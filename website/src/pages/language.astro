---
import BaseLayout from '../layouts/BaseLayout.astro';
import EpistemicTypeLadder from '../components/diagrams/EpistemicTypeLadder.astro';
import UncertaintyFlow from '../components/diagrams/UncertaintyFlow.astro';
import RuntimeArchitecture from '../components/diagrams/RuntimeArchitecture.astro';
import SounioCode from '../components/SounioCode.astro';
import E219DiagnosticExhibit from '../components/language/E219DiagnosticExhibit.astro';
import { getLocaleFromUrl, getLocalizedPath, loadTranslations } from '../lib/i18n';
import { publicContract } from '../data/artifactStatus';
import HonestStatusSection from '../components/status/HonestStatusSection.astro';
import { escapeFullSuiteInline } from '../lib/claimEscapes';
import { gpuFace, gpuMayPrint, gpuRefusal } from '../lib/gpuPublicHonesty';
import { reliabilityFace, reliabilityMayPrint, reliabilityRefusal } from '../lib/stdlibReliabilityHonesty';

const locale = getLocaleFromUrl(Astro.url);
const t = await loadTranslations(locale);
const { bootstrap } = publicContract;
const reliabilityShown = reliabilityMayPrint() ? reliabilityFace() : reliabilityRefusal();

const languageBreadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": t.nav_home || "Home",
      "item": Astro.site?.toString() || "https://www.souniolang.org/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": t.page_language_title || "Language",
      "item": new URL(getLocalizedPath('/language', locale), Astro.site).toString()
    }
  ]
};

const knowledgeExample = `let dose: Knowledge<f64> = Knowledge(
  500.0,
  ε=0.97,
  prov="lab_run_042"
)

// Confidence gate: only passes if ε >= 0.82
if dose.ε >= 0.82 {
  prescribe(dose)           // type: Knowledge<f64>
} else {
  request_remeasurement()
}`;

const effectsExample = `// Effects are part of the signature — callee effects must
// be a subset of the caller's declared effects.
fn read_sensor() -> Knowledge<f64> with IO, Observe {
    let raw = read_port(0x3F8)          // requires IO
    return observe(raw)                  // requires Observe
}

// Linear struct: the handle must be consumed exactly once.
linear struct FileHandle { fd: i32 }

fn close(h: FileHandle) with IO {
    syscall_close(h.fd)                 // h is consumed here
}`;

const compilerExample = `# Stage 0: C compiler compiles the first Sounio compiler
./artifacts/self-hosted/souc-self-hosted-x86_64 \\
    self-hosted/compiler/lean_single.sio gen1.elf

# Stage 1 → Stage 2: first self-hosted compile
./gen1.elf self-hosted/compiler/lean_single.sio gen2.elf

# Stage 2 → Stage 3: fixed-point check
./gen2.elf self-hosted/compiler/lean_single.sio gen3.elf

# Must be identical — this is the fixed point.
sha256sum gen2.elf gen3.elf`;
---

<BaseLayout
  title={t.page_language_title}
  description={t.page_language_desc}
  schema={languageBreadcrumbSchema}
>

  {/* ═══════════════════════════════════════════════════════════════
      LAYOUT SHELL — TOC left, content right on wide viewports
  ═══════════════════════════════════════════════════════════════ */}
  <div class="language-shell">

    {/* ── Mobile collapsible TOC ─────────────────────────────────── */}
    <details class="language-toc-mobile lg:hidden">
      <summary class="toc-mobile-summary">On this page</summary>
      <nav class="toc-mobile-nav">
        <ol class="toc-list">
          <li><a href="#epistemic-types" class="toc-link">A — Epistemic types</a></li>
          <li><a href="#effects" class="toc-link">B — Effects</a></li>
          <li><a href="#compiler" class="toc-link">C — Compiler</a></li>
          <li><a href="#runtime" class="toc-link">D — Runtime</a></li>
        </ol>
      </nav>
    </details>

    {/* ── Sticky TOC (desktop) ─────────────────────────────────── */}
    <aside class="language-toc hidden lg:block" aria-label="Page sections">
      <nav>
        <p class="toc-label">On this page</p>
        <ol class="toc-list">
          <li><a href="#epistemic-types" class="toc-link">A — Epistemic types</a></li>
          <li><a href="#effects" class="toc-link">B — Effects</a></li>
          <li><a href="#compiler" class="toc-link">C — Compiler</a></li>
          <li><a href="#runtime" class="toc-link">D — Runtime</a></li>
        </ol>
        <div class="toc-divider"></div>
        <div class="toc-meta">
          <a href={getLocalizedPath('/compiler', locale)} class="toc-proof-link">Compiler →</a>
          <a href={getLocalizedPath('/proof', locale)} class="toc-proof-link">Honest status →</a>
          <a href={getLocalizedPath('/learn/getting-started', locale)} class="toc-proof-link">Getting started →</a>
        </div>
      </nav>
    </aside>

    {/* ── Main content ────────────────────────────────────────────── */}
    <main class="language-main">

      {/* HEADER */}
      <section class="section-shell pt-[clamp(3rem,8vw,5rem)]">
        <div class="max-w-[740px] grid gap-[1rem]">
          <span class="badge-pill">Language</span>
          <h1 class="font-display text-[clamp(2.4rem,5vw,3.6rem)] font-[400] leading-[1.1] tracking-[-0.01em] text-[var(--color-text-primary)]">
            What the language does.<br />What it doesn&rsquo;t. Exactly.
          </h1>
          <p class="text-[1rem] text-[var(--color-text-secondary)] max-w-[60ch] leading-[1.75]">
            Four things Sounio gives you that other languages don&rsquo;t.
            Anything not on this page is either scaffolding or missing &mdash;
            <a href={getLocalizedPath('/proof', locale)} class="text-[var(--color-accent-gold-soft)] hover:underline">/proof</a>{' '}
            has the honest status.
          </p>
          <p class="text-[0.92rem] text-[var(--color-text-secondary)] max-w-[68ch] leading-[1.8] border-l-[2px] border-[var(--color-accent-gold-soft)] pl-[1rem] opacity-85">
            Sounio is a statically typed, natively compiled systems language. Its
            contribution relative to Rust (ownership&thinsp;/&thinsp;linearity), Koka (algebraic
            effects), and Lean (verified computation) is the <em>epistemic
            dimension</em>: gradual confidence typing, GUM uncertainty propagation,
            and confidence gates &mdash; all enforced by the compiler, not
            by convention or runtime library.
          </p>
        </div>
      </section>

      <div class="border-t border-[var(--glass-border)]"></div>

      {/* ═══════════════════════════════════════════════════════════
          SECTION A — EPISTEMIC TYPES
      ═══════════════════════════════════════════════════════════ */}
      <section id="epistemic-types" class="section-shell scroll-mt-[5rem]">
        <div class="max-w-[740px] grid gap-[1.8rem]">

          <div class="grid gap-[0.4rem]">
            <span class="text-[0.78rem] font-[700] uppercase tracking-[0.1em] text-[var(--color-accent-gold-soft)]">A</span>
            <h2 class="font-display text-[1.7rem] font-[400] leading-[1.2] text-[var(--color-text-primary)]">
              Confidence survives every operation.
            </h2>
            <p class="text-[0.95rem] text-[var(--color-text-secondary)] leading-[1.75] max-w-[64ch]">
              Every value in Sounio can carry the evidence behind it. The type system
              enforces this at compile time — not as a lint, not as a runtime check.
            </p>
          </div>

          {/* Type cards */}
          <div class="grid gap-[0.75rem] sm:grid-cols-2">

            <article class="glass glass-specular rounded-[var(--radius-xl)] p-[1.1rem] grid gap-[0.5rem]">
              <h3 class="text-[1.05rem] font-[680] text-[var(--color-text-primary)]">
                Knowledge&lt;T&gt;
              </h3>
              <p class="text-[0.87rem] text-[var(--color-text-secondary)] leading-[1.65]">
                The base epistemic type. Wraps any value with a confidence level ε ∈ [0, 1],
                an uncertainty interval, and a provenance string. GUM uncertainty
                propagates automatically through arithmetic.
              </p>
              <code class="text-[0.8rem] font-mono text-[var(--color-accent-gold-soft)] bg-[rgba(255,255,255,0.05)] px-[0.5em] py-[0.25em] rounded self-start">
                Knowledge&lt;f64&gt;, Knowledge&lt;mg&gt;
              </code>
            </article>

            <article class="glass glass-specular rounded-[var(--radius-xl)] p-[1.1rem] grid gap-[0.5rem]">
              <h3 class="text-[1.05rem] font-[680] text-[var(--color-text-primary)]">
                Validated&lt;T&gt;
              </h3>
              <p class="text-[0.87rem] text-[var(--color-text-secondary)] leading-[1.65]">
                A distinct type that can only be produced by passing a formal confidence
                gate. Cannot be confused with raw measurements. Confidence-gated
                execution branches on Validated vs. raw.
              </p>
              <code class="text-[0.8rem] font-mono text-[var(--color-accent-gold-soft)] bg-[rgba(255,255,255,0.05)] px-[0.5em] py-[0.25em] rounded self-start">
                fn prescribe(d: Validated&lt;f64, ε &gt;= 0.82&gt;)
              </code>
            </article>

            <article class="glass glass-specular rounded-[var(--radius-xl)] p-[1.1rem] grid gap-[0.5rem]">
              <h3 class="text-[1.05rem] font-[680] text-[var(--color-text-primary)]">
                Unobserved&lt;T&gt;
              </h3>
              <p class="text-[0.87rem] text-[var(--color-text-secondary)] leading-[1.65]">
                Values remain quantum-indeterminate until a comparison or I/O boundary
                collapses them. Bayesian and quantum measurement semantics live in
                the type system, not in runtime libraries.
              </p>
              <code class="text-[0.8rem] font-mono text-[var(--color-accent-gold-soft)] bg-[rgba(255,255,255,0.05)] px-[0.5em] py-[0.25em] rounded self-start">
                fn observe(x: Unobserved&lt;f64&gt;) -&gt; bool with Observe
              </code>
            </article>

            <article class="glass glass-specular rounded-[var(--radius-xl)] p-[1.1rem] grid gap-[0.5rem]">
              <h3 class="text-[1.05rem] font-[680] text-[var(--color-text-primary)]">
                Intervention&lt;T&gt; &amp; Counterfactual&lt;T&gt;
              </h3>
              <p class="text-[0.87rem] text-[var(--color-text-secondary)] leading-[1.65]">
                Compiler-level types that carry causal confidence. Intervention&lt;T&gt;
                corresponds to Pearl's do-operator; Counterfactual&lt;T&gt; encodes
                hypothetical reasoning under the same discipline as observational data.
              </p>
              <code class="text-[0.8rem] font-mono text-[var(--color-accent-gold-soft)] bg-[rgba(255,255,255,0.05)] px-[0.5em] py-[0.25em] rounded self-start">
                do(X = x): Intervention&lt;f64&gt;
              </code>
            </article>

          </div>

          {/* Type progression diagram */}
          <div class="grid gap-[0.6rem]">
            <p class="text-[0.82rem] font-[600] uppercase tracking-[0.08em] text-[var(--color-text-tertiary)]">
              Knowledge&lt;T&gt; progression — bare numeric to fully epistemic
            </p>
            <EpistemicTypeLadder />
          </div>

          {/* Code example */}
          <div class="grid gap-[0.5rem]">
            <p class="text-[0.82rem] font-[600] uppercase tracking-[0.08em] text-[var(--color-text-tertiary)]">
              Confidence-gated execution
            </p>
            <SounioCode code={knowledgeExample} title="confidence_gate.sio" />
          </div>

          <E219DiagnosticExhibit locale={locale} />

          {/* Algebra declarations */}
          <div class="glass rounded-[var(--radius-xl)] p-[1.1rem] grid gap-[0.6rem]">
            <h3 class="text-[1rem] font-[680] text-[var(--color-text-primary)]">Algebra declarations</h3>
            <p class="text-[0.88rem] text-[var(--color-text-secondary)] leading-[1.65]">
              Declare algebraic laws on types. The e-graph optimizer uses only the
              rewrites your algebra permits — no unsound reordering of non-commutative ops.
            </p>
            <pre class="rounded-[var(--radius-md)] bg-[#1e1e1e] text-[#d4d4d4] text-[0.85rem] font-mono p-[0.85rem] overflow-x-auto border border-white/10"><code>{`algebra Octonion over f64 {
  add: commutative, associative
  mul: alternative, non_commutative
  reassociate: fano_selective
}`}</code></pre>
          </div>

          {/* Units */}
          <div class="glass rounded-[var(--radius-xl)] p-[1.1rem] grid gap-[0.5rem]">
            <h3 class="text-[1rem] font-[680] text-[var(--color-text-primary)]">Units & dimensional analysis</h3>
            <p class="text-[0.88rem] text-[var(--color-text-secondary)] leading-[1.65]">
              Units are checked at compile time. A value declared as <code class="font-mono text-[0.85em] bg-[rgba(255,255,255,0.07)] px-[0.3em] rounded">mg</code> cannot
              be silently coerced to <code class="font-mono text-[0.85em] bg-[rgba(255,255,255,0.07)] px-[0.3em] rounded">kg</code> or dimensionless.
              Refinement predicates (e.g. <code class="font-mono text-[0.85em] bg-[rgba(255,255,255,0.07)] px-[0.3em] rounded">x &gt; 0</code>) work today;
              SMT integration is planned.
            </p>
            <pre class="rounded-[var(--radius-md)] bg-[#1e1e1e] text-[#d4d4d4] text-[0.85rem] font-mono p-[0.85rem] overflow-x-auto border border-white/10"><code>{`let dose: mg = 500.0
let weight: kg = 78.5
// let wrong = dose + weight  ← compile error: mg + kg`}</code></pre>
          </div>

          {/* Uncertainty flow */}
          <div class="grid gap-[0.6rem]">
            <p class="text-[0.82rem] font-[600] uppercase tracking-[0.08em] text-[var(--color-text-tertiary)]">
              GUM propagation — uncertainty flows automatically
            </p>
            <UncertaintyFlow />
          </div>

        </div>
      </section>

      <div class="border-t border-[var(--glass-border)]"></div>

      {/* ═══════════════════════════════════════════════════════════
          SECTION B — EFFECTS & LINEARITY
      ═══════════════════════════════════════════════════════════ */}
      <section id="effects" class="section-shell scroll-mt-[5rem]">
        <div class="max-w-[740px] grid gap-[1.8rem]">

          <div class="grid gap-[0.4rem]">
            <span class="text-[0.78rem] font-[700] uppercase tracking-[0.1em] text-[var(--color-accent-gold-soft)]">B</span>
            <h2 class="font-display text-[1.7rem] font-[400] leading-[1.2] text-[var(--color-text-primary)]">
              Side effects live in the signature.
            </h2>
            <p class="text-[0.95rem] text-[var(--color-text-secondary)] leading-[1.75] max-w-[64ch]">
              Side effects are visible in function signatures. Linear types enforce
              exactly-once resource consumption. Neither requires runtime overhead.
            </p>
          </div>

          {/* Effects table */}
          <div class="glass rounded-[var(--radius-xl)] p-[1.1rem] grid gap-[0.8rem]">
            <h3 class="text-[0.82rem] font-[700] uppercase tracking-[0.08em] text-[var(--color-text-tertiary)]">Built-in effects</h3>
            <div class="grid gap-[0.5rem]">
              {[
                { eff: 'IO', desc: 'File, network, stdin/stdout — any real-world I/O.' },
                { eff: 'Panic', desc: 'Controlled abort path. Functions without Panic cannot panic.' },
                { eff: 'Observe', desc: 'Collapses Unobserved\u003cT\u003e to a concrete value — separates measurement from computation.' },
                { eff: 'Async', desc: 'Async/await, channels, spawn. Phase 1 wired (channel + send/recv + spawn); full scheduler pending.' },
                { eff: 'GPU', desc: 'Kernel launch, memory transfer. Syntax integrated; end-to-end path requires CUDA driver.' },
                { eff: 'Probabilistic', desc: 'Monte Carlo sampling, Bayesian updates. In stdlib; effect annotation enforces separation from deterministic code.' },
              ].map(({ eff, desc }) => (
                <div class="flex gap-[0.8rem] text-[0.88rem]">
                  <code class="font-mono font-[600] text-[var(--color-accent-gold-soft)] shrink-0 w-[7rem]">with {eff}</code>
                  <span class="text-[var(--color-text-secondary)] leading-[1.6]">{desc}</span>
                </div>
              ))}
            </div>
          </div>

          {/* Effect rule */}
          <div class="glass rounded-[var(--radius-xl)] p-[1.1rem] grid gap-[0.5rem]">
            <h3 class="text-[1rem] font-[680] text-[var(--color-text-primary)]">The subset rule</h3>
            <p class="text-[0.88rem] text-[var(--color-text-secondary)] leading-[1.65]">
              A function's effects must be a subset of its caller's declared effects.
              A function without <code class="font-mono text-[0.85em] bg-[rgba(255,255,255,0.07)] px-[0.3em] rounded">with IO</code> cannot call a function that has it.
              This is checked by the type checker, not at runtime.
            </p>
          </div>

          {/* Linear types */}
          <div class="glass rounded-[var(--radius-xl)] p-[1.1rem] grid gap-[0.5rem]">
            <h3 class="text-[1rem] font-[680] text-[var(--color-text-primary)]">Linear structs</h3>
            <p class="text-[0.88rem] text-[var(--color-text-secondary)] leading-[1.65]">
              A <code class="font-mono text-[0.85em] bg-[rgba(255,255,255,0.07)] px-[0.3em] rounded">linear struct</code> must be consumed exactly once — it cannot
              be copied, dropped silently, or moved into two branches. File handles,
              network connections, and cryptographic contexts are the canonical use case.
            </p>
          </div>

          <SounioCode code={effectsExample} title="effects_and_linear.sio" />

        </div>
      </section>

      <div class="border-t border-[var(--glass-border)]"></div>

      {/* ═══════════════════════════════════════════════════════════
          SECTION C — COMPILER
      ═══════════════════════════════════════════════════════════ */}
      <section id="compiler" class="section-shell scroll-mt-[5rem]">
        <div class="max-w-[740px] grid gap-[1.8rem]">

          <div class="grid gap-[0.4rem]">
            <span class="text-[0.78rem] font-[700] uppercase tracking-[0.1em] text-[var(--color-accent-gold-soft)]">C</span>
            <h2 class="font-display text-[1.7rem] font-[400] leading-[1.2] text-[var(--color-text-primary)]">
              The compiler compiles itself.
            </h2>
            <p class="text-[0.95rem] text-[var(--color-text-secondary)] leading-[1.75] max-w-[64ch]">
              The compiler is self-hosted: written in Sounio, it compiles Sounio.
              The bootstrap chain is verified — stage 2 and stage 3 produce byte-for-byte
              identical binaries.
            </p>
          </div>

          {/* Pipeline diagram */}
          <div class="grid gap-[0.6rem]">
            <p class="text-[0.82rem] font-[600] uppercase tracking-[0.08em] text-[var(--color-text-tertiary)]">
              Compilation pipeline
            </p>
            <RuntimeArchitecture />
          </div>

          {/* Pipeline steps */}
          <div class="glass rounded-[var(--radius-xl)] p-[1.1rem] grid gap-[0.6rem]">
            <h3 class="text-[0.82rem] font-[700] uppercase tracking-[0.08em] text-[var(--color-text-tertiary)]">Pipeline stages</h3>
            <div class="grid gap-[0.45rem]">
              {[
                ['Source → Lexer → Parser', 'Recursive-descent parser. No external parser generator.'],
                ['AST → Check', 'Bidirectional type inference + effect analysis. Knowledge\u003cT\u003e subtyping, confidence gates, linear resource tracking.'],
                ['Check → HIR → SIR', 'High-level IR, then Static IR (SSA form). Epistemic metadata preserved through lowering.'],
                ['SIR → HLIR (e-graph)', '1,000+ algebraic rewrite rules. Algebra declarations constrain which rewrites apply.'],
                ['HLIR → ELF (x86-64)', 'Native code generation. No LLVM. Bootstrap chain: C → gen1 → gen2 → gen3 (fixed point).'],
              ].map(([stage, desc]) => (
                <div class="flex gap-[0.8rem] text-[0.87rem]">
                  <code class="font-mono font-[600] text-[var(--color-accent-gold-soft)] shrink-0 leading-[1.6]">{stage}</code>
                  <span class="text-[var(--color-text-secondary)] leading-[1.6]">{desc}</span>
                </div>
              ))}
            </div>
          </div>

          {/* Bootstrap fixed point */}
          <div class="grid gap-[0.5rem]">
            <p class="text-[0.82rem] font-[600] uppercase tracking-[0.08em] text-[var(--color-text-tertiary)]">
              Reproducing the self-hosting fixed point
            </p>
            <pre class="rounded-[var(--radius-lg)] bg-[#1e1e1e] text-[#d4d4d4] text-[0.85rem] font-mono p-[1rem] overflow-x-auto leading-relaxed border border-white/10"><code>{compilerExample}</code></pre>
            <p class="text-[0.8rem] text-[var(--color-text-tertiary)] leading-[1.6]">
              Achieved 2026-03-23. Recorded SHA-256 (CHANGELOG): <code class="font-mono text-[0.82em]">{bootstrap.recordedSha256?.slice(0, 12) ?? "see CHANGELOG"}…</code>{bootstrap.recordedSizeKb ? ` (${bootstrap.recordedSizeKb} KB).` : "."}
              See <a href={getLocalizedPath('/proof#fixed-point', locale)} class="text-[var(--color-accent-gold-soft)] hover:underline">/proof §2</a> for the full verification.
            </p>
          </div>

          {/* E-graph optimizer */}
          <div class="glass rounded-[var(--radius-xl)] p-[1.1rem] grid gap-[0.5rem]">
            <h3 class="text-[1rem] font-[680] text-[var(--color-text-primary)]">E-graph optimizer</h3>
            <p class="text-[0.88rem] text-[var(--color-text-secondary)] leading-[1.65]">
              The optimizer implements equality saturation over an e-graph — the same
              approach used by egg/egglog but running inside a Sounio compiler written
              in Sounio. 1,000+ algebraic rewrite rules, all at FAIL=0 in the test gate.
              Algebra declarations constrain which rewrites apply per type.
            </p>
          </div>

          {/* CLI commands */}
          <div class="glass rounded-[var(--radius-xl)] p-[1.1rem] grid gap-[0.6rem]">
            <h3 class="text-[0.82rem] font-[700] uppercase tracking-[0.08em] text-[var(--color-text-tertiary)]">Common commands</h3>
            <div class="grid gap-[0.45rem]">
              {[
                ['souc check file.sio', 'Type-check; no output generated.'],
                ['souc run file.sio', 'Compile to temp ELF, execute, clean up.'],
                ['souc compile file.sio -o out.elf', 'Direct native compilation to ELF.'],
                ['souc check --show-types file.sio', 'Dump inferred types (JIT mode only).'],
              ].map(([cmd, desc]) => (
                <div class="flex gap-[0.8rem] text-[0.87rem]">
                  <code class="font-mono font-[600] text-[var(--color-text-primary)] shrink-0 leading-[1.6] min-w-[16rem]">$ {cmd}</code>
                  <span class="text-[var(--color-text-secondary)] leading-[1.6]">{desc}</span>
                </div>
              ))}
            </div>
          </div>

        </div>
      </section>

      <div class="border-t border-[var(--glass-border)]"></div>

      {/* ═══════════════════════════════════════════════════════════
          SECTION D — RUNTIME
      ═══════════════════════════════════════════════════════════ */}
      <section id="runtime" class="section-shell scroll-mt-[5rem]">
        <div class="max-w-[740px] grid gap-[1.8rem]">

          <div class="grid gap-[0.4rem]">
            <span class="text-[0.78rem] font-[700] uppercase tracking-[0.1em] text-[var(--color-accent-gold-soft)]">D</span>
            <h2 class="font-display text-[1.7rem] font-[400] leading-[1.2] text-[var(--color-text-primary)]">
              What is wired. What is not.
            </h2>
            <p class="text-[0.95rem] text-[var(--color-text-secondary)] leading-[1.75] max-w-[64ch]">
              What is and isn't wired up end-to-end. The anti-slop move is to say
              this explicitly before the reader discovers it.
            </p>
          </div>

          <HonestStatusSection heading="Runtime honesty (synced)" subhead="Same contract as the homepage and README.md — regenerated from artifacts." showFooterLink={false} />

          {/* GPU section */}
          <div class="glass rounded-[var(--radius-xl)] p-[1.1rem] grid gap-[0.5rem]">
            <h3 class="text-[1rem] font-[680] text-[var(--color-text-primary)]">GPU path</h3>
            <p class="text-[0.88rem] text-[var(--color-text-secondary)] leading-[1.65]">
              Kernel syntax is integrated into the language — a Sounio function annotated
              <code class="font-mono text-[0.85em] bg-[rgba(255,255,255,0.07)] px-[0.3em] rounded">with GPU</code> compiles to PTX via a backend bridge.
              The world's first GUM uncertainty propagation through a GPU WMMA kernel
              is verified in <code class="font-mono text-[0.85em] bg-[rgba(255,255,255,0.07)] px-[0.3em] rounded">tests/stdlib/gpu/</code> ({gpuMayPrint() ? gpuFace() : gpuRefusal()}).
              The end-to-end driver path requires a CUDA-capable host —
              <code class="font-mono text-[0.85em] bg-[rgba(255,255,255,0.07)] px-[0.3em] rounded">gpu/lib.sio</code> is currently an empty stub.
            </p>
          </div>

          {/* Test gate summary */}
          <div class="glass rounded-[var(--radius-xl)] p-[1.1rem] grid gap-[0.5rem]">
            <h3 class="text-[1rem] font-[680] text-[var(--color-text-primary)]">Test gate snapshot</h3>
            <p class="text-[0.88rem] text-[var(--color-text-secondary)] leading-[1.65]">
              Stdlib reliability gate: <strong class="text-[var(--color-text-primary)]">{reliabilityShown}</strong>{escapeFullSuiteInline()} See <a href={getLocalizedPath('/proof#test-gate', locale)} class="text-[var(--color-accent-gold-soft)] hover:underline">/proof §4</a>.
            </p>
          </div>

        </div>
      </section>

      <div class="border-t border-[var(--glass-border)]"></div>

      {/* ── CTA ─────────────────────────────────────────────────── */}
      <section class="section-shell">
        <div class="max-w-[740px] flex flex-wrap gap-[0.65rem]">
          <a
            href={getLocalizedPath('/learn/getting-started', locale)}
            class="inline-flex items-center justify-center rounded-full px-[1.3rem] py-[0.75rem] text-[0.93rem] font-[650] transition-all hover:-translate-y-px bg-[linear-gradient(120deg,var(--color-accent-gold),var(--color-accent-gold-soft))] text-[#10233e]"
          >
            Getting started
          </a>
          <a
            href={getLocalizedPath('/proof', locale)}
            class="inline-flex items-center justify-center rounded-full px-[1.3rem] py-[0.75rem] text-[0.93rem] font-[650] transition-all hover:-translate-y-px border border-[var(--glass-border)] bg-[rgba(255,255,255,0.06)] text-[var(--color-text-primary)]"
          >
            Honest status →
          </a>
          <a
            href={getLocalizedPath('/learn/language', locale)}
            class="inline-flex items-center justify-center rounded-full px-[1.3rem] py-[0.75rem] text-[0.93rem] font-[650] transition-all hover:-translate-y-px border border-[var(--glass-border)] bg-[rgba(255,255,255,0.06)] text-[var(--color-text-primary)]"
          >
            Language guide (docs) →
          </a>
        </div>
      </section>

    </main>
  </div>

</BaseLayout>

<style>
  .language-shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    min-height: 100vh;
  }

  /* TOC — desktop sticky sidebar */
  .language-toc {
    position: sticky;
    top: 5rem;
    padding: 2rem 1.2rem 2rem 1rem;
    height: fit-content;
    border-right: 1px solid var(--glass-border);
  }

  .language-toc-mobile {
    border-bottom: 1px solid var(--glass-border);
    background: color-mix(in srgb, var(--color-bg-alt) 88%, transparent);
    padding: 0 1rem;
  }

  .toc-mobile-summary {
    cursor: pointer;
    list-style: none;
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-secondary);
    padding: 0.85rem 0;
  }

  .toc-mobile-summary::-webkit-details-marker {
    display: none;
  }

  .toc-mobile-nav {
    padding-bottom: 0.85rem;
  }

  @media (min-width: 1100px) {
    .language-shell {
      grid-template-columns: 14rem minmax(0, 1fr);
      align-items: start;
    }
  }

  /* legacy breakpoint alias — lg uses 1024px in Tailwind; shell uses 1100px */
  @media (max-width: 1099px) {
    .language-toc {
      display: none;
    }
  }

  .toc-label {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-tertiary);
    margin-bottom: 0.65rem;
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.2rem;
  }

  .toc-link {
    display: block;
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    padding: 0.28rem 0.5rem;
    border-radius: var(--radius-md);
    transition: color var(--transition-fast), background var(--transition-fast);
  }

  .toc-link:hover {
    color: var(--color-text-primary);
    background: color-mix(in srgb, var(--color-text-primary) 7%, transparent);
  }

  .toc-divider {
    height: 1px;
    background: var(--glass-border);
    margin: 0.9rem 0;
  }

  .toc-meta {
    display: grid;
    gap: 0.2rem;
  }

  .toc-proof-link {
    font-size: 0.82rem;
    color: var(--color-accent-gold-soft);
    padding: 0.2rem 0.5rem;
    display: block;
    transition: opacity var(--transition-fast);
  }

  .toc-proof-link:hover {
    opacity: 0.8;
  }

  /* Main content */
  .language-main {
    min-width: 0;
  }

  .language-main .section-shell {
    padding-left: 0;
    padding-right: 0;
  }

  .language-main .section-shell > * {
    padding-left: clamp(1rem, 5vw, 2.5rem);
    padding-right: clamp(1rem, 5vw, 2.5rem);
  }
</style>

<script>
  /* Highlight active TOC entry based on scroll position */
  const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.toc-link');
  const sections = ['epistemic-types', 'effects', 'compiler', 'runtime'].map(
    (id) => document.getElementById(id)
  ).filter(Boolean) as HTMLElement[];

  function updateToc() {
    let active = sections[0];
    for (const section of sections) {
      if (section.getBoundingClientRect().top <= 100) active = section;
    }
    tocLinks.forEach((link) => {
      const matches = link.getAttribute('href') === `#${active?.id}`;
      link.style.color = matches ? 'var(--color-text-primary)' : '';
      link.style.background = matches
        ? 'color-mix(in srgb, var(--color-accent-gold) 12%, transparent)'
        : '';
    });
  }

  window.addEventListener('scroll', updateToc, { passive: true });
  updateToc();
</script>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    // Animate top-level content of each section as it enters
    ['#epistemic-types', '#effects', '#compiler', '#runtime'].forEach((id) => {
      const el = document.querySelector(id);
      if (!el) return;
      const children = el.querySelectorAll(':scope > div > div > *');
      gsap.from(children, {
        y: 20, opacity: 0, stagger: 0.1, duration: 0.55, ease: 'power2.out',
        scrollTrigger: { trigger: el, start: 'top 76%', once: true },
      });
    });
  });
</script>
