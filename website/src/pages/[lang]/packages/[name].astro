---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { registryPackages } from '../../../data/registryPackages';
import { getLocalizedPath, type Locale } from '../../../lib/i18n';

export async function getStaticPaths() {
  return ['pt', 'el', 'zh', 'zh-hk', 'ja', 'es'].flatMap((lang) =>
    registryPackages.map((pkg) => ({ params: { lang, name: pkg.name }, props: { pkg } }))
  );
}

const { pkg } = Astro.props;
---

<BaseLayout title={`Package: ${pkg.name}`} description={pkg.description}>
  <section class="section-shell">
    <div class="container package-detail-shell">
      <a href={getLocalizedPath('/packages', Astro.params.lang as Locale)} class="hero-cta secondary back-link">
        Back to Packages
      </a>

      <article class="glass glass-specular package-detail-card">
        <div class="title-row">
          <div>
            <h1>{pkg.name}</h1>
            <p>{pkg.description}</p>
          </div>
          <span>v{pkg.version}</span>
        </div>

        <div class="detail-grid">
          <div>
            <h2>Downloads</h2>
            <p>{pkg.downloads.toLocaleString()}</p>
          </div>
          <div>
            <h2>Status</h2>
            <p>{pkg.featured ? 'Featured' : 'Community'}</p>
          </div>
          <div>
            <h2>Install</h2>
            <pre><code>souc add {pkg.name}</code></pre>
          </div>
        </div>

        <h2 class="keywords-title">Keywords</h2>
        <div class="keywords-list">
          {pkg.keywords.map((k) => (
            <span>#{k}</span>
          ))}
        </div>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .package-detail-shell {
    max-width: 920px;
    display: grid;
    gap: 0.9rem;
  }

  .back-link {
    justify-self: start;
    padding: 0.52rem 0.82rem;
  }

  .package-detail-card {
    border-radius: var(--radius-xl);
    padding: 1.2rem;
    display: grid;
    gap: 1rem;
  }

  .title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: start;
    justify-content: space-between;
    gap: 0.8rem;
  }

  .title-row h1 {
    font-family: var(--font-mono);
    font-size: clamp(1.55rem, 4vw, 2.4rem);
  }

  .title-row p {
    margin-top: 0.45rem;
    color: var(--color-text-secondary);
  }

  .title-row span {
    color: var(--color-text-tertiary);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .detail-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 0.8rem;
  }

  .detail-grid > div {
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    padding: 0.8rem;
  }

  .detail-grid h2 {
    font-family: var(--font-sans);
    color: var(--color-text-tertiary);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }

  .detail-grid p {
    color: var(--color-text-primary);
    font-size: 1rem;
  }

  .keywords-title {
    font-family: var(--font-sans);
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-tertiary);
  }

  .keywords-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.44rem;
  }

  .keywords-list span {
    border-radius: var(--radius-full);
    border: 1px solid var(--glass-border);
    background: var(--color-surface-frost);
    color: var(--color-text-secondary);
    font-size: 0.8rem;
    padding: 0.3rem 0.62rem;
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    gsap.from('.package-detail-card', {
      y: 28, opacity: 0, duration: 0.7, ease: 'power2.out',
      scrollTrigger: { trigger: '.package-detail-shell', start: 'top 80%', once: true },
    });
  });
</script>
