---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../../layouts/DocsLayout.astro';
import { getLocalizedPath, loadTranslations, type Locale } from '../../../lib/i18n';
import { contentIdsMatch } from '../../../lib/content-ids';

const DEFAULT_LOCALE: Locale = 'en';

function normalizeParamSlug(slug: unknown): string {
  if (typeof slug === 'string') return slug.replace(/^\/+/, '').replace(/\/+$/, '');
  if (Array.isArray(slug)) return slug.join('/').replace(/^\/+/, '').replace(/\/+$/, '');
  return '';
}

function candidateDocIds(locale: Locale, slug: string) {
  const clean = slug.replace(/^\/+/, '').replace(/\/+$/, '');
  const candidates = [`${locale}/${clean}.mdx`, `${locale}/${clean}/index.mdx`];
  if (locale !== DEFAULT_LOCALE) {
    candidates.push(`${DEFAULT_LOCALE}/${clean}.mdx`, `${DEFAULT_LOCALE}/${clean}/index.mdx`);
  }
  return candidates;
}

export async function getStaticPaths() {
  const docs = await getCollection('docs', (entry) => entry.id.startsWith('en/'));
  const slugs = Array.from(
    new Set(
      docs.map((doc) => {
        const noLocale = doc.id.replace(/^en\//, '').replace(/\.mdx$/, '');
        return noLocale.endsWith('/index') ? noLocale.slice(0, -'/index'.length) : noLocale;
      })
    )
  );

  return ['pt', 'el', 'zh', 'zh-hk', 'ja', 'es'].flatMap((lang) =>
    slugs.map((slug) => ({ params: { lang, slug } }))
  );
}

const locale = Astro.params.lang as Locale;
const t = await loadTranslations(locale);
const requestedSlug = normalizeParamSlug(Astro.params.slug);

const allDocs = await getCollection('docs');
const doc =
  candidateDocIds(locale, requestedSlug)
    .map((id) => allDocs.find((d) => contentIdsMatch(d.id, id)))
    .find(Boolean) ??
  candidateDocIds(DEFAULT_LOCALE, requestedSlug)
    .map((id) => allDocs.find((d) => contentIdsMatch(d.id, id)))
    .find(Boolean);

if (!doc) {
  throw new Error(`Doc not found for slug: ${requestedSlug}`);
}

const { Content, headings } = await render(doc);

const layoutHeadings = headings.map((h) => ({
  id: h.slug,
  text: h.text,
  depth: h.depth,
}));

function resolveDocTitle(slug: string): string | undefined {
  const found =
    candidateDocIds(locale, slug)
      .map((id) => allDocs.find((d) => d.id === id))
      .find(Boolean) ??
    candidateDocIds(DEFAULT_LOCALE, slug)
      .map((id) => allDocs.find((d) => d.id === id))
      .find(Boolean);
  return found?.data.title;
}

function hrefFor(slug: string) {
  return getLocalizedPath(`/learn/${slug}`, locale);
}

const sidebarBlueprint: Array<{ title: string; slugs: string[] }> = [
  {
    title: t.docs_sidebar_getting_started,
    slugs: ['getting-started', 'getting-started/hello-world', 'getting-started/first-program'],
  },
  {
    title: t.docs_sidebar_language,
    slugs: ['language', 'language/variables', 'language/functions', 'language/control-flow'],
  },
  {
    title: t.docs_sidebar_epistemic,
    slugs: ['epistemic', 'epistemic/knowledge', 'epistemic/uncertainty', 'epistemic/provenance'],
  },
  {
    title: t.docs_sidebar_effects,
    slugs: ['effects', 'effects/io', 'effects/custom'],
  },
  {
    title: t.docs_sidebar_reference,
    slugs: ['gpu', 'units', 'stdlib', 'tooling', 'tooling/lsp', 'examples'],
  },
  {
    title: t.docs_sidebar_compiler,
    slugs: [
      'compiler',
      'compiler/lexer-parser',
      'compiler/type-system',
      'compiler/effect-system',
      'compiler/codegen',
      'compiler/scientific-features',
    ],
  },
  {
    title: t.docs_sidebar_spec,
    slugs: ['spec', 'spec/language-spec'],
  },
];

const sidebar = sidebarBlueprint
  .map((section) => ({
    title: section.title,
    items: section.slugs
      .map((slug) => {
        const title = resolveDocTitle(slug);
        if (!title) return null;
        return { title, href: hrefFor(slug) };
      })
      .filter((item): item is { title: string; href: string } => item !== null),
  }))
  .filter((section) => section.items.length > 0);

const orderedSlugs = sidebarBlueprint.flatMap((s) => s.slugs);
const currentIndex = orderedSlugs.indexOf(requestedSlug);
const prevSlug = currentIndex > 0 ? orderedSlugs[currentIndex - 1] : null;
const nextSlug = currentIndex >= 0 && currentIndex < orderedSlugs.length - 1 ? orderedSlugs[currentIndex + 1] : null;

const prev = prevSlug
  ? { title: resolveDocTitle(prevSlug) ?? prevSlug, href: hrefFor(prevSlug) }
  : undefined;
const next = nextSlug
  ? { title: resolveDocTitle(nextSlug) ?? nextSlug, href: hrefFor(nextSlug) }
  : undefined;
---

<DocsLayout
  title={doc.data.title}
  description={doc.data.description}
  headings={layoutHeadings}
  sidebar={sidebar}
  prev={prev}
  next={next}
  docsBasePath="/learn"
  docsBaseLabel="Learn"
>
  <Content />
</DocsLayout>
