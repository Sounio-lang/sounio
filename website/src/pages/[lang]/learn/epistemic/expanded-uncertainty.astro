---
import ExpandedUncertaintyPage from '../../../../components/learn/ExpandedUncertaintyPage.astro';

interface Props {
  locale: 'en' | 'ja';
}

// `pt` renders the English article at its own URL. BaseLayout marks that
// URL noindex,follow because Portuguese is not an indexable locale here.
// Japanese is the only translation.
export function getStaticPaths() {
  const paths: { params: { lang: string }; props: Props }[] = [
    { params: { lang: 'ja' }, props: { locale: 'ja' } },
    { params: { lang: 'pt' }, props: { locale: 'en' } },
  ];
  return paths;
}

const { locale } = Astro.props;
---

<ExpandedUncertaintyPage locale={locale} />
