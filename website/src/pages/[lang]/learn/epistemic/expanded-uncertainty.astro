---
import ExpandedUncertaintyPage from '../../../../components/learn/ExpandedUncertaintyPage.astro';

// `pt` is the untranslated stub: the English article at its own URL.
// BaseLayout marks that URL noindex,follow because it is not in the
// indexable locale set. Japanese is the only translation.
export function getStaticPaths() {
  return [
    { params: { lang: 'ja' }, props: { locale: 'ja' } },
    { params: { lang: 'pt' }, props: { locale: 'en' } },
  ];
}

const { locale } = Astro.props;
---

<ExpandedUncertaintyPage locale={locale} />
