---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getLocalizedPath, type Locale } from '../../../lib/i18n';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return ['pt', 'el', 'zh', 'zh-hk', 'ja', 'es'].flatMap((lang) => {
    // Build a map of slug -> post, preferring locale-specific over English
    const slugMap = new Map<string, typeof posts[0]>();
    for (const post of posts) {
      if (post.data.draft) continue;
      const rawId = post.id.replace(/\.mdx$/, '');
      const hasLocalePrefix = rawId.includes('/');
      const entryLocale = hasLocalePrefix ? rawId.split('/')[0] : 'en';
      const slug = hasLocalePrefix ? rawId.split('/').slice(1).join('-') : rawId;

      if (entryLocale === 'en') {
        if (!slugMap.has(slug)) slugMap.set(slug, post);
      } else if (entryLocale === lang) {
        slugMap.set(slug, post);
      }
    }
    return Array.from(slugMap.entries()).map(([slug, post]) => ({
      params: { lang, slug },
      props: { post },
    }));
  });
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <section class="section-shell insight-detail-hero">
    <div class="container insight-detail-inner">
      <a href={getLocalizedPath('/insights', Astro.params.lang as Locale)} class="hero-cta secondary">Back to Insights</a>
      <span class="badge-pill">Insight</span>
      <h1>{post.data.title}</h1>
      <p>{post.data.description}</p>
      <div class="meta-strip">
        <time>{post.data.publishedAt.toISOString().slice(0, 10)}</time>
        <span>{post.data.author}</span>
      </div>
    </div>
  </section>

  <section class="section-shell">
    <div class="container">
      <article class="prose insight-prose">
        <Content />
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .insight-detail-inner {
    max-width: 820px;
    display: grid;
    gap: 0.95rem;
  }

  .insight-detail-inner h1 {
    font-size: clamp(2rem, 5.1vw, 4rem);
  }

  .insight-detail-inner p {
    color: var(--color-text-secondary);
    font-size: clamp(1rem, 2.2vw, 1.12rem);
  }

  .meta-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    color: var(--color-text-tertiary);
    font-size: 0.84rem;
  }

  .insight-prose {
    margin: 0 auto;
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    gsap.from('.insight-detail-inner > *', {
      y: 24, opacity: 0, stagger: 0.13, duration: 0.7, ease: 'power2.out',
    });
    gsap.from('.insight-prose', {
      y: 20, opacity: 0, duration: 0.65, ease: 'power2.out',
      scrollTrigger: { trigger: '.insight-prose', start: 'top 80%', once: true },
    });
  });
</script>
