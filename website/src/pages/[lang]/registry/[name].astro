---
import { registryPackages } from '../../../data/registryPackages';

export async function getStaticPaths() {
  const locales = ['pt', 'el', 'zh', 'zh-hk', 'ja', 'es'];
  return locales.flatMap((lang) =>
    registryPackages.map((pkg) => ({
      params: { lang, name: pkg.name },
    }))
  );
}

return Astro.redirect(`/${Astro.params.lang}/packages/${Astro.params.name}`, 308);
---
