---
import { registryPackages } from '../../../data/registryPackages';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const languages = ['pt', 'el', 'zh', 'ja', 'es'];
  return languages.flatMap((lang) =>
    registryPackages.map((pkg) => ({
      params: { lang, name: pkg.name },
      props: { pkg },
    }))
  );
}

const { pkg } = Astro.props;
---

<BaseLayout title={`Registry: ${pkg.name}`} description={pkg.description}>
  <section class="py-16 bg-[var(--color-bg)]">
    <div class="container max-w-4xl">
      <a href="/registry" class="inline-flex items-center gap-2 text-sm text-[var(--color-gold-500)] hover:gap-3 transition-all mb-8">
        <svg class="w-4 h-4 rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
        Back to registry
      </a>

      <div class="p-8 rounded-2xl bg-white dark:bg-[var(--color-bg-alt)] shadow-md border border-[var(--color-border)]">
        <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4 mb-6">
          <div>
            <h1 class="text-3xl font-semibold text-[var(--color-navy-900)] dark:text-white font-mono">{pkg.name}</h1>
            <p class="text-[var(--color-text-muted)] mt-2">{pkg.description}</p>
          </div>
          <span class="inline-flex items-center px-3 py-1 rounded-full bg-[var(--color-bg-alt)] dark:bg-[var(--color-bg)] text-sm font-mono text-[var(--color-text-muted)]">
            v{pkg.version}
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
          <div class="rounded-lg border border-[var(--color-border)] p-4">
            <p class="text-xs uppercase tracking-wider text-[var(--color-text-muted)]">Downloads</p>
            <p class="text-xl font-semibold text-[var(--color-navy-900)] dark:text-white mt-1">{pkg.downloads.toLocaleString()}</p>
          </div>
          <div class="rounded-lg border border-[var(--color-border)] p-4">
            <p class="text-xs uppercase tracking-wider text-[var(--color-text-muted)]">Status</p>
            <p class="text-xl font-semibold text-[var(--color-navy-900)] dark:text-white mt-1">{pkg.featured ? 'Featured' : 'Community'}</p>
          </div>
          <div class="rounded-lg border border-[var(--color-border)] p-4">
            <p class="text-xs uppercase tracking-wider text-[var(--color-text-muted)]">Install</p>
            <p class="text-sm font-mono text-[var(--color-navy-900)] dark:text-white mt-1">souc add {pkg.name}</p>
          </div>
        </div>

        <h2 class="text-lg font-semibold text-[var(--color-navy-900)] dark:text-white mb-3">Keywords</h2>
        <div class="flex flex-wrap gap-2">
          {pkg.keywords.map((k) => (
            <span class="px-3 py-1 rounded-full text-sm bg-[var(--color-bg-alt)] dark:bg-[var(--color-bg)] text-[var(--color-text-muted)]">
              #{k}
            </span>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
