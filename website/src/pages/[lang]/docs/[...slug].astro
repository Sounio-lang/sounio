---
import DocsPage from '../../docs/[...slug].astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const LOCALES = ['pt', 'el', 'zh', 'ja', 'es'] as const;
  const docs = await getCollection('docs', (entry) => entry.id.startsWith('en/'));
  const slugs = Array.from(
    new Set(
      docs.map((doc) => {
        const noLocale = doc.id.replace(/^en\//, '').replace(/\.mdx$/, '');
        return noLocale.endsWith('/index') ? noLocale.slice(0, -'/index'.length) : noLocale;
      })
    )
  );

  return LOCALES.flatMap((lang) =>
    slugs.map((slug) => ({
      params: { lang, slug },
    }))
  );
}
---

<DocsPage />
