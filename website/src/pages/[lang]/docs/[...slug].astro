---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const locales = ['pt', 'el', 'zh', 'zh-hk', 'ja', 'es'] as const;
  const docs = await getCollection('docs', (entry) => entry.id.startsWith('en/'));
  const slugs = Array.from(
    new Set(
      docs.map((doc) => {
        const noLocale = doc.id.replace(/^en\//, '').replace(/\.mdx$/, '');
        return noLocale.endsWith('/index') ? noLocale.slice(0, -'/index'.length) : noLocale;
      })
    )
  );

  return locales.flatMap((lang) =>
    slugs.map((slug) => ({
      params: { lang, slug },
    }))
  );
}

return Astro.redirect(
  `/${Astro.params.lang}/learn/${Array.isArray(Astro.params.slug) ? Astro.params.slug.join('/') : (Astro.params.slug ?? '')}`,
  308
);
---
