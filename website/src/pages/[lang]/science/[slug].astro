---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getLocalizedPath, type Locale } from '../../../lib/i18n';

export async function getStaticPaths() {
  const showcases = await getCollection('showcases');
  return ['pt', 'el', 'zh', 'zh-hk', 'ja', 'es'].flatMap((lang) => {
    // Build a map of slug -> showcase, preferring locale-specific over English
    const slugMap = new Map<string, typeof showcases[0]>();
    for (const showcase of showcases) {
      const rawId = showcase.id.replace(/\.mdx$/, '');
      const hasLocalePrefix = rawId.includes('/');
      const entryLocale = hasLocalePrefix ? rawId.split('/')[0] : 'en';
      const slug = hasLocalePrefix ? rawId.split('/').slice(1).join('-') : rawId;

      if (entryLocale === 'en') {
        // English fallback: only add if no locale-specific version exists yet
        if (!slugMap.has(slug)) {
          slugMap.set(slug, showcase);
        }
      } else if (entryLocale === lang) {
        // Locale-specific: always prefer over English
        slugMap.set(slug, showcase);
      }
    }
    return Array.from(slugMap.entries()).map(([slug, showcase]) => ({
      params: { lang, slug },
      props: { showcase },
    }));
  });
}

const { showcase } = Astro.props;
const { Content } = await render(showcase);

const gradients: Record<string, string> = {
  pharma: 'bg-[var(--spectrum-04-panic)]',
  neuroimaging: 'bg-[var(--spectrum-03-div)]',
  quantum: 'bg-[var(--spectrum-01-io)]',
  climate: 'bg-[var(--spectrum-05-alloc)]',
  causal: 'bg-[var(--spectrum-08-prob)]',
  gpu: 'bg-[var(--spectrum-07-gpu)]',
  genomics: 'bg-[var(--spectrum-07-gpu)]',
  science: 'bg-[var(--color-accent-gold)]',
};

const rawSlug = showcase.id.replace(/\.mdx$/, '');
const slug = rawSlug.includes('/') ? rawSlug.split('/').slice(1).join('-') : rawSlug;
const gradient = gradients[slug] || gradients[showcase.data.domain] || 'bg-[var(--color-accent-gold)]';
---

<BaseLayout title={showcase.data.title} description={showcase.data.description}>
  <section class="section-shell science-detail-hero">
    <div class={`science-halo ${gradient}`}></div>
    <div class="container hero-detail-inner">
      <span class="badge-pill">Science Workflow</span>
      <h1>{showcase.data.title}</h1>
      <p>{showcase.data.description}</p>
      <a href={getLocalizedPath('/science', Astro.params.lang as Locale)} class="hero-cta secondary">Back to Science Hub</a>
    </div>
  </section>

  <section class="section-shell">
    <div class="container">
      <article class="prose science-prose">
        <Content />
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .science-detail-hero {
    padding-top: clamp(4.2rem, 8vw, 7rem);
    overflow: hidden;
  }

  .science-halo {
    position: absolute;
    width: min(680px, 84vw);
    height: min(680px, 84vw);
    right: -18%;
    top: -25%;
    opacity: 0.17;
    filter: blur(56px);
    border-radius: 999px;
    pointer-events: none;
  }

  .hero-detail-inner {
    position: relative;
    z-index: 1;
    max-width: 840px;
    display: grid;
    gap: 1rem;
  }

  .hero-detail-inner h1 {
    font-size: clamp(2.1rem, 5.3vw, 4.2rem);
  }

  .hero-detail-inner p {
    color: var(--color-text-secondary);
    font-size: clamp(1rem, 2.3vw, 1.16rem);
  }

  .science-prose {
    margin: 0 auto;
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    gsap.from('.hero-detail-inner > *', {
      y: 24, opacity: 0, stagger: 0.13, duration: 0.7, ease: 'power2.out',
    });
    gsap.from('.science-prose', {
      y: 20, opacity: 0, duration: 0.65, ease: 'power2.out',
      scrollTrigger: { trigger: '.science-prose', start: 'top 80%', once: true },
    });
  });
</script>
