---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getLocalizedPath, type Locale } from '../../../lib/i18n';

export async function getStaticPaths() {
  const showcases = await getCollection('showcases');
  return ['pt', 'el', 'zh', 'zh-hk', 'ja', 'es'].flatMap((lang) =>
    showcases.map((showcase) => ({
      params: { lang, slug: showcase.id.replace(/\.mdx$/, '') },
      props: { showcase },
    }))
  );
}

const { showcase } = Astro.props;
const { Content } = await render(showcase);

const gradients: Record<string, string> = {
  pharma: 'from-rose-500 to-pink-600',
  neuroimaging: 'from-purple-500 to-indigo-600',
  quantum: 'from-cyan-500 to-blue-600',
  climate: 'from-emerald-500 to-teal-600',
  causal: 'from-amber-500 to-orange-600',
  gpu: 'from-red-500 to-rose-600',
  genomics: 'from-green-500 to-emerald-600',
  science: 'from-blue-500 to-indigo-600',
};

const slug = showcase.id.replace(/\.mdx$/, '');
const gradient = gradients[slug] || gradients[showcase.data.domain] || 'from-gray-500 to-gray-600';
---

<BaseLayout title={showcase.data.title} description={showcase.data.description}>
  <section class="section-shell science-detail-hero">
    <div class={`science-halo bg-gradient-to-br ${gradient}`}></div>
    <div class="container hero-detail-inner">
      <span class="badge-pill">Science Workflow</span>
      <h1>{showcase.data.title}</h1>
      <p>{showcase.data.description}</p>
      <a href={getLocalizedPath('/science', Astro.params.lang as Locale)} class="hero-cta secondary">Back to Science Hub</a>
    </div>
  </section>

  <section class="section-shell">
    <div class="container">
      <article class="prose science-prose">
        <Content />
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .science-detail-hero {
    padding-top: clamp(4.2rem, 8vw, 7rem);
    overflow: hidden;
  }

  .science-halo {
    position: absolute;
    width: min(680px, 84vw);
    height: min(680px, 84vw);
    right: -18%;
    top: -25%;
    opacity: 0.17;
    filter: blur(56px);
    border-radius: 999px;
    pointer-events: none;
  }

  .hero-detail-inner {
    position: relative;
    z-index: 1;
    max-width: 840px;
    display: grid;
    gap: 1rem;
  }

  .hero-detail-inner h1 {
    font-size: clamp(2.1rem, 5.3vw, 4.2rem);
  }

  .hero-detail-inner p {
    color: var(--color-text-secondary);
    font-size: clamp(1rem, 2.3vw, 1.16rem);
  }

  .science-prose {
    margin: 0 auto;
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    gsap.from('.hero-detail-inner > *', {
      y: 24, opacity: 0, stagger: 0.13, duration: 0.7, ease: 'power2.out',
    });
    gsap.from('.science-prose', {
      y: 20, opacity: 0, duration: 0.65, ease: 'power2.out',
      scrollTrigger: { trigger: '.science-prose', start: 'top 80%', once: true },
    });
  });
</script>
