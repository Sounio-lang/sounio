---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const locales = ['pt', 'el', 'zh', 'zh-hk', 'ja', 'es'];
  const showcases = await getCollection('showcases');
  return locales.flatMap((lang) => {
    const slugMap = new Map<string, string>();
    for (const showcase of showcases) {
      const rawId = showcase.id.replace(/\.mdx$/, '');
      const hasLocalePrefix = rawId.includes('/');
      const entryLocale = hasLocalePrefix ? rawId.split('/')[0] : 'en';
      const slug = hasLocalePrefix ? rawId.split('/').slice(1).join('-') : rawId;
      if (entryLocale === 'en') {
        if (!slugMap.has(slug)) slugMap.set(slug, slug);
      } else if (entryLocale === lang) {
        slugMap.set(slug, slug);
      }
    }
    return Array.from(slugMap.keys()).map((slug) => ({
      params: { lang, slug },
    }));
  });
}

return Astro.redirect(`/${Astro.params.lang}/science/${Astro.params.slug}`, 308);
