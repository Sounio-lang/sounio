---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const showcases = await getCollection('showcases');
  return ['pt', 'el', 'zh', 'ja', 'es'].flatMap((lang) =>
    showcases.map((showcase) => ({
      params: { lang, slug: showcase.id.replace(/\.mdx$/, '') },
    }))
  );
}

const { slug } = Astro.params;
const showcases = await getCollection('showcases');
const showcase = showcases.find((s) => s.id.replace(/\.mdx$/, '') === slug);

if (!showcase) {
  throw new Error(`Showcase not found: ${slug}`);
}

const { Content } = await showcase.render();

const gradients: Record<string, string> = {
  pharma: 'from-rose-500 to-pink-600',
  neuroimaging: 'from-purple-500 to-indigo-600',
  quantum: 'from-cyan-500 to-blue-600',
  climate: 'from-emerald-500 to-teal-600',
  causal: 'from-amber-500 to-orange-600',
  gpu: 'from-red-500 to-rose-600',
  genomics: 'from-green-500 to-emerald-600',
  science: 'from-blue-500 to-indigo-600',
};

const gradient = gradients[slug] || gradients[showcase.data.domain] || 'from-gray-500 to-gray-600';
---

<BaseLayout title={showcase.data.title} description={showcase.data.description}>
  <!-- Hero -->
  <section class="relative py-24 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-[#0a0f1a] to-[var(--color-navy-900)]"></div>
    <div class={`absolute top-0 right-0 w-96 h-96 bg-gradient-to-br ${gradient} opacity-20 rounded-full blur-3xl`}></div>

    <div class="relative container px-4">
      <div class="max-w-4xl">
        {showcase.data.icon && (
          <span class="text-6xl mb-6 block">{showcase.data.icon}</span>
        )}
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6">
          {showcase.data.title}
        </h1>
        <p class="text-xl text-white/70 leading-relaxed">
          {showcase.data.description}
        </p>
      </div>
    </div>
  </section>

  <!-- Content -->
  <section class="py-16">
    <div class="container px-4">
      <div class="max-w-4xl mx-auto prose prose-lg dark:prose-invert">
        <Content />
      </div>
    </div>
  </section>

  <!-- Back link -->
  <section class="py-12 border-t border-gray-200 dark:border-white/10">
    <div class="container px-4">
      <a href={`/${Astro.params.lang}/#use-cases`} class="inline-flex items-center gap-2 text-[var(--color-gold-500)] hover:gap-3 transition-all">
        <svg class="w-5 h-5 rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
        Back to all use cases
      </a>
    </div>
  </section>
</BaseLayout>
