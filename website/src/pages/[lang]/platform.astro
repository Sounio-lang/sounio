---
// Permanent redirect: /[lang]/platform → /[lang]/language#compiler
export async function getStaticPaths() {
  return ['pt', 'el', 'zh', 'ja', 'es'].map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params;
const dest = `/${lang}/language#compiler`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${dest}`} />
    <link rel="canonical" href={dest} />
    <title>Redirecting…</title>
  </head>
  <body>
    <p>This page has moved to <a href={dest}>{dest}</a>.</p>
    <script define:vars={{ dest }}>window.location.replace(dest);</script>
  </body>
</html>
