---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const locales = ['pt', 'el', 'zh', 'zh-hk', 'ja', 'es'] as const;
  const tutorials = await getCollection('tutorials');
  const seriesMap = new Map<string, typeof tutorials>();

  for (const tutorial of tutorials) {
    const series = tutorial.data.series;
    if (!seriesMap.has(series)) {
      seriesMap.set(series, []);
    }
    seriesMap.get(series)!.push(tutorial);
  }

  const slugs: string[] = [];
  for (const [series, lessons] of seriesMap) {
    lessons.sort((a, b) => a.data.order - b.data.order);
    slugs.push(series);
    for (const lesson of lessons) {
      slugs.push(`${series}/${lesson.id.replace(/\.mdx$/, '')}`);
    }
  }

  return locales.flatMap((lang) =>
    slugs.map((slug) => ({
      params: { lang, slug },
    }))
  );
}

const slugParam = Astro.params.slug;
const slug = Array.isArray(slugParam) ? slugParam.join('/') : slugParam;

if (!slug) {
  return Astro.redirect('/tutorials', 308);
}

return Astro.redirect(`/tutorials/${slug}`, 308);
---
