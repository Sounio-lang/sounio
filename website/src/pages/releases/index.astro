const d = t[locale] || t.en;
const releases = releasesData[locale] || releasesData.en;
---

<BaseLayout title={d.title} description={d.description}>
  <section class="section-shell releases-hero">
    <div class="container releases-inner">
      <span class="badge-pill">{d.badge}</span>
      <h1>{d.h1}</h1>
      <p>{d.p}</p>
    </div>
  </section>

  <section class="section-shell">
    <div class="container release-timeline">
      {releases.map((release: { version: string; date: string; tag: string; notes: string[] }) => (
        <article class="glass release-item">
          <div class="release-head">
            <h2>v{release.version}</h2>
            <span>{release.tag}</span>
          </div>
          <time>{release.date}</time>
          <ul>
            {release.notes.map((note: string) => (
              <li>{note}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .releases-inner {
    max-width: 780px;
    display: grid;
    gap: 0.95rem;
  }

  .releases-inner h1 {
    font-size: clamp(2.15rem, 5.5vw, 4.35rem);
  }

  .releases-inner p {
    color: var(--color-text-secondary);
    font-size: clamp(1rem, 2.3vw, 1.14rem);
  }

  .release-timeline {
    display: grid;
    gap: 0.9rem;
  }

  .release-item {
    border-radius: var(--radius-xl);
    padding: 1.1rem;
    border: 1px solid var(--glass-border);
  }

  .release-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
  }

  .release-head h2 {
    font-size: 1.3rem;
  }

  .release-head span {
    border-radius: var(--radius-full);
    border: 1px solid rgba(214, 179, 90, 0.34);
    padding: 0.2rem 0.6rem;
    color: var(--color-accent-gold-soft);
    background: rgba(214, 179, 90, 0.1);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
  }

  time {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-text-tertiary);
    margin: 0.3rem 0 0.95rem 0;
  }

  ul {
    display: grid;
    gap: 0.45rem;
    padding-left: 1.1rem;
    margin: 0;
  }

  li {
    font-size: 0.88rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }
</style>
