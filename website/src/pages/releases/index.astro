---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProofData } from '../../lib/proofData';

const proof = getProofData();
---

<BaseLayout title="Releases" description="Current attested release provenance for Sounio">
  <section class="section-shell releases-hero">
    <div class="container releases-inner">
      <span class="badge-pill">Releases</span>
      <h1>Release provenance before release theatre.</h1>
      <p>
        This page surfaces the currently attested compiler release and the artifact evidence behind it. Historical
        release browsing belongs in GitHub releases; the website should foreground what is currently verified.
      </p>
    </div>
  </section>

  <section class="section-shell">
    <div class="container release-grid">
      <article class="glass glass-specular release-panel">
        <span class="release-kicker">Current attested release</span>
        <h2>v{proof.release.version}</h2>
        <p>
          Status: <strong>{proof.release.status}</strong>. {proof.release.statusLabel}.
        </p>
        {proof.release.generatedAtUtc && <p>Generated at: <code>{proof.release.generatedAtUtc}</code></p>}
        {proof.release.assetUrl && (
          <a href={proof.release.assetUrl} target="_blank" rel="noopener noreferrer" class="release-link">
            Open release artifact
          </a>
        )}
      </article>

      <article class="glass release-panel">
        <span class="release-kicker">Integrity evidence</span>
        <h2>Why this route matters.</h2>
        <p>
          Release pages should not be a stale marketing timeline. The useful question is whether the currently surfaced
          binary can be traced to a checked provenance artifact and whether the current public contract still holds.
        </p>
        {proof.release.sha256 && <code class="release-code">{proof.release.sha256}</code>}
      </article>
    </div>
  </section>

  <section class="section-shell">
    <div class="container release-evidence">
      <article class="glass glass-specular release-panel">
        <span class="release-kicker">Supporting contracts</span>
        <ul>
          <li>Stdlib reliability: {proof.stdlib.passCount}/{proof.stdlib.totalCount} passing</li>
          <li>GPU public contract: {proof.gpu.publicPassCount}/{proof.gpu.publicCheckCount} public checks passing</li>
          <li>Required hyper lanes: {proof.stdlib.hyperPassCount}/{proof.stdlib.hyperTotalCount} passing</li>
        </ul>
      </article>

      <article class="glass release-panel">
        <span class="release-kicker">Canonical source</span>
        <p>
          The website points at the current provenance artifact. Long-form version history and tags remain available in
          the GitHub release stream.
        </p>
        <a
          href="https://github.com/sounio-lang/sounio/releases"
          target="_blank"
          rel="noopener noreferrer"
          class="release-link"
        >
          Browse GitHub releases
        </a>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .releases-inner {
    max-width: 780px;
    display: grid;
    gap: 0.95rem;
  }

  .releases-inner h1 {
    font-size: clamp(2.15rem, 5.5vw, 4.35rem);
  }

  .releases-inner p {
    color: var(--color-text-secondary);
    font-size: clamp(1rem, 2.3vw, 1.14rem);
  }

  .release-grid,
  .release-evidence {
    display: grid;
    gap: 1rem;
  }

  .release-panel {
    border-radius: var(--radius-xl);
    padding: 1.15rem;
    display: grid;
    gap: 0.6rem;
  }

  .release-kicker {
    color: var(--color-accent-gold-soft);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.72rem;
    font-weight: 700;
  }

  .release-panel h2 {
    font-size: 1.7rem;
  }

  .release-panel p,
  .release-panel li {
    color: var(--color-text-secondary);
    font-size: 0.92rem;
  }

  .release-panel ul {
    margin: 0;
    padding-left: 1rem;
    display: grid;
    gap: 0.45rem;
  }

  .release-link {
    width: fit-content;
    color: var(--color-text-primary);
    border-bottom: 1px solid color-mix(in srgb, var(--color-accent-gold) 42%, transparent);
    padding-bottom: 0.12rem;
    font-size: 0.84rem;
    font-weight: 650;
  }

  .release-code {
    border-radius: var(--radius-md);
    border: 1px solid var(--glass-border);
    background: color-mix(in srgb, var(--color-bg-alt) 86%, transparent);
    padding: 0.55rem 0.7rem;
    color: var(--color-text-secondary);
    font-size: 0.8rem;
    overflow-wrap: anywhere;
  }

  @media (min-width: 980px) {
    .release-grid,
    .release-evidence {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
