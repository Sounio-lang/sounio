---
import BaseLayout from '../../layouts/BaseLayout.astro';

const releases = [
  {
    version: '1.0.0-beta.5',
    date: '2026-03-05',
    tag: 'Beta',
    notes: [
      'Self-hosted native ELF codegen: souc bootstrap cycle verified deterministic.',
      'SSE2/AVX-512 float arithmetic confirmed via source-to-ELF pipeline (mutvar.sio, float_arith.sio).',
      'All four epistemic types (Knowledge<T>, Validated<T>, Intervention<T>, Counterfactual<T>) fully parsed, type-checked, and lowered to native ELF.',
    ],
  },
  {
    version: '0.100.0',
    date: '2026-02-03',
    tag: 'Release',
    notes: [
      'Genomics module expansion with uncertainty propagation support.',
      'Sequence I/O and alignment workflows matured across core APIs.',
      'GPU pathway validations and stress tests expanded.',
    ],
  },
  {
    version: '0.99.0',
    date: '2026-01-15',
    tag: 'Pre-release',
    notes: [
      'Algebraic effects with continuation support improved.',
      'Native backend reliability and diagnostics upgraded.',
      'Linear type checking behavior refined for nested patterns.',
    ],
  },
  {
    version: '0.98.0',
    date: '2025-12-01',
    tag: 'Alpha',
    notes: [
      'GPU compilation workflows for PTX/SPIR-V advanced.',
      'Refinement constraints with SMT support expanded.',
      'Tooling and package workflow baselines hardened.',
    ],
  },
];
---

<BaseLayout title="Releases" description="Release history and notes for Sounio">
  <section class="section-shell releases-hero">
    <div class="container releases-inner">
      <span class="badge-pill">Releases</span>
      <h1>Version history for the Sounio language and platform.</h1>
      <p>Track milestone releases, platform changes, and stability improvements over time.</p>
    </div>
  </section>

  <section class="section-shell">
    <div class="container release-timeline">
      {releases.map((release) => (
        <article class="glass release-item">
          <div class="release-head">
            <h2>v{release.version}</h2>
            <span>{release.tag}</span>
          </div>
          <time>{release.date}</time>
          <ul>
            {release.notes.map((note) => (
              <li>{note}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .releases-inner {
    max-width: 780px;
    display: grid;
    gap: 0.95rem;
  }

  .releases-inner h1 {
    font-size: clamp(2.15rem, 5.5vw, 4.35rem);
  }

  .releases-inner p {
    color: var(--color-text-secondary);
    font-size: clamp(1rem, 2.3vw, 1.14rem);
  }

  .release-timeline {
    display: grid;
    gap: 0.9rem;
  }

  .release-item {
    border-radius: var(--radius-xl);
    padding: 1.1rem;
    border: 1px solid var(--glass-border);
  }

  .release-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
  }

  .release-head h2 {
    font-size: 1.3rem;
  }

  .release-head span {
    border-radius: var(--radius-full);
    border: 1px solid rgba(214, 179, 90, 0.34);
    padding: 0.2rem 0.6rem;
    color: var(--color-accent-gold-soft);
    background: rgba(214, 179, 90, 0.1);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .release-item time {
    display: block;
    margin-top: 0.35rem;
    color: var(--color-text-tertiary);
    font-size: 0.82rem;
  }

  .release-item ul {
    margin: 0.8rem 0 0;
    padding-left: 1.1rem;
    color: var(--color-text-secondary);
    display: grid;
    gap: 0.35rem;
  }
</style>
