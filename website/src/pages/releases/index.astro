    p: "Track milestone releases, platform changes, and stability improvements over time."
  },
  pt: {
    title: "Lançamentos",
    description: "Histórico de versões e notas de lançamento do Sounio",
    badge: "Lançamentos",
    h1: "Histórico de versões para a linguagem e plataforma Sounio.",
