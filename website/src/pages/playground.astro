---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/common/PageHero.astro';
import PlaygroundEditor from '../components/playground/PlaygroundEditor';
import { getLocaleFromUrl, loadTranslations, getLocalizedPath } from '../lib/i18n';

const locale = getLocaleFromUrl(Astro.url);
const t = await loadTranslations(locale);

const playgroundBreadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": t.nav_home || "Home",
      "item": Astro.site?.toString() || "https://www.souniolang.org/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": t.page_playground_title || "Playground",
      "item": new URL(getLocalizedPath('/playground', locale), Astro.site).toString()
    }
  ]
};
---

<BaseLayout title={t.page_playground_title} description={t.page_playground_subtitle} schema={playgroundBreadcrumbSchema} removeTopPadding={true}>
  <PageHero
    badge={t.page_playground_badge}
    title={t.page_playground_title}
    subtitle={t.page_playground_subtitle}
    mascot="pappou"
    compact={true}
  />

  <section class="section-shell page-body">
    <div class="container">
      <div class="playground-shell glass-elevated">
        <div class="wasm-status-banner">
          <div class="wasm-status-indicator">
            <span class="idle-dot"></span>
            <span class="status-text">WebAssembly Playground</span>
          </div>
          <span class="status-detail">Run locally: <code>bash scripts/build/build_playground_wasm.sh</code></span>
        </div>
        <PlaygroundEditor client:only="react" theme="dark" />
      </div>
      <p class="playground-note">
        Build WebAssembly assets with <code>bash scripts/build/build_playground_wasm.sh</code> when updating browser-runtime compiler components.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .page-body {
    background: #020617;
  }

  .playground-shell {
    border-radius: var(--radius-2xl);
    overflow: hidden;
    min-height: 720px;
    display: flex;
    flex-direction: column;
  }

  .wasm-status-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.6rem 1.1rem;
    background: color-mix(in srgb, var(--color-bg-alt) 80%, transparent);
    border-bottom: 1px solid var(--glass-border);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .wasm-status-indicator {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .idle-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-text-tertiary);
  }

  .status-text {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  .status-detail {
    color: var(--color-text-tertiary);
    display: none;
  }

  @media (min-width: 640px) {
    .status-detail {
      display: block;
    }
  }

  .playground-note {
    margin-top: 0.8rem;
    color: var(--color-text-tertiary);
    font-size: 0.86rem;
  }
</style>
