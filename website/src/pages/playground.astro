---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlaygroundEditor from '../components/playground/PlaygroundEditor';
---

<BaseLayout title="Playground" description="Interactive Sounio playground for quick experiments">
  <section class="section-shell playground-hero">
    <div class="container playground-inner">
      <span class="badge-pill">Playground</span>
      <h1>Write, run, and validate confidence-aware code directly in the browser.</h1>
      <p>
        Use the in-browser compiler loop to prototype language constructs, uncertainty propagation flows, and domain models.
      </p>
    </div>
  </section>

  <section class="section-shell">
    <div class="container">
      <div class="playground-shell glass-elevated">
        <PlaygroundEditor client:load theme="dark" />
      </div>
      <p class="playground-note">
        Build WebAssembly assets with <code>bash scripts/build_playground_wasm.sh</code> when updating browser-runtime compiler components.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .playground-inner {
    max-width: 840px;
    display: grid;
    gap: 0.95rem;
  }

  .playground-inner h1 {
    font-size: clamp(2.2rem, 5.8vw, 4.6rem);
  }

  .playground-inner p {
    color: var(--color-text-secondary);
    font-size: clamp(1rem, 2.3vw, 1.16rem);
  }

  .playground-shell {
    border-radius: var(--radius-2xl);
    overflow: hidden;
    min-height: 720px;
  }

  .playground-note {
    margin-top: 0.8rem;
    color: var(--color-text-tertiary);
    font-size: 0.86rem;
  }
</style>
