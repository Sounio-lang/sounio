---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlaygroundEditor from '../components/playground/PlaygroundEditor';
---

<BaseLayout title="Playground">
  <div class="min-h-screen bg-[var(--color-bg-alt)] py-8">
    <div class="container">
      <div class="text-center mb-6">
        <h1 class="text-4xl font-semibold text-[var(--color-navy-900)] dark:text-white mb-2">
          Interactive Playground
        </h1>
        <p class="text-lg text-[var(--color-text-muted)]">
          Write, compile, and run Sounio code directly in your browser.
        </p>
      </div>

      <div class="bg-white dark:bg-[var(--color-bg)] rounded-xl shadow-xl overflow-hidden border border-[var(--color-border)] h-[700px]">
        <PlaygroundEditor client:load theme="dark" />
      </div>

      <p class="text-center text-[var(--color-text-muted)] mt-6 text-sm">
        Build WebAssembly assets with <code>bash scripts/build_playground_wasm.sh</code> to run the compiler in-browser.
      </p>
    </div>
  </div>
</BaseLayout>
