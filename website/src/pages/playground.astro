---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlaygroundEditor from '../components/playground/PlaygroundEditor';
import { getLocaleFromUrl, loadTranslations, getLocalizedPath } from '../lib/i18n';

const locale = getLocaleFromUrl(Astro.url);
const t = await loadTranslations(locale);

const playgroundBreadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": t.nav_home || "Home",
      "item": Astro.site?.toString() || "https://www.souniolang.org/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": t.page_playground_title || "Playground",
      "item": new URL(getLocalizedPath('/playground', locale), Astro.site).toString()
    }
  ]
};
---

<BaseLayout title={t.page_playground_title} description={t.page_playground_desc} schema={playgroundBreadcrumbSchema}>
  <section class="section-shell playground-hero relative overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img
        src="/assets/original-artworks/ai_brand_sheet.png"
        alt=""
        class="absolute inset-0 w-full h-full object-cover object-center opacity-[0.07] mix-blend-screen"
        loading="eager"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-[var(--color-bg)]/75 via-transparent to-[var(--color-bg)]"></div>
    </div>
    <div class="container playground-inner relative z-10">
      <span class="badge-pill">WASM Playground</span>
      <h1>Write, compile, and run confidence-aware code instantly in the browser.</h1>
      <p>
        Powered by WebAssembly. Use the zero-latency compiler loop to prototype language constructs, uncertainty propagation flows, and domain models entirely on your local machine.
      </p>
    </div>
  </section>

  <section class="section-shell">
    <div class="container">
      <div class="playground-shell glass-elevated">
        <div class="wasm-status-banner">
          <div class="wasm-status-indicator">
            <span class="idle-dot"></span>
            <span class="status-text">WebAssembly Playground</span>
          </div>
          <span class="status-detail">Run locally: <code>bash scripts/build/build_playground_wasm.sh</code></span>
        </div>
        <PlaygroundEditor client:load theme="dark" />
      </div>
      <p class="playground-note">
        Build WebAssembly assets with <code>bash scripts/build/build_playground_wasm.sh</code> when updating browser-runtime compiler components.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .playground-inner {
    max-width: 840px;
    display: grid;
    gap: 0.95rem;
  }

  .playground-inner h1 {
    font-size: clamp(2.2rem, 5.8vw, 4.6rem);
  }

  .playground-inner p {
    color: var(--color-text-secondary);
    font-size: clamp(1rem, 2.3vw, 1.16rem);
  }

  .playground-shell {
    border-radius: var(--radius-2xl);
    overflow: hidden;
    min-height: 720px;
    display: flex;
    flex-direction: column;
  }

  .wasm-status-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.6rem 1.1rem;
    background: color-mix(in srgb, var(--color-bg-alt) 80%, transparent);
    border-bottom: 1px solid var(--glass-border);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .wasm-status-indicator {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .idle-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-text-tertiary);
  }

  .status-text {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  .status-detail {
    color: var(--color-text-tertiary);
    display: none;
  }

  @media (min-width: 640px) {
    .status-detail {
      display: block;
    }
  }

  .playground-note {
    margin-top: 0.8rem;
    color: var(--color-text-tertiary);
    font-size: 0.86rem;
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    gsap.from('.playground-inner > *', {
      y: 24, opacity: 0, stagger: 0.13, duration: 0.7, ease: 'power2.out',
    });
    gsap.from('.playground-shell', {
      y: 32, opacity: 0, duration: 0.75, ease: 'power2.out',
      scrollTrigger: { trigger: '.playground-shell', start: 'top 80%', once: true },
    });
  });
</script>
