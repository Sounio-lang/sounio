---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocaleFromUrl, getLocalizedPath } from '../../lib/i18n';
import { getProofData } from '../../lib/proofData';
import { PharmaSimulator } from '../../components/science-simulators/PharmaSimulator';
import { NeuroSimulator } from '../../components/science-simulators/NeuroSimulator';
import { QuantumSimulator } from '../../components/science-simulators/QuantumSimulator';
import { ClimateSimulator } from '../../components/science-simulators/ClimateSimulator';
import { WebGPUSimulator } from '../../components/science-simulators/WebGPUSimulator';

export async function getStaticPaths() {
  const showcases = await getCollection('showcases');
  return showcases.map((showcase) => ({
    params: { slug: showcase.id.replace(/\.mdx$/, '') },
    props: { showcase },
  }));
}

const { showcase } = Astro.props;
const { Content } = await showcase.render();
const locale = getLocaleFromUrl(Astro.url);
const proof = getProofData();

const gradients: Record<string, string> = {
  pharma: 'from-rose-500 to-pink-600',
  neuroimaging: 'from-purple-500 to-indigo-600',
  quantum: 'from-cyan-500 to-blue-600',
  climate: 'from-emerald-500 to-teal-600',
  causal: 'from-amber-500 to-orange-600',
  gpu: 'from-red-500 to-rose-600',
  genomics: 'from-green-500 to-emerald-600',
  science: 'from-blue-500 to-indigo-600',
};

const slug = showcase.id.replace(/\.mdx$/, '');
const gradient = gradients[slug] || gradients[showcase.data.domain] || 'from-gray-500 to-gray-600';
const isGpu = slug === 'gpu';
const heroBadge = isGpu ? 'GPU Proof Surface' : 'Science Workflow';
const heroBody = isGpu
  ? 'The GPU story needs to be inspectable, not just asserted. This route now combines a live WebGPU proof object with artifact-backed evidence from the checked repository surface.'
  : showcase.data.description;
const gpuProofCards = isGpu
  ? [
      {
        label: 'Public checks',
        value: `${proof.gpu.publicPassCount}/${proof.gpu.publicCheckCount}`,
        detail: 'Current public GPU contract passing in the verified snapshot.',
      },
      {
        label: 'Attested targets',
        value: `${proof.gpu.attestedTargetCount}`,
        detail: 'Binary targets with attestation evidence published by the project.',
      },
      {
        label: 'Native lanes',
        value: `${proof.gpu.nativeLanePassCount}/${proof.gpu.nativeLaneCount}`,
        detail: 'Required native execution lanes currently passing.',
      },
      {
        label: 'Release surface',
        value: `v${proof.release.version}`,
        detail: proof.release.statusLabel,
      },
    ]
  : [];
---

<BaseLayout title={showcase.data.title} description={showcase.data.description}>
  <section class="section-shell science-detail-hero">
    <div class={`science-halo bg-gradient-to-br ${gradient}`}></div>
    <div class="container hero-detail-inner">
      <span class="badge-pill">{heroBadge}</span>
      <h1>{showcase.data.title}</h1>
      <p>{heroBody}</p>
      <a href={getLocalizedPath('/science', locale)} class="hero-cta secondary">Back to Science Hub</a>
    </div>
  </section>

  <section class="section-shell">
    <div class="container">
      {isGpu && (
        <div class="gpu-feature-shell">
          <div class="gpu-proof-intro glass glass-specular">
            <span class="gpu-proof-kicker">Live browser object</span>
            <h2>The storefront-grade GPU surface.</h2>
            <p>
              This page is where the browser-facing GPU object, the checked PTX/runtime claims, and the release-attested
              public contract meet. The point is not to imply the browser demo is the whole backend. The point is to make
              the thesis legible and inspectable.
            </p>
            <div class="gpu-proof-links">
              <a href={getLocalizedPath('/proof', locale)}>Open proof hub</a>
              <a href={getLocalizedPath('/releases', locale)}>Inspect release provenance</a>
            </div>
          </div>

          <WebGPUSimulator client:load />

          <div class="gpu-proof-grid" role="list" aria-label="GPU proof evidence">
            {gpuProofCards.map((card) => (
              <article class="gpu-proof-card glass glass-elevated" role="listitem">
                <span>{card.label}</span>
                <strong>{card.value}</strong>
                <p>{card.detail}</p>
              </article>
            ))}
          </div>
        </div>
      )}
      {slug === 'pharma' && <PharmaSimulator client:load />}
      {slug === 'neuroimaging' && <NeuroSimulator client:load />}
      {slug === 'quantum' && <QuantumSimulator client:load />}
      {slug === 'climate' && <ClimateSimulator client:load />}
      <article class="prose science-prose">
        <Content />
      </article>
    </div>
  </section>

  <section class="section-shell">
    <div class="container">
      <img src="/assets/stamps/stamp_monochrome_on_navy.png" alt="" aria-hidden="true" class="stamp-divider" width="64" height="64" loading="lazy" />
    </div>
  </section>
</BaseLayout>

<style>
  .science-detail-hero {
    padding-top: clamp(4.2rem, 8vw, 7rem);
    overflow: hidden;
  }

  .science-halo {
    position: absolute;
    width: min(680px, 84vw);
    height: min(680px, 84vw);
    right: -18%;
    top: -25%;
    opacity: 0.17;
    filter: blur(56px);
    border-radius: 999px;
    pointer-events: none;
  }

  .hero-detail-inner {
    position: relative;
    z-index: 1;
    max-width: 840px;
    display: grid;
    gap: 1rem;
  }

  .hero-detail-inner h1 {
    font-size: clamp(2.1rem, 5.3vw, 4.2rem);
  }

  .hero-detail-inner p {
    color: var(--color-text-secondary);
    font-size: clamp(1rem, 2.3vw, 1.16rem);
  }

  .science-prose {
    margin: 0 auto;
  }

  .gpu-feature-shell {
    display: grid;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .gpu-proof-intro {
    border-radius: var(--radius-2xl);
    padding: 1.1rem;
    display: grid;
    gap: 0.55rem;
    background:
      radial-gradient(560px 220px at 100% 0%, color-mix(in srgb, var(--color-accent-gold) 18%, transparent), transparent 62%),
      color-mix(in srgb, var(--color-surface-frost) 88%, transparent);
  }

  .gpu-proof-kicker {
    color: var(--color-accent-gold-soft);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.72rem;
    font-weight: 700;
  }

  .gpu-proof-intro h2 {
    font-size: 1.35rem;
  }

  .gpu-proof-intro p,
  .gpu-proof-card p {
    color: var(--color-text-secondary);
    font-size: 0.92rem;
  }

  .gpu-proof-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .gpu-proof-links a {
    width: fit-content;
    color: var(--color-text-primary);
    border-bottom: 1px solid color-mix(in srgb, var(--color-accent-gold) 45%, transparent);
    padding-bottom: 0.12rem;
    font-size: 0.84rem;
    font-weight: 650;
  }

  .gpu-proof-grid {
    display: grid;
    gap: 0.85rem;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  }

  .gpu-proof-card {
    border-radius: var(--radius-xl);
    padding: 1rem;
    display: grid;
    gap: 0.22rem;
  }

  .gpu-proof-card span {
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.7rem;
  }

  .gpu-proof-card strong {
    color: var(--color-text-primary);
    font-size: 1.18rem;
  }
</style>
