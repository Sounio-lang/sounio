---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocaleFromUrl, getLocalizedPath } from '../../lib/i18n';
import { PharmaSimulator } from '../../components/science-simulators/PharmaSimulator';
import { NeuroSimulator } from '../../components/science-simulators/NeuroSimulator';
import { QuantumSimulator } from '../../components/science-simulators/QuantumSimulator';
import { ClimateSimulator } from '../../components/science-simulators/ClimateSimulator';

export async function getStaticPaths() {
  const showcases = await getCollection('showcases');
  return showcases
    .filter((showcase) => !showcase.id.includes('/'))  // only English (non-locale-prefixed) entries
    .map((showcase) => ({
      params: { slug: showcase.id.replace(/\.mdx$/, '') },
      props: { showcase },
    }));
}

const { showcase } = Astro.props;
const { Content } = await render(showcase);
const locale = getLocaleFromUrl(Astro.url);

const gradients: Record<string, string> = {
  pharma: 'from-rose-500 to-pink-600',
  neuroimaging: 'from-purple-500 to-indigo-600',
  quantum: 'from-cyan-500 to-blue-600',
  climate: 'from-emerald-500 to-teal-600',
  causal: 'from-amber-500 to-orange-600',
  gpu: 'from-red-500 to-rose-600',
  genomics: 'from-green-500 to-emerald-600',
  science: 'from-blue-500 to-indigo-600',
};

const slug = showcase.id.replace(/\.mdx$/, '');
const gradient = gradients[slug] || gradients[showcase.data.domain] || 'from-gray-500 to-gray-600';

const routeFrames: Record<string, { pillar: string; argument: string; skeptic: string; boundary: string }> = {
  gpu: {
    pillar: 'GPU Compiler',
    argument:
      'Kretikos is Sounio\'s named GPU compiler lane: checked source-level thread builtins, deterministic serial CPU fallback, in-tree PTX/CUBIN templates, and artifact bundles with hashes.',
    skeptic:
      'A skeptical reader should be able to run the public commands, inspect emitted artifacts, verify the bundle manifest, and see where CPU fallback stops short of GPU execution.',
    boundary:
      'The claim is not total GPU completeness or parallel CPU simulation. The claim is a bounded GPU compiler lane whose public story stops where the artifact trail stops.',
  },
  climate: {
    pillar: 'Refusal',
    argument:
      'This route is here to prove that Sounio is useful when the right behavior is to halt, narrow scope, or refuse to keep speaking after the confidence story breaks down.',
    skeptic:
      'A skeptical reader should be able to ask whether uncertainty only decorates the output or whether it actually changes what the program is willing to say.',
    boundary:
      'The claim is not a full forecasting platform. The claim is a language posture for programs that should stop pretending before they become policy theater.',
  },
  neuroimaging: {
    pillar: 'Diagnosis',
    argument:
      'This route is here to prove that Sounio is being shaped by diagnostic domains where false certainty is expensive and where refusal is part of competent software behavior.',
    skeptic:
      'A skeptical reader should be able to ask whether the route preserves uncertainty through the pipeline or merely annotates a predetermined answer after the fact.',
    boundary:
      'The claim is not clinical deployment today. The claim is diagnostic honesty as a language-level pressure, not just a UI convention.',
  },
};

const routeFrame = routeFrames[slug];
---

<BaseLayout title={showcase.data.title} description={showcase.data.description}>
  <section class="section-shell science-detail-hero">
    <div class={`science-halo bg-gradient-to-br ${gradient}`}></div>
    <div class="container hero-detail-inner">
      <span class="badge-pill">{routeFrame ? `${routeFrame.pillar} flagship route` : 'Science workflow'}</span>
      <h1>{showcase.data.title}</h1>
      <p>{showcase.data.description}</p>
      <div class="hero-link-row">
        <a href={getLocalizedPath('/science', locale)} class="hero-cta secondary">Back to Science Hub</a>
        <a href={getLocalizedPath('/proof', locale)} class="hero-cta secondary">Inspect proof discipline</a>
      </div>
    </div>
  </section>

  <section class="section-shell">
    <div class="container">
      {routeFrame && (
        <div class="science-claim-grid">
          <article class="glass rounded-[var(--radius-xl)] p-[1.05rem] grid gap-[0.45rem]">
            <p class="claim-label">What this route is arguing</p>
            <p class="claim-copy">{routeFrame.argument}</p>
          </article>
          <article class="glass rounded-[var(--radius-xl)] p-[1.05rem] grid gap-[0.45rem]">
            <p class="claim-label">A skeptical reader should ask</p>
            <p class="claim-copy">{routeFrame.skeptic}</p>
          </article>
          <article class="glass rounded-[var(--radius-xl)] p-[1.05rem] grid gap-[0.45rem]">
            <p class="claim-label">Boundary</p>
            <p class="claim-copy claim-copy-dim">{routeFrame.boundary}</p>
          </article>
        </div>
      )}
      {slug === 'pharma' && <PharmaSimulator client:load />}
      {slug === 'neuroimaging' && <NeuroSimulator client:load />}
      {slug === 'quantum' && <QuantumSimulator client:load />}
      {slug === 'climate' && <ClimateSimulator client:load />}
      <article class="prose science-prose">
        <Content />
      </article>
    </div>
  </section>

  <section class="section-shell">
    <div class="container">
      <img src="/assets/stamps/stamp_monochrome_on_navy.png" alt="" aria-hidden="true" class="stamp-divider" width="64" height="64" loading="lazy" />
    </div>
  </section>
</BaseLayout>

<style>
  .science-detail-hero {
    padding-top: clamp(4.2rem, 8vw, 7rem);
    overflow: hidden;
  }

  .science-halo {
    position: absolute;
    width: min(680px, 84vw);
    height: min(680px, 84vw);
    right: -18%;
    top: -25%;
    opacity: 0.17;
    filter: blur(56px);
    border-radius: 999px;
    pointer-events: none;
  }

  .hero-detail-inner {
    position: relative;
    z-index: 1;
    max-width: 840px;
    display: grid;
    gap: 1rem;
  }

  .hero-detail-inner h1 {
    font-size: clamp(2.1rem, 5.3vw, 4.2rem);
  }

  .hero-detail-inner p {
    color: var(--color-text-secondary);
    font-size: clamp(1rem, 2.3vw, 1.16rem);
  }

  .hero-link-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  .science-claim-grid {
    display: grid;
    gap: 1rem;
    margin-bottom: 1.35rem;
  }

  .claim-label {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent-gold-soft);
  }

  .claim-copy {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    line-height: 1.62;
  }

  .claim-copy-dim {
    color: var(--color-text-tertiary);
  }

  .science-prose {
    margin: 0 auto;
  }

  @media (min-width: 960px) {
    .science-claim-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
