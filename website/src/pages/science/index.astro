---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocaleFromUrl, getLocalizedPath } from '../../lib/i18n';

const locale = getLocaleFromUrl(Astro.url);
const showcases = await getCollection('showcases');

const englishShowcases = showcases
  .filter((entry) => !entry.data.draft)
  .filter((entry) => !entry.id.includes('/'))  // only English (non-locale-prefixed) entries
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

const elShowcaseCopy: Record<string, { domain: string; title: string; description: string }> = {
  causal: {
    domain: 'αιτιώδης συμπερασματολογία',
    title: 'Αιτιώδης συμπερασματολογία',
    description: 'Τύποι Intervention<T> και Counterfactual<T> για ρητή αιτιώδη σκέψη.',
  },
  climate: {
    domain: 'κλιματική επιστήμη',
    title: 'Κλιματική επιστήμη',
    description: 'Συλλογισμός ensemble όπου η αβεβαιότητα μπορεί να σταματήσει το πρόγραμμα πριν γίνει πολιτική επίφαση.',
  },
  genomics: {
    domain: 'γονιδιωματική',
    title: 'Γονιδιωματική και βιοπληροφορική',
    description: 'Τελεστές αλληλουχιών DNA και αναλυτικές ροές με ρητή προέλευση.',
  },
  graphics: {
    domain: 'γραφικά',
    title: 'Γραφικά και απόδοση',
    description: 'Επιστημονικές απεικονίσεις τερματικού και raster προεπισκοπήσεις από native εκτέλεση παραδειγμάτων Sounio.',
  },
  gpu: {
    domain: 'GPU',
    title: 'Μεταγλωττιστής GPU Kretikos',
    description: 'Περιορισμένη διαδρομή GPU με ελεγμένα thread builtins, σειριακό CPU fallback και τεκμηριωμένα artifacts PTX/CUBIN.',
  },
  neuroimaging: {
    domain: 'νευροαπεικόνιση',
    title: 'Νευροαπεικόνιση',
    description: 'Διαγνωστικές ροές που διατηρούν την αβεβαιότητα αντί να προσπερνούν αδύναμα ή αμφίσημα σήματα.',
  },
  pharma: {
    domain: 'φαρμακομετρία',
    title: 'Φαρμακομετρία',
    description: 'Μοντελοποίηση PK/PD με διάδοση αβεβαιότητας GUM για κλινική δοσολογία.',
  },
  quantum: {
    domain: 'κβαντικός υπολογισμός',
    title: 'Κβαντικός υπολογισμός',
    description: 'Μοντελοποίηση κβαντικών καταστάσεων μέσω γραμμικών τύπων.',
  },
  'scientific-computing': {
    domain: 'επιστημονικός υπολογισμός',
    title: 'Επιστημονικός υπολογισμός',
    description: 'Ανάλυση δεδομένων και παρακολούθηση αβεβαιότητας σε αναπαραγώγιμες ροές.',
  },
};

const sorted = englishShowcases.map((entry) => {
  const slug = entry.id.replace(/\.mdx$/, '');
  if (locale === 'el' && elShowcaseCopy[slug]) {
    return { entry, slug, copy: elShowcaseCopy[slug] };
  }
  const localized = locale === 'en'
    ? entry
    : showcases.find((candidate) => candidate.id.replace(/\.mdx$/, '') === `${locale}/${slug}`);
  return {
    entry: localized ?? entry,
    slug,
    copy: {
      domain: (localized ?? entry).data.domain,
      title: (localized ?? entry).data.title,
      description: (localized ?? entry).data.description,
    },
  };
});

const pageCopy = locale === 'el'
  ? {
      title: 'Επιστήμη',
      description: 'Επιστημονικές εφαρμογές και ροές εργασίας που υποστηρίζονται από τη Sounio.',
      badge: 'Επιστήμη',
      hero: 'Κάθε αριθμός φέρει τη δική του αμφιβολία.',
      heroDescription: 'Ροές εργασίας όπου η αβεβαιότητα δεν είναι υποσημείωση αλλά τύπος — παρούσα σε κάθε βήμα, διαδιδόμενη από τον compiler και επιβαλλόμενη στο όριο.',
      section: 'Το σύστημα τύπων σε δράση',
      sectionDescription: 'Από τη φαρμακομετρία έως τη γεωμετρία δικτύων, κάθε ροή δείχνει πώς η επιστημική εμπιστοσύνη διακινείται μέσα από έναν πραγματικό υπολογισμό και τι συμβαίνει όταν εξαντλείται.',
      cta: 'Δείτε τη ροή εργασίας',
    }
  : {
      title: 'Science',
      description: 'Domain applications and scientific workflows powered by Sounio',
      badge: 'Science',
      hero: 'Every number carries its doubt.',
      heroDescription: 'Domain workflows where uncertainty is not a footnote but a type — present at every step, propagated by the compiler, enforced at the boundary.',
      section: 'The type system at work',
      sectionDescription: 'From pharmacometrics to network geometry — each workflow shows how epistemic confidence travels through a real computation and what happens when it runs out.',
      cta: 'View workflow',
    };
---

<BaseLayout title={pageCopy.title} description={pageCopy.description}>
  <section class="section-shell science-hero">
    <div class="science-backdrop" aria-hidden="true">
      <picture>
        <source
          srcset="/assets/original-artworks/yiayia_hero_1280.webp 1280w, /assets/original-artworks/yiayia_hero_1536.webp 1536w"
          sizes="100vw"
          type="image/webp"
        />
        <img src="/assets/original-artworks/yiayia_hero.png" alt="" loading="eager" decoding="async" />
      </picture>
      <div class="science-overlay"></div>
    </div>
    <div class="container science-content">
      <span class="badge-pill">{pageCopy.badge}</span>
      <h1>{pageCopy.hero}</h1>
      <p>
        {pageCopy.heroDescription}
      </p>
    </div>
  </section>

  <section class="section-shell">
    <div class="container">
      <div class="section-headline">
        <h2 class="section-heading">{pageCopy.section}</h2>
        <p class="section-subhead">
          {pageCopy.sectionDescription}
        </p>
      </div>

      <div class="science-grid premium-grid">
        {sorted.map(({ entry, slug, copy }) => {
          return (
            <a href={getLocalizedPath(`/science/${slug}`, locale)} class="science-card glass glass-elevated">
              <div class="science-card-top">
                <span class="science-icon">{entry.data.icon ?? '•'}</span>
                <span class="science-domain">{copy.domain}</span>
              </div>
              <h3>{copy.title}</h3>
              <p>{copy.description}</p>
              <span class="science-cta">{pageCopy.cta}</span>
            </a>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .science-hero {
    min-height: min(660px, 82vh);
    display: grid;
    align-items: center;
    overflow: hidden;
  }

  .science-backdrop {
    position: absolute;
    inset: 0;
  }

  .science-backdrop picture,
  .science-backdrop img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .science-backdrop img {
    object-fit: cover;
    object-position: center;
  }

  .science-overlay {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(600px 340px at 80% 10%, rgba(214, 179, 90, 0.22), transparent 60%),
      linear-gradient(130deg, rgba(7, 22, 44, 0.84), rgba(7, 22, 44, 0.66), rgba(7, 22, 44, 0.9));
  }

  .science-content {
    position: relative;
    z-index: 2;
    max-width: 780px;
    display: grid;
    gap: 1rem;
  }

  .science-content h1 {
    font-size: clamp(2.2rem, 6vw, 4.7rem);
  }

  .science-content p {
    color: var(--color-text-secondary);
    font-size: clamp(1rem, 2.4vw, 1.2rem);
  }

  .science-grid {
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }

  .science-card {
    border-radius: var(--radius-xl);
    padding: 1.1rem;
    display: grid;
    gap: 0.6rem;
  }

  .science-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .science-icon {
    font-size: 1.15rem;
  }

  .science-domain {
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.7rem;
    font-weight: 650;
  }

  .science-card h3 {
    font-size: 1.22rem;
  }

  .science-card p {
    color: var(--color-text-secondary);
    font-size: 0.92rem;
  }

  .science-cta {
    margin-top: 0.25rem;
    color: var(--color-accent-gold-soft);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    // Hero text cascade
    gsap.from('.science-content > *', {
      y: 28, opacity: 0, stagger: 0.14, duration: 0.75, ease: 'power2.out',
    });

    // Grid cards stagger in
    gsap.from('.science-card', {
      y: 36, opacity: 0, stagger: 0.1, duration: 0.65, ease: 'power2.out',
      scrollTrigger: { trigger: '.science-grid', start: 'top 78%', once: true },
    });

    // Section heading
    gsap.from('.section-headline', {
      y: 20, opacity: 0, duration: 0.55, ease: 'power2.out',
      scrollTrigger: { trigger: '.section-headline', start: 'top 80%', once: true },
    });
  });
</script>
