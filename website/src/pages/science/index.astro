---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/common/PageHero.astro';
import ContentCard from '../../components/common/ContentCard.astro';
import { getLocaleFromUrl, getLocalizedPath, loadTranslations } from '../../lib/i18n';

const locale = getLocaleFromUrl(Astro.url);
const t = await loadTranslations(locale);
const showcases = await getCollection('showcases');

const sorted = showcases
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<BaseLayout title={t.nav_science} description={t.page_science_subtitle} removeTopPadding={true}>
  <PageHero
    badge={t.page_science_badge}
    title={t.page_science_title}
    subtitle={t.page_science_subtitle}
    mascot="yiayia"
    transitionName="science-title"
  />

  <section class="section-shell page-body">
    <div class="container">
      <header class="section-headline mb-10">
        <h2 class="font-display section-heading">{t.page_science_gallery_title}</h2>
        <p class="section-subhead">{t.page_science_gallery_subtitle}</p>
      </header>

      <div class="science-grid">
        {sorted.map((showcase) => {
          const slug = showcase.id.replace(/\.mdx$/, '');
          return (
            <ContentCard
              href={getLocalizedPath(`/science/${slug}`, locale)}
              title={showcase.data.title}
              description={showcase.data.description}
              accent="var(--color-accent-teal)"
            >
              <span class="science-domain">{showcase.data.domain}</span>
            </ContentCard>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-body {
    background: #020617;
  }

  .science-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }

  .science-domain {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
  }
</style>
