---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import Container from '../../components/ui/Container.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import { getLocaleFromUrl, getLocalizedPath } from '../../lib/i18n';

const locale = getLocaleFromUrl(Astro.url);
const showcases = await getCollection('showcases');

const sorted = showcases
  .filter((entry) => !entry.data.draft)
  .filter((entry) => !entry.id.includes('/'))  // only English (non-locale-prefixed) entries
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<BaseLayout title="Science" description="Domain applications and scientific workflows powered by Sounio">
  <Section class="science-hero">
    <div class="science-backdrop" aria-hidden="true">
      <picture>
        <source
          srcset="/assets/original-artworks/yiayia_hero_1280.webp 1280w, /assets/original-artworks/yiayia_hero_1536.webp 1536w"
          sizes="100vw"
          type="image/webp"
        />
        <img src="/assets/original-artworks/yiayia_hero.png" alt="" loading="eager" decoding="async" />
      </picture>
      <div class="science-overlay"></div>
    </div>
    <Container class="science-content">
      <Eyebrow>Science</Eyebrow>
      <h1>Every number carries its doubt.</h1>
      <p>
        Domain workflows where uncertainty is not a footnote but a type — present at every step,
        propagated by the compiler, enforced at the boundary.
      </p>
    </Container>
  </Section>

  <Section>
    <Container>
      <div class="section-headline">
        <h2 class="section-heading">The type system at work</h2>
        <p class="section-subhead">
          From pharmacometrics to network geometry — each workflow shows how epistemic
          confidence travels through a real computation and what happens when it runs out.
        </p>
      </div>

      <div class="science-grid premium-grid">
        {sorted.map((showcase) => {
          const slug = showcase.id.replace(/\.mdx$/, '');
          return (
            <a href={getLocalizedPath(`/science/${slug}`, locale)} class="science-card glass glass-elevated">
              <div class="science-card-top">
                <span class="science-icon">{showcase.data.icon ?? '•'}</span>
                <span class="science-domain">{showcase.data.domain}</span>
              </div>
              <h3>{showcase.data.title}</h3>
              <p>{showcase.data.description}</p>
              <span class="science-cta">View workflow</span>
            </a>
          );
        })}
      </div>
    </Container>
  </Section>
</BaseLayout>

<style>
  .science-hero {
    min-height: min(660px, 82vh);
    display: grid;
    align-items: center;
    overflow: hidden;
  }

  .science-backdrop {
    position: absolute;
    inset: 0;
  }

  .science-backdrop picture,
  .science-backdrop img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .science-backdrop img {
    object-fit: cover;
    object-position: center;
  }

  .science-overlay {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(600px 340px at 80% 10%, color-mix(in srgb, var(--color-accent-champagne) 22%, transparent), transparent 60%),
      linear-gradient(
        130deg,
        color-mix(in srgb, var(--color-surface-base) 84%, transparent),
        color-mix(in srgb, var(--color-surface-base) 66%, transparent),
        color-mix(in srgb, var(--color-surface-base) 90%, transparent)
      );
  }

  .science-content {
    position: relative;
    z-index: 2;
    max-width: 780px;
    display: grid;
    gap: 1rem;
  }

  .science-content h1 {
    font-size: clamp(2.2rem, 6vw, 4.7rem);
  }

  .science-content p {
    color: var(--color-ink-2);
    font-size: clamp(1rem, 2.4vw, 1.2rem);
  }

  .science-grid {
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }

  .science-card {
    border-radius: var(--radius-xl);
    padding: 1.1rem;
    display: grid;
    gap: 0.6rem;
  }

  .science-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .science-icon {
    font-size: 1.15rem;
  }

  .science-domain {
    color: var(--color-ink-3);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.7rem;
    font-weight: 650;
  }

  .science-card h3 {
    font-size: 1.22rem;
  }

  .science-card p {
    color: var(--color-ink-2);
    font-size: 0.92rem;
  }

  .science-cta {
    margin-top: 0.25rem;
    color: var(--color-accent-champagne-soft);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
</style>

<script>
  import { gsap, revealOnScroll, prefersReducedMotion } from '../../lib/motion';

  if (!prefersReducedMotion()) {
    // Hero text cascade
    gsap.from('.science-content > *', {
      y: 28, opacity: 0, stagger: 0.14, duration: 0.75, ease: 'power2.out',
    });

    // Grid cards stagger in
    revealOnScroll('.science-card', {
      y: 36,
      stagger: 0.1,
      duration: 0.65,
      scrollTrigger: { trigger: '.science-grid', start: 'top 78%', once: true },
    });

    // Section heading
    revealOnScroll('.section-headline', {
      y: 20,
      duration: 0.55,
      scrollTrigger: { trigger: '.section-headline', start: 'top 80%', once: true },
    });
  }
</script>
