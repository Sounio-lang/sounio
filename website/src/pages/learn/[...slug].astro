---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { getLocalizedPath, getLocaleFromUrl, loadTranslations, type Locale } from '../../lib/i18n';
import { docsNavSections, docsLinearOrder } from '../../lib/docs-navigation';
import { contentIdsMatch } from '../../lib/content-ids';
import { EFFECTS_PAGE, SELF_HOSTED_PAGE } from '../../lib/search-appearance.mjs';
import { effectsFaqPage } from '../../lib/effect-system-page.mjs';

const DEFAULT_LOCALE: Locale = 'en';

function normalizeParamSlug(slug: unknown): string {
  if (typeof slug === 'string') return slug.replace(/^\/+/, '').replace(/\/+$/, '');
  if (Array.isArray(slug)) return slug.join('/').replace(/^\/+/, '').replace(/\/+$/, '');
  return '';
}

function candidateDocIds(locale: Locale, slug: string) {
  const clean = slug.replace(/^\/+/, '').replace(/\/+$/, '');
  const candidates = [
    `${locale}/${clean}.mdx`,
    `${locale}/${clean}/index.mdx`,
  ];
  if (locale !== DEFAULT_LOCALE) {
    candidates.push(`${DEFAULT_LOCALE}/${clean}.mdx`, `${DEFAULT_LOCALE}/${clean}/index.mdx`);
  }
  return candidates;
}

export async function getStaticPaths() {
  const docs = await getCollection('docs', (entry) => entry.id.startsWith('en/'));
  const slugs = Array.from(
    new Set(
      docs.map((doc) => {
        const noLocale = doc.id.replace(/^en\//, '').replace(/\.mdx$/, '');
        return noLocale.endsWith('/index') ? noLocale.slice(0, -'/index'.length) : noLocale;
      })
    )
  );
  return slugs.map((slug) => ({ params: { slug } }));
}

const locale = getLocaleFromUrl(Astro.url);
const t = await loadTranslations(locale);
const requestedSlug = normalizeParamSlug(Astro.params.slug);

const allDocs = await getCollection('docs');
const doc =
  candidateDocIds(locale, requestedSlug)
    .map((id) => allDocs.find((d) => contentIdsMatch(d.id, id)))
    .find(Boolean) ??
  candidateDocIds(DEFAULT_LOCALE, requestedSlug)
    .map((id) => allDocs.find((d) => contentIdsMatch(d.id, id)))
    .find(Boolean);

if (!doc) {
  throw new Error(`Doc not found for slug: ${requestedSlug}`);
}

const { Content, headings } = await render(doc);

const layoutHeadings = headings.map((h) => ({
  id: h.slug,
  text: h.text,
  depth: h.depth,
}));

function resolveDocTitle(slug: string): string | undefined {
  const found =
    candidateDocIds(locale, slug)
      .map((id) => allDocs.find((d) => contentIdsMatch(d.id, id)))
      .find(Boolean) ??
    candidateDocIds(DEFAULT_LOCALE, slug)
      .map((id) => allDocs.find((d) => contentIdsMatch(d.id, id)))
      .find(Boolean);
  return found?.data.title;
}

function hrefFor(slug: string) {
  return getLocalizedPath(`/learn/${slug}`, locale);
}

const sidebarBlueprint = docsNavSections.map((section) => ({
  title: t[section.titleKey as keyof typeof t] as string,
  slugs: section.slugs,
}));

const isSelfHosted = requestedSlug === 'compiler/self-hosted';
const isEffects = requestedSlug === 'effects';
const stripSpecVersion = isSelfHosted || isEffects;

const sidebar = sidebarBlueprint
  .map((section) => ({
    title: section.title,
    items: section.slugs
      .map((slug) => {
        const title = resolveDocTitle(slug);
        if (!title) return null;
        // S1: this page's HTML must not contain a compiler version string.
        // The language-spec nav label is "Language Spec (v1.0.0)" on every
        // other learn page; here the parenthetical is dropped.
        const label = stripSpecVersion
          ? title.replace(/\s*\((?:v0\.80|v0\.99|v0\.100|v1\.0)[^)]*\)/g, '').trim()
          : title;
        return { title: label, href: hrefFor(slug) };
      })
      .filter((item): item is { title: string; href: string } => item !== null),
  }))
  .filter((section) => section.items.length > 0);

const currentIndex = docsLinearOrder.indexOf(requestedSlug);
const prevSlug = currentIndex > 0 ? docsLinearOrder[currentIndex - 1] : null;
const nextSlug = currentIndex >= 0 && currentIndex < docsLinearOrder.length - 1 ? docsLinearOrder[currentIndex + 1] : null;

const prev = prevSlug
  ? { title: resolveDocTitle(prevSlug) ?? prevSlug, href: hrefFor(prevSlug) }
  : undefined;
const next = nextSlug
  ? { title: resolveDocTitle(nextSlug) ?? nextSlug, href: hrefFor(nextSlug) }
  : undefined;

const selfHostedCrumbs = [
  { name: SELF_HOSTED_PAGE.crumbs[0], href: getLocalizedPath('/learn', locale) },
  { name: SELF_HOSTED_PAGE.crumbs[1], href: getLocalizedPath('/learn/compiler', locale) },
  { name: SELF_HOSTED_PAGE.crumbs[2], href: Astro.url.pathname },
];
---

<DocsLayout
  title={isSelfHosted ? SELF_HOSTED_PAGE.h1 : doc.data.title}
  heading={isEffects ? EFFECTS_PAGE.h1 : undefined}
  description={doc.data.description}
  lede={isSelfHosted ? SELF_HOSTED_PAGE.lede : isEffects ? EFFECTS_PAGE.lede : undefined}
  breadcrumbs={isSelfHosted ? selfHostedCrumbs : undefined}
  articleHeadline={isSelfHosted ? SELF_HOSTED_PAGE.h1 : isEffects ? EFFECTS_PAGE.h1 : undefined}
  articleAbout={isSelfHosted ? SELF_HOSTED_PAGE.about : isEffects ? EFFECTS_PAGE.about : undefined}
  articleAuthor={isSelfHosted ? SELF_HOSTED_PAGE.author : isEffects ? EFFECTS_PAGE.author : undefined}
  articleIsPartOf={isEffects ? EFFECTS_PAGE.isPartOf : undefined}
  articleProficiencyLevel={isEffects ? EFFECTS_PAGE.proficiencyLevel : undefined}
  articleDependencies={isEffects ? EFFECTS_PAGE.dependencies : undefined}
  schema={isEffects ? effectsFaqPage() : undefined}
  headings={layoutHeadings}
  sidebar={sidebar}
  prev={prev}
  next={next}
  docsBasePath="/learn"
  docsBaseLabel={t.nav_learn}
  dateModified={doc.data.last_validated}
>
  <Content />
</DocsLayout>
