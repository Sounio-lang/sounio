const description = 'Compare units of measure and uncertainty propagation in Sounio, mp-units, physure and Pint, including metres added to seconds.';

const pageUrl = absoluteUrl('/learn/compare/units-libraries/');
const learnUrl = absoluteUrl('/learn/');
const homeUrl = absoluteUrl('/');

const schema = {
  '@context': 'https://schema.org',
