const sounioRun = `unit velocity = m / s

fn sqrt_f64(x: f64) -> f64 with Mut, Div {
    if x <= 0.0 { return 0.0 }
    var guess = x / 2.0
    if guess < 0.001 { guess = 0.001 }
    var i = 0
    while i < 40 {
        guess = (guess + x / guess) / 2.0
        i = i + 1
    }
    return guess
}

fn main() -> i32 with IO, Mut, Panic, Div, Epistemic {
    let distance: Knowledge<m> = measure(100.0, uncertainty: 0.5)
    let elapsed: Knowledge<s> = measure(10.0, uncertainty: 0.1)
    let speed: velocity = distance.value / elapsed.value
    let variance = variance_of(speed)
    let std_unc = sqrt_f64(variance)
    print("speed=")
    print_f64(speed)
    print("\\n")
    print("variance=")
    print_f64(variance)
    print("\\n")
    print("std_unc=")
    print_f64(std_unc)
    print("\\n")
    return 0
}`;

const sounioAdd = `unit velocity = m / s

fn main() -> i32 with IO, Mut, Panic, Div, Epistemic {
    let distance: Knowledge<m> = measure(100.0, uncertainty: 0.5)
    let elapsed: Knowledge<s> = measure(10.0, uncertainty: 0.1)
    let bad = distance.value + elapsed.value
    print_f64(bad)
    print("\\n")
    return 0
}`;

const mpUnits = `#include <iostream>
#include <mp-units/systems/si.h>
#include <mp-units/utility/uncertain.h>

using namespace mp_units;
using namespace mp_units::si::unit_symbols;
using mp_units::utility::uncertain;

int main() {
  quantity distance = uncertain{100.0, 0.5} * m;  // 100.0 ± 0.5 m
  quantity elapsed = uncertain{10.0, 0.1} * s;    // 10.0 ± 0.1 s
  quantity speed = distance / elapsed;
  std::cout << speed << "\\n";
  return 0;
}`;

const physure = `from physure import Q_

distance = Q_(100.0, "m", uncertainty=0.5)
elapsed = Q_(10.0, "s", uncertainty=0.1)
print((distance / elapsed).to("m/s"))
print(distance + elapsed)  # IncompatibleUnitsError`;

const pint = `from pint import UnitRegistry

ureg = UnitRegistry()
distance = (100.0 * ureg.meter).plus_minus(0.5)
elapsed = (10.0 * ureg.second).plus_minus(0.1)
speed = distance / elapsed
print(speed)
print(speed.error)
print(distance + elapsed)  # DimensionalityError`;
---

<DocsLayout title={title} description={description} headings={headings} schema={schema} localizedAlternates={false}>
  <h2 id="the-same-problem">The same problem</h2>
  <p>
    A distance of 100.0&nbsp;m is measured with standard uncertainty 0.5&nbsp;m. A time of 10.0&nbsp;s is measured with standard uncertainty 0.1&nbsp;s. Velocity is distance divided by time. For independent inputs, the first-order law in JCGM 100:2008 §5.1.2 is
  </p>
  <p>
    <em>u</em>(<em>v</em>)<sup>2</sup> = (<em>u</em><sub>d</sub> / <em>t</em>)<sup>2</sup> + (<em>d</em> · <em>u</em><sub>t</sub> / <em>t</em><sup>2</sup>)<sup>2</sup> = 0.0125,
    so <em>v</em> = 10&nbsp;m/s and <em>u</em>(<em>v</em>) = √0.0125 ≈ 0.11180339887&nbsp;m/s.
  </p>
  <p>
    Adding the distance to the time is not a velocity. Each section below uses these two numbers, then tries that addition. Nothing here is a benchmark.
  </p>

  <h2 id="sounio">Sounio</h2>
  <p>
    The program that runs is <code>examples/units/velocity_with_uncertainty.sio</code>. Distance and time are <code>Knowledge&lt;m&gt;</code> and <code>Knowledge&lt;s&gt;</code>. The quotient is stored as <code>velocity</code>, declared <code>unit velocity = m / s</code>. <code>variance_of</code> reads the first-order channel; <code>sqrt_f64</code> is ordinary Newton iteration in the same file, so the example does not import the standard library.
  </p>
  <pre><code>{sounioRun}</code></pre>
  <p>Program stdout, Madaros:</p>
  <pre><code>{`speed=10.000000
variance=0.012500
std_unc=0.111803`}</code></pre>
  <p>
    <code>print_f64</code> stops at six digits after the decimal, so 0.111803 is the printed standard uncertainty, not a claim of more precision. The variance line is the quantity 0.0125 from the formula above. The division sits in <code>main</code>. That is the inline shape already pinned by <code>tests/run-pass/gum_fo_imported_div_variance.sio</code> (there, 6±0.3 over 2±0.1 has variance 0.045). It is not the open case: <code>tests/run-pass/gum_fo_across_call.sio</code> still carries <code>//@ known-failure</code>, and <code>docs/compiler/KNOWN_LIMITATIONS.md</code> (KL-11) says a general user call does not keep the first-order channel.
  </p>
  <p>
    The addition is <code>examples/units/metres_plus_seconds.sio</code>. <code>./bin/souc check</code> exits 1. Madaros prints:
  </p>
  <pre><code>{`error[E041]: unit mismatch in arithmetic operation
  left unit: length^1
  right unit: time^1
error[E000]: type checking failed`}</code></pre>
  <pre><code>{sounioAdd}</code></pre>
  <p>
    On the committed lean_single engine (<code>SOUNIO_SOUC_ENGINE=lean_single</code>) this same Knowledge program is refused with <code>unit mismatch in call argument</code>, and the addition file is also refused (<code>unit mismatch</code> / <code>arithmetic operands must have matching numeric types</code>). A shorter program, plain <code>m</code> divided by <code>s</code> with no <code>Knowledge</code>, does run there and prints <code>10.000000</code>. The numbers in the stdout block above are the Madaros run. <code>Knowledge&lt;f128&gt;</code> is not part of this example; KL-15 says it is not implemented.
  </p>
  <p>
    <code>examples/units/same_value_quotient.sio</code> divides one <code>Knowledge&lt;f64&gt;</code> by itself and prints <code>var_same_over_same=0.000000</code>. That is the first-order derivative of <em>x</em>/<em>x</em>, which is zero. It is not a covariance store for two different measurements. The pin for correlated expressions is <code>tests/run-pass/gum_fo_correlation_and_call_variance_2776.sio</code>.
  </p>
  <p>
    This velocity program does not record a provenance trail. The page <a href="/learn/epistemic/provenance/">Provenance</a> describes an explicit unwrap reason as the boundary that the public docs currently stand on. Nothing in the stdout above is that record.
  </p>

  <h2 id="mp-units">mp-units</h2>
  <p>
    <a href="https://mpusz.github.io/mp-units/HEAD/how_to_guides/advanced_usage/working_with_measurement_uncertainty/">Working with Measurement Uncertainty</a> defines <code>mp_units::utility::uncertain</code> as a central value plus an absolute standard uncertainty, and shows <code>quantity length = uncertain&#123;10.0, 0.1&#125; * m</code>. The program below is that pattern with the numbers from this page.
  </p>
  <pre><code>{mpUnits}</code></pre>
  <p>
    Executed. Checkout <a href="https://github.com/mpusz/mp-units/commit/5e34599">mpusz/mp-units</a> at <code>5e34599</code> (CMake project version 2.6.0; <code>git describe</code> printed the same hash, not a release tag), header-only, g++ 13.3.0, <code>-std=c++20</code>, include directories <code>src/core</code>, <code>src/systems</code>, <code>src/utility</code> and <code>src/integrations</code>. The program printed:
  </p>
  <pre><code>10 ± 0.111803 m/s</code></pre>
  <p>
    A second translation unit kept those two quantities and added <code>quantity bad = distance + elapsed;</code>. g++ exited 2. The first diagnostic was:
  </p>
  <pre><code>error: no match for ‘operator+’ (operand types are ‘mp_units::quantity&lt;mp_units::si::metre(), mp_units::utility::uncertain&lt;double&gt; &gt;’ and ‘mp_units::quantity&lt;mp_units::si::second(), mp_units::utility::uncertain&lt;double&gt; &gt;’)</code></pre>
  <p>
    The <a href="https://mpusz.github.io/mp-units/HEAD/getting_started/safety_features/">safety guide</a> describes the same refusal in prose (“cannot add length and time”). This page quotes the compiler line above as the measurement, and the guide as the documentation the example was taken from. The uncertainty guide says propagation assumes independent values, so <code>x - x</code> keeps a non-zero uncertainty, and that full correlation is out of scope. That <code>x - x</code> case was not re-run. Unit conversion (<code>length.in(mm)</code>) and the concise ISO notation are also in that guide. Those are real library surface that the Sounio example on this page does not implement. For a C++ codebase, this library is the stronger fit of the four.
  </p>

  <h2 id="physure">physure</h2>
  <p>
    <a href="https://github.com/Alexisrx96/physure">physure</a> (PyPI <code>physure</code> 0.2.4, the release installed for this page) is a Rust core with a Python package. The README’s quick start is <code>Q_(10, "km")</code> and <code>Q_(9.8, "m/s^2", uncertainty=0.02)</code>. The same constructor, with the numbers from this page:
  </p>
  <pre><code>{physure}</code></pre>
  <p>Executed with <code>physure</code> 0.2.4. Division:</p>
  <pre><code>(10.0 ± 0.1118033988749895) m/s</code></pre>
  <p>Addition:</p>
  <pre><code>IncompatibleUnitsError: Cannot operate with incompatible units: 'm' and 's'.</code></pre>
  <p>
    The refusal is a Python exception at run time. The README also describes a mypy plugin that narrows <code>Q_(3, "m/s")</code>. That plugin was not run. The README’s own comparison table marks physure’s ecosystem maturity as “new” and Pint’s as mature. A separate expression from the same README’s correlation claim, <code>Q_(10.0, "m", uncertainty=0.2) - </code> itself, printed <code>0.0 m</code>. The README’s timing table was not remeasured.
  </p>

  <h2 id="pint">Pint</h2>
  <p>
    <a href="https://pint.readthedocs.io/en/stable/advanced/measurement.html">Pint’s measurement guide</a> builds a measurement with <code>plus_minus</code> once the <a href="https://pypi.org/project/uncertainties/">uncertainties</a> package is installed. Quantities themselves are defined in the <a href="https://pint.readthedocs.io/en/stable/user/defining-quantities.html">defining-quantities guide</a> (<code>100.0 * ureg.meter</code>).
  </p>
  <pre><code>{pint}</code></pre>
  <p>
    Executed with pint 0.26.2 and uncertainties 3.2.3. Division printed <code>(10.00 +/- 0.11) meter / second</code>, and <code>speed.error</code> printed <code>0.1118033988749895 meter / second</code>. Addition raised <code>DimensionalityError: Cannot convert from 'meter' ([length]) to 'second' ([time])</code>. Both happen when the program runs, not when Python parses the file.
  </p>
  <p>
    The measurement guide still says “Only linear combinations are currently supported.” This division printed an uncertainty anyway. The page reports that pair of facts and does not treat the guide’s sentence as void.
  </p>
  <p>
    Pint’s strength on this problem is the surrounding Python tooling: string parsing, <code>.to(...)</code> conversion, and formatting, documented on the defining-quantities page. Uncertainty is a second package, not a type in the language. That split is a real cost, and the conversion ecosystem is larger than anything this Sounio example shows.
  </p>

  <h2 id="feature-table">Feature table</h2>
  <div class="compare-wrap">
    <table class="compare-table">
      <thead>
        <tr>
          <th></th>
          <th>Sounio</th>
          <th>mp-units</th>
          <th>physure</th>
          <th>Pint</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <th>Unit checking</th>
          <td>Madaros <code>souc check</code> on <code>examples/units/metres_plus_seconds.sio</code> exits 1 with <code>error[E041]</code> (length against time) and does not run the program. lean_single also refuses that file, with a different diagnostic. The Knowledge velocity program itself runs on Madaros and is refused on the committed lean_single engine.</td>
          <td>g++ 13.3.0 exited 2 on <code>distance + elapsed</code> for the same <code>uncertain</code> quantities, with <code>no match for ‘operator+’</code> between metre and second. The safety guide describes that refusal. The velocity program itself compiled and printed <code>10 ± 0.111803 m/s</code>.</td>
          <td>Run time. <code>IncompatibleUnitsError</code> from the 0.2.4 Python package, as printed above. The README’s mypy plugin was not run.</td>
          <td>Run time. <code>DimensionalityError</code> from pint 0.26.2, as printed above.</td>
        </tr>
        <tr>
          <th>Uncertainty propagation</th>
          <td>First-order channel on the quotient in <code>main</code>: printed variance <code>0.012500</code>, printed standard uncertainty <code>0.111803</code>. Inline division is pinned by <code>tests/run-pass/gum_fo_imported_div_variance.sio</code>. A general call is not: KL-11, <code>tests/run-pass/gum_fo_across_call.sio</code>.</td>
          <td>The division printed <code>10 ± 0.111803 m/s</code> (commit <code>5e34599</code>, project version 2.6.0). The uncertainty guide says correlation is out of scope (<code>x - x</code> stays non-zero). That case was not re-run.</td>
          <td>The division printed <code>(10.0 ± 0.1118033988749895) m/s</code>. <code>x - x</code> printed <code>0.0 m</code>. Backends other than the default were not selected.</td>
          <td>The division printed <code>0.1118033988749895 meter / second</code> as <code>speed.error</code>. The measurement guide still limits itself to linear combinations in prose.</td>
        </tr>
        <tr>
          <th>Epistemic / provenance</th>
          <td>Not printed by the velocity program. <a href="/learn/epistemic/provenance/">Provenance</a> is the public description of an explicit unwrap reason. There is no ledger in the stdout.</td>
          <td>The uncertainty guide cited above does not describe a provenance record.</td>
          <td>The README sections cited above do not describe a provenance record. Correlation is not the same thing.</td>
          <td>Neither the measurement guide nor the uncertainties package, as used here, describes a provenance record.</td>
        </tr>
        <tr>
          <th>Ecosystem maturity</th>
          <td>The numbers above were printed by a Madaros built from this tree: <code>artifacts/self-hosted/madaros</code>, md5 <code>1d357d17</code>, tree <code>15db77d45</code>, version line <code>3.0.0-rc.1 (madaros 1d357d17)</code>. The committed ELF <code>bin/madaros-linux-x86_64</code> (md5 <code>23edbec5</code>) printed the same three lines for the same velocity file. Linux x86-64. The file is an example, not a package index.</td>
          <td>Project version 2.6.0, commit <code>5e34599</code>, with its own documentation site. It drops into an existing C++ program. That is a stronger fit for C++ codebases than Sounio is.</td>
          <td>Version 0.2.4. The project README calls this column “new” and calls Pint mature. Rust core, Python, and other bindings are described there; only the Python package was run.</td>
          <td>pint 0.26.2, the usual Python units library, plus uncertainties 3.2.3. Conversion, parsing, and formatting are why people already use it. Sounio does not replace that ecosystem.</td>
        </tr>
      </tbody>
    </table>
  </div>

  <h2 id="not-claimed">What this page does not claim</h2>
  <ul>
    <li>No timings, and no “faster than” sentence. physure’s README has a timing table; it was not reproduced.</li>
    <li>No unit conversion (km to m, or m/s to km/h) in the Sounio program. mp-units and Pint document conversion; this page did not need it for the velocity.</li>
    <li>No <code>Knowledge&lt;f128&gt;</code>. KL-15.</li>
    <li>No claim that every call preserves variance. KL-11.</li>
    <li>No claim that lean_single runs the Knowledge velocity file. It does not.</li>
    <li>No provenance graph, confidence gate, or clinical dosing example. Those are other pages and other tests.</li>
    <li>The older units guide still has a broader comparison table. This page does not repeat it. The link from that guide points here for the measurement.</li>
  </ul>

  <h2 id="sources">Sources</h2>
  <ul>
    <li>Sounio programs: <code>examples/units/velocity_with_uncertainty.sio</code>, <code>examples/units/metres_plus_seconds.sio</code>, <code>examples/units/same_value_quotient.sio</code>.</li>
    <li>Sounio pins: <code>tests/run-pass/gum_fo_imported_div_variance.sio</code>, <code>tests/run-pass/gum_fo_across_call.sio</code>, <code>tests/run-pass/gum_fo_correlation_and_call_variance_2776.sio</code>, <code>docs/compiler/KNOWN_LIMITATIONS.md</code> (KL-11, KL-15).</li>
    <li>JCGM 100:2008: <a href="https://www.bipm.org/en/publications/guides/gum">Guide to the expression of uncertainty in measurement</a>.</li>
    <li>mp-units: <a href="https://mpusz.github.io/mp-units/HEAD/how_to_guides/advanced_usage/working_with_measurement_uncertainty/">uncertainty guide</a>, <a href="https://mpusz.github.io/mp-units/HEAD/getting_started/safety_features/">safety guide</a>, <a href="https://github.com/mpusz/mp-units">repository</a> at commit <a href="https://github.com/mpusz/mp-units/commit/5e34599"><code>5e34599</code></a> (project version 2.6.0). The velocity listing on this page is the program that printed <code>10 ± 0.111803 m/s</code>.</li>
    <li>physure: <a href="https://github.com/Alexisrx96/physure">Alexisrx96/physure</a>, <a href="https://pypi.org/project/physure/">PyPI</a>.</li>
    <li>Pint: <a href="https://pint.readthedocs.io/en/stable/advanced/measurement.html">Using Measurements</a>, <a href="https://pint.readthedocs.io/en/stable/user/defining-quantities.html">Defining Quantities</a>, <a href="https://pypi.org/project/uncertainties/">uncertainties on PyPI</a>.</li>
  </ul>

  <h2 id="reproduce">Reproduce</h2>
  <pre><code>{`export SOUNIO_STDLIB_PATH="$(pwd)/stdlib"
./bin/souc run examples/units/velocity_with_uncertainty.sio
./bin/souc run examples/units/same_value_quotient.sio
./bin/souc check examples/units/metres_plus_seconds.sio   # exit 1, error[E041]

python3 -c 'import pint, uncertainties, physure; print(pint.__version__); print(uncertainties.__version__); print(physure.__version__)'

# mpusz/mp-units commit 5e34599, g++ 13.3.0, header-only.
# SRC is the clone. The velocity file is the listing in the mp-units section.
g++ -std=c++20 -O0 \\
  -I"$SRC/src/core/include" -I"$SRC/src/systems/include" \\
  -I"$SRC/src/utility/include" -I"$SRC/src/integrations/include" \\
  velocity.cpp -o velocity && ./velocity
# printed: 10 ± 0.111803 m/s
# a second file that adds the two uncertain quantities: g++ exits 2`}</code></pre>
  <p>
    <code>souc check</code> on the addition is supposed to fail. A passing check would mean this page is wrong.
  </p>
