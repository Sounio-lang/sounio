      description,
      url: pageUrl,
      inLanguage: 'en',
      datePublished: '2026-10-27',
      author: {
        '@type': 'Person',
        name: 'Demetrios Chiuratto Agourakis',
        url: 'https://www.souniolang.org/',
      },
