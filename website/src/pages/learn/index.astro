const docSections: Array<{ slug: string; items: string[] }> = [
  { slug: 'getting-started', items: ['getting-started/hello-world', 'getting-started/first-program'] },
  { slug: 'language', items: ['language/variables', 'language/functions', 'language/control-flow'] },
  { slug: 'epistemic', items: ['epistemic/knowledge', 'epistemic/uncertainty', 'epistemic/provenance'] },
  { slug: 'effects', items: ['effects/io', 'effects/custom'] },
  { slug: 'gpu', items: [] },
  { slug: 'units', items: [] },
  { slug: 'stdlib', items: [] },
  { slug: 'tooling', items: ['tooling/lsp'] },
  { slug: 'examples', items: [] },
  { slug: 'compiler', items: ['compiler/lexer-parser', 'compiler/type-system', 'compiler/effect-system', 'compiler/codegen'] },
  { slug: 'spec', items: ['spec/language-spec'] },
];
---

<BaseLayout title="Learn" description="Sounio learning hub and technical documentation">
  <section class="section-shell learn-hero">
    <div class="container learn-inner">
      <span class="badge-pill">Learn</span>
      <h1>Documentation built for researchers shipping production systems.</h1>
      <p>
        Navigate language fundamentals, epistemic mechanics, compiler internals, and domain guides from one structured learning hub.
      </p>
    </div>
  </section>

  <section class="section-shell">
    <div class="container">
      <div class="learn-grid premium-grid">
        {docSections.map((section) => (
          <a href={hrefFor(section.slug)} class="learn-card glass glass-specular">
            <svg class="w-8 h-8 text-[var(--color-accent-gold)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d={sectionIcons[section.slug] || sectionIcons['spec']} />
            </svg>
            <h2>{titleFor(section.slug)}</h2>
            <p>{descriptionFor(section.slug)}</p>
            {section.items.length > 0 && (
              <ul>
                {section.items.map((slug) => (
                  <li>{titleFor(slug)}</li>
                ))}
              </ul>
            )}
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .learn-inner {
    max-width: 780px;
    display: grid;
    gap: 0.9rem;
  }

  .learn-inner h1 {
    font-size: clamp(2.15rem, 5.4vw, 4.3rem);
  }

  .learn-inner p {
    color: var(--color-text-secondary);
    font-size: clamp(1rem, 2.3vw, 1.17rem);
  }

  .learn-grid {
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  }

  .learn-card {
    border-radius: var(--radius-xl);
    padding: 1.1rem;
    display: grid;
    gap: 0.55rem;
  }

  .learn-card h2 {
    font-size: 1.2rem;
  }

  .learn-card p {
    color: var(--color-text-secondary);
    font-size: 0.9rem;
  }

  .learn-card ul {
    margin: 0.3rem 0 0;
    padding-left: 1rem;
    color: var(--color-text-tertiary);
    font-size: 0.82rem;
    display: grid;
    gap: 0.22rem;
  }
</style>
