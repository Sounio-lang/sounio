---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getLocalizedPath, getLocaleFromUrl, type Locale } from '../../lib/i18n';
import { docsNavSections } from '../../lib/docs-navigation';
import { contentIdsMatch } from '../../lib/content-ids';

const locale = getLocaleFromUrl(Astro.url);
const DEFAULT_LOCALE: Locale = 'en';
const allDocs = await getCollection('docs');

function candidateDocIds(localeParam: Locale, slug: string) {
  const clean = slug.replace(/^\/+/, '').replace(/\/+$/, '');
  return [
    `${localeParam}/${clean}.mdx`,
    `${localeParam}/${clean}/index.mdx`,
    `${DEFAULT_LOCALE}/${clean}.mdx`,
    `${DEFAULT_LOCALE}/${clean}/index.mdx`,
  ];
}

function findDoc(slug: string) {
  return candidateDocIds(locale, slug)
    .map((id) => allDocs.find((d) => contentIdsMatch(d.id, id)))
    .find(Boolean);
}

function titleFor(slug: string) {
  return findDoc(slug)?.data.title ?? slug;
}

function descriptionFor(slug: string) {
  return findDoc(slug)?.data.description ?? '';
}

function hrefFor(slug: string) {
  return getLocalizedPath(`/learn/${slug}`, locale);
}

const sectionIcons: Record<string, string> = {
  'getting-started': 'M15.59 14.37a6 6 0 01-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 006.16-12.12A14.98 14.98 0 009.631 8.41m5.96 5.96a14.926 14.926 0 01-5.841 2.58m-.119-8.54a6 6 0 00-7.381 5.84h4.8m2.581-5.84a14.927 14.927 0 00-2.58 5.84m2.699 2.7c-.103.021-.207.041-.311.06a15.09 15.09 0 01-2.448-2.448 14.9 14.9 0 01.06-.312m-2.24 2.39a4.493 4.493 0 00-1.757 4.306 4.493 4.493 0 004.306-1.758M16.5 9a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z',
  'language': 'M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25',
  'epistemic': 'M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z',
  'effects': 'M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z',
  'runtime': 'M3.75 5.25h16.5v3H3.75zm1.5 6h13.5v7.5H5.25zm2.25 1.5v4.5h2.25v-4.5zm3.75 0v4.5h2.25v-4.5zm3.75 0v4.5h1.5v-4.5z',
  'examples': 'M12 18v-5.25m0 0a6.01 6.01 0 001.5-.189m-1.5.189a6.01 6.01 0 01-1.5-.189m3.75 7.478a12.06 12.06 0 01-4.5 0m3.75 2.383a14.406 14.406 0 01-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 10-7.517 0c.85.493 1.509 1.333 1.509 2.316V18',
  'compiler': 'M6.75 7.5l3 2.25-3 2.25m4.5 0h3m-9 8.25h13.5A2.25 2.25 0 0021 18V6a2.25 2.25 0 00-2.25-2.25H5.25A2.25 2.25 0 003 6v12a2.25 2.25 0 002.25 2.25z',
  'spec': 'M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z',
};
---

<BaseLayout title="Learn" description="Sounio learning hub and technical documentation">
  <section class="section-shell learn-hero">
    <div class="container learn-inner">
      <span class="badge-pill">Learn</span>
      <h1>Documentation built for researchers shipping production systems.</h1>
      <p>
        Navigate language fundamentals, epistemic mechanics, compiler internals, and domain guides from one structured learning hub.
      </p>
    </div>
  </section>

  <section class="section-shell">
    <div class="container">
      <div class="learn-grid premium-grid">
        {docsNavSections.map((section) => (
          <a href={hrefFor(section.heroSlug)} class="learn-card glass glass-specular">
            <svg class="w-8 h-8 text-[var(--color-accent-gold)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d={sectionIcons[section.icon] || sectionIcons['spec']} />
            </svg>
            <h2>{titleFor(section.heroSlug)}</h2>
            <p>{descriptionFor(section.heroSlug)}</p>
            {section.slugs.length > 1 && (
              <ul>
                {section.slugs.slice(1).map((slug) => (
                  <li>{titleFor(slug)}</li>
                ))}
              </ul>
            )}
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .learn-inner {
    max-width: 780px;
    display: grid;
    gap: 0.9rem;
  }

  .learn-inner h1 {
    font-size: clamp(2.15rem, 5.4vw, 4.3rem);
  }

  .learn-inner p {
    color: var(--color-text-secondary);
    font-size: clamp(1rem, 2.3vw, 1.17rem);
  }

  .learn-grid {
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  }

  .learn-card {
    border-radius: var(--radius-xl);
    padding: 1.1rem;
    display: grid;
    gap: 0.55rem;
  }

  .learn-card h2 {
    font-size: 1.2rem;
  }

  .learn-card p {
    color: var(--color-text-secondary);
    font-size: 0.9rem;
  }

  .learn-card ul {
    margin: 0.3rem 0 0;
    padding-left: 1rem;
    color: var(--color-text-tertiary);
    font-size: 0.82rem;
    display: grid;
    gap: 0.22rem;
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    gsap.from('.learn-inner > *', {
      y: 22, opacity: 0, stagger: 0.12, duration: 0.65, ease: 'power2.out',
    });
    gsap.from('.learn-card', {
      y: 28, opacity: 0, stagger: 0.09, duration: 0.6, ease: 'power2.out',
      scrollTrigger: { trigger: '.learn-grid', start: 'top 78%', once: true },
    });
  });
</script>
