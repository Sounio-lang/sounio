---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocaleFromUrl, getLocalizedPath } from '../../lib/i18n';

const locale = getLocaleFromUrl(Astro.url);
---

<BaseLayout title="About" description="Sounio mission and project context">
  <section class="section-shell about-hero">
    <div class="container about-inner">
      <span class="badge-pill">About</span>
      <h1>Sounio is building software that communicates the quality of its own knowledge.</h1>
      <p>
        We design language and tooling infrastructure for scientists and engineers who need both computational performance
        and defensible uncertainty handling in production systems.
      </p>
      <div class="hero-actions">
        <a href={getLocalizedPath('/about/vision', locale)} class="hero-cta primary">Read Vision</a>
        <a href={getLocalizedPath('/about/roadmap', locale)} class="hero-cta secondary">View Roadmap</a>
      </div>
    </div>
  </section>

  <section class="section-shell">
    <div class="container about-grid">
      <article class="glass glass-specular about-card">
        <h2 class="section-heading">Design Principle</h2>
        <p class="section-subhead">
          A language for science should never erase provenance or confidence signals just because a result reached a scalar.
        </p>
      </article>
      <article class="glass about-image-card">
        <picture>
          <source
            srcset="/assets/original-artworks/pappou_hero_1280.webp 1280w, /assets/original-artworks/pappou_hero_1536.webp 1536w"
            sizes="(min-width: 980px) 48vw, 94vw"
            type="image/webp"
          />
          <img src="/assets/original-artworks/pappou_hero.png" alt="Sounio heritage artwork" loading="lazy" decoding="async" />
        </picture>
      </article>
    </div>
  </section>

  <!-- Liquid Glass Author Section -->
  <section class="author-section">
    <div class="author-container">
      <!-- Main Glass Card -->
      <div class="liquid-glass-card">
        <!-- Specular highlight overlay -->
        <div class="glass-highlight"></div>
        
        <div class="card-content">
          <!-- Left: Avatar with glass ring -->
          <div class="avatar-wrapper">
            <div class="avatar-glass-ring">
              <img src="/assets/author.jpg" alt="Demetrios Chiuratto Agourakis" class="author-avatar" />
            </div>
            <div class="avatar-glow"></div>
          </div>
          
          <!-- Center: Content -->
          <div class="content-stack">
            <div class="title-row">
              <h2 class="author-title">About the Author</h2>
              <div class="title-underline"></div>
            </div>
            
            <div class="name-role">
              <span class="author-name">Demetrios Chiuratto Agourakis</span>
              <span class="role-badge">Creator & Lead Architect</span>
            </div>
            
            <div class="bio-text">
              <p>
                Software architect and researcher specializing in epistemic computing and scientific programming 
                languages. Created Sounio to bridge the gap between scientific rigor and software engineering.
              </p>
              <p class="heritage">
                The name <em>Sounio</em> (Σούνιο) reflects Cape Sounion's ancient boundary between known waters 
                and the unknown sea—a metaphor for computing at the edge of certainty.
              </p>
            </div>
            
            <!-- Liquid Glass Buttons -->
            <div class="action-row">
              <a href="https://github.com/demetrios-agourakis" class="glass-button" target="_blank" rel="noopener">
                <span class="button-glass"></span>
                <span class="button-content">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                    <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
                  </svg>
                  GitHub
                </span>
              </a>
              <a href="https://orcid.org/0009-0000-0000-0000" class="glass-button secondary" target="_blank" rel="noopener">
                <span class="button-glass"></span>
                <span class="button-content">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                    <path d="M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zM7.5 7.5h3v9h-3v-9zm1.5-2a1.5 1.5 0 110-3 1.5 1.5 0 010 3zm6 2h3v1.5h.03c.39-.75 1.35-1.5 2.775-1.5 2.955 0 3.495 1.95 3.495 4.485V16.5h-3v-4.305c0-1.065-.015-2.43-1.485-2.43-1.485 0-1.71 1.155-1.71 2.355V16.5h-3v-9z"/>
                  </svg>
                  ORCID
                </span>
              </a>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Stats Glass Panel -->
      <div class="stats-glass-panel">
        <div class="panel-highlight"></div>
        <h3 class="stats-title">Project Scale</h3>
        <div class="stats-grid">
          <div class="stat-cell">
            <span class="stat-value" data-suffix="+">627K</span>
            <span class="stat-desc">Language & Runtime LOC</span>
          </div>
          <div class="stat-cell">
            <span class="stat-value" data-suffix="+">236K</span>
            <span class="stat-desc">Standard Library LOC</span>
          </div>
          <div class="stat-cell">
            <span class="stat-value" data-suffix="+">15M</span>
            <span class="stat-desc">Ontology Entities</span>
          </div>
          <div class="stat-cell compact">
            <span class="stat-value">6</span>
            <span class="stat-desc">Languages</span>
          </div>
          <div class="stat-cell compact">
            <span class="stat-value">2025</span>
            <span class="stat-desc">JOSS Submission</span>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Existing styles preserved */
  .about-inner {
    max-width: 820px;
    display: grid;
    gap: 1rem;
  }

  .about-inner h1 {
    font-size: clamp(2.2rem, 5.8vw, 4.6rem);
  }

  .about-inner p {
    color: var(--color-text-secondary);
    font-size: clamp(1rem, 2.4vw, 1.18rem);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .about-grid {
    display: grid;
    gap: 0.9rem;
  }

  .about-card,
  .about-image-card {
    border-radius: var(--radius-xl);
    padding: 1.1rem;
  }

  .about-image-card img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    object-fit: cover;
  }

  @media (min-width: 980px) {
    .about-grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      align-items: center;
    }
  }

  /* ========================================
     APPLE LIQUID GLASS DESIGN SYSTEM
     ======================================== */

  .author-section {
    padding: 3rem 1rem;
    background: linear-gradient(180deg, 
      transparent 0%,
      rgba(0,0,0,0.02) 50%,
      transparent 100%
    );
  }

  .author-container {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* Main Liquid Glass Card */
  .liquid-glass-card {
    position: relative;
    border-radius: 32px;
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(40px) saturate(180%);
    -webkit-backdrop-filter: blur(40px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow: 
      0 1px 2px rgba(0,0,0,0.02),
      0 4px 8px rgba(0,0,0,0.03),
      0 12px 24px rgba(0,0,0,0.04),
      0 24px 48px rgba(0,0,0,0.05),
      inset 0 1px 0 rgba(255,255,255,0.1);
    overflow: hidden;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), 
                box-shadow 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .liquid-glass-card:hover {
    box-shadow: 
      0 1px 2px rgba(0,0,0,0.02),
      0 8px 16px rgba(0,0,0,0.04),
      0 16px 32px rgba(0,0,0,0.06),
      0 32px 64px rgba(0,0,0,0.08),
      inset 0 1px 0 rgba(255,255,255,0.15);
  }

  /* Specular Highlight - The "Liquid" Effect */
  .glass-highlight {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 60%;
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.18) 0%,
      rgba(255, 255, 255, 0.08) 40%,
      rgba(255, 255, 255, 0.02) 70%,
      transparent 100%
    );
    border-radius: 32px 32px 50% 50% / 32px 32px 20% 20%;
    pointer-events: none;
    z-index: 1;
  }

  .card-content {
    position: relative;
    z-index: 2;
    padding: 2.5rem;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  /* Avatar with Glass Ring */
  .avatar-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .avatar-glass-ring {
    position: relative;
    width: 140px;
    height: 140px;
    border-radius: 50%;
    padding: 4px;
    background: linear-gradient(
      135deg,
      rgba(255,255,255,0.4) 0%,
      rgba(255,255,255,0.1) 50%,
      rgba(255,255,255,0.2) 100%
    );
    box-shadow: 
      0 0 0 1px rgba(255,255,255,0.2),
      0 8px 32px rgba(0,0,0,0.15),
      inset 0 2px 4px rgba(255,255,255,0.3);
  }

  .author-avatar {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid rgba(255,255,255,0.3);
    box-shadow: inset 0 2px 8px rgba(0,0,0,0.2);
  }

  .avatar-glow {
    position: absolute;
    inset: -10px;
    border-radius: 50%;
    background: radial-gradient(
      circle at 30% 30%,
      rgba(196, 165, 116, 0.3) 0%,
      rgba(196, 165, 116, 0.1) 40%,
      transparent 70%
    );
    filter: blur(20px);
    z-index: -1;
    opacity: 0.6;
  }

  /* Content Stack */
  .content-stack {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .title-row {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .author-title {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.5);
    margin: 0;
  }

  .title-underline {
    width: 40px;
    height: 2px;
    background: linear-gradient(
      90deg,
      rgba(196, 165, 116, 0.8),
      rgba(196, 165, 116, 0.2)
    );
    border-radius: 1px;
  }

  .name-role {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .author-name {
    font-size: 1.75rem;
    font-weight: 600;
    color: rgba(255,255,255,0.95);
    letter-spacing: -0.02em;
    text-shadow: 0 1px 2px rgba(0,0,0,0.1);
  }

  .role-badge {
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.35rem 0.75rem;
    background: rgba(196, 165, 116, 0.15);
    border: 1px solid rgba(196, 165, 116, 0.25);
    border-radius: 100px;
    color: rgba(196, 165, 116, 0.9);
    letter-spacing: 0.02em;
    backdrop-filter: blur(10px);
  }

  .bio-text {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .bio-text p {
    font-size: 1rem;
    line-height: 1.7;
    color: rgba(255,255,255,0.65);
    margin: 0;
    font-weight: 400;
  }

  .bio-text .heritage {
    font-size: 0.9375rem;
    color: rgba(255,255,255,0.5);
    font-style: italic;
    padding-left: 1rem;
    border-left: 2px solid rgba(196, 165, 116, 0.3);
  }

  .bio-text .heritage em {
    color: rgba(196, 165, 116, 0.8);
    font-style: normal;
    font-weight: 500;
  }

  /* Liquid Glass Buttons */
  .action-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .glass-button {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1.25rem;
    border-radius: 100px;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    color: rgba(255,255,255,0.9);
    overflow: hidden;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .glass-button::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 100px;
    padding: 1px;
    background: linear-gradient(
      135deg,
      rgba(255,255,255,0.4) 0%,
      rgba(255,255,255,0.1) 50%,
      rgba(255,255,255,0.2) 100%
    );
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
  }

  .button-glass {
    position: absolute;
    inset: 0;
    background: rgba(255,255,255,0.08);
    backdrop-filter: blur(20px) saturate(150%);
    border-radius: 100px;
    transition: background 0.2s ease;
  }

  .glass-button:hover .button-glass {
    background: rgba(255,255,255,0.12);
  }

  .glass-button:active {
    transform: scale(0.96);
  }

  .glass-button.secondary {
    color: rgba(255,255,255,0.6);
  }

  .glass-button.secondary .button-glass {
    background: rgba(255,255,255,0.03);
  }

  .glass-button.secondary:hover .button-glass {
    background: rgba(255,255,255,0.06);
  }

  .button-content {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* Stats Glass Panel */
  .stats-glass-panel {
    position: relative;
    border-radius: 24px;
    background: rgba(255,255,255,0.04);
    backdrop-filter: blur(30px) saturate(150%);
    -webkit-backdrop-filter: blur(30px) saturate(150%);
    border: 1px solid rgba(255,255,255,0.08);
    padding: 2rem;
    overflow: hidden;
  }

  .panel-highlight {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 50%;
    background: linear-gradient(
      180deg,
      rgba(255,255,255,0.08) 0%,
      transparent 100%
    );
    border-radius: 24px 24px 40% 40% / 24px 24px 15% 15%;
    pointer-events: none;
  }

  .stats-title {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.35);
    margin: 0 0 1.5rem 0;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 1.5rem;
  }

  .stat-cell {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 1rem;
    background: rgba(255,255,255,0.03);
    border-radius: 16px;
    border: 1px solid rgba(255,255,255,0.06);
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .stat-cell:hover {
    background: rgba(255,255,255,0.05);
    transform: translateY(-2px);
  }

  .stat-cell.compact {
    padding: 0.75rem 1rem;
  }

  .stat-value {
    font-size: 1.75rem;
    font-weight: 600;
    color: rgba(196, 165, 116, 0.9);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .stat-value::after {
    content: attr(data-suffix);
    font-size: 0.875rem;
    opacity: 0.7;
  }

  .stat-desc {
    font-size: 0.8125rem;
    color: rgba(255,255,255,0.4);
    line-height: 1.4;
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .card-content {
      grid-template-columns: 1fr;
      padding: 2rem;
      gap: 1.5rem;
    }

    .avatar-wrapper {
      justify-content: flex-start;
    }

    .avatar-glass-ring {
      width: 100px;
      height: 100px;
    }

    .author-name {
      font-size: 1.375rem;
    }

    .liquid-glass-card,
    .stats-glass-panel {
      border-radius: 24px;
    }

    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
  }

  @media (min-width: 980px) {
    .author-container {
      flex-direction: row;
      align-items: stretch;
    }

    .liquid-glass-card {
      flex: 1.2;
    }

    .stats-glass-panel {
      flex: 0.8;
      display: flex;
      flex-direction: column;
    }

    .stats-grid {
      grid-template-columns: 1fr 1fr;
      flex: 1;
    }
  }

  /* Dark mode adjustments for liquid glass */
  @media (prefers-color-scheme: light) {
    .liquid-glass-card {
      background: rgba(255,255,255,0.7);
      border-color: rgba(255,255,255,0.5);
      box-shadow: 
        0 1px 2px rgba(0,0,0,0.05),
        0 4px 8px rgba(0,0,0,0.08),
        0 12px 24px rgba(0,0,0,0.1),
        inset 0 1px 0 rgba(255,255,255,0.8);
    }

    .glass-highlight {
      background: linear-gradient(
        180deg,
        rgba(255,255,255,0.9) 0%,
        rgba(255,255,255,0.4) 40%,
        rgba(255,255,255,0.1) 70%,
        transparent 100%
      );
    }

    .author-title {
      color: rgba(0,0,0,0.4);
    }

    .author-name {
      color: rgba(0,0,0,0.9);
    }

    .bio-text p {
      color: rgba(0,0,0,0.6);
    }

    .bio-text .heritage {
      color: rgba(0,0,0,0.45);
      border-left-color: rgba(196, 165, 116, 0.4);
    }

    .glass-button {
      color: rgba(0,0,0,0.8);
    }

    .glass-button::before {
      background: linear-gradient(
        135deg,
        rgba(0,0,0,0.15) 0%,
        rgba(0,0,0,0.05) 50%,
        rgba(0,0,0,0.1) 100%
      );
    }

    .button-glass {
      background: rgba(0,0,0,0.03);
    }

    .stats-glass-panel {
      background: rgba(255,255,255,0.5);
      border-color: rgba(255,255,255,0.4);
    }

    .stats-title {
      color: rgba(0,0,0,0.35);
    }

    .stat-cell {
      background: rgba(0,0,0,0.03);
      border-color: rgba(0,0,0,0.06);
    }

    .stat-desc {
      color: rgba(0,0,0,0.5);
    }
  }
</style>
