---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocaleFromUrl, getLocalizedPath, loadTranslations } from '../../lib/i18n';
import {
  escapeFullSuite,
  escapeStdlibInventoryFiles,
} from '../../lib/claimEscapes';
import { reliabilityFace, reliabilityMayPrint, reliabilityRefusal, reliabilityShortRefusal } from '../../lib/stdlibReliabilityHonesty';
import { FORMER_LANGUAGE_NAME, FORMER_RELEASE_URL } from '../../lib/structured-data.mjs';

const locale = getLocaleFromUrl(Astro.url);
const t = await loadTranslations(locale);
const reliabilityOk = reliabilityMayPrint();

const aboutTitle = 'About Sounio and creator Demetrios Chiuratto Agourakis';
const aboutDescription = 'Sounio is an open-source language for units and uncertainty, created by Demetrios Chiuratto Agourakis (PUC-SP). Project facts, contributors and links.';
const pageTitle = locale === 'en' ? aboutTitle : t.page_about_title;
const pageDescription = locale === 'en' ? aboutDescription : t.page_about_desc;

const demetriosId = 'https://www.souniolang.org/about/#demetrios';
const dionisioId = 'https://www.souniolang.org/about/#dionisio';
const siteOrigin = (Astro.site?.toString() || 'https://www.souniolang.org/').replace(/\/$/, '');

const aboutSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": demetriosId,
      "name": "Demetrios Chiuratto Agourakis",
      "url": "https://www.souniolang.org/about/",
      "description": "Final-year medical student and M.Sc. student at PUC-SP; creator and main author of the Sounio programming language.",
      "affiliation": {
        "@type": "CollegeOrUniversity",
        "name": "Pontifícia Universidade Católica de São Paulo"
      },
      "alumniOf": {
        "@type": "CollegeOrUniversity",
        "name": "Escola Superior de Química Oswaldo Cruz"
      },
      "sameAs": [
        "https://orcid.org/0009-0001-8671-8878",
        "https://github.com/agourakis82",
        "https://www.linkedin.com/in/demetrios-chiuratto-agourakis-50b8a9169",
        "https://huggingface.co/chiuratto-AIgourakis"
      ]
    },
    {
      "@type": "Person",
      "@id": dionisioId,
      "name": "Dionisio Chiuratto Agourakis",
      "sameAs": ["https://orcid.org/0009-0000-4863-9143"]
    },
    {
      "@type": "SoftwareApplication",
      "name": "Sounio",
      "alternateName": FORMER_LANGUAGE_NAME,
      "sameAs": [FORMER_RELEASE_URL],
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "Linux x86_64 (committed prebuilt); macOS arm64 (source-built)",
      "programmingLanguage": "Sounio",
      "license": "https://opensource.org/licenses/Apache-2.0",
      "downloadUrl": "https://github.com/Sounio-lang/sounio",
      "codeRepository": "https://github.com/Sounio-lang/sounio",
      "author": [
        { "@id": demetriosId },
        { "@id": dionisioId }
      ],
      "creator": { "@id": demetriosId },
      "description": pageDescription,
      "url": siteOrigin,
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": t.nav_home || "Home",
          "item": Astro.site?.toString() || "https://www.souniolang.org/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": t.page_about_title || "About",
          "item": new URL(getLocalizedPath('/about', locale), Astro.site).toString()
        }
      ]
    }
  ]
};
---

<BaseLayout title={pageTitle} description={pageDescription} schema={aboutSchema} omitSoftwareApplication={true}>

  {/* ── Hero ─────────────────────────────────────────────────── */}
  <section class="section-shell about-hero">
    <div class="container about-hero-inner">
      <span class="badge-pill">About</span>
      <h1>Sounio is building software that communicates the quality of its own knowledge.</h1>
      <p>
        Sounio is a scientific programming language: statically typed, effect-annotated
        and self-hosted, with first-class epistemic types &mdash; for computation that must
        account for what it doesn&rsquo;t know. Milestones still ahead are on the
        <a class="about-inline-link" href={getLocalizedPath('/about/roadmap', locale)}>Sounio programming language roadmap</a>.
      </p>
      <p>
        Sounio (formerly Demetrios). Sounio was previously released as Demetrios, the former name of this language.
      </p>
      <div class="about-hero-actions">
        <a href={getLocalizedPath('/about/vision', locale)} class="hero-cta primary">Read Vision</a>
        <a href={getLocalizedPath('/about/roadmap', locale)} class="hero-cta secondary">View Roadmap</a>
      </div>
    </div>
  </section>

  {/* ── Design Principle ────────────────────────────────────── */}
  <section class="about-principle-section">
    <div class="container about-principle-inner">
      <p class="about-principle-label">DESIGN PRINCIPLE</p>
      <p class="about-principle-text">
        A language for science should never erase provenance<br class="br-sm" />
        or confidence signals just because a result reached a scalar.
      </p>
    </div>
  </section>

  {/* ── Heritage image ──────────────────────────────────────── */}
  <div class="about-image-full" aria-hidden="true">
    <picture>
      <source
        srcset="/assets/original-artworks/pappou_hero_1280.webp 1280w, /assets/original-artworks/pappou_hero_1536.webp 1536w"
        sizes="100vw"
        type="image/webp"
      />
      <img src="/assets/original-artworks/pappou_hero.png" alt="" loading="lazy" decoding="async" />
    </picture>
    <div class="about-image-overlay"></div>
  </div>

  {/* ── Author + Stats ──────────────────────────────────────── */}
  <section class="section-shell">
    <div class="container author-grid">
      <div class="author-bio">
        <div class="author-header">
          <img
            src="/assets/author.jpg"
            alt="Demetrios Chiuratto Agourakis"
            class="author-photo"
            width="96"
            height="96"
            loading="lazy"
          />
          <div class="author-title-block">
            <h2 class="author-heading">Demetrios Chiuratto Agourakis — creator and main author</h2>
          </div>
        </div>
        <div class="author-content">
          <p>
            Demetrios Chiuratto Agourakis is a final-year medical student at Faculdade São Leopoldo Mandic and an M.Sc. student in the Graduate Program in Biomaterials and Regenerative Medicine at PUC-SP, supervised by Prof. Marli Gerenutti. He trained as a chemical engineer at Escola Superior de Química Oswaldo Cruz. His preprints cover Ollivier–Ricci curvature of complex networks and zero divisors in the sedenions ("A Dual Pathway to 168", <a class="about-inline-link" href="https://doi.org/10.22541/au.177507195.52530214/v1">a preprint on Authorea</a>). He created Sounio in December 2025 and is its main author.
          </p>
          <p class="author-links">
            <a href="https://orcid.org/0009-0001-8671-8878" class="author-link" target="_blank" rel="noopener">ORCID</a>
            <span aria-hidden="true">·</span>
            <a href="https://github.com/agourakis82" class="author-link" target="_blank" rel="noopener">GitHub</a>
            <span aria-hidden="true">·</span>
            <a href="https://www.linkedin.com/in/demetrios-chiuratto-agourakis-50b8a9169" class="author-link" target="_blank" rel="noopener">LinkedIn</a>
          </p>
          <p>
            The name &ldquo;Sounio&rdquo; reflects both personal heritage and architectural philosophy: Cape Sounion (&Sigma;&omicron;&upsilon;&nu;&iota;&omicron;),
            where ancient Greek mariners made crucial decisions at the boundary of known waters, embodies the epistemic
            boundary where certainty meets uncertainty&mdash;a metaphor central to the language&rsquo;s design.
          </p>
        </div>
      </div>

      <aside class="glass author-stats">
        <h2 class="stats-heading">Project at a Glance</h2>
        <ul class="stats-list">
          <li><span class="stat-number">3,224</span><span class="stat-label">commits</span></li>
          <li><span class="stat-number">{escapeStdlibInventoryFiles()}</span><span class="stat-label">stdlib .sio files</span></li>
          <li><span class="stat-number">{reliabilityOk ? reliabilityFace() : reliabilityShortRefusal()}</span><span class="stat-label">{reliabilityOk ? 'stdlib reliability gate' : reliabilityRefusal()}</span></li>
          <li><span class="stat-number">{escapeFullSuite("—")}</span><span class="stat-label">full suite</span></li>
          <li><span class="stat-number">1,000+</span><span class="stat-label">e-graph rewrite rules</span></li>
          <li><span class="stat-number">86K</span><span class="stat-label">max parameters (O-SSM)</span></li>
        </ul>
      </aside>
    </div>
  </section>

  {/* ── Authors ─────────────────────────────────────────────── */}
  <section class="section-shell authors-section">
    <div class="container authors-inner">
      <h2 class="authors-heading">Authors</h2>
      <div class="authors-list">
        <p>Demetrios Chiuratto Agourakis — creator and main author.</p>
        <p>Dionisio Chiuratto Agourakis — co-author. Demetrios's brother; contributes occasionally and is an intellectual sparring partner on the project.</p>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Hero ──────────────────────────────────────────────────── */
  .about-hero-inner {
    max-width: 820px;
    display: grid;
    gap: 1rem;
  }

  .about-hero-inner h1 {
    font-size: clamp(2.2rem, 5.8vw, 4.6rem);
    font-weight: 750;
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  .about-hero-inner p {
    color: var(--color-text-secondary);
    font-size: clamp(1rem, 2.4vw, 1.18rem);
    max-width: 60ch;
  }

  .about-inline-link {
    color: var(--color-accent-gold-soft, #d6b35a);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .about-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 0.5rem;
  }

  /* ── Design Principle ─────────────────────────────────────── */
  .about-principle-section {
    padding: clamp(3rem, 6vw, 5rem) 0;
    border-top: 1px solid var(--glass-border);
    border-bottom: 1px solid var(--glass-border);
  }

  .about-principle-inner {
    max-width: 900px;
    display: grid;
    gap: 1.1rem;
  }

  .about-principle-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--color-accent-gold-soft, #d6b35a);
    font-family: var(--font-mono);
    margin: 0;
  }

  .about-principle-text {
    font-family: var(--font-display, Georgia, serif);
    font-size: clamp(1.5rem, 3.5vw, 2.4rem);
    font-weight: 400;
    line-height: 1.35;
    color: var(--color-text-primary);
    margin: 0;
  }

  .br-sm {
    display: none;
  }

  @media (min-width: 640px) {
    .br-sm {
      display: inline;
    }
  }

  /* ── Heritage image ───────────────────────────────────────── */
  .about-image-full {
    position: relative;
    height: clamp(220px, 38vw, 480px);
    overflow: hidden;
  }

  .about-image-full picture,
  .about-image-full img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .about-image-full img {
    object-fit: cover;
    object-position: center 35%;
  }

  .about-image-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgba(7, 22, 44, 0.2) 0%, rgba(7, 22, 44, 0.78) 100%),
      radial-gradient(ellipse 70% 60% at 60% 40%, rgba(214, 179, 90, 0.12), transparent 70%);
  }

  /* ── Author ───────────────────────────────────────────────── */
  .author-grid {
    display: grid;
    gap: 2rem;
    align-items: start;
  }

  .author-bio {
    display: grid;
    gap: 1.5rem;
  }

  .author-header {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .author-photo {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--color-gold, #c4a574);
    flex-shrink: 0;
  }

  .author-title-block {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding-top: 0.2rem;
  }

  .author-heading {
    font-size: 1.2rem;
    font-weight: 650;
    line-height: 1.35;
    color: var(--color-text-primary);
    margin: 0;
  }

  .author-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.65rem;
  }

  .author-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.7rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-md);
    color: var(--color-text-secondary);
    font-size: 0.82rem;
    text-decoration: none;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .author-link:hover {
    border-color: var(--color-gold, #c4a574);
    color: var(--color-text-primary);
  }

  .author-content p {
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin: 0 0 0.75rem;
    font-size: 0.95rem;
  }

  .author-content p:last-child {
    margin-bottom: 0;
  }

  /* ── Stats ────────────────────────────────────────────────── */
  .author-stats {
    border-radius: var(--radius-xl);
    padding: 1.5rem;
  }

  .stats-heading {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
    margin: 0 0 1.25rem;
  }

  .stats-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0;
  }

  .stats-list li {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    border-bottom: 1px solid var(--glass-border);
    padding: 0.75rem 0;
  }

  .stats-list li:first-child {
    padding-top: 0;
  }

  .stats-list li:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .stat-number {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--color-gold, #c4a574);
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .stat-label {
    font-size: 0.82rem;
    color: var(--color-text-secondary);
  }

  /* ── Authors ──────────────────────────────────────────────── */
  .authors-section {
    border-top: 1px solid var(--glass-border);
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
  }

  .authors-inner {
    max-width: 820px;
    display: grid;
    gap: 0.75rem;
  }

  .authors-heading {
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
    margin: 0;
  }

  .authors-list {
    display: grid;
    gap: 0.65rem;
  }

  .authors-list p {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* ── Responsive ───────────────────────────────────────────── */
  @media (min-width: 980px) {
    .author-grid {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    // Hero cascade
    gsap.from('.about-hero-inner > *', {
      y: 24, opacity: 0, stagger: 0.13, duration: 0.7, ease: 'power2.out',
    });

    // Design principle
    const tlP = gsap.timeline({ scrollTrigger: { trigger: '.about-principle-section', start: 'top 76%', once: true } });
    tlP.from('.about-principle-label', { y: 12, opacity: 0, duration: 0.4, ease: 'power2.out' })
       .from('.about-principle-text', { y: 22, opacity: 0, duration: 0.65, ease: 'power2.out' }, '-=0.2');

    // Author + stats
    const tlA = gsap.timeline({ scrollTrigger: { trigger: '.author-grid', start: 'top 76%', once: true } });
    tlA.from('.author-header', { y: 20, opacity: 0, duration: 0.55, ease: 'power2.out' })
       .from('.author-content', { y: 18, opacity: 0, duration: 0.55, ease: 'power2.out' }, '-=0.3')
       .from('.author-stats', { y: 24, opacity: 0, duration: 0.6, ease: 'power2.out' }, '-=0.4')
       .from('.stats-list li', { x: -12, opacity: 0, stagger: 0.07, duration: 0.45, ease: 'power2.out' }, '-=0.25');

    // Authors
    gsap.from('.authors-inner > *', {
      y: 14, opacity: 0, stagger: 0.1, duration: 0.45, ease: 'power2.out',
      scrollTrigger: { trigger: '.authors-section', start: 'top 82%', once: true },
    });
  });
</script>
