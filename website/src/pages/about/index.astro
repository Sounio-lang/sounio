---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocaleFromUrl, getLocalizedPath } from '../../lib/i18n';

const locale = getLocaleFromUrl(Astro.url);
---

<BaseLayout title="About" description="Sounio mission and project context">
  <section class="section-shell about-hero">
    <div class="container about-inner">
      <span class="badge-pill">About</span>
      <h1>Sounio is building software that communicates the quality of its own knowledge.</h1>
      <p>
        We design language and tooling infrastructure for scientists and engineers who need both computational performance
        and defensible uncertainty handling in production systems.
      </p>
      <div class="hero-actions">
        <a href={getLocalizedPath('/about/vision', locale)} class="hero-cta primary">Read Vision</a>
        <a href={getLocalizedPath('/about/roadmap', locale)} class="hero-cta secondary">View Roadmap</a>
      </div>
    </div>
  </section>

  <section class="section-shell">
    <div class="container about-grid">
      <article class="glass glass-specular about-card">
        <h2 class="section-heading">Design Principle</h2>
        <p class="section-subhead">
          A language for science should never erase provenance or confidence signals just because a result reached a scalar.
        </p>
      </article>
      <article class="glass about-image-card">
        <picture>
          <source
            srcset="/assets/original-artworks/pappou_hero_1280.webp 1280w, /assets/original-artworks/pappou_hero_1536.webp 1536w"
            sizes="(min-width: 980px) 48vw, 94vw"
            type="image/webp"
          />
          <img src="/assets/original-artworks/pappou_hero.png" alt="Sounio heritage artwork" loading="lazy" decoding="async" />
        </picture>
      </article>
    </div>
  </section>

  <section class="section-shell about-author">
    <div class="container author-grid">
      <article class="glass about-author-card">
        <div class="author-header">
          <img src="/assets/author.jpg" alt="Demetrios Chiuratto Agourakis" class="author-photo" />
          <div class="author-title">
            <h2 class="section-heading">About the Author</h2>
            <p class="author-name">Demetrios Chiuratto Agourakis</p>
            <p class="author-role">Creator & Lead Architect</p>
          </div>
        </div>
        <div class="author-content">
          <p>
            Demetrios is a software architect and researcher specializing in epistemic computing, scientific programming 
            languages, and high-performance systems. With a background spanning systems engineering, computational biology, 
            and language design, he created Sounio to address the fundamental gap between scientific rigor and software 
            engineering practice.
          </p>
          <p>
            The name "Sounio" reflects both personal heritage and architectural philosophy: Cape Sounion (Σούνιο), 
            where ancient Greek mariners made crucial decisions at the boundary of known waters, embodies the epistemic 
            boundary where certainty meets uncertainty—a metaphor central to the language's design.
          </p>
          <div class="author-links">
            <a href="https://github.com/demetrios-agourakis" class="author-link" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
              GitHub
            </a>
            <a href="https://orcid.org/0009-0000-0000-0000" class="author-link" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zM7.5 7.5h3v9h-3v-9zm1.5-2a1.5 1.5 0 110-3 1.5 1.5 0 010 3zm6 2h3v1.5h.03c.39-.75 1.35-1.5 2.775-1.5 2.955 0 3.495 1.95 3.495 4.485V16.5h-3v-4.305c0-1.065-.015-2.43-1.485-2.43-1.485 0-1.71 1.155-1.71 2.355V16.5h-3v-9z"/></svg>
              ORCID
            </a>
          </div>
        </div>
      </article>
      <article class="glass author-stats">
        <h3>Project at a Glance</h3>
        <ul class="stats-list">
          <li><span class="stat-number">627K+</span> <span class="stat-label">lines of language/runtime code</span></li>
          <li><span class="stat-number">236K+</span> <span class="stat-label">lines of stdlib code</span></li>
          <li><span class="stat-number">15M+</span> <span class="stat-label">ontology entities</span></li>
          <li><span class="stat-number">6</span> <span class="stat-label">languages (i18n)</span></li>
          <li><span class="stat-number">2025</span> <span class="stat-label">JOSS submission</span></li>
        </ul>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .about-inner {
    max-width: 820px;
    display: grid;
    gap: 1rem;
  }

  .about-inner h1 {
    font-size: clamp(2.2rem, 5.8vw, 4.6rem);
  }

  .about-inner p {
    color: var(--color-text-secondary);
    font-size: clamp(1rem, 2.4vw, 1.18rem);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .about-grid {
    display: grid;
    gap: 0.9rem;
  }

  .about-card,
  .about-image-card {
    border-radius: var(--radius-xl);
    padding: 1.1rem;
  }

  .about-image-card img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    object-fit: cover;
  }

  /* About Author Section */
  .author-grid {
    display: grid;
    gap: 0.9rem;
  }

  .about-author-card {
    border-radius: var(--radius-xl);
    padding: 1.5rem;
  }

  .author-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .author-photo {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--color-gold, #c4a574);
  }

  .author-title {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .author-name {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0;
  }

  .author-role {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .author-content p {
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: 0.75rem;
  }

  .author-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .author-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.875rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text);
    font-size: 0.875rem;
    text-decoration: none;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .author-link:hover {
    background: var(--color-surface-hover);
    border-color: var(--color-gold, #c4a574);
  }

  .author-stats {
    border-radius: var(--radius-xl);
    padding: 1.5rem;
  }

  .author-stats h3 {
    font-size: 1.1rem;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  .stats-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }

  .stats-list li {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .stat-number {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-gold, #c4a574);
    font-variant-numeric: tabular-nums;
  }

  .stat-label {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }

  @media (min-width: 640px) {
    .author-header {
      flex-direction: row;
      align-items: center;
    }
  }

  @media (min-width: 980px) {
    .about-grid,
    .author-grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      align-items: start;
    }
  }
</style>
