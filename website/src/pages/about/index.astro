---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocaleFromUrl, getLocalizedPath } from '../../lib/i18n';

const locale = getLocaleFromUrl(Astro.url);
---

<BaseLayout title="About" description="Sounio mission and project context">
  <section class="section-shell about-hero">
    <div class="container about-inner">
      <span class="badge-pill">About</span>
      <h1>Sounio is building software that communicates the quality of its own knowledge.</h1>
      <p>
        We design language and tooling infrastructure for scientists and engineers who need both computational performance
        and defensible uncertainty handling in production systems.
      </p>
      <div class="hero-actions">
        <a href={getLocalizedPath('/about/vision', locale)} class="hero-cta primary">Read Vision</a>
        <a href={getLocalizedPath('/about/roadmap', locale)} class="hero-cta secondary">View Roadmap</a>
      </div>
    </div>
  </section>

  <section class="section-shell">
    <div class="container about-grid">
      <article class="glass glass-specular about-card">
        <h2 class="section-heading">Design Principle</h2>
        <p class="section-subhead">
          A language for science should never erase provenance or confidence signals just because a result reached a scalar.
        </p>
      </article>
      <article class="glass about-image-card">
        <picture>
          <source
            srcset="/assets/original-artworks/pappou_hero_1280.webp 1280w, /assets/original-artworks/pappou_hero_1536.webp 1536w"
            sizes="(min-width: 980px) 48vw, 94vw"
            type="image/webp"
          />
          <img src="/assets/original-artworks/pappou_hero.png" alt="Sounio heritage artwork" loading="lazy" decoding="async" />
        </picture>
      </article>
    </div>
  </section>

  <!-- Liquid Glass Author Section -->
  <section class="lg-section">
    <!-- Deep background layer for contrast -->
    <div class="lg-bg-layer"></div>
    
    <div class="lg-wrapper">
      <!-- Primary Glass Card -->
      <div class="glass-card main">
        <!-- Glass surface layers -->
        <div class="glass-surface"></div>
        <div class="glass-blur"></div>
        <div class="glass-shine"></div>
        <div class="glass-edge"></div>
        
        <!-- Content -->
        <div class="card-content">
          <!-- Avatar -->
          <div class="avatar-container">
            <div class="avatar-frame">
              <img src="/assets/author.jpg" alt="Demetrios Chiuratto Agourakis" />
              <div class="avatar-shine"></div>
            </div>
            <div class="avatar-aura"></div>
          </div>
          
          <!-- Text content -->
          <div class="text-content">
            <header>
              <span class="overline">About the Author</span>
              <h2 class="headline">Demetrios Chiuratto Agourakis</h2>
              <span class="subhead">Creator & Lead Architect</span>
            </header>
            
            <div class="body-text">
              <p>
                Software architect and researcher specializing in epistemic computing and scientific programming 
                languages. Created Sounio to bridge the gap between scientific rigor and software engineering.
              </p>
              <p class="heritage">
                The name <em>Sounio</em> (Σούνιο) reflects Cape Sounion's ancient boundary between known waters 
                and the unknown sea—a metaphor for computing at the edge of certainty.
              </p>
            </div>
            
            <!-- Buttons -->
            <div class="actions">
              <a href="https://github.com/demetrios-agourakis" class="pill-button primary" target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                  <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
                </svg>
                GitHub
              </a>
              <a href="https://orcid.org/0009-0000-0000-0000" class="pill-button" target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                  <path d="M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zM7.5 7.5h3v9h-3v-9zm1.5-2a1.5 1.5 0 110-3 1.5 1.5 0 010 3zm6 2h3v1.5h.03c.39-.75 1.35-1.5 2.775-1.5 2.955 0 3.495 1.95 3.495 4.485V16.5h-3v-4.305c0-1.065-.015-2.43-1.485-2.43-1.485 0-1.71 1.155-1.71 2.355V16.5h-3v-9z"/>
                </svg>
                ORCID
              </a>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Stats Glass Card -->
      <div class="glass-card stats">
        <div class="glass-surface"></div>
        <div class="glass-blur"></div>
        <div class="glass-shine"></div>
        <div class="glass-edge"></div>
        
        <div class="stats-content">
          <h3 class="stats-overline">Project Scale</h3>
          
          <div class="stats-list">
            <div class="stat-item">
              <span class="stat-num">627K<span class="plus">+</span></span>
              <span class="stat-desc">Language & Runtime LOC</span>
            </div>
            <div class="stat-item">
              <span class="stat-num">236K<span class="plus">+</span></span>
              <span class="stat-desc">Standard Library LOC</span>
            </div>
            <div class="stat-item">
              <span class="stat-num">15M<span class="plus">+</span></span>
              <span class="stat-desc">Ontology Entities</span>
            </div>
            <div class="stat-item small">
              <span class="stat-num">6</span>
              <span class="stat-desc">Languages</span>
            </div>
            <div class="stat-item small">
              <span class="stat-num">2025</span>
              <span class="stat-desc">JOSS Submission</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ========================================
     APPLE LIQUID GLASS — AUTHENTIC SYSTEM
     ======================================== */

  .lg-section {
    position: relative;
    padding: 4rem 1.5rem 5rem;
    margin: 2rem 0;
    overflow: hidden;
  }

  /* Background gradient for glass contrast */
  .lg-bg-layer {
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(ellipse 80% 50% at 50% 0%, rgba(196, 165, 116, 0.15) 0%, transparent 60%),
      radial-gradient(ellipse 60% 40% at 80% 100%, rgba(43, 166, 179, 0.1) 0%, transparent 50%),
      linear-gradient(180deg, 
        rgba(11, 30, 58, 0) 0%,
        rgba(11, 30, 58, 0.5) 30%,
        rgba(11, 30, 58, 0.8) 70%,
        rgba(11, 30, 58, 0) 100%
      );
    pointer-events: none;
  }

  .lg-wrapper {
    position: relative;
    z-index: 1;
    max-width: 1080px;
    margin: 0 auto;
    display: grid;
    gap: 1.25rem;
  }

  /* ========================================
     LIQUID GLASS CARD COMPONENT
     ======================================== */

  .glass-card {
    position: relative;
    border-radius: 32px;
    overflow: hidden;
    /* Apple-style layered shadow */
    box-shadow:
      /* Inner light glow */
      inset 0 0.5px 0.5px rgba(255,255,255,0.4),
      inset 0 1px 2px rgba(255,255,255,0.2),
      /* Edge highlight */
      0 0 0 0.5px rgba(255,255,255,0.12),
      /* Ambient shadows */
      0 2px 4px rgba(0,0,0,0.15),
      0 8px 16px rgba(0,0,0,0.15),
      0 16px 32px rgba(0,0,0,0.15),
      0 32px 64px rgba(0,0,0,0.2);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .glass-card:hover {
    transform: translateY(-2px);
    box-shadow:
      inset 0 0.5px 0.5px rgba(255,255,255,0.5),
      inset 0 1px 2px rgba(255,255,255,0.25),
      0 0 0 0.5px rgba(255,255,255,0.15),
      0 4px 8px rgba(0,0,0,0.15),
      0 12px 24px rgba(0,0,0,0.18),
      0 24px 48px rgba(0,0,0,0.2),
      0 48px 96px rgba(0,0,0,0.25);
  }

  /* Glass material layers */
  .glass-surface {
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 32px;
  }

  .glass-blur {
    position: absolute;
    inset: 0;
    backdrop-filter: blur(80px) saturate(220%);
    -webkit-backdrop-filter: blur(80px) saturate(220%);
    border-radius: 32px;
  }

  /* Specular highlight - the "wet" look */
  .glass-shine {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 55%;
    background: linear-gradient(
      180deg,
      rgba(255,255,255,0.35) 0%,
      rgba(255,255,255,0.18) 30%,
      rgba(255,255,255,0.08) 55%,
      transparent 80%
    );
    border-radius: 32px 32px 50% 50% / 32px 32px 25% 25%;
    pointer-events: none;
  }

  /* Edge glow effect */
  .glass-edge {
    position: absolute;
    inset: 0;
    border-radius: 32px;
    padding: 1px;
    background: linear-gradient(
      160deg,
      rgba(255,255,255,0.3) 0%,
      rgba(255,255,255,0.05) 40%,
      rgba(255,255,255,0.1) 60%,
      rgba(255,255,255,0.2) 100%
    );
    -webkit-mask: 
      linear-gradient(#fff 0 0) content-box, 
      linear-gradient(#fff 0 0);
    mask: 
      linear-gradient(#fff 0 0) content-box, 
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  /* ========================================
     MAIN CARD CONTENT
     ======================================== */

  .glass-card.main {
    min-height: 360px;
  }

  .card-content {
    position: relative;
    z-index: 2;
    padding: 2.25rem;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 2rem;
    align-items: start;
  }

  /* Avatar with glass frame */
  .avatar-container {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .avatar-frame {
    position: relative;
    width: 120px;
    height: 120px;
    border-radius: 50%;
    overflow: hidden;
    box-shadow:
      0 8px 32px rgba(0,0,0,0.3),
      inset 0 2px 4px rgba(0,0,0,0.3),
      /* Glass ring */
      0 0 0 3px rgba(255,255,255,0.15),
      0 0 0 4px rgba(255,255,255,0.05);
  }

  .avatar-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Shine on avatar */
  .avatar-shine {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 45%;
    background: linear-gradient(
      180deg,
      rgba(255,255,255,0.25) 0%,
      rgba(255,255,255,0.05) 60%,
      transparent 100%
    );
    border-radius: 60px 60px 35% 35% / 60px 60px 25% 25%;
    pointer-events: none;
  }

  /* Ambient glow */
  .avatar-aura {
    position: absolute;
    inset: -20px;
    border-radius: 50%;
    background: radial-gradient(
      circle at 30% 30%,
      rgba(196, 165, 116, 0.4) 0%,
      rgba(196, 165, 116, 0.15) 40%,
      transparent 70%
    );
    filter: blur(30px);
    z-index: -1;
    opacity: 0.6;
    animation: auraPulse 5s ease-in-out infinite;
  }

  @keyframes auraPulse {
    0%, 100% { opacity: 0.4; transform: scale(0.95); }
    50% { opacity: 0.7; transform: scale(1.05); }
  }

  /* Text styling */
  .text-content {
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
  }

  .overline {
    display: block;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.45);
    margin-bottom: 0.375rem;
  }

  .headline {
    font-size: 1.5rem;
    font-weight: 600;
    color: rgba(255,255,255,0.95);
    letter-spacing: -0.02em;
    margin: 0;
    line-height: 1.2;
    text-shadow: 0 1px 2px rgba(0,0,0,0.2);
  }

  .subhead {
    display: block;
    font-size: 0.8125rem;
    font-weight: 500;
    color: rgba(196, 165, 116, 0.9);
    letter-spacing: 0.02em;
    margin-top: 0.25rem;
  }

  .body-text {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .body-text p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: rgba(255,255,255,0.7);
    margin: 0;
  }

  .heritage {
    font-size: 0.875rem;
    color: rgba(255,255,255,0.5) !important;
    padding-left: 0.875rem;
    border-left: 2px solid rgba(196, 165, 116, 0.35);
    font-style: italic;
  }

  .heritage em {
    color: rgba(196, 165, 116, 0.9);
    font-style: normal;
    font-weight: 500;
  }

  /* Buttons */
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }

  .pill-button {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1.25rem;
    border-radius: 100px;
    font-size: 0.875rem;
    font-weight: 500;
    color: rgba(255,255,255,0.85);
    text-decoration: none;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.12);
    box-shadow: 
      inset 0 1px 1px rgba(255,255,255,0.1),
      0 1px 2px rgba(0,0,0,0.1);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    transition: all 0.2s ease;
  }

  .pill-button:hover {
    background: rgba(255,255,255,0.12);
    border-color: rgba(255,255,255,0.18);
    transform: translateY(-1px);
    box-shadow: 
      inset 0 1px 1px rgba(255,255,255,0.15),
      0 2px 4px rgba(0,0,0,0.15);
  }

  .pill-button:active {
    transform: translateY(0) scale(0.98);
  }

  .pill-button.primary {
    background: rgba(255,255,255,0.9);
    color: rgba(0,0,0,0.85);
    border-color: rgba(255,255,255,0.5);
    font-weight: 600;
  }

  .pill-button.primary:hover {
    background: rgba(255,255,255,0.95);
    box-shadow: 
      inset 0 1px 1px rgba(255,255,255,0.5),
      0 2px 8px rgba(0,0,0,0.2);
  }

  /* ========================================
     STATS CARD
     ======================================== */

  .glass-card.stats {
    padding: 1.75rem;
  }

  .stats-content {
    position: relative;
    z-index: 2;
  }

  .stats-overline {
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.35);
    margin: 0 0 1.25rem 0;
  }

  .stats-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.625rem;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem 0.875rem;
    background: rgba(255,255,255,0.05);
    border-radius: 16px;
    border: 1px solid rgba(255,255,255,0.08);
    box-shadow: inset 0 1px 1px rgba(255,255,255,0.05);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .stat-item:hover {
    background: rgba(255,255,255,0.08);
    border-color: rgba(255,255,255,0.12);
    transform: translateY(-2px);
  }

  .stat-item.small {
    padding: 0.75rem 0.875rem;
  }

  .stat-num {
    font-size: 1.375rem;
    font-weight: 600;
    color: rgba(196, 165, 116, 0.95);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .stat-num .plus {
    font-size: 0.75rem;
    font-weight: 500;
    opacity: 0.7;
    margin-left: 1px;
  }

  .stat-desc {
    font-size: 0.6875rem;
    color: rgba(255,255,255,0.45);
    line-height: 1.35;
  }

  /* ========================================
     RESPONSIVE
     ======================================== */

  @media (max-width: 768px) {
    .lg-section {
      padding: 2.5rem 1rem;
    }

    .card-content {
      grid-template-columns: 1fr;
      padding: 1.75rem;
      gap: 1.5rem;
    }

    .avatar-container {
      justify-content: flex-start;
    }

    .avatar-frame {
      width: 88px;
      height: 88px;
    }

    .headline {
      font-size: 1.25rem;
    }

    .glass-card,
    .glass-card.stats {
      border-radius: 24px;
      padding: 1.5rem;
    }

    .glass-shine {
      border-radius: 24px 24px 45% 45% / 24px 24px 22% 22%;
    }

    .stats-list {
      grid-template-columns: repeat(2, 1fr);
    }

    .stat-item:nth-child(3) {
      grid-column: span 2;
    }
  }

  @media (min-width: 980px) {
    .lg-wrapper {
      grid-template-columns: 1.3fr 0.7fr;
      align-items: stretch;
    }

    .glass-card.stats {
      display: flex;
      flex-direction: column;
    }

    .stats-content {
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .stats-list {
      flex: 1;
      grid-template-columns: 1fr 1fr;
      align-content: start;
    }

    .stat-item:nth-child(3) {
      grid-column: span 2;
    }
  }

  /* ========================================
     LIGHT MODE
     ======================================== */

  @media (prefers-color-scheme: light) {
    .glass-surface {
      background: rgba(255, 255, 255, 0.65);
    }

    .glass-shine {
      background: linear-gradient(
        180deg,
        rgba(255,255,255,0.9) 0%,
        rgba(255,255,255,0.5) 30%,
        rgba(255,255,255,0.2) 55%,
        transparent 80%
      );
    }

    .glass-edge {
      background: linear-gradient(
        160deg,
        rgba(255,255,255,0.6) 0%,
        rgba(255,255,255,0.2) 40%,
        rgba(255,255,255,0.3) 60%,
        rgba(255,255,255,0.4) 100%
      );
    }

    .glass-card {
      box-shadow:
        inset 0 0.5px 0.5px rgba(255,255,255,0.8),
        inset 0 1px 2px rgba(255,255,255,0.4),
        0 0 0 0.5px rgba(0,0,0,0.08),
        0 2px 4px rgba(0,0,0,0.08),
        0 8px 16px rgba(0,0,0,0.1),
        0 16px 32px rgba(0,0,0,0.12);
    }

    .overline {
      color: rgba(0,0,0,0.4);
    }

    .headline {
      color: rgba(0,0,0,0.9);
    }

    .body-text p {
      color: rgba(0,0,0,0.65);
    }

    .heritage {
      color: rgba(0,0,0,0.5) !important;
      border-left-color: rgba(196, 165, 116, 0.4);
    }

    .stat-item {
      background: rgba(0,0,0,0.04);
      border-color: rgba(0,0,0,0.08);
      box-shadow: inset 0 1px 1px rgba(255,255,255,0.5);
    }

    .stat-desc {
      color: rgba(0,0,0,0.5);
    }

    .pill-button {
      background: rgba(0,0,0,0.06);
      border-color: rgba(0,0,0,0.12);
      color: rgba(0,0,0,0.75);
      box-shadow: 
        inset 0 1px 1px rgba(255,255,255,0.3),
        0 1px 2px rgba(0,0,0,0.08);
    }

    .pill-button:hover {
      background: rgba(0,0,0,0.09);
    }

    .pill-button.primary {
      background: rgba(0,0,0,0.8);
      color: rgba(255,255,255,0.95);
      border-color: rgba(0,0,0,0.5);
    }
  }

  /* ========================================
     LEGACY STYLES
     ======================================== */

  .about-inner {
    max-width: 820px;
    display: grid;
    gap: 1rem;
  }

  .about-inner h1 {
    font-size: clamp(2.2rem, 5.8vw, 4.6rem);
  }

  .about-inner p {
    color: var(--color-text-secondary);
    font-size: clamp(1rem, 2.4vw, 1.18rem);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .about-grid {
    display: grid;
    gap: 0.9rem;
  }

  .about-card,
  .about-image-card {
    border-radius: var(--radius-xl);
    padding: 1.1rem;
  }

  .about-image-card img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    object-fit: cover;
  }

  @media (min-width: 980px) {
    .about-grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      align-items: center;
    }
  }
</style>
