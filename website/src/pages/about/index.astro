---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocaleFromUrl, getLocalizedPath, loadTranslations } from '../../lib/i18n';
import { publicContract } from '../../data/artifactStatus';

const locale = getLocaleFromUrl(Astro.url);
const t = await loadTranslations(locale);
const { metrics, versions } = publicContract;
const gate = metrics.stdlibReliabilityGate;
const full = metrics.fullTestSuite;

const aboutBreadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": t.nav_home || "Home",
      "item": Astro.site?.toString() || "https://www.souniolang.org/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": t.page_about_title || "About",
      "item": new URL(getLocalizedPath('/about', locale), Astro.site).toString()
    }
  ]
};
---

<BaseLayout title={t.page_about_title} description={t.page_about_desc} schema={aboutBreadcrumbSchema}>
  <section class="section-shell about-hero">
    <div class="container about-inner">
      <span class="badge-pill">About</span>
      <h1>Sounio is building software that communicates the quality of its own knowledge.</h1>
      <p>
        We design language and tooling infrastructure for scientists and engineers who need both computational performance
        and defensible uncertainty handling in production systems.
      </p>
      <div class="hero-actions">
        <a href={getLocalizedPath('/about/vision', locale)} class="hero-cta primary">Read Vision</a>
        <a href={getLocalizedPath('/about/roadmap', locale)} class="hero-cta secondary">View Roadmap</a>
      </div>
    </div>
  </section>

  <section class="section-shell about-principle-section">
    <div class="container about-principle-inner">
      <p class="about-principle-label">DESIGN PRINCIPLE</p>
      <p class="about-principle-text">
        A language for science should never erase provenance<br class="hidden sm:inline" /> or confidence signals just because a result reached a scalar.
      </p>
    </div>
  </section>

  <section class="about-image-full" aria-hidden="true">
    <picture>
      <source
        srcset="/assets/original-artworks/pappou_hero_1280.webp 1280w, /assets/original-artworks/pappou_hero_1536.webp 1536w"
        sizes="100vw"
        type="image/webp"
      />
      <img src="/assets/original-artworks/pappou_hero.png" alt="Sounio heritage artwork" loading="lazy" decoding="async" />
    </picture>
    <div class="about-image-overlay" aria-hidden="true"></div>
  </section>

  <section class="section-shell about-author">
    <div class="container author-grid">
      <div class="author-bio">
        <div class="author-header">
          <img src="/assets/author.jpg" alt="Demetrios Chiuratto Agourakis" class="author-photo" width="120" height="120" loading="lazy" />
          <div class="author-title">
            <p class="author-name">Demetrios Chiuratto Agourakis</p>
            <p class="author-role">Creator &amp; Lead Architect</p>
            <div class="author-links">
              <a href="https://github.com/sounio-lang" class="author-link" target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
                GitHub
              </a>
              <a href="https://orcid.org/0009-0001-8671-8878" class="author-link" target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zM7.5 7.5h3v9h-3v-9zm1.5-2a1.5 1.5 0 110-3 1.5 1.5 0 010 3zm6 2h3v1.5h.03c.39-.75 1.35-1.5 2.775-1.5 2.955 0 3.495 1.95 3.495 4.485V16.5h-3v-4.305c0-1.065-.015-2.43-1.485-2.43-1.485 0-1.71 1.155-1.71 2.355V16.5h-3v-9z"/></svg>
                ORCID
              </a>
            </div>
          </div>
        </div>
        <div class="author-content">
          <p>
            Demetrios is a medical student and researcher at PUC-SP and S&atilde;o Leopoldo Mandic,
            specializing in biomaterials and regenerative medicine. With published work on Ollivier-Ricci
            curvature for complex networks and a submitted paper on octonion algebra (the 168 theorem),
            he created Sounio to bridge the gap between scientific rigor and computational practice —
            building the entire language, compiler, and standard library from scratch since December 2025 (souc {versions.checkedArtifact}).
          </p>
          <p>
            The name "Sounio" reflects both personal heritage and architectural philosophy: Cape Sounion (Σούνιο),
            where ancient Greek mariners made crucial decisions at the boundary of known waters, embodies the epistemic
            boundary where certainty meets uncertainty — a metaphor central to the language's design.
          </p>
        </div>
      </div>
      <article class="glass author-stats">
        <h3>Project at a Glance</h3>
        <ul class="stats-list">
          <li><span class="stat-number">3,224</span> <span class="stat-label">commits</span></li>
          <li><span class="stat-number">{metrics.stdlibInventoryFiles ?? "—"}</span> <span class="stat-label">stdlib .sio files</span></li>
          <li><span class="stat-number">{gate.pass}/{gate.total}</span> <span class="stat-label">stdlib reliability gate</span></li>
          <li><span class="stat-number">{full ? `${full.pass}/${full.total}` : "—"}</span> <span class="stat-label">full suite (README)</span></li>
          <li><span class="stat-number">1,000+</span> <span class="stat-label">e-graph rewrite rules</span></li>
          <li><span class="stat-number">86K</span> <span class="stat-label">max parameters (O-SSM)</span></li>
        </ul>
      </article>
    </div>
  </section>

  <section class="section-shell">
    <div class="container about-inner">
      <article class="glass" style="padding: 1.5rem; border-radius: var(--radius-xl);">
        <h3 class="section-heading" style="font-size: 1.3rem; margin-bottom: 1rem;">Contributors</h3>
        <div style="display: flex; gap: 1.5rem; flex-wrap: wrap;">
          <div>
            <p style="font-weight: 600; color: var(--color-text-primary);">Dionisio Chiuratto Agourakis</p>
            <p style="font-size: 0.875rem; color: var(--color-text-secondary);">Contributor</p>
          </div>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .about-inner {
    max-width: 820px;
    display: grid;
    gap: 1rem;
  }

  .about-inner h1 {
    font-size: clamp(2.2rem, 5.8vw, 4.6rem);
  }

  .about-inner p {
    color: var(--color-text-secondary);
    font-size: clamp(1rem, 2.4vw, 1.18rem);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .about-grid {
    display: grid;
    gap: 0.9rem;
  }

  .about-card,
  .about-image-card {
    border-radius: var(--radius-xl);
    padding: 1.1rem;
  }

  .about-image-card img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    object-fit: cover;
  }

  /* About Author Section */
  .author-grid {
    display: grid;
    gap: 0.9rem;
  }

  .about-author-card {
    border-radius: var(--radius-xl);
    padding: 1.5rem;
  }

  .author-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .author-photo {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--color-gold, #c4a574);
  }

  .author-title {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .author-name {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0;
  }

  .author-role {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .author-content p {
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: 0.75rem;
  }

  .author-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .author-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.875rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text);
    font-size: 0.875rem;
    text-decoration: none;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .author-link:hover {
    background: var(--color-surface-hover);
    border-color: var(--color-gold, #c4a574);
  }

  .author-stats {
    border-radius: var(--radius-xl);
    padding: 1.5rem;
  }

  .author-stats h3 {
    font-size: 1.1rem;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  .stats-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }

  .stats-list li {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .stat-number {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-gold, #c4a574);
    font-variant-numeric: tabular-nums;
  }

  .stat-label {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }

  @media (min-width: 640px) {
    .author-header {
      flex-direction: row;
      align-items: center;
    }
  }

  @media (min-width: 980px) {
    .about-grid,
    .author-grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      align-items: start;
    }
  }
</style>
