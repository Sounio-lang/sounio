---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import Container from '../../components/ui/Container.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
import { getLocaleFromUrl, getLocalizedPath, loadTranslations } from '../../lib/i18n';
import { publicContract } from '../../data/artifactStatus';

const locale = getLocaleFromUrl(Astro.url);
const t = await loadTranslations(locale);
const { metrics, versions } = publicContract;
const gate = metrics.stdlibReliabilityGate;
const full = metrics.fullTestSuite;

const aboutBreadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": t.nav_home || "Home",
      "item": Astro.site?.toString() || "https://www.souniolang.org/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": t.page_about_title || "About",
      "item": new URL(getLocalizedPath('/about', locale), Astro.site).toString()
    }
  ]
};
---

<BaseLayout title={t.page_about_title} description={t.page_about_desc} schema={aboutBreadcrumbSchema}>

  {/* ── Hero ─────────────────────────────────────────────────── */}
  <Section class="about-hero">
    <Container class="about-hero-inner">
      <Eyebrow>About</Eyebrow>
      <h1>Sounio is building software that communicates the quality of its own knowledge.</h1>
      <p>
        A statically typed, effect-annotated, self-hosted programming language
        with first-class epistemic types &mdash; for computation that must account
        for what it doesn&rsquo;t know.
      </p>
      <div class="about-hero-actions">
        <Button href={getLocalizedPath('/about/vision', locale)}>Read Vision</Button>
        <Button href={getLocalizedPath('/about/roadmap', locale)} variant="ghost">View Roadmap</Button>
      </div>
    </Container>
  </Section>

  {/* ── Design Principle ────────────────────────────────────── */}
  <Section pad="none" class="about-principle-section">
    <Container class="about-principle-inner">
      <Eyebrow class="about-principle-label">DESIGN PRINCIPLE</Eyebrow>
      <p class="about-principle-text">
        A language for science should never erase provenance<br class="br-sm" />
        or confidence signals just because a result reached a scalar.
      </p>
    </Container>
  </Section>

  {/* ── Heritage image ──────────────────────────────────────── */}
  <div class="about-image-full" aria-hidden="true">
    <picture>
      <source
        srcset="/assets/original-artworks/pappou_hero_1280.webp 1280w, /assets/original-artworks/pappou_hero_1536.webp 1536w"
        sizes="100vw"
        type="image/webp"
      />
      <img src="/assets/original-artworks/pappou_hero.png" alt="" loading="lazy" decoding="async" />
    </picture>
    <div class="about-image-overlay"></div>
  </div>

  {/* ── Author + Stats ──────────────────────────────────────── */}
  <Section>
    <Container class="author-grid">
      <div class="author-bio">
        <div class="author-header">
          <img
            src="/assets/author.jpg"
            alt="Demetrios Chiuratto Agourakis"
            class="author-photo"
            width="96"
            height="96"
            loading="lazy"
          />
          <div class="author-title-block">
            <p class="author-name">Demetrios Chiuratto Agourakis</p>
            <p class="author-role">Creator &amp; Lead Architect</p>
            <div class="author-links">
              <a href="https://github.com/sounio-lang" class="author-link" target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
                GitHub
              </a>
              <a href="https://orcid.org/0009-0001-8671-8878" class="author-link" target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zM7.5 7.5h3v9h-3v-9zm1.5-2a1.5 1.5 0 110-3 1.5 1.5 0 010 3zm6 2h3v1.5h.03c.39-.75 1.35-1.5 2.775-1.5 2.955 0 3.495 1.95 3.495 4.485V16.5h-3v-4.305c0-1.065-.015-2.43-1.485-2.43-1.485 0-1.71 1.155-1.71 2.355V16.5h-3v-9z"/></svg>
                ORCID
              </a>
            </div>
          </div>
        </div>
        <div class="author-content">
          <p>
            Demetrios is a medical student and researcher at PUC-SP and S&atilde;o Leopoldo Mandic,
            specialising in biomaterials and regenerative medicine. With published work on Ollivier-Ricci
            curvature for complex networks and a submitted paper on octonion algebra (the 168 theorem),
            he created Sounio to bridge the gap between scientific rigour and computational practice &mdash;
            building the entire language, compiler, and standard library from scratch since December 2025 (souc {versions.checkedArtifact}).
          </p>
          <p>
            The name &ldquo;Sounio&rdquo; reflects both personal heritage and architectural philosophy: Cape Sounion (&Sigma;&omicron;&upsilon;&nu;&iota;&omicron;),
            where ancient Greek mariners made crucial decisions at the boundary of known waters, embodies the epistemic
            boundary where certainty meets uncertainty&mdash;a metaphor central to the language&rsquo;s design.
          </p>
        </div>
      </div>

      <Card class="author-stats">
        <h2 class="stats-heading">Project at a Glance</h2>
        <ul class="stats-list">
          <li><span class="stat-number">3,224</span><span class="stat-label">commits</span></li>
          <li><span class="stat-number">{metrics.stdlibInventoryFiles ?? "—"}</span><span class="stat-label">stdlib .sio files</span></li>
          <li><span class="stat-number">{gate.pass}/{gate.total}</span><span class="stat-label">stdlib reliability gate</span></li>
          <li><span class="stat-number">{full ? `${full.pass}/${full.total}` : "—"}</span><span class="stat-label">full suite</span></li>
          <li><span class="stat-number">1,000+</span><span class="stat-label">e-graph rewrite rules</span></li>
          <li><span class="stat-number">86K</span><span class="stat-label">max parameters (O-SSM)</span></li>
        </ul>
      </Card>
    </Container>
  </Section>

  {/* ── Contributors ────────────────────────────────────────── */}
  <Section pad="none" class="contributors-section">
    <Container class="contributors-inner">
      <Eyebrow tone="ink" class="contributors-label">CONTRIBUTORS</Eyebrow>
      <div class="contributors-list">
        <div class="contributor">
          <p class="contributor-name">Dionisio Chiuratto Agourakis</p>
          <p class="contributor-role">Contributor</p>
        </div>
      </div>
    </Container>
  </Section>

</BaseLayout>

<style>
  /* ── Hero ──────────────────────────────────────────────────── */
  .about-hero-inner {
    max-width: 820px;
    display: grid;
    gap: 1rem;
  }

  .about-hero-inner h1 {
    font-size: clamp(2.2rem, 5.8vw, 4.6rem);
    font-weight: 750;
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  .about-hero-inner p {
    color: var(--color-ink-2);
    font-size: clamp(1rem, 2.4vw, 1.18rem);
    max-width: 60ch;
  }

  .about-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 0.5rem;
  }

  /* ── Design Principle ─────────────────────────────────────── */
  .about-principle-section {
    padding: clamp(3rem, 6vw, 5rem) 0;
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }

  .about-principle-inner {
    max-width: 900px;
    display: grid;
    gap: 1.1rem;
  }

  .about-principle-text {
    font-family: var(--font-display, Georgia, serif);
    font-size: clamp(1.5rem, 3.5vw, 2.4rem);
    font-weight: 400;
    line-height: 1.35;
    color: var(--color-ink-1);
    margin: 0;
  }

  .br-sm {
    display: none;
  }

  @media (min-width: 640px) {
    .br-sm {
      display: inline;
    }
  }

  /* ── Heritage image ───────────────────────────────────────── */
  .about-image-full {
    position: relative;
    height: clamp(220px, 38vw, 480px);
    overflow: hidden;
  }

  .about-image-full picture,
  .about-image-full img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .about-image-full img {
    object-fit: cover;
    object-position: center 35%;
  }

  .about-image-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, color-mix(in srgb, var(--color-surface-base) 20%, transparent) 0%, color-mix(in srgb, var(--color-surface-base) 78%, transparent) 100%),
      radial-gradient(ellipse 70% 60% at 60% 40%, color-mix(in srgb, var(--color-accent-champagne) 12%, transparent), transparent 70%);
  }

  /* ── Author ───────────────────────────────────────────────── */
  .author-grid {
    display: grid;
    gap: 2rem;
    align-items: start;
  }

  .author-bio {
    display: grid;
    gap: 1.5rem;
  }

  .author-header {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .author-photo {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--color-accent-champagne);
    flex-shrink: 0;
  }

  .author-title-block {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding-top: 0.2rem;
  }

  .author-name {
    font-size: 1.2rem;
    font-weight: 650;
    color: var(--color-ink-1);
    margin: 0;
  }

  .author-role {
    font-size: 0.85rem;
    color: var(--color-ink-2);
    margin: 0;
  }

  .author-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.65rem;
  }

  .author-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.7rem;
    background: var(--color-surface-frost);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    color: var(--color-ink-2);
    font-size: 0.82rem;
    text-decoration: none;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .author-link:hover {
    border-color: var(--color-accent-champagne);
    color: var(--color-ink-1);
  }

  .author-content p {
    color: var(--color-ink-2);
    line-height: 1.7;
    margin: 0 0 0.75rem;
    font-size: 0.95rem;
  }

  .author-content p:last-child {
    margin-bottom: 0;
  }

  /* ── Stats ────────────────────────────────────────────────── */
  .stats-heading {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-3);
    margin: 0 0 1.25rem;
  }

  .stats-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0;
  }

  .stats-list li {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    border-bottom: 1px solid var(--color-line);
    padding: 0.75rem 0;
  }

  .stats-list li:first-child {
    padding-top: 0;
  }

  .stats-list li:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .stat-number {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--color-accent-champagne);
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .stat-label {
    font-size: 0.82rem;
    color: var(--color-ink-2);
  }

  /* ── Contributors ─────────────────────────────────────────── */
  .contributors-section {
    border-top: 1px solid var(--color-line);
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
  }

  .contributors-inner {
    max-width: 820px;
    display: grid;
    gap: 0.75rem;
  }

  .contributors-list {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .contributor-name {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-ink-1);
    margin: 0;
  }

  .contributor-role {
    font-size: 0.82rem;
    color: var(--color-ink-2);
    margin: 0.15rem 0 0;
  }

  /* ── Responsive ───────────────────────────────────────────── */
  @media (min-width: 980px) {
    .author-grid {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    }
  }
</style>

<script>
  import { gsap, prefersReducedMotion } from '../../lib/motion';

  if (!prefersReducedMotion()) {
    // Hero cascade
    gsap.from('.about-hero-inner > *', {
      y: 24, opacity: 0, stagger: 0.13, duration: 0.7, ease: 'power2.out',
    });

    // Design principle
    const tlP = gsap.timeline({ scrollTrigger: { trigger: '.about-principle-section', start: 'top 76%', once: true } });
    tlP.from('.about-principle-label', { y: 12, opacity: 0, duration: 0.4, ease: 'power2.out' })
       .from('.about-principle-text', { y: 22, opacity: 0, duration: 0.65, ease: 'power2.out' }, '-=0.2');

    // Author + stats
    const tlA = gsap.timeline({ scrollTrigger: { trigger: '.author-grid', start: 'top 76%', once: true } });
    tlA.from('.author-header', { y: 20, opacity: 0, duration: 0.55, ease: 'power2.out' })
       .from('.author-content', { y: 18, opacity: 0, duration: 0.55, ease: 'power2.out' }, '-=0.3')
       .from('.author-stats', { y: 24, opacity: 0, duration: 0.6, ease: 'power2.out' }, '-=0.4')
       .from('.stats-list li', { x: -12, opacity: 0, stagger: 0.07, duration: 0.45, ease: 'power2.out' }, '-=0.25');

    // Contributors
    gsap.from('.contributors-inner > *', {
      y: 14, opacity: 0, stagger: 0.1, duration: 0.45, ease: 'power2.out',
      scrollTrigger: { trigger: '.contributors-section', start: 'top 82%', once: true },
    });
  }
</script>
