---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { VisionScroll } from '../../components/about/VisionScroll';
import { getLocaleFromUrl, getLocalizedPath, loadTranslations } from '../../lib/i18n';

const locale = getLocaleFromUrl(Astro.url);
const t = await loadTranslations(locale);

const visionBreadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": t.nav_home || "Home",
      "item": Astro.site?.toString() || "https://www.souniolang.org/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": t.page_about_title || "About",
      "item": new URL(getLocalizedPath('/about', locale), Astro.site).toString()
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": t.page_vision_title || "Vision",
      "item": new URL(getLocalizedPath('/about/vision', locale), Astro.site).toString()
    }
  ]
};
---

<BaseLayout
  title={t.page_vision_title}
  description={t.page_vision_desc}
  removeTopPadding={true}
  schema={visionBreadcrumbSchema}
>
  <VisionScroll client:load />
</BaseLayout>
