---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RoadmapTimeline from '../../components/diagrams/RoadmapTimeline.astro';
import { getLocaleFromUrl, getLocalizedPath, loadTranslations } from '../../lib/i18n';

const locale = getLocaleFromUrl(Astro.url);
const t = await loadTranslations(locale);

const roadmapBreadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": t.nav_home || "Home",
      "item": Astro.site?.toString() || "https://www.souniolang.org/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": t.page_about_title || "About",
      "item": new URL(getLocalizedPath('/about', locale), Astro.site).toString()
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": t.page_roadmap_title || "Roadmap",
      "item": new URL(getLocalizedPath('/about/roadmap', locale), Astro.site).toString()
    }
  ]
};
---

<BaseLayout title={t.page_roadmap_title} description={t.page_roadmap_desc} schema={roadmapBreadcrumbSchema}>
  <section class="section-shell roadmap-hero">
    <div class="container roadmap-inner">
      <span class="badge-pill">Roadmap</span>
      <h1>Execution milestones for a pre-1.0 research language.</h1>
      <p>
        This roadmap tracks Sounio, a scientific programming language, through the language, runtime, and ecosystem work required for dependable scientific deployment.
        The design and the author are described in
        <a class="roadmap-inline-link" href={getLocalizedPath('/about', locale)}>about the Sounio programming language</a>.
      </p>
    </div>
  </section>

  <section class="section-shell">
    <div class="container">
      <RoadmapTimeline />
    </div>
  </section>
</BaseLayout>

<style>
  .roadmap-inner {
    max-width: 840px;
    display: grid;
    gap: 0.95rem;
  }

  .roadmap-inner h1 {
    font-size: clamp(2.15rem, 5.4vw, 4.3rem);
  }

  .roadmap-inner p {
    color: var(--color-text-secondary);
    font-size: clamp(1rem, 2.25vw, 1.15rem);
  }

  .roadmap-inline-link {
    color: var(--color-accent-gold-soft, #d6b35a);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
