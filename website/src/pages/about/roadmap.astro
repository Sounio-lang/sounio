---
import BaseLayout from '../../layouts/BaseLayout.astro';

const phases = [
  {
    name: 'Phase 1 — Language Core',
    status: 'completed',
    items: ['Core language design', 'Type system foundations', 'Units and effect model'],
  },
  {
    name: 'Phase 2 — Epistemic Semantics',
    status: 'completed',
    items: ['Knowledge<T> model', 'Uncertainty propagation', 'Confidence-gated control flow'],
  },
  {
    name: 'Phase 3 — Runtime + Backends',
    status: 'in_progress',
    items: ['Native backend hardening', 'GPU workflow expansion', 'WebAssembly improvements'],
  },
  {
    name: 'Phase 4 — Tooling Ecosystem',
    status: 'in_progress',
    items: ['LSP evolution', 'Package lifecycle workflows', 'Docs and verification pipelines'],
  },
  {
    name: 'Phase 5 — Production Readiness',
    status: 'planned',
    items: ['Performance stabilization', 'Security review', 'v1 release criteria'],
  },
];

const statusLabel: Record<string, string> = {
  completed: 'Completed',
  in_progress: 'In Progress',
  planned: 'Planned',
};
---

<BaseLayout title="Roadmap" description="Sounio roadmap and execution milestones">
  <section class="section-shell roadmap-hero">
    <div class="container roadmap-inner">
      <span class="badge-pill">Roadmap</span>
      <h1>Execution milestones for delivering production-grade epistemic computing.</h1>
      <p>
        This roadmap tracks the language, runtime, and ecosystem work required for dependable scientific deployment.
      </p>
    </div>
  </section>

  <section class="section-shell">
    <div class="container roadmap-stack">
      {phases.map((phase, index) => (
        <article class={`glass roadmap-card status-${phase.status}`}>
          <div class="roadmap-head">
            <span class="phase-index">{index + 1}</span>
            <div>
              <h2>{phase.name}</h2>
              <p>{statusLabel[phase.status]}</p>
            </div>
          </div>
          <ul>
            {phase.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .roadmap-inner {
    max-width: 840px;
    display: grid;
    gap: 0.95rem;
  }

  .roadmap-inner h1 {
    font-size: clamp(2.15rem, 5.4vw, 4.3rem);
  }

  .roadmap-inner p {
    color: var(--color-text-secondary);
    font-size: clamp(1rem, 2.25vw, 1.15rem);
  }

  .roadmap-stack {
    display: grid;
    gap: 0.9rem;
  }

  .roadmap-card {
    border-radius: var(--radius-xl);
    padding: 1.1rem;
    border: 1px solid var(--glass-border);
  }

  .roadmap-head {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .phase-index {
    width: 2rem;
    height: 2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
    background: rgba(214, 179, 90, 0.16);
    color: var(--color-accent-gold-soft);
    font-weight: 650;
  }

  .roadmap-head h2 {
    font-size: 1.1rem;
  }

  .roadmap-head p {
    color: var(--color-text-tertiary);
    font-size: 0.82rem;
  }

  .roadmap-card ul {
    margin: 0.8rem 0 0;
    padding-left: 1.1rem;
    color: var(--color-text-secondary);
    display: grid;
    gap: 0.35rem;
  }

  .status-completed .phase-index {
    background: rgba(73, 211, 141, 0.18);
    color: var(--color-accent-green);
  }

  .status-in_progress .phase-index {
    background: rgba(255, 159, 10, 0.18);
    color: var(--color-accent-orange);
  }
</style>
