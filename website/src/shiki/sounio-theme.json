{
  "name": "sounio-epistemic",
  "type": "dark",
  "comment": "Every foreground below is a var() reference to a token already committed in website/src/styles/global.css (PR #1764, 'Epistemic Instrumentarium'). No colors are invented here — this theme only assigns existing tokens to Shiki scopes. Because the values are CSS variables, not resolved hex, code blocks automatically follow the site's light/dark/system theme contract instead of being pinned to one palette.",
  "colors": {
    "editor.background": "var(--color-code-bg)",
    "editor.foreground": "var(--color-text-primary)"
  },
  "tokenColors": [
    {
      "scope": ["comment.line.double-slash.sio", "comment.block.sio"],
      "settings": { "foreground": "var(--color-text-tertiary)" }
    },
    {
      "scope": ["string.quoted.double.sio", "constant.character.escape.sio"],
      "settings": { "foreground": "var(--color-brand-teal-400)" }
    },
    {
      "scope": "keyword.operator.exclusive-ref.sio",
      "comment": "&! shares the Mut effect color: taking an exclusive ref is what makes mutation possible.",
      "settings": { "foreground": "var(--color-effect-mut)" }
    },
    {
      "scope": "keyword.operator.concat.sio",
      "settings": { "foreground": "var(--color-brand-teal-500)" }
    },
    {
      "scope": "keyword.control.effect-clause.sio",
      "settings": { "foreground": "var(--color-brand-teal-500)" }
    },
    {
      "scope": "support.type.effect.io.sio",
      "settings": { "foreground": "var(--color-effect-io)" }
    },
    {
      "scope": "support.type.effect.mut.sio",
      "settings": { "foreground": "var(--color-effect-mut)" }
    },
    {
      "scope": "support.type.effect.div.sio",
      "settings": { "foreground": "var(--color-effect-div)" }
    },
    {
      "scope": "support.type.effect.panic.sio",
      "settings": { "foreground": "var(--color-effect-panic)" }
    },
    {
      "scope": "support.type.effect.alloc.sio",
      "settings": { "foreground": "var(--color-effect-alloc)" }
    },
    {
      "scope": "support.type.effect.async.sio",
      "settings": { "foreground": "var(--color-effect-async)" }
    },
    {
      "scope": "support.type.effect.gpu.sio",
      "settings": { "foreground": "var(--color-effect-gpu)" }
    },
    {
      "scope": "support.type.effect.prob.sio",
      "settings": { "foreground": "var(--color-effect-prob)" }
    },
    {
      "scope": "support.type.effect.observe.sio",
      "settings": { "foreground": "var(--color-effect-observe)" }
    },
    {
      "scope": "storage.modifier.ownership.sio",
      "comment": "linear/affine struct — cursor-1's token set reserves --color-type-linear for exactly this.",
      "settings": { "foreground": "var(--color-type-linear)" }
    },
    {
      "scope": "storage.type.immutable.sio",
      "comment": "let — the certain/verified half of the let/var split.",
      "settings": { "foreground": "var(--color-epistemic-verified)" }
    },
    {
      "scope": "storage.modifier.mutable.sio",
      "comment": "var — Sounio's own mutable-binding keyword, colored with the Mut effect.",
      "settings": { "foreground": "var(--color-effect-mut)" }
    },
    {
      "scope": "storage.modifier.other.sio",
      "settings": { "foreground": "var(--color-text-secondary)" }
    },
    {
      "scope": "keyword.control.sio",
      "settings": { "foreground": "var(--color-brand-teal-500)" }
    },
    {
      "scope": "keyword.other.sio",
      "settings": { "foreground": "var(--color-brand-teal-500)" }
    },
    {
      "scope": "constant.language.sio",
      "settings": { "foreground": "var(--color-brand-gold-500)" }
    },
    {
      "scope": "constant.numeric.sio",
      "settings": { "foreground": "var(--color-brand-gold-500)" }
    },
    {
      "scope": "keyword.other.unit.sio",
      "settings": { "foreground": "var(--color-text-secondary)" }
    },
    {
      "scope": "entity.name.type.sio",
      "settings": { "foreground": "var(--color-text-primary)" }
    },
    {
      "scope": "entity.name.function.sio",
      "settings": { "foreground": "var(--color-brand-gold-400)" }
    },
    {
      "scope": "keyword.operator.sio",
      "settings": { "foreground": "var(--color-text-secondary)" }
    }
  ]
}
