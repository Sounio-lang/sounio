---
import '../styles/fonts.css';
import '../styles/global.css';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import { CustomCursor } from '../components/common/CustomCursor';
import { ClientRouter } from 'astro:transitions';
import { getLocaleFromUrl, getLocalizedPath, isLocaleFullyLocalized, loadTranslations, ogLocaleTag, shouldShowLocaleTranslationNotice, type Locale } from '../lib/i18n';
import { absoluteUrl, canonicalPathname, hreflangLinks, htmlLang, localeFromPath } from '../lib/seo-locales.mjs';
import surface from '../data/publicSurface.json';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noIndex?: boolean;
  localizedAlternates?: boolean;
  removeTopPadding?: boolean;
  schema?: any;
}

const { title, description, image, noIndex = false, localizedAlternates = true, removeTopPadding = false, schema = null } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const canonicalPath = canonicalPathname(Astro.url.pathname);
const canonicalURL = absoluteUrl(canonicalPath);
const alternates: { hreflang: string; href: string }[] = hreflangLinks(Astro.url.pathname);
const t = await loadTranslations(locale);

const siteTitle = 'Sounio';
const fullTitle = title 
  ? (title.includes(siteTitle) ? title : `${title} — ${siteTitle}`)
  : (t.seo_default_title || 'Sounio — Epistemic Computing');
const metaDescription = description || t.seo_default_description || 'A self-hosted programming language for epistemic computing: native uncertainty quantification, physical units and declared effects, compiled to Linux x86-64.';
const ogImage = image || '/assets/lockups/lockup_horizontal_light.svg';

const showLocaleNotice =
  locale !== 'en' && !isLocaleFullyLocalized(locale) && shouldShowLocaleTranslationNotice(Astro.url.pathname);
const englishUrl = getLocalizedPath(Astro.url.pathname, 'en');
---

<!doctype html>
<html lang={htmlLang(locale)} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Islands use client:idle. Hold requestIdleCallback until load so their
         bundles do not compete with the hero image on the first paint. -->
    <script is:inline>
      (function () {
        const native = window.requestIdleCallback && window.requestIdleCallback.bind(window);
        window.requestIdleCallback = function (callback, options) {
          const run = function () {
            if (native) native(callback, options);
            else window.setTimeout(callback, 1);
          };
          if (document.readyState === 'complete') run();
          else window.addEventListener('load', run, { once: true });
          return 0;
        };
      })();
    </script>
    <slot name="head" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0B1E3A" />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" href="/icon-192.png" sizes="192x192" />
    <link rel="icon" type="image/png" href="/icon-512.png" sizes="512x512" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:locale" content={ogLocaleTag(localeFromPath(canonicalPath) as Locale)} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />

    <!-- Alternate language links: only self-canonical translations, plus x-default. -->
    {!noIndex && alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}

    <!-- JSON-LD Structured Data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "Sounio",
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "Linux x86_64 (committed prebuilt); macOS arm64 (source-built)",
      "programmingLanguage": "Sounio",
      "license": "https://opensource.org/licenses/Apache-2.0",
      "downloadUrl": "https://github.com/Sounio-lang/sounio",
      "codeRepository": "https://github.com/Sounio-lang/sounio",
      "author": {
        "@type": "Person",
        "name": "Demetrios Chiuratto Agourakis",
        "url": (Astro.site?.toString() || "https://www.souniolang.org").replace(/\/$/, "")
      },
      "description": metaDescription,
      "url": (Astro.site?.toString() || "https://www.souniolang.org").replace(/\/$/, ""),
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    })} />

    {schema && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}

    <!-- Dark-first theme script (runs before render to prevent flash) -->
    <script is:inline>
      const storedTheme = typeof localStorage !== 'undefined' ? localStorage.getItem('theme') : null;
      const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const resolvedTheme =
        storedTheme === 'light' || storedTheme === 'dark'
          ? storedTheme
          : storedTheme === 'system'
            ? (systemDark ? 'dark' : 'light')
            : 'dark';

      document.documentElement.classList.remove('dark', 'light');
      document.documentElement.classList.add(resolvedTheme);

      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
        if (localStorage.getItem('theme') === 'system') {
          document.documentElement.classList.remove('dark', 'light');
          document.documentElement.classList.add(e.matches ? 'dark' : 'light');
        }
      });
    </script>

    <!-- Audience pre-render (scientist default, runs before paint to prevent flash) -->
    <script is:inline>
      const storedAudience = typeof localStorage !== 'undefined' ? localStorage.getItem('sounio-audience') : null;
      if (storedAudience === 'scientist' || storedAudience === 'technical') {
        document.documentElement.setAttribute('data-audience', storedAudience);
      }
      // Persist audience across Astro client router / view transitions (prevents reset on navigation)
      document.addEventListener('astro:before-swap', (e) => {
        const current = document.documentElement.getAttribute('data-audience');
        if (current === 'scientist' || current === 'technical') {
          e.newDocument.documentElement.setAttribute('data-audience', current);
        }
      });
    </script>

    <!-- Pagefind runtime. Loaded after the window load event so it does not
         share the first-paint connection pool with the hero image. -->
    <script type="module" is:inline>
      window.addEventListener('load', () => {
        import('/pagefind/pagefind.js')
          .then((mod) => { window.pagefind = mod; })
          .catch(() => {
            // Dev mode or builds without pagefind. Search UI will gracefully noop.
          });
      }, { once: true });
    </script>

    <ClientRouter />
  </head>
  <body class="min-h-screen flex flex-col bg-[var(--color-bg)] text-[var(--color-text)]">
    <CustomCursor client:media="(hover: hover) and (pointer: fine)" />
    <a href="#main-content" class="skip-link">{surface[locale].chrome.skip}</a>

    <Header locale={locale} />

    {showLocaleNotice && (
      <div class="locale-notice" role="status" aria-live="polite">
        {t?.locale_banner_notice ?? 'This page has not yet been translated for this release. The English version is authoritative.'}
        {' '}
        <a href={englishUrl} class="locale-notice-link">
          {t?.locale_banner_link ?? 'View English version'} &rarr;
        </a>
      </div>
    )}

    <main id="main-content" class={`flex-1 ${removeTopPadding ? '' : 'pt-16'}`} data-pagefind-body>
      <slot />
    </main>

    <Footer locale={locale} localizedAlternates={localizedAlternates} />
  </body>
</html>
