---
import '../styles/global.css';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import { ViewTransitions } from 'astro:transitions';
import { getLocaleFromUrl, loadTranslations } from '../lib/i18n';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noIndex?: boolean;
}

const { title, description, image, noIndex = false } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const t = await loadTranslations(locale);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const siteTitle = 'Sounio';
const fullTitle = title ? `${title} — ${siteTitle}` : `${siteTitle} — Epistemic Computing`;
const metaDescription = description || 'A systems programming language for epistemic computing with native uncertainty quantification, GPU acceleration, and standards compliance.';
const ogImage = image || '/assets/lockups/lockup_horizontal_light.svg';
---

<!doctype html>
<html lang={locale} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="generator" content={Astro.generator} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Preload fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,400;0,600;1,400&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:locale" content={locale} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />

    <!-- Alternate language links -->
    <link rel="alternate" hreflang="en" href={new URL('/', Astro.site)} />
    <link rel="alternate" hreflang="pt" href={new URL('/pt/', Astro.site)} />
    <link rel="alternate" hreflang="el" href={new URL('/el/', Astro.site)} />
    <link rel="alternate" hreflang="zh" href={new URL('/zh/', Astro.site)} />
    <link rel="alternate" hreflang="ja" href={new URL('/ja/', Astro.site)} />
    <link rel="alternate" hreflang="es" href={new URL('/es/', Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />

    <!-- Theme script (runs before render to prevent flash) -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      }
    </script>

    <!-- Pagefind runtime (present in production builds; ignored in dev if missing) -->
    <script type="module" is:inline>
      (async () => {
        try {
          const mod = await import('/pagefind/pagefind.js');
          // Expose on window for the React search component.
          window.pagefind = mod;
        } catch {
          // Dev mode or builds without pagefind. Search UI will gracefully noop.
        }
      })();
    </script>

    <ViewTransitions />
  </head>
  <body class="min-h-screen flex flex-col bg-[var(--color-bg)] text-[var(--color-text)]">
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <Header locale={locale} />

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <Footer locale={locale} />
  </body>
</html>
