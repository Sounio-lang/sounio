---
import '../styles/global.css';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import { ViewTransitions } from 'astro:transitions';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import { getLocaleFromUrl, getLocalizedPath, isLocaleFullyLocalized, type Locale } from '../lib/i18n';
import { isDocsPath } from '../lib/docs-locale';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noIndex?: boolean;
  removeTopPadding?: boolean;
}

const { title, description, image, noIndex = false, removeTopPadding = false } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const siteTitle = 'Sounio';
const fullTitle = title ? `${title} — ${siteTitle}` : `${siteTitle} — Epistemic Computing`;
const metaDescription = description || 'A systems programming language for epistemic computing with native uncertainty quantification, GPU acceleration, and standards compliance.';
const ogImage = image || '/assets/lockups/lockup_horizontal_light.svg';

const localeAlternates: Locale[] = ['en', 'pt', 'el', 'zh', 'ja', 'es'];
const localeUpdateInProgress = !isLocaleFullyLocalized(locale);
const hideLocaleNotice = isDocsPath(Astro.url.pathname);
---

<!doctype html>
<html lang={locale} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0B1E3A" />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" href="/icon-192.png" sizes="192x192" />
    <link rel="icon" type="image/png" href="/icon-512.png" sizes="512x512" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:locale" content={locale} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />

    <!-- Alternate language links -->
    {!noIndex && localeAlternates.map((altLocale) => (
      <link
        rel="alternate"
        hreflang={altLocale}
        href={new URL(getLocalizedPath(Astro.url.pathname, altLocale), Astro.site)}
      />
    ))}
    {!noIndex && <link rel="alternate" hreflang="x-default" href={new URL(getLocalizedPath(Astro.url.pathname, 'en'), Astro.site)} />}

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "Sounio",
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "Cross-platform",
      "description": metaDescription,
      "url": Astro.site?.toString() || "https://souniolang.org",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    })} />

    <!-- Dark-first theme script (runs before render to prevent flash) -->
    <script is:inline>
      const storedTheme = typeof localStorage !== 'undefined' ? localStorage.getItem('theme') : null;
      const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const resolvedTheme =
        storedTheme === 'light' || storedTheme === 'dark'
          ? storedTheme
          : storedTheme === 'system'
            ? (systemDark ? 'dark' : 'light')
            : 'dark';

      document.documentElement.classList.remove('dark', 'light');
      document.documentElement.classList.add(resolvedTheme);

      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
        if (localStorage.getItem('theme') === 'system') {
          document.documentElement.classList.remove('dark', 'light');
          document.documentElement.classList.add(e.matches ? 'dark' : 'light');
        }
      });
    </script>

    <!-- Audience pre-render (scientist default, runs before paint to prevent flash) -->
    <script is:inline>
      const storedAudience = typeof localStorage !== 'undefined' ? localStorage.getItem('sounio-audience') : null;
      if (storedAudience === 'scientist' || storedAudience === 'technical') {
        document.documentElement.setAttribute('data-audience', storedAudience);
      }
      // Persist audience across Astro ViewTransitions (prevents reset on navigation)
      document.addEventListener('astro:before-swap', (e) => {
        const current = document.documentElement.getAttribute('data-audience');
        if (current === 'scientist' || current === 'technical') {
          e.newDocument.documentElement.setAttribute('data-audience', current);
        }
      });
    </script>

    <ViewTransitions />
  </head>
  <body class="min-h-screen flex flex-col bg-[var(--color-bg)] text-[var(--color-text)]">
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <Header locale={locale} />

    {locale !== 'en' && localeUpdateInProgress && !hideLocaleNotice && (
      <div class="locale-notice" role="status" aria-live="polite">
        Localized V2 rewrite for this language is in progress. Showing English-first content for now.
      </div>
    )}

    <main id="main-content" class={`flex-1 ${removeTopPadding ? '' : 'pt-16'}`} data-pagefind-body>
      <slot />
    </main>

    <Footer locale={locale} />
    <Analytics />
    <SpeedInsights />
  </body>
</html>
