---
import BaseLayout from './BaseLayout.astro';
import { getLocalizedPath, getLocaleFromUrl, loadTranslations } from '../lib/i18n';

interface Heading {
  id: string;
  text: string;
  depth: number;
}

interface SidebarItem {
  title: string;
  href?: string;
  items?: { title: string; href: string }[];
}

interface NavLink {
  title: string;
  href: string;
}

interface Props {
  title: string;
  description?: string;
  headings?: Heading[];
  sidebar?: SidebarItem[];
  prev?: NavLink;
  next?: NavLink;
  docsBasePath?: string;
  docsBaseLabel?: string;
}

const {
  title,
  description,
  headings = [],
  sidebar = [],
  prev,
  next,
  docsBasePath = '/learn',
  docsBaseLabel = 'Learn',
} = Astro.props;

const locale = getLocaleFromUrl(Astro.url);
const t = await loadTranslations(locale);

const defaultSidebar: SidebarItem[] = [
  {
    title: 'Getting Started',
    items: [
      { title: 'Getting Started', href: getLocalizedPath(`${docsBasePath}/getting-started`, locale) },
      { title: 'Hello World', href: getLocalizedPath(`${docsBasePath}/getting-started/hello-world`, locale) },
      { title: 'First Program', href: getLocalizedPath(`${docsBasePath}/getting-started/first-program`, locale) },
    ],
  },
  {
    title: 'Language Guide',
    items: [
      { title: 'Language Overview', href: getLocalizedPath(`${docsBasePath}/language`, locale) },
      { title: 'Variables & Types', href: getLocalizedPath(`${docsBasePath}/language/variables`, locale) },
      { title: 'Functions', href: getLocalizedPath(`${docsBasePath}/language/functions`, locale) },
      { title: 'Control Flow', href: getLocalizedPath(`${docsBasePath}/language/control-flow`, locale) },
    ],
  },
  {
    title: 'Epistemic Types',
    items: [
      { title: 'Epistemic Overview', href: getLocalizedPath(`${docsBasePath}/epistemic`, locale) },
      { title: 'Knowledge<T>', href: getLocalizedPath(`${docsBasePath}/epistemic/knowledge`, locale) },
      { title: 'Uncertainty', href: getLocalizedPath(`${docsBasePath}/epistemic/uncertainty`, locale) },
      { title: 'Provenance', href: getLocalizedPath(`${docsBasePath}/epistemic/provenance`, locale) },
    ],
  },
  {
    title: 'Reference',
    items: [
      { title: 'Standard Library', href: getLocalizedPath(`${docsBasePath}/stdlib`, locale) },
      { title: 'Tooling', href: getLocalizedPath(`${docsBasePath}/tooling`, locale) },
      { title: 'Examples', href: getLocalizedPath(`${docsBasePath}/examples`, locale) },
    ],
  },
];

const sidebarItems = sidebar.length > 0 ? sidebar : defaultSidebar;
const tocHeadings = headings.filter((h) => h.depth <= 3 && typeof h.id === 'string' && h.id.length > 0);
---

<BaseLayout title={title} description={description}>
  <div class="flex min-h-screen">
    <aside id="docs-sidebar" class="hidden lg:block w-72 shrink-0 border-r border-[var(--color-border)] bg-[var(--color-bg-alt)]/65">
      <nav class="sticky top-16 h-[calc(100vh-4rem)] overflow-y-auto p-4">
        <ul class="space-y-4">
          {sidebarItems.map((section) => (
            <li>
              <h3 class="font-semibold text-[var(--color-text-primary)] mb-2 text-[0.72rem] uppercase tracking-[0.08em]">
                {section.title}
              </h3>
              {section.items && (
                <ul class="space-y-1 ml-1">
                  {section.items.map((item) => (
                    <li>
                      <a
                        href={item.href}
                        class:list={[
                          'block py-1.5 px-3 rounded-md text-sm transition-colors docs-nav-link',
                          Astro.url.pathname === item.href ? 'docs-nav-link-active' : '',
                        ]}
                      >
                        {item.title}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </nav>
    </aside>

    <button
      id="sidebar-toggle"
      class="fixed bottom-4 left-4 z-40 lg:hidden p-3 rounded-full border border-[var(--glass-border)] bg-[var(--color-bg-alt)] text-[var(--color-text-primary)]"
      aria-label="Toggle sidebar"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>

    <div id="sidebar-overlay" class="fixed inset-0 bg-black/50 z-30 hidden lg:hidden" />

    <div class="flex-1 min-w-0">
      <nav class="sticky top-16 z-10 bg-[var(--color-bg)]/90 backdrop-blur border-b border-[var(--color-border)] px-6 py-3">
        <ol class="flex items-center gap-2 text-sm text-[var(--color-text-muted)]">
          <li><a href={getLocalizedPath('/', locale)} class="hover:text-[var(--color-text)]">{t.breadcrumb_home}</a></li>
          <li><span class="mx-1">/</span></li>
          <li><a href={getLocalizedPath(docsBasePath, locale)} class="hover:text-[var(--color-text)]">{docsBaseLabel}</a></li>
          <li><span class="mx-1">/</span></li>
          <li class="text-[var(--color-text)] font-medium truncate">{title}</li>
        </ol>
      </nav>

      <article class="px-6 py-8 max-w-4xl" data-pagefind-body>
        <header class="mb-8">
          <h1 class="text-4xl font-semibold text-[var(--color-text-primary)] mb-2">
            {title}
          </h1>
          {description && (
            <p class="text-lg text-[var(--color-text-muted)]">{description}</p>
          )}
        </header>

        <div class="prose max-w-none">
          <slot />
        </div>

        {(prev || next) && (
          <nav class="mt-16 pt-8 border-t border-[var(--color-border)] flex justify-between items-center">
            {prev ? (
              <a href={prev.href} class="group flex items-center gap-2 text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)]">
                <svg class="w-5 h-5 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
                <span>{prev.title}</span>
              </a>
            ) : <div />}
            {next ? (
              <a href={next.href} class="group flex items-center gap-2 text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)]">
                <span>{next.title}</span>
                <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            ) : <div />}
          </nav>
        )}
      </article>
    </div>

    {tocHeadings.length > 0 && (
      <aside class="hidden xl:block w-56 shrink-0 border-l border-[var(--color-border)]">
        <nav class="sticky top-16 h-[calc(100vh-4rem)] overflow-y-auto p-4">
          <h2 class="font-semibold text-[var(--color-text-primary)] mb-4 text-sm">{t.toc_title}</h2>
          <ul class="space-y-2 text-sm" id="toc">
            {tocHeadings.map((heading) => (
              <li style={`margin-left: ${(heading.depth - 2) * 0.75}rem`}>
                <a
                  href={`#${heading.id}`}
                  class="block py-1 text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors toc-link"
                  data-heading-id={heading.id}
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </aside>
    )}
  </div>

  <style>
    .docs-nav-link {
      color: var(--color-text-muted);
    }

    .docs-nav-link:hover {
      color: var(--color-text);
      background: color-mix(in srgb, var(--color-text-primary) 7%, transparent);
    }

    .docs-nav-link-active {
      color: var(--color-text-primary);
      font-weight: 600;
      background: color-mix(in srgb, var(--color-accent-gold) 14%, transparent);
      border: 1px solid color-mix(in srgb, var(--color-accent-gold) 34%, transparent);
    }
  </style>

  <script>
    const toggleBtn = document.getElementById('sidebar-toggle');
    const sidebar = document.getElementById('docs-sidebar');
    const overlay = document.getElementById('sidebar-overlay');

    toggleBtn?.addEventListener('click', () => {
      sidebar?.classList.toggle('hidden');
      sidebar?.classList.toggle('fixed');
      sidebar?.classList.toggle('inset-y-0');
      sidebar?.classList.toggle('left-0');
      sidebar?.classList.toggle('z-40');
      overlay?.classList.toggle('hidden');
    });

    overlay?.addEventListener('click', () => {
      sidebar?.classList.add('hidden');
      sidebar?.classList.remove('fixed', 'inset-y-0', 'left-0', 'z-40');
      overlay?.classList.add('hidden');
    });

    const tocLinks = document.querySelectorAll('.toc-link');
    const headings = Array.from(tocLinks)
      .map((link) => {
        const id = link.getAttribute('data-heading-id');
        return id ? document.getElementById(id) : null;
      })
      .filter((el): el is HTMLElement => el !== null);

    if (headings.length > 0) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            tocLinks.forEach((link) => link.classList.remove('text-[var(--color-accent-gold)]', 'font-medium'));
            const activeLink = document.querySelector(`[data-heading-id="${entry.target.id}"]`);
            activeLink?.classList.add('text-[var(--color-accent-gold)]', 'font-medium');
          });
        },
        { rootMargin: '-80px 0px -80% 0px' }
      );

      headings.forEach((heading) => observer.observe(heading));
    }

    document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
      anchor.addEventListener('click', (e) => {
        e.preventDefault();
        const targetId = anchor.getAttribute('href')?.substring(1);
        const target = document.getElementById(targetId || '');
        if (!target) return;

        const offset = 100;
        const top = target.getBoundingClientRect().top + window.scrollY - offset;
        window.scrollTo({ top, behavior: 'smooth' });
      });
    });
  </script>

  <script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    gsap.registerPlugin(ScrollTrigger);

    const mm = gsap.matchMedia();
    mm.add('(prefers-reduced-motion: no-preference)', () => {
      // Article header
      const header = document.querySelector('article header');
      if (header) {
        gsap.from(header.children, {
          y: 20, opacity: 0, stagger: 0.12, duration: 0.6, ease: 'power2.out', delay: 0.05,
        });
      }

      // Prose content
      const prose = document.querySelector('.prose');
      if (prose) {
        gsap.from(prose, {
          y: 18, opacity: 0, duration: 0.65, ease: 'power2.out', delay: 0.2,
        });
      }

      // TOC links stagger
      const toc = document.getElementById('toc');
      if (toc) {
        gsap.from(toc.querySelectorAll('li'), {
          x: -10, opacity: 0, stagger: 0.04, duration: 0.4, ease: 'power2.out', delay: 0.1,
        });
      }

      // Prev/next nav
      const docsnav = document.querySelector('article > nav');
      if (docsnav) {
        gsap.from(docsnav, {
          y: 14, opacity: 0, duration: 0.45, ease: 'power2.out',
          scrollTrigger: { trigger: docsnav, start: 'top 88%', once: true },
        });
      }
    });
  </script>
</BaseLayout>
