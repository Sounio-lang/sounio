---
import BaseLayout from './BaseLayout.astro';
import { getLocaleFromUrl, loadTranslations } from '../lib/i18n';

interface Heading {
  id: string;
  text: string;
  depth: number;
}

interface SidebarItem {
  title: string;
  href?: string;
  items?: { title: string; href: string }[];
}

interface NavLink {
  title: string;
  href: string;
}

interface Props {
  title: string;
  description?: string;
  headings?: Heading[];
  sidebar?: SidebarItem[];
  prev?: NavLink;
  next?: NavLink;
}

const { title, description, headings = [], sidebar = [], prev, next } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const t = await loadTranslations(locale);

// Default sidebar structure if not provided
const defaultSidebar: SidebarItem[] = [
  {
    title: 'Getting Started',
    items: [
      { title: 'Installation', href: '/docs/getting-started' },
      { title: 'Hello World', href: '/docs/getting-started/hello-world' },
      { title: 'First Program', href: '/docs/getting-started/first-program' },
    ],
  },
  {
    title: 'Language Guide',
    items: [
      { title: 'Variables & Types', href: '/docs/language/variables' },
      { title: 'Functions', href: '/docs/language/functions' },
      { title: 'Control Flow', href: '/docs/language/control-flow' },
    ],
  },
  {
    title: 'Epistemic Types',
    items: [
      { title: 'Knowledge<T>', href: '/docs/epistemic/knowledge' },
      { title: 'Uncertainty', href: '/docs/epistemic/uncertainty' },
      { title: 'Provenance', href: '/docs/epistemic/provenance' },
    ],
  },
  {
    title: 'Effect System',
    items: [
      { title: 'Introduction', href: '/docs/effects' },
      { title: 'IO Effects', href: '/docs/effects/io' },
      { title: 'Custom Effects', href: '/docs/effects/custom' },
    ],
  },
];

const sidebarItems = sidebar.length > 0 ? sidebar : defaultSidebar;
---

<BaseLayout title={title} description={description}>
  <div class="flex min-h-screen">
    <!-- Sidebar -->
    <aside id="docs-sidebar" class="hidden lg:block w-64 shrink-0 border-r border-[var(--color-border)] bg-[var(--color-bg-alt)]">
      <nav class="sticky top-16 h-[calc(100vh-4rem)] overflow-y-auto p-4">
        <ul class="space-y-4">
          {sidebarItems.map((section) => (
            <li>
              <h3 class="font-semibold text-[var(--color-navy-900)] dark:text-white mb-2 text-sm uppercase tracking-wide">
                {section.title}
              </h3>
              {section.items && (
                <ul class="space-y-1 ml-2">
                  {section.items.map((item) => (
                    <li>
                      <a
                        href={item.href}
                        class:list={[
                          'block py-1.5 px-3 rounded-md text-sm transition-colors',
                          Astro.url.pathname === item.href
                            ? 'bg-[var(--color-gold-500)]/20 text-[var(--color-navy-900)] dark:text-white font-medium'
                            : 'text-[var(--color-text-muted)] hover:text-[var(--color-text)] hover:bg-[var(--color-bg)]',
                        ]}
                      >
                        {item.title}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </nav>
    </aside>

    <!-- Mobile sidebar toggle -->
    <button
      id="sidebar-toggle"
      class="fixed bottom-4 left-4 z-50 lg:hidden p-3 bg-[var(--color-navy-900)] text-white rounded-full shadow-lg"
      aria-label="Toggle sidebar"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>

    <!-- Mobile sidebar overlay -->
    <div id="sidebar-overlay" class="fixed inset-0 bg-black/50 z-40 hidden lg:hidden" />

    <!-- Main content -->
    <main class="flex-1 min-w-0">
      <!-- Breadcrumb -->
      <nav class="sticky top-16 z-10 bg-[var(--color-bg)]/95 backdrop-blur border-b border-[var(--color-border)] px-6 py-3">
        <ol class="flex items-center gap-2 text-sm text-[var(--color-text-muted)]">
          <li><a href="/" class="hover:text-[var(--color-text)]">{t.breadcrumb_home}</a></li>
          <li><span class="mx-1">/</span></li>
          <li><a href="/docs" class="hover:text-[var(--color-text)]">{t.breadcrumb_docs}</a></li>
          <li><span class="mx-1">/</span></li>
          <li class="text-[var(--color-text)] font-medium truncate">{title}</li>
        </ol>
      </nav>

      <article class="px-6 py-8 max-w-4xl">
        <header class="mb-8">
          <h1 class="text-4xl font-semibold text-[var(--color-navy-900)] dark:text-white mb-2">
            {title}
          </h1>
          {description && (
            <p class="text-lg text-[var(--color-text-muted)]">{description}</p>
          )}
        </header>

        <div class="prose dark:prose-invert max-w-none">
          <slot />
        </div>

        <!-- Prev/Next navigation -->
        {(prev || next) && (
          <nav class="mt-16 pt-8 border-t border-[var(--color-border)] flex justify-between items-center">
            {prev ? (
              <a href={prev.href} class="group flex items-center gap-2 text-[var(--color-text-muted)] hover:text-[var(--color-navy-900)] dark:hover:text-white">
                <svg class="w-5 h-5 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
                <span>{prev.title}</span>
              </a>
            ) : <div />}
            {next ? (
              <a href={next.href} class="group flex items-center gap-2 text-[var(--color-text-muted)] hover:text-[var(--color-navy-900)] dark:hover:text-white">
                <span>{next.title}</span>
                <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            ) : <div />}
          </nav>
        )}
      </article>
    </main>

    <!-- Table of Contents -->
    {headings.length > 0 && (
      <aside class="hidden xl:block w-56 shrink-0 border-l border-[var(--color-border)]">
        <nav class="sticky top-16 h-[calc(100vh-4rem)] overflow-y-auto p-4">
          <h2 class="font-semibold text-[var(--color-navy-900)] dark:text-white mb-4 text-sm">
            {t.toc_title}
          </h2>
          <ul class="space-y-2 text-sm" id="toc">
            {headings.filter(h => h.depth <= 3).map((heading) => (
              <li style={`margin-left: ${(heading.depth - 2) * 0.75}rem`}>
                <a
                  href={`#${heading.id}`}
                  class="block py-1 text-[var(--color-text-muted)] hover:text-[var(--color-navy-900)] dark:hover:text-white transition-colors toc-link"
                  data-heading-id={heading.id}
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </aside>
    )}
  </div>

  <script>
    // Mobile sidebar toggle
    const toggleBtn = document.getElementById('sidebar-toggle');
    const sidebar = document.getElementById('docs-sidebar');
    const overlay = document.getElementById('sidebar-overlay');

    toggleBtn?.addEventListener('click', () => {
      sidebar?.classList.toggle('hidden');
      sidebar?.classList.toggle('fixed');
      sidebar?.classList.toggle('inset-y-0');
      sidebar?.classList.toggle('left-0');
      sidebar?.classList.toggle('z-50');
      overlay?.classList.toggle('hidden');
    });

    overlay?.addEventListener('click', () => {
      sidebar?.classList.add('hidden');
      sidebar?.classList.remove('fixed', 'inset-y-0', 'left-0', 'z-50');
      overlay?.classList.add('hidden');
    });

    // Scrollspy for ToC
    const tocLinks = document.querySelectorAll('.toc-link');
    const headings = Array.from(tocLinks).map(link => {
      const id = link.getAttribute('data-heading-id');
      return id ? document.getElementById(id) : null;
    }).filter((el): el is HTMLElement => el !== null);

    if (headings.length > 0) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              tocLinks.forEach(link => link.classList.remove('text-[var(--color-orange-500)]', 'font-medium'));
              const activeLink = document.querySelector(`[data-heading-id="${entry.target.id}"]`);
              activeLink?.classList.add('text-[var(--color-orange-500)]', 'font-medium');
            }
          });
        },
        { rootMargin: '-80px 0px -80% 0px' }
      );

      headings.forEach(heading => observer.observe(heading));
    }

    // Smooth scroll for anchor links
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', (e) => {
        e.preventDefault();
        const targetId = anchor.getAttribute('href')?.substring(1);
        const target = document.getElementById(targetId || '');
        if (target) {
          const offset = 100;
          const top = target.getBoundingClientRect().top + window.scrollY - offset;
          window.scrollTo({ top, behavior: 'smooth' });
        }
      });
    });
  </script>
</BaseLayout>
