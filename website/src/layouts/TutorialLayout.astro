---
import BaseLayout from './BaseLayout.astro';

interface Lesson {
  title: string;
  slug: string;
}

interface Props {
  title: string;
  description?: string;
  tutorialTitle: string;
  tutorialSlug: string;
  lessons: Lesson[];
  currentLesson: number;
}

const { title, description, tutorialTitle, tutorialSlug, lessons, currentLesson } = Astro.props;
const currentLessonData = lessons[currentLesson];
const prevLesson = currentLesson > 0 ? lessons[currentLesson - 1] : null;
const nextLesson = currentLesson < lessons.length - 1 ? lessons[currentLesson + 1] : null;
const progressPercent = ((currentLesson + 1) / lessons.length) * 100;
---

<BaseLayout title={`${title} | ${tutorialTitle}`} description={description}>
  <div class="min-h-screen bg-[var(--color-surface-base)]">
    <!-- Progress bar -->
    <div class="h-1 bg-[var(--color-line)]">
      <div
        class="h-full bg-gradient-to-r from-[var(--color-accent-gold)] to-[var(--color-accent-warning)] transition-all duration-500"
        style={`width: ${progressPercent}%`}
        id="progress-bar"
      />
    </div>

    <div class="flex">
      <!-- Sidebar: Lesson List -->
      <aside class="hidden lg:block w-72 shrink-0 border-r border-[var(--color-line)] bg-[var(--color-surface-raise)]">
        <nav class="sticky top-16 h-[calc(100vh-4rem)] overflow-y-auto p-6">
          <a href="/tutorials" class="flex items-center gap-2 text-sm text-[var(--color-ink-2)] hover:text-[var(--color-text)] mb-4">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            All Tutorials
          </a>

          <h2 class="font-semibold text-[var(--color-ink-1)] mb-4">
            {tutorialTitle}
          </h2>

          <ul class="space-y-1">
            {lessons.map((lesson, index) => (
              <li>
                <a
                  href={`${tutorialSlug}/${lesson.slug}`}
                  class:list={[
                    'group flex items-center gap-3 px-3 py-2 rounded-lg text-sm transition-colors',
                    index === currentLesson
                      ? 'bg-[var(--color-accent-gold)]/20 text-[var(--color-ink-1)] font-medium'
                      : 'text-[var(--color-ink-2)] hover:text-[var(--color-text)] hover:bg-[var(--color-surface-base)]',
                  ]}
                  data-lesson-index={index}
                >
                  <span
                    class:list={[
                      'flex items-center justify-center w-6 h-6 rounded-full text-xs font-medium transition-colors',
                      index === currentLesson
                        ? 'bg-[var(--color-accent-gold)] text-[var(--color-ink-1)]'
                        : 'bg-[var(--color-line)] text-[var(--color-ink-2)] group-hover:bg-[var(--color-ink-2)] group-hover:text-[var(--color-ink-1)]',
                    ]}
                    data-lesson-number={index + 1}
                  >
                    <span class="lesson-number">{index + 1}</span>
                    <svg class="lesson-check hidden w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                    </svg>
                  </span>
                  {lesson.title}
                </a>
              </li>
            ))}
          </ul>

          <div class="mt-8 pt-6 border-t border-[var(--color-line)]">
            <div class="text-sm text-[var(--color-ink-2)] mb-2">
              Progress: <span id="progress-text">{currentLesson + 1}</span>/{lessons.length} lessons
            </div>
            <div class="h-2 bg-[var(--color-line)] rounded-full overflow-hidden">
              <div
                class="h-full bg-[var(--color-accent-gold)] transition-all duration-500"
                style={`width: ${progressPercent}%`}
                id="sidebar-progress"
              />
            </div>
          </div>
        </nav>
      </aside>

      <!-- Main content -->
      <main class="flex-1 min-w-0">
        <!-- Breadcrumb -->
        <nav class="sticky top-16 z-10 bg-[var(--color-surface-base)]/95 backdrop-blur border-b border-[var(--color-line)] px-6 py-3">
          <ol class="flex items-center gap-2 text-sm text-[var(--color-ink-2)]">
            <li><a href="/tutorials" class="hover:text-[var(--color-text)]">Tutorials</a></li>
            <li><span class="mx-1">/</span></li>
            <li><a href={`${tutorialSlug}`} class="hover:text-[var(--color-text)]">{tutorialTitle}</a></li>
            <li><span class="mx-1">/</span></li>
            <li class="text-[var(--color-text)] font-medium">{currentLessonData.title}</li>
          </ol>
        </nav>

        <article class="px-6 py-8 max-w-4xl">
          <header class="mb-8">
            <div class="flex items-center gap-3 mb-4">
              <span class="px-3 py-1 text-sm font-medium bg-[var(--color-accent-gold)]/20 text-[var(--color-accent-gold)] rounded-full">
                Lesson {currentLesson + 1}
              </span>
            </div>
            <h1 class="text-4xl font-semibold text-[var(--color-ink-1)] mb-2">
              {title}
            </h1>
            {description && (
              <p class="text-lg text-[var(--color-ink-2)]">{description}</p>
            )}
          </header>

          <div class="prose max-w-none">
            <slot />
          </div>

          <!-- Mark as complete button -->
          <div class="mt-12 pt-8 border-t border-[var(--color-line)]">
            <button
              id="mark-complete"
              class="w-full sm:w-auto px-6 py-3 bg-[var(--color-accent-gold)] hover:bg-[color-mix(in_srgb,var(--color-accent-gold)_85%,black)] text-[var(--color-ink-1)] font-medium rounded-lg transition-colors flex items-center justify-center gap-2"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span id="complete-text">Mark as Complete</span>
            </button>
          </div>

          <!-- Navigation -->
          <nav class="mt-8 flex justify-between items-center">
            {prevLesson ? (
              <a
                href={`${tutorialSlug}/${prevLesson.slug}`}
                class="group flex items-center gap-2 text-[var(--color-ink-2)] hover:text-[var(--color-ink-1)]"
              >
                <svg class="w-5 h-5 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
                <span>Previous: {prevLesson.title}</span>
              </a>
            ) : <div />}
            {nextLesson ? (
              <a
                href={`${tutorialSlug}/${nextLesson.slug}`}
                class="group flex items-center gap-2 text-[var(--color-ink-2)] hover:text-[var(--color-ink-1)]"
              >
                <span>Next: {nextLesson.title}</span>
                <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            ) : (
              <a
                href="/tutorials"
                class="group flex items-center gap-2 px-4 py-2 bg-[var(--color-accent-evidence)] hover:bg-[color-mix(in_srgb,var(--color-accent-evidence)_85%,black)] text-[var(--color-ink-1)] rounded-lg font-medium transition-colors"
              >
                <span>Complete Tutorial</span>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </a>
            )}
          </nav>
        </article>
      </main>
    </div>
  </div>

  <script is:inline define:vars={{ tutorialSlug, currentLesson, lessonsCount: lessons.length }}>
    // Tutorial progress tracking with localStorage
    const storageKey = `tutorial-progress-${tutorialSlug}`;

    function getProgress() {
      try {
        return JSON.parse(localStorage.getItem(storageKey) || '[]');
      } catch {
        return [];
      }
    }

    function saveProgress(completed) {
      localStorage.setItem(storageKey, JSON.stringify(completed));
    }

    function updateUI() {
      const completed = getProgress();
      const completedCount = completed.length;

      // Update sidebar lesson indicators
      document.querySelectorAll('[data-lesson-index]').forEach(el => {
        const index = parseInt(el.getAttribute('data-lesson-index') || '0');
        const numberEl = el.querySelector('.lesson-number');
        const checkEl = el.querySelector('.lesson-check');
        const badgeEl = el.querySelector('[data-lesson-number]');

        if (completed.includes(index)) {
          if (numberEl) numberEl.classList.add('hidden');
          if (checkEl) checkEl.classList.remove('hidden');
          if (badgeEl) {
            badgeEl.classList.remove('bg-[var(--color-line)]');
            badgeEl.classList.add('bg-[var(--color-accent-evidence)]');
          }
        }
      });

      // Update progress bars
      const percent = lessonsCount > 0 ? (completedCount / lessonsCount) * 100 : 0;
      const progressBar = document.getElementById('progress-bar');
      const sidebarProgress = document.getElementById('sidebar-progress');
      const progressText = document.getElementById('progress-text');

      if (progressBar) progressBar.style.width = `${percent}%`;
      if (sidebarProgress) sidebarProgress.style.width = `${percent}%`;
      if (progressText) progressText.textContent = completedCount.toString();

      // Update mark complete button
      const markBtn = document.getElementById('mark-complete');
      const completeText = document.getElementById('complete-text');
      if (completed.includes(currentLesson) && markBtn && completeText) {
        markBtn.classList.remove('bg-[var(--color-accent-gold)]', 'hover:bg-[color-mix(in_srgb,var(--color-accent-gold)_85%,black)]');
        markBtn.classList.add('bg-[var(--color-accent-evidence)]', 'hover:bg-[color-mix(in_srgb,var(--color-accent-evidence)_85%,black)]');
        completeText.textContent = 'Completed ✓';
      }
    }

    // Mark complete button handler
    document.getElementById('mark-complete')?.addEventListener('click', () => {
      const completed = getProgress();
      if (!completed.includes(currentLesson)) {
        completed.push(currentLesson);
        saveProgress(completed);
        updateUI();
      }
    });

    // Initialize on page load
    updateUI();
  </script>

  <script>
    import { gsap, prefersReducedMotion } from '../lib/motion';

    if (!prefersReducedMotion()) {
      // Article header (lesson badge, h1, description)
      const header = document.querySelector('article header');
      if (header) {
        gsap.from(header.children, {
          y: 20, opacity: 0, stagger: 0.12, duration: 0.6, ease: 'power2.out', delay: 0.05,
        });
      }

      // Prose
      const prose = document.querySelector('.prose');
      if (prose) {
        gsap.from(prose, { y: 16, opacity: 0, duration: 0.6, ease: 'power2.out', delay: 0.2 });
      }

      // Sidebar lesson list stagger
      gsap.from('[data-lesson-index]', {
        x: -12, opacity: 0, stagger: 0.05, duration: 0.4, ease: 'power2.out', delay: 0.1,
      });

      // Progress bar fill from 0 → actual width
      const bar = document.getElementById('progress-bar') as HTMLElement | null;
      if (bar) {
        const target = bar.style.width;
        bar.style.width = '0%';
        gsap.to(bar, { width: target, duration: 0.9, ease: 'power2.out', delay: 0.3 });
      }
    }
  </script>
</BaseLayout>
