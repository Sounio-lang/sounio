---
import { loadTranslations, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = await loadTranslations(locale);

const stage3Code = `if result.confidence > 0.95 {
    administer(dose)
} else {
    require_review()
}`;
---

<section class="epistemic-scroll relative" aria-label="Epistemic Computing">
  <div class="epistemic-sticky">
    <!-- Stage 1: Knowledge<T> -->
    <div class="epistemic-stage active" data-stage="1">
      <div class="container px-4 max-w-4xl">
        <div class="text-center mb-8">
          <span class="inline-block px-3 py-1 rounded-full text-sm font-medium bg-[var(--color-accent-gold)]/10 text-[var(--color-accent-gold)] mb-4">
            Knowledge&lt;T&gt;
          </span>
          <h2 class="text-4xl md:text-6xl font-bold text-[var(--color-text-primary)] mb-4">
            {t.epistemic_stage1_title ?? "Uncertainty is a Type"}
          </h2>
          <p class="text-lg md:text-xl text-[var(--color-text-secondary)] max-w-2xl mx-auto">
            {t.epistemic_stage1_body ?? "Every measurement carries what it knows \u2014 and what it doesn\u2019t."}
          </p>
        </div>
        <div class="glass glass-specular rounded-2xl p-6 max-w-2xl mx-auto">
          <pre class="!bg-transparent !p-0 text-sm md:text-base"><code><span class="text-[var(--color-accent-purple)]">let</span> temp: <span class="text-[var(--color-accent-green)]">Knowledge</span>&lt;<span class="text-[var(--color-accent-teal)]">celsius</span>&gt; = <span class="text-[var(--color-accent-gold)]">measure</span>(
    value: <span class="text-[var(--color-accent-orange)]">23.5</span>,
    uncertainty: <span class="text-[var(--color-accent-orange)]">0.2</span>,
    source: <span class="text-[var(--color-accent-green)]">"sensor_A"</span>
)</code></pre>
        </div>
      </div>
    </div>

    <!-- Stage 2: Propagation -->
    <div class="epistemic-stage" data-stage="2">
      <div class="container px-4 max-w-4xl">
        <div class="text-center mb-8">
          <span class="inline-block px-3 py-1 rounded-full text-sm font-medium bg-[var(--color-accent-green)]/10 text-[var(--color-accent-green)] mb-4">
            GUM Propagation
          </span>
          <h2 class="text-4xl md:text-6xl font-bold text-[var(--color-text-primary)] mb-4">
            {t.epistemic_stage2_title ?? "The Compiler Does the Statistics"}
          </h2>
          <p class="text-lg md:text-xl text-[var(--color-text-secondary)] max-w-2xl mx-auto">
            {t.epistemic_stage2_body ?? "GUM-compliant uncertainty propagation through every operation. Automatically."}
          </p>
        </div>
        <div class="glass glass-specular rounded-2xl p-6 max-w-2xl mx-auto">
          <pre class="!bg-transparent !p-0 text-sm md:text-base"><code><span class="text-[var(--color-accent-purple)]">let</span> kelvin = temp + <span class="text-[var(--color-accent-orange)]">273.15</span>

<span class="text-[var(--color-text-tertiary)]">// kelvin.uncertainty = 0.2  (propagated automatically)</span>
<span class="text-[var(--color-text-tertiary)]">// kelvin.confidence  = 0.973</span></code></pre>
        </div>
      </div>
    </div>

    <!-- Stage 3: Confidence Gating -->
    <div class="epistemic-stage" data-stage="3">
      <div class="container px-4 max-w-4xl">
        <div class="text-center mb-8">
          <span class="inline-block px-3 py-1 rounded-full text-sm font-medium bg-[var(--color-accent-purple)]/10 text-[var(--color-accent-purple)] mb-4">
            Confidence Gates
          </span>
          <h2 class="text-4xl md:text-6xl font-bold text-[var(--color-text-primary)] mb-4">
            {t.epistemic_stage3_title ?? "Code That Knows What It Doesn\u2019t Know"}
          </h2>
          <p class="text-lg md:text-xl text-[var(--color-text-secondary)] max-w-2xl mx-auto">
            {t.epistemic_stage3_body ?? "When confidence drops below threshold, execution takes alternative paths."}
          </p>
        </div>
        <div class="glass glass-specular rounded-2xl p-6 max-w-2xl mx-auto">
          <pre class="!bg-transparent !p-0 text-sm md:text-base"><code>{stage3Code}</code></pre>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .epistemic-scroll {
    height: 300vh;
    position: relative;
  }

  .epistemic-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .epistemic-stage {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  .epistemic-stage.active {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .epistemic-scroll {
      height: auto;
    }
    .epistemic-sticky {
      position: relative;
      height: auto;
    }
    .epistemic-stage {
      position: relative;
      opacity: 1 !important;
      padding: 4rem 0;
    }
  }
</style>

<script>
  const section = document.querySelector('.epistemic-scroll') as HTMLElement | null;
  const stages = document.querySelectorAll('.epistemic-stage');

  if (section && stages.length > 0) {
    const handleScroll = () => {
      const rect = section.getBoundingClientRect();
      const sectionHeight = section.offsetHeight;
      const progress = Math.max(0, Math.min(1, -rect.top / (sectionHeight - window.innerHeight)));
      const stageIndex = Math.min(Math.floor(progress * 3), 2);

      stages.forEach((stage, i) => {
        if (i === stageIndex) {
          stage.classList.add('active');
        } else {
          stage.classList.remove('active');
        }
      });
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();
  }
</script>
