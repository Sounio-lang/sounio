---
import { getLocalizedPath, type Locale } from '../../lib/i18n';
import Button from '../ui/Button.astro';
import ClaimChip from '../ui/ClaimChip.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const content = {
  en: {
    scientist: {
      badge: 'For scientists who can’t afford to be wrong',
      title: 'Somewhere between the measurement and the decision, the doubt gets lost.',
      description:
        'The lab says 9.8 ± 0.1. The code says 9.8. The patient gets 9.8. The ±0.1 is gone. Sounio keeps the doubt — in the type, in the compile, in the decision.',
      cta1: 'See how it works',
      cta1Href: '/learn/vancomycin-uncertainty',
      cta2: 'Explore the science',
      cta2Href: '/science',
      featured: 'From hospital dosing to particle physics — doubt is not optional',
      featuredHref: '/science',
      emblem: 'Built for people who measure things that matter.',
    },
    technical: {
      badge: 'A language that keeps the doubt',
      title: 'The compiler that says "I don’t know enough" before it says "trust me".',
      description:
        'Most languages treat uncertainty as a comment. Sounio makes it a type. Every measurement carries its confidence. Every operation propagates it. When confidence drops, the compiler refuses to run. Not a warning. A gate.',
      cta1: 'Start with Docs',
      cta1Href: '/learn/getting-started',
      cta2: 'See the proof',
      cta2Href: '/proof',
      featured: 'The 168 theorem: a language that found new mathematics',
      featuredHref: '/proof#theorem-168',
      emblem: 'Built for teams shipping high-consequence scientific software.',
    },
  },
  pt: {
    scientist: {
      badge: 'Para clínicos e pesquisadores · biomateriais e farmacologia',
      title: 'Em algum lugar entre a medição e a decisão, a dúvida se perde.',
      description:
        'O laboratório diz 9,8 ± 0,1. O código diz 9,8. O paciente recebe 9,8. O ±0,1 se foi. O Sounio mantém a dúvida — no tipo, na compilação, na decisão.',
      cta1: 'Ver como funciona',
      cta1Href: '/learn/vancomycin-uncertainty',
      cta2: 'Explorar a ciência',
      cta2Href: '/science',
      featured: 'De doses hospitalares à física de partículas — a dúvida não é opcional',
      featuredHref: '/science',
      emblem: 'Feito para pessoas que medem coisas importantes.',
    },
    technical: {
      badge: 'Uma linguagem que mantém a dúvida',
      title: 'O compilador que diz "não sei o suficiente" antes de dizer "confie em mim".',
      description:
        'A maioria das linguagens trata a incerteza como um comentário. O Sounio faz dela um tipo. Cada medição carrega sua confiança. Cada operação a propaga. Quando a confiança cai, o compilador se recusa a executar. Não um aviso. Um portão.',
      cta1: 'Começar com Docs',
      cta1Href: '/learn/getting-started',
      cta2: 'Ver as provas',
      cta2Href: '/proof',
      featured: 'O teorema 168: uma linguagem que encontrou nova matemática',
      featuredHref: '/proof#theorem-168',
      emblem: 'Feito para equipes que produzem software científico de alta consequência.',
    },
  },
};

const localeKey = (locale === 'pt' ? 'pt' : 'en') as 'pt' | 'en';
const d = content[localeKey];
---

<section class="vitrine-hero relative min-h-screen overflow-hidden">
  {/* The artifact — 9.8 ± 0.1 as entire first screen */}
  <div class="absolute inset-0 flex items-center justify-center">
    <div class="vitrine-artifact text-center">
      <div class="vitrine-label mb-4">SOUNIO</div>
      <div class="vitrine-numeral font-[var(--font-display)] text-[clamp(8rem,20vw,16rem)] font-bold leading-none tracking-[-0.05em] text-[var(--color-accent-champagne)] select-none">
        <span class="numeral-integer">9.8</span>
        <span class="numeral-uncertainty text-[0.35em] align-super ml-2">± 0.1</span>
      </div>
      <div class="vitrine-beam" aria-hidden="true"></div>
    </div>
  </div>

  {/* Erosion — the doubt getting lost as you scroll */}
  <div class="vitrine-erosion absolute inset-0 flex items-center justify-center opacity-0">
    <div class="text-center">
      <div class="vitrine-numeral font-[var(--font-display)] text-[clamp(8rem,20vw,16rem)] font-bold leading-none tracking-[-0.05em] text-[var(--color-ink-1)] select-none">
        9.8
      </div>
      <p class="mt-8 max-w-[52ch] mx-auto text-[1rem] leading-[1.7] text-[var(--color-ink-2)]">
        {d.scientist.title}
      </p>
    </div>
  </div>

  {/* Content — appears after erosion */}
  <div class="vitrine-content relative z-10 flex min-h-screen items-center justify-center px-6 opacity-0">
    <div class="grid max-w-[640px] gap-7 text-center">
      <div class="grid gap-7" data-for-audience="scientist">
        <div class="vitrine-label text-[var(--color-accent-champagne)]">{d.scientist.badge}</div>
        <h1 class="font-[var(--font-display)] text-[clamp(2rem,5vw,3.5rem)] leading-[1.08] font-medium tracking-[-0.025em] text-balance">
          {d.scientist.title}
        </h1>
        <p class="mx-auto max-w-[56ch] text-[clamp(0.98rem,1.6vw,1.18rem)] leading-[1.7] text-[var(--color-ink-2)]">
          {d.scientist.description}
        </p>
        <div class="mt-2 flex flex-wrap items-center justify-center gap-3">
          <Button href={getLocalizedPath(d.scientist.cta1Href, locale)}>{d.scientist.cta1}</Button>
          <Button href={getLocalizedPath(d.scientist.cta2Href, locale)} variant="ghost">{d.scientist.cta2}</Button>
        </div>
        <div class="mt-2 flex justify-center">
          <ClaimChip status="proven" label={d.scientist.featured} href={getLocalizedPath(d.scientist.featuredHref, locale)} />
        </div>
        <div class="mt-3 inline-flex items-center justify-center gap-3 text-[0.85rem] text-[var(--color-ink-3)]">
          <span>{d.scientist.emblem}</span>
        </div>
      </div>

      <div class="grid gap-7" data-for-audience="technical">
        <div class="vitrine-label text-[var(--color-accent-champagne)]">{d.technical.badge}</div>
        <h1 class="font-[var(--font-display)] text-[clamp(2rem,5vw,3.5rem)] leading-[1.08] font-medium tracking-[-0.025em] text-balance">
          {d.technical.title}
        </h1>
        <p class="mx-auto max-w-[56ch] text-[clamp(0.98rem,1.6vw,1.18rem)] leading-[1.7] text-[var(--color-ink-2)]">
          {d.technical.description}
        </p>
        <div class="mt-2 flex flex-wrap items-center justify-center gap-3">
          <Button href={getLocalizedPath(d.technical.cta1Href, locale)}>{d.technical.cta1}</Button>
          <Button href={getLocalizedPath(d.technical.cta2Href, locale)} variant="ghost">{d.technical.cta2}</Button>
        </div>
        <div class="mt-2 flex justify-center">
          <ClaimChip status="proven" label={d.technical.featured} href={getLocalizedPath(d.technical.featuredHref, locale)} />
        </div>
        <div class="mt-3 inline-flex items-center justify-center gap-3 text-[0.85rem] text-[var(--color-ink-3)]">
          <span>{d.technical.emblem}</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .vitrine-hero {
    background: var(--color-surface-base);
  }

  .vitrine-beam {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 1px;
    height: 100%;
    background: linear-gradient(to bottom, var(--color-accent-champagne), transparent);
    opacity: 0.3;
    pointer-events: none;
  }
</style>

<script>
  import { gsap, prefersReducedMotion } from '../../lib/motion';

  function mountHero() {
    const hero = document.querySelector<HTMLElement>('.vitrine-hero');
    if (!hero || hero.dataset.mounted) return;
    hero.dataset.mounted = 'true';

    if (prefersReducedMotion()) return;

    const artifact = hero.querySelector('.vitrine-artifact');
    const erosion = hero.querySelector('.vitrine-erosion');
    const content = hero.querySelector('.vitrine-content');
    const uncertainty = hero.querySelector('.numeral-uncertainty');

    if (!artifact || !erosion || !content) return;

    // Initial state: artifact visible, erosion and content hidden
    gsap.set(erosion, { opacity: 0 });
    gsap.set(content, { opacity: 0 });

    // Entrance: artifact fades in
    gsap.from(artifact, {
      opacity: 0,
      scale: 0.95,
      duration: 1.2,
      ease: 'power2.out',
      delay: 0.3,
    });

    // Scroll-driven erosion: uncertainty erodes away
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: hero,
        start: 'top top',
        end: '+=150%',
        scrub: 1,
        pin: true,
      },
    });

    // Phase 1: uncertainty erodes (blur + expand + fade)
    if (uncertainty) {
      tl.to(uncertainty, {
        filter: 'blur(8px)',
        letterSpacing: '0.5em',
        opacity: 0,
        duration: 1,
        ease: 'power2.in',
      }, 0);
    }

    // Phase 2: artifact fades out, erosion fades in
    tl.to(artifact, {
      opacity: 0,
      scale: 1.05,
      duration: 0.8,
      ease: 'power2.in',
    }, 0.5);

    tl.to(erosion, {
      opacity: 1,
      duration: 0.8,
      ease: 'power2.out',
    }, 0.8);

    // Phase 3: content fades in
    tl.to(content, {
      opacity: 1,
      duration: 0.8,
      ease: 'power2.out',
    }, 1.2);

    // Content children stagger
    const contentChildren = content.querySelectorAll('[data-for-audience]:not([style*="display: none"]) > *');
    if (contentChildren.length) {
      tl.from(contentChildren, {
        y: 30,
        opacity: 0,
        stagger: 0.1,
        duration: 0.6,
        ease: 'power2.out',
      }, 1.4);
    }
  }

  mountHero();
  document.addEventListener('astro:page-load', mountHero);
</script>
