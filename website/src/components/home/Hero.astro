---
import { getLocalizedPath, type Locale } from '../../lib/i18n';
import Button from '../ui/Button.astro';
import ClaimChip from '../ui/ClaimChip.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const content = {
  en: {
    scientist: {
      badge: 'For scientists who can’t afford to be wrong',
      title: 'Python gives you a number. Sounio gives you a number with a warranty.',
      description:
        'Python is great for prototypes. But when the wrong number costs a patient, a bridge, or a policy, you need more than a number. Sounio is a systems language where uncertainty is a first-class type. The compiler propagates measurement error through every operation. When confidence drops, it refuses to run. Not a warning. A gate.',
      cta1: 'See why scientists are switching',
      cta1Href: '/proof',
      cta2: 'Compare with Python',
      cta2Href: '/language#comparison',
      featured: 'Fixed-point bootstrap · 168 theorem · GUM suite — all executable',
      featuredHref: '/proof',
      emblem: 'For decisions that matter, not just prototypes.',
    },
    technical: {
      badge: 'For developers who need more than memory safety',
      title: 'Rust keeps your memory safe. Sounio keeps your science safe.',
      description:
        'Rust guarantees memory safety. Sounio guarantees memory safety AND epistemic safety. It treats uncertainty as a type, algebra as a tracked effect, and evidence as a first-class concern. The compiler proved itself by compiling itself. The type checker enforces confidence gates before any code runs.',
      cta1: 'Start with Docs',
      cta1Href: '/learn/getting-started',
      cta2: 'Compare with Rust',
      cta2Href: '/language#comparison',
      featured: 'The 168 theorem: a language that found new mathematics',
      featuredHref: '/proof#theorem-168',
      emblem: 'For systems that need to know what they don’t know.',
    },
  },
  pt: {
    scientist: {
      badge: 'Um instrumento funcional para cientistas',
      title: 'Uma linguagem de programação que mede o que sabe — e o que não sabe.',
      description:
        'O Sounio é uma linguagem de sistemas self-hosted onde a incerteza é um tipo de primeiro nível. O compilador propaga o erro de medição através de cada operação. Quando a confiança cai, ele se recusa a executar. Não um aviso. Um portão.',
      cta1: 'Ver a evidência',
      cta1Href: '/proof',
      cta2: 'Explorar a ciência',
      cta2Href: '/science',
      featured: 'Bootstrap de ponto fixo · teorema 168 · suite GUM — tudo executável',
      featuredHref: '/proof',
      emblem: 'Honesto sobre o que funciona. Claro sobre o que não funciona.',
    },
    technical: {
      badge: 'Um instrumento funcional para desenvolvedores',
      title: 'O compilador que se provou compilando a si mesmo.',
      description:
        'O Sounio é uma linguagem de sistemas self-hosted. O compilador fez bootstrap a partir de C através de três estágios até que o Estágio 2 e o Estágio 3 produzissem o mesmo binário exato. Ele trata a incerteza como um tipo, a álgebra como um efeito rastreado, e a evidência como uma preocupação de primeiro nível.',
      cta1: 'Começar com Docs',
      cta1Href: '/learn/getting-started',
      cta2: 'Ver as provas',
      cta2Href: '/proof',
      featured: 'O teorema 168: uma linguagem que encontrou nova matemática',
      featuredHref: '/proof#theorem-168',
      emblem: 'Honesto sobre o que funciona. Claro sobre o que não funciona.',
    },
  },
};

const localeKey = (locale === 'pt' ? 'pt' : 'en') as 'pt' | 'en';
const d = content[localeKey];
---

<section class="working-instrument-hero relative min-h-[90vh] overflow-hidden">
  {/* Background — subtle, honest, no drama */}
  <div class="absolute inset-0 bg-[linear-gradient(135deg,#F8F9FA_0%,#F0F1F3_50%,#F8F9FA_100%)]" aria-hidden="true"></div>

  {/* Content — honest, precise, evidence-based */}
  <div class="relative z-10 flex min-h-[90vh] items-center">
    <div class="container grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:items-center">
      {/* Left — narrative */}
      <div class="grid gap-6">
        <div class="instrument-label">{d.scientist.badge}</div>
        <h1 class="font-[var(--font-display)] text-[clamp(2.2rem,5vw,3.8rem)] leading-[1.08] font-semibold tracking-[-0.02em] text-balance">
          {d.scientist.title}
        </h1>
        <p class="max-w-[56ch] text-[clamp(0.98rem,1.6vw,1.18rem)] leading-[1.7] text-[var(--color-ink-2)]">
          {d.scientist.description}
        </p>
        <div class="mt-2 flex flex-wrap items-center gap-3">
          <Button href={getLocalizedPath(d.scientist.cta1Href, locale)}>{d.scientist.cta1}</Button>
          <Button href={getLocalizedPath(d.scientist.cta2Href, locale)} variant="ghost">{d.scientist.cta2}</Button>
        </div>
        <div class="mt-2">
          <ClaimChip status="proven" label={d.scientist.featured} href={getLocalizedPath(d.scientist.featuredHref, locale)} />
        </div>
        <div class="mt-3 inline-flex items-center gap-3 text-[0.85rem] text-[var(--color-ink-3)]">
          <span>{d.scientist.emblem}</span>
        </div>
      </div>

      {/* Right — evidence panel */}
      <div class="instrument-card-elevated p-6 md:p-8">
        <div class="instrument-label mb-4">executable evidence</div>
        <div class="grid gap-4">
          <div class="flex items-start gap-3">
            <span class="instrument-status works">works</span>
            <div>
              <div class="instrument-value">Fixed-point bootstrap</div>
              <div class="instrument-unit">stage1 == stage2 == stage3 — verified</div>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="instrument-status works">works</span>
            <div>
              <div class="instrument-value">168 theorem</div>
              <div class="instrument-unit">octonion associators = |PSL(2,7)| — CI-gated</div>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="instrument-status works">works</span>
            <div>
              <div class="instrument-value">GUM propagation</div>
              <div class="instrument-unit">NIST suite 32/32 — JCGM 100:2008 compliant</div>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="instrument-status works">works</span>
            <div>
              <div class="instrument-value">Algebraic effects</div>
              <div class="instrument-unit">IO, Mut, Div, Panic — enforced at call sites</div>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="instrument-status partial">partial</span>
            <div>
              <div class="instrument-value">Knowledge[T] confidence gate</div>
              <div class="instrument-unit">vancomycin_low_conf — expected rejection not yet firing</div>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="instrument-status partial">partial</span>
            <div>
              <div class="instrument-value">Madaros default engine</div>
              <div class="instrument-unit">lean_single works; Madaros default has known failures</div>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="instrument-status scaffold">scaffold</span>
            <div>
              <div class="instrument-value">46% of stdlib modules</div>
              <div class="instrument-unit">code present, no executable proof yet</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  {/* Technical pane — hidden for scientist audience */}
  <div class="hidden" data-for-audience="technical">
    <div class="container grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:items-center">
      <div class="grid gap-6">
        <div class="instrument-label">{d.technical.badge}</div>
        <h1 class="font-[var(--font-display)] text-[clamp(2.2rem,5vw,3.8rem)] leading-[1.08] font-semibold tracking-[-0.02em] text-balance">
          {d.technical.title}
        </h1>
        <p class="max-w-[56ch] text-[clamp(0.98rem,1.6vw,1.18rem)] leading-[1.7] text-[var(--color-ink-2)]">
          {d.technical.description}
        </p>
        <div class="mt-2 flex flex-wrap items-center gap-3">
          <Button href={getLocalizedPath(d.technical.cta1Href, locale)}>{d.technical.cta1}</Button>
          <Button href={getLocalizedPath(d.technical.cta2Href, locale)} variant="ghost">{d.technical.cta2}</Button>
        </div>
        <div class="mt-2">
          <ClaimChip status="proven" label={d.technical.featured} href={getLocalizedPath(d.technical.featuredHref, locale)} />
        </div>
        <div class="mt-3 inline-flex items-center gap-3 text-[0.85rem] text-[var(--color-ink-3)]">
          <span>{d.technical.emblem}</span>
        </div>
      </div>

      <div class="instrument-card-elevated p-6 md:p-8">
        <div class="instrument-label mb-4">executable evidence</div>
        <div class="grid gap-4">
          <div class="flex items-start gap-3">
            <span class="instrument-status works">works</span>
            <div>
              <div class="instrument-value">Fixed-point bootstrap</div>
              <div class="instrument-unit">stage1 == stage2 == stage3 — verified</div>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="instrument-status works">works</span>
            <div>
              <div class="instrument-value">168 theorem</div>
              <div class="instrument-unit">octonion associators = |PSL(2,7)| — CI-gated</div>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="instrument-status works">works</span>
            <div>
              <div class="instrument-value">GUM propagation</div>
              <div class="instrument-unit">NIST suite 32/32 — JCGM 100:2008 compliant</div>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="instrument-status works">works</span>
            <div>
              <div class="instrument-value">Algebraic effects</div>
              <div class="instrument-unit">IO, Mut, Div, Panic — enforced at call sites</div>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="instrument-status partial">partial</span>
            <div>
              <div class="instrument-value">Knowledge[T] confidence gate</div>
              <div class="instrument-unit">vancomycin_low_conf — expected rejection not yet firing</div>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="instrument-status partial">partial</span>
            <div>
              <div class="instrument-value">Madaros default engine</div>
              <div class="instrument-unit">lean_single works; Madaros default has known failures</div>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="instrument-status scaffold">scaffold</span>
            <div>
              <div class="instrument-value">46% of stdlib modules</div>
              <div class="instrument-unit">code present, no executable proof yet</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .working-instrument-hero {
    background: var(--color-surface-base);
  }
</style>

<script>
  import { gsap, prefersReducedMotion } from '../../lib/motion';

  function mountHero() {
    const hero = document.querySelector<HTMLElement>('.working-instrument-hero');
    if (!hero || hero.dataset.mounted) return;
    hero.dataset.mounted = 'true';

    if (prefersReducedMotion()) return;

    // Content entrance
    const narrative = hero.querySelector('.grid.gap-6');
    const evidence = hero.querySelector('.instrument-card-elevated');

    if (narrative) {
      gsap.from(narrative.children, {
        y: 20,
        opacity: 0,
        stagger: 0.08,
        duration: 0.6,
        ease: 'power2.out',
        delay: 0.2,
      });
    }

    if (evidence) {
      gsap.from(evidence, {
        y: 20,
        opacity: 0,
        duration: 0.6,
        ease: 'power2.out',
        delay: 0.5,
      });

      // Evidence items stagger
      const items = evidence.querySelectorAll('.flex.items-start');
      if (items.length) {
        gsap.from(items, {
          x: -10,
          opacity: 0,
          stagger: 0.06,
          duration: 0.4,
          ease: 'power2.out',
          delay: 0.7,
        });
      }
    }
  }

  mountHero();
  document.addEventListener('astro:page-load', mountHero);
</script>
