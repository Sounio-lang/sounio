---
import { Picture } from 'astro:assets';
import { getLocalizedPath, type Locale } from '../../lib/i18n';
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';
import ClaimChip from '../ui/ClaimChip.astro';

import pappouHero from '../../../public/assets/original-artworks/pappou_hero.jpg';
import yiayiaHero from '../../../public/assets/original-artworks/yiayia_hero.jpg';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const content = {
  en: {
    scientist: {
      badge: 'For scientists who can’t afford to be wrong',
      title: 'Your doctor gives you a dose. Your engineer builds a bridge. Do they know how sure they are?',
      description:
        'Somewhere between the measurement and the decision, the doubt gets lost. The lab says 9.8 ± 0.1. The code says 9.8. The patient gets 9.8. The ±0.1 is gone. Sounio keeps the doubt — in the type, in the compile, in the decision.',
      cta1: 'See how it works',
      cta1Href: '/learn/vancomycin-uncertainty',
      cta2: 'Explore the science',
      cta2Href: '/science',
      featured: 'From hospital dosing to particle physics — doubt is not optional',
      featuredHref: '/science',
      emblem: 'Built for people who measure things that matter.',
    },
    technical: {
      badge: 'A language that keeps the doubt',
      title: 'The compiler that says "I don’t know enough" before it says "trust me".',
      description:
        'Most languages treat uncertainty as a comment. Sounio makes it a type. Every measurement carries its confidence. Every operation propagates it. When confidence drops, the compiler refuses to run. Not a warning. A gate.',
      cta1: 'Start with Docs',
      cta1Href: '/learn/getting-started',
      cta2: 'See the proof',
      cta2Href: '/proof',
      featured: 'The 168 theorem: a language that found new mathematics',
      featuredHref: '/proof#theorem-168',
      emblem: 'Built for teams shipping high-consequence scientific software.',
    },
  },
  pt: {
    scientist: {
      badge: 'Para clínicos e pesquisadores · biomateriais e farmacologia',
      title: 'Seus cálculos escondem incertezas.',
      description:
        'Ao calcular uma dose de medicamento, uma métrica de paciente ou uma previsão clínica, o código tradicional fornece um único número sem contexto. O Sounio rastreia automaticamente o erro de medição, a incerteza do padrão ISO GUM e a proveniência dos dados em cada etapa da execução.',
      cta1: 'Ver Exemplo de Dosagem',
      cta1Href: '/learn/vancomycin-uncertainty',
      cta2: 'Hub de Ciência Clínica',
      cta2Href: '/science',
      featured: 'Dosagem de vancomicina que não esconde a incerteza',
      featuredHref: '/learn/vancomycin-uncertainty',
      emblem: 'Desenvolvido para segurança clínica e software científico de alta consequência.',
    },
    technical: {
      badge: 'Cadeia de ferramentas beta · linguagem epistêmica self-hosted',
      title: 'Compute na fronteira entre a certeza e a consequência.',
      description:
        'O Sounio é uma linguagem de programação de sistemas para equipas científicas que precisam de raciocinar não apenas sobre valores, mas sobre confiança, proveniência e incerteza em cada fase de execução.',
      cta1: 'Começar com Docs',
      cta1Href: '/learn/getting-started',
      cta2: 'Ver as provas',
      cta2Href: '/proof',
      featured: 'Análise aprofundada do teorema não-associativo de 168 dos Octoniões',
      featuredHref: '/proof#theorem-168',
      emblem: 'Desenvolvido para equipas que produzem software científico de alta consequência.',
    },
  },
};

const localeKey = (locale === 'pt' ? 'pt' : 'en') as 'pt' | 'en';
const d = content[localeKey];
---

<section class="hero-monument relative grid min-h-[min(940px,96vh)] items-center overflow-hidden">
  {/* Layer 1 — Pappou & Yaya protagonists (split-screen on desktop, crossfade on mobile) */}
  <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
    {/* Desktop: split-screen Pappou | Yaya */}
    <div class="hidden md:grid md:grid-cols-2 h-full">
      <div class="relative overflow-hidden">
        <Picture
          src={pappouHero}
          alt="Pappou — the elder who measures what he knows"
          class="h-full w-full object-cover object-center opacity-90"
          formats={['avif', 'webp']}
          loading="eager"
          decoding="async"
        />
        <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(7,18,36,0.55)_0%,rgba(7,18,36,0.15)_70%,rgba(7,18,36,0.35)_100%)]"></div>
      </div>
      <div class="relative overflow-hidden">
        <Picture
          src={yiayiaHero}
          alt="Yaya — the elder who carries what she doesn't know"
          class="h-full w-full object-cover object-center opacity-90"
          formats={['avif', 'webp']}
          loading="eager"
          decoding="async"
        />
        <div class="absolute inset-0 bg-[linear-gradient(270deg,rgba(7,18,36,0.55)_0%,rgba(7,18,36,0.15)_70%,rgba(7,18,36,0.35)_100%)]"></div>
      </div>
    </div>

    {/* Mobile: crossfade between Pappou and Yaya */}
    <div class="md:hidden h-full">
      <Picture
        src={pappouHero}
        alt="Pappou — the elder who measures what he knows"
        class="hero-art h-full w-full object-cover object-center opacity-90"
        formats={['avif', 'webp']}
        loading="eager"
        decoding="async"
      />
      <Picture
        src={yiayiaHero}
        alt="Yaya — the elder who carries what she doesn't know"
        class="hero-art hero-art-alt absolute inset-0 h-full w-full object-cover object-center opacity-0"
        formats={['avif', 'webp']}
        loading="lazy"
        decoding="async"
      />
      <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(7,18,36,0.65)_0%,rgba(7,18,36,0.35)_50%,rgba(7,18,36,0.75)_100%)]"></div>
    </div>

    {/* Epistemic particles overlay */}
    <canvas
      id="hero-shader"
      class="absolute inset-0 h-full w-full opacity-0 transition-opacity duration-[1600ms] ease-out"
    ></canvas>

    {/* Center contrast veil for text readability */}
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_60%_50%_at_50%_50%,rgba(7,18,36,0.4)_0%,rgba(7,18,36,0.1)_50%,transparent_100%)]"></div>
    <div class="absolute inset-x-0 bottom-0 h-40 bg-[linear-gradient(to_top,var(--color-surface-base),transparent)]"></div>
  </div>

  {/* Scientist pane */}
  <div class="relative z-10 container grid max-w-[760px] gap-7 pt-32 pb-20 md:pt-0" data-for-audience="scientist">
    <Eyebrow class="text-shadow-sm">{d.scientist.badge}</Eyebrow>
    <h1 class="font-[var(--font-display)] text-[clamp(3rem,7.5vw,6rem)] leading-[1.02] font-medium tracking-[-0.028em] text-balance text-shadow-md">
      {d.scientist.title}
    </h1>
    <p class="max-w-[58ch] text-[clamp(1rem,1.7vw,1.22rem)] leading-[1.68] text-[var(--color-ink-2)] text-shadow-sm">
      {d.scientist.description}
    </p>
    <div class="mt-2 flex flex-wrap items-center gap-3">
      <Button href={getLocalizedPath(d.scientist.cta1Href, locale)}>{d.scientist.cta1}</Button>
      <Button href={getLocalizedPath(d.scientist.cta2Href, locale)} variant="ghost">{d.scientist.cta2}</Button>
    </div>
    <div class="mt-2">
      <ClaimChip status="proven" label={d.scientist.featured} href={getLocalizedPath(d.scientist.featuredHref, locale)} />
    </div>
    <div class="mt-3 inline-flex items-center gap-3 text-[0.85rem] text-[var(--color-ink-3)]">
      <img src="/assets/stamps/emblem_badge_monochrome_on_navy.png" alt="" aria-hidden="true" class="h-[30px] w-[30px] opacity-80" loading="lazy" />
      <span>{d.scientist.emblem}</span>
    </div>
  </div>

  {/* Technical pane */}
  <div class="relative z-10 container grid max-w-[760px] gap-7 pt-32 pb-20 md:pt-0" data-for-audience="technical">
    <Eyebrow class="text-shadow-sm">{d.technical.badge}</Eyebrow>
    <h1 class="font-[var(--font-display)] text-[clamp(3rem,7.5vw,6rem)] leading-[1.02] font-medium tracking-[-0.028em] text-balance text-shadow-md">
      {d.technical.title}
    </h1>
    <p class="max-w-[58ch] text-[clamp(1rem,1.7vw,1.22rem)] leading-[1.68] text-[var(--color-ink-2)] text-shadow-sm">
      {d.technical.description}
    </p>
    <div class="mt-2 flex flex-wrap items-center gap-3">
      <Button href={getLocalizedPath(d.technical.cta1Href, locale)}>{d.technical.cta1}</Button>
      <Button href={getLocalizedPath(d.technical.cta2Href, locale)} variant="ghost">{d.technical.cta2}</Button>
    </div>
    <div class="mt-2">
      <ClaimChip status="proven" label={d.technical.featured} href={getLocalizedPath(d.technical.featuredHref, locale)} />
    </div>
    <div class="mt-3 inline-flex items-center gap-3 text-[0.85rem] text-[var(--color-ink-3)]">
      <img src="/assets/stamps/emblem_badge_monochrome_on_navy.png" alt="" aria-hidden="true" class="h-[30px] w-[30px] opacity-80" loading="lazy" />
      <span>{d.technical.emblem}</span>
    </div>
  </div>
</section>

<style>
  /* Slow brand-art crossfade under the shader (motion-safe only):
     alt image runs the same cycle shifted by half a period. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-art {
      animation: heroFilmFade 16s linear infinite;
    }
    .hero-art-alt {
      animation: heroFilmFade 16s linear infinite;
      animation-delay: -8s;
    }
  }
  @keyframes heroFilmFade {
    0%, 42% { opacity: 0.6; }
    50%, 92% { opacity: 0; }
    100% { opacity: 0.6; }
  }
</style>

<script>
  import { gsap } from '../../lib/motion';

  function mountHero() {
    const canvas = document.getElementById('hero-shader') as HTMLCanvasElement | null;
    if (!canvas || canvas.dataset.mounted) return;
    canvas.dataset.mounted = 'true';

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let w = canvas.width = canvas.offsetWidth * 1.5;
    let h = canvas.height = canvas.offsetHeight * 1.5;
    ctx.scale(1.5, 1.5);

    const mouse = { x: -1000, y: -1000, vx: 0, vy: 0 };
    let mouseActive = false;

    const onMove = (e: MouseEvent) => {
      const rect = canvas.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      mouse.vx = x - mouse.x;
      mouse.vy = y - mouse.y;
      mouse.x = x;
      mouse.y = y;
      mouseActive = true;
    };
    const onLeave = () => { mouseActive = false; mouse.x = -1000; mouse.y = -1000; };
    canvas.parentElement?.addEventListener('mousemove', onMove);
    canvas.parentElement?.addEventListener('mouseleave', onLeave);

    // Particle system — "epistemic field" (subtle, over Pappou & Yaya)
    const N = 80;
    const particles: { x: number; y: number; z: number; vx: number; vy: number; vz: number; r: number; gold: boolean }[] = [];
    for (let i = 0; i < N; i++) {
      particles.push({
        x: Math.random() * w,
        y: Math.random() * h,
        z: Math.random() * 0.8 + 0.2,
        vx: (Math.random() - 0.5) * 0.3,
        vy: (Math.random() - 0.5) * 0.3,
        vz: (Math.random() - 0.5) * 0.0015,
        r: Math.random() * 1.4 + 0.4,
        gold: Math.random() > 0.68,
      });
    }

    let t = 0;
    let raf = 0;

    function draw() {
      if (!ctx) return;
      t += 0.004;
      ctx.clearRect(0, 0, w, h);

      // subtle background — transparent, let Pappou & Yaya show through
      ctx.clearRect(0, 0, w, h);

      // draw connections
      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];
        for (let j = i + 1; j < particles.length; j++) {
          const q = particles[j];
          const dx = p.x - q.x;
          const dy = p.y - q.y;
          const dist = Math.hypot(dx, dy);
          if (dist < 120) {
            const alpha = (1 - dist / 120) * 0.08 * Math.min(p.z, q.z);
            ctx.beginPath();
            ctx.strokeStyle = p.gold || q.gold ? `rgba(214,179,90,${alpha})` : `rgba(255,255,255,${alpha})`;
            ctx.lineWidth = 0.4;
            ctx.moveTo(p.x, p.y);
            ctx.lineTo(q.x, q.y);
            ctx.stroke();
          }
        }
      }

      // update + draw particles
      for (const p of particles) {
        // drift
        p.x += p.vx + Math.sin(t + p.z * 10) * 0.15;
        p.y += p.vy + Math.cos(t * 0.8 + p.z * 8) * 0.15;
        p.z += p.vz;
        if (p.z < 0.2) p.z = 0.2;
        if (p.z > 1) p.z = 1;

        // mouse repulsion
        if (mouseActive) {
          const dx = p.x - mouse.x * 1.5;
          const dy = p.y - mouse.y * 1.5;
          const dist = Math.hypot(dx, dy);
          if (dist < 160) {
            const force = (1 - dist / 160) * 2.2;
            p.x += (dx / dist) * force;
            p.y += (dy / dist) * force;
          }
        }

        // wrap
        if (p.x < -20) p.x = w + 20;
        if (p.x > w + 20) p.x = -20;
        if (p.y < -20) p.y = h + 20;
        if (p.y > h + 20) p.y = -20;

        const size = p.r * p.z;
        const alpha = 0.15 + p.z * 0.35;
        ctx.beginPath();
        ctx.fillStyle = p.gold ? `rgba(214,179,90,${alpha})` : `rgba(255,255,255,${alpha})`;
        ctx.arc(p.x, p.y, size, 0, Math.PI * 2);
        ctx.fill();

        // glow for gold particles
        if (p.gold) {
          ctx.beginPath();
          ctx.fillStyle = `rgba(214,179,90,${alpha * 0.1})`;
          ctx.arc(p.x, p.y, size * 3, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      raf = requestAnimationFrame(draw);
    }

    raf = requestAnimationFrame(draw);

    // resize handler
    const onResize = () => {
      w = canvas.width = canvas.offsetWidth * 1.5;
      h = canvas.height = canvas.offsetHeight * 1.5;
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.scale(1.5, 1.5);
    };
    window.addEventListener('resize', onResize);

    // cleanup on page unload
    document.addEventListener('astro:before-swap', () => {
      cancelAnimationFrame(raf);
      window.removeEventListener('resize', onResize);
      canvas.parentElement?.removeEventListener('mousemove', onMove);
      canvas.parentElement?.removeEventListener('mouseleave', onLeave);
    });

    requestAnimationFrame(() => canvas.classList.remove('opacity-0'));
  }

  mountHero();
  document.addEventListener('astro:page-load', mountHero);

  // Entrance choreography for the visible audience pane
  const mm = gsap.matchMedia();
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    const pane =
      document.querySelector<HTMLElement>('.hero-monument [data-for-audience]:not([style*="display: none"])') ??
      document.querySelector('.hero-monument [data-for-audience]');
    if (!pane) return;
    gsap.from(pane.children, {
      y: 40,
      opacity: 0,
      stagger: 0.12,
      duration: 0.9,
      ease: 'power2.out',
      delay: 0.2,
      clearProps: 'opacity,transform',
    });
  });

  // Magnetic CTAs — buttons follow the mouse subtly
  function initMagnetic() {
    const buttons = document.querySelectorAll<HTMLElement>('.hero-monument a[class*="inline-flex"]');
    buttons.forEach((btn) => {
      const strength = 18;
      let raf = 0;
      const onMove = (e: MouseEvent) => {
        const rect = btn.getBoundingClientRect();
        const x = e.clientX - rect.left - rect.width / 2;
        const y = e.clientY - rect.top - rect.height / 2;
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(() => {
          btn.style.transform = `translate(${x / strength}px, ${y / strength}px)`;
        });
      };
      const onLeave = () => {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(() => {
          btn.style.transform = 'translate(0, 0)';
        });
      };
      btn.addEventListener('mousemove', onMove);
      btn.addEventListener('mouseleave', onLeave);
    });
  }
  initMagnetic();
  document.addEventListener('astro:page-load', initMagnetic);
</script>
