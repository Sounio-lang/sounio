---
import { loadTranslations, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = await loadTranslations(locale);
---

<section class="hero-section relative min-h-screen flex items-center justify-center overflow-hidden">
  <!-- Animated mesh gradient background -->
  <div class="absolute inset-0 bg-[#0a0f1a]">
    <div class="gradient-orb gradient-orb-1"></div>
    <div class="gradient-orb gradient-orb-2"></div>
    <div class="gradient-orb gradient-orb-3"></div>
    <div class="noise-overlay"></div>
  </div>

  <!-- Floating particles -->
  <div class="particles" aria-hidden="true">
    {Array.from({ length: 20 }).map((_, i) => (
      <div class="particle" style={`--delay: ${i * 0.5}s; --x: ${Math.random() * 100}%; --duration: ${15 + Math.random() * 20}s;`}></div>
    ))}
  </div>

  <!-- Grid pattern overlay -->
  <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px); background-size: 50px 50px;"></div>

  <!-- Hero content -->
  <div class="relative z-10 container px-4 py-20">
    <div class="max-w-5xl mx-auto">
      <!-- Badge -->
      <div class="flex justify-center mb-8 animate-fade-in">
        <a href="/changelog" class="group inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/5 border border-white/10 backdrop-blur-sm hover:bg-white/10 hover:border-[var(--color-gold-500)]/50 transition-all duration-300">
          <span class="flex h-2 w-2 relative">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-400"></span>
          </span>
          <span class="text-white/70 text-sm font-medium">v0.99.0</span>
          <span class="text-white/40 text-sm">—</span>
          <span class="text-[var(--color-gold-500)] text-sm font-medium group-hover:text-[var(--color-gold-400)] transition-colors">Pre-release available</span>
          <svg class="w-4 h-4 text-white/40 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <!-- Main heading with gradient text -->
      <h1 class="text-center mb-6 animate-fade-in-up" style="animation-delay: 0.1s;">
        <span class="block text-6xl md:text-8xl lg:text-9xl font-bold tracking-tight bg-gradient-to-r from-white via-white to-white/60 bg-clip-text text-transparent">
          Sounio
        </span>
      </h1>

      <!-- Tagline -->
      <p class="text-center text-xl md:text-2xl lg:text-3xl text-[var(--color-gold-500)] font-light mb-4 animate-fade-in-up" style="animation-delay: 0.2s;">
        {t.hero_tagline}
      </p>

      <!-- Subtitle -->
      <p class="text-center text-lg md:text-xl text-white/60 max-w-3xl mx-auto mb-12 animate-fade-in-up" style="animation-delay: 0.3s;">
        A systems programming language for <span class="text-white font-medium">scientific computing</span> with
        <span class="text-[var(--color-gold-400)]">epistemic types</span>,
        <span class="text-emerald-400">uncertainty propagation</span>, and
        <span class="text-purple-400">algebraic effects</span>.
      </p>

      <!-- Install command -->
      <div class="max-w-2xl mx-auto mb-12 animate-fade-in-up" style="animation-delay: 0.4s;">
        <div class="relative group">
          <div class="absolute -inset-1 bg-gradient-to-r from-[var(--color-gold-500)] via-[var(--color-orange-500)] to-purple-500 rounded-2xl blur-lg opacity-25 group-hover:opacity-40 transition-opacity duration-500"></div>
          <div class="relative flex items-center gap-4 bg-[#0d1117] rounded-xl p-1 border border-white/10">
            <div class="flex-1 flex items-center gap-3 px-5 py-4">
              <span class="text-emerald-400 font-mono text-sm">$</span>
              <code class="text-white/90 font-mono text-sm md:text-base truncate">
                {t.hero_install_cmd}
              </code>
            </div>
            <button
              type="button"
              class="copy-btn flex items-center gap-2 px-5 py-3 mr-1 bg-gradient-to-r from-[var(--color-gold-500)] to-[var(--color-orange-500)] text-[var(--color-navy-900)] rounded-lg font-semibold text-sm hover:shadow-lg hover:shadow-[var(--color-gold-500)]/25 transition-all duration-300"
              id="copy-install"
              data-copy={t.hero_install_cmd}
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
              <span class="copy-text">{t.code_copy_button}</span>
            </button>
          </div>
        </div>
      </div>

      <!-- CTA buttons -->
      <div class="flex flex-wrap gap-4 justify-center animate-fade-in-up" style="animation-delay: 0.5s;">
        <a
          href="/docs/getting-started"
          class="group relative inline-flex items-center gap-2 px-8 py-4 bg-gradient-to-r from-[var(--color-gold-500)] to-[var(--color-orange-500)] text-[var(--color-navy-900)] rounded-xl font-semibold text-lg overflow-hidden transition-all duration-300 hover:shadow-xl hover:shadow-[var(--color-gold-500)]/25 hover:-translate-y-0.5"
        >
          <span class="relative z-10">{t.hero_cta_started}</span>
          <svg class="relative z-10 w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
          <div class="absolute inset-0 bg-white opacity-0 group-hover:opacity-20 transition-opacity"></div>
        </a>

        <a
          href="/playground"
          class="group relative inline-flex items-center gap-2 px-8 py-4 bg-white/5 text-white border border-white/20 rounded-xl font-semibold text-lg backdrop-blur-sm overflow-hidden transition-all duration-300 hover:bg-white/10 hover:border-white/40 hover:-translate-y-0.5"
        >
          <svg class="w-5 h-5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>{t.hero_cta_playground}</span>
        </a>

        <a
          href="/manifesto"
          class="group relative inline-flex items-center gap-2 px-8 py-4 text-white/70 rounded-xl font-semibold text-lg transition-all duration-300 hover:text-white hover:-translate-y-0.5"
        >
          <span>{t.hero_cta_manifesto}</span>
          <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <!-- Code preview -->
      <div class="mt-20 animate-fade-in-up" style="animation-delay: 0.6s;">
        <div class="relative max-w-4xl mx-auto">
          <!-- Glow effect -->
          <div class="absolute -inset-4 bg-gradient-to-r from-[var(--color-gold-500)]/20 via-purple-500/20 to-emerald-500/20 rounded-3xl blur-2xl"></div>

          <!-- Code window -->
          <div class="relative bg-[#0d1117] rounded-2xl border border-white/10 overflow-hidden shadow-2xl">
            <!-- Window header -->
            <div class="flex items-center gap-2 px-4 py-3 bg-white/5 border-b border-white/10">
              <div class="flex gap-2">
                <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
                <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
                <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
              </div>
              <span class="flex-1 text-center text-white/40 text-sm font-mono">uncertainty_demo.sio</span>
              <div class="w-16"></div>
            </div>

            <!-- Code content -->
            <pre class="p-6 text-sm md:text-base overflow-x-auto"><code class="language-sio"><span class="text-purple-400">fn</span> <span class="text-[var(--color-gold-400)]">analyze_measurement</span>() <span class="text-purple-400">with</span> <span class="text-cyan-400">IO</span> {'{'}
    <span class="text-gray-500">// Measurements with epistemic uncertainty</span>
    <span class="text-purple-400">let</span> temperature: <span class="text-emerald-400">Knowledge</span>&lt;<span class="text-cyan-400">celsius</span>&gt; = <span class="text-[var(--color-gold-400)]">measure</span>(
        value: <span class="text-orange-400">23.5</span>,
        uncertainty: <span class="text-orange-400">0.2</span>,
        source: <span class="text-emerald-300">"sensor_A"</span>
    )

    <span class="text-gray-500">// Uncertainty propagates automatically through calculations</span>
    <span class="text-purple-400">let</span> kelvin = temperature + <span class="text-orange-400">273.15</span>

    <span class="text-gray-500">// Confidence-gated decisions</span>
    <span class="text-purple-400">if</span> kelvin.confidence &gt; <span class="text-orange-400">0.95</span> {'{'}
        <span class="text-[var(--color-gold-400)]">print</span>(<span class="text-emerald-300">"Temperature: "</span> + kelvin.<span class="text-[var(--color-gold-400)]">to_string</span>())
        <span class="text-gray-500">// → Temperature: 296.65 ± 0.2 K (confidence: 97.3%)</span>
    {'}'} <span class="text-purple-400">else</span> {'{'}
        <span class="text-[var(--color-gold-400)]">perform</span> <span class="text-cyan-400">IO</span>::<span class="text-[var(--color-gold-400)]">warn</span>(<span class="text-emerald-300">"Insufficient measurement confidence"</span>)
    {'}'}
{'}'}</code></pre>
          </div>
        </div>
      </div>

      <!-- Stats row -->
      <div class="mt-16 grid grid-cols-2 md:grid-cols-4 gap-8 max-w-4xl mx-auto animate-fade-in-up" style="animation-delay: 0.7s;">
        <div class="text-center">
          <div class="text-3xl md:text-4xl font-bold text-white mb-1">15M+</div>
          <div class="text-white/50 text-sm">Scientific Terms</div>
        </div>
        <div class="text-center">
          <div class="text-3xl md:text-4xl font-bold text-white mb-1">7</div>
          <div class="text-white/50 text-sm">Effect Types</div>
        </div>
        <div class="text-center">
          <div class="text-3xl md:text-4xl font-bold text-white mb-1">GUM</div>
          <div class="text-white/50 text-sm">Compliant</div>
        </div>
        <div class="text-center">
          <div class="text-3xl md:text-4xl font-bold text-white mb-1">Native</div>
          <div class="text-white/50 text-sm">GPU Support</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
    <svg class="w-6 h-6 text-white/30" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </div>
</section>

<style>
  .hero-section {
    background: #0a0f1a;
  }

  .gradient-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.6;
    animation: float 20s ease-in-out infinite;
  }

  .gradient-orb-1 {
    width: 600px;
    height: 600px;
    background: linear-gradient(135deg, var(--color-gold-500), var(--color-orange-500));
    top: -20%;
    left: -10%;
    animation-delay: 0s;
  }

  .gradient-orb-2 {
    width: 500px;
    height: 500px;
    background: linear-gradient(135deg, #8b5cf6, #ec4899);
    bottom: -20%;
    right: -10%;
    animation-delay: -7s;
  }

  .gradient-orb-3 {
    width: 400px;
    height: 400px;
    background: linear-gradient(135deg, #10b981, #3b82f6);
    top: 40%;
    left: 50%;
    transform: translateX(-50%);
    animation-delay: -14s;
  }

  @keyframes float {
    0%, 100% {
      transform: translate(0, 0) scale(1);
    }
    25% {
      transform: translate(30px, -30px) scale(1.05);
    }
    50% {
      transform: translate(-20px, 20px) scale(0.95);
    }
    75% {
      transform: translate(20px, 30px) scale(1.02);
    }
  }

  .noise-overlay {
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
    opacity: 0.03;
    pointer-events: none;
  }

  .particle {
    position: absolute;
    width: 4px;
    height: 4px;
    background: rgba(255, 255, 255, 0.3);
    border-radius: 50%;
    left: var(--x);
    bottom: -10px;
    animation: rise var(--duration) ease-in infinite;
    animation-delay: var(--delay);
  }

  @keyframes rise {
    0% {
      transform: translateY(0) scale(0);
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    90% {
      opacity: 1;
    }
    100% {
      transform: translateY(-100vh) scale(1);
      opacity: 0;
    }
  }

  .animate-fade-in {
    animation: fadeIn 0.8s ease forwards;
    opacity: 0;
  }

  .animate-fade-in-up {
    animation: fadeInUp 0.8s ease forwards;
    opacity: 0;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  const copyBtn = document.getElementById('copy-install');
  copyBtn?.addEventListener('click', async () => {
    const text = copyBtn.dataset.copy;
    if (text) {
      await navigator.clipboard.writeText(text);
      const textEl = copyBtn.querySelector('.copy-text');
      if (textEl) {
        const originalText = textEl.textContent;
        textEl.textContent = 'Copied!';
        setTimeout(() => {
          textEl.textContent = originalText;
        }, 2000);
      }
    }
  });
</script>
