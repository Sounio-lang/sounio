---
import { Picture } from 'astro:assets';
import { getLocalizedPath, type Locale } from '../../lib/i18n';

// Import images from public/assets so Astro processes them at build time
import pappouHero from '../../../public/assets/original-artworks/pappou_hero.png';
import yiayiaHero from '../../../public/assets/original-artworks/yiayia_hero.png';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const content = {
  en: {
    scientist: {
      badge: 'FOR CLINICIANS & RESEARCHERS • BIOMATERIALS & PHARMACOLOGY',
      title: 'Your Calculations Hide Uncertainty.',
      description: 'When you compute a drug dose, a patient metric, or a clinical prediction, traditional code gives you a single number with no context. Sounio automatically tracks measurement error, ISO GUM uncertainty, and data provenance through every step of execution.',
      cta1: 'Explore Dosing Example',
      cta1Href: '/learn/vancomycin-uncertainty',
      cta2: 'Clinical Science Hub',
      cta2Href: '/science',
      featured: 'Featured: Vancomycin dosing that cannot lie about uncertainty.',
      emblem: 'Built for clinical safety & high-consequence scientific software.'
    },
    technical: {
      badge: 'BETA TOOLCHAIN • SELF-HOSTED EPISTEMIC PL',
      title: 'Compute at the boundary between certainty and consequence.',
      description: 'Sounio is a systems programming language for scientific teams that need to reason not only about values, but about trust, provenance, and uncertainty at every stage of execution.',
      cta1: 'Start with Docs',
      cta1Href: '/learn/getting-started',
      cta2: 'See the proof',
      cta2Href: '/proof',
      featured: 'Featured: Deep-dive on the non-associative 168 Octonion theorem.',
      emblem: 'Built for teams shipping high-consequence scientific software.'
    }
  },
  pt: {
    scientist: {
      badge: 'PARA CLÍNICOS E PESQUISADORES • BIOMATERIAIS E FARMACOLOGIA',
      title: 'Seus Cálculos Escondem Incertezas.',
      description: 'Ao calcular uma dose de medicamento, uma métrica de paciente ou uma previsão clínica, o código tradicional fornece um único número sem contexto. O Sounio rastreia automaticamente o erro de medição, a incerteza do padrão ISO GUM e a proveniência dos dados em cada etapa da execução.',
      cta1: 'Ver Exemplo de Dosagem',
      cta1Href: '/learn/vancomycin-uncertainty',
      cta2: 'Hub de Ciência Clínica',
      cta2Href: '/science',
      featured: 'Destaque: Dosagem de vancomicina que não esconde a incerteza.',
      emblem: 'Desenvolvido para segurança clínica e software científico de alta consequência.'
    },
    technical: {
      badge: 'CADEIA DE FERRAMENTAS BETA • LINGUAGEM EPISTÊMICA SELF-HOSTED',
      title: 'Compute na fronteira entre a certeza e a consequência.',
      description: 'O Sounio é uma linguagem de programação de sistemas para equipas científicas que precisam de raciocinar não apenas sobre valores, mas sobre confiança, proveniência e incerteza em cada fase de execução.',
      cta1: 'Começar com Docs',
      cta1Href: '/learn/getting-started',
      cta2: 'Ver as provas',
      cta2Href: '/proof',
      featured: 'Destaque: Análise aprofundada do teorema não-associativo de 168 dos Octoniões.',
      emblem: 'Desenvolvido para equipas que produzem software científico de alta consequência.'
    }
  }
};

const localeKey = (locale === 'pt' ? 'pt' : 'en') as 'pt' | 'en';
const d = content[localeKey];
---

<section class="relative min-h-[min(900px,94vh)] pt-24 sm:pt-28 md:pt-0 grid items-center overflow-hidden">
  <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
    <Picture
      src={pappouHero}
      alt=""
      class="absolute inset-0 w-full h-full object-cover object-center animate-[filmFade_14s_linear_infinite]"
      formats={['avif', 'webp']}
      loading="eager"
      decoding="async"
    />
    <Picture
      src={yiayiaHero}
      alt=""
      class="absolute inset-0 w-full h-full object-cover object-center opacity-0 animate-[filmFade_14s_linear_infinite_reverse]"
      formats={['avif', 'webp']}
      loading="lazy"
      decoding="async"
    />
    <div class="absolute inset-0 bg-[radial-gradient(1000px_440px_at_82%_20%,rgba(214,179,90,0.26),transparent_62%),linear-gradient(120deg,rgba(7,22,44,0.87),rgba(7,22,44,0.55)_45%,rgba(7,22,44,0.92))]" style="animation: gradientPulse 6s ease-in-out infinite;"></div>
  </div>

  {/* Scientist Audience Block */}
  <div class="relative z-10 container grid gap-[1.15rem] max-w-[690px]" data-for-audience="scientist">
    <span class="badge-pill">{d.scientist.badge}</span>
    <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-7xl text-balance leading-tight font-bold">
      {d.scientist.title}
    </h1>
    <p class="text-[var(--color-text-secondary)] text-sm sm:text-base md:text-lg lg:text-xl max-w-[56ch]">
      {d.scientist.description}
    </p>
    <div class="flex flex-wrap gap-3">
      <a
        href={getLocalizedPath(d.scientist.cta1Href, locale)}
        class="inline-flex items-center justify-center gap-[0.4rem] rounded-full px-[1.2rem] py-[0.7rem] text-[0.92rem] font-[650] transition-all hover:-translate-y-px bg-[linear-gradient(120deg,var(--color-accent-gold),var(--color-accent-gold-soft))] text-[#10233e]"
      >
        {d.scientist.cta1}
      </a>
      <a
        href={getLocalizedPath(d.scientist.cta2Href, locale)}
        class="inline-flex items-center justify-center gap-[0.4rem] rounded-full px-[1.2rem] py-[0.7rem] text-[0.92rem] font-[650] transition-all hover:-translate-y-px border border-[var(--glass-border)] bg-[rgba(255,255,255,0.06)] text-[var(--color-text-primary)]"
      >
        {d.scientist.cta2}
      </a>
    </div>
    <p class="text-[var(--color-accent-gold-soft)] underline underline-offset-4 decoration-[var(--glass-border)] hover:decoration-[var(--color-accent-gold)] transition-colors mt-2">
      <a href={getLocalizedPath('/learn/vancomycin-uncertainty', locale)}>{d.scientist.featured}</a>
    </p>
    <div class="mt-1 inline-flex items-center gap-[0.7rem] text-[var(--color-text-tertiary)] text-[0.84rem]">
      <img src="/assets/stamps/emblem_badge_monochrome_on_navy.png" alt="" aria-hidden="true" class="w-8 h-8 opacity-80" />
      <span>{d.scientist.emblem}</span>
    </div>
  </div>

  {/* Technical Audience Block */}
  <div class="relative z-10 container grid gap-[1.15rem] max-w-[690px]" data-for-audience="technical">
    <span class="badge-pill">{d.technical.badge}</span>
    <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-7xl text-balance leading-tight font-bold">
      {d.technical.title}
    </h1>
    <p class="text-[var(--color-text-secondary)] text-sm sm:text-base md:text-lg lg:text-xl max-w-[56ch]">
      {d.technical.description}
    </p>
    <div class="flex flex-wrap gap-3">
      <a
        href={getLocalizedPath(d.technical.cta1Href, locale)}
        class="inline-flex items-center justify-center gap-[0.4rem] rounded-full px-[1.2rem] py-[0.7rem] text-[0.92rem] font-[650] transition-all hover:-translate-y-px bg-[linear-gradient(120deg,var(--color-accent-gold),var(--color-accent-gold-soft))] text-[#10233e]"
      >
        {d.technical.cta1}
      </a>
      <a
        href={getLocalizedPath(d.technical.cta2Href, locale)}
        class="inline-flex items-center justify-center gap-[0.4rem] rounded-full px-[1.2rem] py-[0.7rem] text-[0.92rem] font-[650] transition-all hover:-translate-y-px border border-[var(--glass-border)] bg-[rgba(255,255,255,0.06)] text-[var(--color-text-primary)]"
      >
        {d.technical.cta2}
      </a>
    </div>
    <p class="text-[var(--color-accent-gold-soft)] underline underline-offset-4 decoration-[var(--glass-border)] hover:decoration-[var(--color-accent-gold)] transition-colors mt-2">
      <a href={getLocalizedPath('/proof#theorem-168', locale)}>{d.technical.featured}</a>
    </p>
    <div class="mt-1 inline-flex items-center gap-[0.7rem] text-[var(--color-text-tertiary)] text-[0.84rem]">
      <img src="/assets/stamps/emblem_badge_monochrome_on_navy.png" alt="" aria-hidden="true" class="w-8 h-8 opacity-80" />
      <span>{d.technical.emblem}</span>
    </div>
  </div>
</section>

<style>
  @keyframes filmFade {
    0%, 38%  { opacity: 1; }
    46%, 100% { opacity: 0; }
  }

  @keyframes gradientPulse {
    0%, 100% { opacity: 0.85; }
    50%       { opacity: 1; }
  }
</style>

<script>
  import gsap from 'gsap';

  const mm = gsap.matchMedia();
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    // Animate whichever audience pane is visible on load
    const visiblePane = document.querySelector<HTMLElement>('[data-for-audience]:not([style*="display: none"])') ??
      document.querySelector('[data-for-audience]');
    if (!visiblePane) return;

    gsap.from(visiblePane.children, {
      y: 28, opacity: 0, stagger: 0.12, duration: 0.75, ease: 'power2.out', delay: 0.1,
    });
  });
</script>
