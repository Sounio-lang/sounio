---
import { Picture } from 'astro:assets';
import { getLocalizedPath, type Locale } from '../../lib/i18n';
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';
import ClaimChip from '../ui/ClaimChip.astro';

import pappouDuo from '../../../public/assets/original-artworks/pappou_hero_duotone.png';
import yiayiaDuo from '../../../public/assets/original-artworks/yiayia_hero_duotone.png';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const content = {
  en: {
    scientist: {
      badge: 'For scientists who can’t afford to be wrong',
      title: 'Your doctor gives you a dose. Your engineer builds a bridge. Do they know how sure they are?',
      description:
        'Somewhere between the measurement and the decision, the doubt gets lost. The lab says 9.8 ± 0.1. The code says 9.8. The patient gets 9.8. The ±0.1 is gone. Sounio keeps the doubt — in the type, in the compile, in the decision.',
      cta1: 'See how it works',
      cta1Href: '/learn/vancomycin-uncertainty',
      cta2: 'Explore the science',
      cta2Href: '/science',
      featured: 'From hospital dosing to particle physics — doubt is not optional',
      featuredHref: '/science',
      emblem: 'Built for people who measure things that matter.',
    },
    technical: {
      badge: 'A language that keeps the doubt',
      title: 'The compiler that says "I don’t know enough" before it says "trust me".',
      description:
        'Most languages treat uncertainty as a comment. Sounio makes it a type. Every measurement carries its confidence. Every operation propagates it. When confidence drops, the compiler refuses to run. Not a warning. A gate.',
      cta1: 'Start with Docs',
      cta1Href: '/learn/getting-started',
      cta2: 'See the proof',
      cta2Href: '/proof',
      featured: 'The 168 theorem: a language that found new mathematics',
      featuredHref: '/proof#theorem-168',
      emblem: 'Built for teams shipping high-consequence scientific software.',
    },
  },
  pt: {
    scientist: {
      badge: 'Para clínicos e pesquisadores · biomateriais e farmacologia',
      title: 'Seu médico dá uma dose. Seu engenheiro constrói uma ponte. Eles sabem o quanto têm certeza?',
      description:
        'Em algum lugar entre a medição e a decisão, a dúvida se perde. O laboratório diz 9,8 ± 0,1. O código diz 9,8. O paciente recebe 9,8. O ±0,1 se foi. O Sounio mantém a dúvida — no tipo, na compilação, na decisão.',
      cta1: 'Ver como funciona',
      cta1Href: '/learn/vancomycin-uncertainty',
      cta2: 'Explorar a ciência',
      cta2Href: '/science',
      featured: 'De doses hospitalares à física de partículas — a dúvida não é opcional',
      featuredHref: '/science',
      emblem: 'Feito para pessoas que medem coisas importantes.',
    },
    technical: {
      badge: 'Uma linguagem que mantém a dúvida',
      title: 'O compilador que diz "não sei o suficiente" antes de dizer "confie em mim".',
      description:
        'A maioria das linguagens trata a incerteza como um comentário. O Sounio faz dela um tipo. Cada medição carrega sua confiança. Cada operação a propaga. Quando a confiança cai, o compilador se recusa a executar. Não um aviso. Um portão.',
      cta1: 'Começar com Docs',
      cta1Href: '/learn/getting-started',
      cta2: 'Ver as provas',
      cta2Href: '/proof',
      featured: 'O teorema 168: uma linguagem que encontrou nova matemática',
      featuredHref: '/proof#theorem-168',
      emblem: 'Feito para equipes que produzem software científico de alta consequência.',
    },
  },
};

const localeKey = (locale === 'pt' ? 'pt' : 'en') as 'pt' | 'en';
const d = content[localeKey];
---

<section class="hero-guardians relative min-h-[min(940px,96vh)] overflow-hidden">
  {/* Layer 1 — Pappou & Yaya as monumental guardians (duotone graphic elements) */}
  <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
    {/* Pappou — left guardian */}
    <div class="absolute left-0 top-0 h-full w-[55%] md:w-[42%] overflow-hidden">
      <Picture
        src={pappouDuo}
        alt="Pappou — the elder who measures what he knows"
        class="h-full w-full object-cover object-[70%_center] opacity-85"
        formats={['avif', 'webp']}
        loading="eager"
        decoding="async"
      />
      <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(11,30,58,0.3)_0%,rgba(11,30,58,0.1)_50%,rgba(11,30,58,0.5)_100%)]"></div>
    </div>

    {/* Yaya — right guardian */}
    <div class="absolute right-0 top-0 h-full w-[55%] md:w-[42%] overflow-hidden">
      <Picture
        src={yiayiaDuo}
        alt="Yaya — the elder who carries what she doesn't know"
        class="h-full w-full object-cover object-[30%_center] opacity-85"
        formats={['avif', 'webp']}
        loading="eager"
        decoding="async"
      />
      <div class="absolute inset-0 bg-[linear-gradient(270deg,rgba(11,30,58,0.3)_0%,rgba(11,30,58,0.1)_50%,rgba(11,30,58,0.5)_100%)]"></div>
    </div>

    {/* Center blend zone — where the two guardians meet */}
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_50%_60%_at_50%_50%,rgba(11,30,58,0.4)_0%,rgba(11,30,58,0.1)_50%,transparent_100%)]"></div>

    {/* Epistemic particles overlay */}
    <canvas
      id="hero-shader"
      class="absolute inset-0 h-full w-full opacity-0 transition-opacity duration-[1600ms] ease-out"
    ></canvas>

    {/* Bottom fade */}
    <div class="absolute inset-x-0 bottom-0 h-40 bg-[linear-gradient(to_top,var(--color-surface-base),transparent)]"></div>
  </div>

  {/* Content — flows between the guardians */}
  <div class="relative z-10 flex min-h-[min(940px,96vh)] items-center justify-center px-6">
    <div class="grid max-w-[640px] gap-7 text-center">
      {/* Scientist pane */}
      <div class="grid gap-7" data-for-audience="scientist">
        <Eyebrow class="text-shadow-sm justify-center">{d.scientist.badge}</Eyebrow>
        <h1 class="font-[var(--font-display)] text-[clamp(2.8rem,6.5vw,5.2rem)] leading-[1.04] font-medium tracking-[-0.028em] text-balance text-shadow-md">
          {d.scientist.title}
        </h1>
        <p class="mx-auto max-w-[56ch] text-[clamp(0.98rem,1.6vw,1.18rem)] leading-[1.7] text-[var(--color-ink-2)] text-shadow-sm">
          {d.scientist.description}
        </p>
        <div class="mt-2 flex flex-wrap items-center justify-center gap-3">
          <Button href={getLocalizedPath(d.scientist.cta1Href, locale)}>{d.scientist.cta1}</Button>
          <Button href={getLocalizedPath(d.scientist.cta2Href, locale)} variant="ghost">{d.scientist.cta2}</Button>
        </div>
        <div class="mt-2 flex justify-center">
          <ClaimChip status="proven" label={d.scientist.featured} href={getLocalizedPath(d.scientist.featuredHref, locale)} />
        </div>
        <div class="mt-3 inline-flex items-center justify-center gap-3 text-[0.85rem] text-[var(--color-ink-3)]">
          <img src="/assets/stamps/emblem_badge_monochrome_on_navy.png" alt="" aria-hidden="true" class="h-[30px] w-[30px] opacity-80" loading="lazy" />
          <span>{d.scientist.emblem}</span>
        </div>
      </div>

      {/* Technical pane */}
      <div class="grid gap-7" data-for-audience="technical">
        <Eyebrow class="text-shadow-sm justify-center">{d.technical.badge}</Eyebrow>
        <h1 class="font-[var(--font-display)] text-[clamp(2.8rem,6.5vw,5.2rem)] leading-[1.04] font-medium tracking-[-0.028em] text-balance text-shadow-md">
          {d.technical.title}
        </h1>
        <p class="mx-auto max-w-[56ch] text-[clamp(0.98rem,1.6vw,1.18rem)] leading-[1.7] text-[var(--color-ink-2)] text-shadow-sm">
          {d.technical.description}
        </p>
        <div class="mt-2 flex flex-wrap items-center justify-center gap-3">
          <Button href={getLocalizedPath(d.technical.cta1Href, locale)}>{d.technical.cta1}</Button>
          <Button href={getLocalizedPath(d.technical.cta2Href, locale)} variant="ghost">{d.technical.cta2}</Button>
        </div>
        <div class="mt-2 flex justify-center">
          <ClaimChip status="proven" label={d.technical.featured} href={getLocalizedPath(d.technical.featuredHref, locale)} />
        </div>
        <div class="mt-3 inline-flex items-center justify-center gap-3 text-[0.85rem] text-[var(--color-ink-3)]">
          <img src="/assets/stamps/emblem_badge_monochrome_on_navy.png" alt="" aria-hidden="true" class="h-[30px] w-[30px] opacity-80" loading="lazy" />
          <span>{d.technical.emblem}</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-guardians {
    background: var(--color-surface-base);
  }

  @media (max-width: 767px) {
    .hero-guardians .absolute.left-0,
    .hero-guardians .absolute.right-0 {
      width: 100%;
      opacity: 0.4;
    }
    .hero-guardians .absolute.left-0 {
      clip-path: inset(0 50% 0 0);
    }
    .hero-guardians .absolute.right-0 {
      clip-path: inset(0 0 0 50%);
    }
  }
</style>

<script>
  import { gsap } from '../../lib/motion';

  function mountHero() {
    const canvas = document.getElementById('hero-shader') as HTMLCanvasElement | null;
    if (!canvas || canvas.dataset.mounted) return;
    canvas.dataset.mounted = 'true';

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let w = canvas.width = canvas.offsetWidth * 1.5;
    let h = canvas.height = canvas.offsetHeight * 1.5;
    ctx.scale(1.5, 1.5);

    const mouse = { x: -1000, y: -1000, vx: 0, vy: 0 };
    let mouseActive = false;

    const onMove = (e: MouseEvent) => {
      const rect = canvas.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      mouse.vx = x - mouse.x;
      mouse.vy = y - mouse.y;
      mouse.x = x;
      mouse.y = y;
      mouseActive = true;
    };
    const onLeave = () => { mouseActive = false; mouse.x = -1000; mouse.y = -1000; };
    canvas.parentElement?.addEventListener('mousemove', onMove);
    canvas.parentElement?.addEventListener('mouseleave', onLeave);

    // Particle system — "epistemic field" (subtle, over the guardians)
    const N = 60;
    const particles: { x: number; y: number; z: number; vx: number; vy: number; vz: number; r: number; gold: boolean }[] = [];
    for (let i = 0; i < N; i++) {
      particles.push({
        x: Math.random() * w,
        y: Math.random() * h,
        z: Math.random() * 0.8 + 0.2,
        vx: (Math.random() - 0.5) * 0.25,
        vy: (Math.random() - 0.5) * 0.25,
        vz: (Math.random() - 0.5) * 0.001,
        r: Math.random() * 1.2 + 0.3,
        gold: Math.random() > 0.65,
      });
    }

    let t = 0;
    let raf = 0;

    function draw() {
      if (!ctx) return;
      t += 0.004;
      ctx.clearRect(0, 0, w, h);

      // draw connections
      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];
        for (let j = i + 1; j < particles.length; j++) {
          const q = particles[j];
          const dx = p.x - q.x;
          const dy = p.y - q.y;
          const dist = Math.hypot(dx, dy);
          if (dist < 100) {
            const alpha = (1 - dist / 100) * 0.06 * Math.min(p.z, q.z);
            ctx.beginPath();
            ctx.strokeStyle = p.gold || q.gold ? `rgba(214,179,90,${alpha})` : `rgba(255,255,255,${alpha})`;
            ctx.lineWidth = 0.3;
            ctx.moveTo(p.x, p.y);
            ctx.lineTo(q.x, q.y);
            ctx.stroke();
          }
        }
      }

      // update + draw particles
      for (const p of particles) {
        p.x += p.vx + Math.sin(t + p.z * 10) * 0.1;
        p.y += p.vy + Math.cos(t * 0.8 + p.z * 8) * 0.1;
        p.z += p.vz;
        if (p.z < 0.2) p.z = 0.2;
        if (p.z > 1) p.z = 1;

        if (mouseActive) {
          const dx = p.x - mouse.x * 1.5;
          const dy = p.y - mouse.y * 1.5;
          const dist = Math.hypot(dx, dy);
          if (dist < 140) {
            const force = (1 - dist / 140) * 1.8;
            p.x += (dx / dist) * force;
            p.y += (dy / dist) * force;
          }
        }

        if (p.x < -20) p.x = w + 20;
        if (p.x > w + 20) p.x = -20;
        if (p.y < -20) p.y = h + 20;
        if (p.y > h + 20) p.y = -20;

        const size = p.r * p.z;
        const alpha = 0.12 + p.z * 0.3;
        ctx.beginPath();
        ctx.fillStyle = p.gold ? `rgba(214,179,90,${alpha})` : `rgba(255,255,255,${alpha})`;
        ctx.arc(p.x, p.y, size, 0, Math.PI * 2);
        ctx.fill();

        if (p.gold) {
          ctx.beginPath();
          ctx.fillStyle = `rgba(214,179,90,${alpha * 0.08})`;
          ctx.arc(p.x, p.y, size * 3, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      raf = requestAnimationFrame(draw);
    }

    raf = requestAnimationFrame(draw);

    const onResize = () => {
      w = canvas.width = canvas.offsetWidth * 1.5;
      h = canvas.height = canvas.offsetHeight * 1.5;
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.scale(1.5, 1.5);
    };
    window.addEventListener('resize', onResize);

    document.addEventListener('astro:before-swap', () => {
      cancelAnimationFrame(raf);
      window.removeEventListener('resize', onResize);
      canvas.parentElement?.removeEventListener('mousemove', onMove);
      canvas.parentElement?.removeEventListener('mouseleave', onLeave);
    });

    requestAnimationFrame(() => canvas.classList.remove('opacity-0'));
  }

  mountHero();
  document.addEventListener('astro:page-load', mountHero);

  // Entrance choreography — guardians reveal, then content
  const mm = gsap.matchMedia();
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    const guardians = document.querySelectorAll('.hero-guardians .absolute.left-0, .hero-guardians .absolute.right-0');
    const content = document.querySelector('.hero-guardians [data-for-audience]:not([style*="display: none"])') ?? document.querySelector('.hero-guardians [data-for-audience]');

    if (guardians.length) {
      gsap.from(guardians, {
        opacity: 0,
        scale: 1.05,
        duration: 1.4,
        ease: 'power2.out',
        stagger: 0.2,
      });
    }

    if (content) {
      gsap.from(content.children, {
        y: 40,
        opacity: 0,
        stagger: 0.12,
        duration: 0.9,
        ease: 'power2.out',
        delay: 0.4,
        clearProps: 'opacity,transform',
      });
    }
  });

  // Magnetic CTAs
  function initMagnetic() {
    const buttons = document.querySelectorAll<HTMLElement>('.hero-guardians a[class*="inline-flex"]');
    buttons.forEach((btn) => {
      const strength = 18;
      let raf = 0;
      const onMove = (e: MouseEvent) => {
        const rect = btn.getBoundingClientRect();
        const x = e.clientX - rect.left - rect.width / 2;
        const y = e.clientY - rect.top - rect.height / 2;
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(() => {
          btn.style.transform = `translate(${x / strength}px, ${y / strength}px)`;
        });
      };
      const onLeave = () => {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(() => {
          btn.style.transform = 'translate(0, 0)';
        });
      };
      btn.addEventListener('mousemove', onMove);
      btn.addEventListener('mouseleave', onLeave);
    });
  }
  initMagnetic();
  document.addEventListener('astro:page-load', initMagnetic);
</script>
