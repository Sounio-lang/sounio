---
import ZeroEventObservatory from './ZeroEventObservatory';
import { getLocalizedPath, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const content = {
  en: {
    eyebrow: 'The living observatory',
    title: 'Sounio',
    kicker: 'Epistemic systems language and evidence-carrying science foundry',
    body: 'One system for language semantics, uncertainty, research evidence, and Madaros-gated execution receipts. Results remain inspectable all the way down.',
    primary: 'Enter the observatory',
    secondary: 'Inspect the evidence',
    signal: 'Seven Zero Event histories converge on the same value without losing their origin.',
    traceLabel: 'Zero Event histories',
    traceTitle: 'Epistemic value trace',
    converged: 'Converged value',
  },
  pt: {
    eyebrow: 'O observatório vivo',
    title: 'Sounio',
    kicker: 'Linguagem de sistemas epistêmicos e foundry de ciência com evidência',
    body: 'Um único sistema para semântica, incerteza, evidência de pesquisa e recibos de execução validados pelo Madaros. Os resultados permanecem inspecionáveis até a origem.',
    primary: 'Entrar no observatório',
    secondary: 'Inspecionar a evidência',
    signal: 'Sete histórias de Zero Events convergem no mesmo valor sem perder sua origem.',
    traceLabel: 'Histórias de Zero Events',
    traceTitle: 'Traço de valor epistêmico',
    converged: 'Valor convergente',
  },
};

const d = content[locale === 'pt' ? 'pt' : 'en'];
---

<section class="observatory-hero" aria-labelledby="observatory-title">
  <div class="observatory-shell container">
    <div class="observatory-intro">
      <p class="observatory-eyebrow">{d.eyebrow}</p>
      <h1 id="observatory-title">{d.title}</h1>
      <p class="observatory-kicker">{d.kicker}</p>
      <p class="observatory-body">{d.body}</p>

      <div class="observatory-actions">
        <a class="observatory-action primary" href="#system-atlas">{d.primary}</a>
        <a class="observatory-action secondary" href={getLocalizedPath('/proof', locale)}>{d.secondary}</a>
      </div>

      <p class="observatory-signal">
        <span aria-hidden="true"></span>
        {d.signal}
      </p>
    </div>

    <div class="observatory-visual" aria-label={d.traceTitle}>
      <ZeroEventObservatory
        client:load
        locale={locale === 'pt' ? 'pt' : 'en'}
        traceLabel={d.traceLabel}
        traceTitle={d.traceTitle}
        convergedLabel={d.converged}
      />
    </div>

    <dl class="execution-receipt" aria-label="Current execution receipt">
      <div>
        <dt>Engine</dt>
        <dd>Madaros v0.80.0</dd>
      </div>
      <div>
        <dt>Compiler gate</dt>
        <dd><span class="receipt-pass">Pass</span></dd>
      </div>
      <div>
        <dt>Conformance</dt>
        <dd>16 / 16</dd>
      </div>
      <div>
        <dt>Commit</dt>
        <dd><code>635b4cc95</code></dd>
      </div>
      <div>
        <dt>Verified</dt>
        <dd>2026-07-13 UTC</dd>
      </div>
    </dl>
  </div>
</section>

<style>
  .observatory-hero {
    position: relative;
    overflow: hidden;
    min-height: 820px;
    padding: 5.2rem 0 2.2rem;
    background: #07192d;
    color: #fff;
    border-bottom: 1px solid rgba(122, 206, 211, 0.18);
  }

  .observatory-shell {
    position: relative;
    display: grid;
    grid-template-columns: minmax(280px, 0.72fr) minmax(580px, 1.55fr);
    grid-template-rows: 1fr auto;
    gap: 1.5rem 2.4rem;
    min-height: 680px;
  }

  .observatory-intro {
    align-self: center;
    padding-bottom: 1.5rem;
  }

  .observatory-eyebrow {
    width: fit-content;
    margin: 0 0 1.2rem;
    border: 1px solid rgba(214, 179, 90, 0.72);
    border-radius: 4px;
    color: #e6c775;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0;
    padding: 0.38rem 0.58rem;
    text-transform: uppercase;
  }

  .observatory-intro h1 {
    margin: 0;
    color: #fff;
    font-family: var(--font-display);
    font-size: 6.25rem;
    font-weight: 500;
    letter-spacing: 0;
    line-height: 0.95;
  }

  .observatory-kicker {
    margin: 1.1rem 0 0;
    max-width: 32ch;
    color: #b7c9d9;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.65;
    text-transform: uppercase;
  }

  .observatory-body {
    margin: 1.2rem 0 0;
    max-width: 42ch;
    color: rgba(255, 255, 255, 0.72);
    font-size: 1rem;
    line-height: 1.7;
  }

  .observatory-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.55rem;
  }

  .observatory-action {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    border-radius: 5px;
    padding: 0.7rem 1rem;
    font-size: 0.86rem;
    font-weight: 700;
    transition: background 180ms ease, border-color 180ms ease, color 180ms ease, transform 180ms ease;
  }

  .observatory-action:hover {
    transform: translateY(-1px);
  }

  .observatory-action.primary {
    border: 1px solid #d6b35a;
    background: #d6b35a;
    color: #07192d;
  }

  .observatory-action.primary:hover {
    background: #e4c875;
    color: #07192d;
  }

  .observatory-action.secondary {
    border: 1px solid rgba(58, 190, 199, 0.65);
    color: #b9eef0;
  }

  .observatory-action.secondary:hover {
    border-color: #54cbd2;
    color: #fff;
  }

  .observatory-signal {
    display: flex;
    gap: 0.65rem;
    align-items: flex-start;
    margin: 1.35rem 0 0;
    color: rgba(255, 255, 255, 0.65);
    font-size: 0.8rem;
    line-height: 1.55;
  }

  .observatory-signal span {
    flex: 0 0 auto;
    width: 8px;
    height: 8px;
    margin-top: 0.25rem;
    border-radius: 50%;
    background: #4ac5c8;
    box-shadow: 0 0 0 4px rgba(74, 197, 200, 0.12);
  }

  .observatory-visual {
    min-width: 0;
    align-self: center;
  }

  .execution-receipt {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin: 0;
    border: 1px solid rgba(139, 179, 202, 0.22);
    border-radius: 6px;
    background: #091e35;
  }

  .execution-receipt > div {
    min-width: 0;
    padding: 0.82rem 1rem;
    border-right: 1px solid rgba(139, 179, 202, 0.18);
  }

  .execution-receipt > div:last-child {
    border-right: 0;
  }

  .execution-receipt dt {
    color: #6f94ad;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    text-transform: uppercase;
  }

  .execution-receipt dd {
    overflow: hidden;
    margin: 0.3rem 0 0;
    color: #dce7ef;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .execution-receipt code {
    padding: 0;
    background: transparent;
    color: inherit;
    font-size: inherit;
  }

  .receipt-pass {
    color: #61d3c0;
    text-transform: uppercase;
  }

  @media (max-width: 1100px) {
    .observatory-shell {
      grid-template-columns: minmax(240px, 0.62fr) minmax(480px, 1.38fr);
      gap: 1.2rem;
    }

    .observatory-intro h1 {
      font-size: 4.25rem;
    }

    .execution-receipt {
      grid-template-columns: repeat(3, 1fr);
    }

    .execution-receipt > div:nth-child(3) {
      border-right: 0;
    }

    .execution-receipt > div:nth-child(n + 4) {
      border-top: 1px solid rgba(139, 179, 202, 0.18);
    }
  }

  @media (max-width: 820px) {
    .observatory-hero {
      min-height: 0;
      padding: 5.4rem 0 1.4rem;
    }

    .observatory-shell {
      display: flex;
      min-height: 0;
      flex-direction: column;
      gap: 1.2rem;
    }

    .observatory-intro {
      padding-bottom: 0;
    }

    .observatory-visual {
      width: 100%;
      align-self: stretch;
    }

    .observatory-intro h1 {
      font-size: 3.5rem;
    }

    .observatory-kicker {
      max-width: 42ch;
    }

    .observatory-body {
      max-width: 60ch;
    }

    .execution-receipt {
      grid-template-columns: repeat(2, 1fr);
    }

    .execution-receipt > div,
    .execution-receipt > div:nth-child(3) {
      border-right: 1px solid rgba(139, 179, 202, 0.18);
      border-top: 1px solid rgba(139, 179, 202, 0.18);
    }

    .execution-receipt > div:nth-child(odd) {
      border-right: 0;
    }

    .execution-receipt > div:first-child,
    .execution-receipt > div:nth-child(2) {
      border-top: 0;
    }
  }

  @media (max-width: 520px) {
    .observatory-hero {
      padding-top: 5.1rem;
      padding-bottom: 0.9rem;
    }

    .observatory-shell {
      gap: 0.85rem;
    }

    .observatory-eyebrow {
      margin-bottom: 0.8rem;
    }

    .observatory-intro h1 {
      font-size: 2.8rem;
    }

    .observatory-kicker {
      margin-top: 0.7rem;
      font-size: 0.68rem;
      line-height: 1.55;
    }

    .observatory-body {
      margin-top: 0.75rem;
      font-size: 0.88rem;
      line-height: 1.55;
    }

    .observatory-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      margin-top: 1rem;
    }

    .observatory-action {
      width: 100%;
      min-height: 42px;
      padding: 0.58rem 0.5rem;
      font-size: 0.75rem;
    }

    .observatory-signal {
      margin-top: 0.9rem;
      font-size: 0.7rem;
    }

    .execution-receipt {
      display: flex;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .execution-receipt::-webkit-scrollbar {
      display: none;
    }

    .execution-receipt > div,
    .execution-receipt > div:nth-child(odd),
    .execution-receipt > div:nth-child(n + 4) {
      flex: 0 0 132px;
      padding: 0.6rem 0.7rem;
      border-top: 0;
      border-right: 1px solid rgba(139, 179, 202, 0.18);
    }

    .execution-receipt > div:last-child {
      border-right: 0;
    }
  }
</style>
