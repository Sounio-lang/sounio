---
import { Picture } from 'astro:assets';
import { getLocalizedPath, type Locale } from '../../lib/i18n';

import pappouHero from '../../../public/assets/original-artworks/pappou_hero.png';
import yiayiaHero from '../../../public/assets/original-artworks/yiayia_hero.png';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const content = {
  en: {
    scientist: {
      badge: 'FOR CLINICIANS & RESEARCHERS - BIOMATERIALS & PHARMACOLOGY',
      title: 'Your Calculations Hide Uncertainty.',
      description: 'When you compute a drug dose, a patient metric, or a clinical prediction, traditional code gives you a single number with no context. Sounio tracks uncertainty, provenance, and evidence through the computation itself.',
      cta1: 'Explore Dosing Example',
      cta1Href: '/learn/vancomycin-uncertainty',
      cta2: 'Clinical Science Hub',
      cta2Href: '/science',
      featured: 'Featured: Vancomycin dosing that cannot lie about uncertainty.',
      emblem: 'Built for clinical safety and high-consequence scientific software.',
    },
    technical: {
      badge: 'BETA TOOLCHAIN - SELF-HOSTED EPISTEMIC PL',
      title: 'Compute at the boundary between certainty and consequence.',
      description: 'Sounio is a systems programming language for scientific teams that need to reason not only about values, but about trust, provenance, and uncertainty at every stage of execution.',
      cta1: 'Start with Docs',
      cta1Href: '/learn/getting-started',
      cta2: 'See the proof',
      cta2Href: '/proof',
      featured: 'Featured: Deep-dive on the non-associative 168 Octonion theorem.',
      emblem: 'Built for teams shipping high-consequence scientific software.',
    },
  },
  pt: {
    scientist: {
      badge: 'PARA CLINICOS E PESQUISADORES - BIOMATERIAIS E FARMACOLOGIA',
      title: 'Seus Calculos Escondem Incertezas.',
      description: 'Ao calcular uma dose, uma metrica de paciente ou uma previsao clinica, codigo tradicional entrega um numero sem contexto. Sounio rastreia incerteza, proveniencia e evidencia dentro da propria computacao.',
      cta1: 'Ver Exemplo de Dosagem',
      cta1Href: '/learn/vancomycin-uncertainty',
      cta2: 'Hub de Ciencia Clinica',
      cta2Href: '/science',
      featured: 'Destaque: dosagem de vancomicina que nao esconde a incerteza.',
      emblem: 'Desenvolvido para seguranca clinica e software cientifico de alta consequencia.',
    },
    technical: {
      badge: 'CADEIA BETA - LINGUAGEM EPISTEMICA SELF-HOSTED',
      title: 'Compute na fronteira entre certeza e consequencia.',
      description: 'Sounio e uma linguagem de sistemas para equipes cientificas que precisam raciocinar nao apenas sobre valores, mas sobre confianca, proveniencia e incerteza em cada etapa da execucao.',
      cta1: 'Comecar com Docs',
      cta1Href: '/learn/getting-started',
      cta2: 'Ver as provas',
      cta2Href: '/proof',
      featured: 'Destaque: analise do teorema nao-associativo de 168 dos Octonions.',
      emblem: 'Desenvolvido para equipes que produzem software cientifico de alta consequencia.',
    },
  },
};

const localeKey = (locale === 'pt' ? 'pt' : 'en') as 'pt' | 'en';
const d = content[localeKey];
---

<section class="sounio-hero" aria-labelledby="sounio-hero-title">
  <div class="sounio-hero-art" aria-hidden="true">
    <Picture
      src={pappouHero}
      alt=""
      class="sounio-hero-image image-a"
      formats={['avif', 'webp']}
      loading="eager"
      decoding="async"
    />
    <Picture
      src={yiayiaHero}
      alt=""
      class="sounio-hero-image image-b"
      formats={['avif', 'webp']}
      loading="lazy"
      decoding="async"
    />
    <div class="sounio-hero-veil"></div>
  </div>

  <div class="container sounio-hero-content">
    <div class="sounio-hero-copy" data-for-audience="scientist">
      <span class="badge-pill">{d.scientist.badge}</span>
      <h1 id="sounio-hero-title">{d.scientist.title}</h1>
      <p>{d.scientist.description}</p>
      <div class="sounio-hero-actions">
        <a class="hero-cta primary" href={getLocalizedPath(d.scientist.cta1Href, locale)}>{d.scientist.cta1}</a>
        <a class="hero-cta secondary" href={getLocalizedPath(d.scientist.cta2Href, locale)}>{d.scientist.cta2}</a>
      </div>
      <a class="sounio-featured-link" href={getLocalizedPath('/learn/vancomycin-uncertainty', locale)}>
        {d.scientist.featured}
      </a>
      <div class="sounio-hero-emblem">
        <img src="/assets/stamps/emblem_badge_monochrome_on_navy.png" alt="" aria-hidden="true" />
        <span>{d.scientist.emblem}</span>
      </div>
    </div>

    <div class="sounio-hero-copy" data-for-audience="technical">
      <span class="badge-pill">{d.technical.badge}</span>
      <h1 id="sounio-hero-title-technical">{d.technical.title}</h1>
      <p>{d.technical.description}</p>
      <div class="sounio-hero-actions">
        <a class="hero-cta primary" href={getLocalizedPath(d.technical.cta1Href, locale)}>{d.technical.cta1}</a>
        <a class="hero-cta secondary" href={getLocalizedPath(d.technical.cta2Href, locale)}>{d.technical.cta2}</a>
      </div>
      <a class="sounio-featured-link" href={getLocalizedPath('/proof#theorem-168', locale)}>
        {d.technical.featured}
      </a>
      <div class="sounio-hero-emblem">
        <img src="/assets/stamps/emblem_badge_monochrome_on_navy.png" alt="" aria-hidden="true" />
        <span>{d.technical.emblem}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .sounio-hero {
    position: relative;
    display: grid;
    min-height: min(900px, 94vh);
    align-items: center;
    overflow: hidden;
    padding: 6rem 0 3rem;
  }

  .sounio-hero-art {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .sounio-hero-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .sounio-hero-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .image-a {
    animation: heroFadeA 16s linear infinite;
  }

  .image-b {
    opacity: 0;
    animation: heroFadeB 16s linear infinite;
  }

  .sounio-hero-veil {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(1000px 440px at 82% 20%, rgba(214, 179, 90, 0.26), transparent 62%),
      linear-gradient(120deg, rgba(7, 22, 44, 0.88), rgba(7, 22, 44, 0.55) 45%, rgba(7, 22, 44, 0.92));
    animation: heroVeilPulse 7s ease-in-out infinite;
  }

  .sounio-hero-content {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1.15rem;
  }

  .sounio-hero-copy {
    display: grid;
    max-width: 690px;
    gap: 1.15rem;
  }

  .sounio-hero-copy h1 {
    max-width: 11ch;
    margin: 0;
    color: var(--color-text-primary);
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 5.85rem);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 0.98;
    text-wrap: balance;
  }

  .sounio-hero-copy p {
    max-width: 56ch;
    margin: 0;
    color: var(--color-text-secondary);
    font-size: clamp(1rem, 2vw, 1.18rem);
    line-height: 1.7;
  }

  .sounio-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .sounio-featured-link {
    width: fit-content;
    color: var(--color-accent-gold-soft);
    text-decoration: underline;
    text-decoration-color: var(--glass-border);
    text-underline-offset: 4px;
    transition: text-decoration-color var(--transition-fast), color var(--transition-fast);
  }

  .sounio-featured-link:hover {
    color: var(--color-accent-gold);
    text-decoration-color: var(--color-accent-gold);
  }

  .sounio-hero-emblem {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    margin-top: 0.1rem;
    color: var(--color-text-tertiary);
    font-size: 0.84rem;
  }

  .sounio-hero-emblem img {
    width: 2rem;
    height: 2rem;
    opacity: 0.84;
  }

  @keyframes heroFadeA {
    0%, 42% { opacity: 1; }
    50%, 88% { opacity: 0; }
    96%, 100% { opacity: 1; }
  }

  @keyframes heroFadeB {
    0%, 42% { opacity: 0; }
    50%, 88% { opacity: 1; }
    96%, 100% { opacity: 0; }
  }

  @keyframes heroVeilPulse {
    0%, 100% { opacity: 0.86; }
    50% { opacity: 1; }
  }

  @media (max-width: 700px) {
    .sounio-hero {
      min-height: 760px;
      padding: 5.6rem 0 2.6rem;
    }

    .sounio-hero-copy h1 {
      max-width: 12ch;
      font-size: clamp(2.55rem, 12vw, 4.25rem);
    }

    .sounio-hero-actions {
      display: grid;
      grid-template-columns: 1fr;
      max-width: 320px;
    }

    .sounio-hero-emblem {
      align-items: flex-start;
    }
  }
</style>
