---
import { Picture } from 'astro:assets';
import { getLocalizedPath, type Locale } from '../../lib/i18n';
import { getProofData } from '../../lib/proofData';
import { WebGPUSimulator } from '../science-simulators/WebGPUSimulator';

import pappouHero from '../../../public/assets/original-artworks/pappou_hero.png';
import yiayiaHero from '../../../public/assets/original-artworks/yiayia_hero.png';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const proof = getProofData();

const heroSignals = [
  {
    label: 'Release provenance',
    value: `v${proof.release.version}`,
    detail: proof.release.statusLabel,
  },
  {
    label: 'GPU public contract',
    value: `${proof.gpu.publicPassCount}/${proof.gpu.publicCheckCount}`,
    detail: `${proof.gpu.attestedTargetCount} attested targets`,
  },
  {
    label: 'Stdlib reliability',
    value: `${proof.stdlib.passCount}/${proof.stdlib.totalCount}`,
    detail: `${proof.stdlib.activeModuleEntrypoints} active entrypoints`,
  },
];
---

<section class="relative min-h-[min(980px,96vh)] grid items-center overflow-hidden">
  <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
    <Picture
      src={pappouHero}
      alt=""
      class="absolute inset-0 w-full h-full object-cover object-center animate-[filmFade_14s_linear_infinite]"
      formats={['avif', 'webp']}
      loading="eager"
      decoding="async"
    />
    <Picture
      src={yiayiaHero}
      alt=""
      class="absolute inset-0 w-full h-full object-cover object-center opacity-0 animate-[filmFade_14s_linear_infinite_reverse]"
      formats={['avif', 'webp']}
      loading="lazy"
      decoding="async"
    />
    <div class="absolute inset-0 bg-[radial-gradient(1120px_460px_at_82%_16%,rgba(214,179,90,0.26),transparent_60%),linear-gradient(120deg,rgba(7,22,44,0.9),rgba(7,22,44,0.52)_42%,rgba(4,13,24,0.95))]"></div>
  </div>

  <div class="relative z-10 container hero-grid">
    <div class="hero-copy">
      <span class="badge-pill">SOUNIO • HIGH-STAKES SCIENTIFIC SOFTWARE</span>
      <h1 class="text-[clamp(2.7rem,7vw,5.4rem)] text-balance leading-[0.96] font-bold">
        Scientific software should expose uncertainty, provenance, and proof as part of the product.
      </h1>
      <p class="text-[var(--color-text-secondary)] text-[clamp(1rem,2.4vw,1.28rem)] max-w-[58ch]">
        Sounio is being built for researchers and technical leaders who need more than beautiful abstractions:
        checked artifacts, visible boundaries, and runtime evidence that survives contact with real scientific pressure.
      </p>

      <div class="hero-actions">
        <a
          href={getLocalizedPath('/proof', locale)}
          class="inline-flex items-center justify-center gap-[0.4rem] rounded-full px-[1.2rem] py-[0.7rem] text-[0.92rem] font-[650] transition-all hover:-translate-y-px bg-[linear-gradient(120deg,var(--color-accent-gold),var(--color-accent-gold-soft))] text-[#10233e]"
        >
          See the Proof
        </a>
        <a
          href={getLocalizedPath('/learn/getting-started', locale)}
          class="inline-flex items-center justify-center gap-[0.4rem] rounded-full px-[1.2rem] py-[0.7rem] text-[0.92rem] font-[650] transition-all hover:-translate-y-px border border-[var(--glass-border)] bg-[rgba(255,255,255,0.06)] text-[var(--color-text-primary)]"
        >
          Start with Docs
        </a>
      </div>

      <div class="hero-signals" role="list" aria-label="Current proof signals">
        {heroSignals.map((signal) => (
          <article class="hero-signal glass glass-elevated" role="listitem">
            <span>{signal.label}</span>
            <strong>{signal.value}</strong>
            <p>{signal.detail}</p>
          </article>
        ))}
      </div>

      <p class="hero-research-link">
        <a href={getLocalizedPath('/science', locale)}>Research programs and validation pressure are part of the product story, not a side note.</a>
      </p>

      <div class="hero-footnote">
        <img src="/assets/stamps/emblem_badge_monochrome_on_navy.png" alt="" aria-hidden="true" class="w-8 h-8 opacity-80" />
        <span>Built for teams shipping high-consequence software who need trust to be explicit.</span>
      </div>
    </div>

    <div class="hero-visual-column">
      <div class="hero-visual-copy glass glass-specular">
        <span class="hero-visual-kicker">Flagship storefront object</span>
        <h2>WebGPU proof, not decorative motion.</h2>
        <p>
          The homepage now carries a live provenance field above the fold so the GPU/runtime story is visible before the first docs click.
        </p>
        <div class="hero-visual-links">
          <a href={getLocalizedPath('/science/gpu', locale)}>Open GPU showcase</a>
          <a href={getLocalizedPath('/releases', locale)}>Read release provenance</a>
        </div>
      </div>
      <WebGPUSimulator variant="hero" client:visible />
    </div>
  </div>
</section>

<style>
  .hero-grid {
    display: grid;
    gap: 1.4rem;
    align-items: center;
  }

  .hero-copy {
    display: grid;
    gap: 1.1rem;
    max-width: 720px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero-signals {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0.8rem;
  }

  .hero-signal {
    padding: 0.9rem 1rem;
    border-radius: var(--radius-xl);
    display: grid;
    gap: 0.2rem;
  }

  .hero-signal span {
    color: var(--color-text-tertiary);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .hero-signal strong {
    color: var(--color-text-primary);
    font-size: 1.2rem;
  }

  .hero-signal p {
    color: var(--color-text-secondary);
    font-size: 0.82rem;
  }

  .hero-research-link {
    color: var(--color-accent-gold-soft);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: var(--glass-border);
    transition: color 160ms ease, text-decoration-color 160ms ease;
  }

  .hero-research-link:hover {
    text-decoration-color: var(--color-accent-gold);
  }

  .hero-footnote {
    margin-top: 0.1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--color-text-tertiary);
    font-size: 0.84rem;
  }

  .hero-visual-column {
    display: grid;
    gap: 0.85rem;
    align-self: stretch;
  }

  .hero-visual-copy {
    border-radius: var(--radius-2xl);
    padding: 1rem 1.05rem;
    display: grid;
    gap: 0.45rem;
    background:
      radial-gradient(420px 180px at 100% 0%, color-mix(in srgb, var(--color-accent-gold) 18%, transparent), transparent 62%),
      color-mix(in srgb, var(--color-surface-frost) 88%, transparent);
  }

  .hero-visual-kicker {
    color: var(--color-accent-gold-soft);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.7rem;
    font-weight: 700;
  }

  .hero-visual-copy h2 {
    font-size: 1.15rem;
    color: var(--color-text-primary);
  }

  .hero-visual-copy p {
    color: var(--color-text-secondary);
    font-size: 0.88rem;
    max-width: 48ch;
  }

  .hero-visual-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .hero-visual-links a {
    width: fit-content;
    color: var(--color-text-primary);
    border-bottom: 1px solid color-mix(in srgb, var(--color-accent-gold) 45%, transparent);
    padding-bottom: 0.12rem;
    font-size: 0.82rem;
    font-weight: 650;
  }

  @media (min-width: 1180px) {
    .hero-grid {
      grid-template-columns: minmax(0, 0.95fr) minmax(420px, 0.85fr);
    }
  }

  @keyframes filmFade {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }
</style>
