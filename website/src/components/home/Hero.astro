---
import { Picture } from 'astro:assets';
import { getLocalizedPath, type Locale } from '../../lib/i18n';

import pappouHero from '../../../public/assets/original-artworks/pappou_hero.png';
import yiayiaHero from '../../../public/assets/original-artworks/yiayia_hero.png';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const content = {
  en: {
    scientist: {
      badge: 'SOUNIO LANGUAGE / RESEARCH',
      title: 'Sounio',
      description: 'A language for executable scientific claims: uncertainty, proof, clinical guardrails, and compiler receipts in one visible system.',
      cta1: 'Inspect Epistemic Boundary',
      cta1Href: '/proof#epistemic-boundary',
      cta2: 'Clinical Science Hub',
      cta2Href: '/science',
      featured: 'Featured: Knowledge cannot silently collapse into a plain value.',
      emblem: 'Built for clinical safety and high-consequence scientific software.',
    },
    technical: {
      badge: 'SOUNIO LANGUAGE / SELF-HOSTED TOOLCHAIN',
      title: 'Sounio',
      description: 'An epistemic systems language where trust, provenance, effects, and algebra remain visible from the type signature to the executable receipt.',
      cta1: 'Start with Docs',
      cta1Href: '/learn/getting-started',
      cta2: 'See the proof',
      cta2Href: '/proof',
      featured: 'Featured: Deep-dive on the non-associative 168 Octonion theorem.',
      emblem: 'Built for teams shipping high-consequence scientific software.',
    },
  },
  pt: {
    scientist: {
      badge: 'LINGUAGEM SOUNIO / PESQUISA',
      title: 'Sounio',
      description: 'Uma linguagem para afirmacoes cientificas executaveis: incerteza, prova, guardrails clinicos e recibos do compilador em um sistema visivel.',
      cta1: 'Inspecionar Fronteira Epistemica',
      cta1Href: '/proof#epistemic-boundary',
      cta2: 'Hub de Ciencia Clinica',
      cta2Href: '/science',
      featured: 'Destaque: Knowledge nao colapsa silenciosamente em um valor simples.',
      emblem: 'Desenvolvido para seguranca clinica e software cientifico de alta consequencia.',
    },
    technical: {
      badge: 'LINGUAGEM SOUNIO / TOOLCHAIN SELF-HOSTED',
      title: 'Sounio',
      description: 'Uma linguagem de sistemas epistemicos em que confianca, proveniencia, efeitos e algebra permanecem visiveis da assinatura tipada ao recibo executavel.',
      cta1: 'Comecar com Docs',
      cta1Href: '/learn/getting-started',
      cta2: 'Ver as provas',
      cta2Href: '/proof',
      featured: 'Destaque: analise do teorema nao-associativo de 168 dos Octonions.',
      emblem: 'Desenvolvido para equipes que produzem software cientifico de alta consequencia.',
    },
  },
};

const localeKey = (locale === 'pt' ? 'pt' : 'en') as 'pt' | 'en';
const d = content[localeKey];
---

<section class="sounio-hero" aria-labelledby="sounio-hero-title">
  <div class="sounio-hero-art" aria-hidden="true">
    <div class="sounio-hero-figure figure-pappou">
      <Picture
        src={pappouHero}
        alt=""
        class="sounio-hero-image"
        formats={['avif', 'webp']}
        loading="eager"
        decoding="async"
      />
    </div>
    <div class="sounio-hero-figure figure-yiayia">
      <Picture
        src={yiayiaHero}
        alt=""
        class="sounio-hero-image"
        formats={['avif', 'webp']}
        loading="eager"
        decoding="async"
      />
    </div>
    <div class="sounio-hero-veil"></div>
    <div class="sounio-hero-horizon"></div>
  </div>

  <div class="container sounio-hero-content">
    <div class="sounio-hero-copy" data-for-audience="scientist">
      <span class="sounio-hero-kicker">{d.scientist.badge}</span>
      <h1 id="sounio-hero-title">{d.scientist.title}</h1>
      <p>{d.scientist.description}</p>
      <div class="sounio-hero-actions">
        <a class="hero-cta primary" href={getLocalizedPath(d.scientist.cta1Href, locale)}>{d.scientist.cta1}</a>
        <a class="hero-cta secondary" href={getLocalizedPath(d.scientist.cta2Href, locale)}>{d.scientist.cta2}</a>
      </div>
      <a class="sounio-featured-link" href={getLocalizedPath('/learn/vancomycin-uncertainty', locale)}>
        {d.scientist.featured}
      </a>
      <div class="sounio-hero-emblem">
        <img src="/assets/stamps/emblem_badge_monochrome_on_navy.png" alt="" aria-hidden="true" />
        <span>{d.scientist.emblem}</span>
      </div>
    </div>

    <div class="sounio-hero-copy" data-for-audience="technical">
      <span class="sounio-hero-kicker">{d.technical.badge}</span>
      <h1 id="sounio-hero-title-technical">{d.technical.title}</h1>
      <p>{d.technical.description}</p>
      <div class="sounio-hero-actions">
        <a class="hero-cta primary" href={getLocalizedPath(d.technical.cta1Href, locale)}>{d.technical.cta1}</a>
        <a class="hero-cta secondary" href={getLocalizedPath(d.technical.cta2Href, locale)}>{d.technical.cta2}</a>
      </div>
      <a class="sounio-featured-link" href={getLocalizedPath('/proof#theorem-168', locale)}>
        {d.technical.featured}
      </a>
      <div class="sounio-hero-emblem">
        <img src="/assets/stamps/emblem_badge_monochrome_on_navy.png" alt="" aria-hidden="true" />
        <span>{d.technical.emblem}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .sounio-hero {
    position: relative;
    display: grid;
    min-height: min(860px, 92vh);
    align-items: end;
    overflow: hidden;
    padding: 7rem 0 4.25rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-accent-gold) 28%, transparent);
    background: #07162c;
  }

  .sounio-hero-art {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    overflow: hidden;
  }

  .sounio-hero-figure {
    position: relative;
    min-width: 0;
    overflow: hidden;
  }

  .sounio-hero-figure + .sounio-hero-figure {
    border-left: 1px solid rgba(214, 179, 90, 0.22);
  }

  .sounio-hero-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 42%;
  }

  .figure-pappou .sounio-hero-image {
    object-position: 54% 44%;
  }

  .figure-yiayia .sounio-hero-image {
    object-position: 48% 42%;
  }

  .sounio-hero-veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(5, 17, 34, 0.28), rgba(5, 17, 34, 0.1) 52%, rgba(5, 17, 34, 0.22)),
      linear-gradient(180deg, rgba(7, 22, 44, 0.12) 0%, rgba(7, 22, 44, 0.2) 42%, rgba(7, 22, 44, 0.94) 100%);
  }

  .sounio-hero-horizon {
    position: absolute;
    inset: auto 0 0;
    height: 36%;
    background: linear-gradient(180deg, transparent, rgba(7, 22, 44, 0.84));
  }

  .sounio-hero-content {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1.15rem;
    width: 100%;
  }

  .sounio-hero-copy {
    display: grid;
    max-width: 780px;
    gap: 1rem;
  }

  .sounio-hero-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    width: fit-content;
    color: var(--color-accent-gold-soft);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .sounio-hero-kicker::before {
    width: 2rem;
    height: 1px;
    background: var(--color-accent-gold);
    content: '';
  }

  .sounio-hero-copy h1 {
    max-width: 8ch;
    margin: 0;
    color: var(--color-text-primary);
    font-family: var(--font-display);
    font-size: clamp(4.8rem, 11vw, 9.4rem);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 0.82;
    text-wrap: balance;
  }

  .sounio-hero-copy p {
    max-width: 62ch;
    margin: 0;
    color: rgba(255, 255, 255, 0.9);
    font-size: clamp(1.05rem, 2vw, 1.34rem);
    line-height: 1.55;
  }

  .sounio-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .sounio-hero-actions :global(.hero-cta) {
    border-radius: 6px;
  }

  .sounio-featured-link {
    width: fit-content;
    color: var(--color-accent-gold-soft);
    text-decoration: underline;
    text-decoration-color: var(--glass-border);
    text-underline-offset: 4px;
    transition: text-decoration-color var(--transition-fast), color var(--transition-fast);
  }

  .sounio-featured-link:hover {
    color: var(--color-accent-gold);
    text-decoration-color: var(--color-accent-gold);
  }

  .sounio-hero-emblem {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    margin-top: 0.1rem;
    color: rgba(255, 255, 255, 0.62);
    font-size: 0.84rem;
  }

  .sounio-hero-emblem img {
    width: 2rem;
    height: 2rem;
    opacity: 0.84;
  }

  @media (max-width: 700px) {
    .sounio-hero {
      min-height: 790px;
      padding: 5.8rem 0 2.35rem;
    }

    .sounio-hero-art {
      grid-template-columns: 1.16fr 0.84fr;
    }

    .figure-pappou .sounio-hero-image {
      object-position: 58% 35%;
    }

    .figure-yiayia .sounio-hero-image {
      object-position: 51% 32%;
    }

    .sounio-hero-veil {
      background:
        linear-gradient(90deg, rgba(5, 17, 34, 0.18), rgba(5, 17, 34, 0.1)),
        linear-gradient(180deg, rgba(7, 22, 44, 0.12) 0%, rgba(7, 22, 44, 0.32) 38%, rgba(7, 22, 44, 0.98) 76%);
    }

    .sounio-hero-copy h1 {
      font-size: clamp(4rem, 21vw, 6rem);
      line-height: 0.88;
    }

    .sounio-hero-copy p {
      font-size: 1rem;
      line-height: 1.5;
    }

    .sounio-hero-actions {
      display: grid;
      grid-template-columns: 1fr;
      max-width: 320px;
    }

    .sounio-hero-emblem {
      align-items: flex-start;
      font-size: 0.76rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sounio-hero-image {
      animation: none;
    }
  }
</style>
