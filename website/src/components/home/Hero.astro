---
import { getLocalizedPath, type Locale } from '../../lib/i18n';
import Button from '../ui/Button.astro';
import ClaimChip from '../ui/ClaimChip.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const content = {
  en: {
    scientist: {
      badge: 'For scientists who can’t afford to be wrong',
      title: 'Your doctor gives you a dose. Your engineer builds a bridge. Do they know how sure they are?',
      description:
        'Somewhere between the measurement and the decision, the doubt gets lost. The lab says 9.8 ± 0.1. The code says 9.8. The patient gets 9.8. The ±0.1 is gone. Sounio keeps the doubt — in the type, in the compile, in the decision.',
      cta1: 'See how it works',
      cta1Href: '/learn/vancomycin-uncertainty',
      cta2: 'Explore the science',
      cta2Href: '/science',
      featured: 'From hospital dosing to particle physics — doubt is not optional',
      featuredHref: '/science',
      emblem: 'Built for people who measure things that matter.',
    },
    technical: {
      badge: 'A language that keeps the doubt',
      title: 'The compiler that says "I don’t know enough" before it says "trust me".',
      description:
        'Most languages treat uncertainty as a comment. Sounio makes it a type. Every measurement carries its confidence. Every operation propagates it. When confidence drops, the compiler refuses to run. Not a warning. A gate.',
      cta1: 'Start with Docs',
      cta1Href: '/learn/getting-started',
      cta2: 'See the proof',
      cta2Href: '/proof',
      featured: 'The 168 theorem: a language that found new mathematics',
      featuredHref: '/proof#theorem-168',
      emblem: 'Built for teams shipping high-consequence scientific software.',
    },
  },
  pt: {
    scientist: {
      badge: 'Para clínicos e pesquisadores · biomateriais e farmacologia',
      title: 'Seu médico dá uma dose. Seu engenheiro constrói uma ponte. Eles sabem o quanto têm certeza?',
      description:
        'Em algum lugar entre a medição e a decisão, a dúvida se perde. O laboratório diz 9,8 ± 0,1. O código diz 9,8. O paciente recebe 9,8. O ±0,1 se foi. O Sounio mantém a dúvida — no tipo, na compilação, na decisão.',
      cta1: 'Ver como funciona',
      cta1Href: '/learn/vancomycin-uncertainty',
      cta2: 'Explorar a ciência',
      cta2Href: '/science',
      featured: 'De doses hospitalares à física de partículas — a dúvida não é opcional',
      featuredHref: '/science',
      emblem: 'Feito para pessoas que medem coisas importantes.',
    },
    technical: {
      badge: 'Uma linguagem que mantém a dúvida',
      title: 'O compilador que diz "não sei o suficiente" antes de dizer "confie em mim".',
      description:
        'A maioria das linguagens trata a incerteza como um comentário. O Sounio faz dela um tipo. Cada medição carrega sua confiança. Cada operação a propaga. Quando a confiança cai, o compilador se recusa a executar. Não um aviso. Um portão.',
      cta1: 'Começar com Docs',
      cta1Href: '/learn/getting-started',
      cta2: 'Ver as provas',
      cta2Href: '/proof',
      featured: 'O teorema 168: uma linguagem que encontrou nova matemática',
      featuredHref: '/proof#theorem-168',
      emblem: 'Feito para equipes que produzem software científico de alta consequência.',
    },
  },
};

const localeKey = (locale === 'pt' ? 'pt' : 'en') as 'pt' | 'en';
const d = content[localeKey];
---

<section class="sounion-exe-hero relative min-h-screen overflow-hidden">
  {/* Desktop background — chrome temple ray-traced */}
  <div class="absolute inset-0 bg-[linear-gradient(135deg,#DDE1E6_0%,#E8ECF0_50%,#D0D5DC_100%)]" aria-hidden="true">
    {/* Chrome temple silhouette */}
    <div class="absolute inset-0 flex items-center justify-center opacity-10">
      <svg viewBox="0 0 800 400" class="w-full max-w-4xl" aria-hidden="true">
        <defs>
          <linearGradient id="chrome" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#C9C9C9" />
            <stop offset="50%" stop-color="#E8ECF0" />
            <stop offset="100%" stop-color="#A8ACB0" />
          </linearGradient>
        </defs>
        {/* Temple columns */}
        <g fill="url(#chrome)">
          <rect x="100" y="200" width="20" height="150" />
          <rect x="150" y="200" width="20" height="150" />
          <rect x="200" y="200" width="20" height="150" />
          <rect x="250" y="200" width="20" height="150" />
          <rect x="300" y="200" width="20" height="150" />
          <rect x="350" y="200" width="20" height="150" />
          <rect x="400" y="200" width="20" height="150" />
          <rect x="450" y="200" width="20" height="150" />
          <rect x="500" y="200" width="20" height="150" />
          <rect x="550" y="200" width="20" height="150" />
          <rect x="600" y="200" width="20" height="150" />
          <rect x="650" y="200" width="20" height="150" />
        </g>
        {/* Pediment */}
        <polygon points="50,200 750,200 700,100 100,100" fill="url(#chrome)" />
      </svg>
    </div>
  </div>

  {/* Y2K Window — the entire hero is a window */}
  <div class="relative z-10 flex min-h-screen items-center justify-center p-6">
    <div class="y2k-window w-full max-w-4xl">
      {/* Window titlebar */}
      <div class="y2k-window-titlebar">
        <span>sounion.exe — epistemic operating system</span>
        <div class="y2k-window-controls">
          <span class="y2k-window-control minimize" aria-hidden="true"></span>
          <span class="y2k-window-control maximize" aria-hidden="true"></span>
          <span class="y2k-window-control close" aria-hidden="true"></span>
        </div>
      </div>

      {/* Window content */}
      <div class="p-8 md:p-12">
        {/* Boot sequence */}
        <div class="boot-sequence mb-8 font-mono text-[0.82rem] leading-[1.6] text-[var(--color-ink-2)]" aria-hidden="true">
          <div class="boot-line">SOUNION.EXE v1.0.0 — epistemic operating system</div>
          <div class="boot-line">copyright (c) 1999 pappou &amp; yaya, cape sounion labs</div>
          <div class="boot-line">checking memory... 640K OK</div>
          <div class="boot-line">checking uncertainty coprocessor... OK</div>
          <div class="boot-line">mounting /temple... OK</div>
          <div class="boot-line">loading epistemic kernel... OK</div>
          <div class="boot-line text-[var(--color-accent-lime)]">system ready. doubt level: nominal.</div>
        </div>

        {/* Main content */}
        <div class="grid gap-6" data-for-audience="scientist">
          <div class="vitrine-label text-[var(--color-accent-hyperlink)]">{d.scientist.badge}</div>
          <h1 class="font-[var(--font-display)] text-[clamp(2rem,5vw,3.5rem)] leading-[1.08] font-normal tracking-[0.02em] text-balance lowercase">
            {d.scientist.title}
          </h1>
          <p class="max-w-[56ch] text-[clamp(0.98rem,1.6vw,1.18rem)] leading-[1.7] text-[var(--color-ink-2)]">
            {d.scientist.description}
          </p>
          <div class="mt-2 flex flex-wrap items-center gap-3">
            <Button href={getLocalizedPath(d.scientist.cta1Href, locale)}>{d.scientist.cta1}</Button>
            <Button href={getLocalizedPath(d.scientist.cta2Href, locale)} variant="ghost">{d.scientist.cta2}</Button>
          </div>
          <div class="mt-2">
            <ClaimChip status="proven" label={d.scientist.featured} href={getLocalizedPath(d.scientist.featuredHref, locale)} />
          </div>
          <div class="mt-3 inline-flex items-center gap-3 text-[0.85rem] text-[var(--color-ink-3)]">
            <span>{d.scientist.emblem}</span>
          </div>
        </div>

        <div class="grid gap-6" data-for-audience="technical">
          <div class="vitrine-label text-[var(--color-accent-hyperlink)]">{d.technical.badge}</div>
          <h1 class="font-[var(--font-display)] text-[clamp(2rem,5vw,3.5rem)] leading-[1.08] font-normal tracking-[0.02em] text-balance lowercase">
            {d.technical.title}
          </h1>
          <p class="max-w-[56ch] text-[clamp(0.98rem,1.6vw,1.18rem)] leading-[1.7] text-[var(--color-ink-2)]">
            {d.technical.description}
          </p>
          <div class="mt-2 flex flex-wrap items-center gap-3">
            <Button href={getLocalizedPath(d.technical.cta1Href, locale)}>{d.technical.cta1}</Button>
            <Button href={getLocalizedPath(d.technical.cta2Href, locale)} variant="ghost">{d.technical.cta2}</Button>
          </div>
          <div class="mt-2">
            <ClaimChip status="proven" label={d.technical.featured} href={getLocalizedPath(d.technical.featuredHref, locale)} />
          </div>
          <div class="mt-3 inline-flex items-center gap-3 text-[0.85rem] text-[var(--color-ink-3)]">
            <span>{d.technical.emblem}</span>
          </div>
        </div>
      </div>

      {/* Window status bar */}
      <div class="y2k-statusbar border-t border-[var(--color-line)] bg-[var(--color-surface-overlay)] px-4 py-2 font-mono text-[0.72rem] text-[var(--color-ink-3)] flex justify-between">
        <span>sounion.exe</span>
        <span>conf: 97.3% · doubt: 0.31 · ready</span>
      </div>
    </div>
  </div>
</section>

<style>
  .sounion-exe-hero {
    background: var(--color-surface-base);
  }

  .y2k-statusbar {
    font-family: var(--font-mono);
  }

  .boot-line {
    opacity: 0;
    animation: boot-print 0.3s ease-out forwards;
  }

  .boot-line:nth-child(1) { animation-delay: 0.1s; }
  .boot-line:nth-child(2) { animation-delay: 0.3s; }
  .boot-line:nth-child(3) { animation-delay: 0.5s; }
  .boot-line:nth-child(4) { animation-delay: 0.7s; }
  .boot-line:nth-child(5) { animation-delay: 0.9s; }
  .boot-line:nth-child(6) { animation-delay: 1.1s; }
  .boot-line:nth-child(7) { animation-delay: 1.3s; }

  @keyframes boot-print {
    to { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .boot-line {
      opacity: 1;
      animation: none;
    }
  }
</style>

<script>
  import { gsap, prefersReducedMotion } from '../../lib/motion';

  function mountHero() {
    const hero = document.querySelector<HTMLElement>('.sounion-exe-hero');
    if (!hero || hero.dataset.mounted) return;
    hero.dataset.mounted = 'true';

    if (prefersReducedMotion()) return;

    // Window entrance
    const window = hero.querySelector('.y2k-window');
    if (window) {
      gsap.from(window, {
        y: 40,
        opacity: 0,
        scale: 0.95,
        duration: 0.8,
        ease: 'power2.out',
        delay: 0.5,
      });
    }

    // Content entrance after boot
    const content = hero.querySelector('[data-for-audience]:not([style*="display: none"])');
    if (content) {
      gsap.from(content.children, {
        y: 20,
        opacity: 0,
        stagger: 0.1,
        duration: 0.6,
        ease: 'power2.out',
        delay: 1.5,
      });
    }
  }

  mountHero();
  document.addEventListener('astro:page-load', mountHero);
</script>
