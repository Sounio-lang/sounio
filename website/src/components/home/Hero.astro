---
import { Picture } from 'astro:assets';
import { getLocalizedPath, type Locale } from '../../lib/i18n';
import WebGPUHeroCanvas from './WebGPUHeroCanvas';

import pappouHero from '../../../public/assets/original-artworks/pappou_hero.png';
import yiayiaHero from '../../../public/assets/original-artworks/yiayia_hero.png';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<section class="hero-reset relative min-h-[100svh] overflow-hidden pt-20 pb-10">
  <div class="absolute inset-0 bg-[#061123]" aria-hidden="true"></div>
  <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
    <Picture
      src={pappouHero}
      alt=""
      class="hero-image hero-image-a"
      formats={['avif', 'webp']}
      loading="eager"
      decoding="async"
    />
    <Picture
      src={yiayiaHero}
      alt=""
      class="hero-image hero-image-b"
      formats={['avif', 'webp']}
      loading="lazy"
      decoding="async"
    />
    <div class="hero-film"></div>
    <div class="hero-vignette"></div>
  </div>

  <div class="container relative z-10 grid gap-8">
    <div class="hero-copy max-w-[60rem] justify-self-center text-center">
      <div class="hero-topline">
        <span class="badge-pill hero-badge">SOUNIO</span>
        <img
          src="/assets/stamps/emblem_badge_monochrome_on_navy.png"
          alt=""
          aria-hidden="true"
          class="h-10 w-10 rounded-full border border-white/10 bg-black/20 p-1 opacity-85 backdrop-blur-md"
          loading="eager"
          decoding="async"
        />
      </div>

      <h1 class="hero-title">Software should express not only what it computes, but what it can justify.</h1>

      <p class="hero-subtitle">
        For scientific and AI systems where uncertainty and provenance must survive the final decision.
      </p>

      <div class="hero-actions">
        <a
          href={getLocalizedPath('/about/vision', locale)}
          class="inline-flex items-center justify-center gap-[0.4rem] rounded-full px-[1.2rem] py-[0.76rem] text-[0.92rem] font-[650] transition-all hover:-translate-y-px bg-[linear-gradient(120deg,var(--color-accent-gold),var(--color-accent-gold-soft))] text-[#10233e]"
        >
          Manifesto
        </a>
        <a
          href={getLocalizedPath('/proof', locale)}
          class="inline-flex items-center justify-center gap-[0.4rem] rounded-full px-[1.2rem] py-[0.76rem] text-[0.92rem] font-[650] transition-all hover:-translate-y-px border border-[var(--glass-border)] bg-[rgba(255,255,255,0.06)] text-[var(--color-text-primary)]"
        >
          Proof
        </a>
      </div>
    </div>

    <div class="hero-stage">
      <div class="hero-stage-shell">
        <div class="hero-stage-caption hero-stage-caption-top">
          <span>Live object</span>
          <span>WebGPU live object</span>
        </div>

        <div class="hero-stage-canvas">
          <WebGPUHeroCanvas client:load />
        </div>

        <div class="hero-stage-caption hero-stage-caption-bottom">
          <div class="grid gap-[0.28rem]">
            <p class="hero-stage-label">Why it matters</p>
            <p class="hero-stage-copy">
              A live pressure surface. The rest of the site follows from this.
            </p>
          </div>
          <a
            href={getLocalizedPath('/science/gpu', locale)}
            class="hero-stage-link"
          >
            Enter GPU route →
          </a>
        </div>

        <div class="hero-proofrail" aria-label="Current proof signals">
          <div class="hero-proofitem">
            <span class="hero-prooflabel">Compiler</span>
            <span class="hero-proofvalue">Fixed-point</span>
          </div>
          <div class="hero-proofitem">
            <span class="hero-prooflabel">GPU</span>
            <span class="hero-proofvalue">PTX in-tree</span>
          </div>
          <div class="hero-proofitem">
            <span class="hero-prooflabel">Pressure</span>
            <span class="hero-proofvalue">PBPK, climate, neuro</span>
          </div>
          <div class="hero-proofitem">
            <span class="hero-prooflabel">Boundary</span>
            <span class="hero-proofvalue">Inspectable claims</span>
          </div>
        </div>

        <div class="hero-route-rail" aria-label="Primary routes">
          <a href={getLocalizedPath('/science', locale)} class="hero-route-link">
            <span class="hero-route-label">Clinical / research</span>
            <span class="hero-route-copy">PBPK, neuro, refusal.</span>
          </a>
          <a href={getLocalizedPath('/learn/getting-started', locale)} class="hero-route-link">
            <span class="hero-route-label">Data / ML / AI</span>
            <span class="hero-route-copy">Pipelines, models, boundaries.</span>
          </a>
          <a href={getLocalizedPath('/proof', locale)} class="hero-route-link">
            <span class="hero-route-label">Review / proof</span>
            <span class="hero-route-copy">Artifacts, commands, limits.</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-reset {
    background:
      radial-gradient(980px 520px at 18% 14%, rgba(214, 179, 90, 0.14), transparent 56%),
      radial-gradient(980px 560px at 82% 16%, rgba(43, 166, 179, 0.12), transparent 58%),
      linear-gradient(180deg, rgba(6, 17, 35, 0.98), rgba(9, 21, 40, 0.99));
  }

  .hero-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
    mix-blend-mode: screen;
  }

  .hero-image-a {
    opacity: 0.18;
    object-position: left top;
    animation: heroCrossfadeA 18s linear infinite;
  }

  .hero-image-b {
    opacity: 0;
    object-position: right top;
    animation: heroCrossfadeB 18s linear infinite;
  }

  .hero-film {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 50% 26%, rgba(255,255,255,0.1), transparent 18%),
      linear-gradient(90deg, rgba(6, 15, 29, 0.96), rgba(6, 15, 29, 0.48) 24%, rgba(6, 15, 29, 0.3) 52%, rgba(6, 15, 29, 0.9) 100%);
  }

  .hero-vignette {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at center, transparent 0%, rgba(4, 10, 20, 0.46) 62%, rgba(4, 10, 20, 0.92) 100%);
  }

  .hero-copy {
    display: grid;
    gap: 1.35rem;
  }

  .hero-topline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
  }

  .hero-badge {
    border-color: rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.06);
    color: var(--color-accent-gold-soft);
  }

  .hero-title {
    justify-self: center;
    max-width: 12.8ch;
    font-family: var(--font-display);
    font-size: clamp(3.1rem, 8vw, 6.5rem);
    line-height: 0.92;
    letter-spacing: -0.05em;
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  .hero-subtitle {
    justify-self: center;
    max-width: 54ch;
    font-size: clamp(1.04rem, 2vw, 1.26rem);
    line-height: 1.72;
    color: rgba(255,255,255,0.74);
    text-wrap: pretty;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
  }

  .hero-inline-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.86rem;
    font-weight: 650;
    color: rgba(255,255,255,0.78);
    transition: color var(--transition-fast), transform var(--transition-fast);
  }

  .hero-inline-link::after {
    content: '→';
    color: var(--color-accent-gold);
  }

  .hero-inline-link:hover {
    color: var(--color-text-primary);
    transform: translateX(1px);
  }

  .hero-stage {
    justify-self: center;
    width: min(100%, 82rem);
  }

  .hero-stage-shell {
    display: grid;
    gap: 0.9rem;
    padding: clamp(0.9rem, 2vw, 1.2rem);
    border-radius: 2rem;
    border: 1px solid rgba(255,255,255,0.12);
    background:
      linear-gradient(180deg, rgba(255,255,255,0.08), rgba(255,255,255,0.025)),
      rgba(4, 12, 25, 0.54);
    box-shadow:
      0 28px 64px rgba(0,0,0,0.38),
      inset 0 1px 0 rgba(255,255,255,0.08);
    backdrop-filter: blur(24px);
  }

  .hero-stage-canvas {
    overflow: hidden;
    min-height: clamp(22rem, 46vw, 36rem);
    border-radius: 1.8rem;
    border: 1px solid rgba(255,255,255,0.08);
    background:
      radial-gradient(circle at top, rgba(214,179,90,0.12), transparent 26%),
      rgba(3, 10, 22, 0.9);
    box-shadow:
      inset 0 0 0 1px rgba(255,255,255,0.04),
      0 18px 44px rgba(0,0,0,0.3);
  }

  .hero-stage-caption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .hero-stage-caption-top {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.62);
  }

  .hero-stage-caption-bottom {
    align-items: end;
  }

  .hero-stage-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.44);
  }

  .hero-stage-copy {
    max-width: 30ch;
    font-size: 0.92rem;
    line-height: 1.55;
    color: rgba(255,255,255,0.8);
  }

  .hero-stage-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.84rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent-gold-soft);
  }

  .hero-stage-link:hover {
    color: var(--color-accent-gold);
  }

  .hero-proofrail {
    display: grid;
    gap: 0.7rem;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    padding-top: 0.2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .hero-proofitem {
    display: grid;
    gap: 0.18rem;
    padding: 0.7rem 0.1rem 0;
  }

  .hero-prooflabel {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.4);
  }

  .hero-proofvalue {
    font-size: 0.9rem;
    line-height: 1.35;
    color: rgba(255, 255, 255, 0.78);
    text-wrap: balance;
  }

  .hero-route-rail {
    display: grid;
    gap: 0;
    border-top: 1px solid rgba(255,255,255,0.08);
  }

  .hero-route-link {
    display: grid;
    gap: 0.2rem;
    padding: 0.88rem 0;
    border-top: 1px solid rgba(255,255,255,0.06);
    transition: transform var(--transition-fast), border-color var(--transition-fast), color var(--transition-fast);
  }

  .hero-route-link:first-child {
    border-top: none;
  }

  .hero-route-link:hover {
    transform: translateX(2px);
    border-color: rgba(214,179,90,0.22);
  }

  .hero-route-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent-gold-soft);
  }

  .hero-route-copy {
    max-width: 62ch;
    font-size: 0.88rem;
    line-height: 1.55;
    color: rgba(255,255,255,0.72);
    text-wrap: pretty;
  }

  @keyframes heroCrossfadeA {
    0%, 42%, 100% { opacity: 0.18; }
    50%, 92% { opacity: 0; }
  }

  @keyframes heroCrossfadeB {
    0%, 42% { opacity: 0; }
    50%, 92% { opacity: 0.16; }
    100% { opacity: 0; }
  }

  @media (max-width: 767px) {
    .hero-reset {
      padding-top: 5.5rem;
      padding-bottom: 2.4rem;
    }

    .hero-title {
      max-width: 100%;
      font-size: clamp(2.8rem, 11vw, 4.4rem);
    }

    .hero-subtitle {
      font-size: 0.98rem;
      line-height: 1.66;
    }

    .hero-stage-shell {
      border-radius: 1.5rem;
    }

    .hero-stage-canvas {
      min-height: 18rem;
      border-radius: 1.25rem;
    }

    .hero-stage-caption {
      flex-direction: column;
      align-items: start;
    }

    .hero-stage-copy {
      max-width: 100%;
    }

    .hero-proofrail {
      grid-template-columns: 1fr 1fr;
    }

    .hero-route-copy {
      max-width: 100%;
    }
  }
</style>
