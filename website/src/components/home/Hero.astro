---
import { Picture } from 'astro:assets';
import { getLocalizedPath, type Locale } from '../../lib/i18n';

// Original artworks (brand contract: check-brand-assets.mjs). They appear as
// the two portraits in the provenance line under the call to action.
import pappouHero from '../../../public/assets/original-artworks/pappou_hero.png';
import yiayiaHero from '../../../public/assets/original-artworks/yiayia_hero.png';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const content = {
  en: {
    eyebrow: 'Epistemic computing · self-hosted · Linux x86-64',
    motto: 'Measure is best.',
    scientist: {
      badge: 'For clinicians and researchers',
      title: 'Your calculations hide uncertainty.',
      description: 'When you compute a drug dose, a patient metric or a clinical prediction, ordinary code returns a single number with no context. Sounio carries measurement error, ISO GUM uncertainty and data provenance through every step of execution.',
      cta1: 'Explore the dosing example',
      cta1Href: '/learn/vancomycin-uncertainty',
      cta2: 'Clinical science hub',
      cta2Href: '/science',
      emblem: 'Built for clinical safety and high-consequence scientific software.',
    },
    technical: {
      badge: 'Beta toolchain · self-hosted language',
      title: 'Compute at the boundary between certainty and consequence.',
      description: 'Sounio is a systems language for scientific teams that must reason not only about values, but about trust, provenance and uncertainty at every stage of execution.',
      cta1: 'Start with the docs',
      cta1Href: '/learn/getting-started',
      cta2: 'See the proof',
      cta2Href: '/proof',
      emblem: 'Built for teams shipping high-consequence scientific software.',
    },
    lattice: 'The effect lattice',
    plateCaption: 'Effect lattice vortex · ten effects, one eye',
    tabRun: 'propagates', tabCheck: 'refuses', codeNote: 'Real output of Madaros v0.80.0, the self-hosted compiler.',
  },
  pt: {
    eyebrow: 'Computação epistêmica · self-hosted · Linux x86-64',
    motto: 'A medida é o melhor.',
    scientist: {
      badge: 'Para clínicos e pesquisadores',
      title: 'Seus cálculos escondem incerteza.',
      description: 'Ao calcular uma dose, uma métrica do paciente ou uma previsão clínica, o código comum devolve um único número sem contexto. O Sounio carrega o erro de medição, a incerteza ISO GUM e a proveniência dos dados por cada etapa da execução.',
      cta1: 'Ver o exemplo de dosagem',
      cta1Href: '/learn/vancomycin-uncertainty',
      cta2: 'Hub de ciência clínica',
      cta2Href: '/science',
      emblem: 'Feito para segurança clínica e software científico de alta consequência.',
    },
    technical: {
      badge: 'Toolchain beta · linguagem self-hosted',
      title: 'Compute na fronteira entre a certeza e a consequência.',
      description: 'O Sounio é uma linguagem de sistemas para equipes científicas que precisam raciocinar não apenas sobre valores, mas sobre confiança, proveniência e incerteza em cada etapa da execução.',
      cta1: 'Começar pela documentação',
      cta1Href: '/learn/getting-started',
      cta2: 'Ver as provas',
      cta2Href: '/proof',
      emblem: 'Feito para equipes que entregam software científico de alta consequência.',
    },
    lattice: 'O reticulado de efeitos',
    plateCaption: 'Vórtice do reticulado de efeitos · dez efeitos, um olho',
    tabRun: 'propaga', tabCheck: 'recusa', codeNote: 'Saída real do Madaros v0.80.0, o compilador self-hosted.',
  },
};

const localeKey = (locale === 'pt' ? 'pt' : 'en') as 'pt' | 'en';
const d = content[localeKey];

const effects = [
  { name: 'IO', hue: 'var(--spectrum-01-io)' },
  { name: 'Mut', hue: 'var(--spectrum-02-mut)' },
  { name: 'Div', hue: 'var(--spectrum-03-div)' },
  { name: 'Panic', hue: 'var(--spectrum-04-panic)' },
  { name: 'Alloc', hue: 'var(--spectrum-05-alloc)' },
  { name: 'Async', hue: 'var(--spectrum-06-async)' },
  { name: 'GPU', hue: 'var(--spectrum-07-gpu)' },
  { name: 'Prob', hue: 'var(--spectrum-08-prob)' },
  { name: 'Observe', hue: 'var(--spectrum-09-observe)' },
  { name: 'linear', hue: 'var(--spectrum-10-linear)' },
];


const K = (t: string) => `<span class="sx-k">${t}</span>`;
const F = (t: string) => `<span class="sx-f">${t}</span>`;
const N = (t: string) => `<span class="sx-n">${t}</span>`;
const T = (t: string) => `<span class="sx-t">${t}</span>`;
const C = (t: string) => `<span class="sx-c">${t}</span>`;
const S = (t: string) => `<span class="sx-s">${t}</span>`;
const effects4 = `${K('with')} <span class="sx-e-io">IO</span>, <span class="sx-e-mut">Mut</span>, <span class="sx-e-panic">Panic</span>, <span class="sx-e-div">Div</span>`;
const doseCode = [
  `${K('use')} epistemic::knowledge::{`,
  `    ep_measured, ep_div, ep_val, ep_std, ep_is_credible`,
  `}`,
  ``,
  `${K('fn')} ${F('main')}() -> ${T('i32')} ${effects4} {`,
  `    ${K('let')} dose = ${F('ep_measured')}(${N('500.0')}, ${N('25.0')})   ${C('// mg, σ = 25')}`,
  `    ${K('let')} volume = ${F('ep_measured')}(${N('10.0')}, ${N('0.01')})  ${C('// L')}`,
  `    ${K('let')} conc = ${F('ep_div')}(&amp;dose, &amp;volume)     ${C('// σ travels (GUM)')}`,
  `    ${F('println')}(${F('ep_val')}(&amp;conc))`,
  `    ${F('println')}(${F('ep_std')}(&amp;conc))`,
  `    ${K('if')} ${F('ep_is_credible')}(&amp;conc, ${N('800')}) {`,
  `        ${F('println')}(${S('"credible: act on it"')})`,
  `    }`,
  `    ${K('return')} ${N('0')}`,
  `}`,
].join('\n');
const doseOut = ['50.000000', '2.500500', 'credible: act on it'].join('\n');
const unitsCode = [
  `${K('fn')} ${F('main')}() -> ${T('i32')} ${effects4} {`,
  `    ${K('let')} dose: ${T('mg')} = ${N('500.0')}`,
  `    ${K('let')} height: ${T('m')} = ${N('1.75')}`,
  `    ${K('let')} wrong = dose + height`,
  `    ${K('return')} ${N('0')}`,
  `}`,
].join('\n');
const unitsOut = [
  '<span class="hero-err">error[E041]</span>: unit mismatch in arithmetic operation',
  '  left unit: mass^1',
  '  right unit: length^1',
  '<span class="hero-err">error[E000]</span>: type checking failed',
].join('\n');

const panes = [
  { key: 'scientist', data: d.scientist },
  { key: 'technical', data: d.technical },
] as const;
---

<section class="hero spectrum-surface" aria-labelledby="hero-wordmark">
  <div class="hero-art" aria-hidden="true">
    <img class="hero-poster" src="/media/sounio-vortex.webp" alt="" width="720" height="900" fetchpriority="high" decoding="async" />
    <video class="hero-video" muted loop playsinline preload="none" poster="/media/sounio-vortex.webp" data-src="/media/sounio-vortex.mp4"></video>
    <canvas class="hero-canvas" data-hero-canvas></canvas>
    <div class="hero-veil"></div>
  </div>

  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="sx-eyebrow hero-eyebrow">{d.eyebrow}</p>

      <h1 class="hero-title-block">
        <span id="hero-wordmark" class="sx-wordmark hero-wordmark">Sounio</span>
      </h1>
      <p class="hero-motto">
        <span lang="grc" class="sx-motto">Μέτρον ἄριστον</span>
        <span class="hero-motto-gloss">{d.motto}</span>
      </p>

      {panes.map(({ key, data }) => (
        <div class="hero-pane" data-for-audience={key}>
          <span class="sx-badge sx-badge--gold">{data.badge}</span>
          <p class="hero-headline">{data.title}</p>
          <p class="hero-description">{data.description}</p>
          <div class="hero-actions">
            <a href={getLocalizedPath(data.cta1Href, locale)} class="sx-btn sx-btn--primary">
              {data.cta1}
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
            </a>
            <a href={getLocalizedPath(data.cta2Href, locale)} class="sx-btn sx-btn--secondary">{data.cta2}</a>
          </div>
          <div class="hero-provenance">
            <a href="#witnesses" class="hero-portraits" aria-label="Pappou and Yiayia, the two witnesses">
              <Picture src={pappouHero} alt="" widths={[96]} sizes="48px" formats={['avif', 'webp']} class="hero-portrait" loading="eager" />
              <Picture src={yiayiaHero} alt="" widths={[96]} sizes="48px" formats={['avif', 'webp']} class="hero-portrait" loading="eager" />
              <img src="/assets/stamps/emblem_badge_monochrome_on_navy.png" alt="" class="hero-portrait hero-emblem" width="48" height="48" />
            </a>
            <span>{data.emblem}</span>
          </div>
        </div>
      ))}
    </div>

    <figure class="hero-code" data-hero-code>
      <div class="hero-code-bar" role="tablist" aria-label="Sounio">
        <button type="button" role="tab" class="hero-code-tab" aria-selected="true" data-tab="run">dose.sio <span class="hero-code-verb">· {d.tabRun}</span></button>
        <button type="button" role="tab" class="hero-code-tab" aria-selected="false" data-tab="check">units.sio <span class="hero-code-verb">· {d.tabCheck}</span></button>
      </div>
      <div class="hero-code-panel" data-panel="run" role="tabpanel">
        <pre class="hero-code-src"><code set:html={doseCode} /></pre>
        <pre class="hero-code-out"><code set:html={`<span class="hero-prompt">$ souc run dose.sio</span>\n${doseOut}`} /></pre>
      </div>
      <div class="hero-code-panel" data-panel="check" role="tabpanel" hidden>
        <pre class="hero-code-src"><code set:html={unitsCode} /></pre>
        <pre class="hero-code-out hero-code-out--err"><code set:html={`<span class="hero-prompt">$ souc check units.sio</span>\n${unitsOut}`} /></pre>
      </div>
      <figcaption class="hero-code-note">{d.codeNote}</figcaption>
    </figure>
  </div>

  <div class="hero-lattice">
    <div class="container">
      <p class="hero-lattice-label">{d.lattice}</p>
      <ul class="hero-lattice-list">
        {effects.map((e) => (
          <li style={`--hue:${e.hue}`}>
            <span class="hero-lattice-bar" aria-hidden="true"></span>
            <span class="hero-lattice-name">{e.name}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: max(44rem, 100svh);
    display: grid;
    grid-template-rows: 1fr auto;
    overflow: hidden;
    padding-top: 4rem;
  }

  .hero-art { position: absolute; inset: 0; z-index: -1; }

  .hero-poster,
  .hero-video,
  .hero-canvas {
    position: absolute;
    top: 0;
    bottom: 0;
    right: 0;
    height: 100%;
    width: min(100%, 62rem);
    object-fit: cover;
    object-position: center;
  }

  .hero-canvas {
    width: 100%;
    opacity: 0;
    transition: opacity 1.2s var(--ease-out);
  }

  .hero.is-live .hero-canvas { opacity: 1; }
  .hero.is-live .hero-poster,
  .hero.is-live .hero-video { opacity: 0; transition: opacity 1.2s var(--ease-out); }

  .hero-video { opacity: 0; }
  .hero.is-video .hero-video { opacity: 1; }

  /* Navy veil from the copy side: keeps text >= 4.5:1 over the art. */
  .hero-veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, #05080E 0%, rgba(5, 8, 14, 0.94) 28%, rgba(5, 8, 14, 0.55) 52%, rgba(5, 8, 14, 0) 72%),
      linear-gradient(0deg, #05080E 0%, rgba(5, 8, 14, 0) 26%);
  }

  .hero-grid {
    display: grid;
    align-items: center;
    padding-block: clamp(2rem, 6vh, 4.5rem) 1.5rem;
  }

  .hero-copy {
    display: grid;
    gap: clamp(0.75rem, 1.6vh, 1.25rem);
    max-width: 40rem;
  }


  /* Code card: the language itself, with real compiler output. */
  .hero-code {
    margin: 0;
    width: 100%;
    max-width: 34rem;
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: rgba(5, 8, 14, 0.82);
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: 0 30px 70px -30px rgba(0, 0, 0, 0.9), 0 0 0 1px rgba(214, 179, 90, 0.08);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
  }
  .hero-code-bar { display: flex; border-bottom: 1px solid rgba(255, 255, 255, 0.10); }
  .hero-code-tab {
    flex: 1;
    min-height: 44px;
    padding: 0 1rem;
    border: 0;
    background: transparent;
    font: 500 0.8rem/1 var(--font-mono);
    color: rgba(255, 255, 255, 0.66);
    text-align: left;
    cursor: pointer;
    border-bottom: 2px solid transparent;
    font-variant-ligatures: none;
  }
  .hero-code-tab[aria-selected="true"] { color: #FFFFFF; border-bottom-color: #D6B35A; background: rgba(255, 255, 255, 0.04); }
  .hero-code-tab:focus-visible { outline: 2px solid #D6B35A; outline-offset: -2px; }
  .hero-code-verb { color: #EBD6A2; }
  .hero-code pre {
    margin: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    padding: 0.9rem 1.1rem;
    font: 400 0.78rem/1.6 var(--font-mono);
    color: #FFFFFF;
    overflow-x: auto;
    font-variant-ligatures: none;
    font-feature-settings: "calt" 0, "liga" 0;
  }
  .hero-code-out {
    border-top: 1px solid rgba(255, 255, 255, 0.10) !important;
    background: rgba(0, 229, 192, 0.06) !important;
    color: #4EECD6 !important;
  }
  .hero-code-out--err { background: rgba(255, 59, 86, 0.08) !important; color: #FF8596 !important; }
  .hero-code-out :global(.hero-err) { font-weight: 700; }
  .hero-prompt { color: rgba(255, 255, 255, 0.62); }
  .hero-code-note {
    padding: 0.6rem 1.1rem 0.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.62);
  }
  /* dark syntax tokens (the card is always on navy) */
  .hero-code :global(.sx-k) { color: #2BA6B3; }
  .hero-code :global(.sx-f) { color: #E0C470; }
  .hero-code :global(.sx-n) { color: #D6B35A; }
  .hero-code :global(.sx-s) { color: #3AB8C6; }
  .hero-code :global(.sx-t) { color: #E0C470; }
  .hero-code :global(.sx-c) { color: rgba(255, 255, 255, 0.55); font-style: italic; }
  .hero-code :global(.sx-e-io) { color: #38BDF8; }
  .hero-code :global(.sx-e-mut) { color: #FB923C; }
  .hero-code :global(.sx-e-panic) { color: #FF8596; }
  .hero-code :global(.sx-e-div) { color: #C084FC; }

  @media (min-width: 1100px) {
    .hero-grid {
      grid-template-columns: minmax(0, 40rem) minmax(0, 32rem);
      justify-content: space-between;
      align-items: end;
      column-gap: 3rem;
    }
    .hero-copy { align-self: center; }
    .hero-code { justify-self: end; }
  }
  @media (max-width: 1099px) {
    .hero-grid { row-gap: 2.5rem; }
  }

  .hero-eyebrow { color: #EBD6A2; }

  .hero-title-block { margin: 0; line-height: 1; }

  .hero-wordmark {
    display: block;
    font-size: clamp(4.5rem, min(12vw, 17vh), 9rem);
    color: #FFFFFF;
    margin-left: -0.04em;
    text-shadow: 0 0 60px rgba(214, 179, 90, 0.18);
  }

  .hero-motto {
    margin: -0.5rem 0 0.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 1rem;
  }

  .hero-motto .sx-motto {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    color: #EBD6A2;
  }

  .hero-motto-gloss {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.72);
    letter-spacing: 0.01em;
  }

  .hero-pane {
    display: grid;
    gap: clamp(0.8rem, 1.8vh, 1.1rem);
    justify-items: start;
    padding-top: clamp(1rem, 2.4vh, 1.5rem);
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }

  .hero-headline {
    margin: 0;
    font-size: clamp(1.75rem, min(3.4vw, 5vh), 2.75rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.1;
    color: #FFFFFF;
    text-wrap: balance;
  }

  .hero-description {
    margin: 0;
    max-width: 56ch;
    font-size: clamp(1rem, 1.4vw, 1.125rem);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.76);
  }

  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 0.25rem; }

  .hero-provenance {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.70);
  }

  .hero-portraits { display: inline-flex; flex: none; border-radius: 999px; transition: transform 0.3s var(--ease-out); }
  .hero-portraits:hover { transform: scale(1.08); }

  .hero-portraits :global(img),
  .hero-portrait {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid #05080E;
    box-shadow: 0 0 0 1px rgba(214, 179, 90, 0.55);
  }

  .hero-portraits :global(picture + picture img),
  .hero-portraits > :global(img.hero-emblem) { margin-left: -10px; }

  .hero-emblem { background: #0B1E3A; object-fit: contain; padding: 2px; }

  /* The effect lattice strip — spectrum mode rule: every hue sits with its name. */
  .hero-lattice {
    position: relative;
    border-top: 1px solid rgba(255, 255, 255, 0.10);
    background: rgba(5, 8, 14, 0.72);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    padding: 1rem 0 1.1rem;
  }

  .hero-lattice .container {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .hero-lattice-label {
    margin: 0;
    flex: none;
    font: 700 0.75rem/1 var(--font-sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #EBD6A2;
  }

  .hero-lattice-list {
    list-style: none;
    margin: 0;
    padding: 0;
    flex: 1;
    display: grid;
    grid-template-columns: repeat(10, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .hero-lattice-list li { display: grid; gap: 0.45rem; min-width: 0; }

  .hero-lattice-bar {
    height: 3px;
    border-radius: 2px;
    background: var(--hue);
    box-shadow: 0 0 12px var(--hue);
    transform-origin: left;
    animation: lattice-in 0.9s var(--ease-out) both;
  }

  .hero-lattice-list li:nth-child(n) .hero-lattice-bar { animation-delay: calc(var(--i, 0) * 60ms); }

  .hero-lattice-name {
    font: 500 0.75rem/1 var(--font-mono);
    color: rgba(255, 255, 255, 0.78);
    font-variant-ligatures: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @keyframes lattice-in { from { transform: scaleX(0); opacity: 0; } to { transform: scaleX(1); opacity: 1; } }

  @media (max-width: 900px) {
    .hero-poster, .hero-video, .hero-canvas { width: 100%; opacity: 0.55; }
    .hero.is-live .hero-canvas { opacity: 0.6; }
    .hero-veil {
      background:
        linear-gradient(180deg, rgba(5, 8, 14, 0.35) 0%, rgba(5, 8, 14, 0.85) 45%, #05080E 100%);
    }
    .hero-lattice .container { flex-direction: column; align-items: stretch; gap: 0.75rem; }
    .hero-lattice-list { grid-template-columns: repeat(5, minmax(0, 1fr)); row-gap: 0.85rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-canvas, .hero-video { display: none; }
    .hero-lattice-bar { animation: none; }
  }
</style>

<script>
  import gsap from 'gsap';

  const VERT = `#version 300 es
in vec2 p; void main(){ gl_Position = vec4(p, 0.0, 1.0); }`;

  // Effect-lattice vortex. Same field as the offline render (vortex.cpp):
  // a log-spiral phase whose integer level sets are the ten effect hues.
  // Time enters only through s in [0,1) so the motion is a seamless loop.
  const FRAG = `#version 300 es
precision highp float;
uniform vec2 uRes; uniform float uTime; uniform vec2 uCenter; uniform float uScale; uniform vec2 uLook;
out vec4 o;
const float TAU = 6.28318530718;
vec3 pal(int i){
  if(i==0) return vec3(56,189,248); if(i==1) return vec3(251,146,60); if(i==2) return vec3(192,132,252);
  if(i==3) return vec3(255,133,150); if(i==4) return vec3(45,212,191); if(i==5) return vec3(96,165,250);
  if(i==6) return vec3(163,230,53); if(i==7) return vec3(251,191,36); if(i==8) return vec3(244,114,182);
  return vec3(249,115,22);
}
float phase(vec2 q, float s){
  float r = length(q), a = atan(q.y, q.x);
  float tw = 9.0 + 0.6*sin(TAU*s);
  return a/TAU*10.0 + tw*log(r + 1e-4) - 10.0*s + 0.22*sin(r*16.0 - TAU*2.0*s);
}
void main(){
  float s = fract(uTime / 9.0);
  vec2 q = (gl_FragCoord.xy - uCenter) / uScale;
  q += uLook * 0.035 * length(q);              // gaze: the field leans toward the pointer
  float r = length(q);
  float e = 1.0 / uScale;
  vec3 navy = vec3(11,30,58), abyss = vec3(5,8,14), gold = vec3(214,179,90);
  vec3 c = mix(navy, abyss, smoothstep(0.0, 1.0, clamp(r/0.75, 0.0, 1.0)));
  float ph = phase(q, s);
  float gx = phase(q + vec2(e, 0.0), s) - ph, gy = phase(q + vec2(0.0, e), s) - ph;
  if(gx > 5.0) gx -= 10.0; if(gx < -5.0) gx += 10.0; if(gy > 5.0) gy -= 10.0; if(gy < -5.0) gy += 10.0;
  float fw = abs(gx) + abs(gy) + 1e-6;
  float k = floor(ph + 0.5), dist = abs(ph - k);
  int idx = int(mod(mod(k, 10.0) + 10.0, 10.0));
  float core = 1.0 - smoothstep(0.0, fw*1.3, dist);
  float glow = exp(-dist / (fw*8.0)) * 0.6;
  float mask = smoothstep(0.02, 0.10, r) * (1.0 - smoothstep(0.40, 0.62, r) * 0.9);
  c += pal(idx) * (core + glow) * mask;
  float eye = exp(-r*r/0.0016) * (0.75 + 0.2*sin(TAU*s));
  c += gold * eye;
  float fr = 1.0 / uScale;
  float t1 = (1.0 - min(abs(r - 0.028)/(fr*1.4), 1.0));
  float t2 = (1.0 - min(abs(r - 0.50)/(fr*1.5), 1.0)) * 0.9;
  float t3 = (1.0 - min(abs(r - 0.535)/(fr*1.2), 1.0)) * 0.55;
  c = mix(c, gold, t1); c = mix(c, gold, t2); c = mix(c, gold, t3);
  o = vec4(clamp(c/255.0, 0.0, 1.0), 1.0);
}`;

  function startHero() {
    const hero = document.querySelector<HTMLElement>('.hero');
    const canvas = hero?.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
    if (!hero || !canvas || hero.dataset.ready) return;
    hero.dataset.ready = '1';

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) return;

    const gl = canvas.getContext('webgl2', { antialias: false, alpha: false, powerPreference: 'low-power' });
    if (!gl) {
      const video = hero.querySelector<HTMLVideoElement>('.hero-video');
      if (video?.dataset.src) {
        video.src = video.dataset.src;
        video.play().then(() => hero.classList.add('is-video')).catch(() => {});
      }
      return;
    }

    const sh = (type: number, src: string) => {
      const x = gl.createShader(type)!; gl.shaderSource(x, src); gl.compileShader(x); return x;
    };
    const prog = gl.createProgram()!;
    gl.attachShader(prog, sh(gl.VERTEX_SHADER, VERT));
    gl.attachShader(prog, sh(gl.FRAGMENT_SHADER, FRAG));
    gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) return;
    gl.useProgram(prog);
    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(prog, 'p');
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
    const u = (n: string) => gl.getUniformLocation(prog, n);
    const uRes = u('uRes'), uTime = u('uTime'), uCenter = u('uCenter'), uScale = u('uScale'), uLook = u('uLook');

    const look = { x: 0, y: 0 }, target = { x: 0, y: 0 };
    let w = 0, h = 0, dpr = 1;
    const resize = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 1.5);
      const rect = canvas.getBoundingClientRect();
      w = Math.max(1, Math.round(rect.width * dpr));
      h = Math.max(1, Math.round(rect.height * dpr));
      canvas.width = w; canvas.height = h;
      gl.viewport(0, 0, w, h);
    };
    resize();
    window.addEventListener('resize', resize, { passive: true });
    hero.addEventListener('pointermove', (ev) => {
      const r = hero.getBoundingClientRect();
      target.x = ((ev.clientX - r.left) / r.width - 0.5) * 2;
      target.y = -((ev.clientY - r.top) / r.height - 0.5) * 2;
    }, { passive: true });

    let visible = true, raf = 0, started = false;
    const t0 = performance.now();
    const frame = (now: number) => {
      raf = requestAnimationFrame(frame);
      if (!visible || document.hidden) return;
      look.x += (target.x - look.x) * 0.04; look.y += (target.y - look.y) * 0.04;
      const wide = w / dpr > 900;
      const cx = wide ? w * 0.70 : w * 0.5;
      const cy = wide ? h * 0.75 : h * 0.62;
      const scale = wide ? h * 0.95 : Math.min(w, h) * 1.15;
      gl.uniform2f(uRes, w, h);
      gl.uniform1f(uTime, (now - t0) / 1000);
      gl.uniform2f(uCenter, cx, cy);
      gl.uniform1f(uScale, scale);
      gl.uniform2f(uLook, look.x, look.y);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
      if (!started) { started = true; hero.classList.add('is-live'); }
    };
    new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; }).observe(hero);
    raf = requestAnimationFrame(frame);
    document.addEventListener('astro:before-swap', () => cancelAnimationFrame(raf), { once: true });
  }

  function introHero() {
    const mm = gsap.matchMedia();
    mm.add('(prefers-reduced-motion: no-preference)', () => {
      gsap.from('.hero-eyebrow, .hero-wordmark, .hero-motto', { y: 24, opacity: 0, duration: 0.9, stagger: 0.1, ease: 'power3.out' });
      const pane = Array.from(document.querySelectorAll<HTMLElement>('.hero-pane')).find((el) => el.offsetParent !== null);
      if (pane) gsap.from(pane.children, { y: 18, opacity: 0, duration: 0.7, stagger: 0.08, delay: 0.35, ease: 'power2.out' });
      document.querySelectorAll<HTMLElement>('.hero-lattice-list li').forEach((li, i) => li.style.setProperty('--i', String(i)));
    });
  }

  function wireCode() {
    const card = document.querySelector<HTMLElement>('[data-hero-code]');
    if (!card || card.dataset.wired) return;
    card.dataset.wired = '1';
    const tabs = Array.from(card.querySelectorAll<HTMLButtonElement>('.hero-code-tab'));
    tabs.forEach((tab) => tab.addEventListener('click', () => {
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
      card.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => { p.hidden = p.dataset.panel !== tab.dataset.tab; });
    }));
  }

  document.addEventListener('astro:page-load', () => { startHero(); introHero(); wireCode(); });
</script>
