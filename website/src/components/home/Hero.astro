---
import ZeroEventObservatory from './ZeroEventObservatory';
import { getLocalizedPath, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const content = {
  en: {
    eyebrow: 'Self-hosted epistemic language',
    title: 'Sounio',
    kicker: "A programming language that carries what it doesn't know.",
    body: 'Sounio binds semantics, uncertainty, proof, clinical science, and Madaros-gated execution into one inspectable system.',
    primary: 'Read the living system',
    secondary: 'Inspect the evidence',
    signal: 'Zero Events are one example: seven ways to arrive at zero without erasing origin.',
    traceLabel: 'Zero Event histories',
    traceTitle: 'Epistemic value trace',
    converged: 'Converged value',
  },
  pt: {
    eyebrow: 'Linguagem epistêmica self-hosted',
    title: 'Sounio',
    kicker: 'Uma linguagem de programação que carrega o que não sabe.',
    body: 'Sounio conecta semântica, incerteza, prova, ciência clínica e recibos de execução validados pelo Madaros em um sistema inspecionável.',
    primary: 'Ler o sistema vivo',
    secondary: 'Inspecionar a evidência',
    signal: 'Zero Events são um exemplo: sete modos de chegar a zero sem apagar a origem.',
    traceLabel: 'Histórias de Zero Events',
    traceTitle: 'Traço de valor epistêmico',
    converged: 'Valor convergente',
  },
};

const d = content[locale === 'pt' ? 'pt' : 'en'];
---

<section class="observatory-hero" aria-labelledby="observatory-title">
  <div class="observatory-art" aria-hidden="true">
    <img src="/assets/original-artworks/pappou_hero_1536.webp" alt="" class="observatory-art-image art-a" loading="eager" decoding="async" />
    <img src="/assets/original-artworks/yiayia_hero_1536.webp" alt="" class="observatory-art-image art-b" loading="lazy" decoding="async" />
  </div>
  <div class="observatory-shell container">
    <div class="observatory-intro">
      <img src="/assets/sounio-logo.svg" alt="" class="observatory-emblem" aria-hidden="true" />
      <p class="observatory-eyebrow">{d.eyebrow}</p>
      <h1 id="observatory-title">{d.title}</h1>
      <p class="observatory-kicker">{d.kicker}</p>
      <p class="observatory-body">{d.body}</p>

      <div class="observatory-actions">
        <a class="observatory-action primary" href="#system-atlas">{d.primary}</a>
        <a class="observatory-action secondary" href={getLocalizedPath('/proof', locale)}>{d.secondary}</a>
      </div>

      <p class="observatory-signal">
        <span aria-hidden="true"></span>
        {d.signal}
      </p>
    </div>

    <div class="observatory-visual" aria-label={d.traceTitle}>
      <ZeroEventObservatory
        client:load
        locale={locale === 'pt' ? 'pt' : 'en'}
        traceLabel={d.traceLabel}
        traceTitle={d.traceTitle}
        convergedLabel={d.converged}
      />
    </div>

    <dl class="execution-receipt" aria-label="Current execution receipt">
      <div>
        <dt>Engine</dt>
        <dd>Madaros v0.80.0</dd>
      </div>
      <div>
        <dt>Compiler gate</dt>
        <dd><span class="receipt-pass">Pass</span></dd>
      </div>
      <div>
        <dt>Conformance</dt>
        <dd>16 / 16</dd>
      </div>
      <div>
        <dt>Commit</dt>
        <dd><code>635b4cc95</code></dd>
      </div>
      <div>
        <dt>Verified</dt>
        <dd>2026-07-13 UTC</dd>
      </div>
    </dl>
  </div>
</section>

<style>
  .observatory-hero {
    position: relative;
    overflow: hidden;
    min-height: 760px;
    padding: 5.2rem 0 2.2rem;
    background:
      radial-gradient(760px 420px at 78% 18%, rgba(214, 179, 90, 0.18), transparent 64%),
      linear-gradient(120deg, rgba(11, 30, 58, 0.96), rgba(11, 30, 58, 0.88) 46%, rgba(6, 16, 31, 0.98)),
      var(--color-bg);
    color: #fff;
    border-bottom: 1px solid color-mix(in srgb, var(--color-accent-gold) 20%, transparent);
  }

  .observatory-art {
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0.3;
    pointer-events: none;
  }

  .observatory-art::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(11, 30, 58, 0.9), rgba(11, 30, 58, 0.54) 44%, rgba(11, 30, 58, 0.92)),
      linear-gradient(180deg, rgba(11, 30, 58, 0.48), rgba(11, 30, 58, 0.94));
  }

  .observatory-art-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .art-b {
    opacity: 0;
    animation: heroBrandFade 18s linear infinite;
  }

  .art-a {
    animation: heroBrandFadeA 18s linear infinite;
  }

  @keyframes heroBrandFade {
    0%, 42% { opacity: 0; }
    50%, 88% { opacity: 1; }
    96%, 100% { opacity: 0; }
  }

  @keyframes heroBrandFadeA {
    0%, 42% { opacity: 1; }
    50%, 88% { opacity: 0; }
    96%, 100% { opacity: 1; }
  }

  .observatory-shell {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(320px, 0.88fr) minmax(480px, 1.12fr);
    grid-template-rows: 1fr auto;
    gap: 1.5rem 2.4rem;
    min-height: 620px;
  }

  .observatory-intro {
    align-self: center;
    padding-bottom: 1.5rem;
  }

  .observatory-emblem {
    width: 58px;
    height: 58px;
    margin-bottom: 1rem;
    opacity: 0.88;
  }

  .observatory-eyebrow {
    width: fit-content;
    margin: 0 0 1.2rem;
    border: 1px solid color-mix(in srgb, var(--color-accent-gold) 52%, transparent);
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--color-accent-gold) 10%, transparent);
    color: var(--color-accent-gold-soft);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0;
    padding: 0.38rem 0.58rem;
    text-transform: uppercase;
  }

  .observatory-intro h1 {
    margin: 0;
    color: #fff;
    font-family: var(--font-display);
    font-size: clamp(4.2rem, 9vw, 7.4rem);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 0.95;
  }

  .observatory-kicker {
    margin: 1.1rem 0 0;
    max-width: 36ch;
    color: #fff;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.4vw, 2.1rem);
    font-weight: 400;
    line-height: 1.18;
  }

  .observatory-body {
    margin: 1.2rem 0 0;
    max-width: 42ch;
    color: var(--color-text-secondary);
    font-size: 1.02rem;
    line-height: 1.7;
  }

  .observatory-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.55rem;
  }

  .observatory-action {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
    padding: 0.7rem 1rem;
    font-size: 0.86rem;
    font-weight: 700;
    transition: background 180ms ease, border-color 180ms ease, color 180ms ease, transform 180ms ease;
  }

  .observatory-action:hover {
    transform: translateY(-1px);
  }

  .observatory-action.primary {
    border: 1px solid var(--color-accent-gold);
    background: linear-gradient(135deg, var(--color-accent-gold), var(--color-accent-gold-soft));
    color: var(--color-bg);
  }

  .observatory-action.primary:hover {
    background: var(--color-accent-gold-soft);
    color: var(--color-bg);
  }

  .observatory-action.secondary {
    border: 1px solid var(--glass-border);
    background: color-mix(in srgb, var(--color-surface-frost) 72%, transparent);
    color: var(--color-text-primary);
  }

  .observatory-action.secondary:hover {
    border-color: color-mix(in srgb, var(--color-accent-gold) 44%, transparent);
    color: #fff;
  }

  .observatory-signal {
    display: flex;
    gap: 0.65rem;
    align-items: flex-start;
    margin: 1.35rem 0 0;
    color: var(--color-text-tertiary);
    font-size: 0.8rem;
    line-height: 1.55;
  }

  .observatory-signal span {
    flex: 0 0 auto;
    width: 8px;
    height: 8px;
    margin-top: 0.25rem;
    border-radius: 50%;
    background: var(--color-accent-gold);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-accent-gold) 16%, transparent);
  }

  .observatory-visual {
    min-width: 0;
    align-self: center;
    padding: 1rem;
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--color-bg-alt) 66%, transparent);
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.22);
  }

  .execution-receipt {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin: 0;
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--color-bg-alt) 78%, transparent);
  }

  .execution-receipt > div {
    min-width: 0;
    padding: 0.82rem 1rem;
    border-right: 1px solid var(--glass-border);
  }

  .execution-receipt > div:last-child {
    border-right: 0;
  }

  .execution-receipt dt {
    color: var(--color-text-tertiary);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    text-transform: uppercase;
  }

  .execution-receipt dd {
    overflow: hidden;
    margin: 0.3rem 0 0;
    color: var(--color-text-primary);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .execution-receipt code {
    padding: 0;
    background: transparent;
    color: inherit;
    font-size: inherit;
  }

  .receipt-pass {
    color: var(--color-accent-gold-soft);
    text-transform: uppercase;
  }

  @media (max-width: 1100px) {
    .observatory-shell {
      grid-template-columns: minmax(260px, 0.78fr) minmax(420px, 1.22fr);
      gap: 1.2rem;
    }

    .observatory-intro h1 {
      font-size: 4.25rem;
    }

    .execution-receipt {
      grid-template-columns: repeat(3, 1fr);
    }

    .execution-receipt > div:nth-child(3) {
      border-right: 0;
    }

    .execution-receipt > div:nth-child(n + 4) {
      border-top: 1px solid var(--glass-border);
    }
  }

  @media (max-width: 820px) {
    .observatory-hero {
      min-height: 0;
      padding: 5.4rem 0 1.4rem;
    }

    .observatory-shell {
      display: flex;
      min-height: 0;
      flex-direction: column;
      gap: 1.2rem;
    }

    .observatory-intro {
      padding-bottom: 0;
    }

    .observatory-visual {
      width: 100%;
      align-self: stretch;
      padding: 0.7rem;
    }

    .observatory-intro h1 {
      font-size: 3.5rem;
    }

    .observatory-kicker {
      max-width: 42ch;
    }

    .observatory-body {
      max-width: 60ch;
    }

    .execution-receipt {
      grid-template-columns: repeat(2, 1fr);
    }

    .execution-receipt > div,
    .execution-receipt > div:nth-child(3) {
      border-right: 1px solid var(--glass-border);
      border-top: 1px solid var(--glass-border);
    }

    .execution-receipt > div:nth-child(odd) {
      border-right: 0;
    }

    .execution-receipt > div:first-child,
    .execution-receipt > div:nth-child(2) {
      border-top: 0;
    }
  }

  @media (max-width: 520px) {
    .observatory-hero {
      padding-top: 5.1rem;
      padding-bottom: 0.9rem;
    }

    .observatory-shell {
      gap: 0.85rem;
    }

    .observatory-eyebrow {
      margin-bottom: 0.8rem;
    }

    .observatory-intro h1 {
      font-size: 2.8rem;
    }

    .observatory-kicker {
      margin-top: 0.7rem;
      font-size: 0.68rem;
      line-height: 1.55;
    }

    .observatory-body {
      margin-top: 0.75rem;
      font-size: 0.88rem;
      line-height: 1.55;
    }

    .observatory-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      margin-top: 1rem;
    }

    .observatory-action {
      width: 100%;
      min-height: 42px;
      padding: 0.58rem 0.5rem;
      font-size: 0.75rem;
    }

    .observatory-signal {
      margin-top: 0.9rem;
      font-size: 0.7rem;
    }

    .execution-receipt {
      display: flex;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .execution-receipt::-webkit-scrollbar {
      display: none;
    }

    .execution-receipt > div,
    .execution-receipt > div:nth-child(odd),
    .execution-receipt > div:nth-child(n + 4) {
      flex: 0 0 132px;
      padding: 0.6rem 0.7rem;
      border-top: 0;
      border-right: 1px solid var(--glass-border);
    }

    .execution-receipt > div:last-child {
      border-right: 0;
    }
  }
</style>
