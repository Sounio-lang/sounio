---
import { Picture } from 'astro:assets';
import { getLocalizedPath, type Locale } from '../../lib/i18n';
import surface from '../../data/publicSurface.json';
import pappouHero from '../../../public/assets/original-artworks/pappou_hero.png';
import yiayiaHero from '../../../public/assets/original-artworks/yiayia_hero.png';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const content = surface[locale];
---

<section class="public-hero relative overflow-hidden" aria-labelledby="public-title">
  <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
    <Picture src={pappouHero} alt="" class="hero-art hero-art-first" formats={['avif', 'webp']} loading="eager" decoding="async" />
    <Picture src={yiayiaHero} alt="" class="hero-art hero-art-second" formats={['avif', 'webp']} loading="lazy" decoding="async" />
    <div class="hero-shade absolute inset-0"></div>
  </div>
  <div class="container relative z-10">
    <div class="hero-copy">
      <div class="hero-signature">
        <img src="/assets/stamps/emblem_badge_monochrome_on_navy.png" alt="" aria-hidden="true" width="36" height="36" />
        <span>Sounio</span>
      </div>
      <h1 id="public-title">{content.title}</h1>
      <p class="hero-description">{content.description}</p>
      <div class="hero-actions">
        <a href={getLocalizedPath('/scientist', locale)} class="start-link">{content.start}</a>
        <a href="https://github.com/Sounio-lang/sounio" class="source-link">{content.source}</a>
      </div>
      <p class="hero-note">{content.note}</p>
    </div>
  </div>
</section>

<style>
  .public-hero { padding: 8rem 0 4.5rem; min-height: 70vh; display: grid; align-items: center; background: #07162c; color: #fff; }
  .hero-art { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .hero-art-first { animation: filmFade 18s linear infinite; }
  .hero-art-second { opacity: 0; animation: filmFade 18s linear infinite; animation-delay: -9s; }
  .hero-shade { background: linear-gradient(110deg, rgba(7,22,44,.94), rgba(7,22,44,.76) 55%, rgba(7,22,44,.48)); }
  .hero-copy { max-width: 760px; }
  .hero-signature { display: flex; align-items: center; gap: .7rem; color: #e4ca85; font-size: 1rem; margin-bottom: 1.6rem; }
  h1 { font-size: clamp(2.5rem, 5.6vw, 5rem); line-height: 1.08; letter-spacing: -.035em; font-weight: 750; max-width: 20ch; text-wrap: balance; }
  .hero-description { max-width: 65ch; margin-top: 1.6rem; color: #e0e6ef; font-size: clamp(1rem, 1.6vw, 1.2rem); line-height: 1.7; }
  .hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 1.2rem; margin-top: 1.8rem; }
  .start-link { background: #dfc375; color: #10233e; border-radius: 999px; padding: .9rem 1.4rem; font-weight: 700; }
  .source-link { color: #f2e4ba; text-decoration: underline; text-underline-offset: .3em; }
  .hero-note { max-width: 70ch; margin-top: 1.5rem; color: #becbdc; line-height: 1.65; font-size: .9rem; }
  a:focus-visible { outline: 3px solid #fff; outline-offset: 5px; }
  @keyframes filmFade { 0%, 40%, 100% { opacity: 1; } 50%, 90% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .hero-art { animation: none; } .hero-art-second { display: none; } }
  @media (max-width: 640px) { .public-hero { padding: 7rem 0 3rem; min-height: auto; } }
</style>
