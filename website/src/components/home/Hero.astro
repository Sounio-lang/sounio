---
import { getLocalizedPath, type Locale } from '../../lib/i18n';
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';
import ClaimChip from '../ui/ClaimChip.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const content = {
  en: {
    scientist: {
      badge: 'For scientists who can’t afford to be wrong',
      title: 'Your doctor gives you a dose. Your engineer builds a bridge. Do they know how sure they are?',
      description:
        'Somewhere between the measurement and the decision, the doubt gets lost. The lab says 9.8 ± 0.1. The code says 9.8. The patient gets 9.8. The ±0.1 is gone. Sounio keeps the doubt — in the type, in the compile, in the decision.',
      cta1: 'See how it works',
      cta1Href: '/learn/vancomycin-uncertainty',
      cta2: 'Explore the science',
      cta2Href: '/science',
      featured: 'From hospital dosing to particle physics — doubt is not optional',
      featuredHref: '/science',
      emblem: 'Built for people who measure things that matter.',
    },
    technical: {
      badge: 'A language that keeps the doubt',
      title: 'The compiler that says "I don’t know enough" before it says "trust me".',
      description:
        'Most languages treat uncertainty as a comment. Sounio makes it a type. Every measurement carries its confidence. Every operation propagates it. When confidence drops, the compiler refuses to run. Not a warning. A gate.',
      cta1: 'Start with Docs',
      cta1Href: '/learn/getting-started',
      cta2: 'See the proof',
      cta2Href: '/proof',
      featured: 'The 168 theorem: a language that found new mathematics',
      featuredHref: '/proof#theorem-168',
      emblem: 'Built for teams shipping high-consequence scientific software.',
    },
  },
  pt: {
    scientist: {
      badge: 'Para clínicos e pesquisadores · biomateriais e farmacologia',
      title: 'Seu médico dá uma dose. Seu engenheiro constrói uma ponte. Eles sabem o quanto têm certeza?',
      description:
        'Em algum lugar entre a medição e a decisão, a dúvida se perde. O laboratório diz 9,8 ± 0,1. O código diz 9,8. O paciente recebe 9,8. O ±0,1 se foi. O Sounio mantém a dúvida — no tipo, na compilação, na decisão.',
      cta1: 'Ver como funciona',
      cta1Href: '/learn/vancomycin-uncertainty',
      cta2: 'Explorar a ciência',
      cta2Href: '/science',
      featured: 'De doses hospitalares à física de partículas — a dúvida não é opcional',
      featuredHref: '/science',
      emblem: 'Feito para pessoas que medem coisas importantes.',
    },
    technical: {
      badge: 'Uma linguagem que mantém a dúvida',
      title: 'O compilador que diz "não sei o suficiente" antes de dizer "confie em mim".',
      description:
        'A maioria das linguagens trata a incerteza como um comentário. O Sounio faz dela um tipo. Cada medição carrega sua confiança. Cada operação a propaga. Quando a confiança cai, o compilador se recusa a executar. Não um aviso. Um portão.',
      cta1: 'Começar com Docs',
      cta1Href: '/learn/getting-started',
      cta2: 'Ver as provas',
      cta2Href: '/proof',
      featured: 'O teorema 168: uma linguagem que encontrou nova matemática',
      featuredHref: '/proof#theorem-168',
      emblem: 'Feito para equipes que produzem software científico de alta consequência.',
    },
  },
};

const localeKey = (locale === 'pt' ? 'pt' : 'en') as 'pt' | 'en';
const d = content[localeKey];
---

<article class="preprint-hero relative min-h-screen">
  {/* Running head */}
  <header class="journal-running-head container">
    <span class="left">SOUNIO-LANG</span>
    <span class="right">DRAFT — UNDER PERPETUAL REVIEW</span>
  </header>

  {/* Title page */}
  <div class="container grid min-h-[calc(100vh-3rem)] items-center py-16">
    <div class="mx-auto grid max-w-[720px] gap-8 text-center">
      {/* Plate I — Pappou & Yaya as frontispiece */}
      <figure class="frontispiece mx-auto grid gap-4">
        <div class="grid grid-cols-2 gap-4 max-w-[400px] mx-auto">
          <div class="frontispiece-plate relative overflow-hidden rounded-sm border border-[var(--color-line)] bg-[var(--color-surface-raise)] p-2">
            <img
              src="/assets/original-artworks/pappou_hero_duotone.png"
              alt="Pappou — the elder who measures what he knows"
              class="h-auto w-full object-cover opacity-80"
              loading="eager"
              decoding="async"
            />
            <figcaption class="mt-2 text-center font-mono text-[0.68rem] text-[var(--color-accent-pencil)]">
              Fig. 1 — Pappou, the elder who measures
            </figcaption>
          </div>
          <div class="frontispiece-plate relative overflow-hidden rounded-sm border border-[var(--color-line)] bg-[var(--color-surface-raise)] p-2">
            <img
              src="/assets/original-artworks/yiayia_hero_duotone.png"
              alt="Yaya — the elder who carries what she doesn't know"
              class="h-auto w-full object-cover opacity-80"
              loading="eager"
              decoding="async"
            />
            <figcaption class="mt-2 text-center font-mono text-[0.68rem] text-[var(--color-accent-pencil)]">
              Fig. 2 — Yaya, the elder who carries
            </figcaption>
          </div>
        </div>
        <figcaption class="text-center font-mono text-[0.72rem] text-[var(--color-accent-pencil)]">
          Plate I — The Guardians of Cape Sounion
        </figcaption>
      </figure>

      {/* Title */}
      <div class="grid gap-4">
        <Eyebrow class="justify-center text-[var(--color-accent-rubric)]">{d.scientist.badge}</Eyebrow>
        <h1 class="font-[var(--font-display)] text-[clamp(2.8rem,6.5vw,5.2rem)] leading-[1.04] font-medium tracking-[-0.028em] text-balance">
          {d.scientist.title}
        </h1>
      </div>

      {/* Abstract */}
      <div class="journal-abstract mx-auto max-w-[56ch] text-left">
        <div class="journal-abstract-label">Abstract</div>
        <p class="m-0">{d.scientist.description}</p>
        <div class="journal-keywords mt-3">
          <strong>Keywords:</strong> epistemic computing · uncertainty types · GUM · knowledge · provenance
        </div>
      </div>

      {/* CTAs */}
      <div class="mt-2 flex flex-wrap items-center justify-center gap-3">
        <Button href={getLocalizedPath(d.scientist.cta1Href, locale)}>{d.scientist.cta1}</Button>
        <Button href={getLocalizedPath(d.scientist.cta2Href, locale)} variant="ghost">{d.scientist.cta2}</Button>
      </div>

      {/* Featured claim */}
      <div class="mt-2 flex justify-center">
        <ClaimChip status="proven" label={d.scientist.featured} href={getLocalizedPath(d.scientist.featuredHref, locale)} />
      </div>

      {/* Emblem */}
      <div class="mt-3 inline-flex items-center justify-center gap-3 text-[0.85rem] text-[var(--color-ink-3)]">
        <img src="/assets/stamps/emblem_badge_monochrome_on_navy.png" alt="" aria-hidden="true" class="h-[30px] w-[30px] opacity-60" loading="lazy" />
        <span>{d.scientist.emblem}</span>
      </div>
    </div>
  </div>

  {/* Technical pane — hidden for scientist audience */}
  <div class="hidden" data-for-audience="technical">
    <div class="container grid min-h-[calc(100vh-3rem)] items-center py-16">
      <div class="mx-auto grid max-w-[720px] gap-8 text-center">
        <figure class="frontispiece mx-auto grid gap-4">
          <div class="grid grid-cols-2 gap-4 max-w-[400px] mx-auto">
            <div class="frontispiece-plate relative overflow-hidden rounded-sm border border-[var(--color-line)] bg-[var(--color-surface-raise)] p-2">
              <img
                src="/assets/original-artworks/pappou_hero_duotone.png"
                alt="Pappou — the elder who measures what he knows"
                class="h-auto w-full object-cover opacity-80"
                loading="eager"
                decoding="async"
              />
              <figcaption class="mt-2 text-center font-mono text-[0.68rem] text-[var(--color-accent-pencil)]">
                Fig. 1 — Pappou, the elder who measures
              </figcaption>
            </div>
            <div class="frontispiece-plate relative overflow-hidden rounded-sm border border-[var(--color-line)] bg-[var(--color-surface-raise)] p-2">
              <img
                src="/assets/original-artworks/yiayia_hero_duotone.png"
                alt="Yaya — the elder who carries what she doesn't know"
                class="h-auto w-full object-cover opacity-80"
                loading="eager"
                decoding="async"
              />
              <figcaption class="mt-2 text-center font-mono text-[0.68rem] text-[var(--color-accent-pencil)]">
                Fig. 2 — Yaya, the elder who carries
              </figcaption>
            </div>
          </div>
          <figcaption class="text-center font-mono text-[0.72rem] text-[var(--color-accent-pencil)]">
            Plate I — The Guardians of Cape Sounion
          </figcaption>
        </figure>

        <div class="grid gap-4">
          <Eyebrow class="justify-center text-[var(--color-accent-rubric)]">{d.technical.badge}</Eyebrow>
          <h1 class="font-[var(--font-display)] text-[clamp(2.8rem,6.5vw,5.2rem)] leading-[1.04] font-medium tracking-[-0.028em] text-balance">
            {d.technical.title}
          </h1>
        </div>

        <div class="journal-abstract mx-auto max-w-[56ch] text-left">
          <div class="journal-abstract-label">Abstract</div>
          <p class="m-0">{d.technical.description}</p>
          <div class="journal-keywords mt-3">
            <strong>Keywords:</strong> epistemic computing · uncertainty types · GUM · knowledge · provenance
          </div>
        </div>

        <div class="mt-2 flex flex-wrap items-center justify-center gap-3">
          <Button href={getLocalizedPath(d.technical.cta1Href, locale)}>{d.technical.cta1}</Button>
          <Button href={getLocalizedPath(d.technical.cta2Href, locale)} variant="ghost">{d.technical.cta2}</Button>
        </div>

        <div class="mt-2 flex justify-center">
          <ClaimChip status="proven" label={d.technical.featured} href={getLocalizedPath(d.technical.featuredHref, locale)} />
        </div>

        <div class="mt-3 inline-flex items-center justify-center gap-3 text-[0.85rem] text-[var(--color-ink-3)]">
          <img src="/assets/stamps/emblem_badge_monochrome_on_navy.png" alt="" aria-hidden="true" class="h-[30px] w-[30px] opacity-60" loading="lazy" />
          <span>{d.technical.emblem}</span>
        </div>
      </div>
    </div>
  </div>

  {/* Folio */}
  <footer class="journal-folio container">
    <span>p. 1/9</span>
  </footer>
</article>

<style>
  .preprint-hero {
    background: var(--color-surface-base);
  }

  .frontispiece-plate img {
    filter: sepia(0.1) contrast(1.05);
  }
</style>

<script>
  import { gsap } from '../../lib/motion';

  function mountHero() {
    const hero = document.querySelector<HTMLElement>('.preprint-hero');
    if (!hero || hero.dataset.mounted) return;
    hero.dataset.mounted = 'true';

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const mm = gsap.matchMedia();
    mm.add('(prefers-reduced-motion: no-preference)', () => {
      // Frontispiece plates enter first
      const plates = hero.querySelectorAll('.frontispiece-plate');
      if (plates.length) {
        gsap.from(plates, {
          y: 30,
          opacity: 0,
          duration: 0.8,
          ease: 'power2.out',
          stagger: 0.15,
          delay: 0.2,
        });
      }

      // Title and abstract enter after
      const title = hero.querySelector('h1');
      const abstract = hero.querySelector('.journal-abstract');
      if (title) {
        gsap.from(title, {
          y: 20,
          opacity: 0,
          duration: 0.7,
          ease: 'power2.out',
          delay: 0.5,
        });
      }
      if (abstract) {
        gsap.from(abstract, {
          y: 20,
          opacity: 0,
          duration: 0.7,
          ease: 'power2.out',
          delay: 0.7,
        });
      }
    });
  }

  mountHero();
  document.addEventListener('astro:page-load', mountHero);
</script>
