---
import { loadTranslations, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = await loadTranslations(locale);
---

<section class="relative min-h-[90vh] flex items-center justify-center overflow-hidden bg-gradient-to-br from-[var(--color-navy-900)] via-[var(--color-navy-800)] to-[var(--color-orange-500)]">
  <!-- Decorative background pattern -->
  <div class="absolute inset-0 opacity-10">
    <div class="absolute inset-0" style="background-image: url(\"data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23c4a574' fill-opacity='0.4'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E\");" />
  </div>

  <!-- Wave decoration at bottom -->
  <div class="absolute bottom-0 left-0 right-0 h-48 pointer-events-none">
    <svg class="absolute bottom-0 w-full h-48" viewBox="0 0 1440 320" preserveAspectRatio="none">
      <path
        fill="var(--color-bg)"
        fill-opacity="0.3"
        d="M0,160L48,176C96,192,192,224,288,213.3C384,203,480,149,576,138.7C672,128,768,160,864,186.7C960,213,1056,235,1152,218.7C1248,203,1344,149,1392,122.7L1440,96L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"
      />
    </svg>
  </div>

  <!-- Mascots -->
  <img
    src="/assets/original-artworks/claude-crab-scientist.png"
    alt=""
    class="hidden lg:block absolute bottom-0 left-8 w-48 opacity-90 hover:opacity-100 hover:scale-105 hover:-translate-y-2 transition-all duration-300"
    aria-hidden="true"
    loading="lazy"
  />
  <img
    src="/assets/original-artworks/claude-owl-philosopher.png"
    alt=""
    class="hidden lg:block absolute bottom-0 right-8 w-48 opacity-90 hover:opacity-100 hover:scale-105 hover:-translate-y-2 transition-all duration-300"
    aria-hidden="true"
    loading="lazy"
  />

  <!-- Hero content -->
  <div class="relative z-10 container text-center px-4 py-12">
    <img
      src="/assets/sounio-logo.svg"
      alt="Sounio"
      class="w-32 h-32 mx-auto mb-8 drop-shadow-lg"
    />

    <h1 class="text-5xl md:text-7xl font-semibold text-white mb-4 tracking-tight drop-shadow-lg">
      Sounio
    </h1>

    <p class="text-xl md:text-2xl text-[var(--color-gold-500)] italic mb-4 drop-shadow">
      {t.hero_tagline}
    </p>

    <div class="inline-block px-4 py-2 bg-white/10 rounded-full text-[var(--color-gold-500)] text-sm mb-8 border border-[var(--color-gold-500)]/50">
      <a href="/changelog" class="hover:text-white transition-colors">
        v0.99.0 — Pre-release
      </a>
    </div>

    <!-- Install snippet -->
    <div class="max-w-xl mx-auto mb-8">
      <div class="flex items-center gap-3 bg-[var(--color-navy-900)] rounded-lg p-4 shadow-xl">
        <code class="flex-1 text-[var(--color-gold-500)] font-mono text-sm text-left truncate">
          {t.hero_install_cmd}
        </code>
        <button
          type="button"
          class="px-4 py-2 bg-[var(--color-gold-500)] text-[var(--color-navy-900)] rounded font-semibold hover:bg-white transition-colors focus-ring"
          id="copy-install"
          data-copy={t.hero_install_cmd}
        >
          {t.code_copy_button}
        </button>
      </div>
    </div>

    <!-- CTA buttons -->
    <div class="flex flex-wrap gap-4 justify-center">
      <a
        href="/docs/getting-started"
        class="px-8 py-3 bg-[var(--color-gold-500)] text-[var(--color-navy-900)] rounded-lg font-semibold text-lg hover:bg-white hover:shadow-xl transition-all focus-ring"
      >
        {t.hero_cta_started}
      </a>
      <a
        href="/playground"
        class="px-8 py-3 bg-transparent text-white border-2 border-white rounded-lg font-semibold text-lg hover:bg-white hover:text-[var(--color-navy-900)] transition-all focus-ring"
      >
        {t.hero_cta_playground}
      </a>
      <a
        href="/manifesto"
        class="px-8 py-3 bg-transparent text-white border-2 border-white/50 rounded-lg font-semibold text-lg hover:bg-white/10 hover:border-white transition-all focus-ring"
      >
        {t.hero_cta_manifesto}
      </a>
    </div>
  </div>
</section>

<script>
  const copyBtn = document.getElementById('copy-install');
  copyBtn?.addEventListener('click', async () => {
    const text = copyBtn.dataset.copy;
    if (text) {
      await navigator.clipboard.writeText(text);
      const originalText = copyBtn.textContent;
      copyBtn.textContent = 'Copied!';
      setTimeout(() => {
        copyBtn.textContent = originalText;
      }, 2000);
    }
  });
</script>
