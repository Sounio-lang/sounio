---
import { Picture } from 'astro:assets';
import { getLocalizedPath, type Locale } from '../../lib/i18n';
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';
import ClaimChip from '../ui/ClaimChip.astro';

import pappouHero from '../../../public/assets/original-artworks/pappou_hero.png';
import yiayiaHero from '../../../public/assets/original-artworks/yiayia_hero.png';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const content = {
  en: {
    scientist: {
      badge: 'For scientists who can’t afford to be wrong',
      title: 'Your analysis pipeline is only as honest as its uncertainty.',
      description:
        'You propagate measurement error through 16 fMRI channels, 18 Standard Model parameters, or a 14-compartment PK model. Python gives you a number. Sounio gives you a number with ε, provenance, and a compiler that refuses to run when confidence drops below threshold.',
      cta1: 'See the gate in action',
      cta1Href: '/learn/vancomycin-uncertainty',
      cta2: 'Explore the science',
      cta2Href: '/science',
      featured: 'From ABIDE autism classification to PDG particle constants — uncertainty is first-class',
      featuredHref: '/science',
      emblem: 'Built for high-consequence scientific software.',
    },
    technical: {
      badge: 'Self-hosted epistemic systems language',
      title: 'The compiler that treats uncertainty as a type, not a comment.',
      description:
        'Sounio is a self-hosted systems language where GUM uncertainty propagation, provenance tracking, and confidence gates are first-class primitives. Not a library. Not a convention. The type system. The compiler bootstrapped itself from C to a fixed-point binary — and produced new mathematics along the way.',
      cta1: 'Start with Docs',
      cta1Href: '/learn/getting-started',
      cta2: 'See the proof',
      cta2Href: '/proof',
      featured: 'The 168 theorem: PSL(2,7) governs octonion non-associativity',
      featuredHref: '/proof#theorem-168',
      emblem: 'Built for teams shipping high-consequence scientific software.',
    },
  },
  pt: {
    scientist: {
      badge: 'Para clínicos e pesquisadores · biomateriais e farmacologia',
      title: 'Seus cálculos escondem incertezas.',
      description:
        'Ao calcular uma dose de medicamento, uma métrica de paciente ou uma previsão clínica, o código tradicional fornece um único número sem contexto. O Sounio rastreia automaticamente o erro de medição, a incerteza do padrão ISO GUM e a proveniência dos dados em cada etapa da execução.',
      cta1: 'Ver Exemplo de Dosagem',
      cta1Href: '/learn/vancomycin-uncertainty',
      cta2: 'Hub de Ciência Clínica',
      cta2Href: '/science',
      featured: 'Dosagem de vancomicina que não esconde a incerteza',
      featuredHref: '/learn/vancomycin-uncertainty',
      emblem: 'Desenvolvido para segurança clínica e software científico de alta consequência.',
    },
    technical: {
      badge: 'Cadeia de ferramentas beta · linguagem epistêmica self-hosted',
      title: 'Compute na fronteira entre a certeza e a consequência.',
      description:
        'O Sounio é uma linguagem de programação de sistemas para equipas científicas que precisam de raciocinar não apenas sobre valores, mas sobre confiança, proveniência e incerteza em cada fase de execução.',
      cta1: 'Começar com Docs',
      cta1Href: '/learn/getting-started',
      cta2: 'Ver as provas',
      cta2Href: '/proof',
      featured: 'Análise aprofundada do teorema não-associativo de 168 dos Octoniões',
      featuredHref: '/proof#theorem-168',
      emblem: 'Desenvolvido para equipas que produzem software científico de alta consequência.',
    },
  },
};

const localeKey = (locale === 'pt' ? 'pt' : 'en') as 'pt' | 'en';
const d = content[localeKey];
---

<section class="hero-monument relative grid min-h-[min(940px,96vh)] items-center overflow-hidden">
  {/* Layer 1 — brand art fallback (always present; shader fades in over it) */}
  <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
    <Picture
      src={pappouHero}
      alt=""
      class="hero-art h-full w-full object-cover object-center opacity-60"
      formats={['avif', 'webp']}
      loading="eager"
      decoding="async"
    />
    <Picture
      src={yiayiaHero}
      alt=""
      class="hero-art hero-art-alt absolute inset-0 h-full w-full object-cover object-center opacity-0"
      formats={['avif', 'webp']}
      loading="lazy"
      decoding="async"
    />
    <canvas
      id="hero-shader"
      class="absolute inset-0 h-full w-full opacity-0 transition-opacity duration-[1600ms] ease-out"
    ></canvas>
    {/* contrast veil */}
    <div class="absolute inset-0 bg-[linear-gradient(105deg,rgba(7,18,36,0.92)_0%,rgba(7,18,36,0.62)_46%,rgba(7,18,36,0.35)_72%,rgba(7,18,36,0.78)_100%)]"></div>
    <div class="absolute inset-x-0 bottom-0 h-40 bg-[linear-gradient(to_top,var(--color-surface-base),transparent)]"></div>
  </div>

  {/* Scientist pane */}
  <div class="relative z-10 container grid max-w-[720px] gap-6 pt-28 pb-16 md:pt-0" data-for-audience="scientist">
    <Eyebrow>{d.scientist.badge}</Eyebrow>
    <h1 class="font-[var(--font-display)] text-[clamp(3.2rem,8vw,6.5rem)] leading-[1.01] font-medium tracking-[-0.025em] text-balance">
      {d.scientist.title}
    </h1>
    <p class="max-w-[56ch] text-[clamp(0.98rem,1.6vw,1.2rem)] leading-[1.65] text-[var(--color-ink-2)]">
      {d.scientist.description}
    </p>
    <div class="mt-1 flex flex-wrap items-center gap-3">
      <Button href={getLocalizedPath(d.scientist.cta1Href, locale)}>{d.scientist.cta1}</Button>
      <Button href={getLocalizedPath(d.scientist.cta2Href, locale)} variant="ghost">{d.scientist.cta2}</Button>
    </div>
    <div class="mt-1">
      <ClaimChip status="proven" label={d.scientist.featured} href={getLocalizedPath(d.scientist.featuredHref, locale)} />
    </div>
    <div class="mt-2 inline-flex items-center gap-3 text-[0.85rem] text-[var(--color-ink-3)]">
      <img src="/assets/stamps/emblem_badge_monochrome_on_navy.png" alt="" aria-hidden="true" class="h-[30px] w-[30px] opacity-80" loading="lazy" />
      <span>{d.scientist.emblem}</span>
    </div>
  </div>

  {/* Technical pane */}
  <div class="relative z-10 container grid max-w-[720px] gap-6 pt-28 pb-16 md:pt-0" data-for-audience="technical">
    <Eyebrow>{d.technical.badge}</Eyebrow>
    <h1 class="font-[var(--font-display)] text-[clamp(3.2rem,8vw,6.5rem)] leading-[1.01] font-medium tracking-[-0.025em] text-balance">
      {d.technical.title}
    </h1>
    <p class="max-w-[56ch] text-[clamp(0.98rem,1.6vw,1.2rem)] leading-[1.65] text-[var(--color-ink-2)]">
      {d.technical.description}
    </p>
    <div class="mt-1 flex flex-wrap items-center gap-3">
      <Button href={getLocalizedPath(d.technical.cta1Href, locale)}>{d.technical.cta1}</Button>
      <Button href={getLocalizedPath(d.technical.cta2Href, locale)} variant="ghost">{d.technical.cta2}</Button>
    </div>
    <div class="mt-1">
      <ClaimChip status="proven" label={d.technical.featured} href={getLocalizedPath(d.technical.featuredHref, locale)} />
    </div>
    <div class="mt-2 inline-flex items-center gap-3 text-[0.85rem] text-[var(--color-ink-3)]">
      <img src="/assets/stamps/emblem_badge_monochrome_on_navy.png" alt="" aria-hidden="true" class="h-[30px] w-[30px] opacity-80" loading="lazy" />
      <span>{d.technical.emblem}</span>
    </div>
  </div>
</section>

<style>
  /* Slow brand-art crossfade under the shader (motion-safe only):
     alt image runs the same cycle shifted by half a period. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-art {
      animation: heroFilmFade 16s linear infinite;
    }
    .hero-art-alt {
      animation: heroFilmFade 16s linear infinite;
      animation-delay: -8s;
    }
  }
  @keyframes heroFilmFade {
    0%, 42% { opacity: 0.6; }
    50%, 92% { opacity: 0; }
    100% { opacity: 0.6; }
  }
</style>

<script>
  import { createShaderCanvas } from '../../lib/shader';
  import { gsap } from '../../lib/motion';

  const FRAG = `#version 300 es
precision highp float;
uniform float uTime;
uniform vec2 uRes;
out vec4 outColor;

float hash(vec2 p){ p = fract(p*vec2(123.34, 456.21)); p += dot(p, p+45.32); return fract(p.x*p.y); }
float noise(vec2 p){
  vec2 i = floor(p), f = fract(p);
  f = f*f*(3.0-2.0*f);
  float a = hash(i), b = hash(i+vec2(1.0,0.0)), c = hash(i+vec2(0.0,1.0)), d = hash(i+vec2(1.0,1.0));
  return mix(mix(a,b,f.x), mix(c,d,f.x), f.y);
}
float fbm(vec2 p){
  float v = 0.0, a = 0.5;
  mat2 rot = mat2(0.8, 0.6, -0.6, 0.8);
  for(int i=0;i<5;i++){ v += a*noise(p); p = rot*p*2.0; a *= 0.5; }
  return v;
}
void main(){
  vec2 uv = gl_FragCoord.xy / uRes.xy;
  vec2 p = uv * vec2(uRes.x/uRes.y, 1.0) * 2.1;
  float t = uTime * 0.028;
  vec2 q = vec2(fbm(p + t), fbm(p + vec2(5.2, 1.3) - t));
  vec2 r = vec2(fbm(p + 3.0*q + vec2(1.7, 9.2) + 0.15*t), fbm(p + 3.0*q + vec2(8.3, 2.8)));
  float f = fbm(p + 2.4*r);
  vec3 base = vec3(0.043, 0.118, 0.227);
  vec3 mid  = vec3(0.070, 0.196, 0.325);
  vec3 gold = vec3(0.839, 0.702, 0.353);
  vec3 col = mix(base, mid, smoothstep(0.15, 0.85, f));
  float vein = smoothstep(0.485, 0.505, f) * (1.0 - smoothstep(0.505, 0.565, f));
  col = mix(col, gold, vein * 0.6 * smoothstep(0.25, 0.85, length(q)));
  float vig = smoothstep(1.3, 0.3, length(uv - vec2(0.42, 0.5)));
  col *= mix(0.7, 1.0, vig);
  outColor = vec4(col, 1.0);
}`;

  function mountHero() {
    const canvas = document.getElementById('hero-shader') as HTMLCanvasElement | null;
    if (!canvas || canvas.dataset.mounted) return;
    canvas.dataset.mounted = 'true';

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    createShaderCanvas(canvas, {
      frag: FRAG,
      maxDpr: 1.5,
      onFallback: () => canvas.remove(),
    });

    if (!canvas.dataset.shaderFailed) {
      requestAnimationFrame(() => canvas.classList.remove('opacity-0'));
    }
  }

  mountHero();
  document.addEventListener('astro:page-load', mountHero);

  // Entrance choreography for the visible audience pane
  const mm = gsap.matchMedia();
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    const pane =
      document.querySelector<HTMLElement>('.hero-monument [data-for-audience]:not([style*="display: none"])') ??
      document.querySelector('.hero-monument [data-for-audience]');
    if (!pane) return;
    gsap.from(pane.children, {
      y: 30,
      opacity: 0,
      stagger: 0.11,
      duration: 0.85,
      ease: 'power2.out',
      delay: 0.15,
      clearProps: 'opacity,transform',
    });
  });
</script>
