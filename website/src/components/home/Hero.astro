---
import { Picture } from 'astro:assets';
import { HERO_SIZES, HERO_WIDTHS } from '../../lib/heroImage';
import { getLocalizedPath, type Locale } from '../../lib/i18n';
import { readFileSync } from 'node:fs';
import path from 'node:path';
import ResearchLanguageStatus from '../status/ResearchLanguageStatus.astro';
import surface from '../../data/publicSurface.json';
import pappouHero from '../../../public/assets/original-artworks/pappou_hero.png';
import yiayiaHero from '../../../public/assets/original-artworks/yiayia_hero.png';

const speedSource = readFileSync(path.join(process.cwd(), 'src/fixtures/home/speed_and_knowledge.sio'), 'utf8');
const refusedSource = readFileSync(path.join(process.cwd(), 'src/fixtures/home/metres_plus_seconds.sio'), 'utf8');

const codespace = 'https://codespaces.new/Sounio-lang/sounio?devcontainer_path=.devcontainer%2Fdemo%2Fdevcontainer.json';
const speedReceipt = '10.438413\n0.000000';
const refusedReceipt = 'error[E041]: unit mismatch in arithmetic operation\n  left unit: length^1\n  right unit: time^1';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const content = surface[locale];
---

<section class="public-hero relative overflow-hidden" aria-labelledby="public-title">
  <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
    <Picture src={pappouHero} alt="" class="hero-art hero-art-first" formats={['avif', 'webp']} widths={[...HERO_WIDTHS]} sizes={HERO_SIZES} loading="eager" decoding="sync" fetchpriority="high" />
    <Picture src={yiayiaHero} alt="" class="hero-art hero-art-second" formats={['avif', 'webp']} widths={[...HERO_WIDTHS]} sizes={HERO_SIZES} loading="lazy" decoding="async" fetchpriority="low" />
    <div class="hero-shade absolute inset-0"></div>
  </div>
  <div class="container relative z-10">
    <div class="hero-copy">
      <div class="hero-signature">
        <picture class="hero-emblem">
          <source srcset="/assets/stamps/emblem_badge_monochrome_on_navy.avif" type="image/avif" width="36" height="36" />
          <source srcset="/assets/stamps/emblem_badge_monochrome_on_navy.webp" type="image/webp" width="36" height="36" />
          <img src="/assets/stamps/emblem_badge_monochrome_on_navy.png" alt="" aria-hidden="true" width="36" height="36" decoding="async" />
        </picture>
        <span>Sounio</span>
      </div>
      <h1 id="public-title">{content.title}</h1>
      <p class="hero-status" lang="en">Sounio 3.0 (pre-release)</p>
      <ResearchLanguageStatus locale={locale} tone="hero" />
      <div class="hero-proof">
        <figure>
          <figcaption lang="en">Runs. <code>h - h</code> has variance 0.</figcaption>
          <pre><code>{speedSource}</code></pre>
          <pre class="receipt"><code>{speedReceipt}</code></pre>
        </figure>
        <figure>
          <figcaption lang="en">Refused. Metres added to seconds.</figcaption>
          <pre><code>{refusedSource}</code></pre>
          <pre class="receipt"><code>{refusedReceipt}</code></pre>
        </figure>
      </div>
      <p class="hero-description">{content.description}</p>
      <div class="hero-actions">
        <a href={codespace} class="start-link">Open in GitHub Codespaces</a>
        <a href={getLocalizedPath('/learn/getting-started/', locale)} class="source-link">Install</a>
        <a href="/learn/epistemic/uncertainty-tools-compared/" class="source-link" hreflang="en">uncertainties and Measurements.jl</a>
        <a href="/learn/epistemic/sounio-vs-mp-units-vs-physure/" class="source-link" hreflang="en">mp-units and physure</a>
        <a href={getLocalizedPath('/scientist', locale)} class="source-link">{content.start}</a>
      </div>
      <p class="hero-note">{content.note}</p>
    </div>
  </div>
</section>

<style>
  .public-hero { padding: 8rem 0 4.5rem; min-height: 70vh; display: grid; align-items: center; background: #07162c; color: #fff; }
  .hero-art { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .hero-art-first { animation: filmFade 18s linear infinite; }
  .hero-art-second { opacity: 0; animation: filmFade 18s linear infinite; animation-delay: -9s; }
  .hero-shade { background: linear-gradient(110deg, rgba(7,22,44,.94), rgba(7,22,44,.76) 55%, rgba(7,22,44,.48)); }
  .hero-copy { max-width: 980px; }
  .hero-signature { display: flex; align-items: center; gap: .7rem; color: #e4ca85; font-size: 1rem; margin-bottom: 1.6rem; }
  .hero-emblem { display: block; width: 36px; height: 36px; line-height: 0; }
  .hero-emblem img { display: block; width: 36px; height: 36px; }
  h1 { font-size: clamp(2.2rem, 4.4vw, 4.2rem); line-height: 1.08; letter-spacing: -.035em; font-weight: 750; max-width: 28ch; text-wrap: balance; }
  .hero-status { margin-top: 0.8rem; color: #e4ca85; font-size: 0.95rem; }
  .hero-proof { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 0.8rem; margin-top: 1.2rem; }
  .hero-proof figure { min-width: 0; }
  .hero-proof figcaption { color: #e4ca85; font-size: 0.85rem; margin-bottom: 0.35rem; }
  .hero-proof pre { margin: 0 0 0.45rem; padding: 0.75rem 0.85rem; overflow-x: auto; background: rgba(0,0,0,.35); border: 1px solid rgba(227,207,150,.35); border-radius: 0.5rem; font-size: 0.78rem; line-height: 1.45; color: #f3e6c0; }
  .hero-proof .receipt { color: #d7eccf; }
  .hero-copy { max-width: 980px; }
  .hero-description { max-width: 65ch; margin-top: 1.6rem; color: #e0e6ef; font-size: clamp(1rem, 1.6vw, 1.2rem); line-height: 1.7; }
  .hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 1.2rem; margin-top: 1.8rem; }
  .start-link { background: #dfc375; color: #10233e; border-radius: 999px; padding: .9rem 1.4rem; font-weight: 700; }
  .source-link { color: #f2e4ba; text-decoration: underline; text-underline-offset: .3em; }
  .hero-note { max-width: 70ch; margin-top: 1.5rem; color: #becbdc; line-height: 1.65; font-size: .9rem; }
  a:focus-visible { outline: 3px solid #fff; outline-offset: 5px; }
  @keyframes filmFade { 0%, 40%, 100% { opacity: 1; } 50%, 90% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .hero-art { animation: none; } .hero-art-second { display: none; } }
  @media (max-width: 800px) { .hero-proof { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 640px) { .public-hero { padding: 7rem 0 3rem; min-height: auto; } }
</style>
