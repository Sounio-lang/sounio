    steady: 'estável',
    moving: 'em movimento',
    bounded: 'delimitado',
    localized: 'localizado',
  },
  es: {
    eyebrow: 'Pulso del Lenguaje Vivo',
    heading: 'Lo que cambia debe convertirse en orientación.',
    body: 'Sounio se mueve rápido. Este pulso mantiene la superficie pública ligada a artefactos verificados, salud de puertas, límites conocidos y un camino claro para la verificación escéptica.',
    metrics: 'Señales actuales',
    signal: 'Entrada predeterminada',
    attention: 'Necesita atención',
    plan: 'Leer el plan operativo',
    source: 'fuente',
    freshness: 'Generado',
    evidence: 'Rutas de evidencia',
    proofPath: 'Ruta de verificación',
    attentionMore: 'brechas conocidas siguen rastreadas',
    steady: 'estable',
    moving: 'en movimiento',
    bounded: 'delimitado',
    localized: 'localizado',
  },
  el: {
    eyebrow: 'Παλμός ζωντανής γλώσσας',
    heading: 'Ό,τι αλλάζει πρέπει να γίνεται προσανατολισμός.',
    body: 'Το Sounio κινείται γρήγορα. Αυτός ο παλμός κρατά τη δημόσια επιφάνεια δεμένη με ελεγμένα artifacts, υγεία gates, γνωστά όρια και καθαρό μονοπάτι επαλήθευσης.',
    metrics: 'Τρέχοντα σήματα',
    signal: 'Προεπιλεγμένη είσοδος',
    attention: 'Χρειάζεται προσοχή',
    plan: 'Διαβάστε το επιχειρησιακό πλάνο',
    source: 'πηγή',
    freshness: 'Δημιουργήθηκε',
    evidence: 'Διαδρομές τεκμηρίωσης',
    proofPath: 'Διαδρομή επαλήθευσης',
    attentionMore: 'γνωστά κενά παραμένουν υπό παρακολούθηση',
    steady: 'σταθερό',
    moving: 'σε κίνηση',
    bounded: 'οριοθετημένο',
    localized: 'τοπικοποιημένο',
  },
  zh: {
    eyebrow: '活语言脉搏',
    heading: '变化应当变成方向感。',
    body: 'Sounio 发展很快。这个脉搏把公共界面连接到已检查产物、门控健康、已知边界，以及清晰的验证路径。',
    metrics: '当前信号',
    signal: '默认入口',
    attention: '需要关注',
    plan: '阅读运行计划',
    source: '来源',
    freshness: '生成于',
    evidence: '证据路径',
    proofPath: '验证路径',
    attentionMore: '个已知缺口仍在跟踪',
    steady: '稳定',
    moving: '推进中',
    bounded: '有边界',
    localized: '已本地化',
  },
  'zh-hk': {
    eyebrow: '活語言脈搏',
    heading: '改變要變成方向感。',
    body: 'Sounio 發展得快。呢個脈搏將公共介面連到已檢查產物、門控健康、已知邊界，以及清晰嘅驗證路徑。',
    metrics: '當前信號',
    signal: '預設入口',
    attention: '需要關注',
    plan: '閱讀運作計劃',
    source: '來源',
    freshness: '生成於',
    evidence: '證據路徑',
    proofPath: '驗證路徑',
    attentionMore: '個已知缺口仍然追蹤緊',
    steady: '穩定',
    moving: '推進中',
    bounded: '有邊界',
    localized: '已本地化',
  },
  ja: {
    eyebrow: 'Living Language Pulse',
    heading: '変化は、方向感覚に変わるべきです。',
    body: 'Sounio は速く動きます。このパルスは、公開面を検証済みアーティファクト、ゲート状態、既知の限界、明確な検証経路につなぎます。',
    metrics: '現在のシグナル',
    signal: 'デフォルト入口',
    attention: '注意が必要',
    plan: '運用計画を読む',
    source: 'ソース',
    freshness: '生成日',
    evidence: '証拠パス',
    proofPath: '検証パス',
    attentionMore: '件の既知ギャップを追跡中',
    steady: '安定',
    moving: '進行中',
    bounded: '境界あり',
    localized: '翻訳済み',
  },
};

const d = copy[locale] ?? copy.en;
const { metrics, versions, defaultWorkflow, honestStatus } = publicContract;
const stdlib = metrics.stdlibReliabilityGate;
const sourceFileCount = metrics.selfHostedSourceFiles;
const sourceLineCount = metrics.selfHostedSourceLines;
const parsedGeneratedDate = new Date(artifactStatus.generatedAt);
const generatedDate = Number.isNaN(parsedGeneratedDate.getTime())
  ? artifactStatus.generatedAt.slice(0, 10)
  : parsedGeneratedDate.toISOString().slice(0, 10);
const reliabilityPercent =
  stdlib.total > 0 ? Math.round((stdlib.pass / stdlib.total) * 100) : null;
const localeCodes = ['pt', 'el', 'zh', 'zh-hk', 'ja', 'es'];
const localizedDocs = import.meta.glob('../../content/docs/{pt,el,zh,zh-hk,ja,es}/**/*.{md,mdx}', { eager: true });
const englishDocs = import.meta.glob('../../content/docs/en/**/*.{md,mdx}', { eager: true });
const localizedShowcases = import.meta.glob('../../content/showcases/{pt,el,zh,zh-hk,ja,es}/**/*.{md,mdx}', { eager: true });
const englishShowcases = import.meta.glob('../../content/showcases/*.{md,mdx}', { eager: true });
const localizedTutorials = import.meta.glob('../../content/tutorials/{pt,el,zh,zh-hk,ja,es}/**/*.{md,mdx}', { eager: true });
const englishTutorials = import.meta.glob('../../content/tutorials/*.{md,mdx}', { eager: true });
const localizedDocsCount = Object.keys(localizedDocs).length;
const localizedShowcasesCount = Object.keys(localizedShowcases).length;
const localizedTutorialsCount = Object.keys(localizedTutorials).length;
const expectedDocsCount = Object.keys(englishDocs).length * localeCodes.length;
const expectedShowcasesCount = Object.keys(englishShowcases).length * localeCodes.length;
const expectedTutorialsCount = Object.keys(englishTutorials).length * localeCodes.length;
const localizedContentCount =
  localizedDocsCount +
  localizedShowcasesCount +
  localizedTutorialsCount;
const localizedExpectedCount = expectedDocsCount + expectedShowcasesCount + expectedTutorialsCount;
const localizedPercent =
  localizedExpectedCount > 0 ? Math.round((localizedContentCount / localizedExpectedCount) * 100) : null;
const localizedFamilyNote =
  [
    expectedDocsCount > 0 ? `docs ${localizedDocsCount}/${expectedDocsCount}` : 'docs no data',
    expectedShowcasesCount > 0 ? `showcases ${localizedShowcasesCount}/${expectedShowcasesCount}` : 'showcases no data',
    expectedTutorialsCount > 0 ? `tutorials ${localizedTutorialsCount}/${expectedTutorialsCount}` : 'tutorials no data',
  ].join(' · ');
const reliabilityValue = reliabilityPercent == null ? 'no data' : `${reliabilityPercent}%`;
const reliabilityNote =
  stdlib.total > 0 ? `${stdlib.pass}/${stdlib.total} pass · FAIL=${stdlib.fail}` : 'gate inventory unavailable';

const signals = [
  {
    label: 'Reliability gate',
    value: reliabilityValue,
    note: reliabilityNote,
    state: d.steady,
  },
  {
    label: 'Checked artifact',
    value: versions.checkedArtifact,
    note: defaultWorkflow.launcher,
    state: d.bounded,
  },
  {
    label: 'Self-hosted source',
    value: sourceFileCount == null ? 'inventory pending' : `${sourceFileCount}`,
    note: sourceLineCount == null ? 'line count unavailable' : `${sourceLineCount.toLocaleString('en-US')} lines`,
    state: d.moving,
  },
  {
    label: 'Translations',
    value: localizedPercent == null ? `${localizedContentCount}` : `${localizedPercent}%`,
    note: localizedFamilyNote,
    state: d.localized,
  },
];

const missingItems = Array.isArray(honestStatus.missing) ? honestStatus.missing : [];
const attentionItems = missingItems.slice(0, 3);
const remainingAttention = Math.max(0, missingItems.length - attentionItems.length);
const sourceEntries = Object.entries(publicContract.sources);

function githubSourceHref(path: string) {
  const splitIndex = path.indexOf('#');
  const file = splitIndex === -1 ? path : path.slice(0, splitIndex);
  const hash = splitIndex === -1 ? '' : path.slice(splitIndex + 1);
  return `https://github.com/sounio-lang/sounio/blob/main/${file}${hash ? `#${hash}` : ''}`;
}
---

<Section class="llp-section border-y border-[var(--color-line)]">
  <Container width="wide" class="grid gap-[clamp(1.5rem,4vw,3rem)] min-[980px]:grid-cols-[minmax(0,0.82fr)_minmax(0,1.18fr)] min-[980px]:items-center">
    <div class="grid max-w-[680px] gap-4">
      <Eyebrow tone="gold">{d.eyebrow}</Eyebrow>
      <h2 class="m-0 font-[var(--font-display)] text-[clamp(2.15rem,5.2vw,4.6rem)] font-normal leading-[1.02] text-[var(--color-ink-1)]">{d.heading}</h2>
      <p class="m-0 text-[clamp(1rem,2vw,1.16rem)] leading-[1.72] text-[var(--color-ink-2)]">{d.body}</p>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-3">
        <Button href={getLocalizedPath('/plan', locale)} variant="subtle">{d.plan}</Button>
        <span class="font-mono text-[0.74rem] uppercase tracking-[0.08em] text-[var(--color-ink-3)]">{d.freshness}: {generatedDate}</span>
      </div>
    </div>

    <Card pad="none" class="overflow-hidden">
      <div class="flex flex-wrap items-baseline justify-between gap-2.5 border-b border-[var(--color-line)] px-4 py-3">
        <Eyebrow tone="teal" rule={false}>{d.metrics}</Eyebrow>
        <span class="font-mono text-[0.72rem] uppercase tracking-[0.08em] text-[var(--color-ink-3)]">{d.source}: artifactStatus.ts</span>
      </div>

      <div class="grid grid-cols-1 border-b border-[var(--color-line)] min-[681px]:grid-cols-4">
        {signals.map((item) => (
          <div class="flex min-w-0 flex-col gap-2 border-b border-[var(--color-line)] p-4 last:border-b-0 min-[681px]:border-b-0 min-[681px]:border-r min-[681px]:last:border-r-0">
            <Tag tone="teal">{item.state}</Tag>
            <Stat value={item.value} label={item.label} sub={item.note} accent="ink" />
          </div>
        ))}
      </div>

      <div class="grid min-[980px]:grid-cols-[minmax(0,0.92fr)_minmax(0,1.08fr)]">
        <article class="grid content-start gap-3 border-b border-[var(--color-line)] p-4 min-[980px]:border-b-0 min-[980px]:border-r">
          <Eyebrow tone="gold" rule={false}>{d.proofPath}</Eyebrow>
          <h3 class="m-0 text-[1rem] text-[var(--color-ink-1)]">{defaultWorkflow.backend}</h3>
          <p class="m-0 leading-[1.65] text-[var(--color-ink-2)]">{defaultWorkflow.summary}</p>
          <div class="flex flex-wrap gap-2" aria-label={d.evidence}>
            {sourceEntries.map(([label, path]) => (
              <a
                href={githubSourceHref(path)}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-full border border-[var(--color-line)] bg-[color-mix(in_srgb,var(--color-surface-base)_38%,transparent)] px-2.5 py-1.5 text-[0.78rem] font-bold text-[var(--color-ink-2)] transition-colors duration-150 hover:border-[color-mix(in_srgb,var(--color-accent-champagne)_55%,var(--color-line))] hover:text-[var(--color-ink-1)]"
              >
                {label}
              </a>
            ))}
          </div>
        </article>

        <article class="grid content-start gap-3 border-l-2 border-l-[color-mix(in_srgb,var(--color-accent-red)_55%,transparent)] p-4">
          <Eyebrow tone="gold" rule={false}>{d.attention}</Eyebrow>
          <ul class="m-0 grid list-none gap-3 p-0">
            {attentionItems.map((item) => (
              <li class="grid gap-1">
                <strong class="text-[0.9rem] text-[var(--color-ink-1)]">{item.title}</strong>
                <span class="text-[0.88rem] leading-[1.55] text-[var(--color-ink-2)]">{item.detail}</span>
              </li>
            ))}
          </ul>
          {remainingAttention > 0 && (
            <p class="m-0 font-mono text-[0.74rem] uppercase tracking-[0.04em] text-[var(--color-ink-3)]">
              +{remainingAttention} {d.attentionMore}
            </p>
          )}
        </article>
      </div>
    </Card>
  </Container>
</Section>

<style>
  .llp-section {
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--color-surface-raise) 54%, transparent), transparent 65%),
      var(--color-surface-base);
  }
</style>
