    moving: 'moving',
    bounded: 'bounded',
    localized: 'localized',
  },
  pt: {
    eyebrow: 'Pulso da Linguagem Viva',
    heading: 'O que muda precisa virar orientação.',
    body: 'Sounio se move rápido. Este pulso mantém a superfície pública ligada a artefatos verificados, saúde dos gates, limites conhecidos e um caminho claro para verificação cética.',
    metrics: 'Sinais atuais',
    signal: 'Entrada padrão',
    attention: 'Precisa de atenção',
    plan: 'Ler o plano operacional',
    source: 'fonte',
