---
import { artifactStatus, publicContract } from '../../data/artifactStatus';
import { getLocalizedPath } from '../../lib/i18n';
import type { Locale } from '../../lib/i18n';
import {
  escapeCheckedArtifact,
  escapeSelfHostedFiles,
  escapeSelfHostedLineNote,
} from '../../lib/claimEscapes';
import { reliabilityFace, reliabilityMayPrint, reliabilityRefusal } from '../../lib/stdlibReliabilityHonesty';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;

const copy: Record<string, {
  eyebrow: string;
  heading: string;
  body: string;
  metrics: string;
  signal: string;
  attention: string;
  plan: string;
  source: string;
  freshness: string;
  evidence: string;
  proofPath: string;
  attentionMore: string;
  steady: string;
  moving: string;
  bounded: string;
  localized: string;
}> = {
  en: {
    eyebrow: 'Living Language Pulse',
    heading: 'What changed should become orientation.',
    body: 'Sounio moves quickly. This pulse keeps the public surface tied to checked artifacts, gate health, known limits, and a clear path for skeptical verification.',
    metrics: 'Current signals',
    signal: 'Default entry',
    attention: 'Needs attention',
    plan: 'Read the operating plan',
    source: 'source',
    freshness: 'Generated',
    evidence: 'Evidence paths',
    proofPath: 'Verification path',
    attentionMore: 'more known gaps remain tracked',
    steady: 'steady',
    moving: 'moving',
    bounded: 'bounded',
    localized: 'localized',
  },
  pt: {
    eyebrow: 'Pulso da Linguagem Viva',
    heading: 'O que muda precisa virar orientação.',
    body: 'Sounio se move rápido. Este pulso mantém a superfície pública ligada a artefatos verificados, saúde dos gates, limites conhecidos e um caminho claro para verificação cética.',
    metrics: 'Sinais atuais',
    signal: 'Entrada padrão',
    attention: 'Precisa de atenção',
    plan: 'Ler o plano operacional',
    source: 'fonte',
    freshness: 'Gerado',
    evidence: 'Caminhos de evidência',
    proofPath: 'Caminho de verificação',
    attentionMore: 'lacunas conhecidas seguem rastreadas',
    steady: 'estável',
    moving: 'em movimento',
    bounded: 'delimitado',
    localized: 'localizado',
  },
  es: {
    eyebrow: 'Pulso del Lenguaje Vivo',
    heading: 'Lo que cambia debe convertirse en orientación.',
    body: 'Sounio se mueve rápido. Este pulso mantiene la superficie pública ligada a artefactos verificados, salud de puertas, límites conocidos y un camino claro para la verificación escéptica.',
    metrics: 'Señales actuales',
    signal: 'Entrada predeterminada',
    attention: 'Necesita atención',
    plan: 'Leer el plan operativo',
    source: 'fuente',
    freshness: 'Generado',
    evidence: 'Rutas de evidencia',
    proofPath: 'Ruta de verificación',
    attentionMore: 'brechas conocidas siguen rastreadas',
    steady: 'estable',
    moving: 'en movimiento',
    bounded: 'delimitado',
    localized: 'localizado',
  },
  el: {
    eyebrow: 'Παλμός ζωντανής γλώσσας',
    heading: 'Ό,τι αλλάζει πρέπει να γίνεται προσανατολισμός.',
    body: 'Το Sounio κινείται γρήγορα. Αυτός ο παλμός κρατά τη δημόσια επιφάνεια δεμένη με ελεγμένα artifacts, υγεία gates, γνωστά όρια και καθαρό μονοπάτι επαλήθευσης.',
    metrics: 'Τρέχοντα σήματα',
    signal: 'Προεπιλεγμένη είσοδος',
    attention: 'Χρειάζεται προσοχή',
    plan: 'Διαβάστε το επιχειρησιακό πλάνο',
    source: 'πηγή',
    freshness: 'Δημιουργήθηκε',
    evidence: 'Διαδρομές τεκμηρίωσης',
    proofPath: 'Διαδρομή επαλήθευσης',
    attentionMore: 'γνωστά κενά παραμένουν υπό παρακολούθηση',
    steady: 'σταθερό',
    moving: 'σε κίνηση',
    bounded: 'οριοθετημένο',
    localized: 'τοπικοποιημένο',
  },
  zh: {
    eyebrow: '活语言脉搏',
    heading: '变化应当变成方向感。',
    body: 'Sounio 发展很快。这个脉搏把公共界面连接到已检查产物、门控健康、已知边界，以及清晰的验证路径。',
    metrics: '当前信号',
    signal: '默认入口',
    attention: '需要关注',
    plan: '阅读运行计划',
    source: '来源',
    freshness: '生成于',
    evidence: '证据路径',
    proofPath: '验证路径',
    attentionMore: '个已知缺口仍在跟踪',
    steady: '稳定',
    moving: '推进中',
    bounded: '有边界',
    localized: '已本地化',
  },
  'zh-hk': {
    eyebrow: '活語言脈搏',
    heading: '改變要變成方向感。',
    body: 'Sounio 發展得快。呢個脈搏將公共介面連到已檢查產物、門控健康、已知邊界，以及清晰嘅驗證路徑。',
    metrics: '當前信號',
    signal: '預設入口',
    attention: '需要關注',
    plan: '閱讀運作計劃',
    source: '來源',
    freshness: '生成於',
    evidence: '證據路徑',
    proofPath: '驗證路徑',
    attentionMore: '個已知缺口仍然追蹤緊',
    steady: '穩定',
    moving: '推進中',
    bounded: '有邊界',
    localized: '已本地化',
  },
  ja: {
    eyebrow: 'Living Language Pulse',
    heading: '変化は、方向感覚に変わるべきです。',
    body: 'Sounio は速く動きます。このパルスは、公開面を検証済みアーティファクト、ゲート状態、既知の限界、明確な検証経路につなぎます。',
    metrics: '現在のシグナル',
    signal: 'デフォルト入口',
    attention: '注意が必要',
    plan: '運用計画を読む',
    source: 'ソース',
    freshness: '生成日',
    evidence: '証拠パス',
    proofPath: '検証パス',
    attentionMore: '件の既知ギャップを追跡中',
    steady: '安定',
    moving: '進行中',
    bounded: '境界あり',
    localized: '翻訳済み',
  },
};

const d = copy[locale] ?? copy.en;
const { defaultWorkflow, honestStatus } = publicContract;
const reliabilityOk = reliabilityMayPrint();
const parsedGeneratedDate = new Date(artifactStatus.generatedAt);
const generatedDate = Number.isNaN(parsedGeneratedDate.getTime())
  ? artifactStatus.generatedAt.slice(0, 10)
  : parsedGeneratedDate.toISOString().slice(0, 10);
const localeCodes = ['pt', 'el', 'zh', 'zh-hk', 'ja', 'es'];
const localizedDocs = import.meta.glob('../../content/docs/{pt,el,zh,zh-hk,ja,es}/**/*.{md,mdx}', { eager: true });
const englishDocs = import.meta.glob('../../content/docs/en/**/*.{md,mdx}', { eager: true });
const localizedShowcases = import.meta.glob('../../content/showcases/{pt,el,zh,zh-hk,ja,es}/**/*.{md,mdx}', { eager: true });
const englishShowcases = import.meta.glob('../../content/showcases/*.{md,mdx}', { eager: true });
const localizedTutorials = import.meta.glob('../../content/tutorials/{pt,el,zh,zh-hk,ja,es}/**/*.{md,mdx}', { eager: true });
const englishTutorials = import.meta.glob('../../content/tutorials/*.{md,mdx}', { eager: true });
const localizedDocsCount = Object.keys(localizedDocs).length;
const localizedShowcasesCount = Object.keys(localizedShowcases).length;
const localizedTutorialsCount = Object.keys(localizedTutorials).length;
const expectedDocsCount = Object.keys(englishDocs).length * localeCodes.length;
const expectedShowcasesCount = Object.keys(englishShowcases).length * localeCodes.length;
const expectedTutorialsCount = Object.keys(englishTutorials).length * localeCodes.length;
const localizedContentCount =
  localizedDocsCount +
  localizedShowcasesCount +
  localizedTutorialsCount;
const localizedExpectedCount = expectedDocsCount + expectedShowcasesCount + expectedTutorialsCount;
const localizedPercent =
  localizedExpectedCount > 0 ? Math.round((localizedContentCount / localizedExpectedCount) * 100) : null;
const localizedFamilyNote =
  [
    expectedDocsCount > 0 ? `docs ${localizedDocsCount}/${expectedDocsCount}` : 'docs no data',
    expectedShowcasesCount > 0 ? `showcases ${localizedShowcasesCount}/${expectedShowcasesCount}` : 'showcases no data',
    expectedTutorialsCount > 0 ? `tutorials ${localizedTutorialsCount}/${expectedTutorialsCount}` : 'tutorials no data',
  ].join(' · ');
const reliabilityValue = reliabilityOk ? reliabilityFace() : '—';
const reliabilityNote = reliabilityOk
  ? reliabilityFace()
  : reliabilityRefusal();

const signals = [
  {
    label: 'Reliability gate',
    value: reliabilityValue,
    note: reliabilityNote,
    state: d.steady,
  },
  {
    label: 'Checked artifact',
    value: escapeCheckedArtifact(),
    note: defaultWorkflow.launcher,
    state: d.bounded,
  },
  {
    label: 'Self-hosted source',
    value: escapeSelfHostedFiles(),
    note: escapeSelfHostedLineNote(),
    state: d.moving,
  },
  {
    label: 'Translations',
    value: localizedPercent == null ? `${localizedContentCount}` : `${localizedPercent}%`,
    note: localizedFamilyNote,
    state: d.localized,
  },
];

const missingItems = Array.isArray(honestStatus.missing) ? honestStatus.missing : [];
const attentionItems = missingItems.slice(0, 3);
const remainingAttention = Math.max(0, missingItems.length - attentionItems.length);
const sourceEntries = Object.entries(publicContract.sources);

function githubSourceHref(path: string) {
  const splitIndex = path.indexOf('#');
  const file = splitIndex === -1 ? path : path.slice(0, splitIndex);
  const hash = splitIndex === -1 ? '' : path.slice(splitIndex + 1);
  return `https://github.com/sounio-lang/sounio/blob/main/${file}${hash ? `#${hash}` : ''}`;
}
---

<section class="llp-section section-shell">
  <div class="container llp-grid">
    <div class="llp-intro">
      <span class="badge-pill">{d.eyebrow}</span>
      <h2>{d.heading}</h2>
      <p>{d.body}</p>
      <div class="llp-intro-actions">
        <a href={getLocalizedPath('/plan', locale)} class="llp-link">{d.plan}</a>
        <span>{d.freshness}: {generatedDate}</span>
      </div>
    </div>

    <div class="llp-panel">
      <div class="llp-panel-head">
        <p>{d.metrics}</p>
        <span>{d.source}: artifactStatus.ts</span>
      </div>

      <div class="llp-signals">
        {signals.map((item) => (
          <article class="llp-signal">
            <div class="llp-signal-top">
              <p class="llp-signal-label">{item.label}</p>
              <span>{item.state}</span>
            </div>
            <p class="llp-signal-value">{item.value}</p>
            <p class="llp-signal-note">{item.note}</p>
          </article>
        ))}
      </div>

      <div class="llp-two-col">
        <article class="llp-entry">
          <p class="llp-entry-label">{d.proofPath}</p>
          <h3>{defaultWorkflow.backend}</h3>
          <p>{defaultWorkflow.summary}</p>
          <div class="llp-source-row" aria-label={d.evidence}>
            {sourceEntries.map(([label, path]) => (
              <a href={githubSourceHref(path)} target="_blank" rel="noopener noreferrer">
                {label}
              </a>
            ))}
          </div>
        </article>

        <article class="llp-entry llp-entry-warn">
          <p class="llp-entry-label">{d.attention}</p>
          <ul>
            {attentionItems.map((item) => (
              <li>
                <strong>{item.title}</strong>
                <span>{item.detail}</span>
              </li>
            ))}
          </ul>
          {remainingAttention > 0 && (
            <p class="llp-more">
              +{remainingAttention} {d.attentionMore}
            </p>
          )}
        </article>
      </div>
    </div>
  </div>
</section>

<style>
  .llp-section {
    border-top: 1px solid var(--glass-border);
    border-bottom: 1px solid var(--glass-border);
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--color-bg-alt) 54%, transparent), transparent 65%),
      var(--color-bg);
  }

  .llp-grid {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  .llp-intro {
    display: grid;
    gap: 1rem;
    max-width: 680px;
  }

  .llp-intro h2 {
    margin: 0;
    color: var(--color-text-primary);
    font-family: var(--font-display);
    font-size: clamp(2.15rem, 5.2vw, 4.6rem);
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: 0;
  }

  .llp-intro p {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: clamp(1rem, 2vw, 1.16rem);
    line-height: 1.72;
  }

  .llp-link {
    justify-self: start;
    color: var(--color-accent-gold-soft);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: var(--glass-border);
    text-underline-offset: 0.28em;
  }

  .llp-link:hover {
    color: var(--color-text-primary);
    text-decoration-color: var(--color-accent-gold);
  }

  .llp-intro-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
  }

  .llp-intro-actions span {
    color: var(--color-text-tertiary);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .llp-panel {
    border: 1px solid var(--glass-border);
    border-radius: 8px;
    background: color-mix(in srgb, var(--color-surface-frost) 82%, transparent);
    overflow: hidden;
  }

  .llp-panel-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.7rem;
    padding: 0.9rem 1rem;
    border-bottom: 1px solid var(--glass-border);
  }

  .llp-panel-head p,
  .llp-panel-head span,
  .llp-entry-label,
  .llp-signal-label,
  .llp-signal-note {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .llp-panel-head p {
    color: var(--color-accent-teal);
    font-weight: 700;
  }

  .llp-panel-head span,
  .llp-signal-note {
    color: var(--color-text-tertiary);
  }

  .llp-signals {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-bottom: 1px solid var(--glass-border);
  }

  .llp-signal {
    min-width: 0;
    padding: 1rem;
    border-right: 1px solid var(--glass-border);
  }

  .llp-signal:last-child {
    border-right: 0;
  }

  .llp-signal-label {
    color: var(--color-text-secondary);
  }

  .llp-signal-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .llp-signal-top span {
    flex: 0 0 auto;
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-full);
    padding: 0.18rem 0.42rem;
    color: var(--color-accent-teal);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .llp-signal-value {
    margin: 0.45rem 0;
    color: var(--color-text-primary);
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 4vw, 2.55rem);
    line-height: 1;
  }

  .llp-two-col {
    display: grid;
  }

  .llp-entry {
    padding: 1rem;
    display: grid;
    gap: 0.7rem;
  }

  .llp-entry:first-child {
    border-bottom: 1px solid var(--glass-border);
  }

  .llp-entry-label {
    color: var(--color-accent-gold-soft);
    font-weight: 700;
  }

  .llp-entry h3 {
    margin: 0;
    color: var(--color-text-primary);
    font-size: 1rem;
    letter-spacing: 0;
  }

  .llp-entry p {
    margin: 0;
    color: var(--color-text-secondary);
    line-height: 1.65;
  }

  .llp-source-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .llp-source-row a {
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-full);
    padding: 0.36rem 0.58rem;
    color: var(--color-text-secondary);
    background: color-mix(in srgb, var(--color-bg) 38%, transparent);
    font-size: 0.78rem;
    font-weight: 700;
    transition: border-color var(--transition-fast), color var(--transition-fast);
  }

  .llp-source-row a:hover {
    border-color: color-mix(in srgb, var(--color-accent-gold) 55%, var(--glass-border));
    color: var(--color-text-primary);
  }

  .llp-entry ul {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .llp-entry li {
    display: grid;
    gap: 0.25rem;
  }

  .llp-entry li strong {
    color: var(--color-text-primary);
    font-size: 0.9rem;
  }

  .llp-entry li span {
    color: var(--color-text-secondary);
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .llp-entry-warn {
    border-left: 2px solid color-mix(in srgb, var(--color-accent-red) 55%, transparent);
  }

  .llp-more {
    color: var(--color-text-tertiary) !important;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  @media (min-width: 980px) {
    .llp-grid {
      grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
      align-items: center;
    }

    .llp-two-col {
      grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    }

    .llp-entry:first-child {
      border-bottom: 0;
      border-right: 1px solid var(--glass-border);
    }
  }

  @media (max-width: 680px) {
    .llp-signals {
      grid-template-columns: 1fr;
    }

    .llp-signal {
      border-right: 0;
      border-bottom: 1px solid var(--glass-border);
    }

    .llp-signal:last-child {
      border-bottom: 0;
    }
  }
</style>
