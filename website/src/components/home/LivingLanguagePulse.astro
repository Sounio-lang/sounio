---
import { publicContract } from '../../data/artifactStatus';
import { getLocalizedPath } from '../../lib/i18n';
import type { Locale } from '../../lib/i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;

const copy: Record<string, {
  eyebrow: string;
  heading: string;
  body: string;
  metrics: string;
  signal: string;
  attention: string;
  plan: string;
  source: string;
}> = {
  en: {
    eyebrow: 'Living Language Pulse',
    heading: 'What changed should become orientation.',
    body: 'Sounio moves quickly. This pulse keeps the public surface tied to checked artifacts, gate health, known limits, and a clear path for skeptical verification.',
    metrics: 'Current signals',
    signal: 'Default entry',
    attention: 'Needs attention',
    plan: 'Read the operating plan',
    source: 'source',
  },
  pt: {
    eyebrow: 'Pulso da Linguagem Viva',
    heading: 'O que muda precisa virar orientação.',
    body: 'Sounio se move rápido. Este pulso mantém a superfície pública ligada a artefatos verificados, saúde dos gates, limites conhecidos e um caminho claro para verificação cética.',
    metrics: 'Sinais atuais',
    signal: 'Entrada padrão',
    attention: 'Precisa de atenção',
    plan: 'Ler o plano operacional',
    source: 'fonte',
  },
  es: {
    eyebrow: 'Pulso del Lenguaje Vivo',
    heading: 'Lo que cambia debe convertirse en orientación.',
    body: 'Sounio se mueve rápido. Este pulso mantiene la superficie pública ligada a artefactos verificados, salud de puertas, límites conocidos y un camino claro para la verificación escéptica.',
    metrics: 'Señales actuales',
    signal: 'Entrada predeterminada',
    attention: 'Necesita atención',
    plan: 'Leer el plan operativo',
    source: 'fuente',
  },
  el: {
    eyebrow: 'Παλμός ζωντανής γλώσσας',
    heading: 'Ό,τι αλλάζει πρέπει να γίνεται προσανατολισμός.',
    body: 'Το Sounio κινείται γρήγορα. Αυτός ο παλμός κρατά τη δημόσια επιφάνεια δεμένη με ελεγμένα artifacts, υγεία gates, γνωστά όρια και καθαρό μονοπάτι επαλήθευσης.',
    metrics: 'Τρέχοντα σήματα',
    signal: 'Προεπιλεγμένη είσοδος',
    attention: 'Χρειάζεται προσοχή',
    plan: 'Διαβάστε το επιχειρησιακό πλάνο',
    source: 'πηγή',
  },
  zh: {
    eyebrow: '活语言脉搏',
    heading: '变化应当变成方向感。',
    body: 'Sounio 发展很快。这个脉搏把公共界面连接到已检查产物、门控健康、已知边界，以及清晰的验证路径。',
    metrics: '当前信号',
    signal: '默认入口',
    attention: '需要关注',
    plan: '阅读运行计划',
    source: '来源',
  },
  'zh-hk': {
    eyebrow: '活語言脈搏',
    heading: '改變要變成方向感。',
    body: 'Sounio 發展得快。呢個脈搏將公共介面連到已檢查產物、門控健康、已知邊界，以及清晰嘅驗證路徑。',
    metrics: '當前信號',
    signal: '預設入口',
    attention: '需要關注',
    plan: '閱讀運作計劃',
    source: '來源',
  },
  ja: {
    eyebrow: 'Living Language Pulse',
    heading: '変化は、方向感覚に変わるべきです。',
    body: 'Sounio は速く動きます。このパルスは、公開面を検証済みアーティファクト、ゲート状態、既知の限界、明確な検証経路につなぎます。',
    metrics: '現在のシグナル',
    signal: 'デフォルト入口',
    attention: '注意が必要',
    plan: '運用計画を読む',
    source: 'ソース',
  },
};

const d = copy[locale] ?? copy.en;
const { metrics, versions, defaultWorkflow, honestStatus } = publicContract;
const stdlib = metrics.stdlibReliabilityGate;
const sourceFileCount = metrics.selfHostedSourceFiles;
const sourceLineCount = metrics.selfHostedSourceLines;

const signals = [
  {
    label: stdlib.label,
    value: `${stdlib.pass}/${stdlib.total}`,
    note: `FAIL=${stdlib.fail}`,
  },
  {
    label: 'Checked artifact',
    value: versions.checkedArtifact,
    note: defaultWorkflow.launcher,
  },
  {
    label: 'Self-hosted source',
    value: sourceFileCount == null ? 'inventory pending' : `${sourceFileCount}`,
    note: sourceLineCount == null ? 'line count unavailable' : `${sourceLineCount.toLocaleString('en-US')} lines`,
  },
];

const attentionItems = honestStatus.missing;
---

<section class="llp-section section-shell">
  <div class="container llp-grid">
    <div class="llp-intro">
      <span class="badge-pill">{d.eyebrow}</span>
      <h2>{d.heading}</h2>
      <p>{d.body}</p>
      <a href={getLocalizedPath('/plan', locale)} class="llp-link">{d.plan}</a>
    </div>

    <div class="llp-panel">
      <div class="llp-panel-head">
        <p>{d.metrics}</p>
        <span>{d.source}: artifactStatus.ts</span>
      </div>

      <div class="llp-signals">
        {signals.map((item) => (
          <article class="llp-signal">
            <p class="llp-signal-label">{item.label}</p>
            <p class="llp-signal-value">{item.value}</p>
            <p class="llp-signal-note">{item.note}</p>
          </article>
        ))}
      </div>

      <div class="llp-two-col">
        <article class="llp-entry">
          <p class="llp-entry-label">{d.signal}</p>
          <h3>{defaultWorkflow.backend}</h3>
          <p>{defaultWorkflow.summary}</p>
        </article>

        <article class="llp-entry llp-entry-warn">
          <p class="llp-entry-label">{d.attention}</p>
          <ul>
            {attentionItems.map((item) => (
              <li>
                <strong>{item.title}</strong>
                <span>{item.detail}</span>
              </li>
            ))}
          </ul>
        </article>
      </div>
    </div>
  </div>
</section>

<style>
  .llp-section {
    border-top: 1px solid var(--glass-border);
    border-bottom: 1px solid var(--glass-border);
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--color-bg-alt) 54%, transparent), transparent 65%),
      var(--color-bg);
  }

  .llp-grid {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  .llp-intro {
    display: grid;
    gap: 1rem;
    max-width: 680px;
  }

  .llp-intro h2 {
    margin: 0;
    color: var(--color-text-primary);
    font-family: var(--font-display);
    font-size: clamp(2.15rem, 5.2vw, 4.6rem);
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: 0;
  }

  .llp-intro p {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: clamp(1rem, 2vw, 1.16rem);
    line-height: 1.72;
  }

  .llp-link {
    justify-self: start;
    color: var(--color-accent-gold-soft);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: var(--glass-border);
    text-underline-offset: 0.28em;
  }

  .llp-link:hover {
    color: var(--color-text-primary);
    text-decoration-color: var(--color-accent-gold);
  }

  .llp-panel {
    border: 1px solid var(--glass-border);
    border-radius: 8px;
    background: color-mix(in srgb, var(--color-surface-frost) 82%, transparent);
    overflow: hidden;
  }

  .llp-panel-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.7rem;
    padding: 0.9rem 1rem;
    border-bottom: 1px solid var(--glass-border);
  }

  .llp-panel-head p,
  .llp-panel-head span,
  .llp-entry-label,
  .llp-signal-label,
  .llp-signal-note {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .llp-panel-head p {
    color: var(--color-accent-teal);
    font-weight: 700;
  }

  .llp-panel-head span,
  .llp-signal-note {
    color: var(--color-text-tertiary);
  }

  .llp-signals {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-bottom: 1px solid var(--glass-border);
  }

  .llp-signal {
    min-width: 0;
    padding: 1rem;
    border-right: 1px solid var(--glass-border);
  }

  .llp-signal:last-child {
    border-right: 0;
  }

  .llp-signal-label {
    color: var(--color-text-secondary);
  }

  .llp-signal-value {
    margin: 0.45rem 0;
    color: var(--color-text-primary);
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 4vw, 2.55rem);
    line-height: 1;
  }

  .llp-two-col {
    display: grid;
  }

  .llp-entry {
    padding: 1rem;
    display: grid;
    gap: 0.7rem;
  }

  .llp-entry:first-child {
    border-bottom: 1px solid var(--glass-border);
  }

  .llp-entry-label {
    color: var(--color-accent-gold-soft);
    font-weight: 700;
  }

  .llp-entry h3 {
    margin: 0;
    color: var(--color-text-primary);
    font-size: 1rem;
    letter-spacing: 0;
  }

  .llp-entry p {
    margin: 0;
    color: var(--color-text-secondary);
    line-height: 1.65;
  }

  .llp-entry ul {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .llp-entry li {
    display: grid;
    gap: 0.25rem;
  }

  .llp-entry li strong {
    color: var(--color-text-primary);
    font-size: 0.9rem;
  }

  .llp-entry li span {
    color: var(--color-text-secondary);
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .llp-entry-warn {
    border-left: 2px solid color-mix(in srgb, var(--color-accent-red) 55%, transparent);
  }

  @media (min-width: 980px) {
    .llp-grid {
      grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
      align-items: center;
    }

    .llp-two-col {
      grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    }

    .llp-entry:first-child {
      border-bottom: 0;
      border-right: 1px solid var(--glass-border);
    }
  }

  @media (max-width: 680px) {
    .llp-signals {
      grid-template-columns: 1fr;
    }

    .llp-signal {
      border-right: 0;
      border-bottom: 1px solid var(--glass-border);
    }

    .llp-signal:last-child {
      border-bottom: 0;
    }
  }
</style>
