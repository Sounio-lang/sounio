---
interface Props {
  locale?: string;
}

const locale = Astro.props.locale ?? 'en';
const isPt = locale === 'pt';

const copy = isPt
  ? {
      chapter: 'III · Instrumentos da linguagem',
      label: 'CORREDOR DE RECIBOS SECUNDÁRIOS',
      heading: 'Cinco instrumentos. Mesma disciplina de evidência.',
      body: 'Depois da álgebra exata e das imagens executáveis, estes painéis abrem superfícies menores da linguagem: diferencial, observação, zero, efeitos e borrow. Cada um carrega uma fronteira explícita; nenhum deles substitui os flagships acima.',
      count: '05 / 05',
    }
  : {
      chapter: 'III · Language instruments',
      label: 'SECONDARY RECEIPT CORRIDOR',
      heading: 'Five instruments. One standard of evidence.',
      body: 'After exact algebra and executable images, these panels open smaller language surfaces: differentiation, observation, zero, effects, and borrow. Each carries an explicit boundary; none of them replace the flagships above.',
      count: '05 / 05',
    };
---

<section class="instrument-corridor" aria-labelledby="instrument-corridor-title">
  <div class="instrument-corridor-shell">
    <p class="instrument-corridor-chapter">{copy.chapter}</p>
    <div class="instrument-corridor-grid">
      <p class="instrument-corridor-label">{copy.label}</p>
      <h2 id="instrument-corridor-title">{copy.heading}</h2>
      <div class="instrument-corridor-aside">
        <span>{copy.count}</span>
        <p>{copy.body}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .instrument-corridor {
    padding: clamp(2.8rem, 5vw, 4rem) 0 0.5rem;
    border-top: 1px solid rgba(214, 179, 90, 0.22);
    background:
      linear-gradient(180deg, rgba(7, 22, 44, 0.98), rgba(6, 17, 32, 0.92)),
      #061121;
    color: var(--color-text-primary);
  }

  .instrument-corridor-shell {
    width: min(1440px, calc(100% - 2rem));
    margin: 0 auto;
  }

  .instrument-corridor-chapter {
    margin: 0 0 1rem;
    color: var(--color-accent-gold-soft);
    font: 600 0.62rem/1.4 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .instrument-corridor-grid {
    display: grid;
    grid-template-columns: minmax(180px, 0.42fr) minmax(280px, 0.9fr) minmax(260px, 0.7fr);
    gap: clamp(1rem, 3vw, 3rem);
    align-items: end;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(214, 179, 90, 0.18);
  }

  .instrument-corridor-label {
    margin: 0;
    color: var(--color-accent-gold);
    font: 600 0.62rem/1.5 var(--font-mono);
    text-transform: uppercase;
  }

  .instrument-corridor-grid h2 {
    max-width: 14ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 4vw, 3.6rem);
    font-weight: 400;
    line-height: 0.98;
  }

  .instrument-corridor-aside {
    display: grid;
    gap: 0.75rem;
  }

  .instrument-corridor-aside span {
    color: var(--color-accent-gold);
    font: 600 0.62rem/1.4 var(--font-mono);
  }

  .instrument-corridor-aside p {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  @media (max-width: 900px) {
    .instrument-corridor-grid {
      grid-template-columns: 1fr;
      gap: 0.85rem;
    }

    .instrument-corridor-grid h2 {
      max-width: 18ch;
    }
  }
</style>
