---
import renderManifest from '../../../public/assets/generated/render/manifest.json';
import type { Locale } from '../../lib/i18n';
import SounioObservatoryStage from './SounioObservatoryStage';

interface Props { locale?: Locale; }

const locale: Locale = Astro.props.locale ?? 'en';
const isPt = locale === 'pt';

const domains = [
  {
    file: 'coverage-crystal-atelier.png',
    domain: isPt ? 'Renderer' : 'Renderer',
    title: isPt ? 'A borda também é evidência.' : 'The edge is evidence, too.',
    claim: isPt
      ? 'Quatro amostras de cobertura por pixel e profundidade fixed-point formam um estudo de material Phong inteiramente renderizado por Sounio.'
      : 'Four coverage samples per pixel and fixed-point depth form a Phong material study rendered entirely by Sounio.',
    boundary: isPt
      ? 'Recibo de raster por software; não demonstra paridade GPU nem toda orientação de geometria.'
      : 'Software-raster receipt; not a claim of GPU parity or every geometry orientation.',
    href: '/science/graphics',
  },
  {
    file: 'rapamycin-material-study.png',
    domain: isPt ? 'Moléculas' : 'Molecules',
    title: isPt ? 'A topologia atravessa o desenho.' : 'Topology survives the picture.',
    claim: isPt
      ? 'O render percorre 44 sítios de átomos pesados e 45 registros de ligações do modelo coarse de rapamicina da stdlib.'
      : 'The render traverses 44 heavy-atom sites and 45 bond records from the stdlib coarse rapamycin model.',
    boundary: isPt
      ? 'Scaffold idealizado para inspeção; não é reconstrução cristalográfica nem conformação experimental.'
      : 'Idealized inspection scaffold; not a crystallographic reconstruction or experimental conformation.',
    href: '/science/pharma',
  },
  {
    file: 'epistemic-field-atelier.png',
    domain: isPt ? 'Epistêmica' : 'Epistemics',
    title: isPt ? 'Incerteza não é uma cor secundária.' : 'Uncertainty is not a secondary color.',
    claim: isPt
      ? 'Valor, incerteza-padrão de primeira ordem e a banda de média PBox permanecem em canais visuais distintos.'
      : 'Value, first-order standard uncertainty, and the PBox mean band remain in distinct visual channels.',
    boundary: isPt
      ? 'Campo sintético; não é dado clínico, intervalo de 95% nem declaração completa de conformidade GUM.'
      : 'Synthetic field; not clinical data, a 95% interval, or a complete GUM compliance claim.',
    href: '/language#epistemic-types',
  },
  {
    file: 'causal-intervention-frontier.png',
    domain: isPt ? 'Causalidade' : 'Causality',
    title: isPt ? 'A recusa também produz um artefato.' : 'Refusal produces an artifact, too.',
    claim: isPt
      ? 'A cirurgia do(X) corta causas de X, mas o backdoor latente permanece aberto e nenhuma estimativa é emitida.'
      : 'do(X) surgery cuts causes of X, but the latent backdoor remains open and no estimate is emitted.',
    boundary: isPt
      ? 'Testemunho para este DAG fixo; não é algoritmo ID geral, descoberta de latentes ou efeito causal.'
      : 'Witness for this fixed DAG; not a general ID algorithm, latent discovery, or a causal effect.',
    href: '/science/causal',
  },
].map((domain) => {
  const asset = renderManifest.assets.find((entry) => entry.asset.endsWith(domain.file));
  if (!asset) throw new Error(`Missing observatory receipt: ${domain.file}`);
  const sourceRef = asset.source_ref ?? 'main';
  return {
    ...domain,
    publicPath: asset.public_path,
    width: asset.width,
    height: asset.height,
    source: asset.example,
    sourceHref: `https://github.com/Sounio-lang/sounio/blob/${sourceRef}/${asset.example}`,
    command: asset.command,
    engine: asset.engine ?? 'recorded asset',
    gate: asset.gate ?? 'website/scripts/render-assets.mjs',
    gateHref: asset.gate
      ? `https://github.com/Sounio-lang/sounio/blob/${sourceRef}/${asset.gate}`
      : undefined,
    receipt: asset.receipt ?? 'CHECKED_IN_RENDER',
    sha256: asset.sha256,
    renderSha256: asset.render_sha256,
    verification: asset.verification,
  };
});
---

<SounioObservatoryStage
  locale={locale}
  domains={domains}
  compilerArtifact={renderManifest.compiler_artifact}
  client:visible
/>
