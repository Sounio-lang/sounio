---

import { getLocalizedPath } from '../../lib/i18n';
import type { Locale } from '../../lib/i18n';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;

const t: Record<string, {
  label: string;
  heading: string;
  subhead: string;
  rows: { claim: string; python: string; julia: string; rust: string; sounio: string }[];
  link: string;
}> = {
  en: {
    label: 'WHY NOT PYTHON / JULIA / RUST?',
    heading: 'Other languages give you a number. Sounio gives you a number with a warranty.',
    subhead: 'The difference is not syntax. It is what the type system guarantees before any code runs.',
    rows: [
      {
        claim: 'Uncertainty propagation',
        python: 'uncertainties package (manual, runtime)',
        julia: 'Measurements.jl (library, not enforced)',
        rust: 'none — roll your own',
        sounio: 'GUM-compliant, automatic, in the type',
      },
      {
        claim: 'Confidence gates',
        python: 'assert ε >= 0.82 (runtime, optional)',
        julia: 'if ε < 0.82 error() (runtime, optional)',
        rust: 'if ε < 0.82 panic!() (runtime, optional)',
        sounio: 'where ε >= 0.82 — compile error, not a choice',
      },
      {
        claim: 'Provenance tracking',
        python: 'metadata dict (optional, ignored)',
        julia: 'custom struct (optional, ignored)',
        rust: 'custom struct (optional, ignored)',
        sounio: 'prov= field on Knowledge<T>, tracked by the compiler',
      },
      {
        claim: 'Effect declarations',
        python: 'docstring (convention)',
        julia: 'docstring (convention)',
        rust: 'unsafe (only for memory, not science)',
        sounio: 'with IO, Mut, Div, Panic, GPU — enforced at every call site',
      },
      {
        claim: 'Non-associative algebra',
        python: 'numpy (silent reassociation)',
        julia: 'custom type (no compiler check)',
        rust: 'custom type (no compiler check)',
        sounio: 'algebra Octonion — multiplication table is a type declaration',
      },
    ],
    link: 'Full comparison with citations →',
  },
};

const d = t[locale] ?? t.en;
---

<section class="journal-section relative border-y border-[var(--color-line)] px-6 py-[5.5rem]">
  <div class="relative z-[1] mx-auto grid max-w-[1100px] gap-8">
    <div class="grid gap-2.5">
      <div class="journal-section-number">§3 — The Alternative</div>
      <h2 class="wn-heading m-0 font-[var(--font-display)] text-[clamp(1.8rem,4vw,2.8rem)] font-normal leading-[1.12] tracking-[-0.015em] text-[var(--color-ink-1)]">{d.heading}</h2>
      <p class="m-0 max-w-[62ch] text-[0.95rem] leading-[1.65] text-[var(--color-ink-2)]">{d.subhead}</p>
    </div>

    <div class="wn-table overflow-x-auto rounded-[var(--radius-lg)] border border-[var(--color-line)] bg-[var(--color-surface-raise)]/50">
      <table class="w-full text-left text-[0.82rem] leading-[1.55]">
        <thead>
          <tr class="border-b border-[var(--color-line)] bg-[var(--color-surface-raise)]">
            <th class="py-4 px-4 font-mono text-[0.72rem] uppercase tracking-[0.08em] text-[var(--color-ink-3)]">Claim</th>
            <th class="py-4 px-4 font-mono text-[0.72rem] uppercase tracking-[0.08em] text-[var(--color-ink-3)]">Python</th>
            <th class="py-4 px-4 font-mono text-[0.72rem] uppercase tracking-[0.08em] text-[var(--color-ink-3)]">Julia</th>
            <th class="py-4 px-4 font-mono text-[0.72rem] uppercase tracking-[0.08em] text-[var(--color-ink-3)]">Rust</th>
            <th class="py-4 px-4 font-mono text-[0.72rem] uppercase tracking-[0.08em] text-[var(--color-accent-warning)]">Sounio</th>
          </tr>
        </thead>
        <tbody>
          {d.rows.map((row, i) => (
            <tr class={`border-b border-[var(--color-line)]/50 ${i % 2 === 0 ? 'bg-[var(--color-surface-raise)]/30' : ''}`}>
              <td class="py-4 px-4 font-medium text-[var(--color-ink-1)]">{row.claim}</td>
              <td class="py-4 px-4 text-[var(--color-ink-2)]">{row.python}</td>
              <td class="py-4 px-4 text-[var(--color-ink-2)]">{row.julia}</td>
              <td class="py-4 px-4 text-[var(--color-ink-2)]">{row.rust}</td>
              <td class="py-4 px-4 font-medium text-[var(--color-accent-warning)]">{row.sounio}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <a href={getLocalizedPath('/language#comparison', locale)} class="w-fit text-[0.85rem] text-[var(--color-accent-steel-soft)] no-underline hover:underline">
      {d.link}
    </a>
  </div>
</section>

<style>
  .wn-bg {
    position: absolute;
    inset: -10% 0;
    background-image: url('/assets/vision/act1-column.jpg');
    background-size: cover;
    background-position: center 45%;
    opacity: 0.06;
    will-change: transform;
  }

  .wn-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      var(--color-surface-base) 0%,
      color-mix(in srgb, var(--color-surface-base) 55%, transparent) 20%,
      color-mix(in srgb, var(--color-surface-base) 45%, transparent) 80%,
      var(--color-surface-base) 100%
    );
  }
</style>

<script>
  import { gsap, revealOnScroll, prefersReducedMotion } from '../../lib/motion';

  if (!prefersReducedMotion()) {
    const section = document.querySelector<HTMLElement>('.wn-section');
    const bg = document.querySelector<HTMLElement>('.wn-bg');
    if (section && bg) {
      gsap.to(bg, {
        yPercent: 15,
        ease: 'none',
        scrollTrigger: { trigger: section, start: 'top bottom', end: 'bottom top', scrub: 2 },
      });

      revealOnScroll('.wn-heading, .wn-table, .wn-section a', {
        stagger: 0.1,
        scrollTrigger: { trigger: section, start: 'top 75%', once: true },
      });
    }
  }
</script>
