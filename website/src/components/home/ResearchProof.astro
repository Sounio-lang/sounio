---
import { getLocalizedPath, getLocaleFromUrl } from '../../lib/i18n';
import { getProofData } from '../../lib/proofData';

const locale = getLocaleFromUrl(Astro.url);
const proof = getProofData();

const researchPrograms = [
  {
    status: 'Published theory track',
    title: 'Ollivier-Ricci curvature and biomedical graph work',
    detail: 'The project is under pressure from real mathematical and biomedical work, not synthetic benchmark theatre.',
  },
  {
    status: 'Active dissertation track',
    title: 'Epistemic PBPK and GUM-through-ODE validation',
    detail: 'PBPK, dosing, and uncertainty propagation keep forcing concrete compiler and runtime decisions into the open.',
  },
  {
    status: 'Exceptional algebra track',
    title: '168-theorem, Fano classification, and hypercomplex execution',
    detail: 'Non-associative and hypercomplex surfaces are not decorative. They are part of the technical burden the language is carrying.',
  },
];
---

<section class="section-shell research-proof">
  <div class="container">
    <div class="section-headline">
      <h2 class="section-heading">Research pressure, not presentation theatre.</h2>
      <p class="section-subhead">
        Sounio is being shaped by scientific programs that force uncertainty, provenance, algebra, and runtime evidence
        to stay honest. The point is not to look ambitious. The point is to survive contact with real work.
      </p>
    </div>

    <div class="research-grid">
      <article class="glass glass-specular research-card">
        <span class="section-kicker">Research pressure</span>
        <div class="research-list">
          {researchPrograms.map((program) => (
            <article class="research-entry">
              <span class="research-status">{program.status}</span>
              <h3>{program.title}</h3>
              <p>{program.detail}</p>
            </article>
          ))}
        </div>
        <div class="research-actions">
          <a href={getLocalizedPath('/science', locale)}>Browse research programs</a>
          <a href={getLocalizedPath('/learn/feature-status', locale)}>Read the current feature status</a>
        </div>
      </article>

      <div class="status-stack">
        <article class="glass glass-specular status-card">
          <span class="section-kicker">Current verified state</span>
          <div class="status-grid">
            <div>
              <strong>v{proof.release.version}</strong>
              <span>{proof.release.statusLabel}</span>
            </div>
            <div>
              <strong>{proof.gpu.publicPassCount}/{proof.gpu.publicCheckCount}</strong>
              <span>public GPU checks passing</span>
            </div>
            <div>
              <strong>{proof.stdlib.passCount}/{proof.stdlib.totalCount}</strong>
              <span>stdlib reliability fixtures passing</span>
            </div>
            <div>
              <strong>{proof.stdlib.hyperPassCount}/{proof.stdlib.hyperTotalCount}</strong>
              <span>required hyper lanes passing</span>
            </div>
          </div>
        </article>

        <article class="glass status-card">
          <span class="section-kicker">Known boundaries</span>
          <ul class="boundary-list">
            {proof.boundaries.map((boundary) => (
              <li>{boundary}</li>
            ))}
          </ul>
          <a class="status-link" href={getLocalizedPath('/proof', locale)}>Inspect sources and boundaries</a>
        </article>
      </div>
    </div>
  </div>
</section>

<style>
  .research-grid {
    display: grid;
    gap: 1rem;
  }

  .research-card,
  .status-card {
    border-radius: var(--radius-xl);
    padding: 1.15rem;
    display: grid;
    gap: 0.85rem;
  }

  .section-kicker {
    color: var(--color-accent-gold-soft);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .research-list {
    display: grid;
    gap: 0.8rem;
  }

  .research-entry {
    display: grid;
    gap: 0.2rem;
    padding-top: 0.8rem;
    border-top: 1px solid color-mix(in srgb, var(--glass-border) 75%, transparent);
  }

  .research-entry:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .research-status {
    color: var(--color-text-tertiary);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .research-entry h3 {
    font-size: 1.08rem;
    color: var(--color-text-primary);
  }

  .research-entry p {
    color: var(--color-text-secondary);
    font-size: 0.9rem;
  }

  .research-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .research-actions a,
  .status-link {
    width: fit-content;
    color: var(--color-text-primary);
    font-size: 0.84rem;
    font-weight: 650;
    border-bottom: 1px solid color-mix(in srgb, var(--color-accent-gold) 42%, transparent);
    padding-bottom: 0.15rem;
  }

  .status-stack {
    display: grid;
    gap: 1rem;
  }

  .status-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
  }

  .status-grid strong {
    display: block;
    color: var(--color-text-primary);
    font-family: var(--font-display);
    font-size: 1.42rem;
  }

  .status-grid span {
    color: var(--color-text-secondary);
    font-size: 0.78rem;
  }

  .boundary-list {
    margin: 0;
    padding-left: 1rem;
    color: var(--color-text-secondary);
    display: grid;
    gap: 0.45rem;
  }

  @media (min-width: 1024px) {
    .research-grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      align-items: start;
    }
  }
</style>
