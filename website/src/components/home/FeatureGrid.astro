---
import { loadTranslations, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = await loadTranslations(locale);

const features = [
  {
    title: 'Epistemic Uncertainty',
    description: 'Every measurement carries doubt. Uncertainty and provenance are propagated automatically through type system rules.',
    accent: 'var(--color-accent-blue)',
    size: 'large',
    code: `let c: Knowledge<f64> = Knowledge(
  9.8, 
  ε=0.97, 
  prov="lab_run_042"
)
let derived = c * 2.5  // uncertainty auto-propagates`,
    iconSvg: `<path d="M7.5 4.5L6 4.5L6 19.5L7.5 19.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M16.5 4.5L18 4.5L18 19.5L16.5 19.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><line x1="12" y1="8" x2="12" y2="13.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle cx="12" cy="16.5" r="1.25" fill="currentColor"/>`,
  },
  {
    title: 'Causal Types',
    description: 'Intervention<T> and Counterfactual<T> are compiler-level types. Epistemic confidence tracks through causal operations via the stdlib DAG API.',
    accent: 'var(--color-accent-teal)',
    size: 'large',
    code: `var dag = causal_dag_new()
dag = dag_add_node(dag, 0)  // treatment
dag = dag_add_node(dag, 1)  // outcome
let intervened = do_intervention(dag, 1)`,
    iconSvg: `<circle cx="12" cy="4.5" r="2" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="7" cy="12" r="1.75" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.7"/><circle cx="17" cy="12" r="1.75" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.7"/><circle cx="4" cy="19.5" r="1.25" fill="none" stroke="currentColor" stroke-width="1.25" opacity="0.5"/><circle cx="10" cy="19.5" r="1.25" fill="none" stroke="currentColor" stroke-width="1.25" opacity="0.5"/><circle cx="20" cy="19.5" r="1.25" fill="none" stroke="currentColor" stroke-width="1.25" opacity="0.5"/><line x1="12" y1="6.5" x2="8.25" y2="10.25" stroke="currentColor" stroke-width="1" opacity="0.5"/><line x1="12" y1="6.5" x2="15.75" y2="10.25" stroke="currentColor" stroke-width="1" opacity="0.5"/><line x1="6.25" y1="13.75" x2="4.75" y2="18.25" stroke="currentColor" stroke-width="1" opacity="0.4"/><line x1="7.75" y1="13.75" x2="9.25" y2="18.25" stroke="currentColor" stroke-width="1" opacity="0.4"/><line x1="17.75" y1="13.75" x2="19.25" y2="18.25" stroke="currentColor" stroke-width="1" opacity="0.35"/>`,
  },
  {
    title: 'Linear Types',
    description: 'Resource safety via move semantics. File handles, connections, locks — use exactly once.',
    accent: 'var(--color-accent-red)',
    size: 'small',
    iconSvg: `<path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>`,
  },
  {
    title: 'Systems Performance',
    description: 'Fast compiler architecture suitable for tight iteration loops and scientific performance needs.',
    accent: 'var(--color-accent-orange)',
    size: 'small',
    iconSvg: `<path stroke-linecap="round" stroke-linejoin="round" d="M8.25 3v1.5M4.5 8.25H3m18 0h-1.5M4.5 12H3m18 0h-1.5m-15 3.75H3m18 0h-1.5M8.25 19.5V21M12 3v1.5m0 15V21m3.75-18v1.5m0 15V21m-9-1.5h10.5a2.25 2.25 0 002.25-2.25V6.75a2.25 2.25 0 00-2.25-2.25H6.75A2.25 2.25 0 004.5 6.75v10.5a2.25 2.25 0 002.25 2.25zm.75-12h9v9h-9v-9z"/>`,
  },
  {
    title: 'Scientific Ontology',
    description: 'Ontology modules for SNOMED, GO, HPO, LOINC in the standard library. Type-level integration planned for 2026.',
    accent: 'var(--color-accent-teal)',
    size: 'small',
    iconSvg: `<path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/>`,
  },
  {
    title: 'Refinement Types',
    description: 'Refinement predicates checked at compile time. SMT solver integration planned for 2026.',
    accent: 'var(--color-accent-purple)',
    size: 'small',
    iconSvg: `<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>`,
  },
  {
    title: 'Kretikos GPU',
    description: 'GPU compiler lane with checked thread builtins, deterministic CPU fallback, in-tree PTX/CUBIN templates, and artifact bundles.',
    accent: 'var(--color-accent-gold)',
    size: 'small',
    code: `kernel fn vec_add(n: i64) with GPU {
    let tid = gpu_thread_id_x()
    let bid = gpu_block_id_x()
    let bdim = gpu_block_dim_x()
    let i = bid * bdim + tid
    if i < n {
        // Checked 1D thread-indexing surface
    }
    gpu_sync_threads()
}`,
    iconSvg: `<rect x="3" y="3" width="7" height="7" rx="1" fill="none" stroke="currentColor" stroke-width="1.5"/><rect x="14" y="3" width="7" height="7" rx="1" fill="none" stroke="currentColor" stroke-width="1.5"/><rect x="3" y="14" width="7" height="7" rx="1" fill="none" stroke="currentColor" stroke-width="1.5"/><rect x="14" y="14" width="7" height="7" rx="1" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="6.5" cy="6.5" r="1" fill="currentColor"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/><circle cx="6.5" cy="17.5" r="1" fill="currentColor"/><circle cx="17.5" cy="17.5" r="1" fill="currentColor"/>`,
  },
];
---

<section id="features" class="py-[clamp(3.5rem,7vw,6rem)] bg-[var(--color-bg)]">
  <div class="container px-4">
    <div class="mb-[2.4rem] grid gap-[0.5rem]">
      <h2 class="font-sans text-[clamp(1.7rem,4.2vw,3rem)] font-[750] leading-[1.1] tracking-[-0.025em] text-[var(--color-text-primary)]">
        {t.section_why_title}
      </h2>
      <p class="text-[clamp(0.96rem,2.1vw,1.1rem)] text-[var(--color-text-secondary)] max-w-[68ch]">
        {t.section_why_description}
      </p>
    </div>

    <div class="bento-grid">
      {features.map((feature) => (
        <article
          class={`glass glass-specular rounded-2xl p-8 transition-transform duration-300 hover:scale-[1.01] ${feature.size === 'large' ? 'bento-large' : 'bento-small'}`}
        >
          <div
            class="inline-flex items-center justify-center w-12 h-12 rounded-xl mb-6"
            style={`background: color-mix(in srgb, ${feature.accent} 10%, transparent);`}
          >
            <svg class="w-6 h-6" style={`color: ${feature.accent};`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" set:html={feature.iconSvg}></svg>
          </div>

          <h3 class="text-xl font-semibold text-[var(--color-text-primary)] mb-3">
            {feature.title}
          </h3>

          <p class="text-[var(--color-text-secondary)] text-sm leading-relaxed mb-6">
            {feature.description}
          </p>

          {feature.code && (
            <pre class="text-xs leading-relaxed overflow-x-auto rounded-lg bg-[#0d1117] p-4 border border-[var(--glass-border)]"><code class="text-[#e6edf3]">{feature.code}</code></pre>
          )}
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .bento-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .bento-large {
    grid-column: span 2;
  }

  .bento-small {
    grid-column: span 1;
  }

  @media (max-width: 1024px) {
    .bento-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .bento-large {
      grid-column: span 2;
    }
  }

  @media (max-width: 640px) {
    .bento-grid {
      grid-template-columns: 1fr;
    }
    .bento-large,
    .bento-small {
      grid-column: span 1;
    }
  }
</style>
