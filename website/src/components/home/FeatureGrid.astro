---
import { getLocalizedPath, loadTranslations, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = await loadTranslations(locale);

const features = [
  {
    title: t.feature_uncertainty_title,
    description: t.feature_uncertainty_desc,
    icon: 'uncertainty',
    gradient: 'from-amber-500 to-orange-600',
    iconBg: 'bg-amber-500/10',
    iconColor: 'text-amber-500',
  },
  {
    title: t.feature_propagation_title,
    description: t.feature_propagation_desc,
    icon: 'propagation',
    gradient: 'from-emerald-500 to-teal-600',
    iconBg: 'bg-emerald-500/10',
    iconColor: 'text-emerald-500',
  },
  {
    title: t.feature_provenance_title,
    description: t.feature_provenance_desc,
    icon: 'provenance',
    gradient: 'from-blue-500 to-indigo-600',
    iconBg: 'bg-blue-500/10',
    iconColor: 'text-blue-500',
  },
  {
    title: t.feature_confidence_title,
    description: t.feature_confidence_desc,
    icon: 'confidence',
    gradient: 'from-purple-500 to-pink-600',
    iconBg: 'bg-purple-500/10',
    iconColor: 'text-purple-500',
  },
  {
    title: t.feature_domain_title,
    description: t.feature_domain_desc,
    icon: 'domain',
    gradient: 'from-cyan-500 to-blue-600',
    iconBg: 'bg-cyan-500/10',
    iconColor: 'text-cyan-500',
  },
  {
    title: t.feature_standards_title,
    description: t.feature_standards_desc,
    icon: 'standards',
    gradient: 'from-rose-500 to-red-600',
    iconBg: 'bg-rose-500/10',
    iconColor: 'text-rose-500',
  },
];

const iconPaths: Record<string, string> = {
  uncertainty: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  propagation: 'M13 10V3L4 14h7v7l9-11h-7z',
  provenance: 'M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1',
  confidence: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z',
  domain: 'M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z',
  standards: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01',
};
---

<section id="features" class="relative py-32 overflow-hidden">
  <!-- Background -->
  <div class="absolute inset-0 bg-gradient-to-b from-[#0a0f1a] via-[var(--color-bg)] to-[var(--color-bg)]"></div>

  <!-- Decorative elements -->
  <div class="absolute top-0 left-1/4 w-96 h-96 bg-[var(--color-gold-500)]/5 rounded-full blur-3xl"></div>
  <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-purple-500/5 rounded-full blur-3xl"></div>

  <div class="relative container px-4">
    <!-- Section header -->
    <div class="text-center mb-20">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[var(--color-gold-500)]/10 text-[var(--color-gold-500)] text-sm font-medium mb-6">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        Why Sounio?
      </div>
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-[var(--color-navy-900)] dark:text-white mb-6">
        {t.section_why_title}
      </h2>
      <p class="text-lg md:text-xl text-[var(--color-text-muted)] max-w-3xl mx-auto leading-relaxed">
        {t.section_why_description}
      </p>
    </div>

    <!-- Features grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {features.map((feature, index) => (
        <article
          class="feature-card group relative"
          style={`--delay: ${index * 0.1}s`}
        >
          <!-- Gradient border effect -->
          <div class={`absolute -inset-0.5 bg-gradient-to-r ${feature.gradient} rounded-2xl opacity-0 group-hover:opacity-100 blur transition-all duration-500`}></div>

          <!-- Card content -->
          <div class="relative h-full p-8 bg-white dark:bg-[#0d1117] rounded-2xl border border-gray-200 dark:border-white/10 transition-all duration-300 group-hover:border-transparent">
            <!-- Icon -->
            <div class={`inline-flex items-center justify-center w-14 h-14 ${feature.iconBg} rounded-xl mb-6 transition-transform duration-300 group-hover:scale-110`}>
              <svg class={`w-7 h-7 ${feature.iconColor}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d={iconPaths[feature.icon]} />
              </svg>
            </div>

            <!-- Title -->
            <h3 class="text-xl font-semibold text-[var(--color-navy-900)] dark:text-white mb-3 group-hover:text-[var(--color-orange-500)] transition-colors">
              {feature.title}
            </h3>

            <!-- Description -->
            <p class="text-[var(--color-text-muted)] leading-relaxed">
              {feature.description}
            </p>

            <!-- Hover arrow -->
            <div class="absolute bottom-8 right-8 opacity-0 group-hover:opacity-100 transform translate-x-2 group-hover:translate-x-0 transition-all duration-300">
              <svg class="w-5 h-5 text-[var(--color-orange-500)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Bottom highlight -->
    <div class="mt-20 text-center">
      <div class="inline-flex flex-col sm:flex-row items-center gap-4 sm:gap-8 p-6 sm:p-8 bg-gradient-to-r from-[var(--color-gold-500)]/5 via-purple-500/5 to-emerald-500/5 rounded-2xl border border-white/10">
        <div class="flex items-center gap-3">
          <div class="flex -space-x-2">
            <div class="w-10 h-10 rounded-full bg-gradient-to-br from-amber-400 to-orange-500 flex items-center justify-center text-white font-bold text-sm border-2 border-white dark:border-[#0d1117]">GUM</div>
            <div class="w-10 h-10 rounded-full bg-gradient-to-br from-emerald-400 to-teal-500 flex items-center justify-center text-white font-bold text-sm border-2 border-white dark:border-[#0d1117]">SI</div>
            <div class="w-10 h-10 rounded-full bg-gradient-to-br from-blue-400 to-indigo-500 flex items-center justify-center text-white font-bold text-sm border-2 border-white dark:border-[#0d1117]">ISO</div>
          </div>
          <span class="text-[var(--color-text-muted)]">Standards Compliant</span>
        </div>
        <div class="hidden sm:block w-px h-8 bg-white/20"></div>
        <a href={getLocalizedPath('/docs/spec', locale)} class="inline-flex items-center gap-2 text-[var(--color-gold-500)] font-medium hover:gap-3 transition-all">
          Learn about our standards compliance
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .feature-card {
    animation: fadeInUp 0.6s ease forwards;
    animation-delay: var(--delay);
    opacity: 0;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Intersection observer will trigger this */
  .feature-card.visible {
    animation: fadeInUp 0.6s ease forwards;
  }
</style>

<script>
  // Optional: Add intersection observer for scroll-triggered animations
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    },
    { threshold: 0.1 }
  );

  document.querySelectorAll('.feature-card').forEach((card) => {
    observer.observe(card);
  });
</script>
