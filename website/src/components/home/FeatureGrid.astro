---
import { loadTranslations, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = await loadTranslations(locale);

const features = [
  {
    title: t.feature_uncertainty_title,
    description: t.feature_uncertainty_desc,
    icon: '🎯',
  },
  {
    title: t.feature_propagation_title,
    description: t.feature_propagation_desc,
    icon: '📊',
  },
  {
    title: t.feature_provenance_title,
    description: t.feature_provenance_desc,
    icon: '🔗',
  },
  {
    title: t.feature_confidence_title,
    description: t.feature_confidence_desc,
    icon: '🚦',
  },
  {
    title: t.feature_domain_title,
    description: t.feature_domain_desc,
    icon: '🧬',
  },
  {
    title: t.feature_standards_title,
    description: t.feature_standards_desc,
    icon: '📋',
  },
];
---

<section id="features" class="py-24 bg-gradient-to-r from-[var(--color-navy-900)]/5 to-[var(--color-orange-500)]/5">
  <div class="container">
    <h2 class="text-4xl font-semibold text-center mb-4 text-[var(--color-navy-900)] dark:text-white">
      {t.section_why_title}
    </h2>
    <p class="text-lg text-center text-[var(--color-text-muted)] mb-16 max-w-3xl mx-auto">
      {t.section_why_description}
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {features.map((feature, index) => (
        <article
          class="group p-6 bg-white dark:bg-[var(--color-bg-alt)] rounded-xl shadow-md hover:shadow-xl transition-all duration-300 border-l-4 border-[var(--color-gold-500)] hover:-translate-y-1"
          style={`animation-delay: ${index * 100}ms`}
        >
          <div class="text-3xl mb-4 group-hover:scale-110 transition-transform duration-300">
            {feature.icon}
          </div>
          <h3 class="text-xl font-semibold text-[var(--color-orange-500)] mb-3">
            {feature.title}
          </h3>
          <p class="text-[var(--color-text-muted)] leading-relaxed">
            {feature.description}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>
