---
import type { Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const copy = {
  en: {
    eyebrow: 'Spectrum plates',
    title: 'What a value knows, drawn.',
    lede: 'Four seamless loops rendered from the same mathematics the language is about: fields, distributions, effects and their interference. Each hue is one algebraic effect (or linearity), and it always appears beside its name.',
    note: 'Rendered offline (C++23 and Node canvas, 30 fps). The loops pause when out of view and are replaced by still frames when reduced motion is requested.',
    plates: [
      { id: 'field', numeral: 'I', title: 'Μέτρον ἄριστον', sub: 'Epistemic topography', caption: 'Isolines of a slowly folding field. Gold marks the measure; a single teal contour holds the threshold.', effects: [] as string[] },
      { id: 'uncertainty-fan', numeral: 'II', title: 'Monte Carlo fan', sub: '520 trajectories', caption: 'Each path coloured by the quantile it ends in. Gold is the mean; the dashed pair is ±1σ, widening honestly with time.', effects: ['Prob'] },
      { id: 'vortex', numeral: 'III', title: 'Effect lattice vortex', sub: 'Nine effects and linearity, one eye', caption: 'The nine public effects and linearity as level sets of a logarithmic spiral. At the centre, the gold eye: a pure computation.', effects: ['IO', 'Mut', 'Div', 'Panic', 'Alloc', 'Async', 'GPU', 'Prob', 'Observe', 'linear'] },
      { id: 'interference', numeral: 'IV', title: 'Interference', sub: 'Three sources', caption: 'Three wave sources superposed. Every isoline takes the next effect hue, so composition becomes visible.', effects: ['IO', 'Mut', 'Div'] },
    ],
  },
  pt: {
    eyebrow: 'Pranchas do espectro',
    title: 'O que um valor sabe, desenhado.',
    lede: 'Quatro loops contínuos renderizados a partir da mesma matemática de que a linguagem trata: campos, distribuições, efeitos e sua interferência. Cada matiz é um efeito algébrico (ou a linearidade) e sempre aparece ao lado do seu nome.',
    note: 'Renderizados offline (C++23 e Node canvas, 30 fps). Os loops pausam fora da tela e viram quadros estáticos quando o movimento reduzido é solicitado.',
    plates: [
      { id: 'field', numeral: 'I', title: 'Μέτρον ἄριστον', sub: 'Topografia epistêmica', caption: 'Isolinhas de um campo que se dobra lentamente. O ouro marca a medida; um único contorno teal sustenta o limiar.', effects: [] as string[] },
      { id: 'uncertainty-fan', numeral: 'II', title: 'Leque de Monte Carlo', sub: '520 trajetórias', caption: 'Cada trajetória colorida pelo quantil em que termina. O ouro é a média; o par tracejado é ±1σ, alargando-se honestamente com o tempo.', effects: ['Prob'] },
      { id: 'vortex', numeral: 'III', title: 'Vórtice do reticulado', sub: 'Nove efeitos e a linearidade, um olho', caption: 'Os nove efeitos públicos e a linearidade como conjuntos de nível de uma espiral logarítmica. No centro, o olho dourado: uma computação pura.', effects: ['IO', 'Mut', 'Div', 'Panic', 'Alloc', 'Async', 'GPU', 'Prob', 'Observe', 'linear'] },
      { id: 'interference', numeral: 'IV', title: 'Interferência', sub: 'Três fontes', caption: 'Três fontes de onda superpostas. Cada isolinha assume o próximo matiz de efeito, e a composição se torna visível.', effects: ['IO', 'Mut', 'Div'] },
    ],
  },
};

const d = copy[locale === 'pt' ? 'pt' : 'en'];

const hue: Record<string, string> = {
  IO: 'var(--spectrum-01-io)', Mut: 'var(--spectrum-02-mut)', Div: 'var(--spectrum-03-div)', Panic: 'var(--spectrum-04-panic)',
  Alloc: 'var(--spectrum-05-alloc)', Async: 'var(--spectrum-06-async)', GPU: 'var(--spectrum-07-gpu)', Prob: 'var(--spectrum-08-prob)',
  Observe: 'var(--spectrum-09-observe)', linear: 'var(--spectrum-10-linear)',
};
---

<section class="plates spectrum-surface sx-section" aria-labelledby="plates-title">
  <div class="container">
    <header class="sx-section-head">
      <p class="sx-eyebrow plates-eyebrow">{d.eyebrow}</p>
      <h2 id="plates-title" class="sx-h2 plates-title">{d.title}</h2>
      <p class="sx-lede plates-lede">{d.lede}</p>
    </header>

    <ol class="plates-grid">
      {d.plates.map((p) => (
        <li class="plate">
          <figure>
            <div class="plate-frame">
              <video
                class="plate-video"
                muted
                loop
                playsinline
                preload="none"
                poster={`/media/sounio-${p.id}.webp`}
                data-src={`/media/sounio-${p.id}.mp4`}
                aria-label={`${p.title}: ${p.caption}`}
                width="720"
                height="900"
              ></video>
              <span class="plate-numeral" aria-hidden="true">{p.numeral}</span>
            </div>
            <figcaption>
              <p class="plate-sub">{p.sub}</p>
              <h3 class="plate-title">{p.title}</h3>
              <p class="plate-caption">{p.caption}</p>
              {p.effects.length > 0 && (
                <ul class="plate-effects" aria-label="Effects">
                  {p.effects.map((e) => (
                    <li style={`--hue:${hue[e]}`}>{e}</li>
                  ))}
                </ul>
              )}
            </figcaption>
          </figure>
        </li>
      ))}
    </ol>

    <p class="plates-note">{d.note}</p>
  </div>
</section>

<style>
  .plates {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    overflow: hidden;
  }

  .plates-eyebrow { color: #EBD6A2; }
  .plates-title { color: #FFFFFF; margin: 0; }
  .plates-lede { color: rgba(255, 255, 255, 0.74); margin: 0; }

  .plates-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.75rem);
  }

  .plate figure { margin: 0; display: grid; gap: 1.1rem; }

  .plate-frame {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: #05080E;
    border: 1px solid rgba(255, 255, 255, 0.10);
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.8);
    transition: transform 0.6s var(--ease-out), border-color 0.4s ease, box-shadow 0.6s var(--ease-out);
  }

  .plate:hover .plate-frame {
    transform: translateY(-6px);
    border-color: rgba(214, 179, 90, 0.55);
    box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.9), 0 0 0 1px rgba(214, 179, 90, 0.25);
  }

  .plate-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .plate-numeral {
    position: absolute;
    top: 0.85rem;
    left: 1rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    color: #EBD6A2;
    text-shadow: 0 1px 12px rgba(5, 8, 14, 0.9);
  }

  .plate-sub {
    margin: 0;
    font: 700 0.75rem/1 var(--font-sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.66);
  }

  .plate-title {
    margin: 0.45rem 0 0.4rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.6rem;
    letter-spacing: 0;
    line-height: 1.1;
    color: #FFFFFF;
  }

  .plate-caption {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.72);
  }

  .plate-effects {
    list-style: none;
    margin: 0.85rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.75rem;
  }

  .plate-effects li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font: 500 0.75rem/1 var(--font-mono);
    color: rgba(255, 255, 255, 0.80);
    font-variant-ligatures: none;
  }

  .plate-effects li::before {
    content: '';
    width: 14px;
    height: 3px;
    border-radius: 2px;
    background: var(--hue);
    box-shadow: 0 0 8px var(--hue);
  }

  .plates-note {
    margin: clamp(2rem, 4vw, 3rem) 0 0;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.60);
    max-width: 70ch;
  }

  @media (max-width: 1100px) {
    .plates-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 2.5rem; }
  }

  @media (max-width: 560px) {
    .plates-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  function wirePlates() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const videos = document.querySelectorAll<HTMLVideoElement>('.plate-video[data-src]');
    const io = new IntersectionObserver((entries) => {
      for (const { target, isIntersecting } of entries) {
        const v = target as HTMLVideoElement;
        if (isIntersecting) {
          if (!v.src && v.dataset.src) v.src = v.dataset.src;
          v.play().catch(() => {});
        } else {
          v.pause();
        }
      }
    }, { rootMargin: '200px 0px' });
    videos.forEach((v) => io.observe(v));
  }
  document.addEventListener('astro:page-load', wirePlates);
</script>
