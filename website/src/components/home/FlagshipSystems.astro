---
import { getLocalizedPath, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const systems = [
  {
    pillar: 'Acceleration',
    title: 'GPU',
    href: '/science/gpu',
    eyebrow: 'GPU / PTX',
    art: '/assets/vision/act3-fractal.jpg',
    summary: 'Computation under pressure.',
    proves: 'PTX live',
    limit: 'More lanes to ship.',
  },
  {
    pillar: 'Refusal',
    title: 'Climate',
    href: '/science/climate',
    eyebrow: 'Climate / Ensemble bounds',
    art: '/assets/vision/act2-poseidon.jpg',
    summary: 'Refusal when the envelope breaks.',
    proves: 'Refusal intact',
    limit: 'Not a forecast product.',
  },
  {
    pillar: 'Diagnosis',
    title: 'Neuroimaging',
    href: '/science/neuroimaging',
    eyebrow: 'Neuro / Signal quality',
    art: '/assets/original-artworks/yiayia_hero_1280.webp',
    summary: 'Weak signal without false certainty.',
    proves: 'Uncertainty intact',
    limit: 'Not clinical deployment.',
  },
];
---

<section class="section-shell section-deferred">
  <div class="container grid gap-[1rem]">
    <div class="grid gap-[0.24rem] max-w-[36rem]">
      <p class="text-[0.76rem] uppercase tracking-[0.12em] text-[var(--color-accent-gold-soft)]">Pressure surfaces</p>
      <h2 class="text-[clamp(1.55rem,2.7vw,2.15rem)] font-semibold text-[var(--color-text-primary)] leading-[1.02] text-balance">
        GPU. Climate. Neuro.
      </h2>
    </div>

    <div class="premium-grid grid gap-4 lg:grid-cols-[1.2fr_0.8fr]">
      <article class="group overflow-hidden rounded-[2rem] border border-white/8 bg-[linear-gradient(180deg,rgba(255,255,255,0.06),rgba(255,255,255,0.02))] lg:min-h-[42rem]">
        <div
          class="relative min-h-[27rem] bg-cover bg-center transition-transform duration-700 ease-out group-hover:scale-[1.015] lg:min-h-[42rem]"
          style={`background-image: linear-gradient(180deg, rgba(5, 12, 24, 0.02), rgba(5, 12, 24, 0.88)), url('${systems[0].art}');`}
        >
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_62%_24%,rgba(214,179,90,0.16),transparent_26%),radial-gradient(circle_at_22%_32%,rgba(43,166,179,0.14),transparent_30%)]"></div>
          <div class="absolute inset-x-0 top-0 flex items-center justify-between gap-3 p-[1.15rem] lg:p-[1.35rem]">
            <span class="rounded-full border border-white/12 bg-black/22 px-[0.7rem] py-[0.24rem] text-[0.72rem] uppercase tracking-[0.08em] text-white/78 backdrop-blur-md">
              {systems[0].eyebrow}
            </span>
            <span class="text-[0.8rem] font-semibold text-[var(--color-accent-gold-soft)]">{systems[0].pillar}</span>
          </div>
          <a href={getLocalizedPath(systems[0].href, locale)} class="absolute inset-0" aria-label={`Open ${systems[0].title}`}></a>
          <div class="absolute inset-x-0 bottom-0 grid gap-[0.8rem] p-[1.2rem] lg:p-[1.6rem]">
            <div class="grid gap-[0.26rem]">
              <h3 class="max-w-[8ch] text-[clamp(3rem,5.5vw,5rem)] font-semibold leading-[0.9] text-white text-balance">
                {systems[0].title}
              </h3>
              <p class="max-w-[26ch] text-[0.95rem] leading-[1.45] text-white/70">{systems[0].summary}</p>
            </div>
            <div class="flex flex-wrap items-center gap-[0.52rem] text-[0.7rem] uppercase tracking-[0.08em] text-white/72">
              <span class="rounded-full border border-white/12 bg-black/20 px-[0.58rem] py-[0.22rem] backdrop-blur-md">{systems[0].proves}</span>
              <span class="rounded-full border border-white/10 bg-white/6 px-[0.58rem] py-[0.22rem] text-white/62">{systems[0].limit}</span>
              <span class="ml-auto text-[var(--color-accent-gold-soft)]">Enter route →</span>
            </div>
          </div>
        </div>
      </article>

      <div class="grid gap-4">
        {systems.slice(1).map((system) => (
          <article class="group overflow-hidden rounded-[1.7rem] border border-white/8 bg-[linear-gradient(180deg,rgba(255,255,255,0.05),rgba(255,255,255,0.02))]">
            <div
              class="relative min-h-[18rem] bg-cover bg-center transition-transform duration-700 ease-out group-hover:scale-[1.02]"
              style={`background-image: linear-gradient(180deg, rgba(5, 12, 24, 0.06), rgba(5, 12, 24, 0.9)), url('${system.art}');`}
            >
              <div class="absolute inset-0 bg-[radial-gradient(circle_at_68%_26%,rgba(214,179,90,0.12),transparent_24%),radial-gradient(circle_at_18%_38%,rgba(43,166,179,0.12),transparent_30%)]"></div>
              <div class="absolute inset-x-0 top-0 flex items-center justify-between gap-3 p-[0.95rem]">
                <span class="rounded-full border border-white/12 bg-black/22 px-[0.62rem] py-[0.2rem] text-[0.68rem] uppercase tracking-[0.08em] text-white/78 backdrop-blur-md">
                  {system.eyebrow}
                </span>
                <span class="text-[0.76rem] font-semibold text-[var(--color-accent-gold-soft)]">{system.pillar}</span>
              </div>
              <a href={getLocalizedPath(system.href, locale)} class="absolute inset-0" aria-label={`Open ${system.title}`}></a>
              <div class="absolute inset-x-0 bottom-0 grid gap-[0.62rem] p-[1rem] lg:p-[1.15rem]">
                <div class="grid gap-[0.22rem]">
                  <h3 class="max-w-[11ch] text-[1.7rem] font-semibold leading-[0.96] text-white text-balance">
                    {system.title}
                  </h3>
                  <p class="max-w-[22ch] text-[0.84rem] leading-[1.38] text-white/70">{system.summary}</p>
                </div>
                <div class="flex flex-wrap items-center gap-[0.42rem] text-[0.66rem] uppercase tracking-[0.08em] text-white/70">
                  <span class="rounded-full border border-white/12 bg-black/20 px-[0.52rem] py-[0.18rem] backdrop-blur-md">{system.proves}</span>
                  <span class="rounded-full border border-white/10 bg-white/6 px-[0.52rem] py-[0.18rem] text-white/60">{system.limit}</span>
                  <span class="ml-auto text-[var(--color-accent-gold-soft)]">Enter →</span>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
