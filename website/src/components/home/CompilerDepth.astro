---
import { getLocalizedPath } from '../../lib/i18n';
import type { Locale } from '../../lib/i18n';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;

const t: Record<string, {
  label: string;
  heading: string;
  subhead: string;
  facts: { number: string; desc: string }[];
  cta: string;
}> = {
  en: {
    label: 'THE COMPILER',
    heading: 'It compiles itself.',
    subhead: 'souc is written in Sounio and bootstrapped through three stages. Stage 2 and Stage 3 binaries are SHA-256 identical — the fixed-point is the proof.',
    facts: [
      { number: '3', desc: 'bootstrap stages — C → souc₁ → souc₂ ≡ souc₃' },
      { number: '4', desc: 'compiler phases — parse / check / HLIR / emit' },
      { number: '5', desc: 'backends — x86_64 · ARM64 · PTX/GPU · WASM · Cranelift JIT' },
      { number: '1000+', desc: 'e-graph rewrite rules in the optimisation pass' },
      { number: 'LSP', desc: 'language server — completions, diagnostics, goto definition for VS Code, Neovim, JetBrains' },
    ],
    cta: 'Compiler architecture →',
  },
  pt: {
    label: 'O COMPILADOR',
    heading: 'Ele se compila.',
    subhead: 'souc é escrito em Sounio e bootstrapped em três estágios. Os binários do Estágio 2 e Estágio 3 são SHA-256 idênticos — o ponto fixo é a prova.',
    facts: [
      { number: '3', desc: 'estágios de bootstrap — C → souc₁ → souc₂ ≡ souc₃' },
      { number: '4', desc: 'fases do compilador — parse / check / HLIR / emit' },
      { number: '5', desc: 'backends — x86_64 · ARM64 · PTX/GPU · WASM · Cranelift JIT' },
      { number: '1000+', desc: 'regras de e-graph no passo de optimização' },
      { number: 'LSP', desc: 'servidor de linguagem — completações, diagnósticos, goto definition para VS Code, Neovim, JetBrains' },
    ],
    cta: 'Arquitectura do compilador →',
  },
  es: {
    label: 'EL COMPILADOR',
    heading: 'Se compila a sí mismo.',
    subhead: 'souc está escrito en Sounio y bootstrapped en tres etapas. Los binarios de Etapa 2 y Etapa 3 son SHA-256 idénticos — el punto fijo es la prueba.',
    facts: [
      { number: '3', desc: 'etapas de bootstrap — C → souc₁ → souc₂ ≡ souc₃' },
      { number: '4', desc: 'fases del compilador — parse / check / HLIR / emit' },
      { number: '5', desc: 'backends — x86_64 · ARM64 · PTX/GPU · WASM · Cranelift JIT' },
      { number: '1000+', desc: 'reglas de e-graph en el paso de optimización' },
      { number: 'LSP', desc: 'servidor de lenguaje — completaciones, diagnósticos, goto definition para VS Code, Neovim, JetBrains' },
    ],
    cta: 'Arquitectura del compilador →',
  },
  el: {
    label: 'Ο COMPILER',
    heading: 'Μεταγλωττίζει τον εαυτό του.',
    subhead: 'Το souc είναι γραμμένο σε Sounio και bootstrapped σε τρία στάδια. Τα binaries Σταδίου 2 και Σταδίου 3 είναι SHA-256 πανομοιότυπα — το fixed point είναι η απόδειξη.',
    facts: [
      { number: '3', desc: 'στάδια bootstrap — C → souc₁ → souc₂ ≡ souc₃' },
      { number: '4', desc: 'φάσεις compiler — parse / check / HLIR / emit' },
      { number: '5', desc: 'backends — x86_64 · ARM64 · PTX/GPU · WASM · Cranelift JIT' },
      { number: '1000+', desc: 'κανόνες e-graph στο βήμα βελτιστοποίησης' },
      { number: 'LSP', desc: 'language server — συμπληρώσεις, διαγνωστικά, goto definition για VS Code, Neovim, JetBrains' },
    ],
    cta: 'Αρχιτεκτονική compiler →',
  },
  zh: {
    label: '编译器',
    heading: '它编译自身。',
    subhead: 'souc 用 Sounio 编写，通过三个阶段引导。第2阶段和第3阶段的二进制文件 SHA-256 完全相同——不动点即证明。',
    facts: [
      { number: '3', desc: '引导阶段 — C → souc₁ → souc₂ ≡ souc₃' },
      { number: '4', desc: '编译器阶段 — parse / check / HLIR / emit' },
      { number: '5', desc: '后端 — x86_64 · ARM64 · PTX/GPU · WASM · Cranelift JIT' },
      { number: '1000+', desc: '优化通道中的 e-graph 重写规则' },
      { number: 'LSP', desc: '语言服务器 — 代码补全、诊断、转到定义，支持 VS Code、Neovim、JetBrains' },
    ],
    cta: '编译器架构 →',
  },
  ja: {
    label: 'コンパイラ',
    heading: '自分自身をコンパイルする。',
    subhead: 'souc は Sounio で書かれ、3段階でブートストラップされます。ステージ2とステージ3のバイナリは SHA-256 が同一 — 不動点が証明です。',
    facts: [
      { number: '3', desc: 'ブートストラップ段階 — C → souc₁ → souc₂ ≡ souc₃' },
      { number: '4', desc: 'コンパイラフェーズ — parse / check / HLIR / emit' },
      { number: '5', desc: 'バックエンド — x86_64 · ARM64 · PTX/GPU · WASM · Cranelift JIT' },
      { number: '1000+', desc: '最適化パスのe-graph書き換えルール' },
      { number: 'LSP', desc: '言語サーバー — 補完、診断、定義へ移動、VS Code・Neovim・JetBrains対応' },
    ],
    cta: 'コンパイラアーキテクチャ →',
  },
};

const d = t[locale] ?? t.en;
---

<section class="compiler-depth-section">
  <div class="compiler-depth-inner">

    <div class="cd-header">
      <p class="cd-label">{d.label}</p>
      <h2 class="cd-heading">{d.heading}</h2>
      <p class="cd-subhead">{d.subhead}</p>
    </div>

    <div class="cd-body">
      <div class="cd-facts">
        {d.facts.map((f) => (
          <div class="cd-fact">
            <span class="cd-fact-number">{f.number}</span>
            <span class="cd-fact-desc">{f.desc}</span>
          </div>
        ))}
      </div>

      <div class="cd-pipeline glass">
        <p class="cd-pipeline-label">Bootstrap fixed-point</p>
        <pre class="cd-code"><code>{`# Stage 0 → 1 (C-compiled seed)
souc-seed lean_single.sio  gen1.elf

# Stage 1 → 2
./gen1.elf lean_single.sio gen2.elf

# Stage 2 → 3  (fixed-point check)
./gen2.elf lean_single.sio gen3.elf

sha256sum gen2.elf gen3.elf
# must be identical`}</code></pre>
        <a href={getLocalizedPath('/compiler', locale)} class="cd-cta">{d.cta}</a>
      </div>
    </div>

  </div>
</section>

<style>
  .compiler-depth-section {
    padding: 4.5rem 1.5rem 5rem;
    border-top: 1px solid var(--glass-border);
  }

  .compiler-depth-inner {
    max-width: 980px;
    margin: 0 auto;
    display: grid;
    gap: 2.5rem;
  }

  .cd-header {
    display: grid;
    gap: 0.75rem;
    max-width: 680px;
  }

  .cd-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    color: var(--color-accent-gold-soft);
    opacity: 0.8;
    margin: 0;
    text-transform: uppercase;
  }

  .cd-heading {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 3rem);
    font-weight: 400;
    line-height: 1.12;
    color: var(--color-text-primary);
    margin: 0;
    letter-spacing: -0.015em;
  }

  .cd-subhead {
    font-size: 0.96rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin: 0;
    max-width: 64ch;
  }

  .cd-body {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .cd-body {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  .cd-facts {
    display: grid;
    gap: 0;
  }

  .cd-fact {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--glass-border);
  }

  .cd-fact:first-child {
    padding-top: 0;
  }

  .cd-fact:last-child {
    border-bottom: none;
  }

  .cd-fact-number {
    font-size: 1.55rem;
    font-weight: 700;
    color: var(--color-gold, #c4a574);
    font-variant-numeric: tabular-nums;
    line-height: 1;
    min-width: 3.5rem;
  }

  .cd-fact-desc {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  .cd-pipeline {
    border-radius: var(--radius-xl);
    padding: 1.25rem;
    display: grid;
    gap: 0.75rem;
  }

  .cd-pipeline-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    color: var(--color-accent-gold-soft);
    opacity: 0.7;
    margin: 0;
    text-transform: uppercase;
  }

  .cd-code {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    line-height: 1.7;
    color: rgba(255,255,255,0.72);
    background: rgba(0,0,0,0.25);
    border-radius: 6px;
    padding: 0.9rem;
    overflow-x: auto;
    white-space: pre;
  }

  .cd-cta {
    font-size: 0.82rem;
    color: var(--color-accent-gold-soft);
    text-decoration: none;
    letter-spacing: 0.04em;
  }

  .cd-cta:hover {
    text-decoration: underline;
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    const section = document.querySelector('.compiler-depth-section');
    if (!section) return;

    const tl = gsap.timeline({ scrollTrigger: { trigger: section, start: 'top 75%', once: true } });
    tl.from('.cd-header > *', { y: 18, opacity: 0, stagger: 0.12, duration: 0.55, ease: 'power2.out' })
      .from('.cd-fact', { y: 20, opacity: 0, stagger: 0.08, duration: 0.45, ease: 'power2.out' }, '-=0.2')
      .from('.cd-pipeline', { y: 24, opacity: 0, duration: 0.55, ease: 'power2.out' }, '-=0.3');
  });
</script>
