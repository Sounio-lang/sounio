---
import Eyebrow from '../ui/Eyebrow.astro';
import { getLocalizedPath } from '../../lib/i18n';
import type { Locale } from '../../lib/i18n';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;

const t: Record<string, {
  label: string;
  heading: string;
  subhead: string;
  facts: { number: string; desc: string }[];
  cta: string;
}> = {
  en: {
    label: 'THE MACHINE',
    heading: 'The compiler proved itself by compiling itself.',
    subhead: 'Madaros is written in Sounio. It bootstrapped from C through three stages until Stage 2 and Stage 3 produced the exact same binary. The compiler is the proof.',
    facts: [
      { number: '3', desc: 'bootstrap stages — C → souc₁ → souc₂ ≡ souc₃' },
      { number: '4', desc: 'compiler phases — parse / check / HLIR / emit' },
      { number: '5', desc: 'backends — x86_64 · ARM64 · PTX/GPU · WASM · Cranelift JIT' },
      { number: '1000+', desc: 'e-graph rewrite rules in the optimisation pass' },
      { number: 'LSP', desc: 'language server — completions, diagnostics, goto definition for VS Code, Neovim, JetBrains' },
    ],
    cta: 'Compiler architecture →',
  },
  pt: {
    label: 'O COMPILADOR',
    heading: 'Ele se compila.',
    subhead: 'souc é escrito em Sounio e bootstrapped em três estágios. Os binários do Estágio 2 e Estágio 3 são SHA-256 idênticos — o ponto fixo é a prova.',
    facts: [
      { number: '3', desc: 'estágios de bootstrap — C → souc₁ → souc₂ ≡ souc₃' },
      { number: '4', desc: 'fases do compilador — parse / check / HLIR / emit' },
      { number: '5', desc: 'backends — x86_64 · ARM64 · PTX/GPU · WASM · Cranelift JIT' },
      { number: '1000+', desc: 'regras de e-graph no passo de optimização' },
      { number: 'LSP', desc: 'servidor de linguagem — completações, diagnósticos, goto definition para VS Code, Neovim, JetBrains' },
    ],
    cta: 'Arquitectura do compilador →',
  },
  es: {
    label: 'EL COMPILADOR',
    heading: 'Se compila a sí mismo.',
    subhead: 'souc está escrito en Sounio y bootstrapped en tres etapas. Los binarios de Etapa 2 y Etapa 3 son SHA-256 idénticos — el punto fijo es la prueba.',
    facts: [
      { number: '3', desc: 'etapas de bootstrap — C → souc₁ → souc₂ ≡ souc₃' },
      { number: '4', desc: 'fases del compilador — parse / check / HLIR / emit' },
      { number: '5', desc: 'backends — x86_64 · ARM64 · PTX/GPU · WASM · Cranelift JIT' },
      { number: '1000+', desc: 'reglas de e-graph en el paso de optimización' },
      { number: 'LSP', desc: 'servidor de lenguaje — completaciones, diagnósticos, goto definition para VS Code, Neovim, JetBrains' },
    ],
    cta: 'Arquitectura del compilador →',
  },
  el: {
    label: 'Ο COMPILER',
    heading: 'Μεταγλωττίζει τον εαυτό του.',
    subhead: 'Το souc είναι γραμμένο σε Sounio και bootstrapped σε τρία στάδια. Τα binaries Σταδίου 2 και Σταδίου 3 είναι SHA-256 πανομοιότυπα — το fixed point είναι η απόδειξη.',
    facts: [
      { number: '3', desc: 'στάδια bootstrap — C → souc₁ → souc₂ ≡ souc₃' },
      { number: '4', desc: 'φάσεις compiler — parse / check / HLIR / emit' },
      { number: '5', desc: 'backends — x86_64 · ARM64 · PTX/GPU · WASM · Cranelift JIT' },
      { number: '1000+', desc: 'κανόνες e-graph στο βήμα βελτιστοποίησης' },
      { number: 'LSP', desc: 'language server — συμπληρώσεις, διαγνωστικά, goto definition για VS Code, Neovim, JetBrains' },
    ],
    cta: 'Αρχιτεκτονική compiler →',
  },
  zh: {
    label: '编译器',
    heading: '它编译自身。',
    subhead: 'souc 用 Sounio 编写，通过三个阶段引导。第2阶段和第3阶段的二进制文件 SHA-256 完全相同——不动点即证明。',
    facts: [
      { number: '3', desc: '引导阶段 — C → souc₁ → souc₂ ≡ souc₃' },
      { number: '4', desc: '编译器阶段 — parse / check / HLIR / emit' },
      { number: '5', desc: '后端 — x86_64 · ARM64 · PTX/GPU · WASM · Cranelift JIT' },
      { number: '1000+', desc: '优化通道中的 e-graph 重写规则' },
      { number: 'LSP', desc: '语言服务器 — 代码补全、诊断、转到定义，支持 VS Code、Neovim、JetBrains' },
    ],
    cta: '编译器架构 →',
  },
  ja: {
    label: 'コンパイラ',
    heading: '自分自身をコンパイルする。',
    subhead: 'souc は Sounio で書かれ、3段階でブートストラップされます。ステージ2とステージ3のバイナリは SHA-256 が同一 — 不動点が証明です。',
    facts: [
      { number: '3', desc: 'ブートストラップ段階 — C → souc₁ → souc₂ ≡ souc₃' },
      { number: '4', desc: 'コンパイラフェーズ — parse / check / HLIR / emit' },
      { number: '5', desc: 'バックエンド — x86_64 · ARM64 · PTX/GPU · WASM · Cranelift JIT' },
      { number: '1000+', desc: '最適化パスのe-graph書き換えルール' },
      { number: 'LSP', desc: '言語サーバー — 補完、診断、定義へ移動、VS Code・Neovim・JetBrains対応' },
    ],
    cta: 'コンパイラアーキテクチャ →',
  },
};

const d = t[locale] ?? t.en;
---

<section class="compiler-depth-section relative border-t border-[var(--color-line)] px-6 pb-20 pt-[4.5rem]">
  <span class="section-indicator" aria-hidden="true">08 / The Machine</span>
  <div class="mx-auto grid max-w-[980px] gap-10">

    <div class="cd-header grid max-w-[680px] gap-3">
      <Eyebrow tone="gold" rule={false} class="opacity-80">{d.label}</Eyebrow>
      <h2 class="m-0 font-[var(--font-display)] text-[clamp(1.8rem,4vw,3rem)] font-normal leading-[1.12] tracking-[-0.015em] text-[var(--color-ink-1)]">{d.heading}</h2>
      <p class="m-0 max-w-[64ch] text-[0.96rem] leading-[1.7] text-[var(--color-ink-2)]">{d.subhead}</p>
    </div>

    <div class="grid gap-6 md:grid-cols-2 md:items-start">
      <div class="cd-facts grid">
        {d.facts.map((f) => (
          <div class="cd-fact flex items-baseline gap-3 border-b border-[var(--color-line)] py-3.5 first:pt-0 last:border-b-0">
            <span class="min-w-14 font-[var(--font-display)] text-[1.55rem] font-bold leading-none tabular-nums text-[var(--color-accent-gold)]">{f.number}</span>
            <span class="text-[0.85rem] leading-[1.5] text-[var(--color-ink-2)]">{f.desc}</span>
          </div>
        ))}
      </div>

      <div class="cd-pipeline glass grid gap-3 rounded-[var(--radius-xl)] p-5">
        <p class="m-0 font-mono text-[0.68rem] uppercase tracking-[0.14em] text-[var(--color-accent-gold-soft)] opacity-70">Bootstrap fixed-point</p>
        <pre class="m-0 whitespace-pre font-mono text-[0.76rem] leading-[1.7]"><code>{`# Stage 0 → 1 (C-compiled seed)
souc-seed lean_single.sio  gen1.elf

# Stage 1 → 2
./gen1.elf lean_single.sio gen2.elf

# Stage 2 → 3  (fixed-point check)
./gen2.elf lean_single.sio gen3.elf

sha256sum gen2.elf gen3.elf
# must be identical`}</code></pre>
        <a href={getLocalizedPath('/compiler', locale)} class="cd-cta w-fit text-[0.82rem] tracking-[0.04em] text-[var(--color-accent-gold-soft)] no-underline hover:underline">{d.cta}</a>
      </div>
    </div>

  </div>
</section>

<script>
  import { revealOnScroll } from '../../lib/motion';

  revealOnScroll('.cd-header > *', {
    y: 18,
    stagger: 0.12,
    duration: 0.55,
    scrollTrigger: { trigger: '.compiler-depth-section', start: 'top 75%', once: true },
  });

  revealOnScroll('.cd-fact', {
    y: 20,
    stagger: 0.08,
    duration: 0.45,
    scrollTrigger: { trigger: '.cd-facts', start: 'top 82%', once: true },
  });

  revealOnScroll('.cd-pipeline', {
    y: 24,
    duration: 0.55,
    scrollTrigger: { trigger: '.cd-pipeline', start: 'top 85%', once: true },
  });
</script>
