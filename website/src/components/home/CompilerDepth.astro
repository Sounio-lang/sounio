---
import { getLocalizedPath } from '../../lib/i18n';
import type { Locale } from '../../lib/i18n';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;

// Re-measured 2026-10-06 on main (8ae6468fb):
//   lean_single seed → gen1 → gen2 → gen3, md5(gen2) == md5(gen3) == 4b6b478d… in 39 s
//   (Makefile `build`; CI step "Canonical lean_single fixed point").
//   ls tests/run-pass/*.sio = 2,094; ls tests/compile-fail/*.sio = 708.
//   Madaros (default engine) has no fixed point yet: scripts/ci/madaros_fixed_point_gate.sh.
const t: Record<string, {
  label: string;
  heading: string;
  subhead: string;
  facts: { number: string; desc: string }[];
  cta: string;
}> = {
  en: {
    label: 'THE COMPILER',
    heading: 'It compiles itself.',
    subhead: 'The compiler is written in Sounio. Its seed engine, lean_single, compiles itself three times and the last two binaries are byte-identical; CI checks that fixed point on every change. Madaros, the modular engine behind souc today, does not reach its own fixed point yet, and CI tracks that climb rung by rung.',
    facts: [
      { number: '3', desc: 'self-compiled generations — gen₁ → gen₂ ≡ gen₃, MD5 4b6b478d… (lean_single seed, 39 s)' },
      { number: '2', desc: 'engines — Madaros, the modular default; lean_single, the bootstrap seed' },
      { number: '1', desc: 'target — Linux x86-64 static ELF. GPU is a PTX emission skeleton; WASM is a blocked draft (TOUR.md §6)' },
      { number: '2,094', desc: 'run-pass programs, and 708 compile-fail programs the compiler must refuse' },
      { number: 'LSP', desc: 'preview language server with diagnostics, hover and go-to-definition for VS Code and Neovim' },
    ],
    cta: 'Compiler architecture →',
  },
  pt: {
    label: 'O COMPILADOR',
    heading: 'Ele se compila.',
    subhead: 'O compilador é escrito em Sounio. Seu motor-semente, o lean_single, se compila três vezes e os dois últimos binários são idênticos byte a byte; a CI verifica esse ponto fixo a cada mudança. O Madaros, o motor modular por trás do souc hoje, ainda não atinge o próprio ponto fixo, e a CI acompanha essa subida degrau por degrau.',
    facts: [
      { number: '3', desc: 'gerações autocompiladas — gen₁ → gen₂ ≡ gen₃, MD5 4b6b478d… (semente lean_single, 39 s)' },
      { number: '2', desc: 'motores — Madaros, o modular padrão; lean_single, a semente do bootstrap' },
      { number: '1', desc: 'alvo — ELF estático Linux x86-64. GPU é um esqueleto de emissão PTX; WASM é um rascunho bloqueado (TOUR.md §6)' },
      { number: '2.094', desc: 'programas run-pass, e 708 programas compile-fail que o compilador precisa recusar' },
      { number: 'LSP', desc: 'servidor de linguagem em preview, com diagnósticos, hover e ir-para-definição no VS Code e no Neovim' },
    ],
    cta: 'Arquitetura do compilador →',
  },
  es: {
    label: 'EL COMPILADOR',
    heading: 'Se compila a sí mismo.',
    subhead: 'El compilador está escrito en Sounio. Su motor semilla, lean_single, se compila tres veces y los dos últimos binarios son idénticos byte a byte; la CI verifica ese punto fijo en cada cambio. Madaros, el motor modular detrás de souc hoy, todavía no alcanza su propio punto fijo, y la CI sigue ese ascenso peldaño a peldaño.',
    facts: [
      { number: '3', desc: 'generaciones autocompiladas — gen₁ → gen₂ ≡ gen₃, MD5 4b6b478d… (semilla lean_single, 39 s)' },
      { number: '2', desc: 'motores — Madaros, el modular por defecto; lean_single, la semilla del bootstrap' },
      { number: '1', desc: 'objetivo — ELF estático Linux x86-64. GPU es un esqueleto de emisión PTX; WASM es un borrador bloqueado (TOUR.md §6)' },
      { number: '2.094', desc: 'programas run-pass, y 708 programas compile-fail que el compilador debe rechazar' },
      { number: 'LSP', desc: 'servidor de lenguaje en preview, con diagnósticos, hover e ir a la definición en VS Code y Neovim' },
    ],
    cta: 'Arquitectura del compilador →',
  },
  el: {
    label: 'Ο ΜΕΤΑΓΛΩΤΤΙΣΤΗΣ',
    heading: 'Μεταγλωττίζει τον εαυτό του.',
    subhead: 'Ο μεταγλωττιστής είναι γραμμένος σε Sounio. Η μηχανή-σπόρος, lean_single, μεταγλωττίζει τον εαυτό της τρεις φορές και τα δύο τελευταία δυαδικά είναι ταυτόσημα byte προς byte· το CI ελέγχει αυτό το σταθερό σημείο σε κάθε αλλαγή. Ο Madaros, η αρθρωτή μηχανή πίσω από το souc σήμερα, δεν φτάνει ακόμη στο δικό του σταθερό σημείο, και το CI παρακολουθεί την άνοδο σκαλί σκαλί.',
    facts: [
      { number: '3', desc: 'αυτομεταγλωττισμένες γενιές — gen₁ → gen₂ ≡ gen₃, MD5 4b6b478d… (σπόρος lean_single, 39 s)' },
      { number: '2', desc: 'μηχανές — Madaros, η αρθρωτή προεπιλογή· lean_single, ο σπόρος του bootstrap' },
      { number: '1', desc: 'στόχος — στατικό ELF Linux x86-64. Το GPU είναι σκελετός εκπομπής PTX· το WASM είναι μπλοκαρισμένο προσχέδιο (TOUR.md §6)' },
      { number: '2.094', desc: 'προγράμματα run-pass, και 708 προγράμματα compile-fail που ο μεταγλωττιστής πρέπει να απορρίψει' },
      { number: 'LSP', desc: 'language server σε preview, με διαγνωστικά, hover και μετάβαση σε ορισμό για VS Code και Neovim' },
    ],
    cta: 'Αρχιτεκτονική μεταγλωττιστή →',
  },
  zh: {
    label: '编译器',
    heading: '它编译自身。',
    subhead: '编译器用 Sounio 编写。种子引擎 lean_single 连续编译自身三次，最后两个二进制逐字节相同；CI 在每次变更时检查这个不动点。如今 souc 背后的模块化引擎 Madaros 还没有达到自身的不动点，CI 正逐级跟踪这一进程。',
    facts: [
      { number: '3', desc: '自编译代数 — gen₁ → gen₂ ≡ gen₃，MD5 4b6b478d…（lean_single 种子，39 秒）' },
      { number: '2', desc: '引擎 — 默认的模块化引擎 Madaros；自举种子 lean_single' },
      { number: '1', desc: '目标 — Linux x86-64 静态 ELF。GPU 仅为 PTX 生成骨架；WASM 为受阻草案（TOUR.md §6）' },
      { number: '2,094', desc: '个 run-pass 程序，以及 708 个编译器必须拒绝的 compile-fail 程序' },
      { number: 'LSP', desc: '预览版语言服务器，支持 VS Code 与 Neovim 的诊断、悬停和跳转到定义' },
    ],
    cta: '编译器架构 →',
  },
  ja: {
    label: 'コンパイラ',
    heading: '自分自身をコンパイルする。',
    subhead: 'コンパイラは Sounio で書かれています。シードエンジン lean_single は自分自身を3回コンパイルし、最後の2つのバイナリはバイト単位で一致します。CI は変更のたびにこの不動点を検査します。現在 souc の背後にあるモジュール型エンジン Madaros はまだ自身の不動点に達しておらず、CI がその段階を一つずつ追跡しています。',
    facts: [
      { number: '3', desc: '自己コンパイル世代 — gen₁ → gen₂ ≡ gen₃、MD5 4b6b478d…（lean_single シード、39 秒）' },
      { number: '2', desc: 'エンジン — 既定のモジュール型 Madaros と、ブートストラップのシード lean_single' },
      { number: '1', desc: 'ターゲット — Linux x86-64 静的 ELF。GPU は PTX 出力の骨組み、WASM はブロック中のドラフト（TOUR.md §6）' },
      { number: '2,094', desc: '本の run-pass プログラムと、コンパイラが拒否すべき 708 本の compile-fail プログラム' },
      { number: 'LSP', desc: 'プレビュー版言語サーバー。VS Code と Neovim で診断・ホバー・定義へ移動に対応' },
    ],
    cta: 'コンパイラアーキテクチャ →',
  },
};

const d = t[locale] ?? t.en;
---

<section class="compiler-depth-section">
  <div class="compiler-depth-inner">

    <div class="cd-header">
      <p class="cd-label">{d.label}</p>
      <h2 class="cd-heading">{d.heading}</h2>
      <p class="cd-subhead">{d.subhead}</p>
    </div>

    <div class="cd-body">
      <div class="cd-facts">
        {d.facts.map((f) => (
          <div class="cd-fact">
            <span class="cd-fact-number">{f.number}</span>
            <span class="cd-fact-desc">{f.desc}</span>
          </div>
        ))}
      </div>

      <div class="cd-pipeline glass">
        <p class="cd-pipeline-label">Bootstrap fixed-point</p>
        <pre class="cd-code"><code>{`# make build  (Makefile), measured 2026-10-06
./bin/souc-linux-x86_64 lean_single.sio gen1.elf
./gen1.elf lean_single.sio gen2.elf
./gen2.elf lean_single.sio gen3.elf

md5sum gen2.elf gen3.elf
4b6b478dc45d9518f626f9acf475af5b  gen2.elf
4b6b478dc45d9518f626f9acf475af5b  gen3.elf`}</code></pre>
        <a href={getLocalizedPath('/compiler', locale)} class="cd-cta">{d.cta}</a>
      </div>
    </div>

  </div>
</section>

<style>
  .compiler-depth-section {
    padding: 4.5rem 1.5rem 5rem;
    border-top: 1px solid var(--glass-border);
  }

  .compiler-depth-inner {
    max-width: 980px;
    margin: 0 auto;
    display: grid;
    gap: 2.5rem;
  }

  .cd-header {
    display: grid;
    gap: 0.75rem;
    max-width: 680px;
  }

  .cd-label {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent-gold-text);
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0;

  }

  .cd-heading {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(1.9rem, 3.8vw, 3rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--color-text-primary);
    text-wrap: balance;

  }

  .cd-subhead {
    font-size: 0.96rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin: 0;
    max-width: 64ch;
  }

  .cd-body {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .cd-body {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  .cd-facts {
    display: grid;
    gap: 0;
  }

  .cd-fact {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--glass-border);
  }

  .cd-fact:first-child {
    padding-top: 0;
  }

  .cd-fact:last-child {
    border-bottom: none;
  }

  .cd-fact-number {
    font-size: 1.55rem;
    font-weight: 700;
    color: var(--color-accent-gold-text);
    font-variant-numeric: tabular-nums;
    line-height: 1;
    min-width: 3.5rem;
  }

  .cd-fact-desc {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  .cd-pipeline {
    border-radius: var(--radius-xl);
    padding: 1.25rem;
    display: grid;
    gap: 0.75rem;
  }

  .cd-pipeline-label {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent-gold-text);
    display: inline-flex;
    align-items: center;
    gap: 0.72rem;
    margin: 0;

  }

  .cd-code {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    line-height: 1.7;
    color: rgba(255,255,255,0.72);
    background: rgba(0,0,0,0.25);
    border-radius: 6px;
    padding: 0.9rem;
    overflow-x: auto;
    white-space: pre;
  }

  .cd-cta {
    font-size: 0.82rem;
    color: var(--color-accent-gold-soft);
    text-decoration: none;
    letter-spacing: 0.04em;
  }

  .cd-cta:hover {
    text-decoration: underline;
  }

  .cd-label::before { content: ''; width: 2rem; height: 2px; background: var(--color-accent-gold); flex: none; }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    const section = document.querySelector('.compiler-depth-section');
    if (!section) return;

    const tl = gsap.timeline({ scrollTrigger: { trigger: section, start: 'top 75%', once: true } });
    tl.from('.cd-header > *', { y: 18, opacity: 0, stagger: 0.12, duration: 0.55, ease: 'power2.out' })
      .from('.cd-fact', { y: 20, opacity: 0, stagger: 0.08, duration: 0.45, ease: 'power2.out' }, '-=0.2')
      .from('.cd-pipeline', { y: 24, opacity: 0, duration: 0.55, ease: 'power2.out' }, '-=0.3');
  });
</script>
