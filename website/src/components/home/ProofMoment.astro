---
import { getLocalizedPath } from '../../lib/i18n';
import type { Locale } from '../../lib/i18n';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;

const t: Record<string, { label: string; heading: string; annotation: string; link: string }> = {
  en: {
    label: 'COMPILE-TIME PATIENT SAFETY',
    heading: 'The gate fires before any code runs.',
    annotation: 'Not a heuristic. Not a warning. The type checker sees ε = 0.71, the signature requires ε ≥ 0.82, and the program does not compile. The contract is in the type.',
    link: 'Read the full vancomycin example →',
  },
  pt: {
    label: 'SEGURANÇA DO PACIENTE NA COMPILAÇÃO',
    heading: 'O portão dispara antes de qualquer execução.',
    annotation: 'Não uma heurística. Não um aviso. O verificador de tipos vê ε = 0,71, a assinatura exige ε ≥ 0,82, e o programa não compila. O contrato está no tipo.',
    link: 'Leia o exemplo completo da vancomicina →',
  },
  es: {
    label: 'SEGURIDAD DEL PACIENTE EN COMPILACIÓN',
    heading: 'La puerta se activa antes de que se ejecute el código.',
    annotation: 'No una heurística. No una advertencia. El verificador de tipos ve ε = 0,71, la firma exige ε ≥ 0,82, y el programa no compila. El contrato está en el tipo.',
    link: 'Lea el ejemplo completo de vancomicina →',
  },
  el: {
    label: 'ΑΣΦΑΛΕΙΑ ΑΣΘΕΝΩΝ ΚΑΤΑ ΤΗ ΜΕΤΑΓΛΩΤΤΙΣΗ',
    heading: 'Η πύλη ενεργοποιείται πριν τρέξει οποιοσδήποτε κώδικας.',
    annotation: 'Όχι ευρετική. Όχι προειδοποίηση. Ο type-checker βλέπει ε = 0,71, η υπογραφή απαιτεί ε ≥ 0,82, και το πρόγραμμα δεν μεταγλωττίζεται. Το συμβόλαιο βρίσκεται στον τύπο.',
    link: 'Διαβάστε το παράδειγμα βανκομυκίνης →',
  },
  zh: {
    label: '编译期患者安全',
    heading: '门控在任何代码运行之前触发。',
    annotation: '不是启发式。不是警告。类型检查器看到 ε = 0.71，签名要求 ε ≥ 0.82，程序无法编译。契约在类型中。',
    link: '阅读完整的万古霉素示例 →',
  },
  ja: {
    label: 'コンパイル時の患者安全',
    heading: 'コードが実行される前にゲートが起動します。',
    annotation: 'ヒューリスティックではありません。警告でもありません。型チェッカーは ε = 0.71 を確認し、シグネチャは ε ≥ 0.82 を要求し、プログラムはコンパイルされません。契約は型の中にあります。',
    link: 'バンコマイシンの完全な例を読む →',
  },
};

const d = t[locale] ?? t.en;

const highlightedCode = `<span class="kw">fn</span> <span class="fn-name">dose_vancomycin</span>(<span class="param">auc</span>: <span class="type">Knowledge</span>&lt;<span class="type">f64</span>&gt;) -&gt; <span class="type">f64</span>
  <span class="kw">where</span> <span class="param">auc</span>.<span class="field">&epsilon;</span> &gt;= <span class="num">0.82</span>
{
  <span class="param">auc</span>.<span class="field">value</span> / <span class="num">24.0</span>
}

<span class="comment">// caller — &epsilon; = 0.71, below threshold:</span>
<span class="kw">let</span> <span class="param">measured</span> = <span class="type">Knowledge</span> { <span class="field">value</span>: <span class="num">430.0</span>, <span class="field">&epsilon;</span>: <span class="num">0.71</span> };
<span class="fn-name">dose_vancomycin</span>(<span class="param">measured</span>);`;
---

<section class="pm-section">
  <div class="pm-bg" aria-hidden="true"></div>
  <div class="pm-overlay" aria-hidden="true"></div>
  <div class="pm-inner">
    <div class="pm-label">{d.label}</div>
    <h2 class="pm-heading">{d.heading}</h2>

    <div class="pm-exhibit">
      <div class="pm-code-panel">
        <div class="pm-file-tag">vancomycin_dosing.sio</div>
        <pre class="pm-code"><code set:html={highlightedCode} /></pre>
        <div class="pm-error-line">
          <span class="pm-error-chip">E: epistemic confidence too low</span>
          <span class="pm-error-detail">&epsilon; = 0.71 &lt; where auc.&epsilon; &gt;= 0.82 — compile rejected</span>
        </div>
      </div>

      <div class="pm-annotation">
        <p>{d.annotation}</p>
        <a href={getLocalizedPath('/learn/vancomycin-uncertainty', locale)} class="pm-link">
          {d.link}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .pm-section {
    position: relative;
    overflow: hidden;
    padding: 4.5rem 1.5rem 5rem;
  }

  .pm-bg {
    position: absolute;
    inset: -10% 0;
    background-image: url('/assets/vision/act3-fractal.jpg');
    background-size: cover;
    background-position: center 50%;
    opacity: 0.08;
    will-change: transform;
  }

  .pm-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      var(--color-bg) 0%,
      color-mix(in srgb, var(--color-bg) 60%, transparent) 15%,
      color-mix(in srgb, var(--color-bg) 50%, transparent) 85%,
      var(--color-bg) 100%
    );
  }

  .pm-inner {
    position: relative;
    z-index: 1;
    max-width: 860px;
    margin: 0 auto;
    display: grid;
    gap: 1.5rem;
  }

  .pm-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    color: var(--color-accent-teal, #2BA6B3);
    text-transform: uppercase;
    opacity: 0.85;
  }

  .pm-heading {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    font-weight: 400;
    color: var(--color-text-primary);
    margin: 0;
    line-height: 1.25;
  }

  .pm-exhibit {
    display: grid;
    gap: 1.8rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .pm-exhibit {
      grid-template-columns: 1fr 0.55fr;
      align-items: start;
    }
  }

  .pm-code-panel {
    border: 1px solid rgba(214, 179, 90, 0.25);
    border-radius: 10px;
    overflow: hidden;
    background: #0d1a2d;
  }

  .pm-file-tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: rgba(255,255,255,0.35);
    padding: 0.55rem 1rem;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    background: rgba(255,255,255,0.025);
  }

  .pm-code {
    margin: 0;
    padding: 1.2rem 1.2rem 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.84rem;
    line-height: 1.7;
    overflow-x: auto;
    background: transparent;
    border: none;
  }

  .pm-code :global(.kw)      { color: #c792ea; }
  .pm-code :global(.fn-name) { color: #82aaff; }
  .pm-code :global(.type)    { color: #ffcb6b; }
  .pm-code :global(.param)   { color: #f07178; }
  .pm-code :global(.field)   { color: #89ddff; }
  .pm-code :global(.num)     { color: #f78c6c; }
  .pm-code :global(.comment) { color: rgba(255,255,255,0.28); font-style: italic; }

  .pm-error-line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.65rem 1.2rem 0.85rem;
    border-top: 1px solid rgba(239, 83, 80, 0.2);
    background: rgba(239, 83, 80, 0.05);
  }

  .pm-error-chip {
    font-family: var(--font-mono);
    font-size: 0.73rem;
    color: #ef5350;
    font-weight: 600;
    white-space: nowrap;
  }

  .pm-error-detail {
    font-family: var(--font-mono);
    font-size: 0.71rem;
    color: rgba(255,255,255,0.35);
  }

  .pm-annotation {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .pm-annotation p {
    font-size: 0.92rem;
    line-height: 1.75;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .pm-link {
    font-size: 0.84rem;
    color: var(--color-accent-gold-soft);
    text-decoration: none;
  }

  .pm-link:hover { text-decoration: underline; }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    const section = document.querySelector<HTMLElement>('.pm-section');
    const bg = document.querySelector<HTMLElement>('.pm-bg');
    if (!section || !bg) return;

    gsap.to(bg, {
      yPercent: 18,
      ease: 'none',
      scrollTrigger: { trigger: section, start: 'top bottom', end: 'bottom top', scrub: 2 },
    });

    const tl = gsap.timeline({
      scrollTrigger: { trigger: section, start: 'top 75%', once: true },
    });

    tl.from('.pm-label', { y: 14, opacity: 0, duration: 0.5, ease: 'power2.out' })
      .from('.pm-heading', { y: 22, opacity: 0, duration: 0.65, ease: 'power2.out' }, '-=0.3')
      .from('.pm-code-panel', { y: 28, opacity: 0, duration: 0.7, ease: 'power2.out' }, '-=0.35')
      .from('.pm-annotation', { y: 20, opacity: 0, duration: 0.6, ease: 'power2.out' }, '-=0.4')
      .from('.pm-error-chip', {
        color: 'rgba(239,83,80,0)',
        textShadow: '0 0 14px rgba(239,83,80,0.9)',
        duration: 0.5,
        ease: 'power1.out',
      }, '-=0.05');
  });
</script>
