---
import CodePanel from '../ui/CodePanel.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import { getLocalizedPath } from '../../lib/i18n';
import type { Locale } from '../../lib/i18n';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;

const t: Record<string, { label: string; heading: string; annotation: string; link: string }> = {
  en: {
    label: 'THE GATE',
    heading: 'A program that says "I don’t know enough" is safer than one that says "trust me".',
    annotation: 'ε = 0.71 < where auc.ε ≥ 0.82. The type checker saw the gap and rejected the program before any code ran. Not a warning. A gate. This is what patient safety looks like when the compiler is the gate.',
    link: 'Read the full vancomycin example →',
  },
  pt: {
    label: 'SEGURANÇA DO PACIENTE NA COMPILAÇÃO',
    heading: 'O portão dispara antes de qualquer execução.',
    annotation: 'Não uma heurística. Não um aviso. O verificador de tipos vê ε = 0,71, a assinatura exige ε ≥ 0,82, e o programa não compila. O contrato está no tipo.',
    link: 'Leia o exemplo completo da vancomicina →',
  },
  es: {
    label: 'SEGURIDAD DEL PACIENTE EN COMPILACIÓN',
    heading: 'La puerta se activa antes de que se ejecute el código.',
    annotation: 'No una heurística. No una advertencia. El verificador de tipos ve ε = 0,71, la firma exige ε ≥ 0,82, y el programa no compila. El contrato está en el tipo.',
    link: 'Lea el ejemplo completo de vancomicina →',
  },
  el: {
    label: 'ΑΣΦΑΛΕΙΑ ΑΣΘΕΝΩΝ ΚΑΤΑ ΤΗ ΜΕΤΑΓΛΩΤΤΙΣΗ',
    heading: 'Η πύλη ενεργοποιείται πριν τρέξει οποιοσδήποτε κώδικας.',
    annotation: 'Όχι ευρετική. Όχι προειδοποίηση. Ο type-checker βλέπει ε = 0,71, η υπογραφή απαιτεί ε ≥ 0,82, και το πρόγραμμα δεν μεταγλωττίζεται. Το συμβόλαιο βρίσκεται στον τύπο.',
    link: 'Διαβάστε το παράδειγμα βανκομυκίνης →',
  },
  zh: {
    label: '编译期患者安全',
    heading: '门控在任何代码运行之前触发。',
    annotation: '不是启发式。不是警告。类型检查器看到 ε = 0.71，签名要求 ε ≥ 0.82，程序无法编译。契约在类型中。',
    link: '阅读完整的万古霉素示例 →',
  },
  ja: {
    label: 'コンパイル時の患者安全',
    heading: 'コードが実行される前にゲートが起動します。',
    annotation: 'ヒューリスティックではありません。警告でもありません。型チェッカーは ε = 0.71 を確認し、シグネチャは ε ≥ 0.82 を要求し、プログラムはコンパイルされません。契約は型の中にあります。',
    link: 'バンコマイシンの完全な例を読む →',
  },
};

const d = t[locale] ?? t.en;

const code = `fn dose_vancomycin(auc: Knowledge<f64>) -> f64
  where auc.ε >= 0.82
{
  auc.value / 24.0
}

// caller — ε = 0.71, below threshold:
let measured = Knowledge { value: 430.0, ε: 0.71 };
dose_vancomycin(measured);`;
---

<section class="pm-section relative overflow-hidden px-6 pb-20 pt-[4.5rem] [perspective:1000px]">
  <div class="pm-bg" aria-hidden="true"></div>
  <div class="pm-overlay" aria-hidden="true"></div>
  <div class="relative z-[1] mx-auto grid max-w-[860px] gap-6">
    <Eyebrow tone="teal" rule={false} class="pm-label opacity-85">{d.label}</Eyebrow>
    <h2 class="pm-heading m-0 font-[var(--font-display)] text-[clamp(1.5rem,3vw,2.2rem)] font-normal leading-[1.25] text-[var(--color-ink-1)]">{d.heading}</h2>

    <div class="pm-exhibit grid grid-cols-1 gap-7 md:grid-cols-[1fr_0.55fr] md:items-start">
      <div class="pm-code-panel grid gap-3">
        <CodePanel code={code} lang="rust" filename="vancomycin_dosing.sio" />
        <div class="pm-error-strip flex flex-wrap items-baseline gap-2 rounded-[var(--radius-md)] border-l-2 border-[var(--color-accent-red)] bg-[color-mix(in_srgb,var(--color-accent-red)_8%,transparent)] px-4 py-2.5 font-mono">
          <span class="pm-error-chip whitespace-nowrap text-[0.73rem] font-semibold text-[var(--color-accent-red)]">E: epistemic confidence too low</span>
          <span class="text-[0.71rem] text-[var(--color-ink-3)]">&epsilon; = 0.71 &lt; where auc.&epsilon; &gt;= 0.82 — compile rejected</span>
        </div>
      </div>

      <div class="pm-annotation grid content-start gap-4">
        <p class="m-0 text-[0.92rem] leading-[1.75] text-[var(--color-ink-2)]">{d.annotation}</p>
        <a href={getLocalizedPath('/learn/vancomycin-uncertainty', locale)} class="pm-link text-[0.84rem] text-[var(--color-accent-gold-soft)] no-underline hover:underline">
          {d.link}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .pm-bg {
    position: absolute;
    inset: -10% 0;
    background-image: url('/assets/vision/act3-fractal.jpg');
    background-size: cover;
    background-position: center 50%;
    opacity: 0.08;
    will-change: transform;
  }

  .pm-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      var(--color-surface-base) 0%,
      color-mix(in srgb, var(--color-surface-base) 60%, transparent) 15%,
      color-mix(in srgb, var(--color-surface-base) 50%, transparent) 85%,
      var(--color-surface-base) 100%
    );
  }
</style>

<script>
  import { gsap, revealOnScroll, prefersReducedMotion } from '../../lib/motion';

  if (!prefersReducedMotion()) {
    const section = document.querySelector<HTMLElement>('.pm-section');
    const bg = document.querySelector<HTMLElement>('.pm-bg');
    if (section && bg) {
      gsap.to(bg, {
        yPercent: 18,
        ease: 'none',
        scrollTrigger: { trigger: section, start: 'top bottom', end: 'bottom top', scrub: 2 },
      });

      revealOnScroll('.pm-label, .pm-heading, .pm-code-panel, .pm-annotation', {
        y: 50,
        rotateX: 10,
        opacity: 0,
        stagger: 0.14,
        duration: 0.9,
        ease: 'power3.out',
        scrollTrigger: { trigger: section, start: 'top 75%', once: true },
      });

      gsap.from('.pm-error-chip', {
        opacity: 0,
        duration: 0.6,
        ease: 'power1.out',
        scrollTrigger: { trigger: '.pm-error-strip', start: 'top 88%', once: true },
      });
    }
  }
</script>
