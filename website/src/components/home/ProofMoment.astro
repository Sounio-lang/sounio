---
import { getLocalizedPath } from '../../lib/i18n';
import type { Locale } from '../../lib/i18n';

interface Props {
  locale?: Locale;
}

const locale: Locale = Astro.props.locale ?? 'en';
const isPt = locale === 'pt';

const copy = isPt
  ? {
      label: 'SALA DE RECIBOS / FRONTEIRA EPISTÊMICA',
      heading: 'Evidência não desaparece por atribuição.',
      body: 'Knowledge<f64> entra. Um f64 simples é exigido. O compilador Madaros recusa a perda silenciosa e o manifesto de conformidade exige que o diagnóstico nomeie o tipo encontrado.',
      verdict: 'Compilação recusada',
      boundaryTitle: 'O que este recibo prova',
      boundary: 'Somente esta fronteira: a atribuição implícita de Knowledge<f64> para f64 sai com código não zero. Não prova toda propagação GUM, toda proveniência nem maturidade completa da stdlib epistêmica.',
      link: 'Abrir a superfície de prova',
      source: 'fonte',
      contract: 'contrato',
    }
  : {
      label: 'RECEIPT ROOM / EPISTEMIC BOUNDARY',
      heading: 'Evidence cannot disappear by assignment.',
      body: 'Knowledge<f64> enters. A plain f64 is required. The Madaros compiler refuses the silent loss, and the conformance manifest requires the diagnostic to name the type it found.',
      verdict: 'Compile refused',
      boundaryTitle: 'What this receipt proves',
      boundary: 'Only this boundary: implicit assignment from Knowledge<f64> to f64 exits nonzero. It does not prove all GUM propagation, all provenance behavior, or maturity of the entire epistemic stdlib.',
      link: 'Open the proof surface',
      source: 'source',
      contract: 'contract',
    };

const highlightedCode = `<span class="comment">//@ compile-fail</span>
<span class="comment">//@ error-pattern: found Knowledge</span>

<span class="kw">fn</span> <span class="fn-name">main</span>() {
  <span class="kw">let</span> <span class="param">k</span> = <span class="type">Knowledge</span> { <span class="field">value</span>: <span class="num">1.0</span> }
  <span class="kw">let</span> <span class="param">x</span>: <span class="type">f64</span> = <span class="param">k</span>
}`;

const compilerOutput = `error[E001]: this binding expects a different type
   = expected f64
   = found Knowledge<f64>
   = help: the variable declaration and assigned value have incompatible types`;
---

<section id="receipt-room" class="pm-section" aria-labelledby="receipt-room-title">
  <div class="pm-bg" aria-hidden="true"></div>
  <div class="pm-overlay" aria-hidden="true"></div>
  <div class="pm-inner">
    <header class="pm-header">
      <p class="pm-label">{copy.label}</p>
      <h2 id="receipt-room-title" class="pm-heading">{copy.heading}</h2>
      <p class="pm-body">{copy.body}</p>
    </header>

    <div class="pm-exhibit">
      <div class="pm-source-column">
        <div class="pm-code-panel">
          <div class="pm-file-tag">
            <span>{copy.source}</span>
            <code>tests/compile-fail/knowledge_no_silent_unwrap.sio</code>
          </div>
          <pre class="pm-code"><code set:html={highlightedCode} /></pre>
        </div>

        <div class="pm-output" aria-label={copy.verdict}>
          <div class="pm-output-heading">
            <span>{copy.verdict}</span>
            <code>exit 1</code>
          </div>
          <pre><code>{compilerOutput}</code></pre>
        </div>
      </div>

      <aside class="pm-receipt" aria-label={copy.contract}>
        <div class="pm-receipt-head">
          <span>{copy.contract}</span>
          <strong>knowledge-boundary-diagnostic</strong>
        </div>
        <dl>
          <div><dt>mode</dt><dd>check-fail</dd></div>
          <div><dt>expected exit</dt><dd>nonzero</dd></div>
          <div><dt>required output</dt><dd><code>found Knowledge&lt;f64&gt;</code></dd></div>
          <div><dt>claim</dt><dd><code>epistemic.boundary</code></dd></div>
          <div><dt>entrypoint</dt><dd><code>bin/souc → Madaros</code></dd></div>
        </dl>
        <div class="pm-boundary">
          <strong>{copy.boundaryTitle}</strong>
          <p>{copy.boundary}</p>
        </div>
        <div class="pm-links">
          <a href={getLocalizedPath('/proof#epistemic-boundary', locale)}>{copy.link}<span aria-hidden="true">↗</span></a>
          <a href="https://github.com/Sounio-lang/sounio/blob/main/tests/conformance/manifest.v1.tsv">tests/conformance/manifest.v1.tsv<span aria-hidden="true">↗</span></a>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  .pm-section {
    position: relative;
    overflow: hidden;
    padding: 5.5rem 1.5rem 6rem;
    border-block: 1px solid rgba(214, 179, 90, 0.18);
  }

  .pm-bg {
    position: absolute;
    inset: -10% 0;
    background-image: url('/assets/vision/act3-fractal.jpg');
    background-position: center 50%;
    background-size: cover;
    opacity: 0.07;
    will-change: transform;
  }

  .pm-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, var(--color-bg), color-mix(in srgb, var(--color-bg) 72%, transparent) 45%, var(--color-bg));
  }

  .pm-inner {
    position: relative;
    z-index: 1;
    display: grid;
    max-width: 1180px;
    margin: 0 auto;
    gap: 2.4rem;
  }

  .pm-header {
    display: grid;
    max-width: 850px;
    gap: 0.85rem;
  }

  .pm-label {
    margin: 0;
    color: var(--color-accent-gold-soft);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .pm-heading {
    max-width: 15ch;
    margin: 0;
    color: var(--color-text-primary);
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4.6rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0;
  }

  .pm-body {
    max-width: 68ch;
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.96rem;
    line-height: 1.72;
  }

  .pm-exhibit {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(300px, 0.75fr);
    gap: 1.2rem;
    align-items: stretch;
  }

  .pm-source-column {
    display: grid;
    min-width: 0;
    gap: 1rem;
  }

  .pm-code-panel,
  .pm-output {
    overflow: hidden;
    border: 1px solid rgba(214, 179, 90, 0.24);
    border-radius: 8px;
    background: #081321;
  }

  .pm-file-tag,
  .pm-output-heading {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    color: var(--color-text-tertiary);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    text-transform: uppercase;
  }

  .pm-file-tag code,
  .pm-output-heading code {
    overflow: hidden;
    color: var(--color-accent-gold-soft);
    font: inherit;
    text-overflow: ellipsis;
    text-transform: none;
    white-space: nowrap;
  }

  .pm-code,
  .pm-output pre {
    margin: 0;
    overflow-x: auto;
    border: 0;
    background: transparent;
    font-family: var(--font-mono);
  }

  .pm-code {
    min-height: 15rem;
    padding: 1.4rem;
    font-size: 0.84rem;
    line-height: 1.8;
  }

  .pm-code :global(.kw) { color: #c792ea; }
  .pm-code :global(.fn-name) { color: #82aaff; }
  .pm-code :global(.type) { color: #ffcb6b; }
  .pm-code :global(.param) { color: #f07178; }
  .pm-code :global(.field) { color: #89ddff; }
  .pm-code :global(.num) { color: #f78c6c; }
  .pm-code :global(.comment) { color: rgba(255, 255, 255, 0.38); }

  .pm-output {
    border-color: rgba(239, 83, 80, 0.3);
    background: #140d13;
  }

  .pm-output-heading span {
    color: #ff8a80;
  }

  .pm-output pre {
    padding: 1rem 1.2rem;
    color: #ffaaa4;
    font-size: 0.72rem;
    line-height: 1.65;
  }

  .pm-receipt {
    display: grid;
    align-content: start;
    border-top: 1px solid rgba(214, 179, 90, 0.48);
  }

  .pm-receipt-head {
    display: grid;
    gap: 0.35rem;
    padding: 1.05rem 0;
    border-bottom: 1px solid rgba(214, 179, 90, 0.18);
  }

  .pm-receipt-head span,
  .pm-receipt dt {
    color: var(--color-text-tertiary);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    text-transform: uppercase;
  }

  .pm-receipt-head strong {
    color: var(--color-text-primary);
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
  }

  .pm-receipt dl {
    display: grid;
    margin: 0;
  }

  .pm-receipt dl div {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 0.8rem;
    padding: 0.72rem 0;
    border-bottom: 1px solid rgba(214, 179, 90, 0.12);
  }

  .pm-receipt dd {
    min-width: 0;
    margin: 0;
    color: var(--color-accent-gold-soft);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    overflow-wrap: anywhere;
  }

  .pm-receipt dd code {
    font: inherit;
  }

  .pm-boundary {
    display: grid;
    gap: 0.55rem;
    padding: 1.2rem 0;
    border-bottom: 1px solid rgba(214, 179, 90, 0.18);
  }

  .pm-boundary strong {
    color: var(--color-text-primary);
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 500;
  }

  .pm-boundary p {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.78rem;
    line-height: 1.65;
  }

  .pm-links {
    display: grid;
    gap: 0.65rem;
    padding-top: 1rem;
  }

  .pm-links a {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--color-accent-gold-soft);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-decoration: none;
  }

  .pm-links a:hover {
    text-decoration: underline;
  }

  .pm-links a:focus-visible {
    outline: 2px solid var(--color-accent-gold);
    outline-offset: 4px;
  }

  @media (max-width: 820px) {
    .pm-exhibit {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .pm-section {
      padding: 4rem 1.25rem;
    }

    .pm-heading {
      font-size: 2.65rem;
    }

    .pm-file-tag {
      display: grid;
    }

    .pm-code {
      min-height: 13rem;
      padding: 1rem;
      font-size: 0.75rem;
    }

    .pm-output pre {
      font-size: 0.65rem;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    const section = document.querySelector<HTMLElement>('.pm-section');
    const bg = document.querySelector<HTMLElement>('.pm-bg');
    if (!section || !bg) return;

    gsap.to(bg, {
      yPercent: 18,
      ease: 'none',
      scrollTrigger: { trigger: section, start: 'top bottom', end: 'bottom top', scrub: 2 },
    });

    gsap.from(section.querySelectorAll('.pm-header > *, .pm-source-column, .pm-receipt'), {
      y: 24,
      opacity: 0,
      stagger: 0.1,
      duration: 0.65,
      ease: 'power2.out',
      scrollTrigger: { trigger: section, start: 'top 75%', once: true },
    });
  });
</script>
