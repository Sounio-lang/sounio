---
import { getLocalizedPath } from '../../lib/i18n';
import type { Locale } from '../../lib/i18n';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;

const t: Record<string, { label: string; heading: string; annotation: string; link: string }> = {
  en: {
    label: 'COMPILE-TIME PATIENT SAFETY',
    heading: 'The gate fires before any code runs.',
    annotation: 'The type checker rejects this call statically — not a runtime crash, not a lint warning. The epistemic confidence ε of the measurement is below the threshold declared on the function.',
    link: 'Read the full vancomycin example →',
  },
  pt: {
    label: 'SEGURANÇA DO PACIENTE NA COMPILAÇÃO',
    heading: 'O portão dispara antes de qualquer execução.',
    annotation: 'O verificador de tipos rejeita esta chamada de forma estática — não é um crash em tempo de execução, não é um aviso de linter. A confiança epistémica ε da medição está abaixo do limiar declarado na função.',
    link: 'Leia o exemplo completo da vancomicina →',
  },
  es: {
    label: 'SEGURIDAD DEL PACIENTE EN COMPILACIÓN',
    heading: 'La puerta se activa antes de que se ejecute el código.',
    annotation: 'El verificador de tipos rechaza esta llamada estáticamente — no es un crash en tiempo de ejecución, no es una advertencia del linter. La confianza epistémica ε de la medición está por debajo del umbral declarado en la función.',
    link: 'Lea el ejemplo completo de vancomicina →',
  },
  el: {
    label: 'ΑΣΦΑΛΕΙΑ ΑΣΘΕΝΩΝ ΚΑΤΑ ΤΗ ΜΕΤΑΓΛΩΤΤΙΣΗ',
    heading: 'Η πύλη ενεργοποιείται πριν τρέξει οποιοσδήποτε κώδικας.',
    annotation: 'Ο type-checker απορρίπτει στατικά αυτή την κλήση — όχι runtime crash, όχι lint. Η επιστημική εμπιστοσύνη ε της μέτρησης είναι κάτω από το όριο που δηλώθηκε στη συνάρτηση.',
    link: 'Διαβάστε το παράδειγμα βανκομυκίνης →',
  },
  zh: { label: '编译期患者安全', heading: '门控在任何代码运行之前触发。', annotation: '类型检查器静态拒绝此调用——不是运行时崩溃，不是 lint 警告。测量值的认知置信度 ε 低于函数声明的阈值。', link: '阅读完整的万古霉素示例 →' },
  ja: { label: 'コンパイル時の患者安全', heading: 'コードが実行される前にゲートが起動します。', annotation: '型チェッカーはこの呼び出しを静的に拒否します——ランタイムクラッシュでも、lint警告でもありません。測定値の認識的信頼度 ε は関数で宣言されたしきい値を下回っています。', link: 'バンコマイシンの完全な例を読む →' },
};

const d = t[locale] ?? t.en;

// Pre-rendered highlighted code — HTML entities prevent Astro from parsing
// generic syntax like Knowledge<f64> as HTML tags.
const highlightedCode = `<span class="kw">fn</span> <span class="fn-name">dose_vancomycin</span>(<span class="param">auc</span>: <span class="type">Knowledge</span>&lt;<span class="type">f64</span>&gt;) -&gt; <span class="type">f64</span>
  <span class="kw">where</span> <span class="param">auc</span>.<span class="field">&epsilon;</span> &gt;= <span class="num">0.82</span>
{
  <span class="param">auc</span>.<span class="field">value</span> / <span class="num">24.0</span>
}

<span class="comment">// caller — &epsilon; = 0.71, below threshold:</span>
<span class="kw">let</span> <span class="param">measured</span> = <span class="type">Knowledge</span> { <span class="field">value</span>: <span class="num">430.0</span>, <span class="field">&epsilon;</span>: <span class="num">0.71</span> };
<span class="fn-name">dose_vancomycin</span>(<span class="param">measured</span>);`;
---

<section class="proof-moment-section">
  <div class="proof-moment-inner">
    <div class="proof-label">{d.label}</div>
    <h2 class="proof-heading">{d.heading}</h2>

    <div class="proof-exhibit">
      <div class="proof-code-panel">
        <div class="code-file-tag">vancomycin_dosing.sio</div>
        <pre class="proof-code"><code set:html={highlightedCode} /></pre>

        <div class="proof-error-line">
          <span class="error-chip">E: epistemic confidence too low</span>
          <span class="error-detail">&epsilon; = 0.71 &lt; where auc.&epsilon; &gt;= 0.82 — compile rejected</span>
        </div>
      </div>

      <div class="proof-annotation">
        <p>{d.annotation}</p>
        <a href={getLocalizedPath('/learn/vancomycin-uncertainty', locale)} class="proof-link">
          {d.link}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .proof-moment-section {
    padding: 4.5rem 1.5rem 5rem;
  }

  .proof-moment-inner {
    max-width: 860px;
    margin: 0 auto;
    display: grid;
    gap: 1.5rem;
  }

  .proof-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    color: var(--color-accent-teal, #2BA6B3);
    text-transform: uppercase;
    opacity: 0.85;
  }

  .proof-heading {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    font-weight: 400;
    color: var(--color-text-primary);
    margin: 0;
    line-height: 1.25;
  }

  .proof-exhibit {
    display: grid;
    gap: 1.8rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .proof-exhibit {
      grid-template-columns: 1fr 0.55fr;
      align-items: start;
    }
  }

  .proof-code-panel {
    border: 1px solid rgba(214, 179, 90, 0.25);
    border-radius: 10px;
    overflow: hidden;
    background: #0d1a2d;
  }

  .code-file-tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: rgba(255,255,255,0.35);
    padding: 0.55rem 1rem;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    background: rgba(255,255,255,0.025);
  }

  .proof-code {
    margin: 0;
    padding: 1.2rem 1.2rem 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.84rem;
    line-height: 1.7;
    overflow-x: auto;
    background: transparent;
    border: none;
  }

  .proof-code :global(.kw)      { color: #c792ea; }
  .proof-code :global(.fn-name) { color: #82aaff; }
  .proof-code :global(.type)    { color: #ffcb6b; }
  .proof-code :global(.param)   { color: #f07178; }
  .proof-code :global(.field)   { color: #89ddff; }
  .proof-code :global(.num)     { color: #f78c6c; }
  .proof-code :global(.comment) { color: rgba(255,255,255,0.28); font-style: italic; }

  .proof-error-line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.65rem 1.2rem 0.85rem;
    border-top: 1px solid rgba(239, 83, 80, 0.2);
    background: rgba(239, 83, 80, 0.05);
  }

  .error-chip {
    font-family: var(--font-mono);
    font-size: 0.73rem;
    color: #ef5350;
    font-weight: 600;
    white-space: nowrap;
  }

  .error-detail {
    font-family: var(--font-mono);
    font-size: 0.71rem;
    color: rgba(255,255,255,0.35);
  }

  .proof-annotation {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .proof-annotation p {
    font-size: 0.92rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .proof-link {
    font-size: 0.84rem;
    color: var(--color-accent-gold-soft);
    text-decoration: none;
  }

  .proof-link:hover {
    text-decoration: underline;
  }
</style>
