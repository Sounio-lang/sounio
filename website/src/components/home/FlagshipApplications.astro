---
import renderManifest from '../../../public/assets/generated/render/manifest.json';
import { getLocalizedPath, type Locale } from '../../lib/i18n';

interface Props {
  locale?: Locale;
}

type ReceiptAsset = (typeof renderManifest.assets)[number];

const { locale = 'en' } = Astro.props;
const isPt = locale === 'pt';

const copy = isPt
  ? {
      label: 'DOSSIÊ DE EVIDÊNCIA POR DOMÍNIO',
      heading: 'Quatro domínios. Um padrão de evidência.',
      body: 'O mesmo percurso aparece em gráficos, moléculas, valores epistêmicos e causalidade: fonte Sounio, artefato determinístico, gate executável e uma fronteira que impede o claim de crescer além da prova.',
      compiled: 'o que Sounio compilou',
      receipt: 'recibo',
      boundary: 'fronteira',
      inspect: 'Abrir domínio',
      source: 'fonte',
      gate: 'gate',
      engine: 'engine',
    }
  : {
      label: 'DOMAIN EVIDENCE DOCKET',
      heading: 'Four domains. One standard of evidence.',
      body: 'The same path crosses graphics, molecules, epistemic values, and causality: Sounio source, deterministic artifact, executable gate, and a boundary that prevents the claim from outrunning the proof.',
      compiled: 'what Sounio compiled',
      receipt: 'receipt',
      boundary: 'boundary',
      inspect: 'Open domain',
      source: 'source',
      gate: 'gate',
      engine: 'engine',
    };

const entries = [
  {
    assetFile: 'coverage-crystal-atelier.png',
    index: '01',
    domain: isPt ? 'Renderer' : 'Renderer',
    title: isPt ? 'Cobertura que não mente na borda.' : 'Coverage that does not lie at the edge.',
    compiled: isPt
      ? 'Um estudo de material Phong com quatro amostras de cobertura por pixel e profundidade fixed-point.'
      : 'A Phong material study with four coverage samples per pixel and fixed-point depth.',
    boundary: isPt
      ? 'Recibo de raster por software; não demonstra paridade GPU nem toda orientação de geometria.'
      : 'Software-raster receipt; not a claim of GPU parity or every geometry orientation.',
    href: '/science/graphics',
  },
  {
    assetFile: 'rapamycin-material-study.png',
    index: '02',
    domain: isPt ? 'Sistemas moleculares' : 'Molecular systems',
    title: isPt ? 'A topologia atravessa o desenho.' : 'The topology survives the picture.',
    compiled: isPt
      ? 'Quarenta e quatro sítios de átomos pesados e 45 registros de ligações do modelo coarse de rapamicina da stdlib.'
      : 'Forty-four heavy-atom sites and 45 bond records from the stdlib coarse rapamycin model.',
    boundary: isPt
      ? 'Scaffold idealizado para inspeção; não é reconstrução cristalográfica nem conformação experimental.'
      : 'Idealized inspection scaffold; not a crystallographic reconstruction or experimental conformation.',
    href: '/science/pharma',
  },
  {
    assetFile: 'epistemic-field-atelier.png',
    index: '03',
    domain: isPt ? 'Valores epistêmicos' : 'Epistemic values',
    title: isPt ? 'Valor, variância e ambiguidade não colapsam.' : 'Value, variance, and ambiguity do not collapse.',
    compiled: isPt
      ? 'Epistemic::sub dirige valor e variância de primeira ordem; PBox mantém a banda de média em um canal de decisão separado.'
      : 'Epistemic::sub drives value and first-order variance; PBox keeps the mean band in a separate decision channel.',
    boundary: isPt
      ? 'Campo sintético e ilustrativo; não é dado clínico, intervalo de 95% nem declaração completa de conformidade GUM.'
      : 'Synthetic illustrative field; not clinical data, a 95% interval, or a complete GUM compliance claim.',
    href: '/language#epistemic-types',
  },
  {
    assetFile: 'causal-intervention-frontier.png',
    index: '04',
    domain: isPt ? 'Inferência causal' : 'Causal inference',
    title: isPt ? 'Quando a identificação falha, o programa recusa.' : 'When identification fails, the program refuses.',
    compiled: isPt
      ? 'Cirurgia do(X) em um DAG fixo, com a rota backdoor latente preservada e nenhuma estimativa de efeito emitida.'
      : 'do(X) graph surgery on a fixed DAG, with the latent backdoor path preserved and no effect estimate emitted.',
    boundary: isPt
      ? 'Testemunho para este DAG; não é algoritmo ID geral, descoberta de latentes nem estimativa causal.'
      : 'A witness for this DAG; not a general ID algorithm, latent discovery, or a causal effect estimate.',
    href: '/science/causal',
  },
].map((entry) => {
  const asset = renderManifest.assets.find((candidate) => candidate.asset.endsWith(entry.assetFile)) as ReceiptAsset | undefined;
  if (!asset) throw new Error(`Missing domain evidence receipt: ${entry.assetFile}`);
  return { ...entry, asset };
});
---

<section class="domain-docket" aria-labelledby="domain-docket-title">
  <div class="container domain-docket-shell">
    <header class="domain-docket-header">
      <p>{copy.label}</p>
      <h2 id="domain-docket-title">{copy.heading}</h2>
      <span>{copy.body}</span>
    </header>

    <ol class="domain-docket-list">
      {entries.map(({ index, domain, title, compiled, boundary, href, asset }) => (
        <li class="domain-docket-row">
          <div class="domain-docket-identity">
            <span>{index}</span>
            <p>{domain}</p>
          </div>

          <figure class="domain-docket-figure">
            <img src={asset.public_path} alt="" width={asset.width} height={asset.height} loading="lazy" />
          </figure>

          <div class="domain-docket-claim">
            <h3>{title}</h3>
            <dl>
              <div>
                <dt>{copy.compiled}</dt>
                <dd>{compiled}</dd>
              </div>
              <div>
                <dt>{copy.boundary}</dt>
                <dd>{boundary}</dd>
              </div>
            </dl>
          </div>

          <div class="domain-docket-custody">
            <span class="domain-docket-pass">PASS</span>
            <dl>
              <div><dt>{copy.receipt}</dt><dd><code>{asset.receipt}</code></dd></div>
              <div><dt>{copy.engine}</dt><dd><code>{asset.engine}</code></dd></div>
              <div><dt>{copy.source}</dt><dd><code>{asset.example}</code></dd></div>
              <div><dt>{copy.gate}</dt><dd><code>{asset.gate}</code></dd></div>
            </dl>
            <a href={getLocalizedPath(href, locale)}>{copy.inspect}<span aria-hidden="true">↗</span></a>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .domain-docket {
    padding: clamp(4.5rem, 8vw, 7rem) 0;
    border-block: 1px solid rgba(214, 179, 90, 0.2);
    background: #08182a;
    color: var(--color-text-primary);
  }

  .domain-docket-shell {
    display: grid;
    gap: 3rem;
  }

  .domain-docket-header {
    display: grid;
    grid-template-columns: minmax(280px, 0.85fr) minmax(280px, 0.65fr);
    gap: 1rem 4rem;
    align-items: end;
  }

  .domain-docket-header > p {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--color-accent-gold-soft);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
  }

  .domain-docket-header h2 {
    max-width: 14ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 5vw, 4.9rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0;
  }

  .domain-docket-header > span {
    max-width: 54ch;
    color: var(--color-text-secondary);
    font-size: 0.98rem;
    line-height: 1.75;
  }

  .domain-docket-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid rgba(214, 179, 90, 0.28);
    list-style: none;
  }

  .domain-docket-row {
    display: grid;
    grid-template-columns: 7.5rem minmax(150px, 0.55fr) minmax(250px, 0.9fr) minmax(280px, 0.75fr);
    gap: clamp(1.2rem, 3vw, 2.5rem);
    align-items: start;
    padding: 2rem 0;
    border-bottom: 1px solid rgba(214, 179, 90, 0.2);
  }

  .domain-docket-identity {
    display: grid;
    gap: 0.6rem;
  }

  .domain-docket-identity > span,
  .domain-docket-identity > p {
    margin: 0;
    font-family: var(--font-mono);
    text-transform: uppercase;
  }

  .domain-docket-identity > span {
    color: var(--color-accent-gold);
    font-size: 0.68rem;
  }

  .domain-docket-identity > p {
    color: var(--color-text-tertiary);
    font-size: 0.62rem;
    line-height: 1.45;
  }

  .domain-docket-figure {
    width: 100%;
    margin: 0;
    aspect-ratio: 8 / 5;
    overflow: hidden;
    border: 1px solid rgba(105, 225, 224, 0.2);
    background: #050d17;
  }

  .domain-docket-figure img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .domain-docket-claim {
    display: grid;
    gap: 1.1rem;
  }

  .domain-docket-claim h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.4vw, 2rem);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: 0;
  }

  .domain-docket-claim dl,
  .domain-docket-custody dl {
    display: grid;
    gap: 0.8rem;
    margin: 0;
  }

  .domain-docket-claim dl > div,
  .domain-docket-custody dl > div {
    display: grid;
    gap: 0.3rem;
  }

  .domain-docket-claim dt,
  .domain-docket-custody dt {
    color: var(--color-text-tertiary);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    text-transform: uppercase;
  }

  .domain-docket-claim dd {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.8rem;
    line-height: 1.55;
  }

  .domain-docket-custody {
    display: grid;
    gap: 1rem;
    padding-left: 1.2rem;
    border-left: 1px solid rgba(105, 225, 224, 0.24);
  }

  .domain-docket-pass {
    justify-self: start;
    border: 1px solid rgba(105, 225, 224, 0.55);
    padding: 0.28rem 0.45rem;
    color: var(--color-accent-teal, #69e1e0);
    font-family: var(--font-mono);
    font-size: 0.58rem;
  }

  .domain-docket-custody dd {
    min-width: 0;
    margin: 0;
  }

  .domain-docket-custody code {
    display: block;
    overflow-wrap: anywhere;
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    line-height: 1.45;
  }

  .domain-docket-custody a {
    display: inline-flex;
    gap: 0.45rem;
    align-items: center;
    justify-self: start;
    color: var(--color-accent-gold-soft);
    font-size: 0.75rem;
    text-decoration: none;
  }

  .domain-docket-custody a:hover {
    text-decoration: underline;
  }

  @media (max-width: 1050px) {
    .domain-docket-row {
      grid-template-columns: 5rem minmax(150px, 0.55fr) minmax(0, 1fr);
    }

    .domain-docket-custody {
      grid-column: 2 / -1;
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: start;
    }

    .domain-docket-custody dl {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .domain-docket-header {
      grid-template-columns: 1fr;
    }

    .domain-docket-header > p {
      grid-column: auto;
    }

    .domain-docket-row {
      grid-template-columns: 3.5rem minmax(0, 1fr);
      gap: 1rem;
      padding: 1.6rem 0;
    }

    .domain-docket-figure,
    .domain-docket-claim,
    .domain-docket-custody {
      grid-column: 2;
    }

    .domain-docket-custody {
      grid-template-columns: 1fr;
      padding-left: 0;
      border-top: 1px solid rgba(105, 225, 224, 0.24);
      border-left: 0;
      padding-top: 1rem;
    }

    .domain-docket-custody dl {
      grid-template-columns: 1fr;
    }
  }
</style>
