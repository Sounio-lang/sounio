---
import { getLocalizedPath } from '../../lib/i18n';
import type { Locale } from '../../lib/i18n';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;

const t: Record<string, {
  heading: string;
  subhead: string;
  cards: { tag: string; headline: string; fact: string; desc: string; link: string }[];
}> = {
  en: {
    heading: 'The type system travels.',
    subhead: '130 stdlib modules. Four domains no other compiled language reaches with compile-time uncertainty, effects, and algebra together.',
    cards: [
      {
        tag: 'PHARMACOKINETICS',
        headline: '16 compartments. One sedenion.',
        fact: '14-compartment PBPK · Cayley-Dickson transfer dynamics · GUM-exact ODE',
        desc: 'Each sedenion basis element encodes one anatomical compartment. Drug transfer between tissues is Cayley-Dickson multiplication — the algebra is the pharmacokinetics.',
        link: '/dissertation',
      },
      {
        tag: 'STANDARD MODEL',
        headline: '18 constants. Every σ. Enforced.',
        fact: '31 modules · PDG uncertainties at every vertex · LO QED ±2% vs CERN data',
        desc: 'The 18 Standard Model parameters carry their PDG uncertainties as Knowledge<f64>. The type checker enforces error budgets through every Feynman amplitude.',
        link: '/proof#standard-model',
      },
      {
        tag: 'COMPUTATIONAL PSYCHIATRY',
        headline: 'Double-bind dynamics. In code.',
        fact: 'Bateson L0-L3 · Spencer-Brown calculus · Pask eigenforms · executable Maturana',
        desc: "Second-order cybernetics formalized as running programs. Double-bind dynamics, schismogenesis, autopoiesis — not metaphors. Types.",
        link: '/science',
      },
      {
        tag: 'QUANTUM COMPUTING',
        headline: 'No-cloning. In the type system.',
        fact: 'Linear-typed qubits · Bell pairs · VQE H₂ ground state · compile-time no-copy',
        desc: 'Linear types make quantum cloning a compile error. No runtime check. No convention. The no-cloning theorem is a constraint on the type of Qubit.',
        link: '/proof#quantum-linear',
      },
    ],
  },
  pt: {
    heading: 'O sistema de tipos viaja.',
    subhead: '130 módulos da stdlib. Quatro domínios que nenhuma linguagem compilada alcança com incerteza, efeitos e álgebra em tempo de compilação.',
    cards: [
      {
        tag: 'FARMACOCINÉTICA',
        headline: '16 compartimentos. Um sedenion.',
        fact: 'PBPK de 14 compartimentos · dinâmica de transferência Cayley-Dickson · ODE GUM-exata',
        desc: 'Cada elemento de base sedenion codifica um compartimento anatómico. A transferência de medicamento entre tecidos é multiplicação Cayley-Dickson — a álgebra é a farmacocinética.',
        link: '/dissertation',
      },
      {
        tag: 'MODELO PADRÃO',
        headline: '18 constantes. Cada σ. Aplicado.',
        fact: '31 módulos · incertezas PDG em cada vértice · QED LO ±2% vs dados CERN',
        desc: 'Os 18 parâmetros do Modelo Padrão carregam as suas incertezas PDG como Knowledge<f64>. O verificador de tipos aplica orçamentos de erro em cada amplitude de Feynman.',
        link: '/proof#standard-model',
      },
      {
        tag: 'PSIQUIATRIA COMPUTACIONAL',
        headline: 'Dinâmica de duplo vínculo. Em código.',
        fact: 'Bateson L0-L3 · cálculo Spencer-Brown · eigenformas Pask · Maturana executável',
        desc: 'A cibernética de segunda ordem formalizada como programas em execução. Dinâmica de duplo vínculo, esquismogénese, autopoiese — não metáforas. Tipos.',
        link: '/science',
      },
      {
        tag: 'COMPUTAÇÃO QUÂNTICA',
        headline: 'Sem clonagem. No sistema de tipos.',
        fact: 'Qubits lineares · pares Bell · VQE H₂ · sem cópia em tempo de compilação',
        desc: 'Os tipos lineares tornam a clonagem quântica um erro de compilação. Sem verificação em tempo de execução. Sem convenção. O teorema sem clonagem é uma restrição no tipo de Qubit.',
        link: '/proof#quantum-linear',
      },
    ],
  },
  es: {
    heading: 'El sistema de tipos viaja.',
    subhead: '130 módulos de stdlib. Cuatro dominios que ningún otro lenguaje compilado alcanza con incertidumbre, efectos y álgebra en tiempo de compilación.',
    cards: [
      {
        tag: 'FARMACOCINÉTICA',
        headline: '16 compartimentos. Un sedenion.',
        fact: 'PBPK de 14 compartimentos · dinámica de transferencia Cayley-Dickson · EDO GUM-exacta',
        desc: 'Cada elemento de base sedenion codifica un compartimento anatómico. La transferencia de fármacos entre tejidos es multiplicación Cayley-Dickson — el álgebra es la farmacocinética.',
        link: '/dissertation',
      },
      {
        tag: 'MODELO ESTÁNDAR',
        headline: '18 constantes. Cada σ. Aplicado.',
        fact: '31 módulos · incertidumbres PDG en cada vértice · QED LO ±2% vs datos CERN',
        desc: 'Los 18 parámetros del Modelo Estándar llevan sus incertidumbres PDG como Knowledge<f64>. El verificador de tipos impone presupuestos de error en cada amplitud de Feynman.',
        link: '/proof#standard-model',
      },
      {
        tag: 'PSIQUIATRÍA COMPUTACIONAL',
        headline: 'Dinámica de doble vínculo. En código.',
        fact: 'Bateson L0-L3 · cálculo Spencer-Brown · eigenformas Pask · Maturana ejecutable',
        desc: 'La cibernética de segundo orden formalizada como programas en ejecución. Dinámicas de doble vínculo, esquismogénesis, autopoiesis — no metáforas. Tipos.',
        link: '/science',
      },
      {
        tag: 'COMPUTACIÓN CUÁNTICA',
        headline: 'Sin clonación. En el sistema de tipos.',
        fact: 'Qubits lineales · pares Bell · VQE H₂ · sin copia en tiempo de compilación',
        desc: 'Los tipos lineales hacen que la clonación cuántica sea un error de compilación. Sin comprobación en tiempo de ejecución. Sin convención. El teorema de no clonación es una restricción sobre el tipo de Qubit.',
        link: '/proof#quantum-linear',
      },
    ],
  },
  el: {
    heading: 'Το σύστημα τύπων ταξιδεύει.',
    subhead: '130 ενότητες stdlib. Τέσσερις τομείς που καμία άλλη μεταγλωττισμένη γλώσσα δεν φτάνει με αβεβαιότητα, εφέ και άλγεβρα κατά τη μεταγλώττιση.',
    cards: [
      {
        tag: 'ΦΑΡΜΑΚΟΚΙΝΗΤΙΚΗ',
        headline: '16 διαμερίσματα. Ένα sedenion.',
        fact: 'PBPK 14 διαμερισμάτων · δυναμική μεταφοράς Cayley-Dickson · GUM-ακριβής ODE',
        desc: 'Κάθε βασικό στοιχείο sedenion κωδικοποιεί ένα ανατομικό διαμέρισμα. Η μεταφορά φαρμάκου μεταξύ ιστών είναι πολλαπλασιασμός Cayley-Dickson — η άλγεβρα είναι η φαρμακοκινητική.',
        link: '/dissertation',
      },
      {
        tag: 'ΤΥΠΙΚΟ ΠΡΟΤΥΠΟ',
        headline: '18 σταθερές. Κάθε σ. Εφαρμοσμένο.',
        fact: '31 ενότητες · αβεβαιότητες PDG σε κάθε κορυφή · QED LO ±2% vs δεδομένα CERN',
        desc: 'Οι 18 παράμετροι του Τυπικού Προτύπου φέρουν τις αβεβαιότητές τους PDG ως Knowledge<f64>. Ο ελεγκτής τύπων επιβάλλει προϋπολογισμούς σφάλματος μέσω κάθε πλάτους Feynman.',
        link: '/proof#standard-model',
      },
      {
        tag: 'ΥΠΟΛΟΓΙΣΤΙΚΗ ΨΥΧΙΑΤΡΙΚΗ',
        headline: 'Δυναμική διπλού δεσμού. Σε κώδικα.',
        fact: 'Bateson L0-L3 · λογισμός Spencer-Brown · eigenμορφές Pask · εκτελέσιμος Maturana',
        desc: 'Η κυβερνητική δεύτερης τάξης τυποποιημένη ως εκτελούμενα προγράμματα. Δυναμική διπλού δεσμού, σχισμογένεση, αυτοποίηση — όχι μεταφορές. Τύποι.',
        link: '/science',
      },
      {
        tag: 'ΚΒΑΝΤΙΚΗ ΥΠΟΛΟΓΙΣΤΙΚΗ',
        headline: 'Χωρίς κλωνοποίηση. Στο σύστημα τύπων.',
        fact: 'Γραμμικά qubits · ζεύγη Bell · VQE H₂ · χωρίς αντιγραφή κατά τη μεταγλώττιση',
        desc: 'Οι γραμμικοί τύποι κάνουν την κβαντική κλωνοποίηση σφάλμα μεταγλώττισης. Χωρίς έλεγχο χρόνου εκτέλεσης. Χωρίς σύμβαση. Το θεώρημα μη-κλωνοποίησης είναι περιορισμός στον τύπο Qubit.',
        link: '/proof#quantum-linear',
      },
    ],
  },
  zh: {
    heading: '类型系统在旅行。',
    subhead: '130个标准库模块。四个领域——没有其他编译语言能在编译时同时实现不确定性、效应和代数。',
    cards: [
      {
        tag: '药物代谢动力学',
        headline: '16个隔室。一个赛德尼翁。',
        fact: '14隔室PBPK · Cayley-Dickson转移动力学 · GUM精确ODE',
        desc: '每个赛德尼翁基元素编码一个解剖隔室。药物在组织间的转移是Cayley-Dickson乘法——代数即药代动力学。',
        link: '/dissertation',
      },
      {
        tag: '标准模型',
        headline: '18个常数。每个σ。强制执行。',
        fact: '31个模块 · 每个顶点的PDG不确定性 · LO QED ±2% vs CERN数据',
        desc: '18个标准模型参数以Knowledge<f64>携带其PDG不确定性。类型检查器在每个费曼振幅中强制执行误差预算。',
        link: '/proof#standard-model',
      },
      {
        tag: '计算精神病学',
        headline: '双重束缚动力学。在代码中。',
        fact: 'Bateson L0-L3 · Spencer-Brown演算 · Pask本征形式 · 可执行Maturana',
        desc: '二阶控制论形式化为运行程序。双重束缚动力学、分裂生成、自生——不是隐喻。是类型。',
        link: '/science',
      },
      {
        tag: '量子计算',
        headline: '禁止克隆。在类型系统中。',
        fact: '线性类型量子比特 · Bell对 · VQE H₂基态 · 编译时禁止复制',
        desc: '线性类型使量子克隆成为编译错误。没有运行时检查。没有约定。不克隆定理是对量子比特类型的约束。',
        link: '/proof#quantum-linear',
      },
    ],
  },
  ja: {
    heading: '型システムが旅する。',
    subhead: '130のstdlibモジュール。コンパイル時の不確実性、エフェクト、代数を同時に持つ他のコンパイル言語が届かない4つの領域。',
    cards: [
      {
        tag: '薬物動態学',
        headline: '16コンパートメント。1つのセデニオン。',
        fact: '14コンパートメントPBPK · Cayley-Dickson移動動力学 · GUM正確ODE',
        desc: '各セデニオン基底要素が1つの解剖学的コンパートメントをエンコードします。組織間の薬物移動はCayley-Dickson乗算です——代数が薬物動態です。',
        link: '/dissertation',
      },
      {
        tag: '標準模型',
        headline: '18の定数。すべてのσ。強制。',
        fact: '31モジュール · 各頂点でPDG不確実性 · LO QED ±2% vs CERNデータ',
        desc: '18の標準モデルパラメータがKnowledge<f64>としてPDG不確実性を持ちます。型チェッカーがすべてのファインマン振幅でエラーバジェットを強制します。',
        link: '/proof#standard-model',
      },
      {
        tag: '計算精神医学',
        headline: 'ダブルバインド動力学。コードで。',
        fact: 'Bateson L0-L3 · Spencer-Brown計算 · Pask固有形式 · 実行可能Maturana',
        desc: '二次サイバネティクスを実行プログラムとして形式化。ダブルバインド動力学、分裂生成、オートポイエーシス——メタファーではありません。型です。',
        link: '/science',
      },
      {
        tag: '量子コンピューティング',
        headline: '不可複製。型システムで。',
        fact: '線形型量子ビット · Bellペア · VQE H₂基底状態 · コンパイル時コピー禁止',
        desc: '線形型により量子クローンがコンパイルエラーになります。ランタイムチェックなし。慣例なし。不可複製定理はQubit型への制約です。',
        link: '/proof#quantum-linear',
      },
    ],
  },
};

const d = t[locale] ?? t.en;

const accentColors = [
  'rgba(43,166,179,0.6)',   // teal — pharmacokinetics
  'rgba(214,179,90,0.5)',   // gold — standard model
  'rgba(180,100,220,0.5)',  // violet — psychiatry
  'rgba(100,180,255,0.45)', // blue — quantum
];
---

<section class="fa-section">
  <div class="fa-inner">
    <div class="fa-header">
      <h2 class="fa-heading">{d.heading}</h2>
      <p class="fa-subhead">{d.subhead}</p>
    </div>

    <div class="fa-grid">
      {d.cards.map((card, i) => (
        <article class="fa-card" style={`--card-accent: ${accentColors[i]}`}>
          <p class="fa-tag">{card.tag}</p>
          <h3 class="fa-headline">{card.headline}</h3>
          <p class="fa-fact"><code>{card.fact}</code></p>
          <p class="fa-desc">{card.desc}</p>
          <a href={getLocalizedPath(card.link, locale)} class="fa-link">Explore →</a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .fa-section {
    padding: 4.5rem 1.5rem 5rem;
    border-top: 1px solid var(--glass-border);
  }

  .fa-inner {
    max-width: 980px;
    margin: 0 auto;
    display: grid;
    gap: 2.8rem;
  }

  .fa-header {
    display: grid;
    gap: 0.65rem;
    max-width: 680px;
  }

  .fa-heading {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.5vw, 2.5rem);
    font-weight: 400;
    color: var(--color-text-primary);
    margin: 0;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .fa-subhead {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    margin: 0;
    max-width: 60ch;
    line-height: 1.65;
  }

  .fa-grid {
    display: grid;
    gap: 1.1rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .fa-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .fa-card {
    position: relative;
    background: #0d1a2d;
    border: 1px solid var(--glass-border);
    border-left: 3px solid var(--card-accent, rgba(214,179,90,0.5));
    border-radius: 10px;
    padding: 1.3rem 1.3rem 1.1rem;
    display: grid;
    gap: 0.65rem;
    align-content: start;
    transition: border-color 0.2s;
  }

  .fa-card:hover {
    border-color: var(--glass-border);
    border-left-color: color-mix(in srgb, var(--card-accent) 140%, white);
  }

  .fa-tag {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    color: var(--color-accent-gold-soft);
    opacity: 0.7;
    margin: 0;
    text-transform: uppercase;
  }

  .fa-headline {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--color-text-primary);
    margin: 0;
    line-height: 1.3;
  }

  .fa-fact {
    margin: 0;
  }

  .fa-fact code {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-text-tertiary, rgba(255,255,255,0.38));
    letter-spacing: 0.01em;
    line-height: 1.5;
  }

  .fa-desc {
    font-size: 0.86rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .fa-link {
    font-size: 0.78rem;
    color: var(--color-accent-gold-soft);
    text-decoration: none;
    margin-top: 0.2rem;
  }

  .fa-link:hover { text-decoration: underline; }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    const section = document.querySelector<HTMLElement>('.fa-section');
    if (!section) return;

    gsap.from('.fa-heading, .fa-subhead', {
      y: 18,
      opacity: 0,
      stagger: 0.1,
      duration: 0.6,
      ease: 'power2.out',
      scrollTrigger: { trigger: section, start: 'top 78%', once: true },
    });

    gsap.from('.fa-card', {
      y: 38,
      opacity: 0,
      stagger: 0.12,
      duration: 0.7,
      ease: 'power2.out',
      scrollTrigger: { trigger: '.fa-grid', start: 'top 82%', once: true },
    });
  });
</script>
