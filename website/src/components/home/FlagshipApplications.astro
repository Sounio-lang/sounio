        link: '/proof#differential-privacy',
      },
      {
        tag: '幾何学証明',
        headline: 'IMO定理。正直な確信度。',
        fact: 'AlphaGeoZero · Beta分布解確信度 · 初のε付き幾何学証明器',
        desc: 'AlphaGeoZeroはIMO幾何問題を証明し、問題ごとの確信度をBeta分布として報告します——不確実性を定量化する最初の幾何学証明器。',
        link: '/proof#alphageozero',
      },
      {
        tag: 'ブラウザランタイム',
        headline: 'ブラウザで動く。インストール不要。',
        fact: 'WASMターゲット · クライアントサイドラパマイシンPBPK · souc build --backend wasm',
        desc: 'WebAssemblyにコンパイル。論文PBPKモデルがブラウザタブで動作——完全なstdlib、サーバーゼロ、認識型そのまま。',
        link: '/playground',
      },
    ],
  },
};

const d = t[locale] ?? t.en;

const accentColors = [
  'rgba(43,166,179,0.6)',   // teal   — pharmacokinetics
  'rgba(214,179,90,0.5)',   // gold   — standard model
  'rgba(180,100,220,0.5)',  // violet — psychiatry
  'rgba(100,180,255,0.45)', // blue   — quantum
  'rgba(80,200,120,0.5)',   // green  — units
  'rgba(255,120,80,0.5)',   // coral  — privacy
  'rgba(255,200,60,0.45)',  // amber  — geometry
  'rgba(160,210,255,0.4)',  // sky    — wasm
];
---

<section class="fa-section">
  <div class="fa-inner">
    <div class="fa-header">
      <h2 class="fa-heading">{d.heading}</h2>
      <p class="fa-subhead">{d.subhead}</p>
    </div>

    <div class="fa-grid">
      {d.cards.map((card, i) => (
        <article class="fa-card" style={`--card-accent: ${accentColors[i]}`}>
          <p class="fa-tag">{card.tag}</p>
          <h3 class="fa-headline">{card.headline}</h3>
          <p class="fa-fact"><code>{card.fact}</code></p>
          <p class="fa-desc">{card.desc}</p>
          <a href={getLocalizedPath(card.link, locale)} class="fa-link">Explore →</a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .fa-section {
    padding: 4.5rem 1.5rem 5rem;
    border-top: 1px solid var(--glass-border);
  }

  .fa-inner {
    max-width: 980px;
    margin: 0 auto;
    display: grid;
    gap: 2.8rem;
  }

  .fa-header {
    display: grid;
    gap: 0.65rem;
    max-width: 680px;
  }

  .fa-heading {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.5vw, 2.5rem);
    font-weight: 400;
    color: var(--color-text-primary);
    margin: 0;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .fa-subhead {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    margin: 0;
    max-width: 60ch;
    line-height: 1.65;
  }

  .fa-grid {
    display: grid;
    gap: 1.1rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .fa-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .fa-card {
    background: #0d1a2d;
    border: 1px solid var(--glass-border);
    border-left: 3px solid var(--card-accent, rgba(214,179,90,0.5));
    border-radius: 10px;
    padding: 1.3rem 1.3rem 1.1rem;
    display: grid;
    gap: 0.65rem;
    align-content: start;
    transition: border-left-color 0.2s;
  }

  .fa-card:hover {
    border-left-color: color-mix(in srgb, var(--card-accent) 160%, white 40%);
  }

  .fa-tag {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    color: var(--color-accent-gold-soft);
    opacity: 0.7;
    margin: 0;
    text-transform: uppercase;
  }

  .fa-headline {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--color-text-primary);
    margin: 0;
    line-height: 1.3;
  }

  .fa-fact {
    margin: 0;
  }

  .fa-fact code {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-text-tertiary, rgba(255,255,255,0.38));
    letter-spacing: 0.01em;
    line-height: 1.5;
  }

  .fa-desc {
    font-size: 0.86rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .fa-link {
    font-size: 0.78rem;
    color: var(--color-accent-gold-soft);
    text-decoration: none;
    margin-top: 0.2rem;
  }

  .fa-link:hover { text-decoration: underline; }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    const section = document.querySelector<HTMLElement>('.fa-section');
    if (!section) return;

    gsap.from('.fa-heading, .fa-subhead', {
      y: 18,
      opacity: 0,
      stagger: 0.1,
      duration: 0.6,
      ease: 'power2.out',
      scrollTrigger: { trigger: section, start: 'top 78%', once: true },
    });

    gsap.from('.fa-card', {
      y: 38,
      opacity: 0,
      stagger: 0.09,
      duration: 0.65,
      ease: 'power2.out',
      scrollTrigger: { trigger: '.fa-grid', start: 'top 85%', once: true },
    });
  });
</script>
