---
import { getLocalizedPath, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isPt = locale === 'pt';

const worlds = [
  {
    index: '01',
    name: isPt ? 'Linguagem' : 'Language',
    statement: isPt ? 'Semântica que preserva consequências.' : 'Semantics that preserve consequences.',
    evidence: '16 / 16 conformance',
    state: 'verified',
    href: '/language',
  },
  {
    index: '02',
    name: isPt ? 'Epistêmica' : 'Epistemics',
    statement: isPt ? 'Valor, variância, confiança e origem.' : 'Value, variance, confidence, and origin.',
    evidence: 'Zero Events executable',
    state: 'verified',
    href: '/language#epistemic-types',
  },
  {
    index: '03',
    name: isPt ? 'Ciência' : 'Science',
    statement: isPt ? 'Modelos com limites de claim visiveis.' : 'Models with visible claim boundaries.',
    evidence: '137 stdlib domains',
    state: 'research',
    href: '/science',
  },
  {
    index: '04',
    name: 'Formal',
    statement: isPt ? 'Prova mostrada teorema por teorema.' : 'Proof shown theorem by theorem.',
    evidence: 'Lean + executable witnesses',
    state: 'bounded',
    href: '/proof',
  },
  {
    index: '05',
    name: isPt ? 'Pesquisa' : 'Research',
    statement: isPt ? 'Da preregistração ao resultado nulo.' : 'From preregistration to honest nulls.',
    evidence: '223 campaign scripts',
    state: 'active',
    href: '/dissertation',
  },
  {
    index: '06',
    name: 'Tooling',
    statement: isPt ? 'REPL, LSP, editores e packages locais.' : 'REPL, LSP, editors, and local packages.',
    evidence: '6 pass / 1 warning',
    state: 'preview',
    href: '/learn/getting-started',
  },
];
---

<section id="system-atlas" class="system-atlas" aria-labelledby="system-atlas-title">
  <div class="container">
    <div class="atlas-heading">
      <div>
        <p>{isPt ? 'Um sistema. Seis mundos.' : 'One system. Six worlds.'}</p>
        <h2 id="system-atlas-title">{isPt ? 'O Sounio inteiro, finalmente visível.' : 'The whole Sounio, finally visible.'}</h2>
      </div>
      <p class="atlas-intro">
        {isPt
          ? 'Cada mundo liga código, prova, artefato e limite. Cada estado aparece com um recibo ou uma fronteira.'
          : 'Each world connects code, proof, artifact, and limit. Each state appears with a receipt or a boundary.'}
      </p>
    </div>

    <div class="atlas-list">
      {worlds.map((world) => (
        <a href={getLocalizedPath(world.href, locale)} class="atlas-row">
          <span class="atlas-index">{world.index}</span>
          <strong>{world.name}</strong>
          <span class="atlas-statement">{world.statement}</span>
          <span class="atlas-evidence">{world.evidence}</span>
          <span class:list={['atlas-state', `state-${world.state}`]}>{world.state}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .system-atlas {
    padding: 4.5rem 0 5.5rem;
    background: #f2f0ea;
    color: #0b1e3a;
    border-bottom: 1px solid #d4d0c5;
  }

  .atlas-heading {
    display: grid;
    grid-template-columns: 1fr minmax(280px, 0.65fr);
    gap: 2rem;
    align-items: end;
    padding-bottom: 2rem;
    border-bottom: 1px solid #b8b3a7;
  }

  .atlas-heading > div > p {
    margin: 0 0 0.65rem;
    color: #607080;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
  }

  .atlas-heading h2 {
    max-width: 16ch;
    margin: 0;
    color: #0b1e3a;
    font-family: var(--font-display);
    font-size: 2.9rem;
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.08;
  }

  .atlas-intro {
    max-width: 45ch;
    margin: 0;
    color: #536170;
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .atlas-list {
    display: grid;
  }

  .atlas-row {
    display: grid;
    grid-template-columns: 42px minmax(120px, 0.65fr) minmax(220px, 1.3fr) minmax(170px, 0.8fr) 92px;
    gap: 1rem;
    align-items: center;
    min-height: 70px;
    padding: 0.75rem 0;
    border-bottom: 1px solid #d4d0c5;
    color: #0b1e3a;
    transition: background 160ms ease, padding 160ms ease;
  }

  .atlas-row:hover {
    padding-right: 0.7rem;
    padding-left: 0.7rem;
    background: #e8e5dc;
    color: #0b1e3a;
  }

  .atlas-index,
  .atlas-evidence,
  .atlas-state {
    font-family: var(--font-mono);
  }

  .atlas-index {
    color: #8c753a;
    font-size: 0.7rem;
  }

  .atlas-row strong {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
  }

  .atlas-statement {
    color: #435261;
    font-size: 0.88rem;
  }

  .atlas-evidence {
    color: #607080;
    font-size: 0.68rem;
  }

  .atlas-state {
    justify-self: end;
    width: 82px;
    border: 1px solid currentColor;
    border-radius: 4px;
    font-size: 0.58rem;
    padding: 0.28rem 0.4rem;
    text-align: center;
    text-transform: uppercase;
  }

  .state-verified,
  .state-active {
    color: #1f756e;
  }

  .state-research,
  .state-preview {
    color: #35698c;
  }

  .state-bounded {
    color: #8d6b20;
  }

  @media (max-width: 900px) {
    .atlas-heading {
      grid-template-columns: 1fr;
    }

    .atlas-row {
      grid-template-columns: 34px minmax(100px, 0.7fr) 1.3fr 82px;
    }

    .atlas-evidence {
      display: none;
    }
  }

  @media (max-width: 620px) {
    .system-atlas {
      padding: 3.2rem 0 4rem;
    }

    .atlas-heading h2 {
      font-size: 2.2rem;
    }

    .atlas-row {
      grid-template-columns: 30px 1fr 80px;
      gap: 0.65rem;
      min-height: 76px;
    }

    .atlas-statement,
    .atlas-evidence {
      display: none;
    }
  }
</style>
