---
import featureStatus from '../../data/feature-status.json';
import { publicContract } from '../../data/artifactStatus';
import { getLocalizedPath, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isPt = locale === 'pt';
const { metrics } = publicContract;

const copy = isPt
  ? {
      label: 'CARTOGRAFIA DO SISTEMA',
      heading: 'Uma linguagem. Seis superfícies conectadas.',
      body: 'Sounio é um percurso da sintaxe aos efeitos, valores epistêmicos, artefatos de prova, aplicações e ao compilador self-hosted. Cada nó liga uma rota pública a um recibo versionado e ao limite daquela alegação.',
      inspect: 'Abrir superfície',
      receipt: 'recibo',
      source: 'fonte',
      boundary: 'limite',
    }
  : {
      label: 'SYSTEM CARTOGRAPHY',
      heading: 'One language. Six connected surfaces.',
      body: 'Sounio is a route from syntax to effects, epistemic values, proof artifacts, applications, and the self-hosted compiler. Each node connects a public route to a checked-in receipt and the boundary of that claim.',
      inspect: 'Open surface',
      receipt: 'receipt',
      source: 'source',
      boundary: 'boundary',
    };

const nodes = [
  {
    index: '01',
    name: isPt ? 'Linguagem' : 'Language',
    eyebrow: isPt ? 'Sintaxe, tipos, ownership' : 'Syntax, types, ownership',
    body: isPt
      ? 'O spine de conformidade nomeia casos para sintaxe, execução, estruturas, imports, generics, ownership, efeitos e fronteiras epistêmicas.'
      : 'The conformance spine names cases for syntax, execution, structs, imports, generics, ownership, effects, and epistemic boundaries.',
    receipt: `linear_types=${featureStatus.features.linear_types.status} · named conformance cases`,
    source: 'tests/conformance/manifest.v1.tsv',
    boundary: isPt ? 'Matriz parcialmente executável; não é conformidade exaustiva da spec.' : 'Partially executable matrix; not exhaustive spec conformance.',
    status: 'production',
    href: '/language',
  },
  {
    index: '02',
    name: isPt ? 'Efeitos' : 'Effects',
    eyebrow: 'IO · Mut · Div · Panic · Observe',
    body: isPt
      ? 'Um caso positivo exercita effect-row superset; um fixture negativo exige o diagnóstico de efeito ausente.'
      : 'One positive case exercises effect-row superset calling; one negative fixture requires a missing-effect diagnostic.',
    receipt: `effects_system=${featureStatus.features.effects_system.status} · pass + refuse`,
    source: 'tests/run-pass/effect_superset_ok.sio · tests/compile-fail/effect_missing.sio',
    boundary: isPt ? 'Recibo de subtyping e diagnóstico, não de todo handler customizado.' : 'A subtyping and diagnostic receipt, not proof of every custom handler.',
    status: 'production',
    href: '/language#effects',
  },
  {
    index: '03',
    name: isPt ? 'Epistêmica' : 'Epistemics',
    eyebrow: 'Knowledge<T> · confidence · provenance',
    body: isPt
      ? 'Exemplos GUM executam; uma fronteira compile-fail impede que Knowledge<f64> vire f64 silenciosamente.'
      : 'GUM examples run; a compile-fail boundary prevents Knowledge<f64> from silently becoming f64.',
    receipt: `epistemic_knowledge=${featureStatus.features.epistemic_knowledge.status} · no silent unwrap`,
    source: 'tests/run-pass/gum_compliance.sio · tests/compile-fail/knowledge_no_silent_unwrap.sio',
    boundary: isPt ? 'Núcleo exercitado; não declara toda a stdlib epistêmica madura.' : 'Core behavior exercised; not a claim that the entire epistemic stdlib is mature.',
    status: 'production',
    href: '/language#epistemic-types',
  },
  {
    index: '04',
    name: isPt ? 'Prova' : 'Proof',
    eyebrow: isPt ? 'Claims com recibos' : 'Claims with receipts',
    body: isPt
      ? 'Lean verifica um lattice limitado de confiança, ordenação de Knowledge e leis de medição sem sorry naquele arquivo.'
      : 'Lean checks a bounded confidence lattice, Knowledge ordering, and measurement laws with no sorry in that file.',
    receipt: `stdlib ${metrics.stdlibReliabilityGate.pass}/${metrics.stdlibReliabilityGate.total} · fail ${metrics.stdlibReliabilityGate.fail}`,
    source: 'formal/lean4/SounioEpistemic.lean',
    boundary: isPt ? 'Modelo formal limitado a Nat; não é prova end-to-end do compilador.' : 'Nat-bounded formal model; not an end-to-end compiler soundness proof.',
    status: 'artifact',
    href: '/proof',
  },
  {
    index: '05',
    name: isPt ? 'Aplicações' : 'Applications',
    eyebrow: isPt ? 'Clínica, causal, neuro, clima' : 'Clinical, causal, neuro, climate',
    body: isPt
      ? 'Um fixture ilustrativo e autorado exercita uma recusa compile-fail antes de uma chamada simulada de prescrição.'
      : 'An illustrative authored fixture exercises compile-fail rejection before a simulated prescribing call.',
    receipt: 'compile-fail: vancomycin_low_conf',
    source: 'tests/compile-fail/vancomycin_low_conf.sio',
    boundary: isPt ? 'Fixture com epsilon autorado; não é validação clínica nem orientação de dose.' : 'Authored epsilon-bound fixture; not clinical validation or dosing guidance.',
    status: 'bounded',
    href: '/showcases',
  },
  {
    index: '06',
    name: 'Self-hosting',
    eyebrow: isPt ? 'O compilador fecha o ciclo' : 'The compiler closes the loop',
    body: isPt
      ? 'O gate canônico pede ao compilador lean_single preservado que reproduza um executável byte-idêntico de sua própria fonte Sounio.'
      : 'The canonical gate asks the preserved lean_single compiler to reproduce a byte-identical executable from its own Sounio source.',
    receipt: 'canonical gate · gen2 == gen3',
    source: 'scripts/ci/canonical_compiler_gate.sh · self-hosted/compiler/lean_single.sio',
    boundary: isPt ? 'Gate Linux x86-64 do seed preservado; bin/souc usa Madaros por padrão.' : 'Linux x86-64 preserved-seed gate; bin/souc defaults to Madaros.',
    status: 'recorded',
    href: '/compiler#bootstrap',
  },
];
---

<section id="system-atlas" class="system-map" aria-labelledby="system-map-title">
  <div class="container system-map-shell">
    <header class="system-map-intro">
      <p class="system-map-label">{copy.label}</p>
      <h2 id="system-map-title">{copy.heading}</h2>
      <p class="system-map-body">{copy.body}</p>
      <div class="system-map-key" aria-hidden="true">
        <span>syntax</span><i></i><span>effect</span><i></i><span>claim</span><i></i><span>artifact</span>
      </div>
    </header>

    <ol class="system-map-route" aria-label={copy.label}>
      {nodes.map((node) => (
        <li class="system-map-stop">
          <a href={getLocalizedPath(node.href, locale)} class="system-map-node">
            <span class="system-map-index">{node.index}</span>
            <span class="system-map-copy">
              <small>{node.eyebrow}</small>
              <strong>{node.name}</strong>
              <span class="system-map-description">{node.body}</span>
            </span>
            <span class="system-map-evidence">
              <span class:list={['system-map-status', `is-${node.status}`]}>{node.status}</span>
              <span><b>{copy.receipt}</b><code>{node.receipt}</code></span>
              <span><b>{copy.source}</b><code>{node.source}</code></span>
              <span class="system-map-boundary"><b>{copy.boundary}</b><code>{node.boundary}</code></span>
            </span>
            <span class="system-map-open">{copy.inspect}<span aria-hidden="true">↗</span></span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .system-map {
    overflow: hidden;
    padding: 6rem 0;
    border-block: 1px solid rgba(214, 179, 90, 0.2);
    background:
      linear-gradient(90deg, rgba(214, 179, 90, 0.025) 1px, transparent 1px),
      linear-gradient(rgba(214, 179, 90, 0.025) 1px, transparent 1px),
      #040d1a;
    background-size: 48px 48px;
    color: var(--color-text-primary);
  }

  .system-map-shell {
    display: grid;
    grid-template-columns: minmax(260px, 0.62fr) minmax(0, 1.38fr);
    gap: clamp(3rem, 7vw, 7rem);
    align-items: start;
  }

  .system-map-intro {
    position: sticky;
    top: 7rem;
    display: grid;
    gap: 1.2rem;
  }

  .system-map-label {
    margin: 0;
    color: var(--color-accent-gold-soft);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .system-map-intro h2 {
    max-width: 10ch;
    margin: 0;
    color: var(--color-text-primary);
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 5vw, 4.8rem);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: 0;
  }

  .system-map-body {
    max-width: 42ch;
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    line-height: 1.72;
  }

  .system-map-key {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.8rem;
    color: var(--color-text-tertiary);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    text-transform: uppercase;
  }

  .system-map-key i {
    width: 1rem;
    height: 1px;
    background: rgba(214, 179, 90, 0.55);
  }

  .system-map-route {
    position: relative;
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .system-map-route::before {
    position: absolute;
    top: 2.25rem;
    bottom: 2.25rem;
    left: 1.15rem;
    width: 1px;
    background: linear-gradient(var(--color-accent-gold), rgba(214, 179, 90, 0.14));
    content: '';
  }

  .system-map-stop {
    position: relative;
    margin: 0;
    border-top: 1px solid rgba(214, 179, 90, 0.18);
  }

  .system-map-stop:last-child {
    border-bottom: 1px solid rgba(214, 179, 90, 0.18);
  }

  .system-map-node {
    position: relative;
    display: grid;
    grid-template-columns: 2.3rem minmax(180px, 0.75fr) minmax(250px, 1fr) auto;
    gap: 1.1rem;
    align-items: center;
    min-height: 9.1rem;
    padding: 1.25rem 0.2rem;
    color: inherit;
    text-decoration: none;
    transition: background var(--transition-fast), border-color var(--transition-fast);
  }

  .system-map-node::before {
    position: absolute;
    top: 50%;
    left: 0.82rem;
    width: 0.72rem;
    height: 0.72rem;
    border: 2px solid var(--color-accent-gold);
    border-radius: 50%;
    background: #040d1a;
    content: '';
    transform: translateY(-50%);
    transition: background var(--transition-fast), box-shadow var(--transition-fast);
  }

  .system-map-node:hover,
  .system-map-node:focus-visible {
    background: rgba(214, 179, 90, 0.055);
    color: inherit;
  }

  .system-map-node:hover::before,
  .system-map-node:focus-visible::before {
    background: var(--color-accent-gold);
    box-shadow: 0 0 0 7px rgba(214, 179, 90, 0.1);
  }

  .system-map-node:focus-visible {
    outline: 2px solid var(--color-accent-gold);
    outline-offset: 3px;
  }

  .system-map-index {
    position: relative;
    z-index: 1;
    color: var(--color-accent-gold-soft);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    text-align: center;
  }

  .system-map-copy {
    display: grid;
    min-width: 0;
    gap: 0.35rem;
  }

  .system-map-copy small {
    color: var(--color-text-tertiary);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    line-height: 1.45;
  }

  .system-map-copy strong {
    color: var(--color-text-primary);
    font-family: var(--font-display);
    font-size: 1.65rem;
    font-weight: 500;
    line-height: 1.1;
  }

  .system-map-description {
    color: var(--color-text-secondary);
    font-size: 0.78rem;
    line-height: 1.55;
  }

  .system-map-evidence {
    display: grid;
    min-width: 0;
    gap: 0.48rem;
  }

  .system-map-evidence > span:not(.system-map-status) {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 0.55rem;
    align-items: baseline;
  }

  .system-map-evidence b {
    color: var(--color-text-tertiary);
    font-family: var(--font-mono);
    font-size: 0.54rem;
    font-weight: 400;
    text-transform: uppercase;
  }

  .system-map-evidence code {
    min-width: 0;
    overflow: hidden;
    color: #8bc9c2;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    line-height: 1.45;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .system-map-status {
    width: fit-content;
    padding: 0.22rem 0.45rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    color: var(--color-accent-gold-soft);
    font-family: var(--font-mono);
    font-size: 0.52rem;
    text-transform: uppercase;
  }

  .system-map-status.is-bounded,
  .system-map-status.is-artifact {
    color: var(--color-text-secondary);
  }

  .system-map-open {
    display: inline-flex;
    gap: 0.35rem;
    align-items: center;
    color: var(--color-accent-gold-soft);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    white-space: nowrap;
    text-transform: uppercase;
  }

  @media (max-width: 1050px) {
    .system-map-shell {
      grid-template-columns: minmax(230px, 0.52fr) minmax(0, 1.48fr);
      gap: 2.5rem;
    }

    .system-map-node {
      grid-template-columns: 2.3rem minmax(150px, 0.8fr) minmax(210px, 1fr);
    }

    .system-map-open {
      display: none;
    }
  }

  @media (max-width: 800px) {
    .system-map {
      padding: 4.5rem 0;
      background-size: 36px 36px;
    }

    .system-map-shell {
      grid-template-columns: 1fr;
    }

    .system-map-intro {
      position: static;
    }

    .system-map-intro h2 {
      max-width: 12ch;
    }
  }

  @media (max-width: 560px) {
    .system-map {
      padding: 3.8rem 0;
    }

    .system-map-key {
      gap: 0.4rem;
      font-size: 0.52rem;
    }

    .system-map-key i {
      width: 0.6rem;
    }

    .system-map-route::before {
      left: 0.92rem;
    }

    .system-map-node {
      grid-template-columns: 1.85rem minmax(0, 1fr);
      gap: 0.8rem;
      min-height: 0;
      padding: 1.35rem 0;
    }

    .system-map-node::before {
      left: 0.6rem;
    }

    .system-map-copy strong {
      font-size: 1.45rem;
    }

    .system-map-description {
      font-size: 0.76rem;
    }

    .system-map-evidence {
      grid-column: 2;
      margin-top: 0.25rem;
    }

    .system-map-evidence > span:not(.system-map-status) {
      grid-template-columns: 2.7rem minmax(0, 1fr);
    }

    .system-map-evidence code {
      white-space: normal;
      overflow-wrap: anywhere;
    }
  }
</style>
