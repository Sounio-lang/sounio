---
---

<section class="py-[clamp(2.5rem,5vw,4rem)] bg-[color-mix(in_srgb,var(--color-bg-alt)_74%,transparent)] border-y border-[var(--glass-border)]">
  <div class="container px-4">
    <div class="numbers-grid grid grid-cols-2 md:grid-cols-4 gap-8 max-w-5xl mx-auto">
      <div class="text-center" data-count-target="660000" data-count-suffix="K">
        <div class="count-number text-5xl md:text-7xl font-extrabold text-[var(--color-text-primary)] tracking-tight mb-2">
          660K
        </div>
        <div class="text-sm text-[var(--color-text-secondary)]">Lines of Code</div>
      </div>

      <div class="text-center" data-count-target="168000" data-count-suffix="K">
        <div class="count-number text-5xl md:text-7xl font-extrabold text-[var(--color-text-primary)] tracking-tight mb-2">
          927
        </div>
        <div class="text-sm text-[var(--color-text-secondary)]">Stdlib .sio Files</div>
      </div>

      <div class="text-center" data-count-target="604" data-count-suffix="">
        <div class="count-number text-5xl md:text-7xl font-extrabold text-[var(--color-text-primary)] tracking-tight mb-2">
          839
        </div>
        <div class="text-sm text-[var(--color-text-secondary)]">Tests Pass / 920</div>
      </div>

      <div class="text-center" data-count-target="80" data-count-suffix="">
        <div class="count-number text-5xl md:text-7xl font-extrabold text-[var(--color-text-primary)] tracking-tight mb-2">
          80
        </div>
        <div class="text-sm text-[var(--color-text-secondary)]">Stdlib Modules</div>
      </div>
    </div>
  </div>
</section>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const items = entry.target.querySelectorAll('[data-count-target]');
          items.forEach((item) => {
            const el = item as HTMLElement;
            const target = parseInt(el.dataset.countTarget || '0', 10);
            const suffix = el.dataset.countSuffix || '';
            const numberEl = el.querySelector('.count-number');
            if (!numberEl) return;

            const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            if (prefersReducedMotion) return;

            const duration = 1500;
            const startTime = performance.now();

            const format = (n: number): string => {
              if (suffix === 'K') return Math.floor(n / 1000) + 'K';
              if (suffix === 'M+') return Math.floor(n / 1000000) + 'M+';
              return n.toString();
            };

            const animate = (now: number) => {
              const elapsed = now - startTime;
              const progress = Math.min(elapsed / duration, 1);
              const eased = 1 - Math.pow(1 - progress, 3);
              const current = Math.floor(eased * target);
              numberEl.textContent = format(current);

              if (progress < 1) {
                requestAnimationFrame(animate);
              } else {
                numberEl.textContent = format(target);
              }
            };

            numberEl.textContent = format(0);
            requestAnimationFrame(animate);
          });

          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.3 }
  );

  const grid = document.querySelector('.numbers-grid');
  if (grid) observer.observe(grid);
</script>
