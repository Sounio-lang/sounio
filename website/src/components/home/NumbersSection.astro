---
import { publicContract } from "../../data/artifactStatus";

const { metrics, bootstrap, versions } = publicContract;
const gate = metrics.stdlibReliabilityGate;
const full = metrics.fullTestSuite;
const selfHostedLines = metrics.selfHostedSourceLines;
const stdlibFiles = metrics.stdlibInventoryFiles;

function formatLines(n: number | null): string {
  if (n == null) return "—";
  if (n >= 1_000_000) return `${Math.round(n / 100_000) / 10}M`;
  if (n >= 1000) return `${Math.round(n / 1000)}K`;
  return String(n);
}
---

<section class="py-6 md:py-8 bg-[color-mix(in_srgb,var(--color-bg-alt)_85%,transparent)] border-y border-[var(--glass-border)]">
  <div class="container px-4">
    <p class="text-center text-[0.78rem] text-[var(--color-text-tertiary)] mb-6 max-w-2xl mx-auto">
      Metrics synced from committed artifacts and README.md · souc {versions.checkedArtifact}
      {versions.readmeBadge && versions.readmeBadge !== versions.checkedArtifact
        ? ` (README badge: ${versions.readmeBadge})`
        : ""}
    </p>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 max-w-5xl mx-auto">
      <div class="text-center">
        <div class="text-5xl md:text-7xl font-extrabold text-[var(--color-text-primary)] tracking-tight mb-2">
          {formatLines(selfHostedLines)}
        </div>
        <div class="text-sm text-[var(--color-text-secondary)]">Self-hosted compiler LOC</div>
      </div>

      <div class="text-center">
        <div class="text-5xl md:text-7xl font-extrabold text-[var(--color-text-primary)] tracking-tight mb-2">
          {stdlibFiles ?? "—"}
        </div>
        <div class="text-sm text-[var(--color-text-secondary)]">Stdlib .sio files (inventory)</div>
      </div>

      <div class="text-center">
        <div class="text-5xl md:text-7xl font-extrabold text-[var(--color-text-primary)] tracking-tight mb-2">
          {gate.pass}/{gate.total}
        </div>
        <div class="text-sm text-[var(--color-text-secondary)]">Stdlib reliability gate</div>
      </div>

      <div class="text-center">
        <div class="text-5xl md:text-7xl font-extrabold text-[var(--color-text-primary)] tracking-tight mb-2">
          {full ? `${full.pass}/${full.total}` : "—"}
        </div>
        <div class="text-sm text-[var(--color-text-secondary)]">Full suite (README)</div>
      </div>
    </div>

    {bootstrap.recordedSha256 && (
      <p class="text-center text-[0.75rem] text-[var(--color-text-tertiary)] mt-6 font-mono">
        Fixed-point SHA-256 (CHANGELOG): {bootstrap.recordedSha256.slice(0, 12)}…
        {bootstrap.recordedSizeKb ? ` · ${bootstrap.recordedSizeKb} KB` : ""}
      </p>
    )}
  </div>
</section>
