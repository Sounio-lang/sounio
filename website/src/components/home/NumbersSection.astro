---
import { publicContract } from "../../data/artifactStatus";
import { getLocaleFromUrl } from "../../lib/i18n";

const locale = getLocaleFromUrl(Astro.url);
const { metrics, bootstrap, versions } = publicContract;
const gate = metrics.stdlibReliabilityGate;
const full = metrics.fullTestSuite;
const selfHostedLines = metrics.selfHostedSourceLines;
const stdlibFiles = metrics.stdlibInventoryFiles;

function formatLines(n: number | null): string {
  if (n == null) return "—";
  if (n >= 1_000_000) return `${Math.round(n / 100_000) / 10}M`;
  if (n >= 1000) return `${Math.round(n / 1000)}K`;
  return String(n);
}

const t = {
  en: {
    topBanner: "Metrics synced from committed artifacts and README.md · souc",
    readmeBadge: "README badge:",
    selfHostedLoc: "Self-hosted compiler LOC",
    stdlibFiles: "Stdlib .sio files (inventory)",
    stdlibGate: "Stdlib reliability gate",
    fullSuite: "Full suite (README)",
    fixedPoint: "Fixed-point SHA-256 (CHANGELOG):"
  },
  pt: {
    topBanner: "Métricas sincronizadas com artefactos registados e README.md · souc",
    readmeBadge: "Emblema do README:",
    selfHostedLoc: "Linhas de código do compilador",
    stdlibFiles: "Ficheiros .sio na stdlib (inventário)",
    stdlibGate: "Portão de fiabilidade da stdlib",
    fullSuite: "Suite de testes completa (README)",
    fixedPoint: "Ponto fixo SHA-256 (CHANGELOG):"
  },
  es: {
    topBanner: "Métricas sincronizadas con artefactos registrados y README.md · souc",
    readmeBadge: "Emblema del README:",
    selfHostedLoc: "Líneas de código del compilador",
    stdlibFiles: "Archivos .sio en stdlib (inventario)",
    stdlibGate: "Portal de fiabilidad de stdlib",
    fullSuite: "Suite de pruebas completa (README)",
    fixedPoint: "Punto fijo SHA-256 (CHANGELOG):"
  },
  el: {
    topBanner: "Τα μετρικά συγχρονίστηκαν από καταχωρημένα τεκμήρια και το README.md · souc",
    readmeBadge: "README badge:",
    selfHostedLoc: "Γραμμές κώδικα του compiler",
    stdlibFiles: "Αρχεία .sio στη stdlib (απογραφή)",
    stdlibGate: "Πύλη αξιοπιστίας της stdlib",
    fullSuite: "Πλήρης σουίτα δοκιμών (README)",
    fixedPoint: "Σταθερό σημείο SHA-256 (CHANGELOG):"
  },
  zh: {
    topBanner: "指标从提交的产物和 README.md 同步 · souc",
    readmeBadge: "README 徽章:",
    selfHostedLoc: "自托管编译器行数",
    stdlibFiles: "Stdlib .sio 文件（库存）",
    stdlibGate: "Stdlib 可靠性门控",
    fullSuite: "完整测试套件 (README)",
    fixedPoint: "固定点 SHA-256 (CHANGELOG):"
  },
  ja: {
    topBanner: "コミット済みの成果物および README.md から同期されたメトリクス · souc",
    readmeBadge: "README バッジ:",
    selfHostedLoc: "セルフホストコンパイラの行数",
    stdlibFiles: "Stdlib .sio ファイル（インベントリ）",
    stdlibGate: "Stdlib 信頼性ゲート",
    fullSuite: "フルテストスイート (README)",
    fixedPoint: "固定点 SHA-256 (CHANGELOG):"
  }
};

const d = t[locale] || t.en;
---

<section class="py-6 md:py-8 bg-[color-mix(in_srgb,var(--color-bg-alt)_85%,transparent)] border-y border-[var(--glass-border)]">
  <div class="container px-4">
    <p class="text-center text-[0.78rem] text-[var(--color-text-tertiary)] mb-6 max-w-2xl mx-auto">
      {d.topBanner} {versions.checkedArtifact}
      {versions.readmeBadge && versions.readmeBadge !== versions.checkedArtifact
        ? ` (${d.readmeBadge} ${versions.readmeBadge})`
        : ""}
    </p>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 max-w-5xl mx-auto">
      <div class="text-center">
        <div class="text-3xl sm:text-4xl md:text-5xl lg:text-7xl font-extrabold text-[var(--color-text-primary)] tracking-tight mb-2 overflow-hidden text-ellipsis whitespace-nowrap">
          {formatLines(selfHostedLines)}
        </div>
        <div class="text-xs sm:text-sm text-[var(--color-text-secondary)]">{d.selfHostedLoc}</div>
      </div>

      <div class="text-center">
        <div class="text-3xl sm:text-4xl md:text-5xl lg:text-7xl font-extrabold text-[var(--color-text-primary)] tracking-tight mb-2 overflow-hidden text-ellipsis whitespace-nowrap">
          {stdlibFiles ?? "—"}
        </div>
        <div class="text-xs sm:text-sm text-[var(--color-text-secondary)]">{d.stdlibFiles}</div>
      </div>

      <div class="text-center">
        <div class="text-3xl sm:text-4xl md:text-5xl lg:text-7xl font-extrabold text-[var(--color-text-primary)] tracking-tight mb-2 overflow-hidden text-ellipsis whitespace-nowrap">
          {gate.pass}/{gate.total}
        </div>
        <div class="text-xs sm:text-sm text-[var(--color-text-secondary)]">{d.stdlibGate}</div>
      </div>

      <div class="text-center">
        <div class="text-3xl sm:text-4xl md:text-5xl lg:text-7xl font-extrabold text-[var(--color-text-primary)] tracking-tight mb-2 overflow-hidden text-ellipsis whitespace-nowrap">
          {full ? `${full.pass}/${full.total}` : "—"}
        </div>
        <div class="text-xs sm:text-sm text-[var(--color-text-secondary)]">{d.fullSuite}</div>
      </div>
    </div>

    {bootstrap.recordedSha256 && (
      <p class="text-center text-[0.75rem] text-[var(--color-text-tertiary)] mt-6 font-mono">
        {d.fixedPoint} {bootstrap.recordedSha256.slice(0, 12)}…
        {bootstrap.recordedSizeKb ? ` · ${bootstrap.recordedSizeKb} KB` : ""}
      </p>
    )}
  </div>
</section>
