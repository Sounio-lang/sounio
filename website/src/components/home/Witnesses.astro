---
import type { Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const copy = {
  en: {
    eyebrow: 'The two witnesses',
    title: 'Struck in gold, counted in effects.',
    lede: 'Pappou and Yiayia keep watch at Cape Sounion, the headland the language is named after. Each is struck as the face of a drachma, engraved in gold line; turn the coin and the effect lattice is on the reverse. Between them runs a komboloi of ten beads, one for each of the nine public effects and one for linearity, passed one by one the way an effect row is threaded through a program.',
    hint: 'Hover a coin to observe the photograph under the engraving · click to turn it',
    hintTouch: 'Touch a coin to observe it · tap again to turn it',
    counting: 'counting',
    note: 'Live WebGL2, drawn in your browser from the original artworks. The engraving is a single line field whose width follows the light of the portrait.',
    observed: 'observed',
    turn: 'Turn the coin',
  },
  pt: {
    eyebrow: 'As duas testemunhas',
    title: 'Cunhados em ouro, contados em efeitos.',
    lede: 'Pappou e Yiayia vigiam o Cabo Sounion, o promontório que dá nome à linguagem. Cada um é cunhado como a face de uma dracma, gravado em linha de ouro; vire a moeda e o reticulado de efeitos está no verso. Entre eles corre um komboloi de dez contas, uma para cada um dos nove efeitos públicos e uma para a linearidade, passadas uma a uma como uma linha de efeitos atravessa um programa.',
    hint: 'Passe sobre uma moeda para observar a fotografia sob a gravura · clique para virá-la',
    hintTouch: 'Toque numa moeda para observá-la · toque de novo para virá-la',
    counting: 'contando',
    note: 'WebGL2 ao vivo, desenhado no seu navegador a partir das artes originais. A gravura é um único campo de linhas cuja espessura segue a luz do retrato.',
    observed: 'observado',
    turn: 'Virar a moeda',
  },
};

const d = copy[locale === 'pt' ? 'pt' : 'en'];

const witnesses = [
  { id: 'pappou', greek: 'Παππούς', latin: 'Pappou', legend: 'ΠΑΠΠΟΥΣ', src: '/media/witness-pappou.webp', phase: 0 },
  { id: 'yiayia', greek: 'Γιαγιά', latin: 'Yiayia', legend: 'ΓΙΑΓΙΑ', src: '/media/witness-yiayia.webp', phase: 2.1 },
];

const beads = [
  { name: 'IO', hue: '#38BDF8' }, { name: 'Mut', hue: '#FB923C' }, { name: 'Div', hue: '#C084FC' },
  { name: 'Panic', hue: '#FF8596' }, { name: 'Alloc', hue: '#2DD4BF' }, { name: 'Async', hue: '#60A5FA' },
  { name: 'GPU', hue: '#A3E635' }, { name: 'Prob', hue: '#FBBF24' }, { name: 'Observe', hue: '#F472B6' },
  { name: 'linear', hue: '#F97316' },
];
---

<section id="witnesses" class="witnesses spectrum-surface" aria-labelledby="witnesses-title">
  <div class="container witnesses-head">
    <p class="sx-eyebrow witnesses-eyebrow">{d.eyebrow}</p>
    <h2 id="witnesses-title" class="witnesses-title">{d.title}</h2>
    <p class="witnesses-lede">{d.lede}</p>
  </div>

  <div class="container coins">
    {witnesses.map((w) => (
      <figure class="coin-wrap" data-witness={w.id} data-phase={w.phase}>
        <button type="button" class="coin" aria-label={`${d.turn}: ${w.latin}`}>
          <span class="coin-face">
            <img class="coin-still" src={w.src} alt="" width="768" height="768" loading="lazy" decoding="async" />
            <canvas class="coin-canvas" data-src={w.src} aria-hidden="true"></canvas>
            <svg class="coin-legend coin-legend--front" viewBox="0 0 200 200" aria-hidden="true">
              <defs>
                <path id={`arc-top-${w.id}`} d="M 18 100 A 82 82 0 0 1 182 100" />
                <path id={`arc-bot-${w.id}`} d="M 12 100 A 88 88 0 0 0 188 100" />
              </defs>
              <text class="legend-text"><textPath href={`#arc-top-${w.id}`} startOffset="50%" text-anchor="middle">{w.legend}</textPath></text>
              <text class="legend-text"><textPath href={`#arc-bot-${w.id}`} startOffset="50%" text-anchor="middle">ΣΟΥΝΙΟ</textPath></text>
            </svg>
            <svg class="coin-legend coin-legend--back" viewBox="0 0 200 200" aria-hidden="true">
              <defs>
                <path id={`arcb-top-${w.id}`} d="M 18 100 A 82 82 0 0 1 182 100" />
                <path id={`arcb-bot-${w.id}`} d="M 12 100 A 88 88 0 0 0 188 100" />
              </defs>
              <text class="legend-text"><textPath href={`#arcb-top-${w.id}`} startOffset="50%" text-anchor="middle">ΜΕΤΡΟΝ ΑΡΙΣΤΟΝ</textPath></text>
              <text class="legend-text legend-text--small"><textPath href={`#arcb-bot-${w.id}`} startOffset="50%" text-anchor="middle">IO · MUT · DIV · PANIC · ALLOC · ASYNC · GPU · PROB · OBSERVE</textPath></text>
            </svg>
          </span>
        </button>
        <figcaption class="coin-caption">
          <span class="coin-name">
            <span class="coin-greek" lang="el">{w.greek}</span>
            <span class="coin-latin">{w.latin}</span>
          </span>
          <code class="coin-code">
            <span class="coin-code-unobserved"><span class="sx-k">let</span> {w.id}: <span class="sx-t">Unobserved</span>&lt;<span class="sx-t">Portrait</span>&gt;</span>
            <span class="coin-code-observed"><span class="sx-f">observe</span>({w.id}) <span class="sx-c">// with</span> <span class="coin-observe">Observe</span></span>
          </code>
        </figcaption>
      </figure>
    ))}
  </div>

  <div class="komboloi" aria-label="Komboloi: nine effects and linearity">
    <svg class="komboloi-svg" viewBox="0 0 1000 240" preserveAspectRatio="xMidYMid meet" role="img" aria-label={beads.map((b) => b.name).join(', ')}>
      <defs>
        {beads.map((b, i) => (
          <radialGradient id={`bead-${i}`} cx="35%" cy="30%" r="75%">
            <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0.95" />
            <stop offset="18%" stop-color={b.hue} />
            <stop offset="100%" stop-color="#05080E" />
          </radialGradient>
        ))}
        <radialGradient id="bead-gold" cx="35%" cy="30%" r="75%">
          <stop offset="0%" stop-color="#FFF6D8" />
          <stop offset="22%" stop-color="#E0C470" />
          <stop offset="100%" stop-color="#4A3810" />
        </radialGradient>
        <linearGradient id="string-fade" x1="0" x2="1000" y1="0" y2="0" gradientUnits="userSpaceOnUse">
          <stop offset="0" stop-color="#C9A64F" stop-opacity="0" />
          <stop offset="0.14" stop-color="#C9A64F" stop-opacity="0.9" />
          <stop offset="0.86" stop-color="#C9A64F" stop-opacity="0.9" />
          <stop offset="1" stop-color="#C9A64F" stop-opacity="0" />
        </linearGradient>
        <filter id="bead-glow" x="-60%" y="-60%" width="220%" height="220%">
          <feGaussianBlur stdDeviation="4" result="b" />
          <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
        </filter>
      </defs>
      <path id="komboloi-string" class="komboloi-string" d="M -20 30 C 300 140 700 140 1020 30" />
      <g class="komboloi-tassel">
        {Array.from({ length: 13 }, (_, i) => {
          const x = 500 + (i - 6) * 2.2;
          return <path d={`M 500 118 Q ${x} 160 ${500 + (i - 6) * 4.6} ${204 + (i % 3) * 5}`} />;
        })}
        <rect x="492" y="122" width="16" height="12" rx="3" class="tassel-cap" />
      </g>
      <circle class="komboloi-father" cx="500" cy="112" r="16" fill="url(#bead-gold)" />
      {beads.map((b, i) => (
        <g class="bead" data-i={i} data-name={b.name} data-hue={b.hue}>
          <circle r="13" fill={`url(#bead-${i})`} />
          <text class="bead-label" y="32" text-anchor="middle" fill={b.hue}>{b.name}</text>
        </g>
      ))}
    </svg>
    <p class="komboloi-now" aria-live="off"><span class="komboloi-now-label">{d.counting}</span> <span class="komboloi-now-name">IO</span></p>
  </div>

  <div class="container witnesses-foot">
    <p class="witnesses-hint">
      <span class="witnesses-lens" aria-hidden="true"></span>
      <span class="hint-fine">{d.hint}</span>
      <span class="hint-touch">{d.hintTouch}</span>
    </p>
    <p class="witnesses-note">{d.note}</p>
  </div>
</section>

<style>
  .witnesses {
    position: relative;
    padding: clamp(4.5rem, 9vw, 8rem) 0 clamp(3rem, 6vw, 5rem);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    overflow: hidden;
    background:
      radial-gradient(ellipse 55% 45% at 50% 52%, rgba(214, 179, 90, 0.10), transparent 70%),
      #05080E;
  }

  .witnesses-head { display: grid; gap: 1.1rem; max-width: 56rem; margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .witnesses-eyebrow { color: #EBD6A2; }

  .witnesses-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.4rem, 5.4vw, 4.6rem);
    line-height: 1.02;
    letter-spacing: 0;
    color: #FFFFFF;
    text-wrap: balance;
  }

  .witnesses-lede {
    margin: 0;
    max-width: 64ch;
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.76);
  }

  /* Coins */
  .coins {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 6vw, 6rem);
    justify-items: center;
    position: relative;
    z-index: 2;
  }

  .coin-wrap { margin: 0; display: grid; justify-items: center; gap: 1.5rem; perspective: 1400px; }

  .coin {
    --size: clamp(15rem, 31vw, 27rem);
    position: relative;
    width: var(--size);
    height: var(--size);
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
    transform-style: preserve-3d;
    will-change: transform;
    filter: drop-shadow(0 40px 50px rgba(0, 0, 0, 0.65)) drop-shadow(0 0 40px rgba(214, 179, 90, 0.14));
  }

  .coin:focus-visible { outline: 2px solid #D6B35A; outline-offset: 8px; }

  .coin-face { position: absolute; inset: 0; border-radius: 50%; overflow: hidden; display: block; }
  .coin.is-back .coin-face { transform: scaleX(-1); }

  .coin-still, .coin-canvas, .coin-legend { position: absolute; inset: 0; width: 100%; height: 100%; }
  .coin-still {
    object-fit: cover;
    border-radius: 50%;
    filter: grayscale(1) sepia(0.55) saturate(1.3) brightness(0.75) contrast(1.15);
    box-shadow: inset 0 0 0 6px #A88A3C;
  }
  .coin-canvas { opacity: 0; transition: opacity 1s var(--ease-out); }
  .coin.is-live .coin-canvas { opacity: 1; }

  .coin-legend { pointer-events: none; }
  .legend-text {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 10.5px;
    letter-spacing: 3.2px;
    fill: #EBD6A2;
  }
  .legend-text--small { font-family: var(--font-sans); font-size: 5.6px; letter-spacing: 1.1px; }
  .coin-legend--back { display: none; }
  .coin.is-back .coin-legend--front { display: none; }
  .coin.is-back .coin-legend--back { display: block; }

  .coin-caption { display: grid; justify-items: center; gap: 0.85rem; text-align: center; }
  .coin-name { display: grid; gap: 0.15rem; }
  .coin-greek { font-family: var(--font-display); font-weight: 700; font-size: clamp(2rem, 3.6vw, 3rem); line-height: 1; color: #FFFFFF; }
  .coin-latin { font-family: var(--font-italic); font-style: italic; font-size: 1.25rem; color: #EBD6A2; }

  .coin-code {
    display: grid;
    padding: 0.5rem 0.8rem;
    border-radius: var(--radius-md);
    background: rgba(5, 8, 14, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.14);
    font: 400 0.8rem/1.4 var(--font-mono);
    color: #FFFFFF;
    font-variant-ligatures: none;
    white-space: nowrap;
  }
  .coin-code > span { grid-area: 1 / 1; transition: opacity 0.35s ease, transform 0.35s var(--ease-out); }
  .coin-code-observed { opacity: 0; transform: translateY(4px); }
  .coin-wrap.is-observing .coin-code-unobserved { opacity: 0; transform: translateY(-4px); }
  .coin-wrap.is-observing .coin-code-observed { opacity: 1; transform: none; }
  .coin-observe { color: var(--spectrum-09-observe); }

  /* Komboloi */
  .komboloi { position: relative; margin-top: clamp(1rem, 2.5vw, 2.5rem); z-index: 1; }
  .komboloi-svg { display: block; width: 100%; height: auto; max-height: 15rem; overflow: visible; }
  .komboloi-string { fill: none; stroke: url(#string-fade); stroke-width: 1.6; }
  .komboloi-tassel path { fill: none; stroke: #C9A64F; stroke-width: 1; opacity: 0.8; }
  .tassel-cap { fill: #A88A3C; }
  .komboloi-father { filter: url(#bead-glow); }
  .bead circle { filter: url(#bead-glow); }
  .bead-label { font: 500 11px var(--font-mono); font-variant-ligatures: none; opacity: 0.9; }
  .bead.is-moving .bead-label { opacity: 1; font-weight: 700; }

  .komboloi-now {
    display: none;
    margin: 0.5rem 0 0;
    text-align: center;
    font: 500 0.85rem/1 var(--font-mono);
    color: rgba(255, 255, 255, 0.72);
  }
  .komboloi-now-name { color: var(--now-hue, #38BDF8); font-weight: 700; }

  .witnesses-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }

  .witnesses-hint {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font: 700 0.75rem/1.4 var(--font-sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #EBD6A2;
  }

  .witnesses-lens { flex: none; width: 14px; height: 14px; border-radius: 50%; border: 2px solid #D6B35A; box-shadow: 0 0 10px rgba(214, 179, 90, 0.7); }
  .hint-touch { display: none; }
  @media (hover: none) { .hint-fine { display: none; } .hint-touch { display: inline; } }

  .witnesses-note { margin: 0; max-width: 62ch; font-size: 0.8rem; line-height: 1.5; color: rgba(255, 255, 255, 0.62); }

  @media (max-width: 760px) {
    .coins { grid-template-columns: 1fr; gap: 3rem; }
    .coin { --size: min(78vw, 22rem); }
    .komboloi { margin-top: 0; overflow: hidden; }
    .komboloi-svg { width: 150%; max-height: none; margin-left: -25%; }
    .bead-label { display: none; }
    .komboloi-now { display: block; }
  }

  @media (prefers-reduced-motion: reduce) {
    .coin { transform: none !important; }
  }
</style>

<script>
  const VERT = `#version 300 es
in vec2 p; void main(){ gl_Position = vec4(p, 0.0, 1.0); }`;

  // Drachma. Obverse: the portrait as a gold intaglio line field (line width
  // follows luminance, lines bend with the broad tone). Reverse: the effect
  // lattice vortex. Rim, bead ring and legend band are drawn in coin space;
  // uTilt slides a specular band across the metal as the coin turns.
  const FRAG = `#version 300 es
precision highp float;
uniform sampler2D uImg; uniform vec2 uRes; uniform float uTime; uniform float uSide; uniform float uTilt;
uniform vec3 uLens; uniform float uLensR;
out vec4 o;
const float TAU = 6.28318530718;
const vec3 GD = vec3(0.36, 0.27, 0.09), GM = vec3(0.84, 0.70, 0.35), GL = vec3(0.98, 0.91, 0.68);
vec3 gold(float s){ s = clamp(s, 0.0, 1.0); return s < 0.5 ? mix(GD, GM, s * 2.0) : mix(GM, GL, (s - 0.5) * 2.0); }
float lum(vec3 c){ return dot(c, vec3(0.2126, 0.7152, 0.0722)); }
vec3 pal(int i){
  if(i==0) return vec3(56,189,248); if(i==1) return vec3(251,146,60); if(i==2) return vec3(192,132,252);
  if(i==3) return vec3(255,133,150); if(i==4) return vec3(45,212,191); if(i==5) return vec3(96,165,250);
  if(i==6) return vec3(163,230,53); if(i==7) return vec3(251,191,36); if(i==8) return vec3(244,114,182);
  return vec3(249,115,22);
}
float vphase(vec2 q, float s){
  float r = length(q), a = atan(q.y, q.x);
  return a / TAU * 10.0 + (9.0 + 0.6 * sin(TAU * s)) * log(r + 1e-4) - 10.0 * s + 0.22 * sin(r * 16.0 - TAU * 2.0 * s);
}
vec3 vortex(vec2 q, vec3 ground){
  float s = fract(uTime / 9.0);
  float r = length(q);
  float ph = vphase(q, s);
  float fw = fwidth(ph) + 1e-5;
  if (fw > 5.0) fw = 0.2;
  float k = floor(ph + 0.5), dist = abs(ph - k);
  int idx = int(mod(mod(k, 10.0) + 10.0, 10.0));
  float core = 1.0 - smoothstep(0.0, fw * 1.3, dist);
  float glow = exp(-dist / (fw * 7.0)) * 0.5;
  float mask = smoothstep(0.02, 0.09, r);
  vec3 c = ground + pal(idx) / 255.0 * (core + glow) * mask;
  c += GM * exp(-r * r / 0.0016) * (0.8 + 0.2 * sin(TAU * s));
  return c;
}
vec3 engraving(vec2 p, float sweep, vec3 ground){
  vec2 uv = p / 0.78 * 0.5 + 0.5; uv.y = 1.0 - uv.y;
  float Lm = smoothstep(0.04, 0.82, lum(textureLod(uImg, uv, 0.9).rgb));
  float Lb = lum(textureLod(uImg, uv, 4.2).rgb);
  float N = 64.0;
  vec2 d1 = vec2(cos(0.62), sin(0.62)), d2 = vec2(cos(-0.85), sin(-0.85));
  float h1 = dot(p, d1) * N + Lb * 5.0;
  float f1 = abs(fract(h1) - 0.5) * 2.0;
  float a1 = fwidth(h1) * 1.6;
  float w1 = Lm * 0.92 + 0.04;
  float ink = 1.0 - smoothstep(w1 - a1, w1 + a1, f1);
  float h2 = dot(p, d2) * N * 0.9 - Lb * 3.5;
  float f2 = abs(fract(h2) - 0.5) * 2.0;
  float a2 = fwidth(h2) * 1.6;
  float w2 = clamp((Lm - 0.58) * 1.7, 0.0, 0.8);
  ink = max(ink, (1.0 - smoothstep(w2 - a2, w2 + a2, f2)) * step(0.002, w2));
  vec3 c = mix(ground, gold(0.30 + 0.55 * Lm + 0.45 * sweep), ink);
  return c;
}
void main(){
  vec2 p = gl_FragCoord.xy / uRes * 2.0 - 1.0;
  float r = length(p);
  float aa = 2.5 / uRes.x;
  float alpha = 1.0 - smoothstep(1.0 - aa, 1.0, r);
  if (alpha <= 0.0) { o = vec4(0.0); return; }
  float a = atan(p.y, p.x);
  vec2 n = p / max(r, 1e-4);
  vec2 Ldir = normalize(vec2(-0.55 + uTilt * 0.8, 0.83));
  float sweep = exp(-pow((dot(p, vec2(0.80, 0.60)) - uTilt * 1.25) * 1.9, 2.0));
  vec3 ground = vec3(0.020, 0.036, 0.068) + vec3(0.03, 0.025, 0.01) * sweep;
  vec3 col = ground;

  if (r < 0.78) {
    if (uSide < 0.5) {
      col = engraving(p, sweep, ground);
      // observation lens: the photograph under the engraving
      float dl = length(p - uLens.xy) / max(uLensR, 1e-3);
      float m = (1.0 - smoothstep(0.9, 1.0, dl)) * uLens.z;
      vec2 uv = p / 0.78 * 0.5 + 0.5; uv.y = 1.0 - uv.y;
      vec3 photo = texture(uImg, uv).rgb;
      col = mix(col, photo * 1.04, m);
      float ringW = 2.0 / uRes.x / max(uLensR, 1e-3);
      float ring = (1.0 - min(abs(dl - 1.0) / (ringW * 2.0), 1.0)) * uLens.z;
      col = mix(col, gold(0.75 + 0.25 * sweep), ring);
    } else {
      col = vortex(p / 0.78 * 0.62, ground);
    }
  }
  // inner relief ring
  float px = 1.0 / uRes.x * 2.0;
  float ring1 = 1.0 - smoothstep(0.0, 0.004 + px, abs(r - 0.79));
  col = mix(col, gold(0.55 + 0.25 * dot(n, Ldir) + 0.3 * sweep), ring1);
  // legend band: faint concentric guilloche
  if (r > 0.80 && r < 0.925) {
    float g = abs(fract(r * 160.0) - 0.5);
    col += GM * 0.05 * (1.0 - smoothstep(0.0, 0.25, g));
  }
  float ring2 = 1.0 - smoothstep(0.0, 0.003 + px, abs(r - 0.928));
  col = mix(col, gold(0.5 + 0.3 * sweep), ring2 * 0.9);
  // bead ring
  float cells = 84.0;
  float cell = fract(a / TAU * cells + 0.5);
  vec2 bq = vec2((cell - 0.5) * TAU * 0.948 / cells, r - 0.948);
  float bd = length(bq);
  float bead = 1.0 - smoothstep(0.0098 - px, 0.0098 + px, bd);
  float bshade = 0.45 + 0.45 * dot(normalize(bq + 1e-5), Ldir) + 0.35 * sweep;
  col = mix(col, gold(bshade), bead);
  // raised rim with bevel
  if (r > 0.966) {
    float t = (r - 0.966) / 0.034;
    float bevel = dot(n, Ldir) * (t < 0.5 ? -1.0 : 1.0);
    vec3 rim = gold(0.52 + 0.32 * bevel + 0.35 * sweep);
    col = mix(col, rim, smoothstep(0.966, 0.966 + px * 1.5, r));
  }
  o = vec4(col * alpha, alpha);
}`;

  type Mounted = { stop: () => void };

  function mountCoin(wrap: HTMLElement): Mounted | null {
    const coin = wrap.querySelector<HTMLElement>('.coin')!;
    const canvas = wrap.querySelector<HTMLCanvasElement>('.coin-canvas');
    if (!canvas) return null;
    const gl = canvas.getContext('webgl2', { antialias: false, alpha: true, premultipliedAlpha: true, powerPreference: 'low-power' });
    if (!gl) return null;
    const sh = (type: number, src: string) => { const x = gl.createShader(type)!; gl.shaderSource(x, src); gl.compileShader(x); return x; };
    const prog = gl.createProgram()!;
    gl.attachShader(prog, sh(gl.VERTEX_SHADER, VERT));
    gl.attachShader(prog, sh(gl.FRAGMENT_SHADER, FRAG));
    gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) { console.warn(gl.getProgramInfoLog(prog)); return null; }
    gl.useProgram(prog);
    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(prog, 'p');
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
    const u = (n: string) => gl.getUniformLocation(prog, n);
    const U = { res: u('uRes'), time: u('uTime'), side: u('uSide'), tilt: u('uTilt'), lens: u('uLens'), lensR: u('uLensR'), img: u('uImg') };

    let ready = false;
    const tex = gl.createTexture();
    const img = new Image();
    img.decoding = 'async';
    img.onload = () => {
      gl.bindTexture(gl.TEXTURE_2D, tex);
      gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, img);
      gl.generateMipmap(gl.TEXTURE_2D);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR_MIPMAP_LINEAR);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
      ready = true;
    };
    img.src = canvas.dataset.src ?? '';

    let size = 1;
    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const r = coin.getBoundingClientRect();
      // getBoundingClientRect is affected by the 3D turn; use the layout size instead
      size = Math.max(1, Math.round(coin.offsetWidth * dpr));
      canvas.width = size; canvas.height = size; gl.viewport(0, 0, size, size);
      return r;
    };
    resize();
    const ro = new ResizeObserver(resize); ro.observe(coin);

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const phase = Number(wrap.dataset.phase ?? 0);
    const pointer = { x: 0, y: 0, inside: false };
    const lens = { x: 0, y: 0, z: 0, r: 0.0 };
    const tilt = { x: 0, y: 0 };
    let flipBase = 0, flipFrom = 0, flipStart = -1;
    const FLIP_MS = 1100;

    const toCoin = (ev: PointerEvent) => {
      const w = coin.offsetWidth;
      const r = coin.getBoundingClientRect();
      pointer.x = (ev.clientX - (r.left + r.width / 2)) / (w / 2);
      pointer.y = -(ev.clientY - (r.top + r.height / 2)) / (w / 2);
    };
    coin.addEventListener('pointerenter', (ev) => { toCoin(ev); pointer.inside = true; wrap.classList.add('is-observing'); });
    coin.addEventListener('pointermove', (ev) => { toCoin(ev); pointer.inside = true; wrap.classList.add('is-observing'); }, { passive: true });
    const leave = () => { pointer.inside = false; wrap.classList.remove('is-observing'); };
    coin.addEventListener('pointerleave', leave);
    coin.addEventListener('pointercancel', leave);
    coin.addEventListener('click', () => {
      if (flipStart >= 0) return;
      flipFrom = flipBase; flipStart = performance.now();
    });

    let visible = false, raf = 0, live = false;
    const io = new IntersectionObserver(([e]) => { visible = e.isIntersecting; }, { rootMargin: '120px 0px' });
    io.observe(wrap);
    const t0 = performance.now();
    const ease = (x: number) => (x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2);

    const frame = (now: number) => {
      raf = requestAnimationFrame(frame);
      if (!visible || !ready || document.hidden) return;
      const t = (now - t0) / 1000;
      if (flipStart >= 0) {
        const k = Math.min(1, (now - flipStart) / FLIP_MS);
        flipBase = flipFrom + 180 * ease(k);
        if (k >= 1) { flipStart = -1; flipBase = flipFrom + 180; }
      }
      const sway = reduce ? 0 : 14 * Math.sin(t * 0.55 + phase);
      const targetTx = pointer.inside ? pointer.y * 10 : 0;
      const targetTy = pointer.inside ? pointer.x * 12 : 0;
      tilt.x += (targetTx - tilt.x) * 0.08; tilt.y += (targetTy - tilt.y) * 0.08;
      const angle = flipBase + (pointer.inside ? 0 : sway) + tilt.y;
      const rad = (angle * Math.PI) / 180;
      const back = Math.cos(rad) < 0;
      coin.style.transform = `rotateX(${tilt.x.toFixed(2)}deg) rotateY(${angle.toFixed(2)}deg)`;
      coin.classList.toggle('is-back', back);

      const lensOn = pointer.inside && !back && flipStart < 0;
      const px = back ? -pointer.x : pointer.x;
      lens.x += (px - lens.x) * 0.25; lens.y += (pointer.y - lens.y) * 0.25;
      lens.z += ((lensOn ? 1 : 0) - lens.z) * 0.1;
      lens.r += ((lensOn ? 0.34 : 0.2) - lens.r) * 0.1;

      gl.uniform2f(U.res, size, size);
      gl.uniform1f(U.time, t);
      gl.uniform1f(U.side, back ? 1 : 0);
      gl.uniform1f(U.tilt, Math.sin(rad) * 0.9 + tilt.x / 30);
      gl.uniform3f(U.lens, lens.x, lens.y, lens.z);
      gl.uniform1f(U.lensR, lens.r);
      gl.uniform1i(U.img, 0);
      gl.activeTexture(gl.TEXTURE0);
      gl.bindTexture(gl.TEXTURE_2D, tex);
      gl.clearColor(0, 0, 0, 0);
      gl.clear(gl.COLOR_BUFFER_BIT);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
      if (!live) { live = true; coin.classList.add('is-live'); }
    };
    raf = requestAnimationFrame(frame);
    return { stop: () => { cancelAnimationFrame(raf); io.disconnect(); ro.disconnect(); } };
  }

  // Komboloi: beads are passed one at a time from the left run to the right
  // run across the father bead, then back, like counting with a komboloi.
  function mountKomboloi(root: HTMLElement): Mounted | null {
    const path = root.querySelector<SVGPathElement>('#komboloi-string');
    const beads = Array.from(root.querySelectorAll<SVGGElement>('.bead'));
    const nowName = root.querySelector<HTMLElement>('.komboloi-now-name');
    if (!path || beads.length === 0) return null;
    const len = path.getTotalLength();
    const narrow = root.clientWidth < 700;
    const c = len / 2, gap = narrow ? 30 : 40, step = narrow ? 34 : 48;
    const n = beads.length;
    const target = (i: number, k: number) => (i >= k ? c - gap - (i - k) * step : c + gap + (k - 1 - i) * step);
    let k = 0, dir = 1;
    const pos = beads.map((_, i) => target(i, 0));
    let from = pos.slice(), to = pos.slice(), moving = -1, start = performance.now();
    const DUR = 900, HOLD = 700;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const ease = (x: number) => 1 - Math.pow(1 - x, 3);

    const place = (i: number, s: number, hop: number) => {
      const pt = path.getPointAtLength(Math.max(0, Math.min(len, s)));
      beads[i].setAttribute('transform', `translate(${pt.x.toFixed(1)} ${(pt.y - hop).toFixed(1)})`);
    };
    beads.forEach((_, i) => place(i, pos[i], 0));
    const announce = (i: number) => {
      if (!nowName) return;
      nowName.textContent = beads[i].dataset.name ?? '';
      nowName.parentElement!.style.setProperty('--now-hue', beads[i].dataset.hue ?? '#38BDF8');
    };
    announce(0);
    if (reduce) return { stop: () => {} };

    const next = () => {
      if (dir === 1 && k >= n) dir = -1;
      if (dir === -1 && k <= 0) dir = 1;
      moving = dir === 1 ? k : k - 1;
      k += dir;
      from = pos.slice();
      to = beads.map((_, i) => target(i, k));
      start = performance.now();
      beads.forEach((b, i) => b.classList.toggle('is-moving', i === moving));
      announce(moving);
    };
    let raf = 0, visible = false;
    const io = new IntersectionObserver(([e]) => { visible = e.isIntersecting; });
    io.observe(root);
    let phaseStart = performance.now() + HOLD;
    const frame = (now: number) => {
      raf = requestAnimationFrame(frame);
      if (!visible || document.hidden) return;
      if (moving < 0) { if (now >= phaseStart) next(); return; }
      const x = Math.min(1, (now - start) / DUR);
      const e = ease(x);
      for (let i = 0; i < n; i++) {
        pos[i] = from[i] + (to[i] - from[i]) * e;
        place(i, pos[i], i === moving ? 26 * Math.sin(Math.PI * x) : 0);
      }
      if (x >= 1) { moving = -1; phaseStart = now + HOLD; }
    };
    raf = requestAnimationFrame(frame);
    return { stop: () => { cancelAnimationFrame(raf); io.disconnect(); } };
  }

  let mounted: Mounted[] = [];
  document.addEventListener('astro:page-load', () => {
    mounted.forEach((m) => m.stop());
    mounted = [];
    const section = document.getElementById('witnesses');
    if (!section) return;
    section.querySelectorAll<HTMLElement>('.coin-wrap').forEach((w) => { const m = mountCoin(w); if (m) mounted.push(m); });
    const k = section.querySelector<HTMLElement>('.komboloi');
    if (k) { const m = mountKomboloi(k); if (m) mounted.push(m); }
  });
</script>
