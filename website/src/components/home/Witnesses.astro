---
import type { Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const copy = {
  en: {
    eyebrow: 'The two witnesses',
    title: 'Everything is a contour until it is observed.',
    lede: 'Pappou and Yiayia keep watch at Cape Sounion, the headland the language is named after. Here they are drawn the way the compiler holds an unobserved value: as level sets of what is known, each line carrying one effect. Move across them and the Observe effect resolves the picture, locally, and only where you look.',
    hint: 'Move across a portrait to observe it',
    hintTouch: 'Drag across a portrait to observe it',
    note: 'Live WebGL2, drawn in your browser from the original artworks. Isolines are luminance level sets coloured by the ten effect hues; the lens is a gold-ringed observation.',
    observed: 'observed',
  },
  pt: {
    eyebrow: 'As duas testemunhas',
    title: 'Tudo é contorno até ser observado.',
    lede: 'Pappou e Yiayia vigiam o Cabo Sounion, o promontório que dá nome à linguagem. Aqui eles são desenhados do jeito que o compilador guarda um valor não observado: como conjuntos de nível do que se sabe, cada linha carregando um efeito. Passe sobre eles e o efeito Observe resolve a imagem, localmente, e só onde você olha.',
    hint: 'Passe sobre um retrato para observá-lo',
    hintTouch: 'Arraste sobre um retrato para observá-lo',
    note: 'WebGL2 ao vivo, desenhado no seu navegador a partir das artes originais. As isolinhas são conjuntos de nível de luminância coloridos pelos dez matizes de efeito; a lente é uma observação com anel dourado.',
    observed: 'observado',
  },
};

const d = copy[locale === 'pt' ? 'pt' : 'en'];

const witnesses = [
  { id: 'pappou', greek: 'Παππούς', latin: 'Pappou', src: '/assets/original-artworks/pappou_hero_1536.webp', focus: 0.56, seed: 0.0 },
  { id: 'yiayia', greek: 'Γιαγιά', latin: 'Yiayia', src: '/assets/original-artworks/yiayia_hero_1536.webp', focus: 0.63, seed: 3.7 },
];
---

<section id="witnesses" class="witnesses spectrum-surface" aria-labelledby="witnesses-title">
  <div class="container witnesses-head">
    <p class="sx-eyebrow witnesses-eyebrow">{d.eyebrow}</p>
    <h2 id="witnesses-title" class="witnesses-title">{d.title}</h2>
    <p class="witnesses-lede">{d.lede}</p>
  </div>

  <div class="witnesses-diptych">
    {witnesses.map((w) => (
      <figure class="witness" data-witness={w.id}>
        <img class="witness-still" src={w.src} alt={`${w.latin} at Cape Sounion, holding a komboloi.`} loading="lazy" decoding="async" width="1536" height="1024" style={`object-position:${w.focus * 100}% 50%`} />
        <canvas class="witness-canvas" data-src={w.src} data-focus={w.focus} data-seed={w.seed} aria-hidden="true"></canvas>
        <figcaption class="witness-caption">
          <span class="witness-name">
            <span class="witness-greek" lang="el">{w.greek}</span>
            <span class="witness-latin">{w.latin}</span>
          </span>
          <code class="witness-code">
            <span class="witness-code-unobserved"><span class="sx-k">let</span> {w.id}: <span class="sx-t">Unobserved</span>&lt;<span class="sx-t">Portrait</span>&gt;</span>
            <span class="witness-code-observed"><span class="sx-f">observe</span>({w.id}) <span class="sx-c">// with</span> <span class="witness-observe">Observe</span> <span class="sx-c">· {d.observed}</span></span>
          </code>
        </figcaption>
      </figure>
    ))}
  </div>

  <div class="container witnesses-foot">
    <p class="witnesses-hint">
      <span class="witnesses-lens" aria-hidden="true"></span>
      <span class="hint-fine">{d.hint}</span>
      <span class="hint-touch">{d.hintTouch}</span>
    </p>
    <p class="witnesses-note">{d.note}</p>
  </div>
</section>

<style>
  .witnesses {
    position: relative;
    padding: clamp(4.5rem, 9vw, 8rem) 0 clamp(3rem, 6vw, 5rem);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    overflow: hidden;
  }

  .witnesses-head { display: grid; gap: 1.1rem; max-width: 56rem; margin-bottom: clamp(2.25rem, 4vw, 3.5rem); }
  .witnesses-eyebrow { color: #EBD6A2; }

  .witnesses-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.4rem, 5.4vw, 4.6rem);
    line-height: 1.02;
    letter-spacing: 0;
    color: #FFFFFF;
    text-wrap: balance;
  }

  .witnesses-lede {
    margin: 0;
    max-width: 62ch;
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.76);
  }

  .witnesses-diptych {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
    background: rgba(214, 179, 90, 0.35);
    border-block: 1px solid rgba(214, 179, 90, 0.35);
  }

  .witness {
    position: relative;
    margin: 0;
    height: min(88vh, 860px);
    min-height: 32rem;
    overflow: hidden;
    background: #05080E;
    cursor: crosshair;
    touch-action: pan-y;
  }

  .witness-still,
  .witness-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .witness-still { filter: saturate(0.85) brightness(0.8); }

  .witness-canvas { opacity: 0; transition: opacity 1.4s var(--ease-out); }
  .witness.is-live .witness-canvas { opacity: 1; }

  .witness-caption {
    position: absolute;
    left: clamp(1rem, 3vw, 2.25rem);
    right: clamp(1rem, 3vw, 2.25rem);
    bottom: clamp(1rem, 3vw, 2rem);
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    pointer-events: none;
  }

  .witness-name { display: grid; gap: 0.2rem; text-shadow: 0 2px 24px rgba(5, 8, 14, 0.95); }

  .witness-greek {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.4rem, 4.6vw, 4rem);
    line-height: 0.95;
    color: #FFFFFF;
  }

  .witness-latin {
    font-family: var(--font-italic);
    font-style: italic;
    font-size: clamp(1.15rem, 1.8vw, 1.5rem);
    color: #EBD6A2;
  }

  .witness-code {
    display: grid;
    padding: 0.55rem 0.8rem;
    border-radius: var(--radius-md);
    background: rgba(5, 8, 14, 0.78);
    border: 1px solid rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    font: 400 0.8rem/1.4 var(--font-mono);
    color: #FFFFFF;
    font-variant-ligatures: none;
    white-space: nowrap;
  }

  .witness-code > span { grid-area: 1 / 1; transition: opacity 0.35s ease, transform 0.35s var(--ease-out); }
  .witness-code-observed { opacity: 0; transform: translateY(4px); }
  .witness.is-observing .witness-code-unobserved { opacity: 0; transform: translateY(-4px); }
  .witness.is-observing .witness-code-observed { opacity: 1; transform: none; }
  .witness-observe { color: var(--spectrum-09-observe); }

  .witnesses-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-top: 1.5rem;
  }

  .witnesses-hint {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font: 700 0.75rem/1 var(--font-sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #EBD6A2;
  }

  .witnesses-lens {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 2px solid #D6B35A;
    box-shadow: 0 0 10px rgba(214, 179, 90, 0.7);
  }

  .hint-touch { display: none; }
  @media (hover: none) {
    .hint-fine { display: none; }
    .hint-touch { display: inline; }
  }

  .witnesses-note { margin: 0; max-width: 62ch; font-size: 0.8rem; line-height: 1.5; color: rgba(255, 255, 255, 0.62); }

  @media (max-width: 860px) {
    .witnesses-diptych { grid-template-columns: 1fr; }
    .witness { height: 78svh; min-height: 28rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .witness-canvas { display: none; }
    .witness-still { filter: none; }
  }
</style>

<script>
  const VERT = `#version 300 es
in vec2 p; void main(){ gl_Position = vec4(p, 0.0, 1.0); }`;

  // Spectral portrait. The photograph's luminance is read as a scalar field and
  // drawn as its integer level sets, each hued by one of the ten effects; the
  // phase drifts by exactly ten levels per period, so the motion loops seamlessly.
  // Inside the lens (the observation) the photograph itself is shown.
  const FRAG = `#version 300 es
precision highp float;
uniform sampler2D uImg; uniform vec2 uRes; uniform float uTime; uniform vec2 uLens; uniform float uLensR;
uniform float uReveal; uniform float uFocus; uniform float uImgAspect; uniform float uSeed;
out vec4 o;
const float TAU = 6.28318530718;
vec3 pal(int i){
  if(i==0) return vec3(56,189,248); if(i==1) return vec3(251,146,60); if(i==2) return vec3(192,132,252);
  if(i==3) return vec3(255,133,150); if(i==4) return vec3(45,212,191); if(i==5) return vec3(96,165,250);
  if(i==6) return vec3(163,230,53); if(i==7) return vec3(251,191,36); if(i==8) return vec3(244,114,182);
  return vec3(249,115,22);
}
vec2 cover(vec2 frag){
  vec2 uv = frag / uRes; uv.y = 1.0 - uv.y;
  float ca = uRes.x / uRes.y;
  if (ca < uImgAspect) { float w = ca / uImgAspect; float x0 = clamp(uFocus - 0.5*w, 0.0, 1.0 - w); uv.x = x0 + uv.x * w; }
  else { float h = uImgAspect / ca; uv.y = 0.5 - 0.5*h + uv.y * h; }
  return uv;
}
float lum(vec3 c){ return dot(c, vec3(0.2126, 0.7152, 0.0722)); }
void main(){
  vec2 uv = cover(gl_FragCoord.xy);
  // Smooth field from a blurred mip level: contours follow form, not grain.
  float Lf = lum(textureLod(uImg, uv, 3.4).rgb);
  float Lm = lum(textureLod(uImg, uv, 4.6).rgb);
  Lf = pow(clamp(mix(Lf, Lm, 0.35), 0.0, 1.0), 0.9);
  float Ld = lum(textureLod(uImg, uv, 1.0).rgb);        // ghost of the photograph
  float s = fract(uTime / 40.0 + uSeed);
  float ph = Lf * 17.0 - s * 10.0 + 0.10 * sin(uv.y * 22.0 + TAU * s) + 0.07 * sin(uv.x * 17.0 - TAU * 2.0 * s);
  float fw = fwidth(ph) + 1e-5;
  float k = floor(ph + 0.5), dist = abs(ph - k);
  int idx = int(mod(mod(k, 10.0) + 10.0, 10.0));
  float core = 1.0 - smoothstep(0.0, fw * 1.35, dist);
  float glow = exp(-dist / (fw * 6.0)) * 0.42;
  float calm = 1.0 - smoothstep(0.45, 1.1, fw);
  vec3 navy = vec3(11.0, 30.0, 58.0) / 255.0, abyss = vec3(5.0, 8.0, 14.0) / 255.0, gold = vec3(214.0, 179.0, 90.0) / 255.0;
  vec3 col = mix(abyss, navy, 0.30) + mix(navy * 1.6, gold, Ld) * pow(Ld, 1.35) * 0.30;
  col += pal(idx) / 255.0 * (core + glow) * calm * 0.95;

  // observation lens
  float d = length(gl_FragCoord.xy - uLens) / max(uLensR, 1.0);
  float m = (1.0 - smoothstep(0.86, 1.0, d)) * uReveal;
  vec3 photo = texture(uImg, uv).rgb;
  photo = mix(photo, vec3(lum(photo)), 0.12) * 1.05;
  col = mix(col, photo, m);
  float rpx = abs(d - 1.0) * uLensR;
  float ring = (1.0 - min(rpx / 1.6, 1.0)) * uReveal;
  float ring2 = (1.0 - min(abs(d - 1.07) * uLensR / 1.1, 1.0)) * 0.45 * uReveal;
  col = mix(col, gold, max(ring, ring2));
  col += gold * exp(-pow(max(d - 1.0, 0.0) * 6.0, 2.0)) * 0.10 * uReveal;

  // vignette
  vec2 q = gl_FragCoord.xy / uRes - 0.5;
  col *= 1.0 - 0.55 * smoothstep(0.35, 0.85, length(q * vec2(1.0, 1.2)));
  o = vec4(clamp(col, 0.0, 1.0), 1.0);
}`;

  type Witness = { stop: () => void };

  function mountWitness(fig: HTMLElement): Witness | null {
    const canvas = fig.querySelector<HTMLCanvasElement>('.witness-canvas');
    if (!canvas) return null;
    const gl = canvas.getContext('webgl2', { antialias: false, alpha: false, powerPreference: 'low-power' });
    if (!gl) return null;

    const sh = (type: number, src: string) => { const x = gl.createShader(type)!; gl.shaderSource(x, src); gl.compileShader(x); return x; };
    const prog = gl.createProgram()!;
    gl.attachShader(prog, sh(gl.VERTEX_SHADER, VERT));
    gl.attachShader(prog, sh(gl.FRAGMENT_SHADER, FRAG));
    gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) return null;
    gl.useProgram(prog);
    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(prog, 'p');
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
    const u = (n: string) => gl.getUniformLocation(prog, n);
    const U = {
      res: u('uRes'), time: u('uTime'), lens: u('uLens'), lensR: u('uLensR'), reveal: u('uReveal'),
      focus: u('uFocus'), aspect: u('uImgAspect'), seed: u('uSeed'), img: u('uImg'),
    };

    const focus = Number(canvas.dataset.focus ?? 0.5);
    const seed = Number(canvas.dataset.seed ?? 0) / 10;
    let aspect = 1.5;
    let ready = false;
    const tex = gl.createTexture();
    const img = new Image();
    img.decoding = 'async';
    img.onload = () => {
      gl.bindTexture(gl.TEXTURE_2D, tex);
      gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, img);
      gl.generateMipmap(gl.TEXTURE_2D);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR_MIPMAP_LINEAR);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
      aspect = img.naturalWidth / img.naturalHeight;
      ready = true;
    };
    img.src = canvas.dataset.src ?? '';

    let w = 1, h = 1, dpr = 1;
    const resize = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 1.5);
      const r = canvas.getBoundingClientRect();
      w = Math.max(1, Math.round(r.width * dpr)); h = Math.max(1, Math.round(r.height * dpr));
      canvas.width = w; canvas.height = h; gl.viewport(0, 0, w, h);
    };
    resize();
    const ro = new ResizeObserver(resize); ro.observe(canvas);

    // Lens state: the pointer when present, otherwise a slow Lissajous wander.
    const pointer = { x: 0, y: 0, active: false };
    const lens = { x: 0, y: 0, r: 0, reveal: 0 };
    const toLocal = (ev: PointerEvent) => {
      const r = canvas.getBoundingClientRect();
      pointer.x = (ev.clientX - r.left) * dpr; pointer.y = (r.bottom - ev.clientY) * dpr;
    };
    fig.addEventListener('pointerenter', (ev) => { toLocal(ev); pointer.active = true; fig.classList.add('is-observing'); });
    fig.addEventListener('pointermove', (ev) => { toLocal(ev); pointer.active = true; fig.classList.add('is-observing'); }, { passive: true });
    const leave = () => { pointer.active = false; fig.classList.remove('is-observing'); };
    fig.addEventListener('pointerleave', leave);
    fig.addEventListener('pointercancel', leave);

    let visible = false, raf = 0, live = false;
    const io = new IntersectionObserver(([e]) => { visible = e.isIntersecting; }, { rootMargin: '100px 0px' });
    io.observe(fig);
    const t0 = performance.now();
    const phase = Number(canvas.dataset.seed ?? 0);

    const frame = (now: number) => {
      raf = requestAnimationFrame(frame);
      if (!visible || !ready || document.hidden) return;
      const t = (now - t0) / 1000;
      const base = Math.min(w, h);
      let tx: number, ty: number, tr: number, tv: number;
      if (pointer.active) {
        tx = pointer.x; ty = pointer.y; tr = base * 0.24; tv = 1;
      } else {
        // wander around the face (focus) region
        const cx = w * 0.5 + w * 0.22 * Math.sin(t * 0.21 + phase);
        const cy = h * 0.58 + h * 0.16 * Math.sin(t * 0.33 + phase * 1.7);
        tx = cx; ty = cy; tr = base * 0.15; tv = 0.92;
      }
      if (lens.r === 0) { lens.x = tx; lens.y = ty; }
      const k = pointer.active ? 0.22 : 0.05;
      lens.x += (tx - lens.x) * k; lens.y += (ty - lens.y) * k;
      lens.r += (tr - lens.r) * 0.08; lens.reveal += (tv - lens.reveal) * 0.08;

      gl.uniform2f(U.res, w, h);
      gl.uniform1f(U.time, t);
      gl.uniform2f(U.lens, lens.x, lens.y);
      gl.uniform1f(U.lensR, lens.r);
      gl.uniform1f(U.reveal, lens.reveal);
      gl.uniform1f(U.focus, focus);
      gl.uniform1f(U.aspect, aspect);
      gl.uniform1f(U.seed, seed);
      gl.uniform1i(U.img, 0);
      gl.activeTexture(gl.TEXTURE0);
      gl.bindTexture(gl.TEXTURE_2D, tex);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
      if (!live) { live = true; fig.classList.add('is-live'); }
    };
    raf = requestAnimationFrame(frame);
    return { stop: () => { cancelAnimationFrame(raf); io.disconnect(); ro.disconnect(); } };
  }

  let mounted: Witness[] = [];
  document.addEventListener('astro:page-load', () => {
    mounted.forEach((m) => m.stop());
    mounted = [];
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    document.querySelectorAll<HTMLElement>('.witness').forEach((fig) => {
      const m = mountWitness(fig);
      if (m) mounted.push(m);
    });
  });
</script>
