---
import { getLocalizedPath } from '../../lib/i18n';
import type { Locale } from '../../lib/i18n';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;

const t: Record<string, { label: string; body: string; exact: string; link: string }> = {
  en: {
    label: 'THE FANO PLANE',
    body: 'The octonions have seven imaginary units. Their multiplication table refuses to associate. Of all 343 ordered triples, exactly 168 resist. Not approximately. Exactly.',
    exact: '168 = |PSL(2,7)| = |Aut(Fano)|. Machine-checked inside the language.',
    link: 'See the machine-checked proof →',
  },
  pt: {
    label: 'O PLANO DE FANO',
    body: 'Os octoniões têm sete unidades imaginárias. A sua tabela de multiplicação recusa-se a associar. De todos os 343 triplos ordenados, exatamente 168 resistem. Não aproximadamente. Exatamente.',
    exact: '168 = |PSL(2,7)| = |Aut(Fano)|. Verificado por máquina dentro da linguagem.',
    link: 'Ver a prova verificada por máquina →',
  },
  es: {
    label: 'EL PLANO DE FANO',
    body: 'Los octoniones tienen siete unidades imaginarias. Su tabla de multiplicación se niega a asociar. De los 343 triples ordenados, exactamente 168 resisten. No aproximadamente. Exactamente.',
    exact: '168 = |PSL(2,7)| = |Aut(Fano)|. Verificado por máquina dentro del lenguaje.',
    link: 'Ver la prueba verificada por máquina →',
  },
  el: {
    label: 'ΤΟ ΕΠΙΠΕΔΟ FANO',
    body: 'Τα οκτόνια έχουν επτά φανταστικές μονάδες. Ο πίνακας πολλαπλασιασμού τους αρνείται να συνδεθεί. Από τα 343 διατεταγμένα τριπλέτα, ακριβώς 168 αντιστέκονται. Όχι κατά προσέγγιση. Ακριβώς.',
    exact: '168 = |PSL(2,7)| = |Aut(Fano)|. Επαληθευμένο από μηχανή μέσα στη γλώσσα.',
    link: 'Δείτε την απόδειξη επαληθευμένη από μηχανή →',
  },
  zh: {
    label: 'Fano 平面',
    body: '八元数有七个虚数单位。它们的乘法表拒绝结合律。在所有 343 个有序三元组中，恰好有 168 个抵制结合。不是近似值。恰好。',
    exact: '168 = |PSL(2,7)| = |Aut(Fano)|。在语言内部经机器验证。',
    link: '查看机器验证的证明 →',
  },
  ja: {
    label: 'ファノ平面',
    body: 'オクトニオンには七つの虚数単位があります。その乗法表は結合律を拒否します。343個の有順序三つ組のうち、ちょうど168個が抵抗します。近似ではなく。正確に。',
    exact: '168 = |PSL(2,7)| = |Aut(Fano)|。言語内でマシンチェック済み。',
    link: 'マシンチェック済みの証明を見る →',
  },
};

const d = t[locale] ?? t.en;
---

<section class="na-section" aria-label="168 theorem">
  <div class="na-bg" aria-hidden="true"></div>
  <div class="na-overlay" aria-hidden="true"></div>
  <div class="na-inner">
    <div class="na-number" aria-hidden="true">168</div>
    <div class="na-text">
      <p class="na-label">{d.label}</p>
      <p class="na-body">{d.body}</p>
      <p class="na-exact"><code>{d.exact}</code></p>
      <a href={getLocalizedPath('/proof#theorem-168', locale)} class="na-link">
        {d.link}
      </a>
    </div>
  </div>
</section>

<style>
  .na-section {
    position: relative;
    overflow: hidden;
    padding: 5.5rem 1.5rem;
    border-top: 1px solid var(--glass-border);
    border-bottom: 1px solid var(--glass-border);
  }

  .na-bg {
    position: absolute;
    inset: -10% 0;
    background-image: url('/assets/vision/act3-fractal.jpg');
    background-size: cover;
    background-position: center 40%;
    opacity: 0.22;
    will-change: transform;
  }

  .na-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      var(--color-bg) 0%,
      color-mix(in srgb, var(--color-bg) 55%, transparent) 20%,
      color-mix(in srgb, var(--color-bg) 45%, transparent) 80%,
      var(--color-bg) 100%
    );
  }

  .na-inner {
    position: relative;
    z-index: 1;
    max-width: 900px;
    margin: 0 auto;
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 640px) {
    .na-inner {
      grid-template-columns: auto 1fr;
      gap: 3.5rem;
    }
  }

  .na-number {
    font-family: var(--font-display);
    font-size: clamp(6rem, 18vw, 11rem);
    font-weight: 700;
    line-height: 0.88;
    background: linear-gradient(
      145deg,
      var(--color-accent-gold) 0%,
      var(--color-accent-gold-soft) 55%,
      rgba(214,179,90,0.45) 100%
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: -0.04em;
    user-select: none;
    min-width: 2ch;
  }

  .na-text {
    display: grid;
    gap: 0.85rem;
  }

  .na-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    color: var(--color-accent-gold-soft);
    text-transform: uppercase;
    margin: 0;
    opacity: 0.75;
  }

  .na-body {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--color-text-primary);
    margin: 0;
    max-width: 50ch;
    font-family: var(--font-display);
  }

  .na-exact {
    margin: 0;
  }

  .na-exact code {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--color-text-secondary);
    letter-spacing: 0.01em;
  }

  .na-link {
    font-size: 0.85rem;
    color: var(--color-accent-gold-soft);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.2rem;
    transition: opacity 0.2s;
  }

  .na-link:hover {
    opacity: 0.75;
    text-decoration: underline;
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    const section = document.querySelector<HTMLElement>('.na-section');
    const bg = document.querySelector<HTMLElement>('.na-bg');
    const counter = document.querySelector<HTMLElement>('.na-number');
    const textChildren = document.querySelectorAll('.na-text > *');

    if (!section || !bg || !counter) return;

    // background parallax
    gsap.to(bg, {
      yPercent: 15,
      ease: 'none',
      scrollTrigger: {
        trigger: section,
        start: 'top bottom',
        end: 'bottom top',
        scrub: 1.5,
      },
    });

    // number count-up
    const obj = { val: 0 };
    gsap.to(obj, {
      val: 168,
      duration: 1.6,
      ease: 'power3.out',
      scrollTrigger: {
        trigger: counter,
        start: 'top 85%',
        once: true,
      },
      onUpdate() {
        counter.textContent = String(Math.round(obj.val));
      },
    });

    // text cascade
    gsap.from(Array.from(textChildren), {
      y: 28,
      opacity: 0,
      stagger: 0.12,
      duration: 0.75,
      ease: 'power2.out',
      scrollTrigger: {
        trigger: section,
        start: 'top 72%',
        once: true,
      },
    });
  });
</script>
