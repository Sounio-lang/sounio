---
import { getLocalizedPath } from '../../lib/i18n';
import type { Locale } from '../../lib/i18n';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;

type LedgerRow = { label: string; value: string };
type Copy = {
  label: string;
  number: string;
  heading: string;
  seal: string;
  body: string;
  exact: string;
  link: string;
  chain: string[];
  ledger: LedgerRow[];
  verdict: string;
};

const t: Record<string, Copy> = {
  en: {
    label: 'BOOTSTRAP RECEIPT',
