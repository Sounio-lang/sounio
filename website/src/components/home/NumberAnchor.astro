    heading: 'A compiler convergence receipt.',
    seal: 'guarded sites',
    body: 'After the epistemic boundary, Sounio shows the other side of the contract: when this bootstrap gate reaches the next generation, the receipt remains a concrete record. Gen₂ and gen₃ produced a matching recorded digest; the audited guarded-call-site count is zero for this run.',
    exact: 'recorded digest match: gen₂.elf and gen₃.elf · 15,636 call sites · 0 guarded · 1.25 MB',
    link: 'Read the bootstrap receipt →',
    chain: ['source', 'gen₂ compiler', 'gen₃ compiler', 'matching digest'],
    ledger: [
      { label: 'expressions tracked', value: '113,931' },
      { label: 'call sites audited', value: '15,636' },
      { label: 'guarded sites in gate', value: '0' },
      { label: 'binary receipt', value: '1.25 MB' },
    ],
