  },
  pt: {
    label: 'RECIBO DE BOOTSTRAP',
    number: '0',
    heading: 'Um recibo de convergência do compilador.',
    seal: 'sites guardados',
    body: 'Depois da fronteira epistêmica, Sounio mostra o outro lado do contrato: quando este gate de bootstrap alcança a próxima geração, o recibo permanece um registro concreto. Gen₂ e gen₃ produziram um digest registrado correspondente; a contagem auditada de call sites guardados é zero nesta execução.',
    exact: 'digest registrado correspondente: gen₂.elf e gen₃.elf · 15.636 call sites · 0 guardados · 1,25 MB',
    link: 'Ler o recibo de bootstrap →',
    chain: ['fonte', 'compilador gen₂', 'compilador gen₃', 'digest igual'],
    ledger: [
      { label: 'expressões rastreadas', value: '113.931' },
      { label: 'call sites auditados', value: '15.636' },
      { label: 'sites guardados no gate', value: '0' },
      { label: 'recibo binário', value: '1,25 MB' },
    ],
    verdict: 'digest gen₂/gen₃ igual neste escopo',
  },
  es: {
    label: 'RECIBO DE BOOTSTRAP',
    number: '0',
    heading: 'Un recibo de convergencia del compilador.',
    seal: 'sitios guardados',
    body: 'Después de la frontera epistémica, Sounio muestra el otro lado del contrato: cuando este gate de bootstrap alcanza la siguiente generación, el recibo sigue siendo un registro concreto. Gen₂ y gen₃ produjeron un digest registrado coincidente; el recuento auditado de call sites guardados es cero en esta ejecución.',
    exact: 'digest registrado coincidente: gen₂.elf y gen₃.elf · 15.636 call sites · 0 guardados · 1,25 MB',
    link: 'Leer el recibo de bootstrap →',
    chain: ['fuente', 'compilador gen₂', 'compilador gen₃', 'digest igual'],
    ledger: [
      { label: 'expresiones rastreadas', value: '113.931' },
      { label: 'call sites auditados', value: '15.636' },
      { label: 'sitios guardados en el gate', value: '0' },
      { label: 'recibo binario', value: '1,25 MB' },
    ],
    verdict: 'digest gen₂/gen₃ igual en este alcance',
  },
  el: {
    label: 'ΑΠΟΔΕΙΚΤΙΚΟ BOOTSTRAP',
    number: '0',
    heading: 'Μια απόδειξη σύγκλισης του compiler.',
    seal: 'φυλαγμένα sites',
    body: 'Μετά το επιστημικό όριο, το Sounio δείχνει την άλλη πλευρά του συμβολαίου: όταν αυτό το bootstrap gate φτάνει στην επόμενη γενιά, το αποδεικτικό παραμένει συγκεκριμένο. Gen₂ και gen₃ παρήγαγαν ταιριαστό καταγεγραμμένο digest· η ελεγμένη μέτρηση φυλαγμένων call sites είναι μηδέν σε αυτή την εκτέλεση.',
    exact: 'ταιριαστό καταγεγραμμένο digest: gen₂.elf και gen₃.elf · 15.636 call sites · 0 φυλαγμένα · 1,25 MB',
    link: 'Διαβάστε το bootstrap receipt →',
    chain: ['πηγή', 'compiler gen₂', 'compiler gen₃', 'ίδιο digest'],
    ledger: [
      { label: 'εκφράσεις υπό παρακολούθηση', value: '113.931' },
      { label: 'call sites ελεγμένα', value: '15.636' },
      { label: 'φυλαγμένα sites στο gate', value: '0' },
      { label: 'δυαδική απόδειξη', value: '1,25 MB' },
    ],
    verdict: 'ίδιο gen₂/gen₃ digest σε αυτό το scope',
  },
  zh: {
    label: '自举收据',
    number: '0',
    heading: '编译器收敛收据。',
    seal: '受防护调用点',
    body: '在知识边界之后，Sounio 展示契约的另一面：当这个自举 gate 到达下一代时，收据仍然具体。Gen₂ 与 gen₃ 生成了匹配的记录摘要；此运行中的受防护调用点审计计数为零。',
    exact: '记录摘要匹配: gen₂.elf 与 gen₃.elf · 15,636 个调用点 · 0 个受防护 · 1.25 MB',
    link: '阅读自举收据 →',
    chain: ['源代码', 'gen₂ 编译器', 'gen₃ 编译器', '匹配摘要'],
    ledger: [
      { label: '追踪表达式', value: '113,931' },
      { label: '审计调用点', value: '15,636' },
      { label: 'gate 内受防护点', value: '0' },
      { label: '二进制收据', value: '1.25 MB' },
    ],
    verdict: '此范围内 gen₂/gen₃ 摘要匹配',
  },
  ja: {
    label: 'ブートストラップ受領書',
    number: '0',
    heading: 'コンパイラ収束の受領書。',
    seal: 'ガード箇所',
    body: '認識論的境界の後で、Sounio は契約のもう一つの面を示します。この bootstrap gate が次の世代に到達するとき、受領書は具体的なままです。Gen₂ と gen₃ は一致する記録済み digest を生成し、この実行でのガード済みコールサイト監査数はゼロです。',
    exact: '記録済み digest 一致: gen₂.elf と gen₃.elf · 15,636 コールサイト · 0 ガード · 1.25 MB',
    link: 'ブートストラップ受領書を読む →',
    chain: ['ソース', 'gen₂ コンパイラ', 'gen₃ コンパイラ', '一致 digest'],
    ledger: [
      { label: '追跡された式', value: '113,931' },
      { label: '監査されたコールサイト', value: '15,636' },
      { label: 'gate 内のガード箇所', value: '0' },
      { label: 'バイナリ受領書', value: '1.25 MB' },
    ],
    verdict: 'この範囲で gen₂/gen₃ digest が一致',
  },
};

const d = t[locale] ?? t.en;
---

<section class="na-section" aria-label="Bootstrap convergence receipt">
  <div class="na-bg" aria-hidden="true"></div>
  <div class="na-overlay" aria-hidden="true"></div>
  <div class="na-inner">
    <div class="na-text">
      <p class="na-label">{d.label}</p>
      <h2 class="na-heading">{d.heading}</h2>
      <p class="na-body">{d.body}</p>
      <a href={getLocalizedPath('/compiler#bootstrap-convergence', locale)} class="na-link">
        {d.link}
      </a>
    </div>
    <div class="na-receipt" aria-label={d.label}>
      <div class="na-seal">
        <div class="na-seal-ring" aria-hidden="true">
          <span class="na-seal-value">{d.number}</span>
        </div>
        <p>{d.seal}</p>
      </div>
      <div class="na-chain" aria-label="Bootstrap convergence chain">
        {d.chain.map((item, index) => (
          <>
            <span class:list={['na-chain-node', { 'is-final': index === d.chain.length - 1 }]}>{item}</span>
            {index < d.chain.length - 1 && <span class="na-chain-arrow" aria-hidden="true">→</span>}
          </>
        ))}
      </div>
      <dl class="na-ledger">
        {d.ledger.map((row) => (
          <div class="na-ledger-row">
            <dt>{row.label}</dt>
            <dd>{row.value}</dd>
          </div>
        ))}
      </dl>
      <div class="na-verdict">
        <span aria-hidden="true"></span>
        <p>{d.verdict}</p>
      </div>
      <p class="na-exact"><code>{d.exact}</code></p>
    </div>
  </div>
</section>

<style>
  .na-section {
    position: relative;
    overflow: hidden;
    padding: 5.5rem 1.5rem;
    border-top: 1px solid var(--glass-border);
    border-bottom: 1px solid var(--glass-border);
  }

  .na-bg {
    position: absolute;
    inset: -10% 0;
    background-image: url('/assets/vision/act1-column.jpg');
    background-size: cover;
    background-position: center 35%;
    opacity: 0.18;
    will-change: transform;
  }

  .na-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      var(--color-bg) 0%,
      color-mix(in srgb, var(--color-bg) 55%, transparent) 20%,
      color-mix(in srgb, var(--color-bg) 45%, transparent) 80%,
      var(--color-bg) 100%
    );
  }

  .na-inner {
    position: relative;
    z-index: 1;
    max-width: 1120px;
    margin: 0 auto;
    display: grid;
    gap: 2.4rem;
    align-items: center;
  }

  @media (min-width: 860px) {
    .na-inner {
      grid-template-columns: minmax(0, 0.92fr) minmax(420px, 1.08fr);
      gap: 4rem;
    }
  }

  .na-text {
    display: grid;
    gap: 0.85rem;
  }

  .na-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    color: var(--color-accent-gold-soft);
    text-transform: uppercase;
    margin: 0;
    opacity: 0.75;
  }

  .na-heading {
    margin: 0;
    max-width: 10ch;
    font-family: var(--font-display);
    font-size: 3.35rem;
    line-height: 0.98;
    color: var(--color-text-primary);
  }

  .na-body {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--color-text-primary);
    margin: 0;
    max-width: 50ch;
    font-family: var(--font-display);
  }

  .na-receipt {
    display: grid;
    gap: 1rem;
    padding: 1.15rem;
    border: 1px solid color-mix(in srgb, var(--color-accent-gold) 32%, transparent);
    border-radius: 8px;
    background:
      linear-gradient(135deg, rgba(214, 179, 90, 0.12), transparent 42%),
      color-mix(in srgb, var(--color-bg) 82%, rgba(11, 30, 58, 0.72));
    box-shadow: 0 26px 80px rgba(0, 0, 0, 0.28);
  }

  .na-seal {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    align-items: center;
    padding-bottom: 1rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-accent-gold) 20%, transparent);
  }

  .na-seal-ring {
    width: 8.75rem;
    height: 8.75rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--color-accent-gold) 72%, transparent);
    background:
      radial-gradient(circle at 36% 28%, rgba(255, 235, 180, 0.38), transparent 22%),
      radial-gradient(circle at 50% 52%, color-mix(in srgb, var(--color-bg) 82%, rgba(214, 179, 90, 0.2)) 0 56%, transparent 57%),
      conic-gradient(from 12deg, rgba(214, 179, 90, 0.26), var(--color-accent-gold), rgba(214, 179, 90, 0.28), rgba(43, 166, 179, 0.28), rgba(214, 179, 90, 0.26));
    box-shadow:
      inset 0 0 0 0.62rem color-mix(in srgb, var(--color-bg) 92%, transparent),
      inset 0 0 0 0.75rem color-mix(in srgb, var(--color-accent-gold) 34%, transparent);
    font-family: var(--font-display);
    color: var(--color-accent-gold-soft);
  }

  .na-seal-value {
    font-size: 3.9rem;
    font-weight: 700;
    line-height: 1;
  }

  .na-seal p {
    margin: 0;
    max-width: 16ch;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    line-height: 1.5;
    letter-spacing: 0.14em;
    color: var(--color-accent-gold-soft);
    text-transform: uppercase;
  }

  .na-chain {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
    gap: 0.5rem;
    align-items: center;
  }

  .na-chain-node {
    min-height: 3.2rem;
    display: grid;
    place-items: center;
    padding: 0.65rem 0.5rem;
    border: 1px solid color-mix(in srgb, var(--color-accent-gold) 22%, transparent);
    border-radius: 6px;
    background: color-mix(in srgb, var(--color-bg) 68%, rgba(255, 255, 255, 0.06));
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.25;
    text-align: center;
    text-transform: uppercase;
  }

  .na-chain-node.is-final {
    border-color: color-mix(in srgb, var(--color-accent-gold) 54%, transparent);
    color: var(--color-text-primary);
  }

  .na-chain-arrow {
    color: var(--color-accent-gold-soft);
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }

  .na-ledger {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65rem;
    margin: 0;
  }

  .na-ledger-row {
    min-height: 5.1rem;
    display: grid;
    align-content: space-between;
    gap: 0.55rem;
    padding: 0.78rem;
    border: 1px solid color-mix(in srgb, var(--color-accent-gold) 17%, transparent);
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.035);
  }

  .na-ledger dt {
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: 0.67rem;
    letter-spacing: 0.06em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .na-ledger dd {
    margin: 0;
    color: var(--color-text-primary);
    font-family: var(--font-display);
    font-size: 1.75rem;
    line-height: 1;
  }

  .na-verdict {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.76rem 0.85rem;
    border: 1px solid color-mix(in srgb, var(--color-accent-teal) 35%, transparent);
    border-radius: 6px;
    color: var(--color-text-primary);
    background: color-mix(in srgb, var(--color-accent-teal) 10%, transparent);
  }

  .na-verdict span {
    width: 0.55rem;
    height: 0.55rem;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--color-accent-teal);
    box-shadow: 0 0 18px color-mix(in srgb, var(--color-accent-teal) 60%, transparent);
  }

  .na-verdict p {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    line-height: 1.45;
    text-transform: uppercase;
  }

  .na-exact {
    margin: 0;
  }

  .na-exact code {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--color-text-secondary);
    letter-spacing: 0.01em;
    overflow-wrap: anywhere;
  }

  .na-link {
    font-size: 0.85rem;
    color: var(--color-accent-gold-soft);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.2rem;
    transition: opacity 0.2s;
  }

  .na-link:hover {
    opacity: 0.75;
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .na-section {
      padding: 4.5rem 1rem;
    }

    .na-heading {
      max-width: 11ch;
      font-size: 2.35rem;
    }

    .na-receipt {
      padding: 0.9rem;
    }

    .na-seal {
      grid-template-columns: 1fr;
    }

    .na-seal-ring {
      width: 7.25rem;
      height: 7.25rem;
    }

    .na-seal-value {
      font-size: 3.15rem;
    }

    .na-chain {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }

    .na-chain-arrow {
      justify-self: center;
      font-size: 1rem;
      line-height: 1;
      transform: rotate(90deg);
    }

    .na-ledger {
      grid-template-columns: 1fr;
      gap: 0.55rem;
    }

    .na-ledger-row {
      min-height: 4.65rem;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    const section = document.querySelector<HTMLElement>('.na-section');
    const bg = document.querySelector<HTMLElement>('.na-bg');
    const numberEl = document.querySelector<HTMLElement>('.na-seal-value');
    const textChildren = document.querySelectorAll('.na-text > *');
    const receiptChildren = document.querySelectorAll('.na-receipt > *');

    if (!section || !bg || !numberEl) return;

    // background parallax
    gsap.to(bg, {
      yPercent: 15,
      ease: 'none',
      scrollTrigger: {
        trigger: section,
        start: 'top bottom',
        end: 'bottom top',
        scrub: 1.5,
      },
    });

    // Count down to the number of guarded call sites in the fixed-point receipt.
    const obj = { val: 0 };
    gsap.to(obj, {
      val: Number(numberEl.textContent ?? 0),
      duration: 1.8,
      ease: 'power3.out',
      scrollTrigger: {
        trigger: numberEl,
        start: 'top 85%',
        once: true,
      },
      onUpdate() {
        const v = Math.round(obj.val);
        numberEl.textContent = String(v);
      },
    });

    // text and receipt cascade
    gsap.from([...Array.from(textChildren), ...Array.from(receiptChildren)], {
      y: 28,
      opacity: 0,
      stagger: 0.08,
      duration: 0.75,
      ease: 'power2.out',
      scrollTrigger: {
        trigger: section,
        start: 'top 72%',
        once: true,
      },
    });
  });
</script>
