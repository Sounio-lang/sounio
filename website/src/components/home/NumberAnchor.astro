---
import { getLocalizedPath } from '../../lib/i18n';
import type { Locale } from '../../lib/i18n';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;

const t: Record<string, { label: string; number: string; body: string; exact: string; link: string }> = {
  en: {
    label: 'GEOMETRIC EARLY WARNING',
    number: '40',
    body: 'The affect-network curls before the crisis arrives. Forty days of daily mood tracking — that is all it takes to certify the geometry. The compiler propagated the uncertainty GUM-exact. No Monte Carlo. No guessing.',
    exact: 'κ̄ ± σ — Ollivier-Ricci curvature, certified via forward-mode AD through Sinkhorn fixed-point.',
    link: 'See the certified sample-size proof →',
  },
  pt: {
    label: 'AVISO ANTECIPADO GEOMÉTRICO',
    number: '40',
    body: 'A rede de afeto enrola-se antes de a crise chegar. Quarenta dias de rastreamento diário de humor — é tudo o que é preciso para certificar a geometria. O compilador propagou a incerteza segundo a GUM, exatamente. Sem Monte Carlo. Sem adivinhação.',
    exact: 'κ̄ ± σ — curvatura de Ollivier-Ricci, certificada via AD em modo direto através do ponto fixo de Sinkhorn.',
    link: 'Ver a prova do tamanho mínimo certificado →',
  },
  es: {
    label: 'ADVERTENCIA TEMPRANA GEOMÉTRICA',
    number: '40',
    body: 'La red afectiva se curva antes de que llegue la crisis. Cuarenta días de seguimiento diario del estado de ánimo — eso es todo lo necesario para certificar la geometría. El compilador propagó la incertidumbre GUM-exacto. Sin Monte Carlo. Sin suposiciones.',
    exact: 'κ̄ ± σ — curvatura de Ollivier-Ricci, certificada vía AD en modo directo a través del punto fijo de Sinkhorn.',
    link: 'Ver la prueba de tamaño de muestra certificado →',
  },
  el: {
    label: 'ΓΕΩΜΕΤΡΙΚΗ ΕΓΚΑΙΡΗ ΠΡΟΕΙΔΟΠΟΙΗΣΗ',
    number: '40',
    body: 'Το δίκτυο συναισθημάτων κυρτώνεται πριν φτάσει η κρίση. Σαράντα ημέρες ημερήσιας παρακολούθησης της διάθεσης — αυτό αρκεί για να πιστοποιηθεί η γεωμετρία. Ο compiler διέδωσε την αβεβαιότητα κατά GUM, ακριβώς. Χωρίς Monte Carlo. Χωρίς εικασίες.',
    exact: 'κ̄ ± σ — καμπυλότητα Ollivier-Ricci, πιστοποιημένη μέσω forward-mode AD μέσω σταθερού σημείου Sinkhorn.',
    link: 'Δείτε την πιστοποιημένη απόδειξη ελάχιστου μεγέθους δείγματος →',
  },
  zh: {
    label: '几何早期预警',
    number: '40',
    body: '情感网络在危机到来之前弯曲。四十天的日常情绪追踪——这就是认证这种几何形状所需要的一切。编译器按 GUM 精确传播了不确定性。无需蒙特卡罗。无需猜测。',
    exact: 'κ̄ ± σ — Ollivier-Ricci 曲率，通过 Sinkhorn 不动点的前向模式 AD 认证。',
    link: '查看认证的最小样本量证明 →',
  },
  ja: {
    label: '幾何学的早期警告',
    number: '40',
    body: '感情ネットワークは危機が訪れる前に曲がります。毎日の気分追跡40日間——それがこの幾何学を認証するのに必要なすべてです。コンパイラはGUM正確に不確実性を伝播しました。モンテカルロなし。推測なし。',
    exact: 'κ̄ ± σ — Sinkhorn不動点を通じた前向きモードADで認証されたOllivier-Ricci曲率。',
    link: '認証された最小サンプルサイズの証明を見る →',
  },
};

const d = t[locale] ?? t.en;
---

<section class="na-section" aria-label="Certified geometric early warning">
  <div class="na-bg" aria-hidden="true"></div>
  <div class="na-overlay" aria-hidden="true"></div>
  <div class="na-inner">
    <div class="na-number" aria-hidden="true">{d.number}</div>
    <div class="na-text">
      <p class="na-label">{d.label}</p>
      <p class="na-body">{d.body}</p>
      <p class="na-exact"><code>{d.exact}</code></p>
      <a href={getLocalizedPath('/proof#ews-sample-size', locale)} class="na-link">
        {d.link}
      </a>
    </div>
  </div>
</section>

<style>
  .na-section {
    position: relative;
    overflow: hidden;
    padding: 5.5rem 1.5rem;
    border-top: 1px solid var(--glass-border);
    border-bottom: 1px solid var(--glass-border);
  }

  .na-bg {
    position: absolute;
    inset: -10% 0;
    background-image: url('/assets/vision/act2-poseidon.jpg');
    background-size: cover;
    background-position: center 45%;
    opacity: 0.2;
    will-change: transform;
  }

  .na-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      var(--color-bg) 0%,
      color-mix(in srgb, var(--color-bg) 55%, transparent) 20%,
      color-mix(in srgb, var(--color-bg) 45%, transparent) 80%,
      var(--color-bg) 100%
    );
  }

  .na-inner {
    position: relative;
    z-index: 1;
    max-width: 900px;
    margin: 0 auto;
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 640px) {
    .na-inner {
      grid-template-columns: auto 1fr;
      gap: 3.5rem;
    }
  }

  .na-number {
    font-family: var(--font-display);
    font-size: clamp(6rem, 18vw, 11rem);
    font-weight: 700;
    line-height: 0.88;
    background: linear-gradient(
      145deg,
      var(--color-accent-gold) 0%,
      var(--color-accent-gold-soft) 55%,
      rgba(214,179,90,0.45) 100%
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: -0.04em;
    user-select: none;
    min-width: 2ch;
  }

  .na-text {
    display: grid;
    gap: 0.85rem;
  }

  .na-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    color: var(--color-accent-gold-soft);
    text-transform: uppercase;
    margin: 0;
    opacity: 0.75;
  }

  .na-body {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--color-text-primary);
    margin: 0;
    max-width: 50ch;
    font-family: var(--font-display);
  }

  .na-exact {
    margin: 0;
  }

  .na-exact code {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--color-text-secondary);
    letter-spacing: 0.01em;
  }

  .na-link {
    font-size: 0.85rem;
    color: var(--color-accent-gold-soft);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.2rem;
    transition: opacity 0.2s;
  }

  .na-link:hover {
    opacity: 0.75;
    text-decoration: underline;
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    const section = document.querySelector<HTMLElement>('.na-section');
    const bg = document.querySelector<HTMLElement>('.na-bg');
    const counter = document.querySelector<HTMLElement>('.na-number');
    const textChildren = document.querySelectorAll('.na-text > *');

    if (!section || !bg || !counter) return;

    // background parallax
    gsap.to(bg, {
      yPercent: 15,
      ease: 'none',
      scrollTrigger: {
        trigger: section,
        start: 'top bottom',
        end: 'bottom top',
        scrub: 1.5,
      },
    });

    // number count-up (0 → 40)
    const target = parseInt(counter.textContent ?? '40', 10);
    const obj = { val: 0 };
    gsap.to(obj, {
      val: target,
      duration: 1.4,
      ease: 'power3.out',
      scrollTrigger: {
        trigger: counter,
        start: 'top 85%',
        once: true,
      },
      onUpdate() {
        counter.textContent = String(Math.round(obj.val));
      },
    });

    // text cascade
    gsap.from(Array.from(textChildren), {
      y: 28,
      opacity: 0,
      stagger: 0.12,
      duration: 0.75,
      ease: 'power2.out',
      scrollTrigger: {
        trigger: section,
        start: 'top 72%',
        once: true,
      },
    });
  });
</script>
