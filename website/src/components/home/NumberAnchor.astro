---
import { getLocalizedPath } from '../../lib/i18n';
import type { Locale } from '../../lib/i18n';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;

// Measured 2026-10-06 with the checked self-hosted artifact on its own seed:
//   ./artifacts/self-hosted/souc-self-hosted-x86_64 self-hosted/compiler/lean_single.sio /dev/null
//   epistemic: 184718 expr, 184662 certain, 56 uncertain · gates[direct=25968 guarded=0]
// Fixed point: `make build` (lean_single) gen2 == gen3, MD5 4b6b478d… (TOUR.md, CI step
// "Canonical lean_single fixed point"). Madaros, the default engine, has not reached one yet.
const EXACT = 'epistemic: 184,718 expr · 184,662 certain · 56 uncertain · gates: 25,968 direct, 0 guarded';
const t: Record<string, { label: string; number: string; body: string; exact: string; link: string }> = {
  en: {
    label: 'Epistemic self-census',
    number: '99.97',
    body: 'The compiler turns its uncertainty analysis on its own source. Compiling the lean_single seed, it classifies 184,718 expressions: 184,662 certain, 56 uncertain, and none of its 25,968 call sites needs a runtime guard. The same seed reaches a bootstrap fixed point, gen₂ and gen₃ byte-identical, checked in CI. Madaros, the default engine, does not compile itself to a fixed point yet.',
    exact: EXACT,
    link: 'See the bootstrap →',
  },
  pt: {
    label: 'Autocenso epistêmico',
    number: '99,97',
    body: 'O compilador aplica sua análise de incerteza ao próprio código-fonte. Ao compilar a semente lean_single, ele classifica 184.718 expressões: 184.662 certas, 56 incertas, e nenhuma das 25.968 chamadas precisa de guarda em tempo de execução. A mesma semente atinge um ponto fixo de bootstrap, gen₂ e gen₃ idênticos byte a byte, verificado na CI. O Madaros, o motor padrão, ainda não se compila até um ponto fixo.',
    exact: EXACT,
    link: 'Ver o bootstrap →',
  },
  es: {
    label: 'Autocenso epistémico',
    number: '99,97',
    body: 'El compilador aplica su análisis de incertidumbre a su propio código fuente. Al compilar la semilla lean_single clasifica 184.718 expresiones: 184.662 ciertas, 56 inciertas, y ninguna de sus 25.968 llamadas necesita una guarda en tiempo de ejecución. La misma semilla alcanza un punto fijo de bootstrap, gen₂ y gen₃ idénticos byte a byte, verificado en CI. Madaros, el motor por defecto, todavía no se compila a sí mismo hasta un punto fijo.',
    exact: EXACT,
    link: 'Ver el bootstrap →',
  },
  el: {
    label: 'Επιστημική αυτοαπογραφή',
    number: '99,97',
    body: 'Ο μεταγλωττιστής εφαρμόζει την ανάλυση αβεβαιότητας στον δικό του πηγαίο κώδικα. Μεταγλωττίζοντας τον σπόρο lean_single ταξινομεί 184.718 εκφράσεις: 184.662 βέβαιες, 56 αβέβαιες, και καμία από τις 25.968 κλήσεις δεν χρειάζεται φρουρό κατά την εκτέλεση. Ο ίδιος σπόρος φτάνει σε σταθερό σημείο bootstrap, με gen₂ και gen₃ ταυτόσημα byte προς byte, ελεγμένο στο CI. Ο Madaros, η προεπιλεγμένη μηχανή, δεν μεταγλωττίζει ακόμη τον εαυτό του σε σταθερό σημείο.',
    exact: EXACT,
    link: 'Δείτε το bootstrap →',
  },
  zh: {
    label: '认识论自检',
    number: '99.97',
    body: '编译器把不确定性分析用在自己的源代码上。编译 lean_single 种子时，它对 184,718 个表达式分类：184,662 个确定，56 个不确定，25,968 个调用点都不需要运行时防护。同一种子达到自举不动点，gen₂ 与 gen₃ 逐字节相同，并在 CI 中检查。默认引擎 Madaros 目前还不能把自身编译到不动点。',
    exact: EXACT,
    link: '查看自举 →',
  },
  'zh-hk': {
    label: '認識論自檢',
    number: '99.97',
    body: '編譯器將不確定性分析應用喺自己嘅源碼上。編譯 lean_single 種子時，佢將 184,718 個表達式分類：184,662 個確定、56 個不確定，25,968 個調用點都唔需要運行時防護。同一種子達到自舉不動點，gen₂ 同 gen₃ 逐字節相同，並喺 CI 檢查。預設引擎 Madaros 暫時仲未能將自己編譯到不動點。',
    exact: EXACT,
    link: '查看自舉 →',
  },
  ja: {
    label: '認識論的セルフセンサス',
    number: '99.97',
    body: 'コンパイラは不確実性解析を自分自身のソースに適用します。lean_single シードをコンパイルすると 184,718 個の式を分類し、184,662 個が確実、56 個が不確実で、25,968 か所の呼び出しのどれも実行時ガードを必要としません。同じシードはブートストラップの不動点に達し、gen₂ と gen₃ はバイト単位で一致し、CI で検査されています。既定エンジンの Madaros は、まだ自分自身を不動点までコンパイルできません。',
    exact: EXACT,
    link: 'ブートストラップを見る →',
  },
};

const d = t[locale] ?? t.en;
---

<section class="na-section" aria-label="Epistemic fixed point">
  <div class="na-bg" aria-hidden="true"></div>
  <div class="na-overlay" aria-hidden="true"></div>
  <div class="na-inner">
    <div class="na-number" aria-hidden="true">{d.number}<span class="na-pct">%</span></div>
    <div class="na-text">
      <p class="na-label">{d.label}</p>
      <p class="na-body">{d.body}</p>
      <p class="na-exact"><code>{d.exact}</code></p>
      <a href={getLocalizedPath('/compiler#bootstrap', locale)} class="na-link">
        {d.link}
      </a>
    </div>
  </div>
</section>

<style>
  .na-section {
    position: relative;
    overflow: hidden;
    padding: 5.5rem 1.5rem;
    border-top: 1px solid var(--glass-border);
    border-bottom: 1px solid var(--glass-border);
  }

  .na-bg {
    position: absolute;
    inset: -10% 0;
    background-image: url('/assets/vision/act1-column.jpg');
    background-size: cover;
    background-position: center 35%;
    opacity: 0.18;
    will-change: transform;
  }

  .na-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      var(--color-bg) 0%,
      color-mix(in srgb, var(--color-bg) 55%, transparent) 20%,
      color-mix(in srgb, var(--color-bg) 45%, transparent) 80%,
      var(--color-bg) 100%
    );
  }

  .na-inner {
    position: relative;
    z-index: 1;
    max-width: 900px;
    margin: 0 auto;
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 640px) {
    .na-inner {
      grid-template-columns: auto 1fr;
      gap: 3.5rem;
    }
  }

  .na-number {
    font-family: var(--font-display);
    font-size: clamp(3.75rem, 10vw, 7rem);
    font-weight: 700;
    line-height: 0.88;
    background: linear-gradient(
      145deg,
      var(--color-accent-gold) 0%,
      var(--color-accent-gold-soft) 55%,
      rgba(214,179,90,0.45) 100%
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: -0.04em;
    user-select: none;
  }

  .na-pct {
    font-size: 0.45em;
    vertical-align: super;
    letter-spacing: 0;
  }

  .na-text {
    display: grid;
    gap: 0.85rem;
  }

  .na-label {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent-gold-text);
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0;

  }

  .na-body {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--color-text-primary);
    margin: 0;
    max-width: 50ch;
    font-family: var(--font-display);
  }

  .na-exact {
    margin: 0;
  }

  .na-exact code {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--color-text-secondary);
    letter-spacing: 0.01em;
  }

  .na-link {
    font-size: 0.85rem;
    color: var(--color-accent-gold-soft);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.2rem;
    transition: opacity 0.2s;
  }

  .na-link:hover {
    opacity: 0.75;
    text-decoration: underline;
  }

  .na-label::before { content: ''; width: 2rem; height: 2px; background: var(--color-accent-gold); flex: none; }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    const section = document.querySelector<HTMLElement>('.na-section');
    const bg = document.querySelector<HTMLElement>('.na-bg');
    const numberEl = document.querySelector<HTMLElement>('.na-number');
    const pctEl = document.querySelector<HTMLElement>('.na-pct');
    const textChildren = document.querySelectorAll('.na-text > *');

    if (!section || !bg || !numberEl || !pctEl) return;

    // background parallax
    gsap.to(bg, {
      yPercent: 15,
      ease: 'none',
      scrollTrigger: {
        trigger: section,
        start: 'top bottom',
        end: 'bottom top',
        scrub: 1.5,
      },
    });

    // count-up 0 → measured value, % sign fades in at the end
    gsap.set(pctEl, { opacity: 0 });
    const finalText = numberEl.firstChild!.textContent ?? '0';
    const sep = finalText.includes(',') ? ',' : '.';
    const target = Number(finalText.replace(',', '.'));
    const obj = { val: 0 };
    gsap.to(obj, {
      val: target,
      duration: 1.8,
      ease: 'power3.out',
      scrollTrigger: {
        trigger: numberEl,
        start: 'top 85%',
        once: true,
      },
      onUpdate() {
        numberEl.firstChild!.textContent = obj.val.toFixed(2).replace('.', sep);
      },
      onComplete() {
        gsap.to(pctEl, { opacity: 1, duration: 0.4, ease: 'power1.out' });
      },
    });

    // text cascade
    gsap.from(Array.from(textChildren), {
      y: 28,
      opacity: 0,
      stagger: 0.12,
      duration: 0.75,
      ease: 'power2.out',
      scrollTrigger: {
        trigger: section,
        start: 'top 72%',
        once: true,
      },
    });
  });
</script>
