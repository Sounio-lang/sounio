---
import { getLocalizedPath } from '../../lib/i18n';
import type { Locale } from '../../lib/i18n';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;

const t: Record<string, { label: string; number: string; body: string; exact: string; link: string }> = {
  en: {
    label: 'THE DISCOVERY',
    number: '168',
    body: 'We were building a language. The language found a number nobody had seen before. 168. The number of ways octonion multiplication can go wrong. It’s now a theorem — verified computationally, reproduced independently, submitted for publication. That’s what happens when you build tools that respect the unknown.',
    exact: '343 = 133 (repeated) + 42 (Fano-line) + 168 (non-collinear) · sedenion counts are multiples of 168 · primitive zero-divisor pairs 336 = 2 × 168',
    link: 'Read the 168 theorem →',
  },
  pt: {
    label: 'PONTO FIXO EPISTÉMICO',
    number: '100',
    body: 'A linguagem virou o seu sistema de incerteza sobre si própria. Ao longo de oito gerações de bootstrap, o compilador rastreou a sua própria confiança em cada expressão. Na geração oito: 113.931 expressões. Todas certas. Overhead de guarda: zero bytes. O binário provou-o compilando-se a si próprio duas vezes com o mesmo hash.',
    exact: 'md5(gen₂.elf) = md5(gen₃.elf) · 15.636 call sites · 0 guardados · 1,25 MB',
    link: 'Ver a prova de convergência do bootstrap →',
  },
  es: {
    label: 'PUNTO FIJO EPISTÉMICO',
    number: '100',
    body: 'El lenguaje volvió su sistema de incertidumbre sobre sí mismo. A lo largo de ocho generaciones de bootstrap, el compilador rastreó su propia confianza en cada expresión. En la generación ocho: 113.931 expresiones. Todas ciertas. Coste de guarda: cero bytes. El binario lo demostró compilándose a sí mismo dos veces con el mismo hash.',
    exact: 'md5(gen₂.elf) = md5(gen₃.elf) · 15.636 call sites · 0 guardados · 1,25 MB',
    link: 'Ver la prueba de convergencia del bootstrap →',
  },
  el: {
    label: 'ΕΠΙΣΤΗΜΙΚΟ ΣΤΑΘΕΡΟ ΣΗΜΕΙΟ',
    number: '100',
    body: 'Η γλώσσα στρεψε το σύστημά της αβεβαιότητας πάνω στον εαυτό της. Σε οκτώ γενιές bootstrap, ο compiler παρακολούθησε τη δική του εμπιστοσύνη σε κάθε έκφραση. Στην γενιά οκτώ: 113.931 εκφράσεις. Όλες βέβαιες. Κόστος φύλαξης: μηδέν bytes. Το δυαδικό το απέδειξε μεταγλωττίζοντας τον εαυτό του δύο φορές στο ίδιο hash.',
    exact: 'md5(gen₂.elf) = md5(gen₃.elf) · 15.636 call sites · 0 φυλαγμένα · 1,25 MB',
    link: 'Δείτε την απόδειξη σύγκλισης bootstrap →',
  },
  zh: {
    label: '知识论不动点',
    number: '100',
    body: '这门语言将其不确定性系统对准了自身。在八代自举过程中，编译器追踪了每个表达式的自身置信度。第八代：113,931 个表达式，全部确定。防护开销：零字节。二进制文件通过两次编译出相同哈希值证明了这一点。',
    exact: 'md5(gen₂.elf) = md5(gen₃.elf) · 15,636 个调用点 · 0 个受防护 · 1.25 MB',
    link: '查看自举收敛证明 →',
  },
  ja: {
    label: '認識論的不動点',
    number: '100',
    body: 'この言語は不確実性システムを自分自身に向けました。8世代のブートストラップを通じて、コンパイラはすべての式で自身の確信度を追跡しました。第8世代：113,931の式、すべて確実。ガードのオーバーヘッド：ゼロバイト。バイナリは自身を2回コンパイルして同じハッシュを得ることで証明しました。',
    exact: 'md5(gen₂.elf) = md5(gen₃.elf) · 15,636 コールサイト · 0 ガード · 1.25 MB',
    link: 'ブートストラップ収束証明を見る →',
  },
};

const d = t[locale] ?? t.en;
---

<section class="na-section relative overflow-hidden border-y border-[var(--color-line)] px-6 py-[5.5rem]" aria-label="Epistemic fixed point">
  <div class="na-bg" aria-hidden="true"></div>
  <div class="na-overlay" aria-hidden="true"></div>
  <div class="na-inner relative z-[1] mx-auto grid max-w-[900px] items-center gap-8 sm:grid-cols-[auto_1fr] sm:gap-14">
    <div class="na-number font-[var(--font-display)] text-[clamp(5.5rem,16vw,10rem)] font-bold leading-[0.88] tracking-[-0.04em] select-none" aria-hidden="true"><span class="na-count">{d.number}</span></div>
    <div class="na-text grid gap-3.5">
      <p class="m-0 font-mono text-[0.7rem] uppercase tracking-[0.2em] text-[var(--color-accent-gold-soft)] opacity-75">{d.label}</p>
      <p class="m-0 max-w-[50ch] font-[var(--font-display)] text-[1.05rem] leading-[1.75] text-[var(--color-ink-1)]">{d.body}</p>
      <p class="m-0"><code class="font-mono text-[0.82rem] tracking-[0.01em] text-[var(--color-ink-2)]">{d.exact}</code></p>
      <a href={getLocalizedPath('/compiler#bootstrap-convergence', locale)} class="mt-1 inline-flex items-center gap-1.5 text-[0.85rem] text-[var(--color-accent-gold-soft)] no-underline transition-opacity duration-200 hover:underline hover:opacity-75">
        {d.link}
      </a>
    </div>
  </div>
</section>

<style>
  .na-bg {
    position: absolute;
    inset: -10% 0;
    background-image: url('/assets/vision/act1-column.jpg');
    background-size: cover;
    background-position: center 35%;
    opacity: 0.18;
    will-change: transform;
  }

  .na-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      var(--color-surface-base) 0%,
      color-mix(in srgb, var(--color-surface-base) 55%, transparent) 20%,
      color-mix(in srgb, var(--color-surface-base) 45%, transparent) 80%,
      var(--color-surface-base) 100%
    );
  }

  .na-number {
    background: linear-gradient(
      145deg,
      var(--color-accent-gold) 0%,
      var(--color-accent-gold-soft) 55%,
      color-mix(in srgb, var(--color-accent-gold) 45%, transparent) 100%
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
</style>

<script>
  import { gsap, revealOnScroll, countUp, prefersReducedMotion } from '../../lib/motion';

  if (!prefersReducedMotion()) {
    const section = document.querySelector<HTMLElement>('.na-section');
    const bg = document.querySelector<HTMLElement>('.na-bg');
    const countEl = document.querySelector<HTMLElement>('.na-count');

    if (section && bg && countEl) {
      // background parallax
      gsap.to(bg, {
        yPercent: 15,
        ease: 'none',
        scrollTrigger: {
          trigger: section,
          start: 'top bottom',
          end: 'bottom top',
          scrub: 1.5,
        },
      });

      // count-up 0 → 168
      countUp(countEl, 168, { duration: 2.2 });

      // text cascade
      revealOnScroll('.na-text > *', {
        y: 28,
        stagger: 0.12,
        duration: 0.75,
        scrollTrigger: { trigger: section, start: 'top 72%', once: true },
      });
    }
  }
</script>
