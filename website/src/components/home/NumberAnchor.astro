---
import { getLocalizedPath } from '../../lib/i18n';
import type { Locale } from '../../lib/i18n';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;

const t: Record<string, { label: string; body: string; link: string }> = {
  en: {
    label: 'VERIFIED INSIDE THE LANGUAGE',
    body: 'Among the 7³ = 343 ordered basis triples of the octonions, exactly 168 are non-associative. 168 = |PSL(2,7)| = |Aut(Fano)|. Reproduced independently in NumPy. Under review at Advances in Applied Clifford Algebras.',
    link: 'See the theorem and proof →',
  },
  pt: {
    label: 'VERIFICADO DENTRO DA LINGUAGEM',
    body: 'Entre os 7³ = 343 triplos de bases ordenadas dos octoniões, exatamente 168 são não-associativos. 168 = |PSL(2,7)| = |Aut(Fano)|. Reproduzido de forma independente em NumPy. Sob revisão na revista Advances in Applied Clifford Algebras.',
    link: 'Ver o teorema e a prova →',
  },
  es: {
    label: 'VERIFICADO DENTRO DEL LENGUAJE',
    body: 'Entre los 7³ = 343 triples de bases ordenadas de los octoniones, exactamente 168 son no asociativos. 168 = |PSL(2,7)| = |Aut(Fano)|. Reproducido de forma independiente en NumPy. Bajo revisión en Advances in Applied Clifford Algebras.',
    link: 'Ver el teorema y la prueba →',
  },
  el: {
    label: 'ΕΠΑΛΗΘΕΥΜΕΝΟ ΜΕΣΑ ΣΤΗ ΓΛΩΣΣΑ',
    body: 'Μεταξύ των 7³ = 343 διατεταγμένων τριάδων βάσης των οκτονίων, ακριβώς 168 είναι μη-προσεταιριστικές. 168 = |PSL(2,7)| = |Aut(Fano)|. Αναπαράχθηκε ανεξάρτητα σε NumPy. Υπό αξιολόγηση στο Advances in Applied Clifford Algebras.',
    link: 'Δείτε το θεώρημα και την απόδειξη →',
  },
  zh: {
    label: '在语言内部验证',
    body: '在八元数的 7³ = 343 个有序基三元组中，恰好有 168 个是非结合的。168 = |PSL(2,7)| = |Aut(Fano)|。已在 NumPy 中独立复现。正在 Advances in Applied Clifford Algebras 审稿中。',
    link: '查看定理和证明 →',
  },
  ja: {
    label: '言語内で検証済み',
    body: 'オクトニオンの 7³ = 343 個の有順序基底三つ組のうち、ちょうど 168 個が非結合的です。168 = |PSL(2,7)| = |Aut(Fano)|。NumPy で独立して再現済み。Advances in Applied Clifford Algebras に審査中。',
    link: '定理と証明を見る →',
  },
};

const d = t[locale] ?? t.en;
---

<section class="number-anchor-section">
  <div class="number-anchor-inner">
    <div class="number-display" aria-hidden="true">168</div>
    <div class="number-text">
      <p class="number-label">{d.label}</p>
      <p class="number-body">{d.body}</p>
      <a href={getLocalizedPath('/proof#theorem-168', locale)} class="number-link">
        {d.link}
      </a>
    </div>
  </div>
</section>

<style>
  .number-anchor-section {
    padding: 4rem 1.5rem;
    border-top: 1px solid var(--glass-border);
    border-bottom: 1px solid var(--glass-border);
    background: color-mix(in srgb, var(--color-bg-alt) 50%, transparent);
  }

  .number-anchor-inner {
    max-width: 860px;
    margin: 0 auto;
    display: grid;
    gap: 1.8rem;
    align-items: center;
  }

  @media (min-width: 640px) {
    .number-anchor-inner {
      grid-template-columns: auto 1fr;
    }
  }

  .number-display {
    font-family: var(--font-display);
    font-size: clamp(5rem, 15vw, 9.5rem);
    font-weight: 700;
    line-height: 0.9;
    background: linear-gradient(135deg, var(--color-accent-gold) 0%, var(--color-accent-gold-soft) 60%, rgba(214,179,90,0.5) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: -0.03em;
    user-select: none;
  }

  .number-text {
    display: grid;
    gap: 0.7rem;
  }

  .number-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    color: var(--color-accent-gold-soft);
    text-transform: uppercase;
    margin: 0;
    opacity: 0.8;
  }

  .number-body {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    margin: 0;
    max-width: 56ch;
  }

  .number-link {
    font-size: 0.85rem;
    color: var(--color-accent-gold-soft);
    text-decoration: none;
  }

  .number-link:hover {
    text-decoration: underline;
  }
</style>
