---
import { getLocalizedPath, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isPt = locale === 'pt';

const metrics = [
  {
    value: '6,144',
    label: isPt ? 'fontes Sounio rastreadas' : 'tracked Sounio sources',
    note: isPt ? '2,209,081 linhas de linguagem' : '2,209,081 language lines',
  },
  {
    value: '1,317',
    label: isPt ? 'fontes na stdlib' : 'stdlib sources',
    note: isPt ? '178 entrypoints ativos' : '178 active entrypoints',
  },
  {
    value: '888',
    label: isPt ? 'exemplos .sio' : '.sio examples',
    note: isPt ? 'mais que uma galeria de demos' : 'more than a demo gallery',
  },
  {
    value: '223',
    label: isPt ? 'scripts de pesquisa' : 'research scripts',
    note: isPt ? 'pré-registro, manifestos, controles' : 'preregistration, manifests, controls',
  },
];

const capabilities = [
  {
    domain: isPt ? 'Compilador' : 'Compiler',
    title: isPt ? 'Madaros self-hosted' : 'Self-hosted Madaros',
    body: isPt
      ? 'Pipeline real com gate completo, diagnósticos multimódulo, ELF nativo e recibos de execução.'
      : 'Real pipeline with full gate, multimodule diagnostics, native ELF, and execution receipts.',
    evidence: 'madaros_full_gate.sh',
    state: 'gate-pass',
    href: '/compiler',
  },
  {
    domain: isPt ? 'Semântica' : 'Semantics',
    title: 'Zero Events',
    body: isPt
      ? 'Zeros observacionalmente iguais preservam origem: ausência, cancelamento, resolução, arredondamento e mais.'
      : 'Observationally identical zeros retain origin: absence, cancellation, resolution, rounding, and more.',
    evidence: 'zero_event_gate.sh',
    state: 'exec-pass',
    href: '/language#epistemic-types',
  },
  {
    domain: isPt ? 'Pesquisa' : 'Research',
    title: isPt ? 'Resultados nulos honestos' : 'Honest null results',
    body: isPt
      ? 'Campanhas conectam pré-registro, fixture, execução, controle nulo e limite de claim.'
      : 'Campaigns connect preregistration, fixture, execution, null control, and claim boundary.',
    evidence: 'COBRE ORC ledger',
    state: 'validated-research',
    href: '/dissertation',
  },
  {
    domain: isPt ? 'Ferramentas' : 'Tooling',
    title: isPt ? 'Ecossistema local' : 'Local ecosystem',
    body: isPt
      ? 'REPL, LSP, editores, Jupyter, Python, MCP e packages aparecem com maturidade declarada.'
      : 'REPL, LSP, editors, Jupyter, Python, MCP, and packages appear with declared maturity.',
    evidence: '6 pass / 1 warn',
    state: 'preview',
    href: '/learn/getting-started',
  },
];

const receipts = [
  { label: isPt ? 'Conformance' : 'Conformance', value: '16 / 16', kind: 'pass' },
  { label: isPt ? 'Jupyter' : 'Jupyter', value: '69 tests', kind: 'pass' },
  { label: isPt ? 'PBPK/GUM' : 'PBPK/GUM', value: '4 / 4', kind: 'bounded' },
  { label: isPt ? 'Causalidade' : 'Causality', value: '17 / 17', kind: 'bounded' },
  { label: isPt ? 'Python' : 'Python', value: '262 pass / 15 fail', kind: 'frontier' },
  { label: isPt ? 'Showcases' : 'Showcases', value: '9 / 10', kind: 'frontier' },
];
---

<section id="power-atlas" class="power-atlas" aria-labelledby="power-atlas-title">
  <div class="container power-shell">
    <div class="power-lead">
      <p class="power-kicker">{isPt ? 'Escala real, com fronteira honesta' : 'Real scale, honest frontier'}</p>
      <h2 id="power-atlas-title">
        {isPt ? 'O que estava escondido agora entra na primeira visita.' : 'What was hidden now enters the first visit.'}
      </h2>
      <p>
        {isPt
          ? 'Sounio não é uma página sobre uma linguagem. É uma foundry de semântica, ciência executável, prova, pesquisa e ferramentas - cada capacidade listada com estado visível.'
          : 'Sounio is not a page about a language. It is a foundry for semantics, executable science, proof, research, and tooling - each listed capability with visible state.'}
      </p>
    </div>

    <div class="power-metrics" aria-label={isPt ? 'Escala do repositorio' : 'Repository scale'}>
      {metrics.map((metric) => (
        <div class="power-metric">
          <strong>{metric.value}</strong>
          <span>{metric.label}</span>
          <small>{metric.note}</small>
        </div>
      ))}
    </div>

    <div class="power-grid">
      <div class="capability-rail" aria-label={isPt ? 'Capacidades destacadas' : 'Highlighted capabilities'}>
        {capabilities.map((capability) => (
          <a href={getLocalizedPath(capability.href, locale)} class="capability-row">
            <span class="capability-domain">{capability.domain}</span>
            <strong>{capability.title}</strong>
            <span class="capability-body">{capability.body}</span>
            <span class:list={['capability-state', `state-${capability.state}`]}>{capability.state}</span>
            <code>{capability.evidence}</code>
          </a>
        ))}
      </div>

      <aside class="receipt-panel" aria-label={isPt ? 'Recibos recentes' : 'Recent receipts'}>
        <div>
          <p>{isPt ? 'Recibos' : 'Receipts'}</p>
          <h3>{isPt ? 'Passa, limita, ou avisa.' : 'Pass, bound, or warn.'}</h3>
        </div>
        <dl>
          {receipts.map((receipt) => (
            <div class:list={['receipt-row', `receipt-${receipt.kind}`]}>
              <dt>{receipt.label}</dt>
              <dd>{receipt.value}</dd>
            </div>
          ))}
        </dl>
        <p class="receipt-note">
          {isPt
            ? 'Snapshot: branch neurodyn-docs-registry-batch, commit 635b4cc95, auditado em 2026-07-13.'
            : 'Snapshot: branch neurodyn-docs-registry-batch, commit 635b4cc95, audited 2026-07-13.'}
        </p>
      </aside>
    </div>
  </div>
</section>

<style>
  .power-atlas {
    overflow: hidden;
    scroll-margin-top: 72px;
    padding: 5rem 0;
    background: #08101b;
    color: #f4f0e7;
    border-bottom: 1px solid rgba(212, 208, 197, 0.14);
  }

  .power-shell {
    display: grid;
    gap: 2rem;
  }

  .power-lead {
    display: grid;
    grid-template-columns: minmax(280px, 0.78fr) minmax(280px, 0.72fr);
    gap: 2rem;
    align-items: end;
  }

  .power-kicker {
    grid-column: 1 / -1;
    margin: 0 0 -0.8rem;
    color: #74d0d3;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .power-lead h2 {
    max-width: 15ch;
    margin: 0;
    color: #fff;
    font-family: var(--font-display);
    font-size: 3.45rem;
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.04;
  }

  .power-lead p:last-child {
    max-width: 54ch;
    margin: 0;
    color: rgba(244, 240, 231, 0.72);
    font-size: 1rem;
    line-height: 1.7;
  }

  .power-metrics {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border: 1px solid rgba(116, 208, 211, 0.22);
    background: #0b1a2b;
  }

  .power-metric {
    min-width: 0;
    padding: 1.15rem;
    border-right: 1px solid rgba(116, 208, 211, 0.16);
  }

  .power-metric:last-child {
    border-right: 0;
  }

  .power-metric strong {
    display: block;
    color: #e4c875;
    font-family: var(--font-display);
    font-size: 2.45rem;
    font-weight: 500;
    line-height: 1;
  }

  .power-metric span,
  .power-metric small {
    display: block;
    margin-top: 0.45rem;
  }

  .power-metric span {
    color: #f4f0e7;
    font-size: 0.86rem;
    font-weight: 700;
  }

  .power-metric small {
    color: rgba(244, 240, 231, 0.52);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    line-height: 1.45;
  }

  .power-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.35fr);
    gap: 1.2rem;
    align-items: start;
  }

  .capability-rail {
    display: grid;
    border-top: 1px solid rgba(212, 208, 197, 0.14);
  }

  .capability-row {
    display: grid;
    grid-template-columns: minmax(90px, 0.45fr) minmax(140px, 0.7fr) minmax(260px, 1.4fr) 132px minmax(150px, 0.72fr);
    gap: 1rem;
    align-items: center;
    min-height: 86px;
    padding: 0.9rem 0;
    border-bottom: 1px solid rgba(212, 208, 197, 0.14);
    color: #f4f0e7;
    transition: background 160ms ease, padding 160ms ease;
  }

  .capability-row:hover {
    padding-right: 0.75rem;
    padding-left: 0.75rem;
    background: rgba(116, 208, 211, 0.07);
    color: #fff;
  }

  .capability-domain,
  .capability-state,
  .capability-row code {
    font-family: var(--font-mono);
  }

  .capability-domain {
    color: #74d0d3;
    font-size: 0.66rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .capability-row strong {
    color: #fff;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
  }

  .capability-body {
    color: rgba(244, 240, 231, 0.66);
    font-size: 0.84rem;
    line-height: 1.5;
  }

  .capability-state {
    border: 1px solid currentColor;
    border-radius: 4px;
    padding: 0.34rem 0.45rem;
    font-size: 0.58rem;
    font-weight: 700;
    text-align: center;
    text-transform: uppercase;
  }

  .state-gate-pass,
  .state-exec-pass {
    color: #61d3c0;
  }

  .state-validated-research {
    color: #e4c875;
  }

  .state-preview {
    color: #8cb7e8;
  }

  .capability-row code {
    overflow: hidden;
    color: rgba(244, 240, 231, 0.48);
    font-size: 0.64rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .receipt-panel {
    display: grid;
    gap: 1.1rem;
    padding: 1.1rem;
    border: 1px solid rgba(212, 208, 197, 0.16);
    background: #101a22;
  }

  .receipt-panel p,
  .receipt-panel h3,
  .receipt-panel dl {
    margin: 0;
  }

  .receipt-panel > div > p {
    color: #e4c875;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .receipt-panel h3 {
    margin-top: 0.35rem;
    color: #fff;
    font-family: var(--font-display);
    font-size: 1.55rem;
    font-weight: 500;
    line-height: 1.1;
  }

  .receipt-panel dl {
    display: grid;
    gap: 0.55rem;
  }

  .receipt-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.75rem;
    align-items: center;
    padding: 0.7rem 0;
    border-top: 1px solid rgba(212, 208, 197, 0.12);
  }

  .receipt-row dt {
    color: rgba(244, 240, 231, 0.6);
    font-size: 0.78rem;
  }

  .receipt-row dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
  }

  .receipt-pass dd {
    color: #61d3c0;
  }

  .receipt-bounded dd {
    color: #e4c875;
  }

  .receipt-frontier dd {
    color: #8cb7e8;
  }

  .receipt-note {
    color: rgba(244, 240, 231, 0.48);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    line-height: 1.5;
  }

  @media (max-width: 1100px) {
    .power-metrics {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .power-metric:nth-child(2) {
      border-right: 0;
    }

    .power-metric:nth-child(n + 3) {
      border-top: 1px solid rgba(116, 208, 211, 0.16);
    }

    .power-grid {
      grid-template-columns: 1fr;
    }

    .capability-row {
      grid-template-columns: minmax(90px, 0.4fr) minmax(140px, 0.7fr) minmax(240px, 1.35fr) 132px;
    }

    .capability-row code {
      display: none;
    }
  }

  @media (max-width: 760px) {
    .power-atlas {
      padding: 3.6rem 0;
    }

    .power-lead {
      grid-template-columns: 1fr;
      gap: 1.1rem;
    }

    .power-kicker {
      margin-bottom: 0;
    }

    .power-lead h2 {
      font-size: 2.45rem;
    }

    .capability-row {
      grid-template-columns: 1fr auto;
      gap: 0.55rem 0.8rem;
      min-height: 0;
      padding: 1rem 0;
    }

    .capability-domain,
    .capability-body {
      grid-column: 1 / -1;
    }

    .capability-state {
      align-self: start;
      width: 120px;
    }
  }

  @media (max-width: 480px) {
    .power-atlas {
      scroll-margin-top: 66px;
    }

    .power-lead h2 {
      font-size: 2.05rem;
    }

    .power-lead p:last-child {
      font-size: 0.9rem;
      line-height: 1.58;
    }

    .power-metric {
      padding: 0.9rem;
    }

    .power-metric strong {
      font-size: 2.05rem;
    }

    .capability-row strong {
      font-size: 1rem;
    }

    .capability-body {
      font-size: 0.78rem;
    }

    .capability-state {
      width: 104px;
      font-size: 0.52rem;
    }
  }
</style>
