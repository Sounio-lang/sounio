---
const proofSignals = [
  {
    label: 'Compiler',
    value: 'Fixed-point bootstrap',
  },
  {
    label: 'GPU',
    value: 'PTX emission in-tree',
  },
  {
    label: 'Pressure',
    value: 'PBPK, climate, neuroimaging',
  },
  {
    label: 'Contract',
    value: 'Proof surfaces stay bounded',
  },
];
---

<section class="section-shell section-deferred border-y border-[var(--glass-border)] bg-[color-mix(in_srgb,var(--color-bg-alt)_72%,transparent)]">
  <div class="container grid gap-3 lg:grid-cols-4">
    {proofSignals.map((signal) => (
      <article class="rounded-[var(--radius-xl)] border border-white/7 bg-white/[0.025] p-[0.95rem] grid gap-[0.18rem] backdrop-blur-md">
        <p class="text-[0.72rem] uppercase tracking-[0.1em] text-[var(--color-text-tertiary)]">{signal.label}</p>
        <h2 class="text-[0.98rem] font-semibold text-[var(--color-text-primary)] leading-snug">{signal.value}</h2>
      </article>
    ))}
  </div>
</section>
