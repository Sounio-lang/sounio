---
import { getLocalizedPath, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
  t: Record<string, string>;
}

const { locale, t } = Astro.props;

const steps = [
  { num: '01', title: t.what_is_step1_title, body: t.what_is_step1_body, accent: 'var(--color-accent-teal)' },
  { num: '02', title: t.what_is_step2_title, body: t.what_is_step2_body, accent: 'var(--color-accent-gold)' },
  { num: '03', title: t.what_is_step3_title, body: t.what_is_step3_body, accent: 'var(--color-accent-purple)' },
];
---

<section class="section-shell what-is-shell border-y border-[var(--glass-border)]">
  <div class="container">
    <header class="what-is-header">
      <span class="badge-pill">{t.what_is_badge}</span>
      <h2 class="font-display what-is-title">{t.what_is_title}</h2>
      <p class="what-is-oneliner">{t.what_is_oneliner}</p>
    </header>

    <div class="what-is-grid">
      {steps.map((step) => (
        <article class="what-is-step glass glass-specular">
          <span class="what-is-num" style={`color: ${step.accent}`}>{step.num}</span>
          <h3 class="font-display what-is-step-title">{step.title}</h3>
          <p>{step.body}</p>
        </article>
      ))}
    </div>

    <div class="what-is-compare glass">
      <p set:html={t.what_is_compare} />
    </div>

    <div class="what-is-actions">
      <a href={getLocalizedPath('/language', locale)} class="hero-cta primary">{t.what_is_cta_language}</a>
      <a href={getLocalizedPath('/start', locale)} class="hero-cta secondary">{t.what_is_cta_start}</a>
      <a href={getLocalizedPath('/proof', locale)} class="hero-cta secondary">{t.what_is_cta_proof}</a>
    </div>
  </div>
</section>

<style>
  .what-is-shell {
    background: color-mix(in srgb, var(--color-bg-alt) 40%, #020617);
  }

  .what-is-header {
    max-width: 780px;
    display: grid;
    gap: 0.85rem;
    margin-bottom: 2.5rem;
  }

  .what-is-title {
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    font-weight: 500;
    line-height: 1.1;
    margin: 0;
  }

  .what-is-oneliner {
    margin: 0;
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    line-height: 1.7;
    color: var(--color-text-secondary);
    max-width: 68ch;
  }

  .what-is-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    margin-bottom: 1.5rem;
  }

  .what-is-step {
    border-radius: var(--radius-xl);
    padding: 1.25rem;
    display: grid;
    gap: 0.55rem;
  }

  .what-is-num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .what-is-step-title {
    font-size: 1.25rem;
    font-weight: 500;
    margin: 0;
    line-height: 1.25;
  }

  .what-is-step p {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
  }

  .what-is-compare {
    border-radius: var(--radius-xl);
    padding: 1.1rem 1.25rem;
    margin-bottom: 1.5rem;
  }

  .what-is-compare p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  .what-is-compare :global(strong) {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  .what-is-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }
</style>
