---
import { getLocalizedPath } from '../../lib/i18n';
import type { Locale } from '../../lib/i18n';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;

const lines: Record<string, { label: string; line: string; sub: string }> = {
  en: {
    label: 'EPISTEMIC SYSTEMS LANGUAGE',
    line: "A programming language that carries\nwhat it doesn't know.",
    sub: 'Not a workaround. A type.',
  },
  pt: {
    label: 'LINGUAGEM DE SISTEMAS EPISTÉMICOS',
    line: 'Uma linguagem de programação que carrega\no que não sabe.',
    sub: 'Não um contorno. Um tipo.',
  },
  es: {
    label: 'LENGUAJE DE SISTEMAS EPISTÉMICOS',
    line: 'Un lenguaje de programación que lleva\nlo que no sabe.',
    sub: 'No una solución alternativa. Un tipo.',
  },
  el: {
    label: 'ΓΛΩΣΣΑ ΕΠΙΣΤΗΜΙΚΩΝ ΣΥΣΤΗΜΑΤΩΝ',
    line: 'Μια γλώσσα προγραμματισμού που φέρει\nαυτό που δεν ξέρει.',
    sub: 'Όχι μια παράκαμψη. Έναν τύπο.',
  },
  zh: {
    label: '知识论系统语言',
    line: '一门能携带自身不确定性的编程语言。',
    sub: '不是权宜之计。是一个类型。',
  },
  ja: {
    label: '認識論システム言語',
    line: '知らないことを\n携える、プログラミング言語。',
    sub: '回避策ではない。型だ。',
  },
};

const evidence: Record<string, Array<{ label: string; title: string; body: string; receipt: string; href: string }>> = {
  en: [
    {
      label: 'Clinical uncertainty',
      title: 'A dose can be rejected before it becomes an action.',
      body: 'A value with low confidence is not treated as a normal number. The type carries the boundary.',
      receipt: 'epsilon 0.71 < 0.82',
      href: '/learn/vancomycin-uncertainty',
    },
    {
      label: 'Proof surface',
      title: 'Non-associative structure stays visible.',
      body: 'The homepage does not need to explain every theorem. It needs to show that order and provenance are first-class.',
      receipt: '168 Octonion theorem',
      href: '/proof',
    },
    {
      label: 'Self-hosted compiler',
      title: 'The language turns the test back on itself.',
      body: 'Bootstrap convergence and compiler receipts live in the product story, not in a footnote.',
      receipt: '113,931 expressions',
      href: '/compiler',
    },
  ],
  pt: [
    {
      label: 'Incerteza clínica',
      title: 'Uma dose pode ser recusada antes de virar ação.',
      body: 'Um valor com baixa confiança não é tratado como número comum. O tipo carrega o limite.',
      receipt: 'epsilon 0,71 < 0,82',
      href: '/learn/vancomycin-uncertainty',
    },
    {
      label: 'Superfície de prova',
      title: 'A estrutura não-associativa continua visível.',
      body: 'A home não precisa explicar cada teorema. Precisa mostrar que ordem e proveniência são primeira classe.',
      receipt: 'Teorema Octonion 168',
      href: '/proof',
    },
    {
      label: 'Compilador self-hosted',
      title: 'A linguagem vira o teste contra si mesma.',
      body: 'Convergência de bootstrap e recibos do compilador pertencem à história do produto, não ao rodapé.',
      receipt: '113.931 expressões',
      href: '/compiler',
    },
  ],
};

const d = lines[locale] ?? lines.en;
const proofRail = evidence[locale] ?? evidence.en;
const parts = d.line.split('\n');
---

<section class="mp-section">
  <div class="mp-bg" aria-hidden="true"></div>
  <div class="mp-overlay" aria-hidden="true"></div>
  <div class="mp-inner">
    <p class="mp-label">{d.label}</p>
    <p class="mp-line">
      {parts.map((part, i) => (
        <>
          {part}
          {i < parts.length - 1 && <br />}
        </>
      ))}
    </p>
    <p class="mp-sub">{d.sub}</p>

    <div class="mp-proof-rail" aria-label="Sounio evidence rail">
      {proofRail.map((item) => (
        <a class="mp-proof" href={getLocalizedPath(item.href, locale)}>
          <span class="mp-proof-label">{item.label}</span>
          <strong>{item.title}</strong>
          <span class="mp-proof-body">{item.body}</span>
          <code>{item.receipt}</code>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .mp-section {
    position: relative;
    overflow: hidden;
    padding: 6rem 1.5rem 5.5rem;
    border-top: 1px solid var(--glass-border);
    border-bottom: 1px solid var(--glass-border);
  }

  .mp-bg {
    position: absolute;
    inset: -10% 0;
    background-image: url('/assets/vision/act4-sounion.jpg');
    background-size: cover;
    background-position: center 55%;
    opacity: 0.2;
    will-change: transform;
  }

  .mp-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      var(--color-bg) 0%,
      color-mix(in srgb, var(--color-bg) 50%, transparent) 18%,
      color-mix(in srgb, var(--color-bg) 40%, transparent) 82%,
      var(--color-bg) 100%
    );
  }

  .mp-inner {
    position: relative;
    z-index: 1;
    max-width: 1080px;
    margin: 0 auto;
    display: grid;
    gap: 1.2rem;
  }

  .mp-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    color: var(--color-accent-gold-soft);
    text-transform: uppercase;
    margin: 0;
    opacity: 0.8;
  }

  .mp-line {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5.5vw, 4rem);
    font-weight: 400;
    line-height: 1.16;
    color: var(--color-text-primary);
    margin: 0;
    letter-spacing: -0.01em;
    max-width: 860px;
  }

  .mp-sub {
    font-family: var(--font-mono);
    font-size: 0.88rem;
    letter-spacing: 0.05em;
    color: var(--color-text-secondary);
    margin: 0.4rem 0 0;
  }

  .mp-proof-rail {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.9rem;
    margin-top: 2rem;
  }

  @media (min-width: 760px) {
    .mp-proof-rail {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .mp-proof {
    display: grid;
    min-height: 14rem;
    align-content: start;
    gap: 0.85rem;
    padding: 1.05rem;
    border: 1px solid color-mix(in srgb, var(--color-accent-gold) 22%, transparent);
    border-radius: 8px;
    background:
      linear-gradient(180deg, rgba(255,255,255,0.055), rgba(255,255,255,0.022)),
      color-mix(in srgb, var(--color-bg-alt) 52%, transparent);
    box-shadow: 0 18px 44px rgba(0, 0, 0, 0.16);
    transition: border-color var(--transition-fast), background var(--transition-fast), transform var(--transition-fast);
  }

  .mp-proof:hover {
    border-color: color-mix(in srgb, var(--color-accent-gold) 48%, transparent);
    background:
      linear-gradient(180deg, rgba(255,255,255,0.075), rgba(255,255,255,0.028)),
      color-mix(in srgb, var(--color-bg-alt) 62%, transparent);
    transform: translateY(-2px);
  }

  .mp-proof-label {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    color: var(--color-accent-gold-soft);
    text-transform: uppercase;
  }

  .mp-proof strong {
    max-width: 21ch;
    color: var(--color-text-primary);
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.1vw, 1.75rem);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: 0;
  }

  .mp-proof-body {
    color: var(--color-text-secondary);
    font-size: 0.92rem;
    line-height: 1.65;
  }

  .mp-proof code {
    width: fit-content;
    margin-top: auto;
    border: 1px solid color-mix(in srgb, var(--color-accent-gold) 22%, transparent);
    border-radius: 999px;
    background: rgba(214, 179, 90, 0.1);
    color: var(--color-accent-gold-soft);
    font-size: 0.72rem;
    letter-spacing: 0.03em;
  }

  @media (max-width: 640px) {
    .mp-section {
      padding: 5.2rem 1.5rem 4.5rem;
    }

    .mp-proof {
      min-height: auto;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    const section = document.querySelector<HTMLElement>('.mp-section');
    const bg = document.querySelector<HTMLElement>('.mp-bg');

    if (!section || !bg) return;

    // background parallax — opposite direction to na-bg for depth contrast
    gsap.to(bg, {
      yPercent: 12,
      ease: 'none',
      scrollTrigger: {
        trigger: section,
        start: 'top bottom',
        end: 'bottom top',
        scrub: 2,
      },
    });

    // label first, then the big line, then the sub
    gsap.from('.mp-label', {
      y: 16,
      opacity: 0,
      duration: 0.6,
      ease: 'power2.out',
      scrollTrigger: {
        trigger: section,
        start: 'top 78%',
        once: true,
      },
    });

    gsap.from('.mp-line', {
      y: 36,
      opacity: 0,
      duration: 0.9,
      ease: 'power3.out',
      delay: 0.1,
      scrollTrigger: {
        trigger: section,
        start: 'top 78%',
        once: true,
      },
    });

    gsap.from('.mp-sub', {
      y: 20,
      opacity: 0,
      duration: 0.7,
      ease: 'power2.out',
      delay: 0.25,
      scrollTrigger: {
        trigger: section,
        start: 'top 78%',
        once: true,
      },
    });

    gsap.from('.mp-proof', {
      y: 24,
      opacity: 0,
      duration: 0.72,
      ease: 'power2.out',
      stagger: 0.08,
      delay: 0.36,
      scrollTrigger: {
        trigger: section,
        start: 'top 72%',
        once: true,
      },
    });
  });
</script>
