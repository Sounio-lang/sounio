---
import Eyebrow from '../ui/Eyebrow.astro';
import type { Locale } from '../../lib/i18n';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;

const lines: Record<string, { label: string; line: string; sub: string }> = {
  en: {
    label: 'THE PROBLEM',
    line: "Somewhere between the measurement and the decision,\nthe doubt gets lost.",
    sub: 'The lab says 9.8 ± 0.1. The code says 9.8. The patient gets 9.8. The ±0.1 is gone. Sounio keeps the doubt — in the type, in the compile, in the decision.',
  },
  pt: {
    label: 'LINGUAGEM DE SISTEMAS EPISTÉMICOS',
    line: 'Uma linguagem de programação que carrega\no que não sabe.',
    sub: 'Não um contorno. Um tipo.',
  },
  es: {
    label: 'LENGUAJE DE SISTEMAS EPISTÉMICOS',
    line: 'Un lenguaje de programación que lleva\nlo que no sabe.',
    sub: 'No una solución alternativa. Un tipo.',
  },
  el: {
    label: 'ΓΛΩΣΣΑ ΕΠΙΣΤΗΜΙΚΩΝ ΣΥΣΤΗΜΑΤΩΝ',
    line: 'Μια γλώσσα προγραμματισμού που φέρει\nαυτό που δεν ξέρει.',
    sub: 'Όχι μια παράκαμψη. Έναν τύπο.',
  },
  zh: {
    label: '知识论系统语言',
    line: '一门能携带自身不确定性的编程语言。',
    sub: '不是权宜之计。是一个类型。',
  },
  ja: {
    label: '認識論システム言語',
    line: '知らないことを\n携える、プログラミング言語。',
    sub: '回避策ではない。型だ。',
  },
};

const d = lines[locale] ?? lines.en;
const parts = d.line.split('\n');
---

<section class="mp-section relative overflow-hidden border-y border-[var(--color-line)] px-6 pb-[5.5rem] pt-24 [perspective:1000px]">
  <div class="mp-bg" aria-hidden="true"></div>
  <div class="mp-overlay" aria-hidden="true"></div>
  <div class="relative z-[1] mx-auto grid max-w-[860px] gap-5">
    <Eyebrow tone="gold" rule={false} class="mp-label opacity-80">{d.label}</Eyebrow>
    <p class="mp-line m-0 font-[var(--font-display)] text-[clamp(2.4rem,5.5vw,4rem)] font-normal leading-[1.16] tracking-[-0.01em] text-[var(--color-ink-1)]">
      {parts.map((part, i) => (
        <>
          {part}
          {i < parts.length - 1 && <br />}
        </>
      ))}
    </p>
    <p class="mp-sub m-0 mt-1 font-mono text-[0.88rem] tracking-[0.05em] text-[var(--color-ink-2)]">{d.sub}</p>
  </div>
</section>

<style>
  .mp-bg {
    position: absolute;
    inset: -10% 0;
    background-image: url('/assets/vision/act4-sounion.jpg');
    background-size: cover;
    background-position: center 55%;
    opacity: 0.2;
    will-change: transform;
  }

  .mp-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      var(--color-surface-base) 0%,
      color-mix(in srgb, var(--color-surface-base) 50%, transparent) 18%,
      color-mix(in srgb, var(--color-surface-base) 40%, transparent) 82%,
      var(--color-surface-base) 100%
    );
  }
</style>

<script>
  import { gsap, revealOnScroll, prefersReducedMotion } from '../../lib/motion';

  if (!prefersReducedMotion()) {
    const section = document.querySelector<HTMLElement>('.mp-section');
    const bg = document.querySelector<HTMLElement>('.mp-bg');

    if (section && bg) {
      // background parallax — opposite direction to na-bg for depth contrast
      gsap.to(bg, {
        yPercent: 12,
        ease: 'none',
        scrollTrigger: {
          trigger: section,
          start: 'top bottom',
          end: 'bottom top',
          scrub: 2,
        },
      });

      // label first, then the big line, then the sub — 3D entrance
      revealOnScroll('.mp-label, .mp-line, .mp-sub', {
        y: 60,
        rotateX: 12,
        opacity: 0,
        duration: 1.0,
        ease: 'power3.out',
        stagger: 0.16,
        scrollTrigger: { trigger: section, start: 'top 78%', once: true },
      });
    }
  }
</script>
