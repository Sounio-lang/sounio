---

import type { Locale } from '../../lib/i18n';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;

const lines: Record<string, { section: string; heading: string; abstract: string; keywords: string }> = {
  en: {
    section: '§2 — The Problem',
    heading: 'Python and Rust pretend to be certain. Sounio is honest about doubt.',
    abstract: 'The lab says 9.8 ± 0.1. Python says 9.8. Rust says 9.8. The patient gets 9.8. The ±0.1 is gone. Sounio keeps the doubt — in the type, in the compile, in the decision.',
    keywords: 'epistemic computing · uncertainty types · GUM · knowledge · provenance',
  },
  pt: {
    section: '§2 — O Problema',
    heading: 'Em algum lugar entre a medição e a decisão, a dúvida se perde.',
    abstract: 'O laboratório diz 9,8 ± 0,1. O código diz 9,8. O paciente recebe 9,8. O ±0,1 se foi. O Sounio mantém a dúvida — no tipo, na compilação, na decisão.',
    keywords: 'computação epistêmica · tipos de incerteza · GUM · conhecimento · proveniência',
  },
};

const d = lines[locale] ?? lines.en;
---

<section class="journal-section relative border-y border-[var(--color-line)] py-[clamp(3.5rem,7vw,6rem)]">
  <div class="container mx-auto grid max-w-[860px] gap-6">
    <div class="journal-section-number">{d.section}</div>

    <h2 class="m-0 font-[var(--font-display)] text-[clamp(2rem,4.5vw,3.5rem)] font-normal leading-[1.15] tracking-[-0.015em] text-[var(--color-ink-1)]">
      {d.heading}
    </h2>

    <div class="journal-abstract">
      <div class="journal-abstract-label">Abstract</div>
      <p class="m-0">{d.abstract}</p>
      <div class="journal-keywords mt-3">
        <strong>Keywords:</strong> {d.keywords}
      </div>
    </div>

    {/* Visual anchor — the doubt getting lost */}
    <div class="mp-visual mx-auto mt-4 flex items-center gap-4 font-mono text-[clamp(1rem,2vw,1.4rem)]" aria-hidden="true">
      <span class="text-[var(--color-ink-1)]">9.8</span>
      <span class="text-[var(--color-accent-warning)]">± 0.1</span>
      <span class="text-[var(--color-ink-3)]">→</span>
      <span class="text-[var(--color-ink-3)] line-through decoration-[var(--color-accent-warning)] decoration-2">± 0.1</span>
      <span class="text-[var(--color-ink-3)]">→</span>
      <span class="text-[var(--color-ink-1)]">9.8</span>
    </div>

    {/* Scholia — marginalia from Pappou and Yaya */}
    <div class="scholia mt-6 grid gap-4 md:grid-cols-2">
      <div class="scholium border-l-2 border-[var(--color-accent-warning)] pl-4">
        <div class="font-mono text-[0.72rem] font-bold uppercase tracking-[0.08em] text-[var(--color-accent-warning)]">
          Pappou, on measurement
        </div>
        <p class="m-0 mt-1 text-[0.88rem] leading-[1.6] text-[var(--color-ink-2)]">
          "A number without its uncertainty is not a measurement. It is a guess."
        </p>
      </div>
      <div class="scholium border-l-2 border-[var(--color-accent-evidence)] pl-4">
        <div class="font-mono text-[0.72rem] font-bold uppercase tracking-[0.08em] text-[var(--color-accent-evidence)]">
          Yaya, on knowledge
        </div>
        <p class="m-0 mt-1 text-[0.88rem] leading-[1.6] text-[var(--color-ink-2)]">
          "The wise know what they do not know. The compiler should know too."
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .scholium {
    background: var(--color-surface-overlay);
    padding: 1rem;
    border-radius: var(--radius-md);
  }
</style>

<script>
  import { gsap, revealOnScroll, prefersReducedMotion } from '../../lib/motion';

  if (!prefersReducedMotion()) {
    const section = document.querySelector<HTMLElement>('.journal-section');

    if (section) {
      revealOnScroll('.journal-section-number, h2, .journal-abstract, .mp-visual, .scholium', {
        y: 40,
        opacity: 0,
        duration: 0.8,
        ease: 'power3.out',
        stagger: 0.12,
        scrollTrigger: { trigger: section, start: 'top 78%', once: true },
      });

      // Animate the strikethrough on the ±0.1
      const strike = document.querySelector('.mp-visual .line-through');
      if (strike) {
        gsap.from(strike, {
          textDecoration: 'none',
          duration: 0.6,
          delay: 1.2,
          ease: 'power2.out',
          scrollTrigger: { trigger: '.mp-visual', start: 'top 85%', once: true },
        });
      }
    }
  }
</script>
