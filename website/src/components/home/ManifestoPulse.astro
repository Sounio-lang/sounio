---
import type { Locale } from '../../lib/i18n';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;

const lines: Record<string, { label: string; line: string }> = {
  en: {
    label: 'EPISTEMIC SYSTEMS LANGUAGE',
    line: "A programming language that carries\nwhat it doesn’t know.",
  },
  pt: {
    label: 'LINGUAGEM DE SISTEMAS EPISTÉMICOS',
    line: 'Uma linguagem de programação que carrega\no que não sabe.',
  },
  es: {
    label: 'LENGUAJE DE SISTEMAS EPISTÉMICOS',
    line: 'Un lenguaje de programación que lleva\nlo que no sabe.',
  },
  el: {
    label: 'ΓΛΩΣΣΑ ΕΠΙΣΤΗΜΙΚΩΝ ΣΥΣΤΗΜΑΤΩΝ',
    line: 'Μια γλώσσα προγραμματισμού που φέρει\nαυτό που δεν ξέρει.',
  },
  zh: {
    label: '知识论系统语言',
    line: '一门能携带自身不确定性的编程语言。',
  },
  ja: {
    label: '認識論システム言語',
    line: '知らないことを\n携える、プログラミング言語。',
  },
};

const d = lines[locale] ?? lines.en;
const parts = d.line.split('\n');
---

<section class="manifesto-pulse">
  <div class="manifesto-inner">
    <p class="manifesto-label">{d.label}</p>
    <p class="manifesto-line">
      {parts.map((part, i) => (
        <>
          {part}
          {i < parts.length - 1 && <br />}
        </>
      ))}
    </p>
  </div>
</section>

<style>
  .manifesto-pulse {
    padding: 5rem 1.5rem 4.5rem;
    border-top: 1px solid var(--glass-border);
    border-bottom: 1px solid var(--glass-border);
  }

  .manifesto-inner {
    max-width: 860px;
    margin: 0 auto;
    display: grid;
    gap: 1.1rem;
  }

  .manifesto-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    color: var(--color-accent-gold-soft);
    text-transform: uppercase;
    margin: 0;
    opacity: 0.8;
  }

  .manifesto-line {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    font-weight: 400;
    line-height: 1.18;
    color: var(--color-text-primary);
    margin: 0;
    letter-spacing: -0.01em;
  }
</style>
