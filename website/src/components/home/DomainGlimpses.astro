---
import Card from '../ui/Card.astro';
import CodePanel from '../ui/CodePanel.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import { getLocalizedPath } from '../../lib/i18n';
import type { Locale } from '../../lib/i18n';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;

const t: Record<string, {
  heading: string;
  subhead: string;
  capsules: { tag: string; desc: string; link: string }[];
}> = {
  en: {
    heading: 'Where being wrong costs too much.',
    subhead: 'From hospital dosing to particle physics — the same discipline, applied where a wrong number has consequences.',
    capsules: [
      { tag: 'MEDICINE', desc: 'A drug dose calculated from a patient’s weight. The scale says 78.5 ± 0.2 kg. The compiler refuses to run if the confidence drops below 82%. The dose is safe because the doubt was kept.', link: '/learn/vancomycin-uncertainty' },
      { tag: 'NEUROSCIENCE', desc: 'An fMRI scan with 16 channels of noisy data. The algorithm finds a pattern, but the pattern is uncertain. Sounio tracks that uncertainty through every step — so the diagnosis is honest about its limits.', link: '/science#neuroimaging' },
      { tag: 'PARTICLE PHYSICS', desc: 'The mass of a Z-boson: 91.1876 ± 0.0021 GeV. That ±0.0021 is not decoration. It travels through every calculation automatically. No spreadsheets, no manual error propagation.', link: '/science#particle-physics' },
      { tag: 'CLIMATE', desc: 'Five climate models predict 2050 temperatures. They disagree. Sounio separates "the models are uncertain" from "the measurements are uncertain" — because the difference matters for policy.', link: '/science#climate' },
      { tag: 'CAUSAL INFERENCE', desc: 'Does a drug work? The data says "maybe". Sounio says "Beta(6,4) → 0.6 ± 0.15". Not a guess. A posterior. With refutation tests.', link: '/science#causal-inference' },
      { tag: 'QUANTUM COMPUTING', desc: 'A qubit cannot be copied. In Sounio, that’s not a convention — it’s a type error. The no-cloning theorem is enforced by the compiler.', link: '/science#quantum' },
    ],
  },
  pt: {
    heading: 'Epistémico. Efeito. Álgebra.',
    subhead: 'Três disciplinas de tipo em tempo de compilação que nenhuma outra linguagem tem como primitivas de primeiro nível. Cada uma aplicada em cada chamada. Cada uma especificada formalmente.',
    capsules: [
      { tag: 'PORTÃO DE CONFIANÇA', desc: 'Knowledge<f64> carrega ε, intervalo e proveniência. Uma cláusula where em ε transforma uma assinatura de função num portão de correção em tempo de compilação.', link: '/learn/vancomycin-uncertainty' },
      { tag: 'TIPO DE EFEITO', desc: 'NonUnitary é um efeito declarado, não uma convenção. Tipos de efeito vivem na assinatura — o verificador de tipos aplica a linha de efeitos em cada chamada.', link: '/proof#non-unitary' },
      { tag: 'TIPO DE ÁLGEBRA', desc: 'algebra Octonion declara a tabela de multiplicação, regras de reescrita e máscara de não-associatividade. O compilador possui a álgebra; Lean verifica-a.', link: '/proof#theorem-168' },
    ],
  },
  es: {
    heading: 'Epistémico. Efecto. Álgebra.',
    subhead: 'Tres disciplinas de tipo en tiempo de compilación que ningún otro lenguaje tiene como primitivas de primer nivel. Cada una aplicada en cada sitio de llamada. Cada una especificada formalmente.',
    capsules: [
      { tag: 'PUERTA DE CONFIANZA', desc: 'Knowledge<f64> lleva ε, intervalo y procedencia. Una cláusula where en ε convierte una firma de función en una puerta de corrección en tiempo de compilación.', link: '/learn/vancomycin-uncertainty' },
      { tag: 'TIPO DE EFECTO', desc: 'NonUnitary es un efecto declarado, no una convención. Los tipos de efecto viven en la firma — el verificador de tipos impone la fila de efectos en cada llamada.', link: '/proof#non-unitary' },
      { tag: 'TIPO DE ÁLGEBRA', desc: 'algebra Octonion declara la tabla de multiplicación, reglas de reescritura y máscara de no asociatividad. El compilador posee el álgebra; Lean la verifica.', link: '/proof#theorem-168' },
    ],
  },
  el: {
    heading: 'Επιστημικό. Εφέ. Άλγεβρα.',
    subhead: 'Τρεις πειθαρχίες τύπου κατά τη μεταγλώττιση που καμία άλλη γλώσσα δεν έχει ως πρωτογενείς πρωτόγονες. Κάθε μία εφαρμόζεται σε κάθε σημείο κλήσης. Κάθε μία ορίζεται τυπικά.',
    capsules: [
      { tag: 'ΠΥΛΗ ΕΜΠΙΣΤΟΣΥΝΗΣ', desc: 'Η Knowledge<f64> φέρει ε, διάστημα και προέλευση. Μια where ρήτρα στο ε μετατρέπει μια υπογραφή συνάρτησης σε πύλη ορθότητας χρόνου μεταγλώττισης.', link: '/learn/vancomycin-uncertainty' },
      { tag: 'ΤΥΠΟΣ ΕΦΕΚΤ', desc: 'Το NonUnitary είναι δηλωμένο εφέ, όχι σύμβαση. Οι τύποι εφέ ζουν στην υπογραφή — ο ελεγκτής τύπων επιβάλλει τη σειρά εφέ σε κάθε σημείο κλήσης.', link: '/proof#non-unitary' },
      { tag: 'ΤΥΠΟΣ ΑΛΓΕΒΡΑΣ', desc: 'Το algebra Octonion δηλώνει τον πίνακα πολλαπλασιασμού, κανόνες επαναγραφής και μάσκα μη-προσεταιριστικότητας. Ο compiler κατέχει την άλγεβρα· το Lean την επαληθεύει.', link: '/proof#theorem-168' },
    ],
  },
  zh: {
    heading: '知识论。效应。代数。',
    subhead: '三种编译时类型规程，没有其他语言将其作为一等原语。每一种在每个调用点强制执行。每一种都经过形式化规范。',
    capsules: [
      { tag: '置信度门', desc: 'Knowledge<f64> 携带 ε、区间和溯源。签名上的 where ε 子句将函数签名变为编译时正确性门控。', link: '/learn/vancomycin-uncertainty' },
      { tag: '效应类型', desc: 'NonUnitary 是声明的效应，而非惯例。效应类型存在于签名中——类型检查器在每个调用点强制执行效应行。', link: '/proof#non-unitary' },
      { tag: '代数类型', desc: 'algebra Octonion 声明乘法表、改写规则和非结合性掩码。编译器拥有代数；Lean 对其进行验证。', link: '/proof#theorem-168' },
    ],
  },
  ja: {
    heading: '認識的。エフェクト。代数。',
    subhead: '他のどの言語も第一級プリミティブとして持たない3つのコンパイル時型規律。各々がすべての呼び出しサイトで強制されます。各々が形式的に仕様化されています。',
    capsules: [
      { tag: '信頼度ゲート', desc: 'Knowledge<f64> は ε、区間、出所を保持します。シグネチャの where ε 節は関数シグネチャをコンパイル時正確性ゲートに変えます。', link: '/learn/vancomycin-uncertainty' },
      { tag: 'エフェクト型', desc: 'NonUnitary は宣言されたエフェクトであり、慣例ではありません。エフェクト型はシグネチャに存在し、型チェッカーが各呼び出しサイトでエフェクト行を強制します。', link: '/proof#non-unitary' },
      { tag: '代数型', desc: 'algebra Octonion は乗算テーブル、書き換えルール、非結合マスクを宣言します。コンパイラが代数を所有し、Lean がそれを検証します。', link: '/proof#theorem-168' },
    ],
  },
};

const d = t[locale] ?? t.en;

const snippets: string[] = [
  `let roi: Knowledge<f64> = read_nifti("abide_roi.nii")
let conn = fisher_z_ci(pearson(roi), n=116)
// CI drives the edge, not just the point`,
  `let m_z: Knowledge<f64> = mass_z()  // PDG 2024
let sigma = cross_section(e_plus, e_minus, s=100.0)
// 870 pb ± PDG uncertainty`,
  `let edge: Beta<f64> = posterior_edge(X, Y, data)
let ate = do_calculus(dag, X, Y)
// Beta(6,4) → 0.6 ± 0.15`,
  `fn hadamard(q: Qubit) -> Qubit / Linear
let psi = hadamard(q)
// linear type: q cannot be copied`,
  `let within = ensemble_variance(models)
let between = model_spread(models)
// IPCC: model uncertainty ≠ internal variability`,
  `algebra Octonion {
  basis: [e0..e7]
  product: fano_table
  reassociate: fano_selective
}
let count = count_nonassoc_triples();
// result: 168`,
];
---

<section class="dg-section relative overflow-hidden border-t border-[var(--color-line)] px-6 pb-20 pt-[4.5rem] [perspective:1000px]">
  <div class="dg-bg" aria-hidden="true"></div>
  <div class="dg-overlay" aria-hidden="true"></div>
  <div class="relative z-[1] mx-auto grid max-w-[980px] gap-10">
    <div class="grid gap-2.5">
      <h2 class="dg-heading m-0 font-[var(--font-display)] text-[clamp(1.6rem,3.5vw,2.5rem)] font-normal leading-[1.15] tracking-[-0.01em] text-[var(--color-ink-1)]">{d.heading}</h2>
      <p class="dg-subhead m-0 max-w-[60ch] text-[0.95rem] leading-[1.65] text-[var(--color-ink-2)]">{d.subhead}</p>
    </div>

    <div class="dg-grid grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
      {d.capsules.map((cap, i) => (
        <Card pad="md" class="dg-capsule group flex flex-col gap-3 spotlight-card">
          <div class="absolute inset-0 rounded-[var(--radius-xl)] opacity-0 transition-opacity duration-300 group-hover:opacity-100 pointer-events-none" aria-hidden="true">
            <div class="absolute inset-0 rounded-[var(--radius-xl)] bg-[linear-gradient(135deg,color-mix(in_srgb,var(--color-accent-hyperlink)_20%,transparent),transparent_50%,color-mix(in_srgb,var(--color-accent-hyperlink)_20%,transparent))] opacity-50"></div>
          </div>
          <Eyebrow tone="gold" rule={false} class="opacity-75">{cap.tag}</Eyebrow>
          <CodePanel code={snippets[i]} lang="rust" copy={false} class="text-[0.78rem]" />
          <div class="mt-auto grid gap-2 pt-1">
            <p class="m-0 text-[0.82rem] leading-[1.6] text-[var(--color-ink-2)]">{cap.desc}</p>
            <a href={getLocalizedPath(cap.link, locale)} class="dg-link w-fit text-[0.78rem] text-[var(--color-accent-hyperlink-soft)] no-underline hover:underline">Explore →</a>
          </div>
        </Card>
      ))}
    </div>
  </div>
</section>

<style>
  .dg-bg {
    position: absolute;
    inset: -10% 0;
    background-image: url('/assets/vision/act2-poseidon.jpg');
    background-size: cover;
    background-position: center 40%;
    opacity: 0.07;
    will-change: transform;
  }

  .dg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      var(--color-surface-base) 0%,
      color-mix(in srgb, var(--color-surface-base) 65%, transparent) 12%,
      color-mix(in srgb, var(--color-surface-base) 55%, transparent) 88%,
      var(--color-surface-base) 100%
    );
  }
</style>

<script>
  import { gsap, revealOnScroll, prefersReducedMotion } from '../../lib/motion';

  if (!prefersReducedMotion()) {
    const section = document.querySelector<HTMLElement>('.dg-section');
    const bg = document.querySelector<HTMLElement>('.dg-bg');
    if (section && bg) {
      gsap.to(bg, {
        yPercent: 14,
        ease: 'none',
        scrollTrigger: { trigger: section, start: 'top bottom', end: 'bottom top', scrub: 2 },
      });

      revealOnScroll('.dg-heading, .dg-subhead', {
        y: 40,
        rotateX: 10,
        opacity: 0,
        stagger: 0.12,
        duration: 0.9,
        ease: 'power3.out',
        scrollTrigger: { trigger: section, start: 'top 75%', once: true },
      });

      revealOnScroll('.dg-capsule', {
        y: 60,
        rotateX: 12,
        opacity: 0,
        stagger: 0.16,
        duration: 1.0,
        ease: 'power3.out',
        scrollTrigger: { trigger: '.dg-grid', start: 'top 82%', once: true },
      });
    }
  }
</script>
