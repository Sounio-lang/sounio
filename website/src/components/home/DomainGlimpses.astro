---
import { getLocalizedPath } from '../../lib/i18n';
import type { Locale } from '../../lib/i18n';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;

const t: Record<string, {
  heading: string;
  subhead: string;
  capsules: { tag: string; desc: string; link: string }[];
}> = {
  en: {
    heading: 'Three domains. One language.',
    subhead: 'The type system extends across clinical safety, theoretical physics, and non-associative algebra.',
    capsules: [
      { tag: 'CLINICAL', desc: 'Epistemic confidence gates reject under-measured inputs before dosing calculations run.', link: '/learn/vancomycin-uncertainty' },
      { tag: 'PHYSICS', desc: 'NonUnitary effects model open quantum systems — the first effect-typed non-unitary amplitude in any language.', link: '/proof#non-unitary' },
      { tag: 'GEOMETRY', desc: 'Non-associative algebra over octonions, machine-checked by the language that owns the result.', link: '/proof#theorem-168' },
    ],
  },
  pt: {
    heading: 'Três domínios. Uma linguagem.',
    subhead: 'O sistema de tipos estende-se por segurança clínica, física teórica e álgebra não-associativa.',
    capsules: [
      { tag: 'CLÍNICO', desc: 'Portões de confiança epistémica rejeitam entradas sub-medidas antes de calcular doses.', link: '/learn/vancomycin-uncertainty' },
      { tag: 'FÍSICA', desc: 'Efeitos NonUnitary modelam sistemas quânticos abertos — a primeira amplitude não-unitária com tipo de efeito em qualquer linguagem.', link: '/proof#non-unitary' },
      { tag: 'GEOMETRIA', desc: 'Álgebra não-associativa sobre octoniões, verificada mecanicamente pela linguagem que possui o resultado.', link: '/proof#theorem-168' },
    ],
  },
  es: {
    heading: 'Tres dominios. Un lenguaje.',
    subhead: 'El sistema de tipos se extiende por seguridad clínica, física teórica y álgebra no asociativa.',
    capsules: [
      { tag: 'CLÍNICO', desc: 'Las puertas de confianza epistémica rechazan entradas submedidas antes de calcular las dosis.', link: '/learn/vancomycin-uncertainty' },
      { tag: 'FÍSICA', desc: 'Los efectos NonUnitary modelan sistemas cuánticos abiertos — la primera amplitud no unitaria con tipo de efecto en cualquier lenguaje.', link: '/proof#non-unitary' },
      { tag: 'GEOMETRÍA', desc: 'Álgebra no asociativa sobre octoniões, verificada mecánicamente por el lenguaje que posee el resultado.', link: '/proof#theorem-168' },
    ],
  },
  el: {
    heading: 'Τρία πεδία. Μία γλώσσα.',
    subhead: 'Το σύστημα τύπων επεκτείνεται σε κλινική ασφάλεια, θεωρητική φυσική και μη-προσεταιριστική άλγεβρα.',
    capsules: [
      { tag: 'ΚΛΙΝΙΚΟ', desc: 'Επιστημικές πύλες εμπιστοσύνης απορρίπτουν υποβέλτιστες μετρήσεις πριν τους υπολογισμούς δοσολογίας.', link: '/learn/vancomycin-uncertainty' },
      { tag: 'ΦΥΣΙΚΗ', desc: 'Εφέ NonUnitary μοντελοποιούν ανοιχτά κβαντικά συστήματα — η πρώτη μη-μοναδιαία πλάτος με τύπο εφέ σε οποιαδήποτε γλώσσα.', link: '/proof#non-unitary' },
      { tag: 'ΓΕΩΜΕΤΡΙΑ', desc: 'Μη-προσεταιριστική άλγεβρα πάνω στα οκτόνια, επαληθευμένη μηχανικά από τη γλώσσα που κατέχει το αποτέλεσμα.', link: '/proof#theorem-168' },
    ],
  },
  zh: {
    heading: '三个领域。一门语言。',
    subhead: '类型系统横跨临床安全、理论物理和非结合代数。',
    capsules: [
      { tag: '临床', desc: '知识论置信度门控在剂量计算运行之前拒绝测量不足的输入。', link: '/learn/vancomycin-uncertainty' },
      { tag: '物理', desc: 'NonUnitary 效应对开放量子系统建模——任何语言中第一个效应类型化的非幺正振幅。', link: '/proof#non-unitary' },
      { tag: '几何', desc: '八元数上的非结合代数，由拥有该结果的语言进行机器验证。', link: '/proof#theorem-168' },
    ],
  },
  ja: {
    heading: '3つのドメイン。1つの言語。',
    subhead: '型システムは臨床安全、理論物理学、非結合代数に及びます。',
    capsules: [
      { tag: '臨床', desc: '認識的信頼度ゲートは、投与量計算が実行される前に不十分な測定値の入力を拒否します。', link: '/learn/vancomycin-uncertainty' },
      { tag: '物理学', desc: 'NonUnitary エフェクトは開放量子系をモデル化します——あらゆる言語で初めてのエフェクト型付き非ユニタリ振幅。', link: '/proof#non-unitary' },
      { tag: '幾何学', desc: 'オクトニオン上の非結合代数、その結果を所有する言語によって機械検証済み。', link: '/proof#theorem-168' },
    ],
  },
};

const d = t[locale] ?? t.en;

// HTML entities prevent Astro from parsing generic syntax like Knowledge<f64> as HTML.
const snippets: string[] = [
  // Clinical
  `<span class="kw">fn</span> <span class="fn-name">dose_vancomycin</span>(<span class="param">auc</span>: <span class="type">Knowledge</span>&lt;<span class="type">f64</span>&gt;) -&gt; <span class="type">f64</span>
  <span class="kw">where</span> <span class="param">auc</span>.<span class="field">&epsilon;</span> &gt;= <span class="num">0.82</span>
{
  <span class="param">auc</span>.<span class="field">value</span> / <span class="num">24.0</span>
}`,
  // Physics
  `<span class="kw">effect</span> <span class="type">NonUnitary</span> {
  amplitude: <span class="type">Complex</span>&lt;<span class="type">f64</span>&gt;
}

<span class="kw">fn</span> <span class="fn-name">tt_amplitude</span>(
  p1: <span class="type">FourMomentum</span>, p2: <span class="type">FourMomentum</span>
) -&gt; <span class="type">f64</span> / <span class="type">NonUnitary</span> {
  <span class="comment">// …</span>
}`,
  // Geometry
  `<span class="kw">algebra</span> <span class="type">Octonion</span> {
  basis: [e0..e7]
  product: fano_table
  reassociate: fano_selective
}

<span class="kw">let</span> count = <span class="fn-name">count_nonassoc_triples</span>();
<span class="comment">// result: 168</span>`,
];
---

<section class="domain-glimpses-section">
  <div class="domain-glimpses-inner">
    <div class="dg-header">
      <h2 class="dg-heading">{d.heading}</h2>
      <p class="dg-subhead">{d.subhead}</p>
    </div>

    <div class="dg-grid">
      {d.capsules.map((cap, i) => (
        <div class="dg-capsule">
          <div class="dg-tag">{cap.tag}</div>
          <pre class="dg-code"><code set:html={snippets[i]} /></pre>
          <div class="dg-footer">
            <p class="dg-desc">{cap.desc}</p>
            <a href={getLocalizedPath(cap.link, locale)} class="dg-link">Explore →</a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .domain-glimpses-section {
    padding: 4.5rem 1.5rem 5rem;
  }

  .domain-glimpses-inner {
    max-width: 980px;
    margin: 0 auto;
    display: grid;
    gap: 2.5rem;
  }

  .dg-header {
    display: grid;
    gap: 0.6rem;
  }

  .dg-heading {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    font-weight: 400;
    color: var(--color-text-primary);
    margin: 0;
    line-height: 1.2;
  }

  .dg-subhead {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    margin: 0;
    max-width: 62ch;
    line-height: 1.65;
  }

  .dg-grid {
    display: grid;
    gap: 1.2rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .dg-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .dg-capsule {
    display: grid;
    grid-template-rows: auto 1fr auto;
    border: 1px solid var(--glass-border);
    border-radius: 10px;
    overflow: hidden;
    background: #0d1a2d;
  }

  .dg-tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    color: var(--color-accent-gold-soft);
    opacity: 0.75;
    padding: 0.6rem 1rem;
    border-bottom: 1px solid rgba(255,255,255,0.05);
    background: rgba(255,255,255,0.02);
  }

  .dg-code {
    margin: 0;
    padding: 1rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.65;
    overflow-x: auto;
    background: transparent;
    border: none;
    color: rgba(255,255,255,0.78);
  }

  .dg-code :global(.kw)      { color: #c792ea; }
  .dg-code :global(.fn-name) { color: #82aaff; }
  .dg-code :global(.type)    { color: #ffcb6b; }
  .dg-code :global(.param)   { color: #f07178; }
  .dg-code :global(.field)   { color: #89ddff; }
  .dg-code :global(.num)     { color: #f78c6c; }
  .dg-code :global(.comment) { color: rgba(255,255,255,0.28); font-style: italic; }

  .dg-footer {
    padding: 0.8rem 1rem 1rem;
    border-top: 1px solid rgba(255,255,255,0.05);
    display: grid;
    gap: 0.5rem;
  }

  .dg-desc {
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .dg-link {
    font-size: 0.78rem;
    color: var(--color-accent-gold-soft);
    text-decoration: none;
  }

  .dg-link:hover {
    text-decoration: underline;
  }
</style>
