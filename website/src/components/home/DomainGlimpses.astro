---
import { getLocalizedPath } from '../../lib/i18n';
import type { Locale } from '../../lib/i18n';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;

const t: Record<string, {
  heading: string;
  subhead: string;
  capsules: { tag: string; desc: string; link: string }[];
}> = {
  en: {
    heading: 'Three type-system features. One language.',
    subhead: 'Epistemic confidence gates, effect-typed signatures, and declared algebra types — each a distinct extension to the core type theory, each enforced at compile time.',
    capsules: [
      { tag: 'CONFIDENCE GATE', desc: 'Knowledge<f64> carries ε, interval, and provenance. A where clause on ε turns a function signature into a compile-time correctness gate.', link: '/learn/vancomycin-uncertainty' },
      { tag: 'EFFECT TYPE', desc: 'NonUnitary is a declared effect, not a convention. Effect types live in the signature — the type checker enforces the effect row at every call site.', link: '/proof#non-unitary' },
      { tag: 'ALGEBRA TYPE', desc: 'algebra Octonion declares the multiplication table, rewriting rules, and non-associativity mask. The compiler owns the algebra; Lean verifies it.', link: '/proof#theorem-168' },
    ],
  },
  pt: {
    heading: 'Três funcionalidades do sistema de tipos. Uma linguagem.',
    subhead: 'Portões de confiança epistémica, assinaturas com tipo de efeito e tipos de álgebra declarados — cada um uma extensão distinta da teoria de tipos central, cada um aplicado em tempo de compilação.',
    capsules: [
      { tag: 'PORTÃO DE CONFIANÇA', desc: 'Knowledge<f64> carrega ε, intervalo e proveniência. Uma cláusula where em ε transforma uma assinatura de função num portão de correção em tempo de compilação.', link: '/learn/vancomycin-uncertainty' },
      { tag: 'TIPO DE EFEITO', desc: 'NonUnitary é um efeito declarado, não uma convenção. Tipos de efeito vivem na assinatura — o verificador de tipos aplica a linha de efeitos em cada chamada.', link: '/proof#non-unitary' },
      { tag: 'TIPO DE ÁLGEBRA', desc: 'algebra Octonion declara a tabela de multiplicação, regras de reescrita e máscara de não-associatividade. O compilador possui a álgebra; Lean verifica-a.', link: '/proof#theorem-168' },
    ],
  },
  es: {
    heading: 'Tres características del sistema de tipos. Un lenguaje.',
    subhead: 'Puertas de confianza epistémica, firmas con tipo de efecto y tipos de álgebra declarados — cada uno una extensión distinta de la teoría de tipos central, cada uno aplicado en tiempo de compilación.',
    capsules: [
      { tag: 'PUERTA DE CONFIANZA', desc: 'Knowledge<f64> lleva ε, intervalo y procedencia. Una cláusula where en ε convierte una firma de función en una puerta de corrección en tiempo de compilación.', link: '/learn/vancomycin-uncertainty' },
      { tag: 'TIPO DE EFECTO', desc: 'NonUnitary es un efecto declarado, no una convención. Los tipos de efecto viven en la firma — el verificador de tipos impone la fila de efectos en cada llamada.', link: '/proof#non-unitary' },
      { tag: 'TIPO DE ÁLGEBRA', desc: 'algebra Octonion declara la tabla de multiplicación, reglas de reescritura y máscara de no asociatividad. El compilador posee el álgebra; Lean la verifica.', link: '/proof#theorem-168' },
    ],
  },
  el: {
    heading: 'Τρία χαρακτηριστικά συστήματος τύπων. Μία γλώσσα.',
    subhead: 'Πύλες επιστημικής εμπιστοσύνης, υπογραφές με τύπο εφέ και δηλωμένοι τύποι άλγεβρας — καθένα μια ξεχωριστή επέκταση της κεντρικής θεωρίας τύπων, καθένα επιβαλλόμενο κατά τη μεταγλώττιση.',
    capsules: [
      { tag: 'ΠΥΛΗ ΕΜΠΙΣΤΟΣΥΝΗΣ', desc: 'Η Knowledge<f64> φέρει ε, διάστημα και προέλευση. Μια where ρήτρα στο ε μετατρέπει μια υπογραφή συνάρτησης σε πύλη ορθότητας χρόνου μεταγλώττισης.', link: '/learn/vancomycin-uncertainty' },
      { tag: 'ΤΥΠΟΣ ΕΦΕΚΤ', desc: 'Το NonUnitary είναι δηλωμένο εφέ, όχι σύμβαση. Οι τύποι εφέ ζουν στην υπογραφή — ο ελεγκτής τύπων επιβάλλει τη σειρά εφέ σε κάθε σημείο κλήσης.', link: '/proof#non-unitary' },
      { tag: 'ΤΥΠΟΣ ΑΛΓΕΒΡΑΣ', desc: 'Το algebra Octonion δηλώνει τον πίνακα πολλαπλασιασμού, κανόνες επαναγραφής και μάσκα μη-προσεταιριστικότητας. Ο compiler κατέχει την άλγεβρα· το Lean την επαληθεύει.', link: '/proof#theorem-168' },
    ],
  },
  zh: {
    heading: '三个类型系统特性。一门语言。',
    subhead: '知识论置信度门、效应类型签名和声明代数类型——每一个都是核心类型理论的独立扩展，每一个都在编译时强制执行。',
    capsules: [
      { tag: '置信度门', desc: 'Knowledge<f64> 携带 ε、区间和溯源。签名上的 where ε 子句将函数签名变为编译时正确性门控。', link: '/learn/vancomycin-uncertainty' },
      { tag: '效应类型', desc: 'NonUnitary 是声明的效应，而非惯例。效应类型存在于签名中——类型检查器在每个调用点强制执行效应行。', link: '/proof#non-unitary' },
      { tag: '代数类型', desc: 'algebra Octonion 声明乘法表、改写规则和非结合性掩码。编译器拥有代数；Lean 对其进行验证。', link: '/proof#theorem-168' },
    ],
  },
  ja: {
    heading: '3つの型システム機能。1つの言語。',
    subhead: '認識的信頼度ゲート、エフェクト型シグネチャ、宣言型代数型——それぞれがコア型理論への独自の拡張であり、コンパイル時に強制されます。',
    capsules: [
      { tag: '信頼度ゲート', desc: 'Knowledge<f64> は ε、区間、出所を保持します。シグネチャの where ε 節は関数シグネチャをコンパイル時正確性ゲートに変えます。', link: '/learn/vancomycin-uncertainty' },
      { tag: 'エフェクト型', desc: 'NonUnitary は宣言されたエフェクトであり、慣例ではありません。エフェクト型はシグネチャに存在し、型チェッカーが各呼び出しサイトでエフェクト行を強制します。', link: '/proof#non-unitary' },
      { tag: '代数型', desc: 'algebra Octonion は乗算テーブル、書き換えルール、非結合マスクを宣言します。コンパイラが代数を所有し、Lean がそれを検証します。', link: '/proof#theorem-168' },
    ],
  },
};

const d = t[locale] ?? t.en;

// HTML entities prevent Astro from parsing generic syntax like Knowledge<f64> as HTML.
const snippets: string[] = [
  // Clinical
  `<span class="kw">fn</span> <span class="fn-name">dose_vancomycin</span>(<span class="param">auc</span>: <span class="type">Knowledge</span>&lt;<span class="type">f64</span>&gt;) -&gt; <span class="type">f64</span>
  <span class="kw">where</span> <span class="param">auc</span>.<span class="field">&epsilon;</span> &gt;= <span class="num">0.82</span>
{
  <span class="param">auc</span>.<span class="field">value</span> / <span class="num">24.0</span>
}`,
  // Physics
  `<span class="kw">effect</span> <span class="type">NonUnitary</span> {
  amplitude: <span class="type">Complex</span>&lt;<span class="type">f64</span>&gt;
}

<span class="kw">fn</span> <span class="fn-name">tt_amplitude</span>(
  p1: <span class="type">FourMomentum</span>, p2: <span class="type">FourMomentum</span>
) -&gt; <span class="type">f64</span> / <span class="type">NonUnitary</span> {
  <span class="comment">// …</span>
}`,
  // Geometry
  `<span class="kw">algebra</span> <span class="type">Octonion</span> {
  basis: [e0..e7]
  product: fano_table
  reassociate: fano_selective
}

<span class="kw">let</span> count = <span class="fn-name">count_nonassoc_triples</span>();
<span class="comment">// result: 168</span>`,
];
---

<section class="domain-glimpses-section">
  <div class="domain-glimpses-inner">
    <div class="dg-header">
      <h2 class="dg-heading">{d.heading}</h2>
      <p class="dg-subhead">{d.subhead}</p>
    </div>

    <div class="dg-grid">
      {d.capsules.map((cap, i) => (
        <div class="dg-capsule">
          <div class="dg-tag">{cap.tag}</div>
          <pre class="dg-code"><code set:html={snippets[i]} /></pre>
          <div class="dg-footer">
            <p class="dg-desc">{cap.desc}</p>
            <a href={getLocalizedPath(cap.link, locale)} class="dg-link">Explore →</a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .domain-glimpses-section {
    padding: 4.5rem 1.5rem 5rem;
  }

  .domain-glimpses-inner {
    max-width: 980px;
    margin: 0 auto;
    display: grid;
    gap: 2.5rem;
  }

  .dg-header {
    display: grid;
    gap: 0.6rem;
  }

  .dg-heading {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    font-weight: 400;
    color: var(--color-text-primary);
    margin: 0;
    line-height: 1.2;
  }

  .dg-subhead {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    margin: 0;
    max-width: 62ch;
    line-height: 1.65;
  }

  .dg-grid {
    display: grid;
    gap: 1.2rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .dg-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .dg-capsule {
    display: grid;
    grid-template-rows: auto 1fr auto;
    border: 1px solid var(--glass-border);
    border-radius: 10px;
    overflow: hidden;
    background: #0d1a2d;
  }

  .dg-tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    color: var(--color-accent-gold-soft);
    opacity: 0.75;
    padding: 0.6rem 1rem;
    border-bottom: 1px solid rgba(255,255,255,0.05);
    background: rgba(255,255,255,0.02);
  }

  .dg-code {
    margin: 0;
    padding: 1rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.65;
    overflow-x: auto;
    background: transparent;
    border: none;
    color: rgba(255,255,255,0.78);
  }

  .dg-code :global(.kw)      { color: #c792ea; }
  .dg-code :global(.fn-name) { color: #82aaff; }
  .dg-code :global(.type)    { color: #ffcb6b; }
  .dg-code :global(.param)   { color: #f07178; }
  .dg-code :global(.field)   { color: #89ddff; }
  .dg-code :global(.num)     { color: #f78c6c; }
  .dg-code :global(.comment) { color: rgba(255,255,255,0.28); font-style: italic; }

  .dg-footer {
    padding: 0.8rem 1rem 1rem;
    border-top: 1px solid rgba(255,255,255,0.05);
    display: grid;
    gap: 0.5rem;
  }

  .dg-desc {
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .dg-link {
    font-size: 0.78rem;
    color: var(--color-accent-gold-soft);
    text-decoration: none;
  }

  .dg-link:hover {
    text-decoration: underline;
  }
</style>
