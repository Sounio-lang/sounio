---
import renderManifest from '../../../public/assets/generated/render/manifest.json';
import type { Locale } from '../../lib/i18n';

interface Props {
  locale?: Locale;
}

const locale: Locale = Astro.props.locale ?? 'en';

const copy = {
  en: {
    label: 'COMPILED VISUAL RECEIPTS',
    heading: 'Every image has a source file.',
    body: 'Sounio can be inspected beyond syntax. These checked-in renders retain the example, command, dimensions, and manifest entry used to produce their raster source.',
    inspect: 'Inspect source',
    manifest: 'Generated asset manifest',
    compiler: 'Compiler entrypoint',
    registry: 'Registered renders',
    receipts: {
      'uncertainty-field.svg': {
        title: 'Uncertainty field',
        body: 'A 16 by 16 epistemic heatmap where value and epsilon become color and brightness.',
      },
      'causal-dag.svg': {
        title: 'Causal graph',
        body: 'A front-door causal graph with intervention and latent-node annotations emitted as raster output.',
      },
      'quaternion-rotation.svg': {
        title: 'Quaternion rotation',
        body: 'A tetrahedron wireframe showing original and quaternion-rotated geometry from Sounio code.',
      },
    },
  },
  pt: {
    label: 'RECIBOS VISUAIS COMPILADOS',
    heading: 'Cada imagem tem um arquivo-fonte.',
    body: 'Sounio pode ser inspecionada para além da sintaxe. Estes renders versionados preservam o exemplo, o comando, as dimensões e a entrada do manifesto usados para produzir sua fonte raster.',
    inspect: 'Inspecionar fonte',
    manifest: 'Manifesto de assets gerados',
    compiler: 'Entrada do compilador',
    registry: 'Renders registrados',
    receipts: {
      'uncertainty-field.svg': {
        title: 'Campo de incerteza',
        body: 'Um mapa epistêmico 16 por 16 em que valor e epsilon se tornam cor e brilho.',
      },
      'causal-dag.svg': {
        title: 'Grafo causal',
        body: 'Um grafo causal front-door com anotações de intervenção e nó latente emitido como saída raster.',
      },
      'quaternion-rotation.svg': {
        title: 'Rotação por quaternion',
        body: 'Um tetraedro em wireframe mostrando a geometria original e a rotacionada a partir de código Sounio.',
      },
    },
  },
} as const;

const d = locale === 'pt' ? copy.pt : copy.en;
const selectedAssets = ['causal-dag.svg', 'uncertainty-field.svg', 'quaternion-rotation.svg'] as const;

const receipts = selectedAssets.map((assetFile) => {
  const asset = renderManifest.assets.find((entry) => entry.asset.endsWith(assetFile));
  if (!asset) {
    throw new Error(`Missing compiled visual receipt: ${assetFile}`);
  }

  return {
    ...asset,
    assetFile,
    ...d.receipts[assetFile],
    sourceHref: `https://github.com/Sounio-lang/sounio/blob/main/${asset.example}`,
  };
});
---

<section class="cvr-section" aria-labelledby="cvr-heading">
  <div class="container cvr-layout">
    <header class="cvr-intro">
      <p class="cvr-label">{d.label}</p>
      <h2 id="cvr-heading">{d.heading}</h2>
      <p class="cvr-body">{d.body}</p>

      <dl class="cvr-ledger">
        <div>
          <dt>{d.manifest}</dt>
          <dd><code>render/manifest.json</code></dd>
        </div>
        <div>
          <dt>{d.compiler}</dt>
          <dd><code>{renderManifest.compiler_artifact}</code></dd>
        </div>
        <div>
          <dt>{d.registry}</dt>
          <dd>{renderManifest.assets.length}</dd>
        </div>
      </dl>
    </header>

    <div class="cvr-grid">
      {receipts.map((receipt, index) => (
        <a
          class:list={['cvr-receipt', { 'is-wide': receipt.assetFile === 'causal-dag.svg' }]}
          href={receipt.sourceHref}
          aria-label={`${d.inspect}: ${receipt.title}`}
        >
          <div class="cvr-image-well">
            <img
              src={receipt.public_path}
              alt={`${receipt.title}. ${receipt.body}`}
              width={receipt.width}
              height={receipt.height}
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="cvr-receipt-copy">
            <div class="cvr-receipt-heading">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{receipt.title}</h3>
              <small>{receipt.width} x {receipt.height}</small>
            </div>
            <p>{receipt.body}</p>
            <span class="cvr-source">{receipt.example}</span>
            <code class="cvr-command">{receipt.command}</code>
            <span class="cvr-inspect">{d.inspect}</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .cvr-section {
    padding: 5.5rem 0;
    overflow: hidden;
    border-block: 1px solid color-mix(in srgb, var(--color-accent-gold) 18%, transparent);
    background: #06152a;
  }

  .cvr-layout {
    display: grid;
    gap: 2.5rem;
  }

  .cvr-intro {
    display: grid;
    align-content: start;
    gap: 1rem;
  }

  .cvr-label {
    margin: 0;
    color: var(--color-accent-gold-soft);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .cvr-intro h2 {
    max-width: 9ch;
    margin: 0;
    color: var(--color-text-primary);
    font-family: var(--font-display);
    font-size: clamp(2.7rem, 5vw, 4.5rem);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: 0;
  }

  .cvr-body {
    max-width: 42ch;
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.96rem;
    line-height: 1.7;
  }

  .cvr-ledger {
    display: grid;
    gap: 0;
    margin: 1rem 0 0;
    border-top: 1px solid rgba(214, 179, 90, 0.2);
  }

  .cvr-ledger div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid rgba(214, 179, 90, 0.14);
  }

  .cvr-ledger dt,
  .cvr-ledger dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    line-height: 1.45;
  }

  .cvr-ledger dt {
    color: var(--color-text-tertiary);
  }

  .cvr-ledger dd {
    color: var(--color-accent-gold-soft);
    text-align: right;
  }

  .cvr-ledger code {
    font: inherit;
  }

  .cvr-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .cvr-receipt {
    display: grid;
    min-width: 0;
    overflow: hidden;
    border: 1px solid rgba(214, 179, 90, 0.22);
    border-radius: 8px;
    background: #08111f;
    color: inherit;
    text-decoration: none;
    transition: border-color var(--transition-fast), transform var(--transition-fast);
  }

  .cvr-receipt:hover {
    border-color: rgba(214, 179, 90, 0.66);
    transform: translateY(-2px);
  }

  .cvr-receipt:focus-visible {
    outline: 2px solid var(--color-accent-gold);
    outline-offset: 3px;
  }

  .cvr-receipt.is-wide {
    grid-column: 1 / -1;
    grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.85fr);
  }

  .cvr-image-well {
    display: grid;
    min-height: 14rem;
    place-items: center;
    overflow: hidden;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    background: #000;
  }

  .is-wide .cvr-image-well {
    min-height: 20rem;
    border-right: 1px solid rgba(255, 255, 255, 0.07);
    border-bottom: 0;
  }

  .cvr-image-well img {
    width: 100%;
    height: 100%;
    max-height: 21rem;
    object-fit: contain;
    image-rendering: pixelated;
  }

  .cvr-receipt-copy {
    display: grid;
    min-width: 0;
    align-content: start;
    gap: 0.8rem;
    padding: 1.15rem;
  }

  .cvr-receipt-heading {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.65rem;
    align-items: baseline;
  }

  .cvr-receipt-heading span,
  .cvr-receipt-heading small {
    color: var(--color-accent-gold-soft);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.08em;
  }

  .cvr-receipt-heading h3 {
    margin: 0;
    color: var(--color-text-primary);
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: 0;
  }

  .cvr-receipt-copy p {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.86rem;
    line-height: 1.6;
  }

  .cvr-source,
  .cvr-command {
    display: block;
    min-width: 0;
    overflow-x: auto;
    color: var(--color-text-tertiary);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    line-height: 1.55;
    white-space: nowrap;
  }

  .cvr-command {
    padding-top: 0.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    color: #8fc7bd;
  }

  .cvr-inspect {
    width: fit-content;
    margin-top: 0.25rem;
    color: var(--color-accent-gold-soft);
    font-size: 0.76rem;
    text-decoration: underline;
    text-decoration-color: rgba(214, 179, 90, 0.34);
    text-underline-offset: 4px;
  }

  @media (min-width: 960px) {
    .cvr-layout {
      grid-template-columns: minmax(250px, 0.72fr) minmax(0, 1.78fr);
      gap: clamp(2.5rem, 5vw, 5.5rem);
      align-items: start;
    }
  }

  @media (max-width: 760px) {
    .cvr-section {
      padding: 4.5rem 0;
    }

    .cvr-intro h2 {
      max-width: 11ch;
    }

    .cvr-grid {
      grid-template-columns: 1fr;
    }

    .cvr-receipt.is-wide {
      grid-column: auto;
      grid-template-columns: 1fr;
    }

    .is-wide .cvr-image-well {
      min-height: 12rem;
      border-right: 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    }

    .cvr-image-well {
      min-height: 12rem;
      max-height: 15rem;
    }
  }
</style>
