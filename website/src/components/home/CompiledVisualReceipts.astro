---
import renderManifest from '../../../public/assets/generated/render/manifest.json';
import type { Locale } from '../../lib/i18n';
import RenderAtelier from './RenderAtelier';

interface Props { locale?: Locale; }

const locale: Locale = Astro.props.locale ?? 'en';

const receiptCopy = {
  en: {
    'coverage-crystal-atelier.png': {
      title: 'Coverage crystal',
      body: 'A deterministic Phong material study with four-sample edge coverage and fixed-point depth, rendered entirely by Sounio.',
    },
    'triangle-basic.svg': {
      title: 'Barycentric triangle',
      body: 'A 128 by 128 software raster with barycentric color interpolation authored in Sounio.',
    },
    'uncertainty-field.svg': {
      title: 'Uncertainty field',
      body: 'A 16 by 16 integer-scaled uncertainty field where value becomes color and epsilon controls brightness.',
    },
    'causal-dag.svg': {
      title: 'Causal graph',
      body: 'A Sounio-authored X to M to Y raster diagram with a latent U node and intervention-highlighted X.',
    },
  },
  pt: {
    'coverage-crystal-atelier.png': {
      title: 'Cristal de cobertura',
      body: 'Um estudo determinístico de materiais Phong com quatro amostras de cobertura nas bordas e profundidade fixed-point, renderizado inteiramente pelo Sounio.',
    },
    'triangle-basic.svg': {
      title: 'Triângulo baricêntrico',
      body: 'Um raster de software 128 por 128 com interpolação baricêntrica de cores, escrito em Sounio.',
    },
    'uncertainty-field.svg': {
      title: 'Campo de incerteza',
      body: 'Um campo de incerteza 16 por 16 em escala inteira, onde valor vira cor e epsilon controla o brilho.',
    },
    'causal-dag.svg': {
      title: 'Grafo causal',
      body: 'Um diagrama raster X para M para Y escrito em Sounio, com nó latente U e X destacado como intervenção.',
    },
  },
} as const;

const selectedAssets = ['coverage-crystal-atelier.png', 'triangle-basic.svg', 'uncertainty-field.svg', 'causal-dag.svg'] as const;
const localizedCopy = locale === 'pt' ? receiptCopy.pt : receiptCopy.en;

const receipts = selectedAssets.map((assetFile) => {
  const asset = renderManifest.assets.find((entry) => entry.asset.endsWith(assetFile));
  if (!asset) throw new Error(`Missing compiled visual receipt: ${assetFile}`);
  return {
    assetFile,
    assetPath: asset.asset,
    publicPath: asset.public_path,
    example: asset.example,
    command: asset.command,
    width: asset.width,
    height: asset.height,
    sourceHref: `https://github.com/Sounio-lang/sounio/blob/${asset.source_ref ?? 'main'}/${asset.example}`,
    engine: asset.engine,
    sha256: asset.sha256,
    renderSha256: asset.render_sha256,
    verification: asset.verification,
    gate: asset.gate,
    receipt: asset.receipt,
    ...localizedCopy[assetFile],
  };
});
---

<RenderAtelier
  locale={locale}
  receipts={receipts}
  compilerArtifact={renderManifest.compiler_artifact}
  registrySize={renderManifest.assets.length}
  client:visible
/>
