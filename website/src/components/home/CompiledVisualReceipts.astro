---
import renderManifest from '../../../public/assets/generated/render/manifest.json';
import type { Locale } from '../../lib/i18n';
import RenderAtelier from './RenderAtelier';

interface Props { locale?: Locale; }

const locale: Locale = Astro.props.locale ?? 'en';

const receiptCopy = {
  en: {
    'coverage-crystal-atelier.png': {
      title: 'Coverage crystal',
      body: 'A deterministic Phong material study with four-sample edge coverage and fixed-point depth, rendered entirely by Sounio.',
    },
    'rapamycin-material-study.png': {
      title: 'Idealized rapamycin scaffold',
      body: 'A deterministic ball-and-stick receipt traversing 44 heavy-atom sites and 45 bond records from Sounio\'s coarse stdlib model, not a crystallographic reconstruction.',
    },
    'epistemic-field-atelier.png': {
      title: 'Epistemic frontier',
      body: 'An illustrative field where viridis carries value, magma carries first-order standard uncertainty, and the lower strip keeps PBox mean ambiguity separate from variance.',
    },
    'triangle-basic.svg': {
      title: 'Barycentric triangle',
      body: 'A 128 by 128 software raster with barycentric color interpolation authored in Sounio.',
    },
    'uncertainty-field.svg': {
      title: 'Uncertainty field',
      body: 'A 16 by 16 integer-scaled uncertainty field where value becomes color and epsilon controls brightness.',
    },
    'causal-intervention-frontier.png': {
      title: 'Causal refusal',
      body: 'A fixed-DAG witness where native do(X) surgery cuts incoming causes of X, while latent U keeps the backdoor open and Sounio refuses an observed-data effect estimate.',
    },
  },
  pt: {
    'coverage-crystal-atelier.png': {
      title: 'Cristal de cobertura',
      body: 'Um estudo determinístico de materiais Phong com quatro amostras de cobertura nas bordas e profundidade fixed-point, renderizado inteiramente pelo Sounio.',
    },
    'rapamycin-material-study.png': {
      title: 'Scaffold idealizado de rapamicina',
      body: 'Um recibo ball-and-stick determinístico que percorre 44 sítios de átomos pesados e 45 registros de ligações do modelo coarse da stdlib, não uma reconstrução cristalográfica.',
    },
    'epistemic-field-atelier.png': {
      title: 'Fronteira epistêmica',
      body: 'Um campo ilustrativo onde viridis carrega valor, magma carrega incerteza-padrão de primeira ordem e a faixa inferior mantém ambiguidade de média PBox separada da variância.',
    },
    'triangle-basic.svg': {
      title: 'Triângulo baricêntrico',
      body: 'Um raster de software 128 por 128 com interpolação baricêntrica de cores, escrito em Sounio.',
    },
    'uncertainty-field.svg': {
      title: 'Campo de incerteza',
      body: 'Um campo de incerteza 16 por 16 em escala inteira, onde valor vira cor e epsilon controla o brilho.',
    },
    'causal-intervention-frontier.png': {
      title: 'Recusa causal',
      body: 'Um testemunho em DAG fixo onde a cirurgia do(X) nativa corta as causas de entrada de X, enquanto U latente mantém o backdoor aberto e o Sounio recusa estimar efeito com os dados observados.',
    },
  },
} as const;

const selectedAssets = ['coverage-crystal-atelier.png', 'rapamycin-material-study.png', 'epistemic-field-atelier.png', 'causal-intervention-frontier.png'] as const;
const localizedCopy = locale === 'pt' ? receiptCopy.pt : receiptCopy.en;

const receipts = selectedAssets.map((assetFile) => {
  const asset = renderManifest.assets.find((entry) => entry.asset.endsWith(assetFile));
  if (!asset) throw new Error(`Missing compiled visual receipt: ${assetFile}`);
  return {
    assetFile,
    assetPath: asset.asset,
    publicPath: asset.public_path,
    example: asset.example,
    command: asset.command,
    width: asset.width,
    height: asset.height,
    sourceHref: `https://github.com/Sounio-lang/sounio/blob/${asset.source_ref ?? 'main'}/${asset.example}`,
    sourceRef: asset.source_ref,
    sourceAsset: asset.source_asset,
    gateHref: asset.gate
      ? `https://github.com/Sounio-lang/sounio/blob/${asset.source_ref ?? 'main'}/${asset.gate}`
      : undefined,
    engine: asset.engine,
    sha256: asset.sha256,
    renderSha256: asset.render_sha256,
    verification: asset.verification,
    gate: asset.gate,
    receipt: asset.receipt,
    ...localizedCopy[assetFile],
  };
});
---

<RenderAtelier
  locale={locale}
  receipts={receipts}
  compilerArtifact={renderManifest.compiler_artifact}
  registrySize={renderManifest.assets.length}
  client:visible
/>
