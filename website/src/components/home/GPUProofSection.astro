---
import { getLocalizedPath, type Locale } from '../../lib/i18n';
import { WebGPUSimulator } from '../science-simulators/WebGPUSimulator';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const proofPoints = [
  {
    label: 'Render path',
    value: 'WebGPU first',
    detail: 'Canvas fallback if browser support is absent.',
  },
  {
    label: 'Semantic object',
    value: 'Provenance field',
    detail: 'Confidence lattice, uncertainty widening, tensor pulse.',
  },
  {
    label: 'Product role',
    value: 'Storefront proof',
    detail: 'A visible GPU thesis, not decorative motion.',
  },
];
---

<section class="section-shell gpu-proof-section">
  <div class="container">
    <div class="gpu-proof-shell glass glass-specular">
      <div class="gpu-proof-copy">
        <span class="gpu-proof-kicker">Flagship Proof Surface</span>
        <h2 class="section-heading">A GPU story people can actually see.</h2>
        <p class="gpu-proof-lead">
          The website needed one unmistakable technical object. This is it: a browser-side provenance field that
          prefers WebGPU, exposes uncertainty as a first-class visual signal, and still degrades cleanly when the
          browser cannot render on the GPU.
        </p>
        <p class="gpu-proof-body">
          It is not the whole backend. It is the storefront counterpart to the PTX, runtime, and attestation work
          living in the repo. The point is to make the GPU thesis legible before anyone reads a single release note.
        </p>

        <div class="gpu-proof-grid" role="list" aria-label="WebGPU proof properties">
          {proofPoints.map((item) => (
            <article class="gpu-proof-pill" role="listitem">
              <span>{item.label}</span>
              <strong>{item.value}</strong>
              <p>{item.detail}</p>
            </article>
          ))}
        </div>

        <div class="gpu-proof-actions">
          <a href={getLocalizedPath('/science/gpu', locale)} class="hero-cta primary">Open the full GPU showcase</a>
          <a href={getLocalizedPath('/proof', locale)} class="hero-cta secondary">See artifact-backed proof</a>
        </div>
      </div>

      <div class="gpu-proof-demo">
        <WebGPUSimulator client:visible />
      </div>
    </div>
  </div>
</section>

<style>
  .gpu-proof-shell {
    border-radius: var(--radius-2xl);
    padding: clamp(1.1rem, 3vw, 1.5rem);
    display: grid;
    gap: 1.1rem;
    background:
      radial-gradient(640px 280px at 100% 0%, color-mix(in srgb, var(--color-accent-gold) 18%, transparent), transparent 60%),
      linear-gradient(160deg, color-mix(in srgb, var(--color-bg-alt) 92%, transparent), color-mix(in srgb, #07162c 72%, transparent));
  }

  .gpu-proof-copy {
    display: grid;
    gap: 0.85rem;
  }

  .gpu-proof-kicker {
    color: var(--color-accent-gold-soft);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.72rem;
    font-weight: 700;
  }

  .gpu-proof-lead,
  .gpu-proof-body {
    color: var(--color-text-secondary);
    max-width: 62ch;
  }

  .gpu-proof-lead {
    font-size: 1rem;
  }

  .gpu-proof-body {
    font-size: 0.92rem;
  }

  .gpu-proof-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0.75rem;
    margin-top: 0.2rem;
  }

  .gpu-proof-pill {
    border-radius: var(--radius-xl);
    border: 1px solid var(--glass-border);
    background: color-mix(in srgb, var(--color-surface-frost) 88%, transparent);
    padding: 0.9rem;
    display: grid;
    gap: 0.22rem;
  }

  .gpu-proof-pill span {
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.68rem;
  }

  .gpu-proof-pill strong {
    color: var(--color-text-primary);
    font-size: 1.02rem;
  }

  .gpu-proof-pill p {
    color: var(--color-text-secondary);
    font-size: 0.8rem;
  }

  .gpu-proof-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.15rem;
  }

  .gpu-proof-demo :global(.simulator-shell) {
    margin-top: 0;
    margin-bottom: 0;
  }

  @media (min-width: 1080px) {
    .gpu-proof-shell {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      align-items: start;
    }
  }
</style>
