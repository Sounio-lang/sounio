---
import { getLocalizedPath, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const paths = [
  {
    audience: 'Researchers + technical leaders',
    title: 'Start with the claim, then inspect the evidence.',
    body: 'Use this path if you are evaluating whether Sounio is real, differentiated, and credible enough for serious attention.',
    href: '/proof',
    cta: 'See what is verified',
  },
  {
    audience: 'Hands-on developers',
    title: 'Get to a first successful run fast.',
    body: 'Use this path if you want the shortest route from installation to one bounded, real example without wading through every subsystem.',
    href: '/learn/getting-started',
    cta: 'Start with docs',
  },
  {
    audience: 'Evaluators + reviewers',
    title: 'Trace claims back to artifacts and source surfaces.',
    body: 'Use this path if you need release provenance, public contract boundaries, and machine-checked status artifacts before you trust the story.',
    href: '/releases',
    cta: 'Inspect provenance',
  },
];
---

<section class="section-shell audience-paths">
  <div class="container">
    <div class="section-headline">
      <h2 class="section-heading">Choose your route into the project.</h2>
      <p class="section-subhead">
        The site now optimizes for three serious journeys instead of trying to make every page do every job at once.
      </p>
    </div>

    <div class="audience-grid premium-grid">
      {paths.map((path) => (
        <article class="audience-card glass glass-specular">
          <span class="audience-kicker">{path.audience}</span>
          <h3>{path.title}</h3>
          <p>{path.body}</p>
          <a href={getLocalizedPath(path.href, locale)}>{path.cta}</a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .audience-grid {
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  }

  .audience-card {
    border-radius: var(--radius-xl);
    padding: 1.15rem;
    display: grid;
    gap: 0.55rem;
  }

  .audience-kicker {
    color: var(--color-accent-gold-soft);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.72rem;
    font-weight: 700;
  }

  .audience-card h3 {
    font-size: 1.22rem;
    text-wrap: balance;
  }

  .audience-card p {
    color: var(--color-text-secondary);
    font-size: 0.93rem;
  }

  .audience-card a {
    margin-top: 0.2rem;
    width: fit-content;
    color: var(--color-text-primary);
    border-bottom: 1px solid color-mix(in srgb, var(--color-accent-gold) 45%, transparent);
    padding-bottom: 0.15rem;
    font-size: 0.86rem;
    font-weight: 650;
  }
</style>
