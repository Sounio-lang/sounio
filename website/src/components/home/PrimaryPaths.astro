---
import { getLocalizedPath, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const paths = [
  {
    index: '01',
    title: 'Clinical and scientific research',
    href: '/science',
    summary: 'Follow the routes where confidence, provenance, and refusal have to survive the final threshold.',
  },
  {
    index: '02',
    title: 'Data, ML, and AI systems',
    href: '/learn/getting-started',
    summary: 'Open the current contract, install the toolchain, and see what the language can actually do today.',
  },
  {
    index: '03',
    title: 'Reviewers and evaluators',
    href: '/proof',
    summary: 'Go directly to artifacts, bounded claims, and the discipline that keeps the storefront honest.',
  },
];
---

<section class="section-shell section-deferred pt-0">
  <div class="container">
    <div class="route-rail-shell">
      <div class="route-rail-copy">
        <p class="route-rail-label">Routes</p>
        <h2 class="route-rail-title">Choose the pressure that resembles yours.</h2>
      </div>

      <div class="route-rail-grid">
        {paths.map((path) => (
          <a href={getLocalizedPath(path.href, locale)} class="route-entry group">
            <span class="route-entry-index">{path.index}</span>
            <div class="route-entry-body">
              <h3 class="route-entry-title">{path.title}</h3>
              <p class="route-entry-summary">{path.summary}</p>
            </div>
            <span class="route-entry-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .route-rail-shell {
    display: grid;
    gap: 1.35rem;
    padding: 0.2rem 0 0;
  }

  .route-rail-copy {
    display: grid;
    gap: 0.42rem;
    max-width: 42rem;
  }

  .route-rail-label {
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent-gold-soft);
  }

  .route-rail-title {
    font-size: clamp(1.4rem, 2.8vw, 2.3rem);
    line-height: 1.02;
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  .route-rail-grid {
    display: grid;
    gap: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.09);
    border-bottom: 1px solid rgba(255, 255, 255, 0.09);
  }

  .route-entry {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: start;
    gap: 0.95rem;
    padding: 1rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    transition: color var(--transition-fast), border-color var(--transition-fast), transform var(--transition-fast);
  }

  .route-entry:first-child {
    border-top: none;
  }

  .route-entry:hover {
    transform: translateX(2px);
    border-color: rgba(214, 179, 90, 0.22);
  }

  .route-entry-index {
    padding-top: 0.12rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
  }

  .route-entry-body {
    display: grid;
    gap: 0.28rem;
  }

  .route-entry-title {
    font-size: 1.02rem;
    font-weight: 600;
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  .route-entry-summary {
    max-width: 56ch;
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  .route-entry-arrow {
    padding-top: 0.1rem;
    font-size: 0.94rem;
    font-weight: 700;
    color: var(--color-accent-gold);
  }

  @media (min-width: 980px) {
    .route-rail-shell {
      grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
      align-items: start;
      gap: 2rem;
    }

    .route-rail-copy {
      position: sticky;
      top: 5.75rem;
    }
  }
</style>
