---
import { loadTranslations, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = await loadTranslations(locale);

const domains = [
  {
    title: 'Pharmacometrics',
    description: 'PK/PD modeling with MedLang DSL for drug dosage optimization and DARWIN-caliber clinical trial design.',
    accent: 'var(--color-accent-pink)',
    code: `let dose: Knowledge[f64] = Knowledge(500.0, ε=0.99, prov="iv")\nlet clearance: Knowledge[f64] = patient.renal_cl\nlet steady_state = dose / clearance`,
    iconSvg: `<rect x="4" y="9.5" width="16" height="5" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.5"/><line x1="12" y1="9.5" x2="12" y2="14.5" stroke="currentColor" stroke-width="1" stroke-linecap="round" opacity="0.55"/><circle cx="4.5" cy="6.5" r="1.25" fill="none" stroke="currentColor" stroke-width="1.25" opacity="0.6"/><circle cx="19.5" cy="6.5" r="1.25" fill="none" stroke="currentColor" stroke-width="1.25" opacity="0.6"/><circle cx="4.5" cy="17.5" r="1.25" fill="none" stroke="currentColor" stroke-width="1.25" opacity="0.6"/><circle cx="19.5" cy="17.5" r="1.25" fill="none" stroke="currentColor" stroke-width="1.25" opacity="0.6"/><line x1="5.5" y1="7.4" x2="7" y2="9.5" stroke="currentColor" stroke-width="1" stroke-linecap="round" opacity="0.4"/><line x1="18.5" y1="7.4" x2="17" y2="9.5" stroke="currentColor" stroke-width="1" stroke-linecap="round" opacity="0.4"/><line x1="5.5" y1="16.6" x2="7" y2="14.5" stroke="currentColor" stroke-width="1" stroke-linecap="round" opacity="0.4"/><line x1="18.5" y1="16.6" x2="17" y2="14.5" stroke="currentColor" stroke-width="1" stroke-linecap="round" opacity="0.4"/>`,
  },
  {
    title: 'Neuroimaging',
    description: 'fMRI pipeline analysis with confidence-gated processing and provenance tracking for reproducible neuroscience.',
    accent: 'var(--color-accent-purple)',
    code: `let voxel: Knowledge[f64] = acquire_bold(scan)\nif voxel.ε > threshold {\n    activate_region(voxel)\n}`,
    iconSvg: `<circle cx="12" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.5"/><path d="M5.5 13 L7.5 13 L8.5 9.5 L10 15 L11.5 11 L13 14 L14.5 10.5 L16 13 L18.5 13" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><line x1="5.5" y1="18" x2="18.5" y2="18" stroke="currentColor" stroke-width="1" opacity="0.3" stroke-linecap="round"/>`,
  },
  {
    title: 'Quantum Chemistry',
    description: 'VQE algorithms with uncertainty quantification for variational quantum eigensolver implementations.',
    accent: 'var(--color-accent-blue)',
    code: `let params = init_tensor()\nlet energy: Knowledge[f64] = quantum_expectation(H, params)\n// uncertainty tracked from shot noise`,
    iconSvg: `<circle cx="12" cy="12" r="1.75" fill="currentColor" opacity="0.85"/><ellipse cx="12" cy="12" rx="9.5" ry="3.5" fill="none" stroke="currentColor" stroke-width="1.25" opacity="0.7"/><ellipse cx="12" cy="12" rx="9.5" ry="3.5" fill="none" stroke="currentColor" stroke-width="1.25" transform="rotate(60 12 12)" opacity="0.55"/><ellipse cx="12" cy="12" rx="9.5" ry="3.5" fill="none" stroke="currentColor" stroke-width="1.25" transform="rotate(-60 12 12)" opacity="0.4"/><circle cx="21.5" cy="12" r="1.5" fill="currentColor"/>`,
  },
  {
    title: 'Climate Science',
    description: 'CMIP6 ensemble analysis with uncertainty propagation for robust predictions and policy-relevant confidence intervals.',
    accent: 'var(--color-accent-teal)',
    code: `let ensemble: [Knowledge[f64]] = cmip6.models\nlet projection = ensemble.consensus()\nif projection.ε < 0.90 {\n    flag_for_review(projection)\n}`,
    iconSvg: `<circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.5"/><ellipse cx="12" cy="12" rx="9" ry="3.5" fill="none" stroke="currentColor" stroke-width="1" opacity="0.4"/><line x1="12" y1="3" x2="12" y2="21" stroke="currentColor" stroke-width="1" opacity="0.3"/><path d="M5 17 L8 14 L11 16 L16 10 L19 8" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/><path d="M17 7 L19 8 L18.5 10" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>`,
  },
];
---

<section class="py-32 bg-[var(--color-surface-primary)]">
  <div class="container px-4">
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-bold text-[var(--color-text-primary)] mb-4">
        {t.domain_gallery_title ?? "Built for Scientific Discovery"}
      </h2>
      <p class="text-lg text-[var(--color-text-secondary)] max-w-2xl mx-auto">
        From drug development to quantum chemistry — every domain benefits from knowing what it doesn't know.
      </p>
    </div>

    <!-- Gallery -->
    <div class="domain-gallery">
      {domains.map((domain) => (
        <article class="domain-card glass glass-specular rounded-2xl p-8 flex flex-col" style={`--accent: ${domain.accent};`}>
          <div
            class="inline-flex items-center justify-center w-14 h-14 rounded-xl mb-6"
            style={`background: color-mix(in srgb, ${domain.accent} 10%, transparent);`}
          >
            <svg class="w-7 h-7" style={`color: ${domain.accent};`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" set:html={domain.iconSvg}></svg>
          </div>

          <h3 class="text-xl font-semibold text-[var(--color-text-primary)] mb-2">
            {domain.title}
          </h3>

          <p class="text-sm text-[var(--color-text-secondary)] mb-6 flex-1">
            {domain.description}
          </p>

          <pre class="text-xs leading-relaxed overflow-x-auto rounded-lg bg-[#0d1117] p-4 border border-[var(--glass-border)]"><code class="text-[#e6edf3]">{domain.code}</code></pre>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .domain-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  @media (max-width: 768px) {
    .domain-gallery {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 1rem;
      padding-bottom: 1rem;
      -webkit-overflow-scrolling: touch;
    }

    .domain-card {
      min-width: 320px;
      scroll-snap-align: center;
      flex-shrink: 0;
    }
  }
</style>
