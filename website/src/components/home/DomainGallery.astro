---
import { loadTranslations, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = await loadTranslations(locale);

const domains = [
  {
    title: 'Pharmacometrics',
    description: 'PK/PD modeling with MedLang DSL for drug dosage optimization and DARWIN-caliber clinical trial design.',
    accent: 'var(--color-accent-pink)',
    code: `let dose: Knowledge<mg> = measure(500.0, uncertainty: 2.5)\nlet clearance: Knowledge<L/h> = patient.renal_cl\nlet steady_state = dose / clearance`,
    icon: 'M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z',
  },
  {
    title: 'Neuroimaging',
    description: 'fMRI pipeline analysis with confidence-gated processing and provenance tracking for reproducible neuroscience.',
    accent: 'var(--color-accent-purple)',
    code: `let voxel: Knowledge<T2_star> = acquire_bold(scan)\nif voxel.confidence > threshold {\n    activate_region(voxel)\n}`,
    icon: 'M12 18v-5.25m0 0a6.01 6.01 0 001.5-.189m-1.5.189a6.01 6.01 0 01-1.5-.189m3.75 7.478a12.06 12.06 0 01-4.5 0m3.75 2.383a14.406 14.406 0 01-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 10-7.517 0c.85.493 1.509 1.333 1.509 2.316V18',
  },
  {
    title: 'Quantum Chemistry',
    description: 'VQE algorithms with uncertainty quantification for variational quantum eigensolver implementations.',
    accent: 'var(--color-accent-blue)',
    code: `@kernel\nfn vqe_step(params: &Tensor<f64, [N]>)\n    -> Knowledge<hartree> with GPU {\n    let energy = quantum::expectation(H, params)\n    energy  // uncertainty from shot noise\n}`,
    icon: 'M21 7.5l-2.25-1.313M21 7.5v2.25m0-2.25l-2.25 1.313M3 7.5l2.25-1.313M3 7.5l2.25 1.313M3 7.5v2.25m9 3l2.25-1.313M12 12.75l-2.25-1.313M12 12.75V15m0 6.75l2.25-1.313M12 21.75V19.5m0 2.25l-2.25-1.313m0-16.875L12 2.25l2.25 1.313M21 14.25v2.25l-2.25 1.313m-13.5 0L3 16.5v-2.25',
  },
  {
    title: 'Climate Science',
    description: 'CMIP6 ensemble analysis with uncertainty propagation for robust predictions and policy-relevant confidence intervals.',
    accent: 'var(--color-accent-teal)',
    code: `let ensemble: [Knowledge<celsius>; N] = cmip6.models\nlet projection = ensemble.consensus()\nif projection.confidence < 0.90 {\n    flag_for_review(projection)\n}`,
    icon: 'M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418',
  },
];
---

<section class="py-32 bg-[var(--color-surface-primary)]">
  <div class="container px-4">
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-bold text-[var(--color-text-primary)] mb-4">
        {t.domain_gallery_title ?? "Built for Scientific Discovery"}
      </h2>
      <p class="text-lg text-[var(--color-text-secondary)] max-w-2xl mx-auto">
        From drug development to quantum chemistry — every domain benefits from knowing what it doesn't know.
      </p>
    </div>

    <!-- Gallery -->
    <div class="domain-gallery">
      {domains.map((domain) => (
        <article class="domain-card glass glass-specular rounded-2xl p-8 flex flex-col" style={`--accent: ${domain.accent};`}>
          <div
            class="inline-flex items-center justify-center w-14 h-14 rounded-xl mb-6"
            style={`background: color-mix(in srgb, ${domain.accent} 10%, transparent);`}
          >
            <svg class="w-7 h-7" style={`color: ${domain.accent};`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d={domain.icon} />
            </svg>
          </div>

          <h3 class="text-xl font-semibold text-[var(--color-text-primary)] mb-2">
            {domain.title}
          </h3>

          <p class="text-sm text-[var(--color-text-secondary)] mb-6 flex-1">
            {domain.description}
          </p>

          <pre class="text-xs leading-relaxed overflow-x-auto rounded-lg bg-[#0d1117] p-4 border border-[var(--glass-border)]"><code class="text-[#e6edf3]">{domain.code}</code></pre>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .domain-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  @media (max-width: 768px) {
    .domain-gallery {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 1rem;
      padding-bottom: 1rem;
      -webkit-overflow-scrolling: touch;
    }

    .domain-card {
      min-width: 320px;
      scroll-snap-align: center;
      flex-shrink: 0;
    }
  }
</style>
