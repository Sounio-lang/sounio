---
import { getLocaleFromUrl, loadTranslations, type Locale } from '../../lib/i18n';

interface Props {
  locale?: Locale;
  tone?: 'hero' | 'doc';
}

const { locale = getLocaleFromUrl(Astro.url), tone = 'doc' } = Astro.props;
const t = await loadTranslations(locale);
---

<p class:list={['research-language-status', tone]} lang="en">{t.maturity_description}</p>

<style>
  .research-language-status {
    max-width: 62ch;
    font-size: 0.82rem;
    line-height: 1.45;
  }

  .hero {
    margin-top: 0.85rem;
    color: #e4ca85;
  }

  .doc {
    margin-top: 0.35rem;
    color: var(--color-text-secondary);
  }
</style>
