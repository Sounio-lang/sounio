---
import type { EpistemicLevel } from "../../data/artifactStatus";
import { levelColor, levelLabel, levelIcon } from "../../data/artifactStatus";

interface Props {
  level: EpistemicLevel;
  label?: string;
  showIcon?: boolean;
  size?: "sm" | "md" | "lg";
}

const { level, label, showIcon = true, size = "md" } = Astro.props;

const color = levelColor(level);
const text = label ?? levelLabel(level);
const icon = levelIcon(level);

const sizeClasses = {
  sm: "text-[0.65rem] px-2 py-0.5 gap-1",
  md: "text-[0.75rem] px-2.5 py-1 gap-1.5",
  lg: "text-[0.85rem] px-3 py-1.5 gap-2",
};
---

<span
  class:list={[
    "inline-flex items-center rounded-full border font-semibold tracking-wide uppercase",
    sizeClasses[size],
  ]}
  style={`border-color: color-mix(in srgb, ${color} 40%, transparent); background: color-mix(in srgb, ${color} 12%, transparent); color: ${color};`}
  title={text}
>
  {showIcon && <span class="opacity-90">{icon}</span>}
  <span>{text}</span>
</span>
