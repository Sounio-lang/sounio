---
import { publicContract } from "../../data/artifactStatus";
import { KineticText } from "../common/KineticText";
import { getLocaleFromUrl, getLocalizedPath } from "../../lib/i18n";

interface Props {
  heading?: string;
  subhead?: string;
  showFooterLink?: boolean;
  variant?: 'clinical' | 'technical' | 'unified';
}

const locale = getLocaleFromUrl(Astro.url);

const t = {
  en: {
    heading: "What is true right now",
    subhead: "Aligned with README.md honest status and committed gate artifacts — regenerated via npm run sync:artifacts.",
    clinicalHeading: "What clinicians can rely on today",
    clinicalSubhead: "Honest status for pharmacology and patient-safety features — not marketing claims.",
    gateLabel: "Stdlib reliability gate:",
    pass: "pass",
    fail: "fail",
    skip: "skip",
    total: "total",
    source: "source:",
    works: "Works",
    scaffolding: "Scaffolding",
    missing: "Missing",
    footerLink: "Read the full honest status in README.md →"
  },
  pt: {
    heading: "O estado real das coisas hoje",
    subhead: "Sincronizado com o estado real do README.md e artefactos de integração — atualizado via npm run sync:artifacts.",
    clinicalHeading: "O que clínicos podem confiar hoje",
    clinicalSubhead: "Estado honesto das funcionalidades de farmacologia e segurança do paciente — não promessas de marketing.",
    gateLabel: "Portão de fiabilidade da stdlib:",
    pass: "passados",
    fail: "falhas",
    skip: "ignorados",
    total: "total",
    source: "origem:",
    works: "Funcional",
    scaffolding: "Em Esboço",
    missing: "Em Falta",
    footerLink: "Ler o estado de fiabilidade completo no README.md →"
  },
  es: {
    heading: "El estado real de las cosas hoy",
    subhead: "Sincronizado con el estado real de README.md y artefactos de integración — actualizado vía npm run sync:artifacts.",
    gateLabel: "Portal de fiabilidad de stdlib:",
    pass: "pasados",
    fail: "fallos",
    skip: "omitidos",
    total: "total",
    source: "origen:",
    works: "Funcional",
    scaffolding: "En Esbozo",
    missing: "Inexistente",
    footerLink: "Leer el estado de fiabilidad completo en README.md →"
  },
  el: {
    heading: "Τι ισχύει αυτή τη στιγμή",
    subhead: "Ευθυγραμμισμένο με την ειλικρινή κατάσταση του README.md και τα τεκμήρια της πύλης — ενημερώθηκε μέσω npm run sync:artifacts.",
    gateLabel: "Πύλη αξιοπιστίας stdlib:",
    pass: "επιτυχείς",
    fail: "αποτυχίες",
    skip: "παράλειψη",
    total: "σύνολο",
    source: "πηγή:",
    works: "Λειτουργεί",
    scaffolding: "Σκαλωσιά",
    missing: "Λείπει",
    footerLink: "Διαβάστε την πλήρη ειλικρινή κατάσταση στο README.md →"
  },
  zh: {
    heading: "当前的真实状态",
    subhead: "与 README.md 的真实状态和已提交的门控产物保持一致 — 通过 npm run sync:artifacts 重新生成。",
    gateLabel: "Stdlib 可靠性门控:",
    pass: "通过",
    fail: "失败",
    skip: "跳过",
    total: "总计",
    source: "来源:",
    works: "正常运行",
    scaffolding: "脚手架/草图",
    missing: "缺失",
    footerLink: "在 README.md 中阅读完整的真实状态 →"
  },
  ja: {
    heading: "現在の真実のステータス",
    subhead: "README.md の正直なステータスおよびコミット済みのゲート成果物と同期 — npm run sync:artifacts で再生成。",
    gateLabel: "Stdlib 信頼性ゲート:",
    pass: "パス",
    fail: "失敗",
    skip: "スキップ",
    total: "合計",
    source: "ソース:",
    works: "稼働中",
    scaffolding: "足場/スタブ",
    missing: "未実装",
    footerLink: "README.md で完全な正直ステータスを読む →"
  }
};

const d = t[locale] || t.en;
const clinicalHeading = d.clinicalHeading ?? t.en.clinicalHeading;
const clinicalSubhead = d.clinicalSubhead ?? t.en.clinicalSubhead;

const {
  heading,
  subhead,
  showFooterLink = true,
  variant = 'unified',
} = Astro.props;

const clinical = variant === 'clinical';
const resolvedHeading = heading ?? (clinical ? clinicalHeading : d.heading);
const resolvedSubhead = subhead ?? (clinical ? clinicalSubhead : d.subhead);

const clinicalWorks = [
  { title: 'Vancomycin ε gate', detail: 'compile-fail fixtures reject under-confident dosing (ASHP ε ≥ 0.82)' },
  { title: 'ISO GUM propagation', detail: 'Knowledge<T> uncertainty through arithmetic in stdlib epistemic lane' },
  { title: 'PBPK dissertation demo', detail: 'browser-side rapamycin & semaglutide compartment simulation' },
];
const clinicalScaffolding = [
  { title: 'Provenance metadata', detail: 'prov strings on Knowledge<T>; full audit chain still expanding' },
  { title: 'Clinical Lean obligations', detail: 'partial formal verification; not a regulatory submission' },
];
const clinicalMissing = [
  { title: 'EHR / FHIR integration', detail: 'no live hospital connector in public artifacts' },
  { title: 'Multi-site clinical validation', detail: 'single-author research codebase, not a trial platform' },
];

const { works, scaffolding, missing } = publicContract.honestStatus;
const displayWorks = clinical ? clinicalWorks : works;
const displayScaffolding = clinical ? clinicalScaffolding : scaffolding;
const displayMissing = clinical ? clinicalMissing : missing;
const gate = publicContract.metrics.stdlibReliabilityGate;
const syncedAt = publicContract.metrics.stdlibReliabilityGate.artifact;
---

<section
  class="section-shell bg-[color-mix(in_srgb,var(--color-bg-alt)_74%,transparent)] border-y border-[var(--glass-border)]"
  {...(variant === 'clinical' ? { 'data-for-audience': 'scientist' } : variant === 'technical' ? { 'data-for-audience': 'technical' } : {})}
>
  <div class="container">
    <div class="mb-[1.7rem] grid gap-[0.45rem]">
      <KineticText text={resolvedHeading} client:visible />
      <p class="section-subhead">{resolvedSubhead}</p>
      {!clinical && (
        <p class="text-[0.78rem] text-[var(--color-text-tertiary)]">
          {d.gateLabel} {gate.pass} {d.pass} / {gate.fail} {d.fail} / {gate.skip} {d.skip} / {gate.total} {d.total}
          · {d.source} <code class="font-mono text-[0.85em]">{syncedAt}</code>
        </p>
      )}
    </div>

    <div class="grid gap-[1rem] md:grid-cols-3">
      <article class="glass rounded-[var(--radius-xl)] p-[1.1rem] grid gap-[0.8rem] border-l-[3px] border-l-[var(--color-accent-gold-soft)]">
        <h3 class="text-[0.78rem] font-[700] uppercase tracking-[0.1em] text-[var(--color-accent-gold-soft)]">
          {d.works}
        </h3>
        <ul class="grid gap-[0.55rem] text-[0.85rem] text-[var(--color-text-secondary)] list-none p-0 m-0">
          {displayWorks.map((item) => (
            <li>
              <strong class="text-[var(--color-text-primary)]">{item.title}</strong>
              {" "}— {item.detail}
            </li>
          ))}
        </ul>
      </article>

      <article class="glass rounded-[var(--radius-xl)] p-[1.1rem] grid gap-[0.8rem] border-l-[3px] border-l-[rgba(255,255,255,0.18)]">
        <h3 class="text-[0.78rem] font-[700] uppercase tracking-[0.1em] text-[var(--color-text-tertiary)]">
          {d.scaffolding}
        </h3>
        <ul class="grid gap-[0.55rem] text-[0.85rem] text-[var(--color-text-secondary)] list-none p-0 m-0">
          {displayScaffolding.map((item) => (
            <li>
              <strong class="text-[var(--color-text-primary)]">{item.title}</strong>
              {" "}— {item.detail}
            </li>
          ))}
        </ul>
      </article>

      <article class="glass rounded-[var(--radius-xl)] p-[1.1rem] grid gap-[0.8rem] border-l-[3px] border-l-[rgba(255,80,80,0.45)]">
        <h3 class="text-[0.78rem] font-[700] uppercase tracking-[0.1em] text-[rgba(255,100,100,0.8)]">
          {d.missing}
        </h3>
        <ul class="grid gap-[0.55rem] text-[0.85rem] text-[var(--color-text-secondary)] list-none p-0 m-0">
          {displayMissing.map((item) => (
            <li>
              <strong class="text-[var(--color-text-primary)]">{item.title}</strong>
              {" "}— {item.detail}
            </li>
          ))}
        </ul>
      </article>
    </div>

    {showFooterLink && (
      <p class="mt-[1.2rem] text-[0.84rem] text-[var(--color-text-tertiary)]">
        <a
          href={clinical ? getLocalizedPath('/proof#compile-fail-vancomycin', locale) : "https://github.com/sounio-lang/sounio#honest-status"}
          {...(clinical ? {} : { target: '_blank', rel: 'noopener noreferrer' })}
          class="hover:underline text-[var(--color-text-secondary)]"
        >
          {clinical ? (locale === 'pt' ? 'Ver prova clínica da vancomicina →' : 'See vancomycin clinical proof →') : d.footerLink}
        </a>
      </p>
    )}
  </div>
</section>
