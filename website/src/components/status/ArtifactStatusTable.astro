---
import { artifactStatus } from "../../data/artifactStatus";
import EpistemicBadge from "./EpistemicBadge.astro";

interface Props {
  category: "compiler" | "stdlib";
  title: string;
}

const { category, title } = Astro.props;
const entries = Object.entries(artifactStatus[category]);
---

<div class="glass rounded-xl overflow-hidden">
  <div class="px-5 py-4 border-b border-[var(--glass-border)] flex items-center justify-between">
    <h3 class="text-lg font-bold tracking-tight">{title}</h3>
    <span class="text-[0.7rem] text-[var(--color-text-tertiary)] uppercase tracking-wider">
      Synced from {artifactStatus.repoPath}
    </span>
  </div>

  <div class="divide-y divide-[var(--glass-border)]">
    {entries.map(([, entry]) => (
      <div class="px-5 py-4 flex items-start justify-between gap-4">
        <div class="min-w-0">
          <div class="flex items-center gap-2.5 mb-1">
            <span class="font-semibold text-[var(--color-text-primary)]">{entry.label}</span>
            <EpistemicBadge level={entry.level} size="sm" />
          </div>
          <p class="text-[0.82rem] text-[var(--color-text-secondary)] leading-relaxed">{entry.reason}</p>
          {entry.lanes && entry.lanes.length > 0 && (
            <div class="mt-2.5 flex flex-wrap gap-2">
              {entry.lanes.map((lane) => (
                <EpistemicBadge level={lane.level} label={lane.label} size="sm" showIcon={false} />
              ))}
            </div>
          )}
        </div>
      </div>
    ))}
  </div>

  <div class="px-5 py-2.5 border-t border-[var(--glass-border)] bg-[rgba(255,255,255,0.02)]">
    <p class="text-[0.7rem] text-[var(--color-text-tertiary)]">
      Generated {artifactStatus.generatedAt}
    </p>
  </div>
</div>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    document.querySelectorAll<HTMLElement>('.divide-y').forEach((list) => {
      const rows = list.querySelectorAll(':scope > div');
      if (!rows.length) return;
      gsap.from(rows, {
        y: 12, opacity: 0, stagger: 0.06, duration: 0.45, ease: 'power2.out',
        scrollTrigger: { trigger: list, start: 'top 78%', once: true },
      });
    });
  });
</script>
