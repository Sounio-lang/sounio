---
import {
  receiptHref,
  receiptLabel,
  type ReceiptKey,
} from '../../lib/honestyReceipts';

interface Props {
  of: ReceiptKey;
  prefer?: 'pr' | 'doc';
  class?: string;
}

const { of: key, prefer = 'pr', class: className } = Astro.props;
const href = receiptHref(key, prefer);
const label = receiptLabel(key);
---

<a
  class:list={['d-receipt', className]}
  href={href}
  rel="noopener noreferrer"
  data-receipt={key}
  title={label}
>
  <slot />
  <span class="d-receipt-id">{label}</span>
</a>

<style>
  .d-receipt {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, currentColor 35%, transparent);
    text-underline-offset: 0.18em;
  }

  .d-receipt:hover {
    color: var(--color-accent-gold);
    border-bottom-color: var(--color-accent-gold);
  }

  .d-receipt-id {
    margin-left: 0.28em;
    font-size: 0.62em;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
  }

  .d-receipt:hover .d-receipt-id {
    color: var(--color-accent-gold);
  }
</style>
