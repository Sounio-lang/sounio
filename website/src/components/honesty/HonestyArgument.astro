---
import { KnowledgeRefusalMeter } from '../epistemic/KnowledgeRefusalMeter';
import { E250DiagnosticCodeBlock } from '../epistemic/DiagnosticCodeBlock';
import { EffectLatticeBadge } from '../epistemic/EffectLatticeBadge';
import { EpistemicGateCard } from '../epistemic/EpistemicGateCard';
import { FabricatedDatum } from '../epistemic/FabricatedDatum';
import FabricatedDatumExhibit from './FabricatedDatumExhibit.astro';
import DissertationNowPanel from './DissertationNowPanel.astro';
import DissertationFailMap from './DissertationFailMap.astro';
import { getLocalizedPath } from '../../lib/i18n';
import type { Locale } from '../../lib/i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;

type Copy = {
  kicker: string;
  heading: string;
  lede: string;
  spine: [string, string, string];
  morningK: string;
  morningH: string;
  morningB: string;
  afternoonK: string;
  afternoonH: string;
  afternoonB: string;
  nightK: string;
  nightH: string;
  nightB: string;
  coda: string;
  language: string;
  compiler: string;
  proof: string;
};

const copy: Record<string, Copy> = {
  en: {
    kicker: '17–18 August 2026',
    heading: 'The model was wrong. The compiler was not. The silent zero was the lie.',
    lede: 'One day. Subject reduction failed in the Lean calculus. Refusal became an instrument and found two fabricating sites. By midnight four independent lanes had named the same absence on four surfaces.',
    spine: [
      'Morning — EpistemicEffects.lean lost subject reduction. check.sio kept the payload type. The compiler was right.',
      'Afternoon — a well-typed program returns a value or refuses. Used as an instrument, that statement found abs() + 1 still typed as i64, and an empty stub still readable as 0.',
      'Night — pin_count, CALL, the visual state, and the reclamation wall: a plausible value where absence should have been declared.',
    ],
    morningK: 'Morning · the model',
    morningH: 'Subject reduction was false. That is a fact about the calculus, not about Madaros.',
    morningB:
      '#1772 proved a preservation counterexample. #1779 recorded the ruling: measure collapsing its payload to Real is a defect in EpistemicEffects.lean, not a design choice in the language. The checker (`checker_check_measure_expr_inplace`) puts the argument’s own type into ty_knowledge — measure of a Nat is Knowledge<Nat>. CLAUDE.md already said measure() yields Knowledge<mg>. #1780 then gated the correspondence and left the refuted V1 model under a banner. Do not cite EpistemicEffects.lean as metatheory. It is a refuted model.',
    afternoonK: 'Afternoon · the instrument',
    afternoonH: 'A well-typed program refuses. The proof, used as a lamp, found two sites that still fabricated.',
    afternoonB:
      '#1788 proved, in the E219 fragment and with no sorry, refusal_is_not_zero and well_typed_value_or_refuse. That file is a model. It does not prove check.sio implements the model — the gate stops at E4 and says so. The same afternoon the model was turned on the compiler: #1801 closed the two sites that still fabricated after a refusal. abs() + 1 is ty_error(), not i64. An empty IR stub emits ud2, not a fall-through 0. lean_single still has no E219. A vancomycin Cmin band that is not inside [10, 20] is PRE_REFUSE — the same thesis, on a dose.',
    nightK: 'Night · the same absence',
    nightH: 'Four lanes. One class. A plausible value where a declared absence belonged.',
    nightB:
      'By 01:00 UTC on 18 August, #1830, #1825, #1829 and #1823 had landed from four lanes that did not share a write-set. pin_count was read as 0 live pins; the emitter never increments it — the sentinel is now −1, UNWIRED. CALL was refused only as an unknown opcode; it now has a name, MLI_I_CALL_UNSPECIFIED, and has_value=false. FabricatedDatum gave the fifth epistemic state a face. The reclamation wall shipped its witness before the fix: the gate is intentionally red at 4,194,304 allocations (rc=182). #1792 remains open on the dissertation surface. The class is not closed. It is finally visible.',
    coda: 'This page is the day, not a catalogue of controls. The five instruments appear where the story needs them.',
    language: 'Language — types and E250',
    compiler: 'Compiler — effect lattice',
    proof: 'Proof — gate ladder',
  },
  pt: {
    kicker: '17–18 de agosto de 2026',
    heading: 'O modelo estava errado. O compilador não. O zero silencioso era a mentira.',
    lede: 'Um dia. A subject reduction falhou no cálculo Lean. A recusa virou instrumento e achou dois sítios que fabricavam. À meia-noite, quatro lanes independentes tinham nomeado a mesma ausência em quatro superfícies.',
    spine: [
      'Manhã — EpistemicEffects.lean perdeu subject reduction. check.sio manteve o tipo do payload. O compilador estava certo.',
      'Tarde — um programa bem tipado devolve um valor ou recusa. Usada como instrumento, essa frase encontrou abs() + 1 ainda tipado como i64, e um stub vazio ainda legível como 0.',
      'Noite — pin_count, CALL, o estado visual e o muro de reclamation: um valor plausível onde a ausência devia ser declarada.',
    ],
    morningK: 'Manhã · o modelo',
    morningH: 'A subject reduction era falsa. Isso é um facto do cálculo, não do Madaros.',
    morningB:
      'O #1772 provou um contra-exemplo de preservação. O #1779 registou o veredicto: measure a colapsar o payload para Real é um defeito de EpistemicEffects.lean, não uma escolha da linguagem. O checker (`checker_check_measure_expr_inplace`) mete o tipo do argumento em ty_knowledge — measure de um Nat é Knowledge<Nat>. O CLAUDE.md já dizia que measure() rende Knowledge<mg>. O #1780 fechou a correspondência e deixou o modelo V1 refutado sob um aviso. Não cites EpistemicEffects.lean como metateoria. É um modelo refutado.',
    afternoonK: 'Tarde · o instrumento',
    afternoonH: 'Um programa bem tipado recusa. A prova, usada como lâmpada, achou dois sítios que ainda fabricavam.',
    afternoonB:
      'O #1788 provou, no fragmento E219 e sem sorry, refusal_is_not_zero e well_typed_value_or_refuse. Esse ficheiro é um modelo. Não prova que check.sio o implementa — o portão pára em E4 e diz-o. A mesma tarde o modelo foi virado contra o compilador: o #1801 fechou os dois sítios que ainda fabricavam depois de uma recusa. abs() + 1 é ty_error(), não i64. Um stub IR vazio emite ud2, não um 0 por queda. O lean_single continua sem E219. Uma banda de Cmin de vancomicina que não está dentro de [10, 20] é PRE_REFUSE — a mesma tese, numa dose.',
    nightK: 'Noite · a mesma ausência',
    nightH: 'Quatro lanes. Uma classe. Um valor plausível onde pertencia uma ausência declarada.',
    nightB:
      'Às 01:00 UTC de 18 de agosto, #1830, #1825, #1829 e #1823 tinham aterrado de quatro lanes que não partilhavam write-set. pin_count era lido como 0 pins vivos; o emissor nunca o incrementa — o sentinela é agora −1, UNWIRED. CALL era recusada só como opcode desconhecido; agora tem nome, MLI_I_CALL_UNSPECIFIED, e has_value=false. O FabricatedDatum deu cara ao quinto estado. O muro de reclamation embarcou a testemunha antes do conserto: o gate está vermelho de propósito aos 4 194 304 allocations (rc=182). O #1792 continua aberto na superfície da dissertação. A classe não está fechada. Está, finalmente, visível.',
    coda: 'Esta página é o dia, não um catálogo de controlos. Os cinco instrumentos aparecem onde a história precisa deles.',
    language: 'Linguagem — tipos e E250',
    compiler: 'Compilador — reticulado de efeitos',
    proof: 'Prova — escada de portões',
  },
};

const d = copy[locale] ?? copy.en;
---

<article class="honesty">
  <DissertationNowPanel locale={locale} />
  <DissertationFailMap locale={locale} />

  <header class="honesty-hero">
    <p class="honesty-kicker">{d.kicker}</p>
    <h1 class="honesty-heading">{d.heading}</h1>
    <p class="honesty-lede">{d.lede}</p>
    <ol class="honesty-spine">
      {d.spine.map((line, i) => (
        <li>
          <span class="honesty-spine-n">0{i + 1}</span>
          <span>{line}</span>
        </li>
      ))}
    </ol>
  </header>

  <section class="honesty-act" id="morning" aria-labelledby="honesty-morning">
    <p class="honesty-act-kicker" id="honesty-morning">{d.morningK}</p>
    <h2 class="honesty-act-heading">{d.morningH}</h2>
    <p class="honesty-act-body">{d.morningB}</p>

    <div class="honesty-pair">
      <figure class="honesty-panel">
        <figcaption class="honesty-panel-cap">
          EffectLatticeBadge · why the compiler was right
        </figcaption>
        <p class="honesty-sig" aria-label="fn measure takes T and returns Knowledge of T with Observe">
          <span class="honesty-kw">fn</span>
          <span class="honesty-name">measure</span>
          <span class="honesty-plain">(x: T) -&gt; Knowledge&lt;T&gt;</span>
          <span class="honesty-kw">with</span>
          <EffectLatticeBadge effect="Observe" purityLevel="Declared" size="md" />
        </p>
        <p class="honesty-src">
          checker_check_measure_expr_inplace keeps T. The refuted calculus typed every kraw as Knowledge&lt;Real&gt;
          and discarded the measured value. A unit type cannot survive that collapse.
        </p>
      </figure>

      <figure class="honesty-panel">
        <figcaption class="honesty-panel-cap">
          EpistemicGateCard · #1779 · db750980b4
        </figcaption>
        <EpistemicGateCard
          claim="EpistemicEffects.lean has subject reduction"
          ceiling="E4"
          verdict="REFUSED"
          reason="Preservation is false for that calculus (#1772). measure collapsing the payload to Real contradicts the spec and check.sio. The nearest weakening also fails: the corruption propagates through application. This is a refuted model, not metatheory. E5 is unreached."
          sha="db750980b4"
          href="https://github.com/Sounio-lang/sounio/pull/1779"
          hrefLabel="PR #1779"
        />
      </figure>
    </div>
  </section>

  <section class="honesty-act" id="afternoon" aria-labelledby="honesty-afternoon">
    <p class="honesty-act-kicker" id="honesty-afternoon">{d.afternoonK}</p>
    <h2 class="honesty-act-heading">{d.afternoonH}</h2>
    <p class="honesty-act-body">{d.afternoonB}</p>

    <div class="honesty-pair">
      <figure class="honesty-panel">
        <figcaption class="honesty-panel-cap">
          EpistemicGateCard · #1788 · 31adf7b4bc
        </figcaption>
        <EpistemicGateCard
          claim="check.sio implements well_typed_value_or_refuse"
          ceiling="E4"
          verdict="UNBOUNDED"
          reason="SounioRefusalHonesty.lean proves the E219 fragment with no sorry. The file itself says that is a model, not a proof that check.sio implements the model. Citing the theorem as a compiler proof is empirical extrapolation. E5 is unreached."
          sha="31adf7b4bc"
          href="https://github.com/Sounio-lang/sounio/blob/31adf7b4bc/formal/lean4/SounioRefusalHonesty.lean"
          hrefLabel="SounioRefusalHonesty.lean"
        />
      </figure>

      <figure class="honesty-panel">
        <figcaption class="honesty-panel-cap">
          EpistemicGateCard · #1801 · 2ab2de46cf
        </figcaption>
        <EpistemicGateCard
          claim="abs() + 1 is not i64; empty stub is ud2"
          ceiling="E1"
          verdict="TRUSTWORTHY"
          reason="The afternoon theorem, turned on the compiler, closed two sites of the same class. add_refuse_l: the checker returns ty_error() instead of the declared i64. Empty non-builtin stubs emit ud2. lean_single still has no E219. Two sites, not subject reduction for the whole compiler."
          sha="2ab2de46cf"
          href="https://github.com/Sounio-lang/sounio/pull/1801"
          hrefLabel="PR #1801"
        />
      </figure>
    </div>

    <div class="honesty-pair">
      <figure class="honesty-panel">
        <figcaption class="honesty-panel-cap">
          DiagnosticCodeBlock · E250 in full
        </figcaption>
        <E250DiagnosticCodeBlock />
      </figure>

      <figure class="honesty-panel">
        <figcaption class="honesty-panel-cap">
          KnowledgeRefusalMeter · #1797 · PRE_REFUSE
        </figcaption>
        <KnowledgeRefusalMeter
          signature="cmin: Knowledge<mg/L>"
          boundLow={9.052178}
          boundHigh={24.298861}
          variance={0}
          varianceCalibrated={false}
          unit="mg/L"
          provenance="pre-TDM · 78.5 kg · CrCl 65 · 1000 mg q12h"
          state="refused"
          windowLow={10}
          windowHigh={20}
          guard="where band ⊂ [10, 20] mg/L"
          diagnostic="PRE_REFUSE. Fréchet support [9.05, 24.30] is not inside the therapeutic window. Refusal is the successful outcome — the same afternoon thesis, on a dose."
        />
      </figure>
    </div>
  </section>

  <section class="honesty-act" id="night" aria-labelledby="honesty-night">
    <p class="honesty-act-kicker" id="honesty-night">{d.nightK}</p>
    <h2 class="honesty-act-heading">{d.nightH}</h2>
    <p class="honesty-act-body">{d.nightB}</p>

    <div class="honesty-pair">
      <figure class="honesty-panel">
        <figcaption class="honesty-panel-cap">
          FabricatedDatum · #1830 · pin_count
        </figcaption>
        <FabricatedDatum
          kind="silent-zero"
          signature="runtime_context.pin_count"
          printed="0"
          actual="-1"
          printedLabel="Read as zero live pins"
          actualLabel="Sentinel UNWIRED"
          reason="The live x86_linux emitter never increments pin_count. Readers treated 0 as a measurement. #1830 writes −1 (runtime_context_pin_count_unwired) and pin_registry_ready: false. Same class as var=0.000000. Does not implement reclaim."
          sha="465008a76b"
          href="https://github.com/Sounio-lang/sounio/pull/1830"
          hrefLabel="PR #1830"
        />
      </figure>

      <div class="honesty-stack">
        <figure class="honesty-panel">
          <figcaption class="honesty-panel-cap">
            EpistemicGateCard · #1825 · CALL named
          </figcaption>
          <EpistemicGateCard
            claim="An unspecified CALL is an unknown opcode"
            ceiling="E1"
            verdict="TRUSTWORTHY"
            reason="CALL was refused only by the unknown-op catch-all, so a specified-but-unpinned ABI looked like a missing case — the #1801 empty-stub class. Interp now returns MLI_I_CALL_UNSPECIFIED (14) and has_value=false. A genuinely unknown opcode stays I5."
            sha="f5239e228a"
            href="https://github.com/Sounio-lang/sounio/pull/1825"
            hrefLabel="PR #1825"
          />
        </figure>
        <figure class="honesty-panel">
          <figcaption class="honesty-panel-cap">
            EpistemicGateCard · #1823 · witness before the fix
          </figcaption>
          <EpistemicGateCard
            claim="Handle reclamation at 2^22 allocations"
            ceiling="E1"
            verdict="REFUSED"
            reason="The product is the before-state. At 1,000,000 allocations the control holds. At 4,194,304 the fixture fail-closes with rc=182 (POSITIVE_CONTROL_FIRED). A reclamation patch is accepted only when the same gate prints HANDLE_RECLAMATION_OK. Absence declared, not a silent green."
            sha="40545fba4c"
            href="https://github.com/Sounio-lang/sounio/pull/1823"
            hrefLabel="PR #1823"
          />
        </figure>
      </div>
    </div>
  </section>

  <FabricatedDatumExhibit locale={locale} />

  <footer class="honesty-coda">
    <p>{d.coda}</p>
    <nav class="honesty-coda-nav" aria-label="Related pages">
      <a href={getLocalizedPath('/language', locale)}>{d.language}</a>
      <a href={getLocalizedPath('/compiler', locale)}>{d.compiler}</a>
      <a href={getLocalizedPath('/proof', locale)}>{d.proof}</a>
    </nav>
  </footer>
</article>

<style>
  .honesty {
    --honesty-rule: var(--color-border-hairline);
    max-width: 1120px;
    margin: 0 auto;
    padding: clamp(3rem, 8vw, 5.5rem) 1.5rem clamp(4rem, 8vw, 6rem);
    display: grid;
    gap: clamp(3rem, 6vw, 4.5rem);
  }

  .honesty-hero {
    display: grid;
    gap: 1rem;
    max-width: 48rem;
  }

  .honesty-kicker,
  .honesty-act-kicker,
  .honesty-panel-cap {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .honesty-kicker {
    color: var(--color-accent-teal);
  }

  .honesty-heading {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.6vw, 3.15rem);
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -0.018em;
    color: var(--color-text-primary);
  }

  .honesty-lede,
  .honesty-act-body,
  .honesty-src,
  .honesty-coda p {
    margin: 0;
    max-width: 70ch;
    font-size: 0.98rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  .honesty-spine {
    list-style: none;
    margin: 1.1rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.65rem;
    border-top: 1px solid var(--honesty-rule);
    padding-top: 1.1rem;
  }

  .honesty-spine li {
    display: grid;
    grid-template-columns: 2.1rem 1fr;
    gap: 0.75rem;
    align-items: start;
    color: var(--color-text-primary);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .honesty-spine-n {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--color-accent-gold);
    padding-top: 0.2rem;
  }

  .honesty-act {
    display: grid;
    gap: 0.85rem;
  }

  .honesty-act-kicker {
    color: var(--color-text-tertiary);
  }

  #morning .honesty-act-kicker {
    color: var(--color-epistemic-uncertain-text);
  }

  #afternoon .honesty-act-kicker {
    color: var(--color-epistemic-verified-text);
  }

  #night .honesty-act-kicker {
    color: var(--color-epistemic-refused-text);
  }

  .honesty-act-heading {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.6vw, 1.85rem);
    font-weight: 400;
    line-height: 1.25;
    color: var(--color-text-primary);
  }

  .honesty-pair {
    display: grid;
    gap: 1rem;
    margin-top: 0.4rem;
  }

  @media (min-width: 880px) {
    .honesty-pair {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  .honesty-stack {
    display: grid;
    gap: 1rem;
  }

  .honesty-panel {
    margin: 0;
    padding: 0.85rem;
    border: 1px solid var(--color-border-subtle);
    background: var(--color-surface-primary);
    border-radius: var(--radius-lg);
    display: grid;
    gap: 0.75rem;
    min-width: 0;
  }

  .honesty-panel-cap {
    color: var(--color-text-tertiary);
  }

  .honesty-sig {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--color-text-primary);
  }

  .honesty-kw {
    color: var(--color-accent-teal);
  }

  .honesty-name {
    color: var(--color-text-primary);
    font-weight: 650;
  }

  .honesty-plain {
    color: var(--color-text-secondary);
  }

  .honesty-src {
    font-size: 0.82rem;
    color: var(--color-text-tertiary);
  }

  .honesty-src code {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-text-secondary);
  }

  .honesty-coda {
    display: grid;
    gap: 0.9rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--honesty-rule);
  }

  .honesty-coda-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .honesty-coda-nav a {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-primary);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-full);
    padding: 0.42rem 0.75rem;
    background: var(--color-surface-secondary);
    transition: border-color var(--transition-fast), color var(--transition-fast);
  }

  .honesty-coda-nav a:hover {
    border-color: color-mix(in srgb, var(--color-accent-gold) 55%, transparent);
    color: var(--color-accent-gold);
  }
</style>
