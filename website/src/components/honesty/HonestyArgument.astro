---
import { KnowledgeRefusalMeter } from '../epistemic/KnowledgeRefusalMeter';
import { E219DiagnosticCodeBlock } from '../epistemic/DiagnosticCodeBlock';
import { EffectLatticeBadge } from '../epistemic/EffectLatticeBadge';
import { EpistemicGateCard } from '../epistemic/EpistemicGateCard';
import FabricatedDatumExhibit from './FabricatedDatumExhibit.astro';
import { getLocalizedPath } from '../../lib/i18n';
import type { Locale } from '../../lib/i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;

const copy: Record<
  string,
  {
    kicker: string;
    heading: string;
    lede: string;
    spine: [string, string, string];
    act1k: string;
    act1h: string;
    act1b: string;
    act2k: string;
    act2h: string;
    act2b: string;
    act3k: string;
    act3h: string;
    act3b: string;
    coda: string;
    language: string;
    compiler: string;
    proof: string;
  }
> = {
  en: {
    kicker: 'The argument',
    heading: 'Types have content. Refusal is a result. Fabrication, when it happens, is visible.',
    lede: 'Five states. The fifth is the one that used to look like a given.',
    spine: [
      'A signature carries effects and doubt, not just a return type.',
      'A well-typed program returns a value, or it refuses. It does not invent a zero.',
      'When a backend still fabricates, one control refuses the numeral; another shows both faces.',
    ],
    act1k: '01 · Types have content',
    act1h: 'The checker reads colour and ε before you read the name.',
    act1b: 'Nine algebraic effects live in the signature. Knowledge arrives as a support band, not a point. Pre-TDM vancomycin Cmin [9.052178, 24.298861] is not inside [10, 20] mg/L. PRE_REFUSE. Variance in that source is left uncalibrated; the meter will not print var=0.000.',
    act2k: '02 · Refusal is desirable',
    act2h: 'E219 refuses the call. The help text is 333 characters. None of it is cut.',
    act2b: '#1794 counted 33 user-facing diagnostics over the old 127-character print cap — every one was cut. E219 lost 206 characters mid-word. #1788 then proved, in the E219 fragment and with no sorry, that a well-typed program produces a value or refuses. That Lean file is a model, not a proof that check.sio implements the model. The gate stops at E4 and says so.',
    act3k: '03 · Fabrication is visible',
    act3h: 'Two sites closed. One case still measured in the open.',
    act3b: '#1801 made refusal infect the expression: abs() + 1 is ty_error(), not i64, and an empty IR stub emits ud2 instead of falling through to 0. lean_single still has no E219. #1792 is the remaining dissertation-surface case: Madaros printed var(blood)=0.000000 against lean_single ~1e-5, and printed AUC confidence 4604219396932172800 — the IEEE bits of 0.671038 as an integer. The meter refuses that integer as ε. The PR makes the shape fail-closed. It does not claim the compiler ABI is fixed.',
    coda: 'The first four controls appear on /language, /compiler, /proof, and the home meter. FabricatedDatum is the fifth state — the one that used to have no face.',
    language: 'Language — types and E219',
    compiler: 'Compiler — effect lattice',
    proof: 'Proof — gate ladder',
  },
  pt: {
    kicker: 'O argumento',
    heading: 'Os tipos têm conteúdo. A recusa é um resultado. A fabricação, quando acontece, é visível.',
    lede: 'Cinco estados. O quinto é o que parecia um dado.',
    spine: [
      'A assinatura carrega efeitos e dúvida, não só um tipo de retorno.',
      'Um programa bem tipado devolve um valor, ou recusa. Não inventa um zero.',
      'Quando o backend ainda fabrica, um controlo recusa o numeral; outro mostra as duas caras.',
    ],
    act1k: '01 · Os tipos têm conteúdo',
    act1h: 'O checker lê a cor e o ε antes de leres o nome.',
    act1b: 'Nove efeitos algébricos vivem na assinatura. Knowledge chega como banda de suporte, não como ponto. O Cmin pré-TDM da vancomicina [9.052178, 24.298861] não está dentro de [10, 20] mg/L. PRE_REFUSE. A variância nessa fonte fica por calibrar; o medidor não imprime var=0.000.',
    act2k: '02 · A recusa é desejável',
    act2h: 'E219 recusa a chamada. O texto de ajuda tem 333 caracteres. Nenhum é cortado.',
    act2b: 'O #1794 contou 33 diagnósticos acima do tecto antigo de 127 caracteres — todos cortados. O E219 perdeu 206 caracteres a meio da palavra. O #1788 provou, no fragmento E219 e sem sorry, que um programa bem tipado produz valor ou recusa. Esse ficheiro Lean é um modelo, não a prova de que check.sio o implementa. O portão pára em E4 e diz-o.',
    act3k: '03 · A fabricação é visível',
    act3h: 'Dois sítios fechados. Um caso ainda medido, em aberto.',
    act3b: 'O #1801 fez a recusa infectar a expressão: abs() + 1 é ty_error(), não i64, e um stub IR vazio emite ud2 em vez de cair para 0. O lean_single continua sem E219. O #1792 é o caso que resta na superfície da dissertação: o Madaros imprimiu var(blood)=0.000000 contra ~1e-5 no lean_single, e imprimiu confiança AUC 4604219396932172800 — os bits IEEE de 0.671038 como inteiro. O medidor recusa esse inteiro como ε. O PR torna a forma fail-closed. Não afirma que o ABI do compilador está corrigido.',
    coda: 'Os primeiros quatro controlos aparecem em /language, /compiler, /proof e no medidor da entrada. FabricatedDatum é o quinto estado — o que não tinha cara.',
    language: 'Linguagem — tipos e E219',
    compiler: 'Compilador — reticulado de efeitos',
    proof: 'Prova — escada de portões',
  },
  es: {
    kicker: 'El argumento',
    heading: 'Los tipos tienen contenido. La negativa es un resultado. La fabricación, cuando ocurre, se ve.',
    lede: 'Cinco estados. El quinto parecía un dato.',
    spine: [
      'La firma carga efectos y duda, no solo un tipo de retorno.',
      'Un programa bien tipado devuelve un valor, o se niega. No inventa un cero.',
      'Si el backend aún fabrica, el control imprime la forma — no el numeral falso.',
    ],
    act1k: '01 · Los tipos tienen contenido',
    act1h: 'El checker lee el color y ε antes de que leas el nombre.',
    act1b: 'Nueve efectos algebraicos viven en la firma. Knowledge llega como banda, no como punto. El Cmin pre-TDM [9.052178, 24.298861] ⊄ [10, 20] mg/L. PRE_REFUSE.',
    act2k: '02 · La negativa es deseable',
    act2h: 'E219 rechaza la llamada. La ayuda tiene 333 caracteres. No se corta ninguno.',
    act2b: '#1794 contó 33 diagnósticos sobre el tope de 127. #1788 prueba el fragmento E219 sin sorry — un modelo, no una prueba de que check.sio lo implementa.',
    act3k: '03 · La fabricación es visible',
    act3h: 'Dos sitios cerrados. Un caso aún medido, abierto.',
    act3b: '#1801 infecta la expresión y emite ud2 en stubs vacíos. #1792 (abierto) midió var=0.000000 y la confianza 4604219396932172800. El medidor no imprime ese entero como ε.',
    coda: 'FabricatedDatum es el quinto estado — el que no tenía cara.',
    language: 'Lenguaje — tipos y E219',
    compiler: 'Compilador — retículo de efectos',
    proof: 'Prueba — escalera de puertas',
  },
  el: {
    kicker: 'Το επιχείρημα',
    heading: 'Οι τύποι έχουν περιεχόμενο. Η άρνηση είναι αποτέλεσμα. Η κατασκευή, όταν συμβαίνει, φαίνεται.',
    lede: 'Πέντε καταστάσεις. Η πέμπτη έμοιαζε με δεδομένο.',
    spine: [
      'Η υπογραφή κουβαλά effects και αμφιβολία.',
      'Ένα καλά τυποποιημένο πρόγραμμα επιστρέφει τιμή, ή αρνείται.',
      'Όταν ο backend κατασκευάζει, το control τυπώνει το σχήμα — όχι τον ψεύτικο αριθμό.',
    ],
    act1k: '01 · Οι τύποι έχουν περιεχόμενο',
    act1h: 'Ο checker διαβάζει χρώμα και ε πριν διαβάσεις το όνομα.',
    act1b: 'Το pre-TDM Cmin [9.052178, 24.298861] ⊄ [10, 20] mg/L. PRE_REFUSE.',
    act2k: '02 · Η άρνηση είναι επιθυμητή',
    act2h: 'Το E219 αρνείται την κλήση. 333 χαρακτήρες, κανένας κομμένος.',
    act2b: 'Το #1794 μέτρησε 33 διαγνωστικά πάνω από τους 127. Το #1788 είναι μοντέλο E219, όχι απόδειξη ότι το check.sio το υλοποιεί.',
    act3k: '03 · Η κατασκευή είναι ορατή',
    act3h: 'Δύο σημεία κλειστά. Μία περίπτωση ακόμη ανοιχτή.',
    act3b: 'Το #1801 κλείνει δύο θέσεις κατασκευής. Το #1792 μέτρησε var=0.000000 και εμπιστοσύνη 4604219396932172800.',
    coda: 'Το FabricatedDatum είναι η πέμπτη κατάσταση.',
    language: 'Γλώσσα — τύποι και E219',
    compiler: 'Μεταγλωττιστής — πλέγμα effects',
    proof: 'Απόδειξη — κλίμακα πυλών',
  },
  zh: {
    kicker: '论点',
    heading: '类型有内容。拒绝是结果。伪造一旦发生，必须看得见。',
    lede: '五个状态。第五个曾经看起来像给定值。',
    spine: [
      '签名带着效应和怀疑，不只是返回类型。',
      '良类型程序给出值，或拒绝。它不伪造零。',
      '后端若仍伪造，控件打印的是形状，不是假数字。',
    ],
    act1k: '01 · 类型有内容',
    act1h: '检查器先读颜色和 ε，再读名字。',
    act1b: '治疗前万古霉素 Cmin [9.052178, 24.298861] 不在 [10, 20] mg/L 内。PRE_REFUSE。',
    act2k: '02 · 拒绝是可取的',
    act2h: 'E219 拒绝这次调用。帮助文本 333 字符，一个都不截。',
    act2b: '#1794 统计 33 条超 127 字符的诊断，全部被截。#1788 是 E219 模型，不是 check.sio 已实现该模型的证明。',
    act3k: '03 · 伪造看得见',
    act3h: '两处已关。一处仍在测量、仍开放。',
    act3b: '#1801 让拒绝感染表达式，空 stub 发 ud2。#1792 测到 var=0.000000 与置信度 4604219396932172800。',
    coda: 'FabricatedDatum 是第五态。',
    language: '语言 — 类型与 E219',
    compiler: '编译器 — 效应格',
    proof: '证明 — 门阶梯',
  },
  ja: {
    kicker: '論証',
    heading: '型には中身がある。拒否は結果である。捏造が起きれば、見える。',
    lede: '五つの状態。五つ目は与えられた値に見えていた。',
    spine: [
      'シグネチャは効果と疑念を運ぶ。戻り値の型だけではない。',
      '正しく型付けされたプログラムは値を返すか、拒む。ゼロを捏造しない。',
      'バックエンドがまだ捏造するなら、コントロールは形を刷る。偽の数字ではない。',
    ],
    act1k: '01 · 型には中身がある',
    act1h: '検査器は名前より先に色と ε を読む。',
    act1b: 'TDM前のバンコマイシンCmin [9.052178, 24.298861] は [10, 20] mg/L に入らない。PRE_REFUSE。',
    act2k: '02 · 拒否は望ましい',
    act2h: 'E219 はその呼び出しを拒む。ヘルプは 333 文字。一切切らない。',
    act2b: '#1794 は 127 文字超の診断 33 件を数えた。#1788 は E219 のモデルであり、check.sio がそのモデルを実装した証明ではない。',
    act3k: '03 · 捏造は見える',
    act3h: '二箇所は閉じた。一件はまだ測定され、開いている。',
    act3b: '#1801 は拒否を式に感染させ、空 stub は ud2 を出す。#1792 は var=0.000000 と信頼度 4604219396932172800 を測った。',
    coda: 'FabricatedDatum が第五の状態だ。',
    language: '言語 — 型と E219',
    compiler: 'コンパイラ — 効果格子',
    proof: '証明 — ゲートの梯子',
  },
};

const localeCopy = copy[locale] ?? (locale === 'zh-hk' ? copy.zh : copy.en);

// Madaros printed 4604219396932172800 — larger than 2^53, so it cannot be a
// JS integer literal. Any non-unit ε with uncalibrated variance 0 is the
// fabrication shape; the exact digits stay in the diagnostic string.
const FABRICATED_EPSILON_STAND_IN = 2;
---

<article class="honesty">
  <header class="honesty-hero">
    <p class="honesty-kicker">{localeCopy.kicker}</p>
    <h1 class="honesty-heading">{localeCopy.heading}</h1>
    <p class="honesty-lede">{localeCopy.lede}</p>
    <ol class="honesty-spine">
      {localeCopy.spine.map((line, i) => (
        <li>
          <span class="honesty-spine-n">0{i + 1}</span>
          <span>{line}</span>
        </li>
      ))}
    </ol>
  </header>

  <section class="honesty-act" id="types" aria-labelledby="honesty-act1">
    <p class="honesty-act-kicker" id="honesty-act1">{localeCopy.act1k}</p>
    <h2 class="honesty-act-heading">{localeCopy.act1h}</h2>
    <p class="honesty-act-body">{localeCopy.act1b}</p>

    <div class="honesty-pair">
      <figure class="honesty-panel">
        <figcaption class="honesty-panel-cap">
          EffectLatticeBadge · /compiler
        </figcaption>
        <p class="honesty-sig" aria-label="fn prescribe_vancomycin takes Knowledge of f64 with IO and Observe">
          <span class="honesty-kw">fn</span>
          <span class="honesty-name">prescribe_vancomycin</span>
          <span class="honesty-plain">(dose: Knowledge&lt;f64&gt;)</span>
          <span class="honesty-kw">with</span>
          <EffectLatticeBadge effect="IO" purityLevel="Declared" size="md" />
          <EffectLatticeBadge effect="Observe" purityLevel="Declared" size="md" />
        </p>
        <p class="honesty-sig honesty-sig-sub">
          <span class="honesty-kw">where</span>
          <span class="honesty-plain">dose.ε &gt;= 0.82</span>
          <EffectLatticeBadge effect="Prob" purityLevel="Inferred" size="sm" />
        </p>
        <p class="honesty-src">
          A function without <code>with IO</code> cannot call one that has it. ε is in the type,
          not in a comment.
        </p>
      </figure>

      <figure class="honesty-panel">
        <figcaption class="honesty-panel-cap">
          KnowledgeRefusalMeter · #1797 · c5754c0c84
        </figcaption>
        <KnowledgeRefusalMeter
          signature="cmin: Knowledge<mg/L>"
          boundLow={9.052178}
          boundHigh={24.298861}
          variance={0}
          varianceCalibrated={false}
          unit="mg/L"
          provenance="pre-TDM · 78.5 kg · CrCl 65 · 1000 mg q12h"
          state="refused"
          windowLow={10}
          windowHigh={20}
          guard="where band ⊂ [10, 20] mg/L"
          diagnostic="PRE_REFUSE. Fréchet support [9.05, 24.30] is not inside the therapeutic window. The stdlib leaves variance uncalibrated (v = 0.0 in source); this control will not print var=0.000."
        />
      </figure>
    </div>
  </section>

  <section class="honesty-act" id="refusal" aria-labelledby="honesty-act2">
    <p class="honesty-act-kicker" id="honesty-act2">{localeCopy.act2k}</p>
    <h2 class="honesty-act-heading">{localeCopy.act2h}</h2>
    <p class="honesty-act-body">{localeCopy.act2b}</p>

    <div class="honesty-pair">
      <figure class="honesty-panel">
        <figcaption class="honesty-panel-cap">
          DiagnosticCodeBlock · #1794 · f6d2188d46
        </figcaption>
        <E219DiagnosticCodeBlock />
      </figure>

      <figure class="honesty-panel">
        <figcaption class="honesty-panel-cap">
          EpistemicGateCard · #1788 · 31adf7b4bc
        </figcaption>
        <EpistemicGateCard
          claim="check.sio implements well_typed_value_or_refuse"
          ceiling="E4"
          verdict="UNBOUNDED"
          reason="SounioRefusalHonesty.lean proves the E219 fragment with no sorry (refusal_is_not_zero, well_typed_value_or_refuse). The file itself says that is a model, not a proof that check.sio implements the model. Citing the theorem as a compiler proof is empirical extrapolation. E5 is unreached."
          sha="31adf7b4bc"
          href="https://github.com/Sounio-lang/sounio/blob/31adf7b4bc/formal/lean4/SounioRefusalHonesty.lean"
          hrefLabel="SounioRefusalHonesty.lean"
        />
      </figure>
    </div>
  </section>

  <section class="honesty-act" id="fabrication" aria-labelledby="honesty-act3">
    <p class="honesty-act-kicker" id="honesty-act3">{localeCopy.act3k}</p>
    <h2 class="honesty-act-heading">{localeCopy.act3h}</h2>
    <p class="honesty-act-body">{localeCopy.act3b}</p>

    <div class="honesty-pair">
      <figure class="honesty-panel">
        <figcaption class="honesty-panel-cap">
          KnowledgeRefusalMeter · #1792 · OPEN
        </figcaption>
        <KnowledgeRefusalMeter
          signature="auc: Knowledge<f64>"
          value={0}
          variance={0}
          varianceCalibrated={false}
          epsilon={FABRICATED_EPSILON_STAND_IN}
          unit=""
          provenance="epistemic_pbpk28 TEST 6 · Madaros print"
          state="refused"
          diagnostic="Madaros printed AUC confidence 4604219396932172800.000000 — the IEEE bit pattern of lean_single 0.671038, not ε. A stub zero paired with a non-unit confidence is not a Knowledge value. The control prints no numeral. #1792 makes this shape fail-closed; it does not claim the compiler ABI is fixed."
        />
      </figure>

      <div class="honesty-stack">
        <figure class="honesty-panel">
          <figcaption class="honesty-panel-cap">
            EpistemicGateCard · #1801 · 2ab2de46cf
          </figcaption>
          <EpistemicGateCard
            claim="abs() + 1 is not i64; empty stub is ud2"
            ceiling="E1"
            verdict="TRUSTWORTHY"
            reason="After E219 the checker returns ty_error() (refused_unimplemented) instead of the declared return type — add_refuse_l. Empty non-builtin IR stubs emit ud2; a missed E219 cannot fabricate 0 by reading rax. lean_single still has no E219. Correspondence gate: scripts/ci/e219_refusal_correspondence_gate.sh. This is two sites, not subject reduction for the whole compiler."
            sha="2ab2de46cf"
            href="https://github.com/Sounio-lang/sounio/pull/1801"
            hrefLabel="PR #1801"
          />
        </figure>
        <figure class="honesty-panel">
          <figcaption class="honesty-panel-cap">
            EpistemicGateCard · #1792 · OPEN
          </figcaption>
          <EpistemicGateCard
            claim="Madaros GUM variance and Knowledge.confidence are honest on the dissertation surface"
            ceiling="E3"
            verdict="REFUSED"
            reason="Measured: rapamycin_epistemic_adaptive prints var(blood/brain/periph)=0.000000 on Madaros against lean_single ~1e-5 / ~1e-9. epistemic_pbpk28 TEST 6 prints confidence 4604219396932172800. #1792 is open: fail-closed detection, not a self-hosted ABI repair. E4 and E5 are unreached because the printed values already fail as Knowledge."
            sha="4816902113"
            href="https://github.com/Sounio-lang/sounio/pull/1792"
            hrefLabel="PR #1792"
          />
        </figure>
      </div>
    </div>
  </section>

  <FabricatedDatumExhibit locale={locale} />

  <footer class="honesty-coda">
    <p>{localeCopy.coda}</p>
    <nav class="honesty-coda-nav" aria-label="Related pages">
      <a href={getLocalizedPath('/language', locale)}>{localeCopy.language}</a>
      <a href={getLocalizedPath('/compiler', locale)}>{localeCopy.compiler}</a>
      <a href={getLocalizedPath('/proof', locale)}>{localeCopy.proof}</a>
    </nav>
  </footer>
</article>

<style>
  .honesty {
    --honesty-rule: var(--color-border-hairline);
    max-width: 1120px;
    margin: 0 auto;
    padding: clamp(3rem, 8vw, 5.5rem) 1.5rem clamp(4rem, 8vw, 6rem);
    display: grid;
    gap: clamp(3rem, 6vw, 4.5rem);
  }

  .honesty-hero {
    display: grid;
    gap: 1rem;
    max-width: 46rem;
  }

  .honesty-kicker,
  .honesty-act-kicker,
  .honesty-panel-cap {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .honesty-kicker {
    color: var(--color-accent-teal);
  }

  .honesty-heading {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.6vw, 3.15rem);
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -0.018em;
    color: var(--color-text-primary);
  }

  .honesty-lede,
  .honesty-act-body,
  .honesty-src,
  .honesty-coda p {
    margin: 0;
    max-width: 68ch;
    font-size: 0.98rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  .honesty-spine {
    list-style: none;
    margin: 1.1rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.65rem;
    border-top: 1px solid var(--honesty-rule);
    padding-top: 1.1rem;
  }

  .honesty-spine li {
    display: grid;
    grid-template-columns: 2.1rem 1fr;
    gap: 0.75rem;
    align-items: start;
    color: var(--color-text-primary);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .honesty-spine-n {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--color-accent-gold);
    padding-top: 0.2rem;
  }

  .honesty-act {
    display: grid;
    gap: 0.85rem;
  }

  .honesty-act-kicker {
    color: var(--color-epistemic-refused-text);
  }

  .honesty-act:first-of-type .honesty-act-kicker {
    color: var(--color-epistemic-verified-text);
  }

  .honesty-act:nth-of-type(2) .honesty-act-kicker {
    color: var(--color-epistemic-uncertain-text);
  }

  .honesty-act-heading {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.6vw, 1.85rem);
    font-weight: 400;
    line-height: 1.25;
    color: var(--color-text-primary);
  }

  .honesty-pair {
    display: grid;
    gap: 1rem;
    margin-top: 0.4rem;
  }

  @media (min-width: 880px) {
    .honesty-pair {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  .honesty-stack {
    display: grid;
