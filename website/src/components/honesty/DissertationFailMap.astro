---
import {
  DEFENSE_STATES,
  FAIL_KIND_COUNTS,
  FAIL_STATE_COUNTS,
  PBPK_SUITE_FAILS,
  mapCloses,
} from '../../lib/dissertationHonestyMap';
import { PBPK_SUITE_NOW, suiteFace } from '../../lib/dissertationHonestyNow';
import ReceiptLink from './ReceiptLink.astro';
import type { ReceiptKey } from '../../lib/honestyReceipts';
import type { Locale } from '../../lib/i18n';
import './DissertationFailMap.css';

function rowReceipt(kind: (typeof PBPK_SUITE_FAILS)[number]['kind']): ReceiptKey {
  return kind === 'silent-zero' || kind === 'bit-pattern' ? 'silentZero' : 'pbpkSuite';
}

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const closed = mapCloses(PBPK_SUITE_FAILS);
const m = PBPK_SUITE_NOW;
const face = closed ? suiteFace(m) : '';
const kinds = FAIL_KIND_COUNTS;
const states = FAIL_STATE_COUNTS;

type Copy = {
  kicker: string;
  title: string;
  sentence: string;
  verified: string;
  uncertain: string;
  refused: string;
  unbounded: string;
  fabricated: string;
  n: string;
  test: string;
  family: string;
  state: string;
  evidence: string;
  toolchain: string;
  ceiling: string;
  compile: string;
  silentZero: string;
  bitPattern: string;
  interrupted: string;
  runtime: string;
  measured: string;
};

const copy: Record<string, Copy> = {
  en: {
    kicker: 'The 16',
    title: 'Which of the five states each fail is.',
    sentence: `Zero of the 16 is a science or model defect. ${kinds.compile} are compiler refusals — science never started. ${kinds['silent-zero'] + kinds['bit-pattern']} fabricated a numeral. ${kinds.interrupted} were cut by rc=182 after science had begun. ${kinds.runtime} check-green run segfaults when stdout is a file. The suite family is 9 toolchain / 7 resource ceiling / 0 science; toolchain is not nine refusals.`,
    verified: 'verified',
    uncertain: 'uncertain',
    refused: 'refused',
    unbounded: 'unbounded',
    fabricated: 'fabricated',
    n: '#',
    test: 'test',
    family: 'family',
    state: 'state',
    evidence: 'evidence',
    toolchain: 'toolchain',
    ceiling: 'rc=182',
    compile: 'compile',
    silentZero: 'silent zero',
    bitPattern: 'bit-pattern',
    interrupted: 'interrupted',
    runtime: 'runtime',
    measured: 'same measure as the NOW panel',
  },
  pt: {
    kicker: 'As 16',
    title: 'Qual dos cinco estados é cada falha.',
    sentence: `Zero das 16 é defeito de ciência ou de modelo. ${kinds.compile} são recusas do compilador — a ciência não começou. ${kinds['silent-zero'] + kinds['bit-pattern']} fabricaram um numeral. ${kinds.interrupted} foram cortadas por rc=182 depois da ciência ter começado. ${kinds.runtime} run check-green falha com segfault quando o stdout é um ficheiro. A família da suite é 9 toolchain / 7 tecto de recursos / 0 ciência; toolchain não são nove recusas.`,
    verified: 'verificado',
    uncertain: 'incerto',
    refused: 'recusado',
    unbounded: 'não fechado',
    fabricated: 'fabricado',
    n: '#',
    test: 'teste',
    family: 'família',
    state: 'estado',
    evidence: 'evidência',
    toolchain: 'toolchain',
    ceiling: 'rc=182',
    compile: 'compilação',
    silentZero: 'zero silencioso',
    bitPattern: 'padrão de bits',
    interrupted: 'interrompido',
    runtime: 'runtime',
    measured: 'a mesma medição do painel ESTADO ACTUAL',
  },
};

const d = copy[locale] ?? copy.en;

const stateLabel: Record<(typeof DEFENSE_STATES)[number], string> = {
  verified: d.verified,
  uncertain: d.uncertain,
  refused: d.refused,
  unbounded: d.unbounded,
  fabricated: d.fabricated,
};

const kindLabel = {
  compile: d.compile,
  'silent-zero': d.silentZero,
  'bit-pattern': d.bitPattern,
  interrupted: d.interrupted,
  runtime: d.runtime,
} as const;

const familyLabel = {
  toolchain: d.toolchain,
  'resource-ceiling': d.ceiling,
} as const;

const docHref = `https://github.com/Sounio-lang/sounio/blob/${m.docSha}/${m.doc}`;
---

{
  closed && (
    <aside class="dmap" id="the-16" aria-labelledby="honesty-map-title">
      <div>
        <p class="dmap-kicker">{d.kicker}</p>
        <h2 class="dmap-title" id="honesty-map-title">{d.title}</h2>
      </div>
      <p class="dmap-sentence">{d.sentence}</p>
      <ul class="dmap-strip" aria-label="Five epistemic states among the 16 fails">
        {DEFENSE_STATES.map((state) => (
          <li data-state={state}>
            <ReceiptLink of="pbpkSuite" prefer="doc">
              <strong>{states[state]}</strong>
            </ReceiptLink>
            {stateLabel[state]}
          </li>
        ))}
      </ul>
      <div class="dmap-table-wrap">
        <table class="dmap-table">
          <thead>
            <tr>
              <th class="dmap-n">{d.n}</th>
              <th>{d.test}</th>
              <th class="dmap-col-family">{d.family}</th>
              <th>{d.state}</th>
              <th class="dmap-col-ev">{d.evidence}</th>
            </tr>
          </thead>
          <tbody>
            {PBPK_SUITE_FAILS.map((row) => (
              <tr data-state={row.state} data-kind={row.kind} data-family={row.family}>
                <td class="dmap-n">
                  <ReceiptLink of={rowReceipt(row.kind)} prefer="doc">
                    {row.n}
                  </ReceiptLink>
                </td>
                <td class="dmap-name">{row.name}</td>
                <td class="dmap-col-family">
                  <span class="dmap-chip">{familyLabel[row.family]}</span>
                </td>
                <td>
                  <span class="dmap-chip" data-state={row.state}>
                    {stateLabel[row.state]} · {kindLabel[row.kind]}
                  </span>
                </td>
                <td class="dmap-ev dmap-col-ev">{row.evidence}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="dmap-measured">
        {d.measured} · {face} · <a href={docHref}>{m.doc}</a>
      </p>
    </aside>
  )
}
