---
import { FabricatedDatum } from '../epistemic/FabricatedDatum';
import {
  BIT_PATTERN_ACTUAL,
  BIT_PATTERN_PRINTED,
  SILENT_ZERO_ACTUAL,
  SILENT_ZERO_PRINTED,
  truncatedE219Help,
} from '../../lib/fabricationHonesty';
import { PRE_FIX_PRINT_CAP } from '../../lib/diagnosticHonesty';
import { RECEIPT } from '../../lib/honestyReceipts';
import ReceiptLink from './ReceiptLink.astro';
import type { Locale } from '../../lib/i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const cut = truncatedE219Help();
const kept = cut.state === 'fabricated' ? cut.printed : '';
const dropped = cut.state === 'fabricated' ? cut.actual : '';

const t: Record<
  string,
  { kicker: string; heading: string; body: string }
> = {
  en: {
    kicker: 'Night · the class, torn open',
    heading: 'These three faces are why four lanes recognised each other.',
    body: 'A zero that the other engine does not give. An integer wearing an ε. A diagnostic cut mid-word. The meter still refuses to print the fake numeral. FabricatedDatum (#1829) shows both faces and will not tear when they are the same string. The first two receipts are #1792. The census of the cut is #1794.',
  },
  pt: {
    kicker: 'Noite · a classe, rasgada',
    heading: 'Estas três caras são a razão de quatro lanes se terem reconhecido.',
    body: 'Um zero que o outro motor não dá. Um inteiro vestido de ε. Um diagnóstico cortado a meio da palavra. O medidor continua a recusar o numeral falso. O FabricatedDatum (#1829) mostra as duas caras e não rasga quando são a mesma string. Os dois primeiros recibos são o #1792. O censo do corte é o #1794.',
  },
  es: {
    kicker: 'Noche · la clase, rasgada',
    heading: 'Estas tres caras son por qué cuatro lanes se reconocieron.',
    body: 'Un cero que el otro motor no da. Un entero vestido de ε. Un diagnóstico cortado. #1792 sigue abierto.',
  },
  el: {
    kicker: 'Νύχτα · η κλάση, σχισμένη',
    heading: 'Αυτά τα τρία πρόσωπα είναι γιατί τέσσερις lanes αναγνωρίστηκαν.',
    body: 'Τρεις μετρημένες περιπτώσεις. Το #1792 παραμένει ανοιχτό στις δύο πρώτες.',
  },
  zh: {
    kicker: '夜里 · 撕开这一类',
    heading: '这三张脸，是四条 lane 认出彼此的原因。',
    body: '三个已测案例。前两件 #1792 仍开放。',
  },
  ja: {
    kicker: '夜 · その類を裂く',
    heading: 'この三つの顔が、四つのレーンが互いを認めた理由だ。',
    body: '実測は三つ。最初の二つは #1792 がまだ開いている。',
  },
};

const d = t[locale] ?? (locale === 'zh-hk' ? t.zh : t.en);
---

<section class="honesty-act" id="fabricated" aria-labelledby="honesty-act4">
  <p class="honesty-act-kicker" id="honesty-act4">{d.kicker}</p>
  <h2 class="honesty-act-heading">{d.heading}</h2>
  <p class="honesty-act-body">{d.body}</p>
  <p class="honesty-act-receipts">
    <ReceiptLink of="silentZero">{SILENT_ZERO_PRINTED}</ReceiptLink>
    <ReceiptLink of="silentZero">{BIT_PATTERN_PRINTED}</ReceiptLink>
    <ReceiptLink of="truncatedDiagnostics" prefer="doc">{`33 > ${PRE_FIX_PRINT_CAP}`}</ReceiptLink>
  </p>

  <div class="fd-exhibit">
    <FabricatedDatum
      kind="silent-zero"
      signature="var(blood): Knowledge<f64>"
      printed={SILENT_ZERO_PRINTED}
      actual={SILENT_ZERO_ACTUAL}
      printedLabel="Madaros"
      actualLabel="lean_single"
      reason="rapamycin_epistemic_adaptive. Madaros printed var(blood/brain/periph)=0.000000. lean_single shows ~1e-5 / ~1e-9. A calibrated zero would be a measurement. This zero is the stub. #1792 is open: fail-closed detection, not a compiler ABI fix."
      sha={RECEIPT.silentZero.sha}
      href={RECEIPT.silentZero.href}
      hrefLabel={`PR #${RECEIPT.silentZero.pr}`}
    />
    <FabricatedDatum
      kind="bit-pattern"
      signature="auc.ε: Knowledge<f64>"
      printed={BIT_PATTERN_PRINTED}
      actual={BIT_PATTERN_ACTUAL}
      printedLabel="Madaros TEST 6"
      actualLabel="lean_single ε"
      reason="epistemic_pbpk28 TEST 6 printed AUC confidence 4604219396932172800.000000 — documented as the IEEE-bit-pattern-as-decimal of lean_single 0.671038. The integer exceeds JS 2^53; this control keeps it as text. It is not a unit-interval ε. #1792 remains open."
      sha={RECEIPT.silentZero.sha}
      href={RECEIPT.silentZero.docHref}
      hrefLabel={`PR #${RECEIPT.silentZero.pr}`}
    />
    <FabricatedDatum
      kind="truncated"
      signature={`E219 help · ${PRE_FIX_PRINT_CAP}-char cap`}
      printed={kept}
      actual={dropped}
      printedLabel="Pre-#1784 print"
      actualLabel={`Dropped · ${dropped.length} chars`}
      reason="#1794 counted 33 user-facing diagnostics over the old 127-character print cap. Every one was cut. E219 help is 333 characters; 206 were dropped mid-word. The historical CI logs that quote them are incomplete in the tails. #1784 closed the path. This card is the census, not the fix."
      sha={RECEIPT.truncatedDiagnostics.sha}
      href={RECEIPT.truncatedDiagnostics.href}
      hrefLabel={`PR #${RECEIPT.truncatedDiagnostics.pr}`}
    />
  </div>
</section>

<style>
  .honesty-act {
    display: grid;
    gap: 0.85rem;
  }

  .honesty-act-kicker {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-epistemic-refused-text);
  }

  .honesty-act-heading {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.6vw, 1.85rem);
    font-weight: 400;
    line-height: 1.25;
    color: var(--color-text-primary);
  }

  .honesty-act-receipts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 0.85rem;
    margin: 0;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: 0.78rem;
    color: var(--color-text-primary);
  }

  .honesty-act-body {
    margin: 0;
    max-width: 68ch;
    font-size: 0.98rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  .fd-exhibit {
    display: grid;
    gap: 1rem;
    margin-top: 0.4rem;
  }
</style>
