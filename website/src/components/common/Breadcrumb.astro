---
interface Crumb {
  name: string;
  href: string;
}

interface Props {
  crumbs: Crumb[];
  class?: string;
}

const { crumbs, class: className } = Astro.props;
---

<nav aria-label="Breadcrumb" class={className}>
  <ol class="flex items-center gap-2 text-sm text-[var(--color-text-muted)]">
    {crumbs.flatMap((crumb, index) => {
      const current = index === crumbs.length - 1;
      const item = (
        <li class={current ? 'text-[var(--color-text)] font-medium truncate' : undefined}>
          {current ? (
            <span aria-current="page">{crumb.name}</span>
          ) : (
            <a href={crumb.href} class="hover:text-[var(--color-text)]">{crumb.name}</a>
          )}
        </li>
      );
      if (index === 0) return [item];
      return [<li aria-hidden="true"><span class="mx-1">/</span></li>, item];
    })}
  </ol>
</nav>
