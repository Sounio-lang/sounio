---
interface Cta {
  href: string;
  label: string;
  variant?: 'primary' | 'secondary';
}

interface Props {
  badge: string;
  title: string;
  subtitle?: string;
  mascot?: 'yiayia' | 'pappou';
  compact?: boolean;
  ctas?: Cta[];
  transitionName?: string;
}

const { badge, title, subtitle, mascot, compact = false, ctas = [], transitionName } = Astro.props;
---

<section class:list={['page-hero', compact && 'page-hero-compact']}>
  <div class="page-hero-backdrop" aria-hidden="true">
    {mascot === 'yiayia' && (
      <picture>
        <source
          srcset="/assets/original-artworks/yiayia_hero_1280.webp 1280w, /assets/original-artworks/yiayia_hero_1536.webp 1536w"
          sizes="100vw"
          type="image/webp"
        />
        <img src="/assets/original-artworks/yiayia_hero.png" alt="" loading="eager" decoding="async" />
      </picture>
    )}
    {mascot === 'pappou' && (
      <picture>
        <source
          srcset="/assets/original-artworks/pappou_hero_1280.webp 1280w, /assets/original-artworks/pappou_hero_1536.webp 1536w"
          sizes="100vw"
          type="image/webp"
        />
        <img src="/assets/original-artworks/pappou_hero.png" alt="" loading="eager" decoding="async" />
      </picture>
    )}
    <div class="page-hero-overlay"></div>
  </div>

  <div class="container page-hero-content">
    <span class="badge-pill">{badge}</span>
    <h1
      class="font-display page-hero-title"
      style={transitionName ? `view-transition-name: ${transitionName}` : undefined}
      set:html={title}
    />
    {subtitle && <p class="page-hero-subtitle">{subtitle}</p>}
    {ctas.length > 0 && (
      <div class="page-hero-actions">
        {ctas.map((cta) => (
          <a
            href={cta.href}
            class:list={['hero-cta', cta.variant === 'secondary' ? 'secondary' : 'primary']}
          >
            {cta.label}
          </a>
        ))}
      </div>
    )}
    <slot name="actions" />
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    min-height: min(560px, 72vh);
    display: grid;
    align-items: end;
    overflow: hidden;
    padding: clamp(6rem, 14vw, 9rem) 0 clamp(3rem, 6vw, 4.5rem);
    background: #020617;
  }

  .page-hero-compact {
    min-height: min(420px, 58vh);
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }

  .page-hero-backdrop {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .page-hero-backdrop picture,
  .page-hero-backdrop img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0.22;
  }

  .page-hero-overlay {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 50% at 50% 0%, rgba(214, 179, 90, 0.12), transparent 60%),
      linear-gradient(180deg, rgba(2, 6, 23, 0.55) 0%, rgba(2, 6, 23, 0.92) 55%, #020617 100%);
  }

  .page-hero-content {
    position: relative;
    z-index: 2;
    max-width: 820px;
    display: grid;
    gap: 1rem;
  }

  .page-hero-title {
    font-size: clamp(2.4rem, 6vw, 4.5rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--color-text-primary);
    margin: 0;
  }

  .page-hero-subtitle {
    margin: 0;
    max-width: 62ch;
    color: var(--color-text-secondary);
    font-size: clamp(1.05rem, 2.2vw, 1.25rem);
    line-height: 1.65;
    font-weight: 300;
  }

  .page-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 0.5rem;
  }
</style>
