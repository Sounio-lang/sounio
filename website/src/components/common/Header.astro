---
import ThemeToggle from './ThemeToggle';
import Search from '../docs/Search';
import { locales, localeNames, getLocalizedPath, loadTranslations, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = await loadTranslations(locale);
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '#features', label: t.nav_features },
  { href: '#compare', label: t.nav_compare },
  { href: '/docs', label: t.nav_docs },
  { href: '/playground', label: t.nav_playground },
  { href: '/blog', label: t.nav_blog },
  { href: '/registry', label: t.nav_registry },
];
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-[var(--color-navy-900)]/95 border-b border-[var(--color-gold-500)]/20">
  <nav class="container flex items-center justify-between h-16" aria-label="Main navigation">
    <!-- Logo -->
    <a href={getLocalizedPath('/', locale)} class="flex items-center gap-2 text-white hover:text-[var(--color-gold-500)] transition-colors">
      <img src="/assets/sounio-logo.svg" alt="" class="h-8 w-8" aria-hidden="true" />
      <span class="text-xl font-semibold tracking-tight">Sounio</span>
    </a>

    <!-- Desktop Navigation -->
    <div class="hidden md:flex items-center gap-6">
      {navLinks.map((link) => (
        <a
          href={link.href.startsWith('#') ? link.href : getLocalizedPath(link.href, locale)}
          class="text-white/90 hover:text-[var(--color-gold-500)] text-sm font-medium transition-colors focus-ring"
        >
          {link.label}
        </a>
      ))}

      <a
        href="https://github.com/sounio-lang/sounio"
        target="_blank"
        rel="noopener noreferrer"
        class="text-white/90 hover:text-[var(--color-gold-500)] text-sm font-medium transition-colors focus-ring"
        aria-label="GitHub repository (opens in new tab)"
      >
        {t.nav_github}
      </a>
    </div>

    <!-- Right side: Search + Theme toggle + Language switcher -->
    <div class="flex items-center gap-4">
      <Search client:load />
      <ThemeToggle client:load />

      <!-- Language Switcher -->
      <div class="hidden md:flex items-center gap-2 pl-4 border-l border-[var(--color-gold-500)]/20">
        {locales.map((lang) => (
          <a
            href={getLocalizedPath(currentPath, lang)}
            class:list={[
              'text-xs px-2 py-1 rounded transition-colors focus-ring',
              lang === locale
                ? 'text-white bg-[var(--color-gold-500)]/20'
                : 'text-white/70 hover:text-white hover:bg-[var(--color-gold-500)]/10',
            ]}
            aria-current={lang === locale ? 'page' : undefined}
            title={localeNames[lang]}
          >
            {lang.toUpperCase()}
          </a>
        ))}
      </div>

      <!-- Mobile menu button -->
      <button
        type="button"
        class="md:hidden p-2 text-white hover:text-[var(--color-gold-500)] focus-ring"
        aria-label="Toggle menu"
        aria-expanded="false"
        id="mobile-menu-button"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile Navigation -->
  <div class="hidden md:hidden" id="mobile-menu">
    <div class="px-4 pb-4 space-y-2">
      {navLinks.map((link) => (
        <a
          href={link.href.startsWith('#') ? link.href : getLocalizedPath(link.href, locale)}
          class="block py-2 text-white/90 hover:text-[var(--color-gold-500)] text-sm font-medium"
        >
          {link.label}
        </a>
      ))}
      <a
        href="https://github.com/sounio-lang/sounio"
        target="_blank"
        rel="noopener noreferrer"
        class="block py-2 text-white/90 hover:text-[var(--color-gold-500)] text-sm font-medium"
      >
        {t.nav_github}
      </a>

      <!-- Mobile language switcher -->
      <div class="flex flex-wrap gap-2 pt-4 border-t border-[var(--color-gold-500)]/20">
        {locales.map((lang) => (
          <a
            href={getLocalizedPath(currentPath, lang)}
            class:list={[
              'text-xs px-2 py-1 rounded',
              lang === locale
                ? 'text-white bg-[var(--color-gold-500)]/20'
                : 'text-white/70 hover:text-white',
            ]}
          >
            {localeNames[lang]}
          </a>
        ))}
      </div>
    </div>
  </div>
</header>

<script>
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');

  menuButton?.addEventListener('click', () => {
    const isExpanded = menuButton.getAttribute('aria-expanded') === 'true';
    menuButton.setAttribute('aria-expanded', (!isExpanded).toString());
    mobileMenu?.classList.toggle('hidden');
  });
</script>
