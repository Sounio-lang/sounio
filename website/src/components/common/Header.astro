---
import ThemeToggle from './ThemeToggle';
import Search from '../docs/Search';
import { getLocalizedPath, loadTranslations, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = await loadTranslations(locale);
const currentPath = Astro.url.pathname;

const searchStrings = {
  button: t.search_button,
  placeholder: t.search_placeholder,
  searching: t.search_searching,
  noResults: t.search_no_results,
  noResultsHint: t.search_no_results_hint,
  startTyping: t.search_start_typing,
  startTypingHint: t.search_start_typing_hint,
  toSelect: t.search_to_select,
  toNavigate: t.search_to_navigate,
  poweredBy: t.search_powered_by,
};

const navLinks = [
  { href: '#features', label: t.nav_features },
  { href: '/docs', label: t.nav_docs },
  { href: '/playground', label: t.nav_playground },
  { href: '/blog', label: t.nav_blog },
];
---

<header class="header-transparent fixed top-0 left-0 right-0 z-50 transition-all duration-300" id="site-header">
  <nav class="container flex items-center justify-between h-16" aria-label="Main navigation">
    <!-- Logo -->
    <a href={getLocalizedPath('/', locale)} class="flex items-center gap-2 text-[var(--color-text-primary)] hover:text-[var(--color-accent-gold)] transition-colors">
      <img src="/assets/sounio-logo.svg" alt="" class="h-8 w-8" aria-hidden="true" />
      <span class="text-xl font-bold tracking-[-0.02em]" style="font-family: var(--font-display);">Sounio</span>
    </a>

    <!-- Desktop Navigation -->
    <div class="hidden md:flex items-center gap-6">
      {navLinks.map((link) => (
        <a
          href={link.href.startsWith('#') ? link.href : getLocalizedPath(link.href, locale)}
          class="text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] text-sm font-medium transition-colors"
        >
          {link.label}
        </a>
      ))}

      <a
        href="https://github.com/sounio-lang/sounio"
        target="_blank"
        rel="noopener noreferrer"
        class="text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] text-sm font-medium transition-colors"
        aria-label="GitHub repository (opens in new tab)"
      >
        {t.nav_github}
      </a>
    </div>

    <!-- Right side: Search + Theme toggle -->
    <div class="flex items-center gap-3">
      <Search client:load locale={locale} strings={searchStrings} />
      <ThemeToggle client:load />

      <!-- Mobile menu button -->
      <button
        type="button"
        class="md:hidden p-2 text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors"
        aria-label="Toggle menu"
        aria-expanded="false"
        id="mobile-menu-button"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile Navigation -->
  <div class="hidden md:hidden" id="mobile-menu">
    <div class="px-4 pb-4 space-y-2">
      {navLinks.map((link) => (
        <a
          href={link.href.startsWith('#') ? link.href : getLocalizedPath(link.href, locale)}
          class="block py-2 text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] text-sm font-medium"
        >
          {link.label}
        </a>
      ))}
      <a
        href="https://github.com/sounio-lang/sounio"
        target="_blank"
        rel="noopener noreferrer"
        class="block py-2 text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] text-sm font-medium"
      >
        {t.nav_github}
      </a>
    </div>
  </div>
</header>

<style>
  .header-transparent {
    background: transparent;
    border-bottom: 1px solid transparent;
  }

  .header-scrolled {
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
    border-bottom: 1px solid var(--glass-border);
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');

  const onScroll = () => {
    if (!header) return;
    if (window.scrollY > 50) {
      header.classList.remove('header-transparent');
      header.classList.add('header-scrolled');
    } else {
      header.classList.remove('header-scrolled');
      header.classList.add('header-transparent');
    }
  };

  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  menuButton?.addEventListener('click', () => {
    const isExpanded = menuButton.getAttribute('aria-expanded') === 'true';
    menuButton.setAttribute('aria-expanded', (!isExpanded).toString());
    mobileMenu?.classList.toggle('hidden');
  });
</script>
