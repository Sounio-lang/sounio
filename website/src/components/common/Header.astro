---
import ThemeToggle from './ThemeToggle';
import SounioMark from './SounioMark.astro';
import AudienceSelector from './AudienceSelector';
import Search from '../docs/Search';
import { getLocalizedPath, loadTranslations, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = await loadTranslations(locale);
const currentPath = Astro.url.pathname;

const searchStrings = {
  button: t.search_button,
  placeholder: t.search_placeholder,
  searching: t.search_searching,
  noResults: t.search_no_results,
  noResultsHint: t.search_no_results_hint,
  startTyping: t.search_start_typing,
  startTypingHint: t.search_start_typing_hint,
  toSelect: t.search_to_select,
  toNavigate: t.search_to_navigate,
  poweredBy: t.search_powered_by,
};

const audienceStrings = {
  scientist: t.audience_scientist,
  technical: t.audience_technical,
  choose: t.audience_choose,
};

const navLinks = [
  { href: '/dissertation', label: t.nav_dissertation },
  { href: '/science', label: t.nav_science },
  { href: '/language', label: t.nav_language },
  { href: '/honesty', label: t.nav_honesty },
  { href: '/compiler', label: 'Compiler' },
  { href: '/learn', label: t.nav_learn },
  { href: '/about', label: t.nav_about },
];

function isActivePath(href: string) {
  const localized = getLocalizedPath(href, locale);
  return currentPath === localized || currentPath.startsWith(`${localized}/`);
}
---

<header class="site-header fixed top-0 left-0 right-0 z-50" id="site-header">
  <nav aria-label="Main navigation">
    <div class="container flex items-center justify-between h-16">
      <a href={getLocalizedPath('/', locale)} class="brand-link" aria-label="Sounio homepage">
        <SounioMark size={22} class="brand-mark" />
        <span class="brand-word">Sounio</span>
      </a>

      <div class="hidden lg:flex items-center gap-2">
        {navLinks.map((link) => {
          const active = isActivePath(link.href);
          return (
            <a
              href={getLocalizedPath(link.href, locale)}
              class:list={[
                'nav-link',
                active ? 'nav-link-active' : '',
              ]}
              aria-current={active ? 'page' : undefined}
            >
              {link.label}
            </a>
          );
        })}
      </div>

      <div class="flex items-center gap-2">
        <a
          href={getLocalizedPath('/dissertation', locale)}
          class="docs-cta docs-cta-scientist hidden md:inline-flex"
          data-for-audience="scientist"
        >
          {t.header_cta_scientist}
        </a>
        <a
          href={getLocalizedPath('/learn/getting-started', locale)}
          class="docs-cta docs-cta-technical hidden md:inline-flex"
          data-for-audience="technical"
        >
          {t.header_cta_technical}
        </a>
        <div class="inline-flex lg:hidden">
          <AudienceSelector client:load strings={audienceStrings} />
        </div>
        <Search client:load locale={locale} strings={searchStrings} />
        <div class="hidden lg:inline-flex">
          <AudienceSelector client:load strings={audienceStrings} />
        </div>
        <div class="hidden sm:inline-flex">
          <ThemeToggle client:load />
        </div>

        <button
          type="button"
          class="mobile-toggle inline-flex lg:hidden"
          aria-label="Toggle menu"
          aria-expanded="false"
          aria-haspopup="menu"
          aria-controls="mobile-menu"
          id="mobile-menu-button"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <div class="mobile-menu hidden lg:hidden" id="mobile-menu">
      <div class="container py-3 grid gap-1">
        {navLinks.map((link) => {
          const active = isActivePath(link.href);
          return (
            <a
              href={getLocalizedPath(link.href, locale)}
              class:list={['mobile-nav-link', active ? 'mobile-nav-link-active' : '']}
              aria-current={active ? 'page' : undefined}
            >
              {link.label}
            </a>
          );
        })}

        <a
          href={getLocalizedPath('/dissertation', locale)}
          class="mobile-docs-cta"
          data-for-audience="scientist"
        >
          {t.header_cta_scientist}
        </a>
        <a
          href={getLocalizedPath('/learn/getting-started', locale)}
          class="mobile-docs-cta"
          data-for-audience="technical"
        >
          {t.header_cta_technical}
        </a>

        <a
          href="https://github.com/sounio-lang/sounio"
          target="_blank"
          rel="noopener noreferrer"
          class="mobile-nav-link"
        >
          GitHub
        </a>

        <div class="flex items-center gap-3 mt-4 pt-3 border-t border-[var(--color-border-subtle)] sm:hidden">
          <AudienceSelector client:load strings={audienceStrings} />
          <ThemeToggle client:load />
        </div>
      </div>
    </div>
  </nav>
</header>

<style>
  .site-header::before {
    content: '';
    position: absolute;
    bottom: -1px; left: 0;
    height: 2px;
    width: var(--scroll-pct, 0%);
    background: var(--color-accent-gold);
    pointer-events: none;
    z-index: 1;
  }

  .site-header {
    background: color-mix(in srgb, var(--color-bg) 72%, transparent);
    border-bottom: 1px solid var(--color-border-hairline);
    backdrop-filter: blur(18px) saturate(170%);
    -webkit-backdrop-filter: blur(18px) saturate(170%);
    transition: background var(--transition-base), border-color var(--transition-base);
  }

  .site-header.is-scrolled {
    background: color-mix(in srgb, var(--color-bg) 90%, transparent);
    border-bottom-color: var(--color-border-subtle);
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-text-primary);
    transition: color var(--transition-fast);
  }

  .brand-link :global(.brand-mark) {
    color: var(--color-accent-gold-text);
    transition: transform var(--transition-base);
  }

  .brand-link:hover :global(.brand-mark) { transform: translateY(-1px); }

  .brand-word {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    line-height: 1;
    letter-spacing: 0.01em;
  }

  .brand-link:hover { color: var(--color-text-primary); }

  .nav-link {
    position: relative;
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: -0.005em;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-md);
    transition: color var(--transition-fast), background var(--transition-fast);
  }

  .nav-link:hover {
    color: var(--color-text-primary);
    background: var(--color-surface-frost);
  }

  .nav-link-active {
    color: var(--color-text-primary);
  }

  .nav-link-active::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0.1rem;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    border-radius: 50%;
    background: var(--color-accent-gold);
  }

  .docs-cta,
  .mobile-docs-cta {
    align-items: center;
    justify-content: center;
    min-height: 36px;
    border-radius: var(--radius-full);
    border: 1px solid #D6B35A;
    background: #D6B35A;
    color: #0B1E3A;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0 1rem;
    transition: transform var(--transition-fast), background var(--transition-fast);
  }

  .docs-cta:hover,
  .mobile-docs-cta:hover {
    transform: translateY(-1px);
    background: #E0C470;
    color: #0B1E3A;
  }

  .mobile-toggle {
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: var(--color-text-primary);
    border: 1px solid var(--color-border-strong);
    background: var(--color-surface-frost);
    border-radius: var(--radius-md);
    transition: background var(--transition-fast);
  }

  .mobile-toggle:hover {
    background: var(--color-surface-tertiary);
  }

  .mobile-menu {
    background: color-mix(in srgb, var(--color-bg) 97%, transparent);
    border-top: 1px solid var(--color-border-subtle);
  }

  .mobile-nav-link {
    display: block;
    border-radius: var(--radius-md);
    padding: 0.7rem 0.75rem;
    color: var(--color-text-secondary);
    font-size: 1rem;
    font-weight: 500;
    transition: color var(--transition-fast), background var(--transition-fast);
  }

  .mobile-nav-link:hover {
    color: var(--color-text-primary);
    background: var(--color-surface-frost);
  }

  .mobile-nav-link-active {
    color: var(--color-text-primary);
    background: rgba(214, 179, 90, 0.16);
  }

  .mobile-docs-cta {
    display: inline-flex;
    margin-top: 0.5rem;
    width: fit-content;
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const header = document.getElementById('site-header');
    const menuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');

    const onScroll = () => {
      if (!header) return;
      if (window.scrollY > 8) {
        header.classList.add('is-scrolled');
      } else {
        header.classList.remove('is-scrolled');
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    const updateScrollPct = () => {
      const el = document.documentElement;
      const scrolled = el.scrollTop || document.body.scrollTop;
      const max = el.scrollHeight - el.clientHeight;
      const pct = max > 0 ? (scrolled / max) * 100 : 0;
      header?.style.setProperty('--scroll-pct', `${pct}%`);
    };
    window.addEventListener('scroll', updateScrollPct, { passive: true });

    menuButton?.addEventListener('click', () => {
      const isExpanded = menuButton.getAttribute('aria-expanded') === 'true';
      menuButton.setAttribute('aria-expanded', (!isExpanded).toString());
      mobileMenu?.classList.toggle('hidden');
    });
  });
</script>
