---
import ThemeToggle from './ThemeToggle';
import Search from '../docs/Search';
import { getLocalizedPath, loadTranslations, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = await loadTranslations(locale);
const currentPath = Astro.url.pathname;

const searchStrings = {
  button: t.search_button,
  placeholder: t.search_placeholder,
  searching: t.search_searching,
  noResults: t.search_no_results,
  noResultsHint: t.search_no_results_hint,
  startTyping: t.search_start_typing,
  startTypingHint: t.search_start_typing_hint,
  toSelect: t.search_to_select,
  toNavigate: t.search_to_navigate,
  poweredBy: t.search_powered_by,
};

const audienceStrings = {
  scientist: t.audience_scientist,
  technical: t.audience_technical,
  choose: t.audience_choose,
};

const navLinks = [
  { href: '/dissertation', label: t.nav_dissertation },
  { href: '/science', label: t.nav_science },
  { href: '/language', label: t.nav_language },
  { href: '/learn', label: t.nav_learn },
  { href: '/about', label: t.nav_about },
];

function isActivePath(href: string) {
  const localized = getLocalizedPath(href, locale);
  return currentPath === localized || currentPath.startsWith(`${localized}/`);
}
---

<header class="site-header fixed top-0 left-0 right-0 z-50 mix-blend-difference" id="site-header">
  <nav aria-label="Main navigation">
    <div class="container flex items-center justify-between h-20">
      <a href={getLocalizedPath('/', locale)} class="brand-link" aria-label="Sounio homepage">
        <img src="/assets/sounio-logo.svg" alt="" class="h-6 w-6 opacity-80 hover:opacity-100 transition-opacity" width="24" height="24" aria-hidden="true" />
      </a>

      <div class="hidden lg:flex items-center gap-8">
        <a href={getLocalizedPath('/start', locale)} class="nav-link">Start</a>
        <a href={getLocalizedPath('/explore', locale)} class="nav-link">Explore</a>
        <a href={getLocalizedPath('/proof', locale)} class="nav-link">Proof</a>
        <a href={getLocalizedPath('/about', locale)} class="nav-link">About</a>
      </div>

      <div class="flex items-center gap-4">
        <Search client:only="react" locale={locale} strings={searchStrings} />
        <div class="hidden sm:inline-flex">
          <ThemeToggle client:only="react" />
        </div>

        <button
          type="button"
          class="mobile-toggle lg:hidden"
          aria-label="Toggle menu"
          aria-expanded="false"
          aria-haspopup="menu"
          aria-controls="mobile-menu"
          id="mobile-menu-button"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <div class="mobile-menu hidden lg:hidden" id="mobile-menu">
      <div class="container py-6 grid gap-4">
        <a href={getLocalizedPath('/start', locale)} class="mobile-nav-link text-2xl font-display">Start</a>
        <a href={getLocalizedPath('/explore', locale)} class="mobile-nav-link text-2xl font-display">Explore</a>
        <a href={getLocalizedPath('/proof', locale)} class="mobile-nav-link text-2xl font-display">Proof</a>
        <a href={getLocalizedPath('/about', locale)} class="mobile-nav-link text-2xl font-display">About</a>

        <div class="flex items-center gap-3 mt-8 pt-6 border-t border-white/10 sm:hidden">
          <ThemeToggle client:only="react" />
        </div>
      </div>
    </div>
  </nav>
</header>

<style>
  .site-header {
    background: transparent;
    transition: background 0.4s ease, backdrop-filter 0.4s ease;
  }

  .site-header.is-scrolled {
    background: rgba(2, 6, 23, 0.6);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    mix-blend-mode: normal;
  }

  .nav-link {
    color: var(--color-text-secondary);
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    transition: color 0.2s ease;
    position: relative;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0%;
    height: 1px;
    background: var(--color-text-primary);
    transition: width 0.3s ease;
  }

  .nav-link:hover {
    color: var(--color-text-primary);
  }

  .nav-link:hover::after {
    width: 100%;
  }

  .mobile-menu {
    background: rgba(2, 6, 23, 0.95);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    height: 100vh;
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const header = document.getElementById('site-header');
    const menuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');

    const onScroll = () => {
      if (!header) return;
      if (window.scrollY > 8) {
        header.classList.add('is-scrolled');
      } else {
        header.classList.remove('is-scrolled');
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    menuButton?.addEventListener('click', () => {
      const isExpanded = menuButton.getAttribute('aria-expanded') === 'true';
      menuButton.setAttribute('aria-expanded', (!isExpanded).toString());
      mobileMenu?.classList.toggle('hidden');
    });
  });
</script>
