---
/**
 * Sounio column mark (DS v2, Brand marks page). Single-weight line drawing of
 * an Ionic column: abacus, volutes, fluted shaft, three-step stylobate.
 * Stroke follows currentColor so the mark inherits gold/navy from context.
 */
interface Props {
  size?: number;
  strokeWidth?: number;
  class?: string;
  title?: string;
}
const { size = 32, strokeWidth, class: className, title } = Astro.props;
// Optical stroke compensation: smaller renders get a heavier stroke.
const sw = strokeWidth ?? (size <= 24 ? 4.6 : size <= 40 ? 3.4 : size <= 80 ? 2.6 : 2);
const h = Math.round(size * 1.25);
---

<svg
  width={size}
  height={h}
  viewBox="0 0 64 80"
  fill="none"
  stroke="currentColor"
  stroke-width={sw}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  aria-label={title}
>
  <path d="M6 7h52M10 11h44" />
  <circle cx="12" cy="18" r="6" />
  <circle cx="52" cy="18" r="6" />
  {size >= 40 && <circle cx="12" cy="18" r="2.5" />}
  {size >= 40 && <circle cx="52" cy="18" r="2.5" />}
  <path d="M18 18h28M20 24h24" />
  <path d="M21 24v41M43 24v41M32 27v35" />
  {size >= 40 && <path d="M27 27v35M37 27v35" />}
  <path d="M17 65h30M13 70h38M10 75h44" />
</svg>
