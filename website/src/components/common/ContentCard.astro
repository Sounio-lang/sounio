---
interface Props {
  href: string;
  title: string;
  description: string;
  accent?: string;
  icon?: string;
}

const { href, title, description, accent = 'var(--color-accent-gold)', icon } = Astro.props;
---

<a href={href} class="content-card glass glass-specular group">
  <div class="content-card-top">
    {icon && (
      <svg class="content-card-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" style={`color: ${accent}`}>
        <path stroke-linecap="round" stroke-linejoin="round" d={icon} />
      </svg>
    )}
    <span class="content-card-dot" style={`background: ${accent}`}></span>
  </div>
  <h2 class="font-display content-card-title group-hover:text-white transition-colors" style={`color: ${accent}`}>{title}</h2>
  <p>{description}</p>
  <slot />
</a>

<style>
  .content-card {
    border-radius: var(--radius-xl);
    padding: 1.25rem;
    display: grid;
    gap: 0.6rem;
    text-decoration: none;
    transition: transform 0.25s ease, border-color 0.25s ease;
  }

  .content-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--color-accent-gold) 35%, transparent);
  }

  .content-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .content-card-icon {
    width: 2rem;
    height: 2rem;
  }

  .content-card-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    opacity: 0.5;
  }

  .content-card-title {
    font-size: 1.35rem;
    font-weight: 500;
    margin: 0;
    line-height: 1.25;
  }

  .content-card p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }
</style>
