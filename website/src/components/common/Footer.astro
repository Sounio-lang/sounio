---
import { locales, localeNames, getLocalizedPath, loadTranslations, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = await loadTranslations(locale);
const currentPath = Astro.url.pathname;

const footerSections = [
  {
    title: 'Language',
    links: [
      { href: '/language', label: 'Value Proposition' },
      { href: '/platform', label: 'Compiler + Runtime' },
      { href: '/science', label: 'Scientific Domains' },
    ],
  },
  {
    title: 'Learn',
    links: [
      { href: '/learn', label: 'Documentation Hub' },
      { href: '/learn/getting-started', label: 'Getting Started' },
      { href: '/playground', label: 'Playground' },
      { href: '/packages', label: 'Packages' },
    ],
  },
  {
    title: 'Project',
    links: [
      { href: '/about', label: 'About' },
      { href: '/about/vision', label: 'Vision' },
      { href: '/about/roadmap', label: 'Roadmap' },
      { href: '/releases', label: 'Releases' },
    ],
  },
  {
    title: 'Community',
    links: [
      { href: 'https://github.com/sounio-lang/sounio', label: 'GitHub', external: true },
      { href: 'https://github.com/sounio-lang/sounio/discussions', label: 'Discussions', external: true },
      { href: 'https://github.com/sounio-lang/sounio/issues', label: 'Issues', external: true },
      { href: 'https://github.com/sounio-lang/sounio/blob/main/CONTRIBUTING.md', label: 'Contributing', external: true },
    ],
  },
];
---

<footer class="site-footer mt-auto">
  <div class="container px-4 py-8">
    <div class="seal-strip">
      <img src="/assets/stamps/stamp_monochrome_transparent.png" alt="" aria-hidden="true" width="64" height="64" loading="lazy" decoding="async" />
      <p>Evidence-aware systems engineering for scientific teams shipping high-consequence software.</p>
    </div>

    <div class="footer-grid">
      {footerSections.map((section) => (
        <section>
          <h3>{section.title}</h3>
          <ul>
            {section.links.map((link) => (
              <li>
                <a
                  href={link.external ? link.href : getLocalizedPath(link.href, locale)}
                  {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}

      <section>
        <h3>Language</h3>
        <ul>
          {locales.map((lang) => (
            <li>
              <a
                href={getLocalizedPath(currentPath, lang)}
                class:list={[
                  lang === locale ? 'locale-active' : '',
                ]}
                aria-current={lang === locale ? 'page' : undefined}
              >
                {localeNames[lang]}
              </a>
            </li>
          ))}
        </ul>
      </section>
    </div>

    <div class="footer-bottom">
      <p>{t.footer_copyright}</p>
      <a
        href="https://github.com/sounio-lang/sounio"
        aria-label="GitHub"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--glass-border);
    background: color-mix(in srgb, var(--color-bg-alt) 70%, transparent);
  }

  .seal-strip {
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-xl);
    background: color-mix(in srgb, var(--color-surface-frost) 80%, transparent);
    display: grid;
    gap: 0.7rem;
    justify-items: center;
    text-align: center;
    padding: 0.95rem 1rem;
    margin-bottom: 1.4rem;
  }

  .seal-strip img {
    width: 46px;
    height: 46px;
    opacity: 0.84;
  }

  .seal-strip p {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    max-width: 70ch;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.2rem;
  }

  .footer-grid h3 {
    color: var(--color-text-primary);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 0.5rem;
  }

  .footer-grid ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.32rem;
  }

  .footer-grid a {
    color: var(--color-text-tertiary);
    font-size: 0.88rem;
    transition: color var(--transition-fast);
  }

  .footer-grid a:hover {
    color: var(--color-text-primary);
  }

  .footer-grid a.locale-active {
    color: var(--color-accent-gold);
  }

  .footer-bottom {
    margin-top: 1.4rem;
    padding-top: 1rem;
    border-top: 1px solid var(--glass-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
  }

  .footer-bottom p {
    margin: 0;
    color: var(--color-text-tertiary);
    font-size: 0.79rem;
  }

  .footer-bottom a {
    color: var(--color-text-tertiary);
    transition: color var(--transition-fast);
  }

  .footer-bottom a:hover {
    color: var(--color-text-primary);
  }

  @media (min-width: 980px) {
    .footer-grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 1.6rem;
    }
  }
</style>
