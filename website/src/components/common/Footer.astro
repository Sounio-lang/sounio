---
import SounioMark from './SounioMark.astro';
import { locales, localeNames, getLocalizedPath, loadTranslations, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
  localizedAlternates?: boolean;
}

const { locale, localizedAlternates = true } = Astro.props;
const t = await loadTranslations(locale);
const currentPath = Astro.url.pathname;

type FooterLink = { href: string; label: string; external?: boolean; audience?: 'technical' };

const footerSections: { title: string; links: FooterLink[] }[] = [
  {
    title: t.nav_science,
    links: [
      { href: '/dissertation', label: t.footer_dissertation },
      { href: '/learn/vancomycin-uncertainty', label: 'Vancomycin uncertainty' },
      { href: '/science', label: t.nav_science },
      { href: '/honesty', label: t.nav_honesty },
      { href: '/proof#compile-fail-vancomycin', label: 'Clinical proof' },
    ],
  },
  {
    title: t.nav_learn,
    links: [
      { href: '/learn', label: 'Documentation Hub' },
      { href: '/learn/getting-started', label: 'Getting Started' },
      { href: '/playground', label: 'Playground', audience: 'technical' },
      { href: '/packages', label: t.nav_packages, audience: 'technical' },
    ],
  },
  {
    title: 'Project',
    links: [
      { href: '/about', label: t.nav_about },
      { href: '/about/vision', label: 'Vision' },
      { href: '/about/roadmap', label: 'Roadmap' },
      { href: '/plan', label: 'Plan' },
      { href: '/releases', label: 'Releases' },
    ],
  },
  {
    title: 'Community',
    links: [
      { href: 'https://github.com/sounio-lang/sounio', label: 'GitHub', external: true },
      { href: 'https://github.com/sounio-lang/sounio/discussions', label: 'Discussions', external: true },
      { href: 'https://github.com/sounio-lang/sounio/issues', label: 'Issues', external: true },
      { href: 'https://github.com/sounio-lang/sounio/blob/main/CONTRIBUTING.md', label: 'Contributing', external: true },
    ],
  },
];
---

<footer class="site-footer mt-auto">
  <hr class="sx-spectrum-rule" aria-hidden="true" />
  <div class="container footer-inner">
    <div class="footer-brand">
      <a href={getLocalizedPath('/', locale)} class="footer-lockup" aria-label="Sounio homepage">
        <SounioMark size={44} class="footer-mark" />
        <span class="footer-word">Sounio</span>
      </a>
      <p class="footer-motto" lang="grc">Μέτρον ἄριστον</p>
      <div class="seal-strip" data-for-audience="scientist">
        <img src="/assets/stamps/stamp_monochrome_transparent.png" alt="" aria-hidden="true" width="64" height="64" loading="lazy" decoding="async" />
        <p>{t.footer_seal_scientist}</p>
      </div>
      <div class="seal-strip" data-for-audience="technical">
        <img src="/assets/stamps/stamp_monochrome_transparent.png" alt="" aria-hidden="true" width="64" height="64" loading="lazy" decoding="async" />
        <p>{t.footer_seal_technical}</p>
      </div>
    </div>

    <div class="footer-grid">
      {footerSections.map((section) => (
        <section>
          <h3>{section.title}</h3>
          <ul>
            {section.links.map((link) => (
              <li {...(link.audience === 'technical' ? { 'data-for-audience': 'technical' } : {})}>
                <a
                  href={link.external ? link.href : getLocalizedPath(link.href, locale)}
                  {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}

      {localizedAlternates && (
        <section>
          <h3>Translations</h3>
          <ul>
            {locales.map((lang) => (
              <li>
                <a
                  href={getLocalizedPath(currentPath, lang)}
                  class:list={[
                    lang === locale ? 'locale-active' : '',
                  ]}
                  aria-current={lang === locale ? 'page' : undefined}
                >
                  {localeNames[lang]}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>

    <div class="footer-bottom">
      <p>{t.footer_copyright}</p>
      <a href={getLocalizedPath('/credits', locale)} class="footer-credits-link">
        {t.footer_credits ?? 'Credits and AI disclosure'}
      </a>
      <a
        href="https://github.com/sounio-lang/sounio"
        aria-label="GitHub"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    background: var(--color-surface-canvas);
    border-top: 1px solid var(--color-border-subtle);
  }

  .footer-inner {
    display: grid;
    gap: 2.5rem;
    padding-top: clamp(3rem, 6vw, 4.5rem);
    padding-bottom: 2rem;
  }

  .footer-brand {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    max-width: 30rem;
  }

  .footer-lockup {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    color: var(--color-text-primary);
    width: fit-content;
  }

  .footer-lockup:hover { color: var(--color-text-primary); }

  .footer-lockup :global(.footer-mark) { color: var(--color-accent-gold-text); }

  .footer-word {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 2.75rem;
    line-height: 1;
  }

  .footer-motto {
    margin: 0;
    font-family: var(--font-italic);
    font-style: italic;
    font-size: 1.25rem;
    color: var(--color-text-secondary);
  }

  .seal-strip {
    display: flex;
    gap: 0.85rem;
    align-items: center;
    margin-top: 0.75rem;
  }

  .seal-strip img {
    width: 44px;
    height: 44px;
    flex: none;
    opacity: 0.9;
  }

  :global(html.light) .seal-strip img { filter: invert(1) brightness(0.35); }

  .seal-strip p {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 1.5rem;
  }

  .footer-grid h3 {
    color: var(--color-accent-gold-text);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 0.85rem;
  }

  .footer-grid ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }

  .footer-grid a {
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    transition: color var(--transition-fast);
  }

  .footer-grid a:hover {
    color: var(--color-text-primary);
  }

  .footer-grid a.locale-active {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  .footer-bottom {
    grid-column: 1 / -1;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border-subtle);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem 1.5rem;
  }

  .footer-bottom p {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.8rem;
  }

  .footer-bottom a {
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
  }

  .footer-bottom a:hover {
    color: var(--color-text-primary);
  }

  .footer-credits-link {
    font-size: 0.8rem;
  }

  @media (min-width: 640px) {
    .footer-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  @media (min-width: 1100px) {
    .footer-inner { grid-template-columns: minmax(16rem, 22rem) 1fr; column-gap: 4rem; }
    .footer-grid { grid-template-columns: repeat(5, minmax(0, 1fr)); }
  }
</style>
