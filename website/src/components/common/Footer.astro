---
import { getLocalizedPath, loadTranslations, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = await loadTranslations(locale);

const footerSections = [
  {
    title: t.footer_project,
    links: [
      { href: 'https://github.com/sounio-lang/sounio', label: t.footer_github, external: true },
      { href: '/manifesto', label: t.footer_manifesto },
      { href: '/changelog', label: t.footer_changelog },
      { href: 'https://github.com/sounio-lang/sounio/blob/main/CONTRIBUTING.md', label: t.footer_contributing, external: true },
    ],
  },
  {
    title: t.footer_learn,
    links: [
      { href: '/docs', label: t.footer_docs },
      { href: '/docs/getting-started', label: t.footer_getting_started },
      { href: '/docs/examples', label: t.footer_examples },
      { href: '/docs/language', label: t.footer_guides },
    ],
  },
  {
    title: t.footer_community,
    links: [
      { href: 'https://github.com/sounio-lang/sounio/discussions', label: t.footer_discussions, external: true },
      { href: 'https://github.com/sounio-lang/sounio/issues', label: t.footer_issues, external: true },
      { href: 'https://github.com/sounio-lang/sounio/blob/main/CONTRIBUTING.md', label: t.footer_contributing, external: true },
      { href: 'https://github.com/sounio-lang/sounio/blob/main/CODE_OF_CONDUCT.md', label: t.footer_coc, external: true },
    ],
  },
  {
    title: t.footer_legal,
    links: [
      { href: 'https://github.com/sounio-lang/sounio/blob/main/LICENSE', label: t.footer_license, external: true },
      { href: 'https://plausible.io/privacy-focused-web-analytics', label: t.footer_privacy, external: true },
    ],
  },
];
---

<footer class="bg-[var(--color-navy-900)] text-white/80 py-16 mt-auto">
  <div class="container">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-12">
      {footerSections.map((section) => (
        <div>
          <h3 class="text-white font-semibold mb-4 text-sm uppercase tracking-wider">
            {section.title}
          </h3>
          <ul class="space-y-2">
            {section.links.map((link) => (
              <li>
                <a
                  href={link.external ? link.href : getLocalizedPath(link.href, locale)}
                  class="text-sm hover:text-[var(--color-gold-500)] transition-colors focus-ring inline-flex items-center gap-1"
                  {...(link.external && { target: '_blank', rel: 'noopener noreferrer' })}
                >
                  {link.label}
                  {link.external && (
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="pt-8 border-t border-white/10 flex flex-col md:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <img src="/assets/sounio-logo.svg" alt="" class="h-8 w-8" aria-hidden="true" />
        <span class="text-lg">{t.footer_emoji}</span>
      </div>

      <p class="text-sm text-white/60">
        {t.footer_copyright}
      </p>

      <div class="flex items-center gap-4">
        <a
          href="https://github.com/sounio-lang/sounio"
          class="text-white/60 hover:text-white transition-colors"
          aria-label="GitHub"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
