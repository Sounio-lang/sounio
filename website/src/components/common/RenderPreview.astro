---
interface Props {
  title: string;
  src: string;
  alt: string;
  example: string;
  command: string;
  note: string;
}

const { title, src, alt, example, command, note } = Astro.props;
---

<figure class="render-preview">
  <div class="render-preview__stage">
    <div class="render-preview__frame">
      <img src={src} alt={alt} loading="lazy" decoding="async" />
    </div>
  </div>
  <figcaption class="render-preview__meta">
    <strong>{title}</strong>
    <p>{note}</p>
    <p>
      Source: <code>{example}</code>
    </p>
  </figcaption>
  <pre class="render-preview__command"><code>{command}</code></pre>
</figure>

<style>
  .render-preview {
    margin: 1.75rem 0;
    overflow: hidden;
    border-radius: 22px;
    border: 1px solid rgba(148, 163, 184, 0.2);
    background:
      radial-gradient(circle at top left, rgba(14, 116, 144, 0.18), transparent 40%),
      linear-gradient(180deg, #111827 0%, #0f172a 100%);
    box-shadow: 0 28px 70px -36px rgba(15, 23, 42, 0.9);
  }

  .render-preview__stage {
    padding: 1rem;
    background:
      radial-gradient(circle at 15% 15%, rgba(251, 191, 36, 0.12), transparent 24%),
      radial-gradient(circle at 85% 20%, rgba(34, 197, 94, 0.12), transparent 28%),
      linear-gradient(180deg, rgba(15, 23, 42, 0.92), rgba(2, 6, 23, 0.98));
  }

  .render-preview__frame {
    overflow: hidden;
    border-radius: 14px;
    border: 1px solid rgba(148, 163, 184, 0.18);
    background: #020617;
  }

  .render-preview__frame img {
    display: block;
    width: 100%;
    height: auto;
    image-rendering: pixelated;
  }

  .render-preview__meta {
    padding: 1rem 1rem 0.5rem;
    color: #e2e8f0;
  }

  .render-preview__meta strong {
    display: block;
    font-size: 1rem;
    letter-spacing: 0.01em;
  }

  .render-preview__meta p {
    margin: 0.45rem 0 0;
    color: #cbd5e1;
  }

  .render-preview__meta code,
  .render-preview__command code {
    font-family: 'JetBrains Mono', 'IBM Plex Mono', monospace;
    font-size: 0.92em;
  }

  .render-preview__command {
    margin: 0;
    padding: 0.9rem 1rem 1rem;
    overflow-x: auto;
    color: #bfdbfe;
    background: rgba(2, 6, 23, 0.82);
    border-top: 1px solid rgba(148, 163, 184, 0.14);
  }
</style>
