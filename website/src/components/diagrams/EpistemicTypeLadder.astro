---
const tiers = [
  {
    name: "T",
    description: "Raw scalar or structured value with no attached evidence metadata.",
  },
  {
    name: "Quantity<T, Unit>",
    description: "Value promoted to dimension-aware representation with unit constraints.",
  },
  {
    name: "Knowledge<T>",
    description: "Uncertainty, confidence, and source attribution become part of the value.",
  },
  {
    name: "Knowledge<T, Provenance>",
    description: "Executable value with traceability chain for audit and reproducibility.",
  },
];
---

<div class="ladder-shell glass glass-specular">
  <ol class="ladder-grid">
    {
      tiers.map((tier, index) => (
        <li class="tier-card">
          <span class="tier-step">Tier {index + 1}</span>
          <h3>{tier.name}</h3>
          <p>{tier.description}</p>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .ladder-shell {
    border-radius: var(--radius-2xl);
    padding: clamp(1rem, 3vw, 1.6rem);
  }

  .ladder-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.8rem;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  }

  .tier-card {
    border-radius: var(--radius-lg);
    padding: 0.9rem;
    border: 1px solid color-mix(in srgb, var(--color-accent) 28%, transparent);
    background: color-mix(in srgb, var(--color-bg-elevated) 88%, transparent);
    display: grid;
    gap: 0.45rem;
  }

  .tier-step {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    color: var(--color-accent);
  }

  .tier-card h3 {
    font-size: 1rem;
  }

  .tier-card p {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    line-height: 1.45;
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    gsap.from('.tier-card', {
      y: 20, opacity: 0, stagger: 0.1, duration: 0.55, ease: 'power2.out',
      scrollTrigger: { trigger: '.ladder-shell', start: 'top 78%', once: true },
    });
  });
</script>
