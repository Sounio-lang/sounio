---
const flow = [
  {
    title: "Measure",
    detail: "Capture value + uncertainty + confidence from instrument or model.",
  },
  {
    title: "Propagate",
    detail: "Composition rules carry uncertainty through transformations.",
  },
  {
    title: "Evaluate",
    detail: "Confidence thresholds and effect policies decide admissibility.",
  },
  {
    title: "Act",
    detail: "Execution continues only when evidence satisfies gate criteria.",
  },
];
---

<div class="flow-shell glass glass-specular">
  <div class="flow-track">
    {
      flow.map((node, index) => (
        <>
          <article class="flow-node">
            <span class="flow-index">{index + 1}</span>
            <h3>{node.title}</h3>
            <p>{node.detail}</p>
          </article>
          {index < flow.length - 1 && <span aria-hidden="true" class="flow-arrow">→</span>}
        </>
      ))
    }
  </div>
</div>

<style>
  .flow-shell {
    border-radius: var(--radius-2xl);
    padding: clamp(1rem, 3vw, 1.6rem);
  }

  .flow-track {
    display: grid;
    gap: 0.55rem;
    align-items: center;
    grid-template-columns: 1fr;
  }

  .flow-node {
    border-radius: var(--radius-lg);
    border: 1px solid color-mix(in srgb, var(--color-accent) 28%, transparent);
    background: color-mix(in srgb, var(--color-bg-elevated) 88%, transparent);
    padding: 0.85rem;
    display: grid;
    gap: 0.4rem;
  }

  .flow-index {
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--color-accent-contrast);
    background: var(--color-accent);
  }

  .flow-node h3 {
    font-size: 0.98rem;
  }

  .flow-node p {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.88rem;
    line-height: 1.4;
  }

  .flow-arrow {
    color: var(--color-accent);
    font-weight: 700;
    text-align: center;
    font-size: 1.25rem;
  }

  @media (min-width: 900px) {
    .flow-track {
      grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    gsap.from('.flow-node', {
      y: 18, opacity: 0, stagger: 0.1, duration: 0.5, ease: 'power2.out',
      scrollTrigger: { trigger: '.flow-shell', start: 'top 78%', once: true },
    });
  });
</script>
