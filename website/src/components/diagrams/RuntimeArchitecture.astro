---
const stages = [
  {
    title: "Source + Types",
    detail: "Parser, refinement checks, and uncertainty-aware typing.",
  },
  {
    title: "IR + Effects",
    detail: "Lowering and effect analysis with provenance retention.",
  },
  {
    title: "Backend Select",
    detail: "Native and GPU target selection with capability checks.",
  },
  {
    title: "Runtime Evidence",
    detail: "Execution outputs with confidence and traceability context.",
  },
];
---

<div class="runtime-arch glass glass-specular">
  <div class="flow-grid">
    {
      stages.map((stage, index) => (
        <article class="flow-card">
          <span class="flow-step">Step {index + 1}</span>
          <h3>{stage.title}</h3>
          <p>{stage.detail}</p>
        </article>
      ))
    }
  </div>
</div>

<style>
  .runtime-arch {
    border-radius: var(--radius-2xl);
    padding: clamp(1rem, 3.5vw, 1.8rem);
  }

  .flow-grid {
    display: grid;
    gap: 0.8rem;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
  }

  .flow-card {
    border: 1px solid color-mix(in srgb, var(--color-accent) 24%, transparent);
    border-radius: var(--radius-lg);
    padding: 0.95rem;
    background: color-mix(in srgb, var(--color-bg-elevated) 86%, transparent);
    display: grid;
    gap: 0.45rem;
  }

  .flow-step {
    display: inline-flex;
    width: fit-content;
    padding: 0.24rem 0.55rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    color: var(--color-accent);
    border: 1px solid color-mix(in srgb, var(--color-accent) 45%, transparent);
  }

  .flow-card h3 {
    font-size: 1.02rem;
  }

  .flow-card p {
    color: var(--color-text-secondary);
    font-size: 0.92rem;
    line-height: 1.45;
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    gsap.from('.runtime-arch .flow-card', {
      y: 20, opacity: 0, stagger: 0.1, duration: 0.55, ease: 'power2.out',
      scrollTrigger: { trigger: '.runtime-arch', start: 'top 78%', once: true },
    });
  });
</script>
