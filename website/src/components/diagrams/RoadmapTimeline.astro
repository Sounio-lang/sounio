---
---
<div class="roadmap-timeline-wrap w-full overflow-x-auto" role="img" aria-label="Sounio development roadmap: five phases from language core to production readiness">
  <svg viewBox="0 0 620 550" xmlns="http://www.w3.org/2000/svg" class="w-full min-w-[440px]" aria-hidden="true">

    <!-- Spine segments -->
    <line x1="24" y1="50" x2="24" y2="138" stroke="var(--color-accent-green)" stroke-width="1.5" opacity="0.4"/>
    <line x1="24" y1="158" x2="24" y2="246" stroke="var(--color-accent-orange)" stroke-width="1.5" opacity="0.35"/>
    <line x1="24" y1="266" x2="24" y2="354" stroke="var(--color-accent-orange)" stroke-width="1.5" opacity="0.28"/>
    <line x1="24" y1="374" x2="24" y2="462" stroke="var(--glass-border)" stroke-width="1.5" opacity="0.35"/>

    <!-- PHASE 1 (y=40): COMPLETED -->
    <circle cx="24" cy="40" r="10"
      fill="color-mix(in srgb, var(--color-accent-green) 14%, transparent)"
      stroke="var(--color-accent-green)" stroke-width="1.5"/>
    <path d="M18 40 L22 44 L30 36" fill="none"
      stroke="var(--color-accent-green)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    <line x1="35" y1="40" x2="58" y2="40"
      stroke="var(--color-accent-green)" stroke-width="1" opacity="0.45" stroke-dasharray="3 2"/>
    <text x="66" y="35" fill="var(--color-text-primary)"
      font-family="Inter, sans-serif" font-size="13" font-weight="600">Phase 1 — Language Core</text>
    <text x="66" y="52" fill="var(--color-accent-green)"
      font-family="Inter, sans-serif" font-size="8.5" font-weight="700" letter-spacing="0.12em" opacity="0.72">COMPLETED</text>
    <circle cx="72" cy="68" r="1.8" fill="var(--color-text-tertiary)" opacity="0.38"/>
    <text x="78" y="72" fill="var(--color-text-secondary)"
      font-family="Inter, sans-serif" font-size="11" opacity="0.68">Core language design</text>
    <circle cx="72" cy="84" r="1.8" fill="var(--color-text-tertiary)" opacity="0.38"/>
    <text x="78" y="88" fill="var(--color-text-secondary)"
      font-family="Inter, sans-serif" font-size="11" opacity="0.68">Type system foundations</text>
    <circle cx="72" cy="100" r="1.8" fill="var(--color-text-tertiary)" opacity="0.38"/>
    <text x="78" y="104" fill="var(--color-text-secondary)"
      font-family="Inter, sans-serif" font-size="11" opacity="0.68">Units and effect model</text>

    <!-- PHASE 2 (y=148): COMPLETED -->
    <circle cx="24" cy="148" r="10"
      fill="color-mix(in srgb, var(--color-accent-green) 14%, transparent)"
      stroke="var(--color-accent-green)" stroke-width="1.5"/>
    <path d="M18 148 L22 152 L30 144" fill="none"
      stroke="var(--color-accent-green)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    <line x1="35" y1="148" x2="58" y2="148"
      stroke="var(--color-accent-green)" stroke-width="1" opacity="0.45" stroke-dasharray="3 2"/>
    <text x="66" y="143" fill="var(--color-text-primary)"
      font-family="Inter, sans-serif" font-size="13" font-weight="600">Phase 2 — Epistemic Semantics</text>
    <text x="66" y="160" fill="var(--color-accent-green)"
      font-family="Inter, sans-serif" font-size="8.5" font-weight="700" letter-spacing="0.12em" opacity="0.72">COMPLETED</text>
    <circle cx="72" cy="176" r="1.8" fill="var(--color-text-tertiary)" opacity="0.38"/>
    <text x="78" y="180" fill="var(--color-text-secondary)"
      font-family="Inter, sans-serif" font-size="11" opacity="0.68">Knowledge&lt;T&gt;, Validated&lt;T&gt;, Intervention&lt;T&gt;, Counterfactual&lt;T&gt;</text>
    <circle cx="72" cy="192" r="1.8" fill="var(--color-text-tertiary)" opacity="0.38"/>
    <text x="78" y="196" fill="var(--color-text-secondary)"
      font-family="Inter, sans-serif" font-size="11" opacity="0.68">Uncertainty propagation + causal confidence</text>
    <circle cx="72" cy="208" r="1.8" fill="var(--color-text-tertiary)" opacity="0.38"/>
    <text x="78" y="212" fill="var(--color-text-secondary)"
      font-family="Inter, sans-serif" font-size="11" opacity="0.68">Confidence-gated control flow</text>

    <!-- PHASE 3 (y=256): IN PROGRESS -->
    <circle cx="24" cy="256" r="10"
      fill="color-mix(in srgb, var(--color-accent-orange) 14%, transparent)"
      stroke="var(--color-accent-orange)" stroke-width="1.5"/>
    <circle cx="24" cy="256" r="3.5" fill="var(--color-accent-orange)" opacity="0.78"/>
    <line x1="35" y1="256" x2="58" y2="256"
      stroke="var(--color-accent-orange)" stroke-width="1" opacity="0.45" stroke-dasharray="3 2"/>
    <text x="66" y="251" fill="var(--color-text-primary)"
      font-family="Inter, sans-serif" font-size="13" font-weight="600">Phase 3 — Runtime + Backends</text>
    <text x="66" y="268" fill="var(--color-accent-orange)"
      font-family="Inter, sans-serif" font-size="8.5" font-weight="700" letter-spacing="0.12em" opacity="0.72">IN PROGRESS</text>
    <circle cx="72" cy="284" r="1.8" fill="var(--color-accent-green)" opacity="0.55"/>
    <text x="78" y="288" fill="var(--color-text-secondary)"
      font-family="Inter, sans-serif" font-size="11" opacity="0.68">Self-hosted native ELF codegen + bootstrap ceremony (March 2026) ✓</text>
    <circle cx="72" cy="300" r="1.8" fill="var(--color-text-tertiary)" opacity="0.38"/>
    <text x="78" y="304" fill="var(--color-text-secondary)"
      font-family="Inter, sans-serif" font-size="11" opacity="0.68">GPU / PTX codegen expansion</text>
    <circle cx="72" cy="316" r="1.8" fill="var(--color-text-tertiary)" opacity="0.38"/>
    <text x="78" y="320" fill="var(--color-text-secondary)"
      font-family="Inter, sans-serif" font-size="11" opacity="0.68">WebAssembly improvements</text>

    <!-- PHASE 4 (y=364): IN PROGRESS -->
    <circle cx="24" cy="364" r="10"
      fill="color-mix(in srgb, var(--color-accent-orange) 14%, transparent)"
      stroke="var(--color-accent-orange)" stroke-width="1.5"/>
    <circle cx="24" cy="364" r="3.5" fill="var(--color-accent-orange)" opacity="0.78"/>
    <line x1="35" y1="364" x2="58" y2="364"
      stroke="var(--color-accent-orange)" stroke-width="1" opacity="0.45" stroke-dasharray="3 2"/>
    <text x="66" y="359" fill="var(--color-text-primary)"
      font-family="Inter, sans-serif" font-size="13" font-weight="600">Phase 4 — Tooling Ecosystem</text>
    <text x="66" y="376" fill="var(--color-accent-orange)"
      font-family="Inter, sans-serif" font-size="8.5" font-weight="700" letter-spacing="0.12em" opacity="0.72">IN PROGRESS</text>
    <circle cx="72" cy="392" r="1.8" fill="var(--color-text-tertiary)" opacity="0.38"/>
    <text x="78" y="396" fill="var(--color-text-secondary)"
      font-family="Inter, sans-serif" font-size="11" opacity="0.68">LSP evolution</text>
    <circle cx="72" cy="408" r="1.8" fill="var(--color-text-tertiary)" opacity="0.38"/>
    <text x="78" y="412" fill="var(--color-text-secondary)"
      font-family="Inter, sans-serif" font-size="11" opacity="0.68">Package lifecycle workflows</text>
    <circle cx="72" cy="424" r="1.8" fill="var(--color-text-tertiary)" opacity="0.38"/>
    <text x="78" y="428" fill="var(--color-text-secondary)"
      font-family="Inter, sans-serif" font-size="11" opacity="0.68">Docs and verification pipelines</text>

    <!-- PHASE 5 (y=472): PLANNED -->
    <circle cx="24" cy="472" r="10"
      fill="none" stroke="var(--glass-border)" stroke-width="1.5"/>
    <circle cx="24" cy="472" r="3" fill="var(--color-text-tertiary)" opacity="0.22"/>
    <line x1="35" y1="472" x2="58" y2="472"
      stroke="var(--glass-border)" stroke-width="1" opacity="0.38" stroke-dasharray="3 3"/>
    <text x="66" y="467" fill="var(--color-text-primary)"
      font-family="Inter, sans-serif" font-size="13" font-weight="600" opacity="0.55">Phase 5 — Production Readiness</text>
    <text x="66" y="484" fill="var(--color-text-tertiary)"
      font-family="Inter, sans-serif" font-size="8.5" font-weight="700" letter-spacing="0.12em" opacity="0.5">PLANNED</text>
    <circle cx="72" cy="500" r="1.8" fill="var(--color-text-tertiary)" opacity="0.22"/>
    <text x="78" y="504" fill="var(--color-text-secondary)"
      font-family="Inter, sans-serif" font-size="11" opacity="0.42">Performance stabilization (beta series in progress)</text>
    <circle cx="72" cy="516" r="1.8" fill="var(--color-text-tertiary)" opacity="0.22"/>
    <text x="78" y="520" fill="var(--color-text-secondary)"
      font-family="Inter, sans-serif" font-size="11" opacity="0.42">Security review</text>
    <circle cx="72" cy="532" r="1.8" fill="var(--color-text-tertiary)" opacity="0.22"/>
    <text x="78" y="536" fill="var(--color-text-secondary)"
      font-family="Inter, sans-serif" font-size="11" opacity="0.42">v1.0.0 stable release gate</text>
  </svg>
</div>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    gsap.from('.roadmap-timeline-wrap', {
      opacity: 0, y: 24, duration: 0.7, ease: 'power2.out',
      scrollTrigger: { trigger: '.roadmap-timeline-wrap', start: 'top 80%', once: true },
    });
  });
</script>
