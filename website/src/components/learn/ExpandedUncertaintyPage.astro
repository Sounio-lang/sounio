---
import { getCollection } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { contentIdsMatch } from '../../lib/content-ids';
import { getLocalizedPath, loadTranslations, type Locale } from '../../lib/i18n';

interface Props {
  locale: 'en' | 'ja';
}

const { locale } = Astro.props;
const pageLocale = locale as Locale;
const t = await loadTranslations(pageLocale);
const alternateLocales: Locale[] = ['en', 'ja'];

const en = locale === 'en';

const title = en
  ? 'Expanded uncertainty and coverage factor k | Sounio'
  : '拡張不確かさとは：包含係数kをコードで | Sounio';
const description = en
  ? 'Expanded uncertainty U = k·u_c, with k=2 as the common lab shorthand and k95 from Welch–Satterthwaite in Sounio 3.0 (pre-release) stdlib.'
  : '拡張不確かさ U = k·u_c。よく使う k=2 と、Sounio 3.0 (pre-release) が Welch–Satterthwaite で求める k95 の違い。';
const heading = en
  ? 'Expanded uncertainty and the coverage factor k'
  : '拡張不確かさとは：包含係数 k';

const author = {
  '@type': 'Person',
  name: 'Demetrios Chiuratto Agourakis',
  url: 'https://www.souniolang.org/about/',
  sameAs: [
    'https://orcid.org/0009-0001-8671-8878',
    'https://github.com/agourakis82',
  ],
};

const about = en
  ? [
      { '@type': 'Thing', name: 'expanded uncertainty' },
      { '@type': 'Thing', name: 'coverage factor' },
      { '@type': 'Thing', name: 'Welch–Satterthwaite formula' },
    ]
  : [
      { '@type': 'Thing', name: '拡張不確かさ' },
      { '@type': 'Thing', name: '包含係数' },
      { '@type': 'Thing', name: 'Welch–Satterthwaiteの式' },
    ];

const pagePath = en
  ? '/learn/epistemic/expanded-uncertainty/'
  : '/ja/learn/epistemic/expanded-uncertainty/';

const breadcrumbs = en
  ? [
      { name: 'Learn', href: '/learn/' },
      { name: 'Epistemic', href: '/learn/epistemic/' },
      { name: 'Expanded uncertainty', href: pagePath },
    ]
  : [
      { name: '学習', href: '/ja/learn/' },
      { name: 'エピステミック', href: '/ja/learn/epistemic/' },
      { name: '拡張不確かさ', href: pagePath },
    ];

const faq = en
  ? [
      {
        q: 'What is expanded uncertainty?',
        a: 'Expanded uncertainty is U = k·u_c: the combined standard uncertainty u_c multiplied by a coverage factor k.',
      },
      {
        q: 'Why do certificates use k = 2?',
        a: 'When the effective degrees of freedom are large, k = 2 is the usual laboratory shorthand for about 95% coverage. NIST’s example 2 uses that convention. It is a shorthand for large ν, not a theorem that k is always 2.',
      },
      {
        q: 'How is k95 chosen when ν_eff is small?',
        a: 'From Student’s t at the effective degrees of freedom given by the Welch–Satterthwaite formula. In Sounio 3.0 (pre-release), gum_k95 returns that factor for a combined result. The source table t95 returns 2.776 when ν = 4, and 1.96 when ν is large.',
      },
      {
        q: 'Is Sounio a replacement for my lab pipeline?',
        a: 'No. Sounio 3.0 (pre-release) is a research language. It is not a laboratory reporting pipeline.',
      },
    ]
  : [
      {
        q: '拡張不確かさとは何ですか？',
        a: '拡張不確かさは U = k·u_c です。合成標準不確かさ u_c に包含係数 k を掛けたものです。',
      },
      {
        q: '証明書が k = 2 なのはなぜですか？',
        a: '実効自由度が大きいとき、k = 2 はおよそ 95% の包含を表す、試験所でよく使う略記です。NIST の例 2 がその約束です。ν が大きいときの略記であり、k が常に 2 だという定理ではありません。',
      },
      {
        q: 'ν_eff が小さいとき、k95 はどう決まりますか？',
        a: 'Welch–Satterthwaite の式で得た実効自由度における、Student の t 分布からです。Sounio 3.0 (pre-release) では、gum_k95 が合成結果のその係数を返します。ソースの表 t95 は、ν = 4 で 2.776、ν が大きいときに 1.96 を返します。',
      },
      {
        q: 'Sounio は試験室のパイプラインの置き換えですか？',
        a: 'いいえ。Sounio 3.0 (pre-release) は研究用の言語です。試験室の報告パイプラインではありません。',
      },
    ];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

const headings = en
  ? [
      { id: 'u-equals-kuc', text: 'U = k·u_c, and what k = 2 means', depth: 2 },
      { id: 'when-k-is-not-2', text: 'When k is not 2 — Welch–Satterthwaite and k95', depth: 2 },
      { id: 'stdlib', text: 'In the Sounio 3.0 (pre-release) stdlib', depth: 2 },
      { id: 'limits', text: 'Limits', depth: 2 },
      { id: 'faq', text: 'FAQ', depth: 2 },
    ]
  : [
      { id: 'u-equals-kuc', text: 'U = k·u_c と、k = 2 が意味すること', depth: 2 },
      { id: 'when-k-is-not-2', text: 'k が 2 でないとき — Welch–Satterthwaite と k95', depth: 2 },
      { id: 'stdlib', text: 'Sounio 3.0 (pre-release) の標準ライブラリ', depth: 2 },
      { id: 'limits', text: '限界', depth: 2 },
      { id: 'faq', text: 'よくある質問', depth: 2 },
    ];

const program = `use epistemic::gum::*

fn main() -> i32 with IO, Mut, Div, Panic {
    // Certificate reports an expanded uncertainty U=0.20 with k=2
    let u_b = gum_type_b_expanded(0.20, 2.0)
    let r = gum_combine2(98.3, gum_type_a(0.30, 5), u_b)
    print(gum_std_u(r))
    print("\\n")
    print(gum_k95(r))
    print("\\n")
    print(gum_u95(r))
    print("\\n")
    return 0
}`;

// Three lines from ./bin/souc run of `program`. Do not edit without re-running.
const stdout = `0.167332
2.228000
0.372816`;

const commands = `export SOUNIO_STDLIB_PATH="$(pwd)/stdlib"
./bin/souc check expanded_uncertainty.sio
./bin/souc run expanded_uncertainty.sio`;

const allDocs = await getCollection('docs');

function docTitle(slug: string, fallback: string): string {
  const candidates = [
    `${locale}/${slug}.mdx`,
    `${locale}/${slug}/index.mdx`,
    `en/${slug}.mdx`,
    `en/${slug}/index.mdx`,
  ];
  const found = candidates
    .map((id) => allDocs.find((doc) => contentIdsMatch(doc.id, id)))
    .find(Boolean);
  return found?.data.title ?? fallback;
}

function docHref(slug: string): string {
  return getLocalizedPath(`/learn/${slug}`, pageLocale);
}

const toolsHref = '/learn/epistemic/uncertainty-tools-compared/';
const mpHref = '/learn/epistemic/sounio-vs-mp-units-vs-physure/';
const unitsHref = docHref('language/units-and-uncertainty');
const honestyHref = '/honesty/';
const featureHref = docHref('feature-status');
const playgroundHref = getLocalizedPath('/playground/', pageLocale);

const sidebar = [
  {
    title: t.docs_sidebar_getting_started,
    items: [
      { title: docTitle('getting-started', 'Getting Started'), href: docHref('getting-started') },
      { title: docTitle('getting-started/hello-world', 'Hello World'), href: docHref('getting-started/hello-world') },
      { title: docTitle('getting-started/first-program', 'First Program'), href: docHref('getting-started/first-program') },
    ],
  },
  {
    title: t.docs_sidebar_language,
    items: [
      { title: docTitle('language', 'Language Overview'), href: docHref('language') },
      { title: docTitle('language/variables', 'Variables & Types'), href: docHref('language/variables') },
      { title: docTitle('language/functions', 'Functions'), href: docHref('language/functions') },
      { title: docTitle('language/control-flow', 'Control Flow'), href: docHref('language/control-flow') },
      { title: docTitle('language/units-and-uncertainty', 'Units and Uncertainty'), href: unitsHref },
    ],
  },
  {
    title: t.docs_sidebar_epistemic,
    items: [
      { title: docTitle('epistemic', 'Epistemic Overview'), href: docHref('epistemic') },
      { title: docTitle('epistemic/knowledge', 'Knowledge<T>'), href: docHref('epistemic/knowledge') },
      { title: docTitle('epistemic/uncertainty', 'Uncertainty'), href: docHref('epistemic/uncertainty') },
      { title: en ? 'Uncertainty tools compared' : '不確かさツールの比較', href: toolsHref },
      { title: en ? 'Expanded uncertainty' : '拡張不確かさ', href: pagePath },
      { title: docTitle('epistemic/provenance', 'Provenance'), href: docHref('epistemic/provenance') },
      { title: 'Sounio vs mp-units vs physure', href: mpHref },
    ],
  },
  {
    title: t.docs_sidebar_reference,
    items: [
      { title: docTitle('stdlib', 'Standard Library'), href: docHref('stdlib') },
      { title: docTitle('tooling', 'Tooling'), href: docHref('tooling') },
      { title: docTitle('examples', 'Examples'), href: docHref('examples') },
    ],
  },
];
---

<DocsLayout
  title={title}
  description={description}
  heading={heading}
  headings={headings}
  schema={schema}
  breadcrumbs={breadcrumbs}
  dateModified="2026-11-16"
  articleHeadline={heading}
  articleAbout={about}
  articleAuthor={author}
  sidebar={sidebar}
  alternateLocales={alternateLocales}
>
  {en ? (
    <p slot="answer" class="text-lg text-[var(--color-text-muted)]">
      Expanded uncertainty is U = k·u_c: the combined standard uncertainty scaled by a coverage factor k. Laboratories often take k = 2 as a ~95% shorthand when the effective degrees of freedom are large (<a href="https://physics.nist.gov/cuu/Uncertainty/examples.html">NIST</a>). When ν_eff is small, k comes from the t-distribution via the Welch–Satterthwaite formula. Sounio 3.0 (pre-release) exposes both ends in the stdlib: <code>gum_type_b_expanded(U, k)</code> recovers u from a certificate, and <code>gum_k95</code> returns the 95% coverage factor of a combined result.
    </p>
  ) : (
    <p slot="answer" class="text-lg text-[var(--color-text-muted)]">
      拡張不確かさとは、合成標準不確かさに包含係数 k を掛けた U = k·u_c です。実効自由度が大きいとき、試験所はおよそ 95% の略記として k = 2 を使うことが多いです（<a href="https://physics.nist.gov/cuu/Uncertainty/examples.html">NIST</a>）。ν_eff が小さいときは、Welch–Satterthwaite の式で求めた自由度から t 分布の k を取ります。Sounio 3.0 (pre-release) の標準ライブラリは両端を出しています。<code>gum_type_b_expanded(U, k)</code> は証明書の U と k から u を戻し、<code>gum_k95</code> は合成結果の 95% 包含係数を返します。
    </p>
  )}

  {en ? (
    <>
      <h2 id="u-equals-kuc">U = k·u_c, and what k = 2 means</h2>
      <p>
        Expanded uncertainty scales the combined standard uncertainty by a coverage factor:
      </p>
      <p>U = k · u_c</p>
      <p>
        k = 2 is what laboratories write when the degrees of freedom are large enough that an interval of about 95% is the intended reading. That is a convention for large ν. It is not a theorem that every budget has k = 2.
      </p>
      <p>
        <a href="https://physics.nist.gov/cuu/Uncertainty/examples.html">NIST’s example 2</a> reports a standard mass as m_s = (100.021 47 ± 0.000 70) g, with U = k u_c, k = 2, a confidence of about 95%, and u_c = 0.35 mg.
      </p>
      <p>
        <a href="https://sisu.ut.ee/measurement/44-expanded-uncertainty/">University of Tartu, §4.4</a>, written for chemists, uses the same identity U = u_c · k. In that example, k = 2 takes 0.019 ml to 0.038 ml. The notes call k = 2 the most common way to report an expanded uncertainty.
      </p>
      <p>
        Those two pages define the shorthand. They do not show a program. The neighbouring page for standard uncertainty is the <a href={toolsHref}>comparison of uncertainty tools</a>. The guide to <code>Knowledge&lt;T&gt;</code> and compile-time units is <a href={unitsHref}>units and standard uncertainty together</a>.
      </p>

      <h2 id="when-k-is-not-2">When k is not 2 — Welch–Satterthwaite and k95</h2>
      <p>
        When ν_eff is small, k comes from Student’s t and is larger than 2. The Welch–Satterthwaite formula builds ν_eff from the components. k95 is the 95% point of that t distribution.
      </p>
      <p>
        In <a href="https://github.com/Sounio-lang/sounio/blob/main/stdlib/epistemic/gum.sio"><code>stdlib/epistemic/gum.sio</code></a>, <code>t95</code> (lines 45–70) is that table. The branch <code>dof == 4</code> returns 2.776 (line 50). A large degree of freedom falls through to 1.96 (line 69). <code>dof_to_i64</code> (lines 95–99) sends a degree of freedom above 1e8, the file’s infinity, to 10000, and that integer takes the 1.96 branch. The comment on the helper says why the conversion rounds to nearest: a Welch–Satterthwaite value sitting just below an integer must not select the previous row.
      </p>
      <p>
        <a href="https://github.com/Sounio-lang/sounio/blob/main/tests/epistemic_trust/witness_gum_k95.sio"><code>tests/epistemic_trust/witness_gum_k95.sio</code></a> is a different budget. It pairs a Type A component of n = 5, so ν = n − 1 = 4, with a negligible Type B, and it is written to reach the 2.776 row. That file is not the program on this page. Its output is not shown here.
      </p>
      <p>
        <a href="https://docs.jmrp.io/phonometry/signals/metrology/gum-uncertainty/">phonometry</a> is the page among these three that shows the same idea in Python: U = k u_c, and k = t_p(ν_eff) from Welch–Satterthwaite. Their example has ν_eff ≈ 16 and k = 2.11, not 1.96. The same documentation says that if the budget is correlated and the degrees of freedom are finite, <code>effective_dof</code> is NaN and <code>expanded()</code> requires <code>coverage_factor_override</code>, because the GUM defines Welch–Satterthwaite for independent inputs. That is phonometry’s account. What <code>gum.sio</code> does with correlated inputs was not checked for this page, and it is not claimed here.
      </p>

      <h2 id="stdlib">In the Sounio 3.0 (pre-release) stdlib</h2>
      <p>
        The import is <code>use epistemic::gum::*</code>. The library implements the two directions separately.
      </p>
      <p>
        A certificate that already states U and k is turned back into a standard uncertainty by <code>gum_type_b_expanded</code> (lines 137–140). When k &gt; 0, <code>std_u = expanded_u / k</code>. The degree of freedom stored on that component is 1e9, the file’s stand-in for infinity.
      </p>
      <p>
        A budget combined inside the library goes the other way. <code>gum_combine2</code> (lines 191–197) forms the combined standard uncertainty and the Welch–Satterthwaite ν_eff. The formula comment is at line 176, and the two-component function is <code>ws2</code> (lines 178–188). <code>gum_result_from_parts</code> then sets <code>u95</code> to k95 times that combined standard uncertainty (line 170). <code>gum_u95</code> (line 261) returns the field. <code>gum_k95</code> (line 263) returns <code>r.k95</code>.
      </p>
      <p>
        This example does not wrap the values in <code>Knowledge&lt;T&gt;</code>. That type, and units, live on the units page linked above.
      </p>
      <p>The program that was checked and run:</p>
      <pre><code>{program}</code></pre>
      <p>
        <code>./bin/souc check</code> reported OK, then <code>./bin/souc run</code> printed the three lines below, in the order of the three <code>print</code> calls: <code>gum_std_u</code>, <code>gum_k95</code>, <code>gum_u95</code>. <code>SOUNIO_STDLIB_PATH</code> pointed at the repository <code>stdlib</code>. The source file for that run lived outside the tree; saving the program above as <code>expanded_uncertainty.sio</code> and using the commands below is the same invocation.
      </p>
      <pre><code>{commands}</code></pre>
      <pre><code>{stdout}</code></pre>
      <p>
        The Type A call is <code>gum_type_a(0.30, 5)</code>. That function sets the component’s degree of freedom to n − 1 when n &gt; 1 (line 116), so this component’s degree of freedom is 4. <code>gum_type_b_expanded</code> stores 1e9 (line 140). The coverage factor printed above is 2.228000, which is the value <code>t95</code> returns for <code>dof == 10</code> (line 56). It is not the certificate’s k = 2, and it is not 2.776. ν_eff itself is not printed.
      </p>

      <h2 id="limits">Limits</h2>
      <p>
        Sounio 3.0 (pre-release) is a research language. This page is not a laboratory reporting pipeline. The public account of the compiler is <a href={honestyHref}>honesty</a> and <a href={featureHref}>feature status</a>.
      </p>
      <p>
        Procedures other than the first-order combination and the t table in <code>gum.sio</code> are outside this page. Behaviour of ν_eff when the inputs are correlated was not checked in this stdlib for this page.
      </p>
      <p>
        <a href={unitsHref}>units and standard uncertainty together</a> describes <code>Knowledge&lt;T&gt;</code> and units. This page does not repeat that guide. The <a href={toolsHref}>comparison of uncertainty tools</a> is the table of standard uncertainty.
      </p>
      <p>
        A short program can be edited in the <a href={playgroundHref}>playground</a>. The three lines above were printed by <code>./bin/souc run</code>, not by that editor.
      </p>

      <h2 id="faq">FAQ</h2>
    </>
  ) : (
    <>
      <h2 id="u-equals-kuc">U = k·u_c と、k = 2 が意味すること</h2>
      <p>拡張不確かさは、合成標準不確かさに包含係数を掛けたものです。</p>
      <p>U = k · u_c</p>
      <p>
        k = 2 は、自由度が大きく、およそ 95% の区間を意図しているときに試験所が書く値です。ν が大きいときの約束であり、あらゆるバジェットで k が 2 だという定理ではありません。
      </p>
      <p>
        <a href="https://physics.nist.gov/cuu/Uncertainty/examples.html">NIST の例 2</a>は、標準分銅の質量を m_s = (100.021 47 ± 0.000 70) g と書き、U = k u_c、k = 2、信頼の水準はおよそ 95%、u_c = 0.35 mg としています。
      </p>
      <p>
        化学系の読者向けの<a href="https://sisu.ut.ee/measurement/44-expanded-uncertainty/">タルトゥ大学 §4.4</a>も、同じ関係 U = u_c · k を使います。その例では k = 2 により 0.019 ml が 0.038 ml になります。k = 2 を、拡張不確かさを報告する最も一般的な形だと書いています。
      </p>
      <p>
        この二つは略記の定義です。プログラムは載っていません。標準不確かさの隣のページは<a href={toolsHref} hreflang="en">不確かさツールの比較</a>（英語）です。<code>Knowledge&lt;T&gt;</code> とコンパイル時の単位は、<a href={unitsHref}>単位と標準不確かさをあわせて</a>にあります。
      </p>

      <h2 id="when-k-is-not-2">k が 2 でないとき — Welch–Satterthwaite と k95</h2>
      <p>
        ν_eff が小さいとき、k は Student の t 分布から取り、2 より大きくなります。Welch–Satterthwaite の式が成分から ν_eff を作り、k95 はその t 分布の 95% 点です。
      </p>
      <p>
        <a href="https://github.com/Sounio-lang/sounio/blob/main/stdlib/epistemic/gum.sio"><code>stdlib/epistemic/gum.sio</code></a> の <code>t95</code>（45–70 行）がその表です。<code>dof == 4</code> の分岐は 2.776 を返します（50 行）。自由度が大きいと 1.96 に落ちます（69 行）。<code>dof_to_i64</code>（95–99 行）は、1e8 を超える自由度、つまりこのファイルにおける無限大を 10000 に写し、その整数は 1.96 の分岐に入ります。ヘルパーのコメントは、四捨五入する理由を書いています。Welch–Satterthwaite の値が整数のすぐ下に来たとき、一つ前の行を選んではいけない、という話です。
      </p>
      <p>
        <a href="https://github.com/Sounio-lang/sounio/blob/main/tests/epistemic_trust/witness_gum_k95.sio"><code>tests/epistemic_trust/witness_gum_k95.sio</code></a> は別のバジェットです。n = 5 のタイプ A、したがって ν = n − 1 = 4 と、無視できるタイプ B を組んで、2.776 の行に届くように書いてあります。このページのプログラムではなく、その出力はここには出しません。
      </p>
      <p>
        <a href="https://docs.jmrp.io/phonometry/signals/metrology/gum-uncertainty/">phonometry</a> は、この三つのうち同じ考えを Python で見せているページです。U = k u_c で、k は Welch–Satterthwaite の ν_eff に対する t_p です。そこの例は ν_eff ≈ 16 で k = 2.11 であり、1.96 ではありません。同じ文書は、バジェットが相関を持ち自由度が有限なら <code>effective_dof</code> は NaN になり、<code>expanded()</code> は <code>coverage_factor_override</code> を要求する、と書いています。GUM が Welch–Satterthwaite を独立な入力について定義しているからです。これは phonometry の説明です。<code>gum.sio</code> が相関のある入力に対して何をするかは、このページでは確認しておらず、ここには書きません。
      </p>

      <h2 id="stdlib">Sounio 3.0 (pre-release) の標準ライブラリ</h2>
      <p>
        インポートは <code>use epistemic::gum::*</code> です。ライブラリは二つの向きを分けて実装しています。
      </p>
      <p>
        すでに U と k が書いてある証明書から標準不確かさへ戻すのが <code>gum_type_b_expanded</code>（137–140 行）です。k &gt; 0 のとき <code>std_u = expanded_u / k</code> です。その成分に格納する自由度は 1e9 で、このファイルにおける無限大の代理です。
      </p>
      <p>
        ライブラリの中で合成するバジェットは逆向きです。<code>gum_combine2</code>（191–197 行）が合成標準不確かさと Welch–Satterthwaite の ν_eff を作ります。式のコメントは 176 行、二成分の関数は <code>ws2</code>（178–188 行）です。続けて <code>gum_result_from_parts</code> が <code>u95</code> を、k95 と合成標準不確かさの積にします（170 行）。<code>gum_u95</code>（261 行）がそのフィールドを返し、<code>gum_k95</code>（263 行）が <code>r.k95</code> を返します。
      </p>
      <p>
        この例は値を <code>Knowledge&lt;T&gt;</code> で包みません。その型と単位は、上でリンクした単位のページにあります。
      </p>
      <p>型検査して実行したプログラムです。コメントは英語のままです。</p>
      <pre><code>{program}</code></pre>
      <p>
        <code>./bin/souc check</code> は OK で、続く <code>./bin/souc run</code> が下の三行を、三つの <code>print</code> の順に出しました。<code>gum_std_u</code>、<code>gum_k95</code>、<code>gum_u95</code> です。<code>SOUNIO_STDLIB_PATH</code> はリポジトリの <code>stdlib</code> を指していました。その実行のファイルはツリーの外に置きました。上のプログラムを <code>expanded_uncertainty.sio</code> として保存し、下のコマンドを使うのが同じ呼び出しです。
      </p>
      <pre><code>{commands}</code></pre>
      <pre><code>{stdout}</code></pre>
      <p>
        タイプ A の呼び出しは <code>gum_type_a(0.30, 5)</code> です。この関数は n &gt; 1 のとき成分の自由度を n − 1 にします（116 行）。したがってこの成分の自由度は 4 です。<code>gum_type_b_expanded</code> は 1e9 を格納します（140 行）。上に出た包含係数は 2.228000 で、<code>t95</code> が <code>dof == 10</code> に対して返す値です（56 行）。証明書の k = 2 ではなく、2.776 でもありません。ν_eff そのものは印字していません。
      </p>

      <h2 id="limits">限界</h2>
      <p>
        Sounio 3.0 (pre-release) は研究用の言語です。このページは試験室の報告パイプラインではありません。コンパイラについて公開している説明は <a href={honestyHref}>honesty</a> と <a href={featureHref}>機能の状態</a> です。
      </p>
      <p>
        <code>gum.sio</code> の一次の合成と t の表以外の手続きは、このページの外です。入力が相関しているときの ν_eff の挙動は、この標準ライブラリについては確認していません。
      </p>
      <p>
        <a href={unitsHref}>単位と標準不確かさをあわせて</a>が <code>Knowledge&lt;T&gt;</code> と単位を扱います。ここではその解説を繰り返しません。標準不確かさの表は<a href={toolsHref} hreflang="en">不確かさツールの比較</a>です。
      </p>
      <p>
        短いプログラムは <a href={playgroundHref}>プレイグラウンド</a>で編集できます。上の三行は <code>./bin/souc run</code> が印字したもので、そのエディタの出力ではありません。
      </p>

      <h2 id="faq">よくある質問</h2>
    </>
