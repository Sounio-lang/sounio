---
import { uncertaintyPageFor } from '../../lib/uncertainty-page.mjs';

interface Props {
  locale: 'en' | 'pt';
}

const { locale } = Astro.props;
const page = uncertaintyPageFor(locale);
---

{
  page && (
    <dl>
      {page.faq.map(({ question, answer }) => (
        <div>
          <dt>{question}</dt>
          <dd>{answer}</dd>
        </div>
      ))}
    </dl>
  )
}
