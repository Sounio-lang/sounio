---
import { EFFECT_CHECKER_PAGE } from '../../lib/search-appearance.mjs';
---

<aside class="effect-guide-callout" role="note">
  <p>
    {EFFECT_CHECKER_PAGE.calloutBefore}<a href={EFFECT_CHECKER_PAGE.calloutHref}>{EFFECT_CHECKER_PAGE.calloutLink}</a>{EFFECT_CHECKER_PAGE.calloutAfter}
  </p>
</aside>

<style>
  .effect-guide-callout {
    margin-top: 1rem;
    padding: 0.9rem 1rem;
    border: 1px solid color-mix(in srgb, var(--color-accent-gold) 55%, transparent);
    border-left-width: 3px;
    border-radius: 0.65rem;
    background: color-mix(in srgb, var(--color-accent-gold) 12%, transparent);
  }

  .effect-guide-callout p {
    margin: 0;
    max-width: 68ch;
    color: var(--color-text-primary);
    font-size: 1.05rem;
    line-height: 1.5;
  }

  .effect-guide-callout a {
    color: var(--color-accent-gold-soft);
    font-weight: 650;
    text-decoration: underline;
    text-underline-offset: 0.16em;
  }
</style>
