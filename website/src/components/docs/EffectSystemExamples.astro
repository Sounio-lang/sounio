---
import { readFileSync } from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

interface Props {
  group: 'checked' | 'declared' | 'parsed';
}

const { group } = Astro.props;

const repoRoot = path.resolve(fileURLToPath(new URL('.', import.meta.url)), '../../../..');
const utm = '?utm_source=souniolang&utm_medium=docs&utm_campaign=effects';

const files = group === 'checked'
  ? ['tests/compile-fail/effect_io_in_pure.sio']
  : group === 'declared'
    ? [
        'tests/run-pass/user_effect_declared_madaros.sio',
        'tests/compile-fail/user_effect_missing_in_caller_madaros.sio',
      ]
    : [
        'tests/compile-fail/effects_unhandled.sio',
        'tests/run-pass/effect_handler_basic.sio',
      ];

const samples = files.map((rel) => ({
  rel,
  source: readFileSync(path.join(repoRoot, rel), 'utf8'),
  href: `https://github.com/Sounio-lang/sounio/blob/main/${rel}${utm}`,
}));
---

{samples.map(({ rel, source, href }) => (
  <figure>
    <figcaption>
      <code>{rel}</code>
      {' '}
      <a href={href}>source</a>
    </figcaption>
    <pre data-language="sio"><code>{source}</code></pre>
  </figure>
))}
