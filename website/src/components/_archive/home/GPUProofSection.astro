---
import { getLocalizedPath, type Locale } from '../../lib/i18n';
import { getProofData } from '../../lib/proofData';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const proof = getProofData();

const proofPoints = [
  {
    label: 'Compiler',
    value: 'Kretikos',
    detail: 'Bounded GPU compiler lane with artifact-backed claims.',
  },
  {
    label: 'Semantic object',
    value: 'Provenance field',
    detail: 'Confidence lattice, uncertainty widening, tensor pulse.',
  },
  {
    label: 'Product role',
    value: 'Storefront proof',
    detail: 'A visible GPU thesis, not decorative motion.',
  },
];
---

<section class="section-shell gpu-proof-section">
  <div class="container">
    <div class="gpu-proof-shell glass glass-specular">
      <div class="gpu-proof-copy">
        <span class="gpu-proof-kicker">Kretikos GPU Compiler</span>
        <h2 class="section-heading">A GPU compiler lane with visible boundaries.</h2>
        <p class="gpu-proof-lead">
          Kretikos (Κρητικός) = Cretan. Like Ariadne's thread through the Labyrinth, this is Sounio's named
          path for GPU compiler work: checked thread builtins, in-tree PTX/CUBIN templates, and artifact bundles with hashes.
        </p>
        <p class="gpu-proof-body">
          The browser-side provenance field is the storefront counterpart to the GPU backend living in
          self-hosted/gpu/. The point is to make the GPU thesis legible while keeping each claim inside the
          current artifact boundary.
        </p>

        <div class="gpu-proof-grid" role="list" aria-label="WebGPU proof properties">
          {proofPoints.map((item) => (
            <article class="gpu-proof-pill" role="listitem">
              <span>{item.label}</span>
              <strong>{item.value}</strong>
              <p>{item.detail}</p>
            </article>
          ))}
        </div>

        <div class="gpu-proof-actions">
          <a href={getLocalizedPath('/science/gpu', locale)} class="hero-cta primary">Open the full GPU showcase</a>
          <a href={getLocalizedPath('/proof', locale)} class="hero-cta secondary">See artifact-backed proof</a>
        </div>
      </div>

      <div class="gpu-proof-evidence glass glass-elevated">
        <span class="gpu-proof-evidence-kicker">Artifact-backed evidence</span>
        <div class="gpu-proof-evidence-grid" role="list" aria-label="GPU proof evidence">
          <article class="gpu-proof-stat" role="listitem">
            <span>Public checks</span>
            <strong>{proof.gpu.publicPassCount}/{proof.gpu.publicCheckCount}</strong>
            <p>Current public GPU contract passing in the checked snapshot.</p>
          </article>
          <article class="gpu-proof-stat" role="listitem">
            <span>Attested targets</span>
            <strong>{proof.gpu.attestedTargetCount}</strong>
            <p>Binary targets with published attestation evidence.</p>
          </article>
          <article class="gpu-proof-stat" role="listitem">
            <span>Native lanes</span>
            <strong>{proof.gpu.nativeLanePassCount}/{proof.gpu.nativeLaneCount}</strong>
            <p>Required native execution lanes currently passing.</p>
          </article>
          <article class="gpu-proof-stat" role="listitem">
            <span>Release surface</span>
            <strong>v{proof.release.version}</strong>
            <p>{proof.release.statusLabel} for the currently surfaced core release.</p>
          </article>
        </div>
        <div class="gpu-proof-notes">
          <div>
            <span>Current source version</span>
            <strong>{proof.gpu.sourceVersion}</strong>
          </div>
          <div>
            <span>Runtime posture</span>
            <strong>{proof.gpu.status}</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .gpu-proof-shell {
    border-radius: var(--radius-2xl);
    padding: clamp(1.1rem, 3vw, 1.5rem);
    display: grid;
    gap: 1.1rem;
    background:
      radial-gradient(640px 280px at 100% 0%, color-mix(in srgb, var(--color-accent-gold) 18%, transparent), transparent 60%),
      linear-gradient(160deg, color-mix(in srgb, var(--color-bg-alt) 92%, transparent), color-mix(in srgb, #07162c 72%, transparent));
  }

  .gpu-proof-copy {
    display: grid;
    gap: 0.85rem;
  }

  .gpu-proof-kicker {
    color: var(--color-accent-gold-soft);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.72rem;
    font-weight: 700;
  }

  .gpu-proof-lead,
  .gpu-proof-body {
    color: var(--color-text-secondary);
    max-width: 62ch;
  }

  .gpu-proof-lead {
    font-size: 1rem;
  }

  .gpu-proof-body {
    font-size: 0.92rem;
  }

  .gpu-proof-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0.75rem;
    margin-top: 0.2rem;
  }

  .gpu-proof-pill {
    border-radius: var(--radius-xl);
    border: 1px solid var(--glass-border);
    background: color-mix(in srgb, var(--color-surface-frost) 88%, transparent);
    padding: 0.9rem;
    display: grid;
    gap: 0.22rem;
  }

  .gpu-proof-pill span {
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.68rem;
  }

  .gpu-proof-pill strong {
    color: var(--color-text-primary);
    font-size: 1.02rem;
  }

  .gpu-proof-pill p {
    color: var(--color-text-secondary);
    font-size: 0.8rem;
  }

  .gpu-proof-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.15rem;
  }

  .gpu-proof-evidence {
    border-radius: var(--radius-2xl);
    padding: 1rem;
    display: grid;
    gap: 0.9rem;
    background:
      radial-gradient(460px 200px at 100% 0%, color-mix(in srgb, var(--color-accent-gold) 16%, transparent), transparent 62%),
      color-mix(in srgb, var(--color-surface-frost) 86%, transparent);
  }

  .gpu-proof-evidence-kicker {
    color: var(--color-accent-gold-soft);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.68rem;
    font-weight: 700;
  }

  .gpu-proof-evidence-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0.75rem;
  }

  .gpu-proof-stat {
    border-radius: var(--radius-xl);
    border: 1px solid var(--glass-border);
    background: color-mix(in srgb, var(--color-bg-alt) 80%, transparent);
    padding: 0.95rem;
    display: grid;
    gap: 0.22rem;
  }

  .gpu-proof-stat span,
  .gpu-proof-notes span {
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.68rem;
  }

  .gpu-proof-stat strong,
  .gpu-proof-notes strong {
    color: var(--color-text-primary);
    font-size: 1.1rem;
  }

  .gpu-proof-stat p {
    color: var(--color-text-secondary);
    font-size: 0.8rem;
  }

  .gpu-proof-notes {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  }

  .gpu-proof-notes > div {
    border-top: 1px solid color-mix(in srgb, var(--glass-border) 88%, transparent);
    padding-top: 0.75rem;
    display: grid;
    gap: 0.16rem;
  }

  @media (min-width: 1080px) {
    .gpu-proof-shell {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
      align-items: start;
    }
  }
</style>
