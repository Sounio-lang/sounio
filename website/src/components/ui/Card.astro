---
interface Props {
  class?: string;
  pad?: 'md' | 'lg' | 'none';
  accent?: string;
  glass?: boolean;
}

const { class: className = '', pad = 'md', accent, glass = true } = Astro.props;

const pads = {
  md: 'p-6',
  lg: 'p-8',
  none: '',
};

const style = accent ? `--card-accent: ${accent};` : undefined;
---

<div
  style={style}
  class={`rounded-[var(--radius-xl)] ${glass ? 'glass-elevated' : 'border border-[var(--color-line)] bg-[var(--color-surface-raise)]'} ${accent ? 'border-l-2 !border-l-[var(--card-accent)]' : ''} ${pads[pad]} transition-all duration-300 hover:border-[var(--color-line-strong)] hover:shadow-[0_12px_32px_-8px_rgba(0,0,0,0.3)] ${className}`}
>
  <slot />
</div>
