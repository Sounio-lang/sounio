---
interface Props {
  variant?: 'navy' | 'white' | 'transparent';
  size?: number;
  class?: string;
}

const { variant = 'transparent', size = 34, class: className = '' } = Astro.props;

const srcs = {
  navy: '/assets/stamps/stamp_monochrome_on_navy.png',
  white: '/assets/stamps/stamp_monochrome_on_white.png',
  transparent: '/assets/stamps/stamp_monochrome_transparent.png',
};
---

<img
  src={srcs[variant]}
  width={size}
  height={size}
  alt=""
  aria-hidden="true"
  loading="lazy"
  class={`opacity-75 ${className}`}
/>
