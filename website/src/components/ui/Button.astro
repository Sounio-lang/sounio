---
interface Props {
  href?: string;
  variant?: 'primary' | 'ghost' | 'subtle';
  size?: 'md' | 'sm';
  class?: string;
  type?: 'button' | 'submit';
  external?: boolean;
}

const { href, variant = 'primary', size = 'md', class: className = '', type = 'button', external = false } = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-full font-semibold transition-all duration-200 hover:-translate-y-[2px] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent-gold)] w-fit';

const sizes = {
  md: 'px-[1.35rem] py-[0.75rem] text-[0.92rem]',
  sm: 'px-[1rem] py-[0.5rem] text-[0.82rem]',
};

const variants = {
  primary:
    'bg-[var(--gradient-gold)] text-[#10233E] border border-[color-mix(in_srgb,var(--color-accent-gold)_65%,transparent)] shadow-[0_8px_24px_-8px_color-mix(in_srgb,var(--color-accent-gold)_50%,transparent)] hover:shadow-[0_12px_32px_-8px_color-mix(in_srgb,var(--color-accent-gold)_65%,transparent)]',
  ghost:
    'border border-[var(--glass-border)] bg-[color-mix(in_srgb,var(--color-surface-frost)_84%,transparent)] text-[var(--color-ink-1)] hover:border-[color-mix(in_srgb,var(--color-accent-gold)_44%,transparent)]',
  subtle:
    'text-[var(--color-accent-gold-soft)] underline underline-offset-4 decoration-[color-mix(in_srgb,var(--color-accent-gold)_50%,transparent)] hover:decoration-[var(--color-accent-gold)] px-0 py-0',
};

const classes = `${base} ${sizes[size]} ${variants[variant]} ${className}`;
---

{
  href ? (
    <a href={href} class={classes} {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes}>
      <slot />
    </button>
  )
}
