---
interface Props {
  value: string;
  label: string;
  sub?: string;
  accent?: 'gold' | 'teal' | 'ink';
  class?: string;
}

const { value, label, sub, accent = 'gold', class: className = '' } = Astro.props;

const accents = {
  gold: 'text-[var(--color-accent-gold)]',
  teal: 'text-[var(--color-accent-teal)]',
  ink: 'text-[var(--color-ink-1)]',
};
---

<div class={`flex flex-col gap-1 ${className}`}>
  <span class={`font-[var(--font-display)] text-[clamp(2.2rem,4.5vw,3.4rem)] leading-none font-semibold ${accents[accent]}`}>
    {value}
  </span>
  <span class="font-mono text-[0.7rem] uppercase tracking-[0.18em] text-[var(--color-ink-3)]">{label}</span>
  {sub && <span class="text-[0.85rem] leading-[1.5] text-[var(--color-ink-2)]">{sub}</span>}
</div>
