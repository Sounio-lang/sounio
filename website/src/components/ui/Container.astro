---
interface Props {
  width?: 'wide' | 'narrow' | 'prose';
  class?: string;
}

const { width = 'wide', class: className = '' } = Astro.props;

const widths = {
  wide: 'max-w-[1400px]',
  narrow: 'max-w-[1100px]',
  prose: 'max-w-[72ch]',
};
---

<div class={`w-full ${widths[width]} mx-auto px-6 ${className}`}>
  <slot />
</div>
