---
interface Props {
  text: string;
  as?: 'h1' | 'h2' | 'h3' | 'p' | 'span';
  class?: string;
}

const { text, as: Tag = 'h2', class: className = '' } = Astro.props as Props;
const letters = [...text];
---

<Tag aria-label={text} class={`kinetic-text ${className}`}>
  {
    letters.map((ch, i) => (
      <span aria-hidden="true" class="kinetic-text-letter" style={`--kinetic-index: ${i}`}>
        {ch === ' ' ? ' ' : ch}
      </span>
    ))
  }
</Tag>

<style>
  .kinetic-text {
    display: inline-block;
  }
  .kinetic-text-letter {
    display: inline-block;
    white-space: pre;
    will-change: transform, opacity;
  }
</style>

<script>
  import { gsap } from '../../lib/motion';

  function initKinetic() {
    const texts = document.querySelectorAll<HTMLElement>('.kinetic-text');
    texts.forEach((el) => {
      if (el.dataset.kineticMounted) return;
      el.dataset.kineticMounted = 'true';

      const letters = el.querySelectorAll<HTMLElement>('.kinetic-text-letter');
      if (!letters.length) return;

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      gsap.from(letters, {
        y: 40,
        opacity: 0,
        rotateX: -40,
        transformOrigin: '50% 100%',
        duration: 0.8,
        ease: 'back.out(1.4)',
        stagger: {
          each: 0.03,
          from: 'start',
        },
        scrollTrigger: {
          trigger: el,
          start: 'top 88%',
          once: true,
        },
      });
    });
  }

  initKinetic();
  document.addEventListener('astro:page-load', initKinetic);
</script>
