---
interface Props {
  text: string;
  as?: 'h1' | 'h2' | 'h3' | 'p' | 'span';
  class?: string;
}

const { text, as: Tag = 'h2', class: className = '' } = Astro.props as Props;
const letters = [...text];
---

<Tag aria-label={text} class={`kinetic-text ${className}`}>
  {
    letters.map((ch, i) => (
      <span aria-hidden="true" class="kinetic-text-letter" style={`--kinetic-index: ${i}`}>
        {ch === ' ' ? ' ' : ch}
      </span>
    ))
  }
</Tag>

<style>
  .kinetic-text {
    display: inline-block;
  }
  .kinetic-text-letter {
    display: inline-block;
    white-space: pre;
  }
</style>
