---
interface Props {
  class?: string;
  tone?: 'default' | 'gold' | 'teal';
}

const { class: className = '', tone = 'default' } = Astro.props;

const tones = {
  default: 'border-[var(--color-line)] text-[var(--color-ink-2)]',
  gold: 'border-[color-mix(in_srgb,var(--color-accent-steel)_45%,transparent)] text-[var(--color-accent-steel-soft)]',
  teal: 'border-[color-mix(in_srgb,var(--color-accent-steel)_45%,transparent)] text-[var(--color-accent-steel)]',
};
---

<span
  class={`inline-flex w-fit items-center rounded-full border px-2.5 py-0.5 font-mono text-[0.68rem] uppercase tracking-[0.14em] ${tones[tone]} ${className}`}
>
  <slot />
</span>
