---
import { Code } from 'astro:components';

interface Props {
  code: string;
  lang?: string;
  filename?: string;
  class?: string;
  copy?: boolean;
}

const { code, lang = 'rust', filename, class: className = '', copy = true } = Astro.props;
---

<figure
  class={`code-panel overflow-hidden rounded-[var(--radius-xl)] border border-[var(--glass-border)] bg-[var(--color-code-surface)] ${className}`}
  data-code={copy ? code : undefined}
>
  {
    (filename || copy) && (
      <figcaption class="flex items-center justify-between gap-3 border-b border-[rgba(255,255,255,0.08)] px-4 py-2">
        <span class="font-mono text-[0.72rem] uppercase tracking-[0.14em] text-[rgba(230,237,243,0.55)]">
          {filename ?? lang}
        </span>
        {copy && (
          <button
            type="button"
            class="code-panel-copy font-mono text-[0.72rem] uppercase tracking-[0.14em] text-[rgba(230,237,243,0.55)] transition-colors hover:text-[var(--color-accent-gold)]"
            aria-label="Copy code to clipboard"
          >
            copy
          </button>
        )}
      </figcaption>
    )
  }
  <Code {code} lang={lang as any} theme="github-dark" class="code-panel-body text-[0.85rem] leading-[1.65]" />
</figure>

<style>
  .code-panel :global(pre) {
    margin: 0;
    padding: 1rem 1.25rem;
    background: transparent !important;
    border-radius: 0;
  }
  .code-panel :global(pre code) {
    font-family: var(--font-mono);
  }
</style>

<script>
  function initCodePanels() {
    if ((window as any).__sounioCodePanels) return;
    (window as any).__sounioCodePanels = true;
    document.addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement).closest?.('.code-panel-copy');
      if (!btn) return;
      const panel = btn.closest('.code-panel');
      const code = panel?.getAttribute('data-code');
      if (!code) return;
      try {
        await navigator.clipboard.writeText(code);
        btn.textContent = 'copied';
        setTimeout(() => (btn.textContent = 'copy'), 1400);
      } catch {
        btn.textContent = 'failed';
        setTimeout(() => (btn.textContent = 'copy'), 1400);
      }
    });
  }
  initCodePanels();
  document.addEventListener('astro:page-load', initCodePanels);
</script>
