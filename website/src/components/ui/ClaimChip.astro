---
interface Props {
  status: 'proven' | 'artifact' | 'provisional' | 'scaffolding' | 'missing';
  label?: string;
  href?: string;
  class?: string;
}

const { status, label, href, class: className = '' } = Astro.props;

const config = {
  proven: { color: 'var(--color-accent-blue)', text: label ?? 'proven' },
  artifact: { color: 'var(--color-accent-blue)', text: label ?? 'artifact-backed' },
  provisional: { color: 'var(--color-accent-blue)', text: label ?? 'provisional' },
  scaffolding: { color: 'var(--color-accent-orange)', text: label ?? 'scaffolding' },
  missing: { color: 'var(--color-accent-red)', text: label ?? 'missing' },
} as const;

const { color, text } = config[status];
---

{
  href ? (
    <a
      {href}
      style={`--chip-color: ${color};`}
      class={`claim-chip inline-flex w-fit items-center gap-1.5 rounded-full border border-[color-mix(in_srgb,var(--chip-color)_40%,transparent)] bg-[color-mix(in_srgb,var(--chip-color)_8%,transparent)] px-2.5 py-0.5 font-mono text-[0.68rem] uppercase tracking-[0.14em] text-[var(--chip-color)] transition-colors hover:bg-[color-mix(in_srgb,var(--chip-color)_16%,transparent)] ${className}`}
    >
      <span aria-hidden="true" class="size-1.5 rounded-full bg-[var(--chip-color)]" />
      {text}
    </a>
  ) : (
    <span
      style={`--chip-color: ${color};`}
      class={`claim-chip inline-flex w-fit items-center gap-1.5 rounded-full border border-[color-mix(in_srgb,var(--chip-color)_40%,transparent)] bg-[color-mix(in_srgb,var(--chip-color)_8%,transparent)] px-2.5 py-0.5 font-mono text-[0.68rem] uppercase tracking-[0.14em] text-[var(--chip-color)] ${className}`}
    >
      <span aria-hidden="true" class="size-1.5 rounded-full bg-[var(--chip-color)]" />
      {text}
    </span>
  )
}
