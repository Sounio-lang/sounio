---
interface Props {
  id?: string;
  class?: string;
  pad?: 'default' | 'tight' | 'loose' | 'none';
}

const { id, class: className = '', pad = 'default' } = Astro.props;

const pads = {
  default: 'py-[clamp(3.5rem,7vw,6rem)]',
  tight: 'py-[clamp(2rem,4vw,3rem)]',
  loose: 'py-[clamp(5rem,10vw,8rem)]',
  none: '',
};
---

<section id={id} class={`relative ${pads[pad]} ${className}`}>
  <slot />
</section>
