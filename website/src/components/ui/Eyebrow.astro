---
interface Props {
  class?: string;
  rule?: boolean;
  tone?: 'gold' | 'teal' | 'ink';
}

const { class: className = '', rule = true, tone = 'gold' } = Astro.props;

const tones = {
  gold: 'text-[var(--color-accent-blue-soft)]',
  teal: 'text-[var(--color-accent-blue)]',
  ink: 'text-[var(--color-ink-3)]',
};
const ruleTones = {
  gold: 'bg-[var(--color-accent-blue)]',
  teal: 'bg-[var(--color-accent-blue)]',
  ink: 'bg-[var(--color-line-strong)]',
};
---

<div class={`flex items-center gap-3 font-mono text-[0.72rem] font-medium uppercase tracking-[0.18em] ${tones[tone]} ${className}`}>
  {rule && <span aria-hidden="true" class={`h-px w-8 ${ruleTones[tone]}`}></span>}
  <span><slot /></span>
</div>
