---
import { EpistemicGatePlayground } from './EpistemicGatePlayground';
import type { Locale } from '../../lib/i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;

const t: Record<
  string,
  { label: string; heading: string; annotation: string }
> = {
  en: {
    label: 'A claim has a ceiling',
    heading: 'The ladder stops where the evidence stops.',
    annotation:
      'E0 Syntax → E1 HIR Type → E2 Effect Lattice → E3 GUM Variance Bounds → E4 Lean 4 Formal Proof → E5 Closed-form Theorem. TRUSTWORTHY is a cyan diamond at the last gate that holds. UNBOUNDED is amber: a proved model cited past its scope. REFUSED is carmine: the band is not inside the window. No card on this page reaches E5.',
  },
  pt: {
    label: 'Uma afirmação tem um tecto',
    heading: 'A escada pára onde a evidência pára.',
    annotation:
      'E0 Syntax → E1 HIR Type → E2 Effect Lattice → E3 GUM Variance Bounds → E4 Lean 4 Formal Proof → E5 Closed-form Theorem. TRUSTWORTHY é o diamante ciano no último portão que se segura. UNBOUNDED é âmbar: um modelo provado citado para além do seu âmbito. REFUSED é carmim: a banda não está dentro da janela. Nenhum cartão nesta página chega a E5.',
  },
};

const d = t[locale] ?? t.en;
---

<section id="epistemic-gates" class="egc-section">
  <div class="egc-section-inner">
    <p class="egc-section-label">{d.label}</p>
    <h2 class="egc-section-heading">{d.heading}</h2>
    <p class="egc-section-annotation">{d.annotation}</p>
    <EpistemicGatePlayground client:visible />
  </div>
</section>

<style>
  .egc-section {
    position: relative;
    padding: clamp(3.5rem, 7vw, 6rem) 1.5rem;
  }

  .egc-section-inner {
    max-width: 760px;
    margin: 0 auto;
    display: grid;
    gap: 1.1rem;
  }

  .egc-section-label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent-teal);
    opacity: 0.85;
  }

  .egc-section-heading {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    font-weight: 400;
    line-height: 1.25;
    color: var(--color-text-primary);
  }

  .egc-section-annotation {
    margin: 0;
    max-width: 68ch;
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  :global(.egc-play) {
    display: grid;
    gap: 0.75rem;
  }

  :global(.egc-play-toggle) {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  :global(.egc-play-btn) {
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border-subtle);
    background: var(--color-surface-frost);
    color: var(--color-text-secondary);
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.35rem 0.7rem;
    cursor: pointer;
  }

  :global(.egc-play-btn:hover) {
    color: var(--color-text-primary);
  }

  :global(.egc-play-btn[data-active='true'][data-state='trustworthy']) {
    border-color: var(--color-epistemic-verified-border);
    background: var(--color-epistemic-verified-surface);
    color: var(--color-epistemic-verified-text);
  }

  :global(.egc-play-btn[data-active='true'][data-state='unbounded']) {
    border-color: var(--color-epistemic-uncertain-border);
    background: var(--color-epistemic-uncertain-surface);
    color: var(--color-epistemic-uncertain-text);
  }

  :global(.egc-play-btn[data-active='true'][data-state='refused']) {
    border-color: var(--color-epistemic-refused-border);
    background: var(--color-epistemic-refused-surface);
    color: var(--color-epistemic-refused-text);
  }
</style>
