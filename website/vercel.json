{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "git": {
    "deploymentEnabled": false
  },
  "redirects": [
    { "source": "/docs/:path*", "destination": "/learn/:path*/", "permanent": true },
    { "source": "/showcases", "destination": "/science/", "permanent": true },
    { "source": "/showcases/:slug", "destination": "/science/:slug/", "permanent": true },
    { "source": "/blog", "destination": "/insights/", "permanent": true },
    { "source": "/pt/docs/:path*", "destination": "/pt/learn/:path*/", "permanent": true },
    { "source": "/pt/showcases", "destination": "/pt/science/", "permanent": true },
    { "source": "/pt/showcases/:slug", "destination": "/pt/science/:slug/", "permanent": true },
    { "source": "/pt/blog", "destination": "/pt/insights/", "permanent": true },
    { "source": "/el/docs/:path*", "destination": "/el/learn/:path*/", "permanent": true },
    { "source": "/el/showcases", "destination": "/el/science/", "permanent": true },
    { "source": "/el/showcases/:slug", "destination": "/el/science/:slug/", "permanent": true },
    { "source": "/el/blog", "destination": "/el/insights/", "permanent": true },
    { "source": "/zh/docs/:path*", "destination": "/zh/learn/:path*/", "permanent": true },
    { "source": "/zh/showcases", "destination": "/zh/science/", "permanent": true },
    { "source": "/zh/showcases/:slug", "destination": "/zh/science/:slug/", "permanent": true },
    { "source": "/zh/blog", "destination": "/zh/insights/", "permanent": true },
    { "source": "/ja/docs/:path*", "destination": "/ja/learn/:path*/", "permanent": true },
    { "source": "/ja/showcases", "destination": "/ja/science/", "permanent": true },
    { "source": "/ja/showcases/:slug", "destination": "/ja/science/:slug/", "permanent": true },
    { "source": "/ja/blog", "destination": "/ja/insights/", "permanent": true },
    { "source": "/es/docs/:path*", "destination": "/es/learn/:path*/", "permanent": true },
    { "source": "/es/showcases", "destination": "/es/science/", "permanent": true },
    { "source": "/es/showcases/:slug", "destination": "/es/science/:slug/", "permanent": true },
    { "source": "/es/blog", "destination": "/es/insights/", "permanent": true },
    { "source": "/zh-hk/docs/:path*", "destination": "/zh-hk/learn/:path*/", "permanent": true },
    { "source": "/zh-hk/showcases", "destination": "/zh-hk/science/", "permanent": true },
    { "source": "/zh-hk/showcases/:slug", "destination": "/zh-hk/science/:slug/", "permanent": true },
    { "source": "/zh-hk/blog", "destination": "/zh-hk/insights/", "permanent": true }
  ]
}
