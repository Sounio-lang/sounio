{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": false
  },
  "routes": [
    { "src": "^/docs/?$", "headers": { "Location": "/learn/" }, "status": 308 },
    { "src": "^/docs/([A-Za-z0-9_-]+)/?$", "headers": { "Location": "/learn/$1/" }, "status": 308 },
    { "src": "^/docs/([A-Za-z0-9_-]+)/([A-Za-z0-9_-]+)/?$", "headers": { "Location": "/learn/$1/$2/" }, "status": 308 },
    { "src": "^/(pt|el|zh-hk|zh|ja|es)/docs/?$", "headers": { "Location": "/$1/learn/" }, "status": 308 },
    { "src": "^/(pt|el|zh-hk|zh|ja|es)/docs/([A-Za-z0-9_-]+)/?$", "headers": { "Location": "/$1/learn/$2/" }, "status": 308 },
    { "src": "^/(pt|el|zh-hk|zh|ja|es)/docs/([A-Za-z0-9_-]+)/([A-Za-z0-9_-]+)/?$", "headers": { "Location": "/$1/learn/$2/$3/" }, "status": 308 },
    { "src": "^/sitemap\\.xml/?$", "headers": { "Location": "/sitemap-index.xml" }, "status": 308 },
    { "src": "^/manifesto/?$", "headers": { "Location": "/about/vision/" }, "status": 308 },
    { "src": "^/(pt|el|zh-hk|zh|ja|es)/manifesto/?$", "headers": { "Location": "/$1/about/vision/" }, "status": 308 },
    { "src": "^/roadmap/?$", "headers": { "Location": "/about/roadmap/" }, "status": 308 },
    { "src": "^/(pt|el|zh-hk|zh|ja|es)/roadmap/?$", "headers": { "Location": "/$1/about/roadmap/" }, "status": 308 },
    { "src": "^/platform/?$", "headers": { "Location": "/language/" }, "status": 308 },
    { "src": "^/(pt|el|zh-hk|zh|ja|es)/platform/?$", "headers": { "Location": "/$1/language/" }, "status": 308 },
    { "src": "^/blog/?$", "headers": { "Location": "/insights/" }, "status": 308 },
    { "src": "^/(pt|el|zh-hk|zh|ja|es)/blog/?$", "headers": { "Location": "/$1/insights/" }, "status": 308 },
    { "src": "^/changelog/?$", "headers": { "Location": "/releases/" }, "status": 308 },
    { "src": "^/(pt|el|zh-hk|zh|ja|es)/changelog/?$", "headers": { "Location": "/$1/releases/" }, "status": 308 },
    { "src": "^/registry/?$", "headers": { "Location": "/packages/" }, "status": 308 },
    { "src": "^/(pt|el|zh-hk|zh|ja|es)/registry/?$", "headers": { "Location": "/$1/packages/" }, "status": 308 },
    { "src": "^/registry/([A-Za-z0-9_-]+)/?$", "headers": { "Location": "/packages/$1/" }, "status": 308 },
    { "src": "^/(pt|el|zh-hk|zh|ja|es)/registry/([A-Za-z0-9_-]+)/?$", "headers": { "Location": "/$1/packages/$2/" }, "status": 308 },
    { "src": "^/showcases/([A-Za-z0-9_-]+)/?$", "headers": { "Location": "/science/$1/" }, "status": 308 },
    { "src": "^/(pt|el|zh-hk|zh|ja|es)/showcases/([A-Za-z0-9_-]+)/?$", "headers": { "Location": "/$1/science/$2/" }, "status": 308 },
    { "src": "^/\\.well-known(?:/.*)?$" },
    { "src": "^/((?:[^/]+/)*[^/\\.]+)$", "headers": { "Location": "/$1/" }, "status": 308 },
    { "src": "^/((?:[^/]+/)*[^/]+\\.\\w+)/$", "headers": { "Location": "/$1" }, "status": 308 }
  ]
}
