{
  "name": "website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build:wasm": "bash ../scripts/build/build_playground_wasm.sh",
    "generate:render-assets": "node scripts/render-assets.mjs generate",
    "sync:artifacts": "node scripts/sync-artifact-status.mjs",
    "build": "npm run sync:artifacts && astro build && pagefind --site dist --output-path dist/pagefind --root-selector body",
    "check:render-assets": "node scripts/render-assets.mjs check",
    "check:docs-parity": "node scripts/check-docs-parity.mjs",
    "check:i18n": "node scripts/check-i18n-keys.mjs",
    "check:routes": "node scripts/check-route-contract.mjs",
    "check:redirects": "node scripts/check-redirect-output.mjs",
    "check:brand": "node scripts/check-brand-assets.mjs",
    "check:pagefind": "node scripts/check-pagefind-body.mjs",
    "check:nav": "node scripts/check-navigation-integrity.mjs",
    "check:locale-fallback": "node scripts/check-locale-fallback.mjs",
    "check:sio-highlight": "node scripts/check-sio-highlighting.mjs",
    "check:external-links": "node scripts/check-external-links.mjs",
    "check:astro": "astro check",
    "check:quality": "npm run check:i18n && npm run check:docs-parity && npm run check:render-assets && npm run build && npm run check:routes && npm run check:redirects && npm run check:brand && npm run check:pagefind && npm run check:nav && npm run check:locale-fallback && npm run check:sio-highlight && npm run check:astro",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^6.0.3",
    "@astrojs/react": "^5.0.7",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tailwindcss/vite": "^4.3.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@zarrita/core": "^0.0.3",
    "astro": "^6.4.7",
    "framer-motion": "^12.40.0",
    "gsap": "^3.15.0",
    "katex": "^0.17.0",
    "leva": "^0.10.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.1",
    "three": "^0.184.0",
    "zarrita": "^0.7.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@pagefind/default-ui": "^1.5.2",
    "@webgpu/types": "^0.1.70",
    "pagefind": "^1.5.2",
    "typescript": "^6.0.3"
  }
}
