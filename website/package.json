{
  "name": "website",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build:wasm": "bash ../scripts/build_playground_wasm.sh",
    "build": "astro build && pagefind --site dist --output-path dist/pagefind --root-selector body",
    "check:i18n": "node scripts/check-i18n-keys.mjs",
    "check:routes": "node scripts/check-route-contract.mjs",
    "check:redirects": "node scripts/check-redirect-output.mjs",
    "check:brand": "node scripts/check-brand-assets.mjs",
    "check:pagefind": "node scripts/check-pagefind-body.mjs",
    "check:nav": "node scripts/check-navigation-integrity.mjs",
    "check:locale-fallback": "node scripts/check-locale-fallback.mjs",
    "check:sio-highlight": "node scripts/check-sio-highlighting.mjs",
    "check:quality": "npm run check:i18n && npm run build && npm run check:routes && npm run check:redirects && npm run check:brand && npm run check:pagefind && npm run check:nav && npm run check:locale-fallback && npm run check:sio-highlight",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.13",
    "@astrojs/react": "^4.4.2",
    "@tailwindcss/vite": "^4.1.18",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "astro": "^5.17.1",
    "framer-motion": "^12.34.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@pagefind/default-ui": "^1.4.0",
    "pagefind": "^1.4.0"
  }
}
