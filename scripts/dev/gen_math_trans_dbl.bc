scale=900
/* nearest binary64 (round-half-up, normals only) of x, returned as an exact bc number */
define p2(n) { auto r, i; r = 1; if (n >= 0) { for (i = 0; i < n; i++) r = r * 2; return r } ; for (i = 0; i < -n; i++) r = r / 2; return r }
define e2(x) { auto e; e = 0; if (x >= 1) { while (p2(e + 1) <= x) e = e + 1; return e } ; while (p2(e) > x) e = e - 1; return e }
define fl(x) { auto s, e, m, sc; if (x == 0) return 0; s = 1; if (x < 0) { s = -1; x = -x }; e = e2(x); m = x * p2(52 - e) + 0.5; sc = scale; scale = 0; m = m / 1; scale = sc; return s * m * p2(e - 52) }
/* bits of a positive normal double given as exact value v (assumed already a double) */
define bits(v) { auto s, e, m, sc; s = 0; if (v < 0) { s = 1; v = -v }; if (v == 0) return s * p2(63); e = e2(v); m = v * p2(52 - e); sc = scale; scale = 0; m = m / 1; scale = sc; return s * p2(63) + (e + 1023) * p2(52) + (m - p2(52)) }
define hx(v) { auto o; o = obase; obase = 16; print "0x", bits(v), "\n"; obase = o; return 0 }
/* fl then print */
define hf(x) { return hx(fl(x)) }
