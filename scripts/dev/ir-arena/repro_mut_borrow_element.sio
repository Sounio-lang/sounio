// #1678 item 3: does a MUTABLE borrow of an aggregate array element WRITE to
// the right place? Every earlier witness only read.

struct Inner { tag: i64, bits: [i64; 8] }
struct Outer { n: i64, items: [Inner; 4] }

fn bump(p: &!Inner) with Mut, Panic, Div {
    (*p).tag = (*p).tag + 100
    (*p).bits[0] = (*p).bits[0] + 7
}

fn bump_via_param(c: &!Outer) with Mut, Panic, Div {
    bump(&! (*c).items[2 as usize])
}

fn main() -> i64 with IO, Mut, Panic, Div {
    var o = Outer { n: 0, items: [Inner { tag: 0, bits: [0; 8] }; 4] }
    var seed = o.items[2 as usize]
    seed.tag = 1
    seed.bits[0] = 1
    o.items[2 as usize] = seed

    // (A) hoist, mutate, store back -- the workaround, known correct
    var h = o.items[2 as usize]
    bump(&! h)
    o.items[2 as usize] = h
    var readA = o.items[2 as usize]
    print("A_hoisted tag=")
    print_int(readA.tag)
    print(" bits0=")
    print_int(readA.bits[0 as usize])

    // (B) mutable borrow of the element IN PLACE, through a ref param
    bump_via_param(&! o)
    var readB = o.items[2 as usize]
    print(" | B_inplace tag=")
    print_int(readB.tag)
    print(" bits0=")
    print_int(readB.bits[0 as usize])
    print("\n(expect: A tag=101 bits0=8 | B tag=201 bits0=15)\n")
    0
}
