struct Name2 { len: i64, chars: [i64; 8] }
struct Elem { tag: i64, nm: Name2 }
struct Cont { n: i64, items: [Elem; 4] }

fn name_sum(p: &Name2) -> i64 with Mut, Panic, Div {
    var t: i64 = 0
    var i: i64 = 0
    while i < 8 { t = t + (*p).chars[i as usize]; i = i + 1 }
    t
}
fn elem_tag(p: &Elem) -> i64 { (*p).tag }

// &container.items[i].field  -- the profile.sio / layout.sio shape
fn shape_field_of_elem(c: &Cont) -> i64 with Mut, Panic, Div {
    name_sum(&(*c).items[2 as usize].nm)
}
// &container.items[i]  -- the egraph.sio shape
fn shape_elem(c: &Cont) -> i64 with Mut, Panic, Div {
    elem_tag(&(*c).items[2 as usize])
}

fn main() -> i64 with IO, Mut, Panic, Div {
    var c = Cont { n: 0, items: [Elem { tag: 0, nm: Name2 { len: 0, chars: [0; 8] } }; 4] }
    var e = c.items[2 as usize]
    e.tag = 77
    var k: i64 = 0
    while k < 5 { e.nm.chars[k as usize] = 1; k = k + 1 }
    c.items[2 as usize] = e

    var hoisted = c.items[2 as usize]
    print("hoisted_elem_tag=")
    print_int(elem_tag(&hoisted))
    print(" hoisted_field_sum=")
    print_int(name_sum(&hoisted.nm))
    print(" inplace_field_of_elem=")
    print_int(shape_field_of_elem(&c))
    print(" inplace_elem=")
    print_int(shape_elem(&c))
    print("\n(expect: 77 5 5 77)\n")
    0
}
