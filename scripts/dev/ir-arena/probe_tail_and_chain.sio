// Is a multi-line `&&` chain in TAIL position miscompiled?
struct Inner { op: i64, fn_id: i64, arg_count: i64, src1: i64, src2: i64 }
struct Holder { n: i64, param_regs: [i64; 8], items: [Inner; 4] }

fn as_tail(h: &Holder, c: Inner) -> bool with Mut, Panic, Div {
    c.op == 7 &&
    c.fn_id == 1 &&
    c.arg_count == 2 &&
    c.src1 == (*h).param_regs[0 as usize] &&
    c.src2 == (*h).param_regs[1 as usize]
}

fn as_let(h: &Holder, c: Inner) -> bool with Mut, Panic, Div {
    let ok = c.op == 7 &&
        c.fn_id == 1 &&
        c.arg_count == 2 &&
        c.src1 == (*h).param_regs[0 as usize] &&
        c.src2 == (*h).param_regs[1 as usize]
    ok
}

fn main() -> i64 with IO, Mut, Panic, Div {
    var h = Holder { n: 0, param_regs: [0; 8], items: [Inner { op: 0, fn_id: 0, arg_count: 0, src1: 0, src2: 0 }; 4] }
    h.param_regs[0 as usize] = 0
    h.param_regs[1 as usize] = 1
    let c = Inner { op: 7, fn_id: 1, arg_count: 2, src1: 0, src2: 1 }
    print("tail=")
    print_int(if as_tail(&h, c) { 1 } else { 0 })
    print(" let=")
    print_int(if as_let(&h, c) { 1 } else { 0 })
    print("\n(expect: tail=1 let=1)\n")
    0
}
