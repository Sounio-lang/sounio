pi = 4*a(1)
l2 = l(2)
define fact(n) { auto r, i; r = 1; for (i = 2; i <= n; i++) r = r * i; return r }
define sgn(k) { return (-1)^k }
v = pi/2
q1 = fl(v); r1 = v - q1; q2 = fl(r1); r2 = r1 - q2; q3 = fl(r2); r3 = r2 - q3; q4 = fl(r3)
print "COMMON pio2_1 "; x = hx(q1)
print "COMMON pio2_2 "; x = hx(q2)
print "COMMON pio2_3 "; x = hx(q3)
print "COMMON pio2_4 "; x = hx(q4)
print "COMMON inv_pio2 "; x = hf(2/pi)
p1 = fl(pi)
print "COMMON pi_hi "; x = hx(p1)
print "COMMON pi_lo "; x = hf(pi - p1)
print "COMMON pio4 "; x = hf(pi/4)
print "COMMON pio4x3 "; x = hf(3*pi/4)
h0 = fl(a(0.5)); h1 = fl(a(1)); h2 = fl(a(1.5))
print "ATANHI tab "; x = hx(h0)
print "ATANHI tab "; x = hx(h1)
print "ATANHI tab "; x = hx(h2)
print "ATANHI tab "; x = hx(q1)
print "ATANLO tab "; x = hf(a(0.5) - h0)
print "ATANLO tab "; x = hf(a(1) - h1)
print "ATANLO tab "; x = hf(a(1.5) - h2)
print "ATANLO tab "; x = hx(q2)
for (k = 0; k < 24; k++) { print "ATAN_T tab "; x = hf(sgn(k) / (2*k+3)) }
for (k = 0; k < 10; k++) { print "SIN_S tab "; x = hf(sgn(k+1) / fact(2*k+3)) }
for (k = 0; k < 9; k++) { print "COS_Q tab "; x = hf(sgn(k) / fact(2*k+4)) }
for (k = 0; k < 16; k++) { print "EXPM1_E tab "; x = hf(1 / fact(k+2)) }
sc = scale; scale = 0; mh = l2 * p2(40) / 1; scale = sc
lh = mh * p2(-40)
print "COMMON ln2_hi "; x = hx(lh)
print "COMMON ln2_lo "; x = hf(l2 - lh)
print "COMMON inv_ln2 "; x = hf(1/l2)
print "THR c7_16 "; x = hf(7/16)
print "THR c11_16 "; x = hf(11/16)
print "THR c19_16 "; x = hf(19/16)
print "THR c39_16 "; x = hf(39/16)
print "THR c0p7 "; x = hf(0.7)
print "THR c22 "; x = hf(22)
print "THR c2m28 "; x = hf(p2(-28))
print "THR c2m27 "; x = hf(p2(-27))
print "THR c2p66 "; x = hf(p2(66))
print "THR c2p50 "; x = hf(p2(50))
