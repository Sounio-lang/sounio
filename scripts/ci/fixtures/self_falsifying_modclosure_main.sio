//@ ignore
// Module-closure probe, importer (rung R1 of the self-falsifying compilation
// line: docs/research/self_falsifying_compilation_line_r1_2026-07-26.md).
//
// Imports a module whose claim is FALSE (its gate always exits non-zero) and
// carries one claim of its own whose gate passes. Compiled with
// --verify-claims, the two possible outcomes are both informative:
//
//   MODULE_CLOSURE_BLOCKS  — only this file's claim runs; VERIFY_CLAIMS_OK,
//                            ELF emitted, the imported false claim invisible.
//   MODULE_CLOSURE_PASSES  — the imported claim runs too; CLAIM_FAIL,
//                            VERIFY_CLAIMS_FALSIFIED, no ELF.

use self_falsifying_modclosure_lib::{modclosure_lib_value}

claim mcl_main_claim_that_holds {
    hypothesis = "the importing file's own claims are verified",
    falsifier  = "this gate does not run, or runs and fails",
    evidence   = Evidence::GateGreen,
    harness    = "scripts/ci/fixtures/self_falsifying_claim_gate_pass.sh",
    gate       = "scripts/ci/fixtures/self_falsifying_claim_gate_pass.sh",
    verdict    = Verdict::Alive,
}

fn main() -> i64 with IO {
    if modclosure_lib_value() == 42 {
        print("SELF_FALSIFYING_MODCLOSURE_MAIN_OK\n")
    }
    0
}
