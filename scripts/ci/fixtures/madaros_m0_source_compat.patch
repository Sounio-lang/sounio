diff --git a/self-hosted/resolve/scope_table.sio b/self-hosted/resolve/scope_table.sio
new file mode 100644
index 0000000..6937a6d
--- /dev/null
+++ b/self-hosted/resolve/scope_table.sio
@@ -0,0 +1,68 @@
+// Scope stack for lexical scoping
+//
+// Each scope records where it begins in the symbol table (start_index)
+// and its depth. Pushing a scope records the current symbol count;
+// popping restores visibility by trimming back to start_index.
+// Lookup walks symbols in reverse from current count to find the
+// innermost binding for a name.
+
+module resolve::scope_table
+
+// ============================================================
+// Scope entry
+// ============================================================
+
+struct Scope {
+    start_index: i64,
+    depth: i64,
+}
+
+fn empty_scope() -> Scope {
+    Scope { start_index: 0, depth: 0 }
+}
+
+// ============================================================
+// Scope stack
+// ============================================================
+
+pub struct ScopeStack {
+    scopes: [Scope; 256],
+    depth: i64,
+}
+
+fn scope_stack_new() -> ScopeStack {
+    ScopeStack {
+        scopes: [empty_scope(); 256],
+        depth: 0,
+    }
+}
+
+impl ScopeStack {
+    fn push(self, sym_count: i64) -> ScopeStack with Mut, Panic, Div {
+        var ss = self
+        if ss.depth < 256 {
+            ss.scopes[ss.depth] = Scope {
+                start_index: sym_count,
+                depth: ss.depth,
+            }
+            ss.depth = ss.depth + 1
+        }
+        ss
+    }
+
+    fn pop(self) -> ScopeStack with Mut {
+        var ss = self
+        if ss.depth > 0 {
+            ss.depth = ss.depth - 1
+        }
+        ss
+    }
+
+    fn current_start(self) -> i64 with Panic, Div {
+        if self.depth > 0 {
+            self.scopes[self.depth - 1].start_index
+        } else {
+            0
+        }
+    }
+}
