//@ ignore
// THE RUNG. The gate exits 0 AND emits exactly the declared verdict token --
// so exit-code gating and token binding both pass -- while the witness it
// emits differs. The proposition holds; its grounds were replaced.
// Expect CLAIM_WITNESS_MISMATCH, no ELF.

claim sfc_witness_drifts {
    hypothesis = "the evidence establishing the proposition is the declared one",
    falsifier  = "the proposition still holds but on different evidence",
    evidence   = Evidence::GateGreen,
    harness    = "scripts/ci/fixtures/self_falsifying_witness_drift.sh",
    gate       = "scripts/ci/fixtures/self_falsifying_witness_drift.sh",
    verdict_token = "TOKEN_ALPHA",
    witness    = "abc123def456",
    verdict    = Verdict::Alive,
}

fn main() -> i64 with IO {
    print("SELF_FALSIFYING_WITNESS_DRIFT_UNREACHABLE\n")
    0
}
