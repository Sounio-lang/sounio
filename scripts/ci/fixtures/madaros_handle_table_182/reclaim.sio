// Handle-table reclamation witness.
//
// The three-field aggregate is 24 bytes, so native-v2 must represent it as a
// managed object rather than an unboxed <=16-byte value. Each call creates the
// object and returns only a scalar. A sound frame-scoped reclamation scheme may
// recycle the child frame after the call; it must preserve the scalar result.
// The gate replaces N with the capacity-derived run length.

struct Triple {
    a: i64,
    b: i64,
    c: i64,
}

fn transient_value(i: i64) -> i64 with Alloc {
    let t = Triple { a: i, b: 1, c: 2 }
    t.a
}

fn churn(n: i64) -> i64 with Mut, Alloc {
    var total: i64 = 0
    var i: i64 = 0
    while i < n {
        total = total + transient_value(i)
        i = i + 1
    }
    total
}

fn main() -> i32 with IO, Mut, Alloc {
    let n: i64 = 1
    let got = churn(n)
    let expected = (n * (n - 1)) / 2
    if got != expected {
        print("MADAROS_HANDLE_182_RECLAIM_FAIL got=")
        print_int(got)
        print(" expected=")
        print_int(expected)
        print_char(10)
        return 1
    }
    print("MADAROS_HANDLE_182_RECLAIM_OK n=")
    print_int(n)
    print(" sum=")
    print_int(got)
    print_char(10)
    0
}
