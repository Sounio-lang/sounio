// Positive control for handle reclamation.
//
// retained returns a managed Triple to its caller. check_escape then calls a
// separate transient producer before reading the returned value. A reclaim
// implementation that resets the caller's watermark too broadly can make this
// control stale or corrupt; the exact value is part of the witness.

struct Triple {
    a: i64,
    b: i64,
    c: i64,
}

fn retained() -> Triple with Alloc {
    Triple { a: 7, b: 11, c: 13 }
}

fn transient() -> i64 with Alloc {
    let t = Triple { a: 5, b: 17, c: 19 }
    t.a
}

fn check_escape() -> i64 with Alloc {
    let keep = retained()
    let scratch = transient()
    keep.a + keep.b + keep.c + scratch
}

fn main() -> i32 with IO, Alloc {
    let got = check_escape()
    if got != 36 {
        print("MADAROS_HANDLE_182_ESCAPE_FAIL got=")
        print_int(got)
        print_char(10)
        return 1
    }
    print("MADAROS_HANDLE_182_ESCAPE_OK value=")
    print_int(got)
    print_char(10)
    0
}
