//@ ignore
// Token-binding probe: declared token MATCHES what the gate emits.
// Expect CLAIM_PASS, VERIFY_CLAIMS_OK, ELF emitted.

claim sfc_token_agrees {
    hypothesis = "the gate emits the verdict token this claim declares",
    falsifier  = "the gate emits a different token, or none",
    evidence   = Evidence::GateGreen,
    harness    = "scripts/ci/fixtures/self_falsifying_token_match.sh",
    gate       = "scripts/ci/fixtures/self_falsifying_token_match.sh",
    verdict_token = "TOKEN_ALPHA",
    verdict    = Verdict::Alive,
}

fn main() -> i64 with IO {
    print("SELF_FALSIFYING_TOKEN_PASS_OK\n")
    0
}
