// pass=4 (not 5) is what shows the shared node is visited once.

use mcl_diamond_a::{mcl_diamond_a_value}
use mcl_diamond_b::{mcl_diamond_b_value}

claim mcl_diamond_main_claim {
    hypothesis = "closure probe",
    falsifier  = "the gate does not run",
    evidence   = Evidence::Implemented,
    harness    = "scripts/ci/fixtures/self_falsifying_claim_gate_pass.sh",
    gate       = "scripts/ci/fixtures/self_falsifying_claim_gate_pass.sh",
    verdict    = Verdict::Alive,
}

fn main() -> i64 with IO {
    if mcl_diamond_a_value() + mcl_diamond_b_value() == 6 {
        print("MCL_DIAMOND_OK
")
    }
    0
}
