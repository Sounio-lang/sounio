// Prepared fixed-input probe; not yet checked or executed on candidate.
pub export "C" fn exact_integral_center() -> f64 with Epistemic, Observe {
    let a = measure(1.0, 1.0)
    let b = measure(-10000000000000000.0, 0.0)
    let c = measure(10000000000000000.0, 0.0)
    let av = a.value
    let bv = b.value
    let cv = c.value
    (av + bv) + cv
}
fn main() -> i32 with IO, Epistemic, Observe {
    print_f64(exact_integral_center())
    print("\n")
    0
}
