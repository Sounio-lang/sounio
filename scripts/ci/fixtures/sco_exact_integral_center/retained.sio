// Retained callees: declared boundary priority; no physical GPU claim.
fn private_boundary() -> f64 with Epistemic, Observe {
    let a = measure(1.0, 1.0)
    let b = measure(-10000000000000000.0, 0.0)
    let c = measure(10000000000000000.0, 0.0)
    let av = a.value
    let bv = b.value
    let cv = c.value
    (av + bv) + cv
}
pub fn public_boundary() -> f64 with Epistemic, Observe {
    let a = measure(1.0, 1.0)
    let b = measure(-10000000000000000.0, 0.0)
    let c = measure(10000000000000000.0, 0.0)
    let av = a.value
    let bv = b.value
    let cv = c.value
    (av + bv) + cv
}
pub kernel fn kernel_priority(n: i64) -> () with GPU {
 let tid = gpu.thread_id.x
 if tid < n { }
}
fn main() -> i32 with IO, GPU, Epistemic, Observe {
 print_f64(private_boundary())
 print("\n")
 print_f64(public_boundary())
 print("\n")
 perform GPU.launch(kernel_priority, (1, 1, 1), (1, 1, 1))(0)
 perform GPU.sync()
 0
}
