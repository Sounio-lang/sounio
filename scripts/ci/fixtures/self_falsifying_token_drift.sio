//@ ignore
// Token-binding probe: the gate EXITS 0 but emits a DIFFERENT token.
// This is exactly the drift case that exit-code gating cannot see.
// Expect CLAIM_TOKEN_MISMATCH, VERIFY_CLAIMS_FALSIFIED, NO ELF.

claim sfc_token_drifts {
    hypothesis = "the gate emits TOKEN_ALPHA",
    falsifier  = "the gate emits any other token",
    evidence   = Evidence::GateGreen,
    harness    = "scripts/ci/fixtures/self_falsifying_token_drift.sh",
    gate       = "scripts/ci/fixtures/self_falsifying_token_drift.sh",
    verdict_token = "TOKEN_ALPHA",
    verdict    = Verdict::Alive,
}

fn main() -> i64 with IO {
    print("SELF_FALSIFYING_TOKEN_DRIFT_REACHED_CODEGEN\n")
    0
}
