//@ ignore
// THE RUNG. Gate exits 0, emits the declared token -- so exit-code gating and
// token binding both pass -- and the artifact the claim says its derivation
// rests on is not in the tree. Expect CLAIM_PROVENANCE_MISSING, no ELF.
//
// WHY A SYNTHETIC PATH, recorded rather than assumed. This fixture first cited
// the real absence that motivated the rung, the parity-collapse map Phi. Then
// the finding was FIXED -- Phi was restored from lean/cd-seamflip-forall-n --
// and the probe silently stopped demonstrating anything, because the file it
// pointed at now exists. A fixture built on a real defect self-destroys the
// moment the defect is repaired. The real absences live in the audit data,
// which is where they belong; the fixture needs a path that stays absent.
claim sfc_provenance_missing {
    hypothesis = "the derivation this claim rests on is available here",
    falsifier  = "the cited artifact is not in the tree",
    evidence   = Evidence::GateGreen,
    harness    = "scripts/ci/fixtures/self_falsifying_witness_match.sh",
    gate       = "scripts/ci/fixtures/self_falsifying_witness_match.sh",
    verdict_token = "TOKEN_ALPHA",
    provenance = "scripts/ci/fixtures/deliberately_absent_derivation.py",
    verdict    = Verdict::Alive,
}
fn main() -> i64 with IO { print("SFC_PROVENANCE_MISSING_UNREACHABLE\n") 0 }
