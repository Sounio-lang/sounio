//@ ignore
// Backward compatibility: a claim with NO witness field must behave exactly as
// before -- token binding only -- even against a gate that emits a witness.
// Expect CLAIM_PASS, ELF emitted.

claim sfc_witness_optional {
    hypothesis = "claims that declare no witness are unaffected",
    falsifier  = "adding the witness mechanism changed unrelated claims",
    evidence   = Evidence::GateGreen,
    harness    = "scripts/ci/fixtures/self_falsifying_witness_drift.sh",
    gate       = "scripts/ci/fixtures/self_falsifying_witness_drift.sh",
    verdict_token = "TOKEN_ALPHA",
    verdict    = Verdict::Alive,
}

fn main() -> i64 with IO {
    print("SELF_FALSIFYING_WITNESS_COMPAT_OK\n")
    0
}
