//@ ignore
// A claim declaring a witness must fail closed when the gate emits none,
// even though the gate exits 0 and its token is correct.
// Expect CLAIM_WITNESS_ABSENT, no ELF.

claim sfc_witness_absent {
    hypothesis = "the gate fingerprints the evidence it used",
    falsifier  = "the gate states the proposition without exhibiting grounds",
    evidence   = Evidence::GateGreen,
    harness    = "scripts/ci/fixtures/self_falsifying_witness_absent.sh",
    gate       = "scripts/ci/fixtures/self_falsifying_witness_absent.sh",
    verdict_token = "TOKEN_ALPHA",
    witness    = "abc123def456",
    verdict    = Verdict::Alive,
}

fn main() -> i64 with IO {
    print("SELF_FALSIFYING_WITNESS_ABSENT_UNREACHABLE\n")
    0
}
