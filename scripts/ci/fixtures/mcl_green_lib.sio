//@ ignore
// Green counterpart to self_falsifying_modclosure_lib: an imported module whose
// claim's gate PASSES. Pairs with mcl_green_main.sio to show that widening
// verification to the module closure reports the imported claim as a pass
// rather than simply failing everything it now sees.

claim mcl_green_library_claim {
    hypothesis = "a claim in an IMPORTED module is verified when its importer is compiled",
    falsifier  = "the importer compiles without ever running this gate",
    evidence   = Evidence::Implemented,
    harness    = "scripts/ci/fixtures/self_falsifying_claim_gate_pass.sh",
    gate       = "scripts/ci/fixtures/self_falsifying_claim_gate_pass.sh",
    verdict    = Verdict::Alive,
}

pub fn mcl_green_lib_value() -> i64 {
    42
}
