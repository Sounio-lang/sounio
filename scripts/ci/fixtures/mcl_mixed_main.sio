//@ ignore
// Mixed probe: imports one module whose claim is GREEN and one whose claim is
// RED. "Blocks anything it imports" and "verifies what it imports" both satisfy
// D1; only this separates them — the green import must be reported as a pass in
// the same run that the red one is reported as a failure.

use mcl_green_lib::{mcl_green_lib_value}
use self_falsifying_modclosure_lib::{modclosure_lib_value}

fn main() -> i64 with IO {
    if mcl_green_lib_value() + modclosure_lib_value() == 84 {
        print("MCL_MIXED_OK\n")
    }
    0
}
