//@ ignore
// Witness-binding probe: declared token AND declared witness both match.
// Expect CLAIM_PASS, VERIFY_CLAIMS_OK, ELF emitted.

claim sfc_witness_agrees {
    hypothesis = "the gate emits the token and the witness this claim declares",
    falsifier  = "either the token or the witness differs, or is absent",
    evidence   = Evidence::GateGreen,
    harness    = "scripts/ci/fixtures/self_falsifying_witness_match.sh",
    gate       = "scripts/ci/fixtures/self_falsifying_witness_match.sh",
    verdict_token = "TOKEN_ALPHA",
    witness    = "abc123def456",
    verdict    = Verdict::Alive,
}

fn main() -> i64 with IO {
    print("SELF_FALSIFYING_WITNESS_PASS_OK\n")
    0
}
