# One name, one definition per scope.
#
# Measured 2026-08-31 after four corrections to the scanner; see the gate
# header for each way this can be counted wrongly. Lower is the point.
#
# Re-measured 2026-09-01 after a FIFTH correction: braces were counted inside
# string literals, so one unmatched brace in a pattern string hid every later
# definition in that file. The rise from 4/2 is the scanner seeing more, not
# the tree getting worse -- these ten were always there.
identical=6
divergent=1

# CROSS-MODULE half, added 2026-09-01 for #2368: one top-level `pub fn` name
# exported by two different modules. Measured over self-hosted/ that day, and
# the count is a LOWER BOUND -- see the gate header for the four cuts (959 /
# 78 / 49 / 30) and for the measurement that the importer does not enforce
# `pub`, so 75 imports bind a non-pub definition this cut cannot see.
#
# One of the 27 divergent rows is `main`, across five standalone gpu test
# binaries (self-hosted/gpu/test_kaxi_*.sio). It is counted rather than
# excluded by name: a name blocklist is a hole in a gate whose whole value is
# having none.
cross_module_identical=22
cross_module_divergent=27
