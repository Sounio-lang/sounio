use check::check::{Checker, checker_init_in_place, checker_report_warning_at_mut}
use lexer::span::{Span}
use mem::box::{heap_alloc}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let checker = heap_alloc(262144) as *mut Checker
    let span = Span { file_id: 0, start: 0, end: 0 }
    checker_init_in_place(checker)
    checker_report_warning_at_mut(checker, span, 41, 0, 0, 0)
    print("warning_mut_ok\n")
    return 0
}
