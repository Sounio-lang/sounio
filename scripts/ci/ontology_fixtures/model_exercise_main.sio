
// Appended to stdlib/ontology/model.sio by ontology_model_compile_gate.sh to
// verify the Vec→Seq migration compiles AND runs (souc check is lenient; this is
// a full compile + execute). Exercises push-to-field, field subscript, &field[i]
// borrow, and struct-element non-aliasing.
fn main() -> i32 with IO, Mut, Panic, Epistemic {
    let oi = iri_new(1)
    var ont: Ontology = ontology_new(oi)
    let ci = iri_from_parts(1, 100)
    var c: OWLClass = owl_class_new(ci)
    var i = 0
    while i < 6 { owl_class_add_superclass(&c, iri_from_parts(1, 200 + i)); i = i + 1 }
    if c.superclasses.len().unwrap("n") != 6 { return 1 }
    let probe = iri_from_parts(1, 203)
    if !owl_class_has_superclass(&c, &probe) { return 2 }
    let absent = iri_from_parts(1, 999)
    if owl_class_has_superclass(&c, &absent) { return 3 }
    var present = 0
    var p = 0
    while p < 6 {
        let q = iri_from_parts(1, 200 + p)
        if owl_class_has_superclass(&c, &q) { present = present + 1 }
        p = p + 1
    }
    if present != 6 { return 4 }
    var k = 0
    while k < 5 { ontology_add_class(&ont, owl_class_new(iri_from_parts(2, 300 + k))); k = k + 1 }
    if ont.classes.len().unwrap("n") != 5 { return 5 }
    let want = iri_from_parts(2, 302)
    if ontology_get_class_index(&ont, &want) != 2 { return 6 }
    println("ontology_model_compile_gate: PASS")
    return 0
}
