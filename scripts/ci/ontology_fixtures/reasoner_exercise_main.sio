
// Appended to stdlib/ontology/reasoner.sio by ontology_reasoner_compile_gate.sh
// to verify the Vec→Seq migration + `with Mut` effect annotations compile AND
// run. Exercises transitive-closure materialization (field-store + scalar
// local-var mutation through &Reasoner) and the similarity queries that build
// Seq<i64> results. Asserts via the exit code: a lone trailing PASS print
// sometimes does not appear at exit, so the gate relies on the (reliable) exit
// status rather than grepping stdout.
fn main() -> i32 with IO, Mut, Panic, Epistemic {
    var r = reasoner_new()
    // Thing(0) < Animal(1) < Mammal(2) < {Dog(3), Cat(4)}
    reasoner_init_classes(&r, 5)
    reasoner_add_superclass(&r, 1, 0)
    reasoner_add_superclass(&r, 2, 1)
    reasoner_add_superclass(&r, 3, 2)
    reasoner_add_superclass(&r, 4, 2)
    reasoner_materialize(&r)

    // Dog and Cat share Mammal(2) as least common subsumer.
    let lcs = reasoner_least_common_subsumer(&r, 3, 4)
    if lcs != 2 { return 1 }
    let sim = reasoner_wu_palmer_similarity(&r, 3, 4)
    if !(sim > 0.0) { return 2 }
    // Dog is (transitively) a subclass of Thing.
    let sub = reasoner_is_subclass(&r, 3, 0)
    if !sub.value { return 3 }
    println("ontology_reasoner_compile_gate: PASS")
    return 0
}
