
// Appended to stdlib/ontology/query.sio by ontology_query_compile_gate.sh to
// verify the Vec→Seq migration + `with Mut` effect annotations compile AND run.
// Exercises Seq<Triple> push (triple_store_add), pattern matching, and
// sparql_execute (local-var reassignment + nested Seq build). Asserts via the
// exit code: a lone trailing PASS print sometimes does not appear at exit, so
// the gate relies on the (reliable) exit status rather than grepping stdout.
fn main() -> i32 with IO, Mut, Panic, Epistemic {
    var store = triple_store_new()
    triple_store_add(&store, triple_iri(100, 1, 10))  // john type Person
    triple_store_add(&store, triple_iri(101, 1, 10))  // jane type Person
    triple_store_add(&store, triple_iri(102, 1, 11))  // fido type Dog
    if triple_store_count(&store) != 3 { return 1 }

    var sq = sparql_new()
    sparql_select(&sq, 0)
    let pattern = triple_pattern_new(
        queryterm_variable(0),
        queryterm_iri(1),
        queryterm_iri(10)
    )
    sparql_add_pattern(&sq, pattern)

    let result = sparql_execute(&store, &sq)
    // ?x rdf:type Person should match john and jane.
    if sparql_result_count(&result) != 2 { return 2 }
    println("ontology_query_compile_gate: PASS")
    return 0
}
