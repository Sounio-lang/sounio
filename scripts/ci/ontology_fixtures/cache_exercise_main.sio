
// Appended to stdlib/ontology/cache.sio by ontology_cache_compile_gate.sh to
// verify the Vec→Seq migration + `with Mut` effect annotations compile AND run
// (souc check is lenient; this is a full compile + execute). Exercises
// field-store-through-&ref (cache_put/cache_get/cache_clear mutate scalar fields
// and Seq-element fields) plus Seq push/subscript. Asserts via the exit code:
// a lone trailing PASS print sometimes does not appear at exit, so the gate
// relies on the (reliable) exit status rather than grepping stdout.
fn main() -> i32 with IO, Mut, Panic, Epistemic {
    var cache = ontology_cache_new(10000)
    if !cache_put(&cache, 1, 100) { return 1 }
    if !cache_put(&cache, 2, 200) { return 2 }
    if !cache_contains(&cache, 1) { return 3 }
    if cache_contains(&cache, 99) { return 4 }
    if !cache_get(&cache, 1) { return 5 }   // hit
    if cache_get(&cache, 99) { return 6 }    // miss
    let hr = cache_hit_rate(&cache)
    if !(hr > 0.0 && hr < 1.0) { return 7 }
    cache_clear(&cache)
    var ont = lazy_ontology_new(100)
    if !lazy_ontology_needs_loading(&ont) { return 8 }
    lazy_ontology_mark_loaded(&ont, 5, 3, 42)
    if !lazy_ontology_is_loaded(&ont) { return 9 }
    println("ontology_cache_compile_gate: PASS")
    return 0
}
