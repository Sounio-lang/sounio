#!/usr/bin/env bash
#SBATCH --job-name=root06-reviewed-phase
#SBATCH --partition=all
#SBATCH --nodelist=dl380-dl380-proxmox
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=2
#SBATCH --mem=32G
#SBATCH --time=03:00:00
#SBATCH --export=NIL
# TEMPLATE ONLY: root supplies sbatch --output/--error outside immutable source.
# Root submits exactly ONE authorized modular bootstrap after reviewed preflight.
set -euo pipefail
: "${ROOT06_NODE_BIN:?explicit qualified private Node path}"
: "${ROOT06_RECIPE:?immutable reviewed root06_build_template.sh path}"
: "${ROOT06_PLAN:?actual qualified source/seed plan; no example plan is acceptable}"
: "${ROOT06_PHASE:?--stage or --preflight or --build, reviewed by root}"
exec "${ROOT06_BASH_BIN:?explicit qualified Bash path}" "$ROOT06_RECIPE" "$ROOT06_PHASE" "$ROOT06_PLAN"
