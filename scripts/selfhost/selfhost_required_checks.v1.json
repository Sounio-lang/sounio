{
  "schema": "sounio.selfhost_required_checks.v1",
  "ci_system": "github_actions",
  "target_branch": "main",
  "required_checks": [
    {
      "name": "Contracts",
      "workflow": "CI",
      "blocking": true,
      "purpose": "repository contracts and workflow/script consistency"
    },
    {
      "name": "Selfhost Authority",
      "workflow": "CI",
      "blocking": true,
      "purpose": "canonical selfhost authority gate for fixed-point, fallback inventory, aarch64 compile/runtime validation, and source↔artifact parity"
    },
    {
      "name": "Selfhost ABI/Parity",
      "workflow": "CI",
      "blocking": true,
      "purpose": "focused current-head ABI/parity regressions and target-taxonomy compile/runtime coverage"
    },
    {
      "name": "Sounio Lint",
      "workflow": "CI",
      "blocking": true,
      "purpose": "repository-wide .sio validation"
    },
    {
      "name": "Website",
      "workflow": "CI",
      "blocking": true,
      "purpose": "website quality checks"
    }
  ],
  "informational_checks": [
    {
      "name": "Seed Policy",
      "workflow": "Release Gate",
      "blocking": false
    },
    {
      "name": "Rust-Free Proof",
      "workflow": "Release Gate",
      "blocking": false
    },
    {
      "name": "LSP Smoke",
      "workflow": "Release Gate",
      "blocking": false
    },
    {
      "name": "Full Self-Host (5 generations)",
      "workflow": "Release Gate",
      "blocking": false
    },
    {
      "name": "Release Dashboard",
      "workflow": "Release Gate",
      "blocking": false
    }
  ],
  "review_policy": {
    "required_approvals": 1,
    "require_last_push_approval": true,
    "maintainer_review_required_for_paths": [
      "self-hosted/compiler/lean_single.sio",
      "artifacts/self-hosted/souc-self-hosted-x86_64",
      "artifacts/self-hosted/souc-self-hosted-x86_64.provenance.json",
      "scripts/selfhost/",
      "tests/selfhost/"
    ]
  },
  "merge_preconditions": [
    "all required checks pass",
    "current head introduces no unresolved parity regressions relative to the accepted artifact baseline",
    "artifact refreshes are accompanied by a provenance refresh produced by scripts/selfhost/update_selfhost_artifact.sh"
  ]
}
