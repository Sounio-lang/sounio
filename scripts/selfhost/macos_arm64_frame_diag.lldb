# macos_arm64_frame_diag.lldb — frame-corruption diagnostic for the self-hosted arm64 compiler.
#
# Usage (on macOS arm64):
#   lldb --batch -s scripts/selfhost/macos_arm64_frame_diag.lldb \
#     -- artifacts/self-hosted/souc-self-hosted-arm64-macos \
#        tests/selfhost/native_runtime/<case>.sio /tmp/out.macho --target aarch64-macos
#
# If the epilogue fix (mov sp,x29) is correct, the program runs to completion and
# this script prints "PROCESS EXITED". If it still ret-to-garbage, the stop-hook
# fires on the fault and dumps the frame state that names the faulting epilogue:
#   - sp / x29 / x30 : a corrupt frame shows x30 (LR) = small constant == pc
#   - [sp] 16 bytes  : the two words ldp read as the saved {x29,x30} pair
#   - backtrace      : single garbage frame == fell through into an epilogue/prologue

# On any stop (signal/crash), dump the frame-corruption evidence.
target stop-hook add -o "register read sp fp lr pc x9" -o "memory read --size 8 --format x --count 2 '$sp'" -o "thread backtrace"

run

# If we reach here without crashing, report clean exit.
script print(">>> PROCESS COMPLETED WITHOUT FAULT (epilogue fix holds)")
quit
