# macos_arm64_runtime_fault.lldb — capture a runtime fault in an EMITTED test binary.
#
# The arm64 self-hosted compiler now compiles 95/95 runtime-proof cases on macOS,
# but ~23 emitted binaries SIGSEGV at runtime loading from a NULL base
# (`ldr x0, [x0, x10, lsl #3]` with x0=0) — array / closure-env pointers that are
# valid on aarch64-linux (qemu) but NULL on Apple Silicon. These do NOT reproduce
# off-device, so this script captures the fault context needed to pin them.
#
# Usage (macOS arm64), on an already-codesigned emitted .elf:
#   codesign --force -s - /tmp/out.elf
#   lldb --batch -s scripts/selfhost/macos_arm64_runtime_fault.lldb -- /tmp/out.elf
#
# Capture this for 2-3 representative cases (e.g. closure_higher_order,
# array_return_local_*, closure_capture) and send the output back.

# On the fault: registers, the faulting instruction, a wide backtrace, and the
# 24 instructions BEFORE the fault (so the faulting function + how the NULL base
# was produced can be identified in a stripped binary).
target stop-hook add \
  -o "register read x0 x1 x9 x10 x29 x30 sp pc" \
  -o "disassemble --start-address \$pc --count 2" \
  -o "disassemble --start-address \$pc-96 --count 26" \
  -o "thread backtrace all" \
  -o "memory read --size 8 --format x --count 4 \$sp"

run

# Clean exit (no fault) → the case actually passed.
script print(">>> PROCESS COMPLETED WITHOUT FAULT")
quit
