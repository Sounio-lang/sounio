{
  "schema": "sounio.selfhost_promotion_policy.v1",
  "target_branch": "main",
  "entrypoints": {
    "authority_gate": "scripts/selfhost/selfhost_authority_gate.sh",
    "focused_abi_gate": "scripts/selfhost/selfhost_ci_abi_parity_gate.sh",
    "aarch64_runtime_gate": "scripts/selfhost/selfhost_aarch64_runtime_gate.sh",
    "provenance_gate": "scripts/selfhost/selfhost_artifact_provenance_gate.sh",
    "drift_gate": "scripts/selfhost/selfhost_release_drift_gate.sh",
    "policy_gate": "scripts/selfhost/selfhost_promotion_policy_gate.sh",
    "promotion_entrypoint": "scripts/selfhost/update_selfhost_artifact.sh",
    "release_candidate_gate": "scripts/selfhost/selfhost_release_candidate_gate.sh"
  },
  "reference_docs": {
    "authority_model": "docs/implementation/SELFHOST_AUTHORITY_MODEL.md",
    "release_train": "docs/implementation/SELFHOST_RELEASE_TRAIN.md",
    "debt_register": "docs/implementation/SELFHOST_DEBT_REGISTER.md"
  },
  "manifests": {
    "required_checks": "scripts/selfhost/selfhost_required_checks.v1.json",
    "abi_parity": "tests/selfhost/abi_parity/manifest.tsv",
    "aarch64_compile": "tests/selfhost/aarch64_compile/manifest.tsv",
    "aarch64_runtime": "tests/selfhost/aarch64_runtime/manifest.tsv"
  },
  "blocking_authority_checks": [
    "promotion_policy",
    "release_drift",
    "fixed_point",
    "fallback_inventory",
    "abi_parity_regressions",
    "aarch64_compile_proof",
    "aarch64_runtime",
    "source_artifact_parity"
  ],
  "nonblocking_surfaces": [
    "legacy_native_acceptance"
  ],
  "required_provenance_fields": [
    "schema",
    "generated_at_utc",
    "git",
    "artifact",
    "source",
    "policy",
    "target_taxonomy",
    "promotion",
    "bootstrap",
    "integrity"
  ],
  "required_gate_names_in_provenance": [
    "fixed_point",
    "fallback_inventory",
    "abi_parity_regressions",
    "aarch64_compile_proof",
    "aarch64_runtime",
    "source_artifact_parity"
  ],
  "allowed_support_classes": [
    "x86-runtime-supported",
    "aarch64-runtime-supported",
    "aarch64-compile-proof",
    "aarch64-explicit-unsupported"
  ],
  "artifact_freshness": {
    "require_clean_git_tree_before_promotion": true,
    "require_source_sha_match_current_tree": true,
    "require_artifact_sha_match_current_bytes": true,
    "require_provenance_for_checked_artifact": true,
    "require_policy_manifest_hash_match": true,
    "require_taxonomy_manifest_hash_match": true
  },
  "release_train_sequence": [
    "scripts/selfhost/selfhost_release_drift_gate.sh",
    "scripts/selfhost/selfhost_authority_gate.sh",
    "scripts/selfhost/selfhost_ci_abi_parity_gate.sh",
    "scripts/selfhost/selfhost_aarch64_runtime_gate.sh",
    "scripts/selfhost/update_selfhost_artifact.sh",
    "scripts/selfhost/selfhost_artifact_provenance_gate.sh"
  ],
  "rollback_policy": {
    "trigger_conditions": [
      "fixed-point failure after promotion attempt",
      "source↔artifact parity regression",
      "artifact/provenance integrity failure",
      "required-check drift failure"
    ],
    "operator_steps": [
      "stop promotion immediately",
      "discard the isolated worktree or revert the promotion branch locally",
      "re-run scripts/selfhost/selfhost_authority_gate.sh on the last accepted baseline",
      "if an inconsistent artifact/provenance pair was committed, revert both files together in one commit"
    ]
  }
}
