# Copy to scripts/omega/external_baseline_cmds.env and customize for your cluster.
#
# The adapter command must write a valid JSON report to $OMEGA_BASELINE_REPORT.
# Use scripts/omega/omega_emit_baseline_report.py for quick integration.

# Example: use remote command output and emit a local report.
# export OMEGA_CUDA_CUTLASS_CMD='ssh user@cluster "run_cutlass_bench --json /tmp/cutlass.json" && python3 scripts/omega/omega_emit_baseline_report.py --baseline-name cuda-cutlass --report "$OMEGA_BASELINE_REPORT" --samples 50 --speedup dense_linear=1.35 --speedup attention=1.25 --speedup epistemic_elementwise=1.18 --speedup monte_carlo=1.20 --speedup quantum_parallel=1.08 --reason cluster_cuda_cutlass'

# Local smoke example.
export OMEGA_CUDA_CUTLASS_CMD='python3 scripts/omega/omega_emit_baseline_report.py --baseline-name cuda-cutlass --report "$OMEGA_BASELINE_REPORT" --samples 50 --speedup dense_linear=1.35 --speedup attention=1.25 --speedup epistemic_elementwise=1.18 --speedup monte_carlo=1.20 --speedup quantum_parallel=1.08 --reason custom_cutlass_cmd'

# Local smoke example.
export OMEGA_TRITON_CMD='python3 scripts/omega/omega_emit_baseline_report.py --baseline-name triton --report "$OMEGA_BASELINE_REPORT" --samples 50 --speedup dense_linear=1.30 --speedup attention=1.28 --speedup epistemic_elementwise=1.22 --speedup monte_carlo=1.15 --speedup quantum_parallel=1.07 --reason custom_triton_cmd'

# Optional; if unset, adapter fallback probe is used.
# export OMEGA_PYTORCH_INDUCTOR_CMD='python3 scripts/omega/omega_emit_baseline_report.py --baseline-name pytorch-inductor --report "$OMEGA_BASELINE_REPORT" --samples 50 --speedup dense_linear=1.32 --speedup attention=1.27 --speedup epistemic_elementwise=1.26 --speedup monte_carlo=1.19 --speedup quantum_parallel=1.09 --reason custom_inductor_cmd'
