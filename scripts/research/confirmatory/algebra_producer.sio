// C5 — Sounio producer: algebra structure constants, first principles.
//
// Emits the multiplication tables used by the confirmatory controls,
// derived independently from defining rules (no shared code with
// controls.py):
//   OCT — octonions (Fano plane, Baez mnemonic orientation):
//         e0 = 1; e_i^2 = -1 (i>=1); anti-commutative imaginaries;
//         oriented lines (1,2,3) (1,4,5) (1,7,6) (2,4,6) (2,5,7)
//         (3,4,7) (3,6,5): e_a e_b = e_c cyclically.
//   CL3 — Clifford Cl(3,0): basis blades as masks of {e1,e2,e3},
//         e_i^2 = +1, e_i e_j = -e_j e_i; blade product sign from
//         inversions, result blade = symmetric difference.
//
// Output lines: "OCT i j k s" / "CL3 i j k s" for each nonzero
// structure constant (64 each), then "DONE".
// Cross-checked against controls.py by compare_tensors.py (octonions up
// to signed-permutation isomorphism — Fano relabeling freedom; Cl(3,0)
// exactly, blade rules are canonical).

fn bit_of(m: i32, p: i32) -> i32 with Div {
    let d = if p == 0 { 1 } else if p == 1 { 2 } else { 4 }
    (m / d) % 2
}

fn line_at(idx: i32) -> i32 {
    // 7 lines x 3 points, oriented (Baez mnemonic)
    let lines: [i32; 21] = [1, 2, 3, 1, 4, 5, 1, 7, 6, 2, 4, 6, 2, 5, 7,
                            3, 4, 7, 3, 6, 5]
    lines[idx]
}

fn oct_prod(i: i32, j: i32) -> i32 with Div {
    // returns sign * (k + 1) packed: ret = s * (k+1); k in 0..7, s in {+1,-1}
    if i == 0 { return j + 1 }
    if j == 0 { return i + 1 }
    if i == j { return -1 }  // e_i^2 = -1 -> k=0, s=-1
    var l: i32 = 0
    while l < 7 {
        let a = line_at(l * 3)
        let b = line_at(l * 3 + 1)
        let c = line_at(l * 3 + 2)
        if i == a && j == b { return c + 1 }
        if i == b && j == c { return a + 1 }
        if i == c && j == a { return b + 1 }
        if i == b && j == a { return -(c + 1) }
        if i == c && j == b { return -(a + 1) }
        if i == a && j == c { return -(b + 1) }
        l = l + 1
    }
    0  // unreachable for 1..7
}

fn cl3_prod(a: i32, b: i32) -> i32 with Div {
    // blade product: sign = (-1)^inversions, blade = symmetric difference
    var swaps: i32 = 0
    var k: i32 = 0
    var p: i32 = 0
    while p < 3 {
        if bit_of(a, p) == 1 {
            var q: i32 = 0
            while q < 3 {
                if bit_of(b, q) == 1 && p > q {
                    swaps = swaps + 1
                }
                q = q + 1
            }
        }
        p = p + 1
    }
    p = 0
    while p < 3 {
        let ba = bit_of(a, p)
        let bb = bit_of(b, p)
        if (ba + bb) % 2 == 1 {
            let d = if p == 0 { 1 } else if p == 1 { 2 } else { 4 }
            k = k + d
        }
        p = p + 1
    }
    if swaps % 2 == 1 {
        return -(k + 1)
    }
    k + 1
}

fn emit(tag_a: i32, i: i32, j: i32, packed: i32) -> () with IO {
    let s = if packed < 0 { -1 } else { 1 }
    let k = (if packed < 0 { -packed } else { packed }) - 1
    if tag_a == 0 {
        print("OCT ")
    } else {
        print("CL3 ")
    }
    print_int(i)
    print(" ")
    print_int(j)
    print(" ")
    print_int(k)
    print(" ")
    print_int(s)
    println("")
}

fn main() -> i32 with IO, Mut, Div {
    var i: i32 = 0
    while i < 8 {
        var j: i32 = 0
        while j < 8 {
            emit(0, i, j, oct_prod(i, j))
            j = j + 1
        }
        i = i + 1
    }
    i = 0
    while i < 8 {
        var j: i32 = 0
        while j < 8 {
            emit(1, i, j, cl3_prod(i, j))
            j = j + 1
        }
        i = i + 1
    }
    println("DONE")
    0
}
