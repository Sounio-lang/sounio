// ─── Sedenion loaders ────────────────────────────────────────────────────────

fn load_II(t: i64) -> Sedenion {
    Sedenion {
        e0: II_CH0[t],
        e1: II_CH1[t],
        e2: II_CH2[t],
        e3: II_CH3[t],
        e4: II_CH4[t],
        e5: II_CH5[t],
        e6: II_CH6[t],
        e7: II_CH7[t],
        e8: II_CH8[t],
        e9: II_CH9[t],
        e10: II_CH10[t],
        e11: II_CH11[t],
        e12: II_CH12[t],
        e13: II_CH13[t],
        e14: II_CH14[t],
        e15: II_CH15[t]
    }
}

