//@ run-pass
// epistemic-core/tests/test_knowledge.sio
// Testa KCoreKnowledge — construção, aritmética GUM, confidence_gate.

use epistemic_core::*

fn test_knowledge_add() -> bool with IO, Mut, Div, Panic {
    let a = measure(100.0, 2.0, "sensor_A")
    let b = measure(50.0,  1.5, "sensor_B")
    let c = knowledge_add(&a, &b)

    let expected_u = sqrt(2.0 * 2.0 + 1.5 * 1.5)
    let u_diff = knowledge_uncertainty(&c) - expected_u
    let u_diff_abs = if u_diff < 0.0 { 0.0 - u_diff } else { u_diff }

    knowledge_value(&c) == 150.0 && u_diff_abs < 1e-9
}

fn test_knowledge_mul() -> bool with Mut, Div, Panic {
    let a = measure(10.0, 0.5, "sensor_A")  // rel = 5%
    let b = measure(4.0,  0.2, "sensor_B")  // rel = 5%
    let c = knowledge_mul(&a, &b)

    // rel combined = sqrt(0.05^2 + 0.05^2) * 40 = ~2.8284
    let expected_val = 40.0
    let val_diff = knowledge_value(&c) - expected_val
    let val_diff_abs = if val_diff < 0.0 { 0.0 - val_diff } else { val_diff }

    let expected_u = sqrt((4.0 * 0.5) * (4.0 * 0.5) + (10.0 * 0.2) * (10.0 * 0.2))
    let u_diff = knowledge_uncertainty(&c) - expected_u
    let u_diff_abs = if u_diff < 0.0 { 0.0 - u_diff } else { u_diff }

    val_diff_abs < 1e-9 && u_diff_abs < 1e-9
}

fn test_knowledge_mul_zero_value() -> bool with Mut, Div, Panic {
    let a = measure(10.0, 0.5, "sensor_A")
    let b = measure(0.0, 0.2, "zero_centered_sensor")
    let c = knowledge_mul(&a, &b)

    let u_diff = knowledge_uncertainty(&c) - 2.0
    let u_diff_abs = if u_diff < 0.0 { 0.0 - u_diff } else { u_diff }
    knowledge_value(&c) == 0.0 && u_diff_abs < 1e-9
}

fn test_confidence_gate_pass() -> bool with Panic {
    let k = measure_with_confidence(42.0, 0.5, 0.95, "lab")
    confidence_gate(&k, 0.90)
    true
}

fn test_knowledge_div() -> bool with Mut, Div, Panic {
    let num = measure(100.0, 5.0, "num")
    let den = measure(4.0,   0.2, "den")
    let result = knowledge_div(&num, &den)

    let v_diff = knowledge_value(&result) - 25.0
    let v_diff_abs = if v_diff < 0.0 { 0.0 - v_diff } else { v_diff }
    let expected_u = sqrt((5.0 / 4.0) * (5.0 / 4.0) + (100.0 * 0.2 / 16.0) * (100.0 * 0.2 / 16.0))
    let u_diff = knowledge_uncertainty(&result) - expected_u
    let u_diff_abs = if u_diff < 0.0 { 0.0 - u_diff } else { u_diff }
    v_diff_abs < 1e-6 && u_diff_abs < 1e-9
}

fn test_knowledge_div_zero_numerator() -> bool with Mut, Div, Panic {
    let num = measure(0.0, 0.5, "zero_centered_sensor")
    let den = measure(4.0, 0.2, "den")
    let result = knowledge_div(&num, &den)

    let u_diff = knowledge_uncertainty(&result) - 0.125
    let u_diff_abs = if u_diff < 0.0 { 0.0 - u_diff } else { u_diff }
    knowledge_value(&result) == 0.0 && u_diff_abs < 1e-9
}

fn test_knowledge_rel_uncertainty() -> bool with Mut, Div, Panic {
    let k = measure(200.0, 10.0, "sensor")
    let rel = knowledge_rel_uncertainty(&k)
    let diff = rel - 0.05
    let diff_abs = if diff < 0.0 { 0.0 - diff } else { diff }
    diff_abs < 1e-9
}

fn test_sqrt_small_value() -> bool with Mut, Div, Panic {
    let result = sqrt(1e-10)
    let diff = result - 1e-5
    let diff_abs = if diff < 0.0 { 0.0 - diff } else { diff }
    diff_abs < 1e-12
}

fn test_gum_propagate_2() -> bool with Mut, Div, Panic {
    // f(a, b) = a + b^2 at a=3, b=2
    // df/da = 1, df/db = 2*b = 4
    let a = measure(3.0, 0.1, "a")
    let b = measure(2.0, 0.05, "b")
    let f_val = 3.0 + 2.0 * 2.0
    let result = gum_propagate_2(f_val, 1.0, &a, 4.0, &b)
    // u = sqrt((1*0.1)^2 + (4*0.05)^2) = sqrt(0.01 + 0.04) = sqrt(0.05)
    let expected_u = sqrt(0.05)
    let diff = knowledge_uncertainty(&result) - expected_u
    let diff_abs = if diff < 0.0 { 0.0 - diff } else { diff }
    diff_abs < 1e-9
}

fn main() with IO, Mut, Panic, Div {
    var passed: i64 = 0
    var total: i64 = 0

    total = total + 1
    if test_knowledge_add()         { passed = passed + 1 } else { println("FAIL: test_knowledge_add") }
    total = total + 1
    if test_knowledge_mul()         { passed = passed + 1 } else { println("FAIL: test_knowledge_mul") }
    total = total + 1
    if test_knowledge_mul_zero_value() { passed = passed + 1 } else { println("FAIL: test_knowledge_mul_zero_value") }
    total = total + 1
    if test_confidence_gate_pass()  { passed = passed + 1 } else { println("FAIL: test_confidence_gate_pass") }
    total = total + 1
    if test_knowledge_div()         { passed = passed + 1 } else { println("FAIL: test_knowledge_div") }
    total = total + 1
    if test_knowledge_div_zero_numerator() { passed = passed + 1 } else { println("FAIL: test_knowledge_div_zero_numerator") }
    total = total + 1
    if test_knowledge_rel_uncertainty() { passed = passed + 1 } else { println("FAIL: test_knowledge_rel_uncertainty") }
    total = total + 1
    if test_sqrt_small_value()      { passed = passed + 1 } else { println("FAIL: test_sqrt_small_value") }
    total = total + 1
    if test_gum_propagate_2()       { passed = passed + 1 } else { println("FAIL: test_gum_propagate_2") }

    print("epistemic-core tests: ")
    print_int(passed)
    print("/")
    print_int(total)
    println(" passed")

    assert(passed == total)
}
