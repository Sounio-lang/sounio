//@ run-pass
// epistemic-core/tests/test_gum_propagation.sio
// Testa GUM propagation multi-input e gum_propagate_3.

use epistemic_core::*

fn test_gum_3_additive() -> bool with Mut, Div, Panic {
    // f(a,b,c) = a + b + c — sensitividades todas = 1
    let a = measure(1.0, 0.1, "a")
    let b = measure(2.0, 0.2, "b")
    let c = measure(3.0, 0.3, "c")
    let result = gum_propagate_3(6.0, 1.0, &a, 1.0, &b, 1.0, &c)
    // u = sqrt(0.01 + 0.04 + 0.09) = sqrt(0.14)
    let expected = sqrt(0.14)
    let diff = knowledge_uncertainty(&result) - expected
    let diff_abs = if diff < 0.0 { 0.0 - diff } else { diff }
    diff_abs < 1e-9
}

fn test_knowledge_scale() -> bool with Mut, Div, Panic {
    let k = measure(10.0, 1.0, "sensor")
    let scaled = knowledge_scale(&k, 3.0)
    let v_ok = knowledge_value(&scaled) == 30.0
    let u_diff = knowledge_uncertainty(&scaled) - 3.0
    let u_ok = (if u_diff < 0.0 { 0.0 - u_diff } else { u_diff }) < 1e-9
    v_ok && u_ok
}

fn test_confidence_minimum_propagates() -> bool with Mut, Div, Panic {
    let a = measure_with_confidence(1.0, 0.1, 0.9, "a")
    let b = measure_with_confidence(2.0, 0.1, 0.7, "b")
    let c = knowledge_add(&a, &b)
    knowledge_confidence(&c) == 0.7
}

fn test_knowledge_sub_uncertainty() -> bool with Mut, Div, Panic {
    let a = measure(10.0, 0.3, "a")
    let b = measure(3.0,  0.4, "b")
    let c = knowledge_sub(&a, &b)
    let expected_v = 7.0
    let expected_u = sqrt(0.09 + 0.16)  // sqrt(0.25) = 0.5
    let v_diff = knowledge_value(&c) - expected_v
    let u_diff = knowledge_uncertainty(&c) - expected_u
    let v_ok = (if v_diff < 0.0 { 0.0 - v_diff } else { v_diff }) < 1e-9
    let u_ok = (if u_diff < 0.0 { 0.0 - u_diff } else { u_diff }) < 1e-9
    v_ok && u_ok
}

fn test_expanded_uncertainty() -> bool with Mut, Div, Panic {
    let k = measure(50.0, 2.5, "sensor")
    let u2 = knowledge_expanded(&k, 2.0)
    u2 == 5.0
}

fn main() with IO, Mut, Panic, Div {
    var passed: i64 = 0
    var total: i64 = 0

    total = total + 1
    if test_gum_3_additive()                   { passed = passed + 1 } else { println("FAIL: test_gum_3_additive") }
    total = total + 1
    if test_knowledge_scale()                  { passed = passed + 1 } else { println("FAIL: test_knowledge_scale") }
    total = total + 1
    if test_confidence_minimum_propagates()    { passed = passed + 1 } else { println("FAIL: test_confidence_minimum_propagates") }
    total = total + 1
    if test_knowledge_sub_uncertainty()        { passed = passed + 1 } else { println("FAIL: test_knowledge_sub_uncertainty") }
    total = total + 1
    if test_expanded_uncertainty()             { passed = passed + 1 } else { println("FAIL: test_expanded_uncertainty") }

    print("epistemic-core GUM tests: ")
    print_int(passed)
    print("/")
    print_int(total)
    println(" passed")

    assert(passed == total)
}
