// epistemic-core/examples/basic_measurement.sio
// Demonstra uso básico de KCoreKnowledge com propagação de incerteza.

use epistemic_core::*

fn main() with IO, Mut, Panic, Div {
    // Medição de dose farmacêutica
    let dose     = measure(500.0, 25.0, "HPLC_2025")      // 500 ± 25 mg
    let volume   = measure(10.0,  0.2,  "pipette_class_A") // 10  ± 0.2 mL
    let conc     = knowledge_div(&dose, &volume)            // GUM div

    print("Dose:          ")
    println_knowledge(&dose)
    print("Volume:        ")
    println_knowledge(&volume)
    print("Concentration: ")
    println_knowledge(&conc)

    // Gate de confiança: abort se conf < 0.90
    confidence_gate(&conc, 0.90)
    println("Confidence gate passed (>= 0.90)")

    // Escalonamento: converter mg/mL → ug/mL
    let conc_ug = knowledge_scale(&conc, 1000.0)
    print("Concentration (ug/mL): ")
    println_knowledge(&conc_ug)
}
