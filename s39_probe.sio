// Sprint 39 probe: therapeutic window sensitivity
// Windows: std=[4,20], consv_ceil=[4,15], strict_floor=[5,20], narrow=[5,15] ng/mL

module main

use pbpk::rapamycin_assay::{as_trough_mg_l}
use pbpk::rapamycin_expanded_u::{eu_u_c}
use pbpk::rapamycin_oral_budget::{
    ob_ka_var_std, ob_f_var_std, ob_ke_var_std, ob_k12_var_std, ob_k21_var_std,
    ob_ke_var_inh, ob_ke_var_ind
}

fn sqrt_f(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { 0.0 } else {
        var r = x; var i = 0
        while i < 50 { r = (r + x / r) / 2.0; i = i + 1 }
        r
    }
}

fn find_ncrit_w(d: f64, ke: f64, f: f64,
                ka_v: f64, f_v: f64, ke_v: f64, k12_v: f64, k21_v: f64,
                floor_c: f64, ceil_c: f64, max_n: i64) -> i64
    with Mut, Div, Panic {
    var n = 1; var found = 0
    while n <= max_n && found == 0 {
        let c = as_trough_mg_l(d, n, ke, f)
        let uc = eu_u_c(d, n, ke, f, ka_v, f_v, ke_v, k12_v, k21_v)
        let zf = (c - floor_c) / uc
        let zc = (ceil_c - c) / uc
        if zf >= 2.0 && zc >= 2.0 { found = n }
        else { n = n + 1 }
    }
    found
}

// Also compute Z values at specific N for a given window
fn z_floor_n(d: f64, n: i64, ke: f64, f: f64,
             ka_v: f64, f_v: f64, ke_v: f64, k12_v: f64, k21_v: f64,
             floor_c: f64) -> f64 with Mut, Div, Panic {
    let c = as_trough_mg_l(d, n, ke, f)
    let uc = eu_u_c(d, n, ke, f, ka_v, f_v, ke_v, k12_v, k21_v)
    (c - floor_c) / uc
}

fn z_ceil_n(d: f64, n: i64, ke: f64, f: f64,
            ka_v: f64, f_v: f64, ke_v: f64, k12_v: f64, k21_v: f64,
            ceil_c: f64) -> f64 with Mut, Div, Panic {
    let c = as_trough_mg_l(d, n, ke, f)
    let uc = eu_u_c(d, n, ke, f, ka_v, f_v, ke_v, k12_v, k21_v)
    (ceil_c - c) / uc
}

fn pi(n: i64) with Mut, Div, Panic, IO {
    if n == 0 { print("0") }
    else {
        var digits = [0, 0, 0, 0, 0, 0, 0, 0]
        var num = n; var count = 0
        while num > 0 { digits[count] = num - (num / 10) * 10; num = num / 10; count = count + 1 }
        var idx = count - 1
        while idx >= 0 {
            if digits[idx] == 0 { print("0") } else if digits[idx] == 1 { print("1") }
            else if digits[idx] == 2 { print("2") } else if digits[idx] == 3 { print("3") }
            else if digits[idx] == 4 { print("4") } else if digits[idx] == 5 { print("5") }
            else if digits[idx] == 6 { print("6") } else if digits[idx] == 7 { print("7") }
            else if digits[idx] == 8 { print("8") } else { print("9") };
            idx = idx - 1
        }
    }
}

fn main() with Mut, Div, Panic, IO {
    let ka = ob_ka_var_std(); let fv = ob_f_var_std()
    let ke = ob_ke_var_std(); let k12 = ob_k12_var_std(); let k21 = ob_k21_var_std()
    let ke_inh = ob_ke_var_inh(); let ke_ind = ob_ke_var_ind()

    // Windows (mg/L): std=[0.004,0.020], cc=[0.004,0.015], sf=[0.005,0.020], narrow=[0.005,0.015]
    let fl_std = 0.004; let ce_std = 0.020
    let fl_sf  = 0.005; let ce_std2 = 0.020
    let fl_std2= 0.004; let ce_cc = 0.015
    let fl_sf2 = 0.005; let ce_nw = 0.015
    let max_n = 60

    print("N_crit table:\n")
    print("std D=5mg:    std=") pi(find_ncrit_w(5.0,0.01118,0.141,ka,fv,ke,k12,k21,fl_std,ce_std,max_n))
    print(" sf=") pi(find_ncrit_w(5.0,0.01118,0.141,ka,fv,ke,k12,k21,fl_sf,ce_std2,max_n))
    print(" cc=") pi(find_ncrit_w(5.0,0.01118,0.141,ka,fv,ke,k12,k21,fl_std2,ce_cc,max_n))
    print(" nw=") pi(find_ncrit_w(5.0,0.01118,0.141,ka,fv,ke,k12,k21,fl_sf2,ce_nw,max_n))
    print("\n")

    print("slow D=5mg:   std=") pi(find_ncrit_w(5.0,0.00838,0.188,ka,fv,ke,k12,k21,fl_std,ce_std,max_n))
    print(" sf=") pi(find_ncrit_w(5.0,0.00838,0.188,ka,fv,ke,k12,k21,fl_sf,ce_std2,max_n))
    print(" cc=") pi(find_ncrit_w(5.0,0.00838,0.188,ka,fv,ke,k12,k21,fl_std2,ce_cc,max_n))
    print(" nw=") pi(find_ncrit_w(5.0,0.00838,0.188,ka,fv,ke,k12,k21,fl_sf2,ce_nw,max_n))
    print("\n")

    print("fast D=5mg:   std=") pi(find_ncrit_w(5.0,0.01677,0.094,ka,fv,ke,k12,k21,fl_std,ce_std,max_n))
    print(" sf=") pi(find_ncrit_w(5.0,0.01677,0.094,ka,fv,ke,k12,k21,fl_sf,ce_std2,max_n))
    print(" cc=") pi(find_ncrit_w(5.0,0.01677,0.094,ka,fv,ke,k12,k21,fl_std2,ce_cc,max_n))
    print(" nw=") pi(find_ncrit_w(5.0,0.01677,0.094,ka,fv,ke,k12,k21,fl_sf2,ce_nw,max_n))
    print("\n")

    print("inh D=1.5mg:  std=") pi(find_ncrit_w(1.5,0.002236,0.282,ka,fv,ke_inh,k12,k21,fl_std,ce_std,max_n))
    print(" sf=") pi(find_ncrit_w(1.5,0.002236,0.282,ka,fv,ke_inh,k12,k21,fl_sf,ce_std2,max_n))
    print(" cc=") pi(find_ncrit_w(1.5,0.002236,0.282,ka,fv,ke_inh,k12,k21,fl_std2,ce_cc,max_n))
    print(" nw=") pi(find_ncrit_w(1.5,0.002236,0.282,ka,fv,ke_inh,k12,k21,fl_sf2,ce_nw,max_n))
    print("\n")

    print("ind D34 N=26: std=") pi(find_ncrit_w(34.0,0.05590,0.047,ka,fv,ke_ind,k12,k21,fl_std,ce_std,max_n))
    print(" sf=") pi(find_ncrit_w(34.0,0.05590,0.047,ka,fv,ke_ind,k12,k21,fl_sf,ce_std2,max_n))
    print(" cc=") pi(find_ncrit_w(34.0,0.05590,0.047,ka,fv,ke_ind,k12,k21,fl_std2,ce_cc,max_n))
    print(" nw=") pi(find_ncrit_w(34.0,0.05590,0.047,ka,fv,ke_ind,k12,k21,fl_sf2,ce_nw,max_n))
    print("\n")

    // Z values at key N for slow — ceiling sensitivity
    print("\nslow Z_ceil at various N (std window ceil=0.020, cc ceil=0.015):\n")
    print("N=7:  zc_std="); print_f64(z_ceil_n(5.0,7,0.00838,0.188,ka,fv,ke,k12,k21,0.020))
    print(" zc_cc="); print_f64(z_ceil_n(5.0,7,0.00838,0.188,ka,fv,ke,k12,k21,0.015)); print("\n")
    print("N=14: zc_std="); print_f64(z_ceil_n(5.0,14,0.00838,0.188,ka,fv,ke,k12,k21,0.020))
    print(" zc_cc="); print_f64(z_ceil_n(5.0,14,0.00838,0.188,ka,fv,ke,k12,k21,0.015)); print("\n")
    print("N=26: zc_std="); print_f64(z_ceil_n(5.0,26,0.00838,0.188,ka,fv,ke,k12,k21,0.020))
    print(" zc_cc="); print_f64(z_ceil_n(5.0,26,0.00838,0.188,ka,fv,ke,k12,k21,0.015)); print("\n")

    // std Z_floor at N=6 for strict floor
    print("\nstd Z_floor at N=6 (std floor=0.004, sf floor=0.005):\n")
    print("N=6: zf_std="); print_f64(z_floor_n(5.0,6,0.01118,0.141,ka,fv,ke,k12,k21,0.004))
    print(" zf_sf="); print_f64(z_floor_n(5.0,6,0.01118,0.141,ka,fv,ke,k12,k21,0.005)); print("\n")
    print("N=7: zf_std="); print_f64(z_floor_n(5.0,7,0.01118,0.141,ka,fv,ke,k12,k21,0.004))
    print(" zf_sf="); print_f64(z_floor_n(5.0,7,0.01118,0.141,ka,fv,ke,k12,k21,0.005)); print("\n")

    // fast Z_floor sensitivity
    print("\nfast Z_floor N=14,15 (std floor=0.004, sf=0.005):\n")
    print("N=14: zf_std="); print_f64(z_floor_n(5.0,14,0.01677,0.094,ka,fv,ke,k12,k21,0.004))
    print(" zf_sf="); print_f64(z_floor_n(5.0,14,0.01677,0.094,ka,fv,ke,k12,k21,0.005)); print("\n")
    print("N=15: zf_std="); print_f64(z_floor_n(5.0,15,0.01677,0.094,ka,fv,ke,k12,k21,0.004))
    print(" zf_sf="); print_f64(z_floor_n(5.0,15,0.01677,0.094,ka,fv,ke,k12,k21,0.005)); print("\n")
}
