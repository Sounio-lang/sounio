// Basic Test Examples for sounio-test
//
// Demonstrates basic testing functionality

use sounio_test::{create_test_framework, TestFramework, TestConfig, TestMetadata}

// Create test framework instance
let tf: TestFramework = create_test_framework()

// ============================================================================
// 1. BASIC TESTS
// ============================================================================

fn test_addition() -> TestResult {
    let result = 2 + 2
    tf.assert(result == 4, "2 + 2 should equal 4")
}

fn test_subtraction() -> TestResult {
    let result = 10 - 5
    tf.assert(result == 5, "10 - 5 should equal 5")
}

fn test_multiplication() -> TestResult {
    let result = 3 * 4
    tf.assert(result == 12, "3 * 4 should equal 12")
}

fn test_division() -> TestResult {
    let result = 15 / 3
    tf.assert(result == 5, "15 / 3 should equal 5")
}

// ============================================================================
// 2. FLOATING POINT TESTS
// ============================================================================

fn test_float_addition() -> TestResult {
    let result = 0.1 + 0.2
    // Use tolerance for floating point comparison
    tf.assert_eq_float(result, 0.3, 0.000001, "0.1 + 0.2 should equal 0.3")
}

fn test_float_division() -> TestResult {
    let result = 1.0 / 3.0
    tf.assert_eq_float(result, 0.333333, 0.000001, "1/3 should be approximately 0.333333")
}

// ============================================================================
// 3. ARRAY TESTS
// ============================================================================

fn test_array_sum() -> TestResult {
    let numbers = [1, 2, 3, 4, 5]
    var sum = 0
    
    for n in numbers {
        sum = sum + n
    }
    
    tf.assert(sum == 15, "Sum of [1,2,3,4,5] should be 15")
}

fn test_array_average() -> TestResult {
    let numbers = [10.0, 20.0, 30.0, 40.0, 50.0]
    var sum = 0.0
    
    for n in numbers {
        sum = sum + n
    }
    
    let avg = sum / (array_len(numbers) as f64)
    tf.assert_eq_float(avg, 30.0, 0.000001, "Average should be 30.0")
}

// ============================================================================
// 4. STRING TESTS
// ============================================================================

fn test_string_concat() -> TestResult {
    let s1 = "Hello"
    let s2 = " World"
    let result = s1 + s2
    
    tf.assert(result == "Hello World", "String concatenation should work")
}

fn test_string_length() -> TestResult {
    let s = "Sounio"
    let length = str_len(s)
    
    tf.assert(length == 6, "'Sounio' should have length 6")
}

// ============================================================================
// 5. ERROR HANDLING TESTS
// ============================================================================

fn test_division_by_zero() -> TestResult {
    // This test should handle division by zero gracefully
    let result = safe_divide(10.0, 0.0)
    
    // Check that we got a special value (NaN or infinity)
    tf.assert(result.is_nan() || result.is_infinite(), 
        "Division by zero should produce NaN or infinity")
}

fn safe_divide(a: f64, b: f64) -> f64 {
    if b == 0.0 {
        return 0.0 / 0.0  // NaN
    }
    a / b
}

// ============================================================================
// 6. TEST RUNNER SETUP
// ============================================================================

fn run_all_basic_tests() with IO {
    println("🧪 Running Basic Tests")
    println("====================\n")
    
    // Create test configuration
    let config = TestConfig {
        min_confidence: 0.8,
        timeout_ms: 5000,
        check_provenance: false,
        check_uncertainty: false,
        report_format: "console",
        output_dir: ".",
        verbose: true,
    }
    
    // Create test runner
    let runner = tf.create_test_runner(config)
    
    // Register all tests
    let basic_metadata = TestMetadata {
        tags: ["basic", "unit"],
        iterations: 1,
        required_confidence: 1.0,
        check_uncertainty: false,
        check_provenance: false,
    }
    
    tf.register_test(&!runner, "test_addition", test_addition, basic_metadata)
    tf.register_test(&!runner, "test_subtraction", test_subtraction, basic_metadata)
    tf.register_test(&!runner, "test_multiplication", test_multiplication, basic_metadata)
    tf.register_test(&!runner, "test_division", test_division, basic_metadata)
    tf.register_test(&!runner, "test_float_addition", test_float_addition, basic_metadata)
    tf.register_test(&!runner, "test_float_division", test_float_division, basic_metadata)
    tf.register_test(&!runner, "test_array_sum", test_array_sum, basic_metadata)
    tf.register_test(&!runner, "test_array_average", test_array_average, basic_metadata)
    tf.register_test(&!runner, "test_string_concat", test_string_concat, basic_metadata)
    tf.register_test(&!runner, "test_string_length", test_string_length, basic_metadata)
    tf.register_test(&!runner, "test_division_by_zero", test_division_by_zero, basic_metadata)
    
    // Run tests
    tf.run_tests(&!runner)
}

// ============================================================================
// 7. MAIN FUNCTION
// ============================================================================

fn main() with IO {
    println("📚 sounio-test Basic Examples")
    println("============================\n")
    
    run_all_basic_tests()
    
    println("\n🎯 Basic test examples completed!")
    println("Next: Try epistemic_tests.sio for uncertainty-aware testing")
}
