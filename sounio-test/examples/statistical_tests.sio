// Statistical Test Examples for sounio-test
//
// Demonstrates statistical testing with confidence intervals and significance

use sounio_test::{create_test_framework, TestFramework, TestConfig, TestMetadata}

// Create test framework instance
let tf: TestFramework = create_test_framework()

// ============================================================================
// 1. STATISTICAL HELPER FUNCTIONS
// ============================================================================

// Calculate mean of array
fn mean(data: [f64]) -> f64 {
    var sum = 0.0
    for value in data {
        sum = sum + value
    }
    sum / (array_len(data) as f64)
}

// Calculate standard deviation
fn std_dev(data: [f64]) -> f64 {
    let m = mean(data)
    var sum_sq = 0.0
    
    for value in data {
        let diff = value - m
        sum_sq = sum_sq + diff * diff
    }
    
    sqrt(sum_sq / (array_len(data) as f64 - 1.0))
}

// Generate random sample from normal distribution
fn random_normal_sample(size: i64, mean_val: f64, std_val: f64) -> [f64] {
    var sample: [f64] = []
    
    for i in 0..size {
        // Simplified normal distribution generator
        // In real implementation, would use proper random generator
        let u1 = random_uniform()
        let u2 = random_uniform()
        
        // Box-Muller transform
        let z0 = sqrt(-2.0 * log(u1)) * cos(2.0 * π * u2)
        let value = mean_val + std_val * z0
        
        sample = array_append(sample, value)
    }
    
    sample
}

// Simplified random uniform [0, 1)
fn random_uniform() -> f64 {
    // Placeholder - would use proper RNG
    0.5
}

// Mathematical constants
let π: f64 = 3.141592653589793

// ============================================================================
// 2. DISTRIBUTION TESTS
// ============================================================================

fn test_normal_distribution_mean() -> TestResult {
    // Generate sample from normal distribution
    let sample = random_normal_sample(1000, 0.0, 1.0)
    let sample_mean = mean(sample)
    
    // Test that sample mean is close to population mean
    // With 1000 samples, mean should be within ~0.1 of 0.0
    tf.assert_statistical(
        sample_mean,
        expected = 0.0,
        tolerance = 0.1,
        confidence = 0.95,
        "Sample mean should be close to population mean"
    )
}

fn test_normal_distribution_variance() -> TestResult {
    let sample = random_normal_sample(1000, 0.0, 1.0)
    let sample_std = std_dev(sample)
    
    // Test that sample standard deviation is close to 1.0
    tf.assert_statistical(
        sample_std,
        expected = 1.0,
        tolerance = 0.1,
        confidence = 0.95,
        "Sample standard deviation should be close to 1.0"
    )
}

// ============================================================================
// 3. HYPOTHESIS TESTS
// ============================================================================

fn test_two_sample_t_test() -> TestResult {
    // Simulate clinical trial: treatment vs control
    let treatment_group = random_normal_sample(500, 2.5, 1.0)  // Treatment effect
    let control_group = random_normal_sample(500, 2.0, 1.0)    // Baseline
    
    let treatment_mean = mean(treatment_group)
    let control_mean = mean(control_group)
    
    // Simplified t-test (in reality would compute proper t-statistic)
    let mean_difference = treatment_mean - control_mean
    
    // Test if treatment is significantly better
    // With these parameters, difference should be positive
    tf.assert_statistical(
        mean_difference,
        expected = 0.5,  // True difference
        tolerance = 0.2,  // Allow some sampling error
        confidence = 0.99,
        "Treatment should show significant improvement"
    )
}

fn test_proportion_test() -> TestResult {
    // Test proportion (e.g., success rate)
    // Simulate 1000 trials with 70% success rate
    var successes = 0
    let trials = 1000
    let true_success_rate = 0.7
    
    for i in 0..trials {
        if random_uniform() < true_success_rate {
            successes = successes + 1
        }
    }
    
    let observed_rate = successes as f64 / trials as f64
    
    // Test that observed rate is close to true rate
    tf.assert_statistical(
        observed_rate,
        expected = true_success_rate,
        tolerance = 0.03,  // 3% margin
        confidence = 0.95,
        "Observed success rate should match true rate"
    )
}

// ============================================================================
// 4. STATISTICAL POWER TESTS
// ============================================================================

fn test_statistical_power() -> TestResult {
    // Test that we can detect effect of given size
    // with specified statistical power
    
    let effect_size = 0.5  // Medium effect
    let sample_size = 100  // Per group
    
    // Generate data with effect
    let group1 = random_normal_sample(sample_size, 0.0, 1.0)
    let group2 = random_normal_sample(sample_size, effect_size, 1.0)
    
    let mean1 = mean(group1)
    let mean2 = mean(group2)
    let mean_diff = mean2 - mean1
    
    // With n=100 per group and effect=0.5, we should detect difference
    // Standard error ~ sqrt(2/n) = ~0.14
    // So 0.5 is about 3.5 SEs - highly significant
    
    tf.assert_statistical(
        mean_diff,
        expected = effect_size,
        tolerance = 0.3,  // Allow for sampling variability
        confidence = 0.95,
        "Should detect medium effect size with n=100 per group"
    )
}

// ============================================================================
// 5. MONTE CARLO TESTS
// ============================================================================

fn test_monte_carlo_pi() -> TestResult {
    // Estimate π using Monte Carlo simulation
    let iterations = 10000
    var inside_circle = 0
    
    for i in 0..iterations {
        let x = random_uniform() * 2.0 - 1.0  // [-1, 1]
        let y = random_uniform() * 2.0 - 1.0  // [-1, 1]
        
        if x*x + y*y <= 1.0 {
            inside_circle = inside_circle + 1
        }
    }
    
    let pi_estimate = 4.0 * (inside_circle as f64) / (iterations as f64)
    
    // Monte Carlo estimate should be close to π
    tf.assert_statistical(
        pi_estimate,
        expected = π,
        tolerance = 0.1,  // With 10k iterations, error ~0.01
        confidence = 0.95,
        "Monte Carlo should estimate π accurately"
    )
}

fn test_monte_carlo_integration() -> TestResult {
    // Test Monte Carlo integration
    // Integrate f(x) = x^2 from 0 to 1
    // True value: ∫₀¹ x² dx = 1/3 ≈ 0.333333
    
    let iterations = 10000
    var sum = 0.0
    
    for i in 0..iterations {
        let x = random_uniform()
        sum = sum + x * x
    }
    
    let integral_estimate = sum / (iterations as f64)
    
    tf.assert_statistical(
        integral_estimate,
        expected = 1.0/3.0,
        tolerance = 0.01,
        confidence = 0.99,
        "Monte Carlo integration should be accurate"
    )
}

// ============================================================================
// 6. EPISTEMIC STATISTICAL TESTS
// ============================================================================

fn test_epistemic_statistical() -> TestResult {
    // Statistical test with epistemic uncertainty
    
    // Measurements with uncertainty
    let group1_measurements = tf.generate_epistemic_array(50, 0.0, 10.0, 0.5)
    let group2_measurements = tf.generate_epistemic_array(50, 2.0, 12.0, 0.5)
    
    // Calculate means with propagated uncertainty
    var sum1: Knowledge[f64] = create_measurement(0.0, 0.0, "zero")
    var sum2: Knowledge[f64] = create_measurement(0.0, 0.0, "zero")
    
    for x in group1_measurements {
        sum1 = sum1 + x
    }
    
    for x in group2_measurements {
        sum2 = sum2 + x
    }
    
    let mean1 = sum1 / 50.0
    let mean2 = sum2 / 50.0
    
    let difference = mean2 - mean1
    
    // Test if difference is statistically significant
    // considering measurement uncertainty
    
    // Effect should be positive (group2 > group1)
    let value_ok = difference.value > 0.0
    
    // Uncertainty should be reasonable
    let uncertainty_ok = difference.ε < 2.0
    
    // Confidence in difference
    let confidence = 1.0 / (1.0 + difference.ε)  // Simple confidence metric
    
    tf.assert(value_ok && uncertainty_ok,
        "Group difference should be positive with reasonable uncertainty")
    
    // Return result with statistical confidence
    TestResult {
        name: "test_epistemic_statistical",
        passed: value_ok && uncertainty_ok,
        confidence: confidence,
        duration_ms: 0,
        message: "Epistemic statistical test",
        provenance: "statistical_test_with_uncertainty",
        uncertainty_reason: "Combined measurement and sampling uncertainty",
        metadata: TestMetadata {
            tags: ["epistemic", "statistical", "uncertainty"],
            iterations: 50,
            required_confidence: 0.7,
            check_uncertainty: true,
            check_provenance: true,
        },
    }
}

fn create_measurement(value: f64, uncertainty: f64, source: string) -> Knowledge[f64] {
    Knowledge(value: value, ε: uncertainty, prov: source)
}

// ============================================================================
// 7. TEST RUNNER FOR STATISTICAL TESTS
// ============================================================================

fn run_all_statistical_tests() with IO {
    println("📈 Running Statistical Tests")
    println("==========================\n")
    
    // Create test configuration for statistical tests
    let config = TestConfig {
        min_confidence: 0.9,  // Higher threshold for statistical tests
        timeout_ms: 30000,    // Longer timeout for Monte Carlo
        check_provenance: false,
        check_uncertainty: true,
        report_format: "console",
        output_dir: ".",
        verbose: true,
    }
    
    // Create test runner
    let runner = tf.create_test_runner(config)
    
    // Metadata for statistical tests
    let statistical_metadata = TestMetadata {
        tags: ["statistical", "monte_carlo", "hypothesis"],
        iterations: 1000,  // Default iterations for statistical tests
        required_confidence: 0.9,
        check_uncertainty: true,
        check_provenance: false,
    }
    
    // Register all statistical tests
    tf.register_test(&!runner, "test_normal_distribution_mean", 
        test_normal_distribution_mean, statistical_metadata)
    tf.register_test(&!runner, "test_normal_distribution_variance", 
        test_normal_distribution_variance, statistical_metadata)
    tf.register_test(&!runner, "test_two_sample_t_test", 
        test_two_sample_t_test, statistical_metadata)
    tf.register_test(&!runner, "test_proportion_test", 
        test_proportion_test, statistical_metadata)
    tf.register_test(&!runner, "test_statistical_power", 
        test_statistical_power, statistical_metadata)
    tf.register_test(&!runner, "test_monte_carlo_pi", 
        test_monte_carlo_pi, statistical_metadata)
    tf.register_test(&!runner, "test_monte_carlo_integration", 
        test_monte_carlo_integration, statistical_metadata)
    tf.register_test(&!runner, "test_epistemic_statistical", 
        test_epistemic_statistical, statistical_metadata)
    
    // Run tests
    tf.run_tests(&!runner)
}

// ============================================================================
// 8. MAIN FUNCTION
// ============================================================================

fn main() with IO {
    println("📊 sounio-test Statistical Examples")
    println("==================================\n")
    
    println("This example demonstrates:")
    println("  • Distribution testing (normal, uniform)")
    println("  • Hypothesis testing (t-tests, proportions)")
    println("  • Statistical power analysis")
    println("  • Monte Carlo methods")
    println("  • Epistemic statistical tests\n")
    
    run_all_statistical_tests()
    
    println("\n📈 Statistical testing ensures results are not due to chance!")
    println("Combined with epistemic uncertainty for scientific rigor.")
}
