//@ run-pass
//! Validates every pattern from SOUNIO_QUICK_START.md against the real compiler

// === Pattern 1: Variables ===
fn test_variables() with Mut, Div, Panic {
    let x = 5
    var y: i32 = 10
    y = y + x
    assert(y == 15)
}

// === Pattern 2: Fixed-size arrays ===
fn test_arrays() with Mut, Div, Panic {
    var buffer: [u8; 256] = [0; 256]
    buffer[0] = 42u8
    buffer[255] = 99u8
    assert(buffer[0] == 42u8)
    assert(buffer[255] == 99u8)
    assert(buffer[1] == 0u8)
}

// === Pattern 3: Mutable references &! ===
fn increment(x: &!i32) with Mut, Panic {
    *x = *x + 1
}

// === Pattern 4: Effects — Div ===
fn divide(a: f64, b: f64) -> f64 with Div, Panic {
    a / b
}

// === Pattern 5: abs via 0 - x (no unary minus) ===
fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

// === Pattern 6: check_near (floating-point comparison) ===
fn check_near(a: f64, b: f64, tol: f64) -> bool {
    abs_f64(a - b) < tol
}

// === Pattern 7: Struct with by-value update ===
struct Counter {
    value: i32,
}

fn counter_inc(c: Counter) -> Counter {
    Counter { value: c.value + 1 }
}

fn test_struct_by_value() with Mut, Div, Panic {
    var c = Counter { value: 0 }
    c = counter_inc(c)
    c = counter_inc(c)
    c = counter_inc(c)
    assert(c.value == 3)
}

// === Pattern 8: Error code return ===
fn safe_divide(a: f64, b: f64) -> f64 with Div, Panic {
    if b == 0.0 {
        return 0.0
    }
    a / b
}

fn test_safe_divide() with Mut, Div, Panic {
    assert(check_near(safe_divide(10.0, 2.0), 5.0, 0.000001))
    assert(safe_divide(10.0, 0.0) == 0.0)
}

// === Pattern 9: Byte array loop ===
fn sum_bytes(data: &[u8; 256], len: i32) -> i32 with Mut, Div, Panic {
    var total: i32 = 0
    var i: i32 = 0
    while i < len {
        total = total + data[i as usize] as i32
        i = i + 1
    }
    total
}

fn test_byte_loop() with Mut, Div, Panic {
    var data: [u8; 256] = [0; 256]
    data[0] = 10u8
    data[1] = 20u8
    data[2] = 30u8
    let total = sum_bytes(&data, 3)
    assert(total == 60)
}

// === Pattern 10: While loop (preferred over for) ===
fn test_while_loop() with Mut, Div, Panic {
    var sum = 0
    var i = 0
    while i < 10 {
        sum = sum + i
        i = i + 1
    }
    assert(sum == 45)
}

// === Pattern 11: Bit operations with u8 operand ===
fn test_bit_ops() with Mut, Div, Panic {
    let byte: u8 = 222u8  // 0xDE
    let high = (byte >> 4u8) & 15u8
    let low = byte & 15u8
    assert(high == 13u8)  // 0xD = 13
    assert(low == 14u8)   // 0xE = 14
}

// === Pattern 12: Nested if/else ===
fn classify(x: i32) -> i32 {
    if x > 0 {
        1
    } else {
        if x < 0 {
            0 - 1
        } else {
            0
        }
    }
}

fn test_classify() with Mut, Div, Panic {
    assert(classify(5) == 1)
    assert(classify(0) == 0)
    assert(classify(0 - 3) == (0 - 1))
}

// === Main: run all pattern tests ===
pub fn main() with Mut, Div, Panic {
    test_variables()
    test_arrays()
    test_struct_by_value()
    test_safe_divide()
    test_byte_loop()
    test_while_loop()
    test_bit_ops()
    test_classify()
}
