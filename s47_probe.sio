module main

use pbpk::rapamycin_visit_gap::{
    vg_alarm_n7, vg_alarm_n14, vg_alarm_n18, vg_alarm_n22, vg_alarm_n23, vg_alarm_n28,
    vg_n_alarm_free_max, vg_n_alarm_onset_post14,
    vg_gap_standard, vg_gap_alarm_free, vg_gap_excess, vg_safe_pct10
}

fn pi(n: i64) with Mut, Div, Panic, IO {
    if n == 0 { print("0") }
    else {
        var digits = [0, 0, 0, 0, 0, 0, 0, 0]
        var num = n; var count = 0
        while num > 0 { digits[count] = num - (num / 10) * 10; num = num / 10; count = count + 1 }
        var idx = count - 1
        while idx >= 0 {
            if digits[idx] == 0 { print("0") } else if digits[idx] == 1 { print("1") }
            else if digits[idx] == 2 { print("2") } else if digits[idx] == 3 { print("3") }
            else if digits[idx] == 4 { print("4") } else if digits[idx] == 5 { print("5") }
            else if digits[idx] == 6 { print("6") } else if digits[idx] == 7 { print("7") }
            else if digits[idx] == 8 { print("8") } else { print("9") };
            idx = idx - 1
        }
    }
}

fn main() with Mut, Div, Panic, IO {
    print("=== Spot alarm values ===\n")
    print("alarm_n7="); print_f64(vg_alarm_n7()); print("\n")
    print("alarm_n14="); print_f64(vg_alarm_n14()); print("\n")
    print("alarm_n18="); print_f64(vg_alarm_n18()); print("\n")
    print("alarm_n22="); print_f64(vg_alarm_n22()); print("\n")
    print("alarm_n23="); print_f64(vg_alarm_n23()); print("\n")
    print("alarm_n28="); print_f64(vg_alarm_n28()); print("\n")

    print("\n=== Scanners ===\n")
    print("n_alarm_free_max="); pi(vg_n_alarm_free_max()); print("\n")
    print("n_alarm_onset_post14="); pi(vg_n_alarm_onset_post14()); print("\n")

    print("\n=== Gap metrics ===\n")
    print("gap_standard="); pi(vg_gap_standard()); print("\n")
    print("gap_alarm_free="); pi(vg_gap_alarm_free()); print("\n")
    print("gap_excess="); pi(vg_gap_excess()); print("\n")
    print("safe_pct10="); pi(vg_safe_pct10()); print("\n")
}
