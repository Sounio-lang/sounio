// ============================================================================
// SOUNIO DEMO 2: Propagação Analítica de Incertezas (ISO GUM)
// ============================================================================
//
// Diferente de Python ou Matlab que exigem simulações lentas de Monte Carlo
// (executar a fórmula 1 milhão de vezes com ruído), o compilador do Sounio
// propaga a variância analiticamente em tempo real com custo zero.
//
// Para rodar esta demonstração:
//    ./bin/souc run demo_incerteza.sio
// ============================================================================

// Função auxiliar para calcular a raiz quadrada (Newton-Raphson)
fn sqrt(x: f64) -> f64 with Mut, Div {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 15 {
        y = (y + x / y) * 0.5
        i = i + 1
    }
    return y
}

fn main() with IO, Mut, Div, Epistemic {
    println("=== Sounio Demo 2: Propagação de Incerteza (ISO GUM) ===")

    // Semeamos duas medições físicas reais com suas incertezas padrão (desvio padrão)
    let k_comprimento: Knowledge<f64> = measure(10.0, uncertainty: 0.1) // 10.0 ± 0.1
    let k_largura:     Knowledge<f64> = measure(5.0,  uncertainty: 0.05) // 5.0  ± 0.05

    let comp = k_comprimento.value
    let larg = k_largura.value

    // 1. Soma (Incertezas quadradas somadas: 0.1² + 0.05² = 0.01 + 0.0025 = 0.0125)
    let perimetro = (comp + larg) * 2.0
    let var_perimetro = variance_of(perimetro)
    let desvio_perimetro = sqrt(var_perimetro)

    // 2. Multiplicação (Propagação não-linear de primeira ordem do GUM)
    //    var(A) = comp² * var(larg) + larg² * var(comp)
    //           = 100 * 0.0025 + 25 * 0.01 = 0.25 + 0.25 = 0.50
    let area = comp * larg
    let var_area = variance_of(area)
    let desvio_area = sqrt(var_area)

    // Impressão dos resultados em tempo real
    println("Medições iniciais:")
    print("  Comprimento = 10.00, Incerteza (sd) = 0.10  (var = ")
    print_f64(variance_of(comp))
    println(")")
    
    print("  Largura     =  5.00, Incerteza (sd) = 0.05  (var = ")
    print_f64(variance_of(larg))
    println(")\n")

    println("Cálculos Propagados Analiticamente:")
    
    print("  Perímetro   = ")
    print_f64(perimetro)
    print(" ± ")
    print_f64(desvio_perimetro)
    print(" (Variância calculada: ")
    print_f64(var_perimetro)
    println(")")

    print("  Área        = ")
    print_f64(area)
    print(" ± ")
    print_f64(desvio_area)
    print(" (Variância calculada: ")
    print_f64(var_area)
    println(")")

    println("\n[SOUC] Sucesso! Incerteza propagada de acordo com o Guia GUM.")
}
