module main

use pbpk::rapamycin_population_coverage::{
    pc_cert_n7, pc_warn_n7, pc_alarm_n7,
    pc_cert_n14, pc_warn_n14, pc_alarm_n14,
    pc_cert_n28, pc_warn_n28, pc_alarm_n28
}

fn main() with Mut, Div, Panic, IO {
    print("=== N=7 (week 1) ===\n")
    print("cert="); print_f64(pc_cert_n7()); print("\n")
    print("warn="); print_f64(pc_warn_n7()); print("\n")
    print("alarm="); print_f64(pc_alarm_n7()); print("\n")
    print("sum="); print_f64(pc_cert_n7() + pc_warn_n7() + pc_alarm_n7()); print("\n")

    print("\n=== N=14 (week 2) ===\n")
    print("cert="); print_f64(pc_cert_n14()); print("\n")
    print("warn="); print_f64(pc_warn_n14()); print("\n")
    print("alarm="); print_f64(pc_alarm_n14()); print("\n")
    print("sum="); print_f64(pc_cert_n14() + pc_warn_n14() + pc_alarm_n14()); print("\n")

    print("\n=== N=28 (month 1) ===\n")
    print("cert="); print_f64(pc_cert_n28()); print("\n")
    print("warn="); print_f64(pc_warn_n28()); print("\n")
    print("alarm="); print_f64(pc_alarm_n28()); print("\n")
    print("sum="); print_f64(pc_cert_n28() + pc_warn_n28() + pc_alarm_n28()); print("\n")

    print("\n=== Cross-visit deltas ===\n")
    print("cert_n28 - cert_n14="); print_f64(pc_cert_n28() - pc_cert_n14()); print("\n")
    print("warn_n14 - warn_n7="); print_f64(pc_warn_n14() - pc_warn_n7()); print("\n")
    print("alarm_n7 - alarm_n28="); print_f64(pc_alarm_n7() - pc_alarm_n28()); print("\n")
}
