module main

use pbpk::rapamycin_dose_adjust::{
    da_slow_margin_n28_d05, da_slow_margin_n28_d10, da_slow_margin_n28_d15,
    da_slow_margin_n28_d20, da_slow_margin_n28_d25, da_slow_margin_n28_d30,
    da_slow_margin_n28_d35, da_slow_margin_n28_d40, da_slow_margin_n28_d45,
    da_slow_margin_n28_d50,
    da_slow_d_cert_max, da_slow_d_cert_min, da_slow_d_optimal,
    da_slow_cert_range_steps
}

fn pi(n: i64) with Mut, Div, Panic, IO {
    if n == 0 { print("0") }
    else {
        var digits = [0, 0, 0, 0, 0, 0, 0, 0]
        var num = n; var count = 0
        while num > 0 { digits[count] = num - (num / 10) * 10; num = num / 10; count = count + 1 }
        var idx = count - 1
        while idx >= 0 {
            if digits[idx] == 0 { print("0") } else if digits[idx] == 1 { print("1") }
            else if digits[idx] == 2 { print("2") } else if digits[idx] == 3 { print("3") }
            else if digits[idx] == 4 { print("4") } else if digits[idx] == 5 { print("5") }
            else if digits[idx] == 6 { print("6") } else if digits[idx] == 7 { print("7") }
            else if digits[idx] == 8 { print("8") } else { print("9") };
            idx = idx - 1
        }
    }
}

fn main() with Mut, Div, Panic, IO {
    print("=== Slow stratum GUM margin at N=28 ===\n")
    print("D=0.5mg: "); print_f64(da_slow_margin_n28_d05()); print("\n")
    print("D=1.0mg: "); print_f64(da_slow_margin_n28_d10()); print("\n")
    print("D=1.5mg: "); print_f64(da_slow_margin_n28_d15()); print("\n")
    print("D=2.0mg: "); print_f64(da_slow_margin_n28_d20()); print("\n")
    print("D=2.5mg: "); print_f64(da_slow_margin_n28_d25()); print("\n")
    print("D=3.0mg: "); print_f64(da_slow_margin_n28_d30()); print("\n")
    print("D=3.5mg: "); print_f64(da_slow_margin_n28_d35()); print("\n")
    print("D=4.0mg: "); print_f64(da_slow_margin_n28_d40()); print("\n")
    print("D=4.5mg: "); print_f64(da_slow_margin_n28_d45()); print("\n")
    print("D=5.0mg: "); print_f64(da_slow_margin_n28_d50()); print("\n")

    print("\n=== Scanners ===\n")
    print("d_cert_max="); print_f64(da_slow_d_cert_max()); print(" mg\n")
    print("d_cert_min="); print_f64(da_slow_d_cert_min()); print(" mg\n")
    print("d_optimal=");  print_f64(da_slow_d_optimal());  print(" mg\n")
    print("cert_range_steps="); pi(da_slow_cert_range_steps()); print("\n")
}
