// Uncertainty Propagation Benchmarks - Sounio (Knowledge<T>)
//
// Native epistemic type benchmarks demonstrating GUM-compliant
// uncertainty propagation with compile-time optimizations.
//
// Reference: JCGM 100:2008 (GUM)
// DOI: 10.5281/zenodo.18404188

use std::epistemic::*
use std::time::*

// =============================================================================
// Benchmark 1: GUM Propagation Chain
// =============================================================================

fn bench_gum_chain(n_ops: i32) -> Knowledge<f64> with IO {
    // Initial values with uncertainty
    let x = Knowledge::measured(10.0, 0.01, "initial_x")  // 10.0 ± 0.1 (variance = 0.01)
    let y = Knowledge::measured(5.0, 0.0025, "initial_y")  // 5.0 ± 0.05 (variance = 0.0025)

    var result = x
    var i = 0
    while i < n_ops {
        let m = i % 4
        if m == 0 {
            result = result + y
        } else if m == 1 {
            result = result - y.scale(0.1)
        } else if m == 2 {
            result = result * Knowledge::measured(1.01, 0.000001, "factor")
        } else {
            result = result / Knowledge::measured(1.01, 0.000001, "divisor")
        }
        i = i + 1
    }

    return result
}


// =============================================================================
// Benchmark 2: Monte Carlo Portfolio
// =============================================================================

fn bench_monte_carlo(n_samples: i32) -> (f64, f64) with IO {
    // Portfolio parameters with uncertainty
    let ret1 = Knowledge::measured(0.08, 0.0004, "return_1")  // 8% ± 2%
    let ret2 = Knowledge::measured(0.12, 0.0009, "return_2")  // 12% ± 3%
    let ret3 = Knowledge::measured(0.06, 0.0001, "return_3")  // 6% ± 1%

    let w1 = 0.4
    let w2 = 0.35
    let w3 = 0.25

    let initial_value = 1000000.0

    var sum_values = 0.0
    var sum_sq = 0.0
    var i = 0

    while i < n_samples {
        var value = Knowledge::constant(initial_value)
        value = value * (Knowledge::constant(1.0) + ret1.scale(w1))
        value = value * (Knowledge::constant(1.0) + ret2.scale(w2))
        value = value * (Knowledge::constant(1.0) + ret3.scale(w3))

        let v = *value.get()
        sum_values = sum_values + v
        sum_sq = sum_sq + v * v
        i = i + 1
    }

    let mean = sum_values / (n_samples as f64)
    let variance = (sum_sq / (n_samples as f64)) - (mean * mean)
    let std_dev = sqrt(abs(variance))

    return (mean, std_dev)
}


// =============================================================================
// Benchmark 3: Scientific Formula (Creatinine Clearance)
// =============================================================================

fn bench_cockcroft_gault(n_patients: i32) -> Knowledge<f64> with IO {
    // Cockcroft-Gault equation for creatinine clearance
    // CrCl = ((140 - age) × weight × [0.85 if female]) / (72 × SCr)

    var total = Knowledge::constant(0.0)
    var i = 0

    while i < n_patients {
        // Patient parameters with typical measurement uncertainties
        let age_val = 65.0 + ((i % 30) as f64)
        let weight_val = 70.0 + ((i % 40) as f64)
        let scr_val = 1.2 + ((i % 10) as f64) * 0.1
        let is_female = (i % 2) == 0

        let age = Knowledge::measured(age_val, 0.25, "age")  // ± 0.5 years
        let weight = Knowledge::measured(weight_val, 1.0, "weight")  // ± 1.0 kg
        let scr = Knowledge::measured(scr_val, 0.0025, "scr")  // ± 0.05 mg/dL

        let gender_factor = if is_female { 0.85 } else { 1.0 }

        // Calculate CrCl with uncertainty propagation
        let numerator = (Knowledge::constant(140.0) - age) * weight
        let numerator_adj = numerator.scale(gender_factor)
        let denominator = Knowledge::constant(72.0) * scr
        let crcl = numerator_adj / denominator

        total = total + crcl
        i = i + 1
    }

    return total
}


// =============================================================================
// Benchmark 4: Transcendental Functions
// =============================================================================

fn bench_transcendental(n_ops: i32) -> Knowledge<f64> with IO {
    // Uncertainty propagation through transcendental functions
    var x = Knowledge::measured(1.0, 0.0001, "x")  // 1.0 ± 0.01

    var i = 0
    while i < n_ops {
        let y1 = x.map(sin, "sin")
        let y2 = y1.map(cos, "cos")
        let y3 = y2.scale(0.1).map(exp, "exp")
        let y4 = (y3 + Knowledge::constant(1.0)).map(ln, "ln")
        let y5 = (y4 + Knowledge::constant(1.0)).sqrt()
        x = y5
        i = i + 1
    }

    return x
}


// =============================================================================
// Timing Utilities
// =============================================================================

fn measure_time<T>(f: fn() -> T with IO) -> (T, f64) with IO {
    let start = now_nanos()
    let result = f()
    let end = now_nanos()
    let elapsed_ms = ((end - start) as f64) / 1000000.0
    return (result, elapsed_ms)
}


fn run_benchmark<T>(
    name: string,
    f: fn() -> T with IO,
    warmup: i32,
    runs: i32
) -> f64 with IO {
    // Warmup
    var w = 0
    while w < warmup {
        let _ = f()
        w = w + 1
    }

    // Timed runs
    var times: [f64; 20] = [0.0; 20]
    var r = 0
    while r < runs {
        let (_, elapsed) = measure_time(f)
        times[r] = elapsed
        r = r + 1
    }

    // Calculate statistics (simple median for odd runs)
    // Sort times (bubble sort for simplicity)
    var s = 0
    while s < runs - 1 {
        var t = 0
        while t < runs - s - 1 {
            if times[t] > times[t + 1] {
                let tmp = times[t]
                times[t] = times[t + 1]
                times[t + 1] = tmp
            }
            t = t + 1
        }
        s = s + 1
    }

    let median = times[runs / 2]

    var sum = 0.0
    var i = 0
    while i < runs {
        sum = sum + times[i]
        i = i + 1
    }
    let mean = sum / (runs as f64)

    println(name)
    println("  Median: ")
    print_f64(median)
    println(" ms")
    println("  Mean: ")
    print_f64(mean)
    println(" ms")
    println("  Min: ")
    print_f64(times[0])
    println(" ms")
    println("  Max: ")
    print_f64(times[runs - 1])
    println(" ms")
    println("")

    return median
}


// =============================================================================
// Main
// =============================================================================

fn main() with IO {
    println("============================================================")
    println("Uncertainty Propagation Benchmarks - Sounio (Knowledge<T>)")
    println("============================================================")
    println("")

    let warmup = 3
    let runs = 10

    // GUM Chain benchmarks
    let t1 = run_benchmark(
        "GUM Chain (10K ops)",
        || bench_gum_chain(10000),
        warmup,
        runs
    )

    let t2 = run_benchmark(
        "GUM Chain (100K ops)",
        || bench_gum_chain(100000),
        warmup,
        runs
    )

    // Monte Carlo benchmarks
    let t3 = run_benchmark(
        "Monte Carlo (10K samples)",
        || bench_monte_carlo(10000),
        warmup,
        runs
    )

    let t4 = run_benchmark(
        "Monte Carlo (100K samples)",
        || bench_monte_carlo(100000),
        warmup,
        runs
    )

    // Cockcroft-Gault benchmarks
    let t5 = run_benchmark(
        "Cockcroft-Gault (10K patients)",
        || bench_cockcroft_gault(10000),
        warmup,
        runs
    )

    // Transcendental benchmarks
    let t6 = run_benchmark(
        "Transcendental (10K ops)",
        || bench_transcendental(10000),
        warmup,
        runs
    )

    println("============================================================")
    println("Summary (median times in ms):")
    println("============================================================")
    println("GUM Chain (10K): ")
    print_f64(t1)
    println(" ms")
    println("GUM Chain (100K): ")
    print_f64(t2)
    println(" ms")
    println("Monte Carlo (10K): ")
    print_f64(t3)
    println(" ms")
    println("Monte Carlo (100K): ")
    print_f64(t4)
    println(" ms")
    println("Cockcroft-Gault (10K): ")
    print_f64(t5)
    println(" ms")
    println("Transcendental (10K): ")
    print_f64(t6)
    println(" ms")
}
