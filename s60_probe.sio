module main

use pbpk::rapamycin_constraint_crossover::{
    cc_midpoint,
    cc_crossover_inh, cc_crossover_slow, cc_crossover_std,
    cc_crossover_fast, cc_crossover_ind,
    cc_std_floor_n7,  cc_std_ceil_n7,
    cc_std_floor_n14, cc_std_ceil_n14,
    cc_std_floor_n28, cc_std_ceil_n28,
    cc_std_crossover_lead
}

fn pi(n: i64) with Mut, Div, Panic, IO {
    if n == 0 { print("0") }
    else {
        var digits = [0, 0, 0, 0, 0, 0, 0, 0]
        var num = n; var count = 0
        while num > 0 { digits[count] = num - (num / 10) * 10; num = num / 10; count = count + 1 }
        var idx = count - 1
        while idx >= 0 {
            if digits[idx] == 0 { print("0") } else if digits[idx] == 1 { print("1") }
            else if digits[idx] == 2 { print("2") } else if digits[idx] == 3 { print("3") }
            else if digits[idx] == 4 { print("4") } else if digits[idx] == 5 { print("5") }
            else if digits[idx] == 6 { print("6") } else if digits[idx] == 7 { print("7") }
            else if digits[idx] == 8 { print("8") } else { print("9") };
            idx = idx - 1
        }
    }
}

fn main() with Mut, Div, Panic, IO {
    print("=== Therapeutic midpoint ===\n")
    print("midpoint (mg/L): "); print_f64(cc_midpoint()); print("\n")
    print("\n")
    print("=== Crossover days (trough first reaches midpoint) ===\n")
    print("inh  N_x: "); pi(cc_crossover_inh());  print("\n")
    print("slow N_x: "); pi(cc_crossover_slow()); print("\n")
    print("std  N_x: "); pi(cc_crossover_std());  print("\n")
    print("fast N_x: "); pi(cc_crossover_fast()); print("\n")
    print("ind  N_x: "); pi(cc_crossover_ind());  print("  (0=never)\n")
    print("\n")
    print("=== Std stratum floor/ceil margins at monitoring visits ===\n")
    print("N=7  floor: "); print_f64(cc_std_floor_n7());  print("\n")
    print("N=7  ceil:  "); print_f64(cc_std_ceil_n7());   print("\n")
    print("N=14 floor: "); print_f64(cc_std_floor_n14()); print("\n")
    print("N=14 ceil:  "); print_f64(cc_std_ceil_n14());  print("\n")
    print("N=28 floor: "); print_f64(cc_std_floor_n28()); print("\n")
    print("N=28 ceil:  "); print_f64(cc_std_ceil_n28());  print("\n")
    print("\n")
    print("crossover_lead (N_x - n_crit=6): "); pi(cc_std_crossover_lead()); print("\n")
}
