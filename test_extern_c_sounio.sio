// test_extern_c_sounio.sio — extern "C" blocks should pass Check 4
// Semicolons inside extern "C" { } are valid FFI declarations, not style errors.

extern "C" {
    fn sqrt(x: f64) -> f64;
    fn log(x: f64) -> f64;
    fn exp(x: f64) -> f64;
    fn fabs(x: f64) -> f64;
    fn pow(x: f64, y: f64) -> f64;
}

fn compute_log_normal(x: f64, mu: f64, sigma: f64) -> f64 {
    let log_x = log(x)
    let z = (log_x - mu) / sigma
    return 0.0 - 0.5 * z * z - log_x - log(sigma)
}

fn compute_sqrt(x: f64) -> f64 {
    return sqrt(x)
}

fn main() -> i64 {
    return 0
}
