//@ run-pass
//@ expect-stdout: ALL PASS
// Consistent ontology evolution — guarded version chain with REMOVAL
// and repair-then-retry (miniature).
//
// Frontier: consistent-ontology-evolution (see FRONTIER.md)
//
// Literature anchor: Bayoudhi, Sassi, Jaziri 2018 (doi:10.1111/exsy.12355).
// This prototype extends version_chain.sio (which modelled only axiom
// addition) with surgical removal: when the guard rejects a new axiom,
// the conflicting established axiom can be excised and the edit retried.
// The companion formal/OntologyEvolutionRepair.lean proves: removal of a
// sublist keeps consistency; the a priori invariant generalises to mixed
// add/remove scripts; and repair-then-retry succeeds when the removed
// axiom was the unique conflicting partner.
//
// Scenario: add axioms 1, 2, 3; axiom 4 contradicts the established
// axiom 2 and is rejected; remove axiom 2; re-add axiom 4 (accepted).
// Final version: {1, 3, 4}. Consistency is checked after every step.
//
// NOTE: contracts are runtime assertions (Madaros does not yet parse
// `where` refinements); arrays use splat initialisation and parallel
// primitive arrays.

fn conflicts(a: i64, b: i64) -> bool {
    // The only incoherent pair: new axiom 4 contradicts established axiom 2.
    if a == 2 && b == 4 { return true }
    if a == 4 && b == 2 { return true }
    return false
}

fn main() -> i32 with IO, Mut {
    var n_fail = 0

    // Active axiom set for the current version (ids 0..5).
    var active: [bool; 6] = [false; 6]

    // Edit script (kinds: 0 = add, 1 = remove):
    //   add 1, add 2, add 3, add 4 (rejected), remove 2, add 4 (accepted).
    var kind: [i64; 6] = [0; 6]
    kind[4] = 1
    var axiom: [i64; 6] = [0; 6]
    axiom[0] = 1
    axiom[1] = 2
    axiom[2] = 3
    axiom[3] = 4
    axiom[4] = 2
    axiom[5] = 4

    var n_versions: i64 = 1  // the initial empty version
    var n_rejected: i64 = 0
    var n_removed: i64 = 0

    var e: i64 = 0
    while e < 6 {
        let k = kind[e]
        let a = axiom[e]
        if k == 0 {
            // Guarded addition: does the candidate conflict with any active axiom?
            var clash = false
            var x: i64 = 0
            while x < 6 {
                if active[x] {
                    if conflicts(a, x) {
                        clash = true
                    }
                }
                x = x + 1
            }
            // Snapshot to check preservation on rejection.
            let was2 = active[2]
            let was4 = active[4]
            if clash {
                n_rejected = n_rejected + 1
            } else {
                active[a] = true
            }
            n_versions = n_versions + 1

            // Rejection must preserve the previous version exactly.
            if clash {
                if active[2] != was2 { println("FAIL: version changed on reject"); n_fail = n_fail + 1 }
                if active[4] != was4 { println("FAIL: version changed on reject"); n_fail = n_fail + 1 }
            }
        } else {
            // Removal: excise the axiom (always succeeds; all occurrences go).
            if active[a] {
                active[a] = false
                n_removed = n_removed + 1
            }
            n_versions = n_versions + 1
        }

        // ── A priori invariant: the new version is consistent ──────────
        var i: i64 = 0
        while i < 6 {
            var j: i64 = i + 1
            while j < 6 {
                if active[i] && active[j] {
                    if conflicts(i, j) {
                        println("FAIL: inconsistent version produced")
                        n_fail = n_fail + 1
                    }
                }
                j = j + 1
            }
            i = i + 1
        }
        e = e + 1
    }

    // ── Final state: exactly {1, 3, 4} active ──────────────────────────
    if !active[1] { println("FAIL: axiom 1 missing"); n_fail = n_fail + 1 }
    if active[2]  { println("FAIL: axiom 2 should be removed"); n_fail = n_fail + 1 }
    if !active[3] { println("FAIL: axiom 3 missing"); n_fail = n_fail + 1 }
    if !active[4] { println("FAIL: axiom 4 should be accepted after repair"); n_fail = n_fail + 1 }
    if active[5]  { println("FAIL: axiom 5 was never added"); n_fail = n_fail + 1 }
    if n_rejected != 1 { println("FAIL: expected exactly 1 rejection"); n_fail = n_fail + 1 }
    if n_removed != 1 { println("FAIL: expected exactly 1 removal"); n_fail = n_fail + 1 }
    if n_versions != 7 { println("FAIL: expected 7 versions"); n_fail = n_fail + 1 }

    if n_fail == 0 {
        println("ALL PASS")
        return 0
    }
    println("FAILURES:")
    println(n_fail)
    return 1
}
