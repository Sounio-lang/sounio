// Minimal repro — LIMITATION 2a: arrays of structs segfault at runtime.
//
// `var ms: [M; 2]` followed by struct-literal element stores compiles and
// links, but the produced ELF segfaults when run via `souc run`.
// Working alternative (used by the ontology-frontiers prototypes): parallel
// primitive arrays with splat initialization.
struct M { id: i64, conf: f64 }

fn main() -> i32 with IO, Mut {
    var ms: [M; 2]
    ms[0] = M { id: 1, conf: 0.5 }
    ms[1] = M { id: 2, conf: 0.7 }
    println("OK")
    return 0
}
