// Leaf module for LIMITATION P5 (qualified-import miscompile).
// Three independently observable behaviors: an exclusive-ref mutation, a
// scalar cross-module call, and a module-level array read.
pub fn bump(a: &![i64; 2]) with Mut {
    a[0] = a[0] + 1
}

pub fn add(a: i64, b: i64) -> i64 {
    return a + b
}

pub fn fill7(a: &![i64; 4]) with Mut {
    a[0] = 7
    a[1] = 7
    a[2] = 7
    a[3] = 7
}
