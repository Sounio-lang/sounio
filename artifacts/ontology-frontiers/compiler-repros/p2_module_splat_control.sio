// Control for LIMITATION P2: identical splat-initialized arrays as
// main-locals. Expected and observed: 0 0 0 0 / false false false.
fn main() -> i32 with IO, Mut {
    var l_i64: [i64; 4] = [0; 4]
    var l_bool: [bool; 3] = [false; 3]
    println(l_i64[0])
    println(l_i64[1])
    println(l_i64[2])
    println(l_i64[3])
    println(l_bool[0])
    println(l_bool[1])
    println(l_bool[2])
    return 0
}
