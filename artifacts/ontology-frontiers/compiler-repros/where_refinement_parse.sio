// Minimal repro — LIMITATION 1: `where` refinement clauses do not parse.
//
// Mirrors the pattern in examples/epistemic_dempster_shafer.sio:
// a postcondition refinement `where result.confidence >= max(...)` after
// the return type. The current Madaros parser reports
//   parse error: expected token
// at the `where` position, yet `souc check` still exits 0 (the error is
// only visible in stdout).
fn fused_conf<T>(
    a: Knowledge<T>,
    b: Knowledge<T>
) -> Knowledge<bool> where result.confidence >= max(a.confidence, b.confidence) {
    return measure(true, confidence: 0.9)
}

fn main() -> i32 with IO {
    return 0
}
