// Minimal repro — LIMITATION 2b: arrays without splat initialization
// segfault at runtime.
//
// `var a: [f64; 3]` (no initializer) compiles, but the produced ELF
// segfaults at the first element store when run via `souc run`.
// Working alternative: splat initialization `= [0.0; 3]` (see
// splat_array_ok.sio).
fn main() -> i32 with IO, Mut {
    var a: [f64; 3]
    a[0] = 1.0
    println("OK")
    return 0
}
