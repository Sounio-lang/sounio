// LIMITATION P2: module-level splat-initialized arrays have garbage leading
// elements. `g_i64` / `g_bool` are splat-initialized to all-0 / all-false at
// module scope; expected output is 0 0 0 0 / false false false.
// Observed (2026-08-02, Madaros v0.80.0): leading elements read as garbage
// (nonzero i64; bool reads true). Control: p2_module_splat_control.sio --
// the identical arrays as main-locals read back correctly.
var g_i64: [i64; 4] = [0; 4]
var g_bool: [bool; 3] = [false; 3]

fn main() -> i32 with IO, Mut {
    println(g_i64[0])
    println(g_i64[1])
    println(g_i64[2])
    println(g_i64[3])
    println(g_bool[0])
    println(g_bool[1])
    println(g_bool[2])
    return 0
}
