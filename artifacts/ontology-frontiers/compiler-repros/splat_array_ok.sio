// Working control for LIMITATION 2b: splat-initialized arrays run fine.
//
// Identical to uninit_array_segfault.sio except the array carries a splat
// initializer `= [0.0; 3]`; this is the pattern the ontology-frontiers
// prototypes use.
fn main() -> i32 with IO, Mut {
    var a: [f64; 3] = [0.0; 3]
    a[0] = 1.0
    println("OK")
    return 0
}
