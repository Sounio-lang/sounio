// Control for LIMITATION P5: identical program using the named-import form
//   use p5_qualified_leaf::{bump, add, fill7}
// Expected and observed output: 1 / 42 / 7 7 7 7.
use p5_qualified_leaf::{bump, add, fill7}
fn main() -> i32 with IO, Mut {
    var x: [i64; 2] = [0; 2]
    bump(&!x)
    println(x[0])
    println(add(40, 2))
    var y: [i64; 4] = [0; 4]
    fill7(&!y)
    println(y[0])
    println(y[1])
    println(y[2])
    println(y[3])
    return 0
}
