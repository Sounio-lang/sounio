//@ run-pass
//@ expect-stdout: ALL PASS
// Round 12: EL+ role-aware boolean closure on the FULL GO go-plus
// ontology (GO-only policy: H = 38,245 classes, NR = 92 roles incl. the
// RO-closure derived-edge targets, ~58k sub, ~19k exsub, 107 roleSub,
// 60 roleComp).  Executable mirror of the verified saturation engine of
// formal/OntologyELPlusClosureComplete.lean (crStep / closeSatF), at a
// scale where neither the dense variant (64 concepts), the round-11
// self-contained dense driver (U*B matrices: 405k x 45k cells), nor the
// round-9 sparse variant (Anatomy profile: single role, no role axioms)
// applies.
//
// Strategy (see README round 12): the ~24k-statement compiler wall is
// bypassed by loading the TBox at RUNTIME (read_file + str_char_at, the
// stdlib/data/csv_reader.sio pattern) from go_full_packed.txt; the O(U^2)
// boolean matrices are replaced by i64 BITMASKS (WC 64-bit words per
// row): anc[c] = stated-sub ancestor mask (incl. self and the top bit),
// F[(r,c)] = ancestor-closed mask of base fillers of role edges with
// atom source c.  The 8-rule fixpoint reduces on this data profile (no
// extracted conjunctions, no superclass-side restrictions — go-plus has
// none, probed) to:
//   1. anc in ONE topological pass (GO is_a is a DAG; Kahn);
//   2. F seeding F[r][c] |= anc[f] (folds Rmono: seeds are
//      ancestor-closed and unions of closed sets are closed, so the
//      Rmono invariant needs no separate pass) and ONE topological pass
//      F[r][c] |= F[r][p] over parents p (folds transitivity + stoR:
//      x <= c and edge (r, c, f) give edge (r, x, f));
//   3. roleSub / roleComp hybrid fixpoint (round 12b): roleSub via a
//      dirty worklist (complete for this single-input rule), roleComp
//      via a full scan over non-empty rows per round — a dirty worklist
//      on first components is INCOMPLETE for roleComp (when F[r2][f]
//      gains an edge, the chain must re-fire for every c with f in
//      F[r1][c]; two correct worklist orders converged 7,200 edges apart
//      on this data, exposing the leak);
//   4. by the profile theorem (round 11, math-reviewed; re-verified here
//      computationally on the round-11 slice against the general
//      fixpoint): roles add no ATOMIC subsumptions or conflicts, so
//      atomic closure edges / conflicts come from anc[] alone, and the
//      existential targets of an atom row are exactly its role-edge
//      fillers (stoR/RtoS bijection).
//
// Scope (honest limitation): statistics are ATOM-LEVEL.  Universe-level
// numbers of rounds 9/11 (S cells over U = 3.56M interned concepts, role
// edges with existential sources) are not computed: existential-sourced
// edge sets would need a composition fixpoint per (r, f) pair.
//
// Checks: every number must equal the python bitmask mirror
// (gen_go_full_data.py, embedded as go_full_expected_*()); the mirror
// itself was validated against the general set-based fixpoint on the
// round-11 slice (--validate-slice, exact agreement incl. ablations).
//
// Data: go_full_packed.txt (runtime-loaded; written by
// gen_go_full_data.py from extract_tbox.py --go --go-full output).
// Run from the repo root (the CI gate does): the read_file path below is
// repo-relative.

import go_full_expected::*

// ── capacities (compile-time) ────────────────────────────────────────────
const HC: i64 = 39000        // classes incl. the top slot (H = 38245)
const NRC: i64 = 96          // roles (NR = 92)
const WC: i64 = 598          // bitmask words per row (B = H+1 = 38246 bits)
const SUBC: i64 = 60000      // sub axioms (57824)
const EXC: i64 = 20000       // existential restrictions (18791)
const DJC: i64 = 128         // disjoint pairs (55)
const RSC: i64 = 160         // roleSub axioms (107)
const RCC: i64 = 96          // roleComp chains (60)
const EPC: i64 = 128         // distinct disjointness endpoints (<= 110)

// ── module-level workspace (mutated by own-module fns only — the &!-
//    boundary miscompile of rounds 9-11) ─────────────────────────────────
// anc[c*WC + w]: stated-sub ancestor bitmask of class c (bit H = top).
pub var anc: [i64; 23322000] = [0; 23322000]
// fm[(r*HC + c)*WC + w]: role-edge filler mask (atom sources).
pub var fm: [i64; 2238912000] = [0; 2238912000]
// dirty cells for the roleSub worklist; non-empty row flags for the
// roleComp full scan.
pub var cur_dirty: [bool; 3744000] = [false; 3744000]
pub var nxt_dirty: [bool; 3744000] = [false; 3744000]
pub var f_nonempty: [bool; 3744000] = [false; 3744000]
// stated axioms (runtime-parsed).
pub var sub_c: [i64; 60000] = [0; 60000]
pub var sub_p: [i64; 60000] = [0; 60000]
pub var ex_c: [i64; 20000] = [0; 20000]
pub var ex_r: [i64; 20000] = [0; 20000]
pub var ex_f: [i64; 20000] = [0; 20000]
pub var dj_a: [i64; 128] = [0; 128]
pub var dj_b: [i64; 128] = [0; 128]
pub var rs_r: [i64; 160] = [0; 160]
pub var rs_s: [i64; 160] = [0; 160]
pub var ch1: [i64; 96] = [0; 96]
pub var ch2: [i64; 96] = [0; 96]
pub var ch3: [i64; 96] = [0; 96]
// role-hierarchy closure + pair list.
pub var rclos: [bool; 9216] = [false; 9216]
pub var rc_r: [i64; 9216] = [0; 9216]
pub var rc_s: [i64; 9216] = [0; 9216]
// topo / CSR scratch.
pub var indeg: [i64; 39000] = [0; 39000]
pub var order: [i64; 39000] = [0; 39000]
pub var queue: [i64; 39000] = [0; 39000]
pub var coff: [i64; 39001] = [0; 39001]
pub var clist: [i64; 60000] = [0; 60000]
pub var poff: [i64; 39001] = [0; 39001]
pub var plist: [i64; 60000] = [0; 60000]
pub var csr_cnt: [i64; 39000] = [0; 39000]
// conflict scratch: endpoint masks (2 words = 128 bits) per class.
pub var epm0: [i64; 39000] = [0; 39000]
pub var epm1: [i64; 39000] = [0; 39000]
pub var pm0: [i64; 39000] = [0; 39000]
pub var pm1: [i64; 39000] = [0; 39000]
pub var actors: [i64; 39000] = [0; 39000]
pub var ep_id: [i64; 39000] = [0; 39000]
// composition accumulator.
pub var acc: [i64; 598] = [0; 598]

// parser cursor over the read_file text.
pub var g_pos: i64 = 0
pub var g_len: i64 = 0

// ── bit helpers ──────────────────────────────────────────────────────────

// count trailing zeros of a single-bit value (1 << 63 is negative; the
// division ladder works on two's-complement values — probed).
fn ctz64(x: i64) -> i64 with Div {
    var n: i64 = 0
    var v = x
    if (v & 4294967295) == 0 { n = n + 32; v = v / 4294967296 }
    if (v & 65535) == 0 { n = n + 16; v = v / 65536 }
    if (v & 255) == 0 { n = n + 8; v = v / 256 }
    if (v & 15) == 0 { n = n + 4; v = v / 16 }
    if (v & 3) == 0 { n = n + 2; v = v / 4 }
    if (v & 1) == 0 { n = n + 1 }
    return n
}

// Kernighan popcount of a whole bitmask row.
fn row_popcount(base: i64) -> i64 with Mut, Div, Panic {
    var n: i64 = 0
    var w: i64 = 0
    while w < WC {
        var m = anc[base + w]
        while m != 0 {
            n = n + 1
            m = m & (m - 1)
        }
        w = w + 1
    }
    return n
}

// ── runtime text parsing (read_file result; str_char_at access only) ─────

fn skip_ws(text: string) with Mut, Div, Panic {
    while g_pos < g_len {
        let c = str_char_at(text, g_pos) as i64
        if c != 32 && c != 10 && c != 13 && c != 9 {
            return
        }
        g_pos = g_pos + 1
    }
}

fn read_int(text: string) -> i64 with Mut, Div, Panic {
    skip_ws(text)
    var v: i64 = 0
    while g_pos < g_len {
        let c = str_char_at(text, g_pos) as i64
        if c < 48 || c > 57 {
            return v
        }
        v = v * 10 + (c - 48)
        g_pos = g_pos + 1
    }
    return v
}

fn read_kind(text: string) -> i64 with Mut, Div, Panic {
    skip_ws(text)
    if g_pos >= g_len {
        return 0
    }
    let c = str_char_at(text, g_pos) as i64
    g_pos = g_pos + 1
    return c
}

// ── fixpoint pieces ──────────────────────────────────────────────────────

// OR the anc row of class f into the F row of (r, c); mark dirty +
// non-empty on change.
fn or_anc_into_f(r: i64, c: i64, f: i64, mark: i64) with Mut, Div, Panic {
    let dst = (r * HC + c) * WC
    let src = f * WC
    var w: i64 = 0
    while w < WC {
        let sv = anc[src + w]
        if sv != 0 {
            let dv = fm[dst + w]
            let nv = dv | sv
            if nv != dv {
                fm[dst + w] = nv
                f_nonempty[r * HC + c] = true
                if mark == 1 {
                    cur_dirty[r * HC + c] = true
                }
            }
        }
        w = w + 1
    }
}

// OR the F row of (r, p) into the F row of (r, c); mark dirty +
// non-empty on change.
fn or_f_into_f(r: i64, c: i64, p: i64, mark: i64) with Mut, Div, Panic {
    let dst = (r * HC + c) * WC
    let src = (r * HC + p) * WC
    var w: i64 = 0
    while w < WC {
        let sv = fm[src + w]
        if sv != 0 {
            let dv = fm[dst + w]
            let nv = dv | sv
            if nv != dv {
                fm[dst + w] = nv
                f_nonempty[r * HC + c] = true
                if mark == 1 {
                    cur_dirty[r * HC + c] = true
                }
            }
        }
        w = w + 1
    }
}

// Seed F from the stated restrictions, then ONE topological ancestor
// expansion (parents processed before children).  Marks every non-empty
// cell dirty for the role fixpoint.
fn seed_and_expand(nex: i64, h: i64, nr: i64) with Mut, Div, Panic {
    var k: i64 = 0
    while k < nex {
        or_anc_into_f(ex_r[k], ex_c[k], ex_f[k], 1)
        k = k + 1
    }
    var i: i64 = 0
    var c: i64 = 0
    var t: i64 = 0
    var p: i64 = 0
    var r: i64 = 0
    while i < h {
        c = order[i]
        t = poff[c]
        while t < poff[c + 1] {
            p = plist[t]
            r = 0
            while r < nr {
                or_f_into_f(r, c, p, 1)
                r = r + 1
            }
            t = t + 1
        }
        i = i + 1
    }
}

// Hybrid roleSub/roleComp fixpoint (round 12b — direction-2 leak fix):
// a dirty worklist on FIRST components is incomplete for roleComp (when
// F[r2][f] gains an edge, chain (r1,r2,r3) must re-fire for every c with
// f in F[r1][c], and those (r1, c) cells are not dirty).  roleSub uses a
// dirty worklist drained to quiescence (complete: single-input rule);
// roleComp uses a FULL SCAN over non-empty rows each round (naive
// fixpoint).  The hybrid round is Gauss-Seidel chaotic iteration and
// reaches the same least fixpoint as the naive round.  Returns the
// number of rounds.
fn role_fixpoint(with_rsub: i64, with_rcomp: i64, nrp: i64, nch: i64, h: i64, nr: i64) -> i64 with Mut, Div, Panic {
    var rounds: i64 = 0
    var any = true
    var rsub_any = true
    var r: i64 = 0
    var c: i64 = 0
    var k: i64 = 0
    var s: i64 = 0
    var r2: i64 = 0
    var r3: i64 = 0
    var w: i64 = 0
    var m: i64 = 0
    var low: i64 = 0
    var f: i64 = 0
    var dst: i64 = 0
    var src: i64 = 0
    var cell: i64 = 0
    var changed_cell = false
    var i: i64 = 0
    while any {
        any = false
        rounds = rounds + 1

        // ── roleSub worklist, drained to quiescence ──────────────────
        rsub_any = true
        while rsub_any {
            rsub_any = false
            r = 0
            while r < nr {
                c = 0
                while c < h {
                    cell = r * HC + c
                    if cur_dirty[cell] {
                        cur_dirty[cell] = false
                        if with_rsub == 1 {
                            k = 0
                            while k < nrp {
                                if rc_r[k] == r {
                                    s = rc_s[k]
                                    src = (r * HC + c) * WC
                                    dst = (s * HC + c) * WC
                                    changed_cell = false
                                    w = 0
                                    while w < WC {
                                        let sv = fm[src + w]
                                        if sv != 0 {
                                            let dv = fm[dst + w]
                                            let nv = dv | sv
                                            if nv != dv {
                                                fm[dst + w] = nv
                                                changed_cell = true
                                            }
                                        }
                                        w = w + 1
                                    }
                                    if changed_cell {
                                        f_nonempty[s * HC + c] = true
                                        nxt_dirty[s * HC + c] = true
                                        rsub_any = true
                                        any = true
                                    }
                                }
                                k = k + 1
                            }
                        }
                    }
                    c = c + 1
                }
                r = r + 1
            }
            // swap dirty sets (nxt -> cur, clear nxt)
            i = 0
            while i < 3744000 {
                cur_dirty[i] = nxt_dirty[i]
                nxt_dirty[i] = false
                i = i + 1
            }
        }

        // ── roleComp full scan over non-empty rows ───────────────────
        if with_rcomp == 1 {
            r = 0
            while r < nr {
                c = 0
                while c < h {
                    cell = r * HC + c
                    if f_nonempty[cell] {
                        k = 0
                        while k < nch {
                            if ch1[k] == r {
                                r2 = ch2[k]
                                r3 = ch3[k]
                                // acc = union of F[r2][f] over f in F[r][c]
                                w = 0
                                while w < WC {
                                    acc[w] = 0
                                    w = w + 1
                                }
                                src = (r * HC + c) * WC
                                w = 0
                                while w < WC {
                                    m = fm[src + w]
                                    while m != 0 {
                                        low = m & (0 - m)
                                        f = w * 64 + ctz64(low)
                                        m = m & (m - 1)
                                        let src2 = (r2 * HC + f) * WC
                                        var w2: i64 = 0
                                        while w2 < WC {
                                            let sv2 = fm[src2 + w2]
                                            if sv2 != 0 {
                                                acc[w2] = acc[w2] | sv2
                                            }
                                            w2 = w2 + 1
                                        }
                                    }
                                    w = w + 1
                                }
                                // merge acc into F[r3][c]
                                dst = (r3 * HC + c) * WC
                                changed_cell = false
                                w = 0
                                while w < WC {
                                    let av = acc[w]
                                    if av != 0 {
                                        let dv = fm[dst + w]
                                        let nv = dv | av
                                        if nv != dv {
                                            fm[dst + w] = nv
                                            changed_cell = true
                                        }
                                    }
                                    w = w + 1
                                }
                                if changed_cell {
                                    f_nonempty[r3 * HC + c] = true
                                    nxt_dirty[r3 * HC + c] = true
                                    any = true
                                }
                            }
                            k = k + 1
                        }
                    }
                    c = c + 1
                }
                r = r + 1
            }
        }

        // end-of-round swap: the NEXT round's roleSub drain must see the
        // composition products.  (Round 12c fix: without this swap the
        // drain's first sweep finds cur empty, swaps, and exits WITHOUT
        // processing the pending cells — if the outer loop then
        // terminates, the last composition round's roleSub cascade is
        // lost: 21 edges on this data.)
        i = 0
        while i < 3744000 {
            cur_dirty[i] = nxt_dirty[i]
            nxt_dirty[i] = false
            i = i + 1
        }
    }
    return rounds
}

// total role-edge fillers over atom rows (= existential targets).
fn count_role_edges(h: i64, nr: i64) -> i64 with Mut, Div, Panic {
    var n: i64 = 0
    var r: i64 = 0
    var c: i64 = 0
    var w: i64 = 0
    var m: i64 = 0
    while r < nr {
        c = 0
        while c < h {
            let src = (r * HC + c) * WC
            w = 0
            while w < WC {
                m = fm[src + w]
                while m != 0 {
                    n = n + 1
                    m = m & (m - 1)
                }
                w = w + 1
            }
            c = c + 1
        }
        r = r + 1
    }
    return n
}

// clear F and the dirty/non-empty sets (for ablation re-runs).
fn clear_f() with Mut, Div, Panic {
    var i: i64 = 0
    while i < 2238912000 {
        fm[i] = 0
        i = i + 1
    }
    i = 0
    while i < 3744000 {
        cur_dirty[i] = false
        nxt_dirty[i] = false
        f_nonempty[i] = false
        i = i + 1
    }
}

fn main() -> i32 with IO, Mut, Div, Panic {
    var n_fail = 0

    // fixup writes for the garbage leading cells of module-level splat
    // arrays (known compiler pitfall, rounds 6-11)
    anc[0] = 0
    anc[1] = 0
    anc[2] = 0
    fm[0] = 0
    fm[1] = 0
    fm[2] = 0
    cur_dirty[0] = false
    cur_dirty[1] = false
    cur_dirty[2] = false
    nxt_dirty[0] = false
    nxt_dirty[1] = false
    nxt_dirty[2] = false
    f_nonempty[0] = false
    f_nonempty[1] = false
    f_nonempty[2] = false
    rclos[0] = false
    rclos[1] = false
    rclos[2] = false
    epm0[0] = 0
    epm0[1] = 0
    epm0[2] = 0
    epm1[0] = 0
    epm1[1] = 0
    epm1[2] = 0
    pm0[0] = 0
    pm0[1] = 0
    pm0[2] = 0
    pm1[0] = 0
    pm1[1] = 0
    pm1[2] = 0
    ep_id[0] = 0
    ep_id[1] = 0
    ep_id[2] = 0

    // ── runtime data load (bypasses the ~24k-statement wall) ──────────
    let text = read_file("artifacts/ontology-frontiers/real-data/scale/go_full_packed.txt")
    g_len = str_len(text)
    g_pos = 0
    let H = read_int(text)
    let NR = read_int(text)
    let NSUB = read_int(text)
    let NEX = read_int(text)
    let NDJ = read_int(text)
    let NRS = read_int(text)
    let NCH = read_int(text)
    if H != go_full_expected_h() { println("FAIL: H disagrees with mirror"); n_fail = n_fail + 1 }
    if NR != go_full_expected_nr() { println("FAIL: NR disagrees with mirror"); n_fail = n_fail + 1 }
    if NSUB != go_full_expected_nsub() { println("FAIL: NSUB disagrees with mirror"); n_fail = n_fail + 1 }
    if NEX != go_full_expected_nex() { println("FAIL: NEX disagrees with mirror"); n_fail = n_fail + 1 }
    if NDJ != go_full_expected_ndj() { println("FAIL: NDJ disagrees with mirror"); n_fail = n_fail + 1 }
    if NRS != go_full_expected_nrs() { println("FAIL: NRS disagrees with mirror"); n_fail = n_fail + 1 }
    if NCH != go_full_expected_nch() { println("FAIL: NCH disagrees with mirror"); n_fail = n_fail + 1 }
    if H + 1 > HC || NR > NRC || NSUB > SUBC || NEX > EXC || NDJ > DJC || NRS > RSC || NCH > RCC {
        println("FAIL: data exceeds compile-time capacities")
        n_fail = n_fail + 1
    }
    var k: i64 = 0
    var kind: i64 = 0
    var isub: i64 = 0
    var iex: i64 = 0
    var idj: i64 = 0
    var irs: i64 = 0
    var ich: i64 = 0
    while g_pos < g_len {
        kind = read_kind(text)
        if kind == 115 {
            sub_c[isub] = read_int(text)
            sub_p[isub] = read_int(text)
            isub = isub + 1
        }
        if kind == 120 {
            ex_c[iex] = read_int(text)
            ex_r[iex] = read_int(text)
            ex_f[iex] = read_int(text)
            iex = iex + 1
        }
        if kind == 100 {
            dj_a[idj] = read_int(text)
            dj_b[idj] = read_int(text)
            idj = idj + 1
        }
        if kind == 104 {
            rs_r[irs] = read_int(text)
            rs_s[irs] = read_int(text)
            irs = irs + 1
        }
        if kind == 107 {
            ch1[ich] = read_int(text)
            ch2[ich] = read_int(text)
            ch3[ich] = read_int(text)
            ich = ich + 1
        }
    }
    if isub != NSUB || iex != NEX || idj != NDJ || irs != NRS || ich != NCH {
        println("FAIL: parsed axiom counts disagree with header")
        n_fail = n_fail + 1
    }
    let B = H + 1

    // ── role-hierarchy closure (reflexive + transitive) ───────────────
    var r: i64 = 0
    while r < NR {
        rclos[r * NRC + r] = true
        r = r + 1
    }
    k = 0
    while k < NRS {
        rclos[rs_r[k] * NRC + rs_s[k]] = true
        k = k + 1
    }
    var changed2 = true
    var a: i64 = 0
    var b: i64 = 0
    var d: i64 = 0
    while changed2 {
        changed2 = false
        a = 0
        while a < NR {
            b = 0
            while b < NR {
                if rclos[a * NRC + b] {
                    d = 0
                    while d < NR {
                        if rclos[b * NRC + d] && !rclos[a * NRC + d] {
                            rclos[a * NRC + d] = true
                            changed2 = true
                        }
                        d = d + 1
                    }
                }
                b = b + 1
            }
            a = a + 1
        }
    }
    // proper roleSub pairs (r != s) for the fixpoint
    var nrp: i64 = 0
    a = 0
    while a < NR {
        b = 0
        while b < NR {
            if a != b && rclos[a * NRC + b] {
                rc_r[nrp] = a
                rc_s[nrp] = b
                nrp = nrp + 1
            }
            b = b + 1
        }
        a = a + 1
    }

    // ── topological order (Kahn; GO is_a is a DAG) ────────────────────
    var c: i64 = 0
    while c < H {
        indeg[c] = 0
        coff[c] = 0
        poff[c] = 0
        c = c + 1
    }
    coff[H] = 0
    poff[H] = 0
    k = 0
    while k < NSUB {
        indeg[sub_c[k]] = indeg[sub_c[k]] + 1
        coff[sub_p[k] + 1] = coff[sub_p[k] + 1] + 1
        poff[sub_c[k] + 1] = poff[sub_c[k] + 1] + 1
        k = k + 1
    }
    c = 0
    while c < H {
        coff[c + 1] = coff[c + 1] + coff[c]
        poff[c + 1] = poff[c + 1] + poff[c]
        c = c + 1
    }
    c = 0
    while c < H {
        csr_cnt[c] = coff[c]
        c = c + 1
    }
    k = 0
    while k < NSUB {
        clist[csr_cnt[sub_p[k]]] = sub_c[k]
        csr_cnt[sub_p[k]] = csr_cnt[sub_p[k]] + 1
        k = k + 1
    }
    c = 0
    while c < H {
        csr_cnt[c] = poff[c]
        c = c + 1
    }
    k = 0
    while k < NSUB {
        plist[csr_cnt[sub_c[k]]] = sub_p[k]
        csr_cnt[sub_c[k]] = csr_cnt[sub_c[k]] + 1
        k = k + 1
    }
    var head: i64 = 0
    var tail: i64 = 0
    c = 0
    while c < H {
        if indeg[c] == 0 {
            queue[tail] = c
            tail = tail + 1
        }
        c = c + 1
    }
    var nord: i64 = 0
    var t: i64 = 0
    var ch: i64 = 0
    while head < tail {
        c = queue[head]
        head = head + 1
        order[nord] = c
        nord = nord + 1
        t = coff[c]
        while t < coff[c + 1] {
            ch = clist[t]
            indeg[ch] = indeg[ch] - 1
            if indeg[ch] == 0 {
                queue[tail] = ch
                tail = tail + 1
            }
            t = t + 1
        }
    }
    if nord != H {
        println("FAIL: sub relation has a cycle (Kahn incomplete)")
        n_fail = n_fail + 1
    }

    // ── atomic closure: ancestor masks in topological order ───────────
    let one: i64 = 1
    var i: i64 = 0
    var w: i64 = 0
    var p: i64 = 0
    var dst: i64 = 0
    var src: i64 = 0
    while i < H {
        c = order[i]
        dst = c * WC
        let cw = c / 64
        anc[dst + cw] = anc[dst + cw] | (one << (c - cw * 64))
        let tw = H / 64
        anc[dst + tw] = anc[dst + tw] | (one << (H - tw * 64))
        t = poff[c]
        while t < poff[c + 1] {
            p = plist[t]
            src = p * WC
            w = 0
            while w < WC {
                let sv = anc[src + w]
                if sv != 0 {
                    anc[dst + w] = anc[dst + w] | sv
                }
                w = w + 1
            }
            t = t + 1
        }
        i = i + 1
    }
    // atomic closure edges (exclude the top bit of every row)
    var atomic_edges: i64 = 0
    c = 0
    while c < H {
        atomic_edges = atomic_edges + row_popcount(c * WC) - 1
        c = c + 1
    }
    if atomic_edges != go_full_expected_atomic_edges() {
        println("FAIL: atomic closure edges disagree with mirror")
        n_fail = n_fail + 1
    }

    // ── role-aware closure: seed + expand + role fixpoint ─────────────
    seed_and_expand(NEX, H, NR)
    let rounds = role_fixpoint(1, 1, nrp, NCH, H, NR)
    println("role fixpoint rounds (full):")
    println(rounds)

    let r_atom = count_role_edges(H, NR)
    if r_atom != go_full_expected_role_edges_atom() {
        println("FAIL: atom-source role edges disagree with mirror")
        n_fail = n_fail + 1
    }
    // stoR/RtoS bijection on atom rows: existential targets == role edges
    if r_atom != go_full_expected_ex_targets() {
        println("FAIL: existential targets disagree with mirror")
        n_fail = n_fail + 1
    }

    // ── conflicts over atomic ancestors (profile theorem) ─────────────
    // endpoint index per class (1-based, 0 = not an endpoint)

    var nep: i64 = 0
    k = 0
    while k < NDJ {
        a = dj_a[k]
        b = dj_b[k]
        if ep_id[a] == 0 {
            nep = nep + 1
            ep_id[a] = nep
        }
        if ep_id[b] == 0 {
            nep = nep + 1
            ep_id[b] = nep
        }
        k = k + 1
    }
    if nep > EPC {
        println("FAIL: too many disjointness endpoints")
        n_fail = n_fail + 1
    }
    // epm: which endpoints are ancestors of c
    k = 0
    while k < NDJ {
        a = dj_a[k]
        b = dj_b[k]
        let aw = a / 64
        let abit = one << (a - aw * 64)
        let bw = b / 64
        let bbit = one << (b - bw * 64)
        let ka = ep_id[a] - 1
        let kb = ep_id[b] - 1
        c = 0
        while c < H {
            let cw = c * WC
            if (anc[cw + aw] & abit) != 0 {
                if ka < 64 {
                    epm0[c] = epm0[c] | (one << ka)
                } else {
                    epm1[c] = epm1[c] | (one << (ka - 64))
                }
            }
            if (anc[cw + bw] & bbit) != 0 {
                if kb < 64 {
                    epm0[c] = epm0[c] | (one << kb)
                } else {
                    epm1[c] = epm1[c] | (one << (kb - 64))
                }
            }
            c = c + 1
        }
        k = k + 1
    }
    // partner masks: pb[k] = endpoints disjoint with k
    // pm[c] = union of pb over endpoints of c
    k = 0
    while k < NDJ {
        let ka = ep_id[dj_a[k]] - 1
        let kb = ep_id[dj_b[k]] - 1
        // partner bit of b into pm of every class having endpoint a, and
        // vice versa
        c = 0
        while c < H {
            var has_a = false
            var has_b = false
            if ka < 64 {
                has_a = (epm0[c] & (one << ka)) != 0
            } else {
                has_a = (epm1[c] & (one << (ka - 64))) != 0
            }
            if kb < 64 {
                has_b = (epm0[c] & (one << kb)) != 0
            } else {
                has_b = (epm1[c] & (one << (kb - 64))) != 0
            }
            if has_a {
                if kb < 64 {
                    pm0[c] = pm0[c] | (one << kb)
                } else {
                    pm1[c] = pm1[c] | (one << (kb - 64))
                }
            }
            if has_b {
                if ka < 64 {
                    pm0[c] = pm0[c] | (one << ka)
                } else {
                    pm1[c] = pm1[c] | (one << (ka - 64))
                }
            }
            c = c + 1
        }
        k = k + 1
    }
    var nact: i64 = 0
    c = 0
    while c < H {
        if epm0[c] != 0 || epm1[c] != 0 || pm0[c] != 0 || pm1[c] != 0 {
            actors[nact] = c
            nact = nact + 1
        }
        c = c + 1
    }
    var conf: i64 = 0
    var i1: i64 = 0
    var i2: i64 = 0
    var c1: i64 = 0
    var c2: i64 = 0
    while i1 < nact {
        c1 = actors[i1]
        i2 = 0
        while i2 < nact {
            c2 = actors[i2]
            if c1 != c2 {
                if (pm0[c1] & epm0[c2]) != 0 || (pm1[c1] & epm1[c2]) != 0 {
                    conf = conf + 1
                }
            }
            i2 = i2 + 1
        }
        i1 = i1 + 1
    }
    if conf != go_full_expected_conf() {
        println("FAIL: conflicts disagree with mirror")
        n_fail = n_fail + 1
    }

    // ── ablations: attribute derived edges to the rule families ───────
    clear_f()
    seed_and_expand(NEX, H, NR)
    let rounds_norc = role_fixpoint(1, 0, nrp, NCH, H, NR)
    let re_norc = count_role_edges(H, NR)
    if re_norc != go_full_expected_role_edges_atom_no_rc() {
        println("FAIL: no-roleComp role edges disagree with mirror")
        n_fail = n_fail + 1
    }
    clear_f()
    seed_and_expand(NEX, H, NR)
    let rounds_nors = role_fixpoint(0, 1, nrp, NCH, H, NR)
    let re_nors = count_role_edges(H, NR)
    if re_nors != go_full_expected_role_edges_atom_no_rs() {
        println("FAIL: no-roleSub role edges disagree with mirror")
        n_fail = n_fail + 1
    }

    // ── summary ────────────────────────────────────────────────────────
    println("=== FULL GO go-plus: EL+ role-aware closure (round 12) ===")
    println("classes (H):")
    println(H)
    println("roles (NR):")
    println(NR)
    println("sub axioms:")
    println(NSUB)
    println("existential restrictions (exsub):")
    println(NEX)
    println("disjoint pairs:")
    println(NDJ)
    println("roleSub axioms:")
    println(NRS)
    println("roleComp chains:")
    println(NCH)
    println("atomic projection closure edges:")
    println(atomic_edges)
    println("atom-source role edges (= existential targets, stoR/RtoS):")
    println(r_atom)
    println("atomic conflicts (ordered pairs):")
    println(conf)
    println("role fixpoint rounds (full):")
    println(rounds)
    println("role edges without roleComp (ablation):")
    println(re_norc)
    println("role edges without roleSub (ablation):")
    println(re_nors)
    println("role fixpoint rounds (no-roleComp):")
    println(rounds_norc)
    println("role fixpoint rounds (no-roleSub):")
    println(rounds_nors)

    if n_fail == 0 {
        println("ALL PASS")
        return 0
    }
    println("FAILURES:")
    println(n_fail)
    return 1
}
