//@ run-pass
//@ expect-stdout: ALL PASS
// Real-data validation of the verified ontology pipeline
// (EL+ role-aware subsumption closure -> derived conflicts -> greedy
// epistemic repair) on the OAEI 2016 Anatomy track: adult mouse anatomy
// (MA, mouse.owl) vs NCI Thesaurus human anatomy (human.owl), with
// candidate mappings from a lexical label matcher (see lexical_match.py).
//
// Data lives in the generated sibling module tbox_data.sio
// (gen_sounio_data.py): parallel primitive arrays with splat init, exactly
// as in the miniature prototypes el-grounding/el_conflict_demo.sio and
// epistemic-alignment-repair/alignment_repair.sio — same algorithms, real
// ontologies.  Id pairs are packed as a*10000+b (all ids < 10000) to keep
// the generated module under the Madaros multimodule thin-link statement
// budget (see REAL_RESULTS.md).  tbox_data.sio also embeds the outputs of
// an independent python mirror of the pipeline as expected_*() functions;
// the checks below verify (a) the internal sanity conditions and (b)
// exact agreement with the mirror:
//
//   (1) closure is reflexive on the diagonal;
//   (2) derived conflict relation is symmetric and has the mirror's size;
//   (3) greedy repair is conflict-free, matches the mirror's kept/dropped
//       counts, and every dropped mapping has a maximality witness;
//   (4) the five dropped mappings with lowest confidence match the mirror.
//
// ROUND 10 — EL+ ROLE-AWARE CLOSURE (stdlib/ontology/elplus.sio, sparse
// variant).  The hand-rolled atomic fixpoint of rounds 6-7 is replaced by
// the verified EL+ engine: per-class BFS subsumption closure
// (elplus_sparse_bfs), stated-filler seeding of the 862 existential
// restrictions C <= ex part_of.F (elplus_sparse_seed_edges) and
// ancestor expansion to the least fixpoint (elplus_sparse_expand).  All
// closure queries downstream go through the role-aware engine
// (elplus_subsumes_sparse).
//
// BYTE-IDENTICAL OUTPUT (documented behavior, mirrored in
// gen_sounio_data.py): the Anatomy profile has NO conjunctions, a single
// active role (part_of), and NO roleSub/roleComp axioms, and every
// disjointness endpoint is an atom.  No EL+ rule adds atomic subsumption
// targets beyond the atomic closure (stoR/RtoS/Rmono only reach
// existential targets), so the role-aware derived conflicts are EXACTLY
// the round-7 atomic ones: 736 ordered pairs, kept 6392 / dropped 246,
// same top-5 — the summary numbers below are unchanged, with only the
// two role-layer lines appended.  The full-TBox instance of this
// argument is machine-checked by round 9 (scale/gen_elplus_data.py runs
// the general 8-rule fixpoint and aborts unless it agrees).  If a future
// extraction introduces role-derived conflicts (e.g. disjointness over
// existential concepts, conjunctions, or role hierarchy/composition),
// the counts will diverge from round 7 ON PURPOSE — and the mirror will
// have to be regenerated, which is the tripwire.
//
// NOTE: arrays of structs and `where` refinement clauses are unsupported,
// so everything uses parallel primitive arrays and runtime assertions.
// Confidences are exact integers per-10000 (0.3333 -> 3333): Madaros
// silently drops f64 array-element assignments inside non-main functions,
// and integer comparison keeps the repair epistemics exact.

import tbox_data::*
use ontology::elplus::{elplus_sparse_init_mats, elplus_sparse_build_adj, elplus_sparse_bfs, elplus_sparse_seed_edges, elplus_sparse_expand, elplus_sparse_row_count, elplus_subsumes_sparse}

fn main() -> i32 with IO, Mut, Div, Panic {
    var n_fail = 0

    init_data()

    let H = expected_h()        // human classes kept (cap 2000)
    let W = H + 1               // sparse matrix width (top slot at W-1)
    let N_SUB = expected_sub()  // subsumption axioms kept
    let N_EX = expected_exsub() // existential restrictions kept
    let M = expected_mappings() // candidate mappings

    // ── EL+ role-aware closure (sparse variant of stdlib elplus) ────────
    // packed parent adjacency (counting sort) + per-class BFS closure
    // (the workspace matrices live in stdlib elplus.sio: module-level
    // arrays must not cross a &! boundary on the current compiler lane)
    elplus_sparse_init_mats()
    var poff: [i64; 4097] = [0; 4097]
    var pcount: [i64; 4096] = [0; 4096]
    var plist: [i64; 4096] = [0; 4096]
    var vis: [i64; 4096] = [0; 4096]
    var queue: [i64; 4096] = [0; 4096]
    elplus_sparse_build_adj(&h_sub, N_SUB, &!poff, &!pcount, &!plist, H)
    let edges = elplus_sparse_bfs(&poff, &plist, &!vis, &!queue, H, W)
    if edges != expected_closure_edges() {
        println("FAIL: atom closure edge count disagrees with python mirror")
        n_fail = n_fail + 1
    }

    // role layer: seed e[c] with the ancestor rows of the stated fillers
    // of c, then expand in place over ancestors (stoR + RtoS + Rmono for
    // the Anatomy profile; see stdlib module docs)
    elplus_sparse_seed_edges(&ex_c, &ex_f, N_EX, W)
    elplus_sparse_expand(H, W)
    var nre: i64 = 0
    var c: i64 = 0
    while c < H {
        nre = nre + elplus_sparse_row_count(1, c, W)
        c = c + 1
    }
    if nre != expected_role_edges_atom() {
        println("FAIL: atom-source role edge count disagrees with python mirror")
        n_fail = n_fail + 1
    }

    // ── Check (1): closure reflexive on the diagonal ────────────────────
    c = 0
    while c < H {
        if !elplus_subsumes_sparse(c, c) {
            println("FAIL: closure not reflexive on diagonal")
            n_fail = n_fail + 1
        }
        c = c + 1
    }

    // ── Disjointness expanded through the EL+ closure ───────────────────
    // disj_c[c1][c2] iff c1, c2 reach a disjoint pair through the closure.
    // All disjointness endpoints are atomic, and roles add no atomic
    // subsumption targets (see header), so this is byte-identical to the
    // round-7 atomic expansion — closure queries now answered by the
    // role-aware engine.
    var d1: i64 = 0
    while d1 < H {
        var d2: i64 = 0
        while d2 < H {
            if h_disj[d1 * H + d2] {
                var c1: i64 = 0
                while c1 < H {
                    if elplus_subsumes_sparse(c1, d1) {
                        var c2: i64 = 0
                        while c2 < H {
                            if elplus_subsumes_sparse(c2, d2) {
                                disj_c[c1 * H + c2] = true
                                disj_c[c2 * H + c1] = true
                            }
                            c2 = c2 + 1
                        }
                    }
                    c1 = c1 + 1
                }
            }
            d2 = d2 + 1
        }
        d1 = d1 + 1
    }

    // ── Derived conflicts: same mouse entity, disjoint human targets ────
    var ei: i64 = 0
    var ci2: i64 = 0
    var ej: i64 = 0
    var cj2: i64 = 0
    var n_conf: i64 = 0
    var i: i64 = 0
    while i < M {
        ei = m_pack[i] / 10000
        ci2 = m_pack[i] - ei * 10000
        var j: i64 = 0
        while j < M {
            if i != j {
                ej = m_pack[j] / 10000
                if ei == ej {
                    cj2 = m_pack[j] - ej * 10000
                    if disj_c[ci2 * H + cj2] {
                        n_conf = n_conf + 1
                    }
                }
            }
            j = j + 1
        }
        i = i + 1
    }
    if n_conf != expected_derived_conflicts() {
        println("FAIL: derived conflict count disagrees with python mirror")
        n_fail = n_fail + 1
    }

    // ── Check (2): derived conflict relation is symmetric ───────────────
    var cij = false
    var cji = false
    i = 0
    while i < M {
        ei = m_pack[i] / 10000
        ci2 = m_pack[i] - ei * 10000
        var j: i64 = i + 1
        while j < M {
            ej = m_pack[j] / 10000
            cj2 = m_pack[j] - ej * 10000
            cij = ei == ej && disj_c[ci2 * H + cj2]
            cji = ei == ej && disj_c[cj2 * H + ci2]
            if (cij && !cji) || (!cij && cji) {
                println("FAIL: derived conflict relation not symmetric")
                n_fail = n_fail + 1
            }
            j = j + 1
        }
        i = i + 1
    }

    // ── Greedy epistemic repair (drop weaker of each live conflict) ─────
    i = 0
    while i < M {
        ei = m_pack[i] / 10000
        ci2 = m_pack[i] - ei * 10000
        var j: i64 = i + 1
        while j < M {
            if m_keep[i] && m_keep[j] {
                ej = m_pack[j] / 10000
                if ei == ej {
                    cj2 = m_pack[j] - ej * 10000
                    if disj_c[ci2 * H + cj2] {
                        if m_conf[i] >= m_conf[j] {
                            m_keep[j] = false
                        } else {
                            m_keep[i] = false
                        }
                    }
                }
            }
            j = j + 1
        }
        i = i + 1
    }

    var n_kept: i64 = 0
    i = 0
    while i < M {
        if m_keep[i] {
            n_kept = n_kept + 1
        }
        i = i + 1
    }
    let n_dropped = M - n_kept
    if n_kept != expected_kept() {
        println("FAIL: kept count disagrees with python mirror")
        n_fail = n_fail + 1
    }
    if n_dropped != expected_dropped() {
        println("FAIL: dropped count disagrees with python mirror")
        n_fail = n_fail + 1
    }

    // ── Check (3a): retained set is conflict-free ───────────────────────
    i = 0
    while i < M {
        ei = m_pack[i] / 10000
        ci2 = m_pack[i] - ei * 10000
        var j: i64 = i + 1
        while j < M {
            if m_keep[i] && m_keep[j] {
                ej = m_pack[j] / 10000
                if ei == ej {
                    cj2 = m_pack[j] - ej * 10000
                    if disj_c[ci2 * H + cj2] {
                        println("FAIL: retained set still has a conflict")
                        n_fail = n_fail + 1
                    }
                }
            }
            j = j + 1
        }
        i = i + 1
    }

    // ── Check (3b): every dropped mapping has a maximality witness ──────
    i = 0
    while i < M {
        if !m_keep[i] {
            ei = m_pack[i] / 10000
            ci2 = m_pack[i] - ei * 10000
            var witnessed = false
            var j: i64 = 0
            while j < M {
                if m_keep[j] {
                    ej = m_pack[j] / 10000
                    if ei == ej {
                        cj2 = m_pack[j] - ej * 10000
                        if disj_c[ci2 * H + cj2] {
                            if m_conf[j] >= m_conf[i] {
                                witnessed = true
                            }
                        }
                    }
                }
                j = j + 1
            }
            if !witnessed {
                println("FAIL: dropped mapping lacks witness")
                n_fail = n_fail + 1
            }
        }
        i = i + 1
    }

    // ── Check (4): top-5 dropped by confidence (lowest first) ───────────
    var chosen: [i64; 5] = [0 - 1; 5]
    var k: i64 = 0
    while k < 5 {
        var best_id: i64 = 0 - 1
        var best_conf: i64 = 20000
        i = 0
        while i < M {
            if !m_keep[i] {
                var already = false
                var t: i64 = 0
                while t < k {
                    if chosen[t] == i {
                        already = true
                    }
                    t = t + 1
                }
                if !already {
                    if m_conf[i] < best_conf || (m_conf[i] == best_conf && (best_id < 0 || i < best_id)) {
                        best_conf = m_conf[i]
                        best_id = i
                    }
                }
            }
            i = i + 1
        }
        chosen[k] = best_id
        if best_id != expected_drop5(k) {
            println("FAIL: top-5 dropped disagrees with python mirror")
            n_fail = n_fail + 1
        }
        k = k + 1
    }

    // ── Summary ─────────────────────────────────────────────────────────
    println("=== OAEI 2016 Anatomy: real-data pipeline validation ===")
    println("human classes (H):")
    println(H)
    println("sub axioms:")
    println(N_SUB)
    println("disjoint pairs:")
    println(expected_disj())
    println("candidate mappings (M):")
    println(M)
    println("derived conflicts (ordered pairs):")
    println(n_conf)
    println("kept:")
    println(n_kept)
    println("dropped:")
    println(n_dropped)
    println("top-5 dropped by confidence (lowest first; conf per-10000):")
    k = 0
    while k < 5 {
        println(chosen[k])
        println(m_conf[chosen[k]])
        k = k + 1
    }
    // role-layer lines appended in round 10 (all round-7 numbers above
    // are byte-identical; see the header for the reduction argument)
    println("existential restrictions (exsub):")
    println(N_EX)
    println("atom-source role edges:")
    println(nre)

    if n_fail == 0 {
        println("ALL PASS")
        return 0
    }
    println("FAILURES:")
    println(n_fail)
    return 1
}
