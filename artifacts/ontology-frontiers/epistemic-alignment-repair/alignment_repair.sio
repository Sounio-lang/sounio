//@ run-pass
//@ expect-stdout: ALL PASS
// Epistemic ontology alignment repair — miniature UMLS-style scenario.
//
// Frontier: epistemic-alignment-repair (see FRONTIER.md)
//
// Literature anchor: Jimenez-Ruiz, Cuenca Grau, Horrocks 2011
// (doi:10.1186/2041-1480-2-s1-s2) — UMLS integration errors repaired by
// removing low-confidence mappings (e.g. confidence 0.06, 0.30). Here the
// confidence stops being a heuristic removal cost and becomes an explicit
// epistemic quantity whose repair invariants are checked at runtime and
// proved formally in formal/OntologyAlignmentRepair.lean.
//
// ROUND 10 — the conflict oracle is no longer hardcoded NOR merely
// atomic: it is DERIVED from a role-aware EL+ TBox by the verified dense
// engine of stdlib/ontology/elplus.sio (elplus_fixpoint, the executable
// mirror of crStep / closeSatF of formal/OntologyELPlusClosureComplete.lean;
// conflictBPlusC_iff: the boolean conflict oracle IS the deductive
// conflict relation).  The mini TBox extends the shared instance of the
// research line with a role layer:
//
//   Concepts (ckind: 0 atom, 1 top, 3 existential):
//     0 lymphokine   1 protein   2 molecule   3 heart
//     4 organ        5 muscleonly 6 drugclass 7 gland
//     8 top          9 ex part_of.organ ("organ-part")
//   Roles: 0 part_of (no hierarchy, no composition)
//   Subsumptions:  lymphokine <= protein <= molecule, heart <= organ
//   Existential:   heart <= ex part_of.organ   (role layer)
//   Disjointness:  organ ⊥ muscleonly, protein ⊥ drugclass,
//                  ex part_of.organ ⊥ drugclass  (non-atomic endpoint:
//                  only expressible in the EL+ universe)
//
// The role layer is load-bearing for the CONCEPT-level oracle:
// conflict(heart, drugclass) holds only because heart subsumes the
// interned existential organ-part (stated role-layer axiom) and organ-part ⊥
// drugclass — the atomic closure cannot see it.  On the shared
// 5-mapping instance the MAPPING-level derived oracle coincides exactly
// with the original hardcoded one ({m0-m1, m2-m3}): no asserted class
// reaches the existential, so the repair scenario and its expected
// survivors are unchanged.
//
// Scenario: candidate mappings between two biomedical ontologies, with
// explicit logical conflicts. Repair retains, per conflict, the mapping
// with higher confidence, then verifies:
//   (1) the retained set is conflict-free (consistency);
//   (2) every dropped mapping conflicts with a retained mapping of at
//       least equal confidence (maximality witness);
//   (3) a derived subsumption gets weakest-link confidence;
//   (4) Dempster-Shafer fusion of independent matchers never drops below
//       the best single source.
//
// NOTE 1: the aspirational `where result.confidence >= ...` refinement
// syntax used in some examples is not yet accepted by the current Madaros
// parser, so the contracts below are enforced as runtime assertions.
// NOTE 2: arrays of structs segfault in the current runtime, so the
// TBox and the alignment are modelled with parallel primitive arrays
// (mapping k has id k+1, confidence conf[k], retention keep[k]).

use ontology::elplus::{elplus_role_closure, elplus_seed, elplus_fixpoint, elplus_conflict, elplus_derive_conflicts}

fn fmin(a: f64, b: f64) -> f64 {
    if a <= b { return a }
    return b
}

fn fmax(a: f64, b: f64) -> f64 {
    if a >= b { return a }
    return b
}

fn fabs(a: f64) -> f64 {
    if a < 0.0 { return 0.0 - a }
    return a
}

// Dempster-Shafer combination of two independent matcher confidences.
fn ds_combine(a: f64, b: f64) -> f64 {
    return 1.0 - (1.0 - a) * (1.0 - b)
}

fn main() -> i32 with IO, Mut, Div, Panic {
    var n_fail = 0

    // ── EL+ TBox: interned concept table (see header) ───────────────────
    var ckind: [i64; 64] = [0; 64]
    var carg1: [i64; 64] = [0; 64]
    var carg2: [i64; 64] = [0; 64]
    var ci: i64 = 0
    while ci < 8 {
        ckind[ci] = 0
        carg1[ci] = ci
        ci = ci + 1
    }
    ckind[8] = 1          // top
    ckind[9] = 3          // ex part_of.organ
    carg1[9] = 0          // role 0 = part_of
    carg2[9] = 4          // filler = organ(4)

    // exid[r*64+f] = interned id of ex r.(base f), or -1
    var exid: [i64; 512] = [0; 512]
    ci = 0
    while ci < 512 {
        exid[ci] = 0 - 1
        ci = ci + 1
    }
    exid[0 * 64 + 4] = 9

    // role-hierarchy closure (single role: reflexive only)
    var rclos: [bool; 64] = [false; 64]
    elplus_role_closure(&!rclos, 1)

    // seed S: reflexivity + top + stated subsumptions + stated existential
    var s: [bool; 4096] = [false; 4096]
    elplus_seed(&!s, 10, 8)
    s[0 * 64 + 1] = true   // lymphokine <= protein
    s[1 * 64 + 2] = true   // protein <= molecule
    s[3 * 64 + 4] = true   // heart <= organ
    s[3 * 64 + 9] = true   // heart <= ex part_of.organ (role layer)

    // disjointness (symmetric); (9,6) has a non-atomic endpoint
    var disj: [bool; 4096] = [false; 4096]
    disj[4 * 64 + 5] = true
    disj[5 * 64 + 4] = true
    disj[1 * 64 + 6] = true
    disj[6 * 64 + 1] = true
    disj[9 * 64 + 6] = true
    disj[6 * 64 + 9] = true

    // no composition chains on this instance
    var ch1: [i64; 8] = [0; 8]
    var ch2: [i64; 8] = [0; 8]
    var ch3: [i64; 8] = [0; 8]

    // dense 8-rule EL+ fixpoint (crStep mirror, iterated to stability)
    var redges: [bool; 32768] = [false; 32768]
    let rounds = elplus_fixpoint(&!s, &!redges, &ckind, &carg1, &carg2, &exid, &rclos, &ch1, &ch2, &ch3, 0, 10, 9, 1)

    // ── Closure sanity checks (incl. the role layer) ────────────────────
    if !s[0 * 64 + 2] {
        println("FAIL: closure missing lymphokine <=* molecule")
        n_fail = n_fail + 1
    }
    if s[3 * 64 + 6] {
        println("FAIL: closure wrongly has heart <=* drugclass")
        n_fail = n_fail + 1
    }
    if !s[3 * 64 + 9] {
        println("FAIL: role layer missing heart <= ex part_of.organ (RtoS)")
        n_fail = n_fail + 1
    }
    // role-derived CONCEPT conflict: heart vs drugclass holds only
    // through the interned existential (invisible to the atomic closure)
    if !elplus_conflict(&s, &disj, 10, 3, 6) {
        println("FAIL: role-derived conflict(heart, drugclass) missing")
        n_fail = n_fail + 1
    }
    // negative control: molecule vs drugclass must NOT conflict
    if elplus_conflict(&s, &disj, 10, 2, 6) {
        println("FAIL: spurious conflict(molecule, drugclass)")
        n_fail = n_fail + 1
    }

    // ── Alignment scenario (the shared 5 mappings of the research line) ─
    // Entities: 0 = lymphokine, 1 = heart, 2 = protein (as asserted entity)
    //   m0: lymphokine under protein(1),    0.30
    //   m1: lymphokine under drugclass(6),  0.06
    //   m2: heart      under organ(4),      0.95
    //   m3: heart      under muscleonly(5), 0.40
    //   m4: protein    under molecule(2),   0.80
    var ent: [i64; 256] = [0; 256]
    ent[0] = 0
    ent[1] = 0
    ent[2] = 1
    ent[3] = 1
    ent[4] = 2

    var cls: [i64; 256] = [0; 256]
    cls[0] = 1
    cls[1] = 6
    cls[2] = 4
    cls[3] = 5
    cls[4] = 2

    var conf: [f64; 5] = [0.0; 5]
    conf[0] = 0.30
    conf[1] = 0.06
    conf[2] = 0.95
    conf[3] = 0.40
    conf[4] = 0.80

    // ── DERIVED conflict oracle (role-aware, replaces the hardcoded one) ─
    var conf_pair: [bool; 65536] = [false; 65536]
    elplus_derive_conflicts(&!conf_pair, 5, &ent, &cls, &s, &disj, 10)

    // Expected derived conflicts: exactly {0-1} and {2-3} (symmetric) —
    // identical to the original hardcoded oracle on the shared instance.
    if !conf_pair[0 * 256 + 1] { println("FAIL: derived oracle misses 0-1"); n_fail = n_fail + 1 }
    if !conf_pair[1 * 256 + 0] { println("FAIL: derived oracle misses 1-0"); n_fail = n_fail + 1 }
    if !conf_pair[2 * 256 + 3] { println("FAIL: derived oracle misses 2-3"); n_fail = n_fail + 1 }
    if !conf_pair[3 * 256 + 2] { println("FAIL: derived oracle misses 3-2"); n_fail = n_fail + 1 }
    var n_conf: i64 = 0
    var i: i64 = 0
    while i < 5 {
        var j: i64 = 0
        while j < 5 {
            if conf_pair[i * 256 + j] {
                n_conf = n_conf + 1
            }
            j = j + 1
        }
        i = i + 1
    }
    if n_conf != 4 {
        println("FAIL: derived oracle has spurious conflicts")
        n_fail = n_fail + 1
    }

    // ── Greedy epistemic repair ─────────────────────────────────────────
    // For each conflict with both endpoints retained, drop the weaker one.
    var keep: [bool; 5] = [true; 5]
    i = 0
    while i < 5 {
        var j: i64 = i + 1
        while j < 5 {
            if keep[i] && keep[j] {
                if conf_pair[i * 256 + j] {
                    if conf[i] >= conf[j] {
                        keep[j] = false
                    } else {
                        keep[i] = false
                    }
                }
            }
            j = j + 1
        }
        i = i + 1
    }

    // ── Check (1): retained set is conflict-free ────────────────────────
    i = 0
    while i < 5 {
        var j: i64 = i + 1
        while j < 5 {
            if keep[i] && keep[j] {
                if conf_pair[i * 256 + j] {
                    println("FAIL: retained set still has a conflict")
                    n_fail = n_fail + 1
                }
            }
            j = j + 1
        }
        i = i + 1
    }

    // ── Check (2): every dropped mapping has a maximality witness ───────
    i = 0
    while i < 5 {
        if !keep[i] {
            var witnessed = false
            var j: i64 = 0
            while j < 5 {
                if keep[j] {
                    if conf_pair[i * 256 + j] {
                        if conf[j] >= conf[i] {
                            witnessed = true
                        }
                    }
                }
                j = j + 1
            }
            if !witnessed {
                println("FAIL: dropped mapping lacks witness")
                n_fail = n_fail + 1
            }
        }
        i = i + 1
    }

    // Expected survivors: m0 (0.30 > 0.06), m2 (0.95 > 0.40), m4 (no conflict)
    if !keep[0] { println("FAIL: m0 should survive"); n_fail = n_fail + 1 }
    if keep[1]  { println("FAIL: m1 should be dropped"); n_fail = n_fail + 1 }
    if !keep[2] { println("FAIL: m2 should survive"); n_fail = n_fail + 1 }
    if keep[3]  { println("FAIL: m3 should be dropped"); n_fail = n_fail + 1 }
    if !keep[4] { println("FAIL: m4 should survive"); n_fail = n_fail + 1 }

    // ── Check (3): weakest-link derived subsumption ─────────────────────
    // lymphokine -m0-> protein (0.30), protein -m4-> molecule (0.80)
    // derived: lymphokine -> molecule with weakest-link confidence 0.30
    let derived = fmin(conf[0], conf[4])
    if fabs(derived - 0.30) > 0.0001 {
        println("FAIL: weakest-link confidence wrong")
        n_fail = n_fail + 1
    }

    // ── Check (4): DS fusion never below best single source ─────────────
    let lex = 0.60
    let stru = 0.70
    let fused = ds_combine(lex, stru)
    if fabs(fused - 0.88) > 0.0001 {
        println("FAIL: DS value wrong")
        n_fail = n_fail + 1
    }
    if fused < fmax(lex, stru) {
        println("FAIL: DS dropped below best source")
        n_fail = n_fail + 1
    }

    if n_fail == 0 {
        println("ALL PASS")
        return 0
    }
    println("FAILURES:")
    println(n_fail)
    return 1
}
