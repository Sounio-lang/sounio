var A: [i8; 262144] = [0; 262144]
var B: [i8; 262144] = [0; 262144]
var X1: i64 = 0
var X2: i64 = 0
var X3: i64 = 0
var X4: i64 = 0
var X5: i64 = 0

fn log_stderr_nl(msg: string) with IO, Mut, Panic {
    let n = str_len(msg)
    syscall6(1, 2, msg, n, 0, 0, 0)
    syscall6(1, 2, "\n", 1, 0, 0, 0)
}

fn read_headers() -> i64 with IO, Mut, Panic {
    var done: i64 = 0
    while done == 0 {
        log_stderr_nl("about")
        let line = read_line()
        log_stderr_nl("after")
        done = 1
    }
    return 0
}

fn main() -> i32 with IO, Mut, Panic {
    log_stderr_nl("start")
    let cl = read_headers()
    log_stderr_nl("end")
    0
}
