use dialogue::bracket::{grouping_magnitude_sq}
use io::scientific::{sci_print_f64}

fn payload_to_oct(p: &[f64; 16], out: &![f64; 8]) with Mut {
    var k: i64 = 0
    while k < 8 { out[k] = p[k] - p[(k + 8) as usize]; k = k + 1 }
}

fn main() with Mut, Div, Panic, NonAssoc, IO {
    var p0: [f64; 16] = [1.21813511e-02, -1.07246337e-02, 8.72645343e-02, 1.11325450e-01, -1.51930100e-02, -2.22345520e-02, 2.85951691e-02, 7.14614376e-02, 5.89263737e-02, -4.27222227e-03, -5.11689075e-03, 1.62150971e-02, 4.50643316e-02, -5.10109320e-03, -2.63201128e-02, -3.51315905e-02]
    var o0: [f64; 8] = [0.0; 8]
    payload_to_oct(&p0, &!o0)
    var p1: [f64; 16] = [-5.42135503e-02, -1.40871165e-01, 1.14999725e-02, 3.56436339e-02, -4.64330152e-02, -1.49361427e-02, -2.12020731e-02, 4.20616880e-02, -2.04781711e-02, 5.07145911e-02, 5.60602749e-02, -1.43280997e-02, 6.80540575e-02, 5.35874144e-04, -1.71167742e-02, -9.31104759e-03]
    var o1: [f64; 8] = [0.0; 8]
    payload_to_oct(&p1, &!o1)
    var p2: [f64; 16] = [-9.10434653e-03, -2.81196711e-02, 6.02929952e-02, -9.43855637e-03, 2.37966145e-02, -2.68763677e-02, 5.73542737e-02, -1.46763406e-02, 4.66579398e-02, -3.73192903e-02, 2.64095905e-02, 1.46647386e-02, 8.42131954e-02, 6.65842656e-02, -1.06177479e-01, -1.39465656e-01]
    var o2: [f64; 8] = [0.0; 8]
    payload_to_oct(&p2, &!o2)
    let m: f64 = grouping_magnitude_sq(&o0, &o1, &o2)
    sci_print_f64(m, 8)
}
