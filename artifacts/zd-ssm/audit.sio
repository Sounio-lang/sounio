    println("-- begin-zdssm-audit v1")
    print("op:        revive"); println("")
    print("chunk:     "); print_int(chunk as i64); println("")
    print("class:     "); print_int(class as i64); println("")
    print("lean-term: Sounio.SurgicalInterventions.revive_inverse_property"); println("")
    println("-- end-zdssm-audit")
}

fn audit_interp_header(chunk: i32, class: i32) with IO, Mut, Panic, Div {
    println("-- begin-zdssm-audit v1")
    print("op:        interp"); println("")
    print("chunk:     "); print_int(chunk as i64); println("")
    print("class:     "); print_int(class as i64); println("")
    print("lean-term: Sounio.InterpBasis.basis_168_completeness"); println("")
    println("-- end-zdssm-audit")
}

// Demo: emit one audit witness for each of the six surgical ops on
// chunk 0, class 42.  The output is the exact text that a downstream
// verifier consumes.
fn main() with IO, Mut, Panic, Div {
    println("=== ZD-SSM audit emitter ===")
    println("")
    audit_unlearn_header(0, 42)
    println("")
    audit_edit_header(0, 42)
    println("")
    audit_gate_header(0, 42)
    println("")
    audit_compose_header(0, 42)
    println("")
    audit_revive_header(0, 42)
    println("")
    audit_interp_header(0, 42)
    println("")
    println("ZD-SSM AUDIT PASS")
}
