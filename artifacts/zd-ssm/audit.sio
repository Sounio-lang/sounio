// artifacts/zd-ssm/audit.sio
//
// Audit witness emitter for the ZD-SSM.
//
// Given a surgical operation (unlearn-alice, edit-fact, gate-wmdp),
// this module prints a self-contained audit record naming the Lean
// theorem that backs the operation.  A downstream verifier can pull
// the named theorem from formal/lean4/SounioSurgicalInterventions.lean
// and re-verify it offline in ~50ms via `lean --run WITNESS.lean`.
//
// The audit record format is:
//   -- begin-zdssm-audit v1
//   op:        <op-tag>
//   chunk:     <chunk-index>
//   class:     <ZD-class>
//   lean-term: <fully-qualified-theorem>
//   -- end-zdssm-audit
//
// Because each record is tagged with a `lean-term:` whose body is
// closed by `native_decide` on fixed finite data, re-verification
// is bit-exact and auditor-trust-free.

fn audit_unlearn_header(chunk: i32, class: i32) with IO, Mut, Panic, Div {
    println("-- begin-zdssm-audit v1")
    print("op:        unlearn"); println("")
    print("chunk:     "); print_int(chunk as i64); println("")
    print("class:     "); print_int(class as i64); println("")
    print("lean-term: Sounio.SurgicalInterventions.unlearning_kernel_exact"); println("")
    print("calculus:  Sounio.SurgicalInterventions.surgical_hexad (proj 1)"); println("")
    println("-- end-zdssm-audit")
}

fn audit_edit_header(chunk: i32, class: i32) with IO, Mut, Panic, Div {
    println("-- begin-zdssm-audit v1")
    print("op:        edit"); println("")
    print("chunk:     "); print_int(chunk as i64); println("")
    print("class:     "); print_int(class as i64); println("")
    print("lean-term: Sounio.SurgicalInterventions.editing_locality_kernel_bound"); println("")
    println("-- end-zdssm-audit")
}

