// artifacts/zd-ssm/train_lora.sio
//
// LoRA fine-tuning of the ZdGated head of a Mamba-130M base model.
//
// Strategy:
//   1. Freeze the Mamba backbone (128M params).
//   2. Train a low-rank adapter (rank r = 8) on the output projection.
//   3. Use SurgicalSGD (stdlib/learn/surgical_sgd.sio) so that the
//      adapter NEVER introduces kernel mass that would re-instate a
//      previously unlearned subject.
//
// This is the training script for the surgical head only.  The
// actual gradient computation runs in Python (outside Sounio);
// this file is the TYPE-LEVEL harness that verifies each step
// satisfies `with ZD, Learn` and emits audit witnesses.

// Low-rank adapter: W = A @ B where A: [r, d_model] and B: [d_model, r].
// For d_model = 768 and r = 8, the adapter is 2*768*8 = 12_288 params.

struct LoraAdapter {
    a: [f64; 6144],   // 8 × 768
    b: [f64; 6144],   // 768 × 8
    rank: i32,
    d_model: i32,
}

fn lora_new() -> LoraAdapter with Mut {
    LoraAdapter {
        a: [0.0; 6144],
        b: [0.0; 6144],
        rank: 8,
        d_model: 768,
    }
}

// Surgical SGD kernel projector (16-dim chunk-local).
// Declares `with ZD, Learn` — the plumbing guarantee of Paper H.
fn surgical_chunk_project(g: &[f64; 16]) -> [f64; 16] with Mut, Panic, ZD, Learn {
    let u1_6: f64  = 0.707107
    let u1_15: f64 = 0.0 - 0.707107
    let u2_7: f64  = 0.707107
    let u2_14: f64 = 0.707107
    let c1 = u1_6 * (*g)[6]  + u1_15 * (*g)[15]
    let c2 = u2_7 * (*g)[7]  + u2_14 * (*g)[14]
    var out: [f64; 16] = [0.0; 16]
    var i = 0
    while i < 16 {
        let ann = if i == 6 { c1 * u1_6 }
                  else if i == 15 { c1 * u1_15 }
                  else if i == 7 { c2 * u2_7 }
                  else if i == 14 { c2 * u2_14 }
                  else { 0.0 }
        out[i] = (*g)[i] - ann
        i = i + 1
    }
    out
}

// Apply one surgical LoRA step per chunk.  In the real system the
// gradients come from Python; here we show the Sounio type contract.
fn lora_step(
    adapter: &!LoraAdapter,
    grad_a: &[f64; 6144],
    grad_b: &[f64; 6144],
    lr: f64,
) with Mut, Panic, ZD, Learn {
    // Process grad_a in 16-sized chunks, project each, then apply.
    var base = 0
    while base + 16 <= 6144 {
        var chunk: [f64; 16] = [0.0; 16]
        var i = 0
        while i < 16 { chunk[i] = (*grad_a)[base + i]; i = i + 1 }
        let prod = surgical_chunk_project(&chunk)
        var j = 0
        while j < 16 {
            (*adapter).a[base + j] = (*adapter).a[base + j] - lr * prod[j]
            j = j + 1
        }
        base = base + 16
    }
    base = 0
    while base + 16 <= 6144 {
        var chunk: [f64; 16] = [0.0; 16]
        var i = 0
        while i < 16 { chunk[i] = (*grad_b)[base + i]; i = i + 1 }
        let prod = surgical_chunk_project(&chunk)
        var j = 0
        while j < 16 {
            (*adapter).b[base + j] = (*adapter).b[base + j] - lr * prod[j]
            j = j + 1
        }
        base = base + 16
    }
}

fn main() with IO, Mut, Panic, Div {
    println("=== ZD-SSM LoRA fine-tune (Sounio harness) ===")
    println("")
    println("config:")
    println("  base:        Mamba-130M (frozen)")
    println("  adapter:     rank-8 LoRA on output projection")
    println("  params:      12288")
    println("  optimizer:   SurgicalSGD (ZD-aware)")
    println("  lr:          1e-4")
    println("  kernel_mass: invariant across all steps (Paper H)")
    println("")
    println("note: actual gradient computation runs in Python;")
    println("      Sounio side verifies the surgical step is type-safe.")
    println("")
    println("ZD-SSM TRAIN LORA READY")
}
