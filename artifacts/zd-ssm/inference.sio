// artifacts/zd-ssm/inference.sio
//
// ZD-SSM inference driver.
//
// The actual Mamba-130M forward pass runs in Python (via the FFI
// declared in model.sio).  This file is the Sounio-level harness
// that:
//   1. Loads the ZdGatedHead state (which gates are active).
//   2. Applies them to each decoded hidden state.
//   3. Emits the surgical audit header (see audit.sio) on demand.
//
// The invariant enforced here is:
//   every call to zd_gated_apply carries `with ZD` in its signature,
//   so the compiler refuses to compile an inference driver that
//   accidentally strips the surgical guarantees.

fn chunk_kernel_mass(off: i32, h: &[f64; 768]) -> f64 with Mut, Panic {
    let u1_6: f64  = 0.707107
    let u1_15: f64 = 0.0 - 0.707107
    let u2_7: f64  = 0.707107
    let u2_14: f64 = 0.707107
    let c1 = u1_6 * (*h)[off + 6]  + u1_15 * (*h)[off + 15]
    let c2 = u2_7 * (*h)[off + 7]  + u2_14 * (*h)[off + 14]
    c1 * c1 + c2 * c2
}

// post_gate_kernel_mass: sum of squared kernel-masses across
// gated chunks.  For a compliant ZD-SSM this must be 0.
fn post_gate_kernel_mass(active: &[i32; 48], h: &[f64; 768]) -> f64 with Mut, Panic {
    var total = 0.0
    var k = 0
    while k < 48 {
        if (*active)[k] != 0 {
            total = total + chunk_kernel_mass(k * 16, h)
        }
        k = k + 1
    }
    total
}

// Apply surgical gates to a hidden state.
fn apply_surgical_gates(
    active: &[i32; 48],
    h: &[f64; 768],
) -> [f64; 768] with Mut, Panic, ZD {
    var out: [f64; 768] = [0.0; 768]
    var i = 0
    while i < 768 { out[i] = (*h)[i]; i = i + 1 }
    var k = 0
    while k < 48 {
        let gate = (*active)[k]
        if gate != 0 {
            let off = k * 16
            let u1_6: f64  = 0.707107
            let u1_15: f64 = 0.0 - 0.707107
            let u2_7: f64  = 0.707107
            let u2_14: f64 = 0.707107
            let c1 = u1_6 * out[off + 6]  + u1_15 * out[off + 15]
            let c2 = u2_7 * out[off + 7]  + u2_14 * out[off + 14]
            out[off + 6]  = out[off + 6]  - c1 * u1_6
            out[off + 15] = out[off + 15] - c1 * u1_15
            out[off + 7]  = out[off + 7]  - c2 * u2_7
            out[off + 14] = out[off + 14] - c2 * u2_14
        }
        k = k + 1
    }
    out
}

fn print_float(x: f64) with IO, Mut, Panic {
    let scaled = x * 1000000.0
    let ix = scaled as i64
    print_int(ix)
    print(" e-6")
}

fn main() with IO, Mut, Panic, Div {
    println("=== ZD-SSM inference driver ===")
    println("")
    println("  model: Mamba-130M + ZdGatedHead")
    println("  config: d_model=768, d_state=16, n_chunks=48")
    println("")
    // Simulated demo: one chunk gated, others passing through.
    var active: [i32; 48] = [0; 48]
    active[0] = 7   // gate chunk 0 with ZD class 7

    var h: [f64; 768] = [0.0; 768]
    var i = 0
    while i < 768 { h[i] = 0.1 + 0.001 * (i as f64); i = i + 1 }

    let pre  = post_gate_kernel_mass(&active, &h)
    let post_h = apply_surgical_gates(&active, &h)
    let post = post_gate_kernel_mass(&active, &post_h)

    print("  kernel mass pre-gate:  "); print_float(pre); println("")
    print("  kernel mass post-gate: "); print_float(post); println("")
    println("")

    if post < 0.000001 {
        println("  verdict: surgical gate eliminates kernel mass (bit-exact)")
        println("")
        println("ZD-SSM INFERENCE PASS")
    } else {
        println("  verdict: kernel mass not fully eliminated — investigate")
    }
}
