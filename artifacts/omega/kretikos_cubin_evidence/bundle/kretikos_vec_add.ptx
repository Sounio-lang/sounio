.version 7.0
.target sm_50
.address_size 64

.visible .entry vec_add(
    .param .u64 param_a,
    .param .u64 param_b,
    .param .u64 param_c
)
{
    .reg .pred %p<2>;
    .reg .b32 %r<3>;
    .reg .b64 %rd<9>;
    .reg .f32 %f<4>;

    mov.u32 %r1, %tid.x;
    cvt.u64.u32 %rd1, %r1;
    mul.lo.u64 %rd2, %rd1, 4;
    ld.param.u64 %rd3, [param_a];
    ld.param.u64 %rd4, [param_b];
    ld.param.u64 %rd5, [param_c];
    add.u64 %rd6, %rd3, %rd2;
    add.u64 %rd7, %rd4, %rd2;
    add.u64 %rd8, %rd5, %rd2;
    ld.global.f32 %f1, [%rd6];
    ld.global.f32 %f2, [%rd7];
    add.f32 %f3, %f1, %f2;
    st.global.f32 [%rd8], %f3;
    ret;
}
