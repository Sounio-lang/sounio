@@ -0,0 +1,58 @@
+// Omega Sprint 4.0 Genesis - Merkle rooted provenance lane.
+//
+// Deterministic root computation over policy/baseline/telemetry/bitstream
+// hash lanes for reproducible artifact lineage.
+
+use hardware::kaxi::*
+
+let MERKLE_ROOT_SALT_A: i64 = 0x4F4D4547
+let MERKLE_ROOT_SALT_B: i64 = 0x4147454E
+let MERKLE_ROOT_SALT_C: i64 = 0x45534953
+let MERKLE_ROOT_SALT_D: i64 = 0x76312E30
+
+fn merkle_root_mix(a: i64, b: i64, c: i64, salt: i64) -> i64 {
+    ((a ^ b) + c + salt) ^ (a << 5) ^ (b >> 7)
+}
+
+fn merkle_root_lane_l64(
+    policy_hash_l64: i64,
+    baseline_hash_l64: i64,
+    telemetry_hash_l64: i64,
+    bitstream_hash_l64: i64,
+    signed_manifest_hash_l64: i64
+) -> i64 {
+    let h0 = merkle_root_mix(policy_hash_l64, baseline_hash_l64, telemetry_hash_l64, MERKLE_ROOT_SALT_A)
+    let h1 = merkle_root_mix(bitstream_hash_l64, signed_manifest_hash_l64, h0, MERKLE_ROOT_SALT_B)
+    let h2 = merkle_root_mix(h0, h1, policy_hash_l64 ^ bitstream_hash_l64, MERKLE_ROOT_SALT_C)
+    merkle_root_mix(h1, h2, baseline_hash_l64 ^ telemetry_hash_l64, MERKLE_ROOT_SALT_D)
+}
+
+fn merkle_root_verify_l64(
+    expected_root_l64: i64,
+    policy_hash_l64: i64,
+    baseline_hash_l64: i64,
+    telemetry_hash_l64: i64,
+    bitstream_hash_l64: i64,
+    signed_manifest_hash_l64: i64
+) -> bool {
+    expected_root_l64 == merkle_root_lane_l64(
+        policy_hash_l64,
+        baseline_hash_l64,
+        telemetry_hash_l64,
+        bitstream_hash_l64,
+        signed_manifest_hash_l64
+    )
+}
+
+fn merkle_root_summary(root_l64: i64, verified: bool) -> string with Alloc {
+    "merkle_root_l64=" ++ kaxi_i64_to_string(root_l64) ++
+    ", verified=" ++ kaxi_bool_to_string(verified)
+}
+
+fn merkle_root_lane_self_check() -> bool with Alloc {
+    let root = merkle_root_lane_l64(11, 13, 17, 19, 23)
+    let ok = merkle_root_verify_l64(root, 11, 13, 17, 19, 23)
+    let bad = merkle_root_verify_l64(root + 1, 11, 13, 17, 19, 23)
+    let line = merkle_root_summary(root, ok)
+    ok && !bad && root != 0 && str_len(line) > 16
+}
