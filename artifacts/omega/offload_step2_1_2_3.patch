+// ============================================================================
+// Offload-spec compatibility shims
+// ============================================================================
+// These wrappers preserve the existing lowering architecture while exposing
+// the naming surface used by offload scaffold specs.
+
+fn hlir_scope_push(state: HlirLowerState) -> HlirLowerState with Mut, Panic {
+    hlir_lower_push_scope(state)
+}
+
+fn hlir_scope_pop(state: HlirLowerState) -> HlirLowerState with Mut {
+    hlir_lower_pop_scope(state)
+}
+
+fn hlir_scope_insert(state: HlirLowerState, name_hash: i64, value_id: i64) -> HlirLowerState with Mut, Panic, Div, Alloc {
+    var s = state
+    let pseudo_name = hlir_name_from_str("v_" ++ i64_to_string(name_hash))
+    s.builder = hlir_builder_bind_var(s.builder, pseudo_name, value_id)
+    s
+}
+
+fn hlir_scope_lookup(state: HlirLowerState, name_hash: i64) -> i64 with Panic, Div, Alloc {
+    let pseudo_name = hlir_name_from_str("v_" ++ i64_to_string(name_hash))
+    hlir_builder_lookup_var(state.builder, pseudo_name)
+}
+
+fn hlir_lower_seal_block(state: HlirLowerState) -> HlirLowerState {
+    // Current builder model does not require explicit block sealing.
+    state
+}
+
+// ============================================================================
+// AST/HIR compatibility layer (spec-facing entry points)
+// ============================================================================
+
+fn hlir_ast_name_to_string(name: Name) -> string with Mut, Panic, Div, Alloc {
+    str_from_bytes(name.buf, name.len)
+}
+
+fn hlir_ast_path_head_to_string(path: AstPath) -> string with Mut, Panic, Div, Alloc {
+    str_from_bytes(path.segments.head_buf, path.segments.head_len)
+}
+
+fn hlir_type_from_ast(ty: TypeExpr) -> HlirType with Mut, Panic, Div, Alloc {
+    if ty.kind == TypeExprKind::TypeUnit {
+        return hlir_type_void()
+    }
+    if ty.kind == TypeExprKind::TypeNamed {
+        let tname = hlir_ast_path_head_to_string(ty.path)
+        if tname == "i8" { return hlir_type_i8() }
+        if tname == "i16" { return hlir_type_i16() }
+        if tname == "i32" { return hlir_type_i32() }
+        if tname == "i64" { return hlir_type_i64() }
+        if tname == "u8" { return hlir_type_u8() }
+        if tname == "u16" { return hlir_type_u16() }
+        if tname == "u32" { return hlir_type_u32() }
+        if tname == "u64" { return hlir_type_u64() }
+        if tname == "f32" { return hlir_type_f32() }
+        if tname == "f64" { return hlir_type_f64() }
+        if tname == "bool" { return hlir_type_bool() }
+        if tname == "unit" { return hlir_type_void() }
+    }
+    if ty.kind == TypeExprKind::TypeReference || ty.kind == TypeExprKind::TypeRefMut {
+        return hlir_type_ptr(-1)
+    }
+    // Conservative fallback for unsupported/unknown AST types.
+    hlir_type_i64()
+}
+
+fn hlir_type_from_ast_opt(ty: Option<Box<TypeExpr>>) -> HlirType with Mut, Panic, Div, Alloc {
+    match ty {
+        Some(t) => hlir_type_from_ast(*t),
+        None => hlir_type_void(),
+    }
+}
+
+fn hlir_ast_binary_to_hlir(op: BinaryOp) -> HlirBinaryOp {
+    match op {
+        BinaryOp::OpAdd => HlirBinaryOp::HlirOpAdd,
+        BinaryOp::OpSub => HlirBinaryOp::HlirOpSub,
+        BinaryOp::OpMul => HlirBinaryOp::HlirOpMul,
+        BinaryOp::OpDiv => HlirBinaryOp::HlirOpSDiv,
+        BinaryOp::OpRem => HlirBinaryOp::HlirOpSRem,
+        BinaryOp::OpEq => HlirBinaryOp::HlirOpEq,
+        BinaryOp::OpNe => HlirBinaryOp::HlirOpNe,
+        BinaryOp::OpLt => HlirBinaryOp::HlirOpSLt,
+        BinaryOp::OpLe => HlirBinaryOp::HlirOpSLe,
+        BinaryOp::OpGt => HlirBinaryOp::HlirOpSGt,
+        BinaryOp::OpGe => HlirBinaryOp::HlirOpSGe,
+        BinaryOp::OpAnd => HlirBinaryOp::HlirOpAnd,
+        BinaryOp::OpOr => HlirBinaryOp::HlirOpOr,
+        BinaryOp::OpBitAnd => HlirBinaryOp::HlirOpAnd,
+        BinaryOp::OpBitOr => HlirBinaryOp::HlirOpOr,
+        BinaryOp::OpBitXor => HlirBinaryOp::HlirOpXor,
+        BinaryOp::OpShl => HlirBinaryOp::HlirOpShl,
+        BinaryOp::OpShr => HlirBinaryOp::HlirOpAShr,
+        BinaryOp::OpConcat => HlirBinaryOp::HlirOpConcat,
+        _ => HlirBinaryOp::HlirOpAdd,
+    }
+}
+
+fn hlir_ast_binary_result_ty(op: BinaryOp) -> HlirType {
+    if op == BinaryOp::OpEq
+    || op == BinaryOp::OpNe
+    || op == BinaryOp::OpLt
+    || op == BinaryOp::OpLe
+    || op == BinaryOp::OpGt
+    || op == BinaryOp::OpGe
+    || op == BinaryOp::OpAnd
+    || op == BinaryOp::OpOr {
+        return hlir_type_bool()
+    }
+    hlir_type_i64()
+}
+
+fn hlir_ast_unary_to_hlir(op: UnaryOp) -> HlirUnaryOp {
+    match op {
+        UnaryOp::OpNot => HlirUnaryOp::HlirOpNot,
+        _ => HlirUnaryOp::HlirOpNeg,
+    }
+}
+
+fn hlir_ast_name_hash(name: Name) -> i64 with Mut, Panic, Div {
+    var h: i64 = 0
+    var i: i64 = 0
+    while i < name.len {
+        h = h * 33 + (name.buf[i as usize] as i64)
+        i = i + 1
+    }
+    if h < 0 { 0 - h } else { h }
+}
+
+fn hlir_lower_expr_opt(state: HlirLowerState, expr: Option<Box<Expr>>) -> (HlirLowerState, i64) with Mut, Panic, Div, Alloc {
+    match expr {
+        Some(e) => hlir_lower_expr(state, *e),
+        None => hlir_lower_unit(state),
+    }
+}
+
+fn hlir_lower_expr_list(
+    state: HlirLowerState,
+    list: Option<Box<ExprList>>,
+    values: [i64; 64],
+    count: i64,
+) -> (HlirLowerState, [i64; 64], i64) with Mut, Panic, Div, Alloc {
+    match list {
+        Some(node) => {
+            var s = state
+            var out = values
+            let next_count = if count < 64 { count + 1 } else { count }
+            let expr_pair = hlir_lower_expr(s, (*node).head)
+            s = expr_pair.0
+            if count < 64 {
+                out[count as usize] = expr_pair.1
+            }
+            hlir_lower_expr_list(s, (*node).tail, out, next_count)
+        }
+        None => (state, values, count),
+    }
+}
+
+fn hlir_lower_field_access(state: HlirLowerState, base: i64, field: i64) -> (HlirLowerState, i64) with Mut, Panic {
+    let ptr_pair = hlir_lower_get_field_ptr(state, base, field, hlir_type_ptr(-1))
+    hlir_lower_load(ptr_pair.0, ptr_pair.1, hlir_type_i64())
+}
+
+fn hlir_lower_index(state: HlirLowerState, base: i64, index: i64) -> (HlirLowerState, i64) with Mut, Panic {
+    let ptr_pair = hlir_lower_gep(state, base, index, hlir_type_i64())
+    hlir_lower_load(ptr_pair.0, ptr_pair.1, hlir_type_i64())
+}
+
+fn hlir_lower_literal(state: HlirLowerState, lit: Expr) -> (HlirLowerState, i64) with Mut, Panic, Div, Alloc {
+    if lit.kind == ExprKind::ExprIntLit {
+        return hlir_lower_literal_int(state, lit.int_val, hlir_type_i64())
+    }
+    if lit.kind == ExprKind::ExprFloatLit {
+        return hlir_lower_literal_float(state, lit.float_val, hlir_type_f64())
+    }
+    if lit.kind == ExprKind::ExprBoolTrue {
+        return hlir_lower_literal_bool(state, true)
+    }
+    if lit.kind == ExprKind::ExprBoolFalse {
+        return hlir_lower_literal_bool(state, false)
+    }
+    if lit.kind == ExprKind::ExprCharLit {
+        return hlir_lower_literal_int(state, lit.int_val, hlir_type_i64())
+    }
+    if lit.kind == ExprKind::ExprStringLit {
+        return hlir_lower_literal_string(state, hlir_ast_name_to_string(lit.name))
+    }
+    hlir_lower_unit(state)
+}
+
+fn hlir_lower_match(state: HlirLowerState, scrutinee: i64, arms: Option<Box<MatchArmList>>) -> (HlirLowerState, i64) with Mut, Panic, Div, Alloc {
+    // Minimal bridge implementation: lower first arm body if present.
+    // Full pattern dispatch is handled by match_begin/match_merge APIs.
+    match arms {
+        Some(list) => hlir_lower_expr(state, (*list).head.body),
+        None => hlir_lower_unit(state),
+    }
+}
+
+fn hlir_lower_stmt(state: HlirLowerState, stmt: Stmt) -> HlirLowerState with Mut, Panic, Div, Alloc {
+    var s = state
+    if stmt.kind == StmtKind::StmtLet {
+        let init_pair = hlir_lower_expr_opt(s, stmt.expr)
+        s = init_pair.0
+        let name = hlir_ast_name_to_string(stmt.name)
+        let ty = hlir_type_from_ast_opt(stmt.ty)
+        return hlir_lower_let(s, name, ty, init_pair.1)
+    }
+    if stmt.kind == StmtKind::StmtVar {
+        let init_pair = hlir_lower_expr_opt(s, stmt.expr)
+        s = init_pair.0
+        let name = hlir_ast_name_to_string(stmt.name)
+        let ty = hlir_type_from_ast_opt(stmt.ty)
+        return hlir_lower_var(s, name, ty, init_pair.1)
+    }
+    if stmt.kind == StmtKind::StmtAssign {
+        let rhs_pair = hlir_lower_expr_opt(s, stmt.expr)
+        s = rhs_pair.0
+        match stmt.target {
+            Some(t) => {
+                if (*t).kind == ExprKind::ExprIdent {
+                    let target_name = hlir_ast_name_to_string((*t).name)
+                    return hlir_lower_assign(s, target_name, rhs_pair.1)
+                }
+                // Non-identifier assignment target: report unsupported in shim.
+                return hlir_lower_report_error(s)
+            }
+            None => hlir_lower_report_error(s),
+        }
+    }
+    if stmt.kind == StmtKind::StmtExpr {
+        let expr_pair = hlir_lower_expr_opt(s, stmt.expr)
+        return expr_pair.0
+    }
+    s
+}
+
+fn hlir_lower_stmt_list(state: HlirLowerState, stmts: Option<Box<StmtList>>) -> HlirLowerState with Mut, Panic, Div, Alloc {
+    match stmts {
+        Some(list) => {
+            let s1 = hlir_lower_stmt(state, (*list).head)
+            hlir_lower_stmt_list(s1, (*list).tail)
+        }
+        None => state,
+    }
+}
+
+fn hlir_lower_block_from_ast(state: HlirLowerState, block: Block) -> HlirLowerState with Mut, Panic, Div, Alloc {
+    var s = hlir_scope_push(state)
+    s = hlir_lower_stmt_list(s, block.stmts)
+    s = hlir_scope_pop(s)
+    s
+}
+
+fn hlir_lower_struct_field_values(state: HlirLowerState, fields: Option<Box<StructFieldList>>) -> HlirLowerState with Mut, Panic, Div, Alloc {
+    match fields {
+        Some(list) => {
+            let value_pair = hlir_lower_expr(state, (*list).head.value)
+            hlir_lower_struct_field_values(value_pair.0, (*list).tail)
+        }
+        None => state,
+    }
+}
+
+fn hlir_lower_expr(state: HlirLowerState, expr: Expr) -> (HlirLowerState, i64) with Mut, Panic, Div, Alloc {
+    var s = state
+
+    if expr.kind == ExprKind::ExprIntLit
+    || expr.kind == ExprKind::ExprFloatLit
+    || expr.kind == ExprKind::ExprBoolTrue
+    || expr.kind == ExprKind::ExprBoolFalse
+    || expr.kind == ExprKind::ExprCharLit
+    || expr.kind == ExprKind::ExprStringLit {
+        return hlir_lower_literal(s, expr)
+    }
+
+    if expr.kind == ExprKind::ExprIdent {
+        let name = hlir_name_from_str(hlir_ast_name_to_string(expr.name))
+        return hlir_lower_read_var_named(s, name, hlir_type_i64())
+    }
+
+    if expr.kind == ExprKind::ExprPath {
+        let path_name = hlir_name_from_str(hlir_ast_path_head_to_string(expr.path))
+        return hlir_lower_read_var_named(s, path_name, hlir_type_i64())
+    }
+
+    if expr.kind == ExprKind::ExprBinary {
+        let lhs_pair = hlir_lower_expr_opt(s, expr.left)
+        s = lhs_pair.0
+        let rhs_pair = hlir_lower_expr_opt(s, expr.right)
+        s = rhs_pair.0
+        let op = hlir_ast_binary_to_hlir(expr.bin_op)
+        let ty = hlir_ast_binary_result_ty(expr.bin_op)
+        return hlir_lower_binary(s, op, lhs_pair.1, rhs_pair.1, ty)
+    }
+
+    if expr.kind == ExprKind::ExprUnary {
+        let src_pair = hlir_lower_expr_opt(s, expr.left)
+        s = src_pair.0
+        let op = hlir_ast_unary_to_hlir(expr.un_op)
+        return hlir_lower_unary(s, op, src_pair.1, hlir_type_i64())
+    }
+
+    if expr.kind == ExprKind::ExprFieldAccess {
+        let base_pair = hlir_lower_expr_opt(s, expr.left)
+        s = base_pair.0
+        let field_idx = hlir_ast_name_hash(expr.name) % 16
+        return hlir_lower_field_access(s, base_pair.1, field_idx)
+    }
+
+    if expr.kind == ExprKind::ExprIndex {
+        let base_pair = hlir_lower_expr_opt(s, expr.left)
+        s = base_pair.0
+        let idx_pair = hlir_lower_expr_opt(s, expr.right)
+        s = idx_pair.0
+        return hlir_lower_index(s, base_pair.1, idx_pair.1)
+    }
+
+    if expr.kind == ExprKind::ExprCast {
+        let src_pair = hlir_lower_expr_opt(s, expr.left)
+        s = src_pair.0
+        let target_ty = hlir_type_from_ast_opt(expr.cast_type)
+        return hlir_lower_cast(s, src_pair.1, hlir_type_i64(), target_ty)
+    }
+
+    if expr.kind == ExprKind::ExprCall {
+        var callee = "call"
+        match expr.left {
+            Some(callee_expr) => {
+                if (*callee_expr).kind == ExprKind::ExprIdent {
+                    callee = hlir_ast_name_to_string((*callee_expr).name)
+                } else if (*callee_expr).kind == ExprKind::ExprPath {
+                    callee = hlir_ast_path_head_to_string((*callee_expr).path)
+                } else {
+                    s = hlir_lower_report_error(s)
+                    return hlir_lower_unit(s)
+                }
+            }
+            None => {
+                s = hlir_lower_report_error(s)
+                return hlir_lower_unit(s)
+            }
+        }
+        let args_pair = hlir_lower_expr_list(s, expr.args, [HLIR_INVALID_VALUE; 64], 0)
+        s = args_pair.0
+        return hlir_lower_call(s, callee, args_pair.1, args_pair.2, hlir_type_i64())
+    }
+
+    if expr.kind == ExprKind::ExprMethodCall {
+        let base_pair = hlir_lower_expr_opt(s, expr.left)
+        s = base_pair.0
+        var arg_vals: [i64; 64] = [HLIR_INVALID_VALUE; 64]
+        arg_vals[0] = base_pair.1
+        let args_pair = hlir_lower_expr_list(s, expr.args, arg_vals, 1)
+        s = args_pair.0
+        return hlir_lower_call(s, hlir_ast_name_to_string(expr.name), args_pair.1, args_pair.2, hlir_type_i64())
+    }
+
+    if expr.kind == ExprKind::ExprIf {
+        let cond_pair = hlir_lower_expr_opt(s, expr.left)
+        s = cond_pair.0
+        let ifb = hlir_lower_if_begin(s, cond_pair.1)
+        s = hlir_lower_switch_to_block(ifb.state, ifb.then_block)
+        match expr.block {
+            Some(then_block) => { s = hlir_lower_block_from_ast(s, *then_block) }
+            None => {}
+        }
+        let then_done = hlir_lower_if_then_done(s, ifb.merge_block, HLIR_INVALID_VALUE)
+        s = hlir_lower_switch_to_block(then_done.0, ifb.else_block)
+        var else_val: i64 = HLIR_INVALID_VALUE
+        match expr.else_expr {
+            Some(else_expr) => {
+                let else_pair = hlir_lower_expr(s, *else_expr)
+                s = else_pair.0
+                else_val = else_pair.1
+            }
+            None => {}
+        }
+        let else_done = hlir_lower_if_else_done(s, ifb.merge_block, else_val)
+        return hlir_lower_if_finish(
+            else_done.0,
+            ifb.merge_block,
+            then_done.1,
+            HLIR_INVALID_VALUE,
+            else_done.1,
+            else_val,
+            hlir_type_void(),
+        )
+    }
+
+    if expr.kind == ExprKind::ExprWhile {
+        let wb = hlir_lower_while_begin(s)
+        s = hlir_lower_switch_to_block(wb.state, wb.header_block)
+        let cond_pair = hlir_lower_expr_opt(s, expr.left)
+        s = cond_pair.0
+        s = hlir_lower_cond_branch(s, cond_pair.1, wb.body_block, wb.exit_block)
+        s = hlir_lower_switch_to_block(s, wb.body_block)
+        match expr.block {
+            Some(body_block) => { s = hlir_lower_block_from_ast(s, *body_block) }
+            None => {}
+        }
+        let body_exit = hlir_lower_current_block(s)
+        s = hlir_lower_while(s, cond_pair.1, body_exit, wb.header_block, wb.body_block, wb.exit_block)
+        return hlir_lower_unit(s)
+    }
+
+    if expr.kind == ExprKind::ExprLoop {
+        let lb = hlir_lower_loop_begin(s)
+        s = lb.state
+        match expr.block {
+            Some(body_block) => { s = hlir_lower_block_from_ast(s, *body_block) }
+            None => {}
+        }
+        s = hlir_lower_loop_end(s, lb.header_block, lb.exit_block)
+        return hlir_lower_unit(s)
+    }
+
+    if expr.kind == ExprKind::ExprMatch {
+        let scrutinee_pair = hlir_lower_expr_opt(s, expr.left)
+        s = scrutinee_pair.0
+        return hlir_lower_match(s, scrutinee_pair.1, expr.arms)
+    }
+
+    if expr.kind == ExprKind::ExprBlock {
+        match expr.block {
+            Some(block) => { s = hlir_lower_block_from_ast(s, *block) }
+            None => {}
+        }
+        return hlir_lower_unit(s)
+    }
+
+    if expr.kind == ExprKind::ExprStructLit {
+        s = hlir_lower_struct_field_values(s, expr.fields)
+        s = hlir_lower_report_error(s)
+        return hlir_lower_unit(s)
+    }
+
+    if expr.kind == ExprKind::ExprArrayLit || expr.kind == ExprKind::ExprTupleLit {
+        let elems_pair = hlir_lower_expr_list(s, expr.args, [HLIR_INVALID_VALUE; 64], 0)
+        s = elems_pair.0
+        s = hlir_lower_report_error(s)
+        return hlir_lower_unit(s)
+    }
+
+    if expr.kind == ExprKind::ExprRange {
+        let lhs_pair = hlir_lower_expr_opt(s, expr.left)
+        s = lhs_pair.0
+        let rhs_pair = hlir_lower_expr_opt(s, expr.right)
+        s = rhs_pair.0
+        let op = hlir_ast_binary_to_hlir(expr.bin_op)
+        return hlir_lower_binary(s, op, lhs_pair.1, rhs_pair.1, hlir_type_i64())
+    }
+
+    if expr.kind == ExprKind::ExprReturn {
+        let val_pair = hlir_lower_expr_opt(s, expr.left)
+        s = val_pair.0
+        s = hlir_lower_return(s, val_pair.1)
+        return (s, val_pair.1)
+    }
+
+    if expr.kind == ExprKind::ExprBreak {
+        s = hlir_lower_break(s)
+        return hlir_lower_unit(s)
+    }
+
+    if expr.kind == ExprKind::ExprContinue {
+        s = hlir_lower_continue(s)
+        return hlir_lower_unit(s)
+    }
+
+    if expr.kind == ExprKind::ExprError {
+        s = hlir_lower_report_error(s)
+        return hlir_lower_unit(s)
+    }
+
+    // Conservative fallback for unsupported expression forms in this shim.
+    s = hlir_lower_report_error(s)
+    hlir_lower_unit(s)
+}
+
+fn hlir_lower_params(state: HlirLowerState, params: Option<Box<ParamList>>) -> HlirLowerState with Mut, Panic, Div, Alloc {
+    match params {
+        Some(list) => {
+            var s = state
+            let pname = hlir_ast_name_to_string((*list).head.name)
+            let pty = hlir_type_from_ast((*list).head.ty)
+            let p = hlir_lower_add_param(s, pname, pty)
+            s = p.0
+            s = hlir_lower_let(s, pname, pty, p.1)
+            hlir_lower_params(s, (*list).tail)
+        }
+        None => state,
+    }
+}
+
+fn hlir_lower_function(state: HlirLowerState, ast_func: FnDef) -> HlirLowerState with Mut, Panic, Div, Alloc {
+    var s = state
+    let fn_name = hlir_ast_name_to_string(ast_func.name)
+    let ret_ty = hlir_type_from_ast_opt(ast_func.return_type)
+    s = hlir_lower_begin_function(s, fn_name, ret_ty)
+    s = hlir_scope_push(s)
+    s = hlir_lower_params(s, ast_func.params)
+    s = hlir_lower_block_from_ast(s, ast_func.body)
+    s = hlir_scope_pop(s)
+
+    // Ensure a terminating return in shim mode.
+    if ret_ty.kind == HlirTypeKind::HlirTypeVoid {
+        s = hlir_lower_return_void(s)
+    } else {
+        let zero_pair = hlir_lower_literal_int(s, 0, ret_ty)
+        s = zero_pair.0
+        s = hlir_lower_return(s, zero_pair.1)
+    }
+
+    s = hlir_lower_end_function(s)
+    s
+}
+
+fn hlir_lower_items(state: HlirLowerState, items: Option<Box<ItemList>>) -> HlirLowerState with Mut, Panic, Div, Alloc {
+    match items {
+        Some(list) => {
+            var s = state
+            let item = (*list).head
+            if item.kind == ItemKind::ItemFn {
+                match item.fn_def {
+                    Some(fn_def) => { s = hlir_lower_function(s, *fn_def) }
+                    None => { s = hlir_lower_report_error(s) }
+                }
+            }
+            hlir_lower_items(s, (*list).tail)
+        }
+        None => state,
+    }
+}
+
+fn hlir_lower_module(ast_module: Program) -> HlirModule with Mut, Panic, Div, Alloc {
+    var s = hlir_lower_state_new()
+    let mod_name = hlir_ast_path_head_to_string(ast_module.module_path)
+    if str_len(mod_name) > 0 {
+        s = hlir_lower_set_module_name(s, mod_name)
+    } else {
+        s = hlir_lower_set_module_name(s, "module")
+    }
+    s = hlir_lower_items(s, ast_module.items)
+    hlir_lower_finish_module(s)
+}
+
