.version 7.0
.target sm_50
.address_size 64

.visible .entry fma_f64(
    .param .u64 param_a,
    .param .u64 param_b,
    .param .u64 param_c,
    .param .u64 param_d
)
{
    .reg .pred %p<2>;
    .reg .b32 %r<3>;
    .reg .b64 %rd<11>;
    .reg .f64 %fd<5>;

    mov.u32 %r1, %tid.x;
    cvt.u64.u32 %rd1, %r1;
    mul.lo.u64 %rd2, %rd1, 8;
    ld.param.u64 %rd3, [param_a];
    ld.param.u64 %rd4, [param_b];
    ld.param.u64 %rd5, [param_c];
    ld.param.u64 %rd6, [param_d];
    add.u64 %rd7, %rd3, %rd2;
    add.u64 %rd8, %rd4, %rd2;
    add.u64 %rd9, %rd5, %rd2;
    add.u64 %rd10, %rd6, %rd2;
    ld.global.f64 %fd1, [%rd7];
    ld.global.f64 %fd2, [%rd8];
    ld.global.f64 %fd3, [%rd9];
    fma.rn.f64 %fd4, %fd1, %fd2, %fd3;
    st.global.f64 [%rd10], %fd4;
    ret;
}
