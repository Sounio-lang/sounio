.version 6.4
.target sm_75
.address_size 64

.func (.b32 retval) main(
)
{
	.reg .pred p<64>;
	.reg .b16 r16_<64>;
	.reg .b32 r32_<128>;
	.reg .b64 r64_<128>;
	.reg .f32 f32_<128>;
	.reg .f64 f64_<64>;

entry:
	mov.s32 r32_0, 0;
	mov.f32 f32_0, 0F00000000;
	setp.eq.u32 p0, 1, 1;
	mov.u64 r64_0, 0;
	st.param.b64 [retval], r32_0;
	ret;
}

.visible .entry matmul(
	.param .b64 param_m,
	.param .b64 param_n,
	.param .b64 param_k
)
.maxntid 128, 1, 1
{
	// Register declarations
	.reg .pred p<64>;
	.reg .b16 r16_<64>;
	.reg .b32 r32_<128>;
	.reg .b64 r64_<128>;
	.reg .f32 f32_<128>;
	.reg .f64 f64_<64>;

entry:
	ld.param.u64 r64_0, [param_0];
	ld.param.u64 r64_1, [param_1];
	ld.param.u64 r64_2, [param_2];
	ret;
}

.visible .entry matmul_transpose(
	.param .b64 param_m,
	.param .b64 param_n
)
.maxntid 128, 1, 1
{
	// Register declarations
	.reg .pred p<64>;
	.reg .b16 r16_<64>;
	.reg .b32 r32_<128>;
	.reg .b64 r64_<128>;
	.reg .f32 f32_<128>;
	.reg .f64 f64_<64>;

entry:
	ld.param.u64 r64_0, [param_0];
	ld.param.u64 r64_1, [param_1];
	ret;
}

