struct Name { buf: [i8; 8], len: i64 }
struct Module { names: [Name; 4], count: i64 }
fn empty_name() -> Name { Name { buf: [0; 8], len: 0 } }
fn count_names(ns: [Name; 4], count: i64) -> i64 { count + ns[0].len }
fn main() -> i64 {
    let m = Module { names: [empty_name(); 4], count: 2 }
    count_names(m.names, m.count)
}
