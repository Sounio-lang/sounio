struct Octonion { a: f64 }
struct Hyper<T, S> { v: T, s: S }
fn g(pa: &Hyper<Octonion, f64>, pH: &[Hyper<Octonion, f64>; 16], pout: &! [f64; 256]) with GPU { }
kernel fn step(pa: &Hyper<Octonion, f64>, pH: &[Hyper<Octonion, f64>; 16], pout: &! [f64; 256]) with GPU {
    g(pa, pH, pout)
}
fn main() -> i64 { 0 }
