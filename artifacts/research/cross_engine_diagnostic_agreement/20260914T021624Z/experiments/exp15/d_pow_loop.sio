fn emit(v: i64, decimals: i64) -> i64 with Mut, Div, Panic {
    var pow: i64 = 1
    var k: i64 = 0
    while k < decimals {
        pow = pow * 10
        k = k + 1
    }
    let int_part = v / pow
    let frac_part = v - int_part * pow
    var acc: i64 = 0
    if decimals > 0 {
        var place: i64 = pow / 10
        while place >= 1 {
            let digit = (frac_part / place) - ((frac_part / (place * 10)) * 10)
            acc = acc + digit
            place = place / 10
        }
    }
    acc
}
fn main() -> i64 with Mut, Div, Panic { emit(12345, 3) }
