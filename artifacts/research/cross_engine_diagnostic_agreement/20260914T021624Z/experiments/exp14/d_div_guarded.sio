fn digits(pow: i64, frac_part: i64) -> i64 with Mut, Div, Panic {
    var place: i64 = pow / 10
    var acc: i64 = 0
    while place >= 1 {
        let digit = (frac_part / place) - ((frac_part / (place * 10)) * 10)
        acc = acc + digit
        place = place / 10
    }
    acc
}
fn main() -> i64 with Mut, Div, Panic { digits(1000, 5) }
