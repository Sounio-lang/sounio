module main

use pbpk::rapamycin_tdm_sequential::{
    ts_cv_ratio_sq,
    ts_u_post_lcms_k1_n7, ts_u_post_lcms_k2_n7, ts_u_post_lcms_k3_n7,
    ts_gain_lcms_k1_n7, ts_gain_lcms_k2_n7, ts_gain_lcms_k3_n7,
    ts_u_post_immuno_k1_n7, ts_u_post_immuno_k2_n7, ts_u_post_immuno_k3_n7, ts_u_post_immuno_k9_n7,
    ts_gain_immuno_k1_n7, ts_gain_immuno_k2_n7, ts_gain_immuno_k3_n7, ts_gain_immuno_k9_n7,
    ts_u_post_lcms_k1_n14, ts_u_post_lcms_k2_n14, ts_u_post_lcms_k3_n14,
    ts_gain_lcms_k1_n14, ts_gain_lcms_k2_n14, ts_gain_lcms_k3_n14,
    ts_u_post_immuno_k1_n14, ts_u_post_immuno_k9_n14,
    ts_gain_immuno_k1_n14, ts_gain_immuno_k9_n14,
    ts_margin_prior_n7, ts_margin_lcms_k1_n7, ts_margin_lcms_k2_n7, ts_margin_lcms_k3_n7,
    ts_margin_immuno_k1_n7, ts_margin_immuno_k3_n7, ts_margin_immuno_k9_n7,
    ts_equiv_gain_diff_n7, ts_equiv_gain_diff_n14,
    ts_marginal_lcms_k2_n7, ts_marginal_lcms_k3_n7,
    ts_marginal_immuno_k2_n7, ts_marginal_immuno_k3_n7
}

fn main() with Mut, Div, Panic, IO {
    print("=== CV ratio squared ===\n")
    print("(CV_immuno/CV_lcms)^2: "); print_f64(ts_cv_ratio_sq()); print("\n")

    print("\n=== LCMS posterior u at N=7 ===\n")
    print("k=1: "); print_f64(ts_u_post_lcms_k1_n7()); print("\n")
    print("k=2: "); print_f64(ts_u_post_lcms_k2_n7()); print("\n")
    print("k=3: "); print_f64(ts_u_post_lcms_k3_n7()); print("\n")

    print("\n=== LCMS precision gains at N=7 ===\n")
    print("k=1: "); print_f64(ts_gain_lcms_k1_n7()); print("\n")
    print("k=2: "); print_f64(ts_gain_lcms_k2_n7()); print("\n")
    print("k=3: "); print_f64(ts_gain_lcms_k3_n7()); print("\n")

    print("\n=== Immuno posterior u at N=7 ===\n")
    print("k=1: "); print_f64(ts_u_post_immuno_k1_n7()); print("\n")
    print("k=2: "); print_f64(ts_u_post_immuno_k2_n7()); print("\n")
    print("k=3: "); print_f64(ts_u_post_immuno_k3_n7()); print("\n")
    print("k=9: "); print_f64(ts_u_post_immuno_k9_n7()); print("\n")

    print("\n=== Immuno precision gains at N=7 ===\n")
    print("k=1: "); print_f64(ts_gain_immuno_k1_n7()); print("\n")
    print("k=2: "); print_f64(ts_gain_immuno_k2_n7()); print("\n")
    print("k=3: "); print_f64(ts_gain_immuno_k3_n7()); print("\n")
    print("k=9: "); print_f64(ts_gain_immuno_k9_n7()); print("\n")

    print("\n=== LCMS precision gains at N=14 ===\n")
    print("k=1: "); print_f64(ts_gain_lcms_k1_n14()); print("\n")
    print("k=2: "); print_f64(ts_gain_lcms_k2_n14()); print("\n")
    print("k=3: "); print_f64(ts_gain_lcms_k3_n14()); print("\n")

    print("\n=== Immuno gains at N=14 ===\n")
    print("k=1: "); print_f64(ts_gain_immuno_k1_n14()); print("\n")
    print("k=9: "); print_f64(ts_gain_immuno_k9_n14()); print("\n")

    print("\n=== Equivalence verification (immuno k=9 vs LCMS k=1) ===\n")
    print("diff gain at N=7:  "); print_f64(ts_equiv_gain_diff_n7());  print("\n")
    print("diff gain at N=14: "); print_f64(ts_equiv_gain_diff_n14()); print("\n")

    print("\n=== Posterior margins at N=7 ===\n")
    print("prior:       "); print_f64(ts_margin_prior_n7());     print("\n")
    print("LCMS k=1:    "); print_f64(ts_margin_lcms_k1_n7());  print("\n")
    print("LCMS k=2:    "); print_f64(ts_margin_lcms_k2_n7());  print("\n")
    print("LCMS k=3:    "); print_f64(ts_margin_lcms_k3_n7());  print("\n")
    print("immuno k=1:  "); print_f64(ts_margin_immuno_k1_n7()); print("\n")
    print("immuno k=3:  "); print_f64(ts_margin_immuno_k3_n7()); print("\n")
    print("immuno k=9:  "); print_f64(ts_margin_immuno_k9_n7()); print("\n")

    print("\n=== Diminishing returns (marginal gain of k-th LCMS at N=7) ===\n")
    print("2nd LCMS: "); print_f64(ts_marginal_lcms_k2_n7()); print("\n")
    print("3rd LCMS: "); print_f64(ts_marginal_lcms_k3_n7()); print("\n")

    print("\n=== Diminishing returns (marginal gain of k-th immuno at N=7) ===\n")
    print("2nd immuno: "); print_f64(ts_marginal_immuno_k2_n7()); print("\n")
    print("3rd immuno: "); print_f64(ts_marginal_immuno_k3_n7()); print("\n")
}
