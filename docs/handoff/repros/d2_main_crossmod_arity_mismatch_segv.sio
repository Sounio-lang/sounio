//@ run-fail
// D2 repro: cross-module + arity-mismatch aggregate delegation (see
// d2_lib_arity_mismatch.sio). SEGFAULTS at runtime under `souc run`/`build`.
// Confirmed to segfault at array sizes 16, 64, 256, 1024, and 2048 alike —
// the trigger is the cross-module arity mismatch, NOT the array size.

use d2_lib_arity_mismatch::{make_one, add3}

fn main() -> i32 with IO, Mut, Panic, Div {
    let a = make_one(4)
    let b = make_one(4)
    let c = make_one(4)
    let r = add3(a, b, c)
    println("done")
    print_int(r.c[0])
    0
}
