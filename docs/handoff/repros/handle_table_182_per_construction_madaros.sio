// Pre-fix Madaros rc=182 "handles full" -- every >16 B struct CONSTRUCTION took a
// handle-table slot that was never returned (monotonic bump, capacity 2^22).
// Passing, field reads and `s = ...` reassignment take none. This RK2 step builds 4 managed
// values, so the table fills after 2^22/4 = 1048576 steps with at most ~5 values live.
//   Madaros:     last line i=1044480, stderr "madaros: handles full", exit 182
//   lean_single: REPRO_OK
// Control: make St 16 B (drop `c`) and Madaros prints REPRO_OK -- <=16 B structs are unboxed.
struct St { a: f64, b: f64, c: f64 }
fn f(s: St) -> St { St { a: 0.0 - s.a, b: 0.0 - s.b, c: 0.0 - s.c } }
fn axpy(x: St, y: St, h: f64) -> St { St { a: x.a + h * y.a, b: x.b + h * y.b, c: x.c + h * y.c } }
fn step(s: St, h: f64) -> St {
    let k1 = f(s)
    let k2 = f(axpy(s, k1, 0.5 * h))
    axpy(s, k2, h)
}
fn main() -> i32 with IO, Mut, Div, Panic {
    var s = St { a: 1.0, b: 1.0, c: 1.0 }
    var i: i64 = 0
    while i < 1200000 {
        s = step(s, 0.000001)
        i = i + 1
        if i % 4096 == 0 { print("i="); println(i) }
    }
    println("REPRO_OK")
    0
}
