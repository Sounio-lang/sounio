//@ run-pass
// D6 (CONFIRMED, most severe): `var r = a; r.field = x` where `a` is a struct PARAMETER aliases the
// caller's value under souc v0.80.0 -- struct value semantics are broken; copy-then-mutate mutates
// the ORIGINAL in place. Silent data corruption with a clean compile (rc=0). Output observed:
//   p.flag=true q.flag=true   (WRONG -- p was mutated by the call; correct is p.flag=false q.flag=true)
struct P { x: i64, flag: bool }
fn flip(a: P) -> P with Mut { var r = a; r.flag = !a.flag; r }
fn main() with IO, Mut, Panic, Div {
    let p = P { x: 42, flag: false }
    let q = flip(p)
    print("p.flag="); if p.flag { print("true") } else { print("false") }
    print(" q.flag="); if q.flag { print("true") } else { print("false") }; print("\n")
}
