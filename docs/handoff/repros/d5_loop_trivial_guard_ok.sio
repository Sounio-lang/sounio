//@ run-pass
// D5 isolation control: SAME loop shape, but the guard is a trivial literal comparison (no global,
// no division). This does NOT reproduce -- p correctly goes 10,100,1000,10000. So the trigger is not
// merely "function call in a loop"; it involves the guard function's global-read + division.
fn triv(a: i64) -> bool { a > 1000000000000000000 }
fn main() with IO, Mut, Panic, Div {
    var p: i64 = 10
    var k = 1
    while k <= 4 {
        print("k="); print_int(k); print(" p="); print_int(p); print("\n")
        if triv(p) { p = 0 } else { p = p * 10 }
        k = k + 1
    }
}
