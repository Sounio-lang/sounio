//@ run-pass
// D2 repro (library half): struct with a fixed-size array field, and two
// aggregate-by-value functions of DIFFERENT arity where the higher-arity one
// (add3, 3 struct params) delegates to the lower-arity one (add2, 2 struct
// params, itself calling the 1-arg aggregate-returning make_zero).

pub struct S {
    c: [i64; 16],
    bits: i32,
}

pub fn make_zero(k: i32) -> S with Mut, Panic {
    S { c: [0; 16], bits: k }
}

pub fn make_one(k: i32) -> S with Mut, Panic {
    var r = S { c: [0; 16], bits: k }
    r.c[0] = 1
    r
}

pub fn add2(a: S, b: S) -> S with Mut, Panic, Div {
    var r = make_zero(a.bits)
    var i: i32 = 0
    while i < 16 { r.c[i as usize] = a.c[i as usize] + b.c[i as usize]; i = i + 1 }
    r
}

pub fn add3(a: S, b: S, c: S) -> S with Mut, Panic, Div {
    let ab = add2(a, b)
    add2(ab, c)
}
