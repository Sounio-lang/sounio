//@ run-fail
// D4 variant: enum value built via a `let` binding from a DIRECT enum-struct
// literal at the call site (still via constructor fn to dodge the brace/`if`
// parse ambiguity noted elsewhere) rather than as a separately-named `let v =
// make_measured_f64(...)` two steps removed. Tests whether the flake depends
// on how/where the value is constructed.

enum Verdict {
    Proved,
    MeasuredF64 { eps: f64 },
    MeasuredF256 { eps256: f64 },
}

fn is_measurement(v: Verdict) -> bool {
    match v {
        Verdict::Proved => false,
        Verdict::MeasuredF64 { eps } => true,
        Verdict::MeasuredF256 { eps256 } => false,
    }
}

fn main() with IO {
    // Direct enum-struct literal, bound immediately (no separate constructor fn).
    let v = Verdict::MeasuredF64 { eps: 1.0 }
    let im = is_measurement(v)
    println("is_measurement(MeasuredF64) via direct literal let-binding [expect true]:")
    if im { println("true") } else { println("false") }
}
