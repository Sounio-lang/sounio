//@ run-pass
// D6 fix/control: constructing a FRESH struct literal (no copy-then-mutate) is correct.
struct P { x: i64, flag: bool }
fn flip(a: P) -> P with Mut { P { x: a.x, flag: !a.flag } }
fn main() with IO, Mut, Panic, Div {
    let p = P { x: 42, flag: false }
    let q = flip(p)
    print("p.flag="); if p.flag { print("true") } else { print("false") }
    print(" q.flag="); if q.flag { print("true") } else { print("false") }; print("\n")
}
