// #651 Defect A demonstrator — native handle-table wrap at 2^20 (self-hosted/native/gc.sio).
// Each rat_add heap-boxes a value struct → one handle/call. At 2^20=1048576 handles the table
// fills, the GC empty-frame-reset fires, the liveness probe under-detects `acc`, the heap is
// wiped under a live handle → silent WRONG value (no array-of-struct involved). Set N below 2^20
// for a correct result, at/above for garbage. This is NOT an aggregate/[struct;N] bug.
//   N=1048575 -> 1048575 (correct)   N=1048576 -> 2097150 = 2*0xFFFFF (WRONG)
use math::rational::{Rational, rat_zero, rat_one, rat_add}
fn main() with IO, Mut, Panic, Div {
    var acc = rat_zero()
    let one = rat_one()
    var i: i64 = 0
    while i < 1048576 {
        acc = rat_add(acc, one)
        i = i + 1
    }
    print("acc=") print_int(acc.num) print("/") print_int(acc.den)
    print(" (correct would be 1048576/1)\n")
}
