// Defect B — minimal repro: multimodule native thin-link write failure (rc=12) on Madaros.
// `math::rational` ALONE compiles; `algebra::cayley_dickson::cd_sigma` ALONE compiles; importing
// BOTH (two modules) fails the compact-IR ELF thin-link writer. Inlining cd_sigma (→ a single
// `math::rational` import) is the only known workaround. See #651 root-cause dispatch:
// docs/audit/HYPERCOMPLEX_651_ROOTCAUSE_2026-07-14.md
//   ./bin/souc compile docs/handoff/repros/multimodule_thinlink_rc12_madaros.sio -o /tmp/x
//   -> error: multimodule native thin-link compilation failed  (compact IR ELF write failed; rc=1)
use algebra::cayley_dickson::{cd_sigma}
use math::rational::{Rational, rat_one}
fn main() with IO, Mut, Panic, Div {
    let r = rat_one()
    print_int(cd_sigma(3, 6, 4) as i64)
    print_int(r.num)
    print("\n")
}
