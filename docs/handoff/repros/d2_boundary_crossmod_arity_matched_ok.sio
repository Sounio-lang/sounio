//@ run-pass
// D2 boundary control B (main half): cross-module, matching arity (3-param
// calling 3-param). Does NOT segfault -- proves the trigger is specifically
// the ARITY MISMATCH between caller and callee aggregate-by-value
// functions when crossing a module boundary, not cross-module calls per se.

use d2_lib_arity_matched::{make_one, add3_wrap}

fn main() -> i32 with IO, Mut, Panic, Div {
    let a = make_one(4)
    let b = make_one(4)
    let c = make_one(4)
    let r = add3_wrap(a, b, c)
    println("done")
    print_int(r.c[0])
    0
}
