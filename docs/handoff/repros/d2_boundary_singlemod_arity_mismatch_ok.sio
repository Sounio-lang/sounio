//@ run-pass
// D2 boundary control A: IDENTICAL arity-mismatch shape as
// d2_main_crossmod_arity_mismatch_segv.sio, but all-in-ONE module (no `use`).
// Does NOT segfault -- proves the trigger is cross-module linking, not the
// arity mismatch alone.

pub struct S {
    c: [i64; 16],
    bits: i32,
}

pub fn make_zero(k: i32) -> S with Mut, Panic {
    S { c: [0; 16], bits: k }
}

pub fn make_one(k: i32) -> S with Mut, Panic {
    var r = S { c: [0; 16], bits: k }
    r.c[0] = 1
    r
}

pub fn add2(a: S, b: S) -> S with Mut, Panic, Div {
    var r = make_zero(a.bits)
    var i: i32 = 0
    while i < 16 { r.c[i as usize] = a.c[i as usize] + b.c[i as usize]; i = i + 1 }
    r
}

pub fn add3(a: S, b: S, c: S) -> S with Mut, Panic, Div {
    let ab = add2(a, b)
    add2(ab, c)
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let a = make_one(4)
    let b = make_one(4)
    let c = make_one(4)
    let r = add3(a, b, c)
    println("done")
    print_int(r.c[0])
    0
}
