//@ run-pass
// D5 (CONFIRMED repro): a `while` loop that reassigns a loop-carried mutable var based on the result
// of a guard FUNCTION that reads a GLOBAL and does DIVISION mis-compiles under souc v0.80.0 -- the
// call clobbers the carried var. p should go 10 -> 100 -> 1000 -> 10000; instead it collapses to 0
// after k=2. Output observed: k=1 p=10, k=2 p=100, k=3 p=0, k=4 p=0.
let I64_MAX: i64 = 9223372036854775807
fn iabs(a: i64) -> i64 { if a < 0 { 0 - a } else { a } }
fn mul_ovf(a: i64, b: i64) -> bool with Mut, Panic, Div {
    if a == 0 || b == 0 { return false }
    iabs(a) > I64_MAX / iabs(b)          // GLOBAL read + DIVISION -- part of the trigger
}
fn main() with IO, Mut, Panic, Div {
    var p: i64 = 10
    var k = 1
    while k <= 4 {
        print("k="); print_int(k); print(" p="); print_int(p); print("\n")
        if mul_ovf(p, 10) { p = 0 } else { p = p * 10 }
        k = k + 1
    }
}
