//@ run-pass
// D7 (REGRESSION on main's stage2 souc): data-carrying enum variants are rejected. The current
// compiler reports the field name as an UNDEFINED VARIABLE (E200) at the construction site.
//   Under the CI stage2 souc:  E200 `eps` at line 4  -> typecheck failed -> no ELF -> "run exited 1".
//   Under the committed bin/souc (older): compiles + runs fine (3 lines, exit 0).
// So this is a regression between the committed prebuilt and the current self-hosted source.
enum V { P, M { eps: f64 } }
fn mk(e: f64) -> V { V::M { eps: e } }              // <- E200 `eps` here on stage2
fn use_it(v: V) -> bool { match v { V::P => true, V::M { .. } => false } }
fn main() -> i32 with IO { if use_it(mk(1.0)) { println("m") } else { println("p") } 0 }
