// Repro for BLK-20260806-madaros-trait-i64-method-lower
// Madaros: check OK, native lower SIGSEGV. lean_single: prints ER_TRAIT_I64_OK.
trait ExactRing {
    fn er_add(self, o: Self) -> Self with Mut, Div, Panic
}

impl ExactRing for i64 {
    fn er_add(self, o: Self) -> Self with Mut, Div, Panic { self + o }
}

fn main() with IO, Mut, Div, Panic {
    let a: i64 = 2
    let s = a.er_add(3)
    assert(s == 5)
    println("ER_TRAIT_I64_OK")
}
