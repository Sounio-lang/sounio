//@ run-fail
// D4 repro: two structurally-mirrored match functions over one data-carrying
// enum, in the same module. `requires_proof` gives the correct truth table;
// its mirror-image sibling `is_measurement` returns the WRONG answer for
// MeasuredF64 (should be true, comes back false).
//
// NOTE: `if f(Verdict::MeasuredF64 { eps: 1.0 })` PARSE-FAILS (brace
// ambiguity with the `if` block). Values are constructed via a separate
// constructor fn and bound with `let` first, per the caution in the task.

enum Verdict {
    Proved,
    MeasuredF64 { eps: f64 },
    MeasuredF256 { eps256: f64 },
}

fn make_measured_f64(e: f64) -> Verdict {
    Verdict::MeasuredF64 { eps: e }
}

/// Truth table: true only for Proved.
fn requires_proof(v: Verdict) -> bool {
    match v {
        Verdict::Proved => true,
        Verdict::MeasuredF64 { eps } => false,
        Verdict::MeasuredF256 { eps256 } => false,
    }
}

/// Mirror-image truth table: true only for MeasuredF64. Structurally the
/// same match, just permuted arms and negated results.
fn is_measurement(v: Verdict) -> bool {
    match v {
        Verdict::Proved => false,
        Verdict::MeasuredF64 { eps } => true,
        Verdict::MeasuredF256 { eps256 } => false,
    }
}

fn main() with IO {
    let v = make_measured_f64(1.0)

    let rp = requires_proof(v)
    // NB: `v` already moved into requires_proof above under this compiler's
    // move semantics for enum values, so build a second, fresh instance for
    // the second call rather than reusing `v`.
    let v2 = make_measured_f64(1.0)
    let im = is_measurement(v2)

    println("requires_proof(MeasuredF64) [expect false]:")
    if rp { println("true") } else { println("false") }

    println("is_measurement(MeasuredF64) [expect true]:")
    if im { println("true") } else { println("false") }
}
