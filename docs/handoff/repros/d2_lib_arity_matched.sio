//@ run-pass
// D2 boundary control B (library half): same cross-module shape, but the
// 3-struct-param fn (add3_wrap) delegates to ANOTHER 3-struct-param fn
// (add3) -- matching arity. Does NOT segfault.

pub struct S {
    c: [i64; 16],
    bits: i32,
}

pub fn make_one(k: i32) -> S with Mut, Panic {
    var r = S { c: [0; 16], bits: k }
    r.c[0] = 1
    r
}

pub fn add3(a: S, b: S, c: S) -> S with Mut, Panic, Div {
    var r = S { c: [0; 16], bits: a.bits }
    var i: i32 = 0
    while i < 16 { r.c[i as usize] = a.c[i as usize] + b.c[i as usize] + c.c[i as usize]; i = i + 1 }
    r
}

pub fn add3_wrap(a: S, b: S, c: S) -> S with Mut, Panic, Div {
    add3(a, b, c)
}
