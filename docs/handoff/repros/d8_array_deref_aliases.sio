// D8 repro: `var x = *arr` on a `&[u8;4]` reference aliases the caller's
// array rather than copying it. Expected (correct value semantics):
// prints 99 then 1 (mutating x should not affect the caller's original).
// Observed (buggy, confirmed 2026-08-25 on Madaros v0.80.0): prints 99
// then 99 -- `original[0]` was silently corrupted.
fn mutate_alias(arr: &[u8;4]) -> u8 {
    var x = *arr
    x[0] = 99
    return x[0]
}

fn main() -> i64 with IO {
    var original: [u8;4] = [1, 2, 3, 4]
    let r = mutate_alias(&original)
    print_int(r as i64)
    print_int(original[0] as i64)
    return 0
}
