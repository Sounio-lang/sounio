// LANDING KIT for #651 — the F=Rational acceptance test, staged and ready.
// Kept in docs/handoff/repros/ (NOT tests/run-pass/, which CI globs) because it is RED at runtime
// until #651 lands: cd_mul_exact<Rational> miscompiles today. It COMPILES cleanly now (the defect is
// runtime), so this file is type-checked and waiting. The moment #651 is fixed, promote it verbatim to
// tests/run-pass/cd_exact_rational.sio and wire it into scripts/ci/sedenion_zd168_crosscheck_gate.sh.
//
// Cross-verified expected values come from the INDEPENDENT oracle scripts/research/cd16_oracle.py
// (Python fractions, run on a different toolchain):
//   * canonical pair (e3+e10)(e6-e15) over ℚ  → all 16 components 0/1 (ANNIHILATES) [oracle case 1]
//   * e1 * e1 over ℚ                           → c[0] = -1/1
// (The genuinely-fractional case — oracle case 2, a=(1/2)e1+(1/3)e2, b=(1/5)e4+(1/7)e8 → den 210,
//  comps at k=5,6,9,10 — needs a public `cd_with_exact<F>(k,idx,val,zero)` setter to build fractional
//  coefficients; add that helper together with the #651 fix, atop merged #652.)
//
// This is the same integer-coefficient locus the F=i64 engine already proves (cd_exact_generic_i64.sio),
// re-run over F=Rational: identical annihilation, now with rational bookkeeping. Byte-comparing the two
// is the "generic engine is field-agnostic" guarantee.
use algebra::cayley_dickson_exact::{
    cd_basis_exact, cd_add_exact, cd_sub_exact, cd_mul_exact, cd_is_zero_exact,
}
use math::rational::{Rational, rat_zero, rat_one, rat_make, rat_eq}

fn main() with IO, Mut, Panic, Div {
    let k: i32 = 4
    let z = rat_zero()
    let o = rat_one()

    // a = e3 + e10, b = e6 - e15  (integer coefficients as rationals, den = 1)
    let e3 = cd_basis_exact::<Rational>(k, 3, z, o)
    let e10 = cd_basis_exact::<Rational>(k, 10, z, o)
    let a = cd_add_exact::<Rational>(e3, e10, z)
    let e6 = cd_basis_exact::<Rational>(k, 6, z, o)
    let e15 = cd_basis_exact::<Rational>(k, 15, z, o)
    let b = cd_sub_exact::<Rational>(e6, e15, z)

    // The headline: exact annihilation over ℚ (decidable rational equality, no tolerance).
    let prod = cd_mul_exact::<Rational>(a, b, z)
    if cd_is_zero_exact::<Rational>(prod) { println("RAT-ZD PROVED") } else { println("RAT-ZD FAIL") }

    // Control: e1 * e1 == -1/1 over ℚ.
    let e1 = cd_basis_exact::<Rational>(k, 1, z, o)
    let sq = cd_mul_exact::<Rational>(e1, e1, z)
    let neg1 = rat_make(0 - 1, 1)
    if rat_eq(sq.c[0 as usize], neg1) { println("RAT-SQ PASS") } else { println("RAT-SQ FAIL") }

    // Cross-check emission: all 16 components of the canonical product, as num/den.
    // Every line must be "RCOMP <k> 0/1" to match oracle case 1 element-wise.
    var i: i32 = 0
    while i < 16 {
        print("RCOMP ")
        print_int(i as i64)
        print(" ")
        print_int(prod.c[i as usize].num)
        print("/")
        print_int(prod.c[i as usize].den)
        print("\n")
        i = i + 1
    }
}
