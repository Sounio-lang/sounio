//@ run-fail
// D4 isolation test: does the flake require BOTH match functions present
// (an interaction bug), or does `is_measurement` alone still misbehave?
// This file has ONLY `is_measurement` -- no `requires_proof` defined anywhere
// in the module.

enum Verdict {
    Proved,
    MeasuredF64 { eps: f64 },
    MeasuredF256 { eps256: f64 },
}

fn make_measured_f64(e: f64) -> Verdict {
    Verdict::MeasuredF64 { eps: e }
}

fn is_measurement(v: Verdict) -> bool {
    match v {
        Verdict::Proved => false,
        Verdict::MeasuredF64 { eps } => true,
        Verdict::MeasuredF256 { eps256 } => false,
    }
}

fn main() with IO {
    let v = make_measured_f64(1.0)
    let im = is_measurement(v)
    println("is_measurement(MeasuredF64) alone in module [expect true]:")
    if im { println("true") } else { println("false") }
}
