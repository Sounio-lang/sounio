//@ run-pass
// SPIKE: does souc support fn returning a generic struct parameterized by F,
// with a by-value [F; N] array field? This is exactly what cd_mul_exact<F> needs.

struct CDExact<F> {
    c: [F; 4],
    bits: i64,
}

// The load-bearing shape: a function whose RETURN type is CDExact<F>.
fn cd_add<F>(a: CDExact<F>, b: CDExact<F>) -> CDExact<F> {
    var out = CDExact { c: a.c, bits: a.bits }
    out
}

fn main() with IO {
    let a = CDExact { c: [1, 2, 3, 4], bits: 4 }
    let b = CDExact { c: [5, 6, 7, 8], bits: 4 }
    let r = cd_add::<i64>(a, b)
    println(r.c[0])
    println("spike PASS")
}
