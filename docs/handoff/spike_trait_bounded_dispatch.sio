//@ run-pass
// SPIKE: minimal repro for compiler prerequisite #3 (trait-bounded generic method
// dispatch). DEPENDS on #2 (bodyless-trait-method parsing + impl Trait for Type,
// see docs/handoff/compiler_impl_trait_for_type_fix_prompt.md and
// docs/handoff/spike_impl_trait_for_type.sio) landing first — this spike fails at
// the identical `impl R for i64 {` parse site as #2's own spike, so #3 cannot even
// be attempted in isolation today.
//
// Confirmed failing on souc v0.80.0, 2026-07-05 (worktree coord/exact-algebra-core):
//   ./bin/souc run docs/handoff/spike_trait_bounded_dispatch.sio
// (rc is not meaningful; read stdout) gives, as the first real error:
//   parse error: expected token at line 22:8 (the `for` on `impl R for i64 {`),
//   expected=184 actual=23 -- the exact same failure class as #2's spike, just
//   against a builtin type name (i64) instead of a user struct. (A second error also
//   fires at the trait's own closing brace, line 20 -- that is Bug A from #2, the
//   bodyless-trait-method-signature bug; it needs #2's fix too.)
//
// Once #2 lands, re-run this spike: if it STILL fails, the remaining error is #3's
// to fix — trait-bound parsing on `fn use2<F: R>(...)`, and/or resolving
// `a.radd(b)` to the concrete `impl R for i64` inside the monomorphized body.
// Document whatever NEW failure appears at that point before starting the fix —
// it cannot be predicted exactly until #2's grammar is in place (see the task
// prompt, §2).

trait R {
    fn radd(self, o: Self) -> Self
}

impl R for i64 {
    fn radd(self, o: Self) -> Self { self + o }
}

fn use2<F: R>(a: F, b: F) -> F {
    a.radd(b)
}

fn main() with IO {
    let r = use2::<i64>(2, 3)
    println(r)          // expect 5
    println("spike PASS")
}
