module mm::ts
pub struct FPair { pub hi: f64, pub lo: f64 }
pub struct IPair { pub hi: i64, pub lo: i64 }
pub fn ftsum(a: f64, b: f64) -> FPair { let s = a + b  let bb = s - a  let e = (a - (s - bb)) + (b - bb)  FPair { hi: s, lo: e } }
pub fn itsum(a: i64, b: i64) -> IPair { let s = a + b  IPair { hi: s, lo: a } }
