use mm::ts::*
fn main() -> i32 with IO, Mut, Div, Panic {
    let ip = itsum(2, 3)
    if ip.hi == 5 { println("i64 imported hi OK") } else { println("i64 imported hi WRONG") }
    let fp = ftsum(2.0, 3.0)
    if fp.hi == 5.0 { println("f64 imported hi OK") } else { println("f64 imported hi WRONG") }
    if fp.hi == fp.lo { println("  hi==lo (got lo's value)") }
    if fp.hi == 0.0 { println("  hi==0 (zeroed)") }
    if fp.hi == 2.0 { println("  hi==2.0 (got a)") }
    if fp.hi == 3.0 { println("  hi==3.0 (got b)") }
    0
}
