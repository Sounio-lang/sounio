// validated_lane: lean_single
// WP-B1 witness (W1): minimal repro of the EISA default-lane blocker.
//
// main imports ONLY depclosure_str_a. depclosure_str_a uses depclosure_str_b.
// depclosure_str_b uses str::lib::* and calls str_to_string (which calls the
// builtin str_from_bytes, stdlib/str/lib.sio:87) — mirroring how eisa::isa
// reaches str::lib transitively.
//
// FINDING (2026-07-06, build-verified on main a08a0a737 AND base
// integration/continuity-mtrack): the WP-B1 brief's premise — a codegen
// dep-closure emitting str_from_bytes as ud2 -> SIGILL — is FALSIFIED. The
// module file dep-closure DOES load + merge str::lib. The real blocker is the
// Madaros MULTI-MODULE MERGED TYPE-CHECKER (check::mod::check_modules_verdict_
// boot4): it rejects str::lib's own i32/i64 integer-width mixing (E004 x48,
// plus E007/E008/E009/E012) before codegen is ever reached. There is no
// runtime SIGILL; the default lane never produces an ELF.
//
//   lean_single lane : rc 0 (lenient integer-width, PASS — this witness)
//   default (Madaros): BLOCKED at typecheck (E004 family in stdlib/str/lib.sio)
//
// This is a check.sio issue (out of the module_loader/module_frontend scope
// the WP named) and shares the merged-check path with WP-A6. See
// wp-b1-witness/README.md for the full error inventory.
use depclosure_str_a::{depa_probe}

fn main() -> i64 with IO, Mut, Div, Panic {
    let v = depa_probe()
    if v == 5 { 0 } else { 1 }
}
