// validated_lane: lean_single
// WP-B1 witness (W1) leaf module: uses str::lib and calls str_to_string.
// str_to_string -> str_from_bytes (builtin). This is the transitive body that
// the imported-lane closure must pull even though no ancestor imports str::lib
// directly.
use str::lib::*

fn depb_probe() -> i64 with Mut, Div, Panic {
    let s = str_from_literal("hello")
    let g = str_to_string(s)
    // Count chars of the round-tripped builtin string via the builtin
    // str_char_at (not shadowed by str::lib, which only defines str_char_at_s).
    var n: i64 = 0
    var i: i64 = 0
    while i < 256 {
        let ch = str_char_at(g, i)
        if ch <= 0 { i = 256 } else { n = n + 1; i = i + 1 }
    }
    n
}

fn main() -> i64 with Mut, Div, Panic {
    if depb_probe() == 5 { 0 } else { 1 }
}
