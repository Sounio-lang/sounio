% neurips_2026.sty - Minimal NeurIPS 2026 style file
% Based on NeurIPS formatting guidelines
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{neurips_2026}[2026/01/01 NeurIPS 2026 style]

\DeclareOption{final}{\relax}
\DeclareOption{preprint}{\relax}
\DeclareOption{nonatbib}{\relax}
\ProcessOptions\relax

\RequirePackage[margin=1in]{geometry}
\RequirePackage{times}

% Page layout
\setlength{\parindent}{0pt}
\setlength{\parskip}{6pt}

% Title formatting
\renewcommand{\maketitle}{%
  \begin{center}%
    {\LARGE\bfseries \@title \par}%
    \vskip 1.5em%
    {\large \@author \par}%
    \vskip 1em%
    {\large \@date \par}%
  \end{center}%
  \vskip 2em%
}
