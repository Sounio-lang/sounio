use collections::numeric_buffer::{numeric_buffer_new,numeric_buffer_set,numeric_buffer_at,numeric_buffer_close}
use physics::phonon_factor::*
fn log(label:string,x:i64) with IO {print(label);print(" ");print_int(x);println("")}
fn main()->i32 with Alloc,IO,Mut,Div,Panic {
 var values=numeric_buffer_new(1,8)
 var factor=numeric_buffer_new(16,128)
 var i:i64=0;while i<16 {numeric_buffer_set(&!factor,i,0.0);i=i+1}
 numeric_buffer_set(&!values,0,1.0);numeric_buffer_set(&!factor,0,0.1)
 var p=phonon_default_si_params()
 p.d_eff=0.0;p.dx=1.0;p.k_release=1.0;p.cl_site=0.0;p.v_blood=0.0;p.c_tissue=0.0;p.c_portal=0.0;p.c_ha=0.0;p.zonation=1.0
 log("PSTATUS",phonon_params_status(&p))
 var state=phonon_from_factor(values,factor,p,1,0.0)
 log("STATUS",phonon_state_status(&state));log("N",phonon_state_n(&state));log("K",phonon_state_rank(&state));
 assert(phonon_state_status(&state)==0)
 var rhs=numeric_buffer_new(1,8)
 var jac=numeric_buffer_new(15,120)
 let jc=phonon_rhs_jacobian_checked(&state,0.0,&!rhs,&!jac);log("JC",jc);log("RHS",f64_to_bits(numeric_buffer_at(&rhs,0)));log("JAC",f64_to_bits(numeric_buffer_at(&jac,2)));assert(jc==0)
 assert(numeric_buffer_at(&rhs,0)==-1.0)
 assert(numeric_buffer_at(&jac,2)==-1.0)
 var scratch=numeric_buffer_new(10,80)
 println("BEFORE_RHS0");let a=diagnostic_rhs(&state,&!scratch,0.0,0,false);log("AFTER_RHS0",a);assert(a==0)
 println("BEFORE_TRIAL0");let b=diagnostic_trial(&state,&!scratch,0.01,0);log("AFTER_TRIAL0",b);assert(b==0)
 println("BEFORE_RHS1");let c=diagnostic_rhs(&state,&!scratch,0.005,1,true);log("AFTER_RHS1",c);assert(c==0)
 println("BEFORE_TRIAL1");let d=diagnostic_trial(&state,&!scratch,0.01,1);log("AFTER_TRIAL1",d);assert(d==0)
 println("BEFORE_RHS2");let e=diagnostic_rhs(&state,&!scratch,0.005,2,true);log("AFTER_RHS2",e);assert(e==0)
 println("BEFORE_TRIAL2");let f=diagnostic_trial(&state,&!scratch,0.01,2);log("AFTER_TRIAL2",f);assert(f==0)
 println("BEFORE_RHS3");let g=diagnostic_rhs(&state,&!scratch,0.01,3,true);log("AFTER_RHS3",g);assert(g==0)
 println("BEFORE_TRIAL3");let h=diagnostic_trial(&state,&!scratch,0.01,3);log("AFTER_TRIAL3",h);assert(h==0)
 log("CANDIDATE_MEAN",f64_to_bits(numeric_buffer_at(&scratch,8)));log("CANDIDATE_S",f64_to_bits(numeric_buffer_at(&scratch,9)))
 phonon_close(state);numeric_buffer_close(rhs);numeric_buffer_close(jac);numeric_buffer_close(scratch)
 println("ALL_PHASE_HELPERS_PASS");0
}
