use collections::numeric_buffer::{numeric_buffer_new,numeric_buffer_set,numeric_buffer_at,numeric_buffer_close}
use physics::phonon_factor::*
fn main()->i32 with Alloc,IO,Mut,Div,Panic {
 var values=numeric_buffer_new(3,24)
 numeric_buffer_set(&!values,0,0.7);numeric_buffer_set(&!values,1,1.1);numeric_buffer_set(&!values,2,0.2)
 let factor=numeric_buffer_new(0,0)
 let p=PhononParams{d_eff:0.03,dx:0.4,k_release:0.2,cl_site:0.1,fu:0.3,kp:2.0,c_portal:0.9,c_ha:1.2,f_heart:0.8,a_portal:0.2,a_ha:-0.3,phi_ha:0.4,c_tissue:0.5,v_blood:0.1,zonation:2.0}
 let state=phonon_from_factor(values,factor,p,0,0.37)
 assert(phonon_state_status(&state)==0)
 var rhs=numeric_buffer_new(3,24)
 var jac=numeric_buffer_new(45,360)
 assert(phonon_rhs_jacobian_checked(&state,0.37,&!rhs,&!jac)==0)
 var i:i64=0
 while i<3 {
  print("PHONON_VALUE rhs.");print_int(i);print(" ");print_int(f64_to_bits(numeric_buffer_at(&rhs,i)));println("")
  var j:i64=0
  while j<15 {print("PHONON_VALUE jac.");print_int(i);print(".");print_int(j);print(" ");print_int(f64_to_bits(numeric_buffer_at(&jac,i*15+j)));println("");j=j+1}
  i=i+1
 }
 phonon_close(state);numeric_buffer_close(rhs);numeric_buffer_close(jac)
 println("PHONON_JACOBIAN_PASS");0
}
