use collections::numeric_buffer::{NumericBuffer,numeric_buffer_new,numeric_buffer_set,numeric_buffer_at,numeric_buffer_close}
pub linear struct PhononOwnerProbe {values:NumericBuffer,factor:NumericBuffer,n:i64}
fn make(values:NumericBuffer,factor:NumericBuffer)->PhononOwnerProbe {PhononOwnerProbe{values:values,factor:factor,n:1}}
fn set_first(s:&!PhononOwnerProbe)->i64 with Mut {numeric_buffer_set(&!s.values,0,2.0)}
fn get_first(s:&PhononOwnerProbe)->f64 with Panic {numeric_buffer_at(&s.values,0)}
fn close(s:PhononOwnerProbe) with Alloc {let PhononOwnerProbe{values,factor,n}=s;numeric_buffer_close(values);numeric_buffer_close(factor)}
fn main()->i32 with Alloc,IO,Mut,Div,Panic {
 let values=numeric_buffer_new(1,8)
 let factor=numeric_buffer_new(16,128)
 var state=make(values,factor)
 assert(set_first(&!state)==0)
 assert(get_first(&state)==2.0)
 close(state)
 println("PHONON_NESTED_OWNER_PASS");0
}
