use collections::numeric_buffer::{numeric_buffer_get}

pub fn diagnostic_step_trace(s:&!PhononState,scratch:&!NumericBuffer,h:f64)->PhononResult with IO,Mut,Div,Panic {
 println("STEP_ENTRY")
 var out=ph_result(s,s.status)
 if s.status!=0 {return out}
 if !is_finite(h) {out.status=1;return out}
 if h<=0.0 {out.status=2;return out}
 let shape=phonon_workspace(s.n,s.k)
 if numeric_buffer_status(scratch)!=0||numeric_buffer_len(scratch)<shape.scratch_len {out.status=3;return out}
 let next=s.t+h
 if !is_finite(next) {out.status=4;return out}
 if next<=s.t {out.status=6;return out}
 println("STEP_PRE_LIMIT")
 let limit=ph_limit(s)
 if limit.status!=0 {out.status=limit.status;return out}
 if h>limit.value {out.status=2;return out}
 println("STEP_PRE_RHS0")
 var code=ph_rhs_stage(s,scratch,s.t,0,false)
 println("STEP_POST_RHS0")
 out.nfeval=1
 if code!=0 {out.status=code;return out}
 println("STEP_PRE_TRIAL0")
 code=ph_trial(s,scratch,h,0)
 if code!=0 {out.status=code;return out}
 println("STEP_PRE_RHS1")
 code=ph_rhs_stage(s,scratch,s.t+0.5*h,1,true)
 println("STEP_POST_RHS1")
 out.nfeval=2
 if code!=0 {out.status=code;return out}
 println("STEP_PRE_TRIAL1")
 code=ph_trial(s,scratch,h,1)
 if code!=0 {out.status=code;return out}
 println("STEP_PRE_RHS2")
 code=ph_rhs_stage(s,scratch,s.t+0.5*h,2,true)
 println("STEP_POST_RHS2")
 out.nfeval=3
 if code!=0 {out.status=code;return out}
 println("STEP_PRE_TRIAL2")
 code=ph_trial(s,scratch,h,2)
 if code!=0 {out.status=code;return out}
 println("STEP_PRE_RHS3")
 code=ph_rhs_stage(s,scratch,next,3,true)
 println("STEP_POST_RHS3")
 out.nfeval=4
 if code!=0 {out.status=code;return out}
 println("STEP_PRE_TRIAL3")
 code=ph_trial(s,scratch,h,3)
 if code!=0 {out.status=code;return out}
 println("STEP_PRE_COMMIT")
 // Commit only after the entire candidate is finite and concentrations >=0.
 let width:i64=s.k+1
 let offset:i64=4*s.n*width
 print("META n=");print_int(s.n);print(" k=");print_int(s.k);print(" getter_n=");print_int(phonon_state_n(s));print(" getter_k=");print_int(phonon_state_rank(s));println("")
 print("META width=");print_int(width);print(" offset=");print_int(offset);print(" scratchlen=");print_int(numeric_buffer_len(scratch));print(" valueslen=");print_int(numeric_buffer_len(&s.values));print(" factorlen=");print_int(numeric_buffer_len(&s.factor));println("")
 let g0=numeric_buffer_get(scratch,offset)
 print("GET0 status=");print_int(g0.status);print(" value=");print_int(f64_to_bits(g0.value));println("")
 let g1=numeric_buffer_get(scratch,offset+1)
 print("GET1 status=");print_int(g1.status);print(" value=");print_int(f64_to_bits(g1.value));println("")
 var i:i64=0
 while i<s.n {
  numeric_buffer_set(&!s.values,i,numeric_buffer_at(scratch,offset+i*width))
  var col:i64=0
  while col<s.k {numeric_buffer_set(&!s.factor,i*s.k+col,numeric_buffer_at(scratch,offset+i*width+col+1));col=col+1}
  i=i+1
 }
 println("STEP_POST_COMMIT")
 s.t=next;out.status=0;out.t_final=next;out.steps=1;out
}

pub fn diagnostic_step_scalar(s:&!PhononState,scratch:&!NumericBuffer,h:f64)->i64 with Mut,Div,Panic {
 var out=ph_result(s,s.status)
 if s.status!=0 {return out.status}
 if !is_finite(h) {out.status=1;return out.status}
 if h<=0.0 {out.status=2;return out.status}
 let shape=phonon_workspace(s.n,s.k)
 if numeric_buffer_status(scratch)!=0||numeric_buffer_len(scratch)<shape.scratch_len {out.status=3;return out.status}
 let next=s.t+h
 if !is_finite(next) {out.status=4;return out.status}
 if next<=s.t {out.status=6;return out.status}
 let limit=ph_limit(s)
 if limit.status!=0 {out.status=limit.status;return out.status}
 if h>limit.value {out.status=2;return out.status}
 var code=ph_rhs_stage(s,scratch,s.t,0,false)
 out.nfeval=1
 if code!=0 {out.status=code;return out.status}
 code=ph_trial(s,scratch,h,0)
 if code!=0 {out.status=code;return out.status}
 code=ph_rhs_stage(s,scratch,s.t+0.5*h,1,true)
 out.nfeval=2
 if code!=0 {out.status=code;return out.status}
 code=ph_trial(s,scratch,h,1)
 if code!=0 {out.status=code;return out.status}
 code=ph_rhs_stage(s,scratch,s.t+0.5*h,2,true)
 out.nfeval=3
 if code!=0 {out.status=code;return out.status}
 code=ph_trial(s,scratch,h,2)
 if code!=0 {out.status=code;return out.status}
 code=ph_rhs_stage(s,scratch,next,3,true)
 out.nfeval=4
 if code!=0 {out.status=code;return out.status}
 code=ph_trial(s,scratch,h,3)
 if code!=0 {out.status=code;return out.status}
 // Commit only after the entire candidate is finite and concentrations >=0.
 let width=s.k+1
 let offset=4*s.n*width
 var i:i64=0
 while i<s.n {
  numeric_buffer_set(&!s.values,i,numeric_buffer_at(scratch,offset+i*width))
  var col:i64=0
  while col<s.k {numeric_buffer_set(&!s.factor,i*s.k+col,numeric_buffer_at(scratch,offset+i*width+col+1));col=col+1}
  i=i+1
 }
 s.t=next;out.status=0;out.t_final=next;out.steps=1;out.status
}
