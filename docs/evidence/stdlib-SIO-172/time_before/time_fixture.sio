use collections::numeric_buffer::{NumericBuffer,numeric_buffer_new,numeric_buffer_set,numeric_buffer_close}
use physics::phonon_factor::*
fn zeros(n:i64)->NumericBuffer with Alloc,Mut,Div,Panic {var b=numeric_buffer_new(n,n*8);var i:i64=0;while i<n {numeric_buffer_set(&!b,i,0.0);i=i+1};b}
fn emit(name:string,x:f64) with IO {print("PHONON_VALUE ");print(name);print(" ");print_int(f64_to_bits(x));println("")}
fn main()->i32 with Alloc,IO,Mut,Div,Panic {
 var values=zeros(1);numeric_buffer_set(&!values,0,1.0);let factor=zeros(0)
 let p=PhononParams{d_eff:0.0,dx:1.0,k_release:1e15,cl_site:0.0,fu:0.0,kp:1.0,c_portal:0.0,c_ha:0.0,f_heart:0.0,a_portal:0.0,a_ha:0.0,phi_ha:0.0,c_tissue:0.0,v_blood:0.0,zonation:1.0}
 var state=phonon_from_factor(values,factor,p,0,1.0);var scratch=zeros(5)
 let r=phonon_step_checked(&!state,&!scratch,3e-16)
 emit("time.before.status",r.status as f64);emit("time.before.time",phonon_state_time(&state))
 let x=phonon_concentration(&state,0);assert(x.status==0);emit("time.before.mean",x.value)
 phonon_close(state);numeric_buffer_close(scratch);println("PHONON_TIME_BEFORE_WITNESS");0
}
