use data::bigframe::*
use data::bigframe_ops::*
fn main()->i32 with IO,Mut,Div,Panic,Alloc {
 var gsf=bf_new(2,16)
 var gsi:i64=0
 while gsi<100000 {var gsr:[f64;64]=[0.0;64];gsr[0]=(gsi%1000) as f64;gsr[1]=gsi as f64;bf_push_row(&!gsf,&gsr,2);gsi=gsi+1}
 let gs=bf_rolling_sum_by(&gsf,0,1,3,0.0-1.0)
 let gm=bf_rolling_mean_by(&gsf,0,1,3,0.0-1.0)
 assert(bf_get(&gs,3000,0)==6000.0)
 assert(bf_get(&gm,3000,0)==2000.0)
 println("BEFORE_GROUPED_ROLLING_MAX")
 let gmx=bf_rolling_max_by(&gsf,0,1,3,0.0-1.0)
 println("AFTER_GROUPED_ROLLING_MAX")
 let gmn=bf_rolling_min_by(&gsf,0,1,3,0.0-1.0)
 assert(bf_get(&gmx,1000,0)==0.0-1.0)
 assert(bf_get(&gmx,2000,0)==2000.0)
 assert(bf_get(&gmn,2000,0)==0.0)
 assert(bf_get(&gmn,3000,0)==1000.0)
 println("GROUPED_ROLLING_EXTREME_COMPONENT_OK")
 0
}
