use stats::power::{power_ttest_onesample,power_ttest_twosample}
fn main()->i32 with IO,Mut,Div,Panic {
 let p0=power_ttest_onesample(5.00000000000000000e-01,2,5.00000000000000028e-02,true)
 let b0:i64=f64_to_bits(p0)
 print("LROW 0 ");println(b0)
 let p1=power_ttest_onesample(8.00000000000000044e-01,2,5.00000000000000028e-02,true)
 let b1:i64=f64_to_bits(p1)
 print("LROW 1 ");println(b1)
 let p2=power_ttest_onesample(5.00000000000000000e-01,34,5.00000000000000028e-02,true)
 let b2:i64=f64_to_bits(p2)
 print("LROW 2 ");println(b2)
 let p3=power_ttest_twosample(5.00000000000000000e-01,64,5.00000000000000028e-02,true)
 let b3:i64=f64_to_bits(p3)
 print("LROW 3 ");println(b3)
 let p4=power_ttest_onesample(-5.00000000000000000e-01,34,5.00000000000000028e-02,true)
 let b4:i64=f64_to_bits(p4)
 print("LROW 4 ");println(b4)
 let p5=power_ttest_onesample(5.00000000000000000e-01,10,5.00000000000000028e-02,false)
 let b5:i64=f64_to_bits(p5)
 print("LROW 5 ");println(b5)
 let p6=power_ttest_onesample(-5.00000000000000000e-01,10,5.00000000000000028e-02,false)
 let b6:i64=f64_to_bits(p6)
 print("LROW 6 ");println(b6)
 let p7=power_ttest_onesample(0.00000000000000000e+00,50,5.00000000000000028e-02,true)
 let b7:i64=f64_to_bits(p7)
 print("LROW 7 ");println(b7)
 let p8=power_ttest_twosample(1.00000000000000000e+00,60,5.00000000000000028e-02,true)
 let b8:i64=f64_to_bits(p8)
 print("LROW 8 ");println(b8)
 let p9=power_ttest_onesample(2.00000000000000011e-01,100,5.00000000000000028e-02,false)
 let b9:i64=f64_to_bits(p9)
 print("LROW 9 ");println(b9)
 let p10=power_ttest_onesample(-2.00000000000000011e-01,100,5.00000000000000028e-02,false)
 let b10:i64=f64_to_bits(p10)
 print("LROW 10 ");println(b10)
 let p11=power_ttest_onesample(1.00000000000000006e-01,3,5.00000000000000028e-02,true)
 let b11:i64=f64_to_bits(p11)
 print("LROW 11 ");println(b11)
 println("LEGACY_POWER_COMPLETE 12")
 0
}
