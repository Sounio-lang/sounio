   while k<4 {digest=(digest*131+integer_buffer_at(&counts,ib+k))%1000000007;k=k+1}
   let term=numeric_buffer_at(&curves,nb+1)-mass_c;let next=mass+term;mass_c=(next-mass)-term;mass=next
   println("CURVE {} {} {} {} {} {} {} {} {} {} {} {} {} {} {}",id,ri,g,integer_buffer_at(&counts,ib),integer_buffer_at(&counts,ib+1),integer_buffer_at(&counts,ib+2),integer_buffer_at(&counts,ib+3),bit(numeric_buffer_at(&curves,nb)),bit(numeric_buffer_at(&curves,nb+1)),bit(numeric_buffer_at(&curves,nb+2)),bit(numeric_buffer_at(&curves,nb+3)),bit(numeric_buffer_at(&curves,nb+4)),bit(numeric_buffer_at(&curves,nb+5)),bit(numeric_buffer_at(&curves,nb+6)),bit(numeric_buffer_at(&curves,nb+7)))
   g=g+1
  }
  ri=ri+1
 }
 println("AGGREGATE {} {} {}",id,digest,bit(mass))
 numeric_buffer_close(times);integer_buffer_close(event);integer_buffer_close(group);integer_buffer_close(order);numeric_buffer_close(curves);integer_buffer_close(counts)
}
