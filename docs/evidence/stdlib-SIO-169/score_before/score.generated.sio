use collections::numeric_buffer::{numeric_buffer_new,numeric_buffer_at,numeric_buffer_set,numeric_buffer_close}
use collections::integer_buffer::{integer_buffer_new,integer_buffer_at,integer_buffer_set,integer_buffer_close}
use stats::checked_survival::{survival_workspace,survival_checked}
fn bit(x:f64)->i64 {f64_to_bits(x)}
fn yes(x:bool)->i64 {if x {1}else{0}}
fn row(id:i64) with IO,Alloc,Mut,Div,Panic {
 var n:i64=0
 if id==0 {n=100000}
 if id==1 {n=100000}
 if id==2 {n=1000000}
 if id==3 {n=1000000}
 if id==4 {n=100000}
 let q=survival_workspace(n,320000000)
 assert(q.status==0)
 var times=numeric_buffer_new(n,n*8);var event=integer_buffer_new(n,n*8);var group=integer_buffer_new(n,n*8)
 var order=integer_buffer_new(n,n*8);var curves=numeric_buffer_new(q.curve_len,q.curve_len*8);var counts=integer_buffer_new(q.count_len,q.count_len*8)
 var at:i64=0
 while at<n {
  numeric_buffer_set(&!times,at,if id==0 {((at*37)%997) as f64}else{((at*7919)%100000) as f64})
  integer_buffer_set(&!event,at,if id==0 && at%5==0 {0}else{1});integer_buffer_set(&!group,at,at%2)
  at=at+1
 }
 if id==2 {
  var i:i64=0
  while i<n {
   if i<3872 {numeric_buffer_set(&!times,i,1.00000000000000000e+00);integer_buffer_set(&!event,i,1)}
   else if i<99999 {numeric_buffer_set(&!times,i,1.00000000000000000e+00);integer_buffer_set(&!event,i,0)}
   else if i<102622 {numeric_buffer_set(&!times,i,2.00000000000000000e+00);integer_buffer_set(&!event,i,1)}
   else if i<199989 {numeric_buffer_set(&!times,i,2.00000000000000000e+00);integer_buffer_set(&!event,i,0)}
   else if i<203975 {numeric_buffer_set(&!times,i,3.00000000000000000e+00);integer_buffer_set(&!event,i,1)}
   else if i<299999 {numeric_buffer_set(&!times,i,3.00000000000000000e+00);integer_buffer_set(&!event,i,0)}
   else if i<302568 {numeric_buffer_set(&!times,i,4.00000000000000000e+00);integer_buffer_set(&!event,i,1)}
   else if i<499170 {numeric_buffer_set(&!times,i,4.00000000000000000e+00);integer_buffer_set(&!event,i,0)}
   else if i<745681 {numeric_buffer_set(&!times,i,5.00000000000000000e+00);integer_buffer_set(&!event,i,1)}
   else if i<1000000 {numeric_buffer_set(&!times,i,6.00000000000000000e+00);integer_buffer_set(&!event,i,0)}
   else {integer_buffer_set(&!event,i,0)}
   i=i+1
  }
 }
 if id==3 {
  var i:i64=0
  while i<n {
   if i<3620 {numeric_buffer_set(&!times,i,1.00000000000000000e+00);integer_buffer_set(&!event,i,1)}
   else if i<99999 {numeric_buffer_set(&!times,i,1.00000000000000000e+00);integer_buffer_set(&!event,i,0)}
   else if i<103026 {numeric_buffer_set(&!times,i,2.00000000000000000e+00);integer_buffer_set(&!event,i,1)}
   else if i<199989 {numeric_buffer_set(&!times,i,2.00000000000000000e+00);integer_buffer_set(&!event,i,0)}
   else if i<202667 {numeric_buffer_set(&!times,i,3.00000000000000000e+00);integer_buffer_set(&!event,i,1)}
   else if i<299999 {numeric_buffer_set(&!times,i,3.00000000000000000e+00);integer_buffer_set(&!event,i,0)}
   else if i<301596 {numeric_buffer_set(&!times,i,4.00000000000000000e+00);integer_buffer_set(&!event,i,1)}
   else if i<390850 {numeric_buffer_set(&!times,i,4.00000000000000000e+00);integer_buffer_set(&!event,i,0)}
   else if i<691553 {numeric_buffer_set(&!times,i,5.00000000000000000e+00);integer_buffer_set(&!event,i,1)}
   else if i<1000000 {numeric_buffer_set(&!times,i,6.00000000000000000e+00);integer_buffer_set(&!event,i,0)}
   else {integer_buffer_set(&!event,i,0)}
   i=i+1
  }
 }
 if id==4 {
  var i:i64=0
  while i<n {numeric_buffer_set(&!times,i,if i<n-2 {1.0}else{2.0});integer_buffer_set(&!event,i,if i<n-2 {1}else{0});integer_buffer_set(&!group,i,if i==n-1 {0}else{1});i=i+1}
 }
 let r=survival_checked(&times,&event,&group,n,0.05,&!order,&!curves,&!counts,320000000,80000000,100000,100000,1.0e-13)
 assert(r.status==0)
 println("SUMMARY {} {} {} {} {} {} {} {} {} {} {} {} {} {} {} {} {}",id,r.status,r.n,r.rows,r.deaths,r.censored,r.group0,r.group1,yes(r.median_available),bit(r.median),yes(r.median0_available),bit(r.median0),yes(r.median1_available),bit(r.median1),r.sort_comparisons,r.risk_visits,r.critical_evaluations)
 let l=r.logrank
 println("LOGRANK {} {} {} {} {} {} {} {} {} {} {} {} {} {} {} {}",id,l.status,yes(l.available),l.observed1,bit(l.expected1),bit(l.score),bit(l.variance),bit(l.z),bit(l.chi2),yes(l.p_available),bit(l.p),yes(l.log_p_available),bit(l.log_p),yes(l.oe_ratio_available),bit(l.oe_ratio),l.kernel_iterations)
 println("MEDIAN_STATUS {} {} {} {}",id,r.median_status,r.median0_status,r.median1_status)
 var ri:i64=0
 var digest:i64=0
 var mass:f64=0.0;var mass_c:f64=0.0
 while ri<r.rows {
  var g:i64=0
  while g<3 {
   let rec=ri*3+g;let ib=rec*4;let nb=rec*8
   var k:i64=0
   while k<4 {digest=(digest*131+integer_buffer_at(&counts,ib+k))%1000000007;k=k+1}
   let term=numeric_buffer_at(&curves,nb+1)-mass_c;let next=mass+term;mass_c=(next-mass)-term;mass=next
   if id!=1 || ri%7919==0 || ri==r.rows-1 {
   println("CURVE {} {} {} {} {} {} {} {} {} {} {} {} {} {} {}",id,ri,g,integer_buffer_at(&counts,ib),integer_buffer_at(&counts,ib+1),integer_buffer_at(&counts,ib+2),integer_buffer_at(&counts,ib+3),bit(numeric_buffer_at(&curves,nb)),bit(numeric_buffer_at(&curves,nb+1)),bit(numeric_buffer_at(&curves,nb+2)),bit(numeric_buffer_at(&curves,nb+3)),bit(numeric_buffer_at(&curves,nb+4)),bit(numeric_buffer_at(&curves,nb+5)),bit(numeric_buffer_at(&curves,nb+6)),bit(numeric_buffer_at(&curves,nb+7)))
   }
   g=g+1
  }
  ri=ri+1
 }
 println("AGGREGATE {} {} {}",id,digest,bit(mass))
 numeric_buffer_close(times);integer_buffer_close(event);integer_buffer_close(group);integer_buffer_close(order);numeric_buffer_close(curves);integer_buffer_close(counts)
}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
 row(4)
 println("RARE_GROUP_SCORE_ONLY_COMPLETE")
 0
}
