// A heap word has nonzero neighboring bytes. Byte loads must not consume them.
fn read_signed(p: *mut i8) -> i64 with Mut, Panic, Div {
    (*p) as i64
}
fn read_unsigned(p: *mut u8) -> i64 with Mut, Panic, Div {
    (*p) as i64
}
fn read_word(p: *mut i64) -> i64 with Mut, Panic, Div {
    *p
}
fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let raw = heap_alloc(16)
    let word_ptr = raw as *mut i64
    *word_ptr = 0x123456ff
    let signed_ptr = raw as *mut i8
    let unsigned_ptr = raw as *mut u8
    let signed_value = read_signed(signed_ptr)
    let unsigned_value = read_unsigned(unsigned_ptr)
    let word_value = read_word(word_ptr)
    print_int(signed_value)
    print("\n")
    print_int(unsigned_value)
    print("\n")
    print_int(word_value)
    print("\n")
    if signed_value != -1 { return 1 }
    if unsigned_value != 255 { return 2 }
    if word_value != 0x123456ff { return 3 }
    *word_ptr = 0x12345680
    if read_signed(signed_ptr) != -128 { return 4 }
    if read_unsigned(unsigned_ptr) != 128 { return 5 }
    if read_word(word_ptr) != 0x12345680 { return 6 }
    *word_ptr = 0x1234567f
    if read_signed(signed_ptr) != 127 { return 7 }
    if read_unsigned(unsigned_ptr) != 127 { return 8 }
    *word_ptr = 0x12345600
    if read_signed(signed_ptr) != 0 { return 9 }
    if read_unsigned(unsigned_ptr) != 0 { return 10 }
    print("BYTEWIDTH_ACTIVE_PASS\n")
    0
}
