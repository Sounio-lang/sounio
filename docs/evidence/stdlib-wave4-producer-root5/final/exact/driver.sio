use lexer::span::*
use parser::ast::*
pub enum TypeKind {
    TyI64,
    TyF64,
    TyBool,
    TyUnit,
    TyString,
    TyChar,
    TyNamed,
    TyArray,
    TyRef,
    TyRefMut,
    TySlice,
    TySliceMut,
    TyTuple,
    TyFn,
    TyNever,
    TyI8,
    TyI32,
    TyU8,
    TyU32,
    TyU64,
    TyF32,
    TyError,
    TyUnknown,
    TyKnowledge,
    TyModel,
    TyModelFamily,
    TyPolicy,
    TyAcquisitionPolicy,
    TyAcquisitionPlan,
    TyRecoursePolicy,
    TyRecoursePlan,
    TyAlternativePolicy,
    TyAlternativeSet,
    TyAlternativeOption,
    TyTransitionPolicy,
    TyTransitionPlan,
    TyMonitoringPolicy,
    TyObservedTransition,
    TyRollbackCertificate,
    TyDecisionPolicy,
    TyDeferralPolicy,
    TyContest,
    TyRobust,
    TyHyper,       // Hypercomplex: Hyper<Algebra, T> — tag 22
    TyIntervention,     // Intervention<T> — causal: do(X=x)
    TyCounterfactual,   // Counterfactual<T> — causal: Y(x)
    TyValidated,        // Validated<T> — compile-time validated
    TyAdmissible,       // Admissible<T> — decision-admissibility proof carrier
    TyDeferred,         // Deferred<T> — explicit action deferral certificate
    TyValidation,       // Validation policy carrier for validate_manifest(...)
    TyEffectVar,        // Effect row variable (polymorphic effect placeholder) — H6.2
    TyEffectRow,        // Effect row: label + tail (linked list of effects) — H6.2
    TyAleatoric,        // Aleatoric<T> — irreducible uncertainty (sensor noise, quantum) — H6.3
    TyEpistemic,        // Epistemic<T>  — reducible uncertainty (model params, estimation) — H6.3
    TyCausalEffect,     // CausalEffect<Cause, Effect, do(Z=z)> — typed causal query — H6.4
    TyGradedEffect,     // GradedEffect<ε, label> — effect row graded by uncertainty bound — H6.5
    TySession,          // Session protocol type — Track S
    TyChan,             // chan P — channel carrying session protocol — Track S
    TySessionEnd,       // Closed/exhausted session — Track S
    TySingleton,        // Singleton<T, name> — typed canonical physical constant — Sprint 20 SC
    TyScopedEffect,     // ScopedEffect<E, ε> — scope-limited effect with uncertainty budget — Sprint 20 SE
    TyCondIndep,        // IndepKnowledge<T, A, B | Z> — conditional independence as type — Sprint 20 CI
    TyPotentialOutcome, // PotentialOutcome<T, T0, T1> — Rubin potential outcomes (linear-consumed) — Sprint 20 PO
    TyATE,              // ATE<T> — average treatment effect estimand — Sprint 20 PO
    TyDiffPrivate,      // DiffPrivate<T, ε> — mechanism satisfying ε-differential privacy — Sprint 21 DP
    TyDPBudget,         // DPBudget<ε_total, ε_spent> — depleting privacy budget — Sprint 21 DP
    TyTransportable,    // Transport<T, src, tgt, S> — causal effect identified across domains — Sprint 22 T
    TySelectionDiagram, // SelectionDiagram<T, S> — encodes domain difference structure — Sprint 22 T
    TyFairPrediction,   // FairPrediction<T, criterion, attr> — ML fairness constraint as type — Sprint 22 F
    TyFairnessGap,      // FairnessGap<T, criterion> — measured disparity vs declared slack — Sprint 22 F
    TyDistribution,     // Distribution<T, kind> — Sprint 23 P
    TySample,           // Sample<T, D> — Sprint 23 P
    TyConditionalDist,  // Conditional<T, E> — Sprint 23 P
    TyEntropic,         // Entropic<T, H> — Sprint 23 I
    TyMutualInfo,       // MutualInfo<X, Y> — Sprint 23 I
    TyKLBounded,        // KLBounded<T, delta> — Sprint 23 I
    TyVecShaped,        // Vec<T, n> — Sprint 23 V
    TyMatrixShaped,     // Matrix<T, m, n> — Sprint 23 V
    TyBroadcastable,    // Broadcastable<T, m, n> — Sprint 23 V
    TyELBO,             // ELBO<Q, P, delta> — Sprint 23 X
    TyVariationalFamily, // VarFamily<Q, Params> — Sprint 23 X

    // Sprint 24 Track A: Differentiable Programming Types
    TyDifferentiable,    // Differentiable<f, k> — C^k smooth function
    TyGradient,          // Gradient<f, n, m> — gradient map ∇f : R^n → R^m
    TyJacobian,          // Jacobian<f, n, m> — m×n Jacobian matrix of f

    // Sprint 24 Track B: Stochastic Process Types
    TyMarkovChain,       // Markov<S, Q> — Markov chain (DTMC/CTMC/HMM)
    TySDE,               // SDE<S, μ, σ> — Itô stochastic differential equation
    TyMartingale,        // Martingale<X, F> — martingale adapted to filtration F
    TyStationaryDist,    // StationaryDist<P, π> — invariant distribution

    // Sprint 24 Track C: Complexity/Resource Types
    TyBigO,              // BigO<T, k> — O(n^k) polynomial complexity bound
    TyAmortized,         // Amortized<T, φ> — amortized cost with potential function

    // Sprint 24 Track D: Proof Certificate Types
    TyProof,             // Proof<P> — proof certificate for proposition P
    TyLemma,             // Lemma<P> — named proved proposition
    TyAxiom,             // Axiom<P> — unproven assumption

    // Observer type-state (Phase 3: hybrid observer semantics)
    TyUnobserved,        // Unobserved<T> — value exists but has not been inspected

    // 128-bit integers (added at end to preserve existing discriminants)
    TyI128,              // i128 — signed 128-bit integer
    TyU128,              // u128 — unsigned 128-bit integer

    // Raw C-style pointers from `*const T` / `*mut T`.
    TyRawPtr,

    // Compiler-owned fixed binary-format identities. Appended to preserve every existing discriminant.
    // V0-A owns format identity only; values and operations remain fail-closed.
    TyF128,
    TyF256,

    // DsepProof — the discharged-d-separation credential. Opaque by construction:
    // there is no `struct DsepProof { ... }` anywhere in the tree, so no source
    // text can construct one via a struct literal (there is nothing in any
    // struct table to resolve `DsepProof { ... }` against). The ONLY producer is
    // the checker's own handling of a `d_separated(A, B | Z)` call, which stamps
    // this type directly onto that expression -- never through a function's
    // declared return type, which is refused wherever anyone tries to write
    // `-> DsepProof` (see the check in checker_collect_fn_def_inplace / wherever
    // a function's own return-type annotation is recorded).
    TyDsepProof,

    // Compiler-owned word capabilities; only certified named-function constructors issue them.
    // Appended so every existing TypeKind discriminant is preserved.
    TyWorkerFnI64,
    TyWorkerFnF64,
}
pub struct TypeEntry {
    pub kind: TypeKind,
    pub name: Name,
    pub inner: Option<Box<TypeEntry>>,
    pub array_size: i64,
    pub fn_sig_id: i64,
    pub tuple_elems: Option<Box<TypeEntryList>>,
    pub knowledge_epsilon: f64,
    pub knowledge_epsilon_mode: i64,  // 0=error/unspecified, 1=equality, 2=confidence floor, 3=bottom
    pub knowledge_provenance_kind: i64,  // payload, not identity: provenance category (PROVENANCE_KIND_*; -1 = absent → DERIVED)
    pub knowledge_validity_kind: i64,    // VALIDITY_KIND_*; -1 = absent → ALWAYS
    pub knowledge_validity_value: f64,   // duration_sec or until_timestamp (e.g. YYYYMMDD.0). types_equal never reads this; the call-boundary check does.
    pub algebra_kind: i64,   // ALG_REAL..ALG_CLIFFORD (-1 if not Hyper)
    pub clifford_p: i64,     // Clifford signature p (-1 if not Clifford)
    pub clifford_q: i64,     // Clifford signature q (-1 if not Clifford)
    pub unit_id: i64,        // Unit registry index (-1 if not a unit type)
    pub refinement_id: i64,  // RefinementTable index (-1 if not a refinement type)
    pub epistemic_meta_id: i64,      // Contest/Policy metadata (-1 if absent)
    pub robustness_level_id: i64,    // RobustnessLevel tag (-1 if absent)
    pub robustness_scope_id: i64,    // RobustnessScope tag (-1 if absent)
    pub ontology_id: i64,            // OntologyTable index (-1 if not an ontology type)
    pub noise_set_id: i64,           // NS noise-symbol set handle (-1 unknown/top, 0 empty, >0 interned; see check::noise_sets)
}
pub struct TypeEntryList {
    pub head: TypeEntry,
    pub tail: Option<Box<TypeEntryList>>,
}
pub struct FnParamInfo {
    pub name: Name,
    pub ty: TypeEntry,
}
pub struct FnParamList {
    pub head: FnParamInfo,
    pub tail: Option<Box<FnParamList>>,
}
pub fn ty_i64() -> TypeEntry {
    TypeEntry {
        kind: TypeKind::TyI64,
        name: Name { buf: [0; 384], len: 0 },
        inner: None,
        array_size: -1,
        fn_sig_id: -1,
        tuple_elems: None,
        knowledge_epsilon: -1.0,
        knowledge_epsilon_mode: 0,
        algebra_kind: -1,
        clifford_p: -1,
        clifford_q: -1,
        unit_id: -1,
        refinement_id: -1,
        epistemic_meta_id: -1,
        robustness_level_id: -1,
        robustness_scope_id: -1,
        ontology_id: -1,
        noise_set_id: -1,
        knowledge_provenance_kind: -1,
        knowledge_validity_kind: -1,
        knowledge_validity_value: 0.0,
    }
}
pub fn mk_expr(kind: ExprKind, span: Span) -> Expr {
    Expr {
        kind: kind,
        span: span,
        int_val: 0,
        float_val: 0.0,
        f128_lit_lo: 0,
        f128_lit_hi: 0,
        f128_lit_exact: false,
        name: empty_name(),
        path: empty_path(),
        bin_op: BinaryOp::OpAdd,
        un_op: UnaryOp::OpNeg,
        left: None,
        right: None,
        block: None,
        else_expr: None,
        args: None,
        arms: None,
        fields: None,
        cast_type: None,
        handler_block: None,
        closure_params: None,
        closure_return: None,
        closure_effects: None,
        closure_body: None,
        type_args: None,
    }
}
// LABELED COMPONENT SEAMS. These do not model actual Checker/Lowerer storage.
// Checker is used only through its pointer and controlled type lowering below.
struct Checker{calls:i64}
struct Lowerer{component_marker:i64}
fn checker_lower_type_expr_mut(c:*mut Checker,ty:TypeExpr)->TypeEntry with Mut,Panic,Div,Alloc,IO{
 (*c).calls=(*c).calls+1
 var out=ty_i64()
 out.array_size=(*c).calls
 out.knowledge_epsilon=((*c).calls as f64)+0.5
 out.unit_id=100+(*c).calls
 return out
}

fn checker_collect_closure_param_list_inplace(c: *mut Checker, pl: ClosureParamList) -> (FnParamList, i64) with Mut, Panic, Div, Alloc, IO {
    let head_ty = checker_lower_type_expr_mut(c, pl.head.ty)
    let head_param = FnParamInfo { name: pl.head.name, ty: head_ty }
    match pl.tail {
        None => (FnParamList { head: head_param, tail: None }, 1)
        Some(rest) => {
            let rest_pair = checker_collect_closure_param_list_inplace(c, *rest)
            (FnParamList { head: head_param, tail: Some(Box::new(rest_pair.0)) }, 1 + rest_pair.1)
        }
    }
}
fn checker_collect_closure_params_inplace(c: *mut Checker, opt: Option<Box<ClosureParamList> >) -> (Option<Box<FnParamList> >, i64) with Mut, Panic, Div, Alloc, IO {
    match opt {
        Some(pl) => {
            let r = checker_collect_closure_param_list_inplace(c, *pl)
            (Some(Box::new(r.0)), r.1)
        }
        None => (None, 0)
    }
}
impl Lowerer{
    fn kaxi_sanitize_op_kind(self, raw_op: i64) -> i64 {
        if raw_op < 0 || raw_op > 15 {
            0
        } else {
            raw_op
        }
    }
    fn kaxi_extract_publish_args(self, args: Option<Box<ExprList>>) -> (Option<Box<Expr>>, i64) with Alloc {
        match args {
            Some(list) => {
                let value_expr = (*list).head
                let op_kind = match (*list).tail {
                    Some(tail1) => {
                        let op_expr = (*tail1).head
                        if op_expr.kind == ExprKind::ExprIntLit {
                            self.kaxi_sanitize_op_kind(op_expr.int_val)
                        } else {
                            0
                        }
                    }
                    _ => 0,
                }
                (Some(Box::new(value_expr)), op_kind)
            }
            _ => (None, 0),
        }
    }
}
fn rewrite_hardware_publish_args(
    args: Option<Box<ExprList>>
) -> (Option<Box<ExprList>>, i64) with Mut, Panic, Div, Alloc {
    match args {
        Some(list) => {
            let arg0 = (*list).head
            match (*list).tail {
                Some(tail1) => {
                    let arg1 = (*tail1).head
                    let arg_rest = (*tail1).tail
                    let op_kind = kaxi_op_kind_from_expr(arg1)
                    if op_kind < 0 {
                        let original_tail = Some(Box::new(ExprList { label: empty_name(), head: arg1, tail: arg_rest }))
                        (Some(Box::new(ExprList { label: empty_name(), head: arg0, tail: original_tail })), -1)
                    } else {
                        let op_lit = expr_int_lit(arg1.span, op_kind)
                        let rewritten_tail = Some(Box::new(ExprList { label: empty_name(), head: op_lit, tail: arg_rest }))
                        (Some(Box::new(ExprList { label: empty_name(), head: arg0, tail: rewritten_tail })), op_kind)
                    }
                }
                _ => (Some(Box::new(ExprList { label: empty_name(), head: arg0, tail: None })), -1),
            }
        }
        _ => (None, -1),
    }
}
fn kaxi_op_kind_from_expr(e: Expr) -> i64 with Mut, Panic, Div, Alloc {
    if e.kind != ExprKind::ExprPath {
        return -1
    }
    if e.path.seg_count < 2 {
        return -1
    }
    if !path_first_is_kaxi(e.path) {
        return -1
    }

    let op = path_last_name(e.path)
    if name_eq3(op, 97 as i8, 100 as i8, 100 as i8) { return 1 }               // add
    if name_eq3(op, 109 as i8, 117 as i8, 108 as i8) { return 2 }              // mul
    if name_eq3(op, 100 as i8, 105 as i8, 118 as i8) { return 3 }              // div
    if name_eq3(op, 102 as i8, 109 as i8, 97 as i8) { return 4 }               // fma
    if name_eq4(op, 112 as i8, 97 as i8, 115 as i8, 115 as i8) { return 0 }    // pass
    if name_eq8(op,
        112 as i8, 114 as i8, 111 as i8, 112 as i8,
        95 as i8, 118 as i8, 97 as i8, 114 as i8) { return 5 }                 // prop_var
    -1
}
fn expr_int_lit(span: Span, value: i64) -> Expr with Mut {
    var e = mk_expr(ExprKind::ExprIntLit, span)
    e.int_val = value
    e
}
fn path_first_is_kaxi(path: AstPath) -> bool {
    if path.seg_count < 2 {
        return false
    }
    let seg = path.segments
    seg.head_len == 4 &&
    seg.head_buf[0] == 75 as i8 &&  // K
    seg.head_buf[1] == 65 as i8 &&  // A
    seg.head_buf[2] == 88 as i8 &&  // X
    seg.head_buf[3] == 73 as i8     // I
}
fn exprs_copy_string_list_to_name(seg: StringList) -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 384], len: seg.head_len }
    var i: i64 = 0
    while i < seg.head_len && i < 384 {
        n.buf[i] = seg.head_buf[i]
        i = i + 1
    }
    n
}
fn path_last_name(path: AstPath) -> Name with Mut, Panic, Div, Alloc {
    if path.seg_count <= 0 {
        return empty_name()
    }
    if path.seg_count == 1 {
        return exprs_copy_string_list_to_name(path.segments)
    }
    string_list_last_name(path.segments)
}
fn string_list_last_name(list: StringList) -> Name with Mut, Panic, Div, Alloc {
    match list.tail {
        Some(rest) => string_list_last_name(*rest),
        _ => exprs_copy_string_list_to_name(list),
    }
}
fn name_eq3(n: Name, a: i8, b: i8, c: i8) -> bool {
    n.len == 3 && n.buf[0] == a && n.buf[1] == b && n.buf[2] == c
}
fn name_eq4(n: Name, a: i8, b: i8, c: i8, d: i8) -> bool {
    n.len == 4 && n.buf[0] == a && n.buf[1] == b && n.buf[2] == c && n.buf[3] == d
}
fn name_eq8(
    n: Name,
    a0: i8, a1: i8, a2: i8, a3: i8,
    a4: i8, a5: i8, a6: i8, a7: i8
) -> bool {
    n.len == 8 &&
    n.buf[0] == a0 && n.buf[1] == a1 && n.buf[2] == a2 && n.buf[3] == a3 &&
    n.buf[4] == a4 && n.buf[5] == a5 && n.buf[6] == a6 && n.buf[7] == a7
}
fn component_type()->TypeExpr{
 TypeExpr{kind:TypeExprKind::TypeNamed,span:Span::dummy(),path:empty_path(),type_args:None,inner:None,array_size:None,effects:None,knowledge_info:None,refinement_info:None}
}
fn params(n:i64)->Option<Box<ClosureParamList>> with Mut,Panic,Div,Alloc{
 if n==0{return None}
 let tail=params(n-1)
 return Some(Box::new(ClosureParamList{head:ClosureParam{name:make_name(if n==3{"C"}else if n==2{"B"}else{"A"}),ty:component_type(),span:Span::dummy()},tail:tail}))
}
fn clobber(seed:i64)->i64 with Mut,Panic,Div {
 var a:[i64;512]=[0;512]
 var i:i64=0
 while i<512{a[i as usize]=seed+i;i=i+1}
 var sum:i64=0
 i=0
 while i<512{sum=sum+a[i as usize];i=i+1}
 return sum
}
fn inspect_params(id:i64,n:i64) with IO,Mut,Panic,Div,Alloc{
 var c=Checker{calls:0}
 let p=checker_collect_closure_params_inplace((&!c) as *mut Checker,params(n))
 let trash=clobber(700+n)
 print("PARAMS ");print(id);print(" ");print(p.1);print(" ");print(c.calls);print(" ");println(trash)
 var cur=p.0
 var j:i64=0
 while j<p.1{
  match cur{
   Some(list)=>{
    let h=(*list).head
    let t=h.ty
    print("TYPE ");print(id);print(" ");print(j);print(" ");print(h.name.len);print(" ");print(h.name.buf[0] as i64)
    print(" ");print(t.kind as i64);print(" ");print(t.name.len);print(" ");print(t.name.buf[0] as i64)
    print(" ");print(t.array_size);print(" ");print(t.fn_sig_id)
    let bits=f64_to_bits(t.knowledge_epsilon)
    print(" ");print(bits);print(" ");print(t.knowledge_epsilon_mode)
    print(" ");print(t.knowledge_provenance_kind);print(" ");print(t.knowledge_validity_kind)
    let vb=f64_to_bits(t.knowledge_validity_value)
    print(" ");print(vb);print(" ");print(t.algebra_kind);print(" ");print(t.clifford_p);print(" ");print(t.clifford_q)
    print(" ");print(t.unit_id);print(" ");print(t.refinement_id);print(" ");print(t.epistemic_meta_id);print(" ");print(t.robustness_level_id);print(" ");print(t.robustness_scope_id);print(" ");print(t.ontology_id);print(" ");println(t.noise_set_id)
    cur=(*list).tail
   }
   None=>{println("MISSING");return}
  }
  j=j+1
 }
 match cur{Some(_)=>println("EXTRA"),None=>{}}
}
fn ex(v:i64)->Expr with Mut{
 var e=mk_expr(ExprKind::ExprIntLit,Span::dummy())
 e.int_val=v
 return e
}
fn xs(v:Expr,tail:Option<Box<ExprList>>)->Option<Box<ExprList>> with Mut,Alloc{
 return Some(Box::new(ExprList{label:empty_name(),head:v,tail:tail}))
}
fn op_expr(valid:bool)->Expr with Mut,Panic,Div,Alloc{
 var e=mk_expr(ExprKind::ExprPath,Span::dummy())
 let last=make_name(if valid{"add"}else{"bad"})
 var op=StringList{head_buf:last.buf,head_len:last.len,tail:None}
 let first=make_name("KAXI")
 e.path=AstPath{segments:StringList{head_buf:first.buf,head_len:first.len,tail:Some(Box::new(op))},seg_count:2}
 return e
}
fn inspect_lower(id:i64,args:Option<Box<ExprList>>) with IO,Mut,Panic,Div,Alloc{
 let lo=Lowerer{component_marker:17}
 let r=lo.kaxi_extract_publish_args(args)
 let trash=clobber(710+id)
 print("LOWER ");print(id);print(" ");print(r.1);print(" ");print(trash);print(" ")
 match r.0{Some(e)=>{print(1);print(" ");print((*e).kind as i64);print(" ");println((*e).int_val)},None=>println("0 -1 -1")}
}
fn inspect_rewrite(id:i64,args:Option<Box<ExprList>>) with IO,Mut,Panic,Div,Alloc{
 let r=rewrite_hardware_publish_args(args)
 let trash=clobber(720+id)
 print("REWRITE ");print(id);print(" ");print(r.1);print(" ");println(trash)
 var cur=r.0
 var j:i64=0
 var done=false
 while !done{
  match cur{
   Some(list)=>{
    let e=(*list).head
    print("EXPR ");print(id);print(" ");print(j);print(" ");print(e.kind as i64);print(" ");println(e.int_val)
    cur=(*list).tail
    j=j+1
   }
   None=>{done=true}
  }
 }
 print("LENGTH ");print(id);print(" ");println(j)
}
fn main()->i32 with IO,Mut,Panic,Div,Alloc{
 inspect_params(0,0);inspect_params(1,1);inspect_params(2,3)
 inspect_lower(0,None);inspect_lower(1,xs(ex(7),None));inspect_lower(2,xs(ex(7),xs(ex(3),None)));inspect_lower(3,xs(ex(7),xs(ex(20),None)));inspect_lower(4,xs(ex(7),xs(op_expr(true),None)))
 inspect_rewrite(0,None);inspect_rewrite(1,xs(ex(8),None));inspect_rewrite(2,xs(ex(8),xs(op_expr(true),xs(ex(9),None))));inspect_rewrite(3,xs(ex(8),xs(op_expr(false),xs(ex(9),None))))
 return 0
}

