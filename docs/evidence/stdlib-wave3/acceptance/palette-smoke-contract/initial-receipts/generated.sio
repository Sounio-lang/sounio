//@ run-pass
//@ contract-adjustment: canonical listed RGB8 floor(255*channel), bin=floor(256*t); legacy fits remain under *_approx_*
// Generated from pinned primary data by canonical_palette_reference.cpp --emit-smoke.
use viz::colormap::*
fn main()->i32 with IO,Mut,Div,Panic {
 if viridis_r(0.0)!=68 {print("FAIL canonical bin0r\n");return 1}
 if viridis_g(0.0)!=1 {print("FAIL canonical bin0g\n");return 1}
 if viridis_b(0.0)!=84 {print("FAIL canonical bin0b\n");return 1}
 if viridis_r(0.5)!=32 {print("FAIL canonical bin128r\n");return 1}
 if viridis_g(0.5)!=144 {print("FAIL canonical bin128g\n");return 1}
 if viridis_b(0.5)!=140 {print("FAIL canonical bin128b\n");return 1}
 if viridis_r(1.0)!=253 {print("FAIL canonical bin255r\n");return 1}
 if viridis_g(1.0)!=231 {print("FAIL canonical bin255g\n");return 1}
 if viridis_b(1.0)!=36 {print("FAIL canonical bin255b\n");return 1}
 var i:i64=0
 while i<=10 {
  let t=(i as f64)/10.0
  let r=viridis_r(t)
  if r<0 || r>255 {print("FAIL range r\n");return 2}
  let g=viridis_g(t)
  if g<0 || g>255 {print("FAIL range g\n");return 2}
  let b=viridis_b(t)
  if b<0 || b>255 {print("FAIL range b\n");return 2}
  i=i+1
 }
 print("COLORMAP_STDLIB_OK\n")
 0
}
