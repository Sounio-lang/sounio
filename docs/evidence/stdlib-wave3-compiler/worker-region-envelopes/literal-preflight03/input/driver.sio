use compiler::module_frontend::{module_frontend_compile_imported_to_file}
use native::worker_proof::{worker_lower_backend_opt_in}
use ir::lower::{lower_rgn_backend_opt_in}
fn main()->i32 with IO,Mut,Div,Panic,Alloc {
    worker_lower_backend_opt_in()
    lower_rgn_backend_opt_in()
    println("PRIVATE_LITERAL_DIRECT_BEGIN")
    let direct=module_frontend_compile_imported_to_file("/scratch/sounio-stdlib-wave3-20261027/root-integrated02-loader/gate/cases/direct.sio","/scratch/sounio-stdlib-wave3-20261027/compiler-resumed/worker-literal-preflight03/results/direct.elf",false)
    print("PRIVATE_LITERAL_DIRECT_STATUS=");print_int(direct as i64);print("\n")
    println("PRIVATE_LITERAL_NORMAL_BEGIN")
    let normal=module_frontend_compile_imported_to_file("/scratch/sounio-stdlib-wave3-20261027/root-integrated02-loader/gate/cases/normal.sio","/scratch/sounio-stdlib-wave3-20261027/compiler-resumed/worker-literal-preflight03/results/normal.elf",false)
    print("PRIVATE_LITERAL_NORMAL_STATUS=");print_int(normal as i64);print("\n")
    if direct!=0 || normal!=0 {return 1}
    0
}
