use worker_gate::good::{collision}
use ffi::platform::{platform_open,platform_status,platform_call,platform_close}
use thread::native::{native_thread_spawn,native_thread_status,native_thread_join,native_thread_close}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
 assert(collision(21)==64)
 let p=platform_open()
 assert(platform_status(&p)==0)
 var task=native_thread_spawn(&p,worker_fn_i64(collision),21)
 assert(native_thread_status(&task)==0)
 let result=native_thread_join(&p,&!task)
 assert(result.status==0 && result.value==64)
 assert(collision(7)==22)
 assert(native_thread_close(&p,task)==0)
 assert(platform_call(&p,3,0,0,0,0).value==0)
 platform_close(p)
 println("WORKER_LOADER_DIRECT_OK")
 return 0
}
