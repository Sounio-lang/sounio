
pub fn wave3_concrete_alias_probe()->i32 with IO,Alloc,Mut,Panic,Div {
 var integer=heap_i64_vec_new()
 heap_i64_vec_push(&!integer,42)
 heap_i64_vec_push(&!integer,17)
 assert(heap_i64_vec_len(&integer)==2)
 assert(heap_i64_vec_get(&integer,0)==42)
 assert(heap_i64_vec_get(&integer,1)==17)
 heap_i64_vec_free(&!integer)
 assert(heap_i64_vec_len(&integer)==0)
 var floating=heap_f64_vec_new()
 heap_f64_vec_push(&!floating,1.5)
 heap_f64_vec_push(&!floating,0.0-2.5)
 assert(heap_f64_vec_len(&floating)==2)
 assert(heap_f64_vec_get(&floating,0)==1.5)
 assert(heap_f64_vec_get(&floating,1)==0.0-2.5)
 heap_f64_vec_free(&!floating)
 assert(heap_f64_vec_len(&floating)==0)
 println("CONCRETE_HEAP_ALIASES_OK")
 return 0
}

