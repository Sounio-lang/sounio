fn core(seed: i64) -> i64 with Mut {
    var s = seed
    if s == 0 { s = 1 }
    s = s * 3 + 1
    s
}
fn main() -> i32 with Mut, Panic {
    var seeds0 = 0
    var seeds5 = 5
    var result0 = core(seeds0)
    assert(result0 == 4)
    var result5 = core(seeds5)
    assert(result5 == 15)
    return 0
}
