use ode::checked64::{solve_dp54_64}
use ode::solver::{default_options}
var CALLS:i64=0
fn one_rhs(t:f64,y:&[f64;64],dy:&![f64;64]) with Mut,Div,Panic {CALLS=CALLS+1;var i:i64=0;while i<64 {dy[i]=1.0;i=i+1}}
fn large_rhs(t:f64,y:&[f64;64],dy:&![f64;64]) with Mut,Div,Panic {CALLS=CALLS+1;var i:i64=0;while i<64 {dy[i]=1e15;i=i+1}}
fn record(name:string,status:i64,steps:i64,attempts:i64,nfeval:i64,x:f64,t:f64) with IO {print("DP54_BASELINE ");print(name);print(" ");print_int(status);print(" ");print_int(steps);print(" ");print_int(attempts);print(" ");print_int(nfeval);print(" ");print_int(CALLS);print(" ");print_int(f64_to_bits(x));print(" ");print_int(f64_to_bits(t));println("")}
fn main()->i32 with IO,Mut,Div,Panic {
 let y:[f64;64]=[0.0;64];var opts=default_options();opts.dt_init=0.125;opts.dt_max=0.125
 CALLS=0;let fixed=solve_dp54_64(one_rhs,&y,1,0.0,0.5,opts);record("fixed",fixed.status,fixed.steps,fixed.attempts,fixed.nfeval,fixed.state[0],fixed.t_final)
 opts.dt_init=4.5e-15;opts.dt_max=4.5e-15;opts.dt_min=1e-30;opts.rtol=1.0;opts.atol=1.0
 CALLS=0;let actual=solve_dp54_64(large_rhs,&y,1,1.0,1.0000000000000089,opts);record("actual",actual.status,actual.steps,actual.attempts,actual.nfeval,actual.state[0],actual.t_final)
 opts.dt_init=1e20;opts.dt_max=1e20;opts.dt_min=1e-30
 CALLS=0;let cross=solve_dp54_64(one_rhs,&y,1,1e20,-1.0,opts);record("cross",cross.status,cross.steps,cross.attempts,cross.nfeval,cross.state[0],cross.t_final)
 println("DP54_BASELINE_DONE");0
}
