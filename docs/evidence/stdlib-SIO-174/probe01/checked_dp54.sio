pub struct Ode64Result {
 pub status:i64,pub n:i64,pub t_final:f64,pub steps:i64,pub attempts:i64,
 pub nfeval:i64,pub nreject:i64,pub state:[f64;64],
}
pub fn dp54_identity(r:&Ode64Result)->f64 with Panic {r.state[0]}
pub linear struct DenseProbe {n:i64,status:i64,t0:f64,t1:f64,r1:[f64;64],r2:[f64;64],r3:[f64;64],r4:[f64;64],r5:[f64;64],endpoint:[f64;64],slope0:[f64;64],slope1:[f64;64]}
pub fn dense_probe_new()->DenseProbe {DenseProbe{n:0,status:3,t0:0.0,t1:0.0,r1:[0.0;64],r2:[0.0;64],r3:[0.0;64],r4:[0.0;64],r5:[0.0;64],endpoint:[0.0;64],slope0:[0.0;64],slope1:[0.0;64]}}
pub fn dense_probe_set(d:&!DenseProbe) with Mut,Panic {d.n=1;d.status=0;d.t0=1.0;d.t1=2.0;d.r1[0]=11.0;d.endpoint[0]=22.0;d.slope0[0]=33.0;d.slope1[0]=44.0}
pub fn dense_probe_value(d:&DenseProbe)->f64 with Panic {d.r1[0]+d.endpoint[0]+d.slope0[0]+d.slope1[0]}
pub fn dense_probe_close(d:DenseProbe) {let DenseProbe{n,status,t0,t1,r1,r2,r3,r4,r5,endpoint,slope0,slope1}=d}
