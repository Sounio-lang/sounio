use ode::checked64::{Ode64Result,solve_dp54_64,solve_verlet64}
use ode::checked_dp54::{dp54_identity,dense_probe_new,dense_probe_set,dense_probe_value,dense_probe_close}
use ode::solver::{default_options}
fn constant_rhs(t:f64,y:&[f64;64],dy:&![f64;64]) with Mut,Div,Panic {var i:i64=0;while i<64 {dy[i]=1.0;i=i+1}}
fn zero_acc(t:f64,y:&[f64;64],dy:&![f64;64]) with Mut,Div,Panic {var i:i64=0;while i<64 {dy[i]=0.0;i=i+1}}
fn main()->i32 with IO,Mut,Div,Panic {
 let y:[f64;64]=[0.0;64];let v:[f64;64]=[1.0;64];var o=default_options();o.dt_init=0.125;o.dt_max=0.125
 let r:Ode64Result=solve_dp54_64(constant_rhs,&y,1,0.0,0.125,o)
 assert(r.status==0&&r.steps==1&&r.nfeval==7);assert(dp54_identity(&r)>0.124999999999&&dp54_identity(&r)<0.125000000001)
 let verlet=solve_verlet64(zero_acc,&y,&v,1,0.0,0.125,1);assert(verlet.status==0&&verlet.position[0]==0.125)
 var d=dense_probe_new();dense_probe_set(&!d);assert(dense_probe_value(&d)==110.0);dense_probe_close(d)
 println("DP54_LEGACY_REEXPORT_LINEAR_ABI_PASS");0
}
