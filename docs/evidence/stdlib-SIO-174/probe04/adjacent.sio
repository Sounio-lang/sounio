fn adjacent(x:f64,direction:f64)->f64 with Mut {
 let magnitude=if x<0.0 {-x}else{x}
 var delta=magnitude*1.1102230246251565e-16
 if delta<4.9406564584124654e-324 {delta=4.9406564584124654e-324}
 var y=x+direction*delta
 if y==x {y=x+direction*(2.0*delta)}
 if y==0.0&&x<0.0 {return -0.0}
 y
}
fn record(i:i64,x:f64,d:f64) with IO,Mut {let y=adjacent(x,d);print("ADJ ");print_int(i);print(" ");print_int(f64_to_bits(x));print(" ");print_int(f64_to_bits(d));print(" ");print_int(f64_to_bits(y));println("")}
fn p2(e:i64)->f64 with Mut {var value:f64=1.0;var i:i64=0;if e<0 {while i>e {value=value*0.5;i=i-1}}else{while i<e {value=value*2.0;i=i+1}};value}
fn main()->i32 with IO,Mut {
record(0,0.0,1.0)
record(1,0.0,-1.0)
record(2,-(0.0),1.0)
record(3,-(0.0),-1.0)
