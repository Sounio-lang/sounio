use stats::wilcoxon::{wilcoxon_signed_rank,wilcoxon_one_sample}
fn row(id:i64,paired:bool) with IO,Alloc,Mut,Div,Panic {
 var x:[f64;256]=[0.0;256]
 var y:[f64;256]=[0.0;256]
 var n:i32=0
 if id==0 {n=0
 }
 if id==1 {n=3
 x[0]=0.00000000000000000e+00
 x[1]=-0.00000000000000000e+00
 x[2]=0.00000000000000000e+00
 }
 if id==2 {n=1
 x[0]=1.00000000000000000e+00
 }
 if id==3 {n=1
 x[0]=-1.00000000000000000e+00
 }
 if id==4 {n=8
 x[0]=1.50000000000000000e+00
 x[1]=2.50000000000000000e+00
 x[2]=-3.50000000000000000e+00
 x[3]=4.00000000000000000e+00
 x[4]=-1.00000000000000000e+00
 x[5]=5.00000000000000000e+00
 x[6]=2.00000000000000000e+00
 x[7]=3.00000000000000000e+00
 }
 if id==5 {n=5
 x[0]=1.00000000000000000e+00
 x[1]=1.00000000000000000e+00
 x[2]=-2.00000000000000000e+00
 x[3]=2.00000000000000000e+00
 x[4]=3.00000000000000000e+00
 }
 if id==6 {n=5
 x[0]=0.00000000000000000e+00
 x[1]=0.00000000000000000e+00
 x[2]=2.00000000000000000e+00
 x[3]=-3.00000000000000000e+00
 x[4]=4.00000000000000000e+00
 }
 if id==7 {n=3
 x[0]=1.00000000000000008e-15
 x[1]=-2.00000000000000016e-15
 x[2]=2.99999999999999984e-15
 }
 if id==8 {n=4
 x[0]=1.00000000000000000e+00
 x[1]=1.00000000000000022e+00
 x[2]=-1.00000000000000044e+00
 x[3]=-2.00000000000000000e+00
 }
 if id==9 {n=2
 x[0]=0.00000000000000000e+00
 x[1]=2.00000000000000000e+00
 }
 if id==10 {n=3
 x[0]=0.00000000000000000e+00
 x[1]=2.00000000000000000e+00
 x[2]=3.00000000000000000e+00
 }
 if id==11 {n=4
 x[0]=0.00000000000000000e+00
 x[1]=2.00000000000000000e+00
 x[2]=3.00000000000000000e+00
 x[3]=-4.00000000000000000e+00
 }
 if id==12 {n=5
 x[0]=0.00000000000000000e+00
 x[1]=2.00000000000000000e+00
 x[2]=3.00000000000000000e+00
 x[3]=-4.00000000000000000e+00
 x[4]=5.00000000000000000e+00
 }
 if id==13 {n=6
 x[0]=0.00000000000000000e+00
 x[1]=2.00000000000000000e+00
 x[2]=3.00000000000000000e+00
 x[3]=-4.00000000000000000e+00
 x[4]=5.00000000000000000e+00
 x[5]=1.00000000000000000e+00
 }
 if id==14 {n=7
 x[0]=0.00000000000000000e+00
 x[1]=2.00000000000000000e+00
 x[2]=3.00000000000000000e+00
 x[3]=-4.00000000000000000e+00
 x[4]=5.00000000000000000e+00
 x[5]=1.00000000000000000e+00
 x[6]=-2.00000000000000000e+00
 }
 if id==15 {n=8
 x[0]=0.00000000000000000e+00
 x[1]=2.00000000000000000e+00
 x[2]=3.00000000000000000e+00
 x[3]=-4.00000000000000000e+00
 x[4]=5.00000000000000000e+00
 x[5]=1.00000000000000000e+00
 x[6]=-2.00000000000000000e+00
 x[7]=0.00000000000000000e+00
 }
 if id==16 {n=9
 x[0]=0.00000000000000000e+00
 x[1]=2.00000000000000000e+00
 x[2]=3.00000000000000000e+00
 x[3]=-4.00000000000000000e+00
 x[4]=5.00000000000000000e+00
 x[5]=1.00000000000000000e+00
 x[6]=-2.00000000000000000e+00
 x[7]=0.00000000000000000e+00
 x[8]=4.00000000000000000e+00
 }
 if id==17 {n=10
 x[0]=0.00000000000000000e+00
 x[1]=2.00000000000000000e+00
 x[2]=3.00000000000000000e+00
 x[3]=-4.00000000000000000e+00
 x[4]=5.00000000000000000e+00
 x[5]=1.00000000000000000e+00
 x[6]=-2.00000000000000000e+00
 x[7]=0.00000000000000000e+00
 x[8]=4.00000000000000000e+00
 x[9]=-5.00000000000000000e+00
 }
 if id==18 {n=11
 x[0]=0.00000000000000000e+00
 x[1]=2.00000000000000000e+00
 x[2]=3.00000000000000000e+00
 x[3]=-4.00000000000000000e+00
 x[4]=5.00000000000000000e+00
 x[5]=1.00000000000000000e+00
 x[6]=-2.00000000000000000e+00
 x[7]=0.00000000000000000e+00
 x[8]=4.00000000000000000e+00
 x[9]=-5.00000000000000000e+00
 x[10]=1.00000000000000000e+00
 }
 if id==19 {n=12
 x[0]=0.00000000000000000e+00
 x[1]=2.00000000000000000e+00
 x[2]=3.00000000000000000e+00
 x[3]=-4.00000000000000000e+00
 x[4]=5.00000000000000000e+00
 x[5]=1.00000000000000000e+00
 x[6]=-2.00000000000000000e+00
 x[7]=0.00000000000000000e+00
 x[8]=4.00000000000000000e+00
 x[9]=-5.00000000000000000e+00
 x[10]=1.00000000000000000e+00
 x[11]=2.00000000000000000e+00
 }
 let r=if paired {wilcoxon_signed_rank(&x,&y,n)}else{wilcoxon_one_sample(&x,n,0.0)}
 let kind:i64=if paired {0}else{1}
 let neff:i64=r.n_eff;let wp:i64=f64_to_bits(r.w_plus);let wm:i64=f64_to_bits(r.w_minus)
 let pb:i64=f64_to_bits(r.p_value);let zb:i64=f64_to_bits(r.z);let eb:i64=f64_to_bits(r.effect_r)
 println("LEGACY {} {} {} {} {} {} {} {}",id,kind,neff,wp,wm,pb,zb,eb)
}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
 row(0,true)
 row(0,false)
 row(1,true)
 row(1,false)
 row(2,true)
 row(2,false)
 row(3,true)
 row(3,false)
 row(4,true)
 row(4,false)
 row(5,true)
 row(5,false)
 row(6,true)
 row(6,false)
 row(7,true)
 row(7,false)
 row(8,true)
 row(8,false)
