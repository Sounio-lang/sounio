fn pair_value()->((f64,f64),(f64,f64)){let a:f64=1.0;let b:f64=2.0;let c:f64=3.0;let d:f64=4.0;((a,b),(c,d))}
fn emit(i:i64,x:f64) with IO {print("PAIR_VALUE ");print_int(i);print(" ");print_int(f64_to_bits(x));println("")}
fn main()->i32 with IO { let (a,b)=pair_value();emit(0,a.0);emit(1,a.1);emit(2,b.0);emit(3,b.1);println("PAIR_VALUES_DONE");0}
