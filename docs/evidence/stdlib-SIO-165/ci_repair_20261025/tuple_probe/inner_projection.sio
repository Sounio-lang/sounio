fn pair_value()->((f64,f64),(f64,f64)){let a:(f64,f64)=(1.0,2.0);let b:(f64,f64)=(3.0,4.0);let result:((f64,f64),(f64,f64))=(a,b);result}
fn emit(i:i64,x:f64) with IO {print("PAIR_VALUE ");print_int(i);print(" ");print_int(f64_to_bits(x));println("")}
fn main()->i32 with IO { let total=pair_value();let a=total.0;let b=total.1;emit(0,a.0);emit(1,a.1);emit(2,b.0);emit(3,b.1);println("PAIR_VALUES_DONE");0}
