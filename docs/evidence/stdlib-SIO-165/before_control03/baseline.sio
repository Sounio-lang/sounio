use physics::sr::{gamma,four_momentum,invariant_mass_from_4p}
fn main()->i32 with IO,Mut,Div,Panic {
 let c=299792458.0
 let (g,ug)=gamma(-0.6*c,0.001*c)
 let fm=four_momentum(c*c,1.0,0.0,0.0)
 let (m,um)=invariant_mass_from_4p(&fm)
 print("SR_BASELINE ");print_int(f64_to_bits(g));print(" ");print_int(f64_to_bits(ug));print(" ");print_int(f64_to_bits(m));println("")
 if ug<0.0 || m<0.999999 || m>1.000001 {return 1}
 println("SR_BASELINE_PASS");0
}
