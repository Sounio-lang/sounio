+fn shadow_declared_word_integer(ty: &TypeExpr) -> bool with Mut, Panic, Div {
+    if (*ty).kind != TypeExprKind::TypeNamed || (*ty).path.seg_count != 1 { return false }
+    match (*ty).type_args { Some(_) => { return false } None => {} }
+    match (*ty).inner { Some(_) => { return false } None => {} }
+    match (*ty).knowledge_info { Some(_) => { return false } None => {} }
+    match (*ty).refinement_info { Some(_) => { return false } None => {} }
+    lower_name_is_integer_type(ir_path_first_name((*ty).path))
+}
