+    fn shadow_closed_untracked_integer(self, e: &Expr, depth: i64) -> bool with Mut, Panic, Div, Alloc {
+        if depth > 32 || !self.shadow_origin_body_closed || FO_INLINE_DEPTH != 0
+            || self.current_fn < 0 || !self.current_func_loaded
+            || self.pending_variance_reg >= 0 || self.pending_closure_fn_id >= 0 { return false }
+        var p: i64 = 0
+        while p < 32 {
+            if self.fo_pending_sens[p as usize] >= 0 { return false }
+            p = p + 1
+        }
+        if (*e).kind == ExprKind::ExprIntLit { return true }
+        if (*e).kind == ExprKind::ExprIdent {
+            let i = self.shadow_local_index((*e).name)
+            if !self.shadow_plain_untracked_slot(i) { return false }
+            return (*(*self.locals).scalar_kind).values[i as usize] == 1
+                && (*(*self.locals).untracked_int_origin).values[i as usize] == 1
+        }
+        if (*e).kind == ExprKind::ExprUnary {
+            if (*e).un_op != UnaryOp::OpNeg && (*e).un_op != UnaryOp::OpBitNot { return false }
+            match (*e).left {
+                Some(v) => { return self.shadow_closed_untracked_integer(&(*v), depth + 1) }
+                None => { return false }
+            }
+        }
+        if (*e).kind == ExprKind::ExprBinary {
+            let allowed = match (*e).bin_op {
+                BinaryOp::OpAdd | BinaryOp::OpSub | BinaryOp::OpMul
+                | BinaryOp::OpBitAnd | BinaryOp::OpBitOr | BinaryOp::OpBitXor
+                | BinaryOp::OpShl | BinaryOp::OpShr | BinaryOp::OpUShr => true,
+                _ => false
+            }
+            if !allowed { return false }
+            match (*e).left {
+                Some(l) => {
+                    match (*e).right {
+                        Some(r) => { return self.shadow_closed_untracked_integer(&(*l), depth + 1)
+                            && self.shadow_closed_untracked_integer(&(*r), depth + 1) }
+                        None => { return false }
+                    }
+                }
+                None => { return false }
+            }
+        }
+        false
+    }
+
+    fn shadow_first_track_dominates(self, index: i64) -> bool with Mut, Panic, Div {
+        if !self.shadow_plain_untracked_slot(index) { return false }
+        FO_INLINE_DEPTH == 0 && self.loop_depth == 0
+            && (*(*self.locals).depths).values[index as usize] == self.scope_depth
+            && !self.so_expr_has_hess()
+    }
+
+    fn shadow_refuse_scope(self) -> Lowerer with Mut, Panic, Div, Alloc, IO {
+        if FO_INLINE_DEPTH > 0 {
+            FO_INLINE_FRAME_CLASH = 1
+            return self
+        }
+        var lo = self
+        if !lo.probe_mode {
+            print("error: uncertainty shadow scope refused: first tracking needs a dominating private cell\n")
+        }
+        if lo.probe_mode {
+            lo.error_count = lo.error_count + 1
+            lo.had_error = true
+            return lo
+        }
+        if lo.current_func_loaded && lo.current_fn >= 0 && lo.current_fn < lo.module.fn_count {
+            lowerer_mark_hard_error(&! lo)
+        } else {
+            // Do not dereference current_func merely to diagnose invalid context.
+            lo.error_count = lo.error_count + 1
+            lo.had_error = true
+            IR_LOWER_HARD_ERROR = 1
+        }
+        lo
+    }
