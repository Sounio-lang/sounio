+// REVIEW ONLY: closed whole-body fence for untracked-integer provenance.
+// This is NOT a Worker capability proof and does not authorize runtime callbacks.
+fn shadow_origin_block_closed(block: &Block, depth: i64) -> bool with Mut, Panic, Div, Alloc {
+    if depth > 64 { return false }
+    var cur = &(*block).stmts
+    var count: i64 = 0
+    while true {
+        match *cur {
+            Some(node) => {
+                count = count + 1
+                if count > 4096 { return false }
+                let stmt = &(*node).head
+                match (*stmt).kind {
+                    StmtKind::StmtLet | StmtKind::StmtVar | StmtKind::StmtExpr | StmtKind::StmtAssign => {}
+                    _ => { return false }
+                }
+                match (*stmt).expr {
+                    Some(e) => { if !shadow_origin_expr_closed(&(*e), depth + 1) { return false } }
+                    None => {}
+                }
+                match (*stmt).target {
+                    Some(e) => { if !shadow_origin_expr_closed(&(*e), depth + 1) { return false } }
+                    None => {}
+                }
+                cur = &(*node).tail
+            }
+            None => break
+        }
+    }
+    true
+}
+
+fn shadow_origin_expr_closed(e: &Expr, depth: i64) -> bool with Mut, Panic, Div, Alloc {
+    if depth > 64 { return false }
+    match (*e).kind {
+        ExprKind::ExprIntLit | ExprKind::ExprFloatLit | ExprKind::ExprBoolTrue
+        | ExprKind::ExprBoolFalse | ExprKind::ExprStringLit | ExprKind::ExprCharLit
+        | ExprKind::ExprIdent | ExprKind::ExprPath | ExprKind::ExprBinary
+        | ExprKind::ExprUnary | ExprKind::ExprFieldAccess | ExprKind::ExprIndex
+        | ExprKind::ExprCall | ExprKind::ExprIf | ExprKind::ExprWhile
+        | ExprKind::ExprLoop | ExprKind::ExprBlock | ExprKind::ExprReturn
+        | ExprKind::ExprBreak | ExprKind::ExprContinue | ExprKind::ExprStructLit
+        | ExprKind::ExprArrayLit | ExprKind::ExprTupleLit | ExprKind::ExprRange
+        | ExprKind::ExprCast => {}
+        _ => { return false }
+    }
+    // Fail closed for all borrowing/capture forms, including later occurrences.
+    if (*e).kind == ExprKind::ExprUnary {
+        if (*e).un_op == UnaryOp::OpRef || (*e).un_op == UnaryOp::OpRefMut
+            || (*e).un_op == UnaryOp::OpDeref { return false }
+    }
+    match (*e).arms { Some(_) => { return false } None => {} }
+    match (*e).handler_block { Some(_) => { return false } None => {} }
+    match (*e).closure_body { Some(_) => { return false } None => {} }
+    match (*e).left {
+        Some(c) => { if !shadow_origin_expr_closed(&(*c), depth + 1) { return false } }
+        None => {}
+    }
+    match (*e).right {
+        Some(c) => { if !shadow_origin_expr_closed(&(*c), depth + 1) { return false } }
+        None => {}
+    }
+    match (*e).else_expr {
+        Some(c) => { if !shadow_origin_expr_closed(&(*c), depth + 1) { return false } }
+        None => {}
+    }
+    match (*e).block {
+        Some(b) => { if !shadow_origin_block_closed(&(*b), depth + 1) { return false } }
+        None => {}
+    }
+    var args = &(*e).args
+    var argc: i64 = 0
+    while true {
+        match *args {
+            Some(a) => {
+                argc = argc + 1
+                if argc > 4096 || !shadow_origin_expr_closed(&(*a).head, depth + 1) { return false }
+                args = &(*a).tail
+            }
+            None => break
+        }
+    }
+    var fields = &(*e).fields
+    var fieldc: i64 = 0
+    while true {
+        match *fields {
+            Some(f) => {
+                fieldc = fieldc + 1
+                if fieldc > 4096 || !shadow_origin_expr_closed(&(*f).head.value, depth + 1) { return false }
+                fields = &(*f).tail
+            }
+            None => break
+        }
+    }
+    true
+}
