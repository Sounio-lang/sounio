+    fn shadow_plain_untracked_slot(self, index: i64) -> bool with Mut, Panic, Div {
+        if index < 0 || index >= (*self.locals).count || index >= 4096 { return false }
+        let kind = (*(*self.locals).scalar_kind).values[index as usize]
+        if kind != 1 && kind != 2 { return false }
