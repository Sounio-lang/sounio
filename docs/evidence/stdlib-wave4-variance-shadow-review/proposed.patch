+        while row < self.fo_bind_count {
+            if ir_name_eq((*self.fo_bind).names[row as usize], (*(*self.locals).names).values[index as usize]) { return false }
+            row = row + 1
+        }
+        var ch: i64 = 0
+        while ch < 32 {
