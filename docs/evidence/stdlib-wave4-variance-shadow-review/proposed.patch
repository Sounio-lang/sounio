+            || (*(*self.locals).array_elem_wide_bits).values[index as usize] != 0
+            || (*(*self.locals).struct_type_is_array_elem).values[index as usize] != 0
+            || (*(*self.locals).struct_types).values[index as usize].len != 0
+            || (*(*self.locals).kn_value_float).values[index as usize] != -1
+            || (*(*self.locals).opt_payload_kind).values[index as usize] != 0
+            || (*(*self.locals).box_inner_layout).values[index as usize] >= 0
+            || (*(*self.locals).closure_fn_id).values[index as usize] >= 0
+            || (*(*self.locals).fn_ptr_ret_float).values[index as usize] != 0
+            || (*(*self.locals).fn_ptr_ret_layout).values[index as usize] >= 0
+            || (*(*self.locals).tuple_float_mask).values[index as usize] != 0
+            || (*(*self.locals).tuple_arr_mask).values[index as usize] != 0
+            || (*(*self.locals).tuple0_array_elem_layout).values[index as usize] >= 0
+            || (*(*self.locals).tuple_struct_layout).values[index as usize] >= 0
+            || (*(*self.locals).tuple_struct_slot).values[index as usize] >= 0
+            || (*(*self.locals).variance_regs).values[index as usize] >= 0 { return false }
+        let reg = (*(*self.locals).regs).values[index as usize]
+        if reg < 0 || self.lookup_variance_for_base_reg(reg) >= 0 { return false }
+        if self.fo_bind_count < 0 || self.fo_bind_count > 128 { return false }
