+    fn shadow_local_index(self, name: Name) -> i64 with Mut, Panic, Div {
+        if (*self.locals).count < 0 || (*self.locals).count > 4096 { return -1 }
+        var i = (*self.locals).count - 1
+        while i >= 0 {
+            if (*(*self.locals).depths).values[i as usize] <= self.scope_depth
+                && ir_name_eq((*(*self.locals).names).values[i as usize], name) { return i }
+            i = i - 1
+        }
+        -1
+    }
