// Witness: clinical fn that only returns pb_vacuous() — isolates return-forwarding.
use epistemic::knightian::*

fn fwd_vacuous() -> PBox with Mut, Div, Panic {
    return pb_vacuous()
}

fn main() -> i32 with Mut, Div, Panic {
    let p = fwd_vacuous()
    if pb_confidence(&p) == 0 {
        return 0
    }
    return 1
}