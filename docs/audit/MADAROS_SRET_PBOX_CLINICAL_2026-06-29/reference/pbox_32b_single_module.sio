// Minimal witness: 32-byte struct return (3×f64 + i64), same layout as epistemic::PBox.
// Expected: exit 0. Observed (Madaros v0.80.0): SIGSEGV 139 on field read after return.

struct PBoxLike {
    lo_mean: f64,
    hi_mean: f64,
    variance: f64,
    confidence: i64,
}

fn make_pbox() -> PBoxLike {
    PBoxLike { lo_mean: 10.0, hi_mean: 20.0, variance: 0.0, confidence: 900 }
}

fn main() -> i32 with Mut, Div, Panic {
    let p = make_pbox()
    if p.lo_mean > 0.0 && p.hi_mean > p.lo_mean {
        return 0
    }
    return 1
}