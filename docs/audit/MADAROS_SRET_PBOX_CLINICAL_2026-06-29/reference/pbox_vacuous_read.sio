// Primary witness: vacuous PBox return (contract gate) then accessor read → SIGSEGV.
// Proves crash is not vancomycin PK math — only PBox return consumption.

use clinical::vancomycin_pbpk::*
use epistemic::knightian::pb_confidence

fn main() -> i32 with Mut, Div, Panic {
    let bad = predict_cmin_knightian(15.0, 65.0, 1000.0, 12.0, 0)
    if pb_confidence(&bad) == 0 {
        return 0
    }
    return 1
}