// Production-path witness: stdlib clinical vancomycin + knightian PBox consumption.
// Compile OK; runtime SIGSEGV when reading returned PBox.
// Mirrors tests/stdlib/clinical/test_vancomycin_pbpk_v2.sio (minus stdout marker).

use clinical::vancomycin_pbpk::*
use epistemic::knightian::pb_lo_mean

fn main() -> i32 with Mut, Div, Panic {
    let pre = predict_cmin_knightian(78.5, 65.0, 1000.0, 12.0, 0)
    let lo = pb_lo_mean(&pre)
    if lo > 0.0 {
        return 0
    }
    return 1
}