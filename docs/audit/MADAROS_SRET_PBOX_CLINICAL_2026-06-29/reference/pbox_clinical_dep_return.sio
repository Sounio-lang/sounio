// Witness: dependency-module function that only returns pb_vacuous().
// Isolates "return from merged dep fn" vs predict_cmin_knightian complexity.

use clinical::vancomycin_pbpk::fwd_vacuous_pbox
use epistemic::knightian::*

fn main() -> i32 with Mut, Div, Panic {
    let p = fwd_vacuous_pbox()
    if pb_confidence(&p) == 0 {
        return 0
    }
    return 1
}