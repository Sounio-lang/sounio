pub struct SplitMix64 { state: i64 }

pub fn splitmix64_new(seed: i64) -> SplitMix64 {
    return SplitMix64 { state: seed }
}

pub fn splitmix64_next(rng: SplitMix64) -> (SplitMix64, i64) {
    return (SplitMix64 { state: rng.state + 1 }, rng.state)
}

pub struct OtherT { a: i64, b: i64, c: i64, d: i64 }
pub fn other_new(seed: i64) -> OtherT {
    return OtherT { a: seed, b: 0, c: 0, d: 0 }
}
