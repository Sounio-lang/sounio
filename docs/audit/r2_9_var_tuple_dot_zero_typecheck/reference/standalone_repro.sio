struct SplitMix64 { state: i64 }

fn splitmix64_new(seed: i64) -> SplitMix64 {
    return SplitMix64 { state: seed }
}

fn splitmix64_next(rng: SplitMix64) -> (SplitMix64, i64) {
    return (SplitMix64 { state: rng.state + 1 }, rng.state)
}

fn xoshiro_setup(seed: i64) -> i64 with Mut {
    var sm = splitmix64_new(seed)
    let r1 = splitmix64_next(sm)
    sm = r1.0
    let r2 = splitmix64_next(sm)
    sm = r2.0
    return sm.state
}

fn main() -> i64 with IO, Mut {
    println(xoshiro_setup(42))
    return 0
}
