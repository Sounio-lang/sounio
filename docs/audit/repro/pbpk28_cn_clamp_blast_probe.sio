// Probe: blast radius of the PBPK28 CN floor clamps across drug profiles and dt.
// Dispatch: docs/audit/PBPK28_CN_FLOOR_CLAMP_MASS_INJECTION_DISPATCH_2026-09-26.md
// pr_apply / pr_step are the same bit-exact kernel copy as in
// pbpk28_cn_clamp_mass_probe.sio (clamp = true reproduces the stdlib step).

use darwin_pbpk::core::pbpk28_params::*
use darwin_pbpk::tsit5_pbpk28::*

fn pr_apply(
    state: &!PBPKState28,
    raw: &!PBPKState28,
    clamp: bool,
    cb_new: f64,
    a_v: &[f64; 14],
    b_v: &[f64; 14],
    a_t: &[f64; 14],
    b_t: &[f64; 14]
) with Mut, Div {
    (*raw).cv[0] = cb_new
    if clamp {
        (*state).cv[0] = if cb_new < 0.0 { 0.0 } else { cb_new }
    } else {
        (*state).cv[0] = cb_new
    }
    var i: i32 = 1
    while i < 14 {
        let cv = (*a_v)[i] + (*b_v)[i] * cb_new
        let ct = (*a_t)[i] + (*b_t)[i] * cb_new
        (*raw).cv[i] = cv
        (*raw).ct[i] = ct
        if clamp {
            (*state).cv[i] = if cv < 0.0 { 0.0 } else { cv }
            (*state).ct[i] = if ct < 0.0 { 0.0 } else { ct }
        } else {
            (*state).cv[i] = cv
            (*state).ct[i] = ct
        }
        i = i + 1
    }
}

fn pr_step(state: &!PBPKState28, raw: &!PBPKState28, clamp: bool,
           p: PBPKParams28, rel_mid: f64, dt: f64) with Mut, Div {
    var a_v: [f64; 14] = [0.0; 14]
    var b_v: [f64; 14] = [0.0; 14]
    var a_t: [f64; 14] = [0.0; 14]
    var b_t: [f64; 14] = [0.0; 14]
    let h = 0.5 * dt
    let vb = p.v_ref[0]
    var sum_q = 0.0
    var i: i32 = 1
    while i < 14 {
        sum_q = sum_q + p.q[i]
        i = i + 1
    }
    let big_s = h * (sum_q + p.cl_central) / vb
    let cb_old = (*state).cv[0]
    var rhs0 = (1.0 - big_s) * cb_old + dt * rel_mid / vb
    var sum_beta_a = 0.0
    var sum_beta_b = 0.0
    i = 1
    while i < 14 {
        let vi = p.v_ref[i]
        let vf = p.vasc_frac[i]
        let vv_raw = vi * vf
        let vt_raw = vi * (1.0 - vf)
        let vv = if vv_raw < 1.0e-30 { 1.0e-30 } else { vv_raw }
        let vt = if vt_raw < 1.0e-30 { 1.0e-30 } else { vt_raw }
        let kp = p.kp[i]
        let ps = p.ps[i]
        let qi = p.q[i]
        let beta  = h * qi / vb
        let gamma = h * qi / vv
        let pp    = 1.0 + h * (qi + ps) / vv
        let qq    = h * ps / (vv * kp)
        let rr    = h * ps / vt
        let sb    = 1.0 + h * ps / (vt * kp)
        let det   = pp * sb - qq * rr
        rhs0 = rhs0 + beta * (*state).cv[i]
        let rhs_v = gamma * cb_old + (1.0 - h * (qi + ps) / vv) * (*state).cv[i] + qq * (*state).ct[i]
        let rhs_t = rr * (*state).cv[i] + (1.0 - h * ps / (vt * kp)) * (*state).ct[i]
        let av = (sb * rhs_v + qq * rhs_t) / det
        let bv = (sb * gamma) / det
        let at = (rr * rhs_v + pp * rhs_t) / det
        let bt = (rr * gamma) / det
        a_v[i] = av
        b_v[i] = bv
        a_t[i] = at
        b_t[i] = bt
        sum_beta_a = sum_beta_a + beta * av
        sum_beta_b = sum_beta_b + beta * bv
        i = i + 1
    }
    let cb_new = (rhs0 + sum_beta_a) / ((1.0 + big_s) - sum_beta_b)
    pr_apply(state, raw, clamp, cb_new, &a_v, &b_v, &a_t, &b_t)
}

fn pr_min_raw(s: PBPKState28) -> f64 with Mut {
    var m = s.cv[0]
    var i: i32 = 1
    while i < 14 {
        if s.cv[i] < m { m = s.cv[i] }
        if s.ct[i] < m { m = s.ct[i] }
        i = i + 1
    }
    return m
}

fn pr_maxdiff(a: PBPKState28, b: PBPKState28) -> f64 with Mut {
    var m = 0.0
    var i: i32 = 0
    while i < 14 {
        let d1 = if a.cv[i] > b.cv[i] { a.cv[i] - b.cv[i] } else { b.cv[i] - a.cv[i] }
        let d2 = if a.ct[i] > b.ct[i] { a.ct[i] - b.ct[i] } else { b.ct[i] - a.ct[i] }
        if d1 > m { m = d1 }
        if d2 > m { m = d2 }
        i = i + 1
    }
    return m
}

// Blast-radius probe. 5 mg IV bolus into blood (cb0 = 1.0 mg/L), t_end = 168 h,
// nominal cl_central. Exact discrete invariant of the unclamped CN step:
//   M(t_n) + CL * AUC_trap(0, t_n) = Dose
// because the Q-coupling telescopes out of the volume-weighted row sum and the
// blood-row elimination is exactly -CL*dt*(Cb_old + Cb_new)/2 per step.
// resid = (M_final + CL * AUC - Dose) / Dose, reported for clamp ON (shipped)
// and clamp OFF.
fn pb_run(drug: i32, p: PBPKParams28, dt: f64) with IO, Mut, Div {
    let dose = 5.0
    let t_end = 168.0
    var s1 = pbpk28_state_zero()
    var s0 = pbpk28_state_zero()
    var raw1 = pbpk28_state_zero()
    var raw0 = pbpk28_state_zero()
    s1.cv[0] = dose / p.v_ref[0]
    s0.cv[0] = dose / p.v_ref[0]
    var auc1 = 0.0
    var auc0 = 0.0
    var inj = 0.0
    var nclamp_steps: i32 = 0
    var min0 = 0.0
    var t = 0.0
    var n: i32 = 0
    while t < t_end - 1.0e-12 {
        let dt_use = if t + dt > t_end { t_end - t } else { dt }
        let c1_old = s1.cv[0]
        let c0_old = s0.cv[0]
        pr_step(&!s1, &!raw1, true, p, 0.0, dt_use)
        pr_step(&!s0, &!raw0, false, p, 0.0, dt_use)
        auc1 = auc1 + 0.5 * (c1_old + s1.cv[0]) * dt_use
        auc0 = auc0 + 0.5 * (c0_old + s0.cv[0]) * dt_use
        let d = pbpk28_total_mass(s1, p) - pbpk28_total_mass(raw1, p)
        if d > 0.0 { nclamp_steps = nclamp_steps + 1 }
        inj = inj + d
        let m = pr_min_raw(s0)
        if m < min0 { min0 = m }
        t = t + dt_use
        n = n + 1
    }
    let m1 = pbpk28_total_mass(s1, p)
    let m0 = pbpk28_total_mass(s0, p)
    print("BLAST|drug=")
    print(drug)
    print("|dt=")
    print(dt)
    print("|steps=")
    print(n)
    print("|AUC_on=")
    print(auc1)
    print("|AUC_off=")
    print(auc0)
    print("|AUC_bias_pct=")
    print((auc1 - auc0) / auc0 * 100.0)
    print("|resid_on_pct=")
    print((m1 + p.cl_central * auc1 - dose) / dose * 100.0)
    print("|resid_off_e12=")
    print((m0 + p.cl_central * auc0 - dose) / dose * 1.0e12)
    print("|inj_mg=")
    print(inj)
    print("|clamp_steps=")
    print(nclamp_steps)
    print("|min_conc_off=")
    println(min0)
}

fn pb_drug(drug: i32, p: PBPKParams28) with IO, Mut, Div {
    pb_run(drug, p, 0.5)
    pb_run(drug, p, 0.1)
    pb_run(drug, p, 0.05)
    pb_run(drug, p, 0.01)
    pb_run(drug, p, 0.001)
}

fn main() -> i32 with IO, Mut, Div, Panic {
    // 1 = rapamycin, 2 = semaglutide, 3 = venlafaxine parent, 4 = venlafaxine ODV
    pb_drug(1, pbpk28_params_rapamycin())
    pb_drug(2, pbpk28_params_semaglutide())
    pb_drug(3, pbpk28_params_venlafaxine_parent())
    pb_drug(4, pbpk28_params_venlafaxine_odv())
    0
}
