// Probe: PBPK28 full-CN mass balance, closed system (cl_central = 0, rel_mid = 0).
// Dispatch: docs/audit/PBPK28_CN_FLOOR_CLAMP_MASS_INJECTION_DISPATCH_2026-09-26.md
// Arm S  = stdlib pbpk28_full_cn_step (unchanged, as shipped).
// Arm K1 = in-probe copy of the same kernel, floor clamps ON  (must equal S bitwise).
// Arm K0 = in-probe copy, floor clamps OFF.
// For K1 we also keep the pre-clamp (raw) state so that the mass the floor
// injects in each step is measured directly: inj = M(clamped) - M(raw).

use darwin_pbpk::core::pbpk28_params::*
use darwin_pbpk::tsit5_pbpk28::*

fn pr_apply(
    state: &!PBPKState28,
    raw: &!PBPKState28,
    clamp: bool,
    cb_new: f64,
    a_v: &[f64; 14],
    b_v: &[f64; 14],
    a_t: &[f64; 14],
    b_t: &[f64; 14]
) with Mut, Div {
    (*raw).cv[0] = cb_new
    if clamp {
        (*state).cv[0] = if cb_new < 0.0 { 0.0 } else { cb_new }
    } else {
        (*state).cv[0] = cb_new
    }
    var i: i32 = 1
    while i < 14 {
        let cv = (*a_v)[i] + (*b_v)[i] * cb_new
        let ct = (*a_t)[i] + (*b_t)[i] * cb_new
        (*raw).cv[i] = cv
        (*raw).ct[i] = ct
        if clamp {
            (*state).cv[i] = if cv < 0.0 { 0.0 } else { cv }
            (*state).ct[i] = if ct < 0.0 { 0.0 } else { ct }
        } else {
            (*state).cv[i] = cv
            (*state).ct[i] = ct
        }
        i = i + 1
    }
}

fn pr_step(state: &!PBPKState28, raw: &!PBPKState28, clamp: bool,
           p: PBPKParams28, rel_mid: f64, dt: f64) with Mut, Div {
    var a_v: [f64; 14] = [0.0; 14]
    var b_v: [f64; 14] = [0.0; 14]
    var a_t: [f64; 14] = [0.0; 14]
    var b_t: [f64; 14] = [0.0; 14]
    let h = 0.5 * dt
    let vb = p.v_ref[0]
    var sum_q = 0.0
    var i: i32 = 1
    while i < 14 {
        sum_q = sum_q + p.q[i]
        i = i + 1
    }
    let big_s = h * (sum_q + p.cl_central) / vb
    let cb_old = (*state).cv[0]
    var rhs0 = (1.0 - big_s) * cb_old + dt * rel_mid / vb
    var sum_beta_a = 0.0
    var sum_beta_b = 0.0
    i = 1
    while i < 14 {
        let vi = p.v_ref[i]
        let vf = p.vasc_frac[i]
        let vv_raw = vi * vf
        let vt_raw = vi * (1.0 - vf)
        let vv = if vv_raw < 1.0e-30 { 1.0e-30 } else { vv_raw }
        let vt = if vt_raw < 1.0e-30 { 1.0e-30 } else { vt_raw }
        let kp = p.kp[i]
        let ps = p.ps[i]
        let qi = p.q[i]
        let beta  = h * qi / vb
        let gamma = h * qi / vv
        let pp    = 1.0 + h * (qi + ps) / vv
        let qq    = h * ps / (vv * kp)
        let rr    = h * ps / vt
        let sb    = 1.0 + h * ps / (vt * kp)
        let det   = pp * sb - qq * rr
        rhs0 = rhs0 + beta * (*state).cv[i]
        let rhs_v = gamma * cb_old + (1.0 - h * (qi + ps) / vv) * (*state).cv[i] + qq * (*state).ct[i]
        let rhs_t = rr * (*state).cv[i] + (1.0 - h * ps / (vt * kp)) * (*state).ct[i]
        let av = (sb * rhs_v + qq * rhs_t) / det
        let bv = (sb * gamma) / det
        let at = (rr * rhs_v + pp * rhs_t) / det
        let bt = (rr * gamma) / det
        a_v[i] = av
        b_v[i] = bv
        a_t[i] = at
        b_t[i] = bt
        sum_beta_a = sum_beta_a + beta * av
        sum_beta_b = sum_beta_b + beta * bv
        i = i + 1
    }
    let cb_new = (rhs0 + sum_beta_a) / ((1.0 + big_s) - sum_beta_b)
    pr_apply(state, raw, clamp, cb_new, &a_v, &b_v, &a_t, &b_t)
}

fn pr_min_raw(s: PBPKState28) -> f64 with Mut {
    var m = s.cv[0]
    var i: i32 = 1
    while i < 14 {
        if s.cv[i] < m { m = s.cv[i] }
        if s.ct[i] < m { m = s.ct[i] }
        i = i + 1
    }
    return m
}

fn pr_maxdiff(a: PBPKState28, b: PBPKState28) -> f64 with Mut {
    var m = 0.0
    var i: i32 = 0
    while i < 14 {
        let d1 = if a.cv[i] > b.cv[i] { a.cv[i] - b.cv[i] } else { b.cv[i] - a.cv[i] }
        let d2 = if a.ct[i] > b.ct[i] { a.ct[i] - b.ct[i] } else { b.ct[i] - a.ct[i] }
        if d1 > m { m = d1 }
        if d2 > m { m = d2 }
        i = i + 1
    }
    return m
}

fn pr_run(tag: i32, p: PBPKParams28, cb0: f64, dt: f64, n: i32) with IO, Mut, Div {
    var s_std = pbpk28_state_zero()
    var s_k1 = pbpk28_state_zero()
    var s_k0 = pbpk28_state_zero()
    var raw1 = pbpk28_state_zero()
    var raw0 = pbpk28_state_zero()
    s_std.cv[0] = cb0
    s_k1.cv[0] = cb0
    s_k0.cv[0] = cb0
    let m0 = pbpk28_total_mass(s_std, p)
    print("CASE|tag=")
    print(tag)
    print("|dt=")
    print(dt)
    print("|m0=")
    println(m0)
    var k: i32 = 0
    var inj_sum = 0.0
    var m_prev1 = m0
    while k < n {
        s_std = pbpk28_full_cn_step(s_std, p, 0.0, dt)
        pr_step(&!s_k1, &!raw1, true, p, 0.0, dt)
        pr_step(&!s_k0, &!raw0, false, p, 0.0, dt)
        let m_std = pbpk28_total_mass(s_std, p)
        let m_k1 = pbpk28_total_mass(s_k1, p)
        let m_raw1 = pbpk28_total_mass(raw1, p)
        let m_k0 = pbpk28_total_mass(s_k0, p)
        let inj = m_k1 - m_raw1
        inj_sum = inj_sum + inj
        print("STEP|tag=")
        print(tag)
        print("|k=")
        print(k + 1)
        print("|M_std=")
        print(m_std)
        print("|M_clampON=")
        print(m_k1)
        print("|std_vs_copy_maxdiff_e15=")
        print(pr_maxdiff(s_std, s_k1) * 1.0e15)
        print("|schur_reldrift_in_step_e12=")
        print((m_raw1 - m_prev1) / m_prev1 * 1.0e12)
        print("|clamp_injected=")
        print(inj)
        print("|min_raw_clampON=")
        print(pr_min_raw(raw1))
        print("|M_clampOFF=")
        print(m_k0)
        print("|clampOFF_reldrift_e12=")
        print((m_k0 - m0) / m0 * 1.0e12)
        print("|min_clampOFF=")
        println(pr_min_raw(s_k0))
        m_prev1 = m_k1
        k = k + 1
    }
    print("SUMMARY|tag=")
    print(tag)
    print("|M_final_std=")
    print(pbpk28_total_mass(s_std, p))
    print("|growth_std=")
    print(pbpk28_total_mass(s_std, p) - m0)
    print("|sum_clamp_injected=")
    print(inj_sum)
    print("|clampOFF_final_reldrift_e12=")
    println((pbpk28_total_mass(s_k0, p) - m0) / m0 * 1.0e12)
}

fn main() -> i32 with IO, Mut, Div, Panic {
    // Case 1: the reported repro (venlafaxine parent, CL=0, 50 mg in blood, dt=0.5 h, 6 steps).
    var p = pbpk28_params_venlafaxine_parent()
    p.cl_central = 0.0
    pr_run(1, p, 10.0, 0.5, 6)

    // Case 2: same with PS = 0 in every organ (pure Q-convection).
    var p2 = p
    var i: i32 = 0
    while i < 14 {
        p2.ps[i] = 0.0
        i = i + 1
    }
    pr_run(2, p2, 10.0, 0.5, 6)
    0
}
