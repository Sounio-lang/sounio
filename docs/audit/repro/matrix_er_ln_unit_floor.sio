// Repro: matrix_er Korsmeyer-Peppas fraction floors at ~7.88e-3 as t -> 0+.
// mer_ln_unit is a 20-term artanh series on y=(x-1)/(x+1), and it saturates at
// -2*sum_{k<20} 1/(2k+1) = -4.959 as x -> 0+, so 0.199*t^0.65 floors at 7.88e-3 (0.59 mg
// of 75 mg; mer_exp adds -0.5%). Run via bin/souc (Madaros, 512 MiB stack); rc=1 = defect.
use darwin_pbpk::release::matrix_er::{matrix_fraction, venlafaxine_xr_matrix_gohel2008}

fn rel_err(got: f64, want: f64) -> f64 { if got > want { (got - want) / want } else { (want - got) / want } }

fn main() -> i32 with IO, Mut, Div, Panic {
    let rel = venlafaxine_xr_matrix_gohel2008()
    // Exact 0.199*t^0.65 (IEEE-754 pow, 17 s.f.): t = 3.5e-15, 1e-6, 0.01
    let e0 = rel_err(matrix_fraction(rel, 3.5e-15), 7.9890898448550897e-11)
    let e1 = rel_err(matrix_fraction(rel, 1.0e-6), 2.5052615694703923e-05)
    let e2 = rel_err(matrix_fraction(rel, 0.01), 9.9736259491827184e-03)
    println(e0)
    println(e1)
    println(e2)
    if e0 > 1.0e-9 || e1 > 1.0e-9 || e2 > 1.0e-9 {
        println("REPRO_KP_SMALL_T_FLOOR")
        return 1
    }
    println("KP_SMALL_T_OK")
    return 0
}
