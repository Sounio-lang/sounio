// Converse of D2: n >= 0 does not satisfy n > 0.
// Mirrors tests/compile-fail/refinement_subtype_strict.sio. Expect E042.

type NonNeg = { n: i32 | n >= 0 }
type Positive = { n: i32 | n > 0 }

fn needs_positive(x: Positive) -> i32 {
    x
}

fn main() -> i32 {
    let zero: NonNeg = 0
    needs_positive(zero)
}
