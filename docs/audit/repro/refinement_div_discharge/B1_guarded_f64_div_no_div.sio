// Dispatch shape: explicit float guard, no `with Div`.
// if_cond_extract_pred only accepts an integer-literal RHS, so `d != 0.0`
// is not a refinement guard.

fn guarded(a: f64, d: f64) -> f64 {
    if d != 0.0 {
        a / d
    } else {
        0.0
    }
}

fn main() -> f64 {
    guarded(1.0, 2.0)
}
