// Path narrowing at a call boundary: inside `if y != 0`, y satisfies NonZero.
// This is what refine_cond_env + pred_implies can do. No `/`.

fn takes_nz(d: { x: i32 | x != 0 }) -> i32 {
    d
}

fn main() -> i32 {
    let y: i32 = 3
    if y != 0 {
        takes_nz(y)
    } else {
        0
    }
}
