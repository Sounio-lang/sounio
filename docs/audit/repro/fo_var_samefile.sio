// Independent FO-across-fn probe (grok-cli5). Same file, no import.
// variance_of on f64 extracted from measure() — July gum_cross shape.
// Cells: identity, return-only, 2-arg add, 3-arg add, 4-arg add.
// Instrument: souc compile <src> -o <elf> then confirm \x7fELF and run.

fn id1(x: f64) -> f64 with Mut {
    x
}

fn add2(x: f64, y: f64) -> f64 with Mut {
    let r = x + y
    return r
}

fn add3(x: f64, y: f64, z: f64) -> f64 with Mut {
    let r = x + y + z
    return r
}

fn add4(x: f64, y: f64, z: f64, w: f64) -> f64 with Mut {
    let r = x + y + z + w
    return r
}

fn ret_only(x: f64) -> f64 with Mut {
    return x
}

fn main() with IO, Mut, Epistemic {
    let k1: Knowledge<f64> = measure(100.0, uncertainty: 2.0)
    let k2: Knowledge<f64> = measure(50.0, uncertainty: 1.0)
    let k3: Knowledge<f64> = measure(10.0, uncertainty: 3.0)
    let k4: Knowledge<f64> = measure(7.0, uncertainty: 0.5)
    let a = k1.value
    let b = k2.value
    let c = k3.value
    let d = k4.value

    print("LOCAL_a ")
    print_f64(variance_of(a))
    println("")
    print("LOCAL_b ")
    print_f64(variance_of(b))
    println("")
    print("LOCAL_c ")
    print_f64(variance_of(c))
    println("")
    print("LOCAL_d ")
    print_f64(variance_of(d))
    println("")

    print("ID1 ")
    print_f64(variance_of(id1(a)))
    println("")
    print("RET_ONLY ")
    print_f64(variance_of(ret_only(a)))
    println("")
    print("ADD2 ")
    print_f64(variance_of(add2(a, b)))
    println("")
    print("ADD3 ")
    print_f64(variance_of(add3(a, b, c)))
    println("")
    print("ADD4 ")
    print_f64(variance_of(add4(a, b, c, d)))
    println("")
}
