// Minimal witness for MADAROS_PRINTLN_BOOL_SCALARKIND_SEGV_2026-08-17.
// check = OK; run = SIGSEGV (rc=139) under default Madaros; lean_single PASS.
//
// Mechanism: println_dispatch_name (self-hosted/ir/lower.sio) routes a scalar
// whose expr_result_scalar_kind_ref is 0 ("other") to the char* printer `print`,
// which strlen's the scalar VALUE as a pointer. A bool from a call/field/copy is
// never classified as kind 1, so the bool `1` is dereferenced as address 0x1.
//
// Positive contrast (both run clean): `let b = true; println(b)` prints `1`
// (bool literal lowers as IntLit=kind1); `println("text")` prints text.
fn getb() -> bool { true }
fn main() -> i32 with IO {
    let v = getb()
    print("V=")
    println(v)          // <-- SIGSEGV here
    println("read ok")
    0
}
