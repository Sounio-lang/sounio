// Characterization matrix for FO at a same-file call boundary.
// Not in the run-pass suite. Measured 2026-08-18; see
// docs/audit/MADAROS_FO_CALL_BOUNDARY_DISPATCH_2026-08-18.md.

fn id1(x: f64) -> f64 { x }
fn scale1(x: f64) -> f64 { x * 2.0 }
fn neg1(x: f64) -> f64 { 0.0 - x }
fn div1(x: f64) -> f64 with Div { x / 5.0 }
fn add2(x: f64, y: f64) -> f64 { x + y }
fn mul2(x: f64, y: f64) -> f64 { x * y }
fn sub2(x: f64, y: f64) -> f64 { x - y }
fn id3(a: f64, b: f64, c: f64) -> f64 { a }

struct Ops { n: i64 }
impl Ops {
    fn mscale(self: &Ops, x: f64) -> f64 { x * 2.0 }
}

fn tag(v: f64, name: i64) with IO {
    print("C")
    print_int(name)
    print(" ")
    print_f64(v)
    print(" ")
    if v > 1.0e-12 {
        println("LIVE")
    } else {
        println("ZERO")
    }
}

fn main() with IO, Mut, Div, Epistemic {
    let k: Knowledge<f64> = measure(10.0, uncertainty: 1.0)
    let x = k.value
    tag(variance_of(x), 0)
    tag(variance_of(id1(x)), 1)
    tag(variance_of(scale1(x)), 2)
    tag(variance_of(neg1(x)), 3)
    tag(variance_of(div1(x)), 4)
    let k2: Knowledge<f64> = measure(4.0, uncertainty: 1.0)
    let y = k2.value
    tag(variance_of(add2(x, y)), 5)
    tag(variance_of(mul2(x, y)), 6)
    tag(variance_of(sub2(x, y)), 7)
    tag(variance_of(id3(x, y, 0.0)), 8)
    let ops = Ops { n: 0 }
    tag(variance_of(ops.mscale(x)), 9)
}
