//@ run-pass
//@ expect-stdout: PASS
// Minimal multimodule Madaros smoke: one CN step of imported pbpk28_full_cn_step.
//
// Forensic: docs/audit/MADAROS_IMPORTED_PBPK28_CN_SIGSEGV_2026-08-16.md
// Stdlib mitigation (mut + apply_schur split): default Madaros `souc run` must
// PASS with non-trivial peripheral mass (cv1 gate). Compiler root causes open.

use darwin_pbpk::core::pbpk28_params::{pbpk28_state_zero, PBPKParams28}
use darwin_pbpk::tsit5_pbpk28::{pbpk28_full_cn_step}

fn smoke_params() -> PBPKParams28 {
    // Minimal positive physiology (rapamycin-like skeleton, tiny CL)
    PBPKParams28 {
        v_ref: [5.0, 1.8, 0.31, 1.45, 0.33, 1.1, 28.0, 20.0, 1.2, 3.6, 6.6, 0.18, 0.09, 3.7],
        vasc_frac: [1.000, 0.210, 0.160, 0.037, 0.262, 0.262, 0.040, 0.050, 0.024, 0.019, 0.041, 0.282, 0.180, 0.050],
        kp: [1.0, 2.0, 2.0, 1.0, 1.5, 2.0, 1.0, 1.0, 1.5, 1.0, 0.5, 1.5, 1.0, 1.0],
        ps: [0.0, 900.0, 740.0, 440.0, 160.0, 3500.0, 420.0, 100.0, 550.0, 210.0, 170.0, 100.0, 80.0, 130.0],
        q: [350.0, 90.0, 74.0, 44.0, 16.0, 350.0, 42.0, 10.0, 55.0, 21.0, 17.0, 10.0, 8.0, 13.0],
        cl_central: 10.0
    }
}

fn main() -> i64 with Mut, Div, IO, Panic {
    let pa = smoke_params()
    var st = pbpk28_state_zero()
    // seed a little mass in blood so the step is non-trivial
    st.cv[0] = 1.0
    let st2 = pbpk28_full_cn_step(st, pa, 0.0, 0.05)
    print("cv0="); println(st2.cv[0])
    print("cv1="); println(st2.cv[1])
    if st2.cv[0] < 0.0 {
        println("FAIL")
        return 1
    }
    // Guard against Madaros silent-zero reconstruct (bug B in audit note).
    if st2.cv[1] < 0.35 {
        println("FAIL")
        return 1
    }
    if st2.cv[1] > 0.36 {
        println("FAIL")
        return 1
    }
    println("PASS")
    return 0
}
