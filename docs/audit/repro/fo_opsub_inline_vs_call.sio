// Decides whether OpSub loses FO inline, or only through a user fn.
// Not in the run-pass suite. See MADAROS_FO_CALL_BOUNDARY_DISPATCH.

fn sub2(x: f64, y: f64) -> f64 { x - y }
fn neg1(x: f64) -> f64 { 0.0 - x }
fn mul2(x: f64, y: f64) -> f64 { x * y }

fn tag(label: i64, v: f64) with IO {
    print("T")
    print_int(label)
    print(" ")
    print_f64(v)
    print(" ")
    if v > 1.0e-12 {
        println("LIVE")
    } else {
        println("ZERO")
    }
}

fn main() with IO, Mut, Epistemic {
    let ka: Knowledge<f64> = measure(10.0, uncertainty: 1.0)
    let kb: Knowledge<f64> = measure(4.0, uncertainty: 1.0)
    let a = ka.value
    let b = kb.value

    // Inline — no user fn.
    let i_sub = a - b
    let i_neg = 0.0 - a
    let i_mul = a * b
    tag(1, variance_of(i_sub))
    tag(2, variance_of(i_neg))
    tag(3, variance_of(i_mul))

    // Same three shapes through a user fn (2-param catalog / 1-param).
    tag(4, variance_of(sub2(a, b)))
    tag(5, variance_of(neg1(a)))
    tag(6, variance_of(mul2(a, b)))
}
