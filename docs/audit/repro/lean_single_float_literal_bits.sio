// lean_single misrounds decimal f64 literals by 1-2 ulp (runtime int+frac/10^n,
// then one mulsd/divsd by 10.0 per exponent digit); Madaros emits exact bits.
// Expected integers are the IEEE-754 round-to-nearest bits of each literal.
fn chk(name: i64, got: i64, want: i64) -> i32 with IO {
    print_int(name); print(" ulp_off="); print_int(got - want); println("")
    if got == want { 0 } else { 1 }
}
fn main() -> i32 with IO, Mut {
    var bad: i32 = 0
    bad = bad + chk(1, f64_to_bits(0.000001), 4517329193108106637)            // rtol
    bad = bad + chk(2, f64_to_bits(0.0000000001), 4457293557087583675)        // atol
    bad = bad + chk(3, f64_to_bits(0.041), 4586069543746904523)               // v_vasc
    bad = bad + chk(4, f64_to_bits(1.379008574103742), 4608889321673121243)   // tsit5 a74/b4
    bad = bad + chk(5, f64_to_bits(0.9800255409045097), 4607002504866938653)  // tsit5 c5
    bad = bad + chk(6, f64_to_bits(1.0e-12), 4427486594234968593)
    if bad == 0 { println("LITERALS_EXACT") } else { println("LITERALS_MISROUNDED") }
    0
}
