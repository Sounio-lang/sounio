// Characterization: imported epistemic::fo helpers (catalog shapes).
// Not in the run-pass suite. See MADAROS_FO_CALL_BOUNDARY_DISPATCH.

use epistemic::fo::{fo_scale, fo_add2, fo_mul2, fo_div2}

fn tag(v: f64, name: i64) with IO {
    print("I")
    print_int(name)
    print(" ")
    print_f64(v)
    print(" ")
    if v > 1.0e-12 {
        println("LIVE")
    } else {
        println("ZERO")
    }
}

fn main() with IO, Mut, Div, Epistemic {
    let k: Knowledge<f64> = measure(10.0, uncertainty: 1.0)
    let x = k.value
    let k2: Knowledge<f64> = measure(4.0, uncertainty: 1.0)
    let y = k2.value
    tag(variance_of(fo_scale(x, 2.0)), 1)
    tag(variance_of(fo_add2(x, y)), 2)
    tag(variance_of(fo_mul2(x, y)), 3)
    tag(variance_of(fo_div2(x, y)), 4)
}
