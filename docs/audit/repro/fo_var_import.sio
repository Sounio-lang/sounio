// Independent imported FO probe. Callee is fo_var_callee.sio next to this file.
// Compile with cwd = this directory so `use fo_var_callee` resolves.

use fo_var_callee::{id1, add2, add3}

fn main() with IO, Mut, Epistemic {
    let k1: Knowledge<f64> = measure(100.0, uncertainty: 2.0)
    let k2: Knowledge<f64> = measure(50.0, uncertainty: 1.0)
    let k3: Knowledge<f64> = measure(10.0, uncertainty: 3.0)
    let a = k1.value
    let b = k2.value
    let c = k3.value

    print("IMP_LOCAL_a ")
    print_f64(variance_of(a))
    println("")
    print("IMP_ID1 ")
    print_f64(variance_of(id1(a)))
    println("")
    print("IMP_ADD2 ")
    print_f64(variance_of(add2(a, b)))
    println("")
    print("IMP_ADD3 ")
    print_f64(variance_of(add3(a, b, c)))
    println("")
}
