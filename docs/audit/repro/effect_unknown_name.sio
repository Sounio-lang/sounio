// Accusation witness. NomeQueNaoExiste is not a name that
// effect_name_to_id recognises, nor a declared effect. Until 2026-11-22 it
// was also on the held list, so the checker dropped it with no diagnostic
// and `souc check` exited 0. Since then checker_collect_effects_mut refuses
// it with error[E246], and the closed-list gate requires that refusal.

fn marked() -> i64 with NomeQueNaoExiste {
    0
}

fn main() -> i64 with NomeQueNaoExiste {
    marked()
}
