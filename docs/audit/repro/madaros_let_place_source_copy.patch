+    // By-name sibling of struct_layout_field_pos: same FIRST-registration rule,
+    // matched on the field NAME a field access carries.
+    fn struct_layout_field_pos_by_name(self, type_name: Name, field_name: Name) -> i64 with Mut, Panic, Div, Alloc {
+        if type_name.len <= 0 { return 0 - 1 }
+        if field_name.len <= 0 { return 0 - 1 }
+        var si: i64 = 0
+        while si < (*self.struct_layouts).count {
+            if ir_name_eq((*self.struct_layouts).entries[si as usize].type_name, type_name) {
+                var fi: i64 = 0
+                let fc = (*self.struct_layouts).entries[si as usize].field_count
+                while fi < fc && fi < 128 {
+                    if ir_name_eq(ir_name_at((*self.struct_layouts).entries[si as usize].fields[fi as usize].name_id), field_name) {
+                        return si * 128 + fi
+                    }
+                    fi = fi + 1
+                }
+                return 0 - 1
+            }
+            si = si + 1
+        }
+        0 - 1
+    }
