+    // `let v = o.f` where `f` is a WORD-SCALAR fixed-array field: the field's
+    // layout position, else -1. Tuple slots (`pair.0`) are not named fields.
+    fn let_place_source_word_scalar_array_pos_ref(self, e: &Expr) -> i64 with Mut, Panic, Div, Alloc {
+        if (*e).kind != ExprKind::ExprFieldAccess { return 0 - 1 }
+        if lower_name_tuple_index((*e).name) >= 0 { return 0 - 1 }
+        match (*e).left {
+            Some(owner) => {
+                let owner_st = self.expr_receiver_struct_type_ref(&(*owner))
+                let pos = self.struct_layout_field_pos_by_name(owner_st, (*e).name)
+                if pos >= 0 && self.struct_layout_pos_array_len(pos) > 0 { return pos }
+            }
+            None => {}
+        }
+        0 - 1
+    }
