+    // Static struct type of a PLACE used as a let initialiser, or empty when it
+    // must keep the handle: a Box field or Box deref (reference semantics), a
+    // Seq element, a tuple slot. Knowledge and unregistered names are rejected
+    // by the caller through nested_struct_field_slot_count.
+    fn let_place_source_struct_type_ref(self, e: &Expr) -> Name with Mut, Panic, Div, Alloc {
+        if (*e).kind == ExprKind::ExprFieldAccess {
+            if lower_name_tuple_index((*e).name) >= 0 { return ir_empty_name() }
+            match (*e).left {
+                Some(owner) => {
+                    let owner_st = self.expr_receiver_struct_type_ref(&(*owner))
+                    return self.field_named_type_for_struct(owner_st, (*e).name)
+                }
+                None => {}
+            }
+            return ir_empty_name()
+        }
+        if (*e).kind == ExprKind::ExprUnary && (*e).un_op == UnaryOp::OpDeref {
+            match (*e).left {
+                Some(operand) => {
+                    if (*operand).kind == ExprKind::ExprIdent {
+                        if ir_name_is_box(self.lookup_local_struct_type((*operand).name)) { return ir_empty_name() }
+                    } else {
+                        return ir_empty_name()
+                    }
+                }
+                None => {}
+            }
+            return self.expr_receiver_struct_type_ref(e)
+        }
+        if (*e).kind == ExprKind::ExprIndex {
+            match (*e).left {
+                Some(indexed) => {
+                    if (*indexed).kind != ExprKind::ExprIdent { return ir_empty_name() }
+                    if ir_name_eq(self.lookup_local_struct_type((*indexed).name), make_name("Seq")) { return ir_empty_name() }
+                }
+                None => {}
+            }
+            return self.expr_receiver_struct_type_ref(e)
+        }
+        ir_empty_name()
     }
 
