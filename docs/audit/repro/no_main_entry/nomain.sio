// No `fn main`. Madaros (x86-64) writes an ELF anyway; entry = .text+0 =
// merged fn 0 = z_first_unused, whose body is replaced by an empty stub
// (NATIVE_REFUSAL kind=empty_stub_ud2) -> SIGILL, rc=132.
// lean_single refuses: error[E221]: no main.
// See docs/audit/MADAROS_NO_MAIN_ENTRY_FN0_DISPATCH_2026-09-26.md.
use nm::dep::*
fn helper() -> i64 { z_first_unused() + y_called() }
