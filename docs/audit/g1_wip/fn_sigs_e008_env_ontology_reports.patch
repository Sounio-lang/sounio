+        print(" at ")
+        print_int(span.start)
+        print("..")
+        print_int(span.end)
+    }
+    print(": statistical test on unregistered variable '")
+    print_name_value(outcome_name)
+    print("' - confidence penalty applied\n")
+    print("   = note: Hypothesis currently applies this penalty as an advisory warning; automatic Knowledge<T> confidence scaling is pending\n")
+}
