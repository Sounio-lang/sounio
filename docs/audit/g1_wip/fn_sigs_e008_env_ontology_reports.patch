+// *mut report helpers (transcriptions of report_unit_call_mismatch@14790 /
+// report_effect_error@8181 / report_hypothesis_penalty_warning@8128). The by-value
+// originals return the 8MB Checker (SRET); holding `let t = (*c).report_*()` forces the
+// CALLER's frame to 8MB even when the error branch is not taken — which trips the
+// large-struct codegen miscompile (smashes the return address on the call). Routing the
+// report via *mut removes the 8MB local entirely. (unit_boundary was the confirmed g(5)
+// crash — instrumentation showed arg_ty/param_ty valid right up to the unit call, fault on
+// its return.)
+fn checker_report_unit_call_mismatch_inplace(c: *mut Checker, span: Span, arg_uid: i64, param_uid: i64) with Mut, Panic, Div, Alloc, IO {
+    (*c).had_error = true
+    (*c).error_count = (*c).error_count + 1
+    print("error[E041]: unit mismatch in call argument\n")
+    print("  argument unit: ")
+    if arg_uid >= 0 {
+        print_unit_dim((*c).units.get_dim(arg_uid))
+    } else {
+        print("(dimensionless)")
+    }
+    print("\n  parameter unit: ")
+    if param_uid >= 0 {
+        print_unit_dim((*c).units.get_dim(param_uid))
+    } else {
+        print("(dimensionless)")
+    }
+    print("\n")
+}
+
+fn checker_report_effect_error_inplace(c: *mut Checker, span: Span, missing: [i64; 8], missing_count: i64) with Mut, IO, Panic, Div {
+    (*c).error_count = (*c).error_count + 1
+    (*c).had_error = true
+    print("error[E035]")
+    if span.start > 0 || span.end > 0 {
+        print(" at ")
+        print_int(span.start)
+        print("..")
+        print_int(span.end)
+    }
+    print(": effect not declared in function signature (missing: ")
+    var i: i64 = 0
+    while i < missing_count {
+        if i > 0 { print(", ") }
+        print_effect_name(missing[i as usize])
+        i = i + 1
+    }
+    print(")\n")
+}
+
