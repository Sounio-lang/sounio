+// *mut transcription of check_call_arg_ontology_boundary (17679). The by-value form returned
+// the 8MB Checker (SRET) — a latent SRET-smash the moment call resolution actually reached it.
+// The subclass/disjoint queries are pure reads delegating to free fns over `ontology_kernel`,
+// so route them directly; report via *mut. (Real fix, but NOT the g(5) crash — that is an
+// earlier large-by-value-TypeEntry-arg codegen miscompile around the unit boundary call.)
+fn checker_ontology_boundary_check_call_arg_contract_inplace(c: *mut Checker, arg_ty_ref: &TypeEntry, param_ty_ref: &TypeEntry, call_span: Span) with Mut, Panic, Div, Alloc, IO {
+    let arg_ty = (*arg_ty_ref)
+    let param_ty = (*param_ty_ref)
+    let expected_ty = call_ref_inner_or_self(param_ty)
+    if expected_ty.ontology_id < 0 || is_error_or_unknown(expected_ty) {
+        return
+    }
+    let provided_ty = call_ref_inner_or_self(arg_ty)
+    if is_error_or_unknown(provided_ty) {
+        return
+    }
+    if provided_ty.ontology_id < 0 {
+        checker_report_error_at_inplace(c, call_span, 150, 0, 0, 0)
+        return
+    }
+    if ontology_kernel_is_subclass((*c).ontology_kernel, provided_ty.ontology_id, expected_ty.ontology_id) {
+        return
+    }
+    if ontology_kernel_is_disjoint((*c).ontology_kernel, provided_ty.ontology_id, expected_ty.ontology_id) {
+        checker_report_error_at_inplace(c, call_span, 151, 0, 0, 0)
+        return
+    }
+    checker_report_error_at_inplace(c, call_span, 152, 0, 0, 0)
