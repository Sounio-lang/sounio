struct Ty { kind: i64, inner: Option<Box<Ty>> }
fn teq(a: Ty, b: Ty) -> bool {
    if a.kind != b.kind {
        false
    } else {
        match (a.inner, b.inner) {
            (Some(ia), Some(ib)) => teq(*ia, *ib),
            (None, None) => true,
            _ => false
        }
    }
}
fn main() -> i32 {
    let x = Ty { kind: 1, inner: None }
    let y = Ty { kind: 1, inner: None }
    if teq(x, y) { 0 } else { 1 }
}
