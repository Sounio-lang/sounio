+// name.f1.f2 = expr  — AUTO-DEREF two-level store (ident root, no explicit `(* )`).
+// Shape only: (3|79) 50 3 50 3 16. For a VALUE struct root the generic assignment
+// path already handles this correctly, so the dispatch gates this on the root var
+// being pointer-like (token_chain_root_is_pointer); value structs fall through
+// unchanged. Pointer roots previously wrote into a discarded value-copy (read 0) —
+// the same disease as the explicit-deref form, and the shape used by the in-place
+// checker's c.algebras.count / c.studies.count / c.ontologies.count collectors.
+fn stmt_is_field_field_store_shape(p0: i64) -> bool with Panic, Mut {
+    if TK[p0 as usize] != 3 && TK[p0 as usize] != 79 { return false }
+    if TK[(p0 + 1) as usize] != 50 { return false }
+    if TK[(p0 + 2) as usize] != 3 { return false }
+    if TK[(p0 + 3) as usize] != 50 { return false }
+    if TK[(p0 + 4) as usize] != 3 { return false }
+    return TK[(p0 + 5) as usize] == 16
+}
+
+// name.f1.f2[idx] = expr  →  (3|79) 50 3 50 3 41 ... 42 16
+fn stmt_is_field_field_array_store_shape(p0: i64) -> bool with Panic, Mut {
+    if TK[p0 as usize] != 3 && TK[p0 as usize] != 79 { return false }
+    if TK[(p0 + 1) as usize] != 50 { return false }
+    if TK[(p0 + 2) as usize] != 3 { return false }
+    if TK[(p0 + 3) as usize] != 50 { return false }
+    if TK[(p0 + 4) as usize] != 3 { return false }
+    if TK[(p0 + 5) as usize] != 41 { return false }
+    var p = p0 + 6
+    var depth: i64 = 1
+    while p < TC && depth > 0 {
+        if TK[p as usize] == 41 { depth = depth + 1 }
+        if TK[p as usize] == 42 { depth = depth - 1 }
+        p = p + 1
+    }
+    return TK[p as usize] == 16
+}
+
+// True when the var named by the token at p0 is a pointer/ref binding (so a
+// `name.f1.f2 = …` write must deref rather than write into a local struct slot).
+fn token_chain_root_is_pointer(p0: i64) -> bool with Panic, Mut, Div {
+    let lvi = var_find_idx(TS[p0 as usize], TE[p0 as usize])
+    if lvi < 0 { return false }
+    return type_is_pointer_like(VAR_TY[lvi as usize], VAR_TY_HASH[lvi as usize])
+}
