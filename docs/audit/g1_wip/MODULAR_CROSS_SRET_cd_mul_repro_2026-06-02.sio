/* Modular native-v2 cross-module SRET diagnosis repro (2026-06-02)
 *
 * Choice "1" from parallel work request on modular compiler fix.
 * Exercises the exact hot case from BLK-20260602-SRET-FORWARDING-IMPORTS + PR #227:
 *   cd_mul returns large CDElement (c: [f64; 2048]) across stdlib import (algebra::cayley_dickson).
 *
 * Invocation for modular path (after fresh build from branch sources):
 *   export SOUNIO_STDLIB_PATH=$(pwd)/stdlib
 *   ./bin/souc --native-compile docs/audit/g1_wip/MODULAR_CROSS_SRET_cd_mul_repro_2026-06-02.sio -o /tmp/mod_cd.elf
 *   /tmp/mod_cd.elf   # expect "CD_MUL_CROSS_SRET_OK" + exit 0 if modular fixes the forwarding
 *
 * Compare to legacy:
 *   ./bin/souc ... (plain)  # currently FAIL
 *
 * See also:
 *   SRET_FORWARDING_BUG_2026-06-02.md
 *   SRET_FORWARDING_MINIMAL_REPRO_2026-06-02.sio (intra, small)
 *   agent_handoff.log.md (Lane 4 ownership of the blocker)
 */

use algebra::cayley_dickson::{cd_mul, cd_basis}

fn main() -> i64 with IO, Mut, Div, Panic {
    let e0 = cd_basis(5, 0)
    let e1 = cd_basis(5, 1)
    let p = cd_mul(e0, e1)
    // For e0 * e1 == e1 (one of the basis), p.c[1] == 1.0
    if p.c[1] > 0.5 {
        println("CD_MUL_CROSS_SRET_OK")
        return 0
    }
    println("CD_MUL_CROSS_SRET_FAIL")
    return 1
}
