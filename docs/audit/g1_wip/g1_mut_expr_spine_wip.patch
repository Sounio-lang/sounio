+    } else if base_ty.kind == TypeKind::TyCounterfactual {
+        if name_matches_str5(e.name, 118, 97, 108, 117, 101) {
+            let epistemic_id: i64 = 8
+            if !has_effect_id((*c).current_effects, (*c).current_effect_count, epistemic_id) {
+                checker_report_error_at_inplace(c, e.span, 170, 0, 0, 0)
+            }
+            knowledge_inner(base_ty)
+        } else if name_matches_str7(e.name, 101, 112, 115, 105, 108, 111, 110) {
+            ty_f64()
+        } else {
+            checker_report_error_at_inplace(c, e.span, 12, 0, 0, 0)
+            ty_error()
+        }
+    } else if base_ty.kind == TypeKind::TyValidated {
+        if name_matches_str5(e.name, 118, 97, 108, 117, 101) {
+            let epistemic_id: i64 = 8
+            if !has_effect_id((*c).current_effects, (*c).current_effect_count, epistemic_id) {
+                checker_report_error_at_inplace(c, e.span, 170, 0, 0, 0)
