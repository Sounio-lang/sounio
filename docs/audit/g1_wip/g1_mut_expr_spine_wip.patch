+// --- ExprIf ---------------------------------------------------------------
+fn checker_check_if_expr_inplace(c: *mut Checker, e: Expr) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
+    let cond_ty = checker_check_opt_expr_inplace(c, e.left)
+    if !is_error_or_unknown(cond_ty) && !is_bool_type(cond_ty) {
+        checker_report_mismatch_inplace(c, e.span, 6, ty_bool(), cond_ty)
+    }
+    let saved_cond_env = (*c).refine_cond_env
+    let cond_guard = if_cond_extract_pred(e.left)
+    if cond_guard.0 != 0 {
+        (*c).refine_cond_env = refine_static_env_push((*c).refine_cond_env, cond_guard.1)
+    }
+    let then_ty = checker_check_opt_block_inplace(c, e.block)
+    (*c).refine_cond_env = saved_cond_env
+    match e.else_expr {
+        Some(else_e) => {
+            let else_ty = checker_check_expr_inplace(c, *else_e)
+            (*c).refine_cond_env = saved_cond_env
+            if !types_compatible(then_ty, else_ty) {
+                checker_report_mismatch_inplace(c, e.span, 7, then_ty, else_ty)
+            }
+            then_ty
+        }
+        None => {
+            (*c).refine_cond_env = saved_cond_env
+            ty_unit()
+        }
+    }
+}
