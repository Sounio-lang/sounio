+// --- ExprWhile ------------------------------------------------------------
+fn checker_check_while_expr_inplace(c: *mut Checker, e: Expr) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
+    let cond_ty = checker_check_opt_expr_inplace(c, e.left)
+    if !is_error_or_unknown(cond_ty) && !is_bool_type(cond_ty) {
+        checker_report_mismatch_inplace(c, e.span, 6, ty_bool(), cond_ty)
+    }
+    let depth_pair = (*c).check_loop_depth(e.span)
+    checker_store_from_value(c, depth_pair.0)
+    if !depth_pair.1 {
+        return ty_error()
+    }
+    (*c).loop_depth = (*c).loop_depth + 1
+    (*c).borrows = (*c).borrows.release_exclusive_borrows()
+    match e.block {
+        Some(blk) => { let _bt = checker_check_block_inplace(c, *blk) }
+        None => {}
+    }
+    (*c).loop_depth = (*c).loop_depth - 1
+    ty_unit()
+}
