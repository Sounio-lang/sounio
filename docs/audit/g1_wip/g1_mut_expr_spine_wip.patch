+// --- ExprStructLit (cluster) ----------------------------------------------
+fn checker_check_struct_lit_inplace(c: *mut Checker, e: Expr) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
+    let struct_name = checker_copy_string_list_to_name(e.path.segments)
+    let struct_idx = (*c).structs.find(struct_name)
+    if struct_idx >= 0 {
+        let si = (*c).structs.get(struct_idx)
+        if si.is_generic_template {
+            checker_check_generic_struct_lit_inplace(c, e, si)
+        } else {
+            checker_check_struct_field_inits_inplace(c, e.fields, si, e.span)
+            ty_named(struct_name)
+        }
+    } else {
+        checker_report_error_at_inplace(c, e.span, 15, 0, 0, 0)
+        checker_check_struct_field_inits_no_type_inplace(c, e.fields)
+        ty_error()
+    }
+}
