+fn checker_check_match_arm_inplace(c: *mut Checker, arm: MatchArm, scrut_ty: TypeEntry) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
+    (*c).env = (*c).env.push_scope()
+    (*c).borrows = (*c).borrows.push_scope()
+    checker_push_const_scope_inplace(c)
+    checker_bind_pattern_inplace(c, arm.pattern, scrut_ty)
+    let body_ty = checker_check_expr_inplace(c, arm.body)
+    checker_pop_const_scope_inplace(c)
+    (*c).borrows = (*c).borrows.pop_scope()
+    (*c).env = (*c).env.pop_scope()
+    body_ty
+}
+
+fn checker_check_remaining_arms_inplace(c: *mut Checker, opt: Option<Box<MatchArmList> >, scrut_ty: TypeEntry, expected_ty: TypeEntry) with Mut, Panic, Div, Alloc, IO {
+    var cursor = opt
+    while true {
+        match cursor {
+            Some(list) => {
+                let arm_ty = checker_check_match_arm_inplace(c, (*list).head, scrut_ty)
+                if !types_compatible(arm_ty, expected_ty) {
+                    checker_report_mismatch_inplace(c, (*list).head.span, 18, expected_ty, arm_ty)
+                }
+                cursor = (*list).tail
+            }
+            None => break
+        }
+    }
+}
+
+fn checker_check_match_arms_inplace(c: *mut Checker, opt: Option<Box<MatchArmList> >, scrut_ty: TypeEntry) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
+    match opt {
+        Some(list) => {
+            let first_ty = checker_check_match_arm_inplace(c, (*list).head, scrut_ty)
+            checker_check_remaining_arms_inplace(c, (*list).tail, scrut_ty, first_ty)
+            first_ty
+        }
+        None => ty_unit()
+    }
+}
+
+fn checker_check_match_expr_inplace(c: *mut Checker, e: Expr) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
+    let scrut_ty = checker_check_opt_expr_inplace(c, e.left)
+    checker_check_match_arms_inplace(c, e.arms, scrut_ty)
+}
