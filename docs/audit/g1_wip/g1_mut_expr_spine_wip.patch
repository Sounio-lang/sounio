+            None => ty_error()
+        }
+        if alg == 1 {
+            if name_matches_str4(e.name, 114, 101, 97, 108) { inner_ty }
+            else if name_matches_str4(e.name, 105, 109, 97, 103) { inner_ty }
+            else {
+                checker_report_error_at_inplace(c, e.span, 12, 0, 0, 0)
+                ty_error()
+            }
+        } else if alg == 2 {
+            if name_matches_str1(e.name, 119) { inner_ty }
+            else if name_matches_str1(e.name, 120) { inner_ty }
+            else if name_matches_str1(e.name, 121) { inner_ty }
+            else if name_matches_str1(e.name, 122) { inner_ty }
+            else {
+                checker_report_error_at_inplace(c, e.span, 12, 0, 0, 0)
+                ty_error()
+            }
+        } else {
+            inner_ty
+        }
+    } else if base_ty.kind == TypeKind::TyTuple {
+        let idx = (e.name.buf[0] as i64) - 48
+        let tuple_count = type_entry_list_count(base_ty.tuple_elems)
+        if idx >= tuple_count {
+            checker_report_error_at_inplace(c, e.span, 47, 0, 0, 0)
+            ty_error()
+        } else {
+            let elem = type_entry_list_get(base_ty.tuple_elems, idx)
+            elem
+        }
+    } else if is_error_or_unknown(base_ty) {
+        base_ty
+    } else {
+        checker_report_error_at_inplace(c, e.span, 12, 0, 0, 0)
+        ty_error()
+    }
+}
