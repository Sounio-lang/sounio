+// Shared helper: *mut mirror of check_opt_block (16004). Used by ExprIf.
+fn checker_check_opt_block_inplace(c: *mut Checker, opt: Option<Box<Block> >) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
+    match opt {
+        Some(blk) => checker_check_block_inplace(c, *blk)
+        None => ty_unit()
+    }
+}
