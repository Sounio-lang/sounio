+// --- ExprLoop -------------------------------------------------------------
+fn checker_check_loop_expr_inplace(c: *mut Checker, e: Expr) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
+    let _dp = (*c).check_loop_depth(e.span)
+    checker_store_from_value(c, _dp.0)
+    if !_dp.1 {
+        return ty_error()
+    }
+    (*c).loop_depth = (*c).loop_depth + 1
+    (*c).borrows = (*c).borrows.release_exclusive_borrows()
+    match e.block {
+        Some(blk) => {
+            let _bt = checker_check_block_inplace(c, *blk)
+        }
+        None => {}
+    }
+    (*c).loop_depth = (*c).loop_depth - 1
+    ty_unit()
+}
