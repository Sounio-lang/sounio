+fn checker_check_generic_struct_lit_inplace(c: *mut Checker, e: Expr, tmpl: StructInfo) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
+    var inferred = InferBuf { args: [ty_error(); 8] }
+    inferred = checker_infer_type_params_from_fields_inplace(c, e.fields, tmpl, inferred)
+    checker_finalize_generic_struct_lit_inplace(c, e, tmpl, inferred.args)
+}
+
+fn checker_infer_type_params_from_fields_inplace(c: *mut Checker, opt: Option<Box<StructFieldList> >, tmpl: StructInfo, acc: InferBuf) -> InferBuf with Mut, Panic, Div, Alloc, IO {
+    match opt {
+        None => acc
+        Some(fl) => {
+            let field_name = (*fl).head.name
+            let tmpl_field_ty = field_info_list_find(tmpl.fields, field_name)
+            let init_ty = checker_check_expr_inplace(c, (*fl).head.value)
+
+            var buf = acc
+            if tmpl_field_ty.kind == TypeKind::TyNamed {
+                var pi: i64 = 0
+                while pi < tmpl.type_param_count {
+                    if name_eq(tmpl_field_ty.name, tmpl.type_param_names[pi]) {
+                        buf.args[pi] = init_ty
+                        pi = tmpl.type_param_count
+                    } else {
+                        pi = pi + 1
+                    }
+                }
+            }
+            checker_infer_type_params_from_fields_inplace(c, (*fl).tail, tmpl, buf)
+        }
+    }
+}
+
+fn checker_finalize_generic_struct_lit_inplace(c: *mut Checker, e: Expr, tmpl: StructInfo, inferred_args: [TypeEntry; 8]) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
+    var args_list_opt: Option<Box<TypeEntryList> > = None
+    var ai: i64 = tmpl.type_param_count - 1
+    while ai >= 0 {
+        args_list_opt = Some(Box::new(TypeEntryList { head: inferred_args[ai], tail: args_list_opt }))
+        ai = ai - 1
+    }
+
+    match args_list_opt {
+        None => ty_error()
+        Some(args_box) => {
+            let args = *args_box
+            let mangled = mangle_generic_name(tmpl.name, args)
+
+            let existing_idx = (*c).structs.find(mangled)
+            if existing_idx < 0 {
+                let mono_fields = monomorphize_fields(tmpl.fields, tmpl.type_param_count, tmpl.type_param_names, args)
+                let mono_info = StructInfo {
+                    name: mangled,
+                    fields: mono_fields.0,
+                    field_count: mono_fields.1,
+                    is_linear: tmpl.is_linear,
+                    type_param_count: 0,
+                    type_param_names: [Name { buf: [0; 128], len: 0 }; 8],
+                    is_generic_template: false,
+                }
+                (*c).structs = (*c).structs.add(mono_info)
+            }
+
+            let mono_idx = (*c).structs.find(mangled)
+            if mono_idx >= 0 {
+                let mono_si = (*c).structs.get(mono_idx)
+                checker_check_struct_field_inits_inplace(c, e.fields, mono_si, e.span)
+            }
+            ty_named(mangled)
+        }
+    }
+}
+
+fn checker_check_struct_field_inits_inplace(c: *mut Checker, opt: Option<Box<StructFieldList> >, si: StructInfo, lit_span: Span) with Mut, Panic, Div, Alloc, IO {
+    let init_count = struct_field_list_count(opt)
+    if init_count != si.field_count {
+        checker_report_error_at_inplace(c, lit_span, 46, 0, 0, 0)
+        return
+    }
+    checker_check_struct_field_inits_with_type_inplace(c, opt, si)
+}
+
+fn checker_check_struct_field_inits_with_type_inplace(c: *mut Checker, opt: Option<Box<StructFieldList> >, si: StructInfo) with Mut, Panic, Div, Alloc, IO {
+    match opt {
+        Some(list) => {
+            let field_ty = field_info_list_find(si.fields, (*list).head.name)
+            let init_ty = checker_check_expr_inplace(c, (*list).head.value)
+            if !types_compatible(init_ty, field_ty) {
+                checker_report_mismatch_inplace(c, (*list).head.value.span, 16, field_ty, init_ty)
+            }
+            checker_check_struct_field_inits_with_type_inplace(c, (*list).tail, si)
+        }
+        None => ()
+    }
+}
+
+fn checker_check_struct_field_inits_no_type_inplace(c: *mut Checker, opt: Option<Box<StructFieldList> >) with Mut, Panic, Div, Alloc, IO {
+    match opt {
+        Some(list) => {
+            checker_check_expr_inplace(c, (*list).head.value)
+            checker_check_struct_field_inits_no_type_inplace(c, (*list).tail)
+        }
+        None => ()
+    }
+}
