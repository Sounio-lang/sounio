+// --- ExprTupleLit ---------------------------------------------------------
+fn checker_check_tuple_lit_expr_inplace(c: *mut Checker, e: Expr) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
+    var types: [TypeEntry; 16] = [empty_type_entry(); 16]
+    var count: i64 = 0
+    var cur = e.args
+    var done = false
+    while !done {
+        match cur {
+            Some(list) => {
+                if count < 16 {
+                    types[count] = checker_check_expr_inplace(c, (*list).head)
+                    count = count + 1
+                    cur = (*list).tail
+                } else {
+                    done = true
+                }
+            }
+            None => {
+                done = true
+            }
+        }
+    }
+    if count == 0 {
+        return ty_unit()
+    }
+    var elem_list: Option<Box<TypeEntryList> > = None
+    var j = count - 1
+    while j >= 0 {
+        elem_list = Some(Box::new(TypeEntryList { head: types[j], tail: elem_list }))
+        j = j - 1
+    }
+    match elem_list {
+        Some(el) => ty_tuple(*el)
+        None => ty_unit()
+    }
+}
+
+// --- ExprArrayLit ---------------------------------------------------------
+fn checker_check_array_lit_inplace(c: *mut Checker, e: Expr) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
+    match e.left {
+        Some(elem_expr) => match e.right {
+            Some(count_expr) => {
+                let elem_ty = checker_check_expr_inplace(c, *elem_expr)
+                let count_ty = checker_check_expr_inplace(c, *count_expr)
+                if !types_compatible(count_ty, ty_i64()) {
+                    checker_report_mismatch_inplace(c, (*count_expr).span, 20, ty_i64(), count_ty)
+                    return ty_array(elem_ty, 0)
+                }
+                if (*count_expr).kind != ExprKind::ExprIntLit {
+                    checker_report_error_at_inplace(c, (*count_expr).span, 20, 0, 0, 0)
+                    return ty_array(elem_ty, 0)
+                }
+                return ty_array(elem_ty, (*count_expr).int_val)
+            }
+            None => ()
+        }
+        None => ()
+    }
+
+    var elem_ty = ty_error()
+    var count: i64 = 0
+    var first = true
+    var cur = e.args
+    var done = false
+    while !done {
+        match cur {
+            Some(list) => {
+                let this_ty = checker_check_expr_inplace(c, (*list).head)
+                if first {
+                    elem_ty = this_ty
+                    first = false
+                } else {
+                    if !types_compatible(this_ty, elem_ty) {
+                        checker_report_mismatch_inplace(c, (*list).head.span, 20, elem_ty, this_ty)
+                    }
+                }
+                count = count + 1
+                cur = (*list).tail
+            }
+            None => {
+                done = true
+            }
+        }
+    }
+    ty_array(elem_ty, count)
+}
