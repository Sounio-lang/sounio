+// --- ExprIndex ------------------------------------------------------------
+fn checker_check_index_expr_inplace(c: *mut Checker, e: Expr) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
+    let base_ty = checker_check_opt_expr_inplace(c, e.left)
+    let idx_ty = checker_check_opt_expr_inplace(c, e.right)
+    if !is_error_or_unknown(idx_ty) && idx_ty.kind != TypeKind::TyI64 {
+        checker_report_error_at_inplace(c, e.span, 14, 0, 0, 0)
+    }
+    let elem_ty = indexable_elem_type(base_ty)
+    if !is_error_or_unknown(base_ty) && elem_ty.kind == TypeKind::TyError {
+        checker_report_error_at_inplace(c, e.span, 13, 0, 0, 0)
+        ty_error()
+    } else if is_error_or_unknown(base_ty) {
+        base_ty
+    } else {
+        elem_ty
+    }
+}
