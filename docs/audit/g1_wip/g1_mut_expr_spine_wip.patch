+// --- ExprUnary (+ slice-borrow sub-path) ----------------------------------
+fn checker_check_slice_borrow_expr_inplace(c: *mut Checker, e: Expr) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
+    let want_mut = e.un_op == UnaryOp::OpRefMut
+    let borrow_name = unary_operand_name(e.left)
+    match e.left {
+        Some(index_expr) => {
+            let idx_expr = *index_expr
+            if idx_expr.kind != ExprKind::ExprIndex {
+                checker_report_error_at_inplace(c, e.span, 13, 0, 0, 0)
+                return ty_error()
+            }
+            let base_ty = checker_check_opt_expr_inplace(c, idx_expr.left)
+            let result_ty = slice_borrow_result_type(base_ty, want_mut)
+            if result_ty.kind == TypeKind::TyError && !is_error_or_unknown(base_ty) {
+                checker_report_error_at_inplace(c, e.span, 13, 0, 0, 0)
+            }
+            match idx_expr.right {
+                Some(range_expr) => {
+                    if (*range_expr).kind != ExprKind::ExprRange || (*range_expr).bin_op != BinaryOp::OpRange {
+                        checker_report_error_at_inplace(c, e.span, 13, 0, 0, 0)
+                    } else {
+                        match (*range_expr).left {
+                            Some(start_expr) => {
+                                let start_ty = checker_check_expr_inplace(c, *start_expr)
+                                if !is_error_or_unknown(start_ty) && !is_integer_type(start_ty) {
+                                    checker_report_mismatch_inplace(c, e.span, 55, ty_i64(), start_ty)
+                                }
+                            }
+                            None => {
+                                checker_report_error_at_inplace(c, e.span, 13, 0, 0, 0)
+                            }
+                        }
+                        match (*range_expr).right {
+                            Some(end_expr) => {
+                                let end_ty = checker_check_expr_inplace(c, *end_expr)
+                                if !is_error_or_unknown(end_ty) && !is_integer_type(end_ty) {
+                                    checker_report_mismatch_inplace(c, e.span, 55, ty_i64(), end_ty)
+                                }
+                            }
+                            None => {
+                                checker_report_error_at_inplace(c, e.span, 13, 0, 0, 0)
+                            }
+                        }
+                    }
+                }
+                None => {
+                    checker_report_error_at_inplace(c, e.span, 13, 0, 0, 0)
+                }
+            }
+            if borrow_name.len > 0 {
+                if want_mut {
+                    let borrow_result = (*c).borrows.try_exclusive_borrow(borrow_name)
+                    (*c).borrows = borrow_result.0
+                    if borrow_result.1 != 0 {
+                        checker_report_error_at_inplace(c, e.span, borrow_result.1, 0, 0, 0)
+                    }
+                } else {
+                    let borrow_result = (*c).borrows.try_shared_borrow(borrow_name)
+                    (*c).borrows = borrow_result.0
+                    if borrow_result.1 != 0 {
+                        checker_report_error_at_inplace(c, e.span, borrow_result.1, 0, 0, 0)
+                    }
+                }
+            }
+            result_ty
+        }
+        None => {
+            checker_report_error_at_inplace(c, e.span, 13, 0, 0, 0)
+            ty_error()
+        }
+    }
+}
+
+fn checker_check_unary_expr_inplace(c: *mut Checker, e: Expr) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
+    if (e.un_op == UnaryOp::OpRef || e.un_op == UnaryOp::OpRefMut) && expr_is_half_open_range(e.left) {
+        return checker_check_slice_borrow_expr_inplace(c, e)
+    }
+    let operand_ty = checker_check_opt_expr_inplace(c, e.left)
+    let result = unary_result_type(e.un_op, operand_ty)
+    if result.kind == TypeKind::TyError && !is_error_or_unknown(operand_ty) {
+        checker_report_error_at_inplace(c, e.span, 5, 0, 0, 0)
+    }
+    if e.un_op == UnaryOp::OpRef || e.un_op == UnaryOp::OpRefMut {
+        let borrow_name = unary_operand_name(e.left)
+        if borrow_name.len > 0 {
+            if e.un_op == UnaryOp::OpRef {
+                let borrow_result = (*c).borrows.try_shared_borrow(borrow_name)
+                (*c).borrows = borrow_result.0
+                if borrow_result.1 != 0 {
+                    checker_report_error_at_inplace(c, e.span, borrow_result.1, 0, 0, 0)
+                }
+            } else {
+                let borrow_result = (*c).borrows.try_exclusive_borrow(borrow_name)
+                (*c).borrows = borrow_result.0
+                if borrow_result.1 != 0 {
+                    checker_report_error_at_inplace(c, e.span, borrow_result.1, 0, 0, 0)
+                }
+            }
+        }
+    }
+    result
+}
