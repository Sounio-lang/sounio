+// --- ExprCast -------------------------------------------------------------
+fn checker_check_cast_expr_inplace(c: *mut Checker, e: Expr) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
+    let src_ty = checker_check_opt_expr_inplace(c, e.left)
+    match e.cast_type {
+        Some(ty) => {
+            let target_ty = checker_lower_type_expr_mut(c, *ty)
+            let src_is_epistemic = src_ty.kind == TypeKind::TyKnowledge
+                || src_ty.kind == TypeKind::TyIntervention
+                || src_ty.kind == TypeKind::TyCounterfactual
+                || src_ty.kind == TypeKind::TyValidated
+            let tgt_is_epistemic = target_ty.kind == TypeKind::TyKnowledge
+                || target_ty.kind == TypeKind::TyIntervention
+                || target_ty.kind == TypeKind::TyCounterfactual
+                || target_ty.kind == TypeKind::TyValidated
+            if src_is_epistemic && !tgt_is_epistemic {
+                checker_report_error_at_inplace(c, e.span, 171, 0, 0, 0)
+            }
+            if src_ty.unit_id >= 0 && target_ty.unit_id >= 0 {
+                let src_dim = (*c).units.get_dim(src_ty.unit_id)
+                let tgt_dim = (*c).units.get_dim(target_ty.unit_id)
+                if !unit_dim_compatible(src_dim, tgt_dim) {
+                    checker_report_error_at_inplace(c, e.span, 43, 0, 0, 0)
+                }
+            }
+            target_ty
+        }
+        None => ty_error()
+    }
+}
