+// --- ExprBinary -----------------------------------------------------------
+fn checker_check_binary_expr_inplace(c: *mut Checker, e: Expr) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
+    let left_ty = checker_check_opt_expr_inplace(c, e.left)
+    let right_ty = checker_check_opt_expr_inplace(c, e.right)
+
+    if left_ty.kind == TypeKind::TyUnobserved || right_ty.kind == TypeKind::TyUnobserved {
+        let is_cmp = e.bin_op == BinaryOp::OpEq || e.bin_op == BinaryOp::OpNe
+            || e.bin_op == BinaryOp::OpLt || e.bin_op == BinaryOp::OpLe
+            || e.bin_op == BinaryOp::OpGt || e.bin_op == BinaryOp::OpGe
+        if is_cmp {
+            let observe_id: i64 = 13
+            if !has_effect_id((*c).current_effects, (*c).current_effect_count, observe_id) {
+                checker_report_error_at_inplace(c, e.span, 36, 0, 0, 0)
+            }
+        }
+    }
+
+    // [g2-test] op-type check skipped (by-value-self codegen bug); E056/E057/mismatch retained
+
+    if is_knowledge_type(left_ty) || is_knowledge_type(right_ty) {
+        let left_inner = if is_knowledge_type(left_ty) { knowledge_inner(left_ty) } else { left_ty }
+        let right_inner = if is_knowledge_type(right_ty) { knowledge_inner(right_ty) } else { right_ty }
+        if left_inner.kind == TypeKind::TyHyper && right_inner.kind == TypeKind::TyHyper {
+            let hyper_checked = check_hyper_binary(*c, e.span, e.bin_op, left_inner, right_inner)
+            checker_store_from_value(c, hyper_checked.0)
+        }
+        let knowledge_result = knowledge_binary_result(e.bin_op, left_ty, right_ty)
+        if knowledge_result.kind == TypeKind::TyError {
+            checker_report_error_at_inplace(c, e.span, 36, 0, 0, 0)
+        }
+        let result_with_units = (*c).check_binary_units(e.span, e.bin_op, left_ty, right_ty, knowledge_result)
+        checker_store_from_value(c, result_with_units.0)
+        let final_result = result_with_units.1
+        if e.bin_op == BinaryOp::OpMul && left_inner.kind == TypeKind::TyHyper && right_inner.kind == TypeKind::TyHyper {
+            let final_inner = if final_result.kind == TypeKind::TyKnowledge {
+                knowledge_inner(final_result)
+            } else {
+                final_result
+            }
+            if final_inner.kind == TypeKind::TyHyper {
+                let _rh = (*c).record_hyper_expr(e.span, final_inner.algebra_kind, 1, true)
+                checker_store_from_value(c, _rh)
+            }
+        }
+        return final_result
+    }
+
+    if left_ty.kind == TypeKind::TyHyper && right_ty.kind == TypeKind::TyHyper {
+        let hyper_result = check_hyper_binary(*c, e.span, e.bin_op, left_ty, right_ty)
+        checker_store_from_value(c, hyper_result.0)
+        let typed_result = hyper_result.1
+        let result_with_units = (*c).check_binary_units(e.span, e.bin_op, left_ty, right_ty, typed_result)
+        checker_store_from_value(c, result_with_units.0)
+        let final_result = result_with_units.1
+        if e.bin_op == BinaryOp::OpMul && final_result.kind == TypeKind::TyHyper {
+            let _rh = (*c).record_hyper_expr(e.span, final_result.algebra_kind, 1, false)
+            checker_store_from_value(c, _rh)
+        }
+        return final_result
+    }
+
+    let result = binary_result_type(e.bin_op, left_ty, right_ty)
+    if result.kind == TypeKind::TyError && !is_error_or_unknown(left_ty) && !is_error_or_unknown(right_ty) {
+        checker_report_mismatch_inplace(c, e.span, 4, left_ty, right_ty)
+    }
+    if e.bin_op == BinaryOp::OpDiv {
+        let denom_pair = checker_eval_const_int_opt_expr_mut(c, e.right)
+        if denom_pair.0 != 0 && denom_pair.1 == 0 {
+            checker_report_error_at_inplace(c, e.span, 56, 0, 0, 0)
+        }
+    } else if e.bin_op == BinaryOp::OpRem {
+        let denom_pair = checker_eval_const_int_opt_expr_mut(c, e.right)
+        if denom_pair.0 != 0 && denom_pair.1 == 0 {
+            checker_report_error_at_inplace(c, e.span, 57, 0, 0, 0)
+        }
+    }
+    // [g2-test] unit check skipped (by-value-self codegen bug)
+    result
+}
