+fn checker_check_ident_expr_inplace(c: *mut Checker, e: Expr) -> TypeEntry with Mut, Panic, Div, Alloc, IO {
+    let ident_ty = (*c).env.lookup(e.name)
+    if checker_is_linear_type_inplace(c, ident_ty) && (*c).suppress_linear_consume_depth == 0 {
+        if (*c).borrows.is_borrowed(e.name) {
+            checker_report_error_at_inplace(c, e.span, 38, 0, 0, 0)
+        } else {
+            let consume_result = (*c).borrows.consume_linear(e.name)
+            (*c).borrows = consume_result.0
+            if consume_result.1 != 0 {
+                checker_report_error_at_inplace(c, e.span, consume_result.1, 0, 0, 0)
+            }
+        }
+    }
+    ident_ty
+}
