+// BRIDGE PROTOTYPE: real source -> IrModule (via the working lowering) -> native-v2
+// backend -> ELF. Connects load_multimodule_ir's output to the 9-witness-hardened
+// compile_native_v2_preview_to_file, bypassing the crashing old compile_to_obj path.
+// This is the source->ELF path the synthetic emit witnesses model, fed by real source.
+fn run_native_v2_compile_mode(args: ArgList, flag_index: i64) with IO, Mut, Panic, Div, Alloc {
+    let source_path = compiler_mode_source_arg(args, flag_index, "--native-v2-compile")
+    let output_path = compiler_mode_output_path(args, "a.out")
+    let ir_result = load_multimodule_ir(source_path)
+    if !ir_result.ok {
+        print("native-v2-compile: frontend/lowering failed\n")
+        return
+    }
+    let spec = native_resolve_target("x86_64-linux", "auto", true)
+    let rc = compile_native_v2_preview_to_file(&ir_result.module, spec, output_path)
+    if rc != 0 {
+        print("native-v2-compile: FAIL to_file rc=")
+        print_int(rc as i64)
+        print("\n")
+        return
+    }
+    print("native-v2-compile: emitted path=")
+    print(output_path)
+    print(" fns=")
+    print_int(ir_result.module.fn_count)
+    print("\n")
+}
