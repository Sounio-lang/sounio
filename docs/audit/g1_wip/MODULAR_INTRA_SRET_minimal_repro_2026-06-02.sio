//@ run-pass

/* Adapted intra-module SRET forwarding repro for modular path testing (choice 1).
 * Based on the G1-pinned minimal from SRET_FORWARDING_MINIMAL_REPRO_2026-06-02.sio
 * Made compatible with native v2 style mains (returns i32, uses println).
 *
 * On legacy: FAIL (zeroed struct on return-of-call).
 * On modular (when the path supports no-use or we force via driver): should be ALL PASS if lowering handles return-forward of struct call result.
 */

struct S { f0: f64 }

fn ctor() -> S with Mut {
    var p: S = S { f0: 7.0 }
    return p
}

fn make() -> S with Mut {
    return ctor()   // return-position struct-returning call (the buggy forwarding shape)
}

fn main() -> i32 with IO, Mut {
    let s = make()
    if s.f0 > 6.9 {
        println("ALL PASS")
        return 0
    }
    println("FAIL")
    1
}
