// R.2.7 Phase A — control case: alias round-trip in isolation.
//
// This probe SHOULD compile and run, printing 11 then 10. It demonstrates
// that the alias-in-tuple-return pattern works when both modules are
// /tmp/-local rather than stdlib-imported. Compare against core_alias_smoke.sio
// which uses the same pattern but imports from stdlib::random::pcg64_core
// and fails. Conclusion: the typechecker discriminates stdlib-imported
// struct identity from same-dir-imported struct identity under aliases.
//
// Note: this file uses `use alias_isolated_works_mod::{...}` which only
// resolves if a sibling .sio with that name exists in the same dir. The
// purpose is documentation of the experiment, not to actually run.
//
// The control-case command run during R.2.7 Phase A diagnosis:
//   /tmp/alias_cross_mod.sio:    struct Foo + pub fn step
//   /tmp/alias_cross_main.sio:   use alias_cross_mod::{Foo, step}
//                                type Bar = Foo
//                                fn wrap(b: Bar) -> (Bar, i64) { return step(b) }
//   Result: COMPILES, runs, prints 11/10 correctly.

// — Stub for documentation purposes only —
fn main() -> i64 with IO, Mut, Div, Panic {
    println(0)
    return 0
}
