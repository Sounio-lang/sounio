fn inner(p: &[i8; 1024]) -> i64 { (*p)[0] as i64 }
// mimics the extern wrapper: forward a reference-typed param by bare ident
fn outer(cmd: &[i8; 1024]) -> i64 { inner(cmd) }
fn main() -> i32 with IO, Mut, Panic {
    var buf: [i8; 1024] = [0; 1024]
    buf[0] = 65 as i8
    let b = outer(&buf)
    print("fwd = "); print_int(b); print("\n")
    if b == 65 { println("fwd: PASS") } else { println("fwd: FAIL") }
    return 0
}
