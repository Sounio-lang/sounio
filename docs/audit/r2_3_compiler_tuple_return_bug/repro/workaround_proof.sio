// Bind r1.1 to local scalar — if it stays stable, corruption is in pointer slot.
// If it mutates, corruption is in raw memory.
struct S4 { a: i64, b: i64, c: i64, d: i64 }

fn make(seed: i64) -> S4 with Mut, Div, Panic {
    S4 { a: seed, b: seed ^ 17, c: seed ^ 33, d: seed ^ 49 }
}

fn step_inner(s: S4) -> (S4, i64) with Mut, Div, Panic {
    let na = s.a * 16807
    let nb = s.b * 16807 + 1
    let nc = s.c * 16807 + 2
    let nd = s.d * 16807 + 3
    (S4 { a: na, b: nb, c: nc, d: nd }, na + nb + nc + nd)
}

fn step_outer(s: S4) -> (S4, f64) with Mut, Div, Panic {
    let inner = step_inner(s)
    (inner.0, (inner.1 as f64) / 1000000000.0)
}

fn main() with IO, Mut, Div, Panic {
    var rng = make(20260516)
    let r1 = step_outer(rng)
    let f1 = r1.1                // bind to scalar local
    println(f1)                  // early
    println(99)
    rng = r1.0
    let r2 = step_outer(rng)
    rng = r2.0
    println(f1)                  // late — stable if pointer-slot corruption
    println(r1.1)                // for contrast
    println(r2.1)
}
