// Discriminator: after first println(r1.1) corrupts r1.1,
// are r1.0.{a,b,c,d} (the S4 fields at offsets 0..0x18) also corrupted?
struct S4 { a: i64, b: i64, c: i64, d: i64 }
fn make(seed: i64) -> S4 with Mut, Div, Panic {
    S4 { a: seed, b: seed ^ 17, c: seed ^ 33, d: seed ^ 49 }
}
fn step_inner(s: S4) -> (S4, i64) with Mut, Div, Panic {
    let na = s.a * 16807
    let nb = s.b * 16807 + 1
    let nc = s.c * 16807 + 2
    let nd = s.d * 16807 + 3
    (S4 { a: na, b: nb, c: nc, d: nd }, na + nb + nc + nd)
}
fn step_outer(s: S4) -> (S4, f64) with Mut, Div, Panic {
    let inner = step_inner(s)
    (inner.0, (inner.1 as f64) / 1000000000.0)
}
fn main() with IO, Mut, Div, Panic {
    var rng = make(20260516)
    let r1 = step_outer(rng)

    // Snapshot every field BEFORE the first println(r1.1) call:
    println(r1.0.a)   // expect 340497969612
    println(r1.0.b)
    println(r1.0.c)
    println(r1.0.d)
    println(r1.1)     // 1362.073482 — first f64 read; supposedly corrupts subsequent

    // After the f64 print, re-read every field:
    println(r1.0.a)   // still correct? if yes, S4 part intact
    println(r1.0.b)
    println(r1.0.c)
    println(r1.0.d)
    println(r1.1)     // 0.000000 — known to be corrupted
}
