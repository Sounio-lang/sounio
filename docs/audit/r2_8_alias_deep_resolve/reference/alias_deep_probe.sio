// R.2.8 Phase A — Deep alias resolution probe.
//
// Pattern from DISPATCH §2: consumer uses wired API with `var rng = ...;
// rng = r.0`. LHS slot type recorded at `var` time from inferred return
// of pcg64_new (alias type); RHS r.0 has post-1c.5 base type. The 10
// assignment-typecheck sites in lean_single.sio compare directly via
// ST_FTY/ST_FHASH, bypassing ty_eq's k=0 short-circuit.

use stdlib::random::pcg64_core::{
    PcgState, pcg_u128_add, pcg_step,
}

type DstPcg64 = PcgState

fn dst_pcg64_new(seed: i64) -> DstPcg64 with Mut, Div, Panic {
    let inc_hi: i64 = 6364136223846793005
    let inc_lo: i64 = 1442695040888963407
    let s0 = PcgState { state_hi: 0, state_lo: 0, inc_hi: inc_hi, inc_lo: inc_lo }
    let r1 = pcg_step(s0)
    let mid = r1.0
    let add = pcg_u128_add(mid.state_hi, mid.state_lo, 0, seed)
    let s2 = PcgState { state_hi: add.hi, state_lo: add.lo, inc_hi: inc_hi, inc_lo: inc_lo }
    let r2 = pcg_step(s2)
    return r2.0
}

fn dst_pcg64_next_i64(rng: DstPcg64) -> (DstPcg64, i64) with Mut, Div, Panic {
    return pcg_step(rng)
}

// Consumer pattern: var/assign across alias boundary.
fn consume_loop() -> i64 with IO, Mut, Div, Panic {
    var rng: DstPcg64 = dst_pcg64_new(31415)
    var i: i64 = 0
    var acc: i64 = 0
    while i < 4 {
        let r = dst_pcg64_next_i64(rng)
        rng = r.0
        acc = acc ^ r.1
        i = i + 1
    }
    return acc
}

fn main() -> i64 with IO, Mut, Div, Panic {
    println(consume_loop())
    return 0
}
