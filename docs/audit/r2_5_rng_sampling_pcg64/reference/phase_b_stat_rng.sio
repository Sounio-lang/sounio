// R.2.5 Phase B — stat sanity, rng.sio only.

use stdlib::random::rng::{Pcg64, pcg64_new, pcg64_next_f64, pcg64_next_f64_nonzero}

extern "C" {
    fn sqrt(x: f64) -> f64;
    fn log(x: f64) -> f64;
    fn cos(x: f64) -> f64;
}

fn fabs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }
fn pi() -> f64 { 3.14159265358979323846 }

fn check(label: i64, mean: f64, vrnc: f64,
         tm: f64, tv: f64, tol_m: f64, tol_v: f64) -> i64
    with IO, Mut, Div, Panic
{
    println(label)
    println(mean)
    println(vrnc)
    let pm = if fabs(mean - tm) < tol_m { 1 } else { 0 }
    let pv = if fabs(vrnc - tv) < tol_v { 1 } else { 0 }
    println(pm)
    println(pv)
    return pm * pv
}

fn main() -> i64 with IO, Mut, Div, Panic {
    let n: i64 = 20000
    let nf = n as f64
    var fails: i64 = 0
    var r1 = pcg64_new(31415)

    var su: f64 = 0.0
    var sqU: f64 = 0.0
    var i: i64 = 0
    while i < n {
        let rr = pcg64_next_f64(r1)
        r1 = rr.0
        su = su + rr.1
        sqU = sqU + rr.1 * rr.1
        i = i + 1
    }
    let mU = su / nf
    let vU = sqU / nf - mU * mU
    if check(11, mU, vU, 0.5, 0.08333333333333333, 0.01, 0.01) == 0 { fails = fails + 1 }

    var sN: f64 = 0.0
    var sqN: f64 = 0.0
    i = 0
    while i < n {
        let a = pcg64_next_f64_nonzero(r1)
        r1 = a.0
        let b = pcg64_next_f64(r1)
        r1 = b.0
        let z = sqrt(0.0 - 2.0 * log(a.1)) * cos(2.0 * pi() * b.1)
        sN = sN + z
        sqN = sqN + z * z
        i = i + 1
    }
    let mN = sN / nf
    let vN = sqN / nf - mN * mN
    if check(12, mN, vN, 0.0, 1.0, 0.03, 0.05) == 0 { fails = fails + 1 }

    var sE: f64 = 0.0
    var sqE: f64 = 0.0
    i = 0
    while i < n {
        let u = pcg64_next_f64_nonzero(r1)
        r1 = u.0
        let e = 0.0 - log(u.1)
        sE = sE + e
        sqE = sqE + e * e
        i = i + 1
    }
    let mE = sE / nf
    let vE = sqE / nf - mE * mE
    if check(13, mE, vE, 1.0, 1.0, 0.03, 0.06) == 0 { fails = fails + 1 }

    println(0 - 1)
    println(fails)
    return fails
}
