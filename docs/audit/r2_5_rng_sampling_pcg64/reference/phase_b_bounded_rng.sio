// R.2.5 Phase B — rng.sio pcg64_bounded uniformity.
//
// N=20000 draws from pcg64_bounded(rng, 10); each of 10 buckets should have
// count ∈ [N/10 - 3σ, N/10 + 3σ] where σ = √(N·p·(1-p)) with p=0.1.
//   σ = √(20000 · 0.1 · 0.9) = √1800 ≈ 42.43
//   band: [2000 - 127.28, 2000 + 127.28] = [1873, 2127]

use stdlib::random::rng::{Pcg64, pcg64_new, pcg64_bounded}

fn fabs_i64(x: i64) -> i64 { if x < 0 { 0 - x } else { x } }

fn main() -> i64 with IO, Mut, Div, Panic {
    let n: i64 = 20000
    let buckets: i64 = 10
    let lo: i64 = 1873
    let hi: i64 = 2127

    var c0: i64 = 0
    var c1: i64 = 0
    var c2: i64 = 0
    var c3: i64 = 0
    var c4: i64 = 0
    var c5: i64 = 0
    var c6: i64 = 0
    var c7: i64 = 0
    var c8: i64 = 0
    var c9: i64 = 0
    var rng = pcg64_new(31415)
    var i: i64 = 0
    while i < n {
        let r = pcg64_bounded(rng, buckets)
        rng = r.0
        let b = r.1
        if b == 0 { c0 = c0 + 1 }
        else { if b == 1 { c1 = c1 + 1 }
        else { if b == 2 { c2 = c2 + 1 }
        else { if b == 3 { c3 = c3 + 1 }
        else { if b == 4 { c4 = c4 + 1 }
        else { if b == 5 { c5 = c5 + 1 }
        else { if b == 6 { c6 = c6 + 1 }
        else { if b == 7 { c7 = c7 + 1 }
        else { if b == 8 { c8 = c8 + 1 }
        else { if b == 9 { c9 = c9 + 1 } } } } } } } } } }
        i = i + 1
    }
    println(c0) println(c1) println(c2) println(c3) println(c4)
    println(c5) println(c6) println(c7) println(c8) println(c9)
    var fails: i64 = 0
    if c0 < lo { fails = fails + 1 } else { if c0 > hi { fails = fails + 1 } }
    if c1 < lo { fails = fails + 1 } else { if c1 > hi { fails = fails + 1 } }
    if c2 < lo { fails = fails + 1 } else { if c2 > hi { fails = fails + 1 } }
    if c3 < lo { fails = fails + 1 } else { if c3 > hi { fails = fails + 1 } }
    if c4 < lo { fails = fails + 1 } else { if c4 > hi { fails = fails + 1 } }
    if c5 < lo { fails = fails + 1 } else { if c5 > hi { fails = fails + 1 } }
    if c6 < lo { fails = fails + 1 } else { if c6 > hi { fails = fails + 1 } }
    if c7 < lo { fails = fails + 1 } else { if c7 > hi { fails = fails + 1 } }
    if c8 < lo { fails = fails + 1 } else { if c8 > hi { fails = fails + 1 } }
    if c9 < lo { fails = fails + 1 } else { if c9 > hi { fails = fails + 1 } }
    println(0 - 1)
    println(fails)
    return fails
}
