// R.2.5 Phase B — sampling.sio bit-exact vs R.2.4 oracle.
//
// smp_pcg64_new uses canonical pcg-cpp seeding (state=0, step, +seed, step,
// inc=PCG_DEFAULT_INCREMENT_128), so its stream must be bit-identical to
// the R.2.4 oracle at docs/audit/r2_4_pcg64_algorithmic_bug/reference/
// oracle_seed_*.txt for all 4 seeds.

use stdlib::random::sampling::{SmpPcg64, smp_pcg64_new, smp_pcg64_next_i64}

fn emit_first_n(seed: i64, n: i64) with IO, Mut, Div, Panic {
    var rng = smp_pcg64_new(seed)
    var i: i64 = 0
    while i < n {
        let r = smp_pcg64_next_i64(rng)
        rng = r.0
        println(r.1)
        i = i + 1
    }
}

fn main() with IO, Mut, Div, Panic {
    let n: i64 = 64
    println(0)
    emit_first_n(0, n)
    println(1)
    emit_first_n(1, n)
    println(31415)
    emit_first_n(31415, n)
    println(20260516)
    emit_first_n(20260516, n)
}
