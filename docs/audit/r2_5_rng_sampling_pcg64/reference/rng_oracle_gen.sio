// R.2.5 Phase B — generate rng.sio self-oracle.
//
// rng.sio uses splitmix64-derived seeding (different from pcg-cpp canonical),
// so its stream cannot bit-match the R.2.4 oracle. Instead, commit its own
// oracle as a regression guard: 4 seeds × 256 samples.

use stdlib::random::rng::{Pcg64, pcg64_new, pcg64_next_i64}

fn emit_first_n(seed: i64, n: i64) with IO, Mut, Div, Panic {
    var rng = pcg64_new(seed)
    var i: i64 = 0
    while i < n {
        let r = pcg64_next_i64(rng)
        rng = r.0
        println(r.1)
        i = i + 1
    }
}

fn main() with IO, Mut, Div, Panic {
    let n: i64 = 256
    println(0)
    emit_first_n(0, n)
    println(1)
    emit_first_n(1, n)
    println(31415)
    emit_first_n(31415, n)
    println(20260516)
    emit_first_n(20260516, n)
}
