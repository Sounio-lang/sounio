//@ run-pass
//@ expect-stdout: SYN004_POSTFIX_OK

struct Syn004Cell {
    value: i64,
}
fn add(a: i64, b: i64) -> i64 {
    a + b
}

fn main() -> i32 with IO {
    let values = [4, 5]
    let cell = Syn004Cell { value: 3 }
    if add(cell.value, values[1]) == 8 {
        println("SYN004_POSTFIX_OK")
        return 0
    }
    println("SYN004_POSTFIX_FAIL")
    1
}
