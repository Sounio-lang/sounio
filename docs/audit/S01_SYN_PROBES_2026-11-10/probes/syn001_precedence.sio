//@ run-pass
//@ expect-stdout: SYN001_PRECEDENCE_OK

fn main() -> i32 with IO {
    let multiply_before_add = 1 + 2 * 3
    let add_before_shift = 1 << 2 + 1
    let left_associative = 20 - 5 - 3
    if multiply_before_add == 7 && add_before_shift == 8 && left_associative == 12 {
        println("SYN001_PRECEDENCE_OK")
        return 0
    }
    println("SYN001_PRECEDENCE_FAIL")
    1
}
