//@ run-pass
//@ expect-stdout: SYN009_PATTERNS_OK

enum Syn009Light {
    Red,
    Amber,
    Green,
}
fn classify(light: Syn009Light) -> i64 {
    match light {
        Syn009Light::Amber => 2,
        _ => 0,
    }
}

fn main() -> i32 with IO {
    if classify(Syn009Light::Amber) == 2 {
        println("SYN009_PATTERNS_OK")
        return 0
    }
    println("SYN009_PATTERNS_FAIL")
    1
}
