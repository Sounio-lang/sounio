// Test the annotated-alias path.
// Original gate asserts the witness contains:
//   `let alias: &!RefFieldCollision = pair` and `(*alias).second = value`

struct RefFieldCollision {
    second: f64,
    guard: f64,
}

fn write_via_annotated_alias(pair: &!RefFieldCollision, value: f64) with Mut {
    let alias: &!RefFieldCollision = pair
    (*alias).second = value
}

fn main() -> i64 with IO, Mut {
    var collision = RefFieldCollision { second: 7.5, guard: 101.5 }

    print("before: second=")
    print_f64(collision.second)
    print(" guard=")
    print_f64(collision.guard)
    print("\n")

    write_via_annotated_alias(&!collision, 8.5)
    print("after:  second=")
    print_f64(collision.second)
    print(" guard=")
    print_f64(collision.guard)
    print("\n")

    print("expected after: second=8.5 guard=101.5\n")
    0
}