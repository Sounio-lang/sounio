// Store witness via function parameter (matches the original witness pattern):
// the store is on a `&!RefFieldPair`, so `(*pair).second = value` is type-valid.
// If the explicit-deref store path is broken in current main, the value 44.5
// never reaches the caller's pair.

struct RefFieldPair {
    first: i64,
    second: f64,
}

fn write_auto(pair: &!RefFieldPair, value: f64) with Mut {
    pair.second = value
}

fn write_explicit(pair: &!RefFieldPair, value: f64) with Mut {
    (*pair).second = value
}

fn main() -> i64 with IO, Mut {
    var pair = RefFieldPair { first: 11, second: 22.5 }

    print("before:           first=")
    print_int(pair.first)
    print(" second=")
    print_f64(pair.second)
    print("\n")

    write_auto(&!pair, 33.5)
    print("after auto:       first=")
    print_int(pair.first)
    print(" second=")
    print_f64(pair.second)
    print("\n")

    write_explicit(&!pair, 44.5)
    print("after explicit:   first=")
    print_int(pair.first)
    print(" second=")
    print_f64(pair.second)
    print("\n")

    print("expected after explicit: second=44.5\n")
    0
}