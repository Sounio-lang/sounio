// Test: explicit-deref write on a collision struct with NO prior state.
// This is the controlled case — should work, demonstrating the bug is
// triggered by prior state accumulation.

struct RefFieldCollision {
    second: f64,
    guard: f64,
}

fn write_collision_direct(pair: &!RefFieldCollision, value: f64) with Mut {
    (*pair).second = value
}

fn main() -> i64 with IO, Mut {
    var collision = RefFieldCollision { second: 7.5, guard: 101.5 }

    print("before: second=")
    print_f64(collision.second)
    print(" guard=")
    print_f64(collision.guard)
    print("\n")

    write_collision_direct(&!collision, 8.5)
    print("after:  second=")
    print_f64(collision.second)
    print(" guard=")
    print_f64(collision.guard)
    print("\n")

    print("expected after: second=8.5 guard=101.5\n")
    0
}