// Minimal witness: just the read path, to isolate whether (*pair).field
// on a shared reference returns the correct value in current main.

struct RefFieldPair {
    first: i64,
    second: f64,
}

fn read_auto(pair: &RefFieldPair) -> f64 {
    pair.second
}

fn read_explicit(pair: &RefFieldPair) -> f64 {
    (*pair).second
}

fn main() -> i64 with IO {
    var pair = RefFieldPair { first: 11, second: 22.5 }
    print("auto=")
    print_f64(read_auto(&pair))
    print(" explicit=")
    print_f64(read_explicit(&pair))
    print("\n")
    print("expected=22.5\n")
    0
}