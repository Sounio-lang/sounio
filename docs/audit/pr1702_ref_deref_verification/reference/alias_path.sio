// Test the local-alias path: `let alias = pair; (*alias).second = value`
// This is a let-bound mutable-reference alias. The gate asserts:
//   `let alias = pair` and `(*alias).second = value` both exist in the witness.

struct RefFieldPair {
    first: i64,
    second: f64,
}

fn write_via_local_alias(pair: &!RefFieldPair, value: f64) with Mut {
    let alias = pair
    (*alias).second = value
}

fn main() -> i64 with IO, Mut {
    var pair = RefFieldPair { first: 11, second: 22.5 }

    print("before: second=")
    print_f64(pair.second)
    print("\n")

    write_via_local_alias(&!pair, 55.5)
    print("after:  second=")
    print_f64(pair.second)
    print("\n")

    print("expected after: second=55.5\n")
    0
}