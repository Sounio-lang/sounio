// Test local_borrow_keeps_layout from the original witness.
// This is the most complex path: var local, then let alias = &!local,
// then (*alias).second = ..., then read back.

struct RefFieldCollision {
    second: f64,
    guard: f64,
}

fn local_borrow_keeps_layout() -> i64 with Mut {
    var local = RefFieldCollision { second: 12.5, guard: 99.5 }
    let alias = &!local
    (*alias).second = 77.5
    if (*alias).second == 77.5 && (*alias).guard == 99.5 { 1 } else { 0 }
}

fn main() -> i64 with IO, Mut {
    let r = local_borrow_keeps_layout()
    print("local_borrow_keeps_layout returned ")
    print_int(r)
    print(" (expected 1)\n")
    0
}