// Test: does prior writes to RefFieldPair corrupt the layout of RefFieldCollision?

struct RefFieldPair {
    first: i64,
    second: f64,
    samples: [f64; 2],
}

struct RefFieldCollision {
    second: f64,
    guard: f64,
}

fn write_pair_explicit(pair: &!RefFieldPair, value: f64) with Mut {
    (*pair).second = value
}

fn write_via_annotated_alias(pair: &!RefFieldCollision, value: f64) with Mut {
    let alias: &!RefFieldCollision = pair
    (*alias).second = value
}

fn main() -> i64 with IO, Mut {
    // Phase 1: extensive writes to a different struct type, via function.
    var pair = RefFieldPair { first: 11, second: 22.5, samples: [3.5, 4.5] }
    pair.second = 33.5
    write_pair_explicit(&!pair, 44.5)
    pair.samples[1] = 6.5

    // Phase 2: now declare collision and try the annotated-alias write.
    var collision = RefFieldCollision { second: 7.5, guard: 101.5 }

    print("before: second=")
    print_f64(collision.second)
    print(" guard=")
    print_f64(collision.guard)
    print("\n")

    write_via_annotated_alias(&!collision, 8.5)
    print("after:  second=")
    print_f64(collision.second)
    print(" guard=")
    print_f64(collision.guard)
    print("\n")

    print("expected after: second=8.5 guard=101.5\n")
    0
}