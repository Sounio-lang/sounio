// Combined witness — same operations as the original, but using print
// instead of assert, so we can see which line panics.

struct RefFieldPair {
    first: i64,
    second: f64,
    samples: [f64; 2],
}

struct RefFieldCollision {
    second: f64,
    guard: f64,
}

fn read_auto(pair: &RefFieldPair) -> f64 { pair.second }
fn read_explicit(pair: &RefFieldPair) -> f64 { (*pair).second }
fn read_mut_explicit(pair: &!RefFieldPair) -> f64 { (*pair).second }
fn read_array_explicit(pair: &RefFieldPair) -> f64 with Panic { (*pair).samples[1] }

fn write_auto(pair: &!RefFieldPair, value: f64) with Mut { pair.second = value }
fn write_explicit(pair: &!RefFieldPair, value: f64) with Mut { (*pair).second = value }
fn write_array_explicit(pair: &!RefFieldPair, value: f64) with Mut, Panic { (*pair).samples[1] = value }
fn write_via_local_alias(pair: &!RefFieldPair, value: f64) with Mut {
    let alias = pair
    (*alias).second = value
}
fn write_via_annotated_alias(pair: &!RefFieldCollision, value: f64) with Mut {
    let alias: &!RefFieldCollision = pair
    (*alias).second = value
}

fn local_borrow_keeps_layout() -> i64 with Mut {
    var local = RefFieldCollision { second: 12.5, guard: 99.5 }
    let alias = &!local
    (*alias).second = 77.5
    if (*alias).second == 77.5 && (*alias).guard == 99.5 { 1 } else { 0 }
}

fn check(label: string, expected: i64, actual: i64) with IO {
    if expected == actual {
        print("OK  ")
        print(label)
        print("\n")
    } else {
        print("BAD ")
        print(label)
        print(" expected=")
        print_int(expected)
        print(" actual=")
        print_int(actual)
        print("\n")
    }
}

fn check_f(label: string, expected: f64, actual: f64) with IO {
    if expected == actual {
        print("OK  ")
        print(label)
        print("\n")
    } else {
        print("BAD ")
        print(label)
        print(" expected=")
        print_f64(expected)
        print(" actual=")
        print_f64(actual)
        print("\n")
    }
}

fn main() -> i64 with IO, Mut, Panic {
    var pair = RefFieldPair { first: 11, second: 22.5, samples: [3.5, 4.5] }

    print("step 1: reads\n")
    check_f("read_auto",       22.5, read_auto(&pair))
    check_f("read_explicit",   22.5, read_explicit(&pair))
    check_f("read_mut_explicit", 22.5, read_mut_explicit(&!pair))
    check_f("read_array_explicit", 4.5, read_array_explicit(&pair))

    print("step 2: writes\n")
    write_auto(&!pair, 33.5)
    check("auto first", 11, pair.first)
    check_f("auto second", 33.5, pair.second)

    write_explicit(&!pair, 44.5)
    check("explicit first", 11, pair.first)
    check_f("explicit second", 44.5, pair.second)

    write_array_explicit(&!pair, 6.5)
    check_f("array_explicit [0]", 3.5, pair.samples[0])
    check_f("array_explicit [1]", 6.5, pair.samples[1])

    write_via_local_alias(&!pair, 55.5)
    check("local_alias first", 11, pair.first)
    check_f("local_alias second", 55.5, pair.second)

    print("step 3: annotated alias + collision\n")
    var collision = RefFieldCollision { second: 7.5, guard: 101.5 }
    write_via_annotated_alias(&!collision, 8.5)
    check_f("collision second", 8.5, collision.second)
    check_f("collision guard", 101.5, collision.guard)
    check("local_borrow_keeps_layout", 1, local_borrow_keeps_layout())

    print("step 4: end\n")
    print("DONE ref_field_autoderef_semantics\n")
    0
}