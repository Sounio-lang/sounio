//@ compile-fail
//@ error-pattern: E014

// Positive control for #887 ambiguity detection.
// Imports `same_public_name` from TWO modules without aliasing.
// The compiler must emit E014 (ambiguous_name) at the call site.
// Currently E014 is repurposed for index-type errors and never fires
// for name ambiguity in current main's checker — see self-hosted/check/check.sio
// (the only `report_error_at(.., 14, ..)` calls are in check_index_expr for
// non-i64 index types, NOT in name resolution).
//
// Strong5 is the non-vacuous control: if a future fix adds ambiguity
// detection, this witness must be re-run and E014 must appear.
use ambiguous_public_a::{same_public_name}
use ambiguous_public_b::{same_public_name}

fn main() -> i64 {
    same_public_name()
}
