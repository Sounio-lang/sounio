// Stronger ambiguous-public witness.
// Imports BOTH `same_public_name` symbols via `as` aliases, then calls
// `same_public_name()` unaliased. The compiler must reject this with
// an ambiguity error (NOT "undeclared variable" — the symbol IS in scope,
// it's just bound twice). If it picks one by collection order, the test
// fails.
use ambiguous_public_a::{same_public_name as name_a}
use ambiguous_public_b::{same_public_name as name_b}

fn main() -> i64 {
    same_public_name()
}
