// Test: direct `(*pair).second = value` (no alias) on the collision type
// after prior activity. If the bug is in the alias path, this should pass.

struct RefFieldPair {
    first: i64,
    second: f64,
    samples: [f64; 2],
}

struct RefFieldCollision {
    second: f64,
    guard: f64,
}

fn write_pair_explicit(pair: &!RefFieldPair, value: f64) with Mut {
    (*pair).second = value
}

fn write_collision_direct(pair: &!RefFieldCollision, value: f64) with Mut {
    (*pair).second = value
}

fn main() -> i64 with IO, Mut {
    var pair = RefFieldPair { first: 11, second: 22.5, samples: [3.5, 4.5] }
    pair.second = 33.5
    write_pair_explicit(&!pair, 44.5)

    var collision = RefFieldCollision { second: 7.5, guard: 101.5 }

    print("before: second=")
    print_f64(collision.second)
    print(" guard=")
    print_f64(collision.guard)
    print("\n")

    write_collision_direct(&!collision, 8.5)
    print("after:  second=")
    print_f64(collision.second)
    print(" guard=")
    print_f64(collision.guard)
    print("\n")

    print("expected after: second=8.5 guard=101.5\n")
    0
}