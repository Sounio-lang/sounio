// Witness: encode which marginal endpoint fails the >0 gate.
// Exit: 0=all ok; 211=vc_lo; 212=vc_hi; 213=cl_lo; 214=cl_hi; 215=band inverted

use clinical::vancomycin_pbpk::*
use epistemic::knightian::*

fn main() -> i32 with Mut, Div, Panic {
    let weight: f64 = 70.0
    let crcl: f64 = 80.0
    let dose: f64 = 1500.0
    let tau: f64 = 12.0
    let tdm: i64 = 3

    let params = vp_default(weight, crcl)
    let vc_box = vp_vc_to_pbox(&params, tdm)
    let cl_box = vp_cl_to_pbox(&params, tdm)
    let pbox = predict_cmin_knightian(weight, crcl, dose, tau, tdm)

    let vc_lo = pb_lo_mean(&vc_box)
    let vc_hi = pb_hi_mean(&vc_box)
    let cl_lo = pb_lo_mean(&cl_box)
    let cl_hi = pb_hi_mean(&cl_box)
    let cmin_lo_band = pb_lo_mean(&pbox)
    let cmin_hi_band = pb_hi_mean(&pbox)

    if vc_lo <= 0.0 { return 211 }
    if vc_hi <= 0.0 { return 212 }
    if cl_lo <= 0.0 { return 213 }
    if cl_hi <= 0.0 { return 214 }
    if vc_lo > vc_hi || cl_lo > cl_hi || cmin_lo_band > cmin_hi_band { return 215 }
    return 0
}