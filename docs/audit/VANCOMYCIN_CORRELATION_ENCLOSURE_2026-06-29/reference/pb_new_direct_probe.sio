// Control: pb_new called from main (no vp_vc_to_pbox). Exit 0 if lo_mean > 0 else 211.

use epistemic::knightian::*

fn main() -> i32 with Mut, Div, Panic {
    let vc = 35.0
    let frac = 0.10
    let lo = (1.0 - frac) * vc
    let hi = (1.0 + frac) * vc
    let box = pb_new(lo, hi, 0.0025 * vc * vc, 920)
    let vc_lo = pb_lo_mean(&box)
    if vc_lo <= 0.0 { return 211 }
    return 0
}