// Witness: vp_vc_to_pbox marginal read only. Exit 0 if pb_lo_mean > 0 else 211.

use clinical::vancomycin_pbpk::*
use epistemic::knightian::*

fn main() -> i32 with Mut, Div, Panic {
    let params = vp_default(70.0, 80.0)
    let vc_box = vp_vc_to_pbox(&params, 3)
    let vc_lo = pb_lo_mean(&vc_box)
    if vc_lo <= 0.0 { return 211 }
    return 0
}