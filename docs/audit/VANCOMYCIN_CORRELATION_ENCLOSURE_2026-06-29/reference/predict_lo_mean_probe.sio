// Witness: predict_cmin_knightian → pb_lo_mean (not vp_vc_to_pbox). Exit 211 if lo<=0.

use clinical::vancomycin_pbpk::*
use epistemic::knightian::pb_lo_mean

fn main() -> i32 with Mut, Div, Panic {
    let p = predict_cmin_knightian(70.0, 80.0, 1500.0, 12.0, 3)
    let lo = pb_lo_mean(&p)
    if lo <= 0.0 { return 211 }
    return 0
}