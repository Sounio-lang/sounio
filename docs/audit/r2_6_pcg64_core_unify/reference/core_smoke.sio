// R.2.6 Phase A smoke — import and exercise each pcg64_core helper.

use stdlib::random::pcg64_core::{
    PcgU128, pcg_u_lt, pcg_lshr, pcg_umul64_high,
    pcg_u128_add, pcg_u128_mul, pcg_rotr64, pcg_umod,
}

fn main() -> i64 with IO, Mut, Div, Panic {
    // pcg_u_lt: -1 as u64 (= max u64) > 0 unsigned.
    let lt1 = pcg_u_lt(0 - 1, 0)
    println(if lt1 { 1 } else { 0 })   // expect 0

    let lt2 = pcg_u_lt(0, 0 - 1)
    println(if lt2 { 1 } else { 0 })   // expect 1

    // pcg_lshr: (-1) >>u 1 = 0x7FFFFFFFFFFFFFFF = 9223372036854775807
    println(pcg_lshr(0 - 1, 1))         // expect 9223372036854775807

    // pcg_rotr64(1, 1) = 0x8000000000000000 = i64::MIN = -9223372036854775808
    println(pcg_rotr64(1, 1))

    // pcg_umul64_high(2^32, 2^32) = 2^64 high = 1
    let big: i64 = 4294967296
    println(pcg_umul64_high(big, big))   // expect 1

    // pcg_u128_add: (0, -1) + (0, 1) = (1, 0) — carry into hi.
    let add = pcg_u128_add(0, 0 - 1, 0, 1)
    println(add.hi)                       // expect 1
    println(add.lo)                       // expect 0

    // pcg_u128_mul: (0, 2) * (0, 3) = (0, 6).
    let mul = pcg_u128_mul(0, 2, 0, 3)
    println(mul.hi)                       // expect 0
    println(mul.lo)                       // expect 6

    // pcg_umod: u64(-1) % 10 = (2^64 - 1) % 10 = 5.
    println(pcg_umod(0 - 1, 10))          // expect 5

    // pcg_umod power-of-two fast path: x % 8.
    println(pcg_umod(13, 8))              // expect 5

    return 0
}
