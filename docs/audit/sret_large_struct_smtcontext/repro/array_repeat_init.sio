// REPRODUCIBLE compiler bug: local `var` array repeat-literal [X; N] drops the
// fill value X (array stays zeroed) for any nonzero X — even a literal.
// Struct-field array literals are NOT affected; manual element assignment works.
//
//   ./bin/souc docs/audit/sret_large_struct_smtcontext/repro/array_repeat_init.sio /tmp/a.elf
//   chmod +x /tmp/a.elf && /tmp/a.elf
//
// Expected (correct):  f -> 5 5
// Observed (bug):      f -> 0 0

fn main() -> i32 with IO, Mut, Panic {
    var z: [i64; 4] = [0; 4]
    var f: [i64; 4] = [5; 4]
    var g: [i64; 4] = [0; 4]
    g[0] = 5
    g[1] = 5
    g[2] = 5
    g[3] = 5
    print("z (init [0;4]):  "); print_int(z[0 as usize]); print(" "); print_int(z[3 as usize]); print(" (expect 0 0)\n")
    print("f (init [5;4]):  "); print_int(f[0 as usize]); print(" "); print_int(f[3 as usize]); print(" (expect 5 5)\n")
    print("g (manual =5):   "); print_int(g[0 as usize]); print(" "); print_int(g[3 as usize]); print(" (expect 5 5)\n")
    return 0
}
