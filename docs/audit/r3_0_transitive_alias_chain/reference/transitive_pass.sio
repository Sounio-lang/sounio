// R.3.0 control case: direct alias of imported struct — PASSES under souc HEAD.
//
// `use pcg64_core::PcgState` + `type Pcg64 = PcgState` in the *same* file
// resolves correctly: pcg_step's `(PcgState, i64)` return + `var current; current = r.0`
// assignment matches.

use stdlib::random::pcg64_core::{PcgState, pcg_step}

type LocalPcg = PcgState

fn loop(seed: i64) -> i64 with Mut {
    var current = PcgState { state_hi: 0, state_lo: 0, inc_hi: 1, inc_lo: 1 }
    var i: i64 = 0
    while i < 3 {
        let r = pcg_step(current)
        current = r.0
        i = i + 1
    }
    return current.state_hi
}

fn main() -> i64 with IO, Mut {
    println(loop(42))
    return 0
}
