// R.3.0 reproducer (lib): re-aliases an imported struct.
//
// Pattern: module A defines struct S; module B does `use A::S; type T = S` +
// exports B-aliased wrappers; module C imports B::{T, ...} and uses T's API.
// This two-hop chain is what `rng.sio = type Pcg64 = pcg64_core::PcgState`
// creates when a third module imports `rng::Pcg64`.

use stdlib::random::pcg64_core::{PcgState, pcg_step}

pub type Pcg64 = PcgState

pub fn pcg64_new(seed: i64) -> Pcg64 {
    return PcgState { state_hi: seed, state_lo: 0, inc_hi: 1, inc_lo: 1 }
}

pub fn pcg64_next_i64(rng: Pcg64) -> (Pcg64, i64) { return pcg_step(rng) }
