// R.3.0 bisect step 1: add RngPcgWrapper struct field of aliased type.
use stdlib::random::pcg64_core::{PcgState, pcg_step}

pub struct SplitMix64 { state: i64 }
pub fn splitmix64_new(seed: i64) -> SplitMix64 { return SplitMix64 { state: seed } }
pub fn splitmix64_next(rng: SplitMix64) -> (SplitMix64, i64) {
    return (SplitMix64 { state: rng.state + 1 }, rng.state)
}

pub type Pcg64 = PcgState

pub fn pcg64_new(seed: i64) -> Pcg64 {
    var sm = splitmix64_new(seed)
    let r1 = splitmix64_next(sm)
    return PcgState { state_hi: r1.1, state_lo: 0, inc_hi: 1, inc_lo: 1 }
}

pub fn pcg64_next_i64(rng: Pcg64) -> (Pcg64, i64) { return pcg_step(rng) }

pub struct RngPcgWrapper { rng: Pcg64 }

pub fn rng_pcg_new(seed: i64) -> RngPcgWrapper {
    RngPcgWrapper { rng: pcg64_new(seed) }
}

pub fn rng_pcg_next_i64(state: RngPcgWrapper) -> (RngPcgWrapper, i64) {
    let result = pcg64_next_i64(state.rng)
    (RngPcgWrapper { rng: result.0 }, result.1)
}

pub struct RngXoshiro256 { s0: i64, s1: i64, s2: i64, s3: i64 }

pub fn xoshiro256_new(seed: i64) -> RngXoshiro256 {
    var sm = splitmix64_new(seed)
    let r1 = splitmix64_next(sm)
    sm = r1.0
    let r2 = splitmix64_next(sm)
    sm = r2.0
    let r3 = splitmix64_next(sm)
    sm = r3.0
    let r4 = splitmix64_next(sm)
    RngXoshiro256 { s0: r1.1, s1: r2.1, s2: r3.1, s3: r4.1 }
}

pub fn pcg64_next_f64(rng: Pcg64) -> (Pcg64, f64) {
    let result = pcg64_next_i64(rng)
    let fraction = (result.1 as f64) / 9007199254740992.0
    return (result.0, fraction)
}

pub fn pcg64_next_f64_nonzero(rng: Pcg64) -> (Pcg64, f64) {
    var current = rng
    var attempts = 0
    while attempts < 10 {
        let result = pcg64_next_f64(current)
        current = result.0
        if result.1 > 0.0 {
            return (current, result.1)
        }
        attempts = attempts + 1
    }
    (current, 0.0000001)
}
