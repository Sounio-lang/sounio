use transitive_lib2::{Pcg64, pcg64_new, pcg64_next_i64}

fn loop(seed: i64) -> i64 with Mut {
    var rng = pcg64_new(seed)
    var i: i64 = 0
    while i < 3 {
        let r = pcg64_next_i64(rng)
        rng = r.0
        i = i + 1
    }
    return rng.state_hi
}

fn main() -> i64 with IO, Mut {
    println(loop(42))
    return 0
}
