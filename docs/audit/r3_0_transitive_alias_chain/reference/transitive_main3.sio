use transitive_lib3::{Pcg64, pcg64_new, pcg64_next_i64, RngPcgWrapper, rng_pcg_new, rng_pcg_next_i64}

fn loop(seed: i64) -> i64 with Mut {
    var rng = pcg64_new(seed)
    let r = pcg64_next_i64(rng)
    rng = r.0
    return rng.state_hi
}

fn main() -> i64 with IO, Mut {
    println(loop(42))
    return 0
}
