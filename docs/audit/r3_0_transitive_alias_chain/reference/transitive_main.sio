// R.3.0 reproducer (consumer): imports the re-aliased type via two-hop chain.
//
// EXPECTED FAILURE under souc HEAD (R.2.9 baseline): the consumer-side
// `var rng = pcg64_new(seed); rng = r.0` assignment is rejected with
// "assignment type mismatch" because alias resolution doesn't propagate
// through `Pcg64 → PcgState` when Pcg64 is imported (only single-hop
// aliases inside one module are handled).

use transitive_lib::{Pcg64, pcg64_new, pcg64_next_i64}

fn loop(seed: i64) -> i64 with Mut {
    var rng = pcg64_new(seed)
    var i: i64 = 0
    while i < 3 {
        let r = pcg64_next_i64(rng)
        rng = r.0
        i = i + 1
    }
    return rng.state_hi
}

fn main() -> i64 with IO, Mut {
    println(loop(42))
    return 0
}
