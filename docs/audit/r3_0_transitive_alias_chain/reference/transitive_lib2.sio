// R.3.0 expanded reproducer (lib): re-alias + extra state machine (splitmix64).
// Matches rng.sio shape more closely than transitive_lib.sio.

use stdlib::random::pcg64_core::{PcgState, pcg_step}

pub struct SplitMix64 { state: i64 }

pub fn splitmix64_new(seed: i64) -> SplitMix64 { return SplitMix64 { state: seed } }

pub fn splitmix64_next(rng: SplitMix64) -> (SplitMix64, i64) {
    return (SplitMix64 { state: rng.state + 1 }, rng.state)
}

pub type Pcg64 = PcgState

pub fn pcg64_new(seed: i64) -> Pcg64 {
    var sm = splitmix64_new(seed)
    let r1 = splitmix64_next(sm)
    sm = r1.0
    let s1 = r1.1
    let r2 = splitmix64_next(sm)
    let s2 = r2.1
    return PcgState { state_hi: s1, state_lo: s2, inc_hi: 1, inc_lo: 1 }
}

pub fn pcg64_next_i64(rng: Pcg64) -> (Pcg64, i64) { return pcg_step(rng) }
