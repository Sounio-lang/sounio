// Trace xsl_rr step-by-step on known state for seed=0.
use pcg64_reference::{DstPcg64, pcg64_new, lshr, rotr64}

fn main() with IO, Mut, Div, Panic {
    let rng = pcg64_new(0)
    let old_hi = rng.state_hi
    let old_lo = rng.state_lo
    println(old_hi)                              // expect 5220163216168088568
    println(old_lo)                              // expect -6043960321096071782

    let xorshifted = old_hi ^ old_lo
    println(xorshifted)                          // ?

    let rot_raw = lshr(old_hi, 58)
    println(rot_raw)                             // top 6 bits of state_hi, then & 63 later
    let rot = rot_raw & 63
    println(rot)                                 // expect (state_hi >> 122 of u128) — pcg-cpp had rot for this state

    let output = rotr64(xorshifted, rot)
    println(output)                              // expect 74029666500212977 if matching pcg-cpp
}
