// First 8 PCG64-XSL-RR-128/64 samples for cross-check seeds.
//
// Cross-check spec for operator's external pcg-cpp `pcg64`:
//   pcg64 rng(seed)
//   for i = 0..8: print rng()
//
// Compare line-by-line.

use pcg64_reference::{DstPcg64, pcg64_new, pcg64_step}

fn emit_first_n(seed: i64, n: i64) with IO, Mut, Div, Panic {
    var rng = pcg64_new(seed)
    var i: i64 = 0
    while i < n {
        let r = pcg64_step(rng)
        rng = r.0
        println(r.1)
        i = i + 1
    }
}

fn main() with IO, Mut, Div, Panic {
    println(0)             // seed marker
    emit_first_n(0, 8)
    println(1)
    emit_first_n(1, 8)
    println(31415)
    emit_first_n(31415, 8)
    println(20260516)
    emit_first_n(20260516, 8)
}
