// Self-test for PCG64 128-bit emulation helpers.
// Each test prints expected then actual; manual eyeball verification.

use pcg64_reference::{u_lt, lshr, umul64_high, u128_add, u128_mul, rotr64, U128}

fn main() with IO, Mut, Div, Panic {
    // ─── lshr ─────────────────────────────────────────────────────────────
    println(0)  // lshr expected vs actual section
    // lshr(-1, 1) should give 0x7FFFFFFFFFFFFFFF = 9223372036854775807
    println(9223372036854775807)
    println(lshr(0 - 1, 1))

    // lshr(0x4000000000000000, 62) = 1
    println(1)
    println(lshr(4611686018427387904, 62))  // 0x4000000000000000

    // ─── umul64_high ──────────────────────────────────────────────────────
    println(1)  // umul64_high section
    // (2^32) * (2^32) = 2^64 → high 64 = 1
    println(1)
    println(umul64_high(4294967296, 4294967296))

    // (2^33) * (2^33) = 2^66 → high 64 = 4
    println(4)
    println(umul64_high(8589934592, 8589934592))

    // (2^60) * (2^60) = 2^120 → high 64 = 2^56 = 72057594037927936
    println(72057594037927936)
    println(umul64_high(1152921504606846976, 1152921504606846976))

    // (2^63) * 2 = 2^64 → high 64 = 1
    // 2^63 as i64 = i64::MIN = -9223372036854775808; reinterpret as u64 = 2^63
    println(1)
    println(umul64_high(0 - 9223372036854775808, 2))

    // ─── u128_add ─────────────────────────────────────────────────────────
    println(2)  // u128_add section
    // (0, u64::MAX) + (0, 1) = (1, 0)
    let a1 = u128_add(0, 0 - 1, 0, 1)
    println(1)
    println(a1.hi)
    println(0)
    println(a1.lo)

    // (0, 1) + (0, 2) = (0, 3)
    let a2 = u128_add(0, 1, 0, 2)
    println(0)
    println(a2.hi)
    println(3)
    println(a2.lo)

    // ─── u128_mul ─────────────────────────────────────────────────────────
    println(3)  // u128_mul section
    // 1 * MULT_128 = MULT_128 = (2549297995355413924, 4865540595714422341)
    let m1 = u128_mul(0, 1, 2549297995355413924, 4865540595714422341)
    println(2549297995355413924)
    println(m1.hi)
    println(4865540595714422341)
    println(m1.lo)

    // 2 * (0, 2^63) = (1, 0)   — verifies carry from low
    let m2 = u128_mul(0, 2, 0, 0 - 9223372036854775808)
    println(1)
    println(m2.hi)
    println(0)
    println(m2.lo)

    // ─── rotr64 ───────────────────────────────────────────────────────────
    println(4)  // rotr64 section
    // rotr64(1, 1) = 2^63 = -9223372036854775808
    println(0 - 9223372036854775808)
    println(rotr64(1, 1))

    // rotr64(0x8000000000000000, 1) = 0x4000000000000000 = 2^62
    println(4611686018427387904)
    println(rotr64(0 - 9223372036854775808, 1))

    // rotr64(0x1, 0) = 1
    println(1)
    println(rotr64(1, 0))

    // ─── u_lt ─────────────────────────────────────────────────────────────
    println(5)  // u_lt section
    // u_lt(0, -1) = true (since -1 as u64 = MAX)
    println(1)
    var b: i64 = 0
    if u_lt(0, 0 - 1) { b = 1 }
    println(b)

    // u_lt(-1, 0) = false
    println(0)
    var b2: i64 = 0
    if u_lt(0 - 1, 0) { b2 = 1 }
    println(b2)

    // u_lt(1, 2) = true
    println(1)
    var b3: i64 = 0
    if u_lt(1, 2) { b3 = 1 }
    println(b3)
}
