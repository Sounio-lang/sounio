use pcg64_reference::{DstPcg64, pcg64_new}

fn main() with IO, Mut, Div, Panic {
    // Print state_hi and state_lo after pcg64_new for seed=0 and seed=31415.
    let r0 = pcg64_new(0)
    println(0)
    println(r0.state_hi)
    println(r0.state_lo)
    let r31415 = pcg64_new(31415)
    println(31415)
    println(r31415.state_hi)
    println(r31415.state_lo)
}
