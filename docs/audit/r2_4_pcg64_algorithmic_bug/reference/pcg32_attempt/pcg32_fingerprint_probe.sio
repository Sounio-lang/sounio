// Emit first 8 individual PCG32 32-bit samples for seed 31415.
// Cross-check against operator's external PCG-cpp reference:
//   sample[0] = 1441829971   (0x55F09453)
//   sample[1] = 3303517651   (0xC4E7ADD3)
//   sample[2] = 117924292    (0x070761C4)
//   sample[3] = 106048764    (0x06522CFC)
//   sample[4] = 3207584603   (0xBF2FDB5B)
//   sample[5] = 3398509113   (0xCA912239)
//   sample[6] = 516904547    (0x1ECF5663)
//   sample[7] = 4032317196   (0xF058470C)
use pcg64_reference::{Pcg32, lshr, pcg32_step, pcg32_init}

fn main() with IO, Mut, Div, Panic {
    var rng = pcg32_init(31415)
    var i: i64 = 0
    while i < 8 {
        let r = pcg32_step(rng)
        rng = r.0
        println(r.1)
        i = i + 1
    }
}
