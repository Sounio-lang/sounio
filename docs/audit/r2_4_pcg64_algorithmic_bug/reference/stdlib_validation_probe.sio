// Validate stdlib/random/distributions.sio dst_pcg64_* against the
// canonical Phase A oracle. Emit per-seed marker + N samples; compare
// against reference/oracle_seed_*.txt.

use stdlib::random::distributions::{DstPcg64, dst_pcg64_new, dst_pcg64_next_i64}

fn emit_first_n(seed: i64, n: i64) with IO, Mut, Div, Panic {
    var rng = dst_pcg64_new(seed)
    var i: i64 = 0
    while i < n {
        let r = dst_pcg64_next_i64(rng)
        rng = r.0
        println(r.1)
        i = i + 1
    }
}

fn main() with IO, Mut, Div, Panic {
    println(0)
    emit_first_n(0, 256)
    println(1)
    emit_first_n(1, 256)
    println(31415)
    emit_first_n(31415, 256)
    println(20260516)
    emit_first_n(20260516, 256)
}
