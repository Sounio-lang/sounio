// Verify XOR behavior on the specific seed-0 state.
use pcg64_reference::{lshr, rotr64}

fn main() with IO, Mut, Div, Panic {
    // state_hi = 5220163216168088568 (positive i64)
    // state_lo = -6043960321096071782 as i64; as u64 = 12402783752613479834
    let hi: i64 = 5220163216168088568
    let lo: i64 = 0 - 6043960321096071782

    println(hi ^ lo)
    // Expected if equal to pcg-cpp: same bit pattern as state_hi_u64 XOR state_lo_u64.

    // What if I rotate the pcg-cpp output backward by 18 to reverse-engineer xord_lo?
    // rotr(x, 18) = y means x = rotl(y, 18) = (y << 18) | (y >> 46)
    // Take pcg-cpp output 74029666500212977 and rotl by 18:
    let y: i64 = 74029666500212977
    let rotl_left = y << 18
    let rotl_right = lshr(y, 46)
    let reconstructed_xord = rotl_left | rotl_right
    println(reconstructed_xord)
    // If this equals hi^lo, pcg-cpp and Sounio agree on xord; the difference would be rotr.

    // Also test rotr64 on a known case: rotr64(1, 1) should = 2^63 = -9223372036854775808
    println(rotr64(1, 1))
}
