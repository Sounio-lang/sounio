// Pin every step explicitly to rule out R.2.3-like field-access issues.
use pcg64_reference::{DstPcg64, pcg64_new, lshr, rotr64}

fn main() with IO, Mut, Div, Panic {
    let rng = pcg64_new(0)
    // bind to local i64s
    let h: i64 = rng.state_hi
    let l: i64 = rng.state_lo
    println(h)
    println(l)

    // XOR with literals (avoiding field access entirely)
    let hi_lit: i64 = 5220163216168088568
    let lo_lit: i64 = 0 - 6043960321096071782
    println(hi_lit ^ lo_lit)         // expect same as h ^ l

    println(h ^ l)                    // field-derived XOR

    // Now test: XOR with literal AND the field value
    println(hi_lit ^ l)               // should match hi_lit ^ lo_lit if l == lo_lit
    println(h ^ lo_lit)               // should match if h == hi_lit
}
