// Regenerate canonical 256-sample oracle streams for 4 seeds.
//
// Usage: compile, then redirect per-seed via separate runs is not needed —
//   ./pcg64_oracle_gen > /tmp/all_oracle.txt
// then split externally; or run four single-seed binaries. To keep this
// hermetic to one binary, we emit per-seed markers `# seed=N` so a tiny
// awk splitter (out of scope) is trivial.

use pcg64_reference::{DstPcg64, pcg64_new, pcg64_step}

fn emit_first_n(seed: i64, n: i64) with IO, Mut, Div, Panic {
    var rng = pcg64_new(seed)
    var i: i64 = 0
    while i < n {
        let r = pcg64_step(rng)
        rng = r.0
        println(r.1)
        i = i + 1
    }
}

fn main() with IO, Mut, Div, Panic {
    println(0)
    emit_first_n(0, 256)
    println(1)
    emit_first_n(1, 256)
    println(31415)
    emit_first_n(31415, 256)
    println(20260516)
    emit_first_n(20260516, 256)
}
