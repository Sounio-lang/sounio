fn identities() with IO,Mut,Div,Panic {
 let a=isothermal_entropy_independent(2.0,0.1,2.0,0.02,1.0,0.01)
 let b=isothermal_entropy_independent(2.0,0.1,1.0,0.01,2.0,0.02)
 let c=isothermal_entropy_independent(2.0,0.3,2.0,0.06,1.0,0.03)
 if !(a.status==0 && b.status==0 && c.status==0) { println("FAIL_identities_assert_1") }
 if !(close(a.delta_s,0.0-b.delta_s)) { println("FAIL_identities_assert_2") }
 if !(close(a.standard_uncertainty,b.standard_uncertainty)) { println("FAIL_identities_assert_3") }
 if !(close(c.standard_uncertainty,3.0*a.standard_uncertainty)) { println("FAIL_identities_assert_4") }
 let d=isothermal_entropy_independent(2.0,0.1,2.0e200,2.0e198,1.0e200,1.0e198)
 let e=isothermal_entropy_independent(2.0,0.1,2.0e-200,2.0e-202,1.0e-200,1.0e-202)
 if !(d.status==0 && e.status==0) { println("FAIL_identities_assert_5") }
 if !(close(a.delta_s,d.delta_s) && close(a.delta_s,e.delta_s)) { println("FAIL_identities_assert_6") }
 if !(close(a.standard_uncertainty,d.standard_uncertainty) && close(a.standard_uncertainty,e.standard_uncertainty)) { println("FAIL_identities_assert_7") }
}
