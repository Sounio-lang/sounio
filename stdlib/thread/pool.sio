// stdlib/thread/pool — Shared-memory thread pool handles
//
// ThreadPool is a copyable handle into module-global worker/task state so
// clone-launched tasks can observe and update the same pool by ID.

let POOL_MAX: i64 = 16
let POOL_MAX_WORKERS: i64 = 64

var POOL_USED: [i64; 16] = [0; 16]
var POOL_NUM_WORKERS: [i64; 16] = [0; 16]
var POOL_TASKS_SUBMITTED: [i64; 16] = [0; 16]
var POOL_TASKS_COMPLETED: [i64; 16] = [0; 16]
var POOL_WORKER_STATUS: [i64; 1024] = [0; 1024]
var POOL_WORKER_TASK: [i64; 1024] = [0; 1024]

pub struct ThreadPool {
    id: i64,
}

fn pool_slot_valid(id: i64) -> bool {
    return id >= 0 && id < POOL_MAX && POOL_USED[id as usize] == 1
}

fn pool_worker_index(id: i64, worker_idx: i64) -> i64 {
    return id * POOL_MAX_WORKERS + worker_idx
}

pub fn thread_pool_new(num_workers: i64) -> ThreadPool with Mut {
    var pool_id: i64 = -1
    var i: i64 = 0
    while i < POOL_MAX {
        if POOL_USED[i as usize] == 0 {
            POOL_USED[i as usize] = 1
            pool_id = i
            break
        }
        i = i + 1
    }
    if pool_id < 0 { return ThreadPool { id: -1 } }
    var n = num_workers
    if n > POOL_MAX_WORKERS { n = POOL_MAX_WORKERS }
    if n < 1 { n = 1 }
    POOL_NUM_WORKERS[pool_id as usize] = n
    POOL_TASKS_SUBMITTED[pool_id as usize] = 0
    POOL_TASKS_COMPLETED[pool_id as usize] = 0
    var j: i64 = 0
    while j < POOL_MAX_WORKERS {
        let idx = pool_worker_index(pool_id, j)
        POOL_WORKER_STATUS[idx as usize] = 0
        POOL_WORKER_TASK[idx as usize] = 0
        j = j + 1
    }
    return ThreadPool { id: pool_id }
}

pub fn thread_pool_submit(pool: &! ThreadPool, task_id: i64) -> bool with Mut {
    let id = pool.id
    if !pool_slot_valid(id) { return false }
    var i: i64 = 0
    while i < POOL_NUM_WORKERS[id as usize] {
        let idx = pool_worker_index(id, i)
        if POOL_WORKER_STATUS[idx as usize] == 0 {
            POOL_WORKER_STATUS[idx as usize] = 1
            POOL_WORKER_TASK[idx as usize] = task_id
            POOL_TASKS_SUBMITTED[id as usize] = POOL_TASKS_SUBMITTED[id as usize] + 1
            return true
        }
        i = i + 1
    }
    return false
}

pub fn thread_pool_complete(pool: &! ThreadPool, worker_idx: i64) with Mut {
    let id = pool.id
    if !pool_slot_valid(id) { return }
    if worker_idx < 0 || worker_idx >= POOL_NUM_WORKERS[id as usize] { return }
    let idx = pool_worker_index(id, worker_idx)
    if POOL_WORKER_STATUS[idx as usize] == 0 { return }
    POOL_WORKER_STATUS[idx as usize] = 0
    POOL_TASKS_COMPLETED[id as usize] = POOL_TASKS_COMPLETED[id as usize] + 1
}

pub fn thread_pool_active_count(pool: &! ThreadPool) -> i64 with Mut {
    let id = pool.id
    if !pool_slot_valid(id) { return 0 }
    var count: i64 = 0
    var i: i64 = 0
    while i < POOL_NUM_WORKERS[id as usize] {
        let idx = pool_worker_index(id, i)
        if POOL_WORKER_STATUS[idx as usize] != 0 { count = count + 1 }
        i = i + 1
    }
    return count
}

pub fn thread_pool_total_workers(pool: &! ThreadPool) -> i64 {
    let id = pool.id
    if !pool_slot_valid(id) { return 0 }
    return POOL_NUM_WORKERS[id as usize]
}
