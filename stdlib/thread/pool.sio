// stdlib/thread/pool — Thread pool abstraction
//
// ThreadPool: fixed-size pool of worker slots with task assignment.

let POOL_MAX_WORKERS: i64 = 64

pub struct ThreadPool {
    worker_status: [i64; 64],
    worker_task: [i64; 64],
    num_workers: i64,
    tasks_submitted: i64,
    tasks_completed: i64,
}

impl ThreadPool {
    fn new(num_workers: i64) -> ThreadPool {
        var n = num_workers
        if n > POOL_MAX_WORKERS { n = POOL_MAX_WORKERS }
        if n < 1 { n = 1 }
        ThreadPool {
            worker_status: [0; 64],
            worker_task: [0; 64],
            num_workers: n,
            tasks_submitted: 0,
            tasks_completed: 0,
        }
    }

    fn submit(self: &! ThreadPool, task_id: i64) -> bool {
        // Find idle worker
        var i: i64 = 0
        while i < self.num_workers {
            if self.worker_status[i] == 0 {
                self.worker_status[i] = 1
                self.worker_task[i] = task_id
                self.tasks_submitted = self.tasks_submitted + 1
                return true
            }
            i = i + 1
        }
        return false
    }

    fn complete(self: &! ThreadPool, worker_idx: i64) {
        if worker_idx >= 0 && worker_idx < self.num_workers {
            self.worker_status[worker_idx] = 0
            self.tasks_completed = self.tasks_completed + 1
        }
    }

    fn active_count(self: &ThreadPool) -> i64 {
        var count: i64 = 0
        var i: i64 = 0
        while i < self.num_workers {
            if self.worker_status[i] != 0 { count = count + 1 }
            i = i + 1
        }
        count
    }

    fn total_workers(self: &ThreadPool) -> i64 {
        self.num_workers
    }
}

pub fn thread_pool_new(num_workers: i64) -> ThreadPool {
    var n = num_workers
    if n > POOL_MAX_WORKERS { n = POOL_MAX_WORKERS }
    if n < 1 { n = 1 }
    ThreadPool {
        worker_status: [0; 64],
        worker_task: [0; 64],
        num_workers: n,
        tasks_submitted: 0,
        tasks_completed: 0,
    }
}

pub fn thread_pool_submit(pool: &! ThreadPool, task_id: i64) -> bool {
    var i: i64 = 0
    while i < pool.num_workers {
        if pool.worker_status[i] == 0 {
            pool.worker_status[i] = 1
            pool.worker_task[i] = task_id
            pool.tasks_submitted = pool.tasks_submitted + 1
            return true
        }
        i = i + 1
    }
    return false
}

pub fn thread_pool_complete(pool: &! ThreadPool, worker_idx: i64) {
    if worker_idx >= 0 && worker_idx < pool.num_workers {
        pool.worker_status[worker_idx] = 0
        pool.tasks_completed = pool.tasks_completed + 1
    }
}

pub fn thread_pool_active_count(pool: &! ThreadPool) -> i64 {
    var count: i64 = 0
    var i: i64 = 0
    while i < pool.num_workers {
        if pool.worker_status[i] != 0 { count = count + 1 }
        i = i + 1
    }
    count
}

pub fn thread_pool_total_workers(pool: &! ThreadPool) -> i64 {
    pool.num_workers
}
