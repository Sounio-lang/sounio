use ffi::platform::{Platform,PlatformValue,platform_call}
pub linear struct NativeThread {id:i64,status:i64,joined:bool}
pub fn native_thread_spawn(p:&Platform,callback:fn(i64)->i64 with Panic,argument:i64)->NativeThread with IO {
    let r=platform_call(p,20,callback as i64,argument,0,0)
    return NativeThread {id:r.value,status:r.status,joined:false}
}
pub fn native_thread_status(t:&NativeThread)->i64 {t.status}
pub fn native_thread_join(p:&Platform,t:&!NativeThread)->PlatformValue with IO,Mut {
    if t.status!=0 {return PlatformValue {value:0,status:t.status}}
    if t.joined {return PlatformValue {value:0,status:22}}
    let r=platform_call(p,21,t.id,0,0,0)
    if r.status==0 {t.joined=true}
    return r
}
pub fn native_thread_close(p:&Platform,t:NativeThread)->i64 with IO,Panic {
    let NativeThread {id,status,joined}=t
    if status!=0 {return status}
    assert(joined)
    return platform_call(p,2,id,0,0,0).status
}
