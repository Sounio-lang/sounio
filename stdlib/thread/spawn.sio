// stdlib/thread/spawn — Thread handle
//
// ThreadHandle: represents a spawned thread with status tracking.

struct ThreadHandle {
    id: i64,
    status: i64,
    result: i64,
}

let THREAD_CREATED: i64 = 0
let THREAD_RUNNING: i64 = 1
let THREAD_JOINED: i64 = 2

fn thread_new(id: i64) -> ThreadHandle {
    ThreadHandle { id: id, status: THREAD_CREATED, result: 0 }
}

impl ThreadHandle {
    fn is_running(self: &ThreadHandle) -> bool { self.status == THREAD_RUNNING }
    fn is_joined(self: &ThreadHandle) -> bool { self.status == THREAD_JOINED }

    fn join(self: &! ThreadHandle) -> i64 {
        self.status = THREAD_JOINED
        self.result
    }

    fn set_result(self: &! ThreadHandle, result: i64) {
        self.result = result
        self.status = THREAD_JOINED
    }
}
