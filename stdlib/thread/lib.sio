//! stdlib/thread - Thread Management
//!
//! This module provides threading support for concurrent programming:
//! - `spawn` - Thread creation and joining
//! - `pool` - Thread pools for parallel task execution
//!
//! # Examples
//! ```sio
//! // Spawn a thread
//! let handle = thread_spawn(|| {
//!     print("Hello from thread!")
//!     42
//! })
//!
//! // Wait for thread to finish
//! let result = thread_join(handle)
//! print("Thread returned: " ++ result.to_string())
//!
//! // Use a thread pool
//! let pool = thread_pool_new(4)
//! thread_pool_execute(&pool, || {
//!     print("Task running in pool")
//! })
//! thread_pool_shutdown(&!pool)
//! ```

pub mod spawn;
pub mod pool;
