// stdlib/cmp/lib.sio — Comparison and ordering utilities
//
// Functions:
//   cmp_i64      — three-way comparison (-1/0/1) for i64
//   cmp_f64      — three-way comparison (-1/0/1) for f64 (epsilon 1e-15)
//   min_i64      — minimum of two i64 values
//   max_i64      — maximum of two i64 values
//   min_f64      — minimum of two f64 values
//   max_f64      — maximum of two f64 values
//   clamp_f64    — clamp f64 to [lo, hi]
//   clamp_i64    — clamp i64 to [lo, hi]
//   approx_eq    — f64 equality within tolerance
//   sign_f64     — returns -1.0, 0.0, or 1.0

fn abs_f64_cmp(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    x
}

pub fn cmp_i64(a: i64, b: i64) -> i32 {
    if a < b { return -1 }
    if a > b { return 1 }
    0
}

pub fn cmp_f64(a: f64, b: f64) -> i32 {
    let eps: f64 = 1e-15
    let diff = a - b
    if diff < 0.0 - eps { return -1 }
    if diff > eps { return 1 }
    0
}

pub fn min_i64(a: i64, b: i64) -> i64 {
    if a < b { return a }
    b
}

pub fn max_i64(a: i64, b: i64) -> i64 {
    if a > b { return a }
    b
}

pub fn min_f64(a: f64, b: f64) -> f64 {
    if a < b { return a }
    b
}

pub fn max_f64(a: f64, b: f64) -> f64 {
    if a > b { return a }
    b
}

pub fn clamp_f64(x: f64, lo: f64, hi: f64) -> f64 {
    if x < lo { return lo }
    if x > hi { return hi }
    x
}

pub fn clamp_i64(x: i64, lo: i64, hi: i64) -> i64 {
    if x < lo { return lo }
    if x > hi { return hi }
    x
}

pub fn approx_eq(a: f64, b: f64, tol: f64) -> bool {
    let diff = abs_f64_cmp(a - b)
    diff <= tol
}

pub fn sign_f64(x: f64) -> f64 {
    if x < 0.0 { return -1.0 }
    if x > 0.0 { return 1.0 }
    0.0
}
