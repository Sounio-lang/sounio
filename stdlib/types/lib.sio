// types — Type metadata and refinement types
//
// Runtime type information (TypeInfo) and 8 concrete refinement types
// with validation, clamping, and safe construction.
//
// Submodules:
//   types      — TypeInfo metadata (kind, size, alignment) for i32, i64, f64, bool, array, struct
//   refinement — 8 refinement types: Probability, Positive, NonNegative, Percentage,
//                NonZero, Concentration, Temperature, UnitInterval

pub use types::{
    TypeInfo,
    TYPE_I32, TYPE_I64, TYPE_F64, TYPE_BOOL, TYPE_ARRAY,
    type_eq, type_is_numeric, type_is_integer,
}

pub use refinement::{
    probability_is_valid, probability_new, probability_try_new, probability_clamp, probability_value,
    positive_is_valid, positive_new, positive_try_new, positive_clamp, positive_value,
    non_negative_is_valid, non_negative_new, non_negative_try_new, non_negative_clamp, non_negative_value,
    percentage_is_valid, percentage_new, percentage_try_new, percentage_clamp, percentage_value,
    non_zero_is_valid, non_zero_new, non_zero_try_new, non_zero_value,
    concentration_is_valid, concentration_new, concentration_try_new, concentration_clamp, concentration_value,
    temperature_is_valid, temperature_new, temperature_try_new, temperature_clamp, temperature_value,
    unit_interval_is_valid, unit_interval_new, unit_interval_try_new, unit_interval_clamp, unit_interval_value,
    probability_to_percentage, percentage_to_probability,
    probability_to_unit_interval, positive_to_concentration,
    temperature_celsius_to_kelvin, temperature_kelvin_to_celsius,
}
