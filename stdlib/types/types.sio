// types/mod.sio — Type Metadata
//
// Runtime type information for reflection and serialization.
// Provides size, alignment, and kind metadata for primitive types.

// ============================================================================
// TYPE INFO
// ============================================================================

// Type kind constants
fn TYPE_KIND_BOOL() -> i32 { 0 }
fn TYPE_KIND_I32() -> i32 { 1 }
fn TYPE_KIND_I64() -> i32 { 2 }
fn TYPE_KIND_F64() -> i32 { 3 }
fn TYPE_KIND_ARRAY() -> i32 { 4 }
fn TYPE_KIND_STRUCT() -> i32 { 5 }

pub struct TypeInfo {
    kind: i32,       // TYPE_KIND_*
    size: i32,       // Size in bytes
    alignment: i32,  // Alignment requirement in bytes
}

pub fn TYPE_I32() -> TypeInfo {
    TypeInfo { kind: 1, size: 4, alignment: 4 }
}

pub fn TYPE_I64() -> TypeInfo {
    TypeInfo { kind: 2, size: 8, alignment: 8 }
}

pub fn TYPE_F64() -> TypeInfo {
    TypeInfo { kind: 3, size: 8, alignment: 8 }
}

pub fn TYPE_BOOL() -> TypeInfo {
    TypeInfo { kind: 0, size: 1, alignment: 1 }
}

pub fn TYPE_ARRAY() -> TypeInfo {
    // Generic array metadata (element type determined separately)
    TypeInfo { kind: 4, size: 0, alignment: 8 }
}

// Check if two TypeInfos represent the same type
pub fn type_eq(a: TypeInfo, b: TypeInfo) -> bool {
    a.kind == b.kind && a.size == b.size && a.alignment == b.alignment
}

// Is this a numeric type?
pub fn type_is_numeric(t: TypeInfo) -> bool {
    t.kind == 1 || t.kind == 2 || t.kind == 3
}

// Is this an integer type?
pub fn type_is_integer(t: TypeInfo) -> bool {
    t.kind == 1 || t.kind == 2
}

// ============================================================================
// INLINE TESTS
// ============================================================================

//@ run-pass
fn test_type_i32() -> i32 {
    let t = TYPE_I32()
    if t.kind != 1 { return 1 }
    if t.size != 4 { return 2 }
    if t.alignment != 4 { return 3 }
    0
}

//@ run-pass
fn test_type_f64() -> i32 {
    let t = TYPE_F64()
    if t.kind != 3 { return 1 }
    if t.size != 8 { return 2 }
    0
}

//@ run-pass
fn test_type_eq() -> i32 {
    let a = TYPE_I32()
    let b = TYPE_I32()
    if !type_eq(a, b) { return 1 }
    let c = TYPE_F64()
    if type_eq(a, c) { return 2 }
    0
}

//@ run-pass
fn test_type_is_numeric() -> i32 {
    if !type_is_numeric(TYPE_I32()) { return 1 }
    if !type_is_numeric(TYPE_F64()) { return 2 }
    if type_is_numeric(TYPE_BOOL()) { return 3 }
    0
}
