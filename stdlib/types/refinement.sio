// stdlib/types/refinement.sio — Refinement Types for Sounio
//
// Provides 8 concrete refinement types, each as a struct + typed functions.
// No generics, no traits — pure Sounio with explicit structs per type.
//
// Design: each type X has:
//   struct X { value: f64 }
//   struct XResult { ok: bool, value: X }
//   pub fn x_new(v: f64) -> X          -- panics on invalid (prints error, returns default)
//   pub fn x_try_new(v: f64) -> XResult -- returns ok=false on invalid
//   pub fn x_clamp(v: f64) -> X        -- clips to valid range
//   pub fn x_is_valid(v: f64) -> bool
//   pub fn x_value(x: X) -> f64

// ============================================================================
// 1. Probability — [0.0, 1.0]
// ============================================================================

struct Probability { value: f64 }
struct ProbabilityResult { ok: bool, value: Probability }

pub fn probability_is_valid(v: f64) -> bool {
    v >= 0.0 && v <= 1.0
}

pub fn probability_new(v: f64) -> Probability with IO {
    if probability_is_valid(v) {
        return Probability { value: v }
    }
    println("probability_new: value out of range [0.0, 1.0]: ", v)
    Probability { value: 0.0 }
}

pub fn probability_try_new(v: f64) -> ProbabilityResult {
    if probability_is_valid(v) {
        return ProbabilityResult { ok: true, value: Probability { value: v } }
    }
    ProbabilityResult { ok: false, value: Probability { value: 0.0 } }
}

pub fn probability_clamp(v: f64) -> Probability {
    if v < 0.0 { return Probability { value: 0.0 } }
    if v > 1.0 { return Probability { value: 1.0 } }
    Probability { value: v }
}

pub fn probability_value(x: Probability) -> f64 {
    x.value
}

// ============================================================================
// 2. Positive — (0.0, +inf)
// ============================================================================

struct Positive { value: f64 }
struct PositiveResult { ok: bool, value: Positive }

pub fn positive_is_valid(v: f64) -> bool {
    v > 0.0
}

pub fn positive_new(v: f64) -> Positive with IO {
    if positive_is_valid(v) {
        return Positive { value: v }
    }
    println("positive_new: value must be > 0.0, got: ", v)
    Positive { value: 1.0 }
}

pub fn positive_try_new(v: f64) -> PositiveResult {
    if positive_is_valid(v) {
        return PositiveResult { ok: true, value: Positive { value: v } }
    }
    PositiveResult { ok: false, value: Positive { value: 1.0 } }
}

pub fn positive_clamp(v: f64) -> Positive {
    if v <= 0.0 { return Positive { value: 1.0e-300 } }
    Positive { value: v }
}

pub fn positive_value(x: Positive) -> f64 {
    x.value
}

// ============================================================================
// 3. NonNegative — [0.0, +inf)
// ============================================================================

struct NonNegative { value: f64 }
struct NonNegativeResult { ok: bool, value: NonNegative }

pub fn non_negative_is_valid(v: f64) -> bool {
    v >= 0.0
}

pub fn non_negative_new(v: f64) -> NonNegative with IO {
    if non_negative_is_valid(v) {
        return NonNegative { value: v }
    }
    println("non_negative_new: value must be >= 0.0, got: ", v)
    NonNegative { value: 0.0 }
}

pub fn non_negative_try_new(v: f64) -> NonNegativeResult {
    if non_negative_is_valid(v) {
        return NonNegativeResult { ok: true, value: NonNegative { value: v } }
    }
    NonNegativeResult { ok: false, value: NonNegative { value: 0.0 } }
}

pub fn non_negative_clamp(v: f64) -> NonNegative {
    if v < 0.0 { return NonNegative { value: 0.0 } }
    NonNegative { value: v }
}

pub fn non_negative_value(x: NonNegative) -> f64 {
    x.value
}

// ============================================================================
// 4. Percentage — [0.0, 100.0]
// ============================================================================

struct Percentage { value: f64 }
struct PercentageResult { ok: bool, value: Percentage }

pub fn percentage_is_valid(v: f64) -> bool {
    v >= 0.0 && v <= 100.0
}

pub fn percentage_new(v: f64) -> Percentage with IO {
    if percentage_is_valid(v) {
        return Percentage { value: v }
    }
    println("percentage_new: value out of range [0.0, 100.0]: ", v)
    Percentage { value: 0.0 }
}

pub fn percentage_try_new(v: f64) -> PercentageResult {
    if percentage_is_valid(v) {
        return PercentageResult { ok: true, value: Percentage { value: v } }
    }
    PercentageResult { ok: false, value: Percentage { value: 0.0 } }
}

pub fn percentage_clamp(v: f64) -> Percentage {
    if v < 0.0 { return Percentage { value: 0.0 } }
    if v > 100.0 { return Percentage { value: 100.0 } }
    Percentage { value: v }
}

pub fn percentage_value(x: Percentage) -> f64 {
    x.value
}

// ============================================================================
// 5. NonZero — |x| > 1e-15
// ============================================================================

struct NonZero { value: f64 }
struct NonZeroResult { ok: bool, value: NonZero }

fn abs_nz(v: f64) -> f64 {
    if v < 0.0 { 0.0 - v } else { v }
}

pub fn non_zero_is_valid(v: f64) -> bool {
    abs_nz(v) > 1.0e-15
}

pub fn non_zero_new(v: f64) -> NonZero with IO {
    if non_zero_is_valid(v) {
        return NonZero { value: v }
    }
    println("non_zero_new: |value| must be > 1e-15, got: ", v)
    NonZero { value: 1.0 }
}

pub fn non_zero_try_new(v: f64) -> NonZeroResult {
    if non_zero_is_valid(v) {
        return NonZeroResult { ok: true, value: NonZero { value: v } }
    }
    NonZeroResult { ok: false, value: NonZero { value: 1.0 } }
}

pub fn non_zero_value(x: NonZero) -> f64 {
    x.value
}

// ============================================================================
// 6. Concentration — (0.0, +inf) mol/L
// ============================================================================

struct Concentration { value: f64 }
struct ConcentrationResult { ok: bool, value: Concentration }

pub fn concentration_is_valid(v: f64) -> bool {
    v > 0.0
}

pub fn concentration_new(v: f64) -> Concentration with IO {
    if concentration_is_valid(v) {
        return Concentration { value: v }
    }
    println("concentration_new: concentration must be > 0.0 mol/L, got: ", v)
    Concentration { value: 1.0e-9 }
}

pub fn concentration_try_new(v: f64) -> ConcentrationResult {
    if concentration_is_valid(v) {
        return ConcentrationResult { ok: true, value: Concentration { value: v } }
    }
    ConcentrationResult { ok: false, value: Concentration { value: 1.0e-9 } }
}

pub fn concentration_clamp(v: f64) -> Concentration {
    if v <= 0.0 { return Concentration { value: 1.0e-300 } }
    Concentration { value: v }
}

pub fn concentration_value(x: Concentration) -> f64 {
    x.value
}

// ============================================================================
// 7. Temperature — (0.0, +inf) Kelvin
// ============================================================================

struct Temperature { value: f64 }
struct TemperatureResult { ok: bool, value: Temperature }

pub fn temperature_is_valid(v: f64) -> bool {
    v > 0.0
}

pub fn temperature_new(v: f64) -> Temperature with IO {
    if temperature_is_valid(v) {
        return Temperature { value: v }
    }
    println("temperature_new: temperature must be > 0.0 K (absolute zero), got: ", v)
    Temperature { value: 273.15 }
}

pub fn temperature_try_new(v: f64) -> TemperatureResult {
    if temperature_is_valid(v) {
        return TemperatureResult { ok: true, value: Temperature { value: v } }
    }
    TemperatureResult { ok: false, value: Temperature { value: 273.15 } }
}

pub fn temperature_clamp(v: f64) -> Temperature {
    if v <= 0.0 { return Temperature { value: 1.0e-10 } }
    Temperature { value: v }
}

pub fn temperature_value(x: Temperature) -> f64 {
    x.value
}

// ============================================================================
// 8. UnitInterval — [0.0, 1.0]
// ============================================================================

struct UnitInterval { value: f64 }
struct UnitIntervalResult { ok: bool, value: UnitInterval }

pub fn unit_interval_is_valid(v: f64) -> bool {
    v >= 0.0 && v <= 1.0
}

pub fn unit_interval_new(v: f64) -> UnitInterval with IO {
    if unit_interval_is_valid(v) {
        return UnitInterval { value: v }
    }
    println("unit_interval_new: value out of range [0.0, 1.0]: ", v)
    UnitInterval { value: 0.0 }
}

pub fn unit_interval_try_new(v: f64) -> UnitIntervalResult {
    if unit_interval_is_valid(v) {
        return UnitIntervalResult { ok: true, value: UnitInterval { value: v } }
    }
    UnitIntervalResult { ok: false, value: UnitInterval { value: 0.0 } }
}

pub fn unit_interval_clamp(v: f64) -> UnitInterval {
    if v < 0.0 { return UnitInterval { value: 0.0 } }
    if v > 1.0 { return UnitInterval { value: 1.0 } }
    UnitInterval { value: v }
}

pub fn unit_interval_value(x: UnitInterval) -> f64 {
    x.value
}

// ============================================================================
// Conversion helpers
// ============================================================================

/// probability_to_percentage: [0,1] → [0,100]
pub fn probability_to_percentage(p: Probability) -> Percentage {
    Percentage { value: p.value * 100.0 }
}

/// percentage_to_probability: [0,100] → [0,1]
pub fn percentage_to_probability(p: Percentage) -> Probability with Div, Panic {
    Probability { value: p.value / 100.0 }
}

/// probability_to_unit_interval: identity (both are [0,1])
pub fn probability_to_unit_interval(p: Probability) -> UnitInterval {
    UnitInterval { value: p.value }
}

/// positive_to_concentration: reinterpret Positive mol/L as Concentration
pub fn positive_to_concentration(p: Positive) -> Concentration {
    Concentration { value: p.value }
}

/// temperature_celsius_to_kelvin: C + 273.15 = K
pub fn temperature_celsius_to_kelvin(c: f64) -> f64 {
    c + 273.15
}

/// temperature_kelvin_to_celsius: K - 273.15 = C
pub fn temperature_kelvin_to_celsius(t: Temperature) -> f64 {
    t.value + (0.0 - 273.15)
}
