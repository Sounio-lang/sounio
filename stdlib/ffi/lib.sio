//! stdlib/ffi/lib.sio - Module entry point
//!
//! This is the entry point for the ffi module.

module ffi

pub fn slice_from_raw_parts<T>(ptr: *const T, len: usize) -> *const [T] {
    ptr as *const [T]
}

pub fn slice_from_raw_parts_mut<T>(ptr: *mut T, len: usize) -> *mut [T] {
    ptr as *mut [T]
}
