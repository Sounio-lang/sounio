// stdlib/ffi/ctypes.sio — C-compatible primitive type aliases
//
// Provides platform-conventional type aliases for C interoperability.
// All aliases map to Sounio primitive types with the correct size
// on x86-64 Linux (LP64 model).

type CChar = u8;
type CUChar = u8;
type CShort = i32;
type CUShort = u32;
type CInt = i32;
type CUInt = u32;
type CLong = i64;
type CULong = u64;
type CLongLong = i64;
type CULongLong = u64;
type CFloat = f32;
type CDouble = f64;
type CSizeT = usize;
type CPtrdiffT = i64;
type CIntPtrT = i64;
type CUIntPtrT = usize;

// Null pointer constant
let NULL_PTR: usize = 0
