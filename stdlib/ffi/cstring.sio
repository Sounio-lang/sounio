// stdlib/ffi/cstring.sio
// Minimal C string utilities for FFI
//
// Provides functions for working with null-terminated byte arrays.

// Copy a Sounio string into a fixed buffer with null terminator
// Returns the length written (including null byte)
pub fn cstring_write(src: [u8; 256], src_len: i64, dst: &![u8; 257]) -> i64 {
    var i: i64 = 0
    while i < src_len {
        if i >= 256 { break }
        dst[i] = src[i]
        i = i + 1
    }
    dst[i] = 0
    return i + 1
}

// Measure length of a null-terminated buffer (up to max)
pub fn cstring_len(buf: [u8; 257], max: i64) -> i64 {
    var i: i64 = 0
    while i < max {
        if buf[i] == 0 { return i }
        i = i + 1
    }
    return max
}

// Compare two null-terminated buffers
// Returns 0 if equal, non-zero otherwise
pub fn cstring_eq(a: [u8; 257], b: [u8; 257], max: i64) -> i64 {
    var i: i64 = 0
    while i < max {
        if a[i] != b[i] { return 1 }
        if a[i] == 0 { return 0 }
        i = i + 1
    }
    return 0
}
