// stdlib/ffi/cstring.sio — Null-terminated C string type
//
// Provides CStr for working with null-terminated byte strings
// across the FFI boundary.

extern "C" {
    fn strlen(s: *const u8) -> usize;
    fn memcpy(dst: *mut u8, src: *const u8, n: usize) -> *mut u8;
}

// Maximum capacity for a CString buffer (including null terminator)
let CSTRING_MAX: usize = 256

// Null-terminated string with fixed backing storage (256 bytes)
struct CStr {
    buf: [u8; 256],
    len: usize
}

fn cstr_new() -> CStr {
    CStr {
        buf: [0; 256],
        len: 0
    }
}

fn cstr_len(s: &CStr) -> usize {
    s.len
}

fn cstr_is_empty(s: &CStr) -> bool {
    s.len == 0
}
