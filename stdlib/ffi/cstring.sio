// Conversão mínima string <-> C null-terminated para FFI
//
// Fornece funções básicas para criar strings C null-terminated a partir de strings Sounio.
module ffi::cstring;

use ffi::ctypes::*;
use collections::Vec;
use core::ptr;
use core::slice::from_raw_parts;
use string::{from_utf8, new};

pub fn cstring_from_str(s: string) -> *mut u8 {
    let bytes = s.as_bytes();
    let mut vec: Vec<u8> = Vec::new();
    vec.extend_from_slice(bytes);
    vec.push(0u8);
    let ptr = vec.as_mut_ptr();
    ptr::forget(vec);
    ptr
}

pub fn str_from_cstring(ptr: *const u8) -> string {
    if ptr.is_null() {
        return new();
    }
    unsafe {
        let mut len = 0usize;
        let mut p = ptr;
        loop {
            if p.read() == 0u8 {
                break;
            }
            len += 1;
            p = p.offset(1isize);
        }
        from_utf8(from_raw_parts(ptr, len)).unwrap()
    }
}
