// Compiler-private worker entry extraction is permitted only for this physical
// stdlib/ffi/worker.sio module registered by the loader. A user-declared
// module name does not establish this origin. Caps are opaque compiler types.
use ffi::platform::{Platform,PlatformValue,platform_call}

pub fn platform_pool_new_i64(p:&Platform,callback:WorkerFnI64,workers:i64,capacity:i64,max_bytes:i64)->PlatformValue with IO {
 return platform_call(p,130,worker_fn_i64_raw(callback),workers,capacity,max_bytes)
}

pub fn platform_pool_new_f64(p:&Platform,callback:WorkerFnF64,workers:i64,capacity:i64,max_bytes:i64)->PlatformValue with IO {
 return platform_call(p,140,worker_fn_f64_raw(callback),workers,capacity,max_bytes)
}

pub fn platform_thread_spawn_i64(p:&Platform,callback:WorkerFnI64,argument:i64)->PlatformValue with IO {
 return platform_call(p,20,worker_fn_i64_raw(callback),argument,0,0)
}
