// stdlib/ffi/callback.sio — Callback registry for FFI boundaries
//
// Arena-style registry for storing and invoking callbacks across the FFI
// boundary. Uses a fixed-capacity table to avoid heap allocation.

// Maximum number of registered callbacks
let CALLBACK_CAPACITY: usize = 64

// Slot states
let SLOT_EMPTY: i32 = 0
let SLOT_OCCUPIED: i32 = 1

// A callback entry: an opaque function pointer and user data
struct CallbackEntry {
    func: *mut u8,
    data: *mut u8,
    state: i32
}

// Registry holding up to CALLBACK_CAPACITY callbacks
struct CallbackRegistry {
    entries: [CallbackEntry; 64],
    count: usize
}

fn callback_entry_empty() -> CallbackEntry {
    CallbackEntry {
        func: 0 as *mut u8,
        data: 0 as *mut u8,
        state: SLOT_EMPTY
    }
}

fn callback_registry_new() -> CallbackRegistry {
    CallbackRegistry {
        entries: [callback_entry_empty(); 64],
        count: 0
    }
}

fn callback_registry_len(reg: &CallbackRegistry) -> usize {
    reg.count
}

fn callback_registry_is_full(reg: &CallbackRegistry) -> bool {
    reg.count >= CALLBACK_CAPACITY
}
