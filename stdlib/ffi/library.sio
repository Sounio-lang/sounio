// stdlib/ffi/library.sio — Dynamic library loading via dlopen/dlsym
//
// Provides a minimal wrapper around the POSIX dynamic linking interface
// for loading shared libraries at runtime.

extern "C" {
    fn dlopen(filename: *const u8, flags: i32) -> *mut u8;
    fn dlsym(handle: *mut u8, symbol: *const u8) -> *mut u8;
    fn dlclose(handle: *mut u8) -> i32;
    fn dlerror() -> *const u8;
}

// dlopen flags
let RTLD_LAZY: i32 = 1
let RTLD_NOW: i32 = 2
let RTLD_GLOBAL: i32 = 256
let RTLD_LOCAL: i32 = 0

// Handle to an open dynamic library
struct Library {
    handle: *mut u8,
    valid: bool
}

fn library_open(path: *const u8) -> Library {
    let h = dlopen(path, RTLD_LAZY)
    let ok = h as usize != 0
    Library { handle: h, valid: ok }
}

fn library_is_valid(lib: &Library) -> bool {
    lib.valid
}

fn library_symbol(lib: &Library, name: *const u8) -> *mut u8 {
    dlsym(lib.handle, name)
}

fn library_close(lib: Library) -> i32 {
    dlclose(lib.handle)
}
