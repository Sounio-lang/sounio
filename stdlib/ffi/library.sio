// stdlib/ffi/library.sio — Dynamic library loading via dlopen/dlsym
//
// Madaros resolves dlopen/dlsym/dlclose/dlerror via DT_NEEDED libdl.so.2 + GOT.
// Pointer params use *mut u8 (same convention as compress::zstd).

extern "C" {
    fn dlopen(filename: *mut u8, flags: i32) -> *mut u8
    fn dlsym(handle: *mut u8, symbol: *mut u8) -> *mut u8
    fn dlclose(handle: *mut u8) -> i32
    fn dlerror() -> *mut u8
}

pub let RTLD_LAZY: i32 = 1
pub let RTLD_NOW: i32 = 2
pub let RTLD_GLOBAL: i32 = 256
pub let RTLD_LOCAL: i32 = 0

pub struct Library {
    pub handle: *mut u8,
    pub valid: bool
}

pub fn library_open(path: *mut u8) -> Library with Mut {
    let h = dlopen(path, RTLD_LAZY)
    let ok = (h as i64) != 0
    Library { handle: h, valid: ok }
}

pub fn library_is_valid(lib: Library) -> bool {
    lib.valid
}

pub fn library_symbol(lib: Library, name: *mut u8) -> *mut u8 with Mut {
    dlsym(lib.handle, name)
}

pub fn library_close(lib: Library) -> i32 with Mut {
    dlclose(lib.handle)
}

pub fn library_error() -> *mut u8 with Mut {
    dlerror()
}
