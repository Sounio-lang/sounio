// stdlib/ffi — Foreign Function Interface support
//
// Primitives for C interoperability: pointers, slices, cstrings.

// FFI type size constants
fn ffi_sizeof_i32() -> i64 { return 4 }
fn ffi_sizeof_i64() -> i64 { return 8 }
fn ffi_sizeof_f64() -> i64 { return 8 }
fn ffi_sizeof_ptr() -> i64 { return 8 }
