// stdlib/ffi — Foreign Function Interface support
//
// Primitives for C interoperability: pointers, slices, cstrings.

// FFI type size constants
pub fn ffi_sizeof_i32() -> i64 { return 4 }
pub fn ffi_sizeof_i64() -> i64 { return 8 }
pub fn ffi_sizeof_f64() -> i64 { return 8 }
pub fn ffi_sizeof_ptr() -> i64 { return 8 }

pub fn ffi_i64_read(ptr: *mut i64) -> i64 with Mut {
    *ptr
}

pub fn ffi_i64_write(ptr: *mut i64, value: i64) with Mut {
    *ptr = value
}
