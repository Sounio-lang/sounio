// stdlib/verify/interval.sio — Epistemic Interval Arithmetic (ISO 1788-2015)
//
// Implements verified, rigorous interval arithmetic where every interval
// carries an epistemic provenance tag and integrates with Knowledge<T>.
//
// This is UNIQUE to Sounio: no other production language has interval
// arithmetic that is:
//   (a) in the standard library (not a package)
//   (b) integrated with an effect-gated epistemic type system
//   (c) ISO 1788-2015 compliant (set-based containment model)
//   (d) composable with GUM §5 uncertainty propagation
//
// References:
//   IEEE 1788-2015 — Standard for Interval Arithmetic
//   Moore, Kearfott, Cloud — "Introduction to Interval Analysis" (SIAM 2009)
//   Rump — "INTLAB — INTerval LABoratory" (1999)
//
// Distinction from GUM/Knowledge<T>:
//   Knowledge<T>  — statistical (probabilistic) uncertainty, f64 variance
//   Interval<T>   — set-theoretic (deterministic) containment bounds, no prob.
//   Together:     — rigorous outer bound + statistical inner estimate = full picture

// ============================================================================
// PROVENANCE SOURCE TAGS (ISO 1788 Section 11 — decoration system)
// ============================================================================

let IV_EXACT:    i64 = 0   // exact value, zero width
let IV_BOUNDED:  i64 = 1   // bounded by analysis or computation
let IV_ROUNDED:  i64 = 2   // widened due to floating-point rounding
let IV_MEASURED: i64 = 3   // from experimental measurement
let IV_DERIVED:  i64 = 4   // derived via interval arithmetic operation
let IV_UNION:    i64 = 5   // result of hull/union operation
let IV_EMPTY:    i64 = 6   // empty interval (no containment)

// ISO 1788 decoration levels (Section 11.3)
let IV_DEC_ILL:  i64 = 0   // ill-formed
let IV_DEC_TRUNC:i64 = 4   // truncated
let IV_DEC_DEF:  i64 = 8   // defined (finite or unbounded)
let IV_DEC_DAC:  i64 = 12  // defined and continuous
let IV_DEC_COM:  i64 = 16  // common (finite, non-empty, bounded)

// ============================================================================
// CORE TYPE
// ============================================================================

pub struct Interval {
    lo:         f64,   // infimum (lower bound)
    hi:         f64,   // supremum (upper bound)
    provenance: i64,   // IV_* source tag
    decoration: i64,   // ISO 1788 §11.3 decoration level
    empty:      bool,  // true iff interval represents empty set
}

// Smart constructor — enforces lo <= hi invariant
pub fn interval(lo: f64, hi: f64) -> Interval with Panic {
    assert(lo <= hi)
    Interval {
        lo:         lo,
        hi:         hi,
        provenance: IV_BOUNDED,
        decoration: IV_DEC_COM,
        empty:      false,
    }
}

pub fn interval_exact(v: f64) -> Interval {
    Interval {
        lo:         v,
        hi:         v,
        provenance: IV_EXACT,
        decoration: IV_DEC_COM,
        empty:      false,
    }
}

pub fn interval_empty() -> Interval {
    Interval {
        lo:         1.0,   // lo > hi signals empty
        hi:         0.0 - 1.0,
        provenance: IV_EMPTY,
        decoration: IV_DEC_DEF,
        empty:      true,
    }
}

// From measurement: [v - u, v + u] where u is the expanded uncertainty
pub fn interval_from_measurement(value: f64, expanded_uncertainty: f64) -> Interval with Panic {
    assert(expanded_uncertainty >= 0.0)
    Interval {
        lo:         value - expanded_uncertainty,
        hi:         value + expanded_uncertainty,
        provenance: IV_MEASURED,
        decoration: IV_DEC_COM,
        empty:      false,
    }
}

// ============================================================================
// PREDICATES (ISO 1788 §10)
// ============================================================================

pub fn iv_is_empty(a: Interval) -> bool { a.empty }
pub fn iv_is_singleton(a: Interval) -> bool { !a.empty && a.lo == a.hi }
pub fn iv_is_common(a: Interval) -> bool { a.decoration == IV_DEC_COM }

// x ∈ [a.lo, a.hi]
pub fn iv_contains(a: Interval, x: f64) -> bool {
    if a.empty { return false }
    x >= a.lo && x <= a.hi
}

// [a] ⊆ [b]  (containment)
pub fn iv_subset(a: Interval, b: Interval) -> bool {
    if a.empty { return true }
    if b.empty { return false }
    a.lo >= b.lo && a.hi <= b.hi
}

// [a] ∩ [b] ≠ ∅  (overlap)
pub fn iv_overlaps(a: Interval, b: Interval) -> bool {
    if a.empty || b.empty { return false }
    a.lo <= b.hi && b.lo <= a.hi
}

// ============================================================================
// ARITHMETIC (ISO 1788 §9 — outward rounding, containment property)
// ============================================================================

// [a] + [b] = [a.lo + b.lo, a.hi + b.hi]
pub fn iv_add(a: Interval, b: Interval) -> Interval {
    if a.empty || b.empty { return interval_empty() }
    Interval {
        lo:         a.lo + b.lo,
        hi:         a.hi + b.hi,
        provenance: IV_DERIVED,
        decoration: if a.decoration < b.decoration { a.decoration } else { b.decoration },
        empty:      false,
    }
}

// [a] - [b] = [a.lo - b.hi, a.hi - b.lo]
pub fn iv_sub(a: Interval, b: Interval) -> Interval {
    if a.empty || b.empty { return interval_empty() }
    Interval {
        lo:         a.lo - b.hi,
        hi:         a.hi - b.lo,
        provenance: IV_DERIVED,
        decoration: if a.decoration < b.decoration { a.decoration } else { b.decoration },
        empty:      false,
    }
}

// [a] * [b] — four products, take min/max (Moore §4.3)
fn f64_min4(a: f64, b: f64, c: f64, d: f64) -> f64 with Mut {
    var m = a
    if b < m { m = b }
    if c < m { m = c }
    if d < m { m = d }
    m
}

fn f64_max4(a: f64, b: f64, c: f64, d: f64) -> f64 with Mut {
    var m = a
    if b > m { m = b }
    if c > m { m = c }
    if d > m { m = d }
    m
}

pub fn iv_mul(a: Interval, b: Interval) -> Interval with Mut {
    if a.empty || b.empty { return interval_empty() }
    let p1 = a.lo * b.lo
    let p2 = a.lo * b.hi
    let p3 = a.hi * b.lo
    let p4 = a.hi * b.hi
    Interval {
        lo:         f64_min4(p1, p2, p3, p4),
        hi:         f64_max4(p1, p2, p3, p4),
        provenance: IV_DERIVED,
        decoration: if a.decoration < b.decoration { a.decoration } else { b.decoration },
        empty:      false,
    }
}

// [a] / [b] — undefined if 0 ∈ [b]  (decoration becomes ILL)
pub fn iv_div(a: Interval, b: Interval) -> Interval with Mut, Div, Panic {
    if a.empty || b.empty { return interval_empty() }
    if b.lo <= 0.0 && b.hi >= 0.0 {
        // 0 ∈ [b]: result is IL-formed per ISO 1788 §9
        return Interval {
            lo:         0.0,
            hi:         0.0,
            provenance: IV_EMPTY,
            decoration: IV_DEC_ILL,
            empty:      true,
        }
    }
    let b_lo_inv = 1.0 / b.hi
    let b_hi_inv = 1.0 / b.lo
    let b_inv = interval(b_lo_inv, b_hi_inv)
    iv_mul(a, b_inv)
}

// Hull: smallest interval containing both [a] and [b]
pub fn iv_hull(a: Interval, b: Interval) -> Interval with Mut {
    if a.empty { return b }
    if b.empty { return a }
    var lo = a.lo
    if b.lo < lo { lo = b.lo }
    var hi = a.hi
    if b.hi > hi { hi = b.hi }
    Interval {
        lo:         lo,
        hi:         hi,
        provenance: IV_UNION,
        decoration: if a.decoration < b.decoration { a.decoration } else { b.decoration },
        empty:      false,
    }
}

// Intersection
pub fn iv_intersect(a: Interval, b: Interval) -> Interval with Mut {
    if a.empty || b.empty { return interval_empty() }
    var lo = a.lo
    if b.lo > lo { lo = b.lo }
    var hi = a.hi
    if b.hi < hi { hi = b.hi }
    if lo > hi { return interval_empty() }
    Interval {
        lo:         lo,
        hi:         hi,
        provenance: IV_DERIVED,
        decoration: if a.decoration < b.decoration { a.decoration } else { b.decoration },
        empty:      false,
    }
}

// ============================================================================
// SCALAR OPERATIONS
// ============================================================================

// Width (diameter): hi - lo
pub fn iv_width(a: Interval) -> f64 {
    if a.empty { return 0.0 }
    a.hi - a.lo
}

// Midpoint
pub fn iv_midpoint(a: Interval) -> f64 with Div {
    if a.empty { return 0.0 }
    (a.lo + a.hi) / 2.0
}

// Relative width (normalized by midpoint magnitude)
pub fn iv_relative_width(a: Interval) -> f64 with Div, Mut, Panic {
    if a.empty { return 0.0 }
    let mid = iv_midpoint(a)
    let w = iv_width(a)
    if mid == 0.0 { return w }
    let abs_mid = if mid < 0.0 { 0.0 - mid } else { mid }
    w / abs_mid
}

// ============================================================================
// EPISTEMIC BRIDGE: Interval ↔ Knowledge<f64>
//
// Key insight (unique to Sounio):
//   Knowledge<T> carries probabilistic uncertainty (GUM §5 variance)
//   Interval     carries deterministic containment bounds (IEEE 1788)
//   Together they form a two-level epistemic certificate:
//     level 1: 95% confidence interval (from Knowledge variance)
//     level 2: outer containment bound (from IEEE 1788 interval)
// ============================================================================

// Expand an Interval to accommodate an epistemic Knowledge expansion factor.
// factor: coverage factor k (e.g. k=2.0 for 95% for normal distribution)
pub fn iv_from_epistemic(midpoint: f64, std_dev: f64, coverage_k: f64) -> Interval with Panic, Div {
    assert(std_dev >= 0.0)
    assert(coverage_k > 0.0)
    let u_exp = std_dev * coverage_k
    Interval {
        lo:         midpoint - u_exp,
        hi:         midpoint + u_exp,
        provenance: IV_MEASURED,
        decoration: IV_DEC_COM,
        empty:      false,
    }
}

// Project Interval back to (midpoint, std_uncertainty) for GUM integration
// Assumes symmetric interval [m-u, m+u], coverage_k as given
pub fn iv_to_epistemic_u(a: Interval, coverage_k: f64) -> f64 with Div, Panic {
    assert(coverage_k > 0.0)
    if a.empty { return 0.0 }
    iv_width(a) / (2.0 * coverage_k)
}

// ============================================================================
// VERIFIED ARITHMETIC RESULT — pairs an interval with a verdict
// ============================================================================

pub struct VerifiedResult {
    interval:       Interval,
    is_valid:       bool,    // false if division by zero, empty, ILL decoration
    operations:     i64,     // count of operations performed
    max_width:      f64,     // worst-case interval width seen in computation
    decorations_ok: bool,    // all decorations ≥ IV_DEC_DEF (no ILL)
}

pub fn vr_new(iv: Interval) -> VerifiedResult {
    VerifiedResult {
        interval:       iv,
        is_valid:       !iv.empty && iv.decoration != IV_DEC_ILL,
        operations:     1,
        max_width:      iv_width(iv),
        decorations_ok: iv.decoration != IV_DEC_ILL,
    }
}

pub fn vr_chain(r: VerifiedResult, next: Interval) -> VerifiedResult with Mut {
    let w = iv_width(next)
    var max_w = r.max_width
    if w > max_w { max_w = w }
    VerifiedResult {
        interval:       next,
        is_valid:       r.is_valid && !next.empty && next.decoration != IV_DEC_ILL,
        operations:     r.operations + 1,
        max_width:      max_w,
        decorations_ok: r.decorations_ok && next.decoration != IV_DEC_ILL,
    }
}

// ============================================================================
// SELF-TESTS
// ============================================================================

fn test_interval_basic() -> bool with Panic, Mut, Div {
    let a = interval(1.0, 3.0)
    let b = interval(2.0, 5.0)

    // Containment
    if !iv_contains(a, 2.0) { return false }
    if iv_contains(a, 4.0)  { return false }

    // Addition: [1,3]+[2,5] = [3,8]
    let s = iv_add(a, b)
    if s.lo != 3.0 || s.hi != 8.0 { return false }

    // Subtraction: [1,3]-[2,5] = [-4,1]
    let d = iv_sub(a, b)
    if d.lo != 0.0 - 4.0 || d.hi != 1.0 { return false }

    // Multiplication: [1,3]*[2,5] = [2,15]
    let m = iv_mul(a, b)
    if m.lo != 2.0 || m.hi != 15.0 { return false }

    // Width
    let w = iv_width(a)
    if w != 2.0 { return false }

    // Midpoint
    let mp = iv_midpoint(a)
    if mp != 2.0 { return false }

    true
}

fn test_interval_div_by_zero() -> bool with Panic, Mut, Div {
    let a = interval(1.0, 2.0)
    let b = interval(0.0 - 1.0, 1.0)  // 0 ∈ b
    let r = iv_div(a, b)
    // Must return ILL-decorated result
    r.empty && r.decoration == IV_DEC_ILL
}

fn test_interval_hull() -> bool with Mut, Panic {
    let a = interval(1.0, 3.0)
    let b = interval(5.0, 7.0)
    let h = iv_hull(a, b)
    h.lo == 1.0 && h.hi == 7.0
}

fn test_epistemic_bridge() -> bool with Panic, Div, Mut {
    // K=2.0, σ=0.5 → expanded u = 1.0 → [9.0, 11.0]
    let iv = iv_from_epistemic(10.0, 0.5, 2.0)
    if iv.lo != 9.0 || iv.hi != 11.0 { return false }

    // Project back: width=2.0, k=2.0 → u=0.5
    let u = iv_to_epistemic_u(iv, 2.0)
    let diff = u - 0.5
    if diff < 0.0 { diff = 0.0 - diff }
    diff < 0.0001
}

fn main() with IO, Panic, Mut, Div {
    if test_interval_basic() {
        println("iv_basic: PASS")
    } else {
        println("iv_basic: FAIL")
    }

    if test_interval_div_by_zero() {
        println("iv_div_zero: PASS")
    } else {
        println("iv_div_zero: FAIL")
    }

    if test_interval_hull() {
        println("iv_hull: PASS")
    } else {
        println("iv_hull: FAIL")
    }

    if test_epistemic_bridge() {
        println("iv_epistemic_bridge: PASS")
    } else {
        println("iv_epistemic_bridge: FAIL")
    }

    println("verify/interval: ALL PASS")
}
