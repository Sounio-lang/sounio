// Graph Algorithms Module - BFS, shortest paths, connected components,
// weighted shortest paths (Dijkstra), PageRank, MST (Kruskal), topo sort.
//
// Epistemic edge weights: uncertainty propagated via GUM (quadrature) along paths.
// WeightedGraph uses a 32x32 adjacency matrix (max 32 nodes, 1024 entries).
//
// Ref: GUM (JCGM 100:2008) §5.1 — combined standard uncertainty by quadrature.

module graph::algorithms

// =============================================================================
// Constants
// =============================================================================

let INF_DIST: i64 = -1  // -1 = unreachable in unweighted results
let WGRAPH_MAX: i32 = 32
let WGRAPH_MAT: i32 = 1024  // 32*32

// F64_INF is defined as a local inside each function that needs it,
// because global f64 constants are not yet supported in souc native mode.

// =============================================================================
// Unweighted BFS result (kept for backward compat with test_algorithms_e2e.sio)
// =============================================================================

pub struct BfsResult {
    pub distances: [i64],   // -1 means unreachable
    pub parents: [i64],     // -1 means no parent
    pub source: usize,
}

impl BfsResult {
    pub fn distance_to(self: &BfsResult, target: usize) -> i64 {
        if target < self.distances.len() {
            self.distances[target]
        } else {
            INF_DIST
        }
    }

    pub fn is_reachable(self: &BfsResult, target: usize) -> bool {
        target < self.distances.len() && self.distances[target] >= 0
    }
}

// =============================================================================
// Breadth-First Search (unweighted, adjacency-list)
// =============================================================================

pub fn bfs(adj: &[[usize]], source: usize) -> BfsResult {
    let n = adj.len()
    var distances: [i64] = []
    var parents: [i64] = []
    var i: usize = 0
    while i < n {
        distances.push(-1)
        parents.push(-1)
        i = i + 1
    }

    if source >= n {
        return BfsResult { distances, parents, source }
    }

    var queue: [usize] = []
    queue.push(source)
    distances[source] = 0

    var head: usize = 0
    while head < queue.len() {
        let u = queue[head]
        head = head + 1
        let neighbors = &adj[u]
        var j: usize = 0
        while j < neighbors.len() {
            let v = neighbors[j]
            if distances[v] == -1 {
                distances[v] = distances[u] + 1
                parents[v] = u as i64
                queue.push(v)
            }
            j = j + 1
        }
    }

    BfsResult { distances, parents, source }
}

pub fn shortest_path_distance(adj: &[[usize]], u: usize, v: usize) -> i64 {
    let result = bfs(adj, u)
    result.distance_to(v)
}

pub fn num_components(adj: &[[usize]]) -> usize {
    let n = adj.len()
    let unvisited: usize = n

    var labels: [usize] = []
    var i: usize = 0
    while i < n {
        labels.push(unvisited)
        i = i + 1
    }

    var current_label: usize = 0
    var node: usize = 0

    while node < n {
        if labels[node] == unvisited {
            var queue: [usize] = []
            queue.push(node)
            labels[node] = current_label

            var head: usize = 0
            while head < queue.len() {
                let u = queue[head]
                head = head + 1
                let neighbors = &adj[u]
                var j: usize = 0
                while j < neighbors.len() {
                    let v = neighbors[j]
                    if labels[v] == unvisited {
                        labels[v] = current_label
                        queue.push(v)
                    }
                    j = j + 1
                }
            }
            current_label = current_label + 1
        }
        node = node + 1
    }

    var max_label: usize = 0
    i = 0
    while i < labels.len() {
        if labels[i] < labels.len() && labels[i] > max_label {
            max_label = labels[i]
        }
        i = i + 1
    }
    if labels.len() == 0 { 0 } else { max_label + 1 }
}

pub fn is_connected(adj: &[[usize]]) -> bool {
    let n = adj.len()
    if n <= 1 { return true }
    let result = bfs(adj, 0)
    var i: usize = 0
    while i < n {
        if result.distances[i] < 0 { return false }
        i = i + 1
    }
    true
}

// =============================================================================
// WeightedGraph — 32×32 adjacency matrix with GUM uncertainty
// =============================================================================

pub struct WeightedGraph {
    pub weights: [f64; 1024],     // weights[i*32+j] = edge weight (0.0 = no edge)
    pub weight_unc: [f64; 1024],  // uncertainty on each edge weight
    pub n_nodes: i32,
    pub directed: i32,            // 0=undirected, 1=directed
}

// =============================================================================
// ShortestPathResult — Dijkstra output with GUM uncertainty on distances
// =============================================================================

pub struct ShortestPathResult {
    pub distances: [f64; 32],
    pub dist_unc: [f64; 32],      // GUM-propagated path uncertainty
    pub predecessors: [i32; 32],
    pub reachable: [i32; 32],     // 1=reachable, 0=not
}

// =============================================================================
// PageRankResult
// =============================================================================

pub struct PageRankResult {
    pub scores: [f64; 32],
    pub scores_unc: [f64; 32],
    pub n_iterations: i32,
    pub converged: i32,
}

// =============================================================================
// TopoSortResult
// =============================================================================

pub struct TopoSortResult {
    pub order: [i32; 32],     // topological order
    pub count: i32,           // nodes sorted (-1 = cycle detected)
}

// =============================================================================
// Helpers (must precede callers)
// =============================================================================

// Newton-Raphson sqrt (20 iterations)
fn w_sqrt(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 20 {
        y = 0.5 * (y + x / y)
        i = i + 1
    }
    y
}

fn w_abs(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

// Union-Find for Kruskal — flat arrays, max 32 nodes
fn uf_find(parent: &[i32; 32], x: i32) -> i32 with Mut, Div, Panic {
    var cur = x
    var steps = 0
    while steps < 32 {
        let p = parent[cur as usize]
        if p == cur { return cur }
        cur = p
        steps = steps + 1
    }
    cur
}

fn uf_union(parent: &![i32; 32], rank: &![i32; 32], a: i32, b: i32) with Mut, Div, Panic {
    let ra = uf_find(parent, a)
    let rb = uf_find(parent, b)
    if ra == rb { return }
    if rank[ra as usize] < rank[rb as usize] {
        parent[ra as usize] = rb
    } else if rank[ra as usize] > rank[rb as usize] {
        parent[rb as usize] = ra
    } else {
        parent[rb as usize] = ra
        rank[ra as usize] = rank[ra as usize] + 1
    }
}

// =============================================================================
// Graph Construction
// =============================================================================

pub fn wgraph_new(n: i32, directed: i32) -> WeightedGraph with Mut {
    WeightedGraph {
        weights:    [0.0; 1024],
        weight_unc: [0.0; 1024],
        n_nodes:    n,
        directed:   directed,
    }
}

pub fn wgraph_add_edge(g: WeightedGraph, from: i32, to: i32, weight: f64, unc: f64) -> WeightedGraph with Mut, Div, Panic {
    var g2 = g
    let idx = (from * WGRAPH_MAX + to) as usize
    g2.weights[idx]    = weight
    g2.weight_unc[idx] = unc
    if g2.directed == 0 {
        let idx2 = (to * WGRAPH_MAX + from) as usize
        g2.weights[idx2]    = weight
        g2.weight_unc[idx2] = unc
    }
    g2
}

// =============================================================================
// BFS on WeightedGraph — hop-count distances, no uncertainty on hops
// =============================================================================

pub fn graph_bfs(g: &WeightedGraph, source: i32) -> ShortestPathResult with Mut, Div, Panic {
    let f64_inf: f64 = 1.0e300
    var dist:  [f64; 32] = [0.0; 32]
    var dunc:  [f64; 32] = [0.0; 32]
    var pred:  [i32; 32] = [0; 32]
    var reach: [i32; 32] = [0; 32]

    let n = g.n_nodes
    // initialise to "unreachable"
    var i: i32 = 0
    while i < n {
        dist[i as usize]  = f64_inf
        dunc[i as usize]  = 0.0
        pred[i as usize]  = -1
        reach[i as usize] = 0
        i = i + 1
    }

    if source < 0 || source >= n {
        return ShortestPathResult {
            distances: dist, dist_unc: dunc,
            predecessors: pred, reachable: reach,
        }
    }

    // BFS queue — fixed array, max 32 entries
    var queue: [i32; 32] = [0; 32]
    var qhead: i32 = 0
    var qtail: i32 = 0

    dist[source as usize]  = 0.0
    reach[source as usize] = 1
    queue[qtail as usize] = source
    qtail = qtail + 1

    while qhead < qtail {
        let u = queue[qhead as usize]
        qhead = qhead + 1
        var v: i32 = 0
        while v < n {
            let idx = (u * WGRAPH_MAX + v) as usize
            if g.weights[idx] > 0.0 && reach[v as usize] == 0 {
                dist[v as usize]  = dist[u as usize] + 1.0
                reach[v as usize] = 1
                pred[v as usize]  = u
                if qtail < WGRAPH_MAX {
                    queue[qtail as usize] = v
                    qtail = qtail + 1
                }
            }
            v = v + 1
        }
    }

    ShortestPathResult {
        distances: dist, dist_unc: dunc,
        predecessors: pred, reachable: reach,
    }
}

// =============================================================================
// Connected components on WeightedGraph (undirected)
// =============================================================================

pub fn graph_dfs_connected(g: &WeightedGraph) -> i32 with Mut, Div, Panic {
    let n = g.n_nodes
    var visited: [i32; 32] = [0; 32]
    var components: i32 = 0

    var start: i32 = 0
    while start < n {
        if visited[start as usize] == 0 {
            components = components + 1
            // iterative DFS via stack (fixed array)
            var stack: [i32; 32] = [0; 32]
            var stop: i32 = 0
            stack[stop as usize] = start
            stop = stop + 1
            while stop > 0 {
                stop = stop - 1
                let u = stack[stop as usize]
                if visited[u as usize] == 0 {
                    visited[u as usize] = 1
                    var v: i32 = 0
                    while v < n {
                        let idx = (u * WGRAPH_MAX + v) as usize
                        if g.weights[idx] > 0.0 && visited[v as usize] == 0 {
                            if stop < WGRAPH_MAX {
                                stack[stop as usize] = v
                                stop = stop + 1
                            }
                        }
                        v = v + 1
                    }
                }
            }
        }
        start = start + 1
    }
    components
}

// =============================================================================
// Dijkstra — O(V²) scan, GUM uncertainty propagation along path
//
// GUM rule (§5.1): combined uncertainty along a path is
//   u(d(v)) = sqrt( u(d(u))² + u(w(u,v))² )
// =============================================================================

pub fn dijkstra(g: &WeightedGraph, source: i32) -> ShortestPathResult with Mut, Div, Panic {
    let f64_inf: f64 = 1.0e300
    let n = g.n_nodes
    var dist:    [f64; 32] = [0.0; 32]
    var dunc:    [f64; 32] = [0.0; 32]
    var pred:    [i32; 32] = [0; 32]
    var reach:   [i32; 32] = [0; 32]
    var visited: [i32; 32] = [0; 32]

    var i: i32 = 0
    while i < n {
        dist[i as usize]    = f64_inf
        dunc[i as usize]    = 0.0
        pred[i as usize]    = -1
        reach[i as usize]   = 0
        visited[i as usize] = 0
        i = i + 1
    }

    if source < 0 || source >= n {
        return ShortestPathResult {
            distances: dist, dist_unc: dunc,
            predecessors: pred, reachable: reach,
        }
    }

    dist[source as usize]  = 0.0
    reach[source as usize] = 1

    var processed: i32 = 0
    while processed < n {
        // find unvisited node with minimum distance
        var u: i32 = -1
        var best_d: f64 = f64_inf
        var k: i32 = 0
        while k < n {
            if visited[k as usize] == 0 && dist[k as usize] < best_d {
                best_d = dist[k as usize]
                u = k
            }
            k = k + 1
        }

        if u == -1 { break }   // all remaining nodes unreachable
        visited[u as usize] = 1

        // relax edges from u
        var v: i32 = 0
        while v < n {
            let idx = (u * WGRAPH_MAX + v) as usize
            let w = g.weights[idx]
            if w > 0.0 {
                let nd = dist[u as usize] + w
                if nd < dist[v as usize] {
                    dist[v as usize]  = nd
                    reach[v as usize] = 1
                    pred[v as usize]  = u
                    // GUM quadrature: u(d(v)) = sqrt(u(d(u))^2 + u(w)^2)
                    let uw = g.weight_unc[idx]
                    let ud = dunc[u as usize]
                    dunc[v as usize] = w_sqrt(ud * ud + uw * uw)
                }
            }
            v = v + 1
        }

        processed = processed + 1
    }

    ShortestPathResult {
        distances: dist, dist_unc: dunc,
        predecessors: pred, reachable: reach,
    }
}

// =============================================================================
// PageRank — power iteration with weight-uncertainty propagation
//
// PR(i) = (1-d)/N + d * Σ_{j→i} PR(j) * w(j,i) / out_strength(j)
// Rank uncertainty: u_PR(i) ≈ d * Σ_{j→i} (PR(j)/out_strength(j)) * u_w(j,i)
//
// Uses by-value struct passing to avoid the JIT &! mutation visibility bug.
// =============================================================================

// Internal state carrier for one power-iteration step.
struct PrState {
    scores:     [f64; 32],
    scores_unc: [f64; 32],
    delta:      f64,
}

// Build out-strength array by scanning the graph.
fn pr_make_out_strength(g: &WeightedGraph) -> [f64; 32] with Mut, Div, Panic {
    var out_str: [f64; 32] = [0.0; 32]
    let n = g.n_nodes
    var i: i32 = 0
    while i < n {
        var s: f64 = 0.0
        var j: i32 = 0
        while j < n {
            s = s + g.weights[(i * WGRAPH_MAX + j) as usize]
            j = j + 1
        }
        out_str[i as usize] = s
        i = i + 1
    }
    out_str
}

// One power-iteration step (by-value in/out via PrState).
fn pr_step(g: &WeightedGraph, st: PrState, out_str: [f64; 32], damping: f64, teleport: f64) -> PrState
    with Mut, Div, Panic
{
    let n = g.n_nodes
    var new_scores: [f64; 32] = [0.0; 32]
    var new_unc:    [f64; 32] = [0.0; 32]

    // seed with teleport term
    var k: i32 = 0
    while k < n {
        new_scores[k as usize] = teleport
        k = k + 1
    }

    // accumulate contributions from each source j
    var j: i32 = 0
    while j < n {
        let os = out_str[j as usize]
        if os > 0.0 {
            var vi: i32 = 0
            while vi < n {
                let idx = (j * WGRAPH_MAX + vi) as usize
                let w = g.weights[idx]
                if w > 0.0 {
                    let contrib = damping * st.scores[j as usize] * w / os
                    new_scores[vi as usize] = new_scores[vi as usize] + contrib
                    let uc = damping * st.scores[j as usize] * g.weight_unc[idx] / os
                    new_unc[vi as usize] = new_unc[vi as usize] + uc * uc
                }
                vi = vi + 1
            }
        }
        j = j + 1
    }

    // sqrt the squared uncertainty accumulators
    k = 0
    while k < n {
        new_unc[k as usize] = w_sqrt(new_unc[k as usize])
        k = k + 1
    }

    // L1 delta vs previous scores
    var delta: f64 = 0.0
    k = 0
    while k < n {
        let d = new_scores[k as usize] - st.scores[k as usize]
        if d < 0.0 { delta = delta + (0.0 - d) } else { delta = delta + d }
        k = k + 1
    }

    PrState { scores: new_scores, scores_unc: new_unc, delta: delta }
}

pub fn pagerank(g: &WeightedGraph, damping: f64, max_iter: i32, tol: f64) -> PageRankResult
    with Mut, Div, Panic
{
    let n = g.n_nodes
    var scores: [f64; 32] = [0.0; 32]
    let init = 1.0 / (n as f64)
    var i: i32 = 0
    while i < n {
        scores[i as usize] = init
        i = i + 1
    }

    let out_str = pr_make_out_strength(g)
    let teleport = (1.0 - damping) / (n as f64)

    var st = PrState { scores: scores, scores_unc: [0.0; 32], delta: 1.0e30 }
    var iter: i32 = 0
    var converged: i32 = 0

    while iter < max_iter {
        st = pr_step(g, st, out_str, damping, teleport)
        iter = iter + 1
        if st.delta < tol {
            converged = 1
            break
        }
    }

    PageRankResult {
        scores:       st.scores,
        scores_unc:   st.scores_unc,
        n_iterations: iter,
        converged:    converged,
    }
}

// =============================================================================
// Kruskal MST — union-find, insertion-sort edges by weight
//
// Collects all directed edges (or upper-triangle for undirected) into a
// fixed-size edge list, sorts by weight (insertion sort, O(E²) fine for E≤1024),
// then greedily adds non-cycle edges.
// =============================================================================

pub fn kruskal_mst(g: &WeightedGraph) -> WeightedGraph with Mut, Div, Panic {
    let n = g.n_nodes

    // collect edges into fixed-size arrays (max E = n*(n-1)/2 ≤ 496 for n=32)
    var e_from:  [i32; 512]  = [0; 512]
    var e_to:    [i32; 512]  = [0; 512]
    var e_w:     [f64; 512]  = [0.0; 512]
    var e_unc:   [f64; 512]  = [0.0; 512]
    var ne: i32 = 0

    var i: i32 = 0
    while i < n {
        var j: i32 = 0
        while j < n {
            if g.directed == 1 {
                // directed: every non-zero entry
                let idx = (i * WGRAPH_MAX + j) as usize
                if g.weights[idx] > 0.0 && ne < 512 {
                    e_from[ne as usize] = i
                    e_to[ne as usize]   = j
                    e_w[ne as usize]    = g.weights[idx]
                    e_unc[ne as usize]  = g.weight_unc[idx]
                    ne = ne + 1
                }
            } else {
                // undirected: upper triangle only
                if j > i {
                    let idx = (i * WGRAPH_MAX + j) as usize
                    if g.weights[idx] > 0.0 && ne < 512 {
                        e_from[ne as usize] = i
                        e_to[ne as usize]   = j
                        e_w[ne as usize]    = g.weights[idx]
                        e_unc[ne as usize]  = g.weight_unc[idx]
                        ne = ne + 1
                    }
                }
            }
            j = j + 1
        }
        i = i + 1
    }

    // insertion sort by weight ascending
    var s: i32 = 1
    while s < ne {
        let kw   = e_w[s as usize]
        let ku   = e_unc[s as usize]
        let kf   = e_from[s as usize]
        let kt   = e_to[s as usize]
        var p: i32 = s - 1
        while p >= 0 && e_w[p as usize] > kw {
            e_w[(p + 1) as usize]    = e_w[p as usize]
            e_unc[(p + 1) as usize]  = e_unc[p as usize]
            e_from[(p + 1) as usize] = e_from[p as usize]
            e_to[(p + 1) as usize]   = e_to[p as usize]
            p = p - 1
        }
        e_w[(p + 1) as usize]    = kw
        e_unc[(p + 1) as usize]  = ku
        e_from[(p + 1) as usize] = kf
        e_to[(p + 1) as usize]   = kt
        s = s + 1
    }

    // union-find
    var uf_parent: [i32; 32] = [0; 32]
    var uf_rank:   [i32; 32] = [0; 32]
    var init_k: i32 = 0
    while init_k < n {
        uf_parent[init_k as usize] = init_k
        uf_rank[init_k as usize]   = 0
        init_k = init_k + 1
    }

    var mst = wgraph_new(n, g.directed)
    var ei: i32 = 0
    while ei < ne {
        let u = e_from[ei as usize]
        let v = e_to[ei as usize]

        // inline find-root for u (avoids shared-borrow overlap with mutable union)
        var ru: i32 = u
        var ru_steps: i32 = 0
        while ru_steps < 32 {
            let rp = uf_parent[ru as usize]
            if rp == ru { break }
            ru = rp
            ru_steps = ru_steps + 1
        }

        // inline find-root for v
        var rv: i32 = v
        var rv_steps: i32 = 0
        while rv_steps < 32 {
            let rp = uf_parent[rv as usize]
            if rp == rv { break }
            rv = rp
            rv_steps = rv_steps + 1
        }

        if ru != rv {
            mst = wgraph_add_edge(mst, u, v, e_w[ei as usize], e_unc[ei as usize])
            // inline union-by-rank (avoids &! caller visibility bug)
            if uf_rank[ru as usize] < uf_rank[rv as usize] {
                uf_parent[ru as usize] = rv
            } else if uf_rank[ru as usize] > uf_rank[rv as usize] {
                uf_parent[rv as usize] = ru
            } else {
                uf_parent[rv as usize] = ru
                uf_rank[ru as usize] = uf_rank[ru as usize] + 1
            }
        }
        ei = ei + 1
    }

    mst
}

// =============================================================================
// Topological Sort — Kahn's algorithm (BFS-based)
// Returns TopoSortResult: order array + count (-1 = cycle detected).
// By-value return avoids the JIT &! mutation visibility bug.
// =============================================================================

pub fn topo_sort(g: &WeightedGraph) -> TopoSortResult with Mut, Div, Panic {
    let n = g.n_nodes
    var order: [i32; 32] = [0; 32]

    // compute in-degree for each node
    var indeg: [i32; 32] = [0; 32]
    var i: i32 = 0
    while i < n {
        var j: i32 = 0
        while j < n {
            if g.weights[(j * WGRAPH_MAX + i) as usize] > 0.0 {
                indeg[i as usize] = indeg[i as usize] + 1
            }
            j = j + 1
        }
        i = i + 1
    }

    // enqueue zero-indegree nodes
    var queue: [i32; 32] = [0; 32]
    var qhead: i32 = 0
    var qtail: i32 = 0

    i = 0
    while i < n {
        if indeg[i as usize] == 0 {
            queue[qtail as usize] = i
            qtail = qtail + 1
        }
        i = i + 1
    }

    var cnt: i32 = 0
    while qhead < qtail {
        let u = queue[qhead as usize]
        qhead = qhead + 1
        order[cnt as usize] = u
        cnt = cnt + 1

        var v: i32 = 0
        while v < n {
            if g.weights[(u * WGRAPH_MAX + v) as usize] > 0.0 {
                indeg[v as usize] = indeg[v as usize] - 1
                if indeg[v as usize] == 0 {
                    queue[qtail as usize] = v
                    qtail = qtail + 1
                }
            }
            v = v + 1
        }
    }

    let count = if cnt < n { -1 } else { cnt }
    TopoSortResult { order: order, count: count }
}
