// Test: connectivity of connected path graph P4
fn test_gsp_connected_p4() -> bool with Div, Mut, Panic {
    var adj = gsp_zero_adj()
    gsp_add_edge(&! adj, 4, 0, 1)
    gsp_add_edge(&! adj, 4, 1, 2)
    gsp_add_edge(&! adj, 4, 2, 3)
    return gsp_is_connected(adj, 4)
}

// Test: star graph S3 is connected (center=0, leaves=1,2,3)
fn test_gsp_connected_star() -> bool with Div, Mut, Panic {
    var adj = gsp_zero_adj()
    gsp_add_edge(&! adj, 4, 0, 1)
    gsp_add_edge(&! adj, 4, 0, 2)
    gsp_add_edge(&! adj, 4, 0, 3)
    return gsp_is_connected(adj, 4)
}

// Test: empty graph (no edges, 4 nodes) is NOT connected
fn test_gsp_not_connected_empty() -> bool with Div, Mut, Panic {
    var adj = gsp_zero_adj()
    // No edges added — empty graph on 4 nodes
    let connected = gsp_is_connected(adj, 4)
    return !connected
}

// Test: two disconnected components is not connected
fn test_gsp_not_connected_two_components() -> bool with Div, Mut, Panic {
    var adj = gsp_zero_adj()
    // Component 1: 0-1
    gsp_add_edge(&! adj, 4, 0, 1)
    // Component 2: 2-3
    gsp_add_edge(&! adj, 4, 2, 3)
    let connected = gsp_is_connected(adj, 4)
    return !connected
}

// Test: single node is connected
fn test_gsp_connected_single() -> bool with Div, Mut, Panic {
    var adj = gsp_zero_adj()
    return gsp_is_connected(adj, 1)
}

// Test: K3 is connected
fn test_gsp_connected_k3() -> bool with Div, Mut, Panic {
    var adj = gsp_zero_adj()
    gsp_add_edge(&! adj, 3, 0, 1)
    gsp_add_edge(&! adj, 3, 0, 2)
    gsp_add_edge(&! adj, 3, 1, 2)
    return gsp_is_connected(adj, 3)
}

