// Test: empty graph has energy 0
fn test_gsp_graph_energy_trivial() -> bool with Div, Mut, Panic {
    var adj = gsp_zero_adj()
    return gsp_approx_eq(gsp_graph_energy(adj, 3), 0.0, 1.0e-12)
}

// Test: P3 energy > 0
fn test_gsp_graph_energy_p3() -> bool with Div, Mut, Panic {
    var adj = gsp_zero_adj()
    gsp_add_edge(&! adj, 3, 0, 1)
    gsp_add_edge(&! adj, 3, 1, 2)
    return gsp_graph_energy(adj, 3) > 0.0
}

