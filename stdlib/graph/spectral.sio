    gsp_laplacian(adj, 3, &! lap)
    // L[0,0]=1, L[1,1]=2, L[2,2]=1
    return gsp_approx_eq(lap[0*3+0], 1.0, 1.0e-12)
        && gsp_approx_eq(lap[1*3+1], 2.0, 1.0e-12)
        && gsp_approx_eq(lap[2*3+2], 1.0, 1.0e-12)
}

