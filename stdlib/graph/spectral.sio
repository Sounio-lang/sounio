// Add undirected edge (u, v) to adjacency matrix (for n x n matrix)
fn gsp_add_edge(adj: &! [f64; 1024], n: i64, u: i64, v: i64) with Div, Mut, Panic {
    adj[(u * n + v) as usize] = 1.0
    adj[(v * n + u) as usize] = 1.0
}

// ============================================================================
// UNIT TESTS
// ============================================================================

// Test: degree of isolated vertex = 0
fn test_gsp_degree_isolated() -> bool with Div, Mut, Panic {
    var adj = gsp_zero_adj()
    let d = gsp_degree(adj, 4, 0)
    return gsp_approx_eq(d, 0.0, 1.0e-12)
}

// Test: degree of vertex with 2 neighbors = 2
fn test_gsp_degree_path3() -> bool with Div, Mut, Panic {
    // Path graph P3: 0-1-2
    var adj = gsp_zero_adj()
    gsp_add_edge(&! adj, 3, 0, 1)
    gsp_add_edge(&! adj, 3, 1, 2)
    // degree(0)=1, degree(1)=2, degree(2)=1
    let d0 = gsp_degree(adj, 3, 0)
    let d1 = gsp_degree(adj, 3, 1)
    let d2 = gsp_degree(adj, 3, 2)
    return gsp_approx_eq(d0, 1.0, 1.0e-12)
        && gsp_approx_eq(d1, 2.0, 1.0e-12)
        && gsp_approx_eq(d2, 1.0, 1.0e-12)
}

