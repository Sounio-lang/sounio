    // lambda_max(L_{K3}) = 3
    return gsp_approx_eq(lmax, 3.0, 0.01)
}

// Test: graph energy >= 0
fn test_gsp_energy_nonneg() -> bool with Div, Mut, Panic {
    var adj = gsp_zero_adj()
    gsp_add_edge(&! adj, 4, 0, 1)
    gsp_add_edge(&! adj, 4, 1, 2)
    gsp_add_edge(&! adj, 4, 2, 3)
    let e = gsp_graph_energy(adj, 4)
    return e >= 0.0
}

// Test: graph energy of empty graph = 0
fn test_gsp_energy_empty() -> bool with Div, Mut, Panic {
    var adj = gsp_zero_adj()
    let e = gsp_graph_energy(adj, 4)
    return gsp_approx_eq(e, 0.0, 1.0e-12)
}

// Test: num edges of P3 = 2
fn test_gsp_num_edges_p3() -> bool with Div, Mut, Panic {
    var adj = gsp_zero_adj()
    gsp_add_edge(&! adj, 3, 0, 1)
    gsp_add_edge(&! adj, 3, 1, 2)
    let m = gsp_num_edges(adj, 3)
    return m == 2
}

// Test: num edges of K4 = 6
fn test_gsp_num_edges_k4() -> bool with Div, Mut, Panic {
    var adj = gsp_zero_adj()
    gsp_add_edge(&! adj, 4, 0, 1)
    gsp_add_edge(&! adj, 4, 0, 2)
    gsp_add_edge(&! adj, 4, 0, 3)
    gsp_add_edge(&! adj, 4, 1, 2)
    gsp_add_edge(&! adj, 4, 1, 3)
    gsp_add_edge(&! adj, 4, 2, 3)
    let m = gsp_num_edges(adj, 4)
    return m == 6
}

// Test: max degree of star S3 (center has degree 3)
fn test_gsp_max_degree_star() -> bool with Div, Mut, Panic {
    var adj = gsp_zero_adj()
    gsp_add_edge(&! adj, 4, 0, 1)
    gsp_add_edge(&! adj, 4, 0, 2)
    gsp_add_edge(&! adj, 4, 0, 3)
    let d = gsp_max_degree(adj, 4)
    return gsp_approx_eq(d, 3.0, 1.0e-12)
}

// Test: degree sum of K4 = 4*3 = 12
fn test_gsp_degree_sum_k4() -> bool with Div, Mut, Panic {
    var adj = gsp_zero_adj()
    gsp_add_edge(&! adj, 4, 0, 1)
    gsp_add_edge(&! adj, 4, 0, 2)
    gsp_add_edge(&! adj, 4, 0, 3)
    gsp_add_edge(&! adj, 4, 1, 2)
    gsp_add_edge(&! adj, 4, 1, 3)
    gsp_add_edge(&! adj, 4, 2, 3)
    let s = gsp_degree_sum(adj, 4)
    return gsp_approx_eq(s, 12.0, 1.0e-12)
}

// Test: algebraic connectivity of disconnected graph = 0
fn test_gsp_ac_disconnected() -> bool with Div, Mut, Panic {
    var adj = gsp_zero_adj()
    // Two components: {0,1} and {2,3}
    gsp_add_edge(&! adj, 4, 0, 1)
    gsp_add_edge(&! adj, 4, 2, 3)
    let ac = gsp_algebraic_connectivity_approx(adj, 4)
    return ac < 0.1  // Should be close to 0 for disconnected
}

// Test: algebraic connectivity of K3 > 0 (strongly connected)
fn test_gsp_ac_connected() -> bool with Div, Mut, Panic {
    var adj = gsp_zero_adj()
    gsp_add_edge(&! adj, 3, 0, 1)
    gsp_add_edge(&! adj, 3, 0, 2)
    gsp_add_edge(&! adj, 3, 1, 2)
    let ac = gsp_algebraic_connectivity_approx(adj, 3)
    // lambda_2(K3) = 3 (the exact Fiedler value)
    return ac > 0.0
}

