// graph/curvature.sio — Discrete Curvature on Graphs
// Ollivier-Ricci, Forman, and sectional curvature for graph analysis

fn curv_abs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }
fn curv_sqrt(x: f64) -> f64 {
    if x <= 0.0 { return 0.0 }
    var r = x
    var i = 0
    while i < 15 { r = 0.5 * (r + x / r); i = i + 1 }
    r
}
fn curv_max(a: f64, b: f64) -> f64 { if a > b { a } else { b } }

// Graph as adjacency matrix (max 32 nodes)
struct CurvGraph {
    adj: [i32; 1024],   // 32x32 adjacency matrix
    n: i32,
}

fn curv_graph_new(n: i32) -> CurvGraph {
    CurvGraph { adj: [0; 1024], n: n }
}

fn curv_add_edge(g: CurvGraph, u: i32, v: i32) -> CurvGraph with Mut, Div, Panic {
    var result = g
    result.adj[u * 32 + v] = 1
    result.adj[v * 32 + u] = 1
    result
}

fn curv_has_edge(g: &CurvGraph, u: i32, v: i32) -> bool {
    g.adj[u * 32 + v] == 1
}

fn curv_degree(g: &CurvGraph, v: i32) -> i32 with Mut, Div, Panic {
    var d: i32 = 0
    var i: i32 = 0
    while i < g.n { if g.adj[v * 32 + i] == 1 { d = d + 1 }; i = i + 1 }
    d
}

// Forman curvature of edge (u, v)
// F(u,v) = 4 - deg(u) - deg(v) + 3*triangles(u,v)
fn forman_curvature_edge(g: &CurvGraph, u: i32, v: i32) -> f64 with Mut, Div, Panic {
    let du = curv_degree(g, u)
    let dv = curv_degree(g, v)
    // Count triangles containing edge (u,v)
    var triangles: i32 = 0
    var w: i32 = 0
    while w < g.n {
        if w != u && w != v {
            if curv_has_edge(g, u, w) && curv_has_edge(g, v, w) {
                triangles = triangles + 1
            }
        }
        w = w + 1
    }
    (4 - du - dv + 3 * triangles) as f64
}

// Mean Forman curvature over all edges
fn mean_forman_curvature(g: &CurvGraph) -> f64 with Mut, Div, Panic {
    var sum = 0.0
    var count: i32 = 0
    var u: i32 = 0
    while u < g.n {
        var v: i32 = u + 1
        while v < g.n {
            if curv_has_edge(g, u, v) {
                sum = sum + forman_curvature_edge(g, u, v)
                count = count + 1
            }
            v = v + 1
        }
        u = u + 1
    }
    if count == 0 { 0.0 } else { sum / (count as f64) }
}

// Ollivier-Ricci curvature (simplified: 1-optimal transport cost between neighbors)
fn ollivier_ricci_edge(g: &CurvGraph, u: i32, v: i32) -> f64 with Mut, Div, Panic {
    let du = curv_degree(g, u)
    let dv = curv_degree(g, v)
    if du == 0 || dv == 0 { return 0.0 }
    // Count common neighbors
    var common: i32 = 0
    var w: i32 = 0
    while w < g.n {
        if curv_has_edge(g, u, w) && curv_has_edge(g, v, w) { common = common + 1 }
        w = w + 1
    }
    // Simplified: kappa ~ 2*common/(du+dv) - 1
    let kappa = 2.0 * (common as f64) / ((du + dv) as f64)
    kappa
}

// Geometry classification based on mean curvature
fn classify_geometry(mean_curv: f64) -> i32 {
    // 0 = flat (Euclidean), 1 = positive (spherical), 2 = negative (hyperbolic)
    if curv_abs(mean_curv) < 0.1 { 0 }
    else if mean_curv > 0.0 { 1 }
    else { 2 }
}

fn test_triangle_forman() -> bool with Mut, Div, Panic {
    var g = curv_graph_new(3)
    g = curv_add_edge(g, 0, 1)
    g = curv_add_edge(g, 1, 2)
    g = curv_add_edge(g, 0, 2)
    let f = forman_curvature_edge(&g, 0, 1)
    // 4 - 2 - 2 + 3*1 = 3
    curv_abs(f - 3.0) < 0.01
}

fn test_path_forman() -> bool with Mut, Div, Panic {
    var g = curv_graph_new(3)
    g = curv_add_edge(g, 0, 1)
    g = curv_add_edge(g, 1, 2)
    let f = forman_curvature_edge(&g, 0, 1)
    // 4 - 1 - 2 + 0 = 1
    curv_abs(f - 1.0) < 0.01
}

fn test_ollivier_ricci() -> bool with Mut, Div, Panic {
    var g = curv_graph_new(4)
    g = curv_add_edge(g, 0, 1)
    g = curv_add_edge(g, 0, 2)
    g = curv_add_edge(g, 0, 3)
    g = curv_add_edge(g, 1, 2)
    let kappa = ollivier_ricci_edge(&g, 0, 1)
    kappa >= 0.0
}
