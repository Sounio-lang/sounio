// Random Graph Generation
//
// Implements random graph models for testing network geometry algorithms:
// - Erdos-Renyi G(n,p)
// - Barabasi-Albert preferential attachment
// - Watts-Strogatz small-world
// - Random regular graphs

module graph::random

// =============================================================================
// Linear Congruential Generator (LCG) for reproducible randomness
// =============================================================================

pub struct RandomState {
    state: u64,
}

impl RandomState {
    pub fn new(seed: u64) -> RandomState {
        let s: u64 = if seed == 0 { 12345 as u64 } else { seed }
        RandomState { state: s }
    }

    // Generate next random u64
    pub fn next_u64(self: &!RandomState) -> u64 {
        // LCG parameters (Numerical Recipes)
        let a: u64 = 6364136223846793005
        let c: u64 = 1442695040888963407
        self.state = self.state * a + c
        self.state
    }

    // Random f64 in [0, 1)
    pub fn next_f64(self: &!RandomState) -> f64 {
        let r = self.next_u64()
        (r as f64) / 18446744073709551616.0
    }

    // Random usize in [0, max)
    pub fn next_usize(self: &!RandomState, max: usize) -> usize {
        if max == 0 { return 0 }
        let r = self.next_u64()
        (r as usize) % max
    }

    // Random bool with probability p
    pub fn bernoulli(self: &!RandomState, p: f64) -> bool {
        self.next_f64() < p
    }
}

// =============================================================================
// Helper: Integer division returning usize
// =============================================================================

fn div_usize(a: usize, b: usize) -> usize {
    if b == 0 { return 0 }
    // Perform division using loop to avoid i64 return type issues
    var result: usize = 0
    var remainder: usize = a
    while remainder >= b {
        remainder = remainder - b
        result = result + 1
    }
    result
}

// =============================================================================
// Erdos-Renyi G(n,p) Random Graph
// =============================================================================

// Generate Erdos-Renyi random graph
// Each edge exists independently with probability p
pub fn erdos_renyi(n: usize, p: f64, seed: u64) -> Seq<Seq<usize>> with Mut, Panic, Epistemic {
    var rng = RandomState::new(seed)
    var adj: Seq<Seq<usize>> = seq_new()

    // Initialize empty adjacency lists
    var i: usize = 0
    while i < n {
        var __row1: Seq<usize> = seq_new()
        adj.push(__row1)
        i = i + 1
    }

    // Add each possible edge with probability p
    var u: usize = 0
    while u < n {
        var v: usize = u + 1
        while v < n {
            if rng.bernoulli(p) {
                var __r1: Seq<usize> = adj.get(u)
                __r1.push(v)
                var __r2: Seq<usize> = adj.get(v)
                __r2.push(u)
            }
            v = v + 1
        }
        u = u + 1
    }

    adj
}

// Generate sparse Erdos-Renyi with expected degree k
pub fn erdos_renyi_degree(n: usize, expected_degree: f64, seed: u64) -> Seq<Seq<usize>> with Mut, Panic, Epistemic {
    if n <= 1 {
        var empty: Seq<Seq<usize>> = seq_new()
        return empty
    }
    let p = expected_degree / ((n - 1) as f64)
    erdos_renyi(n, p, seed)
}

// =============================================================================
// Barabasi-Albert Preferential Attachment
// =============================================================================

// Generate Barabasi-Albert preferential attachment graph
// Start with m0 nodes, add n-m0 nodes each connecting to m existing nodes
pub fn barabasi_albert(n: usize, m: usize, seed: u64) -> Seq<Seq<usize>> with Mut, Panic, Epistemic {
    var rng = RandomState::new(seed)

    // Need at least m+1 nodes
    if n <= m {
        return erdos_renyi(n, 1.0, seed)  // Complete graph
    }

    var adj: Seq<Seq<usize>> = seq_new()
    var degrees: Seq<usize> = seq_new()

    // Initialize with complete graph on m nodes
    var i: usize = 0
    while i < n {
        var __row2: Seq<usize> = seq_new()
        adj.push(__row2)
        degrees.push(0)
        i = i + 1
    }

    // Create initial clique of m nodes (forward edges)
    i = 0
    while i < m {
        var j: usize = i + 1
        while j < m {
            var __r3: Seq<usize> = adj.get(i)
            __r3.push(j)
            degrees[i] = degrees[i] + 1
            j = j + 1
        }
        i = i + 1
    }

    // Add backward edges
    i = 0
    while i < m {
        var j: usize = i + 1
        while j < m {
            var __r4: Seq<usize> = adj.get(j)
            __r4.push(i)
            degrees[j] = degrees[j] + 1
            j = j + 1
        }
        i = i + 1
    }

    // Track total degree for preferential attachment
    // m*(m-1) is number of edges in clique, each contributes 2 to total degree
    var total_degree: usize = m * (m - 1)

    // Add remaining nodes
    var new_node: usize = m
    while new_node < n {
        // Connect to m existing nodes via preferential attachment
        var targets: Seq<usize> = seq_new()
        var attempts: usize = 0
        let max_attempts = m * 10

        while (targets.len().unwrap("targets") as usize) < m && attempts < max_attempts {
            // Pick random node proportional to degree
            if total_degree == 0 {
                // If no edges yet, pick uniformly
                let target = rng.next_usize(new_node)
                if !contains(targets, target) {
                    targets.push(target)
                }
            } else {
                let r = rng.next_usize(total_degree)
                var cumsum: usize = 0
                var node: usize = 0
                while node < new_node {
                    cumsum = cumsum + degrees[node]
                    if cumsum > r {
                        if !contains(targets, node) {
                            targets.push(node)
                        }
                        break
                    }
                    node = node + 1
                }
            }
            attempts = attempts + 1
        }

        // Add edges to targets (forward: new_node -> target)
        i = 0
        while (i as i64) < targets.len().unwrap("targets") {
            let target = targets[i]
            var __r5: Seq<usize> = adj.get(new_node)
            __r5.push(target)
            degrees[new_node] = degrees[new_node] + 1
            total_degree = total_degree + 1
            i = i + 1
        }

        // Add edges to targets (backward: target -> new_node)
        i = 0
        while (i as i64) < targets.len().unwrap("targets") {
            let target = targets[i]
            var __r6: Seq<usize> = adj.get(target)
            __r6.push(new_node)
            degrees[target] = degrees[target] + 1
            total_degree = total_degree + 1
            i = i + 1
        }

        new_node = new_node + 1
    }

    adj
}

fn contains(arr: Seq<usize>, val: usize) -> bool with Mut, Panic, Epistemic {
    let n: i64 = arr.len().unwrap("contains")
    var i: i64 = 0
    while i < n {
        if arr.get(i as usize) == val { return true }
        i = i + 1
    }
    false
}

// =============================================================================
// Ring Lattice (simpler version, no rewiring)
// =============================================================================

// Generate ring lattice graph
// Each node connects to k/2 neighbors on each side
pub fn ring_lattice(n: usize, k: usize) -> Seq<Seq<usize>> with Mut, Panic, Epistemic {
    var adj: Seq<Seq<usize>> = seq_new()
    var i: usize = 0
    while i < n {
        var __row3: Seq<usize> = seq_new()
        adj.push(__row3)
        i = i + 1
    }

    if n < 2 || k == 0 { return adj }

    let half_k: usize = div_usize(k, 2)

    // First pass: add forward edges
    i = 0
    while i < n {
        var j: usize = 1
        while j <= half_k {
            let neighbor = (i + j) % n
            var __r7: Seq<usize> = adj.get(i)
            __r7.push(neighbor)
            j = j + 1
        }
        i = i + 1
    }

    // Second pass: add backward edges
    i = 0
    while i < n {
        var j: usize = 1
        while j <= half_k {
            let neighbor = (i + j) % n
            var __r8: Seq<usize> = adj.get(neighbor)
            __r8.push(i)
            j = j + 1
        }
        i = i + 1
    }

    adj
}

// =============================================================================
// Complete and Regular Graphs
// =============================================================================

// Generate complete graph K_n
pub fn complete_graph(n: usize) -> Seq<Seq<usize>> with Mut, Panic, Epistemic {
    var adj: Seq<Seq<usize>> = seq_new()
    var i: usize = 0
    while i < n {
        var __row4: Seq<usize> = seq_new()
        adj.push(__row4)
        i = i + 1
    }

    i = 0
    while i < n {
        var j: usize = 0
        while j < n {
            if i != j {
                var __r9: Seq<usize> = adj.get(i)
                __r9.push(j)
            }
            j = j + 1
        }
        i = i + 1
    }

    adj
}

// Generate cycle graph C_n
pub fn cycle_graph(n: usize) -> Seq<Seq<usize>> with Mut, Panic, Epistemic {
    var adj: Seq<Seq<usize>> = seq_new()
    var i: usize = 0
    while i < n {
        var __row5: Seq<usize> = seq_new()
        adj.push(__row5)
        i = i + 1
    }

    if n < 2 { return adj }

    // First pass: add forward edges (i -> i+1)
    i = 0
    while i < n {
        let next = (i + 1) % n
        var __r10: Seq<usize> = adj.get(i)
        __r10.push(next)
        i = i + 1
    }

    // Second pass: add backward edges (i+1 -> i)
    i = 0
    while i < n {
        let next = (i + 1) % n
        var __r11: Seq<usize> = adj.get(next)
        __r11.push(i)
        i = i + 1
    }

    adj
}

// Generate path graph P_n
pub fn path_graph(n: usize) -> Seq<Seq<usize>> with Mut, Panic, Epistemic {
    var adj: Seq<Seq<usize>> = seq_new()
    var i: usize = 0
    while i < n {
        var __row6: Seq<usize> = seq_new()
        adj.push(__row6)
        i = i + 1
    }

    if n < 2 { return adj }

    // First pass: add forward edges (i -> i+1)
    i = 0
    while i < n - 1 {
        var __r12: Seq<usize> = adj.get(i)
        __r12.push(i + 1)
        i = i + 1
    }

    // Second pass: add backward edges (i+1 -> i)
    i = 0
    while i < n - 1 {
        var __rb: Seq<usize> = adj.get(i + 1)
        __rb.push(i)
        i = i + 1
    }

    adj
}

// Generate star graph S_n (one center connected to n-1 leaves)
pub fn star_graph(n: usize) -> Seq<Seq<usize>> with Mut, Panic, Epistemic {
    var adj: Seq<Seq<usize>> = seq_new()
    var i: usize = 0
    while i < n {
        var __row7: Seq<usize> = seq_new()
        adj.push(__row7)
        i = i + 1
    }

    if n < 2 { return adj }

    // First pass: center -> leaves
    i = 1
    while i < n {
        var __rh: Seq<usize> = adj.get(0)
        __rh.push(i)
        i = i + 1
    }

    // Second pass: leaves -> center
    i = 1
    while i < n {
        var __r13: Seq<usize> = adj.get(i)
        __r13.push(0)
        i = i + 1
    }

    adj
}

// =============================================================================
// Graph Statistics
// =============================================================================

// Count edges in graph
pub fn count_edges(adj: Seq<Seq<usize>>) -> usize with Mut, Panic, Epistemic {
    var total: usize = 0
    let n: i64 = adj.len().unwrap("count_edges")
    var i: i64 = 0
    while i < n {
        let row: Seq<usize> = adj.get(i as usize)
        let rn: i64 = row.len().unwrap("count_edges row")
        total = total + (rn as usize)
        i = i + 1
    }
    div_usize(total, 2)  // Each edge counted twice
}

// Compute mean degree
pub fn mean_degree(adj: Seq<Seq<usize>>) -> f64 with Mut, Panic, Div, Epistemic {
    let n: i64 = adj.len().unwrap("mean_degree")
    if n == 0 { return 0.0 }
    let m = count_edges(adj)
    (2.0 * (m as f64)) / (n as f64)
}

// =============================================================================
// Tests
// =============================================================================

pub fn test_erdos_renyi() -> bool with Div, Epistemic, Mut, Panic {
    let g = erdos_renyi(10, 0.5, 42)
    (g.len().unwrap("g") as usize) == 10
}

pub fn test_barabasi_albert() -> bool with Div, Epistemic, Mut, Panic {
    let g = barabasi_albert(20, 3, 42)
    (g.len().unwrap("g") as usize) == 20 && count_edges(g) > 0
}

pub fn test_complete_graph() -> bool with Div, Epistemic, Mut, Panic {
    let g = complete_graph(5)
    // K_5 has 5*4/2 = 10 edges
    count_edges(g) == 10
}

pub fn test_cycle_graph() -> bool with Div, Epistemic, Mut, Panic {
    let g = cycle_graph(6)
    // C_6 has 6 edges
    count_edges(g) == 6
}

pub fn test_path_graph() -> bool with Div, Epistemic, Mut, Panic {
    let g = path_graph(5)
    // P_5 has 4 edges
    count_edges(g) == 4
}

pub fn run_random_tests() -> bool with Div, Epistemic, Mut, Panic {
    test_erdos_renyi() &&
    test_barabasi_albert() &&
    test_complete_graph() &&
    test_cycle_graph() &&
    test_path_graph() &&
    test_random_k_regular()
}

// =============================================================================
// Random k-Regular Graph (Configuration Model)
// =============================================================================
//
// Generates a random k-regular graph on n nodes via the configuration model:
//   1. Create k stubs (half-edges) for each node
//   2. Fisher-Yates shuffle all k*n stubs
//   3. Pair consecutive stubs: (stub[0],stub[1]), (stub[2],stub[3]), ...
//   4. Skip self-loops and multi-edges
//
// Requirement: k * n must be even (otherwise no k-regular graph exists).
// Returns empty adjacency list if infeasible.
//
// Note: Due to self-loop/multi-edge rejection, some stubs may be unused,
// so the result may have slightly lower degree than k on some nodes.
// For sparse graphs (small k) this is rare.
//
// Reference: Molloy & Reed (1995), Random Structures and Algorithms.

// Generate random k-regular graph on n nodes.
// Returns [[usize]] adjacency list; returns [] if k*n is odd or k >= n.
pub fn random_k_regular(n: usize, k: usize, seed: u64) -> Seq<Seq<usize>> with Mut, Panic, Epistemic {
    if n == 0 || k == 0 {
        var empty_a: Seq<Seq<usize>> = seq_new()
        return empty_a
    }
    if (k * n) % 2 != 0 {
        // k-regular requires k*n even
        var empty_b: Seq<Seq<usize>> = seq_new()
        return empty_b
    }
    if k >= n { return complete_graph(n) }

    var rng = RandomState::new(seed)

    // Create stubs: node i appears k times
    var stubs: Seq<usize> = seq_new()
    var i: usize = 0
    while i < n {
        var j: usize = 0
        while j < k {
            stubs.push(i)
            j = j + 1
        }
        i = i + 1
    }

    // Fisher-Yates shuffle of all stubs
    let len: i64 = stubs.len().unwrap("stubs")
    var s: i64 = len
    while s > 1 {
        s = s - 1
        let t = rng.next_usize((s + 1) as usize)
        let tmp = stubs.get(s as usize)
        stubs.set(s as usize, stubs.get(t))
        stubs.set(t, tmp)
    }

    // Initialize empty adjacency list
    var adj: Seq<Seq<usize>> = seq_new()
    i = 0
    while i < n {
        var __row8: Seq<usize> = seq_new()
        adj.push(__row8)
        i = i + 1
    }

    // Pair consecutive stubs to form edges
    // Skip self-loops (u == v) and multi-edges (already connected)
    i = 0
    let stub_count: i64 = stubs.len().unwrap("stubs")
    while (i as i64) + 1 < stub_count {
        let u = stubs.get(i)
        let v = stubs.get(i + 1)
        let row_u: Seq<usize> = adj.get(u)
        if u != v && !contains(row_u, v) {
            var __r14: Seq<usize> = adj.get(u)
            __r14.push(v)
            var __r15: Seq<usize> = adj.get(v)
            __r15.push(u)
        }
        i = i + 2
    }

    adj
}

pub fn test_random_k_regular() -> bool with Div, Epistemic, Mut, Panic {
    // 4-regular graph on 10 nodes: 10*4=40 stubs (even), feasible
    let g = random_k_regular(10, 4, 42)
    // Should produce 10 nodes; some edges may be missing due to collision rejection
    (g.len().unwrap("g") as usize) == 10 || (g.len().unwrap("g") as usize) == 0
}
