// stdlib/graph/nulls/mod.sio — Public exports for the graph::nulls module
//
// Null models for statistical comparison in graph analysis: random graphs with
// controlled properties, used to test whether an observed graph statistic is
// more extreme than chance.
//
// Per stdlib/CONVENTIONS.md §2, mod.sio declares only the public surface
// (pub use re-exports). Implementations live in the sibling files.
//
// Sounio has no `mod` item; a submodule is reached by path (`use
// graph::nulls::configuration::*`), so the `pub mod` lines that once stood
// here were inert Rust syntax that also stopped this file parsing.

pub use graph::nulls::configuration::{
    ConfigurationModel,
    NullModelStats,
    configuration_ensemble,
    configuration_model,
    create_empty_adjacency,
    edge_swap_configuration,
    extract_degree_sequence,
    null_model_significance,
    run_configuration_tests,
    test_degree_preservation,
    test_edge_swap_preserves_degrees,
    test_no_self_loops,
    verify_degree_sequence,
}
