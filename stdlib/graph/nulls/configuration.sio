// Configuration Model - Degree-Preserving Null Graph
//
// Generates random graphs that preserve the degree sequence of the input graph.
// Useful for null hypothesis testing in network analysis.
//
// References:
// - Chung & Lu (2002): "Connected components in random graphs"
// - Fosdick, Larremore, Nishimura, Nowak (2018): "Configuring random graph models"

module graph::nulls::configuration

// =============================================================================
// Types
// =============================================================================

pub struct DegreeSequence {
    pub degrees: [usize],
    pub total_degree: usize,
}

pub struct ConfigurationModel {
    pub adjacency: [[usize]],
    pub num_nodes: usize,
    pub num_edges: usize,
}

// =============================================================================
// Degree Sequence Extraction
// =============================================================================

/// Extract degree sequence from an adjacency list
pub fn get_degree_sequence(adj: &[[usize]]) -> [usize] {
    let n = adj.len()
    var degrees: [usize] = []

    var i: usize = 0
    while i < n {
        degrees.push(adj[i].len())
        i = i + 1
    }

    degrees
}

/// Validate that degree sequence is graphical (can form valid graph)
pub fn is_graphical_sequence(degrees: &[usize]) -> bool {
    // Handshaking lemma: sum of degrees must be even
    var sum: usize = 0
    var i: usize = 0
    while i < degrees.len() {
        sum = sum + degrees[i]
        i = i + 1
    }

    sum % 2 == 0
}

// =============================================================================
// Configuration Model Generation
// =============================================================================

/// Generate configuration model preserving degree sequence
/// Uses stub-matching approach: creates edge stubs then randomly matches them
pub fn configuration_model_from_graph(adj: &[[usize]]) -> [[usize]] {
    let degrees = get_degree_sequence(adj)
    configuration_model_from_degrees(&degrees, adj.len())
}

/// Generate configuration model from explicit degree sequence
/// n: number of nodes
pub fn configuration_model_from_degrees(degrees: &[usize], n: usize) -> [[usize]] {
    // Initialize adjacency list
    var null_adj: [[usize]] = []
    var i: usize = 0
    while i < n {
        null_adj.push([])
        i = i + 1
    }

    // If not graphical, return empty graph
    if !is_graphical_sequence(degrees) {
        return null_adj
    }

    // Create stub pairs: each node i appears degrees[i] times
    var stubs: [usize] = []
    i = 0
    while i < degrees.len() {
        var d: usize = degrees[i]
        while d > 0 {
            stubs.push(i)
            d = d - 1
        }
        i = i + 1
    }

    // Random shuffle of stubs (simplified: sequential pairing)
    // Note: True configuration model requires random permutation
    // This simplified version pairs sequential stubs
    var pair_idx: usize = 0
    while pair_idx < stubs.len() - 1 {
        let u = stubs[pair_idx]
        let v = stubs[pair_idx + 1]

        // Add edge only if u != v (no self-loops) and not duplicate
        if u != v {
            let u_has_v = has_edge(&null_adj[u], v)
            let v_has_u = has_edge(&null_adj[v], u)

            if !u_has_v && !v_has_u {
                null_adj[u].push(v)
                null_adj[v].push(u)
            }
        }

        pair_idx = pair_idx + 2
    }

    null_adj
}

// =============================================================================
// Helper Functions
// =============================================================================

/// Check if value exists in array
fn has_edge(neighbors: &[usize], target: usize) -> bool {
    var i: usize = 0
    while i < neighbors.len() {
        if neighbors[i] == target {
            return true
        }
        i = i + 1
    }
    false
}

/// Count edges in adjacency list
pub fn count_edges(adj: &[[usize]]) -> usize {
    var edges: usize = 0
    var i: usize = 0
    while i < adj.len() {
        edges = edges + adj[i].len()
        i = i + 1
    }
    // Each edge counted twice (u->v and v->u)
    edges / 2
}

// =============================================================================
// Validation
// =============================================================================

/// Verify that null model preserves degree sequence
pub fn preserves_degree_sequence(original: &[[usize]], null_model: &[[usize]]) -> bool {
    let orig_degrees = get_degree_sequence(original)
    let null_degrees = get_degree_sequence(null_model)

    // Check each degree is preserved
    var i: usize = 0
    while i < orig_degrees.len() {
        if i >= null_degrees.len() {
            return false
        }
        if orig_degrees[i] != null_degrees[i] {
            return false
        }
        i = i + 1
    }

    true
}
