// stdlib/graph/nulls/configuration — Configuration Model Null Graphs
//
// Generates random graphs that preserve the degree sequence of the original graph.
// Used for statistical significance testing of graph properties.
//
// Two algorithms:
// - Stub-matching (accurate but slower): Match half-edges randomly
// - Edge-swap (faster): Rewire edges while preserving degrees
//
// Collections: adjacency lists and degree sequences are `Seq`, not `[T]`.
// A slice is fixed-length and answers only `.len()`; `.push` on one is
// rejected (E019). Seq is handle-based, so every Seq parameter here is taken
// BY VALUE -- a `&Seq<...>` parameter reads back garbage or segfaults
// (docs/handoff/BLK-20260904-seq-f64-element-scalar-kind.md, Residual).
// `Seq::len()` answers `Knowledge<i64>`, so lengths are read as
// `.len().unwrap(..)` into `i64` counters and cast at the index.
//
// References:
// - Molloy & Reed (1995): "A critical point for random graphs with a given degree sequence"
// - Milo et al. (2003): "Uniform generation of random graphs with arbitrary degree sequences"

module graph::nulls::configuration

extern "C" {
    fn sqrt(x: f64) -> f64;
}

// ============================================================================
// DATA STRUCTURES
// ============================================================================

// Result of configuration model generation
pub struct ConfigurationModel {
    pub adj: Seq<Seq<usize>>,       // Generated adjacency list
    pub degree_sequence: Seq<usize>, // Preserved degree sequence
    pub num_rewires: usize,          // Number of edge rewires attempted
    pub success: bool,               // Whether model generation succeeded
}

fn configuration_model_new() -> ConfigurationModel with Mut, Panic {
    var adj: Seq<Seq<usize>> = seq_new()
    var degs: Seq<usize> = seq_new()
    ConfigurationModel {
        adj: adj,
        degree_sequence: degs,
        num_rewires: 0,
        success: false,
    }
}

// Statistics from null model comparison
pub struct NullModelStats {
    pub mean_metric: f64,         // Mean metric value across null models
    pub std_metric: f64,          // Standard deviation
    pub observed_metric: f64,     // Observed metric in original graph
    pub z_score: f64,             // Z-score: (observed - mean) / std
}

fn null_model_stats_new() -> NullModelStats {
    NullModelStats {
        mean_metric: 0.0,
        std_metric: 0.0,
        observed_metric: 0.0,
        z_score: 0.0,
    }
}

// ============================================================================
// HELPER FUNCTIONS
// ============================================================================

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { -x } else { x }
}

fn abs_i64(x: i64) -> i64 {
    if x < 0 { -x } else { x }
}

fn min_usize(a: usize, b: usize) -> usize {
    if a < b { a } else { b }
}

fn max_usize(a: usize, b: usize) -> usize {
    if a > b { a } else { b }
}

// ----------------------------------------------------------------------------
// Row accessors. `adj.get(i)` hands back a handle that shares storage with the
// row, so a push into that handle is a push into the adjacency list; the
// slice spelling `adj[u].push(v)` is not available on a Seq of Seqs.
// ----------------------------------------------------------------------------

// Number of neighbours of node `i`.
fn row_len(adj: Seq<Seq<usize>>, i: usize) -> i64 with Mut, Panic, Epistemic {
    let row: Seq<usize> = adj.get(i)
    row.len().unwrap("row")
}

// The `j`-th neighbour of node `i`.
fn row_get(adj: Seq<Seq<usize>>, i: usize, j: usize) -> usize with Mut, Panic, Epistemic {
    let row: Seq<usize> = adj.get(i)
    row.get(j)
}

// Append `v` to the neighbour list of node `i`.
fn row_push(adj: Seq<Seq<usize>>, i: usize, v: usize) with Mut, Panic {
    var row: Seq<usize> = adj.get(i)
    row.push(v)
}

// Drop the first occurrence of `val` from the neighbour list of node `i`.
// Seq exposes new/push/get/set/len and no pop, so a removal is a rebuild of
// the row followed by a set. The pre-Seq version could not do this at all --
// it swapped the victim with the last element and left the row the same
// length, so "removing" an edge did not lower any degree.
fn row_remove(adj: Seq<Seq<usize>>, i: usize, val: usize) with Mut, Panic, Epistemic {
    let row: Seq<usize> = adj.get(i)
    let m: i64 = row.len().unwrap("row")
    var out: Seq<usize> = seq_new()
    var removed: bool = false
    var k: i64 = 0
    while k < m {
        let x = row.get(k as usize)
        if x == val && !removed {
            removed = true
        } else {
            out.push(x)
        }
        k = k + 1
    }
    adj.set(i, out)
}

// Extract degree sequence from adjacency list
pub fn extract_degree_sequence(adj: Seq<Seq<usize>>) -> Seq<usize> with Mut, Panic, Epistemic {
    var degrees: Seq<usize> = seq_new()
    let n: i64 = adj.len().unwrap("adj")
    var i: i64 = 0
    while i < n {
        degrees.push(row_len(adj, i as usize) as usize)
        i = i + 1
    }
    degrees
}

// Simple deterministic "random" number generator (for reproducibility)
fn pseudo_random(seed: &! u64) -> u64 with Mut, Div, Panic {
    *seed = (*seed * (1103515245 as u64) + (12345 as u64)) % (2147483648 as u64);
    *seed
}

fn pseudo_random_range(seed: &! u64, max: usize) -> usize with Mut, Div, Panic {
    if max == 0 { return 0 }
    ((pseudo_random(seed) % (max as u64)) as usize)
}

// Create empty adjacency list with n nodes
pub fn create_empty_adjacency(n: usize) -> Seq<Seq<usize>> with Mut, Panic {
    var adj: Seq<Seq<usize>> = seq_new()
    var i: usize = 0
    while i < n {
        var empty: Seq<usize> = seq_new()
        adj.push(empty)
        i = i + 1
    }
    adj
}

// Check if edge exists (for undirected graph, check both directions)
fn edge_exists(adj: Seq<Seq<usize>>, u: usize, v: usize) -> bool with Mut, Panic, Epistemic {
    let n: i64 = adj.len().unwrap("adj")
    if (u as i64) >= n || (v as i64) >= n { return false }

    // Check if v is in adj[u]
    let deg: i64 = row_len(adj, u)
    var i: i64 = 0
    while i < deg {
        if row_get(adj, u, i as usize) == v {
            return true
        }
        i = i + 1
    }
    false
}

// Add edge to undirected graph (add to both directions)
fn add_edge(adj: Seq<Seq<usize>>, u: usize, v: usize) -> bool with Mut, Panic, Epistemic {
    let n: i64 = adj.len().unwrap("adj")
    if (u as i64) >= n || (v as i64) >= n { return false }
    if u == v { return false }  // No self-loops
    if edge_exists(adj, u, v) { return false }  // No multi-edges

    row_push(adj, u, v)
    row_push(adj, v, u)
    true
}

// Remove edge from adjacency list (both directions)
fn remove_edge(adj: Seq<Seq<usize>>, u: usize, v: usize) with Mut, Panic, Epistemic {
    let n: i64 = adj.len().unwrap("adj")
    if (u as i64) >= n || (v as i64) >= n { return }

    row_remove(adj, u, v)
    row_remove(adj, v, u)
}

// ============================================================================
// CONFIGURATION MODEL - STUB MATCHING ALGORITHM
// ============================================================================

// Generate single configuration model graph using stub-matching
pub fn configuration_model(
    original_adj: Seq<Seq<usize>>,
    seed: u64,
    max_attempts: usize
) -> ConfigurationModel with Mut, Div, Panic, Epistemic {
    let n: i64 = original_adj.len().unwrap("original_adj")
    if n == 0 { return configuration_model_new() }

    // Extract degree sequence -- preserved on every exit, success or not
    var degs: Seq<usize> = extract_degree_sequence(original_adj)

    // Check if degree sequence is valid (total even)
    var total_degree: i64 = 0
    var i: i64 = 0
    while i < n {
        total_degree = total_degree + (degs.get(i as usize) as i64)
        i = i + 1
    }

    if total_degree % 2 != 0 {
        // Invalid: odd total degree
        var odd_adj: Seq<Seq<usize>> = seq_new()
        return ConfigurationModel {
            adj: odd_adj,
            degree_sequence: degs,
            num_rewires: 0,
            success: false,
        }
    }

    // Attempt stub matching
    var attempt: usize = 0
    var rand_seed = seed

    while attempt < max_attempts {
        // Create empty adjacency list
        var adj: Seq<Seq<usize>> = create_empty_adjacency(n as usize)

        // Create stubs (half-edges)
        var stubs: Seq<usize> = seq_new()
        i = 0
        while i < n {
            let deg: i64 = degs.get(i as usize) as i64
            var j: i64 = 0
            while j < deg {
                stubs.push(i as usize)
                j = j + 1
            }
            i = i + 1
        }

        // Shuffle stubs deterministically
        let num_stubs: i64 = stubs.len().unwrap("stubs")
        var k: i64 = 0
        while k < num_stubs {
            let swap_idx = pseudo_random_range(&! rand_seed, num_stubs as usize)
            let temp = stubs.get(k as usize)
            stubs.set(k as usize, stubs.get(swap_idx))
            stubs.set(swap_idx, temp)
            k = k + 1
        }

        // Pair up stubs to form edges
        var success: bool = true
        i = 0
        while i + 1 < num_stubs {
            let u = stubs.get(i as usize)
            let v = stubs.get((i + 1) as usize)

            let no_self_loop = u != v
            let no_dup = if no_self_loop { !edge_exists(adj, u, v) } else { false }
            if no_self_loop && no_dup {
                add_edge(adj, u, v)
            } else {
                success = false
                break
            }

            i = i + 2
        }

        if success {
            return ConfigurationModel {
                adj: adj,
                degree_sequence: degs,
                num_rewires: 0,
                success: true,
            }
        }

        attempt = attempt + 1
    }

    var failed_adj: Seq<Seq<usize>> = seq_new()
    ConfigurationModel {
        adj: failed_adj,
        degree_sequence: degs,
        num_rewires: 0,
        success: false,
    }
}

// ============================================================================
// CONFIGURATION MODEL - EDGE SWAP ALGORITHM
// ============================================================================

// Generate configuration model using edge-swap (faster for dense graphs)
pub fn edge_swap_configuration(
    original_adj: Seq<Seq<usize>>,
    num_swaps: usize,
    seed: u64
) -> Seq<Seq<usize>> with Mut, Div, Panic, Epistemic {
    let n: i64 = original_adj.len().unwrap("original_adj")

    // Start with copy of original graph
    var adj: Seq<Seq<usize>> = create_empty_adjacency(n as usize)
    var i: i64 = 0
    while i < n {
        let deg: i64 = row_len(original_adj, i as usize)
        var j: i64 = 0
        while j < deg {
            let w = row_get(original_adj, i as usize, j as usize)
            if (i as usize) < w {  // Avoid adding twice
                add_edge(adj, i as usize, w)
            }
            j = j + 1
        }
        i = i + 1
    }

    // Perform edge swaps
    var rand_seed = seed
    var swap_count: usize = 0

    while swap_count < num_swaps {
        // Select two random edges
        let u1 = pseudo_random_range(&! rand_seed, n as usize)
        let u1_neighbors_len: i64 = row_len(adj, u1)
        if u1_neighbors_len == 0 {
            swap_count = swap_count + 1
            continue
        }

        let v1_idx = pseudo_random_range(&! rand_seed, u1_neighbors_len as usize)
        let v1 = row_get(adj, u1, v1_idx)

        let u2 = pseudo_random_range(&! rand_seed, n as usize)
        let u2_neighbors_len: i64 = row_len(adj, u2)
        if u2_neighbors_len == 0 {
            swap_count = swap_count + 1
            continue
        }

        let v2_idx = pseudo_random_range(&! rand_seed, u2_neighbors_len as usize)
        let v2 = row_get(adj, u2, v2_idx)

        // Check if swap would be valid:
        // - No self-loops: u1 != v2 and u2 != v1
        // - No duplicate edges: (u1,v2) and (u2,v1) don't exist
        // These four guards also rule out the degenerate picks (same edge
        // twice, shared endpoint), so an accepted swap always removes two
        // distinct edges and adds two: degrees are preserved exactly.
        let no_cross1 = !edge_exists(adj, u1, v2)
        let no_cross2 = !edge_exists(adj, u2, v1)
        if u1 != v2 && u2 != v1 && no_cross1 && no_cross2 {
            // Remove old edges
            remove_edge(adj, u1, v1)
            remove_edge(adj, u2, v2)

            // Add new edges
            add_edge(adj, u1, v2)
            add_edge(adj, u2, v1)
        }

        swap_count = swap_count + 1
    }

    adj
}

// ============================================================================
// ENSEMBLE GENERATION
// ============================================================================

// Generate ensemble of null models
pub fn configuration_ensemble(
    original_adj: Seq<Seq<usize>>,
    num_graphs: usize,
    seed: u64
) -> Seq<ConfigurationModel> with Mut, Div, Panic, Epistemic {
    var ensemble: Seq<ConfigurationModel> = seq_new()

    var i: usize = 0
    while i < num_graphs {
        let model = configuration_model(original_adj, seed + (i as u64), 100)
        ensemble.push(model)
        i = i + 1
    }

    ensemble
}

// ============================================================================
// VERIFICATION
// ============================================================================

// Verify that generated graph preserves degree sequence
pub fn verify_degree_sequence(
    original: Seq<Seq<usize>>,
    generated: Seq<Seq<usize>>
) -> bool with Mut, Panic, Epistemic {
    let n: i64 = original.len().unwrap("original")
    let m: i64 = generated.len().unwrap("generated")
    if n != m { return false }

    var i: i64 = 0
    while i < n {
        if row_len(original, i as usize) != row_len(generated, i as usize) {
            return false
        }
        i = i + 1
    }

    true
}

// ============================================================================
// NULL MODEL STATISTICS
// ============================================================================

// Compute statistics for null model comparison
pub fn null_model_significance(
    observed: f64,
    null_values: &[f64]
) -> NullModelStats with Mut, Div, Panic {
    var stats = null_model_stats_new()

    if null_values.len() == 0 {
        return stats
    }

    // Compute mean
    var sum = 0.0
    var i: usize = 0
    while i < null_values.len() {
        sum = sum + null_values[i]
        i = i + 1
    }
    stats.mean_metric = sum / (null_values.len() as f64)

    // Compute standard deviation
    var sum_sq_dev = 0.0
    i = 0
    while i < null_values.len() {
        let dev = null_values[i] - stats.mean_metric
        sum_sq_dev = sum_sq_dev + dev * dev
        i = i + 1
    }

    let variance = sum_sq_dev / (null_values.len() as f64)
    stats.std_metric = sqrt(variance)

    stats.observed_metric = observed

    // Compute z-score
    if abs_f64(stats.std_metric) > 1e-10 {
        stats.z_score = (observed - stats.mean_metric) / stats.std_metric
    }

    stats
}

// ============================================================================
// TESTS
// ============================================================================

// Fixture: the 4-node graph 0-1, 0-2, 1-2, 1-3. A nested array literal
// (`[[1,2],[0]]`) compiles to an empty stub that traps at runtime, so rows are
// grown instead.
fn fixture_four() -> Seq<Seq<usize>> with Mut, Panic {
    var adj: Seq<Seq<usize>> = create_empty_adjacency(4)
    row_push(adj, 0, 1); row_push(adj, 0, 2)
    row_push(adj, 1, 0); row_push(adj, 1, 2); row_push(adj, 1, 3)
    row_push(adj, 2, 0); row_push(adj, 2, 1)
    row_push(adj, 3, 1)
    adj
}

// Fixture: the path 0-1-2.
fn fixture_path3() -> Seq<Seq<usize>> with Mut, Panic {
    var adj: Seq<Seq<usize>> = create_empty_adjacency(3)
    row_push(adj, 0, 1)
    row_push(adj, 1, 0); row_push(adj, 1, 2)
    row_push(adj, 2, 1)
    adj
}

// Test: Configuration model preserves degree sequence
pub fn test_degree_preservation() -> bool with Mut, Div, Panic, Epistemic {
    var original: Seq<Seq<usize>> = fixture_four()

    let model = configuration_model(original, 42, 100)

    if !model.success {
        return false
    }

    var generated: Seq<Seq<usize>> = model.adj
    verify_degree_sequence(original, generated)
}

// Test: No self-loops in generated graph
pub fn test_no_self_loops() -> bool with Mut, Div, Panic, Epistemic {
    var original: Seq<Seq<usize>> = fixture_path3()

    // Stub matching abandons an attempt as soon as a pair collides, so some
    // seeds exhaust all 100 attempts on a graph this small (seed 42 is one of
    // them). Take the first seed that produces a graph: a generation failure
    // is not a self-loop, and the old fixed-seed spelling reported it as one.
    var found: bool = false
    var generated: Seq<Seq<usize>> = seq_new()
    var seed: u64 = 1
    while seed <= 32 && !found {
        let model = configuration_model(original, seed, 100)
        if model.success {
            generated = model.adj
            found = true
        }
        seed = seed + 1
    }
    if !found {
        return false
    }

    // Check for self-loops
    let n: i64 = generated.len().unwrap("generated")
    var i: i64 = 0
    while i < n {
        let deg: i64 = row_len(generated, i as usize)
        var j: i64 = 0
        while j < deg {
            if row_get(generated, i as usize, j as usize) == (i as usize) {
                return false  // Found self-loop
            }
            j = j + 1
        }
        i = i + 1
    }

    true
}

// Test: Edge swap preserves degrees
pub fn test_edge_swap_preserves_degrees() -> bool with Mut, Div, Panic, Epistemic {
    var original: Seq<Seq<usize>> = fixture_path3()

    var swapped: Seq<Seq<usize>> = edge_swap_configuration(original, 10, 42)

    verify_degree_sequence(original, swapped)
}

// Master test function
pub fn run_configuration_tests() -> bool with Mut, Div, Panic, Epistemic {
    test_degree_preservation() &&
    test_no_self_loops() &&
    test_edge_swap_preserves_degrees()
}
