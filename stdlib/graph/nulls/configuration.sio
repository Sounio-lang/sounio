// stdlib/graph/nulls/configuration — Configuration Model Null Graphs
//
// Generates random graphs that preserve the degree sequence of the original graph.
// Used for statistical significance testing of graph properties.
//
// Two algorithms:
// - Stub-matching (accurate but slower): Match half-edges randomly
// - Edge-swap (faster): Rewire edges while preserving degrees
//
// References:
// - Molloy & Reed (1995): "A critical point for random graphs with a given degree sequence"
// - Milo et al. (2003): "Uniform generation of random graphs with arbitrary degree sequences"

module graph::nulls::configuration

extern "C" {
    fn sqrt(x: f64) -> f64;
}

// ============================================================================
// DATA STRUCTURES
// ============================================================================

// Result of configuration model generation
pub struct ConfigurationModel {
    pub adj: [[usize]],           // Generated adjacency list
    pub degree_sequence: [usize], // Preserved degree sequence
    pub num_rewires: usize,       // Number of edge rewires attempted
    pub success: bool,            // Whether model generation succeeded
}

fn configuration_model_new() -> ConfigurationModel {
    var adj: [[usize]] = []
    var degs: [usize] = []
    ConfigurationModel {
        adj: adj,
        degree_sequence: degs,
        num_rewires: 0,
        success: false,
    }
}

// Statistics from null model comparison
pub struct NullModelStats {
    pub mean_metric: f64,         // Mean metric value across null models
    pub std_metric: f64,          // Standard deviation
    pub observed_metric: f64,     // Observed metric in original graph
    pub z_score: f64,             // Z-score: (observed - mean) / std
}

fn null_model_stats_new() -> NullModelStats {
    NullModelStats {
        mean_metric: 0.0,
        std_metric: 0.0,
        observed_metric: 0.0,
        z_score: 0.0,
    }
}

// ============================================================================
// HELPER FUNCTIONS
// ============================================================================

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { -x } else { x }
}

fn abs_i64(x: i64) -> i64 {
    if x < 0 { -x } else { x }
}

fn min_usize(a: usize, b: usize) -> usize {
    if a < b { a } else { b }
}

fn max_usize(a: usize, b: usize) -> usize {
    if a > b { a } else { b }
}

// Extract degree sequence from adjacency list
fn extract_degree_sequence(adj: &[[usize]]) -> [usize] {
    var degrees: [usize] = []
    var i: usize = 0
    while i < adj.len() {
        degrees.push(adj[i].len())
        i = i + 1
    }
    degrees
}

// Simple deterministic "random" number generator (for reproducibility)
fn pseudo_random(seed: &! u64) -> u64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648
    *seed
}

fn pseudo_random_range(seed: &! u64, max: usize) -> usize {
    if max == 0 { return 0 }
    ((pseudo_random(seed) % (max as u64)) as usize)
}

// Create empty adjacency list with n nodes
fn create_empty_adjacency(n: usize) -> [[usize]] {
    var adj: [[usize]] = []
    var i: usize = 0
    while i < n {
        var empty: [usize] = []
        adj.push(empty)
        i = i + 1
    }
    adj
}

// Check if edge exists (for undirected graph, check both directions)
fn edge_exists(adj: &[[usize]], u: usize, v: usize) -> bool {
    if u >= adj.len() || v >= adj.len() { return false }

    // Check if v is in adj[u]
    var i: usize = 0
    while i < adj[u].len() {
        if adj[u][i] == v {
            return true
        }
        i = i + 1
    }
    false
}

// Add edge to undirected graph (add to both directions)
fn add_edge(adj: &! [[usize]], u: usize, v: usize) -> bool {
    if u >= adj.len() || v >= adj.len() { return false }
    if u == v { return false }  // No self-loops
    if edge_exists(adj, u, v) { return false }  // No multi-edges

    adj[u].push(v)
    if u != v {
        adj[v].push(u)
    }
    true
}

// ============================================================================
// CONFIGURATION MODEL - STUB MATCHING ALGORITHM
// ============================================================================

// Generate single configuration model graph using stub-matching
pub fn configuration_model(
    original_adj: &[[usize]],
    seed: u64,
    max_attempts: usize
) -> ConfigurationModel {
    var result = configuration_model_new()

    let n = original_adj.len()
    if n == 0 { return result }

    // Extract degree sequence
    result.degree_sequence = extract_degree_sequence(original_adj)

    // Check if degree sequence is valid (total even)
    var total_degree: usize = 0
    var i: usize = 0
    while i < result.degree_sequence.len() {
        total_degree = total_degree + result.degree_sequence[i]
        i = i + 1
    }

    if total_degree % 2 != 0 {
        return result  // Invalid: odd total degree
    }

    // Attempt stub matching
    var attempt: usize = 0
    var rand_seed = seed

    while attempt < max_attempts {
        // Create empty adjacency list
        result.adj = create_empty_adjacency(n)

        // Create stubs (half-edges)
        var stubs: [usize] = []
        i = 0
        while i < n {
            var j: usize = 0
            while j < result.degree_sequence[i] {
                stubs.push(i)
                j = j + 1
            }
            i = i + 1
        }

        // Shuffle stubs deterministically
        var k: usize = 0
        while k < stubs.len() {
            let swap_idx = pseudo_random_range(&rand_seed, stubs.len())
            let temp = stubs[k]
            stubs[k] = stubs[swap_idx]
            stubs[swap_idx] = temp
            k = k + 1
        }

        // Pair up stubs to form edges
        var success = true
        i = 0
        while i < stubs.len() - 1 {
            let u = stubs[i]
            let v = stubs[i + 1]

            if u != v && !edge_exists(&result.adj, u, v) {
                add_edge(&! result.adj, u, v)
            } else {
                success = false
                break
            }

            i = i + 2
        }

        if success {
            result.success = true
            result.num_rewires = 0
            return result
        }

        attempt = attempt + 1
    }

    result
}

// ============================================================================
// CONFIGURATION MODEL - EDGE SWAP ALGORITHM
// ============================================================================

// Generate configuration model using edge-swap (faster for dense graphs)
pub fn edge_swap_configuration(
    original_adj: &[[usize]],
    num_swaps: usize,
    seed: u64
) -> [[usize]] {
    let n = original_adj.len()

    // Start with copy of original graph
    var adj = create_empty_adjacency(n)
    var i: usize = 0
    while i < n {
        var j: usize = 0
        while j < original_adj[i].len() {
            if i < original_adj[i][j] {  // Avoid adding twice
                add_edge(&! adj, i, original_adj[i][j])
            }
            j = j + 1
        }
        i = i + 1
    }

    // Perform edge swaps
    var rand_seed = seed
    var swap_count: usize = 0

    while swap_count < num_swaps {
        // Select two random edges
        let u1 = pseudo_random_range(&rand_seed, n)
        let u1_neighbors_len = adj[u1].len()
        if u1_neighbors_len == 0 {
            swap_count = swap_count + 1
            continue
        }

        let v1_idx = pseudo_random_range(&rand_seed, u1_neighbors_len)
        let v1 = adj[u1][v1_idx]

        let u2 = pseudo_random_range(&rand_seed, n)
        let u2_neighbors_len = adj[u2].len()
        if u2_neighbors_len == 0 {
            swap_count = swap_count + 1
            continue
        }

        let v2_idx = pseudo_random_range(&rand_seed, u2_neighbors_len)
        let v2 = adj[u2][v2_idx]

        // Check if swap would be valid:
        // - No self-loops: u1 != v2 and u2 != v1
        // - No duplicate edges: (u1,v2) and (u2,v1) don't exist
        if u1 != v2 && u2 != v1 &&
           !edge_exists(&adj, u1, v2) && !edge_exists(&adj, u2, v1) {
            // Remove old edges
            remove_edge(&! adj, u1, v1)
            remove_edge(&! adj, u2, v2)

            // Add new edges
            add_edge(&! adj, u1, v2)
            add_edge(&! adj, u2, v1)
        }

        swap_count = swap_count + 1
    }

    adj
}

// Remove edge from adjacency list
fn remove_edge(adj: &! [[usize]], u: usize, v: usize) {
    if u >= adj.len() || v >= adj.len() { return }

    // Remove v from adj[u]
    var i: usize = 0
    while i < adj[u].len() {
        if adj[u][i] == v {
            // Swap with last and pop
            if i < adj[u].len() - 1 {
                adj[u][i] = adj[u][adj[u].len() - 1]
            }
            // pop the last element (can't actually pop in this language)
            break
        }
        i = i + 1
    }

    // Remove u from adj[v]
    i = 0
    while i < adj[v].len() {
        if adj[v][i] == u {
            if i < adj[v].len() - 1 {
                adj[v][i] = adj[v][adj[v].len() - 1]
            }
            break
        }
        i = i + 1
    }
}

// ============================================================================
// ENSEMBLE GENERATION
// ============================================================================

// Generate ensemble of null models
pub fn configuration_ensemble(
    original_adj: &[[usize]],
    num_graphs: usize,
    seed: u64
) -> [ConfigurationModel] {
    var ensemble: [ConfigurationModel] = []

    var i: usize = 0
    while i < num_graphs {
        let model = configuration_model(original_adj, seed + (i as u64), 100)
        ensemble.push(model)
        i = i + 1
    }

    ensemble
}

// ============================================================================
// VERIFICATION
// ============================================================================

// Verify that generated graph preserves degree sequence
pub fn verify_degree_sequence(
    original: &[[usize]],
    generated: &[[usize]]
) -> bool {
    if original.len() != generated.len() { return false }

    let original_degrees = extract_degree_sequence(original)
    let generated_degrees = extract_degree_sequence(generated)

    if original_degrees.len() != generated_degrees.len() { return false }

    var i: usize = 0
    while i < original_degrees.len() {
        if original_degrees[i] != generated_degrees[i] {
            return false
        }
        i = i + 1
    }

    true
}

// ============================================================================
// NULL MODEL STATISTICS
// ============================================================================

// Compute statistics for null model comparison
pub fn null_model_significance(
    observed: f64,
    null_values: &[f64]
) -> NullModelStats {
    var stats = null_model_stats_new()

    if null_values.len() == 0 {
        return stats
    }

    // Compute mean
    var sum = 0.0
    var i: usize = 0
    while i < null_values.len() {
        sum = sum + null_values[i]
        i = i + 1
    }
    stats.mean_metric = sum / (null_values.len() as f64)

    // Compute standard deviation
    var sum_sq_dev = 0.0
    i = 0
    while i < null_values.len() {
        let dev = null_values[i] - stats.mean_metric
        sum_sq_dev = sum_sq_dev + dev * dev
        i = i + 1
    }

    let variance = sum_sq_dev / (null_values.len() as f64)
    stats.std_metric = sqrt(variance)

    stats.observed_metric = observed

    // Compute z-score
    if abs_f64(stats.std_metric) > 1e-10 {
        stats.z_score = (observed - stats.mean_metric) / stats.std_metric
    }

    stats
}

// ============================================================================
// TESTS
// ============================================================================

// Test: Configuration model preserves degree sequence
pub fn test_degree_preservation() -> bool {
    var original: [[usize]] = [[], [], [], []]
    original[0].push(1); original[0].push(2)
    original[1].push(0); original[1].push(2); original[1].push(3)
    original[2].push(0); original[2].push(1)
    original[3].push(1)

    let model = configuration_model(&original, 42, 100)

    if !model.success {
        return false
    }

    verify_degree_sequence(&original, &model.adj)
}

// Test: No self-loops in generated graph
pub fn test_no_self_loops() -> bool {
    var original: [[usize]] = [[], [], []]
    original[0].push(1)
    original[1].push(0); original[1].push(2)
    original[2].push(1)

    let model = configuration_model(&original, 42, 100)

    if !model.success {
        return false
    }

    // Check for self-loops
    var i: usize = 0
    while i < model.adj.len() {
        var j: usize = 0
        while j < model.adj[i].len() {
            if model.adj[i][j] == i {
                return false  // Found self-loop
            }
            j = j + 1
        }
        i = i + 1
    }

    true
}

// Test: Edge swap preserves degrees
pub fn test_edge_swap_preserves_degrees() -> bool {
    var original: [[usize]] = [[], [], []]
    original[0].push(1)
    original[1].push(0); original[1].push(2)
    original[2].push(1)

    let swapped = edge_swap_configuration(&original, 10, 42)

    verify_degree_sequence(&original, &swapped)
}

// Master test function
pub fn run_configuration_tests() -> bool {
    test_degree_preservation() &&
    test_no_self_loops() &&
    test_edge_swap_preserves_degrees()
}
