// stdlib/privacy/differential.sio — Differential Privacy mechanisms and budget accounting
//
// Implements canonical DP mechanisms from Dwork et al. 2006 and Dwork, Rothblum, Vadhan 2010.
// All mechanisms are calibrated to their stated ε (and δ for approximate DP).
//
// CODATA 2022 / NIST SP 800-188 alignment:
//   ε-DP (pure DP): Laplace mechanism, Randomized Response
//   (ε, δ)-DP (approximate DP): Gaussian mechanism
//   Advanced composition: sqrt(2k * ln(1/δ)) * ε bound
//
// Sounio Sprint 21 DP track — first PL with ε as a type-level graded quantity.
// Paper target: POPL 2026 / CCS 2027
//   "Graded Differential Privacy: ε-Budget as a Compile-Time Algebraic Effect in Sounio"

// ============================================================
// Sensitivity computation helpers
// ============================================================

// l1-sensitivity of a counting query: Δf = 1 (adding/removing one record changes count by 1)
fn counting_query_sensitivity() -> f64 with IO {
    1.0
}

// l1-sensitivity of a sum query on bounded domain [lo, hi]: Δf = hi - lo
fn sum_query_sensitivity(lo: f64, hi: f64) -> f64 with IO, Div, Panic {
    hi + (0.0 - lo)
}

// l1-sensitivity of a mean query on bounded domain, n records: Δf = (hi - lo) / n
fn mean_query_sensitivity(lo: f64, hi: f64, n: i64) -> f64 with IO, Div, Panic {
    let range = hi + (0.0 - lo)
    let n_f: f64 = n as f64
    range / n_f
}

// ============================================================
// Laplace mechanism (pure ε-DP)
// ============================================================
// Theorem (Dwork 2006, Proposition 3.5): Adding Lap(Δf/ε) noise achieves ε-DP.
// Scale parameter b = Δf / ε.

fn laplace_scale(sensitivity: f64, epsilon: f64) -> f64 with IO, Div, Panic {
    sensitivity / epsilon
}

// Variance of Laplace mechanism output: Var[Lap(b)] = 2b²
fn laplace_variance(sensitivity: f64, epsilon: f64) -> f64 with IO, Div, Panic {
    let b = laplace_scale(sensitivity, epsilon)
    2.0 * b * b
}

// Mean squared error of Laplace mechanism: E[(M(D) - f(D))²] = 2(Δf/ε)²
fn laplace_mse(sensitivity: f64, epsilon: f64) -> f64 with IO, Div, Panic {
    laplace_variance(sensitivity, epsilon)
}

// ============================================================
// Gaussian mechanism (approximate (ε, δ)-DP)
// ============================================================
// Theorem (Dwork 2006, Proposition 3.6):
//   σ ≥ sqrt(2 * ln(1.25/δ)) * Δf / ε achieves (ε, δ)-DP.
// For δ = 0.01: sqrt(2 * ln(1.25/0.01)) = sqrt(2 * 4.828) ≈ 3.105

fn gaussian_sigma(sensitivity: f64, epsilon: f64, delta: f64) -> f64 with IO, Div, Panic {
    // Compute ln(1.25/δ) via identity: ln(1.25/δ) = ln(1.25) - ln(δ)
    // Approximate: for δ = 0.01, ln(1.25/δ) ≈ 4.828; for δ = 0.001, ≈ 7.13
    // We use a linear approximation around common δ values (for bootstrap purposes)
    // Full implementation would use stdlib/math/log.sio when available
    let log_inv_delta_approx: f64 = if delta > 0.05 {
        3.0  // δ ≈ 0.1: ln(12.5) ≈ 2.53, rounded up
    } else if delta > 0.005 {
        4.828  // δ ≈ 0.01 (common choice)
    } else if delta > 0.0005 {
        7.13   // δ ≈ 0.001
    } else {
        9.43   // δ ≈ 0.0001
    }
    let factor_sq = 2.0 * log_inv_delta_approx
    // Approximate sqrt via Newton (2 iterations from factor_sq/2)
    let x0 = factor_sq / 2.0
    let x1 = (x0 + factor_sq / x0) / 2.0
    let sqrt_factor = (x1 + factor_sq / x1) / 2.0
    sqrt_factor * sensitivity / epsilon
}

// Variance of Gaussian mechanism output: Var = σ²
fn gaussian_variance(sensitivity: f64, epsilon: f64, delta: f64) -> f64 with IO, Div, Panic {
    let sigma = gaussian_sigma(sensitivity, epsilon, delta)
    sigma * sigma
}

// ============================================================
// Composition theorems
// ============================================================

// Sequential composition: k mechanisms each εᵢ-DP → Σεᵢ-DP overall
// (Theorem 3.14, Dwork 2006)
fn dp_sequential_epsilon(eps_list: [f64; 8], count: i64) -> f64 with IO, Div, Mut, Panic {
    var total: f64 = 0.0
    var i: i64 = 0
    while i < count && i < 8 {
        total = total + eps_list[i as usize]
        i = i + 1
    }
    total
}

// Parallel composition: disjoint datasets → max(εᵢ)-DP overall
// (Theorem 3.20, Dwork 2006)
fn dp_parallel_epsilon(eps_list: [f64; 8], count: i64) -> f64 with IO, Div, Mut, Panic {
    var max_eps: f64 = 0.0
    var i: i64 = 0
    while i < count && i < 8 {
        let ei = eps_list[i as usize]
        max_eps = if ei > max_eps { ei } else { max_eps }
        i = i + 1
    }
    max_eps
}

// Advanced composition (Dwork, Rothblum, Vadhan 2010):
// k mechanisms each ε-DP → (ε', δ')-DP where
//   ε' = sqrt(2k * ln(1/δ')) * ε + k * ε * (exp(ε) - 1)
// Simple approximation for small ε (ε ≤ 1): ε' ≈ ε * sqrt(2k * ln(1/δ'))
fn dp_advanced_composition(epsilon: f64, k_queries: i64, delta: f64) -> f64 with IO, Div, Panic {
    let k_f: f64 = k_queries as f64
    // ln(1/δ) approximation (same as gaussian_sigma above)
    let log_inv_delta: f64 = if delta > 0.05 {
        3.0
    } else if delta > 0.005 {
        4.605  // ln(100) ≈ 4.605 for δ=0.01
    } else if delta > 0.0005 {
        6.908  // ln(1000) ≈ 6.908 for δ=0.001
    } else {
        9.21   // ln(10000) ≈ 9.21 for δ=0.0001
    }
    let under_sqrt = 2.0 * k_f * log_inv_delta
    // Newton sqrt (2 iterations)
    let x0 = under_sqrt / 2.0
    let x1 = (x0 + under_sqrt / x0) / 2.0
    let sqrt_factor = (x1 + under_sqrt / x1) / 2.0
    epsilon * sqrt_factor
}

// ============================================================
// Randomized response (local DP)
// ============================================================
// Warner 1965 / Dwork 2006: For binary response, answer truthfully with prob p = exp(ε)/(1+exp(ε))
// Achieves ε-LDP (local differential privacy).
// Privacy parameter: p (probability of truthful response)
fn randomized_response_p(epsilon: f64) -> f64 with IO, Div, Panic {
    // p = exp(ε) / (1 + exp(ε)) = 1 / (1 + exp(-ε))
    // Approximate exp(ε) for ε ∈ [0,1]: exp(ε) ≈ 1 + ε + ε²/2 + ε³/6
    let e2 = epsilon * epsilon
    let e3 = e2 * epsilon
    let exp_eps = 1.0 + epsilon + e2 / 2.0 + e3 / 6.0
    exp_eps / (1.0 + exp_eps)
}

// ============================================================
// Budget tracking
// ============================================================

// DPBudgetTracker: accumulates ε spent across multiple queries
struct DPBudgetTracker {
    epsilon_total: f64,
    epsilon_spent: f64,
    query_count: i64,
}

fn dp_budget_new(epsilon_total: f64) -> DPBudgetTracker {
    DPBudgetTracker {
        epsilon_total: epsilon_total,
        epsilon_spent: 0.0,
        query_count: 0,
    }
}

fn dp_budget_remaining_f64(tracker: DPBudgetTracker) -> f64 with IO {
    tracker.epsilon_total + (0.0 - tracker.epsilon_spent)
}

fn dp_budget_is_exhausted(tracker: DPBudgetTracker) -> bool with IO {
    tracker.epsilon_spent > tracker.epsilon_total
}

// ============================================================
// Public structs for complete DP API
// ============================================================

// DPConfig — configuration for a DP mechanism
struct DPConfig {
    epsilon: f64,        // privacy budget ε
    delta: f64,          // approximate DP parameter δ (0 for pure DP)
    sensitivity: f64,    // query sensitivity Δf
    mechanism: i32,      // 0=Laplace, 1=Gaussian, 2=Exponential
}

// DPResult — result of a differentially private query
struct DPResult {
    noisy_value: f64,
    true_value: f64,
    noise_added: f64,
    epsilon_spent: f64,
    remaining_budget: f64,
}

// PrivacyAccountant — tracks cumulative ε-spending across queries
struct PrivacyAccountant {
    total_epsilon: f64,
    spent_epsilon: f64,
    n_queries: i32,
    max_queries: i32,
}

// ============================================================
// DPConfig constructors
// ============================================================

fn dp_config_laplace(epsilon: f64, sensitivity: f64) -> DPConfig {
    DPConfig {
        epsilon: epsilon,
        delta: 0.0,
        sensitivity: sensitivity,
        mechanism: 0,
    }
}

fn dp_config_gaussian(epsilon: f64, delta: f64, sensitivity: f64) -> DPConfig {
    DPConfig {
        epsilon: epsilon,
        delta: delta,
        sensitivity: sensitivity,
        mechanism: 1,
    }
}

// ============================================================
// Noise generation via inverse CDF (deterministic for given seed)
// ============================================================

// Laplace inverse CDF: F⁻¹(u) = -b * sign(u - 0.5) * ln(1 - 2|u - 0.5|)
// where b = sensitivity / ε and u = pseudo-random from seed.
// Uses a simple multiplicative LCG to derive u ∈ (0,1) from seed.
fn dp_laplace_noise_helper_u(seed: i64) -> f64 with Div, Panic {
    // LCG: x_{n+1} = (a*x + c) mod m
    let a: i64 = 6364136223846793005
    let c: i64 = 1442695040888963407
    let mixed = a * seed + c
    // Map to (0,1) — avoid exact 0 or 1 for log stability
    let raw: f64 = mixed as f64
    let scaled = raw / 9223372036854775807.0
    let u = if scaled < 0.0 { 0.0 - scaled } else { scaled }
    // Clamp to (0.001, 0.999) to avoid log(0)
    if u < 0.001 { return 0.001 }
    if u > 0.999 { return 0.999 }
    u
}

// Natural log approximation (sufficient for Laplace noise)
fn dp_ln_approx(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 - 999999.0 }
    if x == 1.0 { return 0.0 }
    // Use identity: ln(x) = 2 * arctanh((x-1)/(x+1))
    let y = (x - 1.0) / (x + 1.0)
    var result = 0.0
    var term = y
    var i = 1
    while i < 30 {
        let i_f: f64 = i as f64
        result = result + term / i_f
        term = term * y * y
        i = i + 2
    }
    2.0 * result
}

// dp_laplace_noise: samples from Laplace(0, sensitivity/ε) via inverse CDF
// Ref: Dwork 2006, Proposition 3.5
fn dp_laplace_noise(config: DPConfig, seed: i64) -> f64 with Mut, Div, Panic {
    let b = config.sensitivity / config.epsilon
    let u = dp_laplace_noise_helper_u(seed)
    let centered = u - 0.5
    let sign = if centered < 0.0 { 0.0 - 1.0 } else { 1.0 }
    let abs_centered = if centered < 0.0 { 0.0 - centered } else { centered }
    let arg = 1.0 - 2.0 * abs_centered
    // Clamp arg to avoid log(0)
    let arg_safe = if arg < 0.0001 { 0.0001 } else { arg }
    0.0 - sign * b * dp_ln_approx(arg_safe)
}

// Sqrt via Newton's method (3 iterations)
fn dp_sqrt(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x / 2.0
    var i = 0
    while i < 10 {
        y = (y + x / y) / 2.0
        i = i + 1
    }
    y
}

// dp_gaussian_noise: samples from N(0, σ²) via polar Box-Muller (no trig needed).
// σ = sensitivity * sqrt(2 * ln(1.25/δ)) / ε
// Ref: Dwork 2006, Proposition 3.6; Marsaglia & Bray 1964 (polar method)
//
// Polar method:
//   u1, u2 ~ Uniform(0,1); v1 = 2u1-1, v2 = 2u2-1
//   s = v1² + v2²; if s < 1 then Z = v1 * sqrt(-2*ln(s)/s) ~ N(0,1)
//   The polar form avoids cos/sin entirely.
fn dp_gaussian_noise(config: DPConfig, seed: i64) -> f64 with IO, Mut, Div, Panic {
    let sigma = gaussian_sigma(config.sensitivity, config.epsilon, config.delta)
    let u1 = dp_laplace_noise_helper_u(seed)
    let u2 = dp_laplace_noise_helper_u(seed + 1)
    // Map to [-1, 1]
    let v1 = 2.0 * u1 - 1.0
    let v2 = 2.0 * u2 - 1.0
    let s = v1 * v1 + v2 * v2
    // If s >= 1, it falls outside the unit circle; clamp to 0.99 to avoid rejection
    let s_safe = if s >= 1.0 { 0.99 } else if s < 0.000001 { 0.000001 } else { s }
    // Z = v1 * sqrt(-2 * ln(s) / s)
    let log_s = dp_ln_approx(s_safe)
    let factor = dp_sqrt(0.0 - 2.0 * log_s / s_safe)
    v1 * factor * sigma
}

// ============================================================
// dp_query — apply noise to a true value
// ============================================================

fn dp_query(config: DPConfig, true_value: f64, seed: i64) -> DPResult with IO, Mut, Div, Panic {
    let noise = if config.mechanism == 0 {
        dp_laplace_noise(config, seed)
    } else {
        dp_gaussian_noise(config, seed)
    }
    DPResult {
        noisy_value: true_value + noise,
        true_value: true_value,
        noise_added: noise,
        epsilon_spent: config.epsilon,
        remaining_budget: 0.0,  // updated by accountant
    }
}

// ============================================================
// PrivacyAccountant
// ============================================================

fn accountant_new(total_epsilon: f64, max_queries: i32) -> PrivacyAccountant {
    PrivacyAccountant {
        total_epsilon: total_epsilon,
        spent_epsilon: 0.0,
        n_queries: 0,
        max_queries: max_queries,
    }
}

fn accountant_spend(acc: PrivacyAccountant, epsilon: f64) -> PrivacyAccountant {
    PrivacyAccountant {
        total_epsilon: acc.total_epsilon,
        spent_epsilon: acc.spent_epsilon + epsilon,
        n_queries: acc.n_queries + 1,
        max_queries: acc.max_queries,
    }
}

fn accountant_can_query(acc: PrivacyAccountant, epsilon: f64) -> bool {
    let remaining = acc.total_epsilon - acc.spent_epsilon
    remaining >= epsilon && acc.n_queries < acc.max_queries
}

fn accountant_remaining(acc: PrivacyAccountant) -> f64 {
    acc.total_epsilon - acc.spent_epsilon
}

// ============================================================
// Simple 2-mechanism composition (public interface)
// ============================================================

// Sequential composition: running ε₁ + ε₂ on same dataset → (ε₁ + ε₂)-DP
fn dp_compose_sequential(epsilon1: f64, epsilon2: f64) -> f64 {
    epsilon1 + epsilon2
}

// Parallel composition: running ε₁, ε₂ on disjoint partitions → max(ε₁, ε₂)-DP
fn dp_compose_parallel(epsilon1: f64, epsilon2: f64) -> f64 {
    if epsilon1 > epsilon2 { epsilon1 } else { epsilon2 }
}

// ============================================================
// Epistemic confidence tracking for DP queries
// ============================================================

// EpistemicDPValue — a DP result annotated with epistemic uncertainty.
// The variance tracks how much uncertainty is introduced by the DP noise,
// on top of any pre-existing measurement uncertainty.
struct EpistemicDPValue {
    noisy_value: f64,
    true_value: f64,
    noise_variance: f64,   // Var[noise] (known from mechanism)
    conf_lower: f64,       // 95% CI lower bound on true value
    conf_upper: f64,       // 95% CI upper bound on true value
    epsilon_spent: f64,
}

// epistemic_dp_query: wraps dp_query with GUM-style uncertainty propagation.
// For Laplace(b): Var = 2b², so 95% CI half-width ≈ 1.96 * sqrt(2) * b.
// For Gaussian(σ): Var = σ², 95% CI half-width = 1.96 * σ.
fn epistemic_dp_query(config: DPConfig, true_value: f64, seed: i64) -> EpistemicDPValue with IO, Mut, Div, Panic {
    let result = dp_query(config, true_value, seed)
    let noise_var = if config.mechanism == 0 {
        // Laplace: Var = 2 * b²
        let b = config.sensitivity / config.epsilon
        2.0 * b * b
    } else {
        // Gaussian: Var = σ²
        let sigma = gaussian_sigma(config.sensitivity, config.epsilon, config.delta)
        sigma * sigma
    }
    let half_width = 1.96 * dp_sqrt(noise_var)
    EpistemicDPValue {
        noisy_value: result.noisy_value,
        true_value: true_value,
        noise_variance: noise_var,
        conf_lower: result.noisy_value - half_width,
        conf_upper: result.noisy_value + half_width,
        epsilon_spent: config.epsilon,
    }
}

// epistemic_dp_ci_contains: checks if the CI contains the true value
fn epistemic_dp_ci_contains(e: EpistemicDPValue) -> bool {
    e.true_value >= e.conf_lower && e.true_value <= e.conf_upper
}
