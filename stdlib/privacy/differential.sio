// stdlib/privacy/differential.sio — Differential Privacy mechanisms and budget accounting
//
// Implements canonical DP mechanisms from Dwork et al. 2006 and Dwork, Rothblum, Vadhan 2010.
// All mechanisms are calibrated to their stated ε (and δ for approximate DP).
//
// CODATA 2022 / NIST SP 800-188 alignment:
//   ε-DP (pure DP): Laplace mechanism, Randomized Response
//   (ε, δ)-DP (approximate DP): Gaussian mechanism
//   Advanced composition: sqrt(2k * ln(1/δ)) * ε bound
//
// Sounio Sprint 21 DP track — first PL with ε as a type-level graded quantity.
// Paper target: POPL 2026 / CCS 2027
//   "Graded Differential Privacy: ε-Budget as a Compile-Time Algebraic Effect in Sounio"

// ============================================================
// Sensitivity computation helpers
// ============================================================

// l1-sensitivity of a counting query: Δf = 1 (adding/removing one record changes count by 1)
fn counting_query_sensitivity() -> f64 with IO {
    1.0
}

// l1-sensitivity of a sum query on bounded domain [lo, hi]: Δf = hi - lo
fn sum_query_sensitivity(lo: f64, hi: f64) -> f64 with IO, Div, Panic {
    hi + (0.0 - lo)
}

// l1-sensitivity of a mean query on bounded domain, n records: Δf = (hi - lo) / n
fn mean_query_sensitivity(lo: f64, hi: f64, n: i64) -> f64 with IO, Div, Panic {
    let range = hi + (0.0 - lo)
    let n_f: f64 = n as f64
    range / n_f
}

// ============================================================
// Laplace mechanism (pure ε-DP)
// ============================================================
// Theorem (Dwork 2006, Proposition 3.5): Adding Lap(Δf/ε) noise achieves ε-DP.
// Scale parameter b = Δf / ε.

fn laplace_scale(sensitivity: f64, epsilon: f64) -> f64 with IO, Div, Panic {
    sensitivity / epsilon
}

// Variance of Laplace mechanism output: Var[Lap(b)] = 2b²
fn laplace_variance(sensitivity: f64, epsilon: f64) -> f64 with IO, Div, Panic {
    let b = laplace_scale(sensitivity, epsilon)
    2.0 * b * b
}

// Mean squared error of Laplace mechanism: E[(M(D) - f(D))²] = 2(Δf/ε)²
fn laplace_mse(sensitivity: f64, epsilon: f64) -> f64 with IO, Div, Panic {
    laplace_variance(sensitivity, epsilon)
}

// ============================================================
// Gaussian mechanism (approximate (ε, δ)-DP)
// ============================================================
// Theorem (Dwork 2006, Proposition 3.6):
//   σ ≥ sqrt(2 * ln(1.25/δ)) * Δf / ε achieves (ε, δ)-DP.
// For δ = 0.01: sqrt(2 * ln(1.25/0.01)) = sqrt(2 * 4.828) ≈ 3.105

fn gaussian_sigma(sensitivity: f64, epsilon: f64, delta: f64) -> f64 with IO, Div, Panic {
    // Compute ln(1.25/δ) via identity: ln(1.25/δ) = ln(1.25) - ln(δ)
    // Approximate: for δ = 0.01, ln(1.25/δ) ≈ 4.828; for δ = 0.001, ≈ 7.13
    // We use a linear approximation around common δ values (for bootstrap purposes)
    // Full implementation would use stdlib/math/log.sio when available
    let log_inv_delta_approx: f64 = if delta > 0.05 {
        3.0  // δ ≈ 0.1: ln(12.5) ≈ 2.53, rounded up
    } else if delta > 0.005 {
        4.828  // δ ≈ 0.01 (common choice)
    } else if delta > 0.0005 {
        7.13   // δ ≈ 0.001
    } else {
        9.43   // δ ≈ 0.0001
    }
    let factor_sq = 2.0 * log_inv_delta_approx
    // Approximate sqrt via Newton (2 iterations from factor_sq/2)
    let x0 = factor_sq / 2.0
    let x1 = (x0 + factor_sq / x0) / 2.0
    let sqrt_factor = (x1 + factor_sq / x1) / 2.0
    sqrt_factor * sensitivity / epsilon
}

// Variance of Gaussian mechanism output: Var = σ²
fn gaussian_variance(sensitivity: f64, epsilon: f64, delta: f64) -> f64 with IO, Div, Panic {
    let sigma = gaussian_sigma(sensitivity, epsilon, delta)
    sigma * sigma
}

// ============================================================
// Composition theorems
// ============================================================

// Sequential composition: k mechanisms each εᵢ-DP → Σεᵢ-DP overall
// (Theorem 3.14, Dwork 2006)
fn dp_sequential_epsilon(eps_list: [f64; 8], count: i64) -> f64 with IO, Div, Mut, Panic {
    var total: f64 = 0.0
    var i: i64 = 0
    while i < count && i < 8 {
        total = total + eps_list[i as usize]
        i = i + 1
    }
    total
}

// Parallel composition: disjoint datasets → max(εᵢ)-DP overall
// (Theorem 3.20, Dwork 2006)
fn dp_parallel_epsilon(eps_list: [f64; 8], count: i64) -> f64 with IO, Div, Mut, Panic {
    var max_eps: f64 = 0.0
    var i: i64 = 0
    while i < count && i < 8 {
        let ei = eps_list[i as usize]
        max_eps = if ei > max_eps { ei } else { max_eps }
        i = i + 1
    }
    max_eps
}

// Advanced composition (Dwork, Rothblum, Vadhan 2010):
// k mechanisms each ε-DP → (ε', δ')-DP where
//   ε' = sqrt(2k * ln(1/δ')) * ε + k * ε * (exp(ε) - 1)
// Simple approximation for small ε (ε ≤ 1): ε' ≈ ε * sqrt(2k * ln(1/δ'))
fn dp_advanced_composition(epsilon: f64, k_queries: i64, delta: f64) -> f64 with IO, Div, Panic {
    let k_f: f64 = k_queries as f64
    // ln(1/δ) approximation (same as gaussian_sigma above)
    let log_inv_delta: f64 = if delta > 0.05 {
        3.0
    } else if delta > 0.005 {
        4.605  // ln(100) ≈ 4.605 for δ=0.01
    } else if delta > 0.0005 {
        6.908  // ln(1000) ≈ 6.908 for δ=0.001
    } else {
        9.21   // ln(10000) ≈ 9.21 for δ=0.0001
    }
    let under_sqrt = 2.0 * k_f * log_inv_delta
    // Newton sqrt (2 iterations)
    let x0 = under_sqrt / 2.0
    let x1 = (x0 + under_sqrt / x0) / 2.0
    let sqrt_factor = (x1 + under_sqrt / x1) / 2.0
    epsilon * sqrt_factor
}

// ============================================================
// Randomized response (local DP)
// ============================================================
// Warner 1965 / Dwork 2006: For binary response, answer truthfully with prob p = exp(ε)/(1+exp(ε))
// Achieves ε-LDP (local differential privacy).
// Privacy parameter: p (probability of truthful response)
fn randomized_response_p(epsilon: f64) -> f64 with IO, Div, Panic {
    // p = exp(ε) / (1 + exp(ε)) = 1 / (1 + exp(-ε))
    // Approximate exp(ε) for ε ∈ [0,1]: exp(ε) ≈ 1 + ε + ε²/2 + ε³/6
    let e2 = epsilon * epsilon
    let e3 = e2 * epsilon
    let exp_eps = 1.0 + epsilon + e2 / 2.0 + e3 / 6.0
    exp_eps / (1.0 + exp_eps)
}

// ============================================================
// Budget tracking
// ============================================================

// DPBudgetTracker: accumulates ε spent across multiple queries
struct DPBudgetTracker {
    epsilon_total: f64,
    epsilon_spent: f64,
    query_count: i64,
}

fn dp_budget_new(epsilon_total: f64) -> DPBudgetTracker {
    DPBudgetTracker {
        epsilon_total: epsilon_total,
        epsilon_spent: 0.0,
        query_count: 0,
    }
}

fn dp_budget_remaining_f64(tracker: DPBudgetTracker) -> f64 with IO {
    tracker.epsilon_total + (0.0 - tracker.epsilon_spent)
}

fn dp_budget_is_exhausted(tracker: DPBudgetTracker) -> bool with IO {
    tracker.epsilon_spent > tracker.epsilon_total
}
