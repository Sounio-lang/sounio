// stdlib/ml/loss.sio
// Loss functions for neural network training
//
// MSE, MAE, Huber, cross-entropy, and epistemic losses.
// All operate on fixed-size f64 arrays.

struct LossResult {
    loss: f64,
    grad_0: f64,
    grad_1: f64,
    grad_2: f64,
    grad_3: f64,
    n_grads: i64,
}

fn loss_abs(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn loss_sign(x: f64) -> f64 {
    if x > 0.0 { 1.0 } else if x < 0.0 { 0.0 - 1.0 } else { 0.0 }
}

fn loss_max(a: f64, b: f64) -> f64 {
    if a > b { a } else { b }
}

fn loss_clip(x: f64, lo: f64, hi: f64) -> f64 {
    if x < lo { lo } else if x > hi { hi } else { x }
}

// Mean Squared Error for up to 4 elements
// L = (1/n) * sum((pred - target)^2)
fn mse_loss(pred: [f64; 4], target: [f64; 4], n: i64) -> LossResult {
    var sum = 0.0
    var g0 = 0.0
    var g1 = 0.0
    var g2 = 0.0
    var g3 = 0.0
    var i: i64 = 0
    while i < n {
        let diff = pred[i] - target[i]
        sum = sum + diff * diff
        let g = 2.0 * diff / (n as f64)
        if i == 0 { g0 = g }
        if i == 1 { g1 = g }
        if i == 2 { g2 = g }
        if i == 3 { g3 = g }
        i = i + 1
    }
    LossResult {
        loss: sum / (n as f64),
        grad_0: g0, grad_1: g1, grad_2: g2, grad_3: g3,
        n_grads: n,
    }
}

// Mean Absolute Error
fn mae_loss(pred: [f64; 4], target: [f64; 4], n: i64) -> LossResult {
    var sum = 0.0
    var g0 = 0.0
    var g1 = 0.0
    var g2 = 0.0
    var g3 = 0.0
    var i: i64 = 0
    while i < n {
        let diff = pred[i] - target[i]
        sum = sum + loss_abs(diff)
        let g = loss_sign(diff) / (n as f64)
        if i == 0 { g0 = g }
        if i == 1 { g1 = g }
        if i == 2 { g2 = g }
        if i == 3 { g3 = g }
        i = i + 1
    }
    LossResult {
        loss: sum / (n as f64),
        grad_0: g0, grad_1: g1, grad_2: g2, grad_3: g3,
        n_grads: n,
    }
}

// Huber Loss
fn huber_loss(pred: [f64; 4], target: [f64; 4], n: i64, delta: f64) -> LossResult {
    var sum = 0.0
    var g0 = 0.0
    var g1 = 0.0
    var g2 = 0.0
    var g3 = 0.0
    var i: i64 = 0
    while i < n {
        let diff = pred[i] - target[i]
        let abs_diff = loss_abs(diff)
        var g = 0.0
        if abs_diff <= delta {
            sum = sum + 0.5 * diff * diff
            g = diff / (n as f64)
        } else {
            sum = sum + delta * (abs_diff - 0.5 * delta)
            g = delta * loss_sign(diff) / (n as f64)
        }
        if i == 0 { g0 = g }
        if i == 1 { g1 = g }
        if i == 2 { g2 = g }
        if i == 3 { g3 = g }
        i = i + 1
    }
    LossResult {
        loss: sum / (n as f64),
        grad_0: g0, grad_1: g1, grad_2: g2, grad_3: g3,
        n_grads: n,
    }
}

// L1 regularization on fixed array
fn l1_regularization(weights: [f64; 64], n: i64, lambda: f64) -> f64 {
    var sum = 0.0
    var i: i64 = 0
    while i < n {
        sum = sum + loss_abs(weights[i])
        i = i + 1
    }
    return lambda * sum
}

// L2 regularization
fn l2_regularization(weights: [f64; 64], n: i64, lambda: f64) -> f64 {
    var sum = 0.0
    var i: i64 = 0
    while i < n {
        sum = sum + weights[i] * weights[i]
        i = i + 1
    }
    return 0.5 * lambda * sum
}

// Elastic Net
fn elastic_net(weights: [f64; 64], n: i64, l1_lambda: f64, l2_lambda: f64) -> f64 {
    l1_regularization(weights, n, l1_lambda) + l2_regularization(weights, n, l2_lambda)
}
