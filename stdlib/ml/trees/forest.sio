//! Random Forest Implementation
//!
//! This module implements Random Forest (Breiman, 2001) - an ensemble of
//! decision trees with bootstrap sampling and random feature selection.
//!
//! Features:
//! - Bootstrap aggregating (bagging)
//! - Out-of-bag (OOB) error estimation
//! - Random feature subsampling at each split
//! - ExtraTrees variant (extremely randomized trees)
//! - Epistemic uncertainty decomposition (aleatoric vs epistemic)
//!
//! References:
//! - Breiman, "Random Forests" (Machine Learning, 2001)
//! - Geurts et al., "Extremely Randomized Trees" (Machine Learning, 2006)
//! - Conformal prediction for forests (2024-2025 SOTA literature)

use std::ml::trees::node::{
    DecisionTree, TreeNode, LeafStats, TaskType, MAX_CLASSES
}
use std::ml::trees::split::SplitCriterion
use std::ml::trees::cart::{CARTParams, fit_regression, fit_classification}

// ============================================================================
// Constants
// ============================================================================

/// Maximum number of trees in a forest
const MAX_TREES: usize = 500

/// Maximum samples for OOB tracking
const MAX_OOB_SAMPLES: usize = 8192

// ============================================================================
// Random Forest Hyperparameters
// ============================================================================

/// Hyperparameters for Random Forest.
pub struct RandomForestParams {
    /// Number of trees in the forest
    pub n_estimators: i64,

    /// Maximum depth of each tree (0 = unlimited)
    pub max_depth: i64,

    /// Minimum samples to split
    pub min_samples_split: i64,

    /// Minimum samples in leaf
    pub min_samples_leaf: i64,

    /// Number of features to consider at each split
    /// 0 = sqrt(n_features) for classification, n_features/3 for regression
    /// -1 = all features
    pub max_features: i64,

    /// Whether to use bootstrap sampling
    pub bootstrap: bool,

    /// Whether to compute OOB score
    pub oob_score: bool,

    /// Split criterion (Gini, Entropy, Variance)
    pub criterion: i32,

    /// Random seed
    pub random_seed: i64,

    /// Use ExtraTrees variant (random splits)
    pub extra_trees: bool,
}

impl RandomForestParams {
    /// Creates default parameters for classification.
    pub fn classification() -> RandomForestParams {
        RandomForestParams {
            n_estimators: 100,
            max_depth: 0,  // Unlimited
            min_samples_split: 2,
            min_samples_leaf: 1,
            max_features: 0,  // sqrt(n_features)
            bootstrap: true,
            oob_score: true,
            criterion: SplitCriterion::Gini.code(),
            random_seed: 42,
            extra_trees: false,
        }
    }

    /// Creates default parameters for regression.
    pub fn regression() -> RandomForestParams {
        RandomForestParams {
            n_estimators: 100,
            max_depth: 0,
            min_samples_split: 2,
            min_samples_leaf: 1,
            max_features: 0,  // n_features / 3
            bootstrap: true,
            oob_score: true,
            criterion: SplitCriterion::Variance.code(),
            random_seed: 42,
            extra_trees: false,
        }
    }

    /// Creates ExtraTrees parameters.
    pub fn extra_trees() -> RandomForestParams {
        var params = RandomForestParams::classification()
        params.extra_trees = true
        params.bootstrap = false  // ExtraTrees doesn't use bootstrap
        params
    }

    /// Sets number of estimators.
    pub fn with_n_estimators(self: RandomForestParams, n: i64) -> RandomForestParams {
        RandomForestParams {
            n_estimators: n,
            max_depth: self.max_depth,
            min_samples_split: self.min_samples_split,
            min_samples_leaf: self.min_samples_leaf,
            max_features: self.max_features,
            bootstrap: self.bootstrap,
            oob_score: self.oob_score,
            criterion: self.criterion,
            random_seed: self.random_seed,
            extra_trees: self.extra_trees,
        }
    }

    /// Sets max depth.
    pub fn with_max_depth(self: RandomForestParams, depth: i64) -> RandomForestParams {
        RandomForestParams {
            n_estimators: self.n_estimators,
            max_depth: depth,
            min_samples_split: self.min_samples_split,
            min_samples_leaf: self.min_samples_leaf,
            max_features: self.max_features,
            bootstrap: self.bootstrap,
            oob_score: self.oob_score,
            criterion: self.criterion,
            random_seed: self.random_seed,
            extra_trees: self.extra_trees,
        }
    }

    /// Computes actual max_features based on task and n_features.
    fn actual_max_features(self: &RandomForestParams, n_features: i64, is_classification: bool) -> i64 {
        if self.max_features == -1 {
            return n_features
        }
        if self.max_features > 0 {
            return self.max_features
        }
        // Default: sqrt for classification, n/3 for regression
        if is_classification {
            sqrt_i64(n_features)
        } else {
            n_features / 3
        }
    }
}

fn sqrt_i64(n: i64) -> i64 {
    if n <= 0 { return 0 }
    var x = n
    var y = (x + 1) / 2
    while y < x {
        x = y
        y = (x + n / x) / 2
    }
    x
}

// ============================================================================
// Random Forest Model
// ============================================================================

/// A Random Forest model.
pub struct RandomForest {
    /// Individual trees
    trees: [DecisionTree; MAX_TREES],

    /// Number of trees
    n_trees: i64,

    /// Number of features
    n_features: i64,

    /// Number of classes (0 for regression)
    n_classes: i64,

    /// Task type
    task_type: i32,

    /// Feature importances (averaged across trees)
    feature_importances: [f64; 1024],

    /// OOB score (R^2 for regression, accuracy for classification)
    oob_score: f64,

    /// OOB predictions for training samples
    oob_predictions: [f64; MAX_OOB_SAMPLES],

    /// Number of OOB predictions per sample
    oob_counts: [i64; MAX_OOB_SAMPLES],
}

impl RandomForest {
    /// Creates a new empty forest.
    fn new(n_features: i64, n_classes: i64, task_type: TaskType) -> RandomForest {
        // Initialize with placeholder trees
        var trees: [DecisionTree; MAX_TREES] = undefined
        var i: usize = 0
        while i < MAX_TREES {
            trees[i] = DecisionTree::new(n_features, n_classes, task_type)
            i = i + 1
        }

        RandomForest {
            trees,
            n_trees: 0,
            n_features,
            n_classes,
            task_type: task_type.code(),
            feature_importances: [0.0; 1024],
            oob_score: 0.0,
            oob_predictions: [0.0; MAX_OOB_SAMPLES],
            oob_counts: [0; MAX_OOB_SAMPLES],
        }
    }

    /// Returns the number of trees.
    pub fn n_trees(self: &RandomForest) -> i64 {
        self.n_trees
    }

    /// Returns the OOB score.
    pub fn oob_score(self: &RandomForest) -> f64 {
        self.oob_score
    }

    /// Returns feature importance for a feature.
    pub fn feature_importance(self: &RandomForest, idx: i64) -> f64 {
        self.feature_importances[idx as usize]
    }
}

// ============================================================================
// RNG Helpers
// ============================================================================

struct ForestRng {
    state: u64,
}

impl ForestRng {
    fn new(seed: i64) -> ForestRng {
        ForestRng { state: seed as u64 ^ 0x5DEECE66D }
    }

    fn next(self: &!ForestRng) -> u64 {
        self.state = self.state * 6364136223846793005 + 1442695040888963407
        self.state
    }

    fn random_int(self: &!ForestRng, max: i64) -> i64 {
        let r = self.next()
        ((r >> 33) as i64) % max
    }

    /// Generates bootstrap sample indices.
    fn bootstrap_sample(self: &!ForestRng, n_samples: i64, indices: &![i64], in_bag: &![bool]) {
        // Clear in_bag
        var i: i64 = 0
        while i < n_samples && i < MAX_OOB_SAMPLES as i64 {
            in_bag[i as usize] = false
            i = i + 1
        }

        // Sample with replacement
        i = 0
        while i < n_samples {
            let idx = self.random_int(n_samples)
            indices[i as usize] = idx
            if idx < MAX_OOB_SAMPLES as i64 {
                in_bag[idx as usize] = true
            }
            i = i + 1
        }
    }
}

// ============================================================================
// Training
// ============================================================================

/// Fits a Random Forest for regression.
pub fn fit_forest_regression(
    X: &[f64],
    y: &[f64],
    n_samples: i64,
    n_features: i64,
    params: RandomForestParams
) -> RandomForest with Prob {
    var forest = RandomForest::new(n_features, 0, TaskType::Regression)
    var rng = ForestRng::new(params.random_seed)

    let actual_max_features = params.actual_max_features(n_features, false)

    // Convert forest params to CART params
    let cart_params = CARTParams {
        max_depth: params.max_depth,
        min_samples_split: params.min_samples_split,
        min_samples_leaf: params.min_samples_leaf,
        max_features: actual_max_features,
        criterion: params.criterion,
        min_impurity_decrease: 0.0,
        random_seed: 0,  // Will be set per tree
    }

    // Bootstrap sample buffers
    var bootstrap_indices: [i64; 8192] = [0; 8192]
    var in_bag: [bool; 8192] = [false; 8192]

    // Build trees
    var t: i64 = 0
    while t < params.n_estimators && t < MAX_TREES as i64 {
        // Generate bootstrap sample
        if params.bootstrap {
            rng.bootstrap_sample(n_samples, &!bootstrap_indices, &!in_bag)
        } else {
            // No bootstrap - use all samples
            var i: i64 = 0
            while i < n_samples && i < 8192 {
                bootstrap_indices[i as usize] = i
                in_bag[i as usize] = true
                i = i + 1
            }
        }

        // Create bootstrap X and y
        var X_boot: [f64; 65536] = [0.0; 65536]  // 8192 samples * 8 features max
        var y_boot: [f64; 8192] = [0.0; 8192]
        var boot_size = if n_samples < 8192 { n_samples } else { 8192 }

        var i: i64 = 0
        while i < boot_size {
            let idx = bootstrap_indices[i as usize]
            y_boot[i as usize] = y[idx as usize]

            var f: i64 = 0
            while f < n_features && f < 8 {
                X_boot[(i as usize) * (n_features as usize) + (f as usize)] =
                    X[(idx as usize) * (n_features as usize) + (f as usize)]
                f = f + 1
            }
            i = i + 1
        }

        // Train tree with modified seed
        var tree_params = cart_params
        tree_params.random_seed = params.random_seed + t

        forest.trees[t as usize] = fit_regression(
            &X_boot, &y_boot, boot_size, n_features, tree_params
        )

        // OOB predictions
        if params.oob_score && params.bootstrap {
            i = 0
            while i < n_samples && i < MAX_OOB_SAMPLES as i64 {
                if !in_bag[i as usize] {
                    // This sample was out-of-bag for this tree
                    var x: [f64; 1024] = [0.0; 1024]
                    var f: i64 = 0
                    while f < n_features && f < 1024 {
                        x[f as usize] = X[(i as usize) * (n_features as usize) + (f as usize)]
                        f = f + 1
                    }

                    let pred = forest.trees[t as usize].predict_regression(&x)
                    forest.oob_predictions[i as usize] = forest.oob_predictions[i as usize] + pred
                    forest.oob_counts[i as usize] = forest.oob_counts[i as usize] + 1
                }
                i = i + 1
            }
        }

        // Accumulate feature importances
        var f: i64 = 0
        while f < n_features && f < 1024 {
            forest.feature_importances[f as usize] = forest.feature_importances[f as usize]
                + forest.trees[t as usize].feature_importance(f)
            f = f + 1
        }

        forest.n_trees = forest.n_trees + 1
        t = t + 1
    }

    // Normalize feature importances
    var f: i64 = 0
    while f < n_features && f < 1024 {
        forest.feature_importances[f as usize] = forest.feature_importances[f as usize]
            / (forest.n_trees as f64)
        f = f + 1
    }

    // Compute OOB score (R^2)
    if params.oob_score {
        var ss_res = 0.0
        var ss_tot = 0.0
        var y_mean = 0.0
        var n_oob: i64 = 0

        // Compute mean
        var i: i64 = 0
        while i < n_samples && i < MAX_OOB_SAMPLES as i64 {
            if forest.oob_counts[i as usize] > 0 {
                y_mean = y_mean + y[i as usize]
                n_oob = n_oob + 1
            }
            i = i + 1
        }
        if n_oob > 0 {
            y_mean = y_mean / (n_oob as f64)
        }

        // Compute R^2
        i = 0
        while i < n_samples && i < MAX_OOB_SAMPLES as i64 {
            if forest.oob_counts[i as usize] > 0 {
                let oob_pred = forest.oob_predictions[i as usize] / (forest.oob_counts[i as usize] as f64)
                let residual = y[i as usize] - oob_pred
                ss_res = ss_res + residual * residual

                let diff = y[i as usize] - y_mean
                ss_tot = ss_tot + diff * diff
            }
            i = i + 1
        }

        if ss_tot > 0.0 {
            forest.oob_score = 1.0 - ss_res / ss_tot
        }
    }

    forest
}

// ============================================================================
// Prediction
// ============================================================================

/// Prediction result with uncertainty decomposition.
pub struct ForestPrediction {
    /// Mean prediction across trees
    pub value: f64,

    /// Aleatoric uncertainty (average within-leaf variance)
    pub aleatoric_uncertainty: f64,

    /// Epistemic uncertainty (variance across tree predictions)
    pub epistemic_uncertainty: f64,

    /// Total variance
    pub total_variance: f64,

    /// Confidence based on tree agreement
    pub confidence: f64,

    /// Number of trees that contributed
    pub n_trees: i64,

    /// Individual tree predictions (for quantiles)
    pub tree_predictions: [f64; MAX_TREES],
}

impl ForestPrediction {
    /// Returns prediction interval at given coverage level.
    pub fn prediction_interval(self: &ForestPrediction, coverage: f64) -> (f64, f64) {
        let std = sqrt_f64(self.total_variance)
        // Approximate using normal distribution
        let z = if coverage >= 0.99 {
            2.576
        } else if coverage >= 0.95 {
            1.96
        } else if coverage >= 0.90 {
            1.645
        } else {
            1.28
        }

        (self.value - z * std, self.value + z * std)
    }
}

fn sqrt_f64(x: f64) -> f64 {
    if x <= 0.0 { return 0.0 }
    var guess = x / 2.0
    var i = 0
    while i < 20 {
        guess = (guess + x / guess) / 2.0
        i = i + 1
    }
    guess
}

/// Predicts with full uncertainty quantification.
pub fn predict_with_uncertainty(forest: &RandomForest, x: &[f64]) -> ForestPrediction {
    var predictions: [f64; MAX_TREES] = [0.0; MAX_TREES]
    var leaf_variances: [f64; MAX_TREES] = [0.0; MAX_TREES]

    // Get prediction from each tree
    var t: i64 = 0
    while t < forest.n_trees {
        let tree = &forest.trees[t as usize]

        // Get leaf node
        let leaf_idx = tree.find_leaf(x)
        let leaf = tree.get_node(leaf_idx)
        let stats = leaf.stats()

        predictions[t as usize] = stats.predict_regression()
        leaf_variances[t as usize] = stats.variance

        t = t + 1
    }

    // Compute mean prediction
    var mean = 0.0
    t = 0
    while t < forest.n_trees {
        mean = mean + predictions[t as usize]
        t = t + 1
    }
    mean = mean / (forest.n_trees as f64)

    // Compute epistemic uncertainty (variance of predictions)
    var epistemic = 0.0
    t = 0
    while t < forest.n_trees {
        let diff = predictions[t as usize] - mean
        epistemic = epistemic + diff * diff
        t = t + 1
    }
    epistemic = epistemic / (forest.n_trees as f64)

    // Compute aleatoric uncertainty (average leaf variance)
    var aleatoric = 0.0
    t = 0
    while t < forest.n_trees {
        aleatoric = aleatoric + leaf_variances[t as usize]
        t = t + 1
    }
    aleatoric = aleatoric / (forest.n_trees as f64)

    let total = aleatoric + epistemic

    // Confidence based on tree agreement (low epistemic = high confidence)
    let confidence = 1.0 / (1.0 + sqrt_f64(epistemic))

    ForestPrediction {
        value: mean,
        aleatoric_uncertainty: aleatoric,
        epistemic_uncertainty: epistemic,
        total_variance: total,
        confidence,
        n_trees: forest.n_trees,
        tree_predictions: predictions,
    }
}

/// Simple prediction without uncertainty.
pub fn predict(forest: &RandomForest, x: &[f64]) -> f64 {
    var sum = 0.0
    var t: i64 = 0
    while t < forest.n_trees {
        sum = sum + forest.trees[t as usize].predict_regression(x)
        t = t + 1
    }
    sum / (forest.n_trees as f64)
}

/// Batch prediction.
pub fn predict_batch(
    forest: &RandomForest,
    X: &[f64],
    n_samples: i64,
    n_features: i64,
    predictions: &![f64]
) {
    var i: i64 = 0
    while i < n_samples {
        var x: [f64; 1024] = [0.0; 1024]
        var f: i64 = 0
        while f < n_features && f < 1024 {
            x[f as usize] = X[(i as usize) * (n_features as usize) + (f as usize)]
            f = f + 1
        }
        predictions[i as usize] = predict(forest, &x)
        i = i + 1
    }
}

// ============================================================================
// Tests
// ============================================================================

fn main() -> i32 {
    // Test params
    let params = RandomForestParams::regression()
    if params.n_estimators != 100 { return 1 }
    if !params.bootstrap { return 2 }

    // Test sqrt_i64
    if sqrt_i64(100) != 10 { return 3 }
    if sqrt_i64(10) != 3 { return 4 }

    // Test RNG
    var rng = ForestRng::new(42)
    let r1 = rng.next()
    let r2 = rng.next()
    if r1 == r2 { return 5 }

    // Test bootstrap
    var indices: [i64; 8192] = [0; 8192]
    var in_bag: [bool; 8192] = [false; 8192]
    rng.bootstrap_sample(10, &!indices, &!in_bag)

    // At least some should be in bag
    var any_in = false
    var i = 0
    while i < 10 {
        if in_bag[i] { any_in = true }
        i = i + 1
    }
    if !any_in { return 6 }

    // Test sqrt_f64
    let s = sqrt_f64(4.0)
    if s < 1.9 || s > 2.1 { return 7 }

    // Test ForestPrediction interval
    let pred = ForestPrediction {
        value: 10.0,
        aleatoric_uncertainty: 1.0,
        epistemic_uncertainty: 0.5,
        total_variance: 1.5,
        confidence: 0.8,
        n_trees: 10,
        tree_predictions: [0.0; MAX_TREES],
    }

    let (lo, hi) = pred.prediction_interval(0.95)
    // Should be roughly 10 +/- 1.96 * sqrt(1.5) ≈ 10 +/- 2.4
    if lo > 8.0 { return 8 }
    if hi < 12.0 { return 9 }

    // All tests passed
    0
}
