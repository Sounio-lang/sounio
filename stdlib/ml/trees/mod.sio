//! Tree-Based Machine Learning Module
//!
//! This module provides tree-based machine learning algorithms with full
//! epistemic uncertainty quantification, following Sounio's philosophy
//! that every value carries knowledge of its own uncertainty.
//!
//! # Submodules
//!
//! - `node` - Core data structures (TreeNode, SplitInfo, LeafStats, DecisionTree)
//! - `split` - Split criteria (Gini, Entropy, Variance, XGBoost gain)
//! - `cart` - CART decision tree training and prediction
//! - `forest` - Random Forest with bootstrap aggregation and OOB estimation
//! - `epistemic` - Knowledge<T> integration with uncertainty decomposition
//!
//! # Quick Start
//!
//! ## Regression with Uncertainty
//!
//! ```sio
//! use std::ml::trees::{RandomForestParams, fit_forest_regression, predict_epistemic}
//!
//! // Train a random forest
//! let params = RandomForestParams::regression()
//!     .with_n_estimators(100)
//!     .with_max_depth(10)
//!
//! let forest = fit_forest_regression(&X, &y, n_samples, n_features, params)
//!
//! // Predict with uncertainty
//! let prediction = predict_epistemic(&forest, &x_test)
//! println("Prediction: {} +/- {}", prediction.value, prediction.std_uncertainty)
//! println("Confidence: {}", prediction.confidence.value())
//! ```
//!
//! ## Classification
//!
//! ```sio
//! use std::ml::trees::{CARTParams, fit_classification}
//!
//! let params = CARTParams::classification()
//!     .with_max_depth(5)
//!     .with_min_samples_leaf(10)
//!
//! let tree = fit_classification(&X, &y, n_samples, n_features, n_classes, params)
//! let predicted_class = tree.predict_class(&x_test)
//! ```
//!
//! # Uncertainty Decomposition
//!
//! Tree predictions separate uncertainty into:
//! - **Aleatoric**: Irreducible noise in the data (within-leaf variance)
//! - **Epistemic**: Model uncertainty (variance across trees in ensemble)
//!
//! This decomposition enables confidence-gated decisions:
//!
//! ```sio
//! let pred = predict_epistemic(&forest, &x)
//! if pred.is_confident(0.9) {
//!     // High confidence - proceed automatically
//!     take_action(pred.value)
//! } else {
//!     // Low confidence - request human review
//!     request_review(pred)
//! }
//! ```
//!
//! # Conformal Prediction
//!
//! For distribution-free prediction intervals with coverage guarantees:
//!
//! ```sio
//! use std::ml::trees::{ConformalCalibrator, predict_conformal}
//!
//! // Calibrate on held-out data
//! let calibrator = ConformalCalibrator::calibrate(
//!     &forest, &X_cal, &y_cal, n_cal, n_features, 0.95
//! )
//!
//! // Predict with guaranteed 95% coverage
//! let pred = predict_conformal(&forest, &calibrator, &x_test)
//! println("95% interval: [{}, {}]", pred.interval_lo, pred.interval_hi)
//! ```
//!
//! # References
//!
//! - Breiman, "Random Forests" (Machine Learning, 2001)
//! - Breiman et al., "Classification and Regression Trees" (1984)
//! - Conformal Deep Forest (2025)
//! - coverforest: Conformal Predictions with Random Forest (2025)

pub mod node;
pub mod split;
pub mod cart;
pub mod forest;
pub mod epistemic;

// Re-export main types
pub use node::{
    DecisionTree,
    TreeNode,
    SplitInfo,
    LeafStats,
    TaskType,
}

pub use split::{
    SplitCriterion,
    SplitResult,
    gini_impurity,
    entropy,
    variance_from_stats,
    classification_gain,
    variance_reduction,
    xgboost_gain,
}

pub use cart::{
    CARTParams,
    fit_regression,
    fit_classification,
    predict_batch_regression,
    predict_batch_classification,
}

pub use forest::{
    RandomForestParams,
    RandomForest,
    ForestPrediction,
    fit_forest_regression,
    predict_with_uncertainty,
    predict,
    predict_batch,
}

pub use epistemic::{
    TreeKnowledge,
    BetaConfidence,
    ConformalCalibrator,
    predict_epistemic,
    predict_conformal,
    predict_tree_epistemic,
    propagate_linear,
    combine_independent,
}

// ============================================================================
// Module Tests
// ============================================================================

fn main() -> i32 {
    // Test that all submodules load correctly
    // Individual module tests are in their respective files

    // Quick sanity checks
    let params = CARTParams::default()
    if params.max_depth != 10 { return 1 }

    let rf_params = RandomForestParams::regression()
    if rf_params.n_estimators != 100 { return 2 }

    let conf = BetaConfidence::high()
    if conf.value() < 0.9 { return 3 }

    // All tests passed
    0
}
