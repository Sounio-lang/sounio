// stdlib/ml/tensor.sio
// Fixed-size tensor operations for machine learning
//
// Uses [f64; 256] as flat storage with shape metadata.
// Supports up to 4D tensors with max 256 total elements.

struct TensorShape {
    dims: [i64; 4],
    ndim: i64,
    size: i64,
}

fn tshape_compute_size(dims: [i64; 4], ndim: i64) -> i64 {
    var size: i64 = 1
    var i: i64 = 0
    while i < ndim {
        size = size * dims[i]
        i = i + 1
    }
    return size
}

fn tshape_new1(d0: i64) -> TensorShape {
    var dims = [0; 4]
    dims[0] = d0
    TensorShape { dims: dims, ndim: 1, size: d0 }
}

fn tshape_new2(d0: i64, d1: i64) -> TensorShape {
    var dims = [0; 4]
    dims[0] = d0
    dims[1] = d1
    TensorShape { dims: dims, ndim: 2, size: d0 * d1 }
}

// Element-wise add
fn tensor_add(a: [f64; 256], b: [f64; 256], n: i64, out: &![f64; 256]) {
    var i: i64 = 0
    while i < n {
        out[i] = a[i] + b[i]
        i = i + 1
    }
}

// Element-wise sub
fn tensor_sub(a: [f64; 256], b: [f64; 256], n: i64, out: &![f64; 256]) {
    var i: i64 = 0
    while i < n {
        out[i] = a[i] - b[i]
        i = i + 1
    }
}

// Element-wise mul
fn tensor_mul(a: [f64; 256], b: [f64; 256], n: i64, out: &![f64; 256]) {
    var i: i64 = 0
    while i < n {
        out[i] = a[i] * b[i]
        i = i + 1
    }
}

// Element-wise negate
fn tensor_neg(a: [f64; 256], n: i64, out: &![f64; 256]) {
    var i: i64 = 0
    while i < n {
        out[i] = 0.0 - a[i]
        i = i + 1
    }
}

// Scalar multiply
fn tensor_scale(a: [f64; 256], n: i64, s: f64, out: &![f64; 256]) {
    var i: i64 = 0
    while i < n {
        out[i] = a[i] * s
        i = i + 1
    }
}

// Scalar add
fn tensor_shift(a: [f64; 256], n: i64, s: f64, out: &![f64; 256]) {
    var i: i64 = 0
    while i < n {
        out[i] = a[i] + s
        i = i + 1
    }
}

// Sum all elements
fn tensor_sum(a: [f64; 256], n: i64) -> f64 {
    var sum = 0.0
    var i: i64 = 0
    while i < n {
        sum = sum + a[i]
        i = i + 1
    }
    return sum
}

// Mean
fn tensor_mean(a: [f64; 256], n: i64) -> f64 {
    if n == 0 { return 0.0 }
    return tensor_sum(a, n) / (n as f64)
}

// Max
fn tensor_max(a: [f64; 256], n: i64) -> f64 {
    if n == 0 { return 0.0 }
    var m = a[0]
    var i: i64 = 1
    while i < n {
        if a[i] > m { m = a[i] }
        i = i + 1
    }
    return m
}

// Min
fn tensor_min(a: [f64; 256], n: i64) -> f64 {
    if n == 0 { return 0.0 }
    var m = a[0]
    var i: i64 = 1
    while i < n {
        if a[i] < m { m = a[i] }
        i = i + 1
    }
    return m
}

// Matrix multiply: C[m x n] = A[m x k] * B[k x n]  (row-major)
fn tensor_matmul(a: [f64; 256], b: [f64; 256], m: i64, k: i64, n: i64, out: &![f64; 256]) {
    var i: i64 = 0
    while i < m {
        var j: i64 = 0
        while j < n {
            var sum = 0.0
            var p: i64 = 0
            while p < k {
                sum = sum + a[i * k + p] * b[p * n + j]
                p = p + 1
            }
            out[i * n + j] = sum
            j = j + 1
        }
        i = i + 1
    }
}

// Dot product
fn tensor_dot(a: [f64; 256], b: [f64; 256], n: i64) -> f64 {
    var sum = 0.0
    var i: i64 = 0
    while i < n {
        sum = sum + a[i] * b[i]
        i = i + 1
    }
    return sum
}

// Transpose 2D: out[j*rows + i] = a[i*cols + j]
fn tensor_transpose(a: [f64; 256], rows: i64, cols: i64, out: &![f64; 256]) {
    var i: i64 = 0
    while i < rows {
        var j: i64 = 0
        while j < cols {
            out[j * rows + i] = a[i * cols + j]
            j = j + 1
        }
        i = i + 1
    }
}

// Fill with zeros
fn tensor_zeros(out: &![f64; 256], n: i64) {
    var i: i64 = 0
    while i < n {
        out[i] = 0.0
        i = i + 1
    }
}

// Fill with ones
fn tensor_ones(out: &![f64; 256], n: i64) {
    var i: i64 = 0
    while i < n {
        out[i] = 1.0
        i = i + 1
    }
}

// Fill with constant
fn tensor_fill(out: &![f64; 256], n: i64, value: f64) {
    var i: i64 = 0
    while i < n {
        out[i] = value
        i = i + 1
    }
}

// Identity matrix (row-major, n x n)
fn tensor_eye(out: &![f64; 256], n: i64) {
    var i: i64 = 0
    while i < n * n {
        out[i] = 0.0
        i = i + 1
    }
    i = 0
    while i < n {
        out[i * n + i] = 1.0
        i = i + 1
    }
}

// Simple exp approximation
fn tensor_exp_f64(x: f64) -> f64 {
    if x > 10.0 { return 22026.465794806718 * tensor_exp_f64(x - 10.0) }
    if x < 0.0 - 10.0 { return 0.00004539992976248485 * tensor_exp_f64(x + 10.0) }
    var result = 1.0
    var term = 1.0
    var i: i64 = 1
    while i < 20 {
        term = term * x / (i as f64)
        result = result + term
        i = i + 1
    }
    return result
}

// Element-wise exp
fn tensor_exp(a: [f64; 256], n: i64, out: &![f64; 256]) {
    var i: i64 = 0
    while i < n {
        out[i] = tensor_exp_f64(a[i])
        i = i + 1
    }
}

// Simple sqrt (Newton)
fn tensor_sqrt_f64(x: f64) -> f64 {
    if x <= 0.0 { return 0.0 }
    var y = x
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    return y
}

// Element-wise sqrt
fn tensor_sqrt(a: [f64; 256], n: i64, out: &![f64; 256]) {
    var i: i64 = 0
    while i < n {
        out[i] = tensor_sqrt_f64(a[i])
        i = i + 1
    }
}
