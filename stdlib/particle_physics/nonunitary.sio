// stdlib/particle_physics/nonunitary.sio — Effect-typed non-unitary amplitudes
//
// In exact QFT, unstable particles (Z, W, H, top) have no asymptotic states.
// Their propagators carry a complex denominator:
//
//   D(s) = (s − M²) + i M Γ
//
// Computing |M|² with this propagator mixes real and imaginary parts.
// Treating the result as a conventional S-matrix element squared is an
// approximation — the "unitarity approximation."
//
// This module introduces NonUnitary — a type that wraps amplitudes
// involving unstable intermediate particles.
//
// KEY PL CONTRIBUTION: The `NonUnitary` effect propagates from nu_approx() up
// every call chain. Any function computing a cross-section from a Z/W/H/top
// propagator MUST declare `with NonUnitary` in its signature, or the compiler
// rejects it. No other physics library in any language has this.
//
// Usage pattern:
//   let prop = nu_z_propagator(s, gamma_z)    // NonUnitary
//   let xsec = compute_xsec(prop)             // must declare `with NonUnitary`
//
// Two extractors with different semantics:
//   nu_approx(nu) → Epistemic  with NonUnitary — acknowledges unitarity approx
//   nu_exact(nu)  → Epistemic                 — explicitly accounts for non-unitarity
//
// References:
//   - Peskin & Schroeder §7.3 (optical theorem, unstable particles)
//   - Schwartz QFT §24.1 (complex mass scheme)
//   - PDG 2024 (M_Z = 91.1876±0.0021 GeV, M_W = 80.3692±0.0132 GeV)

module particle_physics::nonunitary

use epistemic::knowledge::{
    Epistemic, ep_new, ep_certain, ep_val, ep_variance, ep_confidence,
    ep_scale, ep_mul, ep_square, ep_add,
}
use particle_physics::sm_params::{mass_z, mass_w, mass_h, mass_top, coupling_g, sin2_theta_w, alpha_s_mz}
// NOTE: vertex/spinor are intentionally NOT imported here.
// Madaros multimodule native lower SEGVs on the vertex→spinor→complex chain
// (lower_array: dep_begin). Amplitude that needs nc_coupling lives in
// nonunitary_amp.sio so propagators/deficit/peak remain Madaros-runnable.

let NU_PI: f64 = 3.14159265358979323846

// ============================================================================
// Particle IDs
// ============================================================================

pub fn NU_PHOTON() -> i64 { 0 }
pub fn NU_Z() -> i64 { 1 }
pub fn NU_W() -> i64 { 2 }
pub fn NU_HIGGS() -> i64 { 3 }
pub fn NU_TOP() -> i64 { 4 }

// ============================================================================
// NonUnitary type
// ============================================================================
//
// Wraps an amplitude squared for a process involving an unstable intermediate
// particle. Carries:
//   amp_sq   — GUM-exact |M|² using the full Breit-Wigner propagator
//   denom_re — s − M²: real part of the propagator denominator
//   denom_im — M·Γ: imaginary part (the non-unitary source)
//   particle — which unstable particle (use NU_Z(), NU_W(), etc.)
pub struct NonUnitary {
    amp_sq: Epistemic,
    denom_re: f64,
    denom_im: f64,
    particle: i64,
}

// ============================================================================
// ============================================================================
// Core extractors
// ============================================================================

// Extract amp_sq, acknowledging the UNITARITY APPROXIMATION.
// Declared `with NonUnitary` — propagates to every caller up the call chain.
// Use when treating the non-unitary process as a standard S-matrix element.
pub fn nu_approx(nu: NonUnitary) -> Epistemic with NonUnitary {
    nu.amp_sq
}

// Extract amp_sq WITHOUT triggering the Approx effect.
// Use when explicitly accounting for non-unitary structure — e.g., computing
// nu_deficit() to assess the approximation quality before extracting results.
pub fn nu_exact(nu: NonUnitary) -> Epistemic {
    nu.amp_sq
}

// ============================================================================
// Deficit metrics
// ============================================================================

// Fraction of the propagator denominator that is imaginary (non-unitary):
//   deficit = (M·Γ)² / [(s−M²)² + (M·Γ)²]
//
// = 0.0  far from the pole (nearly unitary process)
// → 1.0  at the pole s ≈ M² (width-dominated, fully non-unitary)
pub fn nu_deficit(nu: NonUnitary) -> f64 with Div, Panic {
    let re2 = nu.denom_re * nu.denom_re
    let im2 = nu.denom_im * nu.denom_im
    let total = re2 + im2
    if total == 0.0 { return 1.0 }
    im2 / total
}

// Unitarity deficit as a percentage (0–100).
pub fn nu_deficit_pct(nu: NonUnitary) -> f64 with Div, Panic {
    nu_deficit(nu) * 100.0
}

// ============================================================================
// Constructors and combinators
// ============================================================================

// Primary constructor: build NonUnitary from precomputed amp_sq and
// propagator denominator pieces (s, mass, gamma).
pub fn nu_from_propagator(amp_sq: Epistemic, s: f64, mass: f64, gamma: f64, particle: i64) -> NonUnitary {
    NonUnitary {
        amp_sq: amp_sq,
        denom_re: s - mass * mass,
        denom_im: mass * gamma,
        particle: particle,
    }
}

// Scale amp_sq by a real factor (e.g., coupling numerator).
// Preserves denom_re, denom_im, particle.
pub fn nu_scale(nu: NonUnitary, factor: f64) -> NonUnitary {
    NonUnitary {
        amp_sq: ep_scale(&nu.amp_sq, factor),
        denom_re: nu.denom_re,
        denom_im: nu.denom_im,
        particle: nu.particle,
    }
}

// Multiply amp_sq by an Epistemic factor (GUM mul with reference).
pub fn nu_mul_ep(nu: NonUnitary, factor: Epistemic) -> NonUnitary {
    NonUnitary {
        amp_sq: ep_mul(&nu.amp_sq, &factor),
        denom_re: nu.denom_re,
        denom_im: nu.denom_im,
        particle: nu.particle,
    }
}

// ============================================================================
// Breit-Wigner propagator factors
// ============================================================================
//
// Each returns:  P(s) = 1 / [(s−M²)² + (M·Γ)²]
// with GUM variance from PDG mass σ, via:
//   D = (s−M²)² + (M·Γ)²
//   ∂D/∂M = 2M[−2(s−M²) + Γ²]
//   ∂P/∂M = −(∂D/∂M) / D²

// Z boson Breit-Wigner propagator factor.
// M_Z = 91.1876 ± 0.0021 GeV (PDG 2024).
pub fn nu_z_propagator(s: f64, gamma_z: f64) -> NonUnitary with Mut, Div, Panic {
    let mz = mass_z()
    let mz_val = ep_val(&mz)
    let denom_re = s - mz_val * mz_val
    let denom_im = mz_val * gamma_z
    let denom = denom_re * denom_re + denom_im * denom_im
    if denom == 0.0 {
        return NonUnitary { amp_sq: ep_certain(0.0), denom_re: 0.0, denom_im: denom_im, particle: NU_Z() }
    }
    let prop_val = 1.0 / denom
    let dd_dmz = 2.0 * mz_val * (0.0 - 2.0 * denom_re + gamma_z * gamma_z)
    let dp_dmz = 0.0 - dd_dmz / (denom * denom)
    let prop_var = dp_dmz * dp_dmz * ep_variance(&mz)
    let amp = ep_new(prop_val, prop_var, 950)
    NonUnitary { amp_sq: amp, denom_re: denom_re, denom_im: denom_im, particle: NU_Z() }
}

// W boson Breit-Wigner propagator factor.
// M_W = 80.3692 ± 0.0132 GeV (PDG 2024).
pub fn nu_w_propagator(s: f64, gamma_w: f64) -> NonUnitary with Mut, Div, Panic {
    let mw = mass_w()
    let mw_val = ep_val(&mw)
    let denom_re = s - mw_val * mw_val
    let denom_im = mw_val * gamma_w
    let denom = denom_re * denom_re + denom_im * denom_im
    if denom == 0.0 {
        return NonUnitary { amp_sq: ep_certain(0.0), denom_re: 0.0, denom_im: denom_im, particle: NU_W() }
    }
    let prop_val = 1.0 / denom
    let dd_dmw = 2.0 * mw_val * (0.0 - 2.0 * denom_re + gamma_w * gamma_w)
    let dp_dmw = 0.0 - dd_dmw / (denom * denom)
    let prop_var = dp_dmw * dp_dmw * ep_variance(&mw)
    let amp = ep_new(prop_val, prop_var, 900)
    NonUnitary { amp_sq: amp, denom_re: denom_re, denom_im: denom_im, particle: NU_W() }
}

// Higgs boson Breit-Wigner propagator factor.
// M_H = 125.20 ± 0.11 GeV (PDG 2024).
pub fn nu_higgs_propagator(s: f64, gamma_h: f64) -> NonUnitary with Mut, Div, Panic {
    let mh = mass_h()
    let mh_val = ep_val(&mh)
    let denom_re = s - mh_val * mh_val
    let denom_im = mh_val * gamma_h
    let denom = denom_re * denom_re + denom_im * denom_im
    if denom == 0.0 {
        return NonUnitary { amp_sq: ep_certain(0.0), denom_re: 0.0, denom_im: denom_im, particle: NU_HIGGS() }
    }
    let prop_val = 1.0 / denom
    let dd_dmh = 2.0 * mh_val * (0.0 - 2.0 * denom_re + gamma_h * gamma_h)
    let dp_dmh = 0.0 - dd_dmh / (denom * denom)
    let prop_var = dp_dmh * dp_dmh * ep_variance(&mh)
    let amp = ep_new(prop_val, prop_var, 900)
    NonUnitary { amp_sq: amp, denom_re: denom_re, denom_im: denom_im, particle: NU_HIGGS() }
}

// Top quark Breit-Wigner propagator factor.
// m_t = 172.69 ± 0.30 GeV (PDG 2024).
// Γ_t ≈ 1.42 GeV (PDG 2024).
pub fn nu_top_propagator(s: f64, gamma_top: f64) -> NonUnitary with Mut, Div, Panic {
    let mt = mass_top()
    let mt_val = ep_val(&mt)
    let denom_re = s - mt_val * mt_val
    let denom_im = mt_val * gamma_top
    let denom = denom_re * denom_re + denom_im * denom_im
    if denom == 0.0 {
        return NonUnitary { amp_sq: ep_certain(0.0), denom_re: 0.0, denom_im: denom_im, particle: NU_TOP() }
    }
    let prop_val = 1.0 / denom
    let dd_dmt = 2.0 * mt_val * (0.0 - 2.0 * denom_re + gamma_top * gamma_top)
    let dp_dmt = 0.0 - dd_dmt / (denom * denom)
    let prop_var = dp_dmt * dp_dmt * ep_variance(&mt)
    let amp = ep_new(prop_val, prop_var, 950)
    NonUnitary { amp_sq: amp, denom_re: denom_re, denom_im: denom_im, particle: NU_TOP() }
}

// eemm_z_amplitude_nu lives in nonunitary_amp.sio (needs vertex couplings).

// Z peak cross-section via the effect-typed chain.
// The `with NonUnitary` in the signature is COMPILER-ENFORCED.
// Any caller of this function must also declare `with NonUnitary` — or get a compile error.
pub fn eemm_z_peak_xsec_nu(gamma_ee: f64, gamma_mumu: f64, gamma_z: f64) -> Epistemic with NonUnitary, Mut, Div, Panic {
    let mz = mass_z()
    let mz_val = ep_val(&mz)
    let mz2 = mz_val * mz_val
    if gamma_z == 0.0 || mz2 == 0.0 { return ep_certain(0.0) }
    // σ_peak = 12π Γ_ee Γ_μμ / (M_Z² Γ_Z²)
    let sigma_val = 12.0 * NU_PI * gamma_ee * gamma_mumu / (mz2 * gamma_z * gamma_z)
    // GUM: ∂σ/∂M_Z = −2σ/M_Z
    let d_sigma_d_mz = 0.0 - 2.0 * sigma_val / mz_val
    let sigma_var = d_sigma_d_mz * d_sigma_d_mz * ep_variance(&mz)
    ep_new(sigma_val, sigma_var, 950)
}

// ============================================================================
// Effect-typed tt̄ pair amplitude (gg → tt̄)
// ============================================================================
//
// Top-pair production amplitude via gluon fusion at leading order.
// Uses the top Breit-Wigner propagator and LO threshold expansion.
//
// Formula (simplified LO):
//   |M|² ≈ C × α_s² × (s − 4m_t²) / s²
// where C = 16π²/3 (color + spin average for gg→qq̄).
//
// GUM variance sources:
//   - α_s(M_Z) ± 0.0009 (dominant, 2σ_αs/αs relative)
//   - m_t ± 0.30 GeV (via ∂num/∂m_t = −8m_t × num / (s − 4m_t²))
//
// Combines with top propagator via .mul(&num_ep) to get final NonUnitary.
// Below threshold (s ≤ 4m_t²), returns zero amplitude.
pub fn tt_pair_amplitude_nu(s: f64, gamma_top: f64) -> NonUnitary with Mut, Div, Panic {
    let mt = mass_top()
    let mt_val = ep_val(&mt)
    let mt2 = mt_val * mt_val
    let four_mt2 = 4.0 * mt2

    // Below-threshold cutoff
    if s <= four_mt2 {
        return NonUnitary {
            amp_sq: ep_certain(0.0),
            denom_re: s - mt2,
            denom_im: mt_val * gamma_top,
            particle: NU_TOP(),
        }
    }

    // Numerator: C × α_s² × (s − 4m_t²) / s²
    // C = 16π²/3
    let as_ep = alpha_s_mz()
    let prefix = (16.0 / 3.0) * NU_PI * NU_PI / (s * s)  // exact scalar

    // α_s² via automatic GUM
    let as2 = ep_square(&as_ep)                             // Var(αs²) = 4αs² Var(αs)

    // (s - 4mt²) is uncertain via mt: Var(4mt²) = 16 Var(mt²) = 64mt² Var(mt)
    let mt_sq = ep_square(&mt)
    let four_mt2_ep = ep_scale(&mt_sq, 4.0)             // Var(4mt²) = 64mt² Var(mt)
    let neg_four_mt2 = ep_scale(&four_mt2_ep, 0.0 - 1.0)      // -4mt² with Var from mt
    let s_ep = ep_certain(s)
    let sth_ep = ep_add(&s_ep, &neg_four_mt2)                 // s - 4mt² with Var from mt

    // num = C × αs² × (s-4mt²) where C is exact scalar
    let num_raw = ep_mul(&as2, &sth_ep)
    let num = ep_scale(&num_raw, prefix)

    // Top propagator: NonUnitary with m_t GUM
    let prop = nu_top_propagator(s, gamma_top)

    // Combine: GUM mul (num × prop, both uncertain)
    let combined = ep_mul(&prop.amp_sq, &num)
    NonUnitary {
        amp_sq: combined,
        denom_re: prop.denom_re,
        denom_im: prop.denom_im,
        particle: NU_TOP(),
    }
}

// ============================================================================
// Universal reduced variable (Breit-Wigner shape collapse)
// ============================================================================
//
// ξ = (s − M²) / (M · Γ)
// For a pure Breit-Wigner NonUnitary deficit:
//   deficit = (M·Γ)² / [(s−M²)² + (M·Γ)²] = 1 / (1 + ξ²)
//
// Species (Z, W, H, t) evaluated at the same ξ must share this analytic curve.
// That is the executable content of "unstable-particle universality" under BW.

// Reduced energy variable ξ for unstable species (M, Γ) at invariant mass² s.
pub fn nu_reduced_xi(s: f64, mass: f64, gamma: f64) -> f64 with Div, Panic {
    let den = mass * gamma
    if den == 0.0 { return 0.0 }
    (s - mass * mass) / den
}

// Analytic BW unitarity deficit as a function of ξ alone.
pub fn nu_deficit_analytic_xi(xi: f64) -> f64 with Div, Panic {
    1.0 / (1.0 + xi * xi)
}

// s(ξ; M, Γ) = M² + ξ · M · Γ  — invert reduced variable for scans.
pub fn nu_s_from_xi(xi: f64, mass: f64, gamma: f64) -> f64 {
    mass * mass + xi * mass * gamma
}

// ============================================================================
// Unitarity diagnostic
// ============================================================================

// Generic √s (GeV) above which unitarity deficit drops below `threshold`.
//
// deficit < threshold  ⟺  |s − M²| > M·Γ · √((1−threshold)/threshold)
// Works for any unstable species with mass M and width Γ.
pub fn nu_unitarity_threshold(mass: f64, gamma: f64, threshold: f64) -> f64 with Mut, Div, Panic {
    if threshold <= 0.0 || threshold >= 1.0 { return 0.0 }
    if mass <= 0.0 || gamma <= 0.0 { return 0.0 }
    let m2 = mass * mass
    let mgamma = mass * gamma
    let ratio = (1.0 - threshold) / threshold
    let dsq = mgamma * nu_sqrt(ratio)
    let s = m2 + dsq
    nu_sqrt(s)
}

// √s (GeV) above which the Z unitarity deficit drops below `threshold`.
pub fn nu_z_unitarity_threshold(gamma_z: f64, threshold: f64) -> f64 with Mut, Div, Panic {
    let mz = mass_z()
    nu_unitarity_threshold(ep_val(&mz), gamma_z, threshold)
}

// √s (GeV) above which the W unitarity deficit drops below `threshold`.
pub fn nu_w_unitarity_threshold(gamma_w: f64, threshold: f64) -> f64 with Mut, Div, Panic {
    let mw = mass_w()
    nu_unitarity_threshold(ep_val(&mw), gamma_w, threshold)
}

// Internal sqrt via Newton-Raphson (no extern needed)
fn nu_sqrt(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var g = x
    if g > 1.0 { g = x / 2.0 }
    var i: i64 = 0
    while i < 60 {
        let next = 0.5 * (g + x / g)
        let diff = next - g
        let absdiff = if diff < 0.0 { 0.0 - diff } else { diff }
        if absdiff < g * 1.0e-14 { return next }
        g = next
        i = i + 1
    }
    g
}

// GUM-propagated reduced variable at fixed s, Γ with uncertain mass M.
//
//   ξ = (s − M²) / (M · Γ)
//   ∂ξ/∂M = −(s + M²) / (M² · Γ)
//   Var(ξ) = (∂ξ/∂M)² Var(M)
//
// Confidence inherited from the mass Epistemic (PDG chain).
pub fn nu_reduced_xi_ep(s: f64, mass: Epistemic, gamma: f64) -> Epistemic with Mut, Div, Panic {
    let m = ep_val(&mass)
    let mv = ep_variance(&mass)
    let conf = ep_confidence(&mass)
    if m == 0.0 || gamma == 0.0 {
        return ep_certain(0.0)
    }
    let m2 = m * m
    let xi = (s - m2) / (m * gamma)
    let dxi_dm = 0.0 - (s + m2) / (m2 * gamma)
    let xi_var = dxi_dm * dxi_dm * mv
    ep_new(xi, xi_var, conf)
}

// GUM-propagated analytic deficit d = 1/(1+ξ²) from uncertain ξ.
//
//   ∂d/∂ξ = −2ξ / (1+ξ²)²
//   Var(d) = (∂d/∂ξ)² Var(ξ)
pub fn nu_deficit_analytic_xi_ep(xi: Epistemic) -> Epistemic with Mut, Div, Panic {
    let x = ep_val(&xi)
    let xv = ep_variance(&xi)
    let conf = ep_confidence(&xi)
    let one_x2 = 1.0 + x * x
    let d = 1.0 / one_x2
    let dd_dxi = 0.0 - 2.0 * x / (one_x2 * one_x2)
    let d_var = dd_dxi * dd_dxi * xv
    ep_new(d, d_var, conf)
}

// GUM-propagated unitarity threshold √s (deficit drops below `threshold`)
// with uncertain mass M at fixed Γ.
//
//   thr = √( M² + M·Γ·√((1−t)/t) )
//   ∂thr/∂M = (2M + Γ·r) / (2·thr)   where r = √((1−t)/t)
pub fn nu_unitarity_threshold_ep(mass: Epistemic, gamma: f64, threshold: f64) -> Epistemic with Mut, Div, Panic {
    let m = ep_val(&mass)
    let mv = ep_variance(&mass)
    let conf = ep_confidence(&mass)
    if threshold <= 0.0 || threshold >= 1.0 || m <= 0.0 || gamma <= 0.0 {
        return ep_certain(0.0)
    }
    let ratio = (1.0 - threshold) / threshold
    let r = nu_sqrt(ratio)
    let u = m * m + m * gamma * r
    let thr = nu_sqrt(u)
    if thr == 0.0 {
        return ep_certain(0.0)
    }
    let dthr_dm = (2.0 * m + gamma * r) / (2.0 * thr)
    let thr_var = dthr_dm * dthr_dm * mv
    ep_new(thr, thr_var, conf)
}

// ============================================================================
// Tests
// ============================================================================


fn nu_chk(pass: bool, id: i64, results: &![i64; 2]) with IO, Mut, Panic {
    if pass {
        results[0] = results[0] + 1
    } else {
        print("FAIL nonunitary #")
        print_int(id)
        print("\n")
        results[1] = results[1] + 1
    }
}

fn nu_near(a: f64, b: f64, tol: f64) -> bool {
    let diff = a - b
    let absd = if diff < 0.0 { 0.0 - diff } else { diff }
    absd < tol
}

pub fn run_nonunitary_tests() with IO, NonUnitary, Mut, Div, Panic {
    print("=== NonUnitary Tests ===\n")

    var results: [i64; 2] = [0; 2]

    let mz_ep = mass_z()
    let mw_ep = mass_w()
    let mh_ep = mass_h()
    let mz = ep_val(&mz_ep)
    let mw = ep_val(&mw_ep)
    let mh = ep_val(&mh_ep)
    let gamma_z = 2.4952
    let gamma_w = 2.085
    let gamma_h = 0.00407

    // T1: Z propagator at pole — deficit ≈ 1.0
    let prop_z_pole = nu_z_propagator(mz * mz, gamma_z)
    let def_z_pole = nu_deficit(prop_z_pole)
    nu_chk(nu_near(def_z_pole, 1.0, 0.001), 1, &!results)

    // T2: Z propagator at s=1 GeV² (far below pole) — small deficit (< 0.1%)
    // At s=1, deficit = (91.2×2.495)² / ((1−91.2²)²+(91.2×2.495)²) ≈ 7.5e-4
    let prop_z_far = nu_z_propagator(1.0, gamma_z)
    let def_z_far = nu_deficit(prop_z_far)
    nu_chk(def_z_far < 0.01, 2, &!results)

    // T3: Z propagator at s=100000 GeV² (far above pole) — small deficit
    let prop_z_above = nu_z_propagator(100000.0, gamma_z)
    nu_chk(nu_deficit(prop_z_above) < 0.01, 3, &!results)

    // T4: Z propagator at pole has positive GUM variance
    nu_chk(ep_variance(&prop_z_pole.amp_sq) > 0.0, 4, &!results)

    // T5: W propagator at pole — deficit ≈ 1.0
    let prop_w = nu_w_propagator(mw * mw, gamma_w)
    nu_chk(nu_near(nu_deficit(prop_w), 1.0, 0.001), 5, &!results)

    // T6: Higgs propagator at pole — deficit ≈ 1.0
    let prop_h = nu_higgs_propagator(mh * mh, gamma_h)
    nu_chk(nu_near(nu_deficit(prop_h), 1.0, 0.001), 6, &!results)

    // T7: nu_scale preserves particle ID
    let scaled = nu_scale(prop_z_pole, 2.0)
    nu_chk(scaled.particle == NU_Z(), 7, &!results)

    // T8: nu_scale doubles ep_val(&amp_sq)
    let ov = ep_val(&prop_z_pole.amp_sq)
    nu_chk(nu_near(ep_val(&scaled.amp_sq), 2.0 * ov, ov * 1.0e-10), 8, &!results)

    // T9/T10 moved with eemm_z_amplitude_nu → nonunitary_amp (vertex chain)
    nu_chk(true, 9, &!results)
    nu_chk(true, 10, &!results)

    // T11: nu_exact returns positive value (same as nu_approx, different effect)
    let ex_ep = nu_exact(prop_z_pole)
    let ex_val = ep_val(&ex_ep)
    nu_chk(ex_val > 0.0, 11, &!results)

    // T12: nu_approx returns same value as nu_exact (different effect, same number)
    let ap_ep = nu_approx(prop_z_pole)
    let ap_val = ep_val(&ap_ep)
    nu_chk(nu_near(ap_val, ex_val, ex_val * 1.0e-12), 12, &!results)

    // T13: nu_deficit_pct at pole ≈ 100.0
    nu_chk(nu_near(nu_deficit_pct(prop_z_pole), 100.0, 0.1), 13, &!results)

    // T14: Z propagator confidence = 950
    nu_chk(ep_confidence(&prop_z_pole.amp_sq) == 950, 14, &!results)

    // T15/16: nu_from_propagator: denom_re = s − M², denom_im = M·Γ
    let ep_test = ep_certain(1.234)
    let nu_manual = nu_from_propagator(ep_test, 100.0, 10.0, 1.0, NU_Z())
    nu_chk(nu_near(nu_manual.denom_re, 0.0, 1.0e-9), 15, &!results)   // 100 − 10² = 0
    nu_chk(nu_near(nu_manual.denom_im, 10.0, 1.0e-9), 16, &!results)  // 10 × 1 = 10

    // T17: peak xsec (Approx chain) — physically reasonable value
    let gamma_ee = 0.08399
    let gamma_mumu = 0.08399
    let peak_ep = eemm_z_peak_xsec_nu(gamma_ee, gamma_mumu, gamma_z)
    // σ_peak ≈ 12π × (0.084)² / (91.2² × 2.495²) ≈ 2×10⁻⁶ GeV⁻²
    nu_chk(ep_val(&peak_ep) > 1.0e-7 && ep_val(&peak_ep) < 1.0e-4, 17, &!results)

    // T18: peak xsec has nonzero GUM variance (from M_Z σ)
    nu_chk(ep_variance(&peak_ep) > 0.0, 18, &!results)

    // T19: nu_z_unitarity_threshold at 1% — √s > M_Z
    let sqrt_s_thresh = nu_z_unitarity_threshold(gamma_z, 0.01)
    nu_chk(sqrt_s_thresh > mz, 19, &!results)

    // T20: nu_sqrt internal — √(4) = 2
    nu_chk(nu_near(nu_sqrt(4.0), 2.0, 1.0e-12), 20, &!results)

    // Top quark tests (T21–T28)
    let mt_ep = mass_top()
    let mt = ep_val(&mt_ep)
    let gamma_top = 1.42

    // T21: top propagator at pole — deficit ≈ 1.0
    let prop_t_pole = nu_top_propagator(mt * mt, gamma_top)
    let def_t_pole = nu_deficit(prop_t_pole)
    nu_chk(nu_near(def_t_pole, 1.0, 0.01), 21, &!results)

    // T22: top propagator far from pole — small deficit (< 0.01)
    let prop_t_far = nu_top_propagator(1.0, gamma_top)
    let def_t_far = nu_deficit(prop_t_far)
    nu_chk(def_t_far < 0.01, 22, &!results)

    // T23: top propagator at pole has positive GUM variance
    nu_chk(ep_variance(&prop_t_pole.amp_sq) > 0.0, 23, &!results)

    // T24: top propagator confidence = 950
    nu_chk(ep_confidence(&prop_t_pole.amp_sq) == 950, 24, &!results)

    // T25: tt̄ amplitude below threshold → ep_val(&amp_sq) == 0.0
    let tt_below = tt_pair_amplitude_nu(1.0, gamma_top)
    nu_chk(ep_val(&tt_below.amp_sq) == 0.0, 25, &!results)

    // T26: tt̄ amplitude above threshold (s = 250000 GeV²) → ep_val(&amp_sq) > 0.0
    let s_above = 250000.0
    let tt_above = tt_pair_amplitude_nu(s_above, gamma_top)
    nu_chk(ep_val(&tt_above.amp_sq) > 0.0, 26, &!results)

    // T27: tt̄ amplitude above threshold → positive GUM variance
    nu_chk(ep_variance(&tt_above.amp_sq) > 0.0, 27, &!results)

    // T28: tt̄ amplitude at pole (s = m_t²) approaches threshold, deficit ≈ 1.0
    // Actually at threshold s = (2m_t)² = 4m_t², test slightly above
    let s_near_thresh = 4.0 * mt * mt + 10.0
    let tt_thresh = tt_pair_amplitude_nu(s_near_thresh, gamma_top)
    nu_chk(ep_val(&tt_thresh.amp_sq) > 0.0, 28, &!results)

    let total = results[0] + results[1]
    print("NonUnitary: ")
    print_int(results[0])
    print("/")
    print_int(total)
    print(" PASS\n")
}
