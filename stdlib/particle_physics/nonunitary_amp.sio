// stdlib/particle_physics/nonunitary_amp.sio
//
// Vertex-dependent NonUnitary amplitudes (split from nonunitary.sio).
//
// Why split: Madaros multimodule native lowering SEGVs when nonunitary pulls
// vertex → spinor → complex (lower_array: dep_begin). Core propagators,
// deficit, and peak xsec stay in nonunitary.sio (Madaros-runnable).
//
// Callers that need eemm_z_amplitude_nu import this module (or the re-export
// from particle_physics::mod).

module particle_physics::nonunitary_amp

use epistemic::knowledge::{
    Epistemic, ep_scale, ep_mul, ep_square, ep_val,
}
use particle_physics::sm_params::{coupling_g, sin2_theta_w}
use particle_physics::vertex::{nc_coupling_electron, nc_coupling_muon}
use particle_physics::nonunitary::{
    NonUnitary, NU_Z, nu_z_propagator,
}

/// e⁺e⁻ → Z → μ⁺μ⁻ amplitude squared, wrapped in NonUnitary.
///
/// |M|² = [g⁴ · (g_V^e² + g_A^e²)(g_V^μ² + g_A^μ²) / cos⁴θ_W]
///          / [(s − M_Z²)² + (M_Z Γ_Z)²]
pub fn eemm_z_amplitude_nu(s: f64, gamma_z: f64) -> NonUnitary with Mut, Div, Panic {
    let g = coupling_g()
    let s2w = sin2_theta_w()
    let cw_sq = 1.0 - ep_val(&s2w)
    let cw4 = cw_sq * cw_sq
    let (gv_e, ga_e) = nc_coupling_electron()
    let (gv_m, ga_m) = nc_coupling_muon()
    let c_e = gv_e * gv_e + ga_e * ga_e
    let c_m = gv_m * gv_m + ga_m * ga_m
    let g2 = ep_square(&g)
    let g4 = ep_square(&g2)
    let num = ep_scale(&g4, c_e * c_m / cw4)
    let prop = nu_z_propagator(s, gamma_z)
    let combined = ep_mul(&prop.amp_sq, &num)
    NonUnitary {
        amp_sq: combined,
        denom_re: prop.denom_re,
        denom_im: prop.denom_im,
        particle: NU_Z(),
    }
}
