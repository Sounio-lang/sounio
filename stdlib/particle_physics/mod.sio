// ============================================================================
// EFFECT-TYPED AMPLITUDES (NonUnitary — first in any language)
// ============================================================================
//
// The `Approx` effect propagates from nu_approx() up every call chain.
// Any function extracting a result from a non-unitary amplitude MUST
// declare `with Approx` in its signature — the compiler enforces this.

pub use particle_physics::nonunitary::{
    NonUnitary,
    NU_PHOTON, NU_Z, NU_W, NU_HIGGS, NU_TOP,
    nu_approx, nu_exact,
    nu_deficit, nu_deficit_pct,
    nu_scale, nu_mul_ep, nu_from_propagator,
    nu_z_propagator, nu_w_propagator, nu_higgs_propagator, nu_top_propagator,
    eemm_z_amplitude_nu, eemm_z_peak_xsec_nu, tt_pair_amplitude_nu,
    nu_z_unitarity_threshold,
}

// ============================================================================
// APPROXIMATION EFFECTS (Perturbative + NarrowWidthApproximation)
// ============================================================================
//
// With NonUnitary (bit 22), Sounio now has THREE distinct physical approximation
// effects encoded in the type system — a uniform calculus of approximations.
//
// Perturbative (bit 23): marks LO-only perturbative expansions.
// NarrowWidthApproximation (bit 24): marks Gamma/M → 0 on-shell calculations.

pub use particle_physics::approx_effects::{
    alpha_s_lo_ep, ggh_lo_xsec_ep,
    z_partial_width_nwa_ep, h_bb_width_nwa_ep,
    alpha_s_lo_ep_gum, ggh_lo_xsec_ep_gum,
    z_partial_width_nwa_ep_gum, h_bb_width_nwa_ep_gum,
}

