// stdlib/particle_physics/sm_params.sio — Standard Model parameters
//
// PDG 2024 recommended values with epistemic uncertainty (GUM variance).
// All masses and energies in GeV (natural units ℏ = c = 1).
//
// References:
//   - PDG 2024: https://pdg.lbl.gov/2024/
//   - CODATA 2022 (exact constants)

module particle_physics::sm_params

use epistemic::knowledge::{Epistemic}

// ============================================================================
// GAUGE COUPLINGS
// ============================================================================

/// Fine-structure constant α_EM at zero momentum.
/// PDG 2024: α⁻¹ ≈ 137.036, α ≈ 0.0072973525693
/// Uncertainty: ±0.0000000000011 (negligible for most QFT; we keep 1 ppb).
pub fn alpha_em() -> Epistemic with Mut, Div, Panic {
    Epistemic::measured(0.0072973525693, 0.0000000000011)
}

/// Strong coupling α_S at M_Z.
/// PDG 2024: α_S(M_Z) = 0.1179 ± 0.0009.
pub fn alpha_s_mz() -> Epistemic with Mut, Div, Panic {
    Epistemic::measured(0.1179, 0.0009)
}

/// Weak mixing angle sin²θ_W (MS-bar scheme at M_Z).
/// PDG 2024: sin²θ_W = 0.23121 ± 0.00004.
pub fn sin2_theta_w() -> Epistemic with Mut, Div, Panic {
    Epistemic::measured(0.23121, 0.00004)
}

/// Electromagnetic coupling e = √(4π α_EM).
pub fn coupling_e() -> Epistemic with Mut, Div, Panic {
    let a = alpha_em()
    // e = sqrt(4*pi*alpha)
    // Variance propagation: de = (2*pi/e) * dalpha ≈ (2*pi/0.3028) * 1.1e-12
    let e_val = sqrt_f64(4.0 * 3.141592653589793 * a.val())
    let de = 2.0 * 3.141592653589793 / e_val * a.std()
    Epistemic::measured(e_val, de)
}

/// Weak coupling g = e / sinθ_W.
pub fn coupling_g() -> Epistemic with Mut, Div, Panic {
    let e = coupling_e()
    let s2 = sin2_theta_w()
    let s = sqrt_f64(s2.val())
    let g_val = e.val() / s
    // δg/g = δe/e + (1/2) δ(sin²θ_W)/sin²θ_W
    let dg = g_val * (e.std() / e.val() + 0.5 * s2.std() / s2.val())
    Epistemic::measured(g_val, dg)
}

/// Hypercharge coupling g′ = e / cosθ_W.
pub fn coupling_gp() -> Epistemic with Mut, Div, Panic {
    let e = coupling_e()
    let s2 = sin2_theta_w()
    let c2 = 1.0 - s2.val()
    let c = sqrt_f64(c2)
    let gp_val = e.val() / c
    let dgp = gp_val * (e.std() / e.val() + 0.5 * s2.std() / c2)
    Epistemic::measured(gp_val, dgp)
}

/// Strong coupling g_s = √(4π α_S) at M_Z.
pub fn coupling_gs() -> Epistemic with Mut, Div, Panic {
    let a = alpha_s_mz()
    let gs_val = sqrt_f64(4.0 * 3.141592653589793 * a.val())
    let dgs = 2.0 * 3.141592653589793 / gs_val * a.std()
    Epistemic::measured(gs_val, dgs)
}

