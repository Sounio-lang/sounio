// ============================================================================
// CKM MATRIX (Wolfenstein parametrization)
// ============================================================================

/// Wolfenstein λ = sinθ_12 ≈ 0.22500 ± 0.00067.
pub fn ckm_lambda() -> Epistemic with Mut, Div, Panic {
    Epistemic::measured(0.22500, 0.00067)
}

/// Wolfenstein A ≈ 0.826 ± 0.012.
pub fn ckm_a() -> Epistemic with Mut, Div, Panic {
    Epistemic::measured(0.826, 0.012)
}

/// Wolfenstein ρ̄ ≈ 0.159 ± 0.010.
pub fn ckm_rho_bar() -> Epistemic with Mut, Div, Panic {
    Epistemic::measured(0.159, 0.010)
}

/// Wolfenstein η̄ ≈ 0.348 ± 0.010.
pub fn ckm_eta_bar() -> Epistemic with Mut, Div, Panic {
    Epistemic::measured(0.348, 0.010)
}

/// CKM matrix element |V_ud| ≈ 1 − λ²/2.
pub fn v_ud() -> Epistemic with Mut, Div, Panic {
    let lam = ckm_lambda()
    let l2 = lam.val() * lam.val()
    let v = 1.0 - l2 / 2.0
    let dv = lam.val() * lam.std()
    Epistemic::measured(v, dv)
}

/// CKM matrix element |V_us| = λ.
pub fn v_us() -> Epistemic with Mut, Div, Panic {
    ckm_lambda()
}

/// CKM matrix element |V_ub| ≈ A λ³ √(ρ̄² + η̄²).
pub fn v_ub() -> Epistemic with Mut, Div, Panic {
    let a = ckm_a()
    let lam = ckm_lambda()
    let rho = ckm_rho_bar()
    let eta = ckm_eta_bar()
    let l3 = lam.val() * lam.val() * lam.val()
    let r2 = rho.val() * rho.val() + eta.val() * eta.val()
    let r = sqrt_f64(r2)
    let v = a.val() * l3 * r
    // Simplified uncertainty (dominated by λ)
    let dv = v * (a.std() / a.val() + 3.0 * lam.std() / lam.val())
    Epistemic::measured(v, dv)
}

/// CKM matrix element |V_cd| ≈ −λ.
pub fn v_cd() -> Epistemic with Mut, Div, Panic {
    let lam = ckm_lambda()
    Epistemic::measured(0.0 - lam.val(), lam.std())
}

/// CKM matrix element |V_cs| ≈ 1 − λ²/2.
pub fn v_cs() -> Epistemic with Mut, Div, Panic {
    v_ud()
}

/// CKM matrix element |V_cb| = A λ².
pub fn v_cb() -> Epistemic with Mut, Div, Panic {
    let a = ckm_a()
    let lam = ckm_lambda()
    let l2 = lam.val() * lam.val()
    let v = a.val() * l2
    let dv = v * (a.std() / a.val() + 2.0 * lam.std() / lam.val())
    Epistemic::measured(v, dv)
}

/// CKM matrix element |V_tb| ≈ 1.
pub fn v_tb() -> Epistemic {
    Epistemic::certain(1.0)
}

/// CKM matrix element |V_ts| ≈ −A λ².
pub fn v_ts() -> Epistemic with Mut, Div, Panic {
    let v = v_cb()
    Epistemic::measured(0.0 - v.val(), v.std())
}

/// CKM matrix element |V_td| ≈ A λ³ (1 − ρ̄ − i η̄) → magnitude A λ³ √( (1−ρ̄)² + η̄² ).
pub fn v_td() -> Epistemic with Mut, Div, Panic {
    let a = ckm_a()
    let lam = ckm_lambda()
    let rho = ckm_rho_bar()
    let eta = ckm_eta_bar()
    let l3 = lam.val() * lam.val() * lam.val()
    let one_m_rho = 1.0 - rho.val()
    let r2 = one_m_rho * one_m_rho + eta.val() * eta.val()
    let r = sqrt_f64(r2)
    let v = a.val() * l3 * r
    let dv = v * (a.std() / a.val() + 3.0 * lam.std() / lam.val())
    Epistemic::measured(v, dv)
}

// ============================================================================
// Λ_QCD
// ============================================================================

/// QCD scale parameter (MS-bar, N_f = 5).
/// PDG 2024: Λ_QCD ≈ 210 ± 20 MeV = 0.210 ± 0.020 GeV.
pub fn lambda_qcd() -> Epistemic with Mut, Div, Panic {
    Epistemic::measured(0.210, 0.020)
}

// ============================================================================
// LOCAL HELPERS
// ============================================================================

fn sqrt_f64(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 24 { y = 0.5 * (y + x / y); i = i + 1 }
    y
}
