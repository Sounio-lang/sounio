pub fn a_mu_hvp_wp20() -> Epistemic with Mut, Div, Panic {
    ep_add(
        &ep_add(&a_mu_hvp_lo_wp20(), &a_mu_hvp_nlo_wp20()),
        &a_mu_hvp_nnlo_wp20(),
    )
}

/// Sounio sum of WP20 sectors. Not the TI correlated total.
pub fn a_mu_sm_sum_wp20() -> Epistemic with Mut, Div, Panic {
    a_mu_ep_sum4(a_mu_qed_wp20(), a_mu_ew_wp20(), a_mu_hvp_wp20(), a_mu_hlbl_wp20())
}

