pub fn a_mu_sm_sum_wp25() -> Epistemic with Mut, Div, Panic {
    a_mu_ep_sum4(a_mu_qed_wp25(), a_mu_ew_wp25(), a_mu_hvp_wp25(), a_mu_hlbl_wp25())
}

