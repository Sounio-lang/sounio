// ============================================================================
// TEST HELPERS
// ============================================================================

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn check_near(a: f64, b: f64, tol: f64) -> bool {
    abs_f64(a - b) < tol
}

fn check_near_complex(a: Complex, b: Complex, tol: f64) -> bool {
    abs_f64(a.re - b.re) < tol && abs_f64(a.im - b.im) < tol
}

// ============================================================================
// LORENTZ TESTS
// ============================================================================

fn test_lorentz_dot() -> bool {
    let p = lorentz_new(5.0, 3.0, 4.0, 0.0)
    let m2 = lorentz_norm_sq(p)
    check_near(m2, 0.0, 1e-10)
}

fn test_lorentz_mass_rest() -> bool with Mut, Div, Panic {
    let q = lorentz_new(10.0, 0.0, 0.0, 0.0)
    let m = lorentz_mass(q)
    check_near(m, 10.0, 1e-10)
}

fn test_lorentz_boost_x() -> bool with Mut, Div, Panic {
    let p_rest = lorentz_new(1.0, 0.0, 0.0, 0.0)
    let p_boosted = lorentz_boost_x(p_rest, 0.6)
    let m_boosted = lorentz_mass(p_boosted)
    check_near(m_boosted, 1.0, 1e-10) && check_near(p_boosted.t, 1.25, 1e-10)
}

fn test_mandelstam_s() -> bool {
    let p1 = lorentz_new(5.0, 0.0, 0.0, 3.0)
    let p2 = lorentz_new(5.0, 0.0, 0.0, -3.0)
    let s = mandelstam_s(p1, p2)
    check_near(s, 100.0, 1e-10)
}

fn test_metric_eta() -> bool {
    check_near(metric_eta(0, 0), 1.0, 1e-10) &&
    check_near(metric_eta(1, 1), -1.0, 1e-10) &&
    check_near(metric_eta(0, 1), 0.0, 1e-10)
}

fn test_pt() -> bool with Mut, Div, Panic {
    let p = lorentz_new(10.0, 3.0, 4.0, 0.0)
    let pt_val = pt(p)
    check_near(pt_val, 5.0, 1e-10)
}

fn test_phase_space_2_body() -> bool with Mut, Div, Panic {
    let ps = phase_space_2_body(100.0, 1.0, 1.0)
    let expected = 4.898979485566356 / (8.0 * 3.141592653589793 * 10.0)
    check_near(ps, expected, 1e-10)
}

// ============================================================================
// SPINOR TESTS
// ============================================================================

fn test_gamma_trace_2() -> bool {
    let tr00 = trace_gamma_2(0, 0)
    let tr11 = trace_gamma_2(1, 1)
    let tr01 = trace_gamma_2(0, 1)
    check_near_complex(tr00, complex_new(4.0, 0.0), 1e-10) &&
    check_near_complex(tr11, complex_new(-4.0, 0.0), 1e-10) &&
    complex_is_zero(tr01)
}

fn test_gamma_trace_4_identity() -> bool {
    // tr(γ^0 γ^1 γ^0 γ^1) = 4(η^01 η^01 - η^00 η^11 + η^01 η^10)
    //                      = 4(0 - (1)(-1) + 0) = 4
    let tr = trace_gamma_4(0, 1, 0, 1)
    check_near_complex(tr, complex_new(4.0, 0.0), 1e-10)
}

fn test_slash_squared() -> bool with Mut, Div, Panic {
    // For a massive particle at rest: p = (m, 0, 0, 0)
    // p̸ = m γ^0, and (p̸)² = m² (γ^0)² = m² I
    let p = lorentz_new(5.0, 0.0, 0.0, 0.0)
    let ps = slash(p)
    let ps2 = dirac_matrix_mul(ps, ps)
    // Check diagonal elements = 25
    let d00 = dm_get(ps2, 0, 0)
    let d11 = dm_get(ps2, 1, 1)
    let d22 = dm_get(ps2, 2, 2)
    let d33 = dm_get(ps2, 3, 3)
    check_near_complex(d00, complex_new(25.0, 0.0), 1e-9) &&
    check_near_complex(d11, complex_new(25.0, 0.0), 1e-9) &&
    check_near_complex(d22, complex_new(25.0, 0.0), 1e-9) &&
    check_near_complex(d33, complex_new(25.0, 0.0), 1e-9)
}

fn test_projector_chirality() -> bool with Mut, Div, Panic {
    // P_L + P_R = I
    let pl = projector_left()
    let pr = projector_right()
    let sum = dirac_matrix_add(pl, pr)
    let id = dirac_matrix_identity()
    var ok = true
    var i: i64 = 0
    while i < 4 {
        var j: i64 = 0
        while j < 4 {
            let s = dm_get(sum, i, j)
            let e = dm_get(id, i, j)
            if abs_f64(s.re - e.re) > 1e-9 || abs_f64(s.im - e.im) > 1e-9 {
                ok = false
            }
            j = j + 1
        }
        i = i + 1
    }
    ok
}

fn test_gamma_5_anticommutation() -> bool with Mut, Div, Panic {
    // {γ^5, γ^0} = 0  →  γ^5 γ^0 + γ^0 γ^5 = 0
    let g5 = gamma_5()
    let g0 = gamma_matrix(0)
    let prod1 = dirac_matrix_mul(g5, g0)
    let prod2 = dirac_matrix_mul(g0, g5)
    let sum = dirac_matrix_add(prod1, prod2)
    var ok = true
    var i: i64 = 0
    while i < 4 {
        var j: i64 = 0
        while j < 4 {
            let s = dm_get(sum, i, j)
            if abs_f64(s.re) > 1e-9 || abs_f64(s.im) > 1e-9 {
                ok = false
            }
            j = j + 1
        }
        i = i + 1
    }
    ok
}

// ============================================================================
// GAUGE TESTS
// ============================================================================

fn test_su2_structure() -> bool {
    let eps123 = su2_structure_constant(1, 2, 3)
    let eps132 = su2_structure_constant(1, 3, 2)
    let eps111 = su2_structure_constant(1, 1, 2)
    check_near(eps123, 1.0, 1e-10) &&
    check_near(eps132, -1.0, 1e-10) &&
    check_near(eps111, 0.0, 1e-10)
}

fn test_su3_casimirs() -> bool {
    check_near(su3_casimir_cf(), 4.0 / 3.0, 1e-10) &&
    check_near(su3_casimir_ca(), 3.0, 1e-10) &&
    check_near(su3_dynkin_tf(), 0.5, 1e-10)
}

fn test_su3_structure_123() -> bool {
    // f_123 = 1
    let f123 = su3_structure_constant(1, 2, 3)
    check_near(f123, 1.0, 1e-10)
}

fn test_su3_structure_147() -> bool {
    // f_147 = 1/2
    let f147 = su3_structure_constant(1, 4, 7)
    let f174 = su3_structure_constant(1, 7, 4)
    check_near(f147, 0.5, 1e-10) && check_near(f174, -0.5, 1e-10)
}

fn test_gell_mann_trace() -> bool {
    // tr(λ^3 λ^3) = 2
    let g3 = gell_mann_re(3)
    var tr: f64 = 0.0
    var i: i64 = 0
    while i < 3 {
        tr = tr + g3[i * 3 + i] * g3[i * 3 + i]
        i = i + 1
    }
    check_near(tr, 2.0, 1e-10)
}

// ============================================================================
// SM PARAMETER TESTS
// ============================================================================

fn test_alpha_em_value() -> bool {
    let a = alpha_em()
    check_near(a.val(), 0.0072973525693, 1e-12) && a.confidence() >= 800
}

fn test_mass_z_value() -> bool {
    let mz = mass_z()
    check_near(mz.val(), 91.1876, 1e-4) && mz.confidence() >= 800
}

fn test_ckm_unitarity_row1() -> bool with Mut, Div, Panic {
    // |V_ud|² + |V_us|² + |V_ub|² ≈ 1
    let vud = v_ud()
    let vus = v_us()
    let vub = v_ub()
    let sum = vud.val() * vud.val() + vus.val() * vus.val() + vub.val() * vub.val()
    check_near(sum, 1.0, 0.01)
}

fn test_coupling_e_positive() -> bool with Mut, Div, Panic {
    let e = coupling_e()
    e.val() > 0.3 && e.val() < 0.31
}

// ============================================================================
// KINEMATICS TESTS
// ============================================================================

fn test_flux_factor() -> bool with Mut, Div, Panic {
    // Two equal mass particles, head-on: p1 = (E, 0, 0, p), p2 = (E, 0, 0, -p)
    // p1·p2 = E² + p², m² = E² - p²
    // F = 4 sqrt((E²+p²)² - (E²-p²)²) = 4 sqrt(4 E² p²) = 8 E p
    let e = 5.0
    let pz = 3.0
    let p1 = lorentz_new(e, 0.0, 0.0, pz)
    let p2 = lorentz_new(e, 0.0, 0.0, 0.0 - pz)
    let f = flux_factor(p1, p2)
    let expected = 8.0 * e * pz
    check_near(f, expected, 1e-9)
}

fn test_cm_momentum() -> bool with Mut, Div, Panic {
    // s = 100, m1 = m2 = 1
    // lambda = 10000 + 1 + 1 - 200 - 200 - 2 = 9600
    // |p_i| = sqrt(9600) / (2*10) = 97.9796 / 20 = 4.89898
    let p_i = cm_momentum_initial(100.0, 1.0, 1.0)
    check_near(p_i, 4.898979485566356, 1e-10)
}

fn test_kallen() -> bool {
    let lam = kallen_lambda(100.0, 1.0, 1.0)
    // lambda = 10000 + 1 + 1 - 200 - 200 - 2 = 9600
    check_near(lam, 9600.0, 1e-10)
}

fn test_decay_width_2_body() -> bool with Mut, Div, Panic {
    // M = 10, m3 = m4 = 1, |M|² = 1
    // Gamma = |p_f| / (8*pi*M²) = 4.8 / (8*pi*100) ≈ 0.00190986
    let gamma = decay_width_2_body(10.0, 1.0, 1.0, 1.0)
    let pf = cm_momentum_final(100.0, 1.0, 1.0)
    let expected = pf / (8.0 * 3.141592653589793 * 100.0)
    check_near(gamma, expected, 1e-10)
}

// ============================================================================
// PHASE 2 TESTS: Propagators, Vertices, Amplitudes
// ============================================================================

fn test_scalar_propagator() -> bool with Mut, Div, Panic {
    // For p² = m², propagator diverges; test slightly off-shell
    let p = lorentz_new(5.0, 0.0, 0.0, 0.0)
    let prop = scalar_propagator(p, 5.0, 0.0)
    // p² = 25, m² = 25 → denominator = 0, should return 0
    // Test with p² ≠ m²
    let p2 = lorentz_new(6.0, 0.0, 0.0, 0.0)
    let prop2 = scalar_propagator_sq(p2, 5.0, 0.0)
    // |D|² = 1/[(36-25)²] = 1/121 ≈ 0.00826
    check_near(prop2, 1.0 / 121.0, 1e-10)
}

fn test_photon_propagator() -> bool with Mut, Div, Panic {
    let p = lorentz_new(3.0, 0.0, 0.0, 0.0)
    let d00 = photon_propagator(p, 0, 0)
    // p² = 9, η_00 = +1, D_00 = -1/9
    check_near(d00.re, -1.0 / 9.0, 1e-10) && check_near(d00.im, 0.0, 1e-10)
}

fn test_qed_vertex() -> bool with Mut, Div, Panic {
    let v = qed_vertex_factor_sq()
    let e = coupling_e().val()
    check_near(v, e * e, 1e-10)
}

fn test_eemm_qed_cross_section() -> bool with Mut, Div, Panic {
    // σ = 4π α² / (3 s) at s = 100 GeV²
    let s = 100.0
    let sigma = eemm_qed_total_cross_section(s)
    let alpha = alpha_em().val()
    let expected = 4.0 * 3.141592653589793 * alpha * alpha / (3.0 * s)
    check_near(sigma, expected, 1e-10)
}

fn test_z_decay_width_ee() -> bool with Mut, Div, Panic {
    let gamma_ee = z_decay_width_ee()
    // PDG: Γ(Z → e⁺e⁻) ≈ 83.9 MeV = 0.0839 GeV
    // Our tree-level estimate should be within ~10%
    check_near(gamma_ee, 0.0839, 0.01)
}

fn test_higgs_width_bb() -> bool with Mut, Div, Panic {
    let mh = mass_h().val()
    let gamma_bb = h_decay_width_ff(mh, mass_bottom().val(), 3.0)
    // Dominant channel: should be > 1 MeV
    gamma_bb > 0.001
}

fn test_r_ratio() -> bool with Mut, Div, Panic {
    // At √s = 10 GeV: u, d, s, c, b all active (2*m_b = 8.36 < 10)
    // R = 3 * (4/9 + 1/9 + 1/9 + 4/9 + 1/9) = 3 * 11/9 = 11/3 ≈ 3.667
    let r = r_ratio(100.0)
    check_near(r, 11.0 / 3.0, 1e-6)
}

// === Phase 3: Standard Model, RGE, Decay, Cross-section ===

fn test_standard_model_config() -> bool with Mut, Div, Panic {
    let sm = standard_model_new()
    sm.e.val() > 0.0
    && sm.g.val() > 0.0
    && sm.gp.val() > 0.0
    && sm.gs.val() > 0.0
}

fn test_ckm_unitarity_sm() -> bool with Mut, Div, Panic {
    let sm = standard_model_new()
    let row1 = sm.ckm[0]*sm.ckm[0] + sm.ckm[1]*sm.ckm[1] + sm.ckm[2]*sm.ckm[2]
    abs_f64(row1 - 1.0) < 0.01
}

fn test_alpha_s_running() -> bool with Mut, Div, Panic {
    let alpha_mz = 0.118
    let mz = 91.19
    let mu = 10.0
    let alpha_low = alpha_s_running(mu, alpha_mz, mz)
    let alpha_val = alpha_low.val()
    // alpha_s should increase as energy decreases
    alpha_val > alpha_mz && alpha_val < 0.25
}

fn test_rho_parameter() -> bool with Mut, Div, Panic {
    let sm = standard_model_new()
    let mw = sm.m_w.val()
    let mz = sm.m_z.val()
    let rho = mw * mw / (mz * mz * (1.0 - sm.sin2_theta_w.val()))
    abs_f64(rho - 1.0) < 0.02
}

fn test_decay_width_epistemic() -> bool with Mut, Div, Panic {
    // Z -> e+ e- width should be ~84 MeV
    let g_ee = z_decay_width_ee()
    g_ee > 0.07 && g_ee < 0.09
}

fn test_branching_ratio() -> bool with Mut, Div, Panic {
    let g_ee = z_decay_width_ee()
    let g_total = z_total_width()
    let br = g_ee / g_total
    br > 0.03 && br < 0.04
}

// === Phase 5: Neutrino, Higgs Production, Three-Body Decays ===

fn test_neutrino_oscillation() -> bool with Mut, Div, Panic {
    // Atmospheric: sin²2θ₂₃ ≈ 1, Δm²₃₁ ≈ 2.5e-3, L=500 km, E=2 GeV
    let p_mutau = oscillation_probability_2flavor(1.0, 0.0025, 500.0, 2.0)
    p_mutau > 0.4 && p_mutau < 0.6
}

fn test_solar_survival() -> bool {
    // Vacuum-averaged solar survival: 1 - ½ sin²2θ₁₂
    // sin²2θ₁₂ ≈ 0.87 → P ≈ 0.565
    let p_avg = survival_probability_2flavor_avg(0.87)
    p_avg > 0.55 && p_avg < 0.58
}

fn test_gg_higgs_production() -> bool with Mut, Div, Panic {
    let mh = mass_h().val()
    let gg = gg_higgs_hadronic_cross_section(mh, 13000.0, 0.118)
    // LO cross-section should be positive and > VBF
    let vbf = vbf_higgs_cross_section_approx(mh, 13000.0)
    gg > 0.0 && gg > vbf
}

fn test_muon_lifetime() -> bool with Mut, Div, Panic {
    let m_mu = mass_muon().val()
    let m_e = mass_electron().val()
    let G_F = 1.1663787e-5
    let tau = muon_lifetime(m_mu, m_e, G_F)
    // PDG: τ_μ ≈ 2.197e-6 s
    tau > 1.8e-6 && tau < 2.6e-6
}

fn test_top_decay_width() -> bool with Mut, Div, Panic {
    let m_t = mass_top().val()
    let m_w = mass_w().val()
    let m_b = mass_bottom().val()
    let G_F = 1.1663787e-5
    let gamma = top_decay_width(m_t, m_w, m_b, G_F)
    // PDG: Γ_t ≈ 1.3 GeV
    gamma > 0.8 && gamma < 1.8
}

fn test_dalitz_bounds() -> bool with Mut, Panic, Div {
    let (m12_min, m12_max) = dalitz_m12_bounds(0.494, 0.140, 0.135, 0.135)
    m12_min >= 0.0 && m12_max > m12_min
}

// === Phase 6: Jet Algorithms, EW Precision, PDFs ===

fn test_jet_clustering() -> bool with Mut, Div, Panic {
    var particles: [LorentzVector; 64] = [lorentz_zero(); 64]
    var jets: [Jet; 64] = [jet_zero(); 64]
    particles[0] = lorentz_new(10.0, 5.0, 0.0, 0.0)
    particles[1] = lorentz_new(10.0, -5.0, 0.0, 0.0)
    let n = anti_kt_cluster(particles, 2, 0.4, &!jets)
    n == 2
}

fn test_jet_merge() -> bool with Mut, Div, Panic {
    var particles: [LorentzVector; 64] = [lorentz_zero(); 64]
    var jets: [Jet; 64] = [jet_zero(); 64]
    particles[0] = lorentz_new(10.0, 0.1, 0.0, 0.0)
    particles[1] = lorentz_new(10.0, 0.2, 0.0, 0.0)
    let n = anti_kt_cluster(particles, 2, 1.0, &!jets)
    n == 1
}

fn test_delta_rho() -> bool with Mut, Div, Panic {
    let drho = delta_rho(mass_top().val())
    drho > 0.008 && drho < 0.012
}

fn test_m_w_prediction() -> bool with Mut, Div, Panic {
    let mw = m_w_prediction(mass_top().val(), mass_h().val(), alpha_s_mz().val())
    mw > 79.0 && mw < 82.0
}

fn test_pdf_valence() -> bool with Mut, Div, Panic {
    let u_num = up_valence_number(10000.0)
    let d_num = down_valence_number(10000.0)
    u_num > 1.5 && u_num < 2.5 && d_num > 0.5 && d_num < 2.5
}

fn test_pdf_gluon_momentum() -> bool with Mut, Div, Panic {
    let g_frac = gluon_momentum_fraction(10000.0)
    g_frac > 0.3 && g_frac < 0.7
}

// ============================================================================
// PHASE 7 TESTS: MONTE CARLO
// ============================================================================

fn test_rambo_massless_conservation() -> bool with Mut, Div, Panic {
    seed_rng(42)
    var momenta: [LorentzVector; 64] = [lorentz_zero(); 64]
    let _w = rambo_generator_massless(3, 10.0, &!momenta)
    check_momentum_conservation(momenta, 3, 10.0)
}

fn test_rambo_massive_conservation() -> bool with Mut, Div, Panic {
    seed_rng(42)
    var momenta: [LorentzVector; 64] = [lorentz_zero(); 64]
    var masses: [f64; 64] = [0.0; 64]
    masses[0] = 1.0
    masses[1] = 1.0
    let _w = rambo_generator(2, 10.0, &masses, &!momenta)
    check_momentum_conservation(momenta, 2, 10.0)
}

fn f_x2(x: f64) -> f64 { x * x }
fn f_poly(x: f64) -> f64 { x * (1.0 - x) }

fn test_vegas_x2() -> bool with Mut, Div, Panic {
    seed_rng(42)
    let (result, error) = vegas_integrate_1d(f_x2, 0.0, 1.0, 20, 2000)
    check_near(result, 0.333333, 5.0 * error + 0.01) && error < 0.05
}

fn test_vegas_poly() -> bool with Mut, Div, Panic {
    seed_rng(42)
    let (result, error) = vegas_integrate_1d(f_poly, 0.0, 1.0, 20, 2000)
    check_near(result, 0.166667, 5.0 * error + 0.01) && error < 0.05
}

fn pdf_uniform(x: f64) -> f64 {
    if x >= 0.0 && x <= 1.0 { 1.0 } else { 0.0 }
}

fn test_acceptance_rejection() -> bool with Mut, Div, Panic {
    seed_rng(42)
    var samples: [f64; 1024] = [0.0; 1024]
    let n = acceptance_rejection_sampling(pdf_uniform, 0.0, 1.0, 1.5, &!samples, 100)
    n >= 50 && n <= 100
}

fn test_eemm_event_gen() -> bool with Mut, Div, Panic {
    seed_rng(42)
    var p3: [LorentzVector; 1024] = [lorentz_zero(); 1024]
    var p4: [LorentzVector; 1024] = [lorentz_zero(); 1024]
    var weights: [f64; 1024] = [0.0; 1024]
    let n = generate_eemm_events(100, 91.2, &!p3, &!p4, &!weights)
    n == 100
}

fn test_dglap_kernels() -> bool with Div {
    // P_qg(0.5) = T_F * (0.25 + 0.25) = 0.5 * 0.5 = 0.25
    let pqg_05 = p_qg(0.5)
    // P_gq(0.5) = C_F * (1 + 0.25) / 0.5 = 4/3 * 1.25 / 0.5 = 10/3 ≈ 3.333
    let pgq_05 = p_gq(0.5)
    check_near(pqg_05, 0.25, 0.01) && pgq_05 > 3.0 && pgq_05 < 3.5
}

fn test_sudakov() -> bool with Div {
    let s1 = sudakov_form_factor(0.12, 100.0, 1.0, false, 5)
    let s2 = sudakov_form_factor(0.12, 100.0, 1.0, true, 5)
    // Gluon Sudakov should be smaller (more radiation)
    s1 > 0.0 && s1 <= 1.0 && s2 > 0.0 && s2 <= 1.0 && s2 < s1
}

fn test_cluster_decay() -> bool with Mut, Div {
    seed_shower_rng(42)
    var h1 = lorentz_zero()
    var h2 = lorentz_zero()
    cluster_decay_two_body(5.0, 0.14, 0.14, 0.0, 0.0, 0.0, &!h1, &!h2)
    let e_sum = h1.t + h2.t
    // Energy conservation in rest frame
    check_near(e_sum, 5.0, 0.01)
}

fn test_bethe_bloch() -> bool with Div {
    let si = material_silicon()
    let mip = dedx_mip(si)
    // MIP dE/dx in Si ≈ 1.5–2.0 MeV cm²/g
    mip > 1.0 && mip < 4.0
}

fn test_highland_scattering() -> bool with Div {
    // 1 GeV muon through 1 X0 of Si
    let theta = highland_scattering_angle(1.0, 0.10566, 1.0, 1.0)
    // Should be O(10–20 mrad)
    theta > 0.01 && theta < 0.05
}

fn test_calorimeter_resolution() -> bool with Div {
    let res_1gev = em_calorimeter_resolution(1.0)
    let res_100gev = em_calorimeter_resolution(100.0)
    // Resolution improves with energy
    res_1gev > res_100gev && res_100gev < 0.01
}

fn test_track_curvature() -> bool with Div {
    let kappa = track_curvature(3.8, 1.0, 1.0)
    let pt = pt_from_curvature(3.8, 1.0, kappa)
    check_near(pt, 1.0, 0.001)
}

fn test_vertex_reco() -> bool with Div {
    // Two tracks crossing at (1, 1)
    let (vx, vy) = vertex_from_two_tracks(
        0.0, 0.0, 1.0, 1.0,
        2.0, 0.0, -1.0, 1.0,
    )
    check_near(vx, 1.0, 0.01) && check_near(vy, 1.0, 0.01)
}

fn jet_zero() -> Jet {
    Jet { p: lorentz_zero(), constituents: [0; 64], n_constituents: 0 }
}

