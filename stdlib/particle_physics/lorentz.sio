// stdlib/particle_physics/lorentz.sio — Lorentz vectors and kinematics
//
// Minkowski-space 4-vectors with metric signature η = diag(+1, −1, −1, −1).
// Natural units: ℏ = c = 1.
//
// References:
//   - Peskin & Schroeder, "An Introduction to Quantum Field Theory", 1995
//   - PDG 2024, Kinematics (https://pdg.lbl.gov/2024/reviews/contents_sports.html)

module particle_physics::lorentz

// #1622 / E175: do not declare private extern "C" sqrt/sinh/cosh here.
// Madaros multimodule registers those as private fn sigs; any sibling module
// that calls the builtin (e.g. complex::lib) then resolves to this private
// stub and false-fails E175. Builtins need no declaration.

// ============================================================================
// LORENTZ VECTOR
// ============================================================================

/// A 4-vector in Minkowski space: p^μ = (E, p_x, p_y, p_z).
pub struct LorentzVector {
    pub t: f64,   // Energy / time component
    pub x: f64,   // x-momentum / space component
    pub y: f64,   // y-momentum / space component
    pub z: f64,   // z-momentum / space component
}

/// Construct a Lorentz vector from components.
pub fn lorentz_new(t: f64, x: f64, y: f64, z: f64) -> LorentzVector {
    LorentzVector { t: t, x: x, y: y, z: z }
}

/// Zero 4-vector.
pub fn lorentz_zero() -> LorentzVector {
    LorentzVector { t: 0.0, x: 0.0, y: 0.0, z: 0.0 }
}

// ============================================================================
// METRIC AND SCALAR PRODUCT
// ============================================================================

/// Minkowski metric η_μν with signature (+, −, −, −).
/// Returns η[mu][nu] where mu,nu ∈ {0,1,2,3}.
pub fn metric_eta(mu: i64, nu: i64) -> f64 {
    if mu != nu { return 0.0 }
    if mu == 0 { return 1.0 }
    return 0.0 - 1.0
}

/// Lorentz scalar product: a·b = η_μν a^μ b^ν = a^t b^t − a^x b^x − a^y b^y − a^z b^z.
pub fn lorentz_dot(a: LorentzVector, b: LorentzVector) -> f64 {
    a.t * b.t - a.x * b.x - a.y * b.y - a.z * b.z
}

/// Invariant mass squared: m² = p·p.
pub fn lorentz_norm_sq(p: LorentzVector) -> f64 {
    lorentz_dot(p, p)
}

/// Invariant mass: m = √(p·p). Returns 0.0 for negative norm (spacelike).
pub fn lorentz_mass(p: LorentzVector) -> f64 with Mut, Div, Panic {
    let m2 = lorentz_norm_sq(p)
    if m2 < 0.0 { return 0.0 }
    sqrt(m2)
}

// ============================================================================
// VECTOR OPERATIONS
// ============================================================================

/// 3-momentum squared: |p⃗|².
pub fn momentum_sq(p: LorentzVector) -> f64 {
    p.x * p.x + p.y * p.y + p.z * p.z
}

/// 3-momentum magnitude: |p⃗|.
pub fn momentum_mag(p: LorentzVector) -> f64 with Mut, Div, Panic {
    sqrt(momentum_sq(p))
}

/// Addition of 4-vectors: (a + b)^μ.
pub fn lorentz_add(a: LorentzVector, b: LorentzVector) -> LorentzVector {
    LorentzVector {
        t: a.t + b.t,
        x: a.x + b.x,
        y: a.y + b.y,
        z: a.z + b.z,
    }
}

/// Subtraction of 4-vectors: (a − b)^μ.
pub fn lorentz_sub(a: LorentzVector, b: LorentzVector) -> LorentzVector {
    LorentzVector {
        t: a.t - b.t,
        x: a.x - b.x,
        y: a.y - b.y,
        z: a.z - b.z,
    }
}

/// Scalar multiplication: (c · p)^μ.
pub fn lorentz_scale(p: LorentzVector, c: f64) -> LorentzVector {
    LorentzVector {
        t: p.t * c,
        x: p.x * c,
        y: p.y * c,
        z: p.z * c,
    }
}

// ============================================================================
// LORENTZ BOOSTS
// ============================================================================

/// Boost along the x-axis with velocity β = v/c.
///   p'^0 = γ(p^0 − β p^x)
///   p'^x = γ(p^x − β p^0)
///   p'^y = p^y
///   p'^z = p^z
/// where γ = 1/√(1−β²).
pub fn lorentz_boost_x(p: LorentzVector, beta: f64) -> LorentzVector with Mut, Div, Panic {
    if beta >= 1.0 || beta <= -1.0 {
        return p
    }
    let gamma = 1.0 / sqrt(1.0 - beta * beta)
    LorentzVector {
        t: gamma * (p.t - beta * p.x),
        x: gamma * (p.x - beta * p.t),
        y: p.y,
        z: p.z,
    }
}

/// Boost along the y-axis.
pub fn lorentz_boost_y(p: LorentzVector, beta: f64) -> LorentzVector with Mut, Div, Panic {
    if beta >= 1.0 || beta <= -1.0 {
        return p
    }
    let gamma = 1.0 / sqrt(1.0 - beta * beta)
    LorentzVector {
        t: gamma * (p.t - beta * p.y),
        x: p.x,
        y: gamma * (p.y - beta * p.t),
        z: p.z,
    }
}

/// Boost along the z-axis.
pub fn lorentz_boost_z(p: LorentzVector, beta: f64) -> LorentzVector with Mut, Div, Panic {
    if beta >= 1.0 || beta <= -1.0 {
        return p
    }
    let gamma = 1.0 / sqrt(1.0 - beta * beta)
    LorentzVector {
        t: gamma * (p.t - beta * p.z),
        x: p.x,
        y: p.y,
        z: gamma * (p.z - beta * p.t),
    }
}

/// General boost with 3-velocity vector β⃗ = (βx, βy, βz).
/// Uses the Lorentz boost matrix in arbitrary direction.
pub fn lorentz_boost(p: LorentzVector, beta_x: f64, beta_y: f64, beta_z: f64) -> LorentzVector with Mut, Div, Panic {
    let beta_sq = beta_x * beta_x + beta_y * beta_y + beta_z * beta_z
    if beta_sq >= 1.0 || beta_sq <= 0.0 {
        return p
    }
    let beta = sqrt(beta_sq)
    let gamma = 1.0 / sqrt(1.0 - beta_sq)
    let n_x = beta_x / beta
    let n_y = beta_y / beta
    let n_z = beta_z / beta

    let bp = n_x * p.x + n_y * p.y + n_z * p.z
    let g1 = gamma - 1.0

    LorentzVector {
        t: gamma * (p.t - beta * bp),
        x: p.x + g1 * bp * n_x - gamma * beta * n_x * p.t,
        y: p.y + g1 * bp * n_y - gamma * beta * n_y * p.t,
        z: p.z + g1 * bp * n_z - gamma * beta * n_z * p.t,
    }
}

// ============================================================================
// RAPIDITY AND PSEUDORAPIDITY
// ============================================================================

/// Rapidity y = ½ ln((E + p_z)/(E − p_z)).
/// Returns 0.0 if E = |p_z| (beam axis).
pub fn rapidity(p: LorentzVector) -> f64 with Mut, Div, Panic {
    let e_plus_pz = p.t + p.z
    let e_minus_pz = p.t - p.z
    if e_plus_pz <= 0.0 || e_minus_pz <= 0.0 {
        return 0.0
    }
    0.5 * (ln_f64(e_plus_pz) - ln_f64(e_minus_pz))
}

/// Pseudorapidity η = −ln(tan(θ/2)) where θ is the polar angle.
/// For massless particles, η = y.
pub fn pseudorapidity(p: LorentzVector) -> f64 with Mut, Div, Panic {
    let p_mag = momentum_mag(p)
    if p_mag <= 0.0 { return 0.0 }
    let cos_theta = p.z / p_mag
    if cos_theta >= 1.0 || cos_theta <= -1.0 { return 0.0 }
    let sin_theta = sqrt(1.0 - cos_theta * cos_theta)
    if sin_theta <= 0.0 { return 0.0 }
    0.0 - ln_f64((1.0 - cos_theta) / sin_theta)
}

/// Transverse momentum squared: p_T² = p_x² + p_y².
pub fn pt_sq(p: LorentzVector) -> f64 {
    p.x * p.x + p.y * p.y
}

/// Transverse momentum: p_T = √(p_x² + p_y²).
pub fn pt(p: LorentzVector) -> f64 with Mut, Div, Panic {
    sqrt(pt_sq(p))
}

/// Azimuthal angle φ = atan2(p_y, p_x).
pub fn azimuth(p: LorentzVector) -> f64 with Mut, Div, Panic {
    atan2_f64(p.y, p.x)
}

// ============================================================================
// MANDELSTAM VARIABLES
// ============================================================================

/// Mandelstam s = (p1 + p2)² — center-of-mass energy squared.
pub fn mandelstam_s(p1: LorentzVector, p2: LorentzVector) -> f64 {
    let p_sum = lorentz_add(p1, p2)
    lorentz_norm_sq(p_sum)
}

/// Mandelstam t = (p1 − p3)² — momentum transfer squared.
pub fn mandelstam_t(p1: LorentzVector, p3: LorentzVector) -> f64 {
    let p_diff = lorentz_sub(p1, p3)
    lorentz_norm_sq(p_diff)
}

/// Mandelstam u = (p1 − p4)² — alternate momentum transfer.
/// For 2→2 scattering: s + t + u = m1² + m2² + m3² + m4².
pub fn mandelstam_u(p1: LorentzVector, p4: LorentzVector) -> f64 {
    let p_diff = lorentz_sub(p1, p4)
    lorentz_norm_sq(p_diff)
}

// ============================================================================
// LORENTZ-INVARIANT PHASE-SPACE MEASURE (2-body)
// ============================================================================

/// Two-body phase-space factor:
///   dΦ₂ = |p⃗_f|/(16π² √s) dΩ
/// where |p⃗_f| is the final-state 3-momentum in the CM frame.
/// Returns the angular-integrated factor (4π) for total cross-sections.
pub fn phase_space_2_body(s: f64, m3: f64, m4: f64) -> f64 with Mut, Div, Panic {
    if s <= 0.0 { return 0.0 }
    let sqrt_s = sqrt(s)
    let p_f_sq = (s - (m3 + m4) * (m3 + m4)) * (s - (m3 - m4) * (m3 - m4)) / (4.0 * s)
    if p_f_sq <= 0.0 { return 0.0 }
    let p_f = sqrt(p_f_sq)
    p_f / (8.0 * PI_F64 * sqrt_s)
}

// ============================================================================
// LOCAL MATH HELPERS (no libm dependency for core functions)
// ============================================================================

fn ln_f64(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 - 1.0e30 }
    var m = x
    var e = 0
    while m >= 2.0 { m = m / 2.0; e = e + 1 }
    while m < 0.5 { m = m * 2.0; e = e - 1 }
    let t = (m - 1.0) / (m + 1.0)
    let t2 = t * t
    var sum = t
    var term = t
    var k = 1
    while k < 30 { term = term * t2; sum = sum + term / ((2 * k + 1) as f64); k = k + 1 }
    let ln2 = 0.6931471805599453
    (e as f64) * ln2 + 2.0 * sum
}

fn atan2_f64(y: f64, x: f64) -> f64 with Mut, Div, Panic {
    if x == 0.0 && y == 0.0 { return 0.0 }
    if x > 0.0 { return atan_f64(y / x) }
    if x < 0.0 {
        if y >= 0.0 { return atan_f64(y / x) + PI_F64 }
        return atan_f64(y / x) - PI_F64
    }
    if y > 0.0 { return PI_F64 / 2.0 }
    return 0.0 - PI_F64 / 2.0
}

fn atan_f64(x: f64) -> f64 with Mut, Div, Panic {
    let a = x
    let a2 = a * a
    var sum = a
    var term = a
    var n = 1
    while n < 25 {
        term = 0.0 - term * a2
        sum = sum + term / ((2 * n + 1) as f64)
        n = n + 1
    }
    sum
}

let PI_F64: f64 = 3.14159265358979323846
