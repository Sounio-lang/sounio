// stdlib/particle_physics/nlo_kfactor.sio — NLO K-factors with renormalization-scale uncertainty
//
// K-factors encode the NLO QCD correction: K = σ_NLO / σ_LO.
// Perturbative (renormalization-scale) uncertainty is estimated by 3-point
// scale variation: evaluate at μ_R = μ₀/2 and μ_R = 2μ₀, take the half-range.
//
// This is the first physics library to carry μ_R uncertainty through
// amplitude → observable in a single compile unit with GUM-exact propagation.
//
// σ_scale = (K(2μ₀) − K(μ₀/2)) / 2
//
// References:
//   - PDG 2024, Monte Carlo generators & NLO calculations
//   - Drell, Yan (1970): DY K ≈ 1 + (α_s/π)·C_F·π²/3
//   - Spira et al. (1995): gg→H at NLO (K ~ 2 from top-quark loop)
//   - Czakon et al. (2014): tt̄ at NLO+NNLO (K ~ 1.5)

module particle_physics::nlo_kfactor

use epistemic::knowledge::{Epistemic}
use particle_physics::sm_params::{alpha_s_mz, mass_z, mass_h, mass_top}
use particle_physics::rge::{alpha_s_at_mu}

// #1622 / E175: do not declare private extern "C" for libm/builtins here.
// Madaros multimodule registers those as private fn sigs; sibling modules
// that call the builtin (e.g. complex::lib) then false-fail E175.
// Builtins (sqrt/exp/log/sin/cos) need no declaration; use math::libm
// for fabs/pow/atan2/tanh (see statistics.sio / ml_hep.sio).
// ============================================================================
// Internal: Newton-Raphson square root (no extern dependency for scale band)
// ============================================================================

fn nlo_sqrt(x: f64) -> f64 with Div, Panic {
    if x <= 0.0 { return 0.0 }
    var g = x
    if g > 1.0 { g = x / 2.0 }
    var i: i64 = 0
    while i < 50 {
        let next = 0.5 * (g + x / g)
        let diff = next - g
        let d = if diff < 0.0 { 0.0 - diff } else { diff }
        if d < g * 1.0e-13 { return next }
        g = next
        i = i + 1
    }
    g
}

// ============================================================================
// DRELL-YAN K-FACTOR  (qq̄ → ℓ+ℓ− via virtual γ*/Z)
//
// LO → NLO correction: K_DY ≈ 1 + (α_s/α_s(M_Z)) × 0.30
// At μ = M_Z: K ≈ 1.30.  Scale variation ~1% at M_Z.
// ============================================================================

/// Drell-Yan K-factor with 3-point renormalization-scale uncertainty.
///
/// # Arguments
/// - `mu0_sq`: Central renormalization scale squared (GeV²).
///
/// # Returns
/// `Epistemic` with val=K_DY(μ₀), std=σ_scale=(K(2μ₀)−K(μ₀/2))/2.
pub fn kfactor_dy_ep(mu0_sq: f64) -> Epistemic with Div, Panic, Mut {
    let mu0 = sqrt(mu0_sq)
    let mu_up = sqrt(4.0 * mu0_sq)
    let mu_dn = sqrt(mu0_sq / 4.0)
    let as0 = alpha_s_at_mu(mu0).val()
    let as_up = alpha_s_at_mu(mu_up).val()
    let as_dn = alpha_s_at_mu(mu_dn).val()
    let k_central = 1.0 + (as0 / 0.1180) * 0.30
    let k_up = 1.0 + (as_up / 0.1180) * 0.30
    let k_dn = 1.0 + (as_dn / 0.1180) * 0.30
    let sigma_scale = (k_up - k_dn) / 2.0
    let abssig = if sigma_scale < 0.0 { 0.0 - sigma_scale } else { sigma_scale }
    Epistemic::measured(k_central, abssig)
}

// ============================================================================
// gg → H K-FACTOR  (gluon fusion via top-quark triangle loop)
//
// LO → NLO correction: K_ggH ≈ 1 + (α_s/α_s(M_Z)) × 1.00
// At μ = M_H ≈ 125 GeV: K ≈ 2.00.  Large because α_s(M_H) ≈ 0.113.
// Scale uncertainty is larger than DY (~3%).
// ============================================================================

/// gg→H K-factor with 3-point renormalization-scale uncertainty.
///
/// # Arguments
/// - `mu0_sq`: Central renormalization scale squared (GeV²).
///
/// # Returns
/// `Epistemic` with val=K_ggH(μ₀), std=σ_scale.
pub fn kfactor_ggh_ep(mu0_sq: f64) -> Epistemic with Div, Panic, Mut {
    let mu0 = sqrt(mu0_sq)
    let mu_up = sqrt(4.0 * mu0_sq)
    let mu_dn = sqrt(mu0_sq / 4.0)
    let as0 = alpha_s_at_mu(mu0).val()
    let as_up = alpha_s_at_mu(mu_up).val()
    let as_dn = alpha_s_at_mu(mu_dn).val()
    let k_central = 1.0 + (as0 / 0.1180) * 1.00
    let k_up = 1.0 + (as_up / 0.1180) * 1.00
    let k_dn = 1.0 + (as_dn / 0.1180) * 1.00
    let sigma_scale = (k_up - k_dn) / 2.0
    let abssig = if sigma_scale < 0.0 { 0.0 - sigma_scale } else { sigma_scale }
    Epistemic::measured(k_central, abssig)
}

// ============================================================================
// qq̄ → tt̄ K-FACTOR
//
// LO → NLO correction: K_tt ≈ 1 + (α_s/α_s(M_Z)) × 0.50
// At μ = m_t ≈ 173 GeV: K ≈ 1.50.
// ============================================================================

/// tt̄ K-factor with 3-point renormalization-scale uncertainty.
///
/// # Arguments
/// - `mu0_sq`: Central renormalization scale squared (GeV²).
///
/// # Returns
/// `Epistemic` with val=K_tt(μ₀), std=σ_scale.
pub fn kfactor_ttbar_ep(mu0_sq: f64) -> Epistemic with Div, Panic, Mut {
    let mu0 = sqrt(mu0_sq)
    let mu_up = sqrt(4.0 * mu0_sq)
    let mu_dn = sqrt(mu0_sq / 4.0)
    let as0 = alpha_s_at_mu(mu0).val()
    let as_up = alpha_s_at_mu(mu_up).val()
    let as_dn = alpha_s_at_mu(mu_dn).val()
    let k_central = 1.0 + (as0 / 0.1180) * 0.50
    let k_up = 1.0 + (as_up / 0.1180) * 0.50
    let k_dn = 1.0 + (as_dn / 0.1180) * 0.50
    let sigma_scale = (k_up - k_dn) / 2.0
    let abssig = if sigma_scale < 0.0 { 0.0 - sigma_scale } else { sigma_scale }
    Epistemic::measured(k_central, abssig)
}

// ============================================================================
// NLO CROSS-SECTIONS: apply K-factor to a LO cross-section
//
// GUM propagation: Var(σ_NLO) = xsec_lo² × Var(K)  (since σ_LO is exact f64)
// ============================================================================

/// Apply Drell-Yan K-factor to a LO cross-section with GUM uncertainty propagation.
///
/// # Arguments
/// - `mu0_sq`: Renormalization scale squared (GeV²).
/// - `xsec_lo`: LO cross-section (any unit, e.g. pb or GeV⁻²).
///
/// # Returns
/// `Epistemic` σ_NLO = K × σ_LO with GUM-propagated scale uncertainty.
pub fn dy_xsec_nlo_ep(mu0_sq: f64, xsec_lo: f64) -> Epistemic with Div, Panic, Mut {
    let k = kfactor_dy_ep(mu0_sq)
    let nlo_val = k.val() * xsec_lo
    let nlo_var = k.variance() * xsec_lo * xsec_lo
    Epistemic::new(nlo_val, nlo_var, k.confidence())
}

/// Apply gg→H K-factor to a LO cross-section with GUM uncertainty propagation.
///
/// # Arguments
/// - `mu0_sq`: Renormalization scale squared (GeV²).
/// - `xsec_lo`: LO cross-section (any unit).
///
/// # Returns
/// `Epistemic` σ_NLO = K × σ_LO with GUM-propagated scale uncertainty.
pub fn ggh_xsec_nlo_ep(mu0_sq: f64, xsec_lo: f64) -> Epistemic with Div, Panic, Mut {
    let k = kfactor_ggh_ep(mu0_sq)
    let nlo_val = k.val() * xsec_lo
    let nlo_var = k.variance() * xsec_lo * xsec_lo
    Epistemic::new(nlo_val, nlo_var, k.confidence())
}

// ============================================================================
// SCALE UNCERTAINTY BAND
// ============================================================================

/// Returns the ±1σ scale variation band as (lower, upper).
///
/// `(k.val() − √Var(k),  k.val() + √Var(k))`
pub fn scale_uncertainty_band(k: Epistemic) -> (f64, f64) with Div, Panic {
    let sigma = nlo_sqrt(k.variance())
    (k.val() - sigma, k.val() + sigma)
}

// ============================================================================
// TESTS
// ============================================================================

var NLO_PASS: [i64; 2] = [0; 2]

fn nlo_chk(pass: bool, id: i64) with Mut, Panic {
    if pass {
        NLO_PASS[0] = NLO_PASS[0] + 1
    } else {
        print("FAIL nlo_kfactor #")
        print_int(id)
        print("\n")
        NLO_PASS[1] = NLO_PASS[1] + 1
    }
}

fn nlo_near(a: f64, b: f64, tol: f64) -> bool {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    ad < tol
}

pub fn run_nlo_kfactor_tests() with Div, Panic, Mut {
    print("=== NLO K-factor Tests ===\n")

    let mz_val = mass_z().val()
    let mz2 = mz_val * mz_val
    let mh_val = mass_h().val()
    let mh2 = mh_val * mh_val

    // T1: DY K-factor at μ=M_Z is ~1.3 (within [1.1, 1.5])
    let k_dy = kfactor_dy_ep(mz2)
    nlo_chk(k_dy.val() > 1.1 && k_dy.val() < 1.5, 1)

    // T2: DY K-factor has positive scale uncertainty (variance > 0)
    nlo_chk(k_dy.variance() > 0.0, 2)

    // T3: ggH K-factor at μ=M_H is ~2.0 (within [1.5, 2.5])
    let k_ggh = kfactor_ggh_ep(mh2)
    nlo_chk(k_ggh.val() > 1.5 && k_ggh.val() < 2.5, 3)

    // T4: ggH K-factor has positive scale uncertainty
    nlo_chk(k_ggh.variance() > 0.0, 4)

    // T5: ggH scale uncertainty larger than DY (ggH has 3× more α_s sensitivity)
    nlo_chk(k_ggh.variance() > k_dy.variance(), 5)

    // T6: ttbar K-factor at μ=m_t is ~1.5 (within [1.2, 1.8])
    let mt_val = mass_top().val()
    let mt2 = mt_val * mt_val
    let k_tt = kfactor_ttbar_ep(mt2)
    nlo_chk(k_tt.val() > 1.2 && k_tt.val() < 1.8, 6)

    // T7: DY NLO xsec > LO (K>1 multiplies positive LO)
    let sigma_lo = 1.0
    let sigma_nlo = dy_xsec_nlo_ep(mz2, sigma_lo)
    nlo_chk(sigma_nlo.val() > sigma_lo, 7)

    // T8: DY NLO xsec has positive scale uncertainty (variance > 0)
    nlo_chk(sigma_nlo.variance() > 0.0, 8)

    // T9: ggH NLO xsec > LO
    let sigma_nlo_h = ggh_xsec_nlo_ep(mh2, 1.0)
    nlo_chk(sigma_nlo_h.val() > 1.0, 9)

    // T10: scale_uncertainty_band returns (low, high) with low < central < high
    let (lo, hi) = scale_uncertainty_band(k_dy)
    nlo_chk(lo < k_dy.val() && k_dy.val() < hi, 10)

    // T11: K-factor at higher scale (larger μ) has smaller K (α_s asymptotic freedom)
    let k_dy_high = kfactor_dy_ep(4.0 * mz2)
    nlo_chk(k_dy_high.val() < k_dy.val(), 11)

    let total = NLO_PASS[0] + NLO_PASS[1]
    print("NLO K-factor: ")
    print_int(NLO_PASS[0])
    print("/")
    print_int(total)
    print(" PASS\n")
}
