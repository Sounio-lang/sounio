// ============================================================================
// STATISTICS — Statistical tools for HEP data analysis
// ============================================================================
//
// Likelihoods, hypothesis testing, confidence intervals, and CLs upper limits.
// Simplified implementations suitable for educational and prototyping use.
//
// References:
// - Cowan, Cranmer, Gross, Vitells, "Asymptotic formulae for likelihood-based tests" (2011)
// - Read, "Modified frequentist analysis of search results" (CLs, 2002)

module particle_physics::statistics

// #1622: these were `extern "C"` bindings to libm. The native backend has no
// dynamic linker, so every call compiled to a stub returning 0. The builtin
// names it does implement (sqrt, exp, log, sin, cos) need no declaration.
use math::libm::{libm_fabs, libm_pow}
// ============================================================================
// Probability Distributions
// ============================================================================

/// Gaussian (normal) PDF evaluated at x.
pub fn gaussian_pdf(x: f64, mu: f64, sigma: f64) -> f64 {
    if sigma <= 0.0 { return 0.0 }
    let pi = 3.141592653589793
    let z = (x - mu) / sigma
    return exp(-0.5 * z * z) / (sigma * sqrt(2.0 * pi))
}

/// Poisson PMF: P(k; lambda) = lambda^k * e^{-lambda} / k!
pub fn poisson_pmf(k: i64, lambda: f64) -> f64 {
    if lambda < 0.0 || k < 0 { return 0.0 }
    if lambda == 0.0 {
        if k == 0 { return 1.0 }
        return 0.0
    }
    var log_p: f64 = 0.0 - lambda + (k as f64) * log(lambda)
    var i: i64 = 1
    while i <= k {
        log_p = log_p - log(i as f64)
        i = i + 1
    }
    return exp(log_p)
}

/// Chi-square PDF with k degrees of freedom, evaluated at x > 0.
pub fn chi2_pdf(x: f64, k: i64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 || k <= 0 { return 0.0 }
    let half_k = (k as f64) * 0.5
    let numer = libm_pow(x, half_k - 1.0) * exp(-x * 0.5)
    let denom = libm_pow(2.0, half_k) * gamma_half_integer(k)
    return numer / denom
}

/// Gamma function for half-integer arguments: Gamma(n/2).
fn gamma_half_integer(n: i64) -> f64 with Mut, Div, Panic {
    let pi = 3.141592653589793
    if n % 2 == 0 {
        let m = n / 2
        var fact: f64 = 1.0
        var i: i64 = 1
        while i < m {
            fact = fact * (i as f64)
            i = i + 1
        }
        return fact
    } else {
        let m = (n - 1) / 2
        var num: f64 = 1.0
        var i: i64 = 1
        while i <= 2 * m {
            num = num * (i as f64)
            i = i + 1
        }
        var den: f64 = 1.0
        i = 1
        while i <= m {
            den = den * (i as f64)
            i = i + 1
        }
        return num / (libm_pow(4.0, m as f64) * den) * sqrt(pi)
    }
}

// ============================================================================
// Likelihoods
// ============================================================================

/// Gaussian (chi-square) log-likelihood for a histogram comparison.
pub fn chi2_log_likelihood(data: &[f64; 64], model: &[f64; 64], n_bins: i64) -> f64 {
    var chi2: f64 = 0.0
    var i: i64 = 0
    while i < n_bins {
        let d = data[i as usize]
        let m = model[i as usize]
        if m > 0.0 {
            let diff = d - m
            chi2 = chi2 + diff * diff / m
        }
        i = i + 1
    }
    return -0.5 * chi2
}

/// Poisson log-likelihood for count data.
pub fn poisson_log_likelihood(data: &[f64; 64], model: &[f64; 64], n_bins: i64) -> f64 with Mut {
    var logL: f64 = 0.0
    var i: i64 = 0
    while i < n_bins {
        let d = data[i as usize]
        let m = model[i as usize]
        if m > 0.0 {
            if d > 0.0 {
                logL = logL + d * log(m) - m - log_gamma(d + 1.0)
            } else {
                logL = logL - m
            }
        }
        i = i + 1
    }
    return logL
}

/// log(Gamma(x+1)) = log(x!) for integer x.
fn log_gamma(x: f64) -> f64 with Mut {
    if x <= 1.0 { return 0.0 }
    var result: f64 = 0.0
    var n: f64 = x
    while n > 1.0 {
        result = result + log(n)
        n = n - 1.0
    }
    return result
}

// ============================================================================
// Profile Likelihood and Hypothesis Testing
// ============================================================================

/// Simple profile likelihood ratio for a single parameter mu.
pub fn profile_likelihood_ratio_counting(n: i64, s: f64, b: f64, mu: f64) -> f64 with Mut {
    if s < 0.0 || b < 0.0 { return 0.0 }
    let lambda_expected = mu * s + b
    var mu_hat = if n as f64 > b { ((n as f64) - b) / s } else { 0.0 }
    if mu_hat < 0.0 { mu_hat = 0.0 }
    let lambda_hat = mu_hat * s + b
    if lambda_expected <= 0.0 || lambda_hat <= 0.0 { return 0.0 }
    let logL_mu = (n as f64) * log(lambda_expected) - lambda_expected
    let logL_hat = (n as f64) * log(lambda_hat) - lambda_hat
    var q = -2.0 * (logL_mu - logL_hat)
    if q < 0.0 { q = 0.0 }
    return q
}

/// p-value from q_mu under the asymptotic approximation (chi-square with 1 DOF).
pub fn p_value_from_qmu(q_mu: f64) -> f64 with Mut, Div, Panic {
    if q_mu <= 0.0 { return 1.0 }
    let approx = exp(-q_mu * 0.5) * sqrt(2.0 / (3.141592653589793 * q_mu))
    if approx > 1.0 { return 1.0 }
    return approx
}

/// CLs = p_{s+b} / p_b for upper limit computation.
pub fn cls_value(n_obs: i64, s: f64, b: f64, mu_test: f64) -> f64 with Mut, Div, Panic {
    let qmu_splusb = profile_likelihood_ratio_counting(n_obs, s, b, mu_test)
    let qmu_bonly = profile_likelihood_ratio_counting(n_obs, s, b, 0.0)
    let psb = p_value_from_qmu(qmu_splusb)
    let pb = p_value_from_qmu(qmu_bonly)
    if pb == 0.0 { return 1.0 }
    return psb / pb
}

/// 95% CL upper limit on signal strength mu. Uses bisection on CLs = 0.05.
pub fn cls_upper_limit(n_obs: i64, s: f64, b: f64) -> f64 with Mut, Div, Panic {
    var mu_low: f64 = 0.0
    var mu_high: f64 = 10.0 * (n_obs as f64 + 1.0) / (s + 0.001)
    var mu_mid: f64 = 0.0
    var i: i64 = 0
    while i < 50 {
        mu_mid = (mu_low + mu_high) * 0.5
        let cls = cls_value(n_obs, s, b, mu_mid)
        if cls < 0.05 {
            mu_high = mu_mid
        } else {
            mu_low = mu_mid
        }
        i = i + 1
    }
    return mu_mid
}

// ============================================================================
// Discovery Significance
// ============================================================================

/// Discovery significance Z for a counting experiment.
pub fn discovery_significance(s: f64, b: f64) -> f64 with Mut, Div, Panic {
    if s <= 0.0 || b <= 0.0 { return 0.0 }
    if b < 5.0 {
        return s / sqrt(b + 0.001)
    }
    let term = (s + b) * log(1.0 + s / b) - s
    if term < 0.0 { return 0.0 }
    return sqrt(2.0 * term)
}

/// Expected median discovery significance.
pub fn expected_discovery_significance(s: f64, b: f64) -> f64 with Mut, Div, Panic {
    return discovery_significance(s, b)
}

// ============================================================================
// Inline tests
// ============================================================================

pub fn test_gaussian_pdf() -> bool {
    let p0 = gaussian_pdf(0.0, 0.0, 1.0)
    let pi = 3.141592653589793
    let expected = 1.0 / sqrt(2.0 * pi)
    if p0 != expected { return false }
    let p_far = gaussian_pdf(5.0, 0.0, 1.0)
    if p_far >= p0 { return false }
    return true
}

pub fn test_poisson_pmf() -> bool with Mut {
    let p0 = poisson_pmf(0, 3.0)
    let expected = exp(-3.0)
    if libm_fabs(p0 - expected) > 1.0e-10 { return false }
    let p3 = poisson_pmf(3, 3.0)
    if p3 < 0.0 || p3 > 1.0 { return false }
    return true
}

pub fn test_chi2_pdf() -> bool with Mut, Div, Panic {
    let p1 = chi2_pdf(1.0, 1)
    if p1 < 0.0 { return false }
    let p2 = chi2_pdf(2.0, 2)
    if p2 < 0.0 { return false }
    return true
}

pub fn test_likelihood_ratio() -> bool with Mut {
    let q = profile_likelihood_ratio_counting(10, 5.0, 2.0, 1.0)
    if q < 0.0 { return false }
    let q_mle = profile_likelihood_ratio_counting(10, 5.0, 2.0, 1.6)
    if q_mle < 0.0 { return false }
    return true
}

pub fn test_cls_value() -> bool with Mut, Div, Panic {
    let cls = cls_value(0, 5.0, 0.5, 1.0)
    if cls < 0.0 || cls > 1.0 { return false }
    return true
}

pub fn test_cls_upper_limit() -> bool with Mut, Div, Panic {
    let ul = cls_upper_limit(5, 3.0, 2.0)
    if ul < 0.0 { return false }
    if ul > 1000.0 { return false }
    return true
}

pub fn test_discovery_significance() -> bool with Mut, Div, Panic {
    let z = discovery_significance(25.0, 100.0)
    if z < 0.0 { return false }
    if z < 2.0 || z > 3.0 { return false }
    return true
}

pub fn test_chi2_likelihood() -> bool {
    var data: [f64; 64] = [0.0; 64]
    data[0 as usize] = 10.0
    data[1 as usize] = 20.0
    data[2 as usize] = 15.0
    var model: [f64; 64] = [0.0; 64]
    model[0 as usize] = 10.0
    model[1 as usize] = 20.0
    model[2 as usize] = 15.0
    let logL = chi2_log_likelihood(&data, &model, 3)
    if logL != 0.0 { return false }
    return true
}
