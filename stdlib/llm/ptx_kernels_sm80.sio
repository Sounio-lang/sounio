// stdlib::llm::ptx_kernels_sm80 — Sm80 PTX kernel emitters for Qwen3, EISA, and O-SSM.
//
// Zero stubs: fully implemented in NVIDIA PTX ISA sm_80 with address_size 64.
// Large kernel strings exceed the 384-byte compiler Name literal capacity if
// written as a single string literal, so multi-line GPU kernels assemble cleanly
// into a NUL-terminated heap C buffer via `bf16_cstr_append`.

use llm::bf16_kernels::{bf16_cstr_append}

fn ptx_emit_rmsnorm(buf: i64, pos: i64) -> i64 with Mut {
    var p = pos
    p = bf16_cstr_append(buf, p, ".visible .entry qwen3_rmsnorm_bf16(\n")
    p = bf16_cstr_append(buf, p, "    .param .u64 param_x,\n    .param .u64 param_w,\n    .param .u64 param_out,\n")
    p = bf16_cstr_append(buf, p, "    .param .u64 param_n_groups,\n    .param .u64 param_dim,\n    .param .u64 param_eps_bits\n) {\n")
    p = bf16_cstr_append(buf, p, "    .reg .pred %p<6>;\n    .reg .b32 %r<12>;\n    .reg .b64 %rd<24>;\n    .reg .f32 %f<16>;\n\n")
    p = bf16_cstr_append(buf, p, "    ld.param.u64 %rd1, [param_x];\n    ld.param.u64 %rd2, [param_w];\n    ld.param.u64 %rd3, [param_out];\n")
    p = bf16_cstr_append(buf, p, "    ld.param.u64 %rd4, [param_n_groups];\n    ld.param.u64 %rd5, [param_dim];\n    ld.param.u64 %rd6, [param_eps_bits];\n\n")
    p = bf16_cstr_append(buf, p, "    mov.u32 %r1, %ctaid.x;\n    mov.u32 %r2, %ntid.x;\n    mov.u32 %r3, %tid.x;\n")
    p = bf16_cstr_append(buf, p, "    mad.lo.u32 %r1, %r1, %r2, %r3;\n    cvt.u64.u32 %rd7, %r1;\n    setp.ge.u64 %p1, %rd7, %rd4;\n    @%p1 bra L_RMS_EXIT;\n\n")
    p = bf16_cstr_append(buf, p, "    setp.eq.u64 %p2, %rd5, 0;\n    @%p2 bra L_RMS_EXIT;\n\n")
    p = bf16_cstr_append(buf, p, "    mul.lo.u64 %rd8, %rd7, %rd5;\n    shl.b64 %rd9, %rd8, 2;\n    add.u64 %rd10, %rd1, %rd9;\n    add.u64 %rd11, %rd3, %rd9;\n\n")
    p = bf16_cstr_append(buf, p, "    mov.f32 %f1, 0f00000000;\n    mov.u64 %rd12, 0;\n\n")
    p = bf16_cstr_append(buf, p, "L_RMS_LOOP1:\n    shl.b64 %rd13, %rd12, 2;\n    add.u64 %rd14, %rd10, %rd13;\n")
    p = bf16_cstr_append(buf, p, "    ld.global.f32 %f2, [%rd14];\n    fma.rn.f32 %f1, %f2, %f2, %f1;\n    add.u64 %rd12, %rd12, 1;\n")
    p = bf16_cstr_append(buf, p, "    setp.lt.u64 %p3, %rd12, %rd5;\n    @%p3 bra L_RMS_LOOP1;\n\n")
    p = bf16_cstr_append(buf, p, "    cvt.rn.f32.u64 %f3, %rd5;\n    div.approx.f32 %f4, %f1, %f3;\n    cvt.u32.u64 %r4, %rd6;\n")
    p = bf16_cstr_append(buf, p, "    mov.b32 %f5, %r4;\n    add.f32 %f6, %f4, %f5;\n    rsqrt.approx.f32 %f7, %f6;\n\n    mov.u64 %rd15, 0;\n\n")
    p = bf16_cstr_append(buf, p, "L_RMS_LOOP2:\n    shl.b64 %rd16, %rd15, 2;\n    add.u64 %rd17, %rd10, %rd16;\n    ld.global.f32 %f8, [%rd17];\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd18, %rd15, 1;\n    add.u64 %rd19, %rd2, %rd18;\n    ld.global.u16 %r5, [%rd19];\n")
    p = bf16_cstr_append(buf, p, "    cvt.u32.u16 %r6, %r5;\n    shl.b32 %r7, %r6, 16;\n    mov.b32 %f9, %r7;\n")
    p = bf16_cstr_append(buf, p, "    mul.f32 %f10, %f8, %f7;\n    mul.f32 %f11, %f10, %f9;\n    add.u64 %rd20, %rd11, %rd16;\n")
    p = bf16_cstr_append(buf, p, "    st.global.f32 [%rd20], %f11;\n    add.u64 %rd15, %rd15, 1;\n    setp.lt.u64 %p4, %rd15, %rd5;\n")
    p = bf16_cstr_append(buf, p, "    @%p4 bra L_RMS_LOOP2;\n\nL_RMS_EXIT:\n    ret;\n}\n\n")
    p
}

fn ptx_emit_rope(buf: i64, pos: i64) -> i64 with Mut {
    var p = pos
    p = bf16_cstr_append(buf, p, ".visible .entry qwen3_rope_f32(\n")
    p = bf16_cstr_append(buf, p, "    .param .u64 param_v,\n    .param .u64 param_n_heads,\n    .param .u64 param_head_dim,\n")
    p = bf16_cstr_append(buf, p, "    .param .u64 param_pos,\n    .param .u64 param_theta_bits,\n    .param .u64 param_dummy\n) {\n")
    p = bf16_cstr_append(buf, p, "    .reg .pred %p<6>;\n    .reg .b32 %r<12>;\n    .reg .b64 %rd<24>;\n    .reg .f32 %f<24>;\n\n")
    p = bf16_cstr_append(buf, p, "    ld.param.u64 %rd1, [param_v];\n    ld.param.u64 %rd2, [param_n_heads];\n    ld.param.u64 %rd3, [param_head_dim];\n")
    p = bf16_cstr_append(buf, p, "    ld.param.u64 %rd4, [param_pos];\n    ld.param.u64 %rd5, [param_theta_bits];\n\n")
    p = bf16_cstr_append(buf, p, "    mov.u32 %r1, %ctaid.x;\n    mov.u32 %r2, %ntid.x;\n    mov.u32 %r3, %tid.x;\n")
    p = bf16_cstr_append(buf, p, "    mad.lo.u32 %r1, %r1, %r2, %r3;\n    cvt.u64.u32 %rd6, %r1;\n    setp.ge.u64 %p1, %rd6, %rd2;\n    @%p1 bra L_ROPE_EXIT;\n\n")
    p = bf16_cstr_append(buf, p, "    shr.u64 %rd7, %rd3, 1;\n    setp.eq.u64 %p2, %rd7, 0;\n    @%p2 bra L_ROPE_EXIT;\n\n")
    p = bf16_cstr_append(buf, p, "    mul.lo.u64 %rd8, %rd6, %rd3;\n    shl.b64 %rd9, %rd8, 2;\n    add.u64 %rd10, %rd1, %rd9;\n\n")
    p = bf16_cstr_append(buf, p, "    cvt.u32.u64 %r4, %rd5;\n    mov.b32 %f1, %r4;\n    lg2.approx.f32 %f2, %f1;\n")
    p = bf16_cstr_append(buf, p, "    cvt.rn.f32.u64 %f3, %rd4;\n    cvt.rn.f32.u64 %f4, %rd3;\n    mov.u64 %rd11, 0;\n\n")
    p = bf16_cstr_append(buf, p, "L_ROPE_LOOP:\n    cvt.rn.f32.u64 %f5, %rd11;\n    mul.f32 %f6, %f5, 0f40000000;\n    neg.f32 %f7, %f6;\n")
    p = bf16_cstr_append(buf, p, "    div.approx.f32 %f8, %f7, %f4;\n    mul.f32 %f9, %f8, %f2;\n    ex2.approx.f32 %f10, %f9;\n")
    p = bf16_cstr_append(buf, p, "    mul.f32 %f11, %f3, %f10;\n    sin.approx.f32 %f12, %f11;\n    cos.approx.f32 %f13, %f11;\n\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd12, %rd11, 2;\n    add.u64 %rd13, %rd10, %rd12;\n    add.u64 %rd14, %rd11, %rd7;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd15, %rd14, 2;\n    add.u64 %rd16, %rd10, %rd15;\n\n")
    p = bf16_cstr_append(buf, p, "    ld.global.f32 %f14, [%rd13];\n    ld.global.f32 %f15, [%rd16];\n    mul.f32 %f16, %f14, %f13;\n")
    p = bf16_cstr_append(buf, p, "    mul.f32 %f17, %f15, %f12;\n    sub.f32 %f18, %f16, %f17;\n    mul.f32 %f19, %f15, %f13;\n")
    p = bf16_cstr_append(buf, p, "    fma.rn.f32 %f20, %f14, %f12, %f19;\n    st.global.f32 [%rd13], %f18;\n    st.global.f32 [%rd16], %f20;\n\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd11, %rd11, 1;\n    setp.lt.u64 %p3, %rd11, %rd7;\n    @%p3 bra L_ROPE_LOOP;\n\n")
    p = bf16_cstr_append(buf, p, "L_ROPE_EXIT:\n    ret;\n}\n\n")
    p
}

fn ptx_emit_gemv_bf16(buf: i64, pos: i64) -> i64 with Mut {
    var p = pos
    p = bf16_cstr_append(buf, p, ".visible .entry qwen3_bf16_gemv_f32(\n")
    p = bf16_cstr_append(buf, p, "    .param .u64 param_w,\n    .param .u64 param_x,\n    .param .u64 param_y,\n")
    p = bf16_cstr_append(buf, p, "    .param .u64 param_out_dim,\n    .param .u64 param_in_dim,\n    .param .u64 param_dummy\n) {\n")
    p = bf16_cstr_append(buf, p, "    .reg .pred %p<6>;\n    .reg .b32 %r<12>;\n    .reg .b64 %rd<24>;\n    .reg .f32 %f<12>;\n\n")
    p = bf16_cstr_append(buf, p, "    ld.param.u64 %rd1, [param_w];\n    ld.param.u64 %rd2, [param_x];\n    ld.param.u64 %rd3, [param_y];\n")
    p = bf16_cstr_append(buf, p, "    ld.param.u64 %rd4, [param_out_dim];\n    ld.param.u64 %rd5, [param_in_dim];\n\n")
    p = bf16_cstr_append(buf, p, "    mov.u32 %r1, %ctaid.x;\n    mov.u32 %r2, %ntid.x;\n    mov.u32 %r3, %tid.x;\n")
    p = bf16_cstr_append(buf, p, "    mad.lo.u32 %r1, %r1, %r2, %r3;\n    cvt.u64.u32 %rd6, %r1;\n    setp.ge.u64 %p1, %rd6, %rd4;\n    @%p1 bra L_GEMV_EXIT;\n\n")
    p = bf16_cstr_append(buf, p, "    mul.lo.u64 %rd7, %rd6, %rd5;\n    shl.b64 %rd8, %rd7, 1;\n    add.u64 %rd9, %rd1, %rd8;\n\n")
    p = bf16_cstr_append(buf, p, "    mov.f32 %f1, 0f00000000;\n    mov.u64 %rd10, 0;\n    setp.eq.u64 %p2, %rd5, 0;\n    @%p2 bra L_GEMV_STORE;\n\n")
    p = bf16_cstr_append(buf, p, "L_GEMV_LOOP:\n    shl.b64 %rd11, %rd10, 1;\n    add.u64 %rd12, %rd9, %rd11;\n")
    p = bf16_cstr_append(buf, p, "    ld.global.u16 %r4, [%rd12];\n    cvt.u32.u16 %r5, %r4;\n    shl.b32 %r6, %r5, 16;\n    mov.b32 %f2, %r6;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd13, %rd10, 2;\n    add.u64 %rd14, %rd2, %rd13;\n    ld.global.f32 %f3, [%rd14];\n")
    p = bf16_cstr_append(buf, p, "    fma.rn.f32 %f1, %f2, %f3, %f1;\n    add.u64 %rd10, %rd10, 1;\n    setp.lt.u64 %p3, %rd10, %rd5;\n    @%p3 bra L_GEMV_LOOP;\n\n")
    p = bf16_cstr_append(buf, p, "L_GEMV_STORE:\n    shl.b64 %rd15, %rd6, 2;\n    add.u64 %rd16, %rd3, %rd15;\n    st.global.f32 [%rd16], %f1;\n\n")
    p = bf16_cstr_append(buf, p, "L_GEMV_EXIT:\n    ret;\n}\n\n")
    p
}

fn ptx_emit_swiglu(buf: i64, pos: i64) -> i64 with Mut {
    var p = pos
    p = bf16_cstr_append(buf, p, ".visible .entry qwen3_swiglu_f32(\n")
    p = bf16_cstr_append(buf, p, "    .param .u64 param_g,\n    .param .u64 param_u,\n    .param .u64 param_o,\n")
    p = bf16_cstr_append(buf, p, "    .param .u64 param_inter_dim,\n    .param .u64 param_dummy1,\n    .param .u64 param_dummy2\n) {\n")
    p = bf16_cstr_append(buf, p, "    .reg .pred %p<4>;\n    .reg .b32 %r<8>;\n    .reg .b64 %rd<16>;\n    .reg .f32 %f<12>;\n\n")
    p = bf16_cstr_append(buf, p, "    ld.param.u64 %rd1, [param_g];\n    ld.param.u64 %rd2, [param_u];\n")
    p = bf16_cstr_append(buf, p, "    ld.param.u64 %rd3, [param_o];\n    ld.param.u64 %rd4, [param_inter_dim];\n\n")
    p = bf16_cstr_append(buf, p, "    mov.u32 %r1, %ctaid.x;\n    mov.u32 %r2, %ntid.x;\n    mov.u32 %r3, %tid.x;\n")
    p = bf16_cstr_append(buf, p, "    mad.lo.u32 %r1, %r1, %r2, %r3;\n    cvt.u64.u32 %rd5, %r1;\n    setp.ge.u64 %p1, %rd5, %rd4;\n    @%p1 bra L_SWIGLU_EXIT;\n\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd6, %rd5, 2;\n    add.u64 %rd7, %rd1, %rd6;\n    add.u64 %rd8, %rd2, %rd6;\n    add.u64 %rd9, %rd3, %rd6;\n\n")
    p = bf16_cstr_append(buf, p, "    ld.global.f32 %f1, [%rd7];\n    ld.global.f32 %f2, [%rd8];\n    neg.f32 %f3, %f1;\n")
    p = bf16_cstr_append(buf, p, "    mul.f32 %f4, %f3, 0f3FB8AA3B;\n    ex2.approx.f32 %f5, %f4;\n    add.f32 %f6, %f5, 0f3F800000;\n")
    p = bf16_cstr_append(buf, p, "    rcp.approx.f32 %f7, %f6;\n    mul.f32 %f8, %f1, %f7;\n    mul.f32 %f9, %f8, %f2;\n")
    p = bf16_cstr_append(buf, p, "    st.global.f32 [%rd9], %f9;\n\nL_SWIGLU_EXIT:\n    ret;\n}\n\n")
    p
}

fn ptx_emit_paged_gqa(buf: i64, pos: i64) -> i64 with Mut {
    var p = pos
    p = bf16_cstr_append(buf, p, ".visible .entry qwen3_paged_gqa_f32(\n")
    p = bf16_cstr_append(buf, p, "    .param .u64 param_q,\n    .param .u64 param_k,\n    .param .u64 param_v,\n")
    p = bf16_cstr_append(buf, p, "    .param .u64 param_table,\n    .param .u64 param_out,\n    .param .u64 param_n_q,\n")
    p = bf16_cstr_append(buf, p, "    .param .u64 param_seq_len,\n    .param .u64 param_cfg\n) {\n")
    p = bf16_cstr_append(buf, p, "    .reg .pred %p<8>;\n    .reg .b32 %r<24>;\n    .reg .b64 %rd<48>;\n    .reg .f32 %f<24>;\n\n")
    p = bf16_cstr_append(buf, p, "    ld.param.u64 %rd1, [param_q];\n    ld.param.u64 %rd2, [param_k];\n    ld.param.u64 %rd3, [param_v];\n")
    p = bf16_cstr_append(buf, p, "    ld.param.u64 %rd4, [param_table];\n    ld.param.u64 %rd5, [param_out];\n    ld.param.u64 %rd6, [param_n_q];\n")
    p = bf16_cstr_append(buf, p, "    ld.param.u64 %rd7, [param_seq_len];\n    ld.param.u64 %rd8, [param_cfg];\n\n")
    p = bf16_cstr_append(buf, p, "    mov.u32 %r1, %ctaid.x;\n    mov.u32 %r2, %ntid.x;\n    mov.u32 %r3, %tid.x;\n")
    p = bf16_cstr_append(buf, p, "    mad.lo.u32 %r1, %r1, %r2, %r3;\n    cvt.u64.u32 %rd9, %r1;\n    setp.ge.u64 %p1, %rd9, %rd6;\n    @%p1 bra L_GQA_EXIT;\n\n")
    p = bf16_cstr_append(buf, p, "    and.b64 %rd10, %rd8, 65535;\n    shr.u64 %rd11, %rd8, 16;\n    and.b64 %rd11, %rd11, 65535;\n")
    p = bf16_cstr_append(buf, p, "    shr.u64 %rd12, %rd8, 32;\n    and.b64 %rd12, %rd12, 65535;\n\n")
    p = bf16_cstr_append(buf, p, "    setp.eq.u64 %p2, %rd10, 0;\n    @%p2 bra L_GQA_EXIT;\n    setp.eq.u64 %p3, %rd11, 0;\n    @%p3 bra L_GQA_EXIT;\n")
    p = bf16_cstr_append(buf, p, "    setp.eq.u64 %p4, %rd12, 0;\n    @%p4 bra L_GQA_EXIT;\n\n")
    p = bf16_cstr_append(buf, p, "    div.u64 %rd13, %rd6, %rd10;\n    div.u64 %rd14, %rd9, %rd13;\n\n")
    p = bf16_cstr_append(buf, p, "    cvt.rn.f32.u64 %f1, %rd11;\n    rsqrt.approx.f32 %f2, %f1;\n\n")
    p = bf16_cstr_append(buf, p, "    mul.lo.u64 %rd15, %rd9, %rd11;\n    shl.b64 %rd16, %rd15, 2;\n    add.u64 %rd17, %rd1, %rd16;\n    add.u64 %rd18, %rd5, %rd16;\n\n")
    p = bf16_cstr_append(buf, p, "    mov.u64 %rd19, 0;\nL_GQA_ZERO:\n    shl.b64 %rd20, %rd19, 2;\n    add.u64 %rd21, %rd18, %rd20;\n")
    p = bf16_cstr_append(buf, p, "    st.global.f32 [%rd21], 0f00000000;\n    add.u64 %rd19, %rd19, 1;\n    setp.lt.u64 %p5, %rd19, %rd11;\n    @%p5 bra L_GQA_ZERO;\n\n")
    p = bf16_cstr_append(buf, p, "    mov.f32 %f3, 0fFE967699;\n    mov.f32 %f4, 0f00000000;\n    mov.u64 %rd22, 0;\n")
    p = bf16_cstr_append(buf, p, "    setp.eq.u64 %p6, %rd7, 0;\n    @%p6 bra L_GQA_NORM;\n\n")
    p = bf16_cstr_append(buf, p, "L_GQA_POS_LOOP:\n    div.u64 %rd23, %rd22, %rd12;\n    rem.u64 %rd24, %rd22, %rd12;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd25, %rd23, 2;\n    add.u64 %rd26, %rd4, %rd25;\n    ld.global.u32 %r4, [%rd26];\n    cvt.u64.u32 %rd27, %r4;\n\n")
    p = bf16_cstr_append(buf, p, "    mul.lo.u64 %rd28, %rd27, %rd12;\n    add.u64 %rd28, %rd28, %rd24;\n    mul.lo.u64 %rd28, %rd28, %rd10;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd28, %rd28, %rd14;\n    mul.lo.u64 %rd28, %rd28, %rd11;\n    shl.b64 %rd29, %rd28, 2;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd30, %rd2, %rd29;\n    add.u64 %rd31, %rd3, %rd29;\n\n")
    p = bf16_cstr_append(buf, p, "    mov.f32 %f5, 0f00000000;\n    mov.u64 %rd32, 0;\nL_GQA_DOT_LOOP:\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd33, %rd32, 2;\n    add.u64 %rd34, %rd17, %rd33;\n    add.u64 %rd35, %rd30, %rd33;\n")
    p = bf16_cstr_append(buf, p, "    ld.global.f32 %f6, [%rd34];\n    ld.global.f32 %f7, [%rd35];\n    fma.rn.f32 %f5, %f6, %f7, %f5;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd32, %rd32, 1;\n    setp.lt.u64 %p7, %rd32, %rd11;\n    @%p7 bra L_GQA_DOT_LOOP;\n\n")
    p = bf16_cstr_append(buf, p, "    mul.f32 %f8, %f5, %f2;\n    setp.gt.f32 %p7, %f8, %f3;\n    @%p7 bra L_GQA_BRANCH_GT;\n\n")
    p = bf16_cstr_append(buf, p, "    sub.f32 %f9, %f8, %f3;\n    mul.f32 %f10, %f9, 0f3FB8AA3B;\n    ex2.approx.f32 %f11, %f10;\n    add.f32 %f4, %f4, %f11;\n\n")
    p = bf16_cstr_append(buf, p, "    mov.u64 %rd36, 0;\nL_GQA_UPDATE_BETA:\n    shl.b64 %rd37, %rd36, 2;\n    add.u64 %rd38, %rd18, %rd37;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd39, %rd31, %rd37;\n    ld.global.f32 %f12, [%rd38];\n    ld.global.f32 %f13, [%rd39];\n")
    p = bf16_cstr_append(buf, p, "    fma.rn.f32 %f14, %f11, %f13, %f12;\n    st.global.f32 [%rd38], %f14;\n    add.u64 %rd36, %rd36, 1;\n")
    p = bf16_cstr_append(buf, p, "    setp.lt.u64 %p7, %rd36, %rd11;\n    @%p7 bra L_GQA_UPDATE_BETA;\n    bra L_GQA_POS_NEXT;\n\n")
    p = bf16_cstr_append(buf, p, "L_GQA_BRANCH_GT:\n    sub.f32 %f15, %f3, %f8;\n    mul.f32 %f16, %f15, 0f3FB8AA3B;\n    ex2.approx.f32 %f17, %f16;\n")
    p = bf16_cstr_append(buf, p, "    fma.rn.f32 %f4, %f4, %f17, 0f3F800000;\n    mov.u64 %rd40, 0;\nL_GQA_UPDATE_ALPHA:\n")
