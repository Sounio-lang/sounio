    p = bf16_cstr_append(buf, p, "    mul.f32 %f99, %f42, %f83; add.f32 %f91, %f91, %f99;\n    mul.f32 %f99, %f43, %f82; sub.f32 %f91, %f91, %f99;\n")
    p = bf16_cstr_append(buf, p, "    mul.f32 %f99, %f44, %f85; add.f32 %f91, %f91, %f99;\n    mul.f32 %f99, %f45, %f84; sub.f32 %f91, %f91, %f99;\n")
    p = bf16_cstr_append(buf, p, "    mul.f32 %f99, %f46, %f87; sub.f32 %f91, %f91, %f99;\n    mul.f32 %f99, %f47, %f86; add.f32 %f91, %f91, %f99;\n\n")

    p = bf16_cstr_append(buf, p, "    mul.f32 %f92, %f40, %f82;\n    mul.f32 %f99, %f41, %f83; sub.f32 %f92, %f92, %f99;\n")
    p = bf16_cstr_append(buf, p, "    mul.f32 %f99, %f42, %f80; add.f32 %f92, %f92, %f99;\n    mul.f32 %f99, %f43, %f81; add.f32 %f92, %f92, %f99;\n")
    p = bf16_cstr_append(buf, p, "    mul.f32 %f99, %f44, %f86; add.f32 %f92, %f92, %f99;\n    mul.f32 %f99, %f45, %f87; add.f32 %f92, %f92, %f99;\n")
    p = bf16_cstr_append(buf, p, "    mul.f32 %f99, %f46, %f84; sub.f32 %f92, %f92, %f99;\n    mul.f32 %f99, %f47, %f85; sub.f32 %f92, %f92, %f99;\n\n")

    p = bf16_cstr_append(buf, p, "    mul.f32 %f93, %f40, %f83;\n    mul.f32 %f99, %f41, %f82; add.f32 %f93, %f93, %f99;\n")
    p = bf16_cstr_append(buf, p, "    mul.f32 %f99, %f42, %f81; sub.f32 %f93, %f93, %f99;\n    mul.f32 %f99, %f43, %f80; add.f32 %f93, %f93, %f99;\n")
    p = bf16_cstr_append(buf, p, "    mul.f32 %f99, %f44, %f87; add.f32 %f93, %f93, %f99;\n    mul.f32 %f99, %f45, %f86; sub.f32 %f93, %f93, %f99;\n")
    p = bf16_cstr_append(buf, p, "    mul.f32 %f99, %f46, %f85; add.f32 %f93, %f93, %f99;\n    mul.f32 %f99, %f47, %f84; sub.f32 %f93, %f93, %f99;\n\n")

    p = bf16_cstr_append(buf, p, "    mul.f32 %f94, %f40, %f84;\n    mul.f32 %f99, %f41, %f85; sub.f32 %f94, %f94, %f99;\n")
    p = bf16_cstr_append(buf, p, "    mul.f32 %f99, %f42, %f86; sub.f32 %f94, %f94, %f99;\n    mul.f32 %f99, %f43, %f87; sub.f32 %f94, %f94, %f99;\n")
    p = bf16_cstr_append(buf, p, "    mul.f32 %f99, %f44, %f80; add.f32 %f94, %f94, %f99;\n    mul.f32 %f99, %f45, %f81; add.f32 %f94, %f94, %f99;\n")
    p = bf16_cstr_append(buf, p, "    mul.f32 %f99, %f46, %f82; add.f32 %f94, %f94, %f99;\n    mul.f32 %f99, %f47, %f83; add.f32 %f94, %f94, %f99;\n\n")

    p = bf16_cstr_append(buf, p, "    mul.f32 %f95, %f40, %f85;\n    mul.f32 %f99, %f41, %f84; add.f32 %f95, %f95, %f99;\n")
    p = bf16_cstr_append(buf, p, "    mul.f32 %f99, %f42, %f87; sub.f32 %f95, %f95, %f99;\n    mul.f32 %f99, %f43, %f86; add.f32 %f95, %f95, %f99;\n")
    p = bf16_cstr_append(buf, p, "    mul.f32 %f99, %f44, %f81; sub.f32 %f95, %f95, %f99;\n    mul.f32 %f99, %f45, %f80; add.f32 %f95, %f95, %f99;\n")
    p = bf16_cstr_append(buf, p, "    mul.f32 %f99, %f46, %f83; sub.f32 %f95, %f95, %f99;\n    mul.f32 %f99, %f47, %f82; add.f32 %f95, %f95, %f99;\n\n")

    p = bf16_cstr_append(buf, p, "    mul.f32 %f96, %f40, %f86;\n    mul.f32 %f99, %f41, %f87; add.f32 %f96, %f96, %f99;\n")
    p = bf16_cstr_append(buf, p, "    mul.f32 %f99, %f42, %f84; add.f32 %f96, %f96, %f99;\n    mul.f32 %f99, %f43, %f85; sub.f32 %f96, %f96, %f99;\n")
    p = bf16_cstr_append(buf, p, "    mul.f32 %f99, %f44, %f82; sub.f32 %f96, %f96, %f99;\n    mul.f32 %f99, %f45, %f83; add.f32 %f96, %f96, %f99;\n")
    p = bf16_cstr_append(buf, p, "    mul.f32 %f99, %f46, %f80; add.f32 %f96, %f96, %f99;\n    mul.f32 %f99, %f47, %f81; sub.f32 %f96, %f96, %f99;\n\n")

    p = bf16_cstr_append(buf, p, "    mul.f32 %f97, %f40, %f87;\n    mul.f32 %f99, %f41, %f86; sub.f32 %f97, %f97, %f99;\n")
    p = bf16_cstr_append(buf, p, "    mul.f32 %f99, %f42, %f85; add.f32 %f97, %f97, %f99;\n    mul.f32 %f99, %f43, %f84; add.f32 %f97, %f97, %f99;\n")
    p = bf16_cstr_append(buf, p, "    mul.f32 %f99, %f44, %f83; sub.f32 %f97, %f97, %f99;\n    mul.f32 %f99, %f45, %f82; sub.f32 %f97, %f97, %f99;\n")
    p = bf16_cstr_append(buf, p, "    mul.f32 %f99, %f46, %f81; add.f32 %f97, %f97, %f99;\n    mul.f32 %f99, %f47, %f80; add.f32 %f97, %f97, %f99;\n\n")

    p = bf16_cstr_append(buf, p, "    st.global.f32 [%rd17], %f90;\n    st.global.f32 [%rd17+4], %f91;\n")
    p = bf16_cstr_append(buf, p, "    st.global.f32 [%rd17+8], %f92;\n    st.global.f32 [%rd17+12], %f93;\n")
    p = bf16_cstr_append(buf, p, "    st.global.f32 [%rd17+16], %f94;\n    st.global.f32 [%rd17+20], %f95;\n")
    p = bf16_cstr_append(buf, p, "    st.global.f32 [%rd17+24], %f96;\n    st.global.f32 [%rd17+28], %f97;\n\n")

    p = bf16_cstr_append(buf, p, "L_OSSM_EXIT:\n    ret;\n}\n\n")
    p
}

pub fn emit_qwen3_ptx_sm80_cstr() -> i64 with Alloc, Mut {
    let buf = heap_alloc(32768) as i64
    var p: i64 = 0
    p = bf16_cstr_append(buf, p, ".version 8.0\n.target sm_80\n.address_size 64\n\n")
    p = ptx_emit_rmsnorm(buf, p)
    p = ptx_emit_rope(buf, p)
    p = ptx_emit_gemv_bf16(buf, p)
    p = ptx_emit_swiglu(buf, p)
    p = ptx_emit_paged_gqa(buf, p)
    buf
}

pub fn emit_eisa_ptx_sm80_cstr() -> i64 with Alloc, Mut {
    let buf = heap_alloc(32768) as i64
    var p: i64 = 0
    p = bf16_cstr_append(buf, p, ".version 8.0\n.target sm_80\n.address_size 64\n\n")
    p = ptx_emit_gemv_q4_eisa(buf, p)
    p = ptx_emit_gemv_q8_eisa(buf, p)
    buf
}

pub fn emit_ossm_ptx_sm80_cstr() -> i64 with Alloc, Mut {
    let buf = heap_alloc(32768) as i64
    var p: i64 = 0
    p = bf16_cstr_append(buf, p, ".version 8.0\n.target sm_80\n.address_size 64\n\n")
    p = ptx_emit_ossm_step(buf, p)
    buf
}

fn ptx_cr_warp_sum_f32(buf: i64, pos: i64, f_acc: string, r_tmp0: string, r_tmp1: string, f_tmp: string) -> i64 with Mut {
    var p = pos
    var d: i64 = 16
    while d >= 1 {
        p = bf16_cstr_append(buf, p, "    mov.b32 ")
        p = bf16_cstr_append(buf, p, r_tmp0)
        p = bf16_cstr_append(buf, p, ", ")
        p = bf16_cstr_append(buf, p, f_acc)
        p = bf16_cstr_append(buf, p, "; shfl.sync.bfly.b32 ")
        p = bf16_cstr_append(buf, p, r_tmp1)
        p = bf16_cstr_append(buf, p, ", ")
        p = bf16_cstr_append(buf, p, r_tmp0)
        p = bf16_cstr_append(buf, p, ", ")
        if d == 16 { p = bf16_cstr_append(buf, p, "16") }
        else if d == 8 { p = bf16_cstr_append(buf, p, "8") }
        else if d == 4 { p = bf16_cstr_append(buf, p, "4") }
        else if d == 2 { p = bf16_cstr_append(buf, p, "2") }
        else { p = bf16_cstr_append(buf, p, "1") }
        p = bf16_cstr_append(buf, p, ", 31, 0xffffffff; mov.b32 ")
        p = bf16_cstr_append(buf, p, f_tmp)
        p = bf16_cstr_append(buf, p, ", ")
        p = bf16_cstr_append(buf, p, r_tmp1)
        p = bf16_cstr_append(buf, p, "; add.rn.ftz.f32 ")
        p = bf16_cstr_append(buf, p, f_acc)
        p = bf16_cstr_append(buf, p, ", ")
        p = bf16_cstr_append(buf, p, f_acc)
        p = bf16_cstr_append(buf, p, ", ")
        p = bf16_cstr_append(buf, p, f_tmp)
        p = bf16_cstr_append(buf, p, ";\n")
        d = d / 2
    }
    p
}

fn ptx_cr_emit_sounio_exp(buf: i64, pos: i64) -> i64 with Mut {
    var p = pos
    p = bf16_cstr_append(buf, p, "// Sounio v2 Float Model: binary32, round-to-nearest-even, FTZ+DAZ, fixed op order\n")
    p = bf16_cstr_append(buf, p, "// Exclusion: fma(a, b, c) with |exact(a*b + c)| in (2^-126 - 2^-150, 2^-126)\n")
    p = bf16_cstr_append(buf, p, ".func (.reg .f32 res) sounio_exp_f32(.reg .f32 x) {\n")
    p = bf16_cstr_append(buf, p, "    .reg .pred %p<4>; .reg .b32 %r<4>; .reg .s32 %rs<5>; .reg .f32 %f<10>;\n")
    p = bf16_cstr_append(buf, p, "    setp.nan.ftz.f32 %p1, x, x;\n")
    p = bf16_cstr_append(buf, p, "    @%p1 mov.f32 res, x;\n")
    p = bf16_cstr_append(buf, p, "    @%p1 bra L_SE_DONE;\n")
    p = bf16_cstr_append(buf, p, "    setp.le.ftz.f32 %p2, x, 0fC2AEAC50;\n")
    p = bf16_cstr_append(buf, p, "    @%p2 mov.f32 res, 0f00000000;\n")
    p = bf16_cstr_append(buf, p, "    @%p2 bra L_SE_DONE;\n")
    p = bf16_cstr_append(buf, p, "    setp.ge.ftz.f32 %p3, x, 0f42B17218;\n")
    p = bf16_cstr_append(buf, p, "    @%p3 mov.f32 res, 0f7F800000;\n")
    p = bf16_cstr_append(buf, p, "    @%p3 bra L_SE_DONE;\n")
    p = bf16_cstr_append(buf, p, "    fma.rn.ftz.f32 %f1, x, 0f3FB8AA3B, 0f4B400000;\n")
    p = bf16_cstr_append(buf, p, "    mov.b32 %r1, %f1;\n")
    p = bf16_cstr_append(buf, p, "    sub.u32 %r2, %r1, 0x4b400000;\n")
    p = bf16_cstr_append(buf, p, "    mov.b32 %rs1, %r2;\n")
    p = bf16_cstr_append(buf, p, "    sub.rn.ftz.f32 %f2, %f1, 0f4B400000;\n")
    p = bf16_cstr_append(buf, p, "    fma.rn.ftz.f32 %f3, %f2, 0fBF317200, x;\n")
    p = bf16_cstr_append(buf, p, "    fma.rn.ftz.f32 %f3, %f2, 0fB5BFBE8E, %f3;\n")
    p = bf16_cstr_append(buf, p, "    fma.rn.ftz.f32 %f4, 0f3AB6DA02, %f3, 0f3C091D98;\n")
    p = bf16_cstr_append(buf, p, "    fma.rn.ftz.f32 %f4, %f4, %f3, 0f3D2AAA2F;\n")
    p = bf16_cstr_append(buf, p, "    fma.rn.ftz.f32 %f4, %f4, %f3, 0f3E2AAA48;\n")
    p = bf16_cstr_append(buf, p, "    fma.rn.ftz.f32 %f4, %f4, %f3, 0f3F000000;\n")
    p = bf16_cstr_append(buf, p, "    fma.rn.ftz.f32 %f4, %f4, %f3, 0f3F800000;\n")
    p = bf16_cstr_append(buf, p, "    fma.rn.ftz.f32 %f4, %f4, %f3, 0f3F800000;\n")
    p = bf16_cstr_append(buf, p, "    shr.s32 %rs2, %rs1, 1;\n")
    p = bf16_cstr_append(buf, p, "    sub.s32 %rs3, %rs1, %rs2;\n")
    p = bf16_cstr_append(buf, p, "    add.s32 %rs2, %rs2, 127; mov.b32 %r2, %rs2; shl.b32 %r2, %r2, 23; mov.b32 %f5, %r2;\n")
    p = bf16_cstr_append(buf, p, "    add.s32 %rs3, %rs3, 127; mov.b32 %r3, %rs3; shl.b32 %r3, %r3, 23; mov.b32 %f6, %r3;\n")
    p = bf16_cstr_append(buf, p, "    mul.rn.ftz.f32 %f7, %f4, %f5;\n")
    p = bf16_cstr_append(buf, p, "    mul.rn.ftz.f32 res, %f7, %f6;\n")
    p = bf16_cstr_append(buf, p, "L_SE_DONE:\n    ret;\n}\n\n")
    p
}

fn ptx_cr_emit_embed_and_vec(buf: i64, pos: i64) -> i64 with Mut {
    var p = pos
    p = bf16_cstr_append(buf, p, ".visible .entry cuda_embed_lookup(\n")
    p = bf16_cstr_append(buf, p, "    .param .u64 p_w, .param .u64 p_out,\n")
    p = bf16_cstr_append(buf, p, "    .param .u64 p_dim, .param .u64 p_bf16\n) {\n")
    p = bf16_cstr_append(buf, p, "    .reg .pred %p<4>; .reg .b32 %r<8>; .reg .b64 %rd<12>; .reg .f32 %f<4>;\n")
    p = bf16_cstr_append(buf, p, "    ld.param.u64 %rd1, [p_w]; ld.param.u64 %rd2, [p_out];\n")
    p = bf16_cstr_append(buf, p, "    ld.param.u64 %rd3, [p_dim]; ld.param.u64 %rd4, [p_bf16];\n")
    p = bf16_cstr_append(buf, p, "    mov.u32 %r1, %ctaid.x; mov.u32 %r2, %ntid.x; mov.u32 %r3, %tid.x;\n")
    p = bf16_cstr_append(buf, p, "    mad.lo.u32 %r1, %r1, %r2, %r3; cvt.u64.u32 %rd5, %r1;\n")
    p = bf16_cstr_append(buf, p, "    setp.ge.u64 %p1, %rd5, %rd3; @%p1 bra L_EMB_EXIT;\n")
    p = bf16_cstr_append(buf, p, "    and.b64 %rd10, %rd4, 1; setp.ne.u64 %p2, %rd10, 0; and.b64 %rd10, %rd4, 2; setp.ne.u64 %p3, %rd10, 0;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd6, %rd5, 2; add.u64 %rd7, %rd2, %rd6;\n")
    p = bf16_cstr_append(buf, p, "    @!%p2 bra L_EMB_F32;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd8, %rd5, 1; add.u64 %rd9, %rd1, %rd8;\n")
    p = bf16_cstr_append(buf, p, "    ld.global.u16 %r4, [%rd9]; cvt.u32.u16 %r5, %r4; shl.b32 %r6, %r5, 16;\n")
    p = bf16_cstr_append(buf, p, "    mov.b32 %f1, %r6; bra L_EMB_STORE;\n")
    p = bf16_cstr_append(buf, p, "L_EMB_F32:\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd9, %rd1, %rd6; ld.global.f32 %f1, [%rd9];\nL_EMB_STORE:\n    @%p3 mul.rn.ftz.f32 %f1, %f1, 0f41400000; st.global.f32 [%rd7], %f1;\n")
    p = bf16_cstr_append(buf, p, "L_EMB_EXIT:\n    ret;\n}\n\n")

    p = bf16_cstr_append(buf, p, ".visible .entry cuda_vec_add_f32(\n")
    p = bf16_cstr_append(buf, p, "    .param .u64 p_x, .param .u64 p_h,\n")
    p = bf16_cstr_append(buf, p, "    .param .u64 p_dim, .param .u64 p_dummy\n) {\n")
    p = bf16_cstr_append(buf, p, "    .reg .pred %p<4>; .reg .b32 %r<5>; .reg .b64 %rd<10>; .reg .f32 %f<5>;\n")
    p = bf16_cstr_append(buf, p, "    ld.param.u64 %rd1, [p_x]; ld.param.u64 %rd2, [p_h]; ld.param.u64 %rd3, [p_dim]; ld.param.u64 %rd8, [p_dummy];\n")
    p = bf16_cstr_append(buf, p, "    mov.u32 %r1, %ctaid.x; mov.u32 %r2, %ntid.x; mov.u32 %r3, %tid.x;\n")
    p = bf16_cstr_append(buf, p, "    mad.lo.u32 %r1, %r1, %r2, %r3; cvt.u64.u32 %rd4, %r1;\n")
    p = bf16_cstr_append(buf, p, "    setp.ge.u64 %p1, %rd4, %rd3; @%p1 bra L_VA_EXIT;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd5, %rd4, 2; add.u64 %rd6, %rd1, %rd5; add.u64 %rd7, %rd2, %rd5;\n")
    p = bf16_cstr_append(buf, p, "    ld.global.f32 %f1, [%rd6]; setp.eq.u64 %p2, %rd2, 0; cvt.u32.u64 %r4, %rd8; mov.b32 %f4, %r4; @%p2 bra L_VA_SCALE; ld.global.f32 %f2, [%rd7]; setp.ne.u64 %p3, %rd8, 0; @%p3 mul.rn.ftz.f32 %f2, %f2, %f4;\n")
    p = bf16_cstr_append(buf, p, "    add.rn.ftz.f32 %f3, %f1, %f2; st.global.f32 [%rd6], %f3; bra L_VA_EXIT;\nL_VA_SCALE:\n    mul.rn.ftz.f32 %f3, %f1, %f4; st.global.f32 [%rd6], %f3;\n")
    p = bf16_cstr_append(buf, p, "L_VA_EXIT:\n    ret;\n}\n\n")

    p = bf16_cstr_append(buf, p, ".visible .entry cuda_swiglu_f32(\n")
    p = bf16_cstr_append(buf, p, "    .param .u64 p_g, .param .u64 p_u,\n")
    p = bf16_cstr_append(buf, p, "    .param .u64 p_o, .param .u64 p_dim\n) {\n")
    p = bf16_cstr_append(buf, p, "    .reg .pred %p<2>; .reg .b32 %r<4>; .reg .b64 %rd<12>; .reg .f32 %f<12>;\n")
    p = bf16_cstr_append(buf, p, "    ld.param.u64 %rd1, [p_g]; ld.param.u64 %rd2, [p_u];\n")
    p = bf16_cstr_append(buf, p, "    ld.param.u64 %rd3, [p_o]; ld.param.u64 %rd4, [p_dim];\n")
    p = bf16_cstr_append(buf, p, "    mov.u32 %r1, %ctaid.x; mov.u32 %r2, %ntid.x; mov.u32 %r3, %tid.x;\n")
    p = bf16_cstr_append(buf, p, "    mad.lo.u32 %r1, %r1, %r2, %r3; cvt.u64.u32 %rd5, %r1;\n")
    p = bf16_cstr_append(buf, p, "    setp.ge.u64 %p1, %rd5, %rd4; @%p1 bra L_SW_EXIT;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd6, %rd5, 2; add.u64 %rd7, %rd1, %rd6;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd8, %rd2, %rd6; add.u64 %rd9, %rd3, %rd6;\n")
    p = bf16_cstr_append(buf, p, "    ld.global.f32 %f1, [%rd7]; ld.global.f32 %f2, [%rd8];\n")
    p = bf16_cstr_append(buf, p, "    neg.ftz.f32 %f3, %f1;\n")
    p = bf16_cstr_append(buf, p, "    call.uni (%f5), sounio_exp_f32, (%f3);\n")
    p = bf16_cstr_append(buf, p, "    add.rn.ftz.f32 %f6, %f5, 0f3F800000; div.rn.ftz.f32 %f7, %f1, %f6;\n")
    p = bf16_cstr_append(buf, p, "    mul.rn.ftz.f32 %f8, %f7, %f2; st.global.f32 [%rd9], %f8;\n")
    p = bf16_cstr_append(buf, p, "L_SW_EXIT:\n    ret;\n}\n\n")
    p
}

fn ptx_cr_emit_rmsnorm(buf: i64, pos: i64) -> i64 with Mut {
    var p = pos
    // 1 warp (32 lanes) per group; grid_x = n_groups, block_x = 32
    p = bf16_cstr_append(buf, p, ".visible .entry cuda_rmsnorm(\n")
    p = bf16_cstr_append(buf, p, "    .param .u64 p_x, .param .u64 p_w, .param .u64 p_out,\n")
    p = bf16_cstr_append(buf, p, "    .param .u64 p_ng, .param .u64 p_dim, .param .u64 p_eps,\n")
    p = bf16_cstr_append(buf, p, "    .param .u64 p_bf16, .param .u64 p_dmy\n) {\n")
    p = bf16_cstr_append(buf, p, "    .reg .pred %p<6>; .reg .b32 %r<16>; .reg .b64 %rd<20>; .reg .f32 %f<16>;\n")
    p = bf16_cstr_append(buf, p, "    ld.param.u64 %rd1, [p_x]; ld.param.u64 %rd2, [p_w]; ld.param.u64 %rd3, [p_out];\n")
    p = bf16_cstr_append(buf, p, "    ld.param.u64 %rd4, [p_ng]; ld.param.u64 %rd5, [p_dim];\n")
    p = bf16_cstr_append(buf, p, "    ld.param.u64 %rd6, [p_eps]; ld.param.u64 %rd7, [p_bf16];\n")
    p = bf16_cstr_append(buf, p, "    mov.u32 %r1, %ctaid.x; cvt.u64.u32 %rd8, %r1;\n")
    p = bf16_cstr_append(buf, p, "    setp.ge.u64 %p1, %rd8, %rd4; @%p1 bra L_CRMS_EXIT;\n")
    p = bf16_cstr_append(buf, p, "    setp.eq.u64 %p2, %rd5, 0; @%p2 bra L_CRMS_EXIT;\n")
    p = bf16_cstr_append(buf, p, "    mul.lo.u64 %rd9, %rd8, %rd5; shl.b64 %rd10, %rd9, 2;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd11, %rd1, %rd10; add.u64 %rd12, %rd3, %rd10;\n")
    p = bf16_cstr_append(buf, p, "    mov.u32 %r2, %tid.x; and.b32 %r2, %r2, 31; cvt.u64.u32 %rd13, %r2;\n")
    p = bf16_cstr_append(buf, p, "    mov.f32 %f1, 0f00000000; mov.u64 %rd14, %rd13;\n")
    p = bf16_cstr_append(buf, p, "L_CRMS_L1:\n    setp.ge.u64 %p3, %rd14, %rd5; @%p3 bra L_CRMS_RED;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd15, %rd14, 2; add.u64 %rd16, %rd11, %rd15;\n")
    p = bf16_cstr_append(buf, p, "    ld.global.f32 %f2, [%rd16]; fma.rn.ftz.f32 %f1, %f2, %f2, %f1;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd14, %rd14, 32; bra L_CRMS_L1;\nL_CRMS_RED:\n")
    p = ptx_cr_warp_sum_f32(buf, p, "%f1", "%r10", "%r11", "%f10")
    p = bf16_cstr_append(buf, p, "    cvt.rn.f32.u64 %f3, %rd5; div.rn.ftz.f32 %f4, %f1, %f3;\n")
    p = bf16_cstr_append(buf, p, "    cvt.u32.u64 %r4, %rd6; mov.b32 %f5, %r4; add.rn.ftz.f32 %f6, %f4, %f5;\n")
    p = bf16_cstr_append(buf, p, "    sqrt.rn.ftz.f32 %f7, %f6; div.rn.ftz.f32 %f8, 0f3F800000, %f7;\n")
    p = bf16_cstr_append(buf, p, "    setp.ne.u64 %p4, %rd7, 0; mov.u64 %rd14, %rd13;\n")
    p = bf16_cstr_append(buf, p, "L_CRMS_L2:\n    setp.ge.u64 %p3, %rd14, %rd5; @%p3 bra L_CRMS_EXIT;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd15, %rd14, 2; add.u64 %rd16, %rd11, %rd15; add.u64 %rd17, %rd12, %rd15;\n")
    p = bf16_cstr_append(buf, p, "    ld.global.f32 %f9, [%rd16];\n")
    p = bf16_cstr_append(buf, p, "    @%p4 bra L_CRMS_BF;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd18, %rd2, %rd15; ld.global.f32 %f11, [%rd18]; bra L_CRMS_MUL;\n")
    p = bf16_cstr_append(buf, p, "L_CRMS_BF:\n    shl.b64 %rd19, %rd14, 1; add.u64 %rd18, %rd2, %rd19;\n")
    p = bf16_cstr_append(buf, p, "    ld.global.u16 %r5, [%rd18]; cvt.u32.u16 %r6, %r5; shl.b32 %r7, %r6, 16; mov.b32 %f11, %r7;\n")
    p = bf16_cstr_append(buf, p, "L_CRMS_MUL:\n    mul.rn.ftz.f32 %f12, %f9, %f8; mul.rn.ftz.f32 %f13, %f12, %f11; st.global.f32 [%rd17], %f13;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd14, %rd14, 32; bra L_CRMS_L2;\n")
    p = bf16_cstr_append(buf, p, "L_CRMS_EXIT:\n    ret;\n}\n\n")
    p
}

fn ptx_cr_emit_add_accum_rmsnorm(buf: i64, pos: i64) -> i64 with Mut {
    var p = pos
    // Single-warp core for cuda_add_rmsnorm and cuda_add_accum_rmsnorm; grid_x=1, block_x=32.
    p = bf16_cstr_append(buf, p, ".visible .entry cuda_add_accum_rmsnorm(\n")
    p = bf16_cstr_append(buf, p, "    .param .u64 p_x, .param .u64 p_h, .param .u64 p_w, .param .u64 p_out,\n")
    p = bf16_cstr_append(buf, p, "    .param .u64 p_conf, .param .u64 p_dim, .param .u64 p_eps, .param .u64 p_wl,\n")
    p = bf16_cstr_append(buf, p, "    .param .u64 p_flags, .param .u64 p_bf16\n) {\n")
    p = bf16_cstr_append(buf, p, "    .reg .pred %p<10>; .reg .b32 %r<20>; .reg .b64 %rd<24>; .reg .f32 %f<20>;\n")
    p = bf16_cstr_append(buf, p, "    ld.param.u64 %rd1, [p_x]; ld.param.u64 %rd2, [p_h];\n")
    p = bf16_cstr_append(buf, p, "    ld.param.u64 %rd3, [p_w]; ld.param.u64 %rd4, [p_out];\n")
    p = bf16_cstr_append(buf, p, "    ld.param.u64 %rd5, [p_conf]; ld.param.u64 %rd6, [p_dim];\n")
    p = bf16_cstr_append(buf, p, "    ld.param.u64 %rd7, [p_eps]; ld.param.u64 %rd8, [p_wl];\n")
    p = bf16_cstr_append(buf, p, "    ld.param.u64 %rd9, [p_flags]; ld.param.u64 %rd10, [p_bf16];\n")
    p = bf16_cstr_append(buf, p, "    setp.eq.u64 %p1, %rd6, 0; @%p1 bra L_AA_EXIT;\n")
    p = bf16_cstr_append(buf, p, "    mov.u32 %r1, %tid.x; setp.ge.u32 %p1, %r1, 32; @%p1 bra L_AA_EXIT;\n")
    p = bf16_cstr_append(buf, p, "    cvt.u64.u32 %rd12, %r1; mov.f32 %f1, 0f00000000; mov.u64 %rd13, %rd12;\n")
    p = bf16_cstr_append(buf, p, "L_AA_L1:\n    setp.ge.u64 %p2, %rd13, %rd6; @%p2 bra L_AA_WRED;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd14, %rd13, 2; add.u64 %rd15, %rd1, %rd14; add.u64 %rd16, %rd2, %rd14;\n")
    p = bf16_cstr_append(buf, p, "    ld.global.f32 %f2, [%rd15]; ld.global.f32 %f3, [%rd16]; shr.u64 %rd23, %rd9, 32; setp.ne.u64 %p9, %rd23, 0; cvt.u32.u64 %r19, %rd23; mov.b32 %f19, %r19; @%p9 mul.rn.ftz.f32 %f3, %f3, %f19;\n")
    p = bf16_cstr_append(buf, p, "    add.rn.ftz.f32 %f4, %f2, %f3; st.global.f32 [%rd15], %f4;\n")
    p = bf16_cstr_append(buf, p, "    fma.rn.ftz.f32 %f1, %f4, %f4, %f1; add.u64 %rd13, %rd13, 32; bra L_AA_L1;\nL_AA_WRED:\n")
    p = ptx_cr_warp_sum_f32(buf, p, "%f1", "%r10", "%r11", "%f10")
    p = bf16_cstr_append(buf, p, "    cvt.rn.f32.u64 %f7, %rd6; div.rn.ftz.f32 %f8, %f1, %f7;\n")
    p = bf16_cstr_append(buf, p, "    cvt.u32.u64 %r4, %rd7; mov.b32 %f9, %r4; add.rn.ftz.f32 %f8, %f8, %f9;\n")
    p = bf16_cstr_append(buf, p, "    sqrt.rn.ftz.f32 %f8, %f8; div.rn.ftz.f32 %f11, 0f3F800000, %f8;\n")
    p = bf16_cstr_append(buf, p, "    setp.eq.u32 %p4, %r1, 0; @!%p4 bra L_AA_LOOP2;\n")
    p = bf16_cstr_append(buf, p, "    and.b64 %rd18, %rd9, 2; setp.ne.u64 %p5, %rd18, 0; @!%p5 bra L_AA_LOOP2;\n")
    p = bf16_cstr_append(buf, p, "    setp.ne.u64 %p6, %rd5, 0; @!%p6 bra L_AA_LOOP2;\n")
    p = bf16_cstr_append(buf, p, "    and.b64 %rd19, %rd9, 1; setp.ne.u64 %p7, %rd19, 0;\n")
    p = bf16_cstr_append(buf, p, "    @%p7 ld.global.f32 %f12, [%rd5+16]; @!%p7 ld.global.f32 %f12, [%rd5];\n")
    p = bf16_cstr_append(buf, p, "    cvt.u32.u64 %r5, %rd8; mov.b32 %f13, %r5; sqrt.rn.ftz.f32 %f14, %f1;\n")
    p = bf16_cstr_append(buf, p, "    fma.rn.ftz.f32 %f15, %f13, %f14, %f12;\n")
    p = bf16_cstr_append(buf, p, "    ld.global.u32 %r6, [%rd5+20]; and.b64 %rd20, %rd9, 4;\n")
    p = bf16_cstr_append(buf, p, "    setp.ne.u64 %p8, %rd20, 0; setp.ne.u32 %p9, %r6, 0; and.pred %p8, %p8, %p9;\n")
    p = bf16_cstr_append(buf, p, "    @%p8 mul.rn.ftz.f32 %f15, %f15, %f11;\n")
    p = bf16_cstr_append(buf, p, "    st.global.f32 [%rd5], %f15;\n")
    p = bf16_cstr_append(buf, p, "L_AA_LOOP2:\n    setp.ne.u64 %p5, %rd10, 0; mov.u64 %rd13, %rd12;\n")
    p = bf16_cstr_append(buf, p, "L_AA_L2:\n    setp.ge.u64 %p2, %rd13, %rd6; @%p2 bra L_AA_EXIT;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd14, %rd13, 2; add.u64 %rd15, %rd1, %rd14; add.u64 %rd16, %rd4, %rd14;\n")
    p = bf16_cstr_append(buf, p, "    ld.global.f32 %f16, [%rd15];\n    @%p5 bra L_AA_BF;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd21, %rd3, %rd14; ld.global.f32 %f17, [%rd21]; bra L_AA_WR;\n")
    p = bf16_cstr_append(buf, p, "L_AA_BF:\n    shl.b64 %rd22, %rd13, 1; add.u64 %rd21, %rd3, %rd22;\n")
    p = bf16_cstr_append(buf, p, "    ld.global.u16 %r7, [%rd21]; cvt.u32.u16 %r8, %r7; shl.b32 %r9, %r8, 16; mov.b32 %f17, %r9;\n")
    p = bf16_cstr_append(buf, p, "L_AA_WR:\n    mul.rn.ftz.f32 %f18, %f16, %f11; mul.rn.ftz.f32 %f19, %f18, %f17; st.global.f32 [%rd16], %f19;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd13, %rd13, 32; bra L_AA_L2;\n")
    p = bf16_cstr_append(buf, p, "L_AA_EXIT:\n    ret;\n}\n\n")
    p
}

fn ptx_cr_emit_qk_rope_and_gqa(buf: i64, pos: i64) -> i64 with Mut {
    var p = pos
    // 1 warp per head; grid_x = n_q + n_kv, block_x = 32
    p = bf16_cstr_append(buf, p, ".visible .entry cuda_qk_norm_rope_kv_scatter(\n")
    p = bf16_cstr_append(buf, p, "    .param .u64 p_q, .param .u64 p_k, .param .u64 p_v,\n")
    p = bf16_cstr_append(buf, p, "    .param .u64 p_qw, .param .u64 p_kw, .param .u64 p_rope,\n")
    p = bf16_cstr_append(buf, p, "    .param .u64 p_kdst, .param .u64 p_vdst, .param .u64 p_nq,\n")
    p = bf16_cstr_append(buf, p, "    .param .u64 p_nkv, .param .u64 p_hdim, .param .u64 p_ef\n) {\n")
    p = bf16_cstr_append(buf, p, "    .reg .pred %p<8>; .reg .b32 %r<18>; .reg .b64 %rd<34>; .reg .f32 %f<22>;\n")
    p = bf16_cstr_append(buf, p, "    ld.param.u64 %rd1, [p_q]; ld.param.u64 %rd2, [p_k]; ld.param.u64 %rd3, [p_v];\n")
    p = bf16_cstr_append(buf, p, "    ld.param.u64 %rd4, [p_qw]; ld.param.u64 %rd5, [p_kw]; ld.param.u64 %rd6, [p_rope];\n")
    p = bf16_cstr_append(buf, p, "    ld.param.u64 %rd7, [p_kdst]; ld.param.u64 %rd8, [p_vdst]; ld.param.u64 %rd9, [p_nq];\n")
    p = bf16_cstr_append(buf, p, "    ld.param.u64 %rd10, [p_nkv]; ld.param.u64 %rd11, [p_hdim]; ld.param.u64 %rd12, [p_ef];\n")
    p = bf16_cstr_append(buf, p, "    mov.u32 %r1, %ctaid.x; cvt.u64.u32 %rd13, %r1; add.u64 %rd14, %rd9, %rd10;\n")
    p = bf16_cstr_append(buf, p, "    setp.ge.u64 %p1, %rd13, %rd14; @%p1 bra L_QK_EXIT;\n")
    p = bf16_cstr_append(buf, p, "    setp.lt.u64 %p2, %rd11, 2; @%p2 bra L_QK_EXIT;\n")
    p = bf16_cstr_append(buf, p, "    setp.ge.u64 %p3, %rd13, %rd9;\n")
    p = bf16_cstr_append(buf, p, "    @%p3 sub.u64 %rd15, %rd13, %rd9; @!%p3 mov.u64 %rd15, %rd13;\n")
    p = bf16_cstr_append(buf, p, "    mul.lo.u64 %rd16, %rd15, %rd11; shl.b64 %rd17, %rd16, 2;\n")
    p = bf16_cstr_append(buf, p, "    @%p3 add.u64 %rd18, %rd2, %rd17; @!%p3 add.u64 %rd18, %rd1, %rd17;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd19, %rd3, %rd17; add.u64 %rd20, %rd7, %rd17; add.u64 %rd21, %rd8, %rd17;\n")
    p = bf16_cstr_append(buf, p, "    @%p3 mov.u64 %rd22, %rd5; @!%p3 mov.u64 %rd22, %rd4;\n")
    p = bf16_cstr_append(buf, p, "    shr.u64 %rd23, %rd12, 32;\n")
    p = bf16_cstr_append(buf, p, "    @%p3 and.b64 %rd24, %rd23, 2; @!%p3 and.b64 %rd24, %rd23, 1;\n")
    p = bf16_cstr_append(buf, p, "    setp.ne.u64 %p4, %rd24, 0;\n")
    p = bf16_cstr_append(buf, p, "    mov.u32 %r2, %tid.x; and.b32 %r2, %r2, 31; cvt.u64.u32 %rd25, %r2;\n")
    p = bf16_cstr_append(buf, p, "    and.b64 %rd24, %rd23, 4; setp.ne.u64 %p6, %rd24, 0; @%p6 bra L_QK_NO_NORM; mov.f32 %f1, 0f00000000; mov.u64 %rd26, %rd25;\n")
    p = bf16_cstr_append(buf, p, "L_QK_L1:\n    setp.ge.u64 %p5, %rd26, %rd11; @%p5 bra L_QK_RED;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd27, %rd26, 2; add.u64 %rd28, %rd18, %rd27;\n")
    p = bf16_cstr_append(buf, p, "    ld.global.f32 %f2, [%rd28]; fma.rn.ftz.f32 %f1, %f2, %f2, %f1;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd26, %rd26, 32; bra L_QK_L1;\nL_QK_RED:\n")
    p = ptx_cr_warp_sum_f32(buf, p, "%f1", "%r10", "%r11", "%f10")
    p = bf16_cstr_append(buf, p, "    cvt.rn.f32.u64 %f3, %rd11; div.rn.ftz.f32 %f4, %f1, %f3;\n")
    p = bf16_cstr_append(buf, p, "    cvt.u32.u64 %r4, %rd12; mov.b32 %f5, %r4; add.rn.ftz.f32 %f6, %f4, %f5;\n")
    p = bf16_cstr_append(buf, p, "    sqrt.rn.ftz.f32 %f7, %f6; div.rn.ftz.f32 %f8, 0f3F800000, %f7;\n")
    p = bf16_cstr_append(buf, p, "    L_QK_NO_NORM:\n    shr.u64 %rd29, %rd11, 1; mov.u64 %rd26, %rd25;\n")
    p = bf16_cstr_append(buf, p, "L_QK_L2:\n    setp.ge.u64 %p5, %rd26, %rd29; @%p5 bra L_QK_EXIT;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd27, %rd26, 2; shl.b64 %rd30, %rd29, 2; add.u64 %rd31, %rd27, %rd30;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd28, %rd18, %rd27; add.u64 %rd32, %rd18, %rd31;\n")
    p = bf16_cstr_append(buf, p, "    ld.global.f32 %f9, [%rd28]; ld.global.f32 %f11, [%rd32]; @%p6 bra L_QK_ROTATE;\n")
    p = bf16_cstr_append(buf, p, "    @%p4 bra L_QK_WBF;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd33, %rd22, %rd27; ld.global.f32 %f12, [%rd33];\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd33, %rd22, %rd31; ld.global.f32 %f13, [%rd33]; bra L_QK_WOK;\n")
    p = bf16_cstr_append(buf, p, "L_QK_WBF:\n    shl.b64 %rd33, %rd26, 1; add.u64 %rd33, %rd22, %rd33;\n")
    p = bf16_cstr_append(buf, p, "    ld.global.u16 %r5, [%rd33]; cvt.u32.u16 %r6, %r5; shl.b32 %r7, %r6, 16; mov.b32 %f12, %r7;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd33, %rd29, 1; shl.b64 %rd28, %rd26, 1; add.u64 %rd33, %rd33, %rd28; add.u64 %rd33, %rd22, %rd33;\n")
    p = bf16_cstr_append(buf, p, "    ld.global.u16 %r5, [%rd33]; cvt.u32.u16 %r6, %r5; shl.b32 %r7, %r6, 16; mov.b32 %f13, %r7;\n")
    p = bf16_cstr_append(buf, p, "L_QK_WOK:\n    mul.rn.ftz.f32 %f9, %f9, %f8; mul.rn.ftz.f32 %f9, %f9, %f12;\n")
    p = bf16_cstr_append(buf, p, "    mul.rn.ftz.f32 %f11, %f11, %f8; mul.rn.ftz.f32 %f11, %f11, %f13;\n")
    p = bf16_cstr_append(buf, p, "    L_QK_ROTATE:\n    add.u64 %rd33, %rd6, %rd27; ld.global.f32 %f14, [%rd33];\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd33, %rd6, %rd31; ld.global.f32 %f15, [%rd33];\n")
    p = bf16_cstr_append(buf, p, "    mul.rn.ftz.f32 %f16, %f9, %f14; mul.rn.ftz.f32 %f17, %f11, %f15; sub.rn.ftz.f32 %f18, %f16, %f17;\n")
    p = bf16_cstr_append(buf, p, "    mul.rn.ftz.f32 %f19, %f11, %f14; mul.rn.ftz.f32 %f20, %f9, %f15; add.rn.ftz.f32 %f20, %f19, %f20;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd28, %rd18, %rd27; add.u64 %rd32, %rd18, %rd31;\n")
    p = bf16_cstr_append(buf, p, "    st.global.f32 [%rd28], %f18; st.global.f32 [%rd32], %f20;\n")
    p = bf16_cstr_append(buf, p, "    @!%p3 bra L_QK_NEXT;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd33, %rd20, %rd27; st.global.f32 [%rd33], %f18;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd33, %rd20, %rd31; st.global.f32 [%rd33], %f20;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd28, %rd19, %rd27; ld.global.f32 %f16, [%rd28];\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd33, %rd21, %rd27; st.global.f32 [%rd33], %f16;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd28, %rd19, %rd31; ld.global.f32 %f17, [%rd28];\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd33, %rd21, %rd31; st.global.f32 [%rd33], %f17;\n")
    p = bf16_cstr_append(buf, p, "L_QK_NEXT:\n    add.u64 %rd26, %rd26, 32; bra L_QK_L2;\n")
    p = bf16_cstr_append(buf, p, "L_QK_EXIT:\n    ret;\n}\n\n")

    // 1 warp per Q head; grid_x = n_q, block_x = 32; supports head_dim <= 256 (8 chunks of 32)
    p = bf16_cstr_append(buf, p, ".visible .entry cuda_paged_gqa_warp(\n")
    p = bf16_cstr_append(buf, p, "    .param .u64 p_q, .param .u64 p_kcache, .param .u64 p_vcache, .param .u64 p_out,\n")
    p = bf16_cstr_append(buf, p, "    .param .u64 p_nq, .param .u64 p_nkv, .param .u64 p_hdim, .param .u64 p_seq\n) {\n")
    p = bf16_cstr_append(buf, p, "    .local .align 4 .b8 q_loc[32]; .local .align 4 .b8 a_loc[32];\n")
    p = bf16_cstr_append(buf, p, "    .reg .pred %p<8>; .reg .b32 %r<16>; .reg .b64 %rd<32>; .reg .f32 %f<20>;\n")
    p = bf16_cstr_append(buf, p, "    ld.param.u64 %rd1, [p_q]; ld.param.u64 %rd2, [p_kcache]; ld.param.u64 %rd3, [p_vcache];\n")
    p = bf16_cstr_append(buf, p, "    ld.param.u64 %rd4, [p_out]; ld.param.u64 %rd5, [p_nq]; ld.param.u64 %rd6, [p_nkv];\n")
    p = bf16_cstr_append(buf, p, "    ld.param.u64 %rd7, [p_hdim]; ld.param.u64 %rd8, [p_seq];\n")
    p = bf16_cstr_append(buf, p, "    cvta.local.u64 %rd27, q_loc; cvta.local.u64 %rd28, a_loc;\n")
    p = bf16_cstr_append(buf, p, "    mov.u32 %r1, %ctaid.x; cvt.u64.u32 %rd9, %r1;\n")
    p = bf16_cstr_append(buf, p, "    setp.ge.u64 %p1, %rd9, %rd5; @%p1 bra L_GQA_EXIT;\n")
    p = bf16_cstr_append(buf, p, "    setp.eq.u64 %p2, %rd6, 0; @%p2 bra L_GQA_EXIT;\n")
    p = bf16_cstr_append(buf, p, "    setp.eq.u64 %p2, %rd7, 0; @%p2 bra L_GQA_EXIT;\n")
    p = bf16_cstr_append(buf, p, "    div.u64 %rd10, %rd5, %rd6; div.u64 %rd11, %rd9, %rd10;\n")
    p = bf16_cstr_append(buf, p, "    cvt.rn.f32.u64 %f1, %rd7; sqrt.rn.ftz.f32 %f1, %f1; div.rn.ftz.f32 %f2, 0f3F800000, %f1; shr.u64 %rd31, %rd8, 32; and.b64 %rd8, %rd8, 4294967295; setp.ne.u64 %p3, %rd31, 0; cvt.u32.u64 %r15, %rd31; @%p3 mov.b32 %f2, %r15;\n")
    p = bf16_cstr_append(buf, p, "    mul.lo.u64 %rd12, %rd9, %rd7; shl.b64 %rd12, %rd12, 2;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd13, %rd1, %rd12; add.u64 %rd14, %rd4, %rd12;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd15, %rd7, 31; shr.u64 %rd15, %rd15, 5;\n")
    p = bf16_cstr_append(buf, p, "    mov.u32 %r2, %tid.x; and.b32 %r2, %r2, 31; cvt.u64.u32 %rd16, %r2;\n")
    p = bf16_cstr_append(buf, p, "    mov.u64 %rd17, 0;\n")
    p = bf16_cstr_append(buf, p, "L_GQA_INIT:\n    setp.ge.u64 %p3, %rd17, %rd15; @%p3 bra L_GQA_INIT_DONE;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd18, %rd17, 5; add.u64 %rd18, %rd18, %rd16;\n")
    p = bf16_cstr_append(buf, p, "    setp.lt.u64 %p4, %rd18, %rd7;\n")
    p = bf16_cstr_append(buf, p, "    @%p4 shl.b64 %rd19, %rd18, 2; @%p4 add.u64 %rd19, %rd13, %rd19;\n")
    p = bf16_cstr_append(buf, p, "    @%p4 ld.global.f32 %f3, [%rd19]; @!%p4 mov.f32 %f3, 0f00000000;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd20, %rd17, 2; add.u64 %rd29, %rd27, %rd20; add.u64 %rd30, %rd28, %rd20;\n")
    p = bf16_cstr_append(buf, p, "    st.f32 [%rd29], %f3; st.f32 [%rd30], 0f00000000;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd17, %rd17, 1; bra L_GQA_INIT;\n")
    p = bf16_cstr_append(buf, p, "L_GQA_INIT_DONE:\n    setp.eq.u64 %p3, %rd8, 0; @%p3 bra L_GQA_ZERO;\n")
    p = bf16_cstr_append(buf, p, "    mul.lo.u64 %rd21, %rd6, %rd7; shl.b64 %rd21, %rd21, 2;\n")
    p = bf16_cstr_append(buf, p, "    mul.lo.u64 %rd22, %rd11, %rd7; shl.b64 %rd22, %rd22, 2;\n")
    p = bf16_cstr_append(buf, p, "    mov.f32 %f4, 0f00000000; mov.f32 %f5, 0f00000000; mov.u64 %rd23, 0;\n")
    p = bf16_cstr_append(buf, p, "L_GQA_T:\n    mul.lo.u64 %rd24, %rd23, %rd21; add.u64 %rd24, %rd24, %rd22;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd25, %rd2, %rd24; add.u64 %rd26, %rd3, %rd24;\n")
    p = bf16_cstr_append(buf, p, "    mov.f32 %f6, 0f00000000; mov.u64 %rd17, 0;\n")
    p = bf16_cstr_append(buf, p, "L_GQA_DOT:\n    setp.ge.u64 %p3, %rd17, %rd15; @%p3 bra L_GQA_DOT_RED;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd18, %rd17, 5; add.u64 %rd18, %rd18, %rd16;\n")
    p = bf16_cstr_append(buf, p, "    setp.lt.u64 %p4, %rd18, %rd7;\n")
    p = bf16_cstr_append(buf, p, "    @%p4 shl.b64 %rd19, %rd18, 2; @%p4 add.u64 %rd19, %rd25, %rd19;\n")
    p = bf16_cstr_append(buf, p, "    @%p4 ld.global.f32 %f7, [%rd19]; @!%p4 mov.f32 %f7, 0f00000000;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd20, %rd17, 2; add.u64 %rd29, %rd27, %rd20; ld.f32 %f8, [%rd29];\n")
    p = bf16_cstr_append(buf, p, "    fma.rn.ftz.f32 %f6, %f8, %f7, %f6; add.u64 %rd17, %rd17, 1; bra L_GQA_DOT;\n")
    p = bf16_cstr_append(buf, p, "L_GQA_DOT_RED:\n")
    p = ptx_cr_warp_sum_f32(buf, p, "%f6", "%r10", "%r11", "%f10")
    p = bf16_cstr_append(buf, p, "    mul.rn.ftz.f32 %f9, %f6, %f2;\n")
    p = bf16_cstr_append(buf, p, "    setp.eq.u64 %p5, %rd23, 0; @%p5 bra L_GQA_FIRST;\n")
    p = bf16_cstr_append(buf, p, "    setp.gt.ftz.f32 %p6, %f9, %f4; @%p6 bra L_GQA_NEWMAX;\n")
    p = bf16_cstr_append(buf, p, "    sub.rn.ftz.f32 %f11, %f9, %f4; call.uni (%f12), sounio_exp_f32, (%f11);\n")
    p = bf16_cstr_append(buf, p, "    add.rn.ftz.f32 %f5, %f5, %f12; mov.u64 %rd17, 0;\n")
    p = bf16_cstr_append(buf, p, "L_GQA_UB:\n    setp.ge.u64 %p3, %rd17, %rd15; @%p3 bra L_GQA_TNEXT;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd18, %rd17, 5; add.u64 %rd18, %rd18, %rd16; setp.lt.u64 %p4, %rd18, %rd7;\n")
    p = bf16_cstr_append(buf, p, "    @%p4 shl.b64 %rd19, %rd18, 2; @%p4 add.u64 %rd19, %rd26, %rd19;\n")
    p = bf16_cstr_append(buf, p, "    @%p4 ld.global.f32 %f13, [%rd19]; @!%p4 mov.f32 %f13, 0f00000000;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd20, %rd17, 2; add.u64 %rd30, %rd28, %rd20; ld.f32 %f14, [%rd30];\n")
    p = bf16_cstr_append(buf, p, "    fma.rn.ftz.f32 %f14, %f12, %f13, %f14; st.f32 [%rd30], %f14;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd17, %rd17, 1; bra L_GQA_UB;\n")
    p = bf16_cstr_append(buf, p, "L_GQA_NEWMAX:\n")
    p = bf16_cstr_append(buf, p, "    sub.rn.ftz.f32 %f11, %f4, %f9; call.uni (%f12), sounio_exp_f32, (%f11);\n")
    p = bf16_cstr_append(buf, p, "    fma.rn.ftz.f32 %f5, %f5, %f12, 0f3F800000; mov.f32 %f4, %f9; mov.u64 %rd17, 0;\n")
    p = bf16_cstr_append(buf, p, "L_GQA_UA:\n    setp.ge.u64 %p3, %rd17, %rd15; @%p3 bra L_GQA_TNEXT;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd18, %rd17, 5; add.u64 %rd18, %rd18, %rd16; setp.lt.u64 %p4, %rd18, %rd7;\n")
    p = bf16_cstr_append(buf, p, "    @%p4 shl.b64 %rd19, %rd18, 2; @%p4 add.u64 %rd19, %rd26, %rd19;\n")
    p = bf16_cstr_append(buf, p, "    @%p4 ld.global.f32 %f13, [%rd19]; @!%p4 mov.f32 %f13, 0f00000000;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd20, %rd17, 2; add.u64 %rd30, %rd28, %rd20; ld.f32 %f14, [%rd30];\n")
    p = bf16_cstr_append(buf, p, "    fma.rn.ftz.f32 %f14, %f14, %f12, %f13; st.f32 [%rd30], %f14;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd17, %rd17, 1; bra L_GQA_UA;\n")
    p = bf16_cstr_append(buf, p, "L_GQA_FIRST:\n    mov.f32 %f4, %f9; mov.f32 %f5, 0f3F800000; mov.u64 %rd17, 0;\n")
    p = bf16_cstr_append(buf, p, "L_GQA_UF:\n    setp.ge.u64 %p3, %rd17, %rd15; @%p3 bra L_GQA_TNEXT;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd18, %rd17, 5; add.u64 %rd18, %rd18, %rd16; setp.lt.u64 %p4, %rd18, %rd7;\n")
    p = bf16_cstr_append(buf, p, "    @%p4 shl.b64 %rd19, %rd18, 2; @%p4 add.u64 %rd19, %rd26, %rd19;\n")
    p = bf16_cstr_append(buf, p, "    @%p4 ld.global.f32 %f13, [%rd19]; @!%p4 mov.f32 %f13, 0f00000000;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd20, %rd17, 2; add.u64 %rd30, %rd28, %rd20; st.f32 [%rd30], %f13;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd17, %rd17, 1; bra L_GQA_UF;\n")
    p = bf16_cstr_append(buf, p, "L_GQA_TNEXT:\n    add.u64 %rd23, %rd23, 1; setp.lt.u64 %p7, %rd23, %rd8; @%p7 bra L_GQA_T;\n")
    p = bf16_cstr_append(buf, p, "    setp.gt.ftz.f32 %p3, %f5, 0f00000000; @!%p3 bra L_GQA_ZERO;\n")
    p = bf16_cstr_append(buf, p, "    div.rn.ftz.f32 %f15, 0f3F800000, %f5; mov.u64 %rd17, 0;\n")
    p = bf16_cstr_append(buf, p, "L_GQA_OUT:\n    setp.ge.u64 %p3, %rd17, %rd15; @%p3 bra L_GQA_EXIT;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd18, %rd17, 5; add.u64 %rd18, %rd18, %rd16; setp.lt.u64 %p4, %rd18, %rd7;\n")
    p = bf16_cstr_append(buf, p, "    @!%p4 bra L_GQA_ONEXT;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd20, %rd17, 2; add.u64 %rd30, %rd28, %rd20; ld.f32 %f16, [%rd30]; mul.rn.ftz.f32 %f16, %f16, %f15;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd19, %rd18, 2; add.u64 %rd19, %rd14, %rd19; st.global.f32 [%rd19], %f16;\n")
    p = bf16_cstr_append(buf, p, "L_GQA_ONEXT:\n    add.u64 %rd17, %rd17, 1; bra L_GQA_OUT;\n")
    p = bf16_cstr_append(buf, p, "L_GQA_ZERO:\n    mov.u64 %rd17, 0;\n")
    p = bf16_cstr_append(buf, p, "L_GQA_ZLOOP:\n    setp.ge.u64 %p3, %rd17, %rd15; @%p3 bra L_GQA_EXIT;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd18, %rd17, 5; add.u64 %rd18, %rd18, %rd16; setp.lt.u64 %p4, %rd18, %rd7;\n")
    p = bf16_cstr_append(buf, p, "    @%p4 shl.b64 %rd19, %rd18, 2; @%p4 add.u64 %rd19, %rd14, %rd19; @%p4 st.global.f32 [%rd19], 0f00000000;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd17, %rd17, 1; bra L_GQA_ZLOOP;\n")
    p = bf16_cstr_append(buf, p, "L_GQA_EXIT:\n    ret;\n}\n\n")
    p
}

fn ptx_cr_emit_gemv_bf16_and_argmax(buf: i64, pos: i64) -> i64 with Mut {
    var p = pos
    // 8 warps/CTA (block_x=256), 1 warp per output row; alignment-independent 4-acc FMA + tail
    p = bf16_cstr_append(buf, p, ".visible .entry cuda_gemv_bf16(\n")
    p = bf16_cstr_append(buf, p, "    .param .u64 p_w, .param .u64 p_x, .param .u64 p_y,\n")
    p = bf16_cstr_append(buf, p, "    .param .u64 p_out, .param .u64 p_in, .param .u64 p_bf16\n) {\n")
    p = bf16_cstr_append(buf, p, "    .reg .pred %p<7>; .reg .b32 %r<22>; .reg .b64 %rd<28>; .reg .f32 %f<20>;\n")
    p = bf16_cstr_append(buf, p, "    ld.param.u64 %rd1, [p_w]; ld.param.u64 %rd2, [p_x]; ld.param.u64 %rd3, [p_y];\n")
    p = bf16_cstr_append(buf, p, "    ld.param.u64 %rd4, [p_out]; ld.param.u64 %rd5, [p_in]; ld.param.u64 %rd6, [p_bf16];\n")
    p = bf16_cstr_append(buf, p, "    mov.u32 %r1, %ctaid.x; mov.u32 %r2, %tid.x; shr.u32 %r3, %r2, 5; and.b32 %r4, %r2, 31;\n")
    p = bf16_cstr_append(buf, p, "    mad.lo.u32 %r5, %r1, 8, %r3; cvt.u64.u32 %rd7, %r5;\n")
    p = bf16_cstr_append(buf, p, "    setp.ge.u64 %p1, %rd7, %rd4; @%p1 bra L_GB_EXIT;\n")
    p = bf16_cstr_append(buf, p, "    mov.f32 %f1, 0f00000000; mov.f32 %f2, 0f00000000; mov.f32 %f3, 0f00000000; mov.f32 %f4, 0f00000000;\n")
    p = bf16_cstr_append(buf, p, "    cvt.u64.u32 %rd8, %r4; setp.eq.u64 %p2, %rd5, 0; @%p2 bra L_GB_STORE;\n")
    p = bf16_cstr_append(buf, p, "    shr.u64 %rd25, %rd5, 2; shl.b64 %rd25, %rd25, 2; shl.b64 %rd26, %rd8, 2; add.u64 %rd27, %rd25, %rd8;\n")
    p = bf16_cstr_append(buf, p, "    setp.ne.u64 %p3, %rd6, 0; mul.lo.u64 %rd9, %rd7, %rd5;\n")
    p = bf16_cstr_append(buf, p, "    @!%p3 bra L_GB_F32;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd10, %rd9, 1; add.u64 %rd11, %rd1, %rd10;\n")
    p = bf16_cstr_append(buf, p, "    and.b64 %rd12, %rd11, 7; and.b64 %rd13, %rd2, 15; or.b64 %rd12, %rd12, %rd13;\n")
    p = bf16_cstr_append(buf, p, "    setp.eq.u64 %p4, %rd12, 0; mov.u64 %rd15, %rd26; @!%p4 bra L_GB_BF_SC;\n")
    p = bf16_cstr_append(buf, p, "L_GB_V4:\n    setp.ge.u64 %p5, %rd15, %rd25; @%p5 bra L_GB_BTAIL;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd16, %rd15, 1; add.u64 %rd17, %rd11, %rd16; ld.global.u64 %rd18, [%rd17];\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd19, %rd15, 2; add.u64 %rd20, %rd2, %rd19; ld.global.v4.f32 {%f5, %f6, %f7, %f8}, [%rd20];\n")
    p = bf16_cstr_append(buf, p, "    cvt.u32.u64 %r6, %rd18; shr.u64 %rd21, %rd18, 32; cvt.u32.u64 %r7, %rd21;\n")
    p = bf16_cstr_append(buf, p, "    and.b32 %r8, %r6, 0xffff; shl.b32 %r8, %r8, 16; mov.b32 %f9, %r8;\n")
    p = bf16_cstr_append(buf, p, "    and.b32 %r9, %r6, 0xffff0000; mov.b32 %f10, %r9;\n")
    p = bf16_cstr_append(buf, p, "    and.b32 %r10, %r7, 0xffff; shl.b32 %r10, %r10, 16; mov.b32 %f11, %r10;\n")
    p = bf16_cstr_append(buf, p, "    and.b32 %r11, %r7, 0xffff0000; mov.b32 %f12, %r11;\n")
    p = bf16_cstr_append(buf, p, "    fma.rn.ftz.f32 %f1, %f9, %f5, %f1; fma.rn.ftz.f32 %f2, %f10, %f6, %f2;\n")
    p = bf16_cstr_append(buf, p, "    fma.rn.ftz.f32 %f3, %f11, %f7, %f3; fma.rn.ftz.f32 %f4, %f12, %f8, %f4;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd15, %rd15, 128; bra L_GB_V4;\n")
    p = bf16_cstr_append(buf, p, "L_GB_BF_SC:\n    setp.ge.u64 %p5, %rd15, %rd25; @%p5 bra L_GB_BTAIL;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd16, %rd15, 1; add.u64 %rd17, %rd11, %rd16;\n")
    p = bf16_cstr_append(buf, p, "    ld.global.u16 %r6, [%rd17]; cvt.u32.u16 %r7, %r6; shl.b32 %r8, %r7, 16; mov.b32 %f9, %r8;\n")
    p = bf16_cstr_append(buf, p, "    ld.global.u16 %r6, [%rd17+2]; cvt.u32.u16 %r7, %r6; shl.b32 %r8, %r7, 16; mov.b32 %f10, %r8;\n")
    p = bf16_cstr_append(buf, p, "    ld.global.u16 %r6, [%rd17+4]; cvt.u32.u16 %r7, %r6; shl.b32 %r8, %r7, 16; mov.b32 %f11, %r8;\n")
    p = bf16_cstr_append(buf, p, "    ld.global.u16 %r6, [%rd17+6]; cvt.u32.u16 %r7, %r6; shl.b32 %r8, %r7, 16; mov.b32 %f12, %r8;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd19, %rd15, 2; add.u64 %rd20, %rd2, %rd19;\n")
    p = bf16_cstr_append(buf, p, "    ld.global.f32 %f5, [%rd20]; ld.global.f32 %f6, [%rd20+4]; ld.global.f32 %f7, [%rd20+8]; ld.global.f32 %f8, [%rd20+12];\n")
    p = bf16_cstr_append(buf, p, "    fma.rn.ftz.f32 %f1, %f9, %f5, %f1; fma.rn.ftz.f32 %f2, %f10, %f6, %f2;\n")
    p = bf16_cstr_append(buf, p, "    fma.rn.ftz.f32 %f3, %f11, %f7, %f3; fma.rn.ftz.f32 %f4, %f12, %f8, %f4;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd15, %rd15, 128; bra L_GB_BF_SC;\n")
    p = bf16_cstr_append(buf, p, "L_GB_BTAIL:\n    mov.u64 %rd15, %rd27;\n")
    p = bf16_cstr_append(buf, p, "L_GB_BTL:\n    setp.ge.u64 %p5, %rd15, %rd5; @%p5 bra L_GB_RED;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd16, %rd15, 1; add.u64 %rd17, %rd11, %rd16;\n")
    p = bf16_cstr_append(buf, p, "    ld.global.u16 %r6, [%rd17]; cvt.u32.u16 %r7, %r6; shl.b32 %r8, %r7, 16; mov.b32 %f9, %r8;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd19, %rd15, 2; add.u64 %rd20, %rd2, %rd19; ld.global.f32 %f5, [%rd20];\n")
    p = bf16_cstr_append(buf, p, "    fma.rn.ftz.f32 %f1, %f9, %f5, %f1; add.u64 %rd15, %rd15, 32; bra L_GB_BTL;\n")
    p = bf16_cstr_append(buf, p, "L_GB_F32:\n    shl.b64 %rd10, %rd9, 2; add.u64 %rd11, %rd1, %rd10; mov.u64 %rd15, %rd26;\n")
    p = bf16_cstr_append(buf, p, "L_GB_F32L:\n    setp.ge.u64 %p5, %rd15, %rd25; @%p5 bra L_GB_FTAIL;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd19, %rd15, 2; add.u64 %rd17, %rd11, %rd19; add.u64 %rd20, %rd2, %rd19;\n")
    p = bf16_cstr_append(buf, p, "    ld.global.f32 %f9, [%rd17]; ld.global.f32 %f10, [%rd17+4]; ld.global.f32 %f11, [%rd17+8]; ld.global.f32 %f12, [%rd17+12];\n")
    p = bf16_cstr_append(buf, p, "    ld.global.f32 %f5, [%rd20]; ld.global.f32 %f6, [%rd20+4]; ld.global.f32 %f7, [%rd20+8]; ld.global.f32 %f8, [%rd20+12];\n")
    p = bf16_cstr_append(buf, p, "    fma.rn.ftz.f32 %f1, %f9, %f5, %f1; fma.rn.ftz.f32 %f2, %f10, %f6, %f2;\n")
    p = bf16_cstr_append(buf, p, "    fma.rn.ftz.f32 %f3, %f11, %f7, %f3; fma.rn.ftz.f32 %f4, %f12, %f8, %f4;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd15, %rd15, 128; bra L_GB_F32L;\n")
    p = bf16_cstr_append(buf, p, "L_GB_FTAIL:\n    mov.u64 %rd15, %rd27;\n")
    p = bf16_cstr_append(buf, p, "L_GB_FTL:\n    setp.ge.u64 %p5, %rd15, %rd5; @%p5 bra L_GB_RED;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd19, %rd15, 2; add.u64 %rd17, %rd11, %rd19; add.u64 %rd20, %rd2, %rd19;\n")
    p = bf16_cstr_append(buf, p, "    ld.global.f32 %f9, [%rd17]; ld.global.f32 %f5, [%rd20];\n")
    p = bf16_cstr_append(buf, p, "    fma.rn.ftz.f32 %f1, %f9, %f5, %f1; add.u64 %rd15, %rd15, 32; bra L_GB_FTL;\nL_GB_RED:\n")
    p = bf16_cstr_append(buf, p, "    add.rn.ftz.f32 %f1, %f1, %f2; add.rn.ftz.f32 %f3, %f3, %f4; add.rn.ftz.f32 %f1, %f1, %f3;\n")
    p = ptx_cr_warp_sum_f32(buf, p, "%f1", "%r14", "%r15", "%f14")
    p = bf16_cstr_append(buf, p, "L_GB_STORE:\n    setp.eq.u32 %p6, %r4, 0; @!%p6 bra L_GB_EXIT;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd22, %rd7, 2; add.u64 %rd23, %rd3, %rd22; st.global.f32 [%rd23], %f1;\n")
    p = bf16_cstr_append(buf, p, "L_GB_EXIT:\n    ret;\n}\n\n")

    // grid_x=1, block_x=256 -> writes [j1(u64), j2(u64), b1(u32), b2(u32)] at p_out
    p = bf16_cstr_append(buf, p, ".visible .entry cuda_argmax_top2_f32(\n")
    p = bf16_cstr_append(buf, p, "    .param .u64 p_logits, .param .u64 p_out,\n")
    p = bf16_cstr_append(buf, p, "    .param .u64 p_vocab, .param .u64 p_dummy\n) {\n")
    p = bf16_cstr_append(buf, p, "    .shared .align 8 .b8 smem[6144];\n")
    p = bf16_cstr_append(buf, p, "    .reg .pred %p<8>; .reg .b32 %r<10>; .reg .b64 %rd<22>; .reg .f32 %f<10>;\n")
    p = bf16_cstr_append(buf, p, "    ld.param.u64 %rd1, [p_logits]; ld.param.u64 %rd2, [p_out]; ld.param.u64 %rd3, [p_vocab];\n")
    p = bf16_cstr_append(buf, p, "    cvta.shared.u64 %rd4, smem; mov.u32 %r1, %tid.x; cvt.u64.u32 %rd5, %r1;\n")
    p = bf16_cstr_append(buf, p, "    mov.f32 %f1, 0fFF800000; mov.f32 %f2, 0fFF800000; mov.u64 %rd6, -1; mov.u64 %rd7, -1;\n")
    p = bf16_cstr_append(buf, p, "    mov.u64 %rd8, %rd5;\n")
    p = bf16_cstr_append(buf, p, "L_ARG_L1:\n    setp.ge.u64 %p1, %rd8, %rd3; @%p1 bra L_ARG_ST;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd9, %rd8, 2; add.u64 %rd10, %rd1, %rd9; ld.global.f32 %f3, [%rd10];\n")
    p = bf16_cstr_append(buf, p, "    setp.gt.ftz.f32 %p2, %f3, %f1; @%p2 bra L_ARG_G1;\n")
    p = bf16_cstr_append(buf, p, "    setp.gt.ftz.f32 %p3, %f3, %f2; @%p3 bra L_ARG_G2; bra L_ARG_NX;\n")
    p = bf16_cstr_append(buf, p, "L_ARG_G1:\n    mov.f32 %f2, %f1; mov.u64 %rd7, %rd6; mov.f32 %f1, %f3; mov.u64 %rd6, %rd8; bra L_ARG_NX;\n")
    p = bf16_cstr_append(buf, p, "L_ARG_G2:\n    mov.f32 %f2, %f3; mov.u64 %rd7, %rd8;\n")
    p = bf16_cstr_append(buf, p, "L_ARG_NX:\n    add.u64 %rd8, %rd8, 256; bra L_ARG_L1;\n")
    p = bf16_cstr_append(buf, p, "L_ARG_ST:\n    shl.b64 %rd11, %rd5, 2; add.u64 %rd12, %rd4, %rd11; st.f32 [%rd12], %f1;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd12, %rd12, 1024; st.f32 [%rd12], %f2;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd13, %rd5, 3; add.u64 %rd14, %rd4, 2048; add.u64 %rd14, %rd14, %rd13; st.u64 [%rd14], %rd6;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd14, %rd14, 2048; st.u64 [%rd14], %rd7;\n")
    p = bf16_cstr_append(buf, p, "    bar.sync 0; setp.eq.u32 %p1, %r1, 0; @!%p1 bra L_ARG_EXIT;\n")
    p = bf16_cstr_append(buf, p, "    mov.f32 %f1, 0fFF800000; mov.f32 %f2, 0fFF800000; mov.u64 %rd6, -1; mov.u64 %rd7, -1; mov.u64 %rd8, 0;\n")
    p = bf16_cstr_append(buf, p, "L_ARG_L2:\n    setp.ge.u64 %p2, %rd8, 512; @%p2 bra L_ARG_OUT;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd11, %rd8, 2; add.u64 %rd12, %rd4, %rd11; ld.f32 %f3, [%rd12];\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd13, %rd8, 3; add.u64 %rd14, %rd4, 2048; add.u64 %rd14, %rd14, %rd13; ld.u64 %rd15, [%rd14];\n")
    p = bf16_cstr_append(buf, p, "    setp.eq.u64 %p3, %rd15, -1; @%p3 bra L_ARG_N2;\n")
    p = bf16_cstr_append(buf, p, "    setp.gt.ftz.f32 %p4, %f3, %f1; setp.eq.ftz.f32 %p5, %f3, %f1; setp.lt.u64 %p6, %rd15, %rd6;\n")
    p = bf16_cstr_append(buf, p, "    and.pred %p5, %p5, %p6; or.pred %p4, %p4, %p5; @%p4 bra L_ARG_B1;\n")
    p = bf16_cstr_append(buf, p, "    setp.gt.ftz.f32 %p4, %f3, %f2; setp.eq.ftz.f32 %p5, %f3, %f2; setp.lt.u64 %p6, %rd15, %rd7;\n")
    p = bf16_cstr_append(buf, p, "    and.pred %p5, %p5, %p6; or.pred %p4, %p4, %p5; @%p4 bra L_ARG_B2; bra L_ARG_N2;\n")
    p = bf16_cstr_append(buf, p, "L_ARG_B1:\n    mov.f32 %f2, %f1; mov.u64 %rd7, %rd6; mov.f32 %f1, %f3; mov.u64 %rd6, %rd15; bra L_ARG_N2;\n")
    p = bf16_cstr_append(buf, p, "L_ARG_B2:\n    mov.f32 %f2, %f3; mov.u64 %rd7, %rd15;\n")
    p = bf16_cstr_append(buf, p, "L_ARG_N2:\n    add.u64 %rd8, %rd8, 1; bra L_ARG_L2;\n")
    p = bf16_cstr_append(buf, p, "L_ARG_OUT:\n    st.global.u64 [%rd2], %rd6; st.global.u64 [%rd2+8], %rd7;\n")
    p = bf16_cstr_append(buf, p, "    mov.b32 %r2, %f1; st.global.u32 [%rd2+16], %r2;\n")
    p = bf16_cstr_append(buf, p, "    mov.b32 %r3, %f2; st.global.u32 [%rd2+20], %r3;\n")
    p = bf16_cstr_append(buf, p, "L_ARG_EXIT:\n    ret;\n}\n\n")
    p
}

fn ptx_cr_emit_q4_quant_and_scale(buf: i64, pos: i64) -> i64 with Mut {
    var p = pos
    // 1 thread per 32-element block; matches qwen3_quantize_{bf16,f32}_q4_eisa exact format (20B/blk)
    p = bf16_cstr_append(buf, p, ".visible .entry cuda_quantize_q4_eisa(\n")
    p = bf16_cstr_append(buf, p, "    .param .u64 p_src, .param .u64 p_dst, .param .u64 p_out,\n")
    p = bf16_cstr_append(buf, p, "    .param .u64 p_in, .param .u64 p_bf16, .param .u64 p_dmy\n) {\n")
    p = bf16_cstr_append(buf, p, "    .reg .pred %p<8>; .reg .u16 %hu<6>; .reg .f16 %hf<4>;\n")
    p = bf16_cstr_append(buf, p, "    .reg .b32 %r<16>; .reg .s32 %rs<8>; .reg .b64 %rd<22>; .reg .f32 %f<18>;\n")
    p = bf16_cstr_append(buf, p, "    ld.param.u64 %rd1, [p_src]; ld.param.u64 %rd2, [p_dst];\n")
    p = bf16_cstr_append(buf, p, "    ld.param.u64 %rd3, [p_out]; ld.param.u64 %rd4, [p_in]; ld.param.u64 %rd5, [p_bf16];\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd6, %rd4, 31; shr.u64 %rd6, %rd6, 5; mul.lo.u64 %rd7, %rd3, %rd6;\n")
    p = bf16_cstr_append(buf, p, "    mov.u32 %r1, %ctaid.x; mov.u32 %r2, %ntid.x; mov.u32 %r3, %tid.x;\n")
    p = bf16_cstr_append(buf, p, "    mad.lo.u32 %r1, %r1, %r2, %r3; cvt.u64.u32 %rd8, %r1;\n")
    p = bf16_cstr_append(buf, p, "    setp.ge.u64 %p1, %rd8, %rd7; @%p1 bra L_QNT_EXIT;\n")
    p = bf16_cstr_append(buf, p, "    div.u64 %rd9, %rd8, %rd6; rem.u64 %rd10, %rd8, %rd6;\n")
    p = bf16_cstr_append(buf, p, "    mul.lo.u64 %rd11, %rd9, %rd4; shl.b64 %rd12, %rd10, 5;\n")
    p = bf16_cstr_append(buf, p, "    mul.lo.u64 %rd13, %rd8, 20; add.u64 %rd13, %rd2, %rd13;\n")
    p = bf16_cstr_append(buf, p, "    setp.ne.u64 %p2, %rd5, 0; mov.f32 %f1, 0f00000000; mov.u64 %rd14, 0;\n")
    p = bf16_cstr_append(buf, p, "L_QNT_MAX:\n    setp.ge.u64 %p3, %rd14, 32; @%p3 bra L_QNT_SCALE;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd15, %rd12, %rd14; setp.lt.u64 %p4, %rd15, %rd4; @!%p4 bra L_QNT_MN;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd16, %rd11, %rd15;\n")
    p = bf16_cstr_append(buf, p, "    @%p2 shl.b64 %rd17, %rd16, 1; @!%p2 shl.b64 %rd17, %rd16, 2; add.u64 %rd17, %rd1, %rd17;\n")
    p = bf16_cstr_append(buf, p, "    @%p2 ld.global.u16 %r4, [%rd17]; @%p2 cvt.u32.u16 %r4, %r4; @%p2 shl.b32 %r4, %r4, 16; @%p2 mov.b32 %f2, %r4;\n")
    p = bf16_cstr_append(buf, p, "    @!%p2 ld.global.f32 %f2, [%rd17]; abs.ftz.f32 %f2, %f2; max.ftz.f32 %f1, %f1, %f2;\n")
    p = bf16_cstr_append(buf, p, "L_QNT_MN:\n    add.u64 %rd14, %rd14, 1; bra L_QNT_MAX;\nL_QNT_SCALE:\n")
    p = bf16_cstr_append(buf, p, "    setp.gt.ftz.f32 %p3, %f1, 0f00000000; @!%p3 mov.u16 %hu1, 0; @!%p3 bra L_QNT_SOK;\n")
    p = bf16_cstr_append(buf, p, "    div.rn.ftz.f32 %f3, %f1, 0f40E00000; cvt.rn.f16.f32 %hf1, %f3; mov.b16 %hu1, %hf1;\n")
    p = bf16_cstr_append(buf, p, "L_QNT_SOK:\n    mov.b16 %hf1, %hu1; cvt.f32.f16 %f4, %hf1;\n")
    p = bf16_cstr_append(buf, p, "    setp.gt.ftz.f32 %p3, %f4, 0f00000000; @%p3 div.rn.ftz.f32 %f5, 0f3F800000, %f4; @!%p3 mov.f32 %f5, 0f00000000;\n")
    p = bf16_cstr_append(buf, p, "    mov.f32 %f6, 0f00000000; mov.u64 %rd14, 0;\n")
    p = bf16_cstr_append(buf, p, "L_QNT_PACK:\n    setp.ge.u64 %p3, %rd14, 16; @%p3 bra L_QNT_RHO;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd18, %rd14, 1; add.u64 %rd15, %rd12, %rd18;\n")
    p = bf16_cstr_append(buf, p, "    setp.lt.u64 %p4, %rd15, %rd4; @!%p4 mov.f32 %f7, 0f00000000; @!%p4 bra L_QNT_V0;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd16, %rd11, %rd15;\n")
    p = bf16_cstr_append(buf, p, "    @%p2 shl.b64 %rd17, %rd16, 1; @!%p2 shl.b64 %rd17, %rd16, 2; add.u64 %rd17, %rd1, %rd17;\n")
    p = bf16_cstr_append(buf, p, "    @%p2 ld.global.u16 %r4, [%rd17]; @%p2 cvt.u32.u16 %r4, %r4; @%p2 shl.b32 %r4, %r4, 16; @%p2 mov.b32 %f7, %r4;\n")
    p = bf16_cstr_append(buf, p, "    @!%p2 ld.global.f32 %f7, [%rd17];\n")
    p = bf16_cstr_append(buf, p, "L_QNT_V0:\n    mul.rn.ftz.f32 %f8, %f7, %f5; setp.ge.ftz.f32 %p5, %f8, 0f00000000;\n")
    p = bf16_cstr_append(buf, p, "    selp.f32 %f9, 0f3F000000, 0fBF000000, %p5; add.rn.ftz.f32 %f8, %f8, %f9;\n")
    p = bf16_cstr_append(buf, p, "    cvt.rzi.s32.f32 %rs1, %f8; max.s32 %rs1, %rs1, -8; min.s32 %rs1, %rs1, 7;\n")
    p = bf16_cstr_append(buf, p, "    cvt.rn.f32.s32 %f10, %rs1; mul.rn.ftz.f32 %f10, %f4, %f10; sub.rn.ftz.f32 %f11, %f7, %f10; fma.rn.ftz.f32 %f6, %f11, %f11, %f6;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd15, %rd15, 1; setp.lt.u64 %p4, %rd15, %rd4;\n")
    p = bf16_cstr_append(buf, p, "    @!%p4 mov.f32 %f12, 0f00000000; @!%p4 bra L_QNT_V1;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd16, %rd11, %rd15;\n")
    p = bf16_cstr_append(buf, p, "    @%p2 shl.b64 %rd17, %rd16, 1; @!%p2 shl.b64 %rd17, %rd16, 2; add.u64 %rd17, %rd1, %rd17;\n")
    p = bf16_cstr_append(buf, p, "    @%p2 ld.global.u16 %r4, [%rd17]; @%p2 cvt.u32.u16 %r4, %r4; @%p2 shl.b32 %r4, %r4, 16; @%p2 mov.b32 %f12, %r4;\n")
    p = bf16_cstr_append(buf, p, "    @!%p2 ld.global.f32 %f12, [%rd17];\n")
    p = bf16_cstr_append(buf, p, "L_QNT_V1:\n    mul.rn.ftz.f32 %f8, %f12, %f5; setp.ge.ftz.f32 %p5, %f8, 0f00000000;\n")
    p = bf16_cstr_append(buf, p, "    selp.f32 %f9, 0f3F000000, 0fBF000000, %p5; add.rn.ftz.f32 %f8, %f8, %f9;\n")
    p = bf16_cstr_append(buf, p, "    cvt.rzi.s32.f32 %rs2, %f8; max.s32 %rs2, %rs2, -8; min.s32 %rs2, %rs2, 7;\n")
    p = bf16_cstr_append(buf, p, "    cvt.rn.f32.s32 %f13, %rs2; mul.rn.ftz.f32 %f13, %f4, %f13; sub.rn.ftz.f32 %f14, %f12, %f13; fma.rn.ftz.f32 %f6, %f14, %f14, %f6;\n")
    p = bf16_cstr_append(buf, p, "    add.s32 %rs1, %rs1, 8; and.b32 %r6, %rs1, 15; add.s32 %rs2, %rs2, 8; and.b32 %r7, %rs2, 15;\n")
    p = bf16_cstr_append(buf, p, "    shl.b32 %r7, %r7, 4; or.b32 %r6, %r6, %r7;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd19, %rd14, 4; add.u64 %rd19, %rd13, %rd19; st.global.u8 [%rd19], %r6;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd14, %rd14, 1; bra L_QNT_PACK;\nL_QNT_RHO:\n")
    p = bf16_cstr_append(buf, p, "    sqrt.rn.ftz.f32 %f15, %f6; setp.gt.ftz.f32 %p3, %f15, 0f00000000; @!%p3 mov.u16 %hu2, 0; @!%p3 bra L_QNT_WHDR;\n")
    p = bf16_cstr_append(buf, p, "    cvt.rn.f16.f32 %hf2, %f15; mov.b16 %hu2, %hf2; setp.eq.u16 %p4, %hu2, 0; @%p4 mov.u16 %hu2, 1;\n")
    p = bf16_cstr_append(buf, p, "L_QNT_RULP:\n    setp.ge.u16 %p5, %hu2, 31743; @%p5 bra L_QNT_WHDR;\n")
    p = bf16_cstr_append(buf, p, "    mov.b16 %hf2, %hu2; cvt.f32.f16 %f16, %hf2; setp.ge.ftz.f32 %p6, %f16, %f15; @%p6 bra L_QNT_WHDR;\n")
    p = bf16_cstr_append(buf, p, "    add.u16 %hu2, %hu2, 1; bra L_QNT_RULP;\nL_QNT_WHDR:\n")
    p = bf16_cstr_append(buf, p, "    st.global.u16 [%rd13], %hu1; st.global.u16 [%rd13+2], %hu2;\n")
    p = bf16_cstr_append(buf, p, "L_QNT_EXIT:\n    ret;\n}\n\n")

    // 8 warps/CTA, block_x=256, 1 warp/row -> conf+64+row*4
    p = bf16_cstr_append(buf, p, ".visible .entry cuda_compute_row_scale(\n")
    p = bf16_cstr_append(buf, p, "    .param .u64 p_w, .param .u64 p_conf, .param .u64 p_out,\n")
    p = bf16_cstr_append(buf, p, "    .param .u64 p_in, .param .u64 p_bf16, .param .u64 p_dmy\n) {\n")
    p = bf16_cstr_append(buf, p, "    .reg .pred %p<5>; .reg .b32 %r<14>; .reg .b64 %rd<18>; .reg .f32 %f<14>;\n")
    p = bf16_cstr_append(buf, p, "    ld.param.u64 %rd1, [p_w]; ld.param.u64 %rd2, [p_conf];\n")
    p = bf16_cstr_append(buf, p, "    ld.param.u64 %rd3, [p_out]; ld.param.u64 %rd4, [p_in]; ld.param.u64 %rd5, [p_bf16];\n")
    p = bf16_cstr_append(buf, p, "    mov.u32 %r1, %ctaid.x; mov.u32 %r2, %tid.x; shr.u32 %r3, %r2, 5; and.b32 %r4, %r2, 31;\n")
    p = bf16_cstr_append(buf, p, "    mad.lo.u32 %r5, %r1, 8, %r3; cvt.u64.u32 %rd6, %r5;\n")
    p = bf16_cstr_append(buf, p, "    setp.ge.u64 %p1, %rd6, %rd3; @%p1 bra L_RSC_EXIT;\n")
    p = bf16_cstr_append(buf, p, "    setp.ne.u64 %p2, %rd5, 0; mul.lo.u64 %rd7, %rd6, %rd4;\n")
    p = bf16_cstr_append(buf, p, "    cvt.u64.u32 %rd8, %r4; mov.f32 %f1, 0f00000000; mov.u64 %rd9, %rd8;\n")
    p = bf16_cstr_append(buf, p, "L_RSC_L:\n    setp.ge.u64 %p3, %rd9, %rd4; @%p3 bra L_RSC_RED;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd10, %rd7, %rd9;\n")
    p = bf16_cstr_append(buf, p, "    @%p2 shl.b64 %rd11, %rd10, 1; @!%p2 shl.b64 %rd11, %rd10, 2; add.u64 %rd11, %rd1, %rd11;\n")
    p = bf16_cstr_append(buf, p, "    @%p2 ld.global.u16 %r6, [%rd11]; @%p2 cvt.u32.u16 %r6, %r6; @%p2 shl.b32 %r6, %r6, 16; @%p2 mov.b32 %f2, %r6;\n")
    p = bf16_cstr_append(buf, p, "    @!%p2 ld.global.f32 %f2, [%rd11]; fma.rn.ftz.f32 %f1, %f2, %f2, %f1;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd9, %rd9, 32; bra L_RSC_L;\nL_RSC_RED:\n")
    p = ptx_cr_warp_sum_f32(buf, p, "%f1", "%r10", "%r11", "%f10")
    p = bf16_cstr_append(buf, p, "    setp.eq.u32 %p4, %r4, 0; @!%p4 bra L_RSC_EXIT;\n")
    p = bf16_cstr_append(buf, p, "    cvt.rn.f32.u64 %f3, %rd4; div.rn.ftz.f32 %f4, %f1, %f3; sqrt.rn.ftz.f32 %f5, %f4;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd12, %rd6, 2; add.u64 %rd13, %rd2, 64; add.u64 %rd13, %rd13, %rd12;\n")
    p = bf16_cstr_append(buf, p, "    st.global.f32 [%rd13], %f5;\n")
    p = bf16_cstr_append(buf, p, "L_RSC_EXIT:\n    ret;\n}\n\n")

    p = bf16_cstr_append(buf, p, ".visible .entry cuda_compute_tile_smax(\n")
    p = bf16_cstr_append(buf, p, "    .param .u64 p_conf, .param .u64 p_smax_off,\n")
    p = bf16_cstr_append(buf, p, "    .param .u64 p_vocab, .param .u64 p_dmy\n) {\n")
    p = bf16_cstr_append(buf, p, "    .reg .pred %p<3>; .reg .b32 %r<4>; .reg .b64 %rd<14>; .reg .f32 %f<4>;\n")
    p = bf16_cstr_append(buf, p, "    ld.param.u64 %rd1, [p_conf]; ld.param.u64 %rd2, [p_smax_off]; ld.param.u64 %rd3, [p_vocab];\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd4, %rd3, 63; shr.u64 %rd4, %rd4, 6;\n")
    p = bf16_cstr_append(buf, p, "    mov.u32 %r1, %ctaid.x; mov.u32 %r2, %ntid.x; mov.u32 %r3, %tid.x;\n")
    p = bf16_cstr_append(buf, p, "    mad.lo.u32 %r1, %r1, %r2, %r3; cvt.u64.u32 %rd5, %r1;\n")
    p = bf16_cstr_append(buf, p, "    setp.ge.u64 %p1, %rd5, %rd4; @%p1 bra L_TSM_EXIT;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd6, %rd5, 6; add.u64 %rd7, %rd6, 64; min.u64 %rd7, %rd7, %rd3;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd8, %rd1, 64; mov.f32 %f1, 0f00000000; mov.u64 %rd9, %rd6;\n")
    p = bf16_cstr_append(buf, p, "L_TSM_L:\n    setp.ge.u64 %p2, %rd9, %rd7; @%p2 bra L_TSM_ST;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd10, %rd9, 2; add.u64 %rd11, %rd8, %rd10; ld.global.f32 %f2, [%rd11];\n")
    p = bf16_cstr_append(buf, p, "    max.ftz.f32 %f1, %f1, %f2; add.u64 %rd9, %rd9, 1; bra L_TSM_L;\nL_TSM_ST:\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd12, %rd5, 2; add.u64 %rd13, %rd1, %rd2; add.u64 %rd13, %rd13, %rd12;\n")
    p = bf16_cstr_append(buf, p, "    st.global.f32 [%rd13], %f1;\nL_TSM_EXIT:\n    ret;\n}\n\n")
    p
}

fn ptx_cr_emit_q4_gemv_and_cert(buf: i64, pos: i64) -> i64 with Mut {
    var p = pos
    // 8 warps/CTA, block_x=256, 1 warp per output row
    p = bf16_cstr_append(buf, p, ".visible .entry cuda_gemv_q4_fast(\n")
    p = bf16_cstr_append(buf, p, "    .param .u64 p_wq, .param .u64 p_x, .param .u64 p_y,\n")
    p = bf16_cstr_append(buf, p, "    .param .u64 p_out, .param .u64 p_in, .param .u64 p_dmy\n) {\n")
    p = bf16_cstr_append(buf, p, "    .reg .pred %p<5>; .reg .u16 %hu<2>; .reg .f16 %hf<2>;\n")
    p = bf16_cstr_append(buf, p, "    .reg .b32 %r<16>; .reg .s32 %rs<4>; .reg .b64 %rd<22>; .reg .f32 %f<14>;\n")
    p = bf16_cstr_append(buf, p, "    ld.param.u64 %rd1, [p_wq]; ld.param.u64 %rd2, [p_x]; ld.param.u64 %rd3, [p_y];\n")
    p = bf16_cstr_append(buf, p, "    ld.param.u64 %rd4, [p_out]; ld.param.u64 %rd5, [p_in];\n")
    p = bf16_cstr_append(buf, p, "    mov.u32 %r1, %ctaid.x; mov.u32 %r2, %tid.x; shr.u32 %r3, %r2, 5; and.b32 %r4, %r2, 31;\n")
    p = bf16_cstr_append(buf, p, "    mad.lo.u32 %r5, %r1, 8, %r3; cvt.u64.u32 %rd6, %r5;\n")
    p = bf16_cstr_append(buf, p, "    setp.ge.u64 %p1, %rd6, %rd4; @%p1 bra L_Q4F_EXIT;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd7, %rd5, 31; shr.u64 %rd7, %rd7, 5;\n")
    p = bf16_cstr_append(buf, p, "    mul.lo.u64 %rd8, %rd7, 20; mul.lo.u64 %rd9, %rd6, %rd8; add.u64 %rd9, %rd1, %rd9;\n")
    p = bf16_cstr_append(buf, p, "    shr.u32 %r6, %r4, 1; add.u32 %r6, %r6, 4; cvt.u64.u32 %rd10, %r6;\n")
    p = bf16_cstr_append(buf, p, "    and.b32 %r7, %r4, 1; shl.b32 %r7, %r7, 2; cvt.u64.u32 %rd11, %r4;\n")
    p = bf16_cstr_append(buf, p, "    mov.f32 %f1, 0f00000000; mov.u64 %rd12, 0;\n")
    p = bf16_cstr_append(buf, p, "L_Q4F_B:\n    setp.ge.u64 %p2, %rd12, %rd7; @%p2 bra L_Q4F_RED;\n")
    p = bf16_cstr_append(buf, p, "    mul.lo.u64 %rd13, %rd12, 20; add.u64 %rd14, %rd9, %rd13;\n")
    p = bf16_cstr_append(buf, p, "    ld.global.u16 %hu1, [%rd14]; mov.b16 %hf1, %hu1; cvt.f32.f16 %f2, %hf1;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd15, %rd14, %rd10; ld.global.u8 %r8, [%rd15];\n")
    p = bf16_cstr_append(buf, p, "    shr.u32 %r9, %r8, %r7; and.b32 %r9, %r9, 15; sub.s32 %rs1, %r9, 8; cvt.rn.f32.s32 %f3, %rs1;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd16, %rd12, 5; add.u64 %rd16, %rd16, %rd11;\n")
    p = bf16_cstr_append(buf, p, "    setp.lt.u64 %p3, %rd16, %rd5;\n")
    p = bf16_cstr_append(buf, p, "    @%p3 shl.b64 %rd17, %rd16, 2; @%p3 add.u64 %rd17, %rd2, %rd17;\n")
    p = bf16_cstr_append(buf, p, "    @%p3 ld.global.f32 %f4, [%rd17]; @%p3 mul.rn.ftz.f32 %f5, %f3, %f4; @%p3 fma.rn.ftz.f32 %f1, %f2, %f5, %f1;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd12, %rd12, 1; bra L_Q4F_B;\nL_Q4F_RED:\n")
    p = ptx_cr_warp_sum_f32(buf, p, "%f1", "%r12", "%r13", "%f10")
    p = bf16_cstr_append(buf, p, "    setp.eq.u32 %p4, %r4, 0; @!%p4 bra L_Q4F_EXIT;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd18, %rd6, 2; add.u64 %rd19, %rd3, %rd18; st.global.f32 [%rd19], %f1;\n")
    p = bf16_cstr_append(buf, p, "L_Q4F_EXIT:\n    ret;\n}\n\n")

    // grid_x = (vocab + 63) / 64, block_x = 64 -> tile_summary[t]
    p = bf16_cstr_append(buf, p, ".visible .entry cuda_summarize_tiles_f32(\n")
    p = bf16_cstr_append(buf, p, "    .param .u64 p_val, .param .u64 p_conf,\n")
    p = bf16_cstr_append(buf, p, "    .param .u64 p_tsum_off, .param .u64 p_vocab\n) {\n")
    p = bf16_cstr_append(buf, p, "    .shared .align 8 .b8 smem[256];\n")
    p = bf16_cstr_append(buf, p, "    .reg .pred %p<5>; .reg .b32 %r<8>; .reg .b64 %rd<16>; .reg .f32 %f<6>;\n")
    p = bf16_cstr_append(buf, p, "    ld.param.u64 %rd1, [p_val]; ld.param.u64 %rd2, [p_conf];\n")
    p = bf16_cstr_append(buf, p, "    ld.param.u64 %rd3, [p_tsum_off]; ld.param.u64 %rd4, [p_vocab];\n")
    p = bf16_cstr_append(buf, p, "    mov.u32 %r1, %ctaid.x; cvt.u64.u32 %rd5, %r1; add.u64 %rd6, %rd4, 63; shr.u64 %rd6, %rd6, 6;\n")
    p = bf16_cstr_append(buf, p, "    setp.ge.u64 %p1, %rd5, %rd6; @%p1 bra L_TIL_EXIT;\n")
    p = bf16_cstr_append(buf, p, "    cvta.shared.u64 %rd7, smem; mov.u32 %r2, %tid.x; cvt.u64.u32 %rd8, %r2;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd9, %rd5, 6; add.u64 %rd10, %rd9, %rd8; setp.lt.u64 %p2, %rd10, %rd4;\n")
    p = bf16_cstr_append(buf, p, "    @%p2 shl.b64 %rd11, %rd10, 2; @%p2 add.u64 %rd11, %rd1, %rd11;\n")
    p = bf16_cstr_append(buf, p, "    @%p2 ld.global.f32 %f1, [%rd11]; @!%p2 mov.f32 %f1, 0fFF800000;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd12, %rd8, 2; add.u64 %rd12, %rd7, %rd12; st.f32 [%rd12], %f1; bar.sync 0;\n")
    p = bf16_cstr_append(buf, p, "    setp.eq.u32 %p1, %r2, 0; @!%p1 bra L_TIL_EXIT;\n")
    p = bf16_cstr_append(buf, p, "    mov.f32 %f2, 0fFF800000; mov.f32 %f3, 0fFF800000; mov.u64 %rd13, -1; mov.u64 %rd14, -1;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd15, %rd9, 64; min.u64 %rd15, %rd15, %rd4; sub.u64 %rd15, %rd15, %rd9; mov.u64 %rd8, 0;\n")
    p = bf16_cstr_append(buf, p, "L_TIL_L:\n    setp.ge.u64 %p2, %rd8, %rd15; @%p2 bra L_TIL_ST;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd12, %rd8, 2; add.u64 %rd12, %rd7, %rd12; ld.f32 %f4, [%rd12]; add.u64 %rd10, %rd9, %rd8;\n")
    p = bf16_cstr_append(buf, p, "    setp.gt.ftz.f32 %p3, %f4, %f2; @%p3 bra L_TIL_B1;\n")
    p = bf16_cstr_append(buf, p, "    setp.gt.ftz.f32 %p4, %f4, %f3; @%p4 bra L_TIL_B2; bra L_TIL_NX;\n")
    p = bf16_cstr_append(buf, p, "L_TIL_B1:\n    mov.f32 %f3, %f2; mov.u64 %rd14, %rd13; mov.f32 %f2, %f4; mov.u64 %rd13, %rd10; bra L_TIL_NX;\n")
    p = bf16_cstr_append(buf, p, "L_TIL_B2:\n    mov.f32 %f3, %f4; mov.u64 %rd14, %rd10;\n")
    p = bf16_cstr_append(buf, p, "L_TIL_NX:\n    add.u64 %rd8, %rd8, 1; bra L_TIL_L;\nL_TIL_ST:\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd11, %rd5, 5; add.u64 %rd12, %rd2, %rd3; add.u64 %rd12, %rd12, %rd11;\n")
    p = bf16_cstr_append(buf, p, "    st.global.u64 [%rd12], %rd13; st.global.u64 [%rd12+8], %rd14;\n")
    p = bf16_cstr_append(buf, p, "    mov.b32 %r3, %f2; st.global.u32 [%rd12+16], %r3; mov.b32 %r4, %f3; st.global.u32 [%rd12+20], %r4;\n")
    p = bf16_cstr_append(buf, p, "L_TIL_EXIT:\n    ret;\n}\n\n")

    // grid_x = 1, block_x = 256; exact port of qwen3_certify_pruned_conformal_f32
    p = bf16_cstr_append(buf, p, ".visible .entry cuda_certify_pruned_conformal(\n")
    p = bf16_cstr_append(buf, p, "    .param .u64 p_val, .param .u64 p_conf, .param .u64 p_smax_off,\n")
    p = bf16_cstr_append(buf, p, "    .param .u64 p_tsum_off, .param .u64 p_out, .param .u64 p_vocab\n) {\n")
    p = bf16_cstr_append(buf, p, "    .shared .align 8 .b8 smem[11328];\n")
    p = bf16_cstr_append(buf, p, "    .reg .pred %p<9>; .reg .b32 %r<10>; .reg .b64 %rd<36>; .reg .f32 %f<18>;\n")
    p = bf16_cstr_append(buf, p, "    ld.param.u64 %rd1, [p_val]; ld.param.u64 %rd2, [p_conf];\n")
    p = bf16_cstr_append(buf, p, "    ld.param.u64 %rd3, [p_smax_off]; ld.param.u64 %rd4, [p_tsum_off];\n")
    p = bf16_cstr_append(buf, p, "    ld.param.u64 %rd5, [p_out]; ld.param.u64 %rd6, [p_vocab];\n")
    p = bf16_cstr_append(buf, p, "    setp.eq.u64 %p1, %rd6, 0; @%p1 bra L_CRT_EXIT;\n")
    p = bf16_cstr_append(buf, p, "    cvta.shared.u64 %rd7, smem; mov.u32 %r1, %tid.x; cvt.u64.u32 %rd8, %r1;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd9, %rd2, %rd3; add.u64 %rd10, %rd2, %rd4; add.u64 %rd11, %rd2, 64;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd12, %rd6, 63; shr.u64 %rd12, %rd12, 6;\n")
    p = bf16_cstr_append(buf, p, "    mov.f32 %f1, 0fFF800000; mov.f32 %f2, 0fFF800000; mov.u64 %rd13, -1; mov.u64 %rd14, -1; mov.u64 %rd15, %rd8;\n")
    p = bf16_cstr_append(buf, p, "L_CRT_T1:\n    setp.ge.u64 %p2, %rd15, %rd12; @%p2 bra L_CRT_ST1;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd16, %rd15, 5; add.u64 %rd17, %rd10, %rd16;\n")
    p = bf16_cstr_append(buf, p, "    ld.global.u64 %rd18, [%rd17]; ld.global.u64 %rd19, [%rd17+8];\n")
    p = bf16_cstr_append(buf, p, "    ld.global.f32 %f3, [%rd17+16]; ld.global.f32 %f4, [%rd17+20];\n")
    p = bf16_cstr_append(buf, p, "    setp.eq.u64 %p3, %rd18, -1; @%p3 bra L_CRT_A2;\n")
    p = bf16_cstr_append(buf, p, "    setp.gt.ftz.f32 %p4, %f3, %f1; setp.eq.ftz.f32 %p5, %f3, %f1; setp.lt.u64 %p6, %rd18, %rd13;\n")
    p = bf16_cstr_append(buf, p, "    and.pred %p5, %p5, %p6; or.pred %p4, %p4, %p5; @%p4 bra L_CRT_A1B1;\n")
    p = bf16_cstr_append(buf, p, "    setp.gt.ftz.f32 %p4, %f3, %f2; setp.eq.ftz.f32 %p5, %f3, %f2; setp.lt.u64 %p6, %rd18, %rd14;\n")
    p = bf16_cstr_append(buf, p, "    and.pred %p5, %p5, %p6; or.pred %p4, %p4, %p5; @%p4 bra L_CRT_A1B2; bra L_CRT_A2;\n")
    p = bf16_cstr_append(buf, p, "L_CRT_A1B1:\n    mov.f32 %f2, %f1; mov.u64 %rd14, %rd13; mov.f32 %f1, %f3; mov.u64 %rd13, %rd18; bra L_CRT_A2;\n")
    p = bf16_cstr_append(buf, p, "L_CRT_A1B2:\n    mov.f32 %f2, %f3; mov.u64 %rd14, %rd18;\n")
    p = bf16_cstr_append(buf, p, "L_CRT_A2:\n    setp.eq.u64 %p3, %rd19, -1; @%p3 bra L_CRT_T1N;\n")
    p = bf16_cstr_append(buf, p, "    setp.gt.ftz.f32 %p4, %f4, %f1; setp.eq.ftz.f32 %p5, %f4, %f1; setp.lt.u64 %p6, %rd19, %rd13;\n")
    p = bf16_cstr_append(buf, p, "    and.pred %p5, %p5, %p6; or.pred %p4, %p4, %p5; @%p4 bra L_CRT_A2B1;\n")
    p = bf16_cstr_append(buf, p, "    setp.gt.ftz.f32 %p4, %f4, %f2; setp.eq.ftz.f32 %p5, %f4, %f2; setp.lt.u64 %p6, %rd19, %rd14;\n")
    p = bf16_cstr_append(buf, p, "    and.pred %p5, %p5, %p6; or.pred %p4, %p4, %p5; @%p4 bra L_CRT_A2B2; bra L_CRT_T1N;\n")
    p = bf16_cstr_append(buf, p, "L_CRT_A2B1:\n    mov.f32 %f2, %f1; mov.u64 %rd14, %rd13; mov.f32 %f1, %f4; mov.u64 %rd13, %rd19; bra L_CRT_T1N;\n")
    p = bf16_cstr_append(buf, p, "L_CRT_A2B2:\n    mov.f32 %f2, %f4; mov.u64 %rd14, %rd19;\n")
    p = bf16_cstr_append(buf, p, "L_CRT_T1N:\n    add.u64 %rd15, %rd15, 256; bra L_CRT_T1;\n")
    p = bf16_cstr_append(buf, p, "L_CRT_ST1:\n    shl.b64 %rd20, %rd8, 2; add.u64 %rd21, %rd7, %rd20; st.f32 [%rd21], %f1; st.f32 [%rd21+1024], %f2;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd22, %rd8, 3; add.u64 %rd23, %rd7, 2048; add.u64 %rd23, %rd23, %rd22;\n")
    p = bf16_cstr_append(buf, p, "    st.u64 [%rd23], %rd13; st.u64 [%rd23+2048], %rd14; bar.sync 0;\n")
    p = bf16_cstr_append(buf, p, "    setp.eq.u32 %p2, %r1, 0; @!%p2 bra L_CRT_B2;\n")
    p = bf16_cstr_append(buf, p, "    mov.f32 %f1, 0fFF800000; mov.f32 %f2, 0fFF800000; mov.u64 %rd13, -1; mov.u64 %rd14, -1; mov.u64 %rd15, 0;\n")
    p = bf16_cstr_append(buf, p, "L_CRT_G:\n    setp.ge.u64 %p3, %rd15, 512; @%p3 bra L_CRT_GD;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd20, %rd15, 2; add.u64 %rd21, %rd7, %rd20; ld.f32 %f3, [%rd21];\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd22, %rd15, 3; add.u64 %rd23, %rd7, 2048; add.u64 %rd23, %rd23, %rd22; ld.u64 %rd18, [%rd23];\n")
    p = bf16_cstr_append(buf, p, "    setp.eq.u64 %p4, %rd18, -1; @%p4 bra L_CRT_GN;\n")
    p = bf16_cstr_append(buf, p, "    setp.gt.ftz.f32 %p5, %f3, %f1; setp.eq.ftz.f32 %p6, %f3, %f1; setp.lt.u64 %p7, %rd18, %rd13;\n")
    p = bf16_cstr_append(buf, p, "    and.pred %p6, %p6, %p7; or.pred %p5, %p5, %p6; @%p5 bra L_CRT_GB1;\n")
    p = bf16_cstr_append(buf, p, "    setp.gt.ftz.f32 %p5, %f3, %f2; setp.eq.ftz.f32 %p6, %f3, %f2; setp.lt.u64 %p7, %rd18, %rd14;\n")
    p = bf16_cstr_append(buf, p, "    and.pred %p6, %p6, %p7; or.pred %p5, %p5, %p6; @%p5 bra L_CRT_GB2; bra L_CRT_GN;\n")
    p = bf16_cstr_append(buf, p, "L_CRT_GB1:\n    mov.f32 %f2, %f1; mov.u64 %rd14, %rd13; mov.f32 %f1, %f3; mov.u64 %rd13, %rd18; bra L_CRT_GN;\n")
    p = bf16_cstr_append(buf, p, "L_CRT_GB2:\n    mov.f32 %f2, %f3; mov.u64 %rd14, %rd18;\n")
    p = bf16_cstr_append(buf, p, "L_CRT_GN:\n    add.u64 %rd15, %rd15, 1; bra L_CRT_G;\nL_CRT_GD:\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd24, %rd7, 11264; st.u64 [%rd24], %rd13; st.u64 [%rd24+8], %rd14; st.f32 [%rd24+16], %f1;\n")
    p = bf16_cstr_append(buf, p, "    ld.global.f32 %f5, [%rd2]; max.ftz.f32 %f5, %f5, 0f358637BD;\n")
    p = bf16_cstr_append(buf, p, "    ld.global.f32 %f6, [%rd2+4]; max.ftz.f32 %f6, %f6, 0f00000000; mul.rn.ftz.f32 %f7, %f6, %f5;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd25, %rd13, 2; add.u64 %rd25, %rd11, %rd25; ld.global.f32 %f8, [%rd25];\n")
    p = bf16_cstr_append(buf, p, "    mul.rn.ftz.f32 %f9, %f7, %f8; sub.rn.ftz.f32 %f10, %f1, %f9;\n")
    p = bf16_cstr_append(buf, p, "    st.f32 [%rd24+20], %f9; st.f32 [%rd24+24], %f10; st.f32 [%rd24+28], %f7;\n")
    p = bf16_cstr_append(buf, p, "    setp.gt.u64 %p3, %rd6, 1; setp.lt.u64 %p4, %rd14, %rd6; and.pred %p3, %p3, %p4;\n")
    p = bf16_cstr_append(buf, p, "    @!%p3 mov.f32 %f11, 0fFF800000; @!%p3 bra L_CRT_RU;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd25, %rd14, 2; add.u64 %rd25, %rd11, %rd25; ld.global.f32 %f12, [%rd25];\n")
    p = bf16_cstr_append(buf, p, "    fma.rn.ftz.f32 %f11, %f7, %f12, %f2;\nL_CRT_RU:\n    st.f32 [%rd24+32], %f11;\n")
    p = bf16_cstr_append(buf, p, "L_CRT_B2:\n    bar.sync 0; add.u64 %rd24, %rd7, 11264;\n")
    p = bf16_cstr_append(buf, p, "    ld.u64 %rd13, [%rd24]; ld.f32 %f10, [%rd24+24]; ld.f32 %f7, [%rd24+28]; ld.f32 %f11, [%rd24+32];\n")
    p = bf16_cstr_append(buf, p, "    shr.u64 %rd26, %rd13, 6; mov.u64 %rd27, 0; mov.f32 %f13, 0fFF800000; mov.u64 %rd28, 0; mov.u64 %rd15, %rd8;\n")
    p = bf16_cstr_append(buf, p, "L_CRT_P:\n    setp.ge.u64 %p2, %rd15, %rd12; @%p2 bra L_CRT_PST;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd16, %rd15, 5; add.u64 %rd17, %rd10, %rd16; ld.global.f32 %f14, [%rd17+16];\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd29, %rd15, 2; add.u64 %rd30, %rd9, %rd29; ld.global.f32 %f15, [%rd30];\n")
    p = bf16_cstr_append(buf, p, "    fma.rn.ftz.f32 %f16, %f7, %f15, %f14;\n")
    p = bf16_cstr_append(buf, p, "    setp.ne.u64 %p3, %rd15, %rd26; setp.lt.ftz.f32 %p4, %f16, %f10; setp.le.ftz.f32 %p5, %f16, %f11;\n")
    p = bf16_cstr_append(buf, p, "    and.pred %p3, %p3, %p4; and.pred %p3, %p3, %p5; @!%p3 bra L_CRT_SCAN;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd28, %rd28, 1; bra L_CRT_PN;\nL_CRT_SCAN:\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd31, %rd15, 6; add.u64 %rd32, %rd31, 64; min.u64 %rd32, %rd32, %rd6; mov.u64 %rd33, %rd31;\n")
    p = bf16_cstr_append(buf, p, "L_CRT_R:\n    setp.ge.u64 %p4, %rd33, %rd32; @%p4 bra L_CRT_PN;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd34, %rd33, 2; add.u64 %rd35, %rd11, %rd34; ld.global.f32 %f14, [%rd35];\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd35, %rd1, %rd34; ld.global.f32 %f15, [%rd35]; fma.rn.ftz.f32 %f16, %f7, %f14, %f15;\n")
    p = bf16_cstr_append(buf, p, "    setp.ge.ftz.f32 %p5, %f16, %f10; @%p5 add.u64 %rd27, %rd27, 1;\n")
    p = bf16_cstr_append(buf, p, "    setp.ne.u64 %p6, %rd33, %rd13; @%p6 max.ftz.f32 %f13, %f13, %f16;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd33, %rd33, 1; bra L_CRT_R;\nL_CRT_PN:\n    add.u64 %rd15, %rd15, 256; bra L_CRT_P;\n")
    p = bf16_cstr_append(buf, p, "L_CRT_PST:\n    shl.b64 %rd22, %rd8, 3; add.u64 %rd23, %rd7, 6144; add.u64 %rd23, %rd23, %rd22;\n")
    p = bf16_cstr_append(buf, p, "    st.u64 [%rd23], %rd27; shl.b64 %rd20, %rd8, 2; add.u64 %rd21, %rd7, 8192; add.u64 %rd21, %rd21, %rd20;\n")
    p = bf16_cstr_append(buf, p, "    st.f32 [%rd21], %f13; add.u64 %rd23, %rd7, 9216; add.u64 %rd23, %rd23, %rd22; st.u64 [%rd23], %rd28;\n")
    p = bf16_cstr_append(buf, p, "    bar.sync 0; setp.eq.u32 %p2, %r1, 0; @!%p2 bra L_CRT_EXIT;\n")
    p = bf16_cstr_append(buf, p, "    mov.u64 %rd27, 0; mov.u64 %rd28, 0; setp.gt.u64 %p3, %rd6, 1; @%p3 mov.f32 %f13, %f11; @!%p3 mov.f32 %f13, 0fFF800000;\n")
    p = bf16_cstr_append(buf, p, "    mov.u64 %rd15, 0;\nL_CRT_F:\n    setp.ge.u64 %p4, %rd15, 256; @%p4 bra L_CRT_FD;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd22, %rd15, 3; add.u64 %rd23, %rd7, 6144; add.u64 %rd23, %rd23, %rd22; ld.u64 %rd30, [%rd23]; add.u64 %rd27, %rd27, %rd30;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd20, %rd15, 2; add.u64 %rd21, %rd7, 8192; add.u64 %rd21, %rd21, %rd20; ld.f32 %f14, [%rd21]; max.ftz.f32 %f13, %f13, %f14;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd23, %rd7, 9216; add.u64 %rd23, %rd23, %rd22; ld.u64 %rd30, [%rd23]; add.u64 %rd28, %rd28, %rd30;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd15, %rd15, 1; bra L_CRT_F;\nL_CRT_FD:\n")
    p = bf16_cstr_append(buf, p, "    setp.le.u64 %p4, %rd6, 1; @%p4 mov.f32 %f13, 0f00000000; sub.rn.ftz.f32 %f17, %f10, %f13;\n")
    p = bf16_cstr_append(buf, p, "    setp.eq.u64 %p5, %rd6, 1; setp.gt.ftz.f32 %p6, %f17, 0f00000000; or.pred %p5, %p5, %p6;\n")
    p = bf16_cstr_append(buf, p, "    selp.u64 %rd31, 1, 0, %p5; selp.u64 %rd32, 1, %rd27, %p5;\n")
    p = bf16_cstr_append(buf, p, "    ld.u64 %rd14, [%rd24+8]; ld.f32 %f1, [%rd24+16]; ld.f32 %f9, [%rd24+20];\n")
    p = bf16_cstr_append(buf, p, "    st.global.u64 [%rd5], %rd13; st.global.u64 [%rd5+8], %rd14; st.global.u64 [%rd5+16], %rd32;\n")
    p = bf16_cstr_append(buf, p, "    st.global.u64 [%rd5+24], %rd31; st.global.u64 [%rd5+48], %rd28;\n")
    p = bf16_cstr_append(buf, p, "    mov.b32 %r2, %f1; st.global.u32 [%rd5+32], %r2; mov.b32 %r3, %f9; st.global.u32 [%rd5+36], %r3;\n")
    p = bf16_cstr_append(buf, p, "    mov.b32 %r4, %f13; st.global.u32 [%rd5+40], %r4; mov.b32 %r5, %f17; st.global.u32 [%rd5+44], %r5;\n")
    p = bf16_cstr_append(buf, p, "    st.global.u64 [%rd2+8], %rd28;\n")
    p = bf16_cstr_append(buf, p, "L_CRT_EXIT:\n    ret;\n}\n\n")
    p
}

fn ptx_cr_emit_q4s_pack_word(buf: i64, pos: i64, dst_reg: string, k_off: string, lbl: string) -> i64 with Mut {
    var p = pos
    p = bf16_cstr_append(buf, p, "    mov.b32 ")
    p = bf16_cstr_append(buf, p, dst_reg)
    p = bf16_cstr_append(buf, p, ", 0; mov.u64 %rd16, 0;\n")
    p = bf16_cstr_append(buf, p, lbl)
    p = bf16_cstr_append(buf, p, "_L:\n    setp.ge.u64 %p3, %rd16, 4; @%p3 bra ")
    p = bf16_cstr_append(buf, p, lbl)
    p = bf16_cstr_append(buf, p, "_D;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd17, %rd16, 1; add.u64 %rd17, %rd17, ")
    p = bf16_cstr_append(buf, p, k_off)
    p = bf16_cstr_append(buf, p, "; add.u64 %rd18, %rd14, %rd17;\n")
    p = bf16_cstr_append(buf, p, "    setp.lt.u64 %p4, %rd18, %rd6; @!%p4 mov.f32 %f7, 0f00000000; @!%p4 bra ")
    p = bf16_cstr_append(buf, p, lbl)
    p = bf16_cstr_append(buf, p, "_V0;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd19, %rd13, %rd18; @%p2 shl.b64 %rd20, %rd19, 1; @!%p2 shl.b64 %rd20, %rd19, 2; add.u64 %rd20, %rd1, %rd20;\n")
    p = bf16_cstr_append(buf, p, "    @%p2 ld.global.u16 %r4, [%rd20]; @%p2 cvt.u32.u16 %r4, %r4; @%p2 shl.b32 %r4, %r4, 16; @%p2 mov.b32 %f7, %r4;\n")
    p = bf16_cstr_append(buf, p, "    @!%p2 ld.global.f32 %f7, [%rd20];\n")
    p = bf16_cstr_append(buf, p, lbl)
    p = bf16_cstr_append(buf, p, "_V0:\n    mul.rn.ftz.f32 %f8, %f7, %f5; setp.ge.ftz.f32 %p5, %f8, 0f00000000;\n")
    p = bf16_cstr_append(buf, p, "    selp.f32 %f9, 0f3F000000, 0fBF000000, %p5; add.rn.ftz.f32 %f8, %f8, %f9;\n")
    p = bf16_cstr_append(buf, p, "    cvt.rzi.s32.f32 %rs1, %f8; max.s32 %rs1, %rs1, -8; min.s32 %rs1, %rs1, 7;\n")
    p = bf16_cstr_append(buf, p, "    @%p7 cvt.rn.f32.s32 %f10, %rs1; @%p7 mul.rn.ftz.f32 %f10, %f4, %f10; @%p7 sub.rn.ftz.f32 %f11, %f7, %f10; @%p7 fma.rn.ftz.f32 %f6, %f11, %f11, %f6;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd18, %rd18, 1; setp.lt.u64 %p4, %rd18, %rd6; @!%p4 mov.f32 %f12, 0f00000000; @!%p4 bra ")
    p = bf16_cstr_append(buf, p, lbl)
    p = bf16_cstr_append(buf, p, "_V1;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd19, %rd13, %rd18; @%p2 shl.b64 %rd20, %rd19, 1; @!%p2 shl.b64 %rd20, %rd19, 2; add.u64 %rd20, %rd1, %rd20;\n")
    p = bf16_cstr_append(buf, p, "    @%p2 ld.global.u16 %r4, [%rd20]; @%p2 cvt.u32.u16 %r4, %r4; @%p2 shl.b32 %r4, %r4, 16; @%p2 mov.b32 %f12, %r4;\n")
    p = bf16_cstr_append(buf, p, "    @!%p2 ld.global.f32 %f12, [%rd20];\n")
    p = bf16_cstr_append(buf, p, lbl)
    p = bf16_cstr_append(buf, p, "_V1:\n    mul.rn.ftz.f32 %f8, %f12, %f5; setp.ge.ftz.f32 %p5, %f8, 0f00000000;\n")
    p = bf16_cstr_append(buf, p, "    selp.f32 %f9, 0f3F000000, 0fBF000000, %p5; add.rn.ftz.f32 %f8, %f8, %f9;\n")
    p = bf16_cstr_append(buf, p, "    cvt.rzi.s32.f32 %rs2, %f8; max.s32 %rs2, %rs2, -8; min.s32 %rs2, %rs2, 7;\n")
    p = bf16_cstr_append(buf, p, "    @%p7 cvt.rn.f32.s32 %f13, %rs2; @%p7 mul.rn.ftz.f32 %f13, %f4, %f13; @%p7 sub.rn.ftz.f32 %f14, %f12, %f13; @%p7 fma.rn.ftz.f32 %f6, %f14, %f14, %f6;\n")
    p = bf16_cstr_append(buf, p, "    add.s32 %rs1, %rs1, 8; and.b32 %r6, %rs1, 15; add.s32 %rs2, %rs2, 8; and.b32 %r7, %rs2, 15;\n")
    p = bf16_cstr_append(buf, p, "    shl.b32 %r7, %r7, 4; or.b32 %r6, %r6, %r7;\n")
    p = bf16_cstr_append(buf, p, "    cvt.u32.u64 %r8, %rd16; shl.b32 %r8, %r8, 3; shl.b32 %r6, %r6, %r8; or.b32 ")
    p = bf16_cstr_append(buf, p, dst_reg)
    p = bf16_cstr_append(buf, p, ", ")
    p = bf16_cstr_append(buf, p, dst_reg)
    p = bf16_cstr_append(buf, p, ", %r6;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd16, %rd16, 1; bra ")
    p = bf16_cstr_append(buf, p, lbl)
    p = bf16_cstr_append(buf, p, "_L;\n")
    p = bf16_cstr_append(buf, p, lbl)
    p = bf16_cstr_append(buf, p, "_D:\n")
    p
}

fn ptx_cr_emit_q4s_dot_word(buf: i64, pos: i64, w_reg: string, x_byte_off: string) -> i64 with Mut {
    var p = pos
    p = bf16_cstr_append(buf, p, "    add.u64 %rd17, %rd16, ")
    p = bf16_cstr_append(buf, p, x_byte_off)
    p = bf16_cstr_append(buf, p, "; ld.global.v4.f32 {%f4, %f5, %f6, %f7}, [%rd17];\n")
    p = bf16_cstr_append(buf, p, "    ld.global.v4.f32 {%f8, %f9, %f10, %f11}, [%rd17+16];\n")
    var nib: i64 = 0
    while nib < 8 {
        let freg = if nib == 0 { "%f4" } else if nib == 1 { "%f5" } else if nib == 2 { "%f6" } else if nib == 3 { "%f7" }
            else if nib == 4 { "%f8" } else if nib == 5 { "%f9" } else if nib == 6 { "%f10" } else { "%f11" }
        let sh = if nib == 0 { "0" } else if nib == 1 { "4" } else if nib == 2 { "8" } else if nib == 3 { "12" }
            else if nib == 4 { "16" } else if nib == 5 { "20" } else if nib == 6 { "24" } else { "28" }
        if nib == 0 {
            p = bf16_cstr_append(buf, p, "    and.b32 %r14, ")
            p = bf16_cstr_append(buf, p, w_reg)
            p = bf16_cstr_append(buf, p, ", 15; ")
        } else {
            p = bf16_cstr_append(buf, p, "    shr.u32 %r14, ")
            p = bf16_cstr_append(buf, p, w_reg)
            p = bf16_cstr_append(buf, p, ", ")
            p = bf16_cstr_append(buf, p, sh)
            p = bf16_cstr_append(buf, p, "; and.b32 %r14, %r14, 15; ")
        }
        p = bf16_cstr_append(buf, p, "add.s32 %rs1, %r14, -8; cvt.rn.f32.s32 %f12, %rs1; fma.rn.ftz.f32 %f16, %f12, ")
        p = bf16_cstr_append(buf, p, freg)
        p = bf16_cstr_append(buf, p, ", %f16;\n")
        nib = nib + 1
    }
    p
}

fn ptx_cr_emit_q4_soa(buf: i64, pos: i64) -> i64 with Mut {
    var p = pos
    // 1 thread per 32-element block; writes 16B-aligned SoA nibbles (v4.b32), contiguous u16 scales, optional rhos
    p = bf16_cstr_append(buf, p, ".visible .entry cuda_quantize_q4_soa(\n")
    p = bf16_cstr_append(buf, p, "    .param .u64 p_src, .param .u64 p_nib, .param .u64 p_scl, .param .u64 p_rho,\n")
    p = bf16_cstr_append(buf, p, "    .param .u64 p_out, .param .u64 p_in, .param .u64 p_flags, .param .u64 p_dmy\n) {\n")
    p = bf16_cstr_append(buf, p, "    .reg .pred %p<9>; .reg .u16 %hu<4>; .reg .f16 %hf<4>;\n")
    p = bf16_cstr_append(buf, p, "    .reg .b32 %r<26>; .reg .s32 %rs<6>; .reg .b64 %rd<26>; .reg .f32 %f<18>;\n")
    p = bf16_cstr_append(buf, p, "    ld.param.u64 %rd1, [p_src]; ld.param.u64 %rd2, [p_nib]; ld.param.u64 %rd3, [p_scl]; ld.param.u64 %rd4, [p_rho];\n")
    p = bf16_cstr_append(buf, p, "    ld.param.u64 %rd5, [p_out]; ld.param.u64 %rd6, [p_in]; ld.param.u64 %rd7, [p_flags];\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd8, %rd6, 31; shr.u64 %rd8, %rd8, 5; mul.lo.u64 %rd9, %rd5, %rd8;\n")
    p = bf16_cstr_append(buf, p, "    mov.u32 %r1, %ctaid.x; mov.u32 %r2, %ntid.x; mov.u32 %r3, %tid.x;\n")
    p = bf16_cstr_append(buf, p, "    mad.lo.u32 %r1, %r1, %r2, %r3; cvt.u64.u32 %rd10, %r1;\n")
    p = bf16_cstr_append(buf, p, "    setp.ge.u64 %p1, %rd10, %rd9; @%p1 bra L_Q4SQ_EXIT;\n")
    p = bf16_cstr_append(buf, p, "    div.u64 %rd11, %rd10, %rd8; rem.u64 %rd12, %rd10, %rd8;\n")
    p = bf16_cstr_append(buf, p, "    mul.lo.u64 %rd13, %rd11, %rd6; shl.b64 %rd14, %rd12, 5;\n")
    p = bf16_cstr_append(buf, p, "    and.b64 %rd15, %rd7, 1; setp.ne.u64 %p2, %rd15, 0;\n")
    p = bf16_cstr_append(buf, p, "    and.b64 %rd15, %rd7, 2; setp.ne.u64 %p7, %rd15, 0; setp.ne.u64 %p8, %rd4, 0; and.pred %p7, %p7, %p8;\n")
    p = bf16_cstr_append(buf, p, "    mov.f32 %f1, 0f00000000; mov.u64 %rd16, 0;\n")
    p = bf16_cstr_append(buf, p, "L_Q4SQ_M:\n    setp.ge.u64 %p3, %rd16, 32; @%p3 bra L_Q4SQ_S;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd17, %rd14, %rd16; setp.lt.u64 %p4, %rd17, %rd6; @!%p4 bra L_Q4SQ_MN;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd18, %rd13, %rd17;\n")
    p = bf16_cstr_append(buf, p, "    @%p2 shl.b64 %rd19, %rd18, 1; @!%p2 shl.b64 %rd19, %rd18, 2; add.u64 %rd19, %rd1, %rd19;\n")
    p = bf16_cstr_append(buf, p, "    @%p2 ld.global.u16 %r4, [%rd19]; @%p2 cvt.u32.u16 %r4, %r4; @%p2 shl.b32 %r4, %r4, 16; @%p2 mov.b32 %f2, %r4;\n")
    p = bf16_cstr_append(buf, p, "    @!%p2 ld.global.f32 %f2, [%rd19]; abs.ftz.f32 %f2, %f2; max.ftz.f32 %f1, %f1, %f2;\n")
    p = bf16_cstr_append(buf, p, "L_Q4SQ_MN:\n    add.u64 %rd16, %rd16, 1; bra L_Q4SQ_M;\nL_Q4SQ_S:\n")
    p = bf16_cstr_append(buf, p, "    setp.gt.ftz.f32 %p3, %f1, 0f00000000; @!%p3 mov.u16 %hu1, 0; @!%p3 bra L_Q4SQ_SOK;\n")
    p = bf16_cstr_append(buf, p, "    div.rn.ftz.f32 %f3, %f1, 0f40E00000; cvt.rn.f16.f32 %hf1, %f3; mov.b16 %hu1, %hf1;\n")
    p = bf16_cstr_append(buf, p, "L_Q4SQ_SOK:\n    mov.b16 %hf1, %hu1; cvt.f32.f16 %f4, %hf1;\n")
    p = bf16_cstr_append(buf, p, "    setp.gt.ftz.f32 %p3, %f4, 0f00000000; @%p3 div.rn.ftz.f32 %f5, 0f3F800000, %f4; @!%p3 mov.f32 %f5, 0f00000000;\n")
    p = bf16_cstr_append(buf, p, "    mov.f32 %f6, 0f00000000;\n")
    p = ptx_cr_emit_q4s_pack_word(buf, p, "%r20", "0", "L_Q4SQ_W0")
    p = ptx_cr_emit_q4s_pack_word(buf, p, "%r21", "8", "L_Q4SQ_W1")
    p = ptx_cr_emit_q4s_pack_word(buf, p, "%r22", "16", "L_Q4SQ_W2")
    p = ptx_cr_emit_q4s_pack_word(buf, p, "%r23", "24", "L_Q4SQ_W3")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd20, %rd10, 4; add.u64 %rd20, %rd2, %rd20; st.global.v4.b32 [%rd20], {%r20, %r21, %r22, %r23};\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd21, %rd10, 1; add.u64 %rd22, %rd3, %rd21; st.global.u16 [%rd22], %hu1;\n")
    p = bf16_cstr_append(buf, p, "    @!%p7 bra L_Q4SQ_EXIT;\n")
    p = bf16_cstr_append(buf, p, "    sqrt.rn.ftz.f32 %f15, %f6; setp.gt.ftz.f32 %p3, %f15, 0f00000000; @!%p3 mov.u16 %hu2, 0; @!%p3 bra L_Q4SQ_WRHO;\n")
    p = bf16_cstr_append(buf, p, "    cvt.rn.f16.f32 %hf2, %f15; mov.b16 %hu2, %hf2; setp.eq.u16 %p4, %hu2, 0; @%p4 mov.u16 %hu2, 1;\n")
    p = bf16_cstr_append(buf, p, "L_Q4SQ_RULP:\n    setp.ge.u16 %p5, %hu2, 31743; @%p5 bra L_Q4SQ_WRHO;\n")
    p = bf16_cstr_append(buf, p, "    mov.b16 %hf2, %hu2; cvt.f32.f16 %f16, %hf2; setp.ge.ftz.f32 %p6, %f16, %f15; @%p6 bra L_Q4SQ_WRHO;\n")
    p = bf16_cstr_append(buf, p, "    add.u16 %hu2, %hu2, 1; bra L_Q4SQ_RULP;\n")
    p = bf16_cstr_append(buf, p, "L_Q4SQ_WRHO:\n    add.u64 %rd22, %rd4, %rd21; st.global.u16 [%rd22], %hu2;\n")
    p = bf16_cstr_append(buf, p, "L_Q4SQ_EXIT:\n    ret;\n}\n\n")

    // Vectorized GEMV on Q4_SoA_32: 8 warps/CTA, 1 warp/row, coalesced v4.b32 nibbles + contiguous f16 scales + v4.f32 x
    p = bf16_cstr_append(buf, p, ".visible .entry cuda_gemv_q4_soa(\n")
    p = bf16_cstr_append(buf, p, "    .param .u64 p_nib, .param .u64 p_scl, .param .u64 p_x,\n")
    p = bf16_cstr_append(buf, p, "    .param .u64 p_y, .param .u64 p_out, .param .u64 p_in\n) {\n")
    p = bf16_cstr_append(buf, p, "    .reg .pred %p<7>; .reg .u16 %hu<2>; .reg .f16 %hf<2>;\n")
    p = bf16_cstr_append(buf, p, "    .reg .b32 %r<20>; .reg .s32 %rs<4>; .reg .b64 %rd<22>; .reg .f32 %f<18>;\n")
    p = bf16_cstr_append(buf, p, "    ld.param.u64 %rd1, [p_nib]; ld.param.u64 %rd2, [p_scl]; ld.param.u64 %rd3, [p_x];\n")
    p = bf16_cstr_append(buf, p, "    ld.param.u64 %rd4, [p_y]; ld.param.u64 %rd5, [p_out]; ld.param.u64 %rd6, [p_in];\n")
    p = bf16_cstr_append(buf, p, "    mov.u32 %r1, %ctaid.x; mov.u32 %r2, %tid.x; shr.u32 %r3, %r2, 5; and.b32 %r4, %r2, 31;\n")
    p = bf16_cstr_append(buf, p, "    mad.lo.u32 %r5, %r1, 8, %r3; cvt.u64.u32 %rd7, %r5;\n")
    p = bf16_cstr_append(buf, p, "    setp.ge.u64 %p1, %rd7, %rd5; @%p1 bra L_Q4SG_EXIT;\n")
    p = bf16_cstr_append(buf, p, "    cvt.u64.u32 %rd8, %r4; add.u64 %rd9, %rd6, 31; shr.u64 %rd9, %rd9, 5;\n")
    p = bf16_cstr_append(buf, p, "    mul.lo.u64 %rd10, %rd7, %rd9; shl.b64 %rd11, %rd10, 4; add.u64 %rd10, %rd1, %rd11;\n")
    p = bf16_cstr_append(buf, p, "    mul.lo.u64 %rd11, %rd7, %rd9; shl.b64 %rd11, %rd11, 1; add.u64 %rd11, %rd2, %rd11;\n")
    p = bf16_cstr_append(buf, p, "    and.b64 %rd18, %rd3, 15; setp.eq.u64 %p6, %rd18, 0;\n")
    p = bf16_cstr_append(buf, p, "    mov.f32 %f1, 0f00000000; mov.u64 %rd12, %rd8;\n")
    p = bf16_cstr_append(buf, p, "L_Q4SG_B:\n    setp.ge.u64 %p2, %rd12, %rd9; @%p2 bra L_Q4SG_RED;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd13, %rd12, 1; add.u64 %rd13, %rd11, %rd13; ld.global.u16 %hu1, [%rd13];\n")
    p = bf16_cstr_append(buf, p, "    mov.b16 %hf1, %hu1; cvt.f32.f16 %f2, %hf1;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd13, %rd12, 5; add.u64 %rd14, %rd13, 32; setp.le.u64 %p3, %rd14, %rd6; and.pred %p3, %p3, %p6;\n")
    p = bf16_cstr_append(buf, p, "    mov.f32 %f16, 0f00000000;\n")
    p = bf16_cstr_append(buf, p, "    @!%p3 bra L_Q4SG_TAIL;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd14, %rd12, 4; add.u64 %rd14, %rd10, %rd14; ld.global.v4.b32 {%r10, %r11, %r12, %r13}, [%rd14];\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd15, %rd13, 2; add.u64 %rd16, %rd3, %rd15;\n")
    p = ptx_cr_emit_q4s_dot_word(buf, p, "%r10", "0")
    p = ptx_cr_emit_q4s_dot_word(buf, p, "%r11", "32")
    p = ptx_cr_emit_q4s_dot_word(buf, p, "%r12", "64")
    p = ptx_cr_emit_q4s_dot_word(buf, p, "%r13", "96")
    p = bf16_cstr_append(buf, p, "    fma.rn.ftz.f32 %f1, %f2, %f16, %f1; add.u64 %rd12, %rd12, 32; bra L_Q4SG_B;\n")
    p = bf16_cstr_append(buf, p, "L_Q4SG_TAIL:\n    shl.b64 %rd14, %rd12, 4; add.u64 %rd14, %rd10, %rd14; mov.u64 %rd15, 0;\n")
    p = bf16_cstr_append(buf, p, "L_Q4SG_TL:\n    setp.ge.u64 %p4, %rd15, 32; @%p4 bra L_Q4SG_TD;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd16, %rd13, %rd15; setp.ge.u64 %p5, %rd16, %rd6; @%p5 bra L_Q4SG_TD;\n")
    p = bf16_cstr_append(buf, p, "    shr.u64 %rd17, %rd15, 1; add.u64 %rd17, %rd14, %rd17; ld.global.u8 %r6, [%rd17];\n")
    p = bf16_cstr_append(buf, p, "    cvt.u32.u64 %r7, %rd15; and.b32 %r7, %r7, 1; shl.b32 %r7, %r7, 2;\n")
    p = bf16_cstr_append(buf, p, "    shr.u32 %r8, %r6, %r7; and.b32 %r8, %r8, 15; add.s32 %rs1, %r8, -8; cvt.rn.f32.s32 %f3, %rs1;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd17, %rd16, 2; add.u64 %rd17, %rd3, %rd17; ld.global.f32 %f4, [%rd17];\n")
    p = bf16_cstr_append(buf, p, "    fma.rn.ftz.f32 %f16, %f3, %f4, %f16; add.u64 %rd15, %rd15, 1; bra L_Q4SG_TL;\n")
    p = bf16_cstr_append(buf, p, "L_Q4SG_TD:\n    fma.rn.ftz.f32 %f1, %f2, %f16, %f1; add.u64 %rd12, %rd12, 32; bra L_Q4SG_B;\nL_Q4SG_RED:\n")
    p = ptx_cr_warp_sum_f32(buf, p, "%f1", "%r14", "%r15", "%f12")
    p = bf16_cstr_append(buf, p, "    setp.eq.u32 %p4, %r4, 0; @!%p4 bra L_Q4SG_EXIT;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd18, %rd7, 2; add.u64 %rd19, %rd4, %rd18; st.global.f32 [%rd19], %f1;\n")
    p = bf16_cstr_append(buf, p, "L_Q4SG_EXIT:\n    ret;\n}\n\n")
    p
}

fn ptx_cr_tok_lbl(buf: i64, pos: i64, prefix: string, ti: i64) -> i64 with Mut {
    var p = bf16_cstr_append(buf, pos, prefix)
    if ti == 0 { p = bf16_cstr_append(buf, p, "0") }
    else if ti == 1 { p = bf16_cstr_append(buf, p, "1") }
    else if ti == 2 { p = bf16_cstr_append(buf, p, "2") }
    else if ti == 3 { p = bf16_cstr_append(buf, p, "3") }
    else if ti == 4 { p = bf16_cstr_append(buf, p, "4") }
    else if ti == 5 { p = bf16_cstr_append(buf, p, "5") }
    else if ti == 6 { p = bf16_cstr_append(buf, p, "6") }
    else { p = bf16_cstr_append(buf, p, "7") }
    p
}

fn ptx_cr_emit_gemm_simt_body(buf: i64, pos: i64, fn_name: string) -> i64 with Mut {
    var p = pos
    p = bf16_cstr_append(buf, p, ".visible .entry ")
    p = bf16_cstr_append(buf, p, fn_name)
    p = bf16_cstr_append(buf, p, "(\n")
    p = bf16_cstr_append(buf, p, "    .param .u64 p_w, .param .u64 p_x, .param .u64 p_y,\n")
    p = bf16_cstr_append(buf, p, "    .param .u64 p_out, .param .u64 p_in, .param .u64 p_ntoks,\n")
    p = bf16_cstr_append(buf, p, "    .param .u64 p_bf16, .param .u64 p_dmy\n) {\n")
    p = bf16_cstr_append(buf, p, "    .reg .pred %p<10>; .reg .pred %pb<9>; .reg .b32 %r<22>; .reg .b64 %rd<32>;\n")
    p = bf16_cstr_append(buf, p, "    .reg .f32 %fa<8>; .reg .f32 %fb<8>; .reg .f32 %fc<8>; .reg .f32 %fd<8>;\n")
    p = bf16_cstr_append(buf, p, "    .reg .f32 %fw<6>; .reg .f32 %fx<6>; .reg .f32 %ft<4>;\n")
    p = bf16_cstr_append(buf, p, "    ld.param.u64 %rd1, [p_w]; ld.param.u64 %rd2, [p_x]; ld.param.u64 %rd3, [p_y];\n")
    p = bf16_cstr_append(buf, p, "    ld.param.u64 %rd4, [p_out]; ld.param.u64 %rd5, [p_in]; ld.param.u64 %rd6, [p_ntoks]; ld.param.u64 %rd7, [p_bf16];\n")
    p = bf16_cstr_append(buf, p, "    mov.u32 %r1, %ctaid.x; mov.u32 %r2, %tid.x; shr.u32 %r3, %r2, 5; and.b32 %r4, %r2, 31;\n")
    p = bf16_cstr_append(buf, p, "    mad.lo.u32 %r5, %r1, 8, %r3; cvt.u64.u32 %rd8, %r5;\n")
    p = bf16_cstr_append(buf, p, "    setp.ge.u64 %p1, %rd8, %rd4; @%p1 bra L_GM_EXIT;\n")
    p = bf16_cstr_append(buf, p, "    setp.eq.u64 %p1, %rd6, 0; @%p1 bra L_GM_EXIT;\n")
    var ti: i64 = 0
    while ti < 8 {
        p = ptx_cr_tok_lbl(buf, p, "    mov.f32 %fa", ti)
        p = ptx_cr_tok_lbl(buf, p, ", 0f00000000; mov.f32 %fb", ti)
        p = ptx_cr_tok_lbl(buf, p, ", 0f00000000; mov.f32 %fc", ti)
        p = ptx_cr_tok_lbl(buf, p, ", 0f00000000; mov.f32 %fd", ti)
        p = bf16_cstr_append(buf, p, ", 0f00000000;\n")
        ti = ti + 1
    }
    p = bf16_cstr_append(buf, p, "    setp.gt.u64 %pb1, %rd6, 1; setp.gt.u64 %pb2, %rd6, 2; setp.gt.u64 %pb3, %rd6, 3;\n")
    p = bf16_cstr_append(buf, p, "    setp.gt.u64 %pb4, %rd6, 4; setp.gt.u64 %pb5, %rd6, 5; setp.gt.u64 %pb6, %rd6, 6; setp.gt.u64 %pb7, %rd6, 7;\n")
    p = bf16_cstr_append(buf, p, "    cvt.u64.u32 %rd9, %r4; setp.eq.u64 %p2, %rd5, 0; @%p2 bra L_GM_STORE;\n")
    p = bf16_cstr_append(buf, p, "    shr.u64 %rd25, %rd5, 2; shl.b64 %rd25, %rd25, 2; shl.b64 %rd26, %rd9, 2; add.u64 %rd27, %rd25, %rd9;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd28, %rd5, 2; setp.ne.u64 %p3, %rd7, 0; mul.lo.u64 %rd10, %rd8, %rd5;\n")
    p = bf16_cstr_append(buf, p, "    @!%p3 bra L_GM_F32;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd11, %rd10, 1; add.u64 %rd12, %rd1, %rd11; mov.u64 %rd15, %rd26;\n")
    p = bf16_cstr_append(buf, p, "L_GM_BFL:\n    setp.ge.u64 %p5, %rd15, %rd25; @%p5 bra L_GM_BTAIL;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd16, %rd15, 1; add.u64 %rd17, %rd12, %rd16;\n")
    p = bf16_cstr_append(buf, p, "    ld.global.u16 %r6, [%rd17]; cvt.u32.u16 %r7, %r6; shl.b32 %r8, %r7, 16; mov.b32 %fw0, %r8;\n")
    p = bf16_cstr_append(buf, p, "    ld.global.u16 %r6, [%rd17+2]; cvt.u32.u16 %r7, %r6; shl.b32 %r8, %r7, 16; mov.b32 %fw1, %r8;\n")
    p = bf16_cstr_append(buf, p, "    ld.global.u16 %r6, [%rd17+4]; cvt.u32.u16 %r7, %r6; shl.b32 %r8, %r7, 16; mov.b32 %fw2, %r8;\n")
    p = bf16_cstr_append(buf, p, "    ld.global.u16 %r6, [%rd17+6]; cvt.u32.u16 %r7, %r6; shl.b32 %r8, %r7, 16; mov.b32 %fw3, %r8;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd19, %rd15, 2; add.u64 %rd20, %rd2, %rd19;\n")
    ti = 0
    while ti < 8 {
        if ti > 0 {
            p = ptx_cr_tok_lbl(buf, p, "    @!%pb", ti)
            p = bf16_cstr_append(buf, p, " bra L_GM_BNXT;\n")
            p = bf16_cstr_append(buf, p, "    add.u64 %rd20, %rd20, %rd28;\n")
        }
        p = bf16_cstr_append(buf, p, "    ld.global.f32 %fx0, [%rd20]; ld.global.f32 %fx1, [%rd20+4]; ld.global.f32 %fx2, [%rd20+8]; ld.global.f32 %fx3, [%rd20+12];\n")
        p = ptx_cr_tok_lbl(buf, p, "    fma.rn.ftz.f32 %fa", ti)
        p = ptx_cr_tok_lbl(buf, p, ", %fw0, %fx0, %fa", ti)
        p = ptx_cr_tok_lbl(buf, p, "; fma.rn.ftz.f32 %fb", ti)
        p = ptx_cr_tok_lbl(buf, p, ", %fw1, %fx1, %fb", ti)
        p = bf16_cstr_append(buf, p, ";\n")
        p = ptx_cr_tok_lbl(buf, p, "    fma.rn.ftz.f32 %fc", ti)
        p = ptx_cr_tok_lbl(buf, p, ", %fw2, %fx2, %fc", ti)
        p = ptx_cr_tok_lbl(buf, p, "; fma.rn.ftz.f32 %fd", ti)
        p = ptx_cr_tok_lbl(buf, p, ", %fw3, %fx3, %fd", ti)
        p = bf16_cstr_append(buf, p, ";\n")
        ti = ti + 1
    }
    p = bf16_cstr_append(buf, p, "L_GM_BNXT:\n    add.u64 %rd15, %rd15, 128; bra L_GM_BFL;\n")
    p = bf16_cstr_append(buf, p, "L_GM_BTAIL:\n    mov.u64 %rd15, %rd27;\n")
    p = bf16_cstr_append(buf, p, "L_GM_BTL:\n    setp.ge.u64 %p5, %rd15, %rd5; @%p5 bra L_GM_RED;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd16, %rd15, 1; add.u64 %rd17, %rd12, %rd16;\n")
    p = bf16_cstr_append(buf, p, "    ld.global.u16 %r6, [%rd17]; cvt.u32.u16 %r7, %r6; shl.b32 %r8, %r7, 16; mov.b32 %fw0, %r8;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd19, %rd15, 2; add.u64 %rd20, %rd2, %rd19;\n")
    ti = 0
    while ti < 8 {
        if ti > 0 {
            p = ptx_cr_tok_lbl(buf, p, "    @!%pb", ti)
            p = bf16_cstr_append(buf, p, " bra L_GM_BTN;\n")
            p = bf16_cstr_append(buf, p, "    add.u64 %rd20, %rd20, %rd28;\n")
        }
        p = bf16_cstr_append(buf, p, "    ld.global.f32 %fx0, [%rd20]; ")
        p = ptx_cr_tok_lbl(buf, p, "fma.rn.ftz.f32 %fa", ti)
        p = ptx_cr_tok_lbl(buf, p, ", %fw0, %fx0, %fa", ti)
        p = bf16_cstr_append(buf, p, ";\n")
        ti = ti + 1
    }
    p = bf16_cstr_append(buf, p, "L_GM_BTN:\n    add.u64 %rd15, %rd15, 32; bra L_GM_BTL;\n")
    p = bf16_cstr_append(buf, p, "L_GM_F32:\n    shl.b64 %rd11, %rd10, 2; add.u64 %rd12, %rd1, %rd11; mov.u64 %rd15, %rd26;\n")
    p = bf16_cstr_append(buf, p, "L_GM_F32L:\n    setp.ge.u64 %p5, %rd15, %rd25; @%p5 bra L_GM_FTAIL;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd19, %rd15, 2; add.u64 %rd17, %rd12, %rd19; add.u64 %rd20, %rd2, %rd19;\n")
    p = bf16_cstr_append(buf, p, "    ld.global.f32 %fw0, [%rd17]; ld.global.f32 %fw1, [%rd17+4]; ld.global.f32 %fw2, [%rd17+8]; ld.global.f32 %fw3, [%rd17+12];\n")
    ti = 0
    while ti < 8 {
        if ti > 0 {
            p = ptx_cr_tok_lbl(buf, p, "    @!%pb", ti)
            p = bf16_cstr_append(buf, p, " bra L_GM_FNXT;\n")
            p = bf16_cstr_append(buf, p, "    add.u64 %rd20, %rd20, %rd28;\n")
        }
        p = bf16_cstr_append(buf, p, "    ld.global.f32 %fx0, [%rd20]; ld.global.f32 %fx1, [%rd20+4]; ld.global.f32 %fx2, [%rd20+8]; ld.global.f32 %fx3, [%rd20+12];\n")
        p = ptx_cr_tok_lbl(buf, p, "    fma.rn.ftz.f32 %fa", ti)
        p = ptx_cr_tok_lbl(buf, p, ", %fw0, %fx0, %fa", ti)
        p = ptx_cr_tok_lbl(buf, p, "; fma.rn.ftz.f32 %fb", ti)
        p = ptx_cr_tok_lbl(buf, p, ", %fw1, %fx1, %fb", ti)
        p = bf16_cstr_append(buf, p, ";\n")
        p = ptx_cr_tok_lbl(buf, p, "    fma.rn.ftz.f32 %fc", ti)
        p = ptx_cr_tok_lbl(buf, p, ", %fw2, %fx2, %fc", ti)
        p = ptx_cr_tok_lbl(buf, p, "; fma.rn.ftz.f32 %fd", ti)
        p = ptx_cr_tok_lbl(buf, p, ", %fw3, %fx3, %fd", ti)
        p = bf16_cstr_append(buf, p, ";\n")
        ti = ti + 1
    }
    p = bf16_cstr_append(buf, p, "L_GM_FNXT:\n    add.u64 %rd15, %rd15, 128; bra L_GM_F32L;\n")
    p = bf16_cstr_append(buf, p, "L_GM_FTAIL:\n    mov.u64 %rd15, %rd27;\n")
    p = bf16_cstr_append(buf, p, "L_GM_FTL:\n    setp.ge.u64 %p5, %rd15, %rd5; @%p5 bra L_GM_RED;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd19, %rd15, 2; add.u64 %rd17, %rd12, %rd19; add.u64 %rd20, %rd2, %rd19;\n")
    p = bf16_cstr_append(buf, p, "    ld.global.f32 %fw0, [%rd17];\n")
    ti = 0
    while ti < 8 {
        if ti > 0 {
            p = ptx_cr_tok_lbl(buf, p, "    @!%pb", ti)
            p = bf16_cstr_append(buf, p, " bra L_GM_FTN;\n")
            p = bf16_cstr_append(buf, p, "    add.u64 %rd20, %rd20, %rd28;\n")
        }
        p = bf16_cstr_append(buf, p, "    ld.global.f32 %fx0, [%rd20]; ")
        p = ptx_cr_tok_lbl(buf, p, "fma.rn.ftz.f32 %fa", ti)
        p = ptx_cr_tok_lbl(buf, p, ", %fw0, %fx0, %fa", ti)
        p = bf16_cstr_append(buf, p, ";\n")
        ti = ti + 1
    }
    p = bf16_cstr_append(buf, p, "L_GM_FTN:\n    add.u64 %rd15, %rd15, 32; bra L_GM_FTL;\n")
    p = bf16_cstr_append(buf, p, "L_GM_RED:\nL_GM_STORE:\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd21, %rd8, 2; add.u64 %rd22, %rd3, %rd21; shl.b64 %rd23, %rd4, 2;\n")
    p = bf16_cstr_append(buf, p, "    setp.eq.u32 %p6, %r4, 0;\n")
    ti = 0
    while ti < 8 {
        if ti > 0 {
            p = ptx_cr_tok_lbl(buf, p, "    @!%pb", ti)
            p = bf16_cstr_append(buf, p, " bra L_GM_EXIT;\n")
            p = bf16_cstr_append(buf, p, "    add.u64 %rd22, %rd22, %rd23;\n")
        }
        p = ptx_cr_tok_lbl(buf, p, "    add.rn.ftz.f32 %ft0, %fa", ti)
        p = ptx_cr_tok_lbl(buf, p, ", %fb", ti)
        p = ptx_cr_tok_lbl(buf, p, "; add.rn.ftz.f32 %ft1, %fc", ti)
        p = ptx_cr_tok_lbl(buf, p, ", %fd", ti)
        p = bf16_cstr_append(buf, p, "; add.rn.ftz.f32 %ft0, %ft0, %ft1;\n")
        p = ptx_cr_warp_sum_f32(buf, p, "%ft0", "%r14", "%r15", "%ft2")
        p = bf16_cstr_append(buf, p, "    @%p6 st.global.f32 [%rd22], %ft0;\n")
        ti = ti + 1
    }
    p = bf16_cstr_append(buf, p, "L_GM_EXIT:\n    ret;\n}\n\n")
    p
}

fn ptx_cr_emit_gemm_bf16_and_tc(buf: i64, pos: i64, sm_ver: i64) -> i64 with Mut {
    var p = ptx_cr_emit_gemm_simt_body(buf, pos, "cuda_gemm_bf16_simt")
    if sm_ver < 75 {
        return ptx_cr_emit_gemm_simt_body(buf, p, "cuda_gemm_bf16_tc")
    }
    let is_sm80 = sm_ver >= 80
    // Tensor Core fast GEMM: 8 warps/CTA = 128 rows/CTA x 8 tokens/CTA
    // grid_x = ((out_dim + 127)/128) * ((n_toks + 7)/8), block_x = 256
    p = bf16_cstr_append(buf, p, ".visible .entry cuda_gemm_bf16_tc(\n")
    p = bf16_cstr_append(buf, p, "    .param .u64 p_w, .param .u64 p_x, .param .u64 p_y,\n")
    p = bf16_cstr_append(buf, p, "    .param .u64 p_out, .param .u64 p_in, .param .u64 p_ntoks,\n")
    p = bf16_cstr_append(buf, p, "    .param .u64 p_bf16, .param .u64 p_dmy\n) {\n")
    if is_sm80 {
        p = bf16_cstr_append(buf, p, "    .shared .align 16 .b8 smem[4352];\n")
    } else {
        p = bf16_cstr_append(buf, p, "    .shared .align 16 .b8 smem[2176];\n")
    }
    p = bf16_cstr_append(buf, p, "    .reg .pred %p<6>; .reg .u16 %hu<4>; .reg .f16 %hf<4>; .reg .b32 %r<24>; .reg .b64 %rd<30>; .reg .f32 %f<10>;\n")
    p = bf16_cstr_append(buf, p, "    ld.param.u64 %rd1, [p_w]; ld.param.u64 %rd2, [p_x]; ld.param.u64 %rd3, [p_y];\n")
    p = bf16_cstr_append(buf, p, "    ld.param.u64 %rd4, [p_out]; ld.param.u64 %rd5, [p_in]; ld.param.u64 %rd6, [p_ntoks]; ld.param.u64 %rd7, [p_bf16];\n")
    p = bf16_cstr_append(buf, p, "    setp.eq.u64 %p1, %rd6, 0; @%p1 bra L_TC_EXIT;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd8, %rd4, 127; shr.u64 %rd8, %rd8, 7;\n")
    p = bf16_cstr_append(buf, p, "    add.u64 %rd9, %rd6, 7; shr.u64 %rd9, %rd9, 3; mul.lo.u64 %rd10, %rd8, %rd9;\n")
    p = bf16_cstr_append(buf, p, "    mov.u32 %r1, %ctaid.x; cvt.u64.u32 %rd11, %r1; setp.ge.u64 %p1, %rd11, %rd10; @%p1 bra L_TC_EXIT;\n")
    p = bf16_cstr_append(buf, p, "    rem.u64 %rd12, %rd11, %rd8; div.u64 %rd13, %rd11, %rd8;\n")
    p = bf16_cstr_append(buf, p, "    shl.b64 %rd12, %rd12, 7; shl.b64 %rd13, %rd13, 3;\n")
    p = bf16_cstr_append(buf, p, "    mov.u32 %r2, %tid.x; shr.u32 %r3, %r2, 5; and.b32 %r4, %r2, 31;\n")
    p = bf16_cstr_append(buf, p, "    cvt.u64.u32 %rd14, %r3; shl.b64 %rd15, %rd14, 4; add.u64 %rd15, %rd12, %rd15;\n")
    p = bf16_cstr_append(buf, p, "    cvta.shared.u64 %rd16, smem; setp.ne.u64 %p2, %rd7, 0;\n")
    p = bf16_cstr_append(buf, p, "    mov.f32 %f0, 0f00000000; mov.f32 %f1, 0f00000000; mov.f32 %f2, 0f00000000; mov.f32 %f3, 0f00000000;\n")
    p = bf16_cstr_append(buf, p, "    mov.u64 %rd17, 0;\n")
    p = bf16_cstr_append(buf, p, "L_TC_K:\n    setp.ge.u64 %p1, %rd17, %rd5; @%p1 bra L_TC_ST;\n")
    if is_sm80 {
        p = bf16_cstr_append(buf, p, "    setp.lt.u32 %p3, %r2, 128; @!%p3 bra L_TC_LA;\n")
        p = bf16_cstr_append(buf, p, "    shr.u32 %r5, %r2, 4; and.b32 %r6, %r2, 15;\n")
    } else {
        p = bf16_cstr_append(buf, p, "    setp.lt.u32 %p3, %r2, 64; @!%p3 bra L_TC_LA;\n")
        p = bf16_cstr_append(buf, p, "    shr.u32 %r5, %r2, 3; and.b32 %r6, %r2, 7;\n")
    }
    p = bf16_cstr_append(buf, p, "    cvt.u64.u32 %rd18, %r5; add.u64 %rd18, %rd13, %rd18;\n")
    p = bf16_cstr_append(buf, p, "    cvt.u64.u32 %rd19, %r6; add.u64 %rd19, %rd17, %rd19;\n")
    p = bf16_cstr_append(buf, p, "    setp.lt.u64 %p4, %rd18, %rd6; setp.lt.u64 %p5, %rd19, %rd5; and.pred %p4, %p4, %p5;\n")
    p = bf16_cstr_append(buf, p, "    @!%p4 mov.u16 %hu1, 0; @!%p4 bra L_TC_WB;\n")
    p = bf16_cstr_append(buf, p, "    mul.lo.u64 %rd20, %rd18, %rd5; add.u64 %rd20, %rd20, %rd19; shl.b64 %rd20, %rd20, 2; add.u64 %rd20, %rd2, %rd20;\n")
    if is_sm80 {
        p = bf16_cstr_append(buf, p, "    ld.global.f32 %f4, [%rd20]; mov.b32 %r7, %f4; add.u32 %r8, %r7, 0x7fff; shr.u32 %r9, %r7, 16; and.b32 %r9, %r9, 1; add.u32 %r8, %r8, %r9; shr.u32 %r8, %r8, 16; cvt.u16.u32 %hu1, %r8;\n")
        p = bf16_cstr_append(buf, p, "L_TC_WB:\n    cvt.u64.u32 %rd21, %r2; shl.b64 %rd21, %rd21, 1; add.u64 %rd21, %rd21, 4096; add.u64 %rd21, %rd16, %rd21; st.u16 [%rd21], %hu1;\n")
    } else {
        p = bf16_cstr_append(buf, p, "    ld.global.f32 %f4, [%rd20]; cvt.rn.f16.f32 %hf1, %f4; mov.b16 %hu1, %hf1;\n")
        p = bf16_cstr_append(buf, p, "L_TC_WB:\n    cvt.u64.u32 %rd21, %r2; shl.b64 %rd21, %rd21, 1; add.u64 %rd21, %rd21, 2048; add.u64 %rd21, %rd16, %rd21; st.u16 [%rd21], %hu1;\n")
    }
    p = bf16_cstr_append(buf, p, "L_TC_LA:\n")
    let n_asubs: i64 = if is_sm80 { 8 } else { 4 }
    var si: i64 = 0
    while si < n_asubs {
        let off_str = if si == 0 { "0" } else if si == 1 { "32" } else if si == 2 { "64" } else if si == 3 { "96" }
            else if si == 4 { "128" } else if si == 5 { "160" } else if si == 6 { "192" } else { "224" }
        p = bf16_cstr_append(buf, p, "    add.u32 %r5, %r4, ")
        p = bf16_cstr_append(buf, p, off_str)
        p = bf16_cstr_append(buf, p, "; ")
        if is_sm80 {
            p = bf16_cstr_append(buf, p, "shr.u32 %r6, %r5, 4; and.b32 %r7, %r5, 15;\n")
        } else {
            p = bf16_cstr_append(buf, p, "shr.u32 %r6, %r5, 3; and.b32 %r7, %r5, 7;\n")
        }
        p = bf16_cstr_append(buf, p, "    cvt.u64.u32 %rd18, %r6; add.u64 %rd18, %rd15, %rd18;\n")
        p = bf16_cstr_append(buf, p, "    cvt.u64.u32 %rd19, %r7; add.u64 %rd19, %rd17, %rd19;\n")
        p = bf16_cstr_append(buf, p, "    setp.lt.u64 %p4, %rd18, %rd4; setp.lt.u64 %p5, %rd19, %rd5; and.pred %p4, %p4, %p5;\n")
        p = ptx_cr_tok_lbl(buf, p, "    @!%p4 mov.u16 %hu1, 0; @!%p4 bra L_TC_AS", si)
        p = bf16_cstr_append(buf, p, ";\n")
        p = ptx_cr_tok_lbl(buf, p, "    mul.lo.u64 %rd20, %rd18, %rd5; add.u64 %rd20, %rd20, %rd19; @!%p2 bra L_TC_AF", si)
        p = bf16_cstr_append(buf, p, ";\n")
        p = bf16_cstr_append(buf, p, "    shl.b64 %rd20, %rd20, 1; add.u64 %rd20, %rd1, %rd20;\n")
        if is_sm80 {
            p = ptx_cr_tok_lbl(buf, p, "    ld.global.u16 %hu1, [%rd20]; bra L_TC_AS", si)
            p = bf16_cstr_append(buf, p, ";\n")
        } else {
            p = ptx_cr_tok_lbl(buf, p, "    ld.global.u16 %r8, [%rd20]; shl.b32 %r8, %r8, 16; mov.b32 %f4, %r8; cvt.rn.f16.f32 %hf1, %f4; mov.b16 %hu1, %hf1; bra L_TC_AS", si)
            p = bf16_cstr_append(buf, p, ";\n")
        }
        p = ptx_cr_tok_lbl(buf, p, "L_TC_AF", si)
        p = bf16_cstr_append(buf, p, ":\n    shl.b64 %rd20, %rd20, 2; add.u64 %rd20, %rd1, %rd20; ld.global.f32 %f4, [%rd20];\n")
        if is_sm80 {
            p = bf16_cstr_append(buf, p, "    mov.b32 %r7, %f4; add.u32 %r8, %r7, 0x7fff; shr.u32 %r9, %r7, 16; and.b32 %r9, %r9, 1; add.u32 %r8, %r8, %r9; shr.u32 %r8, %r8, 16; cvt.u16.u32 %hu1, %r8;\n")
        } else {
            p = bf16_cstr_append(buf, p, "    cvt.rn.f16.f32 %hf1, %f4; mov.b16 %hu1, %hf1;\n")
        }
        p = ptx_cr_tok_lbl(buf, p, "L_TC_AS", si)
        if is_sm80 {
            p = bf16_cstr_append(buf, p, ":\n    cvt.u64.u32 %rd21, %r5; shl.b64 %rd21, %rd21, 1; cvt.u64.u32 %rd22, %r3; shl.b64 %rd22, %rd22, 9;\n")
        } else {
            p = bf16_cstr_append(buf, p, ":\n    cvt.u64.u32 %rd21, %r5; shl.b64 %rd21, %rd21, 1; cvt.u64.u32 %rd22, %r3; shl.b64 %rd22, %rd22, 8;\n")
        }
        p = bf16_cstr_append(buf, p, "    add.u64 %rd21, %rd21, %rd22; add.u64 %rd21, %rd16, %rd21; st.u16 [%rd21], %hu1;\n")
        si = si + 1
    }
    p = bf16_cstr_append(buf, p, "    bar.sync 0;\n")
    p = bf16_cstr_append(buf, p, "    shr.u32 %r5, %r4, 2; and.b32 %r6, %r4, 3;\n")
    if is_sm80 {
        p = bf16_cstr_append(buf, p, "    cvt.u64.u32 %rd18, %r3; shl.b64 %rd18, %rd18, 9; add.u64 %rd18, %rd16, %rd18;\n")
        p = bf16_cstr_append(buf, p, "    cvt.u64.u32 %rd19, %r5; shl.b64 %rd19, %rd19, 5; add.u64 %rd18, %rd18, %rd19;\n")
        p = bf16_cstr_append(buf, p, "    cvt.u64.u32 %rd20, %r6; shl.b64 %rd20, %rd20, 2; add.u64 %rd18, %rd18, %rd20;\n")
        p = bf16_cstr_append(buf, p, "    ld.u32 %r10, [%rd18]; ld.u32 %r11, [%rd18+256]; ld.u32 %r12, [%rd18+16]; ld.u32 %r13, [%rd18+272];\n")
        p = bf16_cstr_append(buf, p, "    add.u64 %rd21, %rd16, 4096; add.u64 %rd21, %rd21, %rd19; add.u64 %rd21, %rd21, %rd20;\n")
        p = bf16_cstr_append(buf, p, "    ld.u32 %r14, [%rd21]; ld.u32 %r15, [%rd21+16];\n")
        p = bf16_cstr_append(buf, p, "    mma.sync.aligned.m16n8k16.row.col.f32.bf16.bf16.f32 {%f0, %f1, %f2, %f3}, {%r10, %r11, %r12, %r13}, {%r14, %r15}, {%f0, %f1, %f2, %f3};\n")
        p = bf16_cstr_append(buf, p, "    bar.sync 0; add.u64 %rd17, %rd17, 16; bra L_TC_K;\n")
    } else {
        p = bf16_cstr_append(buf, p, "    cvt.u64.u32 %rd18, %r3; shl.b64 %rd18, %rd18, 8; add.u64 %rd18, %rd16, %rd18;\n")
        p = bf16_cstr_append(buf, p, "    cvt.u64.u32 %rd19, %r5; shl.b64 %rd19, %rd19, 4; add.u64 %rd18, %rd18, %rd19;\n")
        p = bf16_cstr_append(buf, p, "    cvt.u64.u32 %rd20, %r6; shl.b64 %rd20, %rd20, 2; add.u64 %rd18, %rd18, %rd20;\n")
        p = bf16_cstr_append(buf, p, "    ld.u32 %r10, [%rd18]; ld.u32 %r11, [%rd18+128];\n")
        p = bf16_cstr_append(buf, p, "    add.u64 %rd21, %rd16, 2048; add.u64 %rd21, %rd21, %rd19; add.u64 %rd21, %rd21, %rd20;\n")
        p = bf16_cstr_append(buf, p, "    ld.u32 %r14, [%rd21];\n")
        p = bf16_cstr_append(buf, p, "    mma.sync.aligned.m16n8k8.row.col.f32.f16.f16.f32 {%f0, %f1, %f2, %f3}, {%r10, %r11}, {%r14}, {%f0, %f1, %f2, %f3};\n")
        p = bf16_cstr_append(buf, p, "    bar.sync 0; add.u64 %rd17, %rd17, 8; bra L_TC_K;\n")
    }
    p = bf16_cstr_append(buf, p, "L_TC_ST:\n    shr.u32 %r5, %r4, 2; shl.b32 %r6, %r4, 1; and.b32 %r6, %r6, 6;\n")
    p = bf16_cstr_append(buf, p, "    cvt.u64.u32 %rd18, %r5; add.u64 %rd18, %rd15, %rd18; add.u64 %rd19, %rd18, 8;\n")
    p = bf16_cstr_append(buf, p, "    cvt.u64.u32 %rd20, %r6; add.u64 %rd20, %rd13, %rd20; add.u64 %rd21, %rd20, 1;\n")
    p = bf16_cstr_append(buf, p, "    setp.lt.u64 %p2, %rd18, %rd4; setp.lt.u64 %p3, %rd19, %rd4;\n")
    p = bf16_cstr_append(buf, p, "    setp.lt.u64 %p4, %rd20, %rd6; setp.lt.u64 %p5, %rd21, %rd6;\n")
    p = bf16_cstr_append(buf, p, "    and.pred %p1, %p2, %p4; mul.lo.u64 %rd22, %rd20, %rd4; add.u64 %rd22, %rd22, %rd18; shl.b64 %rd22, %rd22, 2; add.u64 %rd22, %rd3, %rd22; @%p1 st.global.f32 [%rd22], %f0;\n")
    p = bf16_cstr_append(buf, p, "    and.pred %p1, %p2, %p5; mul.lo.u64 %rd23, %rd21, %rd4; add.u64 %rd23, %rd23, %rd18; shl.b64 %rd23, %rd23, 2; add.u64 %rd23, %rd3, %rd23; @%p1 st.global.f32 [%rd23], %f1;\n")
    p = bf16_cstr_append(buf, p, "    and.pred %p1, %p3, %p4; mul.lo.u64 %rd24, %rd20, %rd4; add.u64 %rd24, %rd24, %rd19; shl.b64 %rd24, %rd24, 2; add.u64 %rd24, %rd3, %rd24; @%p1 st.global.f32 [%rd24], %f2;\n")
    p = bf16_cstr_append(buf, p, "    and.pred %p1, %p3, %p5; mul.lo.u64 %rd25, %rd21, %rd4; add.u64 %rd25, %rd25, %rd19; shl.b64 %rd25, %rd25, 2; add.u64 %rd25, %rd3, %rd25; @%p1 st.global.f32 [%rd25], %f3;\n")
    p = bf16_cstr_append(buf, p, "L_TC_EXIT:\n    ret;\n}\n\n")
    p
}

pub fn emit_qwen3_cuda_runner_ptx_for_sm(sm_ver: i64, driver_ver: i64) -> i64 with Alloc, Mut {
    let buf = heap_alloc(393216) as i64
    var p: i64 = 0
    if sm_ver >= 80 && driver_ver >= 12000 {
        p = bf16_cstr_append(buf, p, ".version 8.0\n.target sm_80\n.address_size 64\n\n")
    } else if sm_ver >= 80 {
        p = bf16_cstr_append(buf, p, ".version 7.0\n.target sm_80\n.address_size 64\n\n")
    } else if sm_ver >= 75 && driver_ver >= 11000 {
        p = bf16_cstr_append(buf, p, ".version 7.0\n.target sm_75\n.address_size 64\n\n")
    } else if sm_ver >= 75 {
        p = bf16_cstr_append(buf, p, ".version 6.5\n.target sm_75\n.address_size 64\n\n")
    } else if sm_ver >= 70 && driver_ver >= 11000 {
        p = bf16_cstr_append(buf, p, ".version 7.0\n.target sm_70\n.address_size 64\n\n")
    } else if sm_ver >= 70 {
        p = bf16_cstr_append(buf, p, ".version 6.4\n.target sm_70\n.address_size 64\n\n")
    } else {
        p = bf16_cstr_append(buf, p, ".version 6.4\n.target sm_60\n.address_size 64\n\n")
    }
    p = ptx_cr_emit_sounio_exp(buf, p)
    p = ptx_cr_emit_embed_and_vec(buf, p)
    p = ptx_cr_emit_rmsnorm(buf, p)
    p = ptx_cr_emit_add_accum_rmsnorm(buf, p)
    p = ptx_cr_emit_qk_rope_and_gqa(buf, p)
    p = ptx_cr_emit_gemv_bf16_and_argmax(buf, p)
    p = ptx_cr_emit_q4_quant_and_scale(buf, p)
    p = ptx_cr_emit_q4_gemv_and_cert(buf, p)
    p = ptx_cr_emit_q4_soa(buf, p)
    p = ptx_cr_emit_gemm_bf16_and_tc(buf, p, sm_ver)
    buf
}

pub fn emit_qwen3_cuda_runner_ptx_cstr() -> i64 with Alloc, Mut {
    emit_qwen3_cuda_runner_ptx_for_sm(80, 12000)
}

fn ptx_aud_append_slice(dst: i64, pos: i64, src: i64, start: i64, end_idx: i64) -> i64 with Mut {
    var p = pos
    var i = start
    while i < end_idx {
        let _w = ptr_write_u8(dst, p, ptr_read_u8(src, i))
        p = p + 1
        i = i + 1
    }
    let _z = ptr_write_u8(dst, p, 0)
    p
}

fn ptx_aud_append_u64(dst: i64, pos: i64, v: i64) -> i64 with Mut, Div {
    var p = pos
    if v >= 10 {
        p = ptx_aud_append_u64(dst, p, v / 10)
    }
    let _w = ptr_write_u8(dst, p, (48 + (v % 10)) as u8)
    let _z = ptr_write_u8(dst, p + 1, 0)
    p + 1
}

fn ptx_aud_match_at(src: i64, pos: i64, pat: string) -> bool with Mut {
    let n = str_len(pat)
    var i: i64 = 0
    while i < n {
        let b = ptr_read_u8(src, pos + i)
        if b == 0 || (b as i32) != (str_char_at(pat, i) as i32) {
            return false
        }
        i = i + 1
    }
    true
}

// Audit-only PTX: instruments every `fma.rn.ftz.f32` instruction to count
// exact-min-normal outputs (`|r| == 2^-126`, bits `0x00800000`) into `g_fma_min_norm_hits`.
// Production `emit_qwen3_cuda_runner_ptx_for_sm` contains ZERO audit instrumentation.
pub fn emit_qwen3_cuda_audit_ptx_for_sm(sm_ver: i64, driver_ver: i64) -> i64 with Alloc, Mut, Div {
    let prod = emit_qwen3_cuda_runner_ptx_for_sm(sm_ver, driver_ver)
    if prod == 0 { return 0 }
    let out = heap_alloc(786432) as i64
    if out == 0 {
        heap_free(prod as *mut u8)
        return 0
    }
    var op: i64 = 0
    var i: i64 = 0
    var injected_global = false
    var aud_id: i64 = 0

    while true {
        let b = ptr_read_u8(prod, i)
        if b == 0 { break }

        if !injected_global && ptx_aud_match_at(prod, i, ".address_size 64\n\n") {
            op = bf16_cstr_append(out, op, ".address_size 64\n\n.visible .global .align 8 .u64 g_fma_min_norm_hits = 0;\n\n")
            i = i + 18
            injected_global = true
        } else if ptx_aud_match_at(prod, i, ") {\n") {
            op = bf16_cstr_append(out, op, ") {\n    .reg .pred %p_aud<2>; .reg .b32 %r_aud<2>; .reg .u64 %rdu_aud<2>;\n")
            i = i + 4
        } else if b == 47 && ptr_read_u8(prod, i + 1) == 47 {
            let c_start = i
            while ptr_read_u8(prod, i) != 0 && ptr_read_u8(prod, i) != 10 {
                i = i + 1
            }
            if ptr_read_u8(prod, i) == 10 { i = i + 1 }
            op = ptx_aud_append_slice(out, op, prod, c_start, i)
        } else if ptx_aud_match_at(prod, i, "fma.rn.ftz.f32 ") {
            // Find statement start back to previous ';', '\n', ':', '{', or '}'
            var stmt_s = i
            while stmt_s > 0 {
                let pb = ptr_read_u8(prod, stmt_s - 1)
                if pb == 59 || pb == 10 || pb == 58 || pb == 123 || pb == 125 { break }
                stmt_s = stmt_s - 1
            }
            // Find optional @pred guard between stmt_s and i
            var pstart: i64 = -1
            var pend: i64 = -1
            var is_neg = false
            var k = stmt_s
            while k < i {
                if ptr_read_u8(prod, k) == 64 {
                    pstart = k + 1
                    if ptr_read_u8(prod, pstart) == 33 {
                        is_neg = true
                        pstart = pstart + 1
                    }
                    pend = pstart
                    while pend < i && ptr_read_u8(prod, pend) != 32 && ptr_read_u8(prod, pend) != 9 {
                        pend = pend + 1
                    }
                    break
                }
                k = k + 1
            }
            // Extract dst register right after "fma.rn.ftz.f32 "
            var dstart = i + 15
            while ptr_read_u8(prod, dstart) == 32 { dstart = dstart + 1 }
            var dend = dstart
            while ptr_read_u8(prod, dend) != 0 && ptr_read_u8(prod, dend) != 44 && ptr_read_u8(prod, dend) != 32 {
                dend = dend + 1
            }
            // Advance to end of statement ';'
            var semi = i + 15
            while ptr_read_u8(prod, semi) != 0 && ptr_read_u8(prod, semi) != 59 {
                semi = semi + 1
            }
            if ptr_read_u8(prod, semi) == 59 { semi = semi + 1 }
            op = ptx_aud_append_slice(out, op, prod, i, semi)
            op = bf16_cstr_append(out, op, " ")
            if pstart >= 0 && pend > pstart {
                if is_neg {
                    op = bf16_cstr_append(out, op, "@")
                } else {
                    op = bf16_cstr_append(out, op, "@!")
                }
                op = ptx_aud_append_slice(out, op, prod, pstart, pend)
                op = bf16_cstr_append(out, op, " bra L_AUD_SKIP_")
                op = ptx_aud_append_u64(out, op, aud_id)
                op = bf16_cstr_append(out, op, "; ")
            }
            op = bf16_cstr_append(out, op, "mov.b32 %r_aud0, ")
            op = ptx_aud_append_slice(out, op, prod, dstart, dend)
            op = bf16_cstr_append(out, op, "; and.b32 %r_aud0, %r_aud0, 0x7fffffff; setp.eq.u32 %p_aud0, %r_aud0, 0x00800000; @%p_aud0 atom.global.add.u64 %rdu_aud0, [g_fma_min_norm_hits], 1;")
            if pstart >= 0 && pend > pstart {
                op = bf16_cstr_append(out, op, " L_AUD_SKIP_")
                op = ptx_aud_append_u64(out, op, aud_id)
                op = bf16_cstr_append(out, op, ":")
            }
            aud_id = aud_id + 1
            i = semi
        } else {
            let _w = ptr_write_u8(out, op, b)
            op = op + 1
            i = i + 1
        }
    }
    let _z = ptr_write_u8(out, op, 0)
    heap_free(prod as *mut u8)
    out
}
