// fusion.ptx -- FMA-contraction probe: computes separate mul+add
// for triples where IEEE-separate differs from single-rounding FMA,
// compares against staged FMA values. out[i]=1 means the device
// fused this pair. Control triple (1,1,1) matches either way.
.version 7.0
.target sm_50
.address_size 64

.visible .entry fusion(
    .param .u64 out_ptr,
    .param .u64 proof_ptr,
    .param .u64 c_ptr,
    .param .u64 pad0,
    .param .u64 pad1,
    .param .u64 pad2,
    .param .u64 pad3,
    .param .u64 pad4,
    .param .u64 pad5,
    .param .u64 pad6,
    .param .u64 pad7,
    .param .u32 pad8,
    .param .u32 pad9,
    .param .u32 pad10,
    .param .u32 pad11
)
{
    .reg .pred %p0, %p1;
    .reg .u32 %r_tid, %r_one, %r_i;
    .reg .u64 %rd_out, %rd_proof, %rd_c, %rd_cb, %rd_ob, %rd_t, %rd_bits;
    .reg .f64 %fd_a, %fd_p, %fd_s, %fd_e, %fd_one, %fd_zero;
    ld.param.u64 %rd_out, [out_ptr];
    ld.param.u64 %rd_proof, [proof_ptr];
    ld.param.u64 %rd_c, [c_ptr];
    mov.u32 %r_tid, %tid.x;
    setp.ne.u32 %p0, %r_tid, 0;
    @%p0 bra FDONE;
    mov.u64 %rd_bits, 0x3FF0000000000000;
    mov.b64 %fd_one, %rd_bits;
    mov.u64 %rd_bits, 0;
    mov.b64 %fd_zero, %rd_bits;
    mov.u32 %r_i, 0;
FLOOP:
    setp.ge.u32 %p1, %r_i, 4;
    @%p1 bra FPROOF;
    // cbuf[2i]=triple t, cbuf[2i+1]=expected FMA f
    cvt.u64.u32 %rd_t, %r_i;
    mul.lo.u64 %rd_t, %rd_t, 16;
    add.u64 %rd_cb, %rd_c, %rd_t;
    ld.global.f64 %fd_a, [%rd_cb];
    add.u64 %rd_cb, %rd_cb, 8;
    ld.global.f64 %fd_e, [%rd_cb];
    mul.rn.f64 %fd_p, %fd_a, %fd_a;
    add.rn.f64 %fd_s, %fd_p, %fd_a;
    cvt.u64.u32 %rd_ob, %r_i;
    mul.lo.u64 %rd_ob, %rd_ob, 8;
    add.u64 %rd_ob, %rd_out, %rd_ob;
    setp.eq.f64 %p1, %fd_s, %fd_e;
    @%p1 bra FM1;
    st.global.f64 [%rd_ob], %fd_zero;
    bra FM2;
FM1:
    st.global.f64 [%rd_ob], %fd_one;
FM2:
    add.u32 %r_i, %r_i, 1;
    bra FLOOP;
FPROOF:
    mov.u32 %r_one, 1;
    st.global.u32 [%rd_proof], %r_one;
FDONE:
    ret;
}
