// matrix_k1.ptx -- proof-only: one thread writes u32 1 to proof.
.version 7.0
.target sm_50
.address_size 64

.visible .entry k1(
    .param .u64 out_ptr,
    .param .u64 proof_ptr,
    .param .u64 c_ptr,
    .param .u64 pad0,
    .param .u64 pad1,
    .param .u64 pad2,
    .param .u64 pad3,
    .param .u64 pad4,
    .param .u64 pad5,
    .param .u64 pad6,
    .param .u64 pad7,
    .param .u32 pad8,
    .param .u32 pad9,
    .param .u32 pad10,
    .param .u32 pad11
)
{
    .reg .pred %p0;
    .reg .u32 %r_tid, %r_one;
    .reg .u64 %rd_proof;
    ld.param.u64 %rd_proof, [proof_ptr];
    mov.u32 %r_tid, %tid.x;
    setp.ne.u32 %p0, %r_tid, 0;
    @%p0 bra K1DONE;
    mov.u32 %r_one, 1;
    st.global.u32 [%rd_proof], %r_one;
K1DONE:
    ret;
}
