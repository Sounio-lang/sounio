    p = bf16_cstr_append(buf, p, "    device const float* w = (device const float*)(w_base + w_off);\n")
    p = bf16_cstr_append(buf, p, "    device float* out = (device float*)(out_base + out_off);\n")
    p = bf16_cstr_append(buf, p, "    float sq = 0.0f;\n")
    p = bf16_cstr_append(buf, p, "    for (ulong i = (ulong)tid; i < dim; i = i + 256ul) { float v = x[i] + h[i]; x[i] = v; sq = fma(v, v, sq); }\n")
    p = bf16_cstr_append(buf, p, "    sq = simd_sum(sq); if ((tid & 31u) == 0u) tg_sq[tid >> 5] = sq;\n")
    p = bf16_cstr_append(buf, p, "    threadgroup_barrier(mem_flags::mem_threadgroup);\n")
    p = bf16_cstr_append(buf, p, "    if (tid == 0) {\n")
    p = bf16_cstr_append(buf, p, "        float tsq = 0.0f; for (uint s = 0; s < 8; ++s) tsq = tsq + tg_sq[s];\n")
    p = bf16_cstr_append(buf, p, "        tg_inv = rsqrt(tsq / float(dim) + as_type<float>((uint)eps_bits));\n")
