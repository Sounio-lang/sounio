pub fn qwen3_metal_encode_gemv_bf16_qkv(
    s: &MetalSession,
    cid: i64,
    pipe: i64,
    wq_buf: i64,
    wk_buf: i64,
    wv_buf: i64,
    x_buf: i64,
    out_buf: i64,
    wq_off: i64,
    wk_off: i64,
    wv_off: i64,
    x_off: i64,
    yq_off: i64,
    yk_off: i64,
    yv_off: i64,
    q_dim: i64,
    kv_dim: i64,
    in_dim: i64
) -> i64 {
    if !s.ok || cid <= 0 || pipe <= 0 || wq_buf <= 0 || wk_buf <= 0 || wv_buf <= 0
        || x_buf <= 0 || out_buf <= 0 || q_dim <= 0 || kv_dim <= 0 || in_dim <= 0 {
        return -1
    }
    if metal_cmd_set_buf(s, cid, 0, wq_buf, 0) != 0
        || metal_cmd_set_buf(s, cid, 1, wk_buf, 0) != 0
        || metal_cmd_set_buf(s, cid, 2, wv_buf, 0) != 0
        || metal_cmd_set_buf(s, cid, 3, x_buf, 0) != 0
        || metal_cmd_set_buf(s, cid, 4, out_buf, 0) != 0
        || metal_cmd_set_u64(s, cid, 5, wq_off) != 0
        || metal_cmd_set_u64(s, cid, 6, wk_off) != 0
        || metal_cmd_set_u64(s, cid, 7, wv_off) != 0
        || metal_cmd_set_u64(s, cid, 8, x_off) != 0
        || metal_cmd_set_u64(s, cid, 9, yq_off) != 0
        || metal_cmd_set_u64(s, cid, 10, yk_off) != 0
        || metal_cmd_set_u64(s, cid, 11, yv_off) != 0
        || metal_cmd_set_u64(s, cid, 12, q_dim) != 0
        || metal_cmd_set_u64(s, cid, 13, kv_dim) != 0
        || metal_cmd_set_u64(s, cid, 14, in_dim) != 0 {
        return -1
    }
    let total_out = q_dim + 2 * kv_dim
    let n_groups = (total_out + 31) / 32
    let total_threads = n_groups * 256
    if metal_cmd_dispatch_1d(s, cid, pipe, total_threads, 256) != 0 {
        return -1
    }
    0
}

