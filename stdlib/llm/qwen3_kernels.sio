pub fn qwen3_metal_kv_scatter(
    s: &MetalSession,
    pipe: i64,
    k_src_buf: i64,
    k_src_off: i64,
    v_src_buf: i64,
    v_src_off: i64,
    kv_buf: i64,
    table_off: i64,
    k_layer_off: i64,
    v_layer_off: i64,
    n_kv_dim: i64,
    pos: i64,
    block_size: i64
) -> i64 {
    if !s.ok || pipe <= 0 || n_kv_dim <= 0 || block_size <= 0 { return -1 }
    let cid = metal_cmd_begin(s)
    if cid <= 0 { return -1 }
    if qwen3_metal_encode_kv_scatter(s, cid, pipe, k_src_buf, k_src_off, v_src_buf, v_src_off, kv_buf, table_off, k_layer_off, v_layer_off, n_kv_dim, pos, block_size) != 0 {
        let _c = metal_cmd_cancel(s, cid)
        return -1
    }
    metal_cmd_commit_sync(s, cid)
}

