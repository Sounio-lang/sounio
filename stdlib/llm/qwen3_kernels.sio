    p = bf16_cstr_append(buf, p, "    device float* out_y = (device float*)(out_base + out_off);\n")
    p = bf16_cstr_append(buf, p, "    device const ushort* rg0 = has0 ? ((device const ushort*)(wg_base + wg_off) + r0 * in_dim) : (device const ushort*)wg_base;\n")
    p = bf16_cstr_append(buf, p, "    device const ushort* ru0 = has0 ? ((device const ushort*)(wu_base + wu_off) + r0 * in_dim) : (device const ushort*)wu_base;\n")
    p = bf16_cstr_append(buf, p, "    device const ushort* rg1 = has1 ? ((device const ushort*)(wg_base + wg_off) + r1 * in_dim) : (device const ushort*)wg_base;\n")
    p = bf16_cstr_append(buf, p, "    device const ushort* ru1 = has1 ? ((device const ushort*)(wu_base + wu_off) + r1 * in_dim) : (device const ushort*)wu_base;\n")
    p = bf16_cstr_append(buf, p, "    float g00=0.0f,g01=0.0f,g02=0.0f,g03=0.0f; float u00=0.0f,u01=0.0f,u02=0.0f,u03=0.0f;\n")
    p = bf16_cstr_append(buf, p, "    float g10=0.0f,g11=0.0f,g12=0.0f,g13=0.0f; float u10=0.0f,u11=0.0f,u12=0.0f,u13=0.0f;\n")
    p = bf16_cstr_append(buf, p, "    for (ulong k_base = 0; k_base < in_dim; k_base = k_base + 1024ul) {\n")
    p = bf16_cstr_append(buf, p, "        ulong chunk_k = min(1024ul, in_dim - k_base);\n")
    p = bf16_cstr_append(buf, p, "        for (ulong k = (ulong)tid; k < chunk_k; k = k + 256ul) { tg_x[k + ((k >> 5) << 2)] = in_x[k_base + k]; }\n")
    p = bf16_cstr_append(buf, p, "        threadgroup_barrier(mem_flags::mem_threadgroup);\n")
    p = bf16_cstr_append(buf, p, "        device const ushort* cg0 = rg0 + k_base; device const ushort* cu0 = ru0 + k_base;\n")
    p = bf16_cstr_append(buf, p, "        device const ushort* cg1 = rg1 + k_base; device const ushort* cu1 = ru1 + k_base;\n")
    p = bf16_cstr_append(buf, p, "        bool alg0 = has0 && ((((ulong)cg0) & 7ul) == 0); bool alu0 = has0 && ((((ulong)cu0) & 7ul) == 0);\n")
    p = bf16_cstr_append(buf, p, "        bool alg1 = has1 && ((((ulong)cg1) & 7ul) == 0); bool alu1 = has1 && ((((ulong)cu1) & 7ul) == 0);\n")
    p = bf16_cstr_append(buf, p, "        for (ulong k = (ulong)lane * 4ul; k + 3ul < chunk_k; k = k + 128ul) {\n")
    p = bf16_cstr_append(buf, p, "            ulong u = k >> 2; float4 x4 = tg_x4[u + (u >> 3)];\n")
    p = bf16_cstr_append(buf, p, "            if (has0) {\n")
    p = bf16_cstr_append(buf, p, "                float4 wg = qwen3_load_bf16_4(cg0, k, alg0); float4 wu = qwen3_load_bf16_4(cu0, k, alu0);\n")
    p = bf16_cstr_append(buf, p, "                g00 = fma(wg.x, x4.x, g00); g01 = fma(wg.y, x4.y, g01); g02 = fma(wg.z, x4.z, g02); g03 = fma(wg.w, x4.w, g03);\n")
    p = bf16_cstr_append(buf, p, "                u00 = fma(wu.x, x4.x, u00); u01 = fma(wu.y, x4.y, u01); u02 = fma(wu.z, x4.z, u02); u03 = fma(wu.w, x4.w, u03);\n")
    p = bf16_cstr_append(buf, p, "            }\n")
    p = bf16_cstr_append(buf, p, "            if (has1) {\n")
    p = bf16_cstr_append(buf, p, "                float4 wg = qwen3_load_bf16_4(cg1, k, alg1); float4 wu = qwen3_load_bf16_4(cu1, k, alu1);\n")
    p = bf16_cstr_append(buf, p, "                g10 = fma(wg.x, x4.x, g10); g11 = fma(wg.y, x4.y, g11); g12 = fma(wg.z, x4.z, g12); g13 = fma(wg.w, x4.w, g13);\n")
    p = bf16_cstr_append(buf, p, "                u10 = fma(wu.x, x4.x, u10); u11 = fma(wu.y, x4.y, u11); u12 = fma(wu.z, x4.z, u12); u13 = fma(wu.w, x4.w, u13);\n")
    p = bf16_cstr_append(buf, p, "            }\n")
    p = bf16_cstr_append(buf, p, "        }\n")
    p = bf16_cstr_append(buf, p, "        for (ulong kt = (chunk_k & ~3ULL) + (ulong)lane; kt < chunk_k; kt = kt + 32ul) {\n")
    p = bf16_cstr_append(buf, p, "            float xt = tg_x[kt + ((kt >> 5) << 2)];\n")
    p = bf16_cstr_append(buf, p, "            if (has0) { g00 = fma(as_type<float>(((uint)cg0[kt]) << 16), xt, g00); u00 = fma(as_type<float>(((uint)cu0[kt]) << 16), xt, u00); }\n")
    p = bf16_cstr_append(buf, p, "            if (has1) { g10 = fma(as_type<float>(((uint)cg1[kt]) << 16), xt, g10); u10 = fma(as_type<float>(((uint)cu1[kt]) << 16), xt, u10); }\n")
    p = bf16_cstr_append(buf, p, "        }\n")
    p = bf16_cstr_append(buf, p, "        threadgroup_barrier(mem_flags::mem_threadgroup);\n")
    p = bf16_cstr_append(buf, p, "    }\n")
    p = bf16_cstr_append(buf, p, "    if (has0) { float sg0 = sounio_warp_sum_f32((g00 + g01) + (g02 + g03)); float su0 = sounio_warp_sum_f32((u00 + u01) + (u02 + u03)); if (lane == 0) out_y[r0] = precise::divide(sg0, 1.0f + sounio_exp_f32(-sg0)) * su0; }\n")
    p = bf16_cstr_append(buf, p, "    if (has1) { float sg1 = sounio_warp_sum_f32((g10 + g11) + (g12 + g13)); float su1 = sounio_warp_sum_f32((u10 + u11) + (u12 + u13)); if (lane == 0) out_y[r1] = precise::divide(sg1, 1.0f + sounio_exp_f32(-sg1)) * su1; }\n}\n\n")

    // 23. qwen3_gemm_bf16_tc (Metal simdgroup_float8x8 Tensor Core fast prefill, VENDOR_PREFILL)
    p = bf16_cstr_append(buf, p, "kernel void qwen3_gemm_bf16_tc(\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* w_base [[buffer(0)]], constant ulong& w_off [[buffer(1)]],\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* x_base [[buffer(2)]], constant ulong& x_off [[buffer(3)]],\n")
    p = bf16_cstr_append(buf, p, "    device uchar* y_base [[buffer(4)]], constant ulong& y_off [[buffer(5)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& out_dim [[buffer(6)]], constant ulong& in_dim [[buffer(7)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& n_toks [[buffer(8)]], uint gid [[thread_position_in_grid]], uint tid [[thread_index_in_threadgroup]]) {\n")
    p = bf16_cstr_append(buf, p, "    ulong n_m = (out_dim + 63ul) / 64ul; ulong n_n = (n_toks + 7ul) / 8ul;\n")
    p = bf16_cstr_append(buf, p, "    ulong bid = (ulong)gid >> 8;\n")
    p = bf16_cstr_append(buf, p, "    if (n_toks == 0 || bid >= n_m * n_n) return;\n")
    p = bf16_cstr_append(buf, p, "    ulong g_m = bid % n_m; ulong g_n = bid / n_m;\n")
    p = bf16_cstr_append(buf, p, "    ulong sg = (ulong)tid >> 5; ulong lane = (ulong)tid & 31ul;\n")
    p = bf16_cstr_append(buf, p, "    threadgroup float tg_a[512];\n")
    p = bf16_cstr_append(buf, p, "    threadgroup float tg_b[64];\n")
    p = bf16_cstr_append(buf, p, "    device const ushort* w_bf16 = (device const ushort*)(w_base + w_off);\n")
    p = bf16_cstr_append(buf, p, "    device const float* in_x = (device const float*)(x_base + x_off);\n")
    p = bf16_cstr_append(buf, p, "    device float* out_y = (device float*)(y_base + y_off);\n")
    p = bf16_cstr_append(buf, p, "    simdgroup_float8x8 matC = simdgroup_float8x8(0.0f);\n")
    p = bf16_cstr_append(buf, p, "    for (ulong k_base = 0ul; k_base < in_dim; k_base = k_base + 8ul) {\n")
    p = bf16_cstr_append(buf, p, "        if (tid < 64u) {\n")
    p = bf16_cstr_append(buf, p, "            ulong kl = (ulong)tid >> 3; ulong nl = (ulong)tid & 7ul;\n")
    p = bf16_cstr_append(buf, p, "            ulong tok = g_n * 8ul + nl; ulong kk = k_base + kl;\n")
    p = bf16_cstr_append(buf, p, "            tg_b[tid] = (tok < n_toks && kk < in_dim) ? in_x[tok * in_dim + kk] : 0.0f;\n")
    p = bf16_cstr_append(buf, p, "        }\n")
    p = bf16_cstr_append(buf, p, "        for (ulong sub = 0ul; sub < 2ul; ++sub) {\n")
    p = bf16_cstr_append(buf, p, "            ulong idx = lane + sub * 32ul; ulong rl = idx >> 3; ulong kl = idx & 7ul;\n")
    p = bf16_cstr_append(buf, p, "            ulong row = g_m * 64ul + sg * 8ul + rl; ulong kk = k_base + kl;\n")
    p = bf16_cstr_append(buf, p, "            tg_a[sg * 64ul + idx] = (row < out_dim && kk < in_dim) ? as_type<float>(((uint)w_bf16[row * in_dim + kk]) << 16) : 0.0f;\n")
    p = bf16_cstr_append(buf, p, "        }\n")
    p = bf16_cstr_append(buf, p, "        threadgroup_barrier(mem_flags::mem_threadgroup);\n")
    p = bf16_cstr_append(buf, p, "        simdgroup_float8x8 matA; simdgroup_float8x8 matB;\n")
    p = bf16_cstr_append(buf, p, "        simdgroup_load(matA, tg_a + sg * 64ul, 8);\n")
    p = bf16_cstr_append(buf, p, "        simdgroup_load(matB, tg_b, 8);\n")
    p = bf16_cstr_append(buf, p, "        simdgroup_multiply_accumulate(matC, matA, matB, matC);\n")
    p = bf16_cstr_append(buf, p, "        threadgroup_barrier(mem_flags::mem_threadgroup);\n")
    p = bf16_cstr_append(buf, p, "    }\n")
    p = bf16_cstr_append(buf, p, "    simdgroup_store(matC, tg_a + sg * 64ul, 8);\n")
    p = bf16_cstr_append(buf, p, "    threadgroup_barrier(mem_flags::mem_threadgroup);\n")
    p = bf16_cstr_append(buf, p, "    for (ulong sub = 0ul; sub < 2ul; ++sub) {\n")
    p = bf16_cstr_append(buf, p, "        ulong idx = lane + sub * 32ul; ulong rl = idx >> 3; ulong nl = idx & 7ul;\n")
    p = bf16_cstr_append(buf, p, "        ulong row = g_m * 64ul + sg * 8ul + rl; ulong tok = g_n * 8ul + nl;\n")
    p = bf16_cstr_append(buf, p, "        if (row < out_dim && tok < n_toks) out_y[tok * out_dim + row] = tg_a[sg * 64ul + idx];\n")
    p = bf16_cstr_append(buf, p, "    }\n}\n\n")
    buf
}

pub fn emit_qwen3_kernels_ptx_cstr() -> i64 with Alloc, Mut {
    emit_qwen3_ptx_sm80_cstr()
}

pub fn qwen3_metal_pipelines_compile(s: &MetalSession) -> Qwen3MetalPipelines with Alloc, Mut {
    let c_src = emit_qwen3_kernels_msl_cstr()
    if c_src == 0 { return qwen3_metal_pipelines_empty() }

    let p_rmsnorm_bf16 = metal_compile_msl_ptr(s, c_src, "qwen3_rmsnorm_bf16")
    let p_rmsnorm_f32 = metal_compile_msl_ptr(s, c_src, "qwen3_rmsnorm_f32")
    let p_rope = metal_compile_msl_ptr(s, c_src, "qwen3_rope_f32")
    let p_gemv_bf16 = metal_compile_msl_ptr(s, c_src, "qwen3_gemv_bf16")
    let p_gemv_f32 = metal_compile_msl_ptr(s, c_src, "qwen3_gemv_f32")
    let p_swiglu = metal_compile_msl_ptr(s, c_src, "qwen3_swiglu_f32")
    let p_paged_gqa = metal_compile_msl_ptr(s, c_src, "qwen3_paged_gqa_f32")
    let p_vec_add = metal_compile_msl_ptr(s, c_src, "qwen3_vec_add_f32")
    let p_kv_scatter = metal_compile_msl_ptr(s, c_src, "qwen3_kv_scatter_f32")
    let p_argmax_top2 = metal_compile_msl_ptr(s, c_src, "qwen3_argmax_top2_f32")
    let p_gemm_bf16 = metal_compile_msl_ptr(s, c_src, "qwen3_gemm_bf16")
    let p_gemm_f32 = metal_compile_msl_ptr(s, c_src, "qwen3_gemm_f32")
    let p_rope_batch = metal_compile_msl_ptr(s, c_src, "qwen3_rope_batch_f32")
    let p_kv_scatter_batch = metal_compile_msl_ptr(s, c_src, "qwen3_kv_scatter_batch_f32")
    let p_paged_gqa_batch = metal_compile_msl_ptr(s, c_src, "qwen3_paged_gqa_batch_f32")
    let p_argmax_top2_batch = metal_compile_msl_ptr(s, c_src, "qwen3_argmax_top2_batch_f32")
    let p_qk_norm_rope_kv_bf16 = metal_compile_msl_ptr(s, c_src, "qwen3_qk_norm_rope_kv_scatter_bf16")
    let p_qk_norm_rope_kv_f32 = metal_compile_msl_ptr(s, c_src, "qwen3_qk_norm_rope_kv_scatter_f32")
    let p_add_rmsnorm_bf16 = metal_compile_msl_ptr(s, c_src, "qwen3_add_rmsnorm_bf16")
    let p_add_rmsnorm_f32 = metal_compile_msl_ptr(s, c_src, "qwen3_add_rmsnorm_f32")
    let p_gemv_bf16_qkv = metal_compile_msl_ptr(s, c_src, "qwen3_gemv_bf16_qkv")
    let p_gemv_bf16_gate_up_swiglu = metal_compile_msl_ptr(s, c_src, "qwen3_gemv_bf16_gate_up_swiglu")
    let p_rope_table = metal_compile_msl_ptr(s, c_src, "qwen3_rope_table_f32")
    let p_rope_batch_table = metal_compile_msl_ptr(s, c_src, "qwen3_rope_batch_table_f32")
    let p_gemm_bf16_tc = metal_compile_msl_ptr(s, c_src, "qwen3_gemm_bf16_tc")

    heap_free(c_src as *mut u8)

    let all_ok = p_rmsnorm_bf16 > 0 && p_rmsnorm_f32 > 0 && p_rope > 0
        && p_gemv_bf16 > 0 && p_gemv_f32 > 0 && p_swiglu > 0 && p_paged_gqa > 0
        && p_vec_add > 0 && p_kv_scatter > 0 && p_argmax_top2 > 0
        && p_gemm_bf16 > 0 && p_gemm_f32 > 0 && p_rope_batch > 0
        && p_kv_scatter_batch > 0 && p_paged_gqa_batch > 0 && p_argmax_top2_batch > 0
        && p_qk_norm_rope_kv_bf16 > 0 && p_qk_norm_rope_kv_f32 > 0
        && p_add_rmsnorm_bf16 > 0 && p_add_rmsnorm_f32 > 0
        && p_gemv_bf16_qkv > 0 && p_gemv_bf16_gate_up_swiglu > 0
        && p_rope_table > 0 && p_rope_batch_table > 0 && p_gemm_bf16_tc > 0

    Qwen3MetalPipelines {
        rmsnorm_bf16: p_rmsnorm_bf16,
        rmsnorm_f32: p_rmsnorm_f32,
        rope: p_rope,
        gemv_bf16: p_gemv_bf16,
        gemv_f32: p_gemv_f32,
        swiglu: p_swiglu,
        paged_gqa: p_paged_gqa,
        vec_add: p_vec_add,
        kv_scatter: p_kv_scatter,
        argmax_top2: p_argmax_top2,
        gemm_bf16: p_gemm_bf16,
        gemm_f32: p_gemm_f32,
        rope_batch: p_rope_batch,
        kv_scatter_batch: p_kv_scatter_batch,
        paged_gqa_batch: p_paged_gqa_batch,
        argmax_top2_batch: p_argmax_top2_batch,
        qk_norm_rope_kv_bf16: p_qk_norm_rope_kv_bf16,
        qk_norm_rope_kv_f32: p_qk_norm_rope_kv_f32,
        add_rmsnorm_bf16: p_add_rmsnorm_bf16,
        add_rmsnorm_f32: p_add_rmsnorm_f32,
        gemv_bf16_qkv: p_gemv_bf16_qkv,
        gemv_bf16_gate_up_swiglu: p_gemv_bf16_gate_up_swiglu,
        rope_table: p_rope_table,
        rope_batch_table: p_rope_batch_table,
        gemm_bf16_tc: p_gemm_bf16_tc,
        ok: all_ok,
    }
}

pub fn qwen3_metal_encode_rmsnorm(
    s: &MetalSession,
    cid: i64,
    pipe: i64,
    x_buf: i64,
    x_byte_off: i64,
    w_buf: i64,
    w_byte_off: i64,
    out_buf: i64,
    out_byte_off: i64,
    n_groups: i64,
    dim: i64,
    eps_f32_bits: i64
) -> i64 {
    if !s.ok || cid <= 0 || pipe <= 0 || n_groups <= 0 || dim <= 0 { return -1 }
    if metal_cmd_set_buf(s, cid, 0, x_buf, 0) != 0
        || metal_cmd_set_u64(s, cid, 1, x_byte_off) != 0
        || metal_cmd_set_buf(s, cid, 2, w_buf, 0) != 0
        || metal_cmd_set_u64(s, cid, 3, w_byte_off) != 0
        || metal_cmd_set_buf(s, cid, 4, out_buf, 0) != 0
        || metal_cmd_set_u64(s, cid, 5, out_byte_off) != 0
        || metal_cmd_set_u64(s, cid, 6, n_groups) != 0
        || metal_cmd_set_u64(s, cid, 7, dim) != 0
        || metal_cmd_set_u64(s, cid, 8, eps_f32_bits) != 0 {
        return -1
    }
    let total_threads = n_groups * 32
    let group_threads = if total_threads < 128 { 32 } else { 128 }
    if metal_cmd_dispatch_1d(s, cid, pipe, total_threads, group_threads) != 0 {
        return -1
    }
    0
}

pub fn qwen3_metal_rmsnorm(
    s: &MetalSession,
    pipes: &Qwen3MetalPipelines,
    x_buf: i64,
    x_byte_off: i64,
    w_buf: i64,
    w_byte_off: i64,
    w_dtype: i32,
    out_buf: i64,
    out_byte_off: i64,
    n_groups: i64,
    dim: i64,
    eps_f32_bits: i64
) -> i64 {
    if !pipes.ok || n_groups <= 0 || dim <= 0 { return -1 }
    let pipe = if w_dtype == 2 { pipes.rmsnorm_bf16 } else { pipes.rmsnorm_f32 }
    if pipe <= 0 { return -1 }
    let cid = metal_cmd_begin(s)
    if cid <= 0 { return -1 }
    if qwen3_metal_encode_rmsnorm(s, cid, pipe, x_buf, x_byte_off, w_buf, w_byte_off, out_buf, out_byte_off, n_groups, dim, eps_f32_bits) != 0 {
        let _c = metal_cmd_cancel(s, cid)
        return -1
    }
    metal_cmd_commit_sync(s, cid)
}

pub fn qwen3_metal_encode_rope(
    s: &MetalSession,
    cid: i64,
    pipe: i64,
    vec_buf: i64,
    vec_byte_off: i64,
    n_heads: i64,
    head_dim: i64,
    pos: i64,
    theta_f32_bits: i64
) -> i64 {
    if !s.ok || cid <= 0 || pipe <= 0 || n_heads <= 0 || head_dim <= 0 { return -1 }
    if metal_cmd_set_buf(s, cid, 0, vec_buf, 0) != 0
        || metal_cmd_set_u64(s, cid, 1, vec_byte_off) != 0
        || metal_cmd_set_u64(s, cid, 2, n_heads) != 0
        || metal_cmd_set_u64(s, cid, 3, head_dim) != 0
        || metal_cmd_set_u64(s, cid, 4, pos) != 0
        || metal_cmd_set_u64(s, cid, 5, theta_f32_bits) != 0 {
        return -1
    }
    let hdim = head_dim / 2
    let total_threads = n_heads * hdim
    let group_threads = if total_threads < 64 { total_threads } else { 64 }
    if metal_cmd_dispatch_1d(s, cid, pipe, total_threads, group_threads) != 0 {
        return -1
    }
    0
}

pub fn qwen3_metal_rope(
    s: &MetalSession,
    pipes: &Qwen3MetalPipelines,
    vec_buf: i64,
    vec_byte_off: i64,
    n_heads: i64,
    head_dim: i64,
    pos: i64,
    theta_f32_bits: i64
) -> i64 {
    if !pipes.ok || n_heads <= 0 || head_dim <= 0 { return -1 }
    let pipe = pipes.rope
    if pipe <= 0 { return -1 }
    let cid = metal_cmd_begin(s)
    if cid <= 0 { return -1 }
    if qwen3_metal_encode_rope(s, cid, pipe, vec_buf, vec_byte_off, n_heads, head_dim, pos, theta_f32_bits) != 0 {
        let _c = metal_cmd_cancel(s, cid)
        return -1
    }
    metal_cmd_commit_sync(s, cid)
}

pub fn qwen3_metal_encode_gemv(
    s: &MetalSession,
    cid: i64,
    pipe: i64,
    w_buf: i64,
    w_byte_off: i64,
    x_buf: i64,
    x_byte_off: i64,
    y_buf: i64,
    y_byte_off: i64,
    out_dim: i64,
    in_dim: i64
) -> i64 {
    if !s.ok || cid <= 0 || pipe <= 0 || out_dim <= 0 || in_dim <= 0 { return -1 }
    if metal_cmd_set_buf(s, cid, 0, w_buf, 0) != 0
        || metal_cmd_set_u64(s, cid, 1, w_byte_off) != 0
        || metal_cmd_set_buf(s, cid, 2, x_buf, 0) != 0
        || metal_cmd_set_u64(s, cid, 3, x_byte_off) != 0
        || metal_cmd_set_buf(s, cid, 4, y_buf, 0) != 0
        || metal_cmd_set_u64(s, cid, 5, y_byte_off) != 0
        || metal_cmd_set_u64(s, cid, 6, out_dim) != 0
        || metal_cmd_set_u64(s, cid, 7, in_dim) != 0 {
        return -1
    }
    let n_groups = (out_dim + 31) / 32
    let total_threads = n_groups * 256
    if metal_cmd_dispatch_1d(s, cid, pipe, total_threads, 256) != 0 {
        return -1
    }
    0
}

pub fn qwen3_metal_gemv(
    s: &MetalSession,
    pipes: &Qwen3MetalPipelines,
    w_buf: i64,
    w_byte_off: i64,
    w_dtype: i32,
    x_buf: i64,
    x_byte_off: i64,
    y_buf: i64,
    y_byte_off: i64,
    out_dim: i64,
    in_dim: i64
) -> i64 {
    if !pipes.ok || out_dim <= 0 || in_dim <= 0 { return -1 }
    let pipe = if w_dtype == 2 { pipes.gemv_bf16 } else { pipes.gemv_f32 }
