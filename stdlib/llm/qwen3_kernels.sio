    p = bf16_cstr_append(buf, p, "    device float* out = (device float*)(out_base + out_off);\n")
    p = bf16_cstr_append(buf, p, "    float sq = 0.0f;\n")
    p = bf16_cstr_append(buf, p, "    for (ulong i = (ulong)lane; i < dim; i = i + 32ul) { float v = x[i] + h[i]; x[i] = v; sq = fma(v, v, sq); }\n")
    p = bf16_cstr_append(buf, p, "    sq = sounio_warp_sum_f32(sq);\n")
    p = bf16_cstr_append(buf, p, "    float inv_rms = precise::divide(1.0f, precise::sqrt(precise::divide(sq, float(dim)) + as_type<float>((uint)eps_bits)));\n")
    p = bf16_cstr_append(buf, p, "    for (ulong i = (ulong)lane; i < dim; i = i + 32ul) { out[i] = (x[i] * inv_rms) * w[i]; }\n")
    p = bf16_cstr_append(buf, p, "}\n\n")

    // 21. qwen3_gemv_bf16_qkv (F1-BF16: K-chunked swizzled tg_x4[288] + 4-row/SIMD register reuse + 1-add tree)
    p = bf16_cstr_append(buf, p, "kernel void qwen3_gemv_bf16_qkv(\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* wq_base [[buffer(0)]], device const uchar* wk_base [[buffer(1)]],\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* wv_base [[buffer(2)]], device const uchar* x_base [[buffer(3)]],\n")
    p = bf16_cstr_append(buf, p, "    device uchar* out_base [[buffer(4)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& wq_off [[buffer(5)]], constant ulong& wk_off [[buffer(6)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& wv_off [[buffer(7)]], constant ulong& x_off [[buffer(8)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& yq_off [[buffer(9)]], constant ulong& yk_off [[buffer(10)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& yv_off [[buffer(11)]], constant ulong& q_dim [[buffer(12)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& kv_dim [[buffer(13)]], constant ulong& in_dim [[buffer(14)]],\n")
    p = bf16_cstr_append(buf, p, "    uint gid [[thread_position_in_grid]], uint tid [[thread_index_in_threadgroup]]) {\n")
    p = bf16_cstr_append(buf, p, "    threadgroup float4 tg_x4[288];\n")
    p = bf16_cstr_append(buf, p, "    threadgroup float* tg_x = (threadgroup float*)tg_x4;\n")
    p = bf16_cstr_append(buf, p, "    ulong total_out = q_dim + 2ul * kv_dim;\n")
    p = bf16_cstr_append(buf, p, "    ulong n_groups = (total_out + 31) / 32; ulong g = (ulong)gid >> 8;\n")
    p = bf16_cstr_append(buf, p, "    if (g >= n_groups) return;\n")
    p = bf16_cstr_append(buf, p, "    ulong sg = (ulong)tid >> 5; ulong lane = (ulong)tid & 31ul;\n")
    p = bf16_cstr_append(buf, p, "    ulong r0 = g * 32ul + sg; ulong r1 = r0 + 8ul; ulong r2 = r0 + 16ul; ulong r3 = r0 + 24ul;\n")
    p = bf16_cstr_append(buf, p, "    bool has0 = (r0 < total_out); bool has1 = (r1 < total_out); bool has2 = (r2 < total_out); bool has3 = (r3 < total_out);\n")
    p = bf16_cstr_append(buf, p, "    device const ushort* rw0 = (device const ushort*)wq_base; device float* dst0 = (device float*)out_base; ulong lr0 = 0ul;\n")
    p = bf16_cstr_append(buf, p, "    device const ushort* rw1 = (device const ushort*)wq_base; device float* dst1 = (device float*)out_base; ulong lr1 = 0ul;\n")
    p = bf16_cstr_append(buf, p, "    device const ushort* rw2 = (device const ushort*)wq_base; device float* dst2 = (device float*)out_base; ulong lr2 = 0ul;\n")
    p = bf16_cstr_append(buf, p, "    device const ushort* rw3 = (device const ushort*)wq_base; device float* dst3 = (device float*)out_base; ulong lr3 = 0ul;\n")
    p = bf16_cstr_append(buf, p, "    if (has0) {\n")
    p = bf16_cstr_append(buf, p, "        if (r0 < q_dim) { lr0 = r0; rw0 = (device const ushort*)(wq_base + wq_off) + lr0 * in_dim; dst0 = (device float*)(out_base + yq_off); }\n")
    p = bf16_cstr_append(buf, p, "        else if (r0 < q_dim + kv_dim) { lr0 = r0 - q_dim; rw0 = (device const ushort*)(wk_base + wk_off) + lr0 * in_dim; dst0 = (device float*)(out_base + yk_off); }\n")
    p = bf16_cstr_append(buf, p, "        else { lr0 = r0 - q_dim - kv_dim; rw0 = (device const ushort*)(wv_base + wv_off) + lr0 * in_dim; dst0 = (device float*)(out_base + yv_off); }\n")
    p = bf16_cstr_append(buf, p, "    }\n")
    p = bf16_cstr_append(buf, p, "    if (has1) {\n")
    p = bf16_cstr_append(buf, p, "        if (r1 < q_dim) { lr1 = r1; rw1 = (device const ushort*)(wq_base + wq_off) + lr1 * in_dim; dst1 = (device float*)(out_base + yq_off); }\n")
    p = bf16_cstr_append(buf, p, "        else if (r1 < q_dim + kv_dim) { lr1 = r1 - q_dim; rw1 = (device const ushort*)(wk_base + wk_off) + lr1 * in_dim; dst1 = (device float*)(out_base + yk_off); }\n")
    p = bf16_cstr_append(buf, p, "        else { lr1 = r1 - q_dim - kv_dim; rw1 = (device const ushort*)(wv_base + wv_off) + lr1 * in_dim; dst1 = (device float*)(out_base + yv_off); }\n")
    p = bf16_cstr_append(buf, p, "    }\n")
    p = bf16_cstr_append(buf, p, "    if (has2) {\n")
    p = bf16_cstr_append(buf, p, "        if (r2 < q_dim) { lr2 = r2; rw2 = (device const ushort*)(wq_base + wq_off) + lr2 * in_dim; dst2 = (device float*)(out_base + yq_off); }\n")
    p = bf16_cstr_append(buf, p, "        else if (r2 < q_dim + kv_dim) { lr2 = r2 - q_dim; rw2 = (device const ushort*)(wk_base + wk_off) + lr2 * in_dim; dst2 = (device float*)(out_base + yk_off); }\n")
    p = bf16_cstr_append(buf, p, "        else { lr2 = r2 - q_dim - kv_dim; rw2 = (device const ushort*)(wv_base + wv_off) + lr2 * in_dim; dst2 = (device float*)(out_base + yv_off); }\n")
    p = bf16_cstr_append(buf, p, "    }\n")
    p = bf16_cstr_append(buf, p, "    if (has3) {\n")
    p = bf16_cstr_append(buf, p, "        if (r3 < q_dim) { lr3 = r3; rw3 = (device const ushort*)(wq_base + wq_off) + lr3 * in_dim; dst3 = (device float*)(out_base + yq_off); }\n")
    p = bf16_cstr_append(buf, p, "        else if (r3 < q_dim + kv_dim) { lr3 = r3 - q_dim; rw3 = (device const ushort*)(wk_base + wk_off) + lr3 * in_dim; dst3 = (device float*)(out_base + yk_off); }\n")
    p = bf16_cstr_append(buf, p, "        else { lr3 = r3 - q_dim - kv_dim; rw3 = (device const ushort*)(wv_base + wv_off) + lr3 * in_dim; dst3 = (device float*)(out_base + yv_off); }\n")
    p = bf16_cstr_append(buf, p, "    }\n")
    p = bf16_cstr_append(buf, p, "    device const float* in_x = (device const float*)(x_base + x_off);\n")
    p = bf16_cstr_append(buf, p, "    float a0=0.0f, a1=0.0f, a2=0.0f, a3=0.0f; float b0=0.0f, b1=0.0f, b2=0.0f, b3=0.0f;\n")
    p = bf16_cstr_append(buf, p, "    float d0=0.0f, d1=0.0f, d2=0.0f, d3=0.0f; float e0=0.0f, e1=0.0f, e2=0.0f, e3=0.0f;\n")
    p = bf16_cstr_append(buf, p, "    for (ulong k_base = 0; k_base < in_dim; k_base = k_base + 1024ul) {\n")
    p = bf16_cstr_append(buf, p, "        ulong chunk_k = min(1024ul, in_dim - k_base);\n")
    p = bf16_cstr_append(buf, p, "        for (ulong k = (ulong)tid; k < chunk_k; k = k + 256ul) { tg_x[k + ((k >> 5) << 2)] = in_x[k_base + k]; }\n")
    p = bf16_cstr_append(buf, p, "        threadgroup_barrier(mem_flags::mem_threadgroup);\n")
    p = bf16_cstr_append(buf, p, "        device const ushort* c0 = rw0 + k_base; device const ushort* c1 = rw1 + k_base;\n")
    p = bf16_cstr_append(buf, p, "        device const ushort* c2 = rw2 + k_base; device const ushort* c3 = rw3 + k_base;\n")
    p = bf16_cstr_append(buf, p, "        bool al0 = has0 && ((((ulong)c0) & 7ul) == 0); bool al1 = has1 && ((((ulong)c1) & 7ul) == 0);\n")
    p = bf16_cstr_append(buf, p, "        bool al2 = has2 && ((((ulong)c2) & 7ul) == 0); bool al3 = has3 && ((((ulong)c3) & 7ul) == 0);\n")
    p = bf16_cstr_append(buf, p, "        for (ulong k = (ulong)lane * 4ul; k + 3ul < chunk_k; k = k + 128ul) {\n")
    p = bf16_cstr_append(buf, p, "            ulong u = k >> 2; float4 x4 = tg_x4[u + (u >> 3)];\n")
    p = bf16_cstr_append(buf, p, "            if (has0) { float4 wv = qwen3_load_bf16_4(c0, k, al0); a0 = fma(wv.x, x4.x, a0); a1 = fma(wv.y, x4.y, a1); a2 = fma(wv.z, x4.z, a2); a3 = fma(wv.w, x4.w, a3); }\n")
    p = bf16_cstr_append(buf, p, "            if (has1) { float4 wv = qwen3_load_bf16_4(c1, k, al1); b0 = fma(wv.x, x4.x, b0); b1 = fma(wv.y, x4.y, b1); b2 = fma(wv.z, x4.z, b2); b3 = fma(wv.w, x4.w, b3); }\n")
    p = bf16_cstr_append(buf, p, "            if (has2) { float4 wv = qwen3_load_bf16_4(c2, k, al2); d0 = fma(wv.x, x4.x, d0); d1 = fma(wv.y, x4.y, d1); d2 = fma(wv.z, x4.z, d2); d3 = fma(wv.w, x4.w, d3); }\n")
    p = bf16_cstr_append(buf, p, "            if (has3) { float4 wv = qwen3_load_bf16_4(c3, k, al3); e0 = fma(wv.x, x4.x, e0); e1 = fma(wv.y, x4.y, e1); e2 = fma(wv.z, x4.z, e2); e3 = fma(wv.w, x4.w, e3); }\n")
    p = bf16_cstr_append(buf, p, "        }\n")
    p = bf16_cstr_append(buf, p, "        for (ulong kt = (chunk_k & ~3ULL) + (ulong)lane; kt < chunk_k; kt = kt + 32ul) {\n")
