pub fn qwen3_metal_encode_kv_scatter_batch(
    s: &MetalSession,
    cid: i64,
    pipe: i64,
    k_src_buf: i64,
    k_src_off: i64,
    v_src_buf: i64,
    v_src_off: i64,
    kv_buf: i64,
    table_off: i64,
    k_layer_off: i64,
    v_layer_off: i64,
    n_kv_dim: i64,
    pos_start: i64,
    n_toks: i64,
    block_size: i64
) -> i64 {
    if !s.ok || cid <= 0 || pipe <= 0 || n_kv_dim <= 0 || n_toks <= 0 || pos_start < 0 || block_size <= 0 { return -1 }
    let packed = (n_toks << 32) | (pos_start & 4294967295)
    if metal_cmd_set_buf(s, cid, 0, k_src_buf, 0) != 0
        || metal_cmd_set_u64(s, cid, 1, k_src_off) != 0
        || metal_cmd_set_buf(s, cid, 2, v_src_buf, 0) != 0
        || metal_cmd_set_u64(s, cid, 3, v_src_off) != 0
        || metal_cmd_set_buf(s, cid, 4, kv_buf, 0) != 0
        || metal_cmd_set_u64(s, cid, 5, table_off) != 0
        || metal_cmd_set_u64(s, cid, 6, k_layer_off) != 0
        || metal_cmd_set_u64(s, cid, 7, v_layer_off) != 0
        || metal_cmd_set_u64(s, cid, 8, n_kv_dim) != 0
        || metal_cmd_set_u64(s, cid, 9, packed) != 0
        || metal_cmd_set_u64(s, cid, 10, block_size) != 0 {
        return -1
    }
    let total_threads = n_toks * n_kv_dim
    let group_threads = if total_threads < 64 { total_threads } else { 64 }
    if metal_cmd_dispatch_1d(s, cid, pipe, total_threads, group_threads) != 0 {
        return -1
    }
    0
}

pub fn qwen3_metal_encode_paged_gqa_batch(
    s: &MetalSession,
    cid: i64,
    pipe: i64,
    q_buf: i64,
    q_byte_off: i64,
    kv_buf: i64,
    table_byte_off: i64,
    k_layer_byte_off: i64,
    v_layer_byte_off: i64,
    out_buf: i64,
    out_byte_off: i64,
    n_q: i64,
    n_kv: i64,
    head_dim: i64,
    pos_start: i64,
    n_toks: i64,
    block_size: i64
) -> i64 {
    if !s.ok || cid <= 0 || pipe <= 0 || n_q <= 0 || n_kv <= 0 || head_dim <= 0 || n_toks <= 0 || pos_start < 0 || block_size <= 0 { return -1 }
    let packed = (n_toks << 32) | (pos_start & 4294967295)
    if metal_cmd_set_buf(s, cid, 0, q_buf, 0) != 0
        || metal_cmd_set_u64(s, cid, 1, q_byte_off) != 0
        || metal_cmd_set_buf(s, cid, 2, kv_buf, 0) != 0
        || metal_cmd_set_u64(s, cid, 3, table_byte_off) != 0
        || metal_cmd_set_u64(s, cid, 4, k_layer_byte_off) != 0
        || metal_cmd_set_u64(s, cid, 5, v_layer_byte_off) != 0
        || metal_cmd_set_buf(s, cid, 6, out_buf, 0) != 0
        || metal_cmd_set_u64(s, cid, 7, out_byte_off) != 0
        || metal_cmd_set_u64(s, cid, 8, n_q) != 0
        || metal_cmd_set_u64(s, cid, 9, n_kv) != 0
        || metal_cmd_set_u64(s, cid, 10, head_dim) != 0
        || metal_cmd_set_u64(s, cid, 11, packed) != 0
        || metal_cmd_set_u64(s, cid, 12, block_size) != 0 {
        return -1
    }
    let total_threads = n_toks * n_q * 32
    let group_threads = if total_threads < 128 { 32 } else { 128 }
    if metal_cmd_dispatch_1d(s, cid, pipe, total_threads, group_threads) != 0 {
        return -1
    }
    0
}

