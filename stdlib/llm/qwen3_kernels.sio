    p = bf16_cstr_append(buf, p, "    constant ulong& x_off [[buffer(6)]], constant ulong& out_off [[buffer(7)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& inter_dim [[buffer(8)]], constant ulong& in_dim [[buffer(9)]],\n")
    p = bf16_cstr_append(buf, p, "    uint gid [[thread_position_in_grid]], uint tid [[thread_index_in_threadgroup]]) {\n")
    p = bf16_cstr_append(buf, p, "    threadgroup float4 tg_x4[288];\n")
    p = bf16_cstr_append(buf, p, "    threadgroup float* tg_x = (threadgroup float*)tg_x4;\n")
    p = bf16_cstr_append(buf, p, "    ulong n_groups = (inter_dim + 15) / 16; ulong g = (ulong)gid >> 8;\n")
    p = bf16_cstr_append(buf, p, "    if (g >= n_groups) return;\n")
    p = bf16_cstr_append(buf, p, "    ulong sg = (ulong)tid >> 5; ulong lane = (ulong)tid & 31ul;\n")
