    p = bf16_cstr_append(buf, p, "            if (has0) a0 = fma(as_type<float>(((uint)c0[kt]) << 16), xt, a0);\n")
    p = bf16_cstr_append(buf, p, "            if (has1) b0 = fma(as_type<float>(((uint)c1[kt]) << 16), xt, b0);\n")
    p = bf16_cstr_append(buf, p, "            if (has2) d0 = fma(as_type<float>(((uint)c2[kt]) << 16), xt, d0);\n")
    p = bf16_cstr_append(buf, p, "            if (has3) e0 = fma(as_type<float>(((uint)c3[kt]) << 16), xt, e0);\n")
    p = bf16_cstr_append(buf, p, "        }\n")
    p = bf16_cstr_append(buf, p, "        threadgroup_barrier(mem_flags::mem_threadgroup);\n")
    p = bf16_cstr_append(buf, p, "    }\n")
    p = bf16_cstr_append(buf, p, "    if (has0) { float s0 = sounio_warp_sum_f32((a0 + a1) + (a2 + a3)); if (lane == 0) dst0[lr0] = s0; }\n")
    p = bf16_cstr_append(buf, p, "    if (has1) { float s1 = sounio_warp_sum_f32((b0 + b1) + (b2 + b3)); if (lane == 0) dst1[lr1] = s1; }\n")
    p = bf16_cstr_append(buf, p, "    if (has2) { float s2 = sounio_warp_sum_f32((d0 + d1) + (d2 + d3)); if (lane == 0) dst2[lr2] = s2; }\n")
    p = bf16_cstr_append(buf, p, "    if (has3) { float s3 = sounio_warp_sum_f32((e0 + e1) + (e2 + e3)); if (lane == 0) dst3[lr3] = s3; }\n}\n\n")

    // 22. qwen3_gemv_bf16_gate_up_swiglu (F3-BF16: swizzled tg_x4[288] + 4-acc FMA + sounio_exp_f32)
    p = bf16_cstr_append(buf, p, "kernel void qwen3_gemv_bf16_gate_up_swiglu(\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* wg_base [[buffer(0)]], device const uchar* wu_base [[buffer(1)]],\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* x_base [[buffer(2)]], device uchar* out_base [[buffer(3)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& wg_off [[buffer(4)]], constant ulong& wu_off [[buffer(5)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& x_off [[buffer(6)]], constant ulong& out_off [[buffer(7)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& inter_dim [[buffer(8)]], constant ulong& in_dim [[buffer(9)]],\n")
    p = bf16_cstr_append(buf, p, "    uint gid [[thread_position_in_grid]], uint tid [[thread_index_in_threadgroup]]) {\n")
    p = bf16_cstr_append(buf, p, "    threadgroup float4 tg_x4[288];\n")
    p = bf16_cstr_append(buf, p, "    threadgroup float* tg_x = (threadgroup float*)tg_x4;\n")
    p = bf16_cstr_append(buf, p, "    ulong n_groups = (inter_dim + 15) / 16; ulong g = (ulong)gid >> 8;\n")
    p = bf16_cstr_append(buf, p, "    if (g >= n_groups) return;\n")
    p = bf16_cstr_append(buf, p, "    ulong sg = (ulong)tid >> 5; ulong lane = (ulong)tid & 31ul;\n")
    p = bf16_cstr_append(buf, p, "    ulong r0 = g * 16ul + sg; ulong r1 = r0 + 8ul;\n")
    p = bf16_cstr_append(buf, p, "    bool has0 = (r0 < inter_dim); bool has1 = (r1 < inter_dim);\n")
