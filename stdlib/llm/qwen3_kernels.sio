// stdlib::llm::qwen3_kernels — High-performance GPU kernels for Qwen3 model family.
// Implements Metal (Apple Silicon Unified Memory) and PTX (CUDA Driver API)
// for QK-RMSNorm, RoPE, BF16/F32 GEMV, SwiGLU, and Paged GQA.

use llm::bf16_kernels::{bf16_cstr_append}
use llm::ptx_kernels_sm80::{emit_qwen3_ptx_sm80_cstr}
use llm::hal::{
    MetalSession,
    metal_compile_msl_ptr,
    metal_cmd_begin,
    metal_cmd_cancel,
    metal_cmd_set_buf,
    metal_cmd_set_u64,
    metal_cmd_dispatch_1d,
    metal_cmd_commit_sync,
    CudaDriverSession,
    cuda_launch_6param_1d,
    cuda_launch_8param_1d,
}

pub struct Qwen3MetalPipelines {
    pub rmsnorm_bf16: i64,
    pub rmsnorm_f32: i64,
    pub rope: i64,
    pub gemv_bf16: i64,
    pub gemv_f32: i64,
    pub swiglu: i64,
    pub paged_gqa: i64,
    pub vec_add: i64,
    pub kv_scatter: i64,
    pub argmax_top2: i64,
    pub gemm_bf16: i64,
    pub gemm_f32: i64,
    pub rope_batch: i64,
    pub kv_scatter_batch: i64,
    pub paged_gqa_batch: i64,
    pub argmax_top2_batch: i64,
    pub qk_norm_rope_kv_bf16: i64,
    pub qk_norm_rope_kv_f32: i64,
    pub add_rmsnorm_bf16: i64,
    pub add_rmsnorm_f32: i64,
    pub gemv_bf16_qkv: i64,
    pub gemv_bf16_gate_up_swiglu: i64,
    pub ok: bool,
}

pub fn qwen3_metal_pipelines_empty() -> Qwen3MetalPipelines {
    Qwen3MetalPipelines {
        rmsnorm_bf16: 0,
        rmsnorm_f32: 0,
        rope: 0,
        gemv_bf16: 0,
        gemv_f32: 0,
        swiglu: 0,
        paged_gqa: 0,
        vec_add: 0,
        kv_scatter: 0,
        argmax_top2: 0,
        gemm_bf16: 0,
        gemm_f32: 0,
        rope_batch: 0,
        kv_scatter_batch: 0,
        paged_gqa_batch: 0,
        argmax_top2_batch: 0,
        qk_norm_rope_kv_bf16: 0,
        qk_norm_rope_kv_f32: 0,
        add_rmsnorm_bf16: 0,
        add_rmsnorm_f32: 0,
        gemv_bf16_qkv: 0,
        gemv_bf16_gate_up_swiglu: 0,
        ok: false,
    }
}

pub fn emit_qwen3_kernels_msl_cstr() -> i64 with Alloc, Mut {
    let buf = heap_alloc(262144) as i64
    if buf == 0 { return 0 }
    var p: i64 = 0
    p = bf16_cstr_append(buf, p, "#include <metal_stdlib>\nusing namespace metal;\n\n")

    // 1. qwen3_rmsnorm_bf16
    p = bf16_cstr_append(buf, p, "kernel void qwen3_rmsnorm_bf16(\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* x_base [[buffer(0)]], constant ulong& x_off [[buffer(1)]],\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* w_base [[buffer(2)]], constant ulong& w_off [[buffer(3)]],\n")
    p = bf16_cstr_append(buf, p, "    device uchar* out_base [[buffer(4)]], constant ulong& out_off [[buffer(5)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& n_groups [[buffer(6)]], constant ulong& dim [[buffer(7)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& eps_bits [[buffer(8)]], uint gid [[thread_position_in_grid]], uint lane [[thread_index_in_simdgroup]]) {\n")
    p = bf16_cstr_append(buf, p, "    ulong g = (ulong)gid >> 5;\n")
    p = bf16_cstr_append(buf, p, "    if (g >= n_groups) return;\n")
    p = bf16_cstr_append(buf, p, "    device const float* x = (device const float*)(x_base + x_off) + g * dim;\n")
    p = bf16_cstr_append(buf, p, "    device const ushort* w = (device const ushort*)(w_base + w_off);\n")
    p = bf16_cstr_append(buf, p, "    device float* out = (device float*)(out_base + out_off) + g * dim;\n")
    p = bf16_cstr_append(buf, p, "    float eps = as_type<float>((uint)eps_bits);\n")
    p = bf16_cstr_append(buf, p, "    float sum_sq = 0.0f;\n")
    p = bf16_cstr_append(buf, p, "    for (ulong i = lane; i < dim; i = i + 32) { float v = x[i]; sum_sq = fma(v, v, sum_sq); }\n")
    p = bf16_cstr_append(buf, p, "    sum_sq = simd_sum(sum_sq);\n")
    p = bf16_cstr_append(buf, p, "    float inv_rms = rsqrt(sum_sq / float(dim) + eps);\n")
    p = bf16_cstr_append(buf, p, "    for (ulong i = lane; i < dim; i = i + 32) {\n")
    p = bf16_cstr_append(buf, p, "        float weight = as_type<float>(((uint)w[i]) << 16);\n")
    p = bf16_cstr_append(buf, p, "        out[i] = x[i] * inv_rms * weight;\n")
    p = bf16_cstr_append(buf, p, "    }\n}\n\n")

    // 2. qwen3_rmsnorm_f32
    p = bf16_cstr_append(buf, p, "kernel void qwen3_rmsnorm_f32(\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* x_base [[buffer(0)]], constant ulong& x_off [[buffer(1)]],\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* w_base [[buffer(2)]], constant ulong& w_off [[buffer(3)]],\n")
    p = bf16_cstr_append(buf, p, "    device uchar* out_base [[buffer(4)]], constant ulong& out_off [[buffer(5)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& n_groups [[buffer(6)]], constant ulong& dim [[buffer(7)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& eps_bits [[buffer(8)]], uint gid [[thread_position_in_grid]], uint lane [[thread_index_in_simdgroup]]) {\n")
    p = bf16_cstr_append(buf, p, "    ulong g = (ulong)gid >> 5;\n")
    p = bf16_cstr_append(buf, p, "    if (g >= n_groups) return;\n")
    p = bf16_cstr_append(buf, p, "    device const float* x = (device const float*)(x_base + x_off) + g * dim;\n")
    p = bf16_cstr_append(buf, p, "    device const float* w = (device const float*)(w_base + w_off);\n")
    p = bf16_cstr_append(buf, p, "    device float* out = (device float*)(out_base + out_off) + g * dim;\n")
    p = bf16_cstr_append(buf, p, "    float eps = as_type<float>((uint)eps_bits);\n")
    p = bf16_cstr_append(buf, p, "    float sum_sq = 0.0f;\n")
    p = bf16_cstr_append(buf, p, "    for (ulong i = lane; i < dim; i = i + 32) { float v = x[i]; sum_sq = fma(v, v, sum_sq); }\n")
    p = bf16_cstr_append(buf, p, "    sum_sq = simd_sum(sum_sq);\n")
    p = bf16_cstr_append(buf, p, "    float inv_rms = rsqrt(sum_sq / float(dim) + eps);\n")
    p = bf16_cstr_append(buf, p, "    for (ulong i = lane; i < dim; i = i + 32) {\n")
    p = bf16_cstr_append(buf, p, "        float weight = w[i];\n")
    p = bf16_cstr_append(buf, p, "        out[i] = x[i] * inv_rms * weight;\n")
    p = bf16_cstr_append(buf, p, "    }\n}\n\n")

    // 3. qwen3_rope_f32
    p = bf16_cstr_append(buf, p, "kernel void qwen3_rope_f32(\n")
    p = bf16_cstr_append(buf, p, "    device uchar* v_base [[buffer(0)]], constant ulong& v_off [[buffer(1)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& n_heads [[buffer(2)]], constant ulong& head_dim [[buffer(3)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& pos [[buffer(4)]], constant ulong& theta_bits [[buffer(5)]],\n")
    p = bf16_cstr_append(buf, p, "    uint gid [[thread_position_in_grid]]) {\n")
    p = bf16_cstr_append(buf, p, "    ulong hdim = head_dim / 2;\n")
    p = bf16_cstr_append(buf, p, "    if (hdim == 0 || (ulong)gid >= n_heads * hdim) return;\n")
    p = bf16_cstr_append(buf, p, "    ulong h = (ulong)gid / hdim;\n")
    p = bf16_cstr_append(buf, p, "    ulong j = (ulong)gid % hdim;\n")
    p = bf16_cstr_append(buf, p, "    float theta = as_type<float>((uint)theta_bits);\n")
    p = bf16_cstr_append(buf, p, "    float freq = pow(theta, -float(2 * j) / float(head_dim));\n")
    p = bf16_cstr_append(buf, p, "    float angle = float(pos) * freq;\n")
    p = bf16_cstr_append(buf, p, "    float cos_a = cos(angle);\n")
    p = bf16_cstr_append(buf, p, "    float sin_a = sin(angle);\n")
    p = bf16_cstr_append(buf, p, "    device float* head_ptr = (device float*)(v_base + v_off) + h * head_dim;\n")
    p = bf16_cstr_append(buf, p, "    float x0 = head_ptr[j];\n")
    p = bf16_cstr_append(buf, p, "    float x1 = head_ptr[j + hdim];\n")
    p = bf16_cstr_append(buf, p, "    head_ptr[j] = x0 * cos_a - x1 * sin_a;\n")
    p = bf16_cstr_append(buf, p, "    head_ptr[j + hdim] = x1 * cos_a + x0 * sin_a;\n}\n\n")

    // Inline BF16 and F32 dot-product helpers (threadgroup-staged + device float4)
    p = bf16_cstr_append(buf, p, "inline float qwen3_bf16_row_dot_tg(device const ushort* row_w, threadgroup const float* tg_x, ulong in_dim, ulong lane) {\n")
    p = bf16_cstr_append(buf, p, "    float sum = 0.0f;\n")
    p = bf16_cstr_append(buf, p, "    if ((((ulong)row_w) & 7ul) == 0) {\n")
    p = bf16_cstr_append(buf, p, "        for (ulong k = (ulong)lane * 4; k + 3 < in_dim; k = k + 128) {\n")
    p = bf16_cstr_append(buf, p, "            ulong w4 = *((device const ulong*)(row_w + k));\n")
    p = bf16_cstr_append(buf, p, "            uint w_lo = (uint)w4; uint w_hi = (uint)(w4 >> 32);\n")
    p = bf16_cstr_append(buf, p, "            sum = fma(as_type<float>(w_lo << 16), tg_x[k + 0], sum);\n")
    p = bf16_cstr_append(buf, p, "            sum = fma(as_type<float>(w_lo & 0xFFFF0000u), tg_x[k + 1], sum);\n")
    p = bf16_cstr_append(buf, p, "            sum = fma(as_type<float>(w_hi << 16), tg_x[k + 2], sum);\n")
    p = bf16_cstr_append(buf, p, "            sum = fma(as_type<float>(w_hi & 0xFFFF0000u), tg_x[k + 3], sum);\n")
    p = bf16_cstr_append(buf, p, "        }\n    } else {\n")
    p = bf16_cstr_append(buf, p, "        for (ulong k = (ulong)lane * 4; k + 3 < in_dim; k = k + 128) {\n")
    p = bf16_cstr_append(buf, p, "            sum = fma(as_type<float>(((uint)row_w[k + 0]) << 16), tg_x[k + 0], sum);\n")
    p = bf16_cstr_append(buf, p, "            sum = fma(as_type<float>(((uint)row_w[k + 1]) << 16), tg_x[k + 1], sum);\n")
    p = bf16_cstr_append(buf, p, "            sum = fma(as_type<float>(((uint)row_w[k + 2]) << 16), tg_x[k + 2], sum);\n")
    p = bf16_cstr_append(buf, p, "            sum = fma(as_type<float>(((uint)row_w[k + 3]) << 16), tg_x[k + 3], sum);\n")
    p = bf16_cstr_append(buf, p, "        }\n    }\n")
    p = bf16_cstr_append(buf, p, "    for (ulong k_tail = (in_dim & ~3ULL) + (ulong)lane; k_tail < in_dim; k_tail = k_tail + 32) {\n")
    p = bf16_cstr_append(buf, p, "        sum = fma(as_type<float>(((uint)row_w[k_tail]) << 16), tg_x[k_tail], sum);\n")
    p = bf16_cstr_append(buf, p, "    }\n    return simd_sum(sum);\n}\n\n")

    p = bf16_cstr_append(buf, p, "inline float qwen3_bf16_row_dot_dev(device const ushort* row_w, device const float* in_x, ulong in_dim, ulong lane) {\n")
    p = bf16_cstr_append(buf, p, "    float sum = 0.0f;\n")
    p = bf16_cstr_append(buf, p, "    if ((((ulong)row_w) & 7ul) == 0 && (((ulong)in_x) & 15ul) == 0) {\n")
    p = bf16_cstr_append(buf, p, "        for (ulong k = (ulong)lane * 4; k + 3 < in_dim; k = k + 128) {\n")
    p = bf16_cstr_append(buf, p, "            ulong w4 = *((device const ulong*)(row_w + k));\n")
    p = bf16_cstr_append(buf, p, "            float4 x4 = *((device const float4*)(in_x + k));\n")
    p = bf16_cstr_append(buf, p, "            uint w_lo = (uint)w4; uint w_hi = (uint)(w4 >> 32);\n")
    p = bf16_cstr_append(buf, p, "            sum = fma(as_type<float>(w_lo << 16), x4.x, sum);\n")
    p = bf16_cstr_append(buf, p, "            sum = fma(as_type<float>(w_lo & 0xFFFF0000u), x4.y, sum);\n")
    p = bf16_cstr_append(buf, p, "            sum = fma(as_type<float>(w_hi << 16), x4.z, sum);\n")
    p = bf16_cstr_append(buf, p, "            sum = fma(as_type<float>(w_hi & 0xFFFF0000u), x4.w, sum);\n")
    p = bf16_cstr_append(buf, p, "        }\n    } else if ((((ulong)row_w) & 7ul) == 0) {\n")
    p = bf16_cstr_append(buf, p, "        for (ulong k = (ulong)lane * 4; k + 3 < in_dim; k = k + 128) {\n")
    p = bf16_cstr_append(buf, p, "            ulong w4 = *((device const ulong*)(row_w + k));\n")
    p = bf16_cstr_append(buf, p, "            uint w_lo = (uint)w4; uint w_hi = (uint)(w4 >> 32);\n")
    p = bf16_cstr_append(buf, p, "            sum = fma(as_type<float>(w_lo << 16), in_x[k + 0], sum);\n")
    p = bf16_cstr_append(buf, p, "            sum = fma(as_type<float>(w_lo & 0xFFFF0000u), in_x[k + 1], sum);\n")
    p = bf16_cstr_append(buf, p, "            sum = fma(as_type<float>(w_hi << 16), in_x[k + 2], sum);\n")
    p = bf16_cstr_append(buf, p, "            sum = fma(as_type<float>(w_hi & 0xFFFF0000u), in_x[k + 3], sum);\n")
    p = bf16_cstr_append(buf, p, "        }\n    } else {\n")
    p = bf16_cstr_append(buf, p, "        for (ulong k = (ulong)lane * 4; k + 3 < in_dim; k = k + 128) {\n")
    p = bf16_cstr_append(buf, p, "            sum = fma(as_type<float>(((uint)row_w[k + 0]) << 16), in_x[k + 0], sum);\n")
    p = bf16_cstr_append(buf, p, "            sum = fma(as_type<float>(((uint)row_w[k + 1]) << 16), in_x[k + 1], sum);\n")
    p = bf16_cstr_append(buf, p, "            sum = fma(as_type<float>(((uint)row_w[k + 2]) << 16), in_x[k + 2], sum);\n")
    p = bf16_cstr_append(buf, p, "            sum = fma(as_type<float>(((uint)row_w[k + 3]) << 16), in_x[k + 3], sum);\n")
    p = bf16_cstr_append(buf, p, "        }\n    }\n")
    p = bf16_cstr_append(buf, p, "    for (ulong k_tail = (in_dim & ~3ULL) + (ulong)lane; k_tail < in_dim; k_tail = k_tail + 32) {\n")
    p = bf16_cstr_append(buf, p, "        sum = fma(as_type<float>(((uint)row_w[k_tail]) << 16), in_x[k_tail], sum);\n")
    p = bf16_cstr_append(buf, p, "    }\n    return simd_sum(sum);\n}\n\n")

    p = bf16_cstr_append(buf, p, "inline float qwen3_f32_row_dot_tg(device const float* row_w, threadgroup const float* tg_x, ulong in_dim, ulong lane) {\n")
    p = bf16_cstr_append(buf, p, "    float sum = 0.0f;\n")
    p = bf16_cstr_append(buf, p, "    for (ulong k = (ulong)lane * 4; k + 3 < in_dim; k = k + 128) {\n")
    p = bf16_cstr_append(buf, p, "        sum = fma(row_w[k + 0], tg_x[k + 0], sum);\n")
    p = bf16_cstr_append(buf, p, "        sum = fma(row_w[k + 1], tg_x[k + 1], sum);\n")
    p = bf16_cstr_append(buf, p, "        sum = fma(row_w[k + 2], tg_x[k + 2], sum);\n")
    p = bf16_cstr_append(buf, p, "        sum = fma(row_w[k + 3], tg_x[k + 3], sum);\n")
    p = bf16_cstr_append(buf, p, "    }\n")
    p = bf16_cstr_append(buf, p, "    for (ulong k_tail = (in_dim & ~3ULL) + (ulong)lane; k_tail < in_dim; k_tail = k_tail + 32) {\n")
    p = bf16_cstr_append(buf, p, "        sum = fma(row_w[k_tail], tg_x[k_tail], sum);\n")
    p = bf16_cstr_append(buf, p, "    }\n    return simd_sum(sum);\n}\n\n")

    p = bf16_cstr_append(buf, p, "inline float qwen3_f32_row_dot_dev(device const float* row_w, device const float* in_x, ulong in_dim, ulong lane) {\n")
    p = bf16_cstr_append(buf, p, "    float sum = 0.0f;\n")
    p = bf16_cstr_append(buf, p, "    for (ulong k = (ulong)lane * 4; k + 3 < in_dim; k = k + 128) {\n")
    p = bf16_cstr_append(buf, p, "        sum = fma(row_w[k + 0], in_x[k + 0], sum);\n")
    p = bf16_cstr_append(buf, p, "        sum = fma(row_w[k + 1], in_x[k + 1], sum);\n")
    p = bf16_cstr_append(buf, p, "        sum = fma(row_w[k + 2], in_x[k + 2], sum);\n")
    p = bf16_cstr_append(buf, p, "        sum = fma(row_w[k + 3], in_x[k + 3], sum);\n")
    p = bf16_cstr_append(buf, p, "    }\n")
    p = bf16_cstr_append(buf, p, "    for (ulong k_tail = (in_dim & ~3ULL) + (ulong)lane; k_tail < in_dim; k_tail = k_tail + 32) {\n")
    p = bf16_cstr_append(buf, p, "        sum = fma(row_w[k_tail], in_x[k_tail], sum);\n")
    p = bf16_cstr_append(buf, p, "    }\n    return simd_sum(sum);\n}\n\n")

    p = bf16_cstr_append(buf, p, "inline float qwen3_bf16_dot4(device const ushort* c, ulong k, float4 x4, bool al) {\n")
    p = bf16_cstr_append(buf, p, "    float w0; float w1; float w2; float w3;\n")
    p = bf16_cstr_append(buf, p, "    if (al) {\n")
    p = bf16_cstr_append(buf, p, "        ulong w4 = *((device const ulong*)(c + k));\n")
    p = bf16_cstr_append(buf, p, "        uint wl = (uint)w4; uint wh = (uint)(w4 >> 32);\n")
    p = bf16_cstr_append(buf, p, "        w0 = as_type<float>(wl << 16); w1 = as_type<float>(wl & 0xFFFF0000u);\n")
    p = bf16_cstr_append(buf, p, "        w2 = as_type<float>(wh << 16); w3 = as_type<float>(wh & 0xFFFF0000u);\n")
    p = bf16_cstr_append(buf, p, "    } else {\n")
    p = bf16_cstr_append(buf, p, "        w0 = as_type<float>(((uint)c[k+0]) << 16); w1 = as_type<float>(((uint)c[k+1]) << 16);\n")
    p = bf16_cstr_append(buf, p, "        w2 = as_type<float>(((uint)c[k+2]) << 16); w3 = as_type<float>(((uint)c[k+3]) << 16);\n")
    p = bf16_cstr_append(buf, p, "    }\n")
    p = bf16_cstr_append(buf, p, "    return fma(w0, x4.x, w1 * x4.y) + fma(w2, x4.z, w3 * x4.w);\n")
    p = bf16_cstr_append(buf, p, "}\n\n")

    p = bf16_cstr_append(buf, p, "inline float qwen3_f32_dot4(device const float* c, ulong k, float4 x4) {\n")
    p = bf16_cstr_append(buf, p, "    return fma(c[k+0], x4.x, c[k+1] * x4.y) + fma(c[k+2], x4.z, c[k+3] * x4.w);\n")
    p = bf16_cstr_append(buf, p, "}\n\n")

    // 4. qwen3_gemv_bf16 (K-chunked swizzled tg_x4[288] + 4-row/SIMD register reuse + 1-add tree)
    p = bf16_cstr_append(buf, p, "kernel void qwen3_gemv_bf16(\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* w_base [[buffer(0)]], constant ulong& w_off [[buffer(1)]],\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* x_base [[buffer(2)]], constant ulong& x_off [[buffer(3)]],\n")
    p = bf16_cstr_append(buf, p, "    device uchar* y_base [[buffer(4)]], constant ulong& y_off [[buffer(5)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& out_dim [[buffer(6)]], constant ulong& in_dim [[buffer(7)]],\n")
    p = bf16_cstr_append(buf, p, "    uint gid [[thread_position_in_grid]], uint tid [[thread_index_in_threadgroup]]) {\n")
    p = bf16_cstr_append(buf, p, "    threadgroup float4 tg_x4[288];\n")
    p = bf16_cstr_append(buf, p, "    threadgroup float* tg_x = (threadgroup float*)tg_x4;\n")
    p = bf16_cstr_append(buf, p, "    ulong n_groups = (out_dim + 31) / 32; ulong g = (ulong)gid >> 8;\n")
    p = bf16_cstr_append(buf, p, "    if (g >= n_groups) return;\n")
    p = bf16_cstr_append(buf, p, "    ulong sg = (ulong)tid >> 5; ulong lane = (ulong)tid & 31ul;\n")
    p = bf16_cstr_append(buf, p, "    ulong r0 = g * 32ul + sg; ulong r1 = r0 + 8ul; ulong r2 = r0 + 16ul; ulong r3 = r0 + 24ul;\n")
    p = bf16_cstr_append(buf, p, "    bool has0 = (r0 < out_dim); bool has1 = (r1 < out_dim); bool has2 = (r2 < out_dim); bool has3 = (r3 < out_dim);\n")
    p = bf16_cstr_append(buf, p, "    device const float* in_x = (device const float*)(x_base + x_off);\n")
    p = bf16_cstr_append(buf, p, "    device float* out_y = (device float*)(y_base + y_off);\n")
    p = bf16_cstr_append(buf, p, "    device const ushort* rw0 = has0 ? ((device const ushort*)(w_base + w_off) + r0 * in_dim) : (device const ushort*)w_base;\n")
    p = bf16_cstr_append(buf, p, "    device const ushort* rw1 = has1 ? ((device const ushort*)(w_base + w_off) + r1 * in_dim) : (device const ushort*)w_base;\n")
    p = bf16_cstr_append(buf, p, "    device const ushort* rw2 = has2 ? ((device const ushort*)(w_base + w_off) + r2 * in_dim) : (device const ushort*)w_base;\n")
    p = bf16_cstr_append(buf, p, "    device const ushort* rw3 = has3 ? ((device const ushort*)(w_base + w_off) + r3 * in_dim) : (device const ushort*)w_base;\n")
    p = bf16_cstr_append(buf, p, "    float acc0 = 0.0f; float acc1 = 0.0f; float acc2 = 0.0f; float acc3 = 0.0f;\n")
    p = bf16_cstr_append(buf, p, "    for (ulong k_base = 0; k_base < in_dim; k_base = k_base + 1024ul) {\n")
    p = bf16_cstr_append(buf, p, "        ulong chunk_k = min(1024ul, in_dim - k_base);\n")
    p = bf16_cstr_append(buf, p, "        for (ulong k = (ulong)tid; k < chunk_k; k = k + 256ul) { tg_x[k + ((k >> 5) << 2)] = in_x[k_base + k]; }\n")
    p = bf16_cstr_append(buf, p, "        threadgroup_barrier(mem_flags::mem_threadgroup);\n")
    p = bf16_cstr_append(buf, p, "        device const ushort* c0 = rw0 + k_base; device const ushort* c1 = rw1 + k_base;\n")
    p = bf16_cstr_append(buf, p, "        device const ushort* c2 = rw2 + k_base; device const ushort* c3 = rw3 + k_base;\n")
    p = bf16_cstr_append(buf, p, "        bool al0 = has0 && ((((ulong)c0) & 7ul) == 0); bool al1 = has1 && ((((ulong)c1) & 7ul) == 0);\n")
    p = bf16_cstr_append(buf, p, "        bool al2 = has2 && ((((ulong)c2) & 7ul) == 0); bool al3 = has3 && ((((ulong)c3) & 7ul) == 0);\n")
    p = bf16_cstr_append(buf, p, "        for (ulong k = (ulong)lane * 4ul; k + 3ul < chunk_k; k = k + 128ul) {\n")
    p = bf16_cstr_append(buf, p, "            ulong u = k >> 2; float4 x4 = tg_x4[u + (u >> 3)];\n")
    p = bf16_cstr_append(buf, p, "            if (has0) acc0 = acc0 + qwen3_bf16_dot4(c0, k, x4, al0);\n")
    p = bf16_cstr_append(buf, p, "            if (has1) acc1 = acc1 + qwen3_bf16_dot4(c1, k, x4, al1);\n")
    p = bf16_cstr_append(buf, p, "            if (has2) acc2 = acc2 + qwen3_bf16_dot4(c2, k, x4, al2);\n")
    p = bf16_cstr_append(buf, p, "            if (has3) acc3 = acc3 + qwen3_bf16_dot4(c3, k, x4, al3);\n")
    p = bf16_cstr_append(buf, p, "        }\n")
    p = bf16_cstr_append(buf, p, "        for (ulong kt = (chunk_k & ~3ULL) + (ulong)lane; kt < chunk_k; kt = kt + 32ul) {\n")
    p = bf16_cstr_append(buf, p, "            float xt = tg_x[kt + ((kt >> 5) << 2)];\n")
    p = bf16_cstr_append(buf, p, "            if (has0) acc0 = fma(as_type<float>(((uint)c0[kt]) << 16), xt, acc0);\n")
    p = bf16_cstr_append(buf, p, "            if (has1) acc1 = fma(as_type<float>(((uint)c1[kt]) << 16), xt, acc1);\n")
    p = bf16_cstr_append(buf, p, "            if (has2) acc2 = fma(as_type<float>(((uint)c2[kt]) << 16), xt, acc2);\n")
    p = bf16_cstr_append(buf, p, "            if (has3) acc3 = fma(as_type<float>(((uint)c3[kt]) << 16), xt, acc3);\n")
    p = bf16_cstr_append(buf, p, "        }\n")
    p = bf16_cstr_append(buf, p, "        threadgroup_barrier(mem_flags::mem_threadgroup);\n")
    p = bf16_cstr_append(buf, p, "    }\n")
    p = bf16_cstr_append(buf, p, "    if (has0) { float s0 = simd_sum(acc0); if (lane == 0) out_y[r0] = s0; }\n")
    p = bf16_cstr_append(buf, p, "    if (has1) { float s1 = simd_sum(acc1); if (lane == 0) out_y[r1] = s1; }\n")
    p = bf16_cstr_append(buf, p, "    if (has2) { float s2 = simd_sum(acc2); if (lane == 0) out_y[r2] = s2; }\n")
    p = bf16_cstr_append(buf, p, "    if (has3) { float s3 = simd_sum(acc3); if (lane == 0) out_y[r3] = s3; }\n}\n\n")

    // 5. qwen3_gemv_f32 (K-chunked swizzled tg_x4[288] + 4-row/SIMD register reuse + 1-add tree)
    p = bf16_cstr_append(buf, p, "kernel void qwen3_gemv_f32(\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* w_base [[buffer(0)]], constant ulong& w_off [[buffer(1)]],\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* x_base [[buffer(2)]], constant ulong& x_off [[buffer(3)]],\n")
    p = bf16_cstr_append(buf, p, "    device uchar* y_base [[buffer(4)]], constant ulong& y_off [[buffer(5)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& out_dim [[buffer(6)]], constant ulong& in_dim [[buffer(7)]],\n")
    p = bf16_cstr_append(buf, p, "    uint gid [[thread_position_in_grid]], uint tid [[thread_index_in_threadgroup]]) {\n")
    p = bf16_cstr_append(buf, p, "    threadgroup float4 tg_x4[288];\n")
    p = bf16_cstr_append(buf, p, "    threadgroup float* tg_x = (threadgroup float*)tg_x4;\n")
    p = bf16_cstr_append(buf, p, "    ulong n_groups = (out_dim + 31) / 32; ulong g = (ulong)gid >> 8;\n")
    p = bf16_cstr_append(buf, p, "    if (g >= n_groups) return;\n")
    p = bf16_cstr_append(buf, p, "    ulong sg = (ulong)tid >> 5; ulong lane = (ulong)tid & 31ul;\n")
    p = bf16_cstr_append(buf, p, "    ulong r0 = g * 32ul + sg; ulong r1 = r0 + 8ul; ulong r2 = r0 + 16ul; ulong r3 = r0 + 24ul;\n")
    p = bf16_cstr_append(buf, p, "    bool has0 = (r0 < out_dim); bool has1 = (r1 < out_dim); bool has2 = (r2 < out_dim); bool has3 = (r3 < out_dim);\n")
    p = bf16_cstr_append(buf, p, "    device const float* in_x = (device const float*)(x_base + x_off);\n")
    p = bf16_cstr_append(buf, p, "    device float* out_y = (device float*)(y_base + y_off);\n")
    p = bf16_cstr_append(buf, p, "    device const float* rw0 = has0 ? ((device const float*)(w_base + w_off) + r0 * in_dim) : (device const float*)w_base;\n")
    p = bf16_cstr_append(buf, p, "    device const float* rw1 = has1 ? ((device const float*)(w_base + w_off) + r1 * in_dim) : (device const float*)w_base;\n")
    p = bf16_cstr_append(buf, p, "    device const float* rw2 = has2 ? ((device const float*)(w_base + w_off) + r2 * in_dim) : (device const float*)w_base;\n")
    p = bf16_cstr_append(buf, p, "    device const float* rw3 = has3 ? ((device const float*)(w_base + w_off) + r3 * in_dim) : (device const float*)w_base;\n")
    p = bf16_cstr_append(buf, p, "    float acc0 = 0.0f; float acc1 = 0.0f; float acc2 = 0.0f; float acc3 = 0.0f;\n")
    p = bf16_cstr_append(buf, p, "    for (ulong k_base = 0; k_base < in_dim; k_base = k_base + 1024ul) {\n")
    p = bf16_cstr_append(buf, p, "        ulong chunk_k = min(1024ul, in_dim - k_base);\n")
    p = bf16_cstr_append(buf, p, "        for (ulong k = (ulong)tid; k < chunk_k; k = k + 256ul) { tg_x[k + ((k >> 5) << 2)] = in_x[k_base + k]; }\n")
    p = bf16_cstr_append(buf, p, "        threadgroup_barrier(mem_flags::mem_threadgroup);\n")
    p = bf16_cstr_append(buf, p, "        device const float* c0 = rw0 + k_base; device const float* c1 = rw1 + k_base;\n")
    p = bf16_cstr_append(buf, p, "        device const float* c2 = rw2 + k_base; device const float* c3 = rw3 + k_base;\n")
    p = bf16_cstr_append(buf, p, "        for (ulong k = (ulong)lane * 4ul; k + 3ul < chunk_k; k = k + 128ul) {\n")
    p = bf16_cstr_append(buf, p, "            ulong u = k >> 2; float4 x4 = tg_x4[u + (u >> 3)];\n")
    p = bf16_cstr_append(buf, p, "            if (has0) acc0 = acc0 + qwen3_f32_dot4(c0, k, x4);\n")
    p = bf16_cstr_append(buf, p, "            if (has1) acc1 = acc1 + qwen3_f32_dot4(c1, k, x4);\n")
    p = bf16_cstr_append(buf, p, "            if (has2) acc2 = acc2 + qwen3_f32_dot4(c2, k, x4);\n")
    p = bf16_cstr_append(buf, p, "            if (has3) acc3 = acc3 + qwen3_f32_dot4(c3, k, x4);\n")
    p = bf16_cstr_append(buf, p, "        }\n")
    p = bf16_cstr_append(buf, p, "        for (ulong kt = (chunk_k & ~3ULL) + (ulong)lane; kt < chunk_k; kt = kt + 32ul) {\n")
    p = bf16_cstr_append(buf, p, "            float xt = tg_x[kt + ((kt >> 5) << 2)];\n")
    p = bf16_cstr_append(buf, p, "            if (has0) acc0 = fma(c0[kt], xt, acc0);\n")
    p = bf16_cstr_append(buf, p, "            if (has1) acc1 = fma(c1[kt], xt, acc1);\n")
    p = bf16_cstr_append(buf, p, "            if (has2) acc2 = fma(c2[kt], xt, acc2);\n")
    p = bf16_cstr_append(buf, p, "            if (has3) acc3 = fma(c3[kt], xt, acc3);\n")
    p = bf16_cstr_append(buf, p, "        }\n")
    p = bf16_cstr_append(buf, p, "        threadgroup_barrier(mem_flags::mem_threadgroup);\n")
    p = bf16_cstr_append(buf, p, "    }\n")
    p = bf16_cstr_append(buf, p, "    if (has0) { float s0 = simd_sum(acc0); if (lane == 0) out_y[r0] = s0; }\n")
    p = bf16_cstr_append(buf, p, "    if (has1) { float s1 = simd_sum(acc1); if (lane == 0) out_y[r1] = s1; }\n")
    p = bf16_cstr_append(buf, p, "    if (has2) { float s2 = simd_sum(acc2); if (lane == 0) out_y[r2] = s2; }\n")
    p = bf16_cstr_append(buf, p, "    if (has3) { float s3 = simd_sum(acc3); if (lane == 0) out_y[r3] = s3; }\n}\n\n")

    // 6. qwen3_swiglu_f32
    p = bf16_cstr_append(buf, p, "kernel void qwen3_swiglu_f32(\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* g_base [[buffer(0)]], constant ulong& g_off [[buffer(1)]],\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* u_base [[buffer(2)]], constant ulong& u_off [[buffer(3)]],\n")
    p = bf16_cstr_append(buf, p, "    device uchar* o_base [[buffer(4)]], constant ulong& o_off [[buffer(5)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& inter_dim [[buffer(6)]], uint gid [[thread_position_in_grid]]) {\n")
    p = bf16_cstr_append(buf, p, "    if ((ulong)gid >= inter_dim) return;\n")
    p = bf16_cstr_append(buf, p, "    device const float* g_ptr = (device const float*)(g_base + g_off);\n")
    p = bf16_cstr_append(buf, p, "    device const float* u_ptr = (device const float*)(u_base + u_off);\n")
    p = bf16_cstr_append(buf, p, "    device float* o_ptr = (device float*)(o_base + o_off);\n")
    p = bf16_cstr_append(buf, p, "    float g = g_ptr[gid];\n")
    p = bf16_cstr_append(buf, p, "    float u = u_ptr[gid];\n")
    p = bf16_cstr_append(buf, p, "    float silu_g = g / (1.0f + exp(-g));\n")
    p = bf16_cstr_append(buf, p, "    o_ptr[gid] = silu_g * u;\n}\n\n")

    // Inline 32-lane SIMD Paged GQA helper
    p = bf16_cstr_append(buf, p, "inline void qwen3_paged_gqa_head_simd(\n")
    p = bf16_cstr_append(buf, p, "    device const float* q_vec, device const uchar* kv_base, device const uint* table,\n")
    p = bf16_cstr_append(buf, p, "    ulong k_layer_off, ulong v_layer_off, device float* out_vec,\n")
    p = bf16_cstr_append(buf, p, "    ulong n_kv, ulong kv_h, ulong head_dim, ulong seq_len, ulong block_size, uint lane) {\n")
    p = bf16_cstr_append(buf, p, "    float scale = rsqrt(float(head_dim));\n")
    p = bf16_cstr_append(buf, p, "    uint n_chunks = (uint)((min(head_dim, 256ul) + 31ul) >> 5);\n")
    p = bf16_cstr_append(buf, p, "    float q_reg[8]; float acc_reg[8];\n")
    p = bf16_cstr_append(buf, p, "    for (uint c = 0; c < n_chunks; ++c) {\n")
    p = bf16_cstr_append(buf, p, "        ulong d = (ulong)lane + (ulong)(c << 5);\n")
    p = bf16_cstr_append(buf, p, "        q_reg[c] = (d < head_dim) ? q_vec[d] : 0.0f;\n")
    p = bf16_cstr_append(buf, p, "        acc_reg[c] = 0.0f;\n    }\n")
    p = bf16_cstr_append(buf, p, "    float max_s = -INFINITY; float l = 0.0f;\n")
    p = bf16_cstr_append(buf, p, "    for (ulong pos = 0; pos < seq_len; ++pos) {\n")
    p = bf16_cstr_append(buf, p, "        uint phys_blk = table[pos / block_size];\n")
    p = bf16_cstr_append(buf, p, "        if (phys_blk == 0xFFFFFFFFu) continue;\n")
    p = bf16_cstr_append(buf, p, "        ulong slot = pos % block_size;\n")
    p = bf16_cstr_append(buf, p, "        ulong kv_elem_idx = (((ulong)phys_blk * block_size + slot) * n_kv + kv_h) * head_dim;\n")
    p = bf16_cstr_append(buf, p, "        device const float* k_vec = (device const float*)(kv_base + k_layer_off) + kv_elem_idx;\n")
    p = bf16_cstr_append(buf, p, "        device const float* v_vec = (device const float*)(kv_base + v_layer_off) + kv_elem_idx;\n")
    p = bf16_cstr_append(buf, p, "        float part = 0.0f;\n")
    p = bf16_cstr_append(buf, p, "        for (uint c = 0; c < n_chunks; ++c) {\n")
    p = bf16_cstr_append(buf, p, "            ulong d = (ulong)lane + (ulong)(c << 5);\n")
    p = bf16_cstr_append(buf, p, "            if (d < head_dim) part = fma(q_reg[c], k_vec[d], part);\n        }\n")
    p = bf16_cstr_append(buf, p, "        float s = simd_sum(part) * scale;\n")
    p = bf16_cstr_append(buf, p, "        if (l == 0.0f) {\n")
    p = bf16_cstr_append(buf, p, "            max_s = s; l = 1.0f;\n")
    p = bf16_cstr_append(buf, p, "            for (uint c = 0; c < n_chunks; ++c) { ulong d = (ulong)lane + (ulong)(c << 5); acc_reg[c] = (d < head_dim) ? v_vec[d] : 0.0f; }\n")
    p = bf16_cstr_append(buf, p, "        } else if (s > max_s) {\n")
    p = bf16_cstr_append(buf, p, "            float alpha = exp(max_s - s); l = fma(l, alpha, 1.0f);\n")
    p = bf16_cstr_append(buf, p, "            for (uint c = 0; c < n_chunks; ++c) { ulong d = (ulong)lane + (ulong)(c << 5); float vv = (d < head_dim) ? v_vec[d] : 0.0f; acc_reg[c] = fma(acc_reg[c], alpha, vv); }\n")
    p = bf16_cstr_append(buf, p, "            max_s = s;\n")
    p = bf16_cstr_append(buf, p, "        } else {\n")
    p = bf16_cstr_append(buf, p, "            float beta = exp(s - max_s); l = l + beta;\n")
    p = bf16_cstr_append(buf, p, "            for (uint c = 0; c < n_chunks; ++c) { ulong d = (ulong)lane + (ulong)(c << 5); float vv = (d < head_dim) ? v_vec[d] : 0.0f; acc_reg[c] = fma(beta, vv, acc_reg[c]); }\n")
    p = bf16_cstr_append(buf, p, "        }\n    }\n")
    p = bf16_cstr_append(buf, p, "    if (l > 0.0f) {\n")
    p = bf16_cstr_append(buf, p, "        float inv_l = 1.0f / l;\n")
    p = bf16_cstr_append(buf, p, "        for (uint c = 0; c < n_chunks; ++c) { ulong d = (ulong)lane + (ulong)(c << 5); if (d < head_dim) out_vec[d] = acc_reg[c] * inv_l; }\n")
    p = bf16_cstr_append(buf, p, "    } else {\n")
    p = bf16_cstr_append(buf, p, "        for (uint c = 0; c < n_chunks; ++c) { ulong d = (ulong)lane + (ulong)(c << 5); if (d < head_dim) out_vec[d] = 0.0f; }\n")
    p = bf16_cstr_append(buf, p, "    }\n}\n\n")

    // 7. qwen3_paged_gqa_f32 (32-lane SIMD per head)
    p = bf16_cstr_append(buf, p, "kernel void qwen3_paged_gqa_f32(\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* q_base [[buffer(0)]], constant ulong& q_off [[buffer(1)]],\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* kv_base [[buffer(2)]], constant ulong& table_off [[buffer(3)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& k_layer_off [[buffer(4)]], constant ulong& v_layer_off [[buffer(5)]],\n")
    p = bf16_cstr_append(buf, p, "    device uchar* out_base [[buffer(6)]], constant ulong& out_off [[buffer(7)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& n_q [[buffer(8)]], constant ulong& n_kv [[buffer(9)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& head_dim [[buffer(10)]], constant ulong& seq_len [[buffer(11)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& block_size [[buffer(12)]], uint gid [[thread_position_in_grid]], uint lane [[thread_index_in_simdgroup]]) {\n")
    p = bf16_cstr_append(buf, p, "    ulong q_h = (ulong)gid >> 5;\n")
    p = bf16_cstr_append(buf, p, "    if (q_h >= n_q || n_kv == 0 || head_dim == 0 || block_size == 0) return;\n")
    p = bf16_cstr_append(buf, p, "    ulong kv_h = q_h / (n_q / n_kv);\n")
    p = bf16_cstr_append(buf, p, "    device const float* q_vec = (device const float*)(q_base + q_off) + q_h * head_dim;\n")
    p = bf16_cstr_append(buf, p, "    device const uint* table = (device const uint*)(kv_base + table_off);\n")
    p = bf16_cstr_append(buf, p, "    device float* out_vec = (device float*)(out_base + out_off) + q_h * head_dim;\n")
    p = bf16_cstr_append(buf, p, "    qwen3_paged_gqa_head_simd(q_vec, kv_base, table, k_layer_off, v_layer_off, out_vec, n_kv, kv_h, head_dim, seq_len, block_size, lane);\n")
    p = bf16_cstr_append(buf, p, "}\n\n")

    // 8. qwen3_vec_add_f32
    p = bf16_cstr_append(buf, p, "kernel void qwen3_vec_add_f32(\n")
    p = bf16_cstr_append(buf, p, "    device uchar* a_base [[buffer(0)]], constant ulong& a_off [[buffer(1)]],\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* b_base [[buffer(2)]], constant ulong& b_off [[buffer(3)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& len [[buffer(4)]], uint gid [[thread_position_in_grid]]) {\n")
    p = bf16_cstr_append(buf, p, "    if ((ulong)gid >= len) return;\n")
    p = bf16_cstr_append(buf, p, "    device float* a = (device float*)(a_base + a_off);\n")
    p = bf16_cstr_append(buf, p, "    device const float* b = (device const float*)(b_base + b_off);\n")
    p = bf16_cstr_append(buf, p, "    a[gid] = a[gid] + b[gid];\n}\n\n")

    // 9. qwen3_kv_scatter_f32
    p = bf16_cstr_append(buf, p, "kernel void qwen3_kv_scatter_f32(\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* k_src_base [[buffer(0)]], constant ulong& k_src_off [[buffer(1)]],\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* v_src_base [[buffer(2)]], constant ulong& v_src_off [[buffer(3)]],\n")
    p = bf16_cstr_append(buf, p, "    device uchar* kv_base [[buffer(4)]], constant ulong& table_off [[buffer(5)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& k_layer_off [[buffer(6)]], constant ulong& v_layer_off [[buffer(7)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& n_kv_dim [[buffer(8)]], constant ulong& pos [[buffer(9)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& block_size [[buffer(10)]], uint gid [[thread_position_in_grid]]) {\n")
    p = bf16_cstr_append(buf, p, "    if ((ulong)gid >= n_kv_dim || block_size == 0) return;\n")
    p = bf16_cstr_append(buf, p, "    uint phys_blk = ((device const uint*)(kv_base + table_off))[pos / block_size];\n")
    p = bf16_cstr_append(buf, p, "    if (phys_blk == 0xFFFFFFFFu) return;\n")
    p = bf16_cstr_append(buf, p, "    ulong slot = pos % block_size;\n")
    p = bf16_cstr_append(buf, p, "    ulong dst_idx = (ulong)phys_blk * block_size * n_kv_dim + slot * n_kv_dim + (ulong)gid;\n")
    p = bf16_cstr_append(buf, p, "    ((device float*)(kv_base + k_layer_off))[dst_idx] = ((device const float*)(k_src_base + k_src_off))[gid];\n")
    p = bf16_cstr_append(buf, p, "    ((device float*)(kv_base + v_layer_off))[dst_idx] = ((device const float*)(v_src_base + v_src_off))[gid];\n}\n")
    p = bf16_cstr_append(buf, p, "\n")
    p = bf16_cstr_append(buf, p, "// 10. qwen3_argmax_top2_f32\n")
    p = bf16_cstr_append(buf, p, "kernel void qwen3_argmax_top2_f32(\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* logits_base [[buffer(0)]], constant ulong& logits_off [[buffer(1)]],\n")
    p = bf16_cstr_append(buf, p, "    device uchar* out_base [[buffer(2)]], constant ulong& out_off [[buffer(3)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& vocab [[buffer(4)]], uint lane [[thread_index_in_simdgroup]]) {\n")
    p = bf16_cstr_append(buf, p, "    threadgroup float tv1[32]; threadgroup float tv2[32];\n")
    p = bf16_cstr_append(buf, p, "    threadgroup ulong ti1[32]; threadgroup ulong ti2[32];\n")
    p = bf16_cstr_append(buf, p, "    device const float* lg = (device const float*)(logits_base + logits_off);\n")
    p = bf16_cstr_append(buf, p, "    float v1 = -INFINITY; float v2 = -INFINITY;\n")
    p = bf16_cstr_append(buf, p, "    ulong i1 = 0xFFFFFFFFFFFFFFFFul; ulong i2 = 0xFFFFFFFFFFFFFFFFul;\n")
    p = bf16_cstr_append(buf, p, "    for (ulong i = (ulong)lane; i < vocab; i = i + 32) {\n")
    p = bf16_cstr_append(buf, p, "        float v = lg[i];\n")
    p = bf16_cstr_append(buf, p, "        if (v > v1) { v2 = v1; i2 = i1; v1 = v; i1 = i; }\n")
    p = bf16_cstr_append(buf, p, "        else if (v > v2) { v2 = v; i2 = i; }\n")
    p = bf16_cstr_append(buf, p, "    }\n")
    p = bf16_cstr_append(buf, p, "    tv1[lane] = v1; tv2[lane] = v2; ti1[lane] = i1; ti2[lane] = i2;\n")
    p = bf16_cstr_append(buf, p, "    threadgroup_barrier(mem_flags::mem_threadgroup);\n")
    p = bf16_cstr_append(buf, p, "    if (lane == 0) {\n")
    p = bf16_cstr_append(buf, p, "        float b1 = -INFINITY; float b2 = -INFINITY;\n")
    p = bf16_cstr_append(buf, p, "        ulong j1 = 0xFFFFFFFFFFFFFFFFul; ulong j2 = 0xFFFFFFFFFFFFFFFFul;\n")
    p = bf16_cstr_append(buf, p, "        for (uint l = 0; l < 64; ++l) {\n")
    p = bf16_cstr_append(buf, p, "            float v = (l < 32) ? tv1[l] : tv2[l - 32];\n")
    p = bf16_cstr_append(buf, p, "            ulong ix = (l < 32) ? ti1[l] : ti2[l - 32];\n")
    p = bf16_cstr_append(buf, p, "            if (ix == 0xFFFFFFFFFFFFFFFFul) continue;\n")
    p = bf16_cstr_append(buf, p, "            if (v > b1 || (v == b1 && ix < j1)) { b2 = b1; j2 = j1; b1 = v; j1 = ix; }\n")
    p = bf16_cstr_append(buf, p, "            else if (v > b2 || (v == b2 && ix < j2)) { b2 = v; j2 = ix; }\n")
    p = bf16_cstr_append(buf, p, "        }\n")
    p = bf16_cstr_append(buf, p, "        device ulong* o_ids = (device ulong*)(out_base + out_off);\n")
    p = bf16_cstr_append(buf, p, "        device uint* o_bits = (device uint*)(out_base + out_off + 16);\n")
    p = bf16_cstr_append(buf, p, "        o_ids[0] = j1; o_ids[1] = j2;\n")
    p = bf16_cstr_append(buf, p, "        o_bits[0] = as_type<uint>(b1); o_bits[1] = as_type<uint>(b2);\n")
    p = bf16_cstr_append(buf, p, "    }\n}\n\n")

    // 11. qwen3_gemm_bf16 (TILE_ROWS=16, TILE_K=128, swizzled tg_x4[288]=4.5KB -> 0 bank conflicts, 100% occupancy, fused row0+row1)
    p = bf16_cstr_append(buf, p, "kernel void qwen3_gemm_bf16(\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* w_base [[buffer(0)]], constant ulong& w_off [[buffer(1)]],\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* x_base [[buffer(2)]], constant ulong& x_off [[buffer(3)]],\n")
    p = bf16_cstr_append(buf, p, "    device uchar* y_base [[buffer(4)]], constant ulong& y_off [[buffer(5)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& out_dim [[buffer(6)]], constant ulong& in_dim [[buffer(7)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& n_toks [[buffer(8)]], uint gid [[thread_position_in_grid]], uint tid [[thread_index_in_threadgroup]]) {\n")
    p = bf16_cstr_append(buf, p, "    threadgroup float4 tg_x4[288];\n")
    p = bf16_cstr_append(buf, p, "    threadgroup float* tg_x = (threadgroup float*)tg_x4;\n")
    p = bf16_cstr_append(buf, p, "    ulong n_groups = (out_dim + 15) / 16; ulong g = (ulong)gid >> 8;\n")
    p = bf16_cstr_append(buf, p, "    if (g >= n_groups || n_toks == 0) return;\n")
    p = bf16_cstr_append(buf, p, "    ulong sg = (ulong)tid >> 5; ulong lane = (ulong)tid & 31ul;\n")
    p = bf16_cstr_append(buf, p, "    ulong B = (n_toks > 8ul) ? 8ul : n_toks;\n")
    p = bf16_cstr_append(buf, p, "    ulong row0 = g * 16ul + sg; ulong row1 = row0 + 8ul;\n")
    p = bf16_cstr_append(buf, p, "    bool has0 = (row0 < out_dim); bool has1 = (row1 < out_dim);\n")
    p = bf16_cstr_append(buf, p, "    device const float* in_x = (device const float*)(x_base + x_off);\n")
    p = bf16_cstr_append(buf, p, "    device float* out_y = (device float*)(y_base + y_off);\n")
    p = bf16_cstr_append(buf, p, "    device const ushort* rw0 = has0 ? ((device const ushort*)(w_base + w_off) + row0 * in_dim) : (device const ushort*)w_base;\n")
    p = bf16_cstr_append(buf, p, "    device const ushort* rw1 = has1 ? ((device const ushort*)(w_base + w_off) + row1 * in_dim) : (device const ushort*)w_base;\n")
    p = bf16_cstr_append(buf, p, "    float a0=0.0f; float a1=0.0f; float a2=0.0f; float a3=0.0f; float a4=0.0f; float a5=0.0f; float a6=0.0f; float a7=0.0f;\n")
    p = bf16_cstr_append(buf, p, "    float b0=0.0f; float b1=0.0f; float b2=0.0f; float b3=0.0f; float b4=0.0f; float b5=0.0f; float b6=0.0f; float b7=0.0f;\n")
    p = bf16_cstr_append(buf, p, "    ulong swz = lane + (lane >> 3); ulong k_lane = lane << 2;\n")
    p = bf16_cstr_append(buf, p, "    for (ulong k_base = 0; k_base < in_dim; k_base = k_base + 128ul) {\n")
    p = bf16_cstr_append(buf, p, "        ulong chunk_k = min(128ul, in_dim - k_base);\n")
    p = bf16_cstr_append(buf, p, "        ulong total_load = B << 7;\n")
    p = bf16_cstr_append(buf, p, "        for (ulong idx = (ulong)tid; idx < total_load; idx = idx + 256ul) {\n")
    p = bf16_cstr_append(buf, p, "            ulong bb = idx >> 7; ulong kk = idx & 127ul;\n")
    p = bf16_cstr_append(buf, p, "            tg_x[bb * 144ul + kk + ((kk >> 5) << 2)] = (kk < chunk_k) ? in_x[bb * in_dim + k_base + kk] : 0.0f;\n")
    p = bf16_cstr_append(buf, p, "        }\n")
    p = bf16_cstr_append(buf, p, "        threadgroup_barrier(mem_flags::mem_threadgroup);\n")
    p = bf16_cstr_append(buf, p, "        if (k_lane + 3ul < chunk_k) {\n")
    p = bf16_cstr_append(buf, p, "            float4 wv0 = float4(0.0f); float4 wv1 = float4(0.0f);\n")
    p = bf16_cstr_append(buf, p, "            if (has0) {\n")
    p = bf16_cstr_append(buf, p, "                device const ushort* c0 = rw0 + k_base + k_lane;\n")
    p = bf16_cstr_append(buf, p, "                if ((((ulong)c0) & 7ul) == 0) { ulong w4 = *((device const ulong*)c0); uint wl = (uint)w4; uint wh = (uint)(w4 >> 32); wv0 = float4(as_type<float>(wl << 16), as_type<float>(wl & 0xFFFF0000u), as_type<float>(wh << 16), as_type<float>(wh & 0xFFFF0000u)); }\n")
    p = bf16_cstr_append(buf, p, "                else { wv0 = float4(as_type<float>(((uint)c0[0])<<16), as_type<float>(((uint)c0[1])<<16), as_type<float>(((uint)c0[2])<<16), as_type<float>(((uint)c0[3])<<16)); }\n")
    p = bf16_cstr_append(buf, p, "            }\n")
    p = bf16_cstr_append(buf, p, "            if (has1) {\n")
    p = bf16_cstr_append(buf, p, "                device const ushort* c1 = rw1 + k_base + k_lane;\n")
    p = bf16_cstr_append(buf, p, "                if ((((ulong)c1) & 7ul) == 0) { ulong w4 = *((device const ulong*)c1); uint wl = (uint)w4; uint wh = (uint)(w4 >> 32); wv1 = float4(as_type<float>(wl << 16), as_type<float>(wl & 0xFFFF0000u), as_type<float>(wh << 16), as_type<float>(wh & 0xFFFF0000u)); }\n")
    p = bf16_cstr_append(buf, p, "                else { wv1 = float4(as_type<float>(((uint)c1[0])<<16), as_type<float>(((uint)c1[1])<<16), as_type<float>(((uint)c1[2])<<16), as_type<float>(((uint)c1[3])<<16)); }\n")
    p = bf16_cstr_append(buf, p, "            }\n")
    p = bf16_cstr_append(buf, p, "            if (B == 8ul) {\n")
    p = bf16_cstr_append(buf, p, "                float4 x0 = tg_x4[swz]; float4 x1 = tg_x4[36ul + swz]; float4 x2 = tg_x4[72ul + swz]; float4 x3 = tg_x4[108ul + swz];\n")
    p = bf16_cstr_append(buf, p, "                float4 x4 = tg_x4[144ul + swz]; float4 x5 = tg_x4[180ul + swz]; float4 x6 = tg_x4[216ul + swz]; float4 x7 = tg_x4[252ul + swz];\n")
    p = bf16_cstr_append(buf, p, "                a0 = a0 + fma(wv0.x, x0.x, wv0.y * x0.y) + fma(wv0.z, x0.z, wv0.w * x0.w); b0 = b0 + fma(wv1.x, x0.x, wv1.y * x0.y) + fma(wv1.z, x0.z, wv1.w * x0.w);\n")
    p = bf16_cstr_append(buf, p, "                a1 = a1 + fma(wv0.x, x1.x, wv0.y * x1.y) + fma(wv0.z, x1.z, wv0.w * x1.w); b1 = b1 + fma(wv1.x, x1.x, wv1.y * x1.y) + fma(wv1.z, x1.z, wv1.w * x1.w);\n")
    p = bf16_cstr_append(buf, p, "                a2 = a2 + fma(wv0.x, x2.x, wv0.y * x2.y) + fma(wv0.z, x2.z, wv0.w * x2.w); b2 = b2 + fma(wv1.x, x2.x, wv1.y * x2.y) + fma(wv1.z, x2.z, wv1.w * x2.w);\n")
    p = bf16_cstr_append(buf, p, "                a3 = a3 + fma(wv0.x, x3.x, wv0.y * x3.y) + fma(wv0.z, x3.z, wv0.w * x3.w); b3 = b3 + fma(wv1.x, x3.x, wv1.y * x3.y) + fma(wv1.z, x3.z, wv1.w * x3.w);\n")
    p = bf16_cstr_append(buf, p, "                a4 = a4 + fma(wv0.x, x4.x, wv0.y * x4.y) + fma(wv0.z, x4.z, wv0.w * x4.w); b4 = b4 + fma(wv1.x, x4.x, wv1.y * x4.y) + fma(wv1.z, x4.z, wv1.w * x4.w);\n")
    p = bf16_cstr_append(buf, p, "                a5 = a5 + fma(wv0.x, x5.x, wv0.y * x5.y) + fma(wv0.z, x5.z, wv0.w * x5.w); b5 = b5 + fma(wv1.x, x5.x, wv1.y * x5.y) + fma(wv1.z, x5.z, wv1.w * x5.w);\n")
    p = bf16_cstr_append(buf, p, "                a6 = a6 + fma(wv0.x, x6.x, wv0.y * x6.y) + fma(wv0.z, x6.z, wv0.w * x6.w); b6 = b6 + fma(wv1.x, x6.x, wv1.y * x6.y) + fma(wv1.z, x6.z, wv1.w * x6.w);\n")
    p = bf16_cstr_append(buf, p, "                a7 = a7 + fma(wv0.x, x7.x, wv0.y * x7.y) + fma(wv0.z, x7.z, wv0.w * x7.w); b7 = b7 + fma(wv1.x, x7.x, wv1.y * x7.y) + fma(wv1.z, x7.z, wv1.w * x7.w);\n")
    p = bf16_cstr_append(buf, p, "            } else if (B <= 4ul) {\n")
    p = bf16_cstr_append(buf, p, "                float4 x0 = tg_x4[swz];\n")
    p = bf16_cstr_append(buf, p, "                a0 = a0 + fma(wv0.x, x0.x, wv0.y * x0.y) + fma(wv0.z, x0.z, wv0.w * x0.w); b0 = b0 + fma(wv1.x, x0.x, wv1.y * x0.y) + fma(wv1.z, x0.z, wv1.w * x0.w);\n")
    p = bf16_cstr_append(buf, p, "                if (B > 1ul) { float4 x1 = tg_x4[36ul + swz]; a1 = a1 + fma(wv0.x, x1.x, wv0.y * x1.y) + fma(wv0.z, x1.z, wv0.w * x1.w); b1 = b1 + fma(wv1.x, x1.x, wv1.y * x1.y) + fma(wv1.z, x1.z, wv1.w * x1.w); }\n")
    p = bf16_cstr_append(buf, p, "                if (B > 2ul) { float4 x2 = tg_x4[72ul + swz]; a2 = a2 + fma(wv0.x, x2.x, wv0.y * x2.y) + fma(wv0.z, x2.z, wv0.w * x2.w); b2 = b2 + fma(wv1.x, x2.x, wv1.y * x2.y) + fma(wv1.z, x2.z, wv1.w * x2.w); }\n")
    p = bf16_cstr_append(buf, p, "                if (B > 3ul) { float4 x3 = tg_x4[108ul + swz]; a3 = a3 + fma(wv0.x, x3.x, wv0.y * x3.y) + fma(wv0.z, x3.z, wv0.w * x3.w); b3 = b3 + fma(wv1.x, x3.x, wv1.y * x3.y) + fma(wv1.z, x3.z, wv1.w * x3.w); }\n")
    p = bf16_cstr_append(buf, p, "            } else {\n")
    p = bf16_cstr_append(buf, p, "                float4 x0 = tg_x4[swz]; float4 x1 = tg_x4[36ul + swz]; float4 x2 = tg_x4[72ul + swz]; float4 x3 = tg_x4[108ul + swz]; float4 x4 = tg_x4[144ul + swz];\n")
    p = bf16_cstr_append(buf, p, "                a0 = a0 + fma(wv0.x, x0.x, wv0.y * x0.y) + fma(wv0.z, x0.z, wv0.w * x0.w); b0 = b0 + fma(wv1.x, x0.x, wv1.y * x0.y) + fma(wv1.z, x0.z, wv1.w * x0.w);\n")
    p = bf16_cstr_append(buf, p, "                a1 = a1 + fma(wv0.x, x1.x, wv0.y * x1.y) + fma(wv0.z, x1.z, wv0.w * x1.w); b1 = b1 + fma(wv1.x, x1.x, wv1.y * x1.y) + fma(wv1.z, x1.z, wv1.w * x1.w);\n")
    p = bf16_cstr_append(buf, p, "                a2 = a2 + fma(wv0.x, x2.x, wv0.y * x2.y) + fma(wv0.z, x2.z, wv0.w * x2.w); b2 = b2 + fma(wv1.x, x2.x, wv1.y * x2.y) + fma(wv1.z, x2.z, wv1.w * x2.w);\n")
    p = bf16_cstr_append(buf, p, "                a3 = a3 + fma(wv0.x, x3.x, wv0.y * x3.y) + fma(wv0.z, x3.z, wv0.w * x3.w); b3 = b3 + fma(wv1.x, x3.x, wv1.y * x3.y) + fma(wv1.z, x3.z, wv1.w * x3.w);\n")
    p = bf16_cstr_append(buf, p, "                a4 = a4 + fma(wv0.x, x4.x, wv0.y * x4.y) + fma(wv0.z, x4.z, wv0.w * x4.w); b4 = b4 + fma(wv1.x, x4.x, wv1.y * x4.y) + fma(wv1.z, x4.z, wv1.w * x4.w);\n")
    p = bf16_cstr_append(buf, p, "                if (B > 5ul) { float4 x5 = tg_x4[180ul + swz]; a5 = a5 + fma(wv0.x, x5.x, wv0.y * x5.y) + fma(wv0.z, x5.z, wv0.w * x5.w); b5 = b5 + fma(wv1.x, x5.x, wv1.y * x5.y) + fma(wv1.z, x5.z, wv1.w * x5.w); }\n")
    p = bf16_cstr_append(buf, p, "                if (B > 6ul) { float4 x6 = tg_x4[216ul + swz]; a6 = a6 + fma(wv0.x, x6.x, wv0.y * x6.y) + fma(wv0.z, x6.z, wv0.w * x6.w); b6 = b6 + fma(wv1.x, x6.x, wv1.y * x6.y) + fma(wv1.z, x6.z, wv1.w * x6.w); }\n")
    p = bf16_cstr_append(buf, p, "            }\n")
    p = bf16_cstr_append(buf, p, "        } else if (k_lane < chunk_k) {\n")
    p = bf16_cstr_append(buf, p, "            for (ulong kt = k_lane; kt < chunk_k; ++kt) {\n")
    p = bf16_cstr_append(buf, p, "                ulong tx = kt + ((kt >> 5) << 2);\n")
    p = bf16_cstr_append(buf, p, "                float w0t = has0 ? as_type<float>(((uint)rw0[k_base + kt]) << 16) : 0.0f;\n")
    p = bf16_cstr_append(buf, p, "                float w1t = has1 ? as_type<float>(((uint)rw1[k_base + kt]) << 16) : 0.0f;\n")
    p = bf16_cstr_append(buf, p, "                a0 = fma(w0t, tg_x[tx], a0); b0 = fma(w1t, tg_x[tx], b0);\n")
    p = bf16_cstr_append(buf, p, "                if (B > 1ul) { a1 = fma(w0t, tg_x[144ul + tx], a1); b1 = fma(w1t, tg_x[144ul + tx], b1); }\n")
    p = bf16_cstr_append(buf, p, "                if (B > 2ul) { a2 = fma(w0t, tg_x[288ul + tx], a2); b2 = fma(w1t, tg_x[288ul + tx], b2); }\n")
    p = bf16_cstr_append(buf, p, "                if (B > 3ul) { a3 = fma(w0t, tg_x[432ul + tx], a3); b3 = fma(w1t, tg_x[432ul + tx], b3); }\n")
    p = bf16_cstr_append(buf, p, "                if (B > 4ul) { a4 = fma(w0t, tg_x[576ul + tx], a4); b4 = fma(w1t, tg_x[576ul + tx], b4); }\n")
    p = bf16_cstr_append(buf, p, "                if (B > 5ul) { a5 = fma(w0t, tg_x[720ul + tx], a5); b5 = fma(w1t, tg_x[720ul + tx], b5); }\n")
    p = bf16_cstr_append(buf, p, "                if (B > 6ul) { a6 = fma(w0t, tg_x[864ul + tx], a6); b6 = fma(w1t, tg_x[864ul + tx], b6); }\n")
    p = bf16_cstr_append(buf, p, "                if (B > 7ul) { a7 = fma(w0t, tg_x[1008ul + tx], a7); b7 = fma(w1t, tg_x[1008ul + tx], b7); }\n")
    p = bf16_cstr_append(buf, p, "            }\n        }\n")
    p = bf16_cstr_append(buf, p, "        threadgroup_barrier(mem_flags::mem_threadgroup);\n    }\n")
    p = bf16_cstr_append(buf, p, "    if (has0) {\n")
    p = bf16_cstr_append(buf, p, "        float r0 = simd_sum(a0); float r1 = (B > 1) ? simd_sum(a1) : 0.0f; float r2 = (B > 2) ? simd_sum(a2) : 0.0f; float r3 = (B > 3) ? simd_sum(a3) : 0.0f;\n")
    p = bf16_cstr_append(buf, p, "        float r4 = (B > 4) ? simd_sum(a4) : 0.0f; float r5 = (B > 5) ? simd_sum(a5) : 0.0f; float r6 = (B > 6) ? simd_sum(a6) : 0.0f; float r7 = (B > 7) ? simd_sum(a7) : 0.0f;\n")
    p = bf16_cstr_append(buf, p, "        if (lane == 0) {\n")
    p = bf16_cstr_append(buf, p, "            out_y[row0] = r0; if (B > 1) out_y[out_dim + row0] = r1; if (B > 2) out_y[2ul * out_dim + row0] = r2; if (B > 3) out_y[3ul * out_dim + row0] = r3;\n")
    p = bf16_cstr_append(buf, p, "            if (B > 4) out_y[4ul * out_dim + row0] = r4; if (B > 5) out_y[5ul * out_dim + row0] = r5; if (B > 6) out_y[6ul * out_dim + row0] = r6; if (B > 7) out_y[7ul * out_dim + row0] = r7;\n")
    p = bf16_cstr_append(buf, p, "        }\n    }\n")
    p = bf16_cstr_append(buf, p, "    if (has1) {\n")
    p = bf16_cstr_append(buf, p, "        float r0 = simd_sum(b0); float r1 = (B > 1) ? simd_sum(b1) : 0.0f; float r2 = (B > 2) ? simd_sum(b2) : 0.0f; float r3 = (B > 3) ? simd_sum(b3) : 0.0f;\n")
    p = bf16_cstr_append(buf, p, "        float r4 = (B > 4) ? simd_sum(b4) : 0.0f; float r5 = (B > 5) ? simd_sum(b5) : 0.0f; float r6 = (B > 6) ? simd_sum(b6) : 0.0f; float r7 = (B > 7) ? simd_sum(b7) : 0.0f;\n")
    p = bf16_cstr_append(buf, p, "        if (lane == 0) {\n")
    p = bf16_cstr_append(buf, p, "            out_y[row1] = r0; if (B > 1) out_y[out_dim + row1] = r1; if (B > 2) out_y[2ul * out_dim + row1] = r2; if (B > 3) out_y[3ul * out_dim + row1] = r3;\n")
    p = bf16_cstr_append(buf, p, "            if (B > 4) out_y[4ul * out_dim + row1] = r4; if (B > 5) out_y[5ul * out_dim + row1] = r5; if (B > 6) out_y[6ul * out_dim + row1] = r6; if (B > 7) out_y[7ul * out_dim + row1] = r7;\n")
    p = bf16_cstr_append(buf, p, "        }\n    }\n}\n\n")

    // 12. qwen3_gemm_f32 (TILE_ROWS=16, TILE_K=128, swizzled tg_x4[288]=4.5KB -> 0 bank conflicts, 100% occupancy, fused row0+row1)
    p = bf16_cstr_append(buf, p, "kernel void qwen3_gemm_f32(\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* w_base [[buffer(0)]], constant ulong& w_off [[buffer(1)]],\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* x_base [[buffer(2)]], constant ulong& x_off [[buffer(3)]],\n")
    p = bf16_cstr_append(buf, p, "    device uchar* y_base [[buffer(4)]], constant ulong& y_off [[buffer(5)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& out_dim [[buffer(6)]], constant ulong& in_dim [[buffer(7)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& n_toks [[buffer(8)]], uint gid [[thread_position_in_grid]], uint tid [[thread_index_in_threadgroup]]) {\n")
    p = bf16_cstr_append(buf, p, "    threadgroup float4 tg_x4[288];\n")
    p = bf16_cstr_append(buf, p, "    threadgroup float* tg_x = (threadgroup float*)tg_x4;\n")
    p = bf16_cstr_append(buf, p, "    ulong n_groups = (out_dim + 15) / 16; ulong g = (ulong)gid >> 8;\n")
    p = bf16_cstr_append(buf, p, "    if (g >= n_groups || n_toks == 0) return;\n")
    p = bf16_cstr_append(buf, p, "    ulong sg = (ulong)tid >> 5; ulong lane = (ulong)tid & 31ul;\n")
    p = bf16_cstr_append(buf, p, "    ulong B = (n_toks > 8ul) ? 8ul : n_toks;\n")
    p = bf16_cstr_append(buf, p, "    ulong row0 = g * 16ul + sg; ulong row1 = row0 + 8ul;\n")
    p = bf16_cstr_append(buf, p, "    bool has0 = (row0 < out_dim); bool has1 = (row1 < out_dim);\n")
    p = bf16_cstr_append(buf, p, "    device const float* in_x = (device const float*)(x_base + x_off);\n")
    p = bf16_cstr_append(buf, p, "    device float* out_y = (device float*)(y_base + y_off);\n")
    p = bf16_cstr_append(buf, p, "    device const float* rw0 = has0 ? ((device const float*)(w_base + w_off) + row0 * in_dim) : (device const float*)w_base;\n")
    p = bf16_cstr_append(buf, p, "    device const float* rw1 = has1 ? ((device const float*)(w_base + w_off) + row1 * in_dim) : (device const float*)w_base;\n")
    p = bf16_cstr_append(buf, p, "    float a0=0.0f; float a1=0.0f; float a2=0.0f; float a3=0.0f; float a4=0.0f; float a5=0.0f; float a6=0.0f; float a7=0.0f;\n")
    p = bf16_cstr_append(buf, p, "    float b0=0.0f; float b1=0.0f; float b2=0.0f; float b3=0.0f; float b4=0.0f; float b5=0.0f; float b6=0.0f; float b7=0.0f;\n")
    p = bf16_cstr_append(buf, p, "    ulong swz = lane + (lane >> 3); ulong k_lane = lane << 2;\n")
    p = bf16_cstr_append(buf, p, "    for (ulong k_base = 0; k_base < in_dim; k_base = k_base + 128ul) {\n")
    p = bf16_cstr_append(buf, p, "        ulong chunk_k = min(128ul, in_dim - k_base);\n")
    p = bf16_cstr_append(buf, p, "        ulong total_load = B << 7;\n")
    p = bf16_cstr_append(buf, p, "        for (ulong idx = (ulong)tid; idx < total_load; idx = idx + 256ul) {\n")
    p = bf16_cstr_append(buf, p, "            ulong bb = idx >> 7; ulong kk = idx & 127ul;\n")
    p = bf16_cstr_append(buf, p, "            tg_x[bb * 144ul + kk + ((kk >> 5) << 2)] = (kk < chunk_k) ? in_x[bb * in_dim + k_base + kk] : 0.0f;\n")
    p = bf16_cstr_append(buf, p, "        }\n")
    p = bf16_cstr_append(buf, p, "        threadgroup_barrier(mem_flags::mem_threadgroup);\n")
    p = bf16_cstr_append(buf, p, "        if (k_lane + 3ul < chunk_k) {\n")
    p = bf16_cstr_append(buf, p, "            float4 wv0 = float4(0.0f); float4 wv1 = float4(0.0f);\n")
    p = bf16_cstr_append(buf, p, "            if (has0) { device const float* c0 = rw0 + k_base + k_lane; wv0 = float4(c0[0], c0[1], c0[2], c0[3]); }\n")
    p = bf16_cstr_append(buf, p, "            if (has1) { device const float* c1 = rw1 + k_base + k_lane; wv1 = float4(c1[0], c1[1], c1[2], c1[3]); }\n")
    p = bf16_cstr_append(buf, p, "            if (B == 8ul) {\n")
    p = bf16_cstr_append(buf, p, "                float4 x0 = tg_x4[swz]; float4 x1 = tg_x4[36ul + swz]; float4 x2 = tg_x4[72ul + swz]; float4 x3 = tg_x4[108ul + swz];\n")
    p = bf16_cstr_append(buf, p, "                float4 x4 = tg_x4[144ul + swz]; float4 x5 = tg_x4[180ul + swz]; float4 x6 = tg_x4[216ul + swz]; float4 x7 = tg_x4[252ul + swz];\n")
    p = bf16_cstr_append(buf, p, "                a0 = a0 + fma(wv0.x, x0.x, wv0.y * x0.y) + fma(wv0.z, x0.z, wv0.w * x0.w); b0 = b0 + fma(wv1.x, x0.x, wv1.y * x0.y) + fma(wv1.z, x0.z, wv1.w * x0.w);\n")
    p = bf16_cstr_append(buf, p, "                a1 = a1 + fma(wv0.x, x1.x, wv0.y * x1.y) + fma(wv0.z, x1.z, wv0.w * x1.w); b1 = b1 + fma(wv1.x, x1.x, wv1.y * x1.y) + fma(wv1.z, x1.z, wv1.w * x1.w);\n")
    p = bf16_cstr_append(buf, p, "                a2 = a2 + fma(wv0.x, x2.x, wv0.y * x2.y) + fma(wv0.z, x2.z, wv0.w * x2.w); b2 = b2 + fma(wv1.x, x2.x, wv1.y * x2.y) + fma(wv1.z, x2.z, wv1.w * x2.w);\n")
    p = bf16_cstr_append(buf, p, "                a3 = a3 + fma(wv0.x, x3.x, wv0.y * x3.y) + fma(wv0.z, x3.z, wv0.w * x3.w); b3 = b3 + fma(wv1.x, x3.x, wv1.y * x3.y) + fma(wv1.z, x3.z, wv1.w * x3.w);\n")
    p = bf16_cstr_append(buf, p, "                a4 = a4 + fma(wv0.x, x4.x, wv0.y * x4.y) + fma(wv0.z, x4.z, wv0.w * x4.w); b4 = b4 + fma(wv1.x, x4.x, wv1.y * x4.y) + fma(wv1.z, x4.z, wv1.w * x4.w);\n")
    p = bf16_cstr_append(buf, p, "                a5 = a5 + fma(wv0.x, x5.x, wv0.y * x5.y) + fma(wv0.z, x5.z, wv0.w * x5.w); b5 = b5 + fma(wv1.x, x5.x, wv1.y * x5.y) + fma(wv1.z, x5.z, wv1.w * x5.w);\n")
    p = bf16_cstr_append(buf, p, "                a6 = a6 + fma(wv0.x, x6.x, wv0.y * x6.y) + fma(wv0.z, x6.z, wv0.w * x6.w); b6 = b6 + fma(wv1.x, x6.x, wv1.y * x6.y) + fma(wv1.z, x6.z, wv1.w * x6.w);\n")
    p = bf16_cstr_append(buf, p, "                a7 = a7 + fma(wv0.x, x7.x, wv0.y * x7.y) + fma(wv0.z, x7.z, wv0.w * x7.w); b7 = b7 + fma(wv1.x, x7.x, wv1.y * x7.y) + fma(wv1.z, x7.z, wv1.w * x7.w);\n")
    p = bf16_cstr_append(buf, p, "            } else if (B <= 4ul) {\n")
    p = bf16_cstr_append(buf, p, "                float4 x0 = tg_x4[swz];\n")
    p = bf16_cstr_append(buf, p, "                a0 = a0 + fma(wv0.x, x0.x, wv0.y * x0.y) + fma(wv0.z, x0.z, wv0.w * x0.w); b0 = b0 + fma(wv1.x, x0.x, wv1.y * x0.y) + fma(wv1.z, x0.z, wv1.w * x0.w);\n")
    p = bf16_cstr_append(buf, p, "                if (B > 1ul) { float4 x1 = tg_x4[36ul + swz]; a1 = a1 + fma(wv0.x, x1.x, wv0.y * x1.y) + fma(wv0.z, x1.z, wv0.w * x1.w); b1 = b1 + fma(wv1.x, x1.x, wv1.y * x1.y) + fma(wv1.z, x1.z, wv1.w * x1.w); }\n")
    p = bf16_cstr_append(buf, p, "                if (B > 2ul) { float4 x2 = tg_x4[72ul + swz]; a2 = a2 + fma(wv0.x, x2.x, wv0.y * x2.y) + fma(wv0.z, x2.z, wv0.w * x2.w); b2 = b2 + fma(wv1.x, x2.x, wv1.y * x2.y) + fma(wv1.z, x2.z, wv1.w * x2.w); }\n")
    p = bf16_cstr_append(buf, p, "                if (B > 3ul) { float4 x3 = tg_x4[108ul + swz]; a3 = a3 + fma(wv0.x, x3.x, wv0.y * x3.y) + fma(wv0.z, x3.z, wv0.w * x3.w); b3 = b3 + fma(wv1.x, x3.x, wv1.y * x3.y) + fma(wv1.z, x3.z, wv1.w * x3.w); }\n")
    p = bf16_cstr_append(buf, p, "            } else {\n")
    p = bf16_cstr_append(buf, p, "                float4 x0 = tg_x4[swz]; float4 x1 = tg_x4[36ul + swz]; float4 x2 = tg_x4[72ul + swz]; float4 x3 = tg_x4[108ul + swz]; float4 x4 = tg_x4[144ul + swz];\n")
    p = bf16_cstr_append(buf, p, "                a0 = a0 + fma(wv0.x, x0.x, wv0.y * x0.y) + fma(wv0.z, x0.z, wv0.w * x0.w); b0 = b0 + fma(wv1.x, x0.x, wv1.y * x0.y) + fma(wv1.z, x0.z, wv1.w * x0.w);\n")
    p = bf16_cstr_append(buf, p, "                a1 = a1 + fma(wv0.x, x1.x, wv0.y * x1.y) + fma(wv0.z, x1.z, wv0.w * x1.w); b1 = b1 + fma(wv1.x, x1.x, wv1.y * x1.y) + fma(wv1.z, x1.z, wv1.w * x1.w);\n")
    p = bf16_cstr_append(buf, p, "                a2 = a2 + fma(wv0.x, x2.x, wv0.y * x2.y) + fma(wv0.z, x2.z, wv0.w * x2.w); b2 = b2 + fma(wv1.x, x2.x, wv1.y * x2.y) + fma(wv1.z, x2.z, wv1.w * x2.w);\n")
    p = bf16_cstr_append(buf, p, "                a3 = a3 + fma(wv0.x, x3.x, wv0.y * x3.y) + fma(wv0.z, x3.z, wv0.w * x3.w); b3 = b3 + fma(wv1.x, x3.x, wv1.y * x3.y) + fma(wv1.z, x3.z, wv1.w * x3.w);\n")
    p = bf16_cstr_append(buf, p, "                a4 = a4 + fma(wv0.x, x4.x, wv0.y * x4.y) + fma(wv0.z, x4.z, wv0.w * x4.w); b4 = b4 + fma(wv1.x, x4.x, wv1.y * x4.y) + fma(wv1.z, x4.z, wv1.w * x4.w);\n")
    p = bf16_cstr_append(buf, p, "                if (B > 5ul) { float4 x5 = tg_x4[180ul + swz]; a5 = a5 + fma(wv0.x, x5.x, wv0.y * x5.y) + fma(wv0.z, x5.z, wv0.w * x5.w); b5 = b5 + fma(wv1.x, x5.x, wv1.y * x5.y) + fma(wv1.z, x5.z, wv1.w * x5.w); }\n")
    p = bf16_cstr_append(buf, p, "                if (B > 6ul) { float4 x6 = tg_x4[216ul + swz]; a6 = a6 + fma(wv0.x, x6.x, wv0.y * x6.y) + fma(wv0.z, x6.z, wv0.w * x6.w); b6 = b6 + fma(wv1.x, x6.x, wv1.y * x6.y) + fma(wv1.z, x6.z, wv1.w * x6.w); }\n")
    p = bf16_cstr_append(buf, p, "            }\n")
    p = bf16_cstr_append(buf, p, "        } else if (k_lane < chunk_k) {\n")
    p = bf16_cstr_append(buf, p, "            for (ulong kt = k_lane; kt < chunk_k; ++kt) {\n")
    p = bf16_cstr_append(buf, p, "                ulong tx = kt + ((kt >> 5) << 2);\n")
    p = bf16_cstr_append(buf, p, "                float w0t = has0 ? rw0[k_base + kt] : 0.0f;\n")
    p = bf16_cstr_append(buf, p, "                float w1t = has1 ? rw1[k_base + kt] : 0.0f;\n")
    p = bf16_cstr_append(buf, p, "                a0 = fma(w0t, tg_x[tx], a0); b0 = fma(w1t, tg_x[tx], b0);\n")
    p = bf16_cstr_append(buf, p, "                if (B > 1ul) { a1 = fma(w0t, tg_x[144ul + tx], a1); b1 = fma(w1t, tg_x[144ul + tx], b1); }\n")
    p = bf16_cstr_append(buf, p, "                if (B > 2ul) { a2 = fma(w0t, tg_x[288ul + tx], a2); b2 = fma(w1t, tg_x[288ul + tx], b2); }\n")
    p = bf16_cstr_append(buf, p, "                if (B > 3ul) { a3 = fma(w0t, tg_x[432ul + tx], a3); b3 = fma(w1t, tg_x[432ul + tx], b3); }\n")
    p = bf16_cstr_append(buf, p, "                if (B > 4ul) { a4 = fma(w0t, tg_x[576ul + tx], a4); b4 = fma(w1t, tg_x[576ul + tx], b4); }\n")
    p = bf16_cstr_append(buf, p, "                if (B > 5ul) { a5 = fma(w0t, tg_x[720ul + tx], a5); b5 = fma(w1t, tg_x[720ul + tx], b5); }\n")
    p = bf16_cstr_append(buf, p, "                if (B > 6ul) { a6 = fma(w0t, tg_x[864ul + tx], a6); b6 = fma(w1t, tg_x[864ul + tx], b6); }\n")
    p = bf16_cstr_append(buf, p, "                if (B > 7ul) { a7 = fma(w0t, tg_x[1008ul + tx], a7); b7 = fma(w1t, tg_x[1008ul + tx], b7); }\n")
    p = bf16_cstr_append(buf, p, "            }\n        }\n")
    p = bf16_cstr_append(buf, p, "        threadgroup_barrier(mem_flags::mem_threadgroup);\n    }\n")
    p = bf16_cstr_append(buf, p, "    if (has0) {\n")
    p = bf16_cstr_append(buf, p, "        float r0 = simd_sum(a0); float r1 = (B > 1) ? simd_sum(a1) : 0.0f; float r2 = (B > 2) ? simd_sum(a2) : 0.0f; float r3 = (B > 3) ? simd_sum(a3) : 0.0f;\n")
    p = bf16_cstr_append(buf, p, "        float r4 = (B > 4) ? simd_sum(a4) : 0.0f; float r5 = (B > 5) ? simd_sum(a5) : 0.0f; float r6 = (B > 6) ? simd_sum(a6) : 0.0f; float r7 = (B > 7) ? simd_sum(a7) : 0.0f;\n")
    p = bf16_cstr_append(buf, p, "        if (lane == 0) {\n")
    p = bf16_cstr_append(buf, p, "            out_y[row0] = r0; if (B > 1) out_y[out_dim + row0] = r1; if (B > 2) out_y[2ul * out_dim + row0] = r2; if (B > 3) out_y[3ul * out_dim + row0] = r3;\n")
    p = bf16_cstr_append(buf, p, "            if (B > 4) out_y[4ul * out_dim + row0] = r4; if (B > 5) out_y[5ul * out_dim + row0] = r5; if (B > 6) out_y[6ul * out_dim + row0] = r6; if (B > 7) out_y[7ul * out_dim + row0] = r7;\n")
    p = bf16_cstr_append(buf, p, "        }\n    }\n")
    p = bf16_cstr_append(buf, p, "    if (has1) {\n")
    p = bf16_cstr_append(buf, p, "        float r0 = simd_sum(b0); float r1 = (B > 1) ? simd_sum(b1) : 0.0f; float r2 = (B > 2) ? simd_sum(b2) : 0.0f; float r3 = (B > 3) ? simd_sum(b3) : 0.0f;\n")
    p = bf16_cstr_append(buf, p, "        float r4 = (B > 4) ? simd_sum(b4) : 0.0f; float r5 = (B > 5) ? simd_sum(b5) : 0.0f; float r6 = (B > 6) ? simd_sum(b6) : 0.0f; float r7 = (B > 7) ? simd_sum(b7) : 0.0f;\n")
    p = bf16_cstr_append(buf, p, "        if (lane == 0) {\n")
    p = bf16_cstr_append(buf, p, "            out_y[row1] = r0; if (B > 1) out_y[out_dim + row1] = r1; if (B > 2) out_y[2ul * out_dim + row1] = r2; if (B > 3) out_y[3ul * out_dim + row1] = r3;\n")
    p = bf16_cstr_append(buf, p, "            if (B > 4) out_y[4ul * out_dim + row1] = r4; if (B > 5) out_y[5ul * out_dim + row1] = r5; if (B > 6) out_y[6ul * out_dim + row1] = r6; if (B > 7) out_y[7ul * out_dim + row1] = r7;\n")
    p = bf16_cstr_append(buf, p, "        }\n    }\n}\n\n")

    // 13. qwen3_rope_batch_f32
    p = bf16_cstr_append(buf, p, "kernel void qwen3_rope_batch_f32(\n")
    p = bf16_cstr_append(buf, p, "    device uchar* v_base [[buffer(0)]], constant ulong& v_off [[buffer(1)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& n_heads [[buffer(2)]], constant ulong& head_dim [[buffer(3)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& pos_start [[buffer(4)]], constant ulong& theta_bits [[buffer(5)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& n_toks [[buffer(6)]], uint gid [[thread_position_in_grid]]) {\n")
    p = bf16_cstr_append(buf, p, "    ulong hdim = head_dim / 2;\n")
    p = bf16_cstr_append(buf, p, "    ulong per_tok = n_heads * hdim;\n")
    p = bf16_cstr_append(buf, p, "    if (hdim == 0 || per_tok == 0 || (ulong)gid >= n_toks * per_tok) return;\n")
    p = bf16_cstr_append(buf, p, "    ulong b = (ulong)gid / per_tok;\n")
    p = bf16_cstr_append(buf, p, "    ulong rem = (ulong)gid % per_tok;\n")
    p = bf16_cstr_append(buf, p, "    ulong h = rem / hdim;\n")
    p = bf16_cstr_append(buf, p, "    ulong j = rem % hdim;\n")
    p = bf16_cstr_append(buf, p, "    float theta = as_type<float>((uint)theta_bits);\n")
    p = bf16_cstr_append(buf, p, "    float freq = pow(theta, -float(2 * j) / float(head_dim));\n")
    p = bf16_cstr_append(buf, p, "    float angle = float(pos_start + b) * freq;\n")
    p = bf16_cstr_append(buf, p, "    float cos_a = cos(angle);\n")
    p = bf16_cstr_append(buf, p, "    float sin_a = sin(angle);\n")
    p = bf16_cstr_append(buf, p, "    device float* head_ptr = (device float*)(v_base + v_off) + (b * n_heads + h) * head_dim;\n")
    p = bf16_cstr_append(buf, p, "    float x0 = head_ptr[j]; float x1 = head_ptr[j + hdim];\n")
    p = bf16_cstr_append(buf, p, "    head_ptr[j] = x0 * cos_a - x1 * sin_a;\n")
    p = bf16_cstr_append(buf, p, "    head_ptr[j + hdim] = x1 * cos_a + x0 * sin_a;\n}\n\n")

    // 14. qwen3_kv_scatter_batch_f32
    p = bf16_cstr_append(buf, p, "kernel void qwen3_kv_scatter_batch_f32(\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* k_src_base [[buffer(0)]], constant ulong& k_src_off [[buffer(1)]],\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* v_src_base [[buffer(2)]], constant ulong& v_src_off [[buffer(3)]],\n")
    p = bf16_cstr_append(buf, p, "    device uchar* kv_base [[buffer(4)]], constant ulong& table_off [[buffer(5)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& k_layer_off [[buffer(6)]], constant ulong& v_layer_off [[buffer(7)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& n_kv_dim [[buffer(8)]], constant ulong& pos_and_ntoks [[buffer(9)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& block_size [[buffer(10)]], uint gid [[thread_position_in_grid]]) {\n")
    p = bf16_cstr_append(buf, p, "    ulong pos0 = pos_and_ntoks & 0xFFFFFFFFul;\n")
    p = bf16_cstr_append(buf, p, "    ulong n_toks = pos_and_ntoks >> 32;\n")
    p = bf16_cstr_append(buf, p, "    if (n_kv_dim == 0 || block_size == 0 || (ulong)gid >= n_toks * n_kv_dim) return;\n")
    p = bf16_cstr_append(buf, p, "    ulong b = (ulong)gid / n_kv_dim;\n")
    p = bf16_cstr_append(buf, p, "    ulong d = (ulong)gid % n_kv_dim;\n")
    p = bf16_cstr_append(buf, p, "    ulong pos = pos0 + b;\n")
    p = bf16_cstr_append(buf, p, "    uint phys_blk = ((device const uint*)(kv_base + table_off))[pos / block_size];\n")
    p = bf16_cstr_append(buf, p, "    if (phys_blk == 0xFFFFFFFFu) return;\n")
    p = bf16_cstr_append(buf, p, "    ulong slot = pos % block_size;\n")
    p = bf16_cstr_append(buf, p, "    ulong dst_idx = (ulong)phys_blk * block_size * n_kv_dim + slot * n_kv_dim + d;\n")
    p = bf16_cstr_append(buf, p, "    ((device float*)(kv_base + k_layer_off))[dst_idx] = ((device const float*)(k_src_base + k_src_off))[gid];\n")
    p = bf16_cstr_append(buf, p, "    ((device float*)(kv_base + v_layer_off))[dst_idx] = ((device const float*)(v_src_base + v_src_off))[gid];\n}\n\n")

    // 15. qwen3_paged_gqa_batch_f32 (32-lane SIMD per head)
    p = bf16_cstr_append(buf, p, "kernel void qwen3_paged_gqa_batch_f32(\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* q_base [[buffer(0)]], constant ulong& q_off [[buffer(1)]],\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* kv_base [[buffer(2)]], constant ulong& table_off [[buffer(3)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& k_layer_off [[buffer(4)]], constant ulong& v_layer_off [[buffer(5)]],\n")
    p = bf16_cstr_append(buf, p, "    device uchar* out_base [[buffer(6)]], constant ulong& out_off [[buffer(7)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& n_q [[buffer(8)]], constant ulong& n_kv [[buffer(9)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& head_dim [[buffer(10)]], constant ulong& pos_and_ntoks [[buffer(11)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& block_size [[buffer(12)]], uint gid [[thread_position_in_grid]], uint lane [[thread_index_in_simdgroup]]) {\n")
    p = bf16_cstr_append(buf, p, "    ulong pos0 = pos_and_ntoks & 0xFFFFFFFFul;\n")
    p = bf16_cstr_append(buf, p, "    ulong n_toks = pos_and_ntoks >> 32;\n")
    p = bf16_cstr_append(buf, p, "    ulong idx = (ulong)gid >> 5;\n")
    p = bf16_cstr_append(buf, p, "    if (n_q == 0 || n_kv == 0 || head_dim == 0 || block_size == 0 || idx >= n_toks * n_q) return;\n")
    p = bf16_cstr_append(buf, p, "    ulong b = idx / n_q; ulong q_h = idx % n_q;\n")
    p = bf16_cstr_append(buf, p, "    ulong kv_h = q_h / (n_q / n_kv);\n")
    p = bf16_cstr_append(buf, p, "    ulong seq_len = pos0 + b + 1;\n")
    p = bf16_cstr_append(buf, p, "    device const float* q_vec = (device const float*)(q_base + q_off) + (b * n_q + q_h) * head_dim;\n")
    p = bf16_cstr_append(buf, p, "    device const uint* table = (device const uint*)(kv_base + table_off);\n")
    p = bf16_cstr_append(buf, p, "    device float* out_vec = (device float*)(out_base + out_off) + (b * n_q + q_h) * head_dim;\n")
    p = bf16_cstr_append(buf, p, "    qwen3_paged_gqa_head_simd(q_vec, kv_base, table, k_layer_off, v_layer_off, out_vec, n_kv, kv_h, head_dim, seq_len, block_size, lane);\n")
    p = bf16_cstr_append(buf, p, "}\n\n")

    // 16. qwen3_argmax_top2_batch_f32
    p = bf16_cstr_append(buf, p, "kernel void qwen3_argmax_top2_batch_f32(\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* logits_base [[buffer(0)]], constant ulong& logits_off [[buffer(1)]],\n")
    p = bf16_cstr_append(buf, p, "    device uchar* out_base [[buffer(2)]], constant ulong& out_off [[buffer(3)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& vocab [[buffer(4)]], constant ulong& n_toks [[buffer(5)]],\n")
    p = bf16_cstr_append(buf, p, "    uint gid [[thread_position_in_grid]], uint lane [[thread_index_in_simdgroup]]) {\n")
    p = bf16_cstr_append(buf, p, "    ulong b = (ulong)gid >> 5;\n")
    p = bf16_cstr_append(buf, p, "    if (b >= n_toks) return;\n")
    p = bf16_cstr_append(buf, p, "    threadgroup float tv1[32]; threadgroup float tv2[32];\n")
    p = bf16_cstr_append(buf, p, "    threadgroup ulong ti1[32]; threadgroup ulong ti2[32];\n")
    p = bf16_cstr_append(buf, p, "    device const float* lg = (device const float*)(logits_base + logits_off) + b * vocab;\n")
    p = bf16_cstr_append(buf, p, "    float v1 = -INFINITY; float v2 = -INFINITY;\n")
    p = bf16_cstr_append(buf, p, "    ulong i1 = 0xFFFFFFFFFFFFFFFFul; ulong i2 = 0xFFFFFFFFFFFFFFFFul;\n")
    p = bf16_cstr_append(buf, p, "    for (ulong i = (ulong)lane; i < vocab; i = i + 32) {\n")
    p = bf16_cstr_append(buf, p, "        float v = lg[i];\n")
    p = bf16_cstr_append(buf, p, "        if (v > v1) { v2 = v1; i2 = i1; v1 = v; i1 = i; }\n")
    p = bf16_cstr_append(buf, p, "        else if (v > v2) { v2 = v; i2 = i; }\n")
    p = bf16_cstr_append(buf, p, "    }\n")
    p = bf16_cstr_append(buf, p, "    tv1[lane] = v1; tv2[lane] = v2; ti1[lane] = i1; ti2[lane] = i2;\n")
    p = bf16_cstr_append(buf, p, "    threadgroup_barrier(mem_flags::mem_threadgroup);\n")
    p = bf16_cstr_append(buf, p, "    if (lane == 0) {\n")
    p = bf16_cstr_append(buf, p, "        float b1 = -INFINITY; float b2 = -INFINITY;\n")
    p = bf16_cstr_append(buf, p, "        ulong j1 = 0xFFFFFFFFFFFFFFFFul; ulong j2 = 0xFFFFFFFFFFFFFFFFul;\n")
    p = bf16_cstr_append(buf, p, "        for (uint l = 0; l < 64; ++l) {\n")
    p = bf16_cstr_append(buf, p, "            float v = (l < 32) ? tv1[l] : tv2[l - 32];\n")
    p = bf16_cstr_append(buf, p, "            ulong ix = (l < 32) ? ti1[l] : ti2[l - 32];\n")
    p = bf16_cstr_append(buf, p, "            if (ix == 0xFFFFFFFFFFFFFFFFul) continue;\n")
    p = bf16_cstr_append(buf, p, "            if (v > b1 || (v == b1 && ix < j1)) { b2 = b1; j2 = j1; b1 = v; j1 = ix; }\n")
    p = bf16_cstr_append(buf, p, "            else if (v > b2 || (v == b2 && ix < j2)) { b2 = v; j2 = ix; }\n")
    p = bf16_cstr_append(buf, p, "        }\n")
    p = bf16_cstr_append(buf, p, "        device ulong* o_ids = (device ulong*)(out_base + out_off + b * 32);\n")
    p = bf16_cstr_append(buf, p, "        device uint* o_bits = (device uint*)(out_base + out_off + b * 32 + 16);\n")
    p = bf16_cstr_append(buf, p, "        o_ids[0] = j1; o_ids[1] = j2;\n")
    p = bf16_cstr_append(buf, p, "        o_bits[0] = as_type<uint>(b1); o_bits[1] = as_type<uint>(b2);\n")
    p = bf16_cstr_append(buf, p, "    }\n}\n\n")

    // Inline F2 helper: QK-RMSNorm + half-split RoPE + Paged KV Scatter
    p = bf16_cstr_append(buf, p, "inline void qwen3_qk_norm_rope_scatter_head(\n")
    p = bf16_cstr_append(buf, p, "    device float* vec, device const float* v_head,\n")
    p = bf16_cstr_append(buf, p, "    device const ushort* w_bf16, device const float* w_f32, bool is_bf16,\n")
    p = bf16_cstr_append(buf, p, "    device uchar* kv_base, ulong table_off, ulong k_layer_off, ulong v_layer_off,\n")
    p = bf16_cstr_append(buf, p, "    ulong n_kv, ulong kh, ulong head_dim, ulong pos, ulong block_size,\n")
    p = bf16_cstr_append(buf, p, "    float eps, float theta, uint lane, bool is_k) {\n")
    p = bf16_cstr_append(buf, p, "    float sum_sq = 0.0f;\n")
    p = bf16_cstr_append(buf, p, "    for (ulong d = (ulong)lane; d < head_dim; d = d + 32ul) { float x = vec[d]; sum_sq = fma(x, x, sum_sq); }\n")
    p = bf16_cstr_append(buf, p, "    sum_sq = simd_sum(sum_sq);\n")
    p = bf16_cstr_append(buf, p, "    float inv_rms = rsqrt(sum_sq / float(head_dim) + eps);\n")
    p = bf16_cstr_append(buf, p, "    bool write_kv = false;\n")
    p = bf16_cstr_append(buf, p, "    device float* k_dst = (device float*)(kv_base + k_layer_off);\n")
    p = bf16_cstr_append(buf, p, "    device float* v_dst = (device float*)(kv_base + v_layer_off);\n")
    p = bf16_cstr_append(buf, p, "    ulong kv_head_base = 0ul;\n")
    p = bf16_cstr_append(buf, p, "    if (is_k) {\n")
    p = bf16_cstr_append(buf, p, "        uint phys_blk = ((device const uint*)(kv_base + table_off))[pos / block_size];\n")
    p = bf16_cstr_append(buf, p, "        if (phys_blk != 0xFFFFFFFFu) {\n")
    p = bf16_cstr_append(buf, p, "            ulong slot = pos % block_size;\n")
    p = bf16_cstr_append(buf, p, "            kv_head_base = ((ulong)phys_blk * block_size + slot) * (n_kv * head_dim) + kh * head_dim;\n")
    p = bf16_cstr_append(buf, p, "            write_kv = true;\n        }\n    }\n")
    p = bf16_cstr_append(buf, p, "    ulong hdim = head_dim >> 1;\n")
    p = bf16_cstr_append(buf, p, "    for (ulong j = (ulong)lane; j < hdim; j = j + 32ul) {\n")
    p = bf16_cstr_append(buf, p, "        float w0 = is_bf16 ? as_type<float>(((uint)w_bf16[j]) << 16) : w_f32[j];\n")
    p = bf16_cstr_append(buf, p, "        float w1 = is_bf16 ? as_type<float>(((uint)w_bf16[j + hdim]) << 16) : w_f32[j + hdim];\n")
    p = bf16_cstr_append(buf, p, "        float x0 = vec[j] * inv_rms * w0; float x1 = vec[j + hdim] * inv_rms * w1;\n")
    p = bf16_cstr_append(buf, p, "        float freq = pow(theta, -float(2 * j) / float(head_dim));\n")
    p = bf16_cstr_append(buf, p, "        float angle = float(pos) * freq; float cos_a = cos(angle); float sin_a = sin(angle);\n")
    p = bf16_cstr_append(buf, p, "        float r0 = x0 * cos_a - x1 * sin_a; float r1 = x1 * cos_a + x0 * sin_a;\n")
    p = bf16_cstr_append(buf, p, "        vec[j] = r0; vec[j + hdim] = r1;\n")
    p = bf16_cstr_append(buf, p, "        if (write_kv) {\n")
    p = bf16_cstr_append(buf, p, "            k_dst[kv_head_base + j] = r0; k_dst[kv_head_base + j + hdim] = r1;\n")
    p = bf16_cstr_append(buf, p, "            v_dst[kv_head_base + j] = v_head[j]; v_dst[kv_head_base + j + hdim] = v_head[j + hdim];\n")
    p = bf16_cstr_append(buf, p, "        }\n    }\n}\n\n")

    // 17. qwen3_qk_norm_rope_kv_scatter_bf16 (F2)
    p = bf16_cstr_append(buf, p, "kernel void qwen3_qk_norm_rope_kv_scatter_bf16(\n")
    p = bf16_cstr_append(buf, p, "    device uchar* q_base [[buffer(0)]], device uchar* k_base [[buffer(1)]],\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* v_base [[buffer(2)]], device const uchar* qw_base [[buffer(3)]],\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* kw_base [[buffer(4)]], device uchar* kv_base [[buffer(5)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& q_off [[buffer(6)]], constant ulong& k_off [[buffer(7)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& v_off [[buffer(8)]], constant ulong& qw_off [[buffer(9)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& kw_off [[buffer(10)]], constant ulong& table_off [[buffer(11)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& k_layer_off [[buffer(12)]], constant ulong& v_layer_off [[buffer(13)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& n_q [[buffer(14)]], constant ulong& n_kv [[buffer(15)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& head_dim [[buffer(16)]], constant ulong& pos [[buffer(17)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& block_size [[buffer(18)]], constant ulong& eps_bits [[buffer(19)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& theta_bits [[buffer(20)]], uint gid [[thread_position_in_grid]], uint lane [[thread_index_in_simdgroup]]) {\n")
    p = bf16_cstr_append(buf, p, "    ulong g = (ulong)gid >> 5;\n")
    p = bf16_cstr_append(buf, p, "    if (g >= n_q + n_kv || head_dim < 2 || block_size == 0) return;\n")
    p = bf16_cstr_append(buf, p, "    bool is_k = (g >= n_q); ulong kh = is_k ? (g - n_q) : 0ul;\n")
    p = bf16_cstr_append(buf, p, "    device float* vec = is_k ? ((device float*)(k_base + k_off) + kh * head_dim) : ((device float*)(q_base + q_off) + g * head_dim);\n")
    p = bf16_cstr_append(buf, p, "    device const float* v_head = (device const float*)(v_base + v_off) + kh * head_dim;\n")
    p = bf16_cstr_append(buf, p, "    device const ushort* w_bf16 = is_k ? (device const ushort*)(kw_base + kw_off) : (device const ushort*)(qw_base + qw_off);\n")
    p = bf16_cstr_append(buf, p, "    qwen3_qk_norm_rope_scatter_head(vec, v_head, w_bf16, (device const float*)w_bf16, true, kv_base, table_off, k_layer_off, v_layer_off, n_kv, kh, head_dim, pos, block_size, as_type<float>((uint)eps_bits), as_type<float>((uint)theta_bits), lane, is_k);\n")
    p = bf16_cstr_append(buf, p, "}\n\n")

    // 18. qwen3_qk_norm_rope_kv_scatter_f32 (F2)
    p = bf16_cstr_append(buf, p, "kernel void qwen3_qk_norm_rope_kv_scatter_f32(\n")
    p = bf16_cstr_append(buf, p, "    device uchar* q_base [[buffer(0)]], device uchar* k_base [[buffer(1)]],\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* v_base [[buffer(2)]], device const uchar* qw_base [[buffer(3)]],\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* kw_base [[buffer(4)]], device uchar* kv_base [[buffer(5)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& q_off [[buffer(6)]], constant ulong& k_off [[buffer(7)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& v_off [[buffer(8)]], constant ulong& qw_off [[buffer(9)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& kw_off [[buffer(10)]], constant ulong& table_off [[buffer(11)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& k_layer_off [[buffer(12)]], constant ulong& v_layer_off [[buffer(13)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& n_q [[buffer(14)]], constant ulong& n_kv [[buffer(15)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& head_dim [[buffer(16)]], constant ulong& pos [[buffer(17)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& block_size [[buffer(18)]], constant ulong& eps_bits [[buffer(19)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& theta_bits [[buffer(20)]], uint gid [[thread_position_in_grid]], uint lane [[thread_index_in_simdgroup]]) {\n")
    p = bf16_cstr_append(buf, p, "    ulong g = (ulong)gid >> 5;\n")
    p = bf16_cstr_append(buf, p, "    if (g >= n_q + n_kv || head_dim < 2 || block_size == 0) return;\n")
    p = bf16_cstr_append(buf, p, "    bool is_k = (g >= n_q); ulong kh = is_k ? (g - n_q) : 0ul;\n")
    p = bf16_cstr_append(buf, p, "    device float* vec = is_k ? ((device float*)(k_base + k_off) + kh * head_dim) : ((device float*)(q_base + q_off) + g * head_dim);\n")
    p = bf16_cstr_append(buf, p, "    device const float* v_head = (device const float*)(v_base + v_off) + kh * head_dim;\n")
    p = bf16_cstr_append(buf, p, "    device const float* w_f32 = is_k ? (device const float*)(kw_base + kw_off) : (device const float*)(qw_base + qw_off);\n")
    p = bf16_cstr_append(buf, p, "    qwen3_qk_norm_rope_scatter_head(vec, v_head, (device const ushort*)w_f32, w_f32, false, kv_base, table_off, k_layer_off, v_layer_off, n_kv, kh, head_dim, pos, block_size, as_type<float>((uint)eps_bits), as_type<float>((uint)theta_bits), lane, is_k);\n")
    p = bf16_cstr_append(buf, p, "}\n\n")

    // 19. qwen3_add_rmsnorm_bf16 (F4a)
    p = bf16_cstr_append(buf, p, "kernel void qwen3_add_rmsnorm_bf16(\n")
    p = bf16_cstr_append(buf, p, "    device uchar* x_base [[buffer(0)]], device const uchar* h_base [[buffer(1)]],\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* w_base [[buffer(2)]], device uchar* out_base [[buffer(3)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& x_off [[buffer(4)]], constant ulong& h_off [[buffer(5)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& w_off [[buffer(6)]], constant ulong& out_off [[buffer(7)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& dim [[buffer(8)]], constant ulong& eps_bits [[buffer(9)]],\n")
    p = bf16_cstr_append(buf, p, "    uint tid [[thread_index_in_threadgroup]]) {\n")
    p = bf16_cstr_append(buf, p, "    if (dim == 0) return;\n")
    p = bf16_cstr_append(buf, p, "    threadgroup float tg_sq[8]; threadgroup float tg_inv;\n")
    p = bf16_cstr_append(buf, p, "    device float* x = (device float*)(x_base + x_off);\n")
    p = bf16_cstr_append(buf, p, "    device const float* h = (device const float*)(h_base + h_off);\n")
    p = bf16_cstr_append(buf, p, "    device const ushort* w = (device const ushort*)(w_base + w_off);\n")
    p = bf16_cstr_append(buf, p, "    device float* out = (device float*)(out_base + out_off);\n")
    p = bf16_cstr_append(buf, p, "    float sq = 0.0f;\n")
    p = bf16_cstr_append(buf, p, "    for (ulong i = (ulong)tid; i < dim; i = i + 256ul) { float v = x[i] + h[i]; x[i] = v; sq = fma(v, v, sq); }\n")
    p = bf16_cstr_append(buf, p, "    sq = simd_sum(sq); if ((tid & 31u) == 0u) tg_sq[tid >> 5] = sq;\n")
    p = bf16_cstr_append(buf, p, "    threadgroup_barrier(mem_flags::mem_threadgroup);\n")
