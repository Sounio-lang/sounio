pub fn qwen3_metal_encode_gemm(
    s: &MetalSession,
    cid: i64,
    pipe: i64,
    w_buf: i64,
    w_byte_off: i64,
    x_buf: i64,
    x_byte_off: i64,
    y_buf: i64,
    y_byte_off: i64,
    out_dim: i64,
    in_dim: i64,
    n_toks: i64
) -> i64 {
    if !s.ok || cid <= 0 || pipe <= 0 || out_dim <= 0 || in_dim <= 0 || n_toks <= 0 || n_toks > 8 { return -1 }
    if metal_cmd_set_buf(s, cid, 0, w_buf, 0) != 0
        || metal_cmd_set_u64(s, cid, 1, w_byte_off) != 0
        || metal_cmd_set_buf(s, cid, 2, x_buf, 0) != 0
        || metal_cmd_set_u64(s, cid, 3, x_byte_off) != 0
        || metal_cmd_set_buf(s, cid, 4, y_buf, 0) != 0
        || metal_cmd_set_u64(s, cid, 5, y_byte_off) != 0
        || metal_cmd_set_u64(s, cid, 6, out_dim) != 0
        || metal_cmd_set_u64(s, cid, 7, in_dim) != 0
        || metal_cmd_set_u64(s, cid, 8, n_toks) != 0 {
        return -1
    }
    let n_groups = (out_dim + 15) / 16
    let total_threads = n_groups * 256
    if metal_cmd_dispatch_1d(s, cid, pipe, total_threads, 256) != 0 {
        return -1
    }
    0
}

pub fn qwen3_metal_gemm(
    s: &MetalSession,
    pipes: &Qwen3MetalPipelines,
    w_buf: i64,
    w_byte_off: i64,
    w_dtype: i32,
    x_buf: i64,
    x_byte_off: i64,
    y_buf: i64,
    y_byte_off: i64,
    out_dim: i64,
    in_dim: i64,
    n_toks: i64
) -> i64 {
    if !pipes.ok || out_dim <= 0 || in_dim <= 0 || n_toks <= 0 || n_toks > 8 { return -1 }
    let pipe = if w_dtype == 2 { pipes.gemm_bf16 } else { pipes.gemm_f32 }
    if pipe <= 0 { return -1 }
    let cid = metal_cmd_begin(s)
    if cid <= 0 { return -1 }
    if qwen3_metal_encode_gemm(s, cid, pipe, w_buf, w_byte_off, x_buf, x_byte_off, y_buf, y_byte_off, out_dim, in_dim, n_toks) != 0 {
        let _c = metal_cmd_cancel(s, cid)
        return -1
    }
    metal_cmd_commit_sync(s, cid)
}

pub fn qwen3_metal_encode_rope_batch(
    s: &MetalSession,
    cid: i64,
    pipe: i64,
    vec_buf: i64,
    vec_byte_off: i64,
    n_heads: i64,
    head_dim: i64,
    pos_start: i64,
    theta_f32_bits: i64,
    n_toks: i64
) -> i64 {
    if !s.ok || cid <= 0 || pipe <= 0 || n_heads <= 0 || head_dim <= 0 || n_toks <= 0 || pos_start < 0 { return -1 }
    if metal_cmd_set_buf(s, cid, 0, vec_buf, 0) != 0
        || metal_cmd_set_u64(s, cid, 1, vec_byte_off) != 0
        || metal_cmd_set_u64(s, cid, 2, n_heads) != 0
        || metal_cmd_set_u64(s, cid, 3, head_dim) != 0
        || metal_cmd_set_u64(s, cid, 4, pos_start) != 0
        || metal_cmd_set_u64(s, cid, 5, theta_f32_bits) != 0
        || metal_cmd_set_u64(s, cid, 6, n_toks) != 0 {
        return -1
    }
    let hdim = head_dim / 2
    let total_threads = n_toks * n_heads * hdim
    let group_threads = if total_threads < 64 { total_threads } else { 64 }
    if metal_cmd_dispatch_1d(s, cid, pipe, total_threads, group_threads) != 0 {
        return -1
    }
    0
}

pub fn qwen3_metal_encode_kv_scatter_batch(
    s: &MetalSession,
    cid: i64,
    pipe: i64,
    k_src_buf: i64,
    k_src_off: i64,
    v_src_buf: i64,
    v_src_off: i64,
    kv_buf: i64,
    table_off: i64,
    k_layer_off: i64,
    v_layer_off: i64,
    n_kv_dim: i64,
    pos_start: i64,
    n_toks: i64,
    block_size: i64
) -> i64 {
    if !s.ok || cid <= 0 || pipe <= 0 || n_kv_dim <= 0 || n_toks <= 0 || pos_start < 0 || block_size <= 0 { return -1 }
    let packed = (n_toks << 32) | (pos_start & 4294967295)
    if metal_cmd_set_buf(s, cid, 0, k_src_buf, 0) != 0
        || metal_cmd_set_u64(s, cid, 1, k_src_off) != 0
        || metal_cmd_set_buf(s, cid, 2, v_src_buf, 0) != 0
        || metal_cmd_set_u64(s, cid, 3, v_src_off) != 0
        || metal_cmd_set_buf(s, cid, 4, kv_buf, 0) != 0
        || metal_cmd_set_u64(s, cid, 5, table_off) != 0
        || metal_cmd_set_u64(s, cid, 6, k_layer_off) != 0
        || metal_cmd_set_u64(s, cid, 7, v_layer_off) != 0
        || metal_cmd_set_u64(s, cid, 8, n_kv_dim) != 0
        || metal_cmd_set_u64(s, cid, 9, packed) != 0
        || metal_cmd_set_u64(s, cid, 10, block_size) != 0 {
        return -1
    }
    let total_threads = n_toks * n_kv_dim
    let group_threads = if total_threads < 64 { total_threads } else { 64 }
    if metal_cmd_dispatch_1d(s, cid, pipe, total_threads, group_threads) != 0 {
        return -1
    }
    0
}

