    p = bf16_cstr_append(buf, p, "            if (has1) acc1 = fma(as_type<float>(((uint)c1[kt]) << 16), xt, acc1);\n")
    p = bf16_cstr_append(buf, p, "            if (has2) acc2 = fma(as_type<float>(((uint)c2[kt]) << 16), xt, acc2);\n")
    p = bf16_cstr_append(buf, p, "            if (has3) acc3 = fma(as_type<float>(((uint)c3[kt]) << 16), xt, acc3);\n")
    p = bf16_cstr_append(buf, p, "        }\n")
    p = bf16_cstr_append(buf, p, "        threadgroup_barrier(mem_flags::mem_threadgroup);\n")
    p = bf16_cstr_append(buf, p, "    }\n")
    p = bf16_cstr_append(buf, p, "    if (has0) { float s0 = simd_sum(acc0); if (lane == 0) dst0[lr0] = s0; }\n")
    p = bf16_cstr_append(buf, p, "    if (has1) { float s1 = simd_sum(acc1); if (lane == 0) dst1[lr1] = s1; }\n")
    p = bf16_cstr_append(buf, p, "    if (has2) { float s2 = simd_sum(acc2); if (lane == 0) dst2[lr2] = s2; }\n")
    p = bf16_cstr_append(buf, p, "    if (has3) { float s3 = simd_sum(acc3); if (lane == 0) dst3[lr3] = s3; }\n}\n\n")

    // 22. qwen3_gemv_bf16_gate_up_swiglu (F3-BF16: swizzled tg_x4[288] + 4-way simultaneous scalar reuse + 1-add tree)
    p = bf16_cstr_append(buf, p, "kernel void qwen3_gemv_bf16_gate_up_swiglu(\n")
