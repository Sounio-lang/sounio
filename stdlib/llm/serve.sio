//! stdlib::llm::serve - OpenAI-compatible HTTP front-end (Plan J rewrite).
//! Session slots pumped by one select loop, one KvCache per session,
//! SSE streaming, temperature/top-p params. Overlap is an interleaved
//! event loop (no thread primitives exist): at most one token per
//! active session per pump turn, so GPU calls never overlap.
extern "C" {
    fn dlsym(handle: *mut u8, symbol: *mut u8) -> *mut u8
}
use hetero::net_worker::{NwLib, nw_accept, nw_close, nw_listen, nw_open, nw_send_all}
use hetero::probe_cuda::{pb_cstr}
use hetero::runtime::{Runtime}
use llm::attn_gpu::{llama_sample_greedy, llama_sample_temp_top_p}
use llm::bpe::{Bpe, bpe_decode_token, bpe_encode}
use llm::llama::{Llama, KvCache, kv_new, llama_forward, llama_forward_rt}
use llm::safetensors::{st_byte_at}
use tensor2::cpu_kernel::{CpuBuf, ck_alloc, ck_get, ck_set}

pub const SV_MAX_SESS: i64 = 4

fn sv_putb(buf: *mut u8, i: i64, v: i64) with Mut {
    let w = read_i64(buf as *mut i64, i / 8)
    let sh = (i % 8) * 8
    let cleared = w & ((0 - 1) - (255 << sh))
    write_i64(buf as *mut i64, i / 8, cleared | ((v & 255) << sh))
}

fn sv_byte(data: *mut u8, i: i64) -> i64 {
    (read_i64(data as *mut i64, i / 8) >> ((i % 8) * 8)) & 255
}

fn sv_app_str(out: *mut u8, pos: i64, s: string) -> i64 with Mut {
    var p = pos
    var i: i64 = 0
    while i < str_len(s) {
        sv_putb(out, p, str_char_at(s, i) & 255)
        p = p + 1
        i = i + 1
    }
    p
}
fn sv_app_int(out: *mut u8, pos: i64, v0: i64) -> i64 with Mut {
    var v = v0
    var p = pos
    if v < 0 {
        sv_putb(out, p, 45)
        p = p + 1
        v = 0 - v
    }
    let tmp = heap_alloc(32)
    var n: i64 = 0
    if v == 0 {
        sv_putb(tmp, 0, 48)
        n = 1
    }
    while v > 0 {
        sv_putb(tmp, n, 48 + (v % 10))
        v = v / 10
        n = n + 1
    }
    var i: i64 = 0
    while i < n {
        sv_putb(out, p, sv_byte(tmp, n - 1 - i))
        p = p + 1
        i = i + 1
    }
    p
}

fn sv_app_escaped(out: *mut u8, pos: i64, src: *mut u8, off: i64, len: i64) -> i64 with Mut {
    var p = pos
    var i: i64 = 0
    while i < len {
        let c = sv_byte(src, off + i)
        if c == 34 { p = sv_app_str(out, p, "\\\"") }
        else if c == 92 { p = sv_app_str(out, p, "\\\\") }
        else if c == 10 { p = sv_app_str(out, p, "\n") }
        else if c == 13 { p = sv_app_str(out, p, "\r") }
        else if c == 9 { p = sv_app_str(out, p, "\t") }
        else if c < 32 {
            sv_putb(out, p, 92); p = p + 1
            p = sv_app_str(out, p, "u00")
            let hex = "0123456789abcdef"
            sv_putb(out, p, str_char_at(hex, (c >> 4) & 15))
            p = p + 1
            sv_putb(out, p, str_char_at(hex, c & 15))
            p = p + 1
        } else {
            sv_putb(out, p, c)
            p = p + 1
        }
        i = i + 1
    }
    p
}
fn sv_find(data: *mut u8, len: i64, from: i64, pat: string) -> i64 with Mut {
    let plen = str_len(pat)
    var i: i64 = from
    while i + plen <= len {
        var ok = true
        var j: i64 = 0
        while j < plen {
            if sv_byte(data, i + j) != (str_char_at(pat, j) & 255) { ok = false; j = plen }
            j = j + 1
        }
        if ok { return i }
        i = i + 1
    }
    0 - 1
}

fn sv_starts(data: *mut u8, len: i64, off: i64, pat: string) -> bool with Mut {
    if off + str_len(pat) > len { return false }
    var j: i64 = 0
    while j < str_len(pat) {
        if sv_byte(data, off + j) != (str_char_at(pat, j) & 255) { return false }
        j = j + 1
    }
    true
}

fn sv_int(data: *mut u8, len: i64, from: i64) -> [i64; 3] with Mut {
    var i: i64 = from
    while i < len && sv_byte(data, i) != 45 && (sv_byte(data, i) < 48 || sv_byte(data, i) > 57) { i = i + 1 }
    var r: [i64; 3] = [0, 0, 0]
    if i >= len { r[1] = i; return r }
    var neg: i64 = 1
    if sv_byte(data, i) == 45 { neg = 0 - 1; i = i + 1 }
    var v: i64 = 0
    var any: i64 = 0
    while i < len && sv_byte(data, i) >= 48 && sv_byte(data, i) <= 57 {
        v = v * 10 + (sv_byte(data, i) - 48)
        any = 1
        i = i + 1
    }
    r[0] = v * neg
    r[1] = i
    r[2] = any
    r
}
fn sv_float(data: *mut u8, len: i64, from: i64) -> [f64; 2] with Mut, Div, Panic {
    var i: i64 = from
    while i < len && sv_byte(data, i) != 45 && (sv_byte(data, i) < 48 || sv_byte(data, i) > 57) { i = i + 1 }
    var neg = 1.0
    if i < len && sv_byte(data, i) == 45 { neg = 0.0 - 1.0; i = i + 1 }
    var v = 0.0
    while i < len && sv_byte(data, i) >= 48 && sv_byte(data, i) <= 57 {
        v = v * 10.0 + ((sv_byte(data, i) - 48) as f64)
        i = i + 1
    }
    if i < len && sv_byte(data, i) == 46 {
        i = i + 1
        var scale = 0.1
        while i < len && sv_byte(data, i) >= 48 && sv_byte(data, i) <= 57 {
            v = v + ((sv_byte(data, i) - 48) as f64) * scale
            scale = scale * 0.1
            i = i + 1
        }
    }
    var r: [f64; 2] = [0.0, 0.0]
    r[0] = v * neg
    r[1] = i as f64
    r
}

fn sv_jstr(data: *mut u8, len: i64, q: i64, out: *mut u8, off: i64) -> [i64; 2] with Mut {
    var n: i64 = 0
    var i: i64 = q + 1
    while i < len && sv_byte(data, i) != 34 && n < 60000 {
        let c = sv_byte(data, i)
        if c == 92 && i + 1 < len {
            let e = sv_byte(data, i + 1)
            if e == 110 { sv_putb(out, off + n, 10); n = n + 1; i = i + 2 }
            else if e == 116 { sv_putb(out, off + n, 9); n = n + 1; i = i + 2 }
            else if e == 114 { sv_putb(out, off + n, 13); n = n + 1; i = i + 2 }
            else if e == 117 {
                var cp: i64 = 0
                var k: i64 = 0
                while k < 4 {
                    let h = sv_byte(data, i + 2 + k)
                    var d: i64 = 0
                    if h >= 48 && h <= 57 { d = h - 48 }
                    else if h >= 97 && h <= 102 { d = h - 87 }
                    else if h >= 65 && h <= 70 { d = h - 55 }
                    cp = cp * 16 + d
                    k = k + 1
                }
                if cp < 128 { sv_putb(out, off + n, cp); n = n + 1 }
                else if cp < 2048 {
                    sv_putb(out, off + n, 192 | (cp >> 6)); n = n + 1
                    sv_putb(out, off + n, 128 | (cp & 63)); n = n + 1
                } else {
                    sv_putb(out, off + n, 224 | (cp >> 12)); n = n + 1
                    sv_putb(out, off + n, 128 | ((cp >> 6) & 63)); n = n + 1
                    sv_putb(out, off + n, 128 | (cp & 63)); n = n + 1
                }
                i = i + 6
            } else { sv_putb(out, off + n, e); n = n + 1; i = i + 2 }
        } else {
            sv_putb(out, off + n, c)
            n = n + 1
            i = i + 1
        }
    }
    var r: [i64; 2] = [0, 0]
    r[0] = n
    r[1] = i + 1
    r
}
fn sv_err_body(buf: *mut u8, msg: string) -> i64 with Mut {
    var p: i64 = 0
    p = sv_app_str(buf, p, "{\"error\":{\"message\":\"")
    p = sv_app_str(buf, p, msg)
    p = sv_app_str(buf, p, "\",\"type\":\"invalid_request_error\"}}")
    p
}

fn sv_reply(lib: &NwLib, fd: i64, status: string, body: *mut u8, blen: i64) with Alloc, Mut, Panic {
    let out = heap_alloc(69632)
    var p: i64 = 0
    p = sv_app_str(out, p, "HTTP/1.1 ")
    p = sv_app_str(out, p, status)
    p = sv_app_str(out, p, "\r\nContent-Type: application/json\r\nContent-Length: ")
    p = sv_app_int(out, p, blen)
    p = sv_app_str(out, p, "\r\nConnection: close\r\n\r\n")
    var i: i64 = 0
    while i < blen {
        sv_putb(out, p, sv_byte(body, i))
        p = p + 1
        i = i + 1
    }
    let _s = nw_send_all(lib, fd, out, p)
}

// monotonic nanoseconds via libc clock_gettime; 0 when unavailable.
pub fn sv_now_ns(lib: &NwLib) -> i64 with Alloc, Mut {
    let raw = dlsym(lib.libc, pb_cstr("clock_gettime"))
    if (raw as i64) == 0 { return 0 }
    let f = raw as fn(i64, *mut u8) -> i64
    let ts = heap_alloc(16)
    if f(1, ts) != 0 { return 0 }
    read_i64(ts as *mut i64, 0) * 1000000000 + read_i64(ts as *mut i64, 1)
}
fn sv_fd_zero(set: *mut u8) with Mut {
    var i: i64 = 0
    while i < 16 {
        write_i64(set as *mut i64, i, 0)
        i = i + 1
    }
}

fn sv_fd_set(set: *mut u8, fd: i64) with Mut {
    if fd < 0 || fd >= 1024 { return }
    let w = fd / 64
    let b = fd % 64
    write_i64(set as *mut i64, w, read_i64(set as *mut i64, w) | (1 << b))
}

fn sv_fd_isset(set: *mut u8, fd: i64) -> bool with Mut {
    if fd < 0 || fd >= 1024 { return false }
    let w = fd / 64
    let b = fd % 64
    (read_i64(set as *mut i64, w) & (1 << b)) != 0
}
// select() readable wait over fds[0..nfds). ready count, 0 on
// timeout, -1 when select is unavailable.
fn sv_select(lib: &NwLib, fds: &[i64; 8], nfds: i64, timeout_us: i64) -> i64 with Alloc, Mut {
    let raw = dlsym(lib.libc, pb_cstr("select"))
    if (raw as i64) == 0 { return 0 - 1 }
    let f = raw as fn(i64, *mut u8, *mut u8, *mut u8, *mut u8) -> i64
    let set = heap_alloc(128)
    sv_fd_zero(set)
    var mx: i64 = 0
    var i: i64 = 0
    while i < nfds {
        if fds[i as usize] >= 0 {
            sv_fd_set(set, fds[i as usize])
            if fds[i as usize] > mx { mx = fds[i as usize] }
        }
        i = i + 1
    }
    let tv = heap_alloc(16)
    write_i64(tv as *mut i64, 0, timeout_us / 1000000)
    write_i64(tv as *mut i64, 1, (timeout_us % 1000000) * 1000)
    f(mx + 1, set, 0 as *mut u8, 0 as *mut u8, tv)
}

// one recv shot: caller selects first, so data waits.
fn sv_recv_some(lib: &NwLib, fd: i64, buf: *mut u8, cap: i64) -> i64 with Alloc, Mut {
    let raw = dlsym(lib.libc, pb_cstr("recv"))
    if (raw as i64) == 0 { return 0 - 1 }
    let f = raw as fn(i64, *mut u8, i64, i32) -> i64
    f(fd, buf, cap, 0)
}
// params from a completions JSON body. out len 5: temp, top_p, seed,
// max_tokens, stream. 0 ok; 1 bad temperature; 2 bad top_p.
pub fn sv_parse_params(buf: *mut u8, n: i64, boff: i64, out: &!CpuBuf) -> i64 with Mut, Div, Panic {
    ck_set(out, 0, 0.0)
    ck_set(out, 1, 1.0)
    ck_set(out, 2, 12345.0)
    ck_set(out, 3, 16.0)
    ck_set(out, 4, 0.0)
    let tp = sv_find(buf, n, boff, "\"temperature\"")
    if tp >= 0 {
        let fv = sv_float(buf, n, tp + 13)
        if fv[0] < 0.0 { return 1 }
        ck_set(out, 0, fv[0])
    }
    let pp = sv_find(buf, n, boff, "\"top_p\"")
    if pp >= 0 {
        let fv = sv_float(buf, n, pp + 7)
        if fv[0] <= 0.0 || fv[0] > 1.0 { return 2 }
        ck_set(out, 1, fv[0])
    }
    let sp = sv_find(buf, n, boff, "\"seed\"")
    if sp >= 0 {
        let iv = sv_int(buf, n, sp + 6)
        if iv[2] == 1 { ck_set(out, 2, iv[0] as f64) }
    }
    let mt = sv_find(buf, n, boff, "\"max_tokens\"")
    if mt >= 0 {
        let iv = sv_int(buf, n, mt + 12)
        if iv[2] == 1 {
            var mx = iv[0]
            if mx < 1 { mx = 1 }
            if mx > 256 { mx = 256 }
            ck_set(out, 3, mx as f64)
        }
    }
    let st = sv_find(buf, n, boff, "\"stream\"")
    if st >= 0 {
        if sv_find(buf, n, st, "true") == st + 10 { ck_set(out, 4, 1.0) }
    }
    0
}

// one SSE token frame. returns new pos.
pub fn sv_sse_token(out: *mut u8, pos: i64, req: i64, model: string, text: *mut u8, tlen: i64) -> i64 with Mut {
    var p = sv_app_str(out, pos, "data: {\"id\":\"cmpl-sounio-")
    p = sv_app_int(out, p, req)
    p = sv_app_str(out, p, "\",\"object\":\"text_completion.chunk\",\"created\":")
    p = sv_app_int(out, p, req)
    p = sv_app_str(out, p, ",\"model\":\"")
    p = sv_app_str(out, p, model)
    p = sv_app_str(out, p, "\",\"choices\":[{\"text\":\"")
    p = sv_app_escaped(out, p, text, 0, tlen)
    p = sv_app_str(out, p, "\",\"index\":0,\"finish_reason\":null}]}\n\n")
    p
}

pub fn sv_sse_done(out: *mut u8, pos: i64) -> i64 with Mut {
    sv_app_str(out, pos, "data: [DONE]\n\n")
}
fn kv_empty() -> KvCache {
    KvCache {
        k: [CpuBuf { data: 0 as *mut f64, len: 0 }; 64],
        v: [CpuBuf { data: 0 as *mut f64, len: 0 }; 64],
        len: 0, cap: 0,
    }
}

// total request bytes needed: -1 while headers/body incomplete.
// GET completes at headers end; otherwise Content-Length rules.
fn sv_need_total(buf: *mut u8, rlen: i64) -> i64 with Mut {
    var hend: i64 = 0 - 1
    var i: i64 = 0
    while i + 3 < rlen {
        if sv_byte(buf, i) == 13 && sv_byte(buf, i + 1) == 10 && sv_byte(buf, i + 2) == 13 && sv_byte(buf, i + 3) == 10 { hend = i + 4; i = rlen }
        i = i + 1
    }
    if hend < 0 { return 0 - 1 }
    if sv_starts(buf, rlen, 0, "GET ") { return hend }
    var cl: i64 = 0
    let cp1 = sv_find(buf, rlen, 0, "Content-Length")
    let cp2 = sv_find(buf, rlen, 0, "content-length")
    var cpos = cp1
    if cpos < 0 { cpos = cp2 }
    if cpos >= 0 {
        let colon = sv_find(buf, rlen, cpos, ":")
        let iv = sv_int(buf, rlen, colon + 1)
        if iv[2] == 1 { cl = iv[0] }
    }
    if cl < 0 { cl = 0 }
    hend + cl
}
// prompt ids from a completions body. returns nids, or -1 and err:
// 1 missing prompt, 2 array of strings, 3 bad prompt type, 4 empty.
fn sv_parse_ids(buf: *mut u8, n: i64, boff: i64, bp: &Bpe, ids: &!CpuBuf) -> i64 with Alloc, Mut, Panic, Div {
    let pp = sv_find(buf, n, boff, "\"prompt\"")
    if pp < 0 { return 0 - 1 }
    var colon = sv_find(buf, n, pp, ":")
    var vi = colon + 1
    while vi < n && (sv_byte(buf, vi) == 32 || sv_byte(buf, vi) == 9 || sv_byte(buf, vi) == 10 || sv_byte(buf, vi) == 13) { vi = vi + 1 }
    var nids: i64 = 0
    if sv_byte(buf, vi) == 34 {
        let scratch = heap_alloc(65536)
        let dec = sv_jstr(buf, n, vi, scratch, 0)
        let enc = bpe_encode(bp, scratch, dec[0])
        ck_set(ids, 0, 0.0)
        nids = 1
        var e: i64 = 0
        while e < enc.len && nids < 4000 {
            ck_set(ids, nids, ck_get(&enc, e))
            nids = nids + 1
            e = e + 1
        }
    } else if sv_byte(buf, vi) == 91 {
        var j = vi + 1
        var k = j
        while k < n && (sv_byte(buf, k) == 32 || sv_byte(buf, k) == 10) { k = k + 1 }
        if sv_byte(buf, k) == 34 { return 0 - 2 }
        while j < n && sv_byte(buf, j) != 93 && nids < 4000 {
            let iv = sv_int(buf, n, j)
            if iv[2] == 1 {
                ck_set(ids, nids, iv[0] as f64)
                nids = nids + 1
                j = iv[1]
            } else { j = j + 1 }
            while j < n && (sv_byte(buf, j) == 44 || sv_byte(buf, j) == 32 || sv_byte(buf, j) == 10) { j = j + 1 }
        }
    } else {
        return 0 - 3
    }
    if nids == 0 { return 0 - 4 }
    nids
}

fn sv_copy(dst: &!CpuBuf, src: &CpuBuf) with Mut {
    var i: i64 = 0
    while i < src.len && i < dst.len {
        ck_set(dst, i, ck_get(src, i))
        i = i + 1
    }
}

// non-stream completion body; byte format kept from serve v1.
pub fn sv_completion_body(body: *mut u8, req: i64, model: string, text: *mut u8, tlen: i64, finish: string, nids: i64, gen: i64) -> i64 with Mut {
    var p: i64 = 0
    p = sv_app_str(body, p, "{\"id\":\"cmpl-sounio-")
    p = sv_app_int(body, p, req)
    p = sv_app_str(body, p, "\",\"object\":\"text_completion\",\"created\":")
    p = sv_app_int(body, p, req)
    p = sv_app_str(body, p, ",\"model\":\"")
    p = sv_app_str(body, p, model)
    p = sv_app_str(body, p, "\",\"choices\":[{\"text\":\"")
    p = sv_app_escaped(body, p, text, 0, tlen)
    p = sv_app_str(body, p, "\",\"index\":0,\"logprobs\":null,\"finish_reason\":\"")
    p = sv_app_str(body, p, finish)
    p = sv_app_str(body, p, "\"}],\"usage\":{\"prompt_tokens\":")
    p = sv_app_int(body, p, nids)
    p = sv_app_str(body, p, ",\"completion_tokens\":")
    p = sv_app_int(body, p, gen)
    p = sv_app_str(body, p, ",\"total_tokens\":")
    p = sv_app_int(body, p, nids + gen)
    p = sv_app_str(body, p, "}}")
    p
}
// begin a session from a complete request head. returns 2 GEN,
// -1 close. fills ids/prm/seed/logi/kvs/nids/gen/t0 + headers.
fn sv_begin(
    lib: &NwLib, m: &!Llama, bp: &Bpe, rt: &Runtime, use_gpu: bool,
    model: string, fd: i64, req: i64, rbuf: *mut u8, rlen: i64,
    ids: &!CpuBuf, prm: &!CpuBuf, seed: &!CpuBuf, logi: &!CpuBuf,
    kvs: &![KvCache; 4], nids: &![i64; 4], gen: &![i64; 4], t0: &![i64; 4], si: i64
) -> i64 with Alloc, Mut, Panic, Div, IO {
    let body = heap_alloc(69632)
    if sv_starts(rbuf, rlen, 0, "GET /health") {
        var p: i64 = 0
        p = sv_app_str(body, p, "{\"status\":\"ok\",\"model\":\"")
        p = sv_app_str(body, p, model)
        p = sv_app_str(body, p, "\",\"engine\":\"sounio-llm\"}")
        sv_reply(lib, fd, "200 OK", body, p)
        return 0 - 1
    }
    if sv_starts(rbuf, rlen, 0, "GET /v1/models") {
        var p: i64 = 0
        p = sv_app_str(body, p, "{\"object\":\"list\",\"data\":[{\"id\":\"")
        p = sv_app_str(body, p, model)
        p = sv_app_str(body, p, "\",\"object\":\"model\",\"owned_by\":\"sounio\"}]}")
        sv_reply(lib, fd, "200 OK", body, p)
        return 0 - 1
    }
    if !sv_starts(rbuf, rlen, 0, "POST /v1/completions") {
        let p = sv_err_body(body, "route not found (v1: GET /health, GET /v1/models, POST /v1/completions)")
        sv_reply(lib, fd, "404 Not Found", body, p)
        return 0 - 1
    }
    var boff: i64 = 0
    var i: i64 = 0
    while i + 3 < rlen {
        if sv_byte(rbuf, i) == 13 && sv_byte(rbuf, i + 1) == 10 && sv_byte(rbuf, i + 2) == 13 && sv_byte(rbuf, i + 3) == 10 { boff = i + 4; i = rlen }
        i = i + 1
    }
    let ps = sv_parse_params(rbuf, rlen, boff, prm)
    if ps == 1 {
        let p = sv_err_body(body, "temperature must be >= 0")
        sv_reply(lib, fd, "400 Bad Request", body, p)
        return 0 - 1
    }
    if ps == 2 {
        let p = sv_err_body(body, "top_p must be in (0, 1]")
        sv_reply(lib, fd, "400 Bad Request", body, p)
        return 0 - 1
    }
    let ni = sv_parse_ids(rbuf, rlen, boff, bp, ids)
    if ni == 0 - 1 {
        let p = sv_err_body(body, "missing prompt")
        sv_reply(lib, fd, "400 Bad Request", body, p)
        return 0 - 1
    }
    if ni == 0 - 2 {
        let p = sv_err_body(body, "prompt as array of strings is not supported; use a string or token ids")
        sv_reply(lib, fd, "400 Bad Request", body, p)
        return 0 - 1
    }
    if ni == 0 - 3 {
        let p = sv_err_body(body, "prompt must be a string or an array of token ids")
        sv_reply(lib, fd, "400 Bad Request", body, p)
        return 0 - 1
    }
    if ni <= 0 {
        let p = sv_err_body(body, "empty prompt")
        sv_reply(lib, fd, "400 Bad Request", body, p)
        return 0 - 1
    }
    var max_tokens = ck_get(prm, 3) as i64
    var cap: i64 = ni + max_tokens + 8
    if cap > 4096 { cap = 4096 }
    if ni + max_tokens > cap { max_tokens = cap - ni }
    ck_set(prm, 3, max_tokens as f64)
    nids[si as usize] = ni
    gen[si as usize] = 0
    t0[si as usize] = sv_now_ns(lib)
    kvs[si as usize] = kv_new(m, cap)
    var lg = ck_alloc(1)
    if use_gpu && rt.ready {
        lg = llama_forward_rt(m, &!kvs[si as usize], ids, ni, rt)
    } else {
        lg = llama_forward(m, &!kvs[si as usize], ids, ni)
    }
    sv_copy(logi, &lg)
    ck_set(seed, 0, ck_get(prm, 2))
    if ck_get(prm, 4) > 0.5 {
        let out = heap_alloc(512)
        var p: i64 = 0
        p = sv_app_str(out, p, "HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\nCache-Control: no-cache\r\nConnection: close\r\n\r\n")
        if nw_send_all(lib, fd, out, p) != 0 { return 0 - 1 }
    }
    2
}
// one decode step for slot si. 1 alive, 0 done, -1 transport error.
fn sv_turn(
    lib: &NwLib, m: &!Llama, bp: &Bpe, rt: &Runtime, use_gpu: bool,
    model: string, fd: i64, req: i64,
    logi: &!CpuBuf, kvs: &![KvCache; 4], seed: &!CpuBuf, prm: &!CpuBuf,
    text: *mut u8, tlen: &![i64; 4], gen: &![i64; 4],
    ttfb: &![i64; 4], t0: &![i64; 4], nids: &![i64; 4], si: i64
) -> i64 with Alloc, Mut, Panic, Div, IO {
    let temp = ck_get(prm, 0)
    var cur: i64 = 0
    if temp <= 0.0 {
        cur = llama_sample_greedy(logi)
    } else {
        cur = llama_sample_temp_top_p(logi, temp, ck_get(prm, 1), seed)
    }
    var finish = ""
    var done = false
    if cur == 0 { finish = "stop"; done = true }
    let tbuf = heap_alloc(8192)
    if !done {
        let nb = bpe_decode_token(bp, cur, tbuf)
        if ck_get(prm, 4) > 0.5 {
            let out = heap_alloc(69632)
            let p = sv_sse_token(out, 0, req, model, tbuf, nb)
            if nw_send_all(lib, fd, out, p) != 0 { return 0 - 1 }
        } else {
            var j: i64 = 0
            while j < nb && tlen[si as usize] < 60000 {
                sv_putb(text, tlen[si as usize], st_byte_at(tbuf, j))
                tlen[si as usize] = tlen[si as usize] + 1
                j = j + 1
            }
        }
        gen[si as usize] = gen[si as usize] + 1
        if ttfb[si as usize] == 0 { ttfb[si as usize] = sv_now_ns(lib) - t0[si as usize] }
        if gen[si as usize] >= ck_get(prm, 3) as i64 { finish = "length"; done = true }
    }
    if !done {
        var one = ck_alloc(1)
        ck_set(&!one, 0, cur as f64)
        var lg = ck_alloc(1)
        if use_gpu && rt.ready {
            lg = llama_forward_rt(m, &!kvs[si as usize], &one, 1, rt)
        } else {
            lg = llama_forward(m, &!kvs[si as usize], &one, 1)
        }
        sv_copy(logi, &lg)
        return 1
    }
    if ck_get(prm, 4) > 0.5 {
        let out = heap_alloc(64)
        let p = sv_sse_done(out, 0)
        if nw_send_all(lib, fd, out, p) != 0 { return 0 - 1 }
    } else {
        let body = heap_alloc(69632)
        let p = sv_completion_body(body, req, model, text, tlen[si as usize], finish, nids[si as usize], gen[si as usize])
        sv_reply(lib, fd, "200 OK", body, p)
    }
    print("served req=")
    print_int(req)
    print(" sess=")
    print_int(si)
    print(" prompt_tokens=")
    print_int(nids[si as usize])
    print(" completion_tokens=")
    print_int(gen[si as usize])
    print(" finish=")
    print(finish)
    print(" ttfb_us=")
    print_int(ttfb[si as usize] / 1000)
    print(" gpu=")
    print_int(if use_gpu && rt.ready { 1 } else { 0 })
    print("\n")
    0
}
// Serve forever over one select pump. 0 exit ok, negative on setup.
pub fn llm_serve(m: &!Llama, bp: &Bpe, port: i64, model_name: string, rt: &Runtime, use_gpu: bool) -> i64 with Alloc, Mut, Panic, Div, IO {
    let lib = nw_open()
    if !lib.ok { return 0 - 1 }
    let srv = nw_listen(&lib, port)
    if srv < 0 { return 0 - 2 }
    print("llm serve listening port=")
    print_int(port)
    print(" model=")
    print(model_name)
    print(" gpu=")
    print_int(if use_gpu && rt.ready { 1 } else { 0 })
    print("\n")
    var fd: [i64; 4] = [0 - 1; 4]
    var st: [i64; 4] = [0; 4]
    var rlen: [i64; 4] = [0; 4]
    var rbuf: [*mut u8; 4] = [0 as *mut u8; 4]
    var ids: [CpuBuf; 4] = [CpuBuf { data: 0 as *mut f64, len: 0 }; 4]
    var prm: [CpuBuf; 4] = [CpuBuf { data: 0 as *mut f64, len: 0 }; 4]
    var seed: [CpuBuf; 4] = [CpuBuf { data: 0 as *mut f64, len: 0 }; 4]
    var logi: [CpuBuf; 4] = [CpuBuf { data: 0 as *mut f64, len: 0 }; 4]
    var kvs: [KvCache; 4] = [kv_empty(); 4]
    var nids: [i64; 4] = [0; 4]
    var gen: [i64; 4] = [0; 4]
    var t0: [i64; 4] = [0; 4]
    var ttfb: [i64; 4] = [0; 4]
    var text: [*mut u8; 4] = [0 as *mut u8; 4]
    var tlen: [i64; 4] = [0; 4]
    var reqid: [i64; 4] = [0; 4]
    var req: i64 = 0
    var probe: [i64; 8] = [0 - 1; 8]
    while 1 == 1 {
        probe[0] = srv
        let acc = sv_select(&lib, &probe, 1, 0)
        if acc < 0 { print("serve: select unavailable\n"); return 0 - 3 }
        if acc > 0 {
            let conn = nw_accept(&lib, srv)
            if conn >= 0 {
                var slot: i64 = 0 - 1
                var s: i64 = 0
                while s < SV_MAX_SESS {
                    if fd[s as usize] < 0 { slot = s; s = SV_MAX_SESS }
                    s = s + 1
                }
                if slot < 0 {
                    nw_close(&lib, conn)
                } else {
                    fd[slot as usize] = conn
                    st[slot as usize] = 1
                    rlen[slot as usize] = 0
                    rbuf[slot as usize] = heap_alloc(262144)
                    ids[slot as usize] = ck_alloc(4096)
                    prm[slot as usize] = ck_alloc(5)
                    seed[slot as usize] = ck_alloc(1)
                    logi[slot as usize] = ck_alloc(m.cfg.vocab)
                    text[slot as usize] = heap_alloc(65536)
                    tlen[slot as usize] = 0
                    req = req + 1
                    reqid[slot as usize] = req
                }
            }
        }
        var any = false
        var s: i64 = 0
        while s < SV_MAX_SESS {
            if fd[s as usize] >= 0 {
                any = true
                if st[s as usize] == 1 {
                    probe[0] = fd[s as usize]
                    if sv_select(&lib, &probe, 1, 0) > 0 {
                        let got = sv_recv_some(&lib, fd[s as usize], (rbuf[s as usize] as i64 + rlen[s as usize]) as *mut u8, 262144 - rlen[s as usize])
                        if got <= 0 {
                            nw_close(&lib, fd[s as usize])
                            fd[s as usize] = 0 - 1
                            st[s as usize] = 0
                        } else {
                            rlen[s as usize] = rlen[s as usize] + got
                            let need = sv_need_total(rbuf[s as usize], rlen[s as usize])
                            if need >= 0 && rlen[s as usize] >= need {
                                let ns = sv_begin(&lib, m, bp, rt, use_gpu, model_name, fd[s as usize], reqid[s as usize], rbuf[s as usize], rlen[s as usize], &!ids[s as usize], &!prm[s as usize], &!seed[s as usize], &!logi[s as usize], &!kvs, &!nids, &!gen, &!t0, s)
                                if ns < 0 {
                                    nw_close(&lib, fd[s as usize])
                                    fd[s as usize] = 0 - 1
                                    st[s as usize] = 0
                                } else {
                                    st[s as usize] = ns
                                }
                            }
                            if rlen[s as usize] >= 262144 {
                                nw_close(&lib, fd[s as usize])
                                fd[s as usize] = 0 - 1
                                st[s as usize] = 0
                            }
                        }
                    }
                } else {
                    let tr = sv_turn(&lib, m, bp, rt, use_gpu, model_name, fd[s as usize], reqid[s as usize], &!logi[s as usize], &!kvs, &!seed[s as usize], &!prm[s as usize], text[s as usize], &!tlen, &!gen, &!ttfb, &!t0, &!nids, s)
                    if tr <= 0 {
                        nw_close(&lib, fd[s as usize])
                        fd[s as usize] = 0 - 1
                        st[s as usize] = 0
                    }
                }
            }
            s = s + 1
        }
        if !any {
            probe[0] = srv
            let _w = sv_select(&lib, &probe, 1, 50000)
        }
    }
    0
}
