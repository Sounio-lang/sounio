    if ok {
        let q4_base = page_arena_ptr(&q4_arena)
        let meta_base = page_arena_ptr(&meta_arena)
        var cur_q4_off: i64 = 0

        s = 0
        while s < total_slots {
            let is_lin = s == 2
            let rows = qwen3_model_tensor_rows(m, s)
            let cols = qwen3_model_tensor_cols(m, s)
            if is_lin && rows > 0 && cols > 0 {
                let n_blocks = (cols + 31) / 32
                let matrix_bytes = align_up_64(rows * n_blocks * bpb)
                let _qok = qwen3_eisa_quantize_slot(m, s, q4_base + cur_q4_off, rows, cols, bits)
                let _w0 = ptr_write_i64_le(meta_base, s * 32 + 0, cur_q4_off)
                let _w1 = ptr_write_i64_le(meta_base, s * 32 + 8, rows)
                let _w2 = ptr_write_i64_le(meta_base, s * 32 + 16, cols)
                let _w3 = ptr_write_i64_le(meta_base, s * 32 + 24, 1)
                cur_q4_off = cur_q4_off + matrix_bytes
            } else {
                let _w0 = ptr_write_i64_le(meta_base, s * 32 + 0, 0)
                let _w1 = ptr_write_i64_le(meta_base, s * 32 + 8, rows)
                let _w2 = ptr_write_i64_le(meta_base, s * 32 + 16, cols)
                let _w3 = ptr_write_i64_le(meta_base, s * 32 + 24, 0)
            }
            s = s + 1
        }
    }

    Qwen3EisaModel {
        q4_arena: q4_arena,
        meta_arena: meta_arena,
        b_q4: 0,
        eisa_pipes: eisa_metal_pipelines_empty(),
        n_slots: total_slots,
        quant_bits: bits,
        ok: ok,
    }
}

pub fn qwen3_forward_token_eisa_metal_opt(
    m: &Qwen3Model,
    em: &Qwen3EisaModel,
    kv: &!Qwen3PagedKv,
    rt: &Qwen3MetalRunner,
    token_id: i64,
    pos: i64,
    compute_logits: bool
) -> EisaArgmaxCert with Mut, Div, Panic {
    if !m.ok || !em.ok || !rt.ok || !qwen3_kv_is_ok(kv) || token_id < 0 || token_id >= m.cfg.vocab || pos < 0 {
        return eisa_certify_argmax(0, 0, 0, 0)
    }
    if !qwen3_kv_ensure_pos(kv, pos) {
        return eisa_certify_argmax(0, 0, 0, 0)
    }

    let a_base = page_arena_ptr(&m.arena)
    let buf_x = a_base + m.buf_x_off

    let emb_ptr = qwen3_model_tensor_host_ptr(m, 0)
    let emb_dt = qwen3_model_tensor_dtype(m, 0)
    let emb_elem_b = if emb_dt == 2 { 2 } else { 4 }
    let row_p = emb_ptr + token_id * m.cfg.hidden * emb_elem_b

    var i: i64 = 0
    while i < m.cfg.hidden {
        let v = if emb_dt == 2 {
            bf16_bits_to_f64_exact(ptr_read_u16_le(row_p, i * 2))
        } else {
            f32_bits_to_f64(ptr_read_u32_le(row_p, i * 4))
        }
        let _w = ptr_write_u32_le(buf_x, i * 4, f64_to_f32_bits(v))
        i = i + 1
    }

    let eps_bits = f64_to_f32_bits(m.cfg.eps)
    let theta_bits = f64_to_f32_bits(m.cfg.rope_theta)

    let cid = metal_cmd_begin(&rt.sess)
    if cid <= 0 { return eisa_certify_argmax(0, 0, 0, 0) }

    let meta_base = page_arena_ptr(&em.meta_arena)
    let gemv_pipe = if em.quant_bits == 8 { em.eisa_pipes.q8_gemv } else { em.eisa_pipes.q4_gemv }

    var l: i64 = 0
    while l < m.cfg.layers {
        let slot_base = 3 + l * 11

        let in_norm_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, slot_base + 0))
        let in_norm_off = qwen3_model_tensor_data_off(m, slot_base + 0)
        let in_norm_dt = qwen3_model_tensor_dtype(m, slot_base + 0)
        let in_norm_pipe = if in_norm_dt == 2 { rt.pipes.rmsnorm_bf16 } else { rt.pipes.rmsnorm_f32 }
        if qwen3_metal_encode_rmsnorm(
            &rt.sess, cid, in_norm_pipe,
            rt.b_work, m.buf_x_off,
            in_norm_s, in_norm_off,
            rt.b_work, m.buf_h_off,
            1, m.cfg.hidden, eps_bits
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return eisa_certify_argmax(0, 0, 0, 0)
        }

        let q_q4_off = ptr_read_i64_le(meta_base, (slot_base + 1) * 32 + 0)
        if qwen3_metal_encode_gemv_q4_eisa(
            &rt.sess, cid, gemv_pipe,
            em.b_q4, q_q4_off,
            rt.b_work, m.buf_h_off,
            rt.b_work, m.buf_q_off,
            rt.b_work, m.buf_tmp_err_off,
            m.cfg.n_q * m.cfg.head_dim, m.cfg.hidden
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return eisa_certify_argmax(0, 0, 0, 0)
        }

        let k_q4_off = ptr_read_i64_le(meta_base, (slot_base + 2) * 32 + 0)
        if qwen3_metal_encode_gemv_q4_eisa(
            &rt.sess, cid, gemv_pipe,
            em.b_q4, k_q4_off,
            rt.b_work, m.buf_h_off,
            rt.b_work, m.buf_k_off,
            rt.b_work, m.buf_tmp_err_off,
            m.cfg.n_kv * m.cfg.head_dim, m.cfg.hidden
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return eisa_certify_argmax(0, 0, 0, 0)
        }

        let v_q4_off = ptr_read_i64_le(meta_base, (slot_base + 3) * 32 + 0)
        if qwen3_metal_encode_gemv_q4_eisa(
            &rt.sess, cid, gemv_pipe,
            em.b_q4, v_q4_off,
            rt.b_work, m.buf_h_off,
            rt.b_work, m.buf_v_off,
            rt.b_work, m.buf_tmp_err_off,
            m.cfg.n_kv * m.cfg.head_dim, m.cfg.hidden
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return eisa_certify_argmax(0, 0, 0, 0)
        }

        let q_norm_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, slot_base + 5))
        let q_norm_off = qwen3_model_tensor_data_off(m, slot_base + 5)
        let q_norm_dt = qwen3_model_tensor_dtype(m, slot_base + 5)
        let q_norm_pipe = if q_norm_dt == 2 { rt.pipes.rmsnorm_bf16 } else { rt.pipes.rmsnorm_f32 }
        if qwen3_metal_encode_rmsnorm(
            &rt.sess, cid, q_norm_pipe,
            rt.b_work, m.buf_q_off,
            q_norm_s, q_norm_off,
            rt.b_work, m.buf_q_off,
            m.cfg.n_q, m.cfg.head_dim, eps_bits
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return eisa_certify_argmax(0, 0, 0, 0)
        }

        let k_norm_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, slot_base + 6))
        let k_norm_off = qwen3_model_tensor_data_off(m, slot_base + 6)
        let k_norm_dt = qwen3_model_tensor_dtype(m, slot_base + 6)
        let k_norm_pipe = if k_norm_dt == 2 { rt.pipes.rmsnorm_bf16 } else { rt.pipes.rmsnorm_f32 }
        if qwen3_metal_encode_rmsnorm(
            &rt.sess, cid, k_norm_pipe,
            rt.b_work, m.buf_k_off,
            k_norm_s, k_norm_off,
            rt.b_work, m.buf_k_off,
            m.cfg.n_kv, m.cfg.head_dim, eps_bits
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return eisa_certify_argmax(0, 0, 0, 0)
        }

        if qwen3_metal_encode_rope_table(
            &rt.sess, cid, rt.pipes.rope_table,
            rt.b_work, m.buf_q_off,
            rt.b_rope, pos * m.cfg.head_dim * 4,
            m.cfg.n_q, m.cfg.head_dim
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return eisa_certify_argmax(0, 0, 0, 0)
        }
        if qwen3_metal_encode_rope_table(
            &rt.sess, cid, rt.pipes.rope_table,
            rt.b_work, m.buf_k_off,
            rt.b_rope, pos * m.cfg.head_dim * 4,
            m.cfg.n_kv, m.cfg.head_dim
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return eisa_certify_argmax(0, 0, 0, 0)
        }

        if qwen3_metal_encode_kv_scatter(
            &rt.sess, cid, rt.pipes.kv_scatter,
            rt.b_work, m.buf_k_off,
            rt.b_work, m.buf_v_off,
            rt.b_kv,
            qwen3_kv_table_off(kv),
            qwen3_kv_k_layer_off(kv, l),
            qwen3_kv_v_layer_off(kv, l),
            m.cfg.n_kv * m.cfg.head_dim,
            pos,
            qwen3_kv_block_size(kv)
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return eisa_certify_argmax(0, 0, 0, 0)
        }

        if qwen3_metal_encode_paged_gqa(
            &rt.sess, cid, rt.pipes.paged_gqa,
            rt.b_work, m.buf_q_off,
            rt.b_kv,
            qwen3_kv_table_off(kv),
            qwen3_kv_k_layer_off(kv, l),
            qwen3_kv_v_layer_off(kv, l),
            rt.b_work, m.buf_attn_out_off,
            m.cfg.n_q, m.cfg.n_kv, m.cfg.head_dim,
            pos + 1,
            qwen3_kv_block_size(kv)
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return eisa_certify_argmax(0, 0, 0, 0)
        }

        let o_q4_off = ptr_read_i64_le(meta_base, (slot_base + 4) * 32 + 0)
        if qwen3_metal_encode_gemv_q4_eisa(
            &rt.sess, cid, gemv_pipe,
            em.b_q4, o_q4_off,
            rt.b_work, m.buf_attn_out_off,
            rt.b_work, m.buf_h_off,
            rt.b_work, m.buf_tmp_err_off,
            m.cfg.hidden, m.cfg.n_q * m.cfg.head_dim
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return eisa_certify_argmax(0, 0, 0, 0)
        }

        if qwen3_metal_encode_vec_add(
            &rt.sess, cid, rt.pipes.vec_add,
            rt.b_work, m.buf_x_off,
            rt.b_work, m.buf_h_off,
            m.cfg.hidden
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return eisa_certify_argmax(0, 0, 0, 0)
        }

        let post_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, slot_base + 7))
        let post_off = qwen3_model_tensor_data_off(m, slot_base + 7)
        let post_dt = qwen3_model_tensor_dtype(m, slot_base + 7)
        let post_pipe = if post_dt == 2 { rt.pipes.rmsnorm_bf16 } else { rt.pipes.rmsnorm_f32 }
        if qwen3_metal_encode_rmsnorm(
            &rt.sess, cid, post_pipe,
            rt.b_work, m.buf_x_off,
            post_s, post_off,
            rt.b_work, m.buf_h_off,
            1, m.cfg.hidden, eps_bits
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return eisa_certify_argmax(0, 0, 0, 0)
        }

        let gate_q4_off = ptr_read_i64_le(meta_base, (slot_base + 8) * 32 + 0)
        if qwen3_metal_encode_gemv_q4_eisa(
            &rt.sess, cid, gemv_pipe,
            em.b_q4, gate_q4_off,
            rt.b_work, m.buf_h_off,
            rt.b_work, m.buf_gate_off,
            rt.b_work, m.buf_tmp_err_off,
            m.cfg.inter, m.cfg.hidden
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return eisa_certify_argmax(0, 0, 0, 0)
        }

        let up_q4_off = ptr_read_i64_le(meta_base, (slot_base + 9) * 32 + 0)
        if qwen3_metal_encode_gemv_q4_eisa(
            &rt.sess, cid, gemv_pipe,
            em.b_q4, up_q4_off,
            rt.b_work, m.buf_h_off,
            rt.b_work, m.buf_up_off,
            rt.b_work, m.buf_tmp_err_off,
            m.cfg.inter, m.cfg.hidden
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return eisa_certify_argmax(0, 0, 0, 0)
        }

        if qwen3_metal_encode_swiglu(
            &rt.sess, cid, rt.pipes.swiglu,
            rt.b_work, m.buf_gate_off,
            rt.b_work, m.buf_up_off,
            rt.b_work, m.buf_gate_off,
            m.cfg.inter
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return eisa_certify_argmax(0, 0, 0, 0)
        }

        let down_q4_off = ptr_read_i64_le(meta_base, (slot_base + 10) * 32 + 0)
        if qwen3_metal_encode_gemv_q4_eisa(
            &rt.sess, cid, gemv_pipe,
            em.b_q4, down_q4_off,
            rt.b_work, m.buf_gate_off,
            rt.b_work, m.buf_h_off,
            rt.b_work, m.buf_tmp_err_off,
            m.cfg.hidden, m.cfg.inter
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return eisa_certify_argmax(0, 0, 0, 0)
        }

        if qwen3_metal_encode_vec_add(
            &rt.sess, cid, rt.pipes.vec_add,
            rt.b_work, m.buf_x_off,
            rt.b_work, m.buf_h_off,
            m.cfg.hidden
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return eisa_certify_argmax(0, 0, 0, 0)
        }

        l = l + 1
    }

    if compute_logits {
        let norm_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, 1))
        let norm_off = qwen3_model_tensor_data_off(m, 1)
        let norm_dt = qwen3_model_tensor_dtype(m, 1)
        let norm_pipe = if norm_dt == 2 { rt.pipes.rmsnorm_bf16 } else { rt.pipes.rmsnorm_f32 }
        if qwen3_metal_encode_rmsnorm(
            &rt.sess, cid, norm_pipe,
            rt.b_work, m.buf_x_off,
            norm_s, norm_off,
            rt.b_work, m.buf_h_off,
            1, m.cfg.hidden, eps_bits
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return eisa_certify_argmax(0, 0, 0, 0)
        }

        let lm_q4_off = ptr_read_i64_le(meta_base, 2 * 32 + 0)
        if qwen3_metal_encode_gemv_q4_eisa(
            &rt.sess, cid, gemv_pipe,
            em.b_q4, lm_q4_off,
            rt.b_work, m.buf_h_off,
            rt.b_work, m.buf_logits_off,
            rt.b_work, m.buf_logits_err_off,
            m.cfg.vocab, m.cfg.hidden
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return eisa_certify_argmax(0, 0, 0, 0)
        }
    }

    if metal_cmd_commit_sync(&rt.sess, cid) != 0 {
        return eisa_certify_argmax(0, 0, 0, 0)
    }

    if !compute_logits { return eisa_certify_argmax(0, 0, 0, 0) }
    let val_ptr = page_arena_ptr(&m.arena) + m.buf_logits_off
    let err_ptr = page_arena_ptr(&m.arena) + m.buf_logits_err_off
    eisa_certify_argmax(val_ptr, err_ptr, 0, m.cfg.vocab)
}

pub fn qwen3_forward_token_eisa_metal(
    m: &Qwen3Model,
    em: &Qwen3EisaModel,
    kv: &!Qwen3PagedKv,
    rt: &Qwen3MetalRunner,
    token_id: i64,
    pos: i64
) -> EisaArgmaxCert with Mut, Div, Panic {
    qwen3_forward_token_eisa_metal_opt(m, em, kv, rt, token_id, pos, true)
}

pub fn qwen3_forward_token_eisa_adaptive_metal(
    m: &Qwen3Model,
    em: &Qwen3EisaModel,
    kv: &!Qwen3PagedKv,
    rt: &Qwen3MetalRunner,
    token_id: i64,
    pos: i64,
    compute_logits: bool,
    escalated_out_ptr: i64
) -> EisaArgmaxCert with Mut, Div, Panic {
    if !compute_logits {
        let _ok = qwen3_forward_token_metal_opt(m, kv, rt, token_id, pos, false)
        if escalated_out_ptr != 0 { let _e0 = ptr_write_i64_le(escalated_out_ptr, 0, 0) }
        return eisa_certify_argmax(0, 0, 0, 0)
    }
    let cert = qwen3_forward_token_eisa_metal_opt(m, em, kv, rt, token_id, pos, true)
    if cert.certified_numerical {
        if escalated_out_ptr != 0 { let _e1 = ptr_write_i64_le(escalated_out_ptr, 0, 0) }
        return cert
    }
    if escalated_out_ptr != 0 { let _e2 = ptr_write_i64_le(escalated_out_ptr, 0, 1) }
    let ok = qwen3_forward_token_metal_opt(m, kv, rt, token_id, pos, true)
    if !ok { return eisa_certify_argmax(0, 0, 0, 0) }
    let t = qwen3_model_top2(m)
    EisaArgmaxCert {
        top1_id: t.top1_id,
        runner_up_id: t.runner_up_id,
        top1_val: t.top1_val,
        top1_err: 0.0,
        top1_u: 0.0,
        margin_val: t.top1_val - t.second_val,
        combined_err: 0.0,
        combined_u: 0.0,
        certified_numerical: true,
        certified_total: true,
    }
}

pub fn qwen3_forward_token_cone_metal_opt(
    m: &Qwen3Model,
    em_head: &Qwen3EisaModel,
    kv: &!Qwen3PagedKv,
    rt: &Qwen3MetalRunner,
    token_id: i64,
    pos: i64,
    compute_logits: bool,
    cone_rows_out_ptr: i64
) -> EisaConeCert with Mut, Div, Panic {
    if cone_rows_out_ptr != 0 { let _z = ptr_write_i64_le(cone_rows_out_ptr, 0, 0) }
    if !m.ok || !em_head.ok || !rt.ok || !qwen3_kv_is_ok(kv) || token_id < 0 || token_id >= m.cfg.vocab || pos < 0 {
        return eisa_certify_global(0, 0, 0)
    }
    if !qwen3_kv_ensure_pos(kv, pos) {
        return eisa_certify_global(0, 0, 0)
    }

    let a_base = page_arena_ptr(&m.arena)
    let buf_x = a_base + m.buf_x_off

    let emb_ptr = qwen3_model_tensor_host_ptr(m, 0)
    let emb_dt = qwen3_model_tensor_dtype(m, 0)
    let emb_elem_b = if emb_dt == 2 { 2 } else { 4 }
    let row_p = emb_ptr + token_id * m.cfg.hidden * emb_elem_b

    var i: i64 = 0
    while i < m.cfg.hidden {
        let v = if emb_dt == 2 {
            bf16_bits_to_f64_exact(ptr_read_u16_le(row_p, i * 2))
        } else {
            f32_bits_to_f64(ptr_read_u32_le(row_p, i * 4))
        }
        let _w = ptr_write_u32_le(buf_x, i * 4, f64_to_f32_bits(v))
        i = i + 1
    }

    let eps_bits = f64_to_f32_bits(m.cfg.eps)
    let theta_bits = f64_to_f32_bits(m.cfg.rope_theta)

    let cid = metal_cmd_begin(&rt.sess)
    if cid <= 0 { return eisa_certify_global(0, 0, 0) }

    var l: i64 = 0
    while l < m.cfg.layers {
        let slot_base = 3 + l * 11

        let in_norm_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, slot_base + 0))
        let in_norm_off = qwen3_model_tensor_data_off(m, slot_base + 0)
        let in_norm_dt = qwen3_model_tensor_dtype(m, slot_base + 0)
        let in_norm_pipe = if in_norm_dt == 2 { rt.pipes.rmsnorm_bf16 } else { rt.pipes.rmsnorm_f32 }
        if qwen3_metal_encode_rmsnorm(
            &rt.sess, cid, in_norm_pipe,
            rt.b_work, m.buf_x_off,
            in_norm_s, in_norm_off,
            rt.b_work, m.buf_h_off,
            1, m.cfg.hidden, eps_bits
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return eisa_certify_global(0, 0, 0)
        }

        let q_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, slot_base + 1))
        let q_off = qwen3_model_tensor_data_off(m, slot_base + 1)
        let q_dt = qwen3_model_tensor_dtype(m, slot_base + 1)
        let q_pipe = if q_dt == 2 { rt.pipes.gemv_bf16 } else { rt.pipes.gemv_f32 }
        if qwen3_metal_encode_gemv(
            &rt.sess, cid, q_pipe,
            q_s, q_off,
            rt.b_work, m.buf_h_off,
            rt.b_work, m.buf_q_off,
            m.cfg.n_q * m.cfg.head_dim, m.cfg.hidden
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return eisa_certify_global(0, 0, 0)
        }

        let k_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, slot_base + 2))
        let k_off = qwen3_model_tensor_data_off(m, slot_base + 2)
        let k_dt = qwen3_model_tensor_dtype(m, slot_base + 2)
        let k_pipe = if k_dt == 2 { rt.pipes.gemv_bf16 } else { rt.pipes.gemv_f32 }
        if qwen3_metal_encode_gemv(
            &rt.sess, cid, k_pipe,
            k_s, k_off,
            rt.b_work, m.buf_h_off,
            rt.b_work, m.buf_k_off,
            m.cfg.n_kv * m.cfg.head_dim, m.cfg.hidden
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return eisa_certify_global(0, 0, 0)
        }

        let v_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, slot_base + 3))
        let v_off = qwen3_model_tensor_data_off(m, slot_base + 3)
        let v_dt = qwen3_model_tensor_dtype(m, slot_base + 3)
        let v_pipe = if v_dt == 2 { rt.pipes.gemv_bf16 } else { rt.pipes.gemv_f32 }
        if qwen3_metal_encode_gemv(
            &rt.sess, cid, v_pipe,
            v_s, v_off,
            rt.b_work, m.buf_h_off,
            rt.b_work, m.buf_v_off,
            m.cfg.n_kv * m.cfg.head_dim, m.cfg.hidden
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return eisa_certify_global(0, 0, 0)
        }

        let q_norm_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, slot_base + 5))
        let q_norm_off = qwen3_model_tensor_data_off(m, slot_base + 5)
        let q_norm_dt = qwen3_model_tensor_dtype(m, slot_base + 5)
        let q_norm_pipe = if q_norm_dt == 2 { rt.pipes.rmsnorm_bf16 } else { rt.pipes.rmsnorm_f32 }
        if qwen3_metal_encode_rmsnorm(
            &rt.sess, cid, q_norm_pipe,
            rt.b_work, m.buf_q_off,
            q_norm_s, q_norm_off,
            rt.b_work, m.buf_q_off,
            m.cfg.n_q, m.cfg.head_dim, eps_bits
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return eisa_certify_global(0, 0, 0)
        }

        let k_norm_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, slot_base + 6))
        let k_norm_off = qwen3_model_tensor_data_off(m, slot_base + 6)
        let k_norm_dt = qwen3_model_tensor_dtype(m, slot_base + 6)
        let k_norm_pipe = if k_norm_dt == 2 { rt.pipes.rmsnorm_bf16 } else { rt.pipes.rmsnorm_f32 }
        if qwen3_metal_encode_rmsnorm(
            &rt.sess, cid, k_norm_pipe,
            rt.b_work, m.buf_k_off,
            k_norm_s, k_norm_off,
            rt.b_work, m.buf_k_off,
            m.cfg.n_kv, m.cfg.head_dim, eps_bits
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return eisa_certify_global(0, 0, 0)
        }

        if qwen3_metal_encode_rope_table(
            &rt.sess, cid, rt.pipes.rope_table,
            rt.b_work, m.buf_q_off,
            rt.b_rope, pos * m.cfg.head_dim * 4,
            m.cfg.n_q, m.cfg.head_dim
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return eisa_certify_global(0, 0, 0)
        }

        if qwen3_metal_encode_rope_table(
            &rt.sess, cid, rt.pipes.rope_table,
            rt.b_work, m.buf_k_off,
            rt.b_rope, pos * m.cfg.head_dim * 4,
            m.cfg.n_kv, m.cfg.head_dim
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return eisa_certify_global(0, 0, 0)
        }

        if qwen3_metal_encode_kv_scatter(
            &rt.sess, cid, rt.pipes.kv_scatter,
            rt.b_work, m.buf_k_off,
            rt.b_work, m.buf_v_off,
            rt.b_kv,
            qwen3_kv_table_off(kv),
            qwen3_kv_k_layer_off(kv, l),
            qwen3_kv_v_layer_off(kv, l),
            m.cfg.n_kv * m.cfg.head_dim,
            pos,
            qwen3_kv_block_size(kv)
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return eisa_certify_global(0, 0, 0)
        }

        if qwen3_metal_encode_paged_gqa(
            &rt.sess, cid, rt.pipes.paged_gqa,
            rt.b_work, m.buf_q_off,
            rt.b_kv,
            qwen3_kv_table_off(kv),
            qwen3_kv_k_layer_off(kv, l),
            qwen3_kv_v_layer_off(kv, l),
            rt.b_work, m.buf_attn_out_off,
            m.cfg.n_q, m.cfg.n_kv, m.cfg.head_dim,
            pos + 1,
            qwen3_kv_block_size(kv)
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return eisa_certify_global(0, 0, 0)
        }

        let o_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, slot_base + 4))
        let o_off = qwen3_model_tensor_data_off(m, slot_base + 4)
        let o_dt = qwen3_model_tensor_dtype(m, slot_base + 4)
        let o_pipe = if o_dt == 2 { rt.pipes.gemv_bf16 } else { rt.pipes.gemv_f32 }
        if qwen3_metal_encode_gemv(
            &rt.sess, cid, o_pipe,
            o_s, o_off,
            rt.b_work, m.buf_attn_out_off,
            rt.b_work, m.buf_h_off,
            m.cfg.hidden, m.cfg.n_q * m.cfg.head_dim
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return eisa_certify_global(0, 0, 0)
        }

        if qwen3_metal_encode_vec_add(
            &rt.sess, cid, rt.pipes.vec_add,
            rt.b_work, m.buf_x_off,
            rt.b_work, m.buf_h_off,
            m.cfg.hidden
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return eisa_certify_global(0, 0, 0)
        }

        let post_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, slot_base + 7))
        let post_off = qwen3_model_tensor_data_off(m, slot_base + 7)
        let post_dt = qwen3_model_tensor_dtype(m, slot_base + 7)
        let post_pipe = if post_dt == 2 { rt.pipes.rmsnorm_bf16 } else { rt.pipes.rmsnorm_f32 }
        if qwen3_metal_encode_rmsnorm(
            &rt.sess, cid, post_pipe,
            rt.b_work, m.buf_x_off,
            post_s, post_off,
            rt.b_work, m.buf_h_off,
            1, m.cfg.hidden, eps_bits
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return eisa_certify_global(0, 0, 0)
        }

        let gate_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, slot_base + 8))
        let gate_off = qwen3_model_tensor_data_off(m, slot_base + 8)
        let gate_dt = qwen3_model_tensor_dtype(m, slot_base + 8)
        let gate_pipe = if gate_dt == 2 { rt.pipes.gemv_bf16 } else { rt.pipes.gemv_f32 }
        if qwen3_metal_encode_gemv(
            &rt.sess, cid, gate_pipe,
            gate_s, gate_off,
            rt.b_work, m.buf_h_off,
            rt.b_work, m.buf_gate_off,
            m.cfg.inter, m.cfg.hidden
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return eisa_certify_global(0, 0, 0)
        }

        let up_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, slot_base + 9))
        let up_off = qwen3_model_tensor_data_off(m, slot_base + 9)
        let up_dt = qwen3_model_tensor_dtype(m, slot_base + 9)
        let up_pipe = if up_dt == 2 { rt.pipes.gemv_bf16 } else { rt.pipes.gemv_f32 }
        if qwen3_metal_encode_gemv(
            &rt.sess, cid, up_pipe,
            up_s, up_off,
            rt.b_work, m.buf_h_off,
            rt.b_work, m.buf_up_off,
            m.cfg.inter, m.cfg.hidden
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return eisa_certify_global(0, 0, 0)
        }

        if qwen3_metal_encode_swiglu(
            &rt.sess, cid, rt.pipes.swiglu,
            rt.b_work, m.buf_gate_off,
            rt.b_work, m.buf_up_off,
            rt.b_work, m.buf_gate_off,
            m.cfg.inter
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return eisa_certify_global(0, 0, 0)
        }

        let down_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, slot_base + 10))
        let down_off = qwen3_model_tensor_data_off(m, slot_base + 10)
        let down_dt = qwen3_model_tensor_dtype(m, slot_base + 10)
        let down_pipe = if down_dt == 2 { rt.pipes.gemv_bf16 } else { rt.pipes.gemv_f32 }
        if qwen3_metal_encode_gemv(
            &rt.sess, cid, down_pipe,
            down_s, down_off,
            rt.b_work, m.buf_gate_off,
            rt.b_work, m.buf_h_off,
            m.cfg.hidden, m.cfg.inter
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return eisa_certify_global(0, 0, 0)
        }

        if qwen3_metal_encode_vec_add(
            &rt.sess, cid, rt.pipes.vec_add,
            rt.b_work, m.buf_x_off,
            rt.b_work, m.buf_h_off,
            m.cfg.hidden
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return eisa_certify_global(0, 0, 0)
        }

        l = l + 1
    }

    if compute_logits {
        let norm_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, 1))
        let norm_off = qwen3_model_tensor_data_off(m, 1)
        let norm_dt = qwen3_model_tensor_dtype(m, 1)
        let norm_pipe = if norm_dt == 2 { rt.pipes.rmsnorm_bf16 } else { rt.pipes.rmsnorm_f32 }
        if qwen3_metal_encode_rmsnorm(
            &rt.sess, cid, norm_pipe,
            rt.b_work, m.buf_x_off,
            norm_s, norm_off,
            rt.b_work, m.buf_h_off,
            1, m.cfg.hidden, eps_bits
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return eisa_certify_global(0, 0, 0)
        }

        let head_meta = page_arena_ptr(&em_head.meta_arena)
        let lm_q4_off = ptr_read_i64_le(head_meta, 2 * 32 + 0)
        let gemv_pipe = if em_head.quant_bits == 8 { em_head.eisa_pipes.q8_gemv } else { em_head.eisa_pipes.q4_gemv }
        if qwen3_metal_encode_gemv_q4_eisa(
            &rt.sess, cid, gemv_pipe,
            em_head.b_q4, lm_q4_off,
            rt.b_work, m.buf_h_off,
            rt.b_work, m.buf_logits_off,
            rt.b_work, m.buf_logits_err_off,
            m.cfg.vocab, m.cfg.hidden
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return eisa_certify_global(0, 0, 0)
        }
        if qwen3_metal_encode_eisa_certify_global(
            &rt.sess, cid, em_head.eisa_pipes.certify_global,
            rt.b_work, m.buf_logits_off,
            rt.b_work, m.buf_logits_err_off,
            rt.b_work, m.buf_top2_off,
            m.cfg.vocab
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return eisa_certify_global(0, 0, 0)
        }
    }

    if metal_cmd_commit_sync(&rt.sess, cid) != 0 {
        return eisa_certify_global(0, 0, 0)
    }

    if !compute_logits {
        return eisa_certify_global(0, 0, 0)
    }
    let a_ptr = page_arena_ptr(&m.arena)
    let pk = a_ptr + m.buf_top2_off
    let top1_id = ptr_read_i64_le(pk, 0)
    let runner_id = ptr_read_i64_le(pk, 8)
    let cone_size = ptr_read_i64_le(pk, 16)
    let cert_flag = ptr_read_i64_le(pk, 24)
    let top1_bits = ptr_read_u32_le(pk, 32)
    let err_bits = ptr_read_u32_le(pk, 36)
    let mo_bits = ptr_read_u32_le(pk, 40)
    let gm_bits = ptr_read_u32_le(pk, 44)
    let top1_val = f32_bits_to_f64(top1_bits)
    let top1_err = f32_bits_to_f64(err_bits)
    let max_other = f32_bits_to_f64(mo_bits)
    let g_margin = f32_bits_to_f64(gm_bits)
    if cert_flag == 1 {
        if cone_rows_out_ptr != 0 { let _w = ptr_write_i64_le(cone_rows_out_ptr, 0, 0) }
        return EisaConeCert {
            top1_id: top1_id,
            runner_up_id: runner_id,
            refined_top1_id: top1_id,
            top1_val: top1_val,
            top1_err: top1_err,
            max_other_upper: max_other,
            global_margin: g_margin,
            cone_size: cone_size,
            bf16_rows_touched: 0,
            strict_global_certified: true,
            refined_exact: true,
        }
    }

    let lower_bits = f64_to_f32_bits(top1_val - top1_err)
    let lm_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, 2))
    let lm_off = qwen3_model_tensor_data_off(m, 2)
    let lm_dt = qwen3_model_tensor_dtype(m, 2)
    let cone_pipe = if lm_dt == 2 { em_head.eisa_pipes.cone_refine_bf16 } else { em_head.eisa_pipes.cone_refine_f32 }
    let cid2 = metal_cmd_begin(&rt.sess)
    if cid2 <= 0 { return eisa_certify_global(0, 0, 0) }
    if qwen3_metal_encode_eisa_cone_refine(
        &rt.sess, cid2, cone_pipe,
        lm_s, lm_off,
        rt.b_work, m.buf_h_off,
        rt.b_work, m.buf_logits_off,
        rt.b_work, m.buf_logits_err_off,
        m.cfg.vocab, m.cfg.hidden, lower_bits
    ) != 0 {
        let _c = metal_cmd_cancel(&rt.sess, cid2)
        return eisa_certify_global(0, 0, 0)
    }
    if qwen3_metal_encode_argmax_top2(
        &rt.sess, cid2, rt.pipes.argmax_top2,
        rt.b_work, m.buf_logits_off,
        rt.b_work, m.buf_top2_off,
        m.cfg.vocab
    ) != 0 {
        let _c = metal_cmd_cancel(&rt.sess, cid2)
        return eisa_certify_global(0, 0, 0)
    }
    if metal_cmd_commit_sync(&rt.sess, cid2) != 0 {
        return eisa_certify_global(0, 0, 0)
    }
    let refined_top1_id = ptr_read_i64_le(a_ptr + m.buf_top2_off, 0)
    if cone_rows_out_ptr != 0 { let _w = ptr_write_i64_le(cone_rows_out_ptr, 0, cone_size) }
    EisaConeCert {
        top1_id: top1_id,
        runner_up_id: runner_id,
        refined_top1_id: refined_top1_id,
        top1_val: top1_val,
        top1_err: top1_err,
        max_other_upper: max_other,
        global_margin: g_margin,
        cone_size: cone_size,
        bf16_rows_touched: cone_size,
        strict_global_certified: false,
        refined_exact: true,
    }
}


fn qwen3_eisa_gemv_cpu_bits(
    bits: i64,
    q_ptr: i64,
    x_f32_ptr: i64,
    u_x_f32_ptr: i64,
    val_f32_ptr: i64,
    err_f32_ptr: i64,
    u_f32_ptr: i64,
    out_dim: i64,
    in_dim: i64
) -> bool with Mut, Div {
    if bits == 8 {
        return qwen3_gemv_q8_eisa_cpu(q_ptr, x_f32_ptr, u_x_f32_ptr, val_f32_ptr, err_f32_ptr, u_f32_ptr, out_dim, in_dim)
    }
    qwen3_gemv_q4_eisa_cpu(q_ptr, x_f32_ptr, u_x_f32_ptr, val_f32_ptr, err_f32_ptr, u_f32_ptr, out_dim, in_dim)
}

pub fn qwen3_forward_token_eisa_cpu(
    m: &Qwen3Model,
    em: &Qwen3EisaModel,
    kv: &!Qwen3PagedKv,
    token_id: i64,
    pos: i64
) -> EisaArgmaxCert with Mut, Div, Panic {
    if !m.ok || !em.ok || !qwen3_kv_is_ok(kv) || token_id < 0 || token_id >= m.cfg.vocab || pos < 0 {
        return eisa_certify_argmax(0, 0, 0, 0)
    }
    if !qwen3_kv_ensure_pos(kv, pos) {
        return eisa_certify_argmax(0, 0, 0, 0)
    }

    let a_base = page_arena_ptr(&m.arena)
    let buf_x = a_base + m.buf_x_off
    let buf_h = a_base + m.buf_h_off
    let buf_q = a_base + m.buf_q_off
    let buf_k = a_base + m.buf_k_off
    let buf_v = a_base + m.buf_v_off
    let buf_attn_out = a_base + m.buf_attn_out_off
    let buf_gate = a_base + m.buf_gate_off
    let buf_up = a_base + m.buf_up_off
    let buf_logits = a_base + m.buf_logits_off
    let buf_logits_err = a_base + m.buf_logits_err_off
    let buf_tmp_err = a_base + m.buf_tmp_err_off

    let emb_ptr = qwen3_model_tensor_host_ptr(m, 0)
    let emb_dt = qwen3_model_tensor_dtype(m, 0)
    let emb_elem_b = if emb_dt == 2 { 2 } else { 4 }
    let row_p = emb_ptr + token_id * m.cfg.hidden * emb_elem_b

    var i: i64 = 0
    while i < m.cfg.hidden {
        let v = if emb_dt == 2 {
            bf16_bits_to_f64_exact(ptr_read_u16_le(row_p, i * 2))
        } else {
            f32_bits_to_f64(ptr_read_u32_le(row_p, i * 4))
        }
        let _w = ptr_write_u32_le(buf_x, i * 4, f64_to_f32_bits(v))
        i = i + 1
    }

    let q4_base = page_arena_ptr(&em.q4_arena)
    let meta_base = page_arena_ptr(&em.meta_arena)

    var l: i64 = 0
    while l < m.cfg.layers {
        let slot_base = 3 + l * 11

        let in_norm_p = qwen3_model_tensor_host_ptr(m, slot_base + 0)
        let in_norm_dt = qwen3_model_tensor_dtype(m, slot_base + 0)
        qwen3_cpu_rmsnorm(buf_x, in_norm_p, in_norm_dt, buf_h, 1, m.cfg.hidden, m.cfg.eps)

        let q_q4_off = ptr_read_i64_le(meta_base, (slot_base + 1) * 32 + 0)
        let _qok = qwen3_eisa_gemv_cpu_bits(em.quant_bits, q4_base + q_q4_off, buf_h, 0, buf_q, buf_tmp_err, 0, m.cfg.n_q * m.cfg.head_dim, m.cfg.hidden)

        let k_q4_off = ptr_read_i64_le(meta_base, (slot_base + 2) * 32 + 0)
        let _kok = qwen3_eisa_gemv_cpu_bits(em.quant_bits, q4_base + k_q4_off, buf_h, 0, buf_k, buf_tmp_err, 0, m.cfg.n_kv * m.cfg.head_dim, m.cfg.hidden)

        let v_q4_off = ptr_read_i64_le(meta_base, (slot_base + 3) * 32 + 0)
        let _vok = qwen3_eisa_gemv_cpu_bits(em.quant_bits, q4_base + v_q4_off, buf_h, 0, buf_v, buf_tmp_err, 0, m.cfg.n_kv * m.cfg.head_dim, m.cfg.hidden)

        let q_norm_p = qwen3_model_tensor_host_ptr(m, slot_base + 5)
        let q_norm_dt = qwen3_model_tensor_dtype(m, slot_base + 5)
        qwen3_cpu_rmsnorm(buf_q, q_norm_p, q_norm_dt, buf_q, m.cfg.n_q, m.cfg.head_dim, m.cfg.eps)

        let k_norm_p = qwen3_model_tensor_host_ptr(m, slot_base + 6)
        let k_norm_dt = qwen3_model_tensor_dtype(m, slot_base + 6)
        qwen3_cpu_rmsnorm(buf_k, k_norm_p, k_norm_dt, buf_k, m.cfg.n_kv, m.cfg.head_dim, m.cfg.eps)

        qwen3_cpu_rope(buf_q, m.cfg.n_q, m.cfg.head_dim, pos, m.cfg.rope_theta)
        qwen3_cpu_rope(buf_k, m.cfg.n_kv, m.cfg.head_dim, pos, m.cfg.rope_theta)

        let wk_ok = qwen3_kv_write_kv_f32_buf(kv, l, pos, buf_k, buf_v)
        if !wk_ok { return eisa_certify_argmax(0, 0, 0, 0) }

        qwen3_cpu_paged_gqa(buf_q, kv, l, buf_attn_out, m.cfg.n_q, m.cfg.n_kv, m.cfg.head_dim, pos)

        let o_q4_off = ptr_read_i64_le(meta_base, (slot_base + 4) * 32 + 0)
        let _ook = qwen3_eisa_gemv_cpu_bits(em.quant_bits, q4_base + o_q4_off, buf_attn_out, 0, buf_h, buf_tmp_err, 0, m.cfg.hidden, m.cfg.n_q * m.cfg.head_dim)
        qwen3_cpu_vec_add(buf_x, buf_h, m.cfg.hidden)

        let post_p = qwen3_model_tensor_host_ptr(m, slot_base + 7)
        let post_dt = qwen3_model_tensor_dtype(m, slot_base + 7)
        qwen3_cpu_rmsnorm(buf_x, post_p, post_dt, buf_h, 1, m.cfg.hidden, m.cfg.eps)

        let gate_q4_off = ptr_read_i64_le(meta_base, (slot_base + 8) * 32 + 0)
        let _gok = qwen3_eisa_gemv_cpu_bits(em.quant_bits, q4_base + gate_q4_off, buf_h, 0, buf_gate, buf_tmp_err, 0, m.cfg.inter, m.cfg.hidden)

        let up_q4_off = ptr_read_i64_le(meta_base, (slot_base + 9) * 32 + 0)
        let _uok = qwen3_eisa_gemv_cpu_bits(em.quant_bits, q4_base + up_q4_off, buf_h, 0, buf_up, buf_tmp_err, 0, m.cfg.inter, m.cfg.hidden)

        qwen3_cpu_swiglu(buf_gate, buf_up, buf_gate, m.cfg.inter)

        let down_q4_off = ptr_read_i64_le(meta_base, (slot_base + 10) * 32 + 0)
        let _dok = qwen3_eisa_gemv_cpu_bits(em.quant_bits, q4_base + down_q4_off, buf_gate, 0, buf_h, buf_tmp_err, 0, m.cfg.hidden, m.cfg.inter)
        qwen3_cpu_vec_add(buf_x, buf_h, m.cfg.hidden)

        l = l + 1
    }

    let norm_p = qwen3_model_tensor_host_ptr(m, 1)
    let norm_dt = qwen3_model_tensor_dtype(m, 1)
    qwen3_cpu_rmsnorm(buf_x, norm_p, norm_dt, buf_h, 1, m.cfg.hidden, m.cfg.eps)

    let lm_q4_off = ptr_read_i64_le(meta_base, 2 * 32 + 0)
    let _lok = qwen3_eisa_gemv_cpu_bits(em.quant_bits, q4_base + lm_q4_off, buf_h, 0, buf_logits, buf_logits_err, 0, m.cfg.vocab, m.cfg.hidden)

    eisa_certify_argmax(buf_logits, buf_logits_err, 0, m.cfg.vocab)
}


pub fn qwen3_forward_token_cone_cpu(
    m: &Qwen3Model,
    em_head: &Qwen3EisaModel,
    kv: &!Qwen3PagedKv,
    token_id: i64,
    pos: i64,
    cone_rows_out_ptr: i64
) -> EisaConeCert with Mut, Div, Panic {
    if cone_rows_out_ptr != 0 { let _z = ptr_write_i64_le(cone_rows_out_ptr, 0, 0) }
    if !m.ok || !em_head.ok || !qwen3_kv_is_ok(kv) || token_id < 0 || token_id >= m.cfg.vocab || pos < 0 {
        return eisa_certify_global(0, 0, 0)
    }
    if !qwen3_kv_ensure_pos(kv, pos) {
        return eisa_certify_global(0, 0, 0)
    }

    let a_base = page_arena_ptr(&m.arena)
    let buf_x = a_base + m.buf_x_off
    let buf_h = a_base + m.buf_h_off
    let buf_q = a_base + m.buf_q_off
    let buf_k = a_base + m.buf_k_off
    let buf_v = a_base + m.buf_v_off
    let buf_attn_out = a_base + m.buf_attn_out_off
    let buf_gate = a_base + m.buf_gate_off
    let buf_up = a_base + m.buf_up_off
    let buf_logits = a_base + m.buf_logits_off
    let buf_logits_err = a_base + m.buf_logits_err_off

    let emb_ptr = qwen3_model_tensor_host_ptr(m, 0)
    let emb_dt = qwen3_model_tensor_dtype(m, 0)
    let emb_elem_b = if emb_dt == 2 { 2 } else { 4 }
    let row_p = emb_ptr + token_id * m.cfg.hidden * emb_elem_b

    var i: i64 = 0
    while i < m.cfg.hidden {
        let v = if emb_dt == 2 {
            bf16_bits_to_f64_exact(ptr_read_u16_le(row_p, i * 2))
        } else {
            f32_bits_to_f64(ptr_read_u32_le(row_p, i * 4))
        }
        let _w = ptr_write_u32_le(buf_x, i * 4, f64_to_f32_bits(v))
        i = i + 1
    }

    var l: i64 = 0
    while l < m.cfg.layers {
        let slot_base = 3 + l * 11

        let in_norm_p = qwen3_model_tensor_host_ptr(m, slot_base + 0)
        let in_norm_dt = qwen3_model_tensor_dtype(m, slot_base + 0)
        qwen3_cpu_rmsnorm(buf_x, in_norm_p, in_norm_dt, buf_h, 1, m.cfg.hidden, m.cfg.eps)

        let q_p = qwen3_model_tensor_host_ptr(m, slot_base + 1)
        let q_dt = qwen3_model_tensor_dtype(m, slot_base + 1)
        qwen3_cpu_gemv(q_p, q_dt, buf_h, buf_q, m.cfg.n_q * m.cfg.head_dim, m.cfg.hidden)

        let k_p = qwen3_model_tensor_host_ptr(m, slot_base + 2)
        let k_dt = qwen3_model_tensor_dtype(m, slot_base + 2)
        qwen3_cpu_gemv(k_p, k_dt, buf_h, buf_k, m.cfg.n_kv * m.cfg.head_dim, m.cfg.hidden)

        let v_p = qwen3_model_tensor_host_ptr(m, slot_base + 3)
        let v_dt = qwen3_model_tensor_dtype(m, slot_base + 3)
        qwen3_cpu_gemv(v_p, v_dt, buf_h, buf_v, m.cfg.n_kv * m.cfg.head_dim, m.cfg.hidden)

        let q_norm_p = qwen3_model_tensor_host_ptr(m, slot_base + 5)
        let q_norm_dt = qwen3_model_tensor_dtype(m, slot_base + 5)
        qwen3_cpu_rmsnorm(buf_q, q_norm_p, q_norm_dt, buf_q, m.cfg.n_q, m.cfg.head_dim, m.cfg.eps)

        let k_norm_p = qwen3_model_tensor_host_ptr(m, slot_base + 6)
        let k_norm_dt = qwen3_model_tensor_dtype(m, slot_base + 6)
        qwen3_cpu_rmsnorm(buf_k, k_norm_p, k_norm_dt, buf_k, m.cfg.n_kv, m.cfg.head_dim, m.cfg.eps)

        qwen3_cpu_rope(buf_q, m.cfg.n_q, m.cfg.head_dim, pos, m.cfg.rope_theta)
        qwen3_cpu_rope(buf_k, m.cfg.n_kv, m.cfg.head_dim, pos, m.cfg.rope_theta)

        let wk_ok = qwen3_kv_write_kv_f32_buf(kv, l, pos, buf_k, buf_v)
        if !wk_ok { return eisa_certify_global(0, 0, 0) }

        qwen3_cpu_paged_gqa(buf_q, kv, l, buf_attn_out, m.cfg.n_q, m.cfg.n_kv, m.cfg.head_dim, pos)

        let o_p = qwen3_model_tensor_host_ptr(m, slot_base + 4)
        let o_dt = qwen3_model_tensor_dtype(m, slot_base + 4)
        qwen3_cpu_gemv(o_p, o_dt, buf_attn_out, buf_h, m.cfg.hidden, m.cfg.n_q * m.cfg.head_dim)
        qwen3_cpu_vec_add(buf_x, buf_h, m.cfg.hidden)

        let post_p = qwen3_model_tensor_host_ptr(m, slot_base + 7)
        let post_dt = qwen3_model_tensor_dtype(m, slot_base + 7)
        qwen3_cpu_rmsnorm(buf_x, post_p, post_dt, buf_h, 1, m.cfg.hidden, m.cfg.eps)

        let gate_p = qwen3_model_tensor_host_ptr(m, slot_base + 8)
        let gate_dt = qwen3_model_tensor_dtype(m, slot_base + 8)
        qwen3_cpu_gemv(gate_p, gate_dt, buf_h, buf_gate, m.cfg.inter, m.cfg.hidden)

        let up_p = qwen3_model_tensor_host_ptr(m, slot_base + 9)
        let up_dt = qwen3_model_tensor_dtype(m, slot_base + 9)
        qwen3_cpu_gemv(up_p, up_dt, buf_h, buf_up, m.cfg.inter, m.cfg.hidden)

        qwen3_cpu_swiglu(buf_gate, buf_up, buf_gate, m.cfg.inter)

        let down_p = qwen3_model_tensor_host_ptr(m, slot_base + 10)
        let down_dt = qwen3_model_tensor_dtype(m, slot_base + 10)
        qwen3_cpu_gemv(down_p, down_dt, buf_gate, buf_h, m.cfg.hidden, m.cfg.inter)
        qwen3_cpu_vec_add(buf_x, buf_h, m.cfg.hidden)

        l = l + 1
    }

    let norm_p = qwen3_model_tensor_host_ptr(m, 1)
    let norm_dt = qwen3_model_tensor_dtype(m, 1)
    qwen3_cpu_rmsnorm(buf_x, norm_p, norm_dt, buf_h, 1, m.cfg.hidden, m.cfg.eps)

    let q4_base = page_arena_ptr(&em_head.q4_arena)
    let head_meta = page_arena_ptr(&em_head.meta_arena)
    let lm_q4_off = ptr_read_i64_le(head_meta, 2 * 32 + 0)
    let _lok = qwen3_eisa_gemv_cpu_bits(em_head.quant_bits, q4_base + lm_q4_off, buf_h, 0, buf_logits, buf_logits_err, 0, m.cfg.vocab, m.cfg.hidden)
    let cert = eisa_cone_refine_bf16_cpu(
        buf_logits, buf_logits_err,
        qwen3_model_tensor_host_ptr(m, 2), qwen3_model_tensor_dtype(m, 2),
        buf_h, m.cfg.vocab, m.cfg.hidden
    )
    if cone_rows_out_ptr != 0 { let _w = ptr_write_i64_le(cone_rows_out_ptr, 0, cert.bf16_rows_touched) }
    cert
}

pub linear struct Qwen3ConformalCtx {
    pub conf_arena: PageArena,
    pub weights_arena: PageArena,
    pub b_conf: i64,
    pub pipes: ConformalQ8MetalPipelines,
    pub n_layers: i64,
    pub vocab: i64,
    pub tile_smax_off: i64,
    pub tile_summary_off: i64,
    pub q_threshold: f64,
    pub ok: bool,
}

pub fn qwen3_conformal_q_for_mode_layers(quant_mode: i64, n_layers: i64) -> f64 {
    if quant_mode == 7 { return 120.0 }
    if quant_mode == 8 { return 60.0 }
    if quant_mode == 9 { return 8.754311 }
    if quant_mode == 10 { return 17.473679 }
    if quant_mode == 11 { return 120.0 }
    if quant_mode == 12 { return 120.0 }
    if quant_mode == 13 { return 1.05 }
    if quant_mode == 14 { return 0.85 }
    if quant_mode == 15 { return 0.85 }
    if n_layers == 36 {
        if quant_mode == 16 { return 3.0 }
        if quant_mode == 17 { return 1.15 }
        if quant_mode == 18 { return 3.0 }
        if quant_mode == 19 { return 1.15 }
        if quant_mode == 20 { return 3.0 }
        if quant_mode == 21 { return 1.15 }
    } else {
        if quant_mode == 16 { return 120.0 }
        if quant_mode == 17 { return 60.0 }
        if quant_mode == 18 { return 3.0 }
        if quant_mode == 19 { return 1.15 }
        if quant_mode == 20 { return 0.85 }
        if quant_mode == 21 { return 0.85 }
    }
    120.0
}

pub fn qwen3_conformal_q_for_mode(quant_mode: i64) -> f64 {
    qwen3_conformal_q_for_mode_layers(quant_mode, 28)
}

fn qwen3_conformal_layer_weight_28(l: i64) -> f64 {
    if l == 0 { return 0.08125945925712585 }
    if l == 1 { return 0.21323123574256897 }
    if l == 5 { return 0.000023737378796795383 }
    if l == 6 { return 0.00008122641156660393 }
    if l == 7 { return 0.00008628072100691497 }
    if l == 8 { return 0.00015319883823394775 }
    if l == 9 { return 0.0001571612519910559 }
    if l == 10 { return 0.0001356941502308473 }
    if l == 11 { return 0.0002482270647305995 }
    if l == 12 { return 0.0001704266614979133 }
    if l == 13 { return 0.00016947535914368927 }
    if l == 14 { return 0.00019077489560004324 }
    if l == 15 { return 0.000003559789320206619 }
    if l == 16 { return 0.00012018859706586227 }
    0.0
}

fn qwen3_conformal_layer_weight_mlp_28(l: i64) -> f64 {
    if l == 0 { return 0.12534284591674805 }
    if l == 1 { return 0.05806072801351547 }
    if l == 25 { return 0.0006573801510967314 }
    0.0
}

fn qwen3_conformal_layer_weight_q4_28(l: i64) -> f64 {
    if l == 2 { return 0.42272675037384033 }
    if l == 3 { return 0.7261545658111572 }
    if l == 5 { return 0.7373613119125366 }
    if l == 9 { return 0.16431191563606262 }
    0.0
}

fn qwen3_conformal_layer_weight_q4_36(l: i64) -> f64 {
    if l == 35 { return 0.05919799581170082 }
    0.0
}

fn qwen3_conformal_c_add_for_mode_layers(quant_mode: i64, n_layers: i64) -> f64 {
    if n_layers == 36 && quant_mode >= 16 && quant_mode <= 21 {
        return 492.9598083496094
    }
    0.0
}

fn qwen3_conformal_use_jac_for_mode_layers(quant_mode: i64, n_layers: i64) -> i64 {
    if n_layers == 36 && quant_mode >= 16 && quant_mode <= 21 {
        return 1
    }
    0
}

fn qwen3_conformal_load_env_weights(conf_ptr: i64, weights_ptr: i64, n_layers: i64) -> bool with IO, Mut, Alloc, Div, Panic {
    let env_p = hal_getenv_ptr("SOUNIO_CONFORMAL_WEIGHTS")
    if env_p == 0 || ptr_read_u8(env_p, 0) == 0 {
        return false
    }
    let sh = mapped_shard_open((env_p as *mut u8) as string)
    if !mapped_shard_is_ok(&sh) {
        return false
    }
    let s_ptr = mapped_shard_ptr(&sh)
    let s_len = mapped_shard_len(&sh)
    var count: i64 = 0
    var pos: i64 = 0
    var c_add_val: f64 = 0.0
    var use_jac_val: i64 = 0
    while count < n_layers + 2 && pos < s_len {
        var i = qwen3_skip_ws(s_ptr, pos, s_len)
        while i < s_len && ptr_read_u8(s_ptr, i) == 44 {
            i = qwen3_skip_ws(s_ptr, i + 1, s_len)
        }
        if i >= s_len { break }
        var end = i
        while end < s_len {
            let ch = ptr_read_u8(s_ptr, end)
            if ch == 10 || ch == 13 || ch == 32 || ch == 9 || ch == 44 {
                break
            }
            end = end + 1
        }
        if end > i {
            let val = qwen3_parse_f64(s_ptr, i, end)
            if count < n_layers {
                let _ww = ptr_write_u32_le(weights_ptr, count * 4, f64_to_f32_bits(val))
            } else if count == n_layers {
                c_add_val = val
            } else {
                use_jac_val = if val > 0.5 { 1 } else { 0 }
            }
            count = count + 1
        }
        pos = end
    }
    let _cs = mapped_shard_close(sh)
    if count <= 0 {
        return false
    }
    var k = count
    while k < n_layers {
        let _wz = ptr_write_u32_le(weights_ptr, k * 4, 0)
        k = k + 1
    }
    if conf_ptr != 0 {
        let _wc = ptr_write_u32_le(conf_ptr, 16, f64_to_f32_bits(c_add_val))
        let _wj = ptr_write_u32_le(conf_ptr, 20, use_jac_val)
    }
    true
}

fn qwen3_conformal_fill_weights_for_mode(conf_ptr: i64, weights_ptr: i64, n_layers: i64, quant_mode: i64) with IO, Mut, Alloc, Div, Panic {
    if qwen3_conformal_load_env_weights(conf_ptr, weights_ptr, n_layers) {
        return
    }
    let use_mlp = (quant_mode == 11 || quant_mode == 12)
    let use_q4 = (quant_mode >= 16 && quant_mode <= 21)
    var l: i64 = 0
    while l < n_layers {
        let w = if use_q4 {
            if n_layers == 36 {
                qwen3_conformal_layer_weight_q4_36(l)
            } else if n_layers == 28 {
                qwen3_conformal_layer_weight_q4_28(l)
            } else {
                0.05 / (n_layers as f64)
            }
        } else if n_layers == 28 {
            if use_mlp {
                qwen3_conformal_layer_weight_mlp_28(l)
            } else {
                qwen3_conformal_layer_weight_28(l)
            }
        } else {
            0.01 / (n_layers as f64)
        }
        let _ww = ptr_write_u32_le(weights_ptr, l * 4, f64_to_f32_bits(w))
        l = l + 1
    }
    if conf_ptr != 0 {
        let _wc = ptr_write_u32_le(conf_ptr, 16, f64_to_f32_bits(qwen3_conformal_c_add_for_mode_layers(quant_mode, n_layers)))
        let _wj = ptr_write_u32_le(conf_ptr, 20, qwen3_conformal_use_jac_for_mode_layers(quant_mode, n_layers))
    }
}

fn qwen3_conformal_fill_weights(weights_ptr: i64, n_layers: i64) with IO, Mut, Alloc, Div, Panic {
    qwen3_conformal_fill_weights_for_mode(0, weights_ptr, n_layers, 7)
}

pub fn qwen3_conformal_ctx_is_ok(c: &Qwen3ConformalCtx) -> bool {
    c.ok
}

pub fn qwen3_conformal_ctx_set_q(c: &!Qwen3ConformalCtx, q_threshold: f64) -> bool with Mut {
    if !c.ok { return false }
    c.q_threshold = q_threshold
    let conf_ptr = page_arena_ptr(&c.conf_arena)
    let _wq = ptr_write_u32_le(conf_ptr, 4, f64_to_f32_bits(q_threshold))
    true
}

pub fn qwen3_conformal_ctx_set_jacobian(c: &!Qwen3ConformalCtx, c_add: f64, use_inv_rms: bool) -> bool with Mut {
    if !c.ok { return false }
    let conf_ptr = page_arena_ptr(&c.conf_arena)
    let _wc = ptr_write_u32_le(conf_ptr, 16, f64_to_f32_bits(c_add))
    let uj = if use_inv_rms { 1 } else { 0 }
    let _wj = ptr_write_u32_le(conf_ptr, 20, uj)
    true
}

pub fn qwen3_conformal_ctx_set_layer_weight(c: &!Qwen3ConformalCtx, layer_idx: i64, weight: f64) -> bool with Mut {
    if !c.ok || layer_idx < 0 || layer_idx >= c.n_layers { return false }
    let w_ptr = page_arena_ptr(&c.weights_arena)
    let _ww = ptr_write_u32_le(w_ptr, layer_idx * 4, f64_to_f32_bits(weight))
    true
}

pub fn qwen3_conformal_ctx_init(
    m: &Qwen3Model,
    rt: &Qwen3MetalRunner,
    quant_mode: i64
) -> Qwen3ConformalCtx with IO, Mut, Alloc, Div, Panic {
    let q_val = qwen3_conformal_q_for_mode_layers(quant_mode, m.cfg.layers)
    if !m.ok || !rt.ok || m.cfg.layers <= 0 || m.cfg.vocab <= 0 || m.cfg.hidden <= 0 {
        return Qwen3ConformalCtx {
            conf_arena: PageArena { ptr: 0, len: 0, ok: false },
            weights_arena: PageArena { ptr: 0, len: 0, ok: false },
            b_conf: 0,
            pipes: conformal_q8_metal_pipelines_empty(),
            n_layers: 0,
            vocab: 0,
            tile_smax_off: 0,
            tile_summary_off: 0,
            q_threshold: q_val,
            ok: false,
        }
    }

    let n_tiles = (m.cfg.vocab + 63) / 64
    let tile_smax_off = align_up_64(64 + m.cfg.vocab * 4)
    let tile_summary_off = align_up_64(tile_smax_off + n_tiles * 4)
    let conf_bytes = align_up_64(tile_summary_off + n_tiles * 32 + 4096)
    let weights_bytes = align_up_64(m.cfg.layers * 4 + 64)
    let conf_arena = page_arena_alloc(conf_bytes)
    let weights_arena = page_arena_alloc(weights_bytes)
    var ok = page_arena_is_ok(&conf_arena) && page_arena_is_ok(&weights_arena)

    let pipes = if ok { conformal_q8_metal_pipelines_compile(&rt.sess) } else { conformal_q8_metal_pipelines_empty() }
    let b_conf = if ok { metal_buffer_nocopy(&rt.sess, page_arena_ptr(&conf_arena), page_arena_len(&conf_arena)) } else { 0 }
    if b_conf <= 0 || !pipes.ok {
        ok = false
    }

    if ok {
        let conf_ptr = page_arena_ptr(&conf_arena)
        let _wd = ptr_write_u32_le(conf_ptr, 0, f64_to_f32_bits(0.0))
        let _wq = ptr_write_u32_le(conf_ptr, 4, f64_to_f32_bits(q_val))
        let _wp = ptr_write_i64_le(conf_ptr, 8, 0)
        let _wc = ptr_write_u32_le(conf_ptr, 16, f64_to_f32_bits(0.0))
        let _wj = ptr_write_u32_le(conf_ptr, 20, 0)
        qwen3_conformal_fill_weights_for_mode(conf_ptr, page_arena_ptr(&weights_arena), m.cfg.layers, quant_mode)

        let lm_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, 2))
        let lm_off = qwen3_model_tensor_data_off(m, 2)
        let lm_dt = qwen3_model_tensor_dtype(m, 2)
        let rs_pipe = if lm_dt == 2 { pipes.compute_row_scale_bf16 } else { pipes.compute_row_scale_f32 }
        let cid = metal_cmd_begin(&rt.sess)
        if cid <= 0 {
            ok = false
        } else {
            if qwen3_metal_encode_compute_row_scale(&rt.sess, cid, rs_pipe, lm_s, lm_off, b_conf, 0, m.cfg.vocab, m.cfg.hidden) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                ok = false
            } else if qwen3_metal_encode_compute_tile_smax(&rt.sess, cid, pipes.compute_tile_smax, b_conf, 0, tile_smax_off, m.cfg.vocab) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                ok = false
            } else if metal_cmd_commit_sync(&rt.sess, cid) != 0 {
                ok = false
            }
        }
    }

    Qwen3ConformalCtx {
        conf_arena: conf_arena,
        weights_arena: weights_arena,
        b_conf: b_conf,
        pipes: pipes,
        n_layers: m.cfg.layers,
        vocab: m.cfg.vocab,
        tile_smax_off: tile_smax_off,
        tile_summary_off: tile_summary_off,
        q_threshold: q_val,
        ok: ok,
    }
}

pub fn qwen3_conformal_ctx_init_cpu(
    m: &Qwen3Model,
    quant_mode: i64
) -> Qwen3ConformalCtx with IO, Mut, Alloc, Div, Panic {
    let q_val = qwen3_conformal_q_for_mode_layers(quant_mode, m.cfg.layers)
    if !m.ok || m.cfg.layers <= 0 || m.cfg.vocab <= 0 || m.cfg.hidden <= 0 {
        return Qwen3ConformalCtx {
            conf_arena: PageArena { ptr: 0, len: 0, ok: false },
            weights_arena: PageArena { ptr: 0, len: 0, ok: false },
            b_conf: 0,
            pipes: conformal_q8_metal_pipelines_empty(),
            n_layers: 0,
            vocab: 0,
            tile_smax_off: 0,
            tile_summary_off: 0,
            q_threshold: q_val,
            ok: false,
        }
    }

    let n_tiles = (m.cfg.vocab + 63) / 64
    let tile_smax_off = align_up_64(64 + m.cfg.vocab * 4)
    let tile_summary_off = align_up_64(tile_smax_off + n_tiles * 4)
    let conf_bytes = align_up_64(tile_summary_off + n_tiles * 32 + 4096)
    let weights_bytes = align_up_64(m.cfg.layers * 4 + 64)
    let conf_arena = page_arena_alloc(conf_bytes)
    let weights_arena = page_arena_alloc(weights_bytes)
    var ok = page_arena_is_ok(&conf_arena) && page_arena_is_ok(&weights_arena)

    if ok {
        let conf_ptr = page_arena_ptr(&conf_arena)
        let _wd = ptr_write_u32_le(conf_ptr, 0, f64_to_f32_bits(0.0))
        let _wq = ptr_write_u32_le(conf_ptr, 4, f64_to_f32_bits(q_val))
        let _wp = ptr_write_i64_le(conf_ptr, 8, 0)
        let _wc = ptr_write_u32_le(conf_ptr, 16, f64_to_f32_bits(0.0))
        let _wj = ptr_write_u32_le(conf_ptr, 20, 0)
        qwen3_conformal_fill_weights_for_mode(conf_ptr, page_arena_ptr(&weights_arena), m.cfg.layers, quant_mode)
        let lm_p = qwen3_model_tensor_host_ptr(m, 2)
        let lm_dt = qwen3_model_tensor_dtype(m, 2)
        if !qwen3_compute_row_scale_cpu(lm_p, lm_dt, conf_ptr, m.cfg.vocab, m.cfg.hidden) {
            ok = false
        } else if !qwen3_compute_tile_smax_cpu(conf_ptr, tile_smax_off, m.cfg.vocab) {
            ok = false
        }
    }

    Qwen3ConformalCtx {
        conf_arena: conf_arena,
        weights_arena: weights_arena,
        b_conf: 0,
        pipes: conformal_q8_metal_pipelines_empty(),
        n_layers: m.cfg.layers,
        vocab: m.cfg.vocab,
        tile_smax_off: tile_smax_off,
        tile_summary_off: tile_summary_off,
        q_threshold: q_val,
        ok: ok,
    }
}

pub fn qwen3_conformal_ctx_free(c: Qwen3ConformalCtx, rt: &Qwen3MetalRunner) -> i64 with IO, Mut {
    let Qwen3ConformalCtx {
        conf_arena,
        weights_arena,
        b_conf,
        pipes: _,
        n_layers: _,
        vocab: _,
        tile_smax_off: _,
        tile_summary_off: _,
        q_threshold: _,
        ok: _,
    } = c
    if b_conf > 0 {
        let _f = metal_buffer_free(&rt.sess, b_conf)
    }
    let _fc = page_arena_free(conf_arena)
    let _fw = page_arena_free(weights_arena)
    0
}

pub fn qwen3_conformal_ctx_free_cpu(c: Qwen3ConformalCtx) -> i64 with IO, Mut {
    let Qwen3ConformalCtx {
        conf_arena,
        weights_arena,
        b_conf: _,
        pipes: _,
        n_layers: _,
        vocab: _,
        tile_smax_off: _,
        tile_summary_off: _,
        q_threshold: _,
        ok: _,
    } = c
    let _fc = page_arena_free(conf_arena)
    let _fw = page_arena_free(weights_arena)
    0
}

fn qwen3_metal_encode_quant_gemv(
    rt: &Qwen3MetalRunner,
    cid: i64,
    conf: &Qwen3ConformalCtx,
    bits: i64,
    b_q: i64,
    w_off: i64,
    x_off: i64,
    y_off: i64,
    out_dim: i64,
    in_dim: i64
) -> i64 {
    if bits == 4 {
        qwen3_metal_encode_gemv_q4_fast(&rt.sess, cid, conf.pipes.q4_gemv_fast, b_q, w_off, rt.b_work, x_off, rt.b_work, y_off, out_dim, in_dim)
    } else {
        qwen3_metal_encode_gemv_q8_fast(&rt.sess, cid, conf.pipes.q8_gemv_fast, b_q, w_off, rt.b_work, x_off, rt.b_work, y_off, out_dim, in_dim)
    }
}

fn qwen3_cpu_quant_gemv_fast(
    bits: i64,
    w_ptr: i64,
    x_ptr: i64,
    y_ptr: i64,
    out_dim: i64,
    in_dim: i64
) -> bool with Mut, Div {
    if bits == 4 {
        qwen3_gemv_q4_fast_cpu(w_ptr, x_ptr, y_ptr, out_dim, in_dim)
    } else {
        qwen3_gemv_q8_fast_cpu(w_ptr, x_ptr, y_ptr, out_dim, in_dim)
    }
}

fn qwen3_forward_token_q8_try_inner_metal(
    m: &Qwen3Model,
    em: &Qwen3EisaModel,
    conf: &Qwen3ConformalCtx,
    kv: &!Qwen3PagedKv,
    rt: &Qwen3MetalRunner,
    token_id: i64,
    pos: i64,
    compute_logits: bool,
    attn_bf16: bool
) -> EisaConeCert with Mut, Div, Panic {
    if !m.ok || !em.ok || !conf.ok || !rt.ok || !qwen3_kv_is_ok(kv) || token_id < 0 || token_id >= m.cfg.vocab || pos < 0 {
        return eisa_certify_global(0, 0, 0)
    }
    if !qwen3_kv_ensure_pos(kv, pos) {
        return eisa_certify_global(0, 0, 0)
    }

    let a_base = page_arena_ptr(&m.arena)
    let buf_x = a_base + m.buf_x_off

    let emb_ptr = qwen3_model_tensor_host_ptr(m, 0)
    let emb_dt = qwen3_model_tensor_dtype(m, 0)
    let emb_elem_b = if emb_dt == 2 { 2 } else { 4 }
    let row_p = emb_ptr + token_id * m.cfg.hidden * emb_elem_b

    var i: i64 = 0
    while i < m.cfg.hidden {
        let v = if emb_dt == 2 {
            bf16_bits_to_f64_exact(ptr_read_u16_le(row_p, i * 2))
        } else {
            f32_bits_to_f64(ptr_read_u32_le(row_p, i * 4))
        }
        let _w = ptr_write_u32_le(buf_x, i * 4, f64_to_f32_bits(v))
        i = i + 1
    }

    let eps_bits = f64_to_f32_bits(m.cfg.eps)
    let theta_bits = f64_to_f32_bits(m.cfg.rope_theta)

    let cid = metal_cmd_begin(&rt.sess)
    if cid <= 0 { return eisa_certify_global(0, 0, 0) }

    let meta_base = page_arena_ptr(&em.meta_arena)
    let weights_base = page_arena_ptr(&conf.weights_arena)
    let q_bits = em.quant_bits

    if m.cfg.layers > 0 {
        let in_norm_s0 = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, 3))
        let in_norm_off0 = qwen3_model_tensor_data_off(m, 3)
        let in_norm_dt0 = qwen3_model_tensor_dtype(m, 3)
        let in_norm_pipe0 = if in_norm_dt0 == 2 { rt.pipes.rmsnorm_bf16 } else { rt.pipes.rmsnorm_f32 }
        if qwen3_metal_encode_rmsnorm(
            &rt.sess, cid, in_norm_pipe0,
            rt.b_work, m.buf_x_off,
            in_norm_s0, in_norm_off0,
            rt.b_work, m.buf_h_off,
            1, m.cfg.hidden, eps_bits
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return eisa_certify_global(0, 0, 0)
        }
    }

    var l: i64 = 0
    while l < m.cfg.layers {
        let slot_base = 3 + l * 11

        if attn_bf16 {
            let q_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, slot_base + 1))
            let q_off = qwen3_model_tensor_data_off(m, slot_base + 1)
            let q_dt = qwen3_model_tensor_dtype(m, slot_base + 1)
            let k_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, slot_base + 2))
            let k_off = qwen3_model_tensor_data_off(m, slot_base + 2)
            let k_dt = qwen3_model_tensor_dtype(m, slot_base + 2)
            let v_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, slot_base + 3))
            let v_off = qwen3_model_tensor_data_off(m, slot_base + 3)
            let v_dt = qwen3_model_tensor_dtype(m, slot_base + 3)
            if q_dt == 2 && k_dt == 2 && v_dt == 2 {
                if qwen3_metal_encode_gemv_bf16_qkv(
                    &rt.sess, cid, rt.pipes.gemv_bf16_qkv,
                    q_s, k_s, v_s,
                    rt.b_work, rt.b_work,
                    q_off, k_off, v_off,
                    m.buf_h_off, m.buf_q_off, m.buf_k_off, m.buf_v_off,
                    m.cfg.n_q * m.cfg.head_dim, m.cfg.n_kv * m.cfg.head_dim, m.cfg.hidden
                ) != 0 {
                    let _c = metal_cmd_cancel(&rt.sess, cid)
                    return eisa_certify_global(0, 0, 0)
                }
            } else {
                let q_pipe = if q_dt == 2 { rt.pipes.gemv_bf16 } else { rt.pipes.gemv_f32 }
                if qwen3_metal_encode_gemv(&rt.sess, cid, q_pipe, q_s, q_off, rt.b_work, m.buf_h_off, rt.b_work, m.buf_q_off, m.cfg.n_q * m.cfg.head_dim, m.cfg.hidden) != 0 {
                    let _c = metal_cmd_cancel(&rt.sess, cid)
                    return eisa_certify_global(0, 0, 0)
                }
                let k_pipe = if k_dt == 2 { rt.pipes.gemv_bf16 } else { rt.pipes.gemv_f32 }
                if qwen3_metal_encode_gemv(&rt.sess, cid, k_pipe, k_s, k_off, rt.b_work, m.buf_h_off, rt.b_work, m.buf_k_off, m.cfg.n_kv * m.cfg.head_dim, m.cfg.hidden) != 0 {
                    let _c = metal_cmd_cancel(&rt.sess, cid)
                    return eisa_certify_global(0, 0, 0)
                }
                let v_pipe = if v_dt == 2 { rt.pipes.gemv_bf16 } else { rt.pipes.gemv_f32 }
                if qwen3_metal_encode_gemv(&rt.sess, cid, v_pipe, v_s, v_off, rt.b_work, m.buf_h_off, rt.b_work, m.buf_v_off, m.cfg.n_kv * m.cfg.head_dim, m.cfg.hidden) != 0 {
                    let _c = metal_cmd_cancel(&rt.sess, cid)
                    return eisa_certify_global(0, 0, 0)
                }
            }
        } else {
            let q_off = ptr_read_i64_le(meta_base, (slot_base + 1) * 32 + 0)
            let k_off = ptr_read_i64_le(meta_base, (slot_base + 2) * 32 + 0)
            let v_off = ptr_read_i64_le(meta_base, (slot_base + 3) * 32 + 0)
            let qkv_pipe = if q_bits == 4 { conf.pipes.q4_qkv_fast } else { conf.pipes.q8_qkv_fast }
            if qwen3_metal_encode_gemv_quant_qkv_fast(
                &rt.sess, cid, qkv_pipe,
                em.b_q4, rt.b_work, rt.b_work,
                q_off, k_off, v_off,
                m.buf_h_off, m.buf_q_off, m.buf_k_off, m.buf_v_off,
                m.cfg.n_q * m.cfg.head_dim, m.cfg.n_kv * m.cfg.head_dim, m.cfg.hidden
            ) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return eisa_certify_global(0, 0, 0)
            }
        }

        let q_norm_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, slot_base + 5))
        let q_norm_off = qwen3_model_tensor_data_off(m, slot_base + 5)
        let q_norm_dt = qwen3_model_tensor_dtype(m, slot_base + 5)
        let k_norm_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, slot_base + 6))
        let k_norm_off = qwen3_model_tensor_data_off(m, slot_base + 6)
        let k_norm_dt = qwen3_model_tensor_dtype(m, slot_base + 6)

        if (m.cfg.head_dim & 1) == 0 && q_norm_dt == k_norm_dt {
            let qkn_pipe = if q_norm_dt == 2 { rt.pipes.qk_norm_rope_kv_bf16 } else { rt.pipes.qk_norm_rope_kv_f32 }
            if qwen3_metal_encode_qk_norm_rope_kv_scatter(
                &rt.sess, cid, qkn_pipe,
                rt.b_work, rt.b_work, rt.b_work,
                q_norm_s, k_norm_s, rt.b_kv,
                m.buf_q_off, m.buf_k_off, m.buf_v_off,
                q_norm_off, k_norm_off,
                qwen3_kv_table_off(kv),
                qwen3_kv_k_layer_off(kv, l),
                qwen3_kv_v_layer_off(kv, l),
                m.cfg.n_q, m.cfg.n_kv, m.cfg.head_dim,
                pos, qwen3_kv_block_size(kv),
                eps_bits, rt.b_rope, pos * m.cfg.head_dim * 4
            ) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return eisa_certify_global(0, 0, 0)
            }
        } else {
            let q_norm_pipe = if q_norm_dt == 2 { rt.pipes.rmsnorm_bf16 } else { rt.pipes.rmsnorm_f32 }
            if qwen3_metal_encode_rmsnorm(
                &rt.sess, cid, q_norm_pipe,
                rt.b_work, m.buf_q_off,
                q_norm_s, q_norm_off,
                rt.b_work, m.buf_q_off,
                m.cfg.n_q, m.cfg.head_dim, eps_bits
            ) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return eisa_certify_global(0, 0, 0)
            }

            let k_norm_pipe = if k_norm_dt == 2 { rt.pipes.rmsnorm_bf16 } else { rt.pipes.rmsnorm_f32 }
            if qwen3_metal_encode_rmsnorm(
                &rt.sess, cid, k_norm_pipe,
                rt.b_work, m.buf_k_off,
                k_norm_s, k_norm_off,
                rt.b_work, m.buf_k_off,
                m.cfg.n_kv, m.cfg.head_dim, eps_bits
            ) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return eisa_certify_global(0, 0, 0)
            }

            if qwen3_metal_encode_rope_table(
                &rt.sess, cid, rt.pipes.rope_table,
                rt.b_work, m.buf_q_off,
                rt.b_rope, pos * m.cfg.head_dim * 4,
                m.cfg.n_q, m.cfg.head_dim
            ) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return eisa_certify_global(0, 0, 0)
            }
            if qwen3_metal_encode_rope_table(
                &rt.sess, cid, rt.pipes.rope_table,
                rt.b_work, m.buf_k_off,
                rt.b_rope, pos * m.cfg.head_dim * 4,
                m.cfg.n_kv, m.cfg.head_dim
            ) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return eisa_certify_global(0, 0, 0)
            }

            if qwen3_metal_encode_kv_scatter(
                &rt.sess, cid, rt.pipes.kv_scatter,
                rt.b_work, m.buf_k_off,
                rt.b_work, m.buf_v_off,
                rt.b_kv,
                qwen3_kv_table_off(kv),
                qwen3_kv_k_layer_off(kv, l),
                qwen3_kv_v_layer_off(kv, l),
                m.cfg.n_kv * m.cfg.head_dim,
                pos,
                qwen3_kv_block_size(kv)
            ) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return eisa_certify_global(0, 0, 0)
            }
        }

        if qwen3_metal_encode_paged_gqa(
            &rt.sess, cid, rt.pipes.paged_gqa,
            rt.b_work, m.buf_q_off,
            rt.b_kv,
            qwen3_kv_table_off(kv),
            qwen3_kv_k_layer_off(kv, l),
            qwen3_kv_v_layer_off(kv, l),
            rt.b_work, m.buf_attn_out_off,
            m.cfg.n_q, m.cfg.n_kv, m.cfg.head_dim,
            pos + 1,
            qwen3_kv_block_size(kv)
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return eisa_certify_global(0, 0, 0)
        }

        if attn_bf16 {
            let o_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, slot_base + 4))
            let o_off = qwen3_model_tensor_data_off(m, slot_base + 4)
            let o_dt = qwen3_model_tensor_dtype(m, slot_base + 4)
            let o_pipe = if o_dt == 2 { rt.pipes.gemv_bf16 } else { rt.pipes.gemv_f32 }
            if qwen3_metal_encode_gemv(&rt.sess, cid, o_pipe, o_s, o_off, rt.b_work, m.buf_attn_out_off, rt.b_work, m.buf_h_off, m.cfg.hidden, m.cfg.n_q * m.cfg.head_dim) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return eisa_certify_global(0, 0, 0)
            }
        } else {
            let o_off = ptr_read_i64_le(meta_base, (slot_base + 4) * 32 + 0)
            if qwen3_metal_encode_quant_gemv(rt, cid, conf, q_bits, em.b_q4, o_off, m.buf_attn_out_off, m.buf_h_off, m.cfg.hidden, m.cfg.n_q * m.cfg.head_dim) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return eisa_certify_global(0, 0, 0)
            }
        }

        let post_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, slot_base + 7))
        let post_off = qwen3_model_tensor_data_off(m, slot_base + 7)
        let post_dt = qwen3_model_tensor_dtype(m, slot_base + 7)
        let post_pipe = if post_dt == 2 { rt.pipes.add_rmsnorm_bf16 } else { rt.pipes.add_rmsnorm_f32 }
        if qwen3_metal_encode_add_rmsnorm(
            &rt.sess, cid, post_pipe,
            rt.b_work, rt.b_work, post_s, rt.b_work,
            m.buf_x_off, m.buf_h_off, post_off, m.buf_h_off,
            m.cfg.hidden, eps_bits
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return eisa_certify_global(0, 0, 0)
        }

        let gate_off = ptr_read_i64_le(meta_base, (slot_base + 8) * 32 + 0)
        let up_off = ptr_read_i64_le(meta_base, (slot_base + 9) * 32 + 0)
        let gu_pipe = if q_bits == 4 { conf.pipes.q4_gate_up_swiglu } else { conf.pipes.q8_gate_up_swiglu }
        if qwen3_metal_encode_gemv_quant_gate_up_swiglu(
            &rt.sess, cid, gu_pipe,
            em.b_q4, rt.b_work, rt.b_work,
            gate_off, up_off,
            m.buf_h_off, m.buf_gate_off,
            m.cfg.inter, m.cfg.hidden
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return eisa_certify_global(0, 0, 0)
        }

        let down_off = ptr_read_i64_le(meta_base, (slot_base + 10) * 32 + 0)
        if qwen3_metal_encode_quant_gemv(rt, cid, conf, q_bits, em.b_q4, down_off, m.buf_gate_off, m.buf_h_off, m.cfg.hidden, m.cfg.inter) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return eisa_certify_global(0, 0, 0)
        }

        let lw_bits = ptr_read_u32_le(weights_base, l * 4)
        let reset_bit: i64 = if l == 0 { 1 } else { 0 }
        if l + 1 < m.cfg.layers {
            let accum_bit: i64 = if compute_logits && (l == 0 || lw_bits != 0) { 2 } else { 0 }
            let next_base = 3 + (l + 1) * 11
            let nx_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, next_base))
            let nx_off = qwen3_model_tensor_data_off(m, next_base)
            let nx_dt = qwen3_model_tensor_dtype(m, next_base)
            let nx_pipe = if nx_dt == 2 { conf.pipes.add_accum_rmsnorm_bf16 } else { conf.pipes.add_accum_rmsnorm_f32 }
            if qwen3_metal_encode_add_accum_rmsnorm(
                &rt.sess, cid, nx_pipe,
                rt.b_work, rt.b_work, nx_s, rt.b_work, conf.b_conf,
                m.buf_x_off, m.buf_h_off, nx_off, m.buf_h_off, 0,
                m.cfg.hidden, eps_bits, lw_bits, reset_bit | accum_bit
            ) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return eisa_certify_global(0, 0, 0)
            }
        } else if compute_logits {
            let norm_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, 1))
            let norm_off = qwen3_model_tensor_data_off(m, 1)
            let norm_dt = qwen3_model_tensor_dtype(m, 1)
            let norm_pipe = if norm_dt == 2 { conf.pipes.add_accum_rmsnorm_bf16 } else { conf.pipes.add_accum_rmsnorm_f32 }
            if qwen3_metal_encode_add_accum_rmsnorm(
                &rt.sess, cid, norm_pipe,
                rt.b_work, rt.b_work, norm_s, rt.b_work, conf.b_conf,
                m.buf_x_off, m.buf_h_off, norm_off, m.buf_h_off, 0,
                m.cfg.hidden, eps_bits, lw_bits, reset_bit | 2 | 4
            ) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return eisa_certify_global(0, 0, 0)
            }
        } else {
            if qwen3_metal_encode_vec_add(
                &rt.sess, cid, rt.pipes.vec_add,
                rt.b_work, m.buf_x_off,
                rt.b_work, m.buf_h_off,
                m.cfg.hidden
            ) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return eisa_certify_global(0, 0, 0)
            }
        }

        l = l + 1
    }

    if compute_logits {
        if m.cfg.layers <= 0 {
            let norm_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, 1))
            let norm_off = qwen3_model_tensor_data_off(m, 1)
            let norm_dt = qwen3_model_tensor_dtype(m, 1)
            let norm_pipe = if norm_dt == 2 { rt.pipes.rmsnorm_bf16 } else { rt.pipes.rmsnorm_f32 }
            if qwen3_metal_encode_rmsnorm(
                &rt.sess, cid, norm_pipe,
                rt.b_work, m.buf_x_off,
                norm_s, norm_off,
                rt.b_work, m.buf_h_off,
                1, m.cfg.hidden, eps_bits
            ) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return eisa_certify_global(0, 0, 0)
            }
        }

        let lm_off = ptr_read_i64_le(meta_base, 2 * 32 + 0)
        let head_pipe = if q_bits == 4 { conf.pipes.q4_head_tiled } else { conf.pipes.q8_head_tiled }
        if qwen3_metal_encode_gemv_head_tiled(
            &rt.sess, cid, head_pipe,
            em.b_q4, lm_off,
            rt.b_work, m.buf_h_off,
            conf.b_conf, 0, conf.tile_summary_off,
            rt.b_work, m.buf_logits_off,
            m.cfg.vocab, m.cfg.hidden
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return eisa_certify_global(0, 0, 0)
        }

        if qwen3_metal_encode_certify_pruned_conformal(
            &rt.sess, cid, conf.pipes.certify_pruned,
            rt.b_work, m.buf_logits_off,
            conf.b_conf, 0, conf.tile_smax_off, conf.tile_summary_off,
            rt.b_work, m.buf_top2_off,
            m.cfg.vocab
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return eisa_certify_global(0, 0, 0)
        }
    }

    if metal_cmd_commit_sync(&rt.sess, cid) != 0 {
        return eisa_certify_global(0, 0, 0)
    }

    if !compute_logits {
        return eisa_certify_global(0, 0, 0)
    }

    let pk = a_base + m.buf_top2_off
    let top1_id = ptr_read_i64_le(pk, 0)
    let runner_id = ptr_read_i64_le(pk, 8)
    let cone_size = ptr_read_i64_le(pk, 16)
    let cert_flag = ptr_read_i64_le(pk, 24)
    let top1_bits = ptr_read_u32_le(pk, 32)
    let err_bits = ptr_read_u32_le(pk, 36)
    let mo_bits = ptr_read_u32_le(pk, 40)
    let gm_bits = ptr_read_u32_le(pk, 44)
    let top1_val = f32_bits_to_f64(top1_bits)
    let top1_err = f32_bits_to_f64(err_bits)
    let max_other = f32_bits_to_f64(mo_bits)
    let g_margin = f32_bits_to_f64(gm_bits)

    EisaConeCert {
        top1_id: top1_id,
        runner_up_id: runner_id,
        refined_top1_id: top1_id,
        top1_val: top1_val,
        top1_err: top1_err,
        max_other_upper: max_other,
        global_margin: g_margin,
        cone_size: if cert_flag == 1 { 1 } else { cone_size },
        bf16_rows_touched: 0,
        strict_global_certified: cert_flag == 1,
        refined_exact: cert_flag == 1,
    }
}

pub fn qwen3_forward_token_q8_try_metal(
    m: &Qwen3Model,
    em: &Qwen3EisaModel,
    conf: &Qwen3ConformalCtx,
    kv: &!Qwen3PagedKv,
    rt: &Qwen3MetalRunner,
    token_id: i64,
    pos: i64,
    compute_logits: bool
) -> EisaConeCert with Mut, Div, Panic {
    qwen3_forward_token_q8_try_inner_metal(m, em, conf, kv, rt, token_id, pos, compute_logits, false)
}

fn qwen3_conformal_run_fallback_metal(
    m: &Qwen3Model,
    kv: &!Qwen3PagedKv,
    rt: &Qwen3MetalRunner,
    token_id: i64,
    pos: i64,
    cert: &EisaConeCert,
    escalated_out_ptr: i64
) -> EisaConeCert with Mut, Div, Panic {
    if cert.cone_size <= 0 {
        return eisa_certify_global(0, 0, 0)
    }
    if cert.strict_global_certified {
        if escalated_out_ptr != 0 { let _e1 = ptr_write_i64_le(escalated_out_ptr, 0, 0) }
        return EisaConeCert {
            top1_id: cert.top1_id,
            runner_up_id: cert.runner_up_id,
            refined_top1_id: cert.top1_id,
            top1_val: cert.top1_val,
            top1_err: cert.top1_err,
            max_other_upper: cert.max_other_upper,
            global_margin: cert.global_margin,
            cone_size: 1,
            bf16_rows_touched: 0,
            strict_global_certified: true,
            refined_exact: true,
        }
    }
    if escalated_out_ptr != 0 { let _e2 = ptr_write_i64_le(escalated_out_ptr, 0, 1) }
    let bf_ok = qwen3_forward_token_metal_opt(m, kv, rt, token_id, pos, true)
    if !bf_ok {
        return eisa_certify_global(0, 0, 0)
    }
    let t = qwen3_model_top2(m)
    EisaConeCert {
        top1_id: cert.top1_id,
        runner_up_id: cert.runner_up_id,
        refined_top1_id: t.top1_id,
        top1_val: t.top1_val,
        top1_err: 0.0,
        max_other_upper: t.second_val,
        global_margin: t.top1_val - t.second_val,
        cone_size: cert.cone_size,
        bf16_rows_touched: m.cfg.vocab,
        strict_global_certified: false,
        refined_exact: true,
    }
}

pub fn qwen3_forward_token_q8_conformal_metal_opt(
    m: &Qwen3Model,
    em: &Qwen3EisaModel,
    conf: &Qwen3ConformalCtx,
    kv: &!Qwen3PagedKv,
    rt: &Qwen3MetalRunner,
    token_id: i64,
    pos: i64,
    compute_logits: bool,
    escalated_out_ptr: i64
) -> EisaConeCert with Mut, Div, Panic {
    if escalated_out_ptr != 0 { let _e0 = ptr_write_i64_le(escalated_out_ptr, 0, 0) }
    let cert = qwen3_forward_token_q8_try_inner_metal(m, em, conf, kv, rt, token_id, pos, compute_logits, false)
    if !compute_logits { return cert }
    qwen3_conformal_run_fallback_metal(m, kv, rt, token_id, pos, &cert, escalated_out_ptr)
}

pub fn qwen3_forward_token_q8_mlp_conformal_metal_opt(
    m: &Qwen3Model,
    em: &Qwen3EisaModel,
    conf: &Qwen3ConformalCtx,
    kv: &!Qwen3PagedKv,
    rt: &Qwen3MetalRunner,
    token_id: i64,
    pos: i64,
    compute_logits: bool,
    escalated_out_ptr: i64
) -> EisaConeCert with Mut, Div, Panic {
    if escalated_out_ptr != 0 { let _e0 = ptr_write_i64_le(escalated_out_ptr, 0, 0) }
    let cert = qwen3_forward_token_q8_try_inner_metal(m, em, conf, kv, rt, token_id, pos, compute_logits, true)
    if !compute_logits { return cert }
    qwen3_conformal_run_fallback_metal(m, kv, rt, token_id, pos, &cert, escalated_out_ptr)
}

fn qwen3_forward_token_q8_try_inner_cpu(
    m: &Qwen3Model,
    em: &Qwen3EisaModel,
    conf: &Qwen3ConformalCtx,
    kv: &!Qwen3PagedKv,
    token_id: i64,
    pos: i64,
    compute_logits: bool,
    attn_bf16: bool
) -> EisaConeCert with Mut, Div, Panic {
    if !m.ok || !em.ok || !conf.ok || !qwen3_kv_is_ok(kv) || token_id < 0 || token_id >= m.cfg.vocab || pos < 0 {
        return eisa_certify_global(0, 0, 0)
    }
    if !qwen3_kv_ensure_pos(kv, pos) {
        return eisa_certify_global(0, 0, 0)
    }

    let a_base = page_arena_ptr(&m.arena)
    let buf_x = a_base + m.buf_x_off
    let buf_h = a_base + m.buf_h_off
    let buf_q = a_base + m.buf_q_off
    let buf_k = a_base + m.buf_k_off
    let buf_v = a_base + m.buf_v_off
    let buf_attn_out = a_base + m.buf_attn_out_off
    let buf_gate = a_base + m.buf_gate_off
    let buf_up = a_base + m.buf_up_off
    let buf_logits = a_base + m.buf_logits_off
    let buf_logits_err = a_base + m.buf_logits_err_off

    let emb_ptr = qwen3_model_tensor_host_ptr(m, 0)
    let emb_dt = qwen3_model_tensor_dtype(m, 0)
    let emb_elem_b = if emb_dt == 2 { 2 } else { 4 }
    let row_p = emb_ptr + token_id * m.cfg.hidden * emb_elem_b

    var i: i64 = 0
    while i < m.cfg.hidden {
        let v = if emb_dt == 2 {
            bf16_bits_to_f64_exact(ptr_read_u16_le(row_p, i * 2))
        } else {
            f32_bits_to_f64(ptr_read_u32_le(row_p, i * 4))
        }
        let _w = ptr_write_u32_le(buf_x, i * 4, f64_to_f32_bits(v))
        i = i + 1
    }

    let q8_base = page_arena_ptr(&em.q4_arena)
    let meta_base = page_arena_ptr(&em.meta_arena)
    let conf_ptr = page_arena_ptr(&conf.conf_arena)
    let weights_base = page_arena_ptr(&conf.weights_arena)
    let q_bits = em.quant_bits

    var l: i64 = 0
    while l < m.cfg.layers {
        let slot_base = 3 + l * 11

        let in_norm_p = qwen3_model_tensor_host_ptr(m, slot_base + 0)
        let in_norm_dt = qwen3_model_tensor_dtype(m, slot_base + 0)
        qwen3_cpu_rmsnorm(buf_x, in_norm_p, in_norm_dt, buf_h, 1, m.cfg.hidden, m.cfg.eps)

        if attn_bf16 {
            qwen3_cpu_gemv(qwen3_model_tensor_host_ptr(m, slot_base + 1), qwen3_model_tensor_dtype(m, slot_base + 1), buf_h, buf_q, m.cfg.n_q * m.cfg.head_dim, m.cfg.hidden)
            qwen3_cpu_gemv(qwen3_model_tensor_host_ptr(m, slot_base + 2), qwen3_model_tensor_dtype(m, slot_base + 2), buf_h, buf_k, m.cfg.n_kv * m.cfg.head_dim, m.cfg.hidden)
            qwen3_cpu_gemv(qwen3_model_tensor_host_ptr(m, slot_base + 3), qwen3_model_tensor_dtype(m, slot_base + 3), buf_h, buf_v, m.cfg.n_kv * m.cfg.head_dim, m.cfg.hidden)
        } else {
            let q_off = ptr_read_i64_le(meta_base, (slot_base + 1) * 32 + 0)
            let _qok = qwen3_cpu_quant_gemv_fast(q_bits, q8_base + q_off, buf_h, buf_q, m.cfg.n_q * m.cfg.head_dim, m.cfg.hidden)
            let k_off = ptr_read_i64_le(meta_base, (slot_base + 2) * 32 + 0)
            let _kok = qwen3_cpu_quant_gemv_fast(q_bits, q8_base + k_off, buf_h, buf_k, m.cfg.n_kv * m.cfg.head_dim, m.cfg.hidden)
            let v_off = ptr_read_i64_le(meta_base, (slot_base + 3) * 32 + 0)
            let _vok = qwen3_cpu_quant_gemv_fast(q_bits, q8_base + v_off, buf_h, buf_v, m.cfg.n_kv * m.cfg.head_dim, m.cfg.hidden)
        }

        let q_norm_p = qwen3_model_tensor_host_ptr(m, slot_base + 5)
        let q_norm_dt = qwen3_model_tensor_dtype(m, slot_base + 5)
        qwen3_cpu_rmsnorm(buf_q, q_norm_p, q_norm_dt, buf_q, m.cfg.n_q, m.cfg.head_dim, m.cfg.eps)

        let k_norm_p = qwen3_model_tensor_host_ptr(m, slot_base + 6)
        let k_norm_dt = qwen3_model_tensor_dtype(m, slot_base + 6)
        qwen3_cpu_rmsnorm(buf_k, k_norm_p, k_norm_dt, buf_k, m.cfg.n_kv, m.cfg.head_dim, m.cfg.eps)

        qwen3_cpu_rope(buf_q, m.cfg.n_q, m.cfg.head_dim, pos, m.cfg.rope_theta)
        qwen3_cpu_rope(buf_k, m.cfg.n_kv, m.cfg.head_dim, pos, m.cfg.rope_theta)

        let wk_ok = qwen3_kv_write_kv_f32_buf(kv, l, pos, buf_k, buf_v)
        if !wk_ok { return eisa_certify_global(0, 0, 0) }

        qwen3_cpu_paged_gqa(buf_q, kv, l, buf_attn_out, m.cfg.n_q, m.cfg.n_kv, m.cfg.head_dim, pos)

        if attn_bf16 {
            qwen3_cpu_gemv(qwen3_model_tensor_host_ptr(m, slot_base + 4), qwen3_model_tensor_dtype(m, slot_base + 4), buf_attn_out, buf_h, m.cfg.hidden, m.cfg.n_q * m.cfg.head_dim)
        } else {
            let o_off = ptr_read_i64_le(meta_base, (slot_base + 4) * 32 + 0)
            let _ook = qwen3_cpu_quant_gemv_fast(q_bits, q8_base + o_off, buf_attn_out, buf_h, m.cfg.hidden, m.cfg.n_q * m.cfg.head_dim)
        }
        qwen3_cpu_vec_add(buf_x, buf_h, m.cfg.hidden)

        let post_p = qwen3_model_tensor_host_ptr(m, slot_base + 7)
        let post_dt = qwen3_model_tensor_dtype(m, slot_base + 7)
        qwen3_cpu_rmsnorm(buf_x, post_p, post_dt, buf_h, 1, m.cfg.hidden, m.cfg.eps)

        let gate_off = ptr_read_i64_le(meta_base, (slot_base + 8) * 32 + 0)
        let _gok = qwen3_cpu_quant_gemv_fast(q_bits, q8_base + gate_off, buf_h, buf_gate, m.cfg.inter, m.cfg.hidden)

        let up_off = ptr_read_i64_le(meta_base, (slot_base + 9) * 32 + 0)
        let _uok = qwen3_cpu_quant_gemv_fast(q_bits, q8_base + up_off, buf_h, buf_up, m.cfg.inter, m.cfg.hidden)

        qwen3_cpu_swiglu(buf_gate, buf_up, buf_gate, m.cfg.inter)

        let down_off = ptr_read_i64_le(meta_base, (slot_base + 10) * 32 + 0)
        let _dok = qwen3_cpu_quant_gemv_fast(q_bits, q8_base + down_off, buf_gate, buf_h, m.cfg.hidden, m.cfg.inter)

        let lw_bits = ptr_read_u32_le(weights_base, l * 4)
        if compute_logits && (l == 0 || lw_bits != 0) {
            let reset_flag: i64 = if l == 0 { 1 } else { 0 }
            let lw = f32_bits_to_f64(lw_bits)
            let _va = qwen3_vec_add_accum_norm_cpu(buf_x, buf_h, conf_ptr, m.cfg.hidden, lw, reset_flag)
        } else {
            qwen3_cpu_vec_add(buf_x, buf_h, m.cfg.hidden)
        }

        l = l + 1
    }

    if !compute_logits {
        return eisa_certify_global(0, 0, 0)
    }

    let _ji = qwen3_conformal_apply_final_inv_rms_cpu(buf_x, conf_ptr, m.cfg.hidden, m.cfg.eps)

    let norm_p = qwen3_model_tensor_host_ptr(m, 1)
    let norm_dt = qwen3_model_tensor_dtype(m, 1)
    qwen3_cpu_rmsnorm(buf_x, norm_p, norm_dt, buf_h, 1, m.cfg.hidden, m.cfg.eps)

    let lm_off = ptr_read_i64_le(meta_base, 2 * 32 + 0)
    let _lok = qwen3_gemv_head_tiled_cpu(q_bits, q8_base + lm_off, buf_h, conf_ptr, conf.tile_summary_off, buf_logits, m.cfg.vocab, m.cfg.hidden)
    qwen3_certify_pruned_conformal_cpu(buf_logits, conf_ptr, conf.tile_smax_off, conf.tile_summary_off, m.cfg.vocab)
}

pub fn qwen3_forward_token_q8_try_cpu(
    m: &Qwen3Model,
    em: &Qwen3EisaModel,
    conf: &Qwen3ConformalCtx,
    kv: &!Qwen3PagedKv,
    token_id: i64,
    pos: i64,
    compute_logits: bool
) -> EisaConeCert with Mut, Div, Panic {
    qwen3_forward_token_q8_try_inner_cpu(m, em, conf, kv, token_id, pos, compute_logits, false)
}

fn qwen3_conformal_run_fallback_cpu(
    m: &Qwen3Model,
    kv: &!Qwen3PagedKv,
    token_id: i64,
    pos: i64,
    cert: &EisaConeCert,
    escalated_out_ptr: i64
) -> EisaConeCert with Alloc, Mut, Div, Panic {
    if cert.cone_size <= 0 {
        return eisa_certify_global(0, 0, 0)
    }
    if cert.strict_global_certified {
        if escalated_out_ptr != 0 { let _e1 = ptr_write_i64_le(escalated_out_ptr, 0, 0) }
        return EisaConeCert {
            top1_id: cert.top1_id,
            runner_up_id: cert.runner_up_id,
            refined_top1_id: cert.top1_id,
            top1_val: cert.top1_val,
            top1_err: cert.top1_err,
            max_other_upper: cert.max_other_upper,
            global_margin: cert.global_margin,
            cone_size: 1,
            bf16_rows_touched: 0,
            strict_global_certified: true,
            refined_exact: true,
        }
    }
    if escalated_out_ptr != 0 { let _e2 = ptr_write_i64_le(escalated_out_ptr, 0, 1) }
    let bf_ok = qwen3_forward_token_cpu(m, kv, token_id, pos)
    if !bf_ok {
        return eisa_certify_global(0, 0, 0)
    }
    let t = qwen3_model_top2(m)
    EisaConeCert {
        top1_id: cert.top1_id,
        runner_up_id: cert.runner_up_id,
        refined_top1_id: t.top1_id,
        top1_val: t.top1_val,
        top1_err: 0.0,
        max_other_upper: t.second_val,
        global_margin: t.top1_val - t.second_val,
        cone_size: cert.cone_size,
        bf16_rows_touched: m.cfg.vocab,
        strict_global_certified: false,
        refined_exact: true,
    }
}

pub fn qwen3_forward_token_q8_conformal_cpu(
    m: &Qwen3Model,
    em: &Qwen3EisaModel,
    conf: &Qwen3ConformalCtx,
    kv: &!Qwen3PagedKv,
    token_id: i64,
    pos: i64,
    compute_logits: bool,
    escalated_out_ptr: i64
) -> EisaConeCert with Alloc, Mut, Div, Panic {
    if escalated_out_ptr != 0 { let _e0 = ptr_write_i64_le(escalated_out_ptr, 0, 0) }
    let cert = qwen3_forward_token_q8_try_inner_cpu(m, em, conf, kv, token_id, pos, compute_logits, false)
    if !compute_logits { return cert }
    qwen3_conformal_run_fallback_cpu(m, kv, token_id, pos, &cert, escalated_out_ptr)
}

pub fn qwen3_forward_token_q8_mlp_conformal_cpu(
    m: &Qwen3Model,
    em: &Qwen3EisaModel,
    conf: &Qwen3ConformalCtx,
    kv: &!Qwen3PagedKv,
    token_id: i64,
    pos: i64,
    compute_logits: bool,
    escalated_out_ptr: i64
) -> EisaConeCert with Alloc, Mut, Div, Panic {
    if escalated_out_ptr != 0 { let _e0 = ptr_write_i64_le(escalated_out_ptr, 0, 0) }
    let cert = qwen3_forward_token_q8_try_inner_cpu(m, em, conf, kv, token_id, pos, compute_logits, true)
    if !compute_logits { return cert }
    qwen3_conformal_run_fallback_cpu(m, kv, token_id, pos, &cert, escalated_out_ptr)
}

// =========================================================================
// Native CUDA Driver + PTX Runner (libcuda.so.1 only; zero toolkit/cuBLAS)
// =========================================================================

pub linear struct Qwen3CudaRunner {
    pub sess: CudaDriverSession,
    pub hmod: i64,
    pub fn_embed: i64,
    pub fn_vec_add: i64,
    pub fn_swiglu: i64,
    pub fn_rmsnorm: i64,
    pub fn_add_accum_rmsnorm: i64,
    pub fn_qk_rope_kv: i64,
    pub fn_paged_gqa: i64,
    pub fn_gemv_bf16: i64,
    pub fn_argmax_top2: i64,
    pub fn_gemm_bf16_simt: i64,
    pub fn_gemm_bf16_tc: i64,
    pub d_fma_audit_hits: i64,
    pub fn_quantize_q4: i64,
    pub fn_row_scale: i64,
    pub fn_tile_smax: i64,
    pub fn_gemv_q4_fast: i64,
    pub fn_summarize_tiles: i64,
    pub fn_certify_pruned: i64,
    pub fn_quantize_q4_soa: i64,
    pub fn_gemv_q4_soa: i64,
    pub d_s0: i64,
    pub d_s1: i64,
    pub d_s2: i64,
    pub d_s3: i64,
    pub d_s4: i64,
    pub d_s5: i64,
    pub d_s6: i64,
    pub d_s7: i64,
    pub d_nonlin: i64,
    pub nonlin_meta_arena: PageArena,
    pub d_work: i64,
    pub d_k_cache: i64,
    pub d_v_cache: i64,
    pub d_rope: i64,
    pub max_seq_cap: i64,
    pub kv_dim: i64,
    pub ok: bool,
}

fn qwen3_cuda_runner_empty(sess: CudaDriverSession) -> Qwen3CudaRunner {
    Qwen3CudaRunner {
        sess: sess,
        hmod: 0,
        fn_embed: 0,
        fn_vec_add: 0,
        fn_swiglu: 0,
        fn_rmsnorm: 0,
        fn_add_accum_rmsnorm: 0,
        fn_qk_rope_kv: 0,
        fn_paged_gqa: 0,
        fn_gemv_bf16: 0,
        fn_argmax_top2: 0,
        fn_gemm_bf16_simt: 0,
        fn_gemm_bf16_tc: 0,
        d_fma_audit_hits: 0,
        fn_quantize_q4: 0,
        fn_row_scale: 0,
        fn_tile_smax: 0,
        fn_gemv_q4_fast: 0,
        fn_summarize_tiles: 0,
        fn_certify_pruned: 0,
        fn_quantize_q4_soa: 0,
        fn_gemv_q4_soa: 0,
        d_s0: 0,
        d_s1: 0,
        d_s2: 0,
        d_s3: 0,
        d_s4: 0,
        d_s5: 0,
        d_s6: 0,
        d_s7: 0,
        d_nonlin: 0,
        nonlin_meta_arena: PageArena { ptr: 0, len: 0, ok: false },
        d_work: 0,
        d_k_cache: 0,
        d_v_cache: 0,
        d_rope: 0,
        max_seq_cap: 0,
        kv_dim: 0,
        ok: false,
    }
}

pub fn qwen3_cuda_runner_is_ok(rt: &Qwen3CudaRunner) -> bool {
    rt.ok
}

fn qwen3_cuda_upload_shard(sess: &CudaDriverSession, sh: &MappedShard, active: bool) -> i64 with Alloc {
    if !active { return 0 }
    let slen = mapped_shard_len(sh)
    let sptr = mapped_shard_ptr(sh)
    if slen <= 0 || sptr <= 0 { return 0 }
    let dptr = cuda_mem_alloc(sess, slen)
    if dptr == 0 { return 0 }
    if cuda_memcpy_h2d(sess, dptr, sptr, slen) != 0 {
        let _f = cuda_mem_free(sess, dptr)
        return 0
    }
    dptr
}

pub fn qwen3_cuda_print_info(rt: &Qwen3CudaRunner) with IO, Alloc, Mut {
    if !rt.ok { return }
    let nbuf = heap_alloc(128) as i64
    let _rc = cuda_session_get_name_cstr(&rt.sess, nbuf, 128)
    let sm = cuda_session_sm_version(&rt.sess)
    let drv = cuda_session_driver_version(&rt.sess)
    print("[cuda] device=\"")
    var i: i64 = 0
    while i < 127 {
        let c = ptr_read_u8(nbuf, i)
        if c == 0 { break }
        print_char(c as i32)
        i = i + 1
    }
    heap_free(nbuf as *mut u8)
    print("\" sm=")
    print_int(sm)
    print(" driver=")
    print_int(drv)
    print("\n")
}

fn qwen3_cuda_runner_init_impl(
    m: &Qwen3Model,
    max_seq_cap: i64,
    driver_path: string,
    ordinal: i64,
    q4_only: bool,
    use_audit_ptx: bool
) -> Qwen3CudaRunner with IO, Alloc, Mut, Div, Panic {
    let sess = cuda_session_open(driver_path, ordinal)
    var init_ok = m.ok && cuda_session_is_ok(&sess) && max_seq_cap > 0

    var hmod: i64 = 0
    var fn_embed: i64 = 0
    var fn_vec_add: i64 = 0
    var fn_swiglu: i64 = 0
    var fn_rmsnorm: i64 = 0
    var fn_add_accum_rmsnorm: i64 = 0
    var fn_qk_rope_kv: i64 = 0
    var fn_paged_gqa: i64 = 0
    var fn_gemv_bf16: i64 = 0
    var fn_argmax_top2: i64 = 0
    var fn_gemm_bf16_simt: i64 = 0
    var fn_gemm_bf16_tc: i64 = 0
    var d_fma_audit_hits: i64 = 0
    var fn_quantize_q4: i64 = 0
    var fn_row_scale: i64 = 0
    var fn_tile_smax: i64 = 0
    var fn_gemv_q4_fast: i64 = 0
    var fn_summarize_tiles: i64 = 0
    var fn_certify_pruned: i64 = 0
    var fn_quantize_q4_soa: i64 = 0
    var fn_gemv_q4_soa: i64 = 0

    if init_ok {
        let eff_sm = cuda_session_sm_version(&sess)
        let drv_ver = cuda_session_driver_version(&sess)
        if eff_sm < 60 {
            print("[cuda-ptx] unsupported compute capability sm=")
            print_int(eff_sm)
            println(" (minimum sm_70 Volta / V100)")
            init_ok = false
        } else {
            let c_ptx = if use_audit_ptx {
                emit_qwen3_cuda_audit_ptx_for_sm(eff_sm, drv_ver)
            } else {
                emit_qwen3_cuda_runner_ptx_for_sm(eff_sm, drv_ver)
            }
            let err_cap: i64 = 4096
            let err_buf = heap_alloc(err_cap) as i64
            let _ez = ptr_write_u8(err_buf, 0, 0)
            hmod = cuda_module_load_ptx_ptr_ex(&sess, c_ptx, err_buf, err_cap)
            heap_free(c_ptx as *mut u8)
            if hmod == 0 {
                print("[cuda-ptx] failed to load runner PTX module")
                if ptr_read_u8(err_buf, 0) != 0 {
                    print(": ")
                    var ei: i64 = 0
                    while ei < 1024 {
                        let b = ptr_read_u8(err_buf, ei)
                        if b == 0 { break }
                        print_char(b as i32)
                        ei = ei + 1
                    }
                }
                println("")
                init_ok = false
            }
            heap_free(err_buf as *mut u8)
        }
    }

    if init_ok {
        fn_embed = cuda_module_get_fn(&sess, hmod, "cuda_embed_lookup")
        fn_vec_add = cuda_module_get_fn(&sess, hmod, "cuda_vec_add_f32")
        fn_swiglu = cuda_module_get_fn(&sess, hmod, "cuda_swiglu_f32")
        fn_rmsnorm = cuda_module_get_fn(&sess, hmod, "cuda_rmsnorm")
        fn_add_accum_rmsnorm = cuda_module_get_fn(&sess, hmod, "cuda_add_accum_rmsnorm")
        fn_qk_rope_kv = cuda_module_get_fn(&sess, hmod, "cuda_qk_norm_rope_kv_scatter")
        fn_paged_gqa = cuda_module_get_fn(&sess, hmod, "cuda_paged_gqa_warp")
        fn_gemv_bf16 = cuda_module_get_fn(&sess, hmod, "cuda_gemv_bf16")
        fn_argmax_top2 = cuda_module_get_fn(&sess, hmod, "cuda_argmax_top2_f32")
        fn_gemm_bf16_simt = cuda_module_get_fn(&sess, hmod, "cuda_gemm_bf16_simt")
        fn_gemm_bf16_tc = cuda_module_get_fn(&sess, hmod, "cuda_gemm_bf16_tc")
        fn_quantize_q4 = cuda_module_get_fn(&sess, hmod, "cuda_quantize_q4_eisa")
        fn_row_scale = cuda_module_get_fn(&sess, hmod, "cuda_compute_row_scale")
        fn_tile_smax = cuda_module_get_fn(&sess, hmod, "cuda_compute_tile_smax")
        fn_gemv_q4_fast = cuda_module_get_fn(&sess, hmod, "cuda_gemv_q4_fast")
        fn_summarize_tiles = cuda_module_get_fn(&sess, hmod, "cuda_summarize_tiles_f32")
        fn_certify_pruned = cuda_module_get_fn(&sess, hmod, "cuda_certify_pruned_conformal")
        fn_quantize_q4_soa = cuda_module_get_fn(&sess, hmod, "cuda_quantize_q4_soa")
        fn_gemv_q4_soa = cuda_module_get_fn(&sess, hmod, "cuda_gemv_q4_soa")
        if use_audit_ptx {
            d_fma_audit_hits = cuda_module_get_global(&sess, hmod, "g_fma_min_norm_hits")
        }

        if fn_embed == 0 || fn_vec_add == 0 || fn_swiglu == 0 || fn_rmsnorm == 0
            || fn_add_accum_rmsnorm == 0 || fn_qk_rope_kv == 0 || fn_paged_gqa == 0
            || fn_gemv_bf16 == 0 || fn_argmax_top2 == 0
            || fn_gemm_bf16_simt == 0 || fn_gemm_bf16_tc == 0
            || fn_quantize_q4 == 0
            || fn_row_scale == 0 || fn_tile_smax == 0 || fn_gemv_q4_fast == 0
            || fn_summarize_tiles == 0 || fn_certify_pruned == 0
            || fn_quantize_q4_soa == 0 || fn_gemv_q4_soa == 0
            || (use_audit_ptx && d_fma_audit_hits == 0) {
            println("[cuda-ptx] failed to resolve one or more runner kernel entry points")
            let _u = cuda_module_unload(&sess, hmod)
            hmod = 0
            init_ok = false
        }
    }

    let up_shards = init_ok && !q4_only
    let d_s0 = qwen3_cuda_upload_shard(&sess, &m.s0, up_shards && m.n_shards >= 1)
    let d_s1 = qwen3_cuda_upload_shard(&sess, &m.s1, up_shards && m.n_shards >= 2)
    let d_s2 = qwen3_cuda_upload_shard(&sess, &m.s2, up_shards && m.n_shards >= 3)
    let d_s3 = qwen3_cuda_upload_shard(&sess, &m.s3, up_shards && m.n_shards >= 4)
    let d_s4 = qwen3_cuda_upload_shard(&sess, &m.s4, up_shards && m.n_shards >= 5)
    let d_s5 = qwen3_cuda_upload_shard(&sess, &m.s5, up_shards && m.n_shards >= 6)
    let d_s6 = qwen3_cuda_upload_shard(&sess, &m.s6, up_shards && m.n_shards >= 7)
    let d_s7 = qwen3_cuda_upload_shard(&sess, &m.s7, up_shards && m.n_shards >= 8)

    let total_slots = 3 + m.cfg.layers * 11
    let nonlin_meta_arena = if init_ok && q4_only {
        page_arena_alloc(q4_soa_align_up_64(total_slots * 8))
    } else {
        PageArena { ptr: 0, len: 0, ok: false }
    }
    var d_nonlin: i64 = 0
    var nonlin_ok = true
    if init_ok && q4_only {
        var nl_bytes: i64 = 0
        var si: i64 = 0
        while si < total_slots {
            if !qwen3_slot_matches_mask(si, false) {
                let rows = qwen3_model_tensor_rows(m, si)
                let cols = qwen3_model_tensor_cols(m, si)
                let dt = qwen3_model_tensor_dtype(m, si)
                let elems = if cols > 0 { rows * cols } else { rows }
                let elem_b: i64 = if dt == 2 { 2 } else { 4 }
                nl_bytes = nl_bytes + q4_soa_align_up_64(elems * elem_b)
            }
            si = si + 1
        }
        nl_bytes = q4_soa_align_up_64(nl_bytes + 64)
        d_nonlin = cuda_mem_alloc(&sess, nl_bytes)
        nonlin_ok = page_arena_is_ok(&nonlin_meta_arena) && d_nonlin != 0
        if nonlin_ok {
            let nl_meta = page_arena_ptr(&nonlin_meta_arena)
            var cur_nl_off: i64 = 0
            si = 0
            while si < total_slots && nonlin_ok {
                if !qwen3_slot_matches_mask(si, false) {
                    let rows = qwen3_model_tensor_rows(m, si)
                    let cols = qwen3_model_tensor_cols(m, si)
                    let dt = qwen3_model_tensor_dtype(m, si)
                    let hp = qwen3_model_tensor_host_ptr(m, si)
                    let elems = if cols > 0 { rows * cols } else { rows }
                    let elem_b: i64 = if dt == 2 { 2 } else { 4 }
                    let b_len = elems * elem_b
                    if b_len <= 0 || hp == 0 || cuda_memcpy_h2d(&sess, d_nonlin + cur_nl_off, hp, b_len) != 0 {
                        nonlin_ok = false
                    }
                    let _wo = ptr_write_i64_le(nl_meta, si * 8, cur_nl_off)
                    cur_nl_off = cur_nl_off + q4_soa_align_up_64(b_len)
                } else {
                    let _wo = ptr_write_i64_le(nl_meta, si * 8, -1)
                }
                si = si + 1
            }
        }
    }

    let work_bytes = page_arena_len(&m.arena)
    let d_work = if init_ok && work_bytes > 0 { cuda_mem_alloc(&sess, work_bytes) } else { 0 }
    let kv_dim = m.cfg.n_kv * m.cfg.head_dim
    let kv_bytes = if init_ok && kv_dim > 0 { align_up_64(m.cfg.layers * max_seq_cap * kv_dim * 4) } else { 0 }
    let d_k_cache = if init_ok && kv_bytes > 0 { cuda_mem_alloc(&sess, kv_bytes) } else { 0 }
    let d_v_cache = if init_ok && kv_bytes > 0 { cuda_mem_alloc(&sess, kv_bytes) } else { 0 }

    let rope_bytes = if init_ok && m.cfg.head_dim > 0 { align_up_64(max_seq_cap * m.cfg.head_dim * 4) } else { 0 }
    let d_rope = if init_ok && rope_bytes > 0 { cuda_mem_alloc(&sess, rope_bytes) } else { 0 }
    var rope_ok = d_rope != 0
    if init_ok && rope_ok {
        let h_rope = heap_alloc(rope_bytes) as i64
        if h_rope == 0 || !qwen3_fill_rope_table(h_rope, max_seq_cap, m.cfg.head_dim, m.cfg.rope_theta) {
            rope_ok = false
        } else if cuda_memcpy_h2d(&sess, d_rope, h_rope, rope_bytes) != 0 {
            rope_ok = false
        }
        if h_rope != 0 { heap_free(h_rope as *mut u8) }
    }

    let shards_ok = if q4_only {
        nonlin_ok && d_nonlin != 0
    } else {
        (m.n_shards <= 0 || d_s0 != 0) && (m.n_shards <= 1 || d_s1 != 0)
            && (m.n_shards <= 2 || d_s2 != 0) && (m.n_shards <= 3 || d_s3 != 0)
            && (m.n_shards <= 4 || d_s4 != 0) && (m.n_shards <= 5 || d_s5 != 0)
            && (m.n_shards <= 6 || d_s6 != 0) && (m.n_shards <= 7 || d_s7 != 0)
    }
    let ok = init_ok && shards_ok && d_work != 0 && d_k_cache != 0 && d_v_cache != 0 && rope_ok
        && (!use_audit_ptx || d_fma_audit_hits != 0)
        && cuda_ctx_sync(&sess) == 0

    let rt = Qwen3CudaRunner {
        sess: sess,
        hmod: hmod,
        fn_embed: fn_embed,
        fn_vec_add: fn_vec_add,
        fn_swiglu: fn_swiglu,
        fn_rmsnorm: fn_rmsnorm,
        fn_add_accum_rmsnorm: fn_add_accum_rmsnorm,
        fn_qk_rope_kv: fn_qk_rope_kv,
        fn_paged_gqa: fn_paged_gqa,
        fn_gemv_bf16: fn_gemv_bf16,
        fn_argmax_top2: fn_argmax_top2,
        fn_gemm_bf16_simt: fn_gemm_bf16_simt,
        fn_gemm_bf16_tc: fn_gemm_bf16_tc,
        d_fma_audit_hits: d_fma_audit_hits,
        fn_quantize_q4: fn_quantize_q4,
        fn_row_scale: fn_row_scale,
        fn_tile_smax: fn_tile_smax,
        fn_gemv_q4_fast: fn_gemv_q4_fast,
        fn_summarize_tiles: fn_summarize_tiles,
        fn_certify_pruned: fn_certify_pruned,
        fn_quantize_q4_soa: fn_quantize_q4_soa,
        fn_gemv_q4_soa: fn_gemv_q4_soa,
        d_s0: d_s0,
        d_s1: d_s1,
        d_s2: d_s2,
        d_s3: d_s3,
        d_s4: d_s4,
        d_s5: d_s5,
        d_s6: d_s6,
        d_s7: d_s7,
        d_nonlin: d_nonlin,
        nonlin_meta_arena: nonlin_meta_arena,
        d_work: d_work,
        d_k_cache: d_k_cache,
        d_v_cache: d_v_cache,
        d_rope: d_rope,
        max_seq_cap: max_seq_cap,
        kv_dim: kv_dim,
        ok: ok,
    }
    let v_env = hal_getenv_ptr("SOUNIO_CUDA_VERBOSE")
    if ok && v_env != 0 && ptr_read_u8(v_env, 0) == 49 {
        qwen3_cuda_print_info(&rt)
    }
    rt
}

pub fn qwen3_cuda_runner_init_mode(
    m: &Qwen3Model,
    max_seq_cap: i64,
    driver_path: string,
    ordinal: i64,
    q4_only: bool
) -> Qwen3CudaRunner with IO, Alloc, Mut, Div, Panic {
    qwen3_cuda_runner_init_impl(m, max_seq_cap, driver_path, ordinal, q4_only, false)
}

pub fn qwen3_cuda_runner_init(
    m: &Qwen3Model,
    max_seq_cap: i64,
    driver_path: string,
    ordinal: i64
) -> Qwen3CudaRunner with IO, Alloc, Mut, Div, Panic {
    qwen3_cuda_runner_init_impl(m, max_seq_cap, driver_path, ordinal, false, false)
}

pub fn qwen3_cuda_runner_init_audit(
    m: &Qwen3Model,
    max_seq_cap: i64,
    driver_path: string,
    ordinal: i64
) -> Qwen3CudaRunner with IO, Alloc, Mut, Div, Panic {
    qwen3_cuda_runner_init_impl(m, max_seq_cap, driver_path, ordinal, false, true)
}

pub fn qwen3_cuda_audit_reset_fma_hits(rt: &Qwen3CudaRunner) -> bool with Alloc, Mut {
    if !rt.ok || rt.d_fma_audit_hits == 0 { return false }
    let z = heap_alloc(8) as i64
    if z == 0 { return false }
    let _w = ptr_write_i64_le(z, 0, 0)
    let rc = cuda_memcpy_h2d(&rt.sess, rt.d_fma_audit_hits, z, 8)
    heap_free(z as *mut u8)
    rc == 0
}

pub fn qwen3_cuda_audit_read_fma_hits(rt: &Qwen3CudaRunner) -> i64 with Alloc, Mut {
    if !rt.ok || rt.d_fma_audit_hits == 0 { return -1 }
    if cuda_ctx_sync(&rt.sess) != 0 { return -1 }
    let b = heap_alloc(8) as i64
    if b == 0 { return -1 }
    let _w = ptr_write_i64_le(b, 0, 0)
    let rc = cuda_memcpy_d2h(&rt.sess, b, rt.d_fma_audit_hits, 8)
    let hits = if rc == 0 { ptr_read_i64_le(b, 0) } else { -1 }
    heap_free(b as *mut u8)
    hits
}

pub fn qwen3_cuda_runner_free(rt: Qwen3CudaRunner) -> i64 with IO, Mut {
    let Qwen3CudaRunner {
        sess,
        hmod,
        fn_embed: _,
        fn_vec_add: _,
        fn_swiglu: _,
        fn_rmsnorm: _,
        fn_add_accum_rmsnorm: _,
        fn_qk_rope_kv: _,
        fn_paged_gqa: _,
        fn_gemv_bf16: _,
        fn_argmax_top2: _,
        fn_gemm_bf16_simt: _,
        fn_gemm_bf16_tc: _,
        d_fma_audit_hits: _,
        fn_quantize_q4: _,
        fn_row_scale: _,
        fn_tile_smax: _,
        fn_gemv_q4_fast: _,
        fn_summarize_tiles: _,
        fn_certify_pruned: _,
        fn_quantize_q4_soa: _,
        fn_gemv_q4_soa: _,
        d_s0,
        d_s1,
        d_s2,
        d_s3,
        d_s4,
        d_s5,
        d_s6,
        d_s7,
        d_nonlin,
        nonlin_meta_arena,
        d_work,
        d_k_cache,
        d_v_cache,
        d_rope,
        max_seq_cap: _,
        kv_dim: _,
        ok: _,
    } = rt
    if d_s0 != 0 { let _f = cuda_mem_free(&sess, d_s0) }
    if d_s1 != 0 { let _f = cuda_mem_free(&sess, d_s1) }
    if d_s2 != 0 { let _f = cuda_mem_free(&sess, d_s2) }
    if d_s3 != 0 { let _f = cuda_mem_free(&sess, d_s3) }
    if d_s4 != 0 { let _f = cuda_mem_free(&sess, d_s4) }
    if d_s5 != 0 { let _f = cuda_mem_free(&sess, d_s5) }
    if d_s6 != 0 { let _f = cuda_mem_free(&sess, d_s6) }
    if d_s7 != 0 { let _f = cuda_mem_free(&sess, d_s7) }
    if d_nonlin != 0 { let _f = cuda_mem_free(&sess, d_nonlin) }
    let _fn = page_arena_free(nonlin_meta_arena)
    if d_work != 0 { let _f = cuda_mem_free(&sess, d_work) }
    if d_k_cache != 0 { let _f = cuda_mem_free(&sess, d_k_cache) }
    if d_v_cache != 0 { let _f = cuda_mem_free(&sess, d_v_cache) }
    if d_rope != 0 { let _f = cuda_mem_free(&sess, d_rope) }
    if hmod != 0 { let _u = cuda_module_unload(&sess, hmod) }
    cuda_session_close(sess)
}

fn qwen3_cuda_shard_dev(rt: &Qwen3CudaRunner, shard_idx: i64) -> i64 {
    if shard_idx == 0 { return rt.d_s0 }
    if shard_idx == 1 { return rt.d_s1 }
    if shard_idx == 2 { return rt.d_s2 }
    if shard_idx == 3 { return rt.d_s3 }
    if shard_idx == 4 { return rt.d_s4 }
    if shard_idx == 5 { return rt.d_s5 }
    if shard_idx == 6 { return rt.d_s6 }
    if shard_idx == 7 { return rt.d_s7 }
    0
}

fn qwen3_cuda_slot_dev_ptr(m: &Qwen3Model, rt: &Qwen3CudaRunner, slot: i64) -> i64 {
    if rt.d_nonlin != 0 && page_arena_is_ok(&rt.nonlin_meta_arena) {
        let off = ptr_read_i64_le(page_arena_ptr(&rt.nonlin_meta_arena), slot * 8)
        if off >= 0 { return rt.d_nonlin + off }
        return 0
    }
    let sidx = qwen3_model_tensor_shard_idx(m, slot)
    let doff = qwen3_model_tensor_data_off(m, slot)
    let base = qwen3_cuda_shard_dev(rt, sidx)
    if base == 0 { return 0 }
    base + doff
}

fn qwen3_cuda_linear(
    m: &Qwen3Model,
    rt: &Qwen3CudaRunner,
    slot: i64,
    use_q4: bool,
    d_q4_nib: i64,
    d_q4_scl: i64,
    q4_meta_base: i64,
    d_x: i64,
    d_y: i64,
    out_dim: i64,
    in_dim: i64
) -> i64 with Div {
    let gx = (out_dim + 7) / 8
    if use_q4 {
        let nib_off = ptr_read_i64_le(q4_meta_base, slot * 32 + 0)
        let scl_off = ptr_read_i64_le(q4_meta_base, slot * 32 + 8)
        return cuda_launch_6_async(&rt.sess, rt.fn_gemv_q4_soa, gx, 256, d_q4_nib + nib_off, d_q4_scl + scl_off, d_x, d_y, out_dim, in_dim)
    }
    let w_ptr = qwen3_cuda_slot_dev_ptr(m, rt, slot)
    let is_bf16: i64 = if qwen3_model_tensor_dtype(m, slot) == 2 { 1 } else { 0 }
    cuda_launch_6_async(&rt.sess, rt.fn_gemv_bf16, gx, 256, w_ptr, d_x, d_y, out_dim, in_dim, is_bf16)
}

fn qwen3_cuda_step_begin(
    m: &Qwen3Model,
    rt: &Qwen3CudaRunner,
    token_id: i64,
    eps_bits: i64
) -> bool with Div {
    let d_x = rt.d_work + m.buf_x_off
    let d_h = rt.d_work + m.buf_h_off
    let emb_ptr = qwen3_cuda_slot_dev_ptr(m, rt, 0)
    let emb_bf16: i64 = if qwen3_model_tensor_dtype(m, 0) == 2 { 1 } else { 0 }
    let emb_elem_b: i64 = if emb_bf16 == 1 { 2 } else { 4 }
    let row_p = emb_ptr + token_id * m.cfg.hidden * emb_elem_b
    let emb_grid = (m.cfg.hidden + 255) / 256
    if cuda_launch_4_async(&rt.sess, rt.fn_embed, emb_grid, 256, row_p, d_x, m.cfg.hidden, emb_bf16) != 0 {
        return false
    }
    if m.cfg.layers > 0 {
        let in0_p = qwen3_cuda_slot_dev_ptr(m, rt, 3)
        let in0_bf16: i64 = if qwen3_model_tensor_dtype(m, 3) == 2 { 1 } else { 0 }
        if cuda_launch_8_async(&rt.sess, rt.fn_rmsnorm, 1, 32, d_x, in0_p, d_h, 1, m.cfg.hidden, eps_bits, in0_bf16, 0) != 0 {
            return false
        }
    }
    true
}

fn qwen3_cuda_step_layer_core(
    m: &Qwen3Model,
    rt: &Qwen3CudaRunner,
    l: i64,
    pos: i64,
    eps_bits: i64,
    attn_q4: bool,
    mlp_q4: bool,
    d_q4_nib: i64,
    d_q4_scl: i64,
    q4_meta_base: i64
) -> bool with Div {
    let slot_base = 3 + l * 11
    let d_x = rt.d_work + m.buf_x_off
    let d_h = rt.d_work + m.buf_h_off
    let d_q = rt.d_work + m.buf_q_off
    let d_k = rt.d_work + m.buf_k_off
    let d_v = rt.d_work + m.buf_v_off
    let d_ao = rt.d_work + m.buf_attn_out_off
    let d_gate = rt.d_work + m.buf_gate_off
    let d_up = rt.d_work + m.buf_up_off
    let q_dim = m.cfg.n_q * m.cfg.head_dim

    if qwen3_cuda_linear(m, rt, slot_base + 1, attn_q4, d_q4_nib, d_q4_scl, q4_meta_base, d_h, d_q, q_dim, m.cfg.hidden) != 0 { return false }
    if qwen3_cuda_linear(m, rt, slot_base + 2, attn_q4, d_q4_nib, d_q4_scl, q4_meta_base, d_h, d_k, rt.kv_dim, m.cfg.hidden) != 0 { return false }
    if qwen3_cuda_linear(m, rt, slot_base + 3, attn_q4, d_q4_nib, d_q4_scl, q4_meta_base, d_h, d_v, rt.kv_dim, m.cfg.hidden) != 0 { return false }

    let qw_p = qwen3_cuda_slot_dev_ptr(m, rt, slot_base + 5)
    let kw_p = qwen3_cuda_slot_dev_ptr(m, rt, slot_base + 6)
    let qw_bf: i64 = if qwen3_model_tensor_dtype(m, slot_base + 5) == 2 { 1 } else { 0 }
    let kw_bf: i64 = if qwen3_model_tensor_dtype(m, slot_base + 6) == 2 { 1 } else { 0 }
    let ef_packed = (eps_bits & 4294967295) | ((qw_bf | (kw_bf * 2)) << 32)
    let rope_pos = rt.d_rope + pos * m.cfg.head_dim * 4
    let layer_kv_bytes = rt.max_seq_cap * rt.kv_dim * 4
    let k_layer = rt.d_k_cache + l * layer_kv_bytes
    let v_layer = rt.d_v_cache + l * layer_kv_bytes
    let k_dst = k_layer + pos * rt.kv_dim * 4
    let v_dst = v_layer + pos * rt.kv_dim * 4
    if cuda_launch_12_async(
        &rt.sess, rt.fn_qk_rope_kv, m.cfg.n_q + m.cfg.n_kv, 32,
        d_q, d_k, d_v, qw_p, kw_p, rope_pos, k_dst, v_dst,
        m.cfg.n_q, m.cfg.n_kv, m.cfg.head_dim, ef_packed
    ) != 0 {
        return false
    }

    if cuda_launch_8_async(
        &rt.sess, rt.fn_paged_gqa, m.cfg.n_q, 32,
        d_q, k_layer, v_layer, d_ao, m.cfg.n_q, m.cfg.n_kv, m.cfg.head_dim, pos + 1
    ) != 0 {
        return false
    }

    if qwen3_cuda_linear(m, rt, slot_base + 4, attn_q4, d_q4_nib, d_q4_scl, q4_meta_base, d_ao, d_h, m.cfg.hidden, q_dim) != 0 { return false }

    let post_p = qwen3_cuda_slot_dev_ptr(m, rt, slot_base + 7)
    let post_bf: i64 = if qwen3_model_tensor_dtype(m, slot_base + 7) == 2 { 1 } else { 0 }
    if cuda_launch_10_async(
        &rt.sess, rt.fn_add_accum_rmsnorm, 1, 32,
        d_x, d_h, post_p, d_h, 0, m.cfg.hidden, eps_bits, 0, 0, post_bf
    ) != 0 {
        return false
    }

    if qwen3_cuda_linear(m, rt, slot_base + 8, mlp_q4, d_q4_nib, d_q4_scl, q4_meta_base, d_h, d_gate, m.cfg.inter, m.cfg.hidden) != 0 { return false }
    if qwen3_cuda_linear(m, rt, slot_base + 9, mlp_q4, d_q4_nib, d_q4_scl, q4_meta_base, d_h, d_up, m.cfg.inter, m.cfg.hidden) != 0 { return false }
    let sw_grid = (m.cfg.inter + 255) / 256
    if cuda_launch_4_async(&rt.sess, rt.fn_swiglu, sw_grid, 256, d_gate, d_up, d_gate, m.cfg.inter) != 0 { return false }
    if qwen3_cuda_linear(m, rt, slot_base + 10, mlp_q4, d_q4_nib, d_q4_scl, q4_meta_base, d_gate, d_h, m.cfg.hidden, m.cfg.inter) != 0 { return false }
    true
}

pub fn qwen3_cuda_sync_logits(m: &Qwen3Model, rt: &Qwen3CudaRunner) -> bool {
    if !m.ok || !rt.ok { return false }
    let a_base = page_arena_ptr(&m.arena)
    cuda_memcpy_d2h(&rt.sess, a_base + m.buf_logits_off, rt.d_work + m.buf_logits_off, m.cfg.vocab * 4) == 0
}

fn qwen3_forward_token_cuda_inner(
    m: &Qwen3Model,
    rt: &Qwen3CudaRunner,
    token_id: i64,
    pos: i64,
    compute_logits: bool,
    use_q4: bool,
    d_q4_nib: i64,
    d_q4_scl: i64,
    q4_meta_base: i64
) -> bool with Mut, Div {
    if !m.ok || !rt.ok || token_id < 0 || token_id >= m.cfg.vocab || pos < 0 || pos >= rt.max_seq_cap {
        return false
    }
    if (m.cfg.head_dim & 1) != 0 { return false }
    if use_q4 && (d_q4_nib == 0 || d_q4_scl == 0 || q4_meta_base == 0) {
        return false
    }
    let eps_bits = f64_to_f32_bits(m.cfg.eps)
    if !qwen3_cuda_step_begin(m, rt, token_id, eps_bits) { return false }

    let d_x = rt.d_work + m.buf_x_off
    let d_h = rt.d_work + m.buf_h_off
    let d_logits = rt.d_work + m.buf_logits_off
    let d_top2 = rt.d_work + m.buf_top2_off

    var l: i64 = 0
    while l < m.cfg.layers {
        if !qwen3_cuda_step_layer_core(m, rt, l, pos, eps_bits, use_q4, use_q4, d_q4_nib, d_q4_scl, q4_meta_base) {
            return false
        }
        if l + 1 < m.cfg.layers {
            let nx_slot = 3 + (l + 1) * 11
            let nx_p = qwen3_cuda_slot_dev_ptr(m, rt, nx_slot)
            let nx_bf: i64 = if qwen3_model_tensor_dtype(m, nx_slot) == 2 { 1 } else { 0 }
            if cuda_launch_10_async(&rt.sess, rt.fn_add_accum_rmsnorm, 1, 32, d_x, d_h, nx_p, d_h, 0, m.cfg.hidden, eps_bits, 0, 0, nx_bf) != 0 {
                return false
            }
        } else if compute_logits {
            let nw_p = qwen3_cuda_slot_dev_ptr(m, rt, 1)
            let nw_bf: i64 = if qwen3_model_tensor_dtype(m, 1) == 2 { 1 } else { 0 }
            if cuda_launch_10_async(&rt.sess, rt.fn_add_accum_rmsnorm, 1, 32, d_x, d_h, nw_p, d_h, 0, m.cfg.hidden, eps_bits, 0, 0, nw_bf) != 0 {
                return false
            }
        } else {
            let va_grid = (m.cfg.hidden + 255) / 256
            if cuda_launch_4_async(&rt.sess, rt.fn_vec_add, va_grid, 256, d_x, d_h, m.cfg.hidden, 0) != 0 {
                return false
            }
        }
        l = l + 1
    }

    if !compute_logits {
        return true
    }
    if m.cfg.layers <= 0 {
        let nw_p = qwen3_cuda_slot_dev_ptr(m, rt, 1)
        let nw_bf: i64 = if qwen3_model_tensor_dtype(m, 1) == 2 { 1 } else { 0 }
        if cuda_launch_8_async(&rt.sess, rt.fn_rmsnorm, 1, 32, d_x, nw_p, d_h, 1, m.cfg.hidden, eps_bits, nw_bf, 0) != 0 {
            return false
        }
    }
    if qwen3_cuda_linear(m, rt, 2, use_q4, d_q4_nib, d_q4_scl, q4_meta_base, d_h, d_logits, m.cfg.vocab, m.cfg.hidden) != 0 {
        return false
    }
    if cuda_launch_4_async(&rt.sess, rt.fn_argmax_top2, 1, 256, d_logits, d_top2, m.cfg.vocab, 0) != 0 {
        return false
    }
    let a_base = page_arena_ptr(&m.arena)
    cuda_memcpy_d2h(&rt.sess, a_base + m.buf_top2_off, d_top2, 32) == 0
}

pub fn qwen3_forward_token_cuda_opt(
    m: &Qwen3Model,
    rt: &Qwen3CudaRunner,
    token_id: i64,
    pos: i64,
    compute_logits: bool
) -> bool with Mut, Div {
    qwen3_forward_token_cuda_inner(m, rt, token_id, pos, compute_logits, false, 0, 0, 0)
}

fn qwen3_cuda_linear_batch(
    m: &Qwen3Model,
    rt: &Qwen3CudaRunner,
    slot: i64,
    d_x: i64,
    d_y: i64,
    out_dim: i64,
    in_dim: i64,
    n_toks: i64,
    use_tc: bool,
    sm_ver: i64
) -> i64 with Div {
    let w_ptr = qwen3_cuda_slot_dev_ptr(m, rt, slot)
    let is_bf16: i64 = if qwen3_model_tensor_dtype(m, slot) == 2 { 1 } else { 0 }
    if use_tc && is_bf16 == 1 && sm_ver >= 75 {
        let gx_tc = ((out_dim + 127) / 128) * ((n_toks + 7) / 8)
        return cuda_launch_8_async(&rt.sess, rt.fn_gemm_bf16_tc, gx_tc, 256, w_ptr, d_x, d_y, out_dim, in_dim, n_toks, is_bf16, 0)
    }
    let gx_simt = (out_dim + 7) / 8
    cuda_launch_8_async(&rt.sess, rt.fn_gemm_bf16_simt, gx_simt, 256, w_ptr, d_x, d_y, out_dim, in_dim, n_toks, is_bf16, 0)
}

pub fn qwen3_forward_batch_bf16_cuda_mode(
    m: &Qwen3Model,
    rt: &Qwen3CudaRunner,
    tok_ids_ptr: i64,
    pos_start: i64,
    n_toks: i64,
    compute_all_top1: bool,
    compute_last_logits: bool,
    top1_out_ptr: i64,
    use_tc: bool
) -> bool with Alloc, Mut, Div {
    if !m.ok || !rt.ok || tok_ids_ptr == 0 || pos_start < 0 || n_toks <= 0 { return false }
    if (m.cfg.head_dim & 1) != 0 || pos_start + n_toks > rt.max_seq_cap { return false }
    var pi: i64 = 0
    while pi < n_toks {
        let tid = ptr_read_i64_le(tok_ids_ptr, pi * 8)
        if tid < 0 || tid >= m.cfg.vocab { return false }
        pi = pi + 1
    }

    let a_base = page_arena_ptr(&m.arena)
    let bx8_off = align_up_64(m.buf_top2_off + 64)
    let bh8_off = bx8_off + align_up_64(8 * m.cfg.hidden * 4)
    let bq8_off = bh8_off + align_up_64(8 * m.cfg.hidden * 4)
    let bk8_off = bq8_off + align_up_64(8 * m.cfg.n_q * m.cfg.head_dim * 4)
    let bv8_off = bk8_off + align_up_64(8 * m.cfg.n_kv * m.cfg.head_dim * 4)
    let battn8_off = bv8_off + align_up_64(8 * m.cfg.n_kv * m.cfg.head_dim * 4)
    let bgate8_off = battn8_off + align_up_64(8 * m.cfg.n_q * m.cfg.head_dim * 4)
    let bup8_off = bgate8_off + align_up_64(8 * m.cfg.inter * 4)
    let blogits8_off = bup8_off + align_up_64(8 * m.cfg.inter * 4)
    let btop2_8_off = blogits8_off + align_up_64(8 * m.cfg.vocab * 4)

    let d_bx8 = rt.d_work + bx8_off
    let d_bh8 = rt.d_work + bh8_off
    let d_bq8 = rt.d_work + bq8_off
    let d_bk8 = rt.d_work + bk8_off
    let d_bv8 = rt.d_work + bv8_off
    let d_battn8 = rt.d_work + battn8_off
    let d_bgate8 = rt.d_work + bgate8_off
    let d_bup8 = rt.d_work + bup8_off
    let d_blogits8 = rt.d_work + blogits8_off
    let d_btop2_8 = rt.d_work + btop2_8_off
    let d_h = rt.d_work + m.buf_h_off
    let d_logits = rt.d_work + m.buf_logits_off
    let d_top2 = rt.d_work + m.buf_top2_off

    let emb_ptr = qwen3_cuda_slot_dev_ptr(m, rt, 0)
    let emb_bf16: i64 = if qwen3_model_tensor_dtype(m, 0) == 2 { 1 } else { 0 }
    let emb_elem_b: i64 = if emb_bf16 == 1 { 2 } else { 4 }
    let emb_grid = (m.cfg.hidden + 255) / 256
    let eps_bits = f64_to_f32_bits_ftz(m.cfg.eps)
    let q_dim = m.cfg.n_q * m.cfg.head_dim
    let sm_ver = cuda_session_sm_version(&rt.sess)
    let layer_kv_bytes = rt.max_seq_cap * rt.kv_dim * 4

    var done: i64 = 0
    while done < n_toks {
        let rem = n_toks - done
        let w: i64 = if rem > 8 { 8 } else { rem }
        let chunk_pos = pos_start + done
        let is_last_chunk = (done + w) >= n_toks

        if w == 1 {
            let tid0 = ptr_read_i64_le(tok_ids_ptr, done * 8)
            let want_lg = compute_all_top1 || (compute_last_logits && is_last_chunk)
            if !qwen3_forward_token_cuda_opt(m, rt, tid0, chunk_pos, want_lg) {
                return false
            }
            if want_lg && top1_out_ptr != 0 {
                let t = qwen3_model_top2(m)
                let _wt = ptr_write_i64_le(top1_out_ptr, done * 8, t.top1_id)
            }
            done = done + 1
        } else {
            var b: i64 = 0
            while b < w {
                let tid = ptr_read_i64_le(tok_ids_ptr, (done + b) * 8)
                let row_p = emb_ptr + tid * m.cfg.hidden * emb_elem_b
                if cuda_launch_4_async(&rt.sess, rt.fn_embed, emb_grid, 256, row_p, d_bx8 + b * m.cfg.hidden * 4, m.cfg.hidden, emb_bf16) != 0 {
                    return false
                }
                b = b + 1
            }

            let va_grid = (w * m.cfg.hidden + 255) / 256
            let sw_grid = (w * m.cfg.inter + 255) / 256
            var l: i64 = 0
            while l < m.cfg.layers {
                let slot_base = 3 + l * 11

                let in_p = qwen3_cuda_slot_dev_ptr(m, rt, slot_base + 0)
                let in_bf: i64 = if qwen3_model_tensor_dtype(m, slot_base + 0) == 2 { 1 } else { 0 }
                if cuda_launch_8_async(&rt.sess, rt.fn_rmsnorm, w, 32, d_bx8, in_p, d_bh8, w, m.cfg.hidden, eps_bits, in_bf, 0) != 0 {
                    return false
                }

                if qwen3_cuda_linear_batch(m, rt, slot_base + 1, d_bh8, d_bq8, q_dim, m.cfg.hidden, w, use_tc, sm_ver) != 0 { return false }
                if qwen3_cuda_linear_batch(m, rt, slot_base + 2, d_bh8, d_bk8, rt.kv_dim, m.cfg.hidden, w, use_tc, sm_ver) != 0 { return false }
                if qwen3_cuda_linear_batch(m, rt, slot_base + 3, d_bh8, d_bv8, rt.kv_dim, m.cfg.hidden, w, use_tc, sm_ver) != 0 { return false }

                let qw_p = qwen3_cuda_slot_dev_ptr(m, rt, slot_base + 5)
                let kw_p = qwen3_cuda_slot_dev_ptr(m, rt, slot_base + 6)
                let qw_bf: i64 = if qwen3_model_tensor_dtype(m, slot_base + 5) == 2 { 1 } else { 0 }
                let kw_bf: i64 = if qwen3_model_tensor_dtype(m, slot_base + 6) == 2 { 1 } else { 0 }
                let ef_packed = (eps_bits & 4294967295) | ((qw_bf | (kw_bf * 2)) << 32)
                let k_layer = rt.d_k_cache + l * layer_kv_bytes
                let v_layer = rt.d_v_cache + l * layer_kv_bytes

                var bt: i64 = 0
                while bt < w {
                    let cur_pos = chunk_pos + bt
                    let rope_pos = rt.d_rope + cur_pos * m.cfg.head_dim * 4
                    let k_dst = k_layer + cur_pos * rt.kv_dim * 4
                    let v_dst = v_layer + cur_pos * rt.kv_dim * 4
                    if cuda_launch_12_async(
                        &rt.sess, rt.fn_qk_rope_kv, m.cfg.n_q + m.cfg.n_kv, 32,
                        d_bq8 + bt * q_dim * 4, d_bk8 + bt * rt.kv_dim * 4, d_bv8 + bt * rt.kv_dim * 4,
                        qw_p, kw_p, rope_pos, k_dst, v_dst,
                        m.cfg.n_q, m.cfg.n_kv, m.cfg.head_dim, ef_packed
                    ) != 0 {
                        return false
                    }
                    bt = bt + 1
                }

                bt = 0
                while bt < w {
                    if cuda_launch_8_async(
                        &rt.sess, rt.fn_paged_gqa, m.cfg.n_q, 32,
                        d_bq8 + bt * q_dim * 4, k_layer, v_layer, d_battn8 + bt * q_dim * 4,
                        m.cfg.n_q, m.cfg.n_kv, m.cfg.head_dim, chunk_pos + bt + 1
                    ) != 0 {
                        return false
                    }
                    bt = bt + 1
                }

                if qwen3_cuda_linear_batch(m, rt, slot_base + 4, d_battn8, d_bh8, m.cfg.hidden, q_dim, w, use_tc, sm_ver) != 0 { return false }
                if cuda_launch_4_async(&rt.sess, rt.fn_vec_add, va_grid, 256, d_bx8, d_bh8, w * m.cfg.hidden, 0) != 0 { return false }

                let post_p = qwen3_cuda_slot_dev_ptr(m, rt, slot_base + 7)
                let post_bf: i64 = if qwen3_model_tensor_dtype(m, slot_base + 7) == 2 { 1 } else { 0 }
                if cuda_launch_8_async(&rt.sess, rt.fn_rmsnorm, w, 32, d_bx8, post_p, d_bh8, w, m.cfg.hidden, eps_bits, post_bf, 0) != 0 { return false }

                if qwen3_cuda_linear_batch(m, rt, slot_base + 8, d_bh8, d_bgate8, m.cfg.inter, m.cfg.hidden, w, use_tc, sm_ver) != 0 { return false }
                if qwen3_cuda_linear_batch(m, rt, slot_base + 9, d_bh8, d_bup8, m.cfg.inter, m.cfg.hidden, w, use_tc, sm_ver) != 0 { return false }
                if cuda_launch_4_async(&rt.sess, rt.fn_swiglu, sw_grid, 256, d_bgate8, d_bup8, d_bgate8, w * m.cfg.inter) != 0 { return false }
                if qwen3_cuda_linear_batch(m, rt, slot_base + 10, d_bgate8, d_bh8, m.cfg.hidden, m.cfg.inter, w, use_tc, sm_ver) != 0 { return false }
                if cuda_launch_4_async(&rt.sess, rt.fn_vec_add, va_grid, 256, d_bx8, d_bh8, w * m.cfg.hidden, 0) != 0 { return false }

                l = l + 1
            }

            if compute_all_top1 {
                let nw_p = qwen3_cuda_slot_dev_ptr(m, rt, 1)
                let nw_bf: i64 = if qwen3_model_tensor_dtype(m, 1) == 2 { 1 } else { 0 }
                if cuda_launch_8_async(&rt.sess, rt.fn_rmsnorm, w, 32, d_bx8, nw_p, d_bh8, w, m.cfg.hidden, eps_bits, nw_bf, 0) != 0 { return false }
                if qwen3_cuda_linear_batch(m, rt, 2, d_bh8, d_blogits8, m.cfg.vocab, m.cfg.hidden, w, use_tc, sm_ver) != 0 { return false }
                var bt: i64 = 0
                while bt < w {
                    if cuda_launch_4_async(&rt.sess, rt.fn_argmax_top2, 1, 256, d_blogits8 + bt * m.cfg.vocab * 4, d_btop2_8 + bt * 32, m.cfg.vocab, 0) != 0 {
                        return false
                    }
                    bt = bt + 1
                }
                if cuda_memcpy_d2h(&rt.sess, a_base + btop2_8_off, d_btop2_8, w * 32) != 0 { return false }
                if top1_out_ptr != 0 {
                    var bi: i64 = 0
                    while bi < w {
                        let t1 = ptr_read_i64_le(a_base + btop2_8_off + bi * 32, 0)
                        let _wt = ptr_write_i64_le(top1_out_ptr, (done + bi) * 8, t1)
                        bi = bi + 1
                    }
                }
                if is_last_chunk {
                    let src_pk = a_base + btop2_8_off + (w - 1) * 32
                    let dst_pk = a_base + m.buf_top2_off
                    let _c0 = ptr_write_i64_le(dst_pk, 0, ptr_read_i64_le(src_pk, 0))
                    let _c1 = ptr_write_i64_le(dst_pk, 8, ptr_read_i64_le(src_pk, 8))
                    let _c2 = ptr_write_i64_le(dst_pk, 16, ptr_read_i64_le(src_pk, 16))
                    if compute_last_logits {
                        if cuda_memcpy_d2h(&rt.sess, a_base + m.buf_logits_off, d_blogits8 + (w - 1) * m.cfg.vocab * 4, m.cfg.vocab * 4) != 0 {
                            return false
                        }
                    }
                }
            } else if compute_last_logits && is_last_chunk {
                let nw_p = qwen3_cuda_slot_dev_ptr(m, rt, 1)
                let nw_bf: i64 = if qwen3_model_tensor_dtype(m, 1) == 2 { 1 } else { 0 }
                let last_d_x = d_bx8 + (w - 1) * m.cfg.hidden * 4
                if cuda_launch_8_async(&rt.sess, rt.fn_rmsnorm, 1, 32, last_d_x, nw_p, d_h, 1, m.cfg.hidden, eps_bits, nw_bf, 0) != 0 { return false }
                if qwen3_cuda_linear(m, rt, 2, false, 0, 0, 0, d_h, d_logits, m.cfg.vocab, m.cfg.hidden) != 0 { return false }
                if cuda_launch_4_async(&rt.sess, rt.fn_argmax_top2, 1, 256, d_logits, d_top2, m.cfg.vocab, 0) != 0 { return false }
                if cuda_memcpy_d2h(&rt.sess, a_base + m.buf_top2_off, d_top2, 32) != 0 { return false }
                if top1_out_ptr != 0 {
                    let t = qwen3_model_top2(m)
                    let _wt = ptr_write_i64_le(top1_out_ptr, (n_toks - 1) * 8, t.top1_id)
                }
            }

            done = done + w
        }
    }
    if !compute_all_top1 && !compute_last_logits {
        return cuda_ctx_sync(&rt.sess) == 0
    }
    true
}

pub fn qwen3_forward_batch_bf16_cuda(
    m: &Qwen3Model,
    rt: &Qwen3CudaRunner,
    tok_ids_ptr: i64,
    pos_start: i64,
    n_toks: i64,
    compute_all_top1: bool,
    compute_last_logits: bool,
    top1_out_ptr: i64
) -> bool with Alloc, Mut, Div {
    qwen3_forward_batch_bf16_cuda_mode(m, rt, tok_ids_ptr, pos_start, n_toks, compute_all_top1, compute_last_logits, top1_out_ptr, false)
}

pub linear struct Qwen3CudaConformal {
    pub d_q4_nib: i64,
    pub d_q4_scl: i64,
    pub meta_arena: PageArena,
    pub d_conf: i64,
    pub conf_arena: PageArena,
    pub weights_arena: PageArena,
    pub n_layers: i64,
    pub vocab: i64,
    pub tile_smax_off: i64,
    pub tile_summary_off: i64,
    pub q_threshold: f64,
    pub quant_bits: i64,
    pub mlp_only: bool,
    pub q4_only: bool,
    pub ok: bool,
}

pub fn qwen3_cuda_conformal_is_ok(cc: &Qwen3CudaConformal) -> bool {
    cc.ok
}

pub fn qwen3_cuda_conformal_set_q(
    cc: &!Qwen3CudaConformal,
    rt: &Qwen3CudaRunner,
    q_threshold: f64
) -> bool with Mut {
    if !cc.ok || !rt.ok || cc.d_conf == 0 { return false }
    cc.q_threshold = q_threshold
    let cp = page_arena_ptr(&cc.conf_arena)
    let _wq = ptr_write_u32_le(cp, 4, f64_to_f32_bits(q_threshold))
    cuda_memcpy_h2d(&rt.sess, cc.d_conf + 4, cp + 4, 4) == 0
}

pub fn qwen3_cuda_conformal_init(
    m: &Qwen3Model,
    rt: &Qwen3CudaRunner,
    quant_mode: i64,
    q_override: f64
) -> Qwen3CudaConformal with IO, Mut, Alloc, Div, Panic {
    let q4_only = (quant_mode == 22) || (rt.d_nonlin != 0)
    let q_val = if q_override >= 0.0 {
        q_override
    } else if q4_only {
        0.0
    } else {
        qwen3_conformal_q_for_mode_layers(quant_mode, m.cfg.layers)
    }
    if !m.ok || !rt.ok || m.cfg.layers <= 0 || m.cfg.vocab <= 0 || m.cfg.hidden <= 0 {
        return Qwen3CudaConformal {
            d_q4_nib: 0,
            d_q4_scl: 0,
            meta_arena: PageArena { ptr: 0, len: 0, ok: false },
            d_conf: 0,
            conf_arena: PageArena { ptr: 0, len: 0, ok: false },
            weights_arena: PageArena { ptr: 0, len: 0, ok: false },
            n_layers: 0,
            vocab: 0,
            tile_smax_off: 0,
            tile_summary_off: 0,
            q_threshold: q_val,
            quant_bits: 4,
            mlp_only: false,
            q4_only: q4_only,
            ok: false,
        }
    }

    let total_slots = 3 + m.cfg.layers * 11
    let meta_bytes = q4_soa_align_up_64(total_slots * 32)
    var total_nib_bytes: i64 = 0
    var total_scl_bytes: i64 = 0
    var max_lin_bytes: i64 = 0
    var s: i64 = 0
    while s < total_slots {
        if qwen3_slot_matches_mask(s, false) {
            let rows = qwen3_model_tensor_rows(m, s)
            let cols = qwen3_model_tensor_cols(m, s)
            if rows > 0 && cols > 0 {
                total_nib_bytes = total_nib_bytes + q4_soa_nibbles_bytes(rows, cols)
                total_scl_bytes = total_scl_bytes + q4_soa_scales_bytes(rows, cols)
                let dt = qwen3_model_tensor_dtype(m, s)
                let elem_b: i64 = if dt == 2 { 2 } else { 4 }
                let src_bytes = rows * cols * elem_b
                if src_bytes > max_lin_bytes { max_lin_bytes = src_bytes }
            }
        }
        s = s + 1
    }
    total_nib_bytes = q4_soa_align_up_64(total_nib_bytes + 4096)
    total_scl_bytes = q4_soa_align_up_64(total_scl_bytes + 4096)

    let n_tiles = (m.cfg.vocab + 63) / 64
    let tile_smax_off = align_up_64(64 + m.cfg.vocab * 4)
    let tile_summary_off = align_up_64(tile_smax_off + n_tiles * 4)
    let conf_bytes = align_up_64(tile_summary_off + n_tiles * 32 + 4096)
    let weights_bytes = align_up_64(m.cfg.layers * 4 + 64)

    let meta_arena = page_arena_alloc(meta_bytes)
    let d_q4_nib = cuda_mem_alloc(&rt.sess, total_nib_bytes)
    let d_q4_scl = cuda_mem_alloc(&rt.sess, total_scl_bytes)
    let conf_arena = if !q4_only { page_arena_alloc(conf_bytes) } else { PageArena { ptr: 0, len: 0, ok: false } }
    let weights_arena = if !q4_only { page_arena_alloc(weights_bytes) } else { PageArena { ptr: 0, len: 0, ok: false } }
    let d_conf = if !q4_only { cuda_mem_alloc(&rt.sess, conf_bytes) } else { 0 }
    let d_scratch = if q4_only && max_lin_bytes > 0 { cuda_mem_alloc(&rt.sess, q4_soa_align_up_64(max_lin_bytes)) } else { 0 }

    var ok = page_arena_is_ok(&meta_arena) && d_q4_nib != 0 && d_q4_scl != 0
        && (q4_only || (page_arena_is_ok(&conf_arena) && page_arena_is_ok(&weights_arena) && d_conf != 0))
        && (!q4_only || max_lin_bytes <= 0 || d_scratch != 0)

    if ok {
        let meta_base = page_arena_ptr(&meta_arena)
        var cur_nib_off: i64 = 0
        var cur_scl_off: i64 = 0
        s = 0
        while s < total_slots && ok {
            let is_lin = qwen3_slot_matches_mask(s, false)
            let rows = qwen3_model_tensor_rows(m, s)
            let cols = qwen3_model_tensor_cols(m, s)
            if is_lin && rows > 0 && cols > 0 {
                let n_blocks = q4_soa_block_count(cols)
                let nib_bytes = q4_soa_nibbles_bytes(rows, cols)
                let scl_bytes = q4_soa_scales_bytes(rows, cols)
                let src_bf16: i64 = if qwen3_model_tensor_dtype(m, s) == 2 { 1 } else { 0 }
                let gx = (rows * n_blocks + 255) / 256
                if q4_only {
                    let hp = qwen3_model_tensor_host_ptr(m, s)
                    let elem_b: i64 = if src_bf16 == 1 { 2 } else { 4 }
                    let b_len = rows * cols * elem_b
                    if hp == 0 || b_len <= 0 || cuda_memcpy_h2d(&rt.sess, d_scratch, hp, b_len) != 0 {
                        ok = false
                    } else if cuda_launch_8_async(&rt.sess, rt.fn_quantize_q4_soa, gx, 256, d_scratch, d_q4_nib + cur_nib_off, d_q4_scl + cur_scl_off, 0, rows, cols, src_bf16, 0) != 0 {
                        ok = false
                    } else if cuda_ctx_sync(&rt.sess) != 0 {
                        ok = false
                    }
                } else {
                    let src_p = qwen3_cuda_slot_dev_ptr(m, rt, s)
                    if src_p == 0 || cuda_launch_8_async(&rt.sess, rt.fn_quantize_q4_soa, gx, 256, src_p, d_q4_nib + cur_nib_off, d_q4_scl + cur_scl_off, 0, rows, cols, src_bf16, 0) != 0 {
                        ok = false
                    }
                }
                let _w0 = ptr_write_i64_le(meta_base, s * 32 + 0, cur_nib_off)
                let _w1 = ptr_write_i64_le(meta_base, s * 32 + 8, cur_scl_off)
                let _w2 = ptr_write_i64_le(meta_base, s * 32 + 16, rows)
                let _w3 = ptr_write_i64_le(meta_base, s * 32 + 24, cols)
                cur_nib_off = cur_nib_off + nib_bytes
                cur_scl_off = cur_scl_off + scl_bytes
            } else {
                let _w0 = ptr_write_i64_le(meta_base, s * 32 + 0, 0)
                let _w1 = ptr_write_i64_le(meta_base, s * 32 + 8, 0)
                let _w2 = ptr_write_i64_le(meta_base, s * 32 + 16, rows)
                let _w3 = ptr_write_i64_le(meta_base, s * 32 + 24, cols)
            }
            s = s + 1
        }
    }

    if d_scratch != 0 {
        if cuda_ctx_sync(&rt.sess) != 0 { ok = false }
        let _fs = cuda_mem_free(&rt.sess, d_scratch)
    }

    if ok && !q4_only {
        let cp = page_arena_ptr(&conf_arena)
        let _wd = ptr_write_u32_le(cp, 0, f64_to_f32_bits(0.0))
        let _wq = ptr_write_u32_le(cp, 4, f64_to_f32_bits(q_val))
        let _wp = ptr_write_i64_le(cp, 8, 0)
        let _wc = ptr_write_u32_le(cp, 16, f64_to_f32_bits(0.0))
        let _wj = ptr_write_u32_le(cp, 20, 0)
        qwen3_conformal_fill_weights_for_mode(cp, page_arena_ptr(&weights_arena), m.cfg.layers, quant_mode)
        if cuda_memcpy_h2d(&rt.sess, d_conf, cp, 64) != 0 {
            ok = false
        } else {
            let lm_p = qwen3_cuda_slot_dev_ptr(m, rt, 2)
            let lm_bf: i64 = if qwen3_model_tensor_dtype(m, 2) == 2 { 1 } else { 0 }
            let r_gx = (m.cfg.vocab + 7) / 8
            let s_gx = (n_tiles + 255) / 256
            if lm_p == 0 || cuda_launch_6_async(&rt.sess, rt.fn_row_scale, r_gx, 256, lm_p, d_conf, m.cfg.vocab, m.cfg.hidden, lm_bf, 0) != 0 {
                ok = false
            } else if cuda_launch_4_async(&rt.sess, rt.fn_tile_smax, s_gx, 256, d_conf, tile_smax_off, m.cfg.vocab, 0) != 0 {
                ok = false
            } else if cuda_ctx_sync(&rt.sess) != 0 {
                ok = false
            }
        }
    } else if ok && q4_only {
        if cuda_ctx_sync(&rt.sess) != 0 {
            ok = false
        }
    }

    Qwen3CudaConformal {
        d_q4_nib: d_q4_nib,
        d_q4_scl: d_q4_scl,
        meta_arena: meta_arena,
        d_conf: d_conf,
        conf_arena: conf_arena,
        weights_arena: weights_arena,
        n_layers: m.cfg.layers,
        vocab: m.cfg.vocab,
        tile_smax_off: tile_smax_off,
        tile_summary_off: tile_summary_off,
        q_threshold: q_val,
        quant_bits: 4,
        mlp_only: false,
        q4_only: q4_only,
        ok: ok,
    }
}

pub fn qwen3_cuda_conformal_free(cc: Qwen3CudaConformal, rt: &Qwen3CudaRunner) -> i64 with IO, Mut {
    let Qwen3CudaConformal {
        d_q4_nib,
        d_q4_scl,
        meta_arena,
        d_conf,
        conf_arena,
        weights_arena,
        n_layers: _,
        vocab: _,
        tile_smax_off: _,
        tile_summary_off: _,
        q_threshold: _,
        quant_bits: _,
        mlp_only: _,
        q4_only: _,
        ok: _,
    } = cc
    if d_q4_nib != 0 { let _f = cuda_mem_free(&rt.sess, d_q4_nib) }
    if d_q4_scl != 0 { let _f = cuda_mem_free(&rt.sess, d_q4_scl) }
    if d_conf != 0 { let _f = cuda_mem_free(&rt.sess, d_conf) }
    let _fm = page_arena_free(meta_arena)
    let _fc = page_arena_free(conf_arena)
    let _fw = page_arena_free(weights_arena)
    0
}

pub fn qwen3_forward_token_q4_cuda(
    m: &Qwen3Model,
    cc: &Qwen3CudaConformal,
    rt: &Qwen3CudaRunner,
    token_id: i64,
    pos: i64,
    compute_logits: bool
) -> bool with Mut, Div {
    if !cc.ok { return false }
    qwen3_forward_token_cuda_inner(m, rt, token_id, pos, compute_logits, true, cc.d_q4_nib, cc.d_q4_scl, page_arena_ptr(&cc.meta_arena))
}

pub fn qwen3_forward_token_q4_try_cuda(
    m: &Qwen3Model,
    cc: &Qwen3CudaConformal,
    rt: &Qwen3CudaRunner,
    token_id: i64,
    pos: i64,
    compute_logits: bool,
    attn_bf16: bool
) -> EisaConeCert with Mut, Div {
    if !m.ok || !cc.ok || cc.d_conf == 0 || !rt.ok || token_id < 0 || token_id >= m.cfg.vocab || pos < 0 || pos >= rt.max_seq_cap {
        return eisa_certify_global(0, 0, 0)
    }
    if (m.cfg.head_dim & 1) != 0 { return eisa_certify_global(0, 0, 0) }
    let eps_bits = f64_to_f32_bits(m.cfg.eps)
    if !qwen3_cuda_step_begin(m, rt, token_id, eps_bits) {
        return eisa_certify_global(0, 0, 0)
    }

    let d_x = rt.d_work + m.buf_x_off
    let d_h = rt.d_work + m.buf_h_off
    let d_logits = rt.d_work + m.buf_logits_off
    let d_top2 = rt.d_work + m.buf_top2_off
    let meta_base = page_arena_ptr(&cc.meta_arena)
    let weights_base = page_arena_ptr(&cc.weights_arena)
    let attn_q4 = !attn_bf16

    var l: i64 = 0
    while l < m.cfg.layers {
        if !qwen3_cuda_step_layer_core(m, rt, l, pos, eps_bits, attn_q4, true, cc.d_q4_nib, cc.d_q4_scl, meta_base) {
            return eisa_certify_global(0, 0, 0)
        }
        let lw_bits = ptr_read_u32_le(weights_base, l * 4)
        let reset_bit: i64 = if l == 0 { 1 } else { 0 }
        if l + 1 < m.cfg.layers {
            let accum_bit: i64 = if compute_logits && (l == 0 || lw_bits != 0) { 2 } else { 0 }
            let nx_slot = 3 + (l + 1) * 11
            let nx_p = qwen3_cuda_slot_dev_ptr(m, rt, nx_slot)
            let nx_bf: i64 = if qwen3_model_tensor_dtype(m, nx_slot) == 2 { 1 } else { 0 }
            if cuda_launch_10_async(&rt.sess, rt.fn_add_accum_rmsnorm, 1, 32, d_x, d_h, nx_p, d_h, cc.d_conf, m.cfg.hidden, eps_bits, lw_bits, reset_bit | accum_bit, nx_bf) != 0 {
                return eisa_certify_global(0, 0, 0)
            }
        } else if compute_logits {
            let nw_p = qwen3_cuda_slot_dev_ptr(m, rt, 1)
            let nw_bf: i64 = if qwen3_model_tensor_dtype(m, 1) == 2 { 1 } else { 0 }
            if cuda_launch_10_async(&rt.sess, rt.fn_add_accum_rmsnorm, 1, 32, d_x, d_h, nw_p, d_h, cc.d_conf, m.cfg.hidden, eps_bits, lw_bits, reset_bit | 2 | 4, nw_bf) != 0 {
                return eisa_certify_global(0, 0, 0)
            }
        } else {
            let va_grid = (m.cfg.hidden + 255) / 256
            if cuda_launch_4_async(&rt.sess, rt.fn_vec_add, va_grid, 256, d_x, d_h, m.cfg.hidden, 0) != 0 {
                return eisa_certify_global(0, 0, 0)
            }
        }
        l = l + 1
    }

    if !compute_logits {
        return eisa_certify_global(0, 0, 0)
    }
    if m.cfg.layers <= 0 {
        let nw_p = qwen3_cuda_slot_dev_ptr(m, rt, 1)
        let nw_bf: i64 = if qwen3_model_tensor_dtype(m, 1) == 2 { 1 } else { 0 }
        if cuda_launch_8_async(&rt.sess, rt.fn_rmsnorm, 1, 32, d_x, nw_p, d_h, 1, m.cfg.hidden, eps_bits, nw_bf, 0) != 0 {
            return eisa_certify_global(0, 0, 0)
        }
    }

    if qwen3_cuda_linear(m, rt, 2, true, cc.d_q4_nib, cc.d_q4_scl, meta_base, d_h, d_logits, m.cfg.vocab, m.cfg.hidden) != 0 {
        return eisa_certify_global(0, 0, 0)
    }
    let n_tiles = (m.cfg.vocab + 63) / 64
    if cuda_launch_4_async(&rt.sess, rt.fn_summarize_tiles, n_tiles, 64, d_logits, cc.d_conf, cc.tile_summary_off, m.cfg.vocab) != 0 {
        return eisa_certify_global(0, 0, 0)
    }
    if cuda_launch_6_async(&rt.sess, rt.fn_certify_pruned, 1, 256, d_logits, cc.d_conf, cc.tile_smax_off, cc.tile_summary_off, d_top2, m.cfg.vocab) != 0 {
        return eisa_certify_global(0, 0, 0)
    }
    let a_base = page_arena_ptr(&m.arena)
    if cuda_memcpy_d2h(&rt.sess, a_base + m.buf_top2_off, d_top2, 56) != 0 {
        return eisa_certify_global(0, 0, 0)
    }

    let pk = a_base + m.buf_top2_off
    let top1_id = ptr_read_i64_le(pk, 0)
    let runner_id = ptr_read_i64_le(pk, 8)
    let cone_size = ptr_read_i64_le(pk, 16)
    let cert_flag = ptr_read_i64_le(pk, 24)
    let top1_bits = ptr_read_u32_le(pk, 32)
    let err_bits = ptr_read_u32_le(pk, 36)
    let mo_bits = ptr_read_u32_le(pk, 40)
    let gm_bits = ptr_read_u32_le(pk, 44)
    let top1_val = f32_bits_to_f64(top1_bits)
    let top1_err = f32_bits_to_f64(err_bits)
    let max_other = f32_bits_to_f64(mo_bits)
    let g_margin = f32_bits_to_f64(gm_bits)

    EisaConeCert {
        top1_id: top1_id,
        runner_up_id: runner_id,
        refined_top1_id: top1_id,
        top1_val: top1_val,
        top1_err: top1_err,
        max_other_upper: max_other,
        global_margin: g_margin,
        cone_size: cone_size,
        bf16_rows_touched: 0,
        strict_global_certified: cert_flag == 1,
        refined_exact: cert_flag == 1,
    }
}

pub fn qwen3_forward_token_q4_conformal_cuda(
    m: &Qwen3Model,
    cc: &Qwen3CudaConformal,
    rt: &Qwen3CudaRunner,
    token_id: i64,
    pos: i64,
    compute_logits: bool,
    escalated_out_ptr: i64
) -> EisaConeCert with Mut, Div {
    if escalated_out_ptr != 0 { let _e0 = ptr_write_i64_le(escalated_out_ptr, 0, 0) }
    let cert = qwen3_forward_token_q4_try_cuda(m, cc, rt, token_id, pos, compute_logits, false)
    if !compute_logits { return cert }
    if cert.cone_size <= 0 {
        return eisa_certify_global(0, 0, 0)
    }
    if cert.strict_global_certified {
        if escalated_out_ptr != 0 { let _e1 = ptr_write_i64_le(escalated_out_ptr, 0, 0) }
        return EisaConeCert {
            top1_id: cert.top1_id,
            runner_up_id: cert.runner_up_id,
            refined_top1_id: cert.top1_id,
            top1_val: cert.top1_val,
            top1_err: cert.top1_err,
            max_other_upper: cert.max_other_upper,
            global_margin: cert.global_margin,
            cone_size: 1,
            bf16_rows_touched: 0,
            strict_global_certified: true,
            refined_exact: true,
        }
    }
    if escalated_out_ptr != 0 { let _e2 = ptr_write_i64_le(escalated_out_ptr, 0, 1) }
    if !qwen3_forward_token_cuda_opt(m, rt, token_id, pos, true) {
        return eisa_certify_global(0, 0, 0)
    }
    let t = qwen3_model_top2(m)
    EisaConeCert {
        top1_id: cert.top1_id,
        runner_up_id: cert.runner_up_id,
        refined_top1_id: t.top1_id,
        top1_val: t.top1_val,
        top1_err: 0.0,
        max_other_upper: t.second_val,
        global_margin: t.top1_val - t.second_val,
        cone_size: cert.cone_size,
        bf16_rows_touched: m.cfg.vocab,
        strict_global_certified: false,
        refined_exact: true,
    }
}

// =========================================================================
// Metal Q4_SoA_32 Fast Runner (Q4 weights only, zero conformal overhead)
// =========================================================================

pub linear struct Qwen3MetalQ4Model {
    pub nib_arena: PageArena,
    pub scl_arena: PageArena,
    pub meta_arena: PageArena,
    pub b_nib: i64,
    pub b_scl: i64,
    pub pipes: Q4SoaMetalPipelines,
    pub n_slots: i64,
    pub ok: bool,
}

pub fn qwen3_metal_q4_is_ok(qm: &Qwen3MetalQ4Model) -> bool {
    qm.ok
}

pub fn qwen3_metal_q4_init(
    m: &Qwen3Model,
    rt: &Qwen3MetalRunner
) -> Qwen3MetalQ4Model with IO, Mut, Alloc, Div {
    if !m.ok || !rt.ok || m.cfg.layers <= 0 || m.cfg.vocab <= 0 || m.cfg.hidden <= 0 {
        return Qwen3MetalQ4Model {
            nib_arena: PageArena { ptr: 0, len: 0, ok: false },
            scl_arena: PageArena { ptr: 0, len: 0, ok: false },
            meta_arena: PageArena { ptr: 0, len: 0, ok: false },
            b_nib: 0,
            b_scl: 0,
            pipes: q4_soa_metal_pipelines_empty(),
            n_slots: 0,
            ok: false,
        }
    }

    let total_slots = 3 + m.cfg.layers * 11
    let meta_bytes = q4_soa_align_up_64(total_slots * 32)
    var total_nib_bytes: i64 = 0
    var total_scl_bytes: i64 = 0
    var s: i64 = 0
    while s < total_slots {
        if qwen3_slot_matches_mask(s, false) {
            let rows = qwen3_model_tensor_rows(m, s)
            let cols = qwen3_model_tensor_cols(m, s)
            if rows > 0 && cols > 0 {
                total_nib_bytes = total_nib_bytes + q4_soa_nibbles_bytes(rows, cols)
                total_scl_bytes = total_scl_bytes + q4_soa_scales_bytes(rows, cols)
            }
        }
        s = s + 1
    }
    total_nib_bytes = q4_soa_align_up_64(total_nib_bytes + 4096)
    total_scl_bytes = q4_soa_align_up_64(total_scl_bytes + 4096)

    let nib_arena = page_arena_alloc(total_nib_bytes)
    let scl_arena = page_arena_alloc(total_scl_bytes)
    let meta_arena = page_arena_alloc(meta_bytes)
    var ok = page_arena_is_ok(&nib_arena) && page_arena_is_ok(&scl_arena) && page_arena_is_ok(&meta_arena)

    let pipes = if ok { q4_soa_metal_pipelines_compile(&rt.sess) } else { q4_soa_metal_pipelines_empty() }
    let b_nib = if ok { metal_buffer_nocopy(&rt.sess, page_arena_ptr(&nib_arena), page_arena_len(&nib_arena)) } else { 0 }
    let b_scl = if ok { metal_buffer_nocopy(&rt.sess, page_arena_ptr(&scl_arena), page_arena_len(&scl_arena)) } else { 0 }
    if !pipes.ok || b_nib <= 0 || b_scl <= 0 {
        ok = false
    }

    if ok {
        let meta_base = page_arena_ptr(&meta_arena)
        var cur_nib_off: i64 = 0
        var cur_scl_off: i64 = 0
        var cid: i64 = 0
        var in_batch: i64 = 0
        s = 0
        while s < total_slots {
            let is_lin = qwen3_slot_matches_mask(s, false)
            let rows = qwen3_model_tensor_rows(m, s)
            let cols = qwen3_model_tensor_cols(m, s)
            if is_lin && rows > 0 && cols > 0 {
                if cid <= 0 {
                    cid = metal_cmd_begin(&rt.sess)
                    if cid <= 0 {
                        ok = false
                        break
                    }
                }
                let nib_bytes = q4_soa_nibbles_bytes(rows, cols)
                let scl_bytes = q4_soa_scales_bytes(rows, cols)
                let s_buf = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, s))
                let s_off = qwen3_model_tensor_data_off(m, s)
                let dt = qwen3_model_tensor_dtype(m, s)
                let flags: i64 = if dt == 2 { 1 } else { 0 }
                if s_buf <= 0 || q4_soa_metal_encode_quantize(
                    &rt.sess, cid, pipes.quantize,
                    s_buf, s_off,
                    b_nib, cur_nib_off,
                    b_scl, cur_scl_off,
                    b_scl, 0,
                    rows, cols, flags
                ) != 0 {
                    let _c = metal_cmd_cancel(&rt.sess, cid)
                    cid = 0
                    ok = false
                    break
                }
                let _w0 = ptr_write_i64_le(meta_base, s * 32 + 0, cur_nib_off)
                let _w1 = ptr_write_i64_le(meta_base, s * 32 + 8, cur_scl_off)
                let _w2 = ptr_write_i64_le(meta_base, s * 32 + 16, rows)
                let _w3 = ptr_write_i64_le(meta_base, s * 32 + 24, cols)
                cur_nib_off = cur_nib_off + nib_bytes
                cur_scl_off = cur_scl_off + scl_bytes
                in_batch = in_batch + 1
                if in_batch >= 16 {
                    if metal_cmd_commit_sync(&rt.sess, cid) != 0 {
                        cid = 0
                        ok = false
                        break
                    }
                    cid = 0
                    in_batch = 0
                }
            } else {
                let _w0 = ptr_write_i64_le(meta_base, s * 32 + 0, 0)
                let _w1 = ptr_write_i64_le(meta_base, s * 32 + 8, 0)
                let _w2 = ptr_write_i64_le(meta_base, s * 32 + 16, rows)
                let _w3 = ptr_write_i64_le(meta_base, s * 32 + 24, cols)
            }
            s = s + 1
        }
        if cid > 0 {
            if !ok {
                let _c = metal_cmd_cancel(&rt.sess, cid)
            } else if metal_cmd_commit_sync(&rt.sess, cid) != 0 {
                ok = false
            }
        }
    }

    Qwen3MetalQ4Model {
        nib_arena: nib_arena,
        scl_arena: scl_arena,
        meta_arena: meta_arena,
        b_nib: b_nib,
        b_scl: b_scl,
        pipes: pipes,
        n_slots: total_slots,
        ok: ok,
    }
}

pub fn qwen3_metal_q4_free(qm: Qwen3MetalQ4Model, rt: &Qwen3MetalRunner) -> i64 with IO, Mut {
    let Qwen3MetalQ4Model {
        nib_arena,
        scl_arena,
        meta_arena,
        b_nib,
        b_scl,
        pipes: _,
        n_slots: _,
        ok: _,
    } = qm
    if b_nib > 0 { let _f = metal_buffer_free(&rt.sess, b_nib) }
    if b_scl > 0 { let _f = metal_buffer_free(&rt.sess, b_scl) }
    let _fn = page_arena_free(nib_arena)
    let _fs = page_arena_free(scl_arena)
    let _fm = page_arena_free(meta_arena)
    0
}

fn qwen3_metal_q4_encode_slot(
    rt: &Qwen3MetalRunner,
    qm: &Qwen3MetalQ4Model,
    cid: i64,
    slot: i64,
    x_buf: i64,
    x_off: i64,
    y_buf: i64,
    y_off: i64,
    out_dim: i64,
    in_dim: i64
) -> i64 with Div {
    let meta_base = page_arena_ptr(&qm.meta_arena)
    let nib_off = ptr_read_i64_le(meta_base, slot * 32 + 0)
    let scl_off = ptr_read_i64_le(meta_base, slot * 32 + 8)
    q4_soa_metal_encode_gemv(
        &rt.sess, cid, qm.pipes.gemv,
        qm.b_nib, nib_off,
        qm.b_scl, scl_off,
        x_buf, x_off,
        y_buf, y_off,
        out_dim, in_dim
    )
}

fn qwen3_metal_encode_rmsnorm_slot(
    m: &Qwen3Model,
    rt: &Qwen3MetalRunner,
    cid: i64,
    norm_slot: i64,
    in_off: i64,
    out_off: i64,
    n_rows: i64,
    hidden: i64,
    eps_bits: i64
) -> i64 with Div {
    let s_buf = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, norm_slot))
    let s_off = qwen3_model_tensor_data_off(m, norm_slot)
    let dt = qwen3_model_tensor_dtype(m, norm_slot)
    let pipe = if dt == 2 { rt.pipes.rmsnorm_bf16 } else { rt.pipes.rmsnorm_f32 }
    qwen3_metal_encode_rmsnorm(
        &rt.sess, cid, pipe,
        rt.b_work, in_off,
        s_buf, s_off,
        rt.b_work, out_off,
        n_rows, hidden, eps_bits
    )
}

fn qwen3_metal_encode_add_norm_slot(
    m: &Qwen3Model,
    rt: &Qwen3MetalRunner,
    cid: i64,
    norm_slot: i64,
    x_off: i64,
    h_off: i64,
    out_off: i64,
    hidden: i64,
    eps_bits: i64
) -> i64 with Div {
    let s_buf = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, norm_slot))
    let s_off = qwen3_model_tensor_data_off(m, norm_slot)
    let dt = qwen3_model_tensor_dtype(m, norm_slot)
    let pipe = if dt == 2 { rt.pipes.add_rmsnorm_bf16 } else { rt.pipes.add_rmsnorm_f32 }
    qwen3_metal_encode_add_rmsnorm(
        &rt.sess, cid, pipe,
        rt.b_work, rt.b_work, s_buf, rt.b_work,
        x_off, h_off, s_off, out_off,
        hidden, eps_bits
    )
}

fn qwen3_metal_q4_abort_cmd(rt: &Qwen3MetalRunner, cid: i64) -> bool {
    let _c = metal_cmd_cancel(&rt.sess, cid)
    false
}

pub fn qwen3_forward_token_q4_metal(
    m: &Qwen3Model,
    qm: &Qwen3MetalQ4Model,
    kv: &!Qwen3PagedKv,
    rt: &Qwen3MetalRunner,
    token_id: i64,
    pos: i64,
    compute_logits: bool
) -> bool with Mut, Div, Panic {
    if !m.ok || !qm.ok || !rt.ok || !qwen3_kv_is_ok(kv) || token_id < 0 || token_id >= m.cfg.vocab || pos < 0 {
        return false
    }
    if !qwen3_kv_ensure_pos(kv, pos) {
        return false
    }

    let a_base = page_arena_ptr(&m.arena)
    let buf_x = a_base + m.buf_x_off
    let emb_ptr = qwen3_model_tensor_host_ptr(m, 0)
    let emb_dt = qwen3_model_tensor_dtype(m, 0)
    let emb_elem_b = if emb_dt == 2 { 2 } else { 4 }
    let row_p = emb_ptr + token_id * m.cfg.hidden * emb_elem_b

    var i: i64 = 0
    while i < m.cfg.hidden {
        let v = if emb_dt == 2 {
            bf16_bits_to_f64_exact(ptr_read_u16_le(row_p, i * 2))
        } else {
            f32_bits_to_f64(ptr_read_u32_le(row_p, i * 4))
        }
        let _w = ptr_write_u32_le(buf_x, i * 4, f64_to_f32_bits(v))
        i = i + 1
    }

    let eps_bits = f64_to_f32_bits(m.cfg.eps)
    let theta_bits = f64_to_f32_bits(m.cfg.rope_theta)
    let cid = metal_cmd_begin(&rt.sess)
    if cid <= 0 { return false }

    if m.cfg.layers > 0 {
        if qwen3_metal_encode_rmsnorm_slot(m, rt, cid, 3, m.buf_x_off, m.buf_h_off, 1, m.cfg.hidden, eps_bits) != 0 {
            return qwen3_metal_q4_abort_cmd(rt, cid)
        }
    }

    let q_dim = m.cfg.n_q * m.cfg.head_dim
    let kv_dim = m.cfg.n_kv * m.cfg.head_dim
    var l: i64 = 0
    while l < m.cfg.layers {
        let slot_base = 3 + l * 11

        if qwen3_metal_q4_encode_slot(rt, qm, cid, slot_base + 1, rt.b_work, m.buf_h_off, rt.b_work, m.buf_q_off, q_dim, m.cfg.hidden) != 0 {
            return qwen3_metal_q4_abort_cmd(rt, cid)
        }
        if qwen3_metal_q4_encode_slot(rt, qm, cid, slot_base + 2, rt.b_work, m.buf_h_off, rt.b_work, m.buf_k_off, kv_dim, m.cfg.hidden) != 0 {
            return qwen3_metal_q4_abort_cmd(rt, cid)
        }
        if qwen3_metal_q4_encode_slot(rt, qm, cid, slot_base + 3, rt.b_work, m.buf_h_off, rt.b_work, m.buf_v_off, kv_dim, m.cfg.hidden) != 0 {
            return qwen3_metal_q4_abort_cmd(rt, cid)
        }

        let q_norm_dt = qwen3_model_tensor_dtype(m, slot_base + 5)
        let k_norm_dt = qwen3_model_tensor_dtype(m, slot_base + 6)
        if (m.cfg.head_dim & 1) == 0 && q_norm_dt == k_norm_dt {
            let q_norm_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, slot_base + 5))
            let q_norm_off = qwen3_model_tensor_data_off(m, slot_base + 5)
            let k_norm_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, slot_base + 6))
            let k_norm_off = qwen3_model_tensor_data_off(m, slot_base + 6)
            let qkn_pipe = if q_norm_dt == 2 { rt.pipes.qk_norm_rope_kv_bf16 } else { rt.pipes.qk_norm_rope_kv_f32 }
            if qwen3_metal_encode_qk_norm_rope_kv_scatter(
                &rt.sess, cid, qkn_pipe,
                rt.b_work, rt.b_work, rt.b_work,
                q_norm_s, k_norm_s, rt.b_kv,
                m.buf_q_off, m.buf_k_off, m.buf_v_off,
                q_norm_off, k_norm_off,
                qwen3_kv_table_off(kv),
                qwen3_kv_k_layer_off(kv, l),
                qwen3_kv_v_layer_off(kv, l),
                m.cfg.n_q, m.cfg.n_kv, m.cfg.head_dim,
                pos, qwen3_kv_block_size(kv),
                eps_bits, rt.b_rope, pos * m.cfg.head_dim * 4
            ) != 0 {
                return qwen3_metal_q4_abort_cmd(rt, cid)
            }
        } else {
            if qwen3_metal_encode_rmsnorm_slot(m, rt, cid, slot_base + 5, m.buf_q_off, m.buf_q_off, m.cfg.n_q, m.cfg.head_dim, eps_bits) != 0 {
                return qwen3_metal_q4_abort_cmd(rt, cid)
            }
            if qwen3_metal_encode_rmsnorm_slot(m, rt, cid, slot_base + 6, m.buf_k_off, m.buf_k_off, m.cfg.n_kv, m.cfg.head_dim, eps_bits) != 0 {
                return qwen3_metal_q4_abort_cmd(rt, cid)
            }
            if qwen3_metal_encode_rope_table(&rt.sess, cid, rt.pipes.rope_table, rt.b_work, m.buf_q_off, rt.b_rope, pos * m.cfg.head_dim * 4, m.cfg.n_q, m.cfg.head_dim) != 0 {
                return qwen3_metal_q4_abort_cmd(rt, cid)
            }
            if qwen3_metal_encode_rope_table(&rt.sess, cid, rt.pipes.rope_table, rt.b_work, m.buf_k_off, rt.b_rope, pos * m.cfg.head_dim * 4, m.cfg.n_kv, m.cfg.head_dim) != 0 {
                return qwen3_metal_q4_abort_cmd(rt, cid)
            }
            if qwen3_metal_encode_kv_scatter(
                &rt.sess, cid, rt.pipes.kv_scatter,
                rt.b_work, m.buf_k_off,
                rt.b_work, m.buf_v_off,
                rt.b_kv,
                qwen3_kv_table_off(kv),
                qwen3_kv_k_layer_off(kv, l),
                qwen3_kv_v_layer_off(kv, l),
                kv_dim, pos, qwen3_kv_block_size(kv)
            ) != 0 {
                return qwen3_metal_q4_abort_cmd(rt, cid)
            }
        }

        if qwen3_metal_encode_paged_gqa(
            &rt.sess, cid, rt.pipes.paged_gqa,
            rt.b_work, m.buf_q_off,
            rt.b_kv,
            qwen3_kv_table_off(kv),
            qwen3_kv_k_layer_off(kv, l),
            qwen3_kv_v_layer_off(kv, l),
            rt.b_work, m.buf_attn_out_off,
            m.cfg.n_q, m.cfg.n_kv, m.cfg.head_dim,
            pos + 1, qwen3_kv_block_size(kv)
        ) != 0 {
            return qwen3_metal_q4_abort_cmd(rt, cid)
        }

        if qwen3_metal_q4_encode_slot(rt, qm, cid, slot_base + 4, rt.b_work, m.buf_attn_out_off, rt.b_work, m.buf_h_off, m.cfg.hidden, q_dim) != 0 {
            return qwen3_metal_q4_abort_cmd(rt, cid)
        }
        if qwen3_metal_encode_add_norm_slot(m, rt, cid, slot_base + 7, m.buf_x_off, m.buf_h_off, m.buf_h_off, m.cfg.hidden, eps_bits) != 0 {
            return qwen3_metal_q4_abort_cmd(rt, cid)
        }

        if qwen3_metal_q4_encode_slot(rt, qm, cid, slot_base + 8, rt.b_work, m.buf_h_off, rt.b_work, m.buf_gate_off, m.cfg.inter, m.cfg.hidden) != 0 {
            return qwen3_metal_q4_abort_cmd(rt, cid)
        }
        if qwen3_metal_q4_encode_slot(rt, qm, cid, slot_base + 9, rt.b_work, m.buf_h_off, rt.b_work, m.buf_up_off, m.cfg.inter, m.cfg.hidden) != 0 {
            return qwen3_metal_q4_abort_cmd(rt, cid)
        }
        if qwen3_metal_encode_swiglu(&rt.sess, cid, rt.pipes.swiglu, rt.b_work, m.buf_gate_off, rt.b_work, m.buf_up_off, rt.b_work, m.buf_gate_off, m.cfg.inter) != 0 {
            return qwen3_metal_q4_abort_cmd(rt, cid)
        }
        if qwen3_metal_q4_encode_slot(rt, qm, cid, slot_base + 10, rt.b_work, m.buf_gate_off, rt.b_work, m.buf_h_off, m.cfg.hidden, m.cfg.inter) != 0 {
            return qwen3_metal_q4_abort_cmd(rt, cid)
        }

        if l + 1 < m.cfg.layers {
            if qwen3_metal_encode_add_norm_slot(m, rt, cid, 3 + (l + 1) * 11, m.buf_x_off, m.buf_h_off, m.buf_h_off, m.cfg.hidden, eps_bits) != 0 {
                return qwen3_metal_q4_abort_cmd(rt, cid)
            }
        } else if compute_logits {
            if qwen3_metal_encode_add_norm_slot(m, rt, cid, 1, m.buf_x_off, m.buf_h_off, m.buf_h_off, m.cfg.hidden, eps_bits) != 0 {
                return qwen3_metal_q4_abort_cmd(rt, cid)
            }
        } else {
            if qwen3_metal_encode_vec_add(&rt.sess, cid, rt.pipes.vec_add, rt.b_work, m.buf_x_off, rt.b_work, m.buf_h_off, m.cfg.hidden) != 0 {
                return qwen3_metal_q4_abort_cmd(rt, cid)
            }
        }
        l = l + 1
    }

    if compute_logits {
        if m.cfg.layers <= 0 {
            if qwen3_metal_encode_rmsnorm_slot(m, rt, cid, 1, m.buf_x_off, m.buf_h_off, 1, m.cfg.hidden, eps_bits) != 0 {
                return qwen3_metal_q4_abort_cmd(rt, cid)
            }
        }
        if qwen3_metal_q4_encode_slot(rt, qm, cid, 2, rt.b_work, m.buf_h_off, rt.b_work, m.buf_logits_off, m.cfg.vocab, m.cfg.hidden) != 0 {
            return qwen3_metal_q4_abort_cmd(rt, cid)
        }
        if qwen3_metal_encode_argmax_top2(&rt.sess, cid, rt.pipes.argmax_top2, rt.b_work, m.buf_logits_off, rt.b_work, m.buf_top2_off, m.cfg.vocab) != 0 {
            return qwen3_metal_q4_abort_cmd(rt, cid)
        }
    }

    if metal_cmd_commit_sync(&rt.sess, cid) != 0 {
        return false
    }
    true
}
