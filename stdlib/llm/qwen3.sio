pub struct Qwen3Config {
    pub hidden: i64,
    pub inter: i64,
    pub layers: i64,
    pub n_q: i64,
    pub n_kv: i64,
    pub head_dim: i64,
    pub vocab: i64,
    pub eps: f64,
    pub rope_theta: f64,
    pub tied: bool,
    pub ok: bool,
}

pub fn qwen3_cfg_0_6b() -> Qwen3Config {
    Qwen3Config {
        hidden: 1024,
        inter: 3072,
        layers: 28,
        n_q: 16,
        n_kv: 8,
        head_dim: 128,
        vocab: 151936,
        eps: 0.000001,
        rope_theta: 1000000.0,
        tied: true,
        ok: true,
    }
}

pub fn qwen3_cfg_8b() -> Qwen3Config {
    Qwen3Config {
        hidden: 4096,
        inter: 12288,
        layers: 36,
        n_q: 32,
        n_kv: 8,
        head_dim: 128,
        vocab: 151936,
        eps: 0.000001,
        rope_theta: 1000000.0,
        tied: false,
        ok: true,
    }
}

fn qwen3_cfg_bad() -> Qwen3Config {
    Qwen3Config {
        hidden: 0,
        inter: 0,
        layers: 0,
        n_q: 0,
        n_kv: 0,
        head_dim: 0,
        vocab: 0,
        eps: 0.0,
        rope_theta: 0.0,
        tied: false,
        ok: false,
    }
}

fn qwen3_skip_ws(ptr: i64, pos: i64, limit: i64) -> i64 with Mut {
    var i = pos
    while i < limit {
        let c = ptr_read_u8(ptr, i)
        if c != 32 && c != 9 && c != 10 && c != 13 {
            return i
        }
        i = i + 1
    }
    i
}

fn qwen3_find_key(ptr: i64, limit: i64, key: string) -> (i64, i64, bool) with Mut {
    let klen = str_len(key)
    if ptr <= 0 || limit <= klen + 4 { return (0, 0, false) }
    var i: i64 = 0
    let end_scan = limit - klen - 2
    while i < end_scan {
        if ptr_read_u8(ptr, i) == 34 { // double quote
            if st_bytes_eq_str(ptr, i + 1, klen, key) && ptr_read_u8(ptr, i + 1 + klen) == 34 {
                var p = qwen3_skip_ws(ptr, i + 2 + klen, limit)
                if p < limit && ptr_read_u8(ptr, p) == 58 { // colon
                    let v_start = qwen3_skip_ws(ptr, p + 1, limit)
                    if v_start < limit {
                        let c0 = ptr_read_u8(ptr, v_start)
                        if c0 == 34 {
                            var sp = v_start + 1
                            while sp < limit {
                                let sc = ptr_read_u8(ptr, sp)
                                if sc == 92 {
                                    sp = sp + 2
                                } else if sc == 34 {
                                    return (v_start, sp + 1, true)
                                } else {
                                    sp = sp + 1
                                }
                            }
                        } else {
                            var ep = v_start
                            while ep < limit {
                                let c = ptr_read_u8(ptr, ep)
                                if c == 44 || c == 125 || c == 93 || c == 32 || c == 9 || c == 10 || c == 13 {
                                    break
                                }
                                ep = ep + 1
                            }
                            if ep > v_start {
                                return (v_start, ep, true)
                            }
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    (0, 0, false)
}

fn qwen3_parse_i64(ptr: i64, start: i64, end: i64) -> i64 with Mut {
    var p = qwen3_skip_ws(ptr, start, end)
    if p >= end { return 0 }
    var neg = false
    let c0 = ptr_read_u8(ptr, p)
    if c0 == 45 {
        neg = true
        p = p + 1
    }
    var v: i64 = 0
    while p < end {
        let c = ptr_read_u8(ptr, p)
        if c < 48 || c > 57 { break }
        v = v * 10 + (c - 48)
        p = p + 1
    }
    if neg { 0 - v } else { v }
}

fn qwen3_parse_bool(ptr: i64, start: i64, end: i64) -> bool with Mut {
    let p = qwen3_skip_ws(ptr, start, end)
    if p >= end { return false }
    let c = ptr_read_u8(ptr, p)
    c == 116 || c == 84 // t or T
}

fn qwen3_parse_f64(ptr: i64, start: i64, end: i64) -> f64 with Mut, Div, Panic {
    var p = qwen3_skip_ws(ptr, start, end)
    if p >= end { return 0.0 }
    var neg = false
    let c0 = ptr_read_u8(ptr, p)
    if c0 == 45 {
        neg = true
        p = p + 1
    } else if c0 == 43 {
        p = p + 1
    }
    var int_part: f64 = 0.0
    while p < end {
        let c = ptr_read_u8(ptr, p)
        if c < 48 || c > 57 { break }
        int_part = int_part * 10.0 + ((c - 48) as f64)
        p = p + 1
    }
    var frac_part: f64 = 0.0
    if p < end && ptr_read_u8(ptr, p) == 46 {
        p = p + 1
        var scale: f64 = 0.1
        while p < end {
            let c = ptr_read_u8(ptr, p)
            if c < 48 || c > 57 { break }
            frac_part = frac_part + ((c - 48) as f64) * scale
            scale = scale * 0.1
            p = p + 1
        }
    }
    var res = int_part + frac_part
    if p < end {
        let ec = ptr_read_u8(ptr, p)
        if ec == 101 || ec == 69 {
            p = p + 1
            var exp_neg = false
            if p < end {
                let sc = ptr_read_u8(ptr, p)
                if sc == 45 {
                    exp_neg = true
                    p = p + 1
                } else if sc == 43 {
                    p = p + 1
                }
            }
            var exp_val: i64 = 0
            while p < end {
                let c = ptr_read_u8(ptr, p)
                if c < 48 || c > 57 { break }
                exp_val = exp_val * 10 + (c - 48)
                p = p + 1
            }
            var mult: f64 = 1.0
            var i: i64 = 0
            while i < exp_val {
                mult = mult * 10.0
                i = i + 1
            }
            if exp_neg {
                res = res / mult
            } else {
                res = res * mult
            }
        }
    }
    if neg { 0.0 - res } else { res }
}

fn qwen3_trim_dir_len(dir: string) -> i64 with Mut {
    var n = str_len(dir)
    while n > 0 {
        let c = str_char_at(dir, n - 1) & 255
        if c == 10 || c == 13 || c == 32 || c == 9 || c == 47 {
            n = n - 1
        } else {
            break
        }
    }
    n
}

fn qwen3_open_file_in_dir(dir: string, rel: string) -> MappedShard with IO, Mut, Panic, Alloc {
    let dlen = qwen3_trim_dir_len(dir)
    let flen = str_len(rel)
    let buf = heap_alloc(dlen + flen + 2) as i64
    var i: i64 = 0
    while i < dlen {
        let _w = ptr_write_u8(buf, i, str_char_at(dir, i) & 255)
        i = i + 1
    }
    let _sl = ptr_write_u8(buf, dlen, 47)
    var j: i64 = 0
    while j < flen {
        let _w = ptr_write_u8(buf, dlen + 1 + j, str_char_at(rel, j) & 255)
        j = j + 1
    }
    let _z = ptr_write_u8(buf, dlen + 1 + flen, 0)
    let s = mapped_shard_open((buf as *mut u8) as string)
    heap_free(buf as *mut u8)
    s
}

fn qwen3_open_file_in_dir_bytes(dir: string, src_ptr: i64, off: i64, flen: i64) -> MappedShard with IO, Mut, Panic, Alloc {
    let dlen = qwen3_trim_dir_len(dir)
    let buf = heap_alloc(dlen + flen + 2) as i64
    var i: i64 = 0
    while i < dlen {
        let _w = ptr_write_u8(buf, i, str_char_at(dir, i) & 255)
        i = i + 1
    }
    let _sl = ptr_write_u8(buf, dlen, 47)
    var j: i64 = 0
    while j < flen {
        let _w = ptr_write_u8(buf, dlen + 1 + j, ptr_read_u8(src_ptr, off + j))
        j = j + 1
    }
    let _z = ptr_write_u8(buf, dlen + 1 + flen, 0)
    let s = mapped_shard_open((buf as *mut u8) as string)
    heap_free(buf as *mut u8)
    s
}

pub fn qwen3_config_load(dir_path: string) -> Qwen3Config with IO, Mut, Panic, Alloc, Div {
    let shard = qwen3_open_file_in_dir(dir_path, "config.json")
    var cfg = qwen3_cfg_bad()

    if mapped_shard_is_ok(&shard) {
        let ptr = mapped_shard_ptr(&shard)
        let len = mapped_shard_len(&shard)

        let r_hid = qwen3_find_key(ptr, len, "hidden_size")
        let r_inter = qwen3_find_key(ptr, len, "intermediate_size")
        let r_lay = qwen3_find_key(ptr, len, "num_hidden_layers")
        let r_nq = qwen3_find_key(ptr, len, "num_attention_heads")
        let r_nkv = qwen3_find_key(ptr, len, "num_key_value_heads")
        let r_hd = qwen3_find_key(ptr, len, "head_dim")
        let r_voc = qwen3_find_key(ptr, len, "vocab_size")
        let r_eps = qwen3_find_key(ptr, len, "rms_norm_eps")
        let r_theta = qwen3_find_key(ptr, len, "rope_theta")
        let r_tied = qwen3_find_key(ptr, len, "tie_word_embeddings")

        if r_hid.2 && r_inter.2 && r_lay.2 && r_nq.2 && r_nkv.2 && r_voc.2 {
            let hidden = qwen3_parse_i64(ptr, r_hid.0, r_hid.1)
            let inter = qwen3_parse_i64(ptr, r_inter.0, r_inter.1)
            let layers = qwen3_parse_i64(ptr, r_lay.0, r_lay.1)
            let n_q = qwen3_parse_i64(ptr, r_nq.0, r_nq.1)
            let n_kv = qwen3_parse_i64(ptr, r_nkv.0, r_nkv.1)
            var head_dim = if r_hd.2 { qwen3_parse_i64(ptr, r_hd.0, r_hd.1) } else { 0 }
            if head_dim <= 0 && n_q > 0 {
                head_dim = hidden / n_q
            }
            let vocab = qwen3_parse_i64(ptr, r_voc.0, r_voc.1)
            var eps: f64 = if r_eps.2 { qwen3_parse_f64(ptr, r_eps.0, r_eps.1) } else { 0.000001 }
            if eps <= 0.0 { eps = 0.000001 }
            var rope_theta: f64 = if r_theta.2 { qwen3_parse_f64(ptr, r_theta.0, r_theta.1) } else { 1000000.0 }
            if rope_theta <= 0.0 { rope_theta = 1000000.0 }
            let tied = if r_tied.2 { qwen3_parse_bool(ptr, r_tied.0, r_tied.1) } else { false }

            cfg = Qwen3Config {
                hidden: hidden,
                inter: inter,
                layers: layers,
                n_q: n_q,
                n_kv: n_kv,
                head_dim: head_dim,
                vocab: vocab,
                eps: eps,
                rope_theta: rope_theta,
                tied: tied,
                ok: true,
            }
        }
    }

    let _c = mapped_shard_close(shard)
    cfg
}

fn align_up_64(x: i64) -> i64 with Div {
    let rem = x % 64
    if rem == 0 { x } else { x + (64 - rem) }
}

fn qwen3_copy_lit(buf: i64, p: i64, s: string) -> i64 with Mut {
    let n = str_len(s)
    var i: i64 = 0
    while i < n {
        let _w = ptr_write_u8(buf, p + i, str_char_at(s, i) & 255)
        i = i + 1
    }
    p + n
}

fn qwen3_copy_num(buf: i64, p: i64, n: i64) -> i64 with Mut, Div {
    if n == 0 {
        let _w = ptr_write_u8(buf, p, 48)
        return p + 1
    }
    var digits: i64 = 0
    var temp = n
    while temp > 0 {
        digits = digits + 1
        temp = temp / 10
    }
    var pos = p + digits - 1
    temp = n
    while temp > 0 {
        let d = temp % 10
        let _w = ptr_write_u8(buf, pos, 48 + d)
        pos = pos - 1
        temp = temp / 10
    }
    p + digits
}

fn qwen3_format_layer_tensor_name(buf: i64, layer: i64, kind: i32) -> i64 with Mut, Div {
    var p = qwen3_copy_lit(buf, 0, "model.layers.")
    p = qwen3_copy_num(buf, p, layer)
    if kind == 0 { p = qwen3_copy_lit(buf, p, ".input_layernorm.weight") }
    else if kind == 1 { p = qwen3_copy_lit(buf, p, ".self_attn.q_proj.weight") }
    else if kind == 2 { p = qwen3_copy_lit(buf, p, ".self_attn.k_proj.weight") }
    else if kind == 3 { p = qwen3_copy_lit(buf, p, ".self_attn.v_proj.weight") }
    else if kind == 4 { p = qwen3_copy_lit(buf, p, ".self_attn.o_proj.weight") }
    else if kind == 5 { p = qwen3_copy_lit(buf, p, ".self_attn.q_norm.weight") }
    else if kind == 6 { p = qwen3_copy_lit(buf, p, ".self_attn.k_norm.weight") }
    else if kind == 7 { p = qwen3_copy_lit(buf, p, ".post_attention_layernorm.weight") }
    else if kind == 8 { p = qwen3_copy_lit(buf, p, ".mlp.gate_proj.weight") }
    else if kind == 9 { p = qwen3_copy_lit(buf, p, ".mlp.up_proj.weight") }
    else if kind == 10 { p = qwen3_copy_lit(buf, p, ".mlp.down_proj.weight") }
    p
}

pub linear struct Qwen3Model {
    pub s0: MappedShard,
    pub s1: MappedShard,
    pub s2: MappedShard,
    pub s3: MappedShard,
    pub s4: MappedShard,
    pub s5: MappedShard,
    pub s6: MappedShard,
    pub s7: MappedShard,
    pub arena: PageArena,
    pub cfg: Qwen3Config,
    pub n_shards: i64,
    pub table_off: i64,
    pub buf_x_off: i64,
    pub buf_h_off: i64,
    pub buf_q_off: i64,
    pub buf_k_off: i64,
    pub buf_v_off: i64,
    pub buf_attn_out_off: i64,
    pub buf_gate_off: i64,
    pub buf_up_off: i64,
    pub buf_logits_off: i64,
    pub buf_logits_err_off: i64,
    pub buf_tmp_err_off: i64,
    pub buf_top2_off: i64,
    pub ok: bool,
}

fn qwen3_model_empty() -> Qwen3Model {
    Qwen3Model {
        s0: MappedShard { ptr: 0, len: 0, ok: false },
        s1: MappedShard { ptr: 0, len: 0, ok: false },
        s2: MappedShard { ptr: 0, len: 0, ok: false },
        s3: MappedShard { ptr: 0, len: 0, ok: false },
        s4: MappedShard { ptr: 0, len: 0, ok: false },
        s5: MappedShard { ptr: 0, len: 0, ok: false },
        s6: MappedShard { ptr: 0, len: 0, ok: false },
        s7: MappedShard { ptr: 0, len: 0, ok: false },
        arena: PageArena { ptr: 0, len: 0, ok: false },
        cfg: qwen3_cfg_bad(),
        n_shards: 0,
        table_off: 0,
        buf_x_off: 0,
        buf_h_off: 0,
        buf_q_off: 0,
        buf_k_off: 0,
        buf_v_off: 0,
        buf_attn_out_off: 0,
        buf_gate_off: 0,
        buf_up_off: 0,
        buf_logits_off: 0,
        buf_logits_err_off: 0,
        buf_tmp_err_off: 0,
        buf_top2_off: 0,
        ok: false,
    }
}

pub fn qwen3_model_is_ok(m: &Qwen3Model) -> bool { m.ok }
pub fn qwen3_model_cfg(m: &Qwen3Model) -> Qwen3Config { m.cfg }
pub fn qwen3_model_n_shards(m: &Qwen3Model) -> i64 { m.n_shards }
pub fn qwen3_model_work_ptr(m: &Qwen3Model) -> i64 { page_arena_ptr(&m.arena) }
pub fn qwen3_model_work_len(m: &Qwen3Model) -> i64 { page_arena_len(&m.arena) }

pub fn qwen3_model_shard_ptr(m: &Qwen3Model, shard_idx: i64) -> i64 {
    if shard_idx == 0 { return mapped_shard_ptr(&m.s0) }
    if shard_idx == 1 { return mapped_shard_ptr(&m.s1) }
    if shard_idx == 2 { return mapped_shard_ptr(&m.s2) }
    if shard_idx == 3 { return mapped_shard_ptr(&m.s3) }
    if shard_idx == 4 { return mapped_shard_ptr(&m.s4) }
    if shard_idx == 5 { return mapped_shard_ptr(&m.s5) }
    if shard_idx == 6 { return mapped_shard_ptr(&m.s6) }
    if shard_idx == 7 { return mapped_shard_ptr(&m.s7) }
    0
}

pub fn qwen3_model_shard_len(m: &Qwen3Model, shard_idx: i64) -> i64 {
    if shard_idx == 0 { return mapped_shard_len(&m.s0) }
    if shard_idx == 1 { return mapped_shard_len(&m.s1) }
    if shard_idx == 2 { return mapped_shard_len(&m.s2) }
    if shard_idx == 3 { return mapped_shard_len(&m.s3) }
    if shard_idx == 4 { return mapped_shard_len(&m.s4) }
    if shard_idx == 5 { return mapped_shard_len(&m.s5) }
    if shard_idx == 6 { return mapped_shard_len(&m.s6) }
    if shard_idx == 7 { return mapped_shard_len(&m.s7) }
    0
}

pub fn qwen3_model_free(m: Qwen3Model) -> i64 with IO, Mut {
    let Qwen3Model {
        s0,
        s1,
        s2,
        s3,
        s4,
        s5,
        s6,
        s7,
        arena,
        cfg: _,
        n_shards: _,
        table_off: _,
        buf_x_off: _,
        buf_h_off: _,
        buf_q_off: _,
        buf_k_off: _,
        buf_v_off: _,
        buf_attn_out_off: _,
        buf_gate_off: _,
        buf_up_off: _,
        buf_logits_off: _,
        buf_logits_err_off: _,
        buf_tmp_err_off: _,
        buf_top2_off: _,
        ok: _,
    } = m
    let _c0 = mapped_shard_close(s0)
    let _c1 = mapped_shard_close(s1)
    let _c2 = mapped_shard_close(s2)
    let _c3 = mapped_shard_close(s3)
    let _c4 = mapped_shard_close(s4)
    let _c5 = mapped_shard_close(s5)
    let _c6 = mapped_shard_close(s6)
    let _c7 = mapped_shard_close(s7)
    let _ca = page_arena_free(arena)
    0
}

pub fn qwen3_model_logits_ptr(m: &Qwen3Model) -> i64 {
    page_arena_ptr(&m.arena) + m.buf_logits_off
}

fn qwen3_model_slot_addr(m: &Qwen3Model, slot: i64) -> i64 {
    page_arena_ptr(&m.arena) + m.table_off + slot * 48
}

fn qwen3_model_tensor_shard_idx(m: &Qwen3Model, slot: i64) -> i64 {
    let p = qwen3_model_slot_addr(m, slot)
    ptr_read_i64_le(p, 0)
}

fn qwen3_model_tensor_data_off(m: &Qwen3Model, slot: i64) -> i64 {
    let p = qwen3_model_slot_addr(m, slot)
    ptr_read_i64_le(p, 8)
}

fn qwen3_model_tensor_dtype(m: &Qwen3Model, slot: i64) -> i32 {
    let p = qwen3_model_slot_addr(m, slot)
    ptr_read_i64_le(p, 16) as i32
}

fn qwen3_model_tensor_rows(m: &Qwen3Model, slot: i64) -> i64 {
    let p = qwen3_model_slot_addr(m, slot)
    ptr_read_i64_le(p, 24)
}

fn qwen3_model_tensor_cols(m: &Qwen3Model, slot: i64) -> i64 {
    let p = qwen3_model_slot_addr(m, slot)
    ptr_read_i64_le(p, 32)
}

fn qwen3_model_tensor_host_ptr(m: &Qwen3Model, slot: i64) -> i64 {
    let p = qwen3_model_slot_addr(m, slot)
    ptr_read_i64_le(p, 40)
}

fn qwen3_write_tensor_entry(
    arena_ptr: i64,
    table_off: i64,
    slot: i64,
    shard_idx: i64,
    data_off: i64,
    dtype: i32,
    rows: i64,
    cols: i64,
    host_ptr: i64
) {
    let p = arena_ptr + table_off + slot * 48
    let _0 = ptr_write_i64_le(p, 0, shard_idx)
    let _1 = ptr_write_i64_le(p, 8, data_off)
    let _2 = ptr_write_i64_le(p, 16, dtype as i64)
    let _3 = ptr_write_i64_le(p, 24, rows)
    let _4 = ptr_write_i64_le(p, 32, cols)
    let _5 = ptr_write_i64_le(p, 40, host_ptr)
}

fn qwen3_populate_tensor_table(
    arena_ptr: i64,
    table_off: i64,
    cfg: &Qwen3Config,
    s0: &MappedShard,
    hdr0: &StMmapHeader,
    s1: &MappedShard,
    hdr1: &StMmapHeader,
    s2: &MappedShard,
    hdr2: &StMmapHeader,
    s3: &MappedShard,
    hdr3: &StMmapHeader,
    s4: &MappedShard,
    hdr4: &StMmapHeader,
    s5: &MappedShard,
    hdr5: &StMmapHeader,
    s6: &MappedShard,
    hdr6: &StMmapHeader,
    s7: &MappedShard,
    hdr7: &StMmapHeader,
    has_idx: bool,
    idx_shard: &MappedShard,
    sh0_off: i64,
    sh0_len: i64,
    sh1_off: i64,
    sh1_len: i64,
    sh2_off: i64,
    sh2_len: i64,
    sh3_off: i64,
    sh3_len: i64,
    sh4_off: i64,
    sh4_len: i64,
    sh5_off: i64,
    sh5_len: i64,
    sh6_off: i64,
    sh6_len: i64,
    sh7_off: i64,
    sh7_len: i64
) with Alloc, Mut, Div {
    let name_buf = heap_alloc(256) as i64
    let idx_p = if has_idx { mapped_shard_ptr(idx_shard) } else { 0 }

    var slot: i64 = 0
    let total_slots = 3 + cfg.layers * 11
    while slot < total_slots {
        var nlen: i64 = 0
        if slot == 0 {
            nlen = qwen3_copy_lit(name_buf, 0, "model.embed_tokens.weight")
        } else if slot == 1 {
            nlen = qwen3_copy_lit(name_buf, 0, "model.norm.weight")
        } else if slot == 2 {
            nlen = qwen3_copy_lit(name_buf, 0, "lm_head.weight")
        } else {
            let l_idx = (slot - 3) / 11
            let k_idx = ((slot - 3) % 11) as i32
            nlen = qwen3_format_layer_tensor_name(name_buf, l_idx, k_idx)
        }

        var found_view = StTensorView {
            found: false,
            dtype: 0,
            rank: 0,
            d0: 0,
            d1: 0,
            d2: 0,
            d3: 0,
            count: 0,
            data_off: 0,
            byte_len: 0,
            host_ptr: 0,
        }
        var target_shard: i64 = -1

        if has_idx {
            let r = st_index_resolve_shard_by_bytes(idx_shard, name_buf, nlen)
            if r.2 {
                let sh_off = r.0
                let sh_len = r.1
                if sh0_len > 0 && st_bytes_eq_buf(idx_p, sh_off, sh_len, idx_p + sh0_off, sh0_len) {
                    target_shard = 0
                } else if sh1_len > 0 && st_bytes_eq_buf(idx_p, sh_off, sh_len, idx_p + sh1_off, sh1_len) {
                    target_shard = 1
                } else if sh2_len > 0 && st_bytes_eq_buf(idx_p, sh_off, sh_len, idx_p + sh2_off, sh2_len) {
                    target_shard = 2
                } else if sh3_len > 0 && st_bytes_eq_buf(idx_p, sh_off, sh_len, idx_p + sh3_off, sh3_len) {
                    target_shard = 3
                } else if sh4_len > 0 && st_bytes_eq_buf(idx_p, sh_off, sh_len, idx_p + sh4_off, sh4_len) {
                    target_shard = 4
                } else if sh5_len > 0 && st_bytes_eq_buf(idx_p, sh_off, sh_len, idx_p + sh5_off, sh5_len) {
                    target_shard = 5
                } else if sh6_len > 0 && st_bytes_eq_buf(idx_p, sh_off, sh_len, idx_p + sh6_off, sh6_len) {
                    target_shard = 6
                } else if sh7_len > 0 && st_bytes_eq_buf(idx_p, sh_off, sh_len, idx_p + sh7_off, sh7_len) {
                    target_shard = 7
                }
            }
        } else {
            target_shard = 0
        }

        if target_shard == 0 && mapped_shard_is_ok(s0) {
            found_view = st_mmap_find_tensor_bytes(s0, hdr0, name_buf, nlen)
        } else if target_shard == 1 && mapped_shard_is_ok(s1) {
            found_view = st_mmap_find_tensor_bytes(s1, hdr1, name_buf, nlen)
        } else if target_shard == 2 && mapped_shard_is_ok(s2) {
            found_view = st_mmap_find_tensor_bytes(s2, hdr2, name_buf, nlen)
        } else if target_shard == 3 && mapped_shard_is_ok(s3) {
            found_view = st_mmap_find_tensor_bytes(s3, hdr3, name_buf, nlen)
        } else if target_shard == 4 && mapped_shard_is_ok(s4) {
            found_view = st_mmap_find_tensor_bytes(s4, hdr4, name_buf, nlen)
        } else if target_shard == 5 && mapped_shard_is_ok(s5) {
            found_view = st_mmap_find_tensor_bytes(s5, hdr5, name_buf, nlen)
        } else if target_shard == 6 && mapped_shard_is_ok(s6) {
            found_view = st_mmap_find_tensor_bytes(s6, hdr6, name_buf, nlen)
        } else if target_shard == 7 && mapped_shard_is_ok(s7) {
            found_view = st_mmap_find_tensor_bytes(s7, hdr7, name_buf, nlen)
        }

        if found_view.found {
            qwen3_write_tensor_entry(
                arena_ptr,
                table_off,
                slot,
                target_shard,
                found_view.data_off,
                found_view.dtype,
                st_view_dim(&found_view, 0),
                st_view_dim(&found_view, 1),
                found_view.host_ptr
            )
        } else {
            if slot == 2 && cfg.tied {
                let s_emb_idx = ptr_read_i64_le(arena_ptr + table_off, 0)
                let s_emb_off = ptr_read_i64_le(arena_ptr + table_off, 8)
                let s_emb_dt = ptr_read_i64_le(arena_ptr + table_off, 16) as i32
                let s_emb_r = ptr_read_i64_le(arena_ptr + table_off, 24)
                let s_emb_c = ptr_read_i64_le(arena_ptr + table_off, 32)
                let s_emb_p = ptr_read_i64_le(arena_ptr + table_off, 40)
                qwen3_write_tensor_entry(arena_ptr, table_off, 2, s_emb_idx, s_emb_off, s_emb_dt, s_emb_r, s_emb_c, s_emb_p)
            } else {
                qwen3_write_tensor_entry(arena_ptr, table_off, slot, -1, 0, 0, 0, 0, 0)
            }
        }

        slot = slot + 1
    }

    heap_free(name_buf as *mut u8)
}

pub fn qwen3_model_open(dir_path: string) -> Qwen3Model with IO, Mut, Panic, Alloc, Div {
    let cfg = qwen3_config_load(dir_path)
    if !cfg.ok { return qwen3_model_empty() }

    let idx_shard = qwen3_open_file_in_dir(dir_path, "model.safetensors.index.json")
    let has_idx = mapped_shard_is_ok(&idx_shard)

    var sh0_off: i64 = 0
    var sh0_len: i64 = 0
    var sh1_off: i64 = 0
    var sh1_len: i64 = 0
    var sh2_off: i64 = 0
    var sh2_len: i64 = 0
    var sh3_off: i64 = 0
    var sh3_len: i64 = 0
    var sh4_off: i64 = 0
    var sh4_len: i64 = 0
    var sh5_off: i64 = 0
    var sh5_len: i64 = 0
    var sh6_off: i64 = 0
    var sh6_len: i64 = 0
    var sh7_off: i64 = 0
    var sh7_len: i64 = 0
    var n_shards: i64 = 0

    if has_idx {
        let idx_p = mapped_shard_ptr(&idx_shard)
        let name_scan = heap_alloc(256) as i64
        var s_i: i64 = 0
        let total_slots = 3 + cfg.layers * 11
        while s_i < total_slots {
            var nlen: i64 = 0
            if s_i == 0 {
                nlen = qwen3_copy_lit(name_scan, 0, "model.embed_tokens.weight")
            } else if s_i == 1 {
                nlen = qwen3_copy_lit(name_scan, 0, "model.norm.weight")
            } else if s_i == 2 {
                nlen = qwen3_copy_lit(name_scan, 0, "lm_head.weight")
            } else {
                let l_idx = (s_i - 3) / 11
                let k_idx = ((s_i - 3) % 11) as i32
                nlen = qwen3_format_layer_tensor_name(name_scan, l_idx, k_idx)
            }
            let r = st_index_resolve_shard_by_bytes(&idx_shard, name_scan, nlen)
            if r.2 {
                let off = r.0
                let len = r.1
                var match_found = false
                if n_shards > 0 && st_bytes_eq_buf(idx_p, off, len, idx_p + sh0_off, sh0_len) {
                    match_found = true
                } else if n_shards > 1 && st_bytes_eq_buf(idx_p, off, len, idx_p + sh1_off, sh1_len) {
                    match_found = true
                } else if n_shards > 2 && st_bytes_eq_buf(idx_p, off, len, idx_p + sh2_off, sh2_len) {
                    match_found = true
                } else if n_shards > 3 && st_bytes_eq_buf(idx_p, off, len, idx_p + sh3_off, sh3_len) {
                    match_found = true
                } else if n_shards > 4 && st_bytes_eq_buf(idx_p, off, len, idx_p + sh4_off, sh4_len) {
                    match_found = true
                } else if n_shards > 5 && st_bytes_eq_buf(idx_p, off, len, idx_p + sh5_off, sh5_len) {
                    match_found = true
                } else if n_shards > 6 && st_bytes_eq_buf(idx_p, off, len, idx_p + sh6_off, sh6_len) {
                    match_found = true
                } else if n_shards > 7 && st_bytes_eq_buf(idx_p, off, len, idx_p + sh7_off, sh7_len) {
                    match_found = true
                }
                if !match_found {
                    if n_shards == 0 {
                        sh0_off = off
                        sh0_len = len
                        n_shards = 1
                    } else if n_shards == 1 {
                        sh1_off = off
                        sh1_len = len
                        n_shards = 2
                    } else if n_shards == 2 {
                        sh2_off = off
                        sh2_len = len
                        n_shards = 3
                    } else if n_shards == 3 {
                        sh3_off = off
                        sh3_len = len
                        n_shards = 4
                    } else if n_shards == 4 {
                        sh4_off = off
                        sh4_len = len
                        n_shards = 5
                    } else if n_shards == 5 {
                        sh5_off = off
                        sh5_len = len
                        n_shards = 6
                    } else if n_shards == 6 {
                        sh6_off = off
                        sh6_len = len
                        n_shards = 7
                    } else if n_shards == 7 {
                        sh7_off = off
                        sh7_len = len
                        n_shards = 8
                    }
                }
            }
            s_i = s_i + 1
        }
        heap_free(name_scan as *mut u8)
    } else {
        n_shards = 1
    }

    let idx_p = if has_idx { mapped_shard_ptr(&idx_shard) } else { 0 }
    let s0 = if has_idx {
        if n_shards >= 1 { qwen3_open_file_in_dir_bytes(dir_path, idx_p, sh0_off, sh0_len) } else { MappedShard { ptr: 0, len: 0, ok: false } }
    } else {
        qwen3_open_file_in_dir(dir_path, "model.safetensors")
    }
    let s1 = if has_idx && n_shards >= 2 {
        qwen3_open_file_in_dir_bytes(dir_path, idx_p, sh1_off, sh1_len)
    } else {
        MappedShard { ptr: 0, len: 0, ok: false }
    }
    let s2 = if has_idx && n_shards >= 3 {
        qwen3_open_file_in_dir_bytes(dir_path, idx_p, sh2_off, sh2_len)
    } else {
        MappedShard { ptr: 0, len: 0, ok: false }
    }
    let s3 = if has_idx && n_shards >= 4 {
        qwen3_open_file_in_dir_bytes(dir_path, idx_p, sh3_off, sh3_len)
    } else {
        MappedShard { ptr: 0, len: 0, ok: false }
    }
    let s4 = if has_idx && n_shards >= 5 {
        qwen3_open_file_in_dir_bytes(dir_path, idx_p, sh4_off, sh4_len)
    } else {
        MappedShard { ptr: 0, len: 0, ok: false }
    }
    let s5 = if has_idx && n_shards >= 6 {
        qwen3_open_file_in_dir_bytes(dir_path, idx_p, sh5_off, sh5_len)
    } else {
        MappedShard { ptr: 0, len: 0, ok: false }
    }
    let s6 = if has_idx && n_shards >= 7 {
        qwen3_open_file_in_dir_bytes(dir_path, idx_p, sh6_off, sh6_len)
    } else {
        MappedShard { ptr: 0, len: 0, ok: false }
    }
    let s7 = if has_idx && n_shards >= 8 {
        qwen3_open_file_in_dir_bytes(dir_path, idx_p, sh7_off, sh7_len)
    } else {
        MappedShard { ptr: 0, len: 0, ok: false }
    }

    let hdr0 = if mapped_shard_is_ok(&s0) { st_mmap_parse_header(&s0) } else { StMmapHeader { hdr_len: 0, data_base_off: 0, ok: false } }
    let hdr1 = if mapped_shard_is_ok(&s1) { st_mmap_parse_header(&s1) } else { StMmapHeader { hdr_len: 0, data_base_off: 0, ok: false } }
    let hdr2 = if mapped_shard_is_ok(&s2) { st_mmap_parse_header(&s2) } else { StMmapHeader { hdr_len: 0, data_base_off: 0, ok: false } }
    let hdr3 = if mapped_shard_is_ok(&s3) { st_mmap_parse_header(&s3) } else { StMmapHeader { hdr_len: 0, data_base_off: 0, ok: false } }
    let hdr4 = if mapped_shard_is_ok(&s4) { st_mmap_parse_header(&s4) } else { StMmapHeader { hdr_len: 0, data_base_off: 0, ok: false } }
    let hdr5 = if mapped_shard_is_ok(&s5) { st_mmap_parse_header(&s5) } else { StMmapHeader { hdr_len: 0, data_base_off: 0, ok: false } }
    let hdr6 = if mapped_shard_is_ok(&s6) { st_mmap_parse_header(&s6) } else { StMmapHeader { hdr_len: 0, data_base_off: 0, ok: false } }
    let hdr7 = if mapped_shard_is_ok(&s7) { st_mmap_parse_header(&s7) } else { StMmapHeader { hdr_len: 0, data_base_off: 0, ok: false } }

    let max_tensors = 3 + cfg.layers * 11 + 4
    let table_bytes = align_up_64(max_tensors * 48)
    let buf_x_bytes = align_up_64(cfg.hidden * 4)
    let buf_h_bytes = align_up_64(cfg.hidden * 4)
    let buf_q_bytes = align_up_64(cfg.n_q * cfg.head_dim * 4)
    let buf_k_bytes = align_up_64(cfg.n_kv * cfg.head_dim * 4)
    let buf_v_bytes = align_up_64(cfg.n_kv * cfg.head_dim * 4)
    let buf_attn_bytes = align_up_64(cfg.n_q * cfg.head_dim * 4)
    let buf_gate_bytes = align_up_64(cfg.inter * 4)
    let buf_up_bytes = align_up_64(cfg.inter * 4)
    let buf_logits_bytes = align_up_64(cfg.vocab * 4)
    let buf_logits_err_bytes = align_up_64(cfg.vocab * 4)

    var max_err_dim = cfg.vocab
    if cfg.inter > max_err_dim { max_err_dim = cfg.inter }
    if cfg.hidden > max_err_dim { max_err_dim = cfg.hidden }
    let q_dim = cfg.n_q * cfg.head_dim
    if q_dim > max_err_dim { max_err_dim = q_dim }
    let buf_tmp_err_bytes = align_up_64(max_err_dim * 4)

    let table_off: i64 = 0
    let buf_x_off = table_off + table_bytes
    let buf_h_off = buf_x_off + buf_x_bytes
    let buf_q_off = buf_h_off + buf_h_bytes
    let buf_k_off = buf_q_off + buf_q_bytes
    let buf_v_off = buf_k_off + buf_k_bytes
    let buf_attn_out_off = buf_v_off + buf_v_bytes
    let buf_gate_off = buf_attn_out_off + buf_attn_bytes
    let buf_up_off = buf_gate_off + buf_gate_bytes
    let buf_logits_off = buf_up_off + buf_up_bytes
    let buf_logits_err_off = buf_logits_off + buf_logits_bytes
    let buf_tmp_err_off = buf_logits_err_off + buf_logits_err_bytes
    let buf_top2_off = buf_tmp_err_off + buf_tmp_err_bytes
    let batch8_base = align_up_64(buf_top2_off + 64)
    let bx8_bytes = align_up_64(8 * cfg.hidden * 4)
    let bh8_bytes = align_up_64(8 * cfg.hidden * 4)
    let bq8_bytes = align_up_64(8 * cfg.n_q * cfg.head_dim * 4)
    let bk8_bytes = align_up_64(8 * cfg.n_kv * cfg.head_dim * 4)
    let bv8_bytes = align_up_64(8 * cfg.n_kv * cfg.head_dim * 4)
    let battn8_bytes = align_up_64(8 * cfg.n_q * cfg.head_dim * 4)
    let bgate8_bytes = align_up_64(8 * cfg.inter * 4)
    let bup8_bytes = align_up_64(8 * cfg.inter * 4)
    let blogits8_bytes = align_up_64(8 * cfg.vocab * 4)
    let btop2_8_bytes = align_up_64(8 * 32)
    let total_arena_bytes = batch8_base + bx8_bytes + bh8_bytes + bq8_bytes + bk8_bytes + bv8_bytes
        + battn8_bytes + bgate8_bytes + bup8_bytes + blogits8_bytes + btop2_8_bytes + 16384

    let arena = page_arena_alloc(total_arena_bytes)
    var model_ok = mapped_shard_is_ok(&s0) && hdr0.ok && page_arena_is_ok(&arena)
    if n_shards >= 2 && (!mapped_shard_is_ok(&s1) || !hdr1.ok) { model_ok = false }
    if n_shards >= 3 && (!mapped_shard_is_ok(&s2) || !hdr2.ok) { model_ok = false }
    if n_shards >= 4 && (!mapped_shard_is_ok(&s3) || !hdr3.ok) { model_ok = false }
    if n_shards >= 5 && (!mapped_shard_is_ok(&s4) || !hdr4.ok) { model_ok = false }
    if n_shards >= 6 && (!mapped_shard_is_ok(&s5) || !hdr5.ok) { model_ok = false }
    if n_shards >= 7 && (!mapped_shard_is_ok(&s6) || !hdr6.ok) { model_ok = false }
    if n_shards >= 8 && (!mapped_shard_is_ok(&s7) || !hdr7.ok) { model_ok = false }

    if model_ok {
        qwen3_populate_tensor_table(
            page_arena_ptr(&arena),
            table_off,
            &cfg,
            &s0,
            &hdr0,
            &s1,
            &hdr1,
            &s2,
            &hdr2,
            &s3,
            &hdr3,
            &s4,
            &hdr4,
            &s5,
            &hdr5,
            &s6,
            &hdr6,
            &s7,
            &hdr7,
            has_idx,
            &idx_shard,
            sh0_off,
            sh0_len,
            sh1_off,
            sh1_len,
            sh2_off,
            sh2_len,
            sh3_off,
            sh3_len,
            sh4_off,
            sh4_len,
            sh5_off,
            sh5_len,
            sh6_off,
            sh6_len,
            sh7_off,
            sh7_len
        )
    }

    let _ci = mapped_shard_close(idx_shard)

    Qwen3Model {
        s0: s0,
        s1: s1,
        s2: s2,
        s3: s3,
        s4: s4,
        s5: s5,
        s6: s6,
        s7: s7,
        arena: arena,
        cfg: cfg,
        n_shards: n_shards,
        table_off: table_off,
        buf_x_off: buf_x_off,
        buf_h_off: buf_h_off,
        buf_q_off: buf_q_off,
        buf_k_off: buf_k_off,
        buf_v_off: buf_v_off,
        buf_attn_out_off: buf_attn_out_off,
        buf_gate_off: buf_gate_off,
        buf_up_off: buf_up_off,
        buf_logits_off: buf_logits_off,
        buf_logits_err_off: buf_logits_err_off,
        buf_tmp_err_off: buf_tmp_err_off,
        buf_top2_off: buf_top2_off,
        ok: model_ok,
    }
}

pub fn qwen3_logit_f64(m: &Qwen3Model, vocab_idx: i64) -> f64 with Mut {
    if !m.ok || vocab_idx < 0 || vocab_idx >= m.cfg.vocab { return 0.0 }
    let p = page_arena_ptr(&m.arena) + m.buf_logits_off + vocab_idx * 4
    let bits = ptr_read_u32_le(p, 0)
    f32_bits_to_f64(bits)
}

pub fn qwen3_logit_err_f64(m: &Qwen3Model, vocab_idx: i64) -> f64 with Mut {
    if !m.ok || vocab_idx < 0 || vocab_idx >= m.cfg.vocab { return 0.0 }
    let p = page_arena_ptr(&m.arena) + m.buf_logits_err_off + vocab_idx * 4
    let bits = ptr_read_u32_le(p, 0)
    f32_bits_to_f64(bits)
}

pub fn qwen3_logits_argmax(m: &Qwen3Model) -> i64 with Mut {
    if !m.ok || m.cfg.vocab <= 0 { return 0 }
    let base = page_arena_ptr(&m.arena) + m.buf_logits_off
    var best_idx: i64 = 0
    var best_val = f32_bits_to_f64(ptr_read_u32_le(base, 0))
    var i: i64 = 1
    while i < m.cfg.vocab {
        let val = f32_bits_to_f64(ptr_read_u32_le(base, i * 4))
        if val > best_val {
            best_val = val
            best_idx = i
        }
        i = i + 1
    }
    best_idx
}

pub struct Qwen3Top2 {
    pub top1_id: i64,
    pub runner_up_id: i64,
    pub top1_val: f64,
    pub second_val: f64,
}

pub fn qwen3_cpu_top2(base: i64, out: i64, vocab: i64) -> i64 with Mut {
    if base == 0 || out == 0 || vocab <= 0 { return -1 }
    var t1_id: i64 = 0
    var t1_v = f32_bits_to_f64(ptr_read_u32_le(base, 0))
    var t1_bits = ptr_read_u32_le(base, 0)
    var t2_id: i64 = 0
    var t2_v = t1_v
    var t2_bits = t1_bits
    if vocab >= 2 {
        let b1 = ptr_read_u32_le(base, 4)
        let v1 = f32_bits_to_f64(b1)
        if v1 > t1_v {
            t2_id = t1_id
            t2_v = t1_v
            t2_bits = t1_bits
            t1_id = 1
            t1_v = v1
            t1_bits = b1
        } else {
            t2_id = 1
            t2_v = v1
            t2_bits = b1
        }
        var i: i64 = 2
        while i < vocab {
            let bi = ptr_read_u32_le(base, i * 4)
            let v = f32_bits_to_f64(bi)
            if v > t1_v {
                t2_id = t1_id
                t2_v = t1_v
                t2_bits = t1_bits
                t1_id = i
                t1_v = v
                t1_bits = bi
            } else if v > t2_v {
                t2_id = i
                t2_v = v
                t2_bits = bi
            }
            i = i + 1
        }
    }
    let _w0 = ptr_write_i64_le(out, 0, t1_id)
    let _w1 = ptr_write_i64_le(out, 8, t2_id)
    let _w2 = ptr_write_u32_le(out, 16, t1_bits)
    let _w3 = ptr_write_u32_le(out, 20, t2_bits)
    0
}

fn qwen3_model_write_top2_cpu(m: &Qwen3Model) -> i64 with Mut {
    if !m.ok { return -1 }
    let a_base = page_arena_ptr(&m.arena)
    qwen3_cpu_top2(a_base + m.buf_logits_off, a_base + m.buf_top2_off, m.cfg.vocab)
}

pub fn qwen3_model_top2(m: &Qwen3Model) -> Qwen3Top2 with Mut {
    if !m.ok {
        return Qwen3Top2 { top1_id: 0, runner_up_id: 0, top1_val: 0.0, second_val: 0.0 }
    }
    let out = page_arena_ptr(&m.arena) + m.buf_top2_off
    let t1 = ptr_read_i64_le(out, 0)
    let t2 = ptr_read_i64_le(out, 8)
    let b1 = ptr_read_u32_le(out, 16)
    let b2 = ptr_read_u32_le(out, 20)
    Qwen3Top2 {
        top1_id: t1,
        runner_up_id: t2,
        top1_val: f32_bits_to_f64(b1),
        second_val: f32_bits_to_f64(b2),
    }
}

// Sounio v2 Float Model: binary32, round-to-nearest-even, FTZ+DAZ, fixed op order
// Exclusion: fma(a, b, c) with |exact(a*b + c)| in (2^-126 - 2^-150, 2^-126)

pub fn f32_daz_bits(b: i64) -> i64 {
    let u = b & 4294967295
    if ((u >> 23) & 255) == 0 { return u & 2147483648 }
    u
}

pub fn f64_to_f32_bits_ftz(v: f64) -> i64 with Mut {
    let b = f64_to_f32_bits(v) & 4294967295
    if ((b >> 23) & 255) == 0 { return b & 2147483648 }
    b
}

pub fn f32_ftz_neg(a: i64) -> i64 {
    f32_daz_bits(a) ^ 2147483648
}

pub fn f32_ftz_add(a: i64, b: i64) -> i64 with Mut {
    let da = f32_bits_to_f64(f32_daz_bits(a))
    let db = f32_bits_to_f64(f32_daz_bits(b))
    f64_to_f32_bits_ftz(da + db)
}

pub fn f32_ftz_sub(a: i64, b: i64) -> i64 with Mut {
    let da = f32_bits_to_f64(f32_daz_bits(a))
    let db = f32_bits_to_f64(f32_daz_bits(b))
    f64_to_f32_bits_ftz(da - db)
}

pub fn f32_ftz_mul(a: i64, b: i64) -> i64 with Mut {
    let da = f32_bits_to_f64(f32_daz_bits(a))
    let db = f32_bits_to_f64(f32_daz_bits(b))
    f64_to_f32_bits_ftz(da * db)
}

pub fn f32_ftz_div(a: i64, b: i64) -> i64 with Mut, Div {
    let da = f32_bits_to_f64(f32_daz_bits(a))
    let db = f32_bits_to_f64(f32_daz_bits(b))
    f64_to_f32_bits_ftz(da / db)
}

pub fn f32_ftz_sqrt(a: i64) -> i64 with Mut, Div, Panic {
    let ua = f32_daz_bits(a)
    if (ua & 2147483647) == 0 { return ua }
    if ((ua >> 31) & 1) == 1 { return 2143289344 }
    let da = f32_bits_to_f64(ua)
    f64_to_f32_bits_ftz(sqrt(da))
}

pub fn f32_ftz_fma(a: i64, b: i64, c: i64) -> i64 with Mut {
    let ua = f32_daz_bits(a)
    let ub = f32_daz_bits(b)
    let uc = f32_daz_bits(c)
    let ea = (ua >> 23) & 255
    let eb = (ub >> 23) & 255
    let ec = (uc >> 23) & 255
    let da = f32_bits_to_f64(ua)
    let db = f32_bits_to_f64(ub)
    let dc = f32_bits_to_f64(uc)
    if ea == 255 || eb == 255 || ec == 255 {
        return f64_to_f32_bits_ftz(da * db + dc)
    }
    let p = da * db
    let s = p + dc
    let v = s - p
    let e = (p - (s - v)) + (dc - v)
    var su = f64_to_bits(s)
    let se = (su >> 52) & 2047
    if se != 2047 && e != 0.0 && (su & 1) == 0 {
        if (s > 0.0 && e > 0.0) || (s < 0.0 && e < 0.0) {
            su = su + 1
        } else {
            su = su - 1
        }
    }
    f64_to_f32_bits_ftz(bits_to_f64(su))
}

pub fn sounio_exp_f32_cpu(x_raw: i64) -> i64 with Mut {
    let x = f32_daz_bits(x_raw)
    if (x & 2147483647) > 2139095040 { return x }
    let dx = f32_bits_to_f64(x)
    if dx <= f32_bits_to_f64(3266227280) { return 0 }
    if dx >= f32_bits_to_f64(1118925336) { return 2139095040 }
    let t = f32_ftz_fma(x, 1069066811, 1262485504)
    let k = t - 1262485504
    let kf = f32_ftz_sub(t, 1262485504)
    var r = f32_ftz_fma(kf, 3207688704, x)
    r = f32_ftz_fma(kf, 3049242254, r)
    var p = f32_ftz_fma(985061890, r, 1007230360)
    p = f32_ftz_fma(p, r, 1026206255)
    p = f32_ftz_fma(p, r, 1042983496)
    p = f32_ftz_fma(p, r, 1056964608)
    p = f32_ftz_fma(p, r, 1065353216)
    p = f32_ftz_fma(p, r, 1065353216)
    let k1 = if k >= 0 { k >> 1 } else { 0 - (((0 - k) + 1) >> 1) }
    let k2 = k - k1
    let s1 = ((k1 + 127) & 255) << 23
    let s2 = ((k2 + 127) & 255) << 23
    f32_ftz_mul(f32_ftz_mul(p, s1), s2)
}

pub fn sounio_warp_sum_f32_cpu(v: &![i64; 32]) -> i64 with Mut {
    var next: [i64; 32] = [0; 32]
    var d: i64 = 16
    while d >= 1 {
        var i: i64 = 0
        while i < 32 {
            next[i as usize] = f32_ftz_add((*v)[i as usize], (*v)[(i ^ d) as usize])
            i = i + 1
        }
        var j: i64 = 0
        while j < 32 {
            (*v)[j as usize] = next[j as usize]
            j = j + 1
        }
        d = d / 2
    }
    (*v)[0 as usize]
}

pub fn qwen3_fill_rope_table(dst_ptr: i64, max_seq_cap: i64, head_dim: i64, rope_theta: f64) -> bool with Mut, Div, Panic {
    if dst_ptr == 0 || max_seq_cap <= 0 || head_dim < 2 { return false }
    let hdim = head_dim / 2
    var rp: i64 = 0
    while rp < max_seq_cap {
        let p_f = rp as f64
        let base_p = rp * head_dim
        var j: i64 = 0
        while j < hdim {
            let exp_v = -((2 * j) as f64) / (head_dim as f64)
            let freq = pow(rope_theta, exp_v)
            let ang = p_f * freq
            let _wc = ptr_write_u32_le(dst_ptr, (base_p + j) * 4, f64_to_f32_bits_ftz(cos(ang)))
            let _ws = ptr_write_u32_le(dst_ptr, (base_p + hdim + j) * 4, f64_to_f32_bits_ftz(sin(ang)))
            j = j + 1
        }
        rp = rp + 1
    }
    true
}

pub fn qwen3_cpu_rmsnorm(
    x_ptr: i64,
    w_ptr: i64,
    w_dtype: i32,
    out_ptr: i64,
    n_groups: i64,
    dim: i64,
    eps: f64
) with Mut, Div, Panic {
    if x_ptr <= 0 || w_ptr <= 0 || out_ptr <= 0 || n_groups <= 0 || dim <= 0 { return }
    let eps_bits = f64_to_f32_bits_ftz(eps)
    let dim_bits = f64_to_f32_bits_ftz(dim as f64)
    var sqs: [i64; 32] = [0; 32]
    var g: i64 = 0
    while g < n_groups {
        let in_head = x_ptr + g * dim * 4
        let out_head = out_ptr + g * dim * 4
        var lane: i64 = 0
        while lane < 32 {
            var sum_sq: i64 = 0
            var i = lane
            while i < dim {
                let v_bits = f32_daz_bits(ptr_read_u32_le(in_head, i * 4))
                sum_sq = f32_ftz_fma(v_bits, v_bits, sum_sq)
                i = i + 32
            }
            sqs[lane as usize] = sum_sq
            lane = lane + 1
        }
        let sum_sq_tot = sounio_warp_sum_f32_cpu(&!sqs)
        let mean_sq = f32_ftz_div(sum_sq_tot, dim_bits)
        let rms = f32_ftz_sqrt(f32_ftz_add(mean_sq, eps_bits))
        let inv_rms = f32_ftz_div(1065353216, rms)
        var i: i64 = 0
        while i < dim {
            let v_bits = f32_daz_bits(ptr_read_u32_le(in_head, i * 4))
            let w_bits = if w_dtype == 2 {
                (ptr_read_u16_le(w_ptr, i * 2) & 65535) << 16
            } else {
                f32_daz_bits(ptr_read_u32_le(w_ptr, i * 4))
            }
            let res_bits = f32_ftz_mul(f32_ftz_mul(v_bits, inv_rms), w_bits)
            let _w = ptr_write_u32_le(out_head, i * 4, res_bits)
            i = i + 1
        }
        g = g + 1
    }
}

pub fn qwen3_cpu_gemv(
    w_ptr: i64,
    w_dtype: i32,
    x_ptr: i64,
    y_ptr: i64,
    out_dim: i64,
    in_dim: i64
) with Mut, Div {
    if w_ptr <= 0 || x_ptr <= 0 || y_ptr <= 0 || out_dim <= 0 || in_dim <= 0 { return }
    let w_elem_bytes: i64 = if w_dtype == 2 { 2 } else { 4 }
    let aligned_dim = (in_dim >> 2) << 2
    var lanes: [i64; 32] = [0; 32]
    var r: i64 = 0
    while r < out_dim {
        let row_p = w_ptr + r * in_dim * w_elem_bytes
        var lane: i64 = 0
        while lane < 32 {
            var a0: i64 = 0
            var a1: i64 = 0
            var a2: i64 = 0
            var a3: i64 = 0
            var k = lane * 4
            while k + 3 < in_dim {
                let x0 = f32_daz_bits(ptr_read_u32_le(x_ptr, (k + 0) * 4))
                let x1 = f32_daz_bits(ptr_read_u32_le(x_ptr, (k + 1) * 4))
                let x2 = f32_daz_bits(ptr_read_u32_le(x_ptr, (k + 2) * 4))
                let x3 = f32_daz_bits(ptr_read_u32_le(x_ptr, (k + 3) * 4))
                if w_dtype == 2 {
                    let w0 = (ptr_read_u16_le(row_p, (k + 0) * 2) & 65535) << 16
                    let w1 = (ptr_read_u16_le(row_p, (k + 1) * 2) & 65535) << 16
                    let w2 = (ptr_read_u16_le(row_p, (k + 2) * 2) & 65535) << 16
                    let w3 = (ptr_read_u16_le(row_p, (k + 3) * 2) & 65535) << 16
                    a0 = f32_ftz_fma(w0, x0, a0)
                    a1 = f32_ftz_fma(w1, x1, a1)
                    a2 = f32_ftz_fma(w2, x2, a2)
                    a3 = f32_ftz_fma(w3, x3, a3)
                } else {
                    let w0 = f32_daz_bits(ptr_read_u32_le(row_p, (k + 0) * 4))
                    let w1 = f32_daz_bits(ptr_read_u32_le(row_p, (k + 1) * 4))
                    let w2 = f32_daz_bits(ptr_read_u32_le(row_p, (k + 2) * 4))
                    let w3 = f32_daz_bits(ptr_read_u32_le(row_p, (k + 3) * 4))
                    a0 = f32_ftz_fma(w0, x0, a0)
                    a1 = f32_ftz_fma(w1, x1, a1)
                    a2 = f32_ftz_fma(w2, x2, a2)
                    a3 = f32_ftz_fma(w3, x3, a3)
                }
                k = k + 128
            }
            var kt = aligned_dim + lane
            while kt < in_dim {
                let xt = f32_daz_bits(ptr_read_u32_le(x_ptr, kt * 4))
                let wt = if w_dtype == 2 {
                    (ptr_read_u16_le(row_p, kt * 2) & 65535) << 16
                } else {
                    f32_daz_bits(ptr_read_u32_le(row_p, kt * 4))
                }
                a0 = f32_ftz_fma(wt, xt, a0)
                kt = kt + 32
            }
            lanes[lane as usize] = f32_ftz_add(f32_ftz_add(a0, a1), f32_ftz_add(a2, a3))
            lane = lane + 1
        }
        let sum_bits = sounio_warp_sum_f32_cpu(&!lanes)
        let _w = ptr_write_u32_le(y_ptr, r * 4, sum_bits)
        r = r + 1
    }
}

pub fn qwen3_cpu_rope(
    v_ptr: i64,
    n_heads: i64,
    head_dim: i64,
    pos: i64,
    theta: f64
) with Mut, Div, Panic {
    if v_ptr <= 0 || n_heads <= 0 || head_dim <= 0 { return }
    let half = head_dim / 2
    if half <= 0 { return }
    var h: i64 = 0
    while h < n_heads {
        let h_base = v_ptr + h * head_dim * 4
        var j: i64 = 0
        while j < half {
            let exp_v = -((2 * j) as f64) / (head_dim as f64)
            let freq = pow(theta, exp_v)
            let angle = (pos as f64) * freq
            let cos_bits = f64_to_f32_bits_ftz(cos(angle))
            let sin_bits = f64_to_f32_bits_ftz(sin(angle))
            let x0_bits = f32_daz_bits(ptr_read_u32_le(h_base, j * 4))
            let x1_bits = f32_daz_bits(ptr_read_u32_le(h_base, (j + half) * 4))
            let y0_bits = f32_ftz_sub(f32_ftz_mul(x0_bits, cos_bits), f32_ftz_mul(x1_bits, sin_bits))
            let y1_bits = f32_ftz_add(f32_ftz_mul(x1_bits, cos_bits), f32_ftz_mul(x0_bits, sin_bits))
            let _w0 = ptr_write_u32_le(h_base, j * 4, y0_bits)
            let _w1 = ptr_write_u32_le(h_base, (j + half) * 4, y1_bits)
            j = j + 1
        }
        h = h + 1
    }
}

pub fn qwen3_cpu_paged_gqa(
    q_ptr: i64,
    kv: &Qwen3PagedKv,
    layer: i64,
    out_ptr: i64,
    n_q: i64,
    n_kv: i64,
    head_dim: i64,
    pos: i64
) with Mut, Div, Panic {
    if q_ptr <= 0 || out_ptr <= 0 || n_q <= 0 || n_kv <= 0 || head_dim <= 0 || pos < 0 { return }
    let eff_hdim = if head_dim > 256 { 256 } else { head_dim }
    let scale_bits = f32_ftz_div(1065353216, f32_ftz_sqrt(f64_to_f32_bits_ftz(head_dim as f64)))
    let group_size = n_q / n_kv
    let seq_len = pos + 1
    let kv_ptr = qwen3_kv_arena_ptr(kv)
    let table_off = qwen3_kv_table_off(kv)
    let k_layer_off = qwen3_kv_k_layer_off(kv, layer)
    let v_layer_off = qwen3_kv_v_layer_off(kv, layer)
    let block_size = qwen3_kv_block_size(kv)

    var q_reg: [i64; 256] = [0; 256]
    var acc_reg: [i64; 256] = [0; 256]
    var parts: [i64; 32] = [0; 32]

    var qh: i64 = 0
    while qh < n_q {
        let kvh = qh / group_size
        let q_head_ptr = q_ptr + qh * head_dim * 4
        var di: i64 = 0
        while di < 256 {
            q_reg[di as usize] = if di < eff_hdim { f32_daz_bits(ptr_read_u32_le(q_head_ptr, di * 4)) } else { 0 }
            acc_reg[di as usize] = 0
            di = di + 1
        }
        var max_s_bits: i64 = 4286578688
        var l_bits: i64 = 0
        var t: i64 = 0
        while t < seq_len {
            let logical_blk = t / block_size
            let phys_blk = ptr_read_u32_le(kv_ptr, table_off + logical_blk * 4)
            if phys_blk != 4294967295 {
                let slot = t % block_size
                let kv_elem_idx = ((phys_blk * block_size + slot) * n_kv + kvh) * head_dim
                let k_vec_off = k_layer_off + kv_elem_idx * 4
                let v_vec_off = v_layer_off + kv_elem_idx * 4
                var lane: i64 = 0
                while lane < 32 {
                    var part: i64 = 0
                    var d = lane
                    while d < eff_hdim {
                        let k_bits = f32_daz_bits(ptr_read_u32_le(kv_ptr, k_vec_off + d * 4))
                        part = f32_ftz_fma(q_reg[d as usize], k_bits, part)
                        d = d + 32
                    }
                    parts[lane as usize] = part
                    lane = lane + 1
                }
                let dot_bits = sounio_warp_sum_f32_cpu(&!parts)
                let s_bits = f32_ftz_mul(dot_bits, scale_bits)
                let l_is_zero = (l_bits & 2147483647) == 0
                if l_is_zero {
                    max_s_bits = s_bits
                    l_bits = 1065353216
                    var d: i64 = 0
                    while d < eff_hdim {
                        acc_reg[d as usize] = f32_daz_bits(ptr_read_u32_le(kv_ptr, v_vec_off + d * 4))
                        d = d + 1
                    }
                } else if f32_bits_to_f64(s_bits) > f32_bits_to_f64(max_s_bits) {
                    let alpha_bits = sounio_exp_f32_cpu(f32_ftz_sub(max_s_bits, s_bits))
                    l_bits = f32_ftz_fma(l_bits, alpha_bits, 1065353216)
                    var d: i64 = 0
                    while d < eff_hdim {
                        let vv_bits = f32_daz_bits(ptr_read_u32_le(kv_ptr, v_vec_off + d * 4))
                        acc_reg[d as usize] = f32_ftz_fma(acc_reg[d as usize], alpha_bits, vv_bits)
                        d = d + 1
                    }
                    max_s_bits = s_bits
                } else {
                    let beta_bits = sounio_exp_f32_cpu(f32_ftz_sub(s_bits, max_s_bits))
                    l_bits = f32_ftz_add(l_bits, beta_bits)
                    var d: i64 = 0
                    while d < eff_hdim {
                        let vv_bits = f32_daz_bits(ptr_read_u32_le(kv_ptr, v_vec_off + d * 4))
                        acc_reg[d as usize] = f32_ftz_fma(beta_bits, vv_bits, acc_reg[d as usize])
                        d = d + 1
                    }
                }
            }
            t = t + 1
        }
        if f32_bits_to_f64(l_bits) > 0.0 {
            let inv_l_bits = f32_ftz_div(1065353216, l_bits)
            var d: i64 = 0
            while d < eff_hdim {
                let _w = ptr_write_u32_le(out_ptr, (qh * head_dim + d) * 4, f32_ftz_mul(acc_reg[d as usize], inv_l_bits))
                d = d + 1
            }
        } else {
            var d: i64 = 0
            while d < eff_hdim {
                let _w = ptr_write_u32_le(out_ptr, (qh * head_dim + d) * 4, 0)
                d = d + 1
            }
        }
        qh = qh + 1
    }
}

pub fn qwen3_cpu_swiglu(gate_ptr: i64, up_ptr: i64, out_ptr: i64, inter_dim: i64) with Mut, Div {
    if gate_ptr <= 0 || up_ptr <= 0 || out_ptr <= 0 || inter_dim <= 0 { return }
    var j: i64 = 0
    while j < inter_dim {
        let g_bits = f32_daz_bits(ptr_read_u32_le(gate_ptr, j * 4))
        let u_bits = f32_daz_bits(ptr_read_u32_le(up_ptr, j * 4))
        let denom_bits = f32_ftz_add(1065353216, sounio_exp_f32_cpu(f32_ftz_neg(g_bits)))
        let silu_bits = f32_ftz_div(g_bits, denom_bits)
        let out_bits = f32_ftz_mul(silu_bits, u_bits)
        let _w = ptr_write_u32_le(out_ptr, j * 4, out_bits)
        j = j + 1
    }
}

pub fn qwen3_cpu_vec_add(a_ptr: i64, b_ptr: i64, len: i64) with Mut, Div {
    if a_ptr <= 0 || b_ptr <= 0 || len <= 0 { return }
    var i: i64 = 0
    while i < len {
        let va_bits = f32_daz_bits(ptr_read_u32_le(a_ptr, i * 4))
        let vb_bits = f32_daz_bits(ptr_read_u32_le(b_ptr, i * 4))
        let _w = ptr_write_u32_le(a_ptr, i * 4, f32_ftz_add(va_bits, vb_bits))
        i = i + 1
    }
}

pub fn qwen3_forward_token_cpu(
    m: &Qwen3Model,
    kv: &!Qwen3PagedKv,
    token_id: i64,
    pos: i64
) -> bool with Alloc, Mut, Div, Panic {
    if !m.ok || !qwen3_kv_is_ok(kv) || token_id < 0 || token_id >= m.cfg.vocab || pos < 0 {
        return false
    }
    let _ftz = hal_cpu_set_ftz_daz(true)

    let a_base = page_arena_ptr(&m.arena)
    let buf_x = a_base + m.buf_x_off
    let buf_h = a_base + m.buf_h_off
    let buf_q = a_base + m.buf_q_off
    let buf_k = a_base + m.buf_k_off
    let buf_v = a_base + m.buf_v_off
    let buf_attn_out = a_base + m.buf_attn_out_off
    let buf_gate = a_base + m.buf_gate_off
    let buf_up = a_base + m.buf_up_off
    let buf_logits = a_base + m.buf_logits_off

    let emb_ptr = qwen3_model_tensor_host_ptr(m, 0)
    let emb_dt = qwen3_model_tensor_dtype(m, 0)
    let emb_elem_b = if emb_dt == 2 { 2 } else { 4 }
    let row_p = emb_ptr + token_id * m.cfg.hidden * emb_elem_b

    var i: i64 = 0
    while i < m.cfg.hidden {
        let v_bits = if emb_dt == 2 {
            (ptr_read_u16_le(row_p, i * 2) & 65535) << 16
        } else {
            f32_daz_bits(ptr_read_u32_le(row_p, i * 4))
        }
        let _w = ptr_write_u32_le(buf_x, i * 4, v_bits)
        i = i + 1
    }

    var l: i64 = 0
    while l < m.cfg.layers {
        let slot_base = 3 + l * 11

        let in_norm_p = qwen3_model_tensor_host_ptr(m, slot_base + 0)
        let in_norm_dt = qwen3_model_tensor_dtype(m, slot_base + 0)
        qwen3_cpu_rmsnorm(buf_x, in_norm_p, in_norm_dt, buf_h, 1, m.cfg.hidden, m.cfg.eps)

        let q_p = qwen3_model_tensor_host_ptr(m, slot_base + 1)
        let q_dt = qwen3_model_tensor_dtype(m, slot_base + 1)
        qwen3_cpu_gemv(q_p, q_dt, buf_h, buf_q, m.cfg.n_q * m.cfg.head_dim, m.cfg.hidden)

        let k_p = qwen3_model_tensor_host_ptr(m, slot_base + 2)
        let k_dt = qwen3_model_tensor_dtype(m, slot_base + 2)
        qwen3_cpu_gemv(k_p, k_dt, buf_h, buf_k, m.cfg.n_kv * m.cfg.head_dim, m.cfg.hidden)

        let v_p = qwen3_model_tensor_host_ptr(m, slot_base + 3)
        let v_dt = qwen3_model_tensor_dtype(m, slot_base + 3)
        qwen3_cpu_gemv(v_p, v_dt, buf_h, buf_v, m.cfg.n_kv * m.cfg.head_dim, m.cfg.hidden)

        let q_norm_p = qwen3_model_tensor_host_ptr(m, slot_base + 5)
        let q_norm_dt = qwen3_model_tensor_dtype(m, slot_base + 5)
        qwen3_cpu_rmsnorm(buf_q, q_norm_p, q_norm_dt, buf_q, m.cfg.n_q, m.cfg.head_dim, m.cfg.eps)

        let k_norm_p = qwen3_model_tensor_host_ptr(m, slot_base + 6)
        let k_norm_dt = qwen3_model_tensor_dtype(m, slot_base + 6)
        qwen3_cpu_rmsnorm(buf_k, k_norm_p, k_norm_dt, buf_k, m.cfg.n_kv, m.cfg.head_dim, m.cfg.eps)

        qwen3_cpu_rope(buf_q, m.cfg.n_q, m.cfg.head_dim, pos, m.cfg.rope_theta)
        qwen3_cpu_rope(buf_k, m.cfg.n_kv, m.cfg.head_dim, pos, m.cfg.rope_theta)

        let wk_ok = qwen3_kv_write_kv_f32_buf(kv, l, pos, buf_k, buf_v)
        if !wk_ok { return false }

        qwen3_cpu_paged_gqa(buf_q, kv, l, buf_attn_out, m.cfg.n_q, m.cfg.n_kv, m.cfg.head_dim, pos)

        let o_p = qwen3_model_tensor_host_ptr(m, slot_base + 4)
        let o_dt = qwen3_model_tensor_dtype(m, slot_base + 4)
        qwen3_cpu_gemv(o_p, o_dt, buf_attn_out, buf_h, m.cfg.hidden, m.cfg.n_q * m.cfg.head_dim)
        qwen3_cpu_vec_add(buf_x, buf_h, m.cfg.hidden)

        let post_p = qwen3_model_tensor_host_ptr(m, slot_base + 7)
        let post_dt = qwen3_model_tensor_dtype(m, slot_base + 7)
        qwen3_cpu_rmsnorm(buf_x, post_p, post_dt, buf_h, 1, m.cfg.hidden, m.cfg.eps)

        let gate_p = qwen3_model_tensor_host_ptr(m, slot_base + 8)
        let gate_dt = qwen3_model_tensor_dtype(m, slot_base + 8)
        qwen3_cpu_gemv(gate_p, gate_dt, buf_h, buf_gate, m.cfg.inter, m.cfg.hidden)

        let up_p = qwen3_model_tensor_host_ptr(m, slot_base + 9)
        let up_dt = qwen3_model_tensor_dtype(m, slot_base + 9)
        qwen3_cpu_gemv(up_p, up_dt, buf_h, buf_up, m.cfg.inter, m.cfg.hidden)

        qwen3_cpu_swiglu(buf_gate, buf_up, buf_gate, m.cfg.inter)

        let down_p = qwen3_model_tensor_host_ptr(m, slot_base + 10)
        let down_dt = qwen3_model_tensor_dtype(m, slot_base + 10)
        qwen3_cpu_gemv(down_p, down_dt, buf_gate, buf_h, m.cfg.hidden, m.cfg.inter)
        qwen3_cpu_vec_add(buf_x, buf_h, m.cfg.hidden)

        l = l + 1
    }

    let norm_p = qwen3_model_tensor_host_ptr(m, 1)
    let norm_dt = qwen3_model_tensor_dtype(m, 1)
    qwen3_cpu_rmsnorm(buf_x, norm_p, norm_dt, buf_h, 1, m.cfg.hidden, m.cfg.eps)

    let lm_p = qwen3_model_tensor_host_ptr(m, 2)
    let lm_dt = qwen3_model_tensor_dtype(m, 2)
    qwen3_cpu_gemv(lm_p, lm_dt, buf_h, buf_logits, m.cfg.vocab, m.cfg.hidden)
    let _t2 = qwen3_model_write_top2_cpu(m)

    true
}

pub linear struct Qwen3MetalRunner {
    pub sess: MetalSession,
    pub pipes: Qwen3MetalPipelines,
    pub b_s0: i64,
    pub b_s1: i64,
    pub b_s2: i64,
    pub b_s3: i64,
    pub b_s4: i64,
    pub b_s5: i64,
    pub b_s6: i64,
    pub b_s7: i64,
    pub b_work: i64,
    pub b_kv: i64,
    pub rope_arena: PageArena,
    pub b_rope: i64,
    pub max_seq_cap: i64,
    pub ok: bool,
}

pub fn qwen3_metal_runner_is_ok(r: &Qwen3MetalRunner) -> bool {
    r.ok
}

pub fn qwen3_metal_runner_init(
    m: &Qwen3Model,
    kv: &Qwen3PagedKv,
    runtime_path: string
) -> Qwen3MetalRunner with IO, Alloc, Mut, Div, Panic {
    let sess = metal_session_open(runtime_path)
    var pipes = qwen3_metal_pipelines_empty()
    var b_s0: i64 = 0
    var b_s1: i64 = 0
    var b_s2: i64 = 0
    var b_s3: i64 = 0
    var b_s4: i64 = 0
    var b_s5: i64 = 0
    var b_s6: i64 = 0
    var b_s7: i64 = 0
    var b_work: i64 = 0
    var b_kv: i64 = 0
    let max_seq_cap = qwen3_kv_max_blocks(kv) * qwen3_kv_block_size(kv)
    let rope_bytes = if m.cfg.head_dim >= 2 && max_seq_cap > 0 {
        align_up_64(max_seq_cap * m.cfg.head_dim * 4)
    } else { 0 }
    let rope_arena = if metal_session_is_ok(&sess) && rope_bytes > 0 {
        page_arena_alloc(rope_bytes)
    } else {
        PageArena { ptr: 0, len: 0, ok: false }
    }
    var b_rope: i64 = 0
    var ok = false

    if metal_session_is_ok(&sess) {
        pipes = qwen3_metal_pipelines_compile(&sess)
        if pipes.ok {
            let s0_len = mapped_shard_len(&m.s0)
            let s1_len = mapped_shard_len(&m.s1)
            let s2_len = mapped_shard_len(&m.s2)
            let s3_len = mapped_shard_len(&m.s3)
            let s4_len = mapped_shard_len(&m.s4)
            let s5_len = mapped_shard_len(&m.s5)
            let s6_len = mapped_shard_len(&m.s6)
            let s7_len = mapped_shard_len(&m.s7)

            b_s0 = if s0_len > 0 { metal_buffer_nocopy(&sess, mapped_shard_ptr(&m.s0), s0_len) } else { 0 }
            b_s1 = if s1_len > 0 { metal_buffer_nocopy(&sess, mapped_shard_ptr(&m.s1), s1_len) } else { 0 }
            b_s2 = if s2_len > 0 { metal_buffer_nocopy(&sess, mapped_shard_ptr(&m.s2), s2_len) } else { 0 }
            b_s3 = if s3_len > 0 { metal_buffer_nocopy(&sess, mapped_shard_ptr(&m.s3), s3_len) } else { 0 }
            b_s4 = if s4_len > 0 { metal_buffer_nocopy(&sess, mapped_shard_ptr(&m.s4), s4_len) } else { 0 }
            b_s5 = if s5_len > 0 { metal_buffer_nocopy(&sess, mapped_shard_ptr(&m.s5), s5_len) } else { 0 }
            b_s6 = if s6_len > 0 { metal_buffer_nocopy(&sess, mapped_shard_ptr(&m.s6), s6_len) } else { 0 }
            b_s7 = if s7_len > 0 { metal_buffer_nocopy(&sess, mapped_shard_ptr(&m.s7), s7_len) } else { 0 }

            b_work = metal_buffer_nocopy(&sess, page_arena_ptr(&m.arena), page_arena_len(&m.arena))
            b_kv = metal_buffer_nocopy(&sess, qwen3_kv_arena_ptr(kv), qwen3_kv_arena_len(kv))

            if page_arena_is_ok(&rope_arena)
                && qwen3_fill_rope_table(page_arena_ptr(&rope_arena), max_seq_cap, m.cfg.head_dim, m.cfg.rope_theta) {
                b_rope = metal_buffer_nocopy(&sess, page_arena_ptr(&rope_arena), page_arena_len(&rope_arena))
            }

            ok = (m.n_shards <= 0 || b_s0 > 0) && (m.n_shards <= 1 || b_s1 > 0)
                && (m.n_shards <= 2 || b_s2 > 0) && (m.n_shards <= 3 || b_s3 > 0)
                && (m.n_shards <= 4 || b_s4 > 0) && (m.n_shards <= 5 || b_s5 > 0)
                && (m.n_shards <= 6 || b_s6 > 0) && (m.n_shards <= 7 || b_s7 > 0)
                && b_work > 0 && b_kv > 0 && b_rope > 0
        }
    }

    Qwen3MetalRunner {
        sess: sess,
        pipes: pipes,
        b_s0: b_s0,
        b_s1: b_s1,
        b_s2: b_s2,
        b_s3: b_s3,
        b_s4: b_s4,
        b_s5: b_s5,
        b_s6: b_s6,
        b_s7: b_s7,
        b_work: b_work,
        b_kv: b_kv,
        rope_arena: rope_arena,
        b_rope: b_rope,
        max_seq_cap: max_seq_cap,
        ok: ok,
    }
}

pub fn qwen3_metal_runner_free(r: Qwen3MetalRunner) -> i64 with IO, Mut {
    let Qwen3MetalRunner {
        sess,
        pipes: _,
        b_s0,
        b_s1,
        b_s2,
        b_s3,
        b_s4,
        b_s5,
        b_s6,
        b_s7,
        b_work,
        b_kv,
        rope_arena,
        b_rope,
        max_seq_cap: _,
        ok: _,
    } = r
    if b_s0 > 0 { let _f = metal_buffer_free(&sess, b_s0) }
    if b_s1 > 0 { let _f = metal_buffer_free(&sess, b_s1) }
    if b_s2 > 0 { let _f = metal_buffer_free(&sess, b_s2) }
    if b_s3 > 0 { let _f = metal_buffer_free(&sess, b_s3) }
    if b_s4 > 0 { let _f = metal_buffer_free(&sess, b_s4) }
    if b_s5 > 0 { let _f = metal_buffer_free(&sess, b_s5) }
    if b_s6 > 0 { let _f = metal_buffer_free(&sess, b_s6) }
    if b_s7 > 0 { let _f = metal_buffer_free(&sess, b_s7) }
    if b_work > 0 { let _f = metal_buffer_free(&sess, b_work) }
    if b_kv > 0 { let _f = metal_buffer_free(&sess, b_kv) }
    if b_rope > 0 { let _f = metal_buffer_free(&sess, b_rope) }
    let _fr = page_arena_free(rope_arena)
    metal_session_close(sess)
}

fn qwen3_metal_shard_buf(rt: &Qwen3MetalRunner, shard_idx: i64) -> i64 {
    if shard_idx == 0 { return rt.b_s0 }
    if shard_idx == 1 { return rt.b_s1 }
    if shard_idx == 2 { return rt.b_s2 }
    if shard_idx == 3 { return rt.b_s3 }
    if shard_idx == 4 { return rt.b_s4 }
    if shard_idx == 5 { return rt.b_s5 }
    if shard_idx == 6 { return rt.b_s6 }
    if shard_idx == 7 { return rt.b_s7 }
    0
}

pub fn qwen3_forward_token_metal_opt(
    m: &Qwen3Model,
    kv: &!Qwen3PagedKv,
    rt: &Qwen3MetalRunner,
    token_id: i64,
    pos: i64,
    compute_logits: bool
) -> bool with Mut, Div, Panic {
    if !m.ok || !rt.ok || !qwen3_kv_is_ok(kv) || token_id < 0 || token_id >= m.cfg.vocab || pos < 0 {
        return false
    }
    if !qwen3_kv_ensure_pos(kv, pos) {
        return false
    }

    let a_base = page_arena_ptr(&m.arena)
    let buf_x = a_base + m.buf_x_off

    let emb_ptr = qwen3_model_tensor_host_ptr(m, 0)
    let emb_dt = qwen3_model_tensor_dtype(m, 0)
    let emb_elem_b = if emb_dt == 2 { 2 } else { 4 }
    let row_p = emb_ptr + token_id * m.cfg.hidden * emb_elem_b

    var i: i64 = 0
    while i < m.cfg.hidden {
        let v = if emb_dt == 2 {
            bf16_bits_to_f64_exact(ptr_read_u16_le(row_p, i * 2))
        } else {
            f32_bits_to_f64(ptr_read_u32_le(row_p, i * 4))
        }
        let _w = ptr_write_u32_le(buf_x, i * 4, f64_to_f32_bits(v))
        i = i + 1
    }

    let eps_bits = f64_to_f32_bits(m.cfg.eps)
    let theta_bits = f64_to_f32_bits(m.cfg.rope_theta)

    let cid = metal_cmd_begin(&rt.sess)
    if cid <= 0 { return false }

    if m.cfg.layers > 0 {
        let in_norm_s0 = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, 3))
        let in_norm_off0 = qwen3_model_tensor_data_off(m, 3)
        let in_norm_dt0 = qwen3_model_tensor_dtype(m, 3)
        let in_norm_pipe0 = if in_norm_dt0 == 2 { rt.pipes.rmsnorm_bf16 } else { rt.pipes.rmsnorm_f32 }
        if qwen3_metal_encode_rmsnorm(
            &rt.sess, cid, in_norm_pipe0,
            rt.b_work, m.buf_x_off,
            in_norm_s0, in_norm_off0,
            rt.b_work, m.buf_h_off,
            1, m.cfg.hidden, eps_bits
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return false
        }
    }

    var l: i64 = 0
    while l < m.cfg.layers {
        let slot_base = 3 + l * 11

        let q_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, slot_base + 1))
        let q_off = qwen3_model_tensor_data_off(m, slot_base + 1)
        let q_dt = qwen3_model_tensor_dtype(m, slot_base + 1)
        let k_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, slot_base + 2))
        let k_off = qwen3_model_tensor_data_off(m, slot_base + 2)
        let k_dt = qwen3_model_tensor_dtype(m, slot_base + 2)
        let v_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, slot_base + 3))
        let v_off = qwen3_model_tensor_data_off(m, slot_base + 3)
        let v_dt = qwen3_model_tensor_dtype(m, slot_base + 3)

        if q_dt == 2 && k_dt == 2 && v_dt == 2 {
            if qwen3_metal_encode_gemv_bf16_qkv(
                &rt.sess, cid, rt.pipes.gemv_bf16_qkv,
                q_s, k_s, v_s,
                rt.b_work, rt.b_work,
                q_off, k_off, v_off,
                m.buf_h_off, m.buf_q_off, m.buf_k_off, m.buf_v_off,
                m.cfg.n_q * m.cfg.head_dim, m.cfg.n_kv * m.cfg.head_dim, m.cfg.hidden
            ) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return false
            }
        } else {
            let q_pipe = if q_dt == 2 { rt.pipes.gemv_bf16 } else { rt.pipes.gemv_f32 }
            if qwen3_metal_encode_gemv(
                &rt.sess, cid, q_pipe,
                q_s, q_off,
                rt.b_work, m.buf_h_off,
                rt.b_work, m.buf_q_off,
                m.cfg.n_q * m.cfg.head_dim, m.cfg.hidden
            ) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return false
            }
            let k_pipe = if k_dt == 2 { rt.pipes.gemv_bf16 } else { rt.pipes.gemv_f32 }
            if qwen3_metal_encode_gemv(
                &rt.sess, cid, k_pipe,
                k_s, k_off,
                rt.b_work, m.buf_h_off,
                rt.b_work, m.buf_k_off,
                m.cfg.n_kv * m.cfg.head_dim, m.cfg.hidden
            ) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return false
            }
            let v_pipe = if v_dt == 2 { rt.pipes.gemv_bf16 } else { rt.pipes.gemv_f32 }
            if qwen3_metal_encode_gemv(
                &rt.sess, cid, v_pipe,
                v_s, v_off,
                rt.b_work, m.buf_h_off,
                rt.b_work, m.buf_v_off,
                m.cfg.n_kv * m.cfg.head_dim, m.cfg.hidden
            ) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return false
            }
        }

        let q_norm_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, slot_base + 5))
        let q_norm_off = qwen3_model_tensor_data_off(m, slot_base + 5)
        let q_norm_dt = qwen3_model_tensor_dtype(m, slot_base + 5)
        let k_norm_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, slot_base + 6))
        let k_norm_off = qwen3_model_tensor_data_off(m, slot_base + 6)
        let k_norm_dt = qwen3_model_tensor_dtype(m, slot_base + 6)

        if (m.cfg.head_dim & 1) == 0 && q_norm_dt == k_norm_dt {
            let qkn_pipe = if q_norm_dt == 2 { rt.pipes.qk_norm_rope_kv_bf16 } else { rt.pipes.qk_norm_rope_kv_f32 }
            if qwen3_metal_encode_qk_norm_rope_kv_scatter(
                &rt.sess, cid, qkn_pipe,
                rt.b_work, rt.b_work, rt.b_work,
                q_norm_s, k_norm_s, rt.b_kv,
                m.buf_q_off, m.buf_k_off, m.buf_v_off,
                q_norm_off, k_norm_off,
                qwen3_kv_table_off(kv),
                qwen3_kv_k_layer_off(kv, l),
                qwen3_kv_v_layer_off(kv, l),
                m.cfg.n_q, m.cfg.n_kv, m.cfg.head_dim,
                pos, qwen3_kv_block_size(kv),
                eps_bits, rt.b_rope, pos * m.cfg.head_dim * 4
            ) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return false
            }
        } else {
            let q_norm_pipe = if q_norm_dt == 2 { rt.pipes.rmsnorm_bf16 } else { rt.pipes.rmsnorm_f32 }
            if qwen3_metal_encode_rmsnorm(
                &rt.sess, cid, q_norm_pipe,
                rt.b_work, m.buf_q_off,
                q_norm_s, q_norm_off,
                rt.b_work, m.buf_q_off,
                m.cfg.n_q, m.cfg.head_dim, eps_bits
            ) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return false
            }

            let k_norm_pipe = if k_norm_dt == 2 { rt.pipes.rmsnorm_bf16 } else { rt.pipes.rmsnorm_f32 }
            if qwen3_metal_encode_rmsnorm(
                &rt.sess, cid, k_norm_pipe,
                rt.b_work, m.buf_k_off,
                k_norm_s, k_norm_off,
                rt.b_work, m.buf_k_off,
                m.cfg.n_kv, m.cfg.head_dim, eps_bits
            ) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return false
            }

            if qwen3_metal_encode_rope_table(
                &rt.sess, cid, rt.pipes.rope_table,
                rt.b_work, m.buf_q_off,
                rt.b_rope, pos * m.cfg.head_dim * 4,
                m.cfg.n_q, m.cfg.head_dim
            ) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return false
            }

            if qwen3_metal_encode_rope_table(
                &rt.sess, cid, rt.pipes.rope_table,
                rt.b_work, m.buf_k_off,
                rt.b_rope, pos * m.cfg.head_dim * 4,
                m.cfg.n_kv, m.cfg.head_dim
            ) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return false
            }

            if qwen3_metal_encode_kv_scatter(
                &rt.sess, cid, rt.pipes.kv_scatter,
                rt.b_work, m.buf_k_off,
                rt.b_work, m.buf_v_off,
                rt.b_kv,
                qwen3_kv_table_off(kv),
                qwen3_kv_k_layer_off(kv, l),
                qwen3_kv_v_layer_off(kv, l),
                m.cfg.n_kv * m.cfg.head_dim,
                pos,
                qwen3_kv_block_size(kv)
            ) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return false
            }
        }

        if qwen3_metal_encode_paged_gqa(
            &rt.sess, cid, rt.pipes.paged_gqa,
            rt.b_work, m.buf_q_off,
            rt.b_kv,
            qwen3_kv_table_off(kv),
            qwen3_kv_k_layer_off(kv, l),
            qwen3_kv_v_layer_off(kv, l),
            rt.b_work, m.buf_attn_out_off,
            m.cfg.n_q, m.cfg.n_kv, m.cfg.head_dim,
            pos + 1,
            qwen3_kv_block_size(kv)
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return false
        }

        let o_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, slot_base + 4))
        let o_off = qwen3_model_tensor_data_off(m, slot_base + 4)
        let o_dt = qwen3_model_tensor_dtype(m, slot_base + 4)
        let o_pipe = if o_dt == 2 { rt.pipes.gemv_bf16 } else { rt.pipes.gemv_f32 }
        if qwen3_metal_encode_gemv(
            &rt.sess, cid, o_pipe,
            o_s, o_off,
            rt.b_work, m.buf_attn_out_off,
            rt.b_work, m.buf_h_off,
            m.cfg.hidden, m.cfg.n_q * m.cfg.head_dim
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return false
        }

        let post_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, slot_base + 7))
        let post_off = qwen3_model_tensor_data_off(m, slot_base + 7)
        let post_dt = qwen3_model_tensor_dtype(m, slot_base + 7)
        let post_pipe = if post_dt == 2 { rt.pipes.add_rmsnorm_bf16 } else { rt.pipes.add_rmsnorm_f32 }
        if qwen3_metal_encode_add_rmsnorm(
            &rt.sess, cid, post_pipe,
            rt.b_work, rt.b_work, post_s, rt.b_work,
            m.buf_x_off, m.buf_h_off, post_off, m.buf_h_off,
            m.cfg.hidden, eps_bits
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return false
        }

        let gate_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, slot_base + 8))
        let gate_off = qwen3_model_tensor_data_off(m, slot_base + 8)
        let gate_dt = qwen3_model_tensor_dtype(m, slot_base + 8)
        let up_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, slot_base + 9))
        let up_off = qwen3_model_tensor_data_off(m, slot_base + 9)
        let up_dt = qwen3_model_tensor_dtype(m, slot_base + 9)

        if gate_dt == 2 && up_dt == 2 {
            if qwen3_metal_encode_gemv_bf16_gate_up_swiglu(
                &rt.sess, cid, rt.pipes.gemv_bf16_gate_up_swiglu,
                gate_s, up_s,
                rt.b_work, rt.b_work,
                gate_off, up_off,
                m.buf_h_off, m.buf_gate_off,
                m.cfg.inter, m.cfg.hidden
            ) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return false
            }
        } else {
            let gate_pipe = if gate_dt == 2 { rt.pipes.gemv_bf16 } else { rt.pipes.gemv_f32 }
            if qwen3_metal_encode_gemv(
                &rt.sess, cid, gate_pipe,
                gate_s, gate_off,
                rt.b_work, m.buf_h_off,
                rt.b_work, m.buf_gate_off,
                m.cfg.inter, m.cfg.hidden
            ) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return false
            }

            let up_pipe = if up_dt == 2 { rt.pipes.gemv_bf16 } else { rt.pipes.gemv_f32 }
            if qwen3_metal_encode_gemv(
                &rt.sess, cid, up_pipe,
                up_s, up_off,
                rt.b_work, m.buf_h_off,
                rt.b_work, m.buf_up_off,
                m.cfg.inter, m.cfg.hidden
            ) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return false
            }

            if qwen3_metal_encode_swiglu(
                &rt.sess, cid, rt.pipes.swiglu,
                rt.b_work, m.buf_gate_off,
                rt.b_work, m.buf_up_off,
                rt.b_work, m.buf_gate_off,
                m.cfg.inter
            ) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return false
            }
        }

        let down_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, slot_base + 10))
        let down_off = qwen3_model_tensor_data_off(m, slot_base + 10)
        let down_dt = qwen3_model_tensor_dtype(m, slot_base + 10)
        let down_pipe = if down_dt == 2 { rt.pipes.gemv_bf16 } else { rt.pipes.gemv_f32 }
        if qwen3_metal_encode_gemv(
            &rt.sess, cid, down_pipe,
            down_s, down_off,
            rt.b_work, m.buf_gate_off,
            rt.b_work, m.buf_h_off,
            m.cfg.hidden, m.cfg.inter
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return false
        }

        if l + 1 < m.cfg.layers {
            let next_base = 3 + (l + 1) * 11
            let nx_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, next_base))
            let nx_off = qwen3_model_tensor_data_off(m, next_base)
            let nx_dt = qwen3_model_tensor_dtype(m, next_base)
            let nx_pipe = if nx_dt == 2 { rt.pipes.add_rmsnorm_bf16 } else { rt.pipes.add_rmsnorm_f32 }
            if qwen3_metal_encode_add_rmsnorm(
                &rt.sess, cid, nx_pipe,
                rt.b_work, rt.b_work, nx_s, rt.b_work,
                m.buf_x_off, m.buf_h_off, nx_off, m.buf_h_off,
                m.cfg.hidden, eps_bits
            ) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return false
            }
        } else if compute_logits {
            let norm_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, 1))
            let norm_off = qwen3_model_tensor_data_off(m, 1)
            let norm_dt = qwen3_model_tensor_dtype(m, 1)
            let norm_pipe = if norm_dt == 2 { rt.pipes.add_rmsnorm_bf16 } else { rt.pipes.add_rmsnorm_f32 }
            if qwen3_metal_encode_add_rmsnorm(
                &rt.sess, cid, norm_pipe,
                rt.b_work, rt.b_work, norm_s, rt.b_work,
                m.buf_x_off, m.buf_h_off, norm_off, m.buf_h_off,
                m.cfg.hidden, eps_bits
            ) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return false
            }
        } else {
            if qwen3_metal_encode_vec_add(
                &rt.sess, cid, rt.pipes.vec_add,
                rt.b_work, m.buf_x_off,
                rt.b_work, m.buf_h_off,
                m.cfg.hidden
            ) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return false
            }
        }

        l = l + 1
    }

    if compute_logits {
        if m.cfg.layers <= 0 {
            let norm_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, 1))
            let norm_off = qwen3_model_tensor_data_off(m, 1)
            let norm_dt = qwen3_model_tensor_dtype(m, 1)
            let norm_pipe = if norm_dt == 2 { rt.pipes.rmsnorm_bf16 } else { rt.pipes.rmsnorm_f32 }
            if qwen3_metal_encode_rmsnorm(
                &rt.sess, cid, norm_pipe,
                rt.b_work, m.buf_x_off,
                norm_s, norm_off,
                rt.b_work, m.buf_h_off,
                1, m.cfg.hidden, eps_bits
            ) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return false
            }
        }

        let lm_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, 2))
        let lm_off = qwen3_model_tensor_data_off(m, 2)
        let lm_dt = qwen3_model_tensor_dtype(m, 2)
        let lm_pipe = if lm_dt == 2 { rt.pipes.gemv_bf16 } else { rt.pipes.gemv_f32 }
        if qwen3_metal_encode_gemv(
            &rt.sess, cid, lm_pipe,
            lm_s, lm_off,
            rt.b_work, m.buf_h_off,
            rt.b_work, m.buf_logits_off,
            m.cfg.vocab, m.cfg.hidden
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return false
        }
        if qwen3_metal_encode_argmax_top2(
            &rt.sess, cid, rt.pipes.argmax_top2,
            rt.b_work, m.buf_logits_off,
            rt.b_work, m.buf_top2_off,
            m.cfg.vocab
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return false
        }
    }

    if metal_cmd_commit_sync(&rt.sess, cid) != 0 {
        return false
    }

    true
}

pub fn qwen3_forward_token_metal(
    m: &Qwen3Model,
    kv: &!Qwen3PagedKv,
    rt: &Qwen3MetalRunner,
    token_id: i64,
    pos: i64
) -> bool with Mut, Div, Panic {
    qwen3_forward_token_metal_opt(m, kv, rt, token_id, pos, true)
}

pub fn qwen3_forward_batch_bf16_metal_mode(
    m: &Qwen3Model,
    kv: &!Qwen3PagedKv,
    rt: &Qwen3MetalRunner,
    tok_ids_ptr: i64,
    pos_start: i64,
    n_toks: i64,
    compute_all_top1: bool,
    compute_last_logits: bool,
    top1_out_ptr: i64,
    use_tc: bool
) -> bool with Mut, Div, Panic {
    if !m.ok || !rt.ok || !qwen3_kv_is_ok(kv) || tok_ids_ptr == 0 || pos_start < 0 || n_toks <= 0 {
        return false
    }
    if pos_start + n_toks > rt.max_seq_cap {
        return false
    }
    var pi: i64 = 0
    while pi < n_toks {
        let tid = ptr_read_i64_le(tok_ids_ptr, pi * 8)
        if tid < 0 || tid >= m.cfg.vocab { return false }
        if !qwen3_kv_ensure_pos(kv, pos_start + pi) { return false }
        pi = pi + 1
    }

    let a_base = page_arena_ptr(&m.arena)
    let bx8_off = align_up_64(m.buf_top2_off + 64)
    let bh8_off = bx8_off + align_up_64(8 * m.cfg.hidden * 4)
    let bq8_off = bh8_off + align_up_64(8 * m.cfg.hidden * 4)
    let bk8_off = bq8_off + align_up_64(8 * m.cfg.n_q * m.cfg.head_dim * 4)
    let bv8_off = bk8_off + align_up_64(8 * m.cfg.n_kv * m.cfg.head_dim * 4)
    let battn8_off = bv8_off + align_up_64(8 * m.cfg.n_kv * m.cfg.head_dim * 4)
    let bgate8_off = battn8_off + align_up_64(8 * m.cfg.n_q * m.cfg.head_dim * 4)
    let bup8_off = bgate8_off + align_up_64(8 * m.cfg.inter * 4)
    let blogits8_off = bup8_off + align_up_64(8 * m.cfg.inter * 4)
    let btop2_8_off = blogits8_off + align_up_64(8 * m.cfg.vocab * 4)

    let emb_ptr = qwen3_model_tensor_host_ptr(m, 0)
    let emb_dt = qwen3_model_tensor_dtype(m, 0)
    let emb_elem_b = if emb_dt == 2 { 2 } else { 4 }
    let eps_bits = f64_to_f32_bits_ftz(m.cfg.eps)

    var done: i64 = 0
    while done < n_toks {
        let rem = n_toks - done
        let w: i64 = if rem > 8 { 8 } else { rem }
        let chunk_pos = pos_start + done
        let is_last_chunk = (done + w) >= n_toks

        if w == 1 {
            let tid0 = ptr_read_i64_le(tok_ids_ptr, done * 8)
            let want_lg = compute_all_top1 || (compute_last_logits && is_last_chunk)
            if !qwen3_forward_token_metal_opt(m, kv, rt, tid0, chunk_pos, want_lg) {
                return false
            }
            if want_lg && top1_out_ptr != 0 {
                let t = qwen3_model_top2(m)
                let _wt = ptr_write_i64_le(top1_out_ptr, done * 8, t.top1_id)
            }
            done = done + 1
        } else {

        var b: i64 = 0
        while b < w {
            let tid = ptr_read_i64_le(tok_ids_ptr, (done + b) * 8)
            let row_p = emb_ptr + tid * m.cfg.hidden * emb_elem_b
            let dst_p = a_base + bx8_off + b * m.cfg.hidden * 4
            var i: i64 = 0
            while i < m.cfg.hidden {
                let v = if emb_dt == 2 {
                    bf16_bits_to_f64_exact(ptr_read_u16_le(row_p, i * 2))
                } else {
                    f32_bits_to_f64(ptr_read_u32_le(row_p, i * 4))
                }
                let _ww = ptr_write_u32_le(dst_p, i * 4, f64_to_f32_bits(v))
                i = i + 1
            }
            b = b + 1
        }

        let cid = metal_cmd_begin(&rt.sess)
        if cid <= 0 { return false }

        var l: i64 = 0
        while l < m.cfg.layers {
            let slot_base = 3 + l * 11

            let in_norm_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, slot_base + 0))
            let in_norm_off = qwen3_model_tensor_data_off(m, slot_base + 0)
            let in_norm_dt = qwen3_model_tensor_dtype(m, slot_base + 0)
            let in_norm_pipe = if in_norm_dt == 2 { rt.pipes.rmsnorm_bf16 } else { rt.pipes.rmsnorm_f32 }
            if qwen3_metal_encode_rmsnorm(
                &rt.sess, cid, in_norm_pipe,
                rt.b_work, bx8_off,
                in_norm_s, in_norm_off,
                rt.b_work, bh8_off,
                w, m.cfg.hidden, eps_bits
            ) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return false
            }

            let q_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, slot_base + 1))
            let q_off = qwen3_model_tensor_data_off(m, slot_base + 1)
            let q_dt = qwen3_model_tensor_dtype(m, slot_base + 1)
            let q_rc = if use_tc && q_dt == 2 {
                qwen3_metal_encode_gemm_tc(&rt.sess, cid, rt.pipes.gemm_bf16_tc, q_s, q_off, rt.b_work, bh8_off, rt.b_work, bq8_off, m.cfg.n_q * m.cfg.head_dim, m.cfg.hidden, w)
            } else {
                let q_pipe = if q_dt == 2 { rt.pipes.gemm_bf16 } else { rt.pipes.gemm_f32 }
                qwen3_metal_encode_gemm(&rt.sess, cid, q_pipe, q_s, q_off, rt.b_work, bh8_off, rt.b_work, bq8_off, m.cfg.n_q * m.cfg.head_dim, m.cfg.hidden, w)
            }
            if q_rc != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return false
            }

            let k_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, slot_base + 2))
            let k_off = qwen3_model_tensor_data_off(m, slot_base + 2)
            let k_dt = qwen3_model_tensor_dtype(m, slot_base + 2)
            let k_rc = if use_tc && k_dt == 2 {
                qwen3_metal_encode_gemm_tc(&rt.sess, cid, rt.pipes.gemm_bf16_tc, k_s, k_off, rt.b_work, bh8_off, rt.b_work, bk8_off, m.cfg.n_kv * m.cfg.head_dim, m.cfg.hidden, w)
            } else {
                let k_pipe = if k_dt == 2 { rt.pipes.gemm_bf16 } else { rt.pipes.gemm_f32 }
                qwen3_metal_encode_gemm(&rt.sess, cid, k_pipe, k_s, k_off, rt.b_work, bh8_off, rt.b_work, bk8_off, m.cfg.n_kv * m.cfg.head_dim, m.cfg.hidden, w)
            }
            if k_rc != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return false
            }

            let v_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, slot_base + 3))
            let v_off = qwen3_model_tensor_data_off(m, slot_base + 3)
            let v_dt = qwen3_model_tensor_dtype(m, slot_base + 3)
            let v_rc = if use_tc && v_dt == 2 {
                qwen3_metal_encode_gemm_tc(&rt.sess, cid, rt.pipes.gemm_bf16_tc, v_s, v_off, rt.b_work, bh8_off, rt.b_work, bv8_off, m.cfg.n_kv * m.cfg.head_dim, m.cfg.hidden, w)
            } else {
                let v_pipe = if v_dt == 2 { rt.pipes.gemm_bf16 } else { rt.pipes.gemm_f32 }
                qwen3_metal_encode_gemm(&rt.sess, cid, v_pipe, v_s, v_off, rt.b_work, bh8_off, rt.b_work, bv8_off, m.cfg.n_kv * m.cfg.head_dim, m.cfg.hidden, w)
            }
            if v_rc != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return false
            }

            let q_norm_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, slot_base + 5))
            let q_norm_off = qwen3_model_tensor_data_off(m, slot_base + 5)
            let q_norm_dt = qwen3_model_tensor_dtype(m, slot_base + 5)
            let q_norm_pipe = if q_norm_dt == 2 { rt.pipes.rmsnorm_bf16 } else { rt.pipes.rmsnorm_f32 }
            if qwen3_metal_encode_rmsnorm(
                &rt.sess, cid, q_norm_pipe,
                rt.b_work, bq8_off,
                q_norm_s, q_norm_off,
                rt.b_work, bq8_off,
                w * m.cfg.n_q, m.cfg.head_dim, eps_bits
            ) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return false
            }

            let k_norm_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, slot_base + 6))
            let k_norm_off = qwen3_model_tensor_data_off(m, slot_base + 6)
            let k_norm_dt = qwen3_model_tensor_dtype(m, slot_base + 6)
            let k_norm_pipe = if k_norm_dt == 2 { rt.pipes.rmsnorm_bf16 } else { rt.pipes.rmsnorm_f32 }
            if qwen3_metal_encode_rmsnorm(
                &rt.sess, cid, k_norm_pipe,
                rt.b_work, bk8_off,
                k_norm_s, k_norm_off,
                rt.b_work, bk8_off,
                w * m.cfg.n_kv, m.cfg.head_dim, eps_bits
            ) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return false
            }

            if qwen3_metal_encode_rope_batch_table(
                &rt.sess, cid, rt.pipes.rope_batch_table,
                rt.b_work, bq8_off,
                rt.b_rope, 0,
                m.cfg.n_q, m.cfg.head_dim, chunk_pos, w
            ) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return false
            }

            if qwen3_metal_encode_rope_batch_table(
                &rt.sess, cid, rt.pipes.rope_batch_table,
                rt.b_work, bk8_off,
                rt.b_rope, 0,
                m.cfg.n_kv, m.cfg.head_dim, chunk_pos, w
            ) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return false
            }

            if qwen3_metal_encode_kv_scatter_batch(
                &rt.sess, cid, rt.pipes.kv_scatter_batch,
                rt.b_work, bk8_off,
                rt.b_work, bv8_off,
                rt.b_kv,
                qwen3_kv_table_off(kv),
                qwen3_kv_k_layer_off(kv, l),
                qwen3_kv_v_layer_off(kv, l),
                m.cfg.n_kv * m.cfg.head_dim,
                chunk_pos,
                w,
                qwen3_kv_block_size(kv)
            ) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return false
            }

            if qwen3_metal_encode_paged_gqa_batch(
                &rt.sess, cid, rt.pipes.paged_gqa_batch,
                rt.b_work, bq8_off,
                rt.b_kv,
                qwen3_kv_table_off(kv),
                qwen3_kv_k_layer_off(kv, l),
                qwen3_kv_v_layer_off(kv, l),
                rt.b_work, battn8_off,
                m.cfg.n_q, m.cfg.n_kv, m.cfg.head_dim,
                chunk_pos,
                w,
                qwen3_kv_block_size(kv)
            ) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return false
            }

            let o_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, slot_base + 4))
            let o_off = qwen3_model_tensor_data_off(m, slot_base + 4)
            let o_dt = qwen3_model_tensor_dtype(m, slot_base + 4)
            let o_rc = if use_tc && o_dt == 2 {
                qwen3_metal_encode_gemm_tc(&rt.sess, cid, rt.pipes.gemm_bf16_tc, o_s, o_off, rt.b_work, battn8_off, rt.b_work, bh8_off, m.cfg.hidden, m.cfg.n_q * m.cfg.head_dim, w)
            } else {
                let o_pipe = if o_dt == 2 { rt.pipes.gemm_bf16 } else { rt.pipes.gemm_f32 }
                qwen3_metal_encode_gemm(&rt.sess, cid, o_pipe, o_s, o_off, rt.b_work, battn8_off, rt.b_work, bh8_off, m.cfg.hidden, m.cfg.n_q * m.cfg.head_dim, w)
            }
            if o_rc != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return false
            }

            if qwen3_metal_encode_vec_add(
                &rt.sess, cid, rt.pipes.vec_add,
                rt.b_work, bx8_off,
                rt.b_work, bh8_off,
                w * m.cfg.hidden
            ) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return false
            }

            let post_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, slot_base + 7))
            let post_off = qwen3_model_tensor_data_off(m, slot_base + 7)
            let post_dt = qwen3_model_tensor_dtype(m, slot_base + 7)
            let post_pipe = if post_dt == 2 { rt.pipes.rmsnorm_bf16 } else { rt.pipes.rmsnorm_f32 }
            if qwen3_metal_encode_rmsnorm(
                &rt.sess, cid, post_pipe,
                rt.b_work, bx8_off,
                post_s, post_off,
                rt.b_work, bh8_off,
                w, m.cfg.hidden, eps_bits
            ) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return false
            }

            let gate_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, slot_base + 8))
            let gate_off = qwen3_model_tensor_data_off(m, slot_base + 8)
            let gate_dt = qwen3_model_tensor_dtype(m, slot_base + 8)
            let gate_rc = if use_tc && gate_dt == 2 {
                qwen3_metal_encode_gemm_tc(&rt.sess, cid, rt.pipes.gemm_bf16_tc, gate_s, gate_off, rt.b_work, bh8_off, rt.b_work, bgate8_off, m.cfg.inter, m.cfg.hidden, w)
            } else {
                let gate_pipe = if gate_dt == 2 { rt.pipes.gemm_bf16 } else { rt.pipes.gemm_f32 }
                qwen3_metal_encode_gemm(&rt.sess, cid, gate_pipe, gate_s, gate_off, rt.b_work, bh8_off, rt.b_work, bgate8_off, m.cfg.inter, m.cfg.hidden, w)
            }
            if gate_rc != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return false
            }

            let up_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, slot_base + 9))
            let up_off = qwen3_model_tensor_data_off(m, slot_base + 9)
            let up_dt = qwen3_model_tensor_dtype(m, slot_base + 9)
            let up_rc = if use_tc && up_dt == 2 {
                qwen3_metal_encode_gemm_tc(&rt.sess, cid, rt.pipes.gemm_bf16_tc, up_s, up_off, rt.b_work, bh8_off, rt.b_work, bup8_off, m.cfg.inter, m.cfg.hidden, w)
            } else {
                let up_pipe = if up_dt == 2 { rt.pipes.gemm_bf16 } else { rt.pipes.gemm_f32 }
                qwen3_metal_encode_gemm(&rt.sess, cid, up_pipe, up_s, up_off, rt.b_work, bh8_off, rt.b_work, bup8_off, m.cfg.inter, m.cfg.hidden, w)
            }
            if up_rc != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return false
            }

            if qwen3_metal_encode_swiglu(
                &rt.sess, cid, rt.pipes.swiglu,
                rt.b_work, bgate8_off,
                rt.b_work, bup8_off,
                rt.b_work, bgate8_off,
                w * m.cfg.inter
            ) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return false
            }

            let down_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, slot_base + 10))
            let down_off = qwen3_model_tensor_data_off(m, slot_base + 10)
            let down_dt = qwen3_model_tensor_dtype(m, slot_base + 10)
            let down_rc = if use_tc && down_dt == 2 {
                qwen3_metal_encode_gemm_tc(&rt.sess, cid, rt.pipes.gemm_bf16_tc, down_s, down_off, rt.b_work, bgate8_off, rt.b_work, bh8_off, m.cfg.hidden, m.cfg.inter, w)
            } else {
                let down_pipe = if down_dt == 2 { rt.pipes.gemm_bf16 } else { rt.pipes.gemm_f32 }
                qwen3_metal_encode_gemm(&rt.sess, cid, down_pipe, down_s, down_off, rt.b_work, bgate8_off, rt.b_work, bh8_off, m.cfg.hidden, m.cfg.inter, w)
            }
            if down_rc != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return false
            }

            if qwen3_metal_encode_vec_add(
                &rt.sess, cid, rt.pipes.vec_add,
                rt.b_work, bx8_off,
                rt.b_work, bh8_off,
                w * m.cfg.hidden
            ) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return false
            }

            l = l + 1
        }

        if compute_all_top1 {
            let norm_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, 1))
            let norm_off = qwen3_model_tensor_data_off(m, 1)
            let norm_dt = qwen3_model_tensor_dtype(m, 1)
            let norm_pipe = if norm_dt == 2 { rt.pipes.rmsnorm_bf16 } else { rt.pipes.rmsnorm_f32 }
            if qwen3_metal_encode_rmsnorm(
                &rt.sess, cid, norm_pipe,
                rt.b_work, bx8_off,
                norm_s, norm_off,
                rt.b_work, bh8_off,
                w, m.cfg.hidden, eps_bits
            ) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return false
            }

            let lm_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, 2))
            let lm_off = qwen3_model_tensor_data_off(m, 2)
            let lm_dt = qwen3_model_tensor_dtype(m, 2)
            let lm_rc = if use_tc && lm_dt == 2 {
                qwen3_metal_encode_gemm_tc(&rt.sess, cid, rt.pipes.gemm_bf16_tc, lm_s, lm_off, rt.b_work, bh8_off, rt.b_work, blogits8_off, m.cfg.vocab, m.cfg.hidden, w)
            } else {
                let lm_pipe = if lm_dt == 2 { rt.pipes.gemm_bf16 } else { rt.pipes.gemm_f32 }
                qwen3_metal_encode_gemm(&rt.sess, cid, lm_pipe, lm_s, lm_off, rt.b_work, bh8_off, rt.b_work, blogits8_off, m.cfg.vocab, m.cfg.hidden, w)
            }
            if lm_rc != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return false
            }

            if qwen3_metal_encode_argmax_top2_batch(
                &rt.sess, cid, rt.pipes.argmax_top2_batch,
                rt.b_work, blogits8_off,
                rt.b_work, btop2_8_off,
                m.cfg.vocab, w
            ) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return false
            }
        } else if compute_last_logits && is_last_chunk {
            let norm_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, 1))
            let norm_off = qwen3_model_tensor_data_off(m, 1)
            let norm_dt = qwen3_model_tensor_dtype(m, 1)
            let norm_pipe = if norm_dt == 2 { rt.pipes.rmsnorm_bf16 } else { rt.pipes.rmsnorm_f32 }
            let last_x_off = bx8_off + (w - 1) * m.cfg.hidden * 4
            if qwen3_metal_encode_rmsnorm(
                &rt.sess, cid, norm_pipe,
                rt.b_work, last_x_off,
                norm_s, norm_off,
                rt.b_work, m.buf_h_off,
                1, m.cfg.hidden, eps_bits
            ) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return false
            }

            let lm_s = qwen3_metal_shard_buf(rt, qwen3_model_tensor_shard_idx(m, 2))
            let lm_off = qwen3_model_tensor_data_off(m, 2)
            let lm_dt = qwen3_model_tensor_dtype(m, 2)
            let lm_pipe = if lm_dt == 2 { rt.pipes.gemv_bf16 } else { rt.pipes.gemv_f32 }
            if qwen3_metal_encode_gemv(
                &rt.sess, cid, lm_pipe,
                lm_s, lm_off,
                rt.b_work, m.buf_h_off,
                rt.b_work, m.buf_logits_off,
                m.cfg.vocab, m.cfg.hidden
            ) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return false
            }

            if qwen3_metal_encode_argmax_top2(
                &rt.sess, cid, rt.pipes.argmax_top2,
                rt.b_work, m.buf_logits_off,
                rt.b_work, m.buf_top2_off,
                m.cfg.vocab
            ) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return false
            }
        }

        if metal_cmd_commit_sync(&rt.sess, cid) != 0 {
            return false
        }

        if compute_all_top1 {
            if top1_out_ptr != 0 {
                var bi: i64 = 0
                while bi < w {
                    let t1 = ptr_read_i64_le(a_base + btop2_8_off + bi * 32, 0)
                    let _wt = ptr_write_i64_le(top1_out_ptr, (done + bi) * 8, t1)
                    bi = bi + 1
                }
            }
            if is_last_chunk {
                let src_pk = a_base + btop2_8_off + (w - 1) * 32
                let dst_pk = a_base + m.buf_top2_off
                let _c0 = ptr_write_i64_le(dst_pk, 0, ptr_read_i64_le(src_pk, 0))
                let _c1 = ptr_write_i64_le(dst_pk, 8, ptr_read_i64_le(src_pk, 8))
                let _c2 = ptr_write_i64_le(dst_pk, 16, ptr_read_i64_le(src_pk, 16))
                if compute_last_logits {
                    let src_lg = a_base + blogits8_off + (w - 1) * m.cfg.vocab * 4
                    let dst_lg = a_base + m.buf_logits_off
                    var vi: i64 = 0
                    while vi < m.cfg.vocab {
                        let _wl = ptr_write_u32_le(dst_lg, vi * 4, ptr_read_u32_le(src_lg, vi * 4))
                        vi = vi + 1
                    }
                }
            }
        } else if compute_last_logits && is_last_chunk && top1_out_ptr != 0 {
            let t = qwen3_model_top2(m)
            let _wt = ptr_write_i64_le(top1_out_ptr, (n_toks - 1) * 8, t.top1_id)
        }

        done = done + w
        }
    }

    true
}

pub fn qwen3_forward_batch_bf16_metal(
    m: &Qwen3Model,
    kv: &!Qwen3PagedKv,
    rt: &Qwen3MetalRunner,
    tok_ids_ptr: i64,
    pos_start: i64,
    n_toks: i64,
    compute_all_top1: bool,
    compute_last_logits: bool,
    top1_out_ptr: i64
) -> bool with Mut, Div, Panic {
    qwen3_forward_batch_bf16_metal_mode(m, kv, rt, tok_ids_ptr, pos_start, n_toks, compute_all_top1, compute_last_logits, top1_out_ptr, false)
}

pub fn qwen3_forward_batch_bf16_cpu(
    m: &Qwen3Model,
    kv: &!Qwen3PagedKv,
    tok_ids_ptr: i64,
    pos_start: i64,
    n_toks: i64,
    compute_all_top1: bool,
    compute_last_logits: bool,
    top1_out_ptr: i64
) -> bool with Alloc, Mut, Div, Panic {
    if !m.ok || !qwen3_kv_is_ok(kv) || tok_ids_ptr == 0 || pos_start < 0 || n_toks <= 0 {
        return false
    }
    let _ftz = hal_cpu_set_ftz_daz(true)
    var i: i64 = 0
    while i < n_toks {
        let tid = ptr_read_i64_le(tok_ids_ptr, i * 8)
        if !qwen3_forward_token_cpu(m, kv, tid, pos_start + i) {
            return false
        }
        if (compute_all_top1 || (compute_last_logits && i == n_toks - 1)) && top1_out_ptr != 0 {
            let t = qwen3_model_top2(m)
            let _wt = ptr_write_i64_le(top1_out_ptr, i * 8, t.top1_id)
        }
        i = i + 1
    }
    true
}

pub linear struct Qwen3EisaModel {
    pub q4_arena: PageArena,
    pub meta_arena: PageArena,
    pub b_q4: i64,
    pub eisa_pipes: EisaMetalPipelines,
    pub n_slots: i64,
    pub quant_bits: i64,
    pub ok: bool,
}

pub fn qwen3_eisa_model_is_ok(em: &Qwen3EisaModel) -> bool {
    em.ok
}

pub fn qwen3_eisa_model_bytes(em: &Qwen3EisaModel) -> i64 {
    page_arena_len(&em.q4_arena)
}

pub fn qwen3_eisa_model_free(em: Qwen3EisaModel, rt: &Qwen3MetalRunner) -> i64 with IO, Mut {
    let Qwen3EisaModel {
        q4_arena,
        meta_arena,
        b_q4,
        eisa_pipes: _,
        n_slots: _,
        quant_bits: _,
        ok: _,
    } = em
    if b_q4 > 0 {
        let _f = metal_buffer_free(&rt.sess, b_q4)
    }
    let _fa = page_arena_free(q4_arena)
    let _fm = page_arena_free(meta_arena)
    0
}

pub fn qwen3_eisa_model_free_cpu(em: Qwen3EisaModel) -> i64 with IO, Mut {
    let Qwen3EisaModel {
        q4_arena,
        meta_arena,
        b_q4: _,
        eisa_pipes: _,
        n_slots: _,
        quant_bits: _,
        ok: _,
    } = em
    let _fa = page_arena_free(q4_arena)
    let _fm = page_arena_free(meta_arena)
    0
}

fn qwen3_is_linear_slot(slot: i64) -> bool {
    if slot == 2 { return true }
    if slot >= 3 {
        let k = (slot - 3) % 11
        if k == 1 || k == 2 || k == 3 || k == 4 || k == 8 || k == 9 || k == 10 {
            return true
        }
    }
    false
}

fn qwen3_is_mlp_or_head_slot(slot: i64) -> bool {
    if slot == 2 { return true }
    if slot >= 3 {
        let k = (slot - 3) % 11
        if k == 8 || k == 9 || k == 10 {
            return true
        }
    }
    false
}

fn qwen3_slot_matches_mask(slot: i64, mlp_only: bool) -> bool {
    if mlp_only { qwen3_is_mlp_or_head_slot(slot) } else { qwen3_is_linear_slot(slot) }
}

fn qwen3_eisa_quantize_slot(
    m: &Qwen3Model,
    slot: i64,
    dst_q4_ptr: i64,
    rows: i64,
    cols: i64,
    bits: i64
) -> bool with Mut, Div {
    let host_p = qwen3_model_tensor_host_ptr(m, slot)
    let dt = qwen3_model_tensor_dtype(m, slot)
    if host_p <= 0 || rows <= 0 || cols <= 0 { return false }
    if bits == 8 {
        if dt == 2 {
            return qwen3_quantize_bf16_to_q8_eisa(host_p, dst_q4_ptr, rows, cols)
        }
        return qwen3_quantize_f32_to_q8_eisa(host_p, dst_q4_ptr, rows, cols)
    }
    if dt == 2 {
        qwen3_quantize_bf16_to_q4_eisa(host_p, dst_q4_ptr, rows, cols)
    } else {
        qwen3_quantize_f32_to_q4_eisa(host_p, dst_q4_ptr, rows, cols)
    }
}

pub fn qwen3_eisa_model_quantize_mode_bits(
    m: &Qwen3Model,
    rt: &Qwen3MetalRunner,
    bits: i64,
    mlp_only: bool
) -> Qwen3EisaModel with IO, Mut, Alloc, Div {
    let bpb: i64 = if bits == 8 { 36 } else { 20 }
    if !m.ok || !rt.ok || (bits != 4 && bits != 8) {
        return Qwen3EisaModel {
            q4_arena: PageArena { ptr: 0, len: 0, ok: false },
            meta_arena: PageArena { ptr: 0, len: 0, ok: false },
            b_q4: 0,
            eisa_pipes: eisa_metal_pipelines_empty(),
            n_slots: 0,
            quant_bits: bits,
            ok: false,
        }
    }

    let total_slots = 3 + m.cfg.layers * 11
    let meta_bytes = align_up_64(total_slots * 32)
    var total_q4_bytes: i64 = 0

    var s: i64 = 0
    while s < total_slots {
        if qwen3_slot_matches_mask(s, mlp_only) {
            let rows = qwen3_model_tensor_rows(m, s)
            let cols = qwen3_model_tensor_cols(m, s)
            let n_blocks = (cols + 31) / 32
            let matrix_bytes = align_up_64(rows * n_blocks * bpb)
            total_q4_bytes = total_q4_bytes + matrix_bytes
        }
        s = s + 1
    }
    total_q4_bytes = total_q4_bytes + 16384

    let q4_arena = page_arena_alloc(total_q4_bytes)
    let meta_arena = page_arena_alloc(meta_bytes)
    var ok = page_arena_is_ok(&q4_arena) && page_arena_is_ok(&meta_arena)

    let eisa_pipes = if ok { eisa_metal_pipelines_compile(&rt.sess) } else { eisa_metal_pipelines_empty() }
    let b_q4 = if ok { metal_buffer_nocopy(&rt.sess, page_arena_ptr(&q4_arena), page_arena_len(&q4_arena)) } else { 0 }
    if b_q4 <= 0 || !eisa_pipes.ok {
        ok = false
    }

    if ok {
        let meta_base = page_arena_ptr(&meta_arena)
        var cur_q4_off: i64 = 0
        var cid: i64 = 0
        var in_batch: i64 = 0
        s = 0
        while s < total_slots {
            let is_lin = qwen3_slot_matches_mask(s, mlp_only)
            let rows = qwen3_model_tensor_rows(m, s)
            let cols = qwen3_model_tensor_cols(m, s)
            if is_lin && rows > 0 && cols > 0 {
                if cid <= 0 {
                    cid = metal_cmd_begin(&rt.sess)
                    if cid <= 0 {
                        ok = false
                        break
                    }
                }
                let n_blocks = (cols + 31) / 32
                let matrix_bytes = align_up_64(rows * n_blocks * bpb)
                let s_idx = qwen3_model_tensor_shard_idx(m, s)
                let s_buf = qwen3_metal_shard_buf(rt, s_idx)
                let s_off = qwen3_model_tensor_data_off(m, s)
                let dt = qwen3_model_tensor_dtype(m, s)
                let p_quant = if bits == 8 {
                    if dt == 2 { eisa_pipes.q8_quant_bf16 } else { eisa_pipes.q8_quant_f32 }
                } else {
                    if dt == 2 { eisa_pipes.q4_quant_bf16 } else { eisa_pipes.q4_quant_f32 }
                }
                let q_rc = if bits == 8 {
                    qwen3_metal_encode_quantize_q8_eisa(&rt.sess, cid, p_quant, s_buf, s_off, b_q4, cur_q4_off, rows, cols)
                } else {
                    qwen3_metal_encode_quantize_q4_eisa(&rt.sess, cid, p_quant, s_buf, s_off, b_q4, cur_q4_off, rows, cols)
                }
                if q_rc != 0 {
                    let _c = metal_cmd_cancel(&rt.sess, cid)
                    cid = 0
                    ok = false
                    break
                }
                let _w0 = ptr_write_i64_le(meta_base, s * 32 + 0, cur_q4_off)
                let _w1 = ptr_write_i64_le(meta_base, s * 32 + 8, rows)
                let _w2 = ptr_write_i64_le(meta_base, s * 32 + 16, cols)
                let _w3 = ptr_write_i64_le(meta_base, s * 32 + 24, 1)
                cur_q4_off = cur_q4_off + matrix_bytes
                in_batch = in_batch + 1
                if in_batch >= 16 {
                    if metal_cmd_commit_sync(&rt.sess, cid) != 0 {
                        cid = 0
                        ok = false
                        break
                    }
                    cid = 0
                    in_batch = 0
                }
            } else {
                let _w0 = ptr_write_i64_le(meta_base, s * 32 + 0, 0)
                let _w1 = ptr_write_i64_le(meta_base, s * 32 + 8, rows)
                let _w2 = ptr_write_i64_le(meta_base, s * 32 + 16, cols)
                let _w3 = ptr_write_i64_le(meta_base, s * 32 + 24, 0)
            }
            s = s + 1
        }
        if cid > 0 {
            if !ok {
                let _c = metal_cmd_cancel(&rt.sess, cid)
            } else if metal_cmd_commit_sync(&rt.sess, cid) != 0 {
                ok = false
            }
        }
    }

    Qwen3EisaModel {
        q4_arena: q4_arena,
        meta_arena: meta_arena,
        b_q4: b_q4,
        eisa_pipes: eisa_pipes,
        n_slots: total_slots,
        quant_bits: bits,
        ok: ok,
    }
}

pub fn qwen3_eisa_model_quantize_bits(
    m: &Qwen3Model,
    rt: &Qwen3MetalRunner,
    bits: i64
) -> Qwen3EisaModel with IO, Mut, Alloc, Div {
    qwen3_eisa_model_quantize_mode_bits(m, rt, bits, false)
}

pub fn qwen3_eisa_model_quantize_mlp_head_bits(
    m: &Qwen3Model,
    rt: &Qwen3MetalRunner,
    bits: i64
) -> Qwen3EisaModel with IO, Mut, Alloc, Div {
    qwen3_eisa_model_quantize_mode_bits(m, rt, bits, true)
}

pub fn qwen3_eisa_model_quantize(
    m: &Qwen3Model,
    rt: &Qwen3MetalRunner
) -> Qwen3EisaModel with IO, Mut, Alloc, Div {
    qwen3_eisa_model_quantize_bits(m, rt, 4)
}

pub fn qwen3_eisa_model_quantize_cpu(
    m: &Qwen3Model
) -> Qwen3EisaModel with IO, Mut, Alloc, Div {
    qwen3_eisa_model_quantize_cpu_bits(m, 4)
}

pub fn qwen3_eisa_model_quantize_mode_cpu_bits(
    m: &Qwen3Model,
    bits: i64,
    mlp_only: bool
) -> Qwen3EisaModel with IO, Mut, Alloc, Div {
    let bpb: i64 = if bits == 8 { 36 } else { 20 }
    if !m.ok || (bits != 4 && bits != 8) {
        return Qwen3EisaModel {
            q4_arena: PageArena { ptr: 0, len: 0, ok: false },
            meta_arena: PageArena { ptr: 0, len: 0, ok: false },
            b_q4: 0,
            eisa_pipes: eisa_metal_pipelines_empty(),
            n_slots: 0,
            quant_bits: bits,
            ok: false,
        }
    }

    let total_slots = 3 + m.cfg.layers * 11
    let meta_bytes = align_up_64(total_slots * 32)
    var total_q4_bytes: i64 = 0

    var s: i64 = 0
    while s < total_slots {
        if qwen3_slot_matches_mask(s, mlp_only) {
            let rows = qwen3_model_tensor_rows(m, s)
            let cols = qwen3_model_tensor_cols(m, s)
            let n_blocks = (cols + 31) / 32
            let matrix_bytes = align_up_64(rows * n_blocks * bpb)
            total_q4_bytes = total_q4_bytes + matrix_bytes
        }
        s = s + 1
    }
    total_q4_bytes = total_q4_bytes + 16384

    let q4_arena = page_arena_alloc(total_q4_bytes)
    let meta_arena = page_arena_alloc(meta_bytes)
    var ok = page_arena_is_ok(&q4_arena) && page_arena_is_ok(&meta_arena)

    if ok {
        let q4_base = page_arena_ptr(&q4_arena)
        let meta_base = page_arena_ptr(&meta_arena)
        var cur_q4_off: i64 = 0

        s = 0
        while s < total_slots {
            let is_lin = qwen3_slot_matches_mask(s, mlp_only)
            let rows = qwen3_model_tensor_rows(m, s)
            let cols = qwen3_model_tensor_cols(m, s)
            if is_lin && rows > 0 && cols > 0 {
                let n_blocks = (cols + 31) / 32
                let matrix_bytes = align_up_64(rows * n_blocks * bpb)
                let _qok = qwen3_eisa_quantize_slot(m, s, q4_base + cur_q4_off, rows, cols, bits)
                let _w0 = ptr_write_i64_le(meta_base, s * 32 + 0, cur_q4_off)
                let _w1 = ptr_write_i64_le(meta_base, s * 32 + 8, rows)
                let _w2 = ptr_write_i64_le(meta_base, s * 32 + 16, cols)
                let _w3 = ptr_write_i64_le(meta_base, s * 32 + 24, 1)
                cur_q4_off = cur_q4_off + matrix_bytes
            } else {
                let _w0 = ptr_write_i64_le(meta_base, s * 32 + 0, 0)
                let _w1 = ptr_write_i64_le(meta_base, s * 32 + 8, rows)
                let _w2 = ptr_write_i64_le(meta_base, s * 32 + 16, cols)
                let _w3 = ptr_write_i64_le(meta_base, s * 32 + 24, 0)
            }
            s = s + 1
        }
    }

    Qwen3EisaModel {
        q4_arena: q4_arena,
        meta_arena: meta_arena,
        b_q4: 0,
        eisa_pipes: eisa_metal_pipelines_empty(),
        n_slots: total_slots,
        quant_bits: bits,
        ok: ok,
    }
}

pub fn qwen3_eisa_model_quantize_cpu_bits(
    m: &Qwen3Model,
    bits: i64
) -> Qwen3EisaModel with IO, Mut, Alloc, Div {
    qwen3_eisa_model_quantize_mode_cpu_bits(m, bits, false)
}

pub fn qwen3_eisa_model_quantize_mlp_head_cpu_bits(
    m: &Qwen3Model,
    bits: i64
) -> Qwen3EisaModel with IO, Mut, Alloc, Div {
    qwen3_eisa_model_quantize_mode_cpu_bits(m, bits, true)
}

pub fn qwen3_eisa_model_quantize_lm_head_bits(
    m: &Qwen3Model,
    rt: &Qwen3MetalRunner,
    bits: i64
) -> Qwen3EisaModel with IO, Mut, Alloc, Div {
    let bpb: i64 = if bits == 8 { 36 } else { 20 }
    if !m.ok || !rt.ok || (bits != 4 && bits != 8) {
        return Qwen3EisaModel {
            q4_arena: PageArena { ptr: 0, len: 0, ok: false },
            meta_arena: PageArena { ptr: 0, len: 0, ok: false },
            b_q4: 0,
            eisa_pipes: eisa_metal_pipelines_empty(),
            n_slots: 0,
            quant_bits: bits,
            ok: false,
        }
    }

    let total_slots = 3 + m.cfg.layers * 11
    let meta_bytes = align_up_64(total_slots * 32)
    var total_q4_bytes: i64 = 0

    var s: i64 = 0
    while s < total_slots {
        if s == 2 {
            let rows = qwen3_model_tensor_rows(m, s)
            let cols = qwen3_model_tensor_cols(m, s)
            let n_blocks = (cols + 31) / 32
            let matrix_bytes = align_up_64(rows * n_blocks * bpb)
            total_q4_bytes = total_q4_bytes + matrix_bytes
        }
        s = s + 1
    }
    total_q4_bytes = total_q4_bytes + 16384

    let q4_arena = page_arena_alloc(total_q4_bytes)
    let meta_arena = page_arena_alloc(meta_bytes)
    var ok = page_arena_is_ok(&q4_arena) && page_arena_is_ok(&meta_arena)

    let eisa_pipes = if ok { eisa_metal_pipelines_compile(&rt.sess) } else { eisa_metal_pipelines_empty() }
    let b_q4 = if ok { metal_buffer_nocopy(&rt.sess, page_arena_ptr(&q4_arena), page_arena_len(&q4_arena)) } else { 0 }
    if b_q4 <= 0 || !eisa_pipes.ok {
        ok = false
    }

    if ok {
        let meta_base = page_arena_ptr(&meta_arena)
        var cur_q4_off: i64 = 0
        let cid = metal_cmd_begin(&rt.sess)
        if cid <= 0 {
            ok = false
        } else {
            s = 0
            while s < total_slots {
                let is_lin = s == 2
                let rows = qwen3_model_tensor_rows(m, s)
                let cols = qwen3_model_tensor_cols(m, s)
                if is_lin && rows > 0 && cols > 0 {
                    let n_blocks = (cols + 31) / 32
                    let matrix_bytes = align_up_64(rows * n_blocks * bpb)
                    let s_idx = qwen3_model_tensor_shard_idx(m, s)
                    let s_buf = qwen3_metal_shard_buf(rt, s_idx)
                    let s_off = qwen3_model_tensor_data_off(m, s)
                    let dt = qwen3_model_tensor_dtype(m, s)
                    let p_quant = if bits == 8 {
                        if dt == 2 { eisa_pipes.q8_quant_bf16 } else { eisa_pipes.q8_quant_f32 }
                    } else {
                        if dt == 2 { eisa_pipes.q4_quant_bf16 } else { eisa_pipes.q4_quant_f32 }
                    }
                    let q_rc = if bits == 8 {
                        qwen3_metal_encode_quantize_q8_eisa(&rt.sess, cid, p_quant, s_buf, s_off, b_q4, cur_q4_off, rows, cols)
                    } else {
                        qwen3_metal_encode_quantize_q4_eisa(&rt.sess, cid, p_quant, s_buf, s_off, b_q4, cur_q4_off, rows, cols)
                    }
                    if q_rc != 0 {
                        let _c = metal_cmd_cancel(&rt.sess, cid)
                        ok = false
                        break
                    }
                    let _w0 = ptr_write_i64_le(meta_base, s * 32 + 0, cur_q4_off)
                    let _w1 = ptr_write_i64_le(meta_base, s * 32 + 8, rows)
                    let _w2 = ptr_write_i64_le(meta_base, s * 32 + 16, cols)
                    let _w3 = ptr_write_i64_le(meta_base, s * 32 + 24, 1)
                    cur_q4_off = cur_q4_off + matrix_bytes
                } else {
                    let _w0 = ptr_write_i64_le(meta_base, s * 32 + 0, 0)
                    let _w1 = ptr_write_i64_le(meta_base, s * 32 + 8, rows)
                    let _w2 = ptr_write_i64_le(meta_base, s * 32 + 16, cols)
                    let _w3 = ptr_write_i64_le(meta_base, s * 32 + 24, 0)
                }
                s = s + 1
            }
            if metal_cmd_commit_sync(&rt.sess, cid) != 0 {
                ok = false
            }
        }
    }

    Qwen3EisaModel {
        q4_arena: q4_arena,
        meta_arena: meta_arena,
        b_q4: b_q4,
        eisa_pipes: eisa_pipes,
        n_slots: total_slots,
        quant_bits: bits,
        ok: ok,
    }
}

pub fn qwen3_eisa_model_quantize_lm_head_cpu_bits(
    m: &Qwen3Model,
    bits: i64
) -> Qwen3EisaModel with IO, Mut, Alloc, Div {
    let bpb: i64 = if bits == 8 { 36 } else { 20 }
    if !m.ok || (bits != 4 && bits != 8) {
        return Qwen3EisaModel {
            q4_arena: PageArena { ptr: 0, len: 0, ok: false },
            meta_arena: PageArena { ptr: 0, len: 0, ok: false },
            b_q4: 0,
            eisa_pipes: eisa_metal_pipelines_empty(),
