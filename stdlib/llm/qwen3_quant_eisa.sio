        add_accum_rmsnorm_bf16: 0,
        add_accum_rmsnorm_f32: 0,
        ok: false,
    }
}

pub fn qwen3_eisa_q4_bytes(n_weights: i64) -> i64 {
    ((n_weights + 31) / 32) * 20
}

pub fn qwen3_eisa_q8_bytes(n_weights: i64) -> i64 {
    ((n_weights + 31) / 32) * 36
}

fn round_to_i64(x: f64) -> i64 {
    if x >= 0.0 {
        (x + 0.5) as i64
    } else {
        (x - 0.5) as i64
    }
}

fn f64_abs(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

pub fn compute_rho_bits_upward(exact_l2: f64) -> i64 with Mut {
    var bits = f64_to_f16_bits(exact_l2) & 65535
    if exact_l2 > 0.0 {
        if bits == 0 {
            bits = 1
        }
        while f16_bits_to_f64(bits) < exact_l2 && bits < 31743 {
            bits = bits + 1
        }
    }
    bits & 65535
}

pub fn qwen3_quantize_f32_to_q4_eisa(
    w_f32_ptr: i64,
    dst_q4_ptr: i64,
    out_dim: i64,
    in_dim: i64
) -> bool with Mut, Div {
    if w_f32_ptr == 0 || dst_q4_ptr == 0 || out_dim <= 0 || in_dim <= 0 {
        return false
    }
    let n_blocks = (in_dim + 31) / 32
    var r: i64 = 0
    while r < out_dim {
        var b: i64 = 0
        while b < n_blocks {
            let base_w_idx = r * in_dim + b * 32
            var max_abs: f64 = 0.0
            var k: i64 = 0
            while k < 32 {
                let idx = base_w_idx + k
                if idx < (r + 1) * in_dim {
                    let u32_bits = ptr_read_u32_le(w_f32_ptr, idx * 4)
                    let w = f32_bits_to_f64(u32_bits)
                    let a = f64_abs(w)
                    if a > max_abs { max_abs = a }
                }
                k = k + 1
            }

            let s_bits = if max_abs == 0.0 { 0 } else { f64_to_f16_bits(max_abs / 7.0) & 65535 }
            let s_f16 = f16_bits_to_f64(s_bits)

            var sum_sq_err: f64 = 0.0
            var j: i64 = 0
            let dst_block_off = (r * n_blocks + b) * 20
            while j < 16 {
                let k0 = base_w_idx + 2 * j
                let k1 = k0 + 1
                var w0: f64 = 0.0
                var w1: f64 = 0.0
                if k0 < (r + 1) * in_dim {
                    w0 = f32_bits_to_f64(ptr_read_u32_le(w_f32_ptr, k0 * 4))
                }
                if k1 < (r + 1) * in_dim {
                    w1 = f32_bits_to_f64(ptr_read_u32_le(w_f32_ptr, k1 * 4))
                }

                var q0: i64 = 0
                var q1: i64 = 0
                if s_f16 != 0.0 {
                    let r0 = round_to_i64(w0 / s_f16)
                    q0 = if r0 < -8 { -8 } else if r0 > 7 { 7 } else { r0 }
                    let r1 = round_to_i64(w1 / s_f16)
                    q1 = if r1 < -8 { -8 } else if r1 > 7 { 7 } else { r1 }
                }
                let diff0 = w0 - s_f16 * (q0 as f64)
                let diff1 = w1 - s_f16 * (q1 as f64)
                sum_sq_err = sum_sq_err + diff0 * diff0 + diff1 * diff1

                let lo = (q0 + 8) & 15
                let hi = (q1 + 8) & 15
                let nibble_byte = lo | (hi << 4)
                let _wb = ptr_write_u8(dst_q4_ptr, dst_block_off + 4 + j, nibble_byte)
                j = j + 1
            }

            let exact_l2 = sqrt(sum_sq_err)
            let rho_bits = compute_rho_bits_upward(exact_l2)

            let _ws = ptr_write_u16_le(dst_q4_ptr, dst_block_off, s_bits)
            let _wr = ptr_write_u16_le(dst_q4_ptr, dst_block_off + 2, rho_bits)

            b = b + 1
        }
        r = r + 1
    }
    true
}

pub fn qwen3_quantize_bf16_to_q4_eisa(
    w_bf16_ptr: i64,
    dst_q4_ptr: i64,
    out_dim: i64,
    in_dim: i64
) -> bool with Mut, Div {
    if w_bf16_ptr == 0 || dst_q4_ptr == 0 || out_dim <= 0 || in_dim <= 0 {
        return false
    }
    let n_blocks = (in_dim + 31) / 32
    var r: i64 = 0
    while r < out_dim {
        var b: i64 = 0
        while b < n_blocks {
            let base_w_idx = r * in_dim + b * 32
            var max_abs: f64 = 0.0
            var k: i64 = 0
            while k < 32 {
                let idx = base_w_idx + k
                if idx < (r + 1) * in_dim {
                    let u16_bits = ptr_read_u16_le(w_bf16_ptr, idx * 2)
                    let w = bf16_bits_to_f64(u16_bits)
                    let a = f64_abs(w)
                    if a > max_abs { max_abs = a }
                }
                k = k + 1
            }

            let s_bits = if max_abs == 0.0 { 0 } else { f64_to_f16_bits(max_abs / 7.0) & 65535 }
            let s_f16 = f16_bits_to_f64(s_bits)

            var sum_sq_err: f64 = 0.0
            var j: i64 = 0
            let dst_block_off = (r * n_blocks + b) * 20
            while j < 16 {
                let k0 = base_w_idx + 2 * j
                let k1 = k0 + 1
                var w0: f64 = 0.0
                var w1: f64 = 0.0
                if k0 < (r + 1) * in_dim {
                    w0 = bf16_bits_to_f64(ptr_read_u16_le(w_bf16_ptr, k0 * 2))
                }
                if k1 < (r + 1) * in_dim {
                    w1 = bf16_bits_to_f64(ptr_read_u16_le(w_bf16_ptr, k1 * 2))
                }

                var q0: i64 = 0
                var q1: i64 = 0
                if s_f16 != 0.0 {
                    let r0 = round_to_i64(w0 / s_f16)
                    q0 = if r0 < -8 { -8 } else if r0 > 7 { 7 } else { r0 }
                    let r1 = round_to_i64(w1 / s_f16)
                    q1 = if r1 < -8 { -8 } else if r1 > 7 { 7 } else { r1 }
                }
                let diff0 = w0 - s_f16 * (q0 as f64)
                let diff1 = w1 - s_f16 * (q1 as f64)
                sum_sq_err = sum_sq_err + diff0 * diff0 + diff1 * diff1

                let lo = (q0 + 8) & 15
                let hi = (q1 + 8) & 15
                let nibble_byte = lo | (hi << 4)
                let _wb = ptr_write_u8(dst_q4_ptr, dst_block_off + 4 + j, nibble_byte)
                j = j + 1
            }

            let exact_l2 = sqrt(sum_sq_err)
            let rho_bits = compute_rho_bits_upward(exact_l2)

            let _ws = ptr_write_u16_le(dst_q4_ptr, dst_block_off, s_bits)
            let _wr = ptr_write_u16_le(dst_q4_ptr, dst_block_off + 2, rho_bits)

            b = b + 1
        }
        r = r + 1
    }
    true
}

pub fn qwen3_quantize_bf16_to_q8_eisa(
    w_bf16_ptr: i64,
    dst_q8_ptr: i64,
    out_dim: i64,
    in_dim: i64
) -> bool with Mut, Div {
    if w_bf16_ptr == 0 || dst_q8_ptr == 0 || out_dim <= 0 || in_dim <= 0 {
        return false
    }
    let n_blocks = (in_dim + 31) / 32
    var r: i64 = 0
    while r < out_dim {
        var b: i64 = 0
        while b < n_blocks {
            let base_w_idx = r * in_dim + b * 32
            var max_abs: f64 = 0.0
            var k: i64 = 0
            while k < 32 {
                let idx = base_w_idx + k
                if idx < (r + 1) * in_dim {
                    let u16_bits = ptr_read_u16_le(w_bf16_ptr, idx * 2)
                    let w = bf16_bits_to_f64(u16_bits)
                    let a = f64_abs(w)
                    if a > max_abs { max_abs = a }
                }
                k = k + 1
            }

            let s_bits = if max_abs == 0.0 { 0 } else { f64_to_f16_bits(max_abs / 127.0) & 65535 }
            let s_f16 = f16_bits_to_f64(s_bits)

            var sum_sq_err: f64 = 0.0
            k = 0
            let dst_block_off = (r * n_blocks + b) * 36
            while k < 32 {
                let idx = base_w_idx + k
                var w: f64 = 0.0
                if idx < (r + 1) * in_dim {
                    w = bf16_bits_to_f64(ptr_read_u16_le(w_bf16_ptr, idx * 2))
                }
                var q: i64 = 0
                if s_f16 != 0.0 {
                    let raw = round_to_i64(w / s_f16)
                    q = if raw < -127 { -127 } else if raw > 127 { 127 } else { raw }
                }
                let diff = w - s_f16 * (q as f64)
                sum_sq_err = sum_sq_err + diff * diff
                let _wb = ptr_write_u8(dst_q8_ptr, dst_block_off + 4 + k, q & 255)
                k = k + 1
            }

            let exact_l2 = sqrt(sum_sq_err)
            let rho_bits = compute_rho_bits_upward(exact_l2)

            let _ws = ptr_write_u16_le(dst_q8_ptr, dst_block_off, s_bits)
            let _wr = ptr_write_u16_le(dst_q8_ptr, dst_block_off + 2, rho_bits)

            b = b + 1
        }
        r = r + 1
    }
    true
}

pub fn qwen3_quantize_f32_to_q8_eisa(
    w_f32_ptr: i64,
    dst_q8_ptr: i64,
    out_dim: i64,
    in_dim: i64
) -> bool with Mut, Div {
    if w_f32_ptr == 0 || dst_q8_ptr == 0 || out_dim <= 0 || in_dim <= 0 {
        return false
    }
    let n_blocks = (in_dim + 31) / 32
    var r: i64 = 0
    while r < out_dim {
        var b: i64 = 0
        while b < n_blocks {
            let base_w_idx = r * in_dim + b * 32
            var max_abs: f64 = 0.0
            var k: i64 = 0
            while k < 32 {
                let idx = base_w_idx + k
                if idx < (r + 1) * in_dim {
                    let u32_bits = ptr_read_u32_le(w_f32_ptr, idx * 4)
                    let w = f32_bits_to_f64(u32_bits)
                    let a = f64_abs(w)
                    if a > max_abs { max_abs = a }
                }
                k = k + 1
            }

            let s_bits = if max_abs == 0.0 { 0 } else { f64_to_f16_bits(max_abs / 127.0) & 65535 }
            let s_f16 = f16_bits_to_f64(s_bits)

            var sum_sq_err: f64 = 0.0
            k = 0
            let dst_block_off = (r * n_blocks + b) * 36
            while k < 32 {
                let idx = base_w_idx + k
                var w: f64 = 0.0
                if idx < (r + 1) * in_dim {
                    w = f32_bits_to_f64(ptr_read_u32_le(w_f32_ptr, idx * 4))
                }
                var q: i64 = 0
                if s_f16 != 0.0 {
                    let raw = round_to_i64(w / s_f16)
                    q = if raw < -127 { -127 } else if raw > 127 { 127 } else { raw }
                }
                let diff = w - s_f16 * (q as f64)
                sum_sq_err = sum_sq_err + diff * diff
                let _wb = ptr_write_u8(dst_q8_ptr, dst_block_off + 4 + k, q & 255)
                k = k + 1
            }

            let exact_l2 = sqrt(sum_sq_err)
            let rho_bits = compute_rho_bits_upward(exact_l2)

            let _ws = ptr_write_u16_le(dst_q8_ptr, dst_block_off, s_bits)
            let _wr = ptr_write_u16_le(dst_q8_ptr, dst_block_off + 2, rho_bits)

            b = b + 1
        }
        r = r + 1
    }
    true
}

pub fn qwen3_gemv_q4_eisa_cpu(
    q4_ptr: i64,
    x_f32_ptr: i64,
    u_x_f32_ptr: i64,
    val_f32_ptr: i64,
    err_f32_ptr: i64,
    u_f32_ptr: i64,
    out_dim: i64,
    in_dim: i64
) -> bool with Mut, Div {
    if q4_ptr == 0 || x_f32_ptr == 0 || out_dim <= 0 || in_dim <= 0 {
        return false
    }
    let n_blocks = (in_dim + 31) / 32
    var r: i64 = 0
    while r < out_dim {
        var val_sum: f64 = 0.0
        var err_sum: f64 = 0.0
        var u_sum: f64 = 0.0

        var b: i64 = 0
        while b < n_blocks {
            let blk_off = (r * n_blocks + b) * 20
            let s_bits = ptr_read_u16_le(q4_ptr, blk_off)
            let rho_bits = ptr_read_u16_le(q4_ptr, blk_off + 2)
            let s = f16_bits_to_f64(s_bits)
            let rho = f16_bits_to_f64(rho_bits)

            var sum_sq_x: f64 = 0.0
            var sum_sq_w: f64 = 0.0
            var sum_sq_u_x: f64 = 0.0
            let base_k = b * 32

            var j: i64 = 0
            while j < 16 {
                let byte_val = ptr_read_u8(q4_ptr, blk_off + 4 + j)
                let q0 = ((byte_val & 15) - 8) as f64
                let q1 = (((byte_val >> 4) & 15) - 8) as f64
                let w0 = s * q0
                let w1 = s * q1

                let k0 = base_k + 2 * j
                let k1 = k0 + 1

                var x0: f64 = 0.0
                var x1: f64 = 0.0
                if k0 < in_dim {
                    x0 = f32_bits_to_f64(ptr_read_u32_le(x_f32_ptr, k0 * 4))
                }
                if k1 < in_dim {
                    x1 = f32_bits_to_f64(ptr_read_u32_le(x_f32_ptr, k1 * 4))
                }

                val_sum = val_sum + w0 * x0 + w1 * x1
                sum_sq_x = sum_sq_x + x0 * x0 + x1 * x1
                sum_sq_w = sum_sq_w + w0 * w0 + w1 * w1

                if u_x_f32_ptr != 0 {
                    var ux0: f64 = 0.0
                    var ux1: f64 = 0.0
                    if k0 < in_dim {
                        ux0 = f32_bits_to_f64(ptr_read_u32_le(u_x_f32_ptr, k0 * 4))
                    }
                    if k1 < in_dim {
                        ux1 = f32_bits_to_f64(ptr_read_u32_le(u_x_f32_ptr, k1 * 4))
                    }
                    sum_sq_u_x = sum_sq_u_x + ux0 * ux0 + ux1 * ux1
                }

                j = j + 1
            }

            let norm_x = sqrt(sum_sq_x)
            let norm_w = sqrt(sum_sq_w)
            err_sum = err_sum + rho * norm_x + 0.00001 * (norm_w + rho) * norm_x

            if u_x_f32_ptr != 0 {
                let norm_u_x = sqrt(sum_sq_u_x)
                u_sum = u_sum + (norm_w + rho) * norm_u_x
            }

            b = b + 1
        }

        if val_f32_ptr != 0 {
            let _wv = ptr_write_u32_le(val_f32_ptr, r * 4, f64_to_f32_bits(val_sum))
        }
        if err_f32_ptr != 0 {
            let _we = ptr_write_u32_le(err_f32_ptr, r * 4, f64_to_f32_bits(err_sum))
        }
        if u_f32_ptr != 0 {
            let u_val = if u_x_f32_ptr != 0 { u_sum } else { 0.0 }
            let _wu = ptr_write_u32_le(u_f32_ptr, r * 4, f64_to_f32_bits(u_val))
        }

        r = r + 1
    }
    true
}

pub fn qwen3_gemv_q8_eisa_cpu(
    q8_ptr: i64,
    x_f32_ptr: i64,
    u_x_f32_ptr: i64,
    val_f32_ptr: i64,
    err_f32_ptr: i64,
    u_f32_ptr: i64,
    out_dim: i64,
    in_dim: i64
) -> bool with Mut, Div {
    if q8_ptr == 0 || x_f32_ptr == 0 || out_dim <= 0 || in_dim <= 0 {
        return false
    }
    let n_blocks = (in_dim + 31) / 32
    var r: i64 = 0
    while r < out_dim {
        var val_sum: f64 = 0.0
        var err_sum: f64 = 0.0
        var u_sum: f64 = 0.0

        var b: i64 = 0
        while b < n_blocks {
            let blk_off = (r * n_blocks + b) * 36
            let s_bits = ptr_read_u16_le(q8_ptr, blk_off)
            let rho_bits = ptr_read_u16_le(q8_ptr, blk_off + 2)
            let s = f16_bits_to_f64(s_bits)
            let rho = f16_bits_to_f64(rho_bits)

            var sum_sq_x: f64 = 0.0
            var sum_sq_w: f64 = 0.0
            var sum_sq_u_x: f64 = 0.0
            let base_k = b * 32

            var k: i64 = 0
            while k < 32 {
                let raw_b = ptr_read_u8(q8_ptr, blk_off + 4 + k)
                let q_signed = if raw_b >= 128 { raw_b - 256 } else { raw_b }
                let w = s * (q_signed as f64)
                let idx = base_k + k

                var x: f64 = 0.0
                if idx < in_dim {
                    x = f32_bits_to_f64(ptr_read_u32_le(x_f32_ptr, idx * 4))
                }

                val_sum = val_sum + w * x
                sum_sq_x = sum_sq_x + x * x
                sum_sq_w = sum_sq_w + w * w

                if u_x_f32_ptr != 0 {
                    var ux: f64 = 0.0
                    if idx < in_dim {
                        ux = f32_bits_to_f64(ptr_read_u32_le(u_x_f32_ptr, idx * 4))
                    }
                    sum_sq_u_x = sum_sq_u_x + ux * ux
                }

                k = k + 1
            }

            let norm_x = sqrt(sum_sq_x)
            let norm_w = sqrt(sum_sq_w)
            err_sum = err_sum + rho * norm_x + 0.00001 * (norm_w + rho) * norm_x

            if u_x_f32_ptr != 0 {
                let norm_u_x = sqrt(sum_sq_u_x)
                u_sum = u_sum + (norm_w + rho) * norm_u_x
            }

            b = b + 1
        }

        if val_f32_ptr != 0 {
            let _wv = ptr_write_u32_le(val_f32_ptr, r * 4, f64_to_f32_bits(val_sum))
        }
        if err_f32_ptr != 0 {
            let _we = ptr_write_u32_le(err_f32_ptr, r * 4, f64_to_f32_bits(err_sum))
        }
        if u_f32_ptr != 0 {
            let u_val = if u_x_f32_ptr != 0 { u_sum } else { 0.0 }
            let _wu = ptr_write_u32_le(u_f32_ptr, r * 4, f64_to_f32_bits(u_val))
        }

        r = r + 1
    }
    true
}

pub fn eisa_certify_argmax(
    val_f32_ptr: i64,
    err_f32_ptr: i64,
    u_f32_ptr: i64,
    n_vocab: i64
) -> EisaArgmaxCert with Mut {
    if n_vocab <= 0 || val_f32_ptr == 0 {
        return EisaArgmaxCert {
            top1_id: 0,
            runner_up_id: 0,
            top1_val: 0.0,
            top1_err: 0.0,
            top1_u: 0.0,
            margin_val: 0.0,
            combined_err: 0.0,
            combined_u: 0.0,
            certified_numerical: false,
            certified_total: false,
        }
    }
    if n_vocab == 1 {
        let v0 = f32_bits_to_f64(ptr_read_u32_le(val_f32_ptr, 0))
        let e0 = if err_f32_ptr != 0 { f32_bits_to_f64(ptr_read_u32_le(err_f32_ptr, 0)) } else { 0.0 }
        let u0 = if u_f32_ptr != 0 { f32_bits_to_f64(ptr_read_u32_le(u_f32_ptr, 0)) } else { 0.0 }
        return EisaArgmaxCert {
            top1_id: 0,
            runner_up_id: 0,
            top1_val: v0,
            top1_err: e0,
            top1_u: u0,
            margin_val: 0.0,
            combined_err: e0,
            combined_u: u0,
            certified_numerical: false,
            certified_total: false,
        }
    }

    let v0 = f32_bits_to_f64(ptr_read_u32_le(val_f32_ptr, 0))
    let v1 = f32_bits_to_f64(ptr_read_u32_le(val_f32_ptr, 4))
    var top1_id: i64 = 0
    var top1_val: f64 = v0
    var runner_up_id: i64 = 1
    var runner_up_val: f64 = v1
    if v1 > v0 {
        top1_id = 1
        top1_val = v1
        runner_up_id = 0
        runner_up_val = v0
    }

    var i: i64 = 2
    while i < n_vocab {
        let v = f32_bits_to_f64(ptr_read_u32_le(val_f32_ptr, i * 4))
        if v > top1_val {
            runner_up_id = top1_id
            runner_up_val = top1_val
            top1_id = i
            top1_val = v
        } else if v > runner_up_val {
            runner_up_id = i
            runner_up_val = v
        }
        i = i + 1
    }

    let top1_err = if err_f32_ptr != 0 { f32_bits_to_f64(ptr_read_u32_le(err_f32_ptr, top1_id * 4)) } else { 0.0 }
    let runner_up_err = if err_f32_ptr != 0 { f32_bits_to_f64(ptr_read_u32_le(err_f32_ptr, runner_up_id * 4)) } else { 0.0 }
    let top1_u = if u_f32_ptr != 0 { f32_bits_to_f64(ptr_read_u32_le(u_f32_ptr, top1_id * 4)) } else { 0.0 }
    let runner_up_u = if u_f32_ptr != 0 { f32_bits_to_f64(ptr_read_u32_le(u_f32_ptr, runner_up_id * 4)) } else { 0.0 }

    let margin_val = top1_val - runner_up_val
    let combined_err = top1_err + runner_up_err
    let combined_u = top1_u + runner_up_u
    let certified_numerical = margin_val > combined_err
    let certified_total = margin_val > (combined_err + combined_u)

    EisaArgmaxCert {
        top1_id: top1_id,
        runner_up_id: runner_up_id,
        top1_val: top1_val,
        top1_err: top1_err,
        top1_u: top1_u,
        margin_val: margin_val,
        combined_err: combined_err,
        combined_u: combined_u,
        certified_numerical: certified_numerical,
        certified_total: certified_total,
    }
}

pub fn eisa_certify_global(
    val_f32_ptr: i64,
    err_f32_ptr: i64,
    n_vocab: i64
) -> EisaConeCert with Mut {
    if n_vocab <= 0 || val_f32_ptr == 0 {
        return EisaConeCert {
            top1_id: 0, runner_up_id: 0, refined_top1_id: 0,
            top1_val: 0.0, top1_err: 0.0, max_other_upper: 0.0, global_margin: 0.0,
            cone_size: 0, bf16_rows_touched: 0,
            strict_global_certified: false, refined_exact: false,
        }
    }
    var top1_id: i64 = 0
    var top1_val: f64 = f32_bits_to_f64(ptr_read_u32_le(val_f32_ptr, 0))
    var i: i64 = 1
    while i < n_vocab {
        let v = f32_bits_to_f64(ptr_read_u32_le(val_f32_ptr, i * 4))
        if v > top1_val {
            top1_id = i
            top1_val = v
        }
        i = i + 1
    }
    let top1_err = if err_f32_ptr != 0 { f32_bits_to_f64(ptr_read_u32_le(err_f32_ptr, top1_id * 4)) } else { 0.0 }
    if n_vocab == 1 {
        return EisaConeCert {
            top1_id: top1_id, runner_up_id: top1_id, refined_top1_id: top1_id,
            top1_val: top1_val, top1_err: top1_err, max_other_upper: 0.0, global_margin: 0.0,
            cone_size: 1, bf16_rows_touched: 0,
            strict_global_certified: true, refined_exact: true,
        }
    }
    let lower_top1 = top1_val - top1_err
    var runner_up_id: i64 = -1
    var runner_up_val: f64 = 0.0
    var max_other_upper: f64 = 0.0
    var have_other: bool = false
    var cone_size: i64 = 0
    var j: i64 = 0
    while j < n_vocab {
        let v = f32_bits_to_f64(ptr_read_u32_le(val_f32_ptr, j * 4))
        let e = if err_f32_ptr != 0 { f32_bits_to_f64(ptr_read_u32_le(err_f32_ptr, j * 4)) } else { 0.0 }
        let up = v + e
        if up >= lower_top1 {
            cone_size = cone_size + 1
        }
        if j != top1_id {
            if !have_other || up > max_other_upper {
                max_other_upper = up
                have_other = true
            }
            if runner_up_id < 0 || v > runner_up_val {
                runner_up_id = j
                runner_up_val = v
            }
        }
        j = j + 1
    }
    let global_margin = lower_top1 - max_other_upper
    let certified = global_margin > 0.0
    EisaConeCert {
        top1_id: top1_id,
        runner_up_id: runner_up_id,
        refined_top1_id: top1_id,
        top1_val: top1_val,
        top1_err: top1_err,
        max_other_upper: max_other_upper,
        global_margin: global_margin,
        cone_size: if certified { 1 } else { cone_size },
        bf16_rows_touched: 0,
        strict_global_certified: certified,
        refined_exact: certified,
    }
}

pub fn eisa_cone_refine_bf16_cpu(
    val_f32_ptr: i64,
    err_f32_ptr: i64,
    w_host_ptr: i64,
    w_dtype: i32,
    h_f32_ptr: i64,
    n_vocab: i64,
    in_dim: i64
) -> EisaConeCert with Mut {
    let base = eisa_certify_global(val_f32_ptr, err_f32_ptr, n_vocab)
    if base.strict_global_certified || w_host_ptr <= 0 || h_f32_ptr <= 0 || in_dim <= 0 || n_vocab <= 0 || val_f32_ptr == 0 {
        return base
    }
    let lower_top1 = base.top1_val - base.top1_err
    var best_id: i64 = base.top1_id
    var best_dot: f64 = 0.0
    var have_best: bool = false
    var touched: i64 = 0
    var r: i64 = 0
    while r < n_vocab {
        let v = f32_bits_to_f64(ptr_read_u32_le(val_f32_ptr, r * 4))
        let e = if err_f32_ptr != 0 { f32_bits_to_f64(ptr_read_u32_le(err_f32_ptr, r * 4)) } else { 0.0 }
        if (v + e) >= lower_top1 {
            var dot: f64 = 0.0
            var k: i64 = 0
            while k < in_dim {
                let w = if w_dtype == 2 {
                    bf16_bits_to_f64(ptr_read_u16_le(w_host_ptr, (r * in_dim + k) * 2))
                } else {
                    f32_bits_to_f64(ptr_read_u32_le(w_host_ptr, (r * in_dim + k) * 4))
                }
                let hk = f32_bits_to_f64(ptr_read_u32_le(h_f32_ptr, k * 4))
                dot = dot + w * hk
                k = k + 1
            }
            let _wv = ptr_write_u32_le(val_f32_ptr, r * 4, f64_to_f32_bits(dot))
            if err_f32_ptr != 0 {
                let _we = ptr_write_u32_le(err_f32_ptr, r * 4, 0)
            }
            if !have_best || dot > best_dot {
                best_dot = dot
                best_id = r
                have_best = true
            }
            touched = touched + 1
        }
        r = r + 1
    }
    EisaConeCert {
        top1_id: base.top1_id,
        runner_up_id: base.runner_up_id,
        refined_top1_id: best_id,
        top1_val: base.top1_val,
        top1_err: base.top1_err,
        max_other_upper: base.max_other_upper,
        global_margin: base.global_margin,
        cone_size: base.cone_size,
        bf16_rows_touched: touched,
        strict_global_certified: false,
        refined_exact: true,
    }
}

pub fn emit_eisa_kernels_msl_cstr() -> i64 with Alloc, Mut {
    let buf = heap_alloc(524288) as i64
    if buf == 0 { return 0 }
    var p: i64 = 0
    p = bf16_cstr_append(buf, p, "#include <metal_stdlib>\nusing namespace metal;\n\n")

    p = bf16_cstr_append(buf, p, "inline float eisa_f16_to_f32(ushort h) {\n")
    p = bf16_cstr_append(buf, p, "    uint sign = ((uint)(h & 0x8000)) << 16;\n")
    p = bf16_cstr_append(buf, p, "    uint exp = (h >> 10) & 0x1F;\n")
    p = bf16_cstr_append(buf, p, "    uint mant = h & 0x03FF;\n")
    p = bf16_cstr_append(buf, p, "    if (exp == 31) {\n")
    p = bf16_cstr_append(buf, p, "        uint f_bits = sign | 0x7F800000 | (mant << 13);\n")
    p = bf16_cstr_append(buf, p, "        return as_type<float>(f_bits);\n    }\n")
    p = bf16_cstr_append(buf, p, "    if (exp == 0) {\n")
    p = bf16_cstr_append(buf, p, "        if (mant == 0) return as_type<float>(sign);\n")
    p = bf16_cstr_append(buf, p, "        exp = 1;\n")
    p = bf16_cstr_append(buf, p, "        while ((mant & 0x0400) == 0) { mant = mant << 1; exp = exp - 1; }\n")
    p = bf16_cstr_append(buf, p, "        mant = mant & 0x03FF;\n    }\n")
    p = bf16_cstr_append(buf, p, "    uint exp_f = exp + 112;\n")
    p = bf16_cstr_append(buf, p, "    uint f_bits = sign | (exp_f << 23) | (mant << 13);\n")
    p = bf16_cstr_append(buf, p, "    return as_type<float>(f_bits);\n}\n\n")

    // Kernel 1: qwen3_gemv_q4_eisa
    p = bf16_cstr_append(buf, p, "kernel void qwen3_gemv_q4_eisa(\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* w_base [[buffer(0)]],\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* x_base [[buffer(1)]],\n")
    p = bf16_cstr_append(buf, p, "    device uchar* val_base [[buffer(2)]],\n")
    p = bf16_cstr_append(buf, p, "    device uchar* err_base [[buffer(3)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& w_off [[buffer(4)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& x_off [[buffer(5)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& val_off [[buffer(6)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& err_off [[buffer(7)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& out_dim [[buffer(8)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& in_dim [[buffer(9)]],\n")
    p = bf16_cstr_append(buf, p, "    uint gid [[thread_position_in_grid]], uint lane [[thread_index_in_simdgroup]]) {\n")
    p = bf16_cstr_append(buf, p, "    ulong r = (ulong)gid >> 5;\n")
    p = bf16_cstr_append(buf, p, "    if (r >= out_dim) return;\n")
    p = bf16_cstr_append(buf, p, "    ulong n_blocks = (in_dim + 31) / 32;\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* row_w = w_base + w_off + r * n_blocks * 20;\n")
    p = bf16_cstr_append(buf, p, "    device const float* in_x = (device const float*)(x_base + x_off);\n")
    p = bf16_cstr_append(buf, p, "    device float* out_val = (device float*)(val_base + val_off);\n")
    p = bf16_cstr_append(buf, p, "    device float* out_err = (device float*)(err_base + err_off);\n")
    p = bf16_cstr_append(buf, p, "    float val_acc = 0.0f;\n    float err_acc = 0.0f;\n")
    p = bf16_cstr_append(buf, p, "    for (ulong b = (ulong)lane; b < n_blocks; b = b + 32) {\n")
    p = bf16_cstr_append(buf, p, "        device const uchar* blk = row_w + b * 20;\n")
    p = bf16_cstr_append(buf, p, "        ushort s_bits = (ushort)blk[0] | ((ushort)blk[1] << 8);\n")
    p = bf16_cstr_append(buf, p, "        ushort rho_bits = (ushort)blk[2] | ((ushort)blk[3] << 8);\n")
    p = bf16_cstr_append(buf, p, "        float s = eisa_f16_to_f32(s_bits);\n")
    p = bf16_cstr_append(buf, p, "        float rho = eisa_f16_to_f32(rho_bits);\n")
    p = bf16_cstr_append(buf, p, "        ulong k0 = b * 32;\n")
    p = bf16_cstr_append(buf, p, "        float dot_b = 0.0f; float sq_x_b = 0.0f; float sq_w_b = 0.0f;\n")
    p = bf16_cstr_append(buf, p, "        for (ulong j = 0; j < 16; ++j) {\n")
    p = bf16_cstr_append(buf, p, "            uchar bv = blk[4 + j];\n")
    p = bf16_cstr_append(buf, p, "            float w0 = s * float((int)(bv & 0x0F) - 8);\n")
    p = bf16_cstr_append(buf, p, "            float w1 = s * float((int)((bv >> 4) & 0x0F) - 8);\n")
    p = bf16_cstr_append(buf, p, "            ulong kk = k0 + 2 * j;\n")
    p = bf16_cstr_append(buf, p, "            float x0 = (kk < in_dim) ? in_x[kk] : 0.0f;\n")
    p = bf16_cstr_append(buf, p, "            float x1 = (kk + 1 < in_dim) ? in_x[kk + 1] : 0.0f;\n")
    p = bf16_cstr_append(buf, p, "            dot_b = fma(w0, x0, fma(w1, x1, dot_b));\n")
    p = bf16_cstr_append(buf, p, "            sq_x_b = fma(x0, x0, fma(x1, x1, sq_x_b));\n")
    p = bf16_cstr_append(buf, p, "            sq_w_b = fma(w0, w0, fma(w1, w1, sq_w_b));\n")
    p = bf16_cstr_append(buf, p, "        }\n")
    p = bf16_cstr_append(buf, p, "        float nx = sqrt(sq_x_b);\n")
    p = bf16_cstr_append(buf, p, "        float nw = sqrt(sq_w_b);\n")
    p = bf16_cstr_append(buf, p, "        val_acc = val_acc + dot_b;\n")
    p = bf16_cstr_append(buf, p, "        err_acc = err_acc + rho * nx + 0.00001f * (nw + rho) * nx;\n")
    p = bf16_cstr_append(buf, p, "    }\n")
    p = bf16_cstr_append(buf, p, "    float val_sum = simd_sum(val_acc);\n")
    p = bf16_cstr_append(buf, p, "    float err_sum = simd_sum(err_acc);\n")
    p = bf16_cstr_append(buf, p, "    if (lane == 0) {\n")
    p = bf16_cstr_append(buf, p, "        out_val[r] = val_sum;\n")
    p = bf16_cstr_append(buf, p, "        out_err[r] = err_sum;\n    }\n}\n\n")

    // Kernel 2: qwen3_gemv_q8_eisa
    p = bf16_cstr_append(buf, p, "kernel void qwen3_gemv_q8_eisa(\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* w_base [[buffer(0)]],\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* x_base [[buffer(1)]],\n")
    p = bf16_cstr_append(buf, p, "    device uchar* val_base [[buffer(2)]],\n")
    p = bf16_cstr_append(buf, p, "    device uchar* err_base [[buffer(3)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& w_off [[buffer(4)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& x_off [[buffer(5)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& val_off [[buffer(6)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& err_off [[buffer(7)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& out_dim [[buffer(8)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& in_dim [[buffer(9)]],\n")
    p = bf16_cstr_append(buf, p, "    uint gid [[thread_position_in_grid]], uint lane [[thread_index_in_simdgroup]]) {\n")
    p = bf16_cstr_append(buf, p, "    ulong r = (ulong)gid >> 5;\n")
    p = bf16_cstr_append(buf, p, "    if (r >= out_dim) return;\n")
    p = bf16_cstr_append(buf, p, "    ulong n_blocks = (in_dim + 31) / 32;\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* row_w = w_base + w_off + r * n_blocks * 36;\n")
    p = bf16_cstr_append(buf, p, "    device const float* in_x = (device const float*)(x_base + x_off);\n")
    p = bf16_cstr_append(buf, p, "    device float* out_val = (device float*)(val_base + val_off);\n")
    p = bf16_cstr_append(buf, p, "    device float* out_err = (device float*)(err_base + err_off);\n")
    p = bf16_cstr_append(buf, p, "    float val_acc = 0.0f;\n    float err_acc = 0.0f;\n")
    p = bf16_cstr_append(buf, p, "    for (ulong b = (ulong)lane; b < n_blocks; b = b + 32) {\n")
    p = bf16_cstr_append(buf, p, "        device const uchar* blk = row_w + b * 36;\n")
    p = bf16_cstr_append(buf, p, "        ushort s_bits = (ushort)blk[0] | ((ushort)blk[1] << 8);\n")
    p = bf16_cstr_append(buf, p, "        ushort rho_bits = (ushort)blk[2] | ((ushort)blk[3] << 8);\n")
    p = bf16_cstr_append(buf, p, "        float s = eisa_f16_to_f32(s_bits);\n")
    p = bf16_cstr_append(buf, p, "        float rho = eisa_f16_to_f32(rho_bits);\n")
    p = bf16_cstr_append(buf, p, "        ulong k0 = b * 32;\n")
    p = bf16_cstr_append(buf, p, "        float dot_b = 0.0f; float sq_x_b = 0.0f; float sq_w_b = 0.0f;\n")
    p = bf16_cstr_append(buf, p, "        float nx = 0.0f; float nw = 0.0f;\n")
    p = bf16_cstr_append(buf, p, "        if (k0 + 32 <= in_dim) {\n")
    p = bf16_cstr_append(buf, p, "            device const uint* q4p = (device const uint*)(blk + 4);\n")
    p = bf16_cstr_append(buf, p, "            float dot_q = 0.0f; float sq_q = 0.0f;\n")
    p = bf16_cstr_append(buf, p, "            for (ulong u = 0; u < 8; ++u) {\n")
    p = bf16_cstr_append(buf, p, "                char4 q4 = as_type<char4>(q4p[u]);\n")
    p = bf16_cstr_append(buf, p, "                float x0 = in_x[k0 + u * 4 + 0]; float x1 = in_x[k0 + u * 4 + 1];\n")
    p = bf16_cstr_append(buf, p, "                float x2 = in_x[k0 + u * 4 + 2]; float x3 = in_x[k0 + u * 4 + 3];\n")
    p = bf16_cstr_append(buf, p, "                float q0 = float(q4.x); float q1 = float(q4.y); float q2 = float(q4.z); float q3 = float(q4.w);\n")
    p = bf16_cstr_append(buf, p, "                dot_q = fma(q0, x0, fma(q1, x1, fma(q2, x2, fma(q3, x3, dot_q))));\n")
    p = bf16_cstr_append(buf, p, "                sq_q = fma(q0, q0, fma(q1, q1, fma(q2, q2, fma(q3, q3, sq_q))));\n")
    p = bf16_cstr_append(buf, p, "                sq_x_b = fma(x0, x0, fma(x1, x1, fma(x2, x2, fma(x3, x3, sq_x_b))));\n")
    p = bf16_cstr_append(buf, p, "            }\n")
    p = bf16_cstr_append(buf, p, "            dot_b = s * dot_q;\n")
    p = bf16_cstr_append(buf, p, "            nx = sqrt(sq_x_b);\n")
    p = bf16_cstr_append(buf, p, "            nw = abs(s) * sqrt(sq_q);\n")
    p = bf16_cstr_append(buf, p, "        } else {\n")
    p = bf16_cstr_append(buf, p, "            for (ulong j = 0; j < 32; ++j) {\n")
    p = bf16_cstr_append(buf, p, "                float w = s * float((char)blk[4 + j]);\n")
    p = bf16_cstr_append(buf, p, "                ulong kk = k0 + j;\n")
    p = bf16_cstr_append(buf, p, "                float x = (kk < in_dim) ? in_x[kk] : 0.0f;\n")
    p = bf16_cstr_append(buf, p, "                dot_b = fma(w, x, dot_b);\n")
    p = bf16_cstr_append(buf, p, "                sq_x_b = fma(x, x, sq_x_b);\n")
    p = bf16_cstr_append(buf, p, "                sq_w_b = fma(w, w, sq_w_b);\n")
    p = bf16_cstr_append(buf, p, "            }\n")
    p = bf16_cstr_append(buf, p, "            nx = sqrt(sq_x_b);\n")
    p = bf16_cstr_append(buf, p, "            nw = sqrt(sq_w_b);\n")
    p = bf16_cstr_append(buf, p, "        }\n")
    p = bf16_cstr_append(buf, p, "        val_acc = val_acc + dot_b;\n")
    p = bf16_cstr_append(buf, p, "        err_acc = err_acc + rho * nx + 0.00001f * (nw + rho) * nx;\n")
    p = bf16_cstr_append(buf, p, "    }\n")
    p = bf16_cstr_append(buf, p, "    float val_sum = simd_sum(val_acc);\n")
    p = bf16_cstr_append(buf, p, "    float err_sum = simd_sum(err_acc);\n")
    p = bf16_cstr_append(buf, p, "    if (lane == 0) {\n")
    p = bf16_cstr_append(buf, p, "        out_val[r] = val_sum;\n")
    p = bf16_cstr_append(buf, p, "        out_err[r] = err_sum;\n    }\n}\n\n")

    // Kernel 3: qwen3_quantize_bf16_q4_eisa
    p = bf16_cstr_append(buf, p, "kernel void qwen3_quantize_bf16_q4_eisa(\n    device const uchar* src_base [[buffer(0)]],\n    device uchar* dst_base [[buffer(1)]],\n    constant ulong& src_off [[buffer(2)]],\n    constant ulong& dst_off [[buffer(3)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& out_dim [[buffer(4)]],\n    constant ulong& in_dim [[buffer(5)]],\n    uint gid [[thread_position_in_grid]]) {\n    ulong n_blocks = (in_dim + 31) / 32;\n    if ((ulong)gid >= out_dim * n_blocks) return;\n")
    p = bf16_cstr_append(buf, p, "    ulong r = (ulong)gid / n_blocks;\n    ulong b = (ulong)gid % n_blocks;\n    device const ushort* row_src = (device const ushort*)(src_base + src_off) + r * in_dim;\n    device uchar* blk_dst = dst_base + dst_off + (r * n_blocks + b) * 20;\n")
    p = bf16_cstr_append(buf, p, "    ulong base_k = b * 32;\n    float w[32];\n    float max_abs = 0.0f;\n    for (ulong k = 0; k < 32; ++k) {\n        ulong idx = base_k + k;\n        float val = 0.0f;\n        if (idx < in_dim) {\n            uint ub = ((uint)row_src[idx]) << 16;\n")
    p = bf16_cstr_append(buf, p, "            val = as_type<float>(ub);\n        }\n        w[k] = val;\n        float a = abs(val);\n        if (a > max_abs) max_abs = a;\n    }\n    ushort s_bits = (max_abs > 0.0f) ? as_type<ushort>(half(max_abs / 7.0f)) : 0;\n")
    p = bf16_cstr_append(buf, p, "    float s_f = eisa_f16_to_f32(s_bits);\n    float inv_s = (s_f > 0.0f) ? (1.0f / s_f) : 0.0f;\n    char q[32];\n    float sum_sq_err = 0.0f;\n    for (ulong k = 0; k < 32; ++k) {\n        float sc = w[k] * inv_s;\n")
    p = bf16_cstr_append(buf, p, "        int qi = (sc >= 0.0f) ? int(sc + 0.5f) : int(sc - 0.5f);\n        if (qi > 7) qi = 7;\n        if (qi < -8) qi = -8;\n        q[k] = (char)qi;\n        float w_rec = s_f * float(qi);\n        float diff = w[k] - w_rec;\n        sum_sq_err = sum_sq_err + diff * diff;\n    }\n")
    p = bf16_cstr_append(buf, p, "    uchar nibbles[16];\n    for (ulong i = 0; i < 16; ++i) {\n        uchar lo = (uchar)(q[i * 2 + 0] + 8) & 0x0F;\n        uchar hi = (uchar)(q[i * 2 + 1] + 8) & 0x0F;\n        nibbles[i] = lo | (hi << 4);\n    }\n")
    p = bf16_cstr_append(buf, p, "    float exact_l2 = sqrt(sum_sq_err);\n    ushort rho_bits = (exact_l2 > 0.0f) ? as_type<ushort>(half(exact_l2)) : 0;\n    if (exact_l2 > 0.0f) {\n        if (rho_bits == 0) rho_bits = 1;\n        while (eisa_f16_to_f32(rho_bits) < exact_l2 && rho_bits < 31743u) {\n            rho_bits = rho_bits + 1;\n        }\n    }\n")
    p = bf16_cstr_append(buf, p, "    blk_dst[0] = (uchar)(s_bits & 0xFF);\n    blk_dst[1] = (uchar)((s_bits >> 8) & 0xFF);\n    blk_dst[2] = (uchar)(rho_bits & 0xFF);\n    blk_dst[3] = (uchar)((rho_bits >> 8) & 0xFF);\n    for (ulong i = 0; i < 16; ++i) blk_dst[4 + i] = nibbles[i];\n}\n\n")

    // Kernel 4: qwen3_quantize_f32_q4_eisa
    p = bf16_cstr_append(buf, p, "kernel void qwen3_quantize_f32_q4_eisa(\n    device const uchar* src_base [[buffer(0)]],\n    device uchar* dst_base [[buffer(1)]],\n    constant ulong& src_off [[buffer(2)]],\n    constant ulong& dst_off [[buffer(3)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& out_dim [[buffer(4)]],\n    constant ulong& in_dim [[buffer(5)]],\n    uint gid [[thread_position_in_grid]]) {\n    ulong n_blocks = (in_dim + 31) / 32;\n    if ((ulong)gid >= out_dim * n_blocks) return;\n")
    p = bf16_cstr_append(buf, p, "    ulong r = (ulong)gid / n_blocks;\n    ulong b = (ulong)gid % n_blocks;\n    device const float* row_src = (device const float*)(src_base + src_off) + r * in_dim;\n    device uchar* blk_dst = dst_base + dst_off + (r * n_blocks + b) * 20;\n")
    p = bf16_cstr_append(buf, p, "    ulong base_k = b * 32;\n    float w[32];\n    float max_abs = 0.0f;\n    for (ulong k = 0; k < 32; ++k) {\n        ulong idx = base_k + k;\n        float val = (idx < in_dim) ? row_src[idx] : 0.0f;\n        w[k] = val;\n        float a = abs(val);\n        if (a > max_abs) max_abs = a;\n    }\n")
    p = bf16_cstr_append(buf, p, "    ushort s_bits = (max_abs > 0.0f) ? as_type<ushort>(half(max_abs / 7.0f)) : 0;\n    float s_f = eisa_f16_to_f32(s_bits);\n    float inv_s = (s_f > 0.0f) ? (1.0f / s_f) : 0.0f;\n    char q[32];\n    float sum_sq_err = 0.0f;\n    for (ulong k = 0; k < 32; ++k) {\n        float sc = w[k] * inv_s;\n")
    p = bf16_cstr_append(buf, p, "        int qi = (sc >= 0.0f) ? int(sc + 0.5f) : int(sc - 0.5f);\n        if (qi > 7) qi = 7;\n        if (qi < -8) qi = -8;\n        q[k] = (char)qi;\n        float w_rec = s_f * float(qi);\n        float diff = w[k] - w_rec;\n        sum_sq_err = sum_sq_err + diff * diff;\n    }\n")
    p = bf16_cstr_append(buf, p, "    uchar nibbles[16];\n    for (ulong i = 0; i < 16; ++i) {\n        uchar lo = (uchar)(q[i * 2 + 0] + 8) & 0x0F;\n        uchar hi = (uchar)(q[i * 2 + 1] + 8) & 0x0F;\n        nibbles[i] = lo | (hi << 4);\n    }\n")
    p = bf16_cstr_append(buf, p, "    float exact_l2 = sqrt(sum_sq_err);\n    ushort rho_bits = (exact_l2 > 0.0f) ? as_type<ushort>(half(exact_l2)) : 0;\n    if (exact_l2 > 0.0f) {\n        if (rho_bits == 0) rho_bits = 1;\n        while (eisa_f16_to_f32(rho_bits) < exact_l2 && rho_bits < 31743u) {\n            rho_bits = rho_bits + 1;\n        }\n    }\n")
    p = bf16_cstr_append(buf, p, "    blk_dst[0] = (uchar)(s_bits & 0xFF);\n    blk_dst[1] = (uchar)((s_bits >> 8) & 0xFF);\n    blk_dst[2] = (uchar)(rho_bits & 0xFF);\n    blk_dst[3] = (uchar)((rho_bits >> 8) & 0xFF);\n    for (ulong i = 0; i < 16; ++i) blk_dst[4 + i] = nibbles[i];\n}\n\n")

    // Kernels 5/6: GPU Q8_EISA quantizers
    p = bf16_cstr_append(buf, p, "kernel void qwen3_quantize_bf16_q8_eisa(\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* src_base [[buffer(0)]], device uchar* dst_base [[buffer(1)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& src_off [[buffer(2)]], constant ulong& dst_off [[buffer(3)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& out_dim [[buffer(4)]], constant ulong& in_dim [[buffer(5)]],\n")
    p = bf16_cstr_append(buf, p, "    uint gid [[thread_position_in_grid]]) {\n")
    p = bf16_cstr_append(buf, p, "    ulong n_blocks = (in_dim + 31) / 32;\n")
    p = bf16_cstr_append(buf, p, "    if ((ulong)gid >= out_dim * n_blocks) return;\n")
    p = bf16_cstr_append(buf, p, "    ulong r = (ulong)gid / n_blocks;\n    ulong b = (ulong)gid % n_blocks;\n")
    p = bf16_cstr_append(buf, p, "    device const ushort* row_src = (device const ushort*)(src_base + src_off) + r * in_dim;\n")
    p = bf16_cstr_append(buf, p, "    device uchar* blk_dst = dst_base + dst_off + (r * n_blocks + b) * 36;\n")
    p = bf16_cstr_append(buf, p, "    ulong base_k = b * 32;\n    float w[32];\n    float max_abs = 0.0f;\n")
    p = bf16_cstr_append(buf, p, "    for (ulong k = 0; k < 32; ++k) {\n")
    p = bf16_cstr_append(buf, p, "        ulong idx = base_k + k;\n")
    p = bf16_cstr_append(buf, p, "        float val = (idx < in_dim) ? as_type<float>(((uint)row_src[idx]) << 16) : 0.0f;\n")
    p = bf16_cstr_append(buf, p, "        w[k] = val;\n        float a = abs(val);\n        if (a > max_abs) max_abs = a;\n    }\n")
    p = bf16_cstr_append(buf, p, "    ushort s_bits = (max_abs > 0.0f) ? as_type<ushort>(half(max_abs / 127.0f)) : 0;\n")
    p = bf16_cstr_append(buf, p, "    float s_f = eisa_f16_to_f32(s_bits);\n")
    p = bf16_cstr_append(buf, p, "    float sum_sq_err = 0.0f;\n")
    p = bf16_cstr_append(buf, p, "    for (ulong k = 0; k < 32; ++k) {\n")
    p = bf16_cstr_append(buf, p, "        int qi = 0;\n")
    p = bf16_cstr_append(buf, p, "        if (s_f > 0.0f) {\n")
    p = bf16_cstr_append(buf, p, "            float sc = w[k] / s_f;\n")
    p = bf16_cstr_append(buf, p, "            qi = (sc >= 0.0f) ? int(sc + 0.5f) : int(sc - 0.5f);\n")
    p = bf16_cstr_append(buf, p, "            if (qi > 127) qi = 127;\n            if (qi < -127) qi = -127;\n")
    p = bf16_cstr_append(buf, p, "        }\n")
    p = bf16_cstr_append(buf, p, "        float diff = w[k] - s_f * float(qi);\n")
    p = bf16_cstr_append(buf, p, "        sum_sq_err = sum_sq_err + diff * diff;\n")
    p = bf16_cstr_append(buf, p, "        blk_dst[4 + k] = (uchar)(qi & 255);\n    }\n")
    p = bf16_cstr_append(buf, p, "    float exact_l2 = sqrt(sum_sq_err);\n")
    p = bf16_cstr_append(buf, p, "    ushort rho_bits = (exact_l2 > 0.0f) ? as_type<ushort>(half(exact_l2)) : 0;\n")
    p = bf16_cstr_append(buf, p, "    if (exact_l2 > 0.0f) {\n        if (rho_bits == 0) rho_bits = 1;\n")
    p = bf16_cstr_append(buf, p, "        while (eisa_f16_to_f32(rho_bits) < exact_l2 && rho_bits < 31743u) { rho_bits = rho_bits + 1; }\n    }\n")
    p = bf16_cstr_append(buf, p, "    blk_dst[0] = (uchar)(s_bits & 0xFF);\n    blk_dst[1] = (uchar)((s_bits >> 8) & 0xFF);\n")
    p = bf16_cstr_append(buf, p, "    blk_dst[2] = (uchar)(rho_bits & 0xFF);\n    blk_dst[3] = (uchar)((rho_bits >> 8) & 0xFF);\n}\n\n")
    p = bf16_cstr_append(buf, p, "kernel void qwen3_quantize_f32_q8_eisa(\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* src_base [[buffer(0)]], device uchar* dst_base [[buffer(1)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& src_off [[buffer(2)]], constant ulong& dst_off [[buffer(3)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& out_dim [[buffer(4)]], constant ulong& in_dim [[buffer(5)]],\n")
    p = bf16_cstr_append(buf, p, "    uint gid [[thread_position_in_grid]]) {\n")
    p = bf16_cstr_append(buf, p, "    ulong n_blocks = (in_dim + 31) / 32;\n")
    p = bf16_cstr_append(buf, p, "    if ((ulong)gid >= out_dim * n_blocks) return;\n")
    p = bf16_cstr_append(buf, p, "    ulong r = (ulong)gid / n_blocks;\n    ulong b = (ulong)gid % n_blocks;\n")
    p = bf16_cstr_append(buf, p, "    device const float* row_src = (device const float*)(src_base + src_off) + r * in_dim;\n")
    p = bf16_cstr_append(buf, p, "    device uchar* blk_dst = dst_base + dst_off + (r * n_blocks + b) * 36;\n")
    p = bf16_cstr_append(buf, p, "    ulong base_k = b * 32;\n    float w[32];\n    float max_abs = 0.0f;\n")
    p = bf16_cstr_append(buf, p, "    for (ulong k = 0; k < 32; ++k) {\n")
    p = bf16_cstr_append(buf, p, "        ulong idx = base_k + k;\n")
    p = bf16_cstr_append(buf, p, "        float val = (idx < in_dim) ? row_src[idx] : 0.0f;\n")
    p = bf16_cstr_append(buf, p, "        w[k] = val;\n        float a = abs(val);\n        if (a > max_abs) max_abs = a;\n    }\n")
    p = bf16_cstr_append(buf, p, "    ushort s_bits = (max_abs > 0.0f) ? as_type<ushort>(half(max_abs / 127.0f)) : 0;\n")
    p = bf16_cstr_append(buf, p, "    float s_f = eisa_f16_to_f32(s_bits);\n")
    p = bf16_cstr_append(buf, p, "    float sum_sq_err = 0.0f;\n")
    p = bf16_cstr_append(buf, p, "    for (ulong k = 0; k < 32; ++k) {\n")
    p = bf16_cstr_append(buf, p, "        int qi = 0;\n")
    p = bf16_cstr_append(buf, p, "        if (s_f > 0.0f) {\n")
    p = bf16_cstr_append(buf, p, "            float sc = w[k] / s_f;\n")
    p = bf16_cstr_append(buf, p, "            qi = (sc >= 0.0f) ? int(sc + 0.5f) : int(sc - 0.5f);\n")
    p = bf16_cstr_append(buf, p, "            if (qi > 127) qi = 127;\n            if (qi < -127) qi = -127;\n")
    p = bf16_cstr_append(buf, p, "        }\n")
    p = bf16_cstr_append(buf, p, "        float diff = w[k] - s_f * float(qi);\n")
    p = bf16_cstr_append(buf, p, "        sum_sq_err = sum_sq_err + diff * diff;\n")
    p = bf16_cstr_append(buf, p, "        blk_dst[4 + k] = (uchar)(qi & 255);\n    }\n")
    p = bf16_cstr_append(buf, p, "    float exact_l2 = sqrt(sum_sq_err);\n")
    p = bf16_cstr_append(buf, p, "    ushort rho_bits = (exact_l2 > 0.0f) ? as_type<ushort>(half(exact_l2)) : 0;\n")
    p = bf16_cstr_append(buf, p, "    if (exact_l2 > 0.0f) {\n        if (rho_bits == 0) rho_bits = 1;\n")
    p = bf16_cstr_append(buf, p, "        while (eisa_f16_to_f32(rho_bits) < exact_l2 && rho_bits < 31743u) { rho_bits = rho_bits + 1; }\n    }\n")
    p = bf16_cstr_append(buf, p, "    blk_dst[0] = (uchar)(s_bits & 0xFF);\n    blk_dst[1] = (uchar)((s_bits >> 8) & 0xFF);\n")
    p = bf16_cstr_append(buf, p, "    blk_dst[2] = (uchar)(rho_bits & 0xFF);\n    blk_dst[3] = (uchar)((rho_bits >> 8) & 0xFF);\n}\n\n")

    // Kernel 7/8: GPU global certifier + sparse cone refiners
    p = bf16_cstr_append(buf, p, "kernel void qwen3_eisa_certify_global_f32(\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* val_base [[buffer(0)]], device const uchar* err_base [[buffer(1)]],\n")
    p = bf16_cstr_append(buf, p, "    device uchar* out_base [[buffer(2)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& val_off [[buffer(3)]], constant ulong& err_off [[buffer(4)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& out_off [[buffer(5)]], constant ulong& vocab [[buffer(6)]],\n")
    p = bf16_cstr_append(buf, p, "    uint tid [[thread_index_in_threadgroup]]) {\n")
    p = bf16_cstr_append(buf, p, "    threadgroup float tv1[256]; threadgroup float tv2[256];\n")
    p = bf16_cstr_append(buf, p, "    threadgroup ulong ti1[256]; threadgroup ulong ti2[256];\n")
    p = bf16_cstr_append(buf, p, "    threadgroup ulong tc[256]; threadgroup float tmo[256];\n")
    p = bf16_cstr_append(buf, p, "    threadgroup ulong tg_top1_id; threadgroup ulong tg_runner;\n")
    p = bf16_cstr_append(buf, p, "    threadgroup float tg_top1_val; threadgroup float tg_top1_err; threadgroup float tg_lower;\n")
    p = bf16_cstr_append(buf, p, "    device const float* vl = (device const float*)(val_base + val_off);\n")
    p = bf16_cstr_append(buf, p, "    device const float* er = (device const float*)(err_base + err_off);\n")
    p = bf16_cstr_append(buf, p, "    float v1 = -INFINITY; float v2 = -INFINITY;\n")
    p = bf16_cstr_append(buf, p, "    ulong i1 = 0xFFFFFFFFFFFFFFFFul; ulong i2 = 0xFFFFFFFFFFFFFFFFul;\n")
    p = bf16_cstr_append(buf, p, "    for (ulong i = (ulong)tid; i < vocab; i = i + 256) {\n")
    p = bf16_cstr_append(buf, p, "        float v = vl[i];\n")
    p = bf16_cstr_append(buf, p, "        if (v > v1) { v2 = v1; i2 = i1; v1 = v; i1 = i; }\n")
    p = bf16_cstr_append(buf, p, "        else if (v > v2) { v2 = v; i2 = i; }\n")
    p = bf16_cstr_append(buf, p, "    }\n")
    p = bf16_cstr_append(buf, p, "    tv1[tid] = v1; tv2[tid] = v2; ti1[tid] = i1; ti2[tid] = i2;\n")
    p = bf16_cstr_append(buf, p, "    threadgroup_barrier(mem_flags::mem_threadgroup);\n")
    p = bf16_cstr_append(buf, p, "    if (tid == 0) {\n")
    p = bf16_cstr_append(buf, p, "        float b1 = -INFINITY; float b2 = -INFINITY;\n")
    p = bf16_cstr_append(buf, p, "        ulong j1 = 0xFFFFFFFFFFFFFFFFul; ulong j2 = 0xFFFFFFFFFFFFFFFFul;\n")
    p = bf16_cstr_append(buf, p, "        for (uint l = 0; l < 512; ++l) {\n")
    p = bf16_cstr_append(buf, p, "            float v = (l < 256) ? tv1[l] : tv2[l - 256];\n")
    p = bf16_cstr_append(buf, p, "            ulong ix = (l < 256) ? ti1[l] : ti2[l - 256];\n")
    p = bf16_cstr_append(buf, p, "            if (ix == 0xFFFFFFFFFFFFFFFFul) continue;\n")
    p = bf16_cstr_append(buf, p, "            if (v > b1 || (v == b1 && ix < j1)) { b2 = b1; j2 = j1; b1 = v; j1 = ix; }\n")
    p = bf16_cstr_append(buf, p, "            else if (v > b2 || (v == b2 && ix < j2)) { b2 = v; j2 = ix; }\n")
    p = bf16_cstr_append(buf, p, "        }\n")
    p = bf16_cstr_append(buf, p, "        tg_top1_id = j1; tg_runner = j2;\n")
    p = bf16_cstr_append(buf, p, "        tg_top1_val = vl[j1]; tg_top1_err = er[j1];\n")
    p = bf16_cstr_append(buf, p, "        tg_lower = tg_top1_val - tg_top1_err;\n")
    p = bf16_cstr_append(buf, p, "    }\n")
    p = bf16_cstr_append(buf, p, "    threadgroup_barrier(mem_flags::mem_threadgroup);\n")
    p = bf16_cstr_append(buf, p, "    ulong cone_cnt = 0; float mo = -INFINITY;\n")
    p = bf16_cstr_append(buf, p, "    for (ulong i = (ulong)tid; i < vocab; i = i + 256) {\n")
    p = bf16_cstr_append(buf, p, "        float up = vl[i] + er[i];\n")
    p = bf16_cstr_append(buf, p, "        if (up >= tg_lower) { cone_cnt = cone_cnt + 1; }\n")
    p = bf16_cstr_append(buf, p, "        if (i != tg_top1_id) { mo = max(mo, up); }\n")
    p = bf16_cstr_append(buf, p, "    }\n")
    p = bf16_cstr_append(buf, p, "    tc[tid] = cone_cnt; tmo[tid] = mo;\n")
    p = bf16_cstr_append(buf, p, "    threadgroup_barrier(mem_flags::mem_threadgroup);\n")
    p = bf16_cstr_append(buf, p, "    if (tid == 0) {\n")
    p = bf16_cstr_append(buf, p, "        ulong total_cone = 0; float max_other = -INFINITY;\n")
    p = bf16_cstr_append(buf, p, "        for (uint l = 0; l < 256; ++l) {\n")
    p = bf16_cstr_append(buf, p, "            total_cone = total_cone + tc[l];\n")
    p = bf16_cstr_append(buf, p, "            max_other = max(max_other, tmo[l]);\n")
    p = bf16_cstr_append(buf, p, "        }\n")
    p = bf16_cstr_append(buf, p, "        if (vocab <= 1) max_other = 0.0f;\n")
    p = bf16_cstr_append(buf, p, "        float g_margin = tg_lower - max_other;\n")
    p = bf16_cstr_append(buf, p, "        ulong cert_flag = (vocab == 1 || g_margin > 0.0f) ? 1ul : 0ul;\n")
    p = bf16_cstr_append(buf, p, "        ulong final_cone = (cert_flag == 1ul) ? 1ul : total_cone;\n")
    p = bf16_cstr_append(buf, p, "        device ulong* o64 = (device ulong*)(out_base + out_off);\n")
    p = bf16_cstr_append(buf, p, "        o64[0] = tg_top1_id; o64[1] = tg_runner; o64[2] = final_cone; o64[3] = cert_flag;\n")
    p = bf16_cstr_append(buf, p, "        device uint* o32 = (device uint*)(out_base + out_off + 32);\n")
    p = bf16_cstr_append(buf, p, "        o32[0] = as_type<uint>(tg_top1_val); o32[1] = as_type<uint>(tg_top1_err);\n")
    p = bf16_cstr_append(buf, p, "        o32[2] = as_type<uint>(max_other); o32[3] = as_type<uint>(g_margin);\n")
    p = bf16_cstr_append(buf, p, "    }\n")
    p = bf16_cstr_append(buf, p, "}\n")
    p = bf16_cstr_append(buf, p, "\n")
    p = bf16_cstr_append(buf, p, "kernel void qwen3_eisa_cone_refine_bf16(\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* w_base [[buffer(0)]], device const uchar* x_base [[buffer(1)]],\n")
    p = bf16_cstr_append(buf, p, "    device uchar* val_base [[buffer(2)]], device uchar* err_base [[buffer(3)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& w_off [[buffer(4)]], constant ulong& x_off [[buffer(5)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& val_off [[buffer(6)]], constant ulong& err_off [[buffer(7)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& out_dim [[buffer(8)]], constant ulong& in_dim [[buffer(9)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& lower_bits [[buffer(10)]],\n")
    p = bf16_cstr_append(buf, p, "    uint gid [[thread_position_in_grid]], uint lane [[thread_index_in_simdgroup]]) {\n")
    p = bf16_cstr_append(buf, p, "    ulong row = (ulong)gid >> 5;\n")
    p = bf16_cstr_append(buf, p, "    if (row >= out_dim) return;\n")
    p = bf16_cstr_append(buf, p, "    device float* vl = (device float*)(val_base + val_off);\n")
    p = bf16_cstr_append(buf, p, "    device float* er = (device float*)(err_base + err_off);\n")
    p = bf16_cstr_append(buf, p, "    float lower_top1 = as_type<float>((uint)lower_bits);\n")
    p = bf16_cstr_append(buf, p, "    if ((vl[row] + er[row]) < lower_top1) return;\n")
    p = bf16_cstr_append(buf, p, "    device const float* in_x = (device const float*)(x_base + x_off);\n")
    p = bf16_cstr_append(buf, p, "    float sum = 0.0f;\n")
    p = bf16_cstr_append(buf, p, "    device const ushort* row_w = (device const ushort*)(w_base + w_off) + row * in_dim;\n")
    p = bf16_cstr_append(buf, p, "    if ((((ulong)row_w) & 7ul) == 0) {\n")
    p = bf16_cstr_append(buf, p, "        for (ulong k = (ulong)lane * 4; k + 3 < in_dim; k = k + 128) {\n")
    p = bf16_cstr_append(buf, p, "            ulong w4 = *((device const ulong*)(row_w + k));\n")
    p = bf16_cstr_append(buf, p, "            uint w_lo = (uint)w4; uint w_hi = (uint)(w4 >> 32);\n")
    p = bf16_cstr_append(buf, p, "            sum = fma(as_type<float>(w_lo << 16), in_x[k + 0], sum);\n")
    p = bf16_cstr_append(buf, p, "            sum = fma(as_type<float>(w_lo & 0xFFFF0000u), in_x[k + 1], sum);\n")
    p = bf16_cstr_append(buf, p, "            sum = fma(as_type<float>(w_hi << 16), in_x[k + 2], sum);\n")
    p = bf16_cstr_append(buf, p, "            sum = fma(as_type<float>(w_hi & 0xFFFF0000u), in_x[k + 3], sum);\n")
    p = bf16_cstr_append(buf, p, "        }\n")
    p = bf16_cstr_append(buf, p, "    } else {\n")
    p = bf16_cstr_append(buf, p, "        for (ulong k = (ulong)lane * 4; k + 3 < in_dim; k = k + 128) {\n")
    p = bf16_cstr_append(buf, p, "            sum = fma(as_type<float>(((uint)row_w[k + 0]) << 16), in_x[k + 0], sum);\n")
    p = bf16_cstr_append(buf, p, "            sum = fma(as_type<float>(((uint)row_w[k + 1]) << 16), in_x[k + 1], sum);\n")
    p = bf16_cstr_append(buf, p, "            sum = fma(as_type<float>(((uint)row_w[k + 2]) << 16), in_x[k + 2], sum);\n")
    p = bf16_cstr_append(buf, p, "            sum = fma(as_type<float>(((uint)row_w[k + 3]) << 16), in_x[k + 3], sum);\n")
    p = bf16_cstr_append(buf, p, "        }\n")
    p = bf16_cstr_append(buf, p, "    }\n")
    p = bf16_cstr_append(buf, p, "    for (ulong k_tail = (in_dim & ~3ULL) + (ulong)lane; k_tail < in_dim; k_tail = k_tail + 32) {\n")
    p = bf16_cstr_append(buf, p, "        sum = fma(as_type<float>(((uint)row_w[k_tail]) << 16), in_x[k_tail], sum);\n")
    p = bf16_cstr_append(buf, p, "    }\n")
    p = bf16_cstr_append(buf, p, "    sum = simd_sum(sum);\n")
    p = bf16_cstr_append(buf, p, "    if (lane == 0) {\n")
    p = bf16_cstr_append(buf, p, "        vl[row] = sum;\n")
    p = bf16_cstr_append(buf, p, "        er[row] = 0.0f;\n")
    p = bf16_cstr_append(buf, p, "    }\n")
    p = bf16_cstr_append(buf, p, "}\n")
    p = bf16_cstr_append(buf, p, "\n")
    p = bf16_cstr_append(buf, p, "kernel void qwen3_eisa_cone_refine_f32(\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* w_base [[buffer(0)]], device const uchar* x_base [[buffer(1)]],\n")
    p = bf16_cstr_append(buf, p, "    device uchar* val_base [[buffer(2)]], device uchar* err_base [[buffer(3)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& w_off [[buffer(4)]], constant ulong& x_off [[buffer(5)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& val_off [[buffer(6)]], constant ulong& err_off [[buffer(7)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& out_dim [[buffer(8)]], constant ulong& in_dim [[buffer(9)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& lower_bits [[buffer(10)]],\n")
    p = bf16_cstr_append(buf, p, "    uint gid [[thread_position_in_grid]], uint lane [[thread_index_in_simdgroup]]) {\n")
    p = bf16_cstr_append(buf, p, "    ulong row = (ulong)gid >> 5;\n")
    p = bf16_cstr_append(buf, p, "    if (row >= out_dim) return;\n")
    p = bf16_cstr_append(buf, p, "    device float* vl = (device float*)(val_base + val_off);\n")
    p = bf16_cstr_append(buf, p, "    device float* er = (device float*)(err_base + err_off);\n")
    p = bf16_cstr_append(buf, p, "    float lower_top1 = as_type<float>((uint)lower_bits);\n")
    p = bf16_cstr_append(buf, p, "    if ((vl[row] + er[row]) < lower_top1) return;\n")
    p = bf16_cstr_append(buf, p, "    device const float* in_x = (device const float*)(x_base + x_off);\n")
    p = bf16_cstr_append(buf, p, "    float sum = 0.0f;\n")
    p = bf16_cstr_append(buf, p, "    device const float* row_w = (device const float*)(w_base + w_off) + row * in_dim;\n")
    p = bf16_cstr_append(buf, p, "    for (ulong k = (ulong)lane * 4; k + 3 < in_dim; k = k + 128) {\n")
    p = bf16_cstr_append(buf, p, "        sum = fma(row_w[k], in_x[k + 0], sum);\n")
    p = bf16_cstr_append(buf, p, "        sum = fma(row_w[k + 1], in_x[k + 1], sum);\n")
    p = bf16_cstr_append(buf, p, "        sum = fma(row_w[k + 2], in_x[k + 2], sum);\n")
    p = bf16_cstr_append(buf, p, "        sum = fma(row_w[k + 3], in_x[k + 3], sum);\n")
    p = bf16_cstr_append(buf, p, "    }\n")
    p = bf16_cstr_append(buf, p, "    for (ulong k_tail = (in_dim & ~3ULL) + (ulong)lane; k_tail < in_dim; k_tail = k_tail + 32) {\n")
    p = bf16_cstr_append(buf, p, "        sum = fma(row_w[k_tail], in_x[k_tail], sum);\n")
    p = bf16_cstr_append(buf, p, "    }\n")
    p = bf16_cstr_append(buf, p, "    sum = simd_sum(sum);\n")
    p = bf16_cstr_append(buf, p, "    if (lane == 0) {\n")
    p = bf16_cstr_append(buf, p, "        vl[row] = sum;\n")
    p = bf16_cstr_append(buf, p, "        er[row] = 0.0f;\n")
    p = bf16_cstr_append(buf, p, "    }\n")
    p = bf16_cstr_append(buf, p, "}\n")
    p = bf16_cstr_append(buf, p, "\n")

    // Inline row dot helpers for Q8 fast GEMV, tiled head & fused kernels
    p = bf16_cstr_append(buf, p, "inline float qwen3_q8_row_dot_dev(device const uchar* row_w, device const float* in_x, ulong in_dim, ulong n_blocks, ulong lane) {\n")
    p = bf16_cstr_append(buf, p, "    float acc = 0.0f; ulong k4 = (ulong)(lane & 7); ulong b_lane = (ulong)(lane >> 3);\n")
    p = bf16_cstr_append(buf, p, "    if ((in_dim & 127ul) == 0 && (((ulong)row_w) & 3ul) == 0) {\n")
    p = bf16_cstr_append(buf, p, "        for (ulong b_base = 0; b_base < n_blocks; b_base = b_base + 4) {\n")
    p = bf16_cstr_append(buf, p, "            ulong b = b_base + b_lane; device const uchar* blk = row_w + b * 36;\n")
    p = bf16_cstr_append(buf, p, "            float s = float(as_type<half>(*((device const ushort*)blk)));\n")
    p = bf16_cstr_append(buf, p, "            char4 q4 = as_type<char4>(((device const uint*)(blk + 4))[k4]); ulong k0 = (b << 5) + (k4 << 2);\n")
    p = bf16_cstr_append(buf, p, "            float dot4 = fma((float)q4.x, in_x[k0 + 0], fma((float)q4.y, in_x[k0 + 1], fma((float)q4.z, in_x[k0 + 2], (float)q4.w * in_x[k0 + 3])));\n")
    p = bf16_cstr_append(buf, p, "            acc = fma(s, dot4, acc);\n")
    p = bf16_cstr_append(buf, p, "        }\n    } else {\n")
    p = bf16_cstr_append(buf, p, "        for (ulong b_base = 0; b_base < n_blocks; b_base = b_base + 4) {\n")
    p = bf16_cstr_append(buf, p, "            ulong b = b_base + b_lane;\n")
    p = bf16_cstr_append(buf, p, "            if (b < n_blocks) {\n")
    p = bf16_cstr_append(buf, p, "                device const uchar* blk = row_w + b * 36;\n")
    p = bf16_cstr_append(buf, p, "                float s = eisa_f16_to_f32((ushort)blk[0] | ((ushort)blk[1] << 8)); ulong k0 = (b << 5) + (k4 << 2); float dot4 = 0.0f;\n")
    p = bf16_cstr_append(buf, p, "                for (ulong j = 0; j < 4; ++j) { ulong kk = k0 + j; if (kk < in_dim) dot4 = fma((float)((char)blk[4 + k4 * 4 + j]), in_x[kk], dot4); }\n")
    p = bf16_cstr_append(buf, p, "                acc = fma(s, dot4, acc);\n")
    p = bf16_cstr_append(buf, p, "            }\n        }\n    }\n    return simd_sum(acc);\n}\n\n")

    p = bf16_cstr_append(buf, p, "inline float qwen3_q8_row_dot_tg(device const uchar* row_w, threadgroup const float* tg_x, ulong in_dim, ulong n_blocks, ulong lane) {\n")
    p = bf16_cstr_append(buf, p, "    float acc = 0.0f; ulong k4 = (ulong)(lane & 7); ulong b_lane = (ulong)(lane >> 3);\n")
    p = bf16_cstr_append(buf, p, "    if ((in_dim & 127ul) == 0 && (((ulong)row_w) & 3ul) == 0) {\n")
    p = bf16_cstr_append(buf, p, "        for (ulong b_base = 0; b_base < n_blocks; b_base = b_base + 4) {\n")
    p = bf16_cstr_append(buf, p, "            ulong b = b_base + b_lane; device const uchar* blk = row_w + b * 36;\n")
    p = bf16_cstr_append(buf, p, "            float s = float(as_type<half>(*((device const ushort*)blk)));\n")
    p = bf16_cstr_append(buf, p, "            char4 q4 = as_type<char4>(((device const uint*)(blk + 4))[k4]); ulong k0 = (b << 5) + (k4 << 2);\n")
    p = bf16_cstr_append(buf, p, "            float dot4 = fma((float)q4.x, tg_x[k0 + 0], fma((float)q4.y, tg_x[k0 + 1], fma((float)q4.z, tg_x[k0 + 2], (float)q4.w * tg_x[k0 + 3])));\n")
    p = bf16_cstr_append(buf, p, "            acc = fma(s, dot4, acc);\n")
    p = bf16_cstr_append(buf, p, "        }\n    } else {\n")
    p = bf16_cstr_append(buf, p, "        for (ulong b_base = 0; b_base < n_blocks; b_base = b_base + 4) {\n")
    p = bf16_cstr_append(buf, p, "            ulong b = b_base + b_lane;\n")
    p = bf16_cstr_append(buf, p, "            if (b < n_blocks) {\n")
    p = bf16_cstr_append(buf, p, "                device const uchar* blk = row_w + b * 36;\n")
    p = bf16_cstr_append(buf, p, "                float s = eisa_f16_to_f32((ushort)blk[0] | ((ushort)blk[1] << 8)); ulong k0 = (b << 5) + (k4 << 2); float dot4 = 0.0f;\n")
    p = bf16_cstr_append(buf, p, "                for (ulong j = 0; j < 4; ++j) { ulong kk = k0 + j; if (kk < in_dim) dot4 = fma((float)((char)blk[4 + k4 * 4 + j]), tg_x[kk], dot4); }\n")
    p = bf16_cstr_append(buf, p, "                acc = fma(s, dot4, acc);\n")
    p = bf16_cstr_append(buf, p, "            }\n        }\n    }\n    return simd_sum(acc);\n}\n\n")

    p = bf16_cstr_append(buf, p, "inline float qwen3_q8_blk_sub(device const uchar* blk, float4 x0, ulong k4, bool aligned) {\n")
    p = bf16_cstr_append(buf, p, "    if (aligned) {\n")
    p = bf16_cstr_append(buf, p, "        float s = float(as_type<half>(*((device const ushort*)blk)));\n")
    p = bf16_cstr_append(buf, p, "        char4 q4 = as_type<char4>(((device const uint*)(blk + 4))[k4]);\n")
    p = bf16_cstr_append(buf, p, "        float dot4 = fma((float)q4.x, x0.x, (float)q4.y * x0.y) + fma((float)q4.z, x0.z, (float)q4.w * x0.w);\n")
    p = bf16_cstr_append(buf, p, "        return s * dot4;\n")
    p = bf16_cstr_append(buf, p, "    }\n")
    p = bf16_cstr_append(buf, p, "    float s = eisa_f16_to_f32((ushort)blk[0] | ((ushort)blk[1] << 8)); ulong j0 = k4 << 2;\n")
    p = bf16_cstr_append(buf, p, "    float dot4 = fma((float)((char)blk[4+j0+0]), x0.x, (float)((char)blk[4+j0+1]) * x0.y) + fma((float)((char)blk[4+j0+2]), x0.z, (float)((char)blk[4+j0+3]) * x0.w);\n")
    p = bf16_cstr_append(buf, p, "    return s * dot4;\n}\n\n")

    // Kernel 10: qwen3_gemv_q8_fast (swizzled blk-chunked tg_x4[288] + 4-row/SIMD register reuse)
    p = bf16_cstr_append(buf, p, "kernel void qwen3_gemv_q8_fast(\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* w_base [[buffer(0)]], device const uchar* x_base [[buffer(1)]],\n")
    p = bf16_cstr_append(buf, p, "    device uchar* val_base [[buffer(2)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& w_off [[buffer(3)]], constant ulong& x_off [[buffer(4)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& val_off [[buffer(5)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& out_dim [[buffer(6)]], constant ulong& in_dim [[buffer(7)]],\n")
    p = bf16_cstr_append(buf, p, "    uint gid [[thread_position_in_grid]], uint tid [[thread_index_in_threadgroup]]) {\n")
    p = bf16_cstr_append(buf, p, "    threadgroup float4 tg_x4[288]; threadgroup float* tg_x = (threadgroup float*)tg_x4;\n")
    p = bf16_cstr_append(buf, p, "    ulong n_groups = (out_dim + 31) / 32; ulong g = (ulong)gid >> 8;\n")
    p = bf16_cstr_append(buf, p, "    if (g >= n_groups) return;\n")
    p = bf16_cstr_append(buf, p, "    ulong sg = (ulong)tid >> 5; ulong lane = (ulong)tid & 31ul;\n")
    p = bf16_cstr_append(buf, p, "    ulong k4 = lane & 7ul; ulong b_lane = lane >> 3ul;\n")
    p = bf16_cstr_append(buf, p, "    ulong n_blocks = (in_dim + 31) / 32; ulong row_stride = n_blocks * 36ul;\n")
    p = bf16_cstr_append(buf, p, "    ulong r0 = g * 32ul + sg; ulong r1 = r0 + 8ul; ulong r2 = r0 + 16ul; ulong r3 = r0 + 24ul;\n")
    p = bf16_cstr_append(buf, p, "    bool has0 = (r0 < out_dim); bool has1 = (r1 < out_dim); bool has2 = (r2 < out_dim); bool has3 = (r3 < out_dim);\n")
    p = bf16_cstr_append(buf, p, "    device const float* in_x = (device const float*)(x_base + x_off);\n")
    p = bf16_cstr_append(buf, p, "    device float* out_val = (device float*)(val_base + val_off);\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* rw0 = has0 ? (w_base + w_off + r0 * row_stride) : w_base;\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* rw1 = has1 ? (w_base + w_off + r1 * row_stride) : w_base;\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* rw2 = has2 ? (w_base + w_off + r2 * row_stride) : w_base;\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* rw3 = has3 ? (w_base + w_off + r3 * row_stride) : w_base;\n")
    p = bf16_cstr_append(buf, p, "    bool al0 = has0 && ((((ulong)rw0) & 3ul) == 0); bool al1 = has1 && ((((ulong)rw1) & 3ul) == 0);\n")
    p = bf16_cstr_append(buf, p, "    bool al2 = has2 && ((((ulong)rw2) & 3ul) == 0); bool al3 = has3 && ((((ulong)rw3) & 3ul) == 0);\n")
    p = bf16_cstr_append(buf, p, "    float acc0 = 0.0f; float acc1 = 0.0f; float acc2 = 0.0f; float acc3 = 0.0f;\n")
    p = bf16_cstr_append(buf, p, "    for (ulong blk_base = 0ul; blk_base < n_blocks; blk_base = blk_base + 32ul) {\n")
    p = bf16_cstr_append(buf, p, "        ulong chunk_blks = min(32ul, n_blocks - blk_base); ulong k_start = blk_base << 5;\n")
    p = bf16_cstr_append(buf, p, "        for (ulong k = (ulong)tid; k < 1024ul; k = k + 256ul) { ulong gk = k_start + k; tg_x[(k >> 5) * 36ul + (k & 31ul)] = (gk < in_dim) ? in_x[gk] : 0.0f; }\n")
    p = bf16_cstr_append(buf, p, "        threadgroup_barrier(mem_flags::mem_threadgroup);\n")
    p = bf16_cstr_append(buf, p, "        for (ulong b_off = 0ul; b_off < chunk_blks; b_off = b_off + 4ul) {\n")
    p = bf16_cstr_append(buf, p, "            ulong b = b_off + b_lane;\n")
    p = bf16_cstr_append(buf, p, "            if (b < chunk_blks) {\n")
    p = bf16_cstr_append(buf, p, "                float4 x0 = *((threadgroup const float4*)(tg_x + b * 36ul + (k4 << 2)));\n")
    p = bf16_cstr_append(buf, p, "                ulong blk_byte = (blk_base + b) * 36ul;\n")
    p = bf16_cstr_append(buf, p, "                if (has0) acc0 = acc0 + qwen3_q8_blk_sub(rw0 + blk_byte, x0, k4, al0);\n")
    p = bf16_cstr_append(buf, p, "                if (has1) acc1 = acc1 + qwen3_q8_blk_sub(rw1 + blk_byte, x0, k4, al1);\n")
    p = bf16_cstr_append(buf, p, "                if (has2) acc2 = acc2 + qwen3_q8_blk_sub(rw2 + blk_byte, x0, k4, al2);\n")
    p = bf16_cstr_append(buf, p, "                if (has3) acc3 = acc3 + qwen3_q8_blk_sub(rw3 + blk_byte, x0, k4, al3);\n")
    p = bf16_cstr_append(buf, p, "            }\n        }\n")
    p = bf16_cstr_append(buf, p, "        threadgroup_barrier(mem_flags::mem_threadgroup);\n")
    p = bf16_cstr_append(buf, p, "    }\n")
    p = bf16_cstr_append(buf, p, "    if (has0) { float s0 = simd_sum(acc0); if (lane == 0) out_val[r0] = s0; }\n")
    p = bf16_cstr_append(buf, p, "    if (has1) { float s1 = simd_sum(acc1); if (lane == 0) out_val[r1] = s1; }\n")
    p = bf16_cstr_append(buf, p, "    if (has2) { float s2 = simd_sum(acc2); if (lane == 0) out_val[r2] = s2; }\n")
    p = bf16_cstr_append(buf, p, "    if (has3) { float s3 = simd_sum(acc3); if (lane == 0) out_val[r3] = s3; }\n}\n\n")

    // Kernel 11: qwen3_vec_add_accum_norm_f32
    p = bf16_cstr_append(buf, p, "kernel void qwen3_vec_add_accum_norm_f32(\n")
    p = bf16_cstr_append(buf, p, "    device uchar* a_base [[buffer(0)]], device const uchar* b_base [[buffer(1)]],\n")
    p = bf16_cstr_append(buf, p, "    device uchar* conf_base [[buffer(2)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& a_off [[buffer(3)]], constant ulong& b_off [[buffer(4)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& conf_off [[buffer(5)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& len [[buffer(6)]], constant ulong& weight_bits [[buffer(7)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& reset_flag [[buffer(8)]],\n")
    p = bf16_cstr_append(buf, p, "    uint tid [[thread_index_in_threadgroup]]) {\n")
    p = bf16_cstr_append(buf, p, "    threadgroup float tg_sq[256];\n")
    p = bf16_cstr_append(buf, p, "    device float* a = (device float*)(a_base + a_off);\n")
    p = bf16_cstr_append(buf, p, "    device const float* b = (device const float*)(b_base + b_off);\n")
    p = bf16_cstr_append(buf, p, "    float sq = 0.0f;\n")
    p = bf16_cstr_append(buf, p, "    for (ulong i = (ulong)tid; i < len; i = i + 256) {\n")
    p = bf16_cstr_append(buf, p, "        float v = a[i] + b[i];\n")
    p = bf16_cstr_append(buf, p, "        a[i] = v;\n")
    p = bf16_cstr_append(buf, p, "        sq = fma(v, v, sq);\n")
    p = bf16_cstr_append(buf, p, "    }\n")
    p = bf16_cstr_append(buf, p, "    tg_sq[tid] = sq;\n")
    p = bf16_cstr_append(buf, p, "    threadgroup_barrier(mem_flags::mem_threadgroup);\n")
    p = bf16_cstr_append(buf, p, "    for (uint stride = 128; stride > 0; stride = stride >> 1) {\n")
    p = bf16_cstr_append(buf, p, "        if (tid < stride) tg_sq[tid] = tg_sq[tid] + tg_sq[tid + stride];\n")
    p = bf16_cstr_append(buf, p, "        threadgroup_barrier(mem_flags::mem_threadgroup);\n")
    p = bf16_cstr_append(buf, p, "    }\n")
    p = bf16_cstr_append(buf, p, "    if (tid == 0) {\n")
    p = bf16_cstr_append(buf, p, "        device float* conf_hdr = (device float*)(conf_base + conf_off);\n")
    p = bf16_cstr_append(buf, p, "        float w = as_type<float>((uint)weight_bits);\n")
    p = bf16_cstr_append(buf, p, "        float prev = (reset_flag != 0) ? conf_hdr[4] : conf_hdr[0];\n")
    p = bf16_cstr_append(buf, p, "        conf_hdr[0] = fma(w, sqrt(tg_sq[0]), prev);\n")
    p = bf16_cstr_append(buf, p, "    }\n")
    p = bf16_cstr_append(buf, p, "}\n\n")

    // Kernel 12a: qwen3_compute_row_scale_bf16
    p = bf16_cstr_append(buf, p, "kernel void qwen3_compute_row_scale_bf16(\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* w_base [[buffer(0)]], device uchar* conf_base [[buffer(1)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& w_off [[buffer(2)]], constant ulong& conf_off [[buffer(3)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& out_dim [[buffer(4)]], constant ulong& in_dim [[buffer(5)]],\n")
    p = bf16_cstr_append(buf, p, "    uint gid [[thread_position_in_grid]], uint lane [[thread_index_in_simdgroup]]) {\n")
    p = bf16_cstr_append(buf, p, "    ulong row = (ulong)gid >> 5;\n")
    p = bf16_cstr_append(buf, p, "    if (row >= out_dim) return;\n")
    p = bf16_cstr_append(buf, p, "    device const ushort* row_w = (device const ushort*)(w_base + w_off) + row * in_dim;\n")
    p = bf16_cstr_append(buf, p, "    float sq = 0.0f;\n")
    p = bf16_cstr_append(buf, p, "    for (ulong k = (ulong)lane; k < in_dim; k = k + 32) {\n")
    p = bf16_cstr_append(buf, p, "        float w = as_type<float>(((uint)row_w[k]) << 16);\n")
    p = bf16_cstr_append(buf, p, "        sq = fma(w, w, sq);\n")
    p = bf16_cstr_append(buf, p, "    }\n")
    p = bf16_cstr_append(buf, p, "    sq = simd_sum(sq);\n")
    p = bf16_cstr_append(buf, p, "    if (lane == 0) {\n")
    p = bf16_cstr_append(buf, p, "        device float* w_scale = (device float*)(conf_base + conf_off + 64);\n")
    p = bf16_cstr_append(buf, p, "        w_scale[row] = sqrt(sq) * rsqrt((float)in_dim);\n")
    p = bf16_cstr_append(buf, p, "    }\n")
    p = bf16_cstr_append(buf, p, "}\n\n")

    // Kernel 12b: qwen3_compute_row_scale_f32
    p = bf16_cstr_append(buf, p, "kernel void qwen3_compute_row_scale_f32(\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* w_base [[buffer(0)]], device uchar* conf_base [[buffer(1)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& w_off [[buffer(2)]], constant ulong& conf_off [[buffer(3)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& out_dim [[buffer(4)]], constant ulong& in_dim [[buffer(5)]],\n")
    p = bf16_cstr_append(buf, p, "    uint gid [[thread_position_in_grid]], uint lane [[thread_index_in_simdgroup]]) {\n")
    p = bf16_cstr_append(buf, p, "    ulong row = (ulong)gid >> 5;\n")
    p = bf16_cstr_append(buf, p, "    if (row >= out_dim) return;\n")
    p = bf16_cstr_append(buf, p, "    device const float* row_w = (device const float*)(w_base + w_off) + row * in_dim;\n")
    p = bf16_cstr_append(buf, p, "    float sq = 0.0f;\n")
    p = bf16_cstr_append(buf, p, "    for (ulong k = (ulong)lane; k < in_dim; k = k + 32) {\n")
    p = bf16_cstr_append(buf, p, "        float w = row_w[k];\n")
    p = bf16_cstr_append(buf, p, "        sq = fma(w, w, sq);\n")
    p = bf16_cstr_append(buf, p, "    }\n")
    p = bf16_cstr_append(buf, p, "    sq = simd_sum(sq);\n")
    p = bf16_cstr_append(buf, p, "    if (lane == 0) {\n")
    p = bf16_cstr_append(buf, p, "        device float* w_scale = (device float*)(conf_base + conf_off + 64);\n")
    p = bf16_cstr_append(buf, p, "        w_scale[row] = sqrt(sq) * rsqrt((float)in_dim);\n")
    p = bf16_cstr_append(buf, p, "    }\n")
    p = bf16_cstr_append(buf, p, "}\n\n")

    // Kernel 13: qwen3_gemv_q8_conformal_head
    p = bf16_cstr_append(buf, p, "kernel void qwen3_gemv_q8_conformal_head(\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* w_base [[buffer(0)]], device const uchar* x_base [[buffer(1)]],\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* conf_base [[buffer(2)]], device uchar* val_base [[buffer(3)]],\n")
    p = bf16_cstr_append(buf, p, "    device uchar* err_base [[buffer(4)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& w_off [[buffer(5)]], constant ulong& x_off [[buffer(6)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& conf_off [[buffer(7)]], constant ulong& val_off [[buffer(8)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& err_off [[buffer(9)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& out_dim [[buffer(10)]], constant ulong& in_dim [[buffer(11)]],\n")
    p = bf16_cstr_append(buf, p, "    uint gid [[thread_position_in_grid]], uint lane [[thread_index_in_simdgroup]]) {\n")
    p = bf16_cstr_append(buf, p, "    ulong r = (ulong)gid >> 5;\n")
    p = bf16_cstr_append(buf, p, "    if (r >= out_dim) return;\n")
    p = bf16_cstr_append(buf, p, "    ulong n_blocks = (in_dim + 31) / 32;\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* row_w = w_base + w_off + r * n_blocks * 36;\n")
    p = bf16_cstr_append(buf, p, "    device const float* in_x = (device const float*)(x_base + x_off);\n")
    p = bf16_cstr_append(buf, p, "    device float* out_val = (device float*)(val_base + val_off);\n")
    p = bf16_cstr_append(buf, p, "    device float* out_err = (device float*)(err_base + err_off);\n")
    p = bf16_cstr_append(buf, p, "    float acc = 0.0f;\n")
    p = bf16_cstr_append(buf, p, "    ulong k4 = (ulong)(lane & 7);\n")
    p = bf16_cstr_append(buf, p, "    ulong b_lane = (ulong)(lane >> 3);\n")
    p = bf16_cstr_append(buf, p, "    if ((in_dim & 127ul) == 0 && (((ulong)row_w) & 3ul) == 0) {\n")
    p = bf16_cstr_append(buf, p, "        for (ulong b_base = 0; b_base < n_blocks; b_base = b_base + 4) {\n")
    p = bf16_cstr_append(buf, p, "            ulong b = b_base + b_lane;\n")
    p = bf16_cstr_append(buf, p, "            device const uchar* blk = row_w + b * 36;\n")
    p = bf16_cstr_append(buf, p, "            ushort s_bits = *((device const ushort*)blk);\n")
    p = bf16_cstr_append(buf, p, "            float s = float(as_type<half>(s_bits));\n")
    p = bf16_cstr_append(buf, p, "            uint qw = ((device const uint*)(blk + 4))[k4];\n")
    p = bf16_cstr_append(buf, p, "            char4 q4 = as_type<char4>(qw);\n")
    p = bf16_cstr_append(buf, p, "            ulong k0 = (b << 5) + (k4 << 2);\n")
    p = bf16_cstr_append(buf, p, "            float dot4 = fma((float)q4.x, in_x[k0 + 0], fma((float)q4.y, in_x[k0 + 1], fma((float)q4.z, in_x[k0 + 2], (float)q4.w * in_x[k0 + 3])));\n")
    p = bf16_cstr_append(buf, p, "            acc = fma(s, dot4, acc);\n")
    p = bf16_cstr_append(buf, p, "        }\n")
    p = bf16_cstr_append(buf, p, "    } else {\n")
    p = bf16_cstr_append(buf, p, "        for (ulong b_base = 0; b_base < n_blocks; b_base = b_base + 4) {\n")
    p = bf16_cstr_append(buf, p, "            ulong b = b_base + b_lane;\n")
    p = bf16_cstr_append(buf, p, "            if (b < n_blocks) {\n")
    p = bf16_cstr_append(buf, p, "                device const uchar* blk = row_w + b * 36;\n")
    p = bf16_cstr_append(buf, p, "                ushort s_bits = (ushort)blk[0] | ((ushort)blk[1] << 8);\n")
    p = bf16_cstr_append(buf, p, "                float s = eisa_f16_to_f32(s_bits);\n")
    p = bf16_cstr_append(buf, p, "                ulong k0 = (b << 5) + (k4 << 2);\n")
    p = bf16_cstr_append(buf, p, "                float dot4 = 0.0f;\n")
    p = bf16_cstr_append(buf, p, "                for (ulong j = 0; j < 4; ++j) {\n")
    p = bf16_cstr_append(buf, p, "                    ulong kk = k0 + j;\n")
    p = bf16_cstr_append(buf, p, "                    if (kk < in_dim) dot4 = fma((float)((char)blk[4 + k4 * 4 + j]), in_x[kk], dot4);\n")
    p = bf16_cstr_append(buf, p, "                }\n")
    p = bf16_cstr_append(buf, p, "                acc = fma(s, dot4, acc);\n")
    p = bf16_cstr_append(buf, p, "            }\n")
    p = bf16_cstr_append(buf, p, "        }\n")
    p = bf16_cstr_append(buf, p, "    }\n")
    p = bf16_cstr_append(buf, p, "    float val_sum = simd_sum(acc);\n")
    p = bf16_cstr_append(buf, p, "    if (lane == 0) {\n")
    p = bf16_cstr_append(buf, p, "        device const float* conf_hdr = (device const float*)(conf_base + conf_off);\n")
    p = bf16_cstr_append(buf, p, "        device const float* w_scale = (device const float*)(conf_base + conf_off + 64);\n")
    p = bf16_cstr_append(buf, p, "        float dh_hat = max(conf_hdr[0], 1.0e-6f);\n")
    p = bf16_cstr_append(buf, p, "        float q_val = conf_hdr[1];\n")
    p = bf16_cstr_append(buf, p, "        out_val[r] = val_sum;\n")
    p = bf16_cstr_append(buf, p, "        out_err[r] = q_val * dh_hat * w_scale[r];\n")
    p = bf16_cstr_append(buf, p, "    }\n")
    p = bf16_cstr_append(buf, p, "}\n\n")

    // Inline row dot helpers for Q4 fast GEMV & tiled head (device with float4 + shared memory)
    p = bf16_cstr_append(buf, p, "inline float qwen3_q4_row_dot_dev(device const uchar* row_w, device const float* in_x, ulong in_dim, ulong n_blocks, ulong lane) {\n")
    p = bf16_cstr_append(buf, p, "    float acc = 0.0f;\n")
    p = bf16_cstr_append(buf, p, "    if ((in_dim & 255ul) == 0 && (((ulong)row_w) & 3ul) == 0 && (((ulong)in_x) & 15ul) == 0) {\n")
    p = bf16_cstr_append(buf, p, "        ulong sub = (ulong)(lane & 3); ulong b_lane = (ulong)(lane >> 2);\n")
    p = bf16_cstr_append(buf, p, "        for (ulong b_base = 0; b_base < n_blocks; b_base = b_base + 8) {\n")
    p = bf16_cstr_append(buf, p, "            ulong b = b_base + b_lane; device const uchar* blk = row_w + b * 20;\n")
    p = bf16_cstr_append(buf, p, "            float s = float(as_type<half>(*((device const ushort*)blk)));\n")
    p = bf16_cstr_append(buf, p, "            uint p4 = ((device const uint*)(blk + 4))[sub]; ulong k0 = (b << 5) + (sub << 3);\n")
    p = bf16_cstr_append(buf, p, "            float4 x4_0 = *((device const float4*)(in_x + k0));\n")
    p = bf16_cstr_append(buf, p, "            float4 x4_1 = *((device const float4*)(in_x + k0 + 4));\n")
    p = bf16_cstr_append(buf, p, "            float d0 = fma(float((int)(p4 & 0xFu) - 8), x4_0.x, fma(float((int)((p4 >> 4) & 0xFu) - 8), x4_0.y, fma(float((int)((p4 >> 8) & 0xFu) - 8), x4_0.z, float((int)((p4 >> 12) & 0xFu) - 8) * x4_0.w)));\n")
    p = bf16_cstr_append(buf, p, "            float d1 = fma(float((int)((p4 >> 16) & 0xFu) - 8), x4_1.x, fma(float((int)((p4 >> 20) & 0xFu) - 8), x4_1.y, fma(float((int)((p4 >> 24) & 0xFu) - 8), x4_1.z, float((int)((p4 >> 28) & 0xFu) - 8) * x4_1.w)));\n")
    p = bf16_cstr_append(buf, p, "            acc = fma(s, d0 + d1, acc);\n")
    p = bf16_cstr_append(buf, p, "        }\n    } else if ((in_dim & 255ul) == 0 && (((ulong)row_w) & 3ul) == 0) {\n")
    p = bf16_cstr_append(buf, p, "        ulong sub = (ulong)(lane & 3); ulong b_lane = (ulong)(lane >> 2);\n")
    p = bf16_cstr_append(buf, p, "        for (ulong b_base = 0; b_base < n_blocks; b_base = b_base + 8) {\n")
    p = bf16_cstr_append(buf, p, "            ulong b = b_base + b_lane; device const uchar* blk = row_w + b * 20;\n")
    p = bf16_cstr_append(buf, p, "            float s = float(as_type<half>(*((device const ushort*)blk)));\n")
    p = bf16_cstr_append(buf, p, "            uint p4 = ((device const uint*)(blk + 4))[sub]; ulong k0 = (b << 5) + (sub << 3);\n")
    p = bf16_cstr_append(buf, p, "            float d0 = fma(float((int)(p4 & 0xFu) - 8), in_x[k0 + 0], fma(float((int)((p4 >> 4) & 0xFu) - 8), in_x[k0 + 1], fma(float((int)((p4 >> 8) & 0xFu) - 8), in_x[k0 + 2], float((int)((p4 >> 12) & 0xFu) - 8) * in_x[k0 + 3])));\n")
    p = bf16_cstr_append(buf, p, "            float d1 = fma(float((int)((p4 >> 16) & 0xFu) - 8), in_x[k0 + 4], fma(float((int)((p4 >> 20) & 0xFu) - 8), in_x[k0 + 5], fma(float((int)((p4 >> 24) & 0xFu) - 8), in_x[k0 + 6], float((int)((p4 >> 28) & 0xFu) - 8) * in_x[k0 + 7])));\n")
    p = bf16_cstr_append(buf, p, "            acc = fma(s, d0 + d1, acc);\n")
    p = bf16_cstr_append(buf, p, "        }\n    } else {\n")
