    p = bf16_cstr_append(buf, p, "            float s = eisa_f16_to_f32((ushort)blk[0] | ((ushort)blk[1] << 8)); ulong k0 = b * 32; float dot_b = 0.0f;\n")
    p = bf16_cstr_append(buf, p, "            for (ulong j = 0; j < 16; ++j) {\n")
    p = bf16_cstr_append(buf, p, "                uchar bv = blk[4 + j]; ulong kk = k0 + 2 * j;\n")
    p = bf16_cstr_append(buf, p, "                if (kk < in_dim) dot_b = fma(float((int)(bv & 0x0F) - 8), in_x[kk], dot_b);\n")
    p = bf16_cstr_append(buf, p, "                if (kk + 1 < in_dim) dot_b = fma(float((int)((bv >> 4) & 0x0F) - 8), in_x[kk + 1], dot_b);\n")
    p = bf16_cstr_append(buf, p, "            }\n            acc = fma(s, dot_b, acc);\n        }\n    }\n    return simd_sum(acc);\n}\n\n")

    p = bf16_cstr_append(buf, p, "inline float qwen3_q4_row_dot_tg(device const uchar* row_w, threadgroup const float* tg_x, ulong in_dim, ulong n_blocks, ulong lane) {\n")
    p = bf16_cstr_append(buf, p, "    float acc = 0.0f;\n")
    p = bf16_cstr_append(buf, p, "    if ((in_dim & 255ul) == 0 && (((ulong)row_w) & 3ul) == 0) {\n")
    p = bf16_cstr_append(buf, p, "        ulong sub = (ulong)(lane & 3); ulong b_lane = (ulong)(lane >> 2);\n")
