pub fn qwen3_gemv_q4_fast_cpu(
    q4_ptr: i64,
    x_f32_ptr: i64,
    val_f32_ptr: i64,
    out_dim: i64,
    in_dim: i64
) -> bool with Mut, Div {
    if q4_ptr == 0 || x_f32_ptr == 0 || val_f32_ptr == 0 || out_dim <= 0 || in_dim <= 0 {
        return false
    }
    let n_blocks = (in_dim + 31) / 32
    var r: i64 = 0
    while r < out_dim {
        var val_sum: f64 = 0.0
        var b: i64 = 0
        while b < n_blocks {
            let blk_off = (r * n_blocks + b) * 20
            let s_bits = ptr_read_u16_le(q4_ptr, blk_off)
            let s = f16_bits_to_f64(s_bits)
            let base_k = b * 32
            var dot_b: f64 = 0.0
            var j: i64 = 0
            while j < 16 {
                let bv = ptr_read_u8(q4_ptr, blk_off + 4 + j)
                let w0 = (bv & 15) - 8
                let w1 = ((bv >> 4) & 15) - 8
                let k0 = base_k + 2 * j
                if k0 < in_dim {
                    dot_b = dot_b + (w0 as f64) * f32_bits_to_f64(ptr_read_u32_le(x_f32_ptr, k0 * 4))
                }
                if k0 + 1 < in_dim {
                    dot_b = dot_b + (w1 as f64) * f32_bits_to_f64(ptr_read_u32_le(x_f32_ptr, (k0 + 1) * 4))
                }
                j = j + 1
            }
            val_sum = val_sum + s * dot_b
            b = b + 1
        }
        let _wv = ptr_write_u32_le(val_f32_ptr, r * 4, f64_to_f32_bits(val_sum))
        r = r + 1
    }
    true
}

pub fn qwen3_compute_tile_smax_cpu(
    conf_ptr: i64,
    tile_smax_off: i64,
    vocab: i64
) -> bool with Mut {
    if conf_ptr == 0 || tile_smax_off < 64 || vocab <= 0 {
        return false
    }
    let n_tiles = (vocab + 63) / 64
    var t: i64 = 0
    while t < n_tiles {
        let r0 = t * 64
        let r1 = if r0 + 64 < vocab { r0 + 64 } else { vocab }
        var smax: f64 = 0.0
        var r = r0
        while r < r1 {
            let ws = f32_bits_to_f64(ptr_read_u32_le(conf_ptr, 64 + r * 4))
            if ws > smax { smax = ws }
            r = r + 1
        }
        let _wt = ptr_write_u32_le(conf_ptr, tile_smax_off + t * 4, f64_to_f32_bits(smax))
        t = t + 1
    }
    true
}

pub fn qwen3_gemv_head_tiled_cpu(
    bits: i64,
    w_ptr: i64,
    x_f32_ptr: i64,
    conf_ptr: i64,
    tile_summary_off: i64,
    val_f32_ptr: i64,
    out_dim: i64,
    in_dim: i64
) -> bool with Mut, Div {
    if conf_ptr == 0 || val_f32_ptr == 0 || out_dim <= 0 || in_dim <= 0 {
        return false
    }
    let ok_gemv = if bits == 4 {
        qwen3_gemv_q4_fast_cpu(w_ptr, x_f32_ptr, val_f32_ptr, out_dim, in_dim)
    } else {
        qwen3_gemv_q8_fast_cpu(w_ptr, x_f32_ptr, val_f32_ptr, out_dim, in_dim)
    }
    if !ok_gemv { return false }
    let n_tiles = (out_dim + 63) / 64
    var t: i64 = 0
    while t < n_tiles {
        let r0 = t * 64
        let r1 = if r0 + 64 < out_dim { r0 + 64 } else { out_dim }
        var i1: i64 = -1
        var i2: i64 = -1
        var v1: f64 = 0.0
        var v2: f64 = 0.0
        var r = r0
        while r < r1 {
            let v = f32_bits_to_f64(ptr_read_u32_le(val_f32_ptr, r * 4))
            if i1 < 0 || v > v1 || (v == v1 && r < i1) {
                i2 = i1
                v2 = v1
                i1 = r
                v1 = v
            } else if i2 < 0 || v > v2 || (v == v2 && r < i2) {
                i2 = r
                v2 = v
            }
            r = r + 1
        }
        let off = tile_summary_off + t * 32
        let _w0 = ptr_write_i64_le(conf_ptr, off + 0, i1)
        let _w1 = ptr_write_i64_le(conf_ptr, off + 8, i2)
        let _w2 = ptr_write_u32_le(conf_ptr, off + 16, if i1 >= 0 { f64_to_f32_bits(v1) } else { 4286578688 })
        let _w3 = ptr_write_u32_le(conf_ptr, off + 20, if i2 >= 0 { f64_to_f32_bits(v2) } else { 4286578688 })
        t = t + 1
    }
    true
}

pub fn qwen3_certify_pruned_conformal_cpu(
    val_f32_ptr: i64,
    conf_ptr: i64,
    tile_smax_off: i64,
    tile_summary_off: i64,
    n_vocab: i64
) -> EisaConeCert with Mut, Div {
    if n_vocab <= 0 || val_f32_ptr == 0 || conf_ptr == 0 {
        return eisa_certify_global(0, 0, 0)
    }
    let n_tiles = (n_vocab + 63) / 64
    var top1_id: i64 = -1
    var runner_id: i64 = -1
    var top1_val: f64 = 0.0
    var second_val: f64 = 0.0
    var t: i64 = 0
    while t < n_tiles {
        let off = tile_summary_off + t * 32
        let a_i1 = ptr_read_i64_le(conf_ptr, off + 0)
        let a_i2 = ptr_read_i64_le(conf_ptr, off + 8)
        let a_v1 = f32_bits_to_f64(ptr_read_u32_le(conf_ptr, off + 16))
        let a_v2 = f32_bits_to_f64(ptr_read_u32_le(conf_ptr, off + 20))
        if a_i1 >= 0 && a_i1 < n_vocab {
            if top1_id < 0 || a_v1 > top1_val || (a_v1 == top1_val && a_i1 < top1_id) {
                runner_id = top1_id
                second_val = top1_val
                top1_id = a_i1
                top1_val = a_v1
            } else if runner_id < 0 || a_v1 > second_val || (a_v1 == second_val && a_i1 < runner_id) {
                runner_id = a_i1
                second_val = a_v1
            }
        }
        if a_i2 >= 0 && a_i2 < n_vocab {
            if top1_id < 0 || a_v2 > top1_val || (a_v2 == top1_val && a_i2 < top1_id) {
                runner_id = top1_id
                second_val = top1_val
                top1_id = a_i2
                top1_val = a_v2
            } else if runner_id < 0 || a_v2 > second_val || (a_v2 == second_val && a_i2 < runner_id) {
                runner_id = a_i2
                second_val = a_v2
            }
        }
        t = t + 1
    }
    if top1_id < 0 { return eisa_certify_global(0, 0, 0) }
    let raw_dh = f32_bits_to_f64(ptr_read_u32_le(conf_ptr, 0))
    let dh_hat = if raw_dh > 0.000001 { raw_dh } else { 0.000001 }
    let raw_q = f32_bits_to_f64(ptr_read_u32_le(conf_ptr, 4))
    let q_val = if raw_q > 0.0 { raw_q } else { 0.0 }
    let delta = f32_bits_to_f64(f64_to_f32_bits(q_val * dh_hat))
    let top1_err = f32_bits_to_f64(f64_to_f32_bits(delta * f32_bits_to_f64(ptr_read_u32_le(conf_ptr, 64 + top1_id * 4))))
    if n_vocab == 1 {
        let _wp = ptr_write_i64_le(conf_ptr, 8, 0)
        return EisaConeCert {
            top1_id: top1_id, runner_up_id: top1_id, refined_top1_id: top1_id,
            top1_val: top1_val, top1_err: top1_err, max_other_upper: 0.0, global_margin: 0.0,
            cone_size: 1, bf16_rows_touched: 0,
            strict_global_certified: true, refined_exact: true,
        }
    }
    let lower_top1 = top1_val - top1_err
    let run_scale = if runner_id >= 0 { f32_bits_to_f64(ptr_read_u32_le(conf_ptr, 64 + runner_id * 4)) } else { 0.0 }
    let runner_upper = second_val + f32_bits_to_f64(f64_to_f32_bits(delta * run_scale))
    var max_other_upper: f64 = runner_upper
    var cone_size: i64 = 0
    var pruned_cnt: i64 = 0
    let top_tile = top1_id / 64
    t = 0
    while t < n_tiles {
        let tv = f32_bits_to_f64(ptr_read_u32_le(conf_ptr, tile_summary_off + t * 32 + 16))
        let ts = f32_bits_to_f64(ptr_read_u32_le(conf_ptr, tile_smax_off + t * 4))
        let u_tile = tv + f32_bits_to_f64(f64_to_f32_bits(delta * ts))
        if t != top_tile && u_tile < lower_top1 && u_tile <= runner_upper {
            pruned_cnt = pruned_cnt + 1
        } else {
            let r0 = t * 64
            let r1 = if r0 + 64 < n_vocab { r0 + 64 } else { n_vocab }
            var r = r0
            while r < r1 {
                let v = f32_bits_to_f64(ptr_read_u32_le(val_f32_ptr, r * 4))
                let ws = f32_bits_to_f64(ptr_read_u32_le(conf_ptr, 64 + r * 4))
                let up = v + f32_bits_to_f64(f64_to_f32_bits(delta * ws))
                if up >= lower_top1 { cone_size = cone_size + 1 }
                if r != top1_id && up > max_other_upper { max_other_upper = up }
                r = r + 1
            }
        }
        t = t + 1
    }
    let _wp = ptr_write_i64_le(conf_ptr, 8, pruned_cnt)
    let global_margin = lower_top1 - max_other_upper
    let certified = global_margin > 0.0
    EisaConeCert {
        top1_id: top1_id,
        runner_up_id: runner_id,
        refined_top1_id: top1_id,
        top1_val: top1_val,
        top1_err: top1_err,
        max_other_upper: max_other_upper,
        global_margin: global_margin,
        cone_size: if certified { 1 } else { cone_size },
        bf16_rows_touched: 0,
        strict_global_certified: certified,
        refined_exact: certified,
    }
}

pub fn qwen3_metal_encode_gemv_quant_qkv_fast(
    s: &MetalSession,
    cid: i64,
    pipe: i64,
    buf_w: i64,
    buf_x: i64,
    buf_val: i64,
    wq_byte_off: i64,
    wk_byte_off: i64,
    wv_byte_off: i64,
    x_byte_off: i64,
    yq_byte_off: i64,
    yk_byte_off: i64,
    yv_byte_off: i64,
    q_dim: i64,
    kv_dim: i64,
    in_dim: i64
) -> i64 {
    if !s.ok || cid <= 0 || pipe <= 0 || buf_w <= 0 || buf_x <= 0 || buf_val <= 0
        || q_dim <= 0 || kv_dim <= 0 || in_dim <= 0 {
        return -1
    }
    if metal_cmd_set_buf(s, cid, 0, buf_w, 0) != 0
        || metal_cmd_set_buf(s, cid, 1, buf_x, 0) != 0
        || metal_cmd_set_buf(s, cid, 2, buf_val, 0) != 0
        || metal_cmd_set_u64(s, cid, 3, wq_byte_off) != 0
        || metal_cmd_set_u64(s, cid, 4, wk_byte_off) != 0
        || metal_cmd_set_u64(s, cid, 5, wv_byte_off) != 0
        || metal_cmd_set_u64(s, cid, 6, x_byte_off) != 0
        || metal_cmd_set_u64(s, cid, 7, yq_byte_off) != 0
        || metal_cmd_set_u64(s, cid, 8, yk_byte_off) != 0
        || metal_cmd_set_u64(s, cid, 9, yv_byte_off) != 0
        || metal_cmd_set_u64(s, cid, 10, q_dim) != 0
        || metal_cmd_set_u64(s, cid, 11, kv_dim) != 0
        || metal_cmd_set_u64(s, cid, 12, in_dim) != 0 {
        return -1
    }
    let total_out = q_dim + 2 * kv_dim
    let n_groups = (total_out + 31) / 32
    let total_threads = n_groups * 256
    if metal_cmd_dispatch_1d(s, cid, pipe, total_threads, 256) != 0 {
        return -1
    }
    0
}

pub fn qwen3_metal_encode_gemv_quant_gate_up_swiglu(
    s: &MetalSession,
    cid: i64,
    pipe: i64,
    buf_w: i64,
    buf_x: i64,
    buf_val: i64,
    wg_byte_off: i64,
    wu_byte_off: i64,
    x_byte_off: i64,
    out_byte_off: i64,
    inter_dim: i64,
    in_dim: i64
) -> i64 {
    if !s.ok || cid <= 0 || pipe <= 0 || buf_w <= 0 || buf_x <= 0 || buf_val <= 0
        || inter_dim <= 0 || in_dim <= 0 {
        return -1
    }
    if metal_cmd_set_buf(s, cid, 0, buf_w, 0) != 0
        || metal_cmd_set_buf(s, cid, 1, buf_x, 0) != 0
        || metal_cmd_set_buf(s, cid, 2, buf_val, 0) != 0
        || metal_cmd_set_u64(s, cid, 3, wg_byte_off) != 0
        || metal_cmd_set_u64(s, cid, 4, wu_byte_off) != 0
        || metal_cmd_set_u64(s, cid, 5, x_byte_off) != 0
        || metal_cmd_set_u64(s, cid, 6, out_byte_off) != 0
        || metal_cmd_set_u64(s, cid, 7, inter_dim) != 0
        || metal_cmd_set_u64(s, cid, 8, in_dim) != 0 {
        return -1
    }
    let n_groups = (inter_dim + 15) / 16
    let total_threads = n_groups * 256
    if metal_cmd_dispatch_1d(s, cid, pipe, total_threads, 256) != 0 {
        return -1
    }
    0
}

pub fn qwen3_metal_encode_add_accum_rmsnorm(
    s: &MetalSession,
    cid: i64,
    pipe: i64,
    x_buf: i64,
    h_buf: i64,
    w_buf: i64,
    out_buf: i64,
    conf_buf: i64,
    x_off: i64,
    h_off: i64,
    w_off: i64,
    out_off: i64,
    conf_off: i64,
    dim: i64,
    eps_bits: i64,
    weight_bits: i64,
    flags: i64
) -> i64 {
    if !s.ok || cid <= 0 || pipe <= 0 || x_buf <= 0 || h_buf <= 0 || w_buf <= 0
        || out_buf <= 0 || conf_buf <= 0 || dim <= 0 {
        return -1
    }
    if metal_cmd_set_buf(s, cid, 0, x_buf, 0) != 0
        || metal_cmd_set_buf(s, cid, 1, h_buf, 0) != 0
        || metal_cmd_set_buf(s, cid, 2, w_buf, 0) != 0
        || metal_cmd_set_buf(s, cid, 3, out_buf, 0) != 0
        || metal_cmd_set_buf(s, cid, 4, conf_buf, 0) != 0
        || metal_cmd_set_u64(s, cid, 5, x_off) != 0
        || metal_cmd_set_u64(s, cid, 6, h_off) != 0
        || metal_cmd_set_u64(s, cid, 7, w_off) != 0
        || metal_cmd_set_u64(s, cid, 8, out_off) != 0
        || metal_cmd_set_u64(s, cid, 9, conf_off) != 0
        || metal_cmd_set_u64(s, cid, 10, dim) != 0
        || metal_cmd_set_u64(s, cid, 11, eps_bits) != 0
        || metal_cmd_set_u64(s, cid, 12, weight_bits) != 0
        || metal_cmd_set_u64(s, cid, 13, flags) != 0 {
        return -1
    }
    if metal_cmd_dispatch_1d(s, cid, pipe, 256, 256) != 0 {
        return -1
    }
    0
}

pub fn qwen3_gemv_quant_qkv_fast_cpu(
    bits: i64,
    wq_ptr: i64,
    wk_ptr: i64,
    wv_ptr: i64,
    x_f32_ptr: i64,
    yq_f32_ptr: i64,
    yk_f32_ptr: i64,
    yv_f32_ptr: i64,
    q_dim: i64,
    kv_dim: i64,
    in_dim: i64
) -> bool with Mut, Div {
    if bits == 4 {
        return qwen3_gemv_q4_fast_cpu(wq_ptr, x_f32_ptr, yq_f32_ptr, q_dim, in_dim)
            && qwen3_gemv_q4_fast_cpu(wk_ptr, x_f32_ptr, yk_f32_ptr, kv_dim, in_dim)
            && qwen3_gemv_q4_fast_cpu(wv_ptr, x_f32_ptr, yv_f32_ptr, kv_dim, in_dim)
    }
    qwen3_gemv_q8_fast_cpu(wq_ptr, x_f32_ptr, yq_f32_ptr, q_dim, in_dim)
        && qwen3_gemv_q8_fast_cpu(wk_ptr, x_f32_ptr, yk_f32_ptr, kv_dim, in_dim)
        && qwen3_gemv_q8_fast_cpu(wv_ptr, x_f32_ptr, yv_f32_ptr, kv_dim, in_dim)
}

pub fn qwen3_gemv_quant_gate_up_swiglu_cpu(
    bits: i64,
    wg_ptr: i64,
    wu_ptr: i64,
    x_f32_ptr: i64,
    out_f32_ptr: i64,
    inter_dim: i64,
    in_dim: i64
) -> bool with Alloc, Mut, Div {
    if wg_ptr == 0 || wu_ptr == 0 || x_f32_ptr == 0 || out_f32_ptr == 0 || inter_dim <= 0 || in_dim <= 0 {
        return false
    }
    let tmp = heap_alloc(inter_dim * 4) as i64
    if tmp == 0 { return false }
    let ok_g = if bits == 4 {
        qwen3_gemv_q4_fast_cpu(wg_ptr, x_f32_ptr, out_f32_ptr, inter_dim, in_dim)
    } else {
        qwen3_gemv_q8_fast_cpu(wg_ptr, x_f32_ptr, out_f32_ptr, inter_dim, in_dim)
    }
    let ok_u = if ok_g {
        if bits == 4 {
            qwen3_gemv_q4_fast_cpu(wu_ptr, x_f32_ptr, tmp, inter_dim, in_dim)
        } else {
            qwen3_gemv_q8_fast_cpu(wu_ptr, x_f32_ptr, tmp, inter_dim, in_dim)
        }
    } else { false }
    if ok_u {
        var r: i64 = 0
        while r < inter_dim {
            let g = f32_bits_to_f64(ptr_read_u32_le(out_f32_ptr, r * 4))
            let u = f32_bits_to_f64(ptr_read_u32_le(tmp, r * 4))
            let v = (g / (1.0 + exp(0.0 - g))) * u
            let _w = ptr_write_u32_le(out_f32_ptr, r * 4, f64_to_f32_bits(v))
            r = r + 1
        }
    }
    heap_free(tmp as *mut u8)
    ok_u
}

pub fn qwen3_add_accum_rmsnorm_cpu(
    x_f32_ptr: i64,
    h_f32_ptr: i64,
    w_ptr: i64,
    w_dtype: i32,
    out_f32_ptr: i64,
    conf_ptr: i64,
    dim: i64,
    eps: f64,
    weight: f64,
    flags: i64
) -> bool with Mut, Div {
    if x_f32_ptr == 0 || h_f32_ptr == 0 || w_ptr == 0 || out_f32_ptr == 0 || conf_ptr == 0 || dim <= 0 {
        return false
    }
    var sq: f64 = 0.0
    var i: i64 = 0
    while i < dim {
        let vx = f32_bits_to_f64(ptr_read_u32_le(x_f32_ptr, i * 4))
        let vh = f32_bits_to_f64(ptr_read_u32_le(h_f32_ptr, i * 4))
        let v = vx + vh
        let _wx = ptr_write_u32_le(x_f32_ptr, i * 4, f64_to_f32_bits(v))
        sq = sq + v * v
        i = i + 1
    }
    let inv_rms = 1.0 / sqrt(sq / (dim as f64) + eps)
    if (flags & 2) != 0 {
        let prev = if (flags & 1) != 0 {
            f32_bits_to_f64(ptr_read_u32_le(conf_ptr, 16))
        } else {
            f32_bits_to_f64(ptr_read_u32_le(conf_ptr, 0))
        }
        var dh = prev + weight * sqrt(sq)
        let use_jac = ptr_read_u32_le(conf_ptr, 20)
        if (flags & 4) != 0 && use_jac != 0 {
            dh = dh * inv_rms
        }
        let _wc = ptr_write_u32_le(conf_ptr, 0, f64_to_f32_bits(dh))
    }
    i = 0
    while i < dim {
        let v = f32_bits_to_f64(ptr_read_u32_le(x_f32_ptr, i * 4))
        let w = if w_dtype == 2 {
            f32_bits_to_f64((ptr_read_u16_le(w_ptr, i * 2) & 65535) << 16)
        } else {
            f32_bits_to_f64(ptr_read_u32_le(w_ptr, i * 4))
        }
        let _wo = ptr_write_u32_le(out_f32_ptr, i * 4, f64_to_f32_bits(v * inv_rms * w))
        i = i + 1
    }
    true
}

pub fn qwen3_conformal_apply_final_inv_rms_cpu(
    x_f32_ptr: i64,
    conf_ptr: i64,
    dim: i64,
    eps: f64
) -> bool with Mut, Div {
    if x_f32_ptr == 0 || conf_ptr == 0 || dim <= 0 {
        return false
    }
    let use_jac = ptr_read_u32_le(conf_ptr, 20)
    if use_jac == 0 {
        return true
    }
    var sq: f64 = 0.0
    var i: i64 = 0
    while i < dim {
        let v = f32_bits_to_f64(ptr_read_u32_le(x_f32_ptr, i * 4))
        sq = sq + v * v
        i = i + 1
    }
    let inv_rms = 1.0 / sqrt(sq / (dim as f64) + eps)
    let cur = f32_bits_to_f64(ptr_read_u32_le(conf_ptr, 0))
    let _wc = ptr_write_u32_le(conf_ptr, 0, f64_to_f32_bits(cur * inv_rms))
    true
}
