    pub top1_id: i64,
    pub runner_up_id: i64,
    pub top1_val: f64,
    pub top1_err: f64,
    pub top1_u: f64,
    pub margin_val: f64,
    pub combined_err: f64,
    pub combined_u: f64,
    pub certified_numerical: bool,
    pub certified_total: bool,
}

pub struct EisaConeCert {
    pub top1_id: i64,
    pub runner_up_id: i64,
    pub refined_top1_id: i64,
    pub top1_val: f64,
    pub top1_err: f64,
    pub max_other_upper: f64,
    pub global_margin: f64,
    pub cone_size: i64,
    pub bf16_rows_touched: i64,
    pub strict_global_certified: bool,
    pub refined_exact: bool,
}

