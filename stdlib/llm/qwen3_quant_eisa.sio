    p = bf16_cstr_append(buf, p, "            float d0 = fma(float((int)(p4 & 0xFu) - 8), tg_x[k0 + 0], fma(float((int)((p4 >> 4) & 0xFu) - 8), tg_x[k0 + 1], fma(float((int)((p4 >> 8) & 0xFu) - 8), tg_x[k0 + 2], float((int)((p4 >> 12) & 0xFu) - 8) * tg_x[k0 + 3])));\n")
    p = bf16_cstr_append(buf, p, "            float d1 = fma(float((int)((p4 >> 16) & 0xFu) - 8), tg_x[k0 + 4], fma(float((int)((p4 >> 20) & 0xFu) - 8), tg_x[k0 + 5], fma(float((int)((p4 >> 24) & 0xFu) - 8), tg_x[k0 + 6], float((int)((p4 >> 28) & 0xFu) - 8) * tg_x[k0 + 7])));\n")
    p = bf16_cstr_append(buf, p, "            acc = fma(s, d0 + d1, acc);\n")
    p = bf16_cstr_append(buf, p, "        }\n    } else {\n")
    p = bf16_cstr_append(buf, p, "        for (ulong b = lane; b < n_blocks; b = b + 32) {\n")
    p = bf16_cstr_append(buf, p, "            device const uchar* blk = row_w + b * 20;\n")
    p = bf16_cstr_append(buf, p, "            float s = eisa_f16_to_f32((ushort)blk[0] | ((ushort)blk[1] << 8)); ulong k0 = b * 32; float dot_b = 0.0f;\n")
    p = bf16_cstr_append(buf, p, "            for (ulong j = 0; j < 16; ++j) {\n")
    p = bf16_cstr_append(buf, p, "                uchar bv = blk[4 + j]; ulong kk = k0 + 2 * j;\n")
    p = bf16_cstr_append(buf, p, "                if (kk < in_dim) dot_b = fma(float((int)(bv & 0x0F) - 8), tg_x[kk], dot_b);\n")
    p = bf16_cstr_append(buf, p, "                if (kk + 1 < in_dim) dot_b = fma(float((int)((bv >> 4) & 0x0F) - 8), tg_x[kk + 1], dot_b);\n")
    p = bf16_cstr_append(buf, p, "            }\n            acc = fma(s, dot_b, acc);\n        }\n    }\n    return simd_sum(acc);\n}\n\n")

    p = bf16_cstr_append(buf, p, "inline float qwen3_q4_blk_sub(device const uchar* blk, float4 x0, float4 x1, float x_sum8, ulong sub, bool aligned) {\n")
    p = bf16_cstr_append(buf, p, "    if (aligned) {\n")
    p = bf16_cstr_append(buf, p, "        float s = float(as_type<half>(*((device const ushort*)blk)));\n")
    p = bf16_cstr_append(buf, p, "        uint p4 = ((device const uint*)(blk + 4))[sub];\n")
    p = bf16_cstr_append(buf, p, "        float d0 = fma(float(p4 & 0xFu), x0.x, float((p4 >> 4) & 0xFu) * x0.y) + fma(float((p4 >> 8) & 0xFu), x0.z, float((p4 >> 12) & 0xFu) * x0.w);\n")
    p = bf16_cstr_append(buf, p, "        float d1 = fma(float((p4 >> 16) & 0xFu), x1.x, float((p4 >> 20) & 0xFu) * x1.y) + fma(float((p4 >> 24) & 0xFu), x1.z, float((p4 >> 28) & 0xFu) * x1.w);\n")
    p = bf16_cstr_append(buf, p, "        return s * fma(-8.0f, x_sum8, d0 + d1);\n    }\n")
    p = bf16_cstr_append(buf, p, "    float s = eisa_f16_to_f32((ushort)blk[0] | ((ushort)blk[1] << 8)); ulong j0 = sub << 2;\n")
    p = bf16_cstr_append(buf, p, "    uchar b0 = blk[4+j0+0]; uchar b1 = blk[4+j0+1]; uchar b2 = blk[4+j0+2]; uchar b3 = blk[4+j0+3];\n")
    p = bf16_cstr_append(buf, p, "    float d0 = fma(float(b0 & 0x0Fu), x0.x, float((b0 >> 4) & 0x0Fu) * x0.y) + fma(float(b1 & 0x0Fu), x0.z, float((b1 >> 4) & 0x0Fu) * x0.w);\n")
    p = bf16_cstr_append(buf, p, "    float d1 = fma(float(b2 & 0x0Fu), x1.x, float((b2 >> 4) & 0x0Fu) * x1.y) + fma(float(b3 & 0x0Fu), x1.z, float((b3 >> 4) & 0x0Fu) * x1.w);\n")
    p = bf16_cstr_append(buf, p, "    return s * fma(-8.0f, x_sum8, d0 + d1);\n}\n\n")

    // Kernel 14: qwen3_gemv_q4_fast (swizzled blk-chunked tg_x4[288] + 4-row/SIMD register reuse + hoisted -8*x_sum8)
    p = bf16_cstr_append(buf, p, "kernel void qwen3_gemv_q4_fast(\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* w_base [[buffer(0)]], device const uchar* x_base [[buffer(1)]],\n")
    p = bf16_cstr_append(buf, p, "    device uchar* val_base [[buffer(2)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& w_off [[buffer(3)]], constant ulong& x_off [[buffer(4)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& val_off [[buffer(5)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& out_dim [[buffer(6)]], constant ulong& in_dim [[buffer(7)]],\n")
    p = bf16_cstr_append(buf, p, "    uint gid [[thread_position_in_grid]], uint tid [[thread_index_in_threadgroup]]) {\n")
    p = bf16_cstr_append(buf, p, "    threadgroup float4 tg_x4[288]; threadgroup float* tg_x = (threadgroup float*)tg_x4;\n")
    p = bf16_cstr_append(buf, p, "    ulong n_groups = (out_dim + 31) / 32; ulong g = (ulong)gid >> 8;\n")
    p = bf16_cstr_append(buf, p, "    if (g >= n_groups) return;\n")
    p = bf16_cstr_append(buf, p, "    ulong sg = (ulong)tid >> 5; ulong lane = (ulong)tid & 31ul;\n")
    p = bf16_cstr_append(buf, p, "    ulong sub = lane & 3ul; ulong b_lane = lane >> 2ul;\n")
    p = bf16_cstr_append(buf, p, "    ulong n_blocks = (in_dim + 31) / 32; ulong row_stride = n_blocks * 20ul;\n")
    p = bf16_cstr_append(buf, p, "    ulong r0 = g * 32ul + sg; ulong r1 = r0 + 8ul; ulong r2 = r0 + 16ul; ulong r3 = r0 + 24ul;\n")
    p = bf16_cstr_append(buf, p, "    bool has0 = (r0 < out_dim); bool has1 = (r1 < out_dim); bool has2 = (r2 < out_dim); bool has3 = (r3 < out_dim);\n")
    p = bf16_cstr_append(buf, p, "    device const float* in_x = (device const float*)(x_base + x_off);\n")
    p = bf16_cstr_append(buf, p, "    device float* out_val = (device float*)(val_base + val_off);\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* rw0 = has0 ? (w_base + w_off + r0 * row_stride) : w_base;\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* rw1 = has1 ? (w_base + w_off + r1 * row_stride) : w_base;\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* rw2 = has2 ? (w_base + w_off + r2 * row_stride) : w_base;\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* rw3 = has3 ? (w_base + w_off + r3 * row_stride) : w_base;\n")
    p = bf16_cstr_append(buf, p, "    bool al0 = has0 && ((((ulong)rw0) & 3ul) == 0); bool al1 = has1 && ((((ulong)rw1) & 3ul) == 0);\n")
    p = bf16_cstr_append(buf, p, "    bool al2 = has2 && ((((ulong)rw2) & 3ul) == 0); bool al3 = has3 && ((((ulong)rw3) & 3ul) == 0);\n")
    p = bf16_cstr_append(buf, p, "    float acc0 = 0.0f; float acc1 = 0.0f; float acc2 = 0.0f; float acc3 = 0.0f;\n")
    p = bf16_cstr_append(buf, p, "    for (ulong blk_base = 0ul; blk_base < n_blocks; blk_base = blk_base + 32ul) {\n")
    p = bf16_cstr_append(buf, p, "        ulong chunk_blks = min(32ul, n_blocks - blk_base); ulong k_start = blk_base << 5;\n")
    p = bf16_cstr_append(buf, p, "        for (ulong k = (ulong)tid; k < 1024ul; k = k + 256ul) { ulong gk = k_start + k; tg_x[(k >> 5) * 36ul + (k & 31ul)] = (gk < in_dim) ? in_x[gk] : 0.0f; }\n")
    p = bf16_cstr_append(buf, p, "        threadgroup_barrier(mem_flags::mem_threadgroup);\n")
    p = bf16_cstr_append(buf, p, "        for (ulong b_off = 0ul; b_off < chunk_blks; b_off = b_off + 8ul) {\n")
    p = bf16_cstr_append(buf, p, "            ulong b = b_off + b_lane;\n")
    p = bf16_cstr_append(buf, p, "            if (b < chunk_blks) {\n")
    p = bf16_cstr_append(buf, p, "                ulong x_off_b = b * 36ul + (sub << 3);\n")
    p = bf16_cstr_append(buf, p, "                float4 x0 = *((threadgroup const float4*)(tg_x + x_off_b));\n")
    p = bf16_cstr_append(buf, p, "                float4 x1 = *((threadgroup const float4*)(tg_x + x_off_b + 4ul));\n")
    p = bf16_cstr_append(buf, p, "                float x_sum8 = ((x0.x + x0.y) + (x0.z + x0.w)) + ((x1.x + x1.y) + (x1.z + x1.w));\n")
    p = bf16_cstr_append(buf, p, "                ulong blk_byte = (blk_base + b) * 20ul;\n")
    p = bf16_cstr_append(buf, p, "                if (has0) acc0 = acc0 + qwen3_q4_blk_sub(rw0 + blk_byte, x0, x1, x_sum8, sub, al0);\n")
    p = bf16_cstr_append(buf, p, "                if (has1) acc1 = acc1 + qwen3_q4_blk_sub(rw1 + blk_byte, x0, x1, x_sum8, sub, al1);\n")
    p = bf16_cstr_append(buf, p, "                if (has2) acc2 = acc2 + qwen3_q4_blk_sub(rw2 + blk_byte, x0, x1, x_sum8, sub, al2);\n")
    p = bf16_cstr_append(buf, p, "                if (has3) acc3 = acc3 + qwen3_q4_blk_sub(rw3 + blk_byte, x0, x1, x_sum8, sub, al3);\n")
    p = bf16_cstr_append(buf, p, "            }\n        }\n")
    p = bf16_cstr_append(buf, p, "        threadgroup_barrier(mem_flags::mem_threadgroup);\n")
    p = bf16_cstr_append(buf, p, "    }\n")
    p = bf16_cstr_append(buf, p, "    if (has0) { float s0 = simd_sum(acc0); if (lane == 0) out_val[r0] = s0; }\n")
    p = bf16_cstr_append(buf, p, "    if (has1) { float s1 = simd_sum(acc1); if (lane == 0) out_val[r1] = s1; }\n")
    p = bf16_cstr_append(buf, p, "    if (has2) { float s2 = simd_sum(acc2); if (lane == 0) out_val[r2] = s2; }\n")
    p = bf16_cstr_append(buf, p, "    if (has3) { float s3 = simd_sum(acc3); if (lane == 0) out_val[r3] = s3; }\n}\n\n")

    // Kernel 15: qwen3_compute_tile_smax_f32
    p = bf16_cstr_append(buf, p, "kernel void qwen3_compute_tile_smax_f32(\n")
    p = bf16_cstr_append(buf, p, "    device uchar* conf_base [[buffer(0)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& conf_off [[buffer(1)]], constant ulong& tile_smax_off [[buffer(2)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& vocab [[buffer(3)]], uint gid [[thread_position_in_grid]]) {\n")
    p = bf16_cstr_append(buf, p, "    ulong n_tiles = (vocab + 63) / 64;\n")
    p = bf16_cstr_append(buf, p, "    ulong t = (ulong)gid;\n")
    p = bf16_cstr_append(buf, p, "    if (t >= n_tiles) return;\n")
    p = bf16_cstr_append(buf, p, "    device const float* w_scale = (device const float*)(conf_base + conf_off + 64);\n")
    p = bf16_cstr_append(buf, p, "    device float* tile_smax = (device float*)(conf_base + conf_off + tile_smax_off);\n")
    p = bf16_cstr_append(buf, p, "    ulong r0 = t * 64;\n")
    p = bf16_cstr_append(buf, p, "    ulong r1 = min(vocab, r0 + 64);\n")
    p = bf16_cstr_append(buf, p, "    float smax = 0.0f;\n")
    p = bf16_cstr_append(buf, p, "    for (ulong r = r0; r < r1; ++r) { smax = max(smax, w_scale[r]); }\n")
    p = bf16_cstr_append(buf, p, "    tile_smax[t] = smax;\n")
    p = bf16_cstr_append(buf, p, "}\n\n")

    // Kernel 16: qwen3_gemv_q4_head_tiled (swizzled blk-chunked tg_x4[288] + 8-row scalar accumulators + hoisted -8*x_sum8)
    p = bf16_cstr_append(buf, p, "kernel void qwen3_gemv_q4_head_tiled(\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* w_base [[buffer(0)]], device const uchar* x_base [[buffer(1)]],\n")
    p = bf16_cstr_append(buf, p, "    device uchar* conf_base [[buffer(2)]], device uchar* val_base [[buffer(3)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& w_off [[buffer(4)]], constant ulong& x_off [[buffer(5)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& conf_off [[buffer(6)]], constant ulong& tile_summary_off [[buffer(7)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& val_off [[buffer(8)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& out_dim [[buffer(9)]], constant ulong& in_dim [[buffer(10)]],\n")
    p = bf16_cstr_append(buf, p, "    uint gid [[thread_position_in_grid]], uint tid [[thread_index_in_threadgroup]]) {\n")
    p = bf16_cstr_append(buf, p, "    threadgroup float4 tg_x4[288]; threadgroup float* tg_x = (threadgroup float*)tg_x4;\n")
    p = bf16_cstr_append(buf, p, "    threadgroup float sg_v1[8]; threadgroup float sg_v2[8];\n")
    p = bf16_cstr_append(buf, p, "    threadgroup ulong sg_i1[8]; threadgroup ulong sg_i2[8];\n")
    p = bf16_cstr_append(buf, p, "    ulong n_tiles = (out_dim + 63) / 64; ulong t = (ulong)gid >> 8;\n")
    p = bf16_cstr_append(buf, p, "    if (t >= n_tiles) return;\n")
    p = bf16_cstr_append(buf, p, "    ulong sg = (ulong)tid >> 5; ulong lane = (ulong)tid & 31ul;\n")
    p = bf16_cstr_append(buf, p, "    ulong sub = lane & 3ul; ulong b_lane = lane >> 2ul;\n")
    p = bf16_cstr_append(buf, p, "    ulong n_blocks = (in_dim + 31) / 32; ulong row_stride = n_blocks * 20ul;\n")
    p = bf16_cstr_append(buf, p, "    device const float* in_x = (device const float*)(x_base + x_off);\n")
    p = bf16_cstr_append(buf, p, "    device float* out_val = (device float*)(val_base + val_off);\n")
    p = bf16_cstr_append(buf, p, "    ulong r0 = t * 64ul + sg; ulong r1 = r0 + 8ul; ulong r2 = r0 + 16ul; ulong r3 = r0 + 24ul;\n")
    p = bf16_cstr_append(buf, p, "    ulong r4 = r0 + 32ul; ulong r5 = r0 + 40ul; ulong r6 = r0 + 48ul; ulong r7 = r0 + 56ul;\n")
    p = bf16_cstr_append(buf, p, "    bool h0 = (r0 < out_dim); bool h1 = (r1 < out_dim); bool h2 = (r2 < out_dim); bool h3 = (r3 < out_dim);\n")
    p = bf16_cstr_append(buf, p, "    bool h4 = (r4 < out_dim); bool h5 = (r5 < out_dim); bool h6 = (r6 < out_dim); bool h7 = (r7 < out_dim);\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* rw0 = h0 ? (w_base + w_off + r0 * row_stride) : w_base; device const uchar* rw1 = h1 ? (w_base + w_off + r1 * row_stride) : w_base;\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* rw2 = h2 ? (w_base + w_off + r2 * row_stride) : w_base; device const uchar* rw3 = h3 ? (w_base + w_off + r3 * row_stride) : w_base;\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* rw4 = h4 ? (w_base + w_off + r4 * row_stride) : w_base; device const uchar* rw5 = h5 ? (w_base + w_off + r5 * row_stride) : w_base;\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* rw6 = h6 ? (w_base + w_off + r6 * row_stride) : w_base; device const uchar* rw7 = h7 ? (w_base + w_off + r7 * row_stride) : w_base;\n")
    p = bf16_cstr_append(buf, p, "    bool aligned = ((((ulong)(w_base + w_off)) & 3ul) == 0) && ((row_stride & 3ul) == 0);\n")
    p = bf16_cstr_append(buf, p, "    float a0=0.0f; float a1=0.0f; float a2=0.0f; float a3=0.0f; float a4=0.0f; float a5=0.0f; float a6=0.0f; float a7=0.0f;\n")
    p = bf16_cstr_append(buf, p, "    for (ulong blk_base = 0ul; blk_base < n_blocks; blk_base = blk_base + 32ul) {\n")
    p = bf16_cstr_append(buf, p, "        ulong chunk_blks = min(32ul, n_blocks - blk_base); ulong k_start = blk_base << 5;\n")
    p = bf16_cstr_append(buf, p, "        for (ulong k = (ulong)tid; k < 1024ul; k = k + 256ul) { ulong gk = k_start + k; tg_x[(k >> 5) * 36ul + (k & 31ul)] = (gk < in_dim) ? in_x[gk] : 0.0f; }\n")
    p = bf16_cstr_append(buf, p, "        threadgroup_barrier(mem_flags::mem_threadgroup);\n")
    p = bf16_cstr_append(buf, p, "        for (ulong b_off = 0ul; b_off < chunk_blks; b_off = b_off + 8ul) {\n")
    p = bf16_cstr_append(buf, p, "            ulong b = b_off + b_lane;\n")
    p = bf16_cstr_append(buf, p, "            if (b < chunk_blks) {\n")
    p = bf16_cstr_append(buf, p, "                ulong x_off_b = b * 36ul + (sub << 3);\n")
    p = bf16_cstr_append(buf, p, "                float4 x0 = *((threadgroup const float4*)(tg_x + x_off_b));\n")
    p = bf16_cstr_append(buf, p, "                float4 x1 = *((threadgroup const float4*)(tg_x + x_off_b + 4ul));\n")
    p = bf16_cstr_append(buf, p, "                float x_sum8 = ((x0.x + x0.y) + (x0.z + x0.w)) + ((x1.x + x1.y) + (x1.z + x1.w));\n")
    p = bf16_cstr_append(buf, p, "                ulong blk_byte = (blk_base + b) * 20ul;\n")
    p = bf16_cstr_append(buf, p, "                if (h0) a0 = a0 + qwen3_q4_blk_sub(rw0 + blk_byte, x0, x1, x_sum8, sub, aligned);\n")
    p = bf16_cstr_append(buf, p, "                if (h1) a1 = a1 + qwen3_q4_blk_sub(rw1 + blk_byte, x0, x1, x_sum8, sub, aligned);\n")
    p = bf16_cstr_append(buf, p, "                if (h2) a2 = a2 + qwen3_q4_blk_sub(rw2 + blk_byte, x0, x1, x_sum8, sub, aligned);\n")
    p = bf16_cstr_append(buf, p, "                if (h3) a3 = a3 + qwen3_q4_blk_sub(rw3 + blk_byte, x0, x1, x_sum8, sub, aligned);\n")
    p = bf16_cstr_append(buf, p, "                if (h4) a4 = a4 + qwen3_q4_blk_sub(rw4 + blk_byte, x0, x1, x_sum8, sub, aligned);\n")
    p = bf16_cstr_append(buf, p, "                if (h5) a5 = a5 + qwen3_q4_blk_sub(rw5 + blk_byte, x0, x1, x_sum8, sub, aligned);\n")
    p = bf16_cstr_append(buf, p, "                if (h6) a6 = a6 + qwen3_q4_blk_sub(rw6 + blk_byte, x0, x1, x_sum8, sub, aligned);\n")
    p = bf16_cstr_append(buf, p, "                if (h7) a7 = a7 + qwen3_q4_blk_sub(rw7 + blk_byte, x0, x1, x_sum8, sub, aligned);\n")
    p = bf16_cstr_append(buf, p, "            }\n        }\n")
    p = bf16_cstr_append(buf, p, "        threadgroup_barrier(mem_flags::mem_threadgroup);\n    }\n")
    p = bf16_cstr_append(buf, p, "    float lv1 = -INFINITY; float lv2 = -INFINITY;\n")
    p = bf16_cstr_append(buf, p, "    ulong li1 = 0xFFFFFFFFFFFFFFFFul; ulong li2 = 0xFFFFFFFFFFFFFFFFul;\n")
    p = bf16_cstr_append(buf, p, "    float v0 = h0 ? simd_sum(a0) : -INFINITY; float v1 = h1 ? simd_sum(a1) : -INFINITY; float v2 = h2 ? simd_sum(a2) : -INFINITY; float v3 = h3 ? simd_sum(a3) : -INFINITY;\n")
    p = bf16_cstr_append(buf, p, "    float v4 = h4 ? simd_sum(a4) : -INFINITY; float v5 = h5 ? simd_sum(a5) : -INFINITY; float v6 = h6 ? simd_sum(a6) : -INFINITY; float v7 = h7 ? simd_sum(a7) : -INFINITY;\n")
    p = bf16_cstr_append(buf, p, "    if (lane == 0) {\n")
    p = bf16_cstr_append(buf, p, "        if (h0) { out_val[r0] = v0; if (v0 > lv1 || (v0 == lv1 && r0 < li1)) { lv2 = lv1; li2 = li1; lv1 = v0; li1 = r0; } else if (v0 > lv2 || (v0 == lv2 && r0 < li2)) { lv2 = v0; li2 = r0; } }\n")
    p = bf16_cstr_append(buf, p, "        if (h1) { out_val[r1] = v1; if (v1 > lv1 || (v1 == lv1 && r1 < li1)) { lv2 = lv1; li2 = li1; lv1 = v1; li1 = r1; } else if (v1 > lv2 || (v1 == lv2 && r1 < li2)) { lv2 = v1; li2 = r1; } }\n")
    p = bf16_cstr_append(buf, p, "        if (h2) { out_val[r2] = v2; if (v2 > lv1 || (v2 == lv1 && r2 < li1)) { lv2 = lv1; li2 = li1; lv1 = v2; li1 = r2; } else if (v2 > lv2 || (v2 == lv2 && r2 < li2)) { lv2 = v2; li2 = r2; } }\n")
    p = bf16_cstr_append(buf, p, "        if (h3) { out_val[r3] = v3; if (v3 > lv1 || (v3 == lv1 && r3 < li1)) { lv2 = lv1; li2 = li1; lv1 = v3; li1 = r3; } else if (v3 > lv2 || (v3 == lv2 && r3 < li2)) { lv2 = v3; li2 = r3; } }\n")
    p = bf16_cstr_append(buf, p, "        if (h4) { out_val[r4] = v4; if (v4 > lv1 || (v4 == lv1 && r4 < li1)) { lv2 = lv1; li2 = li1; lv1 = v4; li1 = r4; } else if (v4 > lv2 || (v4 == lv2 && r4 < li2)) { lv2 = v4; li2 = r4; } }\n")
    p = bf16_cstr_append(buf, p, "        if (h5) { out_val[r5] = v5; if (v5 > lv1 || (v5 == lv1 && r5 < li1)) { lv2 = lv1; li2 = li1; lv1 = v5; li1 = r5; } else if (v5 > lv2 || (v5 == lv2 && r5 < li2)) { lv2 = v5; li2 = r5; } }\n")
