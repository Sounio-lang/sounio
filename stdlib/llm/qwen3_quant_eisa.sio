// stdlib::llm::qwen3_quant_eisa — Block-32 Quantization Formats (Q4_EISA & Q8_EISA)
// with Strict Epistemic Error & Measurement Uncertainty Bound Propagation.

use llm::raw_memory::{ptr_read_i64_le, ptr_read_u16_le, ptr_read_u32_le, ptr_read_u8, ptr_write_i64_le, ptr_write_u16_le, ptr_write_u32_le, ptr_write_u8}

use tensor2::convert::{
    f64_to_f16_bits,
    f16_bits_to_f64,
    bf16_bits_to_f64,
    f32_bits_to_f64,
    f64_to_f32_bits,
}
use math::pure::{exp}
use llm::bf16_kernels::{bf16_cstr_append}
use llm::ptx_kernels_sm80::{emit_eisa_ptx_sm80_cstr}
use llm::hal::{
    MetalSession,
    metal_compile_msl_ptr,
    metal_cmd_begin,
    metal_cmd_cancel,
    metal_cmd_set_buf,
    metal_cmd_set_u64,
    metal_cmd_dispatch_1d,
    metal_cmd_commit_sync,
    CudaDriverSession,
    cuda_launch_8param_1d,
}

