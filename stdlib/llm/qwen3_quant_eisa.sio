        || metal_cmd_set_buf(s, cid, 1, buf_conf, 0) != 0
        || metal_cmd_set_u64(s, cid, 2, w_byte_off) != 0
        || metal_cmd_set_u64(s, cid, 3, conf_byte_off) != 0
        || metal_cmd_set_u64(s, cid, 4, out_dim) != 0
        || metal_cmd_set_u64(s, cid, 5, in_dim) != 0 {
        return -1
    }
    let total_threads = out_dim * 32
    let group_threads = if total_threads < 128 { 32 } else { 128 }
    if metal_cmd_dispatch_1d(s, cid, pipe, total_threads, group_threads) != 0 {
        return -1
    }
    0
}

