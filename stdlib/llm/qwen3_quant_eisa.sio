    p = bf16_cstr_append(buf, p, "                if (has0) acc0 = acc0 + qwen3_q8_blk_sub(rw0 + blk_byte, x0, k4, al0);\n")
    p = bf16_cstr_append(buf, p, "                if (has1) acc1 = acc1 + qwen3_q8_blk_sub(rw1 + blk_byte, x0, k4, al1);\n")
    p = bf16_cstr_append(buf, p, "                if (has2) acc2 = acc2 + qwen3_q8_blk_sub(rw2 + blk_byte, x0, k4, al2);\n")
    p = bf16_cstr_append(buf, p, "                if (has3) acc3 = acc3 + qwen3_q8_blk_sub(rw3 + blk_byte, x0, k4, al3);\n")
    p = bf16_cstr_append(buf, p, "            }\n        }\n")
    p = bf16_cstr_append(buf, p, "        threadgroup_barrier(mem_flags::mem_threadgroup);\n    }\n")
    p = bf16_cstr_append(buf, p, "    if (has0) { float s0 = simd_sum(acc0); if (lane == 0) dst0[lr0] = s0; }\n")
    p = bf16_cstr_append(buf, p, "    if (has1) { float s1 = simd_sum(acc1); if (lane == 0) dst1[lr1] = s1; }\n")
    p = bf16_cstr_append(buf, p, "    if (has2) { float s2 = simd_sum(acc2); if (lane == 0) dst2[lr2] = s2; }\n")
    p = bf16_cstr_append(buf, p, "    if (has3) { float s3 = simd_sum(acc3); if (lane == 0) dst3[lr3] = s3; }\n}\n\n")

    // Kernel 21: qwen3_gemv_q4_gate_up_swiglu (F3-Q4: swizzled blk-chunked tg_x4[288] + 4-way simultaneous scalar reuse + hoisted -8*x_sum8)
    p = bf16_cstr_append(buf, p, "kernel void qwen3_gemv_q4_gate_up_swiglu(\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* w_base [[buffer(0)]], device const uchar* x_base [[buffer(1)]],\n")
    p = bf16_cstr_append(buf, p, "    device uchar* val_base [[buffer(2)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& wg_off [[buffer(3)]], constant ulong& wu_off [[buffer(4)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& x_off [[buffer(5)]], constant ulong& out_off [[buffer(6)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& inter_dim [[buffer(7)]], constant ulong& in_dim [[buffer(8)]],\n")
    p = bf16_cstr_append(buf, p, "    uint gid [[thread_position_in_grid]], uint tid [[thread_index_in_threadgroup]]) {\n")
    p = bf16_cstr_append(buf, p, "    threadgroup float4 tg_x4[288]; threadgroup float* tg_x = (threadgroup float*)tg_x4;\n")
    p = bf16_cstr_append(buf, p, "    ulong n_groups = (inter_dim + 15) / 16; ulong g = (ulong)gid >> 8;\n")
    p = bf16_cstr_append(buf, p, "    if (g >= n_groups) return;\n")
    p = bf16_cstr_append(buf, p, "    ulong sg = (ulong)tid >> 5; ulong lane = (ulong)tid & 31ul;\n")
    p = bf16_cstr_append(buf, p, "    ulong sub = lane & 3ul; ulong b_lane = lane >> 2ul;\n")
    p = bf16_cstr_append(buf, p, "    ulong n_blocks = (in_dim + 31) / 32; ulong row_stride = n_blocks * 20ul;\n")
    p = bf16_cstr_append(buf, p, "    ulong r0 = g * 16ul + sg; ulong r1 = r0 + 8ul;\n")
    p = bf16_cstr_append(buf, p, "    bool has0 = (r0 < inter_dim); bool has1 = (r1 < inter_dim);\n")
    p = bf16_cstr_append(buf, p, "    device const float* in_x = (device const float*)(x_base + x_off);\n")
    p = bf16_cstr_append(buf, p, "    device float* out_y = (device float*)(val_base + out_off);\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* rg0 = has0 ? (w_base + wg_off + r0 * row_stride) : w_base;\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* ru0 = has0 ? (w_base + wu_off + r0 * row_stride) : w_base;\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* rg1 = has1 ? (w_base + wg_off + r1 * row_stride) : w_base;\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* ru1 = has1 ? (w_base + wu_off + r1 * row_stride) : w_base;\n")
    p = bf16_cstr_append(buf, p, "    bool alg0 = has0 && ((((ulong)rg0) & 3ul) == 0); bool alu0 = has0 && ((((ulong)ru0) & 3ul) == 0);\n")
    p = bf16_cstr_append(buf, p, "    bool alg1 = has1 && ((((ulong)rg1) & 3ul) == 0); bool alu1 = has1 && ((((ulong)ru1) & 3ul) == 0);\n")
    p = bf16_cstr_append(buf, p, "    float g0 = 0.0f; float u0 = 0.0f; float g1 = 0.0f; float u1 = 0.0f;\n")
    p = bf16_cstr_append(buf, p, "    for (ulong blk_base = 0ul; blk_base < n_blocks; blk_base = blk_base + 32ul) {\n")
    p = bf16_cstr_append(buf, p, "        ulong chunk_blks = min(32ul, n_blocks - blk_base); ulong k_start = blk_base << 5;\n")
    p = bf16_cstr_append(buf, p, "        for (ulong k = (ulong)tid; k < 1024ul; k = k + 256ul) { ulong gk = k_start + k; tg_x[(k >> 5) * 36ul + (k & 31ul)] = (gk < in_dim) ? in_x[gk] : 0.0f; }\n")
    p = bf16_cstr_append(buf, p, "        threadgroup_barrier(mem_flags::mem_threadgroup);\n")
    p = bf16_cstr_append(buf, p, "        for (ulong b_off = 0ul; b_off < chunk_blks; b_off = b_off + 8ul) {\n")
    p = bf16_cstr_append(buf, p, "            ulong b = b_off + b_lane;\n")
    p = bf16_cstr_append(buf, p, "            if (b < chunk_blks) {\n")
    p = bf16_cstr_append(buf, p, "                ulong x_off_b = b * 36ul + (sub << 3);\n")
    p = bf16_cstr_append(buf, p, "                float4 x0 = *((threadgroup const float4*)(tg_x + x_off_b));\n")
    p = bf16_cstr_append(buf, p, "                float4 x1 = *((threadgroup const float4*)(tg_x + x_off_b + 4ul));\n")
    p = bf16_cstr_append(buf, p, "                float x_sum8 = ((x0.x + x0.y) + (x0.z + x0.w)) + ((x1.x + x1.y) + (x1.z + x1.w));\n")
    p = bf16_cstr_append(buf, p, "                ulong blk_byte = (blk_base + b) * 20ul;\n")
    p = bf16_cstr_append(buf, p, "                if (has0) { g0 = g0 + qwen3_q4_blk_sub(rg0 + blk_byte, x0, x1, x_sum8, sub, alg0); u0 = u0 + qwen3_q4_blk_sub(ru0 + blk_byte, x0, x1, x_sum8, sub, alu0); }\n")
    p = bf16_cstr_append(buf, p, "                if (has1) { g1 = g1 + qwen3_q4_blk_sub(rg1 + blk_byte, x0, x1, x_sum8, sub, alg1); u1 = u1 + qwen3_q4_blk_sub(ru1 + blk_byte, x0, x1, x_sum8, sub, alu1); }\n")
    p = bf16_cstr_append(buf, p, "            }\n        }\n")
    p = bf16_cstr_append(buf, p, "        threadgroup_barrier(mem_flags::mem_threadgroup);\n    }\n")
    p = bf16_cstr_append(buf, p, "    if (has0) { float sg0 = simd_sum(g0); float su0 = simd_sum(u0); if (lane == 0) out_y[r0] = (sg0 / (1.0f + exp(-sg0))) * su0; }\n")
    p = bf16_cstr_append(buf, p, "    if (has1) { float sg1 = simd_sum(g1); float su1 = simd_sum(u1); if (lane == 0) out_y[r1] = (sg1 / (1.0f + exp(-sg1))) * su1; }\n}\n\n")

    // Kernel 22: qwen3_gemv_q8_gate_up_swiglu (F3-Q8: swizzled blk-chunked tg_x4[288] + 4-way simultaneous scalar reuse)
    p = bf16_cstr_append(buf, p, "kernel void qwen3_gemv_q8_gate_up_swiglu(\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* w_base [[buffer(0)]], device const uchar* x_base [[buffer(1)]],\n")
    p = bf16_cstr_append(buf, p, "    device uchar* val_base [[buffer(2)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& wg_off [[buffer(3)]], constant ulong& wu_off [[buffer(4)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& x_off [[buffer(5)]], constant ulong& out_off [[buffer(6)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& inter_dim [[buffer(7)]], constant ulong& in_dim [[buffer(8)]],\n")
    p = bf16_cstr_append(buf, p, "    uint gid [[thread_position_in_grid]], uint tid [[thread_index_in_threadgroup]]) {\n")
    p = bf16_cstr_append(buf, p, "    threadgroup float4 tg_x4[288]; threadgroup float* tg_x = (threadgroup float*)tg_x4;\n")
    p = bf16_cstr_append(buf, p, "    ulong n_groups = (inter_dim + 15) / 16; ulong g = (ulong)gid >> 8;\n")
    p = bf16_cstr_append(buf, p, "    if (g >= n_groups) return;\n")
    p = bf16_cstr_append(buf, p, "    ulong sg = (ulong)tid >> 5; ulong lane = (ulong)tid & 31ul;\n")
    p = bf16_cstr_append(buf, p, "    ulong k4 = lane & 7ul; ulong b_lane = lane >> 3ul;\n")
    p = bf16_cstr_append(buf, p, "    ulong n_blocks = (in_dim + 31) / 32; ulong row_stride = n_blocks * 36ul;\n")
    p = bf16_cstr_append(buf, p, "    ulong r0 = g * 16ul + sg; ulong r1 = r0 + 8ul;\n")
    p = bf16_cstr_append(buf, p, "    bool has0 = (r0 < inter_dim); bool has1 = (r1 < inter_dim);\n")
    p = bf16_cstr_append(buf, p, "    device const float* in_x = (device const float*)(x_base + x_off);\n")
    p = bf16_cstr_append(buf, p, "    device float* out_y = (device float*)(val_base + out_off);\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* rg0 = has0 ? (w_base + wg_off + r0 * row_stride) : w_base;\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* ru0 = has0 ? (w_base + wu_off + r0 * row_stride) : w_base;\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* rg1 = has1 ? (w_base + wg_off + r1 * row_stride) : w_base;\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* ru1 = has1 ? (w_base + wu_off + r1 * row_stride) : w_base;\n")
    p = bf16_cstr_append(buf, p, "    bool alg0 = has0 && ((((ulong)rg0) & 3ul) == 0); bool alu0 = has0 && ((((ulong)ru0) & 3ul) == 0);\n")
    p = bf16_cstr_append(buf, p, "    bool alg1 = has1 && ((((ulong)rg1) & 3ul) == 0); bool alu1 = has1 && ((((ulong)ru1) & 3ul) == 0);\n")
    p = bf16_cstr_append(buf, p, "    float g0 = 0.0f; float u0 = 0.0f; float g1 = 0.0f; float u1 = 0.0f;\n")
    p = bf16_cstr_append(buf, p, "    for (ulong blk_base = 0ul; blk_base < n_blocks; blk_base = blk_base + 32ul) {\n")
    p = bf16_cstr_append(buf, p, "        ulong chunk_blks = min(32ul, n_blocks - blk_base); ulong k_start = blk_base << 5;\n")
    p = bf16_cstr_append(buf, p, "        for (ulong k = (ulong)tid; k < 1024ul; k = k + 256ul) { ulong gk = k_start + k; tg_x[(k >> 5) * 36ul + (k & 31ul)] = (gk < in_dim) ? in_x[gk] : 0.0f; }\n")
    p = bf16_cstr_append(buf, p, "        threadgroup_barrier(mem_flags::mem_threadgroup);\n")
    p = bf16_cstr_append(buf, p, "        for (ulong b_off = 0ul; b_off < chunk_blks; b_off = b_off + 4ul) {\n")
    p = bf16_cstr_append(buf, p, "            ulong b = b_off + b_lane;\n")
    p = bf16_cstr_append(buf, p, "            if (b < chunk_blks) {\n")
    p = bf16_cstr_append(buf, p, "                float4 x0 = *((threadgroup const float4*)(tg_x + b * 36ul + (k4 << 2)));\n")
    p = bf16_cstr_append(buf, p, "                ulong blk_byte = (blk_base + b) * 36ul;\n")
    p = bf16_cstr_append(buf, p, "                if (has0) { g0 = g0 + qwen3_q8_blk_sub(rg0 + blk_byte, x0, k4, alg0); u0 = u0 + qwen3_q8_blk_sub(ru0 + blk_byte, x0, k4, alu0); }\n")
    p = bf16_cstr_append(buf, p, "                if (has1) { g1 = g1 + qwen3_q8_blk_sub(rg1 + blk_byte, x0, k4, alg1); u1 = u1 + qwen3_q8_blk_sub(ru1 + blk_byte, x0, k4, alu1); }\n")
    p = bf16_cstr_append(buf, p, "            }\n        }\n")
    p = bf16_cstr_append(buf, p, "        threadgroup_barrier(mem_flags::mem_threadgroup);\n    }\n")
    p = bf16_cstr_append(buf, p, "    if (has0) { float sg0 = simd_sum(g0); float su0 = simd_sum(u0); if (lane == 0) out_y[r0] = (sg0 / (1.0f + exp(-sg0))) * su0; }\n")
    p = bf16_cstr_append(buf, p, "    if (has1) { float sg1 = simd_sum(g1); float su1 = simd_sum(u1); if (lane == 0) out_y[r1] = (sg1 / (1.0f + exp(-sg1))) * su1; }\n}\n\n")

    // Inline F4b conformal accumulator update (shared by BF16 & F32 fused add+accum+rmsnorm)
    p = bf16_cstr_append(buf, p, "inline void qwen3_conf_accum_update(float total_sq, float inv_rms, device uchar* conf_base, ulong conf_off, ulong weight_bits, ulong flags) {\n")
    p = bf16_cstr_append(buf, p, "    if ((flags & 2ul) != 0ul) {\n")
    p = bf16_cstr_append(buf, p, "        device float* conf_hdr = (device float*)(conf_base + conf_off);\n")
    p = bf16_cstr_append(buf, p, "        float w_l = as_type<float>((uint)weight_bits);\n")
    p = bf16_cstr_append(buf, p, "        float prev = ((flags & 1ul) != 0ul) ? conf_hdr[4] : conf_hdr[0];\n")
    p = bf16_cstr_append(buf, p, "        float dh = fma(w_l, sqrt(total_sq), prev);\n")
    p = bf16_cstr_append(buf, p, "        uint use_jac = ((device const uint*)(conf_base + conf_off))[5];\n")
    p = bf16_cstr_append(buf, p, "        if ((flags & 4ul) != 0ul && use_jac != 0u) { dh = dh * inv_rms; }\n")
    p = bf16_cstr_append(buf, p, "        conf_hdr[0] = dh;\n")
    p = bf16_cstr_append(buf, p, "    }\n}\n\n")

    // Kernel 23: qwen3_add_accum_rmsnorm_bf16 (F4b)
    p = bf16_cstr_append(buf, p, "kernel void qwen3_add_accum_rmsnorm_bf16(\n")
    p = bf16_cstr_append(buf, p, "    device uchar* x_base [[buffer(0)]], device const uchar* h_base [[buffer(1)]],\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* w_base [[buffer(2)]], device uchar* out_base [[buffer(3)]],\n")
    p = bf16_cstr_append(buf, p, "    device uchar* conf_base [[buffer(4)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& x_off [[buffer(5)]], constant ulong& h_off [[buffer(6)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& w_off [[buffer(7)]], constant ulong& out_off [[buffer(8)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& conf_off [[buffer(9)]], constant ulong& dim [[buffer(10)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& eps_bits [[buffer(11)]], constant ulong& weight_bits [[buffer(12)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& flags [[buffer(13)]], uint tid [[thread_index_in_threadgroup]]) {\n")
    p = bf16_cstr_append(buf, p, "    if (dim == 0) return;\n")
    p = bf16_cstr_append(buf, p, "    threadgroup float tg_sq[8]; threadgroup float tg_inv;\n")
    p = bf16_cstr_append(buf, p, "    device float* x = (device float*)(x_base + x_off);\n")
    p = bf16_cstr_append(buf, p, "    device const float* h = (device const float*)(h_base + h_off);\n")
    p = bf16_cstr_append(buf, p, "    device const ushort* w = (device const ushort*)(w_base + w_off);\n")
    p = bf16_cstr_append(buf, p, "    device float* out = (device float*)(out_base + out_off);\n")
    p = bf16_cstr_append(buf, p, "    float sq = 0.0f;\n")
    p = bf16_cstr_append(buf, p, "    for (ulong i = (ulong)tid; i < dim; i = i + 256ul) { float v = x[i] + h[i]; x[i] = v; sq = fma(v, v, sq); }\n")
    p = bf16_cstr_append(buf, p, "    sq = simd_sum(sq); if ((tid & 31u) == 0u) tg_sq[tid >> 5] = sq;\n")
    p = bf16_cstr_append(buf, p, "    threadgroup_barrier(mem_flags::mem_threadgroup);\n")
    p = bf16_cstr_append(buf, p, "    if (tid == 0) {\n")
    p = bf16_cstr_append(buf, p, "        float tsq = 0.0f; for (uint s = 0; s < 8; ++s) tsq = tsq + tg_sq[s];\n")
    p = bf16_cstr_append(buf, p, "        float inv_rms = rsqrt(tsq / float(dim) + as_type<float>((uint)eps_bits));\n")
    p = bf16_cstr_append(buf, p, "        tg_inv = inv_rms;\n")
    p = bf16_cstr_append(buf, p, "        qwen3_conf_accum_update(tsq, inv_rms, conf_base, conf_off, weight_bits, flags);\n")
    p = bf16_cstr_append(buf, p, "    }\n")
    p = bf16_cstr_append(buf, p, "    threadgroup_barrier(mem_flags::mem_threadgroup);\n")
    p = bf16_cstr_append(buf, p, "    float inv_rms = tg_inv;\n")
    p = bf16_cstr_append(buf, p, "    for (ulong i = (ulong)tid; i < dim; i = i + 256ul) {\n")
    p = bf16_cstr_append(buf, p, "        out[i] = x[i] * inv_rms * as_type<float>(((uint)w[i]) << 16);\n")
    p = bf16_cstr_append(buf, p, "    }\n}\n\n")

    // Kernel 24: qwen3_add_accum_rmsnorm_f32 (F4b)
    p = bf16_cstr_append(buf, p, "kernel void qwen3_add_accum_rmsnorm_f32(\n")
    p = bf16_cstr_append(buf, p, "    device uchar* x_base [[buffer(0)]], device const uchar* h_base [[buffer(1)]],\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* w_base [[buffer(2)]], device uchar* out_base [[buffer(3)]],\n")
    p = bf16_cstr_append(buf, p, "    device uchar* conf_base [[buffer(4)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& x_off [[buffer(5)]], constant ulong& h_off [[buffer(6)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& w_off [[buffer(7)]], constant ulong& out_off [[buffer(8)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& conf_off [[buffer(9)]], constant ulong& dim [[buffer(10)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& eps_bits [[buffer(11)]], constant ulong& weight_bits [[buffer(12)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& flags [[buffer(13)]], uint tid [[thread_index_in_threadgroup]]) {\n")
    p = bf16_cstr_append(buf, p, "    if (dim == 0) return;\n")
    p = bf16_cstr_append(buf, p, "    threadgroup float tg_sq[8]; threadgroup float tg_inv;\n")
    p = bf16_cstr_append(buf, p, "    device float* x = (device float*)(x_base + x_off);\n")
    p = bf16_cstr_append(buf, p, "    device const float* h = (device const float*)(h_base + h_off);\n")
    p = bf16_cstr_append(buf, p, "    device const float* w = (device const float*)(w_base + w_off);\n")
    p = bf16_cstr_append(buf, p, "    device float* out = (device float*)(out_base + out_off);\n")
    p = bf16_cstr_append(buf, p, "    float sq = 0.0f;\n")
    p = bf16_cstr_append(buf, p, "    for (ulong i = (ulong)tid; i < dim; i = i + 256ul) { float v = x[i] + h[i]; x[i] = v; sq = fma(v, v, sq); }\n")
    p = bf16_cstr_append(buf, p, "    sq = simd_sum(sq); if ((tid & 31u) == 0u) tg_sq[tid >> 5] = sq;\n")
    p = bf16_cstr_append(buf, p, "    threadgroup_barrier(mem_flags::mem_threadgroup);\n")
    p = bf16_cstr_append(buf, p, "    if (tid == 0) {\n")
    p = bf16_cstr_append(buf, p, "        float tsq = 0.0f; for (uint s = 0; s < 8; ++s) tsq = tsq + tg_sq[s];\n")
    p = bf16_cstr_append(buf, p, "        float inv_rms = rsqrt(tsq / float(dim) + as_type<float>((uint)eps_bits));\n")
    p = bf16_cstr_append(buf, p, "        tg_inv = inv_rms;\n")
    p = bf16_cstr_append(buf, p, "        qwen3_conf_accum_update(tsq, inv_rms, conf_base, conf_off, weight_bits, flags);\n")
    p = bf16_cstr_append(buf, p, "    }\n")
    p = bf16_cstr_append(buf, p, "    threadgroup_barrier(mem_flags::mem_threadgroup);\n")
    p = bf16_cstr_append(buf, p, "    float inv_rms = tg_inv;\n")
    p = bf16_cstr_append(buf, p, "    for (ulong i = (ulong)tid; i < dim; i = i + 256ul) { out[i] = x[i] * inv_rms * w[i]; }\n")
    p = bf16_cstr_append(buf, p, "}\n\n")
    buf
}

pub fn eisa_metal_pipelines_compile(s: &MetalSession) -> EisaMetalPipelines with Alloc, Mut {
    if !s.ok { return eisa_metal_pipelines_empty() }
    let c_msl = emit_eisa_kernels_msl_cstr()
    if c_msl == 0 { return eisa_metal_pipelines_empty() }
    let p_q4 = metal_compile_msl_ptr(s, c_msl, "qwen3_gemv_q4_eisa")
    let p_q8 = metal_compile_msl_ptr(s, c_msl, "qwen3_gemv_q8_eisa")
    let p_q4_quant_bf16 = metal_compile_msl_ptr(s, c_msl, "qwen3_quantize_bf16_q4_eisa")
    let p_q4_quant_f32 = metal_compile_msl_ptr(s, c_msl, "qwen3_quantize_f32_q4_eisa")
    let p_q8_quant_bf16 = metal_compile_msl_ptr(s, c_msl, "qwen3_quantize_bf16_q8_eisa")
    let p_q8_quant_f32 = metal_compile_msl_ptr(s, c_msl, "qwen3_quantize_f32_q8_eisa")
    let p_certify = metal_compile_msl_ptr(s, c_msl, "qwen3_eisa_certify_global_f32")
    let p_cone_bf16 = metal_compile_msl_ptr(s, c_msl, "qwen3_eisa_cone_refine_bf16")
    let p_cone_f32 = metal_compile_msl_ptr(s, c_msl, "qwen3_eisa_cone_refine_f32")
    heap_free(c_msl as *mut u8)
    if p_q8_quant_bf16 <= 0 || p_q8_quant_f32 <= 0 { return eisa_metal_pipelines_empty() }
    if p_certify <= 0 || p_cone_bf16 <= 0 || p_cone_f32 <= 0 { return eisa_metal_pipelines_empty() }
    if p_q4 <= 0 || p_q8 <= 0 || p_q4_quant_bf16 <= 0 || p_q4_quant_f32 <= 0 {
        return eisa_metal_pipelines_empty()
    }
    EisaMetalPipelines {
        q4_gemv: p_q4,
        q8_gemv: p_q8,
        q4_quant_bf16: p_q4_quant_bf16,
        q4_quant_f32: p_q4_quant_f32,
        q8_quant_bf16: p_q8_quant_bf16,
        q8_quant_f32: p_q8_quant_f32,
        certify_global: p_certify,
        cone_refine_bf16: p_cone_bf16,
        cone_refine_f32: p_cone_f32,
        ok: true,
    }
}

pub fn conformal_q8_metal_pipelines_compile(s: &MetalSession) -> ConformalQ8MetalPipelines with Alloc, Mut {
    if !s.ok { return conformal_q8_metal_pipelines_empty() }
    let c_msl = emit_eisa_kernels_msl_cstr()
    if c_msl == 0 { return conformal_q8_metal_pipelines_empty() }
    let p_fast = metal_compile_msl_ptr(s, c_msl, "qwen3_gemv_q8_fast")
    let p_vec = metal_compile_msl_ptr(s, c_msl, "qwen3_vec_add_accum_norm_f32")
    let p_rs_bf16 = metal_compile_msl_ptr(s, c_msl, "qwen3_compute_row_scale_bf16")
    let p_rs_f32 = metal_compile_msl_ptr(s, c_msl, "qwen3_compute_row_scale_f32")
    let p_head = metal_compile_msl_ptr(s, c_msl, "qwen3_gemv_q8_conformal_head")
    let p_q4_fast = metal_compile_msl_ptr(s, c_msl, "qwen3_gemv_q4_fast")
    let p_smax = metal_compile_msl_ptr(s, c_msl, "qwen3_compute_tile_smax_f32")
    let p_q4_tiled = metal_compile_msl_ptr(s, c_msl, "qwen3_gemv_q4_head_tiled")
    let p_q8_tiled = metal_compile_msl_ptr(s, c_msl, "qwen3_gemv_q8_head_tiled")
    let p_pruned = metal_compile_msl_ptr(s, c_msl, "qwen3_certify_pruned_conformal_f32")
    let p_q4_qkv = metal_compile_msl_ptr(s, c_msl, "qwen3_gemv_q4_qkv_fast")
    let p_q8_qkv = metal_compile_msl_ptr(s, c_msl, "qwen3_gemv_q8_qkv_fast")
    let p_q4_mlp = metal_compile_msl_ptr(s, c_msl, "qwen3_gemv_q4_gate_up_swiglu")
    let p_q8_mlp = metal_compile_msl_ptr(s, c_msl, "qwen3_gemv_q8_gate_up_swiglu")
    let p_add_acc_bf16 = metal_compile_msl_ptr(s, c_msl, "qwen3_add_accum_rmsnorm_bf16")
    let p_add_acc_f32 = metal_compile_msl_ptr(s, c_msl, "qwen3_add_accum_rmsnorm_f32")
    heap_free(c_msl as *mut u8)
    if p_fast <= 0 || p_vec <= 0 || p_rs_bf16 <= 0 || p_rs_f32 <= 0 || p_head <= 0
        || p_q4_fast <= 0 || p_smax <= 0 || p_q4_tiled <= 0 || p_q8_tiled <= 0 || p_pruned <= 0
        || p_q4_qkv <= 0 || p_q8_qkv <= 0 || p_q4_mlp <= 0 || p_q8_mlp <= 0
        || p_add_acc_bf16 <= 0 || p_add_acc_f32 <= 0 {
        return conformal_q8_metal_pipelines_empty()
    }
    ConformalQ8MetalPipelines {
        q8_gemv_fast: p_fast,
        vec_add_accum_norm: p_vec,
        compute_row_scale_bf16: p_rs_bf16,
        compute_row_scale_f32: p_rs_f32,
        q8_gemv_conformal_head: p_head,
        q4_gemv_fast: p_q4_fast,
        compute_tile_smax: p_smax,
        q4_head_tiled: p_q4_tiled,
        q8_head_tiled: p_q8_tiled,
        certify_pruned: p_pruned,
        q4_qkv_fast: p_q4_qkv,
        q8_qkv_fast: p_q8_qkv,
        q4_gate_up_swiglu: p_q4_mlp,
        q8_gate_up_swiglu: p_q8_mlp,
        add_accum_rmsnorm_bf16: p_add_acc_bf16,
        add_accum_rmsnorm_f32: p_add_acc_f32,
        ok: true,
    }
}

pub fn qwen3_metal_encode_quantize_q4_eisa(
    s: &MetalSession,
    cid: i64,
    pipe: i64,
    src_buf: i64,
    src_byte_off: i64,
    dst_buf: i64,
    dst_byte_off: i64,
    out_dim: i64,
    in_dim: i64
) -> i64 {
    if !s.ok || cid <= 0 || pipe <= 0 || src_buf <= 0 || dst_buf <= 0 || out_dim <= 0 || in_dim <= 0 {
        return -1
    }
    if metal_cmd_set_buf(s, cid, 0, src_buf, 0) != 0
        || metal_cmd_set_buf(s, cid, 1, dst_buf, 0) != 0
        || metal_cmd_set_u64(s, cid, 2, src_byte_off) != 0
        || metal_cmd_set_u64(s, cid, 3, dst_byte_off) != 0
        || metal_cmd_set_u64(s, cid, 4, out_dim) != 0
        || metal_cmd_set_u64(s, cid, 5, in_dim) != 0 {
        return -1
    }
    let n_blocks = (in_dim + 31) / 32
    let total_threads = out_dim * n_blocks
    let group_threads = if total_threads < 128 { 32 } else { 128 }
    if metal_cmd_dispatch_1d(s, cid, pipe, total_threads, group_threads) != 0 {
        return -1
    }
    0
}

