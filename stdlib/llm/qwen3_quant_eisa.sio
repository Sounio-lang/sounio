pub fn qwen3_gemv_q8_fast_cpu(
    q8_ptr: i64,
    x_f32_ptr: i64,
    val_f32_ptr: i64,
    out_dim: i64,
    in_dim: i64
) -> bool with Mut, Div {
    if q8_ptr == 0 || x_f32_ptr == 0 || val_f32_ptr == 0 || out_dim <= 0 || in_dim <= 0 {
        return false
    }
    let n_blocks = (in_dim + 31) / 32
    var r: i64 = 0
    while r < out_dim {
        var val_sum: f64 = 0.0
        var b: i64 = 0
        while b < n_blocks {
            let blk_off = (r * n_blocks + b) * 36
            let s_bits = ptr_read_u16_le(q8_ptr, blk_off)
            let s = f16_bits_to_f64(s_bits)
            let base_k = b * 32
            var dot_b: f64 = 0.0
            var k: i64 = 0
            while k < 32 {
                let idx = base_k + k
                if idx < in_dim {
                    let raw_b = ptr_read_u8(q8_ptr, blk_off + 4 + k)
                    let q_signed = if raw_b >= 128 { raw_b - 256 } else { raw_b }
                    let x = f32_bits_to_f64(ptr_read_u32_le(x_f32_ptr, idx * 4))
                    dot_b = dot_b + (q_signed as f64) * x
                }
                k = k + 1
            }
            val_sum = val_sum + s * dot_b
            b = b + 1
        }
        let _wv = ptr_write_u32_le(val_f32_ptr, r * 4, f64_to_f32_bits(val_sum))
        r = r + 1
    }
    true
}

pub fn qwen3_vec_add_accum_norm_cpu(
    a_f32_ptr: i64,
    b_f32_ptr: i64,
    conf_ptr: i64,
    len: i64,
    weight: f64,
    reset_flag: i64
) -> bool with Mut, Div {
    if a_f32_ptr == 0 || b_f32_ptr == 0 || conf_ptr == 0 || len <= 0 {
        return false
    }
    var sq: f64 = 0.0
    var i: i64 = 0
    while i < len {
        let va = f32_bits_to_f64(ptr_read_u32_le(a_f32_ptr, i * 4))
        let vb = f32_bits_to_f64(ptr_read_u32_le(b_f32_ptr, i * 4))
        let v = va + vb
        let _wa = ptr_write_u32_le(a_f32_ptr, i * 4, f64_to_f32_bits(v))
        sq = sq + v * v
        i = i + 1
    }
    let prev = if reset_flag != 0 {
        f32_bits_to_f64(ptr_read_u32_le(conf_ptr, 16))
    } else {
        f32_bits_to_f64(ptr_read_u32_le(conf_ptr, 0))
    }
    let next = prev + weight * sqrt(sq)
    let _wc = ptr_write_u32_le(conf_ptr, 0, f64_to_f32_bits(next))
    true
}

pub fn qwen3_compute_row_scale_cpu(
    w_ptr: i64,
    w_dtype: i32,
    conf_ptr: i64,
    out_dim: i64,
    in_dim: i64
) -> bool with Mut, Div {
    if w_ptr == 0 || conf_ptr == 0 || out_dim <= 0 || in_dim <= 0 {
        return false
    }
    let inv_sqrt_d = 1.0 / sqrt(in_dim as f64)
    var r: i64 = 0
    while r < out_dim {
        var sq: f64 = 0.0
        var k: i64 = 0
        while k < in_dim {
            let idx = r * in_dim + k
            let w = if w_dtype == 2 {
                bf16_bits_to_f64(ptr_read_u16_le(w_ptr, idx * 2))
            } else {
                f32_bits_to_f64(ptr_read_u32_le(w_ptr, idx * 4))
            }
            sq = sq + w * w
            k = k + 1
        }
        let sc = sqrt(sq) * inv_sqrt_d
        let _ws = ptr_write_u32_le(conf_ptr, 64 + r * 4, f64_to_f32_bits(sc))
        r = r + 1
    }
    true
}

pub fn qwen3_gemv_q8_conformal_head_cpu(
    q8_ptr: i64,
    x_f32_ptr: i64,
    conf_ptr: i64,
    val_f32_ptr: i64,
    err_f32_ptr: i64,
    out_dim: i64,
    in_dim: i64
) -> bool with Mut, Div {
    if conf_ptr == 0 || val_f32_ptr == 0 || err_f32_ptr == 0 {
        return false
    }
    if !qwen3_gemv_q8_fast_cpu(q8_ptr, x_f32_ptr, val_f32_ptr, out_dim, in_dim) {
        return false
    }
    let raw_dh = f32_bits_to_f64(ptr_read_u32_le(conf_ptr, 0))
    let dh_hat = if raw_dh > 0.000001 { raw_dh } else { 0.000001 }
    let q_val = f32_bits_to_f64(ptr_read_u32_le(conf_ptr, 4))
    let scale_factor = q_val * dh_hat
    var r: i64 = 0
    while r < out_dim {
        let ws = f32_bits_to_f64(ptr_read_u32_le(conf_ptr, 64 + r * 4))
        let _we = ptr_write_u32_le(err_f32_ptr, r * 4, f64_to_f32_bits(scale_factor * ws))
        r = r + 1
    }
    true
}

