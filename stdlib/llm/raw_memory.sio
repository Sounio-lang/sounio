// The v2 runtime previously depended on out-of-tree ptr_* compiler builtins.
// The supported Linux x86-64 and macOS arm64 targets are little endian and
// permit these unaligned scalar loads/stores. Callers own the mapped extent.
pub fn ptr_read_u8(base: i64, off: i64) -> i64 {
    let p = (base + off) as *mut u8
    (*p) as i64
}
pub fn ptr_read_u16_le(base: i64, off: i64) -> i64 {
    let p = (base + off) as *mut u16
    ((*p) as i64) & 65535
}
pub fn ptr_read_u32_le(base: i64, off: i64) -> i64 {
    let p = (base + off) as *mut u32
    ((*p) as i64) & 4294967295
}
pub fn ptr_read_i64_le(base: i64, off: i64) -> i64 {
    let p = (base + off) as *mut i64
    *p
}
pub fn ptr_write_u8(base: i64, off: i64, v: i64) -> i64 with Mut {
    let p = (base + off) as *mut u8
    (*p) = (v & 255) as u8
    0
}
pub fn ptr_write_u16_le(base: i64, off: i64, v: i64) -> i64 with Mut {
    let p = (base + off) as *mut u16
    (*p) = (v & 65535) as u16
    0
}
pub fn ptr_write_u32_le(base: i64, off: i64, v: i64) -> i64 with Mut {
    let p = (base + off) as *mut u32
    (*p) = (v & 4294967295) as u32
    0
}
pub fn ptr_write_i64_le(base: i64, off: i64, v: i64) -> i64 with Mut {
    let p = (base + off) as *mut i64
    (*p) = v
    0
}
