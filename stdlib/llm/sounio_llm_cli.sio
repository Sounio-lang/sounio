fn sounio_llm_trace_steps_enabled() -> bool with Alloc, Mut {
    let p = hal_getenv_ptr("SOUNIO_LLM_TRACE_STEPS")
    if p == 0 { return false }
    ptr_read_u8(p, 0) == 49 && ptr_read_u8(p, 1) == 0
}

fn sounio_llm_parse_env_pos_f64(var_name: string) -> f64 with Alloc, Mut, Div {
    let p = hal_getenv_ptr(var_name)
    if p == 0 { return -1.0 }
    var int_part: f64 = 0.0
    var frac_part: f64 = 0.0
    var frac_div: f64 = 1.0
    var seen_dot = false
    var seen_digit = false
    var i: i64 = 0
    while true {
        let b = ptr_read_u8(p, i)
        if b == 0 { break }
        if b == 46 {
            seen_dot = true
        } else if b >= 48 && b <= 57 {
            seen_digit = true
            let d = (b - 48) as f64
            if seen_dot {
                frac_div = frac_div * 10.0
                frac_part = frac_part + d / frac_div
            } else {
                int_part = int_part * 10.0 + d
            }
        } else {
            break
        }
        i = i + 1
    }
    if !seen_digit { return -1.0 }
    int_part + frac_part
}

fn sounio_llm_parse_env_nonneg_i64(var_name: string) -> i64 with Alloc, Mut {
    let p = hal_getenv_ptr(var_name)
    if p == 0 { return -1 }
    var val: i64 = 0
    var seen_digit = false
    var i: i64 = 0
    while true {
        let b = ptr_read_u8(p, i)
        if b == 0 { break }
        if b >= 48 && b <= 57 {
            seen_digit = true
            val = val * 10 + (b - 48)
        } else {
            return -1
        }
        i = i + 1
    }
    if !seen_digit { return -1 }
    val
}

fn sounio_llm_apply_conformal_q_override(conf: &!Qwen3ConformalCtx, q_override: f64) with Alloc, Mut, Div {
    if !qwen3_conformal_ctx_is_ok(conf) { return }
    if q_override >= 0.0 {
        let _sq = qwen3_conformal_ctx_set_q(conf, q_override)
        return
    }
    let q_env = sounio_llm_parse_env_pos_f64("SOUNIO_CONFORMAL_Q")
    if q_env >= 0.0 {
        let _sq = qwen3_conformal_ctx_set_q(conf, q_env)
    }
}

pub const SOUNIO_LLM_PROVENANCE_UNCERTIFIED: i64 = 0
pub const SOUNIO_LLM_PROVENANCE_VERIFIED_EXACT: i64 = 1

pub const SOUNIO_LLM_EXACTNESS_UNCERTIFIED: i64 = 0
pub const SOUNIO_LLM_EXACTNESS_VERIFIED_EXACT: i64 = 1
pub const SOUNIO_LLM_HISTORY_UNCOMPARED: i64 = 0
pub const SOUNIO_LLM_HISTORY_VENDOR_PREFILL: i64 = 1
pub const SOUNIO_LLM_HISTORY_CROSS_BACKEND_IDENTICAL: i64 = 2
pub const SOUNIO_LLM_HISTORY_CROSS_BACKEND_DIVERGENT: i64 = 3

pub fn sounio_llm_float_model_contract() -> string {
    "binary32, round-to-nearest-even, FTZ+DAZ, fixed op order"
}

fn sounio_llm_provenance_label(prov: i64) -> string {
    if prov == SOUNIO_LLM_PROVENANCE_VERIFIED_EXACT { "VERIFIED_EXACT" } else { "UNCERTIFIED" }
}

fn sounio_llm_exactness_label(exactness: i64) -> string {
    if exactness == SOUNIO_LLM_EXACTNESS_VERIFIED_EXACT { "VERIFIED_EXACT" } else { "UNCERTIFIED" }
}

fn sounio_llm_history_label(history: i64) -> string {
    if history == SOUNIO_LLM_HISTORY_VENDOR_PREFILL {
        "VENDOR_PREFILL"
    } else if history == SOUNIO_LLM_HISTORY_CROSS_BACKEND_IDENTICAL {
        "CROSS_BACKEND_IDENTICAL"
    } else if history == SOUNIO_LLM_HISTORY_CROSS_BACKEND_DIVERGENT {
        "CROSS_BACKEND_DIVERGENT"
    } else {
        "UNCOMPARED"
    }
}

fn sounio_llm_pack_provenance(exactness: i64, history: i64) -> i64 {
    (exactness & 1) | ((history & 3) << 1)
}

fn sounio_llm_unpack_exactness(prov: i64) -> i64 {
    prov & 1
}

fn sounio_llm_unpack_history(prov: i64) -> i64 {
    (prov >> 1) & 3
}

pub fn sounio_llm_print_run_header() with Alloc, Mut, Panic, Div, IO {
    let hex = heap_alloc(80) as i64
    let has_sha = if hex != 0 { hal_self_binary_sha256_hex(hex) } else { false }
    print("[run_header binary_sha256=")
    if has_sha {
        var hi: i64 = 0
        while hi < 64 {
            let b = ptr_read_u8(hex, hi)
            if b == 0 { break }
            print_char(b as i32)
            hi = hi + 1
        }
    } else {
        print("unavailable")
    }
    if hex != 0 { heap_free(hex as *mut u8) }
    print(" float_model=\"")
    print(sounio_llm_float_model_contract())
    println("\"]")
}

fn sounio_llm_record_trace_step(
    trace_buf: i64,
    idx: i64,
    tok_id: i64,
    q8_top1_id: i64,
    cert_flag: i64,
    esc_flag: i64,
    prov_flag: i64,
    margin: f64
) with Mut {
    let off = idx * 32
    let _w0 = ptr_write_i64_le(trace_buf, off + 0, tok_id)
    let _w1 = ptr_write_i64_le(trace_buf, off + 8, q8_top1_id)
    let _w2c = ptr_write_u32_le(trace_buf, off + 16, cert_flag as u32)
    let _w2p = ptr_write_u32_le(trace_buf, off + 20, prov_flag as u32)
    let _w3 = ptr_write_u32_le(trace_buf, off + 24, esc_flag as u32)
    let _w4 = ptr_write_u32_le(trace_buf, off + 28, f64_to_f32_bits(margin))
}

fn sounio_llm_count_verified_exact(trace_buf: i64, count: i64) -> i64 with Mut {
    if trace_buf == 0 || count <= 0 { return 0 }
    var cnt: i64 = 0
    var k: i64 = 0
    while k < count {
        let pv = ptr_read_u32_le(trace_buf, k * 32 + 20) as i64
        if sounio_llm_unpack_exactness(pv) == SOUNIO_LLM_EXACTNESS_VERIFIED_EXACT {
            cnt = cnt + 1
        }
        k = k + 1
    }
    cnt
}

fn sounio_llm_emit_token_provenance(prompt_idx: i64, trace_buf: i64, count: i64) with IO, Mut {
    if trace_buf == 0 || count <= 0 { return }
    if prompt_idx >= 0 {
        print("[bench_provenance idx=")
        print_int(prompt_idx)
        print(" n=")
        print_int(count)
        print(" labels=")
        var k: i64 = 0
        while k < count {
            if k > 0 { print(",") }
            let pv = ptr_read_u32_le(trace_buf, k * 32 + 20) as i64
            print("exactness=")
            print(sounio_llm_exactness_label(sounio_llm_unpack_exactness(pv)))
            print("/history=")
            print(sounio_llm_history_label(sounio_llm_unpack_history(pv)))
            k = k + 1
        }
        print("]\n")
    } else {
        print("[token_provenance n=")
        print_int(count)
        print(" tokens=")
        var k: i64 = 0
        while k < count {
            if k > 0 { print(",") }
            let off = k * 32
            let tok_id = ptr_read_i64_le(trace_buf, off + 0)
            let pv = ptr_read_u32_le(trace_buf, off + 20) as i64
            print_int(tok_id)
            print(":exactness=")
            print(sounio_llm_exactness_label(sounio_llm_unpack_exactness(pv)))
            print("/history=")
            print(sounio_llm_history_label(sounio_llm_unpack_history(pv)))
            k = k + 1
        }
        print("]\n")
    }
}

fn sounio_llm_emit_step_trace_impl(prompt_idx: i64, trace_buf: i64, count: i64) with IO, Mut {
    var k: i64 = 0
    while k < count {
        let off = k * 32
        let tok_id = ptr_read_i64_le(trace_buf, off + 0)
        let q8_id = ptr_read_i64_le(trace_buf, off + 8)
        let cert_flag = ptr_read_u32_le(trace_buf, off + 16) as i64
        let prov_flag = ptr_read_u32_le(trace_buf, off + 20) as i64
        let esc_bits = ptr_read_u32_le(trace_buf, off + 24)
        let esc_flag = esc_bits as i64
        let m_val = f32_bits_to_f64(ptr_read_u32_le(trace_buf, off + 28))
        print("[trace_step")
        if prompt_idx >= 0 {
            print(" prompt=")
            print_int(prompt_idx)
        }
        print(" idx=")
        print_int(k)
        print(" tok=")
        print_int(tok_id)
        print(" q8_top1=")
        print_int(q8_id)
        print(" cert=")
        print_int(cert_flag)
        print(" esc=")
        print_int(esc_flag)
        print(" margin=")
        print_f64(m_val)
        print(" exactness=")
        print(sounio_llm_exactness_label(sounio_llm_unpack_exactness(prov_flag)))
        print(" history=")
        print(sounio_llm_history_label(sounio_llm_unpack_history(prov_flag)))
        print("]\n")
        k = k + 1
    }
}

fn sounio_llm_emit_step_trace(trace_buf: i64, count: i64) with IO, Mut {
    sounio_llm_emit_step_trace_impl(-1, trace_buf, count)
}

