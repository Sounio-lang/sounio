// Shared scalar top-two reduction for the BF16 audit (ascending index tie break).
use llm::raw_memory::{ptr_read_u32_le, ptr_write_i64_le, ptr_write_u32_le}
use tensor2::convert::{f32_bits_to_f64}

pub fn qwen3_cpu_top2(base: i64, out: i64, vocab: i64) -> i64 with Mut {
    if base == 0 || out == 0 || vocab <= 0 { return -1 }
    var t1_id: i64 = 0
    var t1_v = f32_bits_to_f64(ptr_read_u32_le(base, 0))
    var t1_bits = ptr_read_u32_le(base, 0)
    var t2_id: i64 = 0
    var t2_v = t1_v
    var t2_bits = t1_bits
    if vocab >= 2 {
        let b1 = ptr_read_u32_le(base, 4)
        let v1 = f32_bits_to_f64(b1)
        if v1 > t1_v {
            t2_id = t1_id
            t2_v = t1_v
            t2_bits = t1_bits
            t1_id = 1
            t1_v = v1
            t1_bits = b1
        } else {
            t2_id = 1
            t2_v = v1
            t2_bits = b1
        }
        var i: i64 = 2
        while i < vocab {
            let bi = ptr_read_u32_le(base, i * 4)
            let v = f32_bits_to_f64(bi)
            if v > t1_v {
                t2_id = t1_id
                t2_v = t1_v
                t2_bits = t1_bits
                t1_id = i
                t1_v = v
                t1_bits = bi
            } else if v > t2_v {
                t2_id = i
                t2_v = v
                t2_bits = bi
            }
            i = i + 1
        }
    }
    let _w0 = ptr_write_i64_le(out, 0, t1_id)
    let _w1 = ptr_write_i64_le(out, 8, t2_id)
    let _w2 = ptr_write_u32_le(out, 16, t1_bits)
    let _w3 = ptr_write_u32_le(out, 20, t2_bits)
    0
}

