//! stdlib/llm — native LLM inference over the heterogeneous runtime.
//!
//! safetensors loading, Llama-family forward (DecoderBlock arch:
//! Llama/Mistral/Qwen2-style), KV cache, BPE tokenizer. Built on
//! Tensor2/CpuBuf masters and the hetero planner/runtime; design:
//! docs/design/heterogeneous-gpu-framework.md (Fase 5).

module llm

pub use llm::safetensors::{
    StEntry,
    StFile,
    st_byte_at,
    st_dtype_bf16,
    st_dtype_f16,
    st_dtype_f32,
    st_dtype_f64,
    st_dtype_i64,
    st_find,
    st_load_f64,
    st_read_all,
    st_scan_bool,
    st_scan_f64,
    st_scan_i64,
}


pub use llm::gguf::{
    GgufFile,
    GgufTensor,
    gguf_byte_at,
    gguf_dtype_f16,
    gguf_dtype_f32,
    gguf_dtype_q4_k,
    gguf_dtype_q5_k,
    gguf_dtype_q8_0,
    gguf_moe_quant_for_dtype,
    gguf_row_quant_bytes,
    gguf_find,
    gguf_open,
    gguf_kv_f32,
    gguf_kv_u32,
    gguf_tensor_off,
    gguf_type_array,
    gguf_type_f32,
    gguf_type_string,
    gguf_type_u32,
}

pub use llm::llama::{
    KvCache,
    Llama,
    LlamaCfg,
    kv_new,
    llama_argmax,
    llama_cfg,
    llama_forward,
    llama_forward_rt,
    llama_load,
    llama_load_moe,
    llama_load_gguf,
}

pub use llm::bpe::{
    Bpe,
    bpe_decode_token,
    bpe_encode,
    bpe_load,
    bpe_lookup,
}

pub use llm::serve::{
    SV_MAX_SESS,
    llm_serve,
    sv_completion_body,
    sv_now_ns,
    sv_parse_params,
    sv_sse_done,
    sv_sse_token,
}

pub use llm::attn_gpu::{
    AttnKernels,
    AttnPacks,
    GenCfg,
    attn_bind_gguf_layer,
    attn_gpu_status,
    attn_kernels_empty,
