//! stdlib/llm — native LLM inference over the heterogeneous runtime.
//!
//! safetensors loading, Llama-family forward (DecoderBlock arch:
//! Llama/Mistral/Qwen2-style), KV cache, BPE tokenizer. Built on
//! Tensor2/CpuBuf masters and the hetero planner/runtime; design:
//! docs/design/heterogeneous-gpu-framework.md (Fase 5).

module llm

pub use llm::safetensors::{
    StEntry,
    StFile,
    st_byte_at,
    st_dtype_bf16,
    st_dtype_f16,
    st_dtype_f32,
    st_dtype_f64,
    st_dtype_i64,
    st_find,
    st_load_f64,
    st_read_all,
    st_scan_bool,
    st_scan_f64,
    st_scan_i64,
}

pub use llm::llama::{
    KvCache,
    Llama,
    LlamaCfg,
    kv_new,
    llama_argmax,
    llama_cfg,
    llama_forward,
    llama_forward_rt,
    llama_load,
}

pub use llm::bpe::{
    Bpe,
    bpe_decode_token,
    bpe_encode,
    bpe_load,
    bpe_lookup,
}

pub use llm::serve::{
    llm_serve,
}

pub use llm::sample::{
    Rng,
    rng_f64,
    rng_new,
    sample_token,
}
