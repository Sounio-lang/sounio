pub fn emit_ossm_kernels_ptx_cstr() -> i64 with Alloc, Mut {
    emit_ossm_ptx_sm80_cstr()
}

pub fn qwen3_cuda_ossm_step(
    s: &CudaDriverSession,
    hfn: i64,
    d_st: i64,
    d_u: i64,
    d_alpha: i64,
    d_b: i64,
    d_dt: i64,
    d_c: i64,
    d_y: i64,
    n_oct: i64
) -> i64 with Alloc {
    cuda_launch_8param_1d(s, hfn, n_oct, 1, d_st, d_u, d_alpha, d_b, d_dt, d_c, d_y, n_oct)
}

// ============================================================================
// Internal CPU Neural Computation Helpers for Forward Pass
// ============================================================================

fn ossm_cpu_rmsnorm(
    x_ptr: i64,
    w_ptr: i64,
    w_dtype: i32,
    out_ptr: i64,
    n_groups: i64,
    dim: i64,
    eps: f64
) with Mut, Div, Panic {
    if x_ptr <= 0 || w_ptr <= 0 || out_ptr <= 0 || n_groups <= 0 || dim <= 0 { return }
    var g: i64 = 0
    while g < n_groups {
        let in_head = x_ptr + g * dim * 4
        let out_head = out_ptr + g * dim * 4
        var sum_sq: f64 = 0.0
        var i: i64 = 0
        while i < dim {
            let v = ossm_read_f32(in_head, i)
            sum_sq = sum_sq + v * v
            i = i + 1
        }
        let inv_rms = 1.0 / sqrt(sum_sq / (dim as f64) + eps)
        i = 0
        while i < dim {
            let v = ossm_read_f32(in_head, i)
            let w = if w_dtype == 2 {
                bf16_bits_to_f64_exact(ptr_read_u16_le(w_ptr, i * 2))
            } else {
                ossm_read_f32(w_ptr, i)
            }
            let res = v * inv_rms * w
            ossm_write_f32(out_head, i, res)
            i = i + 1
        }
        g = g + 1
    }
}

fn ossm_cpu_gemv(
    w_ptr: i64,
    w_dtype: i32,
    x_ptr: i64,
    y_ptr: i64,
    out_dim: i64,
    in_dim: i64
) with Mut, Div {
    if w_ptr <= 0 || x_ptr <= 0 || y_ptr <= 0 || out_dim <= 0 || in_dim <= 0 { return }
    let w_elem_bytes: i64 = if w_dtype == 2 { 2 } else { 4 }
    var r: i64 = 0
    while r < out_dim {
        let row_p = w_ptr + r * in_dim * w_elem_bytes
        var sum: f64 = 0.0
        var c: i64 = 0
        while c < in_dim {
            let xv = ossm_read_f32(x_ptr, c)
            let wv = if w_dtype == 2 {
                bf16_bits_to_f64_exact(ptr_read_u16_le(row_p, c * 2))
            } else {
                ossm_read_f32(row_p, c)
            }
            sum = sum + wv * xv
            c = c + 1
        }
        ossm_write_f32(y_ptr, r, sum)
        r = r + 1
    }
}

fn ossm_cpu_rope(
    v_ptr: i64,
    n_heads: i64,
    head_dim: i64,
    pos: i64,
    theta: f64
) with Mut, Div, Panic {
    if v_ptr <= 0 || n_heads <= 0 || head_dim <= 0 { return }
    let half = head_dim / 2
    if half <= 0 { return }
    var h: i64 = 0
    while h < n_heads {
        let h_base = v_ptr + h * head_dim * 4
        var j: i64 = 0
        while j < half {
            let freq = 1.0 / pow(theta, (2.0 * (j as f64)) / (head_dim as f64))
            let angle = (pos as f64) * freq
            let cos_a = cos(angle)
            let sin_a = sin(angle)
            let x0 = ossm_read_f32(h_base, j)
            let x1 = ossm_read_f32(h_base, j + half)
            let y0 = x0 * cos_a - x1 * sin_a
            let y1 = x1 * cos_a + x0 * sin_a
            ossm_write_f32(h_base, j, y0)
            ossm_write_f32(h_base, j + half, y1)
            j = j + 1
        }
        h = h + 1
    }
}

fn ossm_cpu_paged_gqa(
    q_ptr: i64,
    kv: &Qwen3PagedKv,
    layer: i64,
    out_ptr: i64,
    n_q: i64,
    n_kv: i64,
    head_dim: i64,
    pos: i64
) with Mut, Div, Panic {
    if q_ptr <= 0 || out_ptr <= 0 || n_q <= 0 || n_kv <= 0 || head_dim <= 0 || pos < 0 { return }
    let scale = 1.0 / sqrt(head_dim as f64)
    let group_size = n_q / n_kv
    let seq_len = pos + 1

    var qh: i64 = 0
    while qh < n_q {
        let kvh = qh / group_size
        let q_head_ptr = q_ptr + qh * head_dim * 4

        var max_s: f64 = -1e30
        var t: i64 = 0
        while t < seq_len {
            var dot: f64 = 0.0
            var d: i64 = 0
            while d < head_dim {
                let qd = ossm_read_f32(q_head_ptr, d)
                let kd = qwen3_kv_read_k_f64(kv, layer, t, kvh, d)
                dot = dot + qd * kd
                d = d + 1
            }
            let s = dot * scale
            if s > max_s { max_s = s }
            t = t + 1
        }

        var sum_exp: f64 = 0.0
        t = 0
        while t < seq_len {
            var dot: f64 = 0.0
            var d: i64 = 0
            while d < head_dim {
                let qd = ossm_read_f32(q_head_ptr, d)
                let kd = qwen3_kv_read_k_f64(kv, layer, t, kvh, d)
                dot = dot + qd * kd
                d = d + 1
            }
            let s = dot * scale
            sum_exp = sum_exp + exp(s - max_s)
            t = t + 1
        }
        if sum_exp <= 0.0 { sum_exp = 1.0 }

        var d: i64 = 0
        while d < head_dim {
            var accum: f64 = 0.0
            t = 0
            while t < seq_len {
                var dot: f64 = 0.0
                var di: i64 = 0
                while di < head_dim {
                    let qd = ossm_read_f32(q_head_ptr, di)
                    let kd = qwen3_kv_read_k_f64(kv, layer, t, kvh, di)
                    dot = dot + qd * kd
                    di = di + 1
                }
                let s = dot * scale
                let weight = exp(s - max_s) / sum_exp
                let vd = qwen3_kv_read_v_f64(kv, layer, t, kvh, d)
                accum = accum + weight * vd
                t = t + 1
            }
            ossm_write_f32(out_ptr, qh * head_dim + d, accum)
            d = d + 1
        }

        qh = qh + 1
    }
}

fn ossm_cpu_swiglu(gate_ptr: i64, up_ptr: i64, out_ptr: i64, inter_dim: i64) with Mut, Div {
    if gate_ptr <= 0 || up_ptr <= 0 || out_ptr <= 0 || inter_dim <= 0 { return }
    var j: i64 = 0
    while j < inter_dim {
        let g = ossm_read_f32(gate_ptr, j)
        let u = ossm_read_f32(up_ptr, j)
        let silu_g = g / (1.0 + exp(0.0 - g))
        let out = silu_g * u
        ossm_write_f32(out_ptr, j, out)
        j = j + 1
    }
}

fn ossm_cpu_vec_add(a_ptr: i64, b_ptr: i64, len: i64) with Mut, Div {
    if a_ptr <= 0 || b_ptr <= 0 || len <= 0 { return }
    var i: i64 = 0
    while i < len {
        let va = ossm_read_f32(a_ptr, i)
        let vb = ossm_read_f32(b_ptr, i)
        ossm_write_f32(a_ptr, i, va + vb)
        i = i + 1
    }
}

// ============================================================================
// Hybrid Forward Wrapper
// ============================================================================

fn ossm_model_write_top2_cpu(m: &Qwen3Model) -> i64 with Mut {
    if !m.ok || m.cfg.vocab <= 0 { return 0 }
    let a_base = page_arena_ptr(&m.arena)
    let base = a_base + m.buf_logits_off
    let out = a_base + m.buf_top2_off
    var t1_id: i64 = 0
    var t1_v = f32_bits_to_f64(ptr_read_u32_le(base, 0))
    var t1_bits = ptr_read_u32_le(base, 0)
    var t2_id: i64 = 0
    var t2_v = t1_v
    var t2_bits = t1_bits
    if m.cfg.vocab >= 2 {
        let b1 = ptr_read_u32_le(base, 4)
        let v1 = f32_bits_to_f64(b1)
        if v1 > t1_v {
            t2_id = t1_id
            t2_v = t1_v
            t2_bits = t1_bits
            t1_id = 1
            t1_v = v1
            t1_bits = b1
        } else {
            t2_id = 1
            t2_v = v1
            t2_bits = b1
        }
        var i: i64 = 2
        while i < m.cfg.vocab {
            let bi = ptr_read_u32_le(base, i * 4)
            let v = f32_bits_to_f64(bi)
            if v > t1_v {
                t2_id = t1_id
                t2_v = t1_v
                t2_bits = t1_bits
                t1_id = i
                t1_v = v
                t1_bits = bi
            } else if v > t2_v {
                t2_id = i
                t2_v = v
                t2_bits = bi
            }
            i = i + 1
        }
    }
    let _w0 = ptr_write_i64_le(out, 0, t1_id)
    let _w1 = ptr_write_i64_le(out, 8, t2_id)
    let _w2 = ptr_write_u32_le(out, 16, t1_bits)
    let _w3 = ptr_write_u32_le(out, 20, t2_bits)
    0
}

pub fn qwen3_hybrid_forward_token_cpu_sidecar(
    m: &Qwen3Model,
    kv: &!Qwen3PagedKv,
    ossm: &!Qwen3OssmState,
    sidecar: &Qwen3OssmSidecar,
    ossm_every: i64,
    token_id: i64,
    pos: i64,
    compute_logits: bool,
    last_assoc_out_ptr: i64
) -> bool with Alloc, Mut, Div, Panic {
    if !qwen3_model_is_ok(m) || !qwen3_kv_is_ok(kv) || token_id < 0 || token_id >= m.cfg.vocab || pos < 0 {
        return false
    }

    let a_base = qwen3_model_work_ptr(m)
    let buf_x = a_base + m.buf_x_off
    let buf_h = a_base + m.buf_h_off
    let buf_q = a_base + m.buf_q_off
    let buf_k = a_base + m.buf_k_off
    let buf_v = a_base + m.buf_v_off
    let buf_attn_out = a_base + m.buf_attn_out_off
    let buf_gate = a_base + m.buf_gate_off
    let buf_up = a_base + m.buf_up_off
    let buf_logits = a_base + m.buf_logits_off

    let emb_ptr = ossm_model_tensor_host_ptr(m, 0)
    let emb_dt = ossm_model_tensor_dtype(m, 0)
    let emb_elem_b = if emb_dt == 2 { 2 } else { 4 }
    let row_p = emb_ptr + token_id * m.cfg.hidden * emb_elem_b

    var i: i64 = 0
    while i < m.cfg.hidden {
        let v = if emb_dt == 2 {
            bf16_bits_to_f64_exact(ptr_read_u16_le(row_p, i * 2))
        } else {
            ossm_read_f32(row_p, i)
        }
        ossm_write_f32(buf_x, i, v)
        i = i + 1
    }

    let kv_dim = m.cfg.n_kv * m.cfg.head_dim
    let q_dim = m.cfg.n_q * m.cfg.head_dim

    var has_any_ossm = false
    var l: i64 = 0
    while l < m.cfg.layers {
        let slot_base = 3 + l * 11

        let in_norm_p = ossm_model_tensor_host_ptr(m, slot_base + 0)
        let in_norm_dt = ossm_model_tensor_dtype(m, slot_base + 0)
        ossm_cpu_rmsnorm(buf_x, in_norm_p, in_norm_dt, buf_h, 1, m.cfg.hidden, m.cfg.eps)

        let is_ossm = qwen3_hybrid_layer_is_ossm(l, ossm_every)
        let has_sidecar_layer = is_ossm && sidecar.ok && qwen3_ossm_sidecar_has_layer(sidecar, l)

        if has_sidecar_layer {
            has_any_ossm = true
            let meta_p = page_arena_ptr(&sidecar.meta)
            let u_off = ptr_read_i64_le(meta_p, (l * 6 + 0) * 32 + 0)
            let u_dt = ptr_read_i64_le(meta_p, (l * 6 + 0) * 32 + 16) as i32
            let u_w_ptr = mapped_shard_ptr(&sidecar.shard) + u_off

            let b_off = ptr_read_i64_le(meta_p, (l * 6 + 1) * 32 + 0)
            let b_dt = ptr_read_i64_le(meta_p, (l * 6 + 1) * 32 + 16) as i32
            let b_w_ptr = mapped_shard_ptr(&sidecar.shard) + b_off

            let c_off = ptr_read_i64_le(meta_p, (l * 6 + 2) * 32 + 0)
            let c_dt = ptr_read_i64_le(meta_p, (l * 6 + 2) * 32 + 16) as i32
            let c_w_ptr = mapped_shard_ptr(&sidecar.shard) + c_off

            let dt_off = ptr_read_i64_le(meta_p, (l * 6 + 3) * 32 + 0)
            let dt_dt = ptr_read_i64_le(meta_p, (l * 6 + 3) * 32 + 16) as i32
            let dt_w_ptr = mapped_shard_ptr(&sidecar.shard) + dt_off

            let alpha_off = ptr_read_i64_le(meta_p, (l * 6 + 4) * 32 + 0)
            let alpha_dt = ptr_read_i64_le(meta_p, (l * 6 + 4) * 32 + 16) as i32
            let alpha_w_ptr = mapped_shard_ptr(&sidecar.shard) + alpha_off

            let out_off = ptr_read_i64_le(meta_p, (l * 6 + 5) * 32 + 0)
            let out_dt = ptr_read_i64_le(meta_p, (l * 6 + 5) * 32 + 16) as i32
            let out_w_ptr = mapped_shard_ptr(&sidecar.shard) + out_off

            let tail_base = m.cfg.layers * m.cfg.hidden * 4 + 128
            let u_ptr = ossm.arena_ptr + tail_base + 0 * m.cfg.hidden * 4
            let b_ptr = ossm.arena_ptr + tail_base + 1 * m.cfg.hidden * 4
            let c_ptr = ossm.arena_ptr + tail_base + 2 * m.cfg.hidden * 4
            let dt_ptr = ossm.arena_ptr + tail_base + 3 * m.cfg.hidden * 4
            let alpha_ptr = ossm.arena_ptr + tail_base + 4 * m.cfg.hidden * 4
            let y_ptr = ossm.arena_ptr + tail_base + 5 * m.cfg.hidden * 4

            ossm_cpu_gemv(u_w_ptr, u_dt, buf_h, u_ptr, m.cfg.hidden, m.cfg.hidden)
            ossm_cpu_gemv(b_w_ptr, b_dt, buf_h, b_ptr, m.cfg.hidden, m.cfg.hidden)
            ossm_cpu_gemv(c_w_ptr, c_dt, buf_h, c_ptr, m.cfg.hidden, m.cfg.hidden)
            ossm_cpu_gemv(dt_w_ptr, dt_dt, buf_h, dt_ptr, m.cfg.hidden, m.cfg.hidden)
            ossm_cpu_gemv(alpha_w_ptr, alpha_dt, buf_h, alpha_ptr, m.cfg.hidden, m.cfg.hidden)

            let step_ok = qwen3_ossm_step_cpu(ossm, l, u_ptr, alpha_ptr, b_ptr, dt_ptr, c_ptr, y_ptr)
            if !step_ok { return false }

            ossm_cpu_gemv(out_w_ptr, out_dt, y_ptr, buf_h, m.cfg.hidden, m.cfg.hidden)
            ossm_cpu_vec_add(buf_x, buf_h, m.cfg.hidden)
        } else {
            let q_p = ossm_model_tensor_host_ptr(m, slot_base + 1)
            let q_dt = ossm_model_tensor_dtype(m, slot_base + 1)
            ossm_cpu_gemv(q_p, q_dt, buf_h, buf_q, q_dim, m.cfg.hidden)

            let k_p = ossm_model_tensor_host_ptr(m, slot_base + 2)
            let k_dt = ossm_model_tensor_dtype(m, slot_base + 2)
            ossm_cpu_gemv(k_p, k_dt, buf_h, buf_k, kv_dim, m.cfg.hidden)

            let v_p = ossm_model_tensor_host_ptr(m, slot_base + 3)
            let v_dt = ossm_model_tensor_dtype(m, slot_base + 3)
            ossm_cpu_gemv(v_p, v_dt, buf_h, buf_v, kv_dim, m.cfg.hidden)

            if is_ossm && ossm.ok {
                has_any_ossm = true
                let u_ptr = buf_q
                let b_ptr = buf_gate
                let c_ptr = buf_gate + m.cfg.hidden * 4
                let dt_ptr = buf_up
                let alpha_ptr = buf_up + m.cfg.hidden * 4

                var j: i64 = 0
                while j < m.cfg.hidden {
                    let kv_idx = if kv_dim > 0 { j % kv_dim } else { 0 }
                    let kv_idx_dt = if kv_dim > 0 { (j + 4) % kv_dim } else { 0 }
                    let bk = ossm_read_f32(buf_k, kv_idx)
                    let ck = ossm_read_f32(buf_v, kv_idx)
                    let dtk = ossm_read_f32(buf_v, kv_idx_dt)
                    let alk = ossm_read_f32(buf_h, j)
                    ossm_write_f32(b_ptr, j, bk)
                    ossm_write_f32(c_ptr, j, ck)
                    ossm_write_f32(dt_ptr, j, dtk)
                    ossm_write_f32(alpha_ptr, j, alk)
                    j = j + 1
                }

                let step_ok = qwen3_ossm_step_cpu(ossm, l, u_ptr, alpha_ptr, b_ptr, dt_ptr, c_ptr, buf_attn_out)
                if !step_ok { return false }

                if q_dim > m.cfg.hidden {
                    var p_i = m.cfg.hidden
                    while p_i < q_dim {
                        ossm_write_f32(buf_attn_out, p_i, 0.0)
                        p_i = p_i + 1
                    }
                }
            } else {
                let q_norm_p = ossm_model_tensor_host_ptr(m, slot_base + 5)
                let q_norm_dt = ossm_model_tensor_dtype(m, slot_base + 5)
                ossm_cpu_rmsnorm(buf_q, q_norm_p, q_norm_dt, buf_q, m.cfg.n_q, m.cfg.head_dim, m.cfg.eps)

                let k_norm_p = ossm_model_tensor_host_ptr(m, slot_base + 6)
                let k_norm_dt = ossm_model_tensor_dtype(m, slot_base + 6)
                ossm_cpu_rmsnorm(buf_k, k_norm_p, k_norm_dt, buf_k, m.cfg.n_kv, m.cfg.head_dim, m.cfg.eps)

                ossm_cpu_rope(buf_q, m.cfg.n_q, m.cfg.head_dim, pos, m.cfg.rope_theta)
                ossm_cpu_rope(buf_k, m.cfg.n_kv, m.cfg.head_dim, pos, m.cfg.rope_theta)

                let wk_ok = qwen3_kv_write_kv_f32_buf(kv, l, pos, buf_k, buf_v)
                if !wk_ok { return false }

                ossm_cpu_paged_gqa(buf_q, kv, l, buf_attn_out, m.cfg.n_q, m.cfg.n_kv, m.cfg.head_dim, pos)
            }

            let o_p = ossm_model_tensor_host_ptr(m, slot_base + 4)
            let o_dt = ossm_model_tensor_dtype(m, slot_base + 4)
            ossm_cpu_gemv(o_p, o_dt, buf_attn_out, buf_h, m.cfg.hidden, q_dim)
            ossm_cpu_vec_add(buf_x, buf_h, m.cfg.hidden)
        }

        let post_p = ossm_model_tensor_host_ptr(m, slot_base + 7)
        let post_dt = ossm_model_tensor_dtype(m, slot_base + 7)
        ossm_cpu_rmsnorm(buf_x, post_p, post_dt, buf_h, 1, m.cfg.hidden, m.cfg.eps)

        let gate_p = ossm_model_tensor_host_ptr(m, slot_base + 8)
        let gate_dt = ossm_model_tensor_dtype(m, slot_base + 8)
        ossm_cpu_gemv(gate_p, gate_dt, buf_h, buf_gate, m.cfg.inter, m.cfg.hidden)

        let up_p = ossm_model_tensor_host_ptr(m, slot_base + 9)
        let up_dt = ossm_model_tensor_dtype(m, slot_base + 9)
        ossm_cpu_gemv(up_p, up_dt, buf_h, buf_up, m.cfg.inter, m.cfg.hidden)

        ossm_cpu_swiglu(buf_gate, buf_up, buf_gate, m.cfg.inter)

        let down_p = ossm_model_tensor_host_ptr(m, slot_base + 10)
        let down_dt = ossm_model_tensor_dtype(m, slot_base + 10)
        ossm_cpu_gemv(down_p, down_dt, buf_gate, buf_h, m.cfg.hidden, m.cfg.inter)
        ossm_cpu_vec_add(buf_x, buf_h, m.cfg.hidden)

        l = l + 1
    }

    if compute_logits {
        let norm_p = ossm_model_tensor_host_ptr(m, 1)
        let norm_dt = ossm_model_tensor_dtype(m, 1)
        ossm_cpu_rmsnorm(buf_x, norm_p, norm_dt, buf_h, 1, m.cfg.hidden, m.cfg.eps)

        let lm_p = ossm_model_tensor_host_ptr(m, 2)
        let lm_dt = ossm_model_tensor_dtype(m, 2)
        ossm_cpu_gemv(lm_p, lm_dt, buf_h, buf_logits, m.cfg.vocab, m.cfg.hidden)

        let _top2 = ossm_model_write_top2_cpu(m)
    }

    if last_assoc_out_ptr != 0 && has_any_ossm {
        if sidecar.ok {
            let tail_base = m.cfg.layers * m.cfg.hidden * 4 + 128
            let u_ptr = ossm.arena_ptr + tail_base + 0 * m.cfg.hidden * 4
            let b_ptr = ossm.arena_ptr + tail_base + 1 * m.cfg.hidden * 4
            let dt_ptr = ossm.arena_ptr + tail_base + 3 * m.cfg.hidden * 4
            let assoc = qwen3_ossm_associator_l2(b_ptr, u_ptr, dt_ptr, ossm.n_oct)
            ossm_write_f32(last_assoc_out_ptr, 0, assoc)
        } else {
            let u_ptr = buf_q
            let b_ptr = buf_gate
            let dt_ptr = buf_up
            let assoc = qwen3_ossm_associator_l2(b_ptr, u_ptr, dt_ptr, ossm.n_oct)
            ossm_write_f32(last_assoc_out_ptr, 0, assoc)
        }
    }

    true
}

pub fn qwen3_hybrid_forward_token_cpu(
    m: &Qwen3Model,
    kv: &!Qwen3PagedKv,
    ossm: &!Qwen3OssmState,
    ossm_every: i64,
    token_id: i64,
    pos: i64,
    last_assoc_out_ptr: i64
) -> bool with Alloc, Mut, Div, Panic, IO {
    let dummy = qwen3_ossm_sidecar_empty()
    let res = qwen3_hybrid_forward_token_cpu_sidecar(m, kv, ossm, &dummy, ossm_every, token_id, pos, true, last_assoc_out_ptr)
    let _fd = qwen3_ossm_sidecar_free(dummy)
    res
}

fn ossm_metal_shard_buf(rt: &Qwen3MetalRunner, shard_idx: i64) -> i64 {
    if shard_idx == 0 { return rt.b_s0 }
    if shard_idx == 1 { return rt.b_s1 }
    if shard_idx == 2 { return rt.b_s2 }
    if shard_idx == 3 { return rt.b_s3 }
    if shard_idx == 4 { return rt.b_s4 }
    if shard_idx == 5 { return rt.b_s5 }
    if shard_idx == 6 { return rt.b_s6 }
    if shard_idx == 7 { return rt.b_s7 }
    0
}

pub fn qwen3_hybrid_forward_token_metal_sidecar(
    m: &Qwen3Model,
    kv: &!Qwen3PagedKv,
    ossm: &!Qwen3OssmState,
    sidecar: &!Qwen3OssmSidecar,
    rt: &Qwen3MetalRunner,
    ossm_pipe: i64,
    ossm_every: i64,
    token_id: i64,
    pos: i64,
    compute_logits: bool,
    last_assoc_out_ptr: i64
) -> bool with Alloc, Mut, Div, Panic {
    if !m.ok || !rt.ok || !qwen3_kv_is_ok(kv) || token_id < 0 || token_id >= m.cfg.vocab || pos < 0 {
        return false
    }
    if !qwen3_kv_ensure_pos(kv, pos) {
        return false
    }

    if ossm.ok && ossm.b_st <= 0 && metal_session_is_ok(&rt.sess) {
        ossm.b_st = metal_buffer_nocopy(&rt.sess, ossm.arena_ptr, ossm.arena_len)
    }
    if sidecar.ok && sidecar.b_sidecar <= 0 && metal_session_is_ok(&rt.sess) {
        sidecar.b_sidecar = metal_buffer_nocopy(&rt.sess, mapped_shard_ptr(&sidecar.shard), mapped_shard_len(&sidecar.shard))
    }

    var pipe_ossm = ossm_pipe
    if pipe_ossm <= 0 && metal_session_is_ok(&rt.sess) {
        let opipes = ossm_metal_pipelines_compile(&rt.sess)
        pipe_ossm = opipes.pipe_step
    }

    let a_base = page_arena_ptr(&m.arena)
    let buf_x = a_base + m.buf_x_off

    let emb_ptr = ossm_model_tensor_host_ptr(m, 0)
    let emb_dt = ossm_model_tensor_dtype(m, 0)
    let emb_elem_b = if emb_dt == 2 { 2 } else { 4 }
    let row_p = emb_ptr + token_id * m.cfg.hidden * emb_elem_b

    var i: i64 = 0
    while i < m.cfg.hidden {
        let v = if emb_dt == 2 {
            bf16_bits_to_f64_exact(ptr_read_u16_le(row_p, i * 2))
        } else {
            f32_bits_to_f64(ptr_read_u32_le(row_p, i * 4))
        }
        let _w = ptr_write_u32_le(buf_x, i * 4, f64_to_f32_bits(v))
        i = i + 1
    }

    let eps_bits = f64_to_f32_bits(m.cfg.eps)
    let theta_bits = f64_to_f32_bits(m.cfg.rope_theta)
    let kv_dim = m.cfg.n_kv * m.cfg.head_dim
    let q_dim = m.cfg.n_q * m.cfg.head_dim

    var cid = metal_cmd_begin(&rt.sess)
    if cid <= 0 { return false }

    var has_any_ossm = false
    var l: i64 = 0
    while l < m.cfg.layers {
        let slot_base = 3 + l * 11
        let is_ossm = qwen3_hybrid_layer_is_ossm(l, ossm_every)
        let has_sidecar_layer = is_ossm && sidecar.ok && qwen3_ossm_sidecar_has_layer(sidecar, l)

        let in_norm_s = ossm_metal_shard_buf(rt, ossm_model_tensor_shard_idx(m, slot_base + 0))
        let in_norm_off = ossm_model_tensor_data_off(m, slot_base + 0)
        let in_norm_dt = ossm_model_tensor_dtype(m, slot_base + 0)
        let in_norm_pipe = if in_norm_dt == 2 { rt.pipes.rmsnorm_bf16 } else { rt.pipes.rmsnorm_f32 }
        if qwen3_metal_encode_rmsnorm(
            &rt.sess, cid, in_norm_pipe,
            rt.b_work, m.buf_x_off,
            in_norm_s, in_norm_off,
            rt.b_work, m.buf_h_off,
            1, m.cfg.hidden, eps_bits
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return false
        }

        if has_sidecar_layer && ossm.ok && ossm.b_st > 0 && sidecar.b_sidecar > 0 && pipe_ossm > 0 {
            has_any_ossm = true
            let meta_p = page_arena_ptr(&sidecar.meta)
            let u_off = ptr_read_i64_le(meta_p, (l * 6 + 0) * 32 + 0)
            let u_dt = ptr_read_i64_le(meta_p, (l * 6 + 0) * 32 + 16)
            let u_pipe = if u_dt == 2 { rt.pipes.gemv_bf16 } else { rt.pipes.gemv_f32 }

            let b_off = ptr_read_i64_le(meta_p, (l * 6 + 1) * 32 + 0)
            let b_dt = ptr_read_i64_le(meta_p, (l * 6 + 1) * 32 + 16)
            let b_pipe = if b_dt == 2 { rt.pipes.gemv_bf16 } else { rt.pipes.gemv_f32 }

            let c_off = ptr_read_i64_le(meta_p, (l * 6 + 2) * 32 + 0)
            let c_dt = ptr_read_i64_le(meta_p, (l * 6 + 2) * 32 + 16)
            let c_pipe = if c_dt == 2 { rt.pipes.gemv_bf16 } else { rt.pipes.gemv_f32 }

            let dt_off = ptr_read_i64_le(meta_p, (l * 6 + 3) * 32 + 0)
            let dt_dt = ptr_read_i64_le(meta_p, (l * 6 + 3) * 32 + 16)
            let dt_pipe = if dt_dt == 2 { rt.pipes.gemv_bf16 } else { rt.pipes.gemv_f32 }

            let alpha_off = ptr_read_i64_le(meta_p, (l * 6 + 4) * 32 + 0)
            let alpha_dt = ptr_read_i64_le(meta_p, (l * 6 + 4) * 32 + 16)
            let alpha_pipe = if alpha_dt == 2 { rt.pipes.gemv_bf16 } else { rt.pipes.gemv_f32 }

            let out_off = ptr_read_i64_le(meta_p, (l * 6 + 5) * 32 + 0)
            let out_dt = ptr_read_i64_le(meta_p, (l * 6 + 5) * 32 + 16)
            let out_pipe = if out_dt == 2 { rt.pipes.gemv_bf16 } else { rt.pipes.gemv_f32 }

            let tail_base = m.cfg.layers * m.cfg.hidden * 4 + 128
            let off_u = tail_base + 0 * m.cfg.hidden * 4
            let off_b = tail_base + 1 * m.cfg.hidden * 4
            let off_c = tail_base + 2 * m.cfg.hidden * 4
            let off_dt = tail_base + 3 * m.cfg.hidden * 4
            let off_alpha = tail_base + 4 * m.cfg.hidden * 4
            let off_y = tail_base + 5 * m.cfg.hidden * 4

            if qwen3_metal_encode_gemv(&rt.sess, cid, u_pipe, sidecar.b_sidecar, u_off, rt.b_work, m.buf_h_off, ossm.b_st, off_u, m.cfg.hidden, m.cfg.hidden) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return false
            }
            if qwen3_metal_encode_gemv(&rt.sess, cid, b_pipe, sidecar.b_sidecar, b_off, rt.b_work, m.buf_h_off, ossm.b_st, off_b, m.cfg.hidden, m.cfg.hidden) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return false
            }
            if qwen3_metal_encode_gemv(&rt.sess, cid, c_pipe, sidecar.b_sidecar, c_off, rt.b_work, m.buf_h_off, ossm.b_st, off_c, m.cfg.hidden, m.cfg.hidden) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return false
            }
            if qwen3_metal_encode_gemv(&rt.sess, cid, dt_pipe, sidecar.b_sidecar, dt_off, rt.b_work, m.buf_h_off, ossm.b_st, off_dt, m.cfg.hidden, m.cfg.hidden) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return false
            }
            if qwen3_metal_encode_gemv(&rt.sess, cid, alpha_pipe, sidecar.b_sidecar, alpha_off, rt.b_work, m.buf_h_off, ossm.b_st, off_alpha, m.cfg.hidden, m.cfg.hidden) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return false
            }

            let st_off = qwen3_ossm_state_layer_off(ossm, l)
            if qwen3_metal_encode_ossm_step(
                &rt.sess, cid, pipe_ossm,
                ossm.b_st, st_off,
                ossm.b_st, off_u,
                ossm.b_st, off_alpha,
                ossm.b_st, off_b,
                ossm.b_st, off_dt,
                ossm.b_st, off_c,
                ossm.b_st, off_y,
                ossm.n_oct
            ) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return false
            }

            if qwen3_metal_encode_gemv(
                &rt.sess, cid, out_pipe,
                sidecar.b_sidecar, out_off,
                ossm.b_st, off_y,
                rt.b_work, m.buf_h_off,
                m.cfg.hidden, m.cfg.hidden
            ) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return false
            }

            if qwen3_metal_encode_vec_add(
                &rt.sess, cid, rt.pipes.vec_add,
                rt.b_work, m.buf_x_off,
                rt.b_work, m.buf_h_off,
                m.cfg.hidden
            ) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return false
            }
        } else {
            let q_s = ossm_metal_shard_buf(rt, ossm_model_tensor_shard_idx(m, slot_base + 1))
            let q_off = ossm_model_tensor_data_off(m, slot_base + 1)
            let q_dt = ossm_model_tensor_dtype(m, slot_base + 1)
            let q_pipe = if q_dt == 2 { rt.pipes.gemv_bf16 } else { rt.pipes.gemv_f32 }
            if qwen3_metal_encode_gemv(
                &rt.sess, cid, q_pipe,
                q_s, q_off,
                rt.b_work, m.buf_h_off,
                rt.b_work, m.buf_q_off,
                q_dim, m.cfg.hidden
            ) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return false
            }

            let k_s = ossm_metal_shard_buf(rt, ossm_model_tensor_shard_idx(m, slot_base + 2))
            let k_off = ossm_model_tensor_data_off(m, slot_base + 2)
            let k_dt = ossm_model_tensor_dtype(m, slot_base + 2)
            let k_pipe = if k_dt == 2 { rt.pipes.gemv_bf16 } else { rt.pipes.gemv_f32 }
            if qwen3_metal_encode_gemv(
                &rt.sess, cid, k_pipe,
                k_s, k_off,
                rt.b_work, m.buf_h_off,
                rt.b_work, m.buf_k_off,
                kv_dim, m.cfg.hidden
            ) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return false
            }

            let v_s = ossm_metal_shard_buf(rt, ossm_model_tensor_shard_idx(m, slot_base + 3))
            let v_off = ossm_model_tensor_data_off(m, slot_base + 3)
            let v_dt = ossm_model_tensor_dtype(m, slot_base + 3)
            let v_pipe = if v_dt == 2 { rt.pipes.gemv_bf16 } else { rt.pipes.gemv_f32 }
            if qwen3_metal_encode_gemv(
                &rt.sess, cid, v_pipe,
                v_s, v_off,
                rt.b_work, m.buf_h_off,
                rt.b_work, m.buf_v_off,
                kv_dim, m.cfg.hidden
            ) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return false
            }

            if is_ossm && ossm.ok && ossm.b_st > 0 && pipe_ossm > 0 {
                has_any_ossm = true
                if metal_cmd_commit_sync(&rt.sess, cid) != 0 { return false }

                let buf_h = a_base + m.buf_h_off
                let buf_q = a_base + m.buf_q_off
                let buf_k = a_base + m.buf_k_off
                let buf_v = a_base + m.buf_v_off
                let buf_gate = a_base + m.buf_gate_off
                let buf_up = a_base + m.buf_up_off

                let u_ptr = buf_q
                let b_ptr = buf_gate
                let c_ptr = buf_gate + m.cfg.hidden * 4
                let dt_ptr = buf_up
                let alpha_ptr = buf_up + m.cfg.hidden * 4

                var j: i64 = 0
                while j < m.cfg.hidden {
                    let kv_idx = if kv_dim > 0 { j % kv_dim } else { 0 }
                    let kv_idx_dt = if kv_dim > 0 { (j + 4) % kv_dim } else { 0 }
                    let bk = ossm_read_f32(buf_k, kv_idx)
                    let ck = ossm_read_f32(buf_v, kv_idx)
                    let dtk = ossm_read_f32(buf_v, kv_idx_dt)
                    let alk = ossm_read_f32(buf_h, j)
                    ossm_write_f32(b_ptr, j, bk)
                    ossm_write_f32(c_ptr, j, ck)
                    ossm_write_f32(dt_ptr, j, dtk)
                    ossm_write_f32(alpha_ptr, j, alk)
                    j = j + 1
                }

                cid = metal_cmd_begin(&rt.sess)
                if cid <= 0 { return false }

                if qwen3_metal_encode_ossm_step(
                    &rt.sess, cid, pipe_ossm,
                    ossm.b_st, qwen3_ossm_state_layer_off(ossm, l),
                    rt.b_work, m.buf_q_off,
                    rt.b_work, m.buf_up_off + m.cfg.hidden * 4,
                    rt.b_work, m.buf_gate_off,
                    rt.b_work, m.buf_up_off,
                    rt.b_work, m.buf_gate_off + m.cfg.hidden * 4,
                    rt.b_work, m.buf_attn_out_off,
                    ossm.n_oct
                ) != 0 {
                    let _c = metal_cmd_cancel(&rt.sess, cid)
                    return false
                }
            } else {
                let q_norm_s = ossm_metal_shard_buf(rt, ossm_model_tensor_shard_idx(m, slot_base + 5))
                let q_norm_off = ossm_model_tensor_data_off(m, slot_base + 5)
                let q_norm_dt = ossm_model_tensor_dtype(m, slot_base + 5)
                let q_norm_pipe = if q_norm_dt == 2 { rt.pipes.rmsnorm_bf16 } else { rt.pipes.rmsnorm_f32 }
                if qwen3_metal_encode_rmsnorm(
                    &rt.sess, cid, q_norm_pipe,
                    rt.b_work, m.buf_q_off,
                    q_norm_s, q_norm_off,
                    rt.b_work, m.buf_q_off,
                    m.cfg.n_q, m.cfg.head_dim, eps_bits
                ) != 0 {
                    let _c = metal_cmd_cancel(&rt.sess, cid)
                    return false
                }

                let k_norm_s = ossm_metal_shard_buf(rt, ossm_model_tensor_shard_idx(m, slot_base + 6))
                let k_norm_off = ossm_model_tensor_data_off(m, slot_base + 6)
                let k_norm_dt = ossm_model_tensor_dtype(m, slot_base + 6)
                let k_norm_pipe = if k_norm_dt == 2 { rt.pipes.rmsnorm_bf16 } else { rt.pipes.rmsnorm_f32 }
                if qwen3_metal_encode_rmsnorm(
                    &rt.sess, cid, k_norm_pipe,
                    rt.b_work, m.buf_k_off,
                    k_norm_s, k_norm_off,
                    rt.b_work, m.buf_k_off,
                    m.cfg.n_kv, m.cfg.head_dim, eps_bits
                ) != 0 {
                    let _c = metal_cmd_cancel(&rt.sess, cid)
                    return false
                }

                if qwen3_metal_encode_rope(
                    &rt.sess, cid, rt.pipes.rope,
                    rt.b_work, m.buf_q_off,
                    m.cfg.n_q, m.cfg.head_dim, pos, theta_bits
                ) != 0 {
                    let _c = metal_cmd_cancel(&rt.sess, cid)
                    return false
                }

                if qwen3_metal_encode_rope(
                    &rt.sess, cid, rt.pipes.rope,
                    rt.b_work, m.buf_k_off,
                    m.cfg.n_kv, m.cfg.head_dim, pos, theta_bits
                ) != 0 {
                    let _c = metal_cmd_cancel(&rt.sess, cid)
                    return false
                }

                if qwen3_metal_encode_kv_scatter(
                    &rt.sess, cid, rt.pipes.kv_scatter,
                    rt.b_work, m.buf_k_off,
                    rt.b_work, m.buf_v_off,
                    rt.b_kv,
                    qwen3_kv_table_off(kv),
                    qwen3_kv_k_layer_off(kv, l),
                    qwen3_kv_v_layer_off(kv, l),
                    m.cfg.n_kv * m.cfg.head_dim,
                    pos,
                    qwen3_kv_block_size(kv)
                ) != 0 {
                    let _c = metal_cmd_cancel(&rt.sess, cid)
                    return false
                }

                if qwen3_metal_encode_paged_gqa(
                    &rt.sess, cid, rt.pipes.paged_gqa,
                    rt.b_work, m.buf_q_off,
                    rt.b_kv,
                    qwen3_kv_table_off(kv),
                    qwen3_kv_k_layer_off(kv, l),
                    qwen3_kv_v_layer_off(kv, l),
                    rt.b_work, m.buf_attn_out_off,
                    m.cfg.n_q, m.cfg.n_kv, m.cfg.head_dim,
                    pos + 1,
                    qwen3_kv_block_size(kv)
                ) != 0 {
                    let _c = metal_cmd_cancel(&rt.sess, cid)
                    return false
                }
            }

            let o_s = ossm_metal_shard_buf(rt, ossm_model_tensor_shard_idx(m, slot_base + 4))
            let o_off = ossm_model_tensor_data_off(m, slot_base + 4)
            let o_dt = ossm_model_tensor_dtype(m, slot_base + 4)
            let o_pipe = if o_dt == 2 { rt.pipes.gemv_bf16 } else { rt.pipes.gemv_f32 }
            if qwen3_metal_encode_gemv(
                &rt.sess, cid, o_pipe,
                o_s, o_off,
                rt.b_work, m.buf_attn_out_off,
                rt.b_work, m.buf_h_off,
                m.cfg.hidden, q_dim
            ) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return false
            }

            if qwen3_metal_encode_vec_add(
                &rt.sess, cid, rt.pipes.vec_add,
                rt.b_work, m.buf_x_off,
                rt.b_work, m.buf_h_off,
                m.cfg.hidden
            ) != 0 {
                let _c = metal_cmd_cancel(&rt.sess, cid)
                return false
            }
        }

        let post_s = ossm_metal_shard_buf(rt, ossm_model_tensor_shard_idx(m, slot_base + 7))
        let post_off = ossm_model_tensor_data_off(m, slot_base + 7)
        let post_dt = ossm_model_tensor_dtype(m, slot_base + 7)
        let post_pipe = if post_dt == 2 { rt.pipes.rmsnorm_bf16 } else { rt.pipes.rmsnorm_f32 }
        if qwen3_metal_encode_rmsnorm(
            &rt.sess, cid, post_pipe,
            rt.b_work, m.buf_x_off,
            post_s, post_off,
            rt.b_work, m.buf_h_off,
            1, m.cfg.hidden, eps_bits
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return false
        }

        let gate_s = ossm_metal_shard_buf(rt, ossm_model_tensor_shard_idx(m, slot_base + 8))
        let gate_off = ossm_model_tensor_data_off(m, slot_base + 8)
        let gate_dt = ossm_model_tensor_dtype(m, slot_base + 8)
        let gate_pipe = if gate_dt == 2 { rt.pipes.gemv_bf16 } else { rt.pipes.gemv_f32 }
        if qwen3_metal_encode_gemv(
            &rt.sess, cid, gate_pipe,
            gate_s, gate_off,
            rt.b_work, m.buf_h_off,
            rt.b_work, m.buf_gate_off,
            m.cfg.inter, m.cfg.hidden
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return false
        }

        let up_s = ossm_metal_shard_buf(rt, ossm_model_tensor_shard_idx(m, slot_base + 9))
        let up_off = ossm_model_tensor_data_off(m, slot_base + 9)
        let up_dt = ossm_model_tensor_dtype(m, slot_base + 9)
        let up_pipe = if up_dt == 2 { rt.pipes.gemv_bf16 } else { rt.pipes.gemv_f32 }
        if qwen3_metal_encode_gemv(
            &rt.sess, cid, up_pipe,
            up_s, up_off,
            rt.b_work, m.buf_h_off,
            rt.b_work, m.buf_up_off,
            m.cfg.inter, m.cfg.hidden
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return false
        }

        if qwen3_metal_encode_swiglu(
            &rt.sess, cid, rt.pipes.swiglu,
            rt.b_work, m.buf_gate_off,
            rt.b_work, m.buf_up_off,
            rt.b_work, m.buf_gate_off,
            m.cfg.inter
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return false
        }

        let down_s = ossm_metal_shard_buf(rt, ossm_model_tensor_shard_idx(m, slot_base + 10))
        let down_off = ossm_model_tensor_data_off(m, slot_base + 10)
        let down_dt = ossm_model_tensor_dtype(m, slot_base + 10)
        let down_pipe = if down_dt == 2 { rt.pipes.gemv_bf16 } else { rt.pipes.gemv_f32 }
        if qwen3_metal_encode_gemv(
            &rt.sess, cid, down_pipe,
            down_s, down_off,
            rt.b_work, m.buf_gate_off,
            rt.b_work, m.buf_h_off,
            m.cfg.hidden, m.cfg.inter
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return false
        }

        if qwen3_metal_encode_vec_add(
            &rt.sess, cid, rt.pipes.vec_add,
            rt.b_work, m.buf_x_off,
            rt.b_work, m.buf_h_off,
            m.cfg.hidden
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return false
        }

        l = l + 1
    }

    if compute_logits {
        let norm_s = ossm_metal_shard_buf(rt, ossm_model_tensor_shard_idx(m, 1))
        let norm_off = ossm_model_tensor_data_off(m, 1)
        let norm_dt = ossm_model_tensor_dtype(m, 1)
        let norm_pipe = if norm_dt == 2 { rt.pipes.rmsnorm_bf16 } else { rt.pipes.rmsnorm_f32 }
        if qwen3_metal_encode_rmsnorm(
            &rt.sess, cid, norm_pipe,
            rt.b_work, m.buf_x_off,
            norm_s, norm_off,
            rt.b_work, m.buf_h_off,
            1, m.cfg.hidden, eps_bits
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return false
        }

        let lm_s = ossm_metal_shard_buf(rt, ossm_model_tensor_shard_idx(m, 2))
        let lm_off = ossm_model_tensor_data_off(m, 2)
        let lm_dt = ossm_model_tensor_dtype(m, 2)
        let lm_pipe = if lm_dt == 2 { rt.pipes.gemv_bf16 } else { rt.pipes.gemv_f32 }
        if qwen3_metal_encode_gemv(
            &rt.sess, cid, lm_pipe,
            lm_s, lm_off,
            rt.b_work, m.buf_h_off,
            rt.b_work, m.buf_logits_off,
            m.cfg.vocab, m.cfg.hidden
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return false
        }

        if qwen3_metal_encode_argmax_top2(
            &rt.sess, cid, rt.pipes.argmax_top2,
            rt.b_work, m.buf_logits_off,
            rt.b_work, m.buf_top2_off,
            m.cfg.vocab
        ) != 0 {
            let _c = metal_cmd_cancel(&rt.sess, cid)
            return false
        }
    }

    if metal_cmd_commit_sync(&rt.sess, cid) != 0 {
        return false
    }

    if last_assoc_out_ptr != 0 && has_any_ossm {
        if sidecar.ok {
            let tail_base = m.cfg.layers * m.cfg.hidden * 4 + 128
            let u_ptr = ossm.arena_ptr + tail_base + 0 * m.cfg.hidden * 4
            let b_ptr = ossm.arena_ptr + tail_base + 1 * m.cfg.hidden * 4
            let dt_ptr = ossm.arena_ptr + tail_base + 3 * m.cfg.hidden * 4
            let assoc = qwen3_ossm_associator_l2(b_ptr, u_ptr, dt_ptr, ossm.n_oct)
            ossm_write_f32(last_assoc_out_ptr, 0, assoc)
        }
    }

    true
}

pub fn qwen3_hybrid_forward_token_metal(
    m: &Qwen3Model,
    kv: &!Qwen3PagedKv,
    ossm: &!Qwen3OssmState,
    rt: &Qwen3MetalRunner,
    ossm_pipe: i64,
    ossm_every: i64,
    token_id: i64,
    pos: i64,
    last_assoc_out_ptr: i64
) -> bool with Alloc, Mut, Div, Panic, IO {
    var dummy = qwen3_ossm_sidecar_empty()
    let res = qwen3_hybrid_forward_token_metal_sidecar(m, kv, ossm, &!dummy, rt, ossm_pipe, ossm_every, token_id, pos, true, last_assoc_out_ptr)
    let _fd = qwen3_ossm_sidecar_free(dummy)
    res
}

// ============================================================================
// Artin-Awakened Dual-Register Octonion Primitives
// ============================================================================

struct OssmDualOctVal {
    pub c0: f64,
    pub c1: f64,
    pub c2: f64,
    pub c3: f64,
    pub c4: f64,
    pub c5: f64,
    pub c6: f64,
    pub c7: f64,
}

fn ossm_dual_oct_read(ptr: i64) -> OssmDualOctVal with Mut {
    OssmDualOctVal {
        c0: ossm_read_f32(ptr, 0),
        c1: ossm_read_f32(ptr, 1),
        c2: ossm_read_f32(ptr, 2),
        c3: ossm_read_f32(ptr, 3),
        c4: ossm_read_f32(ptr, 4),
        c5: ossm_read_f32(ptr, 5),
        c6: ossm_read_f32(ptr, 6),
        c7: ossm_read_f32(ptr, 7),
    }
}

fn ossm_dual_oct_write(ptr: i64, o: OssmDualOctVal) with Mut {
    ossm_write_f32(ptr, 0, o.c0)
    ossm_write_f32(ptr, 1, o.c1)
    ossm_write_f32(ptr, 2, o.c2)
    ossm_write_f32(ptr, 3, o.c3)
    ossm_write_f32(ptr, 4, o.c4)
    ossm_write_f32(ptr, 5, o.c5)
    ossm_write_f32(ptr, 6, o.c6)
    ossm_write_f32(ptr, 7, o.c7)
}

fn ossm_dual_oct_mul(a: OssmDualOctVal, b: OssmDualOctVal) -> OssmDualOctVal {
    OssmDualOctVal {
        c0: a.c0*b.c0 - a.c1*b.c1 - a.c2*b.c2 - a.c3*b.c3 - a.c4*b.c4 - a.c5*b.c5 - a.c6*b.c6 - a.c7*b.c7,
        c1: a.c0*b.c1 + a.c1*b.c0 + a.c2*b.c3 - a.c3*b.c2 + a.c4*b.c5 - a.c5*b.c4 - a.c6*b.c7 + a.c7*b.c6,
        c2: a.c0*b.c2 - a.c1*b.c3 + a.c2*b.c0 + a.c3*b.c1 + a.c4*b.c6 + a.c5*b.c7 - a.c6*b.c4 - a.c7*b.c5,
        c3: a.c0*b.c3 + a.c1*b.c2 - a.c2*b.c1 + a.c3*b.c0 + a.c4*b.c7 - a.c5*b.c6 + a.c6*b.c5 - a.c7*b.c4,
        c4: a.c0*b.c4 - a.c1*b.c5 - a.c2*b.c6 - a.c3*b.c7 + a.c4*b.c0 + a.c5*b.c1 + a.c6*b.c2 + a.c7*b.c3,
        c5: a.c0*b.c5 + a.c1*b.c4 - a.c2*b.c7 + a.c3*b.c6 - a.c4*b.c1 + a.c5*b.c0 - a.c6*b.c3 + a.c7*b.c2,
        c6: a.c0*b.c6 + a.c1*b.c7 + a.c2*b.c4 - a.c3*b.c5 - a.c4*b.c2 + a.c5*b.c3 + a.c6*b.c0 - a.c7*b.c1,
        c7: a.c0*b.c7 - a.c1*b.c6 + a.c2*b.c5 + a.c3*b.c4 - a.c4*b.c3 - a.c5*b.c2 + a.c6*b.c1 + a.c7*b.c0,
    }
}

pub fn qwen3_ossm_dual_associator_l2(
    h_left_f32_ptr: i64,
    h_right_f32_ptr: i64,
    u_f32_ptr: i64,
    n_oct: i64
) -> f64 with Mut, Div, Panic {
    if h_left_f32_ptr == 0 || h_right_f32_ptr == 0 || u_f32_ptr == 0 || n_oct <= 0 {
        return 0.0
    }
    var sum_sq: f64 = 0.0
    var c: i64 = 0
    while c < n_oct {
        let hl = ossm_dual_oct_read(h_left_f32_ptr + c * 32)
        let hr = ossm_dual_oct_read(h_right_f32_ptr + c * 32)
        let u = ossm_dual_oct_read(u_f32_ptr + c * 32)

        let hl_hr = ossm_dual_oct_mul(hl, hr)
        let left_assoc = ossm_dual_oct_mul(hl_hr, u)

        let hr_u = ossm_dual_oct_mul(hr, u)
        let right_assoc = ossm_dual_oct_mul(hl, hr_u)

        let d0 = left_assoc.c0 - right_assoc.c0
        let d1 = left_assoc.c1 - right_assoc.c1
        let d2 = left_assoc.c2 - right_assoc.c2
        let d3 = left_assoc.c3 - right_assoc.c3
        let d4 = left_assoc.c4 - right_assoc.c4
        let d5 = left_assoc.c5 - right_assoc.c5
        let d6 = left_assoc.c6 - right_assoc.c6
        let d7 = left_assoc.c7 - right_assoc.c7

        sum_sq = sum_sq + d0*d0 + d1*d1 + d2*d2 + d3*d3 + d4*d4 + d5*d5 + d6*d6 + d7*d7
        c = c + 1
    }
    sqrt(sum_sq)
}

pub fn qwen3_ossm_dual_step_cpu(
    h_left_f32_ptr: i64,
    h_right_f32_ptr: i64,
    u_f32_ptr: i64,
    decay_f32_ptr: i64,
    parenthesize_gate_f32_ptr: i64,
    c_f32_ptr: i64,
    out_y_f32_ptr: i64,
    n_oct: i64
) -> bool with Mut {
    if h_left_f32_ptr == 0 || h_right_f32_ptr == 0 || u_f32_ptr == 0
        || decay_f32_ptr == 0 || parenthesize_gate_f32_ptr == 0
        || c_f32_ptr == 0 || out_y_f32_ptr == 0 || n_oct <= 0 {
        return false
    }

    var ch: i64 = 0
    while ch < n_oct {
        let hl_ptr = h_left_f32_ptr + ch * 32
        let hr_ptr = h_right_f32_ptr + ch * 32
        let u_ptr = u_f32_ptr + ch * 32
        let decay_ptr = decay_f32_ptr + ch * 32
        let gate_ptr = parenthesize_gate_f32_ptr + ch * 32
        let c_ptr = c_f32_ptr + ch * 32
        let y_ptr = out_y_f32_ptr + ch * 32

        let hl = ossm_dual_oct_read(hl_ptr)
        let hr = ossm_dual_oct_read(hr_ptr)
        let u = ossm_dual_oct_read(u_ptr)
        let c_val = ossm_dual_oct_read(c_ptr)

        // decay = sigmoid(decay_f32_ptr[ch * 8 + 0]) matching qwen3_ossm_step_cpu convention
        let raw_decay = ossm_read_f32(decay_ptr, 0)
        let gamma = 1.0 / (1.0 + exp(0.0 - raw_decay))

        // g = sigmoid(parenthesize_gate_f32_ptr[ch * 8 + 0]) parenthesization gate in (0, 1)
        let raw_gate = ossm_read_f32(gate_ptr, 0)
        let g = 1.0 / (1.0 + exp(0.0 - raw_gate))
        let one_minus_g = 1.0 - g

        // left_assoc = (H^(L) * H^(R)) * U
        let hl_hr = ossm_dual_oct_mul(hl, hr)
        let left_assoc = ossm_dual_oct_mul(hl_hr, u)

        // right_assoc = H^(L) * (H^(R) * U)
        let hr_u = ossm_dual_oct_mul(hr, u)
        let right_assoc = ossm_dual_oct_mul(hl, hr_u)

        // H_new^(L) = gamma * H^(L) + g * left_assoc + (1 - g) * right_assoc
        let hl_new = OssmDualOctVal {
            c0: gamma * hl.c0 + g * left_assoc.c0 + one_minus_g * right_assoc.c0,
            c1: gamma * hl.c1 + g * left_assoc.c1 + one_minus_g * right_assoc.c1,
            c2: gamma * hl.c2 + g * left_assoc.c2 + one_minus_g * right_assoc.c2,
            c3: gamma * hl.c3 + g * left_assoc.c3 + one_minus_g * right_assoc.c3,
            c4: gamma * hl.c4 + g * left_assoc.c4 + one_minus_g * right_assoc.c4,
            c5: gamma * hl.c5 + g * left_assoc.c5 + one_minus_g * right_assoc.c5,
            c6: gamma * hl.c6 + g * left_assoc.c6 + one_minus_g * right_assoc.c6,
            c7: gamma * hl.c7 + g * left_assoc.c7 + one_minus_g * right_assoc.c7,
        }

        // H_new^(R) = gamma * H^(R) + U
        let hr_new = OssmDualOctVal {
            c0: gamma * hr.c0 + u.c0,
            c1: gamma * hr.c1 + u.c1,
            c2: gamma * hr.c2 + u.c2,
            c3: gamma * hr.c3 + u.c3,
            c4: gamma * hr.c4 + u.c4,
            c5: gamma * hr.c5 + u.c5,
            c6: gamma * hr.c6 + u.c6,
            c7: gamma * hr.c7 + u.c7,
        }

        // Update dual octonion registers in place
        ossm_dual_oct_write(hl_ptr, hl_new)
        ossm_dual_oct_write(hr_ptr, hr_new)

        // Y = C * H_new^(L)
        let y_val = ossm_dual_oct_mul(c_val, hl_new)
        ossm_dual_oct_write(y_ptr, y_val)

        ch = ch + 1
    }

    true
}

