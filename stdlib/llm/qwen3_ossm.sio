// ============================================================================
// Internal Memory Helpers
// ============================================================================

fn ossm_read_f32(ptr: i64, idx: i64) -> f64 with Mut {
    f32_bits_to_f64(ptr_read_u32_le(ptr, idx * 4))
}

fn ossm_write_f32(ptr: i64, idx: i64, val: f64) with Mut {
    let _w = ptr_write_u32_le(ptr, idx * 4, f64_to_f32_bits(val))
}

fn ossm_model_tensor_host_ptr(m: &Qwen3Model, slot: i64) -> i64 {
    let p = page_arena_ptr(&m.arena) + m.table_off + slot * 48
    ptr_read_i64_le(p, 40)
}

fn ossm_model_tensor_dtype(m: &Qwen3Model, slot: i64) -> i32 {
    let p = page_arena_ptr(&m.arena) + m.table_off + slot * 48
    ptr_read_i64_le(p, 16) as i32
}

fn ossm_model_tensor_shard_idx(m: &Qwen3Model, slot: i64) -> i64 {
    let p = page_arena_ptr(&m.arena) + m.table_off + slot * 48
    ptr_read_i64_le(p, 0)
}

fn ossm_model_tensor_data_off(m: &Qwen3Model, slot: i64) -> i64 {
    let p = page_arena_ptr(&m.arena) + m.table_off + slot * 48
    ptr_read_i64_le(p, 8)
}

// ============================================================================
// Cayley-Dickson Octonion Algebra (verified norm-multiplicative)
// ============================================================================

pub fn qwen3_ossm_oct_mul_f32(a_ptr: i64, b_ptr: i64, out_ptr: i64) with Mut {
    let a0 = ossm_read_f32(a_ptr, 0)
    let a1 = ossm_read_f32(a_ptr, 1)
    let a2 = ossm_read_f32(a_ptr, 2)
    let a3 = ossm_read_f32(a_ptr, 3)
    let a4 = ossm_read_f32(a_ptr, 4)
    let a5 = ossm_read_f32(a_ptr, 5)
    let a6 = ossm_read_f32(a_ptr, 6)
    let a7 = ossm_read_f32(a_ptr, 7)

    let b0 = ossm_read_f32(b_ptr, 0)
    let b1 = ossm_read_f32(b_ptr, 1)
    let b2 = ossm_read_f32(b_ptr, 2)
    let b3 = ossm_read_f32(b_ptr, 3)
    let b4 = ossm_read_f32(b_ptr, 4)
    let b5 = ossm_read_f32(b_ptr, 5)
    let b6 = ossm_read_f32(b_ptr, 6)
    let b7 = ossm_read_f32(b_ptr, 7)

    let c0 = a0*b0 - a1*b1 - a2*b2 - a3*b3 - a4*b4 - a5*b5 - a6*b6 - a7*b7
    let c1 = a0*b1 + a1*b0 + a2*b3 - a3*b2 + a4*b5 - a5*b4 - a6*b7 + a7*b6
    let c2 = a0*b2 - a1*b3 + a2*b0 + a3*b1 + a4*b6 + a5*b7 - a6*b4 - a7*b5
    let c3 = a0*b3 + a1*b2 - a2*b1 + a3*b0 + a4*b7 - a5*b6 + a6*b5 - a7*b4
    let c4 = a0*b4 - a1*b5 - a2*b6 - a3*b7 + a4*b0 + a5*b1 + a6*b2 + a7*b3
    let c5 = a0*b5 + a1*b4 - a2*b7 + a3*b6 - a4*b1 + a5*b0 - a6*b3 + a7*b2
    let c6 = a0*b6 + a1*b7 + a2*b4 - a3*b5 - a4*b2 + a5*b3 + a6*b0 - a7*b1
    let c7 = a0*b7 - a1*b6 + a2*b5 + a3*b4 - a4*b3 - a5*b2 + a6*b1 + a7*b0

    ossm_write_f32(out_ptr, 0, c0)
    ossm_write_f32(out_ptr, 1, c1)
    ossm_write_f32(out_ptr, 2, c2)
    ossm_write_f32(out_ptr, 3, c3)
    ossm_write_f32(out_ptr, 4, c4)
    ossm_write_f32(out_ptr, 5, c5)
    ossm_write_f32(out_ptr, 6, c6)
    ossm_write_f32(out_ptr, 7, c7)
}

pub fn qwen3_ossm_oct_mul_f64(a_ptr: i64, b_ptr: i64, out_ptr: i64) with Mut {
    qwen3_ossm_oct_mul_f32(a_ptr, b_ptr, out_ptr)
}

pub fn qwen3_ossm_associator_l2(
    b_f32_ptr: i64,
    u_f32_ptr: i64,
    dt_f32_ptr: i64,
    n_oct_channels: i64
) -> f64 with Alloc, Mut, Div, Panic {
    if b_f32_ptr == 0 || u_f32_ptr == 0 || dt_f32_ptr == 0 || n_oct_channels <= 0 {
        return 0.0
    }
    let scratch = heap_alloc(128) as i64
    let bu_ptr = scratch
    let left_ptr = scratch + 32
    let udt_ptr = scratch + 64
    let right_ptr = scratch + 96

    var sum_sq: f64 = 0.0
    var c: i64 = 0
    while c < n_oct_channels {
        let b_c = b_f32_ptr + c * 32
        let u_c = u_f32_ptr + c * 32
        let dt_c = dt_f32_ptr + c * 32

        qwen3_ossm_oct_mul_f32(b_c, u_c, bu_ptr)
        qwen3_ossm_oct_mul_f32(bu_ptr, dt_c, left_ptr)

        qwen3_ossm_oct_mul_f32(u_c, dt_c, udt_ptr)
        qwen3_ossm_oct_mul_f32(b_c, udt_ptr, right_ptr)

        var k: i64 = 0
        while k < 8 {
            let l_k = ossm_read_f32(left_ptr, k)
            let r_k = ossm_read_f32(right_ptr, k)
            let diff = l_k - r_k
            sum_sq = sum_sq + diff * diff
            k = k + 1
        }
        c = c + 1
    }

    heap_free(scratch as *mut u8)
    sqrt(sum_sq)
}

// ============================================================================
// O(1) Context State Linear Struct: Qwen3OssmState
// ============================================================================

pub linear struct Qwen3OssmState {
    pub arena_ptr: i64,
    pub arena_len: i64,
    pub n_layers: i64,
    pub n_oct: i64,
    pub b_st: i64,
    pub ok: bool,
}

pub fn qwen3_ossm_state_is_ok(st: &Qwen3OssmState) -> bool {
    st.ok
}

pub fn qwen3_ossm_state_ptr(st: &Qwen3OssmState) -> i64 {
    st.arena_ptr
}

pub fn qwen3_ossm_state_len(st: &Qwen3OssmState) -> i64 {
    st.arena_len
}

pub fn qwen3_ossm_state_n_oct(st: &Qwen3OssmState) -> i64 {
    st.n_oct
}

pub fn qwen3_ossm_state_layer_off(st: &Qwen3OssmState, layer: i64) -> i64 {
    layer * st.n_oct * 32
}

pub fn qwen3_ossm_state_bytes(n_layers: i64, hidden: i64) -> i64 {
    n_layers * hidden * 4
}

pub fn qwen3_ossm_state_alloc(n_layers: i64, hidden: i64) -> Qwen3OssmState with IO, Mut, Div {
    if n_layers <= 0 || hidden <= 0 || (hidden % 8) != 0 {
        return Qwen3OssmState {
            arena_ptr: 0,
            arena_len: 0,
            n_layers: 0,
            n_oct: 0,
            b_st: 0,
            ok: false,
        }
    }
    let total_bytes = qwen3_ossm_state_bytes(n_layers, hidden) + 128 + 6 * hidden * 4 + 64
    let arena = page_arena_alloc(total_bytes)
    let a_ok = page_arena_is_ok(&arena)
    let ptr = page_arena_ptr(&arena)
    let len = page_arena_len(&arena)
    if a_ok {
        var i: i64 = 0
        while i < len {
            let _w = ptr_write_u8(ptr, i, 0)
            i = i + 1
        }
        let PageArena { ptr: _ap, len: _al, ok: _ao } = arena
        Qwen3OssmState {
            arena_ptr: ptr,
            arena_len: len,
            n_layers: n_layers,
            n_oct: hidden / 8,
            b_st: 0,
            ok: true,
        }
    } else {
        let _f = page_arena_free(arena)
        Qwen3OssmState {
            arena_ptr: 0,
            arena_len: 0,
            n_layers: 0,
            n_oct: 0,
            b_st: 0,
            ok: false,
        }
    }
}

pub fn qwen3_ossm_state_free(st: Qwen3OssmState) -> i64 with IO, Mut {
    let Qwen3OssmState {
        arena_ptr,
        arena_len,
        n_layers: _,
        n_oct: _,
        b_st: _,
        ok: _,
    } = st
    if arena_ptr != 0 {
        let arena = PageArena {
            ptr: arena_ptr,
            len: arena_len,
            ok: true,
        }
        let _f = page_arena_free(arena)
    }
    0
}

pub fn qwen3_ossm_state_reset(st: &!Qwen3OssmState) -> bool with Mut {
    if !st.ok || st.arena_ptr == 0 { return false }
    var i: i64 = 0
    while i < st.arena_len {
        let _w = ptr_write_u8(st.arena_ptr, i, 0)
        i = i + 1
    }
    true
}

pub fn qwen3_ossm_state_metal_free(sess: &MetalSession, ossm: &!Qwen3OssmState) with Mut {
    if ossm.b_st > 0 {
        let _f = metal_buffer_free(sess, ossm.b_st)
        ossm.b_st = 0
    }
}

// ============================================================================
// Zero-Copy Sidecar O-SSM
// ============================================================================

fn ossm_copy_lit(buf: i64, p: i64, s: string) -> i64 with Mut {
    let n = str_len(s)
    var i: i64 = 0
    while i < n {
        let _w = ptr_write_u8(buf, p + i, str_char_at(s, i) & 255)
        i = i + 1
    }
    p + n
}

fn ossm_copy_num(buf: i64, p: i64, n: i64) -> i64 with Mut, Div {
    if n == 0 {
        let _w = ptr_write_u8(buf, p, 48)
        return p + 1
    }
    var digits: i64 = 0
    var temp = n
    while temp > 0 {
        digits = digits + 1
        temp = temp / 10
    }
    var pos = p + digits - 1
    temp = n
    while temp > 0 {
        let d = temp % 10
        let _w = ptr_write_u8(buf, pos, 48 + (d as i32))
        pos = pos - 1
        temp = temp / 10
    }
    p + digits
}

fn ossm_format_key_name(buf: i64, layer: i64, kind: i32) -> i64 with Mut, Div {
    var p = ossm_copy_lit(buf, 0, "ossm.layers.")
    p = ossm_copy_num(buf, p, layer)
    if kind == 0 { p = ossm_copy_lit(buf, p, ".u_proj.weight") }
    else if kind == 1 { p = ossm_copy_lit(buf, p, ".b_proj.weight") }
    else if kind == 2 { p = ossm_copy_lit(buf, p, ".c_proj.weight") }
    else if kind == 3 { p = ossm_copy_lit(buf, p, ".dt_proj.weight") }
    else if kind == 4 { p = ossm_copy_lit(buf, p, ".alpha_proj.weight") }
    else if kind == 5 { p = ossm_copy_lit(buf, p, ".out_proj.weight") }
    p
}

pub linear struct Qwen3OssmSidecar {
    pub shard: MappedShard,
    pub meta: PageArena,
    pub b_sidecar: i64,
    pub n_layers: i64,
    pub hidden: i64,
    pub ok: bool,
}

pub fn qwen3_ossm_sidecar_empty() -> Qwen3OssmSidecar {
    Qwen3OssmSidecar {
        shard: MappedShard { ptr: 0, len: 0, ok: false },
        meta: PageArena { ptr: 0, len: 0, ok: false },
        b_sidecar: 0,
        n_layers: 0,
        hidden: 0,
        ok: false,
    }
}

pub fn qwen3_ossm_sidecar_is_ok(sidecar: &Qwen3OssmSidecar) -> bool {
    sidecar.ok
}

pub fn qwen3_ossm_sidecar_has_layer(sidecar: &Qwen3OssmSidecar, layer: i64) -> bool {
    if !sidecar.ok || layer < 0 || layer >= sidecar.n_layers { return false }
    let m_ptr = page_arena_ptr(&sidecar.meta)
    if m_ptr <= 0 { return false }
    let found = ptr_read_i64_le(m_ptr, (layer * 6) * 32 + 24)
    found == 1
}

pub fn qwen3_ossm_sidecar_free(sidecar: Qwen3OssmSidecar) -> i64 with IO, Mut {
    let Qwen3OssmSidecar {
        shard,
        meta,
        b_sidecar: _,
        n_layers: _,
        hidden: _,
        ok: _,
    } = sidecar
    let _fm = page_arena_free(meta)
    let _fc = mapped_shard_close(shard)
    0
}

pub fn qwen3_ossm_sidecar_metal_free(sess: &MetalSession, sidecar: &!Qwen3OssmSidecar) with Mut {
    if sidecar.b_sidecar > 0 {
        let _f = metal_buffer_free(sess, sidecar.b_sidecar)
        sidecar.b_sidecar = 0
    }
}

pub fn qwen3_ossm_sidecar_open(path: string, n_layers: i64, hidden: i64) -> Qwen3OssmSidecar with IO, Mut, Alloc, Div, Panic {
    let shard = if str_len(path) > 0 && n_layers > 0 && hidden > 0 {
        mapped_shard_open(path)
    } else {
        MappedShard { ptr: 0, len: 0, ok: false }
    }
    let shard_ok = mapped_shard_is_ok(&shard)
    let hdr = if shard_ok { st_mmap_parse_header(&shard) } else { StMmapHeader { hdr_len: 0, data_base_off: 0, ok: false } }
    let meta_bytes = if shard_ok && hdr.ok { n_layers * 6 * 32 } else { 0 }
    let meta = if meta_bytes > 0 { page_arena_alloc(meta_bytes) } else { PageArena { ptr: 0, len: 0, ok: false } }

    var sidecar_ok = false
    if shard_ok && hdr.ok && page_arena_is_ok(&meta) {
        let m_ptr = page_arena_ptr(&meta)
        var i: i64 = 0
        while i < meta_bytes {
            let _w = ptr_write_u8(m_ptr, i, 0)
            i = i + 1
        }

        let name_buf = heap_alloc(128) as i64
        var found_any = false

        var l: i64 = 0
        while l < n_layers {
            var k: i32 = 0
            var layer_complete = true
            while k < 6 {
                let n_len = ossm_format_key_name(name_buf, l, k)
                let tv = st_mmap_find_tensor_bytes(&shard, &hdr, name_buf, n_len)
                let slot_off = (l * 6 + (k as i64)) * 32
                if tv.found && tv.rank == 2 && tv.d0 == hidden && tv.d1 == hidden {
                    let _w0 = ptr_write_i64_le(m_ptr, slot_off + 0, tv.data_off)
                    let _w1 = ptr_write_i64_le(m_ptr, slot_off + 8, tv.byte_len)
                    let _w2 = ptr_write_i64_le(m_ptr, slot_off + 16, tv.dtype as i64)
                    let _w3 = ptr_write_i64_le(m_ptr, slot_off + 24, 1)
                } else {
                    layer_complete = false
                }
                k = k + 1
            }
            if layer_complete {
                found_any = true
            } else {
                var j: i64 = 0
                while j < 6 {
                    let slot_off = (l * 6 + j) * 32
                    let _w3 = ptr_write_i64_le(m_ptr, slot_off + 24, 0)
                    j = j + 1
                }
            }
            l = l + 1
        }

        heap_free(name_buf as *mut u8)
        sidecar_ok = found_any
    }

    Qwen3OssmSidecar {
        shard: shard,
        meta: meta,
        b_sidecar: 0,
        n_layers: n_layers,
        hidden: hidden,
        ok: sidecar_ok,
    }
}

// ============================================================================
// Hybrid Schedule & Selective Step (CPU)
// ============================================================================

pub fn qwen3_hybrid_layer_is_ossm(layer: i64, ossm_every: i64) -> bool with Div {
    ossm_every > 0 && (layer % ossm_every) == (ossm_every - 1)
}

pub fn qwen3_ossm_step_cpu(
    st: &!Qwen3OssmState,
    layer: i64,
    u_f32_ptr: i64,
    alpha_f32_ptr: i64,
    b_f32_ptr: i64,
    dt_f32_ptr: i64,
    c_f32_ptr: i64,
    y_f32_ptr: i64
) -> bool with Alloc, Mut, Div {
    if !st.ok || layer < 0 || layer >= st.n_layers || u_f32_ptr == 0 || alpha_f32_ptr == 0
        || b_f32_ptr == 0 || dt_f32_ptr == 0 || c_f32_ptr == 0 || y_f32_ptr == 0 {
        return false
    }

    let scratch = st.arena_ptr + st.n_layers * st.n_oct * 32
    let bu_ptr = scratch
    let inj_ptr = scratch + 32
    let h_new_ptr = scratch + 64

    let layer_base = st.arena_ptr + qwen3_ossm_state_layer_off(st, layer)
    var c: i64 = 0
    while c < st.n_oct {
        let h_c = layer_base + c * 32
        let u_c = u_f32_ptr + c * 32
        let alpha_c = alpha_f32_ptr + c * 32
        let b_c = b_f32_ptr + c * 32
        let dt_c = dt_f32_ptr + c * 32
        let c_c = c_f32_ptr + c * 32
        let y_c = y_f32_ptr + c * 32

        // 1) Decay gate
        let alpha_0 = ossm_read_f32(alpha_c, 0)
        let decay = 1.0 / (1.0 + exp(0.0 - alpha_0))

        // 2) Left-parenthesized inject: (B * U) * dt (NEVER reassociated!)
        qwen3_ossm_oct_mul_f32(b_c, u_c, bu_ptr)
        qwen3_ossm_oct_mul_f32(bu_ptr, dt_c, inj_ptr)

        // 3) Update state: H_new = decay * H_prev + inj
        var k: i64 = 0
        while k < 8 {
            let h_prev = ossm_read_f32(h_c, k)
            let inj_k = ossm_read_f32(inj_ptr, k)
            let h_new = decay * h_prev + inj_k
            ossm_write_f32(h_c, k, h_new)
            ossm_write_f32(h_new_ptr, k, h_new)
            k = k + 1
        }

        // 4) Output: Y_c = C_c * H_new
        qwen3_ossm_oct_mul_f32(c_c, h_new_ptr, y_c)

        c = c + 1
    }

    true
}

// ============================================================================
// Metal MSL Pipelines
// ============================================================================

pub struct OssmMetalPipelines {
    pub pipe_step: i64,
    pub ok: bool,
}

pub fn ossm_metal_pipelines_empty() -> OssmMetalPipelines {
    OssmMetalPipelines {
        pipe_step: 0,
        ok: false,
    }
}

pub fn emit_ossm_kernels_msl_cstr() -> i64 with Alloc, Mut {
    let buf = heap_alloc(4096) as i64
    var p: i64 = 0
    p = bf16_cstr_append(buf, p, "#include <metal_stdlib>\nusing namespace metal;\n\n")
    p = bf16_cstr_append(buf, p, "struct OctF32 {\n    float c0, c1, c2, c3, c4, c5, c6, c7;\n};\n\n")

    p = bf16_cstr_append(buf, p, "static inline OctF32 msl_oct_mul(OctF32 a, OctF32 b) {\n    OctF32 r;\n")
    p = bf16_cstr_append(buf, p, "    r.c0 = a.c0*b.c0 - a.c1*b.c1 - a.c2*b.c2 - a.c3*b.c3 - a.c4*b.c4 - a.c5*b.c5 - a.c6*b.c6 - a.c7*b.c7;\n")
    p = bf16_cstr_append(buf, p, "    r.c1 = a.c0*b.c1 + a.c1*b.c0 + a.c2*b.c3 - a.c3*b.c2 + a.c4*b.c5 - a.c5*b.c4 - a.c6*b.c7 + a.c7*b.c6;\n")
    p = bf16_cstr_append(buf, p, "    r.c2 = a.c0*b.c2 - a.c1*b.c3 + a.c2*b.c0 + a.c3*b.c1 + a.c4*b.c6 + a.c5*b.c7 - a.c6*b.c4 - a.c7*b.c5;\n")
    p = bf16_cstr_append(buf, p, "    r.c3 = a.c0*b.c3 + a.c1*b.c2 - a.c2*b.c1 + a.c3*b.c0 + a.c4*b.c7 - a.c5*b.c6 + a.c6*b.c5 - a.c7*b.c4;\n")
    p = bf16_cstr_append(buf, p, "    r.c4 = a.c0*b.c4 - a.c1*b.c5 - a.c2*b.c6 - a.c3*b.c7 + a.c4*b.c0 + a.c5*b.c1 + a.c6*b.c2 + a.c7*b.c3;\n")
    p = bf16_cstr_append(buf, p, "    r.c5 = a.c0*b.c5 + a.c1*b.c4 - a.c2*b.c7 + a.c3*b.c6 - a.c4*b.c1 + a.c5*b.c0 - a.c6*b.c3 + a.c7*b.c2;\n")
    p = bf16_cstr_append(buf, p, "    r.c6 = a.c0*b.c6 + a.c1*b.c7 + a.c2*b.c4 - a.c3*b.c5 - a.c4*b.c2 + a.c5*b.c3 + a.c6*b.c0 - a.c7*b.c1;\n")
    p = bf16_cstr_append(buf, p, "    r.c7 = a.c0*b.c7 - a.c1*b.c6 + a.c2*b.c5 + a.c3*b.c4 - a.c4*b.c3 - a.c5*b.c2 + a.c6*b.c1 + a.c7*b.c0;\n")
    p = bf16_cstr_append(buf, p, "    return r;\n}\n\n")

    p = bf16_cstr_append(buf, p, "kernel void qwen3_ossm_step_f32(\n")
    p = bf16_cstr_append(buf, p, "    device uchar* st_base [[buffer(0)]],\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* u_base [[buffer(1)]],\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* alpha_base [[buffer(2)]],\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* b_base [[buffer(3)]],\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* dt_base [[buffer(4)]],\n")
    p = bf16_cstr_append(buf, p, "    device const uchar* c_base [[buffer(5)]],\n")
    p = bf16_cstr_append(buf, p, "    device uchar* y_base [[buffer(6)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& st_off [[buffer(7)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& u_off [[buffer(8)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& alpha_off [[buffer(9)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& b_off [[buffer(10)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& dt_off [[buffer(11)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& c_off [[buffer(12)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& y_off [[buffer(13)]],\n")
    p = bf16_cstr_append(buf, p, "    constant ulong& n_oct [[buffer(14)]],\n")
    p = bf16_cstr_append(buf, p, "    uint gid [[thread_position_in_grid]]) {\n")
    p = bf16_cstr_append(buf, p, "    if ((ulong)gid >= n_oct) return;\n")
    p = bf16_cstr_append(buf, p, "    ulong c = (ulong)gid;\n")
    p = bf16_cstr_append(buf, p, "    device float* h_ptr = (device float*)(st_base + st_off) + c * 8;\n")
    p = bf16_cstr_append(buf, p, "    device const float* u_ptr = (device const float*)(u_base + u_off) + c * 8;\n")
    p = bf16_cstr_append(buf, p, "    device const float* alpha_ptr = (device const float*)(alpha_base + alpha_off) + c * 8;\n")
    p = bf16_cstr_append(buf, p, "    device const float* b_ptr = (device const float*)(b_base + b_off) + c * 8;\n")
    p = bf16_cstr_append(buf, p, "    device const float* dt_ptr = (device const float*)(dt_base + dt_off) + c * 8;\n")
    p = bf16_cstr_append(buf, p, "    device const float* c_ptr = (device const float*)(c_base + c_off) + c * 8;\n")
    p = bf16_cstr_append(buf, p, "    device float* y_ptr = (device float*)(y_base + y_off) + c * 8;\n\n")

    p = bf16_cstr_append(buf, p, "    float decay = 1.0f / (1.0f + exp(-alpha_ptr[0]));\n")
    p = bf16_cstr_append(buf, p, "    OctF32 B = {b_ptr[0], b_ptr[1], b_ptr[2], b_ptr[3], b_ptr[4], b_ptr[5], b_ptr[6], b_ptr[7]};\n")
    p = bf16_cstr_append(buf, p, "    OctF32 U = {u_ptr[0], u_ptr[1], u_ptr[2], u_ptr[3], u_ptr[4], u_ptr[5], u_ptr[6], u_ptr[7]};\n")
    p = bf16_cstr_append(buf, p, "    OctF32 DT = {dt_ptr[0], dt_ptr[1], dt_ptr[2], dt_ptr[3], dt_ptr[4], dt_ptr[5], dt_ptr[6], dt_ptr[7]};\n")
    p = bf16_cstr_append(buf, p, "    OctF32 C = {c_ptr[0], c_ptr[1], c_ptr[2], c_ptr[3], c_ptr[4], c_ptr[5], c_ptr[6], c_ptr[7]};\n\n")

    p = bf16_cstr_append(buf, p, "    OctF32 BU = msl_oct_mul(B, U);\n")
    p = bf16_cstr_append(buf, p, "    OctF32 INJ = msl_oct_mul(BU, DT);\n\n")

    p = bf16_cstr_append(buf, p, "    OctF32 H_new;\n")
    p = bf16_cstr_append(buf, p, "    H_new.c0 = decay * h_ptr[0] + INJ.c0;\n")
    p = bf16_cstr_append(buf, p, "    H_new.c1 = decay * h_ptr[1] + INJ.c1;\n")
    p = bf16_cstr_append(buf, p, "    H_new.c2 = decay * h_ptr[2] + INJ.c2;\n")
    p = bf16_cstr_append(buf, p, "    H_new.c3 = decay * h_ptr[3] + INJ.c3;\n")
    p = bf16_cstr_append(buf, p, "    H_new.c4 = decay * h_ptr[4] + INJ.c4;\n")
    p = bf16_cstr_append(buf, p, "    H_new.c5 = decay * h_ptr[5] + INJ.c5;\n")
    p = bf16_cstr_append(buf, p, "    H_new.c6 = decay * h_ptr[6] + INJ.c6;\n")
    p = bf16_cstr_append(buf, p, "    H_new.c7 = decay * h_ptr[7] + INJ.c7;\n\n")

    p = bf16_cstr_append(buf, p, "    h_ptr[0] = H_new.c0;\n    h_ptr[1] = H_new.c1;\n    h_ptr[2] = H_new.c2;\n    h_ptr[3] = H_new.c3;\n")
    p = bf16_cstr_append(buf, p, "    h_ptr[4] = H_new.c4;\n    h_ptr[5] = H_new.c5;\n    h_ptr[6] = H_new.c6;\n    h_ptr[7] = H_new.c7;\n\n")

    p = bf16_cstr_append(buf, p, "    OctF32 Y = msl_oct_mul(C, H_new);\n")
    p = bf16_cstr_append(buf, p, "    y_ptr[0] = Y.c0;\n    y_ptr[1] = Y.c1;\n    y_ptr[2] = Y.c2;\n    y_ptr[3] = Y.c3;\n")
    p = bf16_cstr_append(buf, p, "    y_ptr[4] = Y.c4;\n    y_ptr[5] = Y.c5;\n    y_ptr[6] = Y.c6;\n    y_ptr[7] = Y.c7;\n}\n\n")

    buf
}

pub fn ossm_metal_pipelines_compile(s: &MetalSession) -> OssmMetalPipelines with Alloc, Mut {
    if !s.ok { return ossm_metal_pipelines_empty() }
    let c_msl = emit_ossm_kernels_msl_cstr()
    if c_msl == 0 { return ossm_metal_pipelines_empty() }
    let p_step = metal_compile_msl_ptr(s, c_msl, "qwen3_ossm_step_f32")
    heap_free(c_msl as *mut u8)
    if p_step <= 0 {
        return ossm_metal_pipelines_empty()
    }
    OssmMetalPipelines {
        pipe_step: p_step,
        ok: true,
    }
}

pub fn ossm_metal_pipelines_compile_runner(rt: &Qwen3MetalRunner) -> OssmMetalPipelines with Alloc, Mut {
    ossm_metal_pipelines_compile(&rt.sess)
}

pub fn qwen3_metal_encode_ossm_step(
    s: &MetalSession,
    cid: i64,
    pipe: i64,
    buf_st: i64, st_off: i64,
    buf_u: i64, u_off: i64,
    buf_alpha: i64, alpha_off: i64,
    buf_b: i64, b_off: i64,
    buf_dt: i64, dt_off: i64,
    buf_c: i64, c_off: i64,
    buf_y: i64, y_off: i64,
    n_oct: i64
) -> i64 {
    if !s.ok || cid <= 0 || pipe <= 0 || buf_st <= 0 || buf_u <= 0 || buf_alpha <= 0
        || buf_b <= 0 || buf_dt <= 0 || buf_c <= 0 || buf_y <= 0 || n_oct <= 0 {
        return -1
    }

    if metal_cmd_set_buf(s, cid, 0, buf_st, 0) != 0
        || metal_cmd_set_buf(s, cid, 1, buf_u, 0) != 0
        || metal_cmd_set_buf(s, cid, 2, buf_alpha, 0) != 0
        || metal_cmd_set_buf(s, cid, 3, buf_b, 0) != 0
        || metal_cmd_set_buf(s, cid, 4, buf_dt, 0) != 0
        || metal_cmd_set_buf(s, cid, 5, buf_c, 0) != 0
        || metal_cmd_set_buf(s, cid, 6, buf_y, 0) != 0
        || metal_cmd_set_u64(s, cid, 7, st_off) != 0
        || metal_cmd_set_u64(s, cid, 8, u_off) != 0
        || metal_cmd_set_u64(s, cid, 9, alpha_off) != 0
        || metal_cmd_set_u64(s, cid, 10, b_off) != 0
        || metal_cmd_set_u64(s, cid, 11, dt_off) != 0
        || metal_cmd_set_u64(s, cid, 12, c_off) != 0
        || metal_cmd_set_u64(s, cid, 13, y_off) != 0
        || metal_cmd_set_u64(s, cid, 14, n_oct) != 0 {
        return -1
    }

    let group_threads = if n_oct < 32 { n_oct } else { 32 }
    if metal_cmd_dispatch_1d(s, cid, pipe, n_oct, group_threads) != 0 {
        return -1
    }
    0
}

pub fn qwen3_metal_ossm_step(
    s: &MetalSession,
    pipe: i64,
    buf_st: i64, st_off: i64,
    buf_u: i64, u_off: i64,
    buf_alpha: i64, alpha_off: i64,
    buf_b: i64, b_off: i64,
    buf_dt: i64, dt_off: i64,
    buf_c: i64, c_off: i64,
    buf_y: i64, y_off: i64,
    n_oct: i64
) -> i64 {
    if !s.ok || pipe <= 0 || buf_st <= 0 || buf_u <= 0 || buf_alpha <= 0
        || buf_b <= 0 || buf_dt <= 0 || buf_c <= 0 || buf_y <= 0 || n_oct <= 0 {
        return -1
    }
    let cid = metal_cmd_begin(s)
    if cid <= 0 { return -1 }

    if qwen3_metal_encode_ossm_step(s, cid, pipe, buf_st, st_off, buf_u, u_off, buf_alpha, alpha_off, buf_b, b_off, buf_dt, dt_off, buf_c, c_off, buf_y, y_off, n_oct) != 0 {
        let _c = metal_cmd_cancel(s, cid)
        return -1
    }

    metal_cmd_commit_sync(s, cid)
}

