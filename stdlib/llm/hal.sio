// stdlib::llm::hal — Linear-typed GPU session HAL for Metal NoCopy (macOS ARM64)
// and CUDA Driver API PTX (Linux x86-64 via libcuda.so.1 / SOUNIO_CUDA_DRIVER_LIB).

extern "C" {
    fn dlopen(filename: *mut u8, flags: i32) -> *mut u8
    fn dlsym(handle: *mut u8, symbol: *mut u8) -> *mut u8
    fn dlclose(handle: *mut u8) -> i32
    fn dlerror() -> *mut u8
}

fn hal_cstr(s: string) -> i64 with Alloc, Mut {
    let n = str_len(s)
    let buf = heap_alloc(n + 8) as i64
    var i: i64 = 0
    while i < n {
        let _w = ptr_write_u8(buf, i, str_char_at(s, i))
        i = i + 1
    }
    let _z = ptr_write_u8(buf, n, 0)
    buf
}

fn hal_free_cstr(ptr: i64) {
    if ptr != 0 {
        heap_free(ptr as *mut u8)
    }
}

fn hal_dlopen_str(path: string, flags: i32) -> i64 with Alloc, Mut {
    let cs = hal_cstr(path)
    let h = dlopen(cs as *mut u8, flags) as i64
    hal_free_cstr(cs)
    h
}

fn hal_dlsym_str(handle: i64, sym: string) -> i64 with Alloc, Mut {
    let cs = hal_cstr(sym)
    let p = dlsym(handle as *mut u8, cs as *mut u8) as i64
    hal_free_cstr(cs)
    p
}

pub fn hal_getenv_ptr(var_name: string) -> i64 with Alloc, Mut {
    let main_h = dlopen(0 as *mut u8, 1) as i64
    if main_h == 0 { return 0 }
    let ge_raw = hal_dlsym_str(main_h, "getenv")
    if ge_raw == 0 {
        let _c = dlclose(main_h as *mut u8)
        return 0
    }
    let ge = ge_raw as fn(i64) -> i64
    let cs = hal_cstr(var_name)
    let val = ge(cs)
    hal_free_cstr(cs)
    let _c = dlclose(main_h as *mut u8)
    val
}

fn hal_c_i32(raw: i64) -> i64 {
    let u = raw & 4294967295
    if u >= 2147483648 { u - 4294967296 } else { u }
}

pub linear struct MetalSession {
    pub lib_handle: i64,
    pub sess_id: i64,
    pub fn_destroy: i64,
    pub fn_buf_nocopy: i64,
    pub fn_buf_alloc: i64,
    pub fn_buf_contents: i64,
    pub fn_buf_free: i64,
    pub fn_compile_msl: i64,
    pub fn_cmd_begin: i64,
    pub fn_cmd_cancel: i64,
    pub fn_cmd_set_buf: i64,
    pub fn_cmd_set_u64: i64,
    pub fn_cmd_dispatch_1d: i64,
    pub fn_cmd_commit_sync: i64,
    pub ok: bool,
}

fn metal_session_empty() -> MetalSession {
    MetalSession {
        lib_handle: 0,
        sess_id: 0,
        fn_destroy: 0,
        fn_buf_nocopy: 0,
        fn_buf_alloc: 0,
        fn_buf_contents: 0,
        fn_buf_free: 0,
        fn_compile_msl: 0,
        fn_cmd_begin: 0,
        fn_cmd_cancel: 0,
        fn_cmd_set_buf: 0,
        fn_cmd_set_u64: 0,
        fn_cmd_dispatch_1d: 0,
        fn_cmd_commit_sync: 0,
        ok: false,
    }
}

fn hal_append_cstr_lit(buf: i64, start: i64, lit: string) -> i64 with Mut {
    let n = str_len(lit)
    var i: i64 = 0
    while i < n {
        let _w = ptr_write_u8(buf, start + i, str_char_at(lit, i) as u8)
        i = i + 1
    }
    let _z = ptr_write_u8(buf, start + n, 0)
    start + n
}

fn hal_try_exe_rel_metal_suffix(exe_buf: i64, base_len: i64, cand_buf: i64, suffix: string) -> i64 with Mut {
    if base_len <= 0 || base_len > 3500 { return 0 }
    var i: i64 = 0
    while i < base_len {
        let _w = ptr_write_u8(cand_buf, i, ptr_read_u8(exe_buf, i))
        i = i + 1
    }
    let _tot = hal_append_cstr_lit(cand_buf, base_len, suffix)
    dlopen(cand_buf as *mut u8, 2) as i64
}

fn hal_dlopen_exe_relative_metal() -> i64 with Alloc, Mut {
    let main_h = dlopen(0 as *mut u8, 1) as i64
    if main_h == 0 { return 0 }
    let fn_ns_raw = hal_dlsym_str(main_h, "_NSGetExecutablePath")
    let _cm = dlclose(main_h as *mut u8)
    if fn_ns_raw == 0 { return 0 }

    let exe_buf = heap_alloc(4096) as i64
    let sz_buf = heap_alloc(16) as i64
    let cand_buf = heap_alloc(4096) as i64
    if exe_buf == 0 || sz_buf == 0 || cand_buf == 0 {
        if exe_buf != 0 { heap_free(exe_buf as *mut u8) }
        if sz_buf != 0 { heap_free(sz_buf as *mut u8) }
        if cand_buf != 0 { heap_free(cand_buf as *mut u8) }
        return 0
    }
    let _wsz = ptr_write_u32_le(sz_buf, 0, 4096)
    let ns_fn = fn_ns_raw as fn(i64, i64) -> i32
    let rc = ns_fn(exe_buf, sz_buf)
    var lib: i64 = 0
    if rc == 0 {
        var len: i64 = 0
        while len < 4095 && ptr_read_u8(exe_buf, len) != 0 {
            len = len + 1
        }
        var slash0: i64 = len - 1
        while slash0 >= 0 && ptr_read_u8(exe_buf, slash0) != 47 {
            slash0 = slash0 - 1
        }
        if slash0 > 0 {
            lib = hal_try_exe_rel_metal_suffix(exe_buf, slash0, cand_buf, "/libsounio_metal.dylib")
            if lib == 0 {
                lib = hal_try_exe_rel_metal_suffix(exe_buf, slash0, cand_buf, "/artifacts/self-hosted/libsounio_metal.dylib")
            }
            if lib == 0 {
                var slash1: i64 = slash0 - 1
                while slash1 >= 0 && ptr_read_u8(exe_buf, slash1) != 47 {
                    slash1 = slash1 - 1
                }
                if slash1 > 0 {
                    lib = hal_try_exe_rel_metal_suffix(exe_buf, slash1, cand_buf, "/artifacts/self-hosted/libsounio_metal.dylib")
                }
            }
        }
    }
    heap_free(exe_buf as *mut u8)
    heap_free(sz_buf as *mut u8)
    heap_free(cand_buf as *mut u8)
    lib
}

pub fn metal_session_open(runtime_path: string) -> MetalSession with Alloc, Mut {
    var lib: i64 = 0
    if str_len(runtime_path) > 0 {
        lib = hal_dlopen_str(runtime_path, 2)
    } else {
        let env_p = hal_getenv_ptr("SOUNIO_METAL_RUNTIME")
        if env_p != 0 {
            lib = dlopen(env_p as *mut u8, 2) as i64
        }
        if lib == 0 {
            lib = hal_dlopen_str("./artifacts/self-hosted/libsounio_metal.dylib", 2)
        }
        if lib == 0 {
            lib = hal_dlopen_exe_relative_metal()
        }
        if lib == 0 {
            lib = hal_dlopen_str("libsounio_metal.dylib", 2)
        }
    }
    if lib == 0 { return metal_session_empty() }

    let fn_create = hal_dlsym_str(lib, "sounio_metal_session_create")
    let fn_destroy = hal_dlsym_str(lib, "sounio_metal_session_destroy")
    let fn_buf_nocopy = hal_dlsym_str(lib, "sounio_metal_buffer_nocopy")
    let fn_buf_alloc = hal_dlsym_str(lib, "sounio_metal_buffer_alloc")
    let fn_buf_contents = hal_dlsym_str(lib, "sounio_metal_buffer_contents")
    let fn_buf_free = hal_dlsym_str(lib, "sounio_metal_buffer_free")
    let fn_compile_msl = hal_dlsym_str(lib, "sounio_metal_compile_msl")
    let fn_cmd_begin = hal_dlsym_str(lib, "sounio_metal_cmd_begin")
    let fn_cmd_cancel = hal_dlsym_str(lib, "sounio_metal_cmd_cancel")
    let fn_cmd_set_buf = hal_dlsym_str(lib, "sounio_metal_cmd_set_buffer")
    let fn_cmd_set_u64 = hal_dlsym_str(lib, "sounio_metal_cmd_set_u64")
    let fn_cmd_dispatch_1d = hal_dlsym_str(lib, "sounio_metal_cmd_dispatch_1d")
    let fn_cmd_commit_sync = hal_dlsym_str(lib, "sounio_metal_cmd_commit_sync")

    if fn_create == 0 || fn_destroy == 0 || fn_buf_nocopy == 0 || fn_buf_alloc == 0
        || fn_buf_contents == 0 || fn_buf_free == 0 || fn_compile_msl == 0 || fn_cmd_begin == 0
        || fn_cmd_cancel == 0 || fn_cmd_set_buf == 0 || fn_cmd_set_u64 == 0 || fn_cmd_dispatch_1d == 0
        || fn_cmd_commit_sync == 0 {
        let _c = dlclose(lib as *mut u8)
        return metal_session_empty()
    }

    let create = fn_create as fn() -> i64
    let sid = create()
    if sid <= 0 {
        let _c = dlclose(lib as *mut u8)
        return metal_session_empty()
    }

    MetalSession {
        lib_handle: lib,
        sess_id: sid,
        fn_destroy: fn_destroy,
        fn_buf_nocopy: fn_buf_nocopy,
        fn_buf_alloc: fn_buf_alloc,
        fn_buf_contents: fn_buf_contents,
        fn_buf_free: fn_buf_free,
        fn_compile_msl: fn_compile_msl,
        fn_cmd_begin: fn_cmd_begin,
        fn_cmd_cancel: fn_cmd_cancel,
        fn_cmd_set_buf: fn_cmd_set_buf,
        fn_cmd_set_u64: fn_cmd_set_u64,
        fn_cmd_dispatch_1d: fn_cmd_dispatch_1d,
        fn_cmd_commit_sync: fn_cmd_commit_sync,
        ok: true,
    }
}

pub fn metal_session_is_ok(s: &MetalSession) -> bool { s.ok }

pub fn metal_session_close(s: MetalSession) -> i64 {
    let MetalSession {
        lib_handle,
        sess_id,
        fn_destroy,
        fn_buf_nocopy: _,
        fn_buf_alloc: _,
        fn_buf_contents: _,
        fn_buf_free: _,
        fn_compile_msl: _,
        fn_cmd_begin: _,
        fn_cmd_cancel: _,
        fn_cmd_set_buf: _,
        fn_cmd_set_u64: _,
        fn_cmd_dispatch_1d: _,
        fn_cmd_commit_sync: _,
        ok,
    } = s
    if ok && sess_id > 0 && fn_destroy != 0 {
        let destroy = fn_destroy as fn(i64) -> i64
        let _rc = destroy(sess_id)
    }
    if lib_handle != 0 {
        let _c = dlclose(lib_handle as *mut u8)
    }
    0
}

pub fn metal_buffer_nocopy(s: &MetalSession, host_ptr: i64, byte_len: i64) -> i64 {
    if !s.ok { return 0 }
    let f = s.fn_buf_nocopy as fn(i64, i64, i64) -> i64
    f(s.sess_id, host_ptr, byte_len)
}

pub fn metal_buffer_alloc(s: &MetalSession, byte_len: i64) -> i64 {
    if !s.ok || byte_len <= 0 { return 0 }
    let f = s.fn_buf_alloc as fn(i64, i64) -> i64
    f(s.sess_id, byte_len)
}

pub fn metal_buffer_contents(s: &MetalSession, buf_id: i64) -> i64 {
    if !s.ok || buf_id <= 0 { return 0 }
    let f = s.fn_buf_contents as fn(i64) -> i64
    f(buf_id)
}

pub fn metal_buffer_free(s: &MetalSession, buf_id: i64) -> i64 {
    if !s.ok || buf_id <= 0 { return -1 }
    let f = s.fn_buf_free as fn(i64) -> i64
    f(buf_id)
}

pub fn metal_compile_msl_ptr(s: &MetalSession, c_src: i64, entry: string) -> i64 with Alloc, Mut {
    if !s.ok || c_src == 0 { return 0 }
    let f = s.fn_compile_msl as fn(i64, i64, i64) -> i64
    let c_entry = hal_cstr(entry)
    let pid = f(s.sess_id, c_src, c_entry)
    hal_free_cstr(c_entry)
    pid
}

pub fn metal_compile_msl(s: &MetalSession, msl_src: string, entry: string) -> i64 with Alloc, Mut {
    if !s.ok { return 0 }
    let c_src = hal_cstr(msl_src)
    let pid = metal_compile_msl_ptr(s, c_src, entry)
    hal_free_cstr(c_src)
    pid
}

pub fn metal_cmd_begin(s: &MetalSession) -> i64 {
    if !s.ok { return 0 }
    let f = s.fn_cmd_begin as fn(i64) -> i64
    f(s.sess_id)
}

pub fn metal_cmd_cancel(s: &MetalSession, cid: i64) -> i64 {
    if !s.ok || cid <= 0 { return -1 }
    let f = s.fn_cmd_cancel as fn(i64) -> i64
    f(cid)
}

pub fn metal_cmd_set_buf(s: &MetalSession, cid: i64, slot: i64, buf_id: i64, byte_off: i64) -> i64 {
    if !s.ok || cid <= 0 || slot < 0 || buf_id <= 0 || byte_off < 0 { return -1 }
    let f = s.fn_cmd_set_buf as fn(i64, i64, i64, i64) -> i64
    f(cid, slot, buf_id, byte_off)
}

pub fn metal_cmd_set_u64(s: &MetalSession, cid: i64, slot: i64, val: i64) -> i64 {
    if !s.ok || cid <= 0 || slot < 0 { return -1 }
    let f = s.fn_cmd_set_u64 as fn(i64, i64, i64) -> i64
    f(cid, slot, val)
}

pub fn metal_cmd_dispatch_1d(s: &MetalSession, cid: i64, pipe_id: i64, total_threads: i64, group_threads: i64) -> i64 {
    if !s.ok || cid <= 0 || pipe_id <= 0 || total_threads <= 0 || group_threads <= 0 { return -1 }
    let f = s.fn_cmd_dispatch_1d as fn(i64, i64, i64, i64) -> i64
    f(cid, pipe_id, total_threads, group_threads)
}

pub fn metal_cmd_commit_sync(s: &MetalSession, cid: i64) -> i64 {
    if !s.ok || cid <= 0 { return -1 }
    let f = s.fn_cmd_commit_sync as fn(i64) -> i64
    f(cid)
}

pub fn metal_dispatch_2buf_u64(
    s: &MetalSession,
    pipe_id: i64,
    buf0: i64,
    off0: i64,
    buf1: i64,
    off1: i64,
    arg2_u64: i64,
    total_threads: i64,
    group_threads: i64
) -> i64 {
    if !s.ok || pipe_id <= 0 || buf0 <= 0 || buf1 <= 0 { return -1 }
    let cmd_begin = s.fn_cmd_begin as fn(i64) -> i64
    let cid = cmd_begin(s.sess_id)
    if cid <= 0 { return -1 }

    let cmd_cancel = s.fn_cmd_cancel as fn(i64) -> i64
    let set_buf = s.fn_cmd_set_buf as fn(i64, i64, i64, i64) -> i64
    let set_u64 = s.fn_cmd_set_u64 as fn(i64, i64, i64) -> i64
    let disp = s.fn_cmd_dispatch_1d as fn(i64, i64, i64, i64) -> i64
    let commit_sync = s.fn_cmd_commit_sync as fn(i64) -> i64

    if set_buf(cid, 0, buf0, off0) != 0 {
        let _c = cmd_cancel(cid)
        return -1
    }
    if set_buf(cid, 1, buf1, off1) != 0 {
        let _c = cmd_cancel(cid)
        return -1
    }
    if set_u64(cid, 2, arg2_u64) != 0 {
        let _c = cmd_cancel(cid)
        return -1
    }
    if disp(cid, pipe_id, total_threads, group_threads) != 0 {
        let _c = cmd_cancel(cid)
        return -1
    }
    commit_sync(cid)
}

pub linear struct CudaDriverSession {
    pub lib_handle: i64,
    pub dev: i64,
    pub ctx: i64,
    pub fn_ctx_destroy: i64,
    pub fn_mod_load_data: i64,
    pub fn_mod_load_data_ex: i64,
    pub fn_mod_unload: i64,
    pub fn_mod_get_fn: i64,
    pub fn_mem_alloc: i64,
    pub fn_mem_free: i64,
    pub fn_memcpy_h2d: i64,
    pub fn_memcpy_d2h: i64,
    pub fn_launch_kernel: i64,
    pub fn_ctx_sync: i64,
    pub fn_dev_get_name: i64,
    pub fn_driver_get_ver: i64,
    pub launch_scratch: i64,
    pub ok: bool,
}

fn cuda_session_empty() -> CudaDriverSession {
    CudaDriverSession {
        lib_handle: 0,
        dev: 0,
        ctx: 0,
        fn_ctx_destroy: 0,
        fn_mod_load_data: 0,
        fn_mod_load_data_ex: 0,
        fn_mod_unload: 0,
        fn_mod_get_fn: 0,
        fn_mem_alloc: 0,
        fn_mem_free: 0,
        fn_memcpy_h2d: 0,
        fn_memcpy_d2h: 0,
        fn_launch_kernel: 0,
        fn_ctx_sync: 0,
        fn_dev_get_name: 0,
        fn_driver_get_ver: 0,
        launch_scratch: 0,
        ok: false,
    }
}

fn hal_parse_env_nonneg_i64(cstr_ptr: i64, fallback: i64) -> i64 {
    if cstr_ptr == 0 { return fallback }
    let b0 = ptr_read_u8(cstr_ptr, 0)
    if b0 < 48 || b0 > 57 { return fallback }
    var acc: i64 = 0
    var i: i64 = 0
    while i < 16 {
        let ch = ptr_read_u8(cstr_ptr, i)
        if ch < 48 || ch > 57 { break }
        acc = acc * 10 + (ch - 48)
        i = i + 1
    }
    acc
}

pub fn cuda_session_open(driver_path: string, ordinal: i64) -> CudaDriverSession with Alloc, Mut {
    var lib: i64 = 0
    if str_len(driver_path) > 0 {
        lib = hal_dlopen_str(driver_path, 1)
    } else {
        let env_p = hal_getenv_ptr("SOUNIO_CUDA_DRIVER_LIB")
        if env_p != 0 {
            lib = dlopen(env_p as *mut u8, 1) as i64
        }
        if lib == 0 {
            lib = hal_dlopen_str("libcuda.so.1", 1)
        }
    }
    if lib == 0 { return cuda_session_empty() }

    let fn_init = hal_dlsym_str(lib, "cuInit")
    let fn_dev_get = hal_dlsym_str(lib, "cuDeviceGet")
    let fn_ctx_create = hal_dlsym_str(lib, "cuCtxCreate_v2")
    let fn_ctx_destroy = hal_dlsym_str(lib, "cuCtxDestroy_v2")
    let fn_mod_load_data = hal_dlsym_str(lib, "cuModuleLoadData")
    let fn_mod_load_data_ex = hal_dlsym_str(lib, "cuModuleLoadDataEx")
    let fn_mod_unload = hal_dlsym_str(lib, "cuModuleUnload")
    let fn_mod_get_fn = hal_dlsym_str(lib, "cuModuleGetFunction")
    let fn_mem_alloc = hal_dlsym_str(lib, "cuMemAlloc_v2")
    let fn_mem_free = hal_dlsym_str(lib, "cuMemFree_v2")
    let fn_memcpy_h2d = hal_dlsym_str(lib, "cuMemcpyHtoD_v2")
    let fn_memcpy_d2h = hal_dlsym_str(lib, "cuMemcpyDtoH_v2")
    let fn_launch_kernel = hal_dlsym_str(lib, "cuLaunchKernel")
    let fn_ctx_sync = hal_dlsym_str(lib, "cuCtxSynchronize")
    let fn_dev_get_name = hal_dlsym_str(lib, "cuDeviceGetName")
    let fn_driver_get_ver = hal_dlsym_str(lib, "cuDriverGetVersion")

    if fn_init == 0 || fn_dev_get == 0 || fn_ctx_create == 0 || fn_ctx_destroy == 0
        || fn_mod_load_data == 0 || fn_mod_unload == 0 || fn_mod_get_fn == 0
        || fn_mem_alloc == 0 || fn_mem_free == 0 || fn_memcpy_h2d == 0
        || fn_memcpy_d2h == 0 || fn_launch_kernel == 0 || fn_ctx_sync == 0 {
        let _c = dlclose(lib as *mut u8)
        return cuda_session_empty()
    }

    let cu_init = fn_init as fn(i32) -> i64
    if hal_c_i32(cu_init(0)) != 0 {
        let _c = dlclose(lib as *mut u8)
        return cuda_session_empty()
    }

    var eff_ord = ordinal
    if eff_ord < 0 {
        let dev_env = hal_getenv_ptr("SOUNIO_CUDA_DEVICE")
        eff_ord = hal_parse_env_nonneg_i64(dev_env, 0)
    }

    let scratch = heap_alloc(16) as i64
    let _z0 = ptr_write_i64_le(scratch, 0, 0)
    let cu_dev_get = fn_dev_get as fn(i64, i32) -> i64
    if hal_c_i32(cu_dev_get(scratch, eff_ord as i32)) != 0 {
        heap_free(scratch as *mut u8)
        let _c = dlclose(lib as *mut u8)
        return cuda_session_empty()
    }
    let dev_id = ptr_read_u32_le(scratch, 0)

    let _z1 = ptr_write_i64_le(scratch, 0, 0)
    let cu_ctx_create = fn_ctx_create as fn(i64, i32, i32) -> i64
    if hal_c_i32(cu_ctx_create(scratch, 0 as i32, dev_id as i32)) != 0 {
        heap_free(scratch as *mut u8)
        let _c = dlclose(lib as *mut u8)
        return cuda_session_empty()
    }
    let ctx_h = ptr_read_i64_le(scratch, 0)
    heap_free(scratch as *mut u8)

    let lscratch = heap_alloc(256) as i64
    var zi: i64 = 0
    while zi < 32 {
        let _zw = ptr_write_i64_le(lscratch, zi * 8, 0)
        zi = zi + 1
    }

    CudaDriverSession {
        lib_handle: lib,
        dev: dev_id,
        ctx: ctx_h,
        fn_ctx_destroy: fn_ctx_destroy,
        fn_mod_load_data: fn_mod_load_data,
        fn_mod_load_data_ex: fn_mod_load_data_ex,
        fn_mod_unload: fn_mod_unload,
        fn_mod_get_fn: fn_mod_get_fn,
        fn_mem_alloc: fn_mem_alloc,
        fn_mem_free: fn_mem_free,
        fn_memcpy_h2d: fn_memcpy_h2d,
        fn_memcpy_d2h: fn_memcpy_d2h,
        fn_launch_kernel: fn_launch_kernel,
        fn_ctx_sync: fn_ctx_sync,
        fn_dev_get_name: fn_dev_get_name,
        fn_driver_get_ver: fn_driver_get_ver,
        launch_scratch: lscratch,
        ok: true,
    }
}

pub fn cuda_session_is_ok(s: &CudaDriverSession) -> bool { s.ok }

pub fn cuda_session_close(s: CudaDriverSession) -> i64 {
    let CudaDriverSession {
        lib_handle,
        dev: _,
        ctx,
        fn_ctx_destroy,
        fn_mod_load_data: _,
        fn_mod_load_data_ex: _,
        fn_mod_unload: _,
        fn_mod_get_fn: _,
        fn_mem_alloc: _,
        fn_mem_free: _,
        fn_memcpy_h2d: _,
        fn_memcpy_d2h: _,
        fn_launch_kernel: _,
        fn_ctx_sync,
        fn_dev_get_name: _,
        fn_driver_get_ver: _,
        launch_scratch,
        ok,
    } = s
    if launch_scratch != 0 {
        heap_free(launch_scratch as *mut u8)
    }
    if ok && ctx != 0 && fn_ctx_sync != 0 {
        let cu_sync = fn_ctx_sync as fn() -> i64
        let _rs = hal_c_i32(cu_sync())
    }
    if ok && ctx != 0 && fn_ctx_destroy != 0 {
        let cu_ctx_destroy = fn_ctx_destroy as fn(i64) -> i64
        let _rc = hal_c_i32(cu_ctx_destroy(ctx))
    }
    if lib_handle != 0 {
        let _c = dlclose(lib_handle as *mut u8)
    }
    0
}

pub fn cuda_module_load_ptx_ptr_ex(
    s: &CudaDriverSession,
    c_ptx: i64,
    err_buf: i64,
    err_cap: i64
) -> i64 with Alloc, Mut {
    if !s.ok || c_ptx == 0 { return 0 }
    let mod_box = heap_alloc(8) as i64
    let _z = ptr_write_i64_le(mod_box, 0, 0)
    if s.fn_mod_load_data_ex != 0 && err_buf != 0 && err_cap > 1 {
        let _ez = ptr_write_u8(err_buf, 0, 0)
        // CU_JIT_ERROR_LOG_BUFFER = 5, CU_JIT_ERROR_LOG_BUFFER_SIZE_BYTES = 6
        let opts = heap_alloc(16) as i64
        let _o0 = ptr_write_u32_le(opts, 0, 5)
        let _o1 = ptr_write_u32_le(opts, 4, 6)
        let vals = heap_alloc(16) as i64
        let _v0 = ptr_write_i64_le(vals, 0, err_buf)
        let _v1 = ptr_write_i64_le(vals, 8, err_cap)
        let fex = s.fn_mod_load_data_ex as fn(i64, i64, i32, i64, i64) -> i64
        let rc_ex = hal_c_i32(fex(mod_box, c_ptx, 2 as i32, opts, vals))
        let hmod_ex = ptr_read_i64_le(mod_box, 0)
        heap_free(vals as *mut u8)
        heap_free(opts as *mut u8)
        heap_free(mod_box as *mut u8)
        if rc_ex != 0 { return 0 }
        return hmod_ex
    }
    let f = s.fn_mod_load_data as fn(i64, i64) -> i64
    let rc = hal_c_i32(f(mod_box, c_ptx))
    let hmod = ptr_read_i64_le(mod_box, 0)
    heap_free(mod_box as *mut u8)
    if rc != 0 { return 0 }
    hmod
}

pub fn cuda_module_load_ptx_ptr(s: &CudaDriverSession, c_ptx: i64) -> i64 with Alloc, Mut {
    if !s.ok || c_ptx == 0 { return 0 }
    let mod_box = heap_alloc(8) as i64
    let _z = ptr_write_i64_le(mod_box, 0, 0)
    let f = s.fn_mod_load_data as fn(i64, i64) -> i64
    let rc = hal_c_i32(f(mod_box, c_ptx))
    let hmod = ptr_read_i64_le(mod_box, 0)
    heap_free(mod_box as *mut u8)
    if rc != 0 { return 0 }
    hmod
}

pub fn cuda_module_load_ptx(s: &CudaDriverSession, ptx_src: string) -> i64 with Alloc, Mut {
    if !s.ok { return 0 }
    let c_ptx = hal_cstr(ptx_src)
    let hmod = cuda_module_load_ptx_ptr(s, c_ptx)
    hal_free_cstr(c_ptx)
    hmod
}

pub fn cuda_module_unload(s: &CudaDriverSession, hmod: i64) -> i64 {
    if !s.ok || hmod == 0 { return -1 }
    let f = s.fn_mod_unload as fn(i64) -> i64
    hal_c_i32(f(hmod))
}

pub fn cuda_module_get_fn(s: &CudaDriverSession, hmod: i64, entry: string) -> i64 with Alloc, Mut {
    if !s.ok || hmod == 0 { return 0 }
    let fn_box = heap_alloc(8) as i64
    let _z = ptr_write_i64_le(fn_box, 0, 0)
    let c_entry = hal_cstr(entry)
    let f = s.fn_mod_get_fn as fn(i64, i64, i64) -> i64
    let rc = hal_c_i32(f(fn_box, hmod, c_entry))
    hal_free_cstr(c_entry)
    let hfn = ptr_read_i64_le(fn_box, 0)
    heap_free(fn_box as *mut u8)
    if rc != 0 { return 0 }
    hfn
}

pub fn cuda_mem_alloc(s: &CudaDriverSession, bytes: i64) -> i64 with Alloc {
    if !s.ok || bytes <= 0 { return 0 }
    let dptr_box = heap_alloc(8) as i64
    let _z = ptr_write_i64_le(dptr_box, 0, 0)
    let f = s.fn_mem_alloc as fn(i64, i64) -> i64
    let rc = hal_c_i32(f(dptr_box, bytes))
    let dptr = ptr_read_i64_le(dptr_box, 0)
    heap_free(dptr_box as *mut u8)
    if rc != 0 { return 0 }
    dptr
}

pub fn cuda_mem_free(s: &CudaDriverSession, dptr: i64) -> i64 {
    if !s.ok || dptr == 0 { return -1 }
    let f = s.fn_mem_free as fn(i64) -> i64
    hal_c_i32(f(dptr))
}

pub fn cuda_memcpy_h2d(s: &CudaDriverSession, dst_dev: i64, src_host: i64, bytes: i64) -> i64 {
    if !s.ok || dst_dev == 0 || src_host == 0 || bytes <= 0 { return -1 }
    let f = s.fn_memcpy_h2d as fn(i64, i64, i64) -> i64
    let chunk_cap: i64 = 16777216
    var off: i64 = 0
    while off < bytes {
        let rem = bytes - off
        let n = if rem > chunk_cap { chunk_cap } else { rem }
        let rc = hal_c_i32(f(dst_dev + off, src_host + off, n))
        if rc != 0 { return rc }
        off = off + n
    }
    0
}

pub fn cuda_memcpy_d2h(s: &CudaDriverSession, dst_host: i64, src_dev: i64, bytes: i64) -> i64 {
    if !s.ok || dst_host == 0 || src_dev == 0 || bytes <= 0 { return -1 }
    let f = s.fn_memcpy_d2h as fn(i64, i64, i64) -> i64
    hal_c_i32(f(dst_host, src_dev, bytes))
}

pub fn cuda_launch_3param_1d(
    s: &CudaDriverSession,
    hfn: i64,
    grid_x: i64,
    block_x: i64,
    arg0: i64,
    arg1: i64,
    arg2: i64
) -> i64 with Alloc {
    if !s.ok || hfn == 0 || grid_x <= 0 || block_x <= 0 { return -1 }
    let vals = heap_alloc(24) as i64
    let _w0 = ptr_write_i64_le(vals, 0, arg0)
    let _w1 = ptr_write_i64_le(vals, 8, arg1)
    let _w2 = ptr_write_i64_le(vals, 16, arg2)
    let ptrs = heap_alloc(24) as i64
    let _p0 = ptr_write_i64_le(ptrs, 0, vals)
    let _p1 = ptr_write_i64_le(ptrs, 8, vals + 8)
    let _p2 = ptr_write_i64_le(ptrs, 16, vals + 16)

    let cu_launch = s.fn_launch_kernel as fn(i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) -> i64
    let rc = hal_c_i32(cu_launch(hfn, grid_x, 1, 1, block_x, 1, 1, 0, 0, ptrs, 0))
    heap_free(ptrs as *mut u8)
    heap_free(vals as *mut u8)
    if rc != 0 { return rc }

    let cu_sync = s.fn_ctx_sync as fn() -> i64
    hal_c_i32(cu_sync())
}

