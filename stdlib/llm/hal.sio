    if !s.ok || s.fn_dev_get_name == 0 || out_buf == 0 || out_cap <= 1 { return -1 }
    let _z = ptr_write_u8(out_buf, 0, 0)
    let f = s.fn_dev_get_name as fn(i64, i32, i32) -> i64
    hal_c_i32(f(out_buf, out_cap as i32, s.dev as i32))
}

