    hal_c_i32(cu_sync())
}

pub fn cuda_session_get_name_cstr(s: &CudaDriverSession, out_buf: i64, out_cap: i64) -> i64 {
    if !s.ok || s.fn_dev_get_name == 0 || out_buf == 0 || out_cap <= 1 { return -1 }
    let _z = ptr_write_u8(out_buf, 0, 0)
    let f = s.fn_dev_get_name as fn(i64, i32, i32) -> i64
    hal_c_i32(f(out_buf, out_cap as i32, s.dev as i32))
}

pub fn cuda_session_driver_version(s: &CudaDriverSession) -> i64 with Alloc {
    if !s.ok || s.fn_driver_get_ver == 0 { return -1 }
    let vbox = heap_alloc(8) as i64
    let _z = ptr_write_i64_le(vbox, 0, 0)
    let f = s.fn_driver_get_ver as fn(i64) -> i64
    let rc = hal_c_i32(f(vbox))
    let ver = hal_c_i32(ptr_read_u32_le(vbox, 0))
    heap_free(vbox as *mut u8)
    if rc != 0 { return -1 }
    ver
}

pub fn cuda_launch_set_param(s: &CudaDriverSession, idx: i64, val: i64) {
    if s.launch_scratch != 0 && idx >= 0 && idx < 16 {
        let _w = ptr_write_i64_le(s.launch_scratch, idx * 8, val)
    }
}

pub fn cuda_launch_scratch_async(
    s: &CudaDriverSession,
    hfn: i64,
    grid_x: i64,
    block_x: i64,
    shared_bytes: i64,
    nparams: i64
) -> i64 {
    if !s.ok || hfn == 0 || s.launch_scratch == 0 || grid_x <= 0 || block_x <= 0 || nparams <= 0 || nparams > 16 {
        return -1
    }
    let base = s.launch_scratch
    let ptrs = base + 128
    var i: i64 = 0
    while i < nparams {
        let _p = ptr_write_i64_le(ptrs, i * 8, base + i * 8)
        i = i + 1
    }
    let cu_launch = s.fn_launch_kernel as fn(i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) -> i64
    hal_c_i32(cu_launch(hfn, grid_x, 1, 1, block_x, 1, 1, shared_bytes, 0, ptrs, 0))
}

pub fn cuda_launch_4_async(
    s: &CudaDriverSession,
    hfn: i64,
    grid_x: i64,
    block_x: i64,
    a0: i64,
    a1: i64,
    a2: i64,
    a3: i64
) -> i64 {
    cuda_launch_set_param(s, 0, a0)
    cuda_launch_set_param(s, 1, a1)
    cuda_launch_set_param(s, 2, a2)
    cuda_launch_set_param(s, 3, a3)
    cuda_launch_scratch_async(s, hfn, grid_x, block_x, 0, 4)
}

