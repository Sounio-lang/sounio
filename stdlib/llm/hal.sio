pub fn hal_cpu_set_ftz_daz(enable: bool) -> bool with Alloc, Mut {
    let main_h = dlopen(0 as *mut u8, 1) as i64
    if main_h == 0 { return false }
    let fn_uname_raw = hal_dlsym_str(main_h, "uname")
    var fn_feget_raw = hal_dlsym_str(main_h, "fegetenv")
    var fn_feset_raw = hal_dlsym_str(main_h, "fesetenv")
    var libm_h: i64 = 0
    if fn_feget_raw == 0 || fn_feset_raw == 0 {
        libm_h = hal_dlopen_str("libm.so.6", 1)
        if libm_h != 0 {
            if fn_feget_raw == 0 { fn_feget_raw = hal_dlsym_str(libm_h, "fegetenv") }
            if fn_feset_raw == 0 { fn_feset_raw = hal_dlsym_str(libm_h, "fesetenv") }
        }
    }
    if fn_uname_raw == 0 || fn_feget_raw == 0 || fn_feset_raw == 0 {
        if libm_h != 0 { let _cm = dlclose(libm_h as *mut u8) }
        let _c = dlclose(main_h as *mut u8)
        return false
    }

    let uts = heap_alloc(2048) as i64
    let fenv = heap_alloc(64) as i64
    if uts == 0 || fenv == 0 {
        if uts != 0 { heap_free(uts as *mut u8) }
        if fenv != 0 { heap_free(fenv as *mut u8) }
        if libm_h != 0 { let _cm = dlclose(libm_h as *mut u8) }
        let _c = dlclose(main_h as *mut u8)
        return false
    }
    var zi: i64 = 0
    while zi < 256 {
        let _zu = ptr_write_i64_le(uts, zi * 8, 0)
        zi = zi + 1
    }
    zi = 0
    while zi < 8 {
        let _zf = ptr_write_i64_le(fenv, zi * 8, 0)
        zi = zi + 1
    }

    let uname_fn = fn_uname_raw as fn(i64) -> i32
    var ok = false
    if uname_fn(uts) == 0 {
        // Darwin sysname="Darwin", machine@1024; Linux sysname="Linux", machine@260.
        let s0 = ptr_read_u8(uts, 0)
        let s1 = ptr_read_u8(uts, 1)
        let s2 = ptr_read_u8(uts, 2)
        let s3 = ptr_read_u8(uts, 3)
        let s4 = ptr_read_u8(uts, 4)
        let s5 = ptr_read_u8(uts, 5)
        let s6 = ptr_read_u8(uts, 6)
        let is_darwin = s0 == 68 && s1 == 97 && s2 == 114 && s3 == 119 && s4 == 105 && s5 == 110 && s6 == 0
        let is_linux = s0 == 76 && s1 == 105 && s2 == 110 && s3 == 117 && s4 == 120 && s5 == 0
        var env_off: i64 = -1
        var env_mask: i64 = 0
        if is_darwin {
            let m0 = ptr_read_u8(uts, 1024)
            if m0 == 97 {
                // macOS arm64: __fpsr@0, __fpcr@8; bit 24 = FZ (FTZ+DAZ)
                env_off = 8
                env_mask = 16777216
            } else if m0 == 120 {
                // macOS x86_64: __control@0, __status@2, __mxcsr@4; FTZ=0x8000 | DAZ=0x0040
                env_off = 4
                env_mask = 32832
            }
        } else if is_linux {
            let m0 = ptr_read_u8(uts, 260)
            if m0 == 97 {
                // Linux aarch64: __fpcr@0, __fpsr@4; bit 24 = FZ
                env_off = 0
                env_mask = 16777216
            } else if m0 == 120 {
                // Linux x86_64: mxcsr@28; FTZ=0x8000 | DAZ=0x0040
                env_off = 28
                env_mask = 32832
            }
        }
        if env_off >= 0 {
            let feget = fn_feget_raw as fn(i64) -> i32
            let feset = fn_feset_raw as fn(i64) -> i32
            if feget(fenv) == 0 {
                let cur = ptr_read_u32_le(fenv, env_off) as i64
                let want = if enable { cur | env_mask } else { cur & (4294967295 ^ env_mask) }
                let _w = ptr_write_u32_le(fenv, env_off, want as u32)
                if feset(fenv) == 0 {
                    zi = 0
                    while zi < 8 {
                        let _zf2 = ptr_write_i64_le(fenv, zi * 8, 0)
                        zi = zi + 1
                    }
                    if feget(fenv) == 0 {
                        let after = ptr_read_u32_le(fenv, env_off) as i64
                        if enable {
                            ok = (after & env_mask) == env_mask
                        } else {
                            ok = (after & env_mask) == 0
                        }
                    }
                }
            }
        }
    }

    heap_free(uts as *mut u8)
    heap_free(fenv as *mut u8)
    if libm_h != 0 { let _cm = dlclose(libm_h as *mut u8) }
    let _c = dlclose(main_h as *mut u8)
    ok
}

fn hal_hex_nibble(v: i64) -> i64 {
    let n = v & 15
    if n < 10 { 48 + n } else { 87 + n }
}

pub fn hal_self_binary_sha256_hex(out_hex_65: i64) -> bool with Alloc, Mut, Panic, Div {
    if out_hex_65 == 0 { return false }
    let _z = ptr_write_u8(out_hex_65, 0, 0)
    let main_h = dlopen(0 as *mut u8, 1) as i64
    if main_h == 0 { return false }

    let fn_ns_raw = hal_dlsym_str(main_h, "_NSGetExecutablePath")
    let fn_rl_raw = hal_dlsym_str(main_h, "readlink")
    let fn_fopen_raw = hal_dlsym_str(main_h, "fopen")
    let fn_fread_raw = hal_dlsym_str(main_h, "fread")
    let fn_fclose_raw = hal_dlsym_str(main_h, "fclose")
    if fn_fopen_raw == 0 || fn_fread_raw == 0 || fn_fclose_raw == 0 {
        let _c = dlclose(main_h as *mut u8)
        return false
    }

    let exe_buf = heap_alloc(4096) as i64
    let sz_buf = heap_alloc(16) as i64
    let blk_buf = heap_alloc(64) as i64
    if exe_buf == 0 || sz_buf == 0 || blk_buf == 0 {
        if exe_buf != 0 { heap_free(exe_buf as *mut u8) }
        if sz_buf != 0 { heap_free(sz_buf as *mut u8) }
        if blk_buf != 0 { heap_free(blk_buf as *mut u8) }
        let _c = dlclose(main_h as *mut u8)
        return false
    }
    let _ze = ptr_write_u8(exe_buf, 0, 0)

    var path_ok = false
    if fn_ns_raw != 0 {
        let _wsz = ptr_write_u32_le(sz_buf, 0, 4096)
        let ns_fn = fn_ns_raw as fn(i64, i64) -> i32
        if ns_fn(exe_buf, sz_buf) == 0 {
            path_ok = true
        }
    } else if fn_rl_raw != 0 {
        let c_proc = hal_cstr("/proc/self/exe")
        let rl_fn = fn_rl_raw as fn(i64, i64, i64) -> i64
        let rlen = rl_fn(c_proc, exe_buf, 4095)
        hal_free_cstr(c_proc)
        if rlen > 0 && rlen < 4096 {
            let _zn = ptr_write_u8(exe_buf, rlen, 0)
            path_ok = true
        }
    }

    var ok = false
    if path_ok {
        let c_mode = hal_cstr("rb")
        let fopen_fn = fn_fopen_raw as fn(i64, i64) -> i64
        let fread_fn = fn_fread_raw as fn(i64, i64, i64, i64) -> i64
        let fclose_fn = fn_fclose_raw as fn(i64) -> i32
        let fp = fopen_fn(exe_buf, c_mode)
        hal_free_cstr(c_mode)
        if fp != 0 {
            var h: [i64; 8] = [
                0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
                0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19
            ]
            var block: [u8; 64] = [0; 64]
            var total_bytes: i64 = 0
            var done = false
            while !done {
                var got: i64 = 0
                while got < 64 {
                    let n = fread_fn(blk_buf + got, 1, 64 - got, fp)
                    if n <= 0 { break }
                    got = got + n
                }
                total_bytes = total_bytes + got
                if got == 64 {
                    var bi: i64 = 0
                    while bi < 64 {
                        block[bi] = ptr_read_u8(blk_buf, bi) as u8
                        bi = bi + 1
                    }
                    h = sha256_compress(h, block)
                } else {
                    var bi: i64 = 0
                    while bi < got {
                        block[bi] = ptr_read_u8(blk_buf, bi) as u8
                        bi = bi + 1
                    }
                    block[got] = 0x80 as u8
                    bi = got + 1
                    while bi < 64 {
                        block[bi] = 0 as u8
                        bi = bi + 1
                    }
                    if got >= 56 {
                        h = sha256_compress(h, block)
                        bi = 0
                        while bi < 64 {
                            block[bi] = 0 as u8
                            bi = bi + 1
                        }
                    }
                    let bit_len = total_bytes * 8
                    block[56] = ((bit_len >> 56) & 255) as u8
                    block[57] = ((bit_len >> 48) & 255) as u8
                    block[58] = ((bit_len >> 40) & 255) as u8
                    block[59] = ((bit_len >> 32) & 255) as u8
                    block[60] = ((bit_len >> 24) & 255) as u8
                    block[61] = ((bit_len >> 16) & 255) as u8
                    block[62] = ((bit_len >>  8) & 255) as u8
                    block[63] = (bit_len & 255) as u8
                    h = sha256_compress(h, block)
                    done = true
                }
            }
            let _cf = fclose_fn(fp)
            var wi: i64 = 0
            while wi < 8 {
                let w = h[wi] & 0xFFFFFFFF
                var ni: i64 = 0
                while ni < 8 {
                    let sh = (7 - ni) * 4
                    let _wh = ptr_write_u8(out_hex_65, wi * 8 + ni, hal_hex_nibble(w >> sh))
                    ni = ni + 1
                }
                wi = wi + 1
            }
            let _zt = ptr_write_u8(out_hex_65, 64, 0)
            ok = true
        }
    }

    heap_free(exe_buf as *mut u8)
    heap_free(sz_buf as *mut u8)
    heap_free(blk_buf as *mut u8)
    let _c = dlclose(main_h as *mut u8)
    ok
}
