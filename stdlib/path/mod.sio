//! stdlib/path/mod.sio - Path Manipulation
//!
//! Provides cross-platform path manipulation utilities.
//!
//! # Examples
//!
//! ```sio
//! let p = path_from("/home/user/file.txt")
//!
//! let parent = path_parent(&p)           // "/home/user"
//! let name = path_file_name(&p)          // "file.txt"
//! let stem = path_file_stem(&p)          // "file"
//! let ext = path_extension(&p)           // "txt"
//!
//! let joined = path_join(&p, "subdir")   // "/home/user/file.txt/subdir"
//! let abs = path_absolute(&p)?           // Resolved absolute path
//!
//! let is_abs = path_is_absolute(&p)      // true
//! let exists = path_exists(&p)?          // Check filesystem
//! ```

// ============================================================================
// System FFI
// ============================================================================

extern "C" {
    fn getcwd(buf: *mut u8, size: usize) -> *mut u8
    fn realpath(path: *const u8, resolved_path: *mut u8) -> *mut u8
    fn stat(path: *const u8, buf: *mut StatBuf) -> i32
    fn access(path: *const u8, mode: i32) -> i32
}

// stat struct (simplified)
struct StatBuf {
    st_dev: u64,
    st_ino: u64,
    st_mode: u32,
    st_nlink: u64,
    st_uid: u32,
    st_gid: u32,
    st_rdev: u64,
    st_size: i64,
    st_blksize: i64,
    st_blocks: i64,
    st_atime: i64,
    st_atime_nsec: i64,
    st_mtime: i64,
    st_mtime_nsec: i64,
    st_ctime: i64,
    st_ctime_nsec: i64,
}

// access modes
const F_OK: i32 = 0  // existence
const R_OK: i32 = 4  // readable
const W_OK: i32 = 2  // writable
const X_OK: i32 = 1  // executable

// stat mode masks
const S_IFMT: u32 = 0o170000   // file type mask
const S_IFDIR: u32 = 0o040000  // directory
const S_IFREG: u32 = 0o100000  // regular file
const S_IFLNK: u32 = 0o120000  // symbolic link

// ============================================================================
// Path Type
// ============================================================================

// A filesystem path.
//
// Paths are stored as strings but provide specialized operations
// for path manipulation.
pub struct Path {
    inner: String,
}

// Path separator for the current platform.
#[cfg(unix)]
const PATH_SEPARATOR: char = '/'
#[cfg(windows)]
const PATH_SEPARATOR: char = '\\'

// Path list separator (e.g., for PATH environment variable).
#[cfg(unix)]
const PATH_LIST_SEPARATOR: char = ':'
#[cfg(windows)]
const PATH_LIST_SEPARATOR: char = ';'

// Path errors
pub enum PathError {
    /// Path not found
    NotFound,
    /// Permission denied
    PermissionDenied,
    /// Invalid path
    Invalid,
    /// I/O error
    IoError { code: i32 },
}

// ============================================================================
// Constructors
// ============================================================================

// Create a Path from a string.
pub fn path_from(s: &str) -> Path with Alloc {
    Path { inner: string_from(s) }
}

// Create a Path from a String (takes ownership).
pub fn path_from_string(s: String) -> Path {
    Path { inner: s }
}

// Create an empty path.
pub fn path_new() -> Path with Alloc {
    Path { inner: string_new() }
}

// Get the path as a string slice.
pub fn path_as_str(p: &Path) -> &str {
    &p.inner
}

// Convert path to owned String.
pub fn path_to_string(p: &Path) -> String with Alloc {
    string_from(&p.inner)
}

// ============================================================================
// Path Components
// ============================================================================

// Get the parent directory, if any.
//
// Returns None for root paths or paths without a parent.
pub fn path_parent(p: &Path) -> Option<Path> with Alloc {
    let s = &p.inner
    let len = s.len()

    if len == 0 {
        return None
    }

    // Find last separator
    var last_sep: i64 = -1
    var i = 0
    while i < len {
        if s.char_at(i) == PATH_SEPARATOR {
            last_sep = i as i64
        }
        i = i + 1
    }

    if last_sep < 0 {
        // No separator - no parent
        None
    } else if last_sep == 0 {
        // Root directory
        if len == 1 {
            None  // Root has no parent
        } else {
            Some(path_from("/"))
        }
    } else {
        Some(path_from(&s[..last_sep as usize]))
    }
}

// Get the final component of the path (file or directory name).
pub fn path_file_name(p: &Path) -> Option<&str> {
    let s = &p.inner
    let len = s.len()

    if len == 0 {
        return None
    }

    // Skip trailing separators
    var end = len
    while end > 0 && s.char_at(end - 1) == PATH_SEPARATOR {
        end = end - 1
    }

    if end == 0 {
        return None  // Root or empty
    }

    // Find last separator before end
    var start = end
    while start > 0 && s.char_at(start - 1) != PATH_SEPARATOR {
        start = start - 1
    }

    Some(&s[start..end])
}

// Get the file stem (name without extension).
pub fn path_file_stem(p: &Path) -> Option<String> with Alloc {
    let name = path_file_name(p)?

    // Find last dot
    var last_dot: i64 = -1
    var i = 0
    while i < name.len() {
        if name.char_at(i) == '.' {
            last_dot = i as i64
        }
        i = i + 1
    }

    if last_dot <= 0 {
        // No extension or hidden file (starts with .)
        Some(string_from(name))
    } else {
        Some(string_from(&name[..last_dot as usize]))
    }
}

// Get the file extension (without the leading dot).
pub fn path_extension(p: &Path) -> Option<String> with Alloc {
    let name = path_file_name(p)?

    // Find last dot
    var last_dot: i64 = -1
    var i = 0
    while i < name.len() {
        if name.char_at(i) == '.' {
            last_dot = i as i64
        }
        i = i + 1
    }

    if last_dot <= 0 || last_dot as usize == name.len() - 1 {
        None  // No extension
    } else {
        Some(string_from(&name[(last_dot + 1) as usize..]))
    }
}

// Check if the path is absolute.
pub fn path_is_absolute(p: &Path) -> bool {
    let s = &p.inner
    s.len() > 0 && s.char_at(0) == PATH_SEPARATOR
}

// Check if the path is relative.
pub fn path_is_relative(p: &Path) -> bool {
    !path_is_absolute(p)
}

// Check if the path ends with a separator.
pub fn path_has_trailing_separator(p: &Path) -> bool {
    let s = &p.inner
    s.len() > 0 && s.char_at(s.len() - 1) == PATH_SEPARATOR
}

// ============================================================================
// Path Operations
// ============================================================================

// Join two paths.
pub fn path_join(base: &Path, other: &str) -> Path with Alloc {
    let base_str = &base.inner

    // If other is absolute, return it directly
    if other.len() > 0 && other.char_at(0) == PATH_SEPARATOR {
        return path_from(other)
    }

    if base_str.len() == 0 {
        return path_from(other)
    }

    var result = string_from(base_str)

    // Add separator if needed
    if !path_has_trailing_separator(base) {
        string_push(&!result, PATH_SEPARATOR)
    }

    string_push_str(&!result, other)

    Path { inner: result }
}

// Join multiple path components.
pub fn path_join_all(components: &[&str]) -> Path with Alloc {
    if components.len() == 0 {
        return path_new()
    }

    var result = path_from(components[0])
    var i = 1
    while i < components.len() {
        result = path_join(&result, components[i])
        i = i + 1
    }

    result
}

// Normalize a path by removing . and .. components.
pub fn path_normalize(p: &Path) -> Path with Alloc {
    let s = &p.inner
    let is_abs = path_is_absolute(p)

    // Split into components
    var components = vec_new::<String>()
    var start = 0
    var i = 0

    while i <= s.len() {
        if i == s.len() || s.char_at(i) == PATH_SEPARATOR {
            if i > start {
                let component = &s[start..i]

                if component == "." {
                    // Skip current directory
                } else if component == ".." {
                    // Go up one directory
                    if vec_len(&components) > 0 && components[vec_len(&components) - 1] != ".." {
                        vec_pop(&!components)
                    } else if !is_abs {
                        vec_push(&!components, string_from(".."))
                    }
                } else {
                    vec_push(&!components, string_from(component))
                }
            }
            start = i + 1
        }
        i = i + 1
    }

    // Reconstruct path
    var result = string_new()

    if is_abs {
        string_push(&!result, PATH_SEPARATOR)
    }

    i = 0
    while i < vec_len(&components) {
        if i > 0 {
            string_push(&!result, PATH_SEPARATOR)
        }
        string_push_str(&!result, &components[i])
        i = i + 1
    }

    if result.len() == 0 {
        return path_from(".")
    }

    Path { inner: result }
}

// Get the canonical absolute path (resolving symlinks).
pub fn path_absolute(p: &Path) -> Result<Path, PathError> with IO, Alloc {
    let cstr = string_to_cstr(&p.inner)
    var resolved = [0u8; 4096]

    let result = realpath(cstr.as_ptr(), &!resolved[0])

    if result.is_null() {
        return Err(PathError::NotFound)
    }

    // Convert to string
    var s = string_new()
    var i = 0
    while i < 4096 && resolved[i] != 0 {
        string_push(&!s, resolved[i] as char)
        i = i + 1
    }

    Ok(Path { inner: s })
}

// Get the current working directory.
pub fn path_current_dir() -> Result<Path, PathError> with IO, Alloc {
    var buf = [0u8; 4096]
    let result = getcwd(&!buf[0], 4096)

    if result.is_null() {
        return Err(PathError::IoError { code: 0 })
    }

    var s = string_new()
    var i = 0
    while i < 4096 && buf[i] != 0 {
        string_push(&!s, buf[i] as char)
        i = i + 1
    }

    Ok(Path { inner: s })
}

// Set a new extension (replaces existing).
pub fn path_with_extension(p: &Path, ext: &str) -> Path with Alloc {
    let stem = path_file_stem(p)
    let parent = path_parent(p)

    var new_name = match stem {
        Some(s) => s,
        None => string_from(""),
    }

    if ext.len() > 0 {
        string_push(&!new_name, '.')
        string_push_str(&!new_name, ext)
    }

    match parent {
        Some(p) => path_join(&p, &new_name),
        None => Path { inner: new_name },
    }
}

// Replace the file name.
pub fn path_with_file_name(p: &Path, name: &str) -> Path with Alloc {
    match path_parent(p) {
        Some(parent) => path_join(&parent, name),
        None => path_from(name),
    }
}

// Make a path relative to a base path.
pub fn path_relative_to(p: &Path, base: &Path) -> Option<Path> with Alloc {
    // Normalize both paths
    let norm_p = path_normalize(p)
    let norm_base = path_normalize(base)

    let p_str = &norm_p.inner
    let base_str = &norm_base.inner

    // Check if p starts with base
    if !p_str.starts_with(base_str) {
        return None
    }

    let rest_start = base_str.len()
    if rest_start >= p_str.len() {
        return Some(path_from("."))
    }

    // Skip separator
    var start = rest_start
    if p_str.char_at(start) == PATH_SEPARATOR {
        start = start + 1
    }

    Some(path_from(&p_str[start..]))
}

// ============================================================================
// Filesystem Queries
// ============================================================================

// Check if the path exists.
pub fn path_exists(p: &Path) -> Result<bool, PathError> with IO, Alloc {
    let cstr = string_to_cstr(&p.inner)
    let result = access(cstr.as_ptr(), F_OK)
    Ok(result == 0)
}

// Check if the path is a file.
pub fn path_is_file(p: &Path) -> Result<bool, PathError> with IO, Alloc {
    let cstr = string_to_cstr(&p.inner)
    var st = StatBuf {
        st_dev: 0, st_ino: 0, st_mode: 0, st_nlink: 0,
        st_uid: 0, st_gid: 0, st_rdev: 0, st_size: 0,
        st_blksize: 0, st_blocks: 0,
        st_atime: 0, st_atime_nsec: 0,
        st_mtime: 0, st_mtime_nsec: 0,
        st_ctime: 0, st_ctime_nsec: 0,
    }

    let result = stat(cstr.as_ptr(), &!st)
    if result != 0 {
        return Err(PathError::NotFound)
    }

    Ok((st.st_mode & S_IFMT) == S_IFREG)
}

// Check if the path is a directory.
pub fn path_is_dir(p: &Path) -> Result<bool, PathError> with IO, Alloc {
    let cstr = string_to_cstr(&p.inner)
    var st = StatBuf {
        st_dev: 0, st_ino: 0, st_mode: 0, st_nlink: 0,
        st_uid: 0, st_gid: 0, st_rdev: 0, st_size: 0,
        st_blksize: 0, st_blocks: 0,
        st_atime: 0, st_atime_nsec: 0,
        st_mtime: 0, st_mtime_nsec: 0,
        st_ctime: 0, st_ctime_nsec: 0,
    }

    let result = stat(cstr.as_ptr(), &!st)
    if result != 0 {
        return Err(PathError::NotFound)
    }

    Ok((st.st_mode & S_IFMT) == S_IFDIR)
}

// Check if the path is a symbolic link.
pub fn path_is_symlink(p: &Path) -> Result<bool, PathError> with IO, Alloc {
    let cstr = string_to_cstr(&p.inner)
    var st = StatBuf {
        st_dev: 0, st_ino: 0, st_mode: 0, st_nlink: 0,
        st_uid: 0, st_gid: 0, st_rdev: 0, st_size: 0,
        st_blksize: 0, st_blocks: 0,
        st_atime: 0, st_atime_nsec: 0,
        st_mtime: 0, st_mtime_nsec: 0,
        st_ctime: 0, st_ctime_nsec: 0,
    }

    // Note: should use lstat for symlinks, but we'll use stat for simplicity
    let result = stat(cstr.as_ptr(), &!st)
    if result != 0 {
        return Err(PathError::NotFound)
    }

    Ok((st.st_mode & S_IFMT) == S_IFLNK)
}

// Check if the path is readable.
pub fn path_is_readable(p: &Path) -> bool with IO, Alloc {
    let cstr = string_to_cstr(&p.inner)
    access(cstr.as_ptr(), R_OK) == 0
}

// Check if the path is writable.
pub fn path_is_writable(p: &Path) -> bool with IO, Alloc {
    let cstr = string_to_cstr(&p.inner)
    access(cstr.as_ptr(), W_OK) == 0
}

// Check if the path is executable.
pub fn path_is_executable(p: &Path) -> bool with IO, Alloc {
    let cstr = string_to_cstr(&p.inner)
    access(cstr.as_ptr(), X_OK) == 0
}

// ============================================================================
// Path Iteration
// ============================================================================

// An iterator over path components.
pub struct PathComponents {
    path: String,
    pos: usize,
}

// Get an iterator over path components.
pub fn path_components(p: &Path) -> PathComponents with Alloc {
    PathComponents {
        path: string_from(&p.inner),
        pos: 0,
    }
}

// Get the next component.
pub fn path_components_next(it: &!PathComponents) -> Option<String> with Alloc {
    let s = &it.path

    // Skip leading separators
    while it.pos < s.len() && s.char_at(it.pos) == PATH_SEPARATOR {
        it.pos = it.pos + 1
    }

    if it.pos >= s.len() {
        return None
    }

    // Find end of component
    let start = it.pos
    while it.pos < s.len() && s.char_at(it.pos) != PATH_SEPARATOR {
        it.pos = it.pos + 1
    }

    Some(string_from(&s[start..it.pos]))
}

// Collect all components into a vector.
pub fn path_components_collect(p: &Path) -> Vec<String> with Alloc {
    var result = vec_new::<String>()
    var it = path_components(p)

    loop {
        match path_components_next(&!it) {
            Some(c) => vec_push(&!result, c),
            None => break,
        }
    }

    result
}

// ============================================================================
// Utilities
// ============================================================================

// Compare two paths for equality (case-sensitive on Unix).
pub fn path_eq(a: &Path, b: &Path) -> bool {
    // Normalize both before comparing
    a.inner == b.inner
}

// Check if a path starts with a prefix.
pub fn path_starts_with(p: &Path, prefix: &Path) -> bool {
    p.inner.starts_with(&prefix.inner)
}

// Check if a path ends with a suffix.
pub fn path_ends_with(p: &Path, suffix: &str) -> bool {
    p.inner.ends_with(suffix)
}

// Get the depth of the path (number of components).
pub fn path_depth(p: &Path) -> usize with Alloc {
    vec_len(&path_components_collect(p))
}

// Clone a path.
pub fn path_clone(p: &Path) -> Path with Alloc {
    Path { inner: string_from(&p.inner) }
}

// Helper
fn string_to_cstr(s: &str) -> Vec<u8> with Alloc {
    var v = vec_new::<u8>()
    for c in s.bytes() {
        vec_push(&!v, c)
    }
    vec_push(&!v, 0)
    v
}
