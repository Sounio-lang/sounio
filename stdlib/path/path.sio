// path/mod.sio — Path Utilities
//
// Byte-level path manipulation without heap allocation.
// Works on raw byte arrays for cross-platform compatibility.

// ============================================================================
// PATH EXTENSION
// ============================================================================
// Returns the offset of the last '.' in path, or -1 if none found.
// Example: "file.sio" -> 4, "noext" -> -1

pub fn path_extension(path: &[u8; 256], len: i32) -> i32 {
    var i = len - 1
    while i >= 0 {
        if path[i as usize] == 46 {  // '.'
            return i
        }
        // Stop at directory separator
        if path[i as usize] == 47 {  // '/'
            return 0 - 1
        }
        i = i - 1
    }
    0 - 1
}

// ============================================================================
// PATH BASENAME
// ============================================================================
// Returns the offset after the last '/' in path, or 0 if no '/' found.
// Example: "/foo/bar.sio" -> 5, "bar.sio" -> 0

pub fn path_basename(path: &[u8; 256], len: i32) -> i32 {
    var i = len - 1
    while i >= 0 {
        if path[i as usize] == 47 {  // '/'
            return i + 1
        }
        i = i - 1
    }
    0
}

// ============================================================================
// PATH JOIN
// ============================================================================
// Joins two path components with '/' separator.
// Returns the total length written to out.

pub fn path_join(a: &[u8; 128], a_len: i32, b: &[u8; 128], b_len: i32, out: &![u8; 256]) -> i32 with Mut, Panic, Div {
    var pos: i32 = 0

    // Copy a
    var i: i32 = 0
    while i < a_len {
        if pos >= 255 { return pos }
        out[pos as usize] = a[i as usize]
        pos = pos + 1
        i = i + 1
    }

    // Add separator if needed
    if a_len > 0 && b_len > 0 {
        if pos >= 255 { return pos }
        out[pos as usize] = 47  // '/'
        pos = pos + 1
    }

    // Copy b
    i = 0
    while i < b_len {
        if pos >= 255 { return pos }
        out[pos as usize] = b[i as usize]
        pos = pos + 1
        i = i + 1
    }

    pos
}

// ============================================================================
// INLINE TESTS
// ============================================================================

//@ run-pass
fn test_path_extension() -> i32 {
    var path: [u8; 256] = [0; 256]
    // "file.sio" = [102, 105, 108, 101, 46, 115, 105, 111]
    path[0] = 102  // f
    path[1] = 105  // i
    path[2] = 108  // l
    path[3] = 101  // e
    path[4] = 46   // .
    path[5] = 115  // s
    path[6] = 105  // i
    path[7] = 111  // o
    let ext = path_extension(&path, 8)
    if ext != 4 { return 1 }
    0
}

//@ run-pass
fn test_path_extension_none() -> i32 {
    var path: [u8; 256] = [0; 256]
    // "noext" = [110, 111, 101, 120, 116]
    path[0] = 110
    path[1] = 111
    path[2] = 101
    path[3] = 120
    path[4] = 116
    let ext = path_extension(&path, 5)
    if ext != 0 - 1 { return 1 }
    0
}

//@ run-pass
fn test_path_basename() -> i32 {
    var path: [u8; 256] = [0; 256]
    // "/foo/bar" = [47, 102, 111, 111, 47, 98, 97, 114]
    path[0] = 47   // /
    path[1] = 102  // f
    path[2] = 111  // o
    path[3] = 111  // o
    path[4] = 47   // /
    path[5] = 98   // b
    path[6] = 97   // a
    path[7] = 114  // r
    let base = path_basename(&path, 8)
    if base != 5 { return 1 }
    0
}

//@ run-pass
fn test_path_basename_no_slash() -> i32 {
    var path: [u8; 256] = [0; 256]
    path[0] = 102  // f
    let base = path_basename(&path, 1)
    if base != 0 { return 1 }
    0
}
