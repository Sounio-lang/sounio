// stdlib/path/lib.sio — Byte-based path manipulation
//
// Path: fixed 256-byte buffer + length.
// All operations are pure (by-value return) except path_from_bytes.
//
// ASCII byte constants used inline:
//   47 = '/'   46 = '.'

pub struct Path {
    data: [u8; 256],
    len: i32,
}

pub fn path_new() -> Path {
    Path { data: [0; 256], len: 0 }
}

pub fn path_from_bytes(data: &[u8; 256], len: i32) -> Path {
    var p = path_new()
    var cap = len
    if cap > 256 { cap = 256 }
    var i: i32 = 0
    while i < cap {
        p.data[i] = data[i]
        i = i + 1
    }
    p.len = cap
    p
}

// Copy n bytes from src offset to dst Path starting at dst.len
fn path_append_bytes(dst: Path, src: &Path, start: i32, n: i32) -> Path {
    var out = dst
    var i: i32 = 0
    while i < n && out.len < 256 {
        out.data[out.len] = src.data[start + i]
        out.len = out.len + 1
        i = i + 1
    }
    out
}

pub fn path_join(a: &Path, b: &Path) -> Path {
    var out = path_new()
    // Copy a
    var i: i32 = 0
    while i < a.len && out.len < 256 {
        out.data[out.len] = a.data[i]
        out.len = out.len + 1
        i = i + 1
    }
    // Add separator if a is non-empty and doesn't end with '/'
    // and b is non-empty and doesn't start with '/'
    if a.len > 0 && b.len > 0 {
        let last = a.data[a.len - 1]
        let first = b.data[0]
        if last != 47 && first != 47 && out.len < 256 {
            out.data[out.len] = 47
            out.len = out.len + 1
        }
    }
    // Copy b
    var j: i32 = 0
    while j < b.len && out.len < 256 {
        out.data[out.len] = b.data[j]
        out.len = out.len + 1
        j = j + 1
    }
    out
}

// Find last occurrence of byte b in path data[0..len), return index or -1
fn path_last_index(p: &Path, b: u8) -> i32 {
    var idx: i32 = -1
    var i: i32 = 0
    while i < p.len {
        if p.data[i] == b {
            idx = i
        }
        i = i + 1
    }
    idx
}

pub fn path_extension(p: &Path) -> Path {
    // Extension is bytes after the last '.' in the filename (after last '/')
    let slash_pos = path_last_index(p, 47)
    let dot_pos   = path_last_index(p, 46)
    // Dot must come after the last slash (or there's no slash)
    if dot_pos < 0 { return path_new() }
    if slash_pos >= 0 && dot_pos <= slash_pos { return path_new() }
    // Extension starts at dot_pos + 1
    let start = dot_pos + 1
    let n = p.len - start
    if n <= 0 { return path_new() }
    var out = path_new()
    var i: i32 = 0
    while i < n && out.len < 256 {
        out.data[out.len] = p.data[start + i]
        out.len = out.len + 1
        i = i + 1
    }
    out
}

pub fn path_stem(p: &Path) -> Path {
    // Filename without extension: part after last '/' up to (but not including) last '.'
    let slash_pos = path_last_index(p, 47)
    let dot_pos   = path_last_index(p, 46)
    let fname_start = slash_pos + 1  // works even when slash_pos == -1 (gives 0)
    // End is at dot_pos if dot is inside the filename portion, else at len
    var end: i32 = p.len
    if dot_pos > slash_pos && dot_pos >= 0 {
        end = dot_pos
    }
    let n = end - fname_start
    if n <= 0 { return path_new() }
    var out = path_new()
    var i: i32 = 0
    while i < n && out.len < 256 {
        out.data[out.len] = p.data[fname_start + i]
        out.len = out.len + 1
        i = i + 1
    }
    out
}

pub fn path_parent(p: &Path) -> Path {
    let slash_pos = path_last_index(p, 47)
    if slash_pos < 0 { return path_new() }
    // Special case: root "/"
    var end = slash_pos
    if end == 0 { end = 1 }
    var out = path_new()
    var i: i32 = 0
    while i < end && out.len < 256 {
        out.data[out.len] = p.data[i]
        out.len = out.len + 1
        i = i + 1
    }
    out
}

pub fn path_filename(p: &Path) -> Path {
    let slash_pos = path_last_index(p, 47)
    let start = slash_pos + 1
    let n = p.len - start
    if n <= 0 { return path_new() }
    var out = path_new()
    var i: i32 = 0
    while i < n && out.len < 256 {
        out.data[out.len] = p.data[start + i]
        out.len = out.len + 1
        i = i + 1
    }
    out
}

pub fn path_is_absolute(p: &Path) -> bool {
    if p.len <= 0 { return false }
    p.data[0] == 47
}

pub fn path_eq(a: &Path, b: &Path) -> bool {
    if a.len != b.len { return false }
    var i: i32 = 0
    while i < a.len {
        if a.data[i] != b.data[i] { return false }
        i = i + 1
    }
    true
}
