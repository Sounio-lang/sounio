// stdlib/data/ops.sio
// DataFrame-like operations on fixed arrays
//
// Provides groupby, aggregation, cumulative, and rolling operations
// on fixed-size f64 arrays.

extern "C" {
    fn sqrt(x: f64) -> f64
}

fn ops_sqrt_f64(x: f64) -> f64 {
    if x < 0.0 { return 0.0 }
    return sqrt(x)
}

fn ops_abs_f64(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn ops_min_f64(a: f64, b: f64) -> f64 {
    if a < b { a } else { b }
}

fn ops_max_f64(a: f64, b: f64) -> f64 {
    if a > b { a } else { b }
}

// Sum elements of a float array up to length n
fn ops_sum(data: [f64; 256], n: i64) -> f64 {
    var sum = 0.0
    var i: i64 = 0
    while i < n {
        sum = sum + data[i]
        i = i + 1
    }
    return sum
}

// Mean of elements
fn ops_mean(data: [f64; 256], n: i64) -> f64 {
    if n == 0 { return 0.0 }
    return ops_sum(data, n) / (n as f64)
}

// Cumulative sum: result[i] = sum(data[0..=i])
fn ops_cumsum(data: [f64; 256], n: i64, result: &![f64; 256]) {
    var running = 0.0
    var i: i64 = 0
    while i < n {
        running = running + data[i]
        result[i] = running
        i = i + 1
    }
}

// Cumulative max
fn ops_cummax(data: [f64; 256], n: i64, result: &![f64; 256]) {
    if n == 0 { return }
    var running = data[0]
    result[0] = running
    var i: i64 = 1
    while i < n {
        if data[i] > running {
            running = data[i]
        }
        result[i] = running
        i = i + 1
    }
}

// Rolling mean with window size
fn ops_rolling_mean(data: [f64; 256], n: i64, window: i64, result: &![f64; 256]) {
    if window == 0 { return }
    var i: i64 = 0
    while i < n {
        let start = if i + 1 >= window { i + 1 - window } else { 0 }
        var sum = 0.0
        var j = start
        while j <= i {
            sum = sum + data[j]
            j = j + 1
        }
        let count = i - start + 1
        result[i] = sum / (count as f64)
        i = i + 1
    }
}

// GUM uncertainty for mean: u(mean)^2 = (1/n^2) * sum(u_i^2)
fn ops_gum_mean_uncertainty(uncerts: [f64; 256], n: i64) -> f64 {
    if n == 0 { return 0.0 }
    var sum_u_sq = 0.0
    var i: i64 = 0
    while i < n {
        sum_u_sq = sum_u_sq + uncerts[i] * uncerts[i]
        i = i + 1
    }
    return ops_sqrt_f64(sum_u_sq) / (n as f64)
}
