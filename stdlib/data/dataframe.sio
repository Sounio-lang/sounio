// stdlib/data/dataframe.sio
// Dense DataFrame — flat fixed-array tabular storage
//
// Row-major layout: data[row * MAX_COLS + col]
// Max 64 columns, 1024 rows = 65536 f64 slots.
//
// Design: all ops are free functions over the DataFrame struct.
// Mutation uses the struct-wrapper pattern to work around
// the JIT &![T; N] visibility bug (see KNOWN_LIMITATIONS.md).

extern "C" {
    fn sqrt(x: f64) -> f64
}

fn df_sqrt(x: f64) -> f64 {
    if x <= 0.0 { return 0.0 }
    return sqrt(x)
}

fn df_abs(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

// ============================================================================
// CONSTANTS
// ============================================================================

fn df_max_cols() -> i64 { 64 }
fn df_max_rows() -> i64 { 1024 }
fn df_max_cells() -> i64 { 65536 }

// ============================================================================
// DATAFRAME STRUCT
// ============================================================================

pub struct DataFrame {
    data: [f64; 65536],
    col_names: [i64; 64],
    n_rows: i64,
    n_cols: i64,
}

// ============================================================================
// CONSTRUCTION
// ============================================================================

// Create an empty DataFrame with the given number of columns.
pub fn df_new(n_cols: i64) -> DataFrame {
    var nc = n_cols
    if nc < 0 { nc = 0 }
    if nc > 64 { nc = 64 }
    DataFrame {
        data: [0.0; 65536],
        col_names: [0; 64],
        n_rows: 0,
        n_cols: nc,
    }
}

// ============================================================================
// ELEMENT ACCESS
// ============================================================================

// Set a single cell value.
pub fn df_set(df: &!DataFrame, row: i64, col: i64, val: f64) with Mut, Panic {
    if row < 0 { return }
    if col < 0 { return }
    if row >= df.n_rows { return }
    if col >= df.n_cols { return }
    let idx = row * 64 + col
    df.data[idx] = val
}

// Get a single cell value.
pub fn df_get(df: &DataFrame, row: i64, col: i64) -> f64 with Panic {
    if row < 0 { return 0.0 }
    if col < 0 { return 0.0 }
    if row >= df.n_rows { return 0.0 }
    if col >= df.n_cols { return 0.0 }
    let idx = row * 64 + col
    return df.data[idx]
}

// ============================================================================
// ROW OPERATIONS
// ============================================================================

// Append a row of values. Reads up to n_cols values from the input array.
pub fn df_add_row(df: &!DataFrame, values: &[f64; 64]) with Mut, Div, Panic {
    if df.n_rows >= 1024 { return }
    let row = df.n_rows
    var col: i64 = 0
    while col < df.n_cols {
        let idx = row * 64 + col
        df.data[idx] = values[col]
        col = col + 1
    }
    df.n_rows = df.n_rows + 1
}

// ============================================================================
// COLUMN STATISTICS
// ============================================================================

// Column mean.
pub fn df_col_mean(df: &DataFrame, col: i64) -> f64 with Mut, Div, Panic {
    if col < 0 { return 0.0 }
    if col >= df.n_cols { return 0.0 }
    if df.n_rows == 0 { return 0.0 }
    var sum = 0.0
    var row: i64 = 0
    while row < df.n_rows {
        sum = sum + df.data[row * 64 + col]
        row = row + 1
    }
    return sum / (df.n_rows as f64)
}

// Column standard deviation (sample, Bessel-corrected).
pub fn df_col_std(df: &DataFrame, col: i64) -> f64 with Mut, Div, Panic {
    if col < 0 { return 0.0 }
    if col >= df.n_cols { return 0.0 }
    if df.n_rows < 2 { return 0.0 }
    let mean = df_col_mean(df, col)
    var sum_sq = 0.0
    var row: i64 = 0
    while row < df.n_rows {
        let diff = df.data[row * 64 + col] - mean
        sum_sq = sum_sq + diff * diff
        row = row + 1
    }
    let variance = sum_sq / ((df.n_rows - 1) as f64)
    return df_sqrt(variance)
}

// Column minimum.
pub fn df_col_min(df: &DataFrame, col: i64) -> f64 with Mut, Div, Panic {
    if col < 0 { return 0.0 }
    if col >= df.n_cols { return 0.0 }
    if df.n_rows == 0 { return 0.0 }
    var m = df.data[0 * 64 + col]
    var row: i64 = 1
    while row < df.n_rows {
        let v = df.data[row * 64 + col]
        if v < m { m = v }
        row = row + 1
    }
    return m
}

// Column maximum.
pub fn df_col_max(df: &DataFrame, col: i64) -> f64 with Mut, Div, Panic {
    if col < 0 { return 0.0 }
    if col >= df.n_cols { return 0.0 }
    if df.n_rows == 0 { return 0.0 }
    var m = df.data[0 * 64 + col]
    var row: i64 = 1
    while row < df.n_rows {
        let v = df.data[row * 64 + col]
        if v > m { m = v }
        row = row + 1
    }
    return m
}

// Column sum.
pub fn df_col_sum(df: &DataFrame, col: i64) -> f64 with Mut, Div, Panic {
    if col < 0 { return 0.0 }
    if col >= df.n_cols { return 0.0 }
    var sum = 0.0
    var row: i64 = 0
    while row < df.n_rows {
        sum = sum + df.data[row * 64 + col]
        row = row + 1
    }
    return sum
}

// ============================================================================
// FILTERING
// ============================================================================

// Return a new DataFrame containing only rows where column col > threshold.
pub fn df_filter_gt(df: &DataFrame, col: i64, threshold: f64) -> DataFrame with Mut, Div, Panic {
    var result = df_new(df.n_cols)
    if col < 0 { return result }
    if col >= df.n_cols { return result }
    var row: i64 = 0
    while row < df.n_rows {
        let v = df.data[row * 64 + col]
        if v > threshold {
            // Copy this row into result
            if result.n_rows < 1024 {
                let dst_row = result.n_rows
                var c: i64 = 0
                while c < df.n_cols {
                    result.data[dst_row * 64 + c] = df.data[row * 64 + c]
                    c = c + 1
                }
                result.n_rows = result.n_rows + 1
            }
        }
        row = row + 1
    }
    // Copy column name IDs
    var ci: i64 = 0
    while ci < df.n_cols {
        result.col_names[ci] = df.col_names[ci]
        ci = ci + 1
    }
    return result
}

// ============================================================================
// COLUMN PROJECTION
// ============================================================================

// Select a subset of columns. cols contains column indices, n_sel is the
// number of columns to select.
pub fn df_select_cols(df: &DataFrame, cols: &[i64; 64], n_sel: i64) -> DataFrame with Mut, Div, Panic {
    var ns = n_sel
    if ns < 0 { ns = 0 }
    if ns > 64 { ns = 64 }
    var result = df_new(ns)
    var row: i64 = 0
    while row < df.n_rows {
        if result.n_rows < 1024 {
            let dst_row = result.n_rows
            var s: i64 = 0
            while s < ns {
                let src_col = cols[s]
                if src_col >= 0 {
                    if src_col < df.n_cols {
                        result.data[dst_row * 64 + s] = df.data[row * 64 + src_col]
                    }
                }
                s = s + 1
            }
            result.n_rows = result.n_rows + 1
        }
        row = row + 1
    }
    // Map column name IDs
    var ci: i64 = 0
    while ci < ns {
        let src_col = cols[ci]
        if src_col >= 0 {
            if src_col < df.n_cols {
                result.col_names[ci] = df.col_names[src_col]
            }
        }
        ci = ci + 1
    }
    return result
}

// ============================================================================
// SORTING
// ============================================================================

// Sort rows by a column value (ascending). Returns a new DataFrame.
// Uses insertion sort for simplicity and correctness.
pub fn df_sort_by(df: &DataFrame, col: i64) -> DataFrame with Mut, Div, Panic {
    var result = df_new(df.n_cols)
    if col < 0 { return result }
    if col >= df.n_cols { return result }

    // Copy all data into result first
    var row: i64 = 0
    while row < df.n_rows {
        var c: i64 = 0
        while c < df.n_cols {
            result.data[row * 64 + c] = df.data[row * 64 + c]
            c = c + 1
        }
        row = row + 1
    }
    result.n_rows = df.n_rows

    // Copy column names
    var ci: i64 = 0
    while ci < df.n_cols {
        result.col_names[ci] = df.col_names[ci]
        ci = ci + 1
    }

    // Insertion sort by column col
    var i: i64 = 1
    while i < result.n_rows {
        let key_val = result.data[i * 64 + col]
        var j = i - 1
        while j >= 0 {
            let cmp_val = result.data[j * 64 + col]
            if cmp_val > key_val {
                // Swap rows j and j+1
                var c2: i64 = 0
                while c2 < result.n_cols {
                    let tmp = result.data[(j + 1) * 64 + c2]
                    result.data[(j + 1) * 64 + c2] = result.data[j * 64 + c2]
                    result.data[j * 64 + c2] = tmp
                    c2 = c2 + 1
                }
                j = j - 1
            } else {
                j = -1  // break out of inner loop
            }
        }
        i = i + 1
    }
    return result
}

// ============================================================================
// CSV-STYLE LOADING
// ============================================================================

// Load pre-parsed numeric data into a DataFrame.
// data is a flat array in row-major order (row * n_cols_actual + col),
// but stored in a [f64; 65536] buffer.
pub fn df_from_csv_data(data: &[f64; 65536], n_rows: i64, n_cols: i64) -> DataFrame with Mut, Div, Panic {
    var nr = n_rows
    var nc = n_cols
    if nr < 0 { nr = 0 }
    if nc < 0 { nc = 0 }
    if nr > 1024 { nr = 1024 }
    if nc > 64 { nc = 64 }
    var result = df_new(nc)
    var row: i64 = 0
    while row < nr {
        var col: i64 = 0
        while col < nc {
            // Source uses actual n_cols stride; dest uses 64 stride
            let src_idx = row * nc + col
            result.data[row * 64 + col] = data[src_idx]
            col = col + 1
        }
        row = row + 1
    }
    result.n_rows = nr
    return result
}

// ============================================================================
// SUMMARY / DESCRIBE
// ============================================================================

// Print mean, std, min, max for each column.
pub fn df_describe(df: &DataFrame) with IO, Mut, Div, Panic {
    println("DataFrame describe:")
    print("  rows: ")
    println(df.n_rows)
    print("  cols: ")
    println(df.n_cols)
    println("  ---")
    var col: i64 = 0
    while col < df.n_cols {
        print("  col ")
        print(col)
        print(":  mean=")
        print(df_col_mean(df, col))
        print("  std=")
        print(df_col_std(df, col))
        print("  min=")
        print(df_col_min(df, col))
        print("  max=")
        println(df_col_max(df, col))
        col = col + 1
    }
}

// ============================================================================
// COLUMN NAME HELPERS
// ============================================================================

// Assign an integer name ID to a column.
pub fn df_set_col_name(df: &!DataFrame, col: i64, name_id: i64) with Mut, Panic {
    if col >= 0 {
        if col < df.n_cols {
            df.col_names[col] = name_id
        }
    }
}

// Get the name ID of a column.
pub fn df_get_col_name(df: &DataFrame, col: i64) -> i64 with Panic {
    if col < 0 { return 0 }
    if col >= df.n_cols { return 0 }
    return df.col_names[col]
}

// Dimension accessors
pub fn df_nrows(df: &DataFrame) -> i64 { df.n_rows }
pub fn df_ncols(df: &DataFrame) -> i64 { df.n_cols }
