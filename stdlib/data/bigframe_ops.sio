// stdlib/data/bigframe_ops.sio
// Scale verbs over the heap-backed columnar BigFrame (stdlib/data/bigframe.sio).
//
// These are the relational primitives that make a >>1024-row BigFrame useful as a
// dataframe: a row filter, integer and hash groupby-sum, the inner/left/outer
// hash-joins, a stable comparison sort, an adaptive stable radix sort,
// unique / drop-duplicates, value-counts, cumulative sum / count / max / min, and
// rolling-window sum / mean / max / min, shift / diff / pct-change, and an
// exponentially weighted moving mean.
// Each is an O(n)-expected pass (or two), allocates its result on the heap via
// bf_new, and scales to the millions of rows a BigFrame holds. The reductions/joins
// gather COLUMN-MAJOR through the raw column pointers (bf_col_ptr + read_f64/
// write_f64) for throughput. NATIVE + lean_single only (heap).
//
// Compile+run:
//   SOUNIO_SOUC_ENGINE=lean_single ./bin/souc compile <file> -o out && ./out

use data::bigframe::*

// ============================================================================
// CONSTANTS
// ============================================================================

// Distinct-key ceiling for bf_groupby_sum. Keys are treated as small integer
// bucket ids in [0, this). A row whose key falls outside the range is dropped
// from the group result (documented, not silently miscounted). 1024 keeps the
// two accumulator arrays at 8 KB + 8 KB of stack.
fn bf_groupby_max_keys() -> i64 { 1024 }

// ============================================================================
// FILTER
// ============================================================================
//
// Return a NEW BigFrame containing exactly the rows of `src` for which
// column `col` is strictly greater than `thresh`. Column count and column
// order are preserved. The result is heap-allocated independently of `src`;
// the caller owns it and must bf_free it.
//
// Single O(n_rows * n_cols) pass: for each qualifying row we copy every column
// value into a stack row buffer and append it via bf_push_row (which grows the
// result's column buffers 2x on demand).
// Count the rows of `src` whose column `col` is strictly greater than `thresh` (a pure O(n) scan
// over the raw column buffer -- no allocation).
pub fn bf_count_gt(src: &BigFrame, col: i64, thresh: f64) -> i64 with Mut, Div, Panic {
    let nc = bf_ncols(src)
    if col < 0 { return 0 }
    if col >= nc { return 0 }
    let p = bf_col_ptr(src, col) as *mut f64
    let n = bf_nrows(src)
    var cnt: i64 = 0
    var i: i64 = 0
    while i < n {
        if read_f64(p, i) > thresh { cnt = cnt + 1 }
        i = i + 1
    }
    cnt
}

// Return a NEW BigFrame with exactly the rows where column `col` > `thresh`. TWO-PASS: pass 1 counts
// the survivors (via bf_count_gt) so the output is allocated ONCE at the exact size -- no doubling
// realloc churn (the old single-pass version reallocated ~log2(survivors) times, copying the growing
// buffer each time). Pass 2 copies the matching rows. Columns/order preserved; caller must bf_free.
pub fn bf_filter_gt(src: &BigFrame, col: i64, thresh: f64) -> BigFrame with Alloc, Mut, Div, Panic {
    let nc = bf_ncols(src)
    let nr = bf_nrows(src)
    if col < 0 { return bf_new(nc, 1) }
    if col >= nc { return bf_new(nc, 1) }
    let kp = bf_col_ptr(src, col) as *mut f64
    // Single scan: survivor count + first/last position (for the contiguous fast-path).
    var first: i64 = 0 - 1
    var last: i64 = 0 - 1
    var cnt: i64 = 0
    var r0: i64 = 0
    while r0 < nr {
        if read_f64(kp, r0) > thresh {
            if first < 0 { first = r0 }
            last = r0
            cnt = cnt + 1
        }
        r0 = r0 + 1
    }
    var cap = cnt
    if cap < 1 { cap = 1 }
    var out = bf_new(nc, cap)
    if cnt <= 0 { return out }
    // CONTIGUOUS fast-path: survivors form an unbroken run [first,last] (e.g. a sorted/monotone
    // column) -> copy each column's slice sequentially, no predicate/index/random-access. ~1.4x.
    if cnt == (last - first + 1) {
        var c: i64 = 0
        while c < nc {
            let sp = bf_col_ptr(src, c) as *mut f64
            let op = bf_col_ptr(&out, c) as *mut f64
            var j: i64 = 0
            while j < cnt { write_f64(op, j, read_f64(sp, first + j)); j = j + 1 }
            c = c + 1
        }
        out.n_rows = cnt
        return out
    }
    // Scattered survivors: adaptive gather (index-array wide / column-major narrow).
    if nc >= 8 {
        let idx = heap_alloc(cnt * 8) as *mut f64
        var w: i64 = 0
        var r: i64 = 0
        while r < nr {
            if read_f64(kp, r) > thresh { write_f64(idx, w, r as f64); w = w + 1 }
            r = r + 1
        }
        var c: i64 = 0
        while c < nc {
            let sp = bf_col_ptr(src, c) as *mut f64
            let op = bf_col_ptr(&out, c) as *mut f64
            var j: i64 = 0
            while j < w { write_f64(op, j, read_f64(sp, read_f64(idx, j) as i64)); j = j + 1 }
            c = c + 1
        }
        heap_free(idx as *mut i8)
        out.n_rows = w
    } else {
        var c: i64 = 0
        while c < nc {
            let sp = bf_col_ptr(src, c) as *mut f64
            let op = bf_col_ptr(&out, c) as *mut f64
            var w: i64 = 0
            var r: i64 = 0
            while r < nr {
                if read_f64(kp, r) > thresh { write_f64(op, w, read_f64(sp, r)); w = w + 1 }
                r = r + 1
            }
            c = c + 1
        }
        out.n_rows = cnt
    }
    out
}

// ============================================================================
// GROUPBY-SUM
// ============================================================================
//
// Group `src` by integer bucket `key_col`, summing `val_col` within each group.
// Returns a fresh 2-column BigFrame: col0 = key, col1 = sum(val) for that key.
// Output rows are emitted in ascending key order.
//
// APPROACH (hash-free bounded accumulator, O(n)): the test keys are small
// integers 0..K, so we key a fixed [f64; MAXK] sum accumulator and a parallel
// [i64; MAXK] presence flag directly by (key_col value as i64). One linear pass
// over the rows fills the accumulator; a second pass over the MAXK buckets emits
// one output row per key that was actually seen. No hashing, no sorting, no
// per-key allocation. Keys must land in [0, bf_groupby_max_keys()); rows whose
// key is negative or >= the ceiling are dropped (documented cap, not a silent
// miscount). For genuinely large / sparse key domains this would become an
// open-addressing hash; for dense small-integer keys the direct-index table is
// both simpler and strictly faster.
pub fn bf_groupby_sum(src: &BigFrame, key_col: i64, val_col: i64) -> BigFrame with Alloc, Mut {
    let maxk = bf_groupby_max_keys()
    var sums: [f64; 1024] = [0.0; 1024]
    var seen: [i64; 1024] = [0; 1024]

    let nr = bf_nrows(src)
    let nc = bf_ncols(src)

    var out = bf_new(2, 16)

    // Guard invalid columns -> empty group frame.
    if key_col < 0 { return out }
    if key_col >= nc { return out }
    if val_col < 0 { return out }
    if val_col >= nc { return out }

    // Pass 1: accumulate.
    var r: i64 = 0
    while r < nr {
        let kf = bf_get(src, r, key_col)
        let k = kf as i64
        if k >= 0 {
            if k < maxk {
                sums[k] = sums[k] + bf_get(src, r, val_col)
                seen[k] = 1
            }
        }
        r = r + 1
    }

    // Pass 2: emit one [key, sum] row per seen bucket, ascending key.
    var row: [f64; 64] = [0.0; 64]
    var k2: i64 = 0
    while k2 < maxk {
        if seen[k2] == 1 {
            row[0] = k2 as f64
            row[1] = sums[k2]
            bf_push_row(&!out, &row, 2)
        }
        k2 = k2 + 1
    }
    out
}

// Fibonacci hash of an f64 key (via its bits) into [0, mask].
fn bf_ghash(key: f64, mask: i64) -> i64 with Mut, Div, Panic {
    var h = f64_to_bits(key)
    h = h * (0 - 7046029254386353131)   // 0x9E3779B97F4A7C15 (signed) -- multiplicative/Fibonacci mix
    h = h ^ (h >> 29)
    h & mask
}

/// Group `src` by `key_col` (ANY f64 key -- sparse or large-domain, unlike bf_groupby_sum which caps
/// keys at 0..1023) and sum `val_col` per group, via an open-addressing hash table on the heap. O(n)
/// expected. Returns a 2-column [key, sum] BigFrame in hash-table order (not sorted). For small DENSE
/// integer keys, bf_groupby_sum is faster (direct-index, no probing); use this when keys are sparse,
/// large, or non-integer.
pub fn bf_groupby_sum_hash(src: &BigFrame, key_col: i64, val_col: i64) -> BigFrame with Alloc, Mut, Div, Panic {
    let nr = bf_nrows(src)
    if key_col < 0 || key_col >= bf_ncols(src) { return bf_new(2, 1) }
    if val_col < 0 || val_col >= bf_ncols(src) { return bf_new(2, 1) }
    if nr <= 0 { return bf_new(2, 1) }
    // table size = next power of two >= 2*nr (load factor <= 0.5 -> few probes). occ starts 0 (calloc).
    var size: i64 = 16
    while size < nr + nr { size = size * 2 }
    let mask = size - 1
    let occ = heap_alloc(size * 8) as *mut f64
    let hk  = heap_alloc(size * 8) as *mut f64
    let hs  = heap_alloc(size * 8) as *mut f64
    let kp = bf_col_ptr(src, key_col) as *mut f64
    let vp = bf_col_ptr(src, val_col) as *mut f64
    var ndistinct: i64 = 0
    var r: i64 = 0
    while r < nr {
        let key = read_f64(kp, r)
        let val = read_f64(vp, r)
        var slot = bf_ghash(key, mask)
        var placed = false
        while !placed {
            if read_f64(occ, slot) == 0.0 {
                write_f64(occ, slot, 1.0)
                write_f64(hk, slot, key)
                write_f64(hs, slot, val)
                ndistinct = ndistinct + 1
                placed = true
            } else {
                if read_f64(hk, slot) == key {
                    write_f64(hs, slot, read_f64(hs, slot) + val)
                    placed = true
                } else {
                    slot = (slot + 1) & mask
                }
            }
        }
        r = r + 1
    }
    var cap = ndistinct
    if cap < 1 { cap = 1 }
    var out = bf_new(2, cap)
    var s: i64 = 0
    while s < size {
        if read_f64(occ, s) == 1.0 {
            var row: [f64; 64] = [0.0; 64]
            row[0] = read_f64(hk, s)
            row[1] = read_f64(hs, s)
            bf_push_row(&!out, &row, 2)
        }
        s = s + 1
    }
    heap_free(occ as *mut i8)
    heap_free(hk as *mut i8)
    heap_free(hs as *mut i8)
    out
}

/// Inner hash-join of `left` and `right` on their key columns (`lkey`, `rkey`).
/// Build phase: an open-addressing hash table over `right`'s key column (first row
/// wins on a duplicate build key -- so `right` is treated as the unique/dimension
/// side, i.e. the standard enrichment/lookup join). Probe phase: for each `left`
/// row, look up its key and, on a hit, record the (left-row, right-row) pair.
/// Emit COLUMN-MAJOR: each output column is gathered in a single pass over the
/// match list, which avoids the per-cell cost of a row-major bf_push_row loop.
/// Output columns = all of `left`'s columns, then all of `right`'s columns EXCEPT
/// `rkey` (the join key appears once, from `left`), and rows are emitted in `left`
/// probe order. O(nl + nr) expected. NATIVE + lean_single only (heap).
pub fn bf_join_inner(left: &BigFrame, lkey: i64, right: &BigFrame, rkey: i64) -> BigFrame with Alloc, Mut, Div, Panic {
    let lnc = bf_ncols(left)
    let rnc = bf_ncols(right)
    let lnr = bf_nrows(left)
    let rnr = bf_nrows(right)
    let outc = lnc + rnc - 1
    if lkey < 0 || lkey >= lnc { return bf_new(outc, 1) }
    if rkey < 0 || rkey >= rnc { return bf_new(outc, 1) }
    if lnr <= 0 || rnr <= 0 { return bf_new(outc, 1) }

    // Build an open-addressing table on right's key column (load factor <= 0.5 ->
    // few probes). occ starts 0 (calloc); ri holds the right-row index per slot.
    var size: i64 = 16
    while size < rnr + rnr { size = size * 2 }
    let mask = size - 1
    let occ = heap_alloc(size * 8) as *mut f64
    let hk  = heap_alloc(size * 8) as *mut f64
    let ri  = heap_alloc(size * 8) as *mut f64
    let rkp = bf_col_ptr(right, rkey) as *mut f64
    var b: i64 = 0
    while b < rnr {
        let key = read_f64(rkp, b)
        var slot = bf_ghash(key, mask)
        var placed = false
        while !placed {
            if read_f64(occ, slot) == 0.0 {
                write_f64(occ, slot, 1.0)
                write_f64(hk, slot, key)
                write_f64(ri, slot, b as f64)
                placed = true
            } else {
                if read_f64(hk, slot) == key {
                    placed = true              // first build row wins on a duplicate key
                } else {
                    slot = (slot + 1) & mask
                }
            }
        }
        b = b + 1
    }

    // Probe: for each left row, record the matching (left-row, right-row) pair.
    let lkp = bf_col_ptr(left, lkey) as *mut f64
    let ml = heap_alloc(lnr * 8) as *mut f64
    let mr = heap_alloc(lnr * 8) as *mut f64
    var nmatch: i64 = 0
    var l: i64 = 0
    while l < lnr {
        let key = read_f64(lkp, l)
        var slot = bf_ghash(key, mask)
        var done = false
        while !done {
            if read_f64(occ, slot) == 0.0 {
                done = true                    // empty slot -> no match for this key
            } else {
                if read_f64(hk, slot) == key {
                    write_f64(ml, nmatch, l as f64)
                    write_f64(mr, nmatch, read_f64(ri, slot))
                    nmatch = nmatch + 1
                    done = true
                } else {
                    slot = (slot + 1) & mask
                }
            }
        }
        l = l + 1
    }

    var cap = nmatch
    if cap < 1 { cap = 1 }
    var out = bf_new(outc, cap)
    out.n_rows = nmatch                         // fill the columns directly below

    // Left columns: gather by the matched left-row index.
    var c: i64 = 0
    while c < lnc {
        let sp = bf_col_ptr(left, c) as *mut f64
        let op = bf_col_ptr(&out, c) as *mut f64
        var j: i64 = 0
        while j < nmatch {
            write_f64(op, j, read_f64(sp, read_f64(ml, j) as i64))
            j = j + 1
        }
        c = c + 1
    }
    // Right columns except the join key: gather by the matched right-row index.
    var oc: i64 = lnc
    var rc: i64 = 0
    while rc < rnc {
        if rc != rkey {
            let sp = bf_col_ptr(right, rc) as *mut f64
            let op = bf_col_ptr(&out, oc) as *mut f64
            var j: i64 = 0
            while j < nmatch {
                write_f64(op, j, read_f64(sp, read_f64(mr, j) as i64))
                j = j + 1
            }
            oc = oc + 1
        }
        rc = rc + 1
    }

    heap_free(occ as *mut i8)
    heap_free(hk as *mut i8)
    heap_free(ri as *mut i8)
    heap_free(ml as *mut i8)
    heap_free(mr as *mut i8)
    out
}

// Shared engine for the outer-family joins. Builds a hash table on `right`'s key
// column (first-row-wins on a duplicate key -- `right` is the unique/lookup side,
// same model as bf_join_inner) and probes `left`, keeping EVERY left row: matched
// left rows carry the right columns, unmatched left rows carry `fill` in the right
// columns. When `include_right_only` is true (full outer join) it then appends the
// right rows whose key no left row matched, with `fill` in the left columns except
// the join-key column, which is coalesced to the right key. Output layout matches
// bf_join_inner: all `left` columns, then all `right` columns except `rkey`. Left
// rows come out in probe order; right-only rows follow in right-scan order.
// O(nl + nr) expected. NATIVE + lean_single only (heap).
fn bf_join_lo(left: &BigFrame, lkey: i64, right: &BigFrame, rkey: i64, fill: f64, include_right_only: bool) -> BigFrame with Alloc, Mut, Div, Panic {
    let lnc = bf_ncols(left)
    let rnc = bf_ncols(right)
    let lnr = bf_nrows(left)
    let rnr = bf_nrows(right)
    let outc = lnc + rnc - 1
    if lkey < 0 || lkey >= lnc { return bf_new(outc, 1) }
    if rkey < 0 || rkey >= rnc { return bf_new(outc, 1) }
    if lnr <= 0 { return bf_new(outc, 1) }

    // Build a table on right's key column (occ starts 0 via calloc). ri = right row.
    var size: i64 = 16
    while size < rnr + rnr { size = size * 2 }
    if rnr <= 0 { size = 16 }
    let mask = size - 1
    let occ = heap_alloc(size * 8) as *mut f64
    let hk  = heap_alloc(size * 8) as *mut f64
    let ri  = heap_alloc(size * 8) as *mut f64
    let rkeyp = bf_col_ptr(right, rkey) as *mut f64
    var b: i64 = 0
    while b < rnr {
        let key = read_f64(rkeyp, b)
        var slot = bf_ghash(key, mask)
        var placed = false
        while !placed {
            if read_f64(occ, slot) == 0.0 {
                write_f64(occ, slot, 1.0)
                write_f64(hk, slot, key)
                write_f64(ri, slot, b as f64)
                placed = true
            } else {
                if read_f64(hk, slot) == key {
                    placed = true              // first build row wins on a duplicate key
                } else {
                    slot = (slot + 1) & mask
                }
            }
        }
        b = b + 1
    }

    // Probe every left row. mr[l] = matched right row index, or -1 on a miss.
    // matched[r] flags right rows some left row hit (for the right-only outer pass).
    let lkp = bf_col_ptr(left, lkey) as *mut f64
    let mr = heap_alloc(lnr * 8) as *mut f64
    var rcap = rnr
    if rcap < 1 { rcap = 1 }
    let matched = heap_alloc(rcap * 8) as *mut f64   // 0 = unmatched (calloc)
    var l: i64 = 0
    while l < lnr {
        let key = read_f64(lkp, l)
        var slot = bf_ghash(key, mask)
        var found: i64 = 0 - 1
        var done = false
        while !done {
            if read_f64(occ, slot) == 0.0 {
                done = true
            } else {
                if read_f64(hk, slot) == key {
                    found = read_f64(ri, slot) as i64
                    done = true
                } else {
                    slot = (slot + 1) & mask
                }
            }
        }
        write_f64(mr, l, found as f64)
        if found >= 0 { write_f64(matched, found, 1.0) }
        l = l + 1
    }

    // Collect right-only rows (full outer): right rows whose key no left row matched.
    let rro = heap_alloc(rcap * 8) as *mut f64
    var nonly: i64 = 0
    if include_right_only {
        var b2: i64 = 0
        while b2 < rnr {
            if read_f64(matched, b2) == 0.0 {
                write_f64(rro, nonly, b2 as f64)
                nonly = nonly + 1
            }
            b2 = b2 + 1
        }
    }

    let total = lnr + nonly
    var cap = total
    if cap < 1 { cap = 1 }
    var out = bf_new(outc, cap)
    out.n_rows = total

    // Left columns: left rows in order; right-only rows get `fill` (key col coalesced).
    var c: i64 = 0
    while c < lnc {
        let sp = bf_col_ptr(left, c) as *mut f64
        let op = bf_col_ptr(&out, c) as *mut f64
        var j: i64 = 0
        while j < lnr {
            write_f64(op, j, read_f64(sp, j))
            j = j + 1
        }
        if include_right_only {
            var t: i64 = 0
            while t < nonly {
                if c == lkey {
                    write_f64(op, lnr + t, read_f64(rkeyp, read_f64(rro, t) as i64))
                } else {
                    write_f64(op, lnr + t, fill)
                }
                t = t + 1
            }
        }
        c = c + 1
    }
    // Right columns except the join key: matched right row, else `fill`; right-only
    // rows carry their own right values.
    var oc: i64 = lnc
    var rc: i64 = 0
    while rc < rnc {
        if rc != rkey {
            let sp = bf_col_ptr(right, rc) as *mut f64
            let op = bf_col_ptr(&out, oc) as *mut f64
            var j: i64 = 0
            while j < lnr {
                let m = read_f64(mr, j) as i64
                if m >= 0 {
                    write_f64(op, j, read_f64(sp, m))
                } else {
                    write_f64(op, j, fill)
                }
                j = j + 1
            }
            if include_right_only {
                var t: i64 = 0
                while t < nonly {
                    write_f64(op, lnr + t, read_f64(sp, read_f64(rro, t) as i64))
                    t = t + 1
                }
            }
            oc = oc + 1
        }
        rc = rc + 1
    }

    heap_free(occ as *mut i8)
    heap_free(hk as *mut i8)
    heap_free(ri as *mut i8)
    heap_free(mr as *mut i8)
    heap_free(matched as *mut i8)
    heap_free(rro as *mut i8)
    out
}

/// LEFT outer join: keep every `left` row, attaching the matched `right` columns or
/// `fill` where no right key matches (pass `make_nan()`-style value for pandas NaN
/// semantics, or any sentinel). Output = all `left` columns then `right` columns
/// except the join key, in left probe order. See bf_join_lo for the lookup model.
pub fn bf_join_left(left: &BigFrame, lkey: i64, right: &BigFrame, rkey: i64, fill: f64) -> BigFrame with Alloc, Mut, Div, Panic {
    bf_join_lo(left, lkey, right, rkey, fill, false)
}

/// FULL OUTER join: every `left` row (right columns filled where unmatched) plus
/// every `right` row whose key no `left` row matched (left columns `fill`ed, the
/// join-key column coalesced to the right key). Output layout matches bf_join_left;
/// left rows first, then right-only rows. `right` is treated as the unique/lookup
/// side (first build row wins on a duplicate key). See bf_join_lo.
pub fn bf_join_outer(left: &BigFrame, lkey: i64, right: &BigFrame, rkey: i64, fill: f64) -> BigFrame with Alloc, Mut, Div, Panic {
    bf_join_lo(left, lkey, right, rkey, fill, true)
}

/// Sort all rows of `src` by column `col` (`ascending` toggles direction), returning
/// a NEW BigFrame with the rows permuted. Argsort + column-major gather: a bottom-up
/// STABLE mergesort orders (key, original-row) pairs, then each output column is
/// gathered through the sorted index list. Paired key/index buffers with ping-pong
/// (no per-pass copy-back) keep the comparisons sequential (cache-friendly) rather
/// than chasing an index into the key array. O(n log n), stable (equal keys keep
/// their input order). Comparison is a direct f64 `<=`/`>=`, correct for every
/// non-NaN value; NaN ordering is unspecified (as in pandas). NATIVE + lean_single
/// only (heap).
pub fn bf_sort_by(src: &BigFrame, col: i64, ascending: bool) -> BigFrame with Alloc, Mut, Div, Panic {
    let nc = bf_ncols(src)
    let n = bf_nrows(src)
    if col < 0 || col >= nc || n <= 0 { return bf_new(nc, 1) }

    // Two key buffers + two index buffers, ping-ponged each merge pass. ka/ia start
    // as the identity (key = src column value, index = row number).
    var ka = heap_alloc(n * 8) as *mut f64
    var kb = heap_alloc(n * 8) as *mut f64
    var ia = heap_alloc(n * 8) as *mut i64
    var ib = heap_alloc(n * 8) as *mut i64
    let kp = bf_col_ptr(src, col) as *mut f64
    var i: i64 = 0
    while i < n {
        write_f64(ka, i, read_f64(kp, i))
        write_i64(ia, i, i)
        i = i + 1
    }

    // cur = source buffers this pass, dst = scratch; swapped after each pass.
    var ck = ka
    var ci = ia
    var dk = kb
    var di = ib
    var width: i64 = 1
    while width < n {
        var lo: i64 = 0
        while lo < n {
            var mid = lo + width
            if mid > n { mid = n }
            var hi = lo + width + width
            if hi > n { hi = n }
            var a = lo
            var b = mid
            var k = lo
            while a < mid && b < hi {
                let va = read_f64(ck, a)
                let vb = read_f64(ck, b)
                var take_a = false
                if ascending {
                    if va <= vb { take_a = true }   // <= keeps left (earlier) row first -> stable
                } else {
                    if va >= vb { take_a = true }
                }
                if take_a {
                    write_f64(dk, k, va)
                    write_i64(di, k, read_i64(ci, a))
                    a = a + 1
                } else {
                    write_f64(dk, k, vb)
                    write_i64(di, k, read_i64(ci, b))
                    b = b + 1
                }
                k = k + 1
            }
            while a < mid {
                write_f64(dk, k, read_f64(ck, a))
                write_i64(di, k, read_i64(ci, a))
                a = a + 1
                k = k + 1
            }
            while b < hi {
                write_f64(dk, k, read_f64(ck, b))
                write_i64(di, k, read_i64(ci, b))
                b = b + 1
                k = k + 1
            }
            lo = lo + width + width
        }
        let tk = ck
        ck = dk
        dk = tk
        let ti = ci
        ci = di
        di = ti
        width = width + width
    }

    // ci holds the original-row indices in sorted order. Gather each column.
    var out = bf_new(nc, n)
    out.n_rows = n
    var c: i64 = 0
    while c < nc {
        let sp = bf_col_ptr(src, c) as *mut f64
        let op = bf_col_ptr(&out, c) as *mut f64
        var j: i64 = 0
        while j < n {
            write_f64(op, j, read_f64(sp, read_i64(ci, j)))
            j = j + 1
        }
        c = c + 1
    }

    heap_free(ka as *mut i8)
    heap_free(kb as *mut i8)
    heap_free(ia as *mut i8)
    heap_free(ib as *mut i8)
    out
}

// Map an f64 to an order-preserving i64 sort key: as UNSIGNED integers, the keys
// compare in the same order as the doubles. Negatives (sign bit set) get all bits
// flipped (reverses their reversed order); non-negatives get the sign bit set. This
// is the standard IEEE-754 radix transform; correct for -0.0 (sorts just below +0.0)
// and every finite value. `>>` is arithmetic here, so byte extraction below works
// regardless, but the transform itself uses only `<`, `^`, and `1<<63`.
fn radix_key(x: f64) -> i64 with Mut, Div, Panic {
    let u = f64_to_bits(x)
    if u < 0 { u ^ (0 - 1) } else { u ^ (1 << 63) }
}

/// Sort rows of `src` by column `col` with an LSD RADIX sort over the f64 bit-keys
/// (11-bit digits, up to 6 passes). STABLE. Same result as bf_sort_by but O(n) and,
/// crucially, ADAPTIVE: a diff-mask skips digit-passes whose 11-bit window is uniform
/// across all keys, so a key column with BOUNDED RANGE or LOW CARDINALITY (IDs,
/// categories, quantized/binned measurements, timestamps in a window) sorts in 1-3
/// passes and beats bf_sort_by by ~1.8x (and pandas). On FULL-ENTROPY continuous
/// doubles every pass runs and it merely matches bf_sort_by -- so this is a fast path
/// for bounded keys, not a universal replacement. Correctness is guaranteed for all
/// non-NaN f64 by radix_key; NaN ordering is unspecified (as in pandas). NATIVE +
/// lean_single only (heap).
pub fn bf_sort_radix(src: &BigFrame, col: i64, ascending: bool) -> BigFrame with Alloc, Mut, Div, Panic {
    let nc = bf_ncols(src)
    let n = bf_nrows(src)
    if col < 0 || col >= nc || n <= 0 { return bf_new(nc, 1) }

    var ka = heap_alloc(n * 8) as *mut i64   // transformed key, ping-pong A/B
    var kb = heap_alloc(n * 8) as *mut i64
    var ia = heap_alloc(n * 8) as *mut i64   // original row index, ping-pong A/B
    var ib = heap_alloc(n * 8) as *mut i64
    let kp = bf_col_ptr(src, col) as *mut f64
    var i: i64 = 0
    while i < n {
        write_i64(ka, i, radix_key(read_f64(kp, i)))
        write_i64(ia, i, i)
        i = i + 1
    }
    // diff-mask: the OR of every key XOR the first key -> bits that vary. A digit
    // whose 11-bit window is entirely zero here is uniform, so its pass is a no-op.
    let f0 = read_i64(ka, 0)
    var dmask: i64 = 0
    var d: i64 = 0
    while d < n {
        dmask = dmask | (read_i64(ka, d) ^ f0)
        d = d + 1
    }

    var ck = ka
    var ci = ia
    var dk = kb
    var di = ib
    var digit: i64 = 0
    while digit < 6 {                          // 6 x 11-bit digits cover all 64 bits
        let shift = digit * 11
        if ((dmask >> shift) & 2047) != 0 {    // skip uniform digit windows
            var cnt: [i64; 2048] = [0; 2048]
            var t: i64 = 0
            while t < n {
                let bkt = (read_i64(ck, t) >> shift) & 2047
                cnt[bkt] = cnt[bkt] + 1
                t = t + 1
            }
            var sum: i64 = 0
            var b2: i64 = 0
            while b2 < 2048 {
                let c = cnt[b2]
                cnt[b2] = sum
                sum = sum + c
                b2 = b2 + 1
            }
            t = 0
            while t < n {
                let kv = read_i64(ck, t)
                let bkt = (kv >> shift) & 2047
                let pos = cnt[bkt]
                cnt[bkt] = pos + 1
                write_i64(dk, pos, kv)
                write_i64(di, pos, read_i64(ci, t))
                t = t + 1
            }
            let sk = ck
            ck = dk
            dk = sk
            let si = ci
            ci = di
            di = si
        }
        digit = digit + 1
    }

    // ci holds the original-row indices in ascending-key order. Gather each column
    // (read the index list backwards for a descending sort).
    var out = bf_new(nc, n)
    out.n_rows = n
    var c: i64 = 0
    while c < nc {
        let sp = bf_col_ptr(src, c) as *mut f64
        let op = bf_col_ptr(&out, c) as *mut f64
        var j: i64 = 0
        while j < n {
            var srcrow = read_i64(ci, j)
            if !ascending { srcrow = read_i64(ci, n - 1 - j) }
            write_f64(op, j, read_f64(sp, srcrow))
            j = j + 1
        }
        c = c + 1
    }

    heap_free(ka as *mut i8)
    heap_free(kb as *mut i8)
    heap_free(ia as *mut i8)
    heap_free(ib as *mut i8)
    out
}

/// Distinct values of column `col`, in FIRST-SEEN order (like pandas Series.unique()).
/// Single pass with an open-addressing hash table (the bf_ghash Fibonacci mix, load
/// factor <= 0.5); each value is emitted the first time its slot is claimed. Returns a
/// 1-column BigFrame. O(n) expected. NATIVE + lean_single only (heap).
pub fn bf_unique(src: &BigFrame, col: i64) -> BigFrame with Alloc, Mut, Div, Panic {
    let nr = bf_nrows(src)
    if col < 0 || col >= bf_ncols(src) || nr <= 0 { return bf_new(1, 1) }
    var size: i64 = 16
    while size < nr + nr { size = size * 2 }
    let mask = size - 1
    let occ = heap_alloc(size * 8) as *mut f64   // occupancy (starts 0 via calloc)
    let hk  = heap_alloc(size * 8) as *mut f64   // key at that slot
    let kp = bf_col_ptr(src, col) as *mut f64
    var out = bf_new(1, 16)
    var r: i64 = 0
    while r < nr {
        let v = read_f64(kp, r)
        var slot = bf_ghash(v, mask)
        var done = false
        while !done {
            if read_f64(occ, slot) == 0.0 {
                write_f64(occ, slot, 1.0)
                write_f64(hk, slot, v)
                var row: [f64; 64] = [0.0; 64]
                row[0] = v
                bf_push_row(&!out, &row, 1)      // emit on first sight -> first-seen order
                done = true
            } else {
                if read_f64(hk, slot) == v { done = true } else { slot = (slot + 1) & mask }
            }
        }
        r = r + 1
    }
    heap_free(occ as *mut i8)
    heap_free(hk as *mut i8)
    out
}

/// Keep the FIRST row for each distinct value of `key_col`, dropping later duplicates
/// (like pandas drop_duplicates(subset=[key], keep="first")). Preserves input row
/// order among the survivors. Single pass with the same open-addressing table as
/// bf_unique; on a key's first sighting the whole row is copied into the output.
/// Returns a BigFrame with all of `src`'s columns. O(n) expected. NATIVE +
/// lean_single only (heap).
pub fn bf_drop_duplicates(src: &BigFrame, key_col: i64) -> BigFrame with Alloc, Mut, Div, Panic {
    let nc = bf_ncols(src)
    let nr = bf_nrows(src)
    if key_col < 0 || key_col >= nc || nr <= 0 { return bf_new(nc, 1) }
    var size: i64 = 16
    while size < nr + nr { size = size * 2 }
    let mask = size - 1
    let occ = heap_alloc(size * 8) as *mut f64
    let hk  = heap_alloc(size * 8) as *mut f64
    let kp = bf_col_ptr(src, key_col) as *mut f64
    var out = bf_new(nc, 16)
    var r: i64 = 0
    while r < nr {
        let k = read_f64(kp, r)
        var slot = bf_ghash(k, mask)
        var done = false
        while !done {
            if read_f64(occ, slot) == 0.0 {
                write_f64(occ, slot, 1.0)
                write_f64(hk, slot, k)
                var row: [f64; 64] = [0.0; 64]
                var c: i64 = 0
                while c < nc { row[c] = bf_get(src, r, c); c = c + 1 }
                bf_push_row(&!out, &row, nc)
                done = true
            } else {
                if read_f64(hk, slot) == k { done = true } else { slot = (slot + 1) & mask }
            }
        }
        r = r + 1
    }
    heap_free(occ as *mut i8)
    heap_free(hk as *mut i8)
    out
}

/// Count occurrences of each distinct value of column `col`, returned as a 2-column
/// [value, count] BigFrame SORTED BY COUNT DESCENDING (like pandas Series.value_counts()).
/// One open-addressing hash-count pass (bf_ghash, load <= 0.5) tallies each distinct
/// value; the distinct rows are emitted in first-seen order, then stably sorted by
/// count descending (so equal counts keep first-seen order). O(n + d log d) for d
/// distinct values. NATIVE + lean_single only (heap).
pub fn bf_value_counts(src: &BigFrame, col: i64) -> BigFrame with Alloc, Mut, Div, Panic {
    let nr = bf_nrows(src)
    if col < 0 || col >= bf_ncols(src) || nr <= 0 { return bf_new(2, 1) }
    var size: i64 = 16
    while size < nr + nr { size = size * 2 }
    let mask = size - 1
    let occ = heap_alloc(size * 8) as *mut f64
    let hk  = heap_alloc(size * 8) as *mut f64
    let hc  = heap_alloc(size * 8) as *mut f64   // running count per slot
    let ord = heap_alloc(size * 8) as *mut i64   // slots in first-seen order
    let kp = bf_col_ptr(src, col) as *mut f64
    var nd: i64 = 0
    var r: i64 = 0
    while r < nr {
        let v = read_f64(kp, r)
        var slot = bf_ghash(v, mask)
        var done = false
        while !done {
            if read_f64(occ, slot) == 0.0 {
                write_f64(occ, slot, 1.0)
                write_f64(hk, slot, v)
                write_f64(hc, slot, 1.0)
                write_i64(ord, nd, slot)
                nd = nd + 1
                done = true
            } else {
                if read_f64(hk, slot) == v {
                    write_f64(hc, slot, read_f64(hc, slot) + 1.0)
                    done = true
                } else {
                    slot = (slot + 1) & mask
                }
            }
        }
        r = r + 1
    }
    var cap = nd
    if cap < 1 { cap = 1 }
    var tmp = bf_new(2, cap)
    var j: i64 = 0
    while j < nd {
        let s = read_i64(ord, j)
        var row: [f64; 64] = [0.0; 64]
        row[0] = read_f64(hk, s)
        row[1] = read_f64(hc, s)
        bf_push_row(&!tmp, &row, 2)
        j = j + 1
    }
    heap_free(occ as *mut i8)
    heap_free(hk as *mut i8)
    heap_free(hc as *mut i8)
    heap_free(ord as *mut i8)
    let out = bf_sort_by(&tmp, 1, false)     // by count descending; stable -> ties first-seen
    var tm = tmp
    bf_free(&!tm)
    out
}

/// Running (cumulative) sum of column `col`: a 1-column BigFrame of length n where
/// out[i] = col[0] + col[1] + ... + col[i] (like pandas Series.cumsum()). A single
/// sequential accumulate -- O(n), no hashing. (f64 accumulation, so it carries the
/// same rounding as any f64 running sum.) NATIVE + lean_single only (heap).
pub fn bf_cumsum(src: &BigFrame, col: i64) -> BigFrame with Alloc, Mut, Div, Panic {
    let n = bf_nrows(src)
    if col < 0 || col >= bf_ncols(src) || n <= 0 { return bf_new(1, 1) }
    var out = bf_new(1, n)
    out.n_rows = n
    let sp = bf_col_ptr(src, col) as *mut f64
    let op = bf_col_ptr(&out, 0) as *mut f64
    var acc = 0.0
    var i: i64 = 0
    while i < n {
        acc = acc + read_f64(sp, i)
        write_f64(op, i, acc)
        i = i + 1
    }
    out
}

/// Per-group running count (0-indexed), aligned to input row order: out[i] = the
/// number of EARLIER rows sharing row i's `key_col` value (like pandas
/// groupby(key).cumcount()). One pass with an open-addressing hash table mapping key
/// -> count-so-far. Returns a 1-column BigFrame of length n. O(n) expected. NATIVE +
/// lean_single only (heap).
pub fn bf_cumcount_by(src: &BigFrame, key_col: i64) -> BigFrame with Alloc, Mut, Div, Panic {
    let n = bf_nrows(src)
    if key_col < 0 || key_col >= bf_ncols(src) || n <= 0 { return bf_new(1, 1) }
    var size: i64 = 16
    while size < n + n { size = size * 2 }
    let mask = size - 1
    let occ = heap_alloc(size * 8) as *mut f64
    let hk  = heap_alloc(size * 8) as *mut f64
    let hc  = heap_alloc(size * 8) as *mut f64   // count-so-far per key
    let kp = bf_col_ptr(src, key_col) as *mut f64
    var out = bf_new(1, n)
    out.n_rows = n
    let op = bf_col_ptr(&out, 0) as *mut f64
    var i: i64 = 0
    while i < n {
        let k = read_f64(kp, i)
        var slot = bf_ghash(k, mask)
        var done = false
        while !done {
            if read_f64(occ, slot) == 0.0 {
                write_f64(occ, slot, 1.0)
                write_f64(hk, slot, k)
                write_f64(hc, slot, 1.0)
                write_f64(op, i, 0.0)              // first sighting -> 0 prior
                done = true
            } else {
                if read_f64(hk, slot) == k {
                    let c = read_f64(hc, slot)
                    write_f64(op, i, c)
                    write_f64(hc, slot, c + 1.0)
                    done = true
                } else {
                    slot = (slot + 1) & mask
                }
            }
        }
        i = i + 1
    }
    heap_free(occ as *mut i8)
    heap_free(hk as *mut i8)
    heap_free(hc as *mut i8)
    out
}

/// Per-group running sum of `val_col`, aligned to input row order: out[i] = the sum
/// of `val_col` over all rows up to and including row i that share row i's `key_col`
/// value (like pandas groupby(key)[val].cumsum()). One pass with an open-addressing
/// hash table mapping key -> running sum. Returns a 1-column BigFrame of length n.
/// O(n) expected. NATIVE + lean_single only (heap).
pub fn bf_cumsum_by(src: &BigFrame, key_col: i64, val_col: i64) -> BigFrame with Alloc, Mut, Div, Panic {
    let n = bf_nrows(src)
    let nc = bf_ncols(src)
    if key_col < 0 || key_col >= nc || val_col < 0 || val_col >= nc || n <= 0 { return bf_new(1, 1) }
    var size: i64 = 16
    while size < n + n { size = size * 2 }
    let mask = size - 1
    let occ = heap_alloc(size * 8) as *mut f64
    let hk  = heap_alloc(size * 8) as *mut f64
    let hs  = heap_alloc(size * 8) as *mut f64   // running sum per key
    let kp = bf_col_ptr(src, key_col) as *mut f64
    let vp = bf_col_ptr(src, val_col) as *mut f64
    var out = bf_new(1, n)
    out.n_rows = n
    let op = bf_col_ptr(&out, 0) as *mut f64
    var i: i64 = 0
    while i < n {
        let k = read_f64(kp, i)
        let v = read_f64(vp, i)
        var slot = bf_ghash(k, mask)
        var done = false
        while !done {
            if read_f64(occ, slot) == 0.0 {
                write_f64(occ, slot, 1.0)
                write_f64(hk, slot, k)
                write_f64(hs, slot, v)
                write_f64(op, i, v)
                done = true
            } else {
                if read_f64(hk, slot) == k {
                    let s = read_f64(hs, slot) + v
                    write_f64(hs, slot, s)
                    write_f64(op, i, s)
                    done = true
                } else {
                    slot = (slot + 1) & mask
                }
            }
        }
        i = i + 1
    }
    heap_free(occ as *mut i8)
    heap_free(hk as *mut i8)
    heap_free(hs as *mut i8)
    out
}

/// Running (cumulative) maximum of column `col`: a 1-column BigFrame of length n
/// where out[i] = max(col[0..=i]) (like pandas Series.cummax()). A single sequential
/// compare-accumulate, O(n), no hashing. NATIVE + lean_single only (heap).
pub fn bf_cummax(src: &BigFrame, col: i64) -> BigFrame with Alloc, Mut, Div, Panic {
    let n = bf_nrows(src)
    if col < 0 || col >= bf_ncols(src) || n <= 0 { return bf_new(1, 1) }
    var out = bf_new(1, n)
    out.n_rows = n
    let sp = bf_col_ptr(src, col) as *mut f64
    let op = bf_col_ptr(&out, 0) as *mut f64
    var acc = read_f64(sp, 0)
    var i: i64 = 0
    while i < n {
        let v = read_f64(sp, i)
        if v > acc { acc = v }
        write_f64(op, i, acc)
        i = i + 1
    }
    out
}

/// Running (cumulative) minimum of column `col`: out[i] = min(col[0..=i]) (like
/// pandas Series.cummin()). Single sequential compare-accumulate, O(n), no hashing.
/// NATIVE + lean_single only (heap).
pub fn bf_cummin(src: &BigFrame, col: i64) -> BigFrame with Alloc, Mut, Div, Panic {
    let n = bf_nrows(src)
    if col < 0 || col >= bf_ncols(src) || n <= 0 { return bf_new(1, 1) }
    var out = bf_new(1, n)
    out.n_rows = n
    let sp = bf_col_ptr(src, col) as *mut f64
    let op = bf_col_ptr(&out, 0) as *mut f64
    var acc = read_f64(sp, 0)
    var i: i64 = 0
    while i < n {
        let v = read_f64(sp, i)
        if v < acc { acc = v }
        write_f64(op, i, acc)
        i = i + 1
    }
    out
}

/// Per-group running maximum of `val_col`, aligned to input row order: out[i] = the
/// max of `val_col` over all rows up to and including i that share row i's `key_col`
/// value (like pandas groupby(key)[val].cummax()). One pass with an open-addressing
/// table mapping key -> running max. Returns a 1-column BigFrame of length n. O(n)
/// expected. NATIVE + lean_single only (heap).
pub fn bf_cummax_by(src: &BigFrame, key_col: i64, val_col: i64) -> BigFrame with Alloc, Mut, Div, Panic {
    let n = bf_nrows(src)
    let nc = bf_ncols(src)
    if key_col < 0 || key_col >= nc || val_col < 0 || val_col >= nc || n <= 0 { return bf_new(1, 1) }
    var size: i64 = 16
    while size < n + n { size = size * 2 }
    let mask = size - 1
    let occ = heap_alloc(size * 8) as *mut f64
    let hk  = heap_alloc(size * 8) as *mut f64
    let hm  = heap_alloc(size * 8) as *mut f64   // running max per key
    let kp = bf_col_ptr(src, key_col) as *mut f64
    let vp = bf_col_ptr(src, val_col) as *mut f64
    var out = bf_new(1, n)
    out.n_rows = n
    let op = bf_col_ptr(&out, 0) as *mut f64
    var i: i64 = 0
    while i < n {
        let k = read_f64(kp, i)
        let v = read_f64(vp, i)
        var slot = bf_ghash(k, mask)
        var done = false
        while !done {
            if read_f64(occ, slot) == 0.0 {
                write_f64(occ, slot, 1.0)
                write_f64(hk, slot, k)
                write_f64(hm, slot, v)
                write_f64(op, i, v)
                done = true
            } else {
                if read_f64(hk, slot) == k {
                    var m = read_f64(hm, slot)
                    if v > m { m = v }
                    write_f64(hm, slot, m)
                    write_f64(op, i, m)
                    done = true
                } else {
                    slot = (slot + 1) & mask
                }
            }
        }
        i = i + 1
    }
    heap_free(occ as *mut i8)
    heap_free(hk as *mut i8)
    heap_free(hm as *mut i8)
    out
}

/// Per-group running minimum of `val_col`, aligned to input row order (like pandas
/// groupby(key)[val].cummin()). One pass with an open-addressing table mapping key ->
/// running min. Returns a 1-column BigFrame of length n. O(n) expected. NATIVE +
/// lean_single only (heap).
pub fn bf_cummin_by(src: &BigFrame, key_col: i64, val_col: i64) -> BigFrame with Alloc, Mut, Div, Panic {
    let n = bf_nrows(src)
    let nc = bf_ncols(src)
    if key_col < 0 || key_col >= nc || val_col < 0 || val_col >= nc || n <= 0 { return bf_new(1, 1) }
    var size: i64 = 16
    while size < n + n { size = size * 2 }
    let mask = size - 1
    let occ = heap_alloc(size * 8) as *mut f64
    let hk  = heap_alloc(size * 8) as *mut f64
    let hm  = heap_alloc(size * 8) as *mut f64   // running min per key
    let kp = bf_col_ptr(src, key_col) as *mut f64
    let vp = bf_col_ptr(src, val_col) as *mut f64
    var out = bf_new(1, n)
    out.n_rows = n
    let op = bf_col_ptr(&out, 0) as *mut f64
    var i: i64 = 0
    while i < n {
        let k = read_f64(kp, i)
        let v = read_f64(vp, i)
        var slot = bf_ghash(k, mask)
        var done = false
        while !done {
            if read_f64(occ, slot) == 0.0 {
                write_f64(occ, slot, 1.0)
                write_f64(hk, slot, k)
                write_f64(hm, slot, v)
                write_f64(op, i, v)
                done = true
            } else {
                if read_f64(hk, slot) == k {
                    var m = read_f64(hm, slot)
                    if v < m { m = v }
                    write_f64(hm, slot, m)
                    write_f64(op, i, m)
                    done = true
                } else {
                    slot = (slot + 1) & mask
                }
            }
        }
        i = i + 1
    }
    heap_free(occ as *mut i8)
    heap_free(hk as *mut i8)
    heap_free(hm as *mut i8)
    out
}

/// Rolling (sliding-window) sum of column `col` over a fixed `window`: out[i] = the
/// sum of col[i-window+1 .. i] (like pandas col.rolling(window).sum()). The first
/// window-1 rows have an incomplete window and get `fill` (pass make_nan() for pandas
/// NaN, or any sentinel). O(n) via a running accumulator that adds the entering value
/// and subtracts the leaving one. NOTE: the sliding add/subtract carries f64 rounding
/// like any online window sum; for exactness use integer-valued data. NATIVE +
/// lean_single only (heap).
pub fn bf_rolling_sum(src: &BigFrame, col: i64, window: i64, fill: f64) -> BigFrame with Alloc, Mut, Div, Panic {
    let n = bf_nrows(src)
    if col < 0 || col >= bf_ncols(src) || n <= 0 || window <= 0 { return bf_new(1, 1) }
    var out = bf_new(1, n)
    out.n_rows = n
    let sp = bf_col_ptr(src, col) as *mut f64
    let op = bf_col_ptr(&out, 0) as *mut f64
    var acc = 0.0
    var i: i64 = 0
    while i < n {
        acc = acc + read_f64(sp, i)
        if i >= window { acc = acc - read_f64(sp, i - window) }
        if i >= window - 1 { write_f64(op, i, acc) } else { write_f64(op, i, fill) }
        i = i + 1
    }
    out
}

/// Rolling (sliding-window) mean of column `col` (like pandas col.rolling(window)
/// .mean()): the rolling sum divided by `window`, with the first window-1 rows set to
/// `fill`. O(n). Same f64-rounding note as bf_rolling_sum. NATIVE + lean_single only.
pub fn bf_rolling_mean(src: &BigFrame, col: i64, window: i64, fill: f64) -> BigFrame with Alloc, Mut, Div, Panic {
    let n = bf_nrows(src)
    if col < 0 || col >= bf_ncols(src) || n <= 0 || window <= 0 { return bf_new(1, 1) }
    var out = bf_new(1, n)
    out.n_rows = n
    let sp = bf_col_ptr(src, col) as *mut f64
    let op = bf_col_ptr(&out, 0) as *mut f64
    let wf = window as f64
    var acc = 0.0
    var i: i64 = 0
    while i < n {
        acc = acc + read_f64(sp, i)
        if i >= window { acc = acc - read_f64(sp, i - window) }
        if i >= window - 1 { write_f64(op, i, acc / wf) } else { write_f64(op, i, fill) }
        i = i + 1
    }
    out
}

/// Rolling (sliding-window) maximum of column `col` (like pandas col.rolling(window)
/// .max()): out[i] = max(col[i-window+1 .. i]), first window-1 rows = `fill`. O(n)
/// via a MONOTONIC DEQUE of indices whose values decrease front-to-back, so the front
/// is always the window max; each index is pushed and popped at most once. NATIVE +
/// lean_single only (heap).
pub fn bf_rolling_max(src: &BigFrame, col: i64, window: i64, fill: f64) -> BigFrame with Alloc, Mut, Div, Panic {
    let n = bf_nrows(src)
    if col < 0 || col >= bf_ncols(src) || n <= 0 || window <= 0 { return bf_new(1, 1) }
    var out = bf_new(1, n)
    out.n_rows = n
    let sp = bf_col_ptr(src, col) as *mut f64
    let op = bf_col_ptr(&out, 0) as *mut f64
    let dq = heap_alloc(n * 8) as *mut i64   // indices; values decreasing front->back
    var head: i64 = 0
    var tail: i64 = 0                        // deque occupies [head, tail)
    var i: i64 = 0
    while i < n {
        let v = read_f64(sp, i)
        while tail > head && read_f64(sp, read_i64(dq, tail - 1)) <= v { tail = tail - 1 }  // pop smaller-or-equal from back
        write_i64(dq, tail, i)
        tail = tail + 1
        if read_i64(dq, head) <= i - window { head = head + 1 }                             // drop out-of-window front
        if i >= window - 1 {
            write_f64(op, i, read_f64(sp, read_i64(dq, head)))
        } else {
            write_f64(op, i, fill)
        }
        i = i + 1
    }
    heap_free(dq as *mut i8)
    out
}

/// Rolling (sliding-window) minimum of column `col` (like pandas col.rolling(window)
/// .min()): out[i] = min(col[i-window+1 .. i]), first window-1 rows = `fill`. O(n) via
/// a monotonic deque whose values INCREASE front-to-back (front = window min). NATIVE
/// + lean_single only (heap).
pub fn bf_rolling_min(src: &BigFrame, col: i64, window: i64, fill: f64) -> BigFrame with Alloc, Mut, Div, Panic {
    let n = bf_nrows(src)
    if col < 0 || col >= bf_ncols(src) || n <= 0 || window <= 0 { return bf_new(1, 1) }
    var out = bf_new(1, n)
    out.n_rows = n
    let sp = bf_col_ptr(src, col) as *mut f64
    let op = bf_col_ptr(&out, 0) as *mut f64
    let dq = heap_alloc(n * 8) as *mut i64
    var head: i64 = 0
    var tail: i64 = 0
    var i: i64 = 0
    while i < n {
        let v = read_f64(sp, i)
        while tail > head && read_f64(sp, read_i64(dq, tail - 1)) >= v { tail = tail - 1 }  // pop larger-or-equal from back
        write_i64(dq, tail, i)
        tail = tail + 1
        if read_i64(dq, head) <= i - window { head = head + 1 }
        if i >= window - 1 {
            write_f64(op, i, read_f64(sp, read_i64(dq, head)))
        } else {
            write_f64(op, i, fill)
        }
        i = i + 1
    }
    heap_free(dq as *mut i8)
    out
}

/// Shift column `col` by `periods` rows: out[i] = col[i - periods] where in range,
/// else `fill` (like pandas col.shift(periods)). `periods` may be negative (shift up).
/// O(n). NOTE: this is a memory move; pandas lowers shift to a near-memcpy, so until a
/// mem_copy builtin is exposed (dispatch #1179) Sounio's per-element copy trails it.
/// First/last |periods| rows take `fill` (pass make_nan() for pandas NaN). NATIVE +
/// lean_single only (heap).
pub fn bf_shift(src: &BigFrame, col: i64, periods: i64, fill: f64) -> BigFrame with Alloc, Mut, Div, Panic {
    let n = bf_nrows(src)
    if col < 0 || col >= bf_ncols(src) || n <= 0 { return bf_new(1, 1) }
    var out = bf_new(1, n)
    out.n_rows = n
    let sp = bf_col_ptr(src, col) as *mut f64
    let op = bf_col_ptr(&out, 0) as *mut f64
    var i: i64 = 0
    while i < n {
        let j = i - periods
        if j >= 0 && j < n { write_f64(op, i, read_f64(sp, j)) } else { write_f64(op, i, fill) }
        i = i + 1
    }
    out
}

/// Discrete difference of column `col`: out[i] = col[i] - col[i - periods] where in
/// range, else `fill` (like pandas col.diff(periods)). `periods` may be negative. O(n).
/// NOTE: pandas lowers diff to a vectorized SIMD subtract; Sounio's scalar per-element
/// subtract trails it until SIMD codegen (C3) lands. First/last |periods| rows take
/// `fill`. NATIVE + lean_single only (heap).
pub fn bf_diff(src: &BigFrame, col: i64, periods: i64, fill: f64) -> BigFrame with Alloc, Mut, Div, Panic {
    let n = bf_nrows(src)
    if col < 0 || col >= bf_ncols(src) || n <= 0 { return bf_new(1, 1) }
    var out = bf_new(1, n)
    out.n_rows = n
    let sp = bf_col_ptr(src, col) as *mut f64
    let op = bf_col_ptr(&out, 0) as *mut f64
    var i: i64 = 0
    while i < n {
        let j = i - periods
        if j >= 0 && j < n { write_f64(op, i, read_f64(sp, i) - read_f64(sp, j)) } else { write_f64(op, i, fill) }
        i = i + 1
    }
    out
}

/// Fractional change of column `col` between consecutive rows: out[i] = (col[i] -
/// col[i-1]) / col[i-1] (like pandas col.pct_change()). Row 0 takes `fill`. A zero
/// prior value yields inf/nan (as in pandas). O(n) single pass. NATIVE + lean_single
/// only (heap).
pub fn bf_pct_change(src: &BigFrame, col: i64, fill: f64) -> BigFrame with Alloc, Mut, Div, Panic {
    let n = bf_nrows(src)
    if col < 0 || col >= bf_ncols(src) || n <= 0 { return bf_new(1, 1) }
    var out = bf_new(1, n)
    out.n_rows = n
    let sp = bf_col_ptr(src, col) as *mut f64
    let op = bf_col_ptr(&out, 0) as *mut f64
    var i: i64 = 0
    while i < n {
        if i >= 1 {
            let prev = read_f64(sp, i - 1)
            write_f64(op, i, (read_f64(sp, i) - prev) / prev)
        } else {
            write_f64(op, i, fill)
        }
        i = i + 1
    }
    out
}

/// Exponentially weighted moving mean of column `col` with smoothing factor `alpha`
/// in (0,1] (like pandas col.ewm(alpha=..).mean()). A single-pass recurrence with
/// beta = 1 - alpha. When `adjust` is true (pandas' default) it uses the ramp-up
/// form -- running weighted sum num = x + beta*num over normalizer den = 1 + beta*den,
/// out = num/den -- so early rows are correctly normalized by the partial weight mass.
/// When `adjust` is false it uses the plain recursion out[i] = beta*out[i-1] +
/// alpha*x[i] (out[0] = x[0]). O(n). Both modes match pandas bit-for-close.
/// NATIVE + lean_single only (heap).
pub fn bf_ewm_mean(src: &BigFrame, col: i64, alpha: f64, adjust: bool) -> BigFrame with Alloc, Mut, Div, Panic {
    let n = bf_nrows(src)
    if col < 0 || col >= bf_ncols(src) || n <= 0 { return bf_new(1, 1) }
    var out = bf_new(1, n)
    out.n_rows = n
    let sp = bf_col_ptr(src, col) as *mut f64
    let op = bf_col_ptr(&out, 0) as *mut f64
    let beta = 1.0 - alpha
    if adjust {
        var num = 0.0
        var den = 0.0
        var i: i64 = 0
        while i < n {
            let x = read_f64(sp, i)
            num = x + beta * num
            den = 1.0 + beta * den
            write_f64(op, i, num / den)
            i = i + 1
        }
    } else {
        var y = 0.0
        var i: i64 = 0
        while i < n {
            let x = read_f64(sp, i)
            if i == 0 { y = x } else { y = beta * y + alpha * x }
            write_f64(op, i, y)
            i = i + 1
        }
    }
    out
}
