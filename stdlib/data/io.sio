// stdlib/data/io.sio
// CSV parsing utilities for fixed arrays
//
// Simple CSV field parsing and float conversion.

// Check if a byte is a digit (ASCII 0-9)
fn io_is_digit(b: i64) -> i64 {
    if b >= 48 {
        if b <= 57 { return 1 }
    }
    return 0
}

// Parse a float from a fixed byte buffer
// buf: ASCII bytes, len: number of valid bytes
// Returns parsed f64 value
fn io_parse_float(buf: [u8; 64], len: i64) -> f64 {
    if len == 0 { return 0.0 }

    var result = 0.0
    var decimal_part = 0.0
    var decimal_divisor = 1.0
    var is_negative = 0
    var in_decimal = 0
    var i: i64 = 0

    // Skip leading whitespace
    while i < len {
        let b = buf[i] as i64
        if b != 32 {
            if b != 9 { break }
        }
        i = i + 1
    }

    // Check sign
    if i < len {
        let b = buf[i] as i64
        if b == 45 {
            is_negative = 1
            i = i + 1
        } else if b == 43 {
            i = i + 1
        }
    }

    while i < len {
        let b = buf[i] as i64
        if b == 46 {
            in_decimal = 1
        } else if io_is_digit(b) == 1 {
            let digit = (b - 48) as f64
            if in_decimal == 1 {
                decimal_divisor = decimal_divisor * 10.0
                decimal_part = decimal_part + digit / decimal_divisor
            } else {
                result = result * 10.0 + digit
            }
        }
        i = i + 1
    }

    result = result + decimal_part
    if is_negative == 1 {
        result = 0.0 - result
    }
    return result
}

// Check if a byte buffer contains only numeric characters
fn io_is_numeric(buf: [u8; 64], len: i64) -> i64 {
    if len == 0 { return 0 }
    var has_digit = 0
    var has_dot = 0
    var i: i64 = 0

    // Skip whitespace
    while i < len {
        let b = buf[i] as i64
        if b != 32 {
            if b != 9 { break }
        }
        i = i + 1
    }

    while i < len {
        let b = buf[i] as i64
        if b == 45 {
            if i != 0 { return 0 }
        } else if b == 43 {
            if i != 0 { return 0 }
        } else if b == 46 {
            if has_dot == 1 { return 0 }
            has_dot = 1
        } else if io_is_digit(b) == 1 {
            has_digit = 1
        } else if b == 32 {
            break
        } else if b == 9 {
            break
        } else {
            return 0
        }
        i = i + 1
    }
    return has_digit
}

// Count comma-separated fields in a line buffer
fn io_count_fields(buf: [u8; 256], len: i64) -> i64 {
    if len == 0 { return 0 }
    var count: i64 = 1
    var i: i64 = 0
    while i < len {
        if buf[i] as i64 == 44 {
            count = count + 1
        }
        i = i + 1
    }
    return count
}
