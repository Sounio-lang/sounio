use text::format::{i64_to_str}
// stdlib/data/frame.d
// DataFrame - Tabular Data with Epistemic Integration
//
// A DataFrame holds named columns of different types. This implementation
// uses a type-erased column approach where each column is stored separately.

extern "C" {
    fn sqrt(x: f64) -> f64;
}

fn frm_sqrt_f64(x: f64) -> f64 {
    if x < 0.0 { return 0.0 }
    return sqrt(x)
}

// ============================================================================
// COLUMN TYPE - Type-erased column storage
// ============================================================================

// Column types: 0=Float, 1=Int, 2=string, 3=Bool, 4=Epistemic
pub struct Column {
    pub name: string,
    pub dtype: i32,           // Type discriminator
    pub float_data: [f64],
    pub int_data: [i64],
    pub string_data: [string],
    pub bool_data: [bool],
    // Epistemic data
    pub uncert_data: [f64],   // Uncertainties (for epistemic)
    pub conf_data: [f64],     // Confidences (for epistemic)
}

// Typed array-value helpers keep field receivers on the ordinary array carrier.
// No array header layout or size cap is exposed here.
fn frame_f64_len(data:[f64])->usize {data.len()}
fn frame_i64_len(data:[i64])->usize {data.len()}
fn frame_string_len(data:[string])->usize {data.len()}
fn frame_bool_len(data:[bool])->usize {data.len()}
fn frame_column_len(data:[Column])->usize {data.len()}

pub fn column_float(name: string, data: [f64]) -> Column {
    var empty_i: [i64] = []
    var empty_s: [string] = []
    var empty_b: [bool] = []
    var empty_u: [f64] = []
    var empty_c: [f64] = []
    Column {
        name: name,
        dtype: 0,
        float_data: data,
        int_data: empty_i,
        string_data: empty_s,
        bool_data: empty_b,
        uncert_data: empty_u,
        conf_data: empty_c,
    }
}

pub fn column_int(name: string, data: [i64]) -> Column {
    var empty_f: [f64] = []
    var empty_s: [string] = []
    var empty_b: [bool] = []
    var empty_u: [f64] = []
    var empty_c: [f64] = []
    Column {
        name: name,
        dtype: 1,
        float_data: empty_f,
        int_data: data,
        string_data: empty_s,
        bool_data: empty_b,
        uncert_data: empty_u,
        conf_data: empty_c,
    }
}

pub fn column_string(name: string, data: [string]) -> Column {
    var empty_f: [f64] = []
    var empty_i: [i64] = []
    var empty_b: [bool] = []
    var empty_u: [f64] = []
    var empty_c: [f64] = []
    Column {
        name: name,
        dtype: 2,
        float_data: empty_f,
        int_data: empty_i,
        string_data: data,
        bool_data: empty_b,
        uncert_data: empty_u,
        conf_data: empty_c,
    }
}

pub fn column_bool(name: string, data: [bool]) -> Column {
    var empty_f: [f64] = []
    var empty_i: [i64] = []
    var empty_s: [string] = []
    var empty_u: [f64] = []
    var empty_c: [f64] = []
    Column {
        name: name,
        dtype: 3,
        float_data: empty_f,
        int_data: empty_i,
        string_data: empty_s,
        bool_data: data,
        uncert_data: empty_u,
        conf_data: empty_c,
    }
}

pub fn column_epistemic(name: string, values: [f64], uncerts: [f64], confs: [f64]) -> Column {
    var empty_i: [i64] = []
    var empty_s: [string] = []
    var empty_b: [bool] = []
    Column {
        name: name,
        dtype: 4,
        float_data: values,
        int_data: empty_i,
        string_data: empty_s,
        bool_data: empty_b,
        uncert_data: uncerts,
        conf_data: confs,
    }
}

pub fn column_len(col: Column) -> usize {
    if col.dtype == 0 { return frame_f64_len(col.float_data) }
    if col.dtype == 1 { return frame_i64_len(col.int_data) }
    if col.dtype == 2 { return frame_string_len(col.string_data) }
    if col.dtype == 3 { return frame_bool_len(col.bool_data) }
    if col.dtype == 4 { return frame_f64_len(col.float_data) }
    0
}

pub fn column_dtype_str(col: Column) -> string {
    if col.dtype == 0 { return "float" }
    if col.dtype == 1 { return "int" }
    if col.dtype == 2 { return "string" }
    if col.dtype == 3 { return "bool" }
    if col.dtype == 4 { return "epistemic" }
    "unknown"
}

pub fn column_is_numeric(col: Column) -> bool {
    col.dtype == 0 || col.dtype == 1 || col.dtype == 4
}

// ============================================================================
// DATAFRAME TYPE
// ============================================================================

pub struct DataFrame {
    pub columns: [Column],
    pub index_name: string,
}

pub fn dataframe_new() -> DataFrame {
    var empty: [Column] = []
    DataFrame { columns: empty, index_name: "" }
}

pub fn dataframe_ncols(df: DataFrame) -> usize {
    frame_column_len(df.columns)
}

pub fn dataframe_nrows(df: DataFrame) -> usize {
    if frame_column_len(df.columns) == 0 { return 0 }
    column_len(df.columns[0])
}

pub fn dataframe_shape(df: DataFrame) -> (usize, usize) {
    (dataframe_nrows(df), dataframe_ncols(df))
}

pub fn dataframe_add_column(df: DataFrame, col: Column) -> DataFrame {
    var cols = df.columns
    cols = cols ++ [col]
    DataFrame { columns: cols, index_name: df.index_name }
}

pub fn dataframe_column_names(df: DataFrame) -> [string] {
    var names: [string] = []
    var i: usize = 0
    while i < frame_column_len(df.columns) {
        names = names ++ [df.columns[i].name]
        i = i + 1
    }
    names
}

// Get column by name
pub fn dataframe_get_column(df: DataFrame, name: string) -> Column {
    var i: usize = 0
    while i < frame_column_len(df.columns) {
        if df.columns[i].name == name {
            return df.columns[i]
        }
        i = i + 1
    }
    // Return empty column if not found
    var empty: [f64] = []
    column_float("", empty)
}

// Get column by index
pub fn dataframe_get_column_idx(df: DataFrame, idx: usize) -> Column {
    if idx < frame_column_len(df.columns) {
        return df.columns[idx]
    }
    var empty: [f64] = []
    column_float("", empty)
}

// Check if column exists
pub fn dataframe_has_column(df: DataFrame, name: string) -> bool {
    var i: usize = 0
    while i < frame_column_len(df.columns) {
        if df.columns[i].name == name {
            return true
        }
        i = i + 1
    }
    false
}

// Drop column by name
pub fn dataframe_drop_column(df: DataFrame, name: string) -> DataFrame {
    var new_cols: [Column] = []
    var i: usize = 0
    while i < frame_column_len(df.columns) {
        if df.columns[i].name != name {
            new_cols = new_cols ++ [df.columns[i]]
        }
        i = i + 1
    }
    DataFrame { columns: new_cols, index_name: df.index_name }
}

// ============================================================================
// ROW ACCESS
// ============================================================================

pub struct Row {
    pub column_names: [string],
    pub float_values: [f64],
    pub int_values: [i64],
    pub string_values: [string],
    pub bool_values: [bool],
    pub dtypes: [i32],
}

pub fn dataframe_get_row(df: DataFrame, row_idx: usize) -> Row {
    var names: [string] = []
    var floats: [f64] = []
    var ints: [i64] = []
    var strings: [string] = []
    var bools: [bool] = []
    var types: [i32] = []

    var i: usize = 0
    while i < frame_column_len(df.columns) {
        let col = df.columns[i]
        names = names ++ [col.name]
        types = types ++ [col.dtype]
        if col.dtype == 0 {
            if row_idx < frame_f64_len(col.float_data) {
                floats = floats ++ [col.float_data[row_idx]]
            } else {
                floats = floats ++ [0.0]
            }
            ints = ints ++ [0]
            strings = strings ++ [""]
            bools = bools ++ [false]
        } else if col.dtype == 1 {
            floats = floats ++ [0.0]
            if row_idx < frame_i64_len(col.int_data) {
                ints = ints ++ [col.int_data[row_idx]]
            } else {
                ints = ints ++ [0]
            }
            strings = strings ++ [""]
            bools = bools ++ [false]
        } else if col.dtype == 2 {
            floats = floats ++ [0.0]
            ints = ints ++ [0]
            if row_idx < frame_string_len(col.string_data) {
                strings = strings ++ [col.string_data[row_idx]]
            } else {
                strings = strings ++ [""]
            }
            bools = bools ++ [false]
        } else if col.dtype == 3 {
            floats = floats ++ [0.0]
            ints = ints ++ [0]
            strings = strings ++ [""]
            if row_idx < frame_bool_len(col.bool_data) {
                bools = bools ++ [col.bool_data[row_idx]]
            } else {
                bools = bools ++ [false]
            }
        } else if col.dtype == 4 {
            // Epistemic: return value as float
            if row_idx < frame_f64_len(col.float_data) {
                floats = floats ++ [col.float_data[row_idx]]
            } else {
                floats = floats ++ [0.0]
            }
            ints = ints ++ [0]
            strings = strings ++ [""]
            bools = bools ++ [false]
        }

        i = i + 1
    }

    Row {
        column_names: names,
        float_values: floats,
        int_values: ints,
        string_values: strings,
        bool_values: bools,
        dtypes: types,
    }
}

// Get float value from row by column name
pub fn row_get_float(row: Row, col_name: string) -> f64 {
    var i: usize = 0
    while i < frame_string_len(row.column_names) {
        if row.column_names[i] == col_name {
            return row.float_values[i]
        }
        i = i + 1
    }
    0.0
}

// Get string value from row by column name
pub fn row_get_string(row: Row, col_name: string) -> string {
    var i: usize = 0
    while i < frame_string_len(row.column_names) {
        if row.column_names[i] == col_name {
            return row.string_values[i]
        }
        i = i + 1
    }
    ""
}

// ============================================================================
// SLICING / FILTERING
// ============================================================================

// Get rows by range [start, end)
pub fn dataframe_slice(df: DataFrame, start: usize, end: usize) -> DataFrame {
    var new_cols: [Column] = []
    var i: usize = 0

    while i < frame_column_len(df.columns) {
        let col = df.columns[i]

        if col.dtype == 0 {
            var new_data: [f64] = []
            var j = start
            while j < end && j < frame_f64_len(col.float_data) {
                new_data = new_data ++ [col.float_data[j]]
                j = j + 1
            }
            new_cols = new_cols ++ [column_float(col.name, new_data)]
        } else if col.dtype == 1 {
            var new_data: [i64] = []
            var j = start
            while j < end && j < frame_i64_len(col.int_data) {
                new_data = new_data ++ [col.int_data[j]]
                j = j + 1
            }
            new_cols = new_cols ++ [column_int(col.name, new_data)]
        } else if col.dtype == 2 {
            var new_data: [string] = []
            var j = start
            while j < end && j < frame_string_len(col.string_data) {
                new_data = new_data ++ [col.string_data[j]]
                j = j + 1
            }
            new_cols = new_cols ++ [column_string(col.name, new_data)]
        } else if col.dtype == 3 {
            var new_data: [bool] = []
            var j = start
            while j < end && j < frame_bool_len(col.bool_data) {
                new_data = new_data ++ [col.bool_data[j]]
                j = j + 1
            }
            new_cols = new_cols ++ [column_bool(col.name, new_data)]
        } else if col.dtype == 4 {
            var vals: [f64] = []
            var uncerts: [f64] = []
            var confs: [f64] = []
            var j = start
            while j < end && j < frame_f64_len(col.float_data) {
                vals = vals ++ [col.float_data[j]]
                uncerts = uncerts ++ [col.uncert_data[j]]
                confs = confs ++ [col.conf_data[j]]
                j = j + 1
            }
            new_cols = new_cols ++ [column_epistemic(col.name, vals, uncerts, confs)]
        }

        i = i + 1
    }

    DataFrame { columns: new_cols, index_name: df.index_name }
}

// Head - first n rows
pub fn dataframe_head(df: DataFrame, n: usize) -> DataFrame {
    dataframe_slice(df, 0, n)
}

// Tail - last n rows
pub fn dataframe_tail(df: DataFrame, n: usize) -> DataFrame {
    let nrows = dataframe_nrows(df)
    if n >= nrows {
        return df
    }
    dataframe_slice(df, nrows - n, nrows)
}

// Filter by boolean mask
pub fn dataframe_filter(df: DataFrame, mask: [bool]) -> DataFrame {
    var new_cols: [Column] = []
    var i: usize = 0

    while i < frame_column_len(df.columns) {
        let col = df.columns[i]

        if col.dtype == 0 {
            var new_data: [f64] = []
            var j: usize = 0
            while j < frame_f64_len(col.float_data) && j < mask.len() {
                if mask[j] {
                    new_data = new_data ++ [col.float_data[j]]
                }
                j = j + 1
            }
            new_cols = new_cols ++ [column_float(col.name, new_data)]
        } else if col.dtype == 1 {
            var new_data: [i64] = []
            var j: usize = 0
            while j < frame_i64_len(col.int_data) && j < mask.len() {
                if mask[j] {
                    new_data = new_data ++ [col.int_data[j]]
                }
                j = j + 1
            }
            new_cols = new_cols ++ [column_int(col.name, new_data)]
        } else if col.dtype == 2 {
            var new_data: [string] = []
            var j: usize = 0
            while j < frame_string_len(col.string_data) && j < mask.len() {
                if mask[j] {
                    new_data = new_data ++ [col.string_data[j]]
                }
                j = j + 1
            }
            new_cols = new_cols ++ [column_string(col.name, new_data)]
        } else if col.dtype == 3 {
            var new_data: [bool] = []
            var j: usize = 0
            while j < frame_bool_len(col.bool_data) && j < mask.len() {
                if mask[j] {
                    new_data = new_data ++ [col.bool_data[j]]
                }
                j = j + 1
            }
            new_cols = new_cols ++ [column_bool(col.name, new_data)]
        } else if col.dtype == 4 {
            var vals: [f64] = []
            var uncerts: [f64] = []
            var confs: [f64] = []
            var j: usize = 0
            while j < frame_f64_len(col.float_data) && j < mask.len() {
                if mask[j] {
                    vals = vals ++ [col.float_data[j]]
                    uncerts = uncerts ++ [col.uncert_data[j]]
                    confs = confs ++ [col.conf_data[j]]
                }
                j = j + 1
            }
            new_cols = new_cols ++ [column_epistemic(col.name, vals, uncerts, confs)]
        }

        i = i + 1
    }

    DataFrame { columns: new_cols, index_name: df.index_name }
}

// ============================================================================
// COLUMN OPERATIONS
// ============================================================================

// Sum of numeric column
pub fn dataframe_col_sum(df: DataFrame, col_name: string) -> f64 {
    let col = dataframe_get_column(df, col_name)
    if col.dtype == 0 {
        var total = 0.0
        var i: usize = 0
        while i < frame_f64_len(col.float_data) {
            total = total + col.float_data[i]
            i = i + 1
        }
        return total
    }
    if col.dtype == 1 {
        var total: i64 = 0
        var i: usize = 0
        while i < frame_i64_len(col.int_data) {
            total = total + col.int_data[i]
            i = i + 1
        }
        return total as f64
    }
    if col.dtype == 4 {
        var total = 0.0
        var i: usize = 0
        while i < frame_f64_len(col.float_data) {
            total = total + col.float_data[i]
            i = i + 1
        }
        return total
    }
    0.0
}

// Mean of numeric column
pub fn dataframe_col_mean(df: DataFrame, col_name: string) -> f64 {
    let col = dataframe_get_column(df, col_name)
    let n = column_len(col)
    if n == 0 { return 0.0 }
    dataframe_col_sum(df, col_name) / (n as f64)
}

// Epistemic mean of epistemic column (with uncertainty propagation)
pub struct EpistemicResult {
    pub value: f64,
    pub uncertainty: f64,
    pub confidence: f64,
}

pub fn dataframe_col_mean_epistemic(df: DataFrame, col_name: string) -> EpistemicResult {
    let col = dataframe_get_column(df, col_name)
    let n = frame_f64_len(col.float_data)

    if n == 0 || col.dtype != 4 {
        return EpistemicResult { value: 0.0, uncertainty: 0.0, confidence: 0.0 }
    }

    // Calculate mean
    var sum_val = 0.0
    var i: usize = 0
    while i < n {
        sum_val = sum_val + col.float_data[i]
        i = i + 1
    }
    let mean_val = sum_val / (n as f64)

    // GUM: u(mean)^2 = (1/n^2) * sum(u_i^2)
    var sum_u_sq = 0.0
    i = 0
    while i < n {
        let ui = col.uncert_data[i]
        sum_u_sq = sum_u_sq + ui * ui
        i = i + 1
    }
    let mean_u = frm_sqrt_f64(sum_u_sq) / (n as f64)

    // Minimum confidence
    var min_conf = 1.0
    i = 0
    while i < n {
        if col.conf_data[i] < min_conf {
            min_conf = col.conf_data[i]
        }
        i = i + 1
    }

    EpistemicResult { value: mean_val, uncertainty: mean_u, confidence: min_conf }
}

// ============================================================================
// DISPLAY
// ============================================================================

pub fn dataframe_info(df: DataFrame) -> string with Mut,Panic,Div {
    let shape = dataframe_shape(df)
    var result = "DataFrame: " ++ i64_to_str(shape.0 as i64) ++ " rows x " ++ i64_to_str(shape.1 as i64) ++ " columns\n"
    result = result ++ "Columns:\n"

    var i: usize = 0
    while i < frame_column_len(df.columns) {
        let col = df.columns[i]
        result = result ++ "  " ++ col.name ++ " (" ++ column_dtype_str(col) ++ ")\n"
        i = i + 1
    }
    result
}

// ============================================================================
// TESTS
