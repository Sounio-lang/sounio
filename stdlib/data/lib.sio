// data — Tabular data structures with epistemic integration
//
// DataFrame and Series types for data analysis, CSV loading for
// network/graph data, and array-level groupby/rolling/cumulative operations.
//
// Submodules:
//   frame      — DataFrame with named columns (float, int, string, bool, epistemic)
//   series     — Typed Series (FloatSeries, IntSeries, StringSeries, BoolSeries, EpistemicSeries)
//   csv_loader — Network graph CSV loading (edge list format)
//   ops        — Fixed-array groupby, cumulative sum/max, rolling mean/std
//   io         — Low-level CSV field parsing and float conversion

pub use frame::{
    Column, DataFrame, Row, EpistemicResult,
    column_float, column_int, column_string, column_bool, column_epistemic,
    column_len, column_dtype_str, column_is_numeric,
    dataframe_new, dataframe_ncols, dataframe_nrows, dataframe_shape,
    dataframe_add_column, dataframe_column_names, dataframe_get_column,
    dataframe_get_column_idx, dataframe_has_column, dataframe_drop_column,
    dataframe_get_row, dataframe_slice, dataframe_head, dataframe_tail,
    dataframe_filter, dataframe_col_sum, dataframe_col_mean,
    dataframe_col_mean_epistemic, dataframe_info,
    row_get_float, row_get_string,
}

pub use series::{
    Uncertainty, EpistemicValue,
    FloatSeries, IntSeries, StringSeries, BoolSeries, EpistemicSeries,
    uncertainty_exact, uncertainty_std, uncertainty_interval, uncert_to_std,
    epistemic_std, epistemic_exact, get_value, get_conf, get_std_u,
    float_series_new, float_series_from, float_series_len, float_series_get,
    float_series_push, float_series_sum, float_series_mean,
    float_series_min, float_series_max, float_series_variance, float_series_std,
    float_series_add, float_series_mul, float_series_scale,
    float_series_filter, float_series_gt, float_series_lt,
    int_series_new, int_series_from, int_series_len, int_series_get,
    int_series_push, int_series_sum, int_series_to_float,
    string_series_new, string_series_from, string_series_len, string_series_get, string_series_push,
    bool_series_new, bool_series_from, bool_series_len, bool_series_get, bool_series_count_true,
    epistemic_series_new, epistemic_series_len, epistemic_series_get,
    epistemic_series_push, epistemic_series_push_with_u,
    epistemic_series_mean, epistemic_series_sum, epistemic_series_std,
    epistemic_series_min, epistemic_series_max,
    float_to_epistemic, epistemic_to_float,
}

pub use csv_loader::{
    Edge, WeightedEdge, NetworkData,
    parse_edge_list, load_edge_list,
    to_adjacency_list, to_weighted_adjacency, validate_edge_list,
}
