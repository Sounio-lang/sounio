{
  "ontology": "ALG",
  "version": "fixture-2026.03",
  "terms": [
    {
      "curie": "ALG:0000001",
      "label": "Algebra",
      "definition": "The study of mathematical symbols and the rules for manipulating these symbols.",
      "parents": [],
      "synonyms": [],
      "iri": "https://sounio.org/ontology/ALG_0000001"
    },
    {
      "curie": "ALG:0000002",
      "label": "Group",
      "definition": "A set equipped with an operation that combines any two elements to form a third element while satisfying four axioms: closure, associativity, identity, and invertibility.",
      "parents": [
        "ALG:0000001"
      ],
      "synonyms": [
        "Algebraic group"
      ],
      "iri": "https://sounio.org/ontology/ALG_0000002"
    },
    {
      "curie": "ALG:0000003",
      "label": "Abelian group",
      "definition": "A group in which the binary operation is commutative.",
      "parents": [
        "ALG:0000002"
      ],
      "synonyms": [
        "Commutative group"
      ],
      "iri": "https://sounio.org/ontology/ALG_0000003"
    },
    {
      "curie": "ALG:0000004",
      "label": "Cyclic group",
      "definition": "A group that is generated by a single element.",
      "parents": [
        "ALG:0000002"
      ],
      "synonyms": [],
      "iri": "https://sounio.org/ontology/ALG_0000004"
    },
    {
      "curie": "ALG:0000005",
      "label": "Ring",
      "definition": "A set equipped with two binary operations, usually called addition and multiplication, satisfying certain axioms.",
      "parents": [
        "ALG:0000001"
      ],
      "synonyms": [],
      "iri": "https://sounio.org/ontology/ALG_0000005"
    },
    {
      "curie": "ALG:0000006",
      "label": "Field",
      "definition": "A ring in which the nonzero elements form an abelian group under multiplication.",
      "parents": [
        "ALG:0000005"
      ],
      "synonyms": [],
      "iri": "https://sounio.org/ontology/ALG_0000006"
    },
    {
      "curie": "ALG:0000007",
      "label": "Vector space",
      "definition": "A collection of objects called vectors, which may be added together and multiplied by scalars.",
      "parents": [
        "ALG:0000001"
      ],
      "synonyms": [
        "Linear space"
      ],
      "iri": "https://sounio.org/ontology/ALG_0000007"
    },
    {
      "curie": "ALG:0000008",
      "label": "Inner product space",
      "definition": "A vector space with an additional structure called an inner product.",
      "parents": [
        "ALG:0000007"
      ],
      "synonyms": [],
      "iri": "https://sounio.org/ontology/ALG_0000008"
    },
    {
      "curie": "ALG:0000009",
      "label": "Hilbert space",
      "definition": "A complete inner product space, typically infinite-dimensional.",
      "parents": [
        "ALG:0000008"
      ],
      "synonyms": [],
      "iri": "https://sounio.org/ontology/ALG_0000009"
    },
    {
      "curie": "ALG:0000010",
      "label": "Linear operator",
      "definition": "A mapping between two vector spaces that preserves the operations of vector addition and scalar multiplication.",
      "parents": [
        "ALG:0000007"
      ],
      "synonyms": [
        "Linear map",
        "Linear transformation"
      ],
      "iri": "https://sounio.org/ontology/ALG_0000010"
    },
    {
      "curie": "ALG:0000011",
      "label": "Matrix",
      "definition": "A rectangular array of numbers, symbols, or expressions arranged in rows and columns.",
      "parents": [
        "ALG:0000001"
      ],
      "synonyms": [],
      "iri": "https://sounio.org/ontology/ALG_0000011"
    },
    {
      "curie": "ALG:0000012",
      "label": "Eigenvalue",
      "definition": "A scalar such that there exists a nonzero vector which, when multiplied by a matrix, is scaled by that scalar.",
      "parents": [
        "ALG:0000011"
      ],
      "synonyms": [],
      "iri": "https://sounio.org/ontology/ALG_0000012"
    },
    {
      "curie": "ALG:0000013",
      "label": "Eigenvector",
      "definition": "A nonzero vector that, when multiplied by a matrix, results in a scalar multiple of itself.",
      "parents": [
        "ALG:0000012"
      ],
      "synonyms": [],
      "iri": "https://sounio.org/ontology/ALG_0000013"
    },
    {
      "curie": "ALG:0000014",
      "label": "Tensor",
      "definition": "A multilinear map from vector spaces and their duals to the real numbers.",
      "parents": [
        "ALG:0000001"
      ],
      "synonyms": [],
      "iri": "https://sounio.org/ontology/ALG_0000014"
    },
    {
      "curie": "ALG:0000015",
      "label": "Lie algebra",
      "definition": "A vector space together with a binary operation called the Lie bracket satisfying antisymmetry and the Jacobi identity.",
      "parents": [
        "ALG:0000007"
      ],
      "synonyms": [],
      "iri": "https://sounio.org/ontology/ALG_0000015"
    },
    {
      "curie": "ALG:0000016",
      "label": "Representation theory",
      "definition": "A branch of mathematics studying abstract algebraic structures by representing their elements as linear transformations of vector spaces.",
      "parents": [
        "ALG:0000001"
      ],
      "synonyms": [],
      "iri": "https://sounio.org/ontology/ALG_0000016"
    },
    {
      "curie": "ALG:0000017",
      "label": "Module",
      "definition": "A generalization of a vector space where the scalars are elements of a ring instead of a field.",
      "parents": [
        "ALG:0000007"
      ],
      "synonyms": [],
      "iri": "https://sounio.org/ontology/ALG_0000017"
    },
    {
      "curie": "ALG:0000018",
      "label": "Determinant",
      "definition": "A scalar value that can be computed from the elements of a square matrix and encodes certain properties of the linear transformation.",
      "parents": [
        "ALG:0000011"
      ],
      "synonyms": [],
      "iri": "https://sounio.org/ontology/ALG_0000018"
    },
    {
      "curie": "ALG:0000019",
      "label": "Characteristic polynomial",
      "definition": "A polynomial associated with a square matrix whose roots are the eigenvalues of the matrix.",
      "parents": [
        "ALG:0000012"
      ],
      "synonyms": [],
      "iri": "https://sounio.org/ontology/ALG_0000019"
    },
    {
      "curie": "ALG:0000020",
      "label": "Unitary matrix",
      "definition": "A complex square matrix whose conjugate transpose is also its inverse.",
      "parents": [
        "ALG:0000011"
      ],
      "synonyms": [],
      "iri": "https://sounio.org/ontology/ALG_0000020"
    },
