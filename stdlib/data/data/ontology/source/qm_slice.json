{
  "ontology": "QM",
  "version": "fixture-2026.03",
  "terms": [
    {
      "curie": "QM:0000001",
      "label": "Quantum mechanics",
      "definition": "The fundamental theory describing physical properties of nature at the scale of atoms and subatomic particles.",
      "parents": [],
      "synonyms": [
        "Quantum theory",
        "Quantum physics"
      ],
      "iri": "https://sounio.org/ontology/QM_0000001"
    },
    {
      "curie": "QM:0000002",
      "label": "Wave-particle duality",
      "definition": "The concept that every particle or quantum entity may be described as either a particle or a wave.",
      "parents": [
        "QM:0000001"
      ],
      "synonyms": [
        "Wave-particle complementarity"
      ],
      "iri": "https://sounio.org/ontology/QM_0000002"
    },
    {
      "curie": "QM:0000003",
      "label": "Quantum superposition",
      "definition": "A fundamental principle stating that a physical system exists partly in all its possible states simultaneously.",
      "parents": [
        "QM:0000001"
      ],
      "synonyms": [
        "Superposition principle"
      ],
      "iri": "https://sounio.org/ontology/QM_0000003"
    },
    {
      "curie": "QM:0000004",
      "label": "Quantum entanglement",
      "definition": "A physical phenomenon occurring when a group of particles are generated or interact in a way such that the quantum state of each particle cannot be described independently.",
      "parents": [
        "QM:0000001"
      ],
      "synonyms": [
        "Entanglement"
      ],
      "iri": "https://sounio.org/ontology/QM_0000004"
    },
    {
      "curie": "QM:0000005",
      "label": "Quantum measurement",
      "definition": "The process by which a quantum state collapses to a definite eigenstate upon observation.",
      "parents": [
        "QM:0000001"
      ],
      "synonyms": [
        "Wavefunction collapse",
        "Measurement problem"
      ],
      "iri": "https://sounio.org/ontology/QM_0000005"
    },
    {
      "curie": "QM:0000006",
      "label": "Heisenberg uncertainty principle",
      "definition": "The principle stating that the more precisely the position of a particle is determined, the less precisely its momentum can be known.",
      "parents": [
        "QM:0000001"
      ],
      "synonyms": [
        "Uncertainty principle"
      ],
      "iri": "https://sounio.org/ontology/QM_0000006"
    },
    {
      "curie": "QM:0000007",
      "label": "Hilbert space",
      "definition": "A complete inner product space that serves as the state space in quantum mechanics.",
      "parents": [
        "QM:0000001"
      ],
      "synonyms": [],
      "iri": "https://sounio.org/ontology/QM_0000007"
    },
    {
      "curie": "QM:0000008",
      "label": "Wavefunction",
      "definition": "A mathematical description of the quantum state of an isolated quantum system.",
      "parents": [
        "QM:0000007"
      ],
      "synonyms": [
        "State vector",
        "Psi"
      ],
      "iri": "https://sounio.org/ontology/QM_0000008"
    },
    {
      "curie": "QM:0000009",
      "label": "Schr\u00f6dinger equation",
      "definition": "A linear partial differential equation that governs the wave function of a quantum system.",
      "parents": [
        "QM:0000008"
      ],
      "synonyms": [],
      "iri": "https://sounio.org/ontology/QM_0000009"
    },
    {
      "curie": "QM:0000010",
      "label": "Quantum operator",
      "definition": "A mathematical operator used in quantum mechanics to represent physical observables.",
      "parents": [
        "QM:0000007"
      ],
      "synonyms": [
        "Observable operator"
      ],
      "iri": "https://sounio.org/ontology/QM_0000010"
    },
    {
      "curie": "QM:0000011",
      "label": "Hamiltonian operator",
      "definition": "The operator corresponding to the total energy of a quantum system.",
      "parents": [
        "QM:0000010"
      ],
      "synonyms": [
        "Hamiltonian"
      ],
      "iri": "https://sounio.org/ontology/QM_0000011"
    },
    {
      "curie": "QM:0000012",
      "label": "Momentum operator",
      "definition": "The operator corresponding to linear momentum in quantum mechanics.",
      "parents": [
        "QM:0000010"
      ],
      "synonyms": [],
      "iri": "https://sounio.org/ontology/QM_0000012"
    },
    {
      "curie": "QM:0000013",
      "label": "Position operator",
      "definition": "The operator corresponding to the position of a particle in quantum mechanics.",
      "parents": [
        "QM:0000010"
      ],
      "synonyms": [],
      "iri": "https://sounio.org/ontology/QM_0000013"
    },
    {
      "curie": "QM:0000014",
      "label": "Eigenvalue",
      "definition": "A scalar associated with a linear transformation such that the transformation scales a vector by that scalar.",
      "parents": [
        "QM:0000007"
      ],
      "synonyms": [],
      "iri": "https://sounio.org/ontology/QM_0000014"
    },
    {
      "curie": "QM:0000015",
      "label": "Eigenstate",
      "definition": "A quantum state that corresponds to a definite value of an observable.",
      "parents": [
        "QM:0000014"
      ],
      "synonyms": [
        "Eigenvector"
      ],
      "iri": "https://sounio.org/ontology/QM_0000015"
    },
    {
      "curie": "QM:0000016",
      "label": "Quantum harmonic oscillator",
      "definition": "The quantum-mechanical analog of the classical harmonic oscillator.",
      "parents": [
        "QM:0000009"
      ],
      "synonyms": [
        "QHO"
      ],
      "iri": "https://sounio.org/ontology/QM_0000016"
    },
    {
      "curie": "QM:0000017",
      "label": "Pauli exclusion principle",
      "definition": "The principle that two identical fermions cannot occupy the same quantum state simultaneously.",
      "parents": [
        "QM:0000001"
      ],
      "synonyms": [],
      "iri": "https://sounio.org/ontology/QM_0000017"
    },
    {
      "curie": "QM:0000018",
      "label": "Quantum tunneling",
      "definition": "A quantum mechanical phenomenon where a particle passes through a potential energy barrier.",
      "parents": [
        "QM:0000001"
      ],
      "synonyms": [],
      "iri": "https://sounio.org/ontology/QM_0000018"
    },
    {
      "curie": "QM:0000019",
      "label": "Spin",
      "definition": "An intrinsic form of angular momentum carried by elementary particles.",
      "parents": [
        "QM:0000001"
      ],
      "synonyms": [
        "Intrinsic angular momentum"
      ],
      "iri": "https://sounio.org/ontology/QM_0000019"
    },
    {
      "curie": "QM:0000020",
      "label": "Density matrix",
      "definition": "A matrix that describes the statistical state of a quantum system, including mixed states.",
      "parents": [
        "QM:0000007"
      ],
      "synonyms": [],
      "iri": "https://sounio.org/ontology/QM_0000020"
    },
