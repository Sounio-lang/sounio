pub fn bf_np_ln(src: &BigFrame, col: i64) -> BigFrame with Alloc, Mut, Div, Panic { np_map(src, col, 0.0, 19) }
pub fn bf_np_log2(src: &BigFrame, col: i64) -> BigFrame with Alloc, Mut, Div, Panic { np_map(src, col, 0.0, 20) }
