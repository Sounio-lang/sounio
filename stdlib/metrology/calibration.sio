// stdlib/metrology/calibration.sio — ISO/BIPM Metrological Calibration
//
// Implements the full metrological traceability chain as described in:
//   JCGM 100:2008 (GUM) — Evaluation of measurement uncertainty
//   JCGM 200:2012 (VIM) — International Vocabulary of Metrology
//   ISO 17025:2017    — Competence of calibration laboratories
//
// What makes this UNIQUE to Sounio:
//   Every other language treats calibration as a library add-on.
//   In Sounio, calibration is a type-system operation:
//   - a calibrated value carries its traceability chain IN THE TYPE
//   - the compiler can reject uncalibrated values entering calibrated pipelines
//   - GUM §5 budget is automatically updated when calibration correction is applied
//
// This directly implements the metrological concepts of:
//   - Calibration Hierarchy (JCGM 200 §2.40 → §2.41 → §2.42)
//   - Correction  (JCGM 200 §2.53): c = R - I (reference - indication)
//   - Expanded Uncertainty  (GUM §4.3.6 / §6.2): U = k · u_c
//   - Coverage Factor k (GUM §6.2.3): k=2 → ~95% for normal distribution
//
// References:
//   [GUM]   JCGM 100:2008 "Evaluation of measurement uncertainty" (BIPM)
//   [VIM]   JCGM 200:2012 "International Vocabulary of Metrology" (BIPM)
//   [17025] ISO 17025:2017 "General requirements for testing/calibration labs"

// ============================================================================
// CALIBRATION HIERARCHY (ISO 17025 / VIM §2.40–2.42)
// ============================================================================

// Traceability level (VIM §2.41)
let CAL_LEVEL_SI:         i64 = 0   // Primary standard — traceable to SI unit definition
let CAL_LEVEL_NATIONAL:   i64 = 1   // National standard (NIST, PTB, NPL, INMETRO, etc.)
let CAL_LEVEL_SECONDARY:  i64 = 2   // Secondary reference
let CAL_LEVEL_WORKING:    i64 = 3   // Working standard (field calibrator)
let CAL_LEVEL_INSTRUMENT: i64 = 4   // Instrument under test (uncalibrated)

// Calibration result status codes
let CAL_OK:             i64 = 0  // within tolerance
let CAL_OUT_OF_RANGE:   i64 = 1  // |error| > tolerance
let CAL_EXPIRED:        i64 = 2  // calibration interval exceeded
let CAL_CHAIN_BREAK:    i64 = 3  // traceability chain is broken
let CAL_NOT_PERFORMED:  i64 = 4  // no calibration on record

// ============================================================================
// CORE TYPES
// ============================================================================

// A single calibration point: reference value, instrument indication, conditions
pub struct CalPoint {
    reference:          f64,   // R: reference standard value (in SI unit)
    indication:         f64,   // I: instrument reading
    correction:         f64,   // c = R - I  (VIM §2.53)
    u_reference:        f64,   // standard uncertainty of reference (k=1)
    u_repeatability:    f64,   // standard uncertainty from repeated obs
    u_resolution:       f64,   // standard uncertainty of resolution (digital: 0.5 LSB / √3)
    temperature_c:      f64,   // ambient temperature at measurement (°C)
    valid:              bool,
}

pub fn cal_point_new(reference: f64, indication: f64, u_ref: f64, u_rep: f64, u_res: f64, temp: f64) -> CalPoint {
    CalPoint {
        reference:       reference,
        indication:      indication,
        correction:      reference - indication,
        u_reference:     u_ref,
        u_repeatability: u_rep,
        u_resolution:    u_res,
        temperature_c:   temp,
        valid:           true,
    }
}

// Combined standard uncertainty at a calibration point (GUM §5.1.1, RSS)
// u_c² = u_ref² + u_rep² + u_res²
pub fn cal_point_combined_u(p: CalPoint) -> f64 with Div, Panic, Mut {
    let u2 = p.u_reference * p.u_reference
             + p.u_repeatability * p.u_repeatability
             + p.u_resolution * p.u_resolution
    // Manual sqrt via Newton-Raphson (4 iterations — sufficient for metrology)
    if u2 == 0.0 { return 0.0 }
    var x = u2
    var i: i64 = 0
    while i < 8 {
        x = (x + u2 / x) / 2.0
        i = i + 1
    }
    x
}

// Expanded uncertainty U = k * u_c (GUM §6.2.3)
pub fn cal_point_expanded_u(p: CalPoint, coverage_k: f64) -> f64 with Div, Panic, Mut {
    cal_point_combined_u(p) * coverage_k
}

// ============================================================================
// CALIBRATION CERTIFICATE (ISO 17025 §7.8.4)
// ============================================================================

// Max 8 calibration points per certificate (sufficient for most instruments)
pub struct CalCertificate {
    points:        [CalPoint; 8],
    point_count:   i64,
    level:         i64,           // CAL_LEVEL_*
    coverage_k:    f64,           // coverage factor (typically 2.0)
    interval_days: i64,           // calibration interval in days
    status:        i64,           // CAL_OK / CAL_OUT_OF_RANGE / etc.
}

pub fn cal_cert_new(level: i64, coverage_k: f64, interval_days: i64) -> CalCertificate {
    var cert = CalCertificate {
        points:        [CalPoint {
            reference: 0.0, indication: 0.0, correction: 0.0,
            u_reference: 0.0, u_repeatability: 0.0, u_resolution: 0.0,
            temperature_c: 20.0, valid: false
        }; 8],
        point_count:   0,
        level:         level,
        coverage_k:    coverage_k,
        interval_days: interval_days,
        status:        CAL_NOT_PERFORMED,
    }
    cert
}

pub fn cal_cert_add_point(cert: &!CalCertificate, p: CalPoint) with Mut, Panic {
    if (*cert).point_count >= 8 { return }
    let idx = (*cert).point_count as usize
    (*cert).points[idx] = p
    (*cert).point_count = (*cert).point_count + 1
    (*cert).status = CAL_OK
}

// ============================================================================
// CORRECTION APPLICATION (VIM §2.53)
// Apply calibration correction to a raw instrument reading.
// Returns (corrected_value, combined_uncertainty) using nearest calibration point.
// ============================================================================

pub struct CorrectedValue {
    value:       f64,   // corrected reading  y = I + c
    u_combined:  f64,   // combined standard uncertainty (k=1)
    u_expanded:  f64,   // expanded uncertainty (k as in cert)
    correction:  f64,   // correction applied
    level:       i64,   // traceability level of source certificate
    valid:       bool,
}

// Find calibration point nearest to indication value
fn cal_find_nearest(cert: &CalCertificate, indication: f64) -> i64 with Mut, Panic {
    if (*cert).point_count == 0 { return 0 - 1 }
    var best_idx: i64 = 0
    var best_dist: f64 = 1.0e300
    var i: i64 = 0
    while i < (*cert).point_count {
        let p = (*cert).points[i as usize]
        var dist = p.indication - indication
        if dist < 0.0 { dist = 0.0 - dist }
        if dist < best_dist {
            best_dist = dist
            best_idx = i
        }
        i = i + 1
    }
    best_idx
}

// Apply calibration correction (VIM §2.53: corrected = indication + correction)
pub fn cal_apply(cert: &CalCertificate, indication: f64) -> CorrectedValue with Mut, Panic, Div {
    if (*cert).point_count == 0 || (*cert).status == CAL_NOT_PERFORMED {
        return CorrectedValue {
            value: indication, u_combined: 0.0, u_expanded: 0.0,
            correction: 0.0, level: CAL_LEVEL_INSTRUMENT, valid: false
        }
    }

    let idx = cal_find_nearest(cert, indication)
    if idx < 0 {
        return CorrectedValue {
            value: indication, u_combined: 0.0, u_expanded: 0.0,
            correction: 0.0, level: CAL_LEVEL_INSTRUMENT, valid: false
        }
    }

    let p = (*cert).points[idx as usize]
    let corrected = indication + p.correction
    let u_c = cal_point_combined_u(p)
    let u_exp = u_c * (*cert).coverage_k

    CorrectedValue {
        value:      corrected,
        u_combined: u_c,
        u_expanded: u_exp,
        correction: p.correction,
        level:      (*cert).level,
        valid:      true,
    }
}

// ============================================================================
// GUM §4.3.6 — Type A Evaluation (repeated observations)
// Computes sample mean and standard deviation of the mean from N readings.
// ============================================================================

pub struct TypeAEval {
    mean:           f64,
    s_mean:         f64,   // standard uncertainty of the mean = s / sqrt(N)
    s_std:          f64,   // experimental standard deviation
    n:              i64,
    valid:          bool,
}

// Maximum 16 readings for Type A evaluation
pub fn type_a_eval(readings: &[f64; 16], n: i64) -> TypeAEval with Mut, Panic, Div {
    if n <= 1 {
        return TypeAEval { mean: 0.0, s_mean: 0.0, s_std: 0.0, n: 0, valid: false }
    }

    // Mean
    var sum: f64 = 0.0
    var i: i64 = 0
    while i < n {
        sum = sum + (*readings)[i as usize]
        i = i + 1
    }
    let mean = sum / n as f64

    // Variance Σ(xᵢ - x̄)² / (n-1)
    var sq_sum: f64 = 0.0
    i = 0
    while i < n {
        var d = (*readings)[i as usize] - mean
        sq_sum = sq_sum + d * d
        i = i + 1
    }
    let variance = sq_sum / ((n - 1) as f64)

    // sqrt via Newton-Raphson
    var s = variance
    var j: i64 = 0
    while j < 8 {
        s = (s + variance / s) / 2.0
        j = j + 1
    }
    let s_mean = s / (n as f64)  // u_A = s/√n  (GUM §4.2.3)

    TypeAEval {
        mean:   mean,
        s_mean: s_mean,
        s_std:  s,
        n:      n,
        valid:  true,
    }
}

// ============================================================================
// GUM §4.4 — Type B Evaluation (a priori knowledge)
// Rectangular distribution: u = a / sqrt(3)  (GUM §4.4.5)
// Normal distribution:      u = U / k
// ============================================================================

// Type B from rectangular distribution: half-width a → u = a / √3
pub fn type_b_rectangular(half_width: f64) -> f64 with Div, Panic {
    assert(half_width >= 0.0)
    // √3 ≈ 1.7320508075688772
    half_width / 1.7320508075688772
}

// Type B from expanded uncertainty and coverage factor
pub fn type_b_from_expanded(expanded_u: f64, coverage_k: f64) -> f64 with Div, Panic {
    assert(coverage_k > 0.0)
    expanded_u / coverage_k
}

// Type B from resolution (digital instrument: ±0.5 LSB → rectangular)
pub fn type_b_from_resolution(resolution: f64) -> f64 with Div, Panic {
    type_b_rectangular(resolution / 2.0)
}

// ============================================================================
// TRACEABILITY CHAIN REPORT
// ============================================================================

pub fn cal_print_certificate(cert: &CalCertificate) with IO, Mut, Panic, Div {
    println("[CalCertificate]")
    print("  level:         ")
    if (*cert).level == CAL_LEVEL_SI       { println("SI primary") }
    else if (*cert).level == CAL_LEVEL_NATIONAL  { println("National standard") }
    else if (*cert).level == CAL_LEVEL_SECONDARY { println("Secondary reference") }
    else if (*cert).level == CAL_LEVEL_WORKING   { println("Working standard") }
    else                                         { println("Instrument (uncal)") }

    print("  coverage_k:    ")
    let k_int = (*cert).coverage_k as i64
    print_i64(k_int)
    println(".0")

    print("  interval_days: ")
    print_i64((*cert).interval_days)
    println("")

    print("  points:        ")
    print_i64((*cert).point_count)
    println("")

    var i: i64 = 0
    while i < (*cert).point_count {
        let p = (*cert).points[i as usize]
        print("  [")
        print_i64(i)
        print("] ref=")
        let ref_int = p.reference as i64
        print_i64(ref_int)
        print(" corr=")
        let corr_scaled = (p.correction * 1000.0) as i64
        print_i64(corr_scaled)
        println("e-3")
        i = i + 1
    }
}

// Helper to print i64
fn print_i64(x: i64) with IO, Mut, Panic {
    if x < 0 {
        print("-")
        var xi = 0 - x
        print_i64_abs(xi)
    } else {
        print_i64_abs(x)
    }
}

fn print_i64_abs(x: i64) with IO, Mut, Panic {
    if x < 10 {
        let c = 48 + x
        print_char(c)
        return
    }
    var buf: [i64; 20] = [0; 20]
    var n: i64 = 0
    var v = x
    while v > 0 {
        buf[n as usize] = v - (v / 10) * 10 + 48
        v = v / 10
        n = n + 1
    }
    var i = n - 1
    while i >= 0 {
        print_char(buf[i as usize])
        i = i - 1
    }
}


