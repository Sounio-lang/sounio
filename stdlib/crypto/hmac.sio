//! stdlib/crypto/hmac.sio — HMAC-SHA256 (RFC 2104)
//!
//! Pure Sounio implementation. Uses inline SHA-256 functions.
//!
//! HMAC(K, m) = H((K' xor opad) || H((K' xor ipad) || m))
//! where K' is the key padded/hashed to block size (64 bytes).
//!
//! References:
//!   RFC 2104 — HMAC: Keyed-Hashing for Message Authentication, 1997
//!   FIPS 180-4 — Secure Hash Standard (SHA-256), NIST, 2015

// ============================================================================
// SHA-256 INTERNALS (inlined to avoid cross-module dependency)
// ============================================================================

fn hmac_sha256_k_table() -> [i64; 64] {
    let k: [i64; 64] = [
        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5,
        0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
        0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
        0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
        0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc,
        0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7,
        0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
        0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
        0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3,
        0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5,
        0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
        0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
    ]
    return k
}

fn hmac_rotr32(x: i64, n: i32) -> i64 {
    let xm = x & 0xFFFFFFFF
    let right = (xm >> n) & 0xFFFFFFFF
    let left  = (xm << (32 - n)) & 0xFFFFFFFF
    return (left | right) & 0xFFFFFFFF
}

fn hmac_shr32(x: i64, n: i32) -> i64 {
    return (x & 0xFFFFFFFF) >> n
}

fn hmac_ch(x: i64, y: i64, z: i64) -> i64 {
    return ((x & y) ^ ((x ^ 0xFFFFFFFF) & 0xFFFFFFFF & z)) & 0xFFFFFFFF
}

fn hmac_maj(x: i64, y: i64, z: i64) -> i64 {
    return ((x & y) ^ (x & z) ^ (y & z)) & 0xFFFFFFFF
}

fn hmac_sigma0(x: i64) -> i64 {
    return (hmac_rotr32(x, 2) ^ hmac_rotr32(x, 13) ^ hmac_rotr32(x, 22)) & 0xFFFFFFFF
}

fn hmac_sigma1(x: i64) -> i64 {
    return (hmac_rotr32(x, 6) ^ hmac_rotr32(x, 11) ^ hmac_rotr32(x, 25)) & 0xFFFFFFFF
}

fn hmac_gamma0(x: i64) -> i64 {
    return (hmac_rotr32(x, 7) ^ hmac_rotr32(x, 18) ^ hmac_shr32(x, 3)) & 0xFFFFFFFF
}

fn hmac_gamma1(x: i64) -> i64 {
    return (hmac_rotr32(x, 17) ^ hmac_rotr32(x, 19) ^ hmac_shr32(x, 10)) & 0xFFFFFFFF
}

struct HmacSha256State {
    h: [i64; 8],
    block: [u8; 64],
    block_len: i32,
    total_len: i64,
}

fn hmac_sha256_compress(h: &![i64; 8], block: &[u8; 64]) with Mut, Panic, Div {
    let k = hmac_sha256_k_table()
    var w: [i64; 64] = [0; 64]

    var i: i32 = 0
    while i < 16 {
        let b0 = block[i * 4 + 0] as i64
        let b1 = block[i * 4 + 1] as i64
        let b2 = block[i * 4 + 2] as i64
        let b3 = block[i * 4 + 3] as i64
        w[i] = ((b0 << 24) | (b1 << 16) | (b2 << 8) | b3) & 0xFFFFFFFF
        i = i + 1
    }

    var t: i32 = 16
    while t < 64 {
        let g1 = hmac_gamma1(w[t - 2])
        let g0 = hmac_gamma0(w[t - 15])
        w[t] = (g1 + w[t - 7] + g0 + w[t - 16]) & 0xFFFFFFFF
        t = t + 1
    }

    var a = h[0]
    var b = h[1]
    var c = h[2]
    var d = h[3]
    var e = h[4]
    var f = h[5]
    var g = h[6]
    var hh = h[7]

    var r: i32 = 0
    while r < 64 {
        let t1 = (hh + hmac_sigma1(e) + hmac_ch(e, f, g) + k[r] + w[r]) & 0xFFFFFFFF
        let t2 = (hmac_sigma0(a) + hmac_maj(a, b, c)) & 0xFFFFFFFF
        hh = g
        g = f
        f = e
        e = (d + t1) & 0xFFFFFFFF
        d = c
        c = b
        b = a
        a = (t1 + t2) & 0xFFFFFFFF
        r = r + 1
    }

    h[0] = (h[0] + a) & 0xFFFFFFFF
    h[1] = (h[1] + b) & 0xFFFFFFFF
    h[2] = (h[2] + c) & 0xFFFFFFFF
    h[3] = (h[3] + d) & 0xFFFFFFFF
    h[4] = (h[4] + e) & 0xFFFFFFFF
    h[5] = (h[5] + f) & 0xFFFFFFFF
    h[6] = (h[6] + g) & 0xFFFFFFFF
    h[7] = (h[7] + hh) & 0xFFFFFFFF
}

fn hmac_sha256_init() -> HmacSha256State {
    let h: [i64; 8] = [
        0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
        0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19
    ]
    let buf: [u8; 64] = [0; 64]
    HmacSha256State { h: h, block: buf, block_len: 0, total_len: 0 }
}

fn hmac_sha256_update(state: HmacSha256State, data: &[u8; 256], data_len: i32) -> HmacSha256State with Mut, Panic, Div {
    var s = state
    var pos: i32 = 0

    while pos < data_len {
        s.block[s.block_len] = data[pos]
        s.block_len = s.block_len + 1
        s.total_len = s.total_len + 1
        pos = pos + 1

        if s.block_len == 64 {
            hmac_sha256_compress(&!s.h, &s.block)
            s.block_len = 0
            var bi: i32 = 0
            while bi < 64 {
                s.block[bi] = 0
                bi = bi + 1
            }
        }
    }

    return s
}

// Feed exactly 64 bytes from a [u8; 64] array
fn hmac_sha256_update_64(state: HmacSha256State, data: &[u8; 64]) -> HmacSha256State with Mut, Panic, Div {
    // Copy into a 256-byte buffer and call update with len=64
    var buf: [u8; 256] = [0; 256]
    var i: i32 = 0
    while i < 64 {
        buf[i] = data[i]
        i = i + 1
    }
    return hmac_sha256_update(state, &buf, 64)
}

// Feed exactly 32 bytes from a [u8; 32] array
fn hmac_sha256_update_32(state: HmacSha256State, data: &[u8; 32]) -> HmacSha256State with Mut, Panic, Div {
    var buf: [u8; 256] = [0; 256]
    var i: i32 = 0
    while i < 32 {
        buf[i] = data[i]
        i = i + 1
    }
    return hmac_sha256_update(state, &buf, 32)
}

fn hmac_sha256_finalize(state: HmacSha256State, out: &![u8; 32]) with Mut, Div, Panic {
    var s = state
    let bit_len: i64 = s.total_len * 8

    s.block[s.block_len] = 0x80 as u8
    s.block_len = s.block_len + 1

    if s.block_len > 56 {
        while s.block_len < 64 {
            s.block[s.block_len] = 0
            s.block_len = s.block_len + 1
        }
        hmac_sha256_compress(&!s.h, &s.block)
        s.block_len = 0
        var bi: i32 = 0
        while bi < 64 {
            s.block[bi] = 0
            bi = bi + 1
        }
    }

    while s.block_len < 56 {
        s.block[s.block_len] = 0
        s.block_len = s.block_len + 1
    }

    s.block[56] = ((bit_len >> 56) & 0xFF) as u8
    s.block[57] = ((bit_len >> 48) & 0xFF) as u8
    s.block[58] = ((bit_len >> 40) & 0xFF) as u8
    s.block[59] = ((bit_len >> 32) & 0xFF) as u8
    s.block[60] = ((bit_len >> 24) & 0xFF) as u8
    s.block[61] = ((bit_len >> 16) & 0xFF) as u8
    s.block[62] = ((bit_len >>  8) & 0xFF) as u8
    s.block[63] = ((bit_len      ) & 0xFF) as u8

    hmac_sha256_compress(&!s.h, &s.block)

    var wi: i32 = 0
    while wi < 8 {
        let word = s.h[wi]
        out[wi * 4 + 0] = ((word >> 24) & 0xFF) as u8
        out[wi * 4 + 1] = ((word >> 16) & 0xFF) as u8
        out[wi * 4 + 2] = ((word >>  8) & 0xFF) as u8
        out[wi * 4 + 3] = ((word      ) & 0xFF) as u8
        wi = wi + 1
    }
}

// ============================================================================
// HMAC-SHA256 — RFC 2104
// ============================================================================

fn hmac_sha256(key: &[u8; 256], key_len: i32, msg: &[u8; 256], msg_len: i32, out: &![u8; 32]) with Mut, Div, Panic {
    // Step 1: Derive 64-byte key block
    var k: [u8; 64] = [0; 64]

    if key_len > 64 {
        // Hash the key to get 32 bytes
        var key_hash: [u8; 32] = [0; 32]
        var ks = hmac_sha256_init()
        ks = hmac_sha256_update(ks, key, key_len)
        hmac_sha256_finalize(ks, &!key_hash)
        var di: i32 = 0
        while di < 32 {
            k[di] = key_hash[di]
            di = di + 1
        }
    } else {
        var ki: i32 = 0
        while ki < key_len {
            k[ki] = key[ki]
            ki = ki + 1
        }
    }

    // Step 2: Compute ipad and opad
    var ipad: [u8; 64] = [0; 64]
    var opad: [u8; 64] = [0; 64]
    var pi: i32 = 0
    while pi < 64 {
        ipad[pi] = ((k[pi] as i64) ^ 0x36) as u8
        opad[pi] = ((k[pi] as i64) ^ 0x5c) as u8
        pi = pi + 1
    }

    // Step 3: inner = SHA256(ipad || msg)
    var inner = hmac_sha256_init()
    inner = hmac_sha256_update_64(inner, &ipad)
    inner = hmac_sha256_update(inner, msg, msg_len)
    var inner_digest: [u8; 32] = [0; 32]
    hmac_sha256_finalize(inner, &!inner_digest)

    // Step 4: outer = SHA256(opad || inner_digest)
    var outer = hmac_sha256_init()
    outer = hmac_sha256_update_64(outer, &opad)
    outer = hmac_sha256_update_32(outer, &inner_digest)
    hmac_sha256_finalize(outer, out)
}

// ============================================================================
// TEST — RFC 4231 Test Case 1
// Key = 0x0b repeated 20 times
// Data = "Hi There" (8 bytes)
// HMAC-SHA256 = b0344c61d8db38535ca8afceaf0bf12b
//               881dc200c9833da726e9376c2e32cff7
// ============================================================================

fn hmac_sha256_test() -> i32 with Mut, Div, Panic {
    var key: [u8; 256] = [0; 256]
    var i: i32 = 0
    while i < 20 {
        key[i] = 0x0b as u8
        i = i + 1
    }

    // "Hi There" = 0x48 0x69 0x20 0x54 0x68 0x65 0x72 0x65
    var msg: [u8; 256] = [0; 256]
    msg[0] = 0x48 as u8
    msg[1] = 0x69 as u8
    msg[2] = 0x20 as u8
    msg[3] = 0x54 as u8
    msg[4] = 0x68 as u8
    msg[5] = 0x65 as u8
    msg[6] = 0x72 as u8
    msg[7] = 0x65 as u8

    var result: [u8; 32] = [0; 32]
    hmac_sha256(&key, 20, &msg, 8, &!result)

    let expected: [i32; 32] = [
        0xb0, 0x34, 0x4c, 0x61, 0xd8, 0xdb, 0x38, 0x53,
        0x5c, 0xa8, 0xaf, 0xce, 0xaf, 0x0b, 0xf1, 0x2b,
        0x88, 0x1d, 0xc2, 0x00, 0xc9, 0x83, 0x3d, 0xa7,
        0x26, 0xe9, 0x37, 0x6c, 0x2e, 0x32, 0xcf, 0xf7
    ]

    var j: i32 = 0
    while j < 32 {
        if (result[j] as i32) != expected[j] {
            return 1
        }
        j = j + 1
    }
    return 0
}
