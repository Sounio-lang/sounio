//! stdlib/crypto/hmac.sio - HMAC (Hash-based Message Authentication Code)
//!
//! Provides HMAC implementations using various hash functions.
//! HMAC provides both data integrity and authentication.
//!
//! # Examples
//!
//! ```sio
//! let key = "secret_key".as_bytes()
//! let message = "Hello, World!".as_bytes()
//!
//! // HMAC-SHA256
//! let mac = hmac_sha256(key, message)
//! let hex = hash_to_hex(&mac)
//!
//! // Verify HMAC
//! let is_valid = hmac_verify_sha256(key, message, &mac)
//! ```

use super::hash::{sha256, sha512, md5};

// ============================================================================
// HMAC Core
// ============================================================================

// HMAC block size for SHA-256 and SHA-512
const SHA256_BLOCK_SIZE: usize = 64
const SHA512_BLOCK_SIZE: usize = 128
const MD5_BLOCK_SIZE: usize = 64

// Inner and outer padding bytes
const IPAD: u8 = 0x36
const OPAD: u8 = 0x5c

// ============================================================================
// HMAC-SHA256
// ============================================================================

// Compute HMAC-SHA256 of a message with the given key.
//
// # Arguments
// * `key` - The secret key (any length)
// * `message` - The message to authenticate
//
// # Returns
// 32-byte HMAC-SHA256 digest
pub fn hmac_sha256(key: &[u8], message: &[u8]) -> [u8; 32] with Alloc {
    // Prepare the key
    var k = [0u8; 64]

    if key.len() > SHA256_BLOCK_SIZE {
        // Key longer than block size: hash it first
        let hashed = sha256(key)
        var i = 0
        while i < 32 {
            k[i] = hashed[i]
            i = i + 1
        }
    } else {
        // Key shorter or equal: copy and zero-pad
        var i = 0
        while i < key.len() {
            k[i] = key[i]
            i = i + 1
        }
        // Rest is already zero from initialization
    }

    // Inner padding: key XOR ipad
    var inner_key = [0u8; 64]
    var i = 0
    while i < 64 {
        inner_key[i] = k[i] ^ IPAD
        i = i + 1
    }

    // Outer padding: key XOR opad
    var outer_key = [0u8; 64]
    i = 0
    while i < 64 {
        outer_key[i] = k[i] ^ OPAD
        i = i + 1
    }

    // Inner hash: H(K XOR ipad || message)
    var inner_data = vec_new::<u8>()
    vec_reserve(&!inner_data, 64 + message.len())

    i = 0
    while i < 64 {
        vec_push(&!inner_data, inner_key[i])
        i = i + 1
    }
    i = 0
    while i < message.len() {
        vec_push(&!inner_data, message[i])
        i = i + 1
    }

    let inner_hash = sha256(vec_as_slice(&inner_data))

    // Outer hash: H(K XOR opad || inner_hash)
    var outer_data = vec_new::<u8>()
    vec_reserve(&!outer_data, 64 + 32)

    i = 0
    while i < 64 {
        vec_push(&!outer_data, outer_key[i])
        i = i + 1
    }
    i = 0
    while i < 32 {
        vec_push(&!outer_data, inner_hash[i])
        i = i + 1
    }

    sha256(vec_as_slice(&outer_data))
}

// Verify an HMAC-SHA256 tag against a message.
// Uses constant-time comparison to prevent timing attacks.
pub fn hmac_verify_sha256(key: &[u8], message: &[u8], expected: &[u8; 32]) -> bool with Alloc {
    let computed = hmac_sha256(key, message)

    // Constant-time comparison
    var result: u8 = 0
    var i = 0
    while i < 32 {
        result = result | (computed[i] ^ expected[i])
        i = i + 1
    }

    result == 0
}

// ============================================================================
// HMAC-SHA512
// ============================================================================

// Compute HMAC-SHA512 of a message with the given key.
//
// # Arguments
// * `key` - The secret key (any length)
// * `message` - The message to authenticate
//
// # Returns
// 64-byte HMAC-SHA512 digest
pub fn hmac_sha512(key: &[u8], message: &[u8]) -> [u8; 64] with Alloc {
    // Prepare the key
    var k = [0u8; 128]

    if key.len() > SHA512_BLOCK_SIZE {
        // Key longer than block size: hash it first
        let hashed = sha512(key)
        var i = 0
        while i < 64 {
            k[i] = hashed[i]
            i = i + 1
        }
    } else {
        // Key shorter or equal: copy and zero-pad
        var i = 0
        while i < key.len() {
            k[i] = key[i]
            i = i + 1
        }
    }

    // Inner padding: key XOR ipad
    var inner_key = [0u8; 128]
    var i = 0
    while i < 128 {
        inner_key[i] = k[i] ^ IPAD
        i = i + 1
    }

    // Outer padding: key XOR opad
    var outer_key = [0u8; 128]
    i = 0
    while i < 128 {
        outer_key[i] = k[i] ^ OPAD
        i = i + 1
    }

    // Inner hash: H(K XOR ipad || message)
    var inner_data = vec_new::<u8>()
    vec_reserve(&!inner_data, 128 + message.len())

    i = 0
    while i < 128 {
        vec_push(&!inner_data, inner_key[i])
        i = i + 1
    }
    i = 0
    while i < message.len() {
        vec_push(&!inner_data, message[i])
        i = i + 1
    }

    let inner_hash = sha512(vec_as_slice(&inner_data))

    // Outer hash: H(K XOR opad || inner_hash)
    var outer_data = vec_new::<u8>()
    vec_reserve(&!outer_data, 128 + 64)

    i = 0
    while i < 128 {
        vec_push(&!outer_data, outer_key[i])
        i = i + 1
    }
    i = 0
    while i < 64 {
        vec_push(&!outer_data, inner_hash[i])
        i = i + 1
    }

    sha512(vec_as_slice(&outer_data))
}

// Verify an HMAC-SHA512 tag against a message.
// Uses constant-time comparison to prevent timing attacks.
pub fn hmac_verify_sha512(key: &[u8], message: &[u8], expected: &[u8; 64]) -> bool with Alloc {
    let computed = hmac_sha512(key, message)

    // Constant-time comparison
    var result: u8 = 0
    var i = 0
    while i < 64 {
        result = result | (computed[i] ^ expected[i])
        i = i + 1
    }

    result == 0
}

// ============================================================================
// HMAC-MD5 (for legacy compatibility only)
// ============================================================================

// Compute HMAC-MD5 of a message with the given key.
//
// **WARNING**: MD5 is cryptographically broken. Use HMAC-SHA256 instead.
// This function is provided only for compatibility with legacy systems.
//
// # Arguments
// * `key` - The secret key (any length)
// * `message` - The message to authenticate
//
// # Returns
// 16-byte HMAC-MD5 digest
pub fn hmac_md5(key: &[u8], message: &[u8]) -> [u8; 16] with Alloc {
    // Prepare the key
    var k = [0u8; 64]

    if key.len() > MD5_BLOCK_SIZE {
        // Key longer than block size: hash it first
        let hashed = md5(key)
        var i = 0
        while i < 16 {
            k[i] = hashed[i]
            i = i + 1
        }
    } else {
        // Key shorter or equal: copy and zero-pad
        var i = 0
        while i < key.len() {
            k[i] = key[i]
            i = i + 1
        }
    }

    // Inner padding: key XOR ipad
    var inner_key = [0u8; 64]
    var i = 0
    while i < 64 {
        inner_key[i] = k[i] ^ IPAD
        i = i + 1
    }

    // Outer padding: key XOR opad
    var outer_key = [0u8; 64]
    i = 0
    while i < 64 {
        outer_key[i] = k[i] ^ OPAD
        i = i + 1
    }

    // Inner hash: H(K XOR ipad || message)
    var inner_data = vec_new::<u8>()
    vec_reserve(&!inner_data, 64 + message.len())

    i = 0
    while i < 64 {
        vec_push(&!inner_data, inner_key[i])
        i = i + 1
    }
    i = 0
    while i < message.len() {
        vec_push(&!inner_data, message[i])
        i = i + 1
    }

    let inner_hash = md5(vec_as_slice(&inner_data))

    // Outer hash: H(K XOR opad || inner_hash)
    var outer_data = vec_new::<u8>()
    vec_reserve(&!outer_data, 64 + 16)

    i = 0
    while i < 64 {
        vec_push(&!outer_data, outer_key[i])
        i = i + 1
    }
    i = 0
    while i < 16 {
        vec_push(&!outer_data, inner_hash[i])
        i = i + 1
    }

    md5(vec_as_slice(&outer_data))
}

// Verify an HMAC-MD5 tag against a message.
// Uses constant-time comparison to prevent timing attacks.
//
// **WARNING**: MD5 is cryptographically broken. Use HMAC-SHA256 instead.
pub fn hmac_verify_md5(key: &[u8], message: &[u8], expected: &[u8; 16]) -> bool with Alloc {
    let computed = hmac_md5(key, message)

    // Constant-time comparison
    var result: u8 = 0
    var i = 0
    while i < 16 {
        result = result | (computed[i] ^ expected[i])
        i = i + 1
    }

    result == 0
}

// ============================================================================
// HKDF (HMAC-based Key Derivation Function)
// ============================================================================

// HKDF-Extract using SHA-256.
// Extracts a pseudorandom key from input keying material.
//
// # Arguments
// * `salt` - Optional salt (if None, uses zeros)
// * `ikm` - Input keying material
//
// # Returns
// 32-byte pseudorandom key
pub fn hkdf_extract_sha256(salt: Option<&[u8]>, ikm: &[u8]) -> [u8; 32] with Alloc {
    let actual_salt = match salt {
        Some(s) => s,
        None => {
            // Use zero-filled salt of hash length
            let zeros = [0u8; 32]
            &zeros[..]
        }
    }

    hmac_sha256(actual_salt, ikm)
}

// HKDF-Expand using SHA-256.
// Expands a pseudorandom key into output keying material.
//
// # Arguments
// * `prk` - Pseudorandom key (from hkdf_extract)
// * `info` - Context and application specific information
// * `length` - Length of output keying material (max 255 * 32)
//
// # Returns
// Output keying material of requested length
pub fn hkdf_expand_sha256(prk: &[u8; 32], info: &[u8], length: usize) -> Vec<u8> with Alloc, Panic {
    if length > 255 * 32 {
        panic("HKDF-Expand: output length too large")
    }

    var okm = vec_new::<u8>()
    vec_reserve(&!okm, length)

    var t = [0u8; 32]
    var t_len: usize = 0
    var i: u8 = 1

    while vec_len(&okm) < length {
        // T(i) = HMAC-Hash(PRK, T(i-1) | info | i)
        var input = vec_new::<u8>()

        // Append T(i-1) (empty for first iteration)
        var j = 0
        while j < t_len {
            vec_push(&!input, t[j])
            j = j + 1
        }

        // Append info
        j = 0
        while j < info.len() {
            vec_push(&!input, info[j])
            j = j + 1
        }

        // Append counter
        vec_push(&!input, i)

        t = hmac_sha256(&prk[..], vec_as_slice(&input))
        t_len = 32

        // Copy to output (up to remaining length)
        j = 0
        while j < 32 && vec_len(&okm) < length {
            vec_push(&!okm, t[j])
            j = j + 1
        }

        i = i + 1
    }

    okm
}

// HKDF (Extract and Expand) using SHA-256.
// One-shot key derivation function.
//
// # Arguments
// * `salt` - Optional salt
// * `ikm` - Input keying material
// * `info` - Context and application specific information
// * `length` - Length of output keying material
//
// # Returns
// Derived key of requested length
pub fn hkdf_sha256(
    salt: Option<&[u8]>,
    ikm: &[u8],
    info: &[u8],
    length: usize
) -> Vec<u8> with Alloc, Panic {
    let prk = hkdf_extract_sha256(salt, ikm)
    hkdf_expand_sha256(&prk, info, length)
}

// ============================================================================
// PBKDF2 (Password-Based Key Derivation Function 2)
// ============================================================================

// PBKDF2 using HMAC-SHA256.
// Derives a key from a password using iterative hashing.
//
// # Arguments
// * `password` - The password
// * `salt` - Salt (should be random, at least 16 bytes)
// * `iterations` - Number of iterations (recommended: >= 100000)
// * `dk_len` - Desired key length
//
// # Returns
// Derived key of requested length
pub fn pbkdf2_sha256(
    password: &[u8],
    salt: &[u8],
    iterations: u32,
    dk_len: usize
) -> Vec<u8> with Alloc, Panic {
    if iterations == 0 {
        panic("PBKDF2: iterations must be > 0")
    }

    let h_len: usize = 32  // SHA-256 output length
    let num_blocks = (dk_len + h_len - 1) / h_len

    if num_blocks > 0xFFFFFFFF {
        panic("PBKDF2: derived key too long")
    }

    var dk = vec_new::<u8>()
    vec_reserve(&!dk, dk_len)

    var block_num: u32 = 1
    while block_num <= num_blocks as u32 {
        // U_1 = PRF(Password, Salt || INT(i))
        var input = vec_new::<u8>()

        var j = 0
        while j < salt.len() {
            vec_push(&!input, salt[j])
            j = j + 1
        }

        // Append big-endian block number
        vec_push(&!input, ((block_num >> 24) & 0xFF) as u8)
        vec_push(&!input, ((block_num >> 16) & 0xFF) as u8)
        vec_push(&!input, ((block_num >> 8) & 0xFF) as u8)
        vec_push(&!input, (block_num & 0xFF) as u8)

        var u = hmac_sha256(password, vec_as_slice(&input))
        var t = u  // T_i = U_1

        // U_2 ... U_c
        var iter: u32 = 1
        while iter < iterations {
            u = hmac_sha256(password, &u[..])

            // T_i = T_i XOR U_j
            j = 0
            while j < 32 {
                t[j] = t[j] ^ u[j]
                j = j + 1
            }

            iter = iter + 1
        }

        // Append T_i to derived key
        j = 0
        while j < 32 && vec_len(&dk) < dk_len {
            vec_push(&!dk, t[j])
            j = j + 1
        }

        block_num = block_num + 1
    }

    dk
}

// Verify a password against a stored PBKDF2 hash.
// Uses constant-time comparison.
pub fn pbkdf2_verify_sha256(
    password: &[u8],
    salt: &[u8],
    iterations: u32,
    expected: &[u8]
) -> bool with Alloc, Panic {
    let derived = pbkdf2_sha256(password, salt, iterations, expected.len())

    if vec_len(&derived) != expected.len() {
        return false
    }

    // Constant-time comparison
    var result: u8 = 0
    var i = 0
    while i < expected.len() {
        result = result | (derived[i] ^ expected[i])
        i = i + 1
    }

    result == 0
}
