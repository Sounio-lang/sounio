//! stdlib/crypto - Cryptographic Primitives
//!
//! This module provides cryptographic hash functions and utilities:
//! - `hash` - Cryptographic hash functions (SHA-256, SHA-512, MD5, etc.)
//! - `hmac` - HMAC (Hash-based Message Authentication Code)
//! - `random` - Cryptographically secure random number generation
//!
//! # Examples
//! ```sio
//! // Hash a string
//! let hash = sha256("hello world".as_bytes())
//! let hex = hash_to_hex(&hash)
//!
//! // HMAC
//! let key = "secret".as_bytes()
//! let mac = hmac_sha256(key, "message".as_bytes())
//!
//! // Random bytes
//! let bytes = random_bytes(32)?
//! ```

pub mod hash;
pub mod hmac;
pub mod random;

pub use hash::*;
pub use hmac::*;
pub use random::*;
