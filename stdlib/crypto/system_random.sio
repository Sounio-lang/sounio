// OS-backed entropy. No seeded-PRNG fallback. Platform status is POSIX errno.
use ffi::platform::{Platform,PlatformValue}
use collections::byte_buffer::{ByteBuffer,byte_buffer_system_random}
pub fn system_random_bytes(p:&Platform,out:&!ByteBuffer,n:i64)->PlatformValue with IO,Alloc,Mut {
    return byte_buffer_system_random(p,out,n)
}
