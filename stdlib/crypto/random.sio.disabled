//! stdlib/crypto/random.sio - Cryptographically Secure Random Number Generation
//!
//! Provides cryptographically secure random number generation using
//! system entropy sources (/dev/urandom on Unix, getrandom() on Linux).
//!
//! # Examples
//!
//! ```sio
//! // Generate random bytes
//! let bytes = random_bytes(32)?
//!
//! // Generate random integers
//! let n = random_u64()?
//! let bounded = random_u64_range(1, 100)?  // [1, 100)
//!
//! // Generate random UUID v4
//! let uuid = random_uuid_v4()?
//! ```

// ============================================================================
// System FFI
// ============================================================================

extern "C" {
    // Linux getrandom syscall wrapper
    fn getrandom(buf: *mut u8, buflen: usize, flags: u32) -> i64

    // Fallback: read from /dev/urandom
    fn open(pathname: *const u8, flags: i32) -> i32
    fn read(fd: i32, buf: *mut u8, count: usize) -> i64
    fn close(fd: i32) -> i32
}

// getrandom flags
const GRND_NONBLOCK: u32 = 1

// open flags
const O_RDONLY: i32 = 0

// ============================================================================
// Error Types
// ============================================================================

// Errors from random number generation.
pub enum RandomError {
    /// System call failed
    SystemError { errno: i32 },

    /// Not enough entropy available
    InsufficientEntropy,

    /// Invalid range (min >= max)
    InvalidRange,
}

// ============================================================================
// Core Random Bytes
// ============================================================================

// Generate cryptographically secure random bytes.
//
// Uses getrandom() on Linux, falls back to /dev/urandom.
//
// # Arguments
// * `len` - Number of random bytes to generate
//
// # Returns
// Vector of random bytes
pub fn random_bytes(len: usize) -> Result<Vec<u8>, RandomError> with IO, Alloc {
    var buf = vec_new::<u8>()
    vec_resize(&!buf, len, 0u8)

    let ptr = vec_as_mut_ptr(&!buf)

    // Try getrandom first (available on Linux 3.17+)
    let result = getrandom(ptr, len, 0)

    if result >= 0 && result as usize == len {
        return Ok(buf)
    }

    // Fallback to /dev/urandom
    let fd = open("/dev/urandom\0".as_ptr(), O_RDONLY)
    if fd < 0 {
        return Err(RandomError::SystemError { errno: -fd })
    }

    var total_read: usize = 0
    while total_read < len {
        let n = read(fd, ptr.offset(total_read as isize), len - total_read)
        if n <= 0 {
            close(fd)
            return Err(RandomError::SystemError { errno: if n < 0 { -n as i32 } else { 0 } })
        }
        total_read = total_read + n as usize
    }

    close(fd)
    Ok(buf)
}

// Fill a buffer with cryptographically secure random bytes.
pub fn random_fill(buf: &![u8]) -> Result<(), RandomError> with IO {
    let ptr = buf.as_mut_ptr()
    let len = buf.len()

    // Try getrandom first
    let result = getrandom(ptr, len, 0)

    if result >= 0 && result as usize == len {
        return Ok(())
    }

    // Fallback to /dev/urandom
    let fd = open("/dev/urandom\0".as_ptr(), O_RDONLY)
    if fd < 0 {
        return Err(RandomError::SystemError { errno: -fd })
    }

    var total_read: usize = 0
    while total_read < len {
        let n = read(fd, ptr.offset(total_read as isize), len - total_read)
        if n <= 0 {
            close(fd)
            return Err(RandomError::SystemError { errno: if n < 0 { -n as i32 } else { 0 } })
        }
        total_read = total_read + n as usize
    }

    close(fd)
    Ok(())
}

// ============================================================================
// Random Integers
// ============================================================================

// Generate a random u8.
pub fn random_u8() -> Result<u8, RandomError> with IO, Alloc {
    let bytes = random_bytes(1)?
    Ok(bytes[0])
}

// Generate a random u16.
pub fn random_u16() -> Result<u16, RandomError> with IO, Alloc {
    let bytes = random_bytes(2)?
    Ok((bytes[0] as u16) << 8 | bytes[1] as u16)
}

// Generate a random u32.
pub fn random_u32() -> Result<u32, RandomError> with IO, Alloc {
    let bytes = random_bytes(4)?
    Ok((bytes[0] as u32) << 24 |
       (bytes[1] as u32) << 16 |
       (bytes[2] as u32) << 8 |
       bytes[3] as u32)
}

// Generate a random u64.
pub fn random_u64() -> Result<u64, RandomError> with IO, Alloc {
    let bytes = random_bytes(8)?
    Ok((bytes[0] as u64) << 56 |
       (bytes[1] as u64) << 48 |
       (bytes[2] as u64) << 40 |
       (bytes[3] as u64) << 32 |
       (bytes[4] as u64) << 24 |
       (bytes[5] as u64) << 16 |
       (bytes[6] as u64) << 8 |
       bytes[7] as u64)
}

// Generate a random i32.
pub fn random_i32() -> Result<i32, RandomError> with IO, Alloc {
    let u = random_u32()?
    Ok(u as i32)
}

// Generate a random i64.
pub fn random_i64() -> Result<i64, RandomError> with IO, Alloc {
    let u = random_u64()?
    Ok(u as i64)
}

// Generate a random u32 in range [min, max).
// Uses rejection sampling to avoid modulo bias.
pub fn random_u32_range(min: u32, max: u32) -> Result<u32, RandomError> with IO, Alloc {
    if min >= max {
        return Err(RandomError::InvalidRange)
    }

    let range = max - min
    let threshold = (0u32.wrapping_sub(range)) % range

    loop {
        let r = random_u32()?
        if r >= threshold {
            return Ok(min + (r % range))
        }
    }
}

// Generate a random u64 in range [min, max).
// Uses rejection sampling to avoid modulo bias.
pub fn random_u64_range(min: u64, max: u64) -> Result<u64, RandomError> with IO, Alloc {
    if min >= max {
        return Err(RandomError::InvalidRange)
    }

    let range = max - min
    let threshold = (0u64.wrapping_sub(range)) % range

    loop {
        let r = random_u64()?
        if r >= threshold {
            return Ok(min + (r % range))
        }
    }
}

// ============================================================================
// Random Floats
// ============================================================================

// Generate a random f64 in range [0.0, 1.0).
pub fn random_f64() -> Result<f64, RandomError> with IO, Alloc {
    let u = random_u64()?
    // Use 53 bits (double precision mantissa)
    let mantissa = u >> 11
    Ok(mantissa as f64 / (1u64 << 53) as f64)
}

// Generate a random f64 in range [min, max).
pub fn random_f64_range(min: f64, max: f64) -> Result<f64, RandomError> with IO, Alloc {
    if min >= max {
        return Err(RandomError::InvalidRange)
    }

    let r = random_f64()?
    Ok(min + r * (max - min))
}

// Generate a random f32 in range [0.0, 1.0).
pub fn random_f32() -> Result<f32, RandomError> with IO, Alloc {
    let u = random_u32()?
    // Use 24 bits (single precision mantissa)
    let mantissa = u >> 8
    Ok(mantissa as f32 / (1u32 << 24) as f32)
}

// ============================================================================
// Random Selection
// ============================================================================

// Select a random element from a slice.
pub fn random_choice<T>(items: &[T]) -> Result<&T, RandomError> with IO, Alloc {
    if items.len() == 0 {
        return Err(RandomError::InvalidRange)
    }

    let idx = random_u64_range(0, items.len() as u64)? as usize
    Ok(&items[idx])
}

// Shuffle a slice in-place using Fisher-Yates algorithm.
pub fn random_shuffle<T>(items: &![T]) -> Result<(), RandomError> with IO, Alloc {
    let n = items.len()
    if n <= 1 {
        return Ok(())
    }

    var i = n - 1
    while i > 0 {
        let j = random_u64_range(0, (i + 1) as u64)? as usize

        // Swap items[i] and items[j]
        let tmp = items[i]
        items[i] = items[j]
        items[j] = tmp

        i = i - 1
    }

    Ok(())
}

// Generate a random sample of k elements from a slice (without replacement).
pub fn random_sample<T: Clone>(items: &[T], k: usize) -> Result<Vec<T>, RandomError> with IO, Alloc {
    if k > items.len() {
        return Err(RandomError::InvalidRange)
    }

    // Use reservoir sampling for large samples
    if k > items.len() / 2 {
        // Copy and shuffle, take first k
        var copy = vec_new::<T>()
        vec_reserve(&!copy, items.len())

        var i = 0
        while i < items.len() {
            vec_push(&!copy, items[i].clone())
            i = i + 1
        }

        random_shuffle(vec_as_mut_slice(&!copy))?

        var result = vec_new::<T>()
        i = 0
        while i < k {
            vec_push(&!result, copy[i].clone())
            i = i + 1
        }

        return Ok(result)
    }

    // For small k, use selection without replacement
    var result = vec_new::<T>()
    var selected = vec_new::<usize>()

    while vec_len(&result) < k {
        let idx = random_u64_range(0, items.len() as u64)? as usize

        // Check if already selected
        var found = false
        var i = 0
        while i < vec_len(&selected) {
            if selected[i] == idx {
                found = true
                break
            }
            i = i + 1
        }

        if !found {
            vec_push(&!selected, idx)
            vec_push(&!result, items[idx].clone())
        }
    }

    Ok(result)
}

// ============================================================================
// UUID Generation
// ============================================================================

// A UUID (Universally Unique Identifier).
pub struct Uuid {
    bytes: [u8; 16],
}

// Generate a random UUID v4.
//
// UUID v4 is completely random except for version and variant bits.
pub fn random_uuid_v4() -> Result<Uuid, RandomError> with IO, Alloc {
    var bytes = [0u8; 16]
    let random = random_bytes(16)?

    var i = 0
    while i < 16 {
        bytes[i] = random[i]
        i = i + 1
    }

    // Set version to 4 (random)
    bytes[6] = (bytes[6] & 0x0F) | 0x40

    // Set variant to RFC 4122
    bytes[8] = (bytes[8] & 0x3F) | 0x80

    Ok(Uuid { bytes })
}

// Convert UUID to standard string format (xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx).
pub fn uuid_to_string(uuid: &Uuid) -> String with Alloc {
    let hex_chars = "0123456789abcdef"
    var s = string_new()

    var i = 0
    while i < 16 {
        if i == 4 || i == 6 || i == 8 || i == 10 {
            string_push(&!s, '-')
        }

        let b = uuid.bytes[i]
        string_push(&!s, hex_chars[(b >> 4) as usize])
        string_push(&!s, hex_chars[(b & 0x0F) as usize])

        i = i + 1
    }

    s
}

// Parse a UUID from string format.
pub fn uuid_parse(s: &str) -> Result<Uuid, RandomError> with Alloc {
    var bytes = [0u8; 16]
    var byte_idx = 0
    var chars = s.chars()
    var high_nibble = true

    for c in chars {
        if c == '-' {
            continue
        }

        let nibble = if c >= '0' && c <= '9' {
            (c as u8) - ('0' as u8)
        } else if c >= 'a' && c <= 'f' {
            (c as u8) - ('a' as u8) + 10
        } else if c >= 'A' && c <= 'F' {
            (c as u8) - ('A' as u8) + 10
        } else {
            return Err(RandomError::InvalidRange)
        }

        if high_nibble {
            bytes[byte_idx] = nibble << 4
            high_nibble = false
        } else {
            bytes[byte_idx] = bytes[byte_idx] | nibble
            byte_idx = byte_idx + 1
            high_nibble = true
        }

        if byte_idx > 16 {
            return Err(RandomError::InvalidRange)
        }
    }

    if byte_idx != 16 {
        return Err(RandomError::InvalidRange)
    }

    Ok(Uuid { bytes })
}

// Compare two UUIDs for equality.
pub fn uuid_eq(a: &Uuid, b: &Uuid) -> bool {
    var i = 0
    while i < 16 {
        if a.bytes[i] != b.bytes[i] {
            return false
        }
        i = i + 1
    }
    true
}

// ============================================================================
// Cryptographic Token Generation
// ============================================================================

// Generate a cryptographically secure token as hex string.
//
// # Arguments
// * `byte_len` - Number of random bytes (token will be 2x this in hex)
pub fn random_token_hex(byte_len: usize) -> Result<String, RandomError> with IO, Alloc {
    let bytes = random_bytes(byte_len)?

    let hex_chars = "0123456789abcdef"
    var s = string_new()
    string_reserve(&!s, byte_len * 2)

    var i = 0
    while i < byte_len {
        let b = bytes[i]
        string_push(&!s, hex_chars[(b >> 4) as usize])
        string_push(&!s, hex_chars[(b & 0x0F) as usize])
        i = i + 1
    }

    Ok(s)
}

// Generate a cryptographically secure token as base64 string.
//
// # Arguments
// * `byte_len` - Number of random bytes
pub fn random_token_base64(byte_len: usize) -> Result<String, RandomError> with IO, Alloc {
    let bytes = random_bytes(byte_len)?

    let b64_chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    var s = string_new()

    var i = 0
    while i + 2 < byte_len {
        let b0 = bytes[i] as u32
        let b1 = bytes[i + 1] as u32
        let b2 = bytes[i + 2] as u32

        let n = (b0 << 16) | (b1 << 8) | b2

        string_push(&!s, b64_chars[((n >> 18) & 0x3F) as usize])
        string_push(&!s, b64_chars[((n >> 12) & 0x3F) as usize])
        string_push(&!s, b64_chars[((n >> 6) & 0x3F) as usize])
        string_push(&!s, b64_chars[(n & 0x3F) as usize])

        i = i + 3
    }

    // Handle remaining bytes
    let remaining = byte_len - i
    if remaining == 1 {
        let b0 = bytes[i] as u32
        let n = b0 << 16

        string_push(&!s, b64_chars[((n >> 18) & 0x3F) as usize])
        string_push(&!s, b64_chars[((n >> 12) & 0x3F) as usize])
        string_push(&!s, '=')
        string_push(&!s, '=')
    } else if remaining == 2 {
        let b0 = bytes[i] as u32
        let b1 = bytes[i + 1] as u32
        let n = (b0 << 16) | (b1 << 8)

        string_push(&!s, b64_chars[((n >> 18) & 0x3F) as usize])
        string_push(&!s, b64_chars[((n >> 12) & 0x3F) as usize])
        string_push(&!s, b64_chars[((n >> 6) & 0x3F) as usize])
        string_push(&!s, '=')
    }

    Ok(s)
}

// Generate a URL-safe random token (base64url encoding).
//
// # Arguments
// * `byte_len` - Number of random bytes
pub fn random_token_urlsafe(byte_len: usize) -> Result<String, RandomError> with IO, Alloc {
    let bytes = random_bytes(byte_len)?

    // Base64url: replace + with -, / with _, no padding
    let b64_chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
    var s = string_new()

    var i = 0
    while i + 2 < byte_len {
        let b0 = bytes[i] as u32
        let b1 = bytes[i + 1] as u32
        let b2 = bytes[i + 2] as u32

        let n = (b0 << 16) | (b1 << 8) | b2

        string_push(&!s, b64_chars[((n >> 18) & 0x3F) as usize])
        string_push(&!s, b64_chars[((n >> 12) & 0x3F) as usize])
        string_push(&!s, b64_chars[((n >> 6) & 0x3F) as usize])
        string_push(&!s, b64_chars[(n & 0x3F) as usize])

        i = i + 3
    }

    // Handle remaining bytes (no padding in urlsafe)
    let remaining = byte_len - i
    if remaining == 1 {
        let b0 = bytes[i] as u32
        let n = b0 << 16

        string_push(&!s, b64_chars[((n >> 18) & 0x3F) as usize])
        string_push(&!s, b64_chars[((n >> 12) & 0x3F) as usize])
    } else if remaining == 2 {
        let b0 = bytes[i] as u32
        let b1 = bytes[i + 1] as u32
        let n = (b0 << 16) | (b1 << 8)

        string_push(&!s, b64_chars[((n >> 18) & 0x3F) as usize])
        string_push(&!s, b64_chars[((n >> 12) & 0x3F) as usize])
        string_push(&!s, b64_chars[((n >> 6) & 0x3F) as usize])
    }

    Ok(s)
}
