//! stdlib/crypto/hash.sio - Cryptographic Hash Functions
//!
//! This module provides implementations of common cryptographic hash functions:
//! - SHA-256 (256-bit, secure)
//! - SHA-512 (512-bit, secure)
//! - SHA-1 (160-bit, legacy only)
//! - MD5 (128-bit, legacy only)
//!
//! Note: MD5 and SHA-1 are provided for legacy compatibility only and should
//! not be used for security-sensitive applications.

// =============================================================================
// SHA-256
// =============================================================================

/// SHA-256 hash output (32 bytes / 256 bits)
pub struct Sha256Hash {
    bytes: [u8; 32]
}

/// SHA-256 initial hash values
let SHA256_H: [u32; 8] = [
    0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
    0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19
];

/// SHA-256 round constants
let SHA256_K: [u32; 64] = [
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
];

/// Computes SHA-256 hash of the input data.
///
/// # Example
/// ```sio
/// let hash = sha256("hello".as_bytes())
/// let hex = hash_to_hex(&hash.bytes)
/// // "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824"
/// ```
pub fn sha256(data: &[u8]) -> Sha256Hash with Alloc {
    // Initialize hash state
    var h: [u32; 8] = SHA256_H;

    // Pre-processing: adding padding bits
    let msg_len = data.len();
    let bit_len = (msg_len as u64) * 8;

    // Message + 1 byte (0x80) + padding + 8 bytes (length)
    let padded_len = ((msg_len + 9 + 63) / 64) * 64;
    var padded: Vec<u8> = Vec::with_capacity(padded_len);

    // Copy message
    for b in data {
        padded.push(*b);
    }

    // Append 0x80
    padded.push(0x80);

    // Pad with zeros
    while padded.len() < padded_len - 8 {
        padded.push(0);
    }

    // Append length as big-endian 64-bit
    padded.push((bit_len >> 56) as u8);
    padded.push((bit_len >> 48) as u8);
    padded.push((bit_len >> 40) as u8);
    padded.push((bit_len >> 32) as u8);
    padded.push((bit_len >> 24) as u8);
    padded.push((bit_len >> 16) as u8);
    padded.push((bit_len >> 8) as u8);
    padded.push(bit_len as u8);

    // Process each 512-bit (64-byte) block
    var block_start: usize = 0;
    while block_start < padded.len() {
        var w: [u32; 64] = [0u32; 64];

        // Copy block into first 16 words
        var i: usize = 0;
        while i < 16 {
            let offset = block_start + i * 4;
            w[i] = ((padded[offset] as u32) << 24) |
                   ((padded[offset + 1] as u32) << 16) |
                   ((padded[offset + 2] as u32) << 8) |
                   (padded[offset + 3] as u32);
            i = i + 1;
        }

        // Extend to 64 words
        var i: usize = 16;
        while i < 64 {
            let s0 = rotr32(w[i-15], 7) ^ rotr32(w[i-15], 18) ^ (w[i-15] >> 3);
            let s1 = rotr32(w[i-2], 17) ^ rotr32(w[i-2], 19) ^ (w[i-2] >> 10);
            w[i] = w[i-16].wrapping_add(s0).wrapping_add(w[i-7]).wrapping_add(s1);
            i = i + 1;
        }

        // Initialize working variables
        var a = h[0];
        var b = h[1];
        var c = h[2];
        var d = h[3];
        var e = h[4];
        var f = h[5];
        var g = h[6];
        var hh = h[7];

        // Main loop
        var i: usize = 0;
        while i < 64 {
            let S1 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25);
            let ch = (e & f) ^ ((!e) & g);
            let temp1 = hh.wrapping_add(S1).wrapping_add(ch).wrapping_add(SHA256_K[i]).wrapping_add(w[i]);
            let S0 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22);
            let maj = (a & b) ^ (a & c) ^ (b & c);
            let temp2 = S0.wrapping_add(maj);

            hh = g;
            g = f;
            f = e;
            e = d.wrapping_add(temp1);
            d = c;
            c = b;
            b = a;
            a = temp1.wrapping_add(temp2);
            i = i + 1;
        }

        // Add to hash state
        h[0] = h[0].wrapping_add(a);
        h[1] = h[1].wrapping_add(b);
        h[2] = h[2].wrapping_add(c);
        h[3] = h[3].wrapping_add(d);
        h[4] = h[4].wrapping_add(e);
        h[5] = h[5].wrapping_add(f);
        h[6] = h[6].wrapping_add(g);
        h[7] = h[7].wrapping_add(hh);

        block_start = block_start + 64;
    }

    // Produce final hash
    var result: [u8; 32] = [0u8; 32];
    var i: usize = 0;
    while i < 8 {
        result[i*4] = (h[i] >> 24) as u8;
        result[i*4 + 1] = (h[i] >> 16) as u8;
        result[i*4 + 2] = (h[i] >> 8) as u8;
        result[i*4 + 3] = h[i] as u8;
        i = i + 1;
    }

    Sha256Hash { bytes: result }
}

/// Returns the bytes of a SHA-256 hash.
pub fn sha256_bytes(hash: &Sha256Hash) -> &[u8; 32] {
    &hash.bytes
}

// =============================================================================
// SHA-512
// =============================================================================

/// SHA-512 hash output (64 bytes / 512 bits)
pub struct Sha512Hash {
    bytes: [u8; 64]
}

/// SHA-512 initial hash values
let SHA512_H: [u64; 8] = [
    0x6a09e667f3bcc908, 0xbb67ae8584caa73b, 0x3c6ef372fe94f82b, 0xa54ff53a5f1d36f1,
    0x510e527fade682d1, 0x9b05688c2b3e6c1f, 0x1f83d9abfb41bd6b, 0x5be0cd19137e2179
];

/// SHA-512 round constants
let SHA512_K: [u64; 80] = [
    0x428a2f98d728ae22, 0x7137449123ef65cd, 0xb5c0fbcfec4d3b2f, 0xe9b5dba58189dbbc,
    0x3956c25bf348b538, 0x59f111f1b605d019, 0x923f82a4af194f9b, 0xab1c5ed5da6d8118,
    0xd807aa98a3030242, 0x12835b0145706fbe, 0x243185be4ee4b28c, 0x550c7dc3d5ffb4e2,
    0x72be5d74f27b896f, 0x80deb1fe3b1696b1, 0x9bdc06a725c71235, 0xc19bf174cf692694,
    0xe49b69c19ef14ad2, 0xefbe4786384f25e3, 0x0fc19dc68b8cd5b5, 0x240ca1cc77ac9c65,
    0x2de92c6f592b0275, 0x4a7484aa6ea6e483, 0x5cb0a9dcbd41fbd4, 0x76f988da831153b5,
    0x983e5152ee66dfab, 0xa831c66d2db43210, 0xb00327c898fb213f, 0xbf597fc7beef0ee4,
    0xc6e00bf33da88fc2, 0xd5a79147930aa725, 0x06ca6351e003826f, 0x142929670a0e6e70,
    0x27b70a8546d22ffc, 0x2e1b21385c26c926, 0x4d2c6dfc5ac42aed, 0x53380d139d95b3df,
    0x650a73548baf63de, 0x766a0abb3c77b2a8, 0x81c2c92e47edaee6, 0x92722c851482353b,
    0xa2bfe8a14cf10364, 0xa81a664bbc423001, 0xc24b8b70d0f89791, 0xc76c51a30654be30,
    0xd192e819d6ef5218, 0xd69906245565a910, 0xf40e35855771202a, 0x106aa07032bbd1b8,
    0x19a4c116b8d2d0c8, 0x1e376c085141ab53, 0x2748774cdf8eeb99, 0x34b0bcb5e19b48a8,
    0x391c0cb3c5c95a63, 0x4ed8aa4ae3418acb, 0x5b9cca4f7763e373, 0x682e6ff3d6b2b8a3,
    0x748f82ee5defb2fc, 0x78a5636f43172f60, 0x84c87814a1f0ab72, 0x8cc702081a6439ec,
    0x90befffa23631e28, 0xa4506cebde82bde9, 0xbef9a3f7b2c67915, 0xc67178f2e372532b,
    0xca273eceea26619c, 0xd186b8c721c0c207, 0xeada7dd6cde0eb1e, 0xf57d4f7fee6ed178,
    0x06f067aa72176fba, 0x0a637dc5a2c898a6, 0x113f9804bef90dae, 0x1b710b35131c471b,
    0x28db77f523047d84, 0x32caab7b40c72493, 0x3c9ebe0a15c9bebc, 0x431d67c49c100d4c,
    0x4cc5d4becb3e42b6, 0x597f299cfc657e2a, 0x5fcb6fab3ad6faec, 0x6c44198c4a475817
];

/// Computes SHA-512 hash of the input data.
pub fn sha512(data: &[u8]) -> Sha512Hash with Alloc {
    var h: [u64; 8] = SHA512_H;

    let msg_len = data.len();
    let bit_len = (msg_len as u128) * 8;

    // Padded length (multiple of 128 bytes)
    let padded_len = ((msg_len + 17 + 127) / 128) * 128;
    var padded: Vec<u8> = Vec::with_capacity(padded_len);

    for b in data {
        padded.push(*b);
    }
    padded.push(0x80);

    while padded.len() < padded_len - 16 {
        padded.push(0);
    }

    // Append 128-bit length (only using lower 64 bits for simplicity)
    var i: usize = 0;
    while i < 8 {
        padded.push(0);
        i = i + 1;
    }
    let len64 = bit_len as u64;
    padded.push((len64 >> 56) as u8);
    padded.push((len64 >> 48) as u8);
    padded.push((len64 >> 40) as u8);
    padded.push((len64 >> 32) as u8);
    padded.push((len64 >> 24) as u8);
    padded.push((len64 >> 16) as u8);
    padded.push((len64 >> 8) as u8);
    padded.push(len64 as u8);

    // Process 1024-bit blocks
    var block_start: usize = 0;
    while block_start < padded.len() {
        var w: [u64; 80] = [0u64; 80];

        var i: usize = 0;
        while i < 16 {
            let offset = block_start + i * 8;
            w[i] = ((padded[offset] as u64) << 56) |
                   ((padded[offset+1] as u64) << 48) |
                   ((padded[offset+2] as u64) << 40) |
                   ((padded[offset+3] as u64) << 32) |
                   ((padded[offset+4] as u64) << 24) |
                   ((padded[offset+5] as u64) << 16) |
                   ((padded[offset+6] as u64) << 8) |
                   (padded[offset+7] as u64);
            i = i + 1;
        }

        var i: usize = 16;
        while i < 80 {
            let s0 = rotr64(w[i-15], 1) ^ rotr64(w[i-15], 8) ^ (w[i-15] >> 7);
            let s1 = rotr64(w[i-2], 19) ^ rotr64(w[i-2], 61) ^ (w[i-2] >> 6);
            w[i] = w[i-16].wrapping_add(s0).wrapping_add(w[i-7]).wrapping_add(s1);
            i = i + 1;
        }

        var a = h[0];
        var b = h[1];
        var c = h[2];
        var d = h[3];
        var e = h[4];
        var f = h[5];
        var g = h[6];
        var hh = h[7];

        var i: usize = 0;
        while i < 80 {
            let S1 = rotr64(e, 14) ^ rotr64(e, 18) ^ rotr64(e, 41);
            let ch = (e & f) ^ ((!e) & g);
            let temp1 = hh.wrapping_add(S1).wrapping_add(ch).wrapping_add(SHA512_K[i]).wrapping_add(w[i]);
            let S0 = rotr64(a, 28) ^ rotr64(a, 34) ^ rotr64(a, 39);
            let maj = (a & b) ^ (a & c) ^ (b & c);
            let temp2 = S0.wrapping_add(maj);

            hh = g;
            g = f;
            f = e;
            e = d.wrapping_add(temp1);
            d = c;
            c = b;
            b = a;
            a = temp1.wrapping_add(temp2);
            i = i + 1;
        }

        h[0] = h[0].wrapping_add(a);
        h[1] = h[1].wrapping_add(b);
        h[2] = h[2].wrapping_add(c);
        h[3] = h[3].wrapping_add(d);
        h[4] = h[4].wrapping_add(e);
        h[5] = h[5].wrapping_add(f);
        h[6] = h[6].wrapping_add(g);
        h[7] = h[7].wrapping_add(hh);

        block_start = block_start + 128;
    }

    var result: [u8; 64] = [0u8; 64];
    var i: usize = 0;
    while i < 8 {
        result[i*8] = (h[i] >> 56) as u8;
        result[i*8 + 1] = (h[i] >> 48) as u8;
        result[i*8 + 2] = (h[i] >> 40) as u8;
        result[i*8 + 3] = (h[i] >> 32) as u8;
        result[i*8 + 4] = (h[i] >> 24) as u8;
        result[i*8 + 5] = (h[i] >> 16) as u8;
        result[i*8 + 6] = (h[i] >> 8) as u8;
        result[i*8 + 7] = h[i] as u8;
        i = i + 1;
    }

    Sha512Hash { bytes: result }
}

/// Returns the bytes of a SHA-512 hash.
pub fn sha512_bytes(hash: &Sha512Hash) -> &[u8; 64] {
    &hash.bytes
}

// =============================================================================
// MD5 (Legacy - Not Secure)
// =============================================================================

/// MD5 hash output (16 bytes / 128 bits)
///
/// Warning: MD5 is cryptographically broken and should not be used for
/// security-sensitive applications.
pub struct Md5Hash {
    bytes: [u8; 16]
}

/// Computes MD5 hash of the input data.
///
/// Warning: MD5 is cryptographically broken and should not be used for
/// security-sensitive applications. Use SHA-256 instead.
pub fn md5(data: &[u8]) -> Md5Hash with Alloc {
    // MD5 constants
    let s: [u32; 64] = [
        7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22,
        5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20,
        4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23,
        6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21
    ];

    let k: [u32; 64] = [
        0xd76aa478, 0xe8c7b756, 0x242070db, 0xc1bdceee, 0xf57c0faf, 0x4787c62a, 0xa8304613, 0xfd469501,
        0x698098d8, 0x8b44f7af, 0xffff5bb1, 0x895cd7be, 0x6b901122, 0xfd987193, 0xa679438e, 0x49b40821,
        0xf61e2562, 0xc040b340, 0x265e5a51, 0xe9b6c7aa, 0xd62f105d, 0x02441453, 0xd8a1e681, 0xe7d3fbc8,
        0x21e1cde6, 0xc33707d6, 0xf4d50d87, 0x455a14ed, 0xa9e3e905, 0xfcefa3f8, 0x676f02d9, 0x8d2a4c8a,
        0xfffa3942, 0x8771f681, 0x6d9d6122, 0xfde5380c, 0xa4beea44, 0x4bdecfa9, 0xf6bb4b60, 0xbebfbc70,
        0x289b7ec6, 0xeaa127fa, 0xd4ef3085, 0x04881d05, 0xd9d4d039, 0xe6db99e5, 0x1fa27cf8, 0xc4ac5665,
        0xf4292244, 0x432aff97, 0xab9423a7, 0xfc93a039, 0x655b59c3, 0x8f0ccc92, 0xffeff47d, 0x85845dd1,
        0x6fa87e4f, 0xfe2ce6e0, 0xa3014314, 0x4e0811a1, 0xf7537e82, 0xbd3af235, 0x2ad7d2bb, 0xeb86d391
    ];

    var a0: u32 = 0x67452301;
    var b0: u32 = 0xefcdab89;
    var c0: u32 = 0x98badcfe;
    var d0: u32 = 0x10325476;

    let msg_len = data.len();
    let bit_len = (msg_len as u64) * 8;
    let padded_len = ((msg_len + 9 + 63) / 64) * 64;
    var padded: Vec<u8> = Vec::with_capacity(padded_len);

    for b in data {
        padded.push(*b);
    }
    padded.push(0x80);
    while padded.len() < padded_len - 8 {
        padded.push(0);
    }

    // Length in little-endian
    padded.push(bit_len as u8);
    padded.push((bit_len >> 8) as u8);
    padded.push((bit_len >> 16) as u8);
    padded.push((bit_len >> 24) as u8);
    padded.push((bit_len >> 32) as u8);
    padded.push((bit_len >> 40) as u8);
    padded.push((bit_len >> 48) as u8);
    padded.push((bit_len >> 56) as u8);

    var chunk_start: usize = 0;
    while chunk_start < padded.len() {
        var m: [u32; 16] = [0u32; 16];
        var j: usize = 0;
        while j < 16 {
            let offset = chunk_start + j * 4;
            m[j] = (padded[offset] as u32) |
                   ((padded[offset+1] as u32) << 8) |
                   ((padded[offset+2] as u32) << 16) |
                   ((padded[offset+3] as u32) << 24);
            j = j + 1;
        }

        var a = a0;
        var b = b0;
        var c = c0;
        var d = d0;

        var i: usize = 0;
        while i < 64 {
            var f: u32;
            var g: usize;

            if i < 16 {
                f = (b & c) | ((!b) & d);
                g = i;
            } else if i < 32 {
                f = (d & b) | ((!d) & c);
                g = (5 * i + 1) % 16;
            } else if i < 48 {
                f = b ^ c ^ d;
                g = (3 * i + 5) % 16;
            } else {
                f = c ^ (b | (!d));
                g = (7 * i) % 16;
            }

            f = f.wrapping_add(a).wrapping_add(k[i]).wrapping_add(m[g]);
            a = d;
            d = c;
            c = b;
            b = b.wrapping_add(rotl32(f, s[i]));
            i = i + 1;
        }

        a0 = a0.wrapping_add(a);
        b0 = b0.wrapping_add(b);
        c0 = c0.wrapping_add(c);
        d0 = d0.wrapping_add(d);

        chunk_start = chunk_start + 64;
    }

    var result: [u8; 16] = [0u8; 16];
    // Little-endian output
    result[0] = a0 as u8; result[1] = (a0 >> 8) as u8; result[2] = (a0 >> 16) as u8; result[3] = (a0 >> 24) as u8;
    result[4] = b0 as u8; result[5] = (b0 >> 8) as u8; result[6] = (b0 >> 16) as u8; result[7] = (b0 >> 24) as u8;
    result[8] = c0 as u8; result[9] = (c0 >> 8) as u8; result[10] = (c0 >> 16) as u8; result[11] = (c0 >> 24) as u8;
    result[12] = d0 as u8; result[13] = (d0 >> 8) as u8; result[14] = (d0 >> 16) as u8; result[15] = (d0 >> 24) as u8;

    Md5Hash { bytes: result }
}

/// Returns the bytes of an MD5 hash.
pub fn md5_bytes(hash: &Md5Hash) -> &[u8; 16] {
    &hash.bytes
}

// =============================================================================
// Helper Functions
// =============================================================================

fn rotr32(x: u32, n: u32) -> u32 {
    (x >> n) | (x << (32 - n))
}

fn rotl32(x: u32, n: u32) -> u32 {
    (x << n) | (x >> (32 - n))
}

fn rotr64(x: u64, n: u32) -> u64 {
    (x >> n) | (x << (64 - n as u64))
}

// =============================================================================
// Utility Functions
// =============================================================================

/// Converts hash bytes to hexadecimal string.
pub fn hash_to_hex(bytes: &[u8]) -> string with Alloc {
    let hex_chars = "0123456789abcdef";
    var result = String::with_capacity(bytes.len() * 2);

    for b in bytes {
        result.push(hex_chars.char_at((*b >> 4) as usize));
        result.push(hex_chars.char_at((*b & 0xf) as usize));
    }

    result
}

/// Parses hexadecimal string to bytes.
pub fn hex_to_bytes(hex: &str) -> Option<Vec<u8>> with Alloc {
    if hex.len() % 2 != 0 {
        return None
    }

    var result: Vec<u8> = Vec::with_capacity(hex.len() / 2);
    var i: usize = 0;

    while i < hex.len() {
        let hi = hex_char_to_nibble(hex.char_at(i))?;
        let lo = hex_char_to_nibble(hex.char_at(i + 1))?;
        result.push((hi << 4) | lo);
        i = i + 2;
    }

    Some(result)
}

fn hex_char_to_nibble(c: char) -> Option<u8> {
    if c >= '0' && c <= '9' {
        Some((c as u8) - ('0' as u8))
    } else if c >= 'a' && c <= 'f' {
        Some((c as u8) - ('a' as u8) + 10)
    } else if c >= 'A' && c <= 'F' {
        Some((c as u8) - ('A' as u8) + 10)
    } else {
        None
    }
}

/// Computes SHA-256 of a string.
pub fn sha256_string(s: &str) -> Sha256Hash with Alloc {
    sha256(s.as_bytes())
}

/// Computes MD5 of a string.
pub fn md5_string(s: &str) -> Md5Hash with Alloc {
    md5(s.as_bytes())
}

/// Compares two hash byte arrays in constant time.
pub fn hash_equals(a: &[u8], b: &[u8]) -> bool {
    if a.len() != b.len() {
        return false
    }

    var result: u8 = 0;
    var i: usize = 0;
    while i < a.len() {
        result = result | (a[i] ^ b[i]);
        i = i + 1;
    }

    result == 0
}
