//! stdlib/complex/lib.sio - Complex number arithmetic
//!
//! Provides complex number operations for scientific computing:
//! - Basic arithmetic (add, sub, mul, div)
//! - Properties (abs, arg, conj, norm_sq)
//! - Polar form conversion
//! - Exponential and trigonometric functions
//!
//! Uses principal branch for multi-valued functions (log, sqrt, pow).

// Madaros registers at most five symbols per extern "C" block (6th is dropped
// as undeclared). Keep the first five here; put two-arg atan2 in a second block.
// #1622: these were `extern "C"` bindings to libm. The native backend has no
// dynamic linker, so every call compiled to a stub returning 0. The builtin
// names it does implement (sqrt, exp, log, sin, cos) need no declaration.
use math::libm::{libm_atan2}
// Polar coordinate result
pub struct PolarCoord {
    r: f64,
    theta: f64,
}

// Epistemic magnitude result
pub struct EAbsResult {
    r: f64,
    u: f64,
}

// Result struct for quadratic roots
pub struct QuadRoots {
    r1: Complex,
    r2: Complex,
}

// A complex number z = re + im*i
pub struct Complex {
    re: f64,
    im: f64,
}

// Create a new complex number
pub fn complex_new(re: f64, im: f64) -> Complex {
    Complex { re: re, im: im }
}

// Complex zero: 0 + 0i
pub fn complex_zero() -> Complex {
    Complex { re: 0.0, im: 0.0 }
}

// Complex one: 1 + 0i
pub fn complex_one() -> Complex {
    Complex { re: 1.0, im: 0.0 }
}

// Imaginary unit: 0 + 1i
pub fn complex_i() -> Complex {
    Complex { re: 0.0, im: 1.0 }
}

// =============================================================================
// ARITHMETIC OPERATIONS
// =============================================================================

// Add two complex numbers: (a + bi) + (c + di) = (a+c) + (b+d)i
pub fn complex_add(a: Complex, b: Complex) -> Complex {
    complex_new(a.re + b.re, a.im + b.im)
}

// Subtract two complex numbers: (a + bi) - (c + di) = (a-c) + (b-d)i
pub fn complex_sub(a: Complex, b: Complex) -> Complex {
    complex_new(a.re - b.re, a.im - b.im)
}

// Multiply two complex numbers: (a + bi)(c + di) = (ac - bd) + (ad + bc)i
pub fn complex_mul(a: Complex, b: Complex) -> Complex {
    let re = a.re * b.re - a.im * b.im
    let im = a.re * b.im + a.im * b.re
    complex_new(re, im)
}

// Divide two complex numbers: (a + bi)/(c + di)
pub fn complex_div(a: Complex, b: Complex) -> Complex with Div, Panic {
    let denom = b.re * b.re + b.im * b.im
    let re = (a.re * b.re + a.im * b.im) / denom
    let im = (a.im * b.re - a.re * b.im) / denom
    complex_new(re, im)
}

// Scale a complex number by a real scalar
pub fn complex_scale(z: Complex, s: f64) -> Complex {
    complex_new(z.re * s, z.im * s)
}

// Negate a complex number: -(a + bi) = -a - bi
pub fn complex_neg(z: Complex) -> Complex {
    complex_new(0.0 - z.re, 0.0 - z.im)
}

// =============================================================================
// PROPERTIES
// =============================================================================

// Absolute value (magnitude): |z| = sqrt(re² + im²)
pub fn complex_abs(z: Complex) -> f64 {
    sqrt(z.re * z.re + z.im * z.im)
}

// Squared magnitude: |z|² = re² + im²
// More efficient than abs() when you don't need the square root
pub fn complex_norm_sq(z: Complex) -> f64 {
    z.re * z.re + z.im * z.im
}

// Argument (phase angle): arg(z) = libm_atan2(im, re)
// Returns value in [-π, π]
pub fn complex_arg(z: Complex) -> f64 with Mut, Div, Panic {
    libm_atan2(z.im, z.re)
}

// Complex conjugate: conj(a + bi) = a - bi
pub fn complex_conj(z: Complex) -> Complex {
    complex_new(z.re, 0.0 - z.im)
}

// Check if two complex numbers are equal (exact comparison)
pub fn complex_eq(a: Complex, b: Complex) -> bool {
    a.re == b.re && a.im == b.im
}

// Check if complex number is zero
pub fn complex_is_zero(z: Complex) -> bool {
    z.re == 0.0 && z.im == 0.0
}

// =============================================================================
// POLAR FORM
// =============================================================================

// Create complex from polar coordinates: r * (cos(θ) + i*sin(θ))
pub fn complex_from_polar(r: f64, theta: f64) -> Complex {
    let re = r * cos(theta)
    let im = r * sin(theta)
    complex_new(re, im)
}

// Convert to polar coordinates: returns (r, theta)
pub fn complex_to_polar(z: Complex) -> PolarCoord with Mut, Div, Panic {
    let r = complex_abs(z)
    let theta = complex_arg(z)
    PolarCoord { r: r, theta: theta }
}

// =============================================================================
// EXPONENTIAL AND LOGARITHMIC
// =============================================================================

// Complex exponential: e^(a+bi) = e^a * (cos(b) + i*sin(b))
// Uses Euler's formula
pub fn complex_exp(z: Complex) -> Complex {
    let e_a = exp(z.re)
    let re = e_a * cos(z.im)
    let im = e_a * sin(z.im)
    complex_new(re, im)
}

// Complex natural logarithm: ln(z) = ln|z| + i*arg(z)
// Principal branch with arg in [-π, π]
pub fn complex_log(z: Complex) -> Complex with Mut, Div, Panic {
    let r = complex_abs(z)
    let theta = complex_arg(z)
    complex_new(log(r), theta)
}

// Complex square root: sqrt(z) = sqrt|z| * e^(i*arg(z)/2)
// Principal branch (positive real part when possible)
pub fn complex_sqrt(z: Complex) -> Complex with Div, Mut, Panic {
    if z.re == 0.0 && z.im == 0.0 {
        return complex_zero()
    }
    let r = complex_abs(z)
    let theta = complex_arg(z) / 2.0
    let s = sqrt(r)
    complex_new(s * cos(theta), s * sin(theta))
}

// Complex power: base^exponent = exp(exponent * log(base))
pub fn complex_pow(base: Complex, exponent: Complex) -> Complex with Mut, Div, Panic {
    let log_base = complex_log(base)
    let prod = complex_mul(log_base, exponent)
    complex_exp(prod)
}

// Complex to real power: z^n where n is real
pub fn complex_pow_real(z: Complex, n: f64) -> Complex with Mut, Div, Panic {
    let log_z = complex_log(z)
    let scaled = complex_scale(log_z, n)
    complex_exp(scaled)
}

// =============================================================================
// TRIGONOMETRIC FUNCTIONS
// =============================================================================

// Complex sine: sin(a + bi) = sin(a)*cosh(b) + i*cos(a)*sinh(b)
pub fn complex_sin(z: Complex) -> Complex with Panic {
    let a = z.re
    let b = z.im
    let sa = sin(a)
    let ca = cos(a)
    let eb = exp(b)
    let e_nb = exp(0.0 - b)
    let chb = (eb + e_nb) / 2.0
    let shb = (eb - e_nb) / 2.0
    complex_new(sa * chb, ca * shb)
}

// Complex cosine: cos(a + bi) = cos(a)*cosh(b) - i*sin(a)*sinh(b)
pub fn complex_cos(z: Complex) -> Complex with Panic {
    let a = z.re
    let b = z.im
    let sa = sin(a)
    let ca = cos(a)
    let eb = exp(b)
    let e_nb = exp(0.0 - b)
    let chb = (eb + e_nb) / 2.0
    let shb = (eb - e_nb) / 2.0
    complex_new(ca * chb, 0.0 - sa * shb)
}

// Complex tangent: tan(z) = sin(z) / cos(z)
pub fn complex_tan(z: Complex) -> Complex with Div, Panic {
    let s = complex_sin(z)
    let c = complex_cos(z)
    complex_div(s, c)
}

// =============================================================================
// HYPERBOLIC FUNCTIONS
// =============================================================================

// Complex hyperbolic sine: sinh(z) = (e^z - e^(-z)) / 2
pub fn complex_sinh(z: Complex) -> Complex {
    let e_z = complex_exp(z)
    let e_neg_z = complex_exp(complex_neg(z))
    let diff = complex_sub(e_z, e_neg_z)
    complex_scale(diff, 0.5)
}

// Complex hyperbolic cosine: cosh(z) = (e^z + e^(-z)) / 2
pub fn complex_cosh(z: Complex) -> Complex {
    let e_z = complex_exp(z)
    let e_neg_z = complex_exp(complex_neg(z))
    let sum = complex_add(e_z, e_neg_z)
    complex_scale(sum, 0.5)
}

// Complex hyperbolic tangent: tanh(z) = sinh(z) / cosh(z)
pub fn complex_tanh(z: Complex) -> Complex with Div, Panic {
    let s = complex_sinh(z)
    let c = complex_cosh(z)
    complex_div(s, c)
}

// =============================================================================
// POLYNOMIAL ROOTS
// =============================================================================

// Quadratic formula for ax² + bx + c = 0 over the complex numbers.
// Returns (root1, root2) using the principal branch of sqrt.
// Discriminant D = b² - 4ac; roots = (-b ± sqrt(D)) / (2a)
pub fn complex_quadratic_roots(a: f64, b: f64, c: f64) -> QuadRoots with Div, Mut, Panic {
    // discriminant as complex number (may be negative → imaginary sqrt)
    let disc_re = b * b - 4.0 * a * c
    let disc_c = complex_new(disc_re, 0.0)
    let sq = complex_sqrt(disc_c)
    let neg_b = complex_new(0.0 - b, 0.0)
    let two_a = 2.0 * a
    let r1 = complex_scale(complex_add(neg_b, sq), 1.0 / two_a)
    let r2 = complex_scale(complex_sub(neg_b, sq), 1.0 / two_a)
    QuadRoots { r1: r1, r2: r2 }
}

// =============================================================================
// EPISTEMIC COMPLEX — GUM uncertainty propagation
// =============================================================================

// A complex number with independent GUM standard uncertainties on re and im.
// re_unc and im_unc are standard (k=1) uncertainties.
pub struct EpistemicComplex {
    value: Complex,
    re_unc: f64,
    im_unc: f64,
}

// Construct an EpistemicComplex
pub fn ecomplex_new(re: f64, im: f64, re_unc: f64, im_unc: f64) -> EpistemicComplex {
    EpistemicComplex {
        value: complex_new(re, im),
        re_unc: re_unc,
        im_unc: im_unc,
    }
}

// Addition: (a + b), uncertainties add in quadrature (GUM §5.1)
// u²(re) = u²(a.re) + u²(b.re), same for im
pub fn ecomplex_add(a: EpistemicComplex, b: EpistemicComplex) -> EpistemicComplex {
    let val = complex_add(a.value, b.value)
    let ru = sqrt(a.re_unc * a.re_unc + b.re_unc * b.re_unc)
    let iu = sqrt(a.im_unc * a.im_unc + b.im_unc * b.im_unc)
    EpistemicComplex { value: val, re_unc: ru, im_unc: iu }
}

// Subtraction: (a - b), uncertainties add in quadrature (GUM §5.1)
pub fn ecomplex_sub(a: EpistemicComplex, b: EpistemicComplex) -> EpistemicComplex {
    let val = complex_sub(a.value, b.value)
    let ru = sqrt(a.re_unc * a.re_unc + b.re_unc * b.re_unc)
    let iu = sqrt(a.im_unc * a.im_unc + b.im_unc * b.im_unc)
    EpistemicComplex { value: val, re_unc: ru, im_unc: iu }
}

// Multiplication: (a * b), GUM first-order propagation.
// z = (ar + i·ai)(br + i·bi) = (ar·br - ai·bi) + i(ar·bi + ai·br)
// ∂re/∂ar = br,  ∂re/∂ai = -bi,  ∂re/∂br = ar,  ∂re/∂bi = -ai
// ∂im/∂ar = bi,  ∂im/∂ai =  br,  ∂im/∂br = ai,  ∂im/∂bi =  ar
pub fn ecomplex_mul(a: EpistemicComplex, b: EpistemicComplex) -> EpistemicComplex {
    let val = complex_mul(a.value, b.value)
    let ar = a.value.re
    let ai = a.value.im
    let br = b.value.re
    let bi = b.value.im
    // u²(re) = (br·u_ar)² + (bi·u_ai)² + (ar·u_br)² + (ai·u_bi)²
    let ru_sq = br * br * a.re_unc * a.re_unc
              + bi * bi * a.im_unc * a.im_unc
              + ar * ar * b.re_unc * b.re_unc
              + ai * ai * b.im_unc * b.im_unc
    // u²(im) = (bi·u_ar)² + (br·u_ai)² + (ai·u_br)² + (ar·u_bi)²
    let iu_sq = bi * bi * a.re_unc * a.re_unc
              + br * br * a.im_unc * a.im_unc
              + ai * ai * b.re_unc * b.re_unc
              + ar * ar * b.im_unc * b.im_unc
    EpistemicComplex { value: val, re_unc: sqrt(ru_sq), im_unc: sqrt(iu_sq) }
}

// Magnitude with GUM uncertainty: |z| = sqrt(re² + im²)
// ∂|z|/∂re = re/|z|,  ∂|z|/∂im = im/|z|
// Returns (|z|, u(|z|))
pub fn ecomplex_abs(z: EpistemicComplex) -> EAbsResult with Div, Panic {
    let r = complex_abs(z.value)
    if r == 0.0 {
        return EAbsResult { r: 0.0, u: sqrt(z.re_unc * z.re_unc + z.im_unc * z.im_unc) }
    }
    let d_re = z.value.re / r
    let d_im = z.value.im / r
    let u = sqrt(d_re * d_re * z.re_unc * z.re_unc + d_im * d_im * z.im_unc * z.im_unc)
    EAbsResult { r: r, u: u }
}

// Complex exponential with GUM uncertainty: e^z = e^re · (cos(im) + i·sin(im))
// ∂re(e^z)/∂re = e^re · cos(im),  ∂re(e^z)/∂im = -e^re · sin(im)
// ∂im(e^z)/∂re = e^re · sin(im),  ∂im(e^z)/∂im =  e^re · cos(im)
pub fn ecomplex_exp(z: EpistemicComplex) -> EpistemicComplex {
    let val = complex_exp(z.value)
    let e_re = exp(z.value.re)
    let c_im = cos(z.value.im)
    let s_im = sin(z.value.im)
    // Jacobian rows
    let j_rr = e_re * c_im
    let j_ri = 0.0 - e_re * s_im
    let j_ir = e_re * s_im
    let j_ii = e_re * c_im
    let ru = sqrt(j_rr * j_rr * z.re_unc * z.re_unc + j_ri * j_ri * z.im_unc * z.im_unc)
    let iu = sqrt(j_ir * j_ir * z.re_unc * z.re_unc + j_ii * j_ii * z.im_unc * z.im_unc)
    EpistemicComplex { value: val, re_unc: ru, im_unc: iu }
}
