// Graphics SVG — Vector export bridge
//
// Generates SVG markup from the same plot configs used by the raster modules.
// Counterpart to plot::export (terminal/SVG).
// Output is written to stdout via print/println.

use graphics::drawing::{Color}

// ============================================================================
// LINE PLOT SVG
// ============================================================================

pub fn svg_line_plot(
    xs: &[f64; 256],
    ys: &[f64; 256],
    n: i64,
    width: i64,
    height: i64,
    margin: i64,
    line_color: Color,
    bg_color: Color,
    axis_color: Color
) with IO, Mut, Div, Panic {
    if n <= 0 { return }

    // Find bounds
    var xmin = xs[0]
    var xmax = xs[0]
    var ymin = ys[0]
    var ymax = ys[0]
    var i: i64 = 1
    while i < n {
        if xs[i] < xmin { xmin = xs[i] }
        if xs[i] > xmax { xmax = xs[i] }
        if ys[i] < ymin { ymin = ys[i] }
        if ys[i] > ymax { ymax = ys[i] }
        i = i + 1
    }

    let x_range = xmax - xmin
    let y_range = ymax - ymin
    let plot_w = width - margin * 2
    let plot_h = height - margin * 2

    // Header
    svg_emit_header(width, height)

    // Background
    svg_emit_rect(0, 0, width, height, bg_color)

    // Axes
    svg_emit_line(margin, margin, margin, height - margin, axis_color)
    svg_emit_line(margin, height - margin, width - margin, height - margin, axis_color)

    // Line path
    print("<polyline fill=\"none\" stroke=\"")
    svg_emit_color_hex(line_color)
    print("\" stroke-width=\"2\" points=\"")
    var j: i64 = 0
    while j < n {
        let xf = if x_range == 0.0 { 0.0 } else { (xs[j] - xmin) / x_range }
        let yf = if y_range == 0.0 { 0.0 } else { (ys[j] - ymin) / y_range }
        let px = margin + (xf * (plot_w as f64)) as i64
        let py = height - margin - (yf * (plot_h as f64)) as i64
        svg_emit_i64(px)
        print(",")
        svg_emit_i64(py)
        if j < n - 1 { print(" ") }
        j = j + 1
    }
    println("\"/>")

    // Footer
    svg_emit_footer()
}

// ============================================================================
// SCATTER PLOT SVG
// ============================================================================

pub fn svg_scatter_plot(
    xs: &[f64; 256],
    ys: &[f64; 256],
    n: i64,
    width: i64,
    height: i64,
    margin: i64,
    marker_color: Color,
    bg_color: Color,
    axis_color: Color
) with IO, Mut, Div, Panic {
    if n <= 0 { return }

    var xmin = xs[0]
    var xmax = xs[0]
    var ymin = ys[0]
    var ymax = ys[0]
    var i: i64 = 1
    while i < n {
        if xs[i] < xmin { xmin = xs[i] }
        if xs[i] > xmax { xmax = xs[i] }
        if ys[i] < ymin { ymin = ys[i] }
        if ys[i] > ymax { ymax = ys[i] }
        i = i + 1
    }

    let x_range = xmax - xmin
    let y_range = ymax - ymin
    let plot_w = width - margin * 2
    let plot_h = height - margin * 2

    svg_emit_header(width, height)
    svg_emit_rect(0, 0, width, height, bg_color)
    svg_emit_line(margin, margin, margin, height - margin, axis_color)
    svg_emit_line(margin, height - margin, width - margin, height - margin, axis_color)

    var j: i64 = 0
    while j < n {
        let xf = if x_range == 0.0 { 0.0 } else { (xs[j] - xmin) / x_range }
        let yf = if y_range == 0.0 { 0.0 } else { (ys[j] - ymin) / y_range }
        let px = margin + (xf * (plot_w as f64)) as i64
        let py = height - margin - (yf * (plot_h as f64)) as i64
        svg_emit_circle(px, py, 3, marker_color)
        j = j + 1
    }

    svg_emit_footer()
}

// ============================================================================
// HEATMAP SVG
// ============================================================================

pub fn svg_heatmap_plot(
    data: &[f64; 4096],
    rows: i64,
    cols: i64,
    width: i64,
    height: i64,
    margin: i64,
    bg_color: Color,
    axis_color: Color
) with IO, Mut, Div, Panic {
    if rows <= 0 || cols <= 0 { return }

    var min_val = data[0]
    var max_val = data[0]
    var i: i64 = 1
    while i < rows * cols {
        if data[i] < min_val { min_val = data[i] }
        if data[i] > max_val { max_val = data[i] }
        i = i + 1
    }

    let range = max_val - min_val
    let plot_w = width - margin * 2
    let plot_h = height - margin * 2
    let cell_w = plot_w / cols
    let cell_h = plot_h / rows
    if cell_w <= 0 { return }
    if cell_h <= 0 { return }

    svg_emit_header(width, height)
    svg_emit_rect(0, 0, width, height, bg_color)
    svg_emit_line(margin, margin, margin, height - margin, axis_color)
    svg_emit_line(margin, height - margin, width - margin, height - margin, axis_color)

    var r: i64 = 0
    while r < rows {
        var c: i64 = 0
        while c < cols {
            let idx = r * cols + c
            let normalized = if range == 0.0 { 0.5 } else { (data[idx] - min_val) / range }
            let cell_color = svg_heatmap_color(normalized)
            let px = margin + c * cell_w
            let py = height - margin - (r + 1) * cell_h
            svg_emit_rect(px, py, cell_w, cell_h, cell_color)
            c = c + 1
        }
        r = r + 1
    }

    svg_emit_footer()
}

// ============================================================================
// EPISTEMIC BAND SVG
// ============================================================================

pub fn svg_epistemic_band_plot(
    xs: &[f64; 256],
    center: &[f64; 256],
    lower: &[f64; 256],
    upper: &[f64; 256],
    n: i64,
    width: i64,
    height: i64,
    margin: i64,
    center_color: Color,
    band_color: Color,
    bg_color: Color,
    axis_color: Color
) with IO, Mut, Div, Panic {
    if n <= 0 { return }

    var xmin = xs[0]
    var xmax = xs[0]
    var ymin = center[0]
    var ymax = center[0]
    var i: i64 = 0
    while i < n {
        if xs[i] < xmin { xmin = xs[i] }
        if xs[i] > xmax { xmax = xs[i] }
        if lower[i] < ymin { ymin = lower[i] }
        if upper[i] > ymax { ymax = upper[i] }
        i = i + 1
    }

    let x_range = xmax - xmin
    let y_range = ymax - ymin
    let plot_w = width - margin * 2
    let plot_h = height - margin * 2

    svg_emit_header(width, height)
    svg_emit_rect(0, 0, width, height, bg_color)
    svg_emit_line(margin, margin, margin, height - margin, axis_color)
    svg_emit_line(margin, height - margin, width - margin, height - margin, axis_color)

    // Filled band polygon: upper curve forward, lower curve backward
    print("<polygon fill=\"")
    svg_emit_color_hex(band_color)
    print("\" stroke=\"none\" points=\"")
    // Upper curve
    var j: i64 = 0
    while j < n {
        let xf = if x_range == 0.0 { 0.0 } else { (xs[j] - xmin) / x_range }
        let yf = if y_range == 0.0 { 0.0 } else { (upper[j] - ymin) / y_range }
        let px = margin + (xf * (plot_w as f64)) as i64
        let py = height - margin - (yf * (plot_h as f64)) as i64
        svg_emit_i64(px)
        print(",")
        svg_emit_i64(py)
        print(" ")
        j = j + 1
    }
    // Lower curve backward
    j = n - 1
    while j >= 0 {
        let xf = if x_range == 0.0 { 0.0 } else { (xs[j] - xmin) / x_range }
        let yf = if y_range == 0.0 { 0.0 } else { (lower[j] - ymin) / y_range }
        let px = margin + (xf * (plot_w as f64)) as i64
        let py = height - margin - (yf * (plot_h as f64)) as i64
        svg_emit_i64(px)
        print(",")
        svg_emit_i64(py)
        if j > 0 { print(" ") }
        j = j - 1
    }
    println("\"/>")

    // Center line
    print("<polyline fill=\"none\" stroke=\"")
    svg_emit_color_hex(center_color)
    print("\" stroke-width=\"2\" points=\"")
    j = 0
    while j < n {
        let xf = if x_range == 0.0 { 0.0 } else { (xs[j] - xmin) / x_range }
        let yf = if y_range == 0.0 { 0.0 } else { (center[j] - ymin) / y_range }
        let px = margin + (xf * (plot_w as f64)) as i64
        let py = height - margin - (yf * (plot_h as f64)) as i64
        svg_emit_i64(px)
        print(",")
        svg_emit_i64(py)
        if j < n - 1 { print(" ") }
        j = j + 1
    }
    println("\"/>")

    svg_emit_footer()
}

// ============================================================================
// ADVANCED EPISTEMIC SVG: CONFIDENCE DECAY
// ============================================================================

/// SVG emitter for a confidence decay curve.
/// Each consecutive pair of points is emitted as a short line segment with
/// its own stroke-opacity derived from the average confidence of the two points.
/// This gives a smooth visual decay effect in vector output (publication quality).
pub fn svg_confidence_decay_plot(
    xs: &[f64; 256],
    ys: &[f64; 256],
    conf: &[f64; 256],
    n: i64,
    width: i64,
    height: i64,
    margin: i64,
    line_color: Color,
    bg_color: Color,
    axis_color: Color,
    min_alpha: i64,
    max_alpha: i64
) with IO, Mut, Div, Panic {
    if n <= 1 { return }

    // Bounds (identical logic to other SVG plotters)
    var xmin = xs[0]
    var xmax = xs[0]
    var ymin = ys[0]
    var ymax = ys[0]
    var i: i64 = 1
    while i < n {
        if xs[i] < xmin { xmin = xs[i] }
        if xs[i] > xmax { xmax = xs[i] }
        if ys[i] < ymin { ymin = ys[i] }
        if ys[i] > ymax { ymax = ys[i] }
        i = i + 1
    }

    let x_range = xmax - xmin
    let y_range = ymax - ymin
    let plot_w = width - margin * 2
    let plot_h = height - margin * 2

    svg_emit_header(width, height)
    svg_emit_rect(0, 0, width, height, bg_color)
    svg_emit_line(margin, margin, margin, height - margin, axis_color)
    svg_emit_line(margin, height - margin, width - margin, height - margin, axis_color)

    // One <line> per segment with independent stroke-opacity for decay
    var j: i64 = 0
    while j < n - 1 {
        let x0f = if x_range == 0.0 { 0.0 } else { (xs[j]     - xmin) / x_range }
        let y0f = if y_range == 0.0 { 0.0 } else { (ys[j]     - ymin) / y_range }
        let x1f = if x_range == 0.0 { 0.0 } else { (xs[j + 1] - xmin) / x_range }
        let y1f = if y_range == 0.0 { 0.0 } else { (ys[j + 1] - ymin) / y_range }

        let px0 = margin + (x0f * (plot_w as f64)) as i64
        let py0 = height - margin - (y0f * (plot_h as f64)) as i64
        let px1 = margin + (x1f * (plot_w as f64)) as i64
        let py1 = height - margin - (y1f * (plot_h as f64)) as i64

        var c0 = conf[j]
        var c1 = conf[j + 1]
        if c0 < 0.0 { c0 = 0.0 }
        if c0 > 1.0 { c0 = 1.0 }
        if c1 < 0.0 { c1 = 0.0 }
        if c1 > 1.0 { c1 = 1.0 }
        let seg_conf = (c0 + c1) * 0.5

        let alpha = min_alpha as f64 + (max_alpha - min_alpha) as f64 * seg_conf
        let opacity = alpha / 255.0

        print("<line x1=\"")
        svg_emit_i64(px0)
        print("\" y1=\"")
        svg_emit_i64(py0)
        print("\" x2=\"")
        svg_emit_i64(px1)
        print("\" y2=\"")
        svg_emit_i64(py1)
        print("\" stroke=\"")
        svg_emit_color_hex(line_color)
        print("\" stroke-width=\"2\" stroke-opacity=\"")
        // Simple decimal emission for opacity (0.0 – 1.0)
        let op_tenths = (opacity * 10.0 + 0.5) as i64
        if op_tenths <= 0 {
            print("0.0")
        } else if op_tenths >= 10 {
            print("1.0")
        } else {
            print("0.")
            svg_emit_i64(op_tenths)
        }
        println("\"/>")

        j = j + 1
    }

    svg_emit_footer()
}

// ============================================================================
// ADVANCED EPISTEMIC FIGURE (hero generator - placeholder)
// ============================================================================
// The full self-contained hero figure was prototyped here. It is currently
// disabled pending minor effect annotation resolution in the large function.
// The core primitives below (decay + glyphs) are production-ready and compile cleanly.
//
// When ready, a clean svg_epistemic_advanced_figure() will live in this location.
    let plot_w = width - margin * 2
    let plot_h = height - margin * 2

    // Synthetic data: concentration over time with decaying confidence (extrapolation)
    var xs: [f64; 256] = [0.0; 256]
    var ys: [f64; 256] = [0.0; 256]
    var conf: [f64; 256] = [0.0; 256]
    let n: i64 = 15

    var i: i64 = 0
    while i < n {
        xs[i] = (i as f64) * 0.65
        ys[i] = 52.0 - (i as f64) * 1.8 + (i as f64) * (i as f64) * 0.07
        // High confidence in measurement window, rapid decay in prediction
        if i < 8 {
            conf[i] = 0.97 - (i as f64) * 0.02
        } else {
            conf[i] = 0.80 - (i as f64) * 0.09
        }
        if conf[i] < 0.08 { conf[i] = 0.08 }
        i = i + 1
    }

    let line_color = Color { r: 20, g: 90, b: 170, a: 255 }
    let bg = Color { r: 255, g: 255, b: 255, a: 255 }
    let axis = Color { r: 30, g: 30, b: 30, a: 255 }

    svg_emit_header(width, height)

    // Background + subtle grid feel
    svg_emit_rect(0, 0, width, height, bg)

    // Main plot area background
    svg_emit_rect(margin - 4, margin - 4, plot_w + 8, plot_h + 8, Color { r: 252, g: 252, b: 255, a: 255 })

    // Axes
    svg_emit_line(margin, margin, margin, height - margin, axis)
    svg_emit_line(margin, height - margin, width - margin, height - margin, axis)

    // Title
    print("<text x=\"")
    svg_emit_i64(width / 2)
    print("\" y=\"32\" font-family=\"sans-serif\" font-size=\"18\" font-weight=\"600\" fill=\"#111\" text-anchor=\"middle\">")
    print("Epistemic Confidence Decay with Provenance")
    println("</text>")

    // Subtitle explaining the visual language
    print("<text x=\"")
    svg_emit_i64(width / 2)
    print("\" y=\"52\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#444\" text-anchor=\"middle\">")
    print("Line opacity = confidence | Glyph shape &amp; dash = provenance source | Ring = derived uncertainty")
    println("</text>")

    // === Draw the main decay curve using segments with varying opacity ===
    var j: i64 = 0
    while j < n - 1 {
        let x0f = (xs[j]     - xs[0]) / (xs[n-1] - xs[0])
        let y0f = (ys[j]     - 20.0) / 55.0
        let x1f = (xs[j + 1] - xs[0]) / (xs[n-1] - xs[0])
        let y1f = (ys[j + 1] - 20.0) / 55.0

        let px0 = margin + (x0f * (plot_w as f64)) as i64
        let py0 = height - margin - (y0f * (plot_h as f64)) as i64
        let px1 = margin + (x1f * (plot_w as f64)) as i64
        let py1 = height - margin - (y1f * (plot_h as f64)) as i64

        let seg_conf = (conf[j] + conf[j+1]) * 0.5
        let opacity = 0.25 + seg_conf * 0.72

        print("<line x1=\"")
        svg_emit_i64(px0)
        print("\" y1=\"")
        svg_emit_i64(py0)
        print("\" x2=\"")
        svg_emit_i64(px1)
        print("\" y2=\"")
        svg_emit_i64(py1)
        print("\" stroke=\"#145aaa\" stroke-width=\"2.5\" stroke-opacity=\"")
        // simple opacity
        let op = (opacity * 100.0) as i64
        if op > 99 { print("0.99") } else if op < 10 { print("0.0") } else { print("0."); svg_emit_i64(op / 10) }
        println("\"/>")

        j = j + 1
    }

    // === Provenance Glyphs placed at key locations ===

    // Glyph 1: Direct measurement (solid red, high confidence region)
    svg_draw_provenance_glyph(
        margin + 48, height - margin - 118,
        18, -22,
        7,
        Color { r: 200, g: 40, b: 40, a: 255 },   // strong measured
        Color { r: 50, g: 50, b: 50, a: 220 },
        Color { r: 80, g: 80, b: 80, a: 200 },
        false,
        0
    )
    print("<text x=\"140\" y=\"195\" font-size=\"10\" fill=\"#333\">Measured (in vivo)</text>")

    // Glyph 2: PBPK model output (dashed blue, medium confidence)
    svg_draw_provenance_glyph(
        margin + 195, height - margin - 165,
        22, 18,
        7,
        Color { r: 30, g: 120, b: 200, a: 255 },
        Color { r: 40, g: 40, b: 40, a: 200 },
        Color { r: 90, g: 90, b: 90, a: 180 },
        true,
        0
    )
    print("<text x=\"290\" y=\"168\" font-size=\"10\" fill=\"#333\">PBPK model (derived)</text>")

    // Glyph 3: Literature prior (green, low confidence tail)
    svg_draw_provenance_glyph(
        margin + 340, height - margin - 42,
        15, 12,
        6,
        Color { r: 40, g: 160, b: 90, a: 255 },
        Color { r: 30, g: 30, b: 30, a: 200 },
        Color { r: 100, g: 100, b: 100, a: 170 },
        true,
        1
    )
    print("<text x=\"425\" y=\"295\" font-size=\"10\" fill=\"#333\">Literature prior</text>")

    // === Legend box ===
    let lx = width - 195
    let ly = 85

    svg_emit_rect(lx - 8, ly - 18, 185, 115, Color { r: 250, g: 250, b: 252, a: 240 })
    print("<rect x=\"")
    svg_emit_i64(lx - 8)
    print("\" y=\"")
    svg_emit_i64(ly - 18)
    print("\" width=\"185\" height=\"115\" fill=\"none\" stroke=\"#ccc\"/>")

    print("<text x=\"")
    svg_emit_i64(lx)
    print("\" y=\"")
    svg_emit_i64(ly)
    print("\" font-size=\"11\" font-weight=\"600\" fill=\"#222\">Visual Encoding</text>")

    print("<text x=\"")
    svg_emit_i64(lx)
    print("\" y=\"")
    svg_emit_i64(ly + 18)
    print("\" font-size=\"9\" fill=\"#444\">Fading line = confidence decay</text>")

    print("<text x=\"")
    svg_emit_i64(lx)
    print("\" y=\"")
    svg_emit_i64(ly + 34)
    print("\" font-size=\"9\" fill=\"#444\">Solid vs dashed = source type</text>")

    print("<text x=\"")
    svg_emit_i64(lx)
    print("\" y=\"")
    svg_emit_i64(ly + 50)
    print("\" font-size=\"9\" fill=\"#444\">Color = provenance origin</text>")

    print("<text x=\"")
    svg_emit_i64(lx)
    print("\" y=\"")
    svg_emit_i64(ly + 70)
    print("\" font-size=\"8\" fill=\"#666\">Red = direct measurement</text>")
    print("<text x=\"")
    svg_emit_i64(lx)
    print("\" y=\"")
    svg_emit_i64(ly + 83)
    print("\" font-size=\"8\" fill=\"#666\">Blue = mechanistic model</text>")
    print("<text x=\"")
    svg_emit_i64(lx)
    print("\" y=\"")
    svg_emit_i64(ly + 96)
    print("\" font-size=\"8\" fill=\"#666\">Green = external literature</text>")

    // Footer note
    print("<text x=\"")
    svg_emit_i64(width / 2)
    print("\" y=\"")
    svg_emit_i64(height - 14)
    print("\" font-size=\"8\" fill=\"#777\" text-anchor=\"middle\">")
    print("Sounio native epistemic visualization — generated without matplotlib or external tools")
    println("</text>")

    svg_emit_footer()
}

// Provenance glyph SVG (called from epistemic layer or directly)
pub fn svg_draw_provenance_glyph(
    px: i64,
    py: i64,
    dx: i64,
    dy: i64,
    size: i64,
    fill: Color,
    ring: Color,
    connector: Color,
    dashed: bool,
    shape: i64,   // 0=circle (default), 1=diamond, 2=triangle_up
    uncertainty_ring: bool,
    uncertainty_scale: f64
) with IO, Div {
    let end_x = px + dx * 2
    let end_y = py + dy * 2

    // Connector line
    print("<line x1=\"")
    svg_emit_i64(px)
    print("\" y1=\"")
    svg_emit_i64(py)
    print("\" x2=\"")
    svg_emit_i64(end_x)
    print("\" y2=\"")
    svg_emit_i64(end_y)
    print("\" stroke=\"")
    svg_emit_color_hex(connector)
    print("\" stroke-width=\"1.5\"")
    if dashed {
        print(" stroke-dasharray=\"3,2\"")
    }
    println("/>")

    if shape == 1 {
        // Diamond
        let s = size
        print("<polygon points=\"")
        svg_emit_i64(px); print(","); svg_emit_i64(py - s); print(" ")
        svg_emit_i64(px + s); print(","); svg_emit_i64(py); print(" ")
        svg_emit_i64(px); print(","); svg_emit_i64(py + s); print(" ")
        svg_emit_i64(px - s); print(","); svg_emit_i64(py);
        print("\" fill=\"")
        svg_emit_color_hex(fill)
        print("\" stroke=\"")
        svg_emit_color_hex(ring)
        println("\" stroke-width=\"1.5\"/>")
    } else if shape == 2 {
        // Triangle up
        let s = size
        print("<polygon points=\"")
        svg_emit_i64(px); print(","); svg_emit_i64(py - s); print(" ")
        svg_emit_i64(px + s); print(","); svg_emit_i64(py + s); print(" ")
        svg_emit_i64(px - s); print(","); svg_emit_i64(py + s);
        print("\" fill=\"")
        svg_emit_color_hex(fill)
        print("\" stroke=\"")
        svg_emit_color_hex(ring)
        println("\" stroke-width=\"1.5\"/>")
    } else {
        // Circle
        print("<circle cx=\"")
        svg_emit_i64(px)
        print("\" cy=\"")
        svg_emit_i64(py)
        print("\" r=\"")
        svg_emit_i64(size)
        print("\" fill=\"")
        svg_emit_color_hex(fill)
        print("\" stroke=\"")
        svg_emit_color_hex(ring)
        println("\" stroke-width=\"1.5\"/>")
    }

    // Uncertainty ring (outer, low opacity) for visual second-order uncertainty
    if uncertainty_ring && uncertainty_scale > 0.05 {
        let ur = (size as f64 * (1.0 + uncertainty_scale * 0.7)) as i64
        print("<circle cx=\"")
        svg_emit_i64(px)
        print("\" cy=\"")
        svg_emit_i64(py)
        print("\" r=\"")
        svg_emit_i64(ur)
        print("\" fill=\"none\" stroke=\"")
        svg_emit_color_hex(ring)
        print("\" stroke-width=\"1\" stroke-opacity=\"0.3\"/>")
    }
}

/// Simple but high-quality provenance legend emitter.
/// Draws a small boxed legend at (x,y) with up to 4 entries.
/// Legend fields are parallel arrays because this compiler path does not yet
/// typecheck 4-field tuple arrays consistently.
pub fn svg_draw_provenance_legend(
    x: i64,
    y: i64,
    labels: &[str; 4],
    colors: &[Color; 4],
    shapes: &[i64; 4],
    dashed: &[bool; 4],
    n: i64
) with IO, Mut, Div {
    let box_w: i64 = 210
    let row_h: i64 = 22
    let box_h: i64 = 12 + n * row_h

    // Background box
    print("<rect x=\"")
    svg_emit_i64(x)
    print("\" y=\"")
    svg_emit_i64(y)
    print("\" width=\"")
    svg_emit_i64(box_w)
    print("\" height=\"")
    svg_emit_i64(box_h)
    print("\" fill=\"#fafafa\" stroke=\"#cccccc\" rx=\"4\"/>")

    var i: i64 = 0
    while i < n {
        let label = labels[i]
        let col = colors[i]
        let shp = shapes[i]
        let dash = dashed[i]

        let gy = y + 16 + i * row_h

        // Small symbol
        if shp == 1 {
            // diamond
            print("<polygon points=\"")
            svg_emit_i64(x + 12); print(","); svg_emit_i64(gy - 5); print(" ")
            svg_emit_i64(x + 17); print(","); svg_emit_i64(gy); print(" ")
            svg_emit_i64(x + 12); print(","); svg_emit_i64(gy + 5); print(" ")
            svg_emit_i64(x + 7); print(","); svg_emit_i64(gy);
            print("\" fill=\"")
            svg_emit_color_hex(col)
            println("\"/>")
        } else if shp == 2 {
            // triangle
            print("<polygon points=\"")
            svg_emit_i64(x + 12); print(","); svg_emit_i64(gy - 6); print(" ")
            svg_emit_i64(x + 18); print(","); svg_emit_i64(gy + 5); print(" ")
            svg_emit_i64(x + 6); print(","); svg_emit_i64(gy + 5);
            print("\" fill=\"")
            svg_emit_color_hex(col)
            println("\"/>")
        } else {
            print("<circle cx=\"")
            svg_emit_i64(x + 12)
            print("\" cy=\"")
            svg_emit_i64(gy)
            print("\" r=\"5\" fill=\"")
            svg_emit_color_hex(col)
            println("\"/>")
        }

        // Label
        print("<text x=\"")
        svg_emit_i64(x + 26)
        print("\" y=\"")
        svg_emit_i64(gy + 4)
        print("\" font-family=\"sans-serif\" font-size=\"11\" fill=\"#222\">")
        print(label)
        println("</text>")

        i = i + 1
    }
}

// ============================================================================
// SVG PRIMITIVE EMITTERS
// ============================================================================

fn svg_emit_header(w: i64, h: i64) with IO, Div {
    print("<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"")
    svg_emit_i64(w)
    print("\" height=\"")
    svg_emit_i64(h)
    print("\" viewBox=\"0 0 ")
    svg_emit_i64(w)
    print(" ")
    svg_emit_i64(h)
    println("\">")
}

fn svg_emit_footer() with IO {
    println("</svg>")
}

fn svg_emit_rect(x: i64, y: i64, w: i64, h: i64, c: Color) with IO, Div {
    print("<rect x=\"")
    svg_emit_i64(x)
    print("\" y=\"")
    svg_emit_i64(y)
    print("\" width=\"")
    svg_emit_i64(w)
    print("\" height=\"")
    svg_emit_i64(h)
    print("\" fill=\"")
    svg_emit_color_hex(c)
    println("\"/>")
}

fn svg_emit_line(x1: i64, y1: i64, x2: i64, y2: i64, c: Color) with IO, Div {
    print("<line x1=\"")
    svg_emit_i64(x1)
    print("\" y1=\"")
    svg_emit_i64(y1)
    print("\" x2=\"")
    svg_emit_i64(x2)
    print("\" y2=\"")
    svg_emit_i64(y2)
    print("\" stroke=\"")
    svg_emit_color_hex(c)
    println("\" stroke-width=\"1\"/>")
}

fn svg_emit_circle(cx: i64, cy: i64, r: i64, c: Color) with IO, Div {
    print("<circle cx=\"")
    svg_emit_i64(cx)
    print("\" cy=\"")
    svg_emit_i64(cy)
    print("\" r=\"")
    svg_emit_i64(r)
    print("\" fill=\"")
    svg_emit_color_hex(c)
    println("\"/>")
}

fn svg_emit_color_hex(c: Color) with IO {
    print("#")
    svg_emit_hex_byte(c.r)
    svg_emit_hex_byte(c.g)
    svg_emit_hex_byte(c.b)
}

fn svg_heatmap_color(t: f64) -> Color {
    let nt = if t < 0.0 { 0.0 } else if t > 1.0 { 1.0 } else { t }
    if nt < 0.25 {
        let local = nt / 0.25
        Color { r: 0, g: (local * 255.0) as i64, b: 255, a: 255 }
    } else if nt < 0.5 {
        let local = (nt - 0.25) / 0.25
        Color { r: 0, g: 255, b: 255 - (local * 255.0) as i64, a: 255 }
    } else if nt < 0.75 {
        let local = (nt - 0.5) / 0.25
        Color { r: (local * 255.0) as i64, g: 255, b: 0, a: 255 }
    } else {
        let local = (nt - 0.75) / 0.25
        Color { r: 255, g: 255 - (local * 255.0) as i64, b: 0, a: 255 }
    }
}

fn svg_emit_hex_byte(v: i64) with IO {
    let b = if v < 0 { 0 } else if v > 255 { 255 } else { v }
    let hi = b / 16
    let lo = b % 16
    svg_emit_hex_digit(hi)
    svg_emit_hex_digit(lo)
}

fn svg_emit_i64(v: i64) with IO, Div {
    if v < 0 {
        print("-")
        svg_emit_u64(0 - v)
    } else {
        svg_emit_u64(v)
    }
}

fn svg_emit_u64(v: i64) with IO, Div {
    if v >= 1000000 {
        svg_emit_u64(v / 1000000)
        svg_emit_padded3((v / 1000) % 1000)
        svg_emit_padded3(v % 1000)
    } else if v >= 1000 {
        svg_emit_u64(v / 1000)
        svg_emit_padded3(v % 1000)
    } else if v >= 100 {
        svg_emit_hex_digit(v / 100)
        svg_emit_hex_digit((v / 10) % 10)
        svg_emit_hex_digit(v % 10)
    } else if v >= 10 {
        svg_emit_hex_digit(v / 10)
        svg_emit_hex_digit(v % 10)
    } else {
        svg_emit_hex_digit(v)
    }
}

fn svg_emit_padded3(v: i64) with IO, Div {
    svg_emit_hex_digit((v / 100) % 10)
    svg_emit_hex_digit((v / 10) % 10)
    svg_emit_hex_digit(v % 10)
}

fn svg_emit_hex_digit(d: i64) with IO {
    if d == 0 {
        print("0")
    } else if d == 1 {
        print("1")
    } else if d == 2 {
        print("2")
    } else if d == 3 {
        print("3")
    } else if d == 4 {
        print("4")
    } else if d == 5 {
        print("5")
    } else if d == 6 {
        print("6")
    } else if d == 7 {
        print("7")
    } else if d == 8 {
        print("8")
    } else if d == 9 {
        print("9")
    } else if d == 10 {
        print("a")
    } else if d == 11 {
        print("b")
    } else if d == 12 {
        print("c")
    } else if d == 13 {
        print("d")
    } else if d == 14 {
        print("e")
    } else {
        print("f")
    }
}

fn main() -> i32 with IO { 0 }
