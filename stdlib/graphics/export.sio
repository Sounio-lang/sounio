// Graphics Export — PPM and PNG output
//
// PPM is pure Sounio (text format to stdout).
// PNG uses the pure-Sounio stored-DEFLATE encoder in png.sio.

use graphics::surface::{Surface}
use graphics::png::{png_encode_surface, png_encode_surface_rgba}

// Emit PPM P3 to stdout
pub fn export_ppm(s: &Surface) with IO, Mut, Div, Panic {
    print("P3\n")
    print_int(s.width)
    print(" ")
    print_int(s.height)
    print("\n255\n")
    var y: i64 = 0
    while y < s.height {
        var x: i64 = 0
        while x < s.width {
            let idx = y * s.width + x
            print_int(clamp_byte(s.r[idx]))
            print(" ")
            print_int(clamp_byte(s.g[idx]))
            print(" ")
            print_int(clamp_byte(s.b[idx]))
            print("\n")
            x = x + 1
        }
        y = y + 1
    }
}

fn clamp_byte(v: i64) -> i64 {
    if v < 0 { 0 } else if v > 255 { 255 } else { v }
}

// PNG export — RGB (color type 2)
pub fn export_png(s: &Surface, filename: string) -> bool with IO, Mut, Panic, Div {
    png_encode_surface(s, filename)
}

// PNG export — RGBA (color type 6), preserves alpha channel
pub fn export_png_rgba(s: &Surface, filename: string) -> bool with IO, Mut, Panic, Div {
    png_encode_surface_rgba(s, filename)
}

fn main() -> i32 with IO { 0 }
