// Graphics Extra PNG — One-shot convenience functions for text, grid, and errorbar
//
// Creates a Surface/TiledSurface, renders the element, and exports to PNG in a single call.

use graphics::surface::{Surface, surface_new, surface_clear}
use graphics::tile::{TiledSurface, tiled_surface_new, tiled_clear, tiled_export_png}
use graphics::drawing::{color_white, color_black}
use graphics::text::{draw_text_raster, tiled_draw_text}
use graphics::grid::{GridConfig, grid_config_default, draw_grid_raster, tiled_draw_grid}
use graphics::errorbar::{
    ErrorBarConfig, errorbar_config_default,
    draw_errorbar_vertical_raster, draw_errorbar_horizontal_raster,
    tiled_draw_errorbar_vertical, tiled_draw_errorbar_horizontal
}
use graphics::png::{png_encode_surface}

// ============================================================================
// TEXT
// ============================================================================

pub fn plot_text_png(text: &[i64; 64], text_len: i64, width: i64, height: i64, filename: string) -> bool with IO, Mut, Panic, Div {
    var s = surface_new(width, height)
    s = surface_clear(s, color_white())
    s = draw_text_raster(s, text, text_len, 10, 10, color_black(), 1)
    png_encode_surface(&s, filename)
}

pub fn tiled_plot_text_png(text: &[i64; 64], text_len: i64, width: i64, height: i64, filename: string) -> bool with IO, Mut, Panic, Div {
    var ts = tiled_surface_new(width, height, 256, 256)
    ts = tiled_clear(ts, color_white())
    ts = tiled_draw_text(ts, text, text_len, 10, 10, color_black(), 1)
    tiled_export_png(&ts, filename)
}

// ============================================================================
// GRID
// ============================================================================

pub fn plot_grid_png(width: i64, height: i64, filename: string) -> bool with IO, Mut, Panic, Div {
    var s = surface_new(width, height)
    s = surface_clear(s, color_white())
    let config = grid_config_default()
    s = draw_grid_raster(s, config)
    png_encode_surface(&s, filename)
}

pub fn tiled_plot_grid_png(width: i64, height: i64, filename: string) -> bool with IO, Mut, Panic, Div {
    var ts = tiled_surface_new(width, height, 256, 256)
    ts = tiled_clear(ts, color_white())
    let config = grid_config_default()
    ts = tiled_draw_grid(ts, config)
    tiled_export_png(&ts, filename)
}

// ============================================================================
// ERRORBAR
// ============================================================================

// Helper: map f64 data to pixel coordinates (same convention as plot::plot_line_raster).
fn map_data_to_pixel_x(x: f64, xmin: f64, x_range: f64, margin: i64, plot_w: i64) -> i64 {
    let xf = if x_range == 0.0 { 0.0 } else { (x - xmin) / x_range }
    margin + (xf * (plot_w as f64)) as i64
}

fn map_data_to_pixel_y(y: f64, ymin: f64, y_range: f64, height: i64, margin: i64, plot_h: i64) -> i64 {
    let yf = if y_range == 0.0 { 0.0 } else { (y - ymin) / y_range }
    height - margin - 1 - (yf * (plot_h as f64)) as i64
}

pub fn plot_errorbar_vertical_png(
    xs: &[f64; 256], ys: &[f64; 256], errs: &[f64; 256], n: i64,
    width: i64, height: i64, filename: string
) -> bool with IO, Mut, Panic, Div {
    if n <= 0 { return false }
    var s = surface_new(width, height)
    s = surface_clear(s, color_white())

    var xmin = xs[0]
    var xmax = xs[0]
    var ymin = ys[0]
    var ymax = ys[0]
    var i: i64 = 1
    while i < n {
        if xs[i] < xmin { xmin = xs[i] }
        if xs[i] > xmax { xmax = xs[i] }
        if ys[i] < ymin { ymin = ys[i] }
        if ys[i] > ymax { ymax = ys[i] }
        i = i + 1
    }

    let x_range = xmax - xmin
    let y_range = ymax - ymin
    let margin = 20
    let plot_w = width - margin * 2
    let plot_h = height - margin * 2

    let config = errorbar_config_default()
    var j: i64 = 0
    while j < n && j < 256 {
        let px = map_data_to_pixel_x(xs[j], xmin, x_range, margin, plot_w)
        let py = map_data_to_pixel_y(ys[j], ymin, y_range, height, margin, plot_h)
        var err_px: i64 = 0
        if y_range != 0.0 {
            err_px = ((errs[j] * (plot_h as f64)) / y_range) as i64
        }
        if err_px < 0 { err_px = 0 - err_px }
        s = draw_errorbar_vertical_raster(s, px, py, err_px, config)
        j = j + 1
    }
    png_encode_surface(&s, filename)
}

