// Test for stdlib/graphics/png_decode.sio
//
// Encode a small test image, decode it, and verify pixel values.

use graphics::surface::{Surface, surface_new, surface_set_pixel}
use graphics::drawing::{Color, color_with_alpha}
use graphics::png::{png_encode_surface, png_encode_surface_rgba}
use graphics::png_decode::{png_decode_surface}

fn test_decode_rgb() -> bool with IO, Mut, Panic, Div {
    // Create a 4×4 RGB image with a diagonal pattern
    var s = surface_new(4, 4)
    let red = Color { r: 255, g: 0, b: 0, a: 255 }
    let green = Color { r: 0, g: 255, b: 0, a: 255 }
    let blue = Color { r: 0, g: 0, b: 255, a: 255 }
    let white = Color { r: 255, g: 255, b: 255, a: 255 }

    s = surface_set_pixel(s, 0, 0, red)
    s = surface_set_pixel(s, 1, 1, green)
    s = surface_set_pixel(s, 2, 2, blue)
    s = surface_set_pixel(s, 3, 3, white)

    let enc = png_encode_surface(&s, "/tmp/test_decode_rgb.png")
    if !enc {
        print("FAIL: encode RGB\n")
        return false
    }

    let d = png_decode_surface("/tmp/test_decode_rgb.png")
    if d.width != 4 || d.height != 4 {
        print("FAIL: decode RGB size mismatch\n")
        return false
    }

    // Check corner pixels
    if d.r[0] != 255 || d.g[0] != 0 || d.b[0] != 0 || d.a[0] != 255 {
        print("FAIL: decode RGB pixel (0,0)\n")
        return false
    }
    let idx11 = 1 * 4 + 1
    if d.r[idx11] != 0 || d.g[idx11] != 255 || d.b[idx11] != 0 || d.a[idx11] != 255 {
        print("FAIL: decode RGB pixel (1,1)\n")
        return false
    }
    let idx22 = 2 * 4 + 2
    if d.r[idx22] != 0 || d.g[idx22] != 0 || d.b[idx22] != 255 || d.a[idx22] != 255 {
        print("FAIL: decode RGB pixel (2,2)\n")
        return false
    }
    let idx33 = 3 * 4 + 3
    if d.r[idx33] != 255 || d.g[idx33] != 255 || d.b[idx33] != 255 || d.a[idx33] != 255 {
        print("FAIL: decode RGB pixel (3,3)\n")
        return false
    }

    print("PASS: decode RGB\n")
    true
}

fn test_decode_rgba() -> bool with IO, Mut, Panic, Div {
    // Create a 4×4 RGBA image with transparency
    var s = surface_new(4, 4)
    let semi_red = Color { r: 255, g: 0, b: 0, a: 128 }
    let semi_green = Color { r: 0, g: 255, b: 0, a: 64 }

    s = surface_set_pixel(s, 0, 0, semi_red)
    s = surface_set_pixel(s, 2, 2, semi_green)

    let enc = png_encode_surface_rgba(&s, "/tmp/test_decode_rgba.png")
    if !enc {
        print("FAIL: encode RGBA\n")
        return false
    }

    let d = png_decode_surface("/tmp/test_decode_rgba.png")
    if d.width != 4 || d.height != 4 {
        print("FAIL: decode RGBA size mismatch\n")
        return false
    }

    if d.r[0] != 255 || d.g[0] != 0 || d.b[0] != 0 || d.a[0] != 128 {
        print("FAIL: decode RGBA pixel (0,0)\n")
        return false
    }
    let idx22 = 2 * 4 + 2
    if d.r[idx22] != 0 || d.g[idx22] != 255 || d.b[idx22] != 0 || d.a[idx22] != 64 {
        print("FAIL: decode RGBA pixel (2,2)\n")
        return false
    }

    print("PASS: decode RGBA\n")
    true
}

fn test_decode_gradient() -> bool with IO, Mut, Panic, Div {
    // Create a 16×16 gradient to trigger stored blocks
    var s = surface_new(16, 16)
    var y: i64 = 0
    while y < 16 {
        var x: i64 = 0
        while x < 16 {
            let c = Color { r: x * 16, g: y * 16, b: 128, a: 255 }
            s = surface_set_pixel(s, x, y, c)
            x = x + 1
        }
        y = y + 1
    }

    let enc = png_encode_surface(&s, "/tmp/test_decode_grad.png")
    if !enc {
        print("FAIL: encode gradient\n")
        return false
    }

    let d = png_decode_surface("/tmp/test_decode_grad.png")
    if d.width != 16 || d.height != 16 {
        print("FAIL: decode gradient size mismatch\n")
        return false
    }

    // Spot-check a few pixels
    let idx55 = 5 * 16 + 5
    if d.r[idx55] != 80 || d.g[idx55] != 80 || d.b[idx55] != 128 || d.a[idx55] != 255 {
        print("FAIL: decode gradient pixel (5,5)\n")
        return false
    }
    let idx1515 = 15 * 16 + 15
    if d.r[idx1515] != 240 || d.g[idx1515] != 240 || d.b[idx1515] != 128 || d.a[idx1515] != 255 {
        print("FAIL: decode gradient pixel (15,15)\n")
        return false
    }

    print("PASS: decode gradient\n")
    true
}

pub fn main() -> i32 with IO, Mut, Panic, Div {
    var failures: i64 = 0
    if !test_decode_rgb() { failures = failures + 1 }
    if !test_decode_rgba() { failures = failures + 1 }
    if !test_decode_gradient() { failures = failures + 1 }

    if failures == 0 {
        print("ALL PASS\n")
        0
    } else {
        print("SOME FAILURES\n")
        1
    }
}
