pub fn plot_line_raster_smooth(
    s: Surface,
    xs: &[f64; 256],
    ys: &[f64; 256],
    n: i64,
    config: QualityLinePlotConfig
) -> Surface with Mut, Panic, Div {
    if n <= 0 { return s }

    var out = s
    let margin = sanitize_margin(config.margin, out.width, out.height)
    let plot_w = out.width - margin * 2
    let plot_h = out.height - margin * 2
    if plot_w <= 0 || plot_h <= 0 { return out }

    var xmin = xs[0]
    var xmax = xs[0]
    var ymin = ys[0]
    var ymax = ys[0]
    var i: i64 = 1
    while i < n {
        if xs[i] < xmin { xmin = xs[i] }
        if xs[i] > xmax { xmax = xs[i] }
        if ys[i] < ymin { ymin = ys[i] }
        if ys[i] > ymax { ymax = ys[i] }
        i = i + 1
    }

    let x_range_raw = xmax - xmin
    let y_range_raw = ymax - ymin
    let x_range = if x_range_raw == 0.0 { 1.0 } else { x_range_raw }
    let y_range = if y_range_raw == 0.0 { 1.0 } else { y_range_raw }
    if x_range_raw == 0.0 {
        xmin = xmin - 0.5
        xmax = xmax + 0.5
    }
    if y_range_raw == 0.0 {
        ymin = ymin - 0.5
        ymax = ymax + 0.5
    }

    out = surface_draw_rect(out, 0, 0, out.width, out.height, config.bg_color)
    out = draw_quality_grid(out, margin, plot_w, plot_h, config)

    out = surface_draw_rect(out, margin, margin, 1, plot_h, config.axis_color)
    out = surface_draw_rect(out, margin, out.height - margin - 1, plot_w, 1, config.axis_color)

    var j: i64 = 0
    while j < n - 1 {
        let px0 = map_x(xs[j], xmin, x_range, margin, plot_w)
        let py0 = map_y(ys[j], ymin, y_range, out.height, margin, plot_h)
        let px1 = map_x(xs[j + 1], xmin, x_range, margin, plot_w)
        let py1 = map_y(ys[j + 1], ymin, y_range, out.height, margin, plot_h)
        out = surface_draw_line_smooth(out, px0, py0, px1, py1, config.line_color)
        j = j + 1
    }

    out
}

pub fn plot_heatmap_raster_smooth(
    s: Surface,
    data: &[f64; 4096],
    rows: i64,
    cols: i64,
    config: QualityHeatmapConfig
) -> Surface with Mut, Panic, Div {
    if rows <= 0 || cols <= 0 { return s }

    var out = s
    let margin = sanitize_margin(config.margin, out.width, out.height)
    let plot_w = out.width - margin * 2
    let plot_h = out.height - margin * 2
    if plot_w <= 0 || plot_h <= 0 { return out }

    var min_val = data[0]
    var max_val = data[0]
    var i: i64 = 1
    while i < rows * cols {
        if data[i] < min_val { min_val = data[i] }
        if data[i] > max_val { max_val = data[i] }
        i = i + 1
    }
    let range_raw = max_val - min_val
    let range = if range_raw == 0.0 { 1.0 } else { range_raw }

    out = surface_draw_rect(out, 0, 0, out.width, out.height, config.bg_color)

    var py_rel: i64 = 0
    while py_rel < plot_h {
        var px_rel: i64 = 0
        while px_rel < plot_w {
            let v = if config.smooth {
                sample_bilinear(data, rows, cols, px_rel, py_rel, plot_w, plot_h)
            } else {
                sample_nearest(data, rows, cols, px_rel, py_rel, plot_w, plot_h)
            }
            let t = (v - min_val) / range
            let c = quality_colormap_viridis(t)
            out = surface_blend_pixel(out, margin + px_rel, margin + py_rel, c, 255)
            px_rel = px_rel + 1
        }
        py_rel = py_rel + 1
    }

    out = surface_draw_rect(out, margin, margin, 1, plot_h, config.axis_color)
    out = surface_draw_rect(out, margin, out.height - margin - 1, plot_w, 1, config.axis_color)
    out
}

pub fn plot_contour_raster(
    s: Surface,
    data: &[f64; 4096],
    rows: i64,
    cols: i64,
    level: f64,
    config: QualityContourConfig
) -> Surface with Mut, Panic, Div {
    if rows <= 1 || cols <= 1 { return s }

    var out = s
    let margin = sanitize_margin(config.margin, out.width, out.height)
    let plot_w = out.width - margin * 2
    let plot_h = out.height - margin * 2
    if plot_w <= 0 || plot_h <= 0 { return out }

    var r: i64 = 0
    while r < rows - 1 {
        var c: i64 = 0
        while c < cols - 1 {
            let v00 = data[r * cols + c]
            let v10 = data[r * cols + c + 1]
            let v01 = data[(r + 1) * cols + c]
            let v11 = data[(r + 1) * cols + c + 1]

            let x0 = margin + (c * plot_w) / (cols - 1)
            let x1 = margin + ((c + 1) * plot_w) / (cols - 1)
            let y0 = out.height - margin - 1 - (r * plot_h) / (rows - 1)
            let y1 = out.height - margin - 1 - ((r + 1) * plot_h) / (rows - 1)

            var xs: [i64; 4] = [0; 4]
            var ys: [i64; 4] = [0; 4]
            var count: i64 = 0

            if edge_crosses(v00, v10, level) {
                xs[count] = interp_i64(x0, x1, v00, v10, level)
                ys[count] = y0
                count = count + 1
            }
            if edge_crosses(v10, v11, level) {
                xs[count] = x1
                ys[count] = interp_i64(y0, y1, v10, v11, level)
                count = count + 1
            }
            if edge_crosses(v01, v11, level) {
                xs[count] = interp_i64(x0, x1, v01, v11, level)
                ys[count] = y1
                count = count + 1
            }
            if edge_crosses(v00, v01, level) {
                xs[count] = x0
                ys[count] = interp_i64(y0, y1, v00, v01, level)
                count = count + 1
            }

            if count >= 2 {
                out = surface_draw_line_smooth(out, xs[0], ys[0], xs[1], ys[1], config.line_color)
            }
            if count >= 4 {
                out = surface_draw_line_smooth(out, xs[2], ys[2], xs[3], ys[3], config.line_color)
            }

            c = c + 1
        }
        r = r + 1
    }

    out
}

pub fn plot_band_raster_smooth(
    s: Surface,
    xs: &[f64; 256],
    y_low: &[f64; 256],
    y_high: &[f64; 256],
    n: i64,
    config: QualityBandPlotConfig
) -> Surface with Mut, Panic, Div {
    if n <= 0 { return s }

    var out = s
    let margin = sanitize_margin(config.margin, out.width, out.height)
    let plot_w = out.width - margin * 2
    let plot_h = out.height - margin * 2
    if plot_w <= 0 || plot_h <= 0 { return out }

    var xmin = xs[0]
    var xmax = xs[0]
    var ymin = y_low[0]
    var ymax = y_high[0]
    if y_high[0] < ymin { ymin = y_high[0] }
    if y_low[0] > ymax { ymax = y_low[0] }

    var i: i64 = 1
    while i < n {
        if xs[i] < xmin { xmin = xs[i] }
        if xs[i] > xmax { xmax = xs[i] }
        if y_low[i] < ymin { ymin = y_low[i] }
        if y_high[i] < ymin { ymin = y_high[i] }
        if y_low[i] > ymax { ymax = y_low[i] }
        if y_high[i] > ymax { ymax = y_high[i] }
        i = i + 1
    }

    let x_range_raw = xmax - xmin
    let y_range_raw = ymax - ymin
    let x_range = if x_range_raw == 0.0 { 1.0 } else { x_range_raw }
    let y_range = if y_range_raw == 0.0 { 1.0 } else { y_range_raw }
    if x_range_raw == 0.0 {
        xmin = xmin - 0.5
        xmax = xmax + 0.5
    }
    if y_range_raw == 0.0 {
        ymin = ymin - 0.5
        ymax = ymax + 0.5
    }

    out = surface_draw_rect(out, 0, 0, out.width, out.height, config.bg_color)

    let band_alpha = clamp_byte(config.band_alpha)
    let band = Color {
        r: blend_direct_channel(config.bg_color.r, config.band_color.r, band_alpha),
        g: blend_direct_channel(config.bg_color.g, config.band_color.g, band_alpha),
        b: blend_direct_channel(config.bg_color.b, config.band_color.b, band_alpha),
        a: 255,
    }

    var j: i64 = 0
    while j < n - 1 {
        let px0 = map_x(xs[j], xmin, x_range, margin, plot_w)
        let px1 = map_x(xs[j + 1], xmin, x_range, margin, plot_w)
        let low0 = map_y(y_low[j], ymin, y_range, out.height, margin, plot_h)
        let low1 = map_y(y_low[j + 1], ymin, y_range, out.height, margin, plot_h)
        let high0 = map_y(y_high[j], ymin, y_range, out.height, margin, plot_h)
        let high1 = map_y(y_high[j + 1], ymin, y_range, out.height, margin, plot_h)

        var xa = px0
        var xb = px1
        var l0 = low0
        var l1 = low1
        var h0 = high0
        var h1 = high1
        if xa > xb {
            xa = px1
            xb = px0
            l0 = low1
            l1 = low0
            h0 = high1
            h1 = high0
        }
        if xa < 0 { xa = 0 }
        if xb >= out.width { xb = out.width - 1 }

        let span = xb - xa
        var x = xa
        while x <= xb {
            let t = if span <= 0 { 0.0 } else { ((x - xa) as f64) / (span as f64) }
            let y_a = ((l0 as f64) * (1.0 - t) + (l1 as f64) * t) as i64
            let y_b = ((h0 as f64) * (1.0 - t) + (h1 as f64) * t) as i64
            var fy0 = y_a
            var fy1 = y_b
            if fy0 > fy1 {
                fy0 = y_b
                fy1 = y_a
            }
            if fy0 < 0 { fy0 = 0 }
            if fy1 >= out.height { fy1 = out.height - 1 }
            var fy = fy0
            var fy_guard: i64 = 0
            while fy <= fy1 && fy_guard < out.height {
                let idx = fy * out.width + x
                out.r[idx] = band.r
                out.g[idx] = band.g
                out.b[idx] = band.b
                out.a[idx] = band.a
                fy = fy + 1
                fy_guard = fy_guard + 1
            }
            x = x + 1
        }
        j = j + 1
    }

    out = surface_draw_rect(out, margin, margin, 1, plot_h, config.axis_color)
    out = surface_draw_rect(out, margin, out.height - margin - 1, plot_w, 1, config.axis_color)

    j = 0
    while j < n - 1 {
        let x0 = map_x(xs[j], xmin, x_range, margin, plot_w)
        let x1 = map_x(xs[j + 1], xmin, x_range, margin, plot_w)
        out = surface_draw_line_smooth(
            out,
            x0,
            map_y(y_low[j], ymin, y_range, out.height, margin, plot_h),
            x1,
            map_y(y_low[j + 1], ymin, y_range, out.height, margin, plot_h),
            config.line_color
        )
        out = surface_draw_line_smooth(
            out,
            x0,
            map_y(y_high[j], ymin, y_range, out.height, margin, plot_h),
            x1,
            map_y(y_high[j + 1], ymin, y_range, out.height, margin, plot_h),
            config.line_color
        )
        j = j + 1
    }

    out
}

pub fn plot_markers_raster_smooth(
    s: Surface,
    xs: &[f64; 256],
    ys: &[f64; 256],
    n: i64,
    config: QualityMarkerPlotConfig
) -> Surface with Mut, Panic, Div {
    if n <= 0 { return s }

    var out = s
    let margin = sanitize_margin(config.margin, out.width, out.height)
    let plot_w = out.width - margin * 2
    let plot_h = out.height - margin * 2
    if plot_w <= 0 || plot_h <= 0 { return out }

    var xmin = xs[0]
    var xmax = xs[0]
    var ymin = ys[0]
    var ymax = ys[0]
    var i: i64 = 1
    while i < n {
        if xs[i] < xmin { xmin = xs[i] }
        if xs[i] > xmax { xmax = xs[i] }
        if ys[i] < ymin { ymin = ys[i] }
        if ys[i] > ymax { ymax = ys[i] }
        i = i + 1
    }

    let x_range_raw = xmax - xmin
    let y_range_raw = ymax - ymin
    let x_range = if x_range_raw == 0.0 { 1.0 } else { x_range_raw }
    let y_range = if y_range_raw == 0.0 { 1.0 } else { y_range_raw }
    if x_range_raw == 0.0 {
        xmin = xmin - 0.5
        xmax = xmax + 0.5
    }
    if y_range_raw == 0.0 {
        ymin = ymin - 0.5
        ymax = ymax + 0.5
    }

    out = surface_draw_rect(out, 0, 0, out.width, out.height, config.bg_color)
    out = surface_draw_rect(out, margin, margin, 1, plot_h, config.axis_color)
    out = surface_draw_rect(out, margin, out.height - margin - 1, plot_w, 1, config.axis_color)

    var radius = config.radius
    if radius < 1 { radius = 1 }
    if radius > 16 { radius = 16 }

    var j: i64 = 0
    while j < n {
        let px = map_x(xs[j], xmin, x_range, margin, plot_w)
        let py = map_y(ys[j], ymin, y_range, out.height, margin, plot_h)
        out = draw_quality_marker(out, px, py, radius, config.marker_color, config.outline_color)
        j = j + 1
    }

    out
}

pub fn plot_error_bars_raster_smooth(
    s: Surface,
    xs: &[f64; 256],
    ys: &[f64; 256],
    err_low: &[f64; 256],
    err_high: &[f64; 256],
    n: i64,
    config: QualityErrorBarPlotConfig
) -> Surface with Mut, Panic, Div {
    if n <= 0 { return s }

    var out = s
    let margin = sanitize_margin(config.margin, out.width, out.height)
    let plot_w = out.width - margin * 2
    let plot_h = out.height - margin * 2
    if plot_w <= 0 || plot_h <= 0 { return out }

    var xmin = xs[0]
    var xmax = xs[0]
    var ymin = ys[0] - err_low[0]
    var ymax = ys[0] + err_high[0]
    var i: i64 = 1
    while i < n {
        if xs[i] < xmin { xmin = xs[i] }
        if xs[i] > xmax { xmax = xs[i] }
        let lo = ys[i] - err_low[i]
        let hi = ys[i] + err_high[i]
        if lo < ymin { ymin = lo }
        if hi > ymax { ymax = hi }
        i = i + 1
    }

    let x_range_raw = xmax - xmin
    let y_range_raw = ymax - ymin
    let x_range = if x_range_raw == 0.0 { 1.0 } else { x_range_raw }
    let y_range = if y_range_raw == 0.0 { 1.0 } else { y_range_raw }
    if x_range_raw == 0.0 {
        xmin = xmin - 0.5
        xmax = xmax + 0.5
    }
    if y_range_raw == 0.0 {
        ymin = ymin - 0.5
        ymax = ymax + 0.5
    }

    out = surface_draw_rect(out, 0, 0, out.width, out.height, config.bg_color)
    out = surface_draw_rect(out, margin, margin, 1, plot_h, config.axis_color)
    out = surface_draw_rect(out, margin, out.height - margin - 1, plot_w, 1, config.axis_color)

    var radius = config.radius
    if radius < 1 { radius = 1 }
    if radius > 16 { radius = 16 }
    var cap = config.cap_width
    if cap < 2 { cap = 2 }
    if cap > 32 { cap = 32 }
    let half_cap = cap / 2

    var j: i64 = 0
    while j < n {
        let px = map_x(xs[j], xmin, x_range, margin, plot_w)
        let py = map_y(ys[j], ymin, y_range, out.height, margin, plot_h)
        let py_low = map_y(ys[j] - err_low[j], ymin, y_range, out.height, margin, plot_h)
        let py_high = map_y(ys[j] + err_high[j], ymin, y_range, out.height, margin, plot_h)

        out = surface_draw_line_smooth(out, px, py_low, px, py_high, config.error_color)
        out = surface_draw_line_smooth(out, px - half_cap, py_low, px + half_cap, py_low, config.error_color)
        out = surface_draw_line_smooth(out, px - half_cap, py_high, px + half_cap, py_high, config.error_color)
        out = draw_quality_marker(out, px, py, radius, config.marker_color, config.outline_color)
        j = j + 1
    }

    out
}

pub fn draw_quality_colorbar(
    s: Surface,
    x: i64,
    y: i64,
    w: i64,
    h: i64,
    tick_count: i64,
    border_color: Color
) -> Surface with Mut, Panic, Div {
    var out = s
    if w <= 0 || h <= 0 { return out }

    var yy: i64 = 0
    while yy < h {
        let denom = if h <= 1 { 1.0 } else { (h - 1) as f64 }
        let t = 1.0 - ((yy as f64) / denom)
        let c = quality_colormap_viridis(t)
        var xx: i64 = 0
        while xx < w {
            let px = x + xx
            let py = y + yy
            if px >= 0 && px < out.width && py >= 0 && py < out.height {
                let idx = py * out.width + px
                out.r[idx] = c.r
                out.g[idx] = c.g
                out.b[idx] = c.b
                out.a[idx] = c.a
            }
            xx = xx + 1
        }
        yy = yy + 1
    }

    out = surface_draw_rect(out, x - 1, y - 1, w + 2, 1, border_color)
    out = surface_draw_rect(out, x - 1, y + h, w + 2, 1, border_color)
    out = surface_draw_rect(out, x - 1, y - 1, 1, h + 2, border_color)
    out = surface_draw_rect(out, x + w, y - 1, 1, h + 2, border_color)

    var ticks = tick_count
    if ticks < 2 { ticks = 2 }
    if ticks > 9 { ticks = 9 }
    var k: i64 = 0
    while k < ticks {
        let ty = y + (k * (h - 1)) / (ticks - 1)
        out = surface_draw_rect(out, x + w + 1, ty, 4, 1, border_color)
        k = k + 1
    }

    out
}

pub fn plot_histogram_raster(
    s: Surface,
    counts: &[i64; 256],
    bins: i64,
    config: QualityHistogramConfig
) -> Surface with Mut, Panic, Div {
    if bins <= 0 { return s }

    var out = s
    let margin = sanitize_margin(config.margin, out.width, out.height)
    let plot_w = out.width - margin * 2
    let plot_h = out.height - margin * 2
    if plot_w <= 0 || plot_h <= 0 { return out }

    var n = bins
    if n > 256 { n = 256 }

    var max_count: i64 = 0
    var i: i64 = 0
    while i < n {
        if counts[i] > max_count { max_count = counts[i] }
        i = i + 1
    }
    if max_count <= 0 { max_count = 1 }

    out = surface_draw_rect(out, 0, 0, out.width, out.height, config.bg_color)
    out = surface_draw_rect(out, margin, margin, 1, plot_h, config.axis_color)
    out = surface_draw_rect(out, margin, out.height - margin - 1, plot_w, 1, config.axis_color)

    var b: i64 = 0
    while b < n {
        let x0 = margin + (b * plot_w) / n
        let x1_raw = margin + ((b + 1) * plot_w) / n
        var bar_w = x1_raw - x0
        if bar_w < 1 { bar_w = 1 }
        let bar_h = (counts[b] * (plot_h - 1)) / max_count
        let y0 = out.height - margin - bar_h

        if bar_h > 0 {
            out = surface_draw_rect(out, x0, y0, bar_w, bar_h, config.bar_color)
            out = surface_draw_rect(out, x0, y0, bar_w, 1, config.outline_color)
            out = surface_draw_rect(out, x0, y0, 1, bar_h, config.outline_color)
            out = surface_draw_rect(out, x0 + bar_w - 1, y0, 1, bar_h, config.outline_color)
        }
        b = b + 1
    }

    out
}

pub fn plot_ecdf_raster_smooth(
    s: Surface,
    xs: &[f64; 256],
    n: i64,
    config: QualityEcdfPlotConfig
) -> Surface with Mut, Panic, Div {
    if n <= 0 { return s }

    var out = s
    let margin = sanitize_margin(config.margin, out.width, out.height)
    let plot_w = out.width - margin * 2
    let plot_h = out.height - margin * 2
    if plot_w <= 0 || plot_h <= 0 { return out }

    var xmin = xs[0]
    var xmax = xs[0]
    var i: i64 = 1
    while i < n {
        if xs[i] < xmin { xmin = xs[i] }
        if xs[i] > xmax { xmax = xs[i] }
        i = i + 1
    }
    let x_range_raw = xmax - xmin
    let x_range = if x_range_raw == 0.0 { 1.0 } else { x_range_raw }
    if x_range_raw == 0.0 {
        xmin = xmin - 0.5
        xmax = xmax + 0.5
    }

    out = surface_draw_rect(out, 0, 0, out.width, out.height, config.bg_color)
    out = surface_draw_rect(out, margin, margin, 1, plot_h, config.axis_color)
    out = surface_draw_rect(out, margin, out.height - margin - 1, plot_w, 1, config.axis_color)

    let y0 = out.height - margin - 1
    var prev_x = margin
    var prev_y = y0
    var j: i64 = 0
    while j < n {
        let px = map_x(xs[j], xmin, x_range, margin, plot_w)
        let frac = ((j + 1) as f64) / (n as f64)
        let py = out.height - margin - 1 - (frac * (plot_h as f64)) as i64
        out = surface_draw_line_smooth(out, prev_x, prev_y, px, prev_y, config.line_color)
        out = surface_draw_line_smooth(out, px, prev_y, px, py, config.line_color)
        prev_x = px
        prev_y = py
        j = j + 1
    }
    out = surface_draw_line_smooth(out, prev_x, prev_y, out.width - margin - 1, prev_y, config.line_color)

    out
}

pub fn plot_boxplot_raster(
    s: Surface,
    min_val: f64,
    q1: f64,
    median: f64,
    q3: f64,
    max_val: f64,
    outliers: &[f64; 256],
    outlier_count: i64,
    config: QualityBoxPlotConfig
) -> Surface with Mut, Panic, Div {
    var out = s
    let margin = sanitize_margin(config.margin, out.width, out.height)
    let plot_w = out.width - margin * 2
    let plot_h = out.height - margin * 2
    if plot_w <= 0 || plot_h <= 0 { return out }

    var ymin = min_val
    var ymax = max_val
    if q1 < ymin { ymin = q1 }
    if median < ymin { ymin = median }
    if q3 < ymin { ymin = q3 }
    if q1 > ymax { ymax = q1 }
    if median > ymax { ymax = median }
    if q3 > ymax { ymax = q3 }

    var oi: i64 = 0
    while oi < outlier_count && oi < 256 {
        if outliers[oi] < ymin { ymin = outliers[oi] }
        if outliers[oi] > ymax { ymax = outliers[oi] }
        oi = oi + 1
    }

    let y_range_raw = ymax - ymin
    let y_range = if y_range_raw == 0.0 { 1.0 } else { y_range_raw }
    if y_range_raw == 0.0 {
        ymin = ymin - 0.5
        ymax = ymax + 0.5
    }

    out = surface_draw_rect(out, 0, 0, out.width, out.height, config.bg_color)
    out = surface_draw_rect(out, margin, margin, 1, plot_h, config.axis_color)
    out = surface_draw_rect(out, margin, out.height - margin - 1, plot_w, 1, config.axis_color)

    let cx = margin + plot_w / 2
    var box_w = config.box_width
    if box_w < 6 { box_w = 6 }
    if box_w > plot_w { box_w = plot_w }
    let half_box = box_w / 2
    let left = cx - half_box
    let right = cx + half_box

    let y_min = map_y(min_val, ymin, y_range, out.height, margin, plot_h)
    let y_q1 = map_y(q1, ymin, y_range, out.height, margin, plot_h)
    let y_med = map_y(median, ymin, y_range, out.height, margin, plot_h)
    let y_q3 = map_y(q3, ymin, y_range, out.height, margin, plot_h)
    let y_max = map_y(max_val, ymin, y_range, out.height, margin, plot_h)

    var box_top = y_q3
    var box_bottom = y_q1
    if box_top > box_bottom {
        box_top = y_q1
        box_bottom = y_q3
    }
    var box_h = box_bottom - box_top + 1
    if box_h < 1 { box_h = 1 }

    out = surface_draw_rect(out, left, box_top, box_w, box_h, config.box_color)
    out = surface_draw_rect(out, left, box_top, box_w, 1, config.line_color)
    out = surface_draw_rect(out, left, box_bottom, box_w, 1, config.line_color)
    out = surface_draw_rect(out, left, box_top, 1, box_h, config.line_color)
    out = surface_draw_rect(out, right, box_top, 1, box_h, config.line_color)

    out = surface_draw_line_smooth(out, left, y_med, right, y_med, config.line_color)
    out = surface_draw_line_smooth(out, cx, y_max, cx, box_top, config.line_color)
    out = surface_draw_line_smooth(out, cx, box_bottom, cx, y_min, config.line_color)
    out = surface_draw_line_smooth(out, left, y_max, right, y_max, config.line_color)
    out = surface_draw_line_smooth(out, left, y_min, right, y_min, config.line_color)

    var radius = config.outlier_radius
    if radius < 1 { radius = 1 }
    if radius > 8 { radius = 8 }
    oi = 0
    while oi < outlier_count && oi < 256 {
        let oy = map_y(outliers[oi], ymin, y_range, out.height, margin, plot_h)
        out = draw_quality_marker(out, cx, oy, radius, config.line_color, config.line_color)
        oi = oi + 1
    }

    out
}

pub fn plot_violin_raster_smooth(
    s: Surface,
    ys: &[f64; 256],
    density: &[f64; 256],
    n: i64,
    config: QualityViolinPlotConfig
) -> Surface with Mut, Panic, Div {
    if n <= 1 { return s }

    var out = s
    let margin = sanitize_margin(config.margin, out.width, out.height)
    let plot_w = out.width - margin * 2
    let plot_h = out.height - margin * 2
    if plot_w <= 0 || plot_h <= 0 { return out }

    var count = n
    if count > 256 { count = 256 }

    var ymin = ys[0]
    var ymax = ys[0]
    var max_density = density[0]
    if max_density < 0.0 { max_density = 0.0 }

    var i: i64 = 1
    while i < count {
        if ys[i] < ymin { ymin = ys[i] }
        if ys[i] > ymax { ymax = ys[i] }
        if density[i] > max_density { max_density = density[i] }
        i = i + 1
    }
    if max_density <= 0.0 { max_density = 1.0 }

    let y_range_raw = ymax - ymin
    let y_range = if y_range_raw == 0.0 { 1.0 } else { y_range_raw }
    if y_range_raw == 0.0 {
        ymin = ymin - 0.5
        ymax = ymax + 0.5
    }

    out = surface_draw_rect(out, 0, 0, out.width, out.height, config.bg_color)
    out = surface_draw_rect(out, margin, margin, 1, plot_h, config.axis_color)
    out = surface_draw_rect(out, margin, out.height - margin - 1, plot_w, 1, config.axis_color)

    let cx = margin + plot_w / 2
    var half_w = config.half_width
    if half_w < 4 { half_w = 4 }
    let max_half = plot_w / 2
    if half_w > max_half { half_w = max_half }

    var j: i64 = 0
    while j < count - 1 {
        let y0 = map_y(ys[j], ymin, y_range, out.height, margin, plot_h)
        let y1 = map_y(ys[j + 1], ymin, y_range, out.height, margin, plot_h)

        var d0 = density[j]
        var d1 = density[j + 1]
        if d0 < 0.0 { d0 = 0.0 }
        if d1 < 0.0 { d1 = 0.0 }

        let w0 = ((d0 / max_density) * (half_w as f64)) as i64
        let w1 = ((d1 / max_density) * (half_w as f64)) as i64
        let lx0 = cx - w0
        let rx0 = cx + w0
        let lx1 = cx - w1
        let rx1 = cx + w1

        var ya = y0
        var yb = y1
        var fill_l0 = lx0
        var fill_l1 = lx1
        var fill_r0 = rx0
        var fill_r1 = rx1
        if ya > yb {
            ya = y1
            yb = y0
            fill_l0 = lx1
            fill_l1 = lx0
            fill_r0 = rx1
            fill_r1 = rx0
        }
        if ya < margin { ya = margin }
        if yb > out.height - margin - 1 { yb = out.height - margin - 1 }

        let span_y = yb - ya
        var py = ya
        while py <= yb {
            let t = if span_y <= 0 { 0.0 } else { ((py - ya) as f64) / (span_y as f64) }
            var left = ((fill_l0 as f64) * (1.0 - t) + (fill_l1 as f64) * t) as i64
            var right = ((fill_r0 as f64) * (1.0 - t) + (fill_r1 as f64) * t) as i64
            if left > right {
                let tmp = left
                left = right
                right = tmp
            }
            if left < margin { left = margin }
            if right > out.width - margin - 1 { right = out.width - margin - 1 }
            var px = left
            while px <= right {
                let idx = py * out.width + px
                out.r[idx] = config.fill_color.r
                out.g[idx] = config.fill_color.g
                out.b[idx] = config.fill_color.b
                out.a[idx] = config.fill_color.a
                px = px + 1
            }
            py = py + 1
        }

        out = surface_draw_line_smooth(out, lx0, y0, lx1, y1, config.outline_color)
        out = surface_draw_line_smooth(out, rx0, y0, rx1, y1, config.outline_color)
        j = j + 1
    }

    out
}

pub fn plot_hexbin_raster(
    s: Surface,
    xs: &[f64; 256],
    ys: &[f64; 256],
    values: &[f64; 256],
    n: i64,
    config: QualityHexbinPlotConfig
) -> Surface with Mut, Panic, Div {
    if n <= 0 { return s }

    var out = s
    let margin = sanitize_margin(config.margin, out.width, out.height)
    let plot_w = out.width - margin * 2
    let plot_h = out.height - margin * 2
    if plot_w <= 0 || plot_h <= 0 { return out }

    var count = n
    if count > 256 { count = 256 }

    var xmin = xs[0]
    var xmax = xs[0]
    var ymin = ys[0]
    var ymax = ys[0]
    var max_value = values[0]
    if max_value < 0.0 { max_value = 0.0 }

    var i: i64 = 1
    while i < count {
        if xs[i] < xmin { xmin = xs[i] }
        if xs[i] > xmax { xmax = xs[i] }
        if ys[i] < ymin { ymin = ys[i] }
        if ys[i] > ymax { ymax = ys[i] }
        if values[i] > max_value { max_value = values[i] }
        i = i + 1
    }
    if max_value <= 0.0 { max_value = 1.0 }

    let x_range_raw = xmax - xmin
    let y_range_raw = ymax - ymin
    let x_range = if x_range_raw == 0.0 { 1.0 } else { x_range_raw }
    let y_range = if y_range_raw == 0.0 { 1.0 } else { y_range_raw }
    if x_range_raw == 0.0 {
        xmin = xmin - 0.5
        xmax = xmax + 0.5
    }
    if y_range_raw == 0.0 {
        ymin = ymin - 0.5
        ymax = ymax + 0.5
    }

    out = surface_draw_rect(out, 0, 0, out.width, out.height, config.bg_color)
    out = surface_draw_rect(out, margin, margin, 1, plot_h, config.axis_color)
    out = surface_draw_rect(out, margin, out.height - margin - 1, plot_w, 1, config.axis_color)

    var radius = config.radius
    if radius < 2 { radius = 2 }
    if radius > 24 { radius = 24 }

    var j: i64 = 0
    while j < count {
        if values[j] > 0.0 {
            let px = map_x(xs[j], xmin, x_range, margin, plot_w)
            let py = map_y(ys[j], ymin, y_range, out.height, margin, plot_h)
            let t = values[j] / max_value
            let fill = quality_colormap_viridis(t)
            out = draw_quality_hexagon(out, px, py, radius, fill, config.outline_color)
        }
        j = j + 1
    }

    out
}

pub fn quality_colormap_viridis(t: f64) -> Color {
    let nt = clamp_unit(t)
    if nt < 0.25 {
        let u = nt / 0.25
        lerp_color(
            Color { r: 68, g: 1, b: 84, a: 255 },
            Color { r: 59, g: 82, b: 139, a: 255 },
            u
        )
    } else if nt < 0.5 {
        let u = (nt - 0.25) / 0.25
        lerp_color(
            Color { r: 59, g: 82, b: 139, a: 255 },
            Color { r: 33, g: 145, b: 140, a: 255 },
            u
        )
    } else if nt < 0.75 {
        let u = (nt - 0.5) / 0.25
        lerp_color(
            Color { r: 33, g: 145, b: 140, a: 255 },
            Color { r: 94, g: 201, b: 98, a: 255 },
            u
        )
    } else {
        let u = (nt - 0.75) / 0.25
        lerp_color(
            Color { r: 94, g: 201, b: 98, a: 255 },
            Color { r: 253, g: 231, b: 37, a: 255 },
            u
        )
    }
}

fn edge_crosses(a: f64, b: f64, level: f64) -> bool {
    (a < level && b >= level) || (b < level && a >= level)
}

fn interp_i64(a: i64, b: i64, va: f64, vb: f64, level: f64) -> i64 {
    let denom = vb - va
    let t = if denom == 0.0 { 0.5 } else { clamp_unit((level - va) / denom) }
    a + (((b - a) as f64) * t) as i64
}

fn draw_quality_grid(
    s: Surface,
    margin: i64,
    plot_w: i64,
    plot_h: i64,
    config: QualityLinePlotConfig
) -> Surface with Mut, Panic, Div {
    var out = s
    var steps = config.grid_steps
    if steps < 1 { steps = 1 }
    if steps > 16 { steps = 16 }

    let grid = Color {
        r: config.grid_color.r,
        g: config.grid_color.g,
        b: config.grid_color.b,
        a: clamp_byte(config.grid_alpha),
    }

    var k: i64 = 1
    while k < steps {
        let x = margin + (plot_w * k) / steps
        let y = margin + (plot_h * k) / steps
        out = draw_v_alpha_line(out, x, margin, margin + plot_h - 1, grid)
        out = draw_h_alpha_line(out, margin, margin + plot_w - 1, y, grid)
        k = k + 1
    }

    out
}

fn sample_nearest(data: &[f64; 4096], rows: i64, cols: i64, px: i64, py: i64, plot_w: i64, plot_h: i64) -> f64 with Div {
    let gx = if plot_w <= 1 { 0.0 } else { (px as f64) / ((plot_w - 1) as f64) * ((cols - 1) as f64) }
    let gy_top = if plot_h <= 1 { 0.0 } else { (py as f64) / ((plot_h - 1) as f64) * ((rows - 1) as f64) }
    let col = clamp_i64((gx + 0.5) as i64, 0, cols - 1)
    let row_from_top = clamp_i64((gy_top + 0.5) as i64, 0, rows - 1)
    let row = rows - 1 - row_from_top
    data[row * cols + col]
}

fn sample_bilinear(data: &[f64; 4096], rows: i64, cols: i64, px: i64, py: i64, plot_w: i64, plot_h: i64) -> f64 with Div {
    let gx = if plot_w <= 1 { 0.0 } else { (px as f64) / ((plot_w - 1) as f64) * ((cols - 1) as f64) }
    let gy_top = if plot_h <= 1 { 0.0 } else { (py as f64) / ((plot_h - 1) as f64) * ((rows - 1) as f64) }
    let gy = ((rows - 1) as f64) - gy_top

    let x0 = clamp_i64(gx as i64, 0, cols - 1)
    let y0 = clamp_i64(gy as i64, 0, rows - 1)
    let x1 = clamp_i64(x0 + 1, 0, cols - 1)
    let y1 = clamp_i64(y0 + 1, 0, rows - 1)
    let tx = gx - (x0 as f64)
    let ty = gy - (y0 as f64)

    let v00 = data[y0 * cols + x0]
    let v10 = data[y0 * cols + x1]
    let v01 = data[y1 * cols + x0]
    let v11 = data[y1 * cols + x1]
    let a = v00 * (1.0 - tx) + v10 * tx
    let b = v01 * (1.0 - tx) + v11 * tx
    a * (1.0 - ty) + b * ty
}

fn lerp_color(a: Color, b: Color, t: f64) -> Color {
    let u = clamp_unit(t)
    Color {
        r: ((a.r as f64) * (1.0 - u) + (b.r as f64) * u) as i64,
        g: ((a.g as f64) * (1.0 - u) + (b.g as f64) * u) as i64,
        b: ((a.b as f64) * (1.0 - u) + (b.b as f64) * u) as i64,
        a: 255,
    }
}

fn draw_v_alpha_line(s: Surface, x: i64, y0: i64, y1: i64, c: Color) -> Surface with Mut, Panic, Div {
    var out = s
    var y = y0
    while y <= y1 {
        out = surface_blend_pixel(out, x, y, c, 255)
        y = y + 1
    }
    out
}

fn draw_h_alpha_line(s: Surface, x0: i64, x1: i64, y: i64, c: Color) -> Surface with Mut, Panic, Div {
    var out = s
    var x = x0
    while x <= x1 {
        out = surface_blend_pixel(out, x, y, c, 255)
        x = x + 1
    }
    out
}

fn draw_quality_marker(
    s: Surface,
    cx: i64,
    cy: i64,
    radius: i64,
    fill: Color,
    outline: Color
) -> Surface with Mut, Panic, Div {
    var out = s
    let outer = radius + 1
    let outer2 = outer * outer
    let fill2 = radius * radius
    let inner_outline = radius - 1
    let inner2 = if inner_outline <= 0 { 0 } else { inner_outline * inner_outline }

    var dy = 0 - outer
    while dy <= outer {
        var dx = 0 - outer
        while dx <= outer {
            let d2 = dx * dx + dy * dy
            let x = cx + dx
            let y = cy + dy
            if d2 <= fill2 {
                out = surface_blend_pixel(out, x, y, fill, 255)
            } else if d2 <= outer2 && d2 >= inner2 {
                out = surface_blend_pixel(out, x, y, outline, 255)
            }
            dx = dx + 1
        }
        dy = dy + 1
    }
    out
}

fn draw_quality_hexagon(
    s: Surface,
    cx: i64,
    cy: i64,
    radius: i64,
    fill: Color,
    outline: Color
) -> Surface with Mut, Panic, Div {
    var out = s
    var half = radius / 2
    if half < 1 { half = 1 }

    var dy = 0 - radius
    while dy <= radius {
        let ady = if dy < 0 { 0 - dy } else { dy }
        var span = radius - (ady * half) / radius
        if span < half { span = half }
        let y = cy + dy
        if y >= 0 && y < out.height {
            var x = cx - span
            let x_end = cx + span
            while x <= x_end {
                if x >= 0 && x < out.width {
                    let idx = y * out.width + x
                    out.r[idx] = fill.r
                    out.g[idx] = fill.g
                    out.b[idx] = fill.b
                    out.a[idx] = fill.a
                }
                x = x + 1
            }
        }
        dy = dy + 1
    }

    out = surface_draw_line_smooth(out, cx - half, cy - radius, cx + half, cy - radius, outline)
    out = surface_draw_line_smooth(out, cx + half, cy - radius, cx + radius, cy, outline)
    out = surface_draw_line_smooth(out, cx + radius, cy, cx + half, cy + radius, outline)
    out = surface_draw_line_smooth(out, cx + half, cy + radius, cx - half, cy + radius, outline)
    out = surface_draw_line_smooth(out, cx - half, cy + radius, cx - radius, cy, outline)
    out = surface_draw_line_smooth(out, cx - radius, cy, cx - half, cy - radius, outline)

    out
}

fn map_x(x: f64, xmin: f64, xrange: f64, margin: i64, plot_w: i64) -> i64 {
    let t = clamp_unit((x - xmin) / xrange)
    margin + (t * (plot_w as f64)) as i64
}

fn map_y(y: f64, ymin: f64, yrange: f64, height: i64, margin: i64, plot_h: i64) -> i64 {
    let t = clamp_unit((y - ymin) / yrange)
    height - margin - 1 - (t * (plot_h as f64)) as i64
}

fn sanitize_margin(m: i64, w: i64, h: i64) -> i64 with Mut, Div {
    var out = m
    if out < 2 { out = 2 }
    let max_w = w / 3
    let max_h = h / 3
    let max_m = if max_w < max_h { max_w } else { max_h }
    if out > max_m { out = max_m }
    out
}

fn clamp_i64(v: i64, lo: i64, hi: i64) -> i64 {
    if v < lo { lo } else if v > hi { hi } else { v }
}

fn clamp_unit(v: f64) -> f64 {
    if v < 0.0 { 0.0 } else if v > 1.0 { 1.0 } else { v }
}

fn clamp_byte(v: i64) -> i64 {
    if v < 0 { 0 } else if v > 255 { 255 } else { v }
}

fn blend_direct_channel(dst: i64, src: i64, alpha: i64) -> i64 {
    let d = clamp_byte(dst)
    let s = clamp_byte(src)
    let a = clamp_byte(alpha)
    (s * a + d * (255 - a) + 127) / 255
}

fn main() -> i32 with IO { 0 }
