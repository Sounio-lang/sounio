// Graphics Quality — high-quality scientific raster plots
//
// Builds on graphics::raster for antialiased lines and alpha-blended grids.
// This is the opt-in path for publication-style raster output while the base
// plot module remains the compact compatibility implementation.

use graphics::drawing::{Color}
use graphics::surface::{Surface, surface_draw_rect}
use graphics::raster::{surface_blend_pixel, surface_draw_line_smooth}

