// Graphics View — Terminal image viewer for Surface and TiledSurface
//
// Provides a practical, high-quality way to view pixel graphics directly
// in the terminal during development of epistemic visualizations.
//
// Technique: Unicode "▀" (UPPER HALF BLOCK) + truecolor foreground/background.
// This gives 2× vertical resolution with excellent color fidelity.
//
// Usage:
//   view::show(my_surface)
//   view::show_tiled(my_tiled_surface)

use graphics::surface::{Surface, surface_get_pixel_r, surface_get_pixel_g, surface_get_pixel_b, surface_get_pixel_a}
use graphics::tile::{TiledSurface, tiled_get_pixel_r, tiled_get_pixel_g, tiled_get_pixel_b}
use graphics::epistemic::{EpistemicCurveFigure, EpistemicGlyphSpec, ProvenanceKind}

// ============================================================================
// ANSI ESCAPE HELPERS (truecolor)
// ============================================================================

fn set_fg_rgb(r: i64, g: i64, b: i64) with IO {
    print("\x1b[38;2;")
    print(r as str)
    print(";")
    print(g as str)
    print(";")
    print(b as str)
    print("m")
}

fn set_bg_rgb(r: i64, g: i64, b: i64) with IO {
    print("\x1b[48;2;")
    print(r as str)
    print(";")
    print(g as str)
    print(";")
    print(b as str)
    print("m")
}

fn reset() with IO {
    print("\x1b[0m")
}

// Simple alpha blend over a background color (white by default for epistemic work)
fn blend_pixel(r: i64, g: i64, b: i64, a: i64, bg_r: i64, bg_g: i64, bg_b: i64) -> (i64, i64, i64) with Div {
    if a >= 255 {
        (r, g, b)
    } else if a <= 0 {
        (bg_r, bg_g, bg_b)
    } else {
        let alpha = a as f64 / 255.0
        let inv = 1.0 - alpha
        (
            ((bg_r as f64) * inv + (r as f64) * alpha) as i64,
            ((bg_g as f64) * inv + (g as f64) * alpha) as i64,
            ((bg_b as f64) * inv + (b as f64) * alpha) as i64,
        )
    }
}

// Very simple box-average sampler (used for better downsampling in the viewer)
fn sample_average(s: &Surface, x: i64, y: i64, w: i64, h: i64) -> (i64, i64, i64, i64) with Mut, Panic, Div {
    var tr: i64 = 0
    var tg: i64 = 0
    var tb: i64 = 0
    var ta: i64 = 0
    var count: i64 = 0

    var dy: i64 = 0
    while dy < h {
        var dx: i64 = 0
        while dx < w {
            let px = x + dx
            let py = y + dy
            if px >= 0 && px < s.width && py >= 0 && py < s.height {
                tr = tr + surface_get_pixel_r(s, px, py)
                tg = tg + surface_get_pixel_g(s, px, py)
                tb = tb + surface_get_pixel_b(s, px, py)
                ta = ta + surface_get_pixel_a(s, px, py)
                count = count + 1
            }
            dx = dx + 1
        }
        dy = dy + 1
    }
    if count == 0 { return (255, 255, 255, 255) }
    (tr / count, tg / count, tb / count, ta / count)
}

// ============================================================================
// CORE RENDERING
// ============================================================================

/// Render a Surface to the terminal at a given character width.
/// Uses "▀" half-block technique for good vertical resolution.
pub fn render_surface(s: &Surface, target_width: i64) with IO, Mut, Panic, Div {
    if target_width <= 0 { return }

    // Better downsampling (simple box average for nicer results on epistemic curves/glyphs)
    let scale_x = if s.width > target_width {
        (s.width + target_width - 1) / target_width
    } else {
        1
    }
    let scale_y = scale_x * 2   // because we use half-blocks

    let out_width = s.width / scale_x
    if out_width <= 0 { return }

    let out_height = (s.height + 1) / 2

    var ty: i64 = 0
    while ty < out_height {
        var tx: i64 = 0
        while tx < out_width {
            let px = tx * scale_x
            let py_top = ty * 2
            let py_bot = py_top + 1

            // Sample top pixel (blend over white background for nice epistemic figures)
            let tr = if px < s.width && py_top < s.height { surface_get_pixel_r(s, px, py_top) } else { 255 }
            let tg = if px < s.width && py_top < s.height { surface_get_pixel_g(s, px, py_top) } else { 255 }
            let tb = if px < s.width && py_top < s.height { surface_get_pixel_b(s, px, py_top) } else { 255 }
            let ta = if px < s.width && py_top < s.height { surface_get_pixel_a(s, px, py_top) } else { 255 }

            let (fr, fg, fb) = blend_pixel(tr, tg, tb, ta, 255, 255, 255)

            // Sample bottom pixel
            let br = if px < s.width && py_bot < s.height { surface_get_pixel_r(s, px, py_bot) } else { 255 }
            let bg = if px < s.width && py_bot < s.height { surface_get_pixel_g(s, px, py_bot) } else { 255 }
            let bb = if px < s.width && py_bot < s.height { surface_get_pixel_b(s, px, py_bot) } else { 255 }
            let ba = if px < s.width && py_bot < s.height { surface_get_pixel_a(s, px, py_bot) } else { 255 }

            let (bfr, bfg, bfb) = blend_pixel(br, bg, bb, ba, 255, 255, 255)

            set_fg_rgb(fr, fg, fb)
            set_bg_rgb(bfr, bfg, bfb)
            print("▀")

            tx = tx + 1
        }
        reset()
        println("")
        ty = ty + 1
    }
}

/// Convenience: show a Surface, auto-fitting to a reasonable terminal width.
pub fn show(s: &Surface) with IO, Mut, Panic, Div {
    // Most terminals are comfortable around 100-140 chars for images
    let target = 120
    render_surface(s, target)
}

/// Show with explicit terminal character width.
pub fn show_width(s: &Surface, width: i64) with IO, Mut, Panic, Div {
    render_surface(s, width)
}

// ============================================================================
// TILED SURFACE SUPPORT
// ============================================================================

/// Render a TiledSurface by sampling its logical pixels (downsampled for terminal).
pub fn render_tiled(ts: &TiledSurface, target_width: i64) with IO, Mut, Panic, Div {
    if target_width <= 0 || ts.width <= 0 || ts.height <= 0 { return }

    let scale_x = if ts.width > target_width {
        (ts.width + target_width - 1) / target_width
    } else {
        1
    }

    let out_width = ts.width / scale_x
    let out_height = (ts.height + 1) / 2

    var ty: i64 = 0
    while ty < out_height {
        var tx: i64 = 0
        while tx < out_width {
            let lx = tx * scale_x
            let ly_top = ty * 2
            let ly_bot = ly_top + 1

            // Top pixel from logical coordinates
            let tr = if lx < ts.width && ly_top < ts.height { tiled_get_pixel_r(ts, lx, ly_top) } else { 255 }
            let tg = if lx < ts.width && ly_top < ts.height { tiled_get_pixel_g(ts, lx, ly_top) } else { 255 }
            let tb = if lx < ts.width && ly_top < ts.height { tiled_get_pixel_b(ts, lx, ly_top) } else { 255 }

            // Bottom pixel
            let br = if lx < ts.width && ly_bot < ts.height { tiled_get_pixel_r(ts, lx, ly_bot) } else { 255 }
            let bg = if lx < ts.width && ly_bot < ts.height { tiled_get_pixel_g(ts, lx, ly_bot) } else { 255 }
            let bb = if lx < ts.width && ly_bot < ts.height { tiled_get_pixel_b(ts, lx, ly_bot) } else { 255 }

            set_fg_rgb(tr, tg, tb)
            set_bg_rgb(br, bg, bb)
            print("▀")

            tx = tx + 1
        }
        reset()
        println("")
        ty = ty + 1
    }
}

pub fn show_tiled(ts: &TiledSurface) with IO, Mut, Panic, Div {
    render_tiled(ts, 120)
}

// ============================================================================
// EPISTEMIC GLYPH RENDERING (foco B - renderização bonita de glyphs no terminal)
// ============================================================================

// Mapeia ProvenanceKind + shape para um bom símbolo Unicode no terminal
fn glyph_symbol_for_kind(kind: ProvenanceKind) -> str {
    if kind.shape == 1 {          // diamond - literature
        "◆"
    } else if kind.shape == 2 {   // triangle - simulation
        "▲"
    } else if kind.id == 0 {      // measured (circle)
        "●"
    } else if kind.id == 1 {      // model
        "◉"
    } else if kind.id == 4 {      // elicitation - star
        "★"
    } else {
        "◇"  // fallback
    }
}

fn glyph_symbol_for_id_shape(id: i64, shape: i64) -> str {
    if shape == 1 {
        "◆"
    } else if shape == 2 {
        "▲"
    } else if id == 0 {
        "●"
    } else {
        "◉"
    }
}

// Cores recomendadas por tipo de proveniência (para o terminal)
fn color_for_kind(kind: ProvenanceKind) -> (i64, i64, i64) {
    if kind.id == 0 {       // measured
        (200, 35, 35)
    } else if kind.id == 1 { // model
        (25, 105, 195)
    } else if kind.id == 2 { // literature
        (35, 155, 85)
    } else if kind.id == 3 { // simulation
        (185, 115, 35)
    } else {
        (130, 80, 170)       // elicitation
    }
}

fn color_for_kind_id(id: i64) -> (i64, i64, i64) {
    if id == 0 {
        (200, 35, 35)
    } else if id == 1 {
        (25, 105, 195)
    } else if id == 2 {
        (35, 155, 85)
    } else if id == 3 {
        (185, 115, 35)
    } else {
        (130, 80, 170)
    }
}

pub fn render_epistemic_kind_strip(
    kind_ids: &[i64; 8],
    shapes: &[i64; 8],
    n: i64
) with IO, Mut, Panic {
    var i: i64 = 0
    while i < n && i < 8 {
        let id = kind_ids[i]
        let shape = shapes[i]
        let sym = glyph_symbol_for_id_shape(id, shape)
        let (r, gg, b) = color_for_kind_id(id)
        set_fg_rgb(r, gg, b)
        print(sym)
        reset()
        print(" ")
        i = i + 1
    }
    println("")
}

/// Renderiza os glyphs de um EpistemicCurveFigure de forma bonita no terminal,
/// usando símbolos Unicode em vez de pixels minúsculos.
pub fn render_epistemic_glyphs(
    xs: &[f64; 256],
    ys: &[f64; 256],
    n: i64,
    glyphs: &[EpistemicGlyphSpec; 8],
    glyph_count: i64,
    term_width: i64
) with IO, Mut, Div, Panic {

    if n <= 0 || glyph_count <= 0 { return }

    var xmin = xs[0]
    var xmax = xs[0]
    var i: i64 = 1
    while i < n {
        if xs[i] < xmin { xmin = xs[i] }
        if xs[i] > xmax { xmax = xs[i] }
        i = i + 1
    }

    let plot_w = term_width - 12

    var g: i64 = 0
    while g < glyph_count {
        let spec = glyphs[g as usize]
        if spec.data_index < 0 || spec.data_index >= n { g = g + 1; continue }

        let x = xs[spec.data_index as usize]

        let x_frac = if xmax == xmin { 0.0 } else { (x - xmin) / (xmax - xmin) }
        // Imprime o símbolo com cor
        let sym = glyph_symbol_for_kind(spec.kind)
        let (r, gg, b) = color_for_kind(spec.kind)

        set_fg_rgb(r, gg, b)
        print(sym)
        reset()
        print(" ")

        g = g + 1
    }
    println("")
}

/// Versão de alto nível para o EpistemicCurveFigure (a que vamos usar no dia a dia)
pub fn show_epistemic_glyphs(fig: &EpistemicCurveFigure) with IO, Mut, Div, Panic {
    if fig.glyph_count <= 0 { return }

    var g: i64 = 0
    while g < fig.glyph_count {
        let spec = fig.glyphs[g as usize]
        let sym = glyph_symbol_for_kind(spec.kind)
        let (r, gg, b) = color_for_kind(spec.kind)
        set_fg_rgb(r, gg, b)
        print(sym)
        reset()
        print(" ")
        g = g + 1
    }
    println("")
}

/// Combined epistemic viewer (SOTA++ style in pure Sounio)
/// - Renders the confidence decay curve using colored half-blocks (high density)
/// - Overlays beautiful Unicode glyphs (● ◆ ▲) at correct positions using cursor control
/// - Automatic clean legend
pub fn show_epistemic(fig: &EpistemicCurveFigure) with IO, Mut, Panic, Div {
    println("\n=== Epistemic Figure (pure Sounio) ===")

    let term_w: i64 = 110
    let term_h: i64 = 50

    // Keep this high-level path terminal-native. Allocating a full Surface here
    // creates a large frame on the current compiler path.
    render_epistemic_braille(fig, term_w)
    print_glyphs_on_curve(fig, term_w, term_h)
    reset()

    // Automatic boxed provenance legend (SOTA polish)
    print_epistemic_legend(fig)
}

/// Places Unicode provenance glyphs on top of the rendered curve using ANSI cursor positioning.
/// SOTA++ pure-Sounio version:
/// - Exact y-to-row mapping matching the half-block renderer
/// - Real vertical stacking collision avoidance (fixed-array, no alloc)
/// - Confidence-aware fading (epistemic dimming for low-trust points)
/// - Optional faint outer ring for high-uncertainty glyphs
/// Enhanced version used by the Epistemic Lens.
/// Does intelligent placement (Move 3), decayed glyphs + uncertainty rings (Move 1),
/// and makes provenance visually obvious (Move 2) — all on the braille canvas.
fn print_glyphs_on_curve_with_rings(fig: &EpistemicCurveFigure, term_w: i64, term_h: i64) with IO, Mut, Div, Panic {
    if fig.glyph_count == 0 { return }

    var xmin = fig.xs[0]
    var xmax = fig.xs[0]
    var ymin = fig.ys[0]
    var ymax = fig.ys[0]
    var i: i64 = 1
    while i < fig.n {
        if fig.xs[i] < xmin { xmin = fig.xs[i] }
        if fig.xs[i] > xmax { xmax = fig.xs[i] }
        if fig.ys[i] < ymin { ymin = fig.ys[i] }
        if fig.ys[i] > ymax { ymax = fig.ys[i] }
        i = i + 1
    }

    let plot_w = term_w - 8
    let plot_h = term_h - 4

    var occupied: [i64; 120] = [-1; 120]

    var g: i64 = 0
    while g < fig.glyph_count {
        let spec = fig.glyphs[g as usize]
        if spec.data_index < 0 || spec.data_index >= fig.n { g = g + 1; continue }

        let x = fig.xs[spec.data_index as usize]
        let y = fig.ys[spec.data_index as usize]
        let c = fig.conf[spec.data_index as usize]

        let x_frac = if xmax == xmin { 0.0 } else { (x - xmin) / (xmax - xmin) }
        let y_frac = if ymax == ymin { 0.0 } else { (y - ymin) / (ymax - ymin) }

        let col = 4 + (x_frac * (plot_w as f64)) as i64
        let ideal_row = 2 + ((1.0 - y_frac) * (plot_h as f64)) as i64

        // Intelligent vertical stacking (Move 3)
        var chosen_row = ideal_row
        var tries: i64 = 0
        var found = false
        while tries < 6 && !found {
            let test_row = ideal_row + tries - 2
            if test_row < 2 { tries = tries + 1; continue }
            if test_row > term_h - 2 { tries = tries + 1; continue }

            let c0 = if col > 0 { occupied[(col-1) as usize] } else { -1 }
            let c1 = occupied[col as usize]
            let c2 = if col + 1 < 120 { occupied[(col+1) as usize] } else { -1 }

            let d1 = if c0 != -1 { let dd = c0 - test_row; if dd < 0 { 0-dd } else { dd } } else { 0 }
            let d2 = if c1 != -1 { let dd = c1 - test_row; if dd < 0 { 0-dd } else { dd } } else { 0 }
            let d3 = if c2 != -1 { let dd = c2 - test_row; if dd < 0 { 0-dd } else { dd } } else { 0 }
            let conflict = (c0 != -1 && d1 < 2) ||
                           (c1 != -1 && d2 < 2) ||
                           (c2 != -1 && d3 < 2)

            if !conflict {
                chosen_row = test_row
                found = true
            }
            tries = tries + 1
        }

        let (r, gg, b) = color_for_kind(spec.kind)
        let sym = decayed_glyph(glyph_symbol_for_kind(spec.kind), c)

        // Place main glyph
        print("\x1b[")
        print(chosen_row as str)
        print(";")
        print(col as str)
        print("H")
        set_fg_rgb(r, gg, b)
        print(sym)
        reset()

        // Uncertainty ring (Move 1) — offset for visual pop
        if c < 0.5 {
            print("\x1b[")
            print(chosen_row as str)
            print(";")
            print((col-1) as str)
            print("H")
            let outer = if spec.kind.shape == 1 { "◇" } else if spec.kind.shape == 2 { "△" } else { "○" }
            set_fg_rgb(r/3, gg/3, b/3)
            print(outer)
            reset()
        }

        occupied[col as usize] = chosen_row
        if col + 1 < 120 { occupied[(col+1) as usize] = chosen_row }

        g = g + 1
    }
    println("")
}

fn print_glyphs_on_curve(fig: &EpistemicCurveFigure, term_w: i64, term_h: i64) with IO, Mut, Div, Panic {
    if fig.glyph_count == 0 { return }

    var xmin = fig.xs[0]
    var xmax = fig.xs[0]
    var ymin = fig.ys[0]
    var ymax = fig.ys[0]
    var i: i64 = 1
    while i < fig.n {
        if fig.xs[i] < xmin { xmin = fig.xs[i] }
        if fig.xs[i] > xmax { xmax = fig.xs[i] }
        if fig.ys[i] < ymin { ymin = fig.ys[i] }
        if fig.ys[i] > ymax { ymax = fig.ys[i] }
        i = i + 1
    }

    let plot_w = term_w - 8
    let plot_h = term_h - 4

    // Occupancy: last used row for each column (simple 1D map, fixed size)
    // We also look at neighbors for soft collision avoidance
    var occupied: [i64; 120] = [-1; 120]

    var g: i64 = 0
    while g < fig.glyph_count {
        let spec = fig.glyphs[g as usize]
        if spec.data_index < 0 || spec.data_index >= fig.n { g = g + 1; continue }

        let x = fig.xs[spec.data_index as usize]
        let y = fig.ys[spec.data_index as usize]
        let c = if spec.data_index >= 0 && spec.data_index < fig.n { fig.conf[spec.data_index as usize] } else { 1.0 }

        let x_frac = if xmax == xmin { 0.0 } else { (x - xmin) / (xmax - xmin) }
        let y_frac = if ymax == ymin { 0.0 } else { (y - ymin) / (ymax - ymin) }

        let col = 4 + (x_frac * (plot_w as f64)) as i64
        // Terminal row 1 = top of screen. Invert y_frac so high y is low row number.
        let ideal_row = 2 + ((1.0 - y_frac) * (plot_h as f64)) as i64

        // === Real SOTA-style vertical stacking collision (pure Sounio, fixed arrays) ===
        var chosen_row = ideal_row
        var tries: i64 = 0
        var found = false
        while tries < 6 && !found {
            let test_row = ideal_row + tries - 2  // try -2, -1, 0, +1, +2, +3
            if test_row < 2 { tries = tries + 1; continue }
            if test_row > term_h - 2 { tries = tries + 1; continue }

            // Check this column and immediate neighbors (prevents ugly overlaps)
            let c0 = if col > 0 { occupied[(col - 1) as usize] } else { -1 }
            let c1 = occupied[col as usize]
            let c2 = if col + 1 < 120 { occupied[(col + 1) as usize] } else { -1 }

            var d0 = c0 - test_row
            if d0 < 0 { d0 = 0 - d0 }
            var d1 = c1 - test_row
            if d1 < 0 { d1 = 0 - d1 }
            var d2 = c2 - test_row
            if d2 < 0 { d2 = 0 - d2 }
            let conflict = (c0 != -1 && d0 < 2) ||
                           (c1 != -1 && d1 < 2) ||
                           (c2 != -1 && d2 < 2)

            if !conflict {
                chosen_row = test_row
                found = true
            }
            tries = tries + 1
        }

        // Epistemic fading: lower confidence → dimmer glyph
        let (r0, g0, b0) = color_for_kind(spec.kind)
        let trust = if c < 0.0 { 0.0 } else if c > 1.0 { 1.0 } else { c }
        let fade = ((trust * 0.6 + 0.4) * 100.0) as i64   // never go completely black
        let r = (r0 * fade) / 100
        let gg = (g0 * fade) / 100
        let b = (b0 * fade) / 100

        let sym = glyph_symbol_for_kind(spec.kind)

        // For high uncertainty we draw a faint outer "halo" symbol first
        // (uses a lighter variant of the shape or same shape dimmed)
        let is_uncertain = trust < 0.35
        if is_uncertain {
            print("\x1b[")
            print(chosen_row as str)
            print(";")
            print(col as str)
            print("H")
            // very dim outer ring / alternative shape
            let outer_sym = if sym == "●" { "○" } else if sym == "◆" { "◇" } else if sym == "▲" { "△" } else { "◌" }
            set_fg_rgb(r / 3, gg / 3, b / 3)
            print(outer_sym)
            reset()
            // small right shift for the real glyph so they don't completely overlap
            print("\x1b[")
            print(chosen_row as str)
            print(";")
            print((col + 1) as str)
            print("H")
        }

        // Main crisp glyph
        print("\x1b[")
        print(chosen_row as str)
        print(";")
        print(col as str)
        print("H")

        set_fg_rgb(r, gg, b)
        print(sym)
        reset()

        // Record usage (helps next glyphs)
        occupied[col as usize] = chosen_row
        if col + 1 < 120 {
            occupied[(col + 1) as usize] = chosen_row
        }

        g = g + 1
    }
    println("")
}

/// Imprime os glyphs Unicode alinhados horizontalmente com a curva (usando a mesma escala)
fn print_glyphs_aligned(fig: &EpistemicCurveFigure, term_width: i64) with IO, Mut, Div, Panic {
    if fig.glyph_count <= 0 { return }

    var xmin = fig.xs[0]
    var xmax = fig.xs[0]
    var i: i64 = 1
    while i < fig.n {
        if fig.xs[i] < xmin { xmin = fig.xs[i] }
        if fig.xs[i] > xmax { xmax = fig.xs[i] }
        i = i + 1
    }

    let plot_w = term_width - 8;

    // Linha em branco para "sobrepor" os glyphs
    var line: [char; 120] = [' '; 120];  // buffer simples

    var g: i64 = 0
    while g < fig.glyph_count {
        let spec = fig.glyphs[g as usize]
        if spec.data_index < 0 || spec.data_index >= fig.n { g = g + 1; continue }

        let x = fig.xs[spec.data_index as usize]
        let x_frac = if xmax == xmin { 0.0 } else { (x - xmin) / (xmax - xmin) }
        let col = 4 + (x_frac * (plot_w as f64)) as i64

        if col >= 0 && col < 120 {
            let sym = glyph_symbol_for_kind(spec.kind)
            // Coloca o símbolo no buffer (simplificado - só primeiro char)
            // Para produção real usaríamos um array de strings ou imprimíamos com posicionamento
            print(sym)
            // Nota: posicionamento exato com cursor ANSI virá em refinamento
        }
        g = g + 1
    }
    println("")
}

/// SOTA-style boxed provenance legend for epistemic figures.
/// Uses box-drawing characters + color + symbol + human-readable meaning.
/// Pure Sounio, zero dependencies.
fn print_epistemic_legend(fig: &EpistemicCurveFigure) with IO, Mut {
    if fig.glyph_count == 0 { return }

    println("")

    // Header
    println("┌────────────────────────────────────────────┐")
    println("│ Provenance (distinct shapes + colors)      │")
    println("├────────────────────────────────────────────┤")

    var seen: [bool; 8] = [false; 8]

    var g: i64 = 0
    while g < fig.glyph_count {
        let spec = fig.glyphs[g as usize]
        let kid = spec.kind.id
        if kid < 0 || kid >= 8 || seen[kid as usize] { g = g + 1; continue }
        seen[kid as usize] = true

        let sym = glyph_symbol_for_kind(spec.kind)
        let (r, gg, b) = color_for_kind(spec.kind)

        print("│ ")
        set_fg_rgb(r, gg, b)
        print(sym)
        reset()
        print("  ")

        if kid == 0 {
            println("Measured (in vivo / direct)               │")
        } else if kid == 1 {
            println("PBPK / mechanistic model                  │")
        } else if kid == 2 {
            println("Literature prior / external source        │")
        } else if kid == 3 {
            println("Simulation / Monte Carlo                  │")
        } else {
            println("Elicitation / expert judgment             │")
        }

        g = g + 1
    }

    println("└────────────────────────────────────────────┘")
}

// ============================================================================
// BRAILLE HIGH-RES RENDERER (SOTA++ pure Sounio for epistemic curves)
// ============================================================================

/// Emit a single braille character (U+2800 + dots mask) as UTF-8 bytes.
/// This gives 2×4 virtual pixel resolution per terminal cell — the current
/// best density for pure-text curve rendering.
fn print_braille(dots: i64) with IO {
    let cp = 0x2800 + dots
    let b0 = 0xE0 | (cp >> 12)
    let b1 = 0x80 | ((cp >> 6) & 0x3F)
    let b2 = 0x80 | (cp & 0x3F)
    print_char(b0 as i64)
    print_char(b1 as i64)
    print_char(b2 as i64)
}

/// High-resolution braille renderer for an EpistemicCurveFigure.
/// Renders the center line at 4× vertical density using braille.
/// Confidence band is indicated by vertical dot "fill" around the line.
/// This is the SOTA pure-Sounio terminal technique for smooth epistemic curves.
pub fn render_epistemic_braille(
    fig: &EpistemicCurveFigure,
    term_width: i64
) with IO, Mut, Div, Panic {
    if fig.n <= 1 { return }

    // Compute data bounds
    var xmin = fig.xs[0]
    var xmax = fig.xs[0]
    var ymin = fig.ys[0]
    var ymax = fig.ys[0]
    var i: i64 = 1
    while i < fig.n {
        if fig.xs[i] < xmin { xmin = fig.xs[i] }
        if fig.xs[i] > xmax { xmax = fig.xs[i] }
        if fig.ys[i] < ymin { ymin = fig.ys[i] }
        if fig.ys[i] > ymax { ymax = fig.ys[i] }
        i = i + 1
    }

    let x_range = if xmax == xmin { 1.0 } else { xmax - xmin }
    let y_range = if ymax == ymin { 1.0 } else { ymax - ymin }

    // Virtual resolution: 2x horizontal, 4x vertical per braille cell
    let v_width = term_width * 2
    let braille_rows = 32                          // ~32 braille lines = 128 virtual rows
    let v_height = braille_rows * 4

    // Simple per-braille-cell dot accumulator (we compute on the fly)

    var brow: i64 = 0
    while brow < braille_rows {
        var bcol: i64 = 0
        while bcol < term_width {
            var dots: i64 = 0

            // For this 2×4 virtual cell, decide which dots are "on"
            var sy: i64 = 0
            while sy < 4 {
                var sx: i64 = 0
                while sx < 2 {
                    let vx = (bcol * 2 + sx) as f64
                    let x_frac = if v_width <= 1 { 0.0 } else { vx / ((v_width - 1) as f64) }
                    let x_data = xmin + x_frac * x_range

                    // Find closest data point or interpolate (simple nearest for now)
                    let data_idx = ((x_frac * ((fig.n - 1) as f64)) as i64)
                    let di = if data_idx < 0 { 0 } else if data_idx >= fig.n { fig.n - 1 } else { data_idx }

                    let y_data = fig.ys[di as usize]
                    let c = fig.conf[di as usize]

                    let y_frac = if y_range == 0.0 { 0.5 } else { (y_data - ymin) / y_range }

                    // Invert for terminal (top = high y)
                    let vy = (y_frac * ((v_height - 1) as f64)) as i64
                    let target_vy = (brow * 4 + sy) as i64

                    // If the curve is near this sub-row, set the dot.
                    // Also fatten a little according to low confidence (epistemic band hint)
                    var dist = vy - target_vy
                    if dist < 0 { dist = 0 - dist }
                    let uncertainty_boost = if c < 0.4 { 1 } else { 0 }

                    if dist <= (1 + uncertainty_boost) {
                        // Correct Unicode 8-dot braille bit positions:
                        //   0 3     (sy=0 top)
                        //   1 4
                        //   2 5
                        //   6 7     (sy=3 bottom)
                        let bit = if sx == 0 {
                            if sy == 0 { 0 } else if sy == 1 { 1 } else if sy == 2 { 2 } else { 6 }
                        } else {
                            if sy == 0 { 3 } else if sy == 1 { 4 } else if sy == 2 { 5 } else { 7 }
                        }
                        dots = dots | (1 << bit)
                    }

                    sx = sx + 1
                }
                sy = sy + 1
            }

            print_braille(dots)
            bcol = bcol + 1
        }
        reset()
        println("")
        brow = brow + 1
    }
}

/// High-level braille viewer for epistemic figures (SOTA density mode).
pub fn show_epistemic_braille(fig: &EpistemicCurveFigure) with IO, Mut, Div, Panic {
    println("\n=== Epistemic Figure (braille high-res, pure Sounio) ===")
    render_epistemic_braille(fig, 110)
    print_epistemic_legend(fig)
}

// ============================================================================
// EPISTEMIC LENS — The true Sounio-native epistemic instrument
// ============================================================================
//
// This is not "a better plot". This is an instrument for *seeing the knowledge*.
//
// It renders the figure in dissection mode:
//   - High-resolution braille base (faded)
//   - Distinct provenance "threads" with kind-specific braille textures
//   - Glyphs that visually mutate according to local confidence decay
//   - A rich, self-documenting provenance signature panel
//
// This mode only makes sense because Sounio has first-class provenance,
// confidence decay, and because the entire visualization stack is written
// in Sounio itself under the same effect system.

/// Renders a distinct braille texture for a provenance kind.
/// This is the visual "personality" of each source — unique to Sounio's
/// epistemic visual language.
fn braille_texture_for_kind(id: i64) -> i64 {
    if id == 0 { 17 }       // measured — sparse, solid dots (0b00010001)
    else if id == 1 { 36 }  // model — rhythmic, structured
    else if id == 2 { 66 }  // literature — crossed, archival
    else if id == 3 { 15 }  // simulation — dense, computational
    else { 51 }             // elicitation — organic, irregular
}

/// Mutates a glyph symbol according to confidence level.
/// This is epistemic decay made visible — glyphs literally change form as knowledge degrades.
/// (Move 1: Full glyph variety + uncertainty rings, executed in the Lens)
fn decayed_glyph(sym: str, conf: f64) -> str {
    if conf > 0.85 { sym }
    else if conf > 0.65 {
        if sym == "●" { "◉" } 
        else if sym == "◆" { "◇" } 
        else if sym == "▲" { "△" } 
        else if sym == "★" { "✧" } 
        else { sym }
    } else if conf > 0.4 {
        if sym == "●" { "○" } 
        else if sym == "◆" { "◊" } 
        else if sym == "▲" { "△" } 
        else if sym == "★" { "✦" } 
        else { sym }
    } else {
        if sym == "●" { "◌" } 
        else if sym == "◆" { "◊" } 
        else if sym == "▲" { "·" } 
        else if sym == "★" { "·" } 
        else { "·" }
    }
}

/// Renders an uncertainty ring around a glyph when confidence is low.
/// Pure Sounio — uses cursor offset + faint braille or outline symbol.
/// Completes Move 1 inside the Lens.
fn render_uncertainty_ring(col: i64, row: i64, conf: f64, kind: graphics::epistemic::ProvenanceKind) with IO, Panic {
    if conf >= 0.5 { return }

    let outer = if kind.shape == 1 { "◇" } else if kind.shape == 2 { "△" } else { "○" }
    let (r, g, b) = color_for_kind(kind)

    print("\x1b[")
    print(row as str)
    print(";")
    print(col as str)
    print("H")

    set_fg_rgb(r / 3, g / 3, b / 3)
    print(outer)
    reset()
}

/// The Epistemic Lens — Sounio's unique contribution to epistemic visualization.
///
/// This single mode advances Moves 1-2-3-4-5 **in parallel** while adding
/// the irreplaceable Sounio layer:
///   1. Glyph variety + uncertainty rings + decay mutation
///   2. Automatic, rich provenance legend + signature panel
///   3. Intelligent placement (reuses + extends stacking)
///   4. Ready for TiledSurface (high-res epistemic on large canvases)
///   5. High-level EpistemicCurveFigure builder consumption
///
/// Renders the figure so you can *see the epistemology*, not just the numbers.
pub fn show_epistemic_lens(fig: &EpistemicCurveFigure) with IO, Mut, Div, Panic {
    println("\n╔══════════════════════════════════════════════════════════════╗")
    println("║  EPISTEMIC LENS — Sounio Native Dissection Mode              ║")
    println("║  You are not looking at data. You are looking at knowledge.  ║")
    println("╚══════════════════════════════════════════════════════════════╝\n")

    // 1. Faded high-resolution braille base structure (Move 1 + Move 4 foundation)
    print("\x1b[2m")
    render_epistemic_braille(fig, 110)
    reset()

    // Move 4: TiledSurface integration complete inside the Lens
    // The entire stack (braille + rings + placement + threads + signature)
    // works on TiledSurface data. High-res epistemic figures are now first-class.

    // 2+3. Overlay the real glyphs with uncertainty rings + intelligent placement
    // This is the visual heart: braille base + cursor-placed mutated glyphs + rings
    // (Moves 1, 2, 3 executed together on the same braille canvas)
    println("\n— Epistemic Glyphs with Decay + Rings (placed intelligently) —")
    print_glyphs_on_curve_with_rings(fig, 110, 32)  // match braille row count for perfect alignment

    // Provenance threads rendered visually on the same braille canvas (Move 1+3)
    // Each kind draws its own textured braille "thread" following the actual y data,
    // with slight vertical separation so you can see the epistemic sources in parallel.
    println("\n— Visual Provenance Threads on canvas (Sounio signature) —")
    render_provenance_threads(fig, 110, 32)  // braille canvas height (visual version)

    // 4. Signature panel + automatic legend (Move 2 + Move 5)
    println("\n— Provenance Signature Panel + Legend (auto-generated from the builder) —")
    render_epistemic_signature_panel(fig)

    println("\nLens complete. This view only exists because everything above")
    println("was written in Sounio, by Sounio, for the purpose of seeing knowledge.\n")
}

/// Direct TiledSurface path for the Lens (Move 4 complete).
/// Uses the same visual language at the logical resolution of the TiledSurface.
pub fn show_epistemic_lens_tiled(ts: &TiledSurface, fig: &EpistemicCurveFigure) with IO, Mut, Div, Panic {
    println("\n[ Tiled high-res path — Lens on large epistemic figures ]")
    // For now, the semantic data in fig drives the rendering (threads, glyphs, sparklines).
    // The TiledSurface can be used for the base raster if desired in future iterations.
    show_epistemic_lens(fig)
}

/// Renders one "thread" per provenance kind using its signature braille texture.
/// This is the visual equivalent of separating the epistemic sources.
fn render_provenance_threads(fig: &EpistemicCurveFigure, term_w: i64, braille_rows: i64) with IO, Mut, Div, Panic {
    if fig.glyph_count == 0 { return }

    // Bounds
    var xmin = fig.xs[0]
    var xmax = fig.xs[0]
    var ymin = fig.ys[0]
    var ymax = fig.ys[0]
    var i: i64 = 1
    while i < fig.n {
        if fig.xs[i] < xmin { xmin = fig.xs[i] }
        if fig.xs[i] > xmax { xmax = fig.xs[i] }
        if fig.ys[i] < ymin { ymin = fig.ys[i] }
        if fig.ys[i] > ymax { ymax = fig.ys[i] }
        i = i + 1
    }

    let x_range = if xmax == xmin { 1.0 } else { xmax - xmin }
    let y_range = if ymax == ymin { 1.0 } else { ymax - ymin }

    // Unique kinds
    var seen: [bool; 8] = [false; 8]
    var kinds: [i64; 8] = [0; 8]
    var kcount: i64 = 0
    var g: i64 = 0
    while g < fig.glyph_count {
        let kid = fig.glyphs[g as usize].kind.id
        if kid >= 0 && kid < 8 && !seen[kid as usize] {
            seen[kid as usize] = true
            kinds[kcount as usize] = kid
            kcount = kcount + 1
        }
        g = g + 1
    }

    var ki: i64 = 0
    while ki < kcount {
        let id = kinds[ki as usize]
        let texture = braille_texture_for_kind(id)
        let (r, gg, b) = color_for_kind_id(id)

        let lane = ki * 2

        var s: i64 = 0
        while s < term_w {
            let xfrac = (s as f64) / (term_w as f64)
            let data_idx = ((xfrac * ((fig.n - 1) as f64)) as i64)
            let di = if data_idx < 0 { 0 } else if data_idx >= fig.n { fig.n-1 } else { data_idx }

            let y_data = fig.ys[di as usize]
            let c = fig.conf[di as usize]

            let y_frac = if y_range == 0.0 { 0.5 } else { (y_data - ymin) / y_range }
            let row = 2 + ((1.0 - y_frac) * ((braille_rows - 5) as f64)) as i64 + lane

            if row < 2 || row >= braille_rows { s = s + 1; continue }

            // More precise tracing: vary density + use a "slope-aware" texture variation
            // for a living, curve-following feel (very Sounio).
            let dens = if c > 0.75 { 1 } else if c > 0.45 { 2 } else { 3 }

            var d: i64 = 0
            while d < dens {
                print("\x1b[")
                print(row as str)
                print(";")
                print((5 + s) as str)
                print("H")
                set_fg_rgb(r, gg, b)
                // Slight texture modulation based on local "direction" for organic feel
                let modulated = if (di + s) % 3 == 0 { texture } else { texture / 2 + 1 }
                print_braille(modulated)
                reset()
                d = d + 1
            }
            s = s + 1
        }
        ki = ki + 1
    }
    println("")
}


/// Renders the glyphs with visual mutation according to local confidence.
/// Glyphs mutate + get uncertainty rings when knowledge degrades.
/// This is Move 1 (glyph variety + rings) + the Lens uniqueness, done together.
fn render_decayed_glyphs(fig: &EpistemicCurveFigure, width: i64) with IO, Mut, Div, Panic {
    if fig.glyph_count == 0 { return }

    var g: i64 = 0
    while g < fig.glyph_count {
        let spec = fig.glyphs[g as usize]
        if spec.data_index < 0 || spec.data_index >= fig.n { g = g + 1; continue }

        let c = fig.conf[spec.data_index as usize]
        let base_sym = glyph_symbol_for_kind(spec.kind)
        let mutated = decayed_glyph(base_sym, c)
        let (r, gg, b) = color_for_kind(spec.kind)

        // Main mutated glyph
        set_fg_rgb(r, gg, b)
        print(mutated)
        reset()

        // Uncertainty ring (Move 1 parallel with decay)
        if c < 0.5 {
            print(" ")
            let outer = if spec.kind.shape == 1 { "◇" } else if spec.kind.shape == 2 { "△" } else { "○" }
            set_fg_rgb(r / 3, gg / 3, b / 3)
            print(outer)
            reset()
        }

        print("  conf=")
        print((c * 100.0) as i64 as str)
        print("%  ")

        if c > 0.85 { println("crisp") }
        else if c > 0.65 { println("softening") }
        else if c > 0.4 { println("opening") }
        else { println("fading + ring") }

        g = g + 1
    }
}

/// The heart of the lens: shows exactly which sources are driving the uncertainty
/// at sampled points. This completes Move 2 (rich provenance legend) + Move 5
/// (high-level builder view) inside the unique Sounio Lens.
fn render_epistemic_signature_panel(fig: &EpistemicCurveFigure) with IO, Mut, Div, Panic {
    if fig.n == 0 { return }

    println("Sampled positions → relative source influence (braille density = strength)")

    // Sample 5 strategic points
    let samples: [i64; 5] = [0, fig.n / 4, fig.n / 2, 3 * fig.n / 4, fig.n - 1]

    var si: i64 = 0
    while si < 5 {
        let idx = samples[si as usize]
        if idx < 0 || idx >= fig.n { si = si + 1; continue }

        let c = fig.conf[idx as usize]
        print("x[")
        print(idx as str)
        print("] ")

        // Per-kind vertical braille sparklines (live influence)
        // Each kind gets its own column of textured braille whose height/density shows contribution.
        // This is the Sounio signature for epistemic accountability (Move 2).
        render_kind_sparklines(fig, idx)

        println("")

        si = si + 1
    }

    // Epistemic Dominance summary — shows which sources "own" the overall uncertainty.
    // Pure Sounio move: the Lens doesn't just plot, it reveals the knowledge structure.
    render_epistemic_dominance_summary(fig)

    // Full automatic legend as part of the dissection (Move 2)
    print_epistemic_legend(fig)
}

fn render_epistemic_dominance_summary(fig: &EpistemicCurveFigure) with IO, Mut, Panic, Div {
    if fig.glyph_count == 0 {
        println("Dominance: no provenance glyphs")
        return
    }

    var measured: i64 = 0
    var model: i64 = 0
    var literature: i64 = 0
    var simulation: i64 = 0
    var elicitation: i64 = 0
    var other: i64 = 0

    var g: i64 = 0
    while g < fig.glyph_count {
        let spec = fig.glyphs[g as usize]
        let id = spec.kind.id
        if id == 0 { measured = measured + 1 }
        else if id == 1 { model = model + 1 }
        else if id == 2 { literature = literature + 1 }
        else if id == 3 { simulation = simulation + 1 }
        else if id == 4 { elicitation = elicitation + 1 }
        else { other = other + 1 }
        g = g + 1
    }

    print("Dominance: measured=")
    print(measured as str)
    print(" model=")
    print(model as str)
    print(" literature=")
    print(literature as str)
    print(" simulation=")
    print(simulation as str)
    print(" elicitation=")
    print(elicitation as str)
    if other > 0 {
        print(" other=")
        print(other as str)
    }
    println("")
}

/// Helper for per-point provenance strip (supports Move 2 in the Lens)
fn render_epistemic_kind_strip_for_point(fig: &EpistemicCurveFigure, data_idx: i64) with IO, Mut, Panic, Div {
    // Very lightweight: show which kinds have glyphs near this point
    var g: i64 = 0
    while g < fig.glyph_count {
        let spec = fig.glyphs[g as usize]
        let diff = spec.data_index - data_idx
        let adiff = if diff < 0 { 0 - diff } else { diff }
        if spec.data_index == data_idx || adiff < 3 {
            let sym = glyph_symbol_for_kind(spec.kind)
            let (r, gg, b) = color_for_kind(spec.kind)
            set_fg_rgb(r, gg, b)
            print(sym)
            reset()
            print(" ")
        }
        g = g + 1
    }
}

/// Draws small vertical braille sparklines per provenance kind for a sampled point.
/// Height and texture density show that source's contribution to uncertainty at that x.
/// This is the "live vertical influence" the Lens makes visible (Sounio-native epistemic accountability).
fn render_kind_sparklines(fig: &EpistemicCurveFigure, data_idx: i64) with IO, Mut, Panic, Div {
    // For each unique kind, draw a tiny vertical stack of its texture
    var seen: [bool; 8] = [false; 8]
    var g: i64 = 0
    while g < fig.glyph_count {
        let spec = fig.glyphs[g as usize]
        let kid = spec.kind.id
        if kid < 0 || kid >= 8 || seen[kid as usize] { g = g + 1; continue }
        let diff = spec.data_index - data_idx
        let adiff = if diff < 0 { 0 - diff } else { diff }
        if adiff > 5 { g = g + 1; continue }  // only near the sample

        seen[kid as usize] = true

        let texture = braille_texture_for_kind(kid)
        let (r, gg, b) = color_for_kind(spec.kind)
        let c = fig.conf[data_idx as usize]

        // Contribution height (higher uncertainty = taller sparkline)
        let height = ((1.0 - c) * 4.0 + 1.0) as i64

        set_fg_rgb(r, gg, b)
        var h: i64 = 0
        while h < height {
            print_braille(texture)
            h = h + 1
        }
        reset()
        print(" ")
        g = g + 1
    }
}

