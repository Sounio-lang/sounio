// Graphics Drawing Primitives
//
// Core types for the native graphics library.
// Mirrors the Drawing Primitives layer from docs/design/native_graphics_library.md.

pub struct Point2D {
    pub x: f64,
    pub y: f64,
}

pub struct Color {
    pub r: i64,
    pub g: i64,
    pub b: i64,
    pub a: i64,
}

pub struct Rect {
    pub x: i64,
    pub y: i64,
    pub w: i64,
    pub h: i64,
}

pub fn color_black() -> Color { Color { r: 0, g: 0, b: 0, a: 255 } }
pub fn color_white() -> Color { Color { r: 255, g: 255, b: 255, a: 255 } }
pub fn color_red() -> Color { Color { r: 255, g: 0, b: 0, a: 255 } }
pub fn color_green() -> Color { Color { r: 0, g: 255, b: 0, a: 255 } }
pub fn color_blue() -> Color { Color { r: 0, g: 0, b: 255, a: 255 } }
pub fn color_gray() -> Color { Color { r: 128, g: 128, b: 128, a: 255 } }

pub fn clamp_i64(v: i64, min: i64, max: i64) -> i64 {
    if v < min { min } else if v > max { max } else { v }
}

pub fn color_with_alpha(c: Color, a: i64) -> Color {
    Color { r: c.r, g: c.g, b: c.b, a: clamp_i64(a, 0, 255) }
}

/// Blend fg over bg using standard alpha compositing (over operator).
/// Resulting color is always fully opaque (a=255) — suitable for final
/// framebuffer write when we want "faded" appearance on a known background.
pub fn color_blend_over(bg: Color, fg: Color) -> Color with Div, Panic {
    let alpha = (fg.a as f64) / 255.0
    let inv = 1.0 - alpha
    Color {
        r: ((bg.r as f64) * inv + (fg.r as f64) * alpha) as i64,
        g: ((bg.g as f64) * inv + (fg.g as f64) * alpha) as i64,
        b: ((bg.b as f64) * inv + (fg.b as f64) * alpha) as i64,
        a: 255
    }
}

pub fn point2d(x: f64, y: f64) -> Point2D { Point2D { x: x, y: y } }

fn main() -> i32 with IO { 0 }
