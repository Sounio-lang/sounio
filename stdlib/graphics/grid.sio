// Graphics Grid — Evenly spaced horizontal/vertical grid lines behind plot data.

use graphics::drawing::{Color}
use graphics::surface::{Surface}
use graphics::tile::{TiledSurface, tiled_draw_line}

pub struct GridConfig {
    pub margin: i64,
    pub grid_color: Color,
    pub n_x_ticks: i64,
    pub n_y_ticks: i64,
}

pub fn grid_config_default() -> GridConfig {
    GridConfig {
        margin: 20,
        grid_color: Color { r: 200, g: 200, b: 200, a: 255 },
        n_x_ticks: 5,
        n_y_ticks: 5,
    }
}

// Helper: draw a vertical line with direct pixel writes (no by-value copies per pixel).
fn draw_vline_direct(s: Surface, x: i64, y0: i64, y1: i64, c: Color) -> Surface with Mut, Panic {
    var out = s
    if x < 0 || x >= out.width { return out }
    var y = y0
    var y_end = y1
    if y0 > y1 { y = y1; y_end = y0 }
    if y < 0 { y = 0 }
    if y_end >= out.height { y_end = out.height - 1 }
    while y <= y_end {
        let idx = y * out.width + x
        out.r[idx] = c.r
        out.g[idx] = c.g
        out.b[idx] = c.b
        out.a[idx] = c.a
        y = y + 1
    }
    out
}

// Helper: draw a horizontal line with direct pixel writes (no by-value copies per pixel).
fn draw_hline_direct(s: Surface, x0: i64, x1: i64, y: i64, c: Color) -> Surface with Mut, Panic {
    var out = s
    if y < 0 || y >= out.height { return out }
    var x = x0
    var x_end = x1
    if x0 > x1 { x = x1; x_end = x0 }
    if x < 0 { x = 0 }
    if x_end >= out.width { x_end = out.width - 1 }
    while x <= x_end {
        let idx = y * out.width + x
        out.r[idx] = c.r
        out.g[idx] = c.g
        out.b[idx] = c.b
        out.a[idx] = c.a
        x = x + 1
    }
    out
}

// Draw evenly spaced grid lines on a Surface.
pub fn draw_grid_raster(s: Surface, config: GridConfig) -> Surface with Mut, Panic {
    var out = s
    let inner_w = out.width - 2 * config.margin
    let inner_h = out.height - 2 * config.margin

    if config.n_x_ticks > 1 && inner_w > 0 {
        var i: i64 = 0
        while i < config.n_x_ticks {
            let x = config.margin + (i * inner_w) / (config.n_x_ticks - 1)
            out = draw_vline_direct(out, x, config.margin, out.height - config.margin, config.grid_color)
            i = i + 1
        }
    }

    if config.n_y_ticks > 1 && inner_h > 0 {
        var i: i64 = 0
        while i < config.n_y_ticks {
            let y = config.margin + (i * inner_h) / (config.n_y_ticks - 1)
            out = draw_hline_direct(out, config.margin, out.width - config.margin, y, config.grid_color)
            i = i + 1
        }
    }

    out
}

// Draw evenly spaced grid lines on a TiledSurface.
pub fn tiled_draw_grid(ts: TiledSurface, config: GridConfig) -> TiledSurface with Mut, Panic, Div {
    var out = ts
    let inner_w = out.width - 2 * config.margin
    let inner_h = out.height - 2 * config.margin

    if config.n_x_ticks > 1 && inner_w > 0 {
        var i: i64 = 0
        while i < config.n_x_ticks {
            let x = config.margin + (i * inner_w) / (config.n_x_ticks - 1)
            out = tiled_draw_line(out, x, config.margin, x, out.height - config.margin, config.grid_color)
            i = i + 1
        }
    }

    if config.n_y_ticks > 1 && inner_h > 0 {
        var i: i64 = 0
        while i < config.n_y_ticks {
            let y = config.margin + (i * inner_h) / (config.n_y_ticks - 1)
            out = tiled_draw_line(out, config.margin, y, out.width - config.margin, y, config.grid_color)
            i = i + 1
        }
    }

    out
}

fn main() -> i32 with IO { 0 }
