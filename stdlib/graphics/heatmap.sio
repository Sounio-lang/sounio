// Graphics Heatmap — Raster heatmaps
//
// Pixel-based heatmap rendering onto a Surface.
// Counterpart to plot::heatmap (terminal-based).

use graphics::drawing::{Color}
use graphics::surface::{Surface, surface_draw_rect}

pub struct HeatmapConfig {
    pub width: i64,
    pub height: i64,
    pub margin: i64,
    pub bg_color: Color,
    pub axis_color: Color,
}

pub fn heatmap_config_default() -> HeatmapConfig {
    HeatmapConfig {
        width: 256,
        height: 256,
        margin: 20,
        bg_color: Color { r: 255, g: 255, b: 255, a: 255 },
        axis_color: Color { r: 0, g: 0, b: 0, a: 255 },
    }
}

// Draw a heatmap from a row-major data array.
// data: up to 4096 values (64×64 max for the cell grid)
// rows, cols: dimensions of the data grid
// Returns the updated surface.
pub fn plot_heatmap_raster(
    s: Surface,
    data: &[f64; 4096],
    rows: i64,
    cols: i64,
    config: HeatmapConfig
) -> Surface with Mut, Panic, Div {
    if rows <= 0 || cols <= 0 { return s }

    var out = s

    // Find data range
    var min_val = data[0]
    var max_val = data[0]
    var i: i64 = 1
    while i < rows * cols {
        if data[i] < min_val { min_val = data[i] }
        if data[i] > max_val { max_val = data[i] }
        i = i + 1
    }
    let range = max_val - min_val

    let plot_w = out.width - config.margin * 2
    let plot_h = out.height - config.margin * 2
    let cell_w = plot_w / cols
    let cell_h = plot_h / rows
    if cell_w <= 0 { return s }
    if cell_h <= 0 { return s }

    // Clear background
    out = surface_draw_rect(out, 0, 0, out.width, out.height, config.bg_color)

    // Draw axes
    out = surface_draw_rect(out, config.margin, config.margin, 1, plot_h, config.axis_color)
    out = surface_draw_rect(out, config.margin, out.height - config.margin - 1, plot_w, 1, config.axis_color)

    // Draw cells
    var r: i64 = 0
    while r < rows {
        var c: i64 = 0
        while c < cols {
            let idx = r * cols + c
            let normalized = if range == 0.0 { 0.5 } else { (data[idx] - min_val) / range }
            let cell_color = heatmap_color(normalized)
            let px = config.margin + c * cell_w
            let py = out.height - config.margin - 1 - (r + 1) * cell_h
            out = surface_draw_rect(out, px, py, cell_w, cell_h, cell_color)
            c = c + 1
        }
        r = r + 1
    }
    out
}

// Map normalized value [0.0, 1.0] to a color (blue -> cyan -> yellow -> red)
pub fn heatmap_color(t: f64) -> Color {
    let nt = if t < 0.0 { 0.0 } else if t > 1.0 { 1.0 } else { t }
    if nt < 0.25 {
        // blue -> cyan
        let local = nt / 0.25
        Color { r: 0, g: (local * 255.0) as i64, b: 255, a: 255 }
    } else if nt < 0.5 {
        // cyan -> green
        let local = (nt - 0.25) / 0.25
        Color { r: 0, g: 255, b: 255 - (local * 255.0) as i64, a: 255 }
    } else if nt < 0.75 {
        // green -> yellow
        let local = (nt - 0.5) / 0.25
        Color { r: (local * 255.0) as i64, g: 255, b: 0, a: 255 }
    } else {
        // yellow -> red
        let local = (nt - 0.75) / 0.25
        Color { r: 255, g: 255 - (local * 255.0) as i64, b: 0, a: 255 }
    }
}

fn main() -> i32 with IO { 0 }
