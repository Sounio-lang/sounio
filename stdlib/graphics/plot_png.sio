// Graphics Plot PNG — One-shot convenience functions to render plots and save to PNG
//
// Creates a Surface, renders a plot, and exports to PNG in a single call.

use graphics::surface::{Surface, surface_new, surface_clear}
use graphics::drawing::{color_white}
use graphics::plot::{LinePlotConfig, line_plot_config_default, plot_line_raster}
use graphics::scatter::{ScatterConfig, scatter_config_default, plot_scatter_raster}
use graphics::heatmap::{HeatmapConfig, heatmap_config_default, plot_heatmap_raster}
use graphics::epistemic::{EpistemicBandConfig, epistemic_band_config_default, plot_epistemic_band_raster}
use graphics::png::{png_encode_surface}

pub fn plot_line_png(xs: &[f64; 256], ys: &[f64; 256], n: i64, width: i64, height: i64, filename: string) -> bool with IO, Mut, Panic, Div {
    var s = surface_new(width, height)
    s = surface_clear(s, color_white())
    let config = line_plot_config_default()
    s = plot_line_raster(s, xs, ys, n, config)
    png_encode_surface(&s, filename)
}

pub fn plot_scatter_png(xs: &[f64; 256], ys: &[f64; 256], n: i64, width: i64, height: i64, filename: string) -> bool with IO, Mut, Panic, Div {
    var s = surface_new(width, height)
    s = surface_clear(s, color_white())
    let config = scatter_config_default()
    s = plot_scatter_raster(s, xs, ys, n, config)
    png_encode_surface(&s, filename)
}

pub fn plot_heatmap_png(data: &[f64; 4096], rows: i64, cols: i64, width: i64, height: i64, filename: string) -> bool with IO, Mut, Panic, Div {
    var s = surface_new(width, height)
    s = surface_clear(s, color_white())
    let config = heatmap_config_default()
    s = plot_heatmap_raster(s, data, rows, cols, config)
    png_encode_surface(&s, filename)
}

pub fn plot_epistemic_band_png(xs: &[f64; 256], center: &[f64; 256], lower: &[f64; 256], upper: &[f64; 256], n: i64, width: i64, height: i64, filename: string) -> bool with IO, Mut, Panic, Div {
    var s = surface_new(width, height)
    s = surface_clear(s, color_white())
    let config = epistemic_band_config_default()
    s = plot_epistemic_band_raster(s, xs, center, lower, upper, n, config)
    png_encode_surface(&s, filename)
}

fn main() -> i32 with IO { 0 }
