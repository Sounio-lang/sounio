// Bitmap Text Rendering — 5×7 raster font
//
// Hardcoded glyph set: digits 0-9, uppercase A-Z, space, ., ,, :, /, +, -, %
// Each glyph is encoded as a 35-bit integer: 7 rows of 5 bits, row-major,
// col 0 = LSB within the row, bit position = row*5 + col.

use graphics::drawing::{Color}
use graphics::surface::{Surface}
use graphics::tile::{TiledSurface, tiled_set_pixel}

pub struct Font {
    pub glyphs: [i64; 256],
}

// Return a Font with all supported glyphs initialized.
pub fn font_default() -> Font with Mut {
    var f: Font = Font { glyphs: [0; 256] }

    // Digits 0-9
    f.glyphs[48] = 15623448110  // '0'
    f.glyphs[49] = 15170932932  // '1'
    f.glyphs[50] = 33322058286  // '2'
    f.glyphs[51] = 15619998254  // '3'
    f.glyphs[52] = 8891181448   // '4'
    f.glyphs[53] = 15620127807  // '5'
    f.glyphs[54] = 15621129774  // '6'
    f.glyphs[55] = 4433519135   // '7'
    f.glyphs[56] = 15621113390  // '8'
    f.glyphs[57] = 15620589102  // '9'

    // Uppercase A-Z
    f.glyphs[65] = 18842895918  // 'A'
    f.glyphs[66] = 16694887983  // 'B'
    f.glyphs[67] = 15603893806  // 'C'
    f.glyphs[68] = 16694953519  // 'D'
    f.glyphs[69] = 33321092159  // 'E'
    f.glyphs[70] = 1108837439   // 'F'
    f.glyphs[71] = 15621457454  // 'G'
    f.glyphs[72] = 18842895921  // 'H'
    f.glyphs[73] = 15170932878  // 'I'
    f.glyphs[74] = 6753100060   // 'J'
    f.glyphs[75] = 18560947505  // 'K'
    f.glyphs[76] = 33320633377  // 'L'
    f.glyphs[77] = 18842441585  // 'M'
    f.glyphs[78] = 18842703473  // 'N'
    f.glyphs[79] = 15621211694  // 'O'
    f.glyphs[80] = 1108854319   // 'P'
    f.glyphs[81] = 23946905134  // 'Q'
    f.glyphs[82] = 18561353263  // 'R'
    f.glyphs[83] = 15620048430  // 'S'
    f.glyphs[84] = 4433514655   // 'T'
    f.glyphs[85] = 15621211697  // 'U'
    f.glyphs[86] = 4648912433   // 'V'
    f.glyphs[87] = 19182306865  // 'W'
    f.glyphs[88] = 18834663985  // 'X'
    f.glyphs[89] = 4433521201   // 'Y'
    f.glyphs[90] = 33321787935  // 'Z'

    // Symbols
    f.glyphs[32] = 0             // ' '
    f.glyphs[46] = 4294967296    // '.'
    f.glyphs[44] = 2281701376    // ','
    f.glyphs[58] = 4194432       // ':'
    f.glyphs[47] = 1118480       // '/'
    f.glyphs[43] = 139432064     // '+'
    f.glyphs[45] = 1015808       // '-'
    f.glyphs[37] = 21040866105   // '%'

    f
}

// Render text onto a Surface using direct array writes.
// Out-of-bounds pixels are silently skipped.
pub fn draw_text_raster(s: Surface, text: &[i64; 64], text_len: i64, x: i64, y: i64, color: Color, scale: i64) -> Surface with Mut, Panic {
    var out = s
    let font = font_default()
    let advance = 6 * scale
    var i: i64 = 0
    while i < text_len && i < 64 {
        let ch = text[i]
        let glyph = if ch >= 0 && ch < 256 { font.glyphs[ch as usize] } else { 0 }
        let base_x = x + i * advance

        var row: i64 = 0
        while row < 7 {
            var col: i64 = 0
            while col < 5 {
                let bit_pos = row * 5 + col
                let on = ((glyph >> bit_pos) & 1) == 1
                if on {
                    let px0 = base_x + col * scale
                    let py0 = y + row * scale
                    var dy: i64 = 0
                    while dy < scale {
                        var dx: i64 = 0
                        while dx < scale {
                            let px = px0 + dx
                            let py = py0 + dy
                            if px >= 0 && px < out.width && py >= 0 && py < out.height {
                                let idx = py * out.width + px
                                out.r[idx] = color.r
                                out.g[idx] = color.g
                                out.b[idx] = color.b
                                out.a[idx] = color.a
                            }
                            dx = dx + 1
                        }
                        dy = dy + 1
                    }
                }
                col = col + 1
            }
            row = row + 1
        }
        i = i + 1
    }
    out
}

// Render text onto a TiledSurface using tiled_set_pixel.
pub fn tiled_draw_text(ts: TiledSurface, text: &[i64; 64], text_len: i64, x: i64, y: i64, color: Color, scale: i64) -> TiledSurface with Mut, Panic {
    var out = ts
    let font = font_default()
    let advance = 6 * scale
    var i: i64 = 0
    while i < text_len && i < 64 {
        let ch = text[i]
        let glyph = if ch >= 0 && ch < 256 { font.glyphs[ch as usize] } else { 0 }
        let base_x = x + i * advance

        var row: i64 = 0
        while row < 7 {
            var col: i64 = 0
            while col < 5 {
                let bit_pos = row * 5 + col
                let on = ((glyph >> bit_pos) & 1) == 1
                if on {
                    let px0 = base_x + col * scale
                    let py0 = y + row * scale
                    var dy: i64 = 0
                    while dy < scale {
                        var dx: i64 = 0
                        while dx < scale {
                            let px = px0 + dx
                            let py = py0 + dy
                            out = tiled_set_pixel(out, px, py, color)
                            dx = dx + 1
                        }
                        dy = dy + 1
                    }
                }
                col = col + 1
            }
            row = row + 1
        }
        i = i + 1
    }
    out
}

fn main() -> i32 with IO { 0 }
