// Graphics Histogram — Raster histogram rendering
//
// Histograms for Surface and TiledSurface with PNG export.

use graphics::drawing::{Color, color_white}
use graphics::surface::{Surface, surface_new, surface_clear, surface_draw_rect}
use graphics::tile::{TiledSurface, tiled_surface_new, tiled_clear, tiled_draw_rect, tiled_export_png}
use graphics::png::{png_encode_surface}

pub struct HistogramConfig {
    pub margin: i64,
    pub bar_color: Color,
    pub bg_color: Color,
    pub axis_color: Color,
    pub bins: i64,
}

pub fn histogram_config_default() -> HistogramConfig {
    HistogramConfig {
        margin: 20,
        bar_color: Color { r: 0, g: 150, b: 100, a: 255 },
        bg_color: Color { r: 255, g: 255, b: 255, a: 255 },
        axis_color: Color { r: 0, g: 0, b: 0, a: 255 },
        bins: 10,
    }
}

pub fn plot_histogram_raster(s: Surface, values: &[f64; 256], n: i64, config: HistogramConfig) -> Surface with Mut, Panic, Div {
    if n <= 0 || config.bins <= 0 { return s }

    var out = s

    var vmin = values[0]
    var vmax = values[0]
    var i: i64 = 1
    while i < n {
        if values[i] < vmin { vmin = values[i] }
        if values[i] > vmax { vmax = values[i] }
        i = i + 1
    }

    let plot_w = out.width - config.margin * 2
    let plot_h = out.height - config.margin * 2

    out = surface_clear(out, config.bg_color)

    out = surface_draw_rect(out, config.margin, config.margin, 1, plot_h, config.axis_color)
    out = surface_draw_rect(out, config.margin, out.height - config.margin - 1, plot_w, 1, config.axis_color)

    var bins = config.bins
    if bins > 32 { bins = 32 }

    var counts: [i64; 32] = [0; 32]
    let vrange = vmax - vmin

    var j: i64 = 0
    while j < n {
        let v = values[j]
        var idx: i64 = 0
        if vrange == 0.0 {
            idx = 0
        } else {
            idx = ((v - vmin) / vrange * (bins as f64)) as i64
            if idx < 0 { idx = 0 }
            if idx >= bins { idx = bins - 1 }
        }
        counts[idx] = counts[idx] + 1
        j = j + 1
    }

    var max_count: i64 = 0
    var k: i64 = 0
    while k < bins {
        if counts[k] > max_count { max_count = counts[k] }
        k = k + 1
    }

    let bar_width = plot_w / bins
    if bar_width <= 0 { return out }

    var b: i64 = 0
    while b < bins {
        let count = counts[b]
        let bar_h = if max_count == 0 { 0 } else { (count * plot_h) / max_count }
        let x = config.margin + b * bar_width
        let y = out.height - config.margin - 1 - bar_h
        out = surface_draw_rect(out, x, y, bar_width, bar_h, config.bar_color)
        b = b + 1
    }

    out
}

pub fn tiled_plot_histogram_raster(ts: TiledSurface, values: &[f64; 256], n: i64, config: HistogramConfig) -> TiledSurface with Mut, Panic, Div {
    if n <= 0 || config.bins <= 0 { return ts }

    var out = ts

    var vmin = values[0]
    var vmax = values[0]
    var i: i64 = 1
    while i < n {
        if values[i] < vmin { vmin = values[i] }
        if values[i] > vmax { vmax = values[i] }
        i = i + 1
    }

    let plot_w = out.width - config.margin * 2
    let plot_h = out.height - config.margin * 2

    out = tiled_clear(out, config.bg_color)

    out = tiled_draw_rect(out, config.margin, config.margin, 1, plot_h, config.axis_color)
    out = tiled_draw_rect(out, config.margin, out.height - config.margin - 1, plot_w, 1, config.axis_color)

    var bins = config.bins
    if bins > 32 { bins = 32 }

    var counts: [i64; 32] = [0; 32]
    let vrange = vmax - vmin

    var j: i64 = 0
    while j < n {
        let v = values[j]
        var idx: i64 = 0
        if vrange == 0.0 {
            idx = 0
        } else {
            idx = ((v - vmin) / vrange * (bins as f64)) as i64
            if idx < 0 { idx = 0 }
            if idx >= bins { idx = bins - 1 }
        }
        counts[idx] = counts[idx] + 1
        j = j + 1
    }

    var max_count: i64 = 0
    var k: i64 = 0
    while k < bins {
        if counts[k] > max_count { max_count = counts[k] }
        k = k + 1
    }

    let bar_width = plot_w / bins
    if bar_width <= 0 { return out }

    var b: i64 = 0
    while b < bins {
        let count = counts[b]
        let bar_h = if max_count == 0 { 0 } else { (count * plot_h) / max_count }
        let x = config.margin + b * bar_width
        let y = out.height - config.margin - 1 - bar_h
        out = tiled_draw_rect(out, x, y, bar_width, bar_h, config.bar_color)
        b = b + 1
    }

    out
}

pub fn plot_histogram_png(values: &[f64; 256], n: i64, width: i64, height: i64, filename: string) -> bool with IO, Mut, Panic, Div {
    var s = surface_new(width, height)
    s = surface_clear(s, color_white())
    let config = histogram_config_default()
    s = plot_histogram_raster(s, values, n, config)
    png_encode_surface(&s, filename)
}

pub fn tiled_plot_histogram_png(values: &[f64; 256], n: i64, width: i64, height: i64, filename: string) -> bool with IO, Mut, Panic, Div {
    var ts = tiled_surface_new(width, height, 256, 256)
    ts = tiled_clear(ts, color_white())
    let config = histogram_config_default()
    ts = tiled_plot_histogram_raster(ts, values, n, config)
    tiled_export_png(&ts, filename)
}

fn main() -> i32 with IO { 0 }
