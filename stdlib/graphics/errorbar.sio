// Graphics ErrorBar — Vertical/horizontal error bars with caps.

use graphics::drawing::{Color}
use graphics::surface::{Surface}
use graphics::tile::{TiledSurface, tiled_draw_line}

pub struct ErrorBarConfig {
    pub margin: i64,
    pub bar_color: Color,
    pub cap_width: i64,
    pub line_width: i64,
}

pub fn errorbar_config_default() -> ErrorBarConfig {
    ErrorBarConfig {
        margin: 20,
        bar_color: Color { r: 0, g: 0, b: 0, a: 255 },
        cap_width: 4,
        line_width: 1,
    }
}

// Helper: draw a vertical line with direct pixel writes (no by-value copies per pixel).
fn draw_vline_direct(s: Surface, x: i64, y0: i64, y1: i64, c: Color) -> Surface with Mut, Panic {
    var out = s
    if x < 0 || x >= out.width { return out }
    var y = y0
    var y_end = y1
    if y0 > y1 { y = y1; y_end = y0 }
    if y < 0 { y = 0 }
    if y_end >= out.height { y_end = out.height - 1 }
    while y <= y_end {
        let idx = y * out.width + x
        out.r[idx] = c.r
        out.g[idx] = c.g
        out.b[idx] = c.b
        out.a[idx] = c.a
        y = y + 1
    }
    out
}

// Helper: draw a horizontal line with direct pixel writes (no by-value copies per pixel).
fn draw_hline_direct(s: Surface, x0: i64, x1: i64, y: i64, c: Color) -> Surface with Mut, Panic {
    var out = s
    if y < 0 || y >= out.height { return out }
    var x = x0
    var x_end = x1
    if x0 > x1 { x = x1; x_end = x0 }
    if x < 0 { x = 0 }
    if x_end >= out.width { x_end = out.width - 1 }
    while x <= x_end {
        let idx = y * out.width + x
        out.r[idx] = c.r
        out.g[idx] = c.g
        out.b[idx] = c.b
        out.a[idx] = c.a
        x = x + 1
    }
    out
}

// Draw a vertical error bar with caps on a Surface.
pub fn draw_errorbar_vertical_raster(s: Surface, px: i64, py: i64, err_px: i64, config: ErrorBarConfig) -> Surface with Mut, Panic {
    var out = s
    let y_top = py - err_px
    let y_bot = py + err_px

    var offset: i64 = 0
    while offset < config.line_width {
        let x = px - config.line_width / 2 + offset
        out = draw_vline_direct(out, x, y_top, y_bot, config.bar_color)
        offset = offset + 1
    }

    out = draw_hline_direct(out, px - config.cap_width, px + config.cap_width, y_top, config.bar_color)
    out = draw_hline_direct(out, px - config.cap_width, px + config.cap_width, y_bot, config.bar_color)

    out
}

// Draw a horizontal error bar with caps on a Surface.
pub fn draw_errorbar_horizontal_raster(s: Surface, px: i64, py: i64, err_px: i64, config: ErrorBarConfig) -> Surface with Mut, Panic {
    var out = s
    let x_left = px - err_px
    let x_right = px + err_px

    var offset: i64 = 0
    while offset < config.line_width {
        let y = py - config.line_width / 2 + offset
        out = draw_hline_direct(out, x_left, x_right, y, config.bar_color)
        offset = offset + 1
    }

    out = draw_vline_direct(out, x_left, py - config.cap_width, py + config.cap_width, config.bar_color)
    out = draw_vline_direct(out, x_right, py - config.cap_width, py + config.cap_width, config.bar_color)

    out
}

// Draw a vertical error bar with caps on a TiledSurface.
pub fn tiled_draw_errorbar_vertical(ts: TiledSurface, px: i64, py: i64, err_px: i64, config: ErrorBarConfig) -> TiledSurface with Mut, Panic, Div {
    var out = ts
    let y_top = py - err_px
    let y_bot = py + err_px

    var offset: i64 = 0
    while offset < config.line_width {
        let x = px - config.line_width / 2 + offset
        out = tiled_draw_line(out, x, y_top, x, y_bot, config.bar_color)
        offset = offset + 1
    }

    out = tiled_draw_line(out, px - config.cap_width, y_top, px + config.cap_width, y_top, config.bar_color)
    out = tiled_draw_line(out, px - config.cap_width, y_bot, px + config.cap_width, y_bot, config.bar_color)

    out
}

// Draw a horizontal error bar with caps on a TiledSurface.
pub fn tiled_draw_errorbar_horizontal(ts: TiledSurface, px: i64, py: i64, err_px: i64, config: ErrorBarConfig) -> TiledSurface with Mut, Panic, Div {
    var out = ts
    let x_left = px - err_px
    let x_right = px + err_px

    var offset: i64 = 0
    while offset < config.line_width {
        let y = py - config.line_width / 2 + offset
        out = tiled_draw_line(out, x_left, y, x_right, y, config.bar_color)
        offset = offset + 1
    }

    out = tiled_draw_line(out, x_left, py - config.cap_width, x_left, py + config.cap_width, config.bar_color)
    out = tiled_draw_line(out, x_right, py - config.cap_width, x_right, py + config.cap_width, config.bar_color)

    out
}

fn main() -> i32 with IO { 0 }
