// Graphics Animation Helpers
//
// Generate sequences of plot frames for animation.

use graphics::drawing::{Color, color_white, color_black}
use graphics::surface::{surface_new, surface_clear, surface_draw_rect}
use graphics::plot::{LinePlotConfig, plot_line_raster}
use graphics::png::{png_encode_surface}

// Draw a line plot showing only the first `progress` fraction of the data.
// progress is 0.0 to 1.0. The function computes how many points to draw,
// renders them on a fresh surface, and saves to the given filename.
pub fn animate_line_buildup(
    xs: &[f64; 256],
    ys: &[f64; 256],
    n: i64,
    width: i64,
    height: i64,
    progress: f64,
    filename: string
) -> bool with IO, Mut, Panic, Div {
    var points_to_draw = (progress * (n - 1) as f64) as i64 + 1
    if points_to_draw < 1 {
        points_to_draw = 1
    }
    if points_to_draw > n {
        points_to_draw = n
    }

    var s = surface_new(width, height)
    s = surface_clear(s, color_white())

    let config = LinePlotConfig {
        width: width,
        height: height,
        margin: 20,
        line_color: Color { r: 0, g: 100, b: 200, a: 255 },
        bg_color: color_white(),
        axis_color: color_black(),
    }

    s = plot_line_raster(s, xs, ys, points_to_draw, config)
    png_encode_surface(&s, filename)
}

// Given arrays of pre-constructed filenames (up to 64 frames),
// and a parallel array of progress values (0.0 to 1.0),
// render each frame and save it.
// Returns the number of frames successfully written.
pub fn animate_line_sequence(
    xs: &[f64; 256],
    ys: &[f64; 256],
    n: i64,
    width: i64,
    height: i64,
    progress: &[f64; 64],
    filenames: &[string; 64],
    frames: i64
) -> i64 with IO, Mut, Panic, Div {
    var count: i64 = 0
    var i: i64 = 0
    while i < frames {
        if animate_line_buildup(xs, ys, n, width, height, progress[i], filenames[i]) {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// Draw a full plot but mask it so only the left `progress` fraction is visible.
// This creates a "wipe" effect rather than a "draw" effect.
pub fn animate_line_wipe(
    xs: &[f64; 256],
    ys: &[f64; 256],
    n: i64,
    width: i64,
    height: i64,
    progress: f64,
    filename: string
) -> bool with IO, Mut, Panic, Div {
    var s = surface_new(width, height)
    s = surface_clear(s, color_white())

    let config = LinePlotConfig {
        width: width,
        height: height,
        margin: 20,
        line_color: Color { r: 0, g: 100, b: 200, a: 255 },
        bg_color: color_white(),
        axis_color: color_black(),
    }

    s = plot_line_raster(s, xs, ys, n, config)

    var x_visible = (progress * (width as f64)) as i64
    if x_visible < 0 {
        x_visible = 0
    }
    if x_visible < width {
        s = surface_draw_rect(s, x_visible, 0, width - x_visible, height, color_white())
    }

    png_encode_surface(&s, filename)
}

fn main() -> i32 with IO { 0 }
