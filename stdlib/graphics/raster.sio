// Graphics Raster — quality rasterization helpers
//
// Adds alpha compositing and fixed-point antialiased line drawing on top of the
// basic Surface API. This module is intentionally independent of surface.sio so
// the scaffold can adopt it incrementally.

use graphics::drawing::{Color}
use graphics::surface::{Surface, surface_set_pixel}

pub fn surface_blend_pixel(s: Surface, x: i64, y: i64, c: Color, coverage: i64) -> Surface with Mut, Panic, Div {
    var out = s
    if x < 0 || x >= out.width || y < 0 || y >= out.height { return out }
    let cov = clamp_byte(coverage)
    let alpha = (cov * clamp_byte(c.a) + 127) / 255
    if alpha <= 0 { return out }
    if alpha >= 255 { return surface_set_pixel(out, x, y, c) }

    let idx = y * out.width + x
    out.r[idx] = blend_channel(out.r[idx], c.r, alpha)
    out.g[idx] = blend_channel(out.g[idx], c.g, alpha)
    out.b[idx] = blend_channel(out.b[idx], c.b, alpha)
    out.a[idx] = blend_channel(out.a[idx], c.a, alpha)
    out
}

// Fixed-point coverage line drawing. Uses 8 fractional bits and blends the
// two nearest pixels along the minor axis.
pub fn surface_draw_line_smooth(s: Surface, x0: i64, y0: i64, x1: i64, y1: i64, c: Color) -> Surface with Mut, Panic, Div {
    var out = s
    var dx = x1 - x0
    var dy = y1 - y0
    if dx < 0 { dx = 0 - dx }
    if dy < 0 { dy = 0 - dy }

    if dx == 0 || dy == 0 {
        return surface_draw_axis_line_smooth(out, x0, y0, x1, y1, c)
    }

    if dx >= dy {
        out = surface_draw_line_smooth_x_major(out, x0, y0, x1, y1, c)
    } else {
        out = surface_draw_line_smooth_y_major(out, x0, y0, x1, y1, c)
    }
    out
}

fn surface_draw_axis_line_smooth(s: Surface, x0: i64, y0: i64, x1: i64, y1: i64, c: Color) -> Surface with Mut, Panic, Div {
    var out = s
    var cx = x0
    var cy = y0
    let sx = if x0 < x1 { 1 } else if x0 > x1 { 0 - 1 } else { 0 }
    let sy = if y0 < y1 { 1 } else if y0 > y1 { 0 - 1 } else { 0 }
    var done = false
    var guard = 0
    while !done && guard < 131072 {
        out = surface_blend_pixel(out, cx, cy, c, 255)
        if cx == x1 && cy == y1 {
            done = true
        } else {
            cx = cx + sx
            cy = cy + sy
        }
        guard = guard + 1
    }
    out
}

fn surface_draw_line_smooth_x_major(s: Surface, ax: i64, ay: i64, bx: i64, by: i64, c: Color) -> Surface with Mut, Panic, Div {
    var out = s
    var x_start = ax
    var y_start = ay
    var x_end = bx
    var y_end = by
    if x_start > x_end {
        x_start = bx
        y_start = by
        x_end = ax
        y_end = ay
    }

    let span = x_end - x_start
    let y_step = ((y_end - y_start) * 256) / span
    var y_fixed = y_start * 256
    var x = x_start
    while x <= x_end {
        let y_base = fixed_floor(y_fixed)
        let frac = fixed_frac(y_fixed)
        out = surface_blend_pixel(out, x, y_base, c, 255 - frac)
        if frac > 0 {
            let y_next = if y_step >= 0 { y_base + 1 } else { y_base - 1 }
            out = surface_blend_pixel(out, x, y_next, c, frac)
        }
        y_fixed = y_fixed + y_step
        x = x + 1
    }
    out
}

fn surface_draw_line_smooth_y_major(s: Surface, ax: i64, ay: i64, bx: i64, by: i64, c: Color) -> Surface with Mut, Panic, Div {
    var out = s
    var x_start = ax
    var y_start = ay
    var x_end = bx
    var y_end = by
    if y_start > y_end {
        x_start = bx
        y_start = by
        x_end = ax
        y_end = ay
    }

    let span = y_end - y_start
    let x_step = ((x_end - x_start) * 256) / span
    var x_fixed = x_start * 256
    var y = y_start
    while y <= y_end {
        let x_base = fixed_floor(x_fixed)
        let frac = fixed_frac(x_fixed)
        out = surface_blend_pixel(out, x_base, y, c, 255 - frac)
        if frac > 0 {
            let x_next = if x_step >= 0 { x_base + 1 } else { x_base - 1 }
            out = surface_blend_pixel(out, x_next, y, c, frac)
        }
        x_fixed = x_fixed + x_step
        y = y + 1
    }
    out
}

fn fixed_floor(v: i64) -> i64 {
    if v >= 0 { return v / 256 }
    (v - 255) / 256
}

fn fixed_frac(v: i64) -> i64 {
    let base = fixed_floor(v)
    v - base * 256
}

fn blend_channel(dst: i64, src: i64, alpha: i64) -> i64 {
    let d = clamp_byte(dst)
    let s = clamp_byte(src)
    (s * alpha + d * (255 - alpha) + 127) / 255
}

fn clamp_byte(v: i64) -> i64 {
    if v < 0 { 0 } else if v > 255 { 255 } else { v }
}

fn main() -> i32 with IO { 0 }
