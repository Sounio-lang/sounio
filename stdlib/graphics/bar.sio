// Graphics Bar Chart — Raster bar chart rendering
//
// Bar charts for Surface and TiledSurface with PNG export.

use graphics::drawing::{Color, color_white}
use graphics::surface::{Surface, surface_new, surface_clear, surface_draw_rect}
use graphics::tile::{TiledSurface, tiled_surface_new, tiled_clear, tiled_draw_rect, tiled_export_png}
use graphics::png::{png_encode_surface}

pub struct BarChartConfig {
    pub margin: i64,
    pub bar_color: Color,
    pub bg_color: Color,
    pub axis_color: Color,
    pub bar_spacing: i64,
}

pub fn bar_chart_config_default() -> BarChartConfig {
    BarChartConfig {
        margin: 20,
        bar_color: Color { r: 0, g: 100, b: 200, a: 255 },
        bg_color: Color { r: 255, g: 255, b: 255, a: 255 },
        axis_color: Color { r: 0, g: 0, b: 0, a: 255 },
        bar_spacing: 4,
    }
}

pub fn plot_bar_raster(s: Surface, values: &[f64; 64], n: i64, config: BarChartConfig) -> Surface with Mut, Panic, Div {
    if n <= 0 { return s }

    var out = s

    var vmin = values[0]
    var vmax = values[0]
    var i: i64 = 1
    while i < n {
        if values[i] < vmin { vmin = values[i] }
        if values[i] > vmax { vmax = values[i] }
        i = i + 1
    }

    let plot_w = out.width - config.margin * 2
    let plot_h = out.height - config.margin * 2

    out = surface_clear(out, config.bg_color)

    out = surface_draw_rect(out, config.margin, config.margin, 1, plot_h, config.axis_color)
    out = surface_draw_rect(out, config.margin, out.height - config.margin - 1, plot_w, 1, config.axis_color)

    let total_spacing = (n - 1) * config.bar_spacing
    var bar_width = (plot_w - total_spacing) / n
    if bar_width < 1 { bar_width = 1 }

    let vrange = vmax - vmin

    var j: i64 = 0
    while j < n {
        let v = values[j]
        let vnorm = if vrange == 0.0 { 0.0 } else { (v - vmin) / vrange }
        let bar_h = (vnorm * (plot_h as f64)) as i64
        let x = config.margin + j * (bar_width + config.bar_spacing)
        let y = out.height - config.margin - 1 - bar_h
        out = surface_draw_rect(out, x, y, bar_width, bar_h, config.bar_color)
        j = j + 1
    }

    out
}

pub fn tiled_plot_bar_raster(ts: TiledSurface, values: &[f64; 64], n: i64, config: BarChartConfig) -> TiledSurface with Mut, Panic, Div {
    if n <= 0 { return ts }

    var out = ts

    var vmin = values[0]
    var vmax = values[0]
    var i: i64 = 1
    while i < n {
        if values[i] < vmin { vmin = values[i] }
        if values[i] > vmax { vmax = values[i] }
        i = i + 1
    }

    let plot_w = out.width - config.margin * 2
    let plot_h = out.height - config.margin * 2

    out = tiled_clear(out, config.bg_color)

    out = tiled_draw_rect(out, config.margin, config.margin, 1, plot_h, config.axis_color)
    out = tiled_draw_rect(out, config.margin, out.height - config.margin - 1, plot_w, 1, config.axis_color)

    let total_spacing = (n - 1) * config.bar_spacing
    var bar_width = (plot_w - total_spacing) / n
    if bar_width < 1 { bar_width = 1 }

    let vrange = vmax - vmin

    var j: i64 = 0
    while j < n {
        let v = values[j]
        let vnorm = if vrange == 0.0 { 0.0 } else { (v - vmin) / vrange }
        let bar_h = (vnorm * (plot_h as f64)) as i64
        let x = config.margin + j * (bar_width + config.bar_spacing)
        let y = out.height - config.margin - 1 - bar_h
        out = tiled_draw_rect(out, x, y, bar_width, bar_h, config.bar_color)
        j = j + 1
    }

    out
}

pub fn plot_bar_png(values: &[f64; 64], n: i64, width: i64, height: i64, filename: string) -> bool with IO, Mut, Panic, Div {
    var s = surface_new(width, height)
    s = surface_clear(s, color_white())
    let config = bar_chart_config_default()
    s = plot_bar_raster(s, values, n, config)
    png_encode_surface(&s, filename)
}

pub fn tiled_plot_bar_png(values: &[f64; 64], n: i64, width: i64, height: i64, filename: string) -> bool with IO, Mut, Panic, Div {
    var ts = tiled_surface_new(width, height, 256, 256)
    ts = tiled_clear(ts, color_white())
    let config = bar_chart_config_default()
    ts = tiled_plot_bar_raster(ts, values, n, config)
    tiled_export_png(&ts, filename)
}

fn main() -> i32 with IO { 0 }
