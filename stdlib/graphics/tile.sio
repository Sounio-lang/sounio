// Graphics Tile — Tiled surface for resolutions beyond 256×256
//
// Composes multiple 256×256 Surfaces into a larger logical canvas.
// This is the scaling strategy from docs/design/native_graphics_library.md §4.3.
//
// Current limit: 9 tiles (3×3) = 768×768 pixels.
// Extend the tiles array size for larger canvases.

use graphics::drawing::{Color}
use graphics::surface::{
    Surface, surface_new, surface_clear, surface_set_pixel,
    surface_draw_line, surface_draw_rect,
    surface_get_pixel_r, surface_get_pixel_g, surface_get_pixel_b
}
use graphics::png::{
    BLOCK_MAX, PNG_COLOR_RGB, PNG_COLOR_RGBA,
    png_write_sig, png_write_ihdr, png_write_iend, png_write_deflate_block,
    pixel_to_i8
}

pub struct TiledSurface {
    pub width: i64,
    pub height: i64,
    pub tile_w: i64,
    pub tile_h: i64,
    pub tiles_wide: i64,
    pub tiles_high: i64,
    pub tile0: Surface,
    pub tile1: Surface,
    pub tile2: Surface,
    pub tile3: Surface,
    pub tile4: Surface,
    pub tile5: Surface,
    pub tile6: Surface,
    pub tile7: Surface,
    pub tile8: Surface,
}

pub fn tiled_surface_new(total_w: i64, total_h: i64, tile_w: i64, tile_h: i64) -> TiledSurface {
    let tw = (total_w + tile_w - 1) / tile_w
    let th = (total_h + tile_h - 1) / tile_h
    TiledSurface {
        width: total_w,
        height: total_h,
        tile_w: tile_w,
        tile_h: tile_h,
        tiles_wide: tw,
        tiles_high: th,
        tile0: surface_new(tile_w, tile_h),
        tile1: surface_new(tile_w, tile_h),
        tile2: surface_new(tile_w, tile_h),
        tile3: surface_new(tile_w, tile_h),
        tile4: surface_new(tile_w, tile_h),
        tile5: surface_new(tile_w, tile_h),
        tile6: surface_new(tile_w, tile_h),
        tile7: surface_new(tile_w, tile_h),
        tile8: surface_new(tile_w, tile_h),
    }
}

pub fn tiled_clear(ts: TiledSurface, c: Color) -> TiledSurface with Mut, Panic {
    var out = ts
    let n = out.tiles_wide * out.tiles_high
    if n > 0 { out.tile0 = surface_clear(out.tile0, c) }
    if n > 1 { out.tile1 = surface_clear(out.tile1, c) }
    if n > 2 { out.tile2 = surface_clear(out.tile2, c) }
    if n > 3 { out.tile3 = surface_clear(out.tile3, c) }
    if n > 4 { out.tile4 = surface_clear(out.tile4, c) }
    if n > 5 { out.tile5 = surface_clear(out.tile5, c) }
    if n > 6 { out.tile6 = surface_clear(out.tile6, c) }
    if n > 7 { out.tile7 = surface_clear(out.tile7, c) }
    if n > 8 { out.tile8 = surface_clear(out.tile8, c) }
    out
}

pub fn tiled_set_pixel(ts: TiledSurface, x: i64, y: i64, c: Color) -> TiledSurface with Mut, Panic {
    var out = ts
    if x < 0 || x >= out.width || y < 0 || y >= out.height { return out }
    let tx = x / out.tile_w
    let ty = y / out.tile_h
    let lx = x % out.tile_w
    let ly = y % out.tile_h
    let idx = ty * out.tiles_wide + tx
    if idx == 0 {
        out.tile0 = surface_set_pixel(out.tile0, lx, ly, c)
    } else if idx == 1 {
        out.tile1 = surface_set_pixel(out.tile1, lx, ly, c)
    } else if idx == 2 {
        out.tile2 = surface_set_pixel(out.tile2, lx, ly, c)
    } else if idx == 3 {
        out.tile3 = surface_set_pixel(out.tile3, lx, ly, c)
    } else if idx == 4 {
        out.tile4 = surface_set_pixel(out.tile4, lx, ly, c)
    } else if idx == 5 {
        out.tile5 = surface_set_pixel(out.tile5, lx, ly, c)
    } else if idx == 6 {
        out.tile6 = surface_set_pixel(out.tile6, lx, ly, c)
    } else if idx == 7 {
        out.tile7 = surface_set_pixel(out.tile7, lx, ly, c)
    } else if idx == 8 {
        out.tile8 = surface_set_pixel(out.tile8, lx, ly, c)
    }
    out
}

// Helper: test whether a line bbox intersects a tile.
fn tile_line_intersects(ox: i64, oy: i64, tw: i64, th: i64, lminx: i64, lmaxx: i64, lminy: i64, lmaxy: i64) -> bool {
    let tmaxx = ox + tw - 1
    let tmaxy = oy + th - 1
    lminx <= tmaxx && lmaxx >= ox && lminy <= tmaxy && lmaxy >= oy
}

// Bresenham line across tile boundaries.
// Draws the line on each intersecting tile using local coordinates;
// out-of-bounds pixels are silently ignored by surface_set_pixel.
pub fn tiled_draw_line(ts: TiledSurface, x0: i64, y0: i64, x1: i64, y1: i64, c: Color) -> TiledSurface with Mut, Panic, Div {
    var out = ts
    let n = out.tiles_wide * out.tiles_high

    var lminx = x0
    var lmaxx = x1
    if x1 < x0 { lminx = x1; lmaxx = x0 }
    var lminy = y0
    var lmaxy = y1
    if y1 < y0 { lminy = y1; lmaxy = y0 }

    if n > 0 {
        let ox = 0
        let oy = 0
        if tile_line_intersects(ox, oy, out.tile_w, out.tile_h, lminx, lmaxx, lminy, lmaxy) {
            out.tile0 = surface_draw_line(out.tile0, x0, y0, x1, y1, c)
        }
    }
    if n > 1 {
        let tx = 1 % out.tiles_wide
        let ty = 1 / out.tiles_wide
        let ox = tx * out.tile_w
        let oy = ty * out.tile_h
        if tile_line_intersects(ox, oy, out.tile_w, out.tile_h, lminx, lmaxx, lminy, lmaxy) {
            out.tile1 = surface_draw_line(out.tile1, x0 - ox, y0 - oy, x1 - ox, y1 - oy, c)
        }
    }
    if n > 2 {
        let tx = 2 % out.tiles_wide
        let ty = 2 / out.tiles_wide
        let ox = tx * out.tile_w
        let oy = ty * out.tile_h
        if tile_line_intersects(ox, oy, out.tile_w, out.tile_h, lminx, lmaxx, lminy, lmaxy) {
            out.tile2 = surface_draw_line(out.tile2, x0 - ox, y0 - oy, x1 - ox, y1 - oy, c)
        }
    }
    if n > 3 {
        let tx = 3 % out.tiles_wide
        let ty = 3 / out.tiles_wide
        let ox = tx * out.tile_w
        let oy = ty * out.tile_h
        if tile_line_intersects(ox, oy, out.tile_w, out.tile_h, lminx, lmaxx, lminy, lmaxy) {
            out.tile3 = surface_draw_line(out.tile3, x0 - ox, y0 - oy, x1 - ox, y1 - oy, c)
        }
    }
    if n > 4 {
        let tx = 4 % out.tiles_wide
        let ty = 4 / out.tiles_wide
        let ox = tx * out.tile_w
        let oy = ty * out.tile_h
        if tile_line_intersects(ox, oy, out.tile_w, out.tile_h, lminx, lmaxx, lminy, lmaxy) {
            out.tile4 = surface_draw_line(out.tile4, x0 - ox, y0 - oy, x1 - ox, y1 - oy, c)
        }
    }
    if n > 5 {
        let tx = 5 % out.tiles_wide
        let ty = 5 / out.tiles_wide
        let ox = tx * out.tile_w
        let oy = ty * out.tile_h
        if tile_line_intersects(ox, oy, out.tile_w, out.tile_h, lminx, lmaxx, lminy, lmaxy) {
            out.tile5 = surface_draw_line(out.tile5, x0 - ox, y0 - oy, x1 - ox, y1 - oy, c)
        }
    }
    if n > 6 {
        let tx = 6 % out.tiles_wide
        let ty = 6 / out.tiles_wide
        let ox = tx * out.tile_w
        let oy = ty * out.tile_h
        if tile_line_intersects(ox, oy, out.tile_w, out.tile_h, lminx, lmaxx, lminy, lmaxy) {
            out.tile6 = surface_draw_line(out.tile6, x0 - ox, y0 - oy, x1 - ox, y1 - oy, c)
        }
    }
    if n > 7 {
        let tx = 7 % out.tiles_wide
        let ty = 7 / out.tiles_wide
        let ox = tx * out.tile_w
        let oy = ty * out.tile_h
        if tile_line_intersects(ox, oy, out.tile_w, out.tile_h, lminx, lmaxx, lminy, lmaxy) {
            out.tile7 = surface_draw_line(out.tile7, x0 - ox, y0 - oy, x1 - ox, y1 - oy, c)
        }
    }
    if n > 8 {
        let tx = 8 % out.tiles_wide
        let ty = 8 / out.tiles_wide
        let ox = tx * out.tile_w
        let oy = ty * out.tile_h
        if tile_line_intersects(ox, oy, out.tile_w, out.tile_h, lminx, lmaxx, lminy, lmaxy) {
            out.tile8 = surface_draw_line(out.tile8, x0 - ox, y0 - oy, x1 - ox, y1 - oy, c)
        }
    }
    out
}

// Helper: test whether a rect intersects a tile.
fn tile_rect_intersects(ox: i64, oy: i64, tw: i64, th: i64, rx: i64, ry: i64, rx1: i64, ry1: i64) -> bool {
    let tmaxx = ox + tw - 1
    let tmaxy = oy + th - 1
    rx <= tmaxx && rx1 >= ox && ry <= tmaxy && ry1 >= oy
}

// Filled rect across tile boundaries.
// For each intersecting tile, clips the rect to the tile's bounds and draws only the overlap.
pub fn tiled_draw_rect(ts: TiledSurface, x: i64, y: i64, w: i64, h: i64, c: Color) -> TiledSurface with Mut, Panic, Div {
    var out = ts
    let n = out.tiles_wide * out.tiles_high
    let rx1 = x + w
    let ry1 = y + h
    if n > 0 {
        let ox = 0
        let oy = 0
        if tile_rect_intersects(ox, oy, out.tile_w, out.tile_h, x, y, rx1, ry1) {
            let clip_x = if x > ox { x } else { ox }
            let clip_y = if y > oy { y } else { oy }
            let clip_x1 = if rx1 < ox + out.tile_w { rx1 } else { ox + out.tile_w }
            let clip_y1 = if ry1 < oy + out.tile_h { ry1 } else { oy + out.tile_h }
            let cw = clip_x1 - clip_x
            let ch = clip_y1 - clip_y
            if cw > 0 && ch > 0 {
                out.tile0 = surface_draw_rect(out.tile0, clip_x - ox, clip_y - oy, cw, ch, c)
            }
        }
    }
    if n > 1 {
        let tx = 1 % out.tiles_wide
        let ty = 1 / out.tiles_wide
        let ox = tx * out.tile_w
        let oy = ty * out.tile_h
        if tile_rect_intersects(ox, oy, out.tile_w, out.tile_h, x, y, rx1, ry1) {
            let clip_x = if x > ox { x } else { ox }
            let clip_y = if y > oy { y } else { oy }
            let clip_x1 = if rx1 < ox + out.tile_w { rx1 } else { ox + out.tile_w }
            let clip_y1 = if ry1 < oy + out.tile_h { ry1 } else { oy + out.tile_h }
            let cw = clip_x1 - clip_x
            let ch = clip_y1 - clip_y
            if cw > 0 && ch > 0 {
                out.tile1 = surface_draw_rect(out.tile1, clip_x - ox, clip_y - oy, cw, ch, c)
            }
        }
    }
    if n > 2 {
        let tx = 2 % out.tiles_wide
        let ty = 2 / out.tiles_wide
        let ox = tx * out.tile_w
        let oy = ty * out.tile_h
        if tile_rect_intersects(ox, oy, out.tile_w, out.tile_h, x, y, rx1, ry1) {
            let clip_x = if x > ox { x } else { ox }
            let clip_y = if y > oy { y } else { oy }
            let clip_x1 = if rx1 < ox + out.tile_w { rx1 } else { ox + out.tile_w }
            let clip_y1 = if ry1 < oy + out.tile_h { ry1 } else { oy + out.tile_h }
            let cw = clip_x1 - clip_x
            let ch = clip_y1 - clip_y
            if cw > 0 && ch > 0 {
                out.tile2 = surface_draw_rect(out.tile2, clip_x - ox, clip_y - oy, cw, ch, c)
            }
        }
    }
    if n > 3 {
        let tx = 3 % out.tiles_wide
        let ty = 3 / out.tiles_wide
        let ox = tx * out.tile_w
        let oy = ty * out.tile_h
        if tile_rect_intersects(ox, oy, out.tile_w, out.tile_h, x, y, rx1, ry1) {
            let clip_x = if x > ox { x } else { ox }
            let clip_y = if y > oy { y } else { oy }
            let clip_x1 = if rx1 < ox + out.tile_w { rx1 } else { ox + out.tile_w }
            let clip_y1 = if ry1 < oy + out.tile_h { ry1 } else { oy + out.tile_h }
            let cw = clip_x1 - clip_x
            let ch = clip_y1 - clip_y
            if cw > 0 && ch > 0 {
                out.tile3 = surface_draw_rect(out.tile3, clip_x - ox, clip_y - oy, cw, ch, c)
            }
        }
    }
    if n > 4 {
        let tx = 4 % out.tiles_wide
        let ty = 4 / out.tiles_wide
        let ox = tx * out.tile_w
        let oy = ty * out.tile_h
        if tile_rect_intersects(ox, oy, out.tile_w, out.tile_h, x, y, rx1, ry1) {
            let clip_x = if x > ox { x } else { ox }
            let clip_y = if y > oy { y } else { oy }
            let clip_x1 = if rx1 < ox + out.tile_w { rx1 } else { ox + out.tile_w }
            let clip_y1 = if ry1 < oy + out.tile_h { ry1 } else { oy + out.tile_h }
            let cw = clip_x1 - clip_x
            let ch = clip_y1 - clip_y
            if cw > 0 && ch > 0 {
                out.tile4 = surface_draw_rect(out.tile4, clip_x - ox, clip_y - oy, cw, ch, c)
            }
        }
    }
    if n > 5 {
        let tx = 5 % out.tiles_wide
        let ty = 5 / out.tiles_wide
        let ox = tx * out.tile_w
        let oy = ty * out.tile_h
        if tile_rect_intersects(ox, oy, out.tile_w, out.tile_h, x, y, rx1, ry1) {
            let clip_x = if x > ox { x } else { ox }
            let clip_y = if y > oy { y } else { oy }
            let clip_x1 = if rx1 < ox + out.tile_w { rx1 } else { ox + out.tile_w }
            let clip_y1 = if ry1 < oy + out.tile_h { ry1 } else { oy + out.tile_h }
            let cw = clip_x1 - clip_x
            let ch = clip_y1 - clip_y
            if cw > 0 && ch > 0 {
                out.tile5 = surface_draw_rect(out.tile5, clip_x - ox, clip_y - oy, cw, ch, c)
            }
        }
    }
    if n > 6 {
        let tx = 6 % out.tiles_wide
        let ty = 6 / out.tiles_wide
        let ox = tx * out.tile_w
        let oy = ty * out.tile_h
        if tile_rect_intersects(ox, oy, out.tile_w, out.tile_h, x, y, rx1, ry1) {
            let clip_x = if x > ox { x } else { ox }
            let clip_y = if y > oy { y } else { oy }
            let clip_x1 = if rx1 < ox + out.tile_w { rx1 } else { ox + out.tile_w }
            let clip_y1 = if ry1 < oy + out.tile_h { ry1 } else { oy + out.tile_h }
            let cw = clip_x1 - clip_x
            let ch = clip_y1 - clip_y
            if cw > 0 && ch > 0 {
                out.tile6 = surface_draw_rect(out.tile6, clip_x - ox, clip_y - oy, cw, ch, c)
            }
        }
    }
    if n > 7 {
        let tx = 7 % out.tiles_wide
        let ty = 7 / out.tiles_wide
        let ox = tx * out.tile_w
        let oy = ty * out.tile_h
        if tile_rect_intersects(ox, oy, out.tile_w, out.tile_h, x, y, rx1, ry1) {
            let clip_x = if x > ox { x } else { ox }
            let clip_y = if y > oy { y } else { oy }
            let clip_x1 = if rx1 < ox + out.tile_w { rx1 } else { ox + out.tile_w }
            let clip_y1 = if ry1 < oy + out.tile_h { ry1 } else { oy + out.tile_h }
            let cw = clip_x1 - clip_x
            let ch = clip_y1 - clip_y
            if cw > 0 && ch > 0 {
                out.tile7 = surface_draw_rect(out.tile7, clip_x - ox, clip_y - oy, cw, ch, c)
            }
        }
    }
    if n > 8 {
        let tx = 8 % out.tiles_wide
        let ty = 8 / out.tiles_wide
        let ox = tx * out.tile_w
        let oy = ty * out.tile_h
        if tile_rect_intersects(ox, oy, out.tile_w, out.tile_h, x, y, rx1, ry1) {
            let clip_x = if x > ox { x } else { ox }
            let clip_y = if y > oy { y } else { oy }
            let clip_x1 = if rx1 < ox + out.tile_w { rx1 } else { ox + out.tile_w }
            let clip_y1 = if ry1 < oy + out.tile_h { ry1 } else { oy + out.tile_h }
            let cw = clip_x1 - clip_x
            let ch = clip_y1 - clip_y
            if cw > 0 && ch > 0 {
                out.tile8 = surface_draw_rect(out.tile8, clip_x - ox, clip_y - oy, cw, ch, c)
            }
        }
    }
    out
}

// Batch rectangle draw on TiledSurface — same semantics as tiled_draw_rect,
// explicitly named for bulk pipelines that expect a "batch" API.
pub fn tiled_draw_rect_batch(ts: TiledSurface, x: i64, y: i64, w: i64, h: i64, c: Color) -> TiledSurface with Mut, Panic, Div {
    tiled_draw_rect(ts, x, y, w, h, c)
}

// Read pixel R channel from global coordinates.
pub fn tiled_get_pixel_r(ts: &TiledSurface, x: i64, y: i64) -> i64 {
    if x < 0 || x >= ts.width || y < 0 || y >= ts.height { return 0 }
    let tx = x / ts.tile_w
    let ty = y / ts.tile_h
    let lx = x % ts.tile_w
    let ly = y % ts.tile_h
    let idx = ty * ts.tiles_wide + tx
    if idx < 0 || idx >= 9 { return 0 }
    let pidx = ly * ts.tile_w + lx
    if idx == 0 {
        ts.tile0.r[pidx]
    } else if idx == 1 {
        ts.tile1.r[pidx]
    } else if idx == 2 {
        ts.tile2.r[pidx]
    } else if idx == 3 {
        ts.tile3.r[pidx]
    } else if idx == 4 {
        ts.tile4.r[pidx]
    } else if idx == 5 {
        ts.tile5.r[pidx]
    } else if idx == 6 {
        ts.tile6.r[pidx]
    } else if idx == 7 {
        ts.tile7.r[pidx]
    } else {
        ts.tile8.r[pidx]
    }
}

