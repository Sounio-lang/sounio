// Export composited PPM to stdout.
pub fn tiled_export_ppm(ts: &TiledSurface) with IO, Mut, Div, Panic {
    print("P3\n")
    print_int(ts.width)
    print(" ")
    print_int(ts.height)
    print("\n255\n")
    var y: i64 = 0
    while y < ts.height {
        var x: i64 = 0
        while x < ts.width {
            let tx = x / ts.tile_w
            let ty = y / ts.tile_h
            let lx = x % ts.tile_w
            let ly = y % ts.tile_h
            let idx = ty * ts.tiles_wide + tx
            let pidx = ly * ts.tile_w + lx
            var r = 0
            var g = 0
            var b = 0
            if idx == 0 {
                r = ts.tile0.r[pidx]
                g = ts.tile0.g[pidx]
                b = ts.tile0.b[pidx]
            } else if idx == 1 {
                r = ts.tile1.r[pidx]
                g = ts.tile1.g[pidx]
                b = ts.tile1.b[pidx]
            } else if idx == 2 {
                r = ts.tile2.r[pidx]
                g = ts.tile2.g[pidx]
                b = ts.tile2.b[pidx]
            } else if idx == 3 {
                r = ts.tile3.r[pidx]
                g = ts.tile3.g[pidx]
                b = ts.tile3.b[pidx]
            } else if idx == 4 {
                r = ts.tile4.r[pidx]
                g = ts.tile4.g[pidx]
                b = ts.tile4.b[pidx]
            } else if idx == 5 {
                r = ts.tile5.r[pidx]
                g = ts.tile5.g[pidx]
                b = ts.tile5.b[pidx]
            } else if idx == 6 {
                r = ts.tile6.r[pidx]
                g = ts.tile6.g[pidx]
                b = ts.tile6.b[pidx]
            } else if idx == 7 {
                r = ts.tile7.r[pidx]
                g = ts.tile7.g[pidx]
                b = ts.tile7.b[pidx]
            } else if idx == 8 {
                r = ts.tile8.r[pidx]
                g = ts.tile8.g[pidx]
                b = ts.tile8.b[pidx]
            }
            print_int(clamp_byte(r))
            print(" ")
            print_int(clamp_byte(g))
            print(" ")
            print_int(clamp_byte(b))
            print("\n")
            x = x + 1
        }
        y = y + 1
    }
}

fn clamp_byte(v: i64) -> i64 {
    if v < 0 { 0 } else if v > 255 { 255 } else { v }
}

// ============================================================================
// TILED SURFACE PNG EXPORT
// ============================================================================

fn tiled_tile_adler_rgb(ts: &TiledSurface, idx: i64, a: i64, b: i64) -> (i64, i64) with Mut, Panic {
    var a1 = a
    var b1 = b
    if idx == 0 {
        var y = 0
        while y < ts.tile0.height {
            a1 = (a1 + 0) % 65521
            b1 = (b1 + a1) % 65521
            var x = 0
            while x < ts.tile0.width {
                let pidx = y * ts.tile0.width + x
                a1 = (a1 + ts.tile0.r[pidx]) % 65521
                b1 = (b1 + a1) % 65521
                a1 = (a1 + ts.tile0.g[pidx]) % 65521
                b1 = (b1 + a1) % 65521
                a1 = (a1 + ts.tile0.b[pidx]) % 65521
                b1 = (b1 + a1) % 65521
                x = x + 1
            }
            y = y + 1
        }
    } else if idx == 1 {
        var y = 0
        while y < ts.tile1.height {
            a1 = (a1 + 0) % 65521
            b1 = (b1 + a1) % 65521
            var x = 0
            while x < ts.tile1.width {
                let pidx = y * ts.tile1.width + x
                a1 = (a1 + ts.tile1.r[pidx]) % 65521
                b1 = (b1 + a1) % 65521
                a1 = (a1 + ts.tile1.g[pidx]) % 65521
                b1 = (b1 + a1) % 65521
                a1 = (a1 + ts.tile1.b[pidx]) % 65521
                b1 = (b1 + a1) % 65521
                x = x + 1
            }
            y = y + 1
        }
    } else if idx == 2 {
        var y = 0
        while y < ts.tile2.height {
            a1 = (a1 + 0) % 65521
            b1 = (b1 + a1) % 65521
            var x = 0
            while x < ts.tile2.width {
                let pidx = y * ts.tile2.width + x
                a1 = (a1 + ts.tile2.r[pidx]) % 65521
                b1 = (b1 + a1) % 65521
                a1 = (a1 + ts.tile2.g[pidx]) % 65521
                b1 = (b1 + a1) % 65521
                a1 = (a1 + ts.tile2.b[pidx]) % 65521
                b1 = (b1 + a1) % 65521
                x = x + 1
            }
            y = y + 1
        }
    } else if idx == 3 {
        var y = 0
        while y < ts.tile3.height {
            a1 = (a1 + 0) % 65521
            b1 = (b1 + a1) % 65521
            var x = 0
            while x < ts.tile3.width {
                let pidx = y * ts.tile3.width + x
                a1 = (a1 + ts.tile3.r[pidx]) % 65521
                b1 = (b1 + a1) % 65521
                a1 = (a1 + ts.tile3.g[pidx]) % 65521
                b1 = (b1 + a1) % 65521
                a1 = (a1 + ts.tile3.b[pidx]) % 65521
                b1 = (b1 + a1) % 65521
                x = x + 1
            }
            y = y + 1
        }
    } else if idx == 4 {
        var y = 0
        while y < ts.tile4.height {
            a1 = (a1 + 0) % 65521
            b1 = (b1 + a1) % 65521
            var x = 0
            while x < ts.tile4.width {
                let pidx = y * ts.tile4.width + x
                a1 = (a1 + ts.tile4.r[pidx]) % 65521
                b1 = (b1 + a1) % 65521
                a1 = (a1 + ts.tile4.g[pidx]) % 65521
                b1 = (b1 + a1) % 65521
                a1 = (a1 + ts.tile4.b[pidx]) % 65521
                b1 = (b1 + a1) % 65521
                x = x + 1
            }
            y = y + 1
        }
    } else if idx == 5 {
        var y = 0
        while y < ts.tile5.height {
            a1 = (a1 + 0) % 65521
            b1 = (b1 + a1) % 65521
            var x = 0
            while x < ts.tile5.width {
                let pidx = y * ts.tile5.width + x
                a1 = (a1 + ts.tile5.r[pidx]) % 65521
                b1 = (b1 + a1) % 65521
                a1 = (a1 + ts.tile5.g[pidx]) % 65521
                b1 = (b1 + a1) % 65521
                a1 = (a1 + ts.tile5.b[pidx]) % 65521
                b1 = (b1 + a1) % 65521
                x = x + 1
            }
            y = y + 1
        }
    } else if idx == 6 {
        var y = 0
        while y < ts.tile6.height {
            a1 = (a1 + 0) % 65521
            b1 = (b1 + a1) % 65521
            var x = 0
            while x < ts.tile6.width {
                let pidx = y * ts.tile6.width + x
                a1 = (a1 + ts.tile6.r[pidx]) % 65521
                b1 = (b1 + a1) % 65521
                a1 = (a1 + ts.tile6.g[pidx]) % 65521
                b1 = (b1 + a1) % 65521
                a1 = (a1 + ts.tile6.b[pidx]) % 65521
                b1 = (b1 + a1) % 65521
                x = x + 1
            }
            y = y + 1
        }
    } else if idx == 7 {
        var y = 0
        while y < ts.tile7.height {
            a1 = (a1 + 0) % 65521
            b1 = (b1 + a1) % 65521
            var x = 0
            while x < ts.tile7.width {
                let pidx = y * ts.tile7.width + x
                a1 = (a1 + ts.tile7.r[pidx]) % 65521
                b1 = (b1 + a1) % 65521
                a1 = (a1 + ts.tile7.g[pidx]) % 65521
                b1 = (b1 + a1) % 65521
                a1 = (a1 + ts.tile7.b[pidx]) % 65521
                b1 = (b1 + a1) % 65521
                x = x + 1
            }
            y = y + 1
        }
    } else if idx == 8 {
        var y = 0
        while y < ts.tile8.height {
            a1 = (a1 + 0) % 65521
            b1 = (b1 + a1) % 65521
            var x = 0
            while x < ts.tile8.width {
                let pidx = y * ts.tile8.width + x
                a1 = (a1 + ts.tile8.r[pidx]) % 65521
                b1 = (b1 + a1) % 65521
                a1 = (a1 + ts.tile8.g[pidx]) % 65521
                b1 = (b1 + a1) % 65521
                a1 = (a1 + ts.tile8.b[pidx]) % 65521
                b1 = (b1 + a1) % 65521
                x = x + 1
            }
            y = y + 1
        }
    }
    (a1, b1)
}

fn tiled_compute_adler_rgb(ts: &TiledSurface) -> i64 with Mut, Panic {
    var a: i64 = 1
    var b: i64 = 0
    let n = ts.tiles_wide * ts.tiles_high
    var idx: i64 = 0
    while idx < n && idx < 9 {
        let ab = tiled_tile_adler_rgb(ts, idx, a, b)
        a = ab.0
        b = ab.1
        idx = idx + 1
    }
    (b << 16) | a
}

pub fn tiled_export_png(ts: &TiledSurface, filename: string) -> bool with IO, Mut, Panic, Div {
    if ts.width <= 0 || ts.height <= 0 { return false }

    let adler = tiled_compute_adler_rgb(ts)
    let scanline_size = 1 + ts.width * 3

    if !png_write_sig(filename) { return false }
    if !png_write_ihdr(filename, ts.width, ts.height, PNG_COLOR_RGB) { return false }

    var block_buf: [i8; 32800] = [0; 32800]
    var block_pos: i64 = 0
    var block_num: i64 = 0
    var y: i64 = 0

    while y < ts.height {
        if block_pos > 0 && block_pos + scanline_size > BLOCK_MAX {
            if !png_write_deflate_block(filename, block_num, false, block_pos, block_buf, adler) {
                return false
            }
            block_pos = 0
            block_num = block_num + 1
        }

        block_buf[block_pos] = 0 as i8
        block_pos = block_pos + 1

        let ty = y / ts.tile_h
        let ly = y % ts.tile_h
        var tx: i64 = 0
        while tx < ts.tiles_wide {
            let idx = ty * ts.tiles_wide + tx
            var tile_width: i64 = 0
            var r_arr: [i64; 65536] = [0; 65536]
            var g_arr: [i64; 65536] = [0; 65536]
            var b_arr: [i64; 65536] = [0; 65536]

            if idx == 0 {
                tile_width = ts.tile0.width
                r_arr = ts.tile0.r
                g_arr = ts.tile0.g
                b_arr = ts.tile0.b
            } else if idx == 1 {
                tile_width = ts.tile1.width
                r_arr = ts.tile1.r
                g_arr = ts.tile1.g
                b_arr = ts.tile1.b
            } else if idx == 2 {
                tile_width = ts.tile2.width
                r_arr = ts.tile2.r
                g_arr = ts.tile2.g
                b_arr = ts.tile2.b
            } else if idx == 3 {
                tile_width = ts.tile3.width
                r_arr = ts.tile3.r
                g_arr = ts.tile3.g
                b_arr = ts.tile3.b
            } else if idx == 4 {
                tile_width = ts.tile4.width
                r_arr = ts.tile4.r
                g_arr = ts.tile4.g
                b_arr = ts.tile4.b
            } else if idx == 5 {
                tile_width = ts.tile5.width
                r_arr = ts.tile5.r
                g_arr = ts.tile5.g
                b_arr = ts.tile5.b
            } else if idx == 6 {
                tile_width = ts.tile6.width
                r_arr = ts.tile6.r
                g_arr = ts.tile6.g
                b_arr = ts.tile6.b
            } else if idx == 7 {
                tile_width = ts.tile7.width
                r_arr = ts.tile7.r
                g_arr = ts.tile7.g
                b_arr = ts.tile7.b
            } else if idx == 8 {
                tile_width = ts.tile8.width
                r_arr = ts.tile8.r
                g_arr = ts.tile8.g
                b_arr = ts.tile8.b
            }

            var lx: i64 = 0
            while lx < tile_width {
                let pidx = ly * tile_width + lx
                block_buf[block_pos] = pixel_to_i8(r_arr[pidx])
                block_pos = block_pos + 1
                block_buf[block_pos] = pixel_to_i8(g_arr[pidx])
                block_pos = block_pos + 1
                block_buf[block_pos] = pixel_to_i8(b_arr[pidx])
                block_pos = block_pos + 1
                lx = lx + 1
            }
            tx = tx + 1
        }
        y = y + 1
    }

    if block_pos > 0 {
        if !png_write_deflate_block(filename, block_num, true, block_pos, block_buf, adler) {
            return false
        }
    }

    png_write_iend(filename)
}

fn main() -> i32 with IO { 0 }
