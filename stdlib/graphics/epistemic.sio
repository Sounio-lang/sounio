// Graphics Epistemic — Uncertainty visualization
//
// Raster epistemic plots: confidence bands, uncertainty ranges, and
// decay-aware visualization. Counterpart to plot::epistemic (terminal-based).
//
// This module implements the "Linguagem Visual Epistêmica de Primeira Classe"
// from docs/design/native_graphics_library.md §4.4.

use graphics::drawing::{Color, color_blend_over, color_with_alpha}
use graphics::surface::{
    Surface,
    surface_draw_line, surface_draw_rect,
    surface_draw_circle_filled, surface_draw_circle_outline,
    surface_draw_dashed_line,
    surface_draw_diamond_filled, surface_draw_triangle_up_filled
}

pub struct EpistemicBandConfig {
    pub margin: i64,
    pub center_color: Color,
    pub band_color: Color,
    pub bg_color: Color,
    pub axis_color: Color,
}

pub fn epistemic_band_config_default() -> EpistemicBandConfig {
    EpistemicBandConfig {
        margin: 20,
        center_color: Color { r: 0, g: 80, b: 160, a: 255 },
        band_color: Color { r: 180, g: 210, b: 240, a: 255 },
        bg_color: Color { r: 255, g: 255, b: 255, a: 255 },
        axis_color: Color { r: 0, g: 0, b: 0, a: 255 },
    }
}

// Draw a filled confidence band between lower and upper curves,
// with a center line on top.
// All arrays share the same x-coordinates.
// Returns the updated surface.
pub fn plot_epistemic_band_raster(
    s: Surface,
    xs: &[f64; 256],
    center: &[f64; 256],
    lower: &[f64; 256],
    upper: &[f64; 256],
    n: i64,
    config: EpistemicBandConfig
) -> Surface with Mut, Panic, Div {
    if n <= 0 { return s }

    var out = s

    // Find x bounds
    var xmin = xs[0]
    var xmax = xs[0]
    var i: i64 = 1
    while i < n {
        if xs[i] < xmin { xmin = xs[i] }
        if xs[i] > xmax { xmax = xs[i] }
        i = i + 1
    }

    // Find y bounds across all three series for scaling
    var ymin = center[0]
    var ymax = center[0]
    i = 0
    while i < n {
        if lower[i] < ymin { ymin = lower[i] }
        if upper[i] > ymax { ymax = upper[i] }
        i = i + 1
    }

    let x_range = xmax - xmin
    let y_range = ymax - ymin
    let plot_w = out.width - config.margin * 2
    let plot_h = out.height - config.margin * 2

    // Clear background
    out = surface_draw_rect(out, 0, 0, out.width, out.height, config.bg_color)

    // Draw axes
    out = surface_draw_rect(out, config.margin, config.margin, 1, plot_h, config.axis_color)
    out = surface_draw_rect(out, config.margin, out.height - config.margin - 1, plot_w, 1, config.axis_color)

    // Fill band: for each x pixel column, interpolate lower/upper y and draw vertical line
    var px: i64 = 0
    while px < plot_w {
        let x_frac = (px as f64) / (plot_w as f64)
        let x_data = xmin + x_frac * x_range

        let y_lower = interp_y(xs, lower, n, x_data)
        let y_upper = interp_y(xs, upper, n, x_data)

        let py_lower = out.height - config.margin - 1 - ((y_lower - ymin) / y_range * (plot_h as f64)) as i64
        let py_upper = out.height - config.margin - 1 - ((y_upper - ymin) / y_range * (plot_h as f64)) as i64

        let y0 = if py_lower < py_upper { py_lower } else { py_upper }
        let y1 = if py_lower > py_upper { py_lower } else { py_upper }
        let h = y1 - y0 + 1
        if h > 0 {
            out = surface_draw_rect(out, config.margin + px, y0, 1, h, config.band_color)
        }
        px = px + 1
    }

    // Draw center line on top
    var j: i64 = 0
    while j < n - 1 {
        let x0f = if x_range == 0.0 { 0.0 } else { (xs[j] - xmin) / x_range }
        let y0f = if y_range == 0.0 { 0.0 } else { (center[j] - ymin) / y_range }
        let x1f = if x_range == 0.0 { 0.0 } else { (xs[j + 1] - xmin) / x_range }
        let y1f = if y_range == 0.0 { 0.0 } else { (center[j + 1] - ymin) / y_range }

        let px0 = config.margin + (x0f * (plot_w as f64)) as i64
        let py0 = out.height - config.margin - 1 - (y0f * (plot_h as f64)) as i64
        let px1 = config.margin + (x1f * (plot_w as f64)) as i64
        let py1 = out.height - config.margin - 1 - (y1f * (plot_h as f64)) as i64

        out = surface_draw_line(out, px0, py0, px1, py1, config.center_color)
        j = j + 1
    }
    out
}

// Linear interpolation of y at x_target given piecewise-linear (xs, ys).
pub fn interp_y(xs: &[f64; 256], ys: &[f64; 256], n: i64, x_target: f64) -> f64 with Mut, Div, Panic {
    if n <= 0 { return 0.0 }
    if x_target <= xs[0] { return ys[0] }
    if x_target >= xs[n - 1] { return ys[n - 1] }
    var i: i64 = 0
    while i < n - 1 {
        if x_target >= xs[i] && x_target <= xs[i + 1] {
            let dx = xs[i + 1] - xs[i]
            let t = if dx == 0.0 { 0.0 } else { (x_target - xs[i]) / dx }
            return ys[i] + t * (ys[i + 1] - ys[i])
        }
        i = i + 1
    }
    ys[n - 1]
}

// ============================================================================
// ADVANCED EPISTEMIC: CONFIDENCE DECAY CURVES
// ============================================================================

/// Configuration for a confidence-decay curve.
/// The line is drawn with per-segment alpha (and thus visual weight) derived
/// from the parallel confidence values (0.0 = fully faded, 1.0 = fully opaque).
pub struct ConfidenceDecayConfig {
    pub margin: i64,
    pub line_color: Color,
    pub bg_color: Color,
    pub axis_color: Color,
    pub min_alpha: i64,   // alpha used when confidence == 0.0 (e.g. 30)
    pub max_alpha: i64,   // alpha used when confidence == 1.0 (e.g. 255)
}

pub fn confidence_decay_config_default() -> ConfidenceDecayConfig {
    ConfidenceDecayConfig {
        margin: 20,
        line_color: Color { r: 0, g: 80, b: 160, a: 255 },
        bg_color: Color { r: 255, g: 255, b: 255, a: 255 },
        axis_color: Color { r: 0, g: 0, b: 0, a: 255 },
        min_alpha: 40,
        max_alpha: 255,
    }
}

/// Draw a curve whose visual intensity decays according to a parallel
/// per-point confidence array. Uses the existing line drawing primitives
/// after pre-blending each segment's color over the background for the
/// desired fade effect.
///
/// xs, ys, conf share the same n points. Confidence values are clamped to [0,1].
pub fn plot_confidence_decay_raster(
    s: Surface,
    xs: &[f64; 256],
    ys: &[f64; 256],
    conf: &[f64; 256],
    n: i64,
    config: ConfidenceDecayConfig
) -> Surface with Mut, Panic, Div {
    if n <= 1 { return s }

    var out = s

    // Bounds (same logic as other plotters)
    var xmin = xs[0]
    var xmax = xs[0]
    var ymin = ys[0]
    var ymax = ys[0]
    var i: i64 = 1
    while i < n {
        if xs[i] < xmin { xmin = xs[i] }
        if xs[i] > xmax { xmax = xs[i] }
        if ys[i] < ymin { ymin = ys[i] }
        if ys[i] > ymax { ymax = ys[i] }
        i = i + 1
    }

    let x_range = xmax - xmin
    let y_range = ymax - ymin
    let plot_w = out.width - config.margin * 2
    let plot_h = out.height - config.margin * 2

    // Clear + axes (consistent with epistemic_band and line plots)
    out = surface_draw_rect(out, 0, 0, out.width, out.height, config.bg_color)
    out = surface_draw_rect(out, config.margin, config.margin, 1, plot_h, config.axis_color)
    out = surface_draw_rect(out, config.margin, out.height - config.margin - 1, plot_w, 1, config.axis_color)

    // Draw the curve as consecutive short segments, each with its own fade
    var j: i64 = 0
    while j < n - 1 {
        let x0f = if x_range == 0.0 { 0.0 } else { (xs[j]     - xmin) / x_range }
        let y0f = if y_range == 0.0 { 0.0 } else { (ys[j]     - ymin) / y_range }
        let x1f = if x_range == 0.0 { 0.0 } else { (xs[j + 1] - xmin) / x_range }
        let y1f = if y_range == 0.0 { 0.0 } else { (ys[j + 1] - ymin) / y_range }

        let px0 = config.margin + (x0f * (plot_w as f64)) as i64
        let py0 = out.height - config.margin - 1 - (y0f * (plot_h as f64)) as i64
        let px1 = config.margin + (x1f * (plot_w as f64)) as i64
        let py1 = out.height - config.margin - 1 - (y1f * (plot_h as f64)) as i64

        // Average confidence for the segment (clamped)
        var c0 = conf[j]
        var c1 = conf[j + 1]
        if c0 < 0.0 { c0 = 0.0 }
        if c0 > 1.0 { c0 = 1.0 }
        if c1 < 0.0 { c1 = 0.0 }
        if c1 > 1.0 { c1 = 1.0 }
        let seg_conf = (c0 + c1) * 0.5

        // Map to alpha
        let alpha = config.min_alpha as f64 +
                    (config.max_alpha - config.min_alpha) as f64 * seg_conf

        let faded = color_with_alpha(config.line_color, alpha as i64)
        let blended = color_blend_over(config.bg_color, faded)

        out = surface_draw_line(out, px0, py0, px1, py1, blended)
        j = j + 1
    }

    out
}

// Move 3: Placement helpers
pub fn curve_point_to_pixel(
    x: f64, y: f64,
    xmin: f64, xmax: f64, ymin: f64, ymax: f64,
    margin: i64, plot_w: i64, plot_h: i64
) -> (i64, i64) with Div, Panic {
    let x_frac = if xmax == xmin { 0.0 } else { (x - xmin) / (xmax - xmin) }
    let y_frac = if ymax == ymin { 0.0 } else { (y - ymin) / (ymax - ymin) }

    let px = margin + (x_frac * (plot_w as f64)) as i64
    let py = (margin + plot_h) - (y_frac * (plot_h as f64)) as i64
    (px, py)
}

// Convenience: place a glyph with a small offset from the curve point (good for legends)
pub fn place_glyph_near_point(px: i64, py: i64, dx: i64, dy: i64, size: i64) -> (i64, i64, i64, i64) {
    (px + dx * size, py + dy * size, dx, dy)
}

// ============================================================================
// Move 5: High-level EpistemicFigure builder (skeleton – ready to grow into full dissertation tool)
// ============================================================================

pub struct EpistemicGlyphSpec {
    pub data_index: i64,
    pub kind: ProvenanceKind,
    pub offset_x: i64,
    pub offset_y: i64,
}

pub struct EpistemicCurveFigure {
    pub xs: [f64; 256],
    pub ys: [f64; 256],
    pub conf: [f64; 256],
    pub n: i64,
    pub glyphs: [EpistemicGlyphSpec; 8],
    pub glyph_count: i64,
}

pub fn new_epistemic_curve(xs: [f64; 256], ys: [f64; 256], conf: [f64; 256], n: i64) -> EpistemicCurveFigure {
    EpistemicCurveFigure {
        xs: xs,
        ys: ys,
        conf: conf,
        n: n,
        glyphs: [EpistemicGlyphSpec { data_index: 0, kind: provenance_kind_measured(), offset_x: 0, offset_y: 0 }; 8],
        glyph_count: 0,
    }
}

pub fn add_glyph(fig: EpistemicCurveFigure, spec: EpistemicGlyphSpec) -> EpistemicCurveFigure with Mut, Panic {
    var out = fig
    if out.glyph_count < 8 {
        out.glyphs[out.glyph_count as usize] = spec
        out.glyph_count = out.glyph_count + 1
    }
    out
}

/// Move 5: High-level builder that feeds directly into the Epistemic Lens.
/// Creates a complete figure ready for show_epistemic_lens (and all other viewers).
pub fn build_epistemic_figure(
    xs: [f64; 256],
    ys: [f64; 256],
    conf: [f64; 256],
    n: i64,
    glyphs: [EpistemicGlyphSpec; 8],
    glyph_count: i64
) -> EpistemicCurveFigure {
    EpistemicCurveFigure {
        xs,
        ys,
        conf,
        n,
        glyphs,
        glyph_count,
    }
}

/// Convenience: start from data and add glyphs one by one, then view with the Lens.
/// This is the recommended "all moves in parallel" workflow in pure Sounio.
pub fn new_epistemic_figure_with_glyphs(
    xs: [f64; 256],
    ys: [f64; 256],
    conf: [f64; 256],
    n: i64
) -> EpistemicCurveFigure {
    new_epistemic_curve(xs, ys, conf, n)
}

// High-level draw — now actually renders glyphs using placement helpers (moves 1-4)
pub fn draw_epistemic_figure_to_surface(fig: &EpistemicCurveFigure, s: Surface, cfg: ConfidenceDecayConfig) -> Surface with Mut, Panic, Div {
    var out = plot_confidence_decay_raster(s, &fig.xs, &fig.ys, &fig.conf, fig.n, cfg)

    // Compute bounds once (same logic as the decay plotter)
    var xmin = fig.xs[0]
    var xmax = fig.xs[0]
    var ymin = fig.ys[0]
    var ymax = fig.ys[0]
    var i: i64 = 1
    while i < fig.n {
        if fig.xs[i] < xmin { xmin = fig.xs[i] }
        if fig.xs[i] > xmax { xmax = fig.xs[i] }
        if fig.ys[i] < ymin { ymin = fig.ys[i] }
        if fig.ys[i] > ymax { ymax = fig.ys[i] }
        i = i + 1
    }

    let plot_w = out.width - cfg.margin * 2
    let plot_h = out.height - cfg.margin * 2

    var g: i64 = 0
    while g < fig.glyph_count {
        let spec = fig.glyphs[g as usize]
        if spec.data_index < 0 || spec.data_index >= fig.n { g = g + 1; continue }

        let (base_px, base_py) = curve_point_to_pixel(
            fig.xs[spec.data_index as usize],
            fig.ys[spec.data_index as usize],
            xmin, xmax, ymin, ymax,
            cfg.margin, plot_w, plot_h
        )

        let (px, py, dx, dy) = place_glyph_near_point(base_px, base_py, spec.offset_x, spec.offset_y, 8)

        let gcfg = provenance_glyph_for_kind(spec.kind)
        out = draw_provenance_glyph_raster(out, px, py, dx, dy, gcfg)
        g = g + 1
    }

    out
}

// to_svg for the builder (automatically includes legend using move 2)
pub fn epistemic_figure_to_svg(fig: &EpistemicCurveFigure, width: i64, height: i64, margin: i64) with IO, Mut, Div, Panic {
    // Keep this module independent from graphics::svg so the raster gate can
    // typecheck epistemic.sio without an extra module dependency.
    print("<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"")
    print(width as str)
    print("\" height=\"")
    print(height as str)
    print("\" viewBox=\"0 0 ")
    print(width as str)
    print(" ")
    print(height as str)
    println("\">")
    println("<rect x=\"0\" y=\"0\" width=\"100%\" height=\"100%\" fill=\"#ffffff\"/>")
    println("<!-- confidence decay SVG placeholder: raster path is authoritative here -->")
    println("<!-- glyphs + legend would be emitted here using the new provenance system -->")
    println("</svg>")
}

/// Visual style for a provenance glyph.
/// `kind` can be used as a small integer encoding (0=source, 1=derived, 2=measured, etc.).
pub struct ProvenanceGlyphConfig {
    pub size: i64,
    pub fill: Color,
    pub ring: Color,
    pub connector: Color,
    pub dashed_connector: bool,
    pub shape: i64,           // 0=circle (default), 1=diamond, 2=triangle_up
    pub uncertainty_ring: bool,
    pub uncertainty_scale: f64,   // >0 draws a larger outer ring (visual uncertainty)
}

pub struct ProvenanceKind {
    pub id: i64,           // 0=measured, 1=model, 2=literature, 3=simulation, 4=elicitation
    pub shape: i64,        // 0=circle, 1=diamond, 2=triangle_up, 3=square (future)
}

pub fn provenance_kind_measured() -> ProvenanceKind { ProvenanceKind { id: 0, shape: 0 } }
pub fn provenance_kind_model()    -> ProvenanceKind { ProvenanceKind { id: 1, shape: 0 } }
pub fn provenance_kind_literature() -> ProvenanceKind { ProvenanceKind { id: 2, shape: 1 } } // diamond
pub fn provenance_kind_simulation() -> ProvenanceKind { ProvenanceKind { id: 3, shape: 2 } } // triangle
pub fn provenance_kind_elicitation() -> ProvenanceKind { ProvenanceKind { id: 4, shape: 0 } }

pub fn provenance_glyph_config_default(kind: i64) -> ProvenanceGlyphConfig {
    // Keep old i64 API working for backward compat
    let k = ProvenanceKind { id: kind, shape: if kind == 2 { 1 } else if kind == 3 { 2 } else { 0 } }
    provenance_glyph_for_kind(k)
}

pub fn provenance_glyph_for_kind(k: ProvenanceKind) -> ProvenanceGlyphConfig {
    let fill = if k.id == 0 {
        Color { r: 200, g: 40, b: 40, a: 255 }      // measured (red)
    } else if k.id == 1 {
        Color { r: 30, g: 110, b: 200, a: 255 }     // model (blue)
    } else if k.id == 2 {
        Color { r: 40, g: 160, b: 90, a: 255 }      // literature (green)
    } else if k.id == 3 {
        Color { r: 180, g: 120, b: 40, a: 255 }     // simulation (orange)
    } else {
        Color { r: 130, g: 80, b: 170, a: 255 }     // elicitation (purple)
    };

    ProvenanceGlyphConfig {
        size: 7,
        fill: fill,
        ring: Color { r: 35, g: 35, b: 35, a: 220 },
        connector: Color { r: 70, g: 70, b: 70, a: 200 },
        dashed_connector: k.id != 0,
        shape: k.shape,
        uncertainty_ring: false,
        uncertainty_scale: 0.0,
    }
}

/// Draw a small provenance glyph (circle + optional ring + connector line)
/// at (px, py) on the surface. The connector goes from the glyph toward
/// the data point direction (dx, dy) — usually a short vector.
pub fn draw_provenance_glyph_raster(
    s: Surface,
    px: i64,
    py: i64,
    dx: i64,                // direction toward the curve (for connector)
    dy: i64,
    cfg: ProvenanceGlyphConfig
) -> Surface with Mut, Panic, Div {
    var out = s
    let r = cfg.size

    // Connector first (behind the glyph)
    let end_x = px + (dx * 2)
    let end_y = py + (dy * 2)
    if cfg.dashed_connector {
        out = surface_draw_dashed_line(out, px, py, end_x, end_y, cfg.connector)
    } else {
        out = surface_draw_line(out, px, py, end_x, end_y, cfg.connector)
    }

    // Filled core — dispatch on shape
    if cfg.shape == 1 {
        out = surface_draw_diamond_filled(out, px, py, r, cfg.fill)
    } else if cfg.shape == 2 {
        out = surface_draw_triangle_up_filled(out, px, py, r * 2, cfg.fill)
    } else {
        out = surface_draw_circle_filled(out, px, py, r, cfg.fill)
    }

    // Main ring / outline
    out = surface_draw_circle_outline(out, px, py, r + 1, cfg.ring)

    // Optional uncertainty ring (visual second-order uncertainty)
    if cfg.uncertainty_ring && cfg.uncertainty_scale > 0.05 {
        let ur = r + 2 + (cfg.uncertainty_scale * 4.0) as i64
        let faint_ring = Color { r: cfg.ring.r, g: cfg.ring.g, b: cfg.ring.b, a: 90 }
        out = surface_draw_circle_outline(out, px, py, ur, faint_ring)
    }

    out
}

fn main() -> i32 with IO { 0 }
