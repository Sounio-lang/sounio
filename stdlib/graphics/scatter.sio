// Graphics Scatter — Raster scatter plots
//
// Pixel-based scatter plot rendering onto a Surface.
// Counterpart to plot::scatter (terminal-based).

use graphics::drawing::{Color}
use graphics::surface::{Surface, surface_draw_line, surface_draw_rect}

pub struct ScatterConfig {
    pub width: i64,
    pub height: i64,
    pub margin: i64,
    pub marker_color: Color,
    pub bg_color: Color,
    pub axis_color: Color,
    pub marker_size: i64,
}

pub fn scatter_config_default() -> ScatterConfig {
    ScatterConfig {
        width: 256,
        height: 256,
        margin: 20,
        marker_color: Color { r: 200, g: 50, b: 50, a: 255 },
        bg_color: Color { r: 255, g: 255, b: 255, a: 255 },
        axis_color: Color { r: 0, g: 0, b: 0, a: 255 },
        marker_size: 2,
    }
}

// Draw a scatter plot of up to 256 points onto a surface.
// Returns the updated surface.
pub fn plot_scatter_raster(
    s: Surface,
    xs: &[f64; 256],
    ys: &[f64; 256],
    n: i64,
    config: ScatterConfig
) -> Surface with Mut, Panic, Div {
    if n <= 0 { return s }

    var out = s

    // Find data bounds
    var xmin = xs[0]
    var xmax = xs[0]
    var ymin = ys[0]
    var ymax = ys[0]
    var i: i64 = 1
    while i < n {
        if xs[i] < xmin { xmin = xs[i] }
        if xs[i] > xmax { xmax = xs[i] }
        if ys[i] < ymin { ymin = ys[i] }
        if ys[i] > ymax { ymax = ys[i] }
        i = i + 1
    }

    let x_range = xmax - xmin
    let y_range = ymax - ymin
    let plot_w = out.width - config.margin * 2
    let plot_h = out.height - config.margin * 2

    // Clear background
    out = surface_draw_rect(out, 0, 0, out.width, out.height, config.bg_color)

    // Draw axes
    out = surface_draw_rect(out, config.margin, config.margin, 1, plot_h, config.axis_color)
    out = surface_draw_rect(out, config.margin, out.height - config.margin - 1, plot_w, 1, config.axis_color)

    // Draw markers
    var j: i64 = 0
    while j < n {
        let xf = if x_range == 0.0 { 0.0 } else { (xs[j] - xmin) / x_range }
        let yf = if y_range == 0.0 { 0.0 } else { (ys[j] - ymin) / y_range }

        let px = config.margin + (xf * (plot_w as f64)) as i64
        let py = out.height - config.margin - 1 - (yf * (plot_h as f64)) as i64

        out = draw_cross(out, px, py, config.marker_size, config.marker_color)
        j = j + 1
    }
    out
}

// Draw a small cross marker at (x,y) with given half-arm length.
fn draw_cross(s: Surface, x: i64, y: i64, half: i64, c: Color) -> Surface with Mut, Panic, Div {
    var out = s
    out = surface_draw_line(out, x - half, y, x + half, y, c)
    out = surface_draw_line(out, x, y - half, x, y + half, c)
    out
}

fn main() -> i32 with IO { 0 }
