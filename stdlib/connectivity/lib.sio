// connectivity — Functional connectivity analysis
//
// Correlation-based connectivity matrices, graph-theoretic network metrics,
// and phase synchronization measures for neuroimaging and systems biology.
//
// Submodules:
//   connectivity     — Pearson/partial correlation matrices (ConnMatrix)
//   network_metrics  — Centrality, clustering, path length, modularity (with uncertainty)
//   phase            — PLV, PLI, wPLI phase synchronization measures

pub use connectivity::{
    ConnMatrix,
    conn_matrix_new,
    conn_pearson,
    conn_partial,
}

// network_metrics — types: MetricValue, NodeMetrics, GlobalMetrics
// Key fns: metric_value_new, threshold_matrix, floyd_warshall,
//   degree_binary, strength_weighted, degree_with_uncertainty,
//   network_density, characteristic_path_length, global_efficiency,
//   clustering_coefficient_node, clustering_coefficient_weighted

// phase — types: ConnectivityMatrix
// Key fns: phase_locking_value, phase_lag_index, weighted_phase_lag_index,
//   debiased_wpli, hilbert_transform, instantaneous_phase,
//   connectivity_matrix_new, mean_connectivity
