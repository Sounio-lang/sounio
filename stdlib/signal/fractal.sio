// signal::fractal — Fractal Dimension and Complexity Analysis
//
// Nonlinear dynamics measures for biosignal complexity.
// Essential for computational psychiatry: altered complexity in psychiatric disorders.
//
// Methods:
// - Higuchi Fractal Dimension (HFD): Time-domain complexity
// - Detrended Fluctuation Analysis (DFA): Long-range correlations
// - Permutation Entropy: Ordinal pattern complexity
//
// References:
// - Higuchi (1988): "Approach to an irregular time series..."
// - Peng et al. (1994): "Mosaic organization of DNA nucleotides"
// - Bandt & Pompe (2002): "Permutation entropy: A natural complexity measure"
//
// Note: higuchi_fd and dfa are fully self-contained (no helper calls)
// to avoid BSS aliasing in the native backend when called from nested contexts.

extern "C" {
    fn sqrt(x: f64) -> f64;
    fn log(x: f64) -> f64;
    fn pow(x: f64, y: f64) -> f64;
}

// ============================================================================
// HIGUCHI FRACTAL DIMENSION
// ============================================================================

// Compute Higuchi Fractal Dimension
// signal: input time series (only first n elements used)
// n: signal length
// k_max: maximum k value (typically 8-64)
// Returns: (HFD, R² of linear fit)
pub fn higuchi_fd(signal: [f64; 1024], n: i64, k_max: i64) -> (f64, f64) with Mut, Div, Panic {
    if n < 10 || k_max < 2 {
        return (0.0, 0.0)
    }

    var log_k: [f64; 64] = [0.0; 64]
    var log_L: [f64; 64] = [0.0; 64]
    var n_points: i64 = 0

    var k: i64 = 1
    while k <= k_max && k < n / 4 {
        var L_avg = 0.0
        var m: i64 = 1
        while m <= k {
            // Inlined curve length: L_m(k) = (N-1)/(n_terms*k^2) * sum|X(m+i*k)-X(m+(i-1)*k)|
            let n_terms = (n - m) / k
            if n_terms > 0 {
                var curve_sum = 0.0
                var ii: i64 = 1
                while ii <= n_terms {
                    let idx1 = m + ii * k - 1
                    let idx2 = m + (ii - 1) * k - 1
                    if idx1 < n && idx2 < n {
                        let d = signal[idx1] - signal[idx2]
                        curve_sum = curve_sum + if d < 0.0 { 0.0 - d } else { d }
                    }
                    ii = ii + 1
                }
                let norm = ((n - 1) as f64) / ((n_terms * k) as f64)
                L_avg = L_avg + curve_sum * norm / (k as f64)
            }
            m = m + 1
        }
        L_avg = L_avg / (k as f64)

        if L_avg > 0.0 {
            log_k[n_points] = log(k as f64)
            log_L[n_points] = log(L_avg)
            n_points = n_points + 1
        }

        k = k + 1
    }

    if n_points < 3 {
        return (0.0, 0.0)
    }

    // Inlined linear regression: log(L) = -D*log(k) + c, so D = -slope
    var sx = 0.0
    var sy = 0.0
    var sxx = 0.0
    var sxy = 0.0
    var syy = 0.0
    var j: i64 = 0
    while j < n_points {
        sx = sx + log_k[j]
        sy = sy + log_L[j]
        sxx = sxx + log_k[j] * log_k[j]
        sxy = sxy + log_k[j] * log_L[j]
        syy = syy + log_L[j] * log_L[j]
        j = j + 1
    }
    let nf = n_points as f64
    let denom = nf * sxx - sx * sx
    if denom == 0.0 {
        return (0.0, 0.0)
    }
    let slope = (nf * sxy - sx * sy) / denom
    let intercept = (sy - slope * sx) / nf
    let ss_tot = syy - sy * sy / nf
    let ss_res = syy - slope * sxy - intercept * sy
    let r2 = if ss_tot > 0.0 { 1.0 - ss_res / ss_tot } else { 0.0 }

    return (0.0 - slope, r2)
}

// ============================================================================
// DETRENDED FLUCTUATION ANALYSIS (DFA)
// ============================================================================

// DFA configuration
pub struct DFAConfig {
    min_box: i64,
    max_box: i64,
    n_boxes: i64,
}

pub fn dfa_config_default() -> DFAConfig {
    DFAConfig { min_box: 4, max_box: 256, n_boxes: 20 }
}

// Interpret DFA alpha value
// Returns: 0=white noise, 1=pink noise/1/f, 2=Brownian, 3=anti-correlated
pub fn dfa_interpret(alpha: f64) -> i32 {
    if alpha < 0.5 { 3 }
    else if alpha < 0.65 { 0 }
    else if alpha < 1.15 { 1 }
    else { 2 }
}

// Compute DFA scaling exponent
// Fully self-contained: integrates signal, computes fluctuations, runs regression
// Returns: (alpha, R²)
pub fn dfa(signal: [f64; 1024], n: i64, config: DFAConfig) -> (f64, f64) with Mut, Div, Panic {
    if n < config.max_box {
        return (0.0, 0.0)
    }

    // Step 1: Integrate signal (cumulative sum of deviations from mean)
    var integrated: [f64; 1024] = [0.0; 1024]
    var mean_sum = 0.0
    var ii: i64 = 0
    while ii < n {
        mean_sum = mean_sum + signal[ii]
        ii = ii + 1
    }
    let sig_mean = mean_sum / (n as f64)
    var cumsum = 0.0
    ii = 0
    while ii < n {
        cumsum = cumsum + signal[ii] - sig_mean
        integrated[ii] = cumsum
        ii = ii + 1
    }

    // Step 2: Compute fluctuations for log-spaced box sizes
    var log_n: [f64; 64] = [0.0; 64]
    var log_F: [f64; 64] = [0.0; 64]
    var n_pts: i64 = 0

    let lmin = log(config.min_box as f64)
    let lmax = log(config.max_box as f64)
    let lstep = (lmax - lmin) / ((config.n_boxes - 1) as f64)

    var bi: i64 = 0
    while bi < config.n_boxes {
        let bs = pow(2.718281828, lmin + (bi as f64) * lstep) as i64

        if bs >= 4 && bs <= n / 4 {
            let nb = n / bs
            if nb > 0 {
                var total_var = 0.0
                var bj: i64 = 0
                while bj < nb {
                    let start = bj * bs
                    // Inline detrend_box_variance: fit linear trend and get residual variance
                    var bsx = 0.0
                    var bsy = 0.0
                    var bsxx = 0.0
                    var bsxy = 0.0
                    var di: i64 = 0
                    while di < bs {
                        let xv = di as f64
                        let yv = integrated[start + di]
                        bsx = bsx + xv
                        bsy = bsy + yv
                        bsxx = bsxx + xv * xv
                        bsxy = bsxy + xv * yv
                        di = di + 1
                    }
                    let bnf = bs as f64
                    let bdn = bnf * bsxx - bsx * bsx
                    if bdn != 0.0 {
                        let bv = (bnf * bsxy - bsx * bsy) / bdn
                        let av = (bsy - bv * bsx) / bnf
                        var sq = 0.0
                        di = 0
                        while di < bs {
                            let res = integrated[start + di] - av - bv * (di as f64)
                            sq = sq + res * res
                            di = di + 1
                        }
                        total_var = total_var + sq / bnf
                    }
                    bj = bj + 1
                }
                let fluct = sqrt(total_var / (nb as f64))
                if fluct > 0.0 {
                    log_n[n_pts] = log(bs as f64)
                    log_F[n_pts] = log(fluct)
                    n_pts = n_pts + 1
                }
            }
        }
        bi = bi + 1
    }

    if n_pts < 3 {
        return (0.0, 0.0)
    }

    // Step 3: Inlined linear regression: log(F) = alpha*log(n) + c
    var rx = 0.0
    var ry = 0.0
    var rxx = 0.0
    var rxy = 0.0
    var rj: i64 = 0
    while rj < n_pts {
        rx = rx + log_n[rj]
        ry = ry + log_F[rj]
        rxx = rxx + log_n[rj] * log_n[rj]
        rxy = rxy + log_n[rj] * log_F[rj]
        rj = rj + 1
    }
    let rnf = n_pts as f64
    let rdenom = rnf * rxx - rx * rx
    if rdenom == 0.0 {
        return (0.0, 0.0)
    }
    let rslope = (rnf * rxy - rx * ry) / rdenom

    return (rslope, 1.0)
}

// ============================================================================
// PERMUTATION ENTROPY
// ============================================================================

// Factorial (up to 7! = 5040)
fn factorial(n: i64) -> i64 {
    if n <= 1 { 1 }
    else { n * factorial(n - 1) }
}

// Encode permutation pattern to index (0 to m!-1)
fn encode_permutation(pattern: [i64; 7], m: i64) -> i64 with Mut, Div {
    var code: i64 = 0
    var fact = factorial(m - 1)

    var i: i64 = 0
    while i < m - 1 {
        var count: i64 = 0
        var j = i + 1
        while j < m {
            if pattern[j] < pattern[i] {
                count = count + 1
            }
            j = j + 1
        }
        code = code + count * fact
        if m - 1 - i > 0 {
            fact = fact / (m - 1 - i)
        }
        i = i + 1
    }
    return code
}

// Compute Permutation Entropy
// m: embedding dimension (typically 3-7)
// tau: time delay (typically 1)
pub fn permutation_entropy(signal: [f64; 1024], n: i64, m: i64, tau: i64) -> f64 with Mut, Div, Panic {
    if m > 7 || n < (m - 1) * tau + 1 {
        return 0.0
    }

    let n_patterns = factorial(m)
    var counts: [i64; 5040] = [0; 5040]
    var total: i64 = 0

    var i: i64 = 0
    while i <= n - (m - 1) * tau - 1 {
        var values: [f64; 7] = [0.0; 7]
        var indices: [i64; 7] = [0; 7]
        var j: i64 = 0
        while j < m {
            values[j] = signal[i + j * tau]
            indices[j] = j
            j = j + 1
        }

        // Insertion sort indices by values
        var s: i64 = 1
        while s < m {
            let key = indices[s]
            let key_val = values[indices[s]]
            var t: i64 = s - 1
            while t >= 0 && values[indices[t]] > key_val {
                indices[t + 1] = indices[t]
                t = t - 1
            }
            indices[t + 1] = key
            s = s + 1
        }

        let pattern_idx = encode_permutation(indices, m)
        if pattern_idx >= 0 && pattern_idx < n_patterns {
            counts[pattern_idx] = counts[pattern_idx] + 1
            total = total + 1
        }
        i = i + 1
    }

    if total == 0 {
        return 0.0
    }

    var entropy = 0.0
    var p: i64 = 0
    while p < n_patterns {
        if counts[p] > 0 {
            let prob = (counts[p] as f64) / (total as f64)
            entropy = entropy + prob * log(prob)
        }
        p = p + 1
    }
    entropy = 0.0 - entropy

    let max_entropy = log(n_patterns as f64)
    if max_entropy > 0.0 {
        return entropy / max_entropy
    } else {
        return 0.0
    }
}

// ============================================================================
// LINEAR REGRESSION HELPER
// ============================================================================

// Simple linear regression: y = a + b*x
// Returns: (slope, intercept, R²)
pub fn linear_regression(x: [f64; 64], y: [f64; 64], n: i64) -> (f64, f64, f64) with Mut, Div {
    var sum_x = 0.0
    var sum_y = 0.0
    var sum_xx = 0.0
    var sum_xy = 0.0
    var sum_yy = 0.0

    var i: i64 = 0
    while i < n {
        sum_x = sum_x + x[i]
        sum_y = sum_y + y[i]
        sum_xx = sum_xx + x[i] * x[i]
        sum_xy = sum_xy + x[i] * y[i]
        sum_yy = sum_yy + y[i] * y[i]
        i = i + 1
    }

    let nf = n as f64
    let denom = nf * sum_xx - sum_x * sum_x

    if denom == 0.0 {
        return (0.0, 0.0, 0.0)
    }

    let slope = (nf * sum_xy - sum_x * sum_y) / denom
    let intercept = (sum_y - slope * sum_x) / nf

    let ss_tot = sum_yy - sum_y * sum_y / nf
    let ss_res = sum_yy - slope * sum_xy - intercept * sum_y

    let r_squared = if ss_tot > 0.0 { 1.0 - ss_res / ss_tot } else { 0.0 }

    return (slope, intercept, r_squared)
}
