//@ run-pass
//@ expect-stdout: ALL PASS

// stdlib/signal/fractal.sio — Fractal Dimension and Complexity Analysis
//
// Higuchi Fractal Dimension (HFD): time-domain complexity via curve-length scaling
// Detrended Fluctuation Analysis (DFA): long-range correlation exponent
// Permutation Entropy (PE): ordinal pattern diversity (order m ≤ 6)
// All functions operate on fixed-size [f64; 1024] buffers with explicit length n.

// ============================================================================
// MATH HELPERS
// ============================================================================

fn frc_abs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

fn frc_sqrt(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y
}

// Natural log via identity: ln(x) = 2*arctanh((x-1)/(x+1))
// arctanh(t) = t + t³/3 + t⁵/5 + ... converges for |t| < 1
fn frc_log(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 - 1e15 }
    // Reduce x to [1, 2) by factoring out powers of 2
    var v = x
    var exp2: i64 = 0
    while v >= 2.0 { v = v * 0.5; exp2 = exp2 + 1 }
    while v < 1.0 { v = v * 2.0; exp2 = exp2 - 1 }
    // ln(x) = exp2 * ln(2) + ln(v), v in [1, 2)
    let ln2 = 0.6931471805599453
    // t = (v-1)/(v+1) in [0, 1/3)
    let t = (v - 1.0) / (v + 1.0)
    let t2 = t * t
    // arctanh(t) = t(1 + t²/3 + t⁴/5 + t⁶/7 + t⁸/9 + t¹⁰/11 + t¹²/13)
    let series = t * (1.0 + t2 * (1.0 / 3.0 + t2 * (1.0 / 5.0 + t2 * (1.0 / 7.0 + t2 * (1.0 / 9.0 + t2 * (1.0 / 11.0 + t2 / 13.0))))))
    let ln_v = 2.0 * series
    (exp2 as f64) * ln2 + ln_v
}

// ============================================================================
// HIGUCHI FRACTAL DIMENSION
// ============================================================================

// HFD measures slope of log(L(k)) vs log(k); steep slope → complex signal.
// signal[0..n-1]: input, k_max: max scale (typ 8–32), returns (HFD, R²)
pub fn higuchi_fd(signal: &[f64; 1024], n: i64, k_max: i64) -> f64 with Mut, Div, Panic {
    if n < 10 || k_max < 2 { return 0.0 }
    var log_k: [f64; 64] = [0.0; 64]
    var log_L: [f64; 64] = [0.0; 64]
    var n_pts: i64 = 0
    var k: i64 = 1
    while k <= k_max && k <= n / 4 {
        var L_sum: f64 = 0.0
        var m: i64 = 1
        while m <= k {
            let n_terms = (n - m) / k
            if n_terms > 0 {
                var curve: f64 = 0.0
                var ii: i64 = 1
                while ii <= n_terms {
                    let idx1 = m + ii * k - 1
                    let idx2 = m + (ii - 1) * k - 1
                    if idx1 < n && idx2 < n {
                        curve = curve + frc_abs(signal[idx1] - signal[idx2])
                    }
                    ii = ii + 1
                }
                let norm = (n - 1) as f64 / ((n_terms as f64) * (k as f64) * (k as f64))
                L_sum = L_sum + curve * norm
            }
            m = m + 1
        }
        let L_k = L_sum / (k as f64)
        if L_k > 0.0 {
            log_k[n_pts] = frc_log(k as f64)
            log_L[n_pts] = frc_log(L_k)
            n_pts = n_pts + 1
        }
        k = k + 1
    }
    if n_pts < 2 { return 0.0 }
    // Ordinary least-squares slope of log_L vs log_k
    var sum_x: f64 = 0.0
    var sum_y: f64 = 0.0
    var i: i64 = 0
    while i < n_pts { sum_x = sum_x + log_k[i]; sum_y = sum_y + log_L[i]; i = i + 1 }
    let mx = sum_x / (n_pts as f64)
    let my = sum_y / (n_pts as f64)
    var sxy: f64 = 0.0
    var sxx: f64 = 0.0
    var j: i64 = 0
    while j < n_pts {
        let dx = log_k[j] - mx
        sxy = sxy + dx * (log_L[j] - my)
        sxx = sxx + dx * dx
        j = j + 1
    }
    if sxx < 1e-15 { return 0.0 }
    // Slope is negative (L decreases with k); FD = -slope
    0.0 - sxy / sxx
}

// ============================================================================
// PERMUTATION ENTROPY
// ============================================================================

// Order-m PE; m ≤ 6 (6! = 720 patterns fit in [i64; 720])
// Counts ordinal patterns of length m in the signal.
// Returns normalized PE in [0, 1].
pub fn permutation_entropy(signal: &[f64; 1024], n: i64, m: i64) -> f64 with Mut, Div, Panic {
    if m < 2 || m > 6 || n < m + 1 { return 0.0 }
    // Compute ordinal rank pattern index for each embedding
    // Pattern index: encode sort-order of m elements as base-m factorial number
    var counts: [i64; 720] = [0; 720]
    var idx: [i64; 6] = [0; 6]
    var total: i64 = 0
    var i: i64 = 0
    while i < n - m + 1 {
        // Compute rank-order of signal[i..i+m]
        // rank[j] = number of elements in window less than signal[i+j]
        var r: i64 = 0
        var q: i64 = 0
        while q < m {
            let val = signal[i + q]
            var rank: i64 = 0
            var p: i64 = 0
            while p < m {
                if p != q && signal[i + p] < val { rank = rank + 1 }
                p = p + 1
            }
            idx[q] = rank
            q = q + 1
        }
        // Convert rank vector to a single integer index via factoradic encoding
        // Simple approach: encode as mixed-radix number (not full factoradic, but bijective for distinct ranks)
        var pattern: i64 = 0
        var fac: i64 = 1
        var k: i64 = m - 1
        while k >= 0 {
            pattern = pattern + idx[k] * fac
            fac = fac * (m - k)
            k = k - 1
        }
        if pattern >= 0 && pattern < 720 {
            counts[pattern] = counts[pattern] + 1
        }
        total = total + 1
        i = i + 1
    }
    if total == 0 { return 0.0 }
    // Compute Shannon entropy
    var entropy: f64 = 0.0
    var p: i64 = 0
    while p < 720 {
        if counts[p] > 0 {
            let prob = (counts[p] as f64) / (total as f64)
            entropy = entropy - prob * frc_log(prob)
        }
        p = p + 1
    }
    // Normalize by log(m!) = max entropy
    var max_fac: i64 = 1
    var f: i64 = 1
    while f <= m { max_fac = max_fac * f; f = f + 1 }
    let max_ent = frc_log(max_fac as f64)
    if max_ent < 1e-15 { return 0.0 }
    entropy / max_ent
}

// ============================================================================
// DETRENDED FLUCTUATION ANALYSIS (DFA)
// ============================================================================

// Alpha exponent from slope of log(F(s)) vs log(s).
// 0.5 = uncorrelated (white noise), 1.0 = 1/f noise, 1.5 = Brownian motion.
pub fn dfa(signal: &[f64; 1024], n: i64) -> f64 with Mut, Div, Panic {
    if n < 16 { return 0.5 }
    // Compute cumulative sum profile
    var profile: [f64; 1024] = [0.0; 1024]
    var mean: f64 = 0.0
    var i: i64 = 0
    while i < n { mean = mean + signal[i]; i = i + 1 }
    mean = mean / (n as f64)
    var cum: f64 = 0.0
    var j: i64 = 0
    while j < n {
        cum = cum + (signal[j] - mean)
        profile[j] = cum
        j = j + 1
    }
    // Compute F(s) for scales s = 4, 8, 16, 32, 64
    var log_s: [f64; 8] = [0.0; 8]
    var log_F: [f64; 8] = [0.0; 8]
    var n_scales: i64 = 0
    var s: i64 = 4
    while s <= n / 4 && n_scales < 8 {
        let n_segs = n / s
        if n_segs < 1 { s = s * 2; }
        if n_segs >= 1 {
            var rms_sum: f64 = 0.0
            var seg: i64 = 0
            while seg < n_segs {
                let seg_start = seg * s
                // Linear detrend: fit y = a*t + b to profile[seg_start..seg_start+s]
                var sx: f64 = 0.0
                var sy: f64 = 0.0
                var sxy2: f64 = 0.0
                var sxx2: f64 = 0.0
                var t: i64 = 0
                while t < s {
                    let tf = t as f64
                    sx = sx + tf
                    sy = sy + profile[seg_start + t]
                    sxy2 = sxy2 + tf * profile[seg_start + t]
                    sxx2 = sxx2 + tf * tf
                    t = t + 1
                }
                let sf = s as f64
                let denom = sf * sxx2 - sx * sx
                var a: f64 = 0.0
                var b: f64 = 0.0
                if frc_abs(denom) > 1e-15 {
                    a = (sf * sxy2 - sx * sy) / denom
                    b = (sy - a * sx) / sf
                }
                var mse: f64 = 0.0
                var u: i64 = 0
                while u < s {
                    let trend = a * (u as f64) + b
                    let res = profile[seg_start + u] - trend
                    mse = mse + res * res
                    u = u + 1
                }
                rms_sum = rms_sum + mse / (s as f64)
                seg = seg + 1
            }
            let F_s = frc_sqrt(rms_sum / (n_segs as f64))
            if F_s > 0.0 {
                log_s[n_scales] = frc_log(s as f64)
                log_F[n_scales] = frc_log(F_s)
                n_scales = n_scales + 1
            }
        }
        s = s * 2
    }
    if n_scales < 2 { return 0.5 }
    var sum_x2: f64 = 0.0
    var sum_y2: f64 = 0.0
    var k: i64 = 0
    while k < n_scales { sum_x2 = sum_x2 + log_s[k]; sum_y2 = sum_y2 + log_F[k]; k = k + 1 }
    let mx2 = sum_x2 / (n_scales as f64)
    let my2 = sum_y2 / (n_scales as f64)
    var sxy2: f64 = 0.0
    var sxx2: f64 = 0.0
    var q: i64 = 0
    while q < n_scales {
        let dx = log_s[q] - mx2
        sxy2 = sxy2 + dx * (log_F[q] - my2)
        sxx2 = sxx2 + dx * dx
        q = q + 1
    }
    if sxx2 < 1e-15 { return 0.5 }
    sxy2 / sxx2
}

// ============================================================================
// TESTS
// ============================================================================

var CNT: [i64; 2] = [0; 2]

fn chk(label: i64, ok: i64) with IO, Mut {
    if ok == 1 {
        print("  PASS ["); print(label); print("]\n")
        CNT[0] = CNT[0] + 1
    } else {
        print("  FAIL ["); print(label); print("]\n")
        CNT[1] = CNT[1] + 1
    }
}

fn near(a: f64, b: f64, tol: f64) -> i64 {
    let d = a - b
    let d2 = if d < 0.0 { 0.0 - d } else { d }
    if d2 <= tol { 1 } else { 0 }
}

fn test_log() with IO, Mut, Div, Panic {
    // ln(1) = 0
    chk(1, near(frc_log(1.0), 0.0, 1e-10))
    // ln(e) ≈ 1 (e ≈ 2.71828)
    chk(2, near(frc_log(2.71828182845905), 1.0, 1e-6))
    // ln(2) ≈ 0.6931
    chk(3, near(frc_log(2.0), 0.6931471805599453, 1e-8))
    // ln(100) = ln(4) + ln(25) ≈ 4.605
    chk(4, near(frc_log(100.0), 4.605170185988092, 1e-6))
}

fn test_higuchi() with IO, Mut, Div, Panic {
    // Constant signal → HFD ≈ 0 (flat, minimum complexity)
    var flat: [f64; 1024] = [0.0; 1024]
    var i: i64 = 0
    while i < 128 { flat[i] = 1.0; i = i + 1 }
    let hfd_flat = higuchi_fd(&flat, 128, 8)
    chk(5, if frc_abs(hfd_flat) < 1.0 { 1 } else { 0 })

    // Linear ramp → HFD ≈ 1.0 (smooth, single-scale)
    var ramp: [f64; 1024] = [0.0; 1024]
    var j: i64 = 0
    while j < 128 { ramp[j] = j as f64; j = j + 1 }
    let hfd_ramp = higuchi_fd(&ramp, 128, 8)
    chk(6, if hfd_ramp > 0.5 && hfd_ramp < 1.5 { 1 } else { 0 })

    // Pseudo-random (LCG) signal → high HFD > ramp HFD
    var noise: [f64; 1024] = [0.0; 1024]
    var lcg: i64 = 1234567
    var k: i64 = 0
    while k < 128 {
        lcg = (lcg * 1664525 + 1013904223) - (lcg * 1664525 + 1013904223) / 1000000000 * 1000000000
        noise[k] = (lcg as f64) / 500000000.0 - 1.0
        k = k + 1
    }
    let hfd_noise = higuchi_fd(&noise, 128, 8)
    // Pseudo-random signal should have higher FD than a smooth ramp
    chk(7, if hfd_noise > hfd_ramp { 1 } else { 0 })
}

fn test_pe() with IO, Mut, Div, Panic {
    // Constant signal → only one pattern → PE = 0
    var flat: [f64; 1024] = [0.0; 1024]
    var i: i64 = 0
    while i < 64 { flat[i] = 5.0; i = i + 1 }
    let pe_flat = permutation_entropy(&flat, 64, 3)
    chk(8, near(pe_flat, 0.0, 0.01))

    // Monotone increasing → PE = 0 (only one ordinal pattern)
    var ramp: [f64; 1024] = [0.0; 1024]
    var j: i64 = 0
    while j < 64 { ramp[j] = j as f64; j = j + 1 }
    let pe_ramp = permutation_entropy(&ramp, 64, 3)
    chk(9, near(pe_ramp, 0.0, 0.01))

    // Mixed signal → PE > 0
    var mixed: [f64; 1024] = [0.0; 1024]
    var k: i64 = 0
    while k < 64 {
        // Cycle through 4 values to get mixed ordinal patterns
        let r = k - (k / 4) * 4
        mixed[k] = if r == 0 { 1.0 } else if r == 1 { 3.0 } else if r == 2 { 2.0 } else { 4.0 }
        k = k + 1
    }
    let pe_mixed = permutation_entropy(&mixed, 64, 3)
    chk(10, if pe_mixed > 0.3 { 1 } else { 0 })
}

fn test_dfa() with IO, Mut, Div, Panic {
    // White noise (alternating ±1) → DFA exponent ≈ 0.5
    var wn: [f64; 1024] = [0.0; 1024]
    var i: i64 = 0
    while i < 512 {
        wn[i] = if (i - i / 2 * 2) == 0 { 1.0 } else { 0.0 - 1.0 }
        i = i + 1
    }
    let alpha_wn = dfa(&wn, 512)
    // For purely alternating signal, DFA exponent should be < 1
    chk(11, if alpha_wn < 1.2 { 1 } else { 0 })

    // Linear ramp (cumulative DC) → DFA exponent should be > 1 (strong correlations)
    var rw: [f64; 1024] = [0.0; 1024]
    var j: i64 = 0
    while j < 256 { rw[j] = j as f64; j = j + 1 }
    let alpha_rw = dfa(&rw, 256)
    chk(12, if alpha_rw > 1.0 { 1 } else { 0 })
}

pub fn main() -> i32 with IO, Mut, Div, Panic {
    CNT[0] = 0; CNT[1] = 0
    print("─── stdlib/signal/fractal tests ───\n")
    test_log()
    test_higuchi()
    test_pe()
    test_dfa()
    print("─── "); print(CNT[0]); print("/"); print(CNT[0]+CNT[1]); print(" PASS ───\n")
    if CNT[1] == 0 { print("ALL PASS\n"); 0 } else { 1 }
}
