// signal — Digital signal processing for biosignal analysis
//
// FFT, digital filters, spectral analysis, wavelet transforms, fractal complexity,
// and event-locked epoching for EEG/ERP and time-series data.
//
// Submodules:
//   fft       — Radix-2 FFT with GUM epistemic uncertainty propagation
//   filter    — IIR/FIR digital filters (Butterworth, Chebyshev, notch, bandpass)
//   spectral  — PSD estimation: periodogram, Welch, EEG band power
//   wavelets  — Discrete wavelet transform (Haar, db4) + thresholding denoising
//   fractal   — Higuchi FD, DFA, permutation entropy for complexity analysis
//   epoch     — Event-locked segmentation with baseline correction and artifact rejection

pub use fft::{
    ComplexArray, EpistemicSpectrum,
    complex_array_new, complex_array_from_real,
    fft_forward, fft_inverse,
    fft_magnitude, fft_phase, fft_power_spectrum,
    fft_epistemic,
}
