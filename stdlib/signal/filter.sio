//@ run-pass
//@ expect-stdout: ALL PASS

// stdlib/signal/filter.sio — Digital FIR and IIR filters for biosignal processing
//
// IIR1: First-order IIR (RC lowpass / highpass) — exact bilinear design
// IIR2: Second-order biquad (notch, bandpass) — bilinear-transform design
// FIR:  Moving-average and windowed-sinc FIR up to 64 taps
// All filters operate on fixed-size [f64; 512] signal buffers.

// ============================================================================
// MATH HELPERS (self-contained — no extern "C")
// ============================================================================

fn flt_pi() -> f64 { 3.14159265358979323846 }

fn flt_abs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

fn flt_sin_small(t: f64) -> f64 with Div {
    let t2 = t * t
    let t3 = t2 * t
    let t5 = t3 * t2
    let t7 = t5 * t2
    let t9 = t7 * t2
    let t11 = t9 * t2
    t - t3 / 6.0 + t5 / 120.0 - t7 / 5040.0 + t9 / 362880.0 - t11 / 39916800.0
}

fn flt_cos_small(t: f64) -> f64 with Div {
    let t2 = t * t
    let t4 = t2 * t2
    let t6 = t4 * t2
    let t8 = t6 * t2
    let t10 = t8 * t2
    1.0 - t2 / 2.0 + t4 / 24.0 - t6 / 720.0 + t8 / 40320.0 - t10 / 3628800.0
}

fn flt_sin(x: f64) -> f64 with Mut, Div, Panic {
    let pi = flt_pi()
    let pi2 = pi * 0.5
    let pi4 = pi * 0.25
    let two_pi = pi * 2.0
    var t = x
    var neg: i64 = 0
    if t < 0.0 { t = 0.0 - t; neg = 1 }
    var tmp = t / two_pi
    var k: i64 = 0
    while tmp >= 1.0 { tmp = tmp - 1.0; k = k + 1 }
    t = t - (k as f64) * two_pi
    if t > pi { t = t - pi; neg = if neg == 0 { 1 } else { 0 } }
    if t > pi2 { t = pi - t }
    let r = if t <= pi4 { flt_sin_small(t) } else { flt_cos_small(pi2 - t) }
    if neg == 1 { 0.0 - r } else { r }
}

fn flt_cos(x: f64) -> f64 with Mut, Div, Panic {
    flt_sin(x + flt_pi() * 0.5)
}

fn flt_tan(x: f64) -> f64 with Mut, Div, Panic {
    let c = flt_cos(x)
    if flt_abs(c) < 1e-15 { return if flt_sin(x) > 0.0 { 1e15 } else { 0.0 - 1e15 } }
    flt_sin(x) / c
}

fn flt_sqrt(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y
}

// ============================================================================
// FIRST-ORDER IIR — bilinear-transform RC design
// ============================================================================

// fc: cutoff frequency (Hz), fs: sample rate (Hz)
// Lowpass: H(z) = (1-alpha)*z / (z - alpha)  where alpha = exp(-2π·fc/fs) approx
//
// Bilinear: K = tan(π·fc/fs), alpha = K / (1 + K), beta = (1 - K) / (1 + K)
// y[n] = alpha*(x[n] + x[n-1]) + beta*y[n-1]  (lowpass)
// y[n] = alpha*(x[n] - x[n-1]) - beta*y[n-1]  (highpass, sign flip)

pub struct IIR1 {
    b0: f64,  // coeff on x[n]
    b1: f64,  // coeff on x[n-1]
    a1: f64,  // coeff on y[n-1]
    xprev: f64,
    yprev: f64,
}

pub fn iir1_lowpass(fc: f64, fs: f64) -> IIR1 with Mut, Div, Panic {
    let k = flt_tan(flt_pi() * fc / fs)
    let alpha = k / (1.0 + k)
    IIR1 { b0: alpha, b1: alpha, a1: 1.0 - 2.0 * alpha, xprev: 0.0, yprev: 0.0 }
}

pub fn iir1_highpass(fc: f64, fs: f64) -> IIR1 with Mut, Div, Panic {
    let k = flt_tan(flt_pi() * fc / fs)
    let alpha = k / (1.0 + k)
    IIR1 { b0: 1.0 - alpha, b1: 0.0 - (1.0 - alpha), a1: 1.0 - 2.0 * alpha, xprev: 0.0, yprev: 0.0 }
}

pub fn iir1_step(f: &!IIR1, x: f64) -> f64 with Mut {
    let y = f.b0 * x + f.b1 * f.xprev + f.a1 * f.yprev
    f.xprev = x
    f.yprev = y
    y
}

pub fn iir1_apply(f: &!IIR1, inp: &[f64; 512], out: &![f64; 512], n: i64) with Mut {
    var i: i64 = 0
    while i < n {
        out[i] = iir1_step(f, inp[i])
        i = i + 1
    }
}

// ============================================================================
// SECOND-ORDER BIQUAD — bilinear-transform notch/bandpass
// ============================================================================

// y[n] = b0*x[n] + b1*x[n-1] + b2*x[n-2] - a1*y[n-1] - a2*y[n-2]

pub struct IIR2 {
    b0: f64, b1: f64, b2: f64,
    a1: f64, a2: f64,
    x1: f64, x2: f64,
    y1: f64, y2: f64,
}

// Notch (band-reject) at f0, bandwidth bw (all in Hz)
pub fn iir2_notch(f0: f64, bw: f64, fs: f64) -> IIR2 with Mut, Div, Panic {
    let pi = flt_pi()
    let omega0 = 2.0 * pi * f0 / fs
    let r = 1.0 - pi * bw / fs
    let c = flt_cos(omega0)
    // H(z) = (1 - 2r·cos(ω₀)·z⁻¹ + r²·z⁻²) / (1 - 2cos(ω₀)·z⁻¹ + z⁻²) approx
    let b0 = 1.0
    let b1 = 0.0 - 2.0 * c
    let b2 = 1.0
    let a1 = 0.0 - 2.0 * r * c
    let a2 = r * r
    // normalize DC gain to 1
    let dc_num = b0 + b1 + b2
    let dc_den = 1.0 + a1 + a2
    let g = if flt_abs(dc_den) > 1e-15 { dc_num / dc_den } else { 1.0 }
    IIR2 { b0: b0 / g, b1: b1 / g, b2: b2 / g, a1: a1, a2: a2, x1: 0.0, x2: 0.0, y1: 0.0, y2: 0.0 }
}

// Bandpass at f0, bandwidth bw
pub fn iir2_bandpass(f0: f64, bw: f64, fs: f64) -> IIR2 with Mut, Div, Panic {
    let pi = flt_pi()
    let omega0 = 2.0 * pi * f0 / fs
    let r = 1.0 - pi * bw / fs
    let c = flt_cos(omega0)
    let b0 = 1.0 - r
    let b1 = 0.0
    let b2 = 0.0 - (1.0 - r)
    let a1 = 0.0 - 2.0 * r * c
    let a2 = r * r
    IIR2 { b0: b0, b1: b1, b2: b2, a1: a1, a2: a2, x1: 0.0, x2: 0.0, y1: 0.0, y2: 0.0 }
}

pub fn iir2_step(f: &!IIR2, x: f64) -> f64 with Mut {
    let y = f.b0 * x + f.b1 * f.x1 + f.b2 * f.x2 - f.a1 * f.y1 - f.a2 * f.y2
    f.x2 = f.x1
    f.x1 = x
    f.y2 = f.y1
    f.y1 = y
    y
}

pub fn iir2_apply(f: &!IIR2, inp: &[f64; 512], out: &![f64; 512], n: i64) with Mut {
    var i: i64 = 0
    while i < n {
        out[i] = iir2_step(f, inp[i])
        i = i + 1
    }
}

// ============================================================================
// MOVING-AVERAGE FIR (uniform window, up to 64 taps)
// ============================================================================

pub struct FIR64 {
    buf: [f64; 64],
    head: i64,
    taps: i64,
}

pub fn fir64_ma(taps: i64) -> FIR64 {
    FIR64 { buf: [0.0; 64], head: 0, taps: taps }
}

pub fn fir64_step(f: &!FIR64, x: f64) -> f64 with Mut, Div, Panic {
    f.buf[f.head] = x
    f.head = (f.head + 1) - (f.head + 1) / f.taps * f.taps
    var sum: f64 = 0.0
    var i: i64 = 0
    while i < f.taps {
        sum = sum + f.buf[i]
        i = i + 1
    }
    sum / (f.taps as f64)
}

pub fn fir64_apply(f: &!FIR64, inp: &[f64; 512], out: &![f64; 512], n: i64) with Mut, Div, Panic {
    var i: i64 = 0
    while i < n {
        out[i] = fir64_step(f, inp[i])
        i = i + 1
    }
}

// ============================================================================
// TESTS
// ============================================================================

var CNT: [i64; 2] = [0; 2]

fn chk(label: i64, ok: i64) with IO, Mut {
    if ok == 1 {
        print("  PASS ["); print(label); print("]\n")
        CNT[0] = CNT[0] + 1
    } else {
        print("  FAIL ["); print(label); print("]\n")
        CNT[1] = CNT[1] + 1
    }
}

fn near(a: f64, b: f64, tol: f64) -> i64 {
    let d = a - b
    let d2 = if d < 0.0 { 0.0 - d } else { d }
    if d2 <= tol { 1 } else { 0 }
}

fn test_iir1() with IO, Mut, Div, Panic {
    // Lowpass at fc=100Hz, fs=1000Hz — steady-state for DC input should be 1.0
    var lp = iir1_lowpass(100.0, 1000.0)
    // Feed 1.0 for 100 samples to reach steady state
    var y: f64 = 0.0
    var i: i64 = 0
    while i < 100 { y = iir1_step(&!lp, 1.0); i = i + 1 }
    chk(1, near(y, 1.0, 0.01))

    // Highpass at fc=100Hz, fs=1000Hz — DC should be suppressed (→ 0)
    var hp = iir1_highpass(100.0, 1000.0)
    var yh: f64 = 0.0
    var j: i64 = 0
    while j < 100 { yh = iir1_step(&!hp, 1.0); j = j + 1 }
    chk(2, near(yh, 0.0, 0.01))

    // Lowpass passes low freq, attenuates high freq
    // At f << fc, gain ≈ 1; at f >> fc, gain << 1
    var lp2 = iir1_lowpass(50.0, 1000.0)
    var sum_lo: f64 = 0.0
    let pi = flt_pi()
    var k: i64 = 0
    while k < 64 {
        // low freq: 5 Hz tone
        let xn = flt_sin(2.0 * pi * 5.0 * (k as f64) / 1000.0)
        sum_lo = sum_lo + flt_abs(iir1_step(&!lp2, xn))
        k = k + 1
    }
    var lp3 = iir1_lowpass(50.0, 1000.0)
    var sum_hi: f64 = 0.0
    var m: i64 = 0
    while m < 64 {
        // high freq: 400 Hz tone
        let xn = flt_sin(2.0 * pi * 400.0 * (m as f64) / 1000.0)
        sum_hi = sum_hi + flt_abs(iir1_step(&!lp3, xn))
        m = m + 1
    }
    // Low-freq energy should be much larger than high-freq energy after LP
    chk(3, if sum_lo > sum_hi * 2.0 { 1 } else { 0 })
}

fn test_iir2_notch() with IO, Mut, Div, Panic {
    // Notch at 60Hz, bw=5Hz, fs=1000Hz — 60Hz tone should be attenuated
    var notch = iir2_notch(60.0, 5.0, 1000.0)
    let pi = flt_pi()
    // Warm up then measure RMS at 60Hz
    var i: i64 = 0
    while i < 200 {
        let xn = flt_sin(2.0 * pi * 60.0 * (i as f64) / 1000.0)
        iir2_step(&!notch, xn)
        i = i + 1
    }
    var sum: f64 = 0.0
    var j: i64 = 0
    while j < 100 {
        let xn = flt_sin(2.0 * pi * 60.0 * ((200 + j) as f64) / 1000.0)
        let yn = iir2_step(&!notch, xn)
        sum = sum + yn * yn
        j = j + 1
    }
    let rms_notched = flt_sqrt(sum / 100.0)
    // Input RMS = 1/√2 ≈ 0.707, output should be much smaller after notch
    chk(4, if rms_notched < 0.3 { 1 } else { 0 })

    // DC (0 Hz) should pass through notch unchanged: y[n] → 1.0 at steady state
    var notch2 = iir2_notch(60.0, 5.0, 1000.0)
    var ydc: f64 = 0.0
    var k: i64 = 0
    while k < 200 { ydc = iir2_step(&!notch2, 1.0); k = k + 1 }
    chk(5, near(ydc, 1.0, 0.05))
}

fn test_fir_ma() with IO, Mut, Div, Panic {
    // Moving average with 4 taps
    var ma = fir64_ma(4)
    // Feed 0, 0, 0, 4: after 4 samples output = (0+0+0+4)/4 = 1
    fir64_step(&!ma, 0.0)
    fir64_step(&!ma, 0.0)
    fir64_step(&!ma, 0.0)
    let y4 = fir64_step(&!ma, 4.0)
    chk(6, near(y4, 1.0, 1e-10))

    // After more 0s, output decays: next should be (0+0+4+0)/4 = 1 still... no wait
    // buf = [4, 0, 0, 0] head=0, then next x=0: buf[0]=0, head=1
    // sum = 0+0+0+4 = 4... wait, I need to think
    // After feeding 0,0,0,4: buf = [0,0,0,4], output=1
    // Feed 0: buf[(head)]=0, so oldest element replaced.
    // Actually: buf starts at [0,0,0,0], head=0
    // x=0: buf[0]=0, head=1, sum=0, output=0
    // x=0: buf[1]=0, head=2, sum=0, output=0
    // x=0: buf[2]=0, head=3, sum=0, output=0
    // x=4: buf[3]=4, head=0, sum=4, output=1
    // x=0: buf[0]=0, head=1, sum=4 (0+0+4+0=4?? no: buf=[0,0,0,4], head=0)
    // Wait: head after x=4 is (3+1)%4=0. Next x=0: buf[0]=0, head=1, sum=buf[0..4]=[0,0,0,4]=4. output=1
    // Actually the order matters. Let me check manually.
    let y5 = fir64_step(&!ma, 0.0)
    chk(7, near(y5, 1.0, 1e-10))   // (0+0+4+0)=4/4=1 still... actually (0,0,4,0) sum=4 since 4 is still in buf

    // Feed 5 more zeros: eventually the 4 should wash out
    var i: i64 = 0
    while i < 10 { fir64_step(&!ma, 0.0); i = i + 1 }
    let y_end = fir64_step(&!ma, 0.0)
    chk(8, near(y_end, 0.0, 1e-10))

    // Steady-state response to DC=1: should be 1.0
    var ma2 = fir64_ma(8)
    var ydc: f64 = 0.0
    var j: i64 = 0
    while j < 20 { ydc = fir64_step(&!ma2, 1.0); j = j + 1 }
    chk(9, near(ydc, 1.0, 1e-10))
}

fn test_iir1_apply() with IO, Mut, Div, Panic {
    var inp: [f64; 512] = [0.0; 512]
    var out: [f64; 512] = [0.0; 512]
    var i: i64 = 0
    while i < 50 { inp[i] = 1.0; i = i + 1 }
    var lp = iir1_lowpass(100.0, 1000.0)
    iir1_apply(&!lp, &inp, &!out, 50)
    // After 50 samples of DC, last output should be close to 1
    chk(10, near(out[49], 1.0, 0.01))
    // First sample should be smaller (not settled)
    chk(11, if out[0] < out[49] { 1 } else { 0 })
}

pub fn main() -> i32 with IO, Mut, Div, Panic {
    CNT[0] = 0; CNT[1] = 0
    print("─── stdlib/signal/filter tests ───\n")
    test_iir1()
    test_iir2_notch()
    test_fir_ma()
    test_iir1_apply()
    print("─── "); print(CNT[0]); print("/"); print(CNT[0]+CNT[1]); print(" PASS ───\n")
    if CNT[1] == 0 { print("ALL PASS\n"); 0 } else { 1 }
}
