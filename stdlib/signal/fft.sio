//@ run-pass
//@ expect-stdout: ALL PASS

// stdlib/signal/fft.sio — Radix-2 Cooley-Tukey FFT (N ≤ 256, power of 2)
//
// ComplexArray holds split re/im arrays of fixed size 256. Avoids large-struct SRET:
// callers declare `var arr = ComplexArray {...}` and pass `&!arr` to init helpers.
// Forward and inverse (normalized) transforms operate in-place via &!ComplexArray.
//
// USAGE: import with `use signal::fft::*`. Construct a buffer in the caller's frame:
//   var arr = ComplexArray { re: [0.0; 256], im: [0.0; 256], n: 0 }
// then `ca_load_real(&!arr, &data, n)`, `fft_forward(&!arr)`, `fft_magnitude(&arr, &!out)`.
// (ComplexArray fields are pub so callers can declare one; pass by &! — never by value.)

// ============================================================================
// MATH HELPERS — accurate trig via octant reduction
// ============================================================================

pub fn fft_pi() -> f64 { 3.14159265358979323846 }

pub fn fft_sqrt(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y
}

// Sin Taylor for |t| ≤ π/4; error < 2e-9
fn fft_sin_small(t: f64) -> f64 with Div {
    let t2 = t * t
    let t3 = t2 * t
    let t5 = t3 * t2
    let t7 = t5 * t2
    let t9 = t7 * t2
    let t11 = t9 * t2
    t - t3 / 6.0 + t5 / 120.0 - t7 / 5040.0 + t9 / 362880.0 - t11 / 39916800.0
}

// Cos Taylor for |t| ≤ π/4; error < 2e-10
fn fft_cos_small(t: f64) -> f64 with Div {
    let t2 = t * t
    let t4 = t2 * t2
    let t6 = t4 * t2
    let t8 = t6 * t2
    let t10 = t8 * t2
    1.0 - t2 / 2.0 + t4 / 24.0 - t6 / 720.0 + t8 / 40320.0 - t10 / 3628800.0
}

// Full sin with range reduction to [-π/4, π/4]; accurate to ~1e-9 everywhere
pub fn fft_sin(x: f64) -> f64 with Mut, Div, Panic {
    let pi = fft_pi()
    let pi2 = pi * 0.5
    let pi4 = pi * 0.25
    let two_pi = pi * 2.0
    var t = x
    var neg: i64 = 0
    if t < 0.0 { t = 0.0 - t; neg = 1 }
    // strip whole 2π periods
    var cnt = t / two_pi
    while cnt >= 1.0 { cnt = cnt - 1.0 }
    var k: i64 = 0
    var tmp = t / two_pi
    while tmp >= 1.0 { tmp = tmp - 1.0; k = k + 1 }
    t = t - (k as f64) * two_pi
    // t in [0, 2π)
    if t > pi { t = t - pi; neg = if neg == 0 { 1 } else { 0 } }
    // t in [0, π)
    if t > pi2 { t = pi - t }
    // t in [0, π/2]
    var result: f64 = 0.0
    if t <= pi4 {
        result = fft_sin_small(t)
    } else {
        result = fft_cos_small(pi2 - t)
    }
    if neg == 1 { 0.0 - result } else { result }
}

pub fn fft_cos(x: f64) -> f64 with Mut, Div, Panic {
    fft_sin(x + fft_pi() * 0.5)
}

fn fft_atan2(y: f64, x: f64) -> f64 with Mut, Div, Panic {
    let pi = fft_pi()
    let pi2 = pi * 0.5
    let abs_y = if y < 0.0 { 0.0 - y } else { y }
    let abs_x = if x < 0.0 { 0.0 - x } else { x }
    if x == 0.0 && y == 0.0 { return 0.0 }
    var ang: f64 = 0.0
    if abs_x >= abs_y {
        let r = y / x
        let r2 = r * r
        // atan(r) via minimax for |r| ≤ 1
        ang = r * (1.0 - r2 * (1.0 / 3.0 - r2 * (1.0 / 5.0 - r2 * (1.0 / 7.0))))
        if x < 0.0 {
            if y >= 0.0 { ang = ang + pi } else { ang = ang - pi }
        }
    } else {
        let r = x / y
        let r2 = r * r
        ang = r * (1.0 - r2 * (1.0 / 3.0 - r2 * (1.0 / 5.0 - r2 * (1.0 / 7.0))))
        if y > 0.0 { ang = pi2 - ang } else { ang = (0.0 - pi2) - ang }
    }
    ang
}

// ============================================================================
// BIT-REVERSAL AND LOG2
// ============================================================================

fn fft_log2(n: i64) -> i64 with Mut, Div, Panic {
    var bits: i64 = 0
    var v = n
    while v > 1 { v = v / 2; bits = bits + 1 }
    bits
}

fn fft_bit_reverse(v: i64, bits: i64) -> i64 with Mut {
    var result: i64 = 0
    var x = v
    var i: i64 = 0
    while i < bits {
        result = (result * 2) + (x - (x / 2) * 2)
        x = x / 2
        i = i + 1
    }
    result
}

// ============================================================================
// COMPLEX ARRAY — pass by reference to avoid large-struct SRET (4104 bytes)
// ============================================================================

pub struct ComplexArray {
    pub re: [f64; 256],
    pub im: [f64; 256],
    pub n: i64,
}

pub fn ca_load_real(arr: &!ComplexArray, data: &[f64; 256], n: i64) with Mut {
    arr.n = n
    var i: i64 = 0
    while i < n {
        arr.re[i] = data[i]
        arr.im[i] = 0.0
        i = i + 1
    }
}

pub fn ca_clear(arr: &!ComplexArray, n: i64) with Mut {
    arr.n = n
    var i: i64 = 0
    while i < n {
        arr.re[i] = 0.0
        arr.im[i] = 0.0
        i = i + 1
    }
}

// ============================================================================
// FFT CORE — in-place Cooley-Tukey DIT radix-2
// ============================================================================

pub fn fft_forward(arr: &!ComplexArray) with Mut, Div, Panic {
    let n = arr.n
    let bits = fft_log2(n)
    var i: i64 = 0
    while i < n {
        let j = fft_bit_reverse(i, bits)
        if j > i {
            let tmp_re = arr.re[i]
            let tmp_im = arr.im[i]
            arr.re[i] = arr.re[j]
            arr.im[i] = arr.im[j]
            arr.re[j] = tmp_re
            arr.im[j] = tmp_im
        }
        i = i + 1
    }
    var size: i64 = 2
    while size <= n {
        let half = size / 2
        let angle_step = (0.0 - 2.0) * fft_pi() / (size as f64)
        var k: i64 = 0
        while k < n {
            var j: i64 = 0
            while j < half {
                let angle = angle_step * (j as f64)
                let w_re = fft_cos(angle)
                let w_im = fft_sin(angle)
                let idx1 = k + j
                let idx2 = k + j + half
                let u_re = arr.re[idx1]
                let u_im = arr.im[idx1]
                let v_re = arr.re[idx2] * w_re - arr.im[idx2] * w_im
                let v_im = arr.re[idx2] * w_im + arr.im[idx2] * w_re
                arr.re[idx1] = u_re + v_re
                arr.im[idx1] = u_im + v_im
                arr.re[idx2] = u_re - v_re
                arr.im[idx2] = u_im - v_im
                j = j + 1
            }
            k = k + size
        }
        size = size * 2
    }
}

pub fn fft_inverse(arr: &!ComplexArray) with Mut, Div, Panic {
    let n = arr.n
    var i: i64 = 0
    while i < n {
        arr.im[i] = 0.0 - arr.im[i]
        i = i + 1
    }
    fft_forward(arr)
    var j: i64 = 0
    while j < n {
        arr.re[j] = arr.re[j] / (n as f64)
        arr.im[j] = (0.0 - arr.im[j]) / (n as f64)
        j = j + 1
    }
}

// ============================================================================
// SPECTRAL HELPERS
// ============================================================================

pub fn fft_magnitude(arr: &ComplexArray, out: &![f64; 256]) with Mut, Div, Panic {
    var i: i64 = 0
    while i < arr.n {
        out[i] = fft_sqrt(arr.re[i] * arr.re[i] + arr.im[i] * arr.im[i])
        i = i + 1
    }
}

pub fn fft_power(arr: &ComplexArray, out: &![f64; 256]) with Mut {
    var i: i64 = 0
    while i < arr.n {
        out[i] = arr.re[i] * arr.re[i] + arr.im[i] * arr.im[i]
        i = i + 1
    }
}

pub fn fft_phase(arr: &ComplexArray, out: &![f64; 256]) with Mut, Div, Panic {
    var i: i64 = 0
    while i < arr.n {
        out[i] = fft_atan2(arr.im[i], arr.re[i])
        i = i + 1
    }
}

// ============================================================================
// TESTS
// ============================================================================

var CNT: [i64; 2] = [0; 2]

fn chk(label: i64, ok: i64) with IO, Mut {
    if ok == 1 {
        print("  PASS ["); print(label); print("]\n")
        CNT[0] = CNT[0] + 1
    } else {
        print("  FAIL ["); print(label); print("]\n")
        CNT[1] = CNT[1] + 1
    }
}

fn near(a: f64, b: f64, tol: f64) -> i64 {
    let d = a - b
    let d2 = if d < 0.0 { 0.0 - d } else { d }
    if d2 <= tol { 1 } else { 0 }
}

fn test_log2_bit_reverse() with IO, Mut, Div, Panic {
    chk(1, if fft_log2(1) == 0 { 1 } else { 0 })
    chk(2, if fft_log2(2) == 1 { 1 } else { 0 })
    chk(3, if fft_log2(8) == 3 { 1 } else { 0 })
    chk(4, if fft_log2(256) == 8 { 1 } else { 0 })
    chk(5, if fft_bit_reverse(6, 3) == 3 { 1 } else { 0 })
    chk(6, if fft_bit_reverse(1, 3) == 4 { 1 } else { 0 })
}

fn test_trig() with IO, Mut, Div, Panic {
    chk(7, near(fft_sin(0.0), 0.0, 1e-12))
    chk(8, near(fft_sin(fft_pi() * 0.5), 1.0, 1e-9))
    chk(9, near(fft_cos(0.0), 1.0, 1e-9))
    chk(10, near(fft_cos(fft_pi()), 0.0 - 1.0, 1e-9))
    // sin(π) = 0 with octant reduction
    chk(11, near(fft_sin(fft_pi()), 0.0, 1e-9))
    // sin(3π/2) = -1
    chk(12, near(fft_sin(fft_pi() * 1.5), 0.0 - 1.0, 1e-9))
}

fn test_dc() with IO, Mut, Div, Panic {
    var data: [f64; 256] = [0.0; 256]
    var i: i64 = 0
    while i < 8 { data[i] = 1.0; i = i + 1 }
    var arr = ComplexArray { re: [0.0; 256], im: [0.0; 256], n: 0 }
    ca_load_real(&!arr, &data, 8)
    fft_forward(&!arr)
    chk(13, near(arr.re[0], 8.0, 1e-8))
    chk(14, near(arr.im[0], 0.0, 1e-8))
    chk(15, near(arr.re[1], 0.0, 1e-6))
    chk(16, near(arr.re[4], 0.0, 1e-6))
}

fn test_single_tone() with IO, Mut, Div, Panic {
    let n: i64 = 8
    let pi = fft_pi()
    var data: [f64; 256] = [0.0; 256]
    var i: i64 = 0
    while i < n {
        data[i] = fft_cos(2.0 * pi * 1.0 * (i as f64) / (n as f64))
        i = i + 1
    }
    var arr = ComplexArray { re: [0.0; 256], im: [0.0; 256], n: 0 }
    ca_load_real(&!arr, &data, n)
    fft_forward(&!arr)
    chk(17, near(arr.re[1], 4.0, 1e-5))
    chk(18, near(arr.im[1], 0.0, 1e-5))
    chk(19, near(arr.re[7], 4.0, 1e-5))
    chk(20, near(arr.re[0], 0.0, 1e-5))
}

fn test_roundtrip() with IO, Mut, Div, Panic {
    let n: i64 = 8
    var data: [f64; 256] = [0.0; 256]
    data[0] = 1.0; data[1] = 2.0; data[2] = 3.0; data[3] = 4.0
    data[4] = 5.0; data[5] = 6.0; data[6] = 7.0; data[7] = 8.0
    var arr = ComplexArray { re: [0.0; 256], im: [0.0; 256], n: 0 }
    ca_load_real(&!arr, &data, n)
    fft_forward(&!arr)
    fft_inverse(&!arr)
    chk(21, near(arr.re[0], 1.0, 1e-6))
    chk(22, near(arr.re[1], 2.0, 1e-6))
    chk(23, near(arr.re[3], 4.0, 1e-6))
    chk(24, near(arr.re[7], 8.0, 1e-6))
    chk(25, near(arr.im[0], 0.0, 1e-6))
}

fn test_magnitude_power() with IO, Mut, Div, Panic {
    let n: i64 = 4
    var data: [f64; 256] = [0.0; 256]
    var i: i64 = 0
    while i < n { data[i] = 2.0; i = i + 1 }
    var arr = ComplexArray { re: [0.0; 256], im: [0.0; 256], n: 0 }
    ca_load_real(&!arr, &data, n)
    fft_forward(&!arr)
    var mag: [f64; 256] = [0.0; 256]
    var pwr: [f64; 256] = [0.0; 256]
    fft_magnitude(&arr, &!mag)
    fft_power(&arr, &!pwr)
    chk(26, near(mag[0], 8.0, 1e-6))
    chk(27, near(mag[1], 0.0, 1e-6))
    chk(28, near(pwr[0], 64.0, 1e-5))
}

pub fn main() -> i32 with IO, Mut, Div, Panic {
    CNT[0] = 0; CNT[1] = 0
    print("─── stdlib/signal/fft tests ───\n")
    test_log2_bit_reverse()
    test_trig()
    test_dc()
    test_single_tone()
    test_roundtrip()
    test_magnitude_power()
    print("─── "); print(CNT[0]); print("/"); print(CNT[0]+CNT[1]); print(" PASS ───\n")
    if CNT[1] == 0 { print("ALL PASS\n"); 0 } else { 1 }
}
