// stdlib/darwin_pbpk/ddi/clozapine_fluvoxamine.sio — fluvoxamine × clozapine,
// the canonical CYP1A2 drug-drug interaction, as a NON-CIRCULAR prediction.
// Scenario library (no main).
//
// Why this file is a test of the model, not a fit
// -----------------------------------------------
// The clozapine card (drugs/clozapine.sio) sets its metabolic fractions FROM
// the fluvoxamine and smoking interactions ("fm_cyp1a2 ~ 0.70: fluvoxamine
// raises clozapine AUC x2-3"). Predicting the fluvoxamine interaction from
// those fractions would be circular. This file does NOT use them. It takes
// two INDEPENDENT in-vitro data sets, neither derived from the whole-body
// interaction it predicts, and feeds them to the driver's own competitive-
// inhibition factor (multidrug28 md_factor_now):
//
//   1. Enzyme partition of clozapine N-demethylation at a therapeutic hepatic
//      concentration (5 uM), from inhibition of cDNA-expressed isoforms in
//      human liver microsomes — Olesen & Linnet 2001, J Clin Pharmacol
//      41:823-832 (DOI 10.1177/00912700122010717):
//        CYP1A2 30%, CYP2C19 24%, CYP3A4 22%, CYP2C9 12%, CYP2D6 6%.
//      The five sum to 94%; the ~6% remainder (N-oxidation, direct routes) is
//      NOT CYP-competitive and is carried as an uninhibitable floor.
//
//   2. Fluvoxamine Ki against each isoform, same group, separate study —
//      Olesen & Linnet 2000, J Clin Psychopharmacol 20:35-42
//      (DOI 10.1097/00004714-200002000-00007):
//        CYP1A2 0.041, CYP2C19 0.087, CYP2C9 2.2, CYP2D6 4.9, CYP3A4 24 (uM),
//      with an estimated therapeutic hepatic fluvoxamine of 4-7 uM.
//
// The prediction (static well-stirred perpetrator limit)
// ------------------------------------------------------
// Fluvoxamine held at its hepatic steady state is a constant competitive load
// L_k = I/Ki_k at the liver. Each inhibitable fraction is scaled by the
// driver's factor f_k = 1/(1 + L_k); the AUC fold-rise of a linear victim is
//        R(I) = 1 / ( Σ_k fm_k · f_k + fm_other ).
// This is the static limit: fluvoxamine is a fixed load, not a co-integrated
// drug, so there is no flow or permeability limitation on the perpetrator and
// no time course. A full co-administration run on the PBPK28 transport (which
// can only BLUNT the rise, never amplify it) is the declared follow-up.
//
// What the model gets, and does not
// ---------------------------------
// R comes out ~3.0x at I = 4 uM and ~3.5x at I = 7 uM. The clinically observed
// rise is 5-10x (Olesen & Linnet 2000). The static mechanistic model from
// independent in-vitro data therefore UNDER-predicts. Honest reading of the
// gap: the HLM partition at 5 uM understates the in-vivo dominance of CYP1A2
// (smoking alone moves clozapine 30-50%, and the clinical fluvoxamine effect
// implies an in-vivo inhibitable 1A2 fraction above 0.30); fluvoxamine's own
// metabolite adds inhibition; and hepatic fluvoxamine may exceed 7 uM. The
// model states what independent in-vitro data predict and leaves the gap
// visible rather than tuning fm to close it — the tuning is exactly the
// circularity this file exists to avoid. No clinical-validity claim (ADR009).

use darwin_pbpk::core::pbpk28_params::*
use darwin_pbpk::ddi::multidrug28::*

// ─── Independent in-vitro constants ─────────────────────────────────────────
// Enzyme partition (Olesen & Linnet 2001), indexed by the multidrug28 code:
// 0 CYP3A4, 1 CYP2D6, 2 CYP2C9, 3 CYP2C19, 4 CYP1A2.
pub fn clzfvx_fm(enz: i32) -> f64 {
    if enz == 0 { return 0.22 }   // CYP3A4
    if enz == 1 { return 0.06 }   // CYP2D6
    if enz == 2 { return 0.12 }   // CYP2C9
    if enz == 3 { return 0.24 }   // CYP2C19
    if enz == 4 { return 0.30 }   // CYP1A2
    return 0.0
}

// Uninhibitable remainder (1 - Σ fm): N-oxidation and direct routes.
pub fn clzfvx_fm_other() -> f64 { return 0.06 }

// Fluvoxamine Ki (uM), same index order (Olesen & Linnet 2000).
pub fn clzfvx_ki_uM(enz: i32) -> f64 {
    if enz == 0 { return 24.0 }    // CYP3A4
    if enz == 1 { return 4.9 }     // CYP2D6
    if enz == 2 { return 2.2 }     // CYP2C9
    if enz == 3 { return 0.087 }   // CYP2C19
    if enz == 4 { return 0.041 }   // CYP1A2
    return 0.0
}

// Therapeutic hepatic fluvoxamine range (uM), Olesen & Linnet 2000.
pub fn clzfvx_hepatic_lo_uM() -> f64 { return 4.0 }
pub fn clzfvx_hepatic_hi_uM() -> f64 { return 7.0 }

// Clinically observed clozapine AUC fold-rise on fluvoxamine (same source).
pub fn clzfvx_clinical_lo() -> f64 { return 5.0 }
pub fn clzfvx_clinical_hi() -> f64 { return 10.0 }

// ─── Register clozapine as a STATIC inhibition-factor harness ───────────────
// SCOPE (narrowed 2026-11-04 after review of PR #3454): this helper exists to
// give md_factor_now a registered victim so the driver's competitive factors
// can be read at the liver. It is NOT a kinetically calibrated victim. The
// five CYP CLint terms are set to the fm partition times a free positive
// scale: md_factor_now reads only the inhibitor load (ext_load + co-drug
// C_u/Ki), never CLint or cl_central, so the factors — and hence the fold-rise
// R — do not depend on this scale or on any absolute clearance. The absolute
// numbers here are placeholders that make the victim registrable, nothing more.
//
// The uninhibitable remainder fm_other is a term of the ANALYTIC denominator
// (clzfvx_predicted_ratio / clzfvx_driver_ratio) only; it is deliberately NOT
// configured as a kinetic path, because partitioning a non-CYP clearance
// against the CYP sinks unit-consistently needs the well-stirred/flow-limited
// calibration this file does not do. cl_central is therefore left at 0, and
// `clzfvx_victim_has_no_kinetic_floor` lets a caller assert that the configured
// victim carries no separate uninhibitable path. A dynamic co-administration
// run would require that calibrated non-CYP path (and calibrated CLint); it is
// the declared follow-up, and must not be built from this harness as if the
// 6% floor were already in the sink.
pub fn clzfvx_clint_scale() -> f64 { return 10.0 }

pub fn clzfvx_add_clozapine(md: &!MultiDrug28, clz_p: PBPKParams28) -> i32 with Mut, Div, Panic {
    // Placeholder CYP CLint weights only; cl_central stays 0 (see SCOPE above).
    // No kinetic-fidelity claim: the fold-rise is analytic, not simulated here.
    var p = clz_p
    p.cl_central = 0.0
    let v = md_add_drug(md, p, 0.05, 0.55, 1.0)   // fu_b, Fa, ka from the card
    let scale = clzfvx_clint_scale()
    var k: i32 = 0
    while k < 5 {
        md_set_clint(md, v, md_site_liver(), k, clzfvx_fm(k) * scale)
        k = k + 1
    }
    return v
}

// Discriminating check for the scope above: the registered victim carries no
// separate (non-CYP) kinetic clearance path, so the analytic fm_other floor is
// NOT embodied in the configured sink. True iff cl_central is exactly 0.
pub fn clzfvx_victim_has_no_kinetic_floor(md: &MultiDrug28, v: i32) -> bool with Mut, Panic {
    return md_params_of(md, v).cl_central == 0.0
}

// Impose fluvoxamine at hepatic concentration I (uM) as a constant competitive
// load L_k = I/Ki_k at the liver. CYP2D6 excepted only when its Ki is zero.
pub fn clzfvx_set_fluvoxamine(md: &!MultiDrug28, i_uM: f64) with Mut, Div, Panic {
    var k: i32 = 0
    while k < 5 {
        let ki = clzfvx_ki_uM(k)
        if ki > 0.0 {
            md_set_ext_load(md, md_site_liver(), k, i_uM / ki)
        }
        k = k + 1
    }
}

// ─── Closed-form prediction ─────────────────────────────────────────────────
// R(I) = 1 / ( Σ_k fm_k/(1 + I/Ki_k) + fm_other ), the hand formula the
// driver's factor must reproduce.
pub fn clzfvx_predicted_ratio(i_uM: f64) -> f64 with Mut, Div {
    var denom = clzfvx_fm_other()
    var k: i32 = 0
    while k < 5 {
        let ki = clzfvx_ki_uM(k)
        let f = 1.0 / (1.0 + i_uM / ki)
        denom = denom + clzfvx_fm(k) * f
        k = k + 1
    }
    return 1.0 / denom
}

// Same ratio but reading each factor from the DRIVER (md_factor_now) after
// clzfvx_set_fluvoxamine, so the gate compares the two. Victim index `v`.
pub fn clzfvx_driver_ratio(md: &MultiDrug28, v: i32) -> f64 with Mut, Div, Panic {
    var denom = clzfvx_fm_other()
    var k: i32 = 0
    while k < 5 {
        denom = denom + clzfvx_fm(k) * md_factor_now(md, v, md_site_liver(), k)
        k = k + 1
    }
    return 1.0 / denom
}
