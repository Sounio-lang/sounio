// darwin_pbpk/bbb/bbb_priors.sio — BBB parameter uncertainty priors
//
// Per-parameter uncertainty distributions for rapamycin BBB input
// parameters.  These priors feed directly into the GUM-through-ODE
// sensitivity harness (bbb_gum.sio).
//
// Each prior carries three numbers:
//   mean       — the literature-consensus central value
//   variance   — squared standard deviation, in the natural scale
//                of the parameter (NOT log-transformed; matches the
//                JCGM 100:2008 first-order propagation formula)
//   confidence — an [0, 1] epistemic quality score (NOT a Beta
//                posterior); high confidence means the literature
//                directly measures this parameter with converging
//                methods, low confidence means cross-species
//                extrapolation or a single primary source.
//
// The priors are ordered to match the indexing used by
// bbb_perturb_param(prm, idx, delta) in bbb_gum.sio:
//
//   0: ps_bbb       — BBB permeability-surface area
//   1: ps_mem       — cellular membrane permeability-surface area
//   2: kpuu_brain   — BBB steady-state unbound partition
//   3: kpuu_cell    — cellular steady-state unbound partition
//   4: fu_plasma    — plasma unbound fraction
//   5: fu_isf       — brain ISF unbound fraction
//   6: fu_icf       — brain ICF unbound fraction
//
// The first four are the TRANSPORTER / MEMBRANE parameters — these
// are what distinguish the dissertation-grade BBB model from the
// coarse Kp approach.  The last three are the PROTEIN BINDING
// parameters, which the dissertation cites as "measurement-dominated"
// (high-confidence wet-lab determinations).
//
// Expected GUM decomposition for rapamycin: ps_bbb and kpuu_brain
// dominate the Kpuu_AUC variance (transporter variability >>
// binding variability for this drug).

pub struct BBBPriors {
    n:          i32,
    mean:       [f64; 8],
    variance:   [f64; 8],
    confidence: [f64; 8],
}

pub fn bbb_rapamycin_priors() -> BBBPriors with Mut, Div, Panic {
    var m: [f64; 8] = [0.0; 8]
    var v: [f64; 8] = [0.0; 8]
    var c: [f64; 8] = [0.0; 8]

    // 0: ps_bbb — effective BBB permeability-surface area (L/h)
    // Central value 0.30 L/h captures the observed ~10-15 h brain
    // Cmax lag time for rapamycin.  Inter-species extrapolation and
    // inter-subject P-gp expression variability together give a
    // published CV of ~40% (Gaohua 2016; Shah & Betts 2012).
    // variance = (0.30 * 0.40)^2 = 0.0144
    // confidence = 0.45 (extrapolation-dominated)
    m[0] = 0.30;       v[0] = 0.0144;    c[0] = 0.45

    // 1: ps_mem — cellular membrane PS (L/h)
    // No direct rapamycin microdialysis data; we take 10 L/h from a
    // class-analogous macrolide.  CV estimated at 60% (generous).
    // variance = (10.0 * 0.60)^2 = 36.0
    // confidence = 0.25 (structural analogue only)
    m[1] = 10.0;       v[1] = 36.0;      c[1] = 0.25

    // 2: kpuu_brain — BBB steady-state unbound partition (-)
    // Mean 0.15 bracketed by Lampen 1998 rodent Kpuu post P-gp
    // correction and Laplanche 1994 human AUC ratios.
    // Literature spread 0.10-0.25 → SD ≈ 0.04, variance ≈ 0.0016
    // confidence = 0.60 (two primary sources, consistent)
    m[2] = 0.15;       v[2] = 0.0016;    c[2] = 0.60

    // 3: kpuu_cell — cellular steady-state unbound partition (-)
    // Typical neutral lipophilic drug; mean 2.0, broad prior.
    // variance = (2.0 * 0.50)^2 = 1.0
    // confidence = 0.30 (class estimate)
    m[3] = 2.0;        v[3] = 1.0;       c[3] = 0.30

    // 4: fu_plasma — plasma unbound fraction (-)
    // Schreiber 1991 in vitro equilibrium dialysis, well replicated.
    // CV ≈ 15%, variance = (0.08 * 0.15)^2 = 1.44e-4
    // confidence = 0.90 (well-characterized wet lab)
    m[4] = 0.08;       v[4] = 0.000144;  c[4] = 0.90

    // 5: fu_isf — brain ISF unbound fraction (-)
    // Class-typical value 0.02; CV 40% (microdialysis not directly
    // measured for rapamycin).
    // variance = (0.02 * 0.40)^2 = 6.4e-5
    // confidence = 0.35
    m[5] = 0.02;       v[5] = 0.000064;  c[5] = 0.35

    // 6: fu_icf — brain ICF unbound fraction (-)
    // Assumed equal to fu_isf absent direct data.  CV 40%.
    // variance = 6.4e-5
    // confidence = 0.25 (assumption, not measurement)
    m[6] = 0.02;       v[6] = 0.000064;  c[6] = 0.25

    BBBPriors { n: 7, mean: m, variance: v, confidence: c }
}
