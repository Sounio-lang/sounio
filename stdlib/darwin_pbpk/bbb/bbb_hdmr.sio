// darwin_pbpk/bbb/bbb_hdmr.sio — Anchored Cut-HDMR (7-D Sobol)
//
// Full 7-dimensional variance decomposition of Kpuu_AUC over all BBB
// input parameters, via the anchored High-Dimensional Model
// Representation (Rabitz & Alis 1999; Sobol 2003; Saltelli 2008):
//
//   Y(p) ≈ Y(p̄) + Σ_i [Y_i(p_i; p̄_{-i}) − Y(p̄)] + ε_interaction
//
// where p̄ is the prior-mean anchor and Y_i is Y evaluated with only
// p_i varying.  Drops all pairwise-and-higher interactions.  This
// approximation is justified by the 2-D PCE finding (bbb_pce2d.sio)
// that S_12 for the dominant transporter pair is 0.06% — interactions
// between BBB parameters are essentially zero for the Kpuu_AUC
// endpoint.
//
// For each dimension i, we run an 8-node Gauss-Hermite quadrature on
// the univariate response Y_i(p_i), producing an order-4 He PCE with
// coefficients (c_0..c_4).  The total Sobol first-order index for
// dimension i is
//
//   S_i  = V_i / Σ_j V_j,    V_i = Σ_{n≥1} c_{i,n}² · n!
//
// Total cost: 7 × 8 = 56 solver evaluations (one shared anchor).
// Compared to a full tensor product (8^7 = 2,097,152) or a Smolyak
// level-2 sparse grid (~113), HDMR is the cheapest sound option for
// a model whose interactions have been pre-measured to be negligible.
//
// Reference: Saltelli A. et al. (2008) Global Sensitivity Analysis:
// The Primer, Ch. 4; Sobol I.M. (2003) Math. Comp. Simul. 58:271.

use darwin_pbpk::bbb::bbb_core::{BBBParams}
use darwin_pbpk::bbb::bbb_coupled::{bbb_coupled_run}
use darwin_pbpk::bbb::bbb_pce::{bbb_pce_node_at, bbb_pce_wt_at}
use darwin_pbpk::bbb::bbb_priors::{BBBPriors}
use darwin_pbpk::tsit5_pbpk14::{PBPKParams14}

fn hdmr_sqrt(x: f64) -> f64 with Div, Panic, Mut {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 18 { y = (y + x / y) * 0.5; i = i + 1 }
    y
}

fn hdmr_he(n: i32, x: f64) -> f64 with Mut, Div, Panic {
    if n == 0 { return 1.0 }
    if n == 1 { return x }
    var h_prev = 1.0
    var h_curr = x
    var k = 2
    while k <= n {
        let h_next = x * h_curr - ((k - 1) as f64) * h_prev
        h_prev = h_curr
        h_curr = h_next
        k = k + 1
    }
    h_curr
}

fn hdmr_fact(n: i32) -> f64 {
    if n <= 1 { return 1.0 }
    if n == 2 { return 2.0 }
    if n == 3 { return 6.0 }
    24.0        // n == 4
}

// Swap BBB parameter at index `idx` with a new value, returning a
// perturbed copy.  Dispatch must match bbb_gum.sio's indexing.
fn hdmr_set_param(prm: BBBParams, idx: i32, v: f64) -> BBBParams with Mut, Div, Panic {
    var p = prm
    if idx == 0 { p.ps_bbb     = v }
    if idx == 1 { p.ps_mem     = v }
    if idx == 2 { p.kpuu_brain = v }
    if idx == 3 { p.kpuu_cell  = v }
    if idx == 4 { p.fu_plasma  = v }
    if idx == 5 { p.fu_isf     = v }
    if idx == 6 { p.fu_icf     = v }
    p
}

// Physical floors for each parameter (prevents a negative draw from a
// node at xi = -2.93 when std is relatively large).
fn hdmr_floor(idx: i32) -> f64 {
    if idx == 0 { return 0.001   }  // ps_bbb
    if idx == 1 { return 0.01    }  // ps_mem
    if idx == 2 { return 0.01    }  // kpuu_brain
    if idx == 3 { return 0.01    }  // kpuu_cell
    if idx == 4 { return 0.0001  }  // fu_plasma
    if idx == 5 { return 0.00001 }  // fu_isf
    0.00001                          // fu_icf
}

// ----------------------------------------------------------------------------
// HDMR result
// ----------------------------------------------------------------------------

pub struct BBBHDMRResult {
    n_dims:          i32,
    anchor_mean:     f64,             // Y(p̄), the reference evaluation
    // Per-dimension univariate-PCE variance contributions.
    v_contrib:       [f64; 8],
    c1_linear:       [f64; 8],        // linear (He_1) component of c_n
    c2_quadratic:    [f64; 8],        // quadratic (He_2) component
    nonlinear_share: [f64; 8],        // fraction of V_i in He_{≥2}
    // Normalised first-order Sobol indices.
    sobol:           [f64; 8],
    // Totals.
    v_total:         f64,
    stddev:          f64,
    mean_hdmr:       f64,             // anchor + Σ (c_{i,0} - anchor)
}

fn bbb_hdmr_zero() -> BBBHDMRResult {
    BBBHDMRResult {
        n_dims: 0, anchor_mean: 0.0,
        v_contrib:       [0.0; 8],
        c1_linear:       [0.0; 8],
        c2_quadratic:    [0.0; 8],
        nonlinear_share: [0.0; 8],
        sobol:           [0.0; 8],
        v_total: 0.0, stddev: 0.0, mean_hdmr: 0.0,
    }
}

// Build the 7-D Cut-HDMR over all BBB parameters.
pub fn bbb_hdmr_build_kpuu_auc(
    sys_prm:     PBPKParams14,
    base_bbb:    BBBParams,
    priors:      BBBPriors,
    dose_mg:     f64,
    checkpoints: [f64; 32],
    n_points:    i32,
    bbb_dt:      f64
) -> BBBHDMRResult with Mut, Div, Panic {
    var out = bbb_hdmr_zero()
    let n_dims = priors.n
    out.n_dims = n_dims

    // --- Anchor evaluation at p̄ ---
    let anchor_trace = bbb_coupled_run(sys_prm, base_bbb, dose_mg, checkpoints, n_points, bbb_dt)
    let anchor = anchor_trace.kpuu_auc
    out.anchor_mean = anchor

    var total_var: f64 = 0.0
    var mean_shift: f64 = 0.0

    // --- Loop over dimensions ---
    var d: i32 = 0
    while d < n_dims {
        let ddx = d as usize
        let mu_d = priors.mean[ddx]
        let sd_d = hdmr_sqrt(priors.variance[ddx])
        let floor = hdmr_floor(d)

        // 8-node Gauss-Hermite quadrature on the univariate response.
        var y_nodes: [f64; 8] = [0.0; 8]
        var k: i32 = 0
        while k < 8 {
            let xi = bbb_pce_node_at(k)
            var p_k = mu_d + sd_d * xi
            if p_k < floor { p_k = floor }
            let bbb_k = hdmr_set_param(base_bbb, d, p_k)
            let tr = bbb_coupled_run(sys_prm, bbb_k, dose_mg, checkpoints, n_points, bbb_dt)
            y_nodes[k as usize] = tr.kpuu_auc
            k = k + 1
        }

        // --- Compute PCE coefficients (order 4 He basis) ---
        var s0: f64 = 0.0
        var s1: f64 = 0.0
        var s2: f64 = 0.0
        var s3: f64 = 0.0
        var s4: f64 = 0.0
        var j: i32 = 0
        while j < 8 {
            let xi = bbb_pce_node_at(j)
            let w  = bbb_pce_wt_at(j)
            let y  = y_nodes[j as usize]
            s0 = s0 + w * y
            s1 = s1 + w * y * hdmr_he(1, xi)
            s2 = s2 + w * y * hdmr_he(2, xi)
            s3 = s3 + w * y * hdmr_he(3, xi)
            s4 = s4 + w * y * hdmr_he(4, xi)
            j = j + 1
        }
        let c0 = s0
        let c1 = s1
        let c2 = s2 / 2.0
        let c3 = s3 / 6.0
        let c4 = s4 / 24.0

        let v_1 = c1 * c1 * hdmr_fact(1)
        let v_2 = c2 * c2 * hdmr_fact(2)
        let v_3 = c3 * c3 * hdmr_fact(3)
        let v_4 = c4 * c4 * hdmr_fact(4)
        let v_i = v_1 + v_2 + v_3 + v_4
        let nl_share = if v_i > 0.0 { (v_2 + v_3 + v_4) / v_i } else { 0.0 }

        out.v_contrib[ddx]       = v_i
        out.c1_linear[ddx]       = c1
        out.c2_quadratic[ddx]    = c2
        out.nonlinear_share[ddx] = nl_share

        total_var = total_var + v_i
        mean_shift = mean_shift + (c0 - anchor)
        d = d + 1
    }

    out.v_total   = total_var
    out.stddev    = hdmr_sqrt(total_var)
    out.mean_hdmr = anchor + mean_shift

    if total_var > 0.0 {
        var m: i32 = 0
        while m < n_dims {
            let mdx = m as usize
            out.sobol[mdx] = out.v_contrib[mdx] / total_var
            m = m + 1
        }
    }

    out
}

// ----------------------------------------------------------------------------
// Pretty-print the HDMR budget
// ----------------------------------------------------------------------------

fn bbb_hdmr_param_name(idx: i32) -> string {
    if idx == 0 { return "ps_bbb" }
    if idx == 1 { return "ps_mem" }
    if idx == 2 { return "kpuu_brain" }
    if idx == 3 { return "kpuu_cell" }
    if idx == 4 { return "fu_plasma" }
    if idx == 5 { return "fu_isf" }
    if idx == 6 { return "fu_icf" }
    "unknown"
}

pub fn bbb_hdmr_print(r: BBBHDMRResult) with IO, Mut, Panic, Div {
    println("BBB anchored Cut-HDMR — 7-D Sobol first-order indices")
    print("  anchor Y(p̄)      = "); print_f64(r.anchor_mean);  println("")
    print("  HDMR mean         = "); print_f64(r.mean_hdmr);    println("")
    print("  HDMR u_c (stddev) = "); print_f64(r.stddev);       println("")
    print("  HDMR V_total      = "); print_f64(r.v_total);      println("")
    println("")
    println("param,sobol_S1,var_contrib,c1_linear,c2_quadratic,nonlinear_share")
    var i: i32 = 0
    while i < r.n_dims {
        let idx = i as usize
        print(bbb_hdmr_param_name(i));       print(",")
        print_f64(r.sobol[idx]);             print(",")
        print_f64(r.v_contrib[idx]);         print(",")
        print_f64(r.c1_linear[idx]);         print(",")
        print_f64(r.c2_quadratic[idx]);      print(",")
        print_f64(r.nonlinear_share[idx])
        println("")
        i = i + 1
    }
}
