// ---- the fitted observables in kernel units (73 kg body) ------------------------------------
// plasma CL in L/h = mL/min/kg x 0.06 x 73; V_ss in L = L/kg x 73
pub fn hal_obs_cl() -> f64 with Mut, Div, Panic { return hal_pool_cl(0).mean * 0.06 * hal_bw() }
pub fn hal_u_cl() -> f64 with Mut, Div, Panic { return hal_pool_cl(0).u * 0.06 * hal_bw() }
pub fn hal_obs_vss() -> f64 with Mut, Div, Panic { return hal_pool_vss(0).mean * hal_bw() }
pub fn hal_u_vss() -> f64 with Mut, Div, Panic { return hal_pool_vss(0).u * hal_bw() }

// ---- the two closed-form fits ----------------------------------------------------------------
// Takes a value array with the measured parameters set and returns it with CD_KPSC, CD_CLREN and
// CD_CLINT set from (vss, cl_plasma). CD_CLINT = -1 if a fit is impossible.
pub fn hal_fit(th: [f64; 18], vss: f64, cl_plasma: f64) -> [f64; 18] with Mut, Div, Panic {
    var t = th
    t[CD_KPSC] = 1.0
    t[CD_CLINT] = 0.0
    t[CD_CLREN] = hal_fe_renal() * cl_plasma
    let p0 = circ28_drug_params_theta(t)
    let sc = circ28_kp_scale_for_vss(p0, p0.kp, vss)
    if !(sc > 0.0) {
        t[CD_CLINT] = 0.0 - 1.0
        return t
    }
    t[CD_KPSC] = sc
    let p = circ28_drug_params_theta(t)
    let clb = (cl_plasma - t[CD_CLREN]) / p.bp
    let qh = circ28_q_hepatic(p)
    let eh = clb / qh
    if !(eh > 0.0) || !(eh < 1.0) {
        t[CD_CLINT] = 0.0 - 1.0
        return t
    }
    let y = p.bp * qh * eh / (1.0 - eh)
    if !(p.ps[1] > y) {
        t[CD_CLINT] = 0.0 - 1.0
        return t
    }
    t[CD_CLINT] = (y * p.ps[1] / (p.ps[1] - y)) / p.fu
    return t
}

// One component of the fit (one array per frame: Madaros segfaults on a frame that holds the
// record and several [f64; 18] arrays).
pub fn hal_fit_comp(th: [f64; 18], vss: f64, cl_plasma: f64, comp: i32) -> f64 with Mut, Div, Panic {
    let t = hal_fit(th, vss, cl_plasma)
    return t[comp]
}

pub fn hal_measured_record(d: &!Circ28Drug) with Mut, Div, Panic, Epistemic {
    circ28_drug_set(d, CD_MW, hal_mw(), 0.0, CD_STATUS_MEASURED, "Alasmari2022 Table 2 (HMDB)")
    circ28_drug_set(d, CD_LOGP, hal_logp(), hal_u_logp(), CD_STATUS_DERIVED, "mean of 4.30 (El Tayar1985 via HSDB) and 3.23 (Sangster via PubChem); u = range/sqrt12")
    circ28_drug_set(d, CD_PKA1, hal_pka1(), hal_u_pka1(), CD_STATUS_MEASURED, "El Tayar1985 via HSDB 8.66; u = (8.66-7.8)/sqrt12 (Alasmari2022 lists 7.8, 8.05, 8.65)")
    circ28_drug_set(d, CD_ION, 2.0, 0.0, CD_STATUS_DERIVED, "monoprotic base")
    circ28_drug_set(d, CD_FU, hal_fu(), hal_u_fu(), CD_STATUS_MEASURED, "midpoint of 7.5-11.6 % (Kudo1999 via Alasmari2022); u = range/sqrt12")
    circ28_drug_set(d, CD_BP, hal_bp(), hal_u_bp(), CD_STATUS_DERIVED, "midpoint of 0.79 (Cheng1987, measured) and 1.08 (Mamada2021 median); u = range/sqrt12")
    circ28_drug_set(d, CD_KA, hal_ka(), hal_u_ka(), CD_STATUS_MEASURED, "ln2 / absorption half-life 0.37 +/- 0.18 h, n 8 (Holley1983)")
    circ28_drug_set(d, CD_TLAG, hal_tlag(), hal_u_tlag(), CD_STATUS_MEASURED, "lag 0.82 +/- 0.25 h, n 8 (Holley1983)")
    circ28_drug_set(d, CD_FA, 1.0, 0.0, CD_STATUS_UNUSED, "ASSUMPTION: complete absorption, no source")
}

// Fits kpsc and clint (and sets the derived renal clearance); uncertainties by central
// differences of the closed forms with respect to their own observable.
pub fn hal_fit_record(d: &!Circ28Drug) with Mut, Div, Panic, Epistemic {
    let th0 = circ28_drug_theta(d)
    let vss = hal_obs_vss()
    let cl = hal_obs_cl()
    let th = hal_fit(th0, vss, cl)
    let hv = 1.0e-4 * vss
    let hc = 1.0e-4 * cl
    let dk = (hal_fit_comp(th0, vss + hv, cl, CD_KPSC) - hal_fit_comp(th0, vss - hv, cl, CD_KPSC)) / (2.0 * hv)
    let dc = (hal_fit_comp(th0, vss, cl + hc, CD_CLINT) - hal_fit_comp(th0, vss, cl - hc, CD_CLINT)) / (2.0 * hc)
    circ28_drug_set(d, CD_KPSC, th[CD_KPSC], hal_abs(dk) * hal_u_vss(), CD_STATUS_FITTED, "fitted to V_ss of healthy adults (Holley1983, one study); u from u(Vss)")
    circ28_drug_set(d, CD_CLINT, th[CD_CLINT], hal_abs(dc) * hal_u_cl(), CD_STATUS_FITTED, "fitted to pooled IV plasma CL of healthy adults (Holley1983, Forsman1974, Miller2008); u from u(CL)")
    circ28_drug_set(d, CD_CLREN, th[CD_CLREN], 0.5 * th[CD_CLREN], CD_STATUS_DERIVED, "1 % of the pooled plasma CL (Alasmari2022 citing Kudo1999); u = half the value (judgment)")
}

// Fills a record made by circ28_drug_new() (no function builds AND returns the record: see the
// midazolam module).
pub fn hal_drug_into(d: &!Circ28Drug) with Mut, Div, Panic, Epistemic {
    hal_measured_record(d)
    hal_fit_record(d)
}

// ---- one profile through the kernel ------------------------------------------------------------
// route 0: IV infusion of `dose` mg over t_inf h; route 1: oral (ka, fa, tlag of the array).
// pssc < 0 keeps the array's ps scalar. Grid: 0.01 h to 0.5 h, 0.05 h to 4 h, 0.25 h to 12 h,
// 1 h to 48 h, 4 h to 240 h (236 steps). The first phase is fine because a 0.05 h step after a
// one-step bolus drove the venous pool NEGATIVE for this drug (measured: -8.6 ng/mL per mg at
// 0.1 h; Kp about 20-60, venous turnover 327 /h; see the report). Plasma = venous blood / bp, mg/L. Fills f:
//   f[0] Cmax (grid), f[1] Tmax, f[2] AUC 0-240 h, f[3] terminal rate constant from C(192) and
//   C(240), f[4] AUC 0-inf, f[5] mass in the body at 240 h, f[6] input, f[7] eliminated
//   f[8..11] C at 0.1, 0.2, 0.3, 0.4 h; f[12] C(0.25); f[13] C(3); f[14] C(8); f[15] C(12);
//   f[16] C(36); f[17 + k] C(24 k), k = 1..10 (f[18] = C(24) ... f[27] = C(240))
//   f[30 + 14 j + i]: fraction of the drug in the body held by blood (i = 0: venous, arterial
//   and organ vascular spaces) or by the tissue of organ i (1 liver .. 13 rest) at 12, 24, 48 h
//   (j = 0, 1, 2)
// One run per call, everything local to this function (lean_single).
pub fn hal_profile(th: &[f64; 18], route: i32, dose: f64, t_inf: f64, pssc: f64, f: &![f64; 80]) -> i32 with Mut, Div, Panic {
    var t2: [f64; 18] = [0.0; 18]
    var i: i32 = 0
    while i < 18 {
        t2[i] = (*th)[i]
        i = i + 1
    }
    if pssc >= 0.0 { t2[CD_PSSC] = pssc }
    let ka = t2[CD_KA]
    let fa = t2[CD_FA]
    let tlag = t2[CD_TLAG]
    let p = circ28_drug_params_theta(t2)
    var sys = circ28_sys_zero()
    var s = circ28_state_zero()
    var el = circ28_elim_zero()
    var t = 0.0
    var input = 0.0
    var cmax = 0.0
    var tmax = 0.0
    var ph: i32 = 0
    while ph < 5 {
        var dt = 0.01
        var tstop = 0.5
        if ph == 1 {
            dt = 0.05
            tstop = 4.0
        }
        if ph == 2 {
            dt = 0.25
            tstop = 12.0
        }
        if ph == 3 {
            dt = 1.0
            tstop = 48.0
        }
        if ph == 4 {
            dt = 4.0
            tstop = 240.0
        }
        circ28_prepare(p, dt, &!sys)
        while t + 0.5 * dt < tstop {
            var iv = 0.0
            var oral = 0.0
            var mass = 0.0
            if route == 0 {
                mass = circ28_iv_mass(dose, t_inf, t, t + dt)
                iv = mass / dt
            } else {
                mass = circ28_oral_mass(ka, fa, dose, tlag, t, t + dt)
                oral = mass / dt
            }
            input = input + mass
            circ28_step(&!s, p, &sys, iv, oral, &!el)
            t = t + dt
            let c = s.x[0] / p.bp
            if c > cmax {
                cmax = c
                tmax = t
            }
            if hal_abs(t - 0.1) < 1.0e-6 { (*f)[8] = c }
            if hal_abs(t - 0.2) < 1.0e-6 { (*f)[9] = c }
            if hal_abs(t - 0.3) < 1.0e-6 { (*f)[10] = c }
            if hal_abs(t - 0.4) < 1.0e-6 { (*f)[11] = c }
            if hal_abs(t - 0.25) < 1.0e-6 { (*f)[12] = c }
            if hal_abs(t - 3.0) < 1.0e-6 { (*f)[13] = c }
            if hal_abs(t - 8.0) < 1.0e-6 { (*f)[14] = c }
            if hal_abs(t - 12.0) < 1.0e-6 { (*f)[15] = c }
            if hal_abs(t - 36.0) < 1.0e-6 { (*f)[16] = c }
            var k: i32 = 1
            while k <= 10 {
                if hal_abs(t - 24.0 * (k as f64)) < 1.0e-6 { (*f)[17 + k] = c }
                k = k + 1
            }
            var j: i32 = 0 - 1
            if hal_abs(t - 12.0) < 1.0e-6 { j = 0 }
            if hal_abs(t - 24.0) < 1.0e-6 { j = 1 }
            if hal_abs(t - 48.0) < 1.0e-6 { j = 2 }
            if j >= 0 {
                let tot = circ28_total_mass(&s, p)
                var blood = 0.0
                var q: i32 = 0
                while q < 28 {
                    if q < 2 || (q - 2) % 2 == 0 {
                        blood = blood + circ28_state_volume(p, q) * s.x[q]
                    }
                    q = q + 1
                }
                (*f)[30 + 14 * j] = blood / tot
                var o: i32 = 1
                while o < 14 {
                    (*f)[30 + 14 * j + o] = circ28_state_volume(p, circ28_it(o)) * s.x[circ28_it(o)] / tot
                    o = o + 1
                }
            }
        }
        ph = ph + 1
    }
    (*f)[0] = cmax
    (*f)[1] = tmax
    (*f)[2] = el.auc_ven / p.bp
    var lz = 0.0
    if (*f)[25] > 0.0 && (*f)[27] > 0.0 { lz = ln((*f)[25] / (*f)[27]) / 48.0 }
    (*f)[3] = lz
    (*f)[4] = (*f)[2]
    if lz > 0.0 { (*f)[4] = (*f)[2] + (*f)[27] / lz }
    (*f)[5] = circ28_total_mass(&s, p)
    (*f)[6] = input
    (*f)[7] = el.hepatic + el.formed + el.renal + el.plasma + el.gut
    return 0
}

// Steady-state trough of a once-daily dose by superposition of the single-dose curve:
// sum of C(24 k), k = 1..10, plus the geometric tail C(240) q / (1 - q), q = exp(-24 lambda_z).
pub fn hal_trough_ss(f: &[f64; 80]) -> f64 with Mut, Div, Panic {
    var sm = 0.0
    var k: i32 = 1
    while k <= 10 {
        sm = sm + (*f)[17 + k]
        k = k + 1
    }
    let q = exp(0.0 - 24.0 * (*f)[3])
    return sm + (*f)[27] * q / (1.0 - q)
}

// ---- one evaluation of the budget --------------------------------------------------------------
// z: 0 logP, 1 pKa1, 2 fu, 3 bp (measured), 4 V_ss (L), 5 CL (L/h) (observables: refit),
//    6 ka, 7 tlag. Oral 1 mg. out[0] AUC 0-inf (mg h/L per mg), out[1] once-daily steady-state
//    trough (mg/L per mg/day), out[2] Cmax, out[3] kpsc.
pub fn hal_eval(z: &[f64; 8], thb: &[f64; 18], out: &![f64; 4]) -> i32 with Mut, Div, Panic {
    var t: [f64; 18] = [0.0; 18]
    var i: i32 = 0
    while i < 18 {
        t[i] = (*thb)[i]
        i = i + 1
    }
    t[CD_LOGP] = (*z)[0]
    t[CD_PKA1] = (*z)[1]
    t[CD_FU] = (*z)[2]
    t[CD_BP] = (*z)[3]
    t[CD_KA] = (*z)[6]
    t[CD_TLAG] = (*z)[7]
    let t3 = hal_fit(t, (*z)[4], (*z)[5])
    var t4: [f64; 18] = [0.0; 18]
    i = 0
    while i < 18 {
        t4[i] = t3[i]
        i = i + 1
    }
    var f: [f64; 80] = [0.0; 80]
    let rc = hal_profile(&t4, 1, 1.0, 0.0, 0.0 - 1.0, &!f)
    (*out)[0] = f[4]
    (*out)[1] = hal_trough_ss(&f)
    (*out)[2] = f[0]
    (*out)[3] = t4[CD_KPSC]
    return rc
}
