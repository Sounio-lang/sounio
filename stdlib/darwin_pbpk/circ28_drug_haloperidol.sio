// stdlib/darwin_pbpk/circ28_drug_haloperidol.sio — haloperidol on the circ28 drug record
//
// Haloperidol in a healthy adult (ICRP 89 reference male, 73 kg), intravenous and oral
// tablet. Cleared by the liver (glucuronidation, carbonyl reduction to reduced haloperidol,
// CYP3A4); about 1 % of a dose is excreted unchanged by the kidney. Reduced haloperidol is
// NOT a state of this model: its share of the clearance is reported only (hal_share_reduction).
// Every number is traceable to a row below; sources were opened on 2026-11-15 (PubMed
// abstracts, the Europe PMC full text of Alasmari 2022, the DailyMed label). Nothing here
// comes from memory. ACCESS LEVEL: AB = abstract only, FT = full text read, SEC = value
// quoted by a full-text paper from a primary source that was not opened.
//
// STATUS: 1 measured, 2 derived by a stated formula from cited measurements, 3 fitted to a
// named observable (that observable is then NOT a validation), 0 unused / assumption.
// u is the STANDARD UNCERTAINTY OF THE VALUE, never an inter-individual SD: SD/sqrt(n) for a
// mean, range/sqrt(12) for a range.
//
//  param   value    u        status  basis of u            source (access)
//  MW      376      0        1       -                     Alasmari 2022 Table 2 (PMC9506126, FT; HMDB)
//  logP    3.765    0.309    2       range/sqrt(12)        mean of the two experimental values 4.30 (El Tayar
//                                                          1985 via HSDB/PubChem CID 3559) and 3.23 (Sangster
//                                                          via PubChem), both SEC. Alasmari uses 3.66 and lists
//                                                          2.9 to 4.3 (FT).
//  pKa1    8.66     0.248    1       (8.66-7.8)/sqrt(12)   El Tayar 1985 via HSDB (SEC); Alasmari Table 2 lists
//                                                          7.8, 8.05, 8.65 (FT)
//  ion     2 (base) 0        2       -                     monoprotic base, pKa > 7: Rodgers-Rowland route 1
//  fu      0.0955   0.0118   1       range/sqrt(12)        midpoint of the measured range 7.5-11.6 % (Kudo and
//                                                          Ishizaki 1999, PMID 10628896, quoted by Alasmari
//                                                          Table 2: SEC). Other values there: 8.5 % (fitted in
//                                                          that model), 12.5 %, 16.6 %.
//  B:P     0.935    0.0837   2       (1.08-0.79)/sqrt(12)  midpoint of 0.79 +/- 0.03 (Cheng 1987, PMID 3108922,
//                                                          AB: steady-state blood/plasma ratio measured in
//                                                          psychotic patients) and 1.08 (Mamada 2021,
//                                                          PMC8342319 Table S1: median of literature values,
//                                                          SEC). THE TWO DISAGREE; both are kept and the
//                                                          difference is carried in u.
//  clint   fitted   propag.  3       from u(CL)            FITTED to the pooled IV plasma clearance
//  clform  0        -        0       -                     no metabolite is tracked
//  clgut   0        -        0       -                     no sourced Fg (gaps_D2: not found): no gut-wall
//                                                          metabolism in the model
//  clren   0.01 CL  0.005 CL 2       factor 2 judgment     "about 1 % of the dose excreted renally unchanged"
//                                                          (Alasmari 2022 text, citing Kudo 1999: SEC)
//  kpsc    fitted   propag.  3       from u(Vss)           FITTED to the pooled V_ss
//  pssc    1        -        0       -                     PLACEHOLDER (ps = 20 Q), not fitted: see below
//  ka      1.873    0.322    1       SD/sqrt(n)            ln 2 / absorption half-life 0.37 +/- 0.18 h, n 8
//                                                          healthy men, 0.5 mg/kg oral (Holley 1983, PMID
//                                                          6831826, AB). Compartmental estimate of the source.
//  tlag    0.82     0.088    1       SD/sqrt(n)            0.82 +/- 0.25 h, same study (AB)
//  fa      1.0      -        0       -                     ASSUMPTION, no source: complete absorption
//
// OBSERVABLES USED TO FIT (pooled in Sounio, hal_pool; printed by the test, section S0):
//   mean = sum n_i m_i / sum n_i; sw = pooled within-study SD; SE_w = sw/sqrt(N);
//   sb = SD of the k study means; SE_b = sb/sqrt(k); u = max(SE_w, SE_b).
//   CL_iv  healthy adults, mL/min/kg (k 3, N 28): Holley 1983 11.8 +/- 2.9 (n 12, AB);
//          Forsman and Ohman 1974 11.9 (n 12, 10 mg IV; non-compartmental value computed by
//          Alasmari 2022 from the digitised mean curve, Table 4: SEC); Miller 2008 11.55 (n 4,
//          2.5 mg IV; same origin: SEC). Converted to the 73 kg reference body.
//   V_ss   healthy adults, L/kg (k 1, N 12): Holley 1983 17.8 +/- 6.5 (AB). ONE study.
//   Patients are NOT in the fit pool (rule: prefer healthy adults): Cheng 1987 (n 6 IV, psychotic
//   patients on continuous oral haloperidol: plasma CL 6.5 mL/min/kg, Vss 7.9 +/- 2.5 L/kg) and
//   Chang 1992 (PMID 1579624, n 8 Chinese patients: CL 21.7 L/h, half-life 55-60 h). They are
//   validation rows and enter the all-population pool printed next to the healthy one.
//   Forsman and Ohman 1976 (Curr Ther Res 20:319) has no abstract in PubMed and no readable
//   copy was found: its parameters are NOT used.
//
// NOT FITTED: the tissue permeability scalar (pssc). The only sourced rate observables are the
// two distribution half-lives of ONE study (Holley 1983: 0.19 +/- 0.07 h and 2 +/- 1 h, n 6, AB);
// they are used as validation rows. Measured by the test (S3c): with the default ps the venous
// curve has no falling fast phase; the fast half-life is 0.18-0.27 h for any scalar between 0.02
// and 0.2 (flat: the scalar is not identified), and lowering ps raises the oral Cmax and lengthens
// the 12-36 h half-life, both already above the observations. The slot stays at the default.
//
// CLOSED FORMS OF THE FITS (kernel equations):
//   kpsc  = (V_ss - bp V_blood) / sum_i V_i (1 - vf_i) Kp_RR,i        (circ28_kp_scale_for_vss)
//   CL_blood,h = (CL_plasma - CL_renal) / bp;  Eh = CL_blood,h / Q_h
//   y = bp Q_h Eh / (1 - Eh);  clint fu = y ps_liver / (ps_liver - y)
// (renal clearance in the kernel acts on arterial plasma, in parallel with the liver).

use darwin_pbpk::circ28::*
use darwin_pbpk::circ28_kp::*
use darwin_pbpk::circ28_drug::*
use math::pure::{exp, ln}

// ---- measured / derived inputs -------------------------------------------------
pub fn hal_mw() -> f64 { return 376.0 }
pub fn hal_logp() -> f64 { return 0.5 * (4.30 + 3.23) }
pub fn hal_u_logp() -> f64 { return (4.30 - 3.23) / 3.4641016151377544 }
pub fn hal_pka1() -> f64 { return 8.66 }
pub fn hal_u_pka1() -> f64 { return (8.66 - 7.8) / 3.4641016151377544 }
pub fn hal_fu() -> f64 { return 0.5 * (0.075 + 0.116) }
pub fn hal_u_fu() -> f64 { return (0.116 - 0.075) / 3.4641016151377544 }
pub fn hal_bp_cheng() -> f64 { return 0.79 }
pub fn hal_bp_mamada() -> f64 { return 1.08 }
pub fn hal_bp() -> f64 { return 0.5 * (hal_bp_cheng() + hal_bp_mamada()) }
pub fn hal_u_bp() -> f64 { return (hal_bp_mamada() - hal_bp_cheng()) / 3.4641016151377544 }
// Fraction of a dose excreted unchanged in urine (Alasmari 2022 text, citing Kudo 1999).
pub fn hal_fe_renal() -> f64 { return 0.01 }
// Oral absorption (Holley 1983, abstract; n 8 healthy men, 0.5 mg/kg).
pub fn hal_abs_thalf() -> f64 { return 0.37 }
pub fn hal_u_abs_thalf() -> f64 { return 0.18 / 2.8284271247461903 }
pub fn hal_ka() -> f64 { return 0.6931471805599453 / hal_abs_thalf() }
pub fn hal_u_ka() -> f64 { return hal_ka() * hal_u_abs_thalf() / hal_abs_thalf() }
pub fn hal_tlag() -> f64 { return 0.82 }
pub fn hal_u_tlag() -> f64 { return 0.25 / 2.8284271247461903 }
// Body weight of the kernel physiology (ICRP 89 reference male): per-kg literature values
// are multiplied by it.
pub fn hal_bw() -> f64 { return 73.0 }

// Share of haloperidol biotransformation that goes through reduction to reduced haloperidol
// in vivo: "about 23 %" (Jann, Lam, Chang 1990, PMID 2343070, AB; 6 Chinese male patients,
// single 10 mg doses of haloperidol and of reduced haloperidol, crossover, interconversion
// model). REPORTED ONLY: reduced haloperidol is not a state here and the back-oxidation is not
// modelled.
pub fn hal_share_reduction() -> f64 { return 0.23 }
// Glucuronidation: "more than 50 %" of the elimination (Alasmari 2022 text, FT, citing the
// in vitro literature). Lower bound used as a share.
pub fn hal_share_ugt_min() -> f64 { return 0.50 }
// Upper bound of the CYP (CYP3A4) share = 1 - reduction - glucuronidation lower bound.
pub fn hal_share_cyp_max() -> f64 { return 1.0 - hal_share_reduction() - hal_share_ugt_min() }

// ---- pooling (same rule as the midazolam module) ---------------------------------
pub struct HalPool {
    pub mean: f64,
    pub n_tot: f64,
    pub k: i32,
    pub sw: f64,
    pub se_w: f64,
    pub sb: f64,
    pub se_b: f64,
    pub u: f64,
}

fn hal_abs(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

pub fn hal_pool(m: &[f64; 8], s: &[f64; 8], n: &[f64; 8], k: i32) -> HalPool with Mut, Div, Panic {
    var sn = 0.0
    var sm = 0.0
    var mm = 0.0
    var num = 0.0
    var den = 0.0
    var i: i32 = 0
    while i < k {
        sn = sn + (*n)[i]
        sm = sm + (*n)[i] * (*m)[i]
        mm = mm + (*m)[i]
        if (*s)[i] > 0.0 && (*n)[i] > 1.0 {
            num = num + ((*n)[i] - 1.0) * (*s)[i] * (*s)[i]
            den = den + ((*n)[i] - 1.0)
        }
        i = i + 1
    }
    let kf = k as f64
    let mbar = mm / kf
    var ss = 0.0
    i = 0
    while i < k {
        let dv = (*m)[i] - mbar
        ss = ss + dv * dv
        i = i + 1
    }
    var sb = 0.0
    if k > 1 { sb = cd_sqrt(ss / (kf - 1.0)) }
    var sw = 0.0
    if den > 0.0 { sw = cd_sqrt(num / den) }
    let se_w = sw / cd_sqrt(sn)
    let se_b = sb / cd_sqrt(kf)
    var u = se_w
    if se_b > u { u = se_b }
    return HalPool { mean: sm / sn, n_tot: sn, k: k, sw: sw, se_w: se_w, sb: sb, se_b: se_b, u: u }
}

// ---- IV plasma clearance, mL/min/kg ------------------------------------------------
// set 0 (FIT): healthy adults
//   0 Holley 1983 (PMID 6831826, AB): 0.125 mg/kg IV, 11.8 +/- 2.9 (SD), n 12 men
//   1 Forsman and Ohman 1974 (Nord Psykiatr Tidsskr 28:441): 10 mg IV, n 12 healthy; 11.9 is
//     the non-compartmental value of Alasmari 2022 Table 4 from the digitised mean curve (SEC),
//     no SD
//   2 Miller 2008 (PMID 18576902): 2.5 mg IV over 15 min, n 4 healthy; 11.55 from Alasmari
//     Table 4 (SEC), no SD
// set 1 (ALL POPULATIONS, printed, not fitted): adds
//   3 Cheng 1987 (PMID 3108922, AB): blood CL 550 +/- 133 mL/min, blood/plasma 0.79, so plasma
//     CL 434.5 +/- 105.1 mL/min; mean weight 67 kg (Alasmari Table 1, n 6 IV): 6.485 +/- 1.568.
//     Psychotic patients under continuous oral haloperidol.
//   4 Chang 1992 (PMID 1579624, AB): 21.7 L/h, n 8 Chinese patients, mean 63.3 kg (Alasmari
//     Table 1): 5.714; no SD in the abstract. (Alasmari Table 4 lists 6.20 as the reported value.)
// NOT pooled: Magliozzi 1985 J Clin Pharmacol (PMID 4008674): the same 12 IV subjects as Holley
// 1983 (same laboratory, dose and n; Alasmari's value 12.02); Li 2022 (PMC8950491, ICU delirium,
// population estimate 51.7 L/h, clearance falls with C-reactive protein).
pub fn hal_cl_studies(set: i32, m: &![f64; 8], s: &![f64; 8], n: &![f64; 8]) -> i32 with Mut, Div, Panic {
    (*m)[0] = 11.8
    (*s)[0] = 2.9
    (*n)[0] = 12.0
    (*m)[1] = 11.9
    (*s)[1] = 0.0 - 1.0
    (*n)[1] = 12.0
    (*m)[2] = 11.55
    (*s)[2] = 0.0 - 1.0
    (*n)[2] = 4.0
    if set == 0 { return 3 }
    (*m)[3] = 550.0 * 0.79 / 67.0
    (*s)[3] = 133.0 * 0.79 / 67.0
    (*n)[3] = 6.0
    (*m)[4] = 21.7 * 1000.0 / 60.0 / 63.3
    (*s)[4] = 0.0 - 1.0
    (*n)[4] = 8.0
    return 5
}

// ---- V_ss, L/kg ---------------------------------------------------------------------
// set 0 (FIT): 0 Holley 1983: 17.8 +/- 6.5, n 12 healthy men (AB). The only healthy study.
// set 1 (ALL): adds 1 Cheng 1987: 7.9 +/- 2.5, n 6 patients (AB; serum).
// NOT pooled: Chang 1992 "volume of distribution during the distribution phase 1754 L" (another
// volume); Li 2022 one-compartment V 1490 L (ICU).
pub fn hal_vss_studies(set: i32, m: &![f64; 8], s: &![f64; 8], n: &![f64; 8]) -> i32 with Mut, Div, Panic {
    (*m)[0] = 17.8
    (*s)[0] = 6.5
    (*n)[0] = 12.0
    if set == 0 { return 1 }
    (*m)[1] = 7.9
    (*s)[1] = 2.5
    (*n)[1] = 6.0
    return 2
}

// ---- terminal half-life, h (VALIDATION; never fitted) ----------------------------------
// The value depends on how long the curve was followed, so two classes are pooled apart.
// SAMPLING DURATION per study: stated only where the abstract gives it.
// class 0, short or unstated sampling (classical GC/HPLC studies):
//   0 Holley 1983: 17.9 +/- 6.4, n 15 (IV and oral together; duration not in the abstract)
//   1 Cheng 1987: 18.8 after IV, n 6 (no SD; duration not in the abstract)
//   2 Magliozzi and Hollister 1985 (PMID 3965439, AB): 15.1 +/- 2.5 after IV, n 3 patients
//   3 Llerena 1992 (PMID 1585408, AB): 16.3 +/- 6.4, n 6 extensive metabolisers, 4 mg oral
// class 1, long sampling (60 h or more) or a three-compartment fit:
//   0 Yun 2005 (PMID 15918525, AB): 29.6 +/- 7.56 (reference tablet 5 mg), n 24 healthy
//     Koreans, sampled for 60 h, LC-MS
//   1 Chang 1992: 54.8 (model) / 59.9 (non-compartmental) after IV, n 8 patients; 54.8 used
//   2 Forsman 1981 (PMID 7333324, AB): 25.1 +/- 12.9, n 19 surgical patients, single oral dose
pub fn hal_thalf_studies(class: i32, m: &![f64; 8], s: &![f64; 8], n: &![f64; 8]) -> i32 with Mut, Div, Panic {
    if class == 0 {
        (*m)[0] = 17.9
        (*s)[0] = 6.4
        (*n)[0] = 15.0
        (*m)[1] = 18.8
        (*s)[1] = 0.0 - 1.0
        (*n)[1] = 6.0
        (*m)[2] = 15.1
        (*s)[2] = 2.5
        (*n)[2] = 3.0
        (*m)[3] = 16.3
        (*s)[3] = 6.4
        (*n)[3] = 6.0
        return 4
    }
    (*m)[0] = 29.6
    (*s)[0] = 7.56
    (*n)[0] = 24.0
    (*m)[1] = 54.8
    (*s)[1] = 0.0 - 1.0
    (*n)[1] = 8.0
    (*m)[2] = 25.1
    (*s)[2] = 12.9
    (*n)[2] = 19.0
    return 3
}

// ---- oral bioavailability (VALIDATION) ------------------------------------------------------
//   0 Holley 1983: 0.65 +/- 0.14, n 8 healthy (AB)
//   1 Cheng 1987: 0.60 +/- 0.18, n 8 patients (AB; n of the oral arm from Alasmari Table 1)
//   2 Magliozzi and Hollister 1985: 0.64 +/- 0.23, n 6 patients (AB)
//   3 Chang 1992: 0.35 +/- 0.08, n 6 Chinese patients (AB)
// Froemming 1989 (PMID 2689040, AB) summarises "60 to 65 %".
pub fn hal_f_studies(m: &![f64; 8], s: &![f64; 8], n: &![f64; 8]) -> i32 with Mut, Div, Panic {
    (*m)[0] = 0.65
    (*s)[0] = 0.14
    (*n)[0] = 8.0
    (*m)[1] = 0.60
    (*s)[1] = 0.18
    (*n)[1] = 8.0
    (*m)[2] = 0.64
    (*s)[2] = 0.23
    (*n)[2] = 6.0
    (*m)[3] = 0.35
    (*s)[3] = 0.08
    (*n)[3] = 6.0
    return 4
}

// ---- single oral dose: AUC(0-inf) per mg, ng h/mL per mg (VALIDATION) ----------------------
//   0 Holley 1983: 0.503 mg/kg, mean 70.8 kg (35.61 mg), AUC 566 (reported), n 8 healthy
//     (Alasmari Table 5 / Table 1: SEC)
//   1 Chang 1992: 0.5 mg/kg, mean 63.3 kg (31.65 mg), AUC 512.6 (reported), n 6 patients (SEC)
//   2 Jann 1990 (PMID 2343070): 10 mg, AUC 200.5 (reported), n 6 Chinese patients (SEC)
//   3 Midha 1989 (PMID 2723140): 5 mg, AUC 44 (Alasmari's non-compartmental value from the
//     digitised curve), n 28 healthy men, sampled 96 h (SEC)
//   4 Yun 2005: 5 mg tablet, AUCinf 21.77 +/- 15.63 (reference), n 24 healthy Koreans (AB)
//   5 Park 2006 (PMID 16633141, AB): 5 mg, AUC 21.7 +/- 11.3, CYP2D6*1/*1, placebo phase, n 8
//     healthy Koreans
// NOT in the list: Magliozzi 1985 (same subjects as Holley); Cheng 1987 2 mg (a test dose on top
// of continuous treatment); Llerena 1992 (CL/F per kg, weight not in the abstract).
pub fn hal_aucpm_studies(m: &![f64; 8], s: &![f64; 8], n: &![f64; 8]) -> i32 with Mut, Div, Panic {
    (*m)[0] = 566.0 / (0.503 * 70.8)
    (*s)[0] = 0.0 - 1.0
    (*n)[0] = 8.0
    (*m)[1] = 512.6 / (0.5 * 63.3)
    (*s)[1] = 0.0 - 1.0
    (*n)[1] = 6.0
    (*m)[2] = 200.5 / 10.0
    (*s)[2] = 0.0 - 1.0
    (*n)[2] = 6.0
    (*m)[3] = 44.0 / 5.0
    (*s)[3] = 0.0 - 1.0
    (*n)[3] = 28.0
    (*m)[4] = 21.77 / 5.0
    (*s)[4] = 15.63 / 5.0
    (*n)[4] = 24.0
    (*m)[5] = 21.7 / 5.0
    (*s)[5] = 11.3 / 5.0
    (*n)[5] = 8.0
    return 6
}

// ---- single oral dose: Cmax per mg, ng/mL per mg (VALIDATION) -------------------------------
//   0 Holley 1983: 37.4 / 35.61 mg (Alasmari's value from the digitised curve; SEC), n 8
//   1 Chang 1992: 19.76 / 31.65 mg (SEC), n 6
//   2 Jann 1990: 8.34 / 10 mg (SEC), n 6
//   3 Midha 1989: 1.27 / 5 mg (SEC), n 28
//   4 Yun 2005: 0.85 +/- 0.62 / 5 mg (AB), n 24
pub fn hal_cmaxpm_studies(m: &![f64; 8], s: &![f64; 8], n: &![f64; 8]) -> i32 with Mut, Div, Panic {
    (*m)[0] = 37.4 / (0.503 * 70.8)
    (*s)[0] = 0.0 - 1.0
    (*n)[0] = 8.0
    (*m)[1] = 19.76 / (0.5 * 63.3)
    (*s)[1] = 0.0 - 1.0
    (*n)[1] = 6.0
    (*m)[2] = 8.34 / 10.0
    (*s)[2] = 0.0 - 1.0
    (*n)[2] = 6.0
    (*m)[3] = 1.27 / 5.0
    (*s)[3] = 0.0 - 1.0
    (*n)[3] = 28.0
    (*m)[4] = 0.85 / 5.0
    (*s)[4] = 0.62 / 5.0
    (*n)[4] = 24.0
    return 5
}

// ---- steady-state concentration per daily dose, ng/mL per mg/day (VALIDATION) --------------
//   0 Yukawa 2002 (PMID 11888334, AB): population CL/F 42.4 L/h for 60 kg, age < 55, 200 ug/kg/day
//     (12 mg/day), no antiepileptic; 218 Japanese patients, 391 serum concentrations:
//     C/D = 1000 / (42.4 x 24) = 0.983. (Yukawa 2000, PMID 11106142, gives 47.4 L/h from
//     overlapping patients: not a second study.)
//   1, 2 Perry 1993 (PMID 8486817, AB): fixed oral doses 10 to 70 mg/day for 2 weeks, n 40,
//     mean steady-state concentrations 4.5 to 55.4 ng/mL: the two ends, 0.45 and 0.791. Only
//     the ends are in the abstract; n is split 20/20 for the pooling (an assignment).
// Roh 2001, Pan 1999, Brockmoller 2002: the dose-normalised values are not in the abstracts.
pub fn hal_css_studies(m: &![f64; 8], s: &![f64; 8], n: &![f64; 8]) -> i32 with Mut, Div, Panic {
    (*m)[0] = 1000.0 / (42.4 * 24.0)
    (*s)[0] = 0.0 - 1.0
    (*n)[0] = 218.0
    (*m)[1] = 4.5 / 10.0
    (*s)[1] = 0.0 - 1.0
    (*n)[1] = 20.0
    (*m)[2] = 55.4 / 70.0
    (*s)[2] = 0.0 - 1.0
    (*n)[2] = 20.0
    return 3
}

// ---- rifampicin: IV midazolam AUC ratio (hepatic CYP3A induction probe) ---------------------
// perpetrator_parameters.md row "rifampicin 600 mg qd, IV midazolam" (Hanke 2018 Table 1):
// 0.378 (n 9), 0.521 (n 10), 0.481 (n 6), 0.655 (n 8), 0.579 (n 3), 0.512 (n 14).
pub fn hal_rif_mdz_studies(m: &![f64; 8], s: &![f64; 8], n: &![f64; 8]) -> i32 with Mut, Div, Panic {
    (*m)[0] = 0.378
    (*n)[0] = 9.0
    (*m)[1] = 0.521
    (*n)[1] = 10.0
    (*m)[2] = 0.481
    (*n)[2] = 6.0
    (*m)[3] = 0.655
    (*n)[3] = 8.0
    (*m)[4] = 0.579
    (*n)[4] = 3.0
    (*m)[5] = 0.512
    (*n)[5] = 14.0
    var i: i32 = 0
    while i < 6 {
        (*s)[i] = 0.0 - 1.0
        i = i + 1
    }
    return 6
}
// Hepatic extraction of midazolam in this kernel (drug_midazolam_report.md, round 4): 0.314.
pub fn hal_mdz_eh() -> f64 { return 0.314 }
// Fold increase of hepatic CYP3A intrinsic clearance under rifampicin 600 mg/day, DERIVED from
// the pooled IV-midazolam AUC ratio r with the well-stirred liver and midazolam taken as
// cleared by hepatic CYP3A alone: Eh' = Eh / r, fold = [Eh'/(1-Eh')] / [Eh/(1-Eh)].
pub fn hal_rif_fold(r: f64) -> f64 with Div {
    let e0 = hal_mdz_eh()
    let e1 = e0 / r
    return (e1 / (1.0 - e1)) / (e0 / (1.0 - e0))
}

pub fn hal_pool_cl(set: i32) -> HalPool with Mut, Div, Panic {
    var m: [f64; 8] = [0.0; 8]
    var s: [f64; 8] = [0.0; 8]
    var n: [f64; 8] = [0.0; 8]
    let k = hal_cl_studies(set, &!m, &!s, &!n)
    return hal_pool(&m, &s, &n, k)
}
pub fn hal_pool_vss(set: i32) -> HalPool with Mut, Div, Panic {
    var m: [f64; 8] = [0.0; 8]
    var s: [f64; 8] = [0.0; 8]
    var n: [f64; 8] = [0.0; 8]
    let k = hal_vss_studies(set, &!m, &!s, &!n)
    return hal_pool(&m, &s, &n, k)
}
pub fn hal_pool_thalf(class: i32) -> HalPool with Mut, Div, Panic {
    var m: [f64; 8] = [0.0; 8]
    var s: [f64; 8] = [0.0; 8]
    var n: [f64; 8] = [0.0; 8]
    let k = hal_thalf_studies(class, &!m, &!s, &!n)
    return hal_pool(&m, &s, &n, k)
}
pub fn hal_pool_f() -> HalPool with Mut, Div, Panic {
    var m: [f64; 8] = [0.0; 8]
    var s: [f64; 8] = [0.0; 8]
    var n: [f64; 8] = [0.0; 8]
    let k = hal_f_studies(&!m, &!s, &!n)
    return hal_pool(&m, &s, &n, k)
}
