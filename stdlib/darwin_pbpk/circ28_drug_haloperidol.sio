    var m: [f64; 8] = [0.0; 8]
    var s: [f64; 8] = [0.0; 8]
    var n: [f64; 8] = [0.0; 8]
    let k = hal_aucpm_studies(&!m, &!s, &!n)
    return hal_pool(&m, &s, &n, k)
}
