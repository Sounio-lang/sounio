// stdlib/darwin_pbpk/circ28_drug_lithium.sio — lithium on the circ28 drug record
//
// Lithium in a healthy adult (ICRP 89 reference male, 73 kg), oral lithium carbonate.
// An ion: not protein bound (see fu), not metabolised, eliminated by the kidney
// (filtered, ~3/4 of the filtered load reabsorbed in the proximal tubule with sodium).
// It tests the RENAL side of the kernel: cl_renal acts on the arterial plasma reaching
// the kidney, so with no other route the plasma clearance IS cl_renal and
// AUC_plasma = Dose / cl_renal exactly (closed form, checked by the test).
//
// Every number is traceable to a row below. Abstract-level sources were opened through
// PubMed (2026-11-15); each row says what was and was not read. Nothing is from memory.
//
// STATUS: 1 measured, 2 derived by a stated formula from cited measurements, 3 fitted
// to ONE named observable (that observable is then NOT a validation), 0 unused.
// u is the STANDARD UNCERTAINTY OF THE VALUE (what enters the budget), never an
// inter-individual SD. Mean of n subjects with SD: u = SD/sqrt(n). A range: range/sqrt(12).
// "judgment" marks a number with no source for its uncertainty.
//
//  param   value    u        status  basis / source
//  MW      7.0      0        1       Li (PubChem CID 3028194, printed to one decimal only: 7.0);
//                                    Li2CO3 73.9 (PubChem CID 11125). 0.5 mEq/kg = 18.5 mg/kg of
//                                    Li2CO3 in Tomaszewski 1992 gives 37.0 mg per mEq, MW 74.0
//  logP    -        -        0       not applicable (ion); pKa, ion class likewise unused
//  fu      1.0      0        0       UNUSED in this model (no metabolism, Kp is fitted to Vss, so fu
//                                    cannot enter). Clarke 1998 Biol Trace Elem Res (PMID 9892496,
//                                    abstract, via the dossier): 13 +/- 4 % and 16 +/- 3 % bound by
//                                    ethanol precipitation, two donors, a method that can precipitate
//                                    free ion with protein; not used
//  B:P     0.7030   0.0084   2       bp = (1 - Hct) + Hct r. r = erythrocyte:plasma ratio, MALE
//                                    healthy volunteers 0.34 +/- 0.03 (n = 8; Li2CO3 8 mEq x3 daily
//                                    x 2 weeks, steady state), Lyttkens, Soderberg, Wetterberg 1976
//                                    Upsala J Med Sci 81:123 (full text via WebFetch, dossier gaps_D3);
//                                    u(r) = 0.03/sqrt(8) = 0.0106 TAKING the +/- as an SD (if it is an
//                                    SEM u(r) is 0.03). Corroboration, not used: females 0.39 (same
//                                    paper); 36.7 +/- 22.7 % after a single 300 mg dose, n not read,
//                                    Arancibia 2003 Int J Clin Pharmacol Ther 41:200 (PMID 12776810,
//                                    abstract). Hct 0.45 (circ28_kp_hct, Rodgers-Rowland), u = range/
//                                    sqrt12 of [0.434, 0.47] = 0.0104: 0.434 is the red-cell share of
//                                    total blood volume, ICRP 89 Table 2.12 (2300/5300), 0.47 the venous
//                                    Hct of PK-Sim (physiology_primary.md s5)
//  clren   1.398 L/h 0.0150  1       OBSERVED lithium clearance 23.3 +/- 6.1 mL/min, n = 592 untreated
//                                    white men (SD of individuals, u = SD/sqrt(592) = 0.251 mL/min),
//                                    Cappuccio & Strazzullo 1993 Clin Sci 85:479 (PDF via WebFetch).
//                                    Same paper: creatinine clearance 98.5 +/- 21.6 mL/min and
//                                    fractional excretion FE = CLLi/Ccr = 23.8 +/- 5.0 % (n = 592).
//                                    FE x ICRP 89 GFR (125 mL/min, physiology_primary.md s5, ICRP 89
//                                    s8.2, middle-aged male) = 29.8 mL/min, 28 % above the observed
//                                    clearance because that cohort's Ccr (98.5) is 21 % below the ICRP
//                                    GFR. The observed clearance is used; the FE route is printed.
//                                    Other sources, not used: 23.0 +/- 6.2 mL/min (n = 8, 63 kg, Reiss
//                                    1994 Clin Pharmacol Ther 55:392, PMID 8162665); total body clearance
//                                    0.0241 +/- 0.0102 L/kg/h (n = 8, Arancibia 1986 Int J Clin Pharmacol
//                                    Ther Toxicol 24:240, PMID 3089949) = 1.76 L/h at 73 kg
//  clint, clform, clgut, clpla   0   0   no hepatic, gut or plasma route (about 99 % of body
//                                    lithium leaves in urine: Horton 2012, secondary, dossier s14)
//  kpsc    fitted   propagated 3     FITTED to V_ss = 41.6 L (below), on a WATER pattern: Kp_i =
//                                    kpsc (fEW_i + fIW_i), the tissue water fractions of the
//                                    circ28_kp composition record. NOT Rodgers-Rowland: lithium is
//                                    a hydrophilic ion with no lipid partition and no ion trapping
//                                    by pH; its distribution space is body water (label: "approximates
//                                    that of total body water", DailyMed ER tablet label, dossier)
//  pssc    fitted   propagated 3     FITTED to the central volume V1 = 0.224 L/kg x 73 kg = 16.35 L
//                                    (Arancibia 1986), by curve peeling of an IV bolus (see
//                                    OBSERVABLES). The first attempt fitted the alpha half-life 1.40 h;
//                                    alpha(pssc) is non-monotone near 1.40 (plateau) and alpha 1.40
//                                    needs V1 about 6 L and a terminal t1/2 of 36 h, so alpha was made
//                                    a VALIDATION (disclosed in the test header). Lithium
//                                    crosses cell membranes slowly (Na/H exchange, Na-Li
//                                    countertransport), so distribution is permeability-limited; the
//                                    one scalar multiplies every organ's ps (default 20 Q_i)
//  ka      fitted   propagated 3     FITTED to the oral Tmax 1.44 h (below)
//  fa      0.945    0.0159   1       urinary recovery after the immediate-release tablet 94.5 %
//                                    (Arancibia 1986; lithium is not metabolised, so urinary recovery
//                                    is F). u = range/sqrt12 of [0.945, 1.0], judgment (no SD in abstract)
//  tlag    0        -        0       unused
//
// OBSERVABLES USED TO FIT (one per fitted parameter; NOT validations):
//   V_ss  41.6 L, u 3.57 L.  Reiss 1994 (PMID 8162665): 8 evaluable normal-weight volunteers
//         (63.1 +/- 6.6 kg), oral lithium citrate 31.4 mEq, 48 h sampling: Vss 0.66 +/- 0.16 L/kg
//         (SD). 0.66 x 63.1 = 41.6 L; u = 0.16 x 63.1/sqrt(8). Weight uncertainty ignored. The value
//         is taken as an absolute volume (total body water does not scale with total weight). A
//         second source, 0.445 +/- 0.106 L/kg (Arancibia 1986, n = 8, weight not in abstract), is the
//         VALIDATION of Vss.
//   V1    16.35 L, u 1.71 L.  Arancibia 1986 (n = 8): central volume 0.224 +/- 0.066 L/kg (SD) x 73 kg.
//         This is the observable of the pssc fit (li_obs_v1, li_u_v1).
//   alpha (VALIDATION, not fitted)  1.40 h.  Arancibia 1986 (n = 8): half-life of the distribution alpha phase
//         1.40 +/- 0.27 h (SD), two-compartment fit to oral data. The model's alpha is obtained from
//         an intravenous bolus by curve peeling with windows fixed a priori (li_peel: terminal
//         fit 24-96 h, residual fit 0.5-5 h). The comparison of a peeled PBPK curve with a
//         two-exponential fit of oral data is approximate and method-dependent; it is the
//         one observable of the distribution phase and is named as such.
//   Tmax  1.44 h, u 0.144 h.  Arancibia 1986, immediate-release tablet: time of peak 1.44 h (no SD in
//         the abstract). u = 0.5 h/sqrt12 (an assumed 0.5 h sampling interval, judgment). Guelen 1992
//         (Biopharm Drug Dispos 13:503, PMID 1489941, n = 18, tablets) gives 1.4 h: the same number, so
//         it is not an independent test and is not used as one.
//
// CLOSED FORMS USED BY THE FITS (kernel equations)
//   kpsc = (V_ss - bp V_blood) / sum_i V_i (1 - vf_i) w_i,  w_i = fEW_i + fIW_i
//          (circ28_kp_scale_for_vss on the water pattern)
//   pssc, ka: roots of V1(pssc) = V1_obs and Tmax(ka) = Tmax_obs by bisection on kernel runs
//          (offline; the stored values are LI_PSSC and LI_KA, re-checked by the test)
//
// WHAT IS VALIDATION: terminal t1/2; alpha; V_ss from a second study; the total
// clearance from the same study as alpha (Arancibia 1986 values that no fit used); Cmax and
// AUC(0-24 h) after a stated single dose (Tomaszewski 1992); the steady-state trough of a stated
// regimen (Apseloff 1995, derived); brain:serum at steady state; the three interaction what-ifs.
// Criteria and expectations are written in tests/run-pass/circ28_drug_lithium.sio.
//
// WHAT THE KERNEL ASSUMES AND LITHIUM VIOLATES. The kernel equilibrates blood and plasma
// instantaneously (bp constant). Lithium enters red cells slowly (Na-Li countertransport and
// leak, hours; Lyttkens 1976 saw no lag at their sampling, plasma 95 % of steady state in 4 days).
// The test brackets the effect by rerunning with bp = 1 - Hct (no red-cell uptake) and the same
// V_ss and prints the difference in the early profile.

use darwin_pbpk::circ28::*
use darwin_pbpk::circ28_kp::*
use darwin_pbpk::circ28_drug::*
use math::pure::{exp, ln}

// ---- measured / derived inputs ---------------------------------------------
pub fn li_mw() -> f64 { return 7.0 }
pub fn li_mw_carbonate() -> f64 { return 73.9 }
pub fn li_hct() -> f64 { return 0.45 }
pub fn li_u_hct() -> f64 { return 0.0104 }
pub fn li_rbc() -> f64 { return 0.34 }
pub fn li_u_rbc() -> f64 { return 0.0106 }
pub fn li_bp_of(hct: f64, r: f64) -> f64 { return 1.0 - hct + hct * r }
pub fn li_u_bp() -> f64 with Mut, Div {
    let a = (li_rbc() - 1.0) * li_u_hct()
    let b = li_hct() * li_u_rbc()
    return cd_sqrt(a * a + b * b)
}
pub fn li_cl_mlmin() -> f64 { return 23.3 }
pub fn li_u_cl_mlmin() -> f64 { return 0.2507 }
pub fn li_fe() -> f64 { return 0.238 }
pub fn li_gfr_icrp() -> f64 { return 125.0 }
pub fn li_fa() -> f64 { return 0.945 }
pub fn li_u_fa() -> f64 { return 0.0159 }

// Observables of the fits
pub fn li_obs_vss() -> f64 { return 0.66 * 63.1 }
pub fn li_u_vss() -> f64 { return 0.16 * 63.1 / 2.8284271247461903 }
// Central volume V1 = 0.224 +/- 0.066 L/kg (SD, n = 8; Arancibia 1986) x 73 kg (ICRP reference man;
// the subjects' weights are not in the abstract)
pub fn li_obs_v1() -> f64 { return 0.224 * 73.0 }
pub fn li_u_v1() -> f64 { return 0.066 * 73.0 / 2.8284271247461903 }
// Validation values of the same study (not used for any fit)
pub fn li_val_alpha() -> f64 { return 1.40 }
pub fn li_val_alpha_sd() -> f64 { return 0.27 }
pub fn li_obs_tmax() -> f64 { return 1.44 }
pub fn li_u_tmax() -> f64 { return 0.5 / 3.4641016151377544 }

// Stored results of the offline bisections (re-checked by the test)
pub fn li_pssc_fit() -> f64 { return 0.002840382 }
pub fn li_ka_fit() -> f64 { return 0.8754726387 }

// ---- molar arithmetic --------------------------------------------------------
// mmol of lithium in `mg` of lithium carbonate (Li2CO3, two Li per formula unit)
pub fn li_mmol_of_carbonate_mg(mg: f64) -> f64 { return 2.0 * mg / li_mw_carbonate() }
// mg of lithium ion in the same mmol (MW 7.0 as printed by PubChem)
pub fn li_mg_ion_of_mmol(mmol: f64) -> f64 { return mmol * li_mw() }

// ---- the water pattern ---------------------------------------------------------
pub fn li_water(i: i32) -> f64 { return circ28_kp_few(i) + circ28_kp_fiw(i) }

pub fn li_pattern(out: &![f64; 14]) with Mut {
    var i: i32 = 1
    while i < 14 {
        (*out)[i] = li_water(i)
        i = i + 1
    }
}

// ---- record --------------------------------------------------------------------
// Value array of the record with the kernel's Kp slots: the water pattern is not an entry
// of the 18-slot record, so the parameters of a run are built by li_params below.
pub fn li_params(th: &[f64; 18]) -> Circ28Params with Mut, Div, Panic {
    var t2: [f64; 18] = [0.0; 18]
    var k: i32 = 0
    while k < 18 {
        t2[k] = (*th)[k]
        k = k + 1
    }
    var p = circ28_drug_params_theta(t2)
    var pat: [f64; 14] = [0.0; 14]
    li_pattern(&!pat)
    var i: i32 = 1
    while i < 14 {
        p.kp[i] = (*th)[CD_KPSC] * pat[i]
        i = i + 1
    }
    return p
}

// kpsc for a given bp and V_ss (closed form on the water pattern)
pub fn li_kpsc_for(bp: f64, vss: f64) -> f64 with Mut, Div, Panic {
    var p = circ28_physiology()
    p.bp = bp
    var pat: [f64; 14] = [0.0; 14]
    li_pattern(&!pat)
    return circ28_kp_scale_for_vss(p, pat, vss)
}

// ---- profiles ---------------------------------------------------------------------
// Grid: 0.05 h to 3 h (60 steps), then 0.25 h to 312 h (1236 steps): 1296 steps.
pub fn li_n1() -> i32 { return 60 }
pub fn li_nmax() -> i32 { return 1296 }
pub fn li_tgrid(k: i32) -> f64 {
    if k <= 60 { return 0.05 * (k as f64) }
    return 3.0 + 0.25 * ((k - 60) as f64)
}
// grid index of time t (t = 3 + 0.25 m)
pub fn li_idx(t: f64) -> i32 {
    if t <= 3.0 { return ((t / 0.05) + 0.5) as i32 }
    return 60 + (((t - 3.0) / 0.25) + 0.5) as i32
}

// One dose of `dose` (mmol) into a fresh body. route 0: IV over 0.05 h; route 1: oral first-order
// (ka, fa, tlag = 0). cs[k] = venous plasma concentration (mmol/L) at li_tgrid(k); cs[0] = 0.
// Returns the plasma AUC 0..312 h (kernel weights); *tail receives c(312 h).
pub fn li_profile(p: Circ28Params, dose: f64, route: i32, ka: f64, fa: f64, cs: &![f64; 1300], tail: &![f64; 2]) -> f64 with Mut, Div, Panic {
    var sys = circ28_sys_zero()
    var s = circ28_state_zero()
    var el = circ28_elim_zero()
    var k: i32 = 0
    var ph: i32 = 0
    var t = 0.0
    (*cs)[0] = 0.0
    while ph < 2 {
        var dt = 0.05
        var n: i32 = 60
        if ph == 1 {
            dt = 0.25
            n = 1236
        }
        circ28_prepare(p, dt, &!sys)
        var j: i32 = 0
        while j < n {
            var iv = 0.0
            var oral = 0.0
            if route == 0 {
                iv = circ28_iv_mass(dose, 0.05, t, t + dt) / dt
            } else {
                oral = circ28_oral_mass(ka, fa, dose, 0.0, t, t + dt) / dt
            }
            circ28_step(&!s, p, &sys, iv, oral, &!el)
            t = t + dt
            k = k + 1
            (*cs)[k] = s.x[0] / p.bp
            j = j + 1
        }
        ph = ph + 1
    }
    (*tail)[0] = (*cs)[1296]
    (*tail)[1] = s.x[3]
    return el.auc_ven / p.bp
}

// Curve peeling. out[0] terminal rate lambda_z (1/h), out[1] terminal intercept B,
// out[2] alpha rate (1/h), out[3] alpha intercept A. Terminal: log-linear least squares of
// c on [t_lo, t_hi]; residual r = c - B exp(-lambda t) on [a_lo, a_hi] (r > 0), log-linear.
pub fn li_peel(cs: &[f64; 1300], t_lo: f64, t_hi: f64, a_lo: f64, a_hi: f64, out: &![f64; 4]) with Mut, Div, Panic {
    var sw = 0.0
    var st = 0.0
    var sy = 0.0
    var stt = 0.0
    var sty = 0.0
    var k: i32 = 1
    while k <= 1296 {
        let t = li_tgrid(k)
        if t >= t_lo && t <= t_hi && (*cs)[k] > 0.0 {
            let y = ln((*cs)[k])
            sw = sw + 1.0
            st = st + t
            sy = sy + y
            stt = stt + t * t
            sty = sty + t * y
        }
        k = k + 1
    }
    let den = sw * stt - st * st
    let slope = (sw * sty - st * sy) / den
    let icpt = (sy - slope * st) / sw
    let lz = 0.0 - slope
    let b = exp(icpt)
    (*out)[0] = lz
    (*out)[1] = b
    // residual
    sw = 0.0
    st = 0.0
    sy = 0.0
    stt = 0.0
    sty = 0.0
    k = 1
    while k <= 1296 {
        let t = li_tgrid(k)
        if t >= a_lo && t <= a_hi {
            let r = (*cs)[k] - b * exp(0.0 - lz * t)
            if r > 0.0 {
                let y = ln(r)
                sw = sw + 1.0
                st = st + t
                sy = sy + y
                stt = stt + t * t
                sty = sty + t * y
            }
        }
        k = k + 1
    }
    let den2 = sw * stt - st * st
    let slope2 = (sw * sty - st * sy) / den2
    let icpt2 = (sy - slope2 * st) / sw
    (*out)[2] = 0.0 - slope2
    (*out)[3] = exp(icpt2)
}

pub fn li_peel_alpha_half() -> f64 { return 0.0 }

// Peeling windows (fixed a priori)
pub fn li_w_tlo() -> f64 { return 24.0 }
pub fn li_w_thi() -> f64 { return 96.0 }
pub fn li_w_alo() -> f64 { return 0.5 }
pub fn li_w_ahi() -> f64 { return 5.0 }

// alpha half-life (h) of the model for the value array th (IV 1 mmol bolus). One run per call.
pub fn li_alpha_half(th: &[f64; 18]) -> f64 with Mut, Div, Panic {
    let p = li_params(th)
    var cs: [f64; 1300] = [0.0; 1300]
    var tail: [f64; 2] = [0.0; 2]
    let a = li_profile(p, 1.0, 0, 1.0, 1.0, &!cs, &!tail)
    var pe: [f64; 4] = [0.0; 4]
    li_peel(&cs, li_w_tlo(), li_w_thi(), li_w_alo(), li_w_ahi(), &!pe)
    return 0.6931471805599453 / pe[2]
}

// Peeled parameters of the model for th (IV 1 mmol bolus): out[0] alpha half-life (h),
// out[1] central volume V1 = dose / (A + B) (L), out[2] terminal half-life (h),
// out[3] V_area = dose / (B/lambda_z) (L).
pub fn li_peeled(th: &[f64; 18], out: &![f64; 4]) with Mut, Div, Panic {
    let p = li_params(th)
    var cs: [f64; 1300] = [0.0; 1300]
    var tail: [f64; 2] = [0.0; 2]
    let a = li_profile(p, 1.0, 0, 1.0, 1.0, &!cs, &!tail)
    var pe: [f64; 4] = [0.0; 4]
    li_peel(&cs, li_w_tlo(), li_w_thi(), li_w_alo(), li_w_ahi(), &!pe)
    (*out)[0] = 0.6931471805599453 / pe[2]
    (*out)[1] = 1.0 / (pe[1] + pe[3])
    (*out)[2] = 0.6931471805599453 / pe[0]
    (*out)[3] = 1.0 / (pe[0] * (pe[3] / pe[2] + pe[1] / pe[0]))
}

// Tmax (h) of the model for th: 1 mmol oral, ka = th[CD_KA]; parabolic vertex on the grid
pub fn li_tmax(th: &[f64; 18]) -> f64 with Mut, Div, Panic {
    let p = li_params(th)
    var cs: [f64; 1300] = [0.0; 1300]
    var tail: [f64; 2] = [0.0; 2]
    let a = li_profile(p, 1.0, 1, (*th)[CD_KA], (*th)[CD_FA], &!cs, &!tail)
    var im: i32 = 1
    var cm = 0.0
    var k: i32 = 1
    while k <= 120 {
        if cs[k] > cm {
            cm = cs[k]
            im = k
        }
        k = k + 1
    }
    if im > 1 && im < 60 {
        let den = cs[im - 1] - 2.0 * cs[im] + cs[im + 1]
        if den < 0.0 {
            let off = 0.5 * (cs[im - 1] - cs[im + 1]) / den
            return li_tgrid(im) + off * 0.05
        }
    }
    return li_tgrid(im)
}

// Steady-state plasma concentration at time t (h after a dose, t a multiple of 0.25 h) of a
// regimen with interval tau, by superposition of 26 single-dose profiles (the model is linear).
pub fn li_ss_c(cs: &[f64; 1300], t: f64, tau: f64) -> f64 with Mut, Div {
    var c = 0.0
    var n: i32 = 0
    while n < 26 {
        let tt = t + tau * (n as f64)
        if tt <= 312.0 {
            c = c + (*cs)[li_idx(tt)]
        }
        n = n + 1
    }
    return c
}

// Steady-state quantities of `dose_ratio` x the profile in cs (cs is for a unit dose), regimen
// interval tau (a multiple of 0.25 h, <= 12 h): out[0] trough (c at t = tau, equal to c at
// t = 0+ without the new dose), out[1] Cmax on the 0.25 h grid, out[2] its time, out[3] unused,
// out[4] mean over the interval by trapezoid on the 0.25 h grid.
pub fn li_ss_from(cs: &[f64; 1300], dose_ratio: f64, tau: f64, out: &![f64; 5]) with Mut, Div {
    var cmax = 0.0
    var tmax = 0.0
    var area = 0.0
    var prev = li_ss_c(cs, tau, tau) * dose_ratio
    let nm = ((tau / 0.25) + 0.5) as i32
    var m: i32 = 1
    while m <= nm {
        let t = 0.25 * (m as f64)
        let c = li_ss_c(cs, t, tau) * dose_ratio
        if c > cmax {
            cmax = c
            tmax = t
        }
        area = area + 0.5 * (c + prev) * 0.25
        prev = c
        m = m + 1
    }
    (*out)[0] = li_ss_c(cs, tau, tau) * dose_ratio
    (*out)[1] = cmax
    (*out)[2] = tmax
    (*out)[3] = 0.0
    (*out)[4] = area / tau
}

// ---- record fill -----------------------------------------------------------------------
pub fn li_measured_record(d: &!Circ28Drug) with Mut, Div, Panic, Epistemic {
    circ28_drug_set(d, CD_MW, li_mw(), 0.0, CD_STATUS_MEASURED, "PubChem CID 3028194 (Li, 7.0 printed); Li2CO3 73.9 CID 11125")
    circ28_drug_set(d, CD_FU, 1.0, 0.0, CD_STATUS_UNUSED, "unused: no metabolism; Clarke1998 13-16 % ethanol-precipitation binding not used")
    circ28_drug_set(d, CD_BP, li_bp_of(li_hct(), li_rbc()), li_u_bp(), CD_STATUS_DERIVED, "bp = 1 - Hct + Hct r; r 0.34 male (Lyttkens1976 n=8), Hct 0.45")
    circ28_drug_set(d, CD_CLREN, li_cl_mlmin() * 0.06, li_u_cl_mlmin() * 0.06, CD_STATUS_MEASURED, "Cappuccio1993 CLLi 23.3 +/- 6.1 mL/min n=592; u = SD/sqrt(n)")
    circ28_drug_set(d, CD_FA, li_fa(), li_u_fa(), CD_STATUS_MEASURED, "Arancibia1986 urinary recovery 94.5 % (IR tablet); u = range/sqrt12 [0.945, 1]")
}

// Fits (each in its own function; the closed-form kpsc first, then pssc and ka).
pub fn li_fit_kpsc_record(d: &!Circ28Drug) with Mut, Div, Panic, Epistemic {
    let bp = circ28_drug_value(d, CD_BP)
    let u_bp = cd_sqrt(circ28_drug_variance(d, CD_BP))
    let vss = li_obs_vss()
    let k0 = li_kpsc_for(bp, vss)
    let hb = 1.0e-3 * bp
    let hv = 1.0e-4 * vss
    let dk_dbp = (li_kpsc_for(bp + hb, vss) - li_kpsc_for(bp - hb, vss)) / (2.0 * hb)
    let dk_dv = (li_kpsc_for(bp, vss + hv) - li_kpsc_for(bp, vss - hv)) / (2.0 * hv)
    let u = cd_sqrt(dk_dbp * dk_dbp * u_bp * u_bp + dk_dv * dk_dv * li_u_vss() * li_u_vss())
    circ28_drug_set(d, CD_KPSC, k0, u, CD_STATUS_FITTED, "fitted to Vss 41.6 L (Reiss1994) on the tissue-water pattern; u from u(Vss), u(bp)")
}

pub fn li_v1_at(d: &Circ28Drug, pssc: f64) -> f64 with Mut, Div, Panic, Epistemic {
    var th: [f64; 18] = [0.0; 18]
    var i: i32 = 0
    while i < 18 {
        th[i] = circ28_drug_value(d, i)
        i = i + 1
    }
    th[CD_PSSC] = pssc
    var o: [f64; 4] = [0.0; 4]
    li_peeled(&th, &!o)
    return o[1]
}

pub fn li_pssc_record(d: &!Circ28Drug) with Mut, Div, Panic, Epistemic {
    let x = li_pssc_fit()
    let h = 1.0e-2 * x
    let slope = (li_v1_at(d, x + h) - li_v1_at(d, x - h)) / (2.0 * h)
    var sa = slope
    if sa < 0.0 { sa = 0.0 - sa }
    circ28_drug_set(d, CD_PSSC, x, li_u_v1() / sa, CD_STATUS_FITTED, "fitted to the central volume V1 0.224 L/kg x 73 kg (Arancibia1986); u from u(V1)/|dV1/dpssc|")
}

pub fn li_tmax_at(d: &Circ28Drug, ka: f64) -> f64 with Mut, Div, Panic, Epistemic {
    var th: [f64; 18] = [0.0; 18]
    var i: i32 = 0
    while i < 18 {
        th[i] = circ28_drug_value(d, i)
        i = i + 1
    }
    th[CD_KA] = ka
    return li_tmax(&th)
}

pub fn li_ka_record(d: &!Circ28Drug) with Mut, Div, Panic, Epistemic {
    let x = li_ka_fit()
    let h = 1.0e-3 * x
    let slope = (li_tmax_at(d, x + h) - li_tmax_at(d, x - h)) / (2.0 * h)
    var sa = slope
    if sa < 0.0 { sa = 0.0 - sa }
    circ28_drug_set(d, CD_KA, x, li_u_tmax() / sa, CD_STATUS_FITTED, "fitted to the oral Tmax 1.44 h (Arancibia1986 IR tablet); u from u(Tmax)/|dTmax/dka|")
}

pub fn li_drug_into(d: &!Circ28Drug) with Mut, Div, Panic, Epistemic {
    li_measured_record(d)
    li_fit_kpsc_record(d)
    li_pssc_record(d)
    li_ka_record(d)
}

// ---- uncertainty budget with refit ------------------------------------------------------
// Seven inputs: 0 Hct, 1 r (red-cell:plasma), 2 CL_obs (mL/min), 3 V_ss obs (L), 4 V1 obs (L),
// 5 Tmax obs (h), 6 fa. Each evaluation rebuilds bp, cl_renal and fa from the inputs, refits kpsc
// in closed form, pssc by one chord correction on V1 and ka by one chord correction on Tmax
// (slopes taken once at the nominal values), then runs a 1 mmol oral dose. Outputs: out[0] AUC_inf
// of a 300 mg Li2CO3 dose (mmol h / L), out[1] steady-state trough of 450 mg q12h (mmol/L).
pub fn li_u_inputs(u: &![f64; 7]) with Mut {
    (*u)[0] = li_u_hct()
    (*u)[1] = li_u_rbc()
    (*u)[2] = li_u_cl_mlmin()
    (*u)[3] = li_u_vss()
    (*u)[4] = li_u_v1()
    (*u)[5] = li_u_tmax()
    (*u)[6] = li_u_fa()
}
pub fn li_z_nominal(z: &![f64; 7]) with Mut {
    (*z)[0] = li_hct()
    (*z)[1] = li_rbc()
    (*z)[2] = li_cl_mlmin()
    (*z)[3] = li_obs_vss()
    (*z)[4] = li_obs_v1()
    (*z)[5] = li_obs_tmax()
    (*z)[6] = li_fa()
}

pub fn li_eval(z: &[f64; 7], th0: &[f64; 18], slope_v1: f64, slope_t: f64, out: &![f64; 2]) with Mut, Div, Panic {
    var t: [f64; 18] = [0.0; 18]
    var k: i32 = 0
    while k < 18 {
        t[k] = (*th0)[k]
        k = k + 1
    }
    t[CD_BP] = li_bp_of((*z)[0], (*z)[1])
    t[CD_CLREN] = (*z)[2] * 0.06
    t[CD_FA] = (*z)[6]
    t[CD_KPSC] = li_kpsc_for(t[CD_BP], (*z)[3])
    var o: [f64; 4] = [0.0; 4]
    li_peeled(&t, &!o)
    t[CD_PSSC] = t[CD_PSSC] + ((*z)[4] - o[1]) / slope_v1
    let tm = li_tmax(&t)
    t[CD_KA] = t[CD_KA] + ((*z)[5] - tm) / slope_t
    let p = li_params(&t)
    var cs: [f64; 1300] = [0.0; 1300]
    var tail: [f64; 2] = [0.0; 2]
    let a = li_profile(p, 1.0, 1, t[CD_KA], t[CD_FA], &!cs, &!tail)
    var pe: [f64; 4] = [0.0; 4]
    li_peel(&cs, li_w_tlo(), li_w_thi(), li_w_alo(), li_w_ahi(), &!pe)
    (*out)[0] = (a + cs[1296] / pe[0]) * li_mmol_of_carbonate_mg(300.0)
    var ss: [f64; 5] = [0.0; 5]
    li_ss_from(&cs, li_mmol_of_carbonate_mg(450.0), 12.0, &!ss)
    (*out)[1] = ss[0]
}

pub fn li_budget(th0: &[f64; 18], slope_v1: f64, slope_t: f64, b: &![f64; 40]) with Mut, Div, Panic {
    var z0: [f64; 7] = [0.0; 7]
    li_z_nominal(&!z0)
    var u: [f64; 7] = [0.0; 7]
    li_u_inputs(&!u)
    var o0: [f64; 2] = [0.0; 2]
    li_eval(&z0, th0, slope_v1, slope_t, &!o0)
    (*b)[0] = o0[0]
    (*b)[1] = o0[1]
    var va = 0.0
    var vt = 0.0
    var i: i32 = 0
    while i < 7 {
        var hs = 1.0e-3 * z0[i]
        if hs > 0.1 * u[i] { hs = 0.1 * u[i] }
        var zp: [f64; 7] = [0.0; 7]
        var zm: [f64; 7] = [0.0; 7]
        var j: i32 = 0
        while j < 7 {
            zp[j] = z0[j]
            zm[j] = z0[j]
            j = j + 1
        }
        zp[i] = z0[i] + hs
        zm[i] = z0[i] - hs
        var op: [f64; 2] = [0.0; 2]
        var om: [f64; 2] = [0.0; 2]
        li_eval(&zp, th0, slope_v1, slope_t, &!op)
        li_eval(&zm, th0, slope_v1, slope_t, &!om)
        let da = (op[0] - om[0]) / (2.0 * hs)
        let dt = (op[1] - om[1]) / (2.0 * hs)
        (*b)[16 + i] = da
        (*b)[23 + i] = dt
        (*b)[30 + i] = u[i]
        (*b)[2 + i] = da * da * u[i] * u[i]
        (*b)[9 + i] = dt * dt * u[i] * u[i]
        va = va + da * da * u[i] * u[i]
        vt = vt + dt * dt * u[i] * u[i]
        i = i + 1
    }
    (*b)[37] = va
    (*b)[38] = vt
}
