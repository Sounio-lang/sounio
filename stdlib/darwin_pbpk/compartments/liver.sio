// liver.sio — Darwin PBPK liver module
// Rewritten in Sounio syntax

fn dpbpk_liver_exp(x: f64) -> f64 {
    var result = 1.0
    var term = 1.0
    var i = 1
    while i < 20 { term = term * x / (i as f64); result = result + term; i = i + 1 }
    result
}

fn dpbpk_liver_abs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }
fn dpbpk_liver_max(a: f64, b: f64) -> f64 { if a > b { a } else { b } }
fn dpbpk_liver_min(a: f64, b: f64) -> f64 { if a < b { a } else { b } }
fn dpbpk_liver_clamp(x: f64, lo: f64, hi: f64) -> f64 { if x < lo { lo } else if x > hi { hi } else { x } }

struct Liver_State {
    concentration: f64,
    flow_in: f64,
    flow_out: f64,
    volume: f64,
    kp: f64,
}

fn liver_state_new(vol: f64, kp: f64) -> Liver_State {
    Liver_State { concentration: 0.0, flow_in: 0.0, flow_out: 0.0, volume: vol, kp: kp }
}

fn liver_compute_flux(c_arterial: f64, c_tissue: f64, kp: f64, blood_flow: f64) -> f64 {
    blood_flow * (c_arterial - c_tissue / kp)
}

fn liver_update(state: Liver_State, c_arterial: f64, blood_flow: f64, dt: f64) -> Liver_State with Div, Panic, Mut {
    let flux = liver_compute_flux(c_arterial, state.concentration, state.kp, blood_flow)
    var new_state = state
    new_state.concentration = state.concentration + dt * flux / state.volume
    if new_state.concentration < 0.0 { new_state.concentration = 0.0 }
    new_state.flow_in = dpbpk_liver_max(flux, 0.0)
    new_state.flow_out = dpbpk_liver_abs(dpbpk_liver_min(flux, 0.0))
    new_state
}

fn test_liver_flux_positive() -> bool with Div, Panic, Mut {
    let flux = liver_compute_flux(10.0, 5.0, 2.0, 90.0)
    flux > 0.0
}

fn test_liver_zero_init() -> bool {
    let s = liver_state_new(1.5, 5.0)
    s.concentration == 0.0 && s.volume == 1.5
}
