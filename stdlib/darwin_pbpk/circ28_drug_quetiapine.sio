// stdlib/darwin_pbpk/circ28_drug_quetiapine.sio — quetiapine (immediate-release oral tablet)
// on the circ28 drug record
//
// Quetiapine in an adult (ICRP 89 reference male, 73 kg), oral only. Extensively metabolised by
// CYP3A4 in the liver and in the gut wall; less than 1% excreted unchanged. Norquetiapine
// (N-desalkylquetiapine) is active but is NOT a state here.
//
// NO HUMAN INTRAVENOUS DATA EXIST (searched 2026-11-15; DeVane & Nemeroff 2001 abstract: "absolute
// bioavailability is unknown"). Every published clearance and volume is apparent (CL/F, V/F), and
// every published V/F is Vz/F = (CL/F)/lambda_z or a one-compartment V/F, so oral data hold TWO
// independent disposition numbers: CL/F and the terminal half-life.
//
// Access level of each source: FT full text read, AB abstract only, LBL FDA label text, DOS row of
// a project dossier, SEC secondary. Nothing here comes from memory.
// STATUS: 1 measured, 2 derived (stated formula, or an assumption named as such), 3 fitted to a
// named observable (then NOT a validation). u is the standard uncertainty of the VALUE.
//
//  param  value     u        st  basis of u               source (access)
//  MW     383.5     0        1   -                        PubChem CID 5002
//  logP   3.54      0.10     1   JUDGMENT (one value)     SangsterLogP via PubChem CID 5002 (database)
//  pKa1   7.06      0.30     2   JUDGMENT                 DrugBank via PubChem; unverified, probably
//                                                         predicted. 7.06 is just above the 7.0 switch
//                                                         of the Rodgers-Rowland route (acidic
//                                                         phospholipids): the uncertainty straddles it
//  ion    2 (base)  0        2   -                        monoprotic base
//  fu     0.17      0.02     1   JUDGMENT (no n, no SD)   83% bound, Seroquel label 12.3 (LBL)
//  B:P    0.7039    0.035    1   between-study SE of two  0.74 blood:SERUM, SD 0.05, n 16 (Breivik 2024,
//                                 means                    PMID 38407283, FT in the dossier) and 0.67,
//                                                         n 17 (Fisher 2013 as quoted there, SEC)
//  clint  fitted    propagated 3 -                        FITTED to the pooled CL/F (closed form)
//  clgut  fitted    propagated 3 -                        FITTED to the ketoconazole Cmax ratio 3.35
//                                                         (Grimm 2006, AB); see IDENTIFIABILITY
//  clren  0         -        0   -                        <1% of the dose unchanged (label, LBL)
//  kpsc   fitted    propagated 3 -                        FITTED to the pooled terminal half-life
//  pssc   1         -        0   -                        placeholder, no source; NOT fitted (no rate
//                                                         observable of distribution without IV data)
//  ka     fitted    propagated 3 -                        FITTED to the pooled Tmax of IR tablets; since
//                                                         round 5 the rate k of ONE stage of an Erlang
//                                                         chain of 5 stages (Shilbayeh 2015, PMID 27137148,
//                                                         AB: 4 transit compartments, Ka = Ktr, so n+1 = 5;
//                                                         no MTT in the abstract; tlag 0, unsourced)
//  fa     1.0       0.078    2   (1-0.73)/sqrt(12)        ASSUMED complete: tablet 100% relative to
//                                                         solution, 73% of 14C in urine, <1% unchanged
//                                                         (label). fa is not separable from Fg here
//  psgut  10.4544   8.05     2   factor-3 band, JUDGMENT  ASSUMED equal to the midazolam value
//                                                         (Peff 4.4e-4 cm/s x 6600 cm2 x 3.6, Brussee
//                                                         2018): no quetiapine permeability was found
//                                                         ("high permeability", Johnson 2014, AB)
//  fm     0.89      0.05     1   JUDGMENT                 CYP3A4 share of in vitro metabolism
//                                                         (Hasselstrom & Linnet 2006, PMID 16841513, AB);
//                                                         the gut wall is taken as CYP3A only
//
// OBSERVABLES USED TO FIT (pooled as in the midazolam module: n-weighted mean, u = max(pooled SE,
// between-study SD / sqrt(k)); the test prints every table):
//   CL/F   qtp_clf_studies   k 7, N 251: Grimm 2006 healthy 25 mg 138 L/h (n 12, AB); Zubiaur 2021
//          25 mg 1.79 (1.03) and 50 mg 1.77 (1.07) L/h/kg x 69.2 kg (n 19, 30, FT); Mahatthanatrakul
//          2008 200 mg Dose/AUCinf (n 24, AB); Li 2004 200 mg b.i.d. 67 +/- 25 (n 21, AB); Grimm 2006
//          patients 300 mg b.i.d. 65 (n 18, AB); Zhou 2015 population model 574 L x 0.12 /h (n 127, AB).
//          The studies mix means of individual CL/F with Dose/mean AUC and healthy low doses with
//          patients at steady state; the low-dose healthy values are twice the others. That spread is
//          the between-study term of u.
//   t1/2   qtp_thalf_studies k 5, N 205: Zubiaur 4.57 (1.19), 5.24 (1.06); Li 2004 7 +/- 3; Gefvert
//          1998 5.3 (n 8, AB); Zhou 2015 ln2/0.12.
//   Tmax   qtp_tmax_studies  k 5, N 104: Zubiaur 1.61 (1.29), 1.17 (0.67); Mahatthanatrakul 1.10 +/-
//          0.79; Li 2004 median 2.0 (range 0.3-5.0, SD range/sqrt12); Nord 2011 about 1.7 h (n 10, FT).
//   ketoconazole Cmax ratio 3.35, 90% CI 2.51-4.47, n 12 (ONE study exists: Grimm 2006, AB).
//   ketoconazole AUC ratio 6.2 (label; CL/F ratio 0.16, 90% CI 0.13-0.20, Grimm 2006): sets the hepatic
//   CYP3A activity left under ketoconazole 200 mg/day. It is a property of the perpetrator regimen.
//
// IDENTIFIABILITY (what the oral data can and cannot give)
//   - For a flow-limited liver CL/F = fu clint / Fg: the AUC fixes the product clint/Fg. The kernel's
//     hepatic flow then gives Eh and F = Fg (1 - Eh). F is an OUTPUT here, never an input.
//   - An oral inhibitor AUC ratio is (Fg'/Fg)(clint/clint'): the product of the gut and liver effects.
//     It cannot split them.
//   - The Cmax ratio is close to F'/F. With the gut wall taken as FULLY inhibited during absorption
//     under ketoconazole (Fg' = 1: ASSUMPTION), F' follows from the inhibited CL/F and the hepatic flow
//     alone, so the Cmax ratio measures the baseline F and hence Fg. clint_gut is fitted to it.
//   - NOT identifiable: the split without that assumption (incomplete gut inhibition means a lower
//     true Fg); fa apart from Fg; ps_gut apart from clint_gut (only Fg and the small arterial gut
//     extraction see them); the distribution rate (ps scalar).
//   - DERIVED PRIOR, used as a check only: the gut:liver ratio clint_gut/clint of the fitted midazolam
//     record applied to the CYP3A part of the quetiapine clint (qtp_prior_fg).
//
// CLOSED FORMS (kernel identities, tests/run-pass/circ28_kernel_identities.sio)
//   A = Q_gut Eg;  CL_blood = A + Eh (Q_h - A);  F = Fg (1 - Eh);  CL/F (plasma) = bp CL_blood / F
//   => Eh = (T Fg - A)/(Q_h - A + T Fg), T = (CL/F)/bp; y = bp Q_h Eh/(1 - Eh);
//      clint fu = y ps_liver/(ps_liver - y)                                          (qtp_fit_clint)
//   kpsc, ka, clint_gut: Newton iteration on kernel runs (half-life, Tmax, Cmax ratio), done offline;
//   the stored values are qtp_kpsc_fit(), qtp_ka_fit(), qtp_clgut_fit() and the test re-checks the
//   three observables they give.
//
// ROUND 5 (transit input, ntr 5, all-organ Kp scalar, gv 0): kpsc 0.104617, k 4.184807 /h (MTT 5/k = 1.195 h),
//   clint_gut 74.317865, clint 161.632599; Fg 0.3976, Eh 0.2791, F 0.2866. The gut-unscaled variant (gv 1: kpsc 0.04981,
//   k 5.441275, clint_gut 468.449583) was run in full and NOT adopted (test section G). The numbers below are the
//   first-order fit of the earlier round, kept as a record.
// FIT RESULT (2026-11-15; u from the observables' u through the inverse Jacobian, test section S1)
//   kpsc 0.116453 +/- 0.020;  ka 0.467594 +/- 0.086 /h;  clint_gut 40.31 +/- 49.9 L/h;
//   clint 243.75 +/- 184 L/h.  Derived: Fg 0.549, Eh 0.367, F 0.347 +/- 0.109, systemic CL 28.1 L/h,
//   V_ss 116 L. Under ketoconazole: CYP3A activity left in the liver 0.232, F 0.843.
//   The gut clint is barely determined (the 90% CI of the Cmax ratio is 2.51-4.47); the Rodgers-Rowland
//   volume at scalar 1 is 970 L, eight times what the half-life allows; adipose holds 60% of V_ss and
//   its perfusion time constant (5.1 h) is the terminal phase. The smallest F the model can have at
//   the pooled CL/F is 0.094 (the tertiary literature value is 0.09).

use darwin_pbpk::circ28::*
use darwin_pbpk::circ28_kp::*
use darwin_pbpk::circ28_drug::*
use darwin_pbpk::circ28_drug_midazolam::*
use math::pure::{exp, ln}

fn qtp_abs(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

// ---- measured / assumed inputs ------------------------------------------------
pub fn qtp_mw() -> f64 { return 383.5 }
pub fn qtp_logp() -> f64 { return 3.54 }
pub fn qtp_u_logp() -> f64 { return 0.10 }
pub fn qtp_pka1() -> f64 { return 7.06 }
pub fn qtp_u_pka1() -> f64 { return 0.30 }
pub fn qtp_fu() -> f64 { return 0.17 }
pub fn qtp_u_fu() -> f64 { return 0.02 }
// B:P: n-weighted mean of 0.74 (n 16) and 0.67 (n 17); u = |0.74 - 0.67| / sqrt(2) / sqrt(2)
// (between-study SD of two means over sqrt(2))
pub fn qtp_bp() -> f64 { return (16.0 * 0.74 + 17.0 * 0.67) / 33.0 }
pub fn qtp_u_bp() -> f64 { return 0.07 / 2.0 }
pub fn qtp_fa() -> f64 { return 1.0 }
pub fn qtp_u_fa() -> f64 { return 0.27 / 3.4641016151377544 }
pub fn qtp_psgut() -> f64 { return mdz_psgut() }
pub fn qtp_u_psgut() -> f64 { return (3.0 - 1.0 / 3.0) * mdz_psgut() / 3.4641016151377544 }
pub fn qtp_fm3a() -> f64 { return 0.89 }
pub fn qtp_u_fm3a() -> f64 { return 0.05 }
// mean body weight of the 49 volunteers of Zubiaur 2021 (Table 2: 70.1 kg, n 9; 69.0 kg, n 40)
pub fn qtp_zub_weight() -> f64 { return (9.0 * 70.1 + 40.0 * 69.0) / 49.0 }

// ---- pooled observables -------------------------------------------------------
// CL/F, L/h (plasma). s <= 0: no SD in the source.
pub fn qtp_clf_studies(m: &![f64; 8], s: &![f64; 8], n: &![f64; 8]) -> i32 with Mut, Div, Panic {
    let w = qtp_zub_weight()
    (*m)[0] = 138.0
    (*s)[0] = 0.0 - 1.0
    (*n)[0] = 12.0
    (*m)[1] = 1.79 * w
    (*s)[1] = 1.03 * w
    (*n)[1] = 19.0
    (*m)[2] = 1.77 * w
    (*s)[2] = 1.07 * w
    (*n)[2] = 30.0
    (*m)[3] = 200000.0 / 3769.45
    (*s)[3] = (200000.0 / 3769.45) * 1296.69 / 3769.45
    (*n)[3] = 24.0
    (*m)[4] = 67.0
    (*s)[4] = 25.0
    (*n)[4] = 21.0
    (*m)[5] = 65.0
    (*s)[5] = 0.0 - 1.0
    (*n)[5] = 18.0
    (*m)[6] = 574.0 * 0.12
    (*s)[6] = 0.0 - 1.0
    (*n)[6] = 127.0
    return 7
}

// terminal half-life, h
pub fn qtp_thalf_studies(m: &![f64; 8], s: &![f64; 8], n: &![f64; 8]) -> i32 with Mut, Div, Panic {
    (*m)[0] = 4.57
    (*s)[0] = 1.19
    (*n)[0] = 19.0
    (*m)[1] = 5.24
    (*s)[1] = 1.06
    (*n)[1] = 30.0
    (*m)[2] = 7.0
    (*s)[2] = 3.0
    (*n)[2] = 21.0
    (*m)[3] = 5.3
    (*s)[3] = 0.0 - 1.0
    (*n)[3] = 8.0
    (*m)[4] = 0.6931471805599453 / 0.12
    (*s)[4] = 0.0 - 1.0
    (*n)[4] = 127.0
    return 5
}

// Tmax of IR tablets, h (means and medians together)
pub fn qtp_tmax_studies(m: &![f64; 8], s: &![f64; 8], n: &![f64; 8]) -> i32 with Mut, Div, Panic {
    (*m)[0] = 1.61
    (*s)[0] = 1.29
    (*n)[0] = 19.0
    (*m)[1] = 1.17
    (*s)[1] = 0.67
    (*n)[1] = 30.0
    (*m)[2] = 1.10
    (*s)[2] = 0.79
    (*n)[2] = 24.0
    (*m)[3] = 2.0
    (*s)[3] = 4.7 / 3.4641016151377544
    (*n)[3] = 21.0
    (*m)[4] = 1.7
    (*s)[4] = 0.0 - 1.0
    (*n)[4] = 10.0
    return 5
}

// which: 0 CL/F, 1 t1/2, 2 Tmax
pub fn qtp_pool(which: i32) -> MdzPool with Mut, Div, Panic {
    var m: [f64; 8] = [0.0; 8]
    var s: [f64; 8] = [0.0; 8]
    var n: [f64; 8] = [0.0; 8]
    var k: i32 = 0
    if which == 0 { k = qtp_clf_studies(&!m, &!s, &!n) }
    if which == 1 { k = qtp_thalf_studies(&!m, &!s, &!n) }
    if which == 2 { k = qtp_tmax_studies(&!m, &!s, &!n) }
    return mdz_pool(&m, &s, &n, k)
}

pub fn qtp_obs_clf() -> f64 with Mut, Div, Panic { return qtp_pool(0).mean }
pub fn qtp_u_clf() -> f64 with Mut, Div, Panic { return qtp_pool(0).u }
pub fn qtp_obs_thalf() -> f64 with Mut, Div, Panic { return qtp_pool(1).mean }
pub fn qtp_u_thalf() -> f64 with Mut, Div, Panic { return qtp_pool(1).u }
pub fn qtp_obs_tmax() -> f64 with Mut, Div, Panic { return qtp_pool(2).mean }
pub fn qtp_u_tmax() -> f64 with Mut, Div, Panic { return qtp_pool(2).u }

// Ketoconazole 200 mg daily x 4 days, quetiapine 25 mg (Grimm 2006, n 12). u from the 90% CI of the
// geometric mean ratio: SE(ln) = (ln hi - ln lo)/(2 t), t = 1.7959 (two-sided 10%, 11 df).
pub fn qtp_keto_rcmax() -> f64 { return 3.35 }
pub fn qtp_u_keto_rcmax() -> f64 with Mut, Div, Panic { return 3.35 * (ln(4.47) - ln(2.51)) / (2.0 * 1.7959) }
pub fn qtp_keto_rauc() -> f64 { return 6.2 }
pub fn qtp_u_keto_rauc() -> f64 with Mut, Div, Panic { return 6.2 * (ln(0.20) - ln(0.13)) / (2.0 * 1.7959) }

// ---- stored fits (offline Newton iteration on kernel runs; re-checked by the test) ----
// Round 5 (ntr = 5 transit stages, offline Newton iteration, see qtp_ntr): the stored fits of the two Kp variants
// gv 0 (all organs scaled) and gv 1 (gut wall at its Rodgers-Rowland Kp). The first-order (round 1-4) fit was
// kpsc 0.116453, ka 0.467594 /h, clint_gut 40.309786.
pub fn qtp_kpsc_fit(gv: i32) -> f64 {
    if gv == 0 { return 0.104617 }
    return 0.049810
}
pub fn qtp_ka_fit(gv: i32) -> f64 {
    if gv == 0 { return 4.184807 }
    return 5.441275
}
pub fn qtp_clgut_fit(gv: i32) -> f64 {
    if gv == 0 { return 74.317865 }
    return 468.449583
}

// Number of Erlang STAGES of the oral input: Shilbayeh 2015 (PMID 27137148, abstract only) fitted four transit
// compartments to 25 mg IR tablets; with Ka = Ktr that is n + 1 = 5 stages (rule 11). CD_KA is the rate of one stage.
pub fn qtp_ntr() -> i32 { return 5 }

// Gut-wall Kp variants (see the test header): 0 all organs scaled, 1 gut wall at its Rodgers-Rowland Kp.
pub fn qtp_gv_adopted() -> i32 { return 0 }

pub fn qtp_params_v(th: [f64; 18], gv: i32) -> Circ28Params with Mut, Div, Panic {
    var t = th
    if gv == 1 { return circ28_drug_params_theta_gutrr(t) }
    return circ28_drug_params_theta(t)
}

// ---- run configuration ----------------------------------------------------------
// Grid 0.05 h to 4 h, 0.5 h to 36 h (144 steps); terminal fit on 12..36 h.
pub fn qtp_cfg_oral(dose_mg: f64) -> Circ28Dose {
    return circ28_dose_oral_transit(dose_mg, qtp_ntr(), 0.05, 4.0, 0.5, 36.0, 12.0, 36.0)
}

// Value array with the measured / assumed inputs and the stored fits; clint is left 0.
pub fn qtp_theta0(t: &![f64; 18], gv: i32) -> i32 with Mut, Div, Panic {
    var i: i32 = 0
    while i < 18 {
        (*t)[i] = 0.0
        i = i + 1
    }
    (*t)[CD_MW] = qtp_mw()
    (*t)[CD_LOGP] = qtp_logp()
    (*t)[CD_PKA1] = qtp_pka1()
    (*t)[CD_ION] = 2.0
    (*t)[CD_FU] = qtp_fu()
    (*t)[CD_BP] = qtp_bp()
    (*t)[CD_KPSC] = qtp_kpsc_fit(gv)
    (*t)[CD_PSSC] = 1.0
    (*t)[CD_KA] = qtp_ka_fit(gv)
    (*t)[CD_FA] = qtp_fa()
    (*t)[CD_PSGUT] = qtp_psgut()
    (*t)[CD_CLGUT] = qtp_clgut_fit(gv)
    return 0
}

// Closed forms of one parameter set: o[0] Fg, o[1] Eh, o[2] Eg (arterial), o[3] F = Fg (1 - Eh),
// o[4] systemic plasma CL (L/h), o[5] CL/F (L/h), o[6] V_ss plasma (L), o[7] Q_h (L/h).
pub fn qtp_closed(th: &[f64; 18], o: &![f64; 8]) -> i32 with Mut, Div, Panic {
    var t: [f64; 18] = [0.0; 18]
    var i: i32 = 0
    while i < 18 {
        t[i] = (*th)[i]
        i = i + 1
    }
    let p = circ28_drug_params_theta(t)
    let fg = circ28_gut_availability(p)
    let eh = circ28_hepatic_extraction(p)
    let eg = circ28_gut_extraction(p)
    let clb = circ28_splanchnic_clearance(p)
    (*o)[0] = fg
    (*o)[1] = eh
    (*o)[2] = eg
    (*o)[3] = fg * (1.0 - eh) * t[CD_FA]
    (*o)[4] = clb * p.bp
    (*o)[5] = clb * p.bp / (fg * (1.0 - eh) * t[CD_FA])
    (*o)[6] = circ28_vss_plasma(p)
    (*o)[7] = circ28_q_hepatic(p)
    return 0
}

// Hepatic clint (L/h, unbound) that gives the apparent oral clearance clf (L/h, plasma) with the
// gut-wall clearance, ps_gut, fu, bp and fa of th. Returns -1 if clf cannot be reached.
pub fn qtp_fit_clint(th: &[f64; 18], clf: f64) -> f64 with Mut, Div, Panic {
    var t: [f64; 18] = [0.0; 18]
    var i: i32 = 0
    while i < 18 {
        t[i] = (*th)[i]
        i = i + 1
    }
    t[CD_CLINT] = 0.0
    let p = circ28_drug_params_theta(t)
    let fg = circ28_gut_availability(p) * t[CD_FA]
    let eg = circ28_gut_extraction(p)
    let a = p.q[8] * eg
    let qh = circ28_q_hepatic(p)
    let tb = clf / p.bp
    let eh = (tb * fg - a) / (qh - a + tb * fg)
    if !(eh > 0.0) || !(eh < 1.0) { return 0.0 - 1.0 }
    let y = p.bp * qh * eh / (1.0 - eh)
    if !(p.ps[1] > y) { return 0.0 - 1.0 }
    return (y * p.ps[1] / (p.ps[1] - y)) / p.fu
}

// CYP3A modulation: hepatic clint x (1 - fm + fm a_h), gut clint x a_g (gut wall CYP3A only).
// a = 1 no change, 0 complete inhibition, > 1 induction.
pub fn qtp_modulate(th: &[f64; 18], fm: f64, a_h: f64, a_g: f64, t: &![f64; 18]) -> i32 with Mut, Div, Panic {
    var i: i32 = 0
    while i < 18 {
        (*t)[i] = (*th)[i]
        i = i + 1
    }
    (*t)[CD_CLINT] = (*th)[CD_CLINT] * (1.0 - fm + fm * a_h)
    (*t)[CD_CLGUT] = (*th)[CD_CLGUT] * a_g
    return 0
}

// One oral run: o[0] AUC_inf, o[1] Cmax, o[2] Tmax, o[3] t1/2, o[4] balance error, o[5] AUC 0-36 h,
// o[6] C at 36 h (mg/L, plasma).
pub fn qtp_run_into(th: &[f64; 18], dose_mg: f64, o: &![f64; 8], gv: i32) -> i32 with Mut, Div, Panic {
    var t: [f64; 18] = [0.0; 18]
    var i: i32 = 0
    while i < 18 {
        t[i] = (*th)[i]
        i = i + 1
    }
    var dc = qtp_cfg_oral(dose_mg)
    dc.ka = t[CD_KA]
    dc.fa = t[CD_FA]
    dc.tlag = t[CD_TLAG]
    let pv = qtp_params_v(t, gv)
    let r = circ28_run(pv, dc)
    (*o)[0] = r.auc_inf
    (*o)[1] = r.cmax
    (*o)[2] = r.tmax
    (*o)[3] = r.thalf
    (*o)[4] = r.balance_err
    (*o)[5] = r.auc_t
    (*o)[6] = r.c_end
    return 0
}

// The ketoconazole state of a parameter set: gut wall fully inhibited (clint_gut 0, ASSUMPTION) and
// the hepatic clint that makes the apparent clearance clf / rauc. t receives the set.
pub fn qtp_keto_theta(th: &[f64; 18], clf: f64, rauc: f64, t: &![f64; 18]) -> i32 with Mut, Div, Panic {
    var i: i32 = 0
    while i < 18 {
        (*t)[i] = (*th)[i]
        i = i + 1
    }
    (*t)[CD_CLGUT] = 0.0
    var t2: [f64; 18] = [0.0; 18]
    i = 0
    while i < 18 {
        t2[i] = (*t)[i]
        i = i + 1
    }
    (*t)[CD_CLINT] = qtp_fit_clint(&t2, clf / rauc)
    return 0
}

// Baseline and ketoconazole runs of 25 mg for a set whose kpsc, ka, clint_gut are given; the hepatic
// clint is refitted to clf first (written back into th). o[0..6] baseline run, o[8..14] ketoconazole
// run, o[7] Cmax ratio, o[15] hepatic clint under ketoconazole.
pub fn qtp_pair(th: &![f64; 18], clf: f64, rauc: f64, o: &![f64; 16], gv: i32) -> i32 with Mut, Div, Panic {
    var t: [f64; 18] = [0.0; 18]
    var tk: [f64; 18] = [0.0; 18]
    var ob: [f64; 8] = [0.0; 8]
    var ok: [f64; 8] = [0.0; 8]
    var i: i32 = 0
    while i < 18 {
        t[i] = (*th)[i]
        i = i + 1
    }
    t[CD_CLINT] = qtp_fit_clint(&t, clf)
    (*th)[CD_CLINT] = t[CD_CLINT]
    qtp_keto_theta(&t, clf, rauc, &!tk)
    qtp_run_into(&t, 25.0, &!ob, gv)
    qtp_run_into(&tk, 25.0, &!ok, gv)
    i = 0
    while i < 7 {
        (*o)[i] = ob[i]
        (*o)[8 + i] = ok[i]
        i = i + 1
    }
    (*o)[7] = ok[1] / ob[1]
    (*o)[15] = tk[CD_CLINT]
    return 0
}

// Inverse Jacobian of (t1/2, Tmax, ketoconazole Cmax ratio) with respect to (kpsc, ka, clint_gut),
// forward differences with relative step 1e-3, the hepatic clint refitted every time. 8 kernel runs.
// ji is row-major: d(parameter r)/d(observable c).
pub fn qtp_jac_inv(th: &[f64; 18], clf: f64, rauc: f64, ji: &![f64; 9], gv: i32) -> i32 with Mut, Div, Panic {
    var t: [f64; 18] = [0.0; 18]
    var o0: [f64; 16] = [0.0; 16]
    var o1: [f64; 16] = [0.0; 16]
    var j: [f64; 9] = [0.0; 9]
    var i: i32 = 0
    while i < 18 {
        t[i] = (*th)[i]
        i = i + 1
    }
    qtp_pair(&!t, clf, rauc, &!o0, gv)
    var c: i32 = 0
    while c < 3 {
        var idx = CD_KPSC
        if c == 1 { idx = CD_KA }
        if c == 2 { idx = CD_CLGUT }
        let keep = t[idx]
        let step = 1.0e-3 * keep
        t[idx] = keep + step
        qtp_pair(&!t, clf, rauc, &!o1, gv)
        j[0 * 3 + c] = (o1[3] - o0[3]) / step
        j[1 * 3 + c] = (o1[2] - o0[2]) / step
        j[2 * 3 + c] = (o1[7] - o0[7]) / step
        t[idx] = keep
        c = c + 1
    }
    let det = j[0] * (j[4] * j[8] - j[5] * j[7]) - j[1] * (j[3] * j[8] - j[5] * j[6]) + j[2] * (j[3] * j[7] - j[4] * j[6])
    if qtp_abs(det) < 1.0e-300 { return 1 }
    (*ji)[0] = (j[4] * j[8] - j[5] * j[7]) / det
    (*ji)[1] = (j[2] * j[7] - j[1] * j[8]) / det
    (*ji)[2] = (j[1] * j[5] - j[2] * j[4]) / det
    (*ji)[3] = (j[5] * j[6] - j[3] * j[8]) / det
    (*ji)[4] = (j[0] * j[8] - j[2] * j[6]) / det
    (*ji)[5] = (j[2] * j[3] - j[0] * j[5]) / det
    (*ji)[6] = (j[3] * j[7] - j[4] * j[6]) / det
    (*ji)[7] = (j[1] * j[6] - j[0] * j[7]) / det
    (*ji)[8] = (j[0] * j[4] - j[1] * j[3]) / det
    return 0
}

// One Newton step of (kpsc, ka, clint_gut) towards obs = (CL/F, t1/2, Tmax, Cmax ratio, AUC ratio)
// with a given inverse Jacobian; th is updated in place (clint refitted). 2 kernel runs. Returns the
// largest relative residual BEFORE the step in res[0].
pub fn qtp_newton(th: &![f64; 18], obs: &[f64; 5], ji: &[f64; 9], res: &![f64; 4], gv: i32) -> i32 with Mut, Div, Panic {
    var o: [f64; 16] = [0.0; 16]
    qtp_pair(th, (*obs)[0], (*obs)[4], &!o, gv)
    let r0 = o[3] - (*obs)[1]
    let r1 = o[2] - (*obs)[2]
    let r2 = o[7] - (*obs)[3]
    (*res)[1] = r0
    (*res)[2] = r1
    (*res)[3] = r2
    var worst = qtp_abs(r0 / (*obs)[1])
    if qtp_abs(r1 / (*obs)[2]) > worst { worst = qtp_abs(r1 / (*obs)[2]) }
    if qtp_abs(r2 / (*obs)[3]) > worst { worst = qtp_abs(r2 / (*obs)[3]) }
    (*res)[0] = worst
    (*th)[CD_KPSC] = (*th)[CD_KPSC] - ((*ji)[0] * r0 + (*ji)[1] * r1 + (*ji)[2] * r2)
    (*th)[CD_KA] = (*th)[CD_KA] - ((*ji)[3] * r0 + (*ji)[4] * r1 + (*ji)[5] * r2)
    (*th)[CD_CLGUT] = (*th)[CD_CLGUT] - ((*ji)[6] * r0 + (*ji)[7] * r1 + (*ji)[8] * r2)
    var t: [f64; 18] = [0.0; 18]
    var i: i32 = 0
    while i < 18 {
        t[i] = (*th)[i]
        i = i + 1
    }
    (*th)[CD_CLINT] = qtp_fit_clint(&t, (*obs)[0])
    return 0
}

pub fn qtp_obs_into(obs: &![f64; 5]) -> i32 with Mut, Div, Panic {
    (*obs)[0] = qtp_obs_clf()
    (*obs)[1] = qtp_obs_thalf()
    (*obs)[2] = qtp_obs_tmax()
    (*obs)[3] = qtp_keto_rcmax()
    (*obs)[4] = qtp_keto_rauc()
    return 0
}

// ---- the record -------------------------------------------------------------------
pub fn qtp_measured_record(d: &!Circ28Drug) with Mut, Div, Panic, Epistemic {
    // every slot is written, the unused ones too: on lean_single the untouched elements of the record's
    // Knowledge array read back as value 1 with a neighbour's variance (seen 2026-11-15 in this test)
    circ28_drug_set(d, CD_PKA2, 0.0, 0.0, CD_STATUS_UNUSED, "unused")
    circ28_drug_set(d, CD_CLFORM, 0.0, 0.0, CD_STATUS_UNUSED, "no metabolite is tracked")
    circ28_drug_set(d, CD_CLREN, 0.0, 0.0, CD_STATUS_UNUSED, "<1% of the dose unchanged in urine (label)")
    circ28_drug_set(d, CD_CLPLA, 0.0, 0.0, CD_STATUS_UNUSED, "unused")
    circ28_drug_set(d, CD_PSSC, 1.0, 0.0, CD_STATUS_UNUSED, "placeholder, no source; not fitted")
    circ28_drug_set(d, CD_TLAG, 0.0, 0.0, CD_STATUS_UNUSED, "unused")
    circ28_drug_set(d, CD_MW, qtp_mw(), 0.0, CD_STATUS_MEASURED, "PubChem CID 5002")
    circ28_drug_set(d, CD_LOGP, qtp_logp(), qtp_u_logp(), CD_STATUS_MEASURED, "SangsterLogP via PubChem CID 5002; u 0.1 is a judgment (one value)")
    circ28_drug_set(d, CD_PKA1, qtp_pka1(), qtp_u_pka1(), CD_STATUS_DERIVED, "DrugBank via PubChem, unverified, probably predicted; u 0.3 is a judgment")
    circ28_drug_set(d, CD_ION, 2.0, 0.0, CD_STATUS_DERIVED, "monoprotic base")
    circ28_drug_set(d, CD_FU, qtp_fu(), qtp_u_fu(), CD_STATUS_MEASURED, "83% bound, Seroquel label 12.3; u 0.02 is a judgment (no n, no SD)")
    circ28_drug_set(d, CD_BP, qtp_bp(), qtp_u_bp(), CD_STATUS_MEASURED, "Breivik2024 0.74 blood:serum (n 16), Fisher2013 0.67 (n 17, quoted); u = between-study SE")
    circ28_drug_set(d, CD_FA, qtp_fa(), qtp_u_fa(), CD_STATUS_DERIVED, "ASSUMED complete (label: tablet 100% of solution, 73% of 14C in urine, <1% unchanged); not separable from Fg")
    circ28_drug_set(d, CD_PSGUT, qtp_psgut(), qtp_u_psgut(), CD_STATUS_DERIVED, "ASSUMED = midazolam ps_gut (Brussee2018 arithmetic); no quetiapine permeability found; u = factor-3 band")
}

// Fitted slots. su[0..3] = standard uncertainties of kpsc, ka, clint_gut, clint (the test computes
// them from the inverse Jacobian and the uncertainties of the observables; qtp_fit_u).
pub fn qtp_fit_record(d: &!Circ28Drug, su: &[f64; 4], gv: i32) with Mut, Div, Panic, Epistemic {
    var t: [f64; 18] = [0.0; 18]
    qtp_theta0(&!t, gv)
    let cl = qtp_fit_clint(&t, qtp_obs_clf())
    circ28_drug_set(d, CD_KPSC, qtp_kpsc_fit(gv), (*su)[0], CD_STATUS_FITTED, "fitted to the pooled terminal half-life (Zubiaur2021 x2, Li2004, Gefvert1998, Zhou2015)")
    circ28_drug_set(d, CD_KA, qtp_ka_fit(gv), (*su)[1], CD_STATUS_FITTED, "fitted to the pooled Tmax of IR tablets (Zubiaur2021 x2, Mahatthanatrakul2008, Li2004, Nord2011)")
    circ28_drug_set(d, CD_CLGUT, qtp_clgut_fit(gv), (*su)[2], CD_STATUS_FITTED, "fitted to the ketoconazole Cmax ratio 3.35 (Grimm2006), gut wall assumed fully inhibited under ketoconazole")
    circ28_drug_set(d, CD_CLINT, cl, (*su)[3], CD_STATUS_FITTED, "fitted to the pooled CL/F (Grimm2006 x2, Zubiaur2021 x2, Mahatthanatrakul2008, Li2004, Zhou2015), closed form")
}

// Uncertainties of the fitted parameters from those of the five observables (the measured inputs
// held fixed): su[r] = sqrt(sum_c (d par_r / d obs_c)^2 u_c^2). The derivatives with respect to
// t1/2, Tmax and the Cmax ratio are the inverse Jacobian; those with respect to CL/F and the AUC
// ratio, and all derivatives of clint, are forward differences of a one-step refit. 6 + 2 runs.
pub fn qtp_fit_u(th: &[f64; 18], ji: &[f64; 9], su: &![f64; 4], gv: i32) -> i32 with Mut, Div, Panic {
    var obs: [f64; 5] = [0.0; 5]
    var uo: [f64; 5] = [0.0; 5]
    var res: [f64; 4] = [0.0; 4]
    qtp_obs_into(&!obs)
    uo[0] = qtp_u_clf()
    uo[1] = qtp_u_thalf()
    uo[2] = qtp_u_tmax()
    uo[3] = qtp_u_keto_rcmax()
    uo[4] = qtp_u_keto_rauc()
    var acc: [f64; 4] = [0.0; 4]
    var c: i32 = 0
    while c < 5 {
        var t: [f64; 18] = [0.0; 18]
        var i: i32 = 0
        while i < 18 {
            t[i] = (*th)[i]
            i = i + 1
        }
        let keep = obs[c]
        let step = 1.0e-3 * keep
        obs[c] = keep + step
        qtp_newton(&!t, &obs, ji, &!res, gv)
        obs[c] = keep
        let d0 = (t[CD_KPSC] - (*th)[CD_KPSC]) / step
        let d1 = (t[CD_KA] - (*th)[CD_KA]) / step
        let d2 = (t[CD_CLGUT] - (*th)[CD_CLGUT]) / step
        let d3 = (t[CD_CLINT] - (*th)[CD_CLINT]) / step
        acc[0] = acc[0] + d0 * d0 * uo[c] * uo[c]
        acc[1] = acc[1] + d1 * d1 * uo[c] * uo[c]
        acc[2] = acc[2] + d2 * d2 * uo[c] * uo[c]
        acc[3] = acc[3] + d3 * d3 * uo[c] * uo[c]
        c = c + 1
    }
    (*su)[0] = cd_sqrt(acc[0])
    (*su)[1] = cd_sqrt(acc[1])
    (*su)[2] = cd_sqrt(acc[2])
    (*su)[3] = cd_sqrt(acc[3])
    return 0
}

// ---- budget with refit ----------------------------------------------------------------
// Eleven inputs: 0 logP, 1 pKa1, 2 fu, 3 B:P, 4 ps_gut, 5 fa (measured / assumed), 6 CL/F, 7 t1/2,
// 8 Tmax, 9 ketoconazole Cmax ratio, 10 ketoconazole AUC ratio (observables). Each is moved by a
// forward step (1e-3 relative), kpsc / ka / clint_gut are refitted by ONE Newton step with the fixed
// inverse Jacobian and clint in closed form, then the 25 mg dose is run. Outputs: 0 AUC_inf,
// 1 Cmax, 2 F. sens[3 i + k] = d out_k / d input_i; var[k] = sum (sens u)^2. 3 runs per input.
pub fn qtp_budget_u(u: &![f64; 11]) -> i32 with Mut, Div, Panic {
    (*u)[0] = qtp_u_logp()
    (*u)[1] = qtp_u_pka1()
    (*u)[2] = qtp_u_fu()
    (*u)[3] = qtp_u_bp()
    (*u)[4] = qtp_u_psgut()
    (*u)[5] = qtp_u_fa()
    (*u)[6] = qtp_u_clf()
    (*u)[7] = qtp_u_thalf()
    (*u)[8] = qtp_u_tmax()
    (*u)[9] = qtp_u_keto_rcmax()
    (*u)[10] = qtp_u_keto_rauc()
    return 0
}

fn qtp_budget_out(t: &[f64; 18], out: &![f64; 3], gv: i32) -> i32 with Mut, Div, Panic {
    var o: [f64; 8] = [0.0; 8]
    var c: [f64; 8] = [0.0; 8]
    qtp_run_into(t, 25.0, &!o, gv)
    qtp_closed(t, &!c)
    (*out)[0] = o[0]
    (*out)[1] = o[1]
    (*out)[2] = c[3]
    return 0
}

pub fn qtp_budget(th: &[f64; 18], ji: &[f64; 9], base: &![f64; 3], sens: &![f64; 33], vr: &![f64; 3], gv: i32) -> i32 with Mut, Div, Panic {
    var obs: [f64; 5] = [0.0; 5]
    var u: [f64; 11] = [0.0; 11]
    var res: [f64; 4] = [0.0; 4]
    var o1: [f64; 3] = [0.0; 3]
    qtp_obs_into(&!obs)
    qtp_budget_u(&!u)
    qtp_budget_out(th, base, gv)
    (*vr)[0] = 0.0
    (*vr)[1] = 0.0
    (*vr)[2] = 0.0
    var c: i32 = 0
    while c < 11 {
        var t: [f64; 18] = [0.0; 18]
        var i: i32 = 0
        while i < 18 {
            t[i] = (*th)[i]
            i = i + 1
        }
        var step = 0.0
        if c < 6 {
            var idx = CD_LOGP
            if c == 1 { idx = CD_PKA1 }
            if c == 2 { idx = CD_FU }
            if c == 3 { idx = CD_BP }
            if c == 4 { idx = CD_PSGUT }
            if c == 5 { idx = CD_FA }
            // fa cannot exceed 1: step downwards there
            step = 1.0e-3 * t[idx]
            if c == 5 { step = 0.0 - step }
            t[idx] = t[idx] + step
            let rc = qtp_newton(&!t, &obs, ji, &!res, gv)
        } else {
            let keep = obs[c - 6]
            step = 1.0e-3 * keep
            obs[c - 6] = keep + step
            qtp_newton(&!t, &obs, ji, &!res, gv)
            obs[c - 6] = keep
        }
        qtp_budget_out(&t, &!o1, gv)
        var k: i32 = 0
        while k < 3 {
            let dv = (o1[k] - (*base)[k]) / step
            (*sens)[3 * c + k] = dv
            (*vr)[k] = (*vr)[k] + dv * dv * u[c] * u[c]
            k = k + 1
        }
        c = c + 1
    }
    return 0
}

// ---- multiple dosing ----------------------------------------------------------------------
// `nd` oral doses of dose_mg every tau h, step 0.1 h. Over the LAST interval: o[0] Cmax (mg/L),
// o[1] time of Cmax after the dose (h), o[2] trough at the end of the interval, o[3] AUC over the
// interval (mg h/L), o[4] trough at the start of the interval, o[5] mass balance error.
pub fn qtp_md(th: &[f64; 18], dose_mg: f64, tau: f64, nd: i32, o: &![f64; 8], gv: i32) -> i32 with Mut, Div, Panic {
    var t: [f64; 18] = [0.0; 18]
    var i: i32 = 0
    while i < 18 {
        t[i] = (*th)[i]
        i = i + 1
    }
    let p = qtp_params_v(t, gv)
    var sys = circ28_sys_zero()
    var s = circ28_state_zero()
    var el = circ28_elim_zero()
    let dt = 0.1
    circ28_prepare(p, dt, &!sys)
    let nstep = ((tau / dt) + 0.5) as i32
    let ka = t[CD_KA]
    let fa = t[CD_FA]
    var input = 0.0
    var cmax = 0.0
    var tmax = 0.0
    var auc0 = 0.0
    var c_start = 0.0
    var k: i32 = 0
    while k < nd {
        if k == nd - 1 {
            auc0 = el.auc_ven
            c_start = s.x[0] / p.bp
        }
        var j: i32 = 0
        while j < nstep {
            let ta = (k as f64) * tau + (j as f64) * dt
            var mass = 0.0
            var q: i32 = 0
            while q <= k {
                let t0 = ta - (q as f64) * tau
                mass = mass + circ28_oral_mass_n(ka, qtp_ntr(), fa, dose_mg, 0.0, t0, t0 + dt)
                q = q + 1
            }
            input = input + mass
            circ28_step(&!s, p, &sys, 0.0, mass / dt, &!el)
            if k == nd - 1 {
                let c = s.x[0] / p.bp
                if c > cmax {
                    cmax = c
                    tmax = ((j + 1) as f64) * dt
                }
            }
            j = j + 1
        }
        k = k + 1
    }
    let elim = el.hepatic + el.formed + el.renal + el.plasma + el.gut
    let rem = circ28_total_mass(&s, p)
    (*o)[0] = cmax
    (*o)[1] = tmax
    (*o)[2] = s.x[0] / p.bp
    (*o)[3] = (el.auc_ven - auc0) / p.bp
    (*o)[4] = c_start
    (*o)[5] = qtp_abs(input - elim - rem) / input
    return 0
}

// ---- CYP3A activity factors of a perpetrator regimen, derived from midazolam -----------------
// The fitted midazolam value array (closed forms of the midazolam module, no kernel run).
pub fn qtp_mdz_theta(t: &![f64; 18]) -> i32 with Mut, Div, Panic {
    var t0: [f64; 18] = [0.0; 18]
    t0[CD_MW] = mdz_mw()
    t0[CD_LOGP] = mdz_logp()
    t0[CD_PKA1] = mdz_pka1()
    t0[CD_ION] = 2.0
    t0[CD_FU] = mdz_fu()
    t0[CD_BP] = mdz_bp()
    t0[CD_KPSC] = 1.0
    t0[CD_PSSC] = 1.0
    t0[CD_KA] = 1.0
    t0[CD_FA] = 1.0
    t0[CD_PSGUT] = mdz_psgut()
    let tf = mdz_fit(t0, mdz_obs_vss(), mdz_obs_cl(), mdz_obs_fg(), 0)
    var i: i32 = 0
    while i < 18 {
        (*t)[i] = tf[i]
        i = i + 1
    }
    return 0
}

// fraction of midazolam hepatic clint that is CYP3A (static-model convention 0.91, Rodrigues 2026
// as recorded in the gut-wall dossier; DOS)
pub fn qtp_mdz_fm() -> f64 { return 0.91 }

// Ratios of a modulated set to its base: o[0] systemic CL ratio (= 1 / IV AUC ratio), o[1] oral AUC
// ratio (= (F'/CL')/(F/CL)), o[2] F ratio.
pub fn qtp_ratios(th: &[f64; 18], fm: f64, a_h: f64, a_g: f64, o: &![f64; 4]) -> i32 with Mut, Div, Panic {
    var t: [f64; 18] = [0.0; 18]
    var c0: [f64; 8] = [0.0; 8]
    var c1: [f64; 8] = [0.0; 8]
    qtp_closed(th, &!c0)
    qtp_modulate(th, fm, a_h, a_g, &!t)
    qtp_closed(&t, &!c1)
    (*o)[0] = c1[4] / c0[4]
    (*o)[1] = c0[5] / c1[5]
    (*o)[2] = c1[3] / c0[3]
    return 0
}

// (a_h, a_g) of a CYP3A inhibitor from a midazolam IV clearance ratio r_iv (with / without) and an
// oral AUC ratio r_po, through the midazolam value array thm: nested bisection (a_h on the IV ratio
// for each a_g; a_g on the oral ratio). o[0] a_h, o[1] a_g, o[2], o[3] the two ratios reproduced.
// If even a_g = 0 does not reach r_po the gut factor is 0 and o[3] shows the shortfall.
pub fn qtp_factors_from_mdz(thm: &[f64; 18], r_iv: f64, r_po: f64, o: &![f64; 4]) -> i32 with Mut, Div, Panic {
    let fm = qtp_mdz_fm()
    var r: [f64; 4] = [0.0; 4]
    var glo = 0.0
    var ghi = 1.0
    var ah = 1.0
    var ag = 0.5
    var it: i32 = 0
    while it < 24 {
        ag = 0.5 * (glo + ghi)
        if it == 23 && glo == 0.0 { ag = 0.0 }
        var lo = 0.0
        var hi = 1.0
        var jt: i32 = 0
        while jt < 24 {
            ah = 0.5 * (lo + hi)
            qtp_ratios(thm, fm, ah, ag, &!r)
            if r[0] > r_iv {
                hi = ah
            } else {
                lo = ah
            }
            jt = jt + 1
        }
        qtp_ratios(thm, fm, ah, ag, &!r)
        if r[1] < r_po {
            ghi = ag
        } else {
            glo = ag
        }
        it = it + 1
    }
    (*o)[0] = ah
    (*o)[1] = ag
    (*o)[2] = r[0]
    (*o)[3] = r[1]
    return 0
}

// DERIVED PRIOR for the gut wall: clint_gut = rr x fm x clint, rr a gut:liver ratio of CYP3A intrinsic
// clearance, with clint refitted to clf (fixed point, 30 passes). o[0] clint_gut, o[1] clint, o[2] Fg,
// o[3] F.
pub fn qtp_prior_fg(th: &[f64; 18], clf: f64, rr: f64, fm: f64, o: &![f64; 4]) -> i32 with Mut, Div, Panic {
    var t: [f64; 18] = [0.0; 18]
    var c: [f64; 8] = [0.0; 8]
    var i: i32 = 0
    while i < 18 {
        t[i] = (*th)[i]
        i = i + 1
    }
    var k: i32 = 0
    while k < 30 {
        t[CD_CLINT] = qtp_fit_clint(&t, clf)
        t[CD_CLGUT] = rr * fm * t[CD_CLINT]
        k = k + 1
    }
    t[CD_CLINT] = qtp_fit_clint(&t, clf)
    qtp_closed(&t, &!c)
    (*o)[0] = t[CD_CLGUT]
    (*o)[1] = t[CD_CLINT]
    (*o)[2] = c[0]
    (*o)[3] = c[3]
    return 0
}

// Carbamazepine (CYP3A4 induction): fold = 1 + Emax I/(EC50 + I). Fuhr 2021 pair (EC50 20 uM,
// Emax 6; whether EC50 is total or unbound is not stated in the dossier) and the average plasma
// concentration at 600 mg/day, 9.5 ug/mL (Datta-Mannan 2024, AB), MW 236.27, fu 0.25.
// which 0: I = unbound concentration; 1: I = total concentration.
pub fn qtp_cbz_fold(which: i32) -> f64 with Mut, Div, Panic {
    let ctot = 9.5 * 1000.0 / 236.27
    var cc = ctot * 0.25
    if which == 1 { cc = ctot }
    return 1.0 + 6.0 * cc / (20.0 + cc)
}
