//@ run-pass
//@ expect-stdout: PASS

// stdlib/darwin_pbpk/core/schmitt_phospholipid.sio
// ----------------------------------------------------------------------------
// Corrected phospholipid association terms from Schmitt (2008), Eqs. 17/18.
//
// The original publication reverses the 0.05 and 20 coefficients between the
// acidic and basic equations.  This is a coefficient reversal, not a swap of
// the neutral- and acidic-phospholipid labels.  The published corrigendum
// (doi:10.1016/j.tiv.2008.04.020) corrects Table 2 columns 6 and 7; it does not
// correct Eqs. 17/18.  The independent Wright (2015) dissertation identifies
// the coefficient reversal explicitly, and the corrected orientation is also
// used by Pearce et al. (2017) and httk's Schmitt implementation.
//
// Primary: Schmitt W. Toxicol In Vitro 22 (2008) 457-467,
//          doi:10.1016/j.tiv.2007.09.010.
// Independent check: Wright (2015), OhioLINK ETD, accession wright1432890247.

// Basic species: the cationic fraction has 20-fold acidic-phospholipid
// association relative to the neutral species.
pub fn schmitt_pl_association_base(kn_pl: f64, fraction_neutral: f64,
                                   fraction_positive: f64) -> f64 {
    return kn_pl * (fraction_neutral + 20.0 * fraction_positive)
}

// Acidic species: the anionic fraction has 0.05-fold association relative to
// the neutral species.
pub fn schmitt_pl_association_acid(kn_pl: f64, fraction_neutral: f64,
                                   fraction_negative: f64) -> f64 {
    return kn_pl * (fraction_neutral + 0.05 * fraction_negative)
}

// General form for a caller that already carries all three ionisation
// fractions.  For a monoprotic acid or base one charged fraction is zero.
pub fn schmitt_pl_association(kn_pl: f64, fraction_neutral: f64,
                              fraction_zwitter: f64,
                              fraction_positive: f64,
                              fraction_negative: f64) -> f64 {
    return kn_pl * (fraction_neutral + fraction_zwitter
                    + 20.0 * fraction_positive
                    + 0.05 * fraction_negative)
}

// Deliberately wrong reproduction of the original coefficient reversal.
// Private: it exists only as the negative control below.
fn schmitt_pl_reversed_coefficients(kn_pl: f64, fraction_neutral: f64,
                                    fraction_zwitter: f64,
                                    fraction_positive: f64,
                                    fraction_negative: f64) -> f64 {
    return kn_pl * (fraction_neutral + fraction_zwitter
                    + 0.05 * fraction_positive
                    + 20.0 * fraction_negative)
}

fn main() -> i32 with IO, Mut {
    var fails = 0

    // Asymmetric charged fractions are essential: equal positive and negative
    // fractions would let the reversed-coefficient mutant pass.
    let corrected = schmitt_pl_association(2.0, 0.15, 0.10, 0.50, 0.25)
    let reversed = schmitt_pl_reversed_coefficients(2.0, 0.15, 0.10, 0.50, 0.25)

    if corrected > 20.524 {
        if corrected < 20.526 {
            if reversed > 10.549 {
                if reversed < 10.551 {
                    if corrected - reversed > 9.97 {
                        println("T1 PASS: asymmetric case rejects reversed coefficients")
                    } else {
                        println("T1 FAIL: corrected and reversed forms are not separated"); fails = fails + 1
                    }
                } else {
                    println("T1 FAIL: reversed mutant above expected band"); fails = fails + 1
                }
            } else {
                println("T1 FAIL: reversed mutant below expected band"); fails = fails + 1
            }
        } else {
            println("T1 FAIL: corrected value above expected band"); fails = fails + 1
        }
    } else {
        println("T1 FAIL: corrected value below expected band"); fails = fails + 1
    }

    let basic = schmitt_pl_association_base(2.0, 0.25, 0.50)
    let acidic = schmitt_pl_association_acid(2.0, 0.25, 0.25)
    if basic > 20.49 {
        if basic < 20.51 {
            if acidic > 0.524 {
                if acidic < 0.526 {
                    println("T2 PASS: basic and acidic corrected forms are oriented")
                } else {
                    println("T2 FAIL: acidic form above expected band"); fails = fails + 1
                }
            } else {
                println("T2 FAIL: acidic form below expected band"); fails = fails + 1
            }
        } else {
            println("T2 FAIL: basic form above expected band"); fails = fails + 1
        }
    } else {
        println("T2 FAIL: basic form below expected band"); fails = fails + 1
    }

    if fails == 0 {
        println("PASS")
        return 0
    }
    println("FAIL")
    return 1
}
