//@ run-pass
//@ expect-stdout: PASS

// stdlib/darwin_pbpk/core/rodgers_rowland.sio
// Rodgers-Rowland (2006) mechanistic tissue:plasma partition coefficient
// prediction for neutral compounds with GUM uncertainty propagation.
//
// Reference: Rodgers T & Rowland M (2006) J Pharm Sci 95(6):1238-1257,
//            doi:10.1002/jps.20502.
//
// SCOPE: Neutral compounds only (rapamycin is a neutral macrolide, pKa N/A).
//
// VALIDATED RANGE: The R-R model was calibrated on drugs with logP < 4.
// For rapamycin (logP = 7.0), absolute Kp values are overestimated due to
// the linear lipid partitioning term dominating outside the model's domain
// (Poulin et al. 2011 Pharm Res 28:1562). This module therefore provides:
//   1. Raw R-R Kp predictions (documents systematic overestimation)
//   2. Dimensionless log-sensitivities ∂ln(Kp_i)/∂logP (valid across logP range)
//   3. GUM scaled uncertainties: sensitivities × literature Kp (for GUM budget)
//
// For GUM budget purposes, the sensitivity structure from R-R is applied to
// the literature Kp values (rapamycin.sio), consistent with JCGM 100:2008 §5.1.3.
//
// GUM formula (JCGM 100:2008 Eq 13):
//   u²(Kp_i) = [∂Kp_i/∂logP]² u²(logP) + [∂Kp_i/∂fu]² u²(fu)
//
// 14-compartment ordering (matching tsit5_pbpk14.sio):
//   0=blood, 1=liver, 2=kidney, 3=brain, 4=heart, 5=lung, 6=muscle,
//   7=adipose, 8=gut, 9=skin, 10=bone, 11=spleen, 12=pancreas, 13=other

// ============================================================================
// MATH HELPERS
// ============================================================================

use math::pure::{exp, sqrt}

fn rr_sqrt(x: f64) -> f64 with Mut, Div, Panic {
    // Delegate to the shared range-reduced square-root helper.
    sqrt(x)
}

fn rr_abs(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

// exp(x) — Taylor series, matches ppcr_neural_net_demo pattern
fn rr_exp(x: f64) -> f64 with Mut, Div, Panic {
    // #846: delegate to the shared, full-range math::pure::exp.
    exp(x)
}

// 10^x = exp(x * ln(10))
fn rr_pow10(x: f64) -> f64 with Mut, Div, Panic {
    rr_exp(x * 2.302585092994046)
}

// ============================================================================
// TISSUE COMPOSITION TABLE (R-R 2006, Table 1 + PK-Sim defaults)
// ============================================================================
// All fractions as volume fractions (dimensionless).
// Sources: Rodgers & Rowland (2006) Table 1 for most tissues;
//          PK-Sim Human Reference Values for adipose/bone/other.

fn rr_fw_e(i: i32) -> f64 {   // extracellular water
    if i == 0  { return 0.620 }   // blood
    if i == 1  { return 0.161 }   // liver
    if i == 2  { return 0.273 }   // kidney
    if i == 3  { return 0.092 }   // brain (Rodgers 2006 Table 1)
    if i == 4  { return 0.320 }   // heart
    if i == 5  { return 0.312 }   // lung
    if i == 6  { return 0.118 }   // muscle
    if i == 7  { return 0.135 }   // adipose
    if i == 8  { return 0.282 }   // gut
    if i == 9  { return 0.382 }   // skin
    if i == 10 { return 0.100 }   // bone
    if i == 11 { return 0.207 }   // spleen
    if i == 12 { return 0.125 }   // pancreas
    return 0.200                   // other
}

fn rr_fw_i(i: i32) -> f64 {   // intracellular water
    if i == 0  { return 0.038 }
    if i == 1  { return 0.573 }
    if i == 2  { return 0.483 }
    if i == 3  { return 0.678 }   // brain high intracellular (Rodgers 2006)
    if i == 4  { return 0.456 }
    if i == 5  { return 0.392 }
    if i == 6  { return 0.630 }
    if i == 7  { return 0.017 }   // adipose: mostly lipid, little water
    if i == 8  { return 0.475 }
    if i == 9  { return 0.291 }
    if i == 10 { return 0.346 }
    if i == 11 { return 0.579 }
    if i == 12 { return 0.631 }
    return 0.500
}

fn rr_fn_l(i: i32) -> f64 {   // neutral lipid fraction
    if i == 0  { return 0.0019 }
    if i == 1  { return 0.0140 }
    if i == 2  { return 0.0130 }
    if i == 3  { return 0.0390 }   // brain: significant myelin lipid
    if i == 4  { return 0.0140 }
    if i == 5  { return 0.0220 }
    if i == 6  { return 0.0100 }
    if i == 7  { return 0.8530 }   // adipose: dominant lipid depot
    if i == 8  { return 0.0380 }
    if i == 9  { return 0.0600 }
    if i == 10 { return 0.0170 }
    if i == 11 { return 0.0110 }
    if i == 12 { return 0.0200 }
    return 0.0200
}

fn rr_fn_ph(i: i32) -> f64 {  // phospholipid fraction
    if i == 0  { return 0.0019 }
    if i == 1  { return 0.0240 }
    if i == 2  { return 0.0120 }
    if i == 3  { return 0.0360 }   // brain: rich in phospholipid
    if i == 4  { return 0.0110 }
    if i == 5  { return 0.0130 }
    if i == 6  { return 0.0070 }
    if i == 7  { return 0.0020 }
    if i == 8  { return 0.0160 }
    if i == 9  { return 0.0040 }
    if i == 10 { return 0.0020 }
    if i == 11 { return 0.0110 }
    if i == 12 { return 0.0130 }
    return 0.0100
}

// ============================================================================
// OUTPUT STRUCTURES
// ============================================================================

pub struct RRResult {
    // Raw R-R Kp values (may overestimate for logP > 4, see header)
    kp: [f64; 14],
    // Dimensionless log-sensitivity ∂ln(Kp_i)/∂logP for each tissue
    // Bounded by ln(10) ≈ 2.303 in the lipid-dominated regime (logP >> 4)
    log_sens: [f64; 14],
    // GUM uncertainty u(Kp_i) using raw R-R values
    kp_unc_raw: [f64; 14],
    logP: f64,
    fu_plasma: f64,
}

pub struct RRScaledUnc {
    // GUM uncertainty applied to literature Kp values:
    //   u(Kp_i) = sqrt( (log_sens_i * u_logP * Kp_lit_i)^2 + (Kp_lit_i/fu * u_fu)^2 )
    u_kp: [f64; 14],
    conf: f64,   // Evidence quality: 0.60 (R-R sensitivity + literature Kp)
}

// ============================================================================
// CORE COMPUTATION — Neutral Compound R-R (Eq. 6 in Rodgers 2006)
// ============================================================================
// For a neutral molecule (no ionization, fu_water = 1.0):
//   Kpu_i = fw_e_i + fw_i_i + P*(fn_L_i + 0.3*fn_P_i)
//   Kp_i  = fu_plasma * Kpu_i
//
// Declared concentration conventions:
//   Kpu   = C_tissue,total / C_plasma,unbound
//   Kp    = C_tissue,total / C_plasma,total
//   Kp,uu = C_tissue,unbound / C_plasma,unbound
// Therefore Kp = fu_plasma*Kpu and Kp,uu = (fu_tissue/fu_plasma)*Kp.
// This neutral function does not use or recompute blood:plasma ratio or Ka.
//
// Analytical GUM sensitivities:
//   ∂Kp/∂logP = fu_plasma * P * ln(10) * (fn_L + 0.3*fn_P)
//   ∂Kp/∂fu   = Kpu = Kp / fu_plasma
//   u²(Kp) = (∂Kp/∂logP)² u²(logP) + (∂Kp/∂fu)² u²(fu)

pub fn rr_neutral(
    logP: f64,
    fu_plasma: f64,
    u_logP: f64,
    u_fu: f64
) -> RRResult with Mut, Div, Panic {
    let P = rr_pow10(logP)
    let ln10 = 2.302585092994046

    var kp: [f64; 14] = [0.0; 14]
    var log_sens: [f64; 14] = [0.0; 14]
    var kp_unc_raw: [f64; 14] = [0.0; 14]

    var i = 0
    while i < 14 {
        let fw_e = rr_fw_e(i)
        let fw_i = rr_fw_i(i)
        let fn_l = rr_fn_l(i)
        let fn_ph = rr_fn_ph(i)

        // Lipid composite term (neutral lipid + 30% of phospholipid)
        let lipid_c = fn_l + 0.3 * fn_ph

        // Total tissue:unbound plasma ratio
        let kpu = fw_e + fw_i + P * lipid_c

        // Total tissue:total plasma
        let kp_i = fu_plasma * kpu
        kp[i] = kp_i

        // GUM sensitivity coefficients (analytical)
        let dkp_dlogP = fu_plasma * P * ln10 * lipid_c
        let dkp_dfu   = kpu

        // Combined GUM variance (JCGM 100:2008 Eq 13)
        let var_i = dkp_dlogP * dkp_dlogP * u_logP * u_logP
                  + dkp_dfu   * dkp_dfu   * u_fu   * u_fu
        kp_unc_raw[i] = rr_sqrt(var_i)

        // Log-sensitivity: ∂ln(Kp_i)/∂logP — bounded by ln(10) for logP >> 4
        if kp_i > 1.0e-12 {
            log_sens[i] = dkp_dlogP / kp_i
        }

        i = i + 1
    }

    RRResult {
        kp: kp,
        log_sens: log_sens,
        kp_unc_raw: kp_unc_raw,
        logP: logP,
        fu_plasma: fu_plasma,
    }
}

// Convenience: rapamycin physicochemical inputs
//   logP = 7.0 (Vaidyanathan 2001), u_logP = 1.05 (CV = 15%)
//   fu_plasma = 0.08 (Schreiber 1991), u_fu = 0.02 (CV = 25%)
pub fn rr_rapamycin() -> RRResult with Mut, Div, Panic {
    rr_neutral(7.0, 0.08, 1.05, 0.02)
}

// ============================================================================
// GUM SCALING: Apply R-R sensitivities to literature Kp values
// ============================================================================
// For logP > 4 compounds (rapamycin), absolute R-R Kp overestimates.
// The sensitivity STRUCTURE (relative tissue ordering, ∂ln Kp/∂logP) is
// preserved even outside the validated domain (Poulin 2011).
//
// Scaled GUM uncertainty for each tissue i:
//   u(Kp_i)² = (log_sens_i × u_logP × Kp_lit_i)² + (Kp_lit_i / fu × u_fu)²
//
// Confidence: 0.60 (R-R sensitivity applied to literature Kp — single calibration)

pub fn rr_scaled_uncertainty(
    rr: RRResult,
    kp_lit: [f64; 14],
    u_logP: f64,
    u_fu: f64
) -> RRScaledUnc with Mut, Div, Panic {
    var u_kp: [f64; 14] = [0.0; 14]
    var i = 0
    while i < 14 {
        let ls = rr.log_sens[i]
        let kp_i = kp_lit[i]
        let fu = rr.fu_plasma

        // logP contribution: u(Kp_i) from u_logP
        let term_logP = ls * u_logP * kp_i

        // fu contribution: u(Kp_i) from u_fu — ∂Kp/∂fu = Kp/fu
        let term_fu = kp_i / fu * u_fu

        u_kp[i] = rr_sqrt(term_logP * term_logP + term_fu * term_fu)
        i = i + 1
    }
    RRScaledUnc { u_kp: u_kp, conf: 0.60 }
}

// ============================================================================
// RAPAMYCIN LITERATURE Kp VALUES (matching tsit5_pbpk14 ordering)
// ============================================================================
// Sources: Lampen 1998 (brain), Serkova 2000 (muscle, kidney),
//          Napoli 2001 (liver, lung), Ferron 1997 (adipose capped model)
pub fn rr_rapamycin_kp_literature() -> [f64; 14] with Mut {
    var kp: [f64; 14] = [0.0; 14]
    kp[0]  = 1.0    // blood (by definition, reference compartment)
    kp[1]  = 8.0    // liver   — high hepatic uptake (CYP3A4 site)
    kp[2]  = 4.0    // kidney
    kp[3]  = 0.08   // brain   — P-gp efflux limited
    kp[4]  = 3.5    // heart
    kp[5]  = 10.0   // lung
    kp[6]  = 3.5    // muscle
    kp[7]  = 0.3    // adipose — capped for 48h BBB-focus model
    kp[8]  = 5.0    // gut
    kp[9]  = 2.0    // skin
    kp[10] = 1.5    // bone
    kp[11] = 6.0    // spleen
    kp[12] = 4.0    // pancreas
    kp[13] = 0.5    // other
    kp
}

// ============================================================================
// LEGACY API (preserves compatibility with any existing callers)
// ============================================================================

struct TissueComposition {
    f_water: f64,
    f_ew: f64,
    f_iw: f64,
    f_neutral_lipid: f64,
    f_phospholipid: f64,
    f_acidic_phospholipid: f64,
    f_protein: f64,
    pH_iw: f64,
}

fn tissue_liver() -> TissueComposition {
    TissueComposition { f_water: 0.751, f_ew: 0.161, f_iw: 0.573, f_neutral_lipid: 0.014, f_phospholipid: 0.024, f_acidic_phospholipid: 0.005, f_protein: 0.157, pH_iw: 7.0 }
}

fn tissue_brain() -> TissueComposition {
    TissueComposition { f_water: 0.770, f_ew: 0.092, f_iw: 0.678, f_neutral_lipid: 0.039, f_phospholipid: 0.036, f_acidic_phospholipid: 0.0059, f_protein: 0.048, pH_iw: 7.0 }
}

fn tissue_kidney() -> TissueComposition {
    TissueComposition { f_water: 0.783, f_ew: 0.209, f_iw: 0.483, f_neutral_lipid: 0.012, f_phospholipid: 0.024, f_acidic_phospholipid: 0.005, f_protein: 0.127, pH_iw: 7.0 }
}

struct DrugPropertiesRR {
    logP: f64,
    pKa: f64,
    fu_plasma: f64,
    is_acid: bool,
    blood_plasma_ratio: f64,
}

// ============================================================================
// MAIN — Gate tests
// ============================================================================
// T1: Lipid-driven ordering: Kp_adipose > Kp_liver > Kp_brain (correct for
//     neutral lipophilic drugs regardless of absolute values)
// T2: GUM uncertainties non-zero for all 14 compartments
// T3: Log-sensitivities in valid range (0, ln(10)] for lipid-rich tissues
// T4: Scaled GUM uncertainties non-zero and finite
// T5: Kp = fu_plasma * Kpu at logP = 0, organ by organ
// T6: central-difference dKp/dfu = Kpu > 0 at fu = 0.2
// T7: central-difference dKp/dlogP matches the analytical coefficient
// T8: raw GUM uncertainty squared recovers its analytical variance
// T9: shared exp path anchors 10^-3 and 10^7 to their absolute values

fn main() -> i32 with IO, Mut, Div, Panic {
    let rr = rr_rapamycin()
    let kp_lit = rr_rapamycin_kp_literature()
    let scaled = rr_scaled_uncertainty(rr, kp_lit, 1.05, 0.02)

    var passed = 0
    var failed = 0

    // T1: Adipose (7) >> liver (1) in absolute R-R Kp (adipose fn_L=0.853 vs liver 0.014)
    //     Brain (3) > liver (1) because brain has higher lipid+phospholipid in R-R table
    //     (myelin-rich tissue; P-gp limitation not in R-R — accounted by literature Kp)
    let kp_adipose = rr.kp[7]
    let kp_liver   = rr.kp[1]
    let kp_brain   = rr.kp[3]
    if kp_adipose > kp_brain && kp_brain > kp_liver {
        println("T1 PASS: R-R ordering adipose > brain > liver (lipid-dominated neutral)")
        passed = passed + 1
    } else {
        println("T1 FAIL: unexpected Kp ordering")
        failed = failed + 1
    }

    // T2: All 14 uncertainties non-zero
    var unc_ok = 0
    var i = 0
    while i < 14 {
        if rr.kp_unc_raw[i] > 0.0 { unc_ok = unc_ok + 1 }
        i = i + 1
    }
    if unc_ok == 14 {
        println("T2 PASS: GUM uncertainties non-zero (14/14 compartments)")
        passed = passed + 1
    } else {
        print("T2 FAIL: only ")
        print_int(unc_ok)
        println("/14 compartments have non-zero GUM uncertainty")
        failed = failed + 1
    }

    // T3: Log-sensitivity of adipose and liver > 0 and ≤ ln(10)
    let ls_adipose = rr.log_sens[7]
    let ls_liver   = rr.log_sens[1]
    let ln10 = 2.302585
    if ls_adipose > 0.0 && ls_adipose <= ln10 + 0.01 && ls_liver > 0.0 {
        println("T3 PASS: log-sensitivities in valid range for lipid-rich tissues")
        passed = passed + 1
    } else {
        println("T3 FAIL: log-sensitivity out of expected range")
        failed = failed + 1
    }

    // T5: Closed-form unit conversion. At logP = 0, P = 1. The tissue
    // composition and logP stay fixed; B:P and Ka are outside this neutral
    // partition function and therefore not recomputed.
    let unit_point = rr_neutral(0.0, 0.2, 0.0, 0.0)
    var unit_ok = 0
    var u = 0
    while u < 14 {
        let lipid_c = rr_fn_l(u) + 0.3 * rr_fn_ph(u)
        let kpu = rr_fw_e(u) + rr_fw_i(u) + lipid_c
        let expected_kp = 0.2 * kpu
        let err = rr_abs(unit_point.kp[u] - expected_kp)
        if err <= 1.0e-12 * (1.0 + rr_abs(expected_kp)) {
            unit_ok = unit_ok + 1
        }
        u = u + 1
    }
    if unit_ok == 14 {
        println("T5 PASS: Kp = fu_plasma * Kpu (14/14)")
        passed = passed + 1
    } else {
        print("T5 FAIL: closed-form Kp conversion matched ")
        print_int(unit_ok)
        println("/14 tissues")
        failed = failed + 1
    }

    // T6: fu sensitivity at logP = 0 and fu = 0.2. Central difference uses
    // h = 1e-6; logP, tissue composition, B:P and Ka policy remain fixed.
    let h_fu = 1.0e-6
    let fu_lo = rr_neutral(0.0, 0.2 - h_fu, 0.0, 0.0)
    let fu_hi = rr_neutral(0.0, 0.2 + h_fu, 0.0, 0.0)
    var dfu_ok = 0
    var f = 0
    while f < 14 {
        let numerical = (fu_hi.kp[f] - fu_lo.kp[f]) / (2.0 * h_fu)
        let expected = unit_point.kp[f] / 0.2
        let err = rr_abs(numerical - expected)
        if numerical > 0.0 && err <= 1.0e-8 * (1.0 + rr_abs(expected)) {
            dfu_ok = dfu_ok + 1
        }
        f = f + 1
    }
    if dfu_ok == 14 {
        println("T6 PASS: dKp/dfu = Kpu > 0 (14/14; h=1e-6)")
        passed = passed + 1
    } else {
        print("T6 FAIL: fu derivative matched ")
        print_int(dfu_ok)
        println("/14 tissues")
        failed = failed + 1
    }

    // T7: logP sensitivity at logP = 0 and fu = 0.2. Central difference
    // uses h = 1e-6; fu, composition, B:P and Ka policy remain fixed.
    let h_logp = 1.0e-6
    let logp_lo = rr_neutral(0.0 - h_logp, 0.2, 0.0, 0.0)
    let logp_hi = rr_neutral(h_logp, 0.2, 0.0, 0.0)
    let ln10_exact = 2.302585092994046
    var dlogp_ok = 0
    var g = 0
    while g < 14 {
        let numerical = (logp_hi.kp[g] - logp_lo.kp[g]) / (2.0 * h_logp)
        let lipid_c = rr_fn_l(g) + 0.3 * rr_fn_ph(g)
        let expected = 0.2 * ln10_exact * lipid_c
        let err = rr_abs(numerical - expected)
        if err <= 1.0e-8 * (1.0 + rr_abs(expected)) {
            dlogp_ok = dlogp_ok + 1
        }
        g = g + 1
    }
    if dlogp_ok == 14 {
        println("T7 PASS: dKp/dlogP analytical agreement (14/14; h=1e-6)")
        passed = passed + 1
    } else {
        print("T7 FAIL: logP derivative matched ")
        print_int(dlogp_ok)
        println("/14 tissues")
        failed = failed + 1
    }

    // T8: rr_sqrt must remain accurate at the actual rapamycin variance
    // magnitudes. Squaring the reported standard uncertainty must recover the
    // analytical variance; this catches fixed-iteration Newton paths that stop
    // before reaching their quadratic-convergence regime.
    let p_rapa = rr_pow10(7.0)
    var variance_ok = 0
    var v = 0
    while v < 14 {
        let lipid_c = rr_fn_l(v) + 0.3 * rr_fn_ph(v)
        let kpu = rr_fw_e(v) + rr_fw_i(v) + p_rapa * lipid_c
        let dkp_dlogp = 0.08 * p_rapa * 2.302585092994046 * lipid_c
        let term_logp = dkp_dlogp * 1.05
        let term_fu = kpu * 0.02
        let expected_variance = term_logp * term_logp + term_fu * term_fu
        let observed_variance = rr.kp_unc_raw[v] * rr.kp_unc_raw[v]
        let err = rr_abs(observed_variance - expected_variance)
        if err <= 1.0e-9 * (1.0 + rr_abs(expected_variance)) {
            variance_ok = variance_ok + 1
        }
        v = v + 1
    }
    if variance_ok == 14 {
        println("T8 PASS: raw GUM sqrt recovers variance (14/14)")
        passed = passed + 1
    } else {
        print("T8 FAIL: raw GUM sqrt recovered ")
        print_int(variance_ok)
        println("/14 variances")
        failed = failed + 1
    }

    // T9: #846 moved rr_exp to math::pure::exp. Absolute anchors verify that
    // the obsolete fixed Taylor path from historical PR #2703 is not active.
    let pow10_low_err = rr_abs(rr_pow10(0.0 - 3.0) - 0.001)
    let pow10_high_err = rr_abs(rr_pow10(7.0) - 10000000.0)
    if pow10_low_err <= 1.0e-12 && pow10_high_err <= 1.0e-3 {
        println("T9 PASS: rr_pow10 absolute anchors (-3, 7)")
        passed = passed + 1
    } else {
        println("T9 FAIL: rr_pow10 absolute anchors (-3, 7)")
        failed = failed + 1
    }

    // T4: Scaled GUM uncertainties non-zero for literature Kp
    var scaled_ok = 0
    var j = 0
    while j < 14 {
        if scaled.u_kp[j] > 0.0 { scaled_ok = scaled_ok + 1 }
        j = j + 1
    }
    if scaled_ok == 14 {
        println("T4 PASS: scaled GUM uncertainties non-zero (14/14)")
        passed = passed + 1
    } else {
        print("T4 FAIL: only ")
        print_int(scaled_ok)
        println("/14 scaled uncertainties are non-zero")
        failed = failed + 1
    }

    println("")
    print("R-R summary — rapamycin (logP=7.0, fu=0.08):")
    println("")
    print("  Kp_liver (lit=8.0)  u_Kp=")
    print(scaled.u_kp[1])
    println("")
    print("  Kp_brain (lit=0.08) u_Kp=")
    print(scaled.u_kp[3])
    println("")
    print("  Kp_adipose(lit=0.3) u_Kp=")
    print(scaled.u_kp[7])
    println("")
    print("  [NOTE] R-R raw Kp overestimates logP>4 drugs by design")
    println("")
    print("  log_sens_adipose=")
    print(rr.log_sens[7])
    print("  log_sens_liver=")
    print(rr.log_sens[1])
    print("  log_sens_brain=")
    print(rr.log_sens[3])
    println("")

    if failed == 0 {
        println("PASS")
        return 0
    } else {
        println("FAIL")
        return 1
    }
}
