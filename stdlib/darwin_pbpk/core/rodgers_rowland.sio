//@ run-pass
//@ expect-stdout: PASS

// stdlib/darwin_pbpk/core/rodgers_rowland.sio
// Rodgers-Rowland (2006) mechanistic tissue:plasma partition coefficient
// prediction for neutral compounds with GUM uncertainty propagation.
//
// Reference: Rodgers T & Rowland M (2006) J Pharm Sci 95(6):1238-1257 (doi:10.1002/jps.20502)
// Erratum:   Rodgers T & Rowland M (2007) J Pharm Sci 96(11):3153-3154 (doi:10.1002/jps.20857)
//            -- zwitterion equations only; does not affect this module's classes.
//
// SCOPE: Neutral compounds only (rapamycin is a neutral macrolide, pKa N/A).
//
// VALIDATED RANGE: The R-R model was calibrated on drugs with logP < 4.
// For rapamycin (logP = 7.0), absolute Kp values are overestimated due to
// the linear lipid partitioning term dominating outside the model's domain
// (Poulin et al. 2011 Pharm Res 28:1562). This module therefore provides:
//   1. Raw R-R Kp predictions (documents systematic overestimation)
//   2. Dimensionless log-sensitivities ∂ln(Kp_i)/∂logP (valid across logP range)
//   3. GUM scaled uncertainties: sensitivities × literature Kp (for GUM budget)
//
// For GUM budget purposes, the sensitivity structure from R-R is applied to
// the literature Kp values (rapamycin.sio), consistent with JCGM 100:2008 §5.1.3.
//
// HOW FAR OUT OF DOMAIN rapamycin is, measured 2026-09-26 rather than implied
// by "overestimates". At logP = 7.0, P = 1e7 and the lipid term dominates.
// Like for like, both as Kp (total tissue : total plasma), fu = 0.08:
//   this function returns      1702.31 (blood) .. 588278.57 (adipose)
//   rr_rapamycin_kp_literature   0.08  (brain) ..      10.00 (lung)
// Compared TISSUE BY TISSUE, the overprediction spans a factor of 1642.5 to
// 1960928.6, i.e. 3.2 to 6.3 ORDERS of magnitude -- not a modest bias.
// Nothing may read `RRResult.kp` for rapamycin and call it a prediction.
// (An earlier version of this note compared Kpu against total-plasma
// literature Kp and quoted the literature floor as 1 rather than 0.08; both
// are corrected here.)
//
// ERRATUM CHECKED (2026-09-26). Rodgers & Rowland published a correction to
// the 2006 paper: J Pharm Sci 96(11):3153-3154, Nov 2007,
// doi:10.1002/jps.20857 (read in full). It corrects Equations 10 and 14, and
// all derivations from them, for DI-BASIC AND DI-ACIDIC ZWITTERIONS only
// (pipemidic acid, tetracycline, ceftazidime), plus one typo in Table 5
// (tetracycline kidney Kpu is 10.7, not 1.06). It does NOT touch the
// neutral / acid / very-weak-base equations, so the compound classes this
// module implements are unaffected by it, and neither are midazolam or
// ketoconazole. The erratum states the accuracy figures and conclusions of the
// original paper are unchanged.
//
// OPEN LEAD from that erratum, NOT yet applied to the code. Its printed
// equations carry the phospholipid term as (0.3*P + 0.7)*fNP, whereas this
// module uses 0.3*P*fNP inside the P factor -- i.e. the module appears to be
// missing a "+ 0.7*fNP" contribution outside the lipophilicity factor
// (magnitude ~0.007 to 0.028 given fNP of 0.01 to 0.04). The erratum prints
// that term only for zwitterions, so carrying it over to the neutral equation
// would be an inference across compound classes, not a reading of the neutral
// equation. Deliberately NOT changed until R&R 2006's own neutral/acid
// equation (Eq 8/9) is read; recorded here so the lead is not lost.
//
// STILL UNRESOLVED, pending R&R 2006 itself (not in PMC; the equations and
// Table 1 could not be retrieved, and are not reconstructed from memory here):
//   - the extracellular-protein (albumin) term. The 2006 abstract states it is
//     incorporated "for the other compound classes", which includes neutrals,
//     so this implementation is missing a term the paper has.
//   - which tissue-composition table is the paper's. This file's rr_fw_e /
//     rr_fw_i / rr_fn_l / rr_fn_ph accessors (the ones rr_neutral calls) and
//     core/tissue_composition.sio (which has no caller) disagree on 30 of 70
//     values, worst at lung neutral lipid 0.0220 vs 0.0030 (7.3x). At most one
//     of them is R&R 2006 Table 1. tissue_kidney() in this file disagrees with
//     this file's own accessors as well.
//   - ionisable species. This module is neutral-only, so it cannot predict Kp
//     for midazolam (weak base, pKa 6.2) or ketoconazole (dibasic 6.51/2.94),
//     both of which fall under the 2006 paper's scope but need its ionisation
//     terms. R&R 2005 (pKa >= 7 bases, doi:10.1002/jps.20322) does not apply
//     to either.
//
// GUM formula (JCGM 100:2008 Eq 13):
//   u²(Kp_i) = [∂Kp_i/∂logP]² u²(logP) + [∂Kp_i/∂fu]² u²(fu)
//
// 14-compartment ordering (matching tsit5_pbpk14.sio):
//   0=blood, 1=liver, 2=kidney, 3=brain, 4=heart, 5=lung, 6=muscle,
//   7=adipose, 8=gut, 9=skin, 10=bone, 11=spleen, 12=pancreas, 13=other

// ============================================================================
// MATH HELPERS
// ============================================================================

fn rr_sqrt(x: f64) -> f64 with Mut, Div {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 12 { y = (y + x / y) * 0.5; i = i + 1 }
    y
}

fn rr_abs(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

// exp(x) — Taylor series, matches ppcr_neural_net_demo pattern
fn rr_exp(x: f64) -> f64 with Mut, Div, Panic {
    if x > 20.0 { return rr_exp(x - 10.0) * rr_exp(10.0) }
    if x < 0.0 - 20.0 { return 0.0 }
    var sum = 1.0
    var term = 1.0
    var i = 1
    while i <= 20 {
        term = term * x / (i as f64)
        sum = sum + term
        i = i + 1
    }
    sum
}

// 10^x = exp(x * ln(10))
fn rr_pow10(x: f64) -> f64 with Mut, Div, Panic {
    rr_exp(x * 2.302585092994046)
}

// ============================================================================
// TISSUE COMPOSITION TABLE (R-R 2006, Table 1 + PK-Sim defaults)
// ============================================================================
// All fractions as volume fractions (dimensionless).
// Sources: Rodgers & Rowland (2006) Table 1 for most tissues;
//          PK-Sim Human Reference Values for adipose/bone/other.

fn rr_fw_e(i: i32) -> f64 {   // extracellular water
    if i == 0  { return 0.620 }   // blood
    if i == 1  { return 0.161 }   // liver
    if i == 2  { return 0.273 }   // kidney
    if i == 3  { return 0.092 }   // brain (Rodgers 2006 Table 1)
    if i == 4  { return 0.320 }   // heart
    if i == 5  { return 0.312 }   // lung
    if i == 6  { return 0.118 }   // muscle
    if i == 7  { return 0.135 }   // adipose
    if i == 8  { return 0.282 }   // gut
    if i == 9  { return 0.382 }   // skin
    if i == 10 { return 0.100 }   // bone
    if i == 11 { return 0.207 }   // spleen
    if i == 12 { return 0.125 }   // pancreas
    return 0.200                   // other
}

fn rr_fw_i(i: i32) -> f64 {   // intracellular water
    if i == 0  { return 0.038 }
    if i == 1  { return 0.573 }
    if i == 2  { return 0.483 }
    if i == 3  { return 0.678 }   // brain high intracellular (Rodgers 2006)
    if i == 4  { return 0.456 }
    if i == 5  { return 0.392 }
    if i == 6  { return 0.630 }
    if i == 7  { return 0.017 }   // adipose: mostly lipid, little water
    if i == 8  { return 0.475 }
    if i == 9  { return 0.291 }
    if i == 10 { return 0.346 }
    if i == 11 { return 0.579 }
    if i == 12 { return 0.631 }
    return 0.500
}

fn rr_fn_l(i: i32) -> f64 {   // neutral lipid fraction
    if i == 0  { return 0.0019 }
    if i == 1  { return 0.0140 }
    if i == 2  { return 0.0130 }
    if i == 3  { return 0.0390 }   // brain: significant myelin lipid
    if i == 4  { return 0.0140 }
    if i == 5  { return 0.0220 }
    if i == 6  { return 0.0100 }
    if i == 7  { return 0.8530 }   // adipose: dominant lipid depot
    if i == 8  { return 0.0380 }
    if i == 9  { return 0.0600 }
    if i == 10 { return 0.0170 }
    if i == 11 { return 0.0110 }
    if i == 12 { return 0.0200 }
    return 0.0200
}

fn rr_fn_ph(i: i32) -> f64 {  // phospholipid fraction
    if i == 0  { return 0.0019 }
    if i == 1  { return 0.0240 }
    if i == 2  { return 0.0120 }
    if i == 3  { return 0.0360 }   // brain: rich in phospholipid
    if i == 4  { return 0.0110 }
    if i == 5  { return 0.0130 }
    if i == 6  { return 0.0070 }
    if i == 7  { return 0.0020 }
    if i == 8  { return 0.0160 }
    if i == 9  { return 0.0040 }
    if i == 10 { return 0.0020 }
    if i == 11 { return 0.0110 }
    if i == 12 { return 0.0130 }
    return 0.0100
}

// ============================================================================
// OUTPUT STRUCTURES
// ============================================================================

pub struct RRResult {
    // Raw R-R Kp values (may overestimate for logP > 4, see header)
    kp: [f64; 14],
    // Dimensionless log-sensitivity ∂ln(Kp_i)/∂logP for each tissue
    // Bounded by ln(10) ≈ 2.303 in the lipid-dominated regime (logP >> 4)
    log_sens: [f64; 14],
    // GUM uncertainty u(Kp_i) using raw R-R values
    kp_unc_raw: [f64; 14],
    logP: f64,
    fu_plasma: f64,
}

pub struct RRScaledUnc {
    // GUM uncertainty applied to literature Kp values:
    //   u(Kp_i) = sqrt( (log_sens_i * u_logP * Kp_lit_i)^2 + (Kp_lit_i/fu * u_fu)^2 )
    u_kp: [f64; 14],
    conf: f64,   // Evidence quality: 0.60 (R-R sensitivity + literature Kp)
}

// ============================================================================
// CORE COMPUTATION — Neutral Compound R-R (Eq. 6 in Rodgers 2006)
// ============================================================================
// For a neutral molecule (no ionization, fu_water = 1.0):
//   Kpu_i = fw_e_i + fw_i_i + P*(fn_L_i + 0.3*fn_P_i)
//   Kp_i  = Kpu_i * fu_plasma
//
// UNITS (corrected 2026-09-26; this block previously divided by fu_plasma).
// R&R's Kpu is the "tissue-to-plasma WATER partition coefficient" -- the title
// and abstract of the 2006 paper say so -- i.e. TOTAL tissue concentration per
// unit UNBOUND plasma concentration. The equation above computes exactly that:
// tissue water contributes its volume fraction 1:1 against an unbound driving
// concentration, and neutral lipid/phospholipid contribute P times theirs.
// Since C_plasma,total = C_plasma,unbound / fu_p,
//   Kp = C_tissue,total / C_plasma,total = Kpu * fu_p,
// so the conversion MULTIPLIES by fu_plasma. Dividing was wrong by 1/fu^2
// (156x at rapamycin's fu = 0.08) and had the wrong physical sense: it made a
// more heavily plasma-bound drug look MORE concentrated in tissue, when
// binding drug up in plasma must lower the tissue:plasma total ratio. The
// module's old label for Kpu ("unbound tissue:unbound plasma") was the source
// of the error; that quantity is not what the equation computes.
//
// Sensitivities follow the corrected conversion:
//   dKp/dlogP = P*ln(10)*(fn_L + 0.3*fn_P) * fu_plasma
//   dKp/dfu   = +Kpu = +Kp/fu_plasma      (was -Kp/fu_plasma)
// The dimensionless log-sensitivity dln(Kp)/dlogP is INVARIANT under this
// correction -- numerator and denominator scale together -- which is why the
// GUM path that consumes only log_sens and literature Kp
// (rr_scaled_uncertainty) is numerically unchanged by this fix.
//
// Analytical GUM sensitivities:
//   ∂Kp/∂logP = P * ln(10) * (fn_L + 0.3*fn_P) / fu_plasma
//   ∂Kp/∂fu   = -Kp / fu_plasma
//   u²(Kp) = (∂Kp/∂logP)² u²(logP) + (∂Kp/∂fu)² u²(fu)

pub fn rr_neutral(
    logP: f64,
    fu_plasma: f64,
    u_logP: f64,
    u_fu: f64
) -> RRResult with Mut, Div, Panic {
    let P = rr_pow10(logP)
    let ln10 = 2.302585092994046

    var kp: [f64; 14] = [0.0; 14]
    var log_sens: [f64; 14] = [0.0; 14]
    var kp_unc_raw: [f64; 14] = [0.0; 14]

    var i = 0
    while i < 14 {
        let fw_e = rr_fw_e(i)
        let fw_i = rr_fw_i(i)
        let fn_l = rr_fn_l(i)
        let fn_ph = rr_fn_ph(i)

        // Lipid composite term (neutral lipid + 30% of phospholipid)
        let lipid_c = fn_l + 0.3 * fn_ph

        // Kpu: TOTAL tissue : UNBOUND (water) plasma -- see the UNITS note.
        // Not "unbound tissue : unbound plasma"; that mislabel is what produced
        // the inverted conversion this module used to carry.
        let kpu = fw_e + fw_i + P * lipid_c

        // Total tissue:total plasma (see the UNITS note above)
        let kp_i = kpu * fu_plasma
        kp[i] = kp_i

        // GUM sensitivity coefficients (analytical)
        let dkp_dlogP = P * ln10 * lipid_c * fu_plasma
        let dkp_dfu   = kpu

        // Combined GUM variance (JCGM 100:2008 Eq 13)
        let var_i = dkp_dlogP * dkp_dlogP * u_logP * u_logP
                  + dkp_dfu   * dkp_dfu   * u_fu   * u_fu
        kp_unc_raw[i] = rr_sqrt(var_i)

        // Log-sensitivity: ∂ln(Kp_i)/∂logP — bounded by ln(10) for logP >> 4
        if kp_i > 1.0e-12 {
            log_sens[i] = dkp_dlogP / kp_i
        }

        i = i + 1
    }

    RRResult {
        kp: kp,
        log_sens: log_sens,
        kp_unc_raw: kp_unc_raw,
        logP: logP,
        fu_plasma: fu_plasma,
    }
}

// Convenience: rapamycin physicochemical inputs
//   logP = 7.0 (Vaidyanathan 2001), u_logP = 1.05 (CV = 15%)
//   fu_plasma = 0.08 (Schreiber 1991), u_fu = 0.02 (CV = 25%)
pub fn rr_rapamycin() -> RRResult with Mut, Div, Panic {
    rr_neutral(7.0, 0.08, 1.05, 0.02)
}

// ============================================================================
// GUM SCALING: Apply R-R sensitivities to literature Kp values
// ============================================================================
// For logP > 4 compounds (rapamycin), absolute R-R Kp overestimates.
// The sensitivity STRUCTURE (relative tissue ordering, ∂ln Kp/∂logP) is
// preserved even outside the validated domain (Poulin 2011).
//
// Scaled GUM uncertainty for each tissue i:
//   u(Kp_i)² = (log_sens_i × u_logP × Kp_lit_i)² + (Kp_lit_i / fu × u_fu)²
//
// Confidence: 0.60 (R-R sensitivity applied to literature Kp — single calibration)

pub fn rr_scaled_uncertainty(
    rr: RRResult,
    kp_lit: [f64; 14],
    u_logP: f64,
    u_fu: f64
) -> RRScaledUnc with Mut, Div, Panic {
    var u_kp: [f64; 14] = [0.0; 14]
    var i = 0
    while i < 14 {
        let ls = rr.log_sens[i]
        let kp_i = kp_lit[i]
        let fu = rr.fu_plasma

        // logP contribution: u(Kp_i) from u_logP
        let term_logP = ls * u_logP * kp_i

        // fu contribution: u(Kp_i) from u_fu — ∂Kp/∂fu = -Kp/fu
        let term_fu = kp_i / fu * u_fu

        u_kp[i] = rr_sqrt(term_logP * term_logP + term_fu * term_fu)
        i = i + 1
    }
    RRScaledUnc { u_kp: u_kp, conf: 0.60 }
}

// ============================================================================
// UNIT-CONVERSION PROPERTY CHECKS (exposed for the CI fixture)
// ============================================================================
// RRResult's fields are private, and Madaros correctly enforces that (E259)
// while lean_single does not, so an out-of-module test cannot read .kp or
// .log_sens. These return the number of tissues (out of 14) satisfying each
// scale-SENSITIVE property, so tests/stdlib/darwin_pbpk/test_rodgers_rowland.sio
// can assert them without widening the struct. The module's own T5-T7 call
// these too, so there is one implementation, not two.

// Kp must INCREASE with fu_plasma: Kp = Kpu*fu_p and Kpu is independent of
// fu_p. Dividing instead of multiplying inverts this.
pub fn rr_check_monotone_fu() -> i32 with Mut, Div, Panic {
    let lo = rr_neutral(2.0, 0.02, 0.1, 0.005)
    let mid = rr_neutral(2.0, 0.20, 0.1, 0.005)
    let hi = rr_neutral(2.0, 1.00, 0.1, 0.005)
    var ok = 0
    var i = 0
    while i < 14 {
        if lo.kp[i] < mid.kp[i] && mid.kp[i] < hi.kp[i] { ok = ok + 1 }
        i = i + 1
    }
    ok
}

// A drug with negligible lipid affinity can at most fill tissue water, so
// Kp = fu_p*(fw_e + fw_i) <= 1. logP = -3 gives P = 1e-3.
pub fn rr_check_hydrophilic_bounded() -> i32 with Mut, Div, Panic {
    let dilute = rr_neutral(0.0 - 3.0, 0.5, 0.1, 0.005)
    var ok = 0
    var i = 0
    while i < 14 {
        if dilute.kp[i] <= 1.0 { ok = ok + 1 }
        i = i + 1
    }
    ok
}

// dln(Kp)/dlogP must not depend on fu_plasma: numerator and denominator carry
// the same factor. This is why rr_scaled_uncertainty is unaffected by the
// conversion correction.
pub fn rr_check_logsens_fu_invariant() -> i32 with Mut, Div, Panic {
    let lo = rr_neutral(2.0, 0.02, 0.1, 0.005)
    let hi = rr_neutral(2.0, 1.00, 0.1, 0.005)
    var ok = 0
    var i = 0
    while i < 14 {
        let d = lo.log_sens[i] - hi.log_sens[i]
        let ad = if d < 0.0 { 0.0 - d } else { d }
        if ad <= 1.0e-12 { ok = ok + 1 }
        i = i + 1
    }
    ok
}

// ============================================================================
// RAPAMYCIN LITERATURE Kp VALUES (matching tsit5_pbpk14 ordering)
// ============================================================================
// Sources: Lampen 1998 (brain), Serkova 2000 (muscle, kidney),
//          Napoli 2001 (liver, lung), Ferron 1997 (adipose capped model)
pub fn rr_rapamycin_kp_literature() -> [f64; 14] with Mut {
    var kp: [f64; 14] = [0.0; 14]
    kp[0]  = 1.0    // blood (by definition, reference compartment)
    kp[1]  = 8.0    // liver   — high hepatic uptake (CYP3A4 site)
    kp[2]  = 4.0    // kidney
    kp[3]  = 0.08   // brain   — P-gp efflux limited
    kp[4]  = 3.5    // heart
    kp[5]  = 10.0   // lung
    kp[6]  = 3.5    // muscle
    kp[7]  = 0.3    // adipose — capped for 48h BBB-focus model
    kp[8]  = 5.0    // gut
    kp[9]  = 2.0    // skin
    kp[10] = 1.5    // bone
    kp[11] = 6.0    // spleen
    kp[12] = 4.0    // pancreas
    kp[13] = 0.5    // other
    kp
}

// ============================================================================
// LEGACY API (preserves compatibility with any existing callers)
// ============================================================================

struct TissueComposition {
    f_water: f64,
    f_ew: f64,
    f_iw: f64,
    f_neutral_lipid: f64,
    f_phospholipid: f64,
    f_acidic_phospholipid: f64,
    f_protein: f64,
    pH_iw: f64,
}

fn tissue_liver() -> TissueComposition {
    TissueComposition { f_water: 0.751, f_ew: 0.161, f_iw: 0.573, f_neutral_lipid: 0.014, f_phospholipid: 0.024, f_acidic_phospholipid: 0.005, f_protein: 0.157, pH_iw: 7.0 }
}

fn tissue_brain() -> TissueComposition {
    TissueComposition { f_water: 0.770, f_ew: 0.092, f_iw: 0.678, f_neutral_lipid: 0.039, f_phospholipid: 0.036, f_acidic_phospholipid: 0.0059, f_protein: 0.048, pH_iw: 7.0 }
}

fn tissue_kidney() -> TissueComposition {
    TissueComposition { f_water: 0.783, f_ew: 0.209, f_iw: 0.483, f_neutral_lipid: 0.012, f_phospholipid: 0.024, f_acidic_phospholipid: 0.005, f_protein: 0.127, pH_iw: 7.0 }
}

struct DrugPropertiesRR {
    logP: f64,
    pKa: f64,
    fu_plasma: f64,
    is_acid: bool,
    blood_plasma_ratio: f64,
}

// ============================================================================
// MAIN — Gate tests
// ============================================================================
// T1: Lipid-driven ordering: Kp_adipose > Kp_liver > Kp_brain (correct for
//     neutral lipophilic drugs regardless of absolute values)
// T2: GUM uncertainties non-zero for all 14 compartments
// T3: Log-sensitivities in valid range (0, ln(10)] for lipid-rich tissues
// T4: Scaled GUM uncertainties non-zero and finite
// T5: Kp monotonically increasing in fu_plasma (discriminates the Kpu->Kp
//     conversion direction; T1-T4 are scale-invariant and cannot)
// T6: a drug with no lipid affinity has Kp <= 1 (absolute-scale check)
// T7: log-sensitivity independent of fu_plasma (justifies the claim that the
//     GUM path is unchanged by the conversion fix)

fn main() -> i32 with IO, Mut, Div, Panic {
    let rr = rr_rapamycin()
    let kp_lit = rr_rapamycin_kp_literature()
    let scaled = rr_scaled_uncertainty(rr, kp_lit, 1.05, 0.02)

    var passed = 0
    var failed = 0

    // T1: Adipose (7) >> liver (1) in absolute R-R Kp (adipose fn_L=0.853 vs liver 0.014)
    //     Brain (3) > liver (1) because brain has higher lipid+phospholipid in R-R table
    //     (myelin-rich tissue; P-gp limitation not in R-R — accounted by literature Kp)
    let kp_adipose = rr.kp[7]
    let kp_liver   = rr.kp[1]
    let kp_brain   = rr.kp[3]
    if kp_adipose > kp_brain && kp_brain > kp_liver {
        println("T1 PASS: R-R ordering adipose > brain > liver (lipid-dominated neutral)")
        passed = passed + 1
    } else {
        println("T1 FAIL: unexpected Kp ordering")
        failed = failed + 1
    }

    // T2: All 14 uncertainties non-zero
    var unc_ok = 0
    var i = 0
    while i < 14 {
        if rr.kp_unc_raw[i] > 0.0 { unc_ok = unc_ok + 1 }
        i = i + 1
    }
    if unc_ok == 14 {
        println("T2 PASS: GUM uncertainties non-zero (14/14 compartments)")
        passed = passed + 1
    } else {
        print("T2 FAIL: only ")
        print_int(unc_ok)
        println("/14 compartments have non-zero GUM uncertainty")
        failed = failed + 1
    }

    // T3: Log-sensitivity of adipose and liver > 0 and ≤ ln(10)
    let ls_adipose = rr.log_sens[7]
    let ls_liver   = rr.log_sens[1]
    let ln10 = 2.302585
    if ls_adipose > 0.0 && ls_adipose <= ln10 + 0.01 && ls_liver > 0.0 {
        println("T3 PASS: log-sensitivities in valid range for lipid-rich tissues")
        passed = passed + 1
    } else {
        println("T3 FAIL: log-sensitivity out of expected range")
        failed = failed + 1
    }

    // T5: Kp must INCREASE with fu. Kp = Kpu*fu_p and Kpu does not depend on
    //     fu_p, so this is monotone by construction; the pre-2026-09-26 body
    //     divided by fu_p and therefore had it backwards. Scale-invariant
    //     checks (T1-T4) all pass under either convention, so this is the test
    //     that discriminates.
    let mono = rr_check_monotone_fu()
    if mono == 14 {
        println("T5 PASS: Kp increases with fu_plasma in all 14 tissues")
        passed = passed + 1
    } else {
        print("T5 FAIL: Kp not monotone in fu_plasma in ")
        print(14 - mono)
        println("/14 tissues (conversion inverted?)")
        failed = failed + 1
    }

    // T6: A drug with negligible lipid affinity can at most fill tissue water,
    //     so Kp = fu_p*(fw_e + fw_i) <= fw_e + fw_i <= 1. At logP = -3,
    //     P = 1e-3 and the lipid term is negligible. With fu_p = 0.5 the old
    //     body returned about twice the water fraction instead of half of it.
    let bounded = rr_check_hydrophilic_bounded()
    if bounded == 14 {
        println("T6 PASS: hydrophilic drug Kp <= 1 in all 14 tissues")
        passed = passed + 1
    } else {
        print("T6 FAIL: ")
        print(14 - bounded)
        println("/14 tissues report Kp > 1 for a drug with no lipid affinity")
        failed = failed + 1
    }

    // T7: the dimensionless log-sensitivity must NOT depend on fu_plasma
    //     (numerator and denominator carry the same factor). This is what
    //     makes rr_scaled_uncertainty -- the only consumer of this module --
    //     numerically unaffected by the T5 correction, so it is asserted
    //     rather than merely claimed in the header.
    let ls_same = rr_check_logsens_fu_invariant()
    if ls_same == 14 {
        println("T7 PASS: log-sensitivity independent of fu_plasma (14/14)")
        passed = passed + 1
    } else {
        print("T7 FAIL: log-sensitivity varies with fu_plasma in ")
        print(14 - ls_same)
        println("/14 tissues")
        failed = failed + 1
    }

    // T4: Scaled GUM uncertainties non-zero for literature Kp
    var scaled_ok = 0
    var j = 0
    while j < 14 {
        if scaled.u_kp[j] > 0.0 { scaled_ok = scaled_ok + 1 }
        j = j + 1
    }
    if scaled_ok == 14 {
        println("T4 PASS: scaled GUM uncertainties non-zero (14/14)")
        passed = passed + 1
    } else {
        print("T4 FAIL: only ")
        print_int(scaled_ok)
        println("/14 scaled uncertainties are non-zero")
        failed = failed + 1
    }

    println("")
    print("R-R summary — rapamycin (logP=7.0, fu=0.08):")
    println("")
    print("  Kp_liver (lit=8.0)  u_Kp=")
    print(scaled.u_kp[1])
    println("")
    print("  Kp_brain (lit=0.08) u_Kp=")
    print(scaled.u_kp[3])
    println("")
    print("  Kp_adipose(lit=0.3) u_Kp=")
    print(scaled.u_kp[7])
    println("")
    print("  [NOTE] R-R raw Kp overestimates logP>4 drugs by design")
    println("")
    print("  log_sens_adipose=")
    print(rr.log_sens[7])
    print("  log_sens_liver=")
    print(rr.log_sens[1])
    print("  log_sens_brain=")
    print(rr.log_sens[3])
    println("")

    if failed == 0 {
        println("PASS")
        return 0
    } else {
        println("FAIL")
        return 1
    }
}
