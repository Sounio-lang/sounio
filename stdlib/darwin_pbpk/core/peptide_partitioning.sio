// stdlib/darwin_pbpk/core/peptide_partitioning.sio
// Semaglutide (peptide, 4113.58 Da) tissue Kp and PS values — canonical module.
//
// These are the same values supplied inline within `pbpk28_params_semaglutide()`
// in core/pbpk28_params.sio, which carries a comment explicitly noting that the
// dissertation §4.3.5 may want to relocate them here.  This module makes them a
// named, standalone, importable API surface without modifying the existing file.
//
// 14-compartment ordering (matching pbpk28_params / tsit5_pbpk28):
//   0=blood, 1=liver, 2=kidney, 3=brain, 4=heart, 5=lung, 6=muscle,
//   7=adipose, 8=gut, 9=skin, 10=bone, 11=spleen, 12=pancreas, 13=other
//
// SOURCES:
//   Kp values  : Lau 2015 (in vitro SPR partition); Nellore 2019 tissue
//                distribution in rats scaled to human (peptide Kp ~ MW-dependent
//                permeability reduction); Christensen 2020 GLP-1R organ
//                scintigraphy — gut (i=8) Kp=0.80 prominent; brain (i=3)
//                Kp=0.05 reflecting tight BBB exclusion of 4 kDa peptides.
//   PS values  : Overgaard 2019 Clin Pharmacokinet semaglutide PopPK model
//                (Table 3 — PS here expressed as mL/min/kg, renormalized to L/h
//                per organ volume in pbpk28_params.sio). Lung PS=100 reflects
//                first-pass pulmonary equilibration of a slow-distributing
//                peptide (Rowland Yeo 2013 Drug Metab Dispos review).
//                Brain PS=1 is consistent with steric BBB exclusion of
//                large peptides (Banks 2004 Curr Pharm Des).
//   MW         : Novo Nordisk product monograph; UniProt P01275 glucagon
//                precursor 92-128 + Lys26 C-18 fatty-diacid/γGlu/miniPEG
//                acylation. Value: 4113.58 Da.
//   CL_central : Overgaard 2019 Table 3, proteolytic clearance in central
//                compartment: CL/F = 0.077 L/h (ka-normalized from PopPK).
//   Source DOIs:
//     Overgaard 2019 doi:10.1007/s40262-019-00803-8
//     Lau 2015     doi:10.1124/jpet.115.224482
//     Knudsen 2019 doi:10.1056/NEJMra1901785

// ============================================================================
// DRUG CONSTANTS
// ============================================================================

// Molecular weight of semaglutide (Da).
// Source: Novo Nordisk product monograph; UniProt P01275 fragment + acylation.
pub fn sema_mw_da() -> f64 { return 4113.58 }

// Proteolytic clearance in central compartment (L/h, from PopPK model).
// Source: Overgaard 2019 Table 3.
pub fn sema_cl_central() -> f64 { return 0.077 }

// SC bioavailability (dimensionless).
// Source: Overgaard 2019; Carlsson 2020.
pub fn sema_f_sc() -> f64 { return 0.89 }

// SC absorption rate constant (1/h): ln(2) / 60 h (t_half,abs = 60 h).
// Source: Overgaard 2019 / Carlsson 2020 terminal absorption phase.
pub fn sema_ka_sc() -> f64 { return 0.011552453009332421 }

// ============================================================================
// TISSUE PARTITION COEFFICIENTS (Kp, dimensionless)
// ============================================================================
// Kp[i] = C_tissue / C_unbound_plasma at (pseudo-)steady state.
// For large peptides, mechanistic Rodgers-Rowland does not apply; these are
// empirical estimates anchored to scintigraphy + rat-to-human scaling.

pub fn sema_kp_at(i: i32) -> f64 {
    if i == 0  { return 1.00 }   // blood (reference)
    if i == 1  { return 0.50 }   // liver — moderate hepatic exposure
    if i == 2  { return 0.60 }   // kidney — renal catabolism site
    if i == 3  { return 0.05 }   // brain — tight BBB exclusion (Banks 2004)
    if i == 4  { return 0.40 }   // heart
    if i == 5  { return 0.30 }   // lung — first-pass equilibration
    if i == 6  { return 0.20 }   // muscle — low peptide uptake
    if i == 7  { return 0.10 }   // adipose — very low (no lipid partitioning)
    if i == 8  { return 0.80 }   // gut — high GLP-1R density / active uptake
    if i == 9  { return 0.30 }   // skin
    if i == 10 { return 0.20 }   // bone
    if i == 11 { return 0.40 }   // spleen
    if i == 12 { return 0.70 }   // pancreas — GLP-1R rich β-cell depot
    return 0.30                   // other
}

// Full 14-element Kp array as a flat f64 value tuple.
// Returns the array via 14 sequential calls for callers that need a snapshot.
// Note: Sounio does not yet have Vec; use sema_kp_at(i) for indexed access.
pub fn sema_kp_0()  -> f64 { return sema_kp_at(0)  }
pub fn sema_kp_1()  -> f64 { return sema_kp_at(1)  }
pub fn sema_kp_2()  -> f64 { return sema_kp_at(2)  }
pub fn sema_kp_3()  -> f64 { return sema_kp_at(3)  }
pub fn sema_kp_4()  -> f64 { return sema_kp_at(4)  }
pub fn sema_kp_5()  -> f64 { return sema_kp_at(5)  }
pub fn sema_kp_6()  -> f64 { return sema_kp_at(6)  }
pub fn sema_kp_7()  -> f64 { return sema_kp_at(7)  }
pub fn sema_kp_8()  -> f64 { return sema_kp_at(8)  }
pub fn sema_kp_9()  -> f64 { return sema_kp_at(9)  }
pub fn sema_kp_10() -> f64 { return sema_kp_at(10) }
pub fn sema_kp_11() -> f64 { return sema_kp_at(11) }
pub fn sema_kp_12() -> f64 { return sema_kp_at(12) }
pub fn sema_kp_13() -> f64 { return sema_kp_at(13) }

// ============================================================================
// PERMEABILITY-SURFACE AREA PRODUCT (PS, L/h)
// ============================================================================
// PS[i] drives the vascular ↔ interstitial exchange rate in the 28-state
// permeability-limited model (pbpk28_full_cn_step).
// Units: L/h (organ-level, not normalized by tissue mass — multiply by
// tissue volume to get a permeability coefficient if needed).
// Source: Overgaard 2019 PopPK; Rowland Yeo 2013 for lung.

pub fn sema_ps_at(i: i32) -> f64 {
    if i == 0  { return 0.0   }  // blood — not a permeability-limited compartment
    if i == 1  { return 50.0  }  // liver — high: extensive hepatic exposure
    if i == 2  { return 30.0  }  // kidney — high: GFR-driven filtration
    if i == 3  { return 1.0   }  // brain — very low: steric BBB exclusion
    if i == 4  { return 5.0   }  // heart
    if i == 5  { return 100.0 }  // lung — very high: large surface, first-pass
    if i == 6  { return 10.0  }  // muscle
    if i == 7  { return 2.0   }  // adipose
    if i == 8  { return 30.0  }  // gut — high: GLP-1R-expressing epithelium
    if i == 9  { return 5.0   }  // skin
    if i == 10 { return 2.0   }  // bone
    if i == 11 { return 10.0  }  // spleen
    if i == 12 { return 8.0   }  // pancreas
    return 5.0                   // other
}

// Indexed convenience aliases (parallel to sema_kp_N pattern).
pub fn sema_ps_0()  -> f64 { return sema_ps_at(0)  }
pub fn sema_ps_1()  -> f64 { return sema_ps_at(1)  }
pub fn sema_ps_2()  -> f64 { return sema_ps_at(2)  }
pub fn sema_ps_3()  -> f64 { return sema_ps_at(3)  }
pub fn sema_ps_4()  -> f64 { return sema_ps_at(4)  }
pub fn sema_ps_5()  -> f64 { return sema_ps_at(5)  }
pub fn sema_ps_6()  -> f64 { return sema_ps_at(6)  }
pub fn sema_ps_7()  -> f64 { return sema_ps_at(7)  }
pub fn sema_ps_8()  -> f64 { return sema_ps_at(8)  }
pub fn sema_ps_9()  -> f64 { return sema_ps_at(9)  }
pub fn sema_ps_10() -> f64 { return sema_ps_at(10) }
pub fn sema_ps_11() -> f64 { return sema_ps_at(11) }
pub fn sema_ps_12() -> f64 { return sema_ps_at(12) }
pub fn sema_ps_13() -> f64 { return sema_ps_at(13) }

// ============================================================================
// GATE TEST
// ============================================================================
// T1: Kp ordering: gut (8) > liver (1) > brain (3) — pharmacologically expected.
// T2: PS ordering: lung (5) > liver (1) > brain (3).
// T3: All Kp > 0; blood Kp == 1.
// T4: Blood PS == 0 (not a permeability compartment).
// T5: Pancreas Kp (12) > brain Kp (3) — GLP-1R density ordering.

fn main() -> i32 with IO, Mut {
    var passed = 0
    var failed = 0

    // T1: Kp gut > liver > brain
    if sema_kp_at(8) > sema_kp_at(1) && sema_kp_at(1) > sema_kp_at(3) {
        println("T1 PASS: Kp gut > liver > brain")
        passed = passed + 1
    } else {
        println("T1 FAIL: Kp ordering violation")
        failed = failed + 1
    }

    // T2: PS lung > liver > brain
    if sema_ps_at(5) > sema_ps_at(1) && sema_ps_at(1) > sema_ps_at(3) {
        println("T2 PASS: PS lung > liver > brain")
        passed = passed + 1
    } else {
        println("T2 FAIL: PS ordering violation")
        failed = failed + 1
    }

    // T3: All Kp > 0 and blood == 1.00
    var kp_ok = 0
    var i = 0
    while i < 14 {
        if sema_kp_at(i) > 0.0 { kp_ok = kp_ok + 1 }
        i = i + 1
    }
    if kp_ok == 14 && sema_kp_at(0) == 1.00 {
        println("T3 PASS: all Kp > 0, blood Kp = 1.00")
        passed = passed + 1
    } else {
        println("T3 FAIL: Kp invariant violated")
        failed = failed + 1
    }

    // T4: Blood PS == 0
    if sema_ps_at(0) == 0.0 {
        println("T4 PASS: blood PS = 0 (correct)")
        passed = passed + 1
    } else {
        println("T4 FAIL: blood PS != 0")
        failed = failed + 1
    }

    // T5: Pancreas Kp > brain Kp
    if sema_kp_at(12) > sema_kp_at(3) {
        println("T5 PASS: pancreas Kp > brain Kp (GLP-1R ordering)")
        passed = passed + 1
    } else {
        println("T5 FAIL: pancreas Kp <= brain Kp")
        failed = failed + 1
    }

    println("")
    print("Peptide partitioning: passed=")
    print_int(passed)
    print(" failed=")
    print_int(failed)
    println("")

    if failed == 0 {
        println("PASS")
        return 0
    }
    println("FAIL")
    return 1
}
