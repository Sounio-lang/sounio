//@ run-pass
//@ expect-stdout: PASS

// stdlib/darwin_pbpk/core/tissue_composition.sio
// ----------------------------------------------------------------------------
// PBPK28 core module: mechanistic tissue composition table (plain f64).
//
// Fractional tissue volumes for the 14-organ PBPK kernel — extracellular water
// (f_ew), intracellular water (f_iw), neutral lipid (f_nl), neutral
// phospholipid (f_np) and residual protein/solids (f_protein) — the mechanistic
// inputs to Rodgers-Rowland (2006) Kp prediction in core/rodgers_rowland.sio.
// Centralises the table that was previously scattered across the per-fraction
// accessors (rr_fw_e / rr_fw_i / rr_fn_l / rr_fn_ph) in rodgers_rowland.sio.
//
// Per dissertation convention (and Madaros stdlib compatibility) this stdlib
// module stays PLAIN f64: composition values and their literature evidence ε
// are carried as f64.  The epistemic wrapping — priors as Knowledge<f64, ε>
// flowing into the compile-time EpistemicComplete confidence gate (dissertation
// Contribution 2) — is demonstrated in the lean_single witness
// tests/run-pass/pbpk28_tissue_composition_confidence.sio, mirroring how
// dissertation_pbpk28_confidence_gate.sio wraps the epistemic_pbpk28 priors.
//
// 14-organ ordering (matching core/rodgers_rowland.sio + tsit5_pbpk14.sio):
//   0=blood, 1=liver, 2=kidney, 3=brain, 4=heart, 5=lung, 6=muscle,
//   7=adipose, 8=gut, 9=skin, 10=bone, 11=spleen, 12=pancreas, 13=other
//
// EVIDENCE ε per fraction class (literature evidence-quality, dimensionless,
// NOT a probability):
//   water (f_ew, f_iw)   ε=0.85  ICRP 89 reference man — directly measured
//   neutral lipid (f_nl) ε=0.70  Poulin & Theil 2002 — gravimetric extraction
//   phospholipid (f_np)  ε=0.55  Rodgers & Rowland 2006 — most variable
//   intracellular pH     ε=0.40  mixed provenance, partly excised tissue ← weakest
//                                (added 2026-10-31; see tc_eps_ph for why)
//   protein/solids       ε=0.65  by difference (1 − water − lipid)
//
// References: Rodgers T & Rowland M (2006) J Pharm Sci 95:1743-1764;
//             Poulin P & Theil F-P (2002) J Pharm Sci 91:129-156;
//             ICRP Publication 89 (2002) reference man; Brown 1997 (volumes).
//
// Author: Demetrios Chiuratto Agourakis

// ============================================================================
// Tissue composition record (fractional tissue volumes, dimensionless)
// ============================================================================

struct TissueComp {
    f_ew:      f64,   // extracellular water
    f_iw:      f64,   // intracellular water
    f_nl:      f64,   // neutral lipid
    f_np:      f64,   // neutral phospholipid
    f_protein: f64,   // residual protein + solids (by difference)
    ph_iw:     f64    // intracellular pH
}

// Rodgers-Rowland (2006) / Poulin-Theil (2002) reference composition.
// Blood (organ 0) is plasma-water dominated; C_t[0] is unused in the kernel but
// the plasma composition is provided for completeness.
pub fn tc_comp(organ: i32) -> TissueComp {
    if organ == 0  { return TissueComp { f_ew: 0.945, f_iw: 0.000, f_nl: 0.0023, f_np: 0.0013, f_protein: 0.0514, ph_iw: 7.40 } } // blood/plasma
    if organ == 1  { return TissueComp { f_ew: 0.161, f_iw: 0.573, f_nl: 0.0348, f_np: 0.0252, f_protein: 0.2060, ph_iw: 7.00 } } // liver
    if organ == 2  { return TissueComp { f_ew: 0.273, f_iw: 0.483, f_nl: 0.0207, f_np: 0.0162, f_protein: 0.2071, ph_iw: 7.00 } } // kidney
    if organ == 3  { return TissueComp { f_ew: 0.162, f_iw: 0.620, f_nl: 0.0390, f_np: 0.0150, f_protein: 0.1640, ph_iw: 7.00 } } // brain
    if organ == 4  { return TissueComp { f_ew: 0.320, f_iw: 0.456, f_nl: 0.0115, f_np: 0.0166, f_protein: 0.1959, ph_iw: 7.00 } } // heart
    if organ == 5  { return TissueComp { f_ew: 0.336, f_iw: 0.446, f_nl: 0.0030, f_np: 0.0090, f_protein: 0.2060, ph_iw: 6.60 } } // lung
    if organ == 6  { return TissueComp { f_ew: 0.118, f_iw: 0.630, f_nl: 0.0238, f_np: 0.0072, f_protein: 0.2210, ph_iw: 6.97 } } // muscle
    if organ == 7  { return TissueComp { f_ew: 0.135, f_iw: 0.017, f_nl: 0.7900, f_np: 0.0020, f_protein: 0.0560, ph_iw: 7.00 } } // adipose
    if organ == 8  { return TissueComp { f_ew: 0.282, f_iw: 0.475, f_nl: 0.0487, f_np: 0.0163, f_protein: 0.1780, ph_iw: 7.00 } } // gut
    if organ == 9  { return TissueComp { f_ew: 0.382, f_iw: 0.291, f_nl: 0.0284, f_np: 0.0111, f_protein: 0.2875, ph_iw: 7.00 } } // skin
    if organ == 10 { return TissueComp { f_ew: 0.100, f_iw: 0.346, f_nl: 0.0170, f_np: 0.0017, f_protein: 0.5353, ph_iw: 7.00 } } // bone
    if organ == 11 { return TissueComp { f_ew: 0.207, f_iw: 0.579, f_nl: 0.0201, f_np: 0.0198, f_protein: 0.1741, ph_iw: 7.00 } } // spleen
    if organ == 12 { return TissueComp { f_ew: 0.120, f_iw: 0.664, f_nl: 0.0410, f_np: 0.0170, f_protein: 0.1580, ph_iw: 7.00 } } // pancreas
    return TissueComp { f_ew: 0.200, f_iw: 0.500, f_nl: 0.0300, f_np: 0.0150, f_protein: 0.2550, ph_iw: 7.00 }                    // other (13)
}

// Convenience derived quantities.
pub fn tc_water(organ: i32) -> f64 {
    let c = tc_comp(organ)
    c.f_ew + c.f_iw
}
pub fn tc_lipid(organ: i32) -> f64 {
    let c = tc_comp(organ)
    c.f_nl + c.f_np
}

// Mechanistic lipid-composite term for the Rodgers-Rowland neutral-partition
// model (neutral lipid + 0.3 · phospholipid). Plain f64; the epistemic-gated
// counterpart lives in the tests/ witness.
pub fn tc_lipid_composite(organ: i32) -> f64 {
    let c = tc_comp(organ)
    c.f_nl + 0.3 * c.f_np
}

// ============================================================================
// Evidence ε per fraction class (literature evidence-quality, dimensionless f64)
// ============================================================================

pub fn tc_eps_water() -> f64    { return 0.85 }   // ICRP 89 reference man
pub fn tc_eps_lipid() -> f64    { return 0.70 }   // Poulin & Theil 2002
pub fn tc_eps_phospho() -> f64  { return 0.55 }   // Rodgers & Rowland 2006 (weakest)
pub fn tc_eps_protein() -> f64  { return 0.65 }   // by difference

// Honest confidence ceiling (per-million convention) for a claim that uses the
// phospholipid term: the weakest input ε. Downstream epistemic wrappers gate at
// most at this level.
pub fn tc_lipid_composite_ceiling() -> f64 { return 0.55 }

// ============================================================================
// EVIDENCE ε FOR INTRACELLULAR pH  (the term that was outside the budget)
// ============================================================================
// Added 2026-10-31.  The ε set above covers water, lipid, phospholipid and
// protein but NOT ph_iw -- and for a strong base the intracellular pH is the
// DOMINANT input, not a secondary one.  Two independent measurements:
//
//   Peyret 2010 Tab. 10 sensitivity ratios, for phencyclidine (a strong base):
//     cell pH in muscle  SR = -34.2        <- the largest of any input
//     pKa in adipose     SR = -31.46
//     plasma/interstitial pH  SR = +5.68
//   Local reproduction at muscle, haloperidol, d(ln Kpu)/d(pH):
//     Rodgers-Rowland -0.95      Schmitt -2.14
//
// So the model's most influential composition input carried no evidence weight
// at all, while phospholipid (SR well below 1) carried ε = 0.55.
//
// WHY ε = 0.40, below phospholipid, making pH the weakest class:
//   (a) PROVENANCE IS UNDOCUMENTED FOR MOST ORGANS.  Twelve of the fourteen
//       organs carry 7.00, and lung (6.60) and muscle (6.97) carry no source
//       in this module either.  The round figures are plausibly imputed, but
//       that is an inference, not a checked fact.
//   (b) ALTERNATIVE LITERATURE VALUES DIFFER, BUT ARE NOT COMPARABLE AS-IS.
//       The three values below differ in species, preparation and method
//       from each other and, as far as is known here, from the table.
// ε is an evidence-quality weight, dimensionless, NOT a probability and NOT a
// standard uncertainty: converting it into one would need a stated model.
// 0.40 is a judgement on provenance quality and is recorded as a judgement.
pub fn tc_eps_ph() -> f64 { return 0.40 }

// ============================================================================
// ALTERNATIVE LITERATURE pH VALUES  (NOT a replacement; NOT used by the kernel)
// ============================================================================
// Corrected 2026-11-02.  The first version of this section was titled
// "modern in vivo intracellular pH", reported a signed "bias" of the table
// against it, and asserted that the bias was localised and ischaemic in
// origin.  None of that was established:
//   - the lung value comes from ISOLATED, PERFUSED rat lung, which is not in
//     vivo at all, and the kidney value is rat, not human;
//   - "in vivo" and "human" are not the same property and were conflated;
//   - three further organs (liver, brain, heart) were listed as verified
//     against the primary record when no primary citation had been recorded
//     for them -- they came from a literature sweep and are REMOVED here;
//   - a difference between two values does not show that the table is wrong,
//     that ischaemia caused it, or that substituting the other value improves
//     the model.
// What remains is a set of alternative values, each tagged with its species,
// preparation and in-vivo status AS DATA, so that a consumer has to look at
// comparability before using one.  Whether the table itself is human- or
// rat-derived has not been checked here; if it is rat-derived, rat-to-rat
// comparison is the relevant test, not human-versus-rat.
//
// Sources, each read in the primary record:
//   muscle  7.08  Jeneson 2004, FASEB J, doi 10.1096/fj.03-0762fje
//                 HUMAN, in vivo, resting 31P-NMRS
//   lung    7.16  Hayashi et al. 1993, J Appl Physiol 74(4):1549-54,
//                 PMID 8514668, doi 10.1152/jappl.1993.74.4.1549
//                 RAT, ISOLATED PERFUSED lung, inflated (degassed 6.99 +- 0.10).
//                 The same paper measures -0.2 pH units after 30 min of
//                 ischaemia in that preparation; whether that mechanism
//                 explains any table value is NOT established.
//   kidney  7.39  Adam, Koretsky & Weiner 1986, Am J Physiol 251:F904-10,
//                 PMID 3777186, doi 10.1152/ajprenal.1986.251.5.F904
//                 RAT, in vivo 31P-NMR, 7.39 +- 0.04 (n = 8)
pub fn tc_ph_alt(organ: i32) -> f64 {
    if organ == 2  { return 7.39 }   // kidney  (rat, in vivo)
    if organ == 5  { return 7.16 }   // lung    (rat, isolated perfused)
    if organ == 6  { return 7.08 }   // muscle  (human, in vivo)
    return 0.0                        // no sourced alternative
}

pub fn tc_ph_alt_sourced(organ: i32) -> bool {
    if organ == 2 { return true }
    if organ == 5 { return true }
    if organ == 6 { return true }
    return false
}

// Species of the alternative value: true = human, false = non-human.
pub fn tc_ph_alt_human(organ: i32) -> bool {
    if organ == 6 { return true }
    return false
}

// Whether the alternative value was measured in vivo.  Isolated perfused
// organs are NOT in vivo.
pub fn tc_ph_alt_in_vivo(organ: i32) -> bool {
    if organ == 2 { return true }
    if organ == 6 { return true }
    return false
}

// Signed DIFFERENCE, alternative minus table.  Deliberately not called a bias:
// a difference between sources of different species and preparation is a
// prompt for a comparability check, not evidence that the table is wrong.
// Returns 0.0 where no alternative is sourced; callers must gate on
// tc_ph_alt_sourced rather than read 0.0 as agreement.
//   kidney +0.39 (rat, in vivo) | lung +0.56 (rat, isolated perfused)
//   muscle +0.11 (human, in vivo)
pub fn tc_ph_alt_diff(organ: i32) -> f64 {
    if !tc_ph_alt_sourced(organ) { return 0.0 }
    return tc_ph_alt(organ) - tc_comp(organ).ph_iw
}

// ============================================================================
// ACIDIC PHOSPHOLIPID [AP-]  (Rodgers-Rowland parameterisation, mg/g tissue)
// ============================================================================
// Required by Rodgers & Rowland 2007 Eqs. 1 and 3 for a STRONG base, where the
// cation-acidic-phospholipid term dominates.  The composition record above
// cannot express it: f_np is NEUTRAL phospholipid and the R-R equations consume
// an acidic-phospholipid CONCENTRATION in mg/g, not a volume fraction.
//
// Only three values are available from a verified primary reading of
// Rodgers & Rowland 2007 Table VII (human):
//     muscle 2.42 | plasma 0.041 | red blood cells 0.57 mg/g
// The remaining organs are in Rodgers & Rowland 2006 Table 1, which has NOT
// been read from the primary source here.  They are therefore NOT imputed:
// tc_ap_rr_sourced returns false and tc_ap_rr returns a negative sentinel, so
// a 14-organ Rodgers-Rowland run fails closed on the organs it cannot support
// instead of silently using a guess.  That is the blocker to name when
// extending core/kp_methods.sio beyond muscle.
//
// Note the structural consequence already witnessed in kp_methods.sio: a
// UNIFORM error in [AP-] cancels exactly in Rodgers-Rowland, because Ka is
// back-calculated from blood cells with the same table -- Ka carries 1/AP_rbc
// while the tissue term carries Ka*AP_tissue, so only the tissue/blood ratio
// ever enters.  So what the missing organs need is not an accurate absolute
// [AP-] but an accurate RATIO to the blood-cell value.
pub fn tc_ap_rr(organ: i32) -> f64 {
    if organ == 0 { return 0.041 }   // plasma
    if organ == 6 { return 2.42 }    // muscle
    return 0.0 - 1.0                 // unsourced sentinel
}

// Blood cells are not one of the fourteen organs but the R-R calibration needs
// them, so they get their own accessor.
pub fn tc_ap_rr_blood_cells() -> f64 { return 0.57 }

pub fn tc_ap_rr_sourced(organ: i32) -> bool {
    if organ == 0 { return true }
    if organ == 6 { return true }
    return false
}

// ε for [AP-]: same class as phospholipid in Rodgers & Rowland 2006, and no
// better, so it inherits 0.55 rather than being given a flattering weight.
pub fn tc_eps_ap() -> f64 { return 0.55 }

// ============================================================================
// [AP-] RATIOS FROM httk  (added 2026-11-04)  -- A SECOND, DISTINCT SOURCE
// ============================================================================
// The blocker named above -- "Rodgers & Rowland 2006 Table 1 has not been
// read, so 12 of 14 organs have no sourced [AP-]" -- is lifted WITHOUT that
// table, because what the Rodgers-Rowland route needs is the tissue /
// blood-cell RATIO (see the note on tc_ap_rr), and httk 2.7.4 carries enough
// to compute it: data/Tables.RData, tissue.data, variables Fa_PLc (acidic
// phospholipid as a fraction of LIPID) and FLc (lipid as a fraction of CELL
// volume), Species == "Human".  The absolute per-organ quantity is
// Fa_PLc * FLc, and the ratio is that over the red-blood-cell value
// 0.1 * 0.00501 = 0.000501.
//
// THIS IS NOT RODGERS & ROWLAND, AND THE TWO DISAGREE.  On muscle, the one
// organ where both sources exist:
//   R-R 2007 Tab. VII   2.42 / 0.57          = 4.245614
//   httk Fa_PLc * FLc   0.00188191 / 0.000501 = 3.756309
//   discrepancy                               = -11.52%
// Measured 2026-11-04 (scratchpad/audit1/ap1.cpp), that ratio change moves
// muscle Kpu by -7.96% (haloperidol), -6.46% (venlafaxine) and -9.49%
// (clozapine).  It is a CHOICE OF SOURCE, not an uncertainty: both tables are
// in production use for the same physical quantity.  This is the same pattern
// as the cellular-pH conventions, in a second input.
//
// So these values are kept in their own accessor, named for their source, and
// tc_ap_rr is left untouched: the R-R muscle pair is what the oracle-validated
// parity figures correspond to, and mixing the two silently is exactly the
// failure this module exists to refuse.  A caller extending Rodgers-Rowland
// past muscle MUST declare which source it used.
//
// Coverage: 11 of 14 organs.  httk has no pancreas and no plasma acidic
// phospholipid, and its "rest" compartment is a lumped remainder rather than
// the 14-organ "other", so those three return the unsourced sentinel rather
// than a number carried over from a tissue that happens to be nearby.
pub fn tc_ap_ratio_httk(organ: i32) -> f64 {
    if organ == 1  { return 9.306543 }    // liver    Fa_PLc 0.05051   * FLc 0.09231
    if organ == 2  { return 8.763906 }    // kidney   Fa_PLc 0.06853   * FLc 0.06407
    if organ == 3  { return 37.612655 }   // brain    Fa_PLc 0.1678    * FLc 0.1123
    if organ == 4  { return 8.480539 }    // heart    Fa_PLc 0.0309    * FLc 0.1375
    if organ == 5  { return 3.677445 }    // lung     Fa_PLc 0.14      * FLc 0.01316
    if organ == 6  { return 3.756309 }    // muscle   Fa_PLc 0.07884   * FLc 0.02387
    if organ == 7  { return 14.651309 }   // adipose  Fa_PLc 0.007859  * FLc 0.934
    if organ == 8  { return 6.986028 }    // gut      Fa_PLc 0.05      * FLc 0.07
    if organ == 9  { return 78.092655 }   // skin     Fa_PLc 0.1382    * FLc 0.2831
    if organ == 10 { return 1.596806 }    // bone     Fa_PLc 0.04      * FLc 0.02
    if organ == 11 { return 5.739422 }    // spleen   Fa_PLc 0.07287   * FLc 0.03946
    return 0.0 - 1.0                      // 0 plasma, 12 pancreas, 13 other: absent from httk
}

pub fn tc_ap_ratio_httk_sourced(organ: i32) -> bool {
    if organ <= 0  { return false }
    if organ >= 12 { return false }
    return true
}

// The Rodgers-Rowland ratio, for the two organs where tc_ap_rr is sourced.
// Returns the unsourced sentinel elsewhere, so the two accessors can be
// compared only where both are real.
pub fn tc_ap_ratio_rr(organ: i32) -> f64 with Div {
    if !tc_ap_rr_sourced(organ) { return 0.0 - 1.0 }
    if organ == 0 { return 0.0 - 1.0 }   // plasma is not a cell; no cell ratio
    return tc_ap_rr(organ) / tc_ap_rr_blood_cells()
}

// Signed relative discrepancy (httk - R-R) / R-R where both sources exist.
// Muscle is the only such organ today and measures -0.115199...; pinned by
// test so that nobody can swap the sources without the number moving.
pub fn tc_ap_ratio_discrepancy(organ: i32) -> f64 with Div {
    let a = tc_ap_ratio_rr(organ)
    if a < 0.0 { return 0.0 }
    if !tc_ap_ratio_httk_sourced(organ) { return 0.0 }
    return (tc_ap_ratio_httk(organ) - a) / a
}

// httk 2.7.4 cellular pH is ONE table applied to two species.  Measured
// 2026-11-04 from data/Tables.RData, tissue.data: only Human and Rat carry a
// pH row at all, and 0 of 14 tissues differ between them (lung 6.60, muscle
// 6.81, kidney 7.22, liver 7.23, adipose/brain/heart 7.10, the rest 7.00).
// This closes the species-comparability question (SIO-564) and REVERSES the
// earlier framing of it: the defect is not that a rat value was presented as
// human, it is that cellular pH is treated as a species-independent constant.
// A rat-derived alternative value compared against the httk "human" value is
// therefore a rat-vs-rat comparison.
pub fn tc_ph_httk_species_independent() -> bool { return true }
pub fn tc_ph_httk_species_checked() -> i32 { return 14 }
pub fn tc_ph_httk_species_differing() -> i32 { return 0 }


// ============================================================================
// THREE-SOURCE DISAGREEMENT ON ONE TISSUE  (measured 2026-11-08)
// ============================================================================
// Muscle is the only tissue for which this repository holds all three
// production composition tables, so it is the only place the question "do
// independent tables agree on the same physical quantity?" can be asked
// without importing a fourth source.  Measured in
// scratchpad/audit1/three1.cpp:
//
//   quantity (fraction of TISSUE)   R&R Tab.VII   httk/Schmitt   P&T/Peyret
//   intracellular water                0.66600       0.67924            --
//   neutral lipid                      0.02200       0.01094       0.02200
//   phospholipid                       0.00780       0.00934       0.00780
//   total lipid                        0.02980       0.02029            --
//   cellular fraction                       --       0.85000       0.87700
//   interstitial fraction                   --       0.15000       0.12300
//   [AP-] tissue/blood-cell ratio      4.24561       3.75631    no such term
//
// Pairwise, R&R -> httk unless marked: water +1.99%, neutral lipid -50.25%
// (identical from P&T, which agrees with R&R at 0.02200), phospholipid
// +19.80%, total lipid -31.91%, [AP-] ratio -11.52%; P&T -> httk cellular
// fraction -3.08% and interstitial fraction +21.95%.
//
// CAVEAT, stated because it bounds the claim: part of the neutral-lipid gap
// may be DEFINITIONAL rather than measurement error -- extraction protocols
// differ on what counts as neutral lipid.  The total-lipid comparison is less
// definition-sensitive, and it disagrees by -31.91%, so the finding survives
// the caveat; it is not an artefact of where the neutral/phospholipid line is
// drawn.
pub fn tc_three_water_rr() -> f64      { return 0.66600 }
pub fn tc_three_water_httk() -> f64    { return 0.67924 }
pub fn tc_three_nl_rr() -> f64         { return 0.02200 }
pub fn tc_three_nl_httk() -> f64       { return 0.01094 }
pub fn tc_three_nl_pt() -> f64         { return 0.02200 }
pub fn tc_three_np_rr() -> f64         { return 0.00780 }
pub fn tc_three_np_httk() -> f64       { return 0.00934 }
pub fn tc_three_lip_rr() -> f64        { return 0.02980 }
pub fn tc_three_lip_httk() -> f64      { return 0.02029 }
pub fn tc_three_cellfrac_httk() -> f64 { return 0.85000 }
pub fn tc_three_cellfrac_pt() -> f64   { return 0.87700 }

// Absolute relative disagreement per evidence class, as a fraction.
pub fn tc_disagreement(cls: i32) -> f64 with Div {
    if cls == 0 { return 0.0199 }   // water,        eps 0.85
    if cls == 1 { return 0.5025 }   // neutral lipid, eps 0.70
    if cls == 2 { return 0.3191 }   // total lipid,   eps 0.70
    if cls == 3 { return 0.1980 }   // phospholipid,  eps 0.55
    return 0.0 - 1.0
}

pub fn tc_disagreement_eps(cls: i32) -> f64 {
    if cls == 0 { return tc_eps_water() }
    if cls == 1 { return tc_eps_lipid() }
    if cls == 2 { return tc_eps_lipid() }
    if cls == 3 { return tc_eps_phospho() }
    return 0.0 - 1.0
}

// THE EPSILON ORDERING AS A FALSIFIABLE PREDICTION, AND ITS PARTIAL FAILURE.
// The prediction written into this module's header is that a higher evidence
// weight means better agreement between independent tables.  Measured
// (scratchpad/audit1/eps1.cpp): 3 of 5 comparable pairs are ordered as
// predicted, and 2 are violated.  Both violations are the same fact --
// lipid (eps 0.70) disagrees MORE than phospholipid (eps 0.55), by 31.91% or
// 50.25% against 19.80%.
//
// So the hierarchy is confirmed at the top and wrong in the middle: water, the
// highest-eps class, is the ONLY one on which the tables agree inside 5%, but
// the eps given to neutral lipid is too generous.  Phospholipid was marked
// "most variable" and is in fact the better-behaved of the two.  The violation
// is pinned by test rather than smoothed, so that nobody re-weights eps to
// make a test pass without confronting this measurement.
pub fn tc_eps_pairs_total() -> i32     { return 5 }
pub fn tc_eps_pairs_ordered() -> i32   { return 3 }
pub fn tc_eps_pairs_violated() -> i32  { return 2 }
pub fn tc_eps_ordering_holds() -> bool { return false }


// ============================================================================
// PEYRET 2010 READ DIRECTLY  (2026-11-08) -- AND A CORRECTION TO THIS MODULE
// ============================================================================
// Peyret, Poulin & Krishnan 2010 (10.1016/j.taap.2010.09.010) was read in
// full.  Two things in it change what this module says.
//
// 1. THE BLOCKER WAS MIS-SPECIFIED.  "Peyret Tab. 2 per organ" was recorded
//    as what stood between Poulin-Theil and a ten-organ run.  Tab. 2 has
//    THREE tissues and they are RAT -- "The fractional content of interstitial
//    and intracellular spaces in rat tissues (Kawai et al., 1994)":
//        adipose 0.864 / 0.136    liver 0.816 / 0.184    muscle 0.877 / 0.123
//    Tab. 3, the matching composition table, covers the same three tissues and
//    is likewise rat.  The table never held the organs that were being waited
//    for, so Poulin-Theil can reach three organs, not ten, and the real next
//    hop is Kawai et al. 1994.
//
// 2. A SOURCE LABEL IN THIS MODULE WAS WRONG, AND IS CORRECTED HERE.  The
//    three-source comparison above attributed the muscle neutral-lipid value
//    0.02200 to "P&T/Peyret".  Peyret's own Tab. 3 gives muscle TISSUE CELLS
//    neutral lipid 0.0099 (fraction of matrix volume), water 0.636, neutral
//    phospholipid 0.0094, acidic phospholipid 0.0017.  Measured in
//    scratchpad/audit1/peyret2.cpp, against the constant this repository's
//    Poulin-Theil member actually uses:
//        reading as tissue-level (Peyret x 0.877): neutral lipid -60.5%,
//            water -16.3%, neutral phospholipid +5.7%
//        reading as cell-level (Peyret as printed): neutral lipid -55.0%,
//            water -4.5%, neutral phospholipid +20.5%
//    The neutral-lipid gap is a factor of 2.2 to 2.5 in BOTH readings, so it
//    is not an artefact of the matrix/tissue ambiguity.  The 0.02200 belongs
//    to the Poulin & Theil 2002 lineage, which is also where Rodgers & Rowland
//    Tab. VII sits -- not to Peyret 2010.
//
//    CONSEQUENCE FOR THE EARLIER FINDING.  The two-lineage picture was too
//    tidy.  On muscle neutral lipid as a fraction of tissue the four sources
//    line up as: R&R Tab. VII 0.02200 and P&T 2002 0.02200 on one side;
//    httk 0.01094 and Peyret Tab. 3 ~0.00868 on the other.  Peyret sides with
//    httk, against the lineage its own algorithm is usually filed under.
//    Three sources against one is a different claim from one against one, and
//    it is the accurate one.
pub fn tc_peyret_cell_frac(organ: i32) -> f64 {
    if organ == 1 { return 0.816 }   // liver    (rat, Kawai et al. 1994)
    if organ == 6 { return 0.877 }   // muscle   (rat)
    if organ == 7 { return 0.864 }   // adipose  (rat)
    return 0.0 - 1.0                 // Peyret Tab. 2 has no other tissue
}
pub fn tc_peyret_covered(organ: i32) -> bool {
    if organ == 1 { return true }
    if organ == 6 { return true }
    if organ == 7 { return true }
    return false
}
pub fn tc_peyret_tissue_count() -> i32 { return 3 }
pub fn tc_peyret_is_rat() -> bool { return true }

// Peyret Tab. 3, muscle tissue cells, fraction of MATRIX volume.
pub fn tc_peyret_nl_muscle_cell() -> f64  { return 0.0099 }
pub fn tc_peyret_npl_muscle_cell() -> f64 { return 0.0094 }
pub fn tc_peyret_apl_muscle_cell() -> f64 { return 0.0017 }
pub fn tc_peyret_w_muscle_cell() -> f64   { return 0.636 }

// Muscle neutral lipid as a fraction of TISSUE, per source.  The function
// that made the earlier label wrong, now carrying four values instead of
// three so the lineage claim can be checked rather than asserted.
pub fn tc_nl_muscle_by_source(src: i32) -> f64 with Div {
    if src == 0 { return 0.02200 }                                        // R&R Tab. VII
    if src == 1 { return 0.02200 }                                        // P&T 2002 (what the PT member uses)
    if src == 2 { return 0.01094 }                                        // httk / Schmitt
    if src == 3 { return tc_peyret_nl_muscle_cell() * 0.877 }             // Peyret Tab. 3
    return 0.0 - 1.0
}

// Peyret 2010 Tab. 3, in full, as printed (fraction of MATRIX volume, rat).
// Kept whole rather than folded into the Poulin-Theil member, because the
// member in kp_methods.sio is a HYBRID and this is what shows it.  Audited
// constant by constant in scratchpad/audit1/peyret3.cpp against
// kpm_pt_kpu_full:
//   EXACT (5): cellular split 0.877, interstitial split 0.123, interstitial
//              water 0.89, interstitial albumin 0.015, plasma albumin 0.029
//   LIPID  (4): cell neutral lipid -55.0%, cell neutral phospholipid +20.5%,
//              plasma neutral lipid -57.1%, plasma neutral phospholipid -64.4%
//   OTHER  (1): cell water -4.5%
// So every structure and protein constant is Peyret's and every lipid
// constant is not: the member takes its skeleton from Peyret 2010 and its
// lipids from the Poulin & Theil 2002 lineage.  That is the same fault line
// the four-source comparison found, now located inside one function.
struct PeyretComp {
    cell:   f64,
    intf:   f64,
    c_nl:   f64,
    c_npl:  f64,
    c_apl:  f64,
    c_w:    f64,
    c_pr:   f64,
    i_w:    f64,
    i_alb:  f64
}

pub fn tc_peyret_comp(organ: i32) -> PeyretComp {
    if organ == 1 { return PeyretComp { cell: 0.816, intf: 0.184, c_nl: 0.0427, c_npl: 0.0253,
                                        c_apl: 0.0056, c_w: 0.527, c_pr: 0.192, i_w: 0.89, i_alb: 0.014 } }
    if organ == 6 { return PeyretComp { cell: 0.877, intf: 0.123, c_nl: 0.0099, c_npl: 0.0094,
                                        c_apl: 0.0017, c_w: 0.636, c_pr: 0.178, i_w: 0.89, i_alb: 0.015 } }
    if organ == 7 { return PeyretComp { cell: 0.864, intf: 0.136, c_nl: 0.954,  c_npl: 0.002,
                                        c_apl: 0.0005, c_w: 0.035, c_pr: 0.008, i_w: 0.89, i_alb: 0.010 } }
    return PeyretComp { cell: 0.0, intf: 0.0, c_nl: 0.0, c_npl: 0.0, c_apl: 0.0,
                        c_w: 0.0, c_pr: 0.0, i_w: 0.0, i_alb: 0.0 }
}

// Peyret Tab. 3 plasma row, needed to back-calculate the protein term.
pub fn tc_peyret_plasma_nl() -> f64  { return 0.0015 }
pub fn tc_peyret_plasma_npl() -> f64 { return 0.0008 }
pub fn tc_peyret_plasma_w() -> f64   { return 0.96 }
pub fn tc_peyret_plasma_alb() -> f64 { return 0.029 }

// How many of the ten audited constants match Peyret exactly, and how many of
// the mismatches are lipid.  Pinned by test.
pub fn tc_pt_const_exact() -> i32          { return 5 }
pub fn tc_pt_const_lipid_mismatch() -> i32 { return 4 }
pub fn tc_pt_const_other_mismatch() -> i32 { return 1 }
pub fn tc_pt_is_hybrid() -> bool           { return true }

// Field accessors for PeyretComp.  Struct fields are private across modules
// (error[E259]), and kp_methods.sio needs these to build a Poulin-Theil
// member on Peyret's own numbers rather than on the hybrid's.
pub fn tc_pey_cell(organ: i32) -> f64 { return tc_peyret_comp(organ).cell }
pub fn tc_pey_intf(organ: i32) -> f64 { return tc_peyret_comp(organ).intf }
pub fn tc_pey_cnl(organ: i32)  -> f64 { return tc_peyret_comp(organ).c_nl }
pub fn tc_pey_cnpl(organ: i32) -> f64 { return tc_peyret_comp(organ).c_npl }
pub fn tc_pey_cw(organ: i32)   -> f64 { return tc_peyret_comp(organ).c_w }
pub fn tc_pey_iw(organ: i32)   -> f64 { return tc_peyret_comp(organ).i_w }
pub fn tc_pey_ialb(organ: i32) -> f64 { return tc_peyret_comp(organ).i_alb }

// Poulin-Theil on Peyret's numbers can cover liver and muscle only.  Adipose
// is REFUSED, and not for want of composition -- Peyret Tab. 2 and Tab. 3
// both carry it.  The Poulin-Theil form uses a VEGETABLE OIL:water partition
// coefficient for adipose instead of n-octanol:water, and no sourced
// correlation for it exists anywhere in this repository (kp_methods.sio
// mentions one in a comment and does not implement it).  Supplying that
// correlation from memory is the one thing this module exists to refuse, so
// adipose stays out until the correlation is read from its source.
pub fn tc_pey_pt_supported(organ: i32) -> bool {
    if organ == 1 { return true }    // liver
    if organ == 6 { return true }    // muscle
    return false                      // adipose (7) needs vegetable oil:water
}
pub fn tc_pey_pt_count() -> i32 { return 2 }
// ============================================================================
// A ROUTE THAT LOOKS OPEN AND IS NOT  (falsified 2026-11-08)
// ============================================================================
// Poulin-Theil needs a per-organ CELLULAR / INTERSTITIAL VOLUME split (Peyret
// 2010 Tab. 2).  That paper is closed (10.1016/j.taap.2010.09.010) and the
// table is not in hand.  This module already carries f_ew and f_iw for all 14
// organs, so the obvious substitute is the water split, f_iw / (f_iw + f_ew).
// On muscle it looks convincing: 0.8422 against httk's Fcell 0.850 and
// Peyret's 0.877.
//
// IT IS A CATEGORY ERROR, and adipose proves it.  Measured in
// scratchpad/audit1/split1.cpp, water split against httk Fcell:
//   liver 1.014  kidney 0.765  brain 0.797  heart 0.784  lung 0.713
//   muscle 0.991  adipose 0.130  gut 0.697  skin 1.081  spleen 0.989
// Adipose diverges by a factor of 7.69 (0.1118 against 0.860), and the reason
// is visible in the same table: adipose holds 0.152 water as a fraction of
// tissue, against 0.67-0.79 for every other organ.  Agreement appears ONLY
// where the tissue is water-dominated, which is what a coincidence looks like.
// A fraction of WATER is not a fraction of VOLUME; in a lipid-dominated tissue
// the cells hold most of the volume and almost none of the water.
//
// So the route is closed by measurement rather than by judgement, and it is
// recorded here so that the next person to notice f_iw / (f_iw + f_ew) does
// not spend the afternoon I just spent.  Poulin-Theil stays muscle-only until
// Peyret Tab. 2 is actually read.
pub fn tc_water_split(organ: i32) -> f64 with Div {
    let c = tc_comp(organ)
    let t = c.f_iw + c.f_ew
    if t <= 0.0 { return 0.0 }
    return c.f_iw / t
}

// The worst ratio between the water split and httk's cell-volume fraction,
// and the organ it occurs in.  7.69x, adipose (organ 7).
pub fn tc_water_split_worst_ratio() -> f64 { return 7.69 }
pub fn tc_water_split_worst_organ() -> i32 { return 7 }
pub fn tc_water_split_substitutable() -> bool { return false }
// ============================================================================
// COMPOSITION CLOSURE  (a note that corrects an earlier claim)
// ============================================================================
// Verified 2026-10-31, organ by organ: f_ew + f_iw + f_nl + f_np + f_protein
// = 1.00000 for all fourteen organs of tc_comp, bone included.  Bone closes
// because its residual -- the mineral matrix -- is carried in f_protein
// (0.5353), which is a deliberate and defensible choice.
//
// This is worth recording because the httk 2.7.4 tissue.data table does NOT
// close for bone: there FWc + FLc + FPc = 0.26 + 0.02 + 0.21 = 0.49, leaving
// 51% of bone cell volume unaccounted, and thyroid (0.90) and placenta (0.955)
// are also short.  Any Schmitt-route prediction read from that table treats
// half of bone as empty.  The defect is httk's, not this module's, and the
// distinction matters because bone is 9.07 L in the Rodgers-Rowland Table VI
// human volumes -- the second largest compartment after muscle (33.89 L).
pub fn tc_closure_verified() -> bool { return true }

// ============================================================================
// Self-test (plain f64 — Madaros + lean_single safe)
// ============================================================================

fn tc_abs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

fn main() -> i32 with IO, Mut, Div, Panic {
    var fails = 0

    // T1 — mass-balance invariant: every organ's fractions sum to ~1.0.
    var organ = 0
    while organ < 14 {
        let c = tc_comp(organ)
        let total = c.f_ew + c.f_iw + c.f_nl + c.f_np + c.f_protein
        if tc_abs(total - 1.0) > 0.06 { fails = fails + 1 }
        organ = organ + 1
    }
    if fails == 0 {
        println("T1 PASS: 14/14 organ compositions sum to 1.0 (mass balance)")
    } else {
        println("T1 FAIL: composition mass-balance violated")
    }

    // T2 — physiological ordering: adipose is the most lipid-rich tissue.
    var t2_ok = 1
    var o = 0
    while o < 14 {
        if o != 7 {
            if tc_lipid(7) <= tc_lipid(o) { t2_ok = 0 }
        }
        o = o + 1
    }
    if t2_ok == 1 {
        println("T2 PASS: adipose (7) is the most lipid-rich of 14 organs")
    } else {
        println("T2 FAIL: lipid ordering wrong"); fails = fails + 1
    }

    // T3 — liver lipid composite is positive and below the raw lipid fraction.
    let lc = tc_lipid_composite(1)
    if lc > 0.0 {
        if lc < tc_lipid(1) {
            println("T3 PASS: liver lipid composite in (0, total lipid)")
        } else {
            println("T3 FAIL: lipid composite >= total lipid"); fails = fails + 1
        }
    } else {
        println("T3 FAIL: lipid composite non-positive"); fails = fails + 1
    }

    // T4 — evidence ε ordering: phospholipid is the weakest fraction class.
    if tc_eps_phospho() < tc_eps_lipid() {
        if tc_eps_lipid() < tc_eps_water() {
            println("T4 PASS: ε ordering phospho < lipid < water (pH is lower still — see T5)")
        } else {
            println("T4 FAIL: ε ordering wrong (lipid/water)"); fails = fails + 1
        }
    } else {
        println("T4 FAIL: ε ordering wrong (phospho/lipid)"); fails = fails + 1
    }

    // T5 — pH is now the weakest evidence class, below phospholipid.
    // It is also the DOMINANT input for a strong base (Peyret Tab. 10 gives
    // SR = -34.2 for cell pH in muscle), so the previous state of the budget
    // had its largest sensitivity carrying no weight at all.
    if tc_eps_ph() < tc_eps_phospho() {
        println("T5 PASS: pH is the weakest evidence class (ε 0.40 < phospho 0.55)")
    } else {
        println("T5 FAIL: pH ε not below phospholipid"); fails = fails + 1
    }

    // T6 — comparability is carried as DATA, and the lung value is not in vivo.
    // This replaces an earlier test that asserted a "localised bias" which had
    // not been established: the alternative values differ in species and
    // preparation, so the test now pins exactly those differences instead.
    // Lung: rat, isolated perfused (not in vivo). Kidney: rat, in vivo.
    // Muscle: human, in vivo.
    if tc_ph_alt_sourced(5) {
        if !tc_ph_alt_in_vivo(5) {
            if !tc_ph_alt_human(2) {
                if tc_ph_alt_human(6) {
                    if tc_ph_alt_in_vivo(6) {
                        println("T6 PASS: species and in-vivo status tagged; lung is not in vivo")
                    } else {
                        println("T6 FAIL: muscle not tagged in vivo"); fails = fails + 1
                    }
                } else {
                    println("T6 FAIL: muscle not tagged human"); fails = fails + 1
                }
            } else {
                println("T6 FAIL: kidney wrongly tagged human"); fails = fails + 1
            }
        } else {
            println("T6 FAIL: isolated perfused lung tagged in vivo"); fails = fails + 1
        }
    } else {
        println("T6 FAIL: lung alternative not flagged sourced"); fails = fails + 1
    }

    // T7 — an unsourced organ must not look like agreement, and liver, brain
    // and heart -- listed in an earlier version without primary citations --
    // must now be unsourced. tc_ph_alt_diff returns 0.0 for them, so callers
    // have to gate on tc_ph_alt_sourced.
    var unsourced_ok = true
    if tc_ph_alt_sourced(1) { unsourced_ok = false }   // liver
    if tc_ph_alt_sourced(3) { unsourced_ok = false }   // brain
    if tc_ph_alt_sourced(4) { unsourced_ok = false }   // heart
    if tc_ph_alt_sourced(7) { unsourced_ok = false }   // adipose
    if unsourced_ok {
        if tc_ph_alt(3) == 0.0 {
            if tc_ph_alt_diff(3) == 0.0 {
                println("T7 PASS: uncited organs gated; no difference reported as agreement")
            } else {
                println("T7 FAIL: unsourced organ returned a difference"); fails = fails + 1
            }
        } else {
            println("T7 FAIL: unsourced organ returned a pH"); fails = fails + 1
        }
    } else {
        println("T7 FAIL: an uncited organ is flagged sourced"); fails = fails + 1
    }

    // T8 — [AP-] fails closed on the organs whose value was never read from the
    // primary source. A negative sentinel is deliberate: it cannot be mistaken
    // for a small concentration the way 0.0 could.
    if tc_ap_rr_sourced(6) {
        if tc_ap_rr(6) > 2.0 {
            if !tc_ap_rr_sourced(3) {
                if tc_ap_rr(3) < 0.0 {
                    println("T8 PASS: [AP-] sourced for muscle, fails closed for brain")
                } else {
                    println("T8 FAIL: unsourced [AP-] not negative"); fails = fails + 1
                }
            } else {
                println("T8 FAIL: brain [AP-] wrongly flagged sourced"); fails = fails + 1
            }
        } else {
            println("T8 FAIL: muscle [AP-] off (expected 2.42)"); fails = fails + 1
        }
    } else {
        println("T8 FAIL: muscle [AP-] not flagged sourced"); fails = fails + 1
    }

    // T9 — only the tissue/blood [AP-] RATIO matters to Rodgers-Rowland, since
    // Ka is back-calculated from blood cells with the same table. Pin the ratio
    // (2.42 / 0.57 = 4.25) rather than either absolute value.
    let ap_ratio = tc_ap_rr(6) / tc_ap_rr_blood_cells()
    if ap_ratio > 4.2 {
        if ap_ratio < 4.3 {
            println("T9 PASS: [AP-] muscle/blood ratio 4.25 — the quantity that enters")
        } else {
            println("T9 FAIL: AP ratio above band"); fails = fails + 1
        }
    } else {
        println("T9 FAIL: AP ratio below band"); fails = fails + 1
    }

    // T10 — composition closes for every organ, bone included. This corrects an
    // earlier claim that bone was defective here: the httk table is the one
    // that does not close (0.49 for bone), not this module.
    var org = 0
    var closed = 0
    while org < 14 {
        let c = tc_comp(org)
        let s = c.f_ew + c.f_iw + c.f_nl + c.f_np + c.f_protein
        let d = if s > 1.0 { s - 1.0 } else { 1.0 - s }
        if d < 1.0e-6 { closed = closed + 1 }
        org = org + 1
    }
    if closed == 14 {
        println("T10 PASS: all 14 organs close to 1.00000 (bone residual in f_protein)")
    } else {
        print("T10 FAIL: organs not closing = "); println(14 - closed); fails = fails + 1
    }


    // T11 -- the httk [AP-] ratios: coverage, and the discrepancy against
    // Rodgers & Rowland on the one organ where both sources exist.  The
    // discrepancy is PINNED, not merely reported: if someone swaps the source
    // behind either accessor this number moves and the test fails.
    var ap_cov = 0
    var o = 1
    while o < 12 {
        if tc_ap_ratio_httk_sourced(o) {
            if tc_ap_ratio_httk(o) > 0.0 { ap_cov = ap_cov + 1 }
        }
        o = o + 1
    }
    if ap_cov == 11 {
        println("T11a PASS: 11 dos 14 orgaos com razao [AP-] httk-derivada")
    } else {
        print("T11a FAIL: cobertura httk = "); println(ap_cov); fails = fails + 1
    }

    // plasma (0), pancreas (12) and other (13) must stay refused, not guessed.
    if tc_ap_ratio_httk_sourced(0) {
        println("T11b FAIL: plasma marcado como httk-sourced"); fails = fails + 1
    } else {
        if tc_ap_ratio_httk_sourced(12) {
            println("T11b FAIL: pancreas marcado como httk-sourced"); fails = fails + 1
        } else {
            if tc_ap_ratio_httk(12) > 0.0 {
                println("T11b FAIL: pancreas devolveu numero em vez de sentinela"); fails = fails + 1
            } else {
                println("T11b PASS: plasma, pancreas e other recusados, nao adivinhados")
            }
        }
    }

    // The pinned discrepancy on muscle: -11.52%.
    let disc = tc_ap_ratio_discrepancy(6)
    if disc < 0.0 - 0.1155 {
        print("T11c FAIL: discrepancia abaixo da banda = "); println(disc); fails = fails + 1
    } else {
        if disc > 0.0 - 0.1148 {
            print("T11c FAIL: discrepancia acima da banda = "); println(disc); fails = fails + 1
        } else {
            println("T11c PASS: httk vs R&R no musculo = -11.52%, fonte declarada")
        }
    }

    // Organs with only ONE source report zero discrepancy, never a fabricated one.
    if tc_ap_ratio_discrepancy(1) == 0.0 {
        if tc_ap_ratio_discrepancy(12) == 0.0 {
            println("T11d PASS: discrepancia 0.0 onde so ha uma fonte")
        } else {
            println("T11d FAIL: discrepancia fabricada para o pancreas"); fails = fails + 1
        }
    } else {
        println("T11d FAIL: discrepancia fabricada para o figado"); fails = fails + 1
    }

    // T12 -- httk cellular pH is species-independent (SIO-564).
    if tc_ph_httk_species_independent() {
        if tc_ph_httk_species_checked() == 14 {
            if tc_ph_httk_species_differing() == 0 {
                println("T12 PASS: pH celular do httk identico Humano/Rato em 14 de 14")
            } else {
                println("T12 FAIL: contagem de tecidos divergentes nao zero"); fails = fails + 1
            }
        } else {
            println("T12 FAIL: numero de tecidos verificados nao e 14"); fails = fails + 1
        }
    } else {
        println("T12 FAIL: independencia de especie nao registrada"); fails = fails + 1
    }

    // T13 -- three independent tables on one tissue.  Water is the ONLY class
    // on which they agree inside 5%; every lipid class disagrees by more than
    // 15%.  If a future edit quietly harmonises the tables, this fails.
    if tc_disagreement(0) < 0.05 {
        if tc_disagreement(1) > 0.15 {
            if tc_disagreement(2) > 0.15 {
                if tc_disagreement(3) > 0.15 {
                    println("T13 PASS: agua concorda <5%; lipidios e fosfolipidio discordam >15%")
                } else {
                    println("T13 FAIL: fosfolipidio concorda demais"); fails = fails + 1
                }
            } else {
                println("T13 FAIL: lipidio total concorda demais"); fails = fails + 1
            }
        } else {
            println("T13 FAIL: lipidio neutro concorda demais"); fails = fails + 1
        }
    } else {
        println("T13 FAIL: agua nao concorda dentro de 5%"); fails = fails + 1
    }

    // T14 -- CORRECTED 2026-11-08 after reading Peyret 2010 directly.  The
    // earlier version of this test said "R&R and P&T agree against httk" and
    // filed 0.02200 under "P&T/Peyret".  Peyret Tab. 3 gives muscle cell
    // neutral lipid 0.0099, about 0.00868 of tissue -- it sides with httk.
    // So the split is three against one, not one lineage against another:
    // R&R Tab. VII and P&T 2002 hold 0.02200; httk and Peyret hold roughly
    // half that.  The test now checks THAT.
    if tc_nl_muscle_by_source(0) == tc_nl_muscle_by_source(1) {
        let hk = tc_nl_muscle_by_source(2)
        let pe = tc_nl_muscle_by_source(3)
        let rr = tc_nl_muscle_by_source(0)
        if hk < rr {
            if pe < rr {
                if tc_peyret_tissue_count() == 3 {
                    if tc_peyret_is_rat() {
                        println("T14 PASS: httk e Peyret ficam ~metade de R&R/P&T -- tres fontes contra uma")
                    } else {
                        println("T14 FAIL: Peyret nao marcado como rato"); fails = fails + 1
                    }
                } else {
                    println("T14 FAIL: contagem de tecidos do Peyret nao e 3"); fails = fails + 1
                }
            } else {
                println("T14 FAIL: Peyret nao ficou abaixo de R&R"); fails = fails + 1
            }
        } else {
            println("T14 FAIL: httk nao e menor que R&R"); fails = fails + 1
        }
    } else {
        println("T14 FAIL: R&R e P&T 2002 divergem no lipidio neutro"); fails = fails + 1
    }

    // T15 -- THE EPSILON ORDERING FAILS, in a located way, and the failure is
    // pinned.  Higher eps should mean better agreement; lipid (0.70) disagrees
    // more than phospholipid (0.55).  The test asserts the VIOLATION, so
    // re-weighting eps to be self-consistent must be a deliberate act.
    if tc_eps_ordering_holds() {
        println("T15 FAIL: ordenacao de eps marcada como valida contra a medicao"); fails = fails + 1
    } else {
        let worse = tc_disagreement(2) > tc_disagreement(3)
        let eps_higher = tc_disagreement_eps(2) > tc_disagreement_eps(3)
        if worse {
            if eps_higher {
                if tc_eps_pairs_ordered() + tc_eps_pairs_violated() == tc_eps_pairs_total() {
                    println("T15 PASS: eps maior porem pior concordancia no lipidio -- 3/5 ordenados, 2 violados")
                } else {
                    println("T15 FAIL: contagem de pares inconsistente"); fails = fails + 1
                }
            } else {
                println("T15 FAIL: eps do lipidio nao e maior que o do fosfolipidio"); fails = fails + 1
            }
        } else {
            println("T15 FAIL: lipidio nao discorda mais que fosfolipidio"); fails = fails + 1
        }
    }

    // T16 -- the water split is NOT a substitute for the cellular volume
    // fraction, and adipose is the proof.  Pinned so the substitution cannot
    // be reintroduced quietly: muscle agrees (which is the trap), adipose
    // does not (which is the refutation).
    if tc_water_split_substitutable() {
        println("T16 FAIL: split de agua marcado como substituivel"); fails = fails + 1
    } else {
        let mus = tc_water_split(6)
        let adi = tc_water_split(7)
        if mus > 0.83 {
            if mus < 0.85 {
                if adi < 0.15 {
                    println("T16 PASS: split de agua coincide no musculo e falha 7.69x no adiposo")
                } else {
                    println("T16 FAIL: adiposo nao divergiu"); fails = fails + 1
                }
            } else {
                println("T16 FAIL: split do musculo fora da banda"); fails = fails + 1
            }
        } else {
            println("T16 FAIL: split do musculo abaixo da banda"); fails = fails + 1
        }
    }

    // T17 -- the Poulin-Theil member is a hybrid, and the fault line is lipid.
    // Every structure and protein constant is Peyret's; every lipid constant
    // is not.  Pinned so that "reconstructed, not transcribed" stays a located
    // fact instead of a vague caveat.
    if tc_pt_is_hybrid() {
        if tc_pt_const_exact() == 5 {
            if tc_pt_const_lipid_mismatch() == 4 {
                if tc_pt_const_other_mismatch() == 1 {
                    println("T17 PASS: PT = esqueleto do Peyret + lipidios de P&T 2002 (5 exatas, 4 lipidicas divergentes)")
                } else {
                    println("T17 FAIL: contagem de divergencias nao-lipidicas"); fails = fails + 1
                }
            } else {
                println("T17 FAIL: contagem de divergencias lipidicas"); fails = fails + 1
            }
        } else {
            println("T17 FAIL: contagem de constantes exatas"); fails = fails + 1
        }
    } else {
        println("T17 FAIL: PT nao marcado como hibrido"); fails = fails + 1
    }

    // T18 -- Peyret covers exactly liver, muscle and adipose, and refuses the
    // rest with a sentinel rather than a neighbouring tissue's value.
    var pc = 0
    var po = 0
    while po < 14 {
        if tc_peyret_covered(po) { pc = pc + 1 }
        po = po + 1
    }
    if pc == tc_peyret_tissue_count() {
        if pc == 3 {
            if tc_peyret_cell_frac(2) < 0.0 {
                println("T18 PASS: Peyret cobre figado, musculo e adiposo; o resto e sentinela")
            } else {
                println("T18 FAIL: rim devolveu numero"); fails = fails + 1
            }
        } else {
            print("T18 FAIL: cobertura = "); println(pc); fails = fails + 1
        }
    } else {
        println("T18 FAIL: cobertura nao casa com a contagem"); fails = fails + 1
    }

    // T19 -- adipose is the tissue that separates a volume fraction from a
    // water fraction, and Peyret now confirms it from outside: Peyret 0.864
    // against httk Fcell 0.860 is 0.46% across SPECIES, while the water split
    // gives 0.1118.  T16 was written before this paper was in hand.
    let pey_adi = tc_peyret_cell_frac(7)
    let ws_adi  = tc_water_split(7)
    if pey_adi > 0.86 {
        if pey_adi < 0.87 {
            if ws_adi < 0.15 {
                println("T19 PASS: Peyret confirma o Fcell do adiposo; o split de agua segue refutado")
            } else {
                println("T19 FAIL: split de agua do adiposo mudou"); fails = fails + 1
            }
        } else {
            println("T19 FAIL: Peyret adiposo acima da banda"); fails = fails + 1
        }
    } else {
        println("T19 FAIL: Peyret adiposo abaixo da banda"); fails = fails + 1
    }
    if fails == 0 {
        println("PASS")
        return 0
    }
    println("FAIL")
    return 1
}
