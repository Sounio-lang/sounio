// stdlib/darwin_pbpk/core/tissue_composition.sio
// Rodgers-Rowland (2006) tissue composition fractions — canonical source module.
//
// Authoritative values for the 14-organ PBPK partition model.
// These are the same values used in core/rodgers_rowland.sio (which holds
// them as private helper functions); this module makes them a named,
// importable, pub-API surface for the dissertation's §4.3 structure.
//
// 14-compartment ordering (matching tsit5_pbpk14 / pbpk28_params):
//   0=blood, 1=liver, 2=kidney, 3=brain, 4=heart, 5=lung, 6=muscle,
//   7=adipose, 8=gut, 9=skin, 10=bone, 11=spleen, 12=pancreas, 13=other
//
// SOURCES:
//   Rodgers T & Rowland M (2006) J Pharm Sci 95:1743-1764, Table 1
//   PK-Sim Human Reference Values (adipose, bone, other)
//   Pearce RG et al. (2017) Drug Metab Dispos 45:1158, acidic PL supplement
//   Poulin P & Krishnan K (1995) Toxicol Ind Health 11:363, plasma protein
//
// NOTE on acidic phospholipid (AP) and plasma protein fractions:
//   Full 14-organ AP values are only partially tabulated in this repository's
//   scope. The three organs below (liver, brain, kidney) are from Rodgers 2006
//   Table 1 directly. The remaining 11 organs are set to widely-used defaults
//   per PK-Sim 6.x tissue parameter database (Schmitt 2008 BMC Pharmacol 8:17).
//   These should be treated as nominal estimates (confidence = 0.5) until
//   organ-specific literature values are curated for the full model.
//   Plasma protein fractions are similarly sourced from Poulin & Krishnan 1995.

// ============================================================================
// WATER FRACTIONS
// ============================================================================

// Extracellular water volume fraction (dimensionless).
// Source: Rodgers & Rowland (2006) Table 1.
pub fn tc_fw_e(i: i32) -> f64 {
    if i == 0  { return 0.620 }   // blood
    if i == 1  { return 0.161 }   // liver
    if i == 2  { return 0.273 }   // kidney
    if i == 3  { return 0.092 }   // brain (Rodgers 2006 Table 1)
    if i == 4  { return 0.320 }   // heart
    if i == 5  { return 0.312 }   // lung
    if i == 6  { return 0.118 }   // muscle
    if i == 7  { return 0.135 }   // adipose
    if i == 8  { return 0.282 }   // gut
    if i == 9  { return 0.382 }   // skin
    if i == 10 { return 0.100 }   // bone
    if i == 11 { return 0.207 }   // spleen
    if i == 12 { return 0.125 }   // pancreas
    return 0.200                   // other
}

// Intracellular water volume fraction (dimensionless).
// Source: Rodgers & Rowland (2006) Table 1.
pub fn tc_fw_i(i: i32) -> f64 {
    if i == 0  { return 0.038 }
    if i == 1  { return 0.573 }
    if i == 2  { return 0.483 }
    if i == 3  { return 0.678 }   // brain: high intracellular (Rodgers 2006)
    if i == 4  { return 0.456 }
    if i == 5  { return 0.392 }
    if i == 6  { return 0.630 }
    if i == 7  { return 0.017 }   // adipose: mostly lipid, very little water
    if i == 8  { return 0.475 }
    if i == 9  { return 0.291 }
    if i == 10 { return 0.346 }
    if i == 11 { return 0.579 }
    if i == 12 { return 0.631 }
    return 0.500
}

// Total water fraction = fw_e + fw_i (dimensionless).
pub fn tc_fw_total(i: i32) -> f64 {
    return tc_fw_e(i) + tc_fw_i(i)
}

// ============================================================================
// LIPID FRACTIONS
// ============================================================================

// Neutral lipid volume fraction (dimensionless).
// Source: Rodgers & Rowland (2006) Table 1; PK-Sim for adipose.
pub fn tc_fn_l(i: i32) -> f64 {
    if i == 0  { return 0.0019 }
    if i == 1  { return 0.0140 }
    if i == 2  { return 0.0130 }
    if i == 3  { return 0.0390 }   // brain: significant myelin lipid
    if i == 4  { return 0.0140 }
    if i == 5  { return 0.0220 }
    if i == 6  { return 0.0100 }
    if i == 7  { return 0.8530 }   // adipose: dominant lipid depot
    if i == 8  { return 0.0380 }
    if i == 9  { return 0.0600 }
    if i == 10 { return 0.0170 }
    if i == 11 { return 0.0110 }
    if i == 12 { return 0.0200 }
    return 0.0200
}

// Phospholipid (zwitterionic / neutral-charge) volume fraction (dimensionless).
// Source: Rodgers & Rowland (2006) Table 1.
pub fn tc_fn_ph(i: i32) -> f64 {
    if i == 0  { return 0.0019 }
    if i == 1  { return 0.0240 }
    if i == 2  { return 0.0120 }
    if i == 3  { return 0.0360 }   // brain: rich in phospholipid (myelin)
    if i == 4  { return 0.0110 }
    if i == 5  { return 0.0130 }
    if i == 6  { return 0.0070 }
    if i == 7  { return 0.0020 }
    if i == 8  { return 0.0160 }
    if i == 9  { return 0.0040 }
    if i == 10 { return 0.0020 }
    if i == 11 { return 0.0110 }
    if i == 12 { return 0.0130 }
    return 0.0100
}

// Acidic phospholipid (AP) volume fraction (dimensionless).
// SOURCING NOTE: liver/brain/kidney from Rodgers & Rowland (2006) Table 1
// directly. Remaining 11 organs from PK-Sim 6.x database (Schmitt 2008
// BMC Pharmacol 8:17) as nominal defaults. Confidence = 0.5 for non-R&R organs.
pub fn tc_fn_ap(i: i32) -> f64 {
    if i == 0  { return 0.0002 }   // blood — Schmitt 2008 default
    if i == 1  { return 0.0050 }   // liver — Rodgers 2006 Table 1
    if i == 2  { return 0.0050 }   // kidney — Rodgers 2006 Table 1
    if i == 3  { return 0.0059 }   // brain — Rodgers 2006 Table 1
    if i == 4  { return 0.0030 }   // heart — Schmitt 2008 default
    if i == 5  { return 0.0020 }   // lung — Schmitt 2008 default
    if i == 6  { return 0.0010 }   // muscle — Schmitt 2008 default
    if i == 7  { return 0.0004 }   // adipose — Schmitt 2008 default
    if i == 8  { return 0.0032 }   // gut — Schmitt 2008 default
    if i == 9  { return 0.0010 }   // skin — Schmitt 2008 default
    if i == 10 { return 0.0006 }   // bone — Schmitt 2008 default
    if i == 11 { return 0.0030 }   // spleen — Schmitt 2008 default
    if i == 12 { return 0.0020 }   // pancreas — Schmitt 2008 default
    return 0.0015                   // other — Schmitt 2008 default
}

// ============================================================================
// PLASMA PROTEIN FRACTION
// ============================================================================

// Albumin + globulin binding protein fraction (dimensionless; relative to
// plasma volume). Used for ionizable-basic drugs in the full Rodgers-Rowland
// Eqs 4–5 extension. For neutral compound R-R Eq 6 (rapamycin), this term
// drops out.
// Source: Poulin & Krishnan (1995) Toxicol Ind Health 11:363, Table 2.
// All values are nominal PK-Sim defaults where not directly tabulated.
pub fn tc_fp_pr(i: i32) -> f64 {
    if i == 0  { return 0.0700 }   // blood — albumin ~ 4.5 g/dL → ~0.07 vol frac
    if i == 1  { return 0.0163 }   // liver — Poulin & Krishnan 1995 Table 2
    if i == 2  { return 0.0926 }   // kidney — Poulin & Krishnan 1995 Table 2
    if i == 3  { return 0.0100 }   // brain — low, BBB-limited
    if i == 4  { return 0.0179 }   // heart — Poulin & Krishnan 1995 Table 2
    if i == 5  { return 0.0218 }   // lung — Poulin & Krishnan 1995 Table 2
    if i == 6  { return 0.0182 }   // muscle — Poulin & Krishnan 1995 Table 2
    if i == 7  { return 0.0135 }   // adipose — Poulin & Krishnan 1995 Table 2
    if i == 8  { return 0.0159 }   // gut — Poulin & Krishnan 1995 Table 2
    if i == 9  { return 0.0123 }   // skin — Poulin & Krishnan 1995 Table 2
    if i == 10 { return 0.0100 }   // bone — Schmitt 2008 default
    if i == 11 { return 0.0111 }   // spleen — Poulin & Krishnan 1995 Table 2
    if i == 12 { return 0.0100 }   // pancreas — Schmitt 2008 default
    return 0.0130                   // other — Schmitt 2008 default
}

// ============================================================================
// LIPID COMPOSITE ACCESSOR — for R-R neutral compound Eq 6
// ============================================================================

// Lipid composite term (fn_L + 0.3 * fn_P) for Rodgers-Rowland neutral Eq 6.
// The 0.3 factor is the empirical phospholipid weighting from R-R 2006.
pub fn tc_lipid_composite_neutral(i: i32) -> f64 {
    return tc_fn_l(i) + 0.3 * tc_fn_ph(i)
}

// ============================================================================
// GATE TEST
// ============================================================================
// T1: Adipose neutral lipid >> liver >> brain (tissue-ordering sanity).
// T2: Water fractions sum to plausible range for each organ.
// T3: AP fractions > 0 for all 14 organs.
// T4: Plasma protein fraction > 0 for all 14 organs.

fn tc_abs(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn main() -> i32 with IO, Mut {
    var passed = 0
    var failed = 0

    // T1: neutral-lipid ordering: adipose (7) >> liver (1) >> blood (0)
    let nl_adipose = tc_fn_l(7)
    let nl_liver   = tc_fn_l(1)
    let nl_blood   = tc_fn_l(0)
    if nl_adipose > nl_liver && nl_liver > nl_blood {
        println("T1 PASS: neutral lipid ordering adipose > liver > blood")
        passed = passed + 1
    } else {
        println("T1 FAIL: unexpected neutral lipid ordering")
        failed = failed + 1
    }

    // T2: water fractions sum to (0.4, 0.85) for most tissues
    var water_ok = 0
    var i = 0
    while i < 14 {
        let fw = tc_fw_total(i)
        if fw > 0.0 && fw < 1.0 { water_ok = water_ok + 1 }
        i = i + 1
    }
    if water_ok == 14 {
        println("T2 PASS: total water fractions in (0,1) for all 14 organs")
        passed = passed + 1
    } else {
        println("T2 FAIL: water fraction out of range for some organ")
        failed = failed + 1
    }

    // T3: AP fractions > 0 for all 14 organs
    var ap_ok = 0
    var j = 0
    while j < 14 {
        if tc_fn_ap(j) > 0.0 { ap_ok = ap_ok + 1 }
        j = j + 1
    }
    if ap_ok == 14 {
        println("T3 PASS: acidic phospholipid fractions > 0 for all 14 organs")
        passed = passed + 1
    } else {
        println("T3 FAIL: AP fraction zero for some organ")
        failed = failed + 1
    }

    // T4: plasma protein fractions > 0
    var pr_ok = 0
    var k = 0
    while k < 14 {
        if tc_fp_pr(k) > 0.0 { pr_ok = pr_ok + 1 }
        k = k + 1
    }
    if pr_ok == 14 {
        println("T4 PASS: plasma protein fractions > 0 for all 14 organs")
        passed = passed + 1
    } else {
        println("T4 FAIL: plasma protein fraction zero for some organ")
        failed = failed + 1
    }

    println("")
    print("Tissue composition: passed=")
    print_int(passed)
    print(" failed=")
    print_int(failed)
    println("")

    if failed == 0 {
        println("PASS")
        return 0
    }
    println("FAIL")
    return 1
}
