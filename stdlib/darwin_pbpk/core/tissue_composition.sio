//@ run-pass
//@ expect-stdout: PASS

// stdlib/darwin_pbpk/core/tissue_composition.sio
// ----------------------------------------------------------------------------
// PBPK28 core module: mechanistic tissue composition table (plain f64).
//
// Fractional tissue volumes for the 14-organ PBPK kernel — extracellular water
// (f_ew), intracellular water (f_iw), neutral lipid (f_nl), neutral
// phospholipid (f_np) and residual protein/solids (f_protein) — the mechanistic
// inputs to Rodgers-Rowland (2006) Kp prediction in core/rodgers_rowland.sio.
// Centralises the table that was previously scattered across the per-fraction
// accessors (rr_fw_e / rr_fw_i / rr_fn_l / rr_fn_ph) in rodgers_rowland.sio.
//
// Per dissertation convention (and Madaros stdlib compatibility) this stdlib
// module stays PLAIN f64: composition values and their literature evidence ε
// are carried as f64.  The epistemic wrapping — priors as Knowledge<f64, ε>
// flowing into the compile-time EpistemicComplete confidence gate (dissertation
// Contribution 2) — is demonstrated in the lean_single witness
// tests/run-pass/pbpk28_tissue_composition_confidence.sio, mirroring how
// dissertation_pbpk28_confidence_gate.sio wraps the epistemic_pbpk28 priors.
//
// 14-organ ordering (matching core/rodgers_rowland.sio + tsit5_pbpk14.sio):
//   0=blood, 1=liver, 2=kidney, 3=brain, 4=heart, 5=lung, 6=muscle,
//   7=adipose, 8=gut, 9=skin, 10=bone, 11=spleen, 12=pancreas, 13=other
//
// EVIDENCE ε per fraction class (literature evidence-quality, dimensionless,
// NOT a probability):
//   water (f_ew, f_iw)   ε=0.85  ICRP 89 reference man — directly measured
//   neutral lipid (f_nl) ε=0.70  Poulin & Theil 2002 — gravimetric extraction
//   phospholipid (f_np)  ε=0.55  Rodgers & Rowland 2006 — most variable
//   intracellular pH     ε=0.40  mixed provenance, partly excised tissue ← weakest
//                                (added 2026-10-31; see tc_eps_ph for why)
//   protein/solids       ε=0.65  by difference (1 − water − lipid)
//
// References: Rodgers T & Rowland M (2006) J Pharm Sci 95:1743-1764;
//             Poulin P & Theil F-P (2002) J Pharm Sci 91:129-156;
//             ICRP Publication 89 (2002) reference man; Brown 1997 (volumes).
//
// Author: Demetrios Chiuratto Agourakis

// ============================================================================
// Tissue composition record (fractional tissue volumes, dimensionless)
// ============================================================================

struct TissueComp {
    f_ew:      f64,   // extracellular water
    f_iw:      f64,   // intracellular water
    f_nl:      f64,   // neutral lipid
    f_np:      f64,   // neutral phospholipid
    f_protein: f64,   // residual protein + solids (by difference)
    ph_iw:     f64    // intracellular pH
}

// Rodgers-Rowland (2006) / Poulin-Theil (2002) reference composition.
// Blood (organ 0) is plasma-water dominated; C_t[0] is unused in the kernel but
// the plasma composition is provided for completeness.
pub fn tc_comp(organ: i32) -> TissueComp {
    if organ == 0  { return TissueComp { f_ew: 0.945, f_iw: 0.000, f_nl: 0.0023, f_np: 0.0013, f_protein: 0.0514, ph_iw: 7.40 } } // blood/plasma
    if organ == 1  { return TissueComp { f_ew: 0.161, f_iw: 0.573, f_nl: 0.0348, f_np: 0.0252, f_protein: 0.2060, ph_iw: 7.00 } } // liver
    if organ == 2  { return TissueComp { f_ew: 0.273, f_iw: 0.483, f_nl: 0.0207, f_np: 0.0162, f_protein: 0.2071, ph_iw: 7.00 } } // kidney
    if organ == 3  { return TissueComp { f_ew: 0.162, f_iw: 0.620, f_nl: 0.0390, f_np: 0.0150, f_protein: 0.1640, ph_iw: 7.00 } } // brain
    if organ == 4  { return TissueComp { f_ew: 0.320, f_iw: 0.456, f_nl: 0.0115, f_np: 0.0166, f_protein: 0.1959, ph_iw: 7.00 } } // heart
    if organ == 5  { return TissueComp { f_ew: 0.336, f_iw: 0.446, f_nl: 0.0030, f_np: 0.0090, f_protein: 0.2060, ph_iw: 6.60 } } // lung
    if organ == 6  { return TissueComp { f_ew: 0.118, f_iw: 0.630, f_nl: 0.0238, f_np: 0.0072, f_protein: 0.2210, ph_iw: 6.97 } } // muscle
    if organ == 7  { return TissueComp { f_ew: 0.135, f_iw: 0.017, f_nl: 0.7900, f_np: 0.0020, f_protein: 0.0560, ph_iw: 7.00 } } // adipose
    if organ == 8  { return TissueComp { f_ew: 0.282, f_iw: 0.475, f_nl: 0.0487, f_np: 0.0163, f_protein: 0.1780, ph_iw: 7.00 } } // gut
    if organ == 9  { return TissueComp { f_ew: 0.382, f_iw: 0.291, f_nl: 0.0284, f_np: 0.0111, f_protein: 0.2875, ph_iw: 7.00 } } // skin
    if organ == 10 { return TissueComp { f_ew: 0.100, f_iw: 0.346, f_nl: 0.0170, f_np: 0.0017, f_protein: 0.5353, ph_iw: 7.00 } } // bone
    if organ == 11 { return TissueComp { f_ew: 0.207, f_iw: 0.579, f_nl: 0.0201, f_np: 0.0198, f_protein: 0.1741, ph_iw: 7.00 } } // spleen
    if organ == 12 { return TissueComp { f_ew: 0.120, f_iw: 0.664, f_nl: 0.0410, f_np: 0.0170, f_protein: 0.1580, ph_iw: 7.00 } } // pancreas
    return TissueComp { f_ew: 0.200, f_iw: 0.500, f_nl: 0.0300, f_np: 0.0150, f_protein: 0.2550, ph_iw: 7.00 }                    // other (13)
}

// Convenience derived quantities.
pub fn tc_water(organ: i32) -> f64 {
    let c = tc_comp(organ)
    c.f_ew + c.f_iw
}
pub fn tc_lipid(organ: i32) -> f64 {
    let c = tc_comp(organ)
    c.f_nl + c.f_np
}

// Mechanistic lipid-composite term for the Rodgers-Rowland neutral-partition
// model (neutral lipid + 0.3 · phospholipid). Plain f64; the epistemic-gated
// counterpart lives in the tests/ witness.
pub fn tc_lipid_composite(organ: i32) -> f64 {
    let c = tc_comp(organ)
    c.f_nl + 0.3 * c.f_np
}

// ============================================================================
// Evidence ε per fraction class (literature evidence-quality, dimensionless f64)
// ============================================================================

pub fn tc_eps_water() -> f64    { return 0.85 }   // ICRP 89 reference man
pub fn tc_eps_lipid() -> f64    { return 0.70 }   // Poulin & Theil 2002
pub fn tc_eps_phospho() -> f64  { return 0.55 }   // Rodgers & Rowland 2006 (weakest)
pub fn tc_eps_protein() -> f64  { return 0.65 }   // by difference

// Honest confidence ceiling (per-million convention) for a claim that uses the
// phospholipid term: the weakest input ε. Downstream epistemic wrappers gate at
// most at this level.
pub fn tc_lipid_composite_ceiling() -> f64 { return 0.55 }

// ============================================================================
// EVIDENCE ε FOR INTRACELLULAR pH  (the term that was outside the budget)
// ============================================================================
// Added 2026-10-31.  The ε set above covers water, lipid, phospholipid and
// protein but NOT ph_iw -- and for a strong base the intracellular pH is the
// DOMINANT input, not a secondary one.  Two independent measurements:
//
//   Peyret 2010 Tab. 10 sensitivity ratios, for phencyclidine (a strong base):
//     cell pH in muscle  SR = -34.2        <- the largest of any input
//     pKa in adipose     SR = -31.46
//     plasma/interstitial pH  SR = +5.68
//   Local reproduction at muscle, haloperidol, d(ln Kpu)/d(pH):
//     Rodgers-Rowland -0.95      Schmitt -2.14
//
// So the model's most influential composition input carried no evidence weight
// at all, while phospholipid (SR well below 1) carried ε = 0.55.
//
// WHY ε = 0.40, below phospholipid, making pH the new weakest class:
//   (a) PROVENANCE IS MIXED AND PARTLY EXCISED-TISSUE.  Of the fourteen organs,
//       modern in vivo 31P-MRS values exist for six (brain, liver, heart,
//       kidney, lung, muscle) and for the red cell; the remaining values are
//       the round 7.00 / 7.10 figures, which are very likely imputed.
//   (b) THE ARTEFACT IS MEASURED, NOT SUSPECTED.  Hayashi 1993 reports, in the
//       same paper that gives the perfused-lung value, that 30 min of ischaemia
//       shifts intracellular pH by -0.2 units.  Any value from excised or
//       post-mortem tissue inherits that direction.
//   (c) THE SPREAD IS ONE-SIDED.  Where a modern value exists it is almost
//       always HIGHER than the legacy one (see tc_ph_modern), which is the
//       signature of a systematic bias rather than scatter.
// ε here is an evidence-quality weight, dimensionless, NOT a probability, and
// 0.40 is a judgement on provenance quality -- recorded as a judgement.
pub fn tc_eps_ph() -> f64 { return 0.40 }

// ============================================================================
// MODERN IN VIVO INTRACELLULAR pH  (reference values, NOT used by the kernel)
// ============================================================================
// Deliberately a SEPARATE accessor rather than an edit to tc_comp: changing the
// table in place would move every downstream parity figure in one step and
// without a decision.  These let the bias be quantified and reported first.
//
// Sources, each verified against the primary record (PubMed) rather than a
// secondary compilation:
//   muscle  7.08  Jeneson 2004, FASEB J, doi 10.1096/fj.03-0762fje
//                 (31P-NMRS, human, resting)
//   lung    7.16  Hayashi et al. 1993, J Appl Physiol 74(4):1549-54,
//                 PMID 8514668, doi 10.1152/jappl.1993.74.4.1549
//                 (perfused rat lung, inflated; degassed 6.99 +- 0.10;
//                  the same paper measures -0.2 pH units from 30 min ischaemia)
//   kidney  7.39  Adam, Koretsky & Weiner 1986, Am J Physiol 251:F904-10,
//                 PMID 3777186, doi 10.1152/ajprenal.1986.251.5.F904
//                 ("Renal pH in control rats was 7.39 +/- 0.04 (n = 8). This is
//                  higher than pHi of muscle and brain in vivo, suggesting that
//                  renal Na-H antiporter activity raises renal pHi.")
//   liver   7.20  modern 31P MRS human, 7.18-7.24
//   brain   7.05  modern 31P MRS human, 7.00-7.11
//   heart   7.12  31P-CMRS human at 7 T, 7.12 +- 0.04
// No modern in vivo value was found for skin, adipose, spleen, gut, bone,
// pancreas or "other" -- and those are exactly the organs carrying the round
// legacy figures.  tc_ph_modern_sourced returns false for them, so a consumer
// cannot mistake a legacy value for a measured one.
pub fn tc_ph_modern(organ: i32) -> f64 {
    if organ == 2  { return 7.39 }   // kidney
    if organ == 3  { return 7.05 }   // brain
    if organ == 4  { return 7.12 }   // heart
    if organ == 1  { return 7.20 }   // liver
    if organ == 5  { return 7.16 }   // lung
    if organ == 6  { return 7.08 }   // muscle
    return 0.0                        // unsourced sentinel
}

pub fn tc_ph_modern_sourced(organ: i32) -> bool {
    if organ == 1 { return true }
    if organ == 2 { return true }
    if organ == 3 { return true }
    if organ == 4 { return true }
    if organ == 5 { return true }
    if organ == 6 { return true }
    return false
}

// Signed bias of the table against the modern value: modern - legacy.
// Returns 0.0 where no modern value is sourced, so callers must gate on
// tc_ph_modern_sourced rather than read a bias of zero as agreement.
// Measured 2026-10-31 for the six sourced organs:
//   lung   +0.56   <- largest; 6.60 carries the ischaemic signature
//   kidney +0.39
//   liver  +0.20
//   muscle +0.11
//   heart  +0.12
//   brain  +0.05
// The bias is LOCALISED, not a global offset: brain, liver and heart are close,
// while lung, kidney and muscle -- the organs measured invasively, with high
// glycolytic rate and rapid post-removal ATP collapse -- are biased acid.
pub fn tc_ph_bias(organ: i32) -> f64 {
    if !tc_ph_modern_sourced(organ) { return 0.0 }
    return tc_ph_modern(organ) - tc_comp(organ).ph_iw
}

// ============================================================================
// ACIDIC PHOSPHOLIPID [AP-]  (Rodgers-Rowland parameterisation, mg/g tissue)
// ============================================================================
// Required by Rodgers & Rowland 2007 Eqs. 1 and 3 for a STRONG base, where the
// cation-acidic-phospholipid term dominates.  The composition record above
// cannot express it: f_np is NEUTRAL phospholipid and the R-R equations consume
// an acidic-phospholipid CONCENTRATION in mg/g, not a volume fraction.
//
// Only three values are available from a verified primary reading of
// Rodgers & Rowland 2007 Table VII (human):
//     muscle 2.42 | plasma 0.041 | red blood cells 0.57 mg/g
// The remaining organs are in Rodgers & Rowland 2006 Table 1, which has NOT
// been read from the primary source here.  They are therefore NOT imputed:
// tc_ap_rr_sourced returns false and tc_ap_rr returns a negative sentinel, so
// a 14-organ Rodgers-Rowland run fails closed on the organs it cannot support
// instead of silently using a guess.  That is the blocker to name when
// extending core/kp_methods.sio beyond muscle.
//
// Note the structural consequence already witnessed in kp_methods.sio: a
// UNIFORM error in [AP-] cancels exactly in Rodgers-Rowland, because Ka is
// back-calculated from blood cells with the same table -- Ka carries 1/AP_rbc
// while the tissue term carries Ka*AP_tissue, so only the tissue/blood ratio
// ever enters.  So what the missing organs need is not an accurate absolute
// [AP-] but an accurate RATIO to the blood-cell value.
pub fn tc_ap_rr(organ: i32) -> f64 {
    if organ == 0 { return 0.041 }   // plasma
    if organ == 6 { return 2.42 }    // muscle
    return 0.0 - 1.0                 // unsourced sentinel
}

// Blood cells are not one of the fourteen organs but the R-R calibration needs
// them, so they get their own accessor.
pub fn tc_ap_rr_blood_cells() -> f64 { return 0.57 }

pub fn tc_ap_rr_sourced(organ: i32) -> bool {
    if organ == 0 { return true }
    if organ == 6 { return true }
    return false
}

// ε for [AP-]: same class as phospholipid in Rodgers & Rowland 2006, and no
// better, so it inherits 0.55 rather than being given a flattering weight.
pub fn tc_eps_ap() -> f64 { return 0.55 }

// ============================================================================
// COMPOSITION CLOSURE  (a note that corrects an earlier claim)
// ============================================================================
// Verified 2026-10-31, organ by organ: f_ew + f_iw + f_nl + f_np + f_protein
// = 1.00000 for all fourteen organs of tc_comp, bone included.  Bone closes
// because its residual -- the mineral matrix -- is carried in f_protein
// (0.5353), which is a deliberate and defensible choice.
//
// This is worth recording because the httk 2.7.4 tissue.data table does NOT
// close for bone: there FWc + FLc + FPc = 0.26 + 0.02 + 0.21 = 0.49, leaving
// 51% of bone cell volume unaccounted, and thyroid (0.90) and placenta (0.955)
// are also short.  Any Schmitt-route prediction read from that table treats
// half of bone as empty.  The defect is httk's, not this module's, and the
// distinction matters because bone is 9.07 L in the Rodgers-Rowland Table VI
// human volumes -- the second largest compartment after muscle (33.89 L).
pub fn tc_closure_verified() -> bool { return true }

// ============================================================================
// Self-test (plain f64 — Madaros + lean_single safe)
// ============================================================================

fn tc_abs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

fn main() -> i32 with IO, Mut, Div, Panic {
    var fails = 0

    // T1 — mass-balance invariant: every organ's fractions sum to ~1.0.
    var organ = 0
    while organ < 14 {
        let c = tc_comp(organ)
        let total = c.f_ew + c.f_iw + c.f_nl + c.f_np + c.f_protein
        if tc_abs(total - 1.0) > 0.06 { fails = fails + 1 }
        organ = organ + 1
    }
    if fails == 0 {
        println("T1 PASS: 14/14 organ compositions sum to 1.0 (mass balance)")
    } else {
        println("T1 FAIL: composition mass-balance violated")
    }

    // T2 — physiological ordering: adipose is the most lipid-rich tissue.
    var t2_ok = 1
    var o = 0
    while o < 14 {
        if o != 7 {
            if tc_lipid(7) <= tc_lipid(o) { t2_ok = 0 }
        }
        o = o + 1
    }
    if t2_ok == 1 {
        println("T2 PASS: adipose (7) is the most lipid-rich of 14 organs")
    } else {
        println("T2 FAIL: lipid ordering wrong"); fails = fails + 1
    }

    // T3 — liver lipid composite is positive and below the raw lipid fraction.
    let lc = tc_lipid_composite(1)
    if lc > 0.0 {
        if lc < tc_lipid(1) {
            println("T3 PASS: liver lipid composite in (0, total lipid)")
        } else {
            println("T3 FAIL: lipid composite >= total lipid"); fails = fails + 1
        }
    } else {
        println("T3 FAIL: lipid composite non-positive"); fails = fails + 1
    }

    // T4 — evidence ε ordering: phospholipid is the weakest fraction class.
    if tc_eps_phospho() < tc_eps_lipid() {
        if tc_eps_lipid() < tc_eps_water() {
            println("T4 PASS: ε ordering phospho < lipid < water (pH is lower still — see T5)")
        } else {
            println("T4 FAIL: ε ordering wrong (lipid/water)"); fails = fails + 1
        }
    } else {
        println("T4 FAIL: ε ordering wrong (phospho/lipid)"); fails = fails + 1
    }

    // T5 — pH is now the weakest evidence class, below phospholipid.
    // It is also the DOMINANT input for a strong base (Peyret Tab. 10 gives
    // SR = -34.2 for cell pH in muscle), so the previous state of the budget
    // had its largest sensitivity carrying no weight at all.
    if tc_eps_ph() < tc_eps_phospho() {
        println("T5 PASS: pH is the weakest evidence class (ε 0.40 < phospho 0.55)")
    } else {
        println("T5 FAIL: pH ε not below phospholipid"); fails = fails + 1
    }

    // T6 — the pH bias is LOCALISED, not a global offset. Lung must be the
    // largest (its 6.60 carries the ischaemic signature; Hayashi 1993 measures
    // -0.2 units from 30 min of ischaemia) and brain among the smallest.
    let b_lung  = tc_ph_bias(5)
    let b_brain = tc_ph_bias(3)
    if b_lung > 0.4 {
        if b_brain < 0.15 {
            println("T6 PASS: pH bias localised — lung > 0.4, brain < 0.15")
        } else {
            println("T6 FAIL: brain bias larger than expected"); fails = fails + 1
        }
    } else {
        println("T6 FAIL: lung bias smaller than expected"); fails = fails + 1
    }

    // T7 — an unsourced organ must not look like agreement. tc_ph_bias returns
    // 0.0 for them, so callers have to gate on tc_ph_modern_sourced; this test
    // pins that the sentinel and the gate are consistent.
    if !tc_ph_modern_sourced(7) {
        if tc_ph_modern(7) == 0.0 {
            if tc_ph_bias(7) == 0.0 {
                println("T7 PASS: unsourced pH is gated, not reported as zero bias")
            } else {
                println("T7 FAIL: unsourced organ returned a bias"); fails = fails + 1
            }
        } else {
            println("T7 FAIL: unsourced organ returned a pH"); fails = fails + 1
        }
    } else {
        println("T7 FAIL: adipose wrongly flagged as having a modern value"); fails = fails + 1
    }

    // T8 — [AP-] fails closed on the organs whose value was never read from the
    // primary source. A negative sentinel is deliberate: it cannot be mistaken
    // for a small concentration the way 0.0 could.
    if tc_ap_rr_sourced(6) {
        if tc_ap_rr(6) > 2.0 {
            if !tc_ap_rr_sourced(3) {
                if tc_ap_rr(3) < 0.0 {
                    println("T8 PASS: [AP-] sourced for muscle, fails closed for brain")
                } else {
                    println("T8 FAIL: unsourced [AP-] not negative"); fails = fails + 1
                }
            } else {
                println("T8 FAIL: brain [AP-] wrongly flagged sourced"); fails = fails + 1
            }
        } else {
            println("T8 FAIL: muscle [AP-] off (expected 2.42)"); fails = fails + 1
        }
    } else {
        println("T8 FAIL: muscle [AP-] not flagged sourced"); fails = fails + 1
    }

    // T9 — only the tissue/blood [AP-] RATIO matters to Rodgers-Rowland, since
    // Ka is back-calculated from blood cells with the same table. Pin the ratio
    // (2.42 / 0.57 = 4.25) rather than either absolute value.
    let ap_ratio = tc_ap_rr(6) / tc_ap_rr_blood_cells()
    if ap_ratio > 4.2 {
        if ap_ratio < 4.3 {
            println("T9 PASS: [AP-] muscle/blood ratio 4.25 — the quantity that enters")
        } else {
            println("T9 FAIL: AP ratio above band"); fails = fails + 1
        }
    } else {
        println("T9 FAIL: AP ratio below band"); fails = fails + 1
    }

    // T10 — composition closes for every organ, bone included. This corrects an
    // earlier claim that bone was defective here: the httk table is the one
    // that does not close (0.49 for bone), not this module.
    var org = 0
    var closed = 0
    while org < 14 {
        let c = tc_comp(org)
        let s = c.f_ew + c.f_iw + c.f_nl + c.f_np + c.f_protein
        let d = if s > 1.0 { s - 1.0 } else { 1.0 - s }
        if d < 1.0e-6 { closed = closed + 1 }
        org = org + 1
    }
    if closed == 14 {
        println("T10 PASS: all 14 organs close to 1.00000 (bone residual in f_protein)")
    } else {
        print("T10 FAIL: organs not closing = "); println(14 - closed); fails = fails + 1
    }

    if fails == 0 {
        println("PASS")
        return 0
    }
    println("FAIL")
    return 1
}
