// stdlib/darwin_pbpk/core/pbpk28_params.sio — PBPK28 state + parameter records
//
// The Stage G dissertation kernel: 14 organs × {vascular C_v, interstitial C_t}
// with a permeability-surface-area product PS coupling. Blood is organ 0;
// peripheral organs are indexed 1..13.
//
// State carries only the transport-layer values (Cv, Ct). TMDD layer
// (R_free, DR) and PD layer (A, N) live in separate records under
// `stdlib/darwin_pbpk/tmdd/` and `stdlib/darwin_pbpk/pd/` — composed by the
// scenario file.
//
// Parameters bundle the per-organ physiology (V_ref, vasc_frac, K_p, PS, Q)
// + a central clearance (cl_central; routes are drug-specific:
// rapamycin = hepatic CYP3A4, semaglutide = proteolytic). The drug profile
// constructors `pbpk28_params_rapamycin()` / `pbpk28_params_semaglutide()`
// populate the fixed-size arrays from literature values matching the JS
// engine `website/src/lib/pbpk28_core.mjs` and the parity refs.
//
// Stage G-ε-15. gap-report claims `organ_topology` (CONFIRMED),
// `peptide_extension_path` (PARTIAL — peptide K_p set lives in this file
// rather than a separate `core/peptide_partitioning.sio` module, which the
// dissertation §4.3.5 may want to relocate).

// ─── State record ───────────────────────────────────────────────────────────
// 14 organs × {C_v, C_t}, all mg/L. Blood is C_v[0] (C_t[0] unused).
pub struct PBPKState28 {
    cv: [f64; 14],
    ct: [f64; 14],
}

pub fn pbpk28_state_zero() -> PBPKState28 {
    PBPKState28 {
        cv: [0.0; 14],
        ct: [0.0; 14],
    }
}

// ─── Parameter record ───────────────────────────────────────────────────────
pub struct PBPKParams28 {
    v_ref:      [f64; 14],   // L, organ volume (ICRP standard man 70 kg)
    vasc_frac:  [f64; 14],   // V_v / V_total per organ (Brown 1997)
    kp:         [f64; 14],   // tissue:vascular partition coefficient at eq
    ps:         [f64; 14],   // mL/min·… permeability-surface-area product
    q:          [f64; 14],   // L/h, organ blood flow (70 kg adult)
    cl_central: f64,         // L/h; hepatic (rapamycin) or proteolytic (sema)
}

// ─── Rapamycin profile ──────────────────────────────────────────────────────
// Lipophilic small molecule (MW 914 Da). High Kp in liver (5.4) / lung (3.1) /
// kidney (4.2) / heart (2.3) / gut (2.6) / spleen (2.1); low at BBB
// (Kp_brain = 0.10 — P-gp efflux per Lampen 1998). PS is large (membrane
// not rate-limiting). Hepatic CYP3A4 clearance 12.4 L/h (Ferron 1997).
pub fn pbpk28_params_rapamycin() -> PBPKParams28 {
    PBPKParams28 {
        v_ref:     [5.0, 1.8, 0.31, 1.45, 0.33, 1.1, 28.0, 20.0, 1.2, 3.6, 6.6, 0.18, 0.09, 3.7],
        vasc_frac: [1.000, 0.210, 0.160, 0.037, 0.262, 0.262, 0.040, 0.050, 0.024, 0.019, 0.041, 0.282, 0.180, 0.050],
        kp:        [1.00, 5.40, 4.20, 0.10, 2.30, 3.10, 0.50, 0.30, 2.60, 0.80, 0.20, 2.10, 1.80, 0.40],
        ps:        [0.0, 1800.0, 1110.0, 88.0, 160.0, 10500.0, 336.0, 40.0, 660.0, 126.0, 51.0, 150.0, 96.0, 78.0],
        q:         [350.0, 90.0, 74.0, 44.0, 16.0, 350.0, 42.0, 10.0, 55.0, 21.0, 17.0, 10.0, 8.0, 13.0],
        cl_central: 12.4,
    }
}

// ─── Venlafaxine parent profile ─────────────────────────────────────────────
// Moderate lipophile (LogP ≈ 2.4). Kp elevated in liver/kidney (metabolic sink),
// moderate muscle/adipose. BBB permeable but not efflux-dominated like rapamycin.
// cl_central = non-formation parent clearance at NM (~57 L/h); CYP2D6 formation
// to ODV is coupled in scenarios/venlafaxine_xr.sio (Klamerus 1999).
// source: Wang 2022; Rodgers-Rowland class estimates for Kp/PS
pub fn pbpk28_params_venlafaxine_parent() -> PBPKParams28 {
    PBPKParams28 {
        v_ref:     [5.0, 1.8, 0.31, 1.45, 0.33, 1.1, 28.0, 20.0, 1.2, 3.6, 6.6, 0.18, 0.09, 3.7],
        vasc_frac: [1.000, 0.210, 0.160, 0.037, 0.262, 0.262, 0.040, 0.050, 0.024, 0.019, 0.041, 0.282, 0.180, 0.050],
        kp:        [1.00, 4.20, 3.50, 1.20, 2.00, 2.80, 1.80, 1.20, 2.40, 1.50, 0.80, 2.00, 1.60, 0.90],
        ps:        [0.0, 900.0, 600.0, 120.0, 200.0, 8000.0, 250.0, 80.0, 500.0, 100.0, 40.0, 120.0, 80.0, 60.0],
        q:         [350.0, 90.0, 74.0, 44.0, 16.0, 350.0, 42.0, 10.0, 55.0, 21.0, 17.0, 10.0, 8.0, 13.0],
        cl_central: 57.0,
    }
}

// ─── Venlafaxine ODV (desvenlafaxine) profile ───────────────────────────────
// Slightly more hydrophilic metabolite; lower Kp, slower PS than parent.
// cl_central = 28 L/h at NM (Wyeth label 0.4 L/h/kg × 70 kg).
pub fn pbpk28_params_venlafaxine_odv() -> PBPKParams28 {
    PBPKParams28 {
        v_ref:     [5.0, 1.8, 0.31, 1.45, 0.33, 1.1, 28.0, 20.0, 1.2, 3.6, 6.6, 0.18, 0.09, 3.7],
        vasc_frac: [1.000, 0.210, 0.160, 0.037, 0.262, 0.262, 0.040, 0.050, 0.024, 0.019, 0.041, 0.282, 0.180, 0.050],
        kp:        [1.00, 3.50, 3.00, 1.00, 1.60, 2.20, 1.40, 0.90, 2.00, 1.20, 0.70, 1.60, 1.30, 0.70],
        ps:        [0.0, 700.0, 450.0, 90.0, 150.0, 6000.0, 200.0, 60.0, 400.0, 80.0, 30.0, 100.0, 70.0, 50.0],
        q:         [350.0, 90.0, 74.0, 44.0, 16.0, 350.0, 42.0, 10.0, 55.0, 21.0, 17.0, 10.0, 8.0, 13.0],
        cl_central: 28.0,
    }
}

// ─── Semaglutide profile ────────────────────────────────────────────────────
// 4114 Da peptide. Low Kp everywhere (Kp < 1; vascular-confined). PS is much
// lower than rapamycin (steric exclusion at endothelium; BBB nearly
// impermeable PS=1). Proteolytic clearance 0.077 L/h (Overgaard 2019).
pub fn pbpk28_params_semaglutide() -> PBPKParams28 {
    PBPKParams28 {
        v_ref:     [5.0, 1.8, 0.31, 1.45, 0.33, 1.1, 28.0, 20.0, 1.2, 3.6, 6.6, 0.18, 0.09, 3.7],
        vasc_frac: [1.000, 0.210, 0.160, 0.037, 0.262, 0.262, 0.040, 0.050, 0.024, 0.019, 0.041, 0.282, 0.180, 0.050],
        kp:        [1.00, 0.50, 0.60, 0.05, 0.40, 0.30, 0.20, 0.10, 0.80, 0.30, 0.20, 0.40, 0.70, 0.30],
        ps:        [0.0, 50.0, 30.0, 1.0, 5.0, 100.0, 10.0, 2.0, 30.0, 5.0, 2.0, 10.0, 8.0, 5.0],
        q:         [350.0, 90.0, 74.0, 44.0, 16.0, 350.0, 42.0, 10.0, 55.0, 21.0, 17.0, 10.0, 8.0, 13.0],
        cl_central: 0.077,
    }
}

// ─── Total-mass utility ─────────────────────────────────────────────────────
// Σ_i (V_v,i · C_v,i + V_t,i · C_t,i). Useful for the parity-gate's case-4
// mass-conservation invariant (12/12 samples monotonically decay under
// no-source bolus runs).
pub fn pbpk28_total_mass(s: PBPKState28, p: PBPKParams28) -> f64 with Mut {
    var total = 0.0
    // Blood: V_b · C_v[0]  (V_t,0 is zero).
    total = total + p.v_ref[0] * s.cv[0]
    var i: i32 = 1
    while i < 14 {
        let vi = p.v_ref[i]
        let vf = p.vasc_frac[i]
        let vv = vi * vf
        let vt = vi * (1.0 - vf)
        total = total + vv * s.cv[i] + vt * s.ct[i]
        i = i + 1
    }
    return total
}
