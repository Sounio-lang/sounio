// darwin_pbpk/io/mapping.sio — map normalized observations onto TAC predictions

use darwin_pbpk::brain_plasma_tac::*
use darwin_pbpk::schema::observation::*

fn map_linear(t0: f64, y0: f64, t1: f64, y1: f64, t: f64) -> f64 with Div, Panic {
    let dt = t1 - t0
    if dt == 0.0 {
        return y0
    }
    y0 + (y1 - y0) * (t - t0) / dt
}

fn map_series_value(
    times: [f64; 16],
    values: [f64; 16],
    n_points: i32,
    time_h: f64
) -> f64 with Div, Panic {
    if n_points <= 0 {
        return 0.0
    }
    if time_h <= times[0] {
        return values[0]
    }

    let last_idx = (n_points - 1) as usize
    if time_h >= times[last_idx] {
        return values[last_idx]
    }

    var i: i32 = 0
    while i < n_points - 1 {
        let idx0 = i as usize
        let idx1 = (i + 1) as usize
        let t0 = times[idx0]
        let t1 = times[idx1]
        if time_h >= t0 && time_h <= t1 {
            return map_linear(t0, values[idx0], t1, values[idx1], time_h)
        }
        i = i + 1
    }

    values[last_idx]
}

pub fn map_observation_prediction(
    tac: BrainPlasmaTacTable,
    row: NormalizedObservationRow
) -> f64 with Div, Panic {
    if row.observable_id == "brain_tissue" {
        return map_series_value(tac.times_h, tac.brain_values, tac.n_points, row.time_h)
    }
    map_series_value(tac.times_h, tac.blood_values, tac.n_points, row.time_h)
}
