// darwin_pbpk/io/normalization.sio — normalize observed PBPK measurements

use darwin_pbpk::schema::observation::*

fn norm_time_to_h(value: f64, unit: string) -> f64 with Div {
    if unit == "h" || unit == "hr" || unit == "hrs" || unit == "hour" || unit == "hours" {
        return value
    }
    if unit == "min" || unit == "mins" || unit == "minute" || unit == "minutes" {
        return value / 60.0
    }
    if unit == "s" || unit == "sec" || unit == "secs" || unit == "second" || unit == "seconds" {
        return value / 3600.0
    }
    value
}

fn norm_value_factor(unit: string) -> f64 {
    if unit == "mg/L" || unit == "mg_per_L" {
        return 1.0
    }
    if unit == "ug/L" {
        return 0.001
    }
    if unit == "ng/mL" {
        return 0.001
    }
    if unit == "ug/mL" {
        return 1.0
    }
    if unit == "ng/L" {
        return 0.000001
    }
    1.0
}

fn norm_observable_id(row: RawObservationRow) -> string {
    if row.observable_id != "" {
        return row.observable_id
    }
    if row.matrix == "plasma" || row.matrix == "blood" || row.organ == "blood" {
        return "blood_plasma"
    }
    if row.organ == "brain" || row.matrix == "brain" || row.compartment == "brain" {
        return "brain_tissue"
    }
    if row.organ == "brain" && row.compartment == "tissue" {
        return "brain_tissue"
    }
    "unmapped"
}

pub fn normalize_observations(
    raw: RawObservationTable,
    simulation_condition_id: string
) -> NormalizedObservationTable with Mut, Div, Panic {
    var out = normalized_observation_table_new()

    var i: usize = 0
    while i < raw_observation_count(raw) {
        let row = raw_observation_get(raw, i)
        let factor = norm_value_factor(row.value_unit)

        out = normalized_observation_table_add(
            out,
            row.subject_id,
            simulation_condition_id,
            norm_observable_id(row),
            norm_time_to_h(row.time_value, row.time_unit),
            row.measurement * factor,
            row.measurement_uncertainty * factor,
            "mg/L",
            row.matrix,
            row.organ,
            row.compartment,
            row.assay,
            row.source
        )
        i = i + 1
    }

    out
}
