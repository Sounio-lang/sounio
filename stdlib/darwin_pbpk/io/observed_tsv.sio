// darwin_pbpk/io/observed_tsv.sio — TSV parsing for PBPK observed data

use darwin_pbpk::io::observed_csv::{parse_observed_delimited}
use darwin_pbpk::schema::observation::*

pub fn parse_observed_tsv(content: string) -> RawObservationTable with Mut, Div, Panic {
    parse_observed_delimited(content, "\t")
}
