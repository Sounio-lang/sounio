// stdlib/darwin_pbpk/sens_pbpk28.sio — forward (tangent-linear) sensitivities
// of the PBPK28 θ-step, integrated together with the model
//
// Why this module exists
// ----------------------
// epistemic_pbpk28.sio builds the GUM Jacobian by central differences: two
// complete simulations per epistemic parameter, and only for four end-point
// metrics (AUC_blood, AUC_liver, AUC_kidney, C_brain(24 h)). That is a layer
// around the solver. This module carries the sensitivities THROUGH the
// integrator instead: one extra linear solve per parameter per sub-step, with
// the same Schur elimination as the model step, yielding
//     s_j(t) = ∂x(t)/∂θ_j     for every state and every step,
// hence the combined standard uncertainty u_c(t) of any concentration at any
// time (JCGM 100:2008 §5.1.2, sensitivity coefficients c_j = ∂f/∂x_j).
//
// Derivation (discrete tangent of the θ-method)
// ----------------------------------------------
// One θ-step of ẋ = A(θ)·x is  L·x₁ = E·x₀  with  L = I − h_i·A,
// E = I + h_e·A,  h_i = θ·dt,  h_e = (1−θ)·dt. Differentiating with respect
// to a parameter θ_j (∂L = −h_i·∂A, ∂E = h_e·∂A):
//     L·s₁ = E·s₀ + ∂A·(h_e·x₀ + h_i·x₁)
// The tangent step is therefore the SAME linear step applied to s, plus a
// forcing built from the model states before and after the step. It is the
// exact derivative of the discrete scheme (not of the continuous ODE), so it
// agrees with a finite difference of the same scheme up to the finite
// difference's own truncation and rounding error, at every dt.
//
// Parameters covered (the ep28 taxonomy, epistemic_pbpk28.sio):
//   0 cl_hepatic, 1 cl_renal : ∂cl_central/∂θ = 1
//   2 fu_plasma              : ∂cl_central/∂θ = cl_central / fu_ref
//   3 kp_brain (organ 3), 4 kp_liver (organ 1), 5 kp_kidney (organ 2),
//   6 kp_adipose (organ 7)
// ∂A for cl_central touches the blood row only: −C_b / V_b.
// ∂A for kp_o touches organ o's 2×2 block:  ∂k_vt = −k_vt/kp on the vascular
// row, ∂k_t = −k_t/kp on the tissue row (so the tissue row gains
// +(k_t/kp)·C_t). Under the volume weights the two forcings cancel exactly:
// V_v·(−k_vt/kp) + V_t·(k_t/kp) = −PS/kp² + PS/kp² = 0 (a Kp change moves
// mass between the two spaces of one organ, it does not create any).
//
// Exact check carried by the consumer test
// (tests/run-pass/pbpk28_tangent_gum.sio): differentiating the ledger
// identity M(T) + CL·AUC_blood = Dose gives, for every parameter,
//     ∂M(T)/∂θ_j + CL·∂AUC_blood/∂θ_j + (∂CL/∂θ_j)·AUC_blood = 0
// to rounding.
//
// Two paths, mirroring epistemic_pbpk28.sio:
//   ep28_tangent_run       IV bolus into blood, no sink (ep28_run);
//   ep28_tangent_run_oral  matrix release → gut → first-order absorption into
//                          blood, with a first-order liver sink cl_form
//                          (ep28_run_oral: venlafaxine XR, midazolam,
//                          haloperidol).
// On the oral path parameter 0 is the clearance the prior describes: the
// liver sink cl_form when one is configured (venlafaxine; rate k_s = cl_form /
// V_liver on both liver rows, so ∂A is −1/V_liver on each), and cl_central
// when cl_form = 0 (midazolam, haloperidol, whose hepatic clearance is
// cl_central). Parameter 2 scales cl_central by the drug's own fu reference.
// The absorbed input does not depend on any of the seven parameters, so it
// adds no tangent forcing. The differentiated identity gains the sink terms:
//     ∂M/∂θ_j + CL·∂AUC_b/∂θ_j + (∂CL/∂θ_j)·AUC_b
//             + cl_form·∂AUC_liver/∂θ_j + (∂cl_form/∂θ_j)·AUC_liver = 0
//
// Layout: the 8 tangent states are stored flat (j·14 + i) in one struct, and
// the Schur pass is done twice without local [f64; 14] arrays (the Madaros
// multimodule workaround documented in theta_pbpk28.sio).
//
// Author: Demetrios Chiuratto Agourakis

use darwin_pbpk::core::pbpk28_params::*
use darwin_pbpk::theta_pbpk28::*
use darwin_pbpk::release::matrix_er::*
use math::pure::{exp}
use darwin_pbpk::epistemic_pbpk28::{EpPrior28, EpJac28, OralInputs28, ep28_fu_ref}

// Tangent states and their running integrals for up to 8 parameters.
pub struct Tan28 {
    pub cv:  [f64; 112],   // ∂C_v,i/∂θ_j at j·14 + i
    pub ct:  [f64; 112],   // ∂C_t,i/∂θ_j
    pub auc: [f64; 112],   // ∂(∫C_avg,i dt)/∂θ_j, method quadrature
}

pub fn tan28_zero() -> Tan28 {
    Tan28 { cv: [0.0; 112], ct: [0.0; 112], auc: [0.0; 112] }
}

// Organ whose Kp parameter j perturbs; 0 for the clearance parameters.
pub fn s28_kp_organ(j: i32) -> i32 {
    if j == 3 { return 3 }
    if j == 4 { return 1 }
    if j == 5 { return 2 }
    if j == 6 { return 7 }
    return 0
}

// ∂cl_central/∂θ_j (0 for the Kp parameters). Mirrors ep28_perturb.
pub fn s28_dcl(prm: PBPKParams28, j: i32) -> f64 with Div {
    if j == 0 { return 1.0 }
    if j == 1 { return 1.0 }
    if j == 2 {
        let fu_ref = ep28_fu_ref()
        if fu_ref > 0.0 { return prm.cl_central / fu_ref }
        return 0.0
    }
    return 0.0
}

struct S28Blk {
    av: f64,
    bv: f64,
    at: f64,
    bt: f64,
    beta: f64,
}

// Schur coefficients of organ i for one θ-step: C_v,new = av + bv·C_b,new and
// C_t,new = at + bt·C_b,new. Same algebra and the same degenerate-volume
// floor as pbpk28_theta_step_routed_sink_mut (organ sink rate ks on both
// rows, no routed input), with the tangent forcing f_v / f_t added to the
// organ's right-hand sides.
fn s28_block(
    p: PBPKParams28, i: i32, hi: f64, he: f64,
    cb_old: f64, cv_old: f64, ct_old: f64, f_v: f64, f_t: f64, ks: f64
) -> S28Blk with Div {
    let vb = p.v_ref[0]
    let vi = p.v_ref[i]
    let vf = p.vasc_frac[i]
    let vv_raw = vi * vf
    let vt_raw = vi * (1.0 - vf)
    let vv = if vv_raw < 1.0e-30 { 1.0e-30 } else { vv_raw }
    let vt = if vt_raw < 1.0e-30 { 1.0e-30 } else { vt_raw }
    let kp = p.kp[i]
    let ps = p.ps[i]
    let qi = p.q[i]

    let kv  = (qi + ps) / vv
    let kvt = ps / (vv * kp)
    let ktv = ps / vt
    let kt  = ps / (vt * kp)

    let gamma_i = hi * qi / vv
    let pp  = 1.0 + hi * (kv + ks)
    let qq  = hi * kvt
    let rr  = hi * ktv
    let sb  = 1.0 + hi * (kt + ks)
    let det = pp * sb - qq * rr

    let rhs_v = (he * qi / vv) * cb_old + (1.0 - he * (kv + ks)) * cv_old + (he * kvt) * ct_old + f_v
    let rhs_t = (he * ktv) * cv_old + (1.0 - he * (kt + ks)) * ct_old + f_t

    S28Blk {
        av: (sb * rhs_v + qq * rhs_t) / det,
        bv: (sb * gamma_i) / det,
        at: (rr * rhs_v + pp * rhs_t) / det,
        bt: (rr * gamma_i) / det,
        beta: hi * qi / vb,
    }
}

fn s28_avg(p: PBPKParams28, i: i32, cv: f64, ct: f64) -> f64 with Div {
    if i == 0 { return cv }
    let vi = p.v_ref[i]
    let vf = p.vasc_frac[i]
    return (vi * vf * cv + vi * (1.0 - vf) * ct) / vi
}

// One θ-step of tangent j with forcing f_b on the blood row and (f_v, f_t) on
// organ `org`'s vascular / tissue rows (org outside 1..13: no organ forcing),
// under the model's organ sink (sink_organ, cl_sink).
// The forcings are already integrated over the step (concentration units).
// Books the step into tan.auc with the θ-method's own quadrature.
pub fn tan28_forced_step_mut(
    tan: &!Tan28, j: i32, p: PBPKParams28,
    f_b: f64, org: i32, f_v: f64, f_t: f64,
    dt: f64, theta: f64, sink_organ: i32, cl_sink: f64
) with Mut, Div {
    let off = j * 14
    // Same activation rule as the model step.
    let has_sink = sink_organ >= 1 && sink_organ < 14 && cl_sink > 0.0
    let hi = theta * dt
    let he = (1.0 - theta) * dt
    let vb = p.v_ref[0]

    var sum_q = 0.0
    var i: i32 = 1
    while i < 14 {
        sum_q = sum_q + p.q[i]
        i = i + 1
    }
    let k0 = (sum_q + p.cl_central) / vb
    let big_s = hi * k0

    let cb_old = (*tan).cv[off]
    var rhs0 = (1.0 - he * k0) * cb_old + f_b
    var sum_beta_a = 0.0
    var sum_beta_b = 0.0

    // Pass 1: blood-row reduction; book the explicit half of the quadrature.
    (*tan).auc[off] = (*tan).auc[off] + he * cb_old
    i = 1
    while i < 14 {
        let cv_old = (*tan).cv[off + i]
        let ct_old = (*tan).ct[off + i]
        let fv = if i == org { f_v } else { 0.0 }
        let ft = if i == org { f_t } else { 0.0 }
        let ks = if has_sink && i == sink_organ { cl_sink / p.v_ref[i] } else { 0.0 }
        let blk = s28_block(p, i, hi, he, cb_old, cv_old, ct_old, fv, ft, ks)
        rhs0 = rhs0 + (he * p.q[i] / vb) * cv_old
        sum_beta_a = sum_beta_a + blk.beta * blk.av
        sum_beta_b = sum_beta_b + blk.beta * blk.bv
        (*tan).auc[off + i] = (*tan).auc[off + i] + he * s28_avg(p, i, cv_old, ct_old)
        i = i + 1
    }

    let cb_new = (rhs0 + sum_beta_a) / ((1.0 + big_s) - sum_beta_b)

    // Pass 2: back-substitution (each organ reads its own old values before
    // overwriting them); book the implicit half of the quadrature.
    i = 1
    while i < 14 {
        let cv_old = (*tan).cv[off + i]
        let ct_old = (*tan).ct[off + i]
        let fv = if i == org { f_v } else { 0.0 }
        let ft = if i == org { f_t } else { 0.0 }
        let ks = if has_sink && i == sink_organ { cl_sink / p.v_ref[i] } else { 0.0 }
        let blk = s28_block(p, i, hi, he, cb_old, cv_old, ct_old, fv, ft, ks)
        let cv_new = blk.av + blk.bv * cb_new
        let ct_new = blk.at + blk.bt * cb_new
        (*tan).cv[off + i] = cv_new
        (*tan).ct[off + i] = ct_new
        (*tan).auc[off + i] = (*tan).auc[off + i] + hi * s28_avg(p, i, cv_new, ct_new)
        i = i + 1
    }
    (*tan).cv[off] = cb_new
    (*tan).auc[off] = (*tan).auc[off] + hi * cb_new
}

// What one θ-step of the model hands to the tangents: the states that enter
// any ∂A·x product, before (0) and after (1) the step.
struct S28Pair {
    cb0: f64, cb1: f64,       // blood
    lv0: f64, lv1: f64,       // liver vascular (sink organ)
    t10: f64, t11: f64,       // tissue of organs 1, 2, 3, 7 (the Kp organs)
    t20: f64, t21: f64,
    t30: f64, t31: f64,
    t70: f64, t71: f64,
}

// Path description shared by the two drivers.
struct S28Path {
    oral: bool,       // true: parameter 0 is the liver sink if one is configured, fu uses fu_ref
    sink_organ: i32,
    cl_sink: f64,
    fu_ref: f64,      // oral path only
}

// ∂cl_central/∂θ_j on the given path.
fn s28_dcl_path(prm: PBPKParams28, j: i32, path: S28Path) -> f64 with Div {
    if !path.oral { return s28_dcl(prm, j) }
    // Parameter 0 is the clearance the prior describes: the liver sink when
    // one is configured, cl_central otherwise (midazolam, haloperidol).
    if j == 0 && !(path.cl_sink > 0.0) { return 1.0 }
    if j == 1 { return 1.0 }
    if j == 2 {
        if path.fu_ref > 0.0 { return prm.cl_central / path.fu_ref }
        return 0.0
    }
    return 0.0
}

// ∂cl_sink/∂θ_j on the given path.
fn s28_dsink_path(j: i32, path: S28Path) -> f64 {
    if path.oral && j == 0 && path.cl_sink > 0.0 { return 1.0 }
    return 0.0
}

// Tangent forcing of parameter j for one θ-step, then the tangent step.
fn s28_advance_tangent(
    tan: &!Tan28, j: i32, p: PBPKParams28, x: S28Pair, path: S28Path,
    dt: f64, theta: f64
) with Mut, Div {
    let hi = theta * dt
    let he = (1.0 - theta) * dt
    let org = s28_kp_organ(j)
    if org != 0 {
        var c0 = 0.0
        var c1 = 0.0
        if org == 1 { c0 = x.t10; c1 = x.t11 }
        if org == 2 { c0 = x.t20; c1 = x.t21 }
        if org == 3 { c0 = x.t30; c1 = x.t31 }
        if org == 7 { c0 = x.t70; c1 = x.t71 }
        let vi = p.v_ref[org]
        let vf = p.vasc_frac[org]
        let vv_raw = vi * vf
        let vt_raw = vi * (1.0 - vf)
        let vv = if vv_raw < 1.0e-30 { 1.0e-30 } else { vv_raw }
        let vt = if vt_raw < 1.0e-30 { 1.0e-30 } else { vt_raw }
        let kp = p.kp[org]
        let w = he * c0 + hi * c1
        let f_v = 0.0 - (p.ps[org] / (vv * kp * kp)) * w
        let f_t = (p.ps[org] / (vt * kp * kp)) * w
        tan28_forced_step_mut(tan, j, p, 0.0, org, f_v, f_t, dt, theta, path.sink_organ, path.cl_sink)
        return
    }
    let dsink = s28_dsink_path(j, path)
    if dsink != 0.0 {
        // k_s = cl_sink / V_k multiplies C_v,k and C_t,k on their own rows.
        let vk = p.v_ref[path.sink_organ]
        let f_v = 0.0 - dsink * (he * x.lv0 + hi * x.lv1) / vk
        let f_t = 0.0 - dsink * (he * x.t10 + hi * x.t11) / vk
        tan28_forced_step_mut(tan, j, p, 0.0, path.sink_organ, f_v, f_t, dt, theta, path.sink_organ, path.cl_sink)
        return
    }
    let f_b = 0.0 - s28_dcl_path(p, j, path) * (he * x.cb0 + hi * x.cb1) / p.v_ref[0]
    tan28_forced_step_mut(tan, j, p, f_b, 0, 0.0, 0.0, dt, theta, path.sink_organ, path.cl_sink)
}

// One model θ-step (input rel_mid into blood, the path's sink) followed by
// the n tangent θ-steps that depend on it.
fn s28_substep(
    st: &!PBPKState28, tan: &!Tan28, n: i32, p: PBPKParams28, path: S28Path,
    rel_mid: f64, dt: f64, theta: f64, led: &!PBPK28Ledger
) with Mut, Div {
    let cb0 = (*st).cv[0]
    let lv0 = (*st).cv[1]
    let t10 = (*st).ct[1]
    let t20 = (*st).ct[2]
    let t30 = (*st).ct[3]
    let t70 = (*st).ct[7]
    let _sink = pbpk28_theta_step_sink_mut(st, p, rel_mid, dt, theta, path.sink_organ, path.cl_sink, led)
    let x = S28Pair {
        cb0: cb0, cb1: (*st).cv[0],
        lv0: lv0, lv1: (*st).cv[1],
        t10: t10, t11: (*st).ct[1],
        t20: t20, t21: (*st).ct[2],
        t30: t30, t31: (*st).ct[3],
        t70: t70, t71: (*st).ct[7],
    }
    var j: i32 = 0
    while j < n {
        s28_advance_tangent(tan, j, p, x, path, dt, theta)
        j = j + 1
    }
}

// Time-resolved combined standard uncertainty (the "uncertainty cone"):
// up to 64 samples of C(t) and u_c(t) for blood and for the brain organ
// average, u_c²(t) = Σ_j s_j(t)² · Var(θ_j)  (uncorrelated inputs).
pub struct EpCone28 {
    pub n:       i32,
    pub t:       [f64; 64],
    pub c_blood: [f64; 64],
    pub u_blood: [f64; 64],
    pub c_brain: [f64; 64],
    pub u_brain: [f64; 64],
}

pub struct EpTangent28 {
    pub jac:        EpJac28,
    pub cone:       EpCone28,
    pub auc_blood:  f64,        // reference AUC_blood (mg·h/L)
    pub mass_tan:   [f64; 8],   // ∂M(T)/∂θ_j (mg per parameter unit)
    pub ident:      [f64; 8],   // ∂M/∂θ_j + CL·∂AUC_b/∂θ_j + (∂CL/∂θ_j)·AUC_b
    pub steps:      i32,
}

fn s28_sqrt(x: f64) -> f64 with Mut, Div {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i: i32 = 0
    while i < 60 {
        y = 0.5 * (y + x / y)
        i = i + 1
    }
    return y
}

fn s28_finite(x: f64) -> bool {
    if x != x { return false }
    let a = if x < 0.0 { 0.0 - x } else { x }
    return a < 1.0e12
}

fn s28_fail() -> EpTangent28 {
    EpTangent28 {
        jac: EpJac28 { d_auc_b: [0.0; 8], d_cb24: [0.0; 8], d_auc_l: [0.0; 8], d_auc_k: [0.0; 8], ok: false },
        cone: EpCone28 { n: 0, t: [0.0; 64], c_blood: [0.0; 64], u_blood: [0.0; 64], c_brain: [0.0; 64], u_brain: [0.0; 64] },
        auc_blood: 0.0, mass_tan: [0.0; 8], ident: [0.0; 8], steps: 0,
    }
}

// PBPK28 run at step dt with the n tangents carried through the integrator:
// Rannacher start-up (two backward-Euler half steps on each of the first
// pbpk28_rannacher_startup_steps() steps), then clamp-free CN — the same
// marching, input and sink as ep28_simulate_dt (IV) / ep28_simulate_oral_dt
// (oral), so the tangent is the derivative of exactly the trajectory the GUM
// budget is reported for.
fn s28_run(
    dt: f64, base_prm: PBPKParams28, priors: EpPrior28, dose_mg: f64, t_end: f64,
    path: S28Path, f_abs: f64, ka: f64, rel: MatrixReleaseModel, gut0: f64
) -> EpTangent28 with Mut, Div, Panic, Epistemic {
    if !(dt > 0.0) || !s28_finite(dt) { return s28_fail() }
    if !(t_end > 0.0) || !s28_finite(t_end) { return s28_fail() }
    if t_end / dt > 1000000.0 { return s28_fail() }
    let n = priors.n
    if n < 0 || n > 8 { return s28_fail() }

    var st = pbpk28_state_zero()
    if !path.oral { st.cv[0] = dose_mg / base_prm.v_ref[0] }
    var led = pbpk28_ledger_zero()
    var tan = tan28_zero()
    let n_start = pbpk28_rannacher_startup_steps()
    var gut = gut0

    var d_cb24: [f64; 8] = [0.0; 8]
    var ct:  [f64; 64] = [0.0; 64]
    var cb:  [f64; 64] = [0.0; 64]
    var ub:  [f64; 64] = [0.0; 64]
    var cbr: [f64; 64] = [0.0; 64]
    var ubr: [f64; 64] = [0.0; 64]
    var n_s: i32 = 0
    let total = t_end / dt
    var stride: i32 = (total / 64.0) as i32
    stride = stride + 1

    var t = 0.0
    var k: i32 = 0
    var found_24h = false
    while t < t_end {
        let dt_use = if t + dt > t_end { t_end - t } else { dt }
        if !(t + dt_use > t) || k >= 1000000 { return s28_fail() }
        var rel_mid = 0.0
        if path.oral {
            gut = gut + matrix_step_amount(rel, t, dt_use)
            let frac_abs = 1.0 - exp(0.0 - ka * dt_use)
            let absorb_amt = f_abs * gut * frac_abs
            gut = gut - absorb_amt
            if gut < 0.0 { gut = 0.0 }
            rel_mid = absorb_amt / dt_use
        }
        if k < n_start {
            let half = 0.5 * dt_use
            s28_substep(&!st, &!tan, n, base_prm, path, rel_mid, half, 1.0, &!led)
            s28_substep(&!st, &!tan, n, base_prm, path, rel_mid, half, 1.0, &!led)
        } else {
            s28_substep(&!st, &!tan, n, base_prm, path, rel_mid, dt_use, 0.5, &!led)
        }
        if !s28_finite(st.cv[0]) { return s28_fail() }
        t = t + dt_use
        k = k + 1

        if found_24h == false && t >= 24.0 - 0.5 * dt_use {
            var j: i32 = 0
            while j < n {
                d_cb24[j] = s28_avg(base_prm, 3, tan.cv[j * 14 + 3], tan.ct[j * 14 + 3])
                j = j + 1
            }
            found_24h = true
        }

        if k % stride == 0 && n_s < 64 {
            var vb2 = 0.0
            var vr2 = 0.0
            var j2: i32 = 0
            while j2 < n {
                let vj = priors.kn[j2].variance
                let sb = tan.cv[j2 * 14]
                let sr = s28_avg(base_prm, 3, tan.cv[j2 * 14 + 3], tan.ct[j2 * 14 + 3])
                vb2 = vb2 + sb * sb * vj
                vr2 = vr2 + sr * sr * vj
                j2 = j2 + 1
            }
            ct[n_s]  = t
            cb[n_s]  = st.cv[0]
            ub[n_s]  = s28_sqrt(vb2)
            cbr[n_s] = s28_avg(base_prm, 3, st.cv[3], st.ct[3])
            ubr[n_s] = s28_sqrt(vr2)
            n_s = n_s + 1
        }
    }
    if led.neg_mass > pbpk28_neg_mass_bound_mg() { return s28_fail() }

    let has_sink = path.sink_organ >= 1 && path.sink_organ < 14 && path.cl_sink > 0.0
    let cl_sink_eff = if has_sink { path.cl_sink } else { 0.0 }
    var d_auc_b: [f64; 8] = [0.0; 8]
    var d_auc_l: [f64; 8] = [0.0; 8]
    var d_auc_k: [f64; 8] = [0.0; 8]
    var mass_tan: [f64; 8] = [0.0; 8]
    var ident: [f64; 8] = [0.0; 8]
    var j3: i32 = 0
    while j3 < n {
        let off = j3 * 14
        d_auc_b[j3] = tan.auc[off]
        d_auc_l[j3] = tan.auc[off + 1]
        d_auc_k[j3] = tan.auc[off + 2]
        var m = base_prm.v_ref[0] * tan.cv[off]
        var i: i32 = 1
        while i < 14 {
            let vi = base_prm.v_ref[i]
            let vf = base_prm.vasc_frac[i]
            m = m + vi * vf * tan.cv[off + i] + vi * (1.0 - vf) * tan.ct[off + i]
            i = i + 1
        }
        mass_tan[j3] = m
        var id = m + base_prm.cl_central * tan.auc[off] + s28_dcl_path(base_prm, j3, path) * led.auc[0]
        if path.oral {
            id = id + cl_sink_eff * tan.auc[off + path.sink_organ] + s28_dsink_path(j3, path) * led.auc[path.sink_organ]
        }
        ident[j3] = id
        j3 = j3 + 1
    }

    EpTangent28 {
        jac: EpJac28 { d_auc_b: d_auc_b, d_cb24: d_cb24, d_auc_l: d_auc_l, d_auc_k: d_auc_k, ok: true },
        cone: EpCone28 { n: n_s, t: ct, c_blood: cb, u_blood: ub, c_brain: cbr, u_brain: ubr },
        auc_blood: led.auc[0], mass_tan: mass_tan, ident: ident, steps: led.steps,
    }
}

fn s28_no_release() -> MatrixReleaseModel {
    matrix_korsmeyer_peppas(0.0, 0.199, 0.65)
}

// IV bolus (the ep28_run path) at step dt.
pub fn ep28_tangent_run_dt(
    dt: f64, base_prm: PBPKParams28, priors: EpPrior28, dose_mg: f64, t_end: f64
) -> EpTangent28 with Mut, Div, Panic, Epistemic {
    let path = S28Path { oral: false, sink_organ: 0, cl_sink: 0.0, fu_ref: 0.0 }
    s28_run(dt, base_prm, priors, dose_mg, t_end, path, 0.0, 0.0, s28_no_release(), 0.0)
}

// Production step of ep28_run (dt = 0.05 h).
pub fn ep28_tangent_run(
    base_prm: PBPKParams28, priors: EpPrior28, dose_mg: f64, t_end: f64
) -> EpTangent28 with Mut, Div, Panic, Epistemic {
    ep28_tangent_run_dt(0.05, base_prm, priors, dose_mg, t_end)
}

// Oral input + liver sink (the ep28_run_oral path) at step dt. Arguments as
// ep28_run_oral.
pub fn ep28_tangent_run_oral_dt(
    dt: f64, prm: PBPKParams28, priors: EpPrior28, dose_mg: f64, t_end: f64,
    oi: OralInputs28, rel: MatrixReleaseModel, fu_ref: f64, gut0: f64
) -> EpTangent28 with Mut, Div, Panic, Epistemic {
    let path = S28Path { oral: true, sink_organ: 1, cl_sink: oi.cl_form, fu_ref: fu_ref }
    s28_run(dt, prm, priors, dose_mg, t_end, path, oi.f_abs, oi.ka, rel, gut0)
}

// Production step of ep28_run_oral (dt = 0.05 h).
pub fn ep28_tangent_run_oral(
    prm: PBPKParams28, priors: EpPrior28, dose_mg: f64, t_end: f64,
    oi: OralInputs28, rel: MatrixReleaseModel, fu_ref: f64, gut0: f64
) -> EpTangent28 with Mut, Div, Panic, Epistemic {
    ep28_tangent_run_oral_dt(0.05, prm, priors, dose_mg, t_end, oi, rel, fu_ref, gut0)
}
