// stdlib/darwin_pbpk/circ28_drug_midazolam.sio — midazolam on the circ28 drug record
//
// Midazolam in a healthy adult (ICRP 89 reference male, 73 kg), intravenous and
// oral, with intestinal and hepatic CYP3A first pass. Every number is traceable
// to a row below. Abstract-level sources were opened through PubMed (E-utilities
// abstracts) on 2026-11-15; each row names its primary reference. Nothing
// here comes from memory.
//
// STATUS: 1 measured, 2 derived by a stated formula from cited measurements,
//         3 fitted to a named observable (that observable is then NOT a
//         validation of the model).
// u is the STANDARD UNCERTAINTY OF THE VALUE (what enters the budget), never an
// inter-individual SD. Where a source gives an SD of a sample of n subjects the
// uncertainty of the mean is SD / sqrt(n); where only a range is available it is
// range / sqrt(12); "assumed" marks a number with no source (a placeholder).
//
//  param    value     u        status basis of u              source
//  MW       325.8     0        1      exact formula weight    PubChem CID 4192 (dossier s.8)
//  logP     3.0       0.0586   1      range/sqrt(12) of the   Sangster via PubChem CID 4192 (3.0, measured);
//                                      three listed values     OSP Midazolam-Model.json 2.897 (fitted there,
//                                                              not a measurement); MoKa 3.1 (predicted)
//                                                              (gaps_D1 rows)
//  pKa1     5.85      0.202    2      range/sqrt(12)          mean of 5.5 (HSDB "calc", PubChem) and 6.2
//                                                              (OSP JSON, source not stated); weak base
//  pKa2     -         -        0      -                       unused
//  ion      2 (base)  0        2      -                       monoprotic base from pKa1 (< 7.4 and < 7, so
//                                                              the Rodgers-Rowland route 2 applies)
//  fu       0.0332    0.00154  1      SD of 4 published       0.034 and 0.037 (young men, young women;
//                                      means / sqrt(4)         Greenblatt 1984 Anesthesiology 61:27, PMID
//                                                              6742481), 0.0303 (Brussee 2018, PMC6096899)
//                                                              and 0.031 (Gertz 2010 via the OSP model).
//                                                              Between-study scatter, not n-weighted.
//  B:P      0.6825    0.0065   1      |0.6825-0.66|/sqrt(12)  median of literature values, Mamada 2021
//                                      (two values only; this   (PMC8342319, Table S1); 0.66 Brussee 2018
//                                      underestimates the      (PMC6096899)
//                                      scatter of the 11 values
//                                      behind the median)
//  clint    fitted    propagated 3    from u of CL_iv         FITTED to systemic plasma clearance
//                                                              22.2 L/h (below), through the kernel closed
//                                                              form circ28_splanchnic_clearance
//  clform   0         -        0      -                       no metabolite is tracked
//  clgut    fitted    propagated 3    from u of Fg            FITTED to the intestinal extraction after
//                                                              an intraduodenal dose (below)
//  clren    0         -        0      -                       ASSUMPTION: no renal clearance of unchanged
//                                                              drug (no source opened here)
//  clpla    0         -        0      -                       unused
//  kpsc     fitted    propagated 3    from u of Vss           FITTED to V_ss = 50.2 L (below)
//  pssc     1         0        0      -                       placeholder, no source (see circ28_drug.sio)
//  ka (k)   fitted    propagated 3    from u of Tmax          FITTED to the pooled oral Tmax of the dose form (below).
//                                                              Round 5: k is the rate of ONE of ntr = 4 transit stages
//                                                              (Brill 2014, PMID 25141974: three transit compartments with
//                                                              Ka = Ktr, MTT = (n+1)/Ktr = ntr/k; full text read)
//  fa       1.0       0        1      not quantified          complete absorption into the gut wall:
//                                                              Thummel 1996 (PMID 8646820, "complete oral
//                                                              absorption"), Gorski 1998 (PMID 9728893,
//                                                              urinary 1'-OH-midazolam equal after IV and
//                                                              oral dose)
//  tlag     0         -        0      -                       unused (Brill 2014: no lag, the chain replaces it)
//
// OBSERVABLES USED TO FIT (one per fitted parameter; these are NOT validations).
// Each is a POOLED estimate computed in Sounio (mdz_pool; printed by the test, section S0):
//   mean = sum n_i m_i / sum n_i;  sw = sqrt(sum (n_i-1) s_i^2 / sum (n_i-1)) over studies with an SD;
//   SE_w = sw/sqrt(N);  sb = SD of the k study means;  SE_b = sb/sqrt(k);  u = max(SE_w, SE_b).
//   CL_iv    24.22 L/h, u 2.40 L/h (k = 4, N = 58): Thummel 1996 370 +/- 114 mL/min (n 20);
//            Gorski 1998 28 +/- 9 L/h (n 16); Allonen 1981 283 +/- 43 mL/min (n 6, "+/-"
//            assumed SD); Hohmann 2015 428 mL/min [396, 462] (n 16, SD from the CI).
//   V_ss     67.1 L, u 11.65 L (k = 2, N = 22): Heizmann 1983 50.2 L (n 6, no SD in the
//            abstract); Hohmann 2015 73.5 L [62.1, 87.1] (n 16). u = SE_b (two studies).
//   Tmax     two dose forms, each fitted to its own pooled Tmax:
//            solution 0.4645 h, u 0.065 h (Hohmann 2015 0.50 h, SD = range/sqrt12; Smith 1981 0.37 h);
//            tablet   0.9291 h, u 0.094 h (Smith 1981 0.74 h, Backman 1995 1.0 h, Greenblatt 1986 1.0 h).
//            ROUND 5, ntr = 4 stages: k = 12.238730 /h (solution, MTT 0.327 h) and 5.371780 /h (tablet, MTT 0.745 h)
//            with the all-organ Kp scalar; 12.847642 and 5.509594 /h with the gut wall left at its Rodgers-Rowland
//            Kp (mdz_ka_fit), by bisection on the kernel run. Round 4 (first-order input, ntr = 1) had 1.976828 and
//            0.827927 /h (round 3: 2.157170 and 0.852464 before Fg was pooled); mdz_k_sweep keeps the k of ntr 1-5.
//            MTT validation (not fitted): Brill 2014 tablet in 20 morbidly obese patients 1.17 h, oral solution in 12
//            healthy volunteers 0.51 h (different populations).
//   Fg       0.4886, u 0.0419 (k 4, N 57): POOLED, round 4 (before: 0.57 from Paine alone). Paine 1996
//            0.57 (n 5, direct), Thummel 1996 0.57 (n 20), Gorski 1998 0.42 (n 16), Hohmann 2015 0.43
//            (n 16); the last three derive Fg from F, CL_iv and an assumed hepatic flow. See mdz_fg_studies.
//
// CLOSED FORMS USED BY THE FITS (kernel equations, tested in
// tests/run-pass/circ28_kernel_identities.sio):
//   kpsc  = (V_ss - bp V_blood) / sum_i V_i (1 - vf_i) Kp_RR,i    (circ28_kp_scale_for_vss)
//   Qg    = Q_gut bp ps_gut / (ps_gut + Q_gut bp)
//   clgut = Qg (1 - Fg) / (Fg fu)                                  (from Fg = Qg/(Qg + clgut fu))
//   Eg    = circ28_gut_extraction;  CL_blood = CL_plasma / bp
//   Eh    = (CL_blood - Q_gut Eg) / (Q_h - Q_gut Eg)                (circ28_splanchnic_clearance)
//   cl_eff = Q_h Eh / (1 - Eh);  y = bp cl_eff;  clint fu = y ps_liver / (ps_liver - y)
//   ka    = root of Tmax(ka) = Tmax_obs by bisection on the kernel run (offline;
//           the stored value is MDZ_KA_FIT and the test re-checks the Tmax it gives).
// The uncertainty of each fitted parameter is propagated from the uncertainty of
// ITS observable by central differences through these forms, conditional on the
// measured inputs (fu, bp, logP, pKa1). The budget printed by the test (mdz_budget)
// does the full job: it perturbs the four measured inputs AND the four observables
// and refits every time.
//
// WHAT IS VALIDATION (observed values below were not used for any fit; the
// criteria and expectations are written in tests/run-pass/circ28_drug_midazolam.sio)
//   IV t1/2, IV CL, Fg and Fh from other studies, intestinal extraction after an
//   IV dose, oral F, AUC, Cmax, Tmax and t1/2 after 7.5 mg, Cmax after 15 mg.

use darwin_pbpk::circ28::*
use darwin_pbpk::circ28_kp::*
use darwin_pbpk::circ28_drug::*
use math::pure::{exp, ln}

// ---- measured inputs ------------------------------------------------------
pub fn mdz_mw() -> f64 { return 325.8 }
pub fn mdz_logp() -> f64 { return 3.0 }
pub fn mdz_u_logp() -> f64 { return 0.0586 }
pub fn mdz_pka1() -> f64 { return 5.85 }
pub fn mdz_u_pka1() -> f64 { return 0.202 }
pub fn mdz_fu() -> f64 { return 0.0332 }
pub fn mdz_u_fu() -> f64 { return 0.00154 }
pub fn mdz_bp() -> f64 { return 0.6825 }
pub fn mdz_u_bp() -> f64 { return 0.0065 }

// ---- gut-wall permeability clearance (DERIVED, not measured) ----------------
// Brussee 2018 (Brussee JM et al., pediatric midazolam physiological PK model with
// gut wall; PMC6096899), Table I and Methods eq. 11: CLperm = Peff,man x A with
//   Peff,man = 4.4e-4 cm/s (midazolam; the paper takes it from its ref. 30)
//   A        = total intestinal surface area, "cut off at a maximum value of the
//              adult value of 0.66 m2" = 6600 cm2
// The paper prints no numeric CLperm; the product is done here. 1 cm3/s = 3.6 L/h.
// (The Table I footnote gives Peff,man the unit "dm/h", which does not match the cm/s of
// the table body; the cm/s value is used and the inconsistency is not resolved here.)
// u(ps_gut): the paper gives no SD for Peff or A. u is a JUDGMENT, not a measured
// spread: a factor-2 band either way, [ps/2, 2 ps], taken as a uniform range,
// u = (2 - 0.5) ps / sqrt(12). Also unchecked: whether the paper's CLperm is referred
// to plasma or to blood (the kernel's ps is plasma-referred; fu,G = 1 in the paper).
pub fn mdz_peff() -> f64 { return 4.4e-4 }            // cm/s
pub fn mdz_gut_area() -> f64 { return 6600.0 }        // cm2 (0.66 m2)
pub fn mdz_psgut() -> f64 { return mdz_peff() * mdz_gut_area() * 3.6 }   // L/h = cm3/s * 3.6
pub fn mdz_u_psgut() -> f64 { return 1.5 * mdz_psgut() / 3.4641016151377544 }

// ---- pooling of study means (done in Sounio; the test prints every table) ----
// A pooled observable is built from the healthy-adult studies that report a mean, an
// SD (when the source gives one) and n:
//   mean = sum n_i m_i / sum n_i                         (n-weighted mean of the study means)
//   sw   = sqrt( sum (n_i - 1) s_i^2 / sum (n_i - 1) )   over the studies that give an SD
//   se_w = sw / sqrt(sum n_i)                            (pooled standard error; all n_i)
//   sb   = SD of the k study means (unweighted, k - 1)   (between-study SD)
//   se_b = sb / sqrt(k)
//   u    = max(se_w, se_b)                               (the standard uncertainty used)
// A study without an SD (s_i <= 0) enters the mean and sb but not sw. sb is also the
// "between-study SD" of the distribution rows of the test.
pub struct MdzPool {
    pub mean: f64,
    pub n_tot: f64,
    pub k: i32,
    pub sw: f64,
    pub se_w: f64,
    pub sb: f64,
    pub se_b: f64,
    pub u: f64,
}

pub fn mdz_pool(m: &[f64; 8], s: &[f64; 8], n: &[f64; 8], k: i32) -> MdzPool with Mut, Div, Panic {
    var sn = 0.0
    var sm = 0.0
    var mm = 0.0
    var num = 0.0
    var den = 0.0
    var i: i32 = 0
    while i < k {
        sn = sn + (*n)[i]
        sm = sm + (*n)[i] * (*m)[i]
        mm = mm + (*m)[i]
        if (*s)[i] > 0.0 && (*n)[i] > 1.0 {
            num = num + ((*n)[i] - 1.0) * (*s)[i] * (*s)[i]
            den = den + ((*n)[i] - 1.0)
        }
        i = i + 1
    }
    let kf = k as f64
    let mbar = mm / kf
    var ss = 0.0
    i = 0
    while i < k {
        let dv = (*m)[i] - mbar
        ss = ss + dv * dv
        i = i + 1
    }
    var sb = 0.0
    if k > 1 { sb = cd_sqrt(ss / (kf - 1.0)) }
    var sw = 0.0
    if den > 0.0 { sw = cd_sqrt(num / den) }
    let se_w = sw / cd_sqrt(sn)
    let se_b = sb / cd_sqrt(kf)
    var u = se_w
    if se_b > u { u = se_b }
    return MdzPool { mean: sm / sn, n_tot: sn, k: k, sw: sw, se_w: se_w, sb: sb, se_b: se_b, u: u }
}

// SD of the individuals from a geometric mean and its 95% CI (n subjects):
// SE of ln = (ln hi - ln lo) / (2 t), SD = gm sqrt(n) SE (small-CV approximation).
// t = 2.1314 is the two-sided 5% point for 15 df (Hohmann 2015, n = 16).
pub fn mdz_sd_ci(gm: f64, lo: f64, hi: f64, n: f64) -> f64 with Mut, Div, Panic {
    return gm * cd_sqrt(n) * (ln(hi) - ln(lo)) / (2.0 * 2.1314)
}

// ---- IV plasma clearance, L/h: healthy-adult studies with mean, SD, n -------
//   0 Thummel 1996 (PMID 8646820, abstract): 370 +/- 114 mL/min (mean +/- SD), n = 20
//   1 Gorski 1998 (PMID 9728893, abstract): 28 +/- 9 L/h, n = 16 (8 M, 8 F)
//   2 Allonen 1981 CPT 30:653 (abstract as quoted in midazolam_fulltext_check.md): plasma
//     CL 283 +/- 43 mL/min, n = 6 (the "+/-" is taken to be an SD: the quoted text does not say)
//   3 Hohmann 2015 BJCP 79:278 (PMC4309633 Table 1): 1 mg IV, CL 428 [396, 462] mL/min
//     (geometric mean, 95% CI), n = 16; SD from the CI by mdz_sd_ci
// NOT pooled (reason): Heizmann 1983 323 mL/min and Lappin 2006 20.4 L/h (no SD, n not in the
// abstract), Smith 1981 0.383 +/- 0.094 L/kg/h and Greenblatt 1986 10.8-12.3 mL/min/kg (body
// weight not in the abstract), Quinney 2008 (elderly). Thummel's CL is not stated to be plasma
// or blood in the abstract; the four are treated as plasma clearances.
pub fn mdz_cl_studies(m: &![f64; 8], s: &![f64; 8], n: &![f64; 8]) -> i32 with Mut, Div, Panic {
    (*m)[0] = 370.0 * 0.06
    (*s)[0] = 114.0 * 0.06
    (*n)[0] = 20.0
    (*m)[1] = 28.0
    (*s)[1] = 9.0
    (*n)[1] = 16.0
    (*m)[2] = 283.0 * 0.06
    (*s)[2] = 43.0 * 0.06
    (*n)[2] = 6.0
    (*m)[3] = 428.0 * 0.06
    (*s)[3] = mdz_sd_ci(428.0 * 0.06, 396.0 * 0.06, 462.0 * 0.06, 16.0)
    (*n)[3] = 16.0
    return 4
}

// ---- V_ss, L ---------------------------------------------------------------
//   0 Heizmann 1983 (PMID 6138080, abstract): 50.2 L, n = 6, no SD in the abstract
//   1 Hohmann 2015 (PMC4309633 Table 1): 1 mg IV, Vss 73.5 [62.1, 87.1] L, n = 16
// NOT pooled: Lappin 2006 (V 75 L at 7.5 mg, 145 L microdose; which volume is not stated),
// Vd(area) values (Greenblatt, per kg), Quinney 2008 (elderly).
pub fn mdz_vss_studies(m: &![f64; 8], s: &![f64; 8], n: &![f64; 8]) -> i32 with Mut, Div, Panic {
    (*m)[0] = 50.2
    (*s)[0] = 0.0 - 1.0
    (*n)[0] = 6.0
    (*m)[1] = 73.5
    (*s)[1] = mdz_sd_ci(73.5, 62.1, 87.1, 16.0)
    (*n)[1] = 16.0
    return 2
}

// ---- Tmax by dose form, h: medians treated as means --------------------------------
// SOLUTION (form 0): 0 Hohmann 2015 3 mg solution: median 0.50 h, range 0.25-0.75, n = 16 (SD
// taken as range / sqrt(12)); 1 Smith 1981 (PMID 6116606): 10 mg solution 0.37 +/- 0.45 h, n = 6.
// Qiu 2024 (median 0.51 h) is left out of the fit: it is a validation row.
// TABLET (form 1): 0 Smith 1981 10 mg tablet 0.74 +/- 0.45 h, n = 6; 1 Backman 1995 (PMID
// 7582388) 15 mg, placebo phase, median 1.0 h (range 0.5-2), n = 10 (SD range / sqrt(12));
// 2 Greenblatt 1986 15 mg: 0.65, 1.45, 0.90 h on three occasions in 6 subjects, mean 1.0 h,
// no SD. Ahonen 1995 (median 1.25 h) is left out of the fit: it is a validation row.
// Formulation is stated for Smith, Hohmann and Qiu; for Backman 1995, Greenblatt 1986 and
// Ahonen 1995 the abstracts do not name it and "tablet" is an assignment (dose strength).
pub fn mdz_tmax_studies(form: i32, m: &![f64; 8], s: &![f64; 8], n: &![f64; 8]) -> i32 with Mut, Div, Panic {
    if form == 0 {
        (*m)[0] = 0.5
        (*s)[0] = 0.5 / 3.4641016151377544
        (*n)[0] = 16.0
        (*m)[1] = 0.37
        (*s)[1] = 0.45
        (*n)[1] = 6.0
        return 2
    }
    (*m)[0] = 0.74
    (*s)[0] = 0.45
    (*n)[0] = 6.0
    (*m)[1] = 1.0
    (*s)[1] = 1.5 / 3.4641016151377544
    (*n)[1] = 10.0
    (*m)[2] = 1.0
    (*s)[2] = 0.0 - 1.0
    (*n)[2] = 6.0
    return 3
}

pub fn mdz_pool_cl() -> MdzPool with Mut, Div, Panic {
    var m: [f64; 8] = [0.0; 8]
    var s: [f64; 8] = [0.0; 8]
    var n: [f64; 8] = [0.0; 8]
    let k = mdz_cl_studies(&!m, &!s, &!n)
    return mdz_pool(&m, &s, &n, k)
}

pub fn mdz_pool_vss() -> MdzPool with Mut, Div, Panic {
    var m: [f64; 8] = [0.0; 8]
    var s: [f64; 8] = [0.0; 8]
    var n: [f64; 8] = [0.0; 8]
    let k = mdz_vss_studies(&!m, &!s, &!n)
    return mdz_pool(&m, &s, &n, k)
}

pub fn mdz_pool_tmax(form: i32) -> MdzPool with Mut, Div, Panic {
    var m: [f64; 8] = [0.0; 8]
    var s: [f64; 8] = [0.0; 8]
    var n: [f64; 8] = [0.0; 8]
    let k = mdz_tmax_studies(form, &!m, &!s, &!n)
    return mdz_pool(&m, &s, &n, k)
}

// ---- observables the fits are tied to (value, standard uncertainty) -------
pub fn mdz_obs_vss() -> f64 with Mut, Div, Panic { return mdz_pool_vss().mean }          // L
pub fn mdz_u_vss() -> f64 with Mut, Div, Panic { return mdz_pool_vss().u }
pub fn mdz_obs_cl() -> f64 with Mut, Div, Panic { return mdz_pool_cl().mean }            // L/h, plasma
pub fn mdz_u_cl() -> f64 with Mut, Div, Panic { return mdz_pool_cl().u }
// ---- Fg (fraction escaping gut-wall metabolism): POOLED over every study that reports it ----
// Round 3 kept Paine alone because the studies disagree; that disagreement is between-study
// variance, which the pooling rule carries in u (SE_b), so all studies enter (round 4).
//   0 Paine 1996 (PMID 8689807, abstract): DIRECT. Intraduodenal 2 mg in liver-transplant
//     recipients, anhepatic phase, portal-systemic mass balance across the splanchnic bed:
//     fraction metabolised in the mucosa 0.43 +/- 0.18, n = 5; Fg = 0.57, SD 0.18.
//   1 Thummel 1996 (PMID 8646820, abstract): DERIVED (oral 2 mg vs IV 1 mg, separate days,
//     hepatic extraction from an assumed hepatic blood flow, EG by difference): intestinal
//     extraction 0.43 +/- 0.24, n = 20; Fg = 0.57, SD 0.24.
//   2 Gorski 1998 (PMID 9728893, abstract): DERIVED (simultaneous IV + oral 15N3, hepatic
//     availability from CL and an assumed hepatic flow): intestinal availability 0.42 +/- 0.2, n = 16.
//   3 Hohmann 2015 (PMC4309633, abstract): DERIVED (ERH = CL_iv/Q_h, Q_h = 25.4 mL/min/kg x
//     (1 - Hct); ERG from F and ERH): gut extraction ratio 0.53 [0.45, 0.63] (3 ug) and 0.61
//     [0.53, 0.70] (3 mg), the same 16 subjects; Fg = 1 - ERG = 0.47 and 0.39, the study value is
//     their mean 0.43, n = 16. SD from the 95% CI widths 0.18 and 0.17: SD = sqrt(16) x 0.175 /
//     (2 x 2.1314) = 0.164 (the CI is taken to be that of an arithmetic mean).
// Method dependence: only Paine measures the gut wall; the other three infer Fg from the oral
// F, CL_iv and an ASSUMED hepatic blood flow (and a blood/plasma conversion), so their Fg carries the
// error of that flow. The test prints the pool with and without Paine.
// NOT used: Tsunoda 1999 (PMID 10579473, abstract only: F 25% -> 80% with ketoconazole, the
// split into Fg and Fh is not in the abstract); Gertz 2010 (PMID 20368326) lists an in vivo Fg of
// 0.51 compiled from the literature, not independent of the studies above; QGut predictions
// (0.54) are model outputs. Circularity: Gorski, Hohmann and Thummel supply both an Fg here and a
// validation row (oral F); those rows are no longer independent of the fit (the test says so).
pub fn mdz_fg_studies(m: &![f64; 8], s: &![f64; 8], n: &![f64; 8]) -> i32 with Mut, Div, Panic {
    (*m)[0] = 0.57
    (*s)[0] = 0.18
    (*n)[0] = 5.0
    (*m)[1] = 0.57
    (*s)[1] = 0.24
    (*n)[1] = 20.0
    (*m)[2] = 0.42
    (*s)[2] = 0.2
    (*n)[2] = 16.0
    (*m)[3] = 0.43
    (*s)[3] = 4.0 * 0.175 / (2.0 * 2.1314)
    (*n)[3] = 16.0
    return 4
}
pub fn mdz_pool_fg() -> MdzPool with Mut, Div, Panic {
    var m: [f64; 8] = [0.0; 8]
    var s: [f64; 8] = [0.0; 8]
    var n: [f64; 8] = [0.0; 8]
    let k = mdz_fg_studies(&!m, &!s, &!n)
    return mdz_pool(&m, &s, &n, k)
}
pub fn mdz_obs_fg() -> f64 with Mut, Div, Panic { return mdz_pool_fg().mean }
pub fn mdz_u_fg() -> f64 with Mut, Div, Panic { return mdz_pool_fg().u }
pub fn mdz_obs_tmax(form: i32) -> f64 with Mut, Div, Panic { return mdz_pool_tmax(form).mean }   // h
pub fn mdz_u_tmax(form: i32) -> f64 with Mut, Div, Panic { return mdz_pool_tmax(form).u }

// Two named dose forms: 0 solution, 1 tablet. Each has its own ka, found by bisection
// (30 halvings of [0.3, 40] /h) on the kernel run with the fitted parameters; the test
// re-checks the Tmax each gives.
pub fn mdz_form_sol() -> i32 { return 0 }
pub fn mdz_form_tab() -> i32 { return 1 }

// ---- transit input (round 5) ------------------------------------------------------------
// Number of Erlang STAGES of the oral input: Brill 2014 (PMID 25141974, full text) found three transit
// compartments with Ka = Ktr, i.e. four stages here (rule 11); both dose forms use it (the paper's
// solution and tablet models share the structure and differ in Ktr).
pub fn mdz_ntr() -> i32 { return 4 }

// Gut-wall Kp variant: 0 = every organ scaled by the V_ss scalar (rounds 1-4), 1 = the gut wall left at
// its Rodgers-Rowland Kp (circ28_kp_scale_for_vss_gutrr).
pub fn mdz_gv_all() -> i32 { return 0 }
pub fn mdz_gv_gut() -> i32 { return 1 }
// The variant the record and the headline rows use (decision of round 5: see the test header and report).
pub fn mdz_gv_adopted() -> i32 { return 0 }

// Rate k (/h) of ONE stage, fitted to the pooled Tmax of the dose form by bisection on the kernel run
// (round 5, ntr = 4; mdz_fit_ka; the test re-checks the Tmax each gives).
pub fn mdz_ka_fit(form: i32, gv: i32) -> f64 {
    if gv == 0 {
        if form == 0 { return 12.238730 }   // solution: Tmax 0.4645 h
        return 5.371780                     // tablet:   Tmax 0.9291 h
    }
    if form == 0 { return 12.847642 }
    return 5.509594
}

// ---- run configuration ----------------------------------------------------
// Grid 0.05 h to 3 h, 0.5 h to 24 h (102 steps); terminal fit on 8..24 h.
pub fn mdz_cfg_oral(dose_mg: f64) -> Circ28Dose {
    return circ28_dose_oral_transit(dose_mg, mdz_ntr(), 0.05, 3.0, 0.5, 24.0, 8.0, 24.0)
}

// the same with another stage count (ntr = 1 is the first-order input of rounds 1-4)
pub fn mdz_cfg_oral_n(dose_mg: f64, ntr: i32) -> Circ28Dose {
    return circ28_dose_oral_transit(dose_mg, ntr, 0.05, 3.0, 0.5, 24.0, 8.0, 24.0)
}

// Kernel parameters of a value array for the Kp variant gv.
pub fn mdz_params_v(th: [f64; 18], gv: i32) -> Circ28Params with Mut, Div, Panic {
    var t = th
    if gv == 1 { return circ28_drug_params_theta_gutrr(t) }
    return circ28_drug_params_theta(t)
}

// Rodgers-Rowland Kp (unscaled) of a value array
pub fn mdz_kp_rr(th: [f64; 18]) -> [f64; 14] with Mut, Div, Panic {
    let kd = circ28_kp_drug(th[CD_LOGP], th[CD_PKA1], th[CD_PKA2], (th[CD_ION] + 0.5) as i32, th[CD_FU], th[CD_BP])
    return circ28_kp_rr(kd)
}

// circ28_run_theta for either Kp variant: ka (the stage rate), fa and tlag of the dose from the array.
pub fn mdz_run_theta(th: [f64; 18], dc: Circ28Dose, gv: i32) -> Circ28Run with Mut, Div, Panic {
    var d2 = dc
    d2.ka = th[CD_KA]
    d2.fa = th[CD_FA]
    d2.tlag = th[CD_TLAG]
    let p = mdz_params_v(th, gv)
    return circ28_run(p, d2)
}

// Intravenous: a bolus is an infusion over one step (0.05 h).
pub fn mdz_cfg_iv(dose_mg: f64) -> Circ28Dose {
    return circ28_dose_iv(dose_mg, 0.05, 0.05, 3.0, 0.5, 24.0, 8.0, 24.0)
}

// ---- the three closed-form fits -------------------------------------------
// Takes a value array with the measured parameters set and returns it with
// CD_KPSC, CD_CLGUT and CD_CLINT fitted to (vss, cl_plasma, fg). If a fit is
// impossible (V_ss below the blood floor, ps not above the required value) the
// returned CD_CLINT is -1.
pub fn mdz_fit(th: [f64; 18], vss: f64, cl_plasma: f64, fg: f64, gv: i32) -> [f64; 18] with Mut, Div, Panic {
    var t = th
    t[CD_KPSC] = 1.0
    t[CD_CLGUT] = 0.0
    t[CD_CLINT] = 0.0
    let p0 = mdz_params_v(t, gv)
    var sc = 0.0
    if gv == 1 {
        let kr = mdz_kp_rr(t)
        sc = circ28_kp_scale_for_vss_gutrr(p0, kr, vss)
    } else {
        sc = circ28_kp_scale_for_vss(p0, p0.kp, vss)
    }
    if !(sc > 0.0) {
        t[CD_CLINT] = 0.0 - 1.0
        return t
    }
    t[CD_KPSC] = sc
    var p = mdz_params_v(t, gv)
    let qb = p.q[8] * p.bp
    let qg = qb * p.ps[8] / (p.ps[8] + qb)
    let cg = qg * (1.0 - fg) / fg
    t[CD_CLGUT] = cg / p.fu
    p.clint_gut = t[CD_CLGUT]
    let eg = circ28_gut_extraction(p)
    let clb = cl_plasma / p.bp
    let qgeg = p.q[8] * eg
    let qh = circ28_q_hepatic(p)
    let eh = (clb - qgeg) / (qh - qgeg)
    if !(eh > 0.0) || !(eh < 1.0) {
        t[CD_CLINT] = 0.0 - 1.0
        return t
    }
    let y = p.bp * qh * eh / (1.0 - eh)
    if !(p.ps[1] > y) {
        t[CD_CLINT] = 0.0 - 1.0
        return t
    }
    t[CD_CLINT] = (y * p.ps[1] / (p.ps[1] - y)) / p.fu
    return t
}

// Central difference of one fitted component with respect to one observable.
pub fn mdz_fit_d(th: [f64; 18], vss: f64, cl: f64, fg: f64, which: i32, comp: i32, gv: i32) -> f64 with Mut, Div, Panic {
    var h = 1.0e-4
    var a = vss
    var b = vss
    var c = cl
    var e = cl
    var f = fg
    var g = fg
    if which == 0 {
        h = 1.0e-4 * vss
        a = vss + h
        b = vss - h
    }
    if which == 1 {
        h = 1.0e-4 * cl
        c = cl + h
        e = cl - h
    }
    if which == 2 {
        h = 1.0e-4 * fg
        f = fg + h
        g = fg - h
    }
    let tp = mdz_fit(th, a, c, f, gv)
    let tm = mdz_fit(th, b, e, g, gv)
    return (tp[comp] - tm[comp]) / (2.0 * h)
}

// Oral run of 1 mg (the model is linear) with a given value array; used for the
// ka slope and fit. Returns the run.
pub fn mdz_oral_run(th: [f64; 18], dose_mg: f64, gv: i32) -> Circ28Run with Mut, Div, Panic {
    return mdz_run_theta(th, mdz_cfg_oral(dose_mg), gv)
}

// dTmax/dka at the values in th (central difference, relative step 1e-3).
pub fn mdz_tmax_slope(th: [f64; 18], gv: i32) -> f64 with Mut, Div, Panic {
    var tp = th
    var tm = th
    let h = 1.0e-3 * th[CD_KA]
    tp[CD_KA] = th[CD_KA] + h
    tm[CD_KA] = th[CD_KA] - h
    let rp = mdz_oral_run(tp, 1.0, gv)
    let rm = mdz_oral_run(tm, 1.0, gv)
    return (rp.tmax - rm.tmax) / (2.0 * h)
}

// the same run with another stage count (round 5 sweep; ntr = 1 is the first-order input)
pub fn mdz_oral_run_n(th: [f64; 18], dose_mg: f64, gv: i32, ntr: i32) -> Circ28Run with Mut, Div, Panic {
    return mdz_run_theta(th, mdz_cfg_oral_n(dose_mg, ntr), gv)
}

// Bisection for the k of a chain of ntr stages (offline; the stored values are mdz_k_sweep)
pub fn mdz_fit_ka_n(th: [f64; 18], tobs: f64, lo0: f64, hi0: f64, gv: i32, ntr: i32) -> f64 with Mut, Div, Panic {
    var t = th
    var lo = lo0
    var hi = hi0
    var k: i32 = 0
    while k < 30 {
        let mid = 0.5 * (lo + hi)
        t[CD_KA] = mid
        let r = mdz_oral_run_n(t, 1.0, gv, ntr)
        if r.tmax > tobs {
            lo = mid
        } else {
            hi = mid
        }
        k = k + 1
    }
    return 0.5 * (lo + hi)
}

// Bisection for the ka with Tmax(ka) = tobs, 30 halvings of [lo, hi]
// (30 kernel runs: used offline; the stored value is mdz_ka_fit()).
pub fn mdz_fit_ka(th: [f64; 18], tobs: f64, lo0: f64, hi0: f64, gv: i32) -> f64 with Mut, Div, Panic {
    var t = th
    var lo = lo0
    var hi = hi0
    var k: i32 = 0
    while k < 30 {
        let mid = 0.5 * (lo + hi)
        t[CD_KA] = mid
        let r = mdz_oral_run(t, 1.0, gv)
        if r.tmax > tobs {
            lo = mid
        } else {
            hi = mid
        }
        k = k + 1
    }
    return 0.5 * (lo + hi)
}

// The fitting steps are separate functions: Madaros segfaults on one frame that holds
// the record plus several [f64; 18] arrays (measured 2026-11-15).
pub fn mdz_fit_record(d: &!Circ28Drug, gv: i32) with Mut, Div, Panic, Epistemic {
    let th0 = circ28_drug_theta(d)
    let vss = mdz_obs_vss()
    let cl = mdz_obs_cl()
    let fg = mdz_obs_fg()
    let th = mdz_fit(th0, vss, cl, fg, gv)
    let dk_dv = mdz_fit_d(th0, vss, cl, fg, 0, CD_KPSC, gv)
    let dg_df = mdz_fit_d(th0, vss, cl, fg, 2, CD_CLGUT, gv)
    let dc_dcl = mdz_fit_d(th0, vss, cl, fg, 1, CD_CLINT, gv)
    let dc_df = mdz_fit_d(th0, vss, cl, fg, 2, CD_CLINT, gv)
    let u_kpsc = cd_abs_m(dk_dv) * mdz_u_vss()
    let u_gut = cd_abs_m(dg_df) * mdz_u_fg()
    let ua = dc_dcl * mdz_u_cl()
    let ub = dc_df * mdz_u_fg()
    let u_int = cd_sqrt(ua * ua + ub * ub)
    circ28_drug_set(d, CD_KPSC, th[CD_KPSC], u_kpsc, CD_STATUS_FITTED, "fitted to pooled Vss (Heizmann1983, Hohmann2015); u from u(Vss)")
    circ28_drug_set(d, CD_CLGUT, th[CD_CLGUT], u_gut, CD_STATUS_FITTED, "fitted to the pooled Fg (Paine1996 direct, Thummel1996, Gorski1998, Hohmann2015 derived; mdz_pool_fg); u from u(Fg)")
    circ28_drug_set(d, CD_CLINT, th[CD_CLINT], u_int, CD_STATUS_FITTED, "fitted to pooled plasma CL (Thummel1996, Gorski1998, Allonen1981, Hohmann2015) given clgut; u from u(CL), u(Fg)")
}

// Tmax of a 1 mg oral run with the record's parameters and the given ka. One run per
// function, the value array filled in the function that runs the kernel (lean_single
// returns wrong run results from frames that hold several arrays and structs).
pub fn mdz_tmax_at(d: &Circ28Drug, ka: f64, gv: i32) -> f64 with Mut, Div, Panic, Epistemic {
    var th: [f64; 18] = [0.0; 18]
    var i: i32 = 0
    while i < 18 {
        th[i] = circ28_drug_value(d, i)
        i = i + 1
    }
    th[CD_KA] = ka
    var dc = mdz_cfg_oral(1.0)
    let r = mdz_run_theta(th, dc, gv)
    return r.tmax
}

// Sets CD_KA of the record to the ka of a dose form (0 solution, 1 tablet), with u from
// u(Tmax of the form) / |dTmax/dka|; the record then describes that form. The slope is a
// central difference, relative step 1e-3, made with one run per function.
pub fn mdz_ka_record(d: &!Circ28Drug, form: i32, gv: i32) with Mut, Div, Panic, Epistemic {
    let ka = mdz_ka_fit(form, gv)
    let h = 1.0e-3 * ka
    let tp = mdz_tmax_at(d, ka + h, gv)
    let tm = mdz_tmax_at(d, ka - h, gv)
    let slope = (tp - tm) / (2.0 * h)
    var prov = "fitted to the SOLUTION Tmax (Hohmann2015, Smith1981 pooled); u from u(Tmax) / |dTmax/dka|"
    if form == 1 {
        prov = "fitted to the TABLET Tmax (Smith1981, Backman1995, Greenblatt1986 pooled); u from u(Tmax) / |dTmax/dka|"
    }
    circ28_drug_set(d, CD_KA, ka, mdz_u_tmax(form) / cd_abs_m(slope), CD_STATUS_FITTED, prov)
}

pub fn mdz_measured_record(d: &!Circ28Drug) with Mut, Div, Panic, Epistemic {
    circ28_drug_set(d, CD_MW, mdz_mw(), 0.0, CD_STATUS_MEASURED, "PubChem CID 4192 (formula weight)")
    circ28_drug_set(d, CD_LOGP, mdz_logp(), mdz_u_logp(), CD_STATUS_MEASURED, "Sangster via PubChem CID 4192; u = range/sqrt12 of 2.897 (OSP fit), 3.0, 3.1 (MoKa)")
    circ28_drug_set(d, CD_PKA1, mdz_pka1(), mdz_u_pka1(), CD_STATUS_DERIVED, "mean of 5.5 (HSDB calc, PubChem) and 6.2 (OSP JSON); u = range/sqrt12")
    circ28_drug_set(d, CD_ION, 2.0, 0.0, CD_STATUS_DERIVED, "monoprotic weak base from pKa1")
    circ28_drug_set(d, CD_FU, mdz_fu(), mdz_u_fu(), CD_STATUS_MEASURED, "Greenblatt1984 0.034/0.037, Brussee2018 0.0303, Gertz2010 0.031; u = SD of 4 means / sqrt4")
    circ28_drug_set(d, CD_BP, mdz_bp(), mdz_u_bp(), CD_STATUS_MEASURED, "Mamada2021 median 0.6825, Brussee2018 0.66; u = diff/sqrt12")
    circ28_drug_set(d, CD_FA, 1.0, 0.0, CD_STATUS_MEASURED, "Thummel1996 complete absorption; Gorski1998 equal urinary 1-OH after IV and oral")

    circ28_drug_set(d, CD_PSGUT, mdz_psgut(), mdz_u_psgut(), CD_STATUS_DERIVED, "Brussee2018 CLperm = Peff 4.4e-4 cm/s x A 6600 cm2 (adult cap) x 3.6 = 10.45 L/h; u = factor-2 range/sqrt12 (judgment)")
}

// Fills a record made by circ28_drug_new(). There is deliberately no function that builds
// AND returns the record: on Madaros, `fn f() -> Circ28Drug { var d = ..; fit(&!d); return d }`
// segfaults at run time once the fit runs inside it (measured 2026-11-15, 18-slot record),
// while the same calls made from the caller's frame work.
pub fn mdz_drug_into(d: &!Circ28Drug, gv: i32) with Mut, Div, Panic, Epistemic {
    mdz_measured_record(d)
    mdz_fit_record(d, gv)
    mdz_ka_record(d, 0, gv)
}

fn cd_abs_m(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

// ---- budget with refit ----------------------------------------------------
// Nine inputs: 0 logP, 1 pKa1, 2 fu, 3 bp (measured), 4 V_ss, 5 CL_iv, 6 Fg,
// 7 Tmax (observables), 8 ps_gut (derived). Each evaluation refits kpsc, clgut, clint in closed form
// and ka by one chord correction on the Tmax of the kernel run, then runs the
// oral dose. u_i from the record (0..3) and the observable constants (4..7).
pub struct MdzOut {
    pub auc: f64,
    pub cmax: f64,
    pub tmax: f64,
    pub ka: f64,
}

pub fn mdz_eval(z: [f64; 9], thb: [f64; 18], ka0: f64, slope: f64, dose_mg: f64, gv: i32) -> MdzOut with Mut, Div, Panic {
    var t = thb
    t[CD_LOGP] = z[0]
    t[CD_PKA1] = z[1]
    t[CD_FU] = z[2]
    t[CD_BP] = z[3]
    t[CD_PSGUT] = z[8]
    t = mdz_fit(t, z[4], z[5], z[6], gv)
    t[CD_KA] = ka0
    let r1 = mdz_oral_run(t, dose_mg, gv)
    let ka2 = ka0 + (z[7] - r1.tmax) / slope
    t[CD_KA] = ka2
    let r2 = mdz_oral_run(t, dose_mg, gv)
    return MdzOut { auc: circ28_run_auc(r2), cmax: r2.cmax, tmax: r2.tmax, ka: ka2 }
}

pub struct MdzBudget {
    pub auc: f64,
    pub cmax: f64,
    pub var_auc: f64,
    pub var_cmax: f64,
    pub contrib_auc: [f64; 9],
    pub contrib_cmax: [f64; 9],
    pub sens_auc: [f64; 9],
    pub sens_cmax: [f64; 9],
    pub u: [f64; 9],
    pub runs: i32,
}

pub fn mdz_budget(d: &Circ28Drug, dose_mg: f64, form: i32, gv: i32) -> MdzBudget with Mut, Div, Panic, Epistemic {
    let thb = circ28_drug_theta(d)
    let ka0 = thb[CD_KA]
    let slope = mdz_tmax_slope(thb, gv)
    var z0: [f64; 9] = [0.0; 9]
    z0[0] = thb[CD_LOGP]
    z0[1] = thb[CD_PKA1]
    z0[2] = thb[CD_FU]
    z0[3] = thb[CD_BP]
    z0[4] = mdz_obs_vss()
    z0[5] = mdz_obs_cl()
    z0[6] = mdz_obs_fg()
    z0[7] = mdz_obs_tmax(form)
    z0[8] = thb[CD_PSGUT]
    var u: [f64; 9] = [0.0; 9]
    u[0] = mdz_u_logp()
    u[1] = mdz_u_pka1()
    u[2] = mdz_u_fu()
    u[3] = mdz_u_bp()
    u[4] = mdz_u_vss()
    u[5] = mdz_u_cl()
    u[6] = mdz_u_fg()
    u[7] = mdz_u_tmax(form)
    u[8] = mdz_u_psgut()
    let o0 = mdz_eval(z0, thb, ka0, slope, dose_mg, gv)
    var sa: [f64; 9] = [0.0; 9]
    var sc: [f64; 9] = [0.0; 9]
    var ca: [f64; 9] = [0.0; 9]
    var cc: [f64; 9] = [0.0; 9]
    var va = 0.0
    var vc = 0.0
    var nrun: i32 = 2 + 2
    var i: i32 = 0
    while i < 9 {
        var hs = 1.0e-4 * cd_abs_m(z0[i])
        if hs > 0.1 * u[i] { hs = 0.1 * u[i] }
        var zp = z0
        var zm = z0
        zp[i] = z0[i] + hs
        zm[i] = z0[i] - hs
        let op = mdz_eval(zp, thb, ka0, slope, dose_mg, gv)
        let om = mdz_eval(zm, thb, ka0, slope, dose_mg, gv)
        nrun = nrun + 4
        let da = (op.auc - om.auc) / (2.0 * hs)
        let dcm = (op.cmax - om.cmax) / (2.0 * hs)
        sa[i] = da
        sc[i] = dcm
        ca[i] = da * da * u[i] * u[i]
        cc[i] = dcm * dcm * u[i] * u[i]
        va = va + ca[i]
        vc = vc + cc[i]
        i = i + 1
    }
    return MdzBudget { auc: o0.auc, cmax: o0.cmax, var_auc: va, var_cmax: vc, contrib_auc: ca, contrib_cmax: cc, sens_auc: sa, sens_cmax: sc, u: u, runs: nrun }
}

// ---- distribution diagnostic (round 4; NOT a fit) ------------------------------------------
// IV 1 mg over 3 min through the kernel, stepping as circ28_run does (0.05 h to 3 h, 0.5 h to
// 12 h), with the ps scalar replaced by pssc (pssc < 0: the record's value). Fills f:
//   f[14 j + 0]      fraction of the drug still in the body that sits in blood (venous, arterial and
//                    every organ vascular space), at 4, 8, 12 h for j = 0, 1, 2
//   f[14 j + i]      the same for the tissue space of organ i (1 liver ... 13 rest)
//   f[42..45]        venous plasma concentration (mg/L) at 0.1, 0.25, 0.5 and 2 h
//   f[46]            total mass in the body (mg) at 12 h; f[47] unused
// One run per call, the array filled in this function (lean_single).
pub fn mdz_iv_dist(d: &Circ28Drug, pssc: f64, f: &![f64; 48], gv: i32) -> i32 with Mut, Div, Panic, Epistemic {
    var th: [f64; 18] = [0.0; 18]
    var i: i32 = 0
    while i < 18 {
        th[i] = circ28_drug_value(d, i)
        i = i + 1
    }
    if pssc >= 0.0 { th[CD_PSSC] = pssc }
    let p = mdz_params_v(th, gv)
    var sys = circ28_sys_zero()
    var s = circ28_state_zero()
    var el = circ28_elim_zero()
    var t = 0.0
    var ph: i32 = 0
    while ph < 2 {
        var dt = 0.05
        var tstop = 3.0
        if ph == 1 {
            dt = 0.5
            tstop = 12.0
        }
        circ28_prepare(p, dt, &!sys)
        while t + 0.5 * dt < tstop {
            let mass = circ28_iv_mass(1.0, 0.05, t, t + dt)
            circ28_step(&!s, p, &sys, mass / dt, 0.0, &!el)
            t = t + dt
            if cd_abs_m(t - 0.1) < 1.0e-6 { (*f)[42] = s.x[0] / p.bp }
            if cd_abs_m(t - 0.25) < 1.0e-6 { (*f)[43] = s.x[0] / p.bp }
            if cd_abs_m(t - 0.5) < 1.0e-6 { (*f)[44] = s.x[0] / p.bp }
            if cd_abs_m(t - 2.0) < 1.0e-6 { (*f)[45] = s.x[0] / p.bp }
            var j: i32 = 0 - 1
            if cd_abs_m(t - 4.0) < 1.0e-6 { j = 0 }
            if cd_abs_m(t - 8.0) < 1.0e-6 { j = 1 }
            if cd_abs_m(t - 12.0) < 1.0e-6 { j = 2 }
            if j >= 0 {
                let tot = circ28_total_mass(&s, p)
                var blood = 0.0
                var k: i32 = 0
                while k < 28 {
                    if k < 2 || (k - 2) % 2 == 0 {
                        blood = blood + circ28_state_volume(p, k) * s.x[k]
                    }
                    k = k + 1
                }
                (*f)[14 * j] = blood / tot
                var o: i32 = 1
                while o < 14 {
                    (*f)[14 * j + o] = circ28_state_volume(p, circ28_it(o)) * s.x[circ28_it(o)] / tot
                    o = o + 1
                }
                if j == 2 { (*f)[46] = tot }
            }
        }
        ph = ph + 1
    }
    return 0
}

// ---- record-level helpers for the two Kp variants (round 5) ----------------------------------
// Kernel parameters of the record for the variant gv.
pub fn mdz_params_rec(d: &Circ28Drug, gv: i32) -> Circ28Params with Mut, Div, Panic, Epistemic {
    let th = circ28_drug_theta(d)
    return mdz_params_v(th, gv)
}

// First-order propagation over the 18 record parameters, independent, no refit: the same algorithm
// as circ28_drug_unc_theta (JCGM 100:2008 5.1.2, central differences, h = min(1e-4 |theta|, 0.1 u)),
// with the run made for the Kp variant gv.
pub fn mdz_drug_unc(d: &Circ28Drug, dc: Circ28Dose, gv: i32) -> Circ28Unc with Mut, Div, Panic, Epistemic {
    let th = circ28_drug_theta(d)
    let vr = circ28_drug_var(d)
    let st = (*d).status
    let r0 = mdz_run_theta(th, dc, gv)
    var sa: [f64; 18] = [0.0; 18]
    var sc: [f64; 18] = [0.0; 18]
    var ca: [f64; 18] = [0.0; 18]
    var cc: [f64; 18] = [0.0; 18]
    var va = 0.0
    var vc = 0.0
    var nrun: i32 = 1
    var i: i32 = 0
    while i < 18 {
        if st[i] != 0 && vr[i] > 0.0 {
            let u = cd_sqrt(vr[i])
            var hs = 1.0e-4 * cd_abs_m(th[i])
            if hs > 0.1 * u || !(hs > 0.0) { hs = 0.1 * u }
            var tp = th
            var tm = th
            tp[i] = th[i] + hs
            tm[i] = th[i] - hs
            let rp = mdz_run_theta(tp, dc, gv)
            let rm = mdz_run_theta(tm, dc, gv)
            nrun = nrun + 2
            let da = (circ28_run_auc(rp) - circ28_run_auc(rm)) / (2.0 * hs)
            let dcm = (rp.cmax - rm.cmax) / (2.0 * hs)
            sa[i] = da
            sc[i] = dcm
            ca[i] = da * da * vr[i]
            cc[i] = dcm * dcm * vr[i]
            va = va + ca[i]
            vc = vc + cc[i]
        }
        i = i + 1
    }
    return Circ28Unc {
        auc: circ28_run_auc(r0), cmax: r0.cmax, var_auc: va, var_cmax: vc,
        sens_auc: sa, sens_cmax: sc, contrib_auc: ca, contrib_cmax: cc, runs: nrun
    }
}

// ---- stage-count sweep (round 5; gv 0, the all-organ record) --------------------------------------
// k (/h) of one stage that reproduces the pooled Tmax of the dose form for a chain of ntr stages,
// found by bisection on the kernel run (mdz_fit_ka_n, 30 halvings); ntr = 1 is the first-order ka of
// rounds 1-4, ntr = 4 the sourced stage count (Brill 2014). Used to show what the stage count does to
// the peak shape, not to choose it.
pub fn mdz_k_sweep(form: i32, ntr: i32) -> f64 {
    if form == 1 {
        if ntr == 1 { return 0.827927 }
        if ntr == 2 { return 2.455544 }
        if ntr == 3 { return 3.943083 }
        if ntr == 4 { return 5.371780 }
        return 6.766470
    }
    if ntr == 1 { return 1.976828 }
    if ntr == 2 { return 5.659914 }
    if ntr == 3 { return 9.019972 }
    if ntr == 4 { return 12.238730 }
    return 15.372520
}
