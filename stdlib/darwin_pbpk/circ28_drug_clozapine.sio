// stdlib/darwin_pbpk/circ28_drug_clozapine.sio — clozapine (oral tablet) and N-desmethylclozapine
// (norclozapine) on the circ28 drug record, coupled by circ28_metab.sio
//
// Adult, ICRP 89 reference male (73 kg) of circ28_physiology. Two records: clozapine P and norclozapine M.
// Norclozapine is formed from the parent's hepatic clform in liver tissue (sequential first pass). Clozapine
// N-oxide and the other products are NOT states: their share is the parent's clint (the non-norclozapine
// clearance).
//
// STATUS: 1 measured, 2 derived by a stated formula (or a declared prediction), 3 fitted to ONE named observable
// (which is then NOT a validation), 0 unused. u is the STANDARD UNCERTAINTY OF THE VALUE, never an inter-individual
// SD. "range/sqrt12" where only a range or several values exist; "assumed" marks a number with no source.
// ACCESS: A abstract (PubMed), F full text read in this session, L label text read (DailyMed), S secondary (value
// quoted by a paper or dossier row that was read; primary not opened), D database. Nothing is from memory.
//
// ---- CLOZAPINE (P) record -----------------------------------------------------------------------------------
//  param  value   u       st  source / access
//  MW     326.8   0       1   Lee 2021 Transl Clin Pharmacol 29:33 (PMC8020364, Table 1) [F]
//  logP   3.33    0.078   1   mean of the three experimental values 3.23 (Hansch 1995 via HSDB), 3.32 (Sangster),
//                             both PubChem CID 135398737 [D], 3.44 (El Ela 2004 via Wong 2019, PMC6590357 Table 1)
//                             [S]; u = (3.5 - 3.23)/sqrt12, the range including the Simcyp library 3.5 (Lee 2021)
//  pKa1   7.6     0.115   1   7.6 (Merck Index via HSDB [D]; label 7.57 via Wong 2019 [S]); 7.5 (El Tayar 1985 via
//                             HSDB), 7.63-7.9 (ChEMBL), 7.75 (Simcyp, Lee 2021); u = (7.9 - 7.5)/sqrt12. The second
//                             pKa 3.7 is irrelevant at pH 7.4: ionisation class 2 (monoprotic base)
//  fu     0.055   0.0072  1   Schaber 1998 Br J Clin Pharmacol 46:453 (PMID 9833598): geometric mean unbound fraction
//                             5.5 % in serum of 15 patients, equilibrium dialysis [A]; Clozaril label "approximately
//                             97 % bound" [L]; u = (0.055 - 0.03)/sqrt12
//  B:P    0.87    0.020   1   Cheng 1988 Eur J Clin Pharmacol 34:445 (PMID 3203703): equilibrium blood/plasma ratio
//                             0.87 measured, 10 patients [A]; 0.86 (Mamada 2021 median), 0.845 (Simcyp, Lee 2021 [F]),
//                             0.8 (Ghoneim 2020, PMC7166056 [F]); u = (0.87 - 0.80)/sqrt12
//  kpsc   fitted          3   to V_ss (IV)
//  clint, clform fitted   3   total hepatic intrinsic clearance to the IV CL; split phi to the steady-state
//                             norclozapine:clozapine trough ratio (below)
//  clgut  0       -       0   NO gut-wall clearance: no sourced Fg was found (gaps_D2_gut_wall.md: "clozapine Fg/Fh:
//                             not found"). The first pass of this record is HEPATIC ONLY. Consequence (tested, and it
//                             FAILS): F = fa (1 - Eh) = 0.85 against the observed 0.27 (Cheng 1988).
//  clren  derived         2   0.11 x CLcr x fu: renal clearance of UNBOUND clozapine is 11 % of creatinine clearance
//                             (Schaber 1998 [A]); CLcr below
//  fa     1.0     0.058   1   Dain 1997 Drug Metab Dispos 25:603 (PMID 9152600) [A]: after 50 mg [14C]clozapine about 50 %
//                             of the radioactivity in urine and 30 % in faeces, parent a MINOR component of the
//                             excreta, the main faecal component a metabolite (N-glucuronide): absorption is taken
//                             as complete; u = (1 - 0.8)/sqrt12 (0.8 = recovered radioactivity)
//  ka     fitted          3   to the steady-state Tmax
//  pssc   1       -       0   placeholder (flow-limited default 20 x Q). NOT fitted (x0.1 moves the IV half-life by 4 %;
//                             10.3 h would need 0.009 x default, test D2): the terminal half-life is kept
//                             as a validation row (lesson 3: ps is a rate parameter)
//
// ---- NORCLOZAPINE (M) record ---------------------------------------------------------------------------------
//  MW     312.8   0       1   PubChem CID 135409468 [D]
//  logP   3.07    0.2     1   El Ela 2004 (J Pharm Pharmacol 56:967, PMID 15285840) as quoted by Wong 2019 Table 1 [S];
//                             u 0.2 ASSUMED (single value)
//  pKa1   8.9     0.3     1   ChEMBL via PubChem CID 135409468, method not stated [D]; u 0.3 ASSUMED
//  fu     0.097   0.012   1   Schaber 1998 [A]: geometric mean 9.7 %, 15 patients; u ASSUMED (the abstract gives no
//                             spread; the same relative u as clozapine's)
//  B:P    0.87    0.10    0   NOT FOUND for norclozapine (gaps_D1, physchem_dossier s.20). ASSUMPTION: equal to
//                             clozapine's; u 0.10 assumed. Status 2 in the record (it must hold a value), flagged here.
//  kpsc   1.0     -       2   A PREDICTION, declared: Rodgers-Rowland with scalar 1 (V_ss,M = 182 L). No human
//                             volume of norclozapine exists: it was dosed to humans as ACP-104 (NCT00628420), but
//                             no pharmacokinetic number was published (a press report gives none)
//  clren  derived         2   3.0 x CLcr x fu_M: renal clearance of UNBOUND norclozapine is 300 % of creatinine
//                             clearance (Schaber 1998 [A])
//  clint  fitted          3   total CL_M to the pooled norclozapine half-life, minus the renal part
//
// ---- POOLED OBSERVABLES (project rule, clz_pool: n-weighted mean of the study means; u = max(pooled SE,
//      between-study SD/sqrt(k)); a study without SD enters the mean and the between-study SD) -----------------
//  (0) FLUVOXAMINE exposure ratio of clozapine (with/without), FITTED observable of the CYP1A2 share:
//        3.0   n 16  Wetzel 1998 J Clin Psychopharmacol 18:2 (PMID 9472836), 50 mg/day, trough, patients [A]
//        2.3   n 18  Lu 2000 J Clin Psychiatry 61:594 (PMID 10982203), 50 mg/day, trough [A]
//        2.58  n 9   Chang 1999 Psychopharmacology 145:91 (PMID 10445377), 50 mg b.i.d., single-dose AUC [A]
//        4.55  n 9   Wang 2004 J Clin Pharmacol 44:785 (PMID 15199083), 100 mg/day, healthy men, from "CL/F
//                    reduced by 78 %" (1/0.22); the same abstract gives AUC +41 % (truncated sampling) [A]
//        7.5   n 2   Jerling 1994 Ther Drug Monit 16:368 (PMID 7974626), "factor of 5-10", mid-range [A]
//        7.5   n 2   Koponen 1996 Eur Neuropsychopharmacol 6:69 (PMID 8866941), "factor of 5-10", mid-range [A]
//      NOT pooled: Szegedi 1999 (PMID 10505485, "2-3 fold", n 16, the Wetzel group and probably its patients).
//      Trough ratios and AUC ratios are pooled as one "exposure ratio" (an approximation: the model's trough
//      ratio is printed as a consistency row).
//  (1) NON-SMOKER / SMOKER dose-normalised clozapine concentration, VALIDATION:
//        1.36  n 23516 Flanagan 2023 J Clin Psychopharmacol 43:131 (PMID 36735578), UK TDM, "dose increased by
//                      36 % in smokers" [A]; Rostami-Hodjegan 2004 (PMID 14709950, +48 %) is the same service
//        2.0   n 196   Tsuda 2014 BMJ Open 4:e004216 (PMC3948577) meta-analysis of 4 studies [F]: their dose
//                      equivalence 200 vs 100 mg/day; the paper reports a mean C/D difference, -1.11 (ng/mL)/(mg/day)
//        1.45  n 162   Li 2012 Acta Pharmacol Sin 33:1409 (PMID 22820910), CL +45 % [A]
//        1.33  n 197   Ng 2009 Ther Drug Monit 31:360 (PMID 19349931), (18.0 + 6.0)/18.0 L/h [A]
//        1.67  n 44    Seppala 1999 Pharmacol Toxicol 85:244 (PMID 10608488), "about 40 % lower" [A]
//        1.72  n 11    Meyer 2001 J Clin Psychopharmacol 21:569 (PMID 11763003), within-subject cessation [A]
//        1.47  n 30    Wetzel 1998, "lower by 32 %" [A]
//        1.52  n 18    Lu 2000, "34 % lower" [A]
//        1.32  n 98    Olmos 2019 Biomed Res Int 3163502 (PMID 30956977), CL/F +32 % [A]
//  (2) NORCLOZAPINE:CLOZAPINE steady-state plasma ratio (trough, TDM), FITTED observable of the split phi:
//        0.758 n 23516 UK TDM service: clozapine:norclozapine 1.32 (Flanagan 2023; Rostami-Hodjegan 2004) [A]
//        0.451 n 45    Spina 2000 Psychopharmacology 148:83 (PMID 10663421), n-weighted means 174/386 ng/mL [A]
//        0.670 n 162   Li 2012, 21.9/32.7 L/h (female non-smokers) [A]
//        0.462 n 197   Ng 2009, 18.0/39.0 L/h [A]
//        0.653 n 98    Olmos 2019, 275/421 ng/mL [A]
//      Smoking does not change this ratio (Wagner 2020 Acta Psychiatr Scand 142:456, PMID 32869278, 5 studies,
//      SMD 0.00 [F]), which is why cohorts of mixed smoking habit are pooled.
//  (3) NORCLOZAPINE half-life (h), FITTED observable of CL_M:
//        19.2  n 8     Guitton 1999 J Clin Pharmacol 39:721 (PMID 10392327) [A]
//        13.2  n 162   Li 2012, ln2 x 624 L / 32.7 L/h (one-compartment population model) [A]
//  (4) STEADY-STATE Tmax (h), 100 mg b.i.d., FITTED observable of ka (n unknown for four: all weights 1):
//        2.74 Lee 2021 (Korean patients, n 23) [F]; 1.97 Tassaneeyakul, 2.0 Golden and Honigfeld 2008, 1.93
//        Sramek (all three as quoted in Lee 2021 Table 3 [S]); 2.5 Clozaril label [L]
//  (5) STEADY-STATE AUC0-12 (ng h/mL), 100 mg b.i.d., VALIDATION: 4641, 3994, 3443, 2781 (same four studies)
//  (6) STEADY-STATE Cmax (ng/mL), 100 mg b.i.d., VALIDATION: 541.3, 551.3, 455.5, 358 (same four), 319 (label)
//  (7) CREATININE CLEARANCE (mL/min) of healthy adults: the values of the vancomycin module of this layer
//      (circ28_drug_vancomycin.sio, va_tab_clcr): 138 n 4, 110 n 11, 92.7 n 10, 117 n 9, 117.9 n 8 [S]. Schaber's
//      own patients' creatinine clearance is not in the abstract.
//
// ---- SINGLE-STUDY OBSERVABLES --------------------------------------------------------------------------------
//  P V_ss   116.8 L = 1.6 L/kg x 73 kg, u 23.4 L.  Cheng 1988 [A], 10 male patients, intravenous. The abstract
//           gives no SD: u = 20 % ASSUMED. The body weight of the patients is not in the abstract.
//  P CL     13.05 L/h plasma = 250 mL/min BLOOD clearance x 0.87 (B:P), u 2.6 L/h (20 % ASSUMED; the abstract
//           says only "large inter-individual variability"). Cheng 1988 [A].
//           THE POOL OF INTRAVENOUS STUDIES HAS k = 1: Choc 1987 (PMID 3508549) and Choc 1990 (PMID 2194198) are
//           ORAL studies (abstracts read), and the Jann 1993 review (PMID 8453823) ranges (CL 8.7-53.3 L/h, V
//           1.6-7.3 L/kg) mix apparent oral values. No second intravenous study was found.
//  INPUT CONSISTENCY (lesson 2): V_ss ln2 / CL = 6.20 h against the terminal half-life 10.3 h (Cheng 1988) and
//           8 h (label, single dose): the terminal half-life is longer, so the inputs leave room for a
//           distribution phase. Printed by the test before any run.
//  fluvoxamine: residual CYP1A2 activity r = 1/(1 + Iu/Ki) = 0.090, u 0.064. Iu = 0.23 x 0.13 umol/L = 30 nmol/L:
//           83 ng/mL total at 100 mg/day (Hiemke 2002, PMID 12352274 [A], perpetrator_parameters.md A5), halved
//           for 50 mg/day (ASSUMED proportional), fu 0.23 (Claassen 1983 via the OSP fluvoxamine model [S]);
//           Ki 2.97 nmol/L unbound (Kanacher 2020, PMID 33302490 [S]); u from the Ki range 0.87-10 nmol/L
//           (r 0.028 to 0.25)/sqrt12.
//  smoking: CYP1A2 activity 1.55-fold in smokers (paraxanthine:caffeine, 194 smokers; Dobrinas 2011 Clin Pharmacol
//           Ther 90:117, PMID 21593735 [A]); u 0.167 = (1.81 - 1.23)/sqrt12 from the abundance ratios 64/52 to
//           94/52 of Plowchalk 2012 (PMID 22258279 [A]). Used for the VALIDATION row only.
//
// ---- STRUCTURE OF THE HEPATIC CLEARANCE ----------------------------------------------------------------------
//   tot = clint + clform (unbound intrinsic, L/h), fitted to the intravenous CL.
//   clform = phi tot (N-demethylation), clint = (1 - phi) tot (N-oxidation, hydroxylation, glucuronidation).
//   f1A2 = share of tot carried by CYP1A2, fitted to the fluvoxamine ratio:
//          (CL/F)/(CL/F)_fluvoxamine = R, tot_fluvoxamine = tot (1 - f1A2 (1 - r)).
//   ASSUMPTION WITH NO SOURCE (kept visible): CYP1A2 and the other enzymes form norclozapine in the SAME
//   proportion phi, so a change of CYP1A2 activity scales clint and clform alike. Its consequence is tested
//   (norclozapine:clozapine ratio in smokers, norclozapine under fluvoxamine).
//   Fluvoxamine also inhibits CYP2C19 (Ki 2.6 nmol/L) and weakly CYP3A4: f1A2 is the FLUVOXAMINE-SENSITIVE share,
//   an upper bound of the CYP1A2 share.
//   WHY NOT THE SMOKING RATIO: with the sourced induction 1.55 the pooled ratio 1.37-1.54 needs
//   f1A2 = (ratio - 1)/0.55 = 0.67 to 0.98; the unweighted pool gives a share at the edge of 1. The fluvoxamine
//   contrast is the larger effect and bounds f1A2 below 1, so it is the fitted observable; smoking validates.
//
// ---- IDENTIFIABILITY OF THE METABOLITE (stated, not hidden) --------------------------------------------------
//   Only CL_M/V_ss,M (the half-life) and phi/CL_M (the ratio) are identified; V_ss,M is a prediction (scalar 1).
//   If V_ss,M is wrong by a factor x, CL_M and phi are wrong by the same factor. Lin 1994 (PMID 8006199) states
//   that norclozapine elimination is rate-limited by its formation: then the observed norclozapine half-life is
//   the parent's and CL_M (hence phi) is only a LOWER bound. phi <= 1 bounds CL_M from above.
//
// CLOSED FORMS (kernel identities): kpsc = (V_ss - bp V_blood)/sum V_i (1 - vf_i) Kp_i; CL_hep = CL - cl_renal;
//   Eh = CL_hep/(bp Qh); y = CL_hep/(1 - Eh); tot fu = y ps_liver/(ps_liver - y).
//
// OFFLINE FITS stored as constants and re-checked by the test: ka (steady-state Tmax), CL_M (norclozapine
// half-life) and phi (steady-state trough ratio; the ratio is exactly linear in phi at fixed tot).

use darwin_pbpk::circ28::*
use darwin_pbpk::circ28_kp::*
use darwin_pbpk::circ28_drug::*
use darwin_pbpk::circ28_metab::*
use math::pure::{exp, ln}

// ---- measured inputs -------------------------------------------------------------------------------
pub fn clz_p_mw() -> f64 { return 326.8 }
pub fn clz_p_logp() -> f64 { return 3.33 }
pub fn clz_p_u_logp() -> f64 { return 0.078 }
pub fn clz_p_pka() -> f64 { return 7.6 }
pub fn clz_p_u_pka() -> f64 { return 0.115 }
pub fn clz_p_fu() -> f64 { return 0.055 }
pub fn clz_p_u_fu() -> f64 { return 0.0072 }
pub fn clz_p_bp() -> f64 { return 0.87 }
pub fn clz_p_u_bp() -> f64 { return 0.020 }
pub fn clz_p_fa() -> f64 { return 1.0 }
pub fn clz_p_u_fa() -> f64 { return 0.058 }
pub fn clz_m_mw() -> f64 { return 312.8 }
pub fn clz_m_logp() -> f64 { return 3.07 }
pub fn clz_m_u_logp() -> f64 { return 0.2 }
pub fn clz_m_pka() -> f64 { return 8.9 }
pub fn clz_m_u_pka() -> f64 { return 0.3 }
pub fn clz_m_fu() -> f64 { return 0.097 }
pub fn clz_m_u_fu() -> f64 { return 0.012 }
pub fn clz_m_bp() -> f64 { return 0.87 }
pub fn clz_m_u_bp() -> f64 { return 0.10 }

// Schaber 1998: renal clearance of the unbound compound as a multiple of creatinine clearance.
pub fn clz_p_ren_mult() -> f64 { return 0.11 }
pub fn clz_m_ren_mult() -> f64 { return 3.0 }

// Cheng 1988 (intravenous, n 10): V_ss L/kg, blood clearance mL/min, terminal half-life h, F.
pub fn clz_bw() -> f64 { return 73.0 }
pub fn clz_obs_vss() -> f64 { return 1.6 * clz_bw() }
pub fn clz_u_vss() -> f64 { return 0.2 * clz_obs_vss() }
pub fn clz_obs_cl() -> f64 { return 250.0 * 0.06 * clz_p_bp() }
pub fn clz_u_cl() -> f64 { return 0.2 * clz_obs_cl() }
pub fn clz_obs_t12_iv() -> f64 { return 10.3 }
pub fn clz_obs_f() -> f64 { return 0.27 }

// Fluvoxamine: residual CYP1A2 activity; smoking: CYP1A2 induction fold.
pub fn clz_fvx_iu_nm() -> f64 { return 0.23 * 0.5 * 83.0 / 318.335 * 1000.0 }
pub fn clz_fvx_ki_nm() -> f64 { return 2.97 }
pub fn clz_fvx_r() -> f64 { return 1.0 / (1.0 + clz_fvx_iu_nm() / clz_fvx_ki_nm()) }
pub fn clz_u_fvx_r() -> f64 { return 0.064 }
pub fn clz_smoke_fold() -> f64 { return 1.55 }
pub fn clz_u_smoke_fold() -> f64 { return 0.167 }

// ---- pooling (the project rule; same arithmetic as va_pool of the vancomycin module) ---------------
// out: [0] n-weighted mean, [1] N, [2] sw, [3] SE_w, [4] sb, [5] SE_b, [6] u, [7] k, [8] unweighted mean
pub fn clz_pool(m: &[f64; 12], s: &[f64; 12], n: &[f64; 12], k: i32, out: &![f64; 12]) with Mut, Div {
    var sn = 0.0
    var sm = 0.0
    var mm = 0.0
    var num = 0.0
    var den = 0.0
    var i: i32 = 0
    while i < k {
        sn = sn + (*n)[i]
        sm = sm + (*n)[i] * (*m)[i]
        mm = mm + (*m)[i]
        if (*s)[i] > 0.0 && (*n)[i] > 1.0 {
            num = num + ((*n)[i] - 1.0) * (*s)[i] * (*s)[i]
            den = den + ((*n)[i] - 1.0)
        }
        i = i + 1
    }
    let kf = k as f64
    let mbar = mm / kf
    var ss = 0.0
    i = 0
    while i < k {
        let dv = (*m)[i] - mbar
        ss = ss + dv * dv
        i = i + 1
    }
    var sb = 0.0
    if k > 1 { sb = cd_sqrt(ss / (kf - 1.0)) }
    var sw = 0.0
    if den > 0.0 { sw = cd_sqrt(num / den) }
    let se_w = sw / cd_sqrt(sn)
    let se_b = sb / cd_sqrt(kf)
    var u = se_w
    if se_b > u { u = se_b }
    (*out)[0] = sm / sn
    (*out)[1] = sn
    (*out)[2] = sw
    (*out)[3] = se_w
    (*out)[4] = sb
    (*out)[5] = se_b
    (*out)[6] = u
    (*out)[7] = kf
    (*out)[8] = mbar
}

// Study tables. which: 0 fluvoxamine ratio, 1 non-smoker/smoker ratio, 2 norclozapine:clozapine ratio,
// 3 norclozapine half-life (h), 4 steady-state Tmax (h), 5 steady-state AUC0-12 (ng h/mL), 6 steady-state
// Cmax (ng/mL), 7 creatinine clearance (mL/min). Returns k.
pub fn clz_tab(which: i32, m: &![f64; 12], s: &![f64; 12], n: &![f64; 12]) -> i32 with Mut, Div {
    var i: i32 = 0
    while i < 12 {
        (*m)[i] = 0.0
        (*s)[i] = 0.0
        (*n)[i] = 1.0
        i = i + 1
    }
    if which == 0 {
        (*m)[0] = 3.0
        (*n)[0] = 16.0
        (*m)[1] = 2.3
        (*n)[1] = 18.0
        (*m)[2] = 2.58
        (*n)[2] = 9.0
        (*m)[3] = 1.0 / 0.22
        (*n)[3] = 9.0
        (*m)[4] = 7.5
        (*n)[4] = 2.0
        (*m)[5] = 7.5
        (*n)[5] = 2.0
        return 6
    }
    if which == 1 {
        (*m)[0] = 1.36
        (*n)[0] = 23516.0
        (*m)[1] = 2.0
        (*n)[1] = 196.0
        (*m)[2] = 1.45
        (*n)[2] = 162.0
        (*m)[3] = 24.0 / 18.0
        (*n)[3] = 197.0
        (*m)[4] = 1.0 / 0.6
        (*n)[4] = 44.0
        (*m)[5] = 1.719
        (*n)[5] = 11.0
        (*m)[6] = 1.0 / 0.68
        (*n)[6] = 30.0
        (*m)[7] = 1.0 / 0.66
        (*n)[7] = 18.0
        (*m)[8] = 1.32
        (*n)[8] = 98.0
        return 9
    }
    if which == 2 {
        (*m)[0] = 1.0 / 1.32
        (*n)[0] = 23516.0
        (*m)[1] = (201.0 * 18.0 + 156.0 * 27.0) / (472.0 * 18.0 + 328.0 * 27.0)
        (*n)[1] = 45.0
        (*m)[2] = 21.9 / 32.7
        (*n)[2] = 162.0
        (*m)[3] = 18.0 / 39.0
        (*n)[3] = 197.0
        (*m)[4] = 275.0 / 421.0
        (*n)[4] = 98.0
        return 5
    }
    if which == 3 {
        (*m)[0] = 19.2
        (*n)[0] = 8.0
        (*m)[1] = 0.6931471805599453 * 624.0 / 32.7
        (*n)[1] = 162.0
        return 2
    }
    if which == 4 {
        (*m)[0] = 2.74
        (*m)[1] = 1.97
        (*m)[2] = 2.0
        (*m)[3] = 1.93
        (*m)[4] = 2.5
        return 5
    }
    if which == 5 {
        (*m)[0] = 4641.0
        (*m)[1] = 3994.0
        (*m)[2] = 3443.0
        (*m)[3] = 2781.0
        return 4
    }
    if which == 6 {
        (*m)[0] = 541.3
        (*m)[1] = 551.3
        (*m)[2] = 455.5
        (*m)[3] = 358.0
        (*m)[4] = 319.0
        return 5
    }
    (*m)[0] = 138.0
    (*s)[0] = 28.0
    (*n)[0] = 4.0
    (*m)[1] = 110.0
    (*s)[1] = 19.3
    (*n)[1] = 11.0
    (*m)[2] = 92.7
    (*n)[2] = 10.0
    (*m)[3] = 117.0
    (*s)[3] = 27.0
    (*n)[3] = 9.0
    (*m)[4] = 117.9
    (*n)[4] = 8.0
    return 5
}

pub fn clz_pool_of(which: i32, out: &![f64; 12]) with Mut, Div {
    var m: [f64; 12] = [0.0; 12]
    var s: [f64; 12] = [0.0; 12]
    var n: [f64; 12] = [0.0; 12]
    let k = clz_tab(which, &!m, &!s, &!n)
    clz_pool(&m, &s, &n, k, out)
}

pub fn clz_pool_mean(which: i32) -> f64 with Mut, Div {
    var o: [f64; 12] = [0.0; 12]
    clz_pool_of(which, &!o)
    return o[0]
}

pub fn clz_pool_u(which: i32) -> f64 with Mut, Div {
    var o: [f64; 12] = [0.0; 12]
    clz_pool_of(which, &!o)
    return o[6]
}

pub fn clz_pool_sb(which: i32) -> f64 with Mut, Div {
    var o: [f64; 12] = [0.0; 12]
    clz_pool_of(which, &!o)
    return o[4]
}

// Creatinine clearance (L/h) and its u (pool of the studies of the vancomycin module).
pub fn clz_clcr() -> f64 with Mut, Div { return clz_pool_mean(7) * 0.06 }
pub fn clz_u_clcr() -> f64 with Mut, Div { return clz_pool_u(7) * 0.06 }

// Observables of the fits (pooled).
pub fn clz_obs_fvx() -> f64 with Mut, Div { return clz_pool_mean(0) }
pub fn clz_u_fvx() -> f64 with Mut, Div { return clz_pool_u(0) }
pub fn clz_obs_ncratio() -> f64 with Mut, Div { return clz_pool_mean(2) }
pub fn clz_u_ncratio() -> f64 with Mut, Div { return clz_pool_u(2) }
pub fn clz_obs_m_t12() -> f64 with Mut, Div { return clz_pool_mean(3) }
pub fn clz_u_m_t12() -> f64 with Mut, Div { return clz_pool_u(3) }
pub fn clz_obs_tmax_ss() -> f64 with Mut, Div { return clz_pool_mean(4) }
pub fn clz_u_tmax_ss() -> f64 with Mut, Div { return clz_pool_u(4) }

// ---- offline fits (kernel runs; the test re-checks each) ----------------------------------------------
// ka (1/h): steady-state Tmax of 100 mg b.i.d. on the grid of clz_run_th = clz_obs_tmax_ss().
// Measured offline (secant, 8 steps): ka 0.461562, CL_M 9.727672, phi 0.350623.
pub fn clz_ka_fit() -> f64 { return 0.461562 }
// CL_M (L/h, plasma, total): terminal half-life of norclozapine = clz_obs_m_t12().
pub fn clz_m_cl_fit() -> f64 { return 9.727672 }
// phi = clform/(clint + clform): steady-state trough ratio norclozapine/clozapine = clz_obs_ncratio().
pub fn clz_phi_fit() -> f64 { return 0.350623 }

fn clz_abs(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

// ---- the fits -------------------------------------------------------------------------------------------
// Clozapine: Kp scalar to V_ss; cl_renal given; total hepatic intrinsic clearance to CL; split phi.
// CD_CLINT = -1 if a fit is impossible.
pub fn clz_fit_p(th: [f64; 18], vss: f64, cl: f64, clren: f64, phi: f64) -> [f64; 18] with Mut, Div, Panic {
    var t = th
    t[CD_KPSC] = 1.0
    t[CD_CLINT] = 0.0
    t[CD_CLFORM] = 0.0
    t[CD_CLREN] = 0.0
    let p0 = circ28_drug_params_theta(t)
    let sc = circ28_kp_scale_for_vss(p0, p0.kp, vss)
    if !(sc > 0.0) {
        t[CD_CLINT] = 0.0 - 1.0
        return t
    }
    t[CD_KPSC] = sc
    let p = circ28_drug_params_theta(t)
    let bb = p.bp * circ28_q_hepatic(p)
    let clh = cl - clren
    let eh = clh / bb
    if !(eh > 0.0) || !(eh < 1.0) {
        t[CD_CLINT] = 0.0 - 1.0
        return t
    }
    let y = clh / (1.0 - eh)
    if !(p.ps[1] > y) {
        t[CD_CLINT] = 0.0 - 1.0
        return t
    }
    let tot = (y * p.ps[1] / (p.ps[1] - y)) / p.fu
    t[CD_CLREN] = clren
    t[CD_CLFORM] = phi * tot
    t[CD_CLINT] = (1.0 - phi) * tot
    return t
}

// Norclozapine: Kp scalar 1 (prediction); cl_renal given; hepatic intrinsic clearance to CL_M - cl_renal.
pub fn clz_fit_m(th: [f64; 18], cl: f64, clren: f64) -> [f64; 18] with Mut, Div, Panic {
    var t = th
    t[CD_KPSC] = 1.0
    t[CD_CLINT] = 0.0
    t[CD_CLFORM] = 0.0
    t[CD_CLREN] = 0.0
    let p = circ28_drug_params_theta(t)
    let bb = p.bp * circ28_q_hepatic(p)
    let clh = cl - clren
    let eh = clh / bb
    if !(eh > 0.0) || !(eh < 1.0) {
        t[CD_CLINT] = 0.0 - 1.0
        return t
    }
    let y = clh / (1.0 - eh)
    if !(p.ps[1] > y) {
        t[CD_CLINT] = 0.0 - 1.0
        return t
    }
    t[CD_CLREN] = clren
    t[CD_CLINT] = (y * p.ps[1] / (p.ps[1] - y)) / p.fu
    return t
}

// Closed forms of a record array: hepatic extraction, oral bioavailability, plasma clearance, CL/F.
pub fn clz_eh(th: [f64; 18]) -> f64 with Mut, Div, Panic {
    var tl = th
    let p = circ28_drug_params_theta(tl)
    return circ28_hepatic_extraction(p)
}

pub fn clz_f_oral(th: [f64; 18]) -> f64 with Mut, Div, Panic {
    var tl = th
    let p = circ28_drug_params_theta(tl)
    return th[CD_FA] * circ28_gut_availability(p) * (1.0 - circ28_hepatic_extraction(p))
}

pub fn clz_cl(th: [f64; 18]) -> f64 with Mut, Div, Panic {
    var tl = th
    let p = circ28_drug_params_theta(tl)
    return circ28_hepatic_extraction(p) * circ28_q_hepatic(p) * p.bp + th[CD_CLREN]
}

pub fn clz_cl_over_f(th: [f64; 18]) -> f64 with Mut, Div, Panic {
    return clz_cl(th) / clz_f_oral(th)
}

// The record array with the hepatic intrinsic clearances (clint and clform) multiplied by s.
pub fn clz_scale_hep(th: [f64; 18], s: f64) -> [f64; 18] with Mut {
    var t = th
    t[CD_CLINT] = s * th[CD_CLINT]
    t[CD_CLFORM] = s * th[CD_CLFORM]
    return t
}

// s in (0, 1) with (CL/F)(th) / (CL/F)(th scaled by s) = ratio; bisection on the closed form.
pub fn clz_solve_scale(th: [f64; 18], ratio: f64) -> f64 with Mut, Div, Panic {
    let target = clz_cl_over_f(th) / ratio
    var lo = 0.0
    var hi = 1.0
    var k: i32 = 0
    while k < 50 {
        let mid = 0.5 * (lo + hi)
        if clz_cl_over_f(clz_scale_hep(th, mid)) > target {
            hi = mid
        } else {
            lo = mid
        }
        k = k + 1
    }
    return 0.5 * (lo + hi)
}

// CYP1A2 (fluvoxamine-sensitive) share of the hepatic intrinsic clearance from the fluvoxamine ratio R and
// the residual CYP1A2 activity r: s = 1 - f (1 - r).
pub fn clz_f1a2(th: [f64; 18], ratio: f64, r: f64) -> f64 with Mut, Div, Panic {
    let s = clz_solve_scale(th, ratio)
    return (1.0 - s) / (1.0 - r)
}

// Multipliers of the hepatic intrinsic clearance in the two CYP1A2 scenarios.
pub fn clz_scale_fvx(f1a2: f64, r: f64) -> f64 { return 1.0 - f1a2 * (1.0 - r) }
pub fn clz_scale_smoke(f1a2: f64, fold: f64) -> f64 { return 1.0 + f1a2 * (fold - 1.0) }

// ---- records ----------------------------------------------------------------------------------------------
pub fn clz_measured_p(d: &!Circ28Drug) with Mut, Div, Panic, Epistemic {
    circ28_drug_set(d, CD_MW, clz_p_mw(), 0.0, CD_STATUS_MEASURED, "Lee2021 PMC8020364 Table 1")
    circ28_drug_set(d, CD_LOGP, clz_p_logp(), clz_p_u_logp(), CD_STATUS_MEASURED, "mean of 3.23 Hansch, 3.32 Sangster (PubChem), 3.44 ElEla2004 (Wong2019); u = range/sqrt12")
    circ28_drug_set(d, CD_PKA1, clz_p_pka(), clz_p_u_pka(), CD_STATUS_MEASURED, "7.6 Merck via HSDB, label 7.57; range 7.5-7.9 / sqrt12")
    circ28_drug_set(d, CD_ION, 2.0, 0.0, CD_STATUS_DERIVED, "monoprotic base (pKa 3.7 irrelevant at 7.4)")
    circ28_drug_set(d, CD_FU, clz_p_fu(), clz_p_u_fu(), CD_STATUS_MEASURED, "Schaber1998 PMID 9833598 5.5 % (n 15); label 97 % bound; u = range/sqrt12")
    circ28_drug_set(d, CD_BP, clz_p_bp(), clz_p_u_bp(), CD_STATUS_MEASURED, "Cheng1988 PMID 3203703 0.87 measured (n 10); 0.80-0.86 in models; u = range/sqrt12")
    circ28_drug_set(d, CD_FA, clz_p_fa(), clz_p_u_fa(), CD_STATUS_MEASURED, "Dain1997 PMID 9152600: parent minor in excreta; u = (1-0.8)/sqrt12")
}

pub fn clz_measured_m(d: &!Circ28Drug) with Mut, Div, Panic, Epistemic {
    circ28_drug_set(d, CD_MW, clz_m_mw(), 0.0, CD_STATUS_MEASURED, "PubChem CID 135409468")
    circ28_drug_set(d, CD_LOGP, clz_m_logp(), clz_m_u_logp(), CD_STATUS_MEASURED, "ElEla2004 via Wong2019 PMC6590357; u 0.2 assumed")
    circ28_drug_set(d, CD_PKA1, clz_m_pka(), clz_m_u_pka(), CD_STATUS_MEASURED, "ChEMBL via PubChem, method not stated; u 0.3 assumed")
    circ28_drug_set(d, CD_ION, 2.0, 0.0, CD_STATUS_DERIVED, "monoprotic base from pKa1")
    circ28_drug_set(d, CD_FU, clz_m_fu(), clz_m_u_fu(), CD_STATUS_MEASURED, "Schaber1998 9.7 % (n 15); u assumed")
    circ28_drug_set(d, CD_BP, clz_m_bp(), clz_m_u_bp(), CD_STATUS_DERIVED, "NOT FOUND: assumed equal to clozapine 0.87; u 0.10 assumed")
}

pub fn clz_fit_record_m(d: &!Circ28Drug) with Mut, Div, Panic, Epistemic {
    let th0 = circ28_drug_theta(d)
    let clren = clz_m_ren_mult() * clz_clcr() * clz_m_fu()
    let th = clz_fit_m(th0, clz_m_cl_fit(), clren)
    circ28_drug_set(d, CD_KPSC, 1.0, 0.0, CD_STATUS_DERIVED, "PREDICTION: Rodgers-Rowland scalar 1 (no human volume of norclozapine)")
    circ28_drug_set(d, CD_CLREN, th[CD_CLREN], 0.0, CD_STATUS_DERIVED, "3.0 x CLcr x fu_M (Schaber1998: unbound renal clearance 300 % of CLcr)")
    circ28_drug_set(d, CD_CLINT, th[CD_CLINT], 0.0, CD_STATUS_FITTED, "CL_M fitted to the pooled norclozapine half-life (Guitton1999, Li2012), minus renal")
}

pub fn clz_fit_record_p(d: &!Circ28Drug) with Mut, Div, Panic, Epistemic {
    let th0 = circ28_drug_theta(d)
    let clren = clz_p_ren_mult() * clz_clcr() * clz_p_fu()
    let th = clz_fit_p(th0, clz_obs_vss(), clz_obs_cl(), clren, clz_phi_fit())
    circ28_drug_set(d, CD_KPSC, th[CD_KPSC], 0.0, CD_STATUS_FITTED, "fitted to Vss 1.6 L/kg x 73 kg (Cheng1988, IV, n 10)")
    circ28_drug_set(d, CD_CLREN, th[CD_CLREN], 0.0, CD_STATUS_DERIVED, "0.11 x CLcr x fu (Schaber1998: unbound renal clearance 11 % of CLcr)")
    circ28_drug_set(d, CD_CLINT, th[CD_CLINT], 0.0, CD_STATUS_FITTED, "(1 - phi) x total hepatic; total to IV CL 13.05 L/h plasma (Cheng1988)")
    circ28_drug_set(d, CD_CLFORM, th[CD_CLFORM], 0.0, CD_STATUS_FITTED, "phi x total hepatic; phi to the pooled steady-state norclozapine:clozapine trough ratio")
    circ28_drug_set(d, CD_KA, clz_ka_fit(), 0.0, CD_STATUS_FITTED, "fitted to the pooled steady-state Tmax (100 mg b.i.d.)")
}

// ---- coupled run with steady-state superposition -------------------------------------------------------------
// Result layout (res):
//   0 P Cmax  1 P Tmax  2 P AUC_inf  3 P t1/2  4 M Cmax  5 M Tmax  6 M AUC_inf  7 M t1/2
//   8 input (mg P)  9 P mass balance error  10 M mass balance error  11 grid ok  12 P terminal fit ok
//   13 M terminal fit ok  14 mass given to M (mg)
//   15 P steady-state Cmax  16 P steady-state Tmax  17 P steady-state trough
//   18 M steady-state Cmax  19 M steady-state Tmax  20 M steady-state trough
//   21 M excreted in urine over the run (mg of M)  22 P AUC_0-T  23 M AUC_0-T  24 P c_end  25 M c_end
// route 0 intravenous infusion over t_inf; route 1 oral (ka, fa, tlag of the P array). Concentrations are
// venous plasma (blood / bp), mg/L. Grid: 0.1 h to 12 h, 1 h to 168 h. Terminal fits: P over wp_lo..wp_hi,
// M over wm_lo..wm_hi (h). Steady state of a regimen `dose` every tau h: superposition of the single-dose
// curve, C_ss(t) = sum_k C(t + k tau), linear interpolation on the grid, analytic exponential tail beyond 168 h
// (the tail of C_end exp(-lambda (t - T)) summed as a geometric series). tau must be 12 or 24.
pub fn clz_lz(ts: &[f64; 400], cs: &[f64; 400], n: i32, lo: f64, hi: f64) -> f64 with Mut, Div, Panic {
    var sw = 0.0
    var st = 0.0
    var sy = 0.0
    var stt = 0.0
    var sty = 0.0
    var nf: i32 = 0
    var i: i32 = 1
    while i <= n {
        if (*ts)[i] >= lo && (*ts)[i] <= hi {
            if (*cs)[i] > 0.0 {
                let y = ln((*cs)[i])
                sw = sw + 1.0
                st = st + (*ts)[i]
                sy = sy + y
                stt = stt + (*ts)[i] * (*ts)[i]
                sty = sty + (*ts)[i] * y
                nf = nf + 1
            }
        }
        i = i + 1
    }
    if nf < 3 { return 0.0 }
    let den = sw * stt - st * st
    let lz = 0.0 - (sw * sty - st * sy) / den
    if !(lz > 0.0) { return 0.0 }
    return lz
}

// Concentration of the single-dose curve at time t (h): grid index 0..120 is t = 0.1 i, index 120 + j is
// t = 12 + j (j up to 156); linear interpolation; beyond t_end the exponential tail with rate lz.
pub fn clz_c_at(cs: &[f64; 400], n: i32, t: f64, lz: f64) -> f64 with Mut, Div, Panic {
    if t <= 0.0 { return 0.0 }
    if t < 12.0 {
        let x = t / 0.1
        var j = x as i32
        if j > 119 { j = 119 }
        let w = x - (j as f64)
        return (*cs)[j] * (1.0 - w) + (*cs)[j + 1] * w
    }
    let x2 = t - 12.0
    var j2 = x2 as i32
    let k = 120 + j2
    if k >= n {
        if !(lz > 0.0) { return 0.0 }
        return (*cs)[n] * exp(0.0 - lz * (t - 168.0))
    }
    let w2 = x2 - (j2 as f64)
    return (*cs)[k] * (1.0 - w2) + (*cs)[k + 1] * w2
}

// Steady-state concentration at time t (0 <= t <= tau) after the dose, regimen every tau h.
pub fn clz_css_at(cs: &[f64; 400], n: i32, t: f64, tau: f64, lz: f64) -> f64 with Mut, Div, Panic {
    var sum = 0.0
    var k: i32 = 0
    var tt = t
    while tt < 168.0 {
        sum = sum + clz_c_at(cs, n, tt, lz)
        k = k + 1
        tt = t + (k as f64) * tau
    }
    if lz > 0.0 {
        sum = sum + (*cs)[n] * exp(0.0 - lz * (tt - 168.0)) / (1.0 - exp(0.0 - lz * tau))
    }
    return sum
}

// Steady-state peak (out[0]), its time (out[1]) and trough (out[2]) of one curve.
pub fn clz_ss(cs: &[f64; 400], n: i32, tau: f64, lz: f64, out: &![f64; 3]) with Mut, Div, Panic {
    var cm = 0.0
    var im: i32 = 0
    var cprev = 0.0
    var cpp = 0.0
    var ya = 0.0
    var yb = 0.0
    var yc = 0.0
    let m = (tau / 0.1 + 0.5) as i32
    var i: i32 = 0
    while i <= m {
        let c = clz_css_at(cs, n, 0.1 * (i as f64), tau, lz)
        if i == 0 { (*out)[2] = c }
        if c > cm {
            cm = c
            im = i
            ya = cprev
            yb = c
            yc = 0.0 - 1.0
        } else {
            if im == i - 1 { yc = c }
        }
        cpp = cprev
        cprev = c
        i = i + 1
    }
    (*out)[0] = cm
    (*out)[1] = 0.1 * (im as f64)
    if im >= 1 && yc >= 0.0 {
        let den = ya - 2.0 * yb + yc
        if den < 0.0 {
            let off = 0.5 * (ya - yc) / den
            (*out)[1] = 0.1 * (im as f64) + off * 0.1
            (*out)[0] = yb - 0.25 * (ya - yc) * off
        }
    }
}

// Peak of the single-dose curve with the vertex refinement (fine grid part only when the peak is there).
pub fn clz_peak(ts: &[f64; 400], cs: &[f64; 400], n: i32, out: &![f64; 3]) with Mut, Div, Panic {
    var im: i32 = 0
    var cm = 0.0
    var i: i32 = 1
    while i <= n {
        if (*cs)[i] > cm {
            cm = (*cs)[i]
            im = i
        }
        i = i + 1
    }
    (*out)[0] = cm
    (*out)[1] = (*ts)[im]
    if im >= 1 && im < n {
        let h1 = (*ts)[im] - (*ts)[im - 1]
        let h2 = (*ts)[im + 1] - (*ts)[im]
        if clz_abs(h1 - h2) < 1.0e-9 {
            let den = (*cs)[im - 1] - 2.0 * (*cs)[im] + (*cs)[im + 1]
            if den < 0.0 {
                let off = 0.5 * ((*cs)[im - 1] - (*cs)[im + 1]) / den
                (*out)[1] = (*ts)[im] + off * h1
                (*out)[0] = (*cs)[im] - 0.25 * ((*cs)[im - 1] - (*cs)[im + 1]) * off
            }
        }
    }
}

pub fn clz_run_th(
    thp_in: [f64; 18], thm_in: [f64; 18], route: i32, dose: f64, t_inf: f64, tau: f64,
    wp_lo: f64, wp_hi: f64, wm_lo: f64, wm_hi: f64, res: &![f64; 32]
) with Mut, Div, Panic {
    var thp = thp_in
    var thm = thm_in
    let pp = circ28_drug_params_theta(thp)
    let pm = circ28_drug_params_theta(thm)
    let cp = circ28_coupling(thm[CD_MW] / thp[CD_MW], 0.0)
    var ts: [f64; 400] = [0.0; 400]
    var cr: [f64; 400] = [0.0; 400]
    var cm: [f64; 400] = [0.0; 400]
    var sysp = circ28_sys_zero()
    var sysm = circ28_sys_zero()
    var sp = circ28_state_zero()
    var sm = circ28_state_zero()
    var elp = circ28_elim_zero()
    var elm = circ28_elim_zero()
    var n: i32 = 0
    var t = 0.0
    var input = 0.0
    var given = 0.0
    var ok = 1.0
    var ph: i32 = 0
    while ph < 2 {
        var dt = 0.1
        var tstop = 12.0
        if ph == 1 {
            dt = 1.0
            tstop = 168.0
        }
        circ28_prepare(pp, dt, &!sysp)
        circ28_prepare(pm, dt, &!sysm)
        while t + 0.5 * dt < tstop {
            if n >= 399 {
                ok = 0.0
                t = tstop
            } else {
                var iv = 0.0
                var oral = 0.0
                var mass = 0.0
                if route == 0 {
                    mass = circ28_iv_mass(dose, t_inf, t, t + dt)
                    iv = mass / dt
                } else {
                    mass = circ28_oral_mass(thp[CD_KA], thp[CD_FA], dose, thp[CD_TLAG], t, t + dt)
                    oral = mass / dt
                }
                input = input + mass
                given = given + circ28_metab_step(&!sp, pp, &sysp, &!elp, &!sm, pm, &sysm, &!elm, cp, iv, oral)
                t = t + dt
                n = n + 1
                ts[n] = t
                cr[n] = sp.x[0] / pp.bp
                cm[n] = sm.x[0] / pm.bp
            }
        }
        ph = ph + 1
    }
    var pk: [f64; 3] = [0.0; 3]
    clz_peak(&ts, &cr, n, &!pk)
    (*res)[0] = pk[0]
    (*res)[1] = pk[1]
    clz_peak(&ts, &cm, n, &!pk)
    (*res)[4] = pk[0]
    (*res)[5] = pk[1]
    let lzp = clz_lz(&ts, &cr, n, wp_lo, wp_hi)
    let lzm = clz_lz(&ts, &cm, n, wm_lo, wm_hi)
    let auc_p = elp.auc_ven / pp.bp
    let auc_m = elm.auc_ven / pm.bp
    (*res)[22] = auc_p
    (*res)[23] = auc_m
    (*res)[2] = auc_p
    (*res)[6] = auc_m
    (*res)[3] = 0.0
    (*res)[7] = 0.0
    (*res)[12] = 0.0
    (*res)[13] = 0.0
    if lzp > 0.0 {
        (*res)[12] = 1.0
        (*res)[3] = 0.6931471805599453 / lzp
        (*res)[2] = auc_p + cr[n] / lzp
    }
    if lzm > 0.0 {
        (*res)[13] = 1.0
        (*res)[7] = 0.6931471805599453 / lzm
        (*res)[6] = auc_m + cm[n] / lzm
    }
    (*res)[8] = input
    let eli_p = elp.hepatic + elp.formed + elp.renal + elp.plasma + elp.gut
    var bep = 0.0
    if input > 0.0 { bep = clz_abs(input - eli_p - circ28_total_mass(&sp, pp)) / input }
    (*res)[9] = bep
    let eli_m = elm.hepatic + elm.formed + elm.renal + elm.plasma + elm.gut
    var bem = 0.0
    if given > 0.0 { bem = clz_abs(given - eli_m - circ28_total_mass(&sm, pm)) / given }
    (*res)[10] = bem
    (*res)[11] = ok
    (*res)[14] = given
    // The tail rate of each curve for the superposition: the slope over the last 48 h of the grid (the curve
    // that is actually there, whichever species limits it).
    let lzp_t = clz_lz(&ts, &cr, n, 120.0, 168.0)
    let lzm_t = clz_lz(&ts, &cm, n, 120.0, 168.0)
    clz_ss(&cr, n, tau, lzp_t, &!pk)
    (*res)[15] = pk[0]
    (*res)[16] = pk[1]
    (*res)[17] = pk[2]
    clz_ss(&cm, n, tau, lzm_t, &!pk)
    (*res)[18] = pk[0]
    (*res)[19] = pk[1]
    (*res)[20] = pk[2]
    (*res)[21] = elm.renal
    (*res)[24] = cr[n]
    (*res)[25] = cm[n]
}

// Terminal half-life (h) of norclozapine given alone as an intravenous bolus (the observable of the CL_M fit).
pub fn clz_m_t12(thm: [f64; 18]) -> f64 with Mut, Div, Panic {
    let r = circ28_run_theta(thm, circ28_dose_iv(1.0, 0.1, 0.1, 12.0, 1.0, 168.0, 72.0, 168.0))
    return r.thalf
}

// ---- uncertainty budget of the steady-state trough (100 mg b.i.d.), with refit ---------------------------
// Inputs: 0 logP_P, 1 pKa_P, 2 fu_P, 3 bp_P, 4 CL obs, 5 V_ss obs, 6 steady-state Tmax obs, 7 CLcr, 8 fa.
// Each evaluation refits the Kp scalar, the hepatic clearance and ka (one chord step with the slope of the
// steady-state Tmax in ka) and runs the regimen. The metabolite inputs do not enter: the split phi is refitted
// to the trough ratio T at every evaluation and the ratio is exactly linear in phi, so the norclozapine trough
// is T x (clozapine trough) whatever the metabolite parameters are; the sum is (1 + T) x (clozapine trough)
// and T adds its own term. A guard row of the test checks this with a perturbed metabolite.
pub fn clz_eval(z: [f64; 9], dp: &Circ28Drug, dm: &Circ28Drug, ka0: f64, slope: f64, out: &![f64; 2]) with Mut, Div, Panic, Epistemic {
    var tp0 = circ28_drug_theta(dp)
    tp0[CD_LOGP] = z[0]
    tp0[CD_PKA1] = z[1]
    tp0[CD_FU] = z[2]
    tp0[CD_BP] = z[3]
    tp0[CD_FA] = z[8]
    let clren = clz_p_ren_mult() * z[7] * z[2]
    var tp = clz_fit_p(tp0, z[5], z[4], clren, clz_phi_fit())
    let tm = circ28_drug_theta(dm)
    tp[CD_KA] = ka0
    var r1: [f64; 32] = [0.0; 32]
    clz_run_th(tp, tm, 1, 100.0, 0.0, 12.0, 24.0, 48.0, 96.0, 168.0, &!r1)
    tp[CD_KA] = ka0 + (z[6] - r1[16]) / slope
    var r2: [f64; 32] = [0.0; 32]
    clz_run_th(tp, tm, 1, 100.0, 0.0, 12.0, 24.0, 48.0, 96.0, 168.0, &!r2)
    (*out)[0] = r2[17]
    (*out)[1] = r2[16]
}

pub fn clz_input_u(i: i32) -> f64 with Mut, Div {
    if i == 0 { return clz_p_u_logp() }
    if i == 1 { return clz_p_u_pka() }
    if i == 2 { return clz_p_u_fu() }
    if i == 3 { return clz_p_u_bp() }
    if i == 4 { return clz_u_cl() }
    if i == 5 { return clz_u_vss() }
    if i == 6 { return clz_u_tmax_ss() }
    if i == 7 { return clz_u_clcr() }
    return clz_p_u_fa()
}

pub fn clz_input_name(i: i32) -> string {
    if i == 0 { return "logP_P     " }
    if i == 1 { return "pKa_P      " }
    if i == 2 { return "fu_P       " }
    if i == 3 { return "bp_P       " }
    if i == 4 { return "CL obs     " }
    if i == 5 { return "Vss obs    " }
    if i == 6 { return "Tmax_ss obs" }
    if i == 7 { return "CLcr       " }
    return "fa         "
}

pub struct ClzBudget {
    pub trough: f64,
    pub var_trough: f64,
    pub contrib: [f64; 9],
    pub u: [f64; 9],
    pub runs: i32,
}

pub fn clz_budget(dp: &Circ28Drug, dm: &Circ28Drug, slope: f64) -> ClzBudget with Mut, Div, Panic, Epistemic {
    let thp = circ28_drug_theta(dp)
    let ka0 = thp[CD_KA]
    var z0: [f64; 9] = [0.0; 9]
    z0[0] = thp[CD_LOGP]
    z0[1] = thp[CD_PKA1]
    z0[2] = thp[CD_FU]
    z0[3] = thp[CD_BP]
    z0[4] = clz_obs_cl()
    z0[5] = clz_obs_vss()
    z0[6] = clz_obs_tmax_ss()
    z0[7] = clz_clcr()
    z0[8] = thp[CD_FA]
    var u: [f64; 9] = [0.0; 9]
    var i: i32 = 0
    while i < 9 {
        u[i] = clz_input_u(i)
        i = i + 1
    }
    var o0: [f64; 2] = [0.0; 2]
    clz_eval(z0, dp, dm, ka0, slope, &!o0)
    var ca: [f64; 9] = [0.0; 9]
    var va = 0.0
    var nrun: i32 = 2
    i = 0
    while i < 9 {
        // forward difference with a step of 0.1 u (lesson 6)
        let hs = 0.1 * u[i]
        var zp = z0
        zp[i] = z0[i] + hs
        var op: [f64; 2] = [0.0; 2]
        clz_eval(zp, dp, dm, ka0, slope, &!op)
        nrun = nrun + 2
        let da = (op[0] - o0[0]) / hs
        ca[i] = da * da * u[i] * u[i]
        va = va + ca[i]
        i = i + 1
    }
    return ClzBudget { trough: o0[0], var_trough: va, contrib: ca, u: u, runs: nrun }
}
