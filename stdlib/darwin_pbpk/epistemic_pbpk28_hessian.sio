// stdlib/darwin_pbpk/epistemic_pbpk28_hessian.sio — Second-Order GUM (PBPK28)
//
// Second-order GUM correction through the 28-state permeability-limited PBPK
// model. Dissertation §4.10 (§4.9 method ported to PBPK28 kernel).
//
// First-order GUM (epistemic_pbpk28.sio):
//   Var(y) ≈ Σᵢ cᵢ² σᵢ²         where cᵢ = ∂y/∂xᵢ
//
// Second-order correction (JCGM 100:2008 §F; JCGM 101 §B.4):
//   Var(y) ≈ Σᵢ cᵢ² σᵢ²  +  ½ Σᵢⱼ Hᵢⱼ² σᵢ² σⱼ²
//   E[y]   ≈ y(μ)         +  ½ Σᵢ Hᵢᵢ σᵢ²
//
// Finite-difference stencils (same as epistemic_pbpk14_hessian.sio):
//   Diagonal   Hᵢᵢ = [y(+h) - 2y(0) + y(-h)] / h²
//   Off-diag   Hᵢⱼ = [y(++)-y(+-)-y(-+)+y(--)] / (4 hᵢ hⱼ)
//
// Step size: h = max(1e-6 · |μ|, 1e-2 · σ)
//
// Scope: AUC_blood endpoint only (primary clinical target for rapamycin DES
// dosing; most non-linear in clearance). Same scope rationale as §4.9.
//
// Simulation path: Crank-Nicolson fixed dt=0.1h (coarser than the 1st-order
// module's dt=0.05h — acceptable here because only relative FD differences
// matter, not absolute trajectory accuracy). Total evals: 1 + 2n + n(n-1)/2×4
// = 1 + 14 + 84 = 99 ODE runs for n=7.

use darwin_pbpk::core::pbpk28_params::*
use darwin_pbpk::tsit5_pbpk28::*
use darwin_pbpk::theta_pbpk28::*
use darwin_pbpk::epistemic_pbpk28::{EpPrior28, ep28_rapamycin_params, ep28_rapamycin_priors}

// ============================================================================
// MATH HELPERS (local copies — not re-exported by PBPK28 imports)
// ============================================================================

fn h28_abs(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn h28_sqrt(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    return y
}

fn h28_max(a: f64, b: f64) -> f64 {
    if a > b { return a }
    return b
}

fn h28_finite(x: f64) -> bool {
    if x != x { return false }
    return h28_abs(x) < 1.0e12
}

// ============================================================================
// STEP SIZE
// ============================================================================

fn h28_step(mean: f64, variance: f64) -> f64 with Mut, Div, Panic {
    let h_rel = 1.0e-6 * h28_abs(mean)
    let h_abs = 0.01 * h28_sqrt(variance)
    h28_max(h_rel, h_abs)
}

// ============================================================================
// AUC-ONLY SIMULATION (coarser dt for Hessian FD)
// ============================================================================
// Uses CN at dt=0.1h. For the Hessian we only need the FD *differences*
// to be accurate; the absolute AUC trajectory is allowed to be ~0.5%
// off from the fine-grid reference.

// Bolus run at the Hessian's dt = 0.1 h: Rannacher-started clamp-free CN
// (theta_pbpk28). Shared by h28_simulate_auc and the mass-balance gate.
// Until 2026-09-26 this was pbpk28_full_cn_step, whose floors biased AUC_blood
// by +52% at this dt (0.611694 vs Dose/CL = 0.403226).
pub fn h28_simulate_ledger(prm: PBPKParams28, dose_mg: f64, t_end: f64,
                           st: &!PBPKState28, led: &!PBPK28Ledger) -> bool with Mut, Div {
    return pbpk28_bolus_run_mut(prm, dose_mg, 0.1, t_end, 5000, st, led)
}

// A stencil AUC is usable iff finite and > 0 (0.0 is h28_simulate_auc's
// failure value).
fn h28_solve_ok(auc: f64) -> bool {
    return h28_finite(auc) && auc > 0.0
}

fn h28_simulate_auc(prm: PBPKParams28, dose_mg: f64, t_end: f64) -> f64 with Mut, Div, Panic {
    var st = pbpk28_state_zero()
    var led = pbpk28_ledger_zero()
    if !h28_simulate_ledger(prm, dose_mg, t_end, &!st, &!led) { return 0.0 }
    let auc = led.auc[0]
    if !h28_finite(auc) { return 0.0 }
    return auc
}

// ============================================================================
// PARAMETER PERTURBATION (mirrors ep28_perturb in epistemic_pbpk28.sio)
// ============================================================================

fn h28_perturb(prm: PBPKParams28, idx: i32, delta: f64) -> PBPKParams28 with Mut, Div {
    var p = prm
    let fu_ref = 0.08
    if idx == 0 { p.cl_central = p.cl_central + delta }
    if idx == 1 { p.cl_central = p.cl_central + delta }
    if idx == 2 {
        if fu_ref > 0.0 {
            let scale = (fu_ref + delta) / fu_ref
            p.cl_central = p.cl_central * scale
        }
    }
    if idx == 3 { p.kp[3] = p.kp[3] + delta }
    if idx == 4 { p.kp[1] = p.kp[1] + delta }
    if idx == 5 { p.kp[2] = p.kp[2] + delta }
    if idx == 6 { p.kp[7] = p.kp[7] + delta }
    return p
}

fn h28_perturb2(prm: PBPKParams28, i: i32, di: f64, j: i32, dj: f64) -> PBPKParams28 with Mut, Div {
    let p1 = h28_perturb(prm, i, di)
    h28_perturb(p1, j, dj)
}

// ============================================================================
// HESSIAN BUDGET RECORD
// ============================================================================

pub struct Pbpk28HessianBudget {
    n:                  i32,
    auc_ref:            f64,
    auc_mean_corrected: f64,       // y(μ) + ½ Σ Hᵢᵢ σᵢ²
    pub sensitivity:        [f64; 8],  // 1st-order: cᵢ = ∂AUC/∂xᵢ
    pub hessian:            [f64; 64], // 8×8 row-major
    pub var_first_order:    f64,
    pub var_second_order:   f64,       // 1st order + Hessian correction
    pub success:            bool,
}

fn h28_budget_zero() -> Pbpk28HessianBudget {
    Pbpk28HessianBudget {
        n: 0,
        auc_ref: 0.0,
        auc_mean_corrected: 0.0,
        sensitivity: [0.0; 8],
        hessian: [0.0; 64],
        var_first_order: 0.0,
        var_second_order: 0.0,
        success: false,
    }
}

// ============================================================================
// MAIN HESSIAN COMPUTATION
// ============================================================================

pub fn hessian_pbpk28_auc(
    base_prm: PBPKParams28,
    priors:   EpPrior28,
    dose_mg:  f64,
    t_end:    f64,
) -> Pbpk28HessianBudget with Mut, Div, Panic, Epistemic {
    let n = priors.n
    var bud = h28_budget_zero()
    bud.n = n

    let auc0 = h28_simulate_auc(base_prm, dose_mg, t_end)
    if !h28_finite(auc0) || auc0 <= 0.0 {
        return bud
    }
    bud.auc_ref = auc0

    // Every stencil solve must succeed. h28_simulate_auc returns 0.0 for a
    // rejected trajectory (non-finite, runaway, or booked negative mass above
    // pbpk28_neg_mass_bound_mg()); a valid AUC is > 0. One rejected solve
    // fails the whole budget instead of entering a difference quotient as 0.
    var all_ok = true

    // Step sizes per parameter
    var hs: [f64; 8] = [0.0; 8]
    var i: i32 = 0
    while i < n {
        hs[i] = h28_step(priors.kn[i].value, priors.kn[i].variance)
        i = i + 1
    }

    // First-order sensitivities + diagonal Hessian (3-point central)
    i = 0
    while i < n {
        let h = hs[i]
        if h > 0.0 {
            let p_p = h28_perturb(base_prm, i, h)
            let p_n = h28_perturb(base_prm, i, 0.0 - h)
            let f_p = h28_simulate_auc(p_p, dose_mg, t_end)
            let f_n = h28_simulate_auc(p_n, dose_mg, t_end)
            if !h28_solve_ok(f_p) || !h28_solve_ok(f_n) { all_ok = false }
            let ci  = (f_p - f_n) / (2.0 * h)
            bud.sensitivity[i] = ci
            let hii = (f_p - 2.0 * auc0 + f_n) / (h * h)
            bud.hessian[i * 8 + i] = hii
        }
        i = i + 1
    }

    // Off-diagonal Hessian (4-point central)
    i = 0
    while i < n {
        var j: i32 = i + 1
        while j < n {
            let hi = hs[i]
            let hj = hs[j]
            if hi > 0.0 && hj > 0.0 {
                let f_pp = h28_simulate_auc(h28_perturb2(base_prm, i, hi,        j, hj),        dose_mg, t_end)
                let f_pn = h28_simulate_auc(h28_perturb2(base_prm, i, hi,        j, 0.0 - hj), dose_mg, t_end)
                let f_np = h28_simulate_auc(h28_perturb2(base_prm, i, 0.0 - hi, j, hj),        dose_mg, t_end)
                let f_nn = h28_simulate_auc(h28_perturb2(base_prm, i, 0.0 - hi, j, 0.0 - hj), dose_mg, t_end)
                if !h28_solve_ok(f_pp) || !h28_solve_ok(f_pn) || !h28_solve_ok(f_np) || !h28_solve_ok(f_nn) { all_ok = false }
                let hij  = (f_pp - f_pn - f_np + f_nn) / (4.0 * hi * hj)
                bud.hessian[i * 8 + j] = hij
                bud.hessian[j * 8 + i] = hij
            }
            j = j + 1
        }
        i = i + 1
    }

    if !all_ok { return h28_budget_zero() }

    // First-order variance
    var v1: f64 = 0.0
    i = 0
    while i < n {
        let ci = bud.sensitivity[i]
        v1 = v1 + ci * ci * priors.kn[i].variance
        i = i + 1
    }
    bud.var_first_order = v1

    // Second-order variance correction: ½ Σᵢⱼ Hᵢⱼ² σᵢ² σⱼ²
    var v2_corr: f64 = 0.0
    i = 0
    while i < n {
        var j: i32 = 0
        while j < n {
            let h_ij = bud.hessian[i * 8 + j]
            let vi   = priors.kn[i].variance
            let vj   = priors.kn[j].variance
            v2_corr = v2_corr + 0.5 * h_ij * h_ij * vi * vj
            j = j + 1
        }
        i = i + 1
    }
    bud.var_second_order = v1 + v2_corr

    // Mean correction: y(μ) + ½ Σ Hᵢᵢ σᵢ²
    var mean_shift: f64 = 0.0
    i = 0
    while i < n {
        let h_diag = bud.hessian[i * 8 + i]
        mean_shift = mean_shift + 0.5 * h_diag * priors.kn[i].variance
        i = i + 1
    }
    bud.auc_mean_corrected = auc0 + mean_shift
    bud.success = true
    bud
}

// ============================================================================
// NONLINEARITY RATIO ρᵢ — dual emission (JCGM 101 §B.4)
// ============================================================================
// Literal  ρᵢ = |½ Hᵢᵢ σᵢ²| / |cᵢ σᵢ|  (JCGM 101 §B.4 in physical units)
// Normalised ρ̃ᵢ = ½ ρᵢ²                  (as computed below; see its comment)
//
// For a perfectly linear function: Hᵢᵢ = 0 → both ratios vanish.
// Resolvability (see the two *_resolvable helpers). Both terms are finite
// differences with their own rounding floors:
//   - first-order and second-order effects both unresolved → the parameter
//     has no measurable effect at either order: both ratios report 0.0;
//   - first order unresolved but second order resolved → a curvature with no
//     measurable slope; the ratio is undefined and both functions return the
//     sentinel -1.0 (never a valid ratio, which is ≥ 0);
//   - first order resolved → the ratio as defined.
// Under the exact mass identity AUC_blood(0-168h) = (Dose − M(168h))/CL the
// four Kp columns are pure rounding at both orders (|cᵢ|σᵢ ~ 1e-13,
// ½|Hᵢᵢ|σᵢ² ~ 1e-12, against AUC_ref ~ 0.4); unguarded, their ratio of two
// noise terms printed as ρ_literal(kp_brain) = 8.2, ρ̃ = 33.6.
// For AUC ~ 1/CL (convex), M6 CV(CL)=38% gives ρ_literal(CL) ≈ 0.38
// and ρ̃(CL) ≈ 0.07. The legacy CV=58% prior gave ρ_literal≈0.58 and
// ρ̃≈0.17. Threshold for "weakly nonlinear": ρ̃ < 0.20 per dissertation §4.9.

// |cᵢ|σᵢ must exceed 1e-9·|AUC_ref| to be a measured effect. The central
// difference of an AUC accumulated over n ≲ 1700 sub-steps carries absolute
// rounding ~ n·ε·|AUC| ≈ 4e-13·|AUC|; with h = 0.01σ that puts the noise in
// |cᵢ|σᵢ near 2e-11·|AUC|, 50× below this floor, while the smallest real
// first-order effect here (cl_renal, |c|σ ≈ 4e-3 vs 4e-10) is 10⁷× above it.
fn h28_first_order_resolvable(bud: Pbpk28HessianBudget, priors: EpPrior28, i: i32) -> bool with Mut, Div, Panic, Epistemic {
    let c_i = bud.sensitivity[i]
    let s_i = h28_sqrt(priors.kn[i].variance)
    return h28_abs(c_i) * s_i > 1.0e-9 * h28_abs(bud.auc_ref)
}

// ½|Hᵢᵢ|σᵢ² must exceed 1e-7·|AUC_ref| to be a measured effect. The
// three-point second difference divides ~4 rounding errors of ≈ 4e-13·|AUC|
// by h² = (0.01σ)², so its noise in ½|Hᵢᵢ|σᵢ² is ≈ 8e-9·|AUC|, 12× below this
// floor; the smallest real second-order term here (cl_renal,
// ½·0.0052·0.0144 ≈ 4e-5 vs 4e-8) is 10³× above it.
fn h28_second_order_resolvable(bud: Pbpk28HessianBudget, priors: EpPrior28, i: i32) -> bool with Mut, Div, Panic, Epistemic {
    let h_ii = bud.hessian[i * 8 + i]
    let v_i = priors.kn[i].variance
    return 0.5 * h28_abs(h_ii) * v_i > 1.0e-7 * h28_abs(bud.auc_ref)
}

// 0.0 when neither order is resolvable, -1.0 (undefined) when only the
// second order is, and 1.0 when the ratio is well defined.
fn h28_ratio_status(bud: Pbpk28HessianBudget, priors: EpPrior28, i: i32) -> f64 with Mut, Div, Panic, Epistemic {
    if h28_first_order_resolvable(bud, priors, i) { return 1.0 }
    if h28_second_order_resolvable(bud, priors, i) { return 0.0 - 1.0 }
    return 0.0
}

pub fn h28_nonlinearity_ratio_literal(
    bud:    Pbpk28HessianBudget,
    priors: EpPrior28,
    i:      i32,
) -> f64 with Mut, Div, Panic, Epistemic {
    let c_i  = bud.sensitivity[i]
    let h_ii = bud.hessian[i * 8 + i]
    let v_i  = priors.kn[i].variance
    let s_i  = h28_sqrt(v_i)
    let num  = 0.5 * h28_abs(h_ii) * v_i
    let den  = h28_abs(c_i) * s_i
    let status = h28_ratio_status(bud, priors, i)
    if status < 0.5 { return status }
    if den < 1.0e-30 { return 0.0 }
    num / den
}

// ρ̃_i = ½ ρ²_literal, which is what this function returns (0.0722 for M6
// CL_hep, ρ_literal = 0.380; editorial range [0.05, 0.20]).
// It is NOT the per-parameter second-order-to-first-order variance ratio.
// That ratio, for a normal input, is
//   ½ H_ii² σ_i⁴ / (c_i² σ_i²) = ½ (H_ii σ_i / c_i)² = 2 ρ²_literal = 4 ρ̃_i
// (0.2888 for M6 CL_hep, 0.125 for fu). An earlier version of this comment
// derived 2ρ² and then labelled ½ρ² with it, a factor of 4 (caught in PR
// #2696 review, 2026-09-26). The value and the [0.05, 0.20] range are left
// as they are: redefining ρ̃ as the variance ratio would move CL_hep past the
// editorial 0.20 threshold, which is a decision for the dissertation author.
// Do not describe ρ̃ as "the fraction of variance the Hessian adds".
pub fn h28_nonlinearity_ratio_normalized(
    bud:    Pbpk28HessianBudget,
    priors: EpPrior28,
    i:      i32,
) -> f64 with Mut, Div, Panic, Epistemic {
    let c_i  = bud.sensitivity[i]
    let h_ii = bud.hessian[i * 8 + i]
    let v_i  = priors.kn[i].variance
    let s_i  = h28_sqrt(v_i)
    let den  = h28_abs(c_i)
    let status = h28_ratio_status(bud, priors, i)
    if status < 0.5 { return status }
    if den < 1.0e-30 { return 0.0 }
    let rho = 0.5 * h28_abs(h_ii) * s_i / den
    0.5 * rho * rho
}

// ============================================================================
// CSV EMIT (matches §4.9 hessian_emit_budget_csv format for GUM Table H.1)
// ============================================================================

pub fn h28_emit_csv_header() with IO, Mut, Panic, Div {
    println("kind,i,j,value,units")
}

// Emit GUM Table H.1 CSV.  rho_literal: JCGM 101 §B.4 in physical units;
// rho_normalized: dimensionless analogue scaled to σ-units.
pub fn h28_emit_budget_csv(bud: Pbpk28HessianBudget, priors: EpPrior28) with IO, Mut, Panic, Div, Epistemic {
    let n = bud.n
    print("ref,0,0,"); print_f64(bud.auc_ref); println(",mg.h/L")
    print("mean_corr,0,0,"); print_f64(bud.auc_mean_corrected); println(",mg.h/L")
    print("var_o1,0,0,"); print_f64(bud.var_first_order); println(",(mg.h/L)^2")
    print("var_o2,0,0,"); print_f64(bud.var_second_order); println(",(mg.h/L)^2")

    var i: i32 = 0
    while i < n {
        print("sens,"); print_f64(i as f64); print(",0,"); print_f64(bud.sensitivity[i])
        println(",mg.h/L/unit")
        i = i + 1
    }

    i = 0
    while i < n {
        var j: i32 = i
        while j < n {
            print("hess,"); print_f64(i as f64); print(","); print_f64(j as f64); print(",")
            print_f64(bud.hessian[i * 8 + j])
            println(",mg.h/L/unit2")
            j = j + 1
        }
        i = i + 1
    }

    i = 0
    while i < n {
        let rho_lit  = h28_nonlinearity_ratio_literal(bud, priors, i)
        let rho_norm = h28_nonlinearity_ratio_normalized(bud, priors, i)
        print("rho_literal,"); print_f64(i as f64); print(",0,"); print_f64(rho_lit)
        println(",dimensionless")
        print("rho_normalized,"); print_f64(i as f64); print(",0,"); print_f64(rho_norm)
        println(",dimensionless")
        i = i + 1
    }
}

// ============================================================================
// MAIN — TEST SUITE (7 tests)
// ============================================================================

fn h28_selftest_main() -> i32 with IO, Mut, Div, Panic, Epistemic {
    println("======================================================================")
    println("  Epistemic PBPK28 — Second-Order GUM (Hessian correction)")
    println("  Drug: Rapamycin (Sirolimus)")
    println("  Method: 3-point + 4-point central FD Hessian (JCGM 101 SS B.4)")
    println("======================================================================")
    println("")

    let prm     = ep28_rapamycin_params()
    let priors  = ep28_rapamycin_priors()
    let dose_mg = 5.0
    let t_end   = 168.0

    let bud = hessian_pbpk28_auc(prm, priors, dose_mg, t_end)

    var passed = 0
    var failed = 0

    // TEST 1: Hessian computation completes
    println("TEST 1: Hessian computation completes")
    if bud.success {
        println("  [PASS]")
        passed = passed + 1
    } else {
        println("  FAIL: Hessian computation failed")
        failed = failed + 1
    }
    println("")

    // TEST 2: Reference AUC > 0
    println("TEST 2: Reference AUC > 0")
    print("  AUC_ref (mg.h/L): ")
    print_f64(bud.auc_ref)
    println("")
    if bud.auc_ref > 0.0 {
        println("  [PASS]")
        passed = passed + 1
    } else {
        println("  FAIL")
        failed = failed + 1
    }
    println("")

    // TEST 3: Second-order variance >= first-order variance (Hessian adds)
    println("TEST 3: var_second_order >= var_first_order")
    print("  var_first_order:  ")
    print_f64(bud.var_first_order)
    println("")
    print("  var_second_order: ")
    print_f64(bud.var_second_order)
    println("")
    if bud.var_second_order >= bud.var_first_order {
        println("  [PASS] Hessian correction is non-negative (quadratic term)")
        passed = passed + 1
    } else {
        println("  FAIL: second-order variance should be >= first-order")
        failed = failed + 1
    }
    println("")

    // TEST 4: Diagonal Hessian for CL (idx=0) is negative (AUC ~ 1/CL is convex upward)
    println("TEST 4: H_00 (CL diagonal) has expected sign")
    print("  H[0][0] (d2AUC/dCL2): ")
    print_f64(bud.hessian[0])
    println("")
    // AUC = Dose/CL (linear PK approx) → d2AUC/dCL2 = 2·Dose/CL3 > 0 at first order
    // For the 28-comp model AUC is more complex but CL sensitivity still dominant.
    // The sign may vary; just check it is non-zero and finite.
    let h00_ok = h28_finite(bud.hessian[0]) && (bud.hessian[0] != 0.0)
    if h00_ok {
        println("  [PASS] H_00 is finite and non-zero")
        passed = passed + 1
    } else {
        println("  FAIL: H_00 is zero or non-finite")
        failed = failed + 1
    }
    println("")

    // TEST 5: Mean correction is physically bounded (< 60% of AUC_ref)
    // AUC ~ 1/CL is convex, so by Jensen E[1/CL] ≥ 1/E[CL] and the Hessian
    // mean correction ½ Σ Hᵢᵢ σᵢ² is positive and grows with the priors' CVs:
    // measured |shift| / AUC_ref = 0.207 under the M6 prior (CV(CL_hep) 38%)
    // and 0.400 under the legacy prior (σ/CL = 58%). The 60% threshold is
    // prior-independent: it flags pathological values (> 100% shifts) and
    // accepts either measured correction.
    println("TEST 5: Mean correction physically bounded (< 60% of AUC_ref)")
    let mean_shift = bud.auc_mean_corrected - bud.auc_ref
    let rel_shift = if bud.auc_ref > 1.0e-12 {
        h28_abs(mean_shift) / bud.auc_ref
    } else {
        0.0
    }
    print("  |mean_shift| / AUC_ref: ")
    print_f64(rel_shift)
    println("")
    if rel_shift < 0.60 {
        println("  [PASS] Hessian mean correction below 60% of AUC_ref")
        passed = passed + 1
    } else {
        println("  FAIL: mean correction too large (> 60%)")
        failed = failed + 1
    }
    println("")

    // TEST 6: CSV emit runs without panic
    println("TEST 6: CSV emit (GUM Table H.1 format with dual-rho columns)")
    h28_emit_csv_header()
    h28_emit_budget_csv(bud, priors)
    println("  [PASS] CSV emitted without error")
    passed = passed + 1
    println("")

    // TEST 7: Mass balance at the production dt — exact discrete identity
    // M(T) + CL·AUC − M(0) = 0 to rounding (theta_pbpk28 gate bounds).
    println("TEST 7: Mass balance at production dt (dt=0.1h, 5 mg bolus)")
    var mb_st = pbpk28_state_zero()
    var mb_led = pbpk28_ledger_zero()
    let mb_run = h28_simulate_ledger(prm, dose_mg, t_end, &!mb_st, &!mb_led)
    let mb_ok = mb_run && pbpk28_mass_gate_report(mb_led, mb_st, prm, dose_mg)
    if mb_ok {
        println("  [PASS] mass identity closes to rounding; no floor, no visible negativity")
        passed = passed + 1
    } else {
        println("  FAIL: discrete mass identity violated or negative mass visible")
        failed = failed + 1
    }
    println("")

    println("======================================================================")
    println("  HESSIAN PBPK28 — TEST SUMMARY")
    println("======================================================================")
    print("  Passed: ")
    print_f64(passed as f64)
    println("")
    print("  Failed: ")
    print_f64(failed as f64)
    println("")
    if failed == 0 {
        println("")
        println("  ALL 7 TESTS PASSED")
        println("")
        println("  Second-order GUM through 28-state PBPK for rapamycin.")
        println("  Dissertation Section 4.10 Hessian stack: CONFIRMED.")
        println("  PASS")
    } else {
        println("  SOME TESTS FAILED")
    }
    println("======================================================================")

    return failed
}

// ============================================================================
// DUAL-RHO SELFTEST (5 tests)
// ============================================================================

fn h28_dual_rho_selftest_main() -> i32 with IO, Mut, Div, Panic, Epistemic {
    println("======================================================================")
    println("  Epistemic PBPK28 — Dual-Rho Nonlinearity Test")
    println("  ρ_literal (JCGM 101 §B.4) and ρ̃_normalized (dimensionless)")
    println("======================================================================")
    println("")

    let prm    = ep28_rapamycin_params()
    let priors = ep28_rapamycin_priors()
    let bud    = hessian_pbpk28_auc(prm, priors, 5.0, 168.0)

    var passed = 0
    var failed = 0

    // TEST 1: ρ_literal recovers a value in physical-unit range (CL_hep, idx=0).
    // AUC ~ 1/CL is convex → Hessian term is positive → ρ_literal > 0.
    // The M6 benchmark is 0.380; allow [0.20, 1.50] to keep the check
    // focused on physical-unit curvature, not on a single rounded prior.
    println("TEST 1: rho_literal(CL_hep) in [0.20, 1.50]")
    let rho_lit_cl = h28_nonlinearity_ratio_literal(bud, priors, 0)
    print("  rho_literal(CL_hep): "); print_f64(rho_lit_cl); println("")
    if rho_lit_cl > 0.20 && rho_lit_cl < 1.50 {
        println("  [PASS]")
        passed = passed + 1
    } else {
        println("  FAIL: outside expected range")
        failed = failed + 1
    }
    println("")

    // TEST 2: ρ̃_normalized in M6 editorial range [0.05, 0.20].
    // ρ̃ = ½ρ² (not the variance ratio, which is 2ρ² = 4ρ̃; see
    // h28_nonlinearity_ratio_normalized). For ρ_literal(CL_hep)=0.380 → 0.072.
    println("TEST 2: rho_normalized(CL_hep) in [0.05, 0.20]")
    let rho_norm_cl = h28_nonlinearity_ratio_normalized(bud, priors, 0)
    print("  rho_normalized(CL_hep): "); print_f64(rho_norm_cl); println("")
    if rho_norm_cl > 0.05 && rho_norm_cl < 0.20 {
        println("  [PASS] rho_normalized = rho_literal^2/2 in editorial range [0.05, 0.20]")
        passed = passed + 1
    } else {
        println("  FAIL: outside [0.05, 0.20]")
        failed = failed + 1
    }
    println("")

    // TEST 3: Both ratios vanish for a synthetic zero-curvature budget.
    // A perfectly linear function has H_ii = 0 → both ρ_literal = ρ̃ = 0.
    println("TEST 3: Both ratios = 0 for zero-curvature (linear) budget")
    var linear_bud = h28_budget_zero()
    linear_bud.n = 7
    linear_bud.sensitivity[0] = 1.0
    linear_bud.hessian[0] = 0.0
    let rho_lit_lin  = h28_nonlinearity_ratio_literal(linear_bud, priors, 0)
    let rho_norm_lin = h28_nonlinearity_ratio_normalized(linear_bud, priors, 0)
    print("  rho_literal (linear):    "); print_f64(rho_lit_lin); println("")
    print("  rho_normalized (linear): "); print_f64(rho_norm_lin); println("")
    if rho_lit_lin == 0.0 && rho_norm_lin == 0.0 {
        println("  [PASS] both vanish for linear model")
        passed = passed + 1
    } else {
        println("  FAIL: expected 0.0 for linear model")
        failed = failed + 1
    }
    println("")

    // TEST 4: A purely quadratic response (zero slope, resolvable curvature)
    // has no defined ratio: both functions return the -1.0 sentinel, never
    // 0.0, which would read as "linear".
    println("TEST 4: Both ratios = -1 (undefined) for a purely quadratic budget")
    var quad_bud = h28_budget_zero()
    quad_bud.n = 7
    quad_bud.auc_ref = 0.4
    quad_bud.sensitivity[0] = 0.0
    quad_bud.hessian[0] = 1.0
    let rho_lit_quad  = h28_nonlinearity_ratio_literal(quad_bud, priors, 0)
    let rho_norm_quad = h28_nonlinearity_ratio_normalized(quad_bud, priors, 0)
    print("  rho_literal (quadratic):    "); print_f64(rho_lit_quad); println("")
    print("  rho_normalized (quadratic): "); print_f64(rho_norm_quad); println("")
    if rho_lit_quad == 0.0 - 1.0 && rho_norm_quad == 0.0 - 1.0 {
        println("  [PASS] both report the undefined sentinel")
        passed = passed + 1
    } else {
        println("  FAIL: expected -1.0 for a purely quadratic response")
        failed = failed + 1
    }
    println("")

    // TEST 5: Neither order resolvable (slope and curvature below their
    // rounding floors against AUC_ref = 0.4): both ratios report 0.0.
    println("TEST 5: Both ratios = 0 when neither order is resolvable")
    var flat_bud = h28_budget_zero()
    flat_bud.n = 7
    flat_bud.auc_ref = 0.4
    flat_bud.sensitivity[0] = 0.0
    flat_bud.hessian[0] = 0.0
    let rho_lit_flat  = h28_nonlinearity_ratio_literal(flat_bud, priors, 0)
    let rho_norm_flat = h28_nonlinearity_ratio_normalized(flat_bud, priors, 0)
    print("  rho_literal (flat):    "); print_f64(rho_lit_flat); println("")
    print("  rho_normalized (flat): "); print_f64(rho_norm_flat); println("")
    if rho_lit_flat == 0.0 && rho_norm_flat == 0.0 {
        println("  [PASS] both report 0 (no measurable effect)")
        passed = passed + 1
    } else {
        println("  FAIL: expected 0.0 when neither order is resolvable")
        failed = failed + 1
    }
    println("")

    println("======================================================================")
    println("  DUAL-RHO TEST SUMMARY")
    println("======================================================================")
    print("  Passed: "); print_f64(passed as f64); println("")
    print("  Failed: "); print_f64(failed as f64); println("")
    if failed == 0 {
        println("")
        println("  ALL 5 DUAL-RHO TESTS PASSED")
        println("")
        println("  HESSIAN_PBPK28_DUAL_RHO_PASS")
    } else {
        println("  SOME DUAL-RHO TESTS FAILED")
    }
    println("======================================================================")

    return failed
}

fn main() -> i32 with IO, Mut, Div, Panic, Epistemic {
    let r1 = h28_selftest_main()
    let r2 = h28_dual_rho_selftest_main()
    r1 + r2
}
