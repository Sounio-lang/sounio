// stdlib/darwin_pbpk/circ28_drug_aripiprazole.sio — aripiprazole (oral tablet) and its active
// metabolite dehydro-aripiprazole on the circ28 drug record, coupled by circ28_metab.sio
//
// Healthy adult (ICRP 89 reference male, 73 kg), CYP2D6 extensive (normal) metaboliser by default;
// the poor metaboliser (PM) is obtained by removing the CYP2D6 share of the hepatic intrinsic
// clearance. Two records: parent P and metabolite M; M is formed from the parent's hepatic clform
// in liver tissue (circ28_metab.sio).
//
// STATUS: 1 measured, 2 derived by a stated formula, 3 fitted to ONE named observable (which is then
// NOT a validation). u is the STANDARD UNCERTAINTY OF THE VALUE, never an inter-individual SD.
// ACCESS: L label / SmPC text read; A abstract; F full text read; Ft full text read through the fetch
// tool's extraction; S secondary (quoted by a document read); M model input of a PBPK paper (not a
// measurement). Nothing is from memory. "ASSUMED" marks a number with no source.
//
// ---- ARIPIPRAZOLE (P) record -----------------------------------------------------------------
//  param   value    u        status  source / access
//  MW      448.38   0        1       Abilify label (L)
//  logP    5.07     0.46     2       mean of the three predicted/database values 4.9, 5.21, 5.11 quoted by
//                                    Kneller 2021 (PMC8613074, F; DrugBank-derived, M); u = (5.21 - 3.60)/sqrt12,
//                                    3.60 being the fitted input of Mou 2024 (PMC11656427, F, M). NO experimental
//                                    logP exists in the sources read (PubChem CID 60795 has none).
//  pKa1    7.46     0.040    2       DrugBank predicted (Kneller 2021, Mou 2024, M); 7.6 (DrugBank via PubChem, S);
//                                    u = (7.6 - 7.46)/sqrt12; ionisation class 2 (monoprotic base; the predicted
//                                    acid pKa 13.5 is irrelevant at pH 7.4)
//  fu      0.01     0.0029   2       "> 99 % bound" (label, L) is an inequality; 0.01 is the input of both PBPK
//                                    papers (M). u = range [0, 0.01]/sqrt12. No measured number was read.
//  B:P     0.61     0.0144   2       0.61 (Zheng 2021 as cited in PMC12081286 Supp Table 4, S, model input);
//                                    0.56 = 1/1.8 from the plasma:whole-blood ratio of Fisher 2013 (PMID 23666566,
//                                    A, n <= 5, haemolysed patient blood); u = (0.61 - 0.56)/sqrt12
//  clint, clform    fitted   3       see the fits below
//  clgut   0        -        0       ASSUMPTION: no gut-wall metabolism (no Fg read; F = 0.86 leaves room for
//                                    fa Fg = 0.9 only, and 18 % of the dose is unchanged in faeces)
//  clren   0.00292  0.0015   1       0.04 mL/h/kg in controls x 73 kg (Mallikaarjun 2008, PMID 18611062, A);
//                                    u = 50 % ASSUMED (no spread in the abstract); < 1 % unchanged in urine (L)
//  kpsc    fitted   3                to V_ss
//  ka      0.2848   0.0282   3       ROUND 2: FITTED to the pooled Tmax of the single-dose TABLET studies, 4.267 h (k = 3:
//                                    label 4.0, Kubo 2007 3.6, Koller 2020 day 1 5.2; u 0.481 h), offline secant on the kernel;
//                                    u = u(Tmax)/|dTmax/dka| = 0.481/17.07. Round 1 used the popPK value 1.67 /h (FDA review), kept as a diagnostic.
//  fa      fitted   3                to the absolute oral bioavailability
//  pssc    1        0        0       placeholder with no source (flow-limited default, circ28_drug.sio); no rate
//                                    observable with a readable source exists (the IV profile is not open)
//
// ---- DEHYDRO-ARIPIPRAZOLE (M) record -----------------------------------------------------------
//  MW      446.38   0        1       Kneller 2021 (F)
//  logP    5.13     0.52     2       mean of 4.98, 5.19, 5.21 (Kneller 2021, M); u = (5.21 - 3.40)/sqrt12, 3.40 = Mou 2024
//  pKa1    7.46     0.040    2       DrugBank predicted (M); u copied from the parent (ASSUMED)
//  fu      0.01     0.0029   2       "> 99 % bound" (label, L); 0.01 Kneller (M), 0.02 Mou (M, parameter identification)
//  B:P     0.61     0.13     2       NOT FOUND. Set equal to the parent (ASSUMED); u = (1.0 - 0.55)/sqrt12
//  kpsc    = parent's fitted scalar  ASSUMPTION (see IDENTIFIABILITY). The declared prediction "Rodgers-Rowland,
//                                    scalar 1" was tested first and is INFEASIBLE: it gives V_ss,M 1980 L, hence
//                                    CL_M 16.4 L/h for a 100.7 h half-life and a formation fraction of 2.6 > 1.
//  clint   fitted   3                to the terminal half-life of M
//  clren   0        -        0       no measured value read (the PBPK papers use 0.03 / 0.06 mL/h/kg, M)
//
// ---- POOLED OBSERVABLES (pooled mean; u = max(pooled SE, between-study SD/sqrt k); ari_pool) ----
//  CL (absolute, L/h at 73 kg), k = 4: 3.066 = 0.7 mL/min/kg x 73 kg (EU SmPC, IV, L); 3.45 x F (Mallikaarjun
//      2004 study 1, A); 4.0 x F (study 2, A); 68.1 mL/h/kg x 73 kg x F (Koller 2020, n = 24, SD 21.4, Ft; this
//      CL/F follows five doses and its computation is not described in what I read). F = 0.86 (below).
//      NOT pooled (not healthy adults): 3.44 L/h at 70 kg, patients 10-17 y (FDA review, Ft), printed only.
//  F, k = 2: 0.87 (label, L), 0.85 (Boulton 2008, n = 18, geometric mean, A).
//  V_ss, k = 1: 4.9 L/kg x 73 kg = 357.7 L (label / SmPC, IV, L). u = (404 - 357.7)/sqrt12: the label gives
//      "404 L or 4.9 L/kg" and the two renderings differ by the study weight. One study, no spread reported.
//  PM/EM parent exposure ratio, k = 3: 1.80 (label, L), 1.50 (Belmonte 2018, 148 healthy, single dose AUC, A),
//      1.730 = 45.5/26.3 (Hendset 2007, TDM medians, 8 PM / 37 EM, A).
//  steady-state M/P ratio in EM, k = 5: 0.40 (label AUC, L); 0.405 = 0.9955 x (37.0 - 26.3)/26.3 (Hendset 2007,
//      molar medians, A); 0.544 = 4.9/9.0 (Suzuki 2011, Japanese wild type, A); 0.27 = middle of 0.20-0.34 (Kim
//      2008, A); 0.464 = 5149.8/11102.4 (Koller 2020 AUC after dose 5, Ft).
//  terminal half-life of M, k = 2: 94 h (label, L), 107.3 h (Koller 2020, SD 62.5, n = 24, Ft).
//
// ---- FITS (one observable per fitted parameter) ---------------------------------------------------
//  P kpsc          -> V_ss 357.7 L
//  P clint+clform  -> pooled CL (closed form of the kernel; cl_renal measured)
//  P fa            -> pooled F: fa = F/(1 - Eh)   (Fg = 1 by the clgut assumption)
//  f2D6            -> pooled PM/EM exposure ratio: (CL/F)_EM/(CL/F)_PM, PM = hepatic intrinsic clearance x (1 - f2D6)
//  fm (= clform/(clint+clform) in EM) -> pooled steady-state M/P ratio (for a linear system the steady-state
//                     AUC ratio over a dosing interval equals the single-dose AUC(0-inf) ratio)
//  M clint         -> pooled terminal half-life of M: CL_M = kappa V_ss,M / t_half, kappa = ari_m_kappa() found
//                     offline on the kernel (the test re-checks the half-life the record gives)
//
// WHICH ENZYME FORMS THE METABOLITE. Both CYP2D6 and CYP3A4 dehydrogenate (label). phi_D = share of the CYP2D6
// clearance that is dehydrogenation, phi_A = share of the remaining (non-2D6) clearance that is dehydrogenation,
// fm = f2D6 phi_D + (1 - f2D6) phi_A. BASE ASSUMPTION r = phi_A/phi_D = 1 (the same share in both enzymes; this
// is also what Kneller 2021 assumed: 40 % in each). Then a PM forms the same fraction of the dose as an EM and
// the metabolite exposure does not change with phenotype. The label's -30 % in PMs is the TEST of r = 1 (a
// validation row), and the r that -30 % would need is printed as a diagnosis, not adopted.
//
// IDENTIFIABILITY OF THE METABOLITE. No human dosing of dehydro-aripiprazole was found. With parent data only,
// the half-life of M fixes CL_M / V_ss,M and the M/P ratio fixes fm / CL_M; V_ss,M itself is free. The record
// therefore lies on a one-parameter family: fm and CL_M both scale with the assumed V_ss,M. fm <= 1 bounds
// V_ss,M from above (about 990 L). Rodgers-Rowland cannot place it: with the two PBPK papers' logP (5.21 and
// 3.40) and fu (0.01, 0.02) it gives 56 to 3960 L.
//
// WHAT IS VALIDATION: single-dose Cmax (Tmax until round 1 only), AUC(0-24), AUC(0-72); half-lives of P; Cmax
// after five daily doses and the accumulation; steady-state concentration/dose; time to steady state; the PM
// half-life, metabolite change and active moiety; the ketoconazole, quinidine and carbamazepine what-ifs;
// unchanged drug in faeces (bound on fa). Expectations are in tests/run-pass/circ28_drug_aripiprazole.sio.

use darwin_pbpk::circ28::*
use darwin_pbpk::circ28_kp::*
use darwin_pbpk::circ28_drug::*
use darwin_pbpk::circ28_metab::*
use math::pure::{exp, ln}

// ---- measured / derived inputs ---------------------------------------------------------------
pub fn ari_p_mw() -> f64 { return 448.38 }
pub fn ari_p_logp() -> f64 { return 5.07 }
pub fn ari_p_u_logp() -> f64 { return 0.46 }
pub fn ari_p_pka1() -> f64 { return 7.46 }
pub fn ari_p_u_pka1() -> f64 { return 0.040 }
pub fn ari_p_fu() -> f64 { return 0.01 }
pub fn ari_p_u_fu() -> f64 { return 0.0029 }
pub fn ari_p_bp() -> f64 { return 0.61 }
pub fn ari_p_u_bp() -> f64 { return 0.0144 }
pub fn ari_p_clren() -> f64 { return 0.00292 }
pub fn ari_p_u_clren() -> f64 { return 0.0015 }
pub fn ari_p_ka() -> f64 { return 0.284844 }
pub fn ari_p_ka_poppk() -> f64 { return 1.67 }
pub fn ari_p_u_ka() -> f64 { return 0.02817 }
pub fn ari_m_mw() -> f64 { return 446.38 }
pub fn ari_m_logp() -> f64 { return 5.13 }
pub fn ari_m_u_logp() -> f64 { return 0.52 }
pub fn ari_m_pka1() -> f64 { return 7.46 }
pub fn ari_m_u_pka1() -> f64 { return 0.040 }
pub fn ari_m_fu() -> f64 { return 0.01 }
pub fn ari_m_u_fu() -> f64 { return 0.0029 }
pub fn ari_m_bp() -> f64 { return 0.61 }
pub fn ari_m_u_bp() -> f64 { return 0.13 }

pub fn ari_weight() -> f64 { return 73.0 }

// r = phi_A/phi_D, the base assumption on which enzyme forms the metabolite (see the header).
pub fn ari_r_base() -> f64 { return 1.0 }

// kappa = CL_M t_half,M / V_ss,M on the kernel (offline secant on the terminal slope of M after an oral
// dose of the parent, window 1200-1680 h, six iterations to 100.650 h; ln 2 = 0.6931 would be the
// one-compartment value). With it CL_M = 3.437 L/h, V_ss,M = 414.9 L and fm = 0.4196.
pub fn ari_m_kappa() -> f64 { return 0.833746 }

fn ari_abs(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

// ---- pooling -----------------------------------------------------------------------------------
// x[0..k-1] study means, se[i] the standard error of study i (0 when not reported).
// out[0] pooled mean, out[1] between-study SD, out[2] u = max(sqrt(sum se^2)/k, SD/sqrt k).
pub fn ari_pool(x: &[f64; 8], se: &[f64; 8], k: i32, out: &![f64; 3]) with Mut, Div, Panic {
    var s = 0.0
    var q = 0.0
    var i: i32 = 0
    while i < k {
        s = s + (*x)[i]
        q = q + (*se)[i] * (*se)[i]
        i = i + 1
    }
    let kf = k as f64
    let m = s / kf
    var v = 0.0
    i = 0
    while i < k {
        v = v + ((*x)[i] - m) * ((*x)[i] - m)
        i = i + 1
    }
    var sd = 0.0
    if k > 1 { sd = cd_sqrt(v / (kf - 1.0)) }
    let u1 = cd_sqrt(q) / kf
    let u2 = sd / cd_sqrt(kf)
    var u = u1
    if u2 > u { u = u2 }
    (*out)[0] = m
    (*out)[1] = sd
    (*out)[2] = u
}

// Study values of each pooled observable (sources in the header). id:
//   0 F   1 CL (L/h, absolute, 73 kg)   2 V_ss (L)   3 PM/EM parent exposure ratio   4 M/P ratio (EM, steady state)
//   5 t_half M (h)   6 t_half P (h; VALIDATION)   7 Tmax P (h; VALIDATION)   8 PM/EM active moiety (VALIDATION)
//   9 PM/EM metabolite exposure (VALIDATION)
// Returns k and fills x, se.
pub fn ari_studies(id: i32, x: &![f64; 8], se: &![f64; 8]) -> i32 with Mut, Div, Panic {
    var i: i32 = 0
    while i < 8 {
        (*x)[i] = 0.0
        (*se)[i] = 0.0
        i = i + 1
    }
    let w = ari_weight()
    if id == 0 {
        (*x)[0] = 0.87
        (*x)[1] = 0.85
        return 2
    }
    if id == 1 {
        let f = 0.5 * (0.87 + 0.85)
        (*x)[0] = 0.7 * 60.0 / 1000.0 * w
        (*x)[1] = 3.45 * f
        (*x)[2] = 4.0 * f
        (*x)[3] = 68.1 / 1000.0 * w * f
        (*se)[3] = 21.4 / cd_sqrt(24.0) / 1000.0 * w * f
        return 4
    }
    if id == 2 {
        (*x)[0] = 4.9 * w
        (*se)[0] = (404.0 - 4.9 * w) / cd_sqrt(12.0)
        return 1
    }
    if id == 3 {
        (*x)[0] = 1.80
        (*x)[1] = 1.50
        (*x)[2] = 45.5 / 26.3
        return 3
    }
    if id == 4 {
        (*x)[0] = 0.40
        (*x)[1] = (ari_m_mw() / ari_p_mw()) * (37.0 - 26.3) / 26.3
        (*x)[2] = 4.9 / 9.0
        (*x)[3] = 0.5 * (0.20 + 0.34)
        (*x)[4] = 5149.8 / 11102.4
        return 5
    }
    if id == 5 {
        (*x)[0] = 94.0
        (*x)[1] = 107.3
        (*se)[1] = 62.5 / cd_sqrt(24.0)
        return 2
    }
    if id == 6 {
        (*x)[0] = 75.0
        (*x)[1] = 0.5 * (47.0 + 68.0)
        (*x)[2] = 59.0
        (*x)[3] = 61.0
        (*x)[4] = 66.1
        (*se)[4] = 24.6 / cd_sqrt(24.0)
        return 5
    }
    if id == 7 {
        (*x)[0] = 4.0
        (*x)[1] = 3.6
        (*x)[2] = 5.2
        (*se)[2] = 2.4 / cd_sqrt(24.0)
        return 3
    }
    if id == 8 {
        (*x)[0] = 1.60
        (*x)[1] = 1.585
        (*se)[1] = (1.724 - 1.447) / 3.92
        (*x)[2] = 53.9 / 37.0
        (*x)[3] = 1.7
        return 4
    }
    (*x)[0] = 0.70
    (*x)[1] = 0.67
    return 2
}

// Pooled mean (which = 0), between-study SD (1) or u (2) of observable id.
pub fn ari_obs(id: i32, which: i32) -> f64 with Mut, Div, Panic {
    var x: [f64; 8] = [0.0; 8]
    var se: [f64; 8] = [0.0; 8]
    var o: [f64; 3] = [0.0; 3]
    let k = ari_studies(id, &!x, &!se)
    ari_pool(&x, &se, k, &!o)
    return o[which]
}

// ---- closed forms on a record array ------------------------------------------------------------
// y = hepatic CL/F-type quantity c ps/(ps + c), c = (clint + clform) fu  (plasma, L/h)
pub fn ari_y(th: [f64; 18]) -> f64 with Mut, Div, Panic {
    var tl = th
    let p = circ28_drug_params_theta(tl)
    let c = (p.clint + p.clform) * p.fu
    return c * p.ps[1] / (p.ps[1] + c)
}

// Oral clearance of the absorbed dose, CL/(1 - Eh) = y (1 + clren/B) + clren, B = bp Qh (plasma, L/h).
// AUC(0-inf) after an oral dose D is fa D / this.
pub fn ari_clf(th: [f64; 18]) -> f64 with Mut, Div, Panic {
    var tl = th
    let p = circ28_drug_params_theta(tl)
    let c = (p.clint + p.clform) * p.fu
    let y = c * p.ps[1] / (p.ps[1] + c)
    let bb = p.bp * circ28_q_hepatic(p)
    return y * (1.0 + p.cl_renal / bb) + p.cl_renal
}

// Total plasma clearance (L/h): hepatic bp Qh Eh plus renal.
pub fn ari_cl(th: [f64; 18]) -> f64 with Mut, Div, Panic {
    var tl = th
    let p = circ28_drug_params_theta(tl)
    return circ28_hepatic_extraction(p) * circ28_q_hepatic(p) * p.bp + p.cl_renal
}

pub fn ari_eh(th: [f64; 18]) -> f64 with Mut, Div, Panic {
    var tl = th
    let p = circ28_drug_params_theta(tl)
    return circ28_hepatic_extraction(p)
}

pub fn ari_vss(th: [f64; 18]) -> f64 with Mut, Div, Panic {
    var tl = th
    let p = circ28_drug_params_theta(tl)
    return circ28_vss_plasma(p)
}

// Fraction of the metabolite formed in liver tissue that leaves the liver.
pub fn ari_fsrc(thm: [f64; 18]) -> f64 with Mut, Div, Panic {
    var tl = thm
    let p = circ28_drug_params_theta(tl)
    let c = p.clint * p.fu
    return 1.0 / (1.0 + c / (circ28_q_hepatic(p) * p.bp) + c / p.ps[1])
}

// Total hepatic intrinsic clearance (clint + clform, L/h of unbound drug) giving the plasma clearance cl
// with renal clearance clren. Returns -1 when impossible.
pub fn ari_tot_for_cl(th: [f64; 18], cl: f64, clren: f64) -> f64 with Mut, Div, Panic {
    var tl = th
    let p = circ28_drug_params_theta(tl)
    let bb = p.bp * circ28_q_hepatic(p)
    let clh = cl - clren
    let eh = clh / bb
    if !(eh > 0.0) || !(eh < 1.0) { return 0.0 - 1.0 }
    let y = clh / (1.0 - eh)
    if !(p.ps[1] > y) { return 0.0 - 1.0 }
    return (y * p.ps[1] / (p.ps[1] - y)) / p.fu
}

// Total hepatic intrinsic clearance giving the oral clearance clf (= CL/(1 - Eh)).
pub fn ari_tot_for_clf(th: [f64; 18], clf: f64, clren: f64) -> f64 with Mut, Div, Panic {
    var tl = th
    let p = circ28_drug_params_theta(tl)
    let bb = p.bp * circ28_q_hepatic(p)
    let y = (clf - clren) / (1.0 + clren / bb)
    if !(y > 0.0) || !(p.ps[1] > y) { return 0.0 - 1.0 }
    return (y * p.ps[1] / (p.ps[1] - y)) / p.fu
}

// ---- the fits ------------------------------------------------------------------------------------
// Parent, step 1: Kp scalar to V_ss, total hepatic intrinsic clearance to CL (all of it booked in clint for
// now), fa to F. Sets CD_KPSC, CD_CLINT, CD_CLFORM = 0, CD_FA; CD_CLINT = -1 if impossible.
pub fn ari_fit_p1(th: [f64; 18], vss: f64, cl: f64, f_obs: f64) -> [f64; 18] with Mut, Div, Panic {
    var t = th
    t[CD_KPSC] = 1.0
    t[CD_CLINT] = 0.0
    t[CD_CLFORM] = 0.0
    let p0 = circ28_drug_params_theta(t)
    let sc = circ28_kp_scale_for_vss(p0, p0.kp, vss)
    if !(sc > 0.0) {
        t[CD_CLINT] = 0.0 - 1.0
        return t
    }
    t[CD_KPSC] = sc
    let tot = ari_tot_for_cl(t, cl, t[CD_CLREN])
    t[CD_CLINT] = tot
    if tot > 0.0 {
        t[CD_FA] = f_obs / (1.0 - ari_eh(t))
    }
    return t
}

// CYP2D6 share of the hepatic intrinsic clearance from the PM/EM exposure ratio
// (CL/F)_EM/(CL/F)_PM = pmratio. th must hold the EM total in clint + clform. Returns -1 if impossible.
pub fn ari_f2d6(th: [f64; 18], pmratio: f64) -> f64 with Mut, Div, Panic {
    let tot = th[CD_CLINT] + th[CD_CLFORM]
    let clf_em = ari_clf(th)
    let totpm = ari_tot_for_clf(th, clf_em / pmratio, th[CD_CLREN])
    if !(totpm > 0.0) { return 0.0 - 1.0 }
    return 1.0 - totpm / tot
}

// Metabolite: Kp scalar given (the parent's, see the header), hepatic intrinsic clearance to the half-life
// through CL_M = kappa V_ss,M / t_half. CD_CLINT = -1 if impossible.
pub fn ari_fit_m(th: [f64; 18], kpsc: f64, thalf: f64, kappa: f64) -> [f64; 18] with Mut, Div, Panic {
    var t = th
    t[CD_KPSC] = kpsc
    t[CD_CLINT] = 0.0
    t[CD_CLFORM] = 0.0
    t[CD_CLREN] = 0.0
    let vss = ari_vss(t)
    let cl = kappa * vss / thalf
    t[CD_CLINT] = ari_tot_for_cl(t, cl, 0.0)
    return t
}

// Formation fraction fm = clform/(clint + clform) of the EM parent giving the oral AUC(0-inf) ratio
// AUC_M/AUC_P = ratio (mass units):
//   ratio = MWr fm Fsrc (1 - clren (1 - Eh)/CL) CL / ((1 - Eh) CL_M)
pub fn ari_fm(thp: [f64; 18], thm: [f64; 18], ratio: f64) -> f64 with Mut, Div, Panic {
    let mwr = thm[CD_MW] / thp[CD_MW]
    let eh = ari_eh(thp)
    let cl = ari_cl(thp)
    let clm = ari_cl(thm)
    let hep = 1.0 - thp[CD_CLREN] * (1.0 - eh) / cl
    return ratio * (1.0 - eh) * clm / (mwr * ari_fsrc(thm) * hep * cl)
}

// Parent, step 2: split the total into clform = fm tot and clint = (1 - fm) tot.
pub fn ari_split(th: [f64; 18], fm: f64) -> [f64; 18] with Mut, Div, Panic {
    var t = th
    let tot = th[CD_CLINT] + th[CD_CLFORM]
    t[CD_CLFORM] = fm * tot
    t[CD_CLINT] = (1.0 - fm) * tot
    return t
}

// Scenario of the parent: the CYP2D6 part of the hepatic intrinsic clearance times s2d6, the rest times
// srest (s2d6 = 0, srest = 1: poor metaboliser). phi_D = fm/(f + (1 - f) r), phi_A = r phi_D.
// (Labelled what-ifs: the "rest" is treated as CYP3A4 for the inhibitor and inducer rows.)
pub fn ari_scenario(th: [f64; 18], f: f64, r: f64, s2d6: f64, srest: f64) -> [f64; 18] with Mut, Div, Panic {
    var t = th
    let tot = th[CD_CLINT] + th[CD_CLFORM]
    let fm = th[CD_CLFORM] / tot
    let phid = fm / (f + (1.0 - f) * r)
    let phia = r * phid
    let a = f * s2d6 * tot
    let b = (1.0 - f) * srest * tot
    t[CD_CLFORM] = phid * a + phia * b
    t[CD_CLINT] = (1.0 - phid) * a + (1.0 - phia) * b
    return t
}

// The same with phi_D and phi_A given directly (used by the enzyme-assignment diagnostic: formation entirely
// by the non-2D6 route is phi_D = 0, phi_A = fm/(1 - f); entirely by CYP2D6 is phi_D = fm/f, phi_A = 0).
pub fn ari_scenario_phi(th: [f64; 18], f: f64, phid: f64, phia: f64, s2d6: f64, srest: f64) -> [f64; 18] with Mut, Div, Panic {
    var t = th
    let tot = th[CD_CLINT] + th[CD_CLFORM]
    let a = f * s2d6 * tot
    let b = (1.0 - f) * srest * tot
    t[CD_CLFORM] = phid * a + phia * b
    t[CD_CLINT] = (1.0 - phid) * a + (1.0 - phia) * b
    return t
}

// Oral AUC(0-inf) ratio M/P of a pair of record arrays (closed form; the inverse of ari_fm).
pub fn ari_ratio_cf(thp: [f64; 18], thm: [f64; 18]) -> f64 with Mut, Div, Panic {
    let mwr = thm[CD_MW] / thp[CD_MW]
    let eh = ari_eh(thp)
    let cl = ari_cl(thp)
    let fm = thp[CD_CLFORM] / (thp[CD_CLINT] + thp[CD_CLFORM])
    let hep = 1.0 - thp[CD_CLREN] * (1.0 - eh) / cl
    return mwr * fm * ari_fsrc(thm) * hep * cl / ((1.0 - eh) * ari_cl(thm))
}

// ---- records -------------------------------------------------------------------------------------
pub fn ari_measured_p(d: &!Circ28Drug) with Mut, Div, Panic, Epistemic {
    circ28_drug_set(d, CD_MW, ari_p_mw(), 0.0, CD_STATUS_MEASURED, "Abilify label")
    circ28_drug_set(d, CD_LOGP, ari_p_logp(), ari_p_u_logp(), CD_STATUS_DERIVED, "mean of predicted 4.9, 5.21, 5.11 (Kneller2021); u to Mou2024 3.60; no experimental value")
    circ28_drug_set(d, CD_PKA1, ari_p_pka1(), ari_p_u_pka1(), CD_STATUS_DERIVED, "DrugBank predicted 7.46 (Kneller2021, Mou2024); 7.6 PubChem; u = range/sqrt12")
    circ28_drug_set(d, CD_ION, 2.0, 0.0, CD_STATUS_DERIVED, "monoprotic base")
    circ28_drug_set(d, CD_FU, ari_p_fu(), ari_p_u_fu(), CD_STATUS_DERIVED, "label > 99 % bound (inequality); 0.01 = PBPK model input; u = [0, 0.01]/sqrt12")
    circ28_drug_set(d, CD_BP, ari_p_bp(), ari_p_u_bp(), CD_STATUS_DERIVED, "0.61 Zheng2021 via PMC12081286 supp (model input); 0.56 from Fisher2013 1/1.8")
    circ28_drug_set(d, CD_CLREN, ari_p_clren(), ari_p_u_clren(), CD_STATUS_MEASURED, "0.04 mL/h/kg x 73 kg, Mallikaarjun2008 PMID 18611062 (abstract); u 50 % assumed")
    circ28_drug_set(d, CD_KA, ari_p_ka(), ari_p_u_ka(), CD_STATUS_FITTED, "fitted to the pooled Tmax 4.267 h of the single-dose tablet studies (k = 3); offline secant")
}

pub fn ari_measured_m(d: &!Circ28Drug) with Mut, Div, Panic, Epistemic {
    circ28_drug_set(d, CD_MW, ari_m_mw(), 0.0, CD_STATUS_MEASURED, "Kneller2021")
    circ28_drug_set(d, CD_LOGP, ari_m_logp(), ari_m_u_logp(), CD_STATUS_DERIVED, "mean of predicted 4.98, 5.19, 5.21 (Kneller2021); u to Mou2024 3.40")
    circ28_drug_set(d, CD_PKA1, ari_m_pka1(), ari_m_u_pka1(), CD_STATUS_DERIVED, "DrugBank predicted 7.46; u copied from the parent (assumed)")
    circ28_drug_set(d, CD_ION, 2.0, 0.0, CD_STATUS_DERIVED, "monoprotic base")
    circ28_drug_set(d, CD_FU, ari_m_fu(), ari_m_u_fu(), CD_STATUS_DERIVED, "label > 99 % bound; 0.01 Kneller2021, 0.02 Mou2024 (model inputs)")
    circ28_drug_set(d, CD_BP, ari_m_bp(), ari_m_u_bp(), CD_STATUS_DERIVED, "NOT FOUND: set equal to the parent (assumed)")
}

// Each fitting step is its own function and is called from main in the test (lean_single mis-forwards
// chained references; Madaros dislikes frames holding records plus several [f64; 18] arrays).
pub fn ari_fit_record_p1(d: &!Circ28Drug) with Mut, Div, Panic, Epistemic {
    let th0 = circ28_drug_theta(d)
    let th = ari_fit_p1(th0, ari_obs(2, 0), ari_obs(1, 0), ari_obs(0, 0))
    circ28_drug_set(d, CD_KPSC, th[CD_KPSC], 0.0, CD_STATUS_FITTED, "fitted to Vss 4.9 L/kg x 73 kg (label, IV; one study)")
    circ28_drug_set(d, CD_CLINT, th[CD_CLINT], 0.0, CD_STATUS_FITTED, "total hepatic intrinsic clearance fitted to the pooled CL (k = 4); split in step 2")
    circ28_drug_set(d, CD_FA, th[CD_FA], 0.0, CD_STATUS_FITTED, "fa = F/(1 - Eh), pooled F 0.86 (label 0.87, Boulton2008 0.85); Fg = 1 assumed")
}

pub fn ari_fit_record_m(dm: &!Circ28Drug, kpsc_parent: f64) with Mut, Div, Panic, Epistemic {
    let th0 = circ28_drug_theta(dm)
    let th = ari_fit_m(th0, kpsc_parent, ari_obs(5, 0), ari_m_kappa())
    circ28_drug_set(dm, CD_KPSC, th[CD_KPSC], 0.0, CD_STATUS_DERIVED, "ASSUMED equal to the parent's fitted Kp scalar (no direct dosing of the metabolite)")
    circ28_drug_set(dm, CD_CLINT, th[CD_CLINT], 0.0, CD_STATUS_FITTED, "fitted to the pooled terminal half-life of the metabolite (label 94 h, Koller2020 107.3 h)")
}

pub fn ari_fit_record_p2(d: &!Circ28Drug, fm: f64) with Mut, Div, Panic, Epistemic {
    let th0 = circ28_drug_theta(d)
    let th = ari_split(th0, fm)
    circ28_drug_set(d, CD_CLINT, th[CD_CLINT], 0.0, CD_STATUS_FITTED, "(1 - fm) x total hepatic intrinsic clearance")
    circ28_drug_set(d, CD_CLFORM, th[CD_CLFORM], 0.0, CD_STATUS_FITTED, "fm x total; fm fitted to the pooled steady-state metabolite/parent ratio (k = 5)")
}

// ---- coupled run with superposition to steady state -------------------------------------------
// Grid: 0.05 h to 4 h (80 steps), 0.25 h to 24 h (80), 1 h to 240 h (216), then `tail` hours to 1680 h
// (tail = 8: 180 steps, 556 in all; tail = 2: 720 steps, 1096 in all, used by the test as a convergence
// check). The scheme is L-stable and its tallies are exact at any step, so the large steps cost only the
// O(dt^2) error of the slow modes. Multiple dosing is obtained by SUPERPOSITION of this one single-dose
// run (the system is linear): C_ss(h) = sum over k of C_single(h + 24 k), with a geometric tail beyond 1680 h.
pub fn ari_tend() -> f64 { return 1680.0 }

fn ari_round(x: f64) -> i32 { return (x + 0.5) as i32 }

// Index of the last sample for a given tail step.
pub fn ari_nend(tail: f64) -> i32 { return 376 + ari_round(1440.0 / tail) }

// Concentration at time t (h) from the grid samples; log-linear interpolation on the tail part.
pub fn ari_c_at(cs: &[f64; 1100], t: f64, tail: f64) -> f64 with Mut, Div, Panic {
    if t <= 4.0 { return (*cs)[ari_round(20.0 * t)] }
    if t <= 24.0 { return (*cs)[80 + ari_round(4.0 * (t - 4.0))] }
    if t <= 240.0 { return (*cs)[160 + ari_round(t - 24.0)] }
    if t >= 1680.0 { return (*cs)[ari_nend(tail)] }
    let pos = (t - 240.0) / tail
    let i0 = (pos + 1.0e-9) as i32
    let fr = pos - (i0 as f64)
    let a = (*cs)[376 + i0]
    if fr < 1.0e-6 { return a }
    let b = (*cs)[377 + i0]
    if a > 0.0 && b > 0.0 { return exp((1.0 - fr) * ln(a) + fr * ln(b)) }
    return (1.0 - fr) * a + fr * b
}

// Concentration at hour h (0..24) of the dosing interval after nd daily doses (nd = 0: steady state,
// with the geometric tail beyond the grid).
pub fn ari_super(cs: &[f64; 1100], h: f64, nd: i32, tail: f64) -> f64 with Mut, Div, Panic {
    var s = 0.0
    var k: i32 = 0
    var kmax: i32 = 69
    if nd > 0 { kmax = nd - 1 }
    while k <= kmax {
        let t = h + 24.0 * (k as f64)
        if t <= 1680.0 { s = s + ari_c_at(cs, t, tail) }
        k = k + 1
    }
    if nd == 0 {
        // terms beyond the grid decay by q per interval, q from the last 24 h of the grid; the last term
        // used above is at t = h + 24 x 69 (1656..1680 h)
        let ne = ari_nend(tail)
        let c1 = (*cs)[ne]
        let c0 = (*cs)[ne - ari_round(24.0 / tail)]
        if c0 > 0.0 && c1 > 0.0 && c1 < c0 {
            let q = c1 / c0
            s = s + ari_c_at(cs, h + 24.0 * 69.0, tail) * q / (1.0 - q)
        }
    }
    return s
}

// Least-squares terminal slope of ln c on t over [lo, hi].
pub fn ari_lz(ts: &[f64; 1100], cs: &[f64; 1100], n: i32, lo: f64, hi: f64) -> f64 with Mut, Div, Panic {
    var sw = 0.0
    var st = 0.0
    var sy = 0.0
    var stt = 0.0
    var sty = 0.0
    var nf: i32 = 0
    var i: i32 = 1
    while i <= n {
        if (*ts)[i] >= lo && (*ts)[i] <= hi {
            if (*cs)[i] > 0.0 {
                let y = ln((*cs)[i])
                sw = sw + 1.0
                st = st + (*ts)[i]
                sy = sy + y
                stt = stt + (*ts)[i] * (*ts)[i]
                sty = sty + (*ts)[i] * y
                nf = nf + 1
            }
        }
        i = i + 1
    }
    if nf < 3 { return 0.0 }
    let den = sw * stt - st * st
    let lz = 0.0 - (sw * sty - st * sy) / den
    if !(lz > 0.0) { return 0.0 }
    return lz
}

// Peak on the grid with the vertex refinement (equal spacing only): out[0] cmax, out[1] tmax.
pub fn ari_peak(ts: &[f64; 1100], cs: &[f64; 1100], n: i32, out: &![f64; 2]) with Mut, Div, Panic {
    var im: i32 = 0
    var cm = 0.0
    var i: i32 = 1
    while i <= n {
        if (*cs)[i] > cm {
            cm = (*cs)[i]
            im = i
        }
        i = i + 1
    }
    (*out)[0] = cm
    (*out)[1] = (*ts)[im]
    if im >= 1 && im < n {
        let h1 = (*ts)[im] - (*ts)[im - 1]
        let h2 = (*ts)[im + 1] - (*ts)[im]
        if ari_abs(h1 - h2) < 1.0e-9 {
            let den = (*cs)[im - 1] - 2.0 * (*cs)[im] + (*cs)[im + 1]
            if den < 0.0 {
                let off = 0.5 * ((*cs)[im - 1] - (*cs)[im + 1]) / den
                (*out)[1] = (*ts)[im] + off * h1
                (*out)[0] = (*cs)[im] - 0.25 * ((*cs)[im - 1] - (*cs)[im + 1]) * off
            }
        }
    }
}

// Profile of one dosing interval after nd doses (nd = 0 steady state) on a 0.25 h grid over 0..24 h:
// maximum (vertex-refined) into out[0], its time into out[1], the value at 24 h (trough) into out[2].
// mode 0: curve a alone; mode 1: a + b (active moiety).
pub fn ari_interval(ca: &[f64; 1100], cb: &[f64; 1100], mode: i32, nd: i32, tail: f64, out: &![f64; 3]) with Mut, Div, Panic {
    var v: [f64; 97] = [0.0; 97]
    var j: i32 = 0
    while j < 97 {
        let h = 0.25 * (j as f64)
        var c = ari_super(ca, h, nd, tail)
        if mode == 1 { c = c + ari_super(cb, h, nd, tail) }
        v[j] = c
        j = j + 1
    }
    var im: i32 = 0
    var cm = 0.0
    j = 0
    while j < 97 {
        if v[j] > cm {
            cm = v[j]
            im = j
        }
        j = j + 1
    }
    (*out)[0] = cm
    (*out)[1] = 0.25 * (im as f64)
    if im >= 1 && im < 96 {
        let den = v[im - 1] - 2.0 * v[im] + v[im + 1]
        if den < 0.0 {
            let off = 0.5 * (v[im - 1] - v[im + 1]) / den
            (*out)[1] = 0.25 * ((im as f64) + off)
            (*out)[0] = v[im] - 0.25 * (v[im - 1] - v[im + 1]) * off
        }
    }
    (*out)[2] = v[96]
}

// Result layout (res), concentrations in mg/L of plasma (venous blood / bp), times in h:
//   0 P Cmax   1 P Tmax   2 P AUCinf   3 P t1/2 (wp_lo..wp_hi)   4 P AUC0-24   5 P AUC0-72
//   6 M Cmax   7 M Tmax   8 M AUCinf   9 M t1/2 (wm_lo..wm_hi)  10 M AUC0-24
//  11 input (mg P)  12 P balance error  13 M balance error  14 grid ok  15 mass given to M (mg)
//  16 P Cmax,ss  17 P Tmax,ss  18 P trough,ss   19 M Cmax,ss  20 M trough,ss
//  21 AM Cmax,ss  22 AM trough,ss
//  23 P Cmax after dose 5   24 M Cmax after dose 5   25 P trough before dose 15 / trough,ss (day 14)
//  26 M trough day 14 / trough,ss   27 P apparent t1/2 over 96-240 h   28 M apparent t1/2 over 336-576 h
//  29 P AUC0-T   30 M AUC0-T   31 P c(T)   32 M c(T)   33 P c(24 h)   34 P c(4 h)
// route 0: intravenous infusion over t_inf; route 1: oral (ka, fa, tlag from the parent array).
// tail: 8.0 (default grid) or 2.0 (convergence check); 24/tail must be an integer.
pub fn ari_run_th(
    thp_in: [f64; 18], thm_in: [f64; 18], route: i32, dose: f64, t_inf: f64, tail: f64,
    wp_lo: f64, wp_hi: f64, wm_lo: f64, wm_hi: f64, res: &![f64; 40]
) with Mut, Div, Panic {
    var thp = thp_in
    var thm = thm_in
    let pp = circ28_drug_params_theta(thp)
    let pm = circ28_drug_params_theta(thm)
    let cp = circ28_coupling(thm[CD_MW] / thp[CD_MW], 0.0)
    var ts: [f64; 1100] = [0.0; 1100]
    var cpar: [f64; 1100] = [0.0; 1100]
    var cmet: [f64; 1100] = [0.0; 1100]
    var sysp = circ28_sys_zero()
    var sysm = circ28_sys_zero()
    var sp = circ28_state_zero()
    var sm = circ28_state_zero()
    var elp = circ28_elim_zero()
    var elm = circ28_elim_zero()
    var n: i32 = 0
    var t = 0.0
    var input = 0.0
    var given = 0.0
    var ok = 1.0
    var a24p = 0.0
    var a72p = 0.0
    var a24m = 0.0
    var ph: i32 = 0
    while ph < 4 {
        var dt = 0.05
        var tstop = 4.0
        if ph == 1 {
            dt = 0.25
            tstop = 24.0
        }
        if ph == 2 {
            dt = 1.0
            tstop = 240.0
        }
        if ph == 3 {
            dt = tail
            tstop = 1680.0
        }
        circ28_prepare(pp, dt, &!sysp)
        circ28_prepare(pm, dt, &!sysm)
        while t + 0.5 * dt < tstop {
            if n >= 1099 {
                ok = 0.0
                t = tstop
            } else {
                var iv = 0.0
                var oral = 0.0
                var mass = 0.0
                if route == 0 {
                    mass = circ28_iv_mass(dose, t_inf, t, t + dt)
                    iv = mass / dt
                } else {
                    mass = circ28_oral_mass(thp[CD_KA], thp[CD_FA], dose, thp[CD_TLAG], t, t + dt)
                    oral = mass / dt
                }
                input = input + mass
                given = given + circ28_metab_step(&!sp, pp, &sysp, &!elp, &!sm, pm, &sysm, &!elm, cp, iv, oral)
                t = t + dt
                n = n + 1
                ts[n] = t
                cpar[n] = sp.x[0] / pp.bp
                cmet[n] = sm.x[0] / pm.bp
                if n == 160 {
                    a24p = elp.auc_ven / pp.bp
                    a24m = elm.auc_ven / pm.bp
                }
                if n == 208 { a72p = elp.auc_ven / pp.bp }
            }
        }
        ph = ph + 1
    }
    if n != ari_nend(tail) { ok = 0.0 }
    var pk: [f64; 2] = [0.0; 2]
    ari_peak(&ts, &cpar, n, &!pk)
    (*res)[0] = pk[0]
    (*res)[1] = pk[1]
    ari_peak(&ts, &cmet, n, &!pk)
    (*res)[6] = pk[0]
    (*res)[7] = pk[1]
    let lzp = ari_lz(&ts, &cpar, n, wp_lo, wp_hi)
    let lzm = ari_lz(&ts, &cmet, n, wm_lo, wm_hi)
    let auc_p = elp.auc_ven / pp.bp
    let auc_m = elm.auc_ven / pm.bp
    (*res)[29] = auc_p
    (*res)[30] = auc_m
    (*res)[2] = auc_p
    (*res)[8] = auc_m
    (*res)[3] = 0.0
    (*res)[9] = 0.0
    if lzp > 0.0 {
        (*res)[3] = 0.6931471805599453 / lzp
        (*res)[2] = auc_p + cpar[n] / lzp
    }
    if lzm > 0.0 {
        (*res)[9] = 0.6931471805599453 / lzm
        (*res)[8] = auc_m + cmet[n] / lzm
    }
    (*res)[4] = a24p
    (*res)[5] = a72p
    (*res)[10] = a24m
    (*res)[11] = input
    let eli_p = elp.hepatic + elp.formed + elp.renal + elp.plasma + elp.gut
    var bep = 0.0
    if input > 0.0 { bep = ari_abs(input - eli_p - circ28_total_mass(&sp, pp)) / input }
    (*res)[12] = bep
    let eli_m = elm.hepatic + elm.formed + elm.renal + elm.plasma + elm.gut
    var bem = 0.0
    if given > 0.0 { bem = ari_abs(given - eli_m - circ28_total_mass(&sm, pm)) / given }
    (*res)[13] = bem
    (*res)[14] = ok
    (*res)[15] = given
    var iv3: [f64; 3] = [0.0; 3]
    ari_interval(&cpar, &cmet, 0, 0, tail, &!iv3)
    (*res)[16] = iv3[0]
    (*res)[17] = iv3[1]
    (*res)[18] = iv3[2]
    let trp = iv3[2]
    ari_interval(&cmet, &cpar, 0, 0, tail, &!iv3)
    (*res)[19] = iv3[0]
    (*res)[20] = iv3[2]
    let trm = iv3[2]
    ari_interval(&cpar, &cmet, 1, 0, tail, &!iv3)
    (*res)[21] = iv3[0]
    (*res)[22] = iv3[2]
    ari_interval(&cpar, &cmet, 0, 5, tail, &!iv3)
    (*res)[23] = iv3[0]
    ari_interval(&cmet, &cpar, 0, 5, tail, &!iv3)
    (*res)[24] = iv3[0]
    (*res)[25] = ari_super(&cpar, 24.0, 14, tail) / trp
    (*res)[26] = ari_super(&cmet, 24.0, 14, tail) / trm
    let l1 = ari_lz(&ts, &cpar, n, 96.0, 240.0)
    let l2 = ari_lz(&ts, &cmet, n, 336.0, 576.0)
    (*res)[27] = 0.0
    (*res)[28] = 0.0
    if l1 > 0.0 { (*res)[27] = 0.6931471805599453 / l1 }
    if l2 > 0.0 { (*res)[28] = 0.6931471805599453 / l2 }
    (*res)[31] = cpar[n]
    (*res)[32] = cmet[n]
    (*res)[33] = cpar[160]
    (*res)[34] = cpar[80]
}

// ---- uncertainty budget with refit --------------------------------------------------------------
// Thirteen inputs: 0 CL obs, 1 Vss obs, 2 F obs, 3 PM/EM ratio obs, 4 M/P ratio obs, 5 t_half M obs,
// 6 ka, 7 logP P, 8 fu P, 9 bp P, 10 logP M, 11 bp M, 12 pKa P. Each evaluation refits the parent, the
// metabolite and the split in closed form and runs one coupled oral dose with superposition.
// out: 0 active-moiety trough at steady state, 1 parent trough, 2 metabolite trough, 3 parent AUCinf
// (all per `dose` mg once daily, mg/L and mg h/L).
pub fn ari_input_value(i: i32) -> f64 with Mut, Div, Panic {
    if i == 0 { return ari_obs(1, 0) }
    if i == 1 { return ari_obs(2, 0) }
    if i == 2 { return ari_obs(0, 0) }
    if i == 3 { return ari_obs(3, 0) }
    if i == 4 { return ari_obs(4, 0) }
    if i == 5 { return ari_obs(5, 0) }
    if i == 6 { return ari_p_ka() }
    if i == 7 { return ari_p_logp() }
    if i == 8 { return ari_p_fu() }
    if i == 9 { return ari_p_bp() }
    if i == 10 { return ari_m_logp() }
    if i == 11 { return ari_m_bp() }
    return ari_p_pka1()
}

pub fn ari_input_u(i: i32) -> f64 with Mut, Div, Panic {
    if i == 0 { return ari_obs(1, 2) }
    if i == 1 { return ari_obs(2, 2) }
    if i == 2 { return ari_obs(0, 2) }
    if i == 3 { return ari_obs(3, 2) }
    if i == 4 { return ari_obs(4, 2) }
    if i == 5 { return ari_obs(5, 2) }
    if i == 6 { return ari_p_u_ka() }
    if i == 7 { return ari_p_u_logp() }
    if i == 8 { return ari_p_u_fu() }
    if i == 9 { return ari_p_u_bp() }
    if i == 10 { return ari_m_u_logp() }
    if i == 11 { return ari_m_u_bp() }
    return ari_p_u_pka1()
}

pub fn ari_input_name(i: i32) -> string {
    if i == 0 { return "CL obs (pooled)   " }
    if i == 1 { return "Vss obs           " }
    if i == 2 { return "F obs (pooled)    " }
    if i == 3 { return "PM/EM ratio obs   " }
    if i == 4 { return "M/P ratio obs     " }
    if i == 5 { return "t1/2 M obs        " }
    if i == 6 { return "ka (pooled Tmax)  " }
    if i == 7 { return "logP parent       " }
    if i == 8 { return "fu parent         " }
    if i == 9 { return "B:P parent        " }
    if i == 10 { return "logP metabolite   " }
    if i == 11 { return "B:P metabolite    " }
    return "pKa parent        "
}

pub fn ari_eval(z: [f64; 13], dp: &Circ28Drug, dm: &Circ28Drug, dose_mg: f64, out: &![f64; 4]) with Mut, Div, Panic, Epistemic {
    var tp0 = circ28_drug_theta(dp)
    tp0[CD_KA] = z[6]
    tp0[CD_LOGP] = z[7]
    tp0[CD_FU] = z[8]
    tp0[CD_BP] = z[9]
    tp0[CD_PKA1] = z[12]
    let tp1 = ari_fit_p1(tp0, z[1], z[0], z[2])
    var tm0 = circ28_drug_theta(dm)
    tm0[CD_LOGP] = z[10]
    tm0[CD_BP] = z[11]
    let tm = ari_fit_m(tm0, tp1[CD_KPSC], z[5], ari_m_kappa())
    let fm = ari_fm(tp1, tm, z[4])
    let tp = ari_split(tp1, fm)
    var res: [f64; 40] = [0.0; 40]
    ari_run_th(tp, tm, 1, dose_mg, 0.0, 8.0, 300.0, 600.0, 1200.0, 1680.0, &!res)
    (*out)[0] = res[22]
    (*out)[1] = res[18]
    (*out)[2] = res[20]
    (*out)[3] = res[2]
}

pub struct AriBudget {
    pub y0: [f64; 4],
    pub var_am: f64,
    pub var_p: f64,
    pub var_m: f64,
    pub var_auc: f64,
    pub contrib_am: [f64; 13],
    pub u: [f64; 13],
    pub runs: i32,
}

// Forward differences (one run per input plus one), step h_i = min(1e-3 |z_i|, 0.1 u_i).
pub fn ari_budget(dp: &Circ28Drug, dm: &Circ28Drug, dose_mg: f64) -> AriBudget with Mut, Div, Panic, Epistemic {
    var z0: [f64; 13] = [0.0; 13]
    var u: [f64; 13] = [0.0; 13]
    var i: i32 = 0
    while i < 13 {
        z0[i] = ari_input_value(i)
        u[i] = ari_input_u(i)
        i = i + 1
    }
    var o0: [f64; 4] = [0.0; 4]
    ari_eval(z0, dp, dm, dose_mg, &!o0)
    var ca: [f64; 13] = [0.0; 13]
    var va = 0.0
    var vp = 0.0
    var vm = 0.0
    var vq = 0.0
    var nrun: i32 = 1
    i = 0
    while i < 13 {
        var hs = 1.0e-3 * ari_abs(z0[i])
        if hs > 0.1 * u[i] { hs = 0.1 * u[i] }
        var zp = z0
        zp[i] = z0[i] + hs
        var op: [f64; 4] = [0.0; 4]
        if i == 3 {
            // the PM/EM ratio does not enter ari_eval (extensive-metaboliser outputs): its share is zero by
            // construction (measured once with the run, 0.000000 %), so the run is not spent on it
            op[0] = o0[0]
            op[1] = o0[1]
            op[2] = o0[2]
            op[3] = o0[3]
        } else {
            ari_eval(zp, dp, dm, dose_mg, &!op)
            nrun = nrun + 1
        }
        let da = (op[0] - o0[0]) / hs
        let dpp = (op[1] - o0[1]) / hs
        let dmm = (op[2] - o0[2]) / hs
        let dq = (op[3] - o0[3]) / hs
        ca[i] = da * da * u[i] * u[i]
        va = va + ca[i]
        vp = vp + dpp * dpp * u[i] * u[i]
        vm = vm + dmm * dmm * u[i] * u[i]
        vq = vq + dq * dq * u[i] * u[i]
        i = i + 1
    }
    return AriBudget { y0: o0, var_am: va, var_p: vp, var_m: vm, var_auc: vq, contrib_am: ca, u: u, runs: nrun }
}
