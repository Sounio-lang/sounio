// stdlib/darwin_pbpk/circ28_drug_olanzapine.sio — olanzapine (oral tablet) on the circ28 drug record
//
// Reference subject: healthy NON-SMOKING adult man (ICRP 89 reference male, 73 kg). Smoking,
// fluvoxamine and carbamazepine are scenarios that scale the CYP1A2 share of the hepatic
// intrinsic clearance (hepatic factor only).
//
// NO INTRAVENOUS DATA EXIST (nothing found in PubMed, 2026-11-15; the US label gives an oral
// first-pass statement and an intramuscular statement that contradict each other, see below).
// Every disposition number is therefore APPARENT (CL/F, V/F). The absolute bioavailability
// F = 0.60 is an INPUT taken from the label ("approximately 40% of the dose metabolized before
// reaching the systemic circulation") with a judgment uncertainty; it is NOT identifiable from
// oral data and the oral predictions do not depend on it to first order (the budget shows it).
//
// Sources were opened on 2026-11-15 (PubMed abstracts, PMC full texts, DailyMed). Access level:
// FT full text read, AB abstract, LBL US label text (DailyMed setid
// b418946a-1ab4-4d89-a012-d94fc361a3c4), SEC value cited by a paper that was read (the primary
// was not opened). Nothing here comes from memory.
//
// STATUS: 1 measured, 2 derived by a stated formula, 3 fitted to ONE named observable (which is
// then not a validation). u is the STANDARD UNCERTAINTY OF THE VALUE, never an inter-individual SD.
//
//  param   value     u         status  basis of u                 source (access)
//  MW      312.43    0         1       formula weight             Sun 2020 PBPK, PMC7020312 Table 1 (FT)
//  logP    2.945     0.0318    1       range/sqrt12 of 2 values   2.89 (El-Ela 2004 via Sun 2020, SEC), 3.0
//                                                                 (Sangster/HSDB via PubChem, SEC)
//  pKa1    7.52      0.162     2       range/sqrt12 of 2 values   mean of 7.24 (Callaghan 1999 via Sun 2020, SEC)
//                                                                 and 7.8 (ChEMBL via PubChem, SEC); 10.57
//                                                                 (DrugBank, probably predicted) not used
//  ion     2 (base)  0         2       -                          monoprotic base (Sun 2020 Table 1)
//  fu      0.07      0.0029    1       rounding of "93% bound"    label 93 % bound, 7-1100 ng/mL (LBL); 0.07
//                                      (0.01/sqrt12); no spread   (Kassahun 1997 via Sun 2020, SEC)
//                                      is published
//  B:P     0.62      0.03      1       ASSUMED (no spread in any  Callaghan 1999 via Sun 2020 (SEC); Kassahun
//                                      source)                    1997 (AB): radioactivity mostly in plasma
//  clint   fitted    propagated 3      from u(CL/F), u(F), u(fe)  FITTED to the pooled CL/F (below)
//  clform  0         -         0       -                          no metabolite tracked
//  clgut   0         -         0       -                          ASSUMPTION: no gut-wall metabolism slot; any
//                                                                 pre-hepatic loss is lumped in CD_FA
//  clren   derived   propagated 2      from u(CL/F); fe has no    CL_R = fe x CL/F, fe = 0.07 unchanged in urine
//                                      spread (u assumed 0.02)    (Kassahun 1997 AB, n 6; LBL). Sun 2020 uses
//                                                                 0.81 L/h (SEC)
//  clpla   0         -         0       -                          unused
//  kpsc    fitted    propagated 3      from u(Vss/F), u(F)        FITTED to the pooled V_ss/F (below)
//  pssc    1         -         0       -                          default ps = 20 x flow (placeholder, no
//                                                                 source). A rate observable exists (popPK
//                                                                 Q/F 6.15 and 8.41 L/h) but mapping it onto
//                                                                 the ps scalar needs a bi-exponential fit of
//                                                                 the kernel curve; not done, ps left alone
//  ka      fitted    propagated 3      from u(Tmax)               FITTED to the pooled Tmax (below)
//  fa      derived   propagated 2      from u(F), u(CL/F)         PRE-HEPATIC AVAILABILITY = F / (1 - Eh), with
//                                                                 F = 0.60 (LBL) and Eh from the fitted clint.
//                                                                 It lumps non-absorption and any gut-wall
//                                                                 loss; it is not a measured fraction absorbed
//  tlag    0.5       0.0417    1       (range 0-1)/sqrt12/sqrt48  Sun 2018, PMC6585851 Table 2: median 0.5 h
//                                                                 (0.0-1.0), n 48 (FT)
//  psgut   -         -         0       -                          unused (flow-limited gut)
//
// Not in the record (module level):
//  F       0.60      0.10      input   JUDGMENT                   LBL "approximately 40%" first pass. The same
//                                                                 label says the IM AUC is "similar" to the
//                                                                 oral AUC at the same dose (F near 1 if IM is
//                                                                 complete), and Kassahun 1997 finds only
//                                                                 about 2 % of the dose as parent in faeces.
//                                                                 With complete absorption and hepatic first
//                                                                 pass only, the fitted CL/F gives F = 0.81
//                                                                 (printed by the test). u 0.10 puts 0.81 at 2 u.
//  fm      fitted    propagated 3      from u(R_flv), u(r)        CYP1A2 share of the hepatic intrinsic
//                                                                 clearance in a non-smoker, FITTED to the
//                                                                 fluvoxamine AUC ratio in non-smokers (below)
//  r_flv   0.0472    0.0371    2       range of Ki / sqrt12       residual CYP1A2 activity under fluvoxamine
//                                                                 100 mg/day = Ki / (Ki + Iu): Ki 2.97 nM unbound
//                                                                 (range 0.87-10; Kanacher 2020 and OSP, dossier
//                                                                 perpetrator_parameters A5), Iu = 83 ng/mL
//                                                                 (Hiemke 2002 AB, week 8) / 318.335 x fu 0.23
//                                                                 = 60.0 nM. Plasma concentration, not the liver
//                                                                 inlet: HEPATIC FACTOR ONLY, a what-if input
//  fold_s  1.808     0.30      2       ASSUMED                    CYP1A2 abundance smokers / non-smokers = 94 / 52
//                                                                 pmol/mg (Simcyp values in Sun 2020 Methods,
//                                                                 FT/SEC); heavy smokers 156 / 52 = 3.0
//
// OBSERVABLES USED TO FIT (pooled in Sounio by olz_pool; the test prints every table):
//   mean = sum n_i m_i / sum n_i; sw = pooled within-study SD over studies that give an SD;
//   SE_w = sw / sqrt(N); sb = SD of the k study means; SE_b = sb / sqrt(k); u = max(SE_w, SE_b).
//   CL/F     k 3, N 1146: Sun 2021 popPK (PMC8596792 Table 3, FT) 15.5 L/h, IIV CV 43.2 %, n 601 (reference:
//            70 kg non-smoking non-Black man, fasted); Li 2018 popPK (PMC6104801 Table 2, FT) healthy men,
//            formulation #0: 25.4 x 0.610 = 15.5 L/h, IIV 49.1 %, n 22; Bigos 2008 (PMID 18199892, AB)
//            16.1 L/h population mean, n 523 patients, no SD.
//            NOT pooled: label mean 25 L/h (5th-95th 12-47; n and smoker share not stated; it is a validation
//            row); Li 2018 patients on formulation #2 (25.4 L/h; the authors could not separate formulation
//            from population); Sun 2018 NCA 17.4 (5.8) L/h (its 48 subjects are inside Sun 2021).
//   V_ss/F   k 2, N 623: Sun 2021 Vc/F 656 + Vp/F 225 = 881 L (n 601); Li 2018 healthy 2390 x 0.216 + 168 =
//            684 L (n 22). These are popPK two-compartment volumes; no non-compartmental V_ss/F exists.
//            NOT pooled: label "approximately 1000 L" and Bigos 2150 L (terminal / one-compartment volumes).
//   Tmax     k 2, N 66: Sun 2018 (PMC6585851, FT) 10 mg Zyprexa, median 5.0 h (2-12), n 48, SD = range/sqrt12;
//            PMC3480756 (AB) 10 mg ODT, median 5.0 h, n 18, no spread. Medians treated as means.
//   R_flv    fluvoxamine AUC ratio, non-smokers / healthy volunteers, k 2, UNWEIGHTED (one n is not stated):
//            label, female non-smokers, AUC +52 % (LBL); Wang 2004 (PMID 15199083, AB) 12 healthy Chinese men,
//            AUC0-inf +76 % (smoking status not in the abstract: an assumption that they are non-smokers).
//
// CLOSED FORMS OF THE FITS (kernel equations; ps_liver = 20 Q_h, CD_PSSC = 1):
//   CL_R   = fe (CL/F)                          a true plasma clearance: Ae / AUC does not involve F
//   CL_h   = F (CL/F) - CL_R                    systemic hepatic plasma clearance
//   Eh     = (CL_h / bp) / Q_h;  y = bp Q_h Eh / (1 - Eh);  clint fu = y ps / (ps - y)
//   kpsc   = (F V_ss/F - bp V_blood) / sum_i V_i (1 - vf_i) Kp_RR,i          (circ28_kp_scale_for_vss)
//   CD_FA  = F / (1 - Eh)
//   The oral AUC is then dose / (CL/F) exactly: AUC = fa (1 - Eh) dose / (bp Q_h Eh + CL_R).
//   fm: with c the hepatic effective blood clearance (c = (ps ci / (ps + ci)) / bp, ci = clint fu),
//       AUC_oral is proportional to Q_h / (c (bp Q_h + CL_R) + CL_R Q_h), so the c1 that gives the ratio R is
//       c1 = ((c0 A + B) / R - B) / A, A = bp Q_h + CL_R, B = CL_R Q_h; ci1 from c1; fm = (1 - ci1/ci0) / (1 - r).
//   ka: root of Tmax(ka) = Tmax_obs on the kernel run (secant, offline; stored in olz_ka_fit(), re-checked by the test).
//
// SCENARIOS (multipliers of the hepatic clint; nothing else changes):
//   smoker                 1 + fm (fold_s - 1)
//   fluvoxamine            1 - fm (1 - r)
//   smoker + fluvoxamine   1 - fm + fm fold_s r
//   carbamazepine WHAT-IF  1 + fm (fold - 1) with the smoking fold BORROWED (no sourced CYP1A2 fold for
//                          carbamazepine; UGT1A4 induction is not modelled)
//
// VALIDATIONS and their criteria are written in tests/run-pass/circ28_drug_olanzapine.sio.

use darwin_pbpk::circ28::*
use darwin_pbpk::circ28_kp::*
use darwin_pbpk::circ28_drug::*
use math::pure::{exp, ln}

// ---- measured / assumed inputs ----------------------------------------------
pub fn olz_mw() -> f64 { return 312.43 }
pub fn olz_logp() -> f64 { return 2.945 }
pub fn olz_u_logp() -> f64 { return 0.0318 }
pub fn olz_pka1() -> f64 { return 7.52 }
pub fn olz_u_pka1() -> f64 { return 0.162 }
pub fn olz_fu() -> f64 { return 0.07 }
pub fn olz_u_fu() -> f64 { return 0.0029 }
pub fn olz_bp() -> f64 { return 0.62 }
pub fn olz_u_bp() -> f64 { return 0.03 }
pub fn olz_tlag() -> f64 { return 0.5 }
pub fn olz_u_tlag() -> f64 { return 0.0417 }
// absolute bioavailability (label; judgment uncertainty)
pub fn olz_f_abs() -> f64 { return 0.60 }
pub fn olz_u_f_abs() -> f64 { return 0.10 }
// fraction of the oral dose excreted unchanged in urine (Kassahun 1997, label); u assumed
pub fn olz_fe() -> f64 { return 0.07 }
pub fn olz_u_fe() -> f64 { return 0.02 }
// CYP1A2 abundance fold in smokers (94 / 52 pmol/mg, Sun 2020); u assumed
pub fn olz_fold_smoker() -> f64 { return 94.0 / 52.0 }
pub fn olz_u_fold_smoker() -> f64 { return 0.30 }
// residual CYP1A2 activity under fluvoxamine 100 mg/day: Ki / (Ki + Iu), nM
pub fn olz_flv_iu() -> f64 { return 83.0 / 318.335 * 1000.0 * 0.23 }
pub fn olz_flv_resid_ki(ki: f64) -> f64 { return ki / (ki + olz_flv_iu()) }
pub fn olz_flv_resid() -> f64 { return olz_flv_resid_ki(2.97) }
pub fn olz_u_flv_resid() -> f64 { return (olz_flv_resid_ki(10.0) - olz_flv_resid_ki(0.8697)) / 3.4641016151377544 }

fn olz_abs(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

// ---- pooling of study means ---------------------------------------------------
pub struct OlzPool {
    pub mean: f64,
    pub n_tot: f64,
    pub k: i32,
    pub sw: f64,
    pub se_w: f64,
    pub sb: f64,
    pub se_b: f64,
    pub u: f64,
    pub mean_unw: f64,
}

// A study without an SD (s_i <= 0) enters the mean and sb but not sw. mean_unw is the plain mean
// of the k study means (used when an n is not stated).
pub fn olz_pool(m: &[f64; 12], s: &[f64; 12], n: &[f64; 12], k: i32) -> OlzPool with Mut, Div, Panic {
    var sn = 0.0
    var sm = 0.0
    var mm = 0.0
    var num = 0.0
    var den = 0.0
    var i: i32 = 0
    while i < k {
        sn = sn + (*n)[i]
        sm = sm + (*n)[i] * (*m)[i]
        mm = mm + (*m)[i]
        if (*s)[i] > 0.0 && (*n)[i] > 1.0 {
            num = num + ((*n)[i] - 1.0) * (*s)[i] * (*s)[i]
            den = den + ((*n)[i] - 1.0)
        }
        i = i + 1
    }
    let kf = k as f64
    let mbar = mm / kf
    var ss = 0.0
    i = 0
    while i < k {
        let dv = (*m)[i] - mbar
        ss = ss + dv * dv
        i = i + 1
    }
    var sb = 0.0
    if k > 1 { sb = cd_sqrt(ss / (kf - 1.0)) }
    var sw = 0.0
    if den > 0.0 { sw = cd_sqrt(num / den) }
    let se_w = sw / cd_sqrt(sn)
    let se_b = sb / cd_sqrt(kf)
    var u = se_w
    if se_b > u { u = se_b }
    return OlzPool { mean: sm / sn, n_tot: sn, k: k, sw: sw, se_w: se_w, sb: sb, se_b: se_b, u: u, mean_unw: mbar }
}

// CL/F, L/h (see the header for the studies and the exclusions)
pub fn olz_clf_studies(m: &![f64; 12], s: &![f64; 12], n: &![f64; 12]) -> i32 with Mut, Div, Panic {
    (*m)[0] = 15.5
    (*s)[0] = 0.432 * 15.5
    (*n)[0] = 601.0
    (*m)[1] = 25.4 * 0.610
    (*s)[1] = 0.491 * 25.4 * 0.610
    (*n)[1] = 22.0
    (*m)[2] = 16.1
    (*s)[2] = 0.0 - 1.0
    (*n)[2] = 523.0
    return 3
}

// V_ss/F = Vc/F + Vp/F, L
pub fn olz_vssf_studies(m: &![f64; 12], s: &![f64; 12], n: &![f64; 12]) -> i32 with Mut, Div, Panic {
    (*m)[0] = 656.0 + 225.0
    (*s)[0] = 0.0 - 1.0
    (*n)[0] = 601.0
    (*m)[1] = 2390.0 * 0.216 + 168.0
    (*s)[1] = 0.0 - 1.0
    (*n)[1] = 22.0
    return 2
}

// Tmax, h
pub fn olz_tmax_studies(m: &![f64; 12], s: &![f64; 12], n: &![f64; 12]) -> i32 with Mut, Div, Panic {
    (*m)[0] = 5.0
    (*s)[0] = 10.0 / 3.4641016151377544
    (*n)[0] = 48.0
    (*m)[1] = 5.0
    (*s)[1] = 0.0 - 1.0
    (*n)[1] = 18.0
    return 2
}

// Terminal half-life from non-compartmental analyses, h (NOT a fit observable: the input check and
// a validation row). Sun 2018 34.5 (8.7), n 48; Kassahun 1997 27 h, n 6, no SD.
pub fn olz_thalf_studies(m: &![f64; 12], s: &![f64; 12], n: &![f64; 12]) -> i32 with Mut, Div, Panic {
    (*m)[0] = 34.5
    (*s)[0] = 8.7
    (*n)[0] = 48.0
    (*m)[1] = 27.0
    (*s)[1] = 0.0 - 1.0
    (*n)[1] = 6.0
    return 2
}

// Fluvoxamine AUC ratio in non-smokers / healthy volunteers. n of the label group is not stated:
// both get n = 1 and the pool's unweighted mean and SE_b are used.
pub fn olz_flv_studies(m: &![f64; 12], s: &![f64; 12], n: &![f64; 12]) -> i32 with Mut, Div, Panic {
    (*m)[0] = 1.52
    (*s)[0] = 0.0 - 1.0
    (*n)[0] = 1.0
    (*m)[1] = 1.76
    (*s)[1] = 0.0 - 1.0
    (*n)[1] = 1.0
    return 2
}

// Smoker / non-smoker ratio of CL/F (= C/D non-smoker over C/D smoker), one value per study.
// VALIDATION pool (not fitted). Order: Skogh 2011 (n 37), Citrome 2009 (mean of the three dose
// groups, n 380), Bigos 2008 (523), Haslemo 2006 (40), Skogh 2002 (medians, 194), Haslemo 2012
// (431 = 205 controls + 226 on antiepileptics, covariate model), Gex-Fabry 2003 (250), Carrillo
// 2003 (17), Wu 2008 (27; single-dose AUC0-120, mean of light -45.1 % and heavy -67.6 %), Laika
// 2010 (73; inducers = smoke and carbamazepine), Sun 2021 (601). No SDs of the ratio are published.
pub fn olz_smoke_studies(m: &![f64; 12], s: &![f64; 12], n: &![f64; 12]) -> i32 with Mut, Div, Panic {
    (*m)[0] = 3.32 / 2.23
    (*n)[0] = 37.0
    (*m)[1] = (25.6 / 16.5 + 43.4 / 34.2 + 113.2 / 60.9) / 3.0
    (*n)[1] = 380.0
    (*m)[2] = 1.55
    (*n)[2] = 523.0
    (*m)[3] = 2.0
    (*n)[3] = 40.0
    (*m)[4] = 9.2 / 4.0
    (*n)[4] = 194.0
    (*m)[5] = 1.0 / (1.0 - 0.32)
    (*n)[5] = 431.0
    (*m)[6] = 1.0 / (1.0 - 0.12)
    (*n)[6] = 250.0
    (*m)[7] = 7.9 / 1.56
    (*n)[7] = 17.0
    (*m)[8] = 1.0 / (0.5 * ((1.0 - 0.451) + (1.0 - 0.676)))
    (*n)[8] = 27.0
    (*m)[9] = 1.0 / (1.0 - 0.27)
    (*n)[9] = 73.0
    (*m)[10] = 1.30
    (*n)[10] = 601.0
    var i: i32 = 0
    while i < 11 {
        (*s)[i] = 0.0 - 1.0
        i = i + 1
    }
    return 11
}

// which: 0 CL/F, 1 V_ss/F, 2 Tmax, 3 NCA half-life, 4 fluvoxamine ratio, 5 smoking ratio
pub fn olz_pool_of(which: i32) -> OlzPool with Mut, Div, Panic {
    var m: [f64; 12] = [0.0; 12]
    var s: [f64; 12] = [0.0; 12]
    var n: [f64; 12] = [0.0; 12]
    var k: i32 = 0
    if which == 0 { k = olz_clf_studies(&!m, &!s, &!n) }
    if which == 1 { k = olz_vssf_studies(&!m, &!s, &!n) }
    if which == 2 { k = olz_tmax_studies(&!m, &!s, &!n) }
    if which == 3 { k = olz_thalf_studies(&!m, &!s, &!n) }
    if which == 4 { k = olz_flv_studies(&!m, &!s, &!n) }
    if which == 5 { k = olz_smoke_studies(&!m, &!s, &!n) }
    return olz_pool(&m, &s, &n, k)
}

pub fn olz_obs_clf() -> f64 with Mut, Div, Panic { return olz_pool_of(0).mean }
pub fn olz_u_clf() -> f64 with Mut, Div, Panic { return olz_pool_of(0).u }
pub fn olz_obs_vssf() -> f64 with Mut, Div, Panic { return olz_pool_of(1).mean }
pub fn olz_u_vssf() -> f64 with Mut, Div, Panic { return olz_pool_of(1).u }
pub fn olz_obs_tmax() -> f64 with Mut, Div, Panic { return olz_pool_of(2).mean }
pub fn olz_u_tmax() -> f64 with Mut, Div, Panic { return olz_pool_of(2).u }
pub fn olz_obs_flv() -> f64 with Mut, Div, Panic { return olz_pool_of(4).mean_unw }
pub fn olz_u_flv() -> f64 with Mut, Div, Panic { return olz_pool_of(4).se_b }

// ka fitted offline (olz_fit_ka, secant on the kernel Tmax) to the pooled Tmax 5.0 h with the
// fitted record; the test re-checks the Tmax it gives.
pub fn olz_ka_fit() -> f64 { return 0.220538 }

// ---- closed-form fits ----------------------------------------------------------
// Returns th with CD_CLREN, CD_CLINT, CD_KPSC and CD_FA set from (F, CL/F, V_ss/F, fe).
// CD_CLINT = -1 when a fit is impossible (hepatic clearance not positive, Eh >= 1, V_ss below the
// blood floor, ps too small, or F / (1 - Eh) > 1).
pub fn olz_fit(th: [f64; 18], f_abs: f64, clf: f64, vssf: f64, fe: f64) -> [f64; 18] with Mut, Div, Panic {
    var t = th
    t[CD_KPSC] = 1.0
    t[CD_CLINT] = 0.0
    t[CD_CLREN] = fe * clf
    let p0 = circ28_drug_params_theta(t)
    let sc = circ28_kp_scale_for_vss(p0, p0.kp, f_abs * vssf)
    if !(sc > 0.0) {
        t[CD_CLINT] = 0.0 - 1.0
        return t
    }
    t[CD_KPSC] = sc
    let clh = f_abs * clf - t[CD_CLREN]
    let qh = circ28_q_hepatic(p0)
    let eh = (clh / p0.bp) / qh
    if !(eh > 0.0) || !(eh < 1.0) {
        t[CD_CLINT] = 0.0 - 1.0
        return t
    }
    let y = p0.bp * qh * eh / (1.0 - eh)
    if !(p0.ps[1] > y) {
        t[CD_CLINT] = 0.0 - 1.0
        return t
    }
    let fa = f_abs / (1.0 - eh)
    if fa > 1.0 {
        t[CD_CLINT] = 0.0 - 1.0
        return t
    }
    t[CD_FA] = fa
    t[CD_CLINT] = (y * p0.ps[1] / (p0.ps[1] - y)) / p0.fu
    return t
}

// Hepatic extraction ratio, oral F and apparent oral clearance of a value array (closed forms).
pub fn olz_eh(th: [f64; 18]) -> f64 with Mut, Div, Panic {
    let p = circ28_drug_params_theta(th)
    return circ28_hepatic_extraction(p)
}

pub fn olz_f_oral(th: [f64; 18]) -> f64 with Mut, Div, Panic {
    return th[CD_FA] * (1.0 - olz_eh(th))
}

pub fn olz_clf_closed(th: [f64; 18]) -> f64 with Mut, Div, Panic {
    let p = circ28_drug_params_theta(th)
    let eh = circ28_hepatic_extraction(p)
    return (p.bp * circ28_q_hepatic(p) * eh + th[CD_CLREN]) / (th[CD_FA] * (1.0 - eh))
}

// F that the fitted CL/F implies when absorption is complete and the first pass is hepatic only:
// (bp Q_h E + CL_R) / (1 - E) = CL/F  =>  E = (CL/F - CL_R) / (bp Q_h + CL/F).
pub fn olz_f_if_complete(th: [f64; 18], clf: f64) -> f64 with Mut, Div, Panic {
    let p = circ28_drug_params_theta(th)
    let e = (clf - th[CD_CLREN]) / (p.bp * circ28_q_hepatic(p) + clf)
    return 1.0 - e
}

// CYP1A2 share fm of the hepatic intrinsic clearance from an oral AUC ratio R under an inhibitor
// that leaves the residual activity r (closed form in the header). Returns -1 if impossible.
pub fn olz_fm_fit(th: [f64; 18], ratio: f64, resid: f64) -> f64 with Mut, Div, Panic {
    let p = circ28_drug_params_theta(th)
    let qh = circ28_q_hepatic(p)
    let ci0 = p.clint * p.fu
    let c0 = (p.ps[1] * ci0 / (p.ps[1] + ci0)) / p.bp
    let a = p.bp * qh + th[CD_CLREN]
    let b = th[CD_CLREN] * qh
    let c1 = ((c0 * a + b) / ratio - b) / a
    if !(c1 > 0.0) { return 0.0 - 1.0 }
    let x = c1 * p.bp
    let ci1 = x * p.ps[1] / (p.ps[1] - x)
    return (1.0 - ci1 / ci0) / (1.0 - resid)
}

// Multiplier of the hepatic clint in a scenario: 0 none, 1 smoker, 2 fluvoxamine,
// 3 smoker + fluvoxamine, 4 carbamazepine what-if (smoking fold borrowed).
pub fn olz_scenario_mult(fm: f64, scen: i32) -> f64 {
    let fo = olz_fold_smoker()
    let r = olz_flv_resid()
    if scen == 1 { return 1.0 + fm * (fo - 1.0) }
    if scen == 2 { return 1.0 - fm * (1.0 - r) }
    if scen == 3 { return 1.0 - fm + fm * fo * r }
    if scen == 4 { return 1.0 + fm * (fo - 1.0) }
    return 1.0
}

// ---- kernel run of one oral dose ------------------------------------------------
// Grid: 0.25 h to 12 h, 1 h to 48 h, 4 h to 168 h, 8 h to 408 h (144 steps).
// res: 0 Cmax (mg/L, parabola through the grid maximum), 1 Tmax (h), 2 AUC0-inf (mg h/L, tail
// C_end / lambda_late), 3 t1/2 over the NCA window 72-168 h, 4 AUC0-24, 5 C(15 h), 6 C(24 h),
// 7 steady-state C 15 h after the dose for once-daily dosing (superposition of the single-dose curve
// at 15 + 24 k h, log-linear interpolation, geometric tail), 8 steady-state trough (24 k h, k >= 1),
// 9 mass-balance error, 10 late t1/2 (window 240-408 h), 11 1 if both slopes are valid,
// 12 steady-state peak (the single-dose Tmax + 24 k h), 13 number of steps.
fn olz_lz(ts: &[f64; 200], cs: &[f64; 200], n: i32, lo: f64, hi: f64) -> f64 with Mut, Div, Panic {
    var sw = 0.0
    var st = 0.0
    var sy = 0.0
    var stt = 0.0
    var sty = 0.0
    var nf: i32 = 0
    var i: i32 = 1
    while i <= n {
        if (*ts)[i] >= lo - 1.0e-9 && (*ts)[i] <= hi + 1.0e-9 && (*cs)[i] > 0.0 {
            let y = ln((*cs)[i])
            sw = sw + 1.0
            st = st + (*ts)[i]
            sy = sy + y
            stt = stt + (*ts)[i] * (*ts)[i]
            sty = sty + (*ts)[i] * y
            nf = nf + 1
        }
        i = i + 1
    }
    if nf < 3 { return 0.0 }
    let den = sw * stt - st * st
    let lz = 0.0 - (sw * sty - st * sy) / den
    if !(lz > 0.0) { return 0.0 }
    return lz
}

// Concentration at time t by log-linear interpolation on the grid (t inside the grid, t > 0).
fn olz_c_at(ts: &[f64; 200], cs: &[f64; 200], n: i32, t: f64) -> f64 with Mut, Div, Panic {
    var i: i32 = 1
    while i < n && (*ts)[i + 1] < t {
        i = i + 1
    }
    if i >= n { return (*cs)[n] }
    let t0 = (*ts)[i]
    let t1 = (*ts)[i + 1]
    let c0 = (*cs)[i]
    let c1 = (*cs)[i + 1]
    if t <= t0 { return c0 }
    if !(c0 > 0.0) || !(c1 > 0.0) { return c0 + (c1 - c0) * (t - t0) / (t1 - t0) }
    return exp(ln(c0) + (ln(c1) - ln(c0)) * (t - t0) / (t1 - t0))
}

// Sum over k >= k0 of C(t0 + 24 k) with a geometric tail beyond the grid.
fn olz_super(ts: &[f64; 200], cs: &[f64; 200], n: i32, t0: f64, k0: i32, lz: f64) -> f64 with Mut, Div, Panic {
    var sum = 0.0
    var k = k0
    var last = 0.0
    var tl = t0 + 24.0 * (k as f64)
    while tl <= (*ts)[n] + 1.0e-9 {
        last = olz_c_at(ts, cs, n, tl)
        sum = sum + last
        k = k + 1
        tl = t0 + 24.0 * (k as f64)
    }
    if lz > 0.0 {
        let q = exp(0.0 - lz * 24.0)
        sum = sum + last * q / (1.0 - q)
    }
    return sum
}

pub fn olz_run_th(th_in: [f64; 18], dose: f64, res: &![f64; 16]) with Mut, Div, Panic {
    var th = th_in
    let p = circ28_drug_params_theta(th)
    var ts: [f64; 200] = [0.0; 200]
    var cs: [f64; 200] = [0.0; 200]
    var sys = circ28_sys_zero()
    var s = circ28_state_zero()
    var el = circ28_elim_zero()
    var n: i32 = 0
    var t = 0.0
    var input = 0.0
    var auc24 = 0.0
    var ph: i32 = 0
    while ph < 4 {
        var dt = 0.25
        var tstop = 12.0
        if ph == 1 {
            dt = 1.0
            tstop = 48.0
        }
        if ph == 2 {
            dt = 4.0
            tstop = 168.0
        }
        if ph == 3 {
            dt = 8.0
            tstop = 408.0
        }
        circ28_prepare(p, dt, &!sys)
        while t + 0.5 * dt < tstop && n < 198 {
            let mass = circ28_oral_mass(th[CD_KA], th[CD_FA], dose, th[CD_TLAG], t, t + dt)
            input = input + mass
            circ28_step(&!s, p, &sys, 0.0, mass / dt, &!el)
            t = t + dt
            n = n + 1
            ts[n] = t
            cs[n] = s.x[0] / p.bp
            if olz_abs(t - 24.0) < 1.0e-9 { auc24 = el.auc_ven / p.bp }
        }
        ph = ph + 1
    }
    // maximum, refined by the parabola through it and its neighbours (equal spacing only)
    var im: i32 = 0
    var cm = 0.0
    var i: i32 = 1
    while i <= n {
        if cs[i] > cm {
            cm = cs[i]
            im = i
        }
        i = i + 1
    }
    var cmax = cm
    var tmax = ts[im]
    if im >= 1 && im < n {
        let h1 = ts[im] - ts[im - 1]
        let h2 = ts[im + 1] - ts[im]
        if olz_abs(h1 - h2) < 1.0e-9 {
            let den = cs[im - 1] - 2.0 * cs[im] + cs[im + 1]
            if den < 0.0 {
                let off = 0.5 * (cs[im - 1] - cs[im + 1]) / den
                tmax = ts[im] + off * h1
                cmax = cs[im] - 0.25 * (cs[im - 1] - cs[im + 1]) * off
            }
        }
    }
    let lz_nca = olz_lz(&ts, &cs, n, 72.0, 168.0)
    let lz_late = olz_lz(&ts, &cs, n, 240.0, 408.0)
    let auc_t = el.auc_ven / p.bp
    (*res)[0] = cmax
    (*res)[1] = tmax
    (*res)[2] = auc_t
    (*res)[3] = 0.0
    (*res)[10] = 0.0
    (*res)[11] = 0.0
    if lz_late > 0.0 && lz_nca > 0.0 {
        (*res)[2] = auc_t + cs[n] / lz_late
        (*res)[3] = 0.6931471805599453 / lz_nca
        (*res)[10] = 0.6931471805599453 / lz_late
        (*res)[11] = 1.0
    }
    (*res)[4] = auc24
    (*res)[5] = olz_c_at(&ts, &cs, n, 15.0)
    (*res)[6] = olz_c_at(&ts, &cs, n, 24.0)
    (*res)[7] = olz_super(&ts, &cs, n, 15.0, 0, lz_late)
    (*res)[8] = olz_super(&ts, &cs, n, 0.0, 1, lz_late)
    let elim = el.hepatic + el.formed + el.renal + el.plasma + el.gut
    var be = 0.0
    if input > 0.0 { be = olz_abs(input - elim - circ28_total_mass(&s, p)) / input }
    (*res)[9] = be
    (*res)[12] = cmax + olz_super(&ts, &cs, n, tmax, 1, lz_late)
    (*res)[13] = n as f64
}

// Tmax of a 1 mg run with a given ka.
pub fn olz_tmax_ka(th_in: [f64; 18], ka: f64) -> f64 with Mut, Div, Panic {
    var th = th_in
    th[CD_KA] = ka
    var r: [f64; 16] = [0.0; 16]
    olz_run_th(th, 1.0, &!r)
    return r[1]
}

// Secant for the ka with Tmax(ka) = tobs (offline; 12 iterations from the two starting values).
pub fn olz_fit_ka(th: [f64; 18], tobs: f64, k0: f64, k1: f64) -> f64 with Mut, Div, Panic {
    var a = k0
    var b = k1
    var fa = olz_tmax_ka(th, a) - tobs
    var fb = olz_tmax_ka(th, b) - tobs
    var it: i32 = 0
    while it < 12 && olz_abs(fb) > 1.0e-7 && olz_abs(fb - fa) > 1.0e-14 {
        let c = b - fb * (b - a) / (fb - fa)
        a = b
        fa = fb
        b = c
        if b < 0.01 { b = 0.01 }
        fb = olz_tmax_ka(th, b) - tobs
        it = it + 1
    }
    return b
}

// ---- the record ------------------------------------------------------------------
pub fn olz_measured_record(d: &!Circ28Drug) with Mut, Div, Panic, Epistemic {
    circ28_drug_set(d, CD_MW, olz_mw(), 0.0, CD_STATUS_MEASURED, "Sun 2020 PBPK (PMC7020312) Table 1, formula weight")
    circ28_drug_set(d, CD_LOGP, olz_logp(), olz_u_logp(), CD_STATUS_MEASURED, "mean of 2.89 (El-Ela 2004 via Sun 2020) and 3.0 (Sangster via PubChem); u = range/sqrt12; both secondary")
    circ28_drug_set(d, CD_PKA1, olz_pka1(), olz_u_pka1(), CD_STATUS_DERIVED, "mean of 7.24 (Callaghan 1999 via Sun 2020) and 7.8 (ChEMBL via PubChem); u = range/sqrt12; both secondary")
    circ28_drug_set(d, CD_ION, 2.0, 0.0, CD_STATUS_DERIVED, "monoprotic base (Sun 2020 Table 1)")
    circ28_drug_set(d, CD_FU, olz_fu(), olz_u_fu(), CD_STATUS_MEASURED, "label: 93 % bound over 7-1100 ng/mL; Kassahun 1997 via Sun 2020; u = rounding 0.01/sqrt12")
    circ28_drug_set(d, CD_BP, olz_bp(), olz_u_bp(), CD_STATUS_MEASURED, "0.62 Callaghan 1999 via Sun 2020 (secondary); u 0.03 ASSUMED")
    circ28_drug_set(d, CD_TLAG, olz_tlag(), olz_u_tlag(), CD_STATUS_MEASURED, "Sun 2018 (PMC6585851) median lag 0.5 h (0-1), n 48; u = range/sqrt12/sqrt48")
}

// Central difference of one fitted component of olz_fit with respect to one of its four inputs
// (0 F, 1 CL/F, 2 V_ss/F, 3 fe), relative step 1e-4.
pub fn olz_fit_d(th: [f64; 18], which: i32, comp: i32) -> f64 with Mut, Div, Panic {
    var a: [f64; 4] = [0.0; 4]
    var b: [f64; 4] = [0.0; 4]
    a[0] = olz_f_abs()
    a[1] = olz_obs_clf()
    a[2] = olz_obs_vssf()
    a[3] = olz_fe()
    b[0] = a[0]
    b[1] = a[1]
    b[2] = a[2]
    b[3] = a[3]
    let h = 1.0e-4 * a[which]
    a[which] = a[which] + h
    b[which] = b[which] - h
    let tp = olz_fit(th, a[0], a[1], a[2], a[3])
    let tm = olz_fit(th, b[0], b[1], b[2], b[3])
    return (tp[comp] - tm[comp]) / (2.0 * h)
}

fn olz_u4(th: [f64; 18], comp: i32) -> f64 with Mut, Div, Panic {
    let a = olz_fit_d(th, 0, comp) * olz_u_f_abs()
    let b = olz_fit_d(th, 1, comp) * olz_u_clf()
    let c = olz_fit_d(th, 2, comp) * olz_u_vssf()
    let e = olz_fit_d(th, 3, comp) * olz_u_fe()
    return cd_sqrt(a * a + b * b + c * c + e * e)
}

pub fn olz_fit_record(d: &!Circ28Drug) with Mut, Div, Panic, Epistemic {
    let th0 = circ28_drug_theta(d)
    let th = olz_fit(th0, olz_f_abs(), olz_obs_clf(), olz_obs_vssf(), olz_fe())
    let u_int = olz_u4(th0, CD_CLINT)
    let u_ren = olz_u4(th0, CD_CLREN)
    let u_kp = olz_u4(th0, CD_KPSC)
    let u_fa = olz_u4(th0, CD_FA)
    circ28_drug_set(d, CD_CLREN, th[CD_CLREN], u_ren, CD_STATUS_DERIVED, "CL_R = fe x CL/F, fe 0.07 (Kassahun 1997, label), pooled CL/F; u from u(fe) assumed 0.02 and u(CL/F)")
    circ28_drug_set(d, CD_KPSC, th[CD_KPSC], u_kp, CD_STATUS_FITTED, "fitted to F x pooled Vss/F (Sun 2021, Li 2018 popPK); u from u(Vss/F), u(F)")
    circ28_drug_set(d, CD_CLINT, th[CD_CLINT], u_int, CD_STATUS_FITTED, "fitted to F x pooled CL/F minus CL_R (Sun 2021, Li 2018, Bigos 2008); u from u(CL/F), u(F), u(fe)")
    circ28_drug_set(d, CD_FA, th[CD_FA], u_fa, CD_STATUS_DERIVED, "pre-hepatic availability F/(1-Eh), F 0.60 label input (not identifiable); u from u(F), u(CL/F), u(fe)")
}

// Tmax of a 1 mg run with the record's parameters and the given ka. The value array is filled in the
// function that runs the kernel: on lean_single, olz_tmax_ka(th, ka) called with an array built in the
// caller returned 0 from main and a slope 6 % off inside olz_ka_record (measured 2026-11-15; the Madaros
// builds are right either way). Not fixed in the compiler; the test guards u(ka).
pub fn olz_tmax_at(d: &Circ28Drug, ka: f64) -> f64 with Mut, Div, Panic, Epistemic {
    var th: [f64; 18] = [0.0; 18]
    var i: i32 = 0
    while i < 18 {
        th[i] = circ28_drug_value(d, i)
        i = i + 1
    }
    th[CD_KA] = ka
    var r: [f64; 16] = [0.0; 16]
    olz_run_th(th, 1.0, &!r)
    return r[1]
}

pub fn olz_ka_record(d: &!Circ28Drug) with Mut, Div, Panic, Epistemic {
    let ka = olz_ka_fit()
    let h = 1.0e-3 * ka
    let tp = olz_tmax_at(d, ka + h)
    let tm = olz_tmax_at(d, ka - h)
    let slope = (tp - tm) / (2.0 * h)
    circ28_drug_set(d, CD_KA, ka, olz_u_tmax() / olz_abs(slope), CD_STATUS_FITTED, "fitted to the pooled Tmax 5.0 h (Sun 2018, PMC3480756); u from u(Tmax) / |dTmax/dka|")
}

// Fills a record made by circ28_drug_new() (no function builds and returns the record: see the
// midazolam module).
pub fn olz_drug_into(d: &!Circ28Drug) with Mut, Div, Panic, Epistemic {
    olz_measured_record(d)
    olz_fit_record(d)
    olz_ka_record(d)
}

// fm of the record (non-smoker) from the pooled fluvoxamine ratio.
pub fn olz_fm(d: &Circ28Drug) -> f64 with Mut, Div, Panic, Epistemic {
    let th = circ28_drug_theta(d)
    return olz_fm_fit(th, olz_obs_flv(), olz_flv_resid())
}

// u(fm) from u(R_flv) and u(r), central differences.
pub fn olz_u_fm(d: &Circ28Drug) -> f64 with Mut, Div, Panic, Epistemic {
    let th = circ28_drug_theta(d)
    let r0 = olz_obs_flv()
    let s0 = olz_flv_resid()
    let hr = 1.0e-4 * r0
    let hs = 1.0e-4
    let d1 = (olz_fm_fit(th, r0 + hr, s0) - olz_fm_fit(th, r0 - hr, s0)) / (2.0 * hr)
    let d2 = (olz_fm_fit(th, r0, s0 + hs) - olz_fm_fit(th, r0, s0 - hs)) / (2.0 * hs)
    let a = d1 * olz_u_flv()
    let b = d2 * olz_u_flv_resid()
    return cd_sqrt(a * a + b * b)
}

// ---- budget with refit -------------------------------------------------------------
// Ten inputs: 0 logP, 1 pKa1, 2 fu, 3 bp (measured), 4 F (label input), 5 CL/F, 6 V_ss/F,
// 7 fe, 8 Tmax (observables), 9 tlag. Every evaluation refits clren, kpsc, clint, fa in closed
// form and ka by one chord step on the kernel Tmax, then runs 10 mg oral. Outputs: 0 AUC0-inf,
// 1 Cmax, 2 steady-state trough per mg/day, 3 Tmax reached, 4 ka. Forward differences with
// h_i = 0.1 u_i (11 evaluations, 22 kernel runs, plus 2 for the slope).
pub fn olz_input_name(i: i32) -> string {
    if i == 0 { return "logP    " }
    if i == 1 { return "pKa1    " }
    if i == 2 { return "fu      " }
    if i == 3 { return "B:P     " }
    if i == 4 { return "F       " }
    if i == 5 { return "CL/F    " }
    if i == 6 { return "Vss/F   " }
    if i == 7 { return "fe      " }
    if i == 8 { return "Tmax    " }
    return "tlag    "
}

pub fn olz_eval(z: &[f64; 10], thb: [f64; 18], ka0: f64, slope: f64, out: &![f64; 8]) with Mut, Div, Panic {
    var t = thb
    t[CD_LOGP] = (*z)[0]
    t[CD_PKA1] = (*z)[1]
    t[CD_FU] = (*z)[2]
    t[CD_BP] = (*z)[3]
    t[CD_TLAG] = (*z)[9]
    t = olz_fit(t, (*z)[4], (*z)[5], (*z)[6], (*z)[7])
    t[CD_KA] = ka0
    var r: [f64; 16] = [0.0; 16]
    olz_run_th(t, 10.0, &!r)
    let ka2 = ka0 + ((*z)[8] - r[1]) / slope
    t[CD_KA] = ka2
    olz_run_th(t, 10.0, &!r)
    (*out)[0] = r[2]
    (*out)[1] = r[0]
    (*out)[2] = r[8] / 10.0
    (*out)[3] = r[1]
    (*out)[4] = ka2
}

pub struct OlzBudget {
    pub y: [f64; 3],            // AUC (mg h/L), Cmax (mg/L), trough per mg/day (mg/L per mg)
    pub vv: [f64; 3],
    pub u_in: [f64; 10],
    pub share: [f64; 30],       // share[3 i + j] = variance contribution of input i to output j
    pub runs: i32,
}

pub fn olz_budget(d: &Circ28Drug) -> OlzBudget with Mut, Div, Panic, Epistemic {
    let thb = circ28_drug_theta(d)
    let ka0 = thb[CD_KA]
    let hk = 1.0e-3 * ka0
    let slope = (olz_tmax_ka(thb, ka0 + hk) - olz_tmax_ka(thb, ka0 - hk)) / (2.0 * hk)
    var z: [f64; 10] = [0.0; 10]
    var u: [f64; 10] = [0.0; 10]
    z[0] = olz_logp()
    u[0] = olz_u_logp()
    z[1] = olz_pka1()
    u[1] = olz_u_pka1()
    z[2] = olz_fu()
    u[2] = olz_u_fu()
    z[3] = olz_bp()
    u[3] = olz_u_bp()
    z[4] = olz_f_abs()
    u[4] = olz_u_f_abs()
    z[5] = olz_obs_clf()
    u[5] = olz_u_clf()
    z[6] = olz_obs_vssf()
    u[6] = olz_u_vssf()
    z[7] = olz_fe()
    u[7] = olz_u_fe()
    z[8] = olz_obs_tmax()
    u[8] = olz_u_tmax()
    z[9] = olz_tlag()
    u[9] = olz_u_tlag()
    var o0: [f64; 8] = [0.0; 8]
    var o1: [f64; 8] = [0.0; 8]
    olz_eval(&z, thb, ka0, slope, &!o0)
    var y: [f64; 3] = [0.0; 3]
    var vr: [f64; 3] = [0.0; 3]
    var sh: [f64; 30] = [0.0; 30]
    y[0] = o0[0]
    y[1] = o0[1]
    y[2] = o0[2]
    var runs: i32 = 4
    var i: i32 = 0
    while i < 10 {
        let h = 0.1 * u[i]
        let keep = z[i]
        z[i] = keep + h
        olz_eval(&z, thb, ka0, slope, &!o1)
        z[i] = keep
        runs = runs + 2
        var j: i32 = 0
        while j < 3 {
            let dv = (o1[j] - o0[j]) / h
            let c = dv * dv * u[i] * u[i]
            sh[3 * i + j] = c
            vr[j] = vr[j] + c
            j = j + 1
        }
        i = i + 1
    }
    return OlzBudget { y: y, vv: vr, u_in: u, share: sh, runs: runs }
}
