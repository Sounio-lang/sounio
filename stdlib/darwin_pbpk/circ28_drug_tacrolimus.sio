// stdlib/darwin_pbpk/circ28_drug_tacrolimus.sio — tacrolimus on the circ28 drug record
//
// Tacrolimus in a healthy adult (ICRP 89 reference male, 73 kg), whole-blood
// concentrations, intravenous and oral, with SATURABLE ERYTHROCYTE BINDING
// (local, per blood bed: circ28_nl.sio) and intestinal CYP3A first pass.
// Every number is traceable to a row below. Sources were opened on 2026-11-15;
// the access level of each is stated. Nothing here comes from memory.
//
// STATUS: 1 measured, 2 derived by a stated formula from cited measurements,
//         3 fitted to a named observable (that observable is then NOT a
//         validation of the model).
// u is the STANDARD UNCERTAINTY OF THE VALUE (what enters the budget), never an
// inter-individual SD. A sample SD of n subjects gives SD / sqrt(n); a range
// gives range / sqrt(12); "judgment" marks a number whose width is a stated
// judgment, not a measured spread.
//
// UNITS. The kernel works in mg and L; concentrations are mg/L. Concentrations
// quoted in ng/mL (= ug/L) are converted by 1e-3 at the boundary (tac_ngml).
//
//  param    value      u         status  basis of u            source (access)
//  MW       804.02     0         1       exact                 Emoto 2019 CPT:PSP 8:273 Table 1 (PMC6539708,
//                                                              full text via the dossier); PubChem CID 445643
//  logP     3.30       0.0115    1       range/sqrt12 of 3.26  3.3 Emoto 2019 Table 1 = PubChem Sangster;
//                                        and 3.3               3.26 Van der Veken 2023 (PMC10536648, citing
//                                                              Gertz 2010) (dossier rows; secondary)
//  pKa      -          -         0       -                     neutral (Van der Veken 2023); ion class 0
//  fu       0.012      0.0021    1       range/sqrt12 of the   Zahir 2001 J Pharmacol Toxicol Methods 46:27
//                                        equilibrium-dialysis  (PMID 12164257, abstract): 1.2 +/- 0.12 % at
//                                        / ultrafiltration     37 C; Emoto 2019 Table 1: 0.012; Zahir 2004 Br
//                                        values 0.0047-0.012   J Clin Pharmacol 57:298 (PMID 14998426, abstract,
//                                        (the 0.27 of          40 liver recipients): 0.47 % (0.07-0.89); Sikma
//                                        ultracentrifugation,  2020 (PMID 31840222): 1/137 = 0.0073; Prograf
//                                        Piekoszewski 1993,    label: "approximately 99 %" bound (DailyMed
//                                        is excluded by the    SPL set 7f667de1..., full text of section 12.3)
//                                        model owner)
//  Hct      0.434      0.0104    1       |0.47-0.434|/sqrt12   ICRP 89 Table 2.12: red cells 2300 mL of 5300 mL
//                                                              total blood volume = 0.434 (full text, physiology
//                                                              dossier). This is the BODY haematocrit, the one
//                                                              that goes with the kernel's total blood volume of
//                                                              5.3 L; the VENOUS haematocrit is higher (0.47,
//                                                              PK-Sim male curve, secondary, origin not shown).
//                                                              The venous value is the upper end of u.
//  Bmax     418 ng/mL  109       2       26 % each of Bmax     Jusko 1995 Clin Pharmacol Ther 57:281 (PMID 7535213)
//           of RBC     ng/mL             and Kd, from the      AS CITED BY Storset 2014 Br J Clin Pharmacol
//                                        label B:P spread      78:509 (PMC4243902, FULL TEXT OPENED 2026-11-15:
//                                        (below)               "B max = 418 ug l-1 erythrocytes, K D = 3.8 ug l-1
//                                                              plasma ... obtained from the literature (ref 35)").
//  Kd       3.8 ng/mL  1.0       2       (below)               The primary paper (Jusko 1995) is NOT opened: its
//           of plasma  ng/mL                                   abstract (read via PubMed) gives the maximum B:P
//                                                              55.5 +/- 26.8 (SD), range 13-114, and the model, not
//                                                              Bmax/Kd. Corroboration (abstract only): Chow,
//                                                              Piekoszewski, Jusko 1997 Drug Metab Dispos 25:610
//                                                              (PMID 9152601): "binding capacity ... 440 ng/ml of
//                                                              RBCs; the binding affinity was 0.876 ng/ml using
//                                                              plasma or buffer" (Hct 0.05-0.4, in vitro).
//                                                              Contradiction: Koomen 2023 Clin Pharmacokinet 62:1233
//                                                              (PMID 37306899, full text): Bmax 35.7 ng/mL, Kd 0.24
//                                                              ng/mL total plasma, TROUGHS only (capacity 13.9
//                                                              ng/mL in blood: unusable above ~10-12 ng/mL).
//                                                              Form used (model owner's decision, = Koomen Eq 2 + 4):
//                                                                C_b = (1-Hct) C_p + Hct Bmax C_p/(Kd + C_p)
//                                                              (Storset adds the whole C_p instead of (1-Hct) C_p;
//                                                              the difference is at most (1-Hct) C_p, i.e. < 1.3 %
//                                                              of C_b at low concentration).
//                                                              UNCERTAINTY. The label (Prograf, DailyMed 2025) gives
//                                                              a whole-blood:plasma ratio "averaged 35 (range 12 to
//                                                              67)". Range/sqrt12 = 15.9, 37 % of the model value
//                                                              at 13 ng/mL (43). At the concentrations of the
//                                                              runs C_p << Kd, so B:P ~ Hct Bmax/Kd and
//                                                              u(B:P)/B:P = sqrt((u_B/Bmax)^2 + (u_K/Kd)^2); taking
//                                                              the two relative widths equal, each is 0.37/sqrt2 =
//                                                              0.26. The label range is an inter-individual
//                                                              spread, so this treats it as a bound on what is
//                                                              known of the population value: deliberately wide
//                                                              (judgment). It covers Chow's Kd 0.876 at 2.9 u, not
//                                                              Koomen's.
//  clint    fitted     propagated 3      from u of CL          FITTED to whole-blood CL 0.040 L/h/kg x 73 kg
//  clgut    fitted     propagated 3      from u of F           FITTED to the oral F of Floren 1997 (below)
//  clform, clren, clpla   0      0       -                     renal: < 1 % of the dose unchanged in urine
//                                                              (Prograf label: "less than 1 %"); set to 0
//  kpsc     fitted     propagated 3      from u of Vss         FITTED to V_ss(whole blood) 1.91 L/kg x 73 kg
//  ps_gut   11.33 L/h  5.0       2       factor-2 band         Peff,man 4.77e-4 cm/s (Tamura 2002 J Pharm Sci
//                                        (judgment)            91:719, as cited by Van der Veken 2023; the
//                                                              primary paper not opened; a RAT-derived value that
//                                                              lumps P-gp efflux, Michailides 2026) x 6600 cm2
//                                                              (adult intestinal surface, Brussee 2018 as used in
//                                                              the midazolam module) x 3.6 L/h per cm3/s. fu,gut
//                                                              is 1 in the sources; here the kernel convention
//                                                              (clint_gut acts on fu T/kp) is used and the fit
//                                                              is in clint_gut.
//  ps scalar fitted    u(Y)/|dY/ds| 3    Storset RSEs          FITTED to the end-of-infusion observable Y = C_wb(4 h) V_ss / D = 3.50
//           (CD_PSSC)  (0.046 at s     (10/11/13/16 %)       (u 0.50, 14 %) from Storset 2014 Br J Clin Pharmacol 78:509
//                      0.097)                                (PMC4243902, FULL TEXT OPENED 2026-11-15) Table 2: adult
//                                                              kidney-transplant PATIENTS, ORAL data, whole-blood two-
//                                                              compartment model (CL/F 16.1 L/h, V1/F 125 L, Q/F 23.8
//                                                              L/h, V2/F 636 L; F cancels in the rate constants and in
//                                                              V1/(V1+V2)). No IV two-compartment fit in healthy
//                                                              volunteers was found (Floren 1997 and Hebert 1999: NCA only,
//                                                              abstracts). Status FITTED to a DERIVED patient observable.
//                                                              The record's ps_i = 20 Q_i had no source.
//  ka       fitted     propagated 3      from u of Tmax        FITTED to the oral Tmax of Bekersky 2001
//  fa       1.0        0.115     2       [0.6, 1.0]/sqrt12     Emoto 2019 (Simcyp, fitted): fa 1.0; Itohara 2019
//                                                              (PMID 31087501): fa fixed 0.6. Fa and Fg are not
//                                                              separable from F; the fit takes fa as given.
//  tlag     0          -         0       -                     unused (absorption lag absorbed by ka)
//
// OBSERVABLES USED TO FIT (one per fitted parameter; NOT validations)
//   V_ss     1.91 L/kg x 73 kg = 139.43 L whole blood; SD 0.31 L/kg, n = 8: u = 0.31/sqrt8 x 73 = 8.0 L.
//            Prograf label Table 17 (DailyMed SPL, FULL TEXT): healthy volunteers, IV 0.025 mg/kg over 4 h.
//            The 73 kg is the model body weight, an assumption: the label gives no weight.
//            Other studies give much smaller values (Floren 1997 0.99 +/- 0.26 L/kg, n = 6; Jusko 1995 0.9
//            L/kg, liver recipients): the between-study spread (factor 2) is NOT in u and is the first
//            suspect for any volume-driven failure. The label V is the one the model owner chose.
//   CL_iv    0.040 +/- 0.009 L/h/kg (SD, n = 8) x 73 = 2.92 L/h whole-blood clearance, u = 0.009/sqrt8 x 73
//            = 0.232 L/h. Prograf label Table 17 (same row).
//   F        0.14 +/- 0.05 (SD, n = 6): Floren 1997 Clin Pharmacol Ther 62:41 (PMID 9246018, ABSTRACT read
//            via PubMed 2026-11-15): 0.1 mg/kg oral and 0.025 mg/kg IV, whole blood. u = 0.05/sqrt6 = 0.0204.
//            Fa is taken as given (CD_FA), so the fit sets the gut-wall clearance with F = Fa Fg (1 - Eh):
//            the FITTED OBSERVABLE IS FLOREN'S F, NOT the label's 18 +/- 5 % (an independent study, used
//            below as a validation) and not Floren's Fh. This choice keeps AUC_oral = F Dose / CL an
//            independent prediction (F and CL come from different studies).
//   Tmax     1.37 h, u = 0.128 h. Bekersky, Dressler, Mekki 2001 J Clin Pharmacol 41:176 (PMID 11210398,
//            ABSTRACT read via PubMed): 5 x 1 mg capsules, fasting, n = 15 healthy men, tmax 1.37 h (no SD in
//            the abstract). u is the label row's SD 0.7 h / sqrt(30) (5 mg capsules, label Table 17,
//            PO row N = 30 as read from the table text): a stand-in, since Bekersky's SD is not in the abstract.
//
// CLOSED FORMS USED BY THE FITS (kernel equations; bp = the local blood:plasma ratio at C_ref, below)
//   C_ref  = D_iv / V_ss,obs = 0.025 mg/kg x 73 kg / 139.43 L = 13.1 ng/mL: the concentration at which
//            amount in body / blood concentration equals V_ss for the IV experiment (D/V_ss = AUC/MRT).
//   bp_ref = C_ref / P(C_ref), P the inverse of the binding relation (nl28_plasma).
//   V_ss(plasma-referred) = V_ss,wb x bp_ref  ->  kpsc by circ28_kp_scale_for_vss.
//   Q'g   = Q_gut bp ps_gut / (ps_gut + Q_gut bp);  Fg = Q'g / (Q'g + cg),  cg = clint_gut fu
//   Eg    = cl_g/(Q_gut + cl_g), cl_g = (ps_gut cg/(ps_gut + cg))/bp
//   Eh    = (CL_wb - Q_gut Eg)/(Q_h - Q_gut Eg)            (circ28_splanchnic_clearance, CL in BLOOD)
//   F     = Fa Fg (1 - Eh) = F_obs  solved for cg by bisection;  clint fu = y ps_liver/(ps_liver - y),
//           y = bp Q_h Eh/(1 - Eh).
//   ka    = root of Tmax(ka) = Tmax_obs by bisection on the nl28 run (the bound 10 /h when Tmax(10) stays above it).
//   ps    = root of Y_kernel(s) = Y_obs by bisection on ln s over [s_min, 1] with the other fits redone at every s
//           (s_min: the hepatic clearance fit needs ps_liver above the plasma-referred hepatic clearance).
// The closed forms use ONE bp (bp_ref); the run uses the local bp of every bed. The test prints how far
// the simulated Vss-independent quantities (IV AUC, F) move from the closed-form ones.

use darwin_pbpk::circ28::*
use darwin_pbpk::circ28_kp::*
use darwin_pbpk::circ28_drug::*
use darwin_pbpk::circ28_blood::*
use darwin_pbpk::circ28_nl::*
use math::pure::{exp, ln}

// ---- measured inputs --------------------------------------------------------
pub fn tac_mw() -> f64 { return 804.02 }
pub fn tac_logp() -> f64 { return 3.3 }
pub fn tac_u_logp() -> f64 { return 0.0115 }
pub fn tac_fu() -> f64 { return 0.012 }
pub fn tac_u_fu() -> f64 { return 0.0021 }
pub fn tac_hct() -> f64 { return 0.434 }
pub fn tac_u_hct() -> f64 { return 0.0104 }
// ng/mL -> mg/L
pub fn tac_ngml(x: f64) -> f64 { return 0.001 * x }
pub fn tac_bmax() -> f64 { return 0.418 }           // mg/L of erythrocytes (418 ng/mL)
pub fn tac_u_bmax() -> f64 { return 0.109 }
pub fn tac_kd() -> f64 { return 0.0038 }            // mg/L of plasma (3.8 ng/mL)
pub fn tac_u_kd() -> f64 { return 0.0010 }
pub fn tac_fa() -> f64 { return 1.0 }
pub fn tac_u_fa() -> f64 { return 0.115 }
pub fn tac_peff() -> f64 { return 4.77e-4 }          // cm/s
pub fn tac_gut_area() -> f64 { return 6600.0 }       // cm2
pub fn tac_psgut() -> f64 { return tac_peff() * tac_gut_area() * 3.6 }   // L/h
pub fn tac_u_psgut() -> f64 { return 1.5 * tac_psgut() / 3.4641016151377544 }
pub fn tac_bw() -> f64 { return 73.0 }               // kg, model body weight (ICRP 89)

// ---- observables ------------------------------------------------------------
pub fn tac_obs_vss() -> f64 { return 1.91 * tac_bw() }                   // L whole blood
pub fn tac_u_vss() -> f64 { return 0.31 / 2.8284271247461903 * tac_bw() }
pub fn tac_obs_cl() -> f64 { return 0.040 * tac_bw() }                   // L/h whole blood
pub fn tac_u_cl() -> f64 { return 0.009 / 2.8284271247461903 * tac_bw() }
pub fn tac_obs_f() -> f64 { return 0.14 }
pub fn tac_u_f() -> f64 { return 0.05 / 2.449489742783178 }
pub fn tac_obs_tmax() -> f64 { return 1.37 }
pub fn tac_u_tmax() -> f64 { return 0.7 / 5.477225575051661 }
pub fn tac_d_iv() -> f64 { return 0.025 * tac_bw() }                     // mg, IV dose of the Vss observable

// ka (1/h). THE Tmax FIT DOES NOT REACH ITS OBSERVABLE. With the fitted Kp scalar the gut tissue holds the
// dose (gut Kp ~ 115, permeability-limited ps_gut 11.3 L/h) and the model's Tmax falls to a FLOOR as ka
// grows (measured 2026-11-15, 5 mg, scratch scan: ka 0.5 -> Tmax 4.84 h, 1.5 -> 2.78, 4.5 -> 1.91,
// 13.5 -> 1.70, 40.5 -> 1.654, 121.5 -> 1.646 h), above the observed 1.37 h. The least-squares solution of
// |Tmax(ka) - 1.37| over ka in (0, ka_max] is therefore the BOUND ka_max = 10 /h (absorption half-life
// 4 min; Jusko 1995 measured 4.5 +/- 3.0 /h in liver recipients, abstract; Emoto 2019 fitted 3.68 /h,
// dossier). It is FITTED AT ITS BOUND: the residual Tmax - 1.37 is a failure of the structure, reported
// by the test, not tuned away.
pub fn tac_ka_fit() -> f64 { return 10.0 }

// ---- fit inputs -------------------------------------------------------------
pub struct TacObs {
    pub hct: f64,
    pub bmax: f64,
    pub kd: f64,
    pub vss: f64,
    pub cl: f64,
    pub f: f64,
    pub d_iv: f64,
    pub psl: i32,
}

pub fn tac_obs_base() -> TacObs {
    return TacObs { hct: tac_hct(), bmax: tac_bmax(), kd: tac_kd(), vss: tac_obs_vss(), cl: tac_obs_cl(), f: tac_obs_f(), d_iv: tac_d_iv(), psl: tac_psl() }
}

// ---- ROUND 2: the tissue permeability scalar (CD_PSSC) -----------------------------------------------------
// The record default ps_i = 20 Q_i is a placeholder with no source (circ28_drug.sio header). CD_PSSC scales it.
// Two variants, selected by `psl`:
//   0  (variant A) CD_PSSC scales every organ, the liver included (the slot semantics of circ28_drug.sio);
//   1  (variant B) the liver ps stays at its flow-limited default 20 Q_h, CD_PSSC scales the 12 other organs
//      (the gut ps is the record value CD_PSGUT in both). Hepatic uptake of a lipophilic drug whose hepatic
//      blood extraction is 2.7 % is not permeability-limited, and variant A cannot go below the ps for which the
//      hepatic clearance fit exists (ps_liver must exceed the plasma-referred clearance): see the test header.
// Which variant is in the record: tac_psl().
pub fn tac_psl() -> i32 { return 0 }

pub fn tac_params_theta(th: [f64; 18], psl: i32) -> Circ28Params with Mut, Div, Panic {
    var p = circ28_drug_params_theta(th)
    if psl == 1 {
        p.ps[1] = circ28_drug_ps_mult() * circ28_q_hepatic(p)
    }
    return p
}

// Storset 2014 Br J Clin Pharmacol 78:509 (PMC4243902, full text opened 2026-11-15) Table 2, whole-blood two-compartment
// model of adult kidney-transplant recipients (PATIENTS, ORAL data), HCT 45 %, FFM 60 kg: CL/F 16.1 L/h (RSE 10 %),
// V1/F 125 L (11 %), Q/F 23.8 L/h (13 %), V2/F 636 L (16 %). F cancels in the rate constants.
pub fn tac_st_cl() -> f64 { return 16.1 }
pub fn tac_st_v1() -> f64 { return 125.0 }
pub fn tac_st_q() -> f64 { return 23.8 }
pub fn tac_st_v2() -> f64 { return 636.0 }

// Y = C(t_inf) V_ss / D for an infusion of length t_inf into a two-compartment model (central V1, V_ss = V1 + V2).
pub fn tac_st_y_of(cl: f64, v1: f64, q: f64, v2: f64, t_inf: f64) -> f64 with Mut, Div, Panic {
    let k10 = cl / v1
    let k12 = q / v1
    let k21 = q / v2
    let sm = k10 + k12 + k21
    let r = cd_sqrt(sm * sm - 4.0 * k10 * k21)
    let al = 0.5 * (sm + r)
    let be = 0.5 * (sm - r)
    let a = (al - k21) / (al - be)
    let b = (k21 - be) / (al - be)
    let c = (a / al) * (1.0 - exp(0.0 - al * t_inf)) + (b / be) * (1.0 - exp(0.0 - be * t_inf))
    return (v1 + v2) / v1 * c / t_inf
}

pub fn tac_y_obs() -> f64 with Mut, Div, Panic {
    return tac_st_y_of(tac_st_cl(), tac_st_v1(), tac_st_q(), tac_st_v2(), 4.0)
}

// u(Y) from the four RSEs (independent: the correlations are not published), central finite differences.
pub fn tac_u_y() -> f64 with Mut, Div, Panic {
    let c = tac_st_cl()
    let v1 = tac_st_v1()
    let q = tac_st_q()
    let v2 = tac_st_v2()
    let h = 1.0e-4
    let d0 = (tac_st_y_of(c * (1.0 + h), v1, q, v2, 4.0) - tac_st_y_of(c * (1.0 - h), v1, q, v2, 4.0)) / (2.0 * h * c)
    let d1 = (tac_st_y_of(c, v1 * (1.0 + h), q, v2, 4.0) - tac_st_y_of(c, v1 * (1.0 - h), q, v2, 4.0)) / (2.0 * h * v1)
    let d2 = (tac_st_y_of(c, v1, q * (1.0 + h), v2, 4.0) - tac_st_y_of(c, v1, q * (1.0 - h), v2, 4.0)) / (2.0 * h * q)
    let d3 = (tac_st_y_of(c, v1, q, v2 * (1.0 + h), 4.0) - tac_st_y_of(c, v1, q, v2 * (1.0 - h), 4.0)) / (2.0 * h * v2)
    let a0 = d0 * 0.10 * c
    let a1 = d1 * 0.11 * v1
    let a2 = d2 * 0.13 * q
    let a3 = d3 * 0.16 * v2
    return cd_sqrt(a0 * a0 + a1 * a1 + a2 * a2 + a3 * a3)
}

fn tac_abs(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

// Local blood:plasma ratio at whole-blood concentration c (mg/L).
pub fn tac_bp_at(hct: f64, bmax: f64, kd: f64, c: f64) -> f64 with Mut, Div, Panic {
    return nl28_bp_local(hct, bmax, kd, c)
}

// Model closed forms as functions of cg = clint_gut fu at bp, for the gut/hepatic split.
// Returns Eh (hepatic extraction ratio) such that the splanchnic blood clearance is cl.
fn tac_eh_of(p: Circ28Params, bp: f64, cg: f64, cl: f64) -> f64 with Div {
    let clg = (p.ps[8] * cg / (p.ps[8] + cg)) / bp
    let eg = clg / (p.q[8] + clg)
    let x = p.q[8] * eg
    return (cl - x) / (circ28_q_hepatic(p) - x)
}

fn tac_fg_of(p: Circ28Params, bp: f64, cg: f64) -> f64 with Div {
    let qb = p.q[8] * bp
    let qg = qb * p.ps[8] / (p.ps[8] + qb)
    return qg / (qg + cg)
}

// Takes a value array with the measured parameters set; returns it with CD_BP (bp_ref), CD_KPSC,
// CD_CLGUT and CD_CLINT fitted. CD_CLINT = -1 when a fit is impossible.
pub fn tac_fit(th: [f64; 18], o: TacObs) -> [f64; 18] with Mut, Div, Panic {
    var t = th
    let cref = o.d_iv / o.vss
    let bp = tac_bp_at(o.hct, o.bmax, o.kd, cref)
    t[CD_BP] = bp
    t[CD_KPSC] = 1.0
    t[CD_CLGUT] = 0.0
    t[CD_CLINT] = 0.0
    let p0 = tac_params_theta(t, o.psl)
    let sc = circ28_kp_scale_for_vss(p0, p0.kp, o.vss * bp)
    if !(sc > 0.0) {
        t[CD_CLINT] = 0.0 - 1.0
        return t
    }
    t[CD_KPSC] = sc
    let p = tac_params_theta(t, o.psl)
    let fa = t[CD_FA]
    // F(cg) = fa Fg (1 - Eh) decreases in cg: bisection on ln cg (64 halvings of a 23-wide interval: below the double
    // precision of cg; 120 gave the same value)
    var lo = ln(1.0e-6)
    var hi = ln(1.0e7)
    var k: i32 = 0
    while k < 64 {
        let mid = 0.5 * (lo + hi)
        let cg = exp(mid)
        let eh = tac_eh_of(p, bp, cg, o.cl)
        let f = fa * tac_fg_of(p, bp, cg) * (1.0 - eh)
        if f > o.f {
            lo = mid
        } else {
            hi = mid
        }
        k = k + 1
    }
    let cgs = exp(0.5 * (lo + hi))
    t[CD_CLGUT] = cgs / p.fu
    let eh = tac_eh_of(p, bp, cgs, o.cl)
    if !(eh > 0.0) || !(eh < 1.0) {
        t[CD_CLINT] = 0.0 - 1.0
        return t
    }
    let qh = circ28_q_hepatic(p)
    let y = bp * qh * eh / (1.0 - eh)
    if !(p.ps[1] > y) {
        t[CD_CLINT] = 0.0 - 1.0
        return t
    }
    t[CD_CLINT] = (y * p.ps[1] / (p.ps[1] - y)) / p.fu
    return t
}

// ---- runner on the local non-linear stepper -----------------------------------
// Three-phase grid: dt1 on [0, t1], dt2 on [t1, t2], dt3 on [t2, t_end]. route 0: IV infusion of `dose` mg
// over t_inf h; route 1: first-order oral input (ka, fa, tlag) into the gut tissue.
pub struct TacDose {
    pub route: i32,
    pub dose: f64,
    pub t_inf: f64,
    pub ka: f64,
    pub fa: f64,
    pub tlag: f64,
    pub dt1: f64,
    pub t1: f64,
    pub dt2: f64,
    pub t2: f64,
    pub dt3: f64,
    pub t_end: f64,
    pub fit_lo: f64,
    pub fit_hi: f64,
}

// Oral run: 0.05 h to 3 h, 0.5 h to 12 h, 2 h to 240 h (192 steps); terminal fit 48-168 h.
pub fn tac_cfg_oral(dose_mg: f64) -> TacDose {
    return TacDose { route: 1, dose: dose_mg, t_inf: 0.0, ka: 1.0, fa: 1.0, tlag: 0.0, dt1: 0.05, t1: 3.0, dt2: 0.5, t2: 12.0, dt3: 2.0, t_end: 240.0, fit_lo: 48.0, fit_hi: 168.0 }
}

// Intravenous: 4 h infusion as in the label study; 0.05 h to 6 h, 0.5 h to 12 h, 2 h to 240 h.
pub fn tac_cfg_iv(dose_mg: f64, t_inf: f64) -> TacDose {
    return TacDose { route: 0, dose: dose_mg, t_inf: t_inf, ka: 1.0, fa: 1.0, tlag: 0.0, dt1: 0.05, t1: 6.0, dt2: 0.5, t2: 12.0, dt3: 2.0, t_end: 240.0, fit_lo: 48.0, fit_hi: 168.0 }
}

// Results. Concentrations are venous WHOLE BLOOD (mg/L) unless named plasma; AUCs mg h / L.
//   cmax, tmax     maximum on the grid refined by the parabola vertex (equal spacing); cmax_grid raw
//   bp_peak        local blood:plasma ratio of the venous pool at the grid maximum
//   c12, bp12      venous blood concentration and local ratio at 12 h; c24, bp24 at 24 h
//   auc_t          whole-blood AUC 0..t_end; auc72 at 72 h; auc_inf = auc_t + c_end / lambda_z
//   aucp_t         venous PLASMA AUC 0..t_end (the plasma curve, P(x_ven))
//   lambda_z, thalf  least squares slope of ln C_blood over fit_lo..fit_hi
pub struct TacRun {
    pub cmax: f64,
    pub tmax: f64,
    pub cmax_grid: f64,
    pub bp_peak: f64,
    pub c12: f64,
    pub bp12: f64,
    pub c24: f64,
    pub bp24: f64,
    pub auc_t: f64,
    pub auc72: f64,
    pub auc_inf: f64,
    pub aucp_t: f64,
    pub lambda_z: f64,
    pub thalf: f64,
    pub c_end: f64,
    pub c_inf: f64,
    pub input: f64,
    pub eliminated: f64,
    pub remaining: f64,
    pub balance_err: f64,
    pub fit_ok: bool,
    pub ok: bool,
    pub nfail: i32,
    pub it_mean: f64,
    pub vss_nca: f64,
}

pub fn tac_run(p: Circ28Params, hct: f64, bmax: f64, kd: f64, dc: TacDose, sysn: &!Nl28Sys) -> TacRun with Mut, Div, Panic {
    var ts: [f64; 400] = [0.0; 400]
    var cs: [f64; 400] = [0.0; 400]
    var ps: [f64; 400] = [0.0; 400]
    var au: [f64; 400] = [0.0; 400]
    var s = circ28_state_zero()
    // lean_single: the [0.0; 28] literal of circ28_state_zero is shared between calls (measured 2026-11-15: a
    // single-ratio run after an IV run started from the previous state), so the state is zeroed explicitly
    var kz: i32 = 0
    while kz < 28 {
        s.x[kz] = 0.0
        kz = kz + 1
    }
    var el = nl28_tally_zero()
    nl28_stats_reset(sysn)
    var n: i32 = 0
    var t = 0.0
    var input = 0.0
    var ok = true
    var ph: i32 = 0
    while ph < 3 {
        var dt = dc.dt1
        var tstop = dc.t1
        if ph == 1 {
            dt = dc.dt2
            tstop = dc.t2
        }
        if ph == 2 {
            dt = dc.dt3
            tstop = dc.t_end
        }
        nl28_prepare(p, hct, bmax, kd, dt, sysn)
        while ok && t + 0.5 * dt < tstop {
            if n >= 399 {
                ok = false
            } else {
                var iv = 0.0
                var oral = 0.0
                var mass = 0.0
                if dc.route == 0 {
                    mass = circ28_iv_mass(dc.dose, dc.t_inf, t, t + dt)
                    iv = mass / dt
                } else {
                    mass = circ28_oral_mass(dc.ka, dc.fa, dc.dose, dc.tlag, t, t + dt)
                    oral = mass / dt
                }
                let st = nl28_step(&!s, sysn, iv, oral, &!el)
                if st != 0 {
                    ok = false
                } else {
                    input = input + mass
                    t = t + dt
                    n = n + 1
                    ts[n] = t
                    cs[n] = s.x[0]
                    ps[n] = nl28_plasma(hct, bmax, kd, s.x[0])
                    au[n] = el.auc_ven
                }
            }
        }
        ph = ph + 1
    }
    var im: i32 = 0
    var cm = 0.0
    var i: i32 = 1
    while i <= n {
        if cs[i] > cm {
            cm = cs[i]
            im = i
        }
        i = i + 1
    }
    var cmax = cm
    var tmax = ts[im]
    if im >= 1 && im < n {
        let h1 = ts[im] - ts[im - 1]
        let h2 = ts[im + 1] - ts[im]
        if tac_abs(h1 - h2) < 1.0e-9 {
            let den = cs[im - 1] - 2.0 * cs[im] + cs[im + 1]
            if den < 0.0 {
                let off = 0.5 * (cs[im - 1] - cs[im + 1]) / den
                tmax = ts[im] + off * h1
                cmax = cs[im] - 0.25 * (cs[im - 1] - cs[im + 1]) * off
            }
        }
    }
    var c_inf = 0.0
    i = 1
    while i <= n {
        if tac_abs(ts[i] - dc.t_inf) < 1.0e-6 { c_inf = cs[i] }
        i = i + 1
    }
    var bp_peak = 0.0
    if ps[im] > 0.0 { bp_peak = cs[im] / ps[im] }
    var c12 = 0.0
    var bp12 = 0.0
    var c24 = 0.0
    var bp24 = 0.0
    var a72 = 0.0
    i = 1
    while i <= n {
        if tac_abs(ts[i] - 12.0) < 1.0e-6 {
            c12 = cs[i]
            if ps[i] > 0.0 { bp12 = cs[i] / ps[i] }
        }
        if tac_abs(ts[i] - 24.0) < 1.0e-6 {
            c24 = cs[i]
            if ps[i] > 0.0 { bp24 = cs[i] / ps[i] }
        }
        if tac_abs(ts[i] - 72.0) < 1.0e-6 { a72 = au[i] }
        i = i + 1
    }
    var sw = 0.0
    var st = 0.0
    var sy = 0.0
    var stt = 0.0
    var sty = 0.0
    var nf: i32 = 0
    var fit_ok = true
    i = 1
    while i <= n {
        if ts[i] >= dc.fit_lo && ts[i] <= dc.fit_hi {
            if cs[i] > 0.0 {
                let y = ln(cs[i])
                sw = sw + 1.0
                st = st + ts[i]
                sy = sy + y
                stt = stt + ts[i] * ts[i]
                sty = sty + ts[i] * y
                nf = nf + 1
            } else {
                fit_ok = false
            }
        }
        i = i + 1
    }
    var lz = 0.0
    if nf >= 3 && fit_ok {
        let den = sw * stt - st * st
        lz = 0.0 - (sw * sty - st * sy) / den
        if !(lz > 0.0) {
            fit_ok = false
            lz = 0.0
        }
    } else {
        fit_ok = false
    }
    var thalf = 0.0
    var auc_inf = 0.0
    if fit_ok {
        thalf = 0.6931471805599453 / lz
        auc_inf = el.auc_ven + cs[n] / lz
    }
    // non-compartmental V_ss of an intravenous run: trapezoid AUC and AUMC on the grid plus the
    // log-linear tail; V_ss = D/AUC (AUMC/AUC - t_inf/2)
    var vss_nca = 0.0
    if dc.route == 0 && fit_ok {
        var a = 0.0
        var am = 0.0
        i = 1
        while i <= n {
            a = a + 0.5 * (cs[i] + cs[i - 1]) * (ts[i] - ts[i - 1])
            am = am + 0.5 * (ts[i] * cs[i] + ts[i - 1] * cs[i - 1]) * (ts[i] - ts[i - 1])
            i = i + 1
        }
        let tl = ts[n]
        let a_tot = a + cs[n] / lz
        let am_tot = am + cs[n] * (tl / lz + 1.0 / (lz * lz))
        vss_nca = dc.dose / a_tot * (am_tot / a_tot - 0.5 * dc.t_inf)
    }
    let elim = nl28_eliminated(&el)
    let rem = circ28_total_mass(&s, p)
    var be = 0.0
    if input > 0.0 { be = tac_abs(input - elim - rem) / input }
    return TacRun {
        cmax: cmax, tmax: tmax, cmax_grid: cm, bp_peak: bp_peak, c12: c12, bp12: bp12, c24: c24, bp24: bp24,
        auc_t: el.auc_ven, auc72: a72, auc_inf: auc_inf, aucp_t: el.auc_pven, lambda_z: lz, thalf: thalf,
        c_end: cs[n], c_inf: c_inf, input: input, eliminated: elim, remaining: rem, balance_err: be, fit_ok: fit_ok, ok: ok,
        nfail: nl28_failures(sysn), it_mean: nl28_iter_mean(sysn), vss_nca: vss_nca
    }
}

// Same parameters through the single-ratio module (circ28_blood, implicit midpoint): uniform dt1 to t1,
// then a new engine at dt2 to t_end (the state and the area are carried). Returns cmax, tmax, AUC at 72 h,
// AUC at t_end, c12. `sysc` is created once by the caller.
pub struct TacSingle {
    pub cmax: f64,
    pub tmax: f64,
    pub auc72: f64,
    pub auc_t: f64,
    pub c12: f64,
    pub bp_min: f64,
    pub bp_max: f64,
    pub input: f64,
    pub remaining: f64,
}

pub fn tac_run_single(p: Circ28Params, hct: f64, bmax: f64, kd: f64, dc: TacDose, sysc: &!Circ28Sys) -> TacSingle with Mut, Div, Panic {
    var b = blood28_new(p, hct, bmax, kd, dc.dt1)
    var kz: i32 = 0
    while kz < 28 {
        blood28_set_x(&!b, kz, 0.0)
        kz = kz + 1
    }
    var t = 0.0
    var input = 0.0
    var cm = 0.0
    var tm = 0.0
    var c12 = 0.0
    var a72 = 0.0
    while t + 0.5 * dc.dt1 < dc.t1 {
        var iv = 0.0
        var oral = 0.0
        var mass = 0.0
        if dc.route == 0 {
            mass = circ28_iv_mass(dc.dose, dc.t_inf, t, t + dc.dt1)
            iv = mass / dc.dt1
        } else {
            mass = circ28_oral_mass(dc.ka, dc.fa, dc.dose, dc.tlag, t, t + dc.dt1)
            oral = mass / dc.dt1
        }
        input = input + mass
        blood28_step(&!b, sysc, iv, oral)
        t = t + dc.dt1
        let c = blood28_get_x(&b, 0)
        if c > cm {
            cm = c
            tm = t
        }
        if tac_abs(t - 12.0) < 1.0e-6 { c12 = c }
    }
    let a1 = blood28_auc_blood(&b)
    var b2 = blood28_new(p, hct, bmax, kd, dc.dt2)
    var k: i32 = 0
    while k < 28 {
        blood28_set_x(&!b2, k, blood28_get_x(&b, k))
        k = k + 1
    }
    b2.el.auc_ven = a1
    while t + 0.5 * dc.dt2 < dc.t_end {
        var oral2 = 0.0
        var mass2 = 0.0
        if dc.route == 1 {
            mass2 = circ28_oral_mass(dc.ka, dc.fa, dc.dose, dc.tlag, t, t + dc.dt2)
            oral2 = mass2 / dc.dt2
        }
        input = input + mass2
        blood28_step(&!b2, sysc, 0.0, oral2)
        t = t + dc.dt2
        let c = blood28_get_x(&b2, 0)
        if c > cm {
            cm = c
            tm = t
        }
        if tac_abs(t - 12.0) < 1.0e-6 { c12 = c }
        if tac_abs(t - 72.0) < 1.0e-6 { a72 = blood28_auc_blood(&b2) }
    }
    return TacSingle {
        cmax: cm, tmax: tm, auc72: a72, auc_t: blood28_auc_blood(&b2), c12: c12,
        bp_min: blood28_bp_min(&b2), bp_max: blood28_bp_max(&b2), input: input,
        remaining: blood28_remaining(&b2)
    }
}


// ---- ROUND 2: fit of the ps scalar to the end-of-infusion observable Y -----------------------------------------
// Y_kernel(s) = C_wb(4 h) V_ss / D for the label infusion, the other fits (Kp scalar, clgut, clint) redone at every s.
// Returns -1 when the hepatic clearance fit does not exist at this s.
pub fn tac_y_at(th0: [f64; 18], o: TacObs, s: f64, sysn: &!Nl28Sys) -> f64 with Mut, Div, Panic {
    var t = th0
    t[CD_PSSC] = s
    t = tac_fit(t, o)
    if !(t[CD_CLINT] > 0.0) { return 0.0 - 1.0 }
    let p = tac_params_theta(t, o.psl)
    var dc = tac_cfg_iv(o.d_iv, 4.0)
    // only C(T_inf = 4 h) is read: the run stops there (same 0.05 h steps as before, so c_inf is bit-identical)
    dc.t1 = 4.0
    dc.t2 = 4.0
    dc.t_end = 4.0
    let r = tac_run(p, o.hct, o.bmax, o.kd, dc, sysn)
    if !r.ok { return 0.0 - 1.0 }
    return r.c_inf * o.vss / o.d_iv
}

// Does the closed-form fit exist at this s (no run)?
pub fn tac_fit_exists(th0: [f64; 18], o: TacObs, s: f64) -> bool with Mut, Div, Panic {
    var t = th0
    t[CD_PSSC] = s
    t = tac_fit(t, o)
    return t[CD_CLINT] > 0.0
}

// Smallest s in [1e-3, 1] for which the fit exists (bisection on ln s, 14 halvings).
pub fn tac_ps_min(th0: [f64; 18], o: TacObs, sysn: &!Nl28Sys) -> f64 with Mut, Div, Panic {
    var lo = ln(1.0e-3)
    var hi = 0.0
    if tac_fit_exists(th0, o, exp(lo)) { return exp(lo) }
    var k: i32 = 0
    while k < 14 {
        let mid = 0.5 * (lo + hi)
        if tac_fit_exists(th0, o, exp(mid)) {
            hi = mid
        } else {
            lo = mid
        }
        k = k + 1
    }
    return exp(hi)
}

// ps scalar: the root of Y_kernel(s) = ytarget on [s_min, 1] (Y falls with s; Illinois on ln s);
// when Y_kernel(s_min) < ytarget there is no root and the result is s_min, the bound (a failure of the
// structure, reported by the caller); when Y_kernel(1) > ytarget the result is 1.
// Same, with s_min and Y(s_min) already known; Illinois (regula falsi) on ln s to |Y - target| < 1e-9 target, at most 30
// evaluations (about 6 are used; the 18 bisection halvings of round 2 gave a ln s error of 1e-5).
pub fn tac_fit_ps_from(th0: [f64; 18], o: TacObs, ytarget: f64, smin: f64, ymin: f64, sysn: &!Nl28Sys) -> f64 with Mut, Div, Panic {
    if ymin < ytarget { return smin }
    let y1 = tac_y_at(th0, o, 1.0, sysn)
    if y1 > ytarget { return 1.0 }
    var xa = ln(smin)
    var xb = 0.0
    var fa = ymin - ytarget
    var fb = y1 - ytarget
    var side: i32 = 0
    var x = xa
    var k: i32 = 0
    while k < 30 {
        x = (xa * fb - xb * fa) / (fb - fa)
        let fx = tac_y_at(th0, o, exp(x), sysn) - ytarget
        if tac_abs(fx) < 1.0e-9 * ytarget { return exp(x) }
        if fx > 0.0 {
            xa = x
            fa = fx
            if side == 1 { fb = 0.5 * fb }
            side = 1
        } else {
            xb = x
            fb = fx
            if side == 0 - 1 { fa = 0.5 * fa }
            side = 0 - 1
        }
        k = k + 1
    }
    return exp(x)
}

pub fn tac_fit_ps(th0: [f64; 18], o: TacObs, ytarget: f64, sysn: &!Nl28Sys) -> f64 with Mut, Div, Panic {
    let smin = tac_ps_min(th0, o, sysn)
    let ymin = tac_y_at(th0, o, smin, sysn)
    return tac_fit_ps_from(th0, o, ytarget, smin, ymin, sysn)
}

// u(s) = u(Y) / |dY/ds| by a central difference at s (relative step 1e-3).
pub fn tac_u_ps_of(th0: [f64; 18], o: TacObs, s: f64, sysn: &!Nl28Sys) -> f64 with Mut, Div, Panic {
    let h = 1.0e-3 * s
    let yp = tac_y_at(th0, o, s + h, sysn)
    let ym = tac_y_at(th0, o, s - h, sysn)
    var d = (yp - ym) / (2.0 * h)
    if d < 0.0 { d = 0.0 - d }
    if !(d > 0.0) { return 0.0 }
    return tac_u_y() / d
}

// ---- the record -----------------------------------------------------------------
fn tac_abs_m(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

pub fn tac_measured_record(d: &!Circ28Drug) with Mut, Div, Panic, Epistemic {
    circ28_drug_set(d, CD_MW, tac_mw(), 0.0, CD_STATUS_MEASURED, "Emoto2019 Table 1; PubChem CID 445643 (804.02)")
    circ28_drug_set(d, CD_LOGP, tac_logp(), tac_u_logp(), CD_STATUS_MEASURED, "3.3 Emoto2019 = PubChem Sangster; 3.26 VanderVeken2023 (Gertz2010); u = range/sqrt12")
    circ28_drug_set(d, CD_ION, 0.0, 0.0, CD_STATUS_DERIVED, "neutral (VanderVeken2023)")
    circ28_drug_set(d, CD_FU, tac_fu(), tac_u_fu(), CD_STATUS_MEASURED, "Zahir2001 equilibrium dialysis 1.2 %; Emoto2019 0.012; Sikma2020 0.0073; Zahir2004 0.0047; u = range/sqrt12; not the 0.27 of ultracentrifugation")
    circ28_drug_set(d, CD_FA, tac_fa(), tac_u_fa(), CD_STATUS_DERIVED, "Emoto2019 fa 1.0; Itohara2019 fa 0.6; u = range/sqrt12")
    circ28_drug_set(d, CD_PSGUT, tac_psgut(), tac_u_psgut(), CD_STATUS_DERIVED, "Peff 4.77e-4 cm/s (Tamura2002 via VanderVeken2023) x 6600 cm2 x 3.6 = 11.33 L/h; u = factor-2 band (judgment)")
}

// Fits CD_BP (bp at C_ref, derived), CD_KPSC, CD_CLGUT, CD_CLINT to V_ss, CL and F. u of the fitted
// parameters: from the observables' u, by central differences through tac_fit (the measured inputs
// held at their values; the budget below perturbs them too and refits).
pub fn tac_fit_d(th: [f64; 18], o: TacObs, which: i32, comp: i32) -> f64 with Mut, Div, Panic {
    var op = o
    var om = o
    var h = 1.0e-4
    if which == 0 {
        h = 1.0e-4 * o.vss
        op.vss = o.vss + h
        om.vss = o.vss - h
    }
    if which == 1 {
        h = 1.0e-4 * o.cl
        op.cl = o.cl + h
        om.cl = o.cl - h
    }
    if which == 2 {
        h = 1.0e-4 * o.f
        op.f = o.f + h
        om.f = o.f - h
    }
    let tp = tac_fit(th, op)
    let tm = tac_fit(th, om)
    return (tp[comp] - tm[comp]) / (2.0 * h)
}

pub fn tac_fit_record(d: &!Circ28Drug) with Mut, Div, Panic, Epistemic {
    let th0 = circ28_drug_theta(d)
    let o = tac_obs_base()
    let th = tac_fit(th0, o)
    let dk_dv = tac_fit_d(th0, o, 0, CD_KPSC)
    let dg_df = tac_fit_d(th0, o, 2, CD_CLGUT)
    let dc_dcl = tac_fit_d(th0, o, 1, CD_CLINT)
    let dc_df = tac_fit_d(th0, o, 2, CD_CLINT)
    let db_dv = tac_fit_d(th0, o, 0, CD_BP)
    let u_kpsc = tac_abs_m(dk_dv) * tac_u_vss()
    let u_gut = tac_abs_m(dg_df) * tac_u_f()
    let ua = dc_dcl * tac_u_cl()
    let ub = dc_df * tac_u_f()
    let u_int = cd_sqrt(ua * ua + ub * ub)
    let u_bp = tac_abs_m(db_dv) * tac_u_vss()
    circ28_drug_set(d, CD_BP, th[CD_BP], u_bp, CD_STATUS_DERIVED, "bp at C_ref = D_iv/Vss = 13.1 ng/mL from the binding relation (Hct 0.434, Bmax 418, Kd 3.8); the nl stepper replaces it by the local relation")
    circ28_drug_set(d, CD_KPSC, th[CD_KPSC], u_kpsc, CD_STATUS_FITTED, "fitted to Vss 1.91 L/kg x 73 kg whole blood (Prograf label Table 17, n=8); u from u(Vss)")
    circ28_drug_set(d, CD_CLGUT, th[CD_CLGUT], u_gut, CD_STATUS_FITTED, "fitted to oral F 0.14 (Floren1997, n=6, whole blood; fa as given); u from u(F)")
    circ28_drug_set(d, CD_CLINT, th[CD_CLINT], u_int, CD_STATUS_FITTED, "fitted to whole-blood CL 0.040 L/h/kg x 73 kg (Prograf label) given clgut; u from u(CL), u(F)")
}

// Tmax (h) of the 5 mg oral run at absorption rate ka, run to 12 h only.
pub fn tac_oral_tmax(p: Circ28Params, fa: f64, ka: f64, sysn: &!Nl28Sys) -> f64 with Mut, Div, Panic {
    var dc = tac_cfg_oral(5.0)
    dc.ka = ka
    dc.fa = fa
    dc.t_end = 12.0
    let r = tac_run(p, tac_hct(), tac_bmax(), tac_kd(), dc, sysn)
    return r.tmax
}

// ka fitted to Tmax = tobs on (0.05, 10] /h (Tmax falls with ka; Illinois on ln ka). When Tmax(10) is
// above tobs the observable is not reachable and the result is the bound 10 (a failure of the structure).
pub fn tac_ka_solve(p: Circ28Params, fa: f64, tobs: f64, sysn: &!Nl28Sys) -> f64 with Mut, Div, Panic {
    let tb = tac_oral_tmax(p, fa, 10.0, sysn)
    if tb > tobs { return 10.0 }
    // Illinois on ln ka (Tmax is a parabola-refined grid maximum: continuous to about 1e-4 h, with tiny kinks), stop at
    // |Tmax - tobs| < 2e-6 h, at most 16 evaluations or a bracket narrower than 1e-9 (round 2: 16 bisection halvings)
    // bracket [2, 10] when Tmax(2) is above tobs, else [0.05, 2]
    var xa = ln(2.0)
    var xb = ln(10.0)
    var gb = tb - tobs
    var ga = tac_oral_tmax(p, fa, 2.0, sysn) - tobs
    if !(ga > 0.0) {
        xb = xa
        gb = ga
        xa = ln(0.05)
        ga = tac_oral_tmax(p, fa, 0.05, sysn) - tobs
    }
    var side: i32 = 0
    var x = xb
    var k: i32 = 0
    while k < 16 && tac_abs(xb - xa) > 1.0e-9 {
        x = (xa * gb - xb * ga) / (gb - ga)
        let fx = tac_oral_tmax(p, fa, exp(x), sysn) - tobs
        if tac_abs(fx) < 2.0e-6 { return exp(x) }
        if fx > 0.0 {
            xa = x
            ga = fx
            if side == 1 { gb = 0.5 * gb }
            side = 1
        } else {
            xb = x
            gb = fx
            if side == 0 - 1 { ga = 0.5 * ga }
            side = 0 - 1
        }
        k = k + 1
    }
    return exp(x)
}

pub fn tac_ka_record(d: &!Circ28Drug, sysn: &!Nl28Sys) with Mut, Div, Panic, Epistemic {
    let th = circ28_drug_theta(d)
    let p = tac_params_theta(th, tac_psl())
    let ka = tac_ka_solve(p, th[CD_FA], tac_obs_tmax(), sysn)
    circ28_drug_set(d, CD_KA, ka, 3.0, CD_STATUS_FITTED, "fitted to Tmax 1.37 h (Bekersky2001), at its bound ka_max 10 /h when Tmax(10) stays above 1.37 h (tac_ka_solve); u = 3 /h judgment (Jusko1995 SD of ka 3.0, abstract)")
}

pub fn tac_ps_record(d: &!Circ28Drug, sysn: &!Nl28Sys) with Mut, Div, Panic, Epistemic {
    let th0 = circ28_drug_theta(d)
    let o = tac_obs_base()
    let s = tac_fit_ps(th0, o, tac_y_obs(), sysn)
    let u = tac_u_ps_of(th0, o, s, sysn)
    circ28_drug_set(d, CD_PSSC, s, u, CD_STATUS_FITTED, "fitted to the end-of-infusion observable Y = C(4 h) Vss / D = 3.5 from Storset2014 Table 2 (patients, oral data, rate constants; full text opened); u from u(Y) / |dY/ds|; the liver ps stays flow-limited (variant B, tac_psl) ")
}

pub fn tac_drug_into(d: &!Circ28Drug, sysn: &!Nl28Sys) with Mut, Div, Panic, Epistemic {
    tac_measured_record(d)
    tac_ps_record(d, sysn)
    tac_fit_record(d)
    tac_ka_record(d, sysn)
}

// ---- budget with refit ----------------------------------------------------------
// Twelve inputs: 0 logP, 1 fu, 2 Hct, 3 Bmax, 4 Kd, 5 ps_gut, 6 fa (measured / derived), 7 V_ss, 8 CL, 9 F
// (observables), 10 ka, 11 the ps scalar. Each evaluation rebuilds the fit (closed forms) and runs the 5 mg oral dose.
pub struct TacOut {
    pub auc: f64,
    pub cmax: f64,
}

pub fn tac_eval(z: [f64; 12], thb: [f64; 18], dose_mg: f64, dt3: f64, sysn: &!Nl28Sys) -> TacOut with Mut, Div, Panic {
    var t = thb
    t[CD_LOGP] = z[0]
    t[CD_FU] = z[1]
    t[CD_PSGUT] = z[5]
    t[CD_FA] = z[6]
    t[CD_KA] = z[10]
    var o = tac_obs_base()
    o.hct = z[2]
    o.bmax = z[3]
    o.kd = z[4]
    o.vss = z[7]
    o.cl = z[8]
    o.f = z[9]
    o.d_iv = 0.025 * tac_bw()
    t[CD_PSSC] = z[11]
    t = tac_fit(t, o)
    let p = tac_params_theta(t, o.psl)
    var dc = tac_cfg_oral(dose_mg)
    dc.dt3 = dt3
    dc.ka = z[10]
    dc.fa = z[6]
    let r = tac_run(p, z[2], z[3], z[4], dc, sysn)
    var a = r.auc_t
    if r.fit_ok { a = r.auc_inf }
    return TacOut { auc: a, cmax: r.cmax }
}

pub struct TacBudget {
    pub auc: f64,
    pub cmax: f64,
    pub var_auc: f64,
    pub var_cmax: f64,
    pub contrib_auc: [f64; 12],
    pub contrib_cmax: [f64; 12],
    pub sens_auc: [f64; 12],
    pub sens_cmax: [f64; 12],
    pub u: [f64; 12],
    pub runs: i32,
}

pub fn tac_z0(thb: [f64; 18]) -> [f64; 12] {
    var z: [f64; 12] = [0.0; 12]
    z[0] = thb[CD_LOGP]
    z[1] = thb[CD_FU]
    z[2] = tac_hct()
    z[3] = tac_bmax()
    z[4] = tac_kd()
    z[5] = thb[CD_PSGUT]
    z[6] = thb[CD_FA]
    z[7] = tac_obs_vss()
    z[8] = tac_obs_cl()
    z[9] = tac_obs_f()
    z[10] = thb[CD_KA]
    z[11] = thb[CD_PSSC]
    return z
}

pub fn tac_u_all(u_ps: f64) -> [f64; 12] {
    var u: [f64; 12] = [0.0; 12]
    u[0] = tac_u_logp()
    u[1] = tac_u_fu()
    u[2] = tac_u_hct()
    u[3] = tac_u_bmax()
    u[4] = tac_u_kd()
    u[5] = tac_u_psgut()
    u[6] = tac_u_fa()
    u[7] = tac_u_vss()
    u[8] = tac_u_cl()
    u[9] = tac_u_f()
    u[10] = 3.0
    u[11] = u_ps
    return u
}

// dt3: the step of the third phase (h) of every run of the budget (the default of tac_cfg_oral is 2)
pub fn tac_budget(d: &Circ28Drug, dose_mg: f64, dt3: f64, sysn: &!Nl28Sys) -> TacBudget with Mut, Div, Panic, Epistemic {
    let thb = circ28_drug_theta(d)
    let z0 = tac_z0(thb)
    let u = tac_u_all(cd_sqrt(circ28_drug_variance(d, CD_PSSC)))
    let o0 = tac_eval(z0, thb, dose_mg, dt3, sysn)
    var sa: [f64; 12] = [0.0; 12]
    var sc: [f64; 12] = [0.0; 12]
    var ca: [f64; 12] = [0.0; 12]
    var cc: [f64; 12] = [0.0; 12]
    var va = 0.0
    var vc = 0.0
    var nrun: i32 = 1
    var i: i32 = 0
    while i < 12 {
        var hs = 1.0e-4 * tac_abs_m(z0[i])
        if hs > 0.1 * u[i] { hs = 0.1 * u[i] }
        var zp = z0
        zp[i] = z0[i] + hs
        let op = tac_eval(zp, thb, dose_mg, dt3, sysn)
        nrun = nrun + 1
        let da = (op.auc - o0.auc) / hs
        let dcm = (op.cmax - o0.cmax) / hs
        sa[i] = da
        sc[i] = dcm
        ca[i] = da * da * u[i] * u[i]
        cc[i] = dcm * dcm * u[i] * u[i]
        va = va + ca[i]
        vc = vc + cc[i]
        i = i + 1
    }
    return TacBudget { auc: o0.auc, cmax: o0.cmax, var_auc: va, var_cmax: vc, contrib_auc: ca, contrib_cmax: cc, sens_auc: sa, sens_cmax: sc, u: u, runs: nrun }
}
