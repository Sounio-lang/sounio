// stdlib/darwin_pbpk/circ28_drug_risperidone.sio — risperidone and 9-hydroxyrisperidone
// (paliperidone) on the circ28 drug record, coupled by circ28_metab.sio
//
// Healthy adult (ICRP 89 reference male, 73 kg), CYP2D6 extensive metaboliser (EM) by
// default; the poor metaboliser (PM) is obtained by scaling the CYP2D6 pathway only.
// Two records (risperidone R, 9-OH M), one fitted record each; the metabolite is formed from the
// parent's hepatic clform in liver tissue (sequential first pass, circ28_metab.sio).
//
// The problem this module answers (notes_15_farmacos, risperidone): the previous model destroyed
// the first-pass loss of the parent instead of forming 9-OH with it, and took the metabolite
// clearance from an APPARENT volume (V/F 487 L of the Invega label treated as absolute). Here the
// paliperidone clearance and volume are made ABSOLUTE with the absolute oral bioavailability of
// the ER tablet (F = 0.28, Invega label) before they are used, and the formation is booked from
// the parent's tally.
//
// STATUS: 1 measured, 2 derived by a stated formula from cited measurements, 3 fitted to ONE named
// observable (which is then NOT a validation). u is the STANDARD UNCERTAINTY OF THE VALUE, never an
// inter-individual SD; "range/sqrt12" is used where only a range or several values exist and
// "assumed" marks a number with no source. Access: A abstract (PubMed), F full text read in this
// session, L label text read, S secondary (value quoted by a paper that I read; primary not
// opened), P poster/review document read. Nothing is from memory.
//
// ---- RISPERIDONE (R) record ---------------------------------------------------------------
//  param   value   u        status  basis of u / source / access
//  MW      410.5   0        1       PubChem CID 5073 (physchem_dossier s.12) [secondary database]
//  logP    2.86    0.173    1       2.86 Sangster via PubChem CID 5073; 2.5 (Badhan 2014 via Wong 2019,
//                                   PMC6590357 Table 1, F); 3.1 MoKa predicted (gaps_D1); u = range/sqrt12
//  pKa1    8.27    0.0173   2       mean of 8.3 (ChEMBL via PubChem) and 8.24 (Saibi 2012 via Wong 2019,
//                                   F); u = range/sqrt12; the second pKa 3.11 is irrelevant at pH 7.4;
//                                   ionisation class 2 (monoprotic base)
//  fu      0.10    0.01     1       Mannens 1994 Psychopharmacology 114:566 PMID 7531854: 90.0 % bound in
//                                   human plasma, equilibrium dialysis (A). u = 0.01 ASSUMED (the abstract
//                                   gives no SD; the Mahdy 2023 model input 0.16 is a model value, not used)
//  B:P     0.67    0.058    1       Mannens 1994 (A): 0.67 in man (in vitro). u = (0.79 - 0.59)/sqrt12 from the
//                                   range of the mean venous whole-blood/plasma ratio of the risperidone ACTIVE
//                                   MOIETY in vivo, Remmerie 2016 Clin Pharmacol Drug Dev 5:528 (PMC5132056, F)
//  clint, clform  fitted            3 see the closed forms below
//  clgut   0       -        0       ASSUMPTION: no gut-wall metabolism. Intestinal CYP2D6 is 0.5 pmol/mg of
//                                   mucosal microsomes against 50 pmol/mg CYP3A (Paine 2006 Drug Metab Dispos
//                                   34:880, PMID 16467132, A); the 9-hydroxylation is CYP2D6-dominated. The
//                                   CYP3A share of risperidone clearance is real (ketoconazole raised AUC by
//                                   66.5 %, Mahatthanatrakul 2012, A) but no number for its gut-wall part was
//                                   read, so it is not invented. The consequence is tested (V1, S3 of the test).
//  clren   fitted  3                fe_R x CL (fe_R below)
//  kpsc    fitted  3                to V_ss
//  ka      fitted  3                k per stage of the oral chain (CD_KA), to the oral Tmax 1.0 h (see ROUND TRANSIT below)
//  fa      1.0     0        1       "rapidly and completely absorbed; < 1 % unchanged in the faeces",
//                                   Heykants 1994 J Clin Psychiatry 55 Suppl:13, PMID 7520903 (A)
//  pssc    1       0        0       placeholder with no source (flow-limited default, circ28_drug.sio)
//
// ---- 9-HYDROXYRISPERIDONE = PALIPERIDONE (M) record -----------------------------------------
//  MW      426.5   0        1       PubChem CID 115237 (dossier s.12)
//  logP    1.9     0.26     1       mean of 2.4 (Loryan 2014 via Wong 2019, F), 1.8 (HMDB via PubChem CID
//                                   115237) and 1.5 (MoKa predicted); u = range/sqrt12
//  pKa1    8.2     0.1      1       8.2 (Loryan 2014 via Wong 2019, F). u = 0.1 ASSUMED (single secondary value)
//  fu      0.243   0.0100   1       mean of 0.226 (77.4 % bound, Mannens 1994, A) and 0.261 (26.1 % free, FDA
//                                   clinical pharmacology review NDA 21-999, P); u = range/sqrt12
//  B:P     0.73    0.0635   1       Remmerie 2016 (F): mean venous whole-blood/plasma ratio of paliperidone
//                                   0.62-0.84 over time (healthy, 3 mg ER tablet); value = mid-range, u = range/sqrt12
//  clint   fitted  3                hepatic part of the paliperidone clearance
//  clform, clgut 0  -       0       no metabolite is tracked from M
//  clren   fitted  3                fe_M x CL_M
//  kpsc    fitted  3                to V_ss,M
//
// ---- OBSERVABLES USED TO FIT (one per fitted parameter; these are NOT validations) ----------
//  R  V_ss     109.5 L, u 21.1 L.  Risperdal label (FDA 2005 label, L): "The volume of distribution is
//              1-2 L/kg" (the label does not say whether this is V_ss or V_z); 1.5 L/kg x 73 kg; u =
//              (2 - 1) x 73 / sqrt12. The 73 kg is the ICRP reference mass of the kernel.
//  R  CL_iv    23.6 L/h, u 7.5 L/h. Value: "mean reported values (23.6 L/h) in healthy volunteers",
//              Mahdy 2023 Clin Transl Sci 16:618 (PMC10087078, F), citing Huang 1993 Clin Pharmacol Ther
//              54:257 PMID 7690693 and Vermeulen 2007 (S: the full text of Huang 1993 is not open; the
//              abstract has no CL). u = range/sqrt12 of three routes to the same quantity: 23.6 (above), 16.8
//              (CL/F 25.4 L/h from the 4 mg AUC0-48 157.49 ng h/mL of Mahatthanatrakul 2007, PMID 17381666, A,
//              times Huang's F 0.66), 43.2 (Feng 2008 CL/F 65.4 L/h in patients, as quoted on the
//              J&J Medical Connect page, S, times 0.66); range 16.8-43.2.
//  R  fe_R     0.02, u 0.0115.     Wong 2019 J Clin Pharmacol 59:731 (PMC6590357, F): renal elimination of
//              risperidone "accounts for only < 4 % of the total clearance" (their refs 39-41);
//              value = 2 %, u = range [0, 4 %]/sqrt12. Secondary.
//  R/M IV ratio 3.0, u 0.29.  Huang 1993 (A): plasma AUC(0-inf) ratio 9-OH/risperidone "averaged 3
//              (intravenous and intramuscular)" in EM. u = range [2.5, 3.5]/sqrt12 (the value is quoted
//              to one digit; no SD in the abstract) = ASSUMED rounding.
//  R  Tmax     1.0 h, u 0.29 h.    Risperdal label (L): mean peak of risperidone "at about 1 hour"; u = range
//              [0.5, 1.5] h/sqrt12 ASSUMED. (Narayanan 2026, healthy EM, 0.79 +/- 0.26 h is kept as a check.)
//  M  CL_iv    3.81 L/h, u 0.42 L/h. CL/F x F with F = 0.28 (Invega label, L, absolute oral bioavailability of the
//              ER tablet, no spread given): 13.8 L/h (Simulations Plus ASCPT 2007 poster, population PK of the
//              ER tablet in healthy subjects and patients, P: renal 5.8 + non-renal 8.0 L/h) x 0.28 = 3.86;
//              10.9 L/h (FDA clinical pharmacology review NDA 21-999, Table 3, P) x 0.28 = 3.05; 268 mL/min =
//              16.08 L/h (same review, Table 1, adults) x 0.28 = 4.50; 3.84 L/h (Magnusson 2017 Clin
//              Pharmacokinet 56:421, PMID 27743205, A, apparent CL of the 3-month palmitate, F est. 20.9 %).
//              Value = mean of the four (3.81), u = range [3.05, 4.50]/sqrt12. The uncertainty of F itself (not
//              reported) is NOT in this u.
//  M  V_ss     136.4 L, u 14.1 L.  487 L (Invega label, L; the poster P gives the same V/F, 260 + 227 L) x 0.28 =
//              136.4. The FDA review V2 + V3 = 442 L x 0.28 = 123.8 L. u = sqrt(u_range^2 + u_F^2), u_range =
//              (136.4 - 123.8)/sqrt12 = 3.6 L, u_F = 10 % of 136.4 ASSUMED (F has no reported spread).
//  M  fe_M     0.59, u 0.031.      59 % (range 51-67 %, n = 5) of an oral 1 mg 14C solution excreted unchanged in
//              urine, Vermeir 2008 Drug Metab Dispos 36:769 (PMID 18227146, A) and the Invega label (L).
//              Used as the fraction of the clearance that is renal; the IR solution is ~ completely
//              absorbed (F ~ 106 % in Spina 2011 J Cent Nerv Syst Dis 3:27, PMC3663611, F). u = (67 -
//              51)/2.326/sqrt5 (SD from the range of 5, then the SEM).
//
// CLOSED FORMS USED BY THE FITS (kernel equations, circ28_kernel_identities.sio T3/T9):
//   kpsc = (V_ss - bp V_blood)/sum_i V_i (1 - vf_i) Kp_RR,i
//   cl_renal = fe CL;  CL_hep(plasma) = CL - cl_renal;  Eh = CL_hep/(bp Qh);  y = CL_hep/(1 - Eh);
//   (clint + clform) fu = y ps_liver/(ps_liver - y)
//   F_src,M = 1/(1 + c_M/(Qh bp_M) + c_M/ps_liver,M),  c_M = clint_M fu_M
//   IV plasma AUC ratio  AUC_M/AUC_R = MWr phi (1 - fe_R) F_src,M CL_R / CL_M,  phi = clform/(clint + clform)
//   so phi = ratio CL_M / (MWr (1 - fe_R) F_src,M CL_R)    (the split of the hepatic clearance; this is
//   the ONE observable that fixes it: the IV 9-OH/risperidone AUC ratio of Huang 1993)
//   ka = root of Tmax(ka) = Tmax_obs by bisection on the kernel run (offline; stored in rsp_ka_fit and
//   re-checked by the test).
//
// WHAT IS VALIDATION: the oral 9-OH/risperidone AUC ratio, absolute F of risperidone, active-moiety
// bioavailability, half-lives of both, Cmax and Tmax of both after a single oral dose in healthy EM,
// the renal clearance of paliperidone, and the PM case. The criteria and expectations are written in
// tests/run-pass/circ28_drug_risperidone.sio BEFORE the runs.
//
// ROUND 2: the split clform/clint is no longer fitted to the IV AUC ratio. f2D6 (share of the hepatic clearance carried by CYP2D6,
// which forms 9-OH entirely) is fitted to the PM/NM oral clearance ratio 6.20 (u 0.65), Zhang 2020 Pharmacotherapy 40:632, PMID
// 32519344 (abstract, A); q = share of the non-2D6 clearance that forms 9-OH is 0 (no source). The IV ratio 3 is then a validation row.
//
// ROUND TRANSIT (2026-11-15). The oral input is an Erlang chain of rsp_ntr() = 4 stages (n = 3 transit compartments, a DECLARED
// ASSUMPTION: no risperidone-specific number was read, plus 1 by the n+1 rule); CD_KA is k per stage, MTT = ntr/k, mode (ntr-1)/k;
// tlag 0 (none sourced). k is refitted to the SAME observable as before (oral Tmax 1.0 h): rsp_ka_fit 5.133473 /h (round 2 first-order ka
// 0.8120). The coupled run uses circ28_oral_mass_n; the R-only Tmax run uses circ28_dose_oral_transit. The _g variants (rsp_params,
// rsp_fit_m_g, rsp_fit_r_g, rsp_run_th_g, rsp_ka_fit_g) carry a gut-wall variant gv (0: V_ss scalar on every organ; 1: gut wall at its
// Rodgers-Rowland Kp, circ28_kp_scale_for_vss_gutrr); gv 0 is the module's variant (test S6: gv 1 does not improve the failing peak row).
// The budget now also carries the R Cmax and the 9-OH Tmax (rsp_eval out[4], out[5]).
//
// POOR METABOLISER. The CYP2D6 pathway only is scaled: clform x PM_SCALE with PM_SCALE = 0 (a PM has no
// functional CYP2D6, which defines the phenotype in Huang 1993, "dextromethorphan-phenotyped"). The
// residual formation of 9-OH in PMs (CYP3A4, Mahatthanatrakul 2011, A, and Kneller 2020, PMID 31359271, A)
// is not in the record (one clform slot), which is a stated limit. The other pathways, renal clearance
// and everything of M are unchanged.

use darwin_pbpk::circ28::*
use darwin_pbpk::circ28_kp::*
use darwin_pbpk::circ28_drug::*
use darwin_pbpk::circ28_metab::*
use math::pure::{exp, ln}

// ---- measured inputs -------------------------------------------------------------------------
pub fn rsp_r_mw() -> f64 { return 410.5 }
pub fn rsp_r_logp() -> f64 { return 2.86 }
pub fn rsp_r_u_logp() -> f64 { return 0.173 }
pub fn rsp_r_pka1() -> f64 { return 8.27 }
pub fn rsp_r_u_pka1() -> f64 { return 0.0173 }
pub fn rsp_r_fu() -> f64 { return 0.10 }
pub fn rsp_r_u_fu() -> f64 { return 0.01 }
pub fn rsp_r_bp() -> f64 { return 0.67 }
pub fn rsp_r_u_bp() -> f64 { return 0.058 }
pub fn rsp_m_mw() -> f64 { return 426.5 }
pub fn rsp_m_logp() -> f64 { return 1.9 }
pub fn rsp_m_u_logp() -> f64 { return 0.26 }
pub fn rsp_m_pka1() -> f64 { return 8.2 }
pub fn rsp_m_u_pka1() -> f64 { return 0.1 }
pub fn rsp_m_fu() -> f64 { return 0.243 }
pub fn rsp_m_u_fu() -> f64 { return 0.0100 }
pub fn rsp_m_bp() -> f64 { return 0.73 }
pub fn rsp_m_u_bp() -> f64 { return 0.0635 }

// ---- observables the fits are tied to (value, standard uncertainty) --------------------------
pub fn rsp_obs_r_vss() -> f64 { return 109.5 }
pub fn rsp_u_r_vss() -> f64 { return 21.07 }
pub fn rsp_obs_r_cl() -> f64 { return 23.6 }
pub fn rsp_u_r_cl() -> f64 { return 7.62 }
pub fn rsp_obs_r_fe() -> f64 { return 0.02 }
pub fn rsp_u_r_fe() -> f64 { return 0.0115 }
pub fn rsp_obs_ratio() -> f64 { return 3.0 }
pub fn rsp_u_ratio() -> f64 { return 0.2887 }
pub fn rsp_obs_r_tmax() -> f64 { return 1.0 }
pub fn rsp_u_r_tmax() -> f64 { return 0.2887 }
pub fn rsp_obs_m_vss() -> f64 { return 136.4 }
pub fn rsp_u_m_vss() -> f64 { return 14.1 }
pub fn rsp_obs_m_cl() -> f64 { return 3.81 }
pub fn rsp_u_m_cl() -> f64 { return 0.42 }
pub fn rsp_obs_m_fe() -> f64 { return 0.59 }
pub fn rsp_u_m_fe() -> f64 { return 0.031 }

// Number of stages of the oral Erlang chain: n = 3 transit compartments (a DECLARED ASSUMPTION, no risperidone value read) + 1.
pub fn rsp_ntr() -> i32 { return 4 }

// k (1/h per stage of the ntr = 4 chain; CD_KA) with Tmax(k) = rsp_obs_r_tmax() on the grid of rsp_cfg_r_oral (offline bisection, 30
// halvings of [0.5, 30], rsp_fit_ka; the test re-checks the Tmax it gives). Round 2 (first-order input) was ka 0.8120 /h.
pub fn rsp_ka_fit() -> f64 { return 5.133473 }

// k per stage of the variant gv (offline fit, see rsp_ka_fit).
pub fn rsp_ka_fit_g(gv: i32) -> f64 {
    if gv == 1 { return 4.893535 }
    return 5.133473
}

// R-only oral run configuration (for the ka fit): 0.05 h to 3 h, 0.5 h to 24 h, terminal fit 8-24 h.
pub fn rsp_cfg_r_oral(dose_mg: f64) -> Circ28Dose {
    return circ28_dose_oral_transit(dose_mg, rsp_ntr(), 0.05, 3.0, 0.5, 24.0, 8.0, 24.0)
}

fn rsp_abs(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

// Parameters of the variant gv: 0 = V_ss scalar on every organ, gut wall included; 1 = gut wall at its Rodgers-Rowland Kp.
pub fn rsp_params(th: [f64; 18], gv: i32) -> Circ28Params with Mut, Div, Panic {
    var t = th
    if gv == 1 { return circ28_drug_params_theta_gutrr(t) }
    return circ28_drug_params_theta(t)
}

// V_ss scalar of the variant gv from the parameters p0 built with CD_KPSC = 1.
pub fn rsp_kp_scale(p0: Circ28Params, vss: f64, gv: i32) -> f64 with Mut, Div {
    if gv == 1 { return circ28_kp_scale_for_vss_gutrr(p0, p0.kp, vss) }
    return circ28_kp_scale_for_vss(p0, p0.kp, vss)
}

// ---- the fits ----------------------------------------------------------------------------------
// 9-OH: Kp scalar to V_ss, renal part fe x CL, hepatic intrinsic clearance to the rest. Returns the
// array with CD_KPSC, CD_CLREN and CD_CLINT set; CD_CLINT = -1 if a fit is impossible.
pub fn rsp_fit_m(th: [f64; 18], vss: f64, cl: f64, fe: f64) -> [f64; 18] with Mut, Div, Panic {
    return rsp_fit_m_g(th, vss, cl, fe, 0)
}

pub fn rsp_fit_m_g(th: [f64; 18], vss: f64, cl: f64, fe: f64, gv: i32) -> [f64; 18] with Mut, Div, Panic {
    var t = th
    t[CD_KPSC] = 1.0
    t[CD_CLINT] = 0.0
    t[CD_CLFORM] = 0.0
    t[CD_CLREN] = 0.0
    let p0 = rsp_params(t, gv)
    let sc = rsp_kp_scale(p0, vss, gv)
    if !(sc > 0.0) {
        t[CD_CLINT] = 0.0 - 1.0
        return t
    }
    t[CD_KPSC] = sc
    let p = rsp_params(t, gv)
    let qh = circ28_q_hepatic(p)
    let clren = fe * cl
    let clh = cl - clren
    let eh = clh / (p.bp * qh)
    if !(eh > 0.0) || !(eh < 1.0) {
        t[CD_CLINT] = 0.0 - 1.0
        return t
    }
    let y = clh / (1.0 - eh)
    if !(p.ps[1] > y) {
        t[CD_CLINT] = 0.0 - 1.0
        return t
    }
    t[CD_CLREN] = clren
    t[CD_CLINT] = (y * p.ps[1] / (p.ps[1] - y)) / p.fu
    return t
}

// F_src of the metabolite: fraction of the mass formed in liver tissue that leaves the liver.
pub fn rsp_fsrc(thm: [f64; 18]) -> f64 with Mut, Div, Panic {
    var tl = thm
    let p = circ28_drug_params_theta(tl)
    let c = p.clint * p.fu
    return 1.0 / (1.0 + c / (circ28_q_hepatic(p) * p.bp) + c / p.ps[1])
}

// Hepatic plasma clearance of a record array (Qh bp Eh from the kernel closed form).
pub fn rsp_hep_cl(th: [f64; 18]) -> f64 with Mut, Div, Panic {
    var tl = th
    let p = circ28_drug_params_theta(tl)
    return circ28_hepatic_extraction(p) * circ28_q_hepatic(p) * p.bp
}

// ROUND 2 split. CYP2D6 share f2D6 of the parent hepatic clearance is fitted to the EM/PM ratio of oral
// clearance (CL/F)_EM/(CL/F)_PM = 6.20 (Zhang 2020 meta-analysis, PMID 32519344, abstract); the CYP2D6 pathway
// forms 9-OH entirely. q = fraction of the NON-2D6 hepatic clearance that forms 9-OH (no independent observable
// read; base case q = 0, derived-with-no-source, i.e. an assumption kept visible and scanned in the test).
pub fn rsp_q_other() -> f64 { return 0.0 }
pub fn rsp_obs_pmratio() -> f64 { return 6.20 }
pub fn rsp_u_pmratio() -> f64 { return 0.65 }

// CL/F of risperidone for a given hepatic CL/F (y), B = bp Qh and renal clearance: well-stirred closed form.
pub fn rsp_cl_over_f(y: f64, bb: f64, clren: f64) -> f64 with Div {
    let clh = y / (1.0 + y / bb)
    let f = 1.0 - clh / bb
    return (clh + clren) / f
}

// y_PM such that (CL/F)(y_PM) = target; monotone increasing, bisection (closed-form model, no kernel run).
pub fn rsp_solve_ypm(target: f64, bb: f64, clren: f64) -> f64 with Mut, Div {
    var lo = 0.0
    var hi = 1000.0 * bb
    var k: i32 = 0
    while k < 200 {
        let mid = 0.5 * (lo + hi)
        if rsp_cl_over_f(mid, bb, clren) > target {
            hi = mid
        } else {
            lo = mid
        }
        k = k + 1
    }
    return 0.5 * (lo + hi)
}

// Risperidone: Kp scalar to V_ss, cl_renal = fe CL, total hepatic intrinsic clearance to CL, f2D6 to the EM/PM
// oral clearance ratio. clform = f2D6 tot + q (1 - f2D6) tot ; clint = (1 - q)(1 - f2D6) tot.
pub fn rsp_fit_r(th: [f64; 18], vss: f64, cl: f64, fe: f64, pmratio: f64, q: f64) -> [f64; 18] with Mut, Div, Panic {
    return rsp_fit_r_g(th, vss, cl, fe, pmratio, q, 0)
}

pub fn rsp_fit_r_g(th: [f64; 18], vss: f64, cl: f64, fe: f64, pmratio: f64, q: f64, gv: i32) -> [f64; 18] with Mut, Div, Panic {
    var t = th
    t[CD_KPSC] = 1.0
    t[CD_CLINT] = 0.0
    t[CD_CLFORM] = 0.0
    t[CD_CLREN] = 0.0
    let p0 = rsp_params(t, gv)
    let sc = rsp_kp_scale(p0, vss, gv)
    if !(sc > 0.0) {
        t[CD_CLINT] = 0.0 - 1.0
        return t
    }
    t[CD_KPSC] = sc
    let p = rsp_params(t, gv)
    let qh = circ28_q_hepatic(p)
    let bb = p.bp * qh
    let clren = fe * cl
    let clh = cl - clren
    let eh = clh / bb
    if !(eh > 0.0) || !(eh < 1.0) {
        t[CD_CLINT] = 0.0 - 1.0
        return t
    }
    let y = clh / (1.0 - eh)
    if !(p.ps[1] > y) {
        t[CD_CLINT] = 0.0 - 1.0
        return t
    }
    let tot = (y * p.ps[1] / (p.ps[1] - y)) / p.fu
    let clf_em = cl / (1.0 - eh)
    let ypm = rsp_solve_ypm(clf_em / pmratio, bb, clren)
    if !(p.ps[1] > ypm) {
        t[CD_CLINT] = 0.0 - 1.0
        return t
    }
    let totpm = (ypm * p.ps[1] / (p.ps[1] - ypm)) / p.fu
    let f2d6 = 1.0 - totpm / tot
    if !(f2d6 > 0.0) || !(f2d6 < 1.0) {
        t[CD_CLINT] = 0.0 - 1.0
        return t
    }
    t[CD_CLREN] = clren
    t[CD_CLFORM] = f2d6 * tot + q * (1.0 - f2d6) * tot
    t[CD_CLINT] = (1.0 - q) * (1.0 - f2d6) * tot
    return t
}

// PM: CYP2D6 formation removed, the non-2D6 formation q (1 - f) tot kept. With clint = (1 - q)(1 - f) tot
// that is clform_PM = clint q/(1 - q).
pub fn rsp_pm_clform(th: [f64; 18], q: f64) -> f64 {
    return th[CD_CLINT] * q / (1.0 - q)
}

// Tmax (h) of a 1 mg oral run of risperidone ALONE at the given ka (record array in the caller).
pub fn rsp_tmax_th(th: [f64; 18], ka: f64) -> f64 with Mut, Div, Panic {
    var t = th
    t[CD_KA] = ka
    let r = circ28_run_theta(t, rsp_cfg_r_oral(1.0))
    return r.tmax
}

pub fn rsp_tmax_slope(th: [f64; 18]) -> f64 with Mut, Div, Panic {
    let h = 1.0e-3 * th[CD_KA]
    let tp = rsp_tmax_th(th, th[CD_KA] + h)
    let tm = rsp_tmax_th(th, th[CD_KA] - h)
    return (tp - tm) / (2.0 * h)
}

pub fn rsp_fit_ka(th: [f64; 18], tobs: f64, lo0: f64, hi0: f64) -> f64 with Mut, Div, Panic {
    var lo = lo0
    var hi = hi0
    var k: i32 = 0
    while k < 30 {
        let mid = 0.5 * (lo + hi)
        if rsp_tmax_th(th, mid) > tobs {
            lo = mid
        } else {
            hi = mid
        }
        k = k + 1
    }
    return 0.5 * (lo + hi)
}

// ---- records -----------------------------------------------------------------------------------
pub fn rsp_measured_r(d: &!Circ28Drug) with Mut, Div, Panic, Epistemic {
    circ28_drug_set(d, CD_MW, rsp_r_mw(), 0.0, CD_STATUS_MEASURED, "PubChem CID 5073 (formula weight)")
    circ28_drug_set(d, CD_LOGP, rsp_r_logp(), rsp_r_u_logp(), CD_STATUS_MEASURED, "Sangster via PubChem CID 5073 2.86; 2.5 Badhan2014 (Wong2019); 3.1 MoKa; u = range/sqrt12")
    circ28_drug_set(d, CD_PKA1, rsp_r_pka1(), rsp_r_u_pka1(), CD_STATUS_DERIVED, "mean of 8.3 ChEMBL and 8.24 Saibi2012 (Wong2019); u = range/sqrt12")
    circ28_drug_set(d, CD_ION, 2.0, 0.0, CD_STATUS_DERIVED, "monoprotic base from pKa1 (pKa 3.11 irrelevant at 7.4)")
    circ28_drug_set(d, CD_FU, rsp_r_fu(), rsp_r_u_fu(), CD_STATUS_MEASURED, "Mannens1994 PMID 7531854 90.0 % bound; u 0.01 assumed")
    circ28_drug_set(d, CD_BP, rsp_r_bp(), rsp_r_u_bp(), CD_STATUS_MEASURED, "Mannens1994 0.67; u from Remmerie2016 active-moiety range 0.59-0.79 / sqrt12")
    circ28_drug_set(d, CD_FA, 1.0, 0.0, CD_STATUS_MEASURED, "Heykants1994 PMID 7520903 completely absorbed, <1 % faeces")
}

pub fn rsp_measured_m(d: &!Circ28Drug) with Mut, Div, Panic, Epistemic {
    circ28_drug_set(d, CD_MW, rsp_m_mw(), 0.0, CD_STATUS_MEASURED, "PubChem CID 115237 (formula weight)")
    circ28_drug_set(d, CD_LOGP, rsp_m_logp(), rsp_m_u_logp(), CD_STATUS_MEASURED, "mean of 2.4 Loryan2014 (Wong2019), 1.8 HMDB, 1.5 MoKa; u = range/sqrt12")
    circ28_drug_set(d, CD_PKA1, rsp_m_pka1(), rsp_m_u_pka1(), CD_STATUS_MEASURED, "8.2 Loryan2014 via Wong2019; u 0.1 assumed")
    circ28_drug_set(d, CD_ION, 2.0, 0.0, CD_STATUS_DERIVED, "monoprotic base from pKa1")
    circ28_drug_set(d, CD_FU, rsp_m_fu(), rsp_m_u_fu(), CD_STATUS_MEASURED, "mean of 0.226 Mannens1994 and 0.261 FDA review NDA 21-999; u = range/sqrt12")
    circ28_drug_set(d, CD_BP, rsp_m_bp(), rsp_m_u_bp(), CD_STATUS_MEASURED, "Remmerie2016 venous whole-blood/plasma 0.62-0.84; mid-range; u = range/sqrt12")
}

// The fitting steps are separate functions (Madaros segfaults on one frame holding records plus
// several [f64; 18] arrays, measured in the midazolam module).
pub fn rsp_fit_record_m(d: &!Circ28Drug) with Mut, Div, Panic, Epistemic {
    rsp_fit_record_m_g(d, 0)
}

pub fn rsp_fit_record_m_g(d: &!Circ28Drug, gv: i32) with Mut, Div, Panic, Epistemic {
    let th0 = circ28_drug_theta(d)
    let th = rsp_fit_m_g(th0, rsp_obs_m_vss(), rsp_obs_m_cl(), rsp_obs_m_fe(), gv)
    circ28_drug_set(d, CD_KPSC, th[CD_KPSC], 0.0, CD_STATUS_FITTED, "fitted to Vss 136.4 L = 487 L x 0.28 (Invega label)")
    circ28_drug_set(d, CD_CLREN, th[CD_CLREN], 0.0, CD_STATUS_FITTED, "fe 0.59 x CL 3.81 L/h (Vermeir2008; Invega F 0.28 x CL/F)")
    circ28_drug_set(d, CD_CLINT, th[CD_CLINT], 0.0, CD_STATUS_FITTED, "fitted to the non-renal part of CL 3.81 L/h")
}

pub fn rsp_fit_record_r(d: &!Circ28Drug) with Mut, Div, Panic, Epistemic {
    rsp_fit_record_r_g(d, 0)
}

pub fn rsp_fit_record_r_g(d: &!Circ28Drug, gv: i32) with Mut, Div, Panic, Epistemic {
    let th0 = circ28_drug_theta(d)
    let th = rsp_fit_r_g(th0, rsp_obs_r_vss(), rsp_obs_r_cl(), rsp_obs_r_fe(), rsp_obs_pmratio(), rsp_q_other(), gv)
    circ28_drug_set(d, CD_KPSC, th[CD_KPSC], 0.0, CD_STATUS_FITTED, "fitted to Vss 109.5 L = 1.5 L/kg x 73 kg (Risperdal label)")
    circ28_drug_set(d, CD_CLREN, th[CD_CLREN], 0.0, CD_STATUS_FITTED, "fe 0.02 x CL 23.6 L/h (Wong2019 <4 %; Mahdy2023 citing Huang1993)")
    circ28_drug_set(d, CD_CLINT, th[CD_CLINT], 0.0, CD_STATUS_FITTED, "non-2D6 pathways (1 - f2D6) x total hepatic, total to CL 23.6 L/h; f2D6 to EM/PM CL/F 6.2 (Zhang2020)")
    circ28_drug_set(d, CD_CLFORM, th[CD_CLFORM], 0.0, CD_STATUS_FITTED, "9-hydroxylation: f2D6 x total hepatic + q(1-f2D6) (q = 0); f2D6 to EM/PM CL/F 6.2 (Zhang2020 PMID 32519344)")
}

pub fn rsp_ka_record(d: &!Circ28Drug) with Mut, Div, Panic, Epistemic {
    circ28_drug_set(d, CD_KA, rsp_ka_fit(), 0.0, CD_STATUS_FITTED, "k per stage of the 4-stage chain (3 transit compartments, assumed), fitted to oral Tmax 1.0 h (Risperdal label)")
}

pub fn rsp_ka_record_g(d: &!Circ28Drug, gv: i32) with Mut, Div, Panic, Epistemic {
    circ28_drug_set(d, CD_KA, rsp_ka_fit_g(gv), 0.0, CD_STATUS_FITTED, "k per stage of the 4-stage chain (3 transit compartments, assumed), fitted to oral Tmax 1.0 h (Risperdal label); gv 1: gut wall at Rodgers-Rowland Kp")
}

pub fn rsp_drug_into(dr: &!Circ28Drug, dm: &!Circ28Drug) with Mut, Div, Panic, Epistemic {
    rsp_measured_m(dm)
    rsp_fit_record_m(dm)
    rsp_measured_r(dr)
    rsp_fit_record_r(dr)
    rsp_ka_record(dr)
}

// ---- coupled run -----------------------------------------------------------------------------
// Result layout (res):
//   0 R Cmax  1 R Tmax  2 R AUC_inf  3 R t1/2  4 R AUC_0-T  5 M Cmax  6 M Tmax  7 M AUC_inf  8 M t1/2
//   9 input (mg R)  10 R mass balance error  11 M mass balance error  12 grid ok  13 R terminal fit ok
//   14 M terminal fit ok  15 mass given to M (mg)  16 M AUC_0-T  17 R c_end  18 M c_end
// route 0 intravenous infusion over t_inf; route 1 oral (ka, fa, tlag from the R array). Plasma
// concentrations: venous blood / bp. Grid: 0.05 h to 6 h, 0.5 h to 240 h; the terminal fits of R and M
// use the windows wr_lo..wr_hi and wm_lo..wm_hi (h).
pub fn rsp_lz(ts: &[f64; 800], cs: &[f64; 800], n: i32, lo: f64, hi: f64) -> f64 with Mut, Div, Panic {
    var sw = 0.0
    var st = 0.0
    var sy = 0.0
    var stt = 0.0
    var sty = 0.0
    var nf: i32 = 0
    var i: i32 = 1
    while i <= n {
        if (*ts)[i] >= lo && (*ts)[i] <= hi {
            if (*cs)[i] > 0.0 {
                let y = ln((*cs)[i])
                sw = sw + 1.0
                st = st + (*ts)[i]
                sy = sy + y
                stt = stt + (*ts)[i] * (*ts)[i]
                sty = sty + (*ts)[i] * y
                nf = nf + 1
            }
        }
        i = i + 1
    }
    if nf < 3 { return 0.0 }
    let den = sw * stt - st * st
    let lz = 0.0 - (sw * sty - st * sy) / den
    if !(lz > 0.0) { return 0.0 }
    return lz
}

// Peak of a curve on the grid with the vertex refinement of circ28_run (equal spacing only).
// Writes cmax to out[0] and tmax to out[1].
pub fn rsp_peak(ts: &[f64; 800], cs: &[f64; 800], n: i32, out: &![f64; 2]) with Mut, Div, Panic {
    var im: i32 = 0
    var cm = 0.0
    var i: i32 = 1
    while i <= n {
        if (*cs)[i] > cm {
            cm = (*cs)[i]
            im = i
        }
        i = i + 1
    }
    (*out)[0] = cm
    (*out)[1] = (*ts)[im]
    if im >= 1 && im < n {
        let h1 = (*ts)[im] - (*ts)[im - 1]
        let h2 = (*ts)[im + 1] - (*ts)[im]
        if rsp_abs(h1 - h2) < 1.0e-9 {
            let den = (*cs)[im - 1] - 2.0 * (*cs)[im] + (*cs)[im + 1]
            if den < 0.0 {
                let off = 0.5 * ((*cs)[im - 1] - (*cs)[im + 1]) / den
                (*out)[1] = (*ts)[im] + off * h1
                (*out)[0] = (*cs)[im] - 0.25 * ((*cs)[im - 1] - (*cs)[im + 1]) * off
            }
        }
    }
}

pub fn rsp_run_th_g(
    thr_in: [f64; 18], thm_in: [f64; 18], route: i32, dose: f64, t_inf: f64,
    wr_lo: f64, wr_hi: f64, wm_lo: f64, wm_hi: f64, gv: i32, res: &![f64; 24]
) with Mut, Div, Panic {
    var thr = thr_in
    var thm = thm_in
    let pr = rsp_params(thr, gv)
    let pm = rsp_params(thm, gv)
    let cp = circ28_coupling(thm[CD_MW] / thr[CD_MW], 0.0)
    var ts: [f64; 800] = [0.0; 800]
    var cr: [f64; 800] = [0.0; 800]
    var cm: [f64; 800] = [0.0; 800]
    var sysr = circ28_sys_zero()
    var sysm = circ28_sys_zero()
    var sr = circ28_state_zero()
    var sm = circ28_state_zero()
    var elr = circ28_elim_zero()
    var elm = circ28_elim_zero()
    var n: i32 = 0
    var t = 0.0
    var input = 0.0
    var given = 0.0
    var ok = 1.0
    var ph: i32 = 0
    while ph < 2 {
        var dt = 0.05
        var tstop = 6.0
        if ph == 1 {
            dt = 0.5
            tstop = 240.0
        }
        circ28_prepare(pr, dt, &!sysr)
        circ28_prepare(pm, dt, &!sysm)
        while t + 0.5 * dt < tstop {
            if n >= 799 {
                ok = 0.0
                t = tstop
            } else {
                var iv = 0.0
                var oral = 0.0
                var mass = 0.0
                if route == 0 {
                    mass = circ28_iv_mass(dose, t_inf, t, t + dt)
                    iv = mass / dt
                } else {
                    mass = circ28_oral_mass_n(thr[CD_KA], rsp_ntr(), thr[CD_FA], dose, thr[CD_TLAG], t, t + dt)
                    oral = mass / dt
                }
                input = input + mass
                given = given + circ28_metab_step(&!sr, pr, &sysr, &!elr, &!sm, pm, &sysm, &!elm, cp, iv, oral)
                t = t + dt
                n = n + 1
                ts[n] = t
                cr[n] = sr.x[0] / pr.bp
                cm[n] = sm.x[0] / pm.bp
            }
        }
        ph = ph + 1
    }
    var pk: [f64; 2] = [0.0; 2]
    rsp_peak(&ts, &cr, n, &!pk)
    (*res)[0] = pk[0]
    (*res)[1] = pk[1]
    rsp_peak(&ts, &cm, n, &!pk)
    (*res)[5] = pk[0]
    (*res)[6] = pk[1]
    let lzr = rsp_lz(&ts, &cr, n, wr_lo, wr_hi)
    let lzm = rsp_lz(&ts, &cm, n, wm_lo, wm_hi)
    let auc_r = elr.auc_ven / pr.bp
    let auc_m = elm.auc_ven / pm.bp
    (*res)[4] = auc_r
    (*res)[16] = auc_m
    (*res)[13] = 0.0
    (*res)[14] = 0.0
    (*res)[2] = auc_r
    (*res)[7] = auc_m
    (*res)[3] = 0.0
    (*res)[8] = 0.0
    if lzr > 0.0 {
        (*res)[13] = 1.0
        (*res)[3] = 0.6931471805599453 / lzr
        (*res)[2] = auc_r + cr[n] / lzr
    }
    if lzm > 0.0 {
        (*res)[14] = 1.0
        (*res)[8] = 0.6931471805599453 / lzm
        (*res)[7] = auc_m + cm[n] / lzm
    }
    (*res)[9] = input
    let eli_r = elr.hepatic + elr.formed + elr.renal + elr.plasma + elr.gut
    var ber = 0.0
    if input > 0.0 { ber = rsp_abs(input - eli_r - circ28_total_mass(&sr, pr)) / input }
    (*res)[10] = ber
    let eli_m = elm.hepatic + elm.formed + elm.renal + elm.plasma + elm.gut
    var bem = 0.0
    if given > 0.0 { bem = rsp_abs(given - eli_m - circ28_total_mass(&sm, pm)) / given }
    (*res)[11] = bem
    (*res)[12] = ok
    (*res)[15] = given
    (*res)[17] = cr[n]
    (*res)[18] = cm[n]
}

pub fn rsp_run_th(
    thr_in: [f64; 18], thm_in: [f64; 18], route: i32, dose: f64, t_inf: f64,
    wr_lo: f64, wr_hi: f64, wm_lo: f64, wm_hi: f64, res: &![f64; 24]
) with Mut, Div, Panic {
    rsp_run_th_g(thr_in, thm_in, route, dose, t_inf, wr_lo, wr_hi, wm_lo, wm_hi, 0, res)
}

// ---- budget with refit -------------------------------------------------------------------------
// Sixteen inputs: 0 logP_R, 1 pKa_R, 2 fu_R, 3 bp_R, 4 logP_M, 5 pKa_M, 6 fu_M, 7 bp_M (measured),
// 8 CL_R, 9 Vss_R, 10 fe_R, 11 IV ratio, 12 Tmax_R, 13 CL_M, 14 Vss_M, 15 fe_M (observables).
// Each evaluation refits M, then R, then ka by one chord correction, then runs the coupled oral dose.

pub fn rsp_eval(z: [f64; 16], dr: &Circ28Drug, dm: &Circ28Drug, ka0: f64, slope: f64, dose_mg: f64, out: &![f64; 6]) with Mut, Div, Panic, Epistemic {
    var tm0 = circ28_drug_theta(dm)
    tm0[CD_LOGP] = z[4]
    tm0[CD_PKA1] = z[5]
    tm0[CD_FU] = z[6]
    tm0[CD_BP] = z[7]
    let tm = rsp_fit_m(tm0, z[14], z[13], z[15])
    var tr0 = circ28_drug_theta(dr)
    tr0[CD_LOGP] = z[0]
    tr0[CD_PKA1] = z[1]
    tr0[CD_FU] = z[2]
    tr0[CD_BP] = z[3]
    var tr = rsp_fit_r(tr0, z[9], z[8], z[10], z[11], rsp_q_other())
    tr[CD_KA] = ka0
    let t1 = rsp_tmax_th(tr, ka0)
    tr[CD_KA] = ka0 + (z[12] - t1) / slope
    var res: [f64; 24] = [0.0; 24]
    rsp_run_th(tr, tm, 1, dose_mg, 0.0, 12.0, 36.0, 120.0, 240.0, &!res)
    (*out)[0] = res[2] + res[7]
    (*out)[1] = res[2]
    (*out)[2] = res[7]
    (*out)[3] = res[7] / res[2]
    (*out)[4] = res[0]
    (*out)[5] = res[6]
}

fn rsp_abs_m(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

// Closed-form oral bioavailability of risperidone: fa x Fg x (1 - Eh), Eh the hepatic extraction
// of the record (clint + clform), Fg from the gut-wall clearance (0 here, so Fg = 1).
pub fn rsp_f_oral(th: [f64; 18]) -> f64 with Mut, Div, Panic {
    var tl = th
    let p = circ28_drug_params_theta(tl)
    return th[CD_FA] * circ28_gut_availability(p) * (1.0 - circ28_hepatic_extraction(p))
}

pub struct RspBudget {
    pub am_auc: f64,
    pub r_auc: f64,
    pub m_auc: f64,
    pub ratio: f64,
    pub var_am: f64,
    pub var_r: f64,
    pub var_m: f64,
    pub var_ratio: f64,
    pub var_rcmax: f64,
    pub var_mtmax: f64,
    pub rcmax: f64,
    pub mtmax: f64,
    pub contrib_rcmax: [f64; 16],
    pub contrib_mtmax: [f64; 16],
    pub contrib_am: [f64; 16],
    pub sens_am: [f64; 16],
    pub u: [f64; 16],
    pub runs: i32,
}

pub fn rsp_input_u(i: i32) -> f64 {
    if i == 0 { return rsp_r_u_logp() }
    if i == 1 { return rsp_r_u_pka1() }
    if i == 2 { return rsp_r_u_fu() }
    if i == 3 { return rsp_r_u_bp() }
    if i == 4 { return rsp_m_u_logp() }
    if i == 5 { return rsp_m_u_pka1() }
    if i == 6 { return rsp_m_u_fu() }
    if i == 7 { return rsp_m_u_bp() }
    if i == 8 { return rsp_u_r_cl() }
    if i == 9 { return rsp_u_r_vss() }
    if i == 10 { return rsp_u_r_fe() }
    if i == 11 { return rsp_u_pmratio() }
    if i == 12 { return rsp_u_r_tmax() }
    if i == 13 { return rsp_u_m_cl() }
    if i == 14 { return rsp_u_m_vss() }
    return rsp_u_m_fe()
}

pub fn rsp_input_name(i: i32) -> string {
    if i == 0 { return "logP_R   " }
    if i == 1 { return "pKa_R    " }
    if i == 2 { return "fu_R     " }
    if i == 3 { return "bp_R     " }
    if i == 4 { return "logP_M   " }
    if i == 5 { return "pKa_M    " }
    if i == 6 { return "fu_M     " }
    if i == 7 { return "bp_M     " }
    if i == 8 { return "CL_R obs " }
    if i == 9 { return "Vss_R obs" }
    if i == 10 { return "fe_R obs " }
    if i == 11 { return "PM/EM CLF" }
    if i == 12 { return "Tmax_R   " }
    if i == 13 { return "CL_M obs " }
    if i == 14 { return "Vss_M obs" }
    return "fe_M obs "
}

pub fn rsp_budget(dr: &Circ28Drug, dm: &Circ28Drug, dose_mg: f64) -> RspBudget with Mut, Div, Panic, Epistemic {
    var thr = circ28_drug_theta(dr)
    var thm = circ28_drug_theta(dm)
    let ka0 = thr[CD_KA]
    let slope = rsp_tmax_slope(thr)
    var z0: [f64; 16] = [0.0; 16]
    z0[0] = thr[CD_LOGP]
    z0[1] = thr[CD_PKA1]
    z0[2] = thr[CD_FU]
    z0[3] = thr[CD_BP]
    z0[4] = thm[CD_LOGP]
    z0[5] = thm[CD_PKA1]
    z0[6] = thm[CD_FU]
    z0[7] = thm[CD_BP]
    z0[8] = rsp_obs_r_cl()
    z0[9] = rsp_obs_r_vss()
    z0[10] = rsp_obs_r_fe()
    z0[11] = rsp_obs_pmratio()
    z0[12] = rsp_obs_r_tmax()
    z0[13] = rsp_obs_m_cl()
    z0[14] = rsp_obs_m_vss()
    z0[15] = rsp_obs_m_fe()
    var u: [f64; 16] = [0.0; 16]
    var i: i32 = 0
    while i < 16 {
        u[i] = rsp_input_u(i)
        i = i + 1
    }
    var o0: [f64; 6] = [0.0; 6]
    rsp_eval(z0, dr, dm, ka0, slope, dose_mg, &!o0)
    var sa: [f64; 16] = [0.0; 16]
    var ca: [f64; 16] = [0.0; 16]
    var va = 0.0
    var vr = 0.0
    var vm = 0.0
    var vq = 0.0
    var vc = 0.0
    var vt = 0.0
    var cc: [f64; 16] = [0.0; 16]
    var ct: [f64; 16] = [0.0; 16]
    var nrun: i32 = 1
    i = 0
    while i < 16 {
        var hs = 1.0e-4 * rsp_abs_m(z0[i])
        if hs > 0.1 * u[i] { hs = 0.1 * u[i] }
        var zp = z0
        var zm = z0
        zp[i] = z0[i] + hs
        zm[i] = z0[i] - hs
        var op: [f64; 6] = [0.0; 6]
        var om: [f64; 6] = [0.0; 6]
        rsp_eval(zp, dr, dm, ka0, slope, dose_mg, &!op)
        rsp_eval(zm, dr, dm, ka0, slope, dose_mg, &!om)
        nrun = nrun + 2
        let da = (op[0] - om[0]) / (2.0 * hs)
        let dr = (op[1] - om[1]) / (2.0 * hs)
        let dm = (op[2] - om[2]) / (2.0 * hs)
        let dq = (op[3] - om[3]) / (2.0 * hs)
        let dc = (op[4] - om[4]) / (2.0 * hs)
        let dt = (op[5] - om[5]) / (2.0 * hs)
        sa[i] = da
        ca[i] = da * da * u[i] * u[i]
        va = va + ca[i]
        vr = vr + dr * dr * u[i] * u[i]
        vm = vm + dm * dm * u[i] * u[i]
        vq = vq + dq * dq * u[i] * u[i]
        cc[i] = dc * dc * u[i] * u[i]
        ct[i] = dt * dt * u[i] * u[i]
        vc = vc + cc[i]
        vt = vt + ct[i]
        i = i + 1
    }
    return RspBudget { am_auc: o0[0], r_auc: o0[1], m_auc: o0[2], ratio: o0[3], var_am: va, var_r: vr, var_m: vm, var_ratio: vq, var_rcmax: vc, var_mtmax: vt, rcmax: o0[4], mtmax: o0[5], contrib_rcmax: cc, contrib_mtmax: ct, contrib_am: ca, sens_am: sa, u: u, runs: nrun }
}
