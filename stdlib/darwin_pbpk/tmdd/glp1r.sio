// stdlib/darwin_pbpk/tmdd/glp1r.sio — GLP-1 receptor TMDD layer (semaglutide)
//
// Target-mediated drug disposition for semaglutide binding the GLP-1 receptor
// at three sites: brain (arcuate nucleus — appetite suppression), gut
// (L-cells / enteric neurons — gastric emptying / satiety), and pancreas
// (β-cells — glucose-dependent insulin secretion). Matches the dissertation's
// three semaglutide TMDD organs and the JS engine
// `website/src/lib/pbpk28_core.mjs` + the parity ref
// `tests/run-pass/dissertation_pbpk28_parity_ref_semaglutide.sio`.
//
// The Newton-linearized implicit-CN step kernel is **identical** to the one
// in `fkbp12_mtorc1.sio` — same Mager 2004 3-state ODE, same matrix shape, same
// 3×3 cofactor invert. Only the literature constants and the per-organ
// R_total schedule differ. Callers compose a TmddOrganParams via
// `glp1r_params_at(i)` and step it with `tmdd_step` (imported from the FKBP12
// module — the kernel is drug-agnostic).
//
// Extracted from tests/run-pass/dissertation_pbpk28_parity_ref_semaglutide.sio
// (Stage G-ε-12, gap-report claim `tmdd_semaglutide_path`).

use darwin_pbpk::tmdd::fkbp12_mtorc1::*

// ─── Drug constants ─────────────────────────────────────────────────────────
// Semaglutide, MW = 4113.58 Da (Novo Nordisk product monograph; sequence
// includes the C-18 fatty diacid and γGlu spacer on Lys26 — UniProt P01275
// glucagon precursor 92-128 fragment + the acylation modifications).
pub fn glp1r_mw_semaglutide_da() -> f64 { return 4113.58 }

// ─── Literature parameters per dissertation §4.5.5 ──────────────────────────
// Peptide-GPCR rates are *kinetically faster* than small-molecule-FKBP12:
// k_on ≈ 5× higher reflects the high-affinity peptide-receptor association
// (Lau 2015 SPR + Knudsen 2019). k_int ≈ 5× higher reflects β-arrestin-mediated
// GPCR internalisation. k_deg ≈ same order (GPCR turnover ~hours).
//   Brain     i=3  → R_total_0 = 1 nM  (arcuate nucleus, low density)
//   Gut       i=8  → R_total_0 = 2 nM  (L-cells, moderate)
//   Pancreas  i=12 → R_total_0 = 5 nM  (β-cells, dominant TMDD sink)

pub fn glp1r_kdeg() -> f64 { return 0.05 }    // 1/h, GPCR turnover
pub fn glp1r_kon()  -> f64 { return 0.50 }    // L/(nmol·h), peptide-GPCR association
pub fn glp1r_kd()   -> f64 { return 0.40 }    // nmol/L (Lau 2015 EC50 vs liraglutide)
pub fn glp1r_kint() -> f64 { return 0.050 }   // 1/h, β-arrestin internalisation
pub fn glp1r_koff() -> f64 { return glp1r_kon() * glp1r_kd() }

// Total GLP-1R receptor density at baseline (nmol/L of tissue volume).
pub fn glp1r_rtotal0_at(i: i64) -> f64 {
    if i ==  3 { return 1.0 }
    if i ==  8 { return 2.0 }
    if i == 12 { return 5.0 }
    return 0.0
}

// At equilibrium, k_syn = k_deg · R_total_0.
pub fn glp1r_ksyn_at(i: i64) -> f64 {
    return glp1r_kdeg() * glp1r_rtotal0_at(i)
}

// Whether an organ index participates in the semaglutide TMDD layer.
pub fn glp1r_is_tmdd_organ(i: i64) -> bool {
    if i ==  3 { return true }
    if i ==  8 { return true }
    if i == 12 { return true }
    return false
}

// Populate `TmddOrganParams` for semaglutide at the named organ index. Returns
// a zero-R_total params pack for non-TMDD organs (callers gate via
// glp1r_is_tmdd_organ before stepping).
pub fn glp1r_params_at(i: i64) -> TmddOrganParams {
    TmddOrganParams {
        k_on:  glp1r_kon(),
        k_off: glp1r_koff(),
        k_int: glp1r_kint(),
        k_deg: glp1r_kdeg(),
        k_syn: glp1r_ksyn_at(i),
        mw_da: glp1r_mw_semaglutide_da(),
    }
}
