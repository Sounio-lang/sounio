// darwin_pbpk/export/petab_observables.sio — PEtab-style observables table

pub fn print_brain_plasma_petab_observables_csv() with IO {
    println("observableId,observableFormula,noiseFormula,observableName")
    println("blood_plasma,blood_plasma_concentration,sigma_blood_plasma,Blood plasma concentration")
    println("brain_tissue,brain_tissue_concentration,sigma_brain_tissue,Brain tissue concentration")
}
