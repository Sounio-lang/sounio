// darwin_pbpk/export/petab_conditions.sio — PEtab-style condition table

use io::scientific::{sci_print_f64}

pub fn print_rapamycin_petab_conditions_csv() with IO, Mut, Panic, Div {
    println("conditionId,dose_mg_per_kg,route,compound,targetCompartment")
    print("rapamycin_iv_bolus_ref,")
    sci_print_f64(1.0, 6)
    println(",iv_bolus,rapamycin,blood")
}
