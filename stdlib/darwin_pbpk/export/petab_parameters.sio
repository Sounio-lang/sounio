// darwin_pbpk/export/petab_parameters.sio — PEtab-style parameters table

use darwin_pbpk::epistemic_pbpk14::{ep14_rapamycin_priors}
use io::scientific::{sci_print_f64}

fn ppar_sqrt(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i: i32 = 0
    while i < 12 {
        y = 0.5 * (y + x / y)
        i = i + 1
    }
    y
}

fn petab_param_name(idx: i32) -> string {
    if idx == 0 { return "cl_hepatic" }
    if idx == 1 { return "cl_renal" }
    if idx == 2 { return "fu_plasma" }
    if idx == 3 { return "kp_brain" }
    if idx == 4 { return "kp_liver" }
    if idx == 5 { return "kp_kidney" }
    if idx == 6 { return "kp_adipose" }
    "param_unknown"
}

fn petab_lower_bound(idx: i32, mean: f64, sd: f64) -> f64 {
    var lower = mean - 3.0 * sd
    if idx == 2 {
        if lower < 0.0 { lower = 0.0 }
    } else {
        if lower < 0.000001 { lower = 0.000001 }
    }
    lower
}

fn petab_upper_bound(idx: i32, mean: f64, sd: f64) -> f64 {
    var upper = mean + 3.0 * sd
    if idx == 2 && upper > 1.0 {
        upper = 1.0
    }
    if upper < mean {
        upper = mean
    }
    upper
}

pub fn print_rapamycin_petab_parameters_csv() with IO, Mut, Panic, Div {
    let priors = ep14_rapamycin_priors()
    println("parameterId,nominalValue,estimate,lowerBound,upperBound")

    var i: i32 = 0
    while i < priors.n {
        let idx = i as usize
        let mean = priors.mean[idx]
        let sd = ppar_sqrt(priors.variance[idx])

        print(petab_param_name(i))
        print(",")
        sci_print_f64(mean, 6)
        print(",1,")
        sci_print_f64(petab_lower_bound(i, mean, sd), 6)
        print(",")
        sci_print_f64(petab_upper_bound(i, mean, sd), 6)
        println("")

        i = i + 1
    }
}
