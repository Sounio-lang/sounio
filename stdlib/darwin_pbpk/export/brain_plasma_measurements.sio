// darwin_pbpk/export/brain_plasma_measurements.sio — measurement-table export
//
// Emits a compact PEtab-style measurement table for the canonical
// brain/plasma trajectory workflow.

use darwin_pbpk::brain_plasma_tac::*
use io::scientific::{sci_print_f64}

// Clamp sub-precision residuals to 0.0 at print time: enforces the
// physical invariant c >= 0 for reported concentrations (suppresses
// IEEE negative zero and tiny-negative RK step artifacts) without
// corrupting the upstream finite-difference uncertainty propagation
// that needs the unclamped tail values.
fn bpm_clamp_eps(x: f64) -> f64 with Mut, Div, Panic {
    let ax = if x < 0.0 { 0.0 - x } else { x }
    if ax < 1.0e-12 { 0.0 } else { x }
}

pub fn print_brain_plasma_measurements_csv(table: BrainPlasmaTacTable) with IO, Mut, Panic, Div {
    println("observableId,simulationConditionId,time,measurement,measurementUncertainty")

    var i: i32 = 0
    while i < table.n_points {
        let idx = i as usize

        print("blood_plasma,rapamycin_iv_bolus_ref,")
        sci_print_f64(table.times_h[idx], 6)
        print(",")
        sci_print_f64(bpm_clamp_eps(table.blood_values[idx]), 6)
        print(",")
        sci_print_f64(table.blood_uncertainties[idx], 6)
        println("")

        print("brain_tissue,rapamycin_iv_bolus_ref,")
        sci_print_f64(table.times_h[idx], 6)
        print(",")
        sci_print_f64(bpm_clamp_eps(table.brain_values[idx]), 6)
        print(",")
        sci_print_f64(table.brain_uncertainties[idx], 6)
        println("")

        i = i + 1
    }
}
