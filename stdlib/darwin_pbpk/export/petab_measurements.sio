// darwin_pbpk/export/petab_measurements.sio — PEtab-style measurements table

use darwin_pbpk::schema::observation::*
use io::scientific::{sci_print_f64}

pub fn print_petab_measurements_csv(
    table: NormalizedObservationTable
) with IO, Mut, Panic, Div {
    println("observableId,simulationConditionId,time,measurement,measurementUncertainty")

    var i: usize = 0
    while i < normalized_observation_count(table) {
        let row = normalized_observation_get(table, i)
        print(row.observable_id)
        print(",")
        print(row.simulation_condition_id)
        print(",")
        sci_print_f64(row.time_h, 6)
        print(",")
        sci_print_f64(row.measurement, 6)
        print(",")
        sci_print_f64(row.measurement_uncertainty, 6)
        println("")
        i = i + 1
    }
}
