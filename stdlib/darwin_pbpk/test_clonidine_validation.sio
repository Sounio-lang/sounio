//@ run-pass
//@ expect-stdout: PASS
// clonidine_faseE4_valid.sio — validação clonidina Fase E4 (kernel UTIped PBPK28)
// Parâmetros: LITERAIS extraídos do módulo canônico darwin_pbpk::drugs::clonidine
// via clo_dump.sio (cluster, 12/08/2026; fonte única de verdade). Workaround
// thin-link documentado: o Madaros v0.80 (toolchain 11/08) REGRIDU — pub fns
// que chamam matemática local recursiva (powf→exp/ln) não cruzam a fronteira
// de módulo (rc=12); morphine::r_ugt2b7 também falha. Rodar com
// SOUNIO_SOUC_ENGINE=lean_single (ver issue #1715).
//
// Âncoras (Potts & Larsson 2007, Paediatr Anaesth 17:924-33; pooled n=83):
//   CL adulto 14.6 L/h/70kg · CL nascer 3.8 L/h/70kg (26%) · 82% adulto em
//   1 ano · Vss 181.5 L/70kg (2.6 L/kg; modelo: 174.8 = 2.50, −4%)
//   t½ lactente 11.4h (ANMF 2025; tensão documentada no cabeçalho do módulo)
//   Enteral: F 0.55 (Larsson 2011) · ka 0.21/h (Arenas-Lopez 2014)
//   Yellepeddi 2024 PBPK: 5 µg/kg q6h lactente → Css ~1–2 ng/mL
//
// CL_eff (L/h) do módulo (clo_dump): adult 14.6 · neo7/3.3kg 0.392381 ·
// lac122/6.15kg 1.237336. Clearance DUAL 50/50 (CYP2D6 × renal) colapsa em
// cl_central total neste kernel (concentração plasmática depende só do CL
// total; split importa apenas para ontogenia diferencial futura e IR).

struct State28 { cv: [f64; 14], ct: [f64; 14] }
struct Params28 {
    v_ref: [f64; 14], vasc_frac: [f64; 14], kp: [f64; 14],
    ps: [f64; 14], q: [f64; 14], cl_central: f64,
}

// ─── Matemática (verbatim morphine_fase6_valid) ─────────────────────────────
fn exp_f64(x: f64) -> f64 {
    if x > 20.0 { return exp_f64(x / 2.0) * exp_f64(x / 2.0) }
    if x < 0.0 - 20.0 { return 1.0 / exp_f64(0.0 - x) }
    var sum = 1.0
    var term = 1.0
    var i = 1.0
    while i <= 20.0 { term = term * x / i; sum = sum + term; i = i + 1.0 }
    return sum
}
fn sqrt_f64(x: f64) -> f64 {
    if x <= 0.0 { return 0.0 }
    var guess = x / 2.0
    if guess < 1.0 { guess = 1.0 }
    var i = 0.0
    while i < 20.0 { guess = (guess + x / guess) / 2.0; i = i + 1.0 }
    return guess
}
fn ln_f64(x: f64) -> f64 {
    if x <= 0.0 { return 0.0 - 1000000.0 }
    if x == 1.0 { return 0.0 }
    if x > 1.5 { return 2.0 * ln_f64(sqrt_f64(x)) }
    if x < 0.7 { return 0.0 - ln_f64(1.0 / x) }
    let u = x - 1.0
    var sum = 0.0
    var term = u
    var i = 1.0
    while i <= 30.0 { sum = sum + term / i; term = 0.0 - term * u; i = i + 1.0 }
    return sum
}
fn powf(b: f64, e: f64) -> f64 { return exp_f64(e * ln_f64(b)) }

// ─── Passo CN (verbatim morphine_fase6_valid) ───────────────────────────────
fn state_zero() -> State28 {
    State28 { cv: [0.0; 14], ct: [0.0; 14] }
}
fn cn_step(state: State28, p: Params28, rel_mid: f64, dt: f64) -> State28 with Mut, Div {
    let h = 0.5 * dt
    let vb = p.v_ref[0]
    var sum_q = 0.0
    var i: i32 = 1
    while i < 14 { sum_q = sum_q + p.q[i]; i = i + 1 }
    let big_s = h * (sum_q + p.cl_central) / vb
    let cb_old = state.cv[0]
    var rhs0 = (1.0 - big_s) * cb_old + dt * rel_mid / vb
    var a_v: [f64; 14] = [0.0; 14]
    var b_v: [f64; 14] = [0.0; 14]
    var a_t: [f64; 14] = [0.0; 14]
    var b_t: [f64; 14] = [0.0; 14]
    var sum_beta_a = 0.0
    var sum_beta_b = 0.0
    i = 1
    while i < 14 {
        let vi = p.v_ref[i]
        let vf = p.vasc_frac[i]
        let vv_raw = vi * vf
        let vt_raw = vi * (1.0 - vf)
        let vv = if vv_raw < 1.0e-30 { 1.0e-30 } else { vv_raw }
        let vt = if vt_raw < 1.0e-30 { 1.0e-30 } else { vt_raw }
        let kp = p.kp[i]
        let psi = p.ps[i]
        let qi = p.q[i]
        let beta  = h * qi / vb
        let gamma = h * qi / vv
        let pp    = 1.0 + h * (qi + psi) / vv
        let qq    = h * psi / (vv * kp)
        let rr    = h * psi / vt
        let sb    = 1.0 + h * psi / (vt * kp)
        let det   = pp * sb - qq * rr
        rhs0 = rhs0 + beta * state.cv[i]
        let rhs_v = gamma * cb_old + (1.0 - h * (qi + psi) / vv) * state.cv[i] + qq * state.ct[i]
        let rhs_t = rr * state.cv[i] + (1.0 - h * psi / (vt * kp)) * state.ct[i]
        let av = (sb * rhs_v + qq * rhs_t) / det
        let bv = (sb * gamma) / det
        let at = (rr * rhs_v + pp * rhs_t) / det
        let bt = (rr * gamma) / det
        a_v[i] = av
        b_v[i] = bv
        a_t[i] = at
        b_t[i] = bt
        sum_beta_a = sum_beta_a + beta * av
        sum_beta_b = sum_beta_b + beta * bv
        i = i + 1
    }
    let cb_new = (rhs0 + sum_beta_a) / ((1.0 + big_s) - sum_beta_b)
    var out = state_zero()
    out.cv[0] = if cb_new < 0.0 { 0.0 } else { cb_new }
    i = 1
    while i < 14 {
        let cv = a_v[i] + b_v[i] * cb_new
        let ct = a_t[i] + b_t[i] * cb_new
        out.cv[i] = if cv < 0.0 { 0.0 } else { cv }
        out.ct[i] = if ct < 0.0 { 0.0 } else { ct }
        i = i + 1
    }
    return out
}

// ─── Ontogenia Potts 2007 (réplica do módulo; gate B) ───────────────────────
fn r_cl_potts_drv(pna_days: f64) -> f64 {
    let x = pna_days / 7.0
    let u = x / 25.7
    let h = powf(u, 1.5)
    return 0.26 + 0.74 * h / (1.0 + h)
}

// ─── Params clonidina (literais do módulo + vf/ps70 da suíte UTIped) ────────
fn build_clo(w: f64, cl: f64) -> Params28 with Mut, Div {
    let wr = w / 70.0
    // v70/q70/kp: literais do módulo canônico (rr_neutral logD 0.7, fu 0.75)
    let v70 = [5.2, 1.69, 0.31, 1.37, 0.31, 1.17, 29.0, 18.2, 1.65, 7.8, 10.5, 0.19, 0.14, 4.5]
    let q70 = [0.0, 90.0, 72.0, 44.0, 14.4, 0.0, 73.8, 18.0, 57.6, 18.0, 21.6, 10.8, 4.5, 18.0]
    let kp = [0.893839, 1.120335, 1.118929, 1.359454, 1.150273, 1.111743,
              1.078191, 5.906845, 1.295344, 1.306302, 0.712278, 1.143559,
              1.167711, 1.087030]
    // vf/ps70: template genérico da suíte UTIped (verbatim morphine; clonidina
    // é pequena/lipofílica → essencialmente perfusion-limited, ps não limita)
    let ps70 = [0.0, 45.0, 37.0, 4.4, 8.0, 0.0, 21.0, 5.0, 27.5, 10.5, 8.5, 5.0, 4.0, 6.5]
    let vf = [1.0, 0.21, 0.16, 0.037, 0.262, 0.262, 0.04, 0.05, 0.024, 0.019, 0.041, 0.282, 0.18, 0.05]
    var v: [f64; 14] = [0.0; 14]
    var q: [f64; 14] = [0.0; 14]
    var ps: [f64; 14] = [0.0; 14]
    var i: i64 = 0
    while i < 14 {
        v[i] = v70[i] * wr
        q[i] = q70[i] * wr
        ps[i] = ps70[i] * wr
        i = i + 1
    }
    return Params28 { v_ref: v, vasc_frac: vf, kp: kp, ps: ps, q: q, cl_central: cl }
}

fn main() -> i64 with Mut, Div, IO {
    println("FASE E4 — validação clonidina (params do módulo canônico)")
    var ok: i64 = 1
    let dt = 0.05

    // A) adulto 70kg: infusão IV 1 µg/kg/h (0.07 mg/h) x 96h → CL_obs
    let pa = build_clo(70.0, 14.6)
    var st = state_zero()
    var t = 0.0
    var c_stop = 0.0
    var steps: i64 = 0
    while t < 96.5 {
        if steps > 100000 { t = 96.5 }
        var rel = 0.07
        if t >= 96.0 { rel = 0.0 }
        let st_new = cn_step(st, pa, rel, dt)
        let t_new = t + dt
        if t < 96.0 && t_new >= 96.0 { c_stop = st_new.cv[0] }
        t = t_new
        st = st_new
        steps = steps + 1
    }
    let cl_obs = 0.07 / c_stop
    print("A adulto: Css="); print(c_stop); print(" mg/L → CL="); print(cl_obs)
    println(" L/h (alvo 14.6 ±20%)")
    if cl_obs < 11.68 || cl_obs > 17.52 { ok = 0 println("  G FAIL CL adulto") }

    // B) ontogenia Potts: r(0)=0.26 · r(365d)≈0.81–0.82
    let r0 = r_cl_potts_drv(0.0)
    let r1y = r_cl_potts_drv(365.0)
    print("B maturação: r(0)="); print(r0); print(" r(1a)="); print(r1y)
    println(" (gates 0.26±0.01 · [0.78,0.85])")
    if r0 < 0.25 || r0 > 0.27 { ok = 0 println("  G FAIL r(0)") }
    if r1y < 0.78 || r1y > 0.85 { ok = 0 println("  G FAIL r(1a)") }

    // C) Vss (literais): alvo 174.8 L/70kg (Potts 181.5, −4%)
    let v70c = [5.2, 1.69, 0.31, 1.37, 0.31, 1.17, 29.0, 18.2, 1.65, 7.8, 10.5, 0.19, 0.14, 4.5]
    let kpc = [0.893839, 1.120335, 1.118929, 1.359454, 1.150273, 1.111743,
               1.078191, 5.906845, 1.295344, 1.306302, 0.712278, 1.143559,
               1.167711, 1.087030]
    var vss = v70c[0]
    var i: i64 = 1
    while i < 14 {
        vss = vss + kpc[i] * v70c[i]
        i = i + 1
    }
    print("C Vss(Kp)="); print(vss); println(" L/70kg (gate [160,190]; 2.50 L/kg)")
    if vss < 160.0 || vss > 190.0 { ok = 0 println("  G FAIL Vss") }

    // D+E) lactente 122d/6.15kg: infusão 1 µg/kg/h x 96h → parada → CL + t½
    let cl_lac = 1.237336
    let pl = build_clo(6.15, cl_lac)
    let rate_l = 0.00615   // mg/h (1 µg/kg/h × 6.15 kg)
    var stl = state_zero()
    var tl = 0.0
    var c_stop_l = 0.0
    var c4 = 0.0
    var c10 = 0.0
    var steps2: i64 = 0
    while tl < 130.0 {
        if steps2 > 100000 { tl = 130.0 }
        var rel = rate_l
        if tl >= 96.0 { rel = 0.0 }
        let st_new = cn_step(stl, pl, rel, dt)
        let c_new = st_new.cv[0]
        let t_new = tl + dt
        if tl < 96.0 && t_new >= 96.0 { c_stop_l = c_new }
        if c_stop_l > 0.0 && t_new >= 100.0 && tl < 100.0 { c4 = c_new }
        if c_stop_l > 0.0 && t_new >= 106.0 && tl < 106.0 { c10 = c_new }
        tl = t_new
        stl = st_new
        steps2 = steps2 + 1
    }
    let cl_obs_l = rate_l / c_stop_l
    print("D lactente: Css="); print(c_stop_l); print(" mg/L → CL="); print(cl_obs_l)
    println(" L/h (módulo 1.2373 ±10%)")
    if cl_obs_l < 1.1136 || cl_obs_l > 1.3611 { ok = 0 println("  G FAIL CL lactente") }
    let thalf = 0.693 * 6.0 / ln_f64(c4 / c10)
    print("E lactente: t1/2 terminal="); print(thalf)
    println(" h (gate [6.8,16.0]; ANMF 11.4h ±40%, tensão documentada)")
    if thalf < 6.8 || thalf > 16.0 { ok = 0 println("  G FAIL t1/2 lactente") }

    // F) enteral lactente 5 µg/kg q6h (F 0.55 · ka 0.21/h): Css médio dia 5
    //    alvo Yellepeddi 2024 ~1–2 ng/mL → gate [1,4] µg/L = [0.001,0.004] mg/L
    let dose_mg = 0.03075          // 5 µg/kg × 6.15 kg
    let f_oral = 0.55
    let ka = 0.21
    var ste = state_zero()
    var te = 0.0
    var depot = 0.0
    var next_dose = 0.0
    var auc_d5 = 0.0
    var steps3: i64 = 0
    while te < 120.0 {
        if steps3 > 100000 { te = 120.0 }
        if te >= next_dose {
            depot = depot + f_oral * dose_mg
            next_dose = next_dose + 6.0
        }
        let rel_e = ka * depot
        let st_new = cn_step(ste, pl, rel_e, dt)
        depot = depot - rel_e * dt
        if te >= 96.0 { auc_d5 = auc_d5 + st_new.cv[0] * dt }
        te = te + dt
        ste = st_new
        steps3 = steps3 + 1
    }
    let css_ent = auc_d5 / 24.0
    print("F enteral q6h: Css médio d5="); print(css_ent * 1000.0)
    println(" µg/L (gate [1,4]; Yellepeddi ~1–2)")
    if css_ent < 0.001 || css_ent > 0.004 { ok = 0 println("  G FAIL Css enteral") }

    if ok == 1 {
        println("PASS")
        return 0
    }
    println("FAIL")
    return 1
}
