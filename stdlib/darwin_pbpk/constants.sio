// stdlib/darwin_pbpk/constants.sio — Shared PBPK Constants
//
// Mathematical utilities and physiological constants for PBPK modeling.
//
// References:
// - ICRP Publication 89: Basic anatomical and physiological data (2002)
// - Brown et al. (1997) Physiological parameter values for PBPK models
// - Davies & Morris (1993) Physiological parameters in laboratory animals and humans

// ============================================================================
// MATHEMATICAL CONSTANTS
// ============================================================================

fn dpbpk_pi() -> f64 { 3.14159265358979323846 }
fn dpbpk_e() -> f64 { 2.71828182845904523536 }

// ============================================================================
// MATHEMATICAL FUNCTIONS
// ============================================================================

fn dpbpk_abs(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn dpbpk_max(a: f64, b: f64) -> f64 {
    if a > b { a } else { b }
}

fn dpbpk_min(a: f64, b: f64) -> f64 {
    if a < b { a } else { b }
}

fn dpbpk_clamp(x: f64, lo: f64, hi: f64) -> f64 {
    if x < lo { lo } else if x > hi { hi } else { x }
}

fn dpbpk_exp(x: f64) -> f64 {
    // Taylor series with overflow/underflow protection
    if x > 700.0 { return dpbpk_exp(350.0) * dpbpk_exp(x - 350.0) }
    if x < -700.0 { return 0.0 }
    var result = 1.0
    var term = 1.0
    var n: i64 = 1
    while n < 30 {
        term = term * x / n as f64
        result = result + term
        n = n + 1
    }
    result
}

fn dpbpk_sqrt(x: f64) -> f64 {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i: i64 = 0
    while i < 15 {
        y = (y + x / y) / 2.0
        i = i + 1
    }
    y
}

fn dpbpk_log(x: f64) -> f64 {
    // Natural log via Newton's method
    if x <= 0.0 { return 0.0 - 1000.0 }
    var y = 0.0
    var xr = x
    while xr > 2.0 {
        xr = xr / 2.71828182845904523536
        y = y + 1.0
    }
    while xr < 0.5 {
        xr = xr * 2.71828182845904523536
        y = y - 1.0
    }
    y = y + (xr - 1.0)
    var i: i64 = 0
    while i < 15 {
        let ey = dpbpk_exp(y)
        if ey > 0.0 {
            y = y + (x - ey) / ey
        }
        i = i + 1
    }
    y
}

fn dpbpk_log10(x: f64) -> f64 {
    dpbpk_log(x) / 2.302585092994046
}

fn dpbpk_pow(base: f64, exp_int: i64) -> f64 {
    if exp_int == 0 { return 1.0 }
    var result = 1.0
    var b = base
    var e = exp_int
    if e < 0 {
        b = 1.0 / b
        e = 0 - e
    }
    while e > 0 {
        if e % 2 == 1 {
            result = result * b
        }
        b = b * b
        e = e / 2
    }
    result
}

// ============================================================================
// PHYSIOLOGICAL CONSTANTS
// ============================================================================

// Reference adult body weight (kg)
fn BODY_WEIGHT_KG() -> f64 { 70.0 }

// Cardiac output (L/h) — resting adult
fn CARDIAC_OUTPUT_LPH() -> f64 { 348.0 }

// Glomerular filtration rate (mL/h)
fn GFR_MLH() -> f64 { 7500.0 }

// Organ blood flows (L/h)
fn LIVER_BLOOD_FLOW_LPH() -> f64 { 90.0 }
fn BRAIN_BLOOD_FLOW_LPH() -> f64 { 42.0 }
fn KIDNEY_BLOOD_FLOW_LPH() -> f64 { 72.0 }

// Plasma protein concentration (g/L albumin)
fn PLASMA_PROTEIN_CONC() -> f64 { 40.0 }

// Hematocrit (fraction)
fn HEMATOCRIT() -> f64 { 0.45 }

// ============================================================================
// TISSUE VOLUMES (L, reference 70 kg adult)
// ============================================================================

fn V_PLASMA() -> f64 { 3.0 }
fn V_LIVER() -> f64 { 1.5 }
fn V_BRAIN() -> f64 { 1.4 }
fn V_KIDNEY() -> f64 { 0.31 }
fn V_MUSCLE() -> f64 { 35.0 }
fn V_FAT() -> f64 { 14.0 }
fn V_GUT() -> f64 { 1.2 }

// ============================================================================
// INLINE TESTS
// ============================================================================

// Test: dpbpk_exp(0) = 1
fn test_dpbpk_exp_zero() -> bool {
    dpbpk_abs(dpbpk_exp(0.0) - 1.0) < 0.0001
}

// Test: dpbpk_exp(1) ≈ e
fn test_dpbpk_exp_one() -> bool {
    dpbpk_abs(dpbpk_exp(1.0) - 2.71828182845904523536) < 0.001
}

// Test: dpbpk_log(e) ≈ 1
fn test_dpbpk_log_e() -> bool {
    dpbpk_abs(dpbpk_log(2.71828182845904523536) - 1.0) < 0.001
}

// Test: log(exp(x)) ≈ x round-trip
fn test_log_exp_roundtrip() -> bool {
    let x = 3.7
    let r = dpbpk_log(dpbpk_exp(x))
    dpbpk_abs(r - x) < 0.01
}

// Test: dpbpk_pow(2, 10) = 1024
fn test_dpbpk_pow_2_10() -> bool {
    dpbpk_abs(dpbpk_pow(2.0, 10) - 1024.0) < 0.001
}

// Test: dpbpk_pow(x, 0) = 1
fn test_dpbpk_pow_zero() -> bool {
    dpbpk_abs(dpbpk_pow(42.0, 0) - 1.0) < 0.0001
}

// Test: dpbpk_pow(x, -1) = 1/x
fn test_dpbpk_pow_neg() -> bool {
    dpbpk_abs(dpbpk_pow(4.0, -1) - 0.25) < 0.0001
}

// Test: dpbpk_log10(100) ≈ 2
fn test_dpbpk_log10() -> bool {
    dpbpk_abs(dpbpk_log10(100.0) - 2.0) < 0.01
}

// Test: dpbpk_sqrt(4) = 2
fn test_dpbpk_sqrt_4() -> bool {
    dpbpk_abs(dpbpk_sqrt(4.0) - 2.0) < 0.0001
}

// Test: clamp works
fn test_dpbpk_clamp() -> bool {
    let a = dpbpk_clamp(5.0, 0.0, 3.0)
    let b = dpbpk_clamp(-1.0, 0.0, 3.0)
    let c = dpbpk_clamp(1.5, 0.0, 3.0)
    let ok1 = dpbpk_abs(a - 3.0) < 0.0001
    let ok2 = dpbpk_abs(b - 0.0) < 0.0001
    let ok3 = dpbpk_abs(c - 1.5) < 0.0001
    if ok1 { if ok2 { ok3 } else { false } } else { false }
}
