// stdlib/darwin_pbpk/circ28_drug_everolimus.sio — everolimus on the circ28 drug record
//
// Everolimus (40-O-(2-hydroxyethyl)-sirolimus) in a healthy adult (ICRP 89 reference male, 73 kg), WHOLE-BLOOD
// concentrations, oral tablet, local saturable erythrocyte binding (circ28_nl.sio), intestinal CYP3A first pass.
// Shared helpers (pooling, closed-form fit, runner, budget): circ28_drug_sirolimus.sio (prefix mtor_).
//
// NO INTRAVENOUS HUMAN DATA EXIST in any source opened: clearance and volume are APPARENT and F is DECLARED.
// As for sirolimus, F cancels to first order in every oral whole-blood prediction (AUC = Dose/(CL/F)).
//
// STATUS: 1 measured, 2 derived (stated formula), 3 fitted to one named observable (then not a validation).
// u = standard uncertainty of the value. ACCESS: FT full text, AB abstract only, LBL label text (DailyMed SPL
// e082a024..., Zortress, full text of sections 12.3 and 7), SEC secondary, PC PubChem.
//
//  param    value        u        status  source (access)
//  MW       958.2        0        1       PubChem CID 6442177 (PC)
//  logP     4.2          0.5      2       NO experimental logP found. Derived: sirolimus 4.3 (Emoto 2013, citing
//                                         DrugBank) + (5.9 - 6.0), the difference of the computed XLogP3 of the
//                                         two compounds (PubChem, PC). u = 0.5 (judgment; the computed values
//                                         themselves are 1.7 above the sirolimus value used)
//  pKa      -            -        0       neutral
//  fu       0.265        0.0085   1       bound 73.5 +/- 2.4 % in 8 healthy controls (Kovarik 2001 Clin Pharmacol
//                                         Ther 70:425, PMID 11719728, AB); label: "approximately 74 %" (LBL).
//                                         u = 0.024/sqrt8
//  Hct      0.434        0.0104   1       ICRP 89 body haematocrit
//  Bmax     3365 ng/mL   1010     2       DERIVED from the label sentence "the blood-to-plasma ratio ... is
//           of RBC                        concentration dependent ranging from 17 % to 73 % over the range of
//  Kd       527 ng/mL    158      2       5 ng/mL to 5000 ng/mL" (LBL), READ AS THE SHARE OF THE DRUG IN BLOOD
//           of plasma                     THAT IS IN PLASMA (the Afinitor label, opened by the dossier: "the
//                                         amount of everolimus confined to plasma is approximately 20 %"): an
//                                         INTERPRETATION, the label does not define the quantity. With
//                                         fp = (1 - Hct) Cp/Cb at Cb = 5 and 5000 ng/mL the two unknowns of
//                                         Cb = (1 - Hct) Cp + Hct Bmax Cp/(Kd + Cp) follow in closed form
//                                         (evr_kd, evr_bmax). The haematocrit of the experiment is unknown
//                                         (the model value is used). u = 30 % each (judgment: the dossier
//                                         puts 25-40 % on the definition alone). No published Bmax/Kd exists.
//  fa       1.0          0.115    2       as for sirolimus (assumption; band [0.6, 1]/sqrt12)
//  ps_gut   11.33 L/h    8.7      2       SURROGATE, UNSOURCED FOR THIS DRUG: the tacrolimus value (see sirolimus)
//  F        0.16         0.05     2       UNSOURCED: the task statement ("about 16 %, estimated"); no human value
//                                         in a source opened here (rat: 12 %, Laplanche 2007, PMID 17431753, AB).
//                                         u = 0.05 (judgment)
//  CL/F     pooled       pooled   -       k = 5, N = 70, healthy subjects, single 2 mg tablet, Dose/AUC of the
//                                         reported mean AUC (ABSTRACTS; SD from the AUC SD): Kovarik 2005 J Clin
//                                         Pharmacol 45:514 (PMID 15831774) n = 12, AUC 90 +/- 23; Kovarik 2005
//                                         Eur J Clin Pharmacol 61:35 (PMID 15785960) n = 16, 116 +/- 37; Kovarik
//                                         2005 Br J Clin Pharmacol 60:434 (PMID 16187976, PMC1884822) n = 16,
//                                         115 +/- 45; Kovarik 2010 Int J Clin Pharmacol Ther 48:103 (PMID
//                                         20137762) n = 18, 114 +/- 50; Kovarik 2001 (PMID 11719728) n = 8 healthy
//                                         controls, CL/F 19.4 +/- 5.8 L/h as reported
//  t1/2     pooled       pooled   -       k = 5, N = 64, the same studies and the rifampicin study (Kovarik 2002
//                                         Ann Pharmacother 36:981, PMID 12022896, AB, 4 mg, n = 12): 30 +/- 4,
//                                         32 +/- 6, 32 +/- 6, 43 +/- 18, 32
//  V        NO V_ss/F in any source opened (healthy: none; label: Vc/F 110 L of a population model and Vz/F 342 +/-
//           107 L in maintenance recipients ON CICLOSPORIN; Moes 2012, PMID 22624503, AB: V1/F 148 L only).
//           The only volume observable of healthy subjects is the TERMINAL volume Vz/F = (CL/F) t1/2/ln 2.
//  kpsc     fitted       propag.  3       to the pooled terminal half-life given the pooled CL/F (equivalently to
//                                         Vz/F), by simulation: the unknown is V_ss/F. CONSEQUENCES, declared:
//                                         the half-life is NOT a validation, and the input-consistency check
//                                         V ln2/CL against t1/2 is degenerate (an identity): the inputs cannot
//                                         say whether there is room for a distribution phase.
//  clint    fitted       propag.  3       to CL(blood) = F x pooled CL/F
//  clgut    fitted       propag.  3       to F (fa as given)
//  ps scalar 1 (DEFAULT) 0.25     0       NOT FITTED: no rate observable was found that would leave Cmax as a
//                                         validation (the abstracts give Cmax, AUC, half-life; no early or 24 h
//                                         concentration, no two-compartment rate constants). The placeholder
//                                         ps = 20 Q stays; u = (1 - 0.138)/sqrt12, the band between the default
//                                         and the value fitted for sirolimus (judgment)
//  ka       fitted       propag.  3       to Tmax 1.5 h: label "peak everolimus concentrations occur 1 to 2 hours
//                                         post dose" (LBL); u = 1 h/sqrt12
//
// ROUND (TRANSIT), 2026-11-15: the oral input of the adopted record is an Erlang chain of evr_ntr() = 4 stages (n = 3 transit
// compartments DECLARED + 1; no sourced n: the Djebli 2006 value is a sirolimus k). CD_KA is then the rate k of EACH stage,
// refitted to the same Tmax 1.5 h: k = 3.96 /h (u 0.79), MTT = 4/k = 1.01 h; tlag 0. The ps scalar stays 1 (no sourced rate
// observable; the what-if scan D-E1 of the test is a diagnostic: Dose/Cmax is a volume-type observable). Gut variant:
// evr_gut() = 0 (all-organ Kp scalar); the gut-unscaled variant cannot reproduce the Tmax (k at its bound, Tmax 4.0 h, gut-wall
// Kp 173) and is rejected. The legacy entry points (evr_drug_into, evr_cfg, ...) keep the first-order record.
// evr_drug_into_gf / _gfu take the declared F (0.16 UNSOURCED, sensitivity only); a record refitted at s = 1 resets the ps scalar.
//
// FIRST PASS MAINLY INTESTINAL: label: substrate of CYP3A and P-gp; in this record Eh = CL(blood)/Q_h is about
// 2 %, so F = 0.16 comes from the gut wall. Evidence from interactions (label; Kovarik 2006 Biopharm Drug Dispos
// 27:421, PMID 16955532, AB): ketoconazole raises AUC 15-fold with Cmax 3.9-fold and the half-life only 1.9-fold.

use darwin_pbpk::circ28::*
use darwin_pbpk::circ28_kp::*
use darwin_pbpk::circ28_drug::*
use darwin_pbpk::circ28_blood::*
use darwin_pbpk::circ28_nl::*
use darwin_pbpk::circ28_drug_sirolimus::*
use math::pure::{exp, ln}

pub fn evr_mw() -> f64 { return 958.2 }
pub fn evr_logp() -> f64 { return 4.3 + (5.9 - 6.0) }
pub fn evr_u_logp() -> f64 { return 0.5 }
pub fn evr_fu() -> f64 { return 1.0 - 0.735 }
pub fn evr_u_fu() -> f64 { return 0.024 / 2.8284271247461903 }

// Binding constants from the two label endpoints (plasma share 0.17 at 5 ng/mL, 0.73 at 5000 ng/mL of blood).
// Concentrations in mg/L. cp_i = fp_i cb_i/(1 - Hct); bound_i = cb_i (1 - fp_i) = Hct Bmax cp_i/(Kd + cp_i).
pub fn evr_cp_lo() -> f64 { return 0.17 * 0.005 / (1.0 - mtor_hct()) }
pub fn evr_cp_hi() -> f64 { return 0.73 * 5.0 / (1.0 - mtor_hct()) }
pub fn evr_kd() -> f64 {
    let b1 = 0.005 * (1.0 - 0.17)
    let b2 = 5.0 * (1.0 - 0.73)
    let r = b1 / b2
    return evr_cp_lo() * evr_cp_hi() * (1.0 - r) / (r * evr_cp_hi() - evr_cp_lo())
}
pub fn evr_bmax() -> f64 {
    let b2 = 5.0 * (1.0 - 0.73)
    return b2 * (evr_kd() + evr_cp_hi()) / (mtor_hct() * evr_cp_hi())
}
pub fn evr_u_bmax() -> f64 { return 0.3 * evr_bmax() }
pub fn evr_u_kd() -> f64 { return 0.3 * evr_kd() }
pub fn evr_fa() -> f64 { return 1.0 }
pub fn evr_u_fa() -> f64 { return 0.115 }
pub fn evr_f() -> f64 { return 0.16 }
pub fn evr_u_f() -> f64 { return 0.05 }
// default ps scalar and the judgment band to the sirolimus value
pub fn evr_ps() -> f64 { return 1.0 }
pub fn evr_u_ps() -> f64 { return (1.0 - 0.138) / 3.4641016151377544 }

// pooled apparent clearance (L/h) of healthy subjects, 2 mg: Dose/AUC, SD = (SD_AUC/AUC) x Dose/AUC
pub fn evr_pool_clf(a: &!MtorPool) with Mut {
    mtor_pool_add(a, 2.0 / 0.090, (23.0 / 90.0) * 2.0 / 0.090, 12.0)
    mtor_pool_add(a, 2.0 / 0.116, (37.0 / 116.0) * 2.0 / 0.116, 16.0)
    mtor_pool_add(a, 2.0 / 0.115, (45.0 / 115.0) * 2.0 / 0.115, 16.0)
    mtor_pool_add(a, 2.0 / 0.114, (50.0 / 114.0) * 2.0 / 0.114, 18.0)
    mtor_pool_add(a, 19.4, 5.8, 8.0)
}

// pooled terminal half-life (h)
pub fn evr_pool_thalf(a: &!MtorPool) with Mut {
    mtor_pool_add(a, 30.0, 4.0, 12.0)
    mtor_pool_add(a, 32.0, 6.0, 16.0)
    mtor_pool_add(a, 32.0, 6.0, 16.0)
    mtor_pool_add(a, 43.0, 18.0, 8.0)
    mtor_pool_add(a, 32.0, 0.0, 12.0)
}

// pooled Cmax (mg/L) after 2 mg in healthy subjects, k = 4 (a VALIDATION observable, never fitted):
// 15 +/- 4 (n 12), 20 +/- 5 (16), 21 +/- 8 (16), 15 +/- 6 (18) ng/mL
pub fn evr_pool_cmax(a: &!MtorPool) with Mut {
    mtor_pool_add(a, 0.015, 0.004, 12.0)
    mtor_pool_add(a, 0.020, 0.005, 16.0)
    mtor_pool_add(a, 0.021, 0.008, 16.0)
    mtor_pool_add(a, 0.015, 0.006, 18.0)
}

pub fn evr_obs_clf() -> f64 with Mut, Div {
    var a = mtor_pool_zero()
    evr_pool_clf(&!a)
    return mtor_pool_mean(&a)
}
pub fn evr_u_clf() -> f64 with Mut, Div {
    var a = mtor_pool_zero()
    evr_pool_clf(&!a)
    return mtor_pool_u(&a)
}
pub fn evr_obs_thalf() -> f64 with Mut, Div {
    var a = mtor_pool_zero()
    evr_pool_thalf(&!a)
    return mtor_pool_mean(&a)
}
pub fn evr_u_thalf() -> f64 with Mut, Div {
    var a = mtor_pool_zero()
    evr_pool_thalf(&!a)
    return mtor_pool_u(&a)
}
pub fn evr_obs_tmax() -> f64 { return 1.5 }
pub fn evr_u_tmax() -> f64 { return 1.0 / 3.4641016151377544 }
// terminal volume (L): (CL/F) t1/2 / ln 2
pub fn evr_vzf() -> f64 with Mut, Div { return evr_obs_clf() * evr_obs_thalf() / 0.6931471805599453 }
// reference blood concentration (mg/L): 2 mg / (Vz/F)
pub fn evr_cref() -> f64 with Mut, Div { return 2.0 / evr_vzf() }

// vssf: the apparent steady-state volume (L) handed in by the half-life fit.
pub fn evr_obs_at(vssf: f64) -> MtorObs with Mut, Div {
    return evr_obs_at_f(vssf, evr_f())
}

// the same with another declared F (the F sensitivity of the test)
pub fn evr_obs_at_f(vssf: f64, f: f64) -> MtorObs with Mut, Div {
    return MtorObs { hct: mtor_hct(), bmax: evr_bmax(), kd: evr_kd(), vss: f * vssf, cl: f * evr_obs_clf(), f: f, cref: evr_cref() }
}

// Single-dose grid: 0.1 h to 3 h, 1 h to 24 h, 8 h to t_end; terminal slope over 48-168 h.
pub fn evr_cfg_n(dose_mg: f64, t_end: f64, ntr: i32) -> MtorDose {
    var dc = evr_cfg(dose_mg, t_end)
    dc.ntr = ntr
    return dc
}

pub fn evr_cfg(dose_mg: f64, t_end: f64) -> MtorDose {
    var dc = mtor_cfg_oral(dose_mg, t_end, 48.0, 168.0)
    dc.dt2 = 1.0
    dc.t2 = 24.0
    dc.dt3 = 8.0
    return dc
}

pub fn evr_measured_record(d: &!Circ28Drug) with Mut, Div, Panic, Epistemic {
    circ28_drug_set(d, CD_MW, evr_mw(), 0.0, CD_STATUS_MEASURED, "PubChem CID 6442177 (958.2)")
    circ28_drug_set(d, CD_LOGP, evr_logp(), evr_u_logp(), CD_STATUS_DERIVED, "no experimental value: sirolimus 4.3 + (XLogP3 5.9 - 6.0); u 0.5 (judgment)")
    circ28_drug_set(d, CD_ION, 0.0, 0.0, CD_STATUS_DERIVED, "neutral macrolide")
    circ28_drug_set(d, CD_FU, evr_fu(), evr_u_fu(), CD_STATUS_MEASURED, "bound 73.5 +/- 2.4 % in 8 healthy controls (Kovarik2001, abstract); label 74 %")
    circ28_drug_set(d, CD_FA, evr_fa(), evr_u_fa(), CD_STATUS_DERIVED, "assumed 1; band [0.6, 1]/sqrt12 (judgment)")
    circ28_drug_set(d, CD_PSGUT, mtor_psgut(), mtor_u_psgut(), CD_STATUS_DERIVED, "SURROGATE: tacrolimus Peff 4.77e-4 cm/s x 6600 cm2 x 3.6 = 11.33 L/h; u = factor-3 band (judgment)")
}

// Terminal half-life (h) of a single 2 mg dose (slope over 48-168 h) when the apparent steady-state volume is
// vssf (L), ps scalar s, absorption rate ka; the closed-form fits are redone. -1 when the fit does not exist.
pub fn evr_thalf_at(th0: [f64; 18], vssf: f64, s: f64, ka: f64, sysn: &!Nl28Sys) -> f64 with Mut, Div, Panic {
    return evr_thalf_at_g(th0, vssf, s, ka, 1, 0, sysn)
}

pub fn evr_thalf_at_g(th0: [f64; 18], vssf: f64, s: f64, ka: f64, ntr: i32, gut: i32, sysn: &!Nl28Sys) -> f64 with Mut, Div, Panic {
    return evr_thalf_at_gf(th0, vssf, s, ka, ntr, gut, evr_f(), sysn)
}

pub fn evr_thalf_at_gf(th0: [f64; 18], vssf: f64, s: f64, ka: f64, ntr: i32, gut: i32, f: f64, sysn: &!Nl28Sys) -> f64 with Mut, Div, Panic {
    var t = th0
    t[CD_PSSC] = s
    let o = evr_obs_at_f(vssf, f)
    t = mtor_fit_g(t, o, gut)
    if !(t[CD_CLINT] > 0.0) { return 0.0 - 1.0 }
    let p = mtor_params(t, gut)
    var dc = evr_cfg_n(2.0, 168.0, ntr)
    dc.ka = ka
    dc.fa = t[CD_FA]
    let r = mtor_run(p, o.hct, o.bmax, o.kd, dc, sysn)
    if !r.ok || !r.fit_ok { return 0.0 - 1.0 }
    return r.thalf
}

// V_ss/F (L) with simulated half-life = target; Illinois on [0.2, 1.3] x Vz/F (the half-life rises with the
// volume). Returns the bound when the target is outside.
pub fn evr_fit_vssf(th0: [f64; 18], target: f64, s: f64, ka: f64, sysn: &!Nl28Sys) -> f64 with Mut, Div, Panic {
    return evr_fit_vssf_g(th0, target, s, ka, 1, 0, sysn)
}

pub fn evr_fit_vssf_g(th0: [f64; 18], target: f64, s: f64, ka: f64, ntr: i32, gut: i32, sysn: &!Nl28Sys) -> f64 with Mut, Div, Panic {
    return evr_fit_vssf_gf(th0, target, s, ka, ntr, gut, evr_f(), sysn)
}

pub fn evr_fit_vssf_gf(th0: [f64; 18], target: f64, s: f64, ka: f64, ntr: i32, gut: i32, f: f64, sysn: &!Nl28Sys) -> f64 with Mut, Div, Panic {
    let warm = evr_thalf_at_gf(th0, 0.2 * evr_vzf(), s, ka, ntr, gut, f, sysn)
    var xa = 0.2 * evr_vzf()
    var xb = 1.3 * evr_vzf()
    var fa = evr_thalf_at_gf(th0, xa, s, ka, ntr, gut, f, sysn) - target
    var fb = evr_thalf_at_gf(th0, xb, s, ka, ntr, gut, f, sysn) - target
    if fa > 0.0 { return xa }
    if fb < 0.0 { return xb }
    var side: i32 = 0
    var x = xa
    var k: i32 = 0
    while k < 30 {
        x = (xa * fb - xb * fa) / (fb - fa)
        let fx = evr_thalf_at_gf(th0, x, s, ka, ntr, gut, f, sysn) - target
        if mtor_abs(fx) < 1.0e-3 { return x }
        if fx < 0.0 {
            xa = x
            fa = fx
            if side == 1 { fb = 0.5 * fb }
            side = 1
        } else {
            xb = x
            fb = fx
            if side == 0 - 1 { fa = 0.5 * fa }
            side = 0 - 1
        }
        k = k + 1
    }
    return x
}

// u of the fitted V_ss/F from u(t1/2): u(t1/2)/|dt1/2/dV| (forward difference, 1 % step).
pub fn evr_u_vssf_at(th0: [f64; 18], vssf: f64, s: f64, ka: f64, sysn: &!Nl28Sys) -> f64 with Mut, Div, Panic {
    return evr_u_vssf_at_g(th0, vssf, s, ka, 1, 0, sysn)
}

pub fn evr_u_vssf_at_g(th0: [f64; 18], vssf: f64, s: f64, ka: f64, ntr: i32, gut: i32, sysn: &!Nl28Sys) -> f64 with Mut, Div, Panic {
    return evr_u_vssf_at_gf(th0, vssf, s, ka, ntr, gut, evr_f(), sysn)
}

pub fn evr_u_vssf_at_gf(th0: [f64; 18], vssf: f64, s: f64, ka: f64, ntr: i32, gut: i32, f: f64, sysn: &!Nl28Sys) -> f64 with Mut, Div, Panic {
    let warm = evr_thalf_at_gf(th0, vssf, s, ka, ntr, gut, f, sysn)
    let t0 = evr_thalf_at_gf(th0, vssf, s, ka, ntr, gut, f, sysn)
    let t1 = evr_thalf_at_gf(th0, 1.01 * vssf, s, ka, ntr, gut, f, sysn)
    let d = mtor_abs(t1 - t0) / (0.01 * vssf)
    if !(d > 0.0) { return 0.0 }
    return evr_u_thalf() / d
}

// The record at ps scalar s (1 = the declared default), WITHOUT ka: returns the fitted V_ss/F (L) and its u.
// ka is solved by the caller in main (mtor_ka_solve) and written by evr_ka_set: on lean_single the Tmax runs made inside a
// module function after the record was written returned wrong values (ka 0.9334 instead of 0.9572, Tmax 1.53 h,
// measured 2026-11-15; the same call from main is right on every engine). Not an engine fix: a workaround.
pub struct EvrFit {
    pub vssf: f64,
    pub u_vssf: f64,
}

pub fn evr_drug_into(d: &!Circ28Drug, s: f64, sysn: &!Nl28Sys) -> EvrFit with Mut, Div, Panic, Epistemic {
    return evr_drug_into_g(d, s, 1, 0, sysn)
}

pub fn evr_drug_into_g(d: &!Circ28Drug, s: f64, ntr: i32, gut: i32, sysn: &!Nl28Sys) -> EvrFit with Mut, Div, Panic, Epistemic {
    return evr_drug_into_gf(d, s, ntr, gut, evr_f(), sysn)
}

// f: the declared oral bioavailability (evr_f() = 0.16, UNSOURCED; another value only for the sensitivity of the test)
pub fn evr_drug_into_gf(d: &!Circ28Drug, s: f64, ntr: i32, gut: i32, f: f64, sysn: &!Nl28Sys) -> EvrFit with Mut, Div, Panic, Epistemic {
    return evr_drug_into_gfu(d, s, ntr, gut, f, 1, sysn)
}

// withu = 0: the u of the fitted V_ss/F is not computed (three runs saved; the what-if records of the test do not use it)
pub fn evr_drug_into_gfu(d: &!Circ28Drug, s: f64, ntr: i32, gut: i32, f: f64, withu: i32, sysn: &!Nl28Sys) -> EvrFit with Mut, Div, Panic, Epistemic {
    evr_measured_record(d)
    var ka_fit = 2.0
    if ntr > 1 { ka_fit = 4.0 }
    let th0 = circ28_drug_theta(d)
    // the half-life does not depend on ka to the tolerance of the fit (asserted by the test): ka 2 /h here
    let x = evr_fit_vssf_gf(th0, evr_obs_thalf(), s, ka_fit, ntr, gut, f, sysn)
    var ux = 0.0
    if withu == 1 { ux = evr_u_vssf_at_gf(th0, x, s, ka_fit, ntr, gut, f, sysn) }
    let o = evr_obs_at_f(x, f)
    let a = f * ux
    let b = evr_u_f() * x
    let c = f * evr_u_clf()
    let e = evr_u_f() * evr_obs_clf()
    if s < 1.0 {
        circ28_drug_set(d, CD_PSSC, s, evr_u_ps(), CD_STATUS_DERIVED, "WHAT-IF: the ps scalar fitted for sirolimus, transferred")
    } else {
        // a record refitted at s = 1 after a what-if must not keep the earlier scalar (found in the round "transit": the F sensitivity ran on a
        // record that still carried ps scalar 0.001)
        circ28_drug_set(d, CD_PSSC, 1.0, 0.0, CD_STATUS_UNUSED, "default")
    }
    mtor_fit_record_g(d, o, cd_sqrt(a * a + b * b), cd_sqrt(c * c + e * e), evr_u_f(), gut)
    return EvrFit { vssf: x, u_vssf: ux }
}

// Writes ka (fitted by the caller with mtor_ka_solve against Tmax 1.5 h) and its u = u(Tmax)/|dTmax/dka|.
// The SOLVE is made by the caller, in main, on parameters read from the record there: on lean_single every ka solve
// made inside a module function after the record had been written returned 0.9334 (Tmax 1.53 h) instead of 0.9572
// (measured 2026-11-15, five variants tried: a second solve, a dropped first read of the record, a dropped warm-up
// run, both; none cured it; the same solve written in main is right on the three engines). Cause not found:
// reported as an engine observation, worked around, not fixed.
pub fn evr_ka_set(d: &!Circ28Drug, ka: f64, sysn: &!Nl28Sys) with Mut, Div, Panic, Epistemic {
    evr_ka_set_g(d, ka, 1, 0, sysn)
}

pub fn evr_ka_set_g(d: &!Circ28Drug, ka: f64, ntr: i32, gut: i32, sysn: &!Nl28Sys) with Mut, Div, Panic, Epistemic {
    let th = circ28_drug_theta(d)
    let p = mtor_params(th, gut)
    let t0 = mtor_tmax_at_n(p, mtor_hct(), evr_bmax(), evr_kd(), 2.0, th[CD_FA], ka, ntr, sysn)
    let t1 = mtor_tmax_at_n(p, mtor_hct(), evr_bmax(), evr_kd(), 2.0, th[CD_FA], 1.01 * ka, ntr, sysn)
    var uk = 0.0
    if mtor_abs(t1 - t0) > 0.0 { uk = evr_u_tmax() / (mtor_abs(t1 - t0) / (0.01 * ka)) }
    circ28_drug_set(d, CD_KA, ka, uk, CD_STATUS_FITTED, "fitted to Tmax 1.5 h (label: 1 to 2 hours); u = u(Tmax)/|dTmax/dka|")
}

// ADOPTED configuration of the module (round "transit"): Erlang stages of the oral input (n = 3 transit compartments declared +
// 1 = 4 stages; no sourced n for everolimus either) and the gut variant decided by the test (0: all-organ Kp scalar).
pub fn evr_ntr() -> i32 { return 4 }
pub fn evr_gut() -> i32 { return 0 }

// Budget inputs (index 7 is the V_ss/F fitted to the half-life) and their standard uncertainties.
pub fn evr_z0(thb: [f64; 18], vssf: f64) -> [f64; 12] with Mut, Div {
    var z: [f64; 12] = [0.0; 12]
    z[0] = thb[CD_LOGP]
    z[1] = thb[CD_FU]
    z[2] = mtor_hct()
    z[3] = evr_bmax()
    z[4] = evr_kd()
    z[5] = thb[CD_PSGUT]
    z[6] = thb[CD_FA]
    z[7] = vssf
    z[8] = evr_obs_clf()
    z[9] = evr_f()
    z[10] = thb[CD_KA]
    z[11] = thb[CD_PSSC]
    return z
}

pub fn evr_u_all(u_vssf: f64, u_ka: f64) -> [f64; 12] with Mut, Div {
    var u: [f64; 12] = [0.0; 12]
    u[0] = evr_u_logp()
    u[1] = evr_u_fu()
    u[2] = mtor_u_hct()
    u[3] = evr_u_bmax()
    u[4] = evr_u_kd()
    u[5] = mtor_u_psgut()
    u[6] = evr_u_fa()
    u[7] = u_vssf
    u[8] = evr_u_clf()
    u[9] = evr_u_f()
    u[10] = u_ka
    u[11] = evr_u_ps()
    return u
}
