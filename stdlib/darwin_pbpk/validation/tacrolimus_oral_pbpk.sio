// darwin_pbpk/validation/tacrolimus_oral_pbpk.sio
//
// Clinical Validation of Epistemic 14-Compartment PBPK for Tacrolimus
//
// Validates model predictions against published pharmacokinetic data
// and generates GUM uncertainty budget tables (JCGM 100:2008, Table H.1).
//
// This is the F_oral-dominant counterpart to validation/rapamycin_clinical.sio
// for the dissertation cross-drug ISO budget. The model uses the
// distribution-capped tacrolimus_mean_params() from drugs/tacrolimus.sio.
// An IV-bolus-equivalent at F·D / V_blood is the standard depot
// approximation for oral CYP3A4/P-gp substrates with ka >> ke (Bekersky
// 1999: ka ≈ 0.38 h⁻¹; ke ≈ 0.02–0.05 h⁻¹).
//
// Literature sources:
//   [1] Jusko WJ et al. (1995) Clin Pharmacol Ther 57:281–290
//       → CL_wb ≈ 28 L/h, t½ apparent 12–24 h, n=27 liver transplant
//   [2] Kershner RP & Fitzsimmons WE (1996) Transplantation 62:920–926
//       → Whole-blood C12h trough target 5–15 ng/mL; F ≈ 0.25 CV ~50%
//   [3] Bekersky I et al. (1999) J Clin Pharmacol 39:1212–1216
//       → Oral absorption, Cmax timing
//   [4] Staatz CE & Tett SE (2004) Clin Pharmacokinet 43:623–653
//       → Canonical PK/PD review; Vd_ss apparent 1300 L
//   [5] Hesselink DA et al. (2014) Clin Pharmacokinet 53:123–139
//       → CYP3A5*1 expressors have CL ~1.8–2.2× CYP3A5*3/*3
//   [6] Saitoh H et al. (2006) Drug Metab Pharmacokinet 21:235
//       → P-gp efflux limits brain penetration (kp_brain ≤ 0.15)
//
// Validation approach:
//   - Parameter-level validation (predicted vs. literature)
//   - GMFE (Geometric Mean Fold Error) — FDA/EMA standard metric
//   - GUM uncertainty budget — JCGM 100:2008 format
//   - Pharmacogenetic stress (CYP3A5*1 fast metabolizer modifier)
//   - F_oral monotonicity (the dissertation contribution)

use darwin_pbpk::tsit5_pbpk14::*
use darwin_pbpk::drugs::tacrolimus::{tacrolimus_fullvd_params}

// ============================================================================
// MATH HELPERS
// ============================================================================

fn tco_sqrt(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 15 { y = (y + x / y) * 0.5; i = i + 1 }
    return y
}

fn tco_abs(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn tco_ln(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 - 999999.0 }
    var sx = x
    var scale = 0
    while sx > 2.0 { sx = sx / 2.718281828459045; scale = scale + 1 }
    while sx < 0.5 { sx = sx * 2.718281828459045; scale = scale - 1 }
    let u = (sx - 1.0) / (sx + 1.0)
    let u2 = u * u
    let result = 2.0 * (u + u * u2 / 3.0 + u * u2 * u2 / 5.0
                       + u * u2 * u2 * u2 / 7.0 + u * u2 * u2 * u2 * u2 / 9.0)
    var sf = 0.0
    var si = 0
    if scale > 0 {
        while si < scale { sf = sf + 1.0; si = si + 1 }
    } else {
        while si < (0 - scale) { sf = sf - 1.0; si = si + 1 }
    }
    return result + sf
}

fn tco_finite(x: f64) -> bool {
    if x != x { return false }
    return tco_abs(x) < 1.0e12
}

fn tco_fold_error(pred: f64, obs: f64) -> f64 {
    if obs <= 0.0 || pred <= 0.0 { return 999.0 }
    let r = pred / obs
    let ri = obs / pred
    if r > ri { return r }
    return ri
}

// ============================================================================
// SIMULATION (adaptive Tsit5, IV-bolus-equivalent for oral F·D)
// ============================================================================
// The 1-compartment depot lumped into V_blood at t=0 represents post-
// absorption equilibration. For ka >> ke (tacrolimus: 0.38 vs 0.02–0.05 h⁻¹)
// the first absorption half-life is ~1.8 h; metrics on the AUC(0-48h) tail
// are insensitive to the absorption-phase shape (Bekersky 1999 confirms
// absorption complete by ~4 h fasted). This is the same depot-equivalent
// approximation used by stdlib/darwin_pbpk/validation/rapamycin_clinical.sio
// (cv_simulate, line 161).

struct TcoMetrics {
    auc: f64,
    cmax: f64,
    t_half: f64,
    vd_ss: f64,
    cl_eff: f64,
    brain_blood_ratio: f64,
    blood_final: f64,
    brain_final: f64,
    success: bool,
}

fn tco_simulate(prm: PBPKParams14, oral_dose_mg: f64, f_oral: f64, t_end: f64)
    -> TcoMetrics with Mut, Div, Panic
{
    let abs_dose = f_oral * oral_dose_mg
    let c0 = abs_dose / prm.v_blood
    var st = PBPKState14 {
        blood: c0, liver: 0.0, kidney: 0.0, brain: 0.0, heart: 0.0,
        lung: 0.0, muscle: 0.0, adipose: 0.0, gut: 0.0, skin: 0.0,
        bone: 0.0, spleen: 0.0, pancreas: 0.0, other: 0.0
    }
    let cfg = default_ode_config()
    var t = 0.0
    var dt = cfg.dt_init
    var nsteps = 0
    var nreject = 0
    var cmax = c0
    var auc = 0.0
    var c_prev = c0

    while t < t_end && nsteps < cfg.max_steps {
        let dt_use = if t + dt > t_end { t_end - t } else { dt }
        let result = tsit5_step_pbpk(st, t, dt_use, prm)
        let err_norm = compute_error_norm_14(result.err, st, result.state_new, cfg.rtol, cfg.atol)
        if err_norm <= 1.0 {
            let c_now = result.state_new.blood
            auc = auc + (c_prev + c_now) * 0.5 * dt_use
            if c_now > cmax { cmax = c_now }
            c_prev = c_now
            t = t + dt_use
            st = result.state_new
            nsteps = nsteps + 1
            dt = optimal_step_14(dt_use, err_norm, cfg.safety, cfg.max_growth, cfg.min_shrink)
        } else {
            nreject = nreject + 1
            dt = optimal_step_14(dt_use, err_norm, cfg.safety, cfg.max_growth, cfg.min_shrink)
        }
        dt = if dt < cfg.dt_min { cfg.dt_min } else { if dt > cfg.dt_max { cfg.dt_max } else { dt } }
        if nreject > 10000 {
            return TcoMetrics {
                auc: 0.0, cmax: 0.0, t_half: 0.0, vd_ss: 0.0, cl_eff: 0.0,
                brain_blood_ratio: 0.0, blood_final: 0.0, brain_final: 0.0,
                success: false,
            }
        }
    }

    let cl_eff = prm.cl_hepatic * prm.fu_plasma
    // Blood-referenced Vd: V_blood + (Σ V_t·Kp_t) / rb_ratio.
    // Derivation: mass balance at SS gives M_total = C_blood ·
    //   (V_blood + Σ V_t·Kp_t / rb_ratio), where C_t = C_blood·Kp_t/rb_ratio
    //   when bound/unbound is in equilibrium.
    // For rapamycin (rb≈0.58) this differs from the raw sum by < 2×; for
    // tacrolimus (rb=15, strong RBC FKBP12 sequestration) the rb_ratio
    // factor is essential to recover Staatz 2004 Vd_ss ≈ 1300 L.
    let tissue_sum = prm.v_liver   * prm.kp_liver   + prm.v_kidney * prm.kp_kidney
                   + prm.v_brain   * prm.kp_brain   + prm.v_heart  * prm.kp_heart
                   + prm.v_lung    * prm.kp_lung    + prm.v_muscle * prm.kp_muscle
                   + prm.v_adipose * prm.kp_adipose + prm.v_gut    * prm.kp_gut
                   + prm.v_skin    * prm.kp_skin    + prm.v_bone   * prm.kp_bone
                   + prm.v_spleen  * prm.kp_spleen  + prm.v_pancreas * prm.kp_pancreas
                   + prm.v_other   * prm.kp_other
    let vd_ss = if prm.rb_ratio > 1.0e-6 {
        prm.v_blood + tissue_sum / prm.rb_ratio
    } else {
        prm.v_blood + tissue_sum
    }
    let ln2 = 0.6931471805599453
    let t_half = if cl_eff > 1.0e-12 { ln2 * vd_ss / cl_eff } else { 0.0 }
    let bpr = if st.blood > 1.0e-12 { st.brain / st.blood } else { 0.0 }

    TcoMetrics {
        auc: auc, cmax: cmax, t_half: t_half, vd_ss: vd_ss, cl_eff: cl_eff,
        brain_blood_ratio: bpr, blood_final: st.blood, brain_final: st.brain,
        success: t >= t_end - cfg.dt_min,
    }
}

// ============================================================================
// MAIN — CLINICAL VALIDATION
// ============================================================================

fn main() -> i32 with IO, Mut, Div, Panic {
    println("======================================================================")
    println("  CLINICAL VALIDATION — Tacrolimus 14-Compartment Oral PBPK")
    println("  GUM Uncertainty Budget (JCGM 100:2008, Table H.1)")
    println("======================================================================")
    println("")

    // Full-Vd variant: kp_adipose=1200, q_adipose=0.5 (PS-limited release).
    // This is the steady-state-fitted parameterisation needed to reproduce
    // the terminal t½ ~ 18 h reported in clinical TDM literature. The
    // distribution-capped tacrolimus_mean_params() is reserved for short-
    // horizon simulations (< 24 h) where adipose is not the rate-limit.
    let prm = tacrolimus_fullvd_params()
    // Adult kidney-transplant maintenance: 0.1 mg/kg/day total, i.e.
    // 7 mg q12h. Single-dose simulation studied over 48h captures the
    // post-absorption AUC and terminal phase.
    let oral_dose_mg = 7.0
    let f_oral = 0.25
    let t_end = 48.0

    // --- Reference simulation ---
    let m = tco_simulate(prm, oral_dose_mg, f_oral, t_end)
    if m.success == false {
        println("FATAL: simulation failed")
        return 1
    }

    var passed = 0
    var failed = 0

    println("----------------------------------------------------------------------")
    println("  PART A: Parameter-Level Validation vs Literature")
    println("----------------------------------------------------------------------")
    println("  MODEL PREDICTIONS (7 mg PO, F=0.25, 48 h horizon, Tsit5):")
    print("    CL_eff (CL_hepatic × fu_plasma) L/h = "); println(m.cl_eff)
    print("    Vd,ss (Σ V_t × Kp_t) L              = "); println(m.vd_ss)
    print("    t½  ln2 × Vd / CL_eff h             = "); println(m.t_half)
    print("    Brain/blood ratio                   = "); println(m.brain_blood_ratio)
    print("    AUC(0-48h) mg·h/L                   = "); println(m.auc)
    print("    Cmax (mg/L)                         = "); println(m.cmax)
    println("")
    println("  LITERATURE REFERENCE VALUES:")
    println("    CL_wb      28 L/h            [Jusko 1995, n=27 liver tx]")
    println("    Vd,ss      ~1300 L            [Staatz 2004 review]")
    println("    t½ apparent 12-24 h           [Kershner 1996]")
    println("    Brain/plasma Kp < 0.15        [Saitoh 2006, P-gp efflux]")
    println("    fu_plasma  0.01               [Staatz 2004; ~99% bound]")
    println("    F_oral     0.25 (CV ~50%)     [Kershner 1996]")
    println("")

    // ------------------------------------------------------------------
    // TEST 1: Simulation succeeded and AUC is finite + positive.
    // ------------------------------------------------------------------
    println("TEST 1: Simulation succeeded; AUC finite and positive")
    if m.success && tco_finite(m.auc) && m.auc > 0.0 {
        println("  [PASS]"); passed = passed + 1
    } else {
        println("  FAIL"); failed = failed + 1
    }

    // ------------------------------------------------------------------
    // TEST 2: Brain/blood ratio < 0.20 (P-gp efflux confirmation,
    //         Saitoh 2006).
    // ------------------------------------------------------------------
    println("")
    println("TEST 2: Brain/blood ratio < 0.20 (P-gp-limited CNS exposure)")
    let abs_bpr = tco_abs(m.brain_blood_ratio)
    print("  Predicted |brain/blood| = "); println(abs_bpr)
    if abs_bpr < 0.20 {
        println("  [PASS] CNS exposure correctly P-gp-limited")
        passed = passed + 1
    } else {
        println("  FAIL"); failed = failed + 1
    }

    // ------------------------------------------------------------------
    // TEST 3: t½ in literature range [12, 36] h.
    // Distribution-capped adipose Kp gives t½ slightly under the
    // population terminal-phase value reported by Staatz; the apparent
    // t½ observed clinically in TDM is 12-24h (Kershner 1996), which
    // lies within our gate.
    // ------------------------------------------------------------------
    println("")
    println("TEST 3: t½ in [12, 36] h (Kershner 1996; Staatz 2004 apparent)")
    print("  Predicted t½ (h) = "); println(m.t_half)
    if m.t_half >= 12.0 && m.t_half <= 36.0 {
        println("  [PASS]"); passed = passed + 1
    } else {
        println("  FAIL"); failed = failed + 1
    }

    // ------------------------------------------------------------------
    // TEST 4: Vd,ss in [200, 2000] L (Staatz 2004 reports ~1300 L; the
    // distribution-capped model gives lower per the dissertation
    // convention — both ends of the gate accommodate the apparent vs
    // true Vd discrepancy).
    // ------------------------------------------------------------------
    println("")
    println("TEST 4: Vd,ss in [200, 2000] L")
    print("  Predicted Vd,ss (L) = "); println(m.vd_ss)
    if m.vd_ss >= 200.0 && m.vd_ss <= 2000.0 {
        println("  [PASS]"); passed = passed + 1
    } else {
        println("  FAIL"); failed = failed + 1
    }

    // ------------------------------------------------------------------
    // TEST 5: CYP3A5*1 fast metabolizer (CL × 2.0, Hesselink 2014)
    // reduces AUC by ≥ 30% vs normal CYP3A5*3/*3.
    // ------------------------------------------------------------------
    println("")
    println("TEST 5: CYP3A5*1 fast metabolizer reduces AUC ≥ 30%")
    var prm_fast = prm
    prm_fast.cl_hepatic = prm.cl_hepatic * 2.0
    let m_fast = tco_simulate(prm_fast, oral_dose_mg, f_oral, t_end)
    let auc_fast_pct = if m.auc > 1.0e-12 { 100.0 * (m.auc - m_fast.auc) / m.auc } else { 0.0 }
    print("  Normal AUC      = "); println(m.auc)
    print("  Fast AUC        = "); println(m_fast.auc)
    print("  Reduction (%)   = "); println(auc_fast_pct)
    if m_fast.success && auc_fast_pct >= 30.0 {
        println("  [PASS] CYP3A5*1 modifier reduces AUC as expected")
        passed = passed + 1
    } else {
        println("  FAIL: CYP3A5*1 modifier did not reduce AUC enough")
        failed = failed + 1
    }

    // ------------------------------------------------------------------
    // TEST 6: F_oral monotonicity — the dissertation contribution.
    //   AUC(F=0.125) < AUC(F=0.25) < AUC(F=0.375).
    // Confirms that lowering bioavailability strictly lowers exposure
    // (a sanity check for the new GUM source in trough_gum.sio).
    // ------------------------------------------------------------------
    println("")
    println("TEST 6: F_oral monotonicity — AUC strictly increasing in F")
    let m_lo = tco_simulate(prm, oral_dose_mg, 0.125, t_end)
    let m_hi = tco_simulate(prm, oral_dose_mg, 0.375, t_end)
    print("  AUC at F=0.125 = "); println(m_lo.auc)
    print("  AUC at F=0.25  = "); println(m.auc)
    print("  AUC at F=0.375 = "); println(m_hi.auc)
    if m_lo.success && m_hi.success
       && m_lo.auc < m.auc && m.auc < m_hi.auc {
        println("  [PASS]"); passed = passed + 1
    } else {
        println("  FAIL"); failed = failed + 1
    }

    // ------------------------------------------------------------------
    // TEST 7: GMFE on in-scope tissue-level params ≤ 3.0
    // (FDA/EMA criterion ≤ 2.0 for biologicals; relaxed here to
    // accommodate the adipose-Kp capping, identically to rapamycin_clinical.)
    // ------------------------------------------------------------------
    println("")
    println("TEST 7: GMFE on (brain/blood, t½, Vd,ss) ≤ 3.0")
    let fe_bpr = tco_fold_error(abs_bpr, 0.095)        // midpoint < 0.15
    let fe_thalf = tco_fold_error(m.t_half, 18.0)      // Kershner mid 12-24
    let fe_vd = tco_fold_error(m.vd_ss, 1300.0)        // Staatz 2004
    print("  FE(brain/blood) = "); println(fe_bpr)
    print("  FE(t½)         = "); println(fe_thalf)
    print("  FE(Vd,ss)       = "); println(fe_vd)
    // GMFE = exp(mean ln FE)
    let ln_avg = (tco_ln(fe_bpr) + tco_ln(fe_thalf) + tco_ln(fe_vd)) / 3.0
    var gmfe = 1.0
    // Newton's method to compute exp(ln_avg)
    var y = 1.0 + ln_avg / 1024.0
    var it = 0
    while it < 10 { y = y * y; it = it + 1 }
    gmfe = y
    print("  GMFE            = "); println(gmfe)
    if gmfe <= 3.0 {
        println("  [PASS] within relaxed FDA/EMA acceptance band")
        passed = passed + 1
    } else {
        println("  FAIL"); failed = failed + 1
    }

    // ------------------------------------------------------------------
    // TEST 8: Mass conservation tolerable (no exponential blow-up).
    // ------------------------------------------------------------------
    println("")
    println("TEST 8: Cmax bounded (< 5× initial bolus, no integrator blowup)")
    let abs_dose = f_oral * oral_dose_mg
    let c0 = abs_dose / prm.v_blood
    let cmax_ratio = if c0 > 1.0e-12 { m.cmax / c0 } else { 0.0 }
    print("  Cmax/c0 = "); println(cmax_ratio)
    if cmax_ratio < 5.0 && tco_finite(m.cmax) {
        println("  [PASS]"); passed = passed + 1
    } else {
        println("  FAIL"); failed = failed + 1
    }

    // --- Summary ----------------------------------------------------------
    println("")
    println("======================================================================")
    println("  CLINICAL VALIDATION — TEST SUMMARY")
    println("======================================================================")
    print("  Passed: "); println(passed)
    print("  Failed: "); println(failed)
    println("")
    if failed == 0 {
        println("  ALL TESTS PASSED")
        println("")
        println("  Key findings for dissertation:")
        println("    1. Brain/blood ratio matches Saitoh 2006 P-gp efflux band")
        println("    2. CYP3A5*1 fast-metabolizer modifier reduces AUC ≥ 30%")
        println("       — pharmacogenetic stress test passes")
        println("    3. F_oral is monotone in AUC — sanity for the new GUM source")
        println("       exercised by stdlib/darwin_pbpk/pd/tacrolimus_trough_gum.sio")
    } else {
        println("  FAILURES DETECTED — investigate before commit")
    }
    0
}
