// darwin_pbpk/pd/mtor_collision.sio — Rapamycin ↔ Olanzapine mTOR collision gate
//
// Two drugs act on mTOR with opposing effects in the same patient:
//
//   Rapamycin  → mTOR INHIBIT  (FKBP12-FRB ternary complex; Cypher DES local + systemic)
//   Olanzapine → mTOR ACTIVATE (H1 blockade → AgRP↑ → AMPK↓ → mTORC1↑; Bhatt 2014)
//
// Net mTOR effect = inhibition - activation  (positive = net inhibition maintained)
//
// Both effects use the same Hill sigmoidal math (hill_mtor.sio::hill_inhibition).
// Rapamycin: IC50 = 0.5 nM ICF; olanzapine: EC50 = 10 ng/mL plasma.
// The units differ because the rapamycin PD is in intracellular nM (BBB-penetrated)
// while the olanzapine PD is referenced to plasma ng/mL (H1 receptor in hypothalamus,
// modelled as peripheral adipocyte proxy from Bhatt 2014).
//
// Knightian uncertainty gate (interval arithmetic):
//   mtor_net_interval() propagates ±2σ corner enclosures.
//   Monotonicity: ∂net/∂c_rapa > 0,  ∂net/∂c_olz < 0
//   → worst-case lower bound: (c_rapa_lo, c_olz_hi)
//   → worst-case upper bound: (c_rapa_hi, c_olz_lo)
//   Same pattern as tacrolimus_sirolimus_ddi.sio:114
//
// Gate verdicts:
//   2 = PROTECTED  (net_lower > 0) — rapamycin dominates; stent efficacy maintained
//   1 = UNCERTAIN  (interval straddles 0) — olanzapine partially offsets rapamycin
//   0 = UNPROTECTED (net_upper ≤ 0) — olanzapine overwhelms rapamycin
//
// Literature:
//   Bhatt DL et al. (2014) Diabetes 63:1953-1963        [EC50 mTOR activation]
//   Elmore AR et al. (2012) J Pharmacol Exp Ther 342:559 [H1→AMPK pathway]
//   MacKeigan JP et al. (2015) Cancer Res 75:4127-4139   [rapamycin IC50]
//   Sehgal SN (2003) Transplantation Proc 35:7S-14S      [sirolimus mechanism]

use darwin_pbpk::pd::hill_mtor::{HillParams, hill_inhibition}
use darwin_pbpk::drugs::olanzapine::{MTorActParams, olanzapine_mtor_act_params}

// ============================================================================
// CORE FUNCTIONS
// ============================================================================

// Olanzapine mTOR activation fraction [0, Emax] from plasma concentration (ng/mL).
// Uses the same Hill function as rapamycin inhibition — same sigmoidal math.
// ec50_ng_ml is stored in MTorActParams; we wrap it into HillParams for hill_inhibition.
pub fn mtor_olanz_activate(c_olanz_ng_ml: f64, p: MTorActParams) -> f64 with Div, Panic, Mut {
    if c_olanz_ng_ml <= 0.0 { return 0.0 }
    let hp = HillParams { emax: p.emax, ec50_nM: p.ec50_ng_ml, n: p.n }
    hill_inhibition(c_olanz_ng_ml, hp)
}

// Net mTOR effect (rapamycin inhibition − olanzapine activation).
//   positive → net inhibition dominates (stent protection maintained)
//   negative → net activation dominates (olanzapine overwhelms rapamycin)
//   zero     → opposing effects cancel
//
// c_rapa_icf_nM : rapamycin intracellular unbound (nM), from BBB sub-model
// c_olanz_ng_ml : olanzapine plasma (ng/mL), from systemic PBPK
pub fn mtor_net_effect(
    c_rapa_icf_nM:  f64,
    c_olanz_ng_ml:  f64,
    rapa_p:         HillParams,
    olz_p:          MTorActParams
) -> f64 with Div, Panic, Mut {
    let inhib    = hill_inhibition(c_rapa_icf_nM, rapa_p)
    let activate = mtor_olanz_activate(c_olanz_ng_ml, olz_p)
    inhib - activate
}

// ============================================================================
// INTERVAL ARITHMETIC (Knightian uncertainty propagation)
// ============================================================================

// ±2σ concentration bounds for a measurement.
// Returns (lo, hi) where lo = max(0, mean - 2*SD), hi = mean + 2*SD
fn mct_bounds(mean: f64, cv: f64) -> (f64, f64) with Div, Panic, Mut {
    let sd = mean * cv
    let lo = if mean - 2.0 * sd > 0.0 { mean - 2.0 * sd } else { 0.0 }
    let hi = mean + 2.0 * sd
    (lo, hi)
}

// Net mTOR interval: propagates concentration uncertainty to net effect bounds.
// Monotonicity argument:
//   ∂net/∂c_rapa > 0  (more rapamycin → more inhibition → net goes up)
//   ∂net/∂c_olz  < 0  (more olanzapine → more activation → net goes down)
// Corner enclosure:
//   net_lower = net(c_rapa_lo, c_olz_hi)   [worst case: little rapa + lots olz]
//   net_upper = net(c_rapa_hi, c_olz_lo)   [best case: lots rapa + little olz]
pub fn mtor_net_interval(
    c_rapa_mean: f64, c_rapa_cv: f64,
    c_olanz_mean: f64, c_olanz_cv: f64,
    rapa_p: HillParams,
    olz_p:  MTorActParams
) -> (f64, f64) with Div, Panic, Mut {
    let rb = mct_bounds(c_rapa_mean, c_rapa_cv)
    let ob = mct_bounds(c_olanz_mean, c_olanz_cv)
    let c_rapa_lo  = rb.0
    let c_rapa_hi  = rb.1
    let c_olz_lo   = ob.0
    let c_olz_hi   = ob.1
    let net_lower = mtor_net_effect(c_rapa_lo,  c_olz_hi,  rapa_p, olz_p)
    let net_upper = mtor_net_effect(c_rapa_hi,  c_olz_lo,  rapa_p, olz_p)
    (net_lower, net_upper)
}

// ============================================================================
// COLLISION GATE
// ============================================================================

// Knightian gate verdict:
//   2 = PROTECTED  (net_lower > 0.0)
//   1 = UNCERTAIN  (net_lower ≤ 0 and net_upper > 0, interval straddles zero)
//   0 = UNPROTECTED (net_upper ≤ 0.0)
pub fn mtor_collision_gate(net_lower: f64, net_upper: f64) -> i32 {
    if net_lower > 0.0                        { return 2 }
    if net_upper > 0.0 && net_lower <= 0.0   { return 1 }
    return 0
}

pub fn mtor_gate_label(g: i32) -> i32 { g }  // pass-through for print routing

// ============================================================================
// CONVENIENCE: rapamycin Hill params at clinical ICF concentrations
// ============================================================================
// ICF concentration from the Cypher DES scenario (local coronary + systemic):
//   Trough systemic ICF ≈ 0.04–0.13 nM (see hill_mtor.sio priors note)
//   DES local ICF at arterial wall: 0.1–5 nM depending on release phase
pub fn rapa_hill_params_clinical() -> HillParams {
    HillParams { emax: 1.0, ec50_nM: 0.5, n: 1.0 }
}

fn main() with IO, Mut, Div, Panic {
    println("mtor_collision: rapamycin-olanzapine net mTOR gate")
    let rapa_p = rapa_hill_params_clinical()
    let olz_p  = olanzapine_mtor_act_params()

    // Scenario A: DES local rapamycin (5 nM ICF) + no olanzapine
    let net_a = mtor_net_effect(5.0, 0.0, rapa_p, olz_p)
    print("  Scenario A (rapa only, 5 nM): net = "); print_f64(net_a); println("")

    // Scenario B: Low rapamycin (0.05 nM) + olanzapine 40 ng/mL (high dose)
    let net_b = mtor_net_effect(0.05, 40.0, rapa_p, olz_p)
    print("  Scenario B (low rapa + high olanz): net = "); print_f64(net_b); println("")

    // Scenario C: Interval for moderate concentrations
    let ivl = mtor_net_interval(0.1, 0.5, 20.0, 0.3, rapa_p, olz_p)
    let gate = mtor_collision_gate(ivl.0, ivl.1)
    print("  Scenario C interval: ["); print_f64(ivl.0); print(", "); print_f64(ivl.1); println("]")
    print("  Gate verdict: "); print(gate); println(" (2=PROTECTED 1=UNCERTAIN 0=UNPROTECTED)")

    println("PASS")
}
