// darwin_pbpk/pgx/cyp2d6_haloperidol.sio — CYP2D6 pharmacogenomics for haloperidol
//
// CYP2D6 is the primary metaboliser of haloperidol (~55% fm_cyp2d6).
// Phenotype classification uses the activity score system (Gaedigk 2017).
// Haloperidol-specific CL scaling from Bertilsson 2002 (n=39 schizophrenia patients):
//
//   PM  (activity score ≤0.25): CL×0.25 → plasma 4× normal → D2 > 80% → EPS
//   IM  (0.25 < score ≤0.75):   CL×0.50 → plasma 2× normal → D2 high-normal
//   NM  (0.75 < score ≤1.5):    CL×1.00 → reference population
//   UM  (score > 1.5):          CL×2.50 → plasma 0.4× normal → D2 < 60% → failure
//
// The CL multiplier is applied only to the CYP2D6 fraction of clearance (fm=0.55),
// keeping the CYP3A4 fraction (fm=0.45) at baseline:
//
//   CL_adjusted = CL_base * (1 - fm) + CL_base * fm * scale(phenotype)
//
// European population allele frequencies (Gaedigk 2017 meta-analysis, n>28000):
//   PM:  ~8%  (CYP2D6 *4/*4 and similar null-activity diplotypes)
//   IM: ~20%  (one functional + one reduced-activity allele)
//   NM: ~65%  (two functional alleles — reference)
//   UM:  ~7%  (gene duplication or extra copy)
//
// Literature:
//   Bertilsson L et al. (2002) Br J Clin Pharmacol 53:553-556
//   Gaedigk A et al. (2017) Clin Pharmacol Ther 101:515-528
//   Tyndale RF et al. (1991) J Pharmacol Exp Ther 256:891-899 [fm_cyp2d6=0.55]
//   Dahl ML et al. (1991) Br J Clin Pharmacol 32:764-768 [PM concentration ratio]

// Phenotype integer codes (consistent with stdlib/pbpk/covariate.sio)
//   0 = PM (poor metaboliser)
//   1 = IM (intermediate)
//   2 = NM (normal)
//   3 = UM (ultra-rapid)

pub fn halo_cyp2d6_pheno_from_score(score: f64) -> i32 {
    if score <= 0.25 { return 0 }
    if score <= 0.75 { return 1 }
    if score <= 1.5  { return 2 }
    return 3
}

// Haloperidol-specific CL scaling factor per phenotype (Bertilsson 2002).
// These are DIFFERENT from covariate.sio's generic values (which use PM=0.10).
pub fn halo_cyp2d6_cl_scale(pheno: i32) -> f64 {
    if pheno == 0 { return 0.25 }   // PM: 75% CL reduction
    if pheno == 1 { return 0.50 }   // IM: 50% CL reduction
    if pheno == 3 { return 2.50 }   // UM: 150% CL increase
    return 1.0                       // NM (default)
}

// Adjusted hepatic clearance: blend CYP2D6-mediated and other pathways.
//   fm_cyp2d6 = 0.55 for haloperidol (Tyndale 1991)
//   CL_adj = CL_base * (1 - fm) + CL_base * fm * scale
pub fn halo_cyp2d6_adjusted_cl(base_cl: f64, pheno: i32) -> f64 with Div, Panic {
    let fm: f64 = 0.55
    let scale = halo_cyp2d6_cl_scale(pheno)
    let cl_other = base_cl * (1.0 - fm)
    let cl_2d6   = base_cl * fm * scale
    cl_other + cl_2d6
}

// Epistemic confidence for the CL scaling estimate per phenotype.
// PM and UM have higher uncertainty (fewer patients, extremes of distribution).
pub fn halo_cyp2d6_prior_conf(pheno: i32) -> f64 {
    if pheno == 0 { return 0.55 }   // PM: n≈3 per typical study, CV=40%
    if pheno == 1 { return 0.60 }   // IM: moderate data, CV=25%
    if pheno == 3 { return 0.55 }   // UM: few subjects, CV=30%
    return 0.75                      // NM: well-characterised reference
}

// CV (coefficient of variation) for the CL uncertainty by phenotype.
// Used to construct GUM variance: var = (CL * CV)^2
pub fn halo_cyp2d6_cl_cv(pheno: i32) -> f64 {
    if pheno == 0 { return 0.40 }
    if pheno == 1 { return 0.25 }
    if pheno == 3 { return 0.30 }
    return 0.20
}

// European population allele frequency for categorical sampling in pop PBPK/PD.
// Returns cumulative lower boundary for [0,1) uniform variate:
//   [0.00, 0.08) → PM
//   [0.08, 0.28) → IM
//   [0.28, 0.93) → NM
//   [0.93, 1.00) → UM
pub fn halo_cyp2d6_freq_european(pheno: i32) -> f64 {
    if pheno == 0 { return 0.08 }   // PM frequency
    if pheno == 1 { return 0.20 }   // IM frequency
    if pheno == 2 { return 0.65 }   // NM frequency
    if pheno == 3 { return 0.07 }   // UM frequency
    return 0.0
}

// Sample CYP2D6 phenotype from uniform variate u in [0, 1).
// Returns phenotype code 0..3.
pub fn halo_cyp2d6_sample(u: f64) -> i32 {
    if u < 0.08 { return 0 }   // PM: [0.00, 0.08)
    if u < 0.28 { return 1 }   // IM: [0.08, 0.28)
    if u < 0.93 { return 2 }   // NM: [0.28, 0.93)
    return 3                    // UM: [0.93, 1.00)
}

// Phenotype name as integer code for print formatting (0=PM,1=IM,2=NM,3=UM).
pub fn halo_cyp2d6_pheno_label(pheno: i32) -> i32 { pheno }

fn main() with IO, Mut, Div, Panic {
    println("cyp2d6_haloperidol: phenotype-stratified CL scaling")
    println("  PM scale:"); print_f64(halo_cyp2d6_cl_scale(0)); println("")
    println("  IM scale:"); print_f64(halo_cyp2d6_cl_scale(1)); println("")
    println("  NM scale:"); print_f64(halo_cyp2d6_cl_scale(2)); println("")
    println("  UM scale:"); print_f64(halo_cyp2d6_cl_scale(3)); println("")
    let base_cl: f64 = 40.0
    println("  NM adjusted CL (base=40):"); print_f64(halo_cyp2d6_adjusted_cl(base_cl, 2)); println("")
    println("  PM adjusted CL (base=40):"); print_f64(halo_cyp2d6_adjusted_cl(base_cl, 0)); println("")
    println("  UM adjusted CL (base=40):"); print_f64(halo_cyp2d6_adjusted_cl(base_cl, 3)); println("")
    println("PASS")
}
