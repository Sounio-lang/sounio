// darwin_pbpk/pgx/cyp2d6_venlafaxine.sio — CYP2D6 pharmacogenomics for venlafaxine
//
// Venlafaxine is metabolised primarily to active O-desmethylvenlafaxine (ODV)
// via CYP2D6. The ODV/parent steady-state concentration ratio is the
// dissertation PD-equivalent readout for this drug (no separate receptor model).
//
// Phenotype ratios (ODV/parent Css) used as the reference series:
//   EM (NM): 3.45
//   IM:      1.16
//   PM:      0.25
//   UM:      10.3
//
// UNSOURCED. These were attributed to "Kirchheiner et al. 2006, Ther Drug Monit
// 28:493-502; CPIC venlafaxine evidence table". That paper does not exist
// (Kirchheiner has no venlafaxine PK paper); pages 493-502 belong to Shams ME et
// al. 2006, J Clin Pharm Ther 31(5):493-502, PMID 16958828,
// doi:10.1111/j.1365-2710.2006.00763.x, which reports median ODV/V 1.8
// (10th-90th pct 0.3-5.2), PM < 0.3, IM 1.1 ± 0.8, UM > 5.2 — not these values.
// CPIC 2023 (PMID 37032427) publishes no numeric ODV/VEN series at all: 3.45 and
// 10.3 have zero occurrences in its text or its 165-page supplement. No published
// source for the quadruple has been found; the upper three bins are a geometric
// ladder (x2.974, x2.986), which measured TDM data do not produce.
// Full forensics: docs/audit/VENLAFAXINE_ODV_RATIO_CITATION_FORENSICS_2026-09-26.md
// Real anchors: Nichols AI et al. 2011, Clin Drug Investig 31(3):155-67,
// PMID 21288052 — ODV:V AUC(inf) 6.2 (EM) vs 0.21 (PM), ER 75 mg single dose.
//
// The phenotype scale below is DEFINED from these ratios (s = r/3.45), so a model
// that reproduces them through this scale is not independent evidence for them.
// Replacing them moves CL_form and the dissertation readout: operator decision.
//
// Normalised to NM = 1.0:
//   PM ≈ 0.072, IM ≈ 0.336, UM ≈ 2.99
//
// CYP2D6-mediated formation clearance at NM: CL_form_ODV ≈ 43 L/h vs total oral
// CL ≈ 100 L/h in EMs. source: Lessard E et al. 1999, Pharmacogenetics
// 9(4):435-43, PMID 10780263 (previously mis-cited as "Klamerus 1999"). Both are
// oral (apparent) clearances, not systemic ones.
//
// Phenotype codes: 0=PM, 1=IM, 2=NM, 3=UM (darwin_pbpk convention).

pub fn vfx_cyp2d6_pheno_from_score(score: f64) -> i32 {
    if score <= 0.25 { return 0 }
    if score <= 0.75 { return 1 }
    if score <= 1.5  { return 2 }
    return 3
}

// ODV/parent Css ratio at steady state. Values unsourced (see header).
pub fn vfx_odv_parent_ratio_literature(pheno: i32) -> f64 {
    if pheno == 0 { return 0.25 }
    if pheno == 1 { return 1.16 }
    if pheno == 3 { return 10.3 }
    return 3.45
}

// Normalised to extensive (NM) metaboliser = 1.0.
pub fn vfx_odv_parent_ratio_norm(pheno: i32) -> f64 with Div, Panic {
    let ref_em = 3.45
    return vfx_odv_parent_ratio_literature(pheno) / ref_em
}

// CYP2D6 formation clearance scale relative to NM.
// Anchored to the unsourced ODV/parent Css ratios above (EM=3.45 reference).
pub fn vfx_cyp2d6_cl_form_scale(pheno: i32) -> f64 with Div, Panic {
    return vfx_odv_parent_ratio_norm(pheno)
}

// NM reference formation clearance to ODV (L/h). source: Lessard 1999 (oral/apparent)
pub fn vfx_cl_form_odv_nm() -> f64 { return 43.0 }

pub fn vfx_cl_form_odv_adjusted(pheno: i32) -> f64 with Div, Panic {
    return vfx_cl_form_odv_nm() * vfx_cyp2d6_cl_form_scale(pheno)
}

// Total parent oral clearance at NM (L/h). source: Lessard 1999 (oral/apparent)
pub fn vfx_cl_parent_oral_nm() -> f64 { return 100.0 }

// Parent total oral CL weakly phenotype-dependent per FDA label (sum V+ODV similar);
// formation fraction carries the primary CYP2D6 effect in this scenario.
pub fn vfx_cl_parent_oral_adjusted(pheno: i32) -> f64 with Div, Panic {
    if pheno == 0 { return 70.0 }
    if pheno == 3 { return 110.0 }
    return vfx_cl_parent_oral_nm()
}