// darwin_pbpk/pgx/drd2_taq1a.sio — DRD2 TaqI A polymorphism → striatal Bmax
//
// The DRD2 TaqI A SNP (rs1800497, actually in the ANKK1 gene flanking DRD2)
// is associated with reduced striatal D2 receptor density. A1-allele carriers
// show ~7-10% lower Bmax in PET studies compared to A2A2 homozygotes.
//
// PET-derived Bmax values (Hall 1994, n=45, [11C]raclopride striatum):
//   A1A1: ~28 nM  (homozygous A1: lowest density)
//   A1A2: ~29 nM  (heterozygous: intermediate)
//   A2A2: ~30 nM  (homozygous A2: reference)
//
// Clinical pharmacology implication:
//   At the same ISF concentration, lower Bmax → HIGHER fractional occupancy.
//   A1A1 patients reach the EPS threshold (>80% occ) at a lower haloperidol dose
//   than A2A2 patients, assuming equivalent PK.
//
// Bmax conversion to mg/L (for use with d2_occupancy.sio):
//   bmax_mgL = bmax_nM × MW_haloperidol × 1e-6
//   MW_haloperidol = 375.86 g/mol
//   A2A2: 30 nM × 375.86 × 1e-6 = 0.011276 mg/L  (matches haloperidol_d2_params)
//   A1A2: 29 nM × 375.86 × 1e-6 = 0.010900 mg/L
//   A1A1: 28 nM × 375.86 × 1e-6 = 0.010524 mg/L
//
// Note: Bmax does NOT affect fractional occupancy (occ = C / (C + Kd)) but DOES
// affect absolute bound receptor concentration (d2_bound). The gatekeeping PD
// endpoint for EPS is fractional occupancy, so this genotype effect is second-order
// compared to CYP2D6 (which changes C directly). It becomes significant when
// combining with CYP2D6 PM (high C → high occ × low Bmax threshold crossover).
//
// European population allele frequencies:
//   A1A1: ~5%    (rare homozygous)
//   A1A2: ~28%   (heterozygous carrier)
//   A2A2: ~67%   (majority)
//
// Literature:
//   Hall H et al. (1994) Neuropsychopharmacology 10:71-80  [PET Bmax values]
//   Grandy DK et al. (1989) Am J Hum Genet 45:778-785     [TaqI A description]
//   Noble EP (2003) Metabolic Brain Disease 18:1-22        [allele frequencies]

// Allele codes:
//   0 = A1A1 (homozygous A1, lowest Bmax)
//   1 = A1A2 (heterozygous)
//   2 = A2A2 (homozygous A2, reference)

// Bmax in nM by allele.
pub fn drd2_bmax_nM(allele: i32) -> f64 {
    if allele == 0 { return 28.0 }   // A1A1
    if allele == 1 { return 29.0 }   // A1A2
    return 30.0                       // A2A2 (default)
}

// Bmax in mg/L: bmax_nM × mw_g_mol × 1e-6
pub fn drd2_bmax_mgL(allele: i32, mw_g_mol: f64) -> f64 with Div, Panic {
    let nM = drd2_bmax_nM(allele)
    nM * mw_g_mol * 1.0e-6
}

// Epistemic confidence for the Bmax estimate.
// A2A2: backed by largest subgroup in Hall 1994.
pub fn drd2_prior_conf(allele: i32) -> f64 {
    if allele == 0 { return 0.55 }   // A1A1: small n, single study
    if allele == 1 { return 0.60 }   // A1A2: moderate n
    return 0.65                       // A2A2: largest subgroup
}

// CV for Bmax uncertainty (inter-individual + measurement).
// Hall 1994: CV ~15% within each genotype group.
pub fn drd2_bmax_cv(allele: i32) -> f64 {
    if allele == 0 { return 0.18 }   // A1A1: slightly wider (smaller n)
    if allele == 1 { return 0.15 }   // A1A2
    return 0.15                       // A2A2
}

// European population frequency for categorical sampling.
pub fn drd2_freq_european(allele: i32) -> f64 {
    if allele == 0 { return 0.05 }   // A1A1
    if allele == 1 { return 0.28 }   // A1A2
    if allele == 2 { return 0.67 }   // A2A2
    return 0.0
}

// Sample DRD2 TaqI A allele from uniform variate u in [0, 1).
pub fn drd2_sample(u: f64) -> i32 {
    if u < 0.05 { return 0 }    // A1A1: [0.00, 0.05)
    if u < 0.33 { return 1 }    // A1A2: [0.05, 0.33)
    return 2                     // A2A2: [0.33, 1.00)
}

fn main() with IO, Div, Panic {
    let mw: f64 = 375.86
    println("drd2_taq1a: DRD2 receptor density by TaqI A allele")
    println("  A1A1 Bmax mg/L:"); print_f64(drd2_bmax_mgL(0, mw)); println("")
    println("  A1A2 Bmax mg/L:"); print_f64(drd2_bmax_mgL(1, mw)); println("")
    println("  A2A2 Bmax mg/L:"); print_f64(drd2_bmax_mgL(2, mw)); println("")
    println("PASS")
}
