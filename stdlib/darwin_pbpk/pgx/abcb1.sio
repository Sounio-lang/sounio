// darwin_pbpk/pgx/abcb1.sio — ABCB1/MDR1 C3435T polymorphism → BBB ps_bbb scaling
//
// ABCB1 (MDR1) encodes P-glycoprotein (P-gp), the main efflux transporter at the
// blood-brain barrier. The C3435T SNP (rs1045642) is a synonymous variant that
// affects P-gp expression level and/or folding:
//
//   CC genotype: reference P-gp expression (TT/CT vs CC calibrated)
//   CT genotype: ~15% reduced P-gp expression → ps_bbb×1.15
//   TT genotype: ~30% reduced P-gp expression → ps_bbb×1.30
//
// For haloperidol: net brain accumulation (Kpuu_brain=3.0) means P-gp efflux is
// already overcome by lysosomal trapping. The ABCB1 effect modulates ps_bbb (influx
// permeability surface area), consistent with reduced efflux meaning faster net
// accumulation in ISF (higher effective ps_bbb).
//
// Note: same transporter that limits rapamycin CNS entry (kp_brain=0.08). In the
// rapamycin context P-gp dominates; in haloperidol context lysosomal trapping
// dominates. The ABCB1 effect on ps_bbb is mechanistically consistent for both.
//
// European population genotype frequencies (Hardy-Weinberg, MAF≈0.43):
//   CC: ~40%
//   CT: ~42%
//   TT: ~18%
//
// Literature:
//   Marzolini C et al. (2004) Pharmacogenetics 14:145-156  [clinical effect sizes]
//   Kim RB et al. (2001) Clin Pharmacol Ther 70:189-199    [MDR1 polymorphisms]
//   Schinkel AH (1999) Adv Drug Deliv Rev 36:179-194       [P-gp BBB role]

// Genotype integer codes:
//   0 = CC (homozygous reference)
//   1 = CT (heterozygous)
//   2 = TT (homozygous variant, lowest P-gp)

// ps_bbb scaling factor: TT genotype → ~30% reduced P-gp → 30% more net influx.
pub fn abcb1_psbbb_scale(genotype: i32) -> f64 {
    if genotype == 0 { return 1.00 }   // CC: reference
    if genotype == 1 { return 1.15 }   // CT: 15% more net permeability
    if genotype == 2 { return 1.30 }   // TT: 30% more net permeability
    return 1.00
}

// Epistemic confidence for the ps_bbb scaling estimate.
// CC is reference (no adjustment uncertainty); CT/TT based on Marzolini 2004 (single cohort).
pub fn abcb1_prior_conf(genotype: i32) -> f64 {
    if genotype == 0 { return 0.70 }   // CC: reference, no estimation needed
    if genotype == 1 { return 0.55 }   // CT: single cohort, CV≈25%
    if genotype == 2 { return 0.55 }   // TT: single cohort, CV≈25%
    return 0.70
}

// CV for the ps_bbb scaling uncertainty (for GUM variance propagation).
pub fn abcb1_psbbb_cv(genotype: i32) -> f64 {
    if genotype == 0 { return 0.10 }   // CC: baseline uncertainty only
    if genotype == 1 { return 0.25 }   // CT
    if genotype == 2 { return 0.25 }   // TT
    return 0.10
}

// European population frequency for each genotype.
pub fn abcb1_freq_european(genotype: i32) -> f64 {
    if genotype == 0 { return 0.40 }   // CC
    if genotype == 1 { return 0.42 }   // CT
    if genotype == 2 { return 0.18 }   // TT
    return 0.0
}

// Sample ABCB1 genotype from uniform variate u in [0, 1).
pub fn abcb1_sample(u: f64) -> i32 {
    if u < 0.40 { return 0 }    // CC: [0.00, 0.40)
    if u < 0.82 { return 1 }    // CT: [0.40, 0.82)
    return 2                     // TT: [0.82, 1.00)
}

fn main() with IO, Mut, Div, Panic {
    println("abcb1: MDR1 C3435T ps_bbb scaling")
    println("  CC scale:"); print_f64(abcb1_psbbb_scale(0)); println("")
    println("  CT scale:"); print_f64(abcb1_psbbb_scale(1)); println("")
    println("  TT scale:"); print_f64(abcb1_psbbb_scale(2)); println("")
    println("PASS")
}
