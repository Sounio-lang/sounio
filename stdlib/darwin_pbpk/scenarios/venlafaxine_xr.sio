// stdlib/darwin_pbpk/scenarios/venlafaxine_xr.sio — Venlafaxine XR end-to-end scenario
//
// SISTEMA 2 controlled-release witness:
//   matrix_er (Korsmeyer-Peppas) → GI absorption → parent PBPK28
//   → CYP2D6 formation → ODV PBPK28 → ODV/parent PGx readout
//
// Operator splitting per step (Lie-Trotter, same pattern as semaglutide_sc_depot):
//   1. Matrix releases dissolved dose to gut pool
//   2. First-order absorption (ka) from gut pool → parent blood input
//   3. Parent PBPK28 CN step with the CYP2D6 formation sink on the liver
//      (organ 1) inside the implicit solve → mass formed feeds ODV blood input
//   4. ODV PBPK28 CN step
//
// The formation flux is CL_form · C_liver,avg. CL_form·dt/V_liver is ~0.9 (PM),
// ~11.9 (NM) and ~35.7 (UM) at dt = 0.5 h, so an explicit post-step
// subtraction cannot represent it: once the step's demand exceeds the liver
// content it saturates to "empty the liver" (IM, NM and UM alike). The
// sink is therefore folded into the liver's 2×2 CN block of
// `pbpk28_full_cn_step_sink_mut`, the same way `cl_central` enters the blood
// row, and the mass that step removes is exactly the mass handed to ODV.
//
// Readout: steady-state C_avg ODV/parent blood ratio under 75 mg XR q24h
// (`vfx_ss_odv_parent_ratio`), with a closed-form oracle and a per-run error
// bound — see "Steady-state ODV/parent readout" below.
//
// Literature anchors: Gohel 2008 (matrix), Wang 2022 (ka, F), Klamerus 1999 (CL),
// Shams 2006 (steady-state ODV/V serum ratio bands, readout comparison only).
// The CYP2D6 CL_form phenotype scaling (vfx_cl_form_odv_adjusted) still comes
// from the ratios pgx/cyp2d6_venlafaxine.sio attributes to "Kirchheiner 2006,
// Ther Drug Monit 28:493-502". That citation is UNRESOLVED: it is not in
// PubMed, its pages match Shams 2006, and the Shams abstract does not contain
// those ratios. Shams does not supply the sink scaling.

use darwin_pbpk::core::pbpk28_params::*
use darwin_pbpk::tsit5_pbpk28::*
use darwin_pbpk::release::matrix_er::*
use darwin_pbpk::drugs::venlafaxine::*
use darwin_pbpk::pgx::cyp2d6_venlafaxine::*

// `pub` (with the two states) so the dissertation parity reference drives this
// scenario itself rather than a copy of it:
// tests/run-pass/dissertation_pbpk28_parity_ref_venlafaxine.sio.
pub struct VenlafaxineXrScenario {
    pub parent: PBPKState28,
    pub odv:    PBPKState28,
    gut_mg: f64,
    pheno:  i32,
    // Fluxes of the most recent step (mg): absorbed into parent blood, and
    // parent converted to ODV. Read by the steady-state audit.
    last_absorbed_mg: f64,
    last_formed_mg:   f64,
}

pub fn vfx_scenario_init(pheno: i32) -> VenlafaxineXrScenario {
    VenlafaxineXrScenario {
        parent: pbpk28_state_zero(),
        odv:    pbpk28_state_zero(),
        gut_mg: 0.0,
        pheno:  pheno,
        last_absorbed_mg: 0.0,
        last_formed_mg:   0.0,
    }
}

fn vfx_parent_params(pheno: i32) -> PBPKParams28 with Mut, Div, Panic {
    var p = pbpk28_params_venlafaxine_parent()
    p.cl_central = venlafaxine_cl_parent_central_pgx(pheno)
    return p
}

fn vfx_odv_params(pheno: i32) -> PBPKParams28 with Mut, Div, Panic {
    var p = pbpk28_params_venlafaxine_odv()
    p.cl_central = venlafaxine_cl_odv_pgx(pheno)
    return p
}

// Liver organ index in PBPK28 (CYP2D6 formation site).
fn vfx_liver_organ() -> i32 { return 1 }

// Parent CN step with the CYP2D6 → ODV formation sink solved implicitly on the
// liver. Advances `*parent` and returns the parent mass (mg) converted to ODV
// over the step — exactly the mass the sink removed from the parent.
pub fn vfx_parent_step_with_formation(
    parent: &!PBPKState28,
    pheno: i32,
    parent_input: f64,
    dt: f64
) -> f64 with Mut, Div, Panic {
    let pp = vfx_parent_params(pheno)
    let cl_form = vfx_cl_form_odv_adjusted(pheno)
    return pbpk28_full_cn_step_sink_mut(parent, pp, parent_input, dt, vfx_liver_organ(), cl_form)
}

// One split step given the mass `released_mg` the matrix dissolves into the gut
// over [t, t + dt] (summed over every dose on board). Records the step's
// absorbed and formed masses in the returned scenario for the steady-state
// audit below.
fn vfx_step_released(
    scen: VenlafaxineXrScenario,
    released_mg: f64,
    dt: f64
) -> VenlafaxineXrScenario with Mut, Div, Panic {
    let op = vfx_odv_params(scen.pheno)
    let f_abs = venlafaxine_f_oral_xr()
    let ka = venlafaxine_ka_abs()

    // 1. Matrix dissolution → gut pool (mg)
    var gut = scen.gut_mg + released_mg

    // 2. First-order absorption from gut pool; F applied to absorbed fraction.
    let frac_abs = 1.0 - mer_exp_neg(0.0 - ka * dt)
    let absorb_amt = f_abs * gut * frac_abs
    gut = gut - absorb_amt
    if gut < 0.0 { gut = 0.0 }

    let parent_input = absorb_amt / dt

    // 3. Parent transport + CYP2D6 formation sink on the liver, one implicit solve.
    var out_parent = scen.parent
    let form_mg = vfx_parent_step_with_formation(&!out_parent, scen.pheno, parent_input, dt)

    // 4. ODV receives exactly the parent mass converted in step 3.
    let odv_input = form_mg / dt
    var out_odv = pbpk28_full_cn_step(scen.odv, op, odv_input, dt)

    VenlafaxineXrScenario {
        parent: out_parent,
        odv:    out_odv,
        gut_mg: gut,
        pheno:  scen.pheno,
        last_absorbed_mg: absorb_amt,
        last_formed_mg:   form_mg,
    }
}

fn vfx_strang_step(
    scen: VenlafaxineXrScenario,
    rel: MatrixReleaseModel,
    t_start: f64,
    dt: f64
) -> VenlafaxineXrScenario with Mut, Div, Panic {
    return vfx_step_released(scen, matrix_step_amount(rel, t_start, dt), dt)
}

// Taylor exp for negative arguments (shared pattern with semaglutide scenario),
// with range reduction. The 19-term series alone is only accurate near 0: at
// x = −15.12 (dt = 24 h) it returns −9.2e4, which made frac_abs ≈ 9.2e4 and
// injected millions of mg. Halve x until |x| ≤ 0.5, sum the series, then
// square back: exp(x) = exp(x/2^m)^(2^m). For |x| ≤ 0.5 (ka·dt ≤ 0.5, i.e.
// dt ≤ 0.79 h) no reduction happens and the result is bit-identical to the
// unreduced series.
fn mer_exp_neg(x: f64) -> f64 with Mut, Div {
    if x >= 0.0 { return 1.0 }
    var r = x
    var m: i64 = 0
    while r < 0.0 - 0.5 {
        r = 0.5 * r
        m = m + 1
    }
    var y = 1.0
    var term = 1.0
    var k: i64 = 1
    while k < 20 {
        term = term * r / (k as f64)
        y = y + term
        k = k + 1
    }
    while m > 0 {
        y = y * y
        m = m - 1
    }
    return y
}

pub fn vfx_integrate_to(
    scen: VenlafaxineXrScenario,
    rel: MatrixReleaseModel,
    t_start: f64,
    t_end: f64,
    dt: f64
) -> VenlafaxineXrScenario with Mut, Div, Panic {
    var s = scen
    var t = t_start
    while t < t_end - 0.5 * dt {
        s = vfx_strang_step(s, rel, t, dt)
        t = t + dt
    }
    return s
}

// ─── Steady-state ODV/parent readout ────────────────────────────────────────
//
// Readout: C_ss,avg(ODV) / C_ss,avg(parent) in blood, i.e. the ratio of blood
// AUCs over one dosing interval at steady state of 75 mg XR q24h. It is
// compared with steady-state TDM ODV/V serum ratios (Shams 2006, below). The
// abstract does not state the sampling time, so that comparison treats a TDM
// ratio as a C_avg ratio. Pointwise ratios are not interchangeable with it:
// the model's steady-state trough ratio is ~3x larger (NM ≈ 6.3 vs 1.91), and
// a trough readout is neither dt-converged at dt = 0.5 h (NM 6.05 / 6.08 /
// 6.26 / 6.35 at dt = 0.5 … 0.0625 h) nor independent of the F/ka input model.
//
// It replaces the total-body mass ratio at t = 120 h after a single dose,
// which divided residual masses of ~1e-12 mg and did not converge under dt
// refinement (NM 129.8 / 222.9 / 348.3 at dt = 0.5 / 0.25 / 0.125 h).
//
// Why it is dt-converged. Write one split step of the joint parent+ODV state
// x as x_{n+1} − x_n = h·A·(x_n + x_{n+1}) + dt·B·u_n + ĵ_n (h = dt/2), where
// A is the continuous compartmental matrix, the ODV input is the formation the
// parent step removed, and ĵ_n is what the kernel's non-negativity clamp
// injects (zero on clamp-free steps). Summed over one interval,
//   S = h·Σ(x_n + x_{n+1}) = (−A)⁻¹ (B·U + J − Δx),
// with J = Σ ĵ_n and Δx = x_end − x_start. With J = 0 and Δx = 0 (exact
// periodic steady state) S is exactly the continuous steady-state integral
// (−A)⁻¹B·U: Crank-Nicolson plus trapezoid AUC keeps the DC gain exactly, and
// the Lie-Trotter split drops out of the sum. The ratio then equals the closed
// form below at every dt, and it does not depend on dose, F or ka.
//
// Error bound (VfxSsInterval.err_auc_*). (−A)⁻¹ ≥ 0 elementwise and mass in
// the parent leaves either through cl_central or into ODV, so for a
// perturbation of mass m placed in the parent, CL_c·ΔAUC_parent ≤ m and
// CL_odv·ΔAUC_odv ≤ m — the fraction of it converted to ODV is at most 1 and
// every converted unit leaves through CL_odv, so taking all of m is an upper
// bound, not an assumption; placed in ODV, CL_odv·ΔAUC_odv ≤ m. The clamp stores
// x̃ + j (j ≥ 0) where the solve gave x̃, which enters the summed identity as
// ĵ = (I − hA)j. Its measured per-step mass residual (parent and ODV alike)
// is r = m(j) − h·m(A·j) ≥ m(j), because the volume-weighted mass functional
// satisfies VᵀA ≤ 0 for a compartmental model; the extra h·j lands only on the
// compartment clamped, at most h·r/V_b in blood. With R = Σ|r| over the
// interval and P = Σ_k V_k·|Δx_k| (mass-weighted non-periodicity):
//   err_parent = (R_p + P_p)/CL_c + h·R_p/V_b
//   err_odv    = (R_p + P_p + R_o + P_o)/CL_odv + h·R_o/V_b
// Both are measured on the same run; nothing in them is a chosen tolerance.
// The bound is valid but conservative: at dt = 0.5 h it certifies ≤ 4.1e-7
// relative while the measured error is ≤ 3.3e-11. P_p dominates it; it comes
// from stiff Crank-Nicolson modes (amplification ≈ −1) still ringing, and
// the mass/CL estimate does not exploit how little blood AUC a fast mode
// carries.
// P also covers whatever approach to steady state is left after the warm-up
// doses, so the dose count is a runtime choice, not an accuracy assumption.

pub struct VfxSsInterval {
    pub auc_parent: f64,             // ∫ C_b,parent over the last interval (mg·h/L)
    pub auc_odv: f64,                // ∫ C_b,ODV over the last interval (mg·h/L)
    pub err_auc_parent: f64,         // certified |AUC − AUC_ss| bound (mg·h/L)
    pub err_auc_odv: f64,
    pub residual_mg_parent: f64,     // R_p = Σ |per-step mass-identity residual|
    pub residual_mg_odv: f64,        // R_o
    pub periodicity_mg_parent: f64,  // P_p = Σ V·|x_end − x_start|
    pub periodicity_mg_odv: f64,     // P_o
}

// Mass released into the gut over [t, t + dt] by doses given at 0, τ, …, (n−1)τ.
fn vfx_released_qtau(
    rel: MatrixReleaseModel,
    n_doses: i32,
    tau: f64,
    t: f64,
    dt: f64
) -> f64 with Mut, Div, Panic {
    var amt = 0.0
    var k: i32 = 0
    while k < n_doses {
        amt = amt + matrix_step_amount(rel, t - (k as f64) * tau, dt)
        k = k + 1
    }
    return amt
}

// Σ_k V_k·|a_k − b_k| over blood and both sub-compartments of each organ (mg).
fn vfx_state_abs_diff_mass(a: PBPKState28, b: PBPKState28, p: PBPKParams28) -> f64 with Mut {
    var d = a.cv[0] - b.cv[0]
    if d < 0.0 { d = 0.0 - d }
    var total = p.v_ref[0] * d
    var i: i32 = 1
    while i < 14 {
        let vi = p.v_ref[i]
        let vv = vi * p.vasc_frac[i]
        let vt = vi * (1.0 - p.vasc_frac[i])
        var dv = a.cv[i] - b.cv[i]
        if dv < 0.0 { dv = 0.0 - dv }
        var dtt = a.ct[i] - b.ct[i]
        if dtt < 0.0 { dtt = 0.0 - dtt }
        total = total + vv * dv + vt * dtt
        i = i + 1
    }
    return total
}

// Fresh element-wise copy of a state. The interval audit snapshots the state
// with this instead of `let start = s.parent`: under Madaros (committed ELF,
// md5 57c015c1, 2026-09-26) a `let` bound to a struct field aliases the
// parent's storage, so after `s = f(s)` the snapshot reads the new state and
// the non-periodicity term silently becomes 0. lean_single copies. 20-line
// repro: let a0 = s.a; s = bump(s) → a0 shows the bumped value.
fn vfx_state_copy(s: PBPKState28) -> PBPKState28 with Mut {
    var c = pbpk28_state_zero()
    var i: i32 = 0
    while i < 14 {
        c.cv[i] = s.cv[i]
        c.ct[i] = s.ct[i]
        i = i + 1
    }
    return c
}

// Runs n_doses of `rel` every `tau` hours and audits the interval after the
// last dose, [(n−1)τ, nτ]. Panics unless n_doses ≥ 1, dt > 0 and tau is a
// whole number of steps: a rounded step count would audit a window that is
// not the dosing interval and void the periodicity term.
pub fn vfx_ss_interval(
    pheno: i32,
    rel: MatrixReleaseModel,
    n_doses: i32,
    tau: f64,
    dt: f64
) -> VfxSsInterval with Mut, Div, Panic {
    let pp = vfx_parent_params(pheno)
    let op = vfx_odv_params(pheno)
    let h = 0.5 * dt
    let vb = pp.v_ref[0]
    if !(n_doses >= 1 && dt > 0.0 && tau >= dt) {
        panic("vfx_ss_interval: need n_doses >= 1, dt > 0 and tau >= dt")
    }
    let steps_per_tau = (tau / dt + 0.5) as i64
    var off = (steps_per_tau as f64) * dt - tau
    if off < 0.0 { off = 0.0 - off }
    if off > 1.0e-9 * tau {
        panic("vfx_ss_interval: tau must be a whole number of dt steps")
    }
    let n_warm = ((n_doses - 1) as i64) * steps_per_tau

    var s = vfx_scenario_init(pheno)
    var n: i64 = 0
    while n < n_warm {
        s = vfx_step_released(s, vfx_released_qtau(rel, n_doses, tau, (n as f64) * dt, dt), dt)
        n = n + 1
    }

    let parent_start = vfx_state_copy(s.parent)
    let odv_start = vfx_state_copy(s.odv)
    var auc_p = 0.0
    var auc_o = 0.0
    var res_p = 0.0
    var res_o = 0.0
    let n_end = n_warm + steps_per_tau
    while n < n_end {
        let mp0 = pbpk28_total_mass(s.parent, pp)
        let mo0 = pbpk28_total_mass(s.odv, op)
        let cp0 = s.parent.cv[0]
        let co0 = s.odv.cv[0]
        s = vfx_step_released(s, vfx_released_qtau(rel, n_doses, tau, (n as f64) * dt, dt), dt)
        let cp1 = s.parent.cv[0]
        let co1 = s.odv.cv[0]
        auc_p = auc_p + h * (cp0 + cp1)
        auc_o = auc_o + h * (co0 + co1)
        var rp = pbpk28_total_mass(s.parent, pp)
            - (mp0 + s.last_absorbed_mg - h * pp.cl_central * (cp0 + cp1) - s.last_formed_mg)
        if rp < 0.0 { rp = 0.0 - rp }
        var ro = pbpk28_total_mass(s.odv, op)
            - (mo0 + s.last_formed_mg - h * op.cl_central * (co0 + co1))
        if ro < 0.0 { ro = 0.0 - ro }
        res_p = res_p + rp
        res_o = res_o + ro
        n = n + 1
    }

    let per_p = vfx_state_abs_diff_mass(s.parent, parent_start, pp)
    let per_o = vfx_state_abs_diff_mass(s.odv, odv_start, op)
    VfxSsInterval {
        auc_parent: auc_p,
        auc_odv: auc_o,
        err_auc_parent: (res_p + per_p) / pp.cl_central + h * res_p / vb,
        err_auc_odv: (res_p + per_p + res_o + per_o) / op.cl_central + h * res_o / vb,
        residual_mg_parent: res_p,
        residual_mg_odv: res_o,
        periodicity_mg_parent: per_p,
        periodicity_mg_odv: per_o,
    }
}

// Canonical regimen: one 75 mg XR unit (Gohel 2008 matrix) every 24 h, audited
// over the 10th interval.
pub fn vfx_ss_regimen_interval(pheno: i32, dt: f64) -> VfxSsInterval with Mut, Div, Panic {
    return vfx_ss_interval(pheno, venlafaxine_xr_matrix_gohel2008(), 10, 24.0, dt)
}

pub fn vfx_ss_ratio(iv: VfxSsInterval) -> f64 with Div {
    return iv.auc_odv / iv.auc_parent
}

// Certified interval for the exact steady-state ratio given the run's bounds.
// When the error bound swallows an AUC (large dt, heavy clamping) the interval
// is unbounded on that side rather than a quotient of negatives: at dt = 6 h
// the parent bound exceeds the parent AUC and the naive upper end was −4.2.
pub fn vfx_ss_ratio_lo(iv: VfxSsInterval) -> f64 with Div {
    let num = iv.auc_odv - iv.err_auc_odv
    if num <= 0.0 { return 0.0 }
    return num / (iv.auc_parent + iv.err_auc_parent)
}

pub fn vfx_ss_ratio_hi(iv: VfxSsInterval) -> f64 with Div {
    let den = iv.auc_parent - iv.err_auc_parent
    if den <= 0.0 { return 1.0e300 }
    return (iv.auc_odv + iv.err_auc_odv) / den
}

// The readout: steady-state C_avg ODV/parent blood ratio, 75 mg XR q24h.
pub fn vfx_ss_odv_parent_ratio(pheno: i32, dt: f64) -> f64 with Mut, Div, Panic {
    return vfx_ss_ratio(vfx_ss_regimen_interval(pheno, dt))
}

// Closed-form steady state of the same model under constant input to parent
// blood, derived without the integrator. Organs without the sink equilibrate
// at C_v = C_b. On the liver, with k_s = CL_form / V on both sub-compartments:
//   tissue:   PS·(C_v − C_t/K_p) = k_s·V_t·C_t   ⇒ τ_t = C_t/C_v = PS / (PS/K_p + k_s·V_t)
//   vascular: Q·(C_b − C_v) = k_s·(V_v·C_v + V_t·C_t)
//   φ = C_avg/C_v = (V_v + V_t·τ_t) / V,   C_avg/C_b = φ·Q / (Q + CL_form·φ)
// ODV has no sink, so C_b,ODV = CL_form·C_avg / CL_odv, and
//   ratio = (CL_form / CL_odv) · C_avg/C_b.
// Steady-state C_avg,liver / C_b of the parent (derivation above).
fn vfx_liver_cavg_over_cb(pheno: i32) -> f64 with Mut, Div, Panic {
    let pp = vfx_parent_params(pheno)
    let li = vfx_liver_organ()
    let clf = vfx_cl_form_odv_adjusted(pheno)
    let v = pp.v_ref[li]
    let vv = v * pp.vasc_frac[li]
    let vt = v * (1.0 - pp.vasc_frac[li])
    let ks = clf / v
    let ps = pp.ps[li]
    let kp = pp.kp[li]
    let q = pp.q[li]
    let tau_t = ps / (ps / kp + ks * vt)
    let phi = (vv + vt * tau_t) / v
    return phi * q / (q + clf * phi)
}

pub fn vfx_ss_ratio_closed_form(pheno: i32) -> f64 with Mut, Div, Panic {
    let clf = vfx_cl_form_odv_adjusted(pheno)
    let clo = venlafaxine_cl_odv_pgx(pheno)
    return (clf / clo) * vfx_liver_cavg_over_cb(pheno)
}

// Fraction of parent mass entering blood that is converted to ODV, f_m =
// X / (CL_c + X) with X = CL_form · C_avg/C_b the formation clearance
// referred to blood. By the same summed identity as the readout, total
// formation over a run whose parent returns to zero is f_m × absorbed mass at
// every dt; see tests/run-pass/darwin_venlafaxine_formation_sink_implicit.sio
// for the per-run bound.
pub fn vfx_formation_fraction_closed_form(pheno: i32) -> f64 with Mut, Div, Panic {
    let pp = vfx_parent_params(pheno)
    let x = vfx_cl_form_odv_adjusted(pheno) * vfx_liver_cavg_over_cb(pheno)
    return x / (pp.cl_central + x)
}

// Steady-state ODV/V serum ratio bands, Shams et al. 2006, J Clin Pharm Ther
// 31(5):493-502, doi:10.1111/j.1365-2710.2006.00763.x (PubMed 16958828,
// abstract), 100 patients on venlafaxine. The cohort's 10th and 90th ratio
// percentiles, 0.3 and 5.2, were the cut-offs for genotyping: every patient
// below 0.3 genotyped PM, every patient above 5.2 a gene-duplication UM; the
// five *4 heterozygotes (IM) had 1.1 ± 0.8 (mean ± 1 SD, the band used); the cohort median was
// 1.8. NM has no band of its own, so it gets the 10th-90th percentile range.
// These are published values, not tolerances. Model concentrations are blood;
// the reference is serum, so this treats the blood:plasma ratios of parent and
// ODV as equal.
pub fn vfx_ss_ratio_band_lo(pheno: i32) -> f64 {
    if pheno == 0 { return 0.0 }
    if pheno == 1 { return 0.3 }
    if pheno == 3 { return 5.2 }
    return 0.3
}

pub fn vfx_ss_ratio_band_hi(pheno: i32) -> f64 {
    if pheno == 0 { return 0.3 }
    if pheno == 1 { return 1.9 }
    if pheno == 3 { return 1.0e300 }
    return 5.2
}

// In-band test with the published endpoint semantics: PM strictly below 0.3,
// UM strictly above 5.2; IM and NM ranges closed.
pub fn vfx_ss_ratio_in_band(pheno: i32, r: f64) -> bool {
    if pheno == 0 { return r < vfx_ss_ratio_band_hi(0) }
    if pheno == 3 { return r > vfx_ss_ratio_band_lo(3) }
    return r >= vfx_ss_ratio_band_lo(pheno) && r <= vfx_ss_ratio_band_hi(pheno)
}

// ─── Runnable validation (library self-check) ───────────────────────────────
fn main() -> i32 with IO, Mut, Div, Panic {
    println("======================================================================")
    println("  Venlafaxine XR — matrix release → parent/ODV PBPK28 scenario")
    println("======================================================================")

    let dt = 0.5
    var passed = 0
    var failed = 0

    // Steady-state C_avg ODV/parent ratio, 75 mg XR q24h, per phenotype.
    var ratio: [f64; 4] = [0.0; 4]
    var ph: i32 = 0
    var certified = true
    while ph < 4 {
        let iv = vfx_ss_regimen_interval(ph, dt)
        ratio[ph] = vfx_ss_ratio(iv)
        let cf = vfx_ss_ratio_closed_form(ph)
        println("phenotype (0=PM 1=IM 2=NM 3=UM), SS ratio, closed form, certified [lo, hi]:")
        println(ph)
        println(ratio[ph])
        println(cf)
        println(vfx_ss_ratio_lo(iv))
        println(vfx_ss_ratio_hi(iv))
        if !(vfx_ss_ratio_lo(iv) <= cf && cf <= vfx_ss_ratio_hi(iv)) { certified = false }
        ph = ph + 1
    }

    if ratio[0] < ratio[1] && ratio[1] < ratio[2] && ratio[2] < ratio[3] {
        println("  [PASS] CYP2D6 phenotype ordering PM < IM < NM < UM")
        passed = passed + 1
    } else {
        println("  FAIL: expected PM < IM < NM < UM ordering")
        failed = failed + 1
    }

    if certified {
        println("  [PASS] closed-form steady state inside every run's certified interval")
        passed = passed + 1
    } else {
        println("  FAIL: closed-form steady state outside a certified interval")
        failed = failed + 1
    }

    // Reported, not asserted here: tests/run-pass/darwin_venlafaxine_xr_odv_ratio_literature.sio
    ph = 0
    while ph < 4 {
        println("Shams 2006 band [lo, hi] and in-band (1/0):")
        println(vfx_ss_ratio_band_lo(ph))
        println(vfx_ss_ratio_band_hi(ph))
        var inb: i32 = 0
        if vfx_ss_ratio_in_band(ph, ratio[ph]) { inb = 1 }
        println(inb)
        ph = ph + 1
    }

    // Matrix release of one unit.
    let rel = venlafaxine_xr_matrix_gohel2008()
    let released = matrix_cumulative(rel, 120.0)
    println("Released dose (mg):")
    println(released)
    if released > 10.0 && released <= 75.0 {
        println("  [PASS] matrix release in expected range")
        passed = passed + 1
    } else {
        println("  FAIL: unexpected released dose")
        failed = failed + 1
    }

    println("  Passed:")
    println(passed)
    println("  Failed:")
    println(failed)
    if failed == 0 {
        println("PASS")
    }
    println("======================================================================")
    return failed as i32
}
