// stdlib/darwin_pbpk/scenarios/lithium_oral.sio — scenario library (no main)
//
// End-to-end dissertation scenario for lithium (SIO-520):
//
//   - Single 300 mg lithium carbonate capsule (= 56.4 mg Li+, 8.12 mEq)
//     → tablet dissolution lag (tlag = 0.25 h) + first-order gut absorption
//       (ka = 1.0/h) with NO first-pass loss (F = 1.00 — nothing hepatic)
//       → blood input (closed-form rate, operator-split source term)
//         → 14-compartment PBPK28 (tsit5_pbpk28, fully-coupled CN)
//         → PURELY RENAL sink: CL = 1.3 L/h (≈22% of GFR, Na+ competition)
//
// Mold: scenarios/quetiapine_oral.sio (oral IR + lag + scenario-owned
// profile). Shared infrastructure, NOT shared mechanism: the only card with
// zero hepatic clearance; Kp from ECF physiology + measured anchors, never
// from lipophilic-neutral predictors (card condition).
//
// Plasma referenced (fu = 1.0, rb ≈ 1): renal CL acts on blood directly.
// Distribution mostly flow-limited (ion in body water); brain and bone PS
// reduced for measured slow equilibration; adipose PS low (ions excluded
// from fat). All PS assumed (SIO-550).
//
// Declared limitation: single-dose PK only. No GFR-impairment variant, no
// steady-state trough, no thyroid/saliva sub-model — follow-ups. No
// clinical-validity claim: parity only (ADR009).
//
// The parity ref tests/run-pass/dissertation_pbpk28_parity_ref_lithium.sio
// drives this scenario itself, so a scenario change not mirrored in Node
// breaks the gate.
//
// This file is a library with no `main`; it is checked, not run.

use darwin_pbpk::core::pbpk28_params::*
use darwin_pbpk::tsit5_pbpk28::*
use darwin_pbpk::drugs::lithium::*
use math::pure::{exp}

// ─── Lithium PBPK28 profile (scenario-owned) ───────────────────────────────
// Kept here — not in core/pbpk28_params.sio — so this lane never churns the
// website-pinned domain source. Standard 70 kg physiology. Kp = lithium
// tissue values from drugs/lithium.sio (Vd ~42 L); PS flow-limited except
// brain/bone/adipose (measured slow exclusion, SIO-550); CL_renal = 1.3 L/h.
pub fn li_pbpk28_params() -> PBPKParams28 {
    PBPKParams28 {
        v_ref:     [5.0, 1.8, 0.31, 1.45, 0.33, 1.1, 28.0, 20.0, 1.2, 3.6, 6.6, 0.18, 0.09, 3.7],
        vasc_frac: [1.000, 0.210, 0.160, 0.037, 0.262, 0.262, 0.040, 0.050, 0.024, 0.019, 0.041, 0.282, 0.180, 0.050],
        kp:        [1.00, 0.6, 0.8, 0.4, 0.6, 0.6, 0.8, 0.2, 0.6, 0.5, 0.5, 0.6, 0.6, 0.6],
        ps:        [0.0, 90.0, 74.0, 5.0, 16.0, 350.0, 42.0, 4.0, 55.0, 21.0, 5.0, 10.0, 8.0, 13.0],
        q:         [350.0, 90.0, 74.0, 44.0, 16.0, 350.0, 42.0, 10.0, 55.0, 21.0, 17.0, 10.0, 8.0, 13.0],
        cl_central: 1.3,
    }
}

// ─── Oral IR input with dissolution lag (elemental mg Li+) ──────────────────
// rate(t) = 0 for t < tlag, else F·D·ka·exp(−ka·(t−tlag)), mg/h.
// D = 56.4 mg Li+ (300 mg carbonate); ka = 1.0/h, F = 1.00, tlag = 0.25 h.
pub fn li_dose_mg() -> f64 { return lithium_elemental_mg() }
pub fn li_ka() -> f64      { return lithium_ka_per_h() }
pub fn li_f() -> f64       { return lithium_f_oral_val() }
pub fn li_tlag() -> f64    { return lithium_tlag_h() }

pub fn li_release_rate_at(t: f64) -> f64 with Mut, Div {
    var te = t - li_tlag()
    if te < 0.0 { return 0.0 }
    return li_f() * li_dose_mg() * li_ka() * exp(0.0 - li_ka() * te)
}

// ─── Composite scenario state ───────────────────────────────────────────────
pub struct LithiumScenario {
    pub pbpk: PBPKState28,
}

// Initial state: zero PBPK (drug enters via gut absorption).
pub fn li_scenario_init() -> LithiumScenario {
    LithiumScenario {
        pbpk: pbpk28_state_zero(),
    }
}

// One fully-coupled CN step at midpoint input rate.
pub fn li_step(scen: LithiumScenario, p: PBPKParams28,
               t_start: f64, dt: f64)
    -> LithiumScenario with Mut, Div
{
    let rel_mid = li_release_rate_at(t_start + 0.5 * dt)
    var out_pbpk = pbpk28_full_cn_step(scen.pbpk, p, rel_mid, dt)
    return LithiumScenario { pbpk: out_pbpk }
}
