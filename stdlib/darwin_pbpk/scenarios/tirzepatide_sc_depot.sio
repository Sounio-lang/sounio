// stdlib/darwin_pbpk/scenarios/tirzepatide_sc_depot.sio — scenario library (no main)
//
// End-to-end dissertation scenario for tirzepatide (SIO-517):
//
//   - PBPK28 transport (core/pbpk28_params + tsit5_pbpk28)
//   - SC depot first-order release (5 mg weekly, F = 0.80, k_a = 0.0164 /h
//     per Urva 2022; maintenance dose per FDA 2022 label)
//
// PK only: no TMDD/PD layer in this scenario. Tirzepatide is a dual
// GIP/GLP-1R agonist; receptor compartments are SIO-517 follow-up once the
// PK parity is gated. Elimination is proteolytic (CL = 0.0488 L/h; see the profile note; Urva
// 2022); per Martin 2024 no intact parent appears in excreta, so no renal
// clearance of parent is modeled.
//
// The parity ref tests/run-pass/dissertation_pbpk28_parity_ref_tirzepatide.sio
// drives this scenario itself (venlafaxine pattern), so a scenario change
// not mirrored in Node breaks the gate.
//
// This file is a library with no `main`; it is checked, not run.

use darwin_pbpk::core::pbpk28_params::*
use darwin_pbpk::tsit5_pbpk28::*
use darwin_pbpk::drugs::tirzepatide::*
use math::pure::{exp}

// ─── SC depot release ───────────────────────────────────────────────────────
// Urva 2022 popPK — ka = 0.0164 /h, F = 0.80. Total systemic exposure over
// t in [0, inf] equals F * Dose by construction.
pub fn tirz_dose_mg() -> f64 { return tirzepatide_dose_mg() }
pub fn tirz_f() -> f64       { return tirzepatide_f_sc() }
pub fn tirz_ka() -> f64      { return 0.0373 }

// rate(t) = F * Dose * k_a * exp(-k_a * t), mg/h.
pub fn tirz_release_rate_at(t: f64) -> f64 with Mut, Div {
    if t < 0.0 { return 0.0 }
    let ka = tirz_ka()
    // math::pure::exp, valid for any t. The 20-term Taylor sum used here
    // before loses accuracy once ka * t exceeds about 4 (error 0.6% at
    // ka * t = 5) and turns negative or grows beyond ka * t of about 9, so
    // the rate was wrong past the second week of a weekly-dosing horizon.
    return tirz_f() * tirz_dose_mg() * ka * exp(0.0 - ka * t)
}

// ─── Tirzepatide PBPK28 profile (scenario-owned) ────────────────────────────
// Kept here — not in core/pbpk28_params.sio — so this lane never churns the
// website-pinned domain source. Dual GIP/GLP-1 peptide (MW 4813 Da); no renal
// clearance of parent (Martin 2024).
//
// Disposition: Mounjaro prescribing information, section 12.3: apparent
// clearance 0.061 L/h, apparent steady-state volume about 10.3 L, absolute
// bioavailability 80%, half-life about 5 days; hence CL = 0.0488 L/h and
// V = 8.24 L. Absorption rate constant 0.0373 /h (Schneck & Urva 2024, CPT
// Pharmacometrics Syst Pharmacol 13:494, population model, 5802 subjects;
// the label gives a time of peak of 8 to 72 h).
//
// The kinetic volume of this structure,
//   V_ss = v_ref[0] + sum v_ref[i]*(vasc_frac[i] + (1 - vasc_frac[i])*kp[i]),
// cannot go below 8.60 L (5 L of central blood plus 3.60 L of organ vascular
// space), which is above 8.24 L. The set is placed 0.10 L above that floor,
// at 8.70 L: the peptide Kp pattern times 0.008041. The tissue Kp are
// therefore a device to reach the volume, not tissue measurements; the floor
// exists because concentrations are referred to whole blood while the
// peptide stays in plasma.
//
// Until 2026-11-15 the set used cl_central = 0.061 L/h together with
// F = 0.80 (the apparent clearance already contains F), ka = 0.0164 /h and
// the unscaled Kp pattern (V_ss 21.57 L): half-life 245 h, time of peak
// 129 h, AUC 65.6 mg.h/L for 5 mg against Dose/(CL/F) = 82.0 mg.h/L
// (tests/run-pass/pbpk28_peptide_half_life.sio). PS mirror the semaglutide
// vector; the 1/sqrt(MW) PS shift is under 8%, inside estimation noise.
pub fn tirz_pbpk28_params() -> PBPKParams28 {
    PBPKParams28 {
        v_ref:     [5.0, 1.8, 0.31, 1.45, 0.33, 1.1, 28.0, 20.0, 1.2, 3.6, 6.6, 0.18, 0.09, 3.7],
        vasc_frac: [1.000, 0.210, 0.160, 0.037, 0.262, 0.262, 0.040, 0.050, 0.024, 0.019, 0.041, 0.282, 0.180, 0.050],
        kp:        [1.00, 0.004021, 0.004825, 0.000402, 0.003217, 0.002412, 0.001608, 0.000804, 0.006433, 0.002412, 0.001608, 0.003217, 0.005629, 0.002412],
        ps:        [0.0, 50.0, 30.0, 1.0, 5.0, 100.0, 10.0, 2.0, 30.0, 5.0, 2.0, 10.0, 8.0, 5.0],
        q:         [350.0, 90.0, 74.0, 44.0, 16.0, 350.0, 42.0, 10.0, 55.0, 21.0, 17.0, 10.0, 8.0, 13.0],
        cl_central: 0.0488,
    }
}

// ─── Composite scenario state ───────────────────────────────────────────────
pub struct TirzepatideScenario {
    pub pbpk: PBPKState28,
}

// Initial state: zero PBPK (drug enters via release_rate).
pub fn tirz_scenario_init() -> TirzepatideScenario {
    TirzepatideScenario {
        pbpk: pbpk28_state_zero(),
    }
}

// One fully-coupled CN step at midpoint release rate (set to 0.0 only for
// depot-exhausted runs; the parity ref always passes the live rate).
pub fn tirz_step(scen: TirzepatideScenario, p: PBPKParams28,
                 t_start: f64, dt: f64)
    -> TirzepatideScenario with Mut, Div
{
    let rel_mid = tirz_release_rate_at(t_start + 0.5 * dt)
    var out_pbpk = pbpk28_full_cn_step(scen.pbpk, p, rel_mid, dt)
    return TirzepatideScenario { pbpk: out_pbpk }
}
