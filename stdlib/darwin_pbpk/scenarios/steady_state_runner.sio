// darwin_pbpk/scenarios/steady_state_runner.sio
//
// Multi-dose runner on top of oral_bbb_run. Accumulates exposure over
// N consecutive doses at interval τ (hours), detects approach to
// steady state, and reports the canonical SS endpoints:
//
//   C_max_ss     — peak plasma concentration in the interval where SS was
//                  declared (dose_of_ss), not the last interval
//   C_trough_ss  — trough plasma concentration at the end of that interval
//   AUC_tau_ss   — AUC over that interval; later intervals, if any, are in
//                  auc_tau_per_dose and are the closer plateau estimate
//   t_to_90pct   — end of the first dosing interval whose AUC_tau reaches
//                  90% of the last interval's AUC_tau; undefined (-1) if SS
//                  is not reached or the run is incomplete (success = false),
//                  even when SS was reached before the failing interval
//
// Implementation: one oral_bbb_run per dose interval, carrying state
// forward by re-seeding absorption/PBPK/BBB from the previous interval's
// end. Keeps per-dose resolution at 16 checkpoints (half of the 32-slot
// trace capacity, so the 14-day budget fits within a 32×14 = 448-point
// outer reporter array without per-run overflow). The checkpoints are only
// for the trace and C_max/C_trough; each interval's AUCs are accumulated
// over every accepted solver step (plasma) and every BBB sub-step (ISF,
// ICF), not by a 16-point trapezoid, which read 0.8-4.6% low on the
// regimens measured (a coarse trapezoid can err either way in general:
// it misses a concave peak and overshoots a convex tail).
//
// Rapamycin regimen (defense-target demo):
//   2 mg q24h × 14 days, oral, fasting. Target C_trough_ss 8–20 µg/L
//   per clinical consensus (Kahan 2001; MacDonald 2000).

use darwin_pbpk::absorption::*
use darwin_pbpk::bbb::bbb_core::*
use darwin_pbpk::scenarios::oral_rapamycin_bbb::*
use darwin_pbpk::tsit5_pbpk14::*

pub struct DosingRegimen {
    dose_mg: f64,
    tau_h:   f64,   // dosing interval
    n_doses: i32,   // max N in simulation
}

pub fn rapamycin_qd_regimen(n_days: i32) -> DosingRegimen {
    DosingRegimen { dose_mg: 2.0, tau_h: 24.0, n_doses: n_days }
}

pub struct SSIntervalResult {
    trace:  OralBBBTrace,
    sys_st: PBPKState14,
    bbb_st: BBBState,
    abs_st: AbsorptionState,
}

pub struct SteadyStateReport {
    // false if the regimen asked for fewer than 1 or more than 32 doses, or
    // if any dosing interval failed to integrate; the fields below then
    // describe only the n_doses_run intervals completed before it.
    pub success:       bool,
    pub n_doses_run:   i32,
    pub reached_ss:    bool,
    pub dose_of_ss:    i32,   // 1-based dose number; -1 if SS not reached
    // The four *_ss values are frozen at the interval where SS is declared
    // (row dose_of_ss of the per-dose table); 0.0 if SS is not reached.
    pub c_max_ss:      f64,
    pub c_trough_ss:   f64,
    pub auc_tau_ss:    f64,
    pub auc_icf_tau_ss: f64,
    pub t_to_90pct_h:  f64,   // hours; -1.0 if undefined (SS not reached, or success = false)
    // per-dose diagnostics (max 32 doses to fit DESBBBTrace shape)
    pub c_max_per_dose:    [f64; 32],
    pub c_trough_per_dose: [f64; 32],
    pub auc_tau_per_dose:  [f64; 32],
}

fn ssr_zero() -> SteadyStateReport {
    SteadyStateReport {
        success: false,
        n_doses_run: 0,
        reached_ss: false,
        dose_of_ss: 0 - 1,
        c_max_ss: 0.0,
        c_trough_ss: 0.0,
        auc_tau_ss: 0.0,
        auc_icf_tau_ss: 0.0,
        t_to_90pct_h: 0.0 - 1.0,
        c_max_per_dose:    [0.0; 32],
        c_trough_per_dose: [0.0; 32],
        auc_tau_per_dose:  [0.0; 32],
    }
}

fn ssr_abs_diff(a: f64, b: f64) -> f64 with Div, Panic, Mut {
    if a > b { return a - b }
    b - a
}

// Build 16 checkpoints uniformly spanning [0, tau_h] (first is 0).
fn ssr_make_checkpoints(tau_h: f64) -> [f64; 32] with Div, Panic, Mut {
    var cp: [f64; 32] = [0.0; 32]
    var i: i32 = 0
    while i < 16 {
        let idx = i as usize
        cp[idx] = (i as f64) * tau_h / 15.0
        i = i + 1
    }
    cp
}

// Run a single dose interval with already-populated initial state.
// Returns the trace so the caller can inspect C_max/trough/AUC for it.
fn ssr_run_one_interval(
    sys_prm: PBPKParams14,
    bbb_prm: BBBParams,
    abs_prm: AbsorptionParams,
    sys_init: PBPKState14,
    bbb_init: BBBState,
    abs_init: AbsorptionState,
    tau_h: f64,
    bbb_dt: f64,
    cfg: ODEConfig14
) -> SSIntervalResult with Mut, Div, Panic {
    // We want the per-interval run to seed from the carried-forward
    // state, not a zero reset. The public oral_bbb_run always zeroes,
    // so we inline the coupled loop here with supplied init state.
    var trace = oral_trace_zero()
    trace.n_points = 16

    var sys_st = sys_init
    var bbb_st = bbb_init
    var abs_st = abs_init

    let checkpoints = ssr_make_checkpoints(tau_h)

    trace.times_h[0]  = 0.0
    trace.plasma[0]   = sys_st.blood
    trace.isf_u[0]    = bbb_prm.fu_isf * bbb_st.c_isf
    trace.icf_u[0]    = bbb_prm.fu_icf * bbb_st.c_icf
    trace.a_gut[0]    = abs_st.a_gut
    trace.released[0] = abs_st.released_cum

    var t: f64 = 0.0
    var dt_sys = cfg.dt_init

    // Per-interval AUCs, accumulated at solver resolution.
    // auc_p integrates PBPKState14.blood, a WHOLE-BLOOD concentration
    // (pbpk_ode's plasma is blood / rb_ratio). The BBB driver below and
    // trace.plasma / auc_plasma_u use the same whole-blood value, so they are
    // off from true plasma by rb_ratio (0.58 mean, 36 full-Vd). Converting
    // changes dissertation BBB and PD numbers and awaits an operator
    // decision: docs/audit/DARWIN_PBPK_BLOOD_AS_PLASMA_BBB_DRIVER_2026-09-26.md.
    var auc_p: f64 = 0.0
    var auc_i: f64 = 0.0
    var auc_c: f64 = 0.0

    var point_i: i32 = 1
    while point_i < 16 {
        let idx = point_i as usize
        let target = checkpoints[idx]
        let t_prev = t
        let c_prev = sys_st.blood

        var nsteps: i64 = 0
        var nreject: i64 = 0
        while t < target && nsteps < cfg.max_steps {
            let dt_use = if t + dt_sys > target { target - t } else { dt_sys }
            let released_before = abs_st.released_cum
            let abs_next = absorption_step(abs_st, t, dt_use, abs_prm)
            let rel_mg = abs_next.released_cum - released_before
            var st_in = sys_st
            if rel_mg > 0.0 {
                st_in.blood = st_in.blood + absorption_mass_to_blood_delta(rel_mg, sys_prm.v_blood)
            }
            let result = tsit5_step_pbpk(st_in, t, dt_use, sys_prm)
            let err_norm = compute_error_norm_14(result.err, st_in, result.state_new, cfg.rtol, cfg.atol)
            if err_norm <= 1.0 {
                // Trapezoid over the accepted step: from the post-release
                // blood level at t to the step's end.
                auc_p = auc_p + 0.5 * dt_use * (st_in.blood + result.state_new.blood)
                sys_st = result.state_new
                abs_st = abs_next
                t = t + dt_use
                nsteps = nsteps + 1
                dt_sys = optimal_step_14(dt_use, err_norm, cfg.safety, cfg.max_growth, cfg.min_shrink)
            } else {
                nreject = nreject + 1
                dt_sys = optimal_step_14(dt_use, err_norm, cfg.safety, cfg.max_growth, cfg.min_shrink)
            }
            if dt_sys < cfg.dt_min { dt_sys = cfg.dt_min }
            if dt_sys > cfg.dt_max { dt_sys = cfg.dt_max }
            // trace.success is still false (oral_trace_zero), which is the
            // failure signal; the wrapper keeps the declared return type.
            if nreject > 10000 {
                return SSIntervalResult { trace: trace, sys_st: sys_st, bbb_st: bbb_st, abs_st: abs_st }
            }
        }
        // Step budget exhausted before the checkpoint: same failure signal.
        if t < target {
            return SSIntervalResult { trace: trace, sys_st: sys_st, bbb_st: bbb_st, abs_st: abs_st }
        }

        let c_now = sys_st.blood
        var t_bbb = t_prev
        while t_bbb < target {
            let dt_use_bbb = if t_bbb + bbb_dt > target { target - t_bbb } else { bbb_dt }
            let alpha = if target > t_prev { (t_bbb + 0.5 * dt_use_bbb - t_prev) / (target - t_prev) } else { 0.0 }
            let c_mid = c_prev + alpha * (c_now - c_prev)
            let isf_before = bbb_prm.fu_isf * bbb_st.c_isf
            let icf_before = bbb_prm.fu_icf * bbb_st.c_icf
            bbb_st = bbb_rk4_step(bbb_st, c_mid, dt_use_bbb, bbb_prm)
            auc_i = auc_i + 0.5 * dt_use_bbb * (isf_before + bbb_prm.fu_isf * bbb_st.c_isf)
            auc_c = auc_c + 0.5 * dt_use_bbb * (icf_before + bbb_prm.fu_icf * bbb_st.c_icf)
            t_bbb = t_bbb + dt_use_bbb
        }

        trace.times_h[idx]  = target
        trace.plasma[idx]   = c_now
        trace.isf_u[idx]    = bbb_prm.fu_isf * bbb_st.c_isf
        trace.icf_u[idx]    = bbb_prm.fu_icf * bbb_st.c_icf
        trace.a_gut[idx]    = abs_st.a_gut
        trace.released[idx] = abs_st.released_cum

        point_i = point_i + 1
    }

    // fu_plasma * AUC(whole blood): see the blood-as-plasma note at auc_p.
    trace.auc_plasma_u = bbb_prm.fu_plasma * auc_p
    trace.auc_isf_u    = auc_i
    trace.auc_icf_u    = auc_c
    trace.kpuu_auc     = if trace.auc_plasma_u > 0.0 { auc_i / trace.auc_plasma_u } else { 0.0 }
    trace.total_released_end = abs_st.released_cum
    trace.success = true
    SSIntervalResult { trace: trace, sys_st: sys_st, bbb_st: bbb_st, abs_st: abs_st }
}

// Same as run_oral_multidose, with the ODE step control supplied by the
// caller (tests use it to force a step-budget failure).
pub fn run_oral_multidose_cfg(
    sys_prm: PBPKParams14,
    bbb_prm: BBBParams,
    abs_prm: AbsorptionParams,
    regimen: DosingRegimen,
    bbb_dt: f64,
    cfg: ODEConfig14
) -> SteadyStateReport with Mut, Div, Panic {
    var report = ssr_zero()

    var sys_st = pbpk_state_zero()
    var bbb_st = bbb_state_zero()
    var abs_st = absorption_state_zero()

    // The report holds at most 32 dosing intervals. A request outside 1..32
    // cannot be honoured, so it fails (success = false, n_doses_run = 0)
    // instead of running zero doses or silently truncating to 32.
    if regimen.n_doses < 1 || regimen.n_doses > 32 {
        return report
    }
    let max_n = regimen.n_doses

    var auc_prev: f64 = 0.0 - 1.0
    var reached: bool = false
    var dose_of_ss: i32 = 0 - 1
    // Stricter SS criterion: require the relative AUC_tau change to
    // stay below `ss_thresh` for `ss_consec` consecutive doses (plus
    // minimum dose index `ss_min_dose`). 5%-once over two doses fires
    // too early on drugs with long distribution timescales (adipose
    // equilibration >> τ), so we tighten to 2% held for 3 consecutive
    // intervals starting no earlier than dose 5.
    let ss_thresh: f64 = 0.02
    let ss_consec: i32 = 3
    let ss_min_dose: i32 = 5
    var ss_streak: i32 = 0

    var dose_i: i32 = 0
    while dose_i < max_n {
        // Deposit the next oral dose into the gut depot
        abs_st.a_gut = abs_st.a_gut + regimen.dose_mg

        let res = ssr_run_one_interval(
            sys_prm, bbb_prm, abs_prm,
            sys_st, bbb_st, abs_st,
            regimen.tau_h, bbb_dt, cfg
        )
        let tr = res.trace
        // A failed interval ends the run: its trace is partial, and carrying
        // its state into later doses would make the report look normal.
        if tr.success == false {
            report.success     = false
            report.n_doses_run = dose_i
            report.reached_ss  = reached
            report.dose_of_ss  = dose_of_ss
            report.t_to_90pct_h = 0.0 - 1.0
            return report
        }

        // Find C_max and C_trough within this interval
        var cmax: f64 = 0.0
        var k: i32 = 0
        while k < 16 {
            let idx = k as usize
            if tr.plasma[idx] > cmax { cmax = tr.plasma[idx] }
            k = k + 1
        }
        let last = 15
        let ctrough = tr.plasma[last]

        let d_idx = dose_i as usize
        report.c_max_per_dose[d_idx]    = cmax
        report.c_trough_per_dose[d_idx] = ctrough
        report.auc_tau_per_dose[d_idx]  = tr.auc_plasma_u

        // Steady-state detection: streak of `ss_consec` consecutive
        // intervals with |ΔAUC|/AUC < ss_thresh, starting at ss_min_dose.
        if reached == false && auc_prev > 0.0 {
            let rel = ssr_abs_diff(tr.auc_plasma_u, auc_prev) / auc_prev
            if rel < ss_thresh && dose_i >= ss_min_dose {
                ss_streak = ss_streak + 1
            } else {
                ss_streak = 0
            }
            if ss_streak >= ss_consec {
                reached = true
                dose_of_ss = dose_i + 1
                report.c_max_ss     = cmax
                report.c_trough_ss  = ctrough
                report.auc_tau_ss   = tr.auc_plasma_u
                report.auc_icf_tau_ss = tr.auc_icf_u
            }
        }
        auc_prev = tr.auc_plasma_u

        // Carry the full state forward: all 14 PBPK compartments + BBB
        // + gut depot. This is what makes multi-dose accumulation work.
        sys_st = res.sys_st
        bbb_st = res.bbb_st
        abs_st = res.abs_st
        // Reset the per-interval released_cum counter so next dose's
        // `released_cum - released_before` delta is per-step, not cumulative.
        abs_st.released_cum = 0.0

        dose_i = dose_i + 1
    }

    report.success     = true
    report.n_doses_run = max_n
    report.reached_ss  = reached
    report.dose_of_ss  = dose_of_ss
    // 90% of plateau: end of the first interval whose AUC_tau reaches 90% of
    // the plateau. The old test compared the growth since dose 1 with itself
    // (grew >= 0.9 * (grew + 1e-12)), so it fired at dose 2 for every drug.
    // The plateau is the last simulated interval's AUC_tau, not the AUC at SS
    // declaration. For AUC_n = AUC_ss (1 - r^n), r = exp(-k_el tau), the SS
    // test |dAUC|/AUC < eps first passes with a shortfall of up to
    // r eps / (eps + 1 - r): ~7% for r ~ 0.79 and eps = 0.02, and approaching
    // 100% as r -> 1. Using it as the 90% reference would bias t_90 early.
    // The last interval is the best estimate available; it is a lower bound
    // on the plateau only when accumulation approaches from below (no
    // induction or decline). Without a detected SS, or on a failed run,
    // there is no plateau to take 90% of, so the value stays undefined (-1).
    var t_to_90: f64 = 0.0 - 1.0
    if reached {
        let plateau = report.auc_tau_per_dose[(max_n - 1) as usize]
        var j: i32 = 0
        while j < max_n && t_to_90 < 0.0 {
            if report.auc_tau_per_dose[j as usize] >= 0.9 * plateau {
                t_to_90 = ((j + 1) as f64) * regimen.tau_h
            }
            j = j + 1
        }
    }
    report.t_to_90pct_h = t_to_90
    report
}

pub fn ssr_print_report(r: SteadyStateReport) with IO, Mut, Panic, Div {
    println("Steady-state multi-dose report")
    if r.success == false {
        println("  FAILED: invalid regimen (outside 1..32 doses) or a dosing interval did not integrate; fields cover completed intervals only")
    }
    print("  n_doses_run = "); print_int(r.n_doses_run as i64); println("")
    if r.reached_ss {
        print("  reached SS at dose #"); print_int(r.dose_of_ss as i64); println("")
        print("    C_max_ss      = "); print_f64(r.c_max_ss);       println(" mg/L")
        print("    C_trough_ss   = "); print_f64(r.c_trough_ss);    println(" mg/L")
        print("    AUC_tau_ss_u  = "); print_f64(r.auc_tau_ss);     println(" mg·h/L (unbound)")
        print("    AUC_icf_tau_u = "); print_f64(r.auc_icf_tau_ss); println(" mg·h/L (unbound)")
    } else if r.success {
        // Only a completed regimen can be said to have missed steady state;
        // a failed run stopped early and the FAILED banner above says so.
        println("  did NOT converge to SS within regimen window")
    }
    if r.t_to_90pct_h >= 0.0 {
        print("  t_to_90pct_h  = "); print_f64(r.t_to_90pct_h); println("")
    } else if r.success == false {
        // A run can reach SS and then fail in a later interval; do not
        // claim SS was not reached.
        println("  t_to_90pct_h  = undefined (run incomplete)")
    } else {
        println("  t_to_90pct_h  = undefined (steady state not reached)")
    }
    println("")
    println("dose,C_max,C_trough,AUC_tau_total")
    var i: i32 = 0
    while i < r.n_doses_run {
        let idx = i as usize
        print_int((i + 1) as i64);           print(",")
        print_f64(r.c_max_per_dose[idx]);    print(",")
        print_f64(r.c_trough_per_dose[idx]); print(",")
        print_f64(r.auc_tau_per_dose[idx])
        println("")
        i = i + 1
    }
}

pub fn run_oral_multidose(
    sys_prm: PBPKParams14,
    bbb_prm: BBBParams,
    abs_prm: AbsorptionParams,
    regimen: DosingRegimen,
    bbb_dt: f64
) -> SteadyStateReport with Mut, Div, Panic {
    run_oral_multidose_cfg(sys_prm, bbb_prm, abs_prm, regimen, bbb_dt, tight_ode_config())
}
