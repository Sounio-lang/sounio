// stdlib/darwin_pbpk/scenarios/vancomycin_iv.sio — scenario library (no main)
//
// End-to-end dissertation scenario for vancomycin (SIO-519):
//
//   - Single 1000 mg IV INFUSION over 1.0 h (label rate; never bolus push)
//     → zero-order blood input (rate = Dose/Tinf on [0, Tinf], 0 after,
//       operator-split source term)
//         → 14-compartment PBPK28 (tsit5_pbpk28, fully-coupled CN)
//         → predominantly renal sink: CL = 5.18 L/h (Matzke 1984 at normal
//           CrCl 120 mL/min: 0.689·120+3.66 mL/min)
//
// Mold: scenarios/lithium_oral.sio (scenario-owned profile + parity-ref
// shape) with the input law swapped from first-order gut absorption to
// zero-order infusion. The infusion path does NOT touch the clamped CN
// bolus kernel audited in SIO-504 (explicit condition on the card).
//
// Plasma referenced (rb ≈ 1; fu 0.45 documented — PBPK28 clears total
// blood Cb, matching how the Matzke CL is defined on total plasma).
// Glycopeptide (MW 1449 Da): ECF-distributed; Kp from ECF rationale +
// measured poor BBB (brain 0.1), NOT from lipophilic-neutral predictors.
// Vd ≈ 45 L vs 2-comp 49 L (Roberts Vc+Vp) — residual is uncharacterized
// slow tissue, follow-up. PS flow-limited except brain/adipose/bone
// (measured slow/excluded), SIO-550.
//
// Declared limitation: single infusion only. No CrCl-impairment variant,
// no AUC24/MIC TDM readout, no steady-state q12h — follow-ups. No
// clinical-validity claim: parity only (ADR009).
//
// The parity ref tests/run-pass/dissertation_pbpk28_parity_ref_vancomycin.sio
// drives this scenario itself, so a scenario change not mirrored in Node
// breaks the gate.
//
// This file is a library with no `main`; it is checked, not run.

use darwin_pbpk::core::pbpk28_params::*
use darwin_pbpk::tsit5_pbpk28::*
use darwin_pbpk::drugs::vancomycin::*

// ─── Vancomycin PBPK28 profile (scenario-owned) ─────────────────────────────
// Kept here — not in core/pbpk28_params.sio — so this lane never churns the
// website-pinned domain source. Standard 70 kg, normal renal function.
// Kp = vancomycin tissue values from drugs/vancomycin.sio rationale
// (Vd ~45 L); PS flow-limited except brain/adipose/bone (SIO-550);
// CL = 5.18 L/h (Matzke 1984 at CrCl 120).
pub fn vnc_pbpk28_params() -> PBPKParams28 {
    PBPKParams28 {
        v_ref:     [5.0, 1.8, 0.31, 1.45, 0.33, 1.1, 28.0, 20.0, 1.2, 3.6, 6.6, 0.18, 0.09, 3.7],
        vasc_frac: [1.000, 0.210, 0.160, 0.037, 0.262, 0.262, 0.040, 0.050, 0.024, 0.019, 0.041, 0.282, 0.180, 0.050],
        kp:        [1.00, 0.6, 1.0, 0.1, 0.6, 0.6, 0.9, 0.2, 0.6, 0.5, 0.3, 0.6, 0.6, 0.9],
        ps:        [0.0, 90.0, 74.0, 2.0, 16.0, 350.0, 42.0, 5.0, 55.0, 21.0, 8.0, 10.0, 8.0, 13.0],
        q:         [350.0, 90.0, 74.0, 44.0, 16.0, 350.0, 42.0, 10.0, 55.0, 21.0, 17.0, 10.0, 8.0, 13.0],
        cl_central: 5.18,
    }
}

// ─── Zero-order IV infusion ─────────────────────────────────────────────────
// rate(t) = Dose/Tinf on [0, Tinf], 0 after. D = 1000 mg, Tinf = 1.0 h
// (label rate; never bolus push). Mid-point evaluation keeps both engines
// on the same rate function, including the step straddling Tinf.
pub fn vnc_dose_mg() -> f64 { return vancomycin_single_dose_mg() }
pub fn vnc_tinf() -> f64    { return vancomycin_infusion_h() }

pub fn vnc_release_rate_at(t: f64) -> f64 with Mut, Div {
    if t < 0.0 { return 0.0 }
    if t <= vnc_tinf() { return vnc_dose_mg() / vnc_tinf() }
    return 0.0
}

// ─── Composite scenario state ───────────────────────────────────────────────
pub struct VancomycinScenario {
    pub pbpk: PBPKState28,
}

// Initial state: zero PBPK (drug enters via IV infusion).
pub fn vnc_scenario_init() -> VancomycinScenario {
    VancomycinScenario {
        pbpk: pbpk28_state_zero(),
    }
}

// One fully-coupled CN step at midpoint input rate.
pub fn vnc_step(scen: VancomycinScenario, p: PBPKParams28,
                t_start: f64, dt: f64)
    -> VancomycinScenario with Mut, Div
{
    let rel_mid = vnc_release_rate_at(t_start + 0.5 * dt)
    var out_pbpk = pbpk28_full_cn_step(scen.pbpk, p, rel_mid, dt)
    return VancomycinScenario { pbpk: out_pbpk }
}
