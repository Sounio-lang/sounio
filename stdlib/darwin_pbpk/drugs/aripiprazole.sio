// darwin_pbpk/drugs/aripiprazole.sio — Aripiprazole PBPK28 Parameters
//
// Aripiprazole (MW 448.39) is a quinolinone D2 partial agonist, eliminated
// almost entirely by hepatic metabolism through two parallel CYP isozymes,
// CYP2D6 and CYP3A4, to the active metabolite dehydro-aripiprazole (which
// supplies ~40% of total exposure — modelled in a follow-up, explicitly
// out of scope here). The ~75 h half-life tests the integrator on an
// extended 336 h horizon.
//
// FDA Abilify label 12.3 Pharmacokinetics [MEASURED]:
//   absolute oral bioavailability F = 0.87 (tablet); Tmax 3-5 h;
//   steady-state Vd 404 L (4.9 L/kg IV); 99% protein bound;
//   parent t1/2 ~75 h, CYP2D6 poor metabolisers ~146 h;
//   dehydro-aripiprazole t1/2 ~94 h;
//   elimination mainly hepatic via CYP2D6 and CYP3A4 (<1% urinary unchanged).
// Boulton et al., Clin Pharmacokinet 47:475-485 [ARCHETYPE, verified
// DOI 10.2165/00003088-200847070-00004, PMID 18563956]: IV + oral + IM data.
//
// DERIVED then CALIBRATED (arithmetic on measured anchors first):
//   blood-referenced CL_total_NM = ln2*404/75 = 3.73 L/h;
//   CL_PM = ln2*404/146 = 1.92 L/h (no 2D6, so CL_3A4+other = 1.92);
//   CL_2D6_NM = 3.73 - 1.92 = 1.81 L/h (pathways co-dominant ~49/51).
//   The kernel sink acts on liver-average concentration (tissue-enriched
//   over blood), so these blood-referenced values over-clear ~6.9x when
//   transferred 1:1 (emergent t1/2 20.5 h). The kernel values (3A4 0.23,
//   2D6 0.21, total 0.44) are CALIBRATED in four steps (x0.273, x0.531,
//   x0.852, x0.957) so the emergent NM terminal half-life is 75.0 h,
//   the label anchor. Independent PM cross-check (2D6 off): emergent
//   132 h vs label 146 h (10% under) — confirms the 3A4:2D6 pathway split
//   within the model's distribution limits.
// ASSUMED (declared): Kp pattern targeting label Vd (~410 L vs 404 L,
//   verified arithmetically); PS flow-limited except brain/adipose/bone
//   (SIO-550, CNS exception for brain); ka = 1.2/h calibrated to
//   Tmax ~4.1 h, immediate gut availability (no lag); phenotype formation
//   scale by CPIC activity-score logic (PM 0 / IM 0.5 / NM 1 / UM 1.5, PM
//   label-derived); single 15 mg oral IR tablet; dehydro out of scope
//   (follow-up).
// No clinical-validity claim: parity only (ADR009).

pub fn aripiprazole_mw() -> f64 { return 448.39 }

// Single 15 mg oral IR tablet (Abilify standard single dose).
pub fn aripiprazole_single_dose_mg() -> f64 { return 15.0 }
pub fn aripiprazole_f_oral() -> f64 { return 0.87 }
pub fn aripiprazole_ka_per_h() -> f64 { return 1.2 }

// Parallel hepatic clearances (L/h, CALIBRATED — see header).
// cl_central is 0: elimination is entirely the two CYP liver sinks,
// folded into one implicit liver sink (linear sinks add exactly).
// The kernel sink acts on the liver-average concentration (tissue-
// enriched ~9.7x over blood at equilibrium), so the blood-referenced
// label clearances (3.73 total, 1.92 3A4) do NOT transfer 1:1; the
// kernel values below are calibrated so the emergent terminal half-life
// reproduces the label anchors (NM 75 h; PM cross-check ~146 h).
pub fn aripiprazole_cl_central() -> f64 { return 0.0 }
pub fn aripiprazole_cl_3a4() -> f64 { return 0.23 }
pub fn aripiprazole_cl_2d6_nm() -> f64 { return 0.21 }

// CYP2D6 pathway scale by phenotype (darwin_pbpk convention:
// 0=PM, 1=IM, 2=NM, 3=UM). PM 0.0 label-derived (t1/2 146 h carries no
// 2D6); IM/UM CPIC activity-score logic (declared).
pub fn aripiprazole_2d6_scale(pheno: i32) -> f64 {
    if pheno == 0 { return 0.0 }
    if pheno == 1 { return 0.5 }
    if pheno == 2 { return 1.0 }
    return 1.5
}

pub fn aripiprazole_cl_cyp(pheno: i32) -> f64 {
    return aripiprazole_cl_3a4() + aripiprazole_cl_2d6_nm() * aripiprazole_2d6_scale(pheno)
}

// NM (2) is the parity reference phenotype.
pub fn aripiprazole_pheno_nm() -> i32 { return 2 }
