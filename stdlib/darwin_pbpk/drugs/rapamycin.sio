// darwin_pbpk/drugs/rapamycin.sio — Rapamycin (Sirolimus) PBPK Parameters
//
// Epistemic priors for sirolimus based on published pharmacokinetic literature.
//
// Key pharmacological identity:
//   - mTOR inhibitor, immunosuppressant (Wyeth/Pfizer, 1999)
//   - CYP3A4/P-gp substrate: high CYP3A4 inter-individual variability (CV~60%)
//   - Very low oral bioavailability (~15%): significant first-pass effect
//   - P-gp efflux at BBB: extremely low CNS penetration (kp_brain~0.07-0.12)
//   - Strong protein binding (92%): fu_plasma = 0.08
//
// Literature sources:
//   - Ferron GM et al. (1997) Clin Pharmacol Ther: CL=12.4 L/h, CV=58%
//   - Kahan BD et al. (2001) J Clin Pharmacol: Vd=12 L/kg
//   - Schreiber SL et al. (1991) JACS: fu_plasma=0.08 (in vitro)
//   - Lampen A et al. (1998) Biochem Pharmacol: P-gp substrate, brain/plasma~0.07-0.12
//   - MacDonald A et al. (2000) Transplantation: ka=1.1/h (oral absorption)
//
// Epistemic note on confidence scores:
//   Confidence values [0,1] represent evidence quality, NOT a Beta posterior.
//   Beta is appropriate for fraction-bounded quantities (fu, Kp); for CL (0,∞)
//   and Ka (0,∞) we use a normalized evidence score based on:
//     - number of independent studies (n), consistency across populations,
//     - whether data are from in vivo (higher) or in vitro (lower)
//
//   Confidence scoring heuristic:
//     0.4-0.5: single in vitro study, small n
//     0.5-0.65: single in vivo study, moderate n (10-30 patients)
//     0.65-0.80: replicated in vivo, n>30, consistent
//     0.80-0.95: meta-analysis or regulatory submission-grade data

use darwin_pbpk::tsit5_pbpk14::*;

// ============================================================================
// MATH HELPERS (local, to avoid relying on import availability)
// ============================================================================

fn rapa_sqrt_drug(x: f64) -> f64 {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 10 {
        y = (y + x / y) * 0.5
        i = i + 1
    }
    return y
}

// ============================================================================
// RAPAMYCIN MEAN PARAMETERS
// ============================================================================
// Returns a PBPKParams14 tuned for rapamycin mean pharmacokinetics.
//
// Note on peripheral volume:
//   Real rapamycin Vd ~ 12 L/kg = 840 L (70 kg adult), driven by deep adipose
//   sequestration (kp_adipose ~ 15). For a 48h simulation this gives t1/2 ~300h
//   (only 15% eliminated), making CL insensitive in this window.
//
//   This module uses a "distribution-capped" model (kp_periph=0.5, v_periph=50 L)
//   representing rapidly equilibrating tissues only, giving t1/2 ~ 21h.
//   The BBB-limited brain compartment (kp_brain=0.08) is preserved accurately.
//   Deep adipose distribution is OUT OF SCOPE for a 48h BBB focus study.
//   For multi-day deep-tissue studies, use the full 14-compartment tsit5 model.

pub fn rapamycin_mean_params() -> PBPKParams14 {
    var prm = default_pbpk_params()

    // Clearance: CYP3A4-dominated, fu_plasma=0.08 unbound cleared
    prm.cl_hepatic = 12.4    // L/h (Ferron 1997)
    prm.cl_renal = 0.3       // L/h (minimal — rapamycin not renally cleared)

    // Binding: strong plasma protein binding
    prm.fu_plasma = 0.08     // Schreiber 1991
    prm.rb_ratio = 0.58      // Blood:plasma (modest RBC binding)

    // Brain: P-gp efflux limits CNS penetration significantly
    prm.kp_brain = 0.08      // Lampen 1998 (P-gp substrate)

    // Other key compartments (literature-based estimates)
    prm.kp_liver = 8.0       // High hepatic uptake (site of CYP3A4 metabolism)
    prm.kp_lung = 10.0       // Moderate lung accumulation (known)
    prm.kp_kidney = 4.0      // Moderate
    prm.kp_heart = 3.5

    // Peripheral: capped at v_other=50L for 48h BBB-focus model
    // (represents fast-equilibrating muscle, skin, bone only)
    prm.kp_other = 0.5       // Distribution cap for short simulation

    // Gut, spleen, pancreas: moderate distribution
    prm.kp_gut = 5.0
    prm.kp_spleen = 6.0
    prm.kp_pancreas = 4.0
    prm.kp_muscle = 3.5
    prm.kp_adipose = 0.3     // Adipose capped (deep compartment excluded)
    prm.kp_skin = 2.0
    prm.kp_bone = 1.5

    return prm
}

// ============================================================================
// RAPAMYCIN FULL-Vd PARAMETERS
// ============================================================================
// Unlike rapamycin_mean_params() (48h BBB-focus with distribution cap),
// this parameterisation restores the real deep-adipose sequestration
// that drives rapamycin's clinical apparent volume of distribution
// Vd ~ 12 L/kg = 840 L for a 70 kg adult (Kahan 2001).
//
// Vd = V_blood + Σ (V_tissue × Kp_tissue). The dominant contribution
// is adipose: V_adipose = 15 L, and lipophilicity gives Kp_adipose ~ 50
// (contribution 750 L). Plus existing high-Kp liver/lung/muscle
// compartments (~60 L contribution). Total Vd ≈ 5 + 750 + ~80 = ~835 L,
// matching the literature target.
//
// Elimination half-life with this Vd:
//   t½ = ln(2) × Vd / CL = 0.693 × 840 / 12.4 ≈ 47 h
// Literature reports 47–62 h (Ferron 1997, Kahan 2001). Close enough
// for multi-day steady-state studies, where it matters that t½ > τ so
// accumulation is non-trivial.
//
// Use this function when simulating regimens longer than ~48 h. Keep
// the capped rapamycin_mean_params() for single-dose BBB studies where
// the added stiffness (v_adipose large, slow adipose equilibration)
// would inflate integration cost without changing the short-horizon
// conclusion.

pub fn rapamycin_fullvd_params() -> PBPKParams14 {
    var prm = default_pbpk_params()

    // --- Clearance ---------------------------------------------------------
    //
    // The PBPK ODE (tsit5_pbpk14.sio:360) applies:
    //   dC/dt ⊃ −(CL / V_blood) · c_unbound · rb_ratio
    // where c_unbound = c_plasma · fu_plasma and c_plasma = c_blood / rb.
    // rb_ratio therefore cancels in the clearance term, and CL acts on
    // unbound drug. With CL_emp = 12.4 L/h (Ferron 1997, whole-blood
    // apparent clearance) and fu_plasma = 0.08, the intrinsic-unbound
    // clearance that enters the ODE is CL_int = CL_emp / fu = 155 L/h.
    prm.cl_hepatic = 155.0
    prm.cl_renal = 3.75

    // --- Binding -----------------------------------------------------------
    //
    // fu_plasma = 0.08: Schreiber 1991 (in vitro equilibrium dialysis).
    //
    // rb_ratio = 36: Yatscoff 1995 whole-blood / plasma partitioning —
    // rapamycin is sequestered in erythrocyte FKBP12. The ODE treats
    // rb_ratio as c_blood / c_plasma. With rb large, the plasma pool
    // driving tissue uptake is small relative to whole blood, so blood
    // drug is protected from rapid distribution — which is the right
    // physiology for an RBC-bound drug.
    prm.fu_plasma = 0.08
    prm.rb_ratio = 36.0

    // --- Partition coefficients (literature in vivo Kp) --------------------
    //
    // Rapamycin tissue-to-plasma ratios from rodent and clinical PET
    // literature (Lampen 1998; Serkova 2000; Napoli 2001). Kept at
    // physiological values — the permeability cap below is what
    // controls alpha-phase peak dynamics.
    prm.kp_brain = 0.08        // Lampen 1998 (P-gp efflux at BBB)
    prm.kp_liver = 8.0         // High hepatic uptake (CYP3A4 site)
    prm.kp_lung  = 10.0
    prm.kp_kidney = 4.0
    prm.kp_heart = 3.5
    prm.kp_muscle = 3.5
    prm.kp_gut = 5.0
    prm.kp_spleen = 6.0
    prm.kp_pancreas = 4.0
    prm.kp_skin = 2.0
    prm.kp_bone = 1.5
    prm.kp_other = 2.0
    // Deep adipose: dominant sequestration.
    //
    // Target clinical Vd_ss (IV-equivalent, blood-referenced):
    //   Vd_ss/F = 12 L/kg × 70 kg = 840 L (Kahan 2001).
    //   With F = 0.14, Vd_ss_true = 840 × 0.14 ≈ 118 L.
    //
    // In this 14-compartment ODE, equilibrium blood concentration
    // obeys mass balance
    //   dose × F = c_blood × (V_blood + Σ V_t × Kp_t / rb_ratio)
    // so the effective Vd (blood-referenced) is
    //   Vd_eff = V_blood + Σ V_t × Kp_t / rb_ratio.
    //
    // With rb_ratio = 36 and Σ V_t × Kp_t for fast tissues ≈ 165,
    // matching Vd_eff = 118 L requires
    //   118 = 5 + (165 + 15 × Kp_adipose) / 36
    //   Kp_adipose = (113 × 36 − 165) / 15 = 260.
    //
    // This high Kp reflects how strongly rapamycin partitions into
    // adipose tissue (lipophilicity + long intracellular residence
    // via FKBP12 / LLC-PK1 binding).
    prm.kp_adipose = 260.0

    // --- Permeability caps (PS×PAE proxy via effective Q) ------------------
    //
    // The 14-compartment ODE is flow-limited: tissue flux is
    //   (Q / V_t) · (c_plasma − c_tissue / Kp)
    // The ODE has no dedicated PS term, so we represent permeability-
    // limited tissues by substituting Q → min(Q_physiological, PS×PAE).
    // This preserves the same ODE structure while giving each tissue
    // its correct uptake timescale.
    //
    // Rapamycin is lipophilic and passively diffuses, but its slow
    // membrane crossing is well-documented (Serkova 2000 microdialysis;
    // Scharfmann 2002 isolated islet uptake). Effective PS estimates:
    //
    //   tissue     Q_phys (L/h)  PS_lit (L/h)  Q_effective = min
    //   muscle        75             5             5
    //   adipose       12             0.2           0.2
    //   bone           5             0.5           0.5
    //   skin          10             2             2
    //
    // q_adipose = 0.2 is set tight to reproduce the clinical terminal
    // t½ ≈ 47 h (Ferron 1997). With V_adipose = 15 L and Kp = 260,
    // adipose release is rate-limiting: release rate constant
    //   k_rel = Q_adipose / V_adipose = 0.2 / 15 = 0.013 / h
    //   t½_β = 0.693 / 0.013 ≈ 52 h.
    //
    // Hepatic Q is also capped on this calibration: with Kp_liver = 8
    // and the physiologic Q_liver = 90 L/h, liver drains blood at
    // 90/5 = 18 / h which eats the dose before adipose can fill. The
    // in-vivo rapamycin hepatic clearance is CYP3A4-limited, not
    // flow-limited — so effective hepatic PS is closer to CL_int / Kp_liver
    // ≈ 155 / 8 ≈ 20 L/h, and that is what we use as the effective Q.
    prm.q_muscle  = 5.0
    prm.q_adipose = 0.2
    prm.q_bone    = 0.5
    prm.q_skin    = 2.0
    prm.q_liver   = 20.0
    prm.q_lung    = 30.0   // lung not a sink (Kp·V = 5 L); cap flow
                           // proportionally so α-phase isn't dominated
                           // by lung transit
    prm.q_kidney  = 8.0
    prm.q_heart   = 5.0
    prm.q_gut     = 10.0
    prm.q_spleen  = 3.0
    prm.q_pancreas = 1.0
    prm.q_other   = 5.0
    // Brain Q kept at 50 — brain is BBB-limited via Kp_brain = 0.08.

    return prm
}

// ============================================================================
// EPISTEMIC VARIANCE PRIORS
// ============================================================================
// Each uncertain parameter has: mean, variance (SD^2), confidence [0,1]
//
// Confidence is NOT a Beta distribution for unbounded parameters (CL, Ka).
// It is an evidence-quality score normalized to [0,1] (see header).

struct RapamycinEpParam {
    mean: f64,
    variance: f64,     // SD^2 — quantifies epistemic spread (GUM Var)
    confidence: f64,   // Evidence quality score [0,1]
}

fn rapa_ep_param(mean: f64, variance: f64, confidence: f64) -> RapamycinEpParam {
    RapamycinEpParam {
        mean: mean,
        variance: variance,
        confidence: confidence,
    }
}

fn rapa_ep_cv(ep: &RapamycinEpParam) -> f64 {
    let sig = rapa_sqrt_drug(ep.variance)
    if ep.mean > 1.0e-12 || ep.mean < 0.0 - 1.0e-12 {
        let abs_mean = if ep.mean < 0.0 { 0.0 - ep.mean } else { ep.mean }
        return sig / abs_mean
    }
    return 0.0
}

struct RapamycinPriors {
    // CL_hepatic: CYP3A4-dominated clearance
    // Large variance (SD=7.4, CV=60%) from CYP3A4 polymorphism
    // Source: Ferron 1997, population PK n=24
    cl_hepatic: RapamycinEpParam,

    // kp_brain: brain:plasma partition coefficient
    // Uncertainty from limited in vivo CNS measurement data
    // Source: Lampen 1998 (in vitro P-gp assay), range 0.07-0.12 in vivo
    kp_brain: RapamycinEpParam,

    // fu_plasma: unbound fraction in plasma
    // Well-characterized in vitro, but in vivo may differ (disease states)
    // Source: Schreiber 1991 (in vitro equilibrium dialysis)
    fu_plasma: RapamycinEpParam,

    // u_kp: Rodgers-Rowland scaled GUM uncertainty for each of 14 tissues.
    // u_Kp_i = Kp_lit_i × sqrt((ln10 × u_logP)² + (u_fu/fu)²)
    // High-logP approximation: log_sens ≈ ln10 for all tissues at logP=7.
    // Source: Rodgers & Rowland (2006); Vaidyanathan 2001 (logP)
    u_kp: [f64; 14],

    // fu_unc: GNN molecular property inference σ(fu)
    // From 3-layer dense GNN forward pass with σ_W=0.01 weights.
    // Source: darwin-pbpk-platform gnn_inference.sio T4 output
    fu_unc: f64,

    // cl_unc: GNN molecular property inference σ(CL)
    // Source: darwin-pbpk-platform gnn_inference.sio T4 output
    cl_unc: f64,
}

fn rapamycin_priors() -> RapamycinPriors with Mut {
    // CL: SD = 7.4 L/h (CV = 7.4/12.4 = 60%), evidence score 0.65
    let cl_prior = rapa_ep_param(12.4, 54.76, 0.65)

    // kp_brain: mean=0.08, SD=0.025 (range 0.07-0.12 in literature)
    // Low confidence: only indirect evidence from P-gp efflux ratios
    let kp_brain_prior = rapa_ep_param(0.08, 0.000625, 0.55)

    // fu_plasma: mean=0.08, SD=0.02 (well-characterized in vitro)
    // Good confidence: multiple replicated in vitro studies
    let fu_prior = rapa_ep_param(0.08, 0.0004, 0.72)

    // R-R scaled GUM uncertainties for 14 tissues (14-comp ordering):
    //   0=blood, 1=liver, 2=kidney, 3=brain, 4=heart, 5=lung, 6=muscle,
    //   7=adipose, 8=gut, 9=skin, 10=bone, 11=spleen, 12=pancreas, 13=other
    // u_Kp_i = Kp_lit_i × sqrt((ln10×u_logP)² + (u_fu/fu)²)
    //        = Kp_lit_i × 2.4306   (high-logP limit, exact at logP=7)
    // Scale factor: sqrt((2.302585×1.05)² + (0.02/0.08)²) = sqrt(5.8453+0.0625) = 2.4306
    let rr_scale = 2.4306
    var u_kp: [f64; 14] = [0.0; 14]
    u_kp[0]  = 1.0    * rr_scale   // blood   kp=1.0
    u_kp[1]  = 8.0    * rr_scale   // liver   kp=8.0
    u_kp[2]  = 4.0    * rr_scale   // kidney  kp=4.0
    u_kp[3]  = 0.08   * rr_scale   // brain   kp=0.08  (R-R component; Lampen SD=0.025 is separate)
    u_kp[4]  = 3.5    * rr_scale   // heart   kp=3.5
    u_kp[5]  = 10.0   * rr_scale   // lung    kp=10.0
    u_kp[6]  = 3.5    * rr_scale   // muscle  kp=3.5
    u_kp[7]  = 0.3    * rr_scale   // adipose kp=0.3   (capped model)
    u_kp[8]  = 5.0    * rr_scale   // gut     kp=5.0
    u_kp[9]  = 2.0    * rr_scale   // skin    kp=2.0
    u_kp[10] = 1.5    * rr_scale   // bone    kp=1.5
    u_kp[11] = 6.0    * rr_scale   // spleen  kp=6.0
    u_kp[12] = 4.0    * rr_scale   // pancreas kp=4.0
    u_kp[13] = 0.5    * rr_scale   // other   kp=0.5

    // GNN uncertainties from 3-layer dense forward pass (darwin gnn_inference.sio)
    // W=0 weights, σ_W=0.01, biases calibrated to population means
    let fu_unc = 0.000736    // σ(fu) from GUM through 25→64→32→sigmoid
    let cl_unc = 0.000009    // σ(CL) from GUM through 25→64→32→softplus

    RapamycinPriors {
        cl_hepatic: cl_prior,
        kp_brain: kp_brain_prior,
        fu_plasma: fu_prior,
        u_kp: u_kp,
        fu_unc: fu_unc,
        cl_unc: cl_unc,
    }
}
