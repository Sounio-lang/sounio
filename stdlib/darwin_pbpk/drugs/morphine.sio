// morphine.sio — Morphine systemic PBPK (adult 70 kg anchor) + pediatric
// ontogeny (UGT2B7 conjugation × OCT1 hepatic uptake) + ontology annotations.
//
// Sétimo composto canônico da suíte; opioide de ALTA extração hidrofílico,
// padrão-ouro de rotação no desmame de fentanil em UTI pediátrica (HMMG).
// Módulo da Fase 6 do estudo "Uncertainty-quantified PBPK modeling of opioid
// weaning in critically ill children" (Agourakis DC, 2026).
//
// MECANISMO (diferencial deste módulo): em neonatos, a eliminação da morfina
// é limitada em CASCATA por (1) uptake hepático via OCT1 (SLC22A1) e
// (2) conjugação via UGT2B7 → M3G (~55%) / M6G (~10%, ativo). A proteína
// OCT1 é baixa ao nascimento e matura no 1º ano (Hahn 2019; Emoto/Liu 2018
// PBPK); UGT2B7 idem (Badée 2019, recomendações de ontogenia UGT). Modelamos
// o clearance intrínseco escalado por min(r_UGT2B7, r_OCT1) — o elo mais
// fraco da cascata — e o clearance hepático resultante via well-stirred,
// capturando a transição flow-limited (adulto) → uptake/metabolism-limited
// (neonato). M6G/renal: fora de escopo (camada futura; relevante em IR).
//
// PARÂMETROS-CHAVE ADULTO (70 kg):
//   fu = 0.70 (ligação 20–35% albumina; Mazoit 2007, Dershwitz 1996)
//   B/P = 1.0 · MW 285.34 · pKa 8.21 · logP 0.89 (base fraca hidrofílica)
//   CL total = 84 L/h (1.2 L/h/kg; faixa 60–105: Mazoit 2007, Särkelä 1991,
//             Lotsch 2002) · 90% hepático UGT / 10% renal inalterado
//   Vss lit. 3.3 L/kg = 231 L (Mazoit 2007: V1 22.7 L); modelo (Kp × V
//   PBPK28 abaixo) reproduz 166 L = 2.4 L/kg (−28%; math-review
//   xai/zai 2026-08-13 confirmou a aritmética do modelo E flagrou a
//   lacuna vs. o alvo — TENSÃO real, não corrigida aqui: reduzir a −28%
//   exigiria retunar Kp/volumes, decisão de calibração fora do escopo
//   desta correção de PR; faixa publicada 1–6 L/kg cobre ambos)
//   t½ terminal 2–3h (obs 1.7–4h)
//
// PEDIATRIA (âncoras de validação, literatura):
//   Neonato a termo: CL ≈ 2–8 mL/min/kg = 0.12–0.48 L/h/kg (Bouwmeester
//     2004; Lynn 1998 — ampla IIV documentada, CV ~50%)
//   Lactente 6m: CL/kg se aproxima do adulto (≥80%; Mazoit 2007 alométrico)
//   1–16 anos: CL alométrico ≈ adulto por kg (Mazoit 2007)
//
// ONTOGENIA (premissas declaradas, cobertas pelo GUM):
//   r_UGT2B7(d) = 0.05 + 0.95·Hill(d; A50=60d, h=1.7)   [Badée 2019]
//   r_OCT1(d)  = 0.10 + 0.90·Hill(d; A50=90d, h=2.0)   [Hahn 2019/2021]
//   CLint(d) = CLint_adult × min(r_UGT2B7, r_OCT1)
// Cross-check Fase 6 (corrigido 2026-08-13, review PR #1714 — valores
// anteriores eram estimativa manual, não batiam com morphine_cl_eff_lh()):
// neonato 7d/3.5kg → CL/kg = 0.369 L/h/kg (dentro do alvo Bouwmeester/Lynn
// 0.12–0.48); lactente 120d/6.5kg → CL/kg = 1.084 L/h/kg = 90% do
// adulto/kg (84/70=1.2) — já ≥80% aos 4 meses, não apenas "a partir de
// ~6m" como a nota antiga sugeria. ✓ (math-review xai/zai independente,
// ver .claude/llm_offload_log.md)
//
// ONTOLOGIA (padrão stdlib/ontology: namespaces + triplas i64):
//   (morfina, is_a, analgésico opioide) · (morfina, metabolized_by, UGT2B7)
//   (morfina, transported_by, OCT1/SLC22A1) · (UGT2B7, has_ontogeny, maturação)
//   IDs externos de REFERÊNCIA (verificar contra releases oficiais SNOMED CT/
//   ATC/RxNorm/ChEBI antes de publicar): ATC N02AA01 · RxNorm 7052 ·
//   ChEBI CHEBI:17303 · SNOMED 373529000.
//
// Units: L, L/h, mg/L (= µg/mL). Convenção de clearance idêntica a
// fentanyl.sio (ODE aplica cl sobre não-livre: CL_eff = cl·fu·rb).

use darwin_pbpk::tsit5_pbpk14::{PBPKParams14}

// ─── Ontologia (anotação; IDs de referência — VERIFY antes de publicar) ─────
// namespaces (stdlib/ontology/namespaces.sio): SNOMED=100 · RxNorm=105 (local)
// · ATC=106 (local) · ChEBI=107 (local) · DARWIN_PK=900 (predicados)
pub let ONT_NS_ATC: i64 = 106
pub let ONT_NS_RXNORM: i64 = 105
pub let ONT_NS_CHEBI: i64 = 107
pub let ONT_NS_DARWIN_PK: i64 = 900

pub let MORPHINE_ATC_N02AA01: i64 = 1060201        // ATC N02AA01 (codificado)
pub let MORPHINE_RXNORM_7052: i64 = 1057052        // RxNorm CUI 7052
pub let MORPHINE_CHEBI_17303: i64 = 10717303       // ChEBI:17303
pub let ENZYME_UGT2B7: i64 = 9001001               // DARWIN_PK:UGT2B7
pub let TRANSPORTER_OCT1_SLC22A1: i64 = 9001002    // DARWIN_PK:OCT1
pub let CLASS_OPIOID_ANALGESIC: i64 = 9002001      // DARWIN_PK:opioid
pub let PRED_IS_A: i64 = 9000010
pub let PRED_METABOLIZED_BY: i64 = 9000011
pub let PRED_TRANSPORTED_BY: i64 = 9000012
pub let PRED_HAS_ONTOGENY: i64 = 9000013
pub let MATURATION_FIRST_YEAR: i64 = 9003001

// Triplas (subj, pred, obj) — cache plano, padrão stdlib/ontology.
pub fn morphine_ontology_subj() -> [i64; 6] {
    [MORPHINE_CHEBI_17303, MORPHINE_CHEBI_17303, MORPHINE_CHEBI_17303,
     MORPHINE_CHEBI_17303, ENZYME_UGT2B7, TRANSPORTER_OCT1_SLC22A1]
}
pub fn morphine_ontology_pred() -> [i64; 6] {
    [PRED_IS_A, PRED_METABOLIZED_BY, PRED_TRANSPORTED_BY,
     PRED_IS_A, PRED_HAS_ONTOGENY, PRED_HAS_ONTOGENY]
}
pub fn morphine_ontology_obj() -> [i64; 6] {
    [CLASS_OPIOID_ANALGESIC, ENZYME_UGT2B7, TRANSPORTER_OCT1_SLC22A1,
     MORPHINE_ATC_N02AA01, MATURATION_FIRST_YEAR, MATURATION_FIRST_YEAR]
}

// ─── Físico-química / ligação (referências no cabeçalho) ────────────────────
pub fn morphine_fu() -> f64 { return 0.70 }
pub fn morphine_rb() -> f64 { return 1.0 }

// ─── Ontogenia ──────────────────────────────────────────────────────────────
fn powf_local(b: f64, e: f64) -> f64 with Mut {
    // b^e para b>0 via exp/ln (série; |ln b| moderado no domínio de uso)
    if b <= 0.0 { return 0.0 }
    let l = ln_local(b)
    return exp_local(e * l)
}
fn exp_local(x: f64) -> f64 with Mut {
    if x > 20.0 {
        let h = exp_local(x / 2.0)
        return h * h
    }
    if x < 0.0 - 20.0 { return 1.0 / exp_local(0.0 - x) }
    var sum = 1.0
    var term = 1.0
    var i = 1.0
    while i <= 20.0 {
        term = term * x / i
        sum = sum + term
        i = i + 1.0
    }
    return sum
}
fn ln_local(x: f64) -> f64 with Mut {
    if x <= 0.0 { return 0.0 - 1000000.0 }
    if x == 1.0 { return 0.0 }
    if x > 1.5 { return 2.0 * ln_local(sqrt_local(x)) }
    if x < 0.7 { return 0.0 - ln_local(1.0 / x) }
    let u = x - 1.0
    var sum = 0.0
    var term = u
    var i = 1.0
    while i <= 30.0 {
        sum = sum + term / i
        term = 0.0 - term * u
        i = i + 1.0
    }
    return sum
}
fn sqrt_local(x: f64) -> f64 with Mut {
    if x <= 0.0 { return 0.0 }
    var guess = x / 2.0
    if guess < 1.0 { guess = 1.0 }
    var i = 0.0
    while i < 20.0 {
        guess = (guess + x / guess) / 2.0
        i = i + 1.0
    }
    return guess
}

// Fração da atividade adulta de UGT2B7 (Badée 2019; premissa Fase 6)
pub fn r_ugt2b7(pna_days: f64) -> f64 with Mut {
    let x = pna_days / 60.0
    let h = powf_local(x, 1.7)
    return 0.05 + 0.95 * h / (1.0 + h)
}
// Fração da abundância adulta de OCT1 (Hahn 2019/2021; premissa Fase 6)
pub fn r_oct1(pna_days: f64) -> f64 with Mut {
    let x = pna_days / 90.0
    let h = powf_local(x, 2.0)
    return 0.10 + 0.90 * h / (1.0 + h)
}
// Elo limitante da cascata uptake→conjugação
pub fn r_cascade(pna_days: f64) -> f64 with Mut {
    let a = r_ugt2b7(pna_days)
    let b = r_oct1(pna_days)
    if a < b { return a }
    return b
}

// ─── Clearance intrínseco adulto (well-stirred invertido) ───────────────────
// CL_h adulto = 75.6 L/h (0.9×84); Q_liver = 90 L/h; fu = 0.70
// CLint = CL_h·Q / (fu·(Q − CL_h)) = 75.6·90 / (0.70·14.4) ≈ 675 L/h
pub fn morphine_clint_adult() -> f64 { return 675.0 }

// ─── PBPK14 adulto (70 kg) ──────────────────────────────────────────────────
fn morphine_params_with_clh(cl_h_eff: f64) -> PBPKParams14 with Div {
    let fu: f64 = 0.70
    let rb: f64 = 1.0
    PBPKParams14 {
        // Volumes (L) — template da suíte (70 kg)
        v_blood: 5.2, v_liver: 1.69, v_kidney: 0.31, v_brain: 1.37,
        v_heart: 0.31, v_lung: 1.17, v_muscle: 29.0, v_adipose: 18.2,
        v_gut: 1.65, v_skin: 7.8, v_bone: 10.5, v_spleen: 0.19,
        v_pancreas: 0.14, v_other: 4.5,
        // Fluxos (L/h) — template da suíte
        q_liver: 90.0, q_kidney: 72.0, q_brain: 44.0, q_heart: 14.4,
        q_lung: 0.0, q_muscle: 73.8, q_adipose: 18.0, q_gut: 57.6,
        q_skin: 18.0, q_bone: 21.6, q_spleen: 10.8, q_pancreas: 4.5,
        q_other: 18.0,
        // Kp — conjunto Fase 6 v2 calibrado contra o OBSERVÁVEL terminal
        // (t½ 2–3h): carga concentrada em órgãos bem perfundidos (fígado/
        // pulmão/intestino/baço — uptake OCT1), tecidos lentos descarregados
        // (músculo 2.6, adiposo 1.1). Vss resultante ≈ 166 L (2.4 L/kg) —
        // faixa publicada 1–6 L/kg (Mazoit 2007: 3.3; Wahlström: ~1–2);
        // a tensão Vss×t½×CL da literatura NCA é documentada (premissa).
        kp_liver: 10.0, kp_kidney: 7.0, kp_brain: 2.0, kp_heart: 5.5,
        kp_lung: 7.0, kp_muscle: 2.6, kp_adipose: 1.1, kp_gut: 9.0,
        kp_skin: 2.0, kp_bone: 1.0, kp_spleen: 7.0, kp_pancreas: 5.5,
        kp_other: 2.0,
        // Convenção do ODE (ver fentanyl.sio): cl = CL_alvo / (fu·rb)
        cl_hepatic: cl_h_eff / (fu * rb),
        cl_renal:   8.4 / (fu * rb),     // 10% do CL total adulto
        fu_plasma: fu,
        rb_ratio: rb
    }
}

pub fn morphine_pbpk_params() -> PBPKParams14 with Div {
    return morphine_params_with_clh(75.6)
}

// ─── PBPK14 pediátrico: escala de tamanho × ontogenia UGT2B7/OCT1 ───────────
// v,q ∝ w/70 (linear, convenção da suíte UTIped); CLint ∝ (w/70)·r_cascade;
// CL_h resultante via well-stirred com Q_liver escalado → transição
// flow-limited → uptake/metabolism-limited emerge do mecanismo.
pub fn morphine_pbpk_params_ped(pna_days: f64, weight: f64) -> PBPKParams14 with Mut, Div {
    let wr = weight / 70.0
    let fu: f64 = 0.70
    let rb: f64 = 1.0
    let q_liv = 90.0 * wr
    let clint = morphine_clint_adult() * wr * r_cascade(pna_days)
    // well-stirred: CL_h = Q·fu·CLint / (Q + fu·CLint)
    let cl_h = q_liv * fu * clint / (q_liv + fu * clint)
    let cl_r = 8.4 * wr * r_cascade(pna_days)   // maturação renal ~ mesma escala
    let base = morphine_params_with_clh(1.0)     // template Kp
    PBPKParams14 {
        v_blood: base.v_blood * wr, v_liver: base.v_liver * wr,
        v_kidney: base.v_kidney * wr, v_brain: base.v_brain * wr,
        v_heart: base.v_heart * wr, v_lung: base.v_lung * wr,
        v_muscle: base.v_muscle * wr, v_adipose: base.v_adipose * wr,
        v_gut: base.v_gut * wr, v_skin: base.v_skin * wr,
        v_bone: base.v_bone * wr, v_spleen: base.v_spleen * wr,
        v_pancreas: base.v_pancreas * wr, v_other: base.v_other * wr,
        q_liver: base.q_liver * wr, q_kidney: base.q_kidney * wr,
        q_brain: base.q_brain * wr, q_heart: base.q_heart * wr,
        q_lung: 0.0, q_muscle: base.q_muscle * wr,
        q_adipose: base.q_adipose * wr, q_gut: base.q_gut * wr,
        q_skin: base.q_skin * wr, q_bone: base.q_bone * wr,
        q_spleen: base.q_spleen * wr, q_pancreas: base.q_pancreas * wr,
        q_other: base.q_other * wr,
        kp_liver: base.kp_liver, kp_kidney: base.kp_kidney, kp_brain: base.kp_brain,
        kp_heart: base.kp_heart, kp_lung: base.kp_lung, kp_muscle: base.kp_muscle,
        kp_adipose: base.kp_adipose, kp_gut: base.kp_gut, kp_skin: base.kp_skin,
        kp_bone: base.kp_bone, kp_spleen: base.kp_spleen, kp_pancreas: base.kp_pancreas,
        kp_other: base.kp_other,
        cl_hepatic: cl_h / (fu * rb),
        cl_renal: cl_r / (fu * rb),
        fu_plasma: fu,
        rb_ratio: rb
    }
}

// Clearance plasmático efetivo resultante (diagnóstico/validação):
// CL_eff = cl_hepatic·fu·rb (convenção do ODE).
pub fn morphine_cl_eff_lh(pna_days: f64, weight: f64) -> f64 with Mut, Div {
    let wr = weight / 70.0
    let q_liv = 90.0 * wr
    let clint = morphine_clint_adult() * wr * r_cascade(pna_days)
    let fu: f64 = 0.70
    let cl_h = q_liv * fu * clint / (q_liv + fu * clint)
    let cl_r = 8.4 * wr * r_cascade(pna_days)
    return cl_h + cl_r
}

// ─── Perfil em arrays (kernel PBPK28 da suíte UTIped) ───────────────────────
// NOTA DE RUNTIME (Madaros v0.80 cluster): tsit5_step_pbpk e pbpk_ode do
// tsit5_pbpk14.sio segfaultam neste build; os construtores de PARÂMETROS
// (este módulo) funcionam. Os drivers UTIped consomem os arrays abaixo no
// kernel Euler fixo próprio (mesma convenção State28/Params28 de
// darwin_pbpk/core/pbpk28_params.sio). Ordem dos órgãos:
// [blood, liver, kidney, brain, heart, lung, muscle, adipose, gut, skin,
//  bone, spleen, pancreas, other].

// Volumes (L) 70 kg — mesmo template PBPK28 da suíte UTIped
pub fn morphine_v70() -> [f64; 14] {
    [5.0, 1.8, 0.31, 1.45, 0.33, 1.1, 28.0, 20.0, 1.2, 3.6, 6.6, 0.18, 0.09, 3.7]
}
// Fluxos (L/h) 70 kg — template UTIped
pub fn morphine_q70() -> [f64; 14] {
    [350.0, 90.0, 74.0, 44.0, 16.0, 350.0, 42.0, 10.0, 55.0, 21.0, 17.0, 10.0, 8.0, 13.0]
}
// Kp — conjunto Fase 6 (Vss alvo ~3.3 L/kg; ver cabeçalho)
pub fn morphine_kp() -> [f64; 14] {
    [1.0, 10.0, 7.0, 2.0, 5.5, 7.0, 2.6, 1.1, 9.0, 2.0, 1.0, 7.0, 5.5, 2.0]
}
// Fração vascular por órgão (Brown 1997) — fisiologia, comum à suíte
pub fn morphine_vasc_frac() -> [f64; 14] {
    [1.000, 0.210, 0.160, 0.037, 0.262, 0.262, 0.040, 0.050, 0.024, 0.019, 0.041, 0.282, 0.180, 0.050]
}
// PS (L/h) 70 kg — base hidrofílica: permeação limitada (≈0.5×Q; BBB 0.1×Q
// no cérebro, premissa declarada; contraste com fentanil lipofílico ~10×Q).
// GUM da Fase 6 perturba este conjunto (CV 30%).
pub fn morphine_ps70() -> [f64; 14] {
    [0.0, 45.0, 37.0, 4.4, 8.0, 0.0, 21.0, 5.0, 27.5, 10.5, 8.5, 5.0, 4.0, 6.5]
}
