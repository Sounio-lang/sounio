// darwin_pbpk/drugs/morphine.sio — Morphine on PBPK28: adult 70 kg anchor and a
// pediatric ontogeny (UGT2B7 conjugation x OCT1 hepatic uptake). Library, no main.
//
// Ported from the sedation-weaning study module (Sounio-lang/sounio-pbpk-
// sedation-weaning, src/drugs/morphine.sio, "Uncertainty-quantified PBPK modeling
// of opioid weaning in critically ill children", Agourakis DC 2026), which no
// longer compiles against this stdlib (it imports core::pbpk28_bridge and
// core::pbpk_params14, neither of which exists here). This port builds
// PBPKParams28 directly and drops the PBPK14 path and the unverified ontology
// ID annotations (the original flagged them "VERIFY before publishing").
//
// Pharmacological identity
//   Hydrophilic weak base (pKa 8.21, logP 0.89, MW 285.34), mu-opioid agonist.
//   fu = 0.70 (20-35 % bound), B/P = 1.0. CL total 84 L/h (1.2 L/h/kg; range
//   60-105): ~90 % hepatic UGT2B7 conjugation (M3G ~55 %, M6G ~10 %), ~10 %
//   renal unchanged. High hepatic extraction at maturity (E_h = 75.6/90 = 0.84).
//
// Mechanism carried here: in neonates elimination is limited in CASCADE by
// hepatic uptake (OCT1, SLC22A1) and conjugation (UGT2B7). Both are immature at
// birth and mature over the first year. The intrinsic clearance is scaled by the
// weakest link, min(r_UGT2B7, r_OCT1), and the hepatic clearance follows from the
// well-stirred model, so the adult flow-limited regime (E_h = 0.84) becomes an
// uptake/metabolism-limited one in the neonate (E_h << 0.84). Renal clearance
// matures on its own GFR curve and is NOT tied to the hepatic cascade.
//
// Ontogeny premises (declared, not fitted here):
//   r_UGT2B7(d) = 0.05 + 0.95 * h/(1+h), h = (d/60)^1.7   [Badee 2019]
//   r_OCT1(d)   = 0.10 + 0.90 * h/(1+h), h = (d/90)^2.0   [Hahn 2019/2021]
//   r_GFR(d)    = 0.25 + 0.75 * h/(1+h), h = (d/30)^1.5   [simplified Hill]
//   CLint(d)    = CLint_adult * (w/70) * min(r_UGT2B7, r_OCT1)
//   CLint_adult = CL_h*Q/(fu*(Q-CL_h)) = 75.6*90/(0.70*14.4) = 675 L/h
//
// Declared limitations (kept visible, not tuned away)
//   1. Distribution volume. With the Kp set below, the PBPK28 steady-state
//      volume is under the literature Vss of 3.3 L/kg (Mazoit 2007): the gap is
//      reported by tests/run-pass/darwin_morphine_pbpk28.sio, not corrected here.
//      Reducing it means retuning Kp and volumes, a calibration decision.
//   2. The elimination acts on blood through cl_central (PBPK28 single-drug
//      convention), so the cascade enters as a closed-form clearance
//      (morphine_cl_eff_lh), not as a hepatic-organ sink inside the transport.
//   3. M6G (active) and renal impairment are out of scope.
//   4. Lung PS. The source template has PS_lung = 0.0, which breaks the
//      module's own PS = 0.5*Q rule and leaves the lung tissue layer empty.
//      Here PS_lung = 0.5*350 = 175 L/h, applying that rule. This is a
//      deliberate deviation from the source (V_ss moves from 151.8 to ~157.5 L);
//      it is a rule-consistency fix, not a calibration to the literature.
//   5. Research parity card (ADR009); no clinical-validity claim and not a
//      dosing tool.
//
// Units: L, L/h, mg/L (= ug/mL). Organ order:
//   [blood, liver, kidney, brain, heart, lung, muscle, adipose, gut, skin,
//    bone, spleen, pancreas, other].

use darwin_pbpk::core::pbpk28_params::*
use math::pure::{exp, ln}

pub fn morphine_mw() -> f64 { return 285.34 }
pub fn morphine_fu() -> f64 { return 0.70 }
pub fn morphine_rb() -> f64 { return 1.0 }

// Adult 70 kg totals (L/h).
pub fn morphine_cl_total_adult() -> f64 { return 84.0 }
pub fn morphine_cl_hepatic_adult() -> f64 { return 75.6 }   // 0.90 * 84
pub fn morphine_cl_renal_adult() -> f64 { return 8.4 }      // 0.10 * 84
pub fn morphine_q_liver_adult() -> f64 { return 90.0 }

// Well-stirred inversion at maturity: CL_h*Q / (fu*(Q - CL_h)).
pub fn morphine_clint_adult() -> f64 { return 675.0 }

// ─── Ontogeny ───────────────────────────────────────────────────────────────
// x^e for x > 0 (the Hill terms only ever see x >= 0).
fn morphine_pow(x: f64, e: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    return exp(e * ln(x))
}

pub fn morphine_r_ugt2b7(pna_days: f64) -> f64 with Mut, Div, Panic {
    let h = morphine_pow(pna_days / 60.0, 1.7)
    return 0.05 + 0.95 * h / (1.0 + h)
}

pub fn morphine_r_oct1(pna_days: f64) -> f64 with Mut, Div, Panic {
    let h = morphine_pow(pna_days / 90.0, 2.0)
    return 0.10 + 0.90 * h / (1.0 + h)
}

// Weakest link of the hepatic uptake -> conjugation cascade.
pub fn morphine_r_cascade(pna_days: f64) -> f64 with Mut, Div, Panic {
    let a = morphine_r_ugt2b7(pna_days)
    let b = morphine_r_oct1(pna_days)
    if a < b { return a }
    return b
}

// Renal maturation (GFR / secretion), independent of the hepatic cascade.
pub fn morphine_r_gfr(pna_days: f64) -> f64 with Mut, Div, Panic {
    let h = morphine_pow(pna_days / 30.0, 1.5)
    return 0.25 + 0.75 * h / (1.0 + h)
}

// ─── Clearance (well-stirred hepatic + renal) ───────────────────────────────
// Hepatic clearance for body weight w (kg) and postnatal age (days). Q_liver
// scales linearly with w/70; CLint with (w/70)*cascade.
pub fn morphine_cl_hepatic_lh(pna_days: f64, weight: f64) -> f64 with Mut, Div, Panic {
    let wr = weight / 70.0
    let q = morphine_q_liver_adult() * wr
    let fuclint = morphine_fu() * morphine_clint_adult() * wr * morphine_r_cascade(pna_days)
    return q * fuclint / (q + fuclint)
}

pub fn morphine_cl_renal_lh(pna_days: f64, weight: f64) -> f64 with Mut, Div, Panic {
    return morphine_cl_renal_adult() * (weight / 70.0) * morphine_r_gfr(pna_days)
}

// Total effective systemic clearance (L/h): the value stored in cl_central.
pub fn morphine_cl_eff_lh(pna_days: f64, weight: f64) -> f64 with Mut, Div, Panic {
    return morphine_cl_hepatic_lh(pna_days, weight) + morphine_cl_renal_lh(pna_days, weight)
}

// Hepatic extraction ratio E_h = CL_h / Q_liver (the mechanism's observable:
// flow-limited near 1 in the adult, uptake/metabolism-limited in the neonate).
pub fn morphine_extraction(pna_days: f64, weight: f64) -> f64 with Mut, Div, Panic {
    return morphine_cl_hepatic_lh(pna_days, weight) / (morphine_q_liver_adult() * (weight / 70.0))
}

// ─── PBPK28 arrays (70 kg) ──────────────────────────────────────────────────
pub fn morphine_v70() -> [f64; 14] {
    [5.0, 1.8, 0.31, 1.45, 0.33, 1.1, 28.0, 20.0, 1.2, 3.6, 6.6, 0.18, 0.09, 3.7]
}
pub fn morphine_q70() -> [f64; 14] {
    [350.0, 90.0, 74.0, 44.0, 16.0, 350.0, 42.0, 10.0, 55.0, 21.0, 17.0, 10.0, 8.0, 13.0]
}
// Kp: liver/lung/gut/spleen heavy (OCT1 uptake), slow tissues unloaded.
pub fn morphine_kp() -> [f64; 14] {
    [1.0, 10.0, 7.0, 2.0, 5.5, 7.0, 2.6, 1.1, 9.0, 2.0, 1.0, 7.0, 5.5, 2.0]
}
pub fn morphine_vasc_frac() -> [f64; 14] {
    [1.000, 0.210, 0.160, 0.037, 0.262, 0.262, 0.040, 0.050, 0.024, 0.019, 0.041, 0.282, 0.180, 0.050]
}
// PS (L/h): permeability-limited (PS = 0.5*Q for every exchanging organ), BBB
// 0.1*Q (declared premise). Blood has no tissue layer (0.0). The lung is 175 =
// 0.5*350: the source template carried 0.0 there (a PBPK14 leftover, q_lung = 0),
// which broke its own 0.5*Q rule and left the lung tissue layer (Kp 7) holding
// no drug. Deliberate deviation from the source module; see limitation 4.
pub fn morphine_ps70() -> [f64; 14] {
    [0.0, 45.0, 37.0, 4.4, 8.0, 175.0, 21.0, 5.0, 27.5, 10.5, 8.5, 5.0, 4.0, 6.5]
}

pub fn pbpk28_params_morphine() -> PBPKParams28 {
    PBPKParams28 {
        v_ref:      morphine_v70(),
        vasc_frac:  morphine_vasc_frac(),
        kp:         morphine_kp(),
        ps:         morphine_ps70(),
        q:          morphine_q70(),
        cl_central: morphine_cl_total_adult(),
    }
}

// Pediatric: volumes and flows (and PS) scale with w/70, Kp and the vascular
// fractions do not; cl_central carries the ontogeny-scaled clearance.
pub fn pbpk28_params_morphine_ped(pna_days: f64, weight: f64) -> PBPKParams28 with Mut, Div, Panic {
    let wr = weight / 70.0
    let b = pbpk28_params_morphine()
    var v = [0.0; 14]
    var q = [0.0; 14]
    var ps = [0.0; 14]
    var i: i32 = 0
    while i < 14 {
        v[i] = b.v_ref[i] * wr
        q[i] = b.q[i] * wr
        ps[i] = b.ps[i] * wr
        i = i + 1
    }
    PBPKParams28 {
        v_ref:      v,
        vasc_frac:  b.vasc_frac,
        kp:         b.kp,
        ps:         ps,
        q:          q,
        cl_central: morphine_cl_eff_lh(pna_days, weight),
    }
}

// Steady-state distribution volume of the exchanging model (L):
//   V_ss = V_b + sum_i V_i * (f_v,i + (1 - f_v,i) * Kp_i)
// over every organ, counting an organ's tissue layer only if it is reachable
// (ps > 0). A tissue layer with ps = 0 never exchanges and holds no drug.
pub fn morphine_vss_of(p: PBPKParams28) -> f64 with Mut {
    var vss = p.v_ref[0]
    var i: i32 = 1
    while i < 14 {
        let fv = p.vasc_frac[i]
        if p.ps[i] > 0.0 {
            vss = vss + p.v_ref[i] * (fv + (1.0 - fv) * p.kp[i])
        } else {
            vss = vss + p.v_ref[i] * fv
        }
        i = i + 1
    }
    return vss
}
