// ─── Físico-química / ligação ───────────────────────────────────────────────
pub fn clonidine_fu() -> f64 { return 0.75 }
pub fn clonidine_rb() -> f64 { return 1.0 }
pub fn clonidine_logd() -> f64 { return 0.7 }   // calibrado Vss Potts (ver cabeçalho)
pub fn clonidine_mw() -> f64 { return 230.09 }

// ─── Matemática local (mesma família dos demais módulos) ────────────────────
fn powf_local(b: f64, e: f64) -> f64 {
    // b^e para b>0 via exp/ln (estilo morphine: 2 statements — inline
    // exp(ln) em 1 statement dispara rc=12 no thin-link do Madaros v0.80)
    if b <= 0.0 { return 0.0 }
    let l = ln_local(b)
    return exp_local(e * l)
}
fn exp_local(x: f64) -> f64 {
    if x > 20.0 {
        let h = exp_local(x / 2.0)
        return h * h
    }
    if x < 0.0 - 20.0 { return 1.0 / exp_local(0.0 - x) }
    var sum = 1.0
    var term = 1.0
    var i = 1.0
    while i <= 20.0 {
        term = term * x / i
        sum = sum + term
        i = i + 1.0
    }
    return sum
}
fn ln_local(x: f64) -> f64 {
    if x <= 0.0 { return 0.0 - 1000000.0 }
    if x == 1.0 { return 0.0 }
    if x > 1.5 { return 2.0 * ln_local(sqrt_local(x)) }
    if x < 0.7 { return 0.0 - ln_local(1.0 / x) }
    let u = x - 1.0
    var sum = 0.0
    var term = u
    var i = 1.0
    while i <= 30.0 {
        sum = sum + term / i
        term = 0.0 - term * u
        i = i + 1.0
    }
    return sum
}
fn sqrt_local(x: f64) -> f64 {
    if x <= 0.0 { return 0.0 }
    var guess = x / 2.0
    if guess < 1.0 { guess = 1.0 }
    var i = 0.0
    while i < 20.0 {
        guess = (guess + x / guess) / 2.0
        i = i + 1.0
    }
    return guess
}

// ─── Ontogenia (forma Potts 2007; ver cabeçalho) ────────────────────────────
pub fn r_cl_potts(pna_days: f64) -> f64 {
    // x^1.5/(25.7^1.5+x^1.5) = (x/25.7)^1.5 / (1 + (x/25.7)^1.5) — forma
    // r_ugt2b7 do morphine: UMA chamada powf por let (3× powf na mesma
    // expressão disparava rc=12 — bissecção C2, cluster 12/08/2026)
    let x = pna_days / 7.0
    let u = x / 25.7
    let h = powf_local(u, 1.5)
    return 0.26 + 0.74 * h / (1.0 + h)
}

// ─── Clearance efetivo (L/h) ────────────────────────────────────────────────
pub fn clonidine_cl_adult_70() -> f64 { return 14.6 }
pub fn clonidine_cl_eff_lh(pna_days: f64, weight: f64) -> f64 with Div {
    // alometria 0.75 (Anderson); um powf por let, estilo morphine
    let wr = powf_local(weight / 70.0, 0.75)
    let r = r_cl_potts(pna_days)
    return 14.6 * r * wr
}

// ─── Kp — literais de rr_neutral(logD=0.7, fu=0.75, u_logP=0.2, u_fu=0.10) ──
// Computados via darwin_pbpk::core::rodgers_rowland (probe_rr2.sio, cluster,
// 12/08/2026) e EMBUTIDOS como literais — padrão morphine.sio "Kp v2"
// (importar rr_neutral na superfície pública do módulo dispara o bug
// thin-link rc=12 do Madaros v0.80 — struct com arrays cruzando fronteira).
// Vss resultante = 174.8 L/70kg = 2.50 L/kg (alvo Potts 2.6, −4% ✓).
// Ordem: [blood, liver, kidney, brain, heart, lung, muscle, adipose, gut,
//         skin, bone, spleen, pancreas, other]
pub fn clonidine_kp() -> [f64; 14] {
    [0.893839, 1.120335, 1.118929, 1.359454, 1.150273, 1.111743, 1.078191,
     5.906845, 1.295344, 1.306302, 0.712278, 1.143559, 1.167711, 1.087030]
}
// u(Kp) GUM do próprio rr_neutral (sensitividades analíticas ∂Kp/∂logP, ∂Kp/∂fu)
pub fn clonidine_kp_unc() -> [f64; 14] {
    [0.119420, 0.163003, 0.157694, 0.237365, 0.162347, 0.168302, 0.148503,
     2.742395, 0.217204, 0.256529, 0.109329, 0.158698, 0.172193, 0.161296]
}

// ─── Template 70 kg (mesma suíte PBPK14) ────────────────────────────────────
pub fn clonidine_v70() -> [f64; 14] {
    [5.2, 1.69, 0.31, 1.37, 0.31, 1.17, 29.0, 18.2, 1.65, 7.8, 10.5, 0.19, 0.14, 4.5]
}
pub fn clonidine_q70() -> [f64; 14] {
    [0.0, 90.0, 72.0, 44.0, 14.4, 0.0, 73.8, 18.0, 57.6, 18.0, 21.6, 10.8, 4.5, 18.0]
}

// ─── PBPK14 adulto/pediátrico ───────────────────────────────────────────────
fn clonidine_params_with_cl(cl_eff: f64) -> PBPKParams14 with Mut, Div, Panic {
    // literais inline (chamar fns que retornam array aqui dispara rc=12)
    let kp = [0.893839, 1.120335, 1.118929, 1.359454, 1.150273, 1.111743,
              1.078191, 5.906845, 1.295344, 1.306302, 0.712278, 1.143559,
              1.167711, 1.087030]
    PBPKParams14 {
        v_blood: 5.2, v_liver: 1.69, v_kidney: 0.31, v_brain: 1.37,
        v_heart: 0.31, v_lung: 1.17, v_muscle: 29.0, v_adipose: 18.2,
        v_gut: 1.65, v_skin: 7.8, v_bone: 10.5, v_spleen: 0.19,
        v_pancreas: 0.14, v_other: 4.5,
        q_liver: 90.0, q_kidney: 72.0, q_brain: 44.0, q_heart: 14.4,
        q_lung: 0.0, q_muscle: 73.8, q_adipose: 18.0, q_gut: 57.6,
        q_skin: 18.0, q_bone: 21.6, q_spleen: 10.8, q_pancreas: 4.5,
        q_other: 18.0,
        kp_liver: kp[1], kp_kidney: kp[2], kp_brain: kp[3],
        kp_heart: kp[4], kp_lung: kp[5], kp_muscle: kp[6],
        kp_adipose: kp[7], kp_gut: kp[8], kp_skin: kp[9],
        kp_bone: kp[10], kp_spleen: kp[11], kp_pancreas: kp[12],
        kp_other: kp[13],
        // Convenção do ODE (ver fentanyl.sio): cl = CL_alvo / (fu·rb)
        // split dual 50/50 (CYP2D6 hepático × renal inalterado — cabeçalho)
        cl_hepatic: 0.5 * cl_eff / (clonidine_fu() * clonidine_rb()),
        cl_renal: 0.5 * cl_eff / (clonidine_fu() * clonidine_rb()),
        fu_plasma: clonidine_fu(),
        rb_ratio: clonidine_rb(),
    }
}
pub fn clonidine_pbpk_params() -> PBPKParams14 with Mut, Div, Panic {
    clonidine_params_with_cl(clonidine_cl_adult_70())
}
pub fn clonidine_pbpk_params_ped(pna_days: f64, weight: f64) -> PBPKParams14 with Mut, Div, Panic {
    // escala volumes/fluxos por peso (w/70)^1.0; clearance por ontogenia+alom.
    let wr = weight / 70.0
    let base = clonidine_params_with_cl(clonidine_cl_eff_lh(pna_days, weight))
    PBPKParams14 {
        v_blood: base.v_blood * wr, v_liver: base.v_liver * wr,
        v_kidney: base.v_kidney * wr, v_brain: base.v_brain * wr,
        v_heart: base.v_heart * wr, v_lung: base.v_lung * wr,
        v_muscle: base.v_muscle * wr, v_adipose: base.v_adipose * wr,
        v_gut: base.v_gut * wr, v_skin: base.v_skin * wr,
        v_bone: base.v_bone * wr, v_spleen: base.v_spleen * wr,
        v_pancreas: base.v_pancreas * wr, v_other: base.v_other * wr,
        q_liver: base.q_liver * wr, q_kidney: base.q_kidney * wr,
        q_brain: base.q_brain * wr, q_heart: base.q_heart * wr,
        q_lung: base.q_lung, q_muscle: base.q_muscle * wr,
        q_adipose: base.q_adipose * wr, q_gut: base.q_gut * wr,
        q_skin: base.q_skin * wr, q_bone: base.q_bone * wr,
        q_spleen: base.q_spleen * wr, q_pancreas: base.q_pancreas * wr,
        q_other: base.q_other * wr,
        kp_liver: base.kp_liver, kp_kidney: base.kp_kidney,
        kp_brain: base.kp_brain, kp_heart: base.kp_heart,
        kp_lung: base.kp_lung, kp_muscle: base.kp_muscle,
        kp_adipose: base.kp_adipose, kp_gut: base.kp_gut,
        kp_skin: base.kp_skin, kp_bone: base.kp_bone,
        kp_spleen: base.kp_spleen, kp_pancreas: base.kp_pancreas,
        kp_other: base.kp_other,
        cl_hepatic: base.cl_hepatic,
        cl_renal: base.cl_renal,
        fu_plasma: base.fu_plasma,
        rb_ratio: base.rb_ratio,
    }
}

// ─── PD (Emax; métricas de cobertura α2) ────────────────────────────────────
pub fn clonidine_ec50_ngml() -> f64 { return 9.32 }   // 40.5 nM × 230.09 g/mol
pub fn clonidine_target_ngml() -> f64 { return 2.0 }  // ANMF 2025 (mínimo)
pub fn clonidine_emax_frac(c_ngml: f64) -> f64 with Div {
    // E/Emax = C/(EC50+C), Hill 1 (premissa)
    let e = clonidine_ec50_ngml()
    return c_ngml / (e + c_ngml)
}

// ─── Vss esperado (gate de validação, L/70kg) ───────────────────────────────
pub fn clonidine_vss_l70() -> f64 with Mut, Div, Panic {
    let v = [5.2, 1.69, 0.31, 1.37, 0.31, 1.17, 29.0, 18.2, 1.65, 7.8, 10.5,
             0.19, 0.14, 4.5]
    let kp = [0.893839, 1.120335, 1.118929, 1.359454, 1.150273, 1.111743,
              1.078191, 5.906845, 1.295344, 1.306302, 0.712278, 1.143559,
              1.167711, 1.087030]
    var s = v[0]
    var i = 1
    while i < 14 {
        s = s + kp[i] * v[i]
        i = i + 1
    }
    return s
}
