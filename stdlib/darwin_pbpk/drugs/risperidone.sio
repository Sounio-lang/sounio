// darwin_pbpk/drugs/risperidone.sio — Risperidone + 9-OH PBPK28 Parameters
//
// Risperidone (MW 410.49) is a benzisoxazole antipsychotic, extensively
// metabolised by hepatic CYP2D6 to the equipotent active metabolite
// 9-hydroxyrisperidone (paliperidone, MW 426.48). Clinical effect is the
// ACTIVE MOIETY (parent + 9-OH); the card simulates both with an explicit
// molar convention (formation conserves moles, masses scale by MW ratio).
//
// Primary literature / labels (parameter classes in caps):
//   - Risperdal FDA label (Janssen), 12.3 Pharmacokinetics [MEASURED]:
//     absolute oral bioavailability F = 0.70 (CV 25%); Vd 1-2 L/kg;
//     parent apparent t1/2 3 h in extensive metabolisers, 20 h in poor
//     metabolisers; Tmax parent ~1 h, 9-OH ~3 h (EM) / ~17 h (PM);
//     main pathway 9-hydroxylation (CYP2D6), minor N-dealkylation.
//   - Paliperidone (Invega) labelling summaries [REPORTED]: Vd 487 L,
//     terminal t1/2 ~23 h. 9-OH brain/plasma 0.8-1.2 [REPORTED].
//   - Kneller et al., Clin Pharmacokinet 59:51-65 [ARCHETYPE, verified
//     DOI 10.1007/s40262-019-00793-x, PMID 31359271]: PBPK with 9-OH
//     and CYP2D6 phenotypes. Closed text: no numeric CL split taken.
//   - Mannheimer et al. 2016, Ther Drug Monit (doi:10.1097/FTD.
//     0000000000000251): metabolic ratio by genotype, n=425 [SUPPORTING].
//   - Bioequivalence single-dose design 2 mg fasting (PMC3627046) [DESIGN].
//
// DERIVED (arithmetic on measured anchors, shown in comments):
//   parent Vd target 1.5 L/kg x 70 kg = 105 L; CL_total_EM = ln2*105/3
//     = 24.3 L/h; CL_other = ln2*105/20 = 3.6 L/h (PM t1/2 carries no
//     formation, so PM total == non-formation clearance); CL_form_NM =
//     24.3 - 3.6 = 20.7 L/h.
//   9-OH CL = ln2*487/23 = 14.7 L/h.
// ASSUMED (declared): Kp patterns targeting label Vd (parent ~115 L,
//   9-OH ~480 L, verified arithmetically below); PS flow-limited except
//   brain/adipose/bone (SIO-550, CNS exception for brain); ka = 2.0/h
//   calibrated to Tmax ~1 h with tlag 0.25 h (sibling IR convention);
//   phenotype formation scale by CPIC activity-score logic
//   (PM 0 / IM 0.5 / NM 1 / UM 1.5); single 2 mg oral IR tablet.
// No clinical-validity claim: parity only (ADR009).

pub fn risperidone_mw_parent() -> f64 { return 410.49 }
pub fn risperidone_mw_oh9() -> f64 { return 426.48 }

// Molar formation convention: moles conserved, metabolite mass formed =
// parent mass converted x MW(9-OH)/MW(parent).
pub fn risperidone_mw_ratio() -> f64 { return 426.48 / 410.49 }

// Single 2 mg oral IR tablet (bioequivalence single-dose design).
pub fn risperidone_single_dose_mg() -> f64 { return 2.0 }
pub fn risperidone_f_oral() -> f64 { return 0.70 }
pub fn risperidone_ka_per_h() -> f64 { return 2.0 }
pub fn risperidone_tlag_h() -> f64 { return 0.25 }

// Clearances (L/h, DERIVED — see header arithmetic).
pub fn risperidone_cl_other_central() -> f64 { return 3.6 }
pub fn risperidone_cl_form_nm() -> f64 { return 20.7 }
pub fn risperidone_cl_oh9_central() -> f64 { return 14.7 }

// CYP2D6 formation scale by phenotype (darwin_pbpk convention:
// 0=PM, 1=IM, 2=NM, 3=UM). PM 0.0 is label-derived (PM t1/2 20 h carries
// no formation); IM/UM follow CPIC activity-score logic (declared).
pub fn risperidone_form_scale(pheno: i32) -> f64 {
    if pheno == 0 { return 0.0 }
    if pheno == 1 { return 0.5 }
    if pheno == 2 { return 1.0 }
    return 1.5
}

pub fn risperidone_cl_form(pheno: i32) -> f64 {
    return risperidone_cl_form_nm() * risperidone_form_scale(pheno)
}

// NM (2) is the parity reference phenotype.
pub fn risperidone_pheno_nm() -> i32 { return 2 }
