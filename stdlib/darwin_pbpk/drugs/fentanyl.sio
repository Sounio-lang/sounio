// fentanyl.sio — Fentanyl systemic PBPK14 parameters (adult 70 kg anchor).
//
// Sexto composto canônico da suíte; opioide de alta extração da UTIped.
// Módulo da Fase 0 do estudo "Uncertainty-quantified PBPK modeling of opioid
// weaning in critically ill children" (Agourakis DC, 2026).
//
// CONVENÇÃO DE CLEARANCE (verificada em tsit5_pbpk14.sio, pbpk_ode linhas
// 440/443): o ODE aplica clearance sobre a concentração NÃO-LIVRE no sangue —
//   dC_blood/dt -= (cl / v_blood) · c_unbound · rb_ratio,  c_unbound = fu · c_blood
// Logo o clearance efetivo sobre concentração sanguínea é CL_eff = cl·fu·rb,
// e armazenamos o intrínseco-sobre-não-livre: cl = CL_alvo / (fu · rb).
//
// PARÂMETROS-CHAVE (Kovar L et al. 2020, Pharmaceutics 12:908, Tabela 3):
//   fu adulto = 20.8% [ref 57 lá] · B/P = 0.87 [ref 59 lá]
//   Eliminação: ~60% hepática inespecífica + ~33% CYP3A4/3A7 → norfentanil
//               + ~7% renal inalterado
//   CL adulto de referência ≈ 0.78–0.80 L/h/kg (McClain & Hug 1980)
//   → CL_total(70 kg) = 55 L/h; CL_h = 0.93·55 = 51.2; CL_R = 0.07·55 = 3.8
//
// CROSS-CHECK (Han J et al. 2025, Pharmaceutics 17:214, Tabela S1):
//   logP 4.05 vs 3.49 (Kovar) · pKa 8.43 vs 8.99 · Rb 1.0 vs 0.87
//   Divergências documentadas → alimentam as distribuições de incerteza
//   (Knowledge<T>) na fase epistêmica, NÃO são resolvidas por escolha única.
//
// Kp: conjunto FINAL calibrado na Fase 0 contra McClain & Hug 1980
//   (CL 61.3 L/h, Vss 302 L, c(10h) 0.178 ng/mL — todos dentro de 2-fold).
//   Os Kp do Han 2025 (adiposo 170.4) são incompatíveis com esta convenção de
//   Vss; os Kp do Kovar são "Diverse" (Rodgers & Rowland computado, não
//   tabulado). TODO(fase 1): rodgers_rowland.sio cobre apenas neutros —
//   estender para base fraca (pKa 8.99) como cross-check independente.
//
// Units: L, L/h, mg/L (= µg/mL). 1 µg/L = 1 ng/mL.

use darwin_pbpk::tsit5_pbpk14::{PBPKParams14}

pub fn fentanyl_pbpk_params() -> PBPKParams14 with Div {
    let fu: f64 = 0.208          // Kovar 2020 Tab 3 (20.8%)
    let rb: f64 = 0.87           // Kovar 2020 Tab 3 (B/P)
    let cl_total: f64 = 55.0     // L/h — McClain & Hug 1980 (~0.79 L/h/kg, 70 kg)
    let cl_h: f64 = 0.93 * cl_total   // 51.2 L/h (60% inespec. + 33% CYP3A4/7)
    let cl_r: f64 = 0.07 * cl_total   // 3.8 L/h
    PBPKParams14 {
        // Volumes (L) — referência 70 kg (mesmo template da suíte)
        v_blood: 5.2, v_liver: 1.69, v_kidney: 0.31, v_brain: 1.37,
        v_heart: 0.31, v_lung: 1.17, v_muscle: 29.0, v_adipose: 18.2,
        v_gut: 1.65, v_skin: 7.8, v_bone: 10.5, v_spleen: 0.19,
        v_pancreas: 0.14, v_other: 4.5,
        // Fluxos sanguíneos (L/h) — template da suíte
        q_liver: 90.0, q_kidney: 72.0, q_brain: 44.0, q_heart: 14.4,
        q_lung: 0.0, q_muscle: 73.8, q_adipose: 18.0, q_gut: 57.6,
        q_skin: 18.0, q_bone: 21.6, q_spleen: 10.8, q_pancreas: 4.5,
        q_other: 18.0,
        // Kp — conjunto FINAL calibrado na Fase 0 (McClain & Hug 1980, gates:
        // CL 61.3 L/h, Vss 302 L, t½_terminal ≈ 3.4h, c(10h)=0.178 ng/mL)
        kp_liver: 5.0, kp_kidney: 5.0, kp_brain: 8.0, kp_heart: 4.0,
        kp_lung: 5.5, kp_muscle: 7.5, kp_adipose: 12.0, kp_gut: 6.0,
        kp_skin: 6.0, kp_bone: 1.2, kp_spleen: 3.0, kp_pancreas: 3.0,
        kp_other: 3.0,
        // Clearance intrínseco-sobre-não-livre (convenção do ODE)
        cl_hepatic: cl_h / (fu * rb),   // ≈ 283 L/h
        cl_renal:   cl_r / (fu * rb),   // ≈ 21 L/h
        fu_plasma: fu,
        rb_ratio: rb
    }
}

// Variante com fração de clearance hepático (ex.: 0.17 = redução de ~83% por
// pressão intra-abdominal em neonatos pós-cirurgia abdominal — Gauntlett 1988,
// Koehntop 1986, Saarenmaa 2000, via Kovar 2020 §3.5).
pub fn fentanyl_pbpk_params_clscaled(f_cl: f64) -> PBPKParams14 with Div {
    let base = fentanyl_pbpk_params()
    PBPKParams14 {
        v_blood: base.v_blood, v_liver: base.v_liver, v_kidney: base.v_kidney,
        v_brain: base.v_brain, v_heart: base.v_heart, v_lung: base.v_lung,
        v_muscle: base.v_muscle, v_adipose: base.v_adipose, v_gut: base.v_gut,
        v_skin: base.v_skin, v_bone: base.v_bone, v_spleen: base.v_spleen,
        v_pancreas: base.v_pancreas, v_other: base.v_other,
        q_liver: base.q_liver, q_kidney: base.q_kidney, q_brain: base.q_brain,
        q_heart: base.q_heart, q_lung: base.q_lung, q_muscle: base.q_muscle,
        q_adipose: base.q_adipose, q_gut: base.q_gut, q_skin: base.q_skin,
        q_bone: base.q_bone, q_spleen: base.q_spleen, q_pancreas: base.q_pancreas,
        q_other: base.q_other,
        kp_liver: base.kp_liver, kp_kidney: base.kp_kidney, kp_brain: base.kp_brain,
        kp_heart: base.kp_heart, kp_lung: base.kp_lung, kp_muscle: base.kp_muscle,
        kp_adipose: base.kp_adipose, kp_gut: base.kp_gut, kp_skin: base.kp_skin,
        kp_bone: base.kp_bone, kp_spleen: base.kp_spleen, kp_pancreas: base.kp_pancreas,
        kp_other: base.kp_other,
        cl_hepatic: base.cl_hepatic * f_cl,
        cl_renal: base.cl_renal,
        fu_plasma: base.fu_plasma,
        rb_ratio: base.rb_ratio
    }
}
