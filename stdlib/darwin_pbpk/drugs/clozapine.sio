// darwin_pbpk/drugs/clozapine.sio — Clozapine Systemic PBPK Parameters
//
// Pharmacological identity:
//   - Atypical antipsychotic for treatment-resistant schizophrenia
//     (Clozaril, Novartis 1989; strict TDM + agranulocytosis monitoring)
//   - CYP1A2 primary metabolism (~70% fm); CYP3A4 minor (~20%);
//     FMO/CYP2C19 remainder (~10%) — estimated from interaction magnitudes
//     (fluvoxamine ×2-3 AUC; smoking −30-50% levels), NOT directly measured
//   - Smoking induces CYP1A2 → CL ×~1.5 (documented; smoker split is
//     follow-up, not in the single-dose canonical card)
//   - Basic lipophilic (pKa ≈ 7.5, LogP ≈ 3.2); high CNS penetration
//     (target organ); P-gp substrate but not P-gp restrained at the BBB
//     the way olanzapine is — separate mechanism, separate Kp
//   - Plasma protein binding ~95%: fu ≈ 0.05; rb ≈ 1 (plasma referenced)
//   - Therapeutic trough: 350–600 ng/mL (treatment-resistant schizophrenia)
//   - t½ ≈ 14 h single dose (beta phase); CL ≈ 20 L/h calibrated so that
//     400 mg/day steady state averages ≈ 450 ng/mL (inside the TDM band)
//
// Literature anchor (archetype, verified SIO-521):
//   - Jann MW et al. (1993) Clin Pharmacokinet 24:161-176
//     PMID 8453823, DOI 10.2165/00003088-199324020-00005
//     → canonical PK/PD review: CYP1A2, smoking, CL, Vd
//
// Confidence rubric: measured (label/replicated in vivo) ≥0.65;
// estimated from interactions 0.45–0.55; assumed (transport) ≤0.40.
// This card claims parity only (ADR009), not clinical validity.

pub fn clozapine_mw() -> f64 { return 326.83 }

// ─── Single-dose design ─────────────────────────────────────────────────────
// 100 mg single oral tablet: standard single-dose PK study design
// (label titration starts 12.5–25 mg; 100 mg gives Cmax ~140 ng/mL,
// well below the steady-state TDM band — safe single-dose probe).
pub fn clozapine_single_dose_mg() -> f64 { return 100.0 }

// Absorption: Tmax ~2 h → ka ≈ 1.0/h (class: estimated from Tmax);
// F ≈ 0.55 (label 50–60%, first-pass CYP1A2); tablet lag 0.25 h.
pub fn clozapine_ka_per_h() -> f64 { return 1.0 }
pub fn clozapine_f_oral_val() -> f64 { return 0.55 }
pub fn clozapine_tlag_h() -> f64 { return 0.25 }

// ─── Elimination fractions (justified, SIO-521 condition) ──────────────────
// fm_cyp1a2 ≈ 0.70: fluvoxamine (strong 1A2 inhibitor) raises clozapine AUC
//   ×2–3, bounding fm ≥ 0.5; smoking (1A2 inducer) lowers levels 30–50%,
//   bounding fm ≥ 0.3 and confirming 1A2 as the inducible route.
// fm_cyp3a4 ≈ 0.20: residual after 1A2; erythromycin/ketoconazole reports
//   show modest rises, no doubling.
// fm_other ≈ 0.10: FMO + CYP2C19 + direct glucuronidation (remainder).
// These fractions justify the smoking ×1.5 CL multiplier as follow-up work:
// a 50% activity gain on 70% fm raises total CL ×1.35–1.5.
pub fn clozapine_fm_cyp1a2() -> f64 { return 0.70 }
pub fn clozapine_fm_cyp3a4() -> f64 { return 0.20 }
pub fn clozapine_fm_other() -> f64  { return 0.10 }

// Smoker CL multiplier (documented, follow-up): 1.5.
pub fn clozapine_smoker_cl_multiplier() -> f64 { return 1.5 }

// Systemic CL = 20 L/h (class: calibrated — 400 mg/day steady state averages
// F·D/CL = 0.55·400/20/24 h ≈ 0.46 mg/L ≈ 460 ng/mL, inside 350–600).
pub fn clozapine_cl_L_per_h() -> f64 { return 20.0 }

// Tissue-to-plasma Kp (class: estimated — Rodgers-Rowland pattern for a
// basic lipophilic amine, Vd target ~400 L ≈ 5.7 L/kg; own values, NOT
// olanzapine's: brain higher (target organ, no P-gp restraint), adipose
// capped per the 24–72 h window note). Full-Vd variant is follow-up.
pub fn clozapine_kp_liver() -> f64   { return 10.0 }
pub fn clozapine_kp_kidney() -> f64  { return 4.0 }
pub fn clozapine_kp_brain() -> f64   { return 8.0 }
pub fn clozapine_kp_heart() -> f64   { return 3.0 }
pub fn clozapine_kp_lung() -> f64    { return 6.0 }
pub fn clozapine_kp_muscle() -> f64  { return 8.0 }
pub fn clozapine_kp_adipose() -> f64 { return 6.0 }
pub fn clozapine_kp_gut() -> f64     { return 4.0 }
pub fn clozapine_kp_skin() -> f64    { return 3.0 }
pub fn clozapine_kp_bone() -> f64    { return 2.0 }
pub fn clozapine_kp_spleen() -> f64  { return 4.0 }
pub fn clozapine_kp_pancreas() -> f64 { return 3.0 }
pub fn clozapine_kp_other() -> f64   { return 3.0 }
