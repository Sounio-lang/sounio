// darwin_pbpk/drugs/semaglutide.sio — Semaglutide PBPK Parameters
//
// Semaglutide (Ozempic / Wegovy, Novo Nordisk) — GLP-1 receptor agonist
// peptide, MW 4114 Da, once-weekly SC injection.
//
// PK class: large peptide, SC depot, vascular-dominant distribution.
// Framework boundaries (same as tirzepatide, drugs/tirzepatide.sio):
//   - Rodgers-Rowland tissue-composition Kp NOT applicable (peptide class;
//     validated only for MW < ~700 Da neutral/monoprotic small molecules)
//   - Active PBPK28 Kp path uses empirical Kp; the R-R module is a
//     reference/GUM layer only
//
// Canonical PBPK28 numbers live in:
//   - core/pbpk28_params.sio (pbpk28_params_semaglutide: organ volumes,
//     vascular fractions, empirical Kp, PS, flows, cl_central)
//   - epistemic_pbpk28.sio (ep28_semaglutide_priors: 7 Knowledge<f64> priors
//     with value+variance+epsilon+provenance)
// This file is the drug-identity home: chemistry, dosing, and thin accessors.
// It duplicates no numeric priors; the single source of truth stays upstream.
//
// Literature:
//   - Overgaard RV et al. (2019) — SC popPK, proteolytic CL
//   - Kapitza C et al. (2015) — early clinical PK
//   - Lau J et al. (2015) — peptide design/discovery
//   - Tougaard RS et al. (2022) — 99% albumin binding, fu_plasma = 0.01
//   - Carlsson 2020 — SC depot absorption model (F = 0.89, ka = ln2/60 h)

use darwin_pbpk::core::pbpk28_params::*;

// Molecular weight (Da). source: peptide identity
pub fn semaglutide_mw_da() -> f64 { return 4114.0 }

// Unbound fraction in plasma (99% albumin-bound). source: Tougaard 2022
pub fn semaglutide_fu_plasma() -> f64 { return 0.010 }

// SC absorption rate constant (h-1): ln(2)/60 h terminal rate.
// source: scenarios/semaglutide_sc_depot.sio (Overgaard 2019 / Carlsson 2020)
pub fn semaglutide_ka_sc() -> f64 { return 0.011552453009332421 }

// SC bioavailability. source: scenarios/semaglutide_sc_depot.sio (F = 0.89)
pub fn semaglutide_f_sc() -> f64 { return 0.89 }

// Canonical weekly SC dose (mg). source: scenarios/semaglutide_sc_depot.sio
pub fn semaglutide_dose_mg_weekly() -> f64 { return 1.0 }

// Proteolytic clearance, central (L/h). source: Overgaard 2019
pub fn semaglutide_cl_proteolytic() -> f64 { return 0.077 }

// Chemical identity: ChEBI:90816 (semaglutide)
pub fn semaglutide_chebi_id() -> i32 { return 90816 }

// Clearance process id: GO:0008152 metabolic process (proteolytic).
// NOTE (from epistemic_pbpk28.sio): the semaglutide clearance-process IRI
// currently delegates to the CYP3A4 enzymatic process identifier as a
// structural placeholder; the numeric process id below is the concrete value.
pub fn semaglutide_clearance_process_id() -> i32 { return 8152 }

// PBPK28 organ-level parameter bundle (volumes, Kp, PS, flows, cl_central).
// Single source: core/pbpk28_params.sio.
pub fn semaglutide_pbpk28_params() -> PBPKParams28 {
    return pbpk28_params_semaglutide()
}
