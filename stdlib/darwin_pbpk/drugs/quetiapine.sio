// darwin_pbpk/drugs/quetiapine.sio — Quetiapine Systemic PBPK Parameters
//
// Pharmacological identity:
//   - Atypical antipsychotic (Seroquel, AstraZeneca 1997)
//   - CYP3A4 substrate (~89% fm, DeVane 2001 — ketoconazole ×5 AUC;
//     the DDI angle with venlafaxine, Paulzen 2018, is follow-up: an
//     interaction claim needs its own mechanism, parameters and evaluation,
//     not just coadministration)
//   - Essentially complete oral bioavailability: F ≈ 1.00 (NO first-pass
//     loss — distinctive vs the other oral cards; the mass envelope caps
//     body mass by dose itself)
//   - Basic lipophilic amine; good CNS penetration (target organ)
//   - Plasma protein binding ~83%: fu ≈ 0.17; rb ≈ 1 (plasma referenced)
//   - TDM trough (debated): 100–500 ng/mL
//   - t½ ≈ 6 h (IR); CL ≈ 84 L/h, Vd ≈ 10 L/kg ≈ 700 L
//
// Literature anchor (archetype, verified SIO-525):
//   - DeVane CL & Nemeroff CB (2001) Clin Pharmacokinet 40:509-522
//     PMID 11510628, DOI 10.2165/00003088-200140070-00003
//     → canonical PK review: CYP3A4, CL, Vd, F, ka
//
// Confidence rubric: measured (label/replicated in vivo) ≥0.65;
// estimated from interactions 0.45–0.55; assumed (transport) ≤0.40.
// This card claims parity only (ADR009), not clinical validity.

pub fn quetiapine_mw() -> f64 { return 383.51 }

// ─── Single-dose design ─────────────────────────────────────────────────────
// 100 mg single oral IR tablet: standard single-dose PK probe
// (Cmax ~150-200 ng/mL, inside the TDM band; Tmax ~1 h).
pub fn quetiapine_single_dose_mg() -> f64 { return 100.0 }

// Absorption: Tmax ~1 h → ka ≈ 1.5/h (class: estimated from Tmax).
// F ≈ 1.00: essentially complete (label) — no first-pass loss modeled.
// Tablet lag 0.25 h.
pub fn quetiapine_ka_per_h() -> f64 { return 1.5 }
pub fn quetiapine_f_oral_val() -> f64 { return 1.00 }
pub fn quetiapine_tlag_h() -> f64 { return 0.25 }

// ─── Elimination fractions (justified, SIO-525 condition) ──────────────────
// fm_cyp3a4 ≈ 0.89: ketoconazole (strong 3A4 inhibitor) raises quetiapine
//   AUC ×5 (label, replicated), bounding fm ≥ 0.8; phenytoin (3A4 inducer)
//   raises CL ×5, confirming 3A4 as the dominant route.
// fm_other ≈ 0.11: CYP2D6 minor + direct excretion (remainder).
// Isolated scenario here; the Paulzen-2018 venlafaxine DDI needs its own
// mechanism/parameters/evaluation — explicitly NOT claimed from this card.
pub fn quetiapine_fm_cyp3a4() -> f64 { return 0.89 }
pub fn quetiapine_fm_other() -> f64  { return 0.11 }

// Systemic CL = 84 L/h (class: measured — label/popPK; 600 mg/day steady
// state averages F·D/CL ≈ 100·24/84... Cav,ss = F·D_tau/(CL·tau) with
// D_tau = 600 mg: 600/(84·24) ≈ 0.30 mg/L ≈ 300 ng/mL, inside 100–500).
pub fn quetiapine_cl_L_per_h() -> f64 { return 84.0 }

// Tissue-to-plasma Kp (class: estimated — Rodgers-Rowland pattern for a
// basic lipophilic amine, Vd target ~700 L; own values, adipose capped per
// the simulation-window note). Full-Vd variant is follow-up.
pub fn quetiapine_kp_liver() -> f64   { return 8.0 }
pub fn quetiapine_kp_kidney() -> f64  { return 4.0 }
pub fn quetiapine_kp_brain() -> f64   { return 3.0 }
pub fn quetiapine_kp_heart() -> f64   { return 3.0 }
pub fn quetiapine_kp_lung() -> f64    { return 6.0 }
pub fn quetiapine_kp_muscle() -> f64  { return 6.0 }
pub fn quetiapine_kp_adipose() -> f64 { return 5.0 }
pub fn quetiapine_kp_gut() -> f64     { return 4.0 }
pub fn quetiapine_kp_skin() -> f64    { return 3.0 }
pub fn quetiapine_kp_bone() -> f64    { return 2.0 }
pub fn quetiapine_kp_spleen() -> f64  { return 4.0 }
pub fn quetiapine_kp_pancreas() -> f64 { return 3.0 }
pub fn quetiapine_kp_other() -> f64   { return 3.0 }
