// darwin_pbpk/drugs/lithium.sio — Lithium Systemic PBPK Parameters
//
// Pharmacological identity:
//   - Mood stabilizer for bipolar disorder (lithium carbonate, 300 mg caps)
//   - The ONLY oral card with purely RENAL elimination — no CYP, no hepatic
//     clearance at all. Renal Li+ clearance ≈ 20–25% of GFR (proximal-tubule
//     Na+ competition): CL ≈ 1.3 L/h at normal GFR (Amdisen 1977)
//   - Narrow therapeutic index: trough 0.6–1.0 mEq/L (12 h post-dose)
//   - t½ ≈ 24 h single dose; Vd ≈ 0.7 L/kg ≈ 45–50 L (total-body-water-like)
//   - No protein binding (fu = 1.0); plasma referenced, rb ≈ 1
//   - Elemental basis: 300 mg Li2CO3 = 56.4 mg Li+ = 8.12 mEq (MW Li 6.94).
//     The model runs in mg Li+; divide by 6.94 for mEq/L.
//
// Literature anchor (archetype, verified SIO-520):
//   - Amdisen (1977) Clin Pharmacokinet 2:73-92
//     PMID 324690, DOI 10.2165/00003088-197702020-00001
//     → canonical PK review: renal elimination, narrow TI, TDM
//
// Kp policy (SIO-520 condition — NO predictors without ion domain):
//   - No Rodgers-Rowland (built for lipophilic neutrals, invalid for ions).
//   - Kp set from extracellular-fluid physiology + measured anchors:
//     most soft tissues ≈ ECF fraction 0.6–0.7; brain 0.4 (measured
//     brain:serum ~0.3–0.5, slow BBB equilibration); adipose 0.2 (ions
//     excluded from fat); kidney 0.8 (cortical concentration); Vd check:
//     ΣV·Kp + Vb ≈ 45 L ≈ 0.65 L/kg (Amdisen range).
//
// Confidence rubric: measured (label/replicated in vivo) ≥0.65;
// estimated from physiology/measured ratios 0.45–0.55;
// assumed (transport) ≤0.40.
// This card claims parity only (ADR009), not clinical validity.

pub fn lithium_mw() -> f64 { return 6.94 }
pub fn lithium_mg_per_meq() -> f64 { return 6.94 }

// ─── Single-dose design ─────────────────────────────────────────────────────
// 300 mg lithium carbonate single oral capsule = 56.4 mg Li+ (8.12 mEq):
// standard single-dose PK probe (Cmax ~0.2–0.4 mEq/L, below the TDM band,
// as expected for a single dose vs steady-state trough).
pub fn lithium_carbonate_dose_mg() -> f64 { return 300.0 }
pub fn lithium_elemental_mg() -> f64 { return 56.4 }
pub fn lithium_single_dose_meq() -> f64 { return 8.12 }

// Absorption: IR carbonate, Tmax ~1–2 h → ka ≈ 1.0/h (class: estimated).
// F ≈ 1.00: complete (label) — no first-pass loss (nothing hepatic at all).
// Tablet lag 0.25 h.
pub fn lithium_ka_per_h() -> f64 { return 1.0 }
pub fn lithium_f_oral_val() -> f64 { return 1.00 }
pub fn lithium_tlag_h() -> f64 { return 0.25 }

// Renal elimination ONLY: CL = 1.3 L/h (class: calibrated — Vd 45 L and
// t½ 24 h via CL = 0.693·Vd/t½; ≈22% of normal GFR 120 mL/min = 7.2 L/h,
// the documented fractional excretion; Amdisen 1977).
pub fn lithium_cl_L_per_h() -> f64 { return 1.3 }

// Tissue-to-plasma Kp (class: estimated — ECF rationale + measured brain
// ratio; adipose capped; Vd target ~45 L). Full-ECF variant is follow-up.
pub fn lithium_kp_liver() -> f64   { return 0.6 }
pub fn lithium_kp_kidney() -> f64  { return 0.8 }
pub fn lithium_kp_brain() -> f64    { return 0.4 }
pub fn lithium_kp_heart() -> f64    { return 0.6 }
pub fn lithium_kp_lung() -> f64     { return 0.6 }
pub fn lithium_kp_muscle() -> f64   { return 0.8 }
pub fn lithium_kp_adipose() -> f64  { return 0.2 }
pub fn lithium_kp_gut() -> f64      { return 0.6 }
pub fn lithium_kp_skin() -> f64     { return 0.5 }
pub fn lithium_kp_bone() -> f64     { return 0.5 }
pub fn lithium_kp_spleen() -> f64   { return 0.6 }
pub fn lithium_kp_pancreas() -> f64 { return 0.6 }
pub fn lithium_kp_other() -> f64    { return 0.6 }
