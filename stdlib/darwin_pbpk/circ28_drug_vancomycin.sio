// stdlib/darwin_pbpk/circ28_drug_vancomycin.sio — vancomycin on the circ28 drug record
//
// Vancomycin in a healthy adult (ICRP 89 reference male, 73 kg), intravenous infusion only.
// A hydrophilic glycopeptide (MW 1449), excluded from cells, filtered by the kidney and not
// metabolised to any appreciable extent. It tests the renal side of the kernel with a SECOND
// route declared and unidentified: cl_renal acts on arterial plasma reaching the kidney, and the
// remainder of the plasma clearance is the record's unidentified plasma clearance (CD_CLPLA), a
// first-order loss from the venous plasma with no organ attached and no mechanism claimed.
// There is no secretion term: renal clearance is the observed value, not fu x GFR.
//
// Units: mg, L, h; concentrations in mg/L. The molar value of a dose is printed with MW 1449.
// Sources were opened on 2026-11-15 (abstract level through PubMed; the DailyMed label as
// plain text). Nothing is from memory. "owner" marks a value the owner supplied and no opened
// source checks. "judgment" marks a number with no source for its uncertainty.
// STATUS: 1 measured, 2 derived by a stated formula from cited measurements, 3 fitted to ONE
// named observable (not a validation), 0 unused. u is the standard uncertainty of the value
// (what enters the budget), not an inter-individual SD: mean of n with SD: SD/sqrt(n); a range
// or a set of discordant estimates: range/sqrt(12).
//
//  param   value      u       status  basis / source
//  MW      1449       0       owner   task statement; no source opened for it
//  fu      0.70       0       owner   owner decision. Corroboration, not used: 30 % bound (Rodvold 1988,
//                                     n = 37, PMID 3415206 abstract); 55 % bound (Krogstad 1980, n = 4,
//                                     PMID 7381031 abstract; same figure in the DailyMed label for the
//                                     bulk package opened here). UNUSED by the model: the kernel applies
//                                     fu only in Rodgers-Rowland Kp and hepatic clearance, both
//                                     bypassed (Kp is a pattern x one fitted scalar; cl_renal is the
//                                     observed clearance)
//  B:P     0.55       0.03    2       bp = 1 - Hct, Hct 0.45 (circ28_kp_hct). UNSOURCED assumption: no
//                                     blood:plasma value for vancomycin was found (physchem_dossier s.
//                                     Gaps) and a PubMed search for red-cell uptake returned nothing.
//                                     The reasoning (a 1449 Da hydrophilic glycopeptide, no known
//                                     transporter into erythrocytes) is not a source. u = 0.03 judgment
//  clren   5.340 L/h  0.66    1       OBSERVED renal clearance 89 mL/min, standard error 11 mL/min,
//                                     9 healthy subjects at steady-state serum 7 and 14 mg/L, Golper
//                                     1988 Clin Pharmacol Ther 43:565 (PMID 3365918, abstract via the
//                                     dossier gaps_D3; not reopened here). The abstract's value is
//                                     "+/- 11 (SE)": u = 11 mL/min taken as the SE of the mean.
//                                     Same abstract: inulin 105, creatinine 117 mL/min, systemic
//                                     clearance 131 mL/min. Other renal clearances: 88.0 mL/min/1.73 m2
//                                     (Rodvold 1988, CLcr > 70, n in group not in abstract); label
//                                     0.048 L/kg/h = 3.50 L/h = 58.4 mL/min at 73 kg
//  clpla   0.6774 L/h 0.5472  2       UNIDENTIFIED plasma clearance, the non-renal remainder. The
//                                     value of Golper (131 - 89 = 42 mL/min) is NOT corroborated:
//                                     Rodvold total 98.4 - renal 88.0 = 10.4 mL/min/1.73 m2;
//                                     label 0.058 - 0.048 = 0.010 L/kg/h = 12.17 mL/min at 73 kg;
//                                     urinary recovery in 24 h: about 75 % (label), more than 80 %
//                                     (Matzke 1986 Clin Pharmacokinet 11:257, PMID 3530582, a review,
//                                     abstract only; primary reports of recovery were searched for
//                                     and not found). A recovery of 75-80 % means a non-renal share
//                                     of 20-25 % of the dose, which agrees with 12 mL/min of 71-100
//                                     and not with 42 of 131 (32 %) as strongly. USED: mean of the two
//                                     corroborating estimates, (10.4 + 12.17)/2 = 11.29 mL/min =
//                                     0.6774 L/h; u = (42 - 10.4)/sqrt(12) = 9.12 mL/min (the range of
//                                     all three estimates), 0.5472 L/h. The Golper variant (42) is
//                                     printed as a sensitivity. Renal fraction used 89/(89 + 11.29)
//                                     = 0.887 (the three estimates: 0.68, 0.83, 0.89)
//  kpsc    fitted     propagated 3    FITTED to V_ss = 59.1 L (below) on the interstitial pattern
//                                     Kp_i = kpsc x int_i/(1 - vas_i), the interstitial share of the
//                                     extravascular volume (physiology_primary.md s4, PK-Sim derived,
//                                     origin unverified, rest-of-body 0.164 = muscle by judgment, no
//                                     value found). NOT Rodgers-Rowland. With kpsc = 1 the pattern
//                                     gives only the interstitial space (printed by the test); the
//                                     fitted kpsc says by how much the observed V_ss exceeds it
//  pssc    fitted     propagated 3    FITTED to the central volume V1 = 10.95 L (below): one scalar
//                                     multiplies every organ's ps (default 20 Q_i)
//  ka, fa  -          -        0      intravenous only
//
// OBSERVABLES USED TO FIT (one per fitted parameter; NOT validations):
//   V_ss  59.13 L, u 3.79 L. Matzke 1984 AAC 25:433 (PMID 6732213, abstract; n = 56 patients,
//         doses 18.4 mg/kg): "steady-state volume of distribution varied from 0.72 to 0.90 L/kg",
//         midpoint 0.81 L/kg x 73 = 59.13 L, u = 0.18 x 73/sqrt(12). Patients, not volunteers; the
//         label gives a "distribution coefficient 0.3 to 0.43 L/kg" (22-31 L) and the Matzke 1986
//         review 0.39-0.97 L/kg; the spread of the literature is wider than u says, and is
//         propagated through the sensitivity of the budget.
//   V1    10.95 L, u 2.19 L. Matzke 1986 review (PMID 3530582, abstract): volume of the central
//         compartment "approximately 0.15 L/kg" x 73. A review value, no SD: u = 0.03 L/kg x 73
//         (20 %, judgment). Peeled from an intravenous bolus with windows fixed a priori
//         (terminal 12-48 h, residual 0.25-3 h).
//
// WHAT IS VALIDATION: Healy 1987 (AAC 31:393, PMID 3579256, n = 11) 1 g over 1 h q12h:
//   concentration at 1 h 33.7 +/- 3.8 mg/L, trough 7.9 +/- 1.7, AUC over the interval 227 +/- 28.3
//   mg h/L, terminal half-life 7.7 +/- 1.8 h, total clearance 86.1 +/- 8.9 mL/min/1.73 m2; the
//   label's concentrations (63 at the end of a 1 g/60 min infusion, 23 at 2 h after, 8 at 11 h
//   after); Krogstad 1980 intermediate half-life 0.43-1.48 h (n = 4) and elimination half-life
//   4.7-11.2 h; Matzke 1984 CL = 3.66 + 0.689 CLcr; Rodvold 1988 total clearance by renal
//   function group. Criteria and expectations are in tests/run-pass/circ28_drug_vancomycin.sio.

use darwin_pbpk::circ28::*
use darwin_pbpk::circ28_kp::*
use darwin_pbpk::circ28_drug::*
use darwin_pbpk::circ28_drug_lithium::*
use math::pure::{exp, ln}

// ---- measured / derived inputs ---------------------------------------------
pub fn va_mw() -> f64 { return 1449.0 }
pub fn va_hct() -> f64 { return 0.45 }
pub fn va_bp() -> f64 { return 1.0 - va_hct() }
pub fn va_u_bp() -> f64 { return 0.03 }
pub fn va_cl_ren_mlmin() -> f64 { return 89.0 }
pub fn va_u_cl_ren_mlmin() -> f64 { return 11.0 }
// non-renal remainder (unidentified plasma clearance), mL/min
pub fn va_nr_rodvold() -> f64 { return 10.4 }
pub fn va_nr_label() -> f64 { return 0.010 * 73.0 * 1000.0 / 60.0 }
pub fn va_nr_golper() -> f64 { return 42.0 }
pub fn va_cl_nr_mlmin() -> f64 { return 0.5 * (va_nr_rodvold() + va_nr_label()) }
pub fn va_u_cl_nr_mlmin() -> f64 { return (va_nr_golper() - va_nr_rodvold()) / 3.4641016151377544 }

// Observables of the fits
pub fn va_obs_vss() -> f64 { return 0.81 * 73.0 }
pub fn va_u_vss() -> f64 { return 0.18 * 73.0 / 3.4641016151377544 }
pub fn va_obs_v1() -> f64 { return 0.15 * 73.0 }
pub fn va_u_v1() -> f64 { return 0.03 * 73.0 }

// Peeling windows (fixed a priori): terminal 12-48 h, residual 0.25-3 h
pub fn va_w_tlo() -> f64 { return 12.0 }
pub fn va_w_thi() -> f64 { return 48.0 }
pub fn va_w_alo() -> f64 { return 0.25 }
pub fn va_w_ahi() -> f64 { return 3.0 }

// Stored result of the offline bisection (re-checked by the test)
pub fn va_pssc_fit() -> f64 { return 0.000615328637699 }

// ---- the interstitial pattern ------------------------------------------------
// int/(1 - vas) of physiology_primary.md s4, organs in circ28 order 1..13
pub fn va_int_share(i: i32) -> f64 {
    if i == 1 { return 0.196 }
    if i == 2 { return 0.260 }
    if i == 3 { return 0.004 }
    if i == 4 { return 0.116 }
    if i == 5 { return 0.448 }
    if i == 6 { return 0.164 }
    if i == 7 { return 0.163 }
    if i == 8 { return 0.098 }
    if i == 9 { return 0.317 }
    if i == 10 { return 0.104 }
    if i == 11 { return 0.224 }
    if i == 12 { return 0.150 }
    return 0.164
}

pub fn va_pattern(out: &![f64; 14]) with Mut {
    var i: i32 = 1
    while i < 14 {
        (*out)[i] = va_int_share(i)
        i = i + 1
    }
}

pub fn va_params(th: &[f64; 18]) -> Circ28Params with Mut, Div, Panic {
    var t2: [f64; 18] = [0.0; 18]
    var k: i32 = 0
    while k < 18 {
        t2[k] = (*th)[k]
        k = k + 1
    }
    var p = circ28_drug_params_theta(t2)
    var pat: [f64; 14] = [0.0; 14]
    va_pattern(&!pat)
    var i: i32 = 1
    while i < 14 {
        p.kp[i] = (*th)[CD_KPSC] * pat[i]
        i = i + 1
    }
    return p
}

pub fn va_kpsc_for(bp: f64, vss: f64) -> f64 with Mut, Div, Panic {
    var p = circ28_physiology()
    p.bp = bp
    var pat: [f64; 14] = [0.0; 14]
    va_pattern(&!pat)
    return circ28_kp_scale_for_vss(p, pat, vss)
}

// ---- profiles ---------------------------------------------------------------------
// One infusion of `dose` mg over t_inf h (t_inf a multiple of 0.05 h, <= 3 h) into a fresh body,
// on the grid of the lithium module (0.05 h to 3 h, 0.25 h to 312 h). cs[k] = venous plasma
// concentration (mg/L). Returns the plasma AUC 0..312 h; *tail receives c(312 h).
pub fn va_profile(p: Circ28Params, dose: f64, t_inf: f64, cs: &![f64; 1300], tail: &![f64; 2]) -> f64 with Mut, Div, Panic {
    var sys = circ28_sys_zero()
    var s = circ28_state_zero()
    var el = circ28_elim_zero()
    var k: i32 = 0
    var ph: i32 = 0
    var t = 0.0
    (*cs)[0] = 0.0
    while ph < 2 {
        var dt = 0.05
        var n: i32 = 60
        if ph == 1 {
            dt = 0.25
            n = 1236
        }
        circ28_prepare(p, dt, &!sys)
        var j: i32 = 0
        while j < n {
            let iv = circ28_iv_mass(dose, t_inf, t, t + dt) / dt
            circ28_step(&!s, p, &sys, iv, 0.0, &!el)
            t = t + dt
            k = k + 1
            (*cs)[k] = s.x[0] / p.bp
            j = j + 1
        }
        ph = ph + 1
    }
    (*tail)[0] = (*cs)[1296]
    (*tail)[1] = s.x[3]
    return el.auc_ven / p.bp
}

// Peeled parameters for th (1 mg bolus over 0.05 h): out[0] intermediate half-life (h) of the
// residual, out[1] central volume V1 = dose/(A + B) (L), out[2] terminal half-life (h), out[3] V_area.
pub fn va_peeled(th: &[f64; 18], out: &![f64; 4]) with Mut, Div, Panic {
    let p = va_params(th)
    var cs: [f64; 1300] = [0.0; 1300]
    var tail: [f64; 2] = [0.0; 2]
    let a = va_profile(p, 1.0, 0.05, &!cs, &!tail)
    var pe: [f64; 4] = [0.0; 4]
    li_peel(&cs, va_w_tlo(), va_w_thi(), va_w_alo(), va_w_ahi(), &!pe)
    (*out)[0] = 0.6931471805599453 / pe[2]
    (*out)[1] = 1.0 / (pe[1] + pe[3])
    (*out)[2] = 0.6931471805599453 / pe[0]
    (*out)[3] = 1.0 / (pe[0] * (pe[3] / pe[2] + pe[1] / pe[0]))
}

// ---- record fill -----------------------------------------------------------------------
pub fn va_measured_record(d: &!Circ28Drug) with Mut, Div, Panic, Epistemic {
    circ28_drug_set(d, CD_MW, va_mw(), 0.0, CD_STATUS_MEASURED, "owner: MW 1449")
    circ28_drug_set(d, CD_FU, 0.7, 0.0, CD_STATUS_UNUSED, "owner decision fu 0.7; Rodvold1988 30 % bound; unused (Kp and clearances bypass fu)")
    circ28_drug_set(d, CD_BP, va_bp(), va_u_bp(), CD_STATUS_DERIVED, "bp = 1 - Hct 0.45; UNSOURCED assumption (no blood:plasma found); u judgment")
    circ28_drug_set(d, CD_CLREN, va_cl_ren_mlmin() * 0.06, va_u_cl_ren_mlmin() * 0.06, CD_STATUS_MEASURED, "Golper1988 renal CL 89 +/- 11 (SE) mL/min, n = 9")
    circ28_drug_set(d, CD_CLPLA, va_cl_nr_mlmin() * 0.06, va_u_cl_nr_mlmin() * 0.06, CD_STATUS_DERIVED, "unidentified non-renal plasma CL: mean of Rodvold1988 10.4 and label 12.17 mL/min; Golper 42 not corroborated")
}

pub fn va_fit_kpsc_record(d: &!Circ28Drug) with Mut, Div, Panic, Epistemic {
    let bp = circ28_drug_value(d, CD_BP)
    let u_bp = cd_sqrt(circ28_drug_variance(d, CD_BP))
    let vss = va_obs_vss()
    let k0 = va_kpsc_for(bp, vss)
    let hb = 1.0e-3 * bp
    let hv = 1.0e-4 * vss
    let dk_dbp = (va_kpsc_for(bp + hb, vss) - va_kpsc_for(bp - hb, vss)) / (2.0 * hb)
    let dk_dv = (va_kpsc_for(bp, vss + hv) - va_kpsc_for(bp, vss - hv)) / (2.0 * hv)
    let u = cd_sqrt(dk_dbp * dk_dbp * u_bp * u_bp + dk_dv * dk_dv * va_u_vss() * va_u_vss())
    circ28_drug_set(d, CD_KPSC, k0, u, CD_STATUS_FITTED, "fitted to Vss 59.13 L (Matzke1984 midpoint) on the interstitial pattern; u from u(Vss), u(bp)")
}

pub fn va_v1_at(d: &Circ28Drug, pssc: f64) -> f64 with Mut, Div, Panic, Epistemic {
    var th: [f64; 18] = [0.0; 18]
    var i: i32 = 0
    while i < 18 {
        th[i] = circ28_drug_value(d, i)
        i = i + 1
    }
    th[CD_PSSC] = pssc
    var o: [f64; 4] = [0.0; 4]
    va_peeled(&th, &!o)
    return o[1]
}

pub fn va_pssc_record(d: &!Circ28Drug) with Mut, Div, Panic, Epistemic {
    let x = va_pssc_fit()
    let h = 1.0e-2 * x
    let slope = (va_v1_at(d, x + h) - va_v1_at(d, x - h)) / (2.0 * h)
    var sa = slope
    if sa < 0.0 { sa = 0.0 - sa }
    circ28_drug_set(d, CD_PSSC, x, va_u_v1() / sa, CD_STATUS_FITTED, "fitted to the central volume V1 0.15 L/kg x 73 kg (Matzke1986 review); u from u(V1)/|dV1/dpssc|")
}

pub fn va_drug_into(d: &!Circ28Drug) with Mut, Div, Panic, Epistemic {
    va_measured_record(d)
    va_fit_kpsc_record(d)
    va_pssc_record(d)
}

// ---- uncertainty budget with refit ------------------------------------------------------
// Five inputs: 0 bp, 1 cl_ren (mL/min), 2 cl_nonrenal (mL/min), 3 V_ss obs (L), 4 V1 obs (L).
// Each evaluation rebuilds the record, refits kpsc in closed form and pssc by one chord correction
// on V1 (slope taken once at the nominal values), then runs 1000 mg over 1 h. Outputs: out[0]
// AUC_inf (mg h/L), out[1] steady-state trough of 1 g over 1 h q12h (mg/L).
pub fn va_u_inputs(u: &![f64; 5]) with Mut {
    (*u)[0] = va_u_bp()
    (*u)[1] = va_u_cl_ren_mlmin()
    (*u)[2] = va_u_cl_nr_mlmin()
    (*u)[3] = va_u_vss()
    (*u)[4] = va_u_v1()
}
pub fn va_z_nominal(z: &![f64; 5]) with Mut {
    (*z)[0] = va_bp()
    (*z)[1] = va_cl_ren_mlmin()
    (*z)[2] = va_cl_nr_mlmin()
    (*z)[3] = va_obs_vss()
    (*z)[4] = va_obs_v1()
}

pub fn va_eval(z: &[f64; 5], th0: &[f64; 18], slope_v1: f64, out: &![f64; 2]) with Mut, Div, Panic {
    var t: [f64; 18] = [0.0; 18]
    var k: i32 = 0
    while k < 18 {
        t[k] = (*th0)[k]
        k = k + 1
    }
    t[CD_BP] = (*z)[0]
    t[CD_CLREN] = (*z)[1] * 0.06
    t[CD_CLPLA] = (*z)[2] * 0.06
    t[CD_KPSC] = va_kpsc_for(t[CD_BP], (*z)[3])
    var o: [f64; 4] = [0.0; 4]
    va_peeled(&t, &!o)
    t[CD_PSSC] = t[CD_PSSC] + ((*z)[4] - o[1]) / slope_v1
    let p = va_params(&t)
    var cs: [f64; 1300] = [0.0; 1300]
    var tail: [f64; 2] = [0.0; 2]
    let a = va_profile(p, 1000.0, 1.0, &!cs, &!tail)
    var pe: [f64; 4] = [0.0; 4]
    li_peel(&cs, va_w_tlo(), va_w_thi(), va_w_alo(), va_w_ahi(), &!pe)
    (*out)[0] = a + cs[1296] / pe[0]
    var ss: [f64; 5] = [0.0; 5]
    li_ss_from(&cs, 1.0, 12.0, &!ss)
    (*out)[1] = ss[0]
}

// b: [0] AUC0, [1] trough0, [2..6] variance contributions to AUC, [7..11] to trough,
// [12..16] AUC sensitivities, [17..21] trough sensitivities, [22..26] u_i, [27] var_AUC, [28] var_trough
pub fn va_budget(th0: &[f64; 18], slope_v1: f64, b: &![f64; 40]) with Mut, Div, Panic {
    var z0: [f64; 5] = [0.0; 5]
    va_z_nominal(&!z0)
    var u: [f64; 5] = [0.0; 5]
    va_u_inputs(&!u)
    var o0: [f64; 2] = [0.0; 2]
    va_eval(&z0, th0, slope_v1, &!o0)
    (*b)[0] = o0[0]
    (*b)[1] = o0[1]
    var va = 0.0
    var vt = 0.0
    var i: i32 = 0
    while i < 5 {
        var zp: [f64; 5] = [0.0; 5]
        var zm: [f64; 5] = [0.0; 5]
        var j: i32 = 0
        while j < 5 {
            zp[j] = z0[j]
            zm[j] = z0[j]
            j = j + 1
        }
        let h = 0.01 * u[i] + 1.0e-9
        zp[i] = z0[i] + h
        zm[i] = z0[i] - h
        var op: [f64; 2] = [0.0; 2]
        var om: [f64; 2] = [0.0; 2]
        va_eval(&zp, th0, slope_v1, &!op)
        va_eval(&zm, th0, slope_v1, &!om)
        let sa = (op[0] - om[0]) / (2.0 * h)
        let st = (op[1] - om[1]) / (2.0 * h)
        (*b)[12 + i] = sa
        (*b)[17 + i] = st
        (*b)[22 + i] = u[i]
        (*b)[2 + i] = sa * sa * u[i] * u[i]
        (*b)[7 + i] = st * st * u[i] * u[i]
        va = va + sa * sa * u[i] * u[i]
        vt = vt + st * st * u[i] * u[i]
        i = i + 1
    }
    (*b)[27] = va
    (*b)[28] = vt
}
