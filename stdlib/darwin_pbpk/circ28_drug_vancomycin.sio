// stdlib/darwin_pbpk/circ28_drug_vancomycin.sio — vancomycin on the circ28 drug record
//
// Vancomycin in a healthy adult (ICRP 89 reference male, 73 kg), intravenous infusion only.
// A hydrophilic glycopeptide (MW 1449), excluded from cells, filtered by the kidney and not
// metabolised to any appreciable extent. It tests the renal side of the kernel with a SECOND
// route declared and unidentified: cl_renal acts on arterial plasma reaching the kidney, and the
// remainder of the plasma clearance is the record's unidentified plasma clearance (CD_CLPLA), a
// first-order loss from the venous plasma with no organ attached and no mechanism claimed.
// There is no secretion term: renal clearance is the observed value, not fu x GFR.
//
// CURRENT STATE: ROUND 4. The table directly below is the current parameter set; the text after it (rounds
// 1-3) is kept as the record and is SUPERSEDED where it differs (V_ss 59.13 L of Matzke 1984, cl_renal 89
// mL/min of Golper alone, remainder 11.3 mL/min, the four-study half-life pool 7.69 h).
//  param    value        u        status  basis (round 4; study tables at va_tab_*; all pooled in va_pool)
//  V_ss     41.21 L      5.22     pooled  0.5646 L/kg (k 3, N 23: Blouin 1982, Healy 1987, Smit 2020 derived
//                                         V1+V2+V3) SCALED to the 73 kg reference body; u = SE_b
//  CL       99.94 mL/min 7.34     pooled  systemic clearance, k 6, N 48 (Blouin, Healy, Davis 1987, Boeckh 1988,
//                                         Golper 1988, Smit 2020), as reported, not rescaled by weight; u = SE_b
//  fe       0.7748       0.0531   pooled  renal fraction, k 3, N 25 (Davis 24-h urine, Boeckh 48-h urine, Golper
//                                         CL_R/CL); u = SE_b
//  t1/2     6.337 h      0.515    pooled  terminal half-life, k 7, N 47 (Blouin, Healy, Davis, Boeckh, Lagast
//                                         1986, Cutler 1984 young, Krogstad 1980); u = SE_b
//  clren    4.646 L/h    0.467    2       cl_renal = fe x CL (77.43 mL/min); the user's structure: renal clearance
//                                         on arterial plasma in the kidney
//  clpla    1.350 L/h    0.333    2       unidentified remainder (1 - fe) x CL (22.50 mL/min), no mechanism claimed
//  kpsc     2.927        0.680    3       deep-space scalar kd, FITTED (closed form) to the pooled V_ss
//  pssc     0.0050026    0.0019   3       FITTED (offline bisection, stored) to the pooled terminal half-life
//  bp, r, interstitial pattern and scale: as round 3 (bp 0.55 UNSOURCED; r 0.784 assumption)
// Why the inputs changed: Matzke 1984 full text: the "steady-state volume 0.72-0.90 L/kg" is a ONE-compartment
// volume in PATIENTS sampled from 3 h after the infusion; Rotschafer 1982: 21 of 28 patients had severe
// burns. Neither belongs to a healthy-adult pool. With the pooled pair V_ss ln2/CL = 4.76 h against the
// terminal 6.34 h (rounds 2-3: 6.81 against 7.69), so a distribution phase fits.
// Healy 1987 full text: lot potency 597 mg per 500-mg vial and "actual doses" used; 86.1 mL/min/1.73 m2 x 227
// mg h/L = 1173-1194 mg: Healy's nominal 1 g is taken as 1194 mg in the validation rows (my reading).
// Access: Blouin, Healy, Davis, Boeckh, Matzke, Rotschafer, Rodvold, Smit: full running text (tables not
// extracted); Golper, Cutler, Lagast, Krogstad: abstract (Krogstad's means quoted by Blouin).
//
// Units: mg, L, h; concentrations in mg/L. The molar value of a dose is printed with MW 1449.
// Sources were opened on 2026-11-15 (abstract level through PubMed; the DailyMed label as
// plain text). Nothing is from memory. "owner" marks a value the owner supplied and no opened
// source checks. "judgment" marks a number with no source for its uncertainty.
// STATUS: 1 measured, 2 derived by a stated formula from cited measurements, 3 fitted to ONE
// named observable (not a validation), 0 unused. u is the standard uncertainty of the value
// (what enters the budget), not an inter-individual SD: mean of n with SD: SD/sqrt(n); a range
// or a set of discordant estimates: range/sqrt(12).
//
//  param   value      u       status  basis / source
//  MW      1449       0       owner   task statement; no source opened for it
//  fu      0.70       0       owner   owner decision. Corroboration, not used: 30 % bound (Rodvold 1988,
//                                     n = 37, PMID 3415206 abstract); 55 % bound (Krogstad 1980, n = 4,
//                                     PMID 7381031 abstract; same figure in the DailyMed label for the
//                                     bulk package opened here). UNUSED by the model: the kernel applies
//                                     fu only in Rodgers-Rowland Kp and hepatic clearance, both
//                                     bypassed (Kp is a pattern x one fitted scalar; cl_renal is the
//                                     observed clearance)
//  B:P     0.55       0.03    2       bp = 1 - Hct, Hct 0.45 (circ28_kp_hct). UNSOURCED assumption: no
//                                     blood:plasma value for vancomycin was found (physchem_dossier s.
//                                     Gaps) and a PubMed search for red-cell uptake returned nothing.
//                                     The reasoning (a 1449 Da hydrophilic glycopeptide, no known
//                                     transporter into erythrocytes) is not a source. u = 0.03 judgment
//  clren   5.340 L/h  0.66    1       OBSERVED renal clearance 89 mL/min, standard error 11 mL/min,
//                                     9 healthy subjects at steady-state serum 7 and 14 mg/L, Golper
//                                     1988 Clin Pharmacol Ther 43:565 (PMID 3365918, abstract via the
//                                     dossier gaps_D3; not reopened here). The abstract's value is
//                                     "+/- 11 (SE)": u = 11 mL/min taken as the SE of the mean.
//                                     Same abstract: inulin 105, creatinine 117 mL/min, systemic
//                                     clearance 131 mL/min. Other renal clearances: 88.0 mL/min/1.73 m2
//                                     (Rodvold 1988, CLcr > 70, n in group not in abstract); label
//                                     0.048 L/kg/h = 3.50 L/h = 58.4 mL/min at 73 kg
//  clpla   0.6774 L/h 0.5472  2       UNIDENTIFIED plasma clearance, the non-renal remainder. The
//                                     value of Golper (131 - 89 = 42 mL/min) is NOT corroborated:
//                                     Rodvold total 98.4 - renal 88.0 = 10.4 mL/min/1.73 m2;
//                                     label 0.058 - 0.048 = 0.010 L/kg/h = 12.17 mL/min at 73 kg;
//                                     urinary recovery in 24 h: about 75 % (label), more than 80 %
//                                     (Matzke 1986 Clin Pharmacokinet 11:257, PMID 3530582, a review,
//                                     abstract only; primary reports of recovery were searched for
//                                     and not found). A recovery of 75-80 % means a non-renal share
//                                     of 20-25 % of the dose, which agrees with 12 mL/min of 71-100
//                                     and not with 42 of 131 (32 %) as strongly. USED: mean of the two
//                                     corroborating estimates, (10.4 + 12.17)/2 = 11.29 mL/min =
//                                     0.6774 L/h; u = (42 - 10.4)/sqrt(12) = 9.12 mL/min (the range of
//                                     all three estimates), 0.5472 L/h. The Golper variant (42) is
//                                     printed as a sensitivity. Renal fraction used 89/(89 + 11.29)
//                                     = 0.887 (the three estimates: 0.68, 0.83, 0.89)
//  kpsc    fitted     propagated 3    FITTED to V_ss = 59.1 L (below) on the interstitial pattern
//                                     Kp_i = kpsc x int_i/(1 - vas_i), the interstitial share of the
//                                     extravascular volume (physiology_primary.md s4, PK-Sim derived,
//                                     origin unverified, rest-of-body 0.164 = muscle by judgment, no
//                                     value found). NOT Rodgers-Rowland. With kpsc = 1 the pattern
//                                     gives only the interstitial space (printed by the test); the
//                                     fitted kpsc says by how much the observed V_ss exceeds it
//  pssc    fitted     propagated 3    ROUND 2: FITTED to the TERMINAL HALF-LIFE 7.69 h, u 0.64 h (pooled
//                                     over normal-renal-function studies, below): a rate observable for
//                                     a rate parameter. One scalar multiplies every organ's ps (default
//                                     20 Q_i). (Round 1 fitted V1 = 10.95 L, a volume, which does not
//                                     identify the exchange rate; it gave a terminal half-life of 20 h.)
//  ka, fa  -          -        0      intravenous only
//
// OBSERVABLES USED TO FIT (one per fitted parameter; NOT validations):
//   V_ss  59.13 L, u 3.79 L. Matzke 1984 AAC 25:433 (PMID 6732213, abstract; n = 56 patients,
//         doses 18.4 mg/kg): "steady-state volume of distribution varied from 0.72 to 0.90 L/kg",
//         midpoint 0.81 L/kg x 73 = 59.13 L, u = 0.18 x 73/sqrt(12). Patients, not volunteers; the
//         label gives a "distribution coefficient 0.3 to 0.43 L/kg" (22-31 L) and the Matzke 1986
//         review 0.39-0.97 L/kg; the spread of the literature is wider than u says, and is
//         propagated through the sensitivity of the budget.
//   t1/2  terminal half-life 7.69 h, u 0.64 h (ROUND 2 fit of pssc). Studies in normal renal function,
//         abstracts only (PubMed, 2026-11-15): Healy 1987 (n = 11 healthy, 3-compartment fit) 7.7 +/- 1.8 h;
//         Krogstad 1980 (n = 4 healthy) 4.7-11.2 h, midpoint 7.95; Matzke 1984 group I (CLcr > 60, n = 7)
//         9.1 h, no SD in the abstract; Rotschafer 1982 (n = 28 patients, mixed renal function, normal
//         renal function not separated) mean 6 h, range 3-13. Not pooled, same-direction context: label
//         4-6 h; Matzke 1986 review 3-9 h. Pooled mean of the four study values 7.69 h; u = max(pooled SE of
//         the one study with an SD, 1.8/sqrt(11) = 0.54; between-study SD 1.28/sqrt(4) = 0.64) = 0.64 h
//         (computed in va_t12_pool). The model's half-life is the log-linear slope of an intravenous bolus
//         profile over 12-48 h (fixed a priori), a 3-exponential curve read as a terminal phase.
//   VALIDATION (not fitted, round 2): central volume V1 0.15 L/kg x 73 = 10.95 L (Matzke 1986 review,
//         abstract; u judgment 0.03 L/kg), Rotschafer 1982 central volume 9.0 +/- 4.0 L and distribution
//         half-life 0.5 +/- 0.3 h (n = 28 patients), Krogstad 1980 intermediate half-life 0.43-1.48 h,
//         Matzke 1986 alpha half-life 0.5-1 h. Population models with an intercompartmental clearance
//         (Q), all patients not normal renal function, none used: Mangin 2014 ICU post-sternotomy Q 5.71 L/h
//         (V1 21.9, V2 68 L; PMID 25117184); Escobar 2014 ICU on haemofiltration Q 9.3 L/h (V1 11.8, V2
//         18.0 L; PMID 24837847); Goyal 2022 pregnancy Q 9.06 L/h (V1 67.35 L; PMID 35734401); Westra 2019
//         haemodiafiltration Q 9.96 L/h fixed (PMID 31086400); Mulla 2005 ECMO Q 0.09 L/kg/h = 6.6 L/h
//         (PMID 16120065); Thomson 2009 (PMID 19299472, Vss 1.4 L/kg, CL 3.0 L/h, no Q in the abstract),
//         Goti 2018 (PMID 29470227) and Buelga 2005 (PMID 16304155, one-compartment) give no usable Q.
//         Their Q (5.7-10 L/h) is a sanity range for the model's effective exchange, not a fit target.
//   V_ss  59.13 L is the other fit (above).
//
// WHAT IS VALIDATION (round 2 adds V1, alpha above): Healy 1987 (AAC 31:393, PMID 3579256, n = 11) 1 g over 1 h q12h:
//   concentration at 1 h 33.7 +/- 3.8 mg/L, trough 7.9 +/- 1.7, AUC over the interval 227 +/- 28.3
//   mg h/L, terminal half-life 7.7 +/- 1.8 h, total clearance 86.1 +/- 8.9 mL/min/1.73 m2; the
//   label's concentrations (63 at the end of a 1 g/60 min infusion, 23 at 2 h after, 8 at 11 h
//   after); Krogstad 1980 intermediate half-life 0.43-1.48 h (n = 4) and elimination half-life
//   4.7-11.2 h; Matzke 1984 CL = 3.66 + 0.689 CLcr; Rodvold 1988 total clearance by renal
//   function group. Criteria and expectations are in tests/run-pass/circ28_drug_vancomycin.sio.

//
// ROUND 3 (kernel unchanged): FAST = vascular + interstitial, DEEP = the remainder of V_ss.
// Read from circ28.sio: vascular state volume v_i vf_i (blood concentration C_i), tissue state volume
// v_i (1 - vf_i) (T_i), exchange ps_i (C_i/bp - T_i/kp_i), circ28_blood_volume = pools + sum v_i vf_i,
// circ28_vss_plasma = bp x blood_volume + sum v_i (1 - vf_i) kp_i. Per organ, with vas_i the kernel's
// ICRP vascular fraction, int_i = share_i (1 - vas_i) the interstitial fraction of the organ volume and r
// the interstitial:plasma total concentration ratio at equilibrium:
//   flow-limited state: content at plasma concentration Cp is v_i (vas_i bp + int_i r) Cp = v_i vf'_i bp Cp
//     => vf'_i = vas_i + int_i r / bp. Plasma-referred fast volume = bp (pools + sum v_i vf'_i)
//     = bp x 5.3 + r sum v_i int_i = 11.01 L (the term circ28_vss_plasma calls bp x blood volume).
//   permeability-limited state: bookkeeping volume v_i (1 - vf'_i), kp_i = kd int_i / (1 - vf'_i), capacity
//     kd v_i int_i; kd = (V_ss - fast volume) / sum v_i int_i = 4.663 (closed form; deep capacity 48.12 L,
//     distributed like the interstitium, as in rounds 1-2). ps_i = 20 pssc Q_i, pssc refitted to the pooled
//     terminal half-life: 0.02515.
//   Mass balance, V_ss, CL = cl_renal + cl_plasma and AUC = dose/CL do not depend on the split (asserted).
//  r       0.784      0.12    2       r = fu + (1 - fu) K, fu 0.70 (owner), K = 0.28 whole-body interstitial:
//                                     plasma albumin ratio (Levitt 2003 BMC Clin Pharmacol 3:3, PMID 12890292,
//                                     full text; fitted there to six beta-lactams, alpha = 1.1). ASSUMPTION for
//                                     vancomycin (binds IgA as well; 1449 Da may see an excluded volume); u is
//                                     judgment covering fu 0.45-0.72 and that exclusion
//  int_i   pattern    11.8 %  2       interstitial share of extravascular volume, swarm physiology_primary.md s4
//                                     (PK-Sim 11.2 database fractions, secondary; Kawai 1994 PMID 7791036 and
//                                     Shah & Betts 2012 PMID 22143261 not opened). Sum on circ28 volumes 10.32 L;
//                                     Levitt 2003 (human, full text, tables not in the extraction): extracellular
//                                     17.45 L incl. plasma water (read so), i.e. about 14.5 L interstitial. One
//                                     scale factor (nominal 1), u = (14.535/10.32 - 1)/sqrt(12) = 0.118
// OUTCOME: the reinterpretation changes the profile after 0.25 h by under 1 % (see the test header): the
// distribution failure of rounds 1-2 is not caused by the single well-mixed tissue space.

use darwin_pbpk::circ28::*
use darwin_pbpk::circ28_kp::*
use darwin_pbpk::circ28_drug::*
use darwin_pbpk::circ28_drug_lithium::*
use math::pure::{exp, ln}

// ---- measured / derived inputs ---------------------------------------------
pub fn va_mw() -> f64 { return 1449.0 }
pub fn va_hct() -> f64 { return 0.45 }
pub fn va_bp() -> f64 { return 1.0 - va_hct() }
pub fn va_u_bp() -> f64 { return 0.03 }
// ---- ROUND 4: pooled observables (computed here; the test prints every table) ----------------
// Pooling rule of the project (same as mdz_pool): n-weighted mean of the study means;
//   sw = sqrt(sum (n_i - 1) s_i^2 / sum (n_i - 1)) over the studies with an SD; SE_w = sw / sqrt(N);
//   sb = SD of the k study means (unweighted, k - 1); SE_b = sb / sqrt(k); u = max(SE_w, SE_b).
// A study without an SD (s_i <= 0) enters the mean and sb, not sw.
// out: [0] mean, [1] N, [2] sw, [3] SE_w, [4] sb, [5] SE_b, [6] u, [7] k
pub fn va_pool(m: &[f64; 8], s: &[f64; 8], n: &[f64; 8], k: i32, out: &![f64; 8]) with Mut, Div {
    var sn = 0.0
    var sm = 0.0
    var mm = 0.0
    var num = 0.0
    var den = 0.0
    var i: i32 = 0
    while i < k {
        sn = sn + (*n)[i]
        sm = sm + (*n)[i] * (*m)[i]
        mm = mm + (*m)[i]
        if (*s)[i] > 0.0 && (*n)[i] > 1.0 {
            num = num + ((*n)[i] - 1.0) * (*s)[i] * (*s)[i]
            den = den + ((*n)[i] - 1.0)
        }
        i = i + 1
    }
    let kf = k as f64
    let mbar = mm / kf
    var ss = 0.0
    i = 0
    while i < k {
        let dv = (*m)[i] - mbar
        ss = ss + dv * dv
        i = i + 1
    }
    var sb = 0.0
    if k > 1 { sb = cd_sqrt(ss / (kf - 1.0)) }
    var sw = 0.0
    if den > 0.0 { sw = cd_sqrt(num / den) }
    let se_w = sw / cd_sqrt(sn)
    let se_b = sb / cd_sqrt(kf)
    var u = se_w
    if se_b > u { u = se_b }
    (*out)[0] = sm / sn
    (*out)[1] = sn
    (*out)[2] = sw
    (*out)[3] = se_w
    (*out)[4] = sb
    (*out)[5] = se_b
    (*out)[6] = u
    (*out)[7] = kf
}

// (a) V_ss, L/kg, healthy adults with normal renal function, intravenous. ONLY values that are a
//     steady-state volume (non-compartmental AUMC, or the sum of the compartment volumes):
//   0 Blouin 1982 AAC 21:575 (PMID 7081978, full text): 4 healthy men, 65.9-89.1 kg, 1 g over 40 min,
//     sampled 24 h, V_ss by AUMC: 0.39 +/- 0.06 L/kg (mean 28.9 L)
//   1 Healy 1987 AAC 31:393 (PMID 3579256, full text): 11 healthy (7 M, 4 F), 66.5 +/- 11.2 kg, 1 g
//     over 1 h q12h, last dose sampled 36 h, non-compartmental multiple-dose V_ss: 0.59 +/- 0.04 L/kg
//     (the 500 mg q6h arm of the same subjects: 0.59 +/- 0.13; one arm used)
//   2 Smit 2020 BJCP 86:303 (PMID 31661553, full text): population model (3-compartment) of 8 non-obese
//     healthy volunteers and 20 obese, 1 g at 10 mg/min, sampled 48 h; typical 70 kg, 36.5 y:
//     V1 16.7 (RSE 18 %), V2 6.98 (17 %), V3 19.5 (13 %) L. DERIVED here: V_ss = V1 + V2 + V3 = 43.18 L
//     = 0.6169 L/kg; SE = root sum of squares of the three SEs = 4.108 L (correlations ignored) =
//     0.05869 L/kg; entered with n = 8 (the healthy non-obese subjects) and SD = SE sqrt(8)
// NOT pooled: Krogstad 1980 V_area 0.92 L/kg (a V_area, n 4, quoted by Blouin 1982); Boeckh 1988
//   36.1 +/- 6.3 L per 70 kg (0.5 g) is CL/beta to 2 %, i.e. a V_area, not a V_ss; Davis 1987 and Cutler
//   1984 report a V_ss whose value was not readable/accessible; label "distribution coefficient"
//   0.3-0.43 L/kg (undefined); PATIENTS: Matzke 1984 0.72 +/- 0.35 L/kg (group I; one-compartment
//   volume from samples taken 3 h or later after the infusion, not a V_ss), Rotschafer 1982 Vd-beta 39 L
//   (21 of 28 with severe burns), Rodvold 1988, Pleasants 1996 (cystic fibrosis, 0.58 +/- 0.15 L/kg),
//   Ducharme 1994 (0.69 L/kg ideal weight, one-compartment, monitoring data), Yasuhara 1998 (60.7 L).
pub fn va_tab_vss(m: &![f64; 8], s: &![f64; 8], n: &![f64; 8]) -> i32 with Mut, Div {
    (*m)[0] = 0.39
    (*s)[0] = 0.06
    (*n)[0] = 4.0
    (*m)[1] = 0.59
    (*s)[1] = 0.04
    (*n)[1] = 11.0
    let se = cd_sqrt(0.18 * 16.7 * 0.18 * 16.7 + 0.17 * 6.98 * 0.17 * 6.98 + 0.13 * 19.5 * 0.13 * 19.5) / 70.0
    (*m)[2] = (16.7 + 6.98 + 19.5) / 70.0
    (*s)[2] = se * cd_sqrt(8.0)
    (*n)[2] = 8.0
    return 3
}

// (b) total (systemic) clearance, mL/min, healthy adults with normal renal function, each as the study
//     reports it (its own subjects or its own normalisation; NOT rescaled to 73 kg: clearance follows
//     renal function, and Smit 2020 finds a weight exponent 0.54, i.e. 2 % between 70 and 73 kg):
//   0 Blouin 1982: 80.78 mL/min (1.085 +/- 0.071 mL/min/kg), n 4; SD 5.29 = 80.78 x 0.071/1.085 (DERIVED)
//   1 Healy 1987: 86.1 +/- 8.9 mL/min per 1.73 m2, n 11 (actual dose / steady-state AUC)
//   2 Davis 1987 AAC 31:720 (PMID 3606073, full text): 6 healthy men, mean 78 kg, 1 g over 1 h,
//     non-compartmental, 6.4 +/- 1.0 L/h = 106.67 +/- 16.67 mL/min
//   3 Boeckh 1988 AAC 32:92 (PMID 3279907, full text): 10 healthy (5 M, 5 F), 0.5 g over 1 h, two-
//     compartment, normalised to 70 kg: 94.5 +/- 15.9 mL/min (1 g arm of the same subjects: 96.5 +/- 18.1)
//   4 Golper 1988 CPT 43:565 (PMID 3365918, abstract): 9 healthy, steady-state infusion, 131 +/- 7 (SE)
//     mL/min; SD = 7 x 3 = 21
//   5 Smit 2020: 5.72 L/h (RSE 5 %) at 70 kg = 95.33 mL/min, SE 4.767; n 8, SD = SE sqrt(8)
// NOT pooled: Krogstad 1980 1.19 mL/min/kg (quoted by Blouin, no SD, weights unknown); label 0.058
//   L/kg/h (population not stated); Cutler 1984 (value not accessible); patients (Matzke group I 62.7 +/-
//   25.3, Rodvold group 1 98.4/1.73 m2, Rotschafer, Pleasants).
pub fn va_tab_cl(m: &![f64; 8], s: &![f64; 8], n: &![f64; 8]) -> i32 with Mut, Div {
    (*m)[0] = 80.78
    (*s)[0] = 80.78 * 0.071 / 1.085
    (*n)[0] = 4.0
    (*m)[1] = 86.1
    (*s)[1] = 8.9
    (*n)[1] = 11.0
    (*m)[2] = 6.4 * 1000.0 / 60.0
    (*s)[2] = 1.0 * 1000.0 / 60.0
    (*n)[2] = 6.0
    (*m)[3] = 94.5
    (*s)[3] = 15.9
    (*n)[3] = 10.0
    (*m)[4] = 131.0
    (*s)[4] = 21.0
    (*n)[4] = 9.0
    (*m)[5] = 5.72 * 1000.0 / 60.0
    (*s)[5] = 0.05 * 5.72 * 1000.0 / 60.0 * cd_sqrt(8.0)
    (*n)[5] = 8.0
    return 6
}

// (c) terminal half-life, h, healthy adults with normal renal function (same class as (a), (b)):
//   0 Blouin 1982: 4.8 h (beta 0.146 +/- 0.012 /h), n 4, tri-exponential, 24 h; SD 0.39 DERIVED
//   1 Healy 1987: 7.7 +/- 1.8, n 11, three-compartment, 36 h
//   2 Davis 1987: 6.6 +/- 1.5, n 6, log-linear 6-24 h
//   3 Boeckh 1988: 269 +/- 49.8 min = 4.483 +/- 0.830 h, n 10, two-compartment, 24 h (0.5 g arm)
//   4 Lagast 1986 JAC 18:513 (PMID 2945811, abstract): 5.8 +/- 1.8, 6 male volunteers, 1 g over 50 min,
//     two-compartment
//   5 Cutler 1984 CPT 36:803 (PMID 6499360, abstract): 7.2 h, 6 young healthy men, 6 mg/kg, three-
//     compartment, 48 h; no SD in the abstract
//   6 Krogstad 1980 (PMID 7381031): mean 7.88 h (quoted by Blouin 1982; the abstract gives the range
//     4.7-11.2 h), n 4, three-compartment; no SD
// REMOVED from the round-2 pool: Matzke 1984 group I 9.1 +/- 2.8 h (patients aged 46.5 +/- 16.6 y,
//   mono-exponential on 3.4 samples from 3 h after the infusion) and Rotschafer 1982 6 h (21 of 28 with
//   severe burns): not the population class of (a) and (b). The elderly of Cutler 1984 (12.1 h) are
//   a different class as well.
pub fn va_tab_t12(m: &![f64; 8], s: &![f64; 8], n: &![f64; 8]) -> i32 with Mut, Div {
    (*m)[0] = 4.8
    (*s)[0] = 4.8 * 0.012 / 0.146
    (*n)[0] = 4.0
    (*m)[1] = 7.7
    (*s)[1] = 1.8
    (*n)[1] = 11.0
    (*m)[2] = 6.6
    (*s)[2] = 1.5
    (*n)[2] = 6.0
    (*m)[3] = 269.0 / 60.0
    (*s)[3] = 49.8 / 60.0
    (*n)[3] = 10.0
    (*m)[4] = 5.8
    (*s)[4] = 1.8
    (*n)[4] = 6.0
    (*m)[5] = 7.2
    (*s)[5] = 0.0
    (*n)[5] = 6.0
    (*m)[6] = 7.88
    (*s)[6] = 0.0
    (*n)[6] = 4.0
    return 7
}

// (d) renal fraction of the systemic clearance, healthy adults:
//   0 Davis 1987: 856 +/- 116 mg of 1000 mg recovered unchanged in urine in 24 h: 0.856 +/- 0.116, n 6
//     (a 24-h recovery; a lower bound of the fraction at infinite time)
//   1 Boeckh 1988: 81.2 +/- 10.1 % in 48 h (0.5 g), n 10 (CL_R/CL of the same arm 76.4/94.5 = 0.808;
//     1 g arm 77.1 +/- 12.4 %)
//   2 Golper 1988: renal 89 / systemic 131 = 0.679, n 9 (ratio of means; no SD)
// NOT pooled: label "about 75 % in 24 h" and 0.048/0.058 = 0.83 (no n, population not stated); Matzke
//   1986 review "> 80 %"; Rodvold 1988 patients, group 1 88.0/98.4 = 0.89 (CL_R 85 % of CL overall).
pub fn va_tab_fe(m: &![f64; 8], s: &![f64; 8], n: &![f64; 8]) -> i32 with Mut, Div {
    (*m)[0] = 0.856
    (*s)[0] = 0.116
    (*n)[0] = 6.0
    (*m)[1] = 0.812
    (*s)[1] = 0.101
    (*n)[1] = 10.0
    (*m)[2] = 89.0 / 131.0
    (*s)[2] = 0.0
    (*n)[2] = 9.0
    return 3
}

// Creatinine clearance of the studies in the clearance pool (mL/min, as reported: Blouin 138 +/- 28;
// Healy 110 +/- 19.3 per 1.73 m2; Boeckh 92.7 per 1.73 m2; Golper 117 +/- 9 SE; Smit median 117.9 24-h;
// Davis not given): used only as the reference of the CL-versus-CLcr rows.
pub fn va_tab_clcr(m: &![f64; 8], s: &![f64; 8], n: &![f64; 8]) -> i32 with Mut, Div {
    (*m)[0] = 138.0
    (*s)[0] = 28.0
    (*n)[0] = 4.0
    (*m)[1] = 110.0
    (*s)[1] = 19.3
    (*n)[1] = 11.0
    (*m)[2] = 92.7
    (*s)[2] = 0.0
    (*n)[2] = 10.0
    (*m)[3] = 117.0
    (*s)[3] = 27.0
    (*n)[3] = 9.0
    (*m)[4] = 117.9
    (*s)[4] = 0.0
    (*n)[4] = 8.0
    return 5
}

// which: 0 V_ss (L/kg), 1 CL (mL/min), 2 terminal t1/2 (h), 3 renal fraction, 4 CLcr (mL/min)
pub fn va_pool_of(which: i32, out: &![f64; 8]) with Mut, Div {
    var m: [f64; 8] = [0.0; 8]
    var s: [f64; 8] = [0.0; 8]
    var n: [f64; 8] = [0.0; 8]
    var k: i32 = 0
    if which == 0 { k = va_tab_vss(&!m, &!s, &!n) }
    if which == 1 { k = va_tab_cl(&!m, &!s, &!n) }
    if which == 2 { k = va_tab_t12(&!m, &!s, &!n) }
    if which == 3 { k = va_tab_fe(&!m, &!s, &!n) }
    if which == 4 { k = va_tab_clcr(&!m, &!s, &!n) }
    va_pool(&m, &s, &n, k, out)
}
pub fn va_pool_mean(which: i32) -> f64 with Mut, Div {
    var o: [f64; 8] = [0.0; 8]
    va_pool_of(which, &!o)
    return o[0]
}
pub fn va_pool_u(which: i32) -> f64 with Mut, Div {
    var o: [f64; 8] = [0.0; 8]
    va_pool_of(which, &!o)
    return o[6]
}

// Reference body weight of circ28_physiology (ICRP 89 male): the pooled V_ss in L/kg is SCALED to it.
pub fn va_bw() -> f64 { return 73.0 }
// pooled total clearance and renal fraction, and the split used by the model:
//   cl_renal = fe x CL_total (acts on arterial plasma in the kidney),
//   unidentified remainder = (1 - fe) x CL_total (first-order loss from venous plasma, no mechanism).
pub fn va_cl_tot_mlmin() -> f64 with Mut, Div { return va_pool_mean(1) }
pub fn va_u_cl_tot_mlmin() -> f64 with Mut, Div { return va_pool_u(1) }
pub fn va_fe() -> f64 with Mut, Div { return va_pool_mean(3) }
pub fn va_u_fe() -> f64 with Mut, Div { return va_pool_u(3) }
pub fn va_cl_ren_mlmin() -> f64 with Mut, Div { return va_fe() * va_cl_tot_mlmin() }
pub fn va_cl_nr_mlmin() -> f64 with Mut, Div { return (1.0 - va_fe()) * va_cl_tot_mlmin() }
// u of each part (for the record only; the budget perturbs CL_total and fe, which are independent)
pub fn va_u_cl_ren_mlmin() -> f64 with Mut, Div {
    let a = va_fe() * va_u_cl_tot_mlmin()
    let b = va_cl_tot_mlmin() * va_u_fe()
    return cd_sqrt(a * a + b * b)
}
pub fn va_u_cl_nr_mlmin() -> f64 with Mut, Div {
    let a = (1.0 - va_fe()) * va_u_cl_tot_mlmin()
    let b = va_cl_tot_mlmin() * va_u_fe()
    return cd_sqrt(a * a + b * b)
}
pub fn va_clcr_ref() -> f64 with Mut, Div { return va_pool_mean(4) }
// Rounds 1-3 values, kept for the record (single-source V_ss of Matzke 1984, Golper renal + remainder)
pub fn va_vss_round3() -> f64 { return 0.81 * 73.0 }
pub fn va_cl_ren_round3() -> f64 { return 89.0 }
pub fn va_cl_nr_round3() -> f64 { return 0.5 * (10.4 + 0.010 * 73.0 * 1000.0 / 60.0) }

// Observables of the fits (ROUND 4: pooled)
pub fn va_obs_vss() -> f64 with Mut, Div { return va_pool_mean(0) * va_bw() }
pub fn va_u_vss() -> f64 with Mut, Div { return va_pool_u(0) * va_bw() }
pub fn va_obs_v1() -> f64 { return 0.15 * 73.0 }
pub fn va_u_v1() -> f64 { return 0.03 * 73.0 }
pub fn va_obs_t12() -> f64 with Mut, Div { return va_pool_mean(2) }
pub fn va_u_t12() -> f64 with Mut, Div { return va_pool_u(2) }
// Round-2/3 half-life pool (Healy, Krogstad midpoint, Matzke group I, Rotschafer), kept for the record
pub fn va_t12_round3() -> f64 { return 0.25 * (7.7 + 0.5 * (4.7 + 11.2) + 9.1 + 6.0) }
// Round 1 stored value, kept for the record
pub fn va_pssc_round1() -> f64 { return 0.000615328637699 }
// Distribution-phase observables (validation): Rotschafer 1982 alpha half-life 0.5 +/- 0.3 h,
// central volume 9.0 +/- 4.0 L
pub fn va_val_alpha() -> f64 { return 0.5 }
pub fn va_val_alpha_sd() -> f64 { return 0.3 }
pub fn va_val_v1_rot() -> f64 { return 9.0 }
pub fn va_val_v1_rot_sd() -> f64 { return 4.0 }

// Peeling windows (fixed a priori): terminal 12-48 h, residual 0.25-3 h
pub fn va_w_tlo() -> f64 { return 12.0 }
pub fn va_w_thi() -> f64 { return 48.0 }
pub fn va_w_alo() -> f64 { return 0.25 }
pub fn va_w_ahi() -> f64 { return 3.0 }

// Stored result of the offline bisection (re-checked by the test)
// Round 2 value (single well-mixed tissue space), kept for the record
pub fn va_pssc_round2() -> f64 { return 0.033943124420225 }
// Round 3 (fast + deep space, V_ss 59.13 L, CL 100.3 mL/min, t1/2 7.6875 h), kept for the record
pub fn va_pssc_round3() -> f64 { return 0.02515336218953 }
// ROUND 4 (pooled V_ss, CL, t1/2): offline bisection on the pooled terminal half-life
pub fn va_pssc_fit() -> f64 { return 0.005002605488776 }

// ---- the interstitial pattern ------------------------------------------------
// int/(1 - vas) of physiology_primary.md s4, organs in circ28 order 1..13
pub fn va_int_share(i: i32) -> f64 {
    if i == 1 { return 0.196 }
    if i == 2 { return 0.260 }
    if i == 3 { return 0.004 }
    if i == 4 { return 0.116 }
    if i == 5 { return 0.448 }
    if i == 6 { return 0.164 }
    if i == 7 { return 0.163 }
    if i == 8 { return 0.098 }
    if i == 9 { return 0.317 }
    if i == 10 { return 0.104 }
    if i == 11 { return 0.224 }
    if i == 12 { return 0.150 }
    return 0.164
}

// ---- ROUND 3: fast (vascular + interstitial) space and deep space ----------------------------
// Unbound fraction and whole-body interstitial:plasma albumin ratio used ONLY for r.
pub fn va_fu_bind() -> f64 { return 0.70 }
pub fn va_k_alb() -> f64 { return 0.28 }
// r: interstitial:plasma total concentration ratio at equilibrium, r = fu + (1 - fu) K
pub fn va_r_int() -> f64 { return va_fu_bind() + (1.0 - va_fu_bind()) * va_k_alb() }
pub fn va_u_r() -> f64 { return 0.12 }
// Scale of the interstitial volumes (1 = the PK-Sim-derived pattern). u: the pattern sums to
// about 10 L, a human primary analysis (Levitt 2003) gives about 14 L: range/sqrt(12) relative
// to the pattern, computed by va_u_isc from the pattern's own sum.
pub fn va_isc_nom() -> f64 { return 1.0 }
pub fn va_levitt_ecf() -> f64 { return 17.45 }
pub fn va_plasma_water() -> f64 { return 5.3 * 0.55 }
// interstitial fraction of the whole organ volume: share x (1 - vas), vas = kernel vf (ICRP)
pub fn va_int_frac(i: i32, vas: f64) -> f64 { return va_int_share(i) * (1.0 - vas) }
// sum of v_i int_i (L) on the circ28 reference volumes
pub fn va_int_volume() -> f64 with Mut, Div {
    let p = circ28_physiology()
    var s = 0.0
    var i: i32 = 1
    while i < 14 {
        s = s + p.v[i] * va_int_frac(i, p.vf[i])
        i = i + 1
    }
    return s
}
pub fn va_u_isc() -> f64 with Mut, Div {
    let vi = va_int_volume()
    let hi = (va_levitt_ecf() - va_plasma_water()) / vi
    return (hi - 1.0) / 3.4641016151377544
}

// Applies the round-3 reinterpretation to p (bp, ps and clearances already set): vf_i becomes
// vas_i + isc int_i r / bp and kp_i = kd int_i isc / (1 - vf_i), so that the deep capacity is
// kd x isc x v_i int_i. pat receives int_i isc / (1 - vf_i) (the pattern kd multiplies).
pub fn va_apply3(p: &!Circ28Params, kd: f64, r: f64, isc: f64, pat: &![f64; 14]) with Mut, Div {
    var i: i32 = 1
    while i < 14 {
        let vas = (*p).vf[i]
        let fi = isc * va_int_frac(i, vas)
        let vfe = vas + fi * r / (*p).bp
        (*p).vf[i] = vfe
        (*pat)[i] = fi / (1.0 - vfe)
        (*p).kp[i] = kd * fi / (1.0 - vfe)
        i = i + 1
    }
}

pub fn va_params3(th: &[f64; 18], r: f64, isc: f64) -> Circ28Params with Mut, Div, Panic {
    var t2: [f64; 18] = [0.0; 18]
    var k: i32 = 0
    while k < 18 {
        t2[k] = (*th)[k]
        k = k + 1
    }
    var p = circ28_drug_params_theta(t2)
    var pat: [f64; 14] = [0.0; 14]
    va_apply3(&!p, (*th)[CD_KPSC], r, isc, &!pat)
    return p
}

pub fn va_params(th: &[f64; 18]) -> Circ28Params with Mut, Div, Panic {
    return va_params3(th, va_r_int(), va_isc_nom())
}

// plasma-referred volume of the fast space (L): bp x (pools + sum v_i vf'_i)
pub fn va_fast_volume(bp: f64, r: f64, isc: f64) -> f64 with Mut, Div {
    var p = circ28_physiology()
    p.bp = bp
    var pat: [f64; 14] = [0.0; 14]
    va_apply3(&!p, 1.0, r, isc, &!pat)
    return bp * circ28_blood_volume(p)
}

// kd in closed form: (V_ss - fast volume) / sum v_i int_i isc
pub fn va_kpsc_for3(bp: f64, vss: f64, r: f64, isc: f64) -> f64 with Mut, Div, Panic {
    var p = circ28_physiology()
    p.bp = bp
    var pat: [f64; 14] = [0.0; 14]
    va_apply3(&!p, 1.0, r, isc, &!pat)
    return circ28_kp_scale_for_vss(p, pat, vss)
}

pub fn va_kpsc_for(bp: f64, vss: f64) -> f64 with Mut, Div, Panic {
    return va_kpsc_for3(bp, vss, va_r_int(), va_isc_nom())
}

// ---- profiles ---------------------------------------------------------------------
// One infusion of `dose` mg over t_inf h (t_inf a multiple of 0.05 h, <= 3 h) into a fresh body,
// on the grid of the lithium module (0.05 h to 3 h, 0.25 h to 312 h). cs[k] = venous plasma
// concentration (mg/L). Returns the plasma AUC 0..312 h; *tail receives c(312 h).
pub fn va_profile(p: Circ28Params, dose: f64, t_inf: f64, cs: &![f64; 1300], tail: &![f64; 2]) -> f64 with Mut, Div, Panic {
    var sys = circ28_sys_zero()
    var s = circ28_state_zero()
    var el = circ28_elim_zero()
    var k: i32 = 0
    var ph: i32 = 0
    var t = 0.0
    (*cs)[0] = 0.0
    while ph < 2 {
        var dt = 0.05
        var n: i32 = 60
        if ph == 1 {
            dt = 0.25
            n = 1236
        }
        circ28_prepare(p, dt, &!sys)
        var j: i32 = 0
        while j < n {
            let iv = circ28_iv_mass(dose, t_inf, t, t + dt) / dt
            circ28_step(&!s, p, &sys, iv, 0.0, &!el)
            t = t + dt
            k = k + 1
            (*cs)[k] = s.x[0] / p.bp
            j = j + 1
        }
        ph = ph + 1
    }
    (*tail)[0] = (*cs)[1296]
    (*tail)[1] = s.x[3]
    return el.auc_ven / p.bp
}

// Peeled parameters for th (1 mg bolus over 0.05 h): out[0] intermediate half-life (h) of the
// residual, out[1] central volume V1 = dose/(A + B) (L), out[2] terminal half-life (h), out[3] V_area.
pub fn va_peeled(th: &[f64; 18], out: &![f64; 4]) with Mut, Div, Panic {
    let p = va_params(th)
    va_peeled_p(p, out)
}

// Diagnostic two-class split (round 2): fenestrated/sinusoidal organs (liver 1, kidney 2, lung 5,
// gut 8, spleen 11, pancreas 12) get ps scalar pf, the others (brain 3, heart 4, muscle 6, adipose 7,
// skin 9, bone 10, rest 13: continuous capillary, judgment for heart and rest) keep th[CD_PSSC].
pub fn va_is_fen(i: i32) -> bool {
    return i == 1 || i == 2 || i == 5 || i == 8 || i == 11 || i == 12
}
pub fn va_params_split(th: &[f64; 18], pf: f64) -> Circ28Params with Mut, Div, Panic {
    var p = va_params(th)
    var i: i32 = 1
    while i < 14 {
        if va_is_fen(i) {
            p.ps[i] = p.ps[i] * pf / (*th)[CD_PSSC]
        }
        i = i + 1
    }
    return p
}
pub fn va_peeled_split(th: &[f64; 18], pf: f64, out: &![f64; 4]) with Mut, Div, Panic {
    let p = va_params_split(th, pf)
    va_peeled_p(p, out)
}

pub fn va_peeled_p(p: Circ28Params, out: &![f64; 4]) with Mut, Div, Panic {
    var cs: [f64; 1300] = [0.0; 1300]
    var tail: [f64; 2] = [0.0; 2]
    let a = va_profile(p, 1.0, 0.05, &!cs, &!tail)
    var pe: [f64; 4] = [0.0; 4]
    li_peel(&cs, va_w_tlo(), va_w_thi(), va_w_alo(), va_w_ahi(), &!pe)
    (*out)[0] = 0.6931471805599453 / pe[2]
    (*out)[1] = 1.0 / (pe[1] + pe[3])
    (*out)[2] = 0.6931471805599453 / pe[0]
    (*out)[3] = 1.0 / (pe[0] * (pe[3] / pe[2] + pe[1] / pe[0]))
}

// ---- record fill -----------------------------------------------------------------------
pub fn va_measured_record(d: &!Circ28Drug) with Mut, Div, Panic, Epistemic {
    circ28_drug_set(d, CD_MW, va_mw(), 0.0, CD_STATUS_MEASURED, "owner: MW 1449")
    circ28_drug_set(d, CD_FU, 0.7, 0.0, CD_STATUS_UNUSED, "owner decision fu 0.7; Rodvold1988 30 % bound; unused (Kp and clearances bypass fu)")
    circ28_drug_set(d, CD_BP, va_bp(), va_u_bp(), CD_STATUS_DERIVED, "bp = 1 - Hct 0.45; UNSOURCED assumption (no blood:plasma found); u judgment")
    circ28_drug_set(d, CD_CLREN, va_cl_ren_mlmin() * 0.06, va_u_cl_ren_mlmin() * 0.06, CD_STATUS_DERIVED, "ROUND 4: renal fraction (pooled: Davis1987, Boeckh1988, Golper1988) x pooled systemic CL (Blouin1982, Healy1987, Davis1987, Boeckh1988, Golper1988, Smit2020)")
    circ28_drug_set(d, CD_CLPLA, va_cl_nr_mlmin() * 0.06, va_u_cl_nr_mlmin() * 0.06, CD_STATUS_DERIVED, "ROUND 4: unidentified non-renal plasma CL = (1 - pooled renal fraction) x pooled systemic CL; no mechanism claimed")
}

pub fn va_fit_kpsc_record(d: &!Circ28Drug) with Mut, Div, Panic, Epistemic {
    let bp = circ28_drug_value(d, CD_BP)
    let u_bp = cd_sqrt(circ28_drug_variance(d, CD_BP))
    let vss = va_obs_vss()
    let r = va_r_int()
    let k0 = va_kpsc_for3(bp, vss, r, 1.0)
    let hb = 1.0e-3 * bp
    let hv = 1.0e-4 * vss
    let hr = 1.0e-3 * r
    let hs = 1.0e-3
    let dk_dbp = (va_kpsc_for3(bp + hb, vss, r, 1.0) - va_kpsc_for3(bp - hb, vss, r, 1.0)) / (2.0 * hb)
    let dk_dv = (va_kpsc_for3(bp, vss + hv, r, 1.0) - va_kpsc_for3(bp, vss - hv, r, 1.0)) / (2.0 * hv)
    let dk_dr = (va_kpsc_for3(bp, vss, r + hr, 1.0) - va_kpsc_for3(bp, vss, r - hr, 1.0)) / (2.0 * hr)
    let dk_ds = (va_kpsc_for3(bp, vss, r, 1.0 + hs) - va_kpsc_for3(bp, vss, r, 1.0 - hs)) / (2.0 * hs)
    let u = cd_sqrt(dk_dbp * dk_dbp * u_bp * u_bp + dk_dv * dk_dv * va_u_vss() * va_u_vss() + dk_dr * dk_dr * va_u_r() * va_u_r() + dk_ds * dk_ds * va_u_isc() * va_u_isc())
    circ28_drug_set(d, CD_KPSC, k0, u, CD_STATUS_FITTED, "ROUND 4 deep-space scalar kd: fitted to the POOLED Vss (Blouin1982, Healy1987, Smit2020; L/kg x 73 kg) after the fast space bp x blood + r x interstitium; u from u(Vss), u(bp), u(r), u(interstitial scale)")
}

pub fn va_v1_at(d: &Circ28Drug, pssc: f64) -> f64 with Mut, Div, Panic, Epistemic {
    var th: [f64; 18] = [0.0; 18]
    var i: i32 = 0
    while i < 18 {
        th[i] = circ28_drug_value(d, i)
        i = i + 1
    }
    th[CD_PSSC] = pssc
    var o: [f64; 4] = [0.0; 4]
    va_peeled(&th, &!o)
    return o[1]
}

// terminal half-life (h) of the model at a given pssc (IV bolus, peeled)
pub fn va_t12_at(d: &Circ28Drug, pssc: f64) -> f64 with Mut, Div, Panic, Epistemic {
    var th: [f64; 18] = [0.0; 18]
    var i: i32 = 0
    while i < 18 {
        th[i] = circ28_drug_value(d, i)
        i = i + 1
    }
    th[CD_PSSC] = pssc
    var o: [f64; 4] = [0.0; 4]
    va_peeled(&th, &!o)
    return o[2]
}

pub fn va_pssc_record(d: &!Circ28Drug) with Mut, Div, Panic, Epistemic {
    let x = va_pssc_fit()
    let h = 1.0e-2 * x
    let slope = (va_t12_at(d, x + h) - va_t12_at(d, x - h)) / (2.0 * h)
    var sa = slope
    if sa < 0.0 { sa = 0.0 - sa }
    circ28_drug_set(d, CD_PSSC, x, va_u_t12() / sa, CD_STATUS_FITTED, "ROUND 4 refit to the pooled healthy-adult terminal half-life (Blouin1982, Healy1987, Davis1987, Boeckh1988, Lagast1986, Cutler1984 young, Krogstad1980); u from u(t1/2)/|dt1/2/dpssc|")
}

pub fn va_drug_into(d: &!Circ28Drug) with Mut, Div, Panic, Epistemic {
    va_measured_record(d)
    va_fit_kpsc_record(d)
    va_pssc_record(d)
}

// ---- uncertainty budget with refit ------------------------------------------------------
// Seven inputs (ROUND 4): 0 bp, 1 pooled systemic CL (mL/min), 2 pooled renal fraction, 3 V_ss obs (L), 4 terminal t1/2 obs (h),
// 5 r (interstitial:plasma ratio), 6 interstitial volume scale. Each evaluation rebuilds the parameters,
// refits kd in closed form and pssc by ONE chord correction on the terminal half-life (round 4: the steps are 0.01 u, so one chord is exact to first order; rounds 2-3 used two) (slope taken once
// at the nominal values), then runs 1000 mg over 1 h. Outputs: out[0] AUC_inf (mg h/L), out[1] steady-
// state trough of 1 g over 1 h q12h (mg/L).
pub fn va_u_inputs(u: &![f64; 7]) with Mut, Div {
    (*u)[0] = va_u_bp()
    (*u)[1] = va_u_cl_tot_mlmin()
    (*u)[2] = va_u_fe()
    (*u)[3] = va_u_vss()
    (*u)[4] = va_u_t12()
    (*u)[5] = va_u_r()
    (*u)[6] = va_u_isc()
}
pub fn va_z_nominal(z: &![f64; 7]) with Mut, Div {
    (*z)[0] = va_bp()
    (*z)[1] = va_cl_tot_mlmin()
    (*z)[2] = va_fe()
    (*z)[3] = va_obs_vss()
    (*z)[4] = va_obs_t12()
    (*z)[5] = va_r_int()
    (*z)[6] = va_isc_nom()
}

// Peel at given r and interstitial scale (kept in its own frame: lean_single gave a different budget
// when the parameter structs of the two chord steps lived in va_eval's frame).
pub fn va_peeled3(th: &[f64; 18], r: f64, isc: f64, out: &![f64; 4]) with Mut, Div, Panic {
    let p = va_params3(th, r, isc)
    va_peeled_p(p, out)
}

// Final run of an evaluation in its own frame: out[0] AUC_inf, out[1] steady-state trough.
pub fn va_run3(th: &[f64; 18], r: f64, isc: f64, out: &![f64; 2]) with Mut, Div, Panic {
    let p = va_params3(th, r, isc)
    var cs: [f64; 1300] = [0.0; 1300]
    var tail: [f64; 2] = [0.0; 2]
    let a = va_profile(p, 1000.0, 1.0, &!cs, &!tail)
    var pe: [f64; 4] = [0.0; 4]
    li_peel(&cs, va_w_tlo(), va_w_thi(), va_w_alo(), va_w_ahi(), &!pe)
    (*out)[0] = a + cs[1296] / pe[0]
    var ss: [f64; 5] = [0.0; 5]
    li_ss_from(&cs, 1.0, 12.0, &!ss)
    (*out)[1] = ss[0]
}

pub fn va_eval(z: &[f64; 7], th0: &[f64; 18], slope_v1: f64, out: &![f64; 2]) with Mut, Div, Panic {
    var t: [f64; 18] = [0.0; 18]
    var k: i32 = 0
    while k < 18 {
        t[k] = (*th0)[k]
        k = k + 1
    }
    let r = (*z)[5]
    let isc = (*z)[6]
    t[CD_BP] = (*z)[0]
    t[CD_CLREN] = (*z)[1] * (*z)[2] * 0.06
    t[CD_CLPLA] = (*z)[1] * (1.0 - (*z)[2]) * 0.06
    t[CD_KPSC] = va_kpsc_for3(t[CD_BP], (*z)[3], r, isc)
    var o: [f64; 4] = [0.0; 4]
    va_peeled3(&t, r, isc, &!o)
    t[CD_PSSC] = t[CD_PSSC] + ((*z)[4] - o[2]) / slope_v1
    va_run3(&t, r, isc, out)
}

// b: [0] AUC0, [1] trough0, [2..8] variance contributions to AUC, [9..15] to trough,
// [16..22] AUC sensitivities, [23..29] trough sensitivities, [30..36] u_i, [37] var_AUC, [38] var_trough
pub fn va_budget(th0: &[f64; 18], slope_v1: f64, b: &![f64; 40]) with Mut, Div, Panic {
    var z0: [f64; 7] = [0.0; 7]
    va_z_nominal(&!z0)
    var u: [f64; 7] = [0.0; 7]
    va_u_inputs(&!u)
    var o0: [f64; 2] = [0.0; 2]
    va_eval(&z0, th0, slope_v1, &!o0)
    (*b)[0] = o0[0]
    (*b)[1] = o0[1]
    var va = 0.0
    var vt = 0.0
    var i: i32 = 0
    while i < 7 {
        var zp: [f64; 7] = [0.0; 7]
        var zm: [f64; 7] = [0.0; 7]
        var j: i32 = 0
        while j < 7 {
            zp[j] = z0[j]
            zm[j] = z0[j]
            j = j + 1
        }
        let h = 0.01 * u[i] + 1.0e-9
        zp[i] = z0[i] + h
        zm[i] = z0[i] - h
        var op: [f64; 2] = [0.0; 2]
        var om: [f64; 2] = [0.0; 2]
        va_eval(&zp, th0, slope_v1, &!op)
        va_eval(&zm, th0, slope_v1, &!om)
        let sa = (op[0] - om[0]) / (2.0 * h)
        let st = (op[1] - om[1]) / (2.0 * h)
        (*b)[16 + i] = sa
        (*b)[23 + i] = st
        (*b)[30 + i] = u[i]
        (*b)[2 + i] = sa * sa * u[i] * u[i]
        (*b)[9 + i] = st * st * u[i] * u[i]
        va = va + sa * sa * u[i] * u[i]
        vt = vt + st * st * u[i] * u[i]
        i = i + 1
    }
    (*b)[37] = va
    (*b)[38] = vt
}

// ---- pi phase (round 3) ---------------------------------------------------------------------
// Fine-grid bolus: 1 mg over 0.01 h, dt 0.01 h, 50 steps. fine[k] = venous plasma concentration at
// 0.01 k h. Then the SECOND residual c - B exp(-lz t) - A exp(-alpha t) (pe from li_peel of the coarse
// bolus profile) is fitted log-linearly on [0.03, 0.15] h (window fixed a priori). out[0] pi half-life
// (h), out[1] intercept P (1/L), out[2] number of positive residual points used.
pub fn va_pi_phase(p: Circ28Params, pe: &[f64; 4], out: &![f64; 3]) with Mut, Div, Panic {
    var sys = circ28_sys_zero()
    var s = circ28_state_zero()
    var el = circ28_elim_zero()
    circ28_prepare(p, 0.01, &!sys)
    var sw = 0.0
    var st = 0.0
    var sy = 0.0
    var stt = 0.0
    var sty = 0.0
    var j: i32 = 1
    while j <= 50 {
        var iv = 0.0
        if j == 1 { iv = 100.0 }
        circ28_step(&!s, p, &sys, iv, 0.0, &!el)
        let t = 0.01 * (j as f64)
        let c = s.x[0] / p.bp
        if j >= 3 && j <= 15 {
            let r = c - (*pe)[1] * exp(0.0 - (*pe)[0] * t) - (*pe)[3] * exp(0.0 - (*pe)[2] * t)
            if r > 0.0 {
                let y = ln(r)
                sw = sw + 1.0
                st = st + t
                sy = sy + y
                stt = stt + t * t
                sty = sty + t * y
            }
        }
        j = j + 1
    }
    (*out)[2] = sw
    if sw < 3.0 {
        (*out)[0] = 0.0
        (*out)[1] = 0.0
        return
    }
    let den = sw * stt - st * st
    let slope = (sw * sty - st * sy) / den
    let icpt = (sy - slope * st) / sw
    (*out)[0] = 0.6931471805599453 / (0.0 - slope)
    (*out)[1] = exp(icpt)
}

// Bolus peel plus pi phase in one callee. KNOWN ENGINE DIVERGENCE, unresolved: lean_single returns A 0.00896,
// B 0.01328, pi 0.0715 h here against 0.00930, 0.01321, 0.0747 h on both Madaros builds (whose A + B agrees
// with va_peeled; lean_single does not agree with its own va_peeled). Moving the frame, copying the peel
// array and rebuilding the parameters did not change it. pe: li_peel output of the
// coarse bolus (1 mg over 0.05 h); o: va_pi_phase output.
pub fn va_pi_of(th: &[f64; 18], pe: &![f64; 4], o: &![f64; 3]) with Mut, Div, Panic {
    let p = va_params(th)
    var cs: [f64; 1300] = [0.0; 1300]
    var tail: [f64; 2] = [0.0; 2]
    let a = va_profile(p, 1.0, 0.05, &!cs, &!tail)
    var pl: [f64; 4] = [0.0; 4]
    li_peel(&cs, va_w_tlo(), va_w_thi(), va_w_alo(), va_w_ahi(), &!pl)
    (*pe)[0] = pl[0]
    (*pe)[1] = pl[1]
    (*pe)[2] = pl[2]
    (*pe)[3] = pl[3]
    va_pi_phase(p, &pl, o)
}
