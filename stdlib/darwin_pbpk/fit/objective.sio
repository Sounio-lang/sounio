// darwin_pbpk/fit/objective.sio — objective summary for TAC calibration

use darwin_pbpk::brain_plasma_tac::*
use darwin_pbpk::fit::problem::*
use darwin_pbpk::fit::residuals::{CalibrationResidualTable, calibration_residuals}

pub struct CalibrationObjective {
    n_points: i32,
    sse: f64,
    chi2: f64,
    rmse: f64,
    mean_abs_weighted_residual: f64,
    success: bool,
}

fn obj_sqrt(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i: i32 = 0
    while i < 12 {
        y = 0.5 * (y + x / y)
        i = i + 1
    }
    y
}

fn obj_abs(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

pub fn calibration_objective_from_residuals(
    residuals: CalibrationResidualTable
) -> CalibrationObjective with Mut, Div, Panic {
    if residuals.success == false || residuals.overflowed {
        return CalibrationObjective {
            n_points: 0,
            sse: 0.0,
            chi2: 0.0,
            rmse: 0.0,
            mean_abs_weighted_residual: 0.0,
            success: false,
        }
    }

    var sse = 0.0
    var chi2 = 0.0
    var abs_weighted = 0.0
    var i: usize = 0
    while i < residuals.count {
        let residual = residuals.residuals[i]
        let weighted = residuals.weighted_residuals[i]
        sse = sse + residual * residual
        chi2 = chi2 + weighted * weighted
        abs_weighted = abs_weighted + obj_abs(weighted)
        i = i + 1
    }

    let n = residuals.count as i32
    let n_f = n as f64
    let rmse = if n > 0 { obj_sqrt(sse / n_f) } else { 0.0 }
    let mean_abs_weighted = if n > 0 { abs_weighted / n_f } else { 0.0 }

    CalibrationObjective {
        n_points: n,
        sse: sse,
        chi2: chi2,
        rmse: rmse,
        mean_abs_weighted_residual: mean_abs_weighted,
        success: true,
    }
}

pub fn calibration_objective(
    problem: CalibrationProblem,
    tac: BrainPlasmaTacTable
) -> CalibrationObjective with Mut, Div, Panic {
    let residuals = calibration_residuals(problem, tac)
    calibration_objective_from_residuals(residuals)
}
