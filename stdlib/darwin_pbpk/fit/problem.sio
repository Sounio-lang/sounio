// darwin_pbpk/fit/problem.sio — calibration problem definition

use darwin_pbpk::schema::observation::*

pub struct CalibrationProblem {
    observations: NormalizedObservationTable,
    simulation_condition_id: string,
}

pub fn calibration_problem_new(
    observations: NormalizedObservationTable,
    simulation_condition_id: string
) -> CalibrationProblem {
    CalibrationProblem {
        observations: observations,
        simulation_condition_id: simulation_condition_id,
    }
}
