// stdlib/darwin_pbpk/tsit5_pbpk28.sio — PBPK28 fully-coupled Crank-Nicolson step
//
// One A-stable, 2nd-order, fully-coupled implicit step on the 27-active-state
// arrow matrix (blood C_v[0] + 13 × (C_v_i, C_t_i)). Per-organ Schur
// complement, O(N) per step, no operator-splitting bias.
//
// The structure of the matrix:
//   - Blood (organ 0) couples to all 13 peripheral C_v through Q-transport.
//   - Each peripheral organ has a 2×2 block (C_v_i, C_t_i) coupled to blood
//     through Q_i·C_b and to its own interstitium through PS_i·Kp_i.
//   - All blocks are eliminated against the central blood-row in closed form;
//     a single scalar equation for C_b_new closes the step.
//
// Derivation (Schur complement):
//   For each peripheral organ i ∈ {1..13}, the CN step on (C_v_i, C_t_i)
//   with unknown blood C_b_new (fully coupled via Schur, not a frozen
//   midpoint guess) gives a 2×2 system:
//       [ p  -q ] [Cv_i_new]   [rhs_v + γ·C_b_new]
//       [-r   s ] [Ct_i_new] = [rhs_t            ]
//   where p, q, r, s are the local mass-balance coefficients (functions of
//   Q_i, PS_i, V_v_i, V_t_i, K_p_i, h). Solving for (Cv_i, Ct_i) yields
//       Cv_i = a_v_i + b_v_i · C_b_new
//       Ct_i = a_t_i + b_t_i · C_b_new
//   Substituting into the blood-row equation closes the step:
//       C_b_new = (rhs_0 + Σ_i β_i · a_v_i) / ((1 + S) - Σ_i β_i · b_v_i)
//   where β_i = h·Q_i/V_b and S = h·(ΣQ_i + CL)/V_b.
//
// Math byte-for-byte preserved from the semaglutide parity ref's
// `full_cn_step` (lines 269-343), generalised over `PBPKParams28` so the
// same kernel drives both rapamycin (with rel_mid = 0 in the bolus-IV
// reference case) and semaglutide (rel_mid > 0 under SC depot release).
//
// Stage G-ε-15. gap-report claim `parity_ref_path` (the PBPK14 ref) is
// adjacent to but distinct from this PBPK28 stdlib promotion.

use darwin_pbpk::core::pbpk28_params::*

// Apply Schur coefficients to reconstruct the new PBPK28 state in place.
// Lives in a separate function on purpose: Madaros multimodule native miscompiles
// a second `while` in the same frame as the Schur fill that reads `a_v[i]` with a
// dynamic index (observes zeros; lean_single is fine). Crossing a function
// boundary with `&[f64; 14]` restores correct loads
// (docs/audit/MADAROS_IMPORTED_PBPK28_CN_SIGSEGV_2026-08-16.md).
fn pbpk28_cn_apply_schur(
    state: &!PBPKState28,
    cb_new: f64,
    a_v: &[f64; 14],
    b_v: &[f64; 14],
    a_t: &[f64; 14],
    b_t: &[f64; 14]
) with Mut, Div {
    (*state).cv[0] = if cb_new < 0.0 { 0.0 } else { cb_new }
    var i: i32 = 1
    while i < 14 {
        let cv = (*a_v)[i] + (*b_v)[i] * cb_new
        let ct = (*a_t)[i] + (*b_t)[i] * cb_new
        (*state).cv[i] = if cv < 0.0 { 0.0 } else { cv }
        (*state).ct[i] = if ct < 0.0 { 0.0 } else { ct }
        i = i + 1
    }
}

// One fully-coupled implicit-CN step at midpoint release rate `rel_mid` (mg/h
// — set to 0.0 for bolus-IV scenarios). Writes the new state into `*state`.
// Does not touch TMDD or PD layers — those compose at the scenario level.
//
// Madaros multimodule native workarounds (same audit note):
// 1. Do not return a freshly rebuilt `PBPKState28` from the Schur frame —
//    caller's field load SIGSEGVs. In-place mut + thin by-value wrapper below.
// 2. Do not reconstruct with a second dynamic-index loop over local `a_v`/`b_v`
//    in this same frame — use `pbpk28_cn_apply_schur` instead.
pub fn pbpk28_full_cn_step_mut(state: &!PBPKState28, p: PBPKParams28, rel_mid: f64, dt: f64) with Mut, Div {
    var a_v: [f64; 14] = [0.0; 14]
    var b_v: [f64; 14] = [0.0; 14]
    var a_t: [f64; 14] = [0.0; 14]
    var b_t: [f64; 14] = [0.0; 14]
    let h = 0.5 * dt
    let vb = p.v_ref[0]

    // Big-S = h · (Σ Q + CL) / V_b — diagonal of the blood row.
    var sum_q = 0.0
    var i: i32 = 1
    while i < 14 {
        sum_q = sum_q + p.q[i]
        i = i + 1
    }
    let big_s = h * (sum_q + p.cl_central) / vb

    let cb_old = (*state).cv[0]
    var rhs0 = (1.0 - big_s) * cb_old + dt * rel_mid / vb

    // Per-organ Schur-complement coefficients.
    var sum_beta_a = 0.0
    var sum_beta_b = 0.0

    i = 1
    while i < 14 {
        let vi = p.v_ref[i]
        let vf = p.vasc_frac[i]
        let vv_raw = vi * vf
        let vt_raw = vi * (1.0 - vf)
        // Floor to avoid division by zero in degenerate (vasc_frac=0 or =1)
        // configurations — used by case 2 of the parity gate (PBPK28 → QSS).
        let vv = if vv_raw < 1.0e-30 { 1.0e-30 } else { vv_raw }
        let vt = if vt_raw < 1.0e-30 { 1.0e-30 } else { vt_raw }
        let kp = p.kp[i]
        let ps = p.ps[i]
        let qi = p.q[i]

        let beta  = h * qi / vb
        let gamma = h * qi / vv
        let pp    = 1.0 + h * (qi + ps) / vv
        let qq    = h * ps / (vv * kp)
        let rr    = h * ps / vt
        let sb    = 1.0 + h * ps / (vt * kp)
        let det   = pp * sb - qq * rr

        rhs0 = rhs0 + beta * (*state).cv[i]

        let rhs_v = gamma * cb_old + (1.0 - h * (qi + ps) / vv) * (*state).cv[i] + qq * (*state).ct[i]
        let rhs_t = rr * (*state).cv[i] + (1.0 - h * ps / (vt * kp)) * (*state).ct[i]

        let av = (sb * rhs_v + qq * rhs_t) / det
        let bv = (sb * gamma) / det
        let at = (rr * rhs_v + pp * rhs_t) / det
        let bt = (rr * gamma) / det

        a_v[i] = av
        b_v[i] = bv
        a_t[i] = at
        b_t[i] = bt

        sum_beta_a = sum_beta_a + beta * av
        sum_beta_b = sum_beta_b + beta * bv
        i = i + 1
    }

    // Close the step: scalar equation for C_b_new.
    let cb_new = (rhs0 + sum_beta_a) / ((1.0 + big_s) - sum_beta_b)
    pbpk28_cn_apply_schur(state, cb_new, &a_v, &b_v, &a_t, &b_t)
}

// By-value API preserved for existing callers. Thin: copy → mut → return copy.
// Math identical to the pre-mitigation reconstruct-into-`out` body.
pub fn pbpk28_full_cn_step(state: PBPKState28, p: PBPKParams28, rel_mid: f64, dt: f64)
    -> PBPKState28 with Mut, Div
{
    var st = state
    pbpk28_full_cn_step_mut(&!st, p, rel_mid, dt)
    return st
}

// Convenience: organ-average concentration C_avg,i = (V_v · C_v + V_t · C_t) / V_i
// used by the visual encoding and the parity-gate's case 1 RMSE
// computation. Blood (i=0) is just C_v[0].
pub fn pbpk28_organ_average(s: PBPKState28, p: PBPKParams28, i: i32) -> f64 with Div {
    if i == 0 { return s.cv[0] }
    let vi = p.v_ref[i]
    let vf = p.vasc_frac[i]
    let vv = vi * vf
    let vt = vi * (1.0 - vf)
    return (vv * s.cv[i] + vt * s.ct[i]) / vi
}

// ============================================================================
// PBPK28 ONTOLOGY CONCRETE CALLS (ChEBI + CYP3A4 enzymatic)
// Callers (ep28_rapamycin_params, validations) invoke pbpk28_rapamycin_chebi_id()
// + pbpk28_cyp3a4_enzymatic_process_id() (defined in drugs/rapamycin + epistemic).
// We document and surface the identity pair from the tsit5_pbpk28 kernel module.
// ============================================================================

pub fn pbpk28_ontology_identities() -> (i32, i32) {
    // concrete numeric IDs for chemical (rapamycin) + enzymatic (CYP3A4) -- the
    // pbpk28_*_id() names are called upstream; here we return the pair directly
    // so the kernel module participates in the ontology wiring.
    (9168, 6805)
}

// ============================================================================
// DT-CONVERGENCE HELPER (shared extractor for AUC dt-refinement logic)
// ============================================================================
// Multiple call sites (epistemic_pbpk28, epistemic_pbpk28_hessian, mc cross
// validation, etc.) duplicate the 3-dt + rel_diff + order-ratio test for CN
// (A-stable 2nd-order). This centralises the sim + metric computation here
// using pbpk28_full_cn_step + trapezoidal AUC on blood. Small, pure-extract.

fn p28_abs(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn p28_finite(x: f64) -> bool {
    if x != x { return false }
    return p28_abs(x) < 1.0e12
}

// Blood AUC(0→t_end) via fixed-dt CN integrator. Initial condition puts
// entire dose into central vascular compartment (bolus-IV). Uses rel_mid=0.0.
// (Oral/SC depot support would require caller-managed A_depot + per-step rel;
// simple bolus for now as used in convergence gates.)
fn pbpk28_simulate_blood_auc_dt(dt: f64, prm: PBPKParams28, dose_mg: f64, t_end: f64) -> f64 with Mut, Div, Panic {
    if dt <= 0.0 || t_end <= 0.0 { return 0.0 }
    var st = pbpk28_state_zero()
    st.cv[0] = dose_mg / prm.v_ref[0]

    var t = 0.0
    var auc = 0.0
    var c_prev = st.cv[0]
    var steps: i32 = 0

    while t < t_end {
        if steps > 100000 { return 0.0 }  // guard against runaway
        let dt_use = if t + dt > t_end { t_end - t } else { dt }
        let st_new = pbpk28_full_cn_step(st, prm, 0.0, dt_use)
        let c_new = st_new.cv[0]
        if !p28_finite(c_new) { return 0.0 }
        auc = auc + 0.5 * (c_prev + c_new) * dt_use
        c_prev = c_new
        t = t + dt_use
        st = st_new
        steps = steps + 1
    }
    return auc
}

// Public shared helper. Computes AUC at base_dt and base_dt/2; internally
// also runs at base_dt/4 to obtain the diff-ratio (should be ~4 for order-2).
// Returns (auc_base, auc_half, rel_diff, ratio).
pub fn pbpk28_dt_convergence_auc(base_dt: f64, prm: PBPKParams28, dose_mg: f64, t_end: f64) -> (f64, f64, f64, f64) with Mut, Div, Panic {
    let auc_base  = pbpk28_simulate_blood_auc_dt(base_dt, prm, dose_mg, t_end)
    let dt_half   = base_dt / 2.0
    let auc_half  = pbpk28_simulate_blood_auc_dt(dt_half, prm, dose_mg, t_end)
    let dt_q      = base_dt / 4.0
    let auc_q     = pbpk28_simulate_blood_auc_dt(dt_q, prm, dose_mg, t_end)

    let rel_diff = if auc_base > 1.0e-12 {
        p28_abs(auc_base - auc_half) / auc_base
    } else { 0.0 }
    let diff1 = p28_abs(auc_base - auc_half)
    let diff2 = p28_abs(auc_half - auc_q)
    let ratio = if diff2 > 1.0e-12 { diff1 / diff2 } else { 0.0 }

    (auc_base, auc_half, rel_diff, ratio)
}
