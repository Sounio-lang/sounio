// stdlib/darwin_pbpk/circ28_drug_venlafaxine.sio — venlafaxine (extended-release capsule and
// immediate-release tablet) and O-desmethylvenlafaxine (ODV, desvenlafaxine) on the circ28 drug
// record, coupled by circ28_metab.sio
//
// Healthy adult (ICRP 89 reference male, 73 kg), CYP2D6 extensive metaboliser (EM) by default; the
// poor metaboliser (PM) removes the CYP2D6 pathway only. Two records (venlafaxine R, ODV M); ODV is
// formed from the parent's hepatic clform in liver tissue (sequential first pass). Doses and
// concentrations are venlafaxine BASE (a 75 mg capsule holds the hydrochloride equivalent to 75 mg
// venlafaxine, Effexor XR label section 11).
//
// STATUS: 1 measured, 2 derived by a stated formula from cited values, 3 fitted to ONE named
// observable (then NOT a validation). u is the STANDARD UNCERTAINTY OF THE VALUE; an SD quoted by a
// source is inter-individual and is divided by sqrt(n); "range/sqrt12" where only several values
// exist; "assumed" marks a number with no source. Access: F full text read in this session,
// L label / product information text read, A abstract (PubMed), S secondary (quoted by a paper or
// database that was read; the primary was not opened). Nothing is from memory.
//
// ---- VENLAFAXINE (R) record ---------------------------------------------------------------------
//  param   value   u        status  source / basis of u / access
//  MW      277.4   0        1       Luecht 2025 Pharmaceutics 17:179 (PMID 40006546, PMC11858960) Table 2 (S);
//                                   label: hydrochloride 313.86 (L)
//  logP    2.873   0.167    1       mean of 3.2 (Sangster via PubChem CID 5656, S), 2.8 (Alenezi 2024 PMID 38142123
//                                   via PMC12649812, S) and 2.62 (Luecht 2025, S); u = range/sqrt12
//  pKa1    9.45    0.029    2       mean of 9.4 (Luecht 2025; PMC12649812) and 9.5 (ChEMBL via PubChem); range/sqrt12;
//                                   ionisation class 2 (monoprotic base)
//  fu      0.73    0.0133   1       27 % bound (Effexor XR label, L; "27 +/- 2 %", Australian PI, L); 0.684 in Mamada
//                                   2021 Table S1 (S); u = (0.73 - 0.684)/sqrt12
//  B:P     1.18    0.0055   1       mean of 1.189 (Mamada 2021 J Pharmacokinet Pharmacodyn, Table S1, authors' own
//                                   measurement, supplementary file read, method not stated) and 1.17 (Alenezi 2024 via
//                                   PMC12649812, S); u = range/sqrt12. Two values only: u is small because they agree.
//  fa      0.92    0.023    1       "at least 92 % of a single oral dose is absorbed" (mass balance; Effexor XR label, L);
//                                   u = (1.00 - 0.92)/sqrt12 (one-sided). The absolute bioavailability ~45 % is first pass,
//                                   not incomplete absorption, and is a VALIDATION row, not an input.
//  clren   3.935   0.354    1       renal clearance measured: 0.053 L/h/kg x 73 kg = 3.87 L/h (Troy 1996 J Clin Pharmacol
//                                   36:175, PMID 8852394, A, healthy, multiple dose) and 4 +/- 1 L/h (Lessard 1999
//                                   Pharmacogenetics, PMID 10780263, A, n = 8 EM); mean; u = 1/sqrt(8)
//  clgut   0       -        0       ASSUMPTION: no gut-wall metabolism (intestinal CYP2D6 is ~1 % of CYP3A, Paine 2006
//                                   PMID 16467132, A, as in the risperidone module). The CYP3A N-demethylation in the gut
//                                   wall is not quantified in any source read.
//  kpsc    fitted  3                to V_ss
//  clint, clform  fitted  3         total hepatic to pooled ORAL clearance; split f2D6 to the PM/EM contrast; q to the PM
//                                   ODV:venlafaxine ratio (below)
//  ka      fitted  3                CD_KA = k, the rate of EACH of the ntr = 4 equal transit stages of the oral input
//                                   (round "transit", below), fitted to the immediate-release Tmax; tlag 0 (no sourced lag)
//  pssc    1       0        0       placeholder (flow-limited default); no rate observable with a readable source
//                                   (no intravenous profile was opened), so it is left at the default (lesson 3)
//
// ---- ORAL INPUT: TRANSIT CHAIN; EXTENDED RELEASE (parameters outside the 18-slot record) --------
//  ROUND "TRANSIT" (2026-11-15). The first-order absorption of dissolved drug of the earlier rounds is replaced by the
//  Erlang transit chain of circ28_drug.sio (circ28_oral_mass_n). CONVENTION (common rules, 11): a published "n transit
//  compartments with Ka = Ktr" (Savic 2007, Brill 2014) is n + 1 stages here. No venlafaxine model with a transit chain
//  was found (Europe PMC title/abstract and full-text searches 2026-11-15; the IR models in the literature are first
//  order; the transit-literature table of the refit round, section 3), so n = 3 transit compartments is a DECLARED
//  ASSUMPTION: ntr = ven_ntr() = 4 stages, mean transit time MTT = 4/k, mode of the input rate 3/k. k is the rate of every
//  stage (CD_KA), fitted to ONE observable, the IR steady-state Tmax; tlag = 0 because no lag is sourced for the tablet.
//  Cmax, Cmax/AUC and the IR/XR Cmax ratio are validation rows, never fitted.
//  IR tablet: the whole dose enters the chain at t = 0; mass into the gut tissue in a step = fa Dose (S_4(t0) - S_4(t1)).
//  XR capsule ("controlled by diffusion through the coating membrane on the spheroids and is not pH-dependent", label
//  section 11, L): release is a Weibull function of time,
//      W(t) = 1 - exp(-ln2 ((t - lag)/t50)^b)   for t > lag,   0 before,
//  the form and two of its three numbers taken from the PK-Sim model of Luecht 2025 (F, Table 2: "Weibull
//  dissolution fitted: t50 338 min, lag 81.2 min, shape 0.92"): lag 1.353 h and shape 0.92 are used as published
//  (status 2: model values fitted by those authors to extended-release profiles, not measurements); t50 is FITTED
//  here to the pooled extended-release Tmax (their 5.63 h is a consistency row). The Weibull input is KEPT. The
//  released drug is dissolved drug and travels the SAME chain as the IR dose: the input to the gut tissue is the release rate
//  convolved with the Erlang density of (k, 4), integrated exactly for a release rate constant over a step by carrying the
//  four stage amounts (ven_chain_step). Reason: dissolved drug has one absorption path; keeping the old
//  first-order lumen pool for the XR only would need a second absorption rate with no observable, because the
//  first-order ka of the earlier rounds no longer exists (the IR is fitted through the chain).
//
// ---- O-DESMETHYLVENLAFAXINE (M) record, fitted as its own drug from desvenlafaxine data -------------
//  MW      263.38  0        1       Luecht 2025 Table 2 (S)
//  logP    2.65    0.13     1       mean of 2.6 (DrugBank via PMC12649812, S, probably predicted), 2.45 (Luecht 2025, S)
//                                   and 2.9 (MoKa predicted, gaps_D1); u = range/sqrt12. No experimental value found.
//  pKa1    8.87    0.1      1       8.87 (DrugBank via PMC12649812, S; 8.86 in Luecht 2025); u 0.1 ASSUMED; the phenol
//                                   (10.25, Luecht 2025) is neglected at pH 7.4: monoprotic base
//  fu      0.70    0.035    1       30 % bound (Pristiq label and Canadian monograph, L); "30 +/- 12 %" (Australian PI, L);
//                                   u = 0.12/sqrt12 ASSUMED reading of that spread
//  B:P     1.18    0.10     2       NOT MEASURED: set equal to venlafaxine (PMC12649812 does the same and says so);
//                                   u 0.10 ASSUMED
//  kpsc, clint, clren  fitted  3    to V_ss, CL and fe of intravenous desvenlafaxine (below)
//
// ---- OBSERVABLES USED TO FIT (one per fitted parameter; NOT validations) -------------------------
//  R  V_ss     321.2 L, u 34.7 L.  "Following intravenous administration, the steady state volume of distribution of
//              venlafaxine is 4.4 +/- 1.9 L/kg" (Australian product information, L) x 73 kg; u = 1.9 x 73/sqrt(16),
//              n = 16 ASSUMED (the 16 men of the intravenous arm of Patat 1998 J Clin Pharmacol 38:256, PMID 9549664,
//              A; the PI does not give n). One study: no pool possible.
//  R  CL/F     POOLED oral clearance of healthy adults not selected as PM, k = 7 (ven_clf_pool, printed by the test):
//              94.9 L/h   1.3 +/- 0.6 L/h/kg x 73 (label, L, steady state; n not given, 18 assumed)
//              100  L/h   +/- 62, n = 8 EM, 18.75 mg q12h steady state (Lessard 1999, A)
//              93.5 L/h   225 mg / AUCtau 2407 ng h/mL, n = 37, XR 225 mg/day day 15 (Ermer 2013 Clin Drug Investig 33:243,
//                         PMC3608883, F; geometric mean, no SD: CV 50 % assumed)
//              147.5 L/h  75 mg / AUC0-48 508.5 +/- 439.5, n = 48, XR 75 mg fasting, reference (de Souza Filho 2010
//                         Clin Ther 32:2088, PMID 21118744, A; AUC0-t, so CL/F is biased high by the missing tail)
//              208.0 L/h  150 mg / (526 + 195) ng h/mL, n = 10 phenotyped EM, medians of the two enantiomers
//                         (J Clin Pharmacol 2020, PMID 32974907, A; medians, no spread: CV 50 % assumed)
//              57.8 L/h   150 mg / AUCinf 2596.75 +/- 1376.76, n = 28 Chinese, XR fed, reference (He 2024 Drugs R D
//                         24:275, PMC11315838, F)
//              65.5 L/h   150 mg / AUC0-t 2291.4 +/- 1036.4, n = 23 Indian, XR fed, reference (Jain 2011 Indian J Pharm
//                         Sci 73:510, PMC3425062, F)
//              u = max(pooled standard error, between-study SD/sqrt(k)). WHY ORAL: no intravenous clearance could be
//              opened (Patat 1998 is closed; its abstract gives F only), and oral clearance is what seven studies
//              report. The intravenous clearance and F are then PREDICTIONS.
//  R  PM/EM    POOLED ratio of venlafaxine oral AUC, PM over EM, k = 3 (ven_pm_pool): 5.45 (AUCinf "445 % higher",
//              XR 75 mg, 7 PM / 7 EM, Nichols 2011 Clin Drug Investig, PMID 21288052, A); 2.3 (dose-corrected
//              AUC, 6 PM / 14 EM, Lindh 2003 Eur J Clin Pharmacol, PMID 12898080, A); 4.0 ("oral clearance
//              more than fourfold less", 6 PM / 8 EM, Lessard 1999, A: a LOWER BOUND entered as 4.0).
//              Fixes f2D6, the CYP2D6 share of the hepatic intrinsic clearance.
//  R  PM ratio 0.21, u 0.026. ODV:venlafaxine AUCinf ratio in PM after XR 75 mg (Nichols 2011, A, n = 7; the Cmax
//              ratio is 0.22; Shams 2006 PMID 16958828, A: all PM below 0.3 at steady state); u = (0.30 - 0.21)/sqrt12.
//              Fixes q, the fraction of the NON-CYP2D6 hepatic clearance that forms ODV (CYP2C19/2C9 O-demethylation,
//              Fogelman 1999 via Luecht 2025). One study: no pool possible.
//  R  Tmax IR  2.0 h, u 0.29 h (Effexor XR label Table 17, immediate release 75 mg twice daily, L; no spread:
//              u = range [1.5, 2.5]/sqrt12 ASSUMED). The label value is a STEADY-STATE Tmax, so k is fitted to the
//              Tmax of the superposed twice-daily profile (round 1, first-order input: ka = 0.2597 /h, single-dose Tmax
//              2.86 h; the transit values are in ven_ka_fit, printed by the test). One source.
//  R  Tmax XR  POOLED, k = 4 (ven_tmax_pool): 6.0 +/- 1.5 h (150 mg/day, Australian PI, L; the US label's 5.5 h is the
//              same sponsor data and is not counted twice), 5.885 +/- 1.648 h (n = 48, de Souza Filho 2010, A),
//              4.5 h median (He 2024, F, fed), 7.0 h median (Jain 2011, F, fed). Fixes t50 of the release (round 1,
//              first-order pool: 0.689 h; transit round: ven_t50_fit) at the single-dose Tmax (three of the four studies are single dose).
//  M  CL       POOLED absolute clearance, k = 2 (ven_clm_pool): 0.268 +/- 0.068 L/h/kg (n = 14, intravenous 50 mg over
//              1 h, Nichols 2012 J Bioequiv Availab 4(2), doi 10.4172/jbb.1000105, F, Table 2) and 0.31 +/- 0.15
//              L/h/kg CL/F in 397 adults (Pristiq Canadian monograph, L) x F 0.805 (Nichols 2012); x 73 kg.
//  M  V_ss     248.2 L, u 10.7 L.  3.4 L/kg "at steady-state following intravenous administration" (Pristiq label and
//              monograph, L) x 73; u = 0.546 x 73/sqrt(14), the SD of Vz 3.664 L/kg in Nichols 2012 (F) used as proxy.
//  M  fe       0.515, u 0.0305.    51.5 +/- 11.4 % of an INTRAVENOUS dose excreted unchanged in 72 h urine, n = 14
//              (Nichols 2012, F, Table 3).
//
// CLOSED FORMS USED BY THE FITS (kernel equations; B = bp Qh, ps = liver permeability-surface product)
//   kpsc = (V_ss - bp V_blood)/sum_i V_i (1 - vf_i) Kp_RR,i
//   oral clearance  CL/F = (CLh + CLr)/(fa (1 - Eh)),  y = CLh/(1 - Eh),  Eh = y/(y + B)
//      =>  y = (fa CL/F - CLr)/(1 + CLr/B)                        (linear in y: no iteration)
//   tot = (clint + clform) = (y ps/(ps - y))/fu;  PM: y_PM from (CL/F)_EM / ratio, tot_PM likewise
//   f2D6 = 1 - tot_PM/tot
//   oral AUC ratio ODV/venlafaxine (mass units)
//      R = MWr phi F_src,M [Eh + (1 - Eh) CLh/CL] CL / ((1 - Eh) CL_M),  phi = clform/(clint + clform)
//      (first-pass and systemic hepatic elimination both form ODV with yield phi; F_src,M = 1/(1 + c/B_M + c/ps_M),
//      c = clint_M fu_M, is the fraction of ODV formed in liver tissue that leaves the liver)
//   q = phi_PM from R_PM = 0.21 with the PM values;  EM: clform = (f2D6 + q (1 - f2D6)) tot, clint = (1 - q)(1 - f2D6) tot
//   M: cl_renal = fe CL, CLh = CL - cl_renal, Eh = CLh/B, y = CLh/(1 - Eh), clint = (y ps/(ps - y))/fu
//   k and t50: roots of Tmax = observed on the coupled-run grid (offline secant, scratch programs; constants below, re-checked
//   by the test; k first (IR steady state), then t50 at that k (XR single dose)).
//
// POOR METABOLISER: clform_PM = q (1 - f2D6) tot = clint q/(1 - q); clint, renal clearance and all of ODV unchanged.
//
// GUT-WALL Kp (round "transit"): every fit and run takes gv (0 or 1). gv = 0: the V_ss scalar multiplies the
// Rodgers-Rowland Kp of every organ, the gut wall included (circ28_drug_params_theta). gv = 1: the gut wall keeps its
// Rodgers-Rowland Kp, the scalar is refitted to V_ss with circ28_kp_scale_for_vss_gutrr and every organ except the gut is
// scaled (circ28_drug_params_theta_gutrr). The closed forms of the fits (extraction, F, clearance) do not contain Kp.
// Both variants are run by the test; the variant kept (gv = 0) and the reason are in the test header.

use darwin_pbpk::circ28::*
use darwin_pbpk::circ28_kp::*
use darwin_pbpk::circ28_drug::*
use darwin_pbpk::circ28_metab::*
use math::pure::{exp, ln}

// ---- measured inputs -------------------------------------------------------------------------
pub fn ven_r_mw() -> f64 { return 277.4 }
pub fn ven_r_logp() -> f64 { return 2.873 }
pub fn ven_r_u_logp() -> f64 { return 0.167 }
pub fn ven_r_pka1() -> f64 { return 9.45 }
pub fn ven_r_u_pka1() -> f64 { return 0.029 }
pub fn ven_r_fu() -> f64 { return 0.73 }
pub fn ven_r_u_fu() -> f64 { return 0.0133 }
pub fn ven_r_bp() -> f64 { return 1.18 }
pub fn ven_r_u_bp() -> f64 { return 0.0055 }
pub fn ven_r_fa() -> f64 { return 0.92 }
pub fn ven_r_u_fa() -> f64 { return 0.023 }
pub fn ven_r_clren() -> f64 { return 3.935 }
pub fn ven_r_u_clren() -> f64 { return 0.354 }
pub fn ven_m_mw() -> f64 { return 263.38 }
pub fn ven_m_logp() -> f64 { return 2.65 }
pub fn ven_m_u_logp() -> f64 { return 0.13 }
pub fn ven_m_pka1() -> f64 { return 8.87 }
pub fn ven_m_u_pka1() -> f64 { return 0.1 }
pub fn ven_m_fu() -> f64 { return 0.70 }
pub fn ven_m_u_fu() -> f64 { return 0.035 }
pub fn ven_m_bp() -> f64 { return 1.18 }
pub fn ven_m_u_bp() -> f64 { return 0.10 }

// extended-release Weibull: lag (h) and shape as published (Luecht 2025); t50 fitted (below)
pub fn ven_xr_lag() -> f64 { return 1.353 }
pub fn ven_xr_shape() -> f64 { return 0.92 }
pub fn ven_xr_t50_luecht() -> f64 { return 5.633 }

// Number of Erlang stages of the oral input: n = 3 transit compartments (declared assumption) + 1, rule 11.
pub fn ven_ntr() -> i32 { return 4 }

// Kernel parameters of a record array: gv 0 all-organ Kp scalar, gv 1 gut wall at its Rodgers-Rowland Kp.
pub fn ven_params(th: [f64; 18], gv: i32) -> Circ28Params with Mut, Div, Panic {
    var t = th
    if gv == 1 { return circ28_drug_params_theta_gutrr(t) }
    return circ28_drug_params_theta(t)
}

// V_ss scalar of the variant gv from the parameters p0 built with CD_KPSC = 1 (p0.kp is then the Rodgers-Rowland Kp).
pub fn ven_kp_scale(p0: Circ28Params, vss: f64, gv: i32) -> f64 with Mut, Div {
    if gv == 1 { return circ28_kp_scale_for_vss_gutrr(p0, p0.kp, vss) }
    return circ28_kp_scale_for_vss(p0, p0.kp, vss)
}

fn ven_abs(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

// ---- pooling (lesson 1): mean, between-study SD/sqrt(k), pooled standard error, u = max of the two
// out[0] mean, out[1] u, out[2] between-study SD/sqrt(k), out[3] pooled standard error sqrt(sum se^2)/k,
// out[4] between-study SD
pub fn ven_pool(v: &[f64; 8], se: &[f64; 8], k: i32, out: &![f64; 5]) with Mut, Div, Panic {
    var s = 0.0
    var i: i32 = 0
    while i < k {
        s = s + (*v)[i]
        i = i + 1
    }
    let kf = k as f64
    let mean = s / kf
    var ss = 0.0
    var s2 = 0.0
    i = 0
    while i < k {
        let d = (*v)[i] - mean
        ss = ss + d * d
        s2 = s2 + (*se)[i] * (*se)[i]
        i = i + 1
    }
    var sd = 0.0
    if k > 1 { sd = cd_sqrt(ss / (kf - 1.0)) }
    let ub = sd / cd_sqrt(kf)
    let pse = cd_sqrt(s2) / kf
    var u = ub
    if pse > u { u = pse }
    (*out)[0] = mean
    (*out)[1] = u
    (*out)[2] = ub
    (*out)[3] = pse
    (*out)[4] = sd
}

// Oral clearance of venlafaxine, L/h, k = 7 (sources in the header). se = SD/sqrt(n) of each study.
pub fn ven_clf_pool(out: &![f64; 5]) with Mut, Div, Panic {
    var v: [f64; 8] = [0.0; 8]
    var se: [f64; 8] = [0.0; 8]
    v[0] = 1.3 * 73.0
    se[0] = 0.6 * 73.0 / cd_sqrt(18.0)
    v[1] = 100.0
    se[1] = 62.0 / cd_sqrt(8.0)
    v[2] = 225.0 / 2.407
    se[2] = 0.5 * (225.0 / 2.407) / cd_sqrt(37.0)
    v[3] = 75.0 / 0.508509
    se[3] = (75.0 / 0.508509) * (439.456 / 508.509) / cd_sqrt(48.0)
    v[4] = 150.0 / 0.721
    se[4] = 0.5 * (150.0 / 0.721) / cd_sqrt(10.0)
    v[5] = 150.0 / 2.59675
    se[5] = (150.0 / 2.59675) * (1376.76 / 2596.75) / cd_sqrt(28.0)
    v[6] = 150.0 / 2.291412
    se[6] = (150.0 / 2.291412) * (1036.414 / 2291.412) / cd_sqrt(23.0)
    ven_pool(&v, &se, 7, out)
}

// PM/EM ratio of venlafaxine oral AUC, k = 3. No per-study standard errors in the abstracts: se = 0, so u is
// the between-study term.
pub fn ven_pm_pool(out: &![f64; 5]) with Mut, Div, Panic {
    var v: [f64; 8] = [0.0; 8]
    var se: [f64; 8] = [0.0; 8]
    v[0] = 5.45
    v[1] = 2.3
    v[2] = 4.0
    ven_pool(&v, &se, 3, out)
}

// Extended-release Tmax of venlafaxine, h, k = 4.
pub fn ven_tmax_pool(out: &![f64; 5]) with Mut, Div, Panic {
    var v: [f64; 8] = [0.0; 8]
    var se: [f64; 8] = [0.0; 8]
    v[0] = 6.0
    se[0] = 1.5 / cd_sqrt(18.0)
    v[1] = 5.885
    se[1] = 1.648 / cd_sqrt(48.0)
    v[2] = 4.5
    v[3] = 7.0
    ven_pool(&v, &se, 4, out)
}

// Absolute clearance of ODV (desvenlafaxine), L/h, k = 2.
pub fn ven_clm_pool(out: &![f64; 5]) with Mut, Div, Panic {
    var v: [f64; 8] = [0.0; 8]
    var se: [f64; 8] = [0.0; 8]
    v[0] = 0.268 * 73.0
    se[0] = 0.068 * 73.0 / cd_sqrt(14.0)
    v[1] = 0.31 * 0.805 * 73.0
    se[1] = 0.15 * 0.805 * 73.0 / cd_sqrt(397.0)
    ven_pool(&v, &se, 2, out)
}

// ---- observables the fits are tied to (value, standard uncertainty) --------------------------
pub fn ven_obs_r_vss() -> f64 { return 4.4 * 73.0 }
pub fn ven_u_r_vss() -> f64 { return 1.9 * 73.0 / 4.0 }
pub fn ven_obs_clf() -> f64 with Mut, Div, Panic {
    var o: [f64; 5] = [0.0; 5]
    ven_clf_pool(&!o)
    return o[0]
}
pub fn ven_u_clf() -> f64 with Mut, Div, Panic {
    var o: [f64; 5] = [0.0; 5]
    ven_clf_pool(&!o)
    return o[1]
}
pub fn ven_obs_pmratio() -> f64 with Mut, Div, Panic {
    var o: [f64; 5] = [0.0; 5]
    ven_pm_pool(&!o)
    return o[0]
}
pub fn ven_u_pmratio() -> f64 with Mut, Div, Panic {
    var o: [f64; 5] = [0.0; 5]
    ven_pm_pool(&!o)
    return o[1]
}
pub fn ven_obs_pm_odvratio() -> f64 { return 0.21 }
pub fn ven_u_pm_odvratio() -> f64 { return 0.026 }
pub fn ven_obs_tmax_ir() -> f64 { return 2.0 }
pub fn ven_u_tmax_ir() -> f64 { return 0.2887 }
pub fn ven_obs_tmax_xr() -> f64 with Mut, Div, Panic {
    var o: [f64; 5] = [0.0; 5]
    ven_tmax_pool(&!o)
    return o[0]
}
pub fn ven_u_tmax_xr() -> f64 with Mut, Div, Panic {
    var o: [f64; 5] = [0.0; 5]
    ven_tmax_pool(&!o)
    return o[1]
}
pub fn ven_obs_m_cl() -> f64 with Mut, Div, Panic {
    var o: [f64; 5] = [0.0; 5]
    ven_clm_pool(&!o)
    return o[0]
}
pub fn ven_u_m_cl() -> f64 with Mut, Div, Panic {
    var o: [f64; 5] = [0.0; 5]
    ven_clm_pool(&!o)
    return o[1]
}
pub fn ven_obs_m_vss() -> f64 { return 3.4 * 73.0 }
pub fn ven_u_m_vss() -> f64 { return 0.546 * 73.0 / 3.7416573867739413 }
pub fn ven_obs_m_fe() -> f64 { return 0.515 }
pub fn ven_u_m_fe() -> f64 { return 0.0305 }

// k (1/h per transit stage, ntr = ven_ntr() = 4) with the steady-state Tmax of the IR tablet 75 mg twice daily = 2.0 h,
// and t50 (h) with the single-dose Tmax of the XR capsule = pooled XR Tmax, at that k; both on the grid of
// ven_run_th_g (offline secant on the coupled run, scratch programs; the test re-checks both Tmax values). gv as above.
// The round-1 first-order values were ka 0.259729 /h and t50 0.689116 h.
pub fn ven_ka_fit_g(gv: i32) -> f64 {
    if gv == 1 { return 2.323679 }
    return 2.375289
}
pub fn ven_t50_fit_g(gv: i32) -> f64 {
    if gv == 1 { return 2.387375 }
    return 2.403832
}
pub fn ven_ka_fit() -> f64 { return ven_ka_fit_g(0) }
pub fn ven_t50_fit() -> f64 { return ven_t50_fit_g(0) }

// ---- the fits ----------------------------------------------------------------------------------
// ODV as its own drug: Kp scalar to V_ss, renal part fe x CL, hepatic intrinsic clearance to the rest.
// CD_CLINT = -1 if a fit is impossible.
pub fn ven_fit_m_g(th: [f64; 18], vss: f64, cl: f64, fe: f64, gv: i32) -> [f64; 18] with Mut, Div, Panic {
    var t = th
    t[CD_KPSC] = 1.0
    t[CD_CLINT] = 0.0
    t[CD_CLFORM] = 0.0
    t[CD_CLREN] = 0.0
    let p0 = ven_params(t, gv)
    let sc = ven_kp_scale(p0, vss, gv)
    if !(sc > 0.0) {
        t[CD_CLINT] = 0.0 - 1.0
        return t
    }
    t[CD_KPSC] = sc
    let p = ven_params(t, gv)
    let qh = circ28_q_hepatic(p)
    let clren = fe * cl
    let clh = cl - clren
    let eh = clh / (p.bp * qh)
    if !(eh > 0.0) || !(eh < 1.0) {
        t[CD_CLINT] = 0.0 - 1.0
        return t
    }
    let y = clh / (1.0 - eh)
    if !(p.ps[1] > y) {
        t[CD_CLINT] = 0.0 - 1.0
        return t
    }
    t[CD_CLREN] = clren
    t[CD_CLINT] = (y * p.ps[1] / (p.ps[1] - y)) / p.fu
    return t
}

pub fn ven_fit_m(th: [f64; 18], vss: f64, cl: f64, fe: f64) -> [f64; 18] with Mut, Div, Panic {
    return ven_fit_m_g(th, vss, cl, fe, 0)
}

// F_src of ODV: fraction of the mass formed in liver tissue that leaves the liver.
pub fn ven_fsrc(thm: [f64; 18]) -> f64 with Mut, Div, Panic {
    var tl = thm
    let p = circ28_drug_params_theta(tl)
    let c = p.clint * p.fu
    return 1.0 / (1.0 + c / (circ28_q_hepatic(p) * p.bp) + c / p.ps[1])
}

// Total plasma clearance of a record array from the kernel closed forms (hepatic + renal).
pub fn ven_cl_total(th: [f64; 18]) -> f64 with Mut, Div, Panic {
    var tl = th
    let p = circ28_drug_params_theta(tl)
    return circ28_hepatic_extraction(p) * circ28_q_hepatic(p) * p.bp + th[CD_CLREN]
}

// Hepatic "oral intrinsic" clearance y (plasma, L/h) that gives the oral clearance clf:
// y = (fa clf - clren)/(1 + clren/B).
pub fn ven_y_for_clf(clf: f64, fa: f64, clren: f64, bb: f64) -> f64 with Div {
    return (fa * clf - clren) / (1.0 + clren / bb)
}

// Oral AUC ratio metabolite/parent in mass units for hepatic y, yield phi (closed form in the header).
pub fn ven_ratio_cf(y: f64, bb: f64, clren: f64, phi: f64, mwr: f64, fsrc: f64, clm: f64) -> f64 with Div {
    let eh = y / (y + bb)
    let clh = bb * eh
    let cl = clh + clren
    return mwr * phi * fsrc * (eh + (1.0 - eh) * clh / cl) * cl / ((1.0 - eh) * clm)
}

// The split. Writes out[0] tot (L/h, unbound intrinsic), out[1] tot_PM, out[2] f2D6, out[3] q, out[4] Eh EM,
// out[5] Eh PM, out[6] y EM, out[7] y PM. out[2] = -1 if impossible. t must already carry the fitted Kp scalar.
pub fn ven_split(t: [f64; 18], clf: f64, pmratio: f64, rpm: f64, mwr: f64, fsrc: f64, clm: f64, out: &![f64; 8]) with Mut, Div, Panic {
    var tl = t
    let p = circ28_drug_params_theta(tl)
    let bb = p.bp * circ28_q_hepatic(p)
    let clren = t[CD_CLREN]
    let fa = t[CD_FA]
    let y = ven_y_for_clf(clf, fa, clren, bb)
    let ypm = ven_y_for_clf(clf / pmratio, fa, clren, bb)
    (*out)[2] = 0.0 - 1.0
    if !(y > 0.0) || !(ypm > 0.0) || !(p.ps[1] > y) { return }
    let tot = (y * p.ps[1] / (p.ps[1] - y)) / p.fu
    let totpm = (ypm * p.ps[1] / (p.ps[1] - ypm)) / p.fu
    let f = 1.0 - totpm / tot
    let r1 = ven_ratio_cf(ypm, bb, clren, 1.0, mwr, fsrc, clm)
    let q = rpm / r1
    (*out)[0] = tot
    (*out)[1] = totpm
    (*out)[3] = q
    (*out)[4] = y / (y + bb)
    (*out)[5] = ypm / (ypm + bb)
    (*out)[6] = y
    (*out)[7] = ypm
    if !(f > 0.0) || !(f < 1.0) || !(q >= 0.0) || !(q < 1.0) { return }
    (*out)[2] = f
}

// Venlafaxine: Kp scalar to V_ss, total hepatic intrinsic clearance to the pooled oral clearance, f2D6 to the
// pooled PM/EM AUC ratio, q to the PM ODV:venlafaxine ratio. The renal clearance (measured) is not touched.
// CD_CLINT = -1 if impossible.
pub fn ven_fit_r_g(th: [f64; 18], vss: f64, clf: f64, pmratio: f64, rpm: f64, mwr: f64, fsrc: f64, clm: f64, gv: i32) -> [f64; 18] with Mut, Div, Panic {
    var t = th
    t[CD_KPSC] = 1.0
    t[CD_CLINT] = 0.0
    t[CD_CLFORM] = 0.0
    let p0 = ven_params(t, gv)
    let sc = ven_kp_scale(p0, vss, gv)
    if !(sc > 0.0) {
        t[CD_CLINT] = 0.0 - 1.0
        return t
    }
    t[CD_KPSC] = sc
    var o: [f64; 8] = [0.0; 8]
    ven_split(t, clf, pmratio, rpm, mwr, fsrc, clm, &!o)
    if !(o[2] > 0.0) {
        t[CD_CLINT] = 0.0 - 1.0
        return t
    }
    let tot = o[0]
    let f = o[2]
    let q = o[3]
    t[CD_CLFORM] = (f + q * (1.0 - f)) * tot
    t[CD_CLINT] = (1.0 - q) * (1.0 - f) * tot
    return t
}

// All-organ-scalar variant (gv 0): the signature of the earlier rounds.
pub fn ven_fit_r(th: [f64; 18], vss: f64, clf: f64, pmratio: f64, rpm: f64, mwr: f64, fsrc: f64, clm: f64) -> [f64; 18] with Mut, Div, Panic {
    return ven_fit_r_g(th, vss, clf, pmratio, rpm, mwr, fsrc, clm, 0)
}

// ---- records -----------------------------------------------------------------------------------
pub fn ven_measured_r(d: &!Circ28Drug) with Mut, Div, Panic, Epistemic {
    circ28_drug_set(d, CD_MW, ven_r_mw(), 0.0, CD_STATUS_MEASURED, "Luecht2025 Table 2 (277.4); label HCl 313.86")
    circ28_drug_set(d, CD_LOGP, ven_r_logp(), ven_r_u_logp(), CD_STATUS_MEASURED, "mean of 3.2 Sangster (PubChem), 2.8 Alenezi2024, 2.62 Luecht2025; u = range/sqrt12")
    circ28_drug_set(d, CD_PKA1, ven_r_pka1(), ven_r_u_pka1(), CD_STATUS_DERIVED, "mean of 9.4 (Luecht2025) and 9.5 (ChEMBL); u = range/sqrt12")
    circ28_drug_set(d, CD_ION, 2.0, 0.0, CD_STATUS_DERIVED, "monoprotic base")
    circ28_drug_set(d, CD_FU, ven_r_fu(), ven_r_u_fu(), CD_STATUS_MEASURED, "27 % bound (Effexor XR label); 0.684 Mamada2021; u = range/sqrt12")
    circ28_drug_set(d, CD_BP, ven_r_bp(), ven_r_u_bp(), CD_STATUS_MEASURED, "mean of 1.189 (Mamada2021 Table S1, measured) and 1.17 (Alenezi2024); u = range/sqrt12")
    circ28_drug_set(d, CD_FA, ven_r_fa(), ven_r_u_fa(), CD_STATUS_MEASURED, "at least 92 % absorbed, mass balance (Effexor XR label); u = (1 - 0.92)/sqrt12")
    circ28_drug_set(d, CD_CLREN, ven_r_clren(), ven_r_u_clren(), CD_STATUS_MEASURED, "renal clearance 0.053 L/h/kg x 73 (Troy1996) and 4 +/- 1 L/h (Lessard1999, n 8); mean")
}

pub fn ven_measured_m(d: &!Circ28Drug) with Mut, Div, Panic, Epistemic {
    circ28_drug_set(d, CD_MW, ven_m_mw(), 0.0, CD_STATUS_MEASURED, "Luecht2025 Table 2 (263.38)")
    circ28_drug_set(d, CD_LOGP, ven_m_logp(), ven_m_u_logp(), CD_STATUS_MEASURED, "mean of 2.6 DrugBank, 2.45 Luecht2025, 2.9 MoKa (all model/predicted); u = range/sqrt12")
    circ28_drug_set(d, CD_PKA1, ven_m_pka1(), ven_m_u_pka1(), CD_STATUS_MEASURED, "8.87 DrugBank via PMC12649812; u 0.1 assumed")
    circ28_drug_set(d, CD_ION, 2.0, 0.0, CD_STATUS_DERIVED, "monoprotic base (phenol pKa 10.25 neglected)")
    circ28_drug_set(d, CD_FU, ven_m_fu(), ven_m_u_fu(), CD_STATUS_MEASURED, "30 % bound (Pristiq label); u = 0.12/sqrt12 assumed")
    circ28_drug_set(d, CD_BP, ven_m_bp(), ven_m_u_bp(), CD_STATUS_DERIVED, "NOT MEASURED: set equal to venlafaxine 1.18; u 0.10 assumed")
}

pub fn ven_fit_record_m_g(d: &!Circ28Drug, gv: i32) with Mut, Div, Panic, Epistemic {
    let th0 = circ28_drug_theta(d)
    let th = ven_fit_m_g(th0, ven_obs_m_vss(), ven_obs_m_cl(), ven_obs_m_fe(), gv)
    circ28_drug_set(d, CD_KPSC, th[CD_KPSC], 0.0, CD_STATUS_FITTED, "fitted to Vss 248.2 L = 3.4 L/kg x 73 (Pristiq label, intravenous); gv 1: gut wall at Rodgers-Rowland Kp")
    circ28_drug_set(d, CD_CLREN, th[CD_CLREN], 0.0, CD_STATUS_FITTED, "fe 0.515 (Nichols2012, intravenous) x pooled CL")
    circ28_drug_set(d, CD_CLINT, th[CD_CLINT], 0.0, CD_STATUS_FITTED, "fitted to the non-renal part of the pooled CL (Nichols2012 IV; monograph CL/F x F)")
}

pub fn ven_fit_record_m(d: &!Circ28Drug) with Mut, Div, Panic, Epistemic {
    ven_fit_record_m_g(d, 0)
}

// dm must already be fitted (its clearance and F_src enter the q fit).
pub fn ven_fit_record_r_g(d: &!Circ28Drug, dm: &Circ28Drug, gv: i32) with Mut, Div, Panic, Epistemic {
    let th0 = circ28_drug_theta(d)
    let thm = circ28_drug_theta(dm)
    let fsrc = ven_fsrc(thm)
    let clm = ven_cl_total(thm)
    let th = ven_fit_r_g(th0, ven_obs_r_vss(), ven_obs_clf(), ven_obs_pmratio(), ven_obs_pm_odvratio(), ven_m_mw() / ven_r_mw(), fsrc, clm, gv)
    circ28_drug_set(d, CD_KPSC, th[CD_KPSC], 0.0, CD_STATUS_FITTED, "fitted to Vss 321.2 L = 4.4 L/kg x 73 (intravenous, Australian PI); gv 1: gut wall at Rodgers-Rowland Kp")
    circ28_drug_set(d, CD_CLINT, th[CD_CLINT], 0.0, CD_STATUS_FITTED, "(1 - q)(1 - f2D6) x total hepatic; total to pooled oral CL/F (k 7); f2D6 to pooled PM/EM AUC ratio (k 3)")
    circ28_drug_set(d, CD_CLFORM, th[CD_CLFORM], 0.0, CD_STATUS_FITTED, "O-demethylation: (f2D6 + q (1 - f2D6)) x total hepatic; q to the PM ODV:venlafaxine AUC ratio 0.21 (Nichols2011)")
}

pub fn ven_fit_record_r(d: &!Circ28Drug, dm: &Circ28Drug) with Mut, Div, Panic, Epistemic {
    ven_fit_record_r_g(d, dm, 0)
}

// CD_KA is the rate k of each of the ven_ntr() = 4 transit stages (round "transit").
pub fn ven_ka_record_g(d: &!Circ28Drug, gv: i32) with Mut, Div, Panic, Epistemic {
    circ28_drug_set(d, CD_KA, ven_ka_fit_g(gv), 0.0, CD_STATUS_FITTED, "per-stage rate of 4 transit stages (n = 3 declared + 1), fitted to the IR steady-state Tmax 2.0 h (Effexor XR label Table 17)")
}

pub fn ven_ka_record(d: &!Circ28Drug) with Mut, Div, Panic, Epistemic {
    ven_ka_record_g(d, 0)
}

// ---- input -------------------------------------------------------------------------------------
// Fraction released by the capsule at time t (h): Weibull with ln2 scaling, so that t50 is the time after
// the lag at which half is released.
pub fn ven_weibull(t: f64, lag: f64, t50: f64, shape: f64) -> f64 with Mut, Div, Panic {
    if t <= lag { return 0.0 }
    let x = (t - lag) / t50
    return 1.0 - exp(0.0 - 0.6931471805599453 * exp(shape * ln(x)))
}

// One exact step of the Erlang chain as ntr (<= 8) states a[0..ntr-1] (mg in each transit stage, rate k out of each):
//   da_1/dt = r - k a_1,  da_j/dt = k (a_{j-1} - a_j);  the flow k a_ntr enters the gut tissue.
// For a release rate r constant over the step dt, with x = k dt and the Poisson terms p_m = exp(-x) x^m / m!,
//   a_j(dt) = sum_{m <= j} p_{j-m} a_m(0) + (r/k) (1 - sum_{m < j} p_m).
// Returns the mass (mg) that arrived in the gut tissue during the step = r dt + sum a(0) - sum a(dt) (conservation, exact).
// Starting with the whole dose in a[0] and r = 0 this is the first-order-in-series chain of circ28_oral_left_n.
pub fn ven_chain_step(a: &![f64; 8], k: f64, ntr: i32, dt: f64, r: f64) -> f64 with Mut, Div, Panic {
    let x = k * dt
    var p: [f64; 8] = [0.0; 8]
    p[0] = exp(0.0 - x)
    var m: i32 = 1
    while m < ntr {
        p[m] = p[m - 1] * x / (m as f64)
        m = m + 1
    }
    var b: [f64; 8] = [0.0; 8]
    var tot0 = 0.0
    var tot1 = 0.0
    var cum = 0.0
    var j: i32 = 0
    while j < ntr {
        cum = cum + p[j]
        var acc = (r / k) * (1.0 - cum)
        var q: i32 = 0
        while q <= j {
            acc = acc + p[j - q] * (*a)[q]
            q = q + 1
        }
        b[j] = acc
        tot0 = tot0 + (*a)[j]
        tot1 = tot1 + acc
        j = j + 1
    }
    j = 0
    while j < ntr {
        (*a)[j] = b[j]
        j = j + 1
    }
    return r * dt + tot0 - tot1
}

// ---- coupled run -----------------------------------------------------------------------------
// Grid: 0.1 h to 12 h (120 steps), then 0.5 h to 132 h (240 steps); n = 360 samples, arrays of 400.
// route 0: intravenous infusion over t_inf; route 1: immediate release (the whole dose enters the Erlang chain at 0);
// route 2: extended release (Weibull release feeding the same chain through the four stage amounts (ven_chain_step)). k = CD_KA per stage, ntr = ven_ntr(), fa from the R array.
// Result layout (res):
//   0 R Cmax  1 R Tmax  2 R AUC_inf  3 R t1/2  4 R AUC_0-T  5 M Cmax  6 M Tmax  7 M AUC_inf  8 M t1/2
//   9 input (mg into the body)  10 R mass balance error  11 M mass balance error  12 grid ok
//   13 R terminal fit ok  14 M terminal fit ok  15 mass given to M (mg)  16 M AUC_0-T  17 R c_end  18 M c_end
//   19 parent mass renally excreted (mg)  20 ODV mass renally excreted (mg)  21 active-moiety Cmax (R + M, mg/L)
//   22 time of the active-moiety peak  23 dose minus the mass that has left the chain (mg): unreleased + in transit
// Plasma concentrations (mg/L): venous blood / bp. The curves are written to ts, cr, cm (index 1..n).
pub fn ven_lz(ts: &[f64; 400], cs: &[f64; 400], n: i32, lo: f64, hi: f64) -> f64 with Mut, Div, Panic {
    var sw = 0.0
    var st = 0.0
    var sy = 0.0
    var stt = 0.0
    var sty = 0.0
    var nf: i32 = 0
    var i: i32 = 1
    while i <= n {
        if (*ts)[i] >= lo && (*ts)[i] <= hi {
            if (*cs)[i] > 0.0 {
                let y = ln((*cs)[i])
                sw = sw + 1.0
                st = st + (*ts)[i]
                sy = sy + y
                stt = stt + (*ts)[i] * (*ts)[i]
                sty = sty + (*ts)[i] * y
                nf = nf + 1
            }
        }
        i = i + 1
    }
    if nf < 3 { return 0.0 }
    let den = sw * stt - st * st
    let lz = 0.0 - (sw * sty - st * sy) / den
    if !(lz > 0.0) { return 0.0 }
    return lz
}

// Peak with the vertex refinement of circ28_run (equal spacing only): out[0] cmax, out[1] tmax.
pub fn ven_peak(ts: &[f64; 400], cs: &[f64; 400], n: i32, out: &![f64; 2]) with Mut, Div, Panic {
    var im: i32 = 0
    var cm = 0.0
    var i: i32 = 1
    while i <= n {
        if (*cs)[i] > cm {
            cm = (*cs)[i]
            im = i
        }
        i = i + 1
    }
    (*out)[0] = cm
    (*out)[1] = (*ts)[im]
    if im >= 1 && im < n {
        let h1 = (*ts)[im] - (*ts)[im - 1]
        let h2 = (*ts)[im + 1] - (*ts)[im]
        if ven_abs(h1 - h2) < 1.0e-9 {
            let den = (*cs)[im - 1] - 2.0 * (*cs)[im] + (*cs)[im + 1]
            if den < 0.0 {
                let off = 0.5 * ((*cs)[im - 1] - (*cs)[im + 1]) / den
                (*out)[1] = (*ts)[im] + off * h1
                (*out)[0] = (*cs)[im] - 0.25 * ((*cs)[im - 1] - (*cs)[im + 1]) * off
            }
        }
    }
}

pub fn ven_run_th_g(
    thr_in: [f64; 18], thm_in: [f64; 18], route: i32, dose: f64, t_inf: f64, t50: f64, gv: i32,
    wr_lo: f64, wr_hi: f64, wm_lo: f64, wm_hi: f64,
    ts: &![f64; 400], cr: &![f64; 400], cm: &![f64; 400], res: &![f64; 24]
) with Mut, Div, Panic {
    var thr = thr_in
    var thm = thm_in
    let pr = ven_params(thr, gv)
    let pm = ven_params(thm, gv)
    let cp = circ28_coupling(thm[CD_MW] / thr[CD_MW], 0.0)
    let ka = thr[CD_KA]
    let fa = thr[CD_FA]
    let lag = ven_xr_lag()
    let shape = ven_xr_shape()
    var sysr = circ28_sys_zero()
    var sysm = circ28_sys_zero()
    var sr = circ28_state_zero()
    var sm = circ28_state_zero()
    var elr = circ28_elim_zero()
    var elm = circ28_elim_zero()
    var n: i32 = 0
    var t = 0.0
    var input = 0.0
    var given = 0.0
    var ok = 1.0
    let ntr = ven_ntr()
    var drawn = 0.0
    var ach: [f64; 8] = [0.0; 8]
    (*ts)[0] = 0.0
    (*cr)[0] = 0.0
    (*cm)[0] = 0.0
    var ph: i32 = 0
    while ph < 2 {
        var dt = 0.1
        var tstop = 12.0
        if ph == 1 {
            dt = 0.5
            tstop = 132.0
        }
        circ28_prepare(pr, dt, &!sysr)
        circ28_prepare(pm, dt, &!sysm)
        while t + 0.5 * dt < tstop {
            if n >= 399 {
                ok = 0.0
                t = tstop
            } else {
                var iv = 0.0
                var oral = 0.0
                var mass = 0.0
                if route == 0 {
                    mass = circ28_iv_mass(dose, t_inf, t, t + dt)
                    iv = mass / dt
                } else {
                    // oral input through the Erlang chain (k = CD_KA per stage, ntr stages, no lag)
                    var arriving = 0.0
                    if route == 1 {
                        arriving = dose * (circ28_oral_left_n(ka, ntr, 0.0, t) - circ28_oral_left_n(ka, ntr, 0.0, t + dt))
                    } else {
                        let rel = dose * (ven_weibull(t + dt, lag, t50, shape) - ven_weibull(t, lag, t50, shape))
                        arriving = ven_chain_step(&!ach, ka, ntr, dt, rel / dt)
                    }
                    drawn = drawn + arriving
                    mass = fa * arriving
                    oral = mass / dt
                }
                input = input + mass
                given = given + circ28_metab_step(&!sr, pr, &sysr, &!elr, &!sm, pm, &sysm, &!elm, cp, iv, oral)
                t = t + dt
                n = n + 1
                (*ts)[n] = t
                (*cr)[n] = sr.x[0] / pr.bp
                (*cm)[n] = sm.x[0] / pm.bp
            }
        }
        ph = ph + 1
    }
    var pk: [f64; 2] = [0.0; 2]
    ven_peak(ts, cr, n, &!pk)
    (*res)[0] = pk[0]
    (*res)[1] = pk[1]
    ven_peak(ts, cm, n, &!pk)
    (*res)[5] = pk[0]
    (*res)[6] = pk[1]
    // active moiety (sum of the two concentrations) on the grid
    var am = 0.0
    var tam = 0.0
    var i: i32 = 1
    while i <= n {
        let s = (*cr)[i] + (*cm)[i]
        if s > am {
            am = s
            tam = (*ts)[i]
        }
        i = i + 1
    }
    (*res)[21] = am
    (*res)[22] = tam
    let lzr = ven_lz(ts, cr, n, wr_lo, wr_hi)
    let lzm = ven_lz(ts, cm, n, wm_lo, wm_hi)
    let auc_r = elr.auc_ven / pr.bp
    let auc_m = elm.auc_ven / pm.bp
    (*res)[4] = auc_r
    (*res)[16] = auc_m
    (*res)[13] = 0.0
    (*res)[14] = 0.0
    (*res)[2] = auc_r
    (*res)[7] = auc_m
    (*res)[3] = 0.0
    (*res)[8] = 0.0
    if lzr > 0.0 {
        (*res)[13] = 1.0
        (*res)[3] = 0.6931471805599453 / lzr
        (*res)[2] = auc_r + (*cr)[n] / lzr
    }
    if lzm > 0.0 {
        (*res)[14] = 1.0
        (*res)[8] = 0.6931471805599453 / lzm
        (*res)[7] = auc_m + (*cm)[n] / lzm
    }
    (*res)[9] = input
    let eli_r = elr.hepatic + elr.formed + elr.renal + elr.plasma + elr.gut
    var ber = 0.0
    if input > 0.0 { ber = ven_abs(input - eli_r - circ28_total_mass(&sr, pr)) / input }
    (*res)[10] = ber
    let eli_m = elm.hepatic + elm.formed + elm.renal + elm.plasma + elm.gut
    var bem = 0.0
    if given > 0.0 { bem = ven_abs(given - eli_m - circ28_total_mass(&sm, pm)) / given }
    (*res)[11] = bem
    (*res)[12] = ok
    (*res)[15] = given
    (*res)[17] = (*cr)[n]
    (*res)[18] = (*cm)[n]
    (*res)[19] = elr.renal
    (*res)[20] = elm.renal
    (*res)[23] = dose - drawn
    if route == 0 { (*res)[23] = 0.0 }
}

// All-organ-scalar variant (gv 0): the signature of the earlier rounds.
pub fn ven_run_th(
    thr_in: [f64; 18], thm_in: [f64; 18], route: i32, dose: f64, t_inf: f64, t50: f64,
    wr_lo: f64, wr_hi: f64, wm_lo: f64, wm_hi: f64,
    ts: &![f64; 400], cr: &![f64; 400], cm: &![f64; 400], res: &![f64; 24]
) with Mut, Div, Panic {
    ven_run_th_g(thr_in, thm_in, route, dose, t_inf, t50, 0, wr_lo, wr_hi, wm_lo, wm_hi, ts, cr, cm, res)
}

// ---- steady state by superposition (the model is linear) ---------------------------------------
// Concentration of the single-dose curve at time t (h) on the grid of ven_run_th: linear interpolation,
// zero beyond the last sample (132 h).
pub fn ven_curve_at(c: &[f64; 400], t: f64) -> f64 with Mut, Div, Panic {
    if t <= 0.0 { return 0.0 }
    if t >= 132.0 { return 0.0 }
    var x = t / 0.1
    var base: i32 = 0
    if t >= 12.0 {
        x = (t - 12.0) / 0.5
        base = 120
    }
    var j = x as i32
    var fr = x - (j as f64)
    if fr < 0.0 {
        j = j - 1
        fr = fr + 1.0
    }
    let i0 = base + j
    if i0 >= 360 { return (*c)[360] }
    return (*c)[i0] + fr * ((*c)[i0 + 1] - (*c)[i0])
}

// Superposed steady-state concentration at time t (h) after a dose, doses every tau h.
pub fn ven_ss_at(c: &[f64; 400], tau: f64, t: f64) -> f64 with Mut, Div, Panic {
    var s = 0.0
    var tt = t
    while tt < 132.0 {
        s = s + ven_curve_at(c, tt)
        tt = tt + tau
    }
    return s
}

// Vertex of the parabola through (t - h, t, t + h) of the superposed curve: out[0] value, out[1] time.
pub fn ven_ss_vertex(c: &[f64; 400], tau: f64, t: f64, h: f64, out: &![f64; 2]) with Mut, Div, Panic {
    let c1 = ven_ss_at(c, tau, t)
    (*out)[0] = c1
    (*out)[1] = t
    if t - h < 0.0 || t + h > tau { return }
    let c0 = ven_ss_at(c, tau, t - h)
    let c2 = ven_ss_at(c, tau, t + h)
    let den = c0 - 2.0 * c1 + c2
    if den < 0.0 {
        let off = 0.5 * (c0 - c2) / den
        (*out)[1] = t + off * h
        (*out)[0] = c1 - 0.25 * (c0 - c2) * off
    }
}

// Steady state of a regimen "dose every tau h" from the single-dose curves of the SAME dose, sampled every
// 0.1 h over one interval (ndose = 132/tau superposed doses). Two curves (parent a, metabolite b) so that the
// active-moiety peak is taken on the summed curve. out: 0 Cmax a, 1 Tmax a, 2 Cmin a, 3 AUCtau a (trapezoid),
// 4 Cmax b, 5 Tmax b, 6 Cmin b, 7 AUCtau b, 8 Cmax of a + b, 9 its time.
pub fn ven_ss(a: &[f64; 400], b: &[f64; 400], tau: f64, out: &![f64; 10]) with Mut, Div, Panic {
    let h = 0.1
    let m = (tau / h + 0.5) as i32
    var amax = 0.0
    var atm = 0.0
    var amin = 1.0e30
    var aauc = 0.0
    var bmax = 0.0
    var btm = 0.0
    var bmin = 1.0e30
    var bauc = 0.0
    var smax = 0.0
    var stm = 0.0
    var aprev = 0.0
    var bprev = 0.0
    var i: i32 = 0
    while i <= m {
        let t = (i as f64) * h
        var sa = 0.0
        var sb = 0.0
        var tt = t
        while tt < 132.0 {
            sa = sa + ven_curve_at(a, tt)
            sb = sb + ven_curve_at(b, tt)
            tt = tt + tau
        }
        if sa > amax {
            amax = sa
            atm = t
        }
        if sa < amin { amin = sa }
        if sb > bmax {
            bmax = sb
            btm = t
        }
        if sb < bmin { bmin = sb }
        if sa + sb > smax {
            smax = sa + sb
            stm = t
        }
        if i > 0 {
            aauc = aauc + 0.5 * h * (aprev + sa)
            bauc = bauc + 0.5 * h * (bprev + sb)
        }
        aprev = sa
        bprev = sb
        i = i + 1
    }
    var vx: [f64; 2] = [0.0; 2]
    ven_ss_vertex(a, tau, atm, h, &!vx)
    (*out)[0] = vx[0]
    (*out)[1] = vx[1]
    (*out)[2] = amin
    (*out)[3] = aauc
    ven_ss_vertex(b, tau, btm, h, &!vx)
    (*out)[4] = vx[0]
    (*out)[5] = vx[1]
    (*out)[6] = bmin
    (*out)[7] = bauc
    (*out)[8] = smax
    (*out)[9] = stm
}

// Closed-form oral bioavailability of venlafaxine: fa (1 - Eh) (no gut-wall clearance).
pub fn ven_f_oral(th: [f64; 18]) -> f64 with Mut, Div, Panic {
    var tl = th
    let p = circ28_drug_params_theta(tl)
    return th[CD_FA] * circ28_gut_availability(p) * (1.0 - circ28_hepatic_extraction(p))
}

// ---- budget with refit -------------------------------------------------------------------------
// Nineteen inputs: 0 logP_R, 1 pKa_R, 2 fu_R, 3 bp_R, 4 fa, 5 CLren_R, 6 logP_M, 7 pKa_M, 8 fu_M, 9 bp_M (measured),
// 10 CL/F pooled, 11 Vss_R, 12 PM/EM ratio pooled, 13 PM ODV ratio, 14 Tmax IR, 15 Tmax XR pooled, 16 CL_M pooled,
// 17 Vss_M, 18 fe_M (observables). Each evaluation refits M, then R (closed forms), moves k and t50 by the chords
// dk/dTmax_IR, dt50/dTmax_XR and dt50/dk (local slopes measured offline by central differences of the secant fit, steps 0.029 h, 0.051 h, 0.04 /h, ven_dka_dtmax,
// ven_dt50_dtmax, ven_dt50_dk; the dependence of the two Tmax on the OTHER inputs is neglected in the budget and stated;
// the test checks one chord update by a refit), runs XR 150 mg, and
// superposes to steady state. Outputs: 0 active-moiety AUC (R + M, mg h/L), 1 active-moiety steady-state Cmax
// (150 mg once daily, mg/L), 2 R AUC, 3 M AUC.
pub fn ven_dka_dtmax() -> f64 { return 0.0 - 1.343798 }
pub fn ven_dt50_dtmax() -> f64 { return 1.336110 }
pub fn ven_dt50_dk() -> f64 { return 1.463057 }

pub fn ven_input_u(i: i32) -> f64 with Mut, Div, Panic {
    if i == 0 { return ven_r_u_logp() }
    if i == 1 { return ven_r_u_pka1() }
    if i == 2 { return ven_r_u_fu() }
    if i == 3 { return ven_r_u_bp() }
    if i == 4 { return ven_r_u_fa() }
    if i == 5 { return ven_r_u_clren() }
    if i == 6 { return ven_m_u_logp() }
    if i == 7 { return ven_m_u_pka1() }
    if i == 8 { return ven_m_u_fu() }
    if i == 9 { return ven_m_u_bp() }
    if i == 10 { return ven_u_clf() }
    if i == 11 { return ven_u_r_vss() }
    if i == 12 { return ven_u_pmratio() }
    if i == 13 { return ven_u_pm_odvratio() }
    if i == 14 { return ven_u_tmax_ir() }
    if i == 15 { return ven_u_tmax_xr() }
    if i == 16 { return ven_u_m_cl() }
    if i == 17 { return ven_u_m_vss() }
    return ven_u_m_fe()
}

pub fn ven_input_name(i: i32) -> string {
    if i == 0 { return "logP_R    " }
    if i == 1 { return "pKa_R     " }
    if i == 2 { return "fu_R      " }
    if i == 3 { return "bp_R      " }
    if i == 4 { return "fa        " }
    if i == 5 { return "CLren_R   " }
    if i == 6 { return "logP_M    " }
    if i == 7 { return "pKa_M     " }
    if i == 8 { return "fu_M      " }
    if i == 9 { return "bp_M      " }
    if i == 10 { return "CL/F pool " }
    if i == 11 { return "Vss_R obs " }
    if i == 12 { return "PM/EM pool" }
    if i == 13 { return "PM ODV:V  " }
    if i == 14 { return "Tmax IR   " }
    if i == 15 { return "Tmax XR   " }
    if i == 16 { return "CL_M pool " }
    if i == 17 { return "Vss_M obs " }
    return "fe_M obs  "
}

pub fn ven_input_value(i: i32) -> f64 with Mut, Div, Panic {
    if i == 0 { return ven_r_logp() }
    if i == 1 { return ven_r_pka1() }
    if i == 2 { return ven_r_fu() }
    if i == 3 { return ven_r_bp() }
    if i == 4 { return ven_r_fa() }
    if i == 5 { return ven_r_clren() }
    if i == 6 { return ven_m_logp() }
    if i == 7 { return ven_m_pka1() }
    if i == 8 { return ven_m_fu() }
    if i == 9 { return ven_m_bp() }
    if i == 10 { return ven_obs_clf() }
    if i == 11 { return ven_obs_r_vss() }
    if i == 12 { return ven_obs_pmratio() }
    if i == 13 { return ven_obs_pm_odvratio() }
    if i == 14 { return ven_obs_tmax_ir() }
    if i == 15 { return ven_obs_tmax_xr() }
    if i == 16 { return ven_obs_m_cl() }
    if i == 17 { return ven_obs_m_vss() }
    return ven_obs_m_fe()
}

pub fn ven_eval(z: &[f64; 20], dr: &Circ28Drug, dm: &Circ28Drug, dose_mg: f64, out: &![f64; 4]) with Mut, Div, Panic, Epistemic {
    var tm0 = circ28_drug_theta(dm)
    tm0[CD_LOGP] = (*z)[6]
    tm0[CD_PKA1] = (*z)[7]
    tm0[CD_FU] = (*z)[8]
    tm0[CD_BP] = (*z)[9]
    let tm = ven_fit_m(tm0, (*z)[17], (*z)[16], (*z)[18])
    var tr0 = circ28_drug_theta(dr)
    tr0[CD_LOGP] = (*z)[0]
    tr0[CD_PKA1] = (*z)[1]
    tr0[CD_FU] = (*z)[2]
    tr0[CD_BP] = (*z)[3]
    tr0[CD_FA] = (*z)[4]
    tr0[CD_CLREN] = (*z)[5]
    let fsrc = ven_fsrc(tm)
    let clm = ven_cl_total(tm)
    var tr = ven_fit_r(tr0, (*z)[11], (*z)[10], (*z)[12], (*z)[13], tm[CD_MW] / tr0[CD_MW], fsrc, clm)
    tr[CD_KA] = ven_ka_fit() + ven_dka_dtmax() * ((*z)[14] - ven_obs_tmax_ir())
    let t50 = ven_t50_fit() + ven_dt50_dtmax() * ((*z)[15] - ven_obs_tmax_xr()) + ven_dt50_dk() * (tr[CD_KA] - ven_ka_fit())
    var ts: [f64; 400] = [0.0; 400]
    var cr: [f64; 400] = [0.0; 400]
    var cm: [f64; 400] = [0.0; 400]
    var res: [f64; 24] = [0.0; 24]
    ven_run_th(tr, tm, 2, dose_mg, 0.0, t50, 60.0, 96.0, 60.0, 120.0, &!ts, &!cr, &!cm, &!res)
    var ss: [f64; 10] = [0.0; 10]
    ven_ss(&cr, &cm, 24.0, &!ss)
    (*out)[0] = res[2] + res[7]
    (*out)[1] = ss[8]
    (*out)[2] = res[2]
    (*out)[3] = res[7]
}

pub struct VenBudget {
    pub am_auc: f64,
    pub am_cmax: f64,
    pub r_auc: f64,
    pub m_auc: f64,
    pub var_auc: f64,
    pub var_cmax: f64,
    pub var_r: f64,
    pub var_m: f64,
    pub contrib_auc: [f64; 20],
    pub contrib_cmax: [f64; 20],
    pub u: [f64; 20],
    pub runs: i32,
}

// Forward differences (lesson 6), step h_i = min(1e-3 |z_i|, 0.1 u_i).
pub fn ven_budget(dr: &Circ28Drug, dm: &Circ28Drug, dose_mg: f64) -> VenBudget with Mut, Div, Panic, Epistemic {
    var z0: [f64; 20] = [0.0; 20]
    var u: [f64; 20] = [0.0; 20]
    var i: i32 = 0
    while i < 19 {
        z0[i] = ven_input_value(i)
        u[i] = ven_input_u(i)
        i = i + 1
    }
    var o0: [f64; 4] = [0.0; 4]
    ven_eval(&z0, dr, dm, dose_mg, &!o0)
    var ca: [f64; 20] = [0.0; 20]
    var cc: [f64; 20] = [0.0; 20]
    var va = 0.0
    var vc = 0.0
    var vr = 0.0
    var vm = 0.0
    var nrun: i32 = 1
    i = 0
    while i < 19 {
        var hs = 1.0e-3 * ven_abs(z0[i])
        if hs > 0.1 * u[i] { hs = 0.1 * u[i] }
        var zp = z0
        zp[i] = z0[i] + hs
        var op: [f64; 4] = [0.0; 4]
        ven_eval(&zp, dr, dm, dose_mg, &!op)
        nrun = nrun + 1
        let da = (op[0] - o0[0]) / hs
        let dc = (op[1] - o0[1]) / hs
        let d2 = (op[2] - o0[2]) / hs
        let d3 = (op[3] - o0[3]) / hs
        ca[i] = da * da * u[i] * u[i]
        cc[i] = dc * dc * u[i] * u[i]
        va = va + ca[i]
        vc = vc + cc[i]
        vr = vr + d2 * d2 * u[i] * u[i]
        vm = vm + d3 * d3 * u[i] * u[i]
        i = i + 1
    }
    return VenBudget { am_auc: o0[0], am_cmax: o0[1], r_auc: o0[2], m_auc: o0[3], var_auc: va, var_cmax: vc, var_r: vr, var_m: vm, contrib_auc: ca, contrib_cmax: cc, u: u, runs: nrun }
}
