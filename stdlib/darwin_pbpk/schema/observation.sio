// darwin_pbpk/schema/observation.sio — observed-data schema for PBPK workflows
//
// Uses fixed-capacity tables because this compiler lane handles them more
// predictably than dynamic vectors for new PBPK workflow surfaces.

pub struct RawObservationRow {
    subject_id: string,
    time_value: f64,
    time_unit: string,
    matrix: string,
    organ: string,
    compartment: string,
    observable_id: string,
    measurement: f64,
    value_unit: string,
    measurement_uncertainty: f64,
    assay: string,
    source: string,
}

pub struct RawObservationTable {
    subject_ids: [string; 128],
    time_values: [f64; 128],
    time_units: [string; 128],
    matrices: [string; 128],
    organs: [string; 128],
    compartments: [string; 128],
    observable_ids: [string; 128],
    measurements: [f64; 128],
    value_units: [string; 128],
    measurement_uncertainties: [f64; 128],
    assays: [string; 128],
    sources: [string; 128],
    count: usize,
    overflowed: bool,
}

pub fn raw_observation_table_new() -> RawObservationTable with Mut {
    RawObservationTable {
        subject_ids: [""; 128],
        time_values: [0.0; 128],
        time_units: [""; 128],
        matrices: [""; 128],
        organs: [""; 128],
        compartments: [""; 128],
        observable_ids: [""; 128],
        measurements: [0.0; 128],
        value_units: [""; 128],
        measurement_uncertainties: [0.0; 128],
        assays: [""; 128],
        sources: [""; 128],
        count: 0,
        overflowed: false,
    }
}

pub fn raw_observation_count(table: RawObservationTable) -> usize {
    table.count
}

pub fn raw_observation_table_add(
    table: RawObservationTable,
    subject_id: string,
    time_value: f64,
    time_unit: string,
    matrix: string,
    organ: string,
    compartment: string,
    observable_id: string,
    measurement: f64,
    value_unit: string,
    measurement_uncertainty: f64,
    assay: string,
    source: string
) -> RawObservationTable with Mut {
    var out = table
    if out.count >= 128 {
        out.overflowed = true
        return out
    }

    let idx = out.count
    out.subject_ids[idx] = subject_id
    out.time_values[idx] = time_value
    out.time_units[idx] = time_unit
    out.matrices[idx] = matrix
    out.organs[idx] = organ
    out.compartments[idx] = compartment
    out.observable_ids[idx] = observable_id
    out.measurements[idx] = measurement
    out.value_units[idx] = value_unit
    out.measurement_uncertainties[idx] = measurement_uncertainty
    out.assays[idx] = assay
    out.sources[idx] = source
    out.count = idx + 1
    out
}

pub fn raw_observation_get(table: RawObservationTable, idx: usize) -> RawObservationRow with Panic {
    RawObservationRow {
        subject_id: table.subject_ids[idx],
        time_value: table.time_values[idx],
        time_unit: table.time_units[idx],
        matrix: table.matrices[idx],
        organ: table.organs[idx],
        compartment: table.compartments[idx],
        observable_id: table.observable_ids[idx],
        measurement: table.measurements[idx],
        value_unit: table.value_units[idx],
        measurement_uncertainty: table.measurement_uncertainties[idx],
        assay: table.assays[idx],
        source: table.sources[idx],
    }
}

pub struct NormalizedObservationRow {
    subject_id: string,
    simulation_condition_id: string,
    observable_id: string,
    time_h: f64,
    measurement: f64,
    measurement_uncertainty: f64,
    value_unit: string,
    matrix: string,
    organ: string,
    compartment: string,
    assay: string,
    source: string,
}

pub struct NormalizedObservationTable {
    subject_ids: [string; 128],
    simulation_condition_ids: [string; 128],
    observable_ids: [string; 128],
    times_h: [f64; 128],
    measurements: [f64; 128],
    measurement_uncertainties: [f64; 128],
    value_units: [string; 128],
    matrices: [string; 128],
    organs: [string; 128],
    compartments: [string; 128],
    assays: [string; 128],
    sources: [string; 128],
    count: usize,
    overflowed: bool,
}

pub fn normalized_observation_table_new() -> NormalizedObservationTable with Mut {
    NormalizedObservationTable {
        subject_ids: [""; 128],
        simulation_condition_ids: [""; 128],
        observable_ids: [""; 128],
        times_h: [0.0; 128],
        measurements: [0.0; 128],
        measurement_uncertainties: [0.0; 128],
        value_units: [""; 128],
        matrices: [""; 128],
        organs: [""; 128],
        compartments: [""; 128],
        assays: [""; 128],
        sources: [""; 128],
        count: 0,
        overflowed: false,
    }
}

pub fn normalized_observation_count(table: NormalizedObservationTable) -> usize {
    table.count
}

pub fn normalized_observation_table_add(
    table: NormalizedObservationTable,
    subject_id: string,
    simulation_condition_id: string,
    observable_id: string,
    time_h: f64,
    measurement: f64,
    measurement_uncertainty: f64,
    value_unit: string,
    matrix: string,
    organ: string,
    compartment: string,
    assay: string,
    source: string
) -> NormalizedObservationTable with Mut {
    var out = table
    if out.count >= 128 {
        out.overflowed = true
        return out
    }

    let idx = out.count
    out.subject_ids[idx] = subject_id
    out.simulation_condition_ids[idx] = simulation_condition_id
    out.observable_ids[idx] = observable_id
    out.times_h[idx] = time_h
    out.measurements[idx] = measurement
    out.measurement_uncertainties[idx] = measurement_uncertainty
    out.value_units[idx] = value_unit
    out.matrices[idx] = matrix
    out.organs[idx] = organ
    out.compartments[idx] = compartment
    out.assays[idx] = assay
    out.sources[idx] = source
    out.count = idx + 1
    out
}

pub fn normalized_observation_get(
    table: NormalizedObservationTable,
    idx: usize
) -> NormalizedObservationRow with Panic {
    NormalizedObservationRow {
        subject_id: table.subject_ids[idx],
        simulation_condition_id: table.simulation_condition_ids[idx],
        observable_id: table.observable_ids[idx],
        time_h: table.times_h[idx],
        measurement: table.measurements[idx],
        measurement_uncertainty: table.measurement_uncertainties[idx],
        value_unit: table.value_units[idx],
        matrix: table.matrices[idx],
        organ: table.organs[idx],
        compartment: table.compartments[idx],
        assay: table.assays[idx],
        source: table.sources[idx],
    }
}

pub fn normalized_observation_table_concat(
    left: NormalizedObservationTable,
    right: NormalizedObservationTable
) -> NormalizedObservationTable with Mut, Panic {
    var out = normalized_observation_table_new()

    var i: usize = 0
    while i < normalized_observation_count(left) {
        let row = normalized_observation_get(left, i)
        out = normalized_observation_table_add(
            out,
            row.subject_id,
            row.simulation_condition_id,
            row.observable_id,
            row.time_h,
            row.measurement,
            row.measurement_uncertainty,
            row.value_unit,
            row.matrix,
            row.organ,
            row.compartment,
            row.assay,
            row.source
        )
        i = i + 1
    }

    var j: usize = 0
    while j < normalized_observation_count(right) {
        let row = normalized_observation_get(right, j)
        out = normalized_observation_table_add(
            out,
            row.subject_id,
            row.simulation_condition_id,
            row.observable_id,
            row.time_h,
            row.measurement,
            row.measurement_uncertainty,
            row.value_unit,
            row.matrix,
            row.organ,
            row.compartment,
            row.assay,
            row.source
        )
        j = j + 1
    }

    if left.overflowed || right.overflowed {
        out.overflowed = true
    }
    out
}
