// stdlib/causal/mod.sio — Causal Inference stdlib
//
// Type-level causal inference: Pearl do-calculus with epistemic uncertainty.
// CausalEstimate carries both the point estimate and identifiability status.
//
// Submodules:
//   - core.sio:       DAG representation, do-calculus, interventions
//   - discovery.sio:  PC, FCI, and structure learning algorithms
//   - uplift.sio:     CATE learners (S/T/X-learner) with uncertainty
//   - refutation.sio: Robustness tests and sensitivity analysis

module causal

// Intervention: encodes do(variable = value)
struct Intervention {
    variable_id: i64,   // index into the causal graph node list
    value: f64,         // the assigned value
    is_active: bool,    // false = observational (no do-operator)
}

// CausalEstimate: result of a causal query with identifiability metadata
struct CausalEstimate {
    ate: f64,               // average treatment effect point estimate
    epsilon: f64,           // uncertainty bound
    identifiable: bool,     // true = ID algorithm passed; false = confounded
    intervention: Intervention,
}

// Construct an intervention do(variable = value)
fn make_intervention(var_id: i64, val: f64) -> Intervention {
    Intervention {
        variable_id: var_id,
        value: val,
        is_active: true,
    }
}

// Null intervention (observational)
fn observational_query() -> Intervention {
    Intervention {
        variable_id: -1,
        value: 0.0,
        is_active: false,
    }
}

// Naive ATE estimator: treatment_mean - control_mean
// Assumes no confounders (caller must verify identifiability).
fn naive_causal_effect(treatment_mean: f64, control_mean: f64) -> CausalEstimate {
    let ate = treatment_mean + (0.0 - control_mean)
    CausalEstimate {
        ate: ate,
        epsilon: 0.0,
        identifiable: true,
        intervention: make_intervention(0, 1.0),
    }
}

// Compute ATE with uncertainty bound (GUM propagation)
fn causal_effect_with_uncertainty(
    treatment_mean: f64,
    control_mean: f64,
    treatment_se: f64,
    control_se: f64,
) -> CausalEstimate with Div {
    let ate = treatment_mean + (0.0 - control_mean)
    // epsilon = sqrt(se_t^2 + se_c^2) — propagate in quadrature
    let var_sum = treatment_se * treatment_se + control_se * control_se
    var eps: f64 = var_sum
    var i: i64 = 0
    while i < 10 {
        eps = (eps + var_sum / eps) / 2.0
        i = i + 1
    }
    CausalEstimate {
        ate: ate,
        epsilon: eps,
        identifiable: true,
        intervention: make_intervention(0, 1.0),
    }
}

// Guard: return true if the estimate is identifiable (usable)
fn causal_estimate_is_valid(est: CausalEstimate) -> bool {
    est.identifiable
}

// Extract ATE point estimate
fn causal_ate(est: CausalEstimate) -> f64 {
    est.ate
}

// Extract uncertainty bound
fn causal_epsilon(est: CausalEstimate) -> f64 {
    est.epsilon
}
