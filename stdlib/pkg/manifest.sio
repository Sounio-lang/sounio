// stdlib/pkg/manifest.sio — Sounio package manifest types and parsing helpers
//
// A manifest describes a package: name, version, and dependencies.
// Names and dependency ids are stored as i64 hashes (djb2 of the string).
//
// Functions:
//   manifest_hash_name(name: string) -> i64
//   manifest_parse_name(name: string) -> i64        (alias — hash of name)
//   manifest_parse_version(major: i64, minor: i64, patch: i64) -> SounioManifest
//   manifest_add_dep(m: &! SounioManifest, dep_hash: i64) -> bool

// ============================================================
// djb2 hash over a string (deterministic, collision-tolerant)
// ============================================================

fn manifest_hash_name(name: string) -> i64 with Mut, Panic, Div {
    var h: i64 = 5381
    var i: i64 = 0
    let n = str_len(name)
    while i < n {
        let c = str_char_at(name, i)
        h = h * 33 + c
        i = i + 1
    }
    h
}

// ============================================================
// SounioManifest — package manifest record
// ============================================================

struct SounioManifest {
    name_hash:     i64,
    version_major: i64,
    version_minor: i64,
    version_patch: i64,
    deps_count:    i64,
    deps:          [i64; 16],   // dep name hashes
}

// ============================================================
// manifest_parse_name — hash a package name string
// ============================================================

fn manifest_parse_name(name: string) -> i64 with Mut, Panic, Div {
    manifest_hash_name(name)
}

// ============================================================
// manifest_parse_version — construct a manifest from components
// ============================================================

fn manifest_parse_version(major: i64, minor: i64, patch: i64) -> SounioManifest {
    SounioManifest {
        name_hash:     0,
        version_major: major,
        version_minor: minor,
        version_patch: patch,
        deps_count:    0,
        deps:          [0; 16],
    }
}

// ============================================================
// manifest_add_dep — append a dependency hash to a manifest
// ============================================================

fn manifest_add_dep(m: &! SounioManifest, dep_hash: i64) -> bool with Mut, Panic {
    if m.deps_count >= 16 {
        return false
    }
    m.deps[m.deps_count as usize] = dep_hash
    m.deps_count = m.deps_count + 1
    true
}
