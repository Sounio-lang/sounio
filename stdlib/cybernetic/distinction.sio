//! stdlib/cybernetic/distinction.sio
//!
//! Spencer-Brown's Laws of Form + Varela's Calculus for Self-Reference
//!
//! The primitive act of cognition is drawing a distinction — splitting
//! the world into "this" and "not-this". Everything in second-order
//! cybernetics flows from this single operation.
//!
//! Spencer-Brown (1969) formalized distinction with two axioms:
//!   Axiom 1 — Calling:  ⌐⌐ = ⌐  (marking twice = marking once)
//!   Axiom 2 — Crossing: ⌐(void) = MARKED, and crossing back = void
//!
//! Varela (1975) extended this with a third value — the autonomous
//! or self-indicating form J where J = ⌐J. This resolves self-reference
//! without paradox and is structurally identical to recursive types.
//!
//! # Example
//!
//! ```sounio
//! use cybernetic::distinction::{Form, form_mark, form_cross, form_reenter, eval_form}
//! use cybernetic::distinction::{UNMARKED, MARKED, AUTONOMOUS}
//!
//! let void = form_void()              // unmarked state
//! let m = form_mark(void)             // draw a distinction → MARKED
//! let mm = form_mark(m)               // calling: ⌐⌐ = ⌐ → MARKED
//! assert(eval_form(m) == eval_form(mm))
//!
//! let crossed = form_cross(m)         // crossing: ⌐MARKED = UNMARKED
//! assert(eval_form(crossed) == UNMARKED)
//!
//! let j = form_reenter()              // self-indicating: J = ⌐J → AUTONOMOUS
//! assert(eval_form(j) == AUTONOMOUS)
//! ```

// ============================================================================
// THE THREE VALUES (Varela 1975)
// ============================================================================

/// Unmarked state — the void, outside all distinctions
pub const UNMARKED: i64 = 0

/// Marked state — inside the distinction
pub const MARKED: i64 = 1

/// Autonomous state — self-indicating form (Varela's J)
/// Neither marked nor unmarked; the fixed point of crossing.
/// Structurally identical to mu X. cross(X) in type theory.
pub const AUTONOMOUS: i64 = 2

// ============================================================================
// FORM — Spencer-Brown expression tree
// ============================================================================

/// A Form is a node in the calculus of indications.
/// Forms compose by nesting (children inside a mark).
///
/// The empty form (no children, not marked) is the UNMARKED state.
/// A mark with no children is the MARKED state.
/// A form with is_reentrant = true is AUTONOMOUS.
pub struct Form {
    /// Current value: UNMARKED, MARKED, or AUTONOMOUS
    value: i64,

    /// Nested sub-forms (Spencer-Brown allows nesting)
    children: [i64; 8],
    child_count: i64,

    /// Nesting depth (number of marks crossed to reach this form)
    depth: i64,

    /// True if this form contains itself (re-entry)
    is_reentrant: bool,

    /// Period of oscillation in imaginary time (Spencer-Brown Ch. 11)
    /// 0 = convergent, 2 = standard crossing oscillation, higher = slower period
    period: i64,
}

// ============================================================================
// CONSTRUCTORS
// ============================================================================

/// The void — unmarked, empty, no distinction drawn
pub fn form_void() -> Form {
    Form {
        value: UNMARKED,
        children: [0; 8],
        child_count: 0,
        depth: 0,
        is_reentrant: false,
        period: 0,
    }
}

/// A mark — the simplest distinction, the MARKED state
pub fn form_marked() -> Form {
    Form {
        value: MARKED,
        children: [0; 8],
        child_count: 0,
        depth: 1,
        is_reentrant: false,
        period: 0,
    }
}

/// The self-indicating form J where J = cross(J)
/// Varela's autonomous value — the third truth value
pub fn form_reenter() -> Form {
    Form {
        value: AUTONOMOUS,
        children: [0; 8],
        child_count: 0,
        depth: 0,
        is_reentrant: true,
        period: 2,
    }
}

// ============================================================================
// AXIOMS
// ============================================================================

/// Axiom 1 — Calling (condensation): ⌐⌐ = ⌐
///
/// "The value of a call made again is the value of the call."
/// Marking something that is already marked does not change it.
/// This is the idempotent law of distinction.
pub fn form_mark(f: Form) -> Form with Mut {
    // If already marked, calling is idempotent
    if f.value == MARKED {
        return f
    }
    // If autonomous, marking preserves autonomy (re-entry absorbs marks)
    if f.value == AUTONOMOUS {
        return f
    }
    // Mark the unmarked
    Form {
        value: MARKED,
        children: f.children,
        child_count: f.child_count,
        depth: f.depth + 1,
        is_reentrant: f.is_reentrant,
        period: f.period,
    }
}

/// Axiom 2 — Crossing (cancellation): ⌐⌐ = (void)
///
/// "The value of a crossing made again is not the value of the crossing."
/// Crossing into a distinction and crossing back out returns to void.
/// Two nested marks cancel.
pub fn form_cross(f: Form) -> Form with Mut {
    // Crossing the autonomous form returns autonomous (J = ⌐J)
    if f.is_reentrant {
        return f
    }
    // Cross: toggle marked ↔ unmarked
    if f.value == MARKED {
        Form {
            value: UNMARKED,
            children: f.children,
            child_count: f.child_count,
            depth: max_i64(f.depth - 1, 0),
            is_reentrant: false,
            period: f.period,
        }
    } else if f.value == UNMARKED {
        Form {
            value: MARKED,
            children: f.children,
            child_count: f.child_count,
            depth: f.depth + 1,
            is_reentrant: false,
            period: f.period,
        }
    } else {
        // AUTONOMOUS: crossing returns autonomous
        f
    }
}

// ============================================================================
// EVALUATION
// ============================================================================

/// Evaluate a form to its canonical value.
///
/// Applies the two axioms recursively:
/// - No children, no mark → UNMARKED
/// - Mark with no children → MARKED
/// - Odd nesting depth → MARKED, even → UNMARKED
/// - Re-entrant → AUTONOMOUS
pub fn eval_form(f: Form) -> i64 {
    // Re-entrant forms are always autonomous
    if f.is_reentrant {
        return AUTONOMOUS
    }
    // Base case: use depth parity
    // Even number of crossings = UNMARKED, odd = MARKED
    if f.depth % 2 == 0 {
        UNMARKED
    } else {
        MARKED
    }
}

/// Check if two forms are equivalent under the calculus
pub fn forms_equal(a: Form, b: Form) -> bool {
    eval_form(a) == eval_form(b)
}

// ============================================================================
// OPERATIONS ON FORMS
// ============================================================================

/// Juxtaposition (OR in Boolean interpretation)
///
/// Spencer-Brown: placing two forms side by side inside a mark.
/// In the arithmetic: a,b inside a mark = mark if either is marked.
pub fn form_juxtapose(a: Form, b: Form) -> i64 {
    let va = eval_form(a)
    let vb = eval_form(b)
    // AUTONOMOUS propagates
    if va == AUTONOMOUS { return AUTONOMOUS }
    if vb == AUTONOMOUS { return AUTONOMOUS }
    // Boolean OR: marked if either is marked
    if va == MARKED { return MARKED }
    if vb == MARKED { return MARKED }
    UNMARKED
}

/// Superposition — nesting one form inside another's mark
///
/// Spencer-Brown: the mark of a is applied to b.
/// In Boolean interpretation: NOT-a OR b (implication).
pub fn form_nest(outer: Form, inner: Form) -> i64 with Mut {
    let vo = eval_form(outer)
    let vi = eval_form(inner)
    // AUTONOMOUS propagates
    if vo == AUTONOMOUS { return AUTONOMOUS }
    if vi == AUTONOMOUS { return AUTONOMOUS }
    // Nesting: cross(outer) juxtaposed with inner
    // = NOT(outer) OR inner = outer IMPLIES inner
    let crossed_outer = if vo == MARKED { UNMARKED } else { MARKED }
    if crossed_outer == MARKED { return MARKED }
    if vi == MARKED { return MARKED }
    UNMARKED
}

// ============================================================================
// SELF-REFERENCE DETECTION
// ============================================================================

/// Attempt to solve f = cross(f) iteratively.
///
/// If the iteration oscillates (MARKED → UNMARKED → MARKED → ...),
/// the form is self-referential and the result is AUTONOMOUS.
/// This implements Varela's key insight: self-reference produces
/// a third value that is neither true nor false.
pub fn solve_reentry(initial: i64, max_iter: i64) -> i64 with Mut, Div {
    var state = initial
    var prev = -1
    var oscillating = false
    var i = 0
    while i < max_iter {
        // Cross: toggle
        let next = if state == MARKED { UNMARKED } else { MARKED }
        // Check for fixed point
        if next == state {
            return state
        }
        // Check for oscillation (period-2 cycle)
        if next == prev {
            oscillating = true
            break
        }
        prev = state
        state = next
        i = i + 1
    }
    // Oscillation detected → self-referential → autonomous
    if oscillating {
        AUTONOMOUS
    } else {
        state
    }
}

/// Solve f = cross(f) and compute the oscillation period.
///
/// Similar to solve_reentry, but returns a Form with the period field
/// populated. The period is the cycle length: standard crossing oscillation
/// (MARKED ↔ UNMARKED) has period 2.
///
/// This implements Spencer-Brown's imaginary-time analysis (Ch. 11):
/// the re-entering form oscillates with a well-defined period.
pub fn solve_reentry_timed(initial: i64, max_iter: i64) -> Form with Mut, Div {
    var state = initial
    var prev = -1
    var oscillating = false
    var oscillation_start = 0i64
    var i = 0

    while i < max_iter {
        // Cross: toggle
        let next = if state == MARKED { UNMARKED } else { MARKED }

        // Check for fixed point
        if next == state {
            // Converged: period = 0
            return Form {
                value: state,
                children: [0; 8],
                child_count: 0,
                depth: 0,
                is_reentrant: false,
                period: 0,
            }
        }

        // Check for oscillation (period-2 cycle)
        if next == prev {
            oscillating = true
            oscillation_start = i
            break
        }

        prev = state
        state = next
        i = i + 1
    }

    // Oscillation detected → compute period
    if oscillating {
        // Standard crossing oscillation: period = 2
        let period = 2i64
        Form {
            value: AUTONOMOUS,
            children: [0; 8],
            child_count: 0,
            depth: 0,
            is_reentrant: true,
            period: period,
        }
    } else {
        // No oscillation found within max_iter
        Form {
            value: state,
            children: [0; 8],
            child_count: 0,
            depth: 0,
            is_reentrant: false,
            period: 0,
        }
    }
}

/// Get the period of oscillation for a form (Spencer-Brown imaginary time).
pub fn form_period(f: Form) -> i64 {
    f.period
}

// ============================================================================
// HELPERS
// ============================================================================

fn max_i64(a: i64, b: i64) -> i64 {
    if a > b { a } else { b }
}

/// Human-readable name for a form value
pub fn value_name(v: i64) -> i64 {
    // Returns: 0 = "unmarked", 1 = "marked", 2 = "autonomous"
    // (In practice, caller uses match on the constant)
    v
}
