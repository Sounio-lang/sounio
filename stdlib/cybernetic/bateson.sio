//! stdlib/cybernetic/bateson.sio
//! Bateson's Learning Levels (L0-L3)

pub struct LearningContext {
    level: i64,
    response_table: [i64; 16],
    active_param_set: i64,
    params: [f64; 64],
    param_counts: [i64; 8],
    available_sets: i64,
    meta_frame: i64,
    double_bind_count: i64,
}

pub struct LearningEvent {
    changed: bool,
    level_engaged: i64,
    context: LearningContext,
}

pub fn bateson_new() -> LearningContext {
    LearningContext {
        level: 0,
        response_table: [0; 16],
        active_param_set: 0,
        params: [0.0; 64],
        param_counts: [0; 8],
        available_sets: 255,
        meta_frame: 0,
        double_bind_count: 0,
    }
}

pub fn level_one_update(ctx: LearningContext, stimulus: i64, outcome: f64) -> LearningEvent with Mut, Div, Panic {
    var s = ctx
    let idx = s.active_param_set * 8 + (stimulus % 8)
    let old_val = s.params[idx as usize]
    s.params[idx as usize] = old_val * 0.9 + outcome * 0.1
    LearningEvent {
        changed: true,
        level_engaged: 1,
        context: s,
    }
}

pub fn level_two_switch(ctx: LearningContext, threshold: f64) -> LearningEvent with Mut, Div, Panic {
    var s = ctx
    var switched = false
    var next_set = s.active_param_set + 1
    var checked: i64 = 0

    loop {
        if checked >= 8 { break }
        if next_set >= 8 {
            next_set = 0
        }
        let bit = 1 << (next_set as i64)
        if (s.available_sets & bit) != 0 {
            s.active_param_set = next_set
            switched = true
            break
        }
        next_set = next_set + 1
        checked = checked + 1
    }

    LearningEvent {
        changed: switched,
        level_engaged: 2,
        context: s,
    }
}

pub fn detect_double_bind(ctx: LearningContext) -> bool with Div, Panic {
    ctx.available_sets == 0
}
