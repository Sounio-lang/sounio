//! stdlib/cybernetic/variety.sio
//! Ashby's Law of Requisite Variety

pub struct VarietySystem {
    env_states: [i64; 32],
    env_total: i64,
    reg_states: [i64; 32],
    reg_total: i64,
    outcome_states: [i64; 8],
    outcome_total: i64,
    env_variety: f64,
    reg_variety: f64,
    outcome_variety: f64,
}

pub fn variety_new() -> VarietySystem {
    VarietySystem {
        env_states: [0; 32],
        env_total: 0,
        reg_states: [0; 32],
        reg_total: 0,
        outcome_states: [0; 8],
        outcome_total: 0,
        env_variety: 0.0,
        reg_variety: 0.0,
        outcome_variety: 0.0,
    }
}

pub fn record_env_state(vs: VarietySystem, state: i64) -> VarietySystem with Mut, Panic {
    var s = vs
    let idx = state % 32
    s.env_states[idx as usize] = s.env_states[idx as usize] + 1
    s.env_total = s.env_total + 1
    s
}

pub fn record_reg_state(vs: VarietySystem, state: i64) -> VarietySystem with Mut, Panic {
    var s = vs
    let idx = state % 32
    s.reg_states[idx as usize] = s.reg_states[idx as usize] + 1
    s.reg_total = s.reg_total + 1
    s
}

pub fn compute_variety(vs: VarietySystem) -> VarietySystem with Mut, Div, Panic {
    var s = vs
    var env_v: f64 = 0.0
    var reg_v: f64 = 0.0
    var out_v: f64 = 0.0
    var i: i64 = 0

    i = 0
    loop {
        if i >= 32 { break }
        if s.env_states[i as usize] > 0 {
            env_v = env_v + 1.0
        }
        if s.reg_states[i as usize] > 0 {
            reg_v = reg_v + 1.0
        }
        i = i + 1
    }

    i = 0
    loop {
        if i >= 8 { break }
        if s.outcome_states[i as usize] > 0 {
            out_v = out_v + 1.0
        }
        i = i + 1
    }

    s.env_variety = env_v
    s.reg_variety = reg_v
    s.outcome_variety = out_v
    s
}

pub fn has_requisite_variety(vs: VarietySystem) -> bool with Div, Panic {
    vs.reg_variety >= vs.env_variety
}
