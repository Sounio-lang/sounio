//! stdlib/cybernetic/languaging.sio
//! Maturana's Languaging: consensual domain coordination

pub struct LanguagingPair {
    a_action_prefs: [f64; 32],
    b_action_prefs: [f64; 32],
    action_freq: [i64; 32],
    num_actions: i64,
    rounds: i64,
    consensus_count: i64,
}

pub fn languaging_new(num_actions: i64) -> LanguagingPair with Mut, Div, Panic {
    var pair = LanguagingPair {
        a_action_prefs: [0.0; 32],
        b_action_prefs: [0.0; 32],
        action_freq: [0; 32],
        num_actions: num_actions,
        rounds: 0,
        consensus_count: 0,
    }
    let init_val = 1.0 / (num_actions as f64)
    var i: i64 = 0
    loop {
        if i >= num_actions { break }
        pair.a_action_prefs[i as usize] = init_val
        pair.b_action_prefs[i as usize] = init_val
        i = i + 1
    }
    pair
}

pub fn languaging_step(pair: LanguagingPair, a_action: i64, b_action: i64) -> LanguagingPair with Mut, Panic {
    var s = pair
    let matched = a_action == b_action

    if matched {
        s.action_freq[a_action as usize] = s.action_freq[a_action as usize] + 1
        s.consensus_count = s.consensus_count + 1
    }

    let boost = if matched { 0.05 } else { 0.0 }
    s.a_action_prefs[a_action as usize] = s.a_action_prefs[a_action as usize] * 0.95 + boost
    s.b_action_prefs[b_action as usize] = s.b_action_prefs[b_action as usize] * 0.95 + boost

    s.rounds = s.rounds + 1
    s
}

pub fn has_consensual_domain(pair: LanguagingPair, threshold: i64) -> bool {
    pair.consensus_count >= threshold
}

pub fn domain_size(pair: LanguagingPair) -> i64 {
    var count: i64 = 0
    var i: i64 = 0
    loop {
        if i >= 32 { break }
        if pair.action_freq[i as usize] > 0 {
            count = count + 1
        }
        i = i + 1
    }
    count
}
