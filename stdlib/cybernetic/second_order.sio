//! stdlib/cybernetic/second_order.sio
//!
//! THE COMPOSITION LAYER — Where Second-Order Cybernetics Becomes One Theory
//!
//! The 9 modules (distinction, eigenform, observer, autopoiesis, coupling,
//! conversation, variety, bateson, languaging) are not separate theories.
//! They are aspects of ONE recursive structure:
//!
//!   An OBSERVER draws a DISTINCTION, producing an EIGENFORM.
//!   The eigenform persists through AUTOPOIETIC closure.
//!   Closure requires REQUISITE VARIETY (Ashby).
//!   Two autopoietic systems interact through STRUCTURAL COUPLING.
//!   Coupling through language is CONVERSATION (Pask).
//!   When conversation fails, LEARNING levels shift (Bateson).
//!   Coordination of coordination is LANGUAGING (Maturana).
//!   And the whole thing is observed — by an OBSERVER.
//!
//! This module wires them together.

use cybernetic::distinction::{UNMARKED, MARKED, AUTONOMOUS, Form, form_void, form_marked, form_reenter, eval_form, solve_reentry}
use cybernetic::eigenform::{EigenformResult, find_eigenform}
use cybernetic::observer::{Observer, Observation, observer_new, make_observation, blind_spot}
use cybernetic::autopoiesis::{AutopoieticSystem, is_alive}
use cybernetic::coupling::{Coupling, congruence}
use cybernetic::conversation::{Conversation, agreement, has_converged}
use cybernetic::variety::{VarietySystem, has_requisite_variety}
use cybernetic::bateson::{LearningContext, LearningEvent, learn, detect_double_bind}
use cybernetic::languaging::{LanguagingPair, domain_stability}

// ============================================================================
// CONFIGURABLE THRESHOLDS (R2: parameterized, not hardcoded)
// ============================================================================

/// Minimum coupling congruence for two systems to be "in conversation"
pub const CONVERSATION_CONGRUENCE_THRESHOLD: f64 = 0.5

/// Minimum agreement for a conversation to be considered "in conversation"
pub const CONVERSATION_AGREEMENT_THRESHOLD: f64 = 0.5

/// Agreement above this → needs only L1 learning (parameter adjustment)
pub const DIAGNOSIS_L1_THRESHOLD: f64 = 0.7

/// Agreement above this → needs L2 learning (model switch)
pub const DIAGNOSIS_L2_THRESHOLD: f64 = 0.3

/// Minimum languaging domain stability for learning to be possible
pub const LEARNING_STABILITY_THRESHOLD: f64 = 0.3

/// Eigenform variance-to-value ratio above which distinction is AUTONOMOUS
pub const BIFURCATION_RATIO: f64 = 0.5

/// Observer drift threshold above which viability is lost
pub const DRIFT_VIABILITY_LIMIT: f64 = 5.0

// ============================================================================
// BRIDGE 1: Observation → Eigenform
//
// Every eigenform search IS an observation process.
// The observer's drift accumulates during iteration.
// ============================================================================

/// Result of observing an eigenform search.
/// The eigenform value has observer-dependent uncertainty.
pub struct ObservedEigenform {
    value: f64,
    variance: f64,
    observer_drift: f64,
    iterations: i64,
    converged: bool,
}

/// Find an eigenform while tracking observer perturbation.
///
/// Each iteration is an observation: the observer's drift accumulates,
/// precision budget depletes. The returned variance includes BOTH
/// the eigenform residual AND the observer's accumulated uncertainty.
///
/// Von Foerster: "The properties of the observer shall not enter the
/// description of his observations." This function proves they ALWAYS do.
pub fn observe_eigenform(
    obs: Observer,
    op: fn(f64) -> f64,
    initial: f64,
    tolerance: f64,
    max_iter: i64
) -> ObservedEigenform with Mut, Div, Panic {
    var o = obs
    var x = initial
    var converged = false
    var residual = 1.0
    var i = 0

    while i < max_iter {
        let new_x = op(x)
        let diff = if new_x > x { new_x - x } else { x - new_x }

        // Each iteration IS an observation — observer is perturbed
        let measurement = make_observation(o, new_x, diff)
        o = measurement.observer

        if diff < tolerance {
            converged = true
            residual = diff
            break
        }
        x = new_x
        i = i + 1
    }

    // Total variance = eigenform residual + observer drift²
    let drift = blind_spot(o)
    let total_var = residual + drift * drift

    ObservedEigenform {
        value: x,
        variance: total_var,
        observer_drift: drift,
        iterations: i,
        converged: converged,
    }
}

// ============================================================================
// BRIDGE 2: Eigenform → Distinction
//
// An eigenform IS a distinction: it separates "inside the attractor"
// from "outside the attractor." Convergent = MARKED, divergent = UNMARKED,
// bifurcating = AUTONOMOUS.
// ============================================================================

/// Classify an eigenform as a Spencer-Brown form.
///
/// Convergent eigenform → MARKED (a stable distinction exists)
/// Divergent eigenform → UNMARKED (no distinction drawn)
/// Marginal eigenform (rate ≈ 1) → AUTONOMOUS (self-referential boundary)
pub fn eigenform_as_distinction(ef: ObservedEigenform) -> i64 {
    if !ef.converged {
        return UNMARKED
    }
    // If variance is very high relative to value, the distinction is unstable
    let abs_val = if ef.value > 0.0 { ef.value } else { 0.0 - ef.value }
    if abs_val > 0.001 && ef.variance > abs_val * BIFURCATION_RATIO {
        // Near bifurcation: the eigenform is self-referential
        return AUTONOMOUS
    }
    MARKED
}

// ============================================================================
// BRIDGE 3: Autopoiesis → Variety
//
// An autopoietic system can only maintain closure if it has
// requisite variety. Ashby's Law is the mathematical reason
// WHY autopoiesis is possible (or not).
// ============================================================================

/// Check if an autopoietic system has sufficient variety to survive.
///
/// Ashby's Law: the system's internal variety (number of distinct component
/// states) must exceed the environment's variety minus the outcome variety.
/// If not, the system WILL lose organizational closure.
pub struct ViabilityReport {
    alive: bool,
    has_variety: bool,
    viable: bool,
    vulnerability: f64,
}

/// Assess whether an autopoietic system is viable given its variety.
///
/// viable = alive AND has_requisite_variety
/// vulnerability = 1 - (reg_variety / env_variety)
pub fn assess_viability(sys: AutopoieticSystem, vs: VarietySystem) -> ViabilityReport with Div, Panic {
    let alive = is_alive(sys)
    let has_var = has_requisite_variety(vs)

    // Vulnerability: how close to losing requisite variety?
    let vulnerability = if vs.reg_variety > 0.001 && vs.env_variety > 0.001 {
        1.0 - vs.reg_variety / vs.env_variety
    } else {
        1.0
    }

    ViabilityReport {
        alive: alive,
        has_variety: has_var,
        viable: alive && has_var,
        vulnerability: if vulnerability < 0.0 { 0.0 } else { vulnerability },
    }
}

// ============================================================================
// BRIDGE 4: Coupling → Conversation
//
// Conversation IS structural coupling through language.
// When coupling congruence exceeds a threshold, the systems are
// "in conversation." When it drops, conversation has broken down.
// ============================================================================

/// Is this coupling a conversation?
///
/// Pask's insight: conversation = structural coupling where both
/// participants maintain models of each other. If the coupling is
/// high enough that they can predict each other, they are conversing.
pub fn coupling_is_conversation(c: Coupling, conv: Conversation) -> bool with Div, Panic {
    let cong = congruence(c)
    let agr = agreement(conv)
    // Both structural congruence AND conversational agreement must be high
    cong > CONVERSATION_CONGRUENCE_THRESHOLD && agr > CONVERSATION_AGREEMENT_THRESHOLD
}

// ============================================================================
// BRIDGE 5: Conversation failure → Bateson learning
//
// When conversation stagnates (agreement stops improving),
// the participants need to learn. Bateson's hierarchy kicks in:
// L1 (adjust parameters) → L2 (switch model) → L3 (restructure).
// ============================================================================

/// Diagnose conversation failure and prescribe learning level.
///
/// Returns: 0 = conversation is fine, 1 = needs L1, 2 = needs L2, 3 = needs L3
pub fn diagnose_conversation(conv: Conversation) -> i64 {
    if has_converged(conv) {
        return 0
    }
    let agr = agreement(conv)
    if agr > DIAGNOSIS_L1_THRESHOLD {
        // Almost there — just needs parameter adjustment (L1)
        return 1
    }
    if agr > DIAGNOSIS_L2_THRESHOLD {
        // Significant disagreement — needs model switch (L2)
        return 2
    }
    // Fundamental disagreement — needs epistemological restructuring (L3)
    3
}

// ============================================================================
// BRIDGE 6: Learning + Languaging
//
// When Bateson L2 triggers a model switch, the participants need to
// re-establish their consensual domain. Languaging is HOW they do it.
// ============================================================================

/// Is the languaging pair in a state where learning can occur?
///
/// Maturana: learning happens IN language, not separate from it.
/// If the consensual domain is unstable, learning is impossible
/// (there's no shared ground to learn from).
pub fn can_learn_in_language(pair: LanguagingPair, ctx: LearningContext) -> bool with Div, Panic {
    let stab = domain_stability(pair)
    let is_db = detect_double_bind(ctx)
    // Can learn if: domain is stable enough AND not in double bind
    stab > LEARNING_STABILITY_THRESHOLD && !is_db
}

// ============================================================================
// BRIDGE 7: The Full Loop — Observer → Distinction → Eigenform →
//   Autopoiesis → Variety → Coupling → Conversation → Learning →
//   Languaging → back to Observer
//
// This is the recursive structure of second-order cybernetics.
// ============================================================================

/// The state of a complete second-order cybernetic system.
pub struct CyberneticState {
    // What distinction has been drawn?
    distinction_value: i64,
    // What is the stable pattern (eigenform)?
    eigenform_value: f64,
    eigenform_variance: f64,
    // How much has the observer drifted?
    observer_drift: f64,
    // Is the system organizationally closed?
    is_autopoietic: bool,
    // Does it have enough variety to survive?
    is_viable: bool,
    // How well coupled are the subsystems?
    coupling_congruence: f64,
    // Have the participants reached understanding?
    conversation_agreement: f64,
    // What learning level is active?
    learning_level: i64,
    // Is there a stable consensual domain?
    languaging_stability: f64,
    // The recursive depth: how many times has the system observed itself?
    recursion_depth: i64,
}

/// Create an initial cybernetic state from observed eigenform + viability.
pub fn cybernetic_state_new(
    ef: ObservedEigenform,
    vr: ViabilityReport,
    cong: f64,
    agr: f64,
    level: i64
) -> CyberneticState {
    CyberneticState {
        distinction_value: eigenform_as_distinction(ef),
        eigenform_value: ef.value,
        eigenform_variance: ef.variance,
        observer_drift: ef.observer_drift,
        is_autopoietic: vr.alive,
        is_viable: vr.viable,
        coupling_congruence: cong,
        conversation_agreement: agr,
        learning_level: level,
        languaging_stability: 0.0,
        recursion_depth: 0,
    }
}

/// The recursive step: observe the cybernetic state itself.
///
/// This is the essence of second-order cybernetics:
/// the system can observe its own observation.
/// Each recursive step increases observer drift (you can't
/// observe yourself without perturbing yourself).
pub fn observe_self(state: CyberneticState, obs: Observer) -> CyberneticState with Mut, Div, Panic {
    var s = state

    // Observe our own eigenform value
    let measurement = make_observation(obs, s.eigenform_value, s.eigenform_variance)

    // The observation changes what we know
    s.eigenform_variance = measurement.variance
    s.observer_drift = blind_spot(measurement.observer)

    // Re-evaluate the distinction based on new uncertainty
    let ef = ObservedEigenform {
        value: s.eigenform_value,
        variance: s.eigenform_variance,
        observer_drift: s.observer_drift,
        iterations: 0,
        converged: s.eigenform_variance < 1.0,
    }
    s.distinction_value = eigenform_as_distinction(ef)

    // Viability may have changed (observer drift affects regulation)
    if s.observer_drift > DRIFT_VIABILITY_LIMIT {
        s.is_viable = false
    }

    s.recursion_depth = s.recursion_depth + 1
    s
}
