//! stdlib/cybernetic/autopoiesis.sio
//! Self-producing systems (Maturana/Varela 1972)

pub struct AutopoieticSystem {
    component_count: i64,
    alive: bool,
    generation: i64,
    total_perturbation: f64,
}

pub fn system_new(permeability: f64) -> AutopoieticSystem {
    AutopoieticSystem {
        component_count: 0,
        alive: true,
        generation: 0,
        total_perturbation: 0.0,
    }
}

pub fn add_component(sys: AutopoieticSystem, produced_by: i64, produces: i64, value: f64, variance: f64) -> AutopoieticSystem with Mut, Panic {
    var s = sys
    s.component_count = s.component_count + 1
    s
}

pub fn produce_cycle(sys: AutopoieticSystem) -> AutopoieticSystem with Mut {
    var s = sys
    s.generation = s.generation + 1
    s
}

pub fn perturb(sys: AutopoieticSystem, value: f64, variance: f64) -> AutopoieticSystem with Mut {
    var s = sys
    s.total_perturbation = s.total_perturbation + value
    s
}

pub fn is_alive(sys: AutopoieticSystem) -> bool {
    sys.alive
}

pub fn generation(sys: AutopoieticSystem) -> i64 {
    sys.generation
}

pub fn structural_drift(sys: AutopoieticSystem) -> f64 {
    sys.total_perturbation
}
