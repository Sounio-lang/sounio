//! stdlib/cybernetic/psychiatry.sio
//!
//! Computational Psychiatry through Second-Order Cybernetics
//!
//! This module bridges nine cybernetic frameworks to psychiatric phenomena.
//! Unlike first-order computational psychiatry (active inference, RL models),
//! this approach includes the observer (therapist) as part of the system,
//! models metacognition as self-observation with measurable cost, and
//! formalizes treatment resistance as a computable property.
//!
//! Theoretical basis:
//! - Bateson (1972): Double bind theory of schizophrenia
//! - Maturana (1988): Autopoietic view of cognition
//! - von Foerster (1981): Observer-inclusion in therapeutic systems
//! - Ashby (1956): Variety as regulatory capacity (anxiety model)
//! - Pask (1975): Therapeutic alliance as conversation

// ============================================================================
// CLINICAL STATE — The patient as a cybernetic system
// ============================================================================

/// A patient modeled as an autopoietic cognitive system.
///
/// The key insight: mental health IS organizational closure.
/// The cognitive-emotional production network must form cycles
/// (thoughts produce emotions produce behaviors produce thoughts).
/// When cycles break, the system loses coherence.
pub struct ClinicalState {
    // Autopoietic core: cognitive production network
    // 8x8 adjacency matrix (flattened): cognitive process relations
    // Processes: 0=perception, 1=appraisal, 2=emotion, 3=memory,
    //            4=planning, 5=action, 6=self_model, 7=social_model
    relations: [i64; 64],
    process_active: [i64; 8],
    process_values: [f64; 8],
    process_variances: [f64; 8],
    component_count: i64,

    // Observer state: the patient's self-observation capacity
    metacognitive_drift: f64,
    metacognitive_budget: f64,
    initial_budget: f64,
    observation_count: i64,

    // Variety: regulatory capacity
    env_states_seen: i64,
    reg_states_available: i64,
    coping_strategies: i64,

    // Learning state (Bateson)
    learning_level: i64,
    l1_failures: i64,
    l2_switches: i64,
    l3_restructures: i64,
    is_double_bound: bool,

    // Conversation state: therapeutic alliance
    alliance_agreement: f64,
    alliance_rounds: i64,
    trust_weight: f64,

    // Global
    alive: bool,
    generation: i64,
    structural_drift: f64,
}

// ============================================================================
// DIAGNOSTIC ASSESSMENTS — Computable psychiatric constructs
// ============================================================================

/// Anxiety as insufficient variety (Ashby 1956).
///
/// The patient cannot regulate environmental complexity because their
/// internal variety (coping strategies, cognitive flexibility) is
/// less than the environment demands. This is Ashby's Law applied
/// to psychopathology: H(coping) < H(environment) - H(desired_outcomes).
///
/// Returns the variety deficit. Negative = anxious (insufficient variety).
pub fn anxiety_deficit(state: ClinicalState) -> f64 with Mut, Div, Panic {
    // Variety = log2(distinct_states)
    let env_var = log2_approx_int(state.env_states_seen)
    let reg_var = log2_approx_int(state.reg_states_available)
    // Assume 2 desired outcomes (well/unwell)
    let outcome_var = 1.0
    // Ashby deficit: reg_var - (env_var - outcome_var)
    reg_var - (env_var - outcome_var)
}

/// Treatment resistance as observer drift ratio.
///
/// When the therapist's observations perturb the patient faster than
/// trust can build, the therapeutic system diverges. This is measurable:
/// resistance = metacognitive_drift / trust_weight.
///
/// High resistance means the patient's self-model is destabilized by
/// each therapeutic intervention faster than rapport compensates.
pub fn treatment_resistance(state: ClinicalState) -> f64 with Div, Panic {
    if state.trust_weight < 0.001 {
        return 100.0
    }
    state.metacognitive_drift / state.trust_weight
}

/// Metacognitive capacity as precision remaining.
///
/// The patient's ability to observe their own cognitive processes
/// degrades with each observation (von Foerster). When budget is
/// exhausted, self-monitoring becomes unreliable — a computational
/// model of metacognitive dysfunction in psychosis.
pub fn metacognitive_capacity(state: ClinicalState) -> f64 with Div, Panic {
    if state.initial_budget < 0.001 {
        return 0.0
    }
    state.metacognitive_budget / state.initial_budget
}

/// Symptom rigidity as failed eigenform convergence.
///
/// A healthy self-model is an eigenform: Op(self) = self.
/// When the operator (cognitive appraisal loop) fails to converge,
/// the self-model is unstable — experienced as identity disturbance,
/// depersonalization, or chronic self-doubt.
///
/// Returns: residual of self-model operator. Low = stable. High = rigid/unstable.
pub fn self_model_residual(state: ClinicalState) -> f64 with Div, Panic {
    // Self-model is process 6; its variance reflects instability
    let self_val = state.process_values[6]
    let self_var = state.process_variances[6]
    // Residual = sqrt(variance) / |value| — coefficient of variation
    if abs_f64(self_val) < 0.001 {
        return self_var
    }
    sqrt_f64(self_var) / abs_f64(self_val)
}

/// Check organizational closure of the cognitive network.
///
/// Mental health requires that the cognitive production network
/// forms at least one cycle. A linear chain (perception → emotion
/// with no feedback) is not autopoietic — the system cannot
/// self-maintain.
///
/// Returns true if the active cognitive processes form a cycle.
pub fn has_cognitive_closure(state: ClinicalState) -> bool with Mut, Div, Panic {
    // DFS cycle detection on the 8x8 relations matrix
    var visited: [i64; 8] = [0; 8]
    var on_stack: [i64; 8] = [0; 8]
    var stack: [i64; 16] = [0; 16]

    var start = 0
    while start < 8 {
        if state.process_active[start] == 0 {
            start = start + 1
            continue
        }
        if visited[start] != 0 {
            start = start + 1
            continue
        }

        // Iterative DFS from this node
        var sp = 0
        stack[sp] = start
        sp = sp + 1
        visited[start] = 1
        on_stack[start] = 1

        while sp > 0 {
            let node = stack[sp - 1]
            var found_unvisited = false

            var neighbor = 0
            while neighbor < 8 {
                if state.relations[node * 8 + neighbor] != 0 {
                    if state.process_active[neighbor] != 0 {
                        if on_stack[neighbor] != 0 {
                            // Back edge → cycle → closure
                            return true
                        }
                        if visited[neighbor] == 0 {
                            visited[neighbor] = 1
                            on_stack[neighbor] = 1
                            stack[sp] = neighbor
                            sp = sp + 1
                            found_unvisited = true
                            break
                        }
                    }
                }
                neighbor = neighbor + 1
            }

            if !found_unvisited {
                sp = sp - 1
                on_stack[node] = 0
            }
        }

        start = start + 1
    }
    false
}

// ============================================================================
// THERAPEUTIC INTERVENTIONS — Computable treatment operations
// ============================================================================

/// Model a single therapeutic round as a Pask conversation step.
///
/// The therapist observes the patient (accumulating drift in both),
/// updates their model of the patient, and the patient updates their
/// model of the therapist. Trust increases with agreement history.
///
/// Returns updated clinical state with new alliance metrics.
pub fn therapeutic_round(
    state: ClinicalState,
    therapist_observation: f64,
    therapist_variance: f64
) -> ClinicalState with Mut, Div, Panic {
    var s = state

    // Precision-weighted Bayesian update of alliance
    let patient_val = s.process_values[6]
    let patient_var = s.process_variances[6]

    // Adaptive trust (Pask): weight increases with agreement
    s.trust_weight = 0.1 + 0.4 * s.alliance_agreement

    // Patient updates self-model toward therapist's observation
    let w = s.trust_weight
    let new_val = (1.0 - w) * patient_val + w * therapist_observation
    let new_var = (1.0 - w) * (1.0 - w) * patient_var + w * w * therapist_variance

    s.process_values[6] = new_val
    s.process_variances[6] = new_var

    // Therapist observation perturbs patient's metacognition
    s.metacognitive_drift = s.metacognitive_drift + 0.01
    s.metacognitive_budget = s.metacognitive_budget - therapist_variance
    if s.metacognitive_budget < 0.0 {
        s.metacognitive_budget = 0.0
    }
    s.observation_count = s.observation_count + 1

    // Update agreement (how close patient and therapist models are)
    let diff = abs_f64(new_val - therapist_observation)
    let combined_std = sqrt_f64(new_var + therapist_variance)
    if combined_std > 0.001 {
        let z = diff / combined_std
        s.alliance_agreement = if z < 0.5 { 0.9 } else if z < 1.0 { 0.7 } else if z < 2.0 { 0.4 } else { 0.1 }
    }
    s.alliance_rounds = s.alliance_rounds + 1

    s
}

/// Bateson learning intervention.
///
/// When the therapeutic conversation stalls, the therapist
/// escalates the learning level:
/// - L1: Adjust parameters (cognitive restructuring)
/// - L2: Switch model class (change therapeutic modality)
/// - L3: Restructure epistemological frame (existential intervention)
///
/// Returns updated state with learning level change.
pub fn learning_intervention(
    state: ClinicalState,
    stimulus: i64,
    reward: f64
) -> ClinicalState with Mut, Div, Panic {
    var s = state

    // Try L1 first (parameter adjustment within current model)
    if s.learning_level < 2 {
        s.learning_level = 1
        // Update the cognitive parameter for the stimulus
        if stimulus >= 0 {
            if stimulus < 8 {
                let old = s.process_values[stimulus]
                let alpha = 0.1
                s.process_values[stimulus] = (1.0 - alpha) * old + alpha * reward
            }
        }

        // Check if L1 is working (reward should be improving)
        if reward < 0.3 {
            s.l1_failures = s.l1_failures + 1
        } else {
            s.l1_failures = 0
        }

        // Escalate to L2 if L1 stagnates
        if s.l1_failures > 3 {
            s.learning_level = 2
            s.l2_switches = s.l2_switches + 1
        }
    } else if s.learning_level == 2 {
        // L2: switch model class
        s.l2_switches = s.l2_switches + 1

        // If L2 exhausted, escalate to L3
        if s.l2_switches > 5 {
            s.learning_level = 3
            s.l3_restructures = s.l3_restructures + 1
            // L3 resets all parameters (epistemological restructure)
            var i = 0
            while i < 8 {
                s.process_values[i] = 0.0
                s.process_variances[i] = 1.0
                i = i + 1
            }
        }
    }

    // Double bind detection
    s.is_double_bound = s.l1_failures > 3 && s.l2_switches > 5 && s.l3_restructures > 2

    s.generation = s.generation + 1
    s
}

/// Activate a cognitive production relation.
///
/// Establishes that process `from` produces/enables process `to`.
/// E.g., activate_relation(state, 0, 2) = "perception produces emotion"
pub fn activate_relation(state: ClinicalState, from: i64, to: i64) -> ClinicalState with Mut, Panic {
    var s = state
    if from >= 0 {
        if from < 8 {
            if to >= 0 {
                if to < 8 {
                    s.relations[from * 8 + to] = 1
                    s.process_active[from] = 1
                    s.process_active[to] = 1
                    s.component_count = s.component_count + 1
                }
            }
        }
    }
    s
}

/// Deactivate a cognitive process (models process disruption).
///
/// When a process is deactivated, its production relations remain
/// (organization unchanged) but it no longer participates in cycles.
/// If this breaks organizational closure, the system is no longer
/// autopoietic — modeling acute decompensation.
pub fn deactivate_process(state: ClinicalState, process: i64) -> ClinicalState with Mut, Div, Panic {
    var s = state
    if process >= 0 {
        if process < 8 {
            s.process_active[process] = 0
            // Check if closure is maintained
            s.alive = has_cognitive_closure(s)
        }
    }
    s
}

// ============================================================================
// CONSTRUCTORS
// ============================================================================

/// Create a new clinical state with default healthy parameters.
pub fn clinical_state_new() -> ClinicalState {
    ClinicalState {
        relations: [0; 64],
        process_active: [0; 8],
        process_values: [0.0; 8],
        process_variances: [1.0; 8],
        component_count: 0,
        metacognitive_drift: 0.0,
        metacognitive_budget: 100.0,
        initial_budget: 100.0,
        observation_count: 0,
        env_states_seen: 6,
        reg_states_available: 8,
        coping_strategies: 5,
        learning_level: 0,
        l1_failures: 0,
        l2_switches: 0,
        l3_restructures: 0,
        is_double_bound: false,
        alliance_agreement: 0.0,
        alliance_rounds: 0,
        trust_weight: 0.1,
        alive: false,
        generation: 0,
        structural_drift: 0.0,
    }
}

/// Build a healthy cognitive network with standard production cycles.
///
/// perception → appraisal → emotion → memory → planning → action → perception
/// Plus: self_model ↔ social_model (bidirectional)
/// Plus: emotion → self_model (emotional self-awareness)
pub fn healthy_network() -> ClinicalState with Mut, Div, Panic {
    var s = clinical_state_new()
    // Main cognitive loop
    s = activate_relation(s, 0, 1)  // perception → appraisal
    s = activate_relation(s, 1, 2)  // appraisal → emotion
    s = activate_relation(s, 2, 3)  // emotion → memory
    s = activate_relation(s, 3, 4)  // memory → planning
    s = activate_relation(s, 4, 5)  // planning → action
    s = activate_relation(s, 5, 0)  // action → perception (CLOSURE)

    // Self-awareness loops
    s = activate_relation(s, 2, 6)  // emotion → self_model
    s = activate_relation(s, 6, 7)  // self_model → social_model
    s = activate_relation(s, 7, 6)  // social_model → self_model

    // Set healthy initial values
    var i = 0
    while i < 8 {
        s.process_values[i] = 50.0
        s.process_variances[i] = 1.0
        i = i + 1
    }

    s.alive = has_cognitive_closure(s)
    s
}

// ============================================================================
// CLINICAL SCENARIOS — Computable psychopathology
// ============================================================================

/// Model anxiety disorder: reduce regulatory variety below environmental demand.
pub fn induce_anxiety(state: ClinicalState) -> ClinicalState with Mut, Div, Panic {
    var s = state
    s.reg_states_available = 2    // Only 2 coping strategies
    s.env_states_seen = 10        // But environment demands 10
    s.coping_strategies = 2
    s
}

/// Model depressive episode: increase metacognitive cost of self-observation.
///
/// Depression as rumination: the patient observes themselves observing
/// themselves, each layer adding drift. The metacognitive budget is
/// consumed by excessive self-monitoring.
pub fn induce_rumination(state: ClinicalState, intensity: i64) -> ClinicalState with Mut, Div, Panic {
    var s = state
    var i = 0
    while i < intensity {
        // Each rumination cycle consumes budget and adds drift
        s.metacognitive_drift = s.metacognitive_drift + 0.05
        s.metacognitive_budget = s.metacognitive_budget - 2.0
        if s.metacognitive_budget < 0.0 {
            s.metacognitive_budget = 0.0
        }
        s.observation_count = s.observation_count + 1
        i = i + 1
    }
    s
}

/// Model dissociation: deactivate self-model process.
///
/// Dissociation as loss of the self-observation loop.
/// Process 6 (self_model) goes offline; the patient can still
/// perceive and act but cannot model themselves doing so.
pub fn induce_dissociation(state: ClinicalState) -> ClinicalState with Mut, Div, Panic {
    deactivate_process(state, 6)
}

// ============================================================================
// HELPERS
// ============================================================================

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn sqrt_f64(x: f64) -> f64 {
    if x <= 0.0 { return 0.0 }
    var y = x
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y
}

fn log2_approx_int(n: i64) -> f64 with Mut, Div, Panic {
    if n <= 1 { return 0.0 }
    let x = n as f64
    // ln(x) via argument reduction + Taylor
    var val = x
    var k = 0.0
    while val > 2.0 {
        val = val / 2.0
        k = k + 1.0
    }
    // ln(val) for val in [1, 2] via series: ln(1+t) ≈ t - t²/2 + t³/3
    let t = val - 1.0
    let ln_val = t - t * t / 2.0 + t * t * t / 3.0 - t * t * t * t / 4.0
    let ln_x = ln_val + k * 0.693147
    // log2(x) = ln(x) / ln(2)
    ln_x / 0.693147
}
