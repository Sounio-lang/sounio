//! stdlib/cybernetic/conversation.sio
//! Pask's conversation theory: dual modeling with Bayesian updates

pub struct Conversation {
    p_id: i64,
    q_id: i64,
    topic_id: i64,
    p_value: f64,
    p_variance: f64,
    q_value: f64,
    q_variance: f64,
    p_model_of_q: f64,
    q_model_of_p: f64,
    agreement_value: f64,
    rounds: i64,
    converged: bool,
    convergence_threshold: f64,
}

pub fn conversation_new(p_id: i64, q_id: i64, topic_id: i64) -> Conversation {
    Conversation {
        p_id: p_id,
        q_id: q_id,
        topic_id: topic_id,
        p_value: 0.0,
        p_variance: 1.0,
        q_value: 0.0,
        q_variance: 1.0,
        p_model_of_q: 0.0,
        q_model_of_p: 0.0,
        agreement_value: 0.0,
        rounds: 0,
        converged: false,
        convergence_threshold: 0.01,
    }
}

pub fn set_models(conv: Conversation, p_val: f64, p_var: f64, q_val: f64, q_var: f64) -> Conversation with Mut {
    var s = conv
    s.p_value = p_val
    s.p_variance = p_var
    s.q_value = q_val
    s.q_variance = q_var
    s.p_model_of_q = q_val
    s.q_model_of_p = p_val
    s
}

pub fn converse(conv: Conversation) -> Conversation with Mut, Div, Panic {
    var s = conv

    let p_prec = 1.0 / s.p_variance
    let q_prec = 1.0 / s.q_variance
    let total_prec = p_prec + q_prec

    let p_new = (s.p_value * p_prec + s.q_value * q_prec) / total_prec
    let q_new = (s.q_value * q_prec + s.p_value * p_prec) / total_prec

    s.p_value = p_new
    s.q_value = q_new

    s.p_model_of_q = s.q_value
    s.q_model_of_p = s.p_value

    let diff = s.p_value - s.q_value
    let abs_diff = if diff > 0.0 { diff } else { 0.0 - diff }

    let abs_p = if s.p_value > 0.0 { s.p_value } else { 0.0 - s.p_value }
    let abs_q = if s.q_value > 0.0 { s.q_value } else { 0.0 - s.q_value }
    var denom = 0.001
    if abs_p > denom {
        denom = abs_p
    }
    if abs_q > denom {
        denom = abs_q
    }

    s.agreement_value = 1.0 - abs_diff / denom
    s.converged = abs_diff < s.convergence_threshold
    s.rounds = s.rounds + 1
    s
}

pub fn agreement(conv: Conversation) -> f64 {
    conv.agreement_value
}

pub fn has_converged(conv: Conversation) -> bool {
    conv.converged
}

pub fn shared_understanding(conv: Conversation) -> f64 with Div, Panic {
    (conv.p_value + conv.q_value) / 2.0
}
