// stdlib/fractal/kec.sio
//
// Kolmogorov Entropy Complexity measures — Sounio
//
// Shannon entropy, box-counting dimension, and related complexity metrics
// for fractal analysis on discrete data.

// ============================================================================
// Helpers
// ============================================================================

fn kec_abs(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn kec_ln(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return -50.0 }
    var v = x
    var adjust = 0.0
    while v > 2.0 {
        v = v / 2.0
        adjust = adjust + 0.6931471805599453
    }
    while v < 0.5 {
        v = v * 2.0
        adjust = adjust - 0.6931471805599453
    }
    let u = (v - 1.0) / (v + 1.0)
    let u2 = u * u
    var term = u
    var sum = u
    var k = 1
    while k <= 20 {
        term = term * u2
        sum = sum + term / (2 * k + 1) as f64
        k = k + 1
    }
    2.0 * sum + adjust
}

fn kec_log2(x: f64) -> f64 with Mut, Div, Panic {
    kec_ln(x) / 0.6931471805599453
}

fn kec_floor_i32(x: f64) -> i32 {
    var r = x as i32
    if r as f64 > x { r = r - 1 }
    r
}

// ============================================================================
// Shannon entropy of a discrete distribution
// data: values, n: count, n_bins: number of histogram bins
// H = -sum(p_i * log2(p_i)) for p_i > 0
// ============================================================================

fn kec_shannon_entropy(data: &[f64; 256], n: i32, n_bins: i32) -> f64 with Mut, Div, Panic {
    if n <= 0 { return 0.0 }
    if n_bins <= 0 { return 0.0 }

    var bins_count = n_bins
    if bins_count > 128 { bins_count = 128 }

    // Find min and max
    var min_val = data[0]
    var max_val = data[0]
    var i = 1
    while i < n {
        if data[i] < min_val { min_val = data[i] }
        if data[i] > max_val { max_val = data[i] }
        i = i + 1
    }

    let range = max_val - min_val
    if range < 1.0e-15 { return 0.0 }

    // Build histogram
    var counts: [i32; 128] = [0; 128]
    i = 0
    while i < n {
        var bin = kec_floor_i32((data[i] - min_val) / range * bins_count as f64)
        if bin >= bins_count { bin = bins_count - 1 }
        if bin < 0 { bin = 0 }
        counts[bin] = counts[bin] + 1
        i = i + 1
    }

    // Compute entropy
    var entropy = 0.0
    var b = 0
    while b < bins_count {
        if counts[b] > 0 {
            let p = counts[b] as f64 / n as f64
            entropy = entropy - p * kec_log2(p)
        }
        b = b + 1
    }

    entropy
}

// ============================================================================
// Box-counting dimension estimate
// For 1D data, tile with boxes of side epsilon, count non-empty boxes.
// D = lim(log(N(eps)) / log(1/eps)) as eps -> 0
// We estimate using two scales.
// ============================================================================

fn kec_box_count_at_scale(data: &[f64; 256], n: i32, epsilon: f64, min_val: f64) -> i32 with Mut, Div, Panic {
    if epsilon < 1.0e-15 { return 0 }
    // Count distinct boxes occupied
    // Box index for data[i] = floor((data[i] - min) / epsilon)
    // Use a simple array to track unique boxes (max 128)
    var boxes: [i32; 128] = [-1; 128]
    var n_boxes = 0

    var i = 0
    while i < n {
        let box_idx = kec_floor_i32((data[i] - min_val) / epsilon)
        // Check if already seen
        var found = false
        var j = 0
        while j < n_boxes {
            if boxes[j] == box_idx { found = true }
            j = j + 1
        }
        if !found && n_boxes < 128 {
            boxes[n_boxes] = box_idx
            n_boxes = n_boxes + 1
        }
        i = i + 1
    }
    n_boxes
}

fn kec_box_counting_dim(data: &[f64; 256], n: i32) -> f64 with Mut, Div, Panic {
    if n < 2 { return 0.0 }

    // Find range
    var min_val = data[0]
    var max_val = data[0]
    var i = 1
    while i < n {
        if data[i] < min_val { min_val = data[i] }
        if data[i] > max_val { max_val = data[i] }
        i = i + 1
    }
    let range = max_val - min_val
    if range < 1.0e-15 { return 0.0 }

    // Two scales for linear regression: eps1 = range/4, eps2 = range/16
    let eps1 = range / 4.0
    let eps2 = range / 16.0

    let n1 = kec_box_count_at_scale(data, n, eps1, min_val)
    let n2 = kec_box_count_at_scale(data, n, eps2, min_val)

    if n1 <= 0 { return 0.0 }
    if n2 <= 0 { return 0.0 }

    // D ≈ (log(N2) - log(N1)) / (log(1/eps2) - log(1/eps1))
    //   = (log(N2) - log(N1)) / (log(eps1) - log(eps2))
    let log_n1 = kec_ln(n1 as f64)
    let log_n2 = kec_ln(n2 as f64)
    let log_e1 = kec_ln(eps1)
    let log_e2 = kec_ln(eps2)

    let denom = log_e1 - log_e2
    if kec_abs(denom) < 1.0e-15 { return 0.0 }

    (log_n2 - log_n1) / denom
}

// ============================================================================
// Approximate entropy (ApEn)
// Measures regularity/complexity in time series
// ============================================================================

fn kec_approx_entropy(data: &[f64; 256], n: i32, m: i32, r_tol: f64) -> f64 with Mut, Div, Panic {
    // ApEn(m, r) = phi(m) - phi(m+1)
    // phi(k) = (1/N-k+1) * sum(log(C_i^k(r)))
    // Simplified: count pairs within tolerance
    if n < m + 1 { return 0.0 }

    // Count matches for template length m
    var phi_m = 0.0
    var nm = n - m + 1
    var i = 0
    while i < nm {
        var count = 0
        var j = 0
        while j < nm {
            // Check if templates match within r_tol
            var match_ok = true
            var k = 0
            while k < m {
                if kec_abs(data[i + k] - data[j + k]) > r_tol {
                    match_ok = false
                }
                k = k + 1
            }
            if match_ok { count = count + 1 }
            j = j + 1
        }
        if count > 0 {
            phi_m = phi_m + kec_ln(count as f64 / nm as f64)
        }
        i = i + 1
    }
    phi_m = phi_m / nm as f64

    // Count matches for template length m+1
    var phi_m1 = 0.0
    let nm1 = n - m
    if nm1 <= 0 { return 0.0 }
    i = 0
    while i < nm1 {
        var count = 0
        var j = 0
        while j < nm1 {
            var match_ok = true
            var k = 0
            while k < m + 1 {
                if kec_abs(data[i + k] - data[j + k]) > r_tol {
                    match_ok = false
                }
                k = k + 1
            }
            if match_ok { count = count + 1 }
            j = j + 1
        }
        if count > 0 {
            phi_m1 = phi_m1 + kec_ln(count as f64 / nm1 as f64)
        }
        i = i + 1
    }
    phi_m1 = phi_m1 / nm1 as f64

    phi_m - phi_m1
}

// ============================================================================
// Tests
// ============================================================================

fn test_shannon_uniform() -> bool with Mut, Div, Panic {
    // Uniform distribution over [0,1]: max entropy ~ log2(n_bins)
    var data: [f64; 256] = [0.0; 256]
    var i = 0
    while i < 100 {
        data[i] = i as f64 / 100.0
        i = i + 1
    }
    let h = kec_shannon_entropy(&data, 100, 10)
    // Should be near log2(10) ≈ 3.32 for uniform
    h > 2.5 && h < 3.5
}

fn test_shannon_constant() -> bool with Mut, Div, Panic {
    // All same value: entropy = 0
    var data: [f64; 256] = [0.0; 256]
    var i = 0
    while i < 50 {
        data[i] = 5.0
        i = i + 1
    }
    let h = kec_shannon_entropy(&data, 50, 10)
    kec_abs(h) < 0.01
}

fn test_box_counting_points() -> bool with Mut, Div, Panic {
    // Linear data should have dimension ~ 1
    var data: [f64; 256] = [0.0; 256]
    var i = 0
    while i < 64 {
        data[i] = i as f64
        i = i + 1
    }
    let d = kec_box_counting_dim(&data, 64)
    // Should be near 1.0 for linear data
    d > 0.5 && d < 1.5
}

fn test_approx_entropy_periodic() -> bool with Mut, Div, Panic {
    // Periodic signal: low complexity
    var data: [f64; 256] = [0.0; 256]
    var i = 0
    while i < 20 {
        // Alternating 0, 1
        if i % 2 == 0 { data[i] = 0.0 } else { data[i] = 1.0 }
        i = i + 1
    }
    let apen = kec_approx_entropy(&data, 20, 2, 0.5)
    // Low ApEn for periodic signals
    apen >= 0.0
}
