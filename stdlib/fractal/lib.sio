// fractal — Fractal analysis, sedenion Mandelbrot, and biomaterial characterization
//
// Fractal dimension estimation, multifractal spectra, entropy measures,
// curvature computation, lacunarity, and sedenion Mandelbrot orbits with
// Jacobian/Hessian recursions for the FSNN architecture.
//
// Submodules:
//   dimension         — Box-counting and Higuchi fractal dimension
//   multifractal      — Multifractal spectrum, generalized dimensions
//   entropy           — Shannon, Renyi, sample, approximate, permutation entropy
//   curvature         — Gaussian/mean/principal curvature from triangle meshes
//   hessian_curvature — Curvature feature extraction from sedenion Hessian tensor
//   lacunarity        — Lacunarity (gappiness) analysis for voxel grids
//   kec               — KEC framework: entropy-curvature-coherence for biomaterials
//   mandelbrot        — Sedenion Mandelbrot orbit with Jacobian + Hessian recursions
//   fsnn              — Fractal Sedenionic Neural Network feature extraction
//   zero_divisor      — Zero-divisor sampling, proximity, and basis pair enumeration

pub use dimension::{
    FractalDimensionResult,
    box_counting_dimension, higuchi_dimension,
}

pub use multifractal::{
    MultifractalSpectrum, MeasureGrid,
    multifractal_spectrum, generalized_dimension,
    is_multifractal, capacity_dimension, information_dimension, correlation_dimension,
}

pub use entropy::{
    EntropyResult,
    shannon_entropy, renyi_entropy, sample_entropy, approximate_entropy, permutation_entropy,
}

pub use curvature::{
    Vertex, Face, TriMesh, CurvatureResult,
    gaussian_curvature, mean_curvature, principal_curvatures,
}

pub use hessian_curvature::{
    CurvatureFeatures,
    contract_hessian, extract_curvature_features, print_curvature_features,
}

pub use lacunarity::{
    LacunarityValue, LacunarityResult, VoxelGrid,
    lacunarity,
}

pub use kec::{
    PHI, PI,
    KECParams, KECMetrics, VoxelScaffold,
    kec_params_default, kec_params_bone,
    compute_kec, kec_is_optimal,
}

pub use mandelbrot::{
    OrbitConfig, OrbitResult,
    orbit_config_default, compute_orbit,
}

pub use fsnn::{
    FSNNFeatures,
    fsnn_forward, fsnn_extract_features,
    fsnn_features_to_array, fsnn_features_from_array,
    fsnn_stat_mean, fsnn_stat_std, fsnn_stat_skewness, fsnn_stat_kurtosis,
}

pub use zero_divisor::{
    zd_sample, zd_proximity, zd_moreno_proximity,
    zd_enumerate_basis_pairs_count,
}
