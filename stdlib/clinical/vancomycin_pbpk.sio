// stdlib/clinical/vancomycin_pbpk.sio
//
// Vancomycin 2-compartment PBPK with Knightian-uncertainty inputs.
//
// Pipeline:
//   PK params (Vc, CL, Vp, Q)  --lift-->  Knightian PBoxes
//   --steady-state Cmin formula-->        Knightian Cmin PBox
//   --within(10, 20) gate-->              {SAFE, REFUSE}
//
// References:
//   Rybak MJ et al. Am J Health-Syst Pharm 2020;77:835. (ASHP guideline.)
//   Roberts JA et al. Antimicrob Agents Chemother 2011;55:2855.
//   Marsot et al. Clin Pharmacokinet 2012;51:1-13. (popPK review.)
//
// Refinement-type-style contracts (currently enforced at runtime):
//   dose_mg     in (0, 4000]
//   interval_h  in [4, 48]
//   weight_kg   in [30, 200]
//   crcl_ml_min in (0, 200]
// Each violation produces a vacuous PBox with confidence 0 (REFUSE).
//
// Lean export: formal/proof_obligations/vancomycin_dosing_safety.lean

use epistemic::knightian::*

// ============================================================================
// PK PARAMETERS — population values from Roberts 2011 ICU cohort
// ============================================================================

pub struct VancoPKParams {
    vc_l: f64,          // central volume (L)
    cl_l_per_h: f64,    // total clearance (L/h)
    vp_l: f64,          // peripheral volume (L)
    q_l_per_h: f64,     // intercompartmental clearance (L/h)
}

pub fn vp_default(weight_kg: f64, crcl_ml_min: f64) -> VancoPKParams {
    // Vc ≈ 0.5 L/kg
    let vc = 0.5 * weight_kg
    // CL (L/h) ≈ 0.05 * CrCl (mL/min) — Cockcroft-Gault scaled
    let cl = 0.05 * crcl_ml_min
    // Vp ≈ 0.5 L/kg
    let vp = 0.5 * weight_kg
    // Q ≈ 7 L/h (adult ICU)
    let q = 7.0
    VancoPKParams { vc_l: vc, cl_l_per_h: cl, vp_l: vp, q_l_per_h: q }
}

// ============================================================================
// LIFT params -> PBox with Knightian bands.
// The bands reflect literature uncertainty in popPK estimates.
// ============================================================================

// Band widths parametric on number of TDM samples observed.
// 0 samples (pre-TDM):    Vc ±15%, CL ±25% (literature popPK)
// 1+ samples:             Vc ±10%, CL ±10% (Bayesian narrowing)
// 3+ samples:             Vc ±7%,  CL ±7%  (post-TDM convergence)
fn vp_band_vc(tdm_samples: i64) -> f64 {
    if tdm_samples >= 3 { return 0.07 }
    if tdm_samples >= 1 { return 0.10 }
    0.15
}

fn vp_band_cl(tdm_samples: i64) -> f64 {
    if tdm_samples >= 3 { return 0.07 }
    if tdm_samples >= 1 { return 0.10 }
    0.25
}

pub fn vp_vc_to_pbox(p: &VancoPKParams, tdm_samples: i64) -> PBox {
    let frac = vp_band_vc(tdm_samples)
    let lo = (1.0 - frac) * p.vc_l
    let hi = (1.0 + frac) * p.vc_l
    let v = 0.0025 * p.vc_l * p.vc_l
    pb_new(lo, hi, v, 920)
}

pub fn vp_cl_to_pbox(p: &VancoPKParams, tdm_samples: i64) -> PBox {
    let frac = vp_band_cl(tdm_samples)
    let lo = (1.0 - frac) * p.cl_l_per_h
    let hi = (1.0 + frac) * p.cl_l_per_h
    let v = 0.01 * p.cl_l_per_h * p.cl_l_per_h
    pb_new(lo, hi, v, 880)
}

// ============================================================================
// EXPONENTIAL — Taylor-series approximation for use in steady-state formula.
// 5-term Maclaurin: e^x ≈ 1 + x + x²/2 + x³/6 + x⁴/24 + x⁵/120
// Accurate to ~1e-3 for |x| <= 2; vancomycin elimination per dosing
// interval typically gives -ke·tau in [-1.5, -0.3], so this regime is safe.
// ============================================================================

fn vp_exp_approx(x: f64) -> f64 {
    let x2 = x * x
    let x3 = x2 * x
    let x4 = x3 * x
    let x5 = x4 * x
    1.0 + x + x2 / 2.0 + x3 / 6.0 + x4 / 24.0 + x5 / 120.0
}

// ============================================================================
// STEADY-STATE Cmin (1-compartment approximation of slow phase).
//
// ke    = CL / Vc
// tau   = dosing interval (h)
// dose  = mg per interval
//
// Cmin_ss = (dose / Vc) * exp(-ke*tau) / (1 - exp(-ke*tau))
//
// We compute this on Knightian PBoxes by interval extension on the
// monotone subterms.
//
// Hand-derived monotonicity (corrected 2026-04-30 after math-review by
// Grok 4.1 caught the original sign error on dCmin/dVc; see
// .claude/vancomycin_track.md "Pivot Log"):
//
//   Let θ = ke·τ = (CL·τ)/Vc. Cmin = (D/Vc) / (e^θ - 1).
//
//   d Cmin / d CL = -(D·τ) e^θ / [Vc² (e^θ - 1)²]                  < 0
//   d Cmin / d Vc =  D · [e^θ (θ - 1) + 1] / [Vc² (e^θ - 1)²]      > 0  ∀ θ > 0
//
//   (h(θ) := e^θ(θ-1) + 1 has h(0)=0, h'(θ) = θ·e^θ > 0 ⇒ h(θ) > 0 ∀ θ > 0.)
//
// Therefore Cmin is INCREASING in Vc and DECREASING in CL.
// PBox image corners:
//   Cmin_min: (Vc_lo, CL_hi)
//   Cmin_max: (Vc_hi, CL_lo)
// ============================================================================

fn vp_cmin_point(vc: f64, cl: f64, dose: f64, tau: f64) -> f64 with Mut, Div, Panic {
    if vc <= 0.0 { return 0.0 }
    if cl <= 0.0 { return 0.0 }
    let ke = cl / vc
    let exp_neg_ke_tau = vp_exp_approx(0.0 - ke * tau)
    let denom = 1.0 - exp_neg_ke_tau
    if denom <= 0.0 { return 0.0 }
    (dose / vc) * exp_neg_ke_tau / denom
}

// ============================================================================
// CONTRACT GATES (refinement-style runtime enforcement).
// Each returns a vacuous PBox if any precondition fails.
// ============================================================================

fn vp_dose_valid(dose: f64) -> bool { dose > 0.0 && dose <= 4000.0 }
fn vp_tau_valid(tau: f64) -> bool { tau >= 4.0 && tau <= 48.0 }
fn vp_weight_valid(w: f64) -> bool { w >= 30.0 && w <= 200.0 }
fn vp_crcl_valid(c: f64) -> bool { c > 0.0 && c <= 200.0 }

// ============================================================================
// PUBLIC API — predict_cmin_knightian
// ============================================================================

pub fn predict_cmin_knightian(
    weight_kg: f64,
    crcl_ml_min: f64,
    dose_mg: f64,
    interval_h: f64,
    tdm_samples: i64,
) -> PBox with Mut, Div, Panic {
    if !vp_dose_valid(dose_mg) { return pb_vacuous() }
    if !vp_tau_valid(interval_h) { return pb_vacuous() }
    if !vp_weight_valid(weight_kg) { return pb_vacuous() }
    if !vp_crcl_valid(crcl_ml_min) { return pb_vacuous() }

    let params = vp_default(weight_kg, crcl_ml_min)
    let vc = vp_vc_to_pbox(&params, tdm_samples)
    let cl = vp_cl_to_pbox(&params, tdm_samples)

    // Cmin is INCREASING in Vc and DECREASING in CL (see header comment).
    // Cmin_min at (Vc_lo, CL_hi); Cmin_max at (Vc_hi, CL_lo).
    let cmin_low = vp_cmin_point(pb_lo_mean(&vc), pb_hi_mean(&cl), dose_mg, interval_h)
    let cmin_high = vp_cmin_point(pb_hi_mean(&vc), pb_lo_mean(&cl), dose_mg, interval_h)

    // Variance on the midpoint Cmin (GUM linearization).
    let mid_cmin = vp_cmin_point(0.5 * (pb_lo_mean(&vc) + pb_hi_mean(&vc)),
                                 0.5 * (pb_lo_mean(&cl) + pb_hi_mean(&cl)),
                                 dose_mg, interval_h)
    let _ = mid_cmin
    // Conservative variance: scaled gap squared / 12 (uniform-on-band proxy).
    let gap = cmin_high - cmin_low
    let v = gap * gap / 12.0

    // Confidence: min of input PBox confidences with one decay step
    // per arithmetic level. Two ops here (vc, cl) used; one decay.
    let conf = pb_min_i64_pub(pb_confidence(&vc), pb_confidence(&cl)) * 99 / 100

    pb_new(cmin_low, cmin_high, v, conf)
}

// Used internally; exposed because pb_min_i64 is module-internal.
pub fn pb_min_i64_pub(a: i64, b: i64) -> i64 {
    if a < b { a } else { b }
}

// ============================================================================
// SAFETY GATE — combined Knightian-Cmin therapeutic-window decision.
// Conservative: refuses if the *band* crosses either boundary.
// ============================================================================

pub fn is_safe_dose(predicted_cmin: &PBox, target_lo: f64, target_hi: f64,
                    min_conf: i64) -> bool {
    if !pb_is_credible(predicted_cmin, min_conf) { return false }
    pb_within(predicted_cmin, target_lo, target_hi)
}

// ============================================================================
// SELF-TEST main()
// ============================================================================

pub fn main() -> i32 with IO, Mut, Div, Panic {
    // Standard adult ICU patient: 78.5 kg, CrCl 65 mL/min,
    // dose 1000 mg q12h. Pre-TDM (0 samples) -> wide band -> REFUSE.
    let pre = predict_cmin_knightian(78.5, 65.0, 1000.0, 12.0, 0)
    println(pb_lo_mean(&pre))
    println(pb_hi_mean(&pre))
    if is_safe_dose(&pre, 10.0, 20.0, 800) {
        println("PRE_PRESCRIBE")
    } else {
        println("PRE_REFUSE")
    }

    // Same patient, post-TDM (3 samples) -> narrow band -> safe to prescribe
    let post = predict_cmin_knightian(78.5, 65.0, 1000.0, 12.0, 3)
    println(pb_lo_mean(&post))
    println(pb_hi_mean(&post))
    if is_safe_dose(&post, 10.0, 20.0, 800) {
        println("POST_PRESCRIBE")
    } else {
        println("POST_REFUSE")
    }

    // Contract violation: weight 15 kg out of [30, 200]
    let bad = predict_cmin_knightian(15.0, 65.0, 1000.0, 12.0, 0)
    if pb_confidence(&bad) == 0 {
        println("CONTRACT_BLOCK")
    } else {
        println("CONTRACT_LEAK")
    }
    0
}
