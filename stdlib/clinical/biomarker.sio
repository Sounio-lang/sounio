// stdlib/clinical/biomarker.sio
//
// PLACEHOLDER / SKELETON.
//
// This file will host the depression-biomarker pipeline that combines
// EEG, fMRI, and Ollivier–Ricci curvature (ORC) using sedenion state
// representations.  The algebraic substrate is shared with the
// surgical-interventions program (self-hosted/parser/ast.sio adds
// ExactlyPrivate<T>, Editable<T>, CapabilityGated<T>; this module will
// add the clinical-grade wrappers on top).
//
// Intentionally not imported anywhere in the current build.  The
// surgical-interventions plan (see paper/paper_c_surgical_ml.tex) treats
// this biomarker line as out-of-scope; the scaffold is here only so the
// biomarker plan lands cleanly without a second round of compiler edits.

fn biomarker_pipeline_skeleton() -> i32 with IO {
    println("clinical/biomarker.sio: skeleton only; see README.md")
    0
}
