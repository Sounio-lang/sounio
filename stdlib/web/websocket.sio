/// WebSocket session types — bidirectional typed communication
/// Implements typed WS sessions as session-type channels

struct WsMessage {
    opcode: i64,    // 1=text, 2=binary, 8=close
    payload_len: i64,
    payload: [i8; 2048],
}

fn ws_text_message(payload: [i8; 2048], len: i64) -> WsMessage {
    WsMessage { opcode: 1, payload_len: len, payload: payload }
}

fn ws_close_message() -> WsMessage {
    WsMessage { opcode: 8, payload_len: 0, payload: [0; 2048] }
}

fn ws_is_close(msg: WsMessage) -> bool {
    msg.opcode == 8
}

fn ws_is_text(msg: WsMessage) -> bool {
    msg.opcode == 1
}
