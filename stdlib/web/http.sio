/// HTTP session protocol types for Sounio web programming
/// Provides typed HTTP request/response sessions with effect tracking

/// HTTP request type
struct HttpRequest {
    url_len: i64,
    url: [i8; 256],
    method: i64,  // 0=GET, 1=POST, 2=PUT, 3=DELETE
    body_len: i64,
    body: [i8; 4096],
}

/// HTTP response type
pub struct HttpResponse {
    status: i64,
    body_len: i64,
    body: [i8; 4096],
    content_type: i64,  // 0=json, 1=text, 2=binary
}

/// HTTP method constants
fn http_get_method() -> i64 { 0 }
fn http_post_method() -> i64 { 1 }
fn http_put_method() -> i64 { 2 }
fn http_delete_method() -> i64 { 3 }

/// HTTP status predicates
fn http_ok(resp: HttpResponse) -> bool {
    resp.status >= 200 && resp.status < 300
}

fn http_client_error(resp: HttpResponse) -> bool {
    resp.status >= 400 && resp.status < 500
}

fn http_server_error(resp: HttpResponse) -> bool {
    resp.status >= 500
}

/// Minimum response quality score [0.0, 1.0]
/// Based on status code: 200=1.0, 4xx=0.3, 5xx=0.0
fn http_quality_score(resp: HttpResponse) -> f64 {
    if resp.status >= 200 && resp.status < 300 {
        1.0
    } else if resp.status >= 400 && resp.status < 500 {
        0.3
    } else {
        0.0
    }
}
