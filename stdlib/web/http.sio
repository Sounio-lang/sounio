/// HTTP session protocol types for Sounio web programming
///
/// Canonical HttpRequest/HttpResponse types and helpers now live in
/// stdlib/http/http.sio (merged 2026-07-01 to remove the duplicate
/// definitions that used to live here). Re-exported under web::http
/// so existing `use web::http::*` call sites keep working unchanged.
pub use http::http::{
    HttpRequest,
    HttpResponse,
    http_client_error,
    http_delete_method,
    http_get_method,
    http_ok,
    http_post_method,
    http_put_method,
    http_quality_score,
    http_request_new,
    http_response_new,
}
