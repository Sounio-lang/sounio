//! stdlib/onn/g2_activation.sio - G2-Equivariant Octonion Activations
//!
//! G2-equivariant activations operate on the octonion norm while preserving
//! the direction (unit octonion). This preserves G2 symmetry, the automorphism
//! group of octonions.
//!
//! Key insight: Standard component-wise activations BREAK G2 symmetry because
//! G2 mixes the 7D imaginary components. G2-equivariant activations only use
//! G2-invariant quantities: total norm |o|, real part Re(o), imaginary norm ||Im(o)||.

use std::onn::Octonion

// G2-equivariant GELU: gelu(|o|) * (o / |o|)
// Applies GELU to the norm, scales the unit octonion by result
fn oct_gelu_g2_activate(o: Octonion) -> Octonion {
    oct_gelu_g2(o)
}

// Batch G2-GELU
fn oct_gelu_g2_batch(input: &[Octonion]) -> [Octonion] {
    var output = [Octonion]::new(input.len())
    for i in 0..input.len() {
        output[i] = oct_gelu_g2(input[i])
    }
    output
}

// G2-equivariant Leaky ReLU: max(alpha*|o|, |o|) * (o / |o|)
fn oct_leaky_relu_g2_activate(o: Octonion, alpha: f32) -> Octonion {
    oct_leaky_relu_g2(o, alpha)
}

// Batch G2-Leaky ReLU
fn oct_leaky_relu_g2_batch(input: &[Octonion], alpha: f32) -> [Octonion] {
    var output = [Octonion]::new(input.len())
    for i in 0..input.len() {
        output[i] = oct_leaky_relu_g2(input[i], alpha)
    }
    output
}

// G2-equivariant ReLU: max(0, |o|) * (o / |o|)
// Note: This is very aggressive - zeros out any octonion, not just negative components
fn oct_relu_g2_activate(o: Octonion) -> Octonion {
    // ReLU on magnitude: if |o| > 0, keep it; otherwise zero
    // Since |o| >= 0 always, this is effectively identity for non-zero octonions
    let norm = oct_norm(o)
    if norm > 0.0 {
        o  // Keep as-is (norm is always non-negative)
    } else {
        Octonion { w: 0.0, x: 0.0, y: 0.0, z: 0.0, t: 0.0, u: 0.0, v: 0.0, s: 0.0 }
    }
}

// Magnitude gating: scale by sigmoid(|o|)
// Smoothly gates based on magnitude - useful for attention
fn oct_sigmoid_gate_g2(o: Octonion) -> Octonion {
    let norm = oct_norm(o)
    let gate = 1.0 / (1.0 + exp(-norm))
    if norm > 1e-8 {
        let scale = gate
        Octonion {
            w: o.w * scale,
            x: o.x * scale,
            y: o.y * scale,
            z: o.z * scale,
            t: o.t * scale,
            u: o.u * scale,
            v: o.v * scale,
            s: o.s * scale,
        }
    } else {
        Octonion { w: 0.0, x: 0.0, y: 0.0, z: 0.0, t: 0.0, u: 0.0, v: 0.0, s: 0.0 }
    }
}

// Soft normalization: o / (|o| + epsilon)
// Prevents division by zero while approximately normalizing
fn oct_soft_normalize(o: Octonion, epsilon: f32) -> Octonion {
    let norm = oct_norm(o)
    let scale = 1.0 / (norm + epsilon)
    Octonion {
        w: o.w * scale,
        x: o.x * scale,
        y: o.y * scale,
        z: o.z * scale,
        t: o.t * scale,
        u: o.u * scale,
        v: o.v * scale,
        s: o.s * scale,
    }
}
