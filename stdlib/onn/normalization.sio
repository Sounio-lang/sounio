//! stdlib/onn/normalization.sio - Octonion Normalization Layers
//!
//! Normalization layers for octonion neural networks.
//! All normalizations operate per-component (8 independent channels).

struct Octonion {
    w: f32,
    x: f32,
    y: f32,
    z: f32,
    t: f32,
    u: f32,
    v: f32,
    s: f32,
}

// Batch normalization config
struct OctBatchNorm {
    num_features: i32,
    epsilon: f32,
    momentum: f32,
}

// Layer normalization config
struct OctLayerNorm {
    normalized_shape: i32,
    epsilon: f32,
}

// Group normalization config
struct OctGroupNorm {
    num_groups: i32,
    num_channels: i32,
    epsilon: f32,
}

// Instance normalization config
struct OctInstanceNorm {
    num_features: i32,
    epsilon: f32,
}

// Create batch normalization
fn oct_batch_norm_new(num_features: i32, epsilon: f32, momentum: f32) -> OctBatchNorm {
    OctBatchNorm {
        num_features: num_features,
        epsilon: epsilon,
        momentum: momentum,
    }
}

// Create layer normalization
fn oct_layer_norm_new(normalized_shape: i32, epsilon: f32) -> OctLayerNorm {
    OctLayerNorm {
        normalized_shape: normalized_shape,
        epsilon: epsilon,
    }
}

// Create group normalization
fn oct_group_norm_new(num_groups: i32, num_channels: i32, epsilon: f32) -> OctGroupNorm {
    OctGroupNorm {
        num_groups: num_groups,
        num_channels: num_channels,
        epsilon: epsilon,
    }
}

// Create instance normalization
fn oct_instance_norm_new(num_features: i32, epsilon: f32) -> OctInstanceNorm {
    OctInstanceNorm {
        num_features: num_features,
        epsilon: epsilon,
    }
}

// ============================================================================
// Helper: normalize a single octonion given mean and variance octonions
// ============================================================================

fn norm_sqrt(x: f32) -> f32 {
    if x <= 0.0 { return 0.0 }
    var guess = x / 2.0
    if guess < 0.001 { guess = 0.001 }
    var i = 0
    while i < 10 {
        guess = (guess + x / guess) / 2.0
        i = i + 1
    }
    guess
}

// Normalize: (x - mean) / sqrt(var + eps) * gamma + beta
fn oct_normalize(x: Octonion, mean: Octonion, variance: Octonion, gamma: Octonion, beta: Octonion, eps: f32) -> Octonion {
    Octonion {
        w: (x.w - mean.w) / norm_sqrt(variance.w + eps) * gamma.w + beta.w,
        x: (x.x - mean.x) / norm_sqrt(variance.x + eps) * gamma.x + beta.x,
        y: (x.y - mean.y) / norm_sqrt(variance.y + eps) * gamma.y + beta.y,
        z: (x.z - mean.z) / norm_sqrt(variance.z + eps) * gamma.z + beta.z,
        t: (x.t - mean.t) / norm_sqrt(variance.t + eps) * gamma.t + beta.t,
        u: (x.u - mean.u) / norm_sqrt(variance.u + eps) * gamma.u + beta.u,
        v: (x.v - mean.v) / norm_sqrt(variance.v + eps) * gamma.v + beta.v,
        s: (x.s - mean.s) / norm_sqrt(variance.s + eps) * gamma.s + beta.s,
    }
}
