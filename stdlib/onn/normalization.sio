//! stdlib/onn/normalization.sio - Octonion Normalization Layers
//!
//! Normalization layers for octonion neural networks.
//! All normalizations operate per-component (8 independent channels).

use std::onn::Octonion

// Batch normalization config
struct OctBatchNorm {
    num_features: i32,
    epsilon: f32,
    momentum: f32,
}

// Layer normalization config
struct OctLayerNorm {
    normalized_shape: i32,
    epsilon: f32,
}

// Group normalization config
struct OctGroupNorm {
    num_groups: i32,
    num_channels: i32,
    epsilon: f32,
}

// Instance normalization config
struct OctInstanceNorm {
    num_features: i32,
    epsilon: f32,
}

// Create batch normalization
fn oct_batch_norm_new(num_features: i32, epsilon: f32, momentum: f32) -> OctBatchNorm {
    OctBatchNorm {
        num_features: num_features,
        epsilon: epsilon,
        momentum: momentum,
    }
}

// Batch normalization forward
fn oct_batch_norm_forward(
    bn: &OctBatchNorm,
    input: &[Octonion],
    gamma: &[Octonion],
    beta: &[Octonion],
    running_mean: &[Octonion],
    running_var: &[Octonion],
    training: bool
) -> [Octonion] {
    oct_bn_fwd(bn, input, gamma, beta, running_mean, running_var, training)
}

// Create layer normalization
fn oct_layer_norm_new(normalized_shape: i32, epsilon: f32) -> OctLayerNorm {
    OctLayerNorm {
        normalized_shape: normalized_shape,
        epsilon: epsilon,
    }
}

// Layer normalization forward
fn oct_layer_norm_forward(
    ln: &OctLayerNorm,
    input: &[Octonion],
    gamma: &[Octonion],
    beta: &[Octonion]
) -> [Octonion] {
    oct_layer_norm_fwd(ln, input, gamma, beta)
}

// Create group normalization
fn oct_group_norm_new(num_groups: i32, num_channels: i32, epsilon: f32) -> OctGroupNorm {
    OctGroupNorm {
        num_groups: num_groups,
        num_channels: num_channels,
        epsilon: epsilon,
    }
}

// Group normalization forward
fn oct_group_norm_forward(
    gn: &OctGroupNorm,
    input: &[Octonion],
    gamma: &[Octonion],
    beta: &[Octonion]
) -> [Octonion] {
    oct_group_norm_fwd(gn, input, gamma, beta)
}

// Create instance normalization
fn oct_instance_norm_new(num_features: i32, epsilon: f32) -> OctInstanceNorm {
    OctInstanceNorm {
        num_features: num_features,
        epsilon: epsilon,
    }
}

// Instance normalization forward
fn oct_instance_norm_forward(
    in_norm: &OctInstanceNorm,
    input: &[Octonion],
    gamma: &[Octonion],
    beta: &[Octonion]
) -> [Octonion] {
    oct_instance_norm_fwd(in_norm, input, gamma, beta)
}
