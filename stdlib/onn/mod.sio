//! stdlib/onn/mod.sio - Octonion Neural Network Module

module onn

// Octonion type (8 components)
struct Octonion {
    w: f32,
    x: f32,
    y: f32,
    z: f32,
    t: f32,
    u: f32,
    v: f32,
    s: f32,
}

struct OctLinearLayer {
    input_features: i32,
    output_features: i32,
}

struct OctConv2dLayer {
    in_channels: i32,
    out_channels: i32,
    kernel_h: i32,
    kernel_w: i32,
    stride: i32,
    padding: i32,
}

fn oct_linear_new(input_features: i32, output_features: i32) -> OctLinearLayer {
    OctLinearLayer {
        input_features: input_features,
        output_features: output_features,
    }
}

fn oct_conv2d_new(
    in_channels: i32,
    out_channels: i32,
    kernel_h: i32,
    kernel_w: i32,
    stride: i32,
    padding: i32
) -> OctConv2dLayer {
    OctConv2dLayer {
        in_channels: in_channels,
        out_channels: out_channels,
        kernel_h: kernel_h,
        kernel_w: kernel_w,
        stride: stride,
        padding: padding,
    }
}
