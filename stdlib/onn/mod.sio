//! stdlib/onn/mod.sio - Octonion Neural Network Module
//!
//! Native octonion neural network support for Sounio.
//! Provides 8x parameter efficiency through hypercomplex algebra.
//!
//! Key differences from QNN (Quaternion Neural Networks):
//!   - 8D vs 4D: Octonions have 8 components (w, x, y, z, t, u, v, s)
//!   - Non-associative: (a*b)*c != a*(b*c) - requires careful handling
//!   - G2 symmetry: Uses exceptional Lie group G2 (automorphisms of octonions)
//!
//! References:
//!   - Deep Octonion Networks (arXiv:1903.08478)
//!   - "The Octonions" by John C. Baez (Bull. AMS, 2002)
//!   - G2-equivariant Neural Networks (arXiv:2106.06610)
//!
//! Usage:
//!   use std::onn
//!
//!   let layer = onn::oct_linear_new(8, 16)
//!   let weights = onn::oct_xavier_init(8, 16, seed: 42)
//!   let bias = onn::oct_xavier_init(1, 16, seed: 43)
//!   let output = onn::oct_linear_forward(layer, weights, input, bias)
//!   let activated = onn::oct_gelu_activate(output)
//!
//! Helper modules:
//!   - onn::linear    - Linear layer helper functions (Xavier/He init)
//!   - onn::conv      - Conv2d and pooling layers
//!   - onn::activation - Component-wise activations (ReLU, GELU, etc.)
//!   - onn::g2_activation - G2-equivariant activations
//!   - onn::normalization - BatchNorm, LayerNorm, GroupNorm, InstanceNorm
//!   - onn::attention - Multi-head attention with octonion projections
//!   - onn::loss      - Loss functions (MSE, MAE, CrossEntropy)
//!   - onn::optimizer - Optimizers (SGD, Adam, RMSprop)
//!   - onn::training  - Training utilities (scheduling, metrics, EMA, etc.)

// All ONN functions are available as compiler intrinsics:
//
// == Core Algebra ==
// - oct_mul(a, b)           Cayley-Dickson multiplication (120 FLOPs)
// - oct_conj(o)             Conjugate (negate imaginary parts)
// - oct_norm_sq(o)          Squared norm
// - oct_normalize(o)        Unit normalization
// - oct_inv(o)              Multiplicative inverse
// - oct_real(o)             Extract scalar part
// - oct_imag(o)             Extract 7D imaginary vector
// - oct_dot(a, b)           Dot product
// - oct_exp(o)              Exponential
// - oct_log(o)              Logarithm
//
// == G2-Equivariant Operations ==
// - oct_rotate(u, v)        G2 rotation: u * v * conj(u)
// - oct_imag_norm(o)        Imaginary part norm ||Im(o)||
// - oct_imag_project(o)     Project to imaginary subspace
//
// == Neural Network Layers ==
// - oct_linear_fwd          Linear layer forward: y = W * x + b
// - oct_linear_bwd          Linear layer backward (gradient computation)
// - oct_conv2d_fwd          2D convolution forward
// - oct_conv2d_bwd          2D convolution backward
//
// == Activations (Component-wise) ==
// - oct_relu                ReLU: max(0, x) per component
// - oct_sigmoid             Sigmoid per component
// - oct_tanh                Tanh per component
// - oct_gelu                GELU: x * sigmoid(1.702 * x)
// - oct_leaky_relu(o, a)    Leaky ReLU: max(alpha*x, x)
//
// == Activations (G2-Equivariant) ==
// - oct_gelu_g2             GELU on norm, preserves direction
// - oct_leaky_relu_g2       Leaky ReLU on norm
//
// == Normalization ==
// - oct_bn_fwd              Batch normalization forward
// - oct_bn_bwd              Batch normalization backward
// - oct_layer_norm_fwd      Layer normalization forward
// - oct_layer_norm_bwd      Layer normalization backward
// - oct_group_norm_fwd      Group normalization forward
// - oct_group_norm_bwd      Group normalization backward
// - oct_instance_norm_fwd   Instance normalization forward
// - oct_instance_norm_bwd   Instance normalization backward
//
// == Regularization ==
// - oct_dropout             Dropout (drops entire octonions)
//
// == Loss Functions ==
// - oct_cross_entropy       Cross-entropy using norm for softmax
// - oct_mse                 Mean squared error
//
// == Attention ==
// - oct_attention           Multi-head attention

// Octonion type (8 components)
struct Octonion {
    w: f32,  // scalar (real) part
    x: f32,  // i component
    y: f32,  // j component
    z: f32,  // k component
    t: f32,  // l component
    u: f32,  // il component
    v: f32,  // jl component
    s: f32,  // kl component
}

// Linear layer configuration
struct OctLinearLayer {
    input_features: i32,
    output_features: i32,
}

// Conv2d layer configuration
struct OctConv2dLayer {
    in_channels: i32,
    out_channels: i32,
    kernel_h: i32,
    kernel_w: i32,
    stride: i32,
    padding: i32,
}

// Create a new linear layer
fn oct_linear_new(input_features: i32, output_features: i32) -> OctLinearLayer {
    OctLinearLayer {
        input_features: input_features,
        output_features: output_features,
    }
}

// Create a new conv2d layer
fn oct_conv2d_new(
    in_channels: i32,
    out_channels: i32,
    kernel_h: i32,
    kernel_w: i32,
    stride: i32,
    padding: i32
) -> OctConv2dLayer {
    OctConv2dLayer {
        in_channels: in_channels,
        out_channels: out_channels,
        kernel_h: kernel_h,
        kernel_w: kernel_w,
        stride: stride,
        padding: padding,
    }
}
