//! stdlib/onn/activation.sio - Octonion Activation Functions
//!
//! Component-wise activation functions for octonion neural networks.
//! Each activation is applied independently to all 8 components.

struct Octonion {
    w: f32,
    x: f32,
    y: f32,
    z: f32,
    t: f32,
    u: f32,
    v: f32,
    s: f32,
}

// ============================================================================
// Helper math functions
// ============================================================================

fn act_exp(x: f32) -> f32 {
    if x > 20.0 { return 1000000.0 }
    if x < -20.0 { return 0.0 }
    var sum = 1.0
    var term = 1.0
    var i = 1
    while i <= 12 {
        term = term * x / (i as f32)
        sum = sum + term
        i = i + 1
    }
    sum
}

// ============================================================================
// Component-wise helpers
// ============================================================================

fn relu_component(x: f32) -> f32 {
    if x > 0.0 { x } else { 0.0 }
}

fn leaky_relu_component(x: f32, alpha: f32) -> f32 {
    if x > 0.0 { x } else { alpha * x }
}

fn sigmoid_component(x: f32) -> f32 {
    1.0 / (1.0 + act_exp(0.0 - x))
}

fn gelu_component(x: f32) -> f32 {
    x * sigmoid_component(1.702 * x)
}

fn tanh_component(x: f32) -> f32 {
    let ep = act_exp(x)
    let en = act_exp(0.0 - x)
    (ep - en) / (ep + en)
}

// ============================================================================
// Octonion activation functions
// ============================================================================

// ReLU activation: max(0, x) per component
fn oct_relu(o: Octonion) -> Octonion {
    Octonion {
        w: relu_component(o.w),
        x: relu_component(o.x),
        y: relu_component(o.y),
        z: relu_component(o.z),
        t: relu_component(o.t),
        u: relu_component(o.u),
        v: relu_component(o.v),
        s: relu_component(o.s),
    }
}

// GELU activation: x * sigmoid(1.702 * x) per component
fn oct_gelu(o: Octonion) -> Octonion {
    Octonion {
        w: gelu_component(o.w),
        x: gelu_component(o.x),
        y: gelu_component(o.y),
        z: gelu_component(o.z),
        t: gelu_component(o.t),
        u: gelu_component(o.u),
        v: gelu_component(o.v),
        s: gelu_component(o.s),
    }
}

// Leaky ReLU activation: max(alpha*x, x) per component
fn oct_leaky_relu(o: Octonion, alpha: f32) -> Octonion {
    Octonion {
        w: leaky_relu_component(o.w, alpha),
        x: leaky_relu_component(o.x, alpha),
        y: leaky_relu_component(o.y, alpha),
        z: leaky_relu_component(o.z, alpha),
        t: leaky_relu_component(o.t, alpha),
        u: leaky_relu_component(o.u, alpha),
        v: leaky_relu_component(o.v, alpha),
        s: leaky_relu_component(o.s, alpha),
    }
}

// Sigmoid activation: 1/(1 + exp(-x)) per component
fn oct_sigmoid(o: Octonion) -> Octonion {
    Octonion {
        w: sigmoid_component(o.w),
        x: sigmoid_component(o.x),
        y: sigmoid_component(o.y),
        z: sigmoid_component(o.z),
        t: sigmoid_component(o.t),
        u: sigmoid_component(o.u),
        v: sigmoid_component(o.v),
        s: sigmoid_component(o.s),
    }
}

// Tanh activation: tanh(x) per component
fn oct_tanh(o: Octonion) -> Octonion {
    Octonion {
        w: tanh_component(o.w),
        x: tanh_component(o.x),
        y: tanh_component(o.y),
        z: tanh_component(o.z),
        t: tanh_component(o.t),
        u: tanh_component(o.u),
        v: tanh_component(o.v),
        s: tanh_component(o.s),
    }
}
