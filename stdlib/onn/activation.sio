//! stdlib/onn/activation.sio - Octonion Activation Functions
//!
//! Component-wise activation functions for octonion neural networks.
//! Each activation is applied independently to all 8 components.

use std::onn::Octonion;

// ReLU activation: max(0, x) per component
fn oct_relu_activate(o: Octonion) -> Octonion {
    oct_relu(o)
}

// Batch ReLU
fn oct_relu_batch(input: &[Octonion]) -> [Octonion] {
    var output = [Octonion]::new(input.len())
    for i in 0..input.len() {
        output[i] = oct_relu(input[i])
    }
    output
}

// GELU activation: x * sigmoid(1.702 * x) per component
fn oct_gelu_activate(o: Octonion) -> Octonion {
    oct_gelu(o)
}

// Batch GELU
fn oct_gelu_batch(input: &[Octonion]) -> [Octonion] {
    var output = [Octonion]::new(input.len())
    for i in 0..input.len() {
        output[i] = oct_gelu(input[i])
    }
    output
}

// Leaky ReLU activation: max(alpha*x, x) per component
fn oct_leaky_relu_activate(o: Octonion, alpha: f32) -> Octonion {
    oct_leaky_relu(o, alpha)
}

// Batch Leaky ReLU
fn oct_leaky_relu_batch(input: &[Octonion], alpha: f32) -> [Octonion] {
    var output = [Octonion]::new(input.len())
    for i in 0..input.len() {
        output[i] = oct_leaky_relu(input[i], alpha)
    }
    output
}

// Sigmoid activation: 1/(1 + exp(-x)) per component
fn oct_sigmoid_activate(o: Octonion) -> Octonion {
    oct_sigmoid(o)
}

// Batch Sigmoid
fn oct_sigmoid_batch(input: &[Octonion]) -> [Octonion] {
    var output = [Octonion]::new(input.len())
    for i in 0..input.len() {
        output[i] = oct_sigmoid(input[i])
    }
    output
}

// Tanh activation: tanh(x) per component
fn oct_tanh_activate(o: Octonion) -> Octonion {
    oct_tanh(o)
}

// Batch Tanh
fn oct_tanh_batch(input: &[Octonion]) -> [Octonion] {
    var output = [Octonion]::new(input.len())
    for i in 0..input.len() {
        output[i] = oct_tanh(input[i])
    }
    output
}
