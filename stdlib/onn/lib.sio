// stdlib/onn — Octonion Neural Network module
//
// Exports the Octonion type (ONN convention: {w,x,y,z,t,u,v,s})
// and layer descriptor types used by the ONN submodules.

// ============================================================================
// Core types
// ============================================================================

struct Octonion {
    w: f32,
    x: f32,
    y: f32,
    z: f32,
    e4: f32,
    e5: f32,
    e6: f32,
    e7: f32,
}

struct OctLinearLayer {
    in_size: i64,
    out_size: i64,
}

struct OctConv2dLayer {
    in_channels: i64,
    out_channels: i64,
    kernel_size: i64,
}

// ============================================================================
// Arithmetic
// ============================================================================

fn oct_zero() -> Octonion {
    Octonion { w: 0.0, x: 0.0, y: 0.0, z: 0.0, e4: 0.0, e5: 0.0, e6: 0.0, e7: 0.0 }
}

fn oct_make(c0: f32, c1: f32, c2: f32, c3: f32, c4: f32, c5: f32, c6: f32, c7: f32) -> Octonion {
    Octonion { w: c0, x: c1, y: c2, z: c3, e4: c4, e5: c5, e6: c6, e7: c7 }
}

fn oct_real_part(r: f32) -> Octonion {
    Octonion { w: r, x: 0.0, y: 0.0, z: 0.0, e4: 0.0, e5: 0.0, e6: 0.0, e7: 0.0 }
}

fn oct_add(a: Octonion, b: Octonion) -> Octonion {
    Octonion { w: a.w+b.w, x: a.x+b.x, y: a.y+b.y, z: a.z+b.z,
               e4: a.e4+b.e4, e5: a.e5+b.e5, e6: a.e6+b.e6, e7: a.e7+b.e7 }
}

fn oct_sub(a: Octonion, b: Octonion) -> Octonion {
    Octonion { w: a.w-b.w, x: a.x-b.x, y: a.y-b.y, z: a.z-b.z,
               e4: a.e4-b.e4, e5: a.e5-b.e5, e6: a.e6-b.e6, e7: a.e7-b.e7 }
}

fn oct_scale(a: Octonion, c: f32) -> Octonion {
    Octonion { w: a.w*c, x: a.x*c, y: a.y*c, z: a.z*c,
               e4: a.e4*c, e5: a.e5*c, e6: a.e6*c, e7: a.e7*c }
}

fn oct_conj(a: Octonion) -> Octonion {
    Octonion { w: a.w, x: -a.x, y: -a.y, z: -a.z,
               e4: -a.e4, e5: -a.e5, e6: -a.e6, e7: -a.e7 }
}

fn oct_norm_sq(a: Octonion) -> f32 {
    a.w*a.w + a.x*a.x + a.y*a.y + a.z*a.z + a.e4*a.e4 + a.e5*a.e5 + a.e6*a.e6 + a.e7*a.e7
}

fn oct_dot(a: Octonion, b: Octonion) -> f32 {
    a.w*b.w + a.x*b.x + a.y*b.y + a.z*b.z + a.e4*b.e4 + a.e5*b.e5 + a.e6*b.e6 + a.e7*b.e7
}

// Cayley-Dickson product (verified norm-multiplicative)
fn oct_mul(a: Octonion, b: Octonion) -> Octonion {
    let c0 = a.w*b.w - a.x*b.x - a.y*b.y - a.z*b.z - a.e4*b.e4 - a.e5*b.e5 - a.e6*b.e6 - a.e7*b.e7
    let c1 = a.w*b.x + a.x*b.w + a.y*b.z - a.z*b.y + a.e4*b.e5 - a.e5*b.e4 - a.e6*b.e7 + a.e7*b.e6
    let c2 = a.w*b.y - a.x*b.z + a.y*b.w + a.z*b.x + a.e4*b.e6 + a.e5*b.e7 - a.e6*b.e4 - a.e7*b.e5
    let c3 = a.w*b.z + a.x*b.y - a.y*b.x + a.z*b.w + a.e4*b.e7 - a.e5*b.e6 + a.e6*b.e5 - a.e7*b.e4
    let c4 = a.w*b.e4 - a.x*b.e5 - a.y*b.e6 - a.z*b.e7 + a.e4*b.w + a.e5*b.x + a.e6*b.y + a.e7*b.z
    let c5 = a.w*b.e5 + a.x*b.e4 - a.y*b.e7 + a.z*b.e6 - a.e4*b.x + a.e5*b.w - a.e6*b.z + a.e7*b.y
    let c6 = a.w*b.e6 + a.x*b.e7 + a.y*b.e4 - a.z*b.e5 - a.e4*b.y + a.e5*b.z + a.e6*b.w - a.e7*b.x
    let c7 = a.w*b.e7 - a.x*b.e6 + a.y*b.e5 + a.z*b.e4 - a.e4*b.z - a.e5*b.y + a.e6*b.x + a.e7*b.w
    Octonion { w: c0, x: c1, y: c2, z: c3, e4: c4, e5: c5, e6: c6, e7: c7 }
}

// ============================================================================
// Scalar helpers (top-level, used by activation functions)
// ============================================================================

fn relu_f32(x: f32) -> f32 {
    if x > 0.0 { x } else { 0.0 }
}

fn lrelu_f32(x: f32, alpha: f32) -> f32 {
    if x > 0.0 { x } else { alpha * x }
}

// Taylor-series exp for f32, good for |x| < 5
fn exp_f32(x: f32) -> f32 {
    let x2 = x * x
    let x3 = x2 * x
    let x4 = x3 * x
    let x5 = x4 * x
    let x6 = x5 * x
    let x7 = x6 * x
    1.0 + x + x2/2.0 + x3/6.0 + x4/24.0 + x5/120.0 + x6/720.0 + x7/5040.0
}

fn sigmoid_f32(x: f32) -> f32 {
    1.0 / (1.0 + exp_f32(-x))
}

fn tanh_f32(x: f32) -> f32 {
    2.0 * sigmoid_f32(2.0 * x) - 1.0
}

fn gelu_f32(x: f32) -> f32 {
    x * sigmoid_f32(1.702 * x)
}

// ============================================================================
// Activation functions (component-wise)
// ============================================================================

fn oct_relu(o: Octonion) -> Octonion {
    Octonion { w: relu_f32(o.w), x: relu_f32(o.x), y: relu_f32(o.y), z: relu_f32(o.z),
               e4: relu_f32(o.e4), e5: relu_f32(o.e5), e6: relu_f32(o.e6), e7: relu_f32(o.e7) }
}

fn oct_leaky_relu(o: Octonion, alpha: f32) -> Octonion {
    Octonion { w: lrelu_f32(o.w, alpha), x: lrelu_f32(o.x, alpha),
               y: lrelu_f32(o.y, alpha), z: lrelu_f32(o.z, alpha),
               e4: lrelu_f32(o.e4, alpha), e5: lrelu_f32(o.e5, alpha),
               e6: lrelu_f32(o.e6, alpha), e7: lrelu_f32(o.e7, alpha) }
}

fn oct_sigmoid(o: Octonion) -> Octonion {
    Octonion { w: sigmoid_f32(o.w), x: sigmoid_f32(o.x),
               y: sigmoid_f32(o.y), z: sigmoid_f32(o.z),
               e4: sigmoid_f32(o.e4), e5: sigmoid_f32(o.e5),
               e6: sigmoid_f32(o.e6), e7: sigmoid_f32(o.e7) }
}

fn oct_tanh(o: Octonion) -> Octonion {
    Octonion { w: tanh_f32(o.w), x: tanh_f32(o.x),
               y: tanh_f32(o.y), z: tanh_f32(o.z),
               e4: tanh_f32(o.e4), e5: tanh_f32(o.e5),
               e6: tanh_f32(o.e6), e7: tanh_f32(o.e7) }
}

fn oct_gelu(o: Octonion) -> Octonion {
    Octonion { w: gelu_f32(o.w), x: gelu_f32(o.x),
               y: gelu_f32(o.y), z: gelu_f32(o.z),
               e4: gelu_f32(o.e4), e5: gelu_f32(o.e5),
               e6: gelu_f32(o.e6), e7: gelu_f32(o.e7) }
}

// ============================================================================
// Layer forward/backward
// weights: row-major [out_size * in_size]
// ============================================================================

fn oct_linear_fwd(
    layer: &OctLinearLayer,
    weights: &[Octonion],
    input: &[Octonion],
    bias: &[Octonion]
) -> [Octonion] with Mut, Alloc, Div {
    var out: [Octonion] = []
    var j: i64 = 0
    while j < layer.out_size {
        var acc = oct_zero()
        var i: i64 = 0
        while i < layer.in_size {
            acc = oct_add(acc, oct_mul(weights[j * layer.in_size + i], input[i]))
            i = i + 1
        }
        out.push(oct_add(acc, bias[j]))
        j = j + 1
    }
    out
}

fn oct_linear_bwd(
    layer: &OctLinearLayer,
    weights: &[Octonion],
    input: &[Octonion],
    grad_output: &[Octonion]
) -> ([Octonion], [Octonion], [Octonion]) with Mut, Alloc, Div {
    var grad_input: [Octonion] = []
    var grad_weights: [Octonion] = []
    var grad_bias: [Octonion] = []
    var i: i64 = 0
    while i < layer.in_size {
        var gi = oct_zero()
        var j: i64 = 0
        while j < layer.out_size {
            gi = oct_add(gi, oct_mul(oct_conj(weights[j * layer.in_size + i]), grad_output[j]))
            j = j + 1
        }
        grad_input.push(gi)
        i = i + 1
    }
    var j: i64 = 0
    while j < layer.out_size {
        var i2: i64 = 0
        while i2 < layer.in_size {
            grad_weights.push(oct_mul(grad_output[j], oct_conj(input[i2])))
            i2 = i2 + 1
        }
        grad_bias.push(grad_output[j])
        j = j + 1
    }
    (grad_input, grad_weights, grad_bias)
}
