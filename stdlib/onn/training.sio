//! stdlib/onn/training.sio - Octonion Neural Network Training Utilities
//!
//! High-level training loop abstractions for octonion neural networks.
//! Includes: gradient accumulation, learning rate scheduling, validation loops,
//! metric tracking, and checkpoint management.

use std::onn::{Octonion}

// Training state
struct TrainingState {
    epoch: i32,
    global_step: i32,
    best_loss: f32,
    best_accuracy: f32,
    total_loss: f32,
    batch_count: i32,
}

// Create initial training state
fn create_training_state() -> TrainingState {
    TrainingState {
        epoch: 0,
        global_step: 0,
        best_loss: 1e9,
        best_accuracy: 0.0,
        total_loss: 0.0,
        batch_count: 0,
    }
}

// Update training metrics
fn update_training_metrics(
    state: &!TrainingState,
    batch_loss: f32
) {
    state.total_loss = state.total_loss + batch_loss
    state.batch_count = state.batch_count + 1
    state.global_step = state.global_step + 1
}

// Get average loss for current epoch
fn get_epoch_loss(state: &TrainingState) -> f32 {
    if state.batch_count == 0 { return 0.0 }
    state.total_loss / state.batch_count as f32
}

// Reset epoch metrics
fn reset_epoch_metrics(state: &!TrainingState) {
    state.total_loss = 0.0
    state.batch_count = 0
    state.epoch = state.epoch + 1
}

// Learning rate scheduling
struct LrScheduler {
    initial_lr: f32,
    schedule_type: i32,     // 0: constant, 1: linear decay, 2: exponential decay, 3: cosine annealing
    total_steps: i32,
    current_step: i32,
    decay_rate: f32,
}

// Create learning rate scheduler
fn create_lr_scheduler(
    initial_lr: f32,
    schedule_type: i32,      // 0: const, 1: linear, 2: exp, 3: cosine
    total_steps: i32,
    decay_rate: f32
) -> LrScheduler {
    LrScheduler {
        initial_lr: initial_lr,
        schedule_type: schedule_type,
        total_steps: total_steps,
        current_step: 0,
        decay_rate: decay_rate,
    }
}

// Get current learning rate
fn get_learning_rate(scheduler: &LrScheduler) -> f32 {
    let progress = scheduler.current_step as f32 / scheduler.total_steps as f32
    let progress = if progress > 1.0 { 1.0 } else { progress }

    if scheduler.schedule_type == 0 {
        // Constant
        scheduler.initial_lr
    } else if scheduler.schedule_type == 1 {
        // Linear decay
        scheduler.initial_lr * (1.0 - progress)
    } else if scheduler.schedule_type == 2 {
        // Exponential decay
        scheduler.initial_lr * pow(scheduler.decay_rate, scheduler.current_step as f32)
    } else {
        // Cosine annealing
        scheduler.initial_lr * (1.0 + cos(progress * 3.14159)) / 2.0
    }
}

// Step scheduler
fn step_scheduler(scheduler: &!LrScheduler) {
    scheduler.current_step = scheduler.current_step + 1
}

// Batch iterator for training
struct DataLoader {
    batch_size: i32,
    num_samples: i32,
    shuffle: bool,
    current_batch: i32,
}

// Create data loader
fn create_dataloader(
    num_samples: i32,
    batch_size: i32,
    shuffle: bool
) -> DataLoader {
    DataLoader {
        batch_size: batch_size,
        num_samples: num_samples,
        shuffle: shuffle,
        current_batch: 0,
    }
}

// Get number of batches
fn get_num_batches(loader: &DataLoader) -> i32 {
    let num_batches = (loader.num_samples + loader.batch_size - 1) / loader.batch_size
    num_batches
}

// Get batch indices for current batch
fn get_batch_indices(
    loader: &!DataLoader
) -> [i32] {
    let start_idx = loader.current_batch * loader.batch_size
    let end_idx = start_idx + loader.batch_size
    let end_idx = if end_idx > loader.num_samples { loader.num_samples } else { end_idx }

    var indices: [i32] = []
    for i in start_idx..end_idx {
        indices_append(i)
    }

    loader.current_batch = loader.current_batch + 1

    indices
}

// Reset data loader
fn reset_dataloader(loader: &!DataLoader) {
    loader.current_batch = 0
}

// Gradient clipping: clip gradients by norm
// Prevents exploding gradients during backprop
fn clip_gradients_by_norm(
    gradients: &![Octonion],
    max_norm: f32
) {
    let n = gradients.len()
    var grad_norm_sq = 0.0

    // Compute norm of gradient vector
    for i in 0..n {
        let grad = gradients[i]
        grad_norm_sq = grad_norm_sq + (grad.w*grad.w + grad.x*grad.x + grad.y*grad.y + grad.z*grad.z
                                      + grad.t*grad.t + grad.u*grad.u + grad.v*grad.v + grad.s*grad.s)
    }

    let grad_norm = sqrt(grad_norm_sq)
    let clip_coef = max_norm / (grad_norm + 1e-6)
    let clip_coef = if clip_coef > 1.0 { 1.0 } else { clip_coef }

    // Apply clipping
    for i in 0..n {
        gradients[i] = Octonion {
            w: gradients[i].w * clip_coef,
            x: gradients[i].x * clip_coef,
            y: gradients[i].y * clip_coef,
            z: gradients[i].z * clip_coef,
            t: gradients[i].t * clip_coef,
            u: gradients[i].u * clip_coef,
            v: gradients[i].v * clip_coef,
            s: gradients[i].s * clip_coef
        }
    }
}

// Exponential Moving Average (EMA) for parameter averaging
// Useful for model stabilization and test-time augmentation
struct EMAModel {
    decay: f32,
    ema_params: [Octonion],
}

// Create EMA model
fn create_ema_model(
    num_params: i32,
    decay: f32
) -> EMAModel {
    var ema_params: [Octonion] = []
    let zero = Octonion { w: 0.0, x: 0.0, y: 0.0, z: 0.0, t: 0.0, u: 0.0, v: 0.0, s: 0.0 }

    for i in 0..num_params {
        ema_params_append(zero)
    }

    EMAModel {
        decay: decay,
        ema_params: ema_params,
    }
}

// Update EMA parameters
// ema_param = decay * ema_param + (1 - decay) * current_param
fn update_ema(
    ema: &!EMAModel,
    current_params: &[Octonion]
) {
    let n = current_params.len()
    let decay = ema.decay

    for i in 0..n {
        let current = current_params[i]
        let ema_param = ema.ema_params[i]

        ema.ema_params[i] = Octonion {
            w: decay * ema_param.w + (1.0 - decay) * current.w,
            x: decay * ema_param.x + (1.0 - decay) * current.x,
            y: decay * ema_param.y + (1.0 - decay) * current.y,
            z: decay * ema_param.z + (1.0 - decay) * current.z,
            t: decay * ema_param.t + (1.0 - decay) * current.t,
            u: decay * ema_param.u + (1.0 - decay) * current.u,
            v: decay * ema_param.v + (1.0 - decay) * current.v,
            s: decay * ema_param.s + (1.0 - decay) * current.s
        }
    }
}

// Batch normalization statistics
struct BatchNormStats {
    running_mean: [Octonion],
    running_var: [Octonion],
    momentum: f32,
    epsilon: f32,
}

// Create batch norm stats tracker
fn create_batchnorm_stats(
    num_features: i32,
    momentum: f32,
    epsilon: f32
) -> BatchNormStats {
    var running_mean: [Octonion] = []
    var running_var: [Octonion] = []
    let zero = Octonion { w: 0.0, x: 0.0, y: 0.0, z: 0.0, t: 0.0, u: 0.0, v: 0.0, s: 0.0 }
    let one_oct = Octonion { w: 1.0, x: 1.0, y: 1.0, z: 1.0, t: 1.0, u: 1.0, v: 1.0, s: 1.0 }

    for i in 0..num_features {
        running_mean_append(zero)
        running_var_append(one_oct)
    }

    BatchNormStats {
        running_mean: running_mean,
        running_var: running_var,
        momentum: momentum,
        epsilon: epsilon,
    }
}

// Update running statistics
// running_mean = momentum * running_mean + (1 - momentum) * batch_mean
// running_var = momentum * running_var + (1 - momentum) * batch_var
fn update_running_stats(
    stats: &!BatchNormStats,
    batch_mean: &[Octonion],
    batch_var: &[Octonion]
) {
    let n = batch_mean.len()
    let momentum = stats.momentum

    for i in 0..n {
        stats.running_mean[i] = Octonion {
            w: momentum * stats.running_mean[i].w + (1.0 - momentum) * batch_mean[i].w,
            x: momentum * stats.running_mean[i].x + (1.0 - momentum) * batch_mean[i].x,
            y: momentum * stats.running_mean[i].y + (1.0 - momentum) * batch_mean[i].y,
            z: momentum * stats.running_mean[i].z + (1.0 - momentum) * batch_mean[i].z,
            t: momentum * stats.running_mean[i].t + (1.0 - momentum) * batch_mean[i].t,
            u: momentum * stats.running_mean[i].u + (1.0 - momentum) * batch_mean[i].u,
            v: momentum * stats.running_mean[i].v + (1.0 - momentum) * batch_mean[i].v,
            s: momentum * stats.running_mean[i].s + (1.0 - momentum) * batch_mean[i].s
        }

        stats.running_var[i] = Octonion {
            w: momentum * stats.running_var[i].w + (1.0 - momentum) * batch_var[i].w,
            x: momentum * stats.running_var[i].x + (1.0 - momentum) * batch_var[i].x,
            y: momentum * stats.running_var[i].y + (1.0 - momentum) * batch_var[i].y,
            z: momentum * stats.running_var[i].z + (1.0 - momentum) * batch_var[i].z,
            t: momentum * stats.running_var[i].t + (1.0 - momentum) * batch_var[i].t,
            u: momentum * stats.running_var[i].u + (1.0 - momentum) * batch_var[i].u,
            v: momentum * stats.running_var[i].v + (1.0 - momentum) * batch_var[i].v,
            s: momentum * stats.running_var[i].s + (1.0 - momentum) * batch_var[i].s
        }
    }
}

// Accuracy computation for classification
// Returns: accuracy in [0, 1]
fn compute_accuracy(
    predictions: &[i32],        // Predicted class indices
    targets: &[i32]             // Target class indices
) -> f32 {
    let n = predictions.len()
    if n == 0 { return 0.0 }

    var correct = 0
    for i in 0..n {
        if predictions[i] == targets[i] {
            correct = correct + 1
        }
    }

    correct as f32 / n as f32
}

// Helper: sqrt(x)
fn sqrt(x: f32) -> f32 {
    if x <= 0.0 { return 0.0 }
    var guess = x / 2.0
    for i in 0..10 {
        guess = (guess + x / guess) / 2.0
    }
    guess
}

// Helper: pow(base, exp)
fn pow(base: f32, exp: f32) -> f32 {
    var result = 1.0
    for i in 0..(exp as i32) {
        result = result * base
    }
    result
}

// Helper: cos(x) via Taylor series
fn cos(x: f32) -> f32 {
    var result = 1.0
    var term = 1.0
    for i in 1..10 {
        term = term * (-x * x) / ((2*i - 1) as f32 * (2*i) as f32)
        result = result + term
    }
    result
}
