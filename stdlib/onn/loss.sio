//! stdlib/onn/loss.sio - Octonion Loss Functions
//!
//! Loss functions for training octonion neural networks.
//! Losses are scalar-valued (real numbers) computed from octonion predictions and targets.

struct Octonion {
    w: f32,
    x: f32,
    y: f32,
    z: f32,
    t: f32,
    u: f32,
    v: f32,
    s: f32,
}

// ============================================================================
// Helper math functions
// ============================================================================

fn loss_sqrt(x: f32) -> f32 {
    if x <= 0.0 { return 0.0 }
    var guess = x / 2.0
    if guess < 0.001 { guess = 0.001 }
    var i = 0
    while i < 10 {
        guess = (guess + x / guess) / 2.0
        i = i + 1
    }
    guess
}

fn loss_exp(x: f32) -> f32 {
    if x > 100.0 { return 1000000000.0 }
    if x < -100.0 { return 0.0 }
    var result = 1.0
    var term = 1.0
    var i = 1
    while i < 20 {
        term = term * x / (i as f32)
        result = result + term
        i = i + 1
    }
    result
}

fn loss_log(x: f32) -> f32 {
    if x <= 0.0 { return -1000000000.0 }
    let z = (x - 1.0) / (x + 1.0)
    var result = 0.0
    var z_power = z
    var n = 0
    while n < 10 {
        result = result + z_power / (2.0 * (n as f32) + 1.0)
        z_power = z_power * z * z
        n = n + 1
    }
    result * 2.0
}

// ============================================================================
// Loss Functions (forward pass only)
// ============================================================================

// Mean Squared Error (MSE) loss
// MSE = (1/n) * sum_i |pred_i - target_i|^2
fn oct_mse_loss(predictions: &[Octonion], targets: &[Octonion]) -> f32 {
    let n = predictions.len()
    var sum_sq_error = 0.0
    var i = 0
    while i < n {
        let pred = predictions[i]
        let target = targets[i]
        let dw = pred.w - target.w
        let dx = pred.x - target.x
        let dy = pred.y - target.y
        let dz = pred.z - target.z
        let dt = pred.t - target.t
        let du = pred.u - target.u
        let dv = pred.v - target.v
        let ds = pred.s - target.s
        sum_sq_error = sum_sq_error + (dw*dw + dx*dx + dy*dy + dz*dz + dt*dt + du*du + dv*dv + ds*ds)
        i = i + 1
    }
    sum_sq_error / (n as f32)
}

// Mean Absolute Error (L1) loss
// MAE = (1/n) * sum_i |pred_i - target_i|
fn oct_mae_loss(predictions: &[Octonion], targets: &[Octonion]) -> f32 {
    let n = predictions.len()
    var sum_abs_error = 0.0
    var i = 0
    while i < n {
        let pred = predictions[i]
        let target = targets[i]
        let dw = pred.w - target.w
        let dx = pred.x - target.x
        let dy = pred.y - target.y
        let dz = pred.z - target.z
        let dt = pred.t - target.t
        let du = pred.u - target.u
        let dv = pred.v - target.v
        let ds = pred.s - target.s
        let norm = loss_sqrt(dw*dw + dx*dx + dy*dy + dz*dz + dt*dt + du*du + dv*dv + ds*ds)
        sum_abs_error = sum_abs_error + norm
        i = i + 1
    }
    sum_abs_error / (n as f32)
}

// Octonion norm squared: |o|^2 = w^2 + x^2 + ... + s^2
fn oct_norm_squared(o: Octonion) -> f32 {
    o.w*o.w + o.x*o.x + o.y*o.y + o.z*o.z + o.t*o.t + o.u*o.u + o.v*o.v + o.s*o.s
}

// Octonion norm: |o| = sqrt(sum components^2)
fn oct_norm(o: Octonion) -> f32 {
    loss_sqrt(oct_norm_squared(o))
}
