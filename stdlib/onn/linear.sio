//! stdlib/onn/linear.sio - Octonion Linear Layers
//!
//! Fully connected (dense) layers for octonion neural networks.
//! Uses octonion multiplication (Hamilton product via Cayley-Dickson)
//! for weight-input products.
//!
//! Forward: y = W * x + b (octonion multiplication, 120 FLOPs per product)
//! Backward: Uses local linearization due to non-associativity

use std::onn::{Octonion, OctLinearLayer}

// Forward pass for octonion linear layer
// y[j] = sum_i(W[j,i] * x[i]) + b[j]
fn oct_linear_forward(
    layer: &OctLinearLayer,
    weights: &[Octonion],
    input: &[Octonion],
    bias: &[Octonion]
) -> [Octonion] {
    oct_linear_fwd(layer, weights, input, bias)
}

// Backward pass for octonion linear layer
// Returns (grad_input, grad_weights, grad_bias)
fn oct_linear_backward(
    layer: &OctLinearLayer,
    weights: &[Octonion],
    input: &[Octonion],
    grad_output: &[Octonion]
) -> ([Octonion], [Octonion], [Octonion]) {
    oct_linear_bwd(layer, weights, input, grad_output)
}

// Xavier/Glorot initialization for octonion weights
// Scale: sqrt(2 / (fan_in + fan_out)) per component
fn oct_xavier_init(fan_in: i32, fan_out: i32, seed: i32) -> [Octonion] {
    let scale = sqrt(2.0 / (fan_in + fan_out) as f32)
    var weights = [Octonion]::new((fan_in * fan_out) as usize)
    var rng_state = seed
    for i in 0..(fan_in * fan_out) as usize {
        // Simple LCG for reproducible randomness
        rng_state = (rng_state * 1103515245 + 12345) % 2147483648
        let r0 = ((rng_state % 1000) as f32 / 500.0 - 1.0) * scale
        rng_state = (rng_state * 1103515245 + 12345) % 2147483648
        let r1 = ((rng_state % 1000) as f32 / 500.0 - 1.0) * scale
        rng_state = (rng_state * 1103515245 + 12345) % 2147483648
        let r2 = ((rng_state % 1000) as f32 / 500.0 - 1.0) * scale
        rng_state = (rng_state * 1103515245 + 12345) % 2147483648
        let r3 = ((rng_state % 1000) as f32 / 500.0 - 1.0) * scale
        rng_state = (rng_state * 1103515245 + 12345) % 2147483648
        let r4 = ((rng_state % 1000) as f32 / 500.0 - 1.0) * scale
        rng_state = (rng_state * 1103515245 + 12345) % 2147483648
        let r5 = ((rng_state % 1000) as f32 / 500.0 - 1.0) * scale
        rng_state = (rng_state * 1103515245 + 12345) % 2147483648
        let r6 = ((rng_state % 1000) as f32 / 500.0 - 1.0) * scale
        rng_state = (rng_state * 1103515245 + 12345) % 2147483648
        let r7 = ((rng_state % 1000) as f32 / 500.0 - 1.0) * scale
        weights[i] = Octonion { w: r0, x: r1, y: r2, z: r3, t: r4, u: r5, v: r6, s: r7 }
    }
    weights
}

// He initialization for ReLU networks
// Scale: sqrt(2 / fan_in) per component
fn oct_he_init(fan_in: i32, fan_out: i32, seed: i32) -> [Octonion] {
    let scale = sqrt(2.0 / fan_in as f32)
    var weights = [Octonion]::new((fan_in * fan_out) as usize)
    var rng_state = seed
    for i in 0..(fan_in * fan_out) as usize {
        rng_state = (rng_state * 1103515245 + 12345) % 2147483648
        let r0 = ((rng_state % 1000) as f32 / 500.0 - 1.0) * scale
        rng_state = (rng_state * 1103515245 + 12345) % 2147483648
        let r1 = ((rng_state % 1000) as f32 / 500.0 - 1.0) * scale
        rng_state = (rng_state * 1103515245 + 12345) % 2147483648
        let r2 = ((rng_state % 1000) as f32 / 500.0 - 1.0) * scale
        rng_state = (rng_state * 1103515245 + 12345) % 2147483648
        let r3 = ((rng_state % 1000) as f32 / 500.0 - 1.0) * scale
        rng_state = (rng_state * 1103515245 + 12345) % 2147483648
        let r4 = ((rng_state % 1000) as f32 / 500.0 - 1.0) * scale
        rng_state = (rng_state * 1103515245 + 12345) % 2147483648
        let r5 = ((rng_state % 1000) as f32 / 500.0 - 1.0) * scale
        rng_state = (rng_state * 1103515245 + 12345) % 2147483648
        let r6 = ((rng_state % 1000) as f32 / 500.0 - 1.0) * scale
        rng_state = (rng_state * 1103515245 + 12345) % 2147483648
        let r7 = ((rng_state % 1000) as f32 / 500.0 - 1.0) * scale
        weights[i] = Octonion { w: r0, x: r1, y: r2, z: r3, t: r4, u: r5, v: r6, s: r7 }
    }
    weights
}

// Zero initialization for biases
fn oct_zero_init(size: i32) -> [Octonion] {
    var biases = [Octonion]::new(size as usize)
    for i in 0..size as usize {
        biases[i] = Octonion { w: 0.0, x: 0.0, y: 0.0, z: 0.0, t: 0.0, u: 0.0, v: 0.0, s: 0.0 }
    }
    biases
}
