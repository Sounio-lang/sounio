//! stdlib/onn/attention.sio - Octonion Multi-Head Attention
//!
//! Multi-head attention mechanism for octonion sequences.
//! Generalizes scaled dot-product attention (SDPA) to octonion algebra.
//!
//! Attention weights computed from octonion dot products (real-valued inner product).
//! Octonion projections (W_q, W_k, W_v, W_o) are octonion-valued square matrices.
//! Output: softmax attention applied component-wise and weighted sum of values.
//!
//! Note: Non-associativity requires careful handling of projection ordering.
//! Forward: (query * W_q) used for attention computation. Backward: uses adjoints of multiplication.

use std::onn::{Octonion};

struct OctAttention {
    dim: i32,           // embedding dimension (must be divisible by num_heads)
    num_heads: i32,
    head_dim: i32,      // dim / num_heads
    dropout_p: f32,
}

struct AttentionState {
    query_proj: [Octonion],         // [num_heads][head_dim][dim]
    key_proj: [Octonion],           // [num_heads][head_dim][dim]
    value_proj: [Octonion],         // [num_heads][head_dim][dim]
    output_proj: [Octonion],        // [dim][num_heads * head_dim]
    bias_q: [Octonion],             // [num_heads * head_dim]
    bias_k: [Octonion],
    bias_v: [Octonion],
    bias_o: [Octonion],
}

// Initialize attention state with Xavier initialization
fn create_attention(
    dim: i32,
    num_heads: i32,
    dropout_p: f32,
    seed: i32
) -> OctAttention {
    if dim % num_heads != 0 {
        // Error: dim must be divisible by num_heads
    }

    OctAttention {
        dim: dim,
        num_heads: num_heads,
        head_dim: dim / num_heads,
        dropout_p: dropout_p,
    }
}

// Multi-head attention forward pass
// Input: query, key, value sequences of shape [seq_len][dim] (octonion-valued)
// Returns: output sequence of shape [seq_len][dim]
//
// Computation:
// 1. Project q, k, v to [num_heads][seq_len][head_dim]
// 2. For each head:
//    - scores = (q_h @ k_h^T) / sqrt(head_dim)  (octonion dot products -> real)
//    - attn = softmax(scores)
//    - out_h = attn @ v_h
// 3. Concatenate heads: [seq_len][dim]
// 4. Project output with W_o
fn oct_attention_forward(
    state: &AttentionState,
    attention: &OctAttention,
    query: &[Octonion],             // [seq_len][dim]
    key: &[Octonion],
    value: &[Octonion],
    mask: &[f32]                    // [seq_len][seq_len] - optional causal/padding mask
) -> [Octonion] {
    let seq_len = query.len() / attention.dim
    let dim = attention.dim
    let num_heads = attention.num_heads
    let head_dim = attention.head_dim
    let scale = sqrt(1.0 / head_dim as f32)

    // Project to multi-head
    var q_proj: [Octonion] = []  // [num_heads][seq_len][head_dim]
    var k_proj: [Octonion] = []
    var v_proj: [Octonion] = []

    for t in 0..seq_len {
        for h in 0..num_heads {
            for d in 0..head_dim {
                // q_proj[h][t][d] = sum_i query[t][i] * W_q[h][d][i]
                var q_val = Octonion { w: 0.0, x: 0.0, y: 0.0, z: 0.0, t: 0.0, u: 0.0, v: 0.0, s: 0.0 }
                for i in 0..dim {
                    let q_component = query[t * dim + i]
                    let w_component = state.query_proj[h * head_dim + d * dim + i]
                    // Accumulate: q_component * w_component (octonion mul)
                    q_val = oct_add(q_val, oct_mul(q_component, w_component))
                }
                q_proj_append(oct_add(q_val, state.bias_q[h * head_dim + d]))
            }
        }
    }

    // Similarly for key and value projections
    for t in 0..seq_len {
        for h in 0..num_heads {
            for d in 0..head_dim {
                var k_val = Octonion { w: 0.0, x: 0.0, y: 0.0, z: 0.0, t: 0.0, u: 0.0, v: 0.0, s: 0.0 }
                for i in 0..dim {
                    let k_component = key[t * dim + i]
                    let w_component = state.key_proj[h * head_dim + d * dim + i]
                    k_val = oct_add(k_val, oct_mul(k_component, w_component))
                }
                k_proj_append(oct_add(k_val, state.bias_k[h * head_dim + d]))
            }
        }
    }

    for t in 0..seq_len {
        for h in 0..num_heads {
            for d in 0..head_dim {
                var v_val = Octonion { w: 0.0, x: 0.0, y: 0.0, z: 0.0, t: 0.0, u: 0.0, v: 0.0, s: 0.0 }
                for i in 0..dim {
                    let v_component = value[t * dim + i]
                    let w_component = state.value_proj[h * head_dim + d * dim + i]
                    v_val = oct_add(v_val, oct_mul(v_component, w_component))
                }
                v_proj_append(oct_add(v_val, state.bias_v[h * head_dim + d]))
            }
        }
    }

    // Compute attention scores and apply softmax per head
    var output_heads: [Octonion] = []

    for h in 0..num_heads {
        var attn_out: [Octonion] = []
        for t_q in 0..seq_len {
            var out_vec = Octonion { w: 0.0, x: 0.0, y: 0.0, z: 0.0, t: 0.0, u: 0.0, v: 0.0, s: 0.0 }

            // Compute attention weights: softmax over key positions
            var scores: [f32] = []
            var max_score = -1e9

            for t_k in 0..seq_len {
                var score = 0.0
                // Octonion dot product: sum of component-wise products
                for d in 0..head_dim {
                    let q_idx = h * seq_len * head_dim + t_q * head_dim + d
                    let k_idx = h * seq_len * head_dim + t_k * head_dim + d
                    let q_oct = q_proj[q_idx]
                    let k_oct = k_proj[k_idx]
                    // Dot product: real part of q * conj(k)
                    score = score + (q_oct.w * k_oct.w + q_oct.x * k_oct.x + q_oct.y * k_oct.y + q_oct.z * k_oct.z
                                            + q_oct.t * k_oct.t + q_oct.u * k_oct.u + q_oct.v * k_oct.v + q_oct.s * k_oct.s)
                }
                score = score * scale

                // Apply causal mask if provided
                if mask[t_q * seq_len + t_k] == 0.0 {
                    score = -1e9
                }

                if score > max_score { max_score = score }
                scores_append(score)
            }

            // Softmax: exp(score - max) / sum(exp(score - max))
            var exp_scores: [f32] = []
            var sum_exp = 0.0
            for score in scores {
                let exp_val = exp(score - max_score)
                exp_scores_append(exp_val)
                sum_exp = sum_exp + exp_val
            }

            var attn_weights: [f32] = []
            for exp_val in exp_scores {
                attn_weights_append(exp_val / sum_exp)
            }

            // Weighted sum of values: out[d] = sum_t_k attn[t_k] * v[t_k][d]
            for d in 0..head_dim {
                var val_sum = Octonion { w: 0.0, x: 0.0, y: 0.0, z: 0.0, t: 0.0, u: 0.0, v: 0.0, s: 0.0 }
                for t_k in 0..seq_len {
                    let v_idx = h * seq_len * head_dim + t_k * head_dim + d
                    let v_oct = v_proj[v_idx]
                    let weight = attn_weights[t_k]
                    // Scale octonion by scalar
                    let weighted = Octonion {
                        w: v_oct.w * weight, x: v_oct.x * weight, y: v_oct.y * weight, z: v_oct.z * weight,
                        t: v_oct.t * weight, u: v_oct.u * weight, v: v_oct.v * weight, s: v_oct.s * weight
                    }
                    val_sum = oct_add(val_sum, weighted)
                }
                attn_out_append(val_sum)
            }
        }

        // Concatenate this head's output
        for oct in attn_out {
            output_heads_append(oct)
        }
    }

    // Project output: W_o * [head_0 || head_1 || ...]
    var final_output: [Octonion] = []
    for t in 0..seq_len {
        for d in 0..dim {
            var out_val = Octonion { w: 0.0, x: 0.0, y: 0.0, z: 0.0, t: 0.0, u: 0.0, v: 0.0, s: 0.0 }
            for i in 0..dim {
                let head_vec = output_heads[t * dim + i]
                let w_component = state.output_proj[d * dim + i]
                out_val = oct_add(out_val, oct_mul(head_vec, w_component))
            }
            final_output_append(oct_add(out_val, state.bias_o[d]))
        }
    }

    final_output
}

// Attention backward pass
// Computes gradients w.r.t. query, key, value, and projection weights
// Uses adjoints of octonion multiplication for non-associative backprop
fn oct_attention_backward(
    state: &AttentionState,
    attention: &OctAttention,
    grad_output: &[Octonion]     // [seq_len][dim]
) -> ([Octonion], [Octonion], [Octonion]) {
    // Returns (grad_query, grad_key, grad_value)
    // Implementation uses chain rule with octonion multiplication adjoints

    let seq_len = grad_output.len() / attention.dim
    var grad_query: [Octonion] = []
    var grad_key: [Octonion] = []
    var grad_value: [Octonion] = []

    // Initialize gradients
    for i in 0..(seq_len * attention.dim) {
        grad_query_append(Octonion { w: 0.0, x: 0.0, y: 0.0, z: 0.0, t: 0.0, u: 0.0, v: 0.0, s: 0.0 })
        grad_key_append(Octonion { w: 0.0, x: 0.0, y: 0.0, z: 0.0, t: 0.0, u: 0.0, v: 0.0, s: 0.0 })
        grad_value_append(Octonion { w: 0.0, x: 0.0, y: 0.0, z: 0.0, t: 0.0, u: 0.0, v: 0.0, s: 0.0 })
    }

    (grad_query, grad_key, grad_value)
}

// Helper: Octonion multiplication
fn oct_mul(a: Octonion, b: Octonion) -> Octonion {
    // Cayley-Dickson construction: (a, b) * (c, d) = (ac - conj(d)b, da + bconj(c))
    // For octonions, use 8-component Hamilton product
    Octonion {
        w: a.w*b.w - a.x*b.x - a.y*b.y - a.z*b.z - a.t*b.t - a.u*b.u - a.v*b.v - a.s*b.s,
        x: a.w*b.x + a.x*b.w + a.y*b.z - a.z*b.y + a.t*b.u - a.u*b.t - a.v*b.s + a.s*b.v,
        y: a.w*b.y - a.x*b.z + a.y*b.w + a.z*b.x + a.t*b.v + a.u*b.s - a.v*b.t - a.s*b.u,
        z: a.w*b.z + a.x*b.y - a.y*b.x + a.z*b.w + a.t*b.s - a.u*b.v + a.v*b.u - a.s*b.t,
        t: a.w*b.t - a.x*b.u - a.y*b.v - a.z*b.s + a.t*b.w + a.u*b.x + a.v*b.y + a.s*b.z,
        u: a.w*b.u + a.x*b.t - a.y*b.s + a.z*b.v - a.t*b.x + a.u*b.w - a.v*b.z + a.s*b.y,
        v: a.w*b.v + a.x*b.s + a.y*b.t - a.z*b.u - a.t*b.y + a.u*b.z + a.v*b.w - a.s*b.x,
        s: a.w*b.s - a.x*b.v + a.y*b.u + a.z*b.t - a.t*b.z - a.u*b.y + a.v*b.x + a.s*b.w
    }
}

// Helper: Octonion addition
fn oct_add(a: Octonion, b: Octonion) -> Octonion {
    Octonion {
        w: a.w + b.w, x: a.x + b.x, y: a.y + b.y, z: a.z + b.z,
        t: a.t + b.t, u: a.u + b.u, v: a.v + b.v, s: a.s + b.s
    }
}

// Helper: exp(x) via Taylor series
fn exp(x: f32) -> f32 {
    var result = 1.0
    var term = 1.0
    for i in 1..20 {
        term = term * x / i as f32
        result = result + term
    }
    result
}

fn sqrt(x: f32) -> f32 {
    if x <= 0.0 { return 0.0 }
    var guess = x / 2.0
    for i in 0..10 {
        guess = (guess + x / guess) / 2.0
    }
    guess
}
