//! stdlib/onn/conv.sio - Octonion Convolution Layers
//!
//! 2D convolution and pooling layers for octonion neural networks.
//! Uses octonion multiplication (Cayley-Dickson, 120 FLOPs per product)
//! for kernel-input convolutions.
//!
//! Forward: out = kernel * input + bias (spatial 2D convolution)
//! Backward: Uses local linearization for non-associative backprop
//! Pooling: Max-pooling by norm-squared (|o|^2 = sum e_i^2)

use std::onn::{Octonion, OctConv2dLayer}

// Forward pass for octonion 2D convolution
// out[oc][oh][ow] = sum_ic sum_kh sum_kw input[ic][ih+kh][iw+kw] * kernel[oc][ic][kh][kw] + bias[oc]
// Forward pass delegates to GPU kernel via intrinsic
fn oct_conv2d_forward(
    layer: &OctConv2dLayer,
    kernel: &[Octonion],
    input: &[Octonion],
    bias: &[Octonion]
) -> [Octonion] {
    // Kernel shape: [out_channels][in_channels][kernel_h][kernel_w]
    // Input shape: [batch][in_channels][height][width]
    // Output shape: [batch][out_channels][out_height][out_width]
    // Delegates to GPU OctonionConv2dFwd intrinsic
    oct_conv2d_fwd(layer, kernel, input, bias)
}

// Backward pass for octonion 2D convolution
// Returns (grad_input, grad_kernel, grad_bias)
// Uses adjoint of bilinear multiplication: (a * b)* = b* * a* (quaternion-like conjugate adjoints)
// Non-associativity handled via local linearization: compute Jacobians at forward values
fn oct_conv2d_backward(
    layer: &OctConv2dLayer,
    kernel: &[Octonion],
    input: &[Octonion],
    grad_output: &[Octonion]
) -> ([Octonion], [Octonion], [Octonion]) {
    oct_conv2d_bwd(layer, kernel, input, grad_output)
}

// Max pooling over octonions by norm-squared
// Selects octonion with maximum |o|^2 = w^2 + x^2 + y^2 + z^2 + t^2 + u^2 + v^2 + s^2
// in each kernel window. Returns (output, indices).
// Indices stored as flattened offsets within kernel for backprop routing.
fn oct_maxpool2d_forward(
    input: &[Octonion],
    batch_size: i32,
    channels: i32,
    height: i32,
    width: i32,
    kernel_size: i32,
    stride: i32,
    padding: i32
) -> ([Octonion], [i32]) {
    var output: [Octonion] = []
    var indices: [i32] = []

    let out_h = ((height + 2 * padding - kernel_size) / stride) + 1
    let out_w = ((width + 2 * padding - kernel_size) / stride) + 1

    for b in 0..batch_size {
        for c in 0..channels {
            for oh in 0..out_h {
                for ow in 0..out_w {
                    let ih_start = oh * stride - padding
                    let iw_start = ow * stride - padding

                    var max_norm_sq = 0.0
                    var max_idx = 0
                    var max_octonion = Octonion { w: 0.0, x: 0.0, y: 0.0, z: 0.0, t: 0.0, u: 0.0, v: 0.0, s: 0.0 }

                    for kh in 0..kernel_size {
                        let ih = ih_start + kh
                        if ih < 0 || ih >= height { continue }
                        for kw in 0..kernel_size {
                            let iw = iw_start + kw
                            if iw < 0 || iw >= width { continue }

                            let input_idx = b * channels * height * width
                                          + c * height * width
                                          + ih * width
                                          + iw
                            let oct = input[input_idx]
                            let norm_sq = oct.w * oct.w + oct.x * oct.x + oct.y * oct.y + oct.z * oct.z
                                        + oct.t * oct.t + oct.u * oct.u + oct.v * oct.v + oct.s * oct.s

                            if norm_sq > max_norm_sq {
                                max_norm_sq = norm_sq
                                max_octonion = oct
                                max_idx = kh * kernel_size + kw
                            }
                        }
                    }

                    output_append(max_octonion)
                    indices_append(max_idx)
                }
            }
        }
    }

    (output, indices)
}

// Max pooling backward: route gradients only to max element position
fn oct_maxpool2d_backward(
    grad_output: &[Octonion],
    indices: &[i32],
    batch_size: i32,
    channels: i32,
    height: i32,
    width: i32,
    kernel_size: i32,
    stride: i32,
    padding: i32
) -> [Octonion] {
    var grad_input: [Octonion] = []
    for i in 0..(batch_size * channels * height * width) {
        grad_input_append(Octonion { w: 0.0, x: 0.0, y: 0.0, z: 0.0, t: 0.0, u: 0.0, v: 0.0, s: 0.0 })
    }

    let out_h = ((height + 2 * padding - kernel_size) / stride) + 1
    let out_w = ((width + 2 * padding - kernel_size) / stride) + 1
    let mut grad_idx = 0

    for b in 0..batch_size {
        for c in 0..channels {
            for oh in 0..out_h {
                for ow in 0..out_w {
                    let ih_start = oh * stride - padding
                    let iw_start = ow * stride - padding
                    let max_idx = indices[grad_idx]
                    let max_kh = max_idx / kernel_size
                    let max_kw = max_idx % kernel_size

                    let ih = ih_start + max_kh
                    let iw = iw_start + max_kw

                    if ih >= 0 && ih < height && iw >= 0 && iw < width {
                        let input_idx = b * channels * height * width + c * height * width + ih * width + iw
                        grad_input[input_idx] = grad_output[grad_idx]
                    }

                    grad_idx = grad_idx + 1
                }
            }
        }
    }

    grad_input
}

// Xavier/Glorot initialization for conv kernels
// Scale per component: sqrt(2 / (fan_in + fan_out))
// fan_in = in_channels * kernel_h * kernel_w
// fan_out = out_channels
fn oct_conv_xavier_init(
    in_channels: i32,
    out_channels: i32,
    kernel_h: i32,
    kernel_w: i32,
    seed: i32
) -> [Octonion] {
    let fan_in = in_channels * kernel_h * kernel_w
    let fan_out = out_channels
    let scale = sqrt(2.0 / (fan_in + fan_out) as f32)

    var kernel: [Octonion] = []
    var rng_state = seed

    let total_params = out_channels * in_channels * kernel_h * kernel_w
    for i in 0..total_params {
        var components: [f32] = []
        for j in 0..8 {
            rng_state = (rng_state * 1103515245 + 12345) % 2147483648
            let val = ((rng_state % 1000) as f32 / 500.0 - 1.0) * scale
            components_append(val)
        }

        let oct = Octonion {
            w: components[0], x: components[1], y: components[2], z: components[3],
            t: components[4], u: components[5], v: components[6], s: components[7]
        }
        kernel_append(oct)
    }

    kernel
}

// He initialization for ReLU-based conv networks
// Scale per component: sqrt(2 / fan_in)
fn oct_conv_he_init(
    in_channels: i32,
    out_channels: i32,
    kernel_h: i32,
    kernel_w: i32,
    seed: i32
) -> [Octonion] {
    let fan_in = in_channels * kernel_h * kernel_w
    let scale = sqrt(2.0 / fan_in as f32)

    var kernel: [Octonion] = []
    var rng_state = seed

    let total_params = out_channels * in_channels * kernel_h * kernel_w
    for i in 0..total_params {
        var components: [f32] = []
        for j in 0..8 {
            rng_state = (rng_state * 1103515245 + 12345) % 2147483648
            let val = ((rng_state % 1000) as f32 / 500.0 - 1.0) * scale
            components_append(val)
        }

        let oct = Octonion {
            w: components[0], x: components[1], y: components[2], z: components[3],
            t: components[4], u: components[5], v: components[6], s: components[7]
        }
        kernel_append(oct)
    }

    kernel
}

fn sqrt(x: f32) -> f32 {
    if x <= 0.0 { return 0.0 }
    var guess = x / 2.0
    for i in 0..10 {
        guess = (guess + x / guess) / 2.0
    }
    guess
}
