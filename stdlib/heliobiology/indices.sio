//! stdlib/heliobiology/indices.sio - Geomagnetic and solar activity indices
//!
//! Type-safe representations of standard space weather indices with
//! refinement types ensuring valid ranges.
//!
//! References:
//! - NOAA Space Weather Scales: https://www.swpc.noaa.gov/noaa-scales-explanation
//! - IAGA geomagnetic indices: https://www.ngdc.noaa.gov/IAGA/vdat/

module heliobiology::indices

use heliobiology::units::{nT, SFU, pfu, TECU}

// =============================================================================
// GEOMAGNETIC INDICES
// =============================================================================

/// Kp index - Planetary K-index (3-hour quasi-logarithmic)
/// Range: 0 to 9 in thirds (0, 0+, 1-, 1, 1+, ... 9-, 9)
/// Derived from K indices of 13 mid-latitude stations
type Kp = { x: f64 | 0.0 <= x && x <= 9.0 }

/// Kp storm levels (NOAA G-scale mapping)
pub enum KpStormLevel {
    Quiet,      // Kp 0-4
    G1Minor,    // Kp 5
    G2Moderate, // Kp 6
    G3Strong,   // Kp 7
    G4Severe,   // Kp 8
    G5Extreme,  // Kp 9
}

/// Convert Kp to storm level
pub fn kp_to_storm_level(kp: Kp) -> KpStormLevel {
    if kp < 5.0 {
        KpStormLevel::Quiet
    } else if kp < 6.0 {
        KpStormLevel::G1Minor
    } else if kp < 7.0 {
        KpStormLevel::G2Moderate
    } else if kp < 8.0 {
        KpStormLevel::G3Strong
    } else if kp < 9.0 {
        KpStormLevel::G4Severe
    } else {
        KpStormLevel::G5Extreme
    }
}

/// Ap index - Daily planetary amplitude (linear, nT)
/// 24-hour average derived from eight 3-hour Kp values
/// Range: 0 to ~400 nT (typically 0-100 for quiet to moderate)
type Ap = { x: f64 | x >= 0.0 }

/// Dst index - Disturbance Storm Time (hourly, nT)
/// Measures ring current intensity; negative = storm
/// Range: typically -500 to +100 nT
type Dst = { x: f64 | -600.0 <= x && x <= 200.0 }

/// Dst storm classification
pub enum DstStormClass {
    Quiet,       // Dst > -30 nT
    Weak,        // -50 < Dst <= -30 nT
    Moderate,    // -100 < Dst <= -50 nT
    Intense,     // -200 < Dst <= -100 nT
    SuperStorm,  // Dst <= -200 nT
}

/// Classify Dst value
pub fn classify_dst(dst: Dst) -> DstStormClass {
    if dst > -30.0 {
        DstStormClass::Quiet
    } else if dst > -50.0 {
        DstStormClass::Weak
    } else if dst > -100.0 {
        DstStormClass::Moderate
    } else if dst > -200.0 {
        DstStormClass::Intense
    } else {
        DstStormClass::SuperStorm
    }
}

/// AE index - Auroral Electrojet (nT)
/// Measures auroral zone magnetic activity
type AE = { x: f64 | x >= 0.0 }

/// SYM-H index - High-resolution Dst equivalent (1-minute)
type SymH = { x: f64 | -600.0 <= x && x <= 200.0 }

/// ASY-H index - Asymmetric ring current component
type AsyH = { x: f64 | x >= 0.0 }

// =============================================================================
// INTERPLANETARY MAGNETIC FIELD (IMF)
// =============================================================================

/// IMF Bz component (north-south, most geoeffective)
/// Negative Bz = southward, enables geomagnetic coupling
type Bz = nT

/// IMF Bt - Total field magnitude
type Bt = { x: nT | x >= 0.0 }

/// IMF clock angle (radians, 0 = northward, π = southward)
type ClockAngle = { theta: f64 | 0.0 <= theta && theta <= 2.0 * PI }
    where PI = 3.141592653589793

/// IMF vector in GSM coordinates
pub struct IMFVector {
    pub bx: nT,
    pub by: nT,
    pub bz: Bz,
}

impl IMFVector {
    /// Total field magnitude
    pub fn magnitude(self) -> Bt {
        sqrt(self.bx * self.bx + self.by * self.by + self.bz * self.bz)
    }

    /// Clock angle in Y-Z plane
    pub fn clock_angle(self) -> ClockAngle {
        atan2(self.by, self.bz) + PI
    }

    /// Geoeffectiveness metric (southward Bz component)
    pub fn geoeffective_bz(self) -> nT {
        if self.bz < 0.0 { -self.bz } else { 0.0 : nT }
    }
}

// =============================================================================
// SOLAR ACTIVITY INDICES
// =============================================================================

/// F10.7 index - 10.7 cm solar radio flux (SFU)
/// Proxy for solar EUV; correlates with sunspot number
/// Range: ~65 (solar minimum) to ~300+ (solar maximum)
type F10_7 = { x: f64 | x >= 50.0 }

/// International Sunspot Number (monthly smoothed)
type SunspotNumber = { x: f64 | x >= 0.0 }

/// MgII core-to-wing ratio (UV activity proxy)
type MgII = { x: f64 | 0.15 <= x && x <= 0.35 }

// =============================================================================
// RADIATION INDICES
// =============================================================================

/// GOES proton flux >10 MeV (pfu)
/// S-scale threshold: S1 at 10 pfu
type ProtonFlux10 = { x: f64 | x >= 0.0 }

/// GOES proton flux >100 MeV (pfu)
type ProtonFlux100 = { x: f64 | x >= 0.0 }

/// NOAA S-scale (Solar Radiation Storm)
pub enum SScale {
    S1Minor,    // 10 pfu
    S2Moderate, // 100 pfu
    S3Strong,   // 1000 pfu
    S4Severe,   // 10000 pfu
    S5Extreme,  // 100000 pfu
}

/// Classify proton event by >10 MeV flux
pub fn classify_proton_storm(flux: ProtonFlux10) -> Option<SScale> {
    if flux >= 100000.0 {
        Some(SScale::S5Extreme)
    } else if flux >= 10000.0 {
        Some(SScale::S4Severe)
    } else if flux >= 1000.0 {
        Some(SScale::S3Strong)
    } else if flux >= 100.0 {
        Some(SScale::S2Moderate)
    } else if flux >= 10.0 {
        Some(SScale::S1Minor)
    } else {
        None  // Below storm threshold
    }
}

// =============================================================================
// IONOSPHERIC INDICES
// =============================================================================

/// Global TEC (Total Electron Content)
type GlobalTEC = TECU

/// foF2 - Critical frequency of F2 layer (MHz)
type FoF2 = { x: f64 | x > 0.0 }

/// hmF2 - Peak height of F2 layer (km)
type HmF2 = { x: f64 | 150.0 <= x && x <= 500.0 }

// =============================================================================
// COMPOSITE INDICES
// =============================================================================

/// Newell coupling function (solar wind-magnetosphere coupling)
/// dΦ/dt ∝ v^(4/3) * Bt^(2/3) * sin^(8/3)(θ/2)
pub struct NewellCoupling {
    pub value: f64,  // Wb/s equivalent
}

/// Calculate Newell coupling function
pub fn newell_coupling(
    v_sw: f64,        // Solar wind speed (km/s)
    bt: Bt,           // IMF total field (nT)
    clock: ClockAngle // IMF clock angle
) -> NewellCoupling {
    let sin_half = sin(clock / 2.0)
    let coupling = pow(v_sw, 4.0/3.0) * pow(bt, 2.0/3.0) * pow(sin_half, 8.0/3.0)
    NewellCoupling { value: coupling * 1e3 }  // Scale factor
}

/// Space weather summary structure
pub struct SpaceWeatherState {
    pub kp: Kp,
    pub dst: Dst,
    pub bz: Bz,
    pub f10_7: F10_7,
    pub proton_flux: ProtonFlux10,
}

impl SpaceWeatherState {
    /// Overall activity level assessment
    pub fn activity_level(self) -> string {
        let g_level = kp_to_storm_level(self.kp)
        let dst_level = classify_dst(self.dst)

        match (g_level, dst_level) {
            (KpStormLevel::G5Extreme, _) => "Extreme",
            (KpStormLevel::G4Severe, _) => "Severe",
            (_, DstStormClass::SuperStorm) => "Severe",
            (KpStormLevel::G3Strong, _) => "Strong",
            (_, DstStormClass::Intense) => "Strong",
            (KpStormLevel::G2Moderate, _) => "Moderate",
            (KpStormLevel::G1Minor, _) => "Minor",
            _ => "Quiet",
        }
    }
}
