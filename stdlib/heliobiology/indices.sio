// heliobiology/indices.sio - Geomagnetic and solar activity indices
//
// Type-safe representations of standard space weather indices.
//
// References:
// - NOAA Space Weather Scales
// - IAGA geomagnetic indices

// Kp storm levels (NOAA G-scale mapping) as i32 constants
fn KP_QUIET() -> i32 { 0 }
fn KP_G1_MINOR() -> i32 { 1 }
fn KP_G2_MODERATE() -> i32 { 2 }
fn KP_G3_STRONG() -> i32 { 3 }
fn KP_G4_SEVERE() -> i32 { 4 }
fn KP_G5_EXTREME() -> i32 { 5 }

// Convert Kp to storm level
fn kp_to_storm_level(kp: f64) -> i32 {
    if kp < 5.0 {
        return KP_QUIET()
    }
    if kp < 6.0 {
        return KP_G1_MINOR()
    }
    if kp < 7.0 {
        return KP_G2_MODERATE()
    }
    if kp < 8.0 {
        return KP_G3_STRONG()
    }
    if kp < 9.0 {
        return KP_G4_SEVERE()
    }
    return KP_G5_EXTREME()
}

// Dst storm classification
fn DST_QUIET() -> i32 { 0 }
fn DST_WEAK() -> i32 { 1 }
fn DST_MODERATE() -> i32 { 2 }
fn DST_INTENSE() -> i32 { 3 }
fn DST_SUPERSTORM() -> i32 { 4 }

// Classify Dst value
fn classify_dst(dst: f64) -> i32 {
    if dst > 0.0 - 30.0 {
        return DST_QUIET()
    }
    if dst > 0.0 - 50.0 {
        return DST_WEAK()
    }
    if dst > 0.0 - 100.0 {
        return DST_MODERATE()
    }
    if dst > 0.0 - 200.0 {
        return DST_INTENSE()
    }
    return DST_SUPERSTORM()
}

// NOAA S-scale (Solar Radiation Storm)
fn S_SCALE_S1() -> i32 { 1 }
fn S_SCALE_S2() -> i32 { 2 }
fn S_SCALE_S3() -> i32 { 3 }
fn S_SCALE_S4() -> i32 { 4 }
fn S_SCALE_S5() -> i32 { 5 }
fn S_SCALE_NONE() -> i32 { 0 }

// Classify proton event by >10 MeV flux
// Returns 0 for below threshold, 1-5 for S1-S5
fn classify_proton_storm(flux: f64) -> i32 {
    if flux >= 100000.0 {
        return S_SCALE_S5()
    }
    if flux >= 10000.0 {
        return S_SCALE_S4()
    }
    if flux >= 1000.0 {
        return S_SCALE_S3()
    }
    if flux >= 100.0 {
        return S_SCALE_S2()
    }
    if flux >= 10.0 {
        return S_SCALE_S1()
    }
    return S_SCALE_NONE()
}

// IMF vector in GSM coordinates
pub struct IMFVector {
    bx: f64,
    by: f64,
    bz: f64
}

extern "C" {
    fn sqrt(x: f64) -> f64;
}

// Total field magnitude
fn imf_magnitude(v: IMFVector) -> f64 {
    return sqrt(v.bx * v.bx + v.by * v.by + v.bz * v.bz)
}

// Geoeffectiveness metric (southward Bz component, positive = geoeffective)
fn imf_geoeffective_bz(v: IMFVector) -> f64 {
    if v.bz < 0.0 { return 0.0 - v.bz }
    return 0.0
}

// Space weather summary structure
pub struct SpaceWeatherState {
    kp: f64,
    dst: f64,
    bz: f64,
    f10_7: f64,
    proton_flux: f64
}

// Overall activity level: 0=quiet, 1=minor, 2=moderate, 3=strong, 4=severe, 5=extreme
fn activity_level(state: SpaceWeatherState) -> i32 {
    let g_level = kp_to_storm_level(state.kp)
    let dst_level = classify_dst(state.dst)

    if g_level >= KP_G5_EXTREME() { return 5 }
    if g_level >= KP_G4_SEVERE() { return 4 }
    if dst_level >= DST_SUPERSTORM() { return 4 }
    if g_level >= KP_G3_STRONG() { return 3 }
    if dst_level >= DST_INTENSE() { return 3 }
    if g_level >= KP_G2_MODERATE() { return 2 }
    if g_level >= KP_G1_MINOR() { return 1 }
    return 0
}

fn indices_main() {
    let level = kp_to_storm_level(7.5)
    println("Kp 7.5 storm level: ", level)

    let dst_class = classify_dst(0.0 - 150.0)
    println("Dst -150 class: ", dst_class)

    let s = classify_proton_storm(500.0)
    println("500 pfu S-scale: ", s)
}
