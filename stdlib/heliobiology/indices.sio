// heliobiology/indices.sio - Geomagnetic and solar activity indices
//
// Every threshold below is a published definition (#2835):
// - G and S scales: NOAA Space Weather Scales, "Physical measure" column,
//   https://www.swpc.noaa.gov/noaa-scales-explanation
//   (G1..G5 = Kp 5, 6, 7, 8 (including 9-), 9; S1..S5 = >=10 MeV integral
//   proton flux 10, 1e2, 1e3, 1e4, 1e5 pfu).
// - Dst storm classes: K. Mursula, T. Qvick, L. Holappa, T. Asikainen,
//   "Magnetic storms during the space age: occurrence and relation to varying
//   solar activity", J. Geophys. Res. Space Physics 127, e2022JA030830 (2022),
//   doi:10.1029/2022JA030830, Section 4: weak -50 < Dst <= -30 nT,
//   moderate -100 < Dst <= -50, intense -200 < Dst <= -100, major Dst <= -200.
// These are definitions, so they carry no uncertainty.

// Kp storm levels (NOAA G scale) as i32 constants
pub fn KP_QUIET() -> i32 { 0 }
pub fn KP_G1_MINOR() -> i32 { 1 }
pub fn KP_G2_MODERATE() -> i32 { 2 }
pub fn KP_G3_STRONG() -> i32 { 3 }
pub fn KP_G4_SEVERE() -> i32 { 4 }
pub fn KP_G5_EXTREME() -> i32 { 5 }

// Convert Kp to storm level
pub fn kp_to_storm_level(kp: f64) -> i32 {
    if kp < 5.0 {
        return KP_QUIET()
    }
    if kp < 6.0 {
        return KP_G1_MINOR()
    }
    if kp < 7.0 {
        return KP_G2_MODERATE()
    }
    if kp < 8.0 {
        return KP_G3_STRONG()
    }
    if kp < 9.0 {
        return KP_G4_SEVERE()
    }
    return KP_G5_EXTREME()
}

// Dst storm classification (Mursula et al. 2022, Section 4)
pub fn DST_QUIET() -> i32 { 0 }       // Dst > -30 nT: no storm
pub fn DST_WEAK() -> i32 { 1 }
pub fn DST_MODERATE() -> i32 { 2 }
pub fn DST_INTENSE() -> i32 { 3 }
pub fn DST_MAJOR() -> i32 { 4 }       // "Major" in the source

// Classify a storm's Dst minimum (nT)
pub fn classify_dst(dst: f64) -> i32 {
    if dst > 0.0 - 30.0 {
        return DST_QUIET()
    }
    if dst > 0.0 - 50.0 {
        return DST_WEAK()
    }
    if dst > 0.0 - 100.0 {
        return DST_MODERATE()
    }
    if dst > 0.0 - 200.0 {
        return DST_INTENSE()
    }
    return DST_MAJOR()
}

// NOAA S-scale (Solar Radiation Storm)
pub fn S_SCALE_S1() -> i32 { 1 }
pub fn S_SCALE_S2() -> i32 { 2 }
pub fn S_SCALE_S3() -> i32 { 3 }
pub fn S_SCALE_S4() -> i32 { 4 }
pub fn S_SCALE_S5() -> i32 { 5 }
pub fn S_SCALE_NONE() -> i32 { 0 }

// Classify proton event by >10 MeV flux
// Returns 0 for below threshold, 1-5 for S1-S5
pub fn classify_proton_storm(flux: f64) -> i32 {
    if flux >= 100000.0 {
        return S_SCALE_S5()
    }
    if flux >= 10000.0 {
        return S_SCALE_S4()
    }
    if flux >= 1000.0 {
        return S_SCALE_S3()
    }
    if flux >= 100.0 {
        return S_SCALE_S2()
    }
    if flux >= 10.0 {
        return S_SCALE_S1()
    }
    return S_SCALE_NONE()
}

// IMF vector in GSM coordinates
pub struct IMFVector {
    pub bx: f64,
    pub by: f64,
    pub bz: f64
}

extern "C" {
    fn sqrt(x: f64) -> f64;
}

// Total field magnitude
pub fn imf_magnitude(v: IMFVector) -> f64 {
    return sqrt(v.bx * v.bx + v.by * v.by + v.bz * v.bz)
}

// Geoeffectiveness metric (southward Bz component, positive = geoeffective)
pub fn imf_geoeffective_bz(v: IMFVector) -> f64 {
    if v.bz < 0.0 { return 0.0 - v.bz }
    return 0.0
}

// Space weather summary structure
pub struct SpaceWeatherState {
    pub kp: f64,
    pub dst: f64,
    pub bz: f64,
    pub f10_7: f64,
    pub proton_flux: f64
}
