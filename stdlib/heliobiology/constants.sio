//! stdlib/heliobiology/constants.sio - Heliophysics constants
//!
//! Physical constants for solar, heliospheric, and geomagnetic calculations.
//! Values from NASA/GSFC, NOAA/NGDC, and IAU.

module heliobiology::constants

use heliobiology::units::{T, nT, W_per_m2, km_per_s}

// =============================================================================
// SOLAR CONSTANTS
// =============================================================================

/// Total Solar Irradiance at 1 AU (W/m²)
/// Value: SORCE/TIM mission average
pub const TSI: f64 = 1360.8

/// Solar luminosity (W)
pub const L_SUN: f64 = 3.828e26

/// Mean Sun-Earth distance (m) - 1 AU
pub const AU: f64 = 1.495978707e11

/// Solar radius (m)
pub const R_SUN: f64 = 6.9634e8

/// Solar mass (kg)
pub const M_SUN: f64 = 1.98892e30

/// Solar rotation period at equator (days)
pub const P_SUN_EQ: f64 = 25.05

/// Solar rotation period at poles (days)
pub const P_SUN_POLE: f64 = 34.4

/// Carrington rotation period (days) - synodic at Earth
pub const CARRINGTON_PERIOD: f64 = 27.2753

// =============================================================================
// SOLAR WIND (TYPICAL VALUES)
// =============================================================================

/// Slow solar wind speed (km/s)
pub const V_SW_SLOW: f64 = 400.0

/// Fast solar wind speed (km/s)
pub const V_SW_FAST: f64 = 750.0

/// Typical solar wind density at 1 AU (particles/cm³)
pub const N_SW_TYPICAL: f64 = 5.0

/// Typical IMF magnitude at 1 AU (nT)
pub const B_IMF_TYPICAL: f64 = 5.0

/// Parker spiral angle at 1 AU (degrees)
pub const PARKER_ANGLE: f64 = 45.0

// =============================================================================
// EARTH'S MAGNETIC FIELD
// =============================================================================

/// Earth's dipole moment (T·m³)
pub const EARTH_DIPOLE: f64 = 7.94e22

/// Surface field at equator (nT)
pub const B_EARTH_EQ: f64 = 31000.0

/// Surface field at poles (nT)
pub const B_EARTH_POLE: f64 = 62000.0

/// Magnetopause standoff distance (quiet, Earth radii)
pub const MAGNETOPAUSE_R: f64 = 10.0

/// Earth radius (m)
pub const R_EARTH: f64 = 6.371e6

/// Geosynchronous orbit radius (Earth radii)
pub const R_GEO: f64 = 6.6

// =============================================================================
// GEOMAGNETIC LATITUDE BOUNDARIES
// =============================================================================

/// Auroral zone equatorward boundary (quiet, degrees)
pub const AURORAL_BOUNDARY_QUIET: f64 = 67.0

/// Auroral zone equatorward boundary (storm, degrees)
pub const AURORAL_BOUNDARY_STORM: f64 = 55.0

/// Polar cap boundary (quiet, degrees)
pub const POLAR_CAP_QUIET: f64 = 78.0

// =============================================================================
// IONOSPHERIC PARAMETERS
// =============================================================================

/// E-layer peak altitude (km)
pub const H_E_LAYER: f64 = 110.0

/// F2-layer peak altitude (km, typical)
pub const H_F2_LAYER: f64 = 300.0

/// TEC unit definition (electrons/m²)
pub const TECU: f64 = 1e16

// =============================================================================
// RADIATION ENVIRONMENT
// =============================================================================

/// Galactic cosmic ray flux at solar minimum (particles/cm²/s)
pub const GCR_SOLAR_MIN: f64 = 4.0

/// Galactic cosmic ray flux at solar maximum (particles/cm²/s)
pub const GCR_SOLAR_MAX: f64 = 2.5

/// ISS orbit altitude (km)
pub const ISS_ALTITUDE: f64 = 420.0

/// ISS orbit inclination (degrees)
pub const ISS_INCLINATION: f64 = 51.6

/// South Atlantic Anomaly center latitude (degrees)
pub const SAA_LAT: f64 = -25.0

/// South Atlantic Anomaly center longitude (degrees)
pub const SAA_LON: f64 = -55.0

// =============================================================================
// SCHUMANN RESONANCE
// =============================================================================

/// Schumann resonance fundamental frequency (Hz)
pub const SCHUMANN_F1: f64 = 7.83

/// Schumann resonance 2nd harmonic (Hz)
pub const SCHUMANN_F2: f64 = 14.3

/// Schumann resonance 3rd harmonic (Hz)
pub const SCHUMANN_F3: f64 = 20.8

/// Schumann resonance 4th harmonic (Hz)
pub const SCHUMANN_F4: f64 = 27.3

// =============================================================================
// HISTORICAL EXTREME EVENTS
// =============================================================================

/// Carrington Event (1859) estimated Dst (nT)
pub const CARRINGTON_DST: f64 = -1760.0

/// March 1989 storm Dst (nT)
pub const MARCH_1989_DST: f64 = -589.0

/// Halloween 2003 storm Dst (nT)
pub const HALLOWEEN_2003_DST: f64 = -383.0

/// Largest recorded X-ray flare class intensity (X28+)
pub const LARGEST_FLARE: f64 = 28.0

/// Fastest CME recorded (km/s, 2012)
pub const FASTEST_CME: f64 = 3500.0

// =============================================================================
// UNIT CONVERSIONS
// =============================================================================

/// Gauss to Tesla
pub const GAUSS_TO_TESLA: f64 = 1e-4

/// Gamma to nanotesla (identity)
pub const GAMMA_TO_NT: f64 = 1.0

/// Solar Flux Unit to SI (W/m²/Hz)
pub const SFU_TO_SI: f64 = 1e-22

/// MeV to Joules
pub const MEV_TO_J: f64 = 1.602176634e-13
