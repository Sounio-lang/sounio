// heliobiology/solar.sio - Solar event types and classification
//
// Types for solar flares, coronal mass ejections (CMEs), solar energetic
// particle (SEP) events, and related phenomena.

extern "C" {
    fn sqrt(x: f64) -> f64;
    fn exp(x: f64) -> f64;
}

// X-ray flare class constants
fn FLARE_A() -> i32 { 0 }
fn FLARE_B() -> i32 { 1 }
fn FLARE_C() -> i32 { 2 }
fn FLARE_M() -> i32 { 3 }
fn FLARE_X() -> i32 { 4 }

// Flare designation
struct FlareDesignation {
    flare_class: i32,
    intensity: f64
}

fn flare_new(flare_class: i32, intensity: f64) -> FlareDesignation {
    return FlareDesignation { flare_class: flare_class, intensity: intensity }
}

// Peak X-ray flux in W/m^2
fn flare_peak_flux(f: FlareDesignation) -> f64 {
    var base = 1.0e-8
    if f.flare_class == FLARE_B() { base = 1.0e-7 }
    if f.flare_class == FLARE_C() { base = 1.0e-6 }
    if f.flare_class == FLARE_M() { base = 1.0e-5 }
    if f.flare_class == FLARE_X() { base = 1.0e-4 }
    return base * f.intensity
}

// NOAA R-scale constants
fn R_NONE() -> i32 { 0 }
fn R1_MINOR() -> i32 { 1 }
fn R2_MODERATE() -> i32 { 2 }
fn R3_STRONG() -> i32 { 3 }
fn R4_SEVERE() -> i32 { 4 }
fn R5_EXTREME() -> i32 { 5 }

// Radio blackout scale from flare
fn flare_radio_scale(f: FlareDesignation) -> i32 {
    if f.flare_class == FLARE_X() {
        if f.intensity >= 20.0 { return R5_EXTREME() }
        if f.intensity >= 10.0 { return R4_SEVERE() }
        return R3_STRONG()
    }
    if f.flare_class == FLARE_M() {
        if f.intensity >= 5.0 { return R2_MODERATE() }
        if f.intensity >= 1.0 { return R1_MINOR() }
    }
    return R_NONE()
}

// CME speed category constants
fn CME_SLOW() -> i32 { 0 }
fn CME_AVERAGE() -> i32 { 1 }
fn CME_FAST() -> i32 { 2 }
fn CME_EXTREME() -> i32 { 3 }

// CME width category constants
fn CME_NARROW() -> i32 { 0 }
fn CME_NORMAL() -> i32 { 1 }
fn CME_WIDE() -> i32 { 2 }
fn CME_PARTIAL_HALO() -> i32 { 3 }
fn CME_HALO() -> i32 { 4 }

// Coronal Mass Ejection event
pub struct CME {
    speed: f64,
    width_deg: f64,
    position_angle: f64,
    acceleration: f64
}

fn cme_speed_class(cme: CME) -> i32 {
    if cme.speed < 500.0 { return CME_SLOW() }
    if cme.speed < 1000.0 { return CME_AVERAGE() }
    if cme.speed < 2000.0 { return CME_FAST() }
    return CME_EXTREME()
}

fn cme_width_class(cme: CME) -> i32 {
    if cme.width_deg >= 360.0 { return CME_HALO() }
    if cme.width_deg > 180.0 { return CME_PARTIAL_HALO() }
    if cme.width_deg > 120.0 { return CME_WIDE() }
    if cme.width_deg > 60.0 { return CME_NORMAL() }
    return CME_NARROW()
}

// Is potentially Earth-directed?
fn cme_is_earth_directed(cme: CME) -> bool {
    let wc = cme_width_class(cme)
    return wc == CME_HALO() || wc == CME_PARTIAL_HALO()
}

// Estimated transit time (hours) using ballistic model
fn cme_transit_ballistic_hours(cme: CME) -> f64 {
    let au_km = 1.496e8
    return au_km / cme.speed / 3600.0
}

// Estimated transit time with drag (hours)
fn cme_transit_drag_hours(cme: CME) -> f64 {
    let v_ambient = 400.0
    var v_eff = cme.speed
    if cme.speed > v_ambient {
        v_eff = v_ambient + (cme.speed - v_ambient) * 0.7
    } else {
        v_eff = cme.speed + (v_ambient - cme.speed) * 0.3
    }
    let au_km = 1.496e8
    return au_km / v_eff / 3600.0
}

// SEP event
pub struct SEPEvent {
    peak_flux_10: f64,
    peak_flux_100: f64,
    source_longitude: f64
}

fn sep_is_well_connected(sep: SEPEvent) -> bool {
    return sep.source_longitude > 0.0 && sep.source_longitude < 90.0
}

// Solar cycle phase constants
fn CYCLE_MINIMUM() -> i32 { 0 }
fn CYCLE_RISING() -> i32 { 1 }
fn CYCLE_MAXIMUM() -> i32 { 2 }
fn CYCLE_DECLINING() -> i32 { 3 }

// Active region
pub struct ActiveRegion {
    number: i32,
    latitude: f64,
    longitude: f64,
    area_msh: f64,
    spot_count: i32,
    mt_wilson_class: i32
}

// Mt Wilson class constants
fn MW_ALPHA() -> i32 { 0 }
fn MW_BETA() -> i32 { 1 }
fn MW_BETA_GAMMA() -> i32 { 2 }
fn MW_GAMMA() -> i32 { 3 }
fn MW_BETA_DELTA() -> i32 { 4 }
fn MW_BETA_GAMMA_DELTA() -> i32 { 5 }

// Flare productivity potential: 0=very_low, 1=low, 2=moderate, 3=high, 4=very_high
fn ar_flare_potential(ar: ActiveRegion) -> i32 {
    if ar.mt_wilson_class == MW_BETA_GAMMA_DELTA() { return 4 }
    if ar.mt_wilson_class == MW_BETA_DELTA() { return 3 }
    if ar.mt_wilson_class == MW_BETA_GAMMA() { return 2 }
    if ar.mt_wilson_class == MW_GAMMA() { return 2 }
    if ar.mt_wilson_class == MW_BETA() { return 1 }
    return 0
}

// Is region at or near central meridian (geoeffective position)?
fn ar_is_geoeffective(ar: ActiveRegion) -> bool {
    var abs_lon = ar.longitude
    if abs_lon < 0.0 { abs_lon = 0.0 - abs_lon }
    return abs_lon <= 30.0
}

fn solar_main() {
    let flare = flare_new(FLARE_X(), 5.2)
    let flux = flare_peak_flux(flare)
    println("X5.2 peak flux: ", flux, " W/m2")

    let r_scale = flare_radio_scale(flare)
    println("Radio blackout scale: R", r_scale)

    let cme = CME { speed: 1500.0, width_deg: 360.0, position_angle: 270.0, acceleration: 0.0 - 5.0 }
    let transit = cme_transit_drag_hours(cme)
    println("CME transit time (drag): ", transit, " hours")
    println("Earth-directed: ", cme_is_earth_directed(cme))
}
