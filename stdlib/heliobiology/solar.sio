// heliobiology/solar.sio - Solar event types and classification
//
// Types for solar flares, coronal mass ejections (CMEs), solar energetic
// particle (SEP) events, and related phenomena.
//
// Every number below is a published definition (#2835):
// - Flare classes: NOAA SWPC, "Solar Flares (Radio Blackouts)": peak flux in
//   the 0.1-0.8 nm band of the GOES XRS, A from 1e-8 W/m^2, then B 1e-7,
//   C 1e-6, M 1e-5, X 1e-4 W/m^2.
//   https://www.swpc.noaa.gov/phenomena/solar-flares-radio-blackouts
// - R scale: NOAA Space Weather Scales, R1..R5 = M1, M5, X1, X10, X20.
//   https://www.swpc.noaa.gov/noaa-scales-explanation
// - Astronomical unit: IAU 2012 Resolution B2, 1 au = 149 597 870 700 m
//   exactly.
// Unsourced heuristics were removed: CME speed/width classes, the "drag"
// transit model (0.7/0.3 factors), the Earth-directed and SEP
// well-connectedness rules, and the active-region flare-potential and
// geoeffectiveness rankings.

// X-ray flare class constants
pub fn FLARE_A() -> i32 { 0 }
pub fn FLARE_B() -> i32 { 1 }
pub fn FLARE_C() -> i32 { 2 }
pub fn FLARE_M() -> i32 { 3 }
pub fn FLARE_X() -> i32 { 4 }

// Flare designation
pub struct FlareDesignation {
    pub flare_class: i32,
    pub intensity: f64
}

pub fn flare_new(flare_class: i32, intensity: f64) -> FlareDesignation {
    return FlareDesignation { flare_class: flare_class, intensity: intensity }
}

// Peak X-ray flux in W/m^2
pub fn flare_peak_flux(f: FlareDesignation) -> f64 {
    var base = 1.0e-8
    if f.flare_class == FLARE_B() { base = 1.0e-7 }
    if f.flare_class == FLARE_C() { base = 1.0e-6 }
    if f.flare_class == FLARE_M() { base = 1.0e-5 }
    if f.flare_class == FLARE_X() { base = 1.0e-4 }
    return base * f.intensity
}

// NOAA R-scale constants
pub fn R_NONE() -> i32 { 0 }
pub fn R1_MINOR() -> i32 { 1 }
pub fn R2_MODERATE() -> i32 { 2 }
pub fn R3_STRONG() -> i32 { 3 }
pub fn R4_SEVERE() -> i32 { 4 }
pub fn R5_EXTREME() -> i32 { 5 }

// Radio blackout scale from flare
pub fn flare_radio_scale(f: FlareDesignation) -> i32 {
    if f.flare_class == FLARE_X() {
        if f.intensity >= 20.0 { return R5_EXTREME() }
        if f.intensity >= 10.0 { return R4_SEVERE() }
        return R3_STRONG()
    }
    if f.flare_class == FLARE_M() {
        if f.intensity >= 5.0 { return R2_MODERATE() }
        if f.intensity >= 1.0 { return R1_MINOR() }
    }
    return R_NONE()
}

// Coronal Mass Ejection event
pub struct CME {
    pub speed: f64,
    pub width_deg: f64,
    pub position_angle: f64,
    pub acceleration: f64
}

// 1 au in km (IAU 2012 Resolution B2, exact).
pub fn AU_KM() -> f64 { 149597870.7 }

// Sun-Earth transit time (hours) at constant speed (km/s): distance / speed.
// No drag or acceleration is modelled.
pub fn cme_transit_ballistic_hours(cme: CME) -> f64 {
    return AU_KM() / cme.speed / 3600.0
}

// SEP event
pub struct SEPEvent {
    pub peak_flux_10: f64,
    pub peak_flux_100: f64,
    pub source_longitude: f64
}

// Solar cycle phase constants
pub fn CYCLE_MINIMUM() -> i32 { 0 }
pub fn CYCLE_RISING() -> i32 { 1 }
pub fn CYCLE_MAXIMUM() -> i32 { 2 }
pub fn CYCLE_DECLINING() -> i32 { 3 }

// Active region
pub struct ActiveRegion {
    pub number: i32,
    pub latitude: f64,
    pub longitude: f64,
    pub area_msh: f64,
    pub spot_count: i32,
    pub mt_wilson_class: i32
}

// Mt Wilson class constants
pub fn MW_ALPHA() -> i32 { 0 }
pub fn MW_BETA() -> i32 { 1 }
pub fn MW_BETA_GAMMA() -> i32 { 2 }
pub fn MW_GAMMA() -> i32 { 3 }
pub fn MW_BETA_DELTA() -> i32 { 4 }
pub fn MW_BETA_GAMMA_DELTA() -> i32 { 5 }
