//! stdlib/heliobiology/solar.sio - Solar event types and classification
//!
//! Types for solar flares, coronal mass ejections (CMEs), solar energetic
//! particle (SEP) events, and related phenomena.
//!
//! References:
//! - GOES X-ray classification: NOAA/SWPC
//! - CME catalog: SOHO/LASCO, STEREO/COR

module heliobiology::solar

use heliobiology::units::{W_per_m2, km_per_s, nT, pfu}
use time::{DateTime, Duration}

// =============================================================================
// SOLAR FLARE CLASSIFICATION
// =============================================================================

/// X-ray flare class (GOES 1-8 Å band)
pub enum FlareClass {
    A,  // < 10^-7 W/m²
    B,  // 10^-7 to 10^-6 W/m²
    C,  // 10^-6 to 10^-5 W/m²
    M,  // 10^-5 to 10^-4 W/m²
    X,  // >= 10^-4 W/m²
}

/// Flare intensity within class (1.0-9.9, or >10 for X-class)
type FlareIntensity = { x: f64 | x >= 1.0 }

/// Complete flare designation (e.g., M5.4, X1.2)
pub struct FlareDesignation {
    pub class: FlareClass,
    pub intensity: FlareIntensity,
}

impl FlareDesignation {
    /// Create from class and intensity
    pub fn new(class: FlareClass, intensity: FlareIntensity) -> FlareDesignation {
        FlareDesignation { class, intensity }
    }

    /// Peak X-ray flux in W/m²
    pub fn peak_flux(self) -> W_per_m2 {
        let base = match self.class {
            FlareClass::A => 1e-8,
            FlareClass::B => 1e-7,
            FlareClass::C => 1e-6,
            FlareClass::M => 1e-5,
            FlareClass::X => 1e-4,
        }
        (base * self.intensity) : W_per_m2
    }

    /// Display string (e.g., "M5.4")
    pub fn to_string(self) -> string {
        let class_str = match self.class {
            FlareClass::A => "A",
            FlareClass::B => "B",
            FlareClass::C => "C",
            FlareClass::M => "M",
            FlareClass::X => "X",
        }
        format!("{}{:.1}", class_str, self.intensity)
    }

    /// NOAA R-scale (Radio Blackout) from flare class
    pub fn radio_blackout_scale(self) -> Option<RScale> {
        match self.class {
            FlareClass::M if self.intensity >= 1.0 => Some(RScale::R1Minor),
            FlareClass::M if self.intensity >= 5.0 => Some(RScale::R2Moderate),
            FlareClass::X if self.intensity < 10.0 => Some(RScale::R3Strong),
            FlareClass::X if self.intensity < 20.0 => Some(RScale::R4Severe),
            FlareClass::X if self.intensity >= 20.0 => Some(RScale::R5Extreme),
            _ => None,
        }
    }
}

/// Parse flare designation from string (e.g., "M5.4" -> FlareDesignation)
pub fn parse_flare(s: string) -> Option<FlareDesignation> {
    if s.len() < 2 { return None }

    let class_char = s.chars().next()?
    let class = match class_char {
        'A' => FlareClass::A,
        'B' => FlareClass::B,
        'C' => FlareClass::C,
        'M' => FlareClass::M,
        'X' => FlareClass::X,
        _ => return None,
    }

    let intensity_str = s.slice(1..)?
    let intensity = parse_f64(intensity_str)?

    if intensity < 1.0 { return None }

    Some(FlareDesignation { class, intensity })
}

/// NOAA R-scale (Radio Blackout)
pub enum RScale {
    R1Minor,    // M1
    R2Moderate, // M5
    R3Strong,   // X1
    R4Severe,   // X10
    R5Extreme,  // X20
}

// =============================================================================
// CORONAL MASS EJECTION (CME)
// =============================================================================

/// CME speed category
pub enum CMESpeedClass {
    Slow,       // < 500 km/s
    Average,    // 500-1000 km/s
    Fast,       // 1000-2000 km/s
    Extreme,    // > 2000 km/s
}

/// CME angular width
pub enum CMEWidth {
    Narrow,     // < 60°
    Normal,     // 60-120°
    Wide,       // 120-180°
    Halo,       // ~360° (Earth-directed)
    PartialHalo,// > 180° but not full halo
}

/// Coronal Mass Ejection event
pub struct CME {
    /// Linear speed (plane-of-sky) in km/s
    pub speed: km_per_s,

    /// Angular width in degrees
    pub width_deg: f64,

    /// Position angle (degrees from solar north)
    pub position_angle: f64,

    /// Acceleration (km/s²), negative = deceleration
    pub acceleration: f64,

    /// Associated flare (if any)
    pub associated_flare: Option<FlareDesignation>,

    /// Source region (NOAA AR number)
    pub source_region: Option<u32>,
}

impl CME {
    /// Speed classification
    pub fn speed_class(self) -> CMESpeedClass {
        if self.speed < 500.0 {
            CMESpeedClass::Slow
        } else if self.speed < 1000.0 {
            CMESpeedClass::Average
        } else if self.speed < 2000.0 {
            CMESpeedClass::Fast
        } else {
            CMESpeedClass::Extreme
        }
    }

    /// Width classification
    pub fn width_class(self) -> CMEWidth {
        if self.width_deg >= 360.0 {
            CMEWidth::Halo
        } else if self.width_deg > 180.0 {
            CMEWidth::PartialHalo
        } else if self.width_deg > 120.0 {
            CMEWidth::Wide
        } else if self.width_deg > 60.0 {
            CMEWidth::Normal
        } else {
            CMEWidth::Narrow
        }
    }

    /// Is potentially Earth-directed?
    pub fn is_earth_directed(self) -> bool {
        match self.width_class() {
            CMEWidth::Halo => true,
            CMEWidth::PartialHalo => {
                // Check if position angle suggests Earth direction
                // ~270° ± 45° for west limb, ~90° ± 45° for east limb
                // Halo/partial halo near disk center most concerning
                true
            },
            _ => false,
        }
    }

    /// Estimated transit time to Earth (simple ballistic)
    pub fn transit_time_ballistic(self) -> Duration {
        // 1 AU ≈ 1.496e8 km
        let au_km = 1.496e8
        let hours = au_km / self.speed / 3600.0
        Duration::hours(hours)
    }

    /// Estimated transit time with drag (empirical)
    pub fn transit_time_drag(self) -> Duration {
        // Empirical formula: slower CMEs accelerate, faster ones decelerate
        // toward ambient solar wind (~400 km/s)
        let v_ambient = 400.0
        let v_eff = if self.speed > v_ambient {
            // Fast CME decelerates
            v_ambient + (self.speed - v_ambient) * 0.7
        } else {
            // Slow CME accelerates slightly
            self.speed + (v_ambient - self.speed) * 0.3
        }
        let au_km = 1.496e8
        let hours = au_km / v_eff / 3600.0
        Duration::hours(hours)
    }
}

// =============================================================================
// SOLAR ENERGETIC PARTICLE (SEP) EVENTS
// =============================================================================

/// SEP event characteristics
pub struct SEPEvent {
    /// Peak proton flux >10 MeV (pfu)
    pub peak_flux_10: pfu,

    /// Peak proton flux >100 MeV (pfu)
    pub peak_flux_100: pfu,

    /// Onset time
    pub onset: DateTime,

    /// Peak time
    pub peak: DateTime,

    /// Associated flare
    pub flare: Option<FlareDesignation>,

    /// Associated CME speed
    pub cme_speed: Option<km_per_s>,

    /// Source longitude (degrees from central meridian)
    pub source_longitude: f64,
}

impl SEPEvent {
    /// Fluence estimate (simplified time integration)
    pub fn estimated_fluence(self, duration: Duration) -> f64 {
        // Simplified: peak * duration * shape_factor
        let shape_factor = 0.5  // Account for rise/decay
        self.peak_flux_10 * duration.hours() * 3600.0 * shape_factor
    }

    /// Is western source (magnetically well-connected)?
    pub fn is_well_connected(self) -> bool {
        // Western hemisphere (positive longitude) better connected
        // via Parker spiral for protons
        self.source_longitude > 0.0 && self.source_longitude < 90.0
    }
}

// =============================================================================
// SOLAR ACTIVE REGIONS
// =============================================================================

/// McIntosh sunspot classification
pub struct McIntoshClass {
    /// Z-class (modified Zurich): A, B, C, D, E, F, H
    pub zurich: char,

    /// p-class (penumbra of largest spot): x, r, s, a, h, k
    pub penumbra: char,

    /// c-class (spot distribution): x, o, i, c
    pub compactness: char,
}

/// Mount Wilson magnetic classification
pub enum MtWilsonClass {
    Alpha,      // Unipolar
    Beta,       // Bipolar, simple
    BetaGamma,  // Bipolar with irregular polarity
    Gamma,      // Complex, mixed polarities
    BetaDelta,  // Beta with delta configuration
    BetaGammaDelta, // Most complex, highest flare potential
}

/// Solar active region
pub struct ActiveRegion {
    /// NOAA region number
    pub number: u32,

    /// Heliographic latitude (degrees, positive = north)
    pub latitude: f64,

    /// Carrington longitude (degrees)
    pub longitude: f64,

    /// McIntosh classification
    pub mcintosh: Option<McIntoshClass>,

    /// Mount Wilson classification
    pub mt_wilson: Option<MtWilsonClass>,

    /// Area in millionths of solar hemisphere
    pub area_msh: f64,

    /// Number of sunspots
    pub spot_count: u32,
}

impl ActiveRegion {
    /// Flare productivity potential (heuristic)
    pub fn flare_potential(self) -> string {
        match self.mt_wilson {
            Some(MtWilsonClass::BetaGammaDelta) => "Very High",
            Some(MtWilsonClass::BetaDelta) => "High",
            Some(MtWilsonClass::BetaGamma) => "Moderate",
            Some(MtWilsonClass::Gamma) => "Moderate",
            Some(MtWilsonClass::Beta) => "Low",
            Some(MtWilsonClass::Alpha) => "Very Low",
            None => "Unknown",
        }
    }

    /// Is region at or near central meridian (geoeffective position)?
    pub fn is_geoeffective_position(self) -> bool {
        // Within ±30° of central meridian
        abs(self.longitude) <= 30.0
    }
}

// =============================================================================
// SOLAR CYCLE
// =============================================================================

/// Solar cycle phase
pub enum SolarCyclePhase {
    Minimum,
    Rising,
    Maximum,
    Declining,
}

/// Solar cycle information
pub struct SolarCycle {
    pub number: u32,        // Cycle number (e.g., 25)
    pub phase: SolarCyclePhase,
    pub smoothed_ssn: f64,  // Smoothed sunspot number
    pub f10_7: f64,         // F10.7 index
}

impl SolarCycle {
    /// Expected activity level
    pub fn expected_activity(self) -> string {
        match self.phase {
            SolarCyclePhase::Minimum => "Low",
            SolarCyclePhase::Rising => "Increasing",
            SolarCyclePhase::Maximum => "High",
            SolarCyclePhase::Declining => "Decreasing",
        }
    }
}

// =============================================================================
// SPACE WEATHER ALERTS
// =============================================================================

/// Alert severity level
pub enum AlertLevel {
    Watch,      // Conditions favorable
    Warning,    // Event expected
    Alert,      // Event occurring/imminent
}

/// Space weather alert
pub struct SpaceWeatherAlert {
    pub level: AlertLevel,
    pub event_type: string,
    pub message: string,
    pub issue_time: DateTime,
    pub valid_from: DateTime,
    pub valid_to: DateTime,
}
