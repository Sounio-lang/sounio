//! heliobiology/effects.sio - published associations between geomagnetic
//! activity and cardiovascular outcomes.
//!
//! Every number in this file is copied from a table of a cited, peer-reviewed
//! paper; nothing here is modelled, fitted or extrapolated. A coefficient that
//! could not be traced to a published table was removed (#2835): the former
//! linear Kp/Dst myocardial-infarction risk, the stroke, HRV-per-Kp, migraine,
//! melatonin, sleep, aviation-dose, solar-particle-dose and Schumann-shift
//! models, and the fixed 15 % (and 30 %, 50 %) relative uncertainties.
//!
//! Uncertainty. Each estimate is returned as an `Epistemic` (value + GUM
//! variance; stdlib/epistemic/knowledge.sio). The struct form is used rather
//! than the builtin `Knowledge<f64>` because the builtin's uncertainty does not
//! cross a function return (KL-11), and every value here is produced by a call.
//! The standard uncertainty is derived from the published 95 % confidence
//! interval as
//!
//!     u = (upper - lower) / (2 * 1.959963984540054)
//!
//! (normal approximation, coverage factor k = 1.96 for p = 95 %;
//! JCGM 100:2008, G.3 and G.6.4). The published intervals are rounded to two
//! decimals, so the interval reconstructed as value +- 1.96 u reproduces the
//! published bounds only to that rounding; tests/stdlib/heliobiology checks it.
//!
//! These are population-level observational associations, not causal effect
//! sizes, and must not be applied to individuals.

use epistemic::knowledge::{Epistemic, ep_measured}

// z_{0.975}: the two-sided 95 % standard-normal quantile.
fn helio_z95() -> f64 { 1.959963984540054 }

// Standard uncertainty from a published 95 % confidence interval.
pub fn helio_u_from_ci95(lower: f64, upper: f64) -> f64 with Div {
    (upper - lower) / (2.0 * helio_z95())
}

// A published point estimate with its 95 % CI, exactly as printed.
pub struct PublishedCI95 {
    pub point: f64,
    pub lower: f64,
    pub upper: f64
}

fn pci(point: f64, lower: f64, upper: f64) -> PublishedCI95 {
    PublishedCI95 { point: point, lower: lower, upper: upper }
}

pub fn published_to_epistemic(p: PublishedCI95) -> Epistemic with Div {
    ep_measured(p.point, helio_u_from_ci95(p.lower, p.upper))
}

// ============================================================================
// Daily mortality vs. daily Kp -- Zilli Vieira et al. (2019)
//
// C. L. Zilli Vieira, D. Alvares, A. Blomberg, J. Schwartz, B. Coull,
// S. Huang, P. Koutrakis. "Geomagnetic disturbances driven by solar activity
// enhance total and cardiovascular mortality risk in 263 U.S. cities."
// Environmental Health 18:83 (2019). doi:10.1186/s12940-019-0516-0,
// PMC6739933.
//
// Exposure: one standard deviation of the z-scored daily Kp index (the daily
// Kp sum; Table 1 overall mean 16.5, SD 9.4), city-specific season-stratified
// Poisson models pooled by meta-analysis over 263 cities, 1985-2013.
// Estimate: percent increase in daily deaths, 95 % CI.
//   Table 2 -- models without PM2.5 adjustment.
//   Table 3 -- models adjusted for 24-h PM2.5.
// ============================================================================

pub fn SEASON_WINTER() -> i32 { 0 }
pub fn SEASON_SPRING() -> i32 { 1 }
pub fn SEASON_SUMMER() -> i32 { 2 }
pub fn SEASON_FALL() -> i32 { 3 }

pub fn OUTCOME_TOTAL() -> i32 { 0 }   // total non-accidental deaths
pub fn OUTCOME_CVD() -> i32 { 1 }     // ICD-10 I00-I99
pub fn OUTCOME_MI() -> i32 { 2 }      // ICD-10 I21-I23
pub fn OUTCOME_STROKE() -> i32 { 3 }  // ICD-10 I60-I69

// Table 2 (no PM2.5 adjustment), row = season, column = outcome.
// The summer stroke interval is printed in the paper as (-0.14, -0.9); it is
// stored here ordered (lower, upper).
fn zv2019_table2(season: i32, outcome: i32) -> PublishedCI95 {
    if season == 0 {
        if outcome == 0 { return pci(0.13, 0.02, 0.24) }
        if outcome == 1 { return pci(0.0 - 0.04, 0.0 - 0.22, 0.13) }
        if outcome == 2 { return pci(0.21, 0.0 - 0.07, 0.5) }
        return pci(0.0 - 0.74, 0.0 - 0.96, 0.0 - 0.51)
    }
    if season == 1 {
        if outcome == 0 { return pci(0.31, 0.21, 0.41) }
        if outcome == 1 { return pci(0.21, 0.05, 0.37) }
        if outcome == 2 { return pci(0.4, 0.05, 0.72) }
        return pci(0.0 - 0.03, 0.0 - 0.4, 0.33)
    }
    if season == 2 {
        if outcome == 0 { return pci(0.27, 0.16, 0.37) }
        if outcome == 1 { return pci(0.15, 0.0 - 0.01, 0.33) }
        if outcome == 2 { return pci(0.14, 0.0 - 0.2, 0.5) }
        return pci(0.0 - 0.52, 0.0 - 0.9, 0.0 - 0.14)
    }
    if outcome == 0 { return pci(0.31, 0.23, 0.4) }
    if outcome == 1 { return pci(0.34, 0.23, 0.44) }
    if outcome == 2 { return pci(0.7, 0.43, 0.94) }
    return pci(0.06, 0.0 - 0.3, 0.4)
}

// Table 3 (adjusted for 24-h PM2.5), row = season, column = outcome.
fn zv2019_table3(season: i32, outcome: i32) -> PublishedCI95 {
    if season == 0 {
        if outcome == 0 { return pci(0.47, 0.3, 0.65) }
        if outcome == 1 { return pci(0.54, 0.23, 0.84) }
        if outcome == 2 { return pci(1.0, 0.4, 1.62) }
        return pci(0.35, 0.0 - 0.27, 0.97)
    }
    if season == 1 {
        if outcome == 0 { return pci(0.0 - 0.03, 0.0 - 0.2, 0.14) }
        if outcome == 1 { return pci(0.28, 0.0 - 0.01, 0.57) }
        if outcome == 2 { return pci(0.5, 0.0 - 0.2, 1.17) }
        return pci(0.0 - 0.13, 0.0 - 0.72, 0.45)
    }
    if season == 2 {
        if outcome == 0 { return pci(0.22, 0.05, 0.4) }
        if outcome == 1 { return pci(0.16, 0.0 - 0.03, 0.35) }
        if outcome == 2 { return pci(0.0 - 0.25, 0.0 - 0.92, 0.4) }
        return pci(0.24, 0.0 - 0.44, 0.92)
    }
    if outcome == 0 { return pci(0.23, 0.09, 0.37) }
    if outcome == 1 { return pci(0.46, 0.23, 0.7) }
    if outcome == 2 { return pci(0.36, 0.0 - 0.24, 0.96) }
    return pci(0.0 - 0.3, 0.0 - 0.81, 0.22)
}

// The published row for (season, outcome); pm25_adjusted selects Table 3.
pub fn gmd_mortality_published(season: i32, outcome: i32, pm25_adjusted: bool) -> PublishedCI95 {
    if pm25_adjusted { return zv2019_table3(season, outcome) }
    zv2019_table2(season, outcome)
}

// Percent increase in daily deaths per 1 SD of z-scored daily Kp.
pub fn gmd_mortality_pct_per_sd_kp(season: i32, outcome: i32, pm25_adjusted: bool) -> Epistemic with Div {
    published_to_epistemic(gmd_mortality_published(season, outcome, pm25_adjusted))
}

// The same estimate as a rate ratio: RR = 1 + pct/100, u_RR = u_pct/100.
pub fn gmd_mortality_rr_per_sd_kp(season: i32, outcome: i32, pm25_adjusted: bool) -> Epistemic with Div {
    let p = gmd_mortality_published(season, outcome, pm25_adjusted)
    ep_measured(1.0 + p.point / 100.0, helio_u_from_ci95(p.lower, p.upper) / 100.0)
}

// ============================================================================
// Heart-rate variability vs. intense geomagnetic disturbance --
// Zilli Vieira et al. (2022)
//
// C. L. Zilli Vieira, K. Chen, E. Garshick, M. Liu, P. Vokonas, P. Ljungman,
// J. Schwartz, P. Koutrakis. "Geomagnetic disturbances reduce heart rate
// variability in the Normative Aging Study." Science of the Total Environment
// 839:156235 (2022). doi:10.1016/j.scitotenv.2022.156235, PMC9233046.
//
// Cohort: 809 elderly men (mean age 74.5 y), Greater Boston, 2000-2017;
// linear mixed-effects models. Exposure: 0-15 h moving average of
// mid-latitude Kp above its 75th percentile vs. below it. Estimate: change in
// HRV in ms, 95 % CI (abstract and Results).
// ============================================================================

pub fn hrv_intense_gmd_sdnn_change_published() -> PublishedCI95 {
    pci(0.0 - 8.2, 0.0 - 13.9, 0.0 - 2.5)
}

pub fn hrv_intense_gmd_rmssd_change_published() -> PublishedCI95 {
    pci(0.0 - 14.7, 0.0 - 23.1, 0.0 - 6.3)
}

// Change in SDNN (ms) during intense GMD.
pub fn hrv_intense_gmd_sdnn_change_ms() -> Epistemic with Div {
    published_to_epistemic(hrv_intense_gmd_sdnn_change_published())
}

// Change in r-MSSD (ms) during intense GMD.
pub fn hrv_intense_gmd_rmssd_change_ms() -> Epistemic with Div {
    published_to_epistemic(hrv_intense_gmd_rmssd_change_published())
}
