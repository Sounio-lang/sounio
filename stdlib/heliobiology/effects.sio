//! stdlib/heliobiology/effects.sio - Biological effects of space weather
//!
//! Models for heliobiological effects: geomagnetic storm impacts on
//! cardiovascular, neurological, and other biological systems.
//!
//! NOTE: These models are research-grade and based on epidemiological
//! correlations. Causation mechanisms are still under investigation.
//!
//! References:
//! - Cornélissen et al. (2002) Chronobiology International
//! - Palmer et al. (2006) International Journal of Biometeorology
//! - Vencloviene et al. (2014) BMC Public Health

module heliobiology::effects

use heliobiology::indices::{Kp, Dst, Ap, Bz, SpaceWeatherState};
use heliobiology::units::{nT, uT, Sv, mSv, uSv};
use epistemic::{Knowledge, Uncertain};

// =============================================================================
// CARDIOVASCULAR EFFECTS
// =============================================================================

/// Relative risk multiplier for cardiovascular events
/// Based on Vencloviene et al. meta-analyses
type RelativeRisk = { x: f64 | x > 0.0 };

/// Cardiovascular risk model parameters
pub struct CardiovascularRiskModel {
    /// Baseline risk (no storm)
    pub baseline: f64,

    /// Kp coefficient (per Kp unit)
    pub kp_coeff: f64,

    /// Dst coefficient (per 10 nT decrease)
    pub dst_coeff: f64,

    /// Lag time in hours (effects often delayed)
    pub lag_hours: f64,
}

impl CardiovascularRiskModel {
    /// Default model from meta-analysis
    pub fn default() -> CardiovascularRiskModel {
        CardiovascularRiskModel {
            baseline: 1.0,
            kp_coeff: 0.03,    // ~3% increase per Kp unit
            dst_coeff: 0.01,   // ~1% per 10nT decrease
            lag_hours: 24.0,   // Peak effect ~24h after storm onset
        }
    }

    /// Calculate relative risk for myocardial infarction
    pub fn mi_risk(self, kp: Kp, dst: Dst) -> Knowledge<RelativeRisk> {
        // Effect strongest for Kp >= 5
        let kp_effect = if kp >= 5.0 {
            1.0 + self.kp_coeff * (kp - 4.0)
        } else {
            1.0
        }

        // Dst effect (more negative = higher risk)
        let dst_effect = if dst < -30.0 {
            1.0 + self.dst_coeff * ((-dst - 30.0) / 10.0)
        } else {
            1.0
        }

        let rr = self.baseline * kp_effect * dst_effect

        // Epistemic uncertainty: ±15% based on study heterogeneity
        Knowledge::new(rr, uncertainty: rr * 0.15)
    }

    /// Risk for stroke (similar but weaker association)
    pub fn stroke_risk(self, kp: Kp, dst: Dst) -> Knowledge<RelativeRisk> {
        let mi_rr = self.mi_risk(kp, dst)
        // Stroke association ~60% of MI association
        Knowledge::new(
            mi_rr.value * 0.6 + 0.4,
            uncertainty: mi_rr.uncertainty * 0.6
        )
    }
}

/// Heart rate variability (HRV) reduction model
pub struct HRVModel {
    /// Baseline SDNN (ms)
    pub baseline_sdnn: f64,

    /// Reduction coefficient per Kp unit
    pub reduction_per_kp: f64,
}

impl HRVModel {
    pub fn default() -> HRVModel {
        HRVModel {
            baseline_sdnn: 140.0,  // Healthy adult
            reduction_per_kp: 3.0, // ~3ms per Kp unit
        }
    }

    /// Estimated SDNN during storm
    pub fn estimated_sdnn(self, kp: Kp) -> Knowledge<f64> {
        let reduction = self.reduction_per_kp * max(0.0, kp - 3.0)
        let sdnn = self.baseline_sdnn - reduction
        Knowledge::new(sdnn, uncertainty: 15.0)
    }
}

// =============================================================================
// NEUROLOGICAL EFFECTS
// =============================================================================

/// Migraine trigger model
pub struct MigraineModel {
    /// Baseline probability
    pub baseline_prob: f64,

    /// dKp/dt sensitivity (rate of change)
    pub dkp_sensitivity: f64,
}

impl MigraineModel {
    pub fn default() -> MigraineModel {
        MigraineModel {
            baseline_prob: 0.05,  // 5% daily baseline
            dkp_sensitivity: 0.02,
        }
    }

    /// Migraine probability given Kp change rate
    pub fn trigger_probability(self, kp_current: Kp, kp_previous: Kp) -> Knowledge<f64> {
        let dkp = kp_current - kp_previous

        // Sudden increases most associated with triggers
        let multiplier = if dkp > 2.0 {
            1.0 + self.dkp_sensitivity * dkp * 10.0
        } else {
            1.0
        }

        let prob = min(0.5, self.baseline_prob * multiplier)
        Knowledge::new(prob, uncertainty: prob * 0.3)
    }
}

/// Epileptic seizure risk model
/// Based on Rajaram & Mitra correlation studies
pub struct SeizureRiskModel {
    pub baseline_rate: f64,  // Seizures per day (patient-specific)
    pub geomagnetic_sensitivity: f64,
}

impl SeizureRiskModel {
    /// Relative seizure risk
    pub fn relative_risk(self, ap: Ap) -> Knowledge<RelativeRisk> {
        // Association seen primarily at Ap > 30
        let effect = if ap > 30.0 {
            1.0 + self.geomagnetic_sensitivity * (ap - 30.0) / 100.0
        } else {
            1.0
        }
        Knowledge::new(effect, uncertainty: effect * 0.25)
    }
}

// =============================================================================
// CIRCADIAN AND MELATONIN EFFECTS
// =============================================================================

/// Melatonin suppression model
/// Geomagnetic disturbances may affect pineal gland function
pub struct MelatoninModel {
    /// Baseline nocturnal peak (pg/mL)
    pub baseline_peak: f64,
}

impl MelatoninModel {
    pub fn default() -> MelatoninModel {
        MelatoninModel {
            baseline_peak: 60.0,  // Typical young adult
        }
    }

    /// Estimated melatonin suppression during storm
    pub fn suppression_fraction(self, kp: Kp) -> Knowledge<f64> {
        // Speculative model based on limited studies
        let suppression = if kp >= 7.0 {
            0.15  // ~15% reduction during severe storm
        } else if kp >= 5.0 {
            0.08  // ~8% reduction during moderate storm
        } else {
            0.0
        }

        // High uncertainty - mechanism not established
        Knowledge::new(suppression, uncertainty: suppression * 0.5)
    }
}

/// Sleep quality index (0-100)
type SleepQuality = { x: f64 | 0.0 <= x && x <= 100.0 };

/// Sleep disruption model
pub fn sleep_quality_estimate(kp: Kp, dst: Dst) -> Knowledge<SleepQuality> {
    let baseline = 75.0

    // Kp effect
    let kp_penalty = if kp >= 5.0 { (kp - 4.0) * 3.0 } else { 0.0 }

    // Dst effect
    let dst_penalty = if dst < -50.0 { (-dst - 50.0) * 0.05 } else { 0.0 }

    let quality = max(30.0, baseline - kp_penalty - dst_penalty)
    Knowledge::new(quality, uncertainty: 10.0)
}

// =============================================================================
// RADIATION EXPOSURE (Aviation & Space)
// =============================================================================

/// Aviation radiation dose model
pub struct AviationDoseModel {
    /// Cruise altitude in km
    pub altitude_km: f64,

    /// Geographic latitude (absolute)
    pub latitude: f64,
}

impl AviationDoseModel {
    /// Baseline cosmic ray dose rate at altitude
    pub fn baseline_dose_rate(self) -> uSv_per_h {
        // Simplified CARI-7 approximation
        let altitude_factor = exp((self.altitude_km - 10.0) * 0.2)
        let latitude_factor = 1.0 + 0.5 * sin(self.latitude * PI / 180.0)

        let base_rate = 3.0  // ~3 µSv/h at 10km equator
        (base_rate * altitude_factor * latitude_factor) : uSv/h
    }

    /// Dose rate during solar particle event
    pub fn spe_dose_rate(self, proton_flux: f64) -> Knowledge<uSv_per_h> {
        let baseline = self.baseline_dose_rate()

        // SPE enhancement factor (logarithmic with flux)
        let enhancement = if proton_flux > 10.0 {
            1.0 + log10(proton_flux / 10.0) * 2.0
        } else {
            1.0
        }

        let rate = baseline * enhancement
        Knowledge::new(rate, uncertainty: rate * 0.3)
    }

    /// Cumulative dose for flight
    pub fn flight_dose(self, duration_hours: f64, proton_flux: f64) -> Knowledge<uSv> {
        let rate = self.spe_dose_rate(proton_flux)
        Knowledge::new(
            rate.value * duration_hours,
            uncertainty: rate.uncertainty * duration_hours
        )
    }
}

/// Astronaut dose model (ISS altitude)
pub struct SpaceDoseModel {
    /// Shielding thickness (g/cm²)
    pub shielding: f64,
}

impl SpaceDoseModel {
    /// ISS typical shielding
    pub fn iss_default() -> SpaceDoseModel {
        SpaceDoseModel { shielding: 10.0 }
    }

    /// Daily GCR dose
    pub fn daily_gcr_dose(self) -> Knowledge<mSv> {
        // Typical ISS: 0.3-0.5 mSv/day from GCR
        let base = 0.4
        let shielding_factor = exp(-self.shielding / 20.0)
        Knowledge::new(base * shielding_factor, uncertainty: 0.1)
    }

    /// SPE dose estimate
    pub fn spe_event_dose(self, proton_flux: f64, duration_hours: f64) -> Knowledge<mSv> {
        // Highly variable based on spectrum and shielding
        let base_rate = proton_flux * 0.01  // Very rough: mSv/h per pfu
        let shielding_factor = exp(-self.shielding / 15.0)
        let dose = base_rate * shielding_factor * duration_hours
        Knowledge::new(dose, uncertainty: dose * 0.5)
    }
}

// =============================================================================
// AGGREGATE HEALTH RISK ASSESSMENT
// =============================================================================

/// Combined heliobiological risk assessment
pub struct HealthRiskAssessment {
    pub cardiovascular: Knowledge<RelativeRisk>,
    pub neurological: Knowledge<RelativeRisk>,
    pub sleep_quality: Knowledge<SleepQuality>,
    pub overall_risk: string,
}

/// Compute aggregate risk assessment
pub fn assess_health_risk(state: SpaceWeatherState) -> HealthRiskAssessment {
    let cv_model = CardiovascularRiskModel::default()
    let cv_risk = cv_model.mi_risk(state.kp, state.dst)

    let neuro_risk = if state.kp >= 7.0 {
        Knowledge::new(1.15, uncertainty: 0.1)
    } else if state.kp >= 5.0 {
        Knowledge::new(1.05, uncertainty: 0.05)
    } else {
        Knowledge::new(1.0, uncertainty: 0.02)
    }

    let sleep = sleep_quality_estimate(state.kp, state.dst)

    let overall = if cv_risk.value > 1.2 {
        "Elevated - consider precautions for sensitive individuals"
    } else if cv_risk.value > 1.1 {
        "Slightly elevated"
    } else {
        "Normal"
    }

    HealthRiskAssessment {
        cardiovascular: cv_risk,
        neurological: neuro_risk,
        sleep_quality: sleep,
        overall_risk: overall,
    }
}

// =============================================================================
// SCHUMANN RESONANCE CORRELATION
// =============================================================================

/// Schumann resonance parameters
/// Earth-ionosphere cavity resonance (~7.83 Hz fundamental)
pub struct SchumannResonance {
    /// Fundamental frequency (Hz)
    pub f1: f64,

    /// Amplitude (pT)
    pub amplitude: f64,

    /// Q-factor
    pub q_factor: f64,
}

impl SchumannResonance {
    /// Typical quiet-time values
    pub fn quiet_baseline() -> SchumannResonance {
        SchumannResonance {
            f1: 7.83,
            amplitude: 1.0,  // ~1 pT typical
            q_factor: 5.0,
        }
    }

    /// Deviation during geomagnetic storm
    pub fn storm_deviation(kp: Kp) -> SchumannResonance {
        // Storms can shift frequency and increase amplitude
        let f_shift = if kp >= 5.0 { -0.1 * (kp - 4.0) } else { 0.0 }
        let amp_mult = if kp >= 5.0 { 1.0 + 0.2 * (kp - 4.0) } else { 1.0 }

        SchumannResonance {
            f1: 7.83 + f_shift,
            amplitude: 1.0 * amp_mult,
            q_factor: 5.0,
        }
    }
}

// =============================================================================
// RESEARCH UTILITIES
// =============================================================================

/// Time lag analysis for heliobiological correlations
pub struct LagAnalysis {
    /// Lag times to test (hours)
    pub lags: Vec<f64>,

    /// Correlation coefficients at each lag
    pub correlations: Vec<f64>,

    /// Optimal lag (hours)
    pub optimal_lag: f64,
}

/// Superposed epoch analysis result
pub struct SuperposedEpoch {
    /// Days relative to key date
    pub days: Vec<i32>,

    /// Mean values at each epoch
    pub means: Vec<f64>,

    /// Standard errors
    pub std_errors: Vec<f64>,
}
