//! stdlib/heliobiology/units.sio - Space weather and electromagnetic units
//!
//! Units for heliobiology, space weather monitoring, and geomagnetic studies.
//! Aligned with IAGA (International Association of Geomagnetism and Aeronomy)
//! and NOAA Space Weather Prediction Center conventions.

module heliobiology::units

// The SI base and derived units used below (m, kg, s, A, W, J) are the
// compiler's preloaded units. This file used to import them from
// units::qudt, which declares no unit of those names (it is a struct-based
// dimension library); lean_single ignored the dangling names and Madaros
// refused the module, so every importer failed on the default engine (#2835).
// Auxiliary units (nm, cm, MeV, h, d) used to be bound with `where` clauses,
// which only lean_single parses; their scale factors are now written inline.

// =============================================================================
// ELECTROMAGNETIC UNITS
// =============================================================================

// Magnetic field strength
pub unit T                      // Tesla (SI base for magnetic flux density)
pub unit mT = 1e-3 * T
pub unit uT = 1e-6 * T          // microtesla
pub unit nT = 1e-9 * T          // nanotesla (standard for geomagnetic)
pub unit pT = 1e-12 * T         // picotesla (magnetoencephalography)
pub unit G = 1e-4 * T           // Gauss (CGS, still used in solar physics)
pub unit mG = 1e-7 * T          // milligauss
pub unit gamma = 1e-9 * T       // gamma = 1 nT (historical geomagnetic unit)

// Magnetic flux
pub unit Wb = T * m^2           // Weber
pub unit mWb = 1e-3 * Wb
pub unit Mx = 1e-8 * Wb         // Maxwell (CGS)

// Electric field
pub unit V_per_m = W / A / m    // Volts per meter
pub unit mV_per_m = 1e-3 * V_per_m

// =============================================================================
// SOLAR RADIATION UNITS
// =============================================================================

// Irradiance (power per area)
pub unit W_per_m2 = W / m^2
pub unit mW_per_m2 = 1e-3 * W_per_m2
pub unit uW_per_m2 = 1e-6 * W_per_m2

// Solar Flux Unit (radio astronomy, 10.7 cm wavelength)
// 1 SFU = 10^-22 W·m^-2·Hz^-1
pub unit SFU                    // Solar Flux Unit
pub unit sfu = SFU              // lowercase alias

// Total Solar Irradiance at 1 AU
pub unit TSI = W_per_m2         // ~1361 W/m² nominal

// Spectral irradiance
pub unit W_per_m2_per_nm = W / m^2 / (1e-9 * m)     // per nanometre

// UV index (dimensionless, 0-11+ scale)
pub unit UV_index               // dimensionless

// =============================================================================
// PARTICLE FLUX UNITS
// =============================================================================

// Particle flux (particles per area per time per steradian per energy)
// 1 pfu = 1 particle cm^-2 s^-1 sr^-1; the steradian is dimensionless.
pub unit pfu = 1 / ((0.01 * m)^2 * s)  // Particle Flux Unit

// Integral proton flux (>10 MeV, >100 MeV thresholds)
pub unit proton_flux = pfu

// Electron flux
pub unit electron_flux = pfu

// Differential flux (per MeV)
pub unit diff_flux = pfu / (1.602176634e-13 * J)   // per MeV (exact SI eV)

// Fluence (time-integrated flux)
pub unit fluence = 1 / (0.01 * m)^2                // per cm^2

// =============================================================================
// IONOSPHERIC UNITS
// =============================================================================

// Total Electron Content
pub unit TECU                   // TEC Unit = 10^16 electrons/m²

// Critical frequency
pub unit MHz = 1e6 / s          // megahertz

// Electron density
pub unit el_per_m3 = 1 / m^3    // electrons per cubic meter
pub unit el_per_cm3 = 1e6 / m^3 // electrons per cubic centimeter

// =============================================================================
// DOSIMETRY UNITS (Radiation exposure)
// =============================================================================

// Absorbed dose
pub unit Gy = J / kg            // Gray
pub unit mGy = 1e-3 * Gy
pub unit uGy = 1e-6 * Gy
pub unit rad_dose = 0.01 * Gy   // rad (CGS, deprecated but still used)

// Dose equivalent (biological effect)
pub unit Sv = J / kg            // Sievert (same dimension as Gy, different meaning)
pub unit mSv = 1e-3 * Sv
pub unit uSv = 1e-6 * Sv
pub unit rem = 0.01 * Sv        // roentgen equivalent man

// Dose rate
pub unit Sv_per_h = Sv / (3600 * s)
pub unit uSv_per_h = 1e-6 * Sv_per_h
pub unit mGy_per_d = 1e-3 * Gy / (86400 * s)

// =============================================================================
// DERIVED HELIOPHYSICS UNITS
// =============================================================================

// Solar wind speed
pub unit km_per_s = 1000 * m / s

// Solar wind density
pub unit particles_per_cm3 = 1e6 / m^3

// Dynamic pressure (solar wind)
pub unit nPa = 1e-9 * kg / m / s^2  // nanopascal

// Interplanetary magnetic field components
pub unit IMF = nT               // alias for clarity

// =============================================================================
// UNIT CONVERSION HELPERS
// =============================================================================
//
// Exact definitional factors: 1 G = 1e-4 T (BIPM SI Brochure, 8th ed. 2006,
// Table 9, CGS units); 1 SFU = 1e-22 W m^-2 Hz^-1 (definition of the unit). They take and return plain f64
// with the unit in the name: a unit-typed signature such as
// `fn gauss_to_tesla(g: G) -> T { g * 1e-4 }` is refused by Madaros (E008: a
// G scaled by a number is still a G, not a T) and, at the time of writing,
// lean_single returns garbage for unit-typed f64 parameters (#2874).

/// Convert gauss to tesla
pub fn gauss_to_tesla(g_gauss: f64) -> f64 {
    g_gauss * 1e-4
}

/// Convert tesla to gauss
pub fn tesla_to_gauss(t_tesla: f64) -> f64 {
    t_tesla * 1e4
}

/// Convert gamma to nanotesla (identity, historical: 1 gamma = 1 nT)
pub fn gamma_to_nT(g_gamma: f64) -> f64 {
    g_gamma
}

/// Convert solar flux units to SI spectral flux density (W m^-2 Hz^-1)
pub fn sfu_to_si(s_sfu: f64) -> f64 {
    s_sfu * 1e-22
}
