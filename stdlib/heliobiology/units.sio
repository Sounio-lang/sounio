// heliobiology/units.sio - Space weather and electromagnetic units
//
// Unit conversion constants and helpers for heliobiology,
// space weather monitoring, and geomagnetic studies.

// Magnetic field conversions (all relative to Tesla)
fn tesla_per_gauss() -> f64 { 1.0e-4 }
fn tesla_per_nanotesla() -> f64 { 1.0e-9 }
fn tesla_per_microtesla() -> f64 { 1.0e-6 }

// Solar flux unit: 1 SFU = 10^-22 W m^-2 Hz^-1
fn sfu_to_si_factor() -> f64 { 1.0e-22 }

// Particle flux unit: cm^-2 s^-1 sr^-1
fn cm2_to_m2() -> f64 { 1.0e-4 }

// Dosimetry: Gray and Sievert (both J/kg)
fn gy_per_rad() -> f64 { 0.01 }
fn sv_per_rem() -> f64 { 0.01 }

// Time conversions
fn seconds_per_hour() -> f64 { 3600.0 }
fn seconds_per_day() -> f64 { 86400.0 }

// Convert Gauss to Tesla
fn gauss_to_tesla(g: f64) -> f64 {
    return g * tesla_per_gauss()
}

// Convert Tesla to Gauss
fn tesla_to_gauss(t: f64) -> f64 {
    return t / tesla_per_gauss()
}

// Convert gamma (historical) to nanotesla (identity: 1 gamma = 1 nT)
fn gamma_to_nT(g: f64) -> f64 {
    return g
}

// Convert SFU to SI spectral flux density
fn sfu_to_si(s: f64) -> f64 {
    return s * sfu_to_si_factor()
}

// Convert microSv/h to mSv/day
fn usv_per_h_to_msv_per_day(rate: f64) -> f64 {
    return rate * 24.0 / 1000.0
}

fn units_main() {
    let t = gauss_to_tesla(1.0)
    println("1 Gauss = ", t, " Tesla")

    let g = tesla_to_gauss(1.0e-4)
    println("1e-4 Tesla = ", g, " Gauss")
}
