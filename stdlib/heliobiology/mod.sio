//! stdlib/heliobiology - Space weather and heliobiological effects
//!
//! A comprehensive module for space weather monitoring, geomagnetic indices,
//! solar event classification, and biological effects modeling.
//!
//! # Overview
//!
//! Heliobiology studies the effects of solar activity and geomagnetic
//! disturbances on terrestrial life. This module provides:
//!
//! - **units**: Electromagnetic and radiation measurement units
//! - **indices**: Geomagnetic (Kp, Dst, Ap) and solar activity indices
//! - **solar**: Solar flare, CME, and active region classification
//! - **effects**: Biological response models (cardiovascular, neurological)
//!
//! # Quick Start
//!
//! ```sio
//! use heliobiology::{indices, solar, effects}
//! use heliobiology::units::{nT, T, SFU}
//!
//! // Check current space weather
//! let kp: indices::Kp = 6.3
//! let dst: indices::Dst = -85.0
//! let bz: indices::Bz = -12.0 : nT
//!
//! // Classify storm level
//! let storm = indices::kp_to_storm_level(kp)
//! // => KpStormLevel::G2Moderate
//!
//! // Parse a solar flare
//! let flare = solar::parse_flare("M5.4")
//! // => Some(FlareDesignation { class: M, intensity: 5.4 })
//!
//! // Assess health risk
//! let state = indices::SpaceWeatherState { kp, dst, bz, ... }
//! let risk = effects::assess_health_risk(state)
//! // => HealthRiskAssessment with epistemic uncertainty
//! ```
//!
//! # Data Sources
//!
//! For real-time data integration, consider fetching from:
//! - NOAA SWPC: https://services.swpc.noaa.gov/
//! - WDC Kyoto: http://wdc.kugi.kyoto-u.ac.jp/
//! - GOES satellite: https://www.swpc.noaa.gov/products/goes-x-ray-flux
//!
//! # References
//!
//! - NOAA Space Weather Scales
//! - IAGA geomagnetic indices
//! - Cornélissen et al. chronobiology studies
//! - Palmer et al. heliobiology meta-analyses

module heliobiology

// Re-export submodules
pub use heliobiology::units
pub use heliobiology::indices
pub use heliobiology::solar
pub use heliobiology::effects
pub use heliobiology::constants

// =============================================================================
// CONVENIENCE ALIASES
// =============================================================================

// Common unit aliases at module level
pub use heliobiology::units::{
    T, nT, uT, G,           // Magnetic field
    SFU,                     // Solar flux
    Sv, mSv, uSv,           // Radiation dose
    W_per_m2,               // Irradiance
    pfu,                     // Particle flux
}

// Common index types
pub use heliobiology::indices::{
    Kp, Dst, Ap, Bz,        // Geomagnetic
    F10_7,                   // Solar radio flux
    SpaceWeatherState,       // Combined state
}

// Solar event types
pub use heliobiology::solar::{
    FlareClass,
    FlareDesignation,
    CME,
    SEPEvent,
}

// Effect models
pub use heliobiology::effects::{
    CardiovascularRiskModel,
    HealthRiskAssessment,
    assess_health_risk,
}

// =============================================================================
// MODULE-LEVEL UTILITIES
// =============================================================================

/// Quick storm check - is Kp at storm level?
pub fn is_geomagnetic_storm(kp: Kp) -> bool {
    kp >= 5.0
}

/// Quick radiation storm check
pub fn is_radiation_storm(proton_flux: f64) -> bool {
    proton_flux >= 10.0  // S1 threshold
}

/// Combined space weather alert level
pub enum SpaceWeatherAlertLevel {
    Quiet,
    Unsettled,
    Active,
    Storm,
    SevereStorm,
}

/// Get overall alert level from indices
pub fn alert_level(kp: Kp, dst: Dst) -> SpaceWeatherAlertLevel {
    if kp >= 8.0 || dst <= -200.0 {
        SpaceWeatherAlertLevel::SevereStorm
    } else if kp >= 6.0 || dst <= -100.0 {
        SpaceWeatherAlertLevel::Storm
    } else if kp >= 5.0 || dst <= -50.0 {
        SpaceWeatherAlertLevel::Active
    } else if kp >= 4.0 || dst <= -30.0 {
        SpaceWeatherAlertLevel::Unsettled
    } else {
        SpaceWeatherAlertLevel::Quiet
    }
}

// =============================================================================
// EXAMPLE: NOAA SCALES SUMMARY
// =============================================================================

/// NOAA G-scale (Geomagnetic Storm) thresholds
pub mod noaa_scales {
    /// G-scale threshold Kp values
    pub const G1_KP: f64 = 5.0
    pub const G2_KP: f64 = 6.0
    pub const G3_KP: f64 = 7.0
    pub const G4_KP: f64 = 8.0
    pub const G5_KP: f64 = 9.0

    /// S-scale threshold proton flux (>10 MeV) values
    pub const S1_PFU: f64 = 10.0
    pub const S2_PFU: f64 = 100.0
    pub const S3_PFU: f64 = 1000.0
    pub const S4_PFU: f64 = 10000.0
    pub const S5_PFU: f64 = 100000.0

    /// R-scale threshold X-ray flux (W/m²) values
    pub const R1_FLUX: f64 = 1e-5    // M1
    pub const R2_FLUX: f64 = 5e-5    // M5
    pub const R3_FLUX: f64 = 1e-4    // X1
    pub const R4_FLUX: f64 = 1e-3    // X10
    pub const R5_FLUX: f64 = 2e-3    // X20
}
