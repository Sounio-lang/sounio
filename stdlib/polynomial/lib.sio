//! stdlib/polynomial/lib.sio - Polynomial operations
//!
//! Provides polynomial arithmetic and evaluation for scientific computing:
//! - Polynomial representation with coefficients
//! - Evaluation using Horner's method
//! - Arithmetic operations (add, sub, mul)
//! - Calculus (derivative, integral)
//! - Root finding for quadratic polynomials
//!
//! Polynomials are represented as p(x) = c[0] + c[1]*x + c[2]*x² + ... + c[n]*x^n

// #1622: these were `extern "C"` bindings to libm. The native backend has no
// dynamic linker, so every call compiled to a stub returning 0. The builtin
// names it does implement (sqrt, exp, log, sin, cos) need no declaration.
use math::libm::{libm_fabs}
// A polynomial with coefficients stored in ascending order of degree.
// p(x) = coeffs[0] + coeffs[1]*x + coeffs[2]*x² + ... + coeffs[degree]*x^degree
pub struct Polynomial {
    coeffs: [f64; 64],
    degree: i32,
}

// Create the zero polynomial (degree -1 by convention)
pub fn poly_zero() -> Polynomial {
    var coeffs: [f64; 64] = [0.0; 64]
    Polynomial { coeffs: coeffs, degree: -1 }
}

// Create a constant polynomial: p(x) = c
pub fn poly_constant(c: f64) -> Polynomial with Panic, Mut {
    var coeffs: [f64; 64] = [0.0; 64]
    coeffs[0] = c
    let deg = if c == 0.0 { -1 } else { 0 }
    Polynomial { coeffs: coeffs, degree: deg }
}

// Create a linear polynomial: p(x) = a*x + b
pub fn poly_linear(a: f64, b: f64) -> Polynomial with Panic, Mut {
    var coeffs: [f64; 64] = [0.0; 64]
    coeffs[0] = b
    coeffs[1] = a
    let deg = if a != 0.0 { 1 } else { if b != 0.0 { 0 } else { -1 } }
    Polynomial { coeffs: coeffs, degree: deg }
}

// Create a quadratic polynomial: p(x) = a*x² + b*x + c
pub fn poly_quadratic(a: f64, b: f64, c: f64) -> Polynomial with Panic, Mut {
    var coeffs: [f64; 64] = [0.0; 64]
    coeffs[0] = c
    coeffs[1] = b
    coeffs[2] = a
    let deg = if a != 0.0 { 2 } else { if b != 0.0 { 1 } else { if c != 0.0 { 0 } else { -1 } } }
    Polynomial { coeffs: coeffs, degree: deg }
}

// Create a monomial: p(x) = c * x^n
pub fn poly_monomial(c: f64, n: i32) -> Polynomial with Panic, Mut {
    var coeffs: [f64; 64] = [0.0; 64]
    if n >= 0 && n < 64 {
        coeffs[n] = c
    }
    let deg = if c == 0.0 { -1 } else { n }
    Polynomial { coeffs: coeffs, degree: deg }
}

// =============================================================================
// EVALUATION
// =============================================================================

// Evaluate polynomial at x using Horner's method.
// Horner's method: p(x) = c[n] + x*(c[n-1] + x*(c[n-2] + ... + x*c[0]))
// This is numerically stable and efficient (n multiplications, n additions).
pub fn poly_eval(p: Polynomial, x: f64) -> f64 with Div, Panic, Mut {
    if p.degree < 0 {
        return 0.0
    }
    var result = p.coeffs[p.degree]
    var i = p.degree - 1
    while i >= 0 {
        result = result * x + p.coeffs[i]
        i = i - 1
    }
    result
}

// Get coefficient at index i (returns 0.0 if out of range)
pub fn poly_coeff(p: Polynomial, i: i32) -> f64 with Panic, Mut {
    if i < 0 || i > p.degree {
        return 0.0
    }
    p.coeffs[i]
}

// Get the degree of the polynomial (-1 for zero polynomial)
pub fn poly_degree(p: Polynomial) -> i32 {
    p.degree
}

// Check if polynomial is zero
pub fn poly_is_zero(p: Polynomial) -> bool {
    p.degree < 0
}

// =============================================================================
// ARITHMETIC OPERATIONS
// =============================================================================

// Add two polynomials
pub fn poly_add(a: Polynomial, b: Polynomial) -> Polynomial with Div, Panic, Mut {
    let max_deg = if a.degree > b.degree { a.degree } else { b.degree }
    if max_deg < 0 {
        return poly_zero()
    }

    var coeffs: [f64; 64] = [0.0; 64]
    var i = 0
    while i <= max_deg {
        let ca = if i <= a.degree { a.coeffs[i] } else { 0.0 }
        let cb = if i <= b.degree { b.coeffs[i] } else { 0.0 }
        coeffs[i] = ca + cb
        i = i + 1
    }

    // Trim leading zeros
    var deg = max_deg
    while deg > 0 && coeffs[deg] == 0.0 {
        deg = deg - 1
    }
    if deg == 0 && coeffs[0] == 0.0 {
        deg = -1
    }

    Polynomial { coeffs: coeffs, degree: deg }
}

// Subtract two polynomials: a - b
pub fn poly_sub(a: Polynomial, b: Polynomial) -> Polynomial with Div, Panic, Mut {
    let max_deg = if a.degree > b.degree { a.degree } else { b.degree }
    if max_deg < 0 {
        return poly_zero()
    }

    var coeffs: [f64; 64] = [0.0; 64]
    var i = 0
    while i <= max_deg {
        let ca = if i <= a.degree { a.coeffs[i] } else { 0.0 }
        let cb = if i <= b.degree { b.coeffs[i] } else { 0.0 }
        coeffs[i] = ca - cb
        i = i + 1
    }

    // Trim leading zeros
    var deg = max_deg
    while deg > 0 && coeffs[deg] == 0.0 {
        deg = deg - 1
    }
    if deg == 0 && coeffs[0] == 0.0 {
        deg = -1
    }

    Polynomial { coeffs: coeffs, degree: deg }
}

// Multiply two polynomials (convolution of coefficients)
pub fn poly_mul(a: Polynomial, b: Polynomial) -> Polynomial with Div, Panic, Mut {
    if a.degree < 0 || b.degree < 0 {
        return poly_zero()
    }

    let result_deg = a.degree + b.degree
    let max_deg = if result_deg > 63 { 63 } else { result_deg }

    var coeffs: [f64; 64] = [0.0; 64]
    var i = 0
    while i <= a.degree {
        var j = 0
        while j <= b.degree {
            let k = i + j
            if k <= max_deg {
                coeffs[k] = coeffs[k] + a.coeffs[i] * b.coeffs[j]
            }
            j = j + 1
        }
        i = i + 1
    }

    // Trim leading zeros
    var deg = max_deg
    while deg > 0 && coeffs[deg] == 0.0 {
        deg = deg - 1
    }
    if deg == 0 && coeffs[0] == 0.0 {
        deg = -1
    }

    Polynomial { coeffs: coeffs, degree: deg }
}

// Scale polynomial by a constant: c * p(x)
pub fn poly_scale(p: Polynomial, c: f64) -> Polynomial with Div, Panic, Mut {
    if c == 0.0 || p.degree < 0 {
        return poly_zero()
    }

    var coeffs: [f64; 64] = [0.0; 64]
    var i = 0
    while i <= p.degree {
        coeffs[i] = p.coeffs[i] * c
        i = i + 1
    }

    Polynomial { coeffs: coeffs, degree: p.degree }
}

// Negate polynomial: -p(x)
pub fn poly_neg(p: Polynomial) -> Polynomial with Div, Panic, Mut {
    poly_scale(p, -1.0)
}

// =============================================================================
// CALCULUS
// =============================================================================

// Compute the derivative: d/dx[c[i]*x^i] = i*c[i]*x^(i-1)
pub fn poly_derivative(p: Polynomial) -> Polynomial with Div, Panic, Mut {
    if p.degree <= 0 {
        return poly_zero()
    }

    let new_deg = p.degree - 1
    var coeffs: [f64; 64] = [0.0; 64]
    var i = 0
    while i <= new_deg {
        coeffs[i] = (i + 1) as f64 * p.coeffs[i + 1]
        i = i + 1
    }

    // Trim leading zeros
    var deg = new_deg
    while deg > 0 && coeffs[deg] == 0.0 {
        deg = deg - 1
    }
    if deg == 0 && coeffs[0] == 0.0 {
        deg = -1
    }

    Polynomial { coeffs: coeffs, degree: deg }
}

// Compute the indefinite integral with constant c: ∫p(x)dx + c
// ∫c[i]*x^i dx = c[i]*x^(i+1)/(i+1)
pub fn poly_integral(p: Polynomial, c: f64) -> Polynomial with Div, Panic, Mut {
    if p.degree < 0 {
        return poly_constant(c)
    }

    let new_deg = if p.degree < 63 { p.degree + 1 } else { 63 }
    var coeffs: [f64; 64] = [0.0; 64]
    coeffs[0] = c

    var i = 0
    while i <= p.degree && i < 63 {
        coeffs[i + 1] = p.coeffs[i] / ((i + 1) as f64)
        i = i + 1
    }

    Polynomial { coeffs: coeffs, degree: new_deg }
}

// =============================================================================
// ROOT FINDING
// =============================================================================

// Quadratic roots result
pub struct QuadraticRoots {
    r1: f64,
    r2: f64,
    discriminant: f64,
    has_real_roots: bool,
}

// Solve quadratic equation ax² + bx + c = 0
// Returns real roots if discriminant >= 0
pub fn poly_roots_quadratic(a: f64, b: f64, c: f64) -> QuadraticRoots with Div, Panic, Mut {
    if a == 0.0 {
        // Linear case: bx + c = 0
        if b == 0.0 {
            return QuadraticRoots { r1: 0.0, r2: 0.0, discriminant: 0.0, has_real_roots: false }
        }
        let r = -c / b
        return QuadraticRoots { r1: r, r2: r, discriminant: 0.0, has_real_roots: true }
    }

    let disc = b * b - 4.0 * a * c
    if disc < 0.0 {
        return QuadraticRoots { r1: 0.0, r2: 0.0, discriminant: disc, has_real_roots: false }
    }

    let sqrt_disc = sqrt(disc)
    let r1 = (-b + sqrt_disc) / (2.0 * a)
    let r2 = (-b - sqrt_disc) / (2.0 * a)
    QuadraticRoots { r1: r1, r2: r2, discriminant: disc, has_real_roots: true }
}

// Evaluate polynomial using numerically stable Horner with error bound
// Returns (value, error_estimate)
pub fn poly_eval_with_error(p: Polynomial, x: f64) -> (f64, f64) with Div, Panic, Mut {
    if p.degree < 0 {
        return (0.0, 0.0)
    }

    let abs_x = if x < 0.0 { -x } else { x }
    var result = p.coeffs[p.degree]
    var error = libm_fabs(result)

    var i = p.degree - 1
    while i >= 0 {
        result = result * x + p.coeffs[i]
        error = error * abs_x + libm_fabs(result)
        i = i - 1
    }

    // Machine epsilon estimate
    let eps = 2.220446049250313e-16
    (result, error * eps)
}

// =============================================================================
// EXTENDED API — poly_new, poly_deriv, poly_integrate, poly_from_roots,
//               poly_deflate, poly_find_real_roots
// =============================================================================

// Create a zero polynomial of a given degree (all coefficients zero).
// Caller sets coefficients after creation.
pub fn poly_new(degree: i32) -> Polynomial with Panic, Mut {
    var coeffs: [f64; 64] = [0.0; 64]
    let d = if degree < 0 { -1 } else { if degree > 63 { 63 } else { degree } }
    Polynomial { coeffs: coeffs, degree: d }
}

// Alias: poly_deriv = poly_derivative (formal derivative)
pub fn poly_deriv(p: Polynomial) -> Polynomial with Div, Panic, Mut {
    if p.degree <= 0 {
        return poly_zero()
    }
    let new_deg = p.degree - 1
    var coeffs: [f64; 64] = [0.0; 64]
    var i = 0
    while i <= new_deg {
        coeffs[i] = (i + 1) as f64 * p.coeffs[i + 1]
        i = i + 1
    }
    var deg = new_deg
    while deg > 0 && coeffs[deg] == 0.0 { deg = deg - 1 }
    if deg == 0 && coeffs[0] == 0.0 { deg = -1 }
    Polynomial { coeffs: coeffs, degree: deg }
}

// Alias: poly_integrate = poly_integral (antiderivative with constant c)
pub fn poly_integrate(p: Polynomial, c: f64) -> Polynomial with Div, Panic, Mut {
    if p.degree < 0 {
        return poly_constant(c)
    }
    let new_deg = if p.degree < 63 { p.degree + 1 } else { 63 }
    var coeffs: [f64; 64] = [0.0; 64]
    coeffs[0] = c
    var i = 0
    while i <= p.degree && i < 63 {
        coeffs[i + 1] = p.coeffs[i] / ((i + 1) as f64)
        i = i + 1
    }
    Polynomial { coeffs: coeffs, degree: new_deg }
}

// Build polynomial from n roots: (x - r[0])*(x - r[1])*...*(x - r[n-1])
// Uses repeated multiplication by the linear factor (x - r[i]).
// NOTE: roots passed by value (fixed array). Uses by-value poly_mul.
pub fn poly_from_roots(roots: [f64; 32], n: i32) -> Polynomial with Div, Panic, Mut {
    // Start with p(x) = 1
    var coeffs: [f64; 64] = [0.0; 64]
    coeffs[0] = 1.0
    var p = Polynomial { coeffs: coeffs, degree: 0 }

    var k = 0
    while k < n {
        // Multiply p by (x - roots[k]): linear factor coeffs[0]=-r, coeffs[1]=1
        var lcoeffs: [f64; 64] = [0.0; 64]
        lcoeffs[0] = 0.0 - roots[k]
        lcoeffs[1] = 1.0
        let factor = Polynomial { coeffs: lcoeffs, degree: 1 }
        p = poly_mul(p, factor)
        k = k + 1
    }
    p
}

// Synthetic division: divide p(x) by (x - root), return quotient.
// If root is truly a root of p, the remainder is zero (or near-zero).
pub fn poly_deflate(p: Polynomial, root: f64) -> Polynomial with Div, Panic, Mut {
    if p.degree <= 0 {
        return poly_zero()
    }
    let n = p.degree
    var coeffs: [f64; 64] = [0.0; 64]
    // Synthetic division: b[n-1] = a[n], b[k] = a[k+1] + root*b[k+1]
    coeffs[n - 1] = p.coeffs[n]
    var i = n - 2
    while i >= 0 {
        coeffs[i] = p.coeffs[i + 1] + root * coeffs[i + 1]
        i = i - 1
    }
    // Trim leading zeros
    var deg = n - 1
    while deg > 0 && coeffs[deg] == 0.0 { deg = deg - 1 }
    if deg == 0 && coeffs[0] == 0.0 { deg = -1 }
    Polynomial { coeffs: coeffs, degree: deg }
}

// Result of poly_find_real_roots — returned by value to avoid JIT &! mutation bug.
pub struct PolyRoots {
    roots: [f64; 32],
    count: i32,
}

// Inline Newton iterate: one step of Newton's method on polynomial p at x.
fn pf_newton_iter(p: Polynomial, x: f64) -> f64 with Div, Panic, Mut {
    var result = p.coeffs[p.degree]
    var i = p.degree - 1
    while i >= 0 {
        result = result * x + p.coeffs[i]
        i = i - 1
    }
    let fx = result
    // Derivative via Horner
    var dresult = (p.degree as f64) * p.coeffs[p.degree]
    var j = p.degree - 1
    while j >= 1 {
        dresult = dresult * x + (j as f64) * p.coeffs[j]
        j = j - 1
    }
    let dfx = dresult
    if libm_fabs(dfx) < 1.0e-30 { return x }
    x - fx / dfx
}

// Evaluate polynomial at x (inline, by value).
fn pf_eval(p: Polynomial, x: f64) -> f64 with Div, Panic, Mut {
    if p.degree < 0 { return 0.0 }
    var result = p.coeffs[p.degree]
    var i = p.degree - 1
    while i >= 0 { result = result * x + p.coeffs[i]; i = i - 1 }
    result
}

// Find all real roots of polynomial p by repeated Newton + deflation.
// Returns PolyRoots (by value) to avoid the JIT &! mutation limitation.
// Works for polynomials up to degree 31.
pub fn poly_find_real_roots(p: Polynomial) -> PolyRoots with Div, Panic, Mut {
    var out_roots: [f64; 32] = [0.0; 32]
    var count = 0

    // Work on a local copy so we can deflate
    var work_coeffs: [f64; 64] = [0.0; 64]
    var i = 0
    while i <= p.degree {
        work_coeffs[i] = p.coeffs[i]
        i = i + 1
    }
    var work = Polynomial { coeffs: work_coeffs, degree: p.degree }

    // Starting guesses spread across [-10, 10]
    var starts: [f64; 32] = [0.0; 32]
    starts[0] = -9.0; starts[1] = -7.0; starts[2] = -5.0; starts[3] = -3.0
    starts[4] = -1.5; starts[5] = 0.0;  starts[6] = 0.5;  starts[7] = 1.5
    starts[8] = 3.0;  starts[9] = 5.0;  starts[10] = 7.0; starts[11] = 9.0

    var attempts = 0
    while work.degree >= 1 && count < 32 {
        let x0 = starts[attempts % 12]
        var x = x0
        var iter = 0
        while iter < 80 {
            let xn = pf_newton_iter(work, x)
            if libm_fabs(xn - x) < 1.0e-12 {
                x = xn
                iter = 80
            } else {
                x = xn
                iter = iter + 1
            }
        }

        // Accept root if residual is small
        let res = pf_eval(work, x)

        if libm_fabs(res) < 1.0e-8 {
            out_roots[count] = x
            count = count + 1
            // Deflate work by (x - root)
            work = poly_deflate(work, x)
        }

        attempts = attempts + 1
        if attempts > 200 { work = poly_zero() }
    }

    PolyRoots { roots: out_roots, count: count }
}
