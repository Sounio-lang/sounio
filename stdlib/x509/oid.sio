pub fn oid_eq10(a: &[u8; 20], a_len: i32, b: &[u8; 10]) -> bool {
    if a_len != 10 {
        return false
    }
    var i: i32 = 0
    while i < 10 {
        if a[i as usize] != b[i as usize] {
            return false
        }
        i = i + 1
    }
    true
}
