pub fn oid_email_address() -> [u8; 9] {
    var r: [u8; 9] = [0; 9]
    r[0] = 0x2A; r[1] = 0x86; r[2] = 0x48; r[3] = 0x86; r[4] = 0xF7
    r[5] = 0x0D; r[6] = 0x01; r[7] = 0x09; r[8] = 0x01
    r
}

