// -- PKIX private extension (arc 1.3.6.1.5.5.7.1) --
pub fn oid_ext_authority_info_access() -> [u8; 8] {
    var r: [u8; 8] = [0; 8]
    r[0] = 0x2B; r[1] = 0x06; r[2] = 0x01; r[3] = 0x05
    r[4] = 0x05; r[5] = 0x07; r[6] = 0x01; r[7] = 0x01
    r
}

// -- RFC 6962 Certificate Transparency SCT extension --
pub fn oid_ext_sct_list() -> [u8; 10] {
    var r: [u8; 10] = [0; 10]
    r[0] = 0x2B; r[1] = 0x06; r[2] = 0x01; r[3] = 0x04; r[4] = 0x01
    r[5] = 0xD6; r[6] = 0x79; r[7] = 0x02; r[8] = 0x04; r[9] = 0x02
    r
}

// Compares the first a_len bytes of a against the first b_len bytes of b --
// equal only if both lengths AND all compared bytes match. Used to match a
// decoded OID's raw bytes against one of the constants above.
pub fn oid_eq(a: &[u8; 20], a_len: i32, b: &[u8; 20], b_len: i32) -> bool {
    if a_len != b_len {
        return false
    }
    // a_len/b_len are recorded from a DER OID's own (attacker-controlled,
    // for an adversarial/malformed certificate) content_len, which is NOT
    // capped at the caller's parse site (only the byte COPY into the
    // fixed [u8;20] buffer is capped there -- see cert.sio's OID-reading
    // loops). Without this check, a_len > 20 would read past the end of
    // both fixed-size arrays -- Sounio's fixed arrays have no runtime
    // bounds checking (confirmed: an out-of-range index silently reads
    // adjacent stack memory rather than panicking). Found during the
    // final whole-plan review (2026-08-24); oid_eq3/8/9/10 are unaffected
    // since their comparison loops use a hardcoded width, never a_len, as
    // the loop bound.
    if a_len < 0 || a_len > 20 {
        return false
    }
    var i: i32 = 0
    while i < a_len {
        if a[i as usize] != b[i as usize] {
            return false
        }
        i = i + 1
    }
    true
}

pub fn oid_eq3(a: &[u8; 20], a_len: i32, b: &[u8; 3]) -> bool {
    if a_len != 3 {
        return false
    }
    var i: i32 = 0
    while i < 3 {
        if a[i as usize] != b[i as usize] {
            return false
        }
        i = i + 1
    }
    true
}

