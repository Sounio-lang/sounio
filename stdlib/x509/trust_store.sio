// stdlib/x509/trust_store.sio — system CA bundle loader
//
// Loads /etc/ssl/certs/ca-certificates.crt (the Debian/Ubuntu system CA
// bundle: a concatenation of PEM-encoded root certificates) into an
// in-memory TrustStore by walking it block-by-block with
// x509::pem::pem_decode_next and parsing each decoded DER block with
// x509::cert::x509_parse_certificate.
//
// read_file signature (Step 1 spike, confirmed on this compiler --
// Madaros v0.80.0): `read_file(path: string) -> string with IO` is a
// compiler builtin, NOT the 3-arg `(path, buf, max_len) -> i64` form the
// task-2 brief's Step 1/Step 4 sketch guessed at (that form matches
// Madaros's own bootstrap-era codegen source, self-hosted/native/
// codegen.sio, describing an IR-level stub shape -- not the front-end
// callable contract). Confirmed empirically:
//   $ ./bin/souc run /tmp/read_file_spike.sio   // 1-arg let n = read_file(path); print_int(n)
//   check: OK, runs, but prints a huge number -- because `n` there was
//   silently typed as the string's underlying pointer value, not a
//   length. The real accessors are the compiler builtins `str_len(s:
//   string) -> i64` and `str_char_at(s: string, i: i64) -> i64`, exactly
//   as already documented (and independently verified against real
//   `/etc/hosts` content) in stdlib/net/dns.sio's header comment from a
//   sibling task in this same plan. No `extern "C" fn heap_alloc` /
//   raw-pointer plumbing is needed or accepted for file reads at all --
//   the brief's `extern "C" { fn heap_alloc(...) }` block for read_file
//   purposes is dropped entirely here (rawbuf_new already wraps
//   heap_alloc internally for RawBuf allocation, which is all this file
//   still needs it for).
//
// Malformed-PEM-block handling (a real gap between the brief's original
// sketch and pem_decode_next's actual returned contract, resolved here
// as a task-level judgment call): pem_decode_next returns a non-zero
// error code (PEM_ERR_NO_END_MARKER / PEM_ERR_BASE64_DECODE) with
// next_search_offset == 0 for a malformed block -- 0 is a real buffer
// offset, not a sentinel meaning "no more blocks" (-1 means that), and
// it is not "the position just past the bad block" either, since
// pem.sio has no such "skip past this block" primitive. Resuming the
// scan loop from offset 0 on a malformed-block error would therefore
// re-find the SAME bad block on every iteration and infinite-loop
// (offset never advances past it). The brief's Step 4 sketch treated a
// non-zero perr as "skip it, continue scanning" via `offset = next`,
// which -- given pem_decode_next's real contract -- is exactly that
// infinite loop, not best-effort skipping. Since there is no safe way to
// re-derive a resume position from here, this loader treats ANY non-zero
// perr as fatal for the whole load, returning TRUST_STORE_ERR_READ_FAILED
// (reusing that existing error code rather than adding a new public one,
// since Tasks 3/4 only need to distinguish "got a usable TrustStore" from
// "did not" -- see task-2 brief's own interface list, which enumerates
// TRUST_STORE_ERR_READ_FAILED and TRUST_STORE_ERR_TOO_MANY_CERTS as the
// only two error consts Tasks 3/4 import verbatim). This is a deliberate
// change from the brief: no looping, no silent truncation.

use bignum::bigint::*
use net::socket::*
use x509::pem::*
use x509::cert::*

pub const TRUST_STORE_MAX_CERTS: i64 = 512
// TRANSIENT: the bundle could not be read at all. An unmounted /etc/ssl,
// a not-yet-populated container filesystem and a permissions problem all
// land here, and all three can be fixed while the process is still
// running -- so this failure is NOT memoised (see trust_store_load).
pub const TRUST_STORE_ERR_READ_FAILED: i64 = 0 - 1
// PERMANENT: content-level failures. The bytes were read fine; they do
// not describe a usable trust store. Re-reading the same bytes cannot
// change the outcome, so these ARE memoised.
pub const TRUST_STORE_ERR_TOO_MANY_CERTS: i64 = 0 - 2
pub const TRUST_STORE_ERR_MALFORMED: i64 = 0 - 3

pub struct TrustStore {
    certs: [Certificate; 512],
    bufs: [RawBuf; 512],
    count: i32,
}

pub fn x509_name_eq(a: &X509Name, b: &X509Name) -> bool {
    if a.count != b.count { return false }
    var i: i32 = 0
    while i < a.count {
        let ea = a.entries[i as usize]
        let eb = b.entries[i as usize]
        if ea.oid_len != eb.oid_len { return false }
        if ea.value_len != eb.value_len { return false }
        var j: i32 = 0
        while j < ea.oid_len {
            if ea.oid[j as usize] != eb.oid[j as usize] { return false }
            j = j + 1
        }
        var k: i32 = 0
        while k < ea.value_len {
            if ea.value[k as usize] != eb.value[k as usize] { return false }
            k = k + 1
        }
        i = i + 1
    }
    true
}

fn x509_general_name_eq(a: &GeneralName, b: &GeneralName) -> bool {
    if a.tag != b.tag { return false }
    if a.value_len != b.value_len { return false }
    if a.oid_len != b.oid_len { return false }
    var i: i32 = 0
    while i < a.value_len {
        if a.value[i as usize] != b.value[i as usize] { return false }
        i = i + 1
    }
    var j: i32 = 0
    while j < a.oid_len {
        if a.oid[j as usize] != b.oid[j as usize] { return false }
        j = j + 1
    }
    true
}

fn x509_extension_eq(a: &ExtensionEntry, b: &ExtensionEntry) -> bool {
    if a.oid_len != b.oid_len { return false }
    if a.critical != b.critical { return false }
    if a.value_len != b.value_len { return false }
    var i: i32 = 0
    while i < a.oid_len {
        if a.oid[i as usize] != b.oid[i as usize] { return false }
        i = i + 1
    }
    var j: i32 = 0
    while j < a.value_len {
        if a.value[j as usize] != b.value[j as usize] { return false }
        j = j + 1
    }
    true
}

fn x509_sct_eq(a: &SctEntry, b: &SctEntry) -> bool {
    if a.version != b.version { return false }
    if a.timestamp_ms != b.timestamp_ms { return false }
    if a.extensions_len != b.extensions_len { return false }
    if a.sig_algorithm_hash != b.sig_algorithm_hash { return false }
    if a.sig_algorithm_sign != b.sig_algorithm_sign { return false }
    if a.signature_len != b.signature_len { return false }
    var i: i64 = 0
    while i < 32 {
        if a.log_id[i as usize] != b.log_id[i as usize] { return false }
        i = i + 1
    }
    var j: i32 = 0
    while j < a.signature_len {
        if a.signature[j as usize] != b.signature[j as usize] { return false }
        j = j + 1
    }
    true
}

// Complete structural equality over EVERY field of Certificate.
//
// This exists because a PARTIAL witness is worse than none for a trust
// store: the memo installs a whole-struct copy of a value containing
// `[Certificate; 512]` into module-level state, which is the aggregate
// assignment shape cert.sio documents as miscompiling in other positions.
// A comparison that checks ten of the twenty-eight fields certifies a copy
// it has not actually inspected. Chain validation reads path-length
// constraints, AKI/SKI, EC keys, extensions and SANs, so a witness that
// skips them is not a witness for the thing being trusted.
pub fn x509_certificate_eq(a: &Certificate, b: &Certificate) -> bool {
    if a.version != b.version { return false }
    if a.tbs_start != b.tbs_start { return false }
    if a.tbs_len != b.tbs_len { return false }
    if a.not_before_unix != b.not_before_unix { return false }
    if a.not_after_unix != b.not_after_unix { return false }
    if a.public_key_algorithm != b.public_key_algorithm { return false }
    if a.is_ca != b.is_ca { return false }
    if a.path_len_constraint != b.path_len_constraint { return false }
    if a.key_usage_bits != b.key_usage_bits { return false }

    if bigint_cmp(&a.serial_number, &b.serial_number) != 0 { return false }
    if bigint_cmp(&a.modulus, &b.modulus) != 0 { return false }
    if bigint_cmp(&a.public_exponent, &b.public_exponent) != 0 { return false }
    if bigint_cmp(&a.ec_public_key.x, &b.ec_public_key.x) != 0 { return false }
    if bigint_cmp(&a.ec_public_key.y, &b.ec_public_key.y) != 0 { return false }

    if !x509_name_eq(&a.issuer, &b.issuer) { return false }
    if !x509_name_eq(&a.subject, &b.subject) { return false }

    if a.outer_sig_alg_oid_len != b.outer_sig_alg_oid_len { return false }
    var i: i32 = 0
    while i < a.outer_sig_alg_oid_len {
        if a.outer_sig_alg_oid[i as usize] != b.outer_sig_alg_oid[i as usize] { return false }
        i = i + 1
    }
    if a.tbs_sig_alg_oid_len != b.tbs_sig_alg_oid_len { return false }
    var t: i32 = 0
    while t < a.tbs_sig_alg_oid_len {
        if a.tbs_sig_alg_oid[t as usize] != b.tbs_sig_alg_oid[t as usize] { return false }
        t = t + 1
    }
    if a.outer_signature_len != b.outer_signature_len { return false }
    var g: i32 = 0
    while g < a.outer_signature_len {
        if a.outer_signature[g as usize] != b.outer_signature[g as usize] { return false }
        g = g + 1
    }
    if a.subject_key_id_len != b.subject_key_id_len { return false }
    var k: i32 = 0
    while k < a.subject_key_id_len {
        if a.subject_key_id[k as usize] != b.subject_key_id[k as usize] { return false }
        k = k + 1
    }
    if a.authority_key_id_len != b.authority_key_id_len { return false }
    var m: i32 = 0
    while m < a.authority_key_id_len {
        if a.authority_key_id[m as usize] != b.authority_key_id[m as usize] { return false }
        m = m + 1
    }

    if a.extension_count != b.extension_count { return false }
    var e: i32 = 0
    while e < a.extension_count {
        let ea = a.extensions[e as usize]
        let eb = b.extensions[e as usize]
        if !x509_extension_eq(&ea, &eb) { return false }
        e = e + 1
    }

    if a.san_count != b.san_count { return false }
    var sn: i32 = 0
    while sn < a.san_count {
        let sa = a.san_entries[sn as usize]
        let sb = b.san_entries[sn as usize]
        if !x509_general_name_eq(&sa, &sb) { return false }
        sn = sn + 1
    }

    if a.issuer_alt_name_count != b.issuer_alt_name_count { return false }
    var ia: i32 = 0
    while ia < a.issuer_alt_name_count {
        let ga = a.issuer_alt_names[ia as usize]
        let gb = b.issuer_alt_names[ia as usize]
        if !x509_general_name_eq(&ga, &gb) { return false }
        ia = ia + 1
    }

    if a.sct_count != b.sct_count { return false }
    var sc: i32 = 0
    while sc < a.sct_count {
        let ca = a.sct_entries[sc as usize]
        let cb = b.sct_entries[sc as usize]
        if !x509_sct_eq(&ca, &cb) { return false }
        sc = sc + 1
    }

    true
}

pub fn trust_store_find_by_subject(store: &TrustStore, subject: &X509Name) -> i64 {
    var i: i64 = 0
    while i < (store.count as i64) {
        if x509_name_eq(&store.certs[i as usize].subject, subject) {
            return i
        }
        i = i + 1
    }
    0 - 1
}

// Security-critical (see chain.sio's chain_is_trusted_root and the
// forged-root-DN-collision finding from final-plan review, 2026-08-25):
// `trust_store_find_by_subject` returns only the FIRST trust-store entry
// whose subject matches, which is not sufficient to decide "is this
// candidate cert genuinely a trust anchor" -- a subject DN is public
// information (CA subject DNs are not secret), so an attacker can forge a
// self-signed certificate with the exact same Subject DN as a real root and
// a key of their own choosing. Accepting such a forgery as a trusted root
// merely because SOME trust-store entry shares its subject is a chain-
// validation bypass. This helper instead loops over EVERY trust-store entry
// (the real system CA bundle legitimately contains cross-signed roots that
// share a Subject DN with a different key, so "first match" is also wrong
// on its own terms, not just insecure) and requires both subject equality
// AND byte-identical public key material on the SAME entry before treating
// the candidate as trusted.
//
// D17 (2026-08-27) -- the 2026-08-25 fix above closed that bypass for RSA
// ONLY, and left it wide open for EC. The previous signature took just
// `(subject, modulus, exponent)`, and `x509_parse_certificate` never
// populates `modulus`/`public_exponent` for an EC certificate: a P-256
// key is decoded into `cert.ec_public_key` and both BigInts stay at
// `bigint_zero()` (stdlib/x509/cert.sio's `else if is_ec_alg &&
// is_p256_curve` branch). So for every EC certificate the key check
// degenerated to `bigint_cmp(zero, zero) == 0` twice -- vacuously true --
// and the function fell back to exactly the pre-fix "any self-signed cert
// whose Subject DN string-matches a trust-store entry" behaviour.
// Demonstrated with an executed proof-of-concept: a forged self-signed
// P-256 CA carrying a genuine root's Subject DN and an attacker's own key,
// supplied as an intermediate, was accepted as a trust anchor and
// `x509_verify_chain` returned CHAIN_OK against a trust store holding only
// the genuine root. See tests/run-pass/x509_chain_forged_ec_root_dn_collision.sio.
//
// The parameter is now the whole candidate `Certificate` so the comparison
// can be algorithm-aware. Three requirements, all on the SAME entry:
//   1. the algorithms match, and
//   2. the Subject DNs match, and
//   3. the algorithm's OWN key material is byte-identical.
// An algorithm whose key material this parser does not decode
// (PUBKEY_ALG_UNKNOWN -- an unsupported curve, a compressed EC point, RSA-PSS,
// Ed25519, ...) can never be a trust anchor: every such certificate leaves
// ALL THREE key fields at zero, so any two of them would compare equal to
// each other. Rejected up front, fail-closed.
pub fn trust_store_has_matching_key_for_subject(
    store: &TrustStore,
    cert: &Certificate,
) -> bool {
    if cert.public_key_algorithm != PUBKEY_ALG_RSA && cert.public_key_algorithm != PUBKEY_ALG_EC_P256 {
        return false
    }
    // Field-by-field access on the array element, never `let entry =
    // store.certs[i]`: a Certificate is ~46 KB and this loop runs over all
    // ~150 system roots on every DFS step (chain.sio's ARENA DISCIPLINE
    // note, and D16). The by-value bind this replaces burned ~6.9 MB of
    // never-reclaimed arena per call.
    var i: i64 = 0
    while i < (store.count as i64) {
        if store.certs[i as usize].public_key_algorithm == cert.public_key_algorithm {
            if x509_name_eq(&store.certs[i as usize].subject, &cert.subject) {
                if cert.public_key_algorithm == PUBKEY_ALG_RSA {
                    if bigint_cmp(&store.certs[i as usize].modulus, &cert.modulus) == 0
                        && bigint_cmp(&store.certs[i as usize].public_exponent, &cert.public_exponent) == 0 {
                        return true
                    }
                } else {
                    if bigint_cmp(&store.certs[i as usize].ec_public_key.x, &cert.ec_public_key.x) == 0
                        && bigint_cmp(&store.certs[i as usize].ec_public_key.y, &cert.ec_public_key.y) == 0 {
                        return true
                    }
                }
            }
        }
        i = i + 1
    }
    false
}

pub fn trust_store_find_by_ski(store: &TrustStore, ski: &[u8; 32], ski_len: i32) -> i64 {
    var i: i64 = 0
    while i < (store.count as i64) {
        let c = store.certs[i as usize]
        if c.subject_key_id_len == ski_len {
            var matched: bool = true
            var j: i32 = 0
            while j < ski_len {
                if c.subject_key_id[j as usize] != ski[j as usize] { matched = false }
                j = j + 1
            }
            if matched { return i }
        }
        i = i + 1
    }
    0 - 1
}

// The real Debian/Ubuntu bundle is well under 1 MB as of 2026; read_file's
// own mmap sizing (1 MiB minimum, page-aligned up from file size) comfortably
// covers it with no size argument needed on this call at all.
const CA_BUNDLE_PATH: string = "/etc/ssl/certs/ca-certificates.crt"

// Process-lifetime memo for trust_store_load (see D16).
//
// Each uncached load parses all ~150 roots of the real Debian/Ubuntu CA
// bundle, and `x509_parse_certificate` spends ~8.8 MB of the Madaros
// runtime's NEVER-RECLAIMED process arena per call. One load therefore
// costs ~1.3 GB, and the 8 GiB arena admits only a handful before
// `madaros: arena full` (exit 181, uncatchable). D16 measured a ceiling of
// SIX loads against a 150-root bundle; seven against a 146-root Debian one
// here. Either way a
// consumer that calls trust_store_load() once per TLS-using stage (rather
// than once per process, threading a `&TrustStore` through) hits the wall
// inside a single ordinary workload; Sounio-lang/conclave-search did, at
// ~14 loads for one query.
//
// Memoising here fixes every such consumer without a source change on
// their side, and is sound because the store is immutable after load and
// its `bufs` are arena handles that are never reclaimed for the life of
// the process -- there is nothing to invalidate. Callers that genuinely
// need a re-read from disk call `trust_store_reload` (refreshes the memo)
// or `trust_store_load_uncached` (bypasses it entirely).
//
// Returning the memo by value is arena-cheap on this compiler: 3,000
// consecutive returns of a cached TrustStore did not move the arena at all
// -- re-verified for this change, on a real 146-root bundle, by
// tests/interop/trust_store_memo_arena_probe.sio. This does not trade one
// arena leak for another.
//
// WHAT THIS IS NOT: a fix for the arena defect. It divides an unbounded
// N x 1.3 GB into a one-off 1.3 GB that is then held for the life of the
// process. ~1.3 GB to hold 150 immutable roots remains extraordinary, and
// the per-certificate ~8.8 MB of unreclaimable parse scratch is UNCHANGED
// and still open. See the D16 dispatch.
//
// TRUST SNAPSHOT: because the memo lives for the whole process, a
// long-running server keeps validating against the roots it observed at
// first use. If the system removes a compromised CA or installs a new
// root, this process does not see it until it restarts or calls
// trust_store_reload(). `trust_store_generation` lets a caller observe
// which snapshot it is holding.
var TRUST_STORE_CACHE: TrustStore = TrustStore {
    certs: [certificate_zero(); 512],
    bufs: [rawbuf_new(1); 512],
    count: 0,
}
// 0 = cold, 1 = loaded successfully, 2 = failed PERMANENTLY (content-level)
var TRUST_STORE_CACHE_STATE: i64 = 0
var TRUST_STORE_CACHE_ERR: i64 = 0
// Increments on every successful load that replaces the memo. A caller can
// record it alongside a validation decision to say which root set that
// decision was made against.
var TRUST_STORE_CACHE_GENERATION: i64 = 0

// Which snapshot of the trust store this process currently holds: 0 before
// the first successful load, then 1, 2, ... after each one.
pub fn trust_store_generation() -> i64 {
    TRUST_STORE_CACHE_GENERATION
}

// The absolute path this process loads its roots from.
pub fn trust_store_source_path() -> string {
    CA_BUNDLE_PATH
}

// True once a successful load has been memoised.
pub fn trust_store_is_loaded() -> bool {
    TRUST_STORE_CACHE_STATE == 1
}

// A transient failure is one where the SAME call can succeed later in the
// same process: the bundle was unreadable, not unusable. Only permanent,
// content-level failures are memoised.
fn trust_store_err_is_permanent(err: i64) -> bool {
    err == TRUST_STORE_ERR_MALFORMED || err == TRUST_STORE_ERR_TOO_MANY_CERTS
}

pub fn trust_store_load() -> (TrustStore, i64) with IO, Mut, Div, Panic {
    if TRUST_STORE_CACHE_STATE == 1 {
        return (TRUST_STORE_CACHE, 0)
    }
    if TRUST_STORE_CACHE_STATE == 2 {
        // Content-level failure: the bytes parsed to something unusable.
        // Re-reading identical bytes cannot change that, and retrying
        // costs another ~1.3 GB of unreclaimable arena, so this verdict
        // stands for the life of the process.
        return (TRUST_STORE_CACHE, TRUST_STORE_CACHE_ERR)
    }
    let (loaded, err) = trust_store_load_uncached()
    if err == 0 {
        TRUST_STORE_CACHE = loaded
        TRUST_STORE_CACHE_STATE = 1
        TRUST_STORE_CACHE_GENERATION = TRUST_STORE_CACHE_GENERATION + 1
        return (TRUST_STORE_CACHE, 0)
    }
    if trust_store_err_is_permanent(err) {
        TRUST_STORE_CACHE_STATE = 2
        TRUST_STORE_CACHE_ERR = err
    }
    // A TRANSIENT failure leaves the memo cold, so a later call retries --
    // an unmounted /etc/ssl or a filesystem that is still coming up must
    // not sentence the process to a TLS-dead lifetime. The caller pays
    // another ~1.3 GB for that retry, which is why only genuinely
    // recoverable failures get one.
    //
    // Every failure path returns the SAME store the failed load produced,
    // whether it is the first failure or a memoised one, so a caller that
    // ignores `err` cannot observe two different stores for one error.
    (loaded, err)
}

// Force a re-read of the CA bundle and, on success, replace the memo.
//
// This is how a long-running process picks up a rotated or revoked root
// without restarting. It costs a full ~1.3 GB of unreclaimable arena, so
// it is a deliberate operation, not something to call per request: the
// process admits only a handful of loads in total, reloads included.
//
// A failed reload leaves the previously memoised store in place -- a
// process that already has good roots must not lose them because a refresh
// attempt hit a half-written bundle.
pub fn trust_store_reload() -> (TrustStore, i64) with IO, Mut, Div, Panic {
    let (loaded, err) = trust_store_load_uncached()
    if err == 0 {
        TRUST_STORE_CACHE = loaded
        TRUST_STORE_CACHE_STATE = 1
        TRUST_STORE_CACHE_ERR = 0
        TRUST_STORE_CACHE_GENERATION = TRUST_STORE_CACHE_GENERATION + 1
        return (TRUST_STORE_CACHE, 0)
    }
    if TRUST_STORE_CACHE_STATE == 1 {
        return (TRUST_STORE_CACHE, err)
    }
    if trust_store_err_is_permanent(err) {
        TRUST_STORE_CACHE_STATE = 2
        TRUST_STORE_CACHE_ERR = err
    }
    (loaded, err)
}

// The real loader: reads and re-parses the whole CA bundle every call.
// ~1.3 GB of never-reclaimed arena per call -- call `trust_store_load`
// instead unless you specifically need to bypass the memo.
pub fn trust_store_load_uncached() -> (TrustStore, i64) with IO, Mut, Div, Panic {
    var store = TrustStore {
        certs: [certificate_zero(); 512],
        bufs: [rawbuf_new(1); 512],
        count: 0,
    }

    let content: string = read_file(CA_BUNDLE_PATH)
    let n: i64 = str_len(content)
    if n <= 0 {
        return (store, TRUST_STORE_ERR_READ_FAILED)
    }

    let bundle = rawbuf_new(n + 8)
    var i: i64 = 0
    while i < n {
        rawbuf_set(&bundle, i, str_char_at(content, i))
        i = i + 1
    }

    var offset: i64 = 0
    while offset >= 0 {
        let (der, der_len, next, perr) = pem_decode_next(&bundle, n, offset)
        if perr != 0 {
            // See header comment: a malformed block cannot be safely
            // skipped with pem_decode_next's actual contract (next == 0
            // is not a resumable position), so this fails the whole load
            // rather than looping forever or silently truncating it.
            //
            // This is a CONTENT failure, distinct from the unreadable-file
            // case above: the bytes arrived and do not parse. Re-reading
            // them cannot help, so trust_store_load memoises this verdict
            // where it deliberately does not memoise a read failure.
            return (store, TRUST_STORE_ERR_MALFORMED)
        } else if der_len > 0 {
            if (store.count as i64) >= TRUST_STORE_MAX_CERTS {
                return (store, TRUST_STORE_ERR_TOO_MANY_CERTS)
            }
            let (cert, cerr) = x509_parse_certificate(&der, der_len)
            if cerr == 0 {
                store.certs[store.count as usize] = cert
                store.bufs[store.count as usize] = der
                store.count = store.count + 1
            }
            offset = next
        } else {
            offset = next  // -1: no more blocks, loop condition ends it
        }
    }

    (store, 0)
}
