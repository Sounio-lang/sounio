// Checked Anderson-Darling for a fitted normal distribution.
// See ANDERSON_DARLING.md: statistic n=3..256; approximate p n>=8 and A*<10.
module stats::anderson_darling
use math::pure::{sqrt,exp,ln_checked,is_finite}
use special::igamma::{igamma_upper}
use stats::order::{sort256}
pub struct ADResult {
 pub a2:f64, pub a2_star:f64, pub p:f64,
 // 0 calibrated; 1 size; 2 nonfinite; 3 constant; 4 arithmetic;
 // 5 statistic available, calibration unavailable.
 pub status:i32, pub n:i32, pub p_approximate:bool, pub has_ties:bool,
}
fn ad_abs(x:f64)->f64 {if x<0.0{return -x} return x}
fn ad_empty(s:i32,n:i32)->ADResult {
 return ADResult{a2:0.0,a2_star:0.0,p:0.0,status:s,n:n,
 p_approximate:true,has_ties:false}
}
pub fn anderson_darling(x:&[f64;256],n:i32)->ADResult with Mut,Div,Panic {
 if n<3 || n>256 {return ad_empty(1,n)}
 var a:[f64;256]=[0.0;256]
 var scale=0.0
 var i:i32=0
 while i<n {
  let v=x[i as usize]
  if !is_finite(v) {return ad_empty(2,n)}
  a[i as usize]=v
  if ad_abs(v)>scale {scale=ad_abs(v)}
  i=i+1
 }
 if !sort256(&!a,n as i64) {return ad_empty(4,n)}
 let anchor=a[0]
 let range=a[(n-1) as usize]-anchor
 if range==0.0 {return ad_empty(3,n)}
 var out=ad_empty(0,n)
 i=1
 while i<n {if a[i as usize]==a[(i-1) as usize] {out.has_ties=true} i=i+1}
 var sum=0.0
 var c=0.0
 i=0
 while i<n {
  var d=0.0
  if is_finite(range) {d=(a[i as usize]-anchor)/range}
  else {d=a[i as usize]/scale-anchor/scale}
  a[i as usize]=d
  let y=d-c
  let t=sum+y
  c=(t-sum)-y
  sum=t
  i=i+1
 }
 let nf=n as f64
 let mean=sum/nf
 var ss=0.0
 c=0.0
 i=0
 while i<n {
  let d=a[i as usize]-mean
  a[i as usize]=d
  let y=d*d-c
  let t=ss+y
  c=(t-ss)-y
  ss=t
  i=i+1
 }
 if ss<=0.0 || !is_finite(ss) {return ad_empty(4,n)}
 let sd=sqrt(ss/(nf-1.0))
 var acc=0.0
 c=0.0
 i=0
 while i<n {
  let z=a[i as usize]/sd
  // For a sample standardized with its own sample SD,
  // |z| <= (n-1)/sqrt(n) <16; normal tails remain representable.
  let tail=0.5*igamma_upper(0.5,0.5*z*z)
  if !is_finite(tail) || tail<=0.0 || tail>0.5 {return ad_empty(4,n)}
  let small=ln_checked(tail)
  let large=ln_checked(1.0-tail)
  if small.status!=0 || large.status!=0 {return ad_empty(4,n)}
  let lc=if z<=0.0 {small.value} else {large.value}
  let ls=if z>=0.0 {small.value} else {large.value}
  // Reindex the reverse survival sum; no second log-tail array.
  let term=((2*i+1) as f64)*lc+((2*(n-i)-1) as f64)*ls
  let y=term-c
  let t=acc+y
  c=(t-acc)-y
  acc=t
  i=i+1
 }
 let a2=-nf-acc/nf
 let aa=a2*(1.0+0.75/nf+2.25/(nf*nf))
 if !is_finite(aa) || a2<0.0 {return ad_empty(4,n)}
 out.a2=a2
 out.a2_star=aa
 if n<8 || aa>=10.0 {out.status=5;return out}
 var p=0.0
 if aa<0.2 {p=1.0-exp(-13.436+101.14*aa-223.73*aa*aa)}
 else if aa<0.34 {p=1.0-exp(-8.318+42.796*aa-59.938*aa*aa)}
 else if aa<0.6 {p=exp(0.9177-4.279*aa-1.38*aa*aa)}
 else {p=exp(1.2937-5.709*aa+0.0186*aa*aa)}
 if !is_finite(p) || p<0.0 || p>1.0 {out.status=5;return out}
 out.p=p
 return out
}
