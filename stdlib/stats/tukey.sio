//@ run-pass
//@ expect-stdout: ALL PASS

// stdlib/stats/tukey.sio — Tukey HSD post-hoc test (studentized range)
//
// After a significant one-way ANOVA (stats::anova), Tukey's Honestly Significant
// Difference identifies which pairs of group means differ while controlling the
// family-wise error rate. It uses the studentized range distribution q_{k,ν} —
// the distribution of (max − min) of k group means divided by the pooled SE —
// which has no closed form and is computed here by numerical integration:
//
//   q_range_cdf(w, k)        — CDF of the range of k standard normals
//   tukey_q_cdf(q, k, nu)    — CDF of the studentized range q_{k,ν}
//   tukey_q_crit(alpha,k,nu) — critical value (inverse CDF at 1−alpha)
//   tukey_hsd(ms_within, n, k, dfw, alpha) — HSD threshold q_crit·sqrt(MS_w/n)
//   tukey_pair_p(diff, ms_within, n, k, dfw) — p-value for one mean difference
//
//   P(W ≤ w) = k ∫ φ(z)[Φ(z) − Φ(z−w)]^{k−1} dz              (range of k normals)
//   P(Q ≤ q) = ∫_0^∞ P(W ≤ q·s)·h(s) ds,  h = density of √(χ²_ν/ν)
//
// Integrals by Simpson's rule; the critical value by bisection. Validated against
// published q tables to ~1e-2.
//
// Pure Sounio; dependencies: normal CDF (special::erf) and log-gamma (special::gamma).
//
// References:
//   Tukey (1949) "Comparing individual means in the analysis of variance"
//   Hartley (1942); Harter (1960) "Tables of range and studentized range"
//   Copenhaver & Holland (1988) — numerical evaluation of the studentized range

module stats::tukey

use special::erf::{normal_cdf}
use special::gamma::{lgamma}

// ============================================================================
// INTERNAL HELPERS (robust reflect-first exp)
// ============================================================================

fn tk_exp(x: f64) -> f64 with Mut, Div, Panic {
    if x < 0.0 { return 1.0 / tk_exp(0.0 - x) }
    if x > 709.0 { return 1.0e300 }
    if x > 2.0 { return tk_exp(x / 2.0) * tk_exp(x / 2.0) }
    var sum = 1.0
    var term = 1.0
    var i = 1
    while i <= 28 { term = term * x / (i as f64); sum = sum + term; i = i + 1 }
    return sum
}

fn tk_ln(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 - 1.0e300 }
    if x == 1.0 { return 0.0 }
    var m = x
    var e = 0
    while m >= 2.0 { m = m / 2.0; e = e + 1 }
    while m < 0.5 { m = m * 2.0; e = e - 1 }
    let t = (m - 1.0) / (m + 1.0)
    let t2 = t * t
    var sum = t
    var term = t
    var kk = 1
    while kk < 32 { term = term * t2; sum = sum + term / ((2 * kk + 1) as f64); kk = kk + 1 }
    return 2.0 * sum + (e as f64) * 0.6931471805599453
}

let TK_INV_SQRT_2PI: f64 = 0.3989422804014327

fn tk_phi(u: f64) -> f64 with Mut, Div, Panic {
    return TK_INV_SQRT_2PI * tk_exp(0.0 - 0.5 * u * u)
}

// (base)^(p) for small non-negative integer p
fn tk_ipow(base: f64, p: i32) -> f64 with Mut, Div, Panic {
    var r = 1.0
    var i = 0
    while i < p { r = r * base; i = i + 1 }
    return r
}

// ============================================================================
// RANGE OF k STANDARD NORMALS — inner integral
// ============================================================================

/// CDF of the range W = max − min of k independent standard normals.
///
/// P(W ≤ w) = k ∫ φ(z) [Φ(z) − Φ(z−w)]^{k−1} dz, by Simpson's rule on [−8, 8].
pub fn q_range_cdf(w: f64, k: i32) -> f64 with Mut, Div, Panic {
    if w <= 0.0 { return 0.0 }
    let kf = k as f64
    let lo = 0.0 - 8.0
    let hi = 8.0
    let m = 160                     // even number of Simpson intervals
    let step = (hi - lo) / (m as f64)
    var acc = 0.0
    var i = 0
    while i <= m {
        let z = lo + (i as f64) * step
        let inner = normal_cdf(z) - normal_cdf(z - w)
        var val = 0.0
        if inner > 0.0 { val = tk_phi(z) * tk_ipow(inner, k - 1) }
        var coef = 2.0
        if i == 0 || i == m { coef = 1.0 } else if i % 2 == 1 { coef = 4.0 }
        acc = acc + coef * val
        i = i + 1
    }
    var cdf = kf * acc * step / 3.0
    if cdf < 0.0 { cdf = 0.0 }
    if cdf > 1.0 { cdf = 1.0 }
    return cdf
}

// density of S = sqrt(chi2_nu / nu): h(s) = nu^{nu/2} s^{nu-1} e^{-nu s²/2}
//                                          / (2^{nu/2-1} Γ(nu/2))
fn tk_s_density(s: f64, nu: f64) -> f64 with Mut, Div, Panic {
    if s <= 0.0 { return 0.0 }
    let half = nu / 2.0
    let log_c = half * tk_ln(nu) - (half - 1.0) * 0.6931471805599453 - lgamma(half)
    let log_h = log_c + (nu - 1.0) * tk_ln(s) - nu * s * s / 2.0
    return tk_exp(log_h)
}

// ============================================================================
// STUDENTIZED RANGE CDF — outer integral over the scale factor
// ============================================================================

/// CDF of the studentized range q_{k,ν}. For large ν the scale factor → 1 and
/// this reduces to `q_range_cdf`.
pub fn tukey_q_cdf(q: f64, k: i32, nu: f64) -> f64 with Mut, Div, Panic {
    if q <= 0.0 { return 0.0 }
    if nu > 2000.0 { return q_range_cdf(q, k) }
    // integrate P(W <= q*s) * h(s) ds, s in (0, s_hi]
    let s_hi = 3.0
    let m = 80
    let step = s_hi / (m as f64)
    var acc = 0.0
    var i = 1                       // start at 1 (s=0 contributes 0)
    while i <= m {
        let s = (i as f64) * step
        let val = q_range_cdf(q * s, k) * tk_s_density(s, nu)
        var coef = 2.0
        if i == m { coef = 1.0 } else if i % 2 == 1 { coef = 4.0 }
        acc = acc + coef * val
        i = i + 1
    }
    var cdf = acc * step / 3.0
    if cdf < 0.0 { cdf = 0.0 }
    if cdf > 1.0 { cdf = 1.0 }
    return cdf
}

/// Critical value q such that P(Q_{k,ν} ≤ q) = 1 − alpha, by bisection.
pub fn tukey_q_crit(alpha: f64, k: i32, nu: f64) -> f64 with Mut, Div, Panic {
    let target = 1.0 - alpha
    var lo = 0.5
    var hi = 20.0
    var iter = 0
    while iter < 40 {
        let mid = 0.5 * (lo + hi)
        let c = tukey_q_cdf(mid, k, nu)
        if c < target { lo = mid } else { hi = mid }
        iter = iter + 1
    }
    return 0.5 * (lo + hi)
}

// ============================================================================
// HSD
// ============================================================================

/// Tukey HSD threshold: two group means (equal size n) differ at level `alpha`
/// iff |mean_i − mean_j| exceeds this.
///
/// HSD = q_{alpha,k,dfw} · sqrt(MS_within / n).
pub fn tukey_hsd(ms_within: f64, n: i64, k: i32, dfw: f64, alpha: f64) -> f64 with Mut, Div, Panic {
    let qc = tukey_q_crit(alpha, k, dfw)
    var root = 0.0
    let v = ms_within / (n as f64)
    if v > 0.0 {
        var y = v
        var i = 0
        while i < 24 { y = 0.5 * (y + v / y); i = i + 1 }
        root = y
    }
    return qc * root
}

/// Two-sided p-value for a single pairwise mean difference under Tukey's method.
/// q_stat = |diff| / sqrt(MS_within/n);  p = 1 − CDF_q(q_stat).
pub fn tukey_pair_p(diff: f64, ms_within: f64, n: i64, k: i32, dfw: f64) -> f64 with Mut, Div, Panic {
    let ad = if diff < 0.0 { 0.0 - diff } else { diff }
    let v = ms_within / (n as f64)
    if v <= 0.0 { return 1.0 }
    var root = v
    var i = 0
    while i < 24 { root = 0.5 * (root + v / root); i = i + 1 }
    let q_stat = ad / root
    var p = 1.0 - tukey_q_cdf(q_stat, k, dfw)
    if p < 0.0 { p = 0.0 }
    if p > 1.0 { p = 1.0 }
    return p
}

// ============================================================================
// INLINE TESTS — validated against published studentized-range tables
// ============================================================================

fn approx(a: f64, b: f64, tol: f64) -> bool {
    let d = if a > b { a - b } else { b - a }
    return d <= tol
}

fn check(name: i64, ok: bool) -> bool with IO {
    if ok { return true }
    print("FAIL at case "); print(name); print("\n")
    return false
}

// Published q_{0.05, k, nu} critical values (Harter 1960):
//   q(0.05,3,10)=3.877  q(0.05,3,20)=3.578  q(0.05,4,20)=3.958
//   q(0.05,3,inf)=3.314  q(0.05,2,20)=2.950 (= sqrt2·t_0.975,20 = 1.414·2.086)
fn test_q_crit() -> bool with IO, Mut, Div, Panic {
    var ok = true
    ok = check(1, approx(tukey_q_crit(0.05, 3, 10.0),  3.877, 2.0e-2)) && ok
    ok = check(2, approx(tukey_q_crit(0.05, 3, 20.0),  3.578, 2.0e-2)) && ok
    ok = check(3, approx(tukey_q_crit(0.05, 4, 20.0),  3.958, 2.0e-2)) && ok
    ok = check(4, approx(tukey_q_crit(0.05, 3, 5000.0), 3.314, 2.0e-2)) && ok
    ok = check(5, approx(tukey_q_crit(0.05, 2, 20.0),  2.950, 2.0e-2)) && ok
    return ok
}

// HSD monotonicity + a concrete value: MS_w=2.5, n=5, k=3, dfw=12.
// q(0.05,3,12) ≈ 3.773 ; HSD = 3.773·sqrt(2.5/5) = 3.773·0.707107 = 2.668.
fn test_hsd() -> bool with IO, Mut, Div, Panic {
    var ok = true
    let hsd = tukey_hsd(2.5, 5, 3, 12.0, 0.05)
    ok = check(10, approx(hsd, 2.668, 5.0e-2)) && ok
    // a difference well above HSD is significant (small p); one below is not
    let p_big = tukey_pair_p(6.0, 2.5, 5, 3, 12.0)
    let p_small = tukey_pair_p(0.5, 2.5, 5, 3, 12.0)
    ok = check(11, p_big < 0.01) && ok
    ok = check(12, p_small > 0.5) && ok
    return ok
}

pub fn run_tests() -> bool with IO, Mut, Div, Panic {
    var ok = true
    ok = test_q_crit() && ok
    ok = test_hsd() && ok
    return ok
}

fn main() with IO, Mut, Div, Panic {
    if run_tests() {
        print("ALL PASS\n")
    } else {
        print("SOME FAILED\n")
    }
}
