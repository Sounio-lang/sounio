// Lie corpus X2: residual-estimated vs declared absolute standard uncertainty.
// https://docs.scipy.org/doc/scipy/reference/generated/scipy.optimize.curve_fit.html
// A minimal one-parameter weighted least-squares model y = slope*x, M=3, N=1,
// independent Gaussian errors with a common supplied sigma. The GUM Type A/B
// distinction here is specifically the provenance of u, not conf or iv.
use math::pure::sqrt

struct TypeA { sigma: f64 }
struct TypeB { sigma: f64 }
struct FitTypeA { slope: f64, u: TypeA }
struct FitTypeB { slope: f64, u: TypeB }
struct FitCore { slope: f64, sum_x2: f64, rss: f64 }

fn fit_core(x: [f64; 3], y: [f64; 3], sigma: f64) -> FitCore with Mut, Div, Panic {
    assert(sigma > 0.0 && sigma < 1.7976931348623157e308)
    var xx = 0.0
    var xy = 0.0
    var i: usize = 0
    while i < 3 {
        xx = xx + x[i] * x[i]
        xy = xy + x[i] * y[i]
        i = i + 1
    }
    assert(xx > 0.0 && xx < 1.7976931348623157e308)
    let slope = xy / xx
    var rss = 0.0
    i = 0
    while i < 3 {
        let r = y[i] - slope * x[i]
        rss = rss + r * r
        i = i + 1
    }
    assert(rss >= 0.0 && rss < 1.7976931348623157e308)
    return FitCore { slope: slope, sum_x2: xx, rss: rss }
}

// sigma^2 / sum(x^2) * chi2/(M-N) = RSS/(2*sum(x^2)). Cancel
// the common sigma analytically rather than introduce unnecessary roundoff.
pub fn fit_type_a(x: [f64; 3], y: [f64; 3], sigma: f64) -> FitTypeA with Mut, Div, Panic {
    let f = fit_core(x, y, sigma)
    let u = sqrt(f.rss / 2.0) / sqrt(f.sum_x2)
    assert(u >= 0.0 && u < 1.7976931348623157e308)
    return FitTypeA { slope: f.slope, u: TypeA { sigma: u } }
}

// Absolute sigma is propagated without rescaling by observed residuals.
pub fn fit_type_b(x: [f64; 3], y: [f64; 3], sigma: f64) -> FitTypeB with Mut, Div, Panic {
    let f = fit_core(x, y, sigma)
    let u = sigma / sqrt(f.sum_x2)
    assert(u > 0.0 && u < 1.7976931348623157e308)
    return FitTypeB { slope: f.slope, u: TypeB { sigma: u } }
}

pub fn fit_a_slope(f: FitTypeA) -> f64 { f.slope }
pub fn fit_b_slope(f: FitTypeB) -> f64 { f.slope }
pub fn fit_a_u(f: FitTypeA) -> TypeA { f.u }
pub fn fit_b_u(f: FitTypeB) -> TypeB { f.u }
pub fn type_a_sigma(u: TypeA) -> f64 { u.sigma }
pub fn type_b_sigma(u: TypeB) -> f64 { u.sigma }
