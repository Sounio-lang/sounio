// stats::clinical::meta_analysis — Epistemic Meta-Analysis
//
// Evidence synthesis across multiple studies with:
// - Fixed-effects (Mantel-Haenszel)
// - Random-effects (DerSimonian-Laird)
// - Heterogeneity metrics (I², τ², Q)
// - Publication bias detection (Egger's test, trim-and-fill)
// - Forest plot data generation
// - Knowledge<PooledEffect> with confidence from study quality
//
// References:
// - DerSimonian & Laird (1986): "Meta-analysis in clinical trials"
// - Higgins & Thompson (2002): "Quantifying heterogeneity" (I²)
// - Egger et al. (1997): "Bias in meta-analysis detected by funnel plot"
// - Cochrane Handbook for Systematic Reviews of Interventions (2024)

// =============================================================================
// Math Helpers
// =============================================================================

struct BetaConfidence {
    alpha: f64,
    beta: f64
}

fn beta_new(a: f64, b: f64) -> BetaConfidence { BetaConfidence { alpha: a, beta: b } }
fn beta_mean(b: &BetaConfidence) -> f64 { b.alpha / (b.alpha + b.beta) }
fn beta_combine(b1: &BetaConfidence, b2: &BetaConfidence) -> BetaConfidence {
    BetaConfidence { alpha: b1.alpha + b2.alpha - 1.0, beta: b1.beta + b2.beta - 1.0 }
}

fn meta_abs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

fn meta_sqrt(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 25 { y = 0.5 * (y + x / y); i = i + 1 }
    y
}

fn meta_max(a: f64, b: f64) -> f64 { if a > b { a } else { b } }
fn meta_min(a: f64, b: f64) -> f64 { if a < b { a } else { b } }

// =============================================================================
// Types
// =============================================================================

// Individual study result
struct StudyResult {
    effect: f64,      // Effect size (mean diff, log-OR, SMD)
    se: f64,          // Standard error
    n: i64,           // Sample size
    weight: f64       // Study weight (computed during analysis)
}

fn study_new(effect: f64, se: f64, n: i64) -> StudyResult {
    StudyResult {
        effect: effect,
        se: se,
        n: n,
        weight: 0.0
    }
}

// Heterogeneity metrics
struct Heterogeneity {
    q_stat: f64,       // Cochran's Q
    q_df: i64,         // Degrees of freedom (k-1)
    q_p_value: f64,    // p-value for Q
    i_squared: f64,    // I² (% variation due to heterogeneity)
    tau_squared: f64,   // Between-study variance
    tau: f64,           // √τ² (between-study SD)
    h_squared: f64     // H² = Q/df
}

// Pooled effect estimate
struct PooledEffect {
    effect: f64,       // Pooled effect size
    se: f64,           // SE of pooled effect
    ci_lower: f64,     // 95% CI
    ci_upper: f64,
    z_stat: f64,       // z-test for pooled effect
    p_value: f64       // Two-tailed p
}

// Publication bias
struct PublicationBias {
    egger_intercept: f64,  // Egger's test intercept
    egger_se: f64,
    egger_p: f64,
    bias_detected: bool,
    trim_fill_added: i64   // Studies imputed by trim-and-fill
}

// Full meta-analysis result
struct MetaAnalysisResult {
    fixed_effect: PooledEffect,
    random_effect: PooledEffect,
    heterogeneity: Heterogeneity,
    publication_bias: PublicationBias,
    study_weights_fixed: [f64; 50],
    study_weights_random: [f64; 50],
    n_studies: i64
}



// Provenance
struct MetaProvenance {
    method: String,
    n_studies: i64,
    total_n: i64,
    heterogeneity: Heterogeneity,
    bias_assessment: PublicationBias
}

// Knowledge wrapper
struct KnowledgeMetaAnalysis {
    value: MetaAnalysisResult,
    variance: f64,
    confidence: BetaConfidence,
    provenance: MetaProvenance
}

// =============================================================================
// FIXED-EFFECTS META-ANALYSIS (Inverse Variance)
// =============================================================================

fn meta_fixed_effects(
    studies: [StudyResult; 50],
    k: i64
) -> PooledEffect with Mut, Div, Panic {
    // Fixed-effects: each study estimates same true effect
    // Weight: wᵢ = 1/SEᵢ²
    // Pooled: θ̂ = Σ(wᵢθᵢ) / Σwᵢ
    // SE(θ̂) = 1/√Σwᵢ

    var sum_w = 0.0
    var sum_w_theta = 0.0

    var i: i64 = 0
    while i < k {
        let se = studies[i as usize].se
        if se < 1.0e-10 { i = i + 1; continue }

        let w = 1.0 / (se * se)
        sum_w = sum_w + w
        sum_w_theta = sum_w_theta + w * studies[i as usize].effect
        i = i + 1
    }

    let pooled_effect = if sum_w > 1.0e-10 { sum_w_theta / sum_w } else { 0.0 }
    let pooled_se = if sum_w > 1.0e-10 { 1.0 / meta_sqrt(sum_w) } else { 0.0 }

    let z = if pooled_se > 1.0e-10 { pooled_effect / pooled_se } else { 0.0 }

    // Approximate two-tailed p-value
    let abs_z = meta_abs(z)
    let p_approx = if abs_z > 3.29 { 0.001 }
                   else if abs_z > 2.58 { 0.01 }
                   else if abs_z > 1.96 { 0.05 }
                   else if abs_z > 1.65 { 0.10 }
                   else { 0.50 }

    PooledEffect {
        effect: pooled_effect,
        se: pooled_se,
        ci_lower: pooled_effect - 1.96 * pooled_se,
        ci_upper: pooled_effect + 1.96 * pooled_se,
        z_stat: z,
        p_value: p_approx
    }
}

// =============================================================================
// HETEROGENEITY (Cochran's Q, I², τ²)
// =============================================================================

fn compute_heterogeneity(
    studies: [StudyResult; 50],
    k: i64,
    pooled_effect: f64
) -> Heterogeneity with Mut, Div, Panic {
    // Cochran's Q = Σ wᵢ(θᵢ - θ̂)²
    var q = 0.0
    var sum_w = 0.0
    var sum_w2 = 0.0

    var i: i64 = 0
    while i < k {
        let se = studies[i as usize].se
        if se < 1.0e-10 { i = i + 1; continue }

        let w = 1.0 / (se * se)
        let diff = studies[i as usize].effect - pooled_effect
        q = q + w * diff * diff
        sum_w = sum_w + w
        sum_w2 = sum_w2 + w * w
        i = i + 1
    }

    let df = k - 1
    let df_f = df as f64

    // I² = max(0, (Q - df) / Q * 100)
    let i_squared = if q > df_f {
        (q - df_f) / q * 100.0
    } else { 0.0 }

    // τ² (DerSimonian-Laird estimator)
    // τ² = max(0, (Q - df) / C)
    // where C = Σwᵢ - Σwᵢ²/Σwᵢ
    let c = sum_w - sum_w2 / sum_w
    let tau_squared = if q > df_f && c > 1.0e-10 {
        (q - df_f) / c
    } else { 0.0 }
    let tau = meta_sqrt(tau_squared)

    // H² = Q / df
    let h_squared = if df_f > 0.0 { q / df_f } else { 1.0 }

    // Approximate p-value for Q (chi-squared)
    let p_q = if q > 20.0 { 0.001 }
              else if q > 12.0 { 0.01 }
              else if q > 7.0 { 0.05 }
              else { 0.50 }

    Heterogeneity {
        q_stat: q,
        q_df: df,
        q_p_value: p_q,
        i_squared: i_squared,
        tau_squared: tau_squared,
        tau: tau,
        h_squared: h_squared
    }
}

// =============================================================================
// RANDOM-EFFECTS META-ANALYSIS (DerSimonian-Laird)
// =============================================================================

fn meta_random_effects(
    studies: [StudyResult; 50],
    k: i64,
    tau_squared: f64
) -> PooledEffect with Mut, Div, Panic {
    // Random-effects: effects vary across studies
    // Weight: wᵢ* = 1/(SEᵢ² + τ²)
    // Pooled: θ̂* = Σ(wᵢ*θᵢ) / Σwᵢ*

    var sum_w = 0.0
    var sum_w_theta = 0.0

    var i: i64 = 0
    while i < k {
        let se = studies[i as usize].se
        let vi = se * se + tau_squared

        if vi < 1.0e-10 { i = i + 1; continue }

        let w = 1.0 / vi
        sum_w = sum_w + w
        sum_w_theta = sum_w_theta + w * studies[i as usize].effect
        i = i + 1
    }

    let pooled_effect = if sum_w > 1.0e-10 { sum_w_theta / sum_w } else { 0.0 }
    let pooled_se = if sum_w > 1.0e-10 { 1.0 / meta_sqrt(sum_w) } else { 0.0 }

    let z = if pooled_se > 1.0e-10 { pooled_effect / pooled_se } else { 0.0 }

    let abs_z = meta_abs(z)
    let p_approx = if abs_z > 3.29 { 0.001 }
                   else if abs_z > 2.58 { 0.01 }
                   else if abs_z > 1.96 { 0.05 }
                   else if abs_z > 1.65 { 0.10 }
                   else { 0.50 }

    PooledEffect {
        effect: pooled_effect,
        se: pooled_se,
        ci_lower: pooled_effect - 1.96 * pooled_se,
        ci_upper: pooled_effect + 1.96 * pooled_se,
        z_stat: z,
        p_value: p_approx
    }
}

// =============================================================================
// PUBLICATION BIAS (Egger's Test)
// =============================================================================

fn egger_test(
    studies: [StudyResult; 50],
    k: i64
) -> PublicationBias with Mut, Div, Panic {
    // Egger's regression: effect/SE = α + β·(1/SE)
    // Test H₀: α = 0 (no funnel asymmetry)

    // Compute standardized effect and precision
    var precision: [f64; 50] = [0.0; 50]
    var std_effect: [f64; 50] = [0.0; 50]

    var i: i64 = 0
    while i < k {
        let se = studies[i as usize].se
        if se < 1.0e-10 { i = i + 1; continue }
        precision[i as usize] = 1.0 / se
        std_effect[i as usize] = studies[i as usize].effect / se
        i = i + 1
    }

    // Simple regression: std_effect = α + β·precision
    var sum_p = 0.0
    var sum_e = 0.0
    var sum_pp = 0.0
    var sum_pe = 0.0

    i = 0
    while i < k {
        let p = precision[i as usize]
        let e = std_effect[i as usize]
        sum_p = sum_p + p
        sum_e = sum_e + e
        sum_pp = sum_pp + p * p
        sum_pe = sum_pe + p * e
        i = i + 1
    }

    let kf = k as f64
    let mean_p = sum_p / kf
    let mean_e = sum_e / kf

    let cov_pe = sum_pe / kf - mean_p * mean_e
    let var_p = sum_pp / kf - mean_p * mean_p

    let beta_slope = if var_p > 1.0e-10 { cov_pe / var_p } else { 0.0 }
    let alpha_intercept = mean_e - beta_slope * mean_p

    // SE of intercept
    var ss_resid = 0.0
    i = 0
    while i < k {
        let pred = alpha_intercept + beta_slope * precision[i as usize]
        let resid = std_effect[i as usize] - pred
        ss_resid = ss_resid + resid * resid
        i = i + 1
    }
    let mse = ss_resid / (kf - 2.0)
    let se_alpha = meta_sqrt(mse * (1.0 / kf + mean_p * mean_p / (var_p * kf)))

    let t_stat = if se_alpha > 1.0e-10 { alpha_intercept / se_alpha } else { 0.0 }
    let abs_t = meta_abs(t_stat)

    let p_egger = if abs_t > 2.58 { 0.01 }
                  else if abs_t > 1.96 { 0.05 }
                  else if abs_t > 1.65 { 0.10 }
                  else { 0.50 }

    // Trim-and-fill: Duval-Tweedie R0 estimator
    // Reference: Duval & Tweedie (2000), Biometrics 56(2):455-463
    // R0 = max(0, k - 2*k_minor) where k_minor = studies on the smaller side
    var sum_eff = 0.0
    i = 0
    while i < k { sum_eff = sum_eff + studies[i as usize].effect; i = i + 1 }
    let mu_hat = sum_eff / kf

    var n_right: i64 = 0
    var n_left: i64 = 0
    i = 0
    while i < k {
        if studies[i as usize].effect > mu_hat { n_right = n_right + 1 }
        else { n_left = n_left + 1 }
        i = i + 1
    }
    let k_minor = if n_right < n_left { n_right } else { n_left }
    let trim_fill_n = if k - 2 * k_minor > 0 { k - 2 * k_minor } else { 0 }

    PublicationBias {
        egger_intercept: alpha_intercept,
        egger_se: se_alpha,
        egger_p: p_egger,
        bias_detected: p_egger < 0.10,
        trim_fill_added: trim_fill_n
    }
}

// =============================================================================
// FULL EPISTEMIC META-ANALYSIS
// =============================================================================

fn meta_analysis_epistemic(
    studies: [StudyResult; 50],
    k: i64
) -> KnowledgeMetaAnalysis with Mut, Div, Panic {
    // Step 1: Fixed-effects pooling
    let fixed = meta_fixed_effects(studies, k)

    // Step 2: Heterogeneity
    let het = compute_heterogeneity(studies, k, fixed.effect)

    // Step 3: Random-effects pooling
    let random = meta_random_effects(studies, k, het.tau_squared)

    // Step 4: Publication bias
    let bias = egger_test(studies, k)

    // Step 5: Compute study weights
    var weights_fixed: [f64; 50] = [0.0; 50]
    var weights_random: [f64; 50] = [0.0; 50]
    var sum_wf = 0.0
    var sum_wr = 0.0

    var i: i64 = 0
    while i < k {
        let se = studies[i as usize].se
        if se > 1.0e-10 {
            weights_fixed[i as usize] = 1.0 / (se * se)
            sum_wf = sum_wf + weights_fixed[i as usize]
            weights_random[i as usize] = 1.0 / (se * se + het.tau_squared)
            sum_wr = sum_wr + weights_random[i as usize]
        }
        i = i + 1
    }

    // Normalize weights to percentages
    i = 0
    while i < k {
        if sum_wf > 0.0 { weights_fixed[i as usize] = 100.0 * weights_fixed[i as usize] / sum_wf }
        if sum_wr > 0.0 { weights_random[i as usize] = 100.0 * weights_random[i as usize] / sum_wr }
        i = i + 1
    }

    let result = MetaAnalysisResult {
        fixed_effect: fixed,
        random_effect: random,
        heterogeneity: het,
        publication_bias: bias,
        study_weights_fixed: weights_fixed,
        study_weights_random: weights_random,
        n_studies: k
    }

    // Confidence assessment
    // 1. Number of studies
    let studies_conf = if k >= 10 { 0.90 }
                       else if k >= 5 { 0.75 }
                       else if k >= 3 { 0.60 }
                       else { 0.40 }
    let studies_beta = beta_new(studies_conf * (k as f64) * 3.0, (1.0 - studies_conf) * (k as f64) * 3.0)

    // 2. Heterogeneity (high I² → lower confidence)
    let het_conf = if het.i_squared < 25.0 { 0.90 }    // Low heterogeneity
                   else if het.i_squared < 50.0 { 0.75 } // Moderate
                   else if het.i_squared < 75.0 { 0.60 } // Substantial
                   else { 0.40 }                          // Considerable
    let het_beta = beta_new(het_conf * (k as f64) * 3.0, (1.0 - het_conf) * (k as f64) * 3.0)

    // 3. Publication bias
    let bias_conf = if !bias.bias_detected { 0.90 } else { 0.60 }
    let bias_beta = beta_new(bias_conf * (k as f64) * 3.0, (1.0 - bias_conf) * (k as f64) * 3.0)

    let conf1 = beta_combine(&studies_beta, &het_beta)
    let overall_conf = beta_combine(&conf1, &bias_beta)

    // Compute total N
    var total_n: i64 = 0
    i = 0
    while i < k { total_n = total_n + studies[i as usize].n; i = i + 1 }

    let prov = MetaProvenance {
        method: "DerSimonian_Laird",
        n_studies: k,
        total_n: total_n,
        heterogeneity: het,
        bias_assessment: bias
    }

    KnowledgeMetaAnalysis {
        value: result,
        variance: random.se * random.se,
        confidence: overall_conf,
        provenance: prov
    }
}

// =============================================================================
// Tests
// =============================================================================

fn test_meta_analysis_basic() -> bool with Mut, Div, Panic {
    // 5 studies with similar positive effects
    var studies: [StudyResult; 50] = [study_new(0.0, 1.0, 0); 50]
    studies[0] = study_new(0.50, 0.15, 100)
    studies[1] = study_new(0.45, 0.20, 80)
    studies[2] = study_new(0.60, 0.18, 120)
    studies[3] = study_new(0.55, 0.12, 150)
    studies[4] = study_new(0.40, 0.25, 60)

    let result = meta_analysis_epistemic(studies, 5)

    // Pooled effect should be around 0.5
    let effect_ok = result.value.random_effect.effect > 0.3 &&
                    result.value.random_effect.effect < 0.7

    // Should be significant
    let sig_ok = result.value.random_effect.p_value < 0.05

    // Low heterogeneity (similar studies)
    let het_ok = result.value.heterogeneity.i_squared < 50.0

    effect_ok && sig_ok && het_ok
}

fn test_high_heterogeneity() -> bool with Mut, Div, Panic {
    // Studies with very different effects → high I²
    var studies: [StudyResult; 50] = [study_new(0.0, 1.0, 0); 50]
    studies[0] = study_new(0.10, 0.10, 200)  // Small effect
    studies[1] = study_new(0.80, 0.10, 200)  // Large effect
    studies[2] = study_new(-0.20, 0.10, 200) // Negative
    studies[3] = study_new(0.50, 0.10, 200)  // Medium

    let result = meta_analysis_epistemic(studies, 4)

    // I² should be high
    let high_het = result.value.heterogeneity.i_squared > 50.0

    // Confidence should be lower due to heterogeneity
    let low_conf = beta_mean(&result.confidence) < 0.80

    high_het && low_conf
}
