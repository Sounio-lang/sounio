// stats::clinical::power_analysis — Extended Power & Sample Size
//
// Comprehensive sample size and power calculations for:
// - Two-sample t-test
// - Paired t-test
// - Two-proportions (chi-squared)
// - One-proportion (binomial)
// - Survival (log-rank)
// - Correlation (Pearson)
// - Linear regression (R²)
// - Equivalence/non-inferiority (TOST)
//
// All return Knowledge<PowerResult> with epistemic confidence
//
// References:
// - Cohen (1988): "Statistical Power Analysis for the Behavioral Sciences"
// - Lachin (1981): "Introduction to sample size determination"
// - Schoenfeld (1983): "Sample-size formula for the proportional-hazards model"
// - Chow et al. (2018): "Sample Size Calculations in Clinical Research"

// =============================================================================
// Math Helpers
// =============================================================================

struct _BetaConfidence {
    alpha: f64,
    beta: f64
}

fn beta_new(a: f64, b: f64) -> _BetaConfidence { _BetaConfidence { alpha: a, beta: b } }
fn beta_mean(b: &_BetaConfidence) -> f64 { b.alpha / (b.alpha + b.beta) }
fn beta_combine(b1: &_BetaConfidence, b2: &_BetaConfidence) -> _BetaConfidence {
    _BetaConfidence { alpha: b1.alpha + b2.alpha - 1.0, beta: b1.beta + b2.beta - 1.0 }
}

fn pow_abs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

fn pow_sqrt(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 25 { y = 0.5 * (y + x / y); i = i + 1 }
    y
}

fn pow_ln(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 - 1.0e30 }
    var m = x
    var e = 0
    while m >= 2.0 { m = m / 2.0; e = e + 1 }
    while m < 0.5 { m = m * 2.0; e = e - 1 }
    let t = (m - 1.0) / (m + 1.0)
    let t2 = t * t
    var sum = t
    var term = t
    var k = 1
    while k < 30 {
        term = term * t2
        sum = sum + term / (2 * k + 1) as f64
        k = k + 1
    }
    2.0 * sum + (e as f64) * 0.6931471805599453
}

fn pow_max(a: f64, b: f64) -> f64 { if a > b { a } else { b } }

// Inverse normal CDF (Abramowitz & Stegun rational approx)
// Returns z such that P(Z ≤ z) = p
fn qnorm(p: f64) -> f64 with Mut, Div, Panic {
    // For p in (0, 0.5]: use reflection
    if p <= 0.0 || p >= 1.0 { return 0.0 }

    let is_lower = p < 0.5
    let pp = if is_lower { p } else { 1.0 - p }

    // Rational approximation for normal quantile
    let t = pow_sqrt(-2.0 * pow_ln(pp))

    // Abramowitz & Stegun 26.2.23
    let c0 = 2.515517
    let c1 = 0.802853
    let c2 = 0.010328
    let d1 = 1.432788
    let d2 = 0.189269
    let d3 = 0.001308

    let z = t - (c0 + c1 * t + c2 * t * t) / (1.0 + d1 * t + d2 * t * t + d3 * t * t * t)

    if is_lower { 0.0 - z } else { z }
}

// =============================================================================
// Types
// =============================================================================

struct PowerResult {
    sample_size_per_group: i64,
    total_sample_size: i64,
    achieved_power: f64,
    alpha: f64,
    effect_size: f64,
    method: String
}



struct PowerProvenance {
    method: String,
    alpha: f64,
    power: f64,
    effect_size: f64,
    effect_size_source: String  // "observed", "literature", "clinically_meaningful"
}

struct KnowledgePower {
    value: PowerResult,
    variance: f64,
    confidence: _BetaConfidence,
    provenance: PowerProvenance
}

// =============================================================================
// TWO-SAMPLE T-TEST
// =============================================================================

fn sample_size_ttest(
    effect_size: f64,  // Cohen's d
    alpha: f64,         // Significance level (two-sided)
    power: f64          // Desired power (1 - β)
) -> PowerResult with Mut, Div, Panic {
    // n = (z_{1-α/2} + z_{1-β})² · 2 / d²
    // Cohen (1988) formula

    let z_alpha = qnorm(1.0 - alpha / 2.0)
    let z_beta = qnorm(power)

    let n_per_group = if pow_abs(effect_size) > 1.0e-10 {
        let n_exact = 2.0 * (z_alpha + z_beta) * (z_alpha + z_beta) / (effect_size * effect_size)
        (n_exact + 1.0) as i64  // Round up
    } else {
        1000000  // Infinite sample needed
    }

    PowerResult {
        sample_size_per_group: n_per_group,
        total_sample_size: 2 * n_per_group,
        achieved_power: power,
        alpha: alpha,
        effect_size: effect_size,
        method: "two_sample_ttest"
    }
}

// =============================================================================
// PAIRED T-TEST
// =============================================================================

fn sample_size_paired_ttest(
    effect_size: f64,  // Cohen's d (mean diff / SD of diffs)
    alpha: f64,
    power: f64
) -> PowerResult with Mut, Div, Panic {
    // n = (z_{1-α/2} + z_{1-β})² / d²

    let z_alpha = qnorm(1.0 - alpha / 2.0)
    let z_beta = qnorm(power)

    let n = if pow_abs(effect_size) > 1.0e-10 {
        let n_exact = (z_alpha + z_beta) * (z_alpha + z_beta) / (effect_size * effect_size)
        (n_exact + 1.0) as i64
    } else {
        1000000
    }

    PowerResult {
        sample_size_per_group: n,
        total_sample_size: n,  // Only one group
        achieved_power: power,
        alpha: alpha,
        effect_size: effect_size,
        method: "paired_ttest"
    }
}

// =============================================================================
// TWO PROPORTIONS (Chi-squared)
// =============================================================================

fn sample_size_two_proportions(
    p1: f64,  // Proportion in group 1
    p2: f64,  // Proportion in group 2
    alpha: f64,
    power: f64
) -> PowerResult with Mut, Div, Panic {
    // n = (z_{1-α/2}√(2p̄q̄) + z_{1-β}√(p₁q₁ + p₂q₂))² / (p₁ - p₂)²
    // where p̄ = (p₁ + p₂)/2, q = 1-p

    let p_bar = (p1 + p2) / 2.0
    let q_bar = 1.0 - p_bar
    let q1 = 1.0 - p1
    let q2 = 1.0 - p2

    let z_alpha = qnorm(1.0 - alpha / 2.0)
    let z_beta = qnorm(power)

    let diff = p1 - p2
    if pow_abs(diff) < 1.0e-10 {
        return PowerResult {
            sample_size_per_group: 1000000,
            total_sample_size: 2000000,
            achieved_power: power,
            alpha: alpha,
            effect_size: 0.0,
            method: "two_proportions"
        }
    }

    let numerator = z_alpha * pow_sqrt(2.0 * p_bar * q_bar) + z_beta * pow_sqrt(p1 * q1 + p2 * q2)
    let n_exact = (numerator * numerator) / (diff * diff)
    let n = (n_exact + 1.0) as i64

    // Effect size: Cohen's h = 2·arcsin(√p₁) - 2·arcsin(√p₂)
    // Approximate: h ≈ (p₁ - p₂) / √(p̄q̄)
    let h = diff / pow_sqrt(p_bar * q_bar)

    PowerResult {
        sample_size_per_group: n,
        total_sample_size: 2 * n,
        achieved_power: power,
        alpha: alpha,
        effect_size: h,
        method: "two_proportions"
    }
}

// =============================================================================
// SURVIVAL (Log-rank test)
// =============================================================================

fn sample_size_logrank(
    hazard_ratio: f64,  // HR (treatment vs control)
    alpha: f64,
    power: f64,
    prop_control: f64,  // Proportion in control arm
    prob_event: f64      // Overall probability of event
) -> PowerResult with Mut, Div, Panic {
    // Schoenfeld (1983): d = (z_{1-α/2} + z_{1-β})² / (log(HR))² · 4
    // Total N = d / prob_event

    let z_alpha = qnorm(1.0 - alpha / 2.0)
    let z_beta = qnorm(power)

    let log_hr = pow_ln(hazard_ratio)
    if pow_abs(log_hr) < 1.0e-10 {
        return PowerResult {
            sample_size_per_group: 1000000,
            total_sample_size: 2000000,
            achieved_power: power,
            alpha: alpha,
            effect_size: 0.0,
            method: "logrank"
        }
    }

    let p_t = 1.0 - prop_control
    let events_needed = ((z_alpha + z_beta) * (z_alpha + z_beta)) / (log_hr * log_hr * prop_control * p_t)
    let events = (events_needed + 1.0) as i64

    let total_n = if prob_event > 1.0e-10 {
        ((events as f64) / prob_event + 1.0) as i64
    } else { events * 10 }

    let n_per_group = (total_n + 1) / 2

    PowerResult {
        sample_size_per_group: n_per_group,
        total_sample_size: total_n,
        achieved_power: power,
        alpha: alpha,
        effect_size: hazard_ratio,
        method: "logrank"
    }
}

// =============================================================================
// CORRELATION
// =============================================================================

fn sample_size_correlation(
    r: f64,    // Expected correlation
    alpha: f64,
    power: f64
) -> PowerResult with Mut, Div, Panic {
    // Fisher's z-transform: z_r = 0.5·ln((1+r)/(1-r))
    // n = ((z_{1-α/2} + z_{1-β}) / z_r)² + 3

    let z_alpha = qnorm(1.0 - alpha / 2.0)
    let z_beta = qnorm(power)

    let abs_r = pow_abs(r)
    if abs_r > 0.999 || abs_r < 1.0e-10 {
        return PowerResult {
            sample_size_per_group: 1000000,
            total_sample_size: 1000000,
            achieved_power: power,
            alpha: alpha,
            effect_size: r,
            method: "correlation"
        }
    }

    let z_r = 0.5 * pow_ln((1.0 + abs_r) / (1.0 - abs_r))
    let ratio = (z_alpha + z_beta) / z_r
    let n = (ratio * ratio + 3.0 + 1.0) as i64

    PowerResult {
        sample_size_per_group: n,
        total_sample_size: n,
        achieved_power: power,
        alpha: alpha,
        effect_size: r,
        method: "correlation"
    }
}

// =============================================================================
// EQUIVALENCE / NON-INFERIORITY (TOST)
// =============================================================================

fn sample_size_equivalence(
    delta: f64,        // Equivalence margin
    true_diff: f64,    // Expected true difference (usually 0)
    sigma: f64,        // Standard deviation
    alpha: f64,        // One-sided alpha (typically 0.05)
    power: f64
) -> PowerResult with Mut, Div, Panic {
    // TOST: n = 2·((z_{1-α} + z_{1-β})·σ / (δ - |d|))²
    // where δ = equivalence margin, d = true difference

    let z_alpha = qnorm(1.0 - alpha)  // One-sided!
    let z_beta = qnorm(power)

    let margin = delta - pow_abs(true_diff)
    if margin <= 0.0 || sigma <= 0.0 {
        return PowerResult {
            sample_size_per_group: 1000000,
            total_sample_size: 2000000,
            achieved_power: power,
            alpha: alpha,
            effect_size: delta,
            method: "TOST_equivalence"
        }
    }

    let n_exact = 2.0 * ((z_alpha + z_beta) * sigma / margin) * ((z_alpha + z_beta) * sigma / margin)
    let n = (n_exact + 1.0) as i64

    PowerResult {
        sample_size_per_group: n,
        total_sample_size: 2 * n,
        achieved_power: power,
        alpha: alpha,
        effect_size: delta,
        method: "TOST_equivalence"
    }
}

// =============================================================================
// EPISTEMIC POWER ANALYSIS
// =============================================================================

fn power_analysis_epistemic(
    method: String,
    effect_size: f64,
    alpha: f64,
    power: f64,
    effect_source: String  // "observed", "literature", "clinically_meaningful"
) -> KnowledgePower with Mut, Div, Panic {
    let result = sample_size_ttest(effect_size, alpha, power)

    // Confidence depends on effect size source
    let source_conf = if effect_source == "observed" { 0.75 }       // Could be biased
                      else if effect_source == "literature" { 0.80 } // Published (pub bias)
                      else { 0.90 }                                  // Clinically meaningful

    // Effect size uncertainty
    let effect_conf = if pow_abs(effect_size) > 0.8 { 0.85 }  // Large: may be inflated
                      else if pow_abs(effect_size) > 0.5 { 0.90 } // Medium: typical
                      else { 0.80 }  // Small: hard to detect

    let source_beta = beta_new(source_conf * 20.0, (1.0 - source_conf) * 20.0)
    let effect_beta = beta_new(effect_conf * 20.0, (1.0 - effect_conf) * 20.0)
    let overall_conf = beta_combine(&source_beta, &effect_beta)

    // Variance on sample size estimate (from effect size uncertainty)
    // If effect size has SE, n ~ 1/d², so Var(n) ≈ 4n²·Var(d)/d²
    let n_variance = (result.total_sample_size as f64) * 0.1  // 10% uncertainty

    let prov = PowerProvenance {
        method: method,
        alpha: alpha,
        power: power,
        effect_size: effect_size,
        effect_size_source: effect_source
    }

    KnowledgePower {
        value: result,
        variance: n_variance,
        confidence: overall_conf,
        provenance: prov
    }
}

// =============================================================================
// Tests
// =============================================================================

fn test_ttest_sample_size() -> bool with Mut, Div, Panic {
    // Cohen's d = 0.5 (medium), α = 0.05, power = 0.80
    let result = sample_size_ttest(0.5, 0.05, 0.80)

    // Expected: ~64 per group (Cohen 1988, Table 2.4.1)
    let n_ok = result.sample_size_per_group >= 50 && result.sample_size_per_group <= 80

    n_ok
}

fn test_proportions_sample_size() -> bool with Mut, Div, Panic {
    // p1 = 0.50, p2 = 0.30, α = 0.05, power = 0.80
    let result = sample_size_two_proportions(0.50, 0.30, 0.05, 0.80)

    // Expected: ~93 per group
    let n_ok = result.sample_size_per_group >= 70 && result.sample_size_per_group <= 120

    n_ok
}

fn test_logrank_sample_size() -> bool with Mut, Div, Panic {
    // HR = 0.7, α = 0.05, power = 0.80, equal allocation, 60% event rate
    let result = sample_size_logrank(0.7, 0.05, 0.80, 0.5, 0.60)

    // Expected: ~300-400 total
    let n_ok = result.total_sample_size >= 200 && result.total_sample_size <= 600

    n_ok
}

fn test_equivalence_sample_size() -> bool with Mut, Div, Panic {
    // δ = 0.5, true_diff = 0, σ = 1, α = 0.05, power = 0.80
    let result = sample_size_equivalence(0.5, 0.0, 1.0, 0.05, 0.80)

    // Expected: ~70 per group
    let n_ok = result.sample_size_per_group >= 50 && result.sample_size_per_group <= 100

    n_ok
}
