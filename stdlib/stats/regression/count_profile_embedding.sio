// Exact operational binary64 nesting witness; not a real-arithmetic proof.
use collections::numeric_buffer::{NumericBuffer,NumericMatrix,numeric_buffer_status,numeric_buffer_len,numeric_buffer_at,numeric_buffer_set,numeric_matrix_fits,numeric_matrix_rows,numeric_matrix_cols,numeric_matrix_at}
use math::pure::{is_finite}
pub fn count_profile_embedding_validate(null_design:&NumericBuffer,null_layout:&NumericMatrix,null_offsets:&NumericBuffer,
 alternative_design:&NumericBuffer,alternative_layout:&NumericMatrix,alternative_offsets:&NumericBuffer,
 embedding:&NumericBuffer)->i64 with Mut,Div,Panic {
 if !numeric_matrix_fits(null_design,null_layout) || !numeric_matrix_fits(alternative_design,alternative_layout) {return 13}
 let n=numeric_matrix_rows(null_layout)
 let p0=numeric_matrix_cols(null_layout)
 let p1=numeric_matrix_cols(alternative_layout)
 if n<1 || p0<1 || p1<p0 {return 13}
 if numeric_matrix_rows(alternative_layout)!=n {return 13}
 if p1>9223372036854775807/p0 {return 13}
 if numeric_buffer_status(embedding)!=0 || numeric_buffer_status(null_offsets)!=0 || numeric_buffer_status(alternative_offsets)!=0 {return 13}
 if numeric_buffer_len(embedding)!=p1*p0 || numeric_buffer_len(null_offsets)!=n || numeric_buffer_len(alternative_offsets)!=n {return 13}
 var j:i64=0
 while j<p1*p0 {if !is_finite(numeric_buffer_at(embedding,j)) {return 13};j=j+1}
 var i:i64=0
 while i<n {
  let o0=numeric_buffer_at(null_offsets,i)
  let o1=numeric_buffer_at(alternative_offsets,i)
  if !is_finite(o0) || !is_finite(o1) || o0!=o1 {return 13}
  j=0
  while j<p0 {
   let expected=numeric_matrix_at(null_design,null_layout,i,j)
   if !is_finite(expected) {return 13}
   var sum:f64=0.0
   var correction:f64=0.0
   var k:i64=0
   while k<p1 {
    let coordinate=numeric_matrix_at(alternative_design,alternative_layout,i,k)
    let coefficient=numeric_buffer_at(embedding,k*p0+j)
    if !is_finite(coordinate) {return 13}
    let product=coordinate*coefficient
    if !is_finite(product) {return 13}
    if coordinate!=0.0 {if coefficient!=0.0 {if product==0.0 {return 13}}}
    let adjusted=product-correction
    let next=sum+adjusted
    correction=(next-sum)-adjusted;sum=next
    if !is_finite(sum) || !is_finite(correction) {return 13}
    k=k+1
   }
   if sum!=expected {return 13}
   j=j+1
  }
  i=i+1
 }
 return 0
}
pub fn count_profile_embedding_warm(embedding:&NumericBuffer,null_coefficients:&NumericBuffer,
 p0:i64,p1:i64,warm_start:&!NumericBuffer)->i64 with Mut,Div,Panic {
 if p0<1 || p1<p0 {return 13}
 if p1>9223372036854775807/p0 {return 13}
 if numeric_buffer_status(warm_start)!=0 || numeric_buffer_status(embedding)!=0 || numeric_buffer_status(null_coefficients)!=0 {return 13}
 if numeric_buffer_len(warm_start)!=p1 || numeric_buffer_len(embedding)!=p1*p0 || numeric_buffer_len(null_coefficients)!=p0 {return 13}
 var j:i64=0
 while j<p1 {
  var sum:f64=0.0
  var correction:f64=0.0
  var k:i64=0
  while k<p0 {
   let a=numeric_buffer_at(embedding,j*p0+k)
   let b=numeric_buffer_at(null_coefficients,k)
   if !is_finite(a) || !is_finite(b) {return 13}
   let product=a*b
   if !is_finite(product) {return 13}
   if a!=0.0 {if b!=0.0 {if product==0.0 {return 13}}}
   let adjusted=product-correction
   let next=sum+adjusted
   correction=(next-sum)-adjusted;sum=next
   if !is_finite(sum) || !is_finite(correction) {return 13}
   k=k+1
  }
  numeric_buffer_set(warm_start,j,sum)
  j=j+1
 }
 return 0
}
