// Caller-owned scalar counters. No solver output or numerical parameter is stored.
// Notes count actual attempted callsites, not work inferred from result fields.
// status0 exact recorded prefix;1 explicit counter limit exhausted;2 bad control.
pub struct CountFitTraceSlot {
 status:i64,limit:i64,configured:bool,fit_calls:i64,irls_entries:i64,initial_rank_qr_calls:i64,weighted_qr_calls:i64,profile_point_evaluations:i64,paired_rank_calls:i64,full_logpmf_row_calls:i64,null_cold_searches:i64,replica_null_seeded_searches:i64,alternative_seeded_searches:i64,normalizer_evaluations:i64,normalizer_cache_hits:i64,normalizer_cache_bypasses:i64,
}
pub struct CountFitTrace {
 pub status:i64,pub limit:i64,pub fit_calls:i64,pub irls_entries:i64,pub initial_rank_qr_calls:i64,pub weighted_qr_calls:i64,pub profile_point_evaluations:i64,pub paired_rank_calls:i64,pub full_logpmf_row_calls:i64,pub null_cold_searches:i64,pub replica_null_seeded_searches:i64,pub alternative_seeded_searches:i64,
}
pub fn count_fit_trace_bounded(limit:i64)->CountFitTraceSlot {
 CountFitTraceSlot{status:if limit<0 {2}else{0},limit:if limit<0 {0}else{limit},configured:limit>=0,fit_calls:0,irls_entries:0,initial_rank_qr_calls:0,weighted_qr_calls:0,profile_point_evaluations:0,paired_rank_calls:0,full_logpmf_row_calls:0,null_cold_searches:0,replica_null_seeded_searches:0,alternative_seeded_searches:0,normalizer_evaluations:0,normalizer_cache_hits:0,normalizer_cache_bypasses:0}
}
pub fn count_fit_trace_slot()->CountFitTraceSlot {count_fit_trace_bounded(9223372036854775807)}
pub fn count_fit_trace_status(s:&CountFitTraceSlot)->i64 {s.status}
pub fn count_fit_trace_reset(s:&!CountFitTraceSlot) with Mut {
 s.status=if s.configured {0}else{2}
 s.fit_calls=0;s.irls_entries=0;s.initial_rank_qr_calls=0;s.weighted_qr_calls=0;s.profile_point_evaluations=0;s.paired_rank_calls=0;s.full_logpmf_row_calls=0;s.null_cold_searches=0;s.replica_null_seeded_searches=0;s.alternative_seeded_searches=0
 s.normalizer_evaluations=0;s.normalizer_cache_hits=0;s.normalizer_cache_bypasses=0
}
// Metric IDs1..10 in the declaration order above. Invalid ID latches status2.
pub fn count_fit_trace_add(s:&!CountFitTraceSlot,metric:i64,amount:i64)->i64 with Mut {
 if s.status!=0 {return s.status}
 if amount<0 {s.status=2;return 2}
 if metric==1 {
  if s.fit_calls<0 || s.fit_calls>s.limit {s.status=1;return 1}
  if amount>s.limit-s.fit_calls {s.status=1;return 1}
  s.fit_calls=s.fit_calls+amount
  return 0
 }
 if metric==2 {
  if s.irls_entries<0 || s.irls_entries>s.limit {s.status=1;return 1}
  if amount>s.limit-s.irls_entries {s.status=1;return 1}
  s.irls_entries=s.irls_entries+amount
  return 0
 }
 if metric==3 {
  if s.initial_rank_qr_calls<0 || s.initial_rank_qr_calls>s.limit {s.status=1;return 1}
  if amount>s.limit-s.initial_rank_qr_calls {s.status=1;return 1}
  s.initial_rank_qr_calls=s.initial_rank_qr_calls+amount
  return 0
 }
 if metric==4 {
  if s.weighted_qr_calls<0 || s.weighted_qr_calls>s.limit {s.status=1;return 1}
  if amount>s.limit-s.weighted_qr_calls {s.status=1;return 1}
  s.weighted_qr_calls=s.weighted_qr_calls+amount
  return 0
 }
 if metric==5 {
  if s.profile_point_evaluations<0 || s.profile_point_evaluations>s.limit {s.status=1;return 1}
  if amount>s.limit-s.profile_point_evaluations {s.status=1;return 1}
  s.profile_point_evaluations=s.profile_point_evaluations+amount
  return 0
 }
 if metric==6 {
  if s.paired_rank_calls<0 || s.paired_rank_calls>s.limit {s.status=1;return 1}
  if amount>s.limit-s.paired_rank_calls {s.status=1;return 1}
  s.paired_rank_calls=s.paired_rank_calls+amount
  return 0
 }
 if metric==7 {
  if s.full_logpmf_row_calls<0 || s.full_logpmf_row_calls>s.limit {s.status=1;return 1}
  if amount>s.limit-s.full_logpmf_row_calls {s.status=1;return 1}
  s.full_logpmf_row_calls=s.full_logpmf_row_calls+amount
  return 0
 }
 if metric==8 {
  if s.null_cold_searches<0 || s.null_cold_searches>s.limit {s.status=1;return 1}
  if amount>s.limit-s.null_cold_searches {s.status=1;return 1}
  s.null_cold_searches=s.null_cold_searches+amount
  return 0
 }
 if metric==9 {
  if s.replica_null_seeded_searches<0 || s.replica_null_seeded_searches>s.limit {s.status=1;return 1}
  if amount>s.limit-s.replica_null_seeded_searches {s.status=1;return 1}
  s.replica_null_seeded_searches=s.replica_null_seeded_searches+amount
  return 0
 }
 if metric==10 {
  if s.alternative_seeded_searches<0 || s.alternative_seeded_searches>s.limit {s.status=1;return 1}
  if amount>s.limit-s.alternative_seeded_searches {s.status=1;return 1}
  s.alternative_seeded_searches=s.alternative_seeded_searches+amount
  return 0
 }
 s.status=2
 return 2
}
pub fn count_fit_trace_note(s:&!CountFitTraceSlot,metric:i64)->i64 with Mut {count_fit_trace_add(s,metric,1)}
pub fn count_fit_trace_incomplete(s:&!CountFitTraceSlot)->i64 with Mut {
 if s.status==0 {s.status=1}
 s.status
}
pub fn count_fit_trace_metric(s:&CountFitTraceSlot,metric:i64)->i64 {
 if metric==1 {return s.fit_calls}
 if metric==2 {return s.irls_entries}
 if metric==3 {return s.initial_rank_qr_calls}
 if metric==4 {return s.weighted_qr_calls}
 if metric==5 {return s.profile_point_evaluations}
 if metric==6 {return s.paired_rank_calls}
 if metric==7 {return s.full_logpmf_row_calls}
 if metric==8 {return s.null_cold_searches}
 if metric==9 {return s.replica_null_seeded_searches}
 if metric==10 {return s.alternative_seeded_searches}
 return -1
}
pub fn count_fit_trace_snapshot(s:&CountFitTraceSlot)->CountFitTrace {
 let status:i64=s.status
 let limit:i64=s.limit
 let fit_calls:i64=s.fit_calls
 let irls_entries:i64=s.irls_entries
 let initial_rank_qr_calls:i64=s.initial_rank_qr_calls
 let weighted_qr_calls:i64=s.weighted_qr_calls
 let profile_point_evaluations:i64=s.profile_point_evaluations
 let paired_rank_calls:i64=s.paired_rank_calls
 let full_logpmf_row_calls:i64=s.full_logpmf_row_calls
 let null_cold_searches:i64=s.null_cold_searches
 let replica_null_seeded_searches:i64=s.replica_null_seeded_searches
 let alternative_seeded_searches:i64=s.alternative_seeded_searches
 CountFitTrace{status:status,limit:limit,fit_calls:fit_calls,irls_entries:irls_entries,initial_rank_qr_calls:initial_rank_qr_calls,weighted_qr_calls:weighted_qr_calls,profile_point_evaluations:profile_point_evaluations,paired_rank_calls:paired_rank_calls,full_logpmf_row_calls:full_logpmf_row_calls,null_cold_searches:null_cold_searches,replica_null_seeded_searches:replica_null_seeded_searches,alternative_seeded_searches:alternative_seeded_searches}
}

// Additional named cache counters do not extend IDs1..10 or the public snapshot.
// Units: actual top-level saturated-normalizer call, successful cache lookup,
// and count>=64 bypass in the cached profile PMF path, respectively.
pub fn count_fit_trace_normalizer_evaluations(s:&CountFitTraceSlot)->i64 {s.normalizer_evaluations}
pub fn count_fit_trace_normalizer_cache_hits(s:&CountFitTraceSlot)->i64 {s.normalizer_cache_hits}
pub fn count_fit_trace_normalizer_cache_bypasses(s:&CountFitTraceSlot)->i64 {s.normalizer_cache_bypasses}
pub fn count_fit_trace_normalizer_add(s:&!CountFitTraceSlot,kind:i64,amount:i64)->i64 with Mut {
 if s.status!=0 {return s.status}
 if amount<0 {s.status=2;return 2}
 var current:i64=0
 if kind==1 {current=s.normalizer_evaluations} else {
  if kind==2 {current=s.normalizer_cache_hits} else {
   if kind==3 {current=s.normalizer_cache_bypasses} else {s.status=2;return 2}
  }
 }
 if current<0 || current>s.limit {s.status=1;return 1}
 if amount>s.limit-current {s.status=1;return 1}
 let next=current+amount
 if kind==1 {s.normalizer_evaluations=next} else {
  if kind==2 {s.normalizer_cache_hits=next} else {s.normalizer_cache_bypasses=next}
 }
 return 0
}
pub fn count_fit_trace_normalizer_note(s:&!CountFitTraceSlot,kind:i64)->i64 with Mut {
 count_fit_trace_normalizer_add(s,kind,1)
}
