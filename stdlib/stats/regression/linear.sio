// Simple OLS with stable scaling, Student inference and real case deletion.
// Assumption assessment remains explicitly unavailable; Beta(1,1) fields are
// compatibility sentinels, not calibrated evidence or assumption tests.
use math::pure::{is_finite}
use stats::student_t::{t_two_tail, t_quantile}
use stats::regression::ols::{SimpleOlsFit, ols_fit_simple, ols_influence_simple}
pub use stats::shared::*
use stats::shared::{beta_new}


// ============================================================================
// CORE TYPES
// ============================================================================

/// Linear model coefficients and statistics.
///
/// # Builder Pattern
///
/// ```sio
/// let model = LinearRegression::new()
///     .with_data(&x, &y, n)
///     .fit();
///
/// // Or with method chaining:
/// let prediction = LinearRegression::new()
///     .with_data(&x, &y, n)
///     .fit()
///     .predict(5.0);
/// ```
pub struct LinearModel {
    pub coefficients: [f64; 10],      // β₀, β₁, ..., β_p
    pub std_errors: [f64; 10],         // SE(βⱼ)
    pub t_statistics: [f64; 10],       // t = βⱼ / SE(βⱼ)
    pub p_values: [f64; 10],           // Two-tailed p-values
    pub n_predictors: i64,             // Number of predictors (excluding intercept)
    pub n_obs: i64,                    // Sample size
    pub r_squared: f64,                // R²
    pub adj_r_squared: f64,            // Adjusted R²
    pub f_statistic: f64,              // Overall model F-test
    pub residual_se: f64,              // Residual standard error
    pub residuals: [f64; 100],
    pub fit_status: i64,
    pub inference_status: i64,
    pub r_squared_defined: bool
}

// ============================================================================
// LinearRegression Builder
// ============================================================================

/// Builder for linear regression with method chaining.
///
/// # Example
///
/// ```sio
/// let model = LinearRegression::builder()
///     .with_x(&x)
///     .with_y(&y)
///     .with_n(10)
///     .fit_simple();
///
/// // Predict new value
/// let y_pred = model.predict(5.0);
/// ```
pub struct LinearRegression {
    pub x: [f64; 100],
    pub y: [f64; 100],
    pub n: i64,
    pub fitted: bool,
    pub model: LinearModel,
}

impl LinearRegression {
    /// Create a new empty regression builder.
    pub fn builder() -> LinearRegression {
        LinearRegression {
            x: [0.0; 100],
            y: [0.0; 100],
            n: 0,
            fitted: false,
            model: LinearModel {
                coefficients: [0.0; 10],
                std_errors: [0.0; 10],
                t_statistics: [0.0; 10],
                p_values: [1.0; 10],
                n_predictors: 0,
                n_obs: 0,
                r_squared: 0.0,
                adj_r_squared: 0.0,
                f_statistic: 0.0,
                residual_se: 0.0,
                residuals: [0.0; 100],
                fit_status: 1, inference_status: 1, r_squared_defined: false,
            },
        }
    }

    /// Alias for builder() for convenience.
    pub fn new() -> LinearRegression {
        LinearRegression::builder()
    }

    /// Set predictor variable X.
    pub fn with_x(self, x: [f64; 100]) -> LinearRegression with Mut {
        var result = self
        result.x = x
        result
    }

    /// Set response variable Y.
    pub fn with_y(self, y: [f64; 100]) -> LinearRegression with Mut {
        var result = self
        result.y = y
        result
    }

    /// Set number of observations.
    pub fn with_n(self, n: i64) -> LinearRegression with Mut {
        var result = self
        result.n = n
        result
    }

    /// Set all data at once.
    pub fn with_data(self, x: [f64; 100], y: [f64; 100], n: i64) -> LinearRegression with Mut {
        var result = self
        result.x = x
        result.y = y
        result.n = n
        result
    }

    /// Fit simple linear regression (y = β₀ + β₁x).
    pub fn fit_simple(self) -> LinearModel with Mut, Div, Panic {
        fit_simple_linear_regression(self.x, self.y, self.n)
    }

    /// Fit epistemic linear regression with full diagnostics.
    pub fn fit_epistemic(self) -> KnowledgeLinearModel with Mut, Div, Panic {
        fit_linear_regression_epistemic(self.x, self.y, self.n)
    }
}

impl LinearModel {
    /// Predict y for a given x value.
    ///
    /// # Parameters
    /// - `x_val`: Predictor value
    ///
    /// # Return
    /// Predicted y value (ŷ = β₀ + β₁x)
    pub fn predict(self: &LinearModel, x_val: f64) -> f64 {
        self.coefficients[0] + self.coefficients[1] * x_val
    }

    /// Get intercept (β₀).
    pub fn intercept(self: &LinearModel) -> f64 {
        self.coefficients[0]
    }

    /// Get slope (β₁).
    pub fn slope(self: &LinearModel) -> f64 {
        self.coefficients[1]
    }

    /// Get standard error of slope.
    pub fn slope_se(self: &LinearModel) -> f64 {
        self.std_errors[1]
    }

    /// Get R² (coefficient of determination).
    pub fn r2(self: &LinearModel) -> f64 {
        self.r_squared
    }

    /// Get adjusted R².
    pub fn adj_r2(self: &LinearModel) -> f64 {
        self.adj_r_squared
    }

    /// Check if slope is significant at p < 0.05.
    pub fn is_slope_significant(self: &LinearModel) -> bool {
        self.fit_status == 0 && self.inference_status == 0 && self.p_values[1] < 0.05
    }

    /// 95% Student interval, conditional on the ordinary regression assumptions.
    /// Requires a valid fit with positive residual variance.
    pub fn slope_ci(self: &LinearModel) -> (f64, f64) with Mut, Div, Panic {
        linear_slope_ci(self)
    }
}

// Regression diagnostics
pub struct ModelDiagnostics {
    pub vif: [f64; 10],
    pub cooks_distance: [f64; 100],
    pub leverage: [f64; 100],
    pub dffits: [f64; 100],
    pub normality_resid: BetaConfidence,
    pub homoscedasticity: BetaConfidence,
    pub no_autocorrelation: BetaConfidence,
    pub no_multicollinearity: BetaConfidence,
    pub influential_points: i64,
    pub status: i64,
    pub dffits_status: [i64;100],
    pub cooks_status: [i64;100],
    pub dffits_cutoff: f64,
    pub dffits_valid_count: i64,
    pub dffits_flagged_count: i64
}

// assessment_status: 1=unassessed, 2=invalid fit. All five fields are sentinels.
pub struct RegressionAssumptions {
    pub assessment_status: i64,
    pub linearity: BetaConfidence,
    pub normality_residuals: BetaConfidence,
    pub homoscedasticity: BetaConfidence,
    pub independence: BetaConfidence,
    pub no_multicollinearity: BetaConfidence
}

pub struct RegressionProvenance {
    pub method_code: i32,  // 0=OLS, 1=WeightedLS, 2=RobustLS
    pub n_obs: i64,
    pub n_predictors: i64,
    pub timestamp: i64,
    pub assumptions: RegressionAssumptions,
    pub diagnostics: ModelDiagnostics
}

pub struct KnowledgeLinearModel {
    pub value: LinearModel,
    pub variance: f64,
    pub variance_status: i64,
    pub confidence: BetaConfidence,
    pub provenance: RegressionProvenance
}


pub fn fit_simple_linear_regression(x: [f64;100], y: [f64;100], n: i64) -> LinearModel with Mut, Div, Panic {
    let fit=ols_fit_simple(&x,&y,n)
    linear_model_from_fit(&fit,n)
}
fn linear_model_from_fit(fit: &SimpleOlsFit, n: i64) -> LinearModel with Mut, Div, Panic {
    var model=linear_regression_new().model
    model.fit_status=fit.status
    model.inference_status=fit.inference_status
    model.n_obs=fit.n
    model.n_predictors=1
    if fit.status != 0 { return model }
    model.coefficients[0]=fit.intercept
    model.coefficients[1]=fit.slope
    model.std_errors[0]=fit.intercept_se
    model.std_errors[1]=fit.slope_se
    model.residuals=fit.residuals
    model.residual_se=fit.residual_se
    model.r_squared=fit.r_squared
    model.r_squared_defined=fit.r_squared_defined
    if fit.r_squared_defined {
        model.adj_r_squared=1.0-(1.0-fit.r_squared)*((n-1) as f64)/((n-2) as f64)
    }
    if fit.inference_status == 0 {
        let t0: f64=fit.intercept/fit.intercept_se
        let t1: f64=fit.slope/fit.slope_se
        let f: f64=t1*t1
        if !is_finite(t0) || !is_finite(t1) || !is_finite(f) {
            model.inference_status=5
            return model
        }
        model.t_statistics[0]=t0
        model.t_statistics[1]=t1
        model.p_values[0]=t_two_tail(t0,(n-2) as f64)
        model.p_values[1]=t_two_tail(t1,(n-2) as f64)
        model.f_statistic=f
    }
    model
}

pub fn linear_slope_ci(model: &LinearModel) -> (f64,f64) with Mut, Div, Panic {
    assert(model.fit_status == 0 && model.inference_status == 0)
    let critical=t_quantile(0.975,(model.n_obs-2) as f64)
    let margin=critical*model.std_errors[1]
    let lower=model.coefficients[1]-margin
    let upper=model.coefficients[1]+margin
    assert(is_finite(lower) && is_finite(upper))
    (lower,upper)
}

pub fn fit_linear_regression_epistemic(x: [f64;100], y: [f64;100], n: i64) -> KnowledgeLinearModel with Mut, Div, Panic {
    let influence=ols_influence_simple(&x,&y,n)
    let model=linear_model_from_fit(&influence.fit,n)
    var vif: [f64;10]=[0.0;10]
    if model.fit_status == 0 { vif[1]=1.0 }
    var influential: i64=0
    var i: i64=0
    while i < influence.n {
        if influence.cooks_status[i as usize] == 0 && influence.cooks_distance[i as usize] > 1.0 {
            influential=influential+1
        }
        i=i+1
    }
    let diagnostics=ModelDiagnostics {
        vif: vif, cooks_distance: influence.cooks_distance,
        leverage: influence.fit.leverage, dffits: influence.dffits,
        normality_resid: beta_new(1.0,1.0), homoscedasticity: beta_new(1.0,1.0),
        no_autocorrelation: beta_new(1.0,1.0), no_multicollinearity: beta_new(1.0,1.0),
        influential_points: influential, status: influence.status,
        dffits_status: influence.dffits_status, cooks_status: influence.cooks_status,
        dffits_cutoff: influence.screening_cutoff,
        dffits_valid_count: influence.valid_count, dffits_flagged_count: influence.flagged_count
    }
    let assessment: i64=if model.fit_status == 0 { 1 } else { 2 }
    let assumptions=RegressionAssumptions {
        assessment_status: assessment,
        linearity: beta_new(1.0,1.0), normality_residuals: beta_new(1.0,1.0),
        homoscedasticity: beta_new(1.0,1.0), independence: beta_new(1.0,1.0),
        no_multicollinearity: beta_new(1.0,1.0)
    }
    var coefficient_variance: f64=model.std_errors[1]*model.std_errors[1]
    var variance_status: i64=model.fit_status
    if model.fit_status == 0 {
        variance_status=0
        if !is_finite(coefficient_variance) || (model.std_errors[1] != 0.0 && coefficient_variance == 0.0) {
            coefficient_variance=0.0
            variance_status=5
        }
    }
    KnowledgeLinearModel {
        variance: coefficient_variance, variance_status: variance_status, value: model,
        confidence: beta_new(1.0,1.0),
        provenance: RegressionProvenance { method_code: 0, n_obs: n, n_predictors: 1,
            timestamp: 0, assumptions: assumptions, diagnostics: diagnostics }
    }
}

/// Empty model has explicit invalid statuses and inactive p-value sentinels.
pub fn linear_regression_new() -> LinearRegression {
    LinearRegression::builder()
}
