// Joint residual summaries for stable simple OLS, with per-procedure status.
// No overall "assumptions passed" or p-to-posterior conversion.
use stats::regression::ols::{SimpleOlsFit,ols_fit_simple}
use stats::normality::{NormalityResult,normality}
use stats::heteroscedasticity::{KoenkerResult,koenker_bp_simple}
use stats::shapiro_wilk::{ShapiroResult,shapiro_wilk}
pub struct SimpleRegressionAssessment {
 pub fit:SimpleOlsFit,
 pub normality:NormalityResult,
 pub heteroscedasticity:KoenkerResult,
 pub shapiro:ShapiroResult,
}
pub fn assess_simple_linear(x:&[f64;100],y:&[f64;100],n:i64)->SimpleRegressionAssessment with Mut,Div,Panic {
 let fit=ols_fit_simple(x,y,n)
 var residuals:[f64;100]=[0.0;100]
 var expanded:[f64;256]=[0.0;256]
 var effective:i64=0
 if fit.status==0 {
  effective=n
  var i:i64=0
  while i<n {
   let e:f64=fit.residuals[i as usize]
   residuals[i as usize]=e
   expanded[i as usize]=e
   i=i+1
  }
 }
 // On fit failure, subtests are unavailable with invalid effective size;
 // consumers must retain fit.status as the primary reason.
 let jb=normality(&expanded,effective as i32)
 let kb=koenker_bp_simple(&residuals,x,effective)
 let sw=shapiro_wilk(&residuals,effective)
 return SimpleRegressionAssessment{fit:fit,normality:jb,heteroscedasticity:kb,shapiro:sw}
}
