 alternative_coefficients:&!NumericBuffer,alternative_means:&!NumericBuffer,
 alternative_eta:&!NumericBuffer,alternative_weighted:&!NumericBuffer,
 alternative_response:&!NumericBuffer,alternative_step:&!NumericBuffer,
 alternative_qr:&!NumericBuffer,alternative_stage:&!NumericBuffer,
 null_candidate_coefficients:&!NumericBuffer,null_candidate_means:&!NumericBuffer,null_candidate_eta:&!NumericBuffer,null_best_coefficients:&!NumericBuffer,null_best_means:&!NumericBuffer,null_best_eta:&!NumericBuffer,null_factor_r:&!NumericBuffer,null_factor_scales:&!NumericBuffer,null_permutation:&!IntegerBuffer,
 alternative_candidate_coefficients:&!NumericBuffer,alternative_candidate_means:&!NumericBuffer,alternative_candidate_eta:&!NumericBuffer,alternative_best_coefficients:&!NumericBuffer,alternative_best_means:&!NumericBuffer,alternative_best_eta:&!NumericBuffer,alternative_factor_r:&!NumericBuffer,alternative_factor_scales:&!NumericBuffer,alternative_permutation:&!IntegerBuffer,embedding:&NumericBuffer,warm_start:&!NumericBuffer,trace:&!CountFitTraceSlot)->CountProfileBootstrapResult with Mut,Div,Panic {
 cpb_nested_engine(null_design,null_layout,null_offsets,null_initial,alternative_design,alternative_layout,alternative_offsets,alternative_initial,observed_counts,options,rng,replicate_counts,generating_means,null_coefficients,null_means,null_eta,null_weighted,null_response,null_step,null_qr,null_stage,alternative_coefficients,alternative_means,alternative_eta,alternative_weighted,alternative_response,alternative_step,alternative_qr,alternative_stage,null_candidate_coefficients,null_candidate_means,null_candidate_eta,null_best_coefficients,null_best_means,null_best_eta,null_factor_r,null_factor_scales,null_permutation,alternative_candidate_coefficients,alternative_candidate_means,alternative_candidate_eta,alternative_best_coefficients,alternative_best_means,alternative_best_eta,alternative_factor_r,alternative_factor_scales,alternative_permutation,embedding,warm_start,true,trace)
