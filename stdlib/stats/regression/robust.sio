// Private legacy routines are retained for source compatibility only.
// robust_fit_checked supplies the bounded checked point-fit contract.
// No calibrated SE, model efficiency or breakdown guarantee is supplied.
use math::pure::{is_finite}
use stats::order::{sort256}
use linalg::least_squares::{qr_least_squares}
use linalg::weighted_least_squares::{weighted_qr_least_squares}
// stats::regression::robust — Robust Regression with M-Estimators
//
// Outlier-resistant regression using:
// - Huber M-estimator (ψ = min(|r|, k))
// - Tukey bisquare M-estimator (fully redescending)
// - Iteratively Reweighted Least Squares (IRLS)
// - Breakdown point analysis
//
// Returns Knowledge<RobustModel> with confidence and diagnostics
//
// References:
// - Huber (1964): "Robust estimation of a location parameter"
// - Tukey (1977): "Exploratory Data Analysis" (bisquare)
// - Maronna et al. (2019): "Robust Statistics: Theory and Methods"
// - Rousseeuw & Leroy (1987): "Robust Regression and Outlier Detection"

// =============================================================================
// Math Helpers
// =============================================================================

struct RobustBetaConfidence {
    alpha: f64,
    beta: f64
}

fn rob_beta_new(a: f64, b: f64) -> RobustBetaConfidence { RobustBetaConfidence { alpha: a, beta: b } }
fn rob_beta_mean(b: &RobustBetaConfidence) -> f64 { b.alpha / (b.alpha + b.beta) }
fn rob_beta_combine(b1: &RobustBetaConfidence, b2: &RobustBetaConfidence) -> RobustBetaConfidence {
    RobustBetaConfidence { alpha: b1.alpha + b2.alpha - 1.0, beta: b1.beta + b2.beta - 1.0 }
}

fn rob_abs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

fn rob_sqrt(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 25 { y = 0.5 * (y + x / y); i = i + 1 }
    y
}

fn rob_max(a: f64, b: f64) -> f64 { if a > b { a } else { b } }
fn rob_min(a: f64, b: f64) -> f64 { if a < b { a } else { b } }

fn rob_sign(x: f64) -> f64 {
    if x > 0.0 { 1.0 }
    else if x < 0.0 { -1.0 }
    else { 0.0 }
}

// =============================================================================
// Types
// =============================================================================

struct RobustModel {
    inference_status:i64, // 1 unavailable: weighted OLS SE is not M-estimator inference
    coefficients: [f64; 10],
    std_errors: [f64; 10],
    n_predictors: i64,
    n_obs: i64,
    residual_scale: f64,       // Robust scale (MAD-based)
    weights: [f64; 100],       // IRLS weights (low for outliers)
    n_outliers: i64,           // Observations with weight < 0.01
    n_iterations: i64,
    converged: bool,
    breakdown_point: f64       // Fraction of contamination tolerable
}



struct RobustDiagnostics {
    outlier_fraction: f64,
    scale_estimate: f64,    // MAD
    efficiency: f64,         // Asymptotic efficiency relative to OLS
    convergence_conf: RobustBetaConfidence,
    outlier_impact_conf: RobustBetaConfidence
}

// Method IDs: 1 = Huber, 2 = TukeyBisquare
struct RobustProvenance {
    method_id: i64,
    tuning_constant: f64,
    n_obs: i64,
    n_outliers: i64,
    n_iterations: i64,
    diagnostics: RobustDiagnostics
}

struct KnowledgeRobust {
    value: RobustModel,
    variance: f64,
    confidence: RobustBetaConfidence,
    provenance: RobustProvenance
}

// =============================================================================
// Robust Scale Estimation: MAD (Median Absolute Deviation)
// =============================================================================

fn median(data: [f64; 100], n: i64) -> f64 with Mut, Div, Panic {
    // Copy and sort
    var sorted: [f64; 100] = [0.0; 100]
    var i: i64 = 0
    while i < n {
        sorted[i as usize] = data[i as usize]
        i = i + 1
    }

    // Bubble sort (small n)
    i = 0
    while i < n - 1 {
        var j: i64 = 0
        while j < n - i - 1 {
            if sorted[j as usize] > sorted[(j + 1) as usize] {
                let temp = sorted[j as usize]
                sorted[j as usize] = sorted[(j + 1) as usize]
                sorted[(j + 1) as usize] = temp
            }
            j = j + 1
        }
        i = i + 1
    }

    if n % 2 == 1 {
        sorted[(n / 2) as usize]
    } else {
        (sorted[(n / 2 - 1) as usize] + sorted[(n / 2) as usize]) / 2.0
    }
}

fn mad(data: [f64; 100], n: i64) -> f64 with Mut, Div, Panic {
    // MAD = median(|xᵢ - median(x)|) * 1.4826
    // Factor 1.4826 makes MAD consistent estimator for σ at normal

    let med = median(data, n)

    var abs_dev: [f64; 100] = [0.0; 100]
    var i: i64 = 0
    while i < n {
        abs_dev[i as usize] = rob_abs(data[i as usize] - med)
        i = i + 1
    }

    let mad_raw = median(abs_dev, n)
    mad_raw * 1.4826
}

// =============================================================================
// Influence Functions (ψ)
// =============================================================================

// Huber ψ: ψ(r) = max(-k, min(k, r))
fn huber_psi(r: f64, k: f64) -> f64 {
    rob_max(-k, rob_min(k, r))
}

// Huber weight: w(r) = min(1, k/|r|)
fn huber_weight(r: f64, k: f64) -> f64 with Div, Panic {
    let abs_r = rob_abs(r)
    if abs_r < 1.0e-10 { return 1.0 }
    rob_min(1.0, k / abs_r)
}

// Tukey bisquare ψ: ψ(r) = r(1 - (r/c)²)² if |r| ≤ c, else 0
fn tukey_psi(r: f64, c: f64) -> f64 {
    if rob_abs(r) > c { return 0.0 }
    let u = r / c
    r * (1.0 - u * u) * (1.0 - u * u)
}

// Tukey bisquare weight: w(r) = (1 - (r/c)²)² if |r| ≤ c, else 0
fn tukey_weight(r: f64, c: f64) -> f64 {
    if rob_abs(r) > c { return 0.0 }
    let u = r / c
    (1.0 - u * u) * (1.0 - u * u)
}

// =============================================================================
// IRLS for Robust Regression
// =============================================================================

fn rob_mean_arr(data: [f64; 100], n: i64) -> f64 with Mut, Div, Panic {
    var sum = 0.0
    var i: i64 = 0
    while i < n { sum = sum + data[i as usize]; i = i + 1 }
    sum / (n as f64)
}

fn fit_robust_simple(
    x: [f64; 100],
    y: [f64; 100],
    n: i64,
    method: i64,       // 1 = huber, 2 = tukey
    tuning: f64        // k=1.345 for Huber, c=4.685 for Tukey
) -> RobustModel with Mut, Div, Panic {
    let max_iter = 50
    let tol = 1.0e-6

    // Initial OLS fit
    let x_mean = rob_mean_arr(x, n)
    let y_mean = rob_mean_arr(y, n)

    var cov = 0.0
    var var_x = 0.0
    var i: i64 = 0
    while i < n {
        let dx = x[i as usize] - x_mean
        let dy = y[i as usize] - y_mean
        cov = cov + dx * dy
        var_x = var_x + dx * dx
        i = i + 1
    }

    var beta1 = if var_x > 1.0e-10 { cov / var_x } else { 0.0 }
    var beta0 = y_mean - beta1 * x_mean

    var weights: [f64; 100] = [1.0; 100]
    var residuals: [f64; 100] = [0.0; 100]

    // IRLS iterations
    var converged = false
    var iter: i64 = 0

    while iter < max_iter {
        // Compute residuals
        i = 0
        while i < n {
            residuals[i as usize] = y[i as usize] - beta0 - beta1 * x[i as usize]
            i = i + 1
        }

        // Robust scale estimate (MAD of residuals)
        let scale = rob_max(mad(residuals, n), 1.0e-10)

        // Compute weights based on standardized residuals
        i = 0
        while i < n {
            let r_std = residuals[i as usize] / scale
            if method == 1 {
                weights[i as usize] = huber_weight(r_std, tuning)
            } else {
                weights[i as usize] = tukey_weight(r_std, tuning)
            }
            i = i + 1
        }

        // Weighted least squares
        var sum_w = 0.0
        var sum_wx = 0.0
        var sum_wy = 0.0
        var sum_wxx = 0.0
        var sum_wxy = 0.0

        i = 0
        while i < n {
            let w = weights[i as usize]
            let xi = x[i as usize]
            let yi = y[i as usize]
            sum_w = sum_w + w
            sum_wx = sum_wx + w * xi
            sum_wy = sum_wy + w * yi
            sum_wxx = sum_wxx + w * xi * xi
            sum_wxy = sum_wxy + w * xi * yi
            i = i + 1
        }

        let det = sum_w * sum_wxx - sum_wx * sum_wx
        if rob_abs(det) < 1.0e-10 { break }

        let new_beta0 = (sum_wxx * sum_wy - sum_wx * sum_wxy) / det
        let new_beta1 = (sum_w * sum_wxy - sum_wx * sum_wy) / det

        // Convergence check
        let delta0 = rob_abs(new_beta0 - beta0)
        let delta1 = rob_abs(new_beta1 - beta1)

        beta0 = new_beta0
        beta1 = new_beta1

        if delta0 < tol && delta1 < tol {
            converged = true
            break
        }

        iter = iter + 1
    }

    // Final residuals and scale
    i = 0
    while i < n {
        residuals[i as usize] = y[i as usize] - beta0 - beta1 * x[i as usize]
        i = i + 1
    }
    let final_scale = mad(residuals, n)
    // Weights must correspond to the returned coefficients and final scale.
    i=0
    while i<n {
        if final_scale>0.0 && is_finite(final_scale) {
            let standardized=residuals[i as usize]/final_scale
            weights[i as usize]=if method==1 {huber_weight(standardized,tuning)} else {tukey_weight(standardized,tuning)}
        } else {
            weights[i as usize]=if residuals[i as usize]==0.0 {1.0} else {0.0}
            if residuals[i as usize]!=0.0 {converged=false}
        }
        i=i+1
    }

    // Count outliers (weight < 0.01)
    var n_outliers: i64 = 0
    i = 0
    while i < n {
        if weights[i as usize] < 0.01 { n_outliers = n_outliers + 1 }
        i = i + 1
    }

    // SE from weighted regression
    var sum_w = 0.0
    var sum_wxx = 0.0
    var sum_wx = 0.0
    i = 0
    while i < n {
        let w = weights[i as usize]
        sum_w = sum_w + w
        sum_wx = sum_wx + w * x[i as usize]
        sum_wxx = sum_wxx + w * x[i as usize] * x[i as usize]
        i = i + 1
    }
    let det = sum_w * sum_wxx - sum_wx * sum_wx
    let se_beta0 = if rob_abs(det) > 1.0e-10 {
        rob_sqrt(final_scale * final_scale * sum_wxx / det)
    } else { 0.0 }
    let se_beta1 = if rob_abs(det) > 1.0e-10 {
        rob_sqrt(final_scale * final_scale * sum_w / det)
    } else { 0.0 }

    // Breakdown point
    let breakdown = -1.0 // unavailable: method selection alone proves no breakdown guarantee

    var coefficients: [f64; 10] = [0.0; 10]
    coefficients[0] = beta0
    coefficients[1] = beta1

    var std_errors: [f64; 10] = [0.0; 10]
    // No calibrated M-estimator covariance is supplied by this legacy fit.
    // The checked migration API also keeps inference explicitly unavailable.
    std_errors[0] = 0.0
    std_errors[1] = 0.0

    RobustModel {
        inference_status:1,
        coefficients: coefficients,
        std_errors: std_errors,
        n_predictors: 1,
        n_obs: n,
        residual_scale: final_scale,
        weights: weights,
        n_outliers: n_outliers,
        n_iterations: iter,
        converged: converged,
        breakdown_point: breakdown
    }
}

// =============================================================================
// Epistemic Robust Regression
// =============================================================================

fn fit_huber_epistemic(
    x: [f64; 100],
    y: [f64; 100],
    n: i64
) -> KnowledgeRobust with Mut, Div, Panic {
    // Huber with k = 1.345 (95% efficiency at normal)
    fit_robust_epistemic(x, y, n, 1, 1.345)
}

fn fit_tukey_epistemic(
    x: [f64; 100],
    y: [f64; 100],
    n: i64
) -> KnowledgeRobust with Mut, Div, Panic {
    // Tukey bisquare with c = 4.685 (95% efficiency at normal)
    fit_robust_epistemic(x, y, n, 2, 4.685)
}

fn fit_robust_epistemic(
    x: [f64; 100],
    y: [f64; 100],
    n: i64,
    method: i64,
    tuning: f64
) -> KnowledgeRobust with Mut, Div, Panic {
    let model = fit_robust_simple(x, y, n, method, tuning)

    // Compute diagnostics
    let outlier_frac = (model.n_outliers as f64) / (n as f64)
    let efficiency = if method == 1 { 0.95 } else { 0.95 }

    // Confidence: higher if few outliers, converged, enough data
    let conv_conf = if model.converged { 0.90 } else { 0.50 }
    let conv_beta = rob_beta_new(conv_conf * (n as f64) * 0.3, (1.0 - conv_conf) * (n as f64) * 0.3)

    let outlier_conf = if outlier_frac < 0.10 { 0.90 }
                       else if outlier_frac < 0.20 { 0.75 }
                       else if outlier_frac < 0.30 { 0.60 }
                       else { 0.40 }
    let outlier_beta = rob_beta_new(outlier_conf * (n as f64) * 0.3, (1.0 - outlier_conf) * (n as f64) * 0.3)

    let overall_conf = rob_beta_combine(&conv_beta, &outlier_beta)

    let diag = RobustDiagnostics {
        outlier_fraction: outlier_frac,
        scale_estimate: model.residual_scale,
        efficiency: efficiency,
        convergence_conf: conv_beta,
        outlier_impact_conf: outlier_beta
    }

    let prov = RobustProvenance {
        method_id: method,
        tuning_constant: tuning,
        n_obs: n,
        n_outliers: model.n_outliers,
        n_iterations: model.n_iterations,
        diagnostics: diag
    }

    KnowledgeRobust {
        value: model,
        variance: model.std_errors[1] * model.std_errors[1],
        confidence: overall_conf,
        provenance: prov
    }
}

// =============================================================================
// Tests
// =============================================================================

fn test_huber_with_outliers() -> bool with Mut, Div, Panic {
    // y = 2 + 3x with outliers
    var x: [f64; 100] = [0.0; 100]
    var y: [f64; 100] = [0.0; 100]

    // Clean data: y = 2 + 3x
    x[0] = 0.0;  y[0] = 2.0
    x[1] = 1.0;  y[1] = 5.0
    x[2] = 2.0;  y[2] = 8.0
    x[3] = 3.0;  y[3] = 11.0
    x[4] = 4.0;  y[4] = 14.0
    x[5] = 5.0;  y[5] = 17.0
    x[6] = 6.0;  y[6] = 20.0
    x[7] = 7.0;  y[7] = 23.0

    // Outliers
    x[8] = 3.0;  y[8] = 50.0   // Outlier!
    x[9] = 5.0;  y[9] = -10.0  // Outlier!

    let result = fit_huber_epistemic(x, y, 10)

    // Slope should be close to 3.0 despite outliers
    let slope = result.value.coefficients[1]
    let slope_ok = rob_abs(slope - 3.0) < 1.5  // Within 1.5 of true slope

    // Should detect outliers
    let outliers_detected = result.value.n_outliers > 0

    slope_ok && outliers_detected
}

fn test_tukey_with_outliers() -> bool with Mut, Div, Panic {
    var x: [f64; 100] = [0.0; 100]
    var y: [f64; 100] = [0.0; 100]

    x[0] = 0.0;  y[0] = 2.0
    x[1] = 1.0;  y[1] = 5.0
    x[2] = 2.0;  y[2] = 8.0
    x[3] = 3.0;  y[3] = 11.0
    x[4] = 4.0;  y[4] = 14.0
    x[5] = 5.0;  y[5] = 17.0
    x[6] = 6.0;  y[6] = 20.0
    x[7] = 7.0;  y[7] = 23.0
    x[8] = 3.0;  y[8] = 50.0
    x[9] = 5.0;  y[9] = -10.0

    let result = fit_tukey_epistemic(x, y, 10)

    // Tukey bisquare should be even more resistant
    let slope = result.value.coefficients[1]
    let slope_ok = rob_abs(slope - 3.0) < 1.5

    // Tukey gives zero weight to extreme outliers
    let outliers_zero_weight = result.value.n_outliers >= 2

    slope_ok && outliers_zero_weight
}

fn test_mad() -> bool with Mut, Div, Panic {
    var data: [f64; 100] = [0.0; 100]
    data[0] = 1.0
    data[1] = 2.0
    data[2] = 3.0
    data[3] = 4.0
    data[4] = 5.0

    let m = mad(data, 5)

    // MAD of {1,2,3,4,5}: deviations from median (3) = {2,1,0,1,2}
    // Median of deviations = 1
    // MAD = 1.4826 * 1 ≈ 1.4826
    rob_abs(m - 1.4826) < 0.01
}


// Checked bounded M-estimator migration layer. Design row stride8.
// Point fitting only. No breakdown guarantee or calibrated inference is inferred.
pub struct RobustFitChecked {
 pub status:i64, pub n:i64, pub p:i64, pub rank:i64, pub iterations:i64,
 pub method:i64, pub active_rows:i64, pub coefficients:[f64;8],
 pub fitted:[f64;256], pub residuals:[f64;256], pub weights:[f64;256],
 pub residual_scale:f64, pub objective:f64, pub score_norm:f64, pub step_norm:f64,
 pub rcond_used:f64, pub inference_status:i64, pub assumptions_assessed:bool,
}
struct RobustEvaluation {
 status:i64, fitted:[f64;256], residuals:[f64;256], weights:[f64;256],
 scale:f64, objective:f64, exact_fit:bool,
}
fn rc_empty(status:i64,n:i64,p:i64,method:i64)->RobustFitChecked {
 RobustFitChecked{status:status,n:n,p:p,rank:0,iterations:0,method:method,
 active_rows:0,coefficients:[0.0;8],fitted:[0.0;256],residuals:[0.0;256],
 weights:[0.0;256],residual_scale:0.0,objective:0.0,score_norm:0.0,step_norm:0.0,
 rcond_used:0.0,inference_status:1,assumptions_assessed:false}
}
fn rc_dot(a:&[f64;2048],beta:&[f64;8],row:i64,p:i64)->f64 with Mut,Div,Panic {
 var sum:f64=0.0
 var correction:f64=0.0
 var j:i64=0
 while j<p {
  let term=a[(row*8+j) as usize]*beta[j as usize]
  let adjusted=term-correction
  let next=sum+adjusted
  correction=(next-sum)-adjusted
  sum=next
  j=j+1
 }
 sum
}
fn rc_median(sorted:&[f64;256],n:i64)->f64 with Div,Panic {
 if n%2==1 {return sorted[(n/2) as usize]}
 sorted[(n/2-1) as usize]*0.5+sorted[(n/2) as usize]*0.5
}
fn rc_weight(r:f64,method:i64,tuning:f64)->f64 with Div {
 let magnitude=rob_abs(r)
 if method==1 {
  if magnitude<=tuning {return 1.0}
  return tuning/magnitude
 }
 if magnitude>=tuning {return 0.0}
 let u=r/tuning
 let remainder=(1.0-u)*(1.0+u)
 remainder*remainder
}
fn rc_rho(r:f64,method:i64,tuning:f64)->f64 with Div {
 let magnitude=rob_abs(r)
 if method==1 {
  if magnitude<=tuning {return (r*0.5)*r}
  return tuning*(magnitude-0.5*tuning)
 }
 if magnitude>=tuning {return (tuning*tuning)/6.0}
 let u=r/tuning
 let square=u*u
 // 1-(1-u²)^3 factored to retain small residual contributions.
 (r*r)*(0.5-square*0.5+square*square/6.0)
}
fn rc_evaluate(a:&[f64;2048],b:&[f64;256],beta:&[f64;8],
 n:i64,p:i64,method:i64,tuning:f64,fixed_scale:f64)->RobustEvaluation with Mut,Div,Panic {
 var out=RobustEvaluation{status:4,fitted:[0.0;256],residuals:[0.0;256],
 weights:[0.0;256],scale:0.0,objective:0.0,exact_fit:true}
 var sorted:[f64;256]=[0.0;256]
 var i:i64=0
 while i<n {
  let fitted=rc_dot(a,beta,i,p)
  let residual=b[i as usize]-fitted
  if !is_finite(fitted) || !is_finite(residual) {return out}
  out.fitted[i as usize]=fitted
  out.residuals[i as usize]=residual
  sorted[i as usize]=residual
  if residual!=0.0 {out.exact_fit=false}
  i=i+1
 }
 if out.exact_fit {
  i=0
  while i<n {out.weights[i as usize]=1.0 i=i+1}
  out.status=0
  return out
 }
 var scale=fixed_scale
 if scale==0.0 {
  if !sort256(&!sorted,n) {return out}
  let center=rc_median(&sorted,n)
  i=0
  while i<n {
   let deviation=rob_abs(out.residuals[i as usize]-center)
   if !is_finite(deviation) {return out}
   sorted[i as usize]=deviation
   i=i+1
  }
  if !sort256(&!sorted,n) {return out}
  scale=rc_median(&sorted,n)*1.482602218505602
 }
 // Nonzero residuals with zero MAD have no declared fallback scale.
 if !is_finite(scale) || scale<=0.0 {out.status=8 return out}
 out.scale=scale
 var correction:f64=0.0
 i=0
 while i<n {
  let r=out.residuals[i as usize]/scale
  if !is_finite(r) {return out}
  let weight=rc_weight(r,method,tuning)
  let loss=rc_rho(r,method,tuning)
  if !is_finite(weight) || weight<0.0 || weight>1.0 || !is_finite(loss) || loss<0.0 {return out}
  out.weights[i as usize]=weight
  let adjusted=loss-correction
  let next=out.objective+adjusted
  correction=(next-out.objective)-adjusted
  out.objective=next
  i=i+1
 }
 if !is_finite(out.objective) {return out}
 out.status=0
 out
}
// status0 point fit;1 size;2 nonfinite;3 effective rank;4 arithmetic;
// 5 controls (method1Huber/2Tukey,tuning0.1..10);7 no convergence;
// 8 zero/unrepresentable MAD for nonzero residuals. OLS initialization.
// Tukey is a local redescending fit, not a global optimum/breakdown certificate.
pub fn robust_fit_checked(a:&[f64;2048],b:&[f64;256],n:i64,p:i64,
 method:i64,tuning:f64,rcond:f64,max_iterations:i64,tolerance:f64)->RobustFitChecked with Mut,Div,Panic {
 if n<1 || n>256 || p<1 || p>8 || p>n {return rc_empty(1,n,p,method)}
 if method<1 || method>2 || !is_finite(tuning) || tuning<0.1 || tuning>10.0 ||
 !is_finite(rcond) || rcond<0.0 || rcond>=1.0 || max_iterations<1 ||
 max_iterations>100 || !is_finite(tolerance) || tolerance<1e-12 || tolerance>1e-4 {
  return rc_empty(5,n,p,method)
 }
 let initial=qr_least_squares(a,b,n,p,rcond)
 if initial.status!=0 {
  var bad=rc_empty(if initial.status==2 {2} else if initial.status==3 {3} else {4},n,p,method)
  bad.rank=initial.rank
  return bad
 }
 var scales:[f64;8]=[0.0;8]
 var j:i64=0
 while j<p {
  var i:i64=0
  while i<n {
   let magnitude=rob_abs(a[(i*8+j) as usize])
   if magnitude>scales[j as usize] {scales[j as usize]=magnitude}
   i=i+1
  }
  j=j+1
 }
 var beta=initial.coefficients
 var iteration:i64=0
 while iteration<max_iterations {
  let current=rc_evaluate(a,b,&beta,n,p,method,tuning,0.0)
  if current.status!=0 {return rc_empty(current.status,n,p,method)}
  var active:i64=0
  var compact_a:[f64;2048]=[0.0;2048]
  var compact_b:[f64;256]=[0.0;256]
  var compact_w:[f64;256]=[0.0;256]
  var i:i64=0
  while i<n {
   if current.weights[i as usize]>0.0 {
    j=0
    while j<p {
     compact_a[(active*8+j) as usize]=a[(i*8+j) as usize]
     j=j+1
    }
    compact_b[active as usize]=current.residuals[i as usize]
    compact_w[active as usize]=current.weights[i as usize]
    active=active+1
   }
   i=i+1
  }
  if active<p {return rc_empty(3,n,p,method)}
  let increment=weighted_qr_least_squares(&compact_a,&compact_b,&compact_w,active,p,rcond)
  if increment.status!=0 {return rc_empty(if increment.status==3 {3}else{4},n,p,method)}
  var score:f64=0.0
  if !current.exact_fit {
   j=0
   while j<p {
    var sum:f64=0.0
    var correction:f64=0.0
    i=0
    while i<n {
     let standardized=current.residuals[i as usize]/current.scale
     let psi=standardized*current.weights[i as usize]
     let term=(a[(i*8+j) as usize]/scales[j as usize])*psi/(n as f64)
     let adjusted=term-correction
     let next=sum+adjusted
     correction=(next-sum)-adjusted
     sum=next
     i=i+1
    }
    if !is_finite(sum) {return rc_empty(4,n,p,method)}
    if rob_abs(sum)>score {score=rob_abs(sum)}
    j=j+1
   }
  }
  var full_step:f64=0.0
  i=0
  while i<n {
   let movement=rc_dot(a,&increment.coefficients,i,p)
   var denominator=current.scale+rob_abs(current.fitted[i as usize])
   if current.exact_fit {denominator=1.0+rob_abs(current.fitted[i as usize])}
   if !is_finite(denominator) || denominator<=0.0 {return rc_empty(4,n,p,method)}
   let step=rob_abs(movement)/denominator
   if !is_finite(step) {return rc_empty(4,n,p,method)}
   if step>full_step {full_step=step}
   i=i+1
  }
  iteration=iteration+1
  if current.exact_fit || (score<=tolerance && full_step<=tolerance) {
   var out=rc_empty(0,n,p,method)
   out.rank=p
   out.active_rows=active
   out.iterations=iteration
   out.coefficients=beta
   out.fitted=current.fitted
   out.residuals=current.residuals
   out.weights=current.weights
   out.residual_scale=current.scale
   out.objective=current.objective
   out.score_norm=score
   out.step_norm=full_step
   out.rcond_used=increment.rcond_used
   return out
  }
  var accepted=false
  var fraction:f64=1.0
  var halvings:i64=0
  while halvings<=32 && !accepted {
   var trial_beta:[f64;8]=[0.0;8]
   j=0
   while j<p {
    trial_beta[j as usize]=beta[j as usize]+fraction*increment.coefficients[j as usize]
    j=j+1
   }
   let trial=rc_evaluate(a,b,&trial_beta,n,p,method,tuning,current.scale)
   if trial.status==0 && trial.objective<=current.objective {
    beta=trial_beta
    accepted=true
   } else {fraction=fraction*0.5}
   halvings=halvings+1
  }
  if !accepted {
   var bad=rc_empty(7,n,p,method)
   bad.iterations=iteration
   return bad
  }
 }
 var exhausted=rc_empty(7,n,p,method)
 exhausted.iterations=iteration
 exhausted
}
