// stats::regression::logistic — Epistemic Logistic Regression
//
// Generalized linear model for binary outcomes with:
// - Maximum likelihood estimation via IRLS
// - Odds ratios as Knowledge<f64> with confidence
// - Dose-response modeling (ED50, ED90)
// - ROC/AUC curve analysis
// - Hosmer-Lemeshow goodness-of-fit
//
// Returns Knowledge<LogisticModel> with full diagnostics
//
// References:
// - Cox (1958): "The regression analysis of binary sequences"
// - Hosmer & Lemeshow (2000): "Applied Logistic Regression"
// - McCullagh & Nelder (1989): "Generalized Linear Models"

// =============================================================================
// Math Helpers (self-contained, following medical/ pattern)
// =============================================================================

struct BetaConfidence {
    alpha: f64,
    beta: f64
}

fn beta_new(a: f64, b: f64) -> BetaConfidence { BetaConfidence { alpha: a, beta: b } }
fn beta_mean(b: &BetaConfidence) -> f64 { b.alpha / (b.alpha + b.beta) }
fn beta_combine(b1: &BetaConfidence, b2: &BetaConfidence) -> BetaConfidence {
    BetaConfidence { alpha: b1.alpha + b2.alpha - 1.0, beta: b1.beta + b2.beta - 1.0 }
}

fn logit_abs(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn logit_sqrt(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 25 { y = 0.5 * (y + x / y); i = i + 1 }
    y
}

fn logit_ln(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 - 1.0e30 }
    var m = x
    var e = 0
    while m >= 2.0 { m = m / 2.0; e = e + 1 }
    while m < 0.5 { m = m * 2.0; e = e - 1 }
    let t = (m - 1.0) / (m + 1.0)
    let t2 = t * t
    var sum = t
    var term = t
    var k = 1
    while k < 30 {
        term = term * t2
        sum = sum + term / (2 * k + 1) as f64
        k = k + 1
    }
    2.0 * sum + (e as f64) * 0.6931471805599453
}

fn logit_exp(x: f64) -> f64 with Mut, Div, Panic {
    if x > 500.0 { return 1.0e200 }
    if x < -500.0 { return 0.0 }
    let ln2 = 0.6931471805599453
    var k_f = x / ln2
    var k: i32 = 0
    if k_f >= 0.0 { k = k_f as i32 } else { k = (k_f as i32) - 1 }
    let r = x - (k as f64) * ln2
    var sum = 1.0
    var term = 1.0
    var n = 1
    while n < 25 { term = term * r / (n as f64); sum = sum + term; n = n + 1 }
    var result = sum
    if k >= 0 {
        var i = 0
        while i < k { result = result * 2.0; i = i + 1 }
    } else {
        var i = 0
        while i < (0 - k) { result = result / 2.0; i = i + 1 }
    }
    result
}

fn logit_min(a: f64, b: f64) -> f64 { if a < b { a } else { b } }
fn logit_max(a: f64, b: f64) -> f64 { if a > b { a } else { b } }

// =============================================================================
// Link Functions
// =============================================================================

// Logistic (sigmoid) function: p = 1 / (1 + exp(-z))
fn sigmoid(z: f64) -> f64 with Mut, Div, Panic {
    if z > 20.0 { return 1.0 - 1.0e-10 }
    if z < -20.0 { return 1.0e-10 }
    1.0 / (1.0 + logit_exp(0.0 - z))
}

// Logit (inverse sigmoid): z = ln(p / (1 - p))
fn logit(p: f64) -> f64 with Mut, Div, Panic {
    let clipped = logit_max(1.0e-10, logit_min(1.0 - 1.0e-10, p))
    logit_ln(clipped / (1.0 - clipped))
}

// =============================================================================
// Core Types
// =============================================================================

struct LogisticModel {
    beta: [f64; 10],          // Coefficients (β₀ = intercept)
    se: [f64; 10],            // Standard errors
    z_scores: [f64; 10],       // Wald z-scores (β/SE)
    p_values: [f64; 10],       // Two-tailed p-values
    odds_ratios: [f64; 10],    // exp(β) for each predictor
    or_ci_lower: [f64; 10],    // 95% CI lower for OR
    or_ci_upper: [f64; 10],    // 95% CI upper for OR
    n_predictors: i64,
    n_obs: i64,
    n_events: i64,             // Number of y=1
    log_likelihood: f64,
    aic: f64,
    bic: f64,
    deviance: f64,
    null_deviance: f64,
    pseudo_r_squared: f64,     // McFadden's R²
    converged: bool,
    iterations: i64
}



// Diagnostics
struct LogisticDiagnostics {
    hosmer_lemeshow_stat: f64,  // Goodness-of-fit
    hosmer_lemeshow_p: f64,
    auc: f64,                    // Area under ROC curve
    concordance: f64,            // C-statistic
    separation_adequate: BetaConfidence,
    sample_events_adequate: BetaConfidence
}

// Provenance
struct LogisticProvenance {
    method: String,  // "IRLS_MLE"
    n_obs: i64,
    n_events: i64,
    n_predictors: i64,
    iterations: i64,
    converged: bool,
    diagnostics: LogisticDiagnostics
}

// Knowledge wrapper
struct KnowledgeLogistic {
    value: LogisticModel,
    variance: f64,
    confidence: BetaConfidence,
    provenance: LogisticProvenance
}

// =============================================================================
// Dose-Response Types
// =============================================================================

struct DoseResponseResult {
    ed50: f64,        // Dose producing 50% effect
    ed90: f64,        // Dose producing 90% effect
    ed50_ci_lower: f64,
    ed50_ci_upper: f64,
    slope: f64,        // Hill slope at ED50
    max_effect: f64
}

struct KnowledgeDoseResponse {
    value: DoseResponseResult,
    variance: f64,
    confidence: BetaConfidence
}

// =============================================================================
// Simple Linear Regression (used internally)
// =============================================================================

fn mean_arr(data: [f64; 100], n: i64) -> f64 with Mut, Div {
    var sum = 0.0
    var i: i64 = 0
    while i < n { sum = sum + data[i as usize]; i = i + 1 }
    sum / (n as f64)
}

// =============================================================================
// IRLS (Iteratively Reweighted Least Squares)
// =============================================================================

// Simple logistic regression: logit(p) = β₀ + β₁x
fn fit_logistic_simple(
    x: [f64; 100],
    y: [f64; 100],   // Binary: 0 or 1
    n: i64
) -> LogisticModel with Mut, Div, Panic {
    let max_iter = 25
    let tol = 1.0e-8

    // Count events
    var n_events: i64 = 0
    var i: i64 = 0
    while i < n {
        if y[i as usize] > 0.5 { n_events = n_events + 1 }
        i = i + 1
    }

    // Initialize β₀ = logit(p_bar), β₁ = 0
    let p_bar = (n_events as f64) / (n as f64)
    var beta0 = logit(p_bar)
    var beta1 = 0.0

    // Null log-likelihood (for pseudo-R²)
    var null_ll = 0.0
    i = 0
    while i < n {
        let yi = y[i as usize]
        if yi > 0.5 {
            null_ll = null_ll + logit_ln(p_bar)
        } else {
            null_ll = null_ll + logit_ln(1.0 - p_bar)
        }
        i = i + 1
    }

    // IRLS iterations
    var converged = false
    var iter: i64 = 0

    while iter < max_iter {
        // E-step: compute predicted probabilities
        var sum_w = 0.0
        var sum_wx = 0.0
        var sum_wxx = 0.0
        var sum_wz = 0.0
        var sum_wxz = 0.0

        i = 0
        while i < n {
            let xi = x[i as usize]
            let yi = y[i as usize]

            // Linear predictor
            let eta = beta0 + beta1 * xi

            // Predicted probability
            let pi = sigmoid(eta)

            // Weight: w = p(1-p)
            let w = pi * (1.0 - pi)
            if w < 1.0e-10 { i = i + 1; continue }

            // Working response: z = eta + (y - p) / w_raw
            let z = eta + (yi - pi) / w

            // Accumulate weighted normal equations
            sum_w = sum_w + w
            sum_wx = sum_wx + w * xi
            sum_wxx = sum_wxx + w * xi * xi
            sum_wz = sum_wz + w * z
            sum_wxz = sum_wxz + w * xi * z

            i = i + 1
        }

        // Solve 2x2 weighted normal equations
        let det = sum_w * sum_wxx - sum_wx * sum_wx
        if logit_abs(det) < 1.0e-10 { break }

        let new_beta0 = (sum_wxx * sum_wz - sum_wx * sum_wxz) / det
        let new_beta1 = (sum_w * sum_wxz - sum_wx * sum_wz) / det

        // Check convergence
        let delta0 = logit_abs(new_beta0 - beta0)
        let delta1 = logit_abs(new_beta1 - beta1)

        beta0 = new_beta0
        beta1 = new_beta1

        if delta0 < tol && delta1 < tol {
            converged = true
            break
        }

        iter = iter + 1
    }

    // Compute final statistics
    var log_lik = 0.0
    var deviance = 0.0
    i = 0
    while i < n {
        let xi = x[i as usize]
        let yi = y[i as usize]
        let eta = beta0 + beta1 * xi
        let pi = sigmoid(eta)

        // Log-likelihood: Σ[y·ln(p) + (1-y)·ln(1-p)]
        if yi > 0.5 {
            log_lik = log_lik + logit_ln(logit_max(pi, 1.0e-10))
        } else {
            log_lik = log_lik + logit_ln(logit_max(1.0 - pi, 1.0e-10))
        }

        i = i + 1
    }

    deviance = -2.0 * log_lik
    let null_deviance = -2.0 * null_ll

    // AIC = -2LL + 2k, BIC = -2LL + k·ln(n)
    let k = 2.0  // Number of parameters
    let aic = deviance + 2.0 * k
    let bic = deviance + k * logit_ln(n as f64)

    // McFadden's pseudo-R²
    let pseudo_r2 = 1.0 - log_lik / null_ll

    // Standard errors from Fisher Information (last IRLS weights)
    var sum_w = 0.0
    var sum_wx = 0.0
    var sum_wxx = 0.0
    i = 0
    while i < n {
        let xi = x[i as usize]
        let eta = beta0 + beta1 * xi
        let pi = sigmoid(eta)
        let w = pi * (1.0 - pi)
        sum_w = sum_w + w
        sum_wx = sum_wx + w * xi
        sum_wxx = sum_wxx + w * xi * xi
        i = i + 1
    }

    let det = sum_w * sum_wxx - sum_wx * sum_wx
    let se_beta0 = if logit_abs(det) > 1.0e-10 {
        logit_sqrt(sum_wxx / det)
    } else { 0.0 }
    let se_beta1 = if logit_abs(det) > 1.0e-10 {
        logit_sqrt(sum_w / det)
    } else { 0.0 }

    // Wald z-scores
    let z0 = if se_beta0 > 1.0e-10 { beta0 / se_beta0 } else { 0.0 }
    let z1 = if se_beta1 > 1.0e-10 { beta1 / se_beta1 } else { 0.0 }

    // Approximate p-values (normal)
    let p0 = 2.0 * (1.0 - sigmoid(logit_abs(z0)))
    let p1 = 2.0 * (1.0 - sigmoid(logit_abs(z1)))

    // Odds ratios: exp(β)
    let or0 = logit_exp(beta0)
    let or1 = logit_exp(beta1)

    // 95% CI for OR: exp(β ± 1.96·SE)
    let or1_lower = logit_exp(beta1 - 1.96 * se_beta1)
    let or1_upper = logit_exp(beta1 + 1.96 * se_beta1)

    // Construct result
    var betas: [f64; 10] = [0.0; 10]
    betas[0] = beta0
    betas[1] = beta1

    var ses: [f64; 10] = [0.0; 10]
    ses[0] = se_beta0
    ses[1] = se_beta1

    var zs: [f64; 10] = [0.0; 10]
    zs[0] = z0
    zs[1] = z1

    var ps: [f64; 10] = [0.0; 10]
    ps[0] = p0
    ps[1] = p1

    var ors: [f64; 10] = [0.0; 10]
    ors[0] = or0
    ors[1] = or1

    var or_lo: [f64; 10] = [0.0; 10]
    or_lo[1] = or1_lower

    var or_hi: [f64; 10] = [0.0; 10]
    or_hi[1] = or1_upper

    LogisticModel {
        beta: betas,
        se: ses,
        z_scores: zs,
        p_values: ps,
        odds_ratios: ors,
        or_ci_lower: or_lo,
        or_ci_upper: or_hi,
        n_predictors: 1,
        n_obs: n,
        n_events: n_events,
        log_likelihood: log_lik,
        aic: aic,
        bic: bic,
        deviance: deviance,
        null_deviance: null_deviance,
        pseudo_r_squared: pseudo_r2,
        converged: converged,
        iterations: iter
    }
}

// =============================================================================
// ROC / AUC
// =============================================================================

fn compute_auc(
    x: [f64; 100],
    y: [f64; 100],
    n: i64,
    beta0: f64,
    beta1: f64
) -> f64 with Mut, Div, Panic {
    // Compute AUC via Mann-Whitney U statistic
    // AUC = P(score(positive) > score(negative))

    // Compute predicted probabilities
    var probs: [f64; 100] = [0.0; 100]
    var i: i64 = 0
    while i < n {
        probs[i as usize] = sigmoid(beta0 + beta1 * x[i as usize])
        i = i + 1
    }

    // Count concordant pairs
    var concordant: i64 = 0
    var discordant: i64 = 0
    var tied: i64 = 0

    i = 0
    while i < n {
        if y[i as usize] < 0.5 { i = i + 1; continue }  // Only positive cases

        var j: i64 = 0
        while j < n {
            if y[j as usize] > 0.5 { j = j + 1; continue }  // Only negative cases

            let pi = probs[i as usize]
            let pj = probs[j as usize]

            if pi > pj { concordant = concordant + 1 }
            else if pi < pj { discordant = discordant + 1 }
            else { tied = tied + 1 }

            j = j + 1
        }
        i = i + 1
    }

    let total = concordant + discordant + tied
    if total == 0 { return 0.5 }

    (concordant as f64 + 0.5 * (tied as f64)) / (total as f64)
}

// =============================================================================
// Epistemic Logistic Regression
// =============================================================================

fn fit_logistic_epistemic(
    x: [f64; 100],
    y: [f64; 100],
    n: i64
) -> KnowledgeLogistic with Mut, Div, Panic {
    let model = fit_logistic_simple(x, y, n)

    // AUC
    let auc = compute_auc(x, y, n, model.beta[0], model.beta[1])

    // Assumption checks
    // 1. Sufficient events (rule of thumb: 10 events per predictor)
    let events_per_pred = model.n_events / (model.n_predictors + 1)
    let event_conf = if events_per_pred >= 10 { 0.95 }
                     else if events_per_pred >= 5 { 0.75 }
                     else { 0.50 }
    let event_beta = beta_new(
        event_conf * (n as f64) * 0.3,
        (1.0 - event_conf) * (n as f64) * 0.3
    )

    // 2. Separation (complete separation → infinite β)
    let sep_conf = if model.converged { 0.90 } else { 0.40 }
    let sep_beta = beta_new(
        sep_conf * (n as f64) * 0.3,
        (1.0 - sep_conf) * (n as f64) * 0.3
    )

    // Hosmer-Lemeshow goodness-of-fit test
    // Bins observations into 10 equal-width probability groups [0,0.1), [0.1,0.2), ..., [0.9,1.0]
    // HL = Σ_g [(O1g - E1g)² / E1g + (O0g - E0g)² / E0g]
    // Under H₀ (good fit): HL ~ χ²(8)
    // Reference: Hosmer & Lemeshow (2000), "Applied Logistic Regression", Ch. 5
    var hl_stat = 0.0
    var g: i64 = 0
    while g < 10 {
        let lo = (g as f64) * 0.1
        let hi = if g == 9 { 1.0001 } else { lo + 0.1 }
        var obs1 = 0.0   // observed events in bin
        var exp1 = 0.0   // expected events in bin
        var ng = 0.0     // total observations in bin
        var j: i64 = 0
        while j < n {
            let p_j = 1.0 / (1.0 + logit_exp(0.0 - model.beta[0] - model.beta[1] * x[j as usize]))
            if p_j >= lo && p_j < hi {
                obs1 = obs1 + y[j as usize]
                exp1 = exp1 + p_j
                ng = ng + 1.0
            }
            j = j + 1
        }
        if ng > 0.0 && exp1 > 1.0e-8 && (ng - exp1) > 1.0e-8 {
            let obs0 = ng - obs1
            let exp0 = ng - exp1
            hl_stat = hl_stat + (obs1 - exp1) * (obs1 - exp1) / exp1
                    + (obs0 - exp0) * (obs0 - exp0) / exp0
        }
        g = g + 1
    }
    // p-value approximation for χ²(8): critical values 15.51 (p=0.05), 20.09 (p=0.01)
    let hl_p = if hl_stat > 20.09 { 0.01 }
               else if hl_stat > 15.51 { 0.05 }
               else if hl_stat > 13.36 { 0.10 }
               else { 0.50 }

    let diag = LogisticDiagnostics {
        hosmer_lemeshow_stat: hl_stat,
        hosmer_lemeshow_p: hl_p,
        auc: auc,
        concordance: auc,  // C-statistic = AUC for binary
        separation_adequate: sep_beta,
        sample_events_adequate: event_beta
    }

    let overall_conf = beta_combine(&event_beta, &sep_beta)

    let prov = LogisticProvenance {
        method: "IRLS_MLE",
        n_obs: n,
        n_events: model.n_events,
        n_predictors: model.n_predictors,
        iterations: model.iterations,
        converged: model.converged,
        diagnostics: diag
    }

    KnowledgeLogistic {
        value: model,
        variance: model.se[1] * model.se[1],  // Variance of slope
        confidence: overall_conf,
        provenance: prov
    }
}

// =============================================================================
// Dose-Response Modeling
// =============================================================================

fn fit_dose_response(
    doses: [f64; 100],
    responses: [f64; 100],  // Binary: 0 or 1
    n: i64
) -> KnowledgeDoseResponse with Mut, Div, Panic {
    // Fit logistic model: logit(P(response=1)) = β₀ + β₁·dose
    let model = fit_logistic_simple(doses, responses, n)

    let beta0 = model.beta[0]
    let beta1 = model.beta[1]

    // ED50: dose where P(response) = 0.5
    // logit(0.5) = 0 = β₀ + β₁·ED50
    // ED50 = -β₀/β₁
    let ed50 = if logit_abs(beta1) > 1.0e-10 {
        0.0 - beta0 / beta1
    } else { 0.0 }

    // ED90: dose where P(response) = 0.9
    // logit(0.9) = 2.197 = β₀ + β₁·ED90
    let logit_90 = logit_ln(0.9 / 0.1)
    let ed90 = if logit_abs(beta1) > 1.0e-10 {
        (logit_90 - beta0) / beta1
    } else { 0.0 }

    // CI for ED50 using delta method
    // Var(ED50) ≈ (1/β₁²)[Var(β₀) + ED50²·Var(β₁) + 2·ED50·Cov(β₀,β₁)]
    // Simplified (ignoring covariance):
    let se_beta0 = model.se[0]
    let se_beta1 = model.se[1]
    let var_ed50 = if logit_abs(beta1) > 1.0e-10 {
        (1.0 / (beta1 * beta1)) * (se_beta0 * se_beta0 + ed50 * ed50 * se_beta1 * se_beta1)
    } else { 0.0 }
    let se_ed50 = logit_sqrt(var_ed50)

    let ed50_lower = ed50 - 1.96 * se_ed50
    let ed50_upper = ed50 + 1.96 * se_ed50

    // Hill slope at ED50
    let slope = beta1 * 0.25  // p(1-p) = 0.25 at ED50

    let result = DoseResponseResult {
        ed50: ed50,
        ed90: ed90,
        ed50_ci_lower: ed50_lower,
        ed50_ci_upper: ed50_upper,
        slope: slope,
        max_effect: 1.0
    }

    // Confidence from model fit
    let auc = compute_auc(doses, responses, n, beta0, beta1)
    let conf_level = if auc > 0.80 { 0.90 }
                     else if auc > 0.70 { 0.70 }
                     else { 0.50 }

    KnowledgeDoseResponse {
        value: result,
        variance: var_ed50,
        confidence: beta_new(
            conf_level * (n as f64) * 0.3,
            (1.0 - conf_level) * (n as f64) * 0.3
        )
    }
}

// =============================================================================
// Tests
// =============================================================================

fn test_logistic_regression() -> bool with Mut, Div, Panic {
    // Dose-response data: higher dose → more response
    var x: [f64; 100] = [0.0; 100]
    var y: [f64; 100] = [0.0; 100]

    // Low doses: mostly 0
    x[0] = 1.0;  y[0] = 0.0
    x[1] = 2.0;  y[1] = 0.0
    x[2] = 3.0;  y[2] = 0.0
    x[3] = 4.0;  y[3] = 0.0
    // Medium doses: mixed
    x[4] = 5.0;  y[4] = 1.0
    x[5] = 6.0;  y[5] = 0.0
    x[6] = 7.0;  y[6] = 1.0
    // High doses: mostly 1
    x[7] = 8.0;  y[7] = 1.0
    x[8] = 9.0;  y[8] = 1.0
    x[9] = 10.0; y[9] = 1.0

    let result = fit_logistic_epistemic(x, y, 10)

    // β₁ should be positive (higher dose → more response)
    let slope_positive = result.value.beta[1] > 0.0

    // OR > 1 (each unit increase in dose increases odds)
    let or_positive = result.value.odds_ratios[1] > 1.0

    // Model should converge
    let did_converge = result.value.converged

    slope_positive && or_positive && did_converge
}

fn test_dose_response() -> bool with Mut, Div, Panic {
    var doses: [f64; 100] = [0.0; 100]
    var responses: [f64; 100] = [0.0; 100]

    doses[0] = 1.0;  responses[0] = 0.0
    doses[1] = 2.0;  responses[1] = 0.0
    doses[2] = 3.0;  responses[2] = 0.0
    doses[3] = 4.0;  responses[3] = 0.0
    doses[4] = 5.0;  responses[4] = 1.0
    doses[5] = 6.0;  responses[5] = 0.0
    doses[6] = 7.0;  responses[6] = 1.0
    doses[7] = 8.0;  responses[7] = 1.0
    doses[8] = 9.0;  responses[8] = 1.0
    doses[9] = 10.0; responses[9] = 1.0

    let dr = fit_dose_response(doses, responses, 10)

    // ED50 should be around 5-6 (transition zone)
    let ed50_reasonable = dr.value.ed50 > 3.0 && dr.value.ed50 < 8.0

    // ED90 > ED50
    let ed90_greater = dr.value.ed90 > dr.value.ed50

    ed50_reasonable && ed90_greater
}
