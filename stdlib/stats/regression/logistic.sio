// Private legacy convenience routines below are not the checked public fit.
// Public migration contracts are logistic_probability, logistic_normal_two_tail,
// and logistic_fit_checked. No checked fitted-model inference is supplied.
use math::pure::{is_finite,exp}
use math::logarithmic::{log1p_checked}
use linalg::least_squares::{qr_least_squares}
use linalg::weighted_least_squares::{weighted_qr_least_squares}
use special::igamma::{igamma_upper}
pub struct LogisticNormalTail {pub status:i64,pub value:f64}
// Standard-normal two-sided tail only; not fitted-model calibration.
// Bounded to |z|<=37, with unavailable extremes rather than extrapolation.
pub fn logistic_normal_two_tail(z:f64)->LogisticNormalTail with Mut,Div,Panic {
 if !is_finite(z) {return LogisticNormalTail{status:2,value:0.0}}
 let a=if z<0.0 {-z} else {z}
 if a>37.0 {return LogisticNormalTail{status:1,value:0.0}}
 let value=igamma_upper(0.5,(a*0.5)*a)
 if !is_finite(value) || value<=0.0 || value>1.0 {return LogisticNormalTail{status:2,value:0.0}}
 LogisticNormalTail{status:0,value:value}
}
// stats::regression::logistic — Epistemic Logistic Regression
//
// Generalized linear model for binary outcomes with:
// - Maximum likelihood estimation via IRLS
// - Odds ratios as Knowledge<f64> with confidence
// - Dose-response modeling (ED50, ED90)
// - ROC/AUC curve analysis
// - Hosmer-Lemeshow goodness-of-fit
//
// Returns Knowledge<LogisticModel> with full diagnostics
//
// References:
// - Cox (1958): "The regression analysis of binary sequences"
// - Hosmer & Lemeshow (2000): "Applied Logistic Regression"
// - McCullagh & Nelder (1989): "Generalized Linear Models"

// =============================================================================
// Math Helpers (self-contained, following medical/ pattern)
// =============================================================================

struct LogisticBetaConfidence {
    alpha: f64,
    beta: f64
}

fn logit_beta_new(a: f64, b: f64) -> LogisticBetaConfidence { LogisticBetaConfidence { alpha: a, beta: b } }
fn logit_beta_mean(b: &LogisticBetaConfidence) -> f64 { b.alpha / (b.alpha + b.beta) }
fn logit_beta_combine(b1: &LogisticBetaConfidence, b2: &LogisticBetaConfidence) -> LogisticBetaConfidence {
    LogisticBetaConfidence { alpha: b1.alpha + b2.alpha - 1.0, beta: b1.beta + b2.beta - 1.0 }
}

fn logit_abs(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn logit_sqrt(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 25 { y = 0.5 * (y + x / y); i = i + 1 }
    y
}

fn logit_ln(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 - 1.0e30 }
    var m = x
    var e = 0
    while m >= 2.0 { m = m / 2.0; e = e + 1 }
    while m < 0.5 { m = m * 2.0; e = e - 1 }
    let t = (m - 1.0) / (m + 1.0)
    let t2 = t * t
    var sum = t
    var term = t
    var k = 1
    while k < 30 {
        term = term * t2
        sum = sum + term / (2 * k + 1) as f64
        k = k + 1
    }
    2.0 * sum + (e as f64) * 0.6931471805599453
}

fn logit_exp(x: f64) -> f64 with Mut, Div, Panic {
    if x > 500.0 { return 1.0e200 }
    if x < -500.0 { return 0.0 }
    let ln2 = 0.6931471805599453
    var k_f = x / ln2
    var k: i32 = 0
    if k_f >= 0.0 { k = k_f as i32 } else { k = (k_f as i32) - 1 }
    let r = x - (k as f64) * ln2
    var sum = 1.0
    var term = 1.0
    var n = 1
    while n < 25 { term = term * r / (n as f64); sum = sum + term; n = n + 1 }
    var result = sum
    if k >= 0 {
        var i = 0
        while i < k { result = result * 2.0; i = i + 1 }
    } else {
        var i = 0
        while i < (0 - k) { result = result / 2.0; i = i + 1 }
    }
    result
}

fn logit_min(a: f64, b: f64) -> f64 { if a < b { a } else { b } }
fn logit_max(a: f64, b: f64) -> f64 { if a > b { a } else { b } }

// =============================================================================
// Link Functions
// =============================================================================

// Logistic (sigmoid) function: p = 1 / (1 + exp(-z))
fn sigmoid(z: f64) -> f64 with Mut, Div, Panic {
    if z > 20.0 { return 1.0 - 1.0e-10 }
    if z < -20.0 { return 1.0e-10 }
    1.0 / (1.0 + logit_exp(0.0 - z))
}

// Logit (inverse sigmoid): z = ln(p / (1 - p))
fn logit(p: f64) -> f64 with Mut, Div, Panic {
    let clipped = logit_max(1.0e-10, logit_min(1.0 - 1.0e-10, p))
    logit_ln(clipped / (1.0 - clipped))
}

// =============================================================================
// Core Types
// =============================================================================

struct LogisticModel {
    inference_status:i64, // 0 conditional Wald available;1 unavailable; private legacy fit
    beta: [f64; 10],          // Coefficients (β₀ = intercept)
    se: [f64; 10],            // Standard errors
    z_scores: [f64; 10],       // Wald z-scores (β/SE)
    p_values: [f64; 10],       // Two-tailed p-values
    odds_ratios: [f64; 10],    // exp(β) for each predictor
    or_ci_lower: [f64; 10],    // 95% CI lower for OR
    or_ci_upper: [f64; 10],    // 95% CI upper for OR
    n_predictors: i64,
    n_obs: i64,
    n_events: i64,             // Number of y=1
    log_likelihood: f64,
    aic: f64,
    bic: f64,
    deviance: f64,
    null_deviance: f64,
    pseudo_r_squared: f64,     // McFadden's R²
    converged: bool,
    iterations: i64
}



// Diagnostics
struct LogisticDiagnostics {
    hosmer_lemeshow_status:i64, // 1 descriptive statistic only; no calibrated p-value
    hosmer_lemeshow_stat: f64,  // Goodness-of-fit
    hosmer_lemeshow_p: f64,
    auc: f64,                    // Area under ROC curve
    concordance: f64,            // C-statistic
    separation_adequate: LogisticBetaConfidence,
    sample_events_adequate: LogisticBetaConfidence
}

// Provenance
struct LogisticProvenance {
    method_id: i64,  // 1 = IRLS_MLE
    n_obs: i64,
    n_events: i64,
    n_predictors: i64,
    iterations: i64,
    converged: bool,
    diagnostics: LogisticDiagnostics
}

// Knowledge wrapper
struct KnowledgeLogistic {
    value: LogisticModel,
    variance: f64,
    confidence: LogisticBetaConfidence,
    provenance: LogisticProvenance
}

// =============================================================================
// Dose-Response Types
// =============================================================================

struct DoseResponseResult {
    inference_status:i64, // 1: full covariance/interval contract unavailable
    ed50: f64,        // Dose producing 50% effect
    ed90: f64,        // Dose producing 90% effect
    ed50_ci_lower: f64,
    ed50_ci_upper: f64,
    slope: f64,        // Hill slope at ED50
    max_effect: f64
}

struct KnowledgeDoseResponse {
    value: DoseResponseResult,
    variance: f64,
    confidence: LogisticBetaConfidence
}

// =============================================================================
// Simple Linear Regression (used internally)
// =============================================================================

fn logit_mean_arr(data: [f64; 100], n: i64) -> f64 with Mut, Div, Panic {
    var sum = 0.0
    var i: i64 = 0
    while i < n { sum = sum + data[i as usize]; i = i + 1 }
    sum / (n as f64)
}

// =============================================================================
// IRLS (Iteratively Reweighted Least Squares)
// =============================================================================

// Simple logistic regression: logit(p) = β₀ + β₁x
fn fit_logistic_simple(
    x: [f64; 100],
    y: [f64; 100],   // Binary: 0 or 1
    n: i64
) -> LogisticModel with Mut, Div, Panic {
    let max_iter = 25
    let tol = 1.0e-8

    // Count events
    var n_events: i64 = 0
    var i: i64 = 0
    while i < n {
        if y[i as usize] > 0.5 { n_events = n_events + 1 }
        i = i + 1
    }

    // Initialize β₀ = logit(p_bar), β₁ = 0
    let p_bar = (n_events as f64) / (n as f64)
    var beta0 = logit(p_bar)
    var beta1 = 0.0

    // Null log-likelihood (for pseudo-R²)
    var null_ll = 0.0
    i = 0
    while i < n {
        let yi = y[i as usize]
        if yi > 0.5 {
            null_ll = null_ll + logit_ln(p_bar)
        } else {
            null_ll = null_ll + logit_ln(1.0 - p_bar)
        }
        i = i + 1
    }

    // IRLS iterations
    var converged = false
    var iter: i64 = 0

    while iter < max_iter {
        // E-step: compute predicted probabilities
        var sum_w = 0.0
        var sum_wx = 0.0
        var sum_wxx = 0.0
        var sum_wz = 0.0
        var sum_wxz = 0.0

        i = 0
        while i < n {
            let xi = x[i as usize]
            let yi = y[i as usize]

            // Linear predictor
            let eta = beta0 + beta1 * xi

            // Predicted probability
            let pi = sigmoid(eta)

            // Weight: w = p(1-p)
            let w = pi * (1.0 - pi)
            if w < 1.0e-10 { i = i + 1; continue }

            // Working response: z = eta + (y - p) / w_raw
            let z = eta + (yi - pi) / w

            // Accumulate weighted normal equations
            sum_w = sum_w + w
            sum_wx = sum_wx + w * xi
            sum_wxx = sum_wxx + w * xi * xi
            sum_wz = sum_wz + w * z
            sum_wxz = sum_wxz + w * xi * z

            i = i + 1
        }

        // Solve 2x2 weighted normal equations
        let det = sum_w * sum_wxx - sum_wx * sum_wx
        if logit_abs(det) < 1.0e-10 { break }

        let new_beta0 = (sum_wxx * sum_wz - sum_wx * sum_wxz) / det
        let new_beta1 = (sum_w * sum_wxz - sum_wx * sum_wz) / det

        // Check convergence
        let delta0 = logit_abs(new_beta0 - beta0)
        let delta1 = logit_abs(new_beta1 - beta1)

        beta0 = new_beta0
        beta1 = new_beta1

        if delta0 < tol && delta1 < tol {
            converged = true
            break
        }

        iter = iter + 1
    }

    // Compute final statistics
    var log_lik = 0.0
    var deviance = 0.0
    i = 0
    while i < n {
        let xi = x[i as usize]
        let yi = y[i as usize]
        let eta = beta0 + beta1 * xi
        let pi = sigmoid(eta)

        // Log-likelihood: Σ[y·ln(p) + (1-y)·ln(1-p)]
        if yi > 0.5 {
            log_lik = log_lik + logit_ln(logit_max(pi, 1.0e-10))
        } else {
            log_lik = log_lik + logit_ln(logit_max(1.0 - pi, 1.0e-10))
        }

        i = i + 1
    }

    deviance = -2.0 * log_lik
    let null_deviance = -2.0 * null_ll

    // AIC = -2LL + 2k, BIC = -2LL + k·ln(n)
    let k = 2.0  // Number of parameters
    let aic = deviance + 2.0 * k
    let bic = deviance + k * logit_ln(n as f64)

    // McFadden's pseudo-R²
    let pseudo_r2 = 1.0 - log_lik / null_ll

    // Standard errors from Fisher Information (last IRLS weights)
    var sum_w = 0.0
    var sum_wx = 0.0
    var sum_wxx = 0.0
    i = 0
    while i < n {
        let xi = x[i as usize]
        let eta = beta0 + beta1 * xi
        let pi = sigmoid(eta)
        let w = pi * (1.0 - pi)
        sum_w = sum_w + w
        sum_wx = sum_wx + w * xi
        sum_wxx = sum_wxx + w * xi * xi
        i = i + 1
    }

    let det = sum_w * sum_wxx - sum_wx * sum_wx
    let se_beta0 = if logit_abs(det) > 1.0e-10 {
        logit_sqrt(sum_wxx / det)
    } else { 0.0 }
    let se_beta1 = if logit_abs(det) > 1.0e-10 {
        logit_sqrt(sum_w / det)
    } else { 0.0 }

    // Wald z-scores
    let z0 = if se_beta0 > 1.0e-10 { beta0 / se_beta0 } else { 0.0 }
    let z1 = if se_beta1 > 1.0e-10 { beta1 / se_beta1 } else { 0.0 }

    // Sigmoid is not a normal distribution tail.
    let tail0=logistic_normal_two_tail(z0)
    let tail1=logistic_normal_two_tail(z1)
    let inference_ok=converged && is_finite(det) && det>0.0 && is_finite(se_beta0) && is_finite(se_beta1) && se_beta0>0.0 && se_beta1>0.0 && tail0.status==0 && tail1.status==0
    let p0=if inference_ok {tail0.value} else {0.0}
    let p1=if inference_ok {tail1.value} else {0.0}

    // Odds ratios: exp(β)
    let or0 = logit_exp(beta0)
    let or1 = logit_exp(beta1)

    // 95% CI for OR: exp(β ± 1.96·SE)
    let or1_lower = logit_exp(beta1 - 1.96 * se_beta1)
    let or1_upper = logit_exp(beta1 + 1.96 * se_beta1)

    // Construct result
    var betas: [f64; 10] = [0.0; 10]
    betas[0] = beta0
    betas[1] = beta1

    var ses: [f64; 10] = [0.0; 10]
    ses[0] = se_beta0
    ses[1] = se_beta1

    var zs: [f64; 10] = [0.0; 10]
    zs[0] = z0
    zs[1] = z1

    var ps: [f64; 10] = [0.0; 10]
    ps[0] = p0
    ps[1] = p1

    var ors: [f64; 10] = [0.0; 10]
    ors[0] = or0
    ors[1] = or1

    var or_lo: [f64; 10] = [0.0; 10]
    or_lo[1] = or1_lower

    var or_hi: [f64; 10] = [0.0; 10]
    or_hi[1] = or1_upper

    if !inference_ok {
        ses=[0.0;10];zs=[0.0;10];ps=[0.0;10];or_lo=[0.0;10];or_hi=[0.0;10]
    }
    LogisticModel {
        inference_status:if inference_ok {0} else {1},
        beta: betas,
        se: ses,
        z_scores: zs,
        p_values: ps,
        odds_ratios: ors,
        or_ci_lower: or_lo,
        or_ci_upper: or_hi,
        n_predictors: 1,
        n_obs: n,
        n_events: n_events,
        log_likelihood: log_lik,
        aic: aic,
        bic: bic,
        deviance: deviance,
        null_deviance: null_deviance,
        pseudo_r_squared: pseudo_r2,
        converged: converged,
        iterations: iter
    }
}

// =============================================================================
// ROC / AUC
// =============================================================================

fn compute_auc(
    x: [f64; 100],
    y: [f64; 100],
    n: i64,
    beta0: f64,
    beta1: f64
) -> f64 with Mut, Div, Panic {
    // Compute AUC via Mann-Whitney U statistic
    // AUC = P(score(positive) > score(negative))

    // Compute predicted probabilities
    var probs: [f64; 100] = [0.0; 100]
    var i: i64 = 0
    while i < n {
        probs[i as usize] = sigmoid(beta0 + beta1 * x[i as usize])
        i = i + 1
    }

    // Count concordant pairs
    var concordant: i64 = 0
    var discordant: i64 = 0
    var tied: i64 = 0

    i = 0
    while i < n {
        if y[i as usize] < 0.5 { i = i + 1; continue }  // Only positive cases

        var j: i64 = 0
        while j < n {
            if y[j as usize] > 0.5 { j = j + 1; continue }  // Only negative cases

            let pi = probs[i as usize]
            let pj = probs[j as usize]

            if pi > pj { concordant = concordant + 1 }
            else if pi < pj { discordant = discordant + 1 }
            else { tied = tied + 1 }

            j = j + 1
        }
        i = i + 1
    }

    let total = concordant + discordant + tied
    if total == 0 { return 0.5 }

    (concordant as f64 + 0.5 * (tied as f64)) / (total as f64)
}

// =============================================================================
// Epistemic Logistic Regression
// =============================================================================

fn fit_logistic_epistemic(
    x: [f64; 100],
    y: [f64; 100],
    n: i64
) -> KnowledgeLogistic with Mut, Div, Panic {
    let model = fit_logistic_simple(x, y, n)

    // AUC
    let auc = compute_auc(x, y, n, model.beta[0], model.beta[1])

    // Assumption checks
    // 1. Sufficient events (rule of thumb: 10 events per predictor)
    let events_per_pred = model.n_events / (model.n_predictors + 1)
    let event_conf = if events_per_pred >= 10 { 0.95 }
                     else if events_per_pred >= 5 { 0.75 }
                     else { 0.50 }
    let event_beta = logit_beta_new(
        event_conf * (n as f64) * 0.3,
        (1.0 - event_conf) * (n as f64) * 0.3
    )

    // 2. Separation (complete separation → infinite β)
    let sep_conf = if model.converged { 0.90 } else { 0.40 }
    let sep_beta = logit_beta_new(
        sep_conf * (n as f64) * 0.3,
        (1.0 - sep_conf) * (n as f64) * 0.3
    )

    // Hosmer-Lemeshow goodness-of-fit test
    // Bins observations into 10 equal-width probability groups [0,0.1), [0.1,0.2), ..., [0.9,1.0]
    // HL = Σ_g [(O1g - E1g)² / E1g + (O0g - E0g)² / E0g]
    // Under H₀ (good fit): HL ~ χ²(8)
    // Reference: Hosmer & Lemeshow (2000), "Applied Logistic Regression", Ch. 5
    var hl_stat = 0.0
    var g: i64 = 0
    while g < 10 {
        let lo = (g as f64) * 0.1
        let hi = if g == 9 { 1.0001 } else { lo + 0.1 }
        var obs1 = 0.0   // observed events in bin
        var exp1 = 0.0   // expected events in bin
        var ng = 0.0     // total observations in bin
        var j: i64 = 0
        while j < n {
            let p_j = 1.0 / (1.0 + logit_exp(0.0 - model.beta[0] - model.beta[1] * x[j as usize]))
            if p_j >= lo && p_j < hi {
                obs1 = obs1 + y[j as usize]
                exp1 = exp1 + p_j
                ng = ng + 1.0
            }
            j = j + 1
        }
        if ng > 0.0 && exp1 > 1.0e-8 && (ng - exp1) > 1.0e-8 {
            let obs0 = ng - obs1
            let exp0 = ng - exp1
            hl_stat = hl_stat + (obs1 - exp1) * (obs1 - exp1) / exp1
                    + (obs0 - exp0) * (obs0 - exp0) / exp0
        }
        g = g + 1
    }
    // Equal-width bins do not establish the advertised chi-square calibration.
    let hl_p=0.0 // unavailable placeholder; inspect diagnostic status

    let diag = LogisticDiagnostics {
        hosmer_lemeshow_status:1,
        hosmer_lemeshow_stat: hl_stat,
        hosmer_lemeshow_p: hl_p,
        auc: auc,
        concordance: auc,  // C-statistic = AUC for binary
        separation_adequate: sep_beta,
        sample_events_adequate: event_beta
    }

    let overall_conf = logit_beta_combine(&event_beta, &sep_beta)

    let prov = LogisticProvenance {
        method_id: 1,
        n_obs: n,
        n_events: model.n_events,
        n_predictors: model.n_predictors,
        iterations: model.iterations,
        converged: model.converged,
        diagnostics: diag
    }

    KnowledgeLogistic {
        value: model,
        variance: model.se[1] * model.se[1],  // Variance of slope
        confidence: overall_conf,
        provenance: prov
    }
}

// =============================================================================
// Dose-Response Modeling
// =============================================================================

fn fit_dose_response(
    doses: [f64; 100],
    responses: [f64; 100],  // Binary: 0 or 1
    n: i64
) -> KnowledgeDoseResponse with Mut, Div, Panic {
    // Fit logistic model: logit(P(response=1)) = β₀ + β₁·dose
    let model = fit_logistic_simple(doses, responses, n)

    let beta0 = model.beta[0]
    let beta1 = model.beta[1]

    // ED50: dose where P(response) = 0.5
    // logit(0.5) = 0 = β₀ + β₁·ED50
    // ED50 = -β₀/β₁
    let ed50 = if logit_abs(beta1) > 1.0e-10 {
        0.0 - beta0 / beta1
    } else { 0.0 }

    // ED90: dose where P(response) = 0.9
    // logit(0.9) = 2.197 = β₀ + β₁·ED90
    let logit_90 = logit_ln(0.9 / 0.1)
    let ed90 = if logit_abs(beta1) > 1.0e-10 {
        (logit_90 - beta0) / beta1
    } else { 0.0 }

    // CI for ED50 using delta method
    // Var(ED50) ≈ (1/β₁²)[Var(β₀) + ED50²·Var(β₁) + 2·ED50·Cov(β₀,β₁)]
    // Simplified (ignoring covariance):
    let se_beta0 = model.se[0]
    let se_beta1 = model.se[1]
    let var_ed50 = if logit_abs(beta1) > 1.0e-10 {
        (1.0 / (beta1 * beta1)) * (se_beta0 * se_beta0 + ed50 * ed50 * se_beta1 * se_beta1)
    } else { 0.0 }
    let se_ed50 = logit_sqrt(var_ed50)

    let ed50_lower = ed50 - 1.96 * se_ed50
    let ed50_upper = ed50 + 1.96 * se_ed50

    // Hill slope at ED50
    let slope = beta1 * 0.25  // p(1-p) = 0.25 at ED50

    let result = DoseResponseResult {
        inference_status:1,
        ed50: ed50,
        ed90: ed90,
        ed50_ci_lower: 0.0,
        ed50_ci_upper: 0.0,
        slope: slope,
        max_effect: 1.0
    }

    // Confidence from model fit
    let auc = compute_auc(doses, responses, n, beta0, beta1)
    let conf_level = if auc > 0.80 { 0.90 }
                     else if auc > 0.70 { 0.70 }
                     else { 0.50 }

    KnowledgeDoseResponse {
        value: result,
        variance: 0.0, // unavailable: full covariance was not supplied
        confidence: logit_beta_new(
            conf_level * (n as f64) * 0.3,
            (1.0 - conf_level) * (n as f64) * 0.3
        )
    }
}

// =============================================================================
// Tests
// =============================================================================

fn test_logistic_regression() -> bool with Mut, Div, Panic {
    // Dose-response data: higher dose → more response
    var x: [f64; 100] = [0.0; 100]
    var y: [f64; 100] = [0.0; 100]

    // Low doses: mostly 0
    x[0] = 1.0;  y[0] = 0.0
    x[1] = 2.0;  y[1] = 0.0
    x[2] = 3.0;  y[2] = 0.0
    x[3] = 4.0;  y[3] = 0.0
    // Medium doses: mixed
    x[4] = 5.0;  y[4] = 1.0
    x[5] = 6.0;  y[5] = 0.0
    x[6] = 7.0;  y[6] = 1.0
    // High doses: mostly 1
    x[7] = 8.0;  y[7] = 1.0
    x[8] = 9.0;  y[8] = 1.0
    x[9] = 10.0; y[9] = 1.0

    let result = fit_logistic_epistemic(x, y, 10)

    // β₁ should be positive (higher dose → more response)
    let slope_positive = result.value.beta[1] > 0.0

    // OR > 1 (each unit increase in dose increases odds)
    let or_positive = result.value.odds_ratios[1] > 1.0

    // Model should converge
    let did_converge = result.value.converged

    slope_positive && or_positive && did_converge
}

fn test_dose_response() -> bool with Mut, Div, Panic {
    var doses: [f64; 100] = [0.0; 100]
    var responses: [f64; 100] = [0.0; 100]

    doses[0] = 1.0;  responses[0] = 0.0
    doses[1] = 2.0;  responses[1] = 0.0
    doses[2] = 3.0;  responses[2] = 0.0
    doses[3] = 4.0;  responses[3] = 0.0
    doses[4] = 5.0;  responses[4] = 1.0
    doses[5] = 6.0;  responses[5] = 0.0
    doses[6] = 7.0;  responses[6] = 1.0
    doses[7] = 8.0;  responses[7] = 1.0
    doses[8] = 9.0;  responses[8] = 1.0
    doses[9] = 10.0; responses[9] = 1.0

    let dr = fit_dose_response(doses, responses, 10)

    // ED50 should be around 5-6 (transition zone)
    let ed50_reasonable = dr.value.ed50 > 3.0 && dr.value.ed50 < 8.0

    // ED90 > ED50
    let ed90_greater = dr.value.ed90 > dr.value.ed50

    ed50_reasonable && ed90_greater
}


// Checked bounded migration layer. Stride8; explicit intercept columns.
// Point estimation only: no standard errors, p-values or calibrated intervals.
pub struct LogisticProbability {
 pub status:i64, pub probability:f64, pub complement:f64,
}
pub fn logistic_probability(eta:f64)->LogisticProbability with Mut,Div,Panic {
 let bad=LogisticProbability{status:2,probability:0.0,complement:0.0}
 if !is_finite(eta) {return bad}
 var t:f64=0.0
 if eta>=0.0 {t=exp(-eta)} else {t=exp(eta)}
 if !is_finite(t) || t<0.0 {return bad}
 let denominator=1.0+t
 if eta>=0.0 {
  return LogisticProbability{status:0,probability:1.0/denominator,complement:t/denominator}
 }
 LogisticProbability{status:0,probability:t/denominator,complement:1.0/denominator}
}
// 0 available;1 size;2 nonfinite;3 rank;4 arithmetic;5 controls;
// 6 nonbinary response;7 iteration/line search exhausted;
// 8 Fisher weights unrepresentable;9 sufficient constant-response boundary.
pub struct LogisticFitChecked {
 pub status:i64, pub n:i64, pub p:i64, pub rank:i64, pub iterations:i64,
 pub coefficients:[f64;8], pub probabilities:[f64;256],
 pub linear_predictors:[f64;256], pub deviance:f64,
 pub score_norm:f64, pub step_norm:f64, pub rcond_used:f64,
 pub inference_status:i64, pub assumptions_assessed:bool,
}
struct LogisticEvaluation {
 status:i64, eta:[f64;256], probabilities:[f64;256], complements:[f64;256],
 objective:f64,
}
fn lc_empty(status:i64,n:i64,p:i64)->LogisticFitChecked {
 LogisticFitChecked{status:status,n:n,p:p,rank:0,iterations:0,
 coefficients:[0.0;8],probabilities:[0.0;256],linear_predictors:[0.0;256],
 deviance:0.0,score_norm:0.0,step_norm:0.0,rcond_used:0.0,
 inference_status:1,assumptions_assessed:false}
}
fn lc_dot(a:&[f64;2048],beta:&[f64;8],row:i64,p:i64)->f64 with Mut,Div,Panic {
 var sum:f64=0.0
 var correction:f64=0.0
 var j:i64=0
 while j<p {
  let term=a[(row*8+j) as usize]*beta[j as usize]
  let adjusted=term-correction
  let next=sum+adjusted
  correction=(next-sum)-adjusted
  sum=next
  j=j+1
 }
 sum
}
fn lc_evaluate(a:&[f64;2048],y:&[f64;256],beta:&[f64;8],n:i64,p:i64)->LogisticEvaluation with Mut,Div,Panic {
 var out=LogisticEvaluation{status:4,eta:[0.0;256],probabilities:[0.0;256],complements:[0.0;256],objective:0.0}
 var correction:f64=0.0
 var i:i64=0
 while i<n {
  let eta=lc_dot(a,beta,i,p)
  let probability=logistic_probability(eta)
  if probability.status!=0 {return out}
  let tail=if eta>=0.0 {exp(-eta)} else {exp(eta)}
  let logged=log1p_checked(tail)
  if logged.status!=0 {return out}
  var loss=logged.value
  if eta>=0.0 && y[i as usize]==0.0 {loss=loss+eta}
  if eta<0.0 && y[i as usize]==1.0 {loss=loss-eta}
  if !is_finite(loss) || loss<0.0 {return out}
  let adjusted=loss-correction
  let next=out.objective+adjusted
  correction=(next-out.objective)-adjusted
  out.objective=next
  out.eta[i as usize]=eta
  out.probabilities[i as usize]=probability.probability
  out.complements[i as usize]=probability.complement
  i=i+1
 }
 if !is_finite(out.objective) {return out}
 out.status=0
 out
}
pub fn logistic_fit_checked(a:&[f64;2048],y:&[f64;256],n:i64,p:i64,
 rcond:f64,max_iterations:i64,tolerance:f64)->LogisticFitChecked with Mut,Div,Panic {
 if n<1 || n>256 || p<1 || p>8 || p>n {return lc_empty(1,n,p)}
 if !is_finite(rcond) || rcond<0.0 || rcond>=1.0 ||
 max_iterations<1 || max_iterations>100 || !is_finite(tolerance) ||
 tolerance<1e-12 || tolerance>1e-4 {return lc_empty(5,n,p)}
 var scales:[f64;8]=[0.0;8]
 var i:i64=0
 while i<n {
  if !is_finite(y[i as usize]) {return lc_empty(2,n,p)}
  var j:i64=0
  while j<p {
   let v=a[(i*8+j) as usize]
   if !is_finite(v) {return lc_empty(2,n,p)}
   let magnitude=logit_abs(v)
   if magnitude>scales[j as usize] {scales[j as usize]=magnitude}
   j=j+1
  }
  i=i+1
 }
 i=0
 while i<n {
  if y[i as usize]!=0.0 && y[i as usize]!=1.0 {return lc_empty(6,n,p)}
  i=i+1
 }
 let zero:[f64;256]=[0.0;256]
 let rank_fit=qr_least_squares(a,&zero,n,p,rcond)
 if rank_fit.status!=0 {
  var bad=lc_empty(if rank_fit.status==3 {3}else{4},n,p)
  bad.rank=rank_fit.rank
  bad.rcond_used=rank_fit.rcond_used
  return bad
 }
 // A nonzero constant design column supplies a diverging intercept direction
 // for an all-zero or all-one response. No general separation claim is made.
 var same=true
 i=1
 while i<n {if y[i as usize]!=y[0] {same=false} i=i+1}
 if same {
  var j:i64=0
  while j<p {
   var constant=a[j as usize]!=0.0
   i=1
   while i<n {if a[(i*8+j) as usize]!=a[j as usize] {constant=false} i=i+1}
   if constant {return lc_empty(9,n,p)}
   j=j+1
  }
 }
 var beta:[f64;8]=[0.0;8]
 var current=lc_evaluate(a,y,&beta,n,p)
 if current.status!=0 {return lc_empty(4,n,p)}
 var iteration:i64=0
 while iteration<max_iterations {
  var response:[f64;256]=[0.0;256]
  var weights:[f64;256]=[0.0;256]
  var score_norm:f64=0.0
  var j:i64=0
  while j<p {
   var sum:f64=0.0
   var correction:f64=0.0
   i=0
   while i<n {
    let residual=if y[i as usize]==1.0 {current.complements[i as usize]} else {-current.probabilities[i as usize]}
    let term=(a[(i*8+j) as usize]/scales[j as usize])*residual/(n as f64)
    let adjusted=term-correction
    let next=sum+adjusted
    correction=(next-sum)-adjusted
    sum=next
    i=i+1
   }
   if !is_finite(sum) {return lc_empty(4,n,p)}
   if logit_abs(sum)>score_norm {score_norm=logit_abs(sum)}
   j=j+1
  }
  i=0
  while i<n {
   let probability=current.probabilities[i as usize]
   let complement=current.complements[i as usize]
   let weight=probability*complement
   if !is_finite(weight) || weight<=0.0 {return lc_empty(8,n,p)}
   weights[i as usize]=weight
   let residual=if y[i as usize]==1.0 {complement} else {-probability}
   response[i as usize]=residual/weight
   if !is_finite(response[i as usize]) {return lc_empty(4,n,p)}
   i=i+1
  }
  let increment=weighted_qr_least_squares(a,&response,&weights,n,p,rcond)
  if increment.status!=0 {
   var bad=lc_empty(if increment.status==3 {3}else{4},n,p)
   bad.rank=increment.rank
   bad.iterations=iteration
   return bad
  }
  var full_step:f64=0.0
  i=0
  while i<n {
   let movement=lc_dot(a,&increment.coefficients,i,p)
   let step=logit_abs(movement)/(1.0+logit_abs(current.eta[i as usize]))
   if !is_finite(step) {return lc_empty(4,n,p)}
   if step>full_step {full_step=step}
   i=i+1
  }
  iteration=iteration+1
  if score_norm<=tolerance && full_step<=tolerance {
   let deviance=2.0*current.objective
   if !is_finite(deviance) {return lc_empty(4,n,p)}
   var out=lc_empty(0,n,p)
   out.rank=p
   out.iterations=iteration
   out.coefficients=beta
   out.probabilities=current.probabilities
   out.linear_predictors=current.eta
   out.deviance=deviance
   out.score_norm=score_norm
   out.step_norm=full_step
   out.rcond_used=increment.rcond_used
   return out
  }
  var fraction:f64=1.0
  var halvings:i64=0
  var accepted=false
  while halvings<=32 && !accepted {
   var trial_beta:[f64;8]=[0.0;8]
   j=0
   while j<p {
    trial_beta[j as usize]=beta[j as usize]+fraction*increment.coefficients[j as usize]
    j=j+1
   }
   let trial=lc_evaluate(a,y,&trial_beta,n,p)
   if trial.status==0 && trial.objective<=current.objective {
    beta=trial_beta
    current=trial
    accepted=true
   } else {fraction=fraction*0.5}
   halvings=halvings+1
  }
  if !accepted {
   var bad=lc_empty(7,n,p)
   bad.iterations=iteration
   return bad
  }
 }
 var exhausted=lc_empty(7,n,p)
 exhausted.iterations=iteration
 exhausted
}
