// Checked multiple linear least squares; explicit caller-supplied design.
// Physical row stride is 8. Include a column of ones for an intercept.
// Returns a numerical fit only: no SE, p-value or interval is inferred.
use linalg::least_squares::{LeastSquaresResult,qr_least_squares}
use linalg::weighted_least_squares::{WeightedLeastSquaresResult,weighted_qr_least_squares}
pub fn multiple_linear_fit(design:&[f64;2048],response:&[f64;256],
    n:i64,p:i64,rcond:f64)->LeastSquaresResult with Mut,Div,Panic {
    qr_least_squares(design,response,n,p,rcond)
}
// Positive relative objective weights. A variance model is not assessed.
pub fn weighted_multiple_linear_fit(design:&[f64;2048],response:&[f64;256],
    weights:&[f64;256],n:i64,p:i64,rcond:f64)->WeightedLeastSquaresResult with Mut,Div,Panic {
    weighted_qr_least_squares(design,response,weights,n,p,rcond)
}
