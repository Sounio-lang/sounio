// stats::timeseries::arima
//
// Minimal stable AR/ARIMA support used by the current repository tests.
// The active surface exercised today is:
// - acf
// - levinson_durbin
// - fit_ar
//
// The broader ARIMA/epistemic API is kept as thin wrappers over this core so
// the module remains importable without dragging unstable aggregate paths into
// the compiler.

fn ar_abs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

fn ar_ln(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 - 1.0e30 }
    var m = x
    var e = 0
    while m >= 2.0 { m = m / 2.0; e = e + 1 }
    while m < 0.5 { m = m * 2.0; e = e - 1 }
    let t = (m - 1.0) / (m + 1.0)
    let t2 = t * t
    var sum = t
    var term = t
    var k = 1
    while k < 30 {
        term = term * t2
        sum = sum + term / (2 * k + 1) as f64
        k = k + 1
    }
    return 2.0 * sum + (e as f64) * 0.6931471805599453
}

fn ar_sqrt(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 25 {
        y = 0.5 * (y + x / y)
        i = i + 1
    }
    return y
}

pub struct ARIMAResult {
    ar_coeffs: [f64; 5],
    ma_coeffs: [f64; 5],
    intercept: f64,
    p: i64,
    d: i64,
    q: i64,
    sigma_squared: f64,
    aic: f64,
    bic: f64,
    log_likelihood: f64,
    residuals: [f64; 500],
    n_obs: i64
}

pub fn acf(series: [f64; 500], n: i64, max_lag: i64) -> [f64; 20] with Mut, Div, Panic {
    var result: [f64; 20] = [0.0; 20]
    if n <= 0 { return result }

    var mean = 0.0
    var i: i64 = 0
    while i < n {
        mean = mean + series[i as usize]
        i = i + 1
    }
    mean = mean / (n as f64)

    var c0 = 0.0
    i = 0
    while i < n {
        let d = series[i as usize] - mean
        c0 = c0 + d * d
        i = i + 1
    }
    c0 = c0 / (n as f64)
    if c0 < 1.0e-12 {
        result[0] = 1.0
        return result
    }

    result[0] = 1.0
    var lag: i64 = 1
    while lag <= max_lag && lag < 20 {
        var ck = 0.0
        i = lag
        while i < n {
            ck = ck + (series[i as usize] - mean) * (series[(i - lag) as usize] - mean)
            i = i + 1
        }
        ck = ck / (n as f64)
        result[lag as usize] = ck / c0
        lag = lag + 1
    }
    return result
}

pub fn levinson_durbin(acf_vals: [f64; 20], order: i64) -> [f64; 5] with Mut, Div, Panic {
    var phi: [f64; 5] = [0.0; 5]
    if order <= 0 { return phi }

    var phi_prev: [f64; 5] = [0.0; 5]
    phi_prev[0] = acf_vals[1]
    var P = 1.0 - phi_prev[0] * phi_prev[0]

    var idx: i64 = 0
    while idx < 5 {
        phi[idx as usize] = phi_prev[idx as usize]
        idx = idx + 1
    }

    var k: i64 = 2
    while k <= order && k <= 5 {
        var lambda = acf_vals[k as usize]
        var j: i64 = 1
        while j <= k - 1 {
            lambda = lambda - phi_prev[(j - 1) as usize] * acf_vals[(k - j) as usize]
            j = j + 1
        }

        var phi_kk = 0.0
        if ar_abs(P) > 1.0e-12 { phi_kk = lambda / P }

        var phi_new: [f64; 5] = [0.0; 5]
        j = 1
        while j <= k - 1 {
            phi_new[(j - 1) as usize] =
                phi_prev[(j - 1) as usize] - phi_kk * phi_prev[(k - j - 1) as usize]
            j = j + 1
        }
        phi_new[(k - 1) as usize] = phi_kk
        P = P * (1.0 - phi_kk * phi_kk)

        idx = 0
        while idx < 5 {
            phi_prev[idx as usize] = phi_new[idx as usize]
            phi[idx as usize] = phi_new[idx as usize]
            idx = idx + 1
        }
        k = k + 1
    }

    return phi
}

pub fn fit_ar(series: [f64; 500], n: i64, p: i64) -> ARIMAResult with Mut, Div, Panic {
    let autocorr = acf(series, n, p + 1)

    var mean = 0.0
    var i: i64 = 0
    while i < n {
        mean = mean + series[i as usize]
        i = i + 1
    }
    mean = mean / (n as f64)

    let ar_coeffs = levinson_durbin(autocorr, p)

    var residuals: [f64; 500] = [0.0; 500]
    var rss = 0.0
    i = p
    while i < n {
        var pred = mean
        var j: i64 = 0
        while j < p {
            pred = pred + ar_coeffs[j as usize] * (series[(i - j - 1) as usize] - mean)
            j = j + 1
        }
        residuals[i as usize] = series[i as usize] - pred
        rss = rss + residuals[i as usize] * residuals[i as usize]
        i = i + 1
    }

    let effective_n = if n - p > 0 { n - p } else { 1 }
    let sigma2 = rss / (effective_n as f64)
    let nf = effective_n as f64
    let ll = -0.5 * nf * (1.0 + ar_ln(2.0 * 3.14159265) + ar_ln(sigma2))
    let k = (p + 1) as f64

    return ARIMAResult {
        ar_coeffs: ar_coeffs,
        ma_coeffs: [0.0; 5],
        intercept: mean,
        p: p,
        d: 0,
        q: 0,
        sigma_squared: sigma2,
        aic: -2.0 * ll + 2.0 * k,
        bic: -2.0 * ll + k * ar_ln(nf),
        log_likelihood: ll,
        residuals: residuals,
        n_obs: n
    }
}

fn fit_arima(series: [f64; 500], n: i64, p: i64, d: i64, q: i64) -> ARIMAResult with Mut, Div, Panic {
    var result = fit_ar(series, n, p)
    result.d = d
    result.q = q
    return result
}

fn auto_arima(series: [f64; 500], n: i64, max_p: i64, max_d: i64, max_q: i64) -> ARIMAResult with Mut, Div, Panic {
    let _ = max_q
    var best = fit_arima(series, n, 0, 0, 0)
    var best_aic = best.aic
    var d: i64 = 0
    while d <= max_d {
        var p: i64 = 0
        while p <= max_p && p <= 5 {
            let candidate = fit_arima(series, n, p, d, 0)
            if candidate.aic < best_aic {
                best = candidate
                best_aic = candidate.aic
            }
            p = p + 1
        }
        d = d + 1
    }
    return best
}

struct ForecastResult {
    point: [f64; 50],
    lower_95: [f64; 50],
    upper_95: [f64; 50],
    n_ahead: i64
}

fn forecast_arima(model: ARIMAResult, series: [f64; 500], n: i64, n_ahead: i64) -> ForecastResult with Mut, Div, Panic {
    let _ = model
    let _ = series
    let _ = n
    return ForecastResult {
        point: [0.0; 50],
        lower_95: [0.0; 50],
        upper_95: [0.0; 50],
        n_ahead: n_ahead
    }
}

// The broader epistemic/time-series wrappers that used to live here are
// intentionally omitted from the active surface until the aggregate ABI path is
// repaired. The current repository only exercises acf / levinson_durbin /
// fit_ar through the stdlib E2E lane.
