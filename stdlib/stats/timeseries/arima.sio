// stats::timeseries::arima — Epistemic ARIMA Models
//
// Autoregressive Integrated Moving Average with:
// - AR(p), MA(q), ARMA(p,q), ARIMA(p,d,q)
// - Auto-ARIMA model selection (AIC/BIC)
// - Forecasting with uncertainty bounds
// - Diagnostic checks (Ljung-Box, ACF/PACF)
// - Knowledge<ARIMAResult> with epistemic metadata
//
// References:
// - Box & Jenkins (1970): "Time Series Analysis: Forecasting and Control"
// - Akaike (1974): "A new look at the statistical model identification" (AIC)
// - Ljung & Box (1978): "On a measure of lack of fit in time series models"
// - Hyndman & Khandakar (2008): "Automatic time series forecasting" (auto.arima)

// =============================================================================
// Math Helpers
// =============================================================================

fn ar_abs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

fn ar_sqrt(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 25 { y = 0.5 * (y + x / y); i = i + 1 }
    y
}

fn ar_ln(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 - 1.0e30 }
    var m = x
    var e = 0
    while m >= 2.0 { m = m / 2.0; e = e + 1 }
    while m < 0.5 { m = m * 2.0; e = e - 1 }
    let t = (m - 1.0) / (m + 1.0)
    let t2 = t * t
    var sum = t
    var term = t
    var k = 1
    while k < 30 { term = term * t2; sum = sum + term / (2 * k + 1) as f64; k = k + 1 }
    2.0 * sum + (e as f64) * 0.6931471805599453
}

fn ar_min(a: f64, b: f64) -> f64 { if a < b { a } else { b } }

// =============================================================================
// Types
// =============================================================================

let MAX_T: i64 = 500
let MAX_ORDER: i64 = 5

struct ARIMAResult {
    ar_coeffs: [f64; 5],   // φ₁, φ₂, ..., φ_p
    ma_coeffs: [f64; 5],   // θ₁, θ₂, ..., θ_q
    intercept: f64,
    p: i64,                  // AR order
    d: i64,                  // Differencing order
    q: i64,                  // MA order
    sigma_squared: f64,      // Residual variance
    aic: f64,
    bic: f64,
    log_likelihood: f64,
    residuals: [f64; 500],
    n_obs: i64
}

struct ForecastResult {
    point: [f64; 50],       // Point forecasts
    lower_95: [f64; 50],    // 95% CI lower
    upper_95: [f64; 50],    // 95% CI upper
    n_ahead: i64
}

struct BetaConfidence {
    alpha: f64,
    beta: f64
}

fn beta_new(a: f64, b: f64) -> BetaConfidence { BetaConfidence { alpha: a, beta: b } }
fn beta_mean(b: &BetaConfidence) -> f64 { b.alpha / (b.alpha + b.beta) }
fn beta_combine(b1: &BetaConfidence, b2: &BetaConfidence) -> BetaConfidence {
    BetaConfidence { alpha: b1.alpha + b2.alpha - 1.0, beta: b1.beta + b2.beta - 1.0 }
}

struct ARIMADiagnostics {
    ljung_box_stat: f64,
    ljung_box_p: f64,
    residual_normality: BetaConfidence,
    stationarity: BetaConfidence
}

struct ARIMAProvenance {
    method: String,
    order: String,  // "(p,d,q)"
    n_obs: i64,
    diagnostics: ARIMADiagnostics
}

struct KnowledgeARIMA {
    value: ARIMAResult,
    variance: f64,
    confidence: BetaConfidence,
    provenance: ARIMAProvenance
}

// =============================================================================
// Differencing
// =============================================================================

fn difference(
    series: [f64; 500],
    n: i64,
    d: i64
) -> ([f64; 500], i64) with Mut, Div, Panic {
    var result: [f64; 500] = series
    var current_n = n

    var diff_order: i64 = 0
    while diff_order < d {
        var new_series: [f64; 500] = [0.0; 500]
        var i: i64 = 1
        while i < current_n {
            new_series[(i - 1) as usize] = result[i as usize] - result[(i - 1) as usize]
            i = i + 1
        }
        result = new_series
        current_n = current_n - 1
        diff_order = diff_order + 1
    }

    (result, current_n)
}

// =============================================================================
// Autocorrelation Function
// =============================================================================

fn acf(series: [f64; 500], n: i64, max_lag: i64) -> [f64; 20] with Mut, Div, Panic {
    var result: [f64; 20] = [0.0; 20]

    // Mean
    var mean = 0.0
    var i: i64 = 0
    while i < n { mean = mean + series[i as usize]; i = i + 1 }
    mean = mean / (n as f64)

    // Variance (lag 0)
    var c0 = 0.0
    i = 0
    while i < n {
        let d = series[i as usize] - mean
        c0 = c0 + d * d
        i = i + 1
    }
    c0 = c0 / (n as f64)

    if c0 < 1.0e-10 { return result }

    var lag: i64 = 1
    while lag <= max_lag && lag < 20 {
        var ck = 0.0
        i = lag
        while i < n {
            ck = ck + (series[i as usize] - mean) * (series[(i - lag) as usize] - mean)
            i = i + 1
        }
        ck = ck / (n as f64)
        result[lag as usize] = ck / c0
        lag = lag + 1
    }

    result
}

// =============================================================================
// Levinson-Durbin Recursion
// =============================================================================
//
// Solves the Yule-Walker system for AR(p) coefficients given the normalised
// autocorrelation sequence r[0..p] (r[0] == 1.0 after normalisation).
//
// Reference: Durbin (1960), Levinson (1947).
//
// Arguments:
//   acf_vals  — autocorrelation array of length >= p+1 (index 0 == lag-0 ACF,
//               which must be 1.0 for the normalised form expected here)
//   order     — AR order p (1 <= p <= 5)
//
// Returns: AR coefficient array of length 5 (coefficients at indices 0..p-1).

fn levinson_durbin(acf_vals: [f64; 20], order: i64) -> [f64; 5] with Mut, Div, Panic {
    var phi: [f64; 5] = [0.0; 5]

    if order <= 0 { return phi }

    // phi_prev holds the coefficients from the previous order.
    // We use two explicit arrays and swap conceptually.
    var phi_prev: [f64; 5] = [0.0; 5]

    // Initialise for k = 1
    // Reflection coefficient: phi_11 = r(1) / r(0) = r(1)  (r(0) == 1.0)
    phi_prev[0] = acf_vals[1]
    // Prediction-error variance (unnormalised): P_1 = 1 - phi_11^2
    var P = 1.0 - phi_prev[0] * phi_prev[0]

    // Copy into phi (will be returned if order == 1)
    var idx: i64 = 0
    while idx < 5 { phi[idx as usize] = phi_prev[idx as usize]; idx = idx + 1 }

    var k: i64 = 2
    while k <= order {
        // --- Compute reflection coefficient for order k ---
        // lambda = r(k) - sum_{j=1}^{k-1} phi_{k-1,j} * r(k-j)
        var lambda = acf_vals[k as usize]
        var j: i64 = 1
        while j <= k - 1 {
            lambda = lambda - phi_prev[(j - 1) as usize] * acf_vals[(k - j) as usize]
            j = j + 1
        }

        // Guard against near-zero prediction-error variance
        var phi_kk = 0.0
        if ar_abs(P) > 1.0e-12 { phi_kk = lambda / P }

        // --- Update AR coefficients ---
        // phi_{k,j} = phi_{k-1,j} - phi_kk * phi_{k-1,k-j}   for j = 1..k-1
        // phi_{k,k} = phi_kk
        var phi_new: [f64; 5] = [0.0; 5]
        j = 1
        while j <= k - 1 {
            phi_new[(j - 1) as usize] =
                phi_prev[(j - 1) as usize]
                - phi_kk * phi_prev[(k - j - 1) as usize]
            j = j + 1
        }
        phi_new[(k - 1) as usize] = phi_kk

        // --- Update prediction-error variance ---
        P = P * (1.0 - phi_kk * phi_kk)

        // Copy phi_new → phi_prev for next iteration and into phi for return
        idx = 0
        while idx < 5 {
            phi_prev[idx as usize] = phi_new[idx as usize]
            phi[idx as usize]      = phi_new[idx as usize]
            idx = idx + 1
        }

        k = k + 1
    }

    phi
}

// =============================================================================
// MA(q) Estimation via OLS on Innovations
// =============================================================================
//
// After fitting the AR part the residuals approximate the innovation process.
// For MA(q) we regress each residual e[t] on the q most-recent lagged residuals
// e[t-1], ..., e[t-q] by solving the normal equations directly.
//
// For q = 1 this is just the sample correlation between e[t] and e[t-1].
// For q = 2 we solve a 2x2 system.  For q > 2 we iteratively refine using a
// single Gauss-Seidel sweep (sufficient for initial estimates).
//
// Arguments:
//   residuals — residual array (length n, stored in a [f64; 500] buffer)
//   n         — number of valid residuals
//   q         — MA order (1 <= q <= 5)
//
// Returns: MA coefficient array of length 5 (indices 0..q-1).

fn estimate_ma_coefficients(residuals: [f64; 500], n: i64, q: i64) -> [f64; 5] with Mut, Div, Panic {
    var theta: [f64; 5] = [0.0; 5]

    if q <= 0 || n <= q { return theta }

    // Build the sample autocovariance of the residuals up to lag q.
    // c[k] = (1/n) * sum_{t=k}^{n-1} e[t] * e[t-k]
    var c: [f64; 6] = [0.0; 6]  // index 0..q, q <= 5
    var k: i64 = 0
    while k <= q && k < 6 {
        var sum = 0.0
        var t: i64 = k
        while t < n {
            sum = sum + residuals[t as usize] * residuals[(t - k) as usize]
            t = t + 1
        }
        c[k as usize] = sum / (n as f64)
        k = k + 1
    }

    // Guard: if residual variance is negligible MA coefficients stay zero
    if ar_abs(c[0]) < 1.0e-12 { return theta }

    if q == 1 {
        // theta_1 = c(1) / c(0)   (OLS slope, also moment estimator)
        theta[0] = c[1] / c[0]
    } else if q == 2 {
        // Solve 2x2 Yule-Walker–like system for the MA side:
        //   [c(0)  c(1)] [theta_1]   [c(1)]
        //   [c(1)  c(0)] [theta_2] = [c(2)]
        let det = c[0] * c[0] - c[1] * c[1]
        if ar_abs(det) > 1.0e-12 {
            theta[0] = (c[0] * c[1] - c[1] * c[2]) / det
            theta[1] = (c[0] * c[2] - c[1] * c[1]) / det
        }
    } else {
        // For q >= 3: use Levinson-Durbin on the residual ACF.
        // First build the normalised ACF array (length 20) for the residuals.
        var resid_acf: [f64; 20] = [0.0; 20]
        resid_acf[0] = 1.0
        var lag: i64 = 1
        while lag <= q && lag < 20 {
            resid_acf[lag as usize] = c[lag as usize] / c[0]
            lag = lag + 1
        }
        // Levinson-Durbin gives AR coefficients for the ACF structure;
        // the resulting coefficients serve as moment-based MA estimates.
        theta = levinson_durbin(resid_acf, q)
    }

    theta
}

// =============================================================================
// AR(p) Estimation via Yule-Walker
// =============================================================================

fn fit_ar(
    series: [f64; 500],
    n: i64,
    p: i64
) -> ARIMAResult with Mut, Div, Panic {
    // Yule-Walker equations: Rφ = r
    // For p=1: φ₁ = r(1) (first autocorrelation)
    // For p=2: solve 2x2 system

    let autocorr = acf(series, n, p + 1)

    // Mean
    var mean = 0.0
    var i: i64 = 0
    while i < n { mean = mean + series[i as usize]; i = i + 1 }
    mean = mean / (n as f64)

    // Levinson-Durbin recursion solves the full Yule-Walker system for any p.
    // For p == 0 it returns a zero array (pure MA / white-noise case).
    var ar_coeffs: [f64; 5] = levinson_durbin(autocorr, p)

    // Compute residuals
    var residuals: [f64; 500] = [0.0; 500]
    var rss = 0.0
    i = p
    while i < n {
        var pred = mean * (1.0 - ar_coeffs[0])  // Simplified
        var j: i64 = 0
        while j < p {
            pred = pred + ar_coeffs[j as usize] * series[(i - j - 1) as usize]
            j = j + 1
        }
        residuals[i as usize] = series[i as usize] - pred
        rss = rss + residuals[i as usize] * residuals[i as usize]
        i = i + 1
    }

    let effective_n = n - p
    let sigma2 = rss / (effective_n as f64)
    let nf = effective_n as f64

    // Log-likelihood
    let ll = -0.5 * nf * (1.0 + ar_ln(2.0 * 3.14159265) + ar_ln(sigma2))

    // AIC, BIC
    let k = (p + 1) as f64  // p AR coeffs + variance
    let aic = -2.0 * ll + 2.0 * k
    let bic = -2.0 * ll + k * ar_ln(nf)

    ARIMAResult {
        ar_coeffs: ar_coeffs,
        ma_coeffs: [0.0; 5],
        intercept: mean,
        p: p,
        d: 0,
        q: 0,
        sigma_squared: sigma2,
        aic: aic,
        bic: bic,
        log_likelihood: ll,
        residuals: residuals,
        n_obs: n
    }
}

// =============================================================================
// ARIMA(p,d,q) Fitting
// =============================================================================

fn fit_arima(
    series: [f64; 500],
    n: i64,
    p: i64,
    d: i64,
    q: i64
) -> ARIMAResult with Mut, Div, Panic {
    // Step 1: Difference d times
    let (diff_series, diff_n) = difference(series, n, d)

    // Step 2: Fit AR(p) on differenced series via Levinson-Durbin / Yule-Walker
    var result = fit_ar(diff_series, diff_n, p)
    result.d = d
    result.q = q

    // Step 3: If q > 0, estimate MA(q) coefficients from the AR residuals.
    // The AR residuals stored in result.residuals approximate the innovations;
    // estimate_ma_coefficients regresses e[t] on e[t-1]..e[t-q] via OLS /
    // moment matching to produce initial MA parameter estimates.
    if q > 0 {
        let ma_est = estimate_ma_coefficients(result.residuals, result.n_obs, q)
        result.ma_coeffs = ma_est

        // Refine residuals with MA correction:
        //   e_arma[t] = e_ar[t] - sum_{j=1}^{q} theta_j * e_ar[t-j]
        var refined: [f64; 500] = [0.0; 500]
        var rss2 = 0.0
        var i: i64 = q
        while i < result.n_obs {
            var corr = result.residuals[i as usize]
            var j: i64 = 0
            while j < q {
                corr = corr - ma_est[j as usize] * result.residuals[(i - j - 1) as usize]
                j = j + 1
            }
            refined[i as usize] = corr
            rss2 = rss2 + corr * corr
            i = i + 1
        }

        let eff_n2 = (result.n_obs - p - q) as f64
        let sigma2_arma = if eff_n2 > 0.0 { rss2 / eff_n2 } else { result.sigma_squared }
        result.residuals    = refined
        result.sigma_squared = sigma2_arma

        // Update log-likelihood, AIC, BIC with new sigma and parameter count
        let ll2 = -0.5 * eff_n2 * (1.0 + ar_ln(2.0 * 3.14159265) + ar_ln(sigma2_arma))
        let k2  = (p + q + 1) as f64
        result.log_likelihood = ll2
        result.aic            = -2.0 * ll2 + 2.0 * k2
        result.bic            = -2.0 * ll2 + k2 * ar_ln(eff_n2)
    }

    result
}

// =============================================================================
// Auto-ARIMA (Model Selection)
// =============================================================================

fn auto_arima(
    series: [f64; 500],
    n: i64,
    max_p: i64,
    max_d: i64,
    max_q: i64
) -> ARIMAResult with Mut, Div, Panic {
    var best_aic = 1.0e30
    var best_p: i64 = 0
    var best_d: i64 = 0
    var best_q: i64 = 0

    // Grid search over (p, d, q)
    var d: i64 = 0
    while d <= max_d {
        var p: i64 = 0
        while p <= max_p {
            // Fit ARIMA(p, d, 0) — AR models only for simplicity
            let model = fit_arima(series, n, p, d, 0)
            if model.aic < best_aic {
                best_aic = model.aic
                best_p = p
                best_d = d
                best_q = 0
            }
            p = p + 1
        }
        d = d + 1
    }

    fit_arima(series, n, best_p, best_d, best_q)
}

// =============================================================================
// Forecasting
// =============================================================================

fn forecast_arima(
    model: &ARIMAResult,
    series: [f64; 500],
    n: i64,
    n_ahead: i64
) -> ForecastResult with Mut, Div, Panic {
    var point: [f64; 50] = [0.0; 50]
    var lower: [f64; 50] = [0.0; 50]
    var upper: [f64; 50] = [0.0; 50]

    // Extend series with forecasts
    var extended: [f64; 550] = [0.0; 550]
    var i: i64 = 0
    while i < n {
        extended[i as usize] = series[i as usize]
        i = i + 1
    }

    var h: i64 = 0
    while h < n_ahead && h < 50 {
        var pred = model.intercept * (1.0 - model.ar_coeffs[0])

        var j: i64 = 0
        while j < model.p {
            let idx = n + h - j - 1
            if idx >= 0 {
                pred = pred + model.ar_coeffs[j as usize] * extended[idx as usize]
            }
            j = j + 1
        }

        point[h as usize] = pred
        extended[(n + h) as usize] = pred

        // Prediction interval widens with horizon
        let se = ar_sqrt(model.sigma_squared * ((h + 1) as f64))
        lower[h as usize] = pred - 1.96 * se
        upper[h as usize] = pred + 1.96 * se

        h = h + 1
    }

    ForecastResult {
        point: point,
        lower_95: lower,
        upper_95: upper,
        n_ahead: n_ahead
    }
}

// =============================================================================
// Ljung-Box Test
// =============================================================================

fn ljung_box(residuals: [f64; 500], n: i64, max_lag: i64) -> (f64, f64) with Mut, Div, Panic {
    let autocorr = acf(residuals, n, max_lag)

    // Q = n(n+2) Σ ρ²(k) / (n-k)
    var q = 0.0
    var k: i64 = 1
    while k <= max_lag && k < 20 {
        let rk = autocorr[k as usize]
        q = q + (rk * rk) / ((n - k) as f64)
        k = k + 1
    }
    q = q * (n as f64) * ((n + 2) as f64)

    // Approximate p-value (chi-squared with max_lag df)
    let p = if q > 20.0 { 0.001 }
            else if q > 12.0 { 0.01 }
            else if q > 7.0 { 0.05 }
            else { 0.50 }

    (q, p)
}

// =============================================================================
// EPISTEMIC ARIMA
// =============================================================================

fn fit_arima_epistemic(
    series: [f64; 500],
    n: i64,
    p: i64,
    d: i64,
    q: i64
) -> KnowledgeARIMA with Mut, Div, Panic {
    let model = fit_arima(series, n, p, d, q)

    // Ljung-Box test on residuals
    let (lb_stat, lb_p) = ljung_box(model.residuals, n, 10)

    // Residual normality (simplified)
    let resid_conf = if lb_p > 0.10 { 0.90 }
                     else if lb_p > 0.05 { 0.70 }
                     else { 0.50 }
    let norm_beta = beta_new(resid_conf * (n as f64) * 0.3, (1.0 - resid_conf) * (n as f64) * 0.3)

    // Stationarity check (AR coefficients < 1)
    var stationary = true
    var j: i64 = 0
    while j < p {
        if ar_abs(model.ar_coeffs[j as usize]) >= 1.0 { stationary = false }
        j = j + 1
    }
    let stat_conf = if stationary { 0.90 } else { 0.40 }
    let stat_beta = beta_new(stat_conf * (n as f64) * 0.3, (1.0 - stat_conf) * (n as f64) * 0.3)

    let diag = ARIMADiagnostics {
        ljung_box_stat: lb_stat,
        ljung_box_p: lb_p,
        residual_normality: norm_beta,
        stationarity: stat_beta
    }

    let overall = beta_combine(&norm_beta, &stat_beta)

    let prov = ARIMAProvenance {
        method: "YuleWalker_AR",
        order: "ARIMA",
        n_obs: n,
        diagnostics: diag
    }

    KnowledgeARIMA {
        value: model,
        variance: model.sigma_squared,
        confidence: overall,
        provenance: prov
    }
}

// =============================================================================
// Tests
// =============================================================================

fn test_ar1_fit() -> bool with Mut, Div, Panic {
    // AR(1) process: y_t = 0.8 * y_{t-1} + ε
    var series: [f64; 500] = [0.0; 500]
    series[0] = 1.0
    var i: i64 = 1
    while i < 100 {
        series[i as usize] = 0.8 * series[(i - 1) as usize] + 0.1 * ((i % 7) as f64 - 3.0)
        i = i + 1
    }

    let result = fit_arima_epistemic(series, 100, 1, 0, 0)

    // AR(1) coefficient should be approximately 0.8
    let phi_ok = ar_abs(result.value.ar_coeffs[0] - 0.8) < 0.3

    phi_ok
}

fn test_auto_arima() -> bool with Mut, Div, Panic {
    var series: [f64; 500] = [0.0; 500]
    series[0] = 1.0
    var i: i64 = 1
    while i < 50 {
        series[i as usize] = 0.5 * series[(i - 1) as usize] + 0.1
        i = i + 1
    }

    let result = auto_arima(series, 50, 3, 1, 0)

    // Should select a low-order model
    result.p <= 3 && result.d <= 1
}
