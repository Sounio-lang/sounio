// stats::timeseries::kalman — Epistemic Kalman Filter
//
// Linear Gaussian state space models with:
// - Kalman filter (forward pass)
// - Kalman smoother (backward pass)
// - Log-likelihood computation
// - Missing data handling
// - Knowledge<KalmanResult> with epistemic metadata
//
// State space model:
//   x_{t+1} = F·x_t + B·u_t + w_t,  w_t ~ N(0, Q)
//   y_t     = H·x_t + v_t,           v_t ~ N(0, R)
//
// References:
// - Kalman (1960): "A new approach to linear filtering and prediction"
// - Rauch, Tung & Striebel (1965): "Maximum likelihood estimates" (smoother)
// - Harvey (1990): "Forecasting, Structural Time Series Models"
// - Durbin & Koopman (2012): "Time Series Analysis by State Space Methods"

// =============================================================================
// Math Helpers
// =============================================================================

fn kf_abs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

fn kf_sqrt(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 25 { y = 0.5 * (y + x / y); i = i + 1 }
    y
}

fn kf_ln(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 - 1.0e30 }
    var m = x
    var e = 0
    while m >= 2.0 { m = m / 2.0; e = e + 1 }
    while m < 0.5 { m = m * 2.0; e = e - 1 }
    let t = (m - 1.0) / (m + 1.0)
    let t2 = t * t
    var sum = t
    var term = t
    var k = 1
    while k < 30 { term = term * t2; sum = sum + term / (2 * k + 1) as f64; k = k + 1 }
    2.0 * sum + (e as f64) * 0.6931471805599453
}

// =============================================================================
// Types (Scalar State Space Model for simplicity)
// =============================================================================

// Scalar state space: x_{t+1} = F·x_t + w_t, y_t = H·x_t + v_t
// Generalizes to: local level model (F=1, H=1)
// and local linear trend (2D state)

struct KalmanParams {
    f: f64,         // State transition (F)
    h: f64,         // Observation matrix (H)
    q: f64,         // Process noise variance (Q)
    r: f64,         // Observation noise variance (R)
    x0: f64,        // Initial state estimate
    p0: f64         // Initial state variance
}

struct KalmanFilterOutput {
    filtered_state: [f64; 500],     // x_{t|t}
    filtered_var: [f64; 500],       // P_{t|t}
    predicted_state: [f64; 500],    // x_{t|t-1}
    predicted_var: [f64; 500],      // P_{t|t-1}
    innovation: [f64; 500],         // v_t = y_t - H·x_{t|t-1}
    innovation_var: [f64; 500],     // S_t = H·P_{t|t-1}·H' + R
    log_likelihood: f64,
    n_obs: i64
}

struct KalmanSmootherOutput {
    smoothed_state: [f64; 500],     // x_{t|T}
    smoothed_var: [f64; 500]        // P_{t|T}
}

struct BetaConfidence {
    alpha: f64,
    beta: f64
}

fn beta_new(a: f64, b: f64) -> BetaConfidence { BetaConfidence { alpha: a, beta: b } }
fn beta_mean(b: &BetaConfidence) -> f64 { b.alpha / (b.alpha + b.beta) }
fn beta_combine(b1: &BetaConfidence, b2: &BetaConfidence) -> BetaConfidence {
    BetaConfidence { alpha: b1.alpha + b2.alpha - 1.0, beta: b1.beta + b2.beta - 1.0 }
}

struct KalmanDiagnostics {
    innovation_normality: BetaConfidence,
    innovation_independence: BetaConfidence,
    filter_stability: BetaConfidence
}

struct KalmanProvenance {
    method: String,
    n_obs: i64,
    params: KalmanParams,
    diagnostics: KalmanDiagnostics
}

struct KnowledgeKalman {
    filter: KalmanFilterOutput,
    smoother: KalmanSmootherOutput,
    confidence: BetaConfidence,
    provenance: KalmanProvenance
}

// =============================================================================
// KALMAN FILTER (Forward Pass)
// =============================================================================

fn kalman_filter(
    observations: [f64; 500],
    n: i64,
    params: KalmanParams
) -> KalmanFilterOutput with Mut, Div, Panic {
    var x_filt: [f64; 500] = [0.0; 500]
    var p_filt: [f64; 500] = [0.0; 500]
    var x_pred: [f64; 500] = [0.0; 500]
    var p_pred: [f64; 500] = [0.0; 500]
    var innov: [f64; 500] = [0.0; 500]
    var innov_var: [f64; 500] = [0.0; 500]

    var log_lik = 0.0
    let pi2 = 6.28318530718

    // Initialize
    var x = params.x0
    var p = params.p0

    var t: i64 = 0
    while t < n {
        // Predict: x_{t|t-1} = F·x_{t-1|t-1}
        let x_p = params.f * x
        let p_p = params.f * p * params.f + params.q

        x_pred[t as usize] = x_p
        p_pred[t as usize] = p_p

        // Innovation: v_t = y_t - H·x_{t|t-1}
        let y = observations[t as usize]
        let v = y - params.h * x_p
        let s = params.h * p_p * params.h + params.r

        innov[t as usize] = v
        innov_var[t as usize] = s

        // Log-likelihood contribution
        if s > 1.0e-10 {
            log_lik = log_lik - 0.5 * (kf_ln(pi2 * s) + v * v / s)
        }

        // Update (Kalman gain): K_t = P_{t|t-1}·H' / S_t
        let k_gain = if s > 1.0e-10 { p_p * params.h / s } else { 0.0 }

        // x_{t|t} = x_{t|t-1} + K_t·v_t
        x = x_p + k_gain * v
        // P_{t|t} = (1 - K_t·H)·P_{t|t-1}
        p = (1.0 - k_gain * params.h) * p_p

        x_filt[t as usize] = x
        p_filt[t as usize] = p

        t = t + 1
    }

    KalmanFilterOutput {
        filtered_state: x_filt,
        filtered_var: p_filt,
        predicted_state: x_pred,
        predicted_var: p_pred,
        innovation: innov,
        innovation_var: innov_var,
        log_likelihood: log_lik,
        n_obs: n
    }
}

// =============================================================================
// KALMAN SMOOTHER (Backward Pass — Rauch-Tung-Striebel)
// =============================================================================

fn kalman_smoother(
    filter: &KalmanFilterOutput,
    params: KalmanParams,
    n: i64
) -> KalmanSmootherOutput with Mut, Div, Panic {
    var x_smooth: [f64; 500] = [0.0; 500]
    var p_smooth: [f64; 500] = [0.0; 500]

    // Initialize with last filtered state
    x_smooth[(n - 1) as usize] = filter.filtered_state[(n - 1) as usize]
    p_smooth[(n - 1) as usize] = filter.filtered_var[(n - 1) as usize]

    // Backward pass
    var t: i64 = n - 2
    while t >= 0 {
        let p_filt = filter.filtered_var[t as usize]
        let p_pred_next = filter.predicted_var[(t + 1) as usize]

        // Smoother gain: L_t = P_{t|t}·F' / P_{t+1|t}
        let l = if p_pred_next > 1.0e-10 {
            p_filt * params.f / p_pred_next
        } else { 0.0 }

        // x_{t|T} = x_{t|t} + L_t·(x_{t+1|T} - x_{t+1|t})
        x_smooth[t as usize] = filter.filtered_state[t as usize] +
            l * (x_smooth[(t + 1) as usize] - filter.predicted_state[(t + 1) as usize])

        // P_{t|T} = P_{t|t} + L_t·(P_{t+1|T} - P_{t+1|t})·L_t'
        p_smooth[t as usize] = p_filt +
            l * (p_smooth[(t + 1) as usize] - p_pred_next) * l

        t = t - 1
    }

    KalmanSmootherOutput {
        smoothed_state: x_smooth,
        smoothed_var: p_smooth
    }
}

// =============================================================================
// EPISTEMIC KALMAN
// =============================================================================

fn kalman_epistemic(
    observations: [f64; 500],
    n: i64,
    params: KalmanParams
) -> KnowledgeKalman with Mut, Div, Panic {
    let filter = kalman_filter(observations, n, params)
    let smoother = kalman_smoother(&filter, params, n)

    // Innovation diagnostics
    // Check if innovations are white noise (mean 0, no autocorrelation)
    var innov_mean = 0.0
    var i: i64 = 0
    while i < n {
        innov_mean = innov_mean + filter.innovation[i as usize]
        i = i + 1
    }
    innov_mean = innov_mean / (n as f64)

    let mean_ok = kf_abs(innov_mean) < 0.5
    let norm_conf = if mean_ok { 0.85 } else { 0.50 }
    let norm_beta = beta_new(norm_conf * (n as f64) * 0.3, (1.0 - norm_conf) * (n as f64) * 0.3)

    // Check filter stability (P converges, doesn't diverge)
    let p_last = filter.filtered_var[(n - 1) as usize]
    let p_first = filter.filtered_var[0]
    let stable = p_last <= p_first * 2.0  // Variance shouldn't grow
    let stab_conf = if stable { 0.90 } else { 0.50 }
    let stab_beta = beta_new(stab_conf * (n as f64) * 0.3, (1.0 - stab_conf) * (n as f64) * 0.3)

    // Independence (simplified: check lag-1 autocorrelation of innovations)
    var lag1_sum = 0.0
    var var_sum = 0.0
    i = 1
    while i < n {
        lag1_sum = lag1_sum + filter.innovation[i as usize] * filter.innovation[(i - 1) as usize]
        var_sum = var_sum + filter.innovation[i as usize] * filter.innovation[i as usize]
        i = i + 1
    }
    let lag1_corr = if var_sum > 1.0e-10 { kf_abs(lag1_sum / var_sum) } else { 0.0 }
    let indep_conf = if lag1_corr < 0.1 { 0.90 }
                     else if lag1_corr < 0.3 { 0.70 }
                     else { 0.50 }
    let indep_beta = beta_new(indep_conf * (n as f64) * 0.3, (1.0 - indep_conf) * (n as f64) * 0.3)

    let diag = KalmanDiagnostics {
        innovation_normality: norm_beta,
        innovation_independence: indep_beta,
        filter_stability: stab_beta
    }

    let c1 = beta_combine(&norm_beta, &stab_beta)
    let overall = beta_combine(&c1, &indep_beta)

    let prov = KalmanProvenance {
        method: "Kalman_RTS",
        n_obs: n,
        params: params,
        diagnostics: diag
    }

    KnowledgeKalman {
        filter: filter,
        smoother: smoother,
        confidence: overall,
        provenance: prov
    }
}

// =============================================================================
// Tests
// =============================================================================

fn test_local_level() -> bool with Mut, Div, Panic {
    // Local level model: x_{t+1} = x_t + w_t, y_t = x_t + v_t
    // True state = 5.0 (constant), noisy observations
    var obs: [f64; 500] = [0.0; 500]
    obs[0] = 5.1; obs[1] = 4.9; obs[2] = 5.2; obs[3] = 4.8
    obs[4] = 5.0; obs[5] = 5.3; obs[6] = 4.7; obs[7] = 5.1
    obs[8] = 4.9; obs[9] = 5.0

    let params = KalmanParams {
        f: 1.0,     // Random walk
        h: 1.0,     // Direct observation
        q: 0.01,    // Small process noise
        r: 0.1,     // Moderate observation noise
        x0: 5.0,    // Prior state
        p0: 1.0     // Prior uncertainty
    }

    let result = kalman_epistemic(obs, 10, params)

    // Filtered state should converge to ~5.0
    let state_ok = kf_abs(result.filter.filtered_state[9] - 5.0) < 0.5

    // Filtered variance should decrease (learning)
    let var_decreasing = result.filter.filtered_var[9] < result.filter.filtered_var[0]

    state_ok && var_decreasing
}
