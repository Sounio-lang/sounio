// Normal/Beta probability distributions backed by the checked canonical kernels.
// Constructors preserve parameter containers. Evaluation validates parameters.
// Scalar convenience calls fail closed when a value is invalid or unavailable;
// checked_distributions exposes status, availability, tails and work limits.
use stats::checked_distributions::{normal_density_checked,normal_tails_checked,normal_quantile_checked,beta_density_checked,beta_tails_checked,beta_quantile_checked}

pub struct NormalDist {mu:f64,sigma:f64}
pub struct BetaDist {alpha:f64,beta_param:f64}
pub fn normal_new(mu:f64,sigma:f64)->NormalDist {NormalDist{mu:mu,sigma:sigma}}
pub fn normal_standard()->NormalDist {normal_new(0.0,1.0)}
pub fn beta_dist_new(alpha:f64,beta_param:f64)->BetaDist {BetaDist{alpha:alpha,beta_param:beta_param}}

pub fn normal_pdf(dist:NormalDist,x:f64)->f64 with Mut,Div,Panic {
 let r=normal_density_checked(dist.mu,dist.sigma,x)
 assert(r.status==0 && r.value_available)
 r.value
}
pub fn normal_logpdf(dist:NormalDist,x:f64)->f64 with Mut,Div,Panic {
 let r=normal_density_checked(dist.mu,dist.sigma,x)
 assert(r.status==0 && r.log_available)
 r.log_value
}
pub fn normal_cdf(dist:NormalDist,x:f64)->f64 with Mut,Div,Panic {
 let r=normal_tails_checked(dist.mu,dist.sigma,x,2048,1.0e-12)
 assert(r.status==0 && r.cdf_available)
 r.cdf
}
pub fn normal_sf(dist:NormalDist,x:f64)->f64 with Mut,Div,Panic {
 let r=normal_tails_checked(dist.mu,dist.sigma,x,2048,1.0e-12)
 assert(r.status==0 && r.sf_available)
 r.sf
}
pub fn normal_logcdf(dist:NormalDist,x:f64)->f64 with Mut,Div,Panic {
 let r=normal_tails_checked(dist.mu,dist.sigma,x,2048,1.0e-12)
 assert(r.status==0 && r.log_cdf_available)
 r.log_cdf
}
pub fn normal_logsf(dist:NormalDist,x:f64)->f64 with Mut,Div,Panic {
 let r=normal_tails_checked(dist.mu,dist.sigma,x,2048,1.0e-12)
 assert(r.status==0 && r.log_sf_available)
 r.log_sf
}
pub fn normal_quantile(dist:NormalDist,p:f64)->f64 with Mut,Div,Panic {
 let r=normal_quantile_checked(dist.mu,dist.sigma,p,false,2048,1.0e-12)
 assert(r.status==0 && r.available)
 r.value
}
pub fn normal_isf(dist:NormalDist,p:f64)->f64 with Mut,Div,Panic {
 let r=normal_quantile_checked(dist.mu,dist.sigma,p,true,2048,1.0e-12)
 assert(r.status==0 && r.available)
 r.value
}
pub fn standard_normal_cdf(z:f64)->f64 with Mut,Div,Panic {normal_cdf(normal_standard(),z)}
pub fn inverse_standard_normal_cdf(p:f64)->f64 with Mut,Div,Panic {normal_quantile(normal_standard(),p)}

pub fn beta_pdf(dist:BetaDist,x:f64)->f64 with Mut,Div,Panic {
 let r=beta_density_checked(dist.alpha,dist.beta_param,x)
 assert(r.status==0 && r.value_available)
 r.value
}
pub fn beta_logpdf(dist:BetaDist,x:f64)->f64 with Mut,Div,Panic {
 let r=beta_density_checked(dist.alpha,dist.beta_param,x)
 assert(r.status==0 && r.log_available)
 r.log_value
}
pub fn beta_cdf(dist:BetaDist,x:f64)->f64 with Mut,Div,Panic {
 let r=beta_tails_checked(dist.alpha,dist.beta_param,x,2048,1.0e-12)
 assert(r.status==0 && r.cdf_available)
 r.cdf
}
pub fn beta_sf(dist:BetaDist,x:f64)->f64 with Mut,Div,Panic {
 let r=beta_tails_checked(dist.alpha,dist.beta_param,x,2048,1.0e-12)
 assert(r.status==0 && r.sf_available)
 r.sf
}
pub fn beta_logcdf(dist:BetaDist,x:f64)->f64 with Mut,Div,Panic {
 let r=beta_tails_checked(dist.alpha,dist.beta_param,x,2048,1.0e-12)
 assert(r.status==0 && r.log_cdf_available)
 r.log_cdf
}
pub fn beta_logsf(dist:BetaDist,x:f64)->f64 with Mut,Div,Panic {
 let r=beta_tails_checked(dist.alpha,dist.beta_param,x,2048,1.0e-12)
 assert(r.status==0 && r.log_sf_available)
 r.log_sf
}
pub fn beta_quantile(dist:BetaDist,p:f64)->f64 with Mut,Div,Panic {
 let r=beta_quantile_checked(dist.alpha,dist.beta_param,p,false,2048,1.0e-12)
 assert(r.status==0 && r.available)
 r.value
}
pub fn beta_isf(dist:BetaDist,p:f64)->f64 with Mut,Div,Panic {
 let r=beta_quantile_checked(dist.alpha,dist.beta_param,p,true,2048,1.0e-12)
 assert(r.status==0 && r.available)
 r.value
}
fn distribution_abs(x:f64)->f64 {if x<0.0 {-x}else{x}}
pub fn run_tests()->bool with Mut,Div,Panic {
 distribution_abs(normal_pdf(normal_standard(),0.0)-0.3989422804014327)<1.0e-12 &&
 normal_cdf(normal_standard(),0.0)==0.5 &&
 distribution_abs(inverse_standard_normal_cdf(0.975)-1.959963984540054)<1.0e-10 &&
 distribution_abs(beta_pdf(beta_dist_new(1.0,1.0),0.5)-1.0)<1.0e-12 &&
 distribution_abs(beta_pdf(beta_dist_new(2.0,2.0),0.5)-1.5)<1.0e-12
}
