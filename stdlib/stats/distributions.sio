// Probability Distributions
//
// Normal and Beta distributions with basic PDF/CDF/sampling.
// Self-contained math helpers (no extern dependencies).

// =============================================================================
// Math Helpers
// =============================================================================

fn dist_abs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

fn dist_sqrt(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 25 { y = 0.5 * (y + x / y); i = i + 1 }
    y
}

fn dist_exp(x: f64) -> f64 with Mut, Div, Panic {
    if x > 500.0 { return 1.0e200 }
    if x < -500.0 { return 0.0 }
    let ln2 = 0.6931471805599453
    var k_f = x / ln2
    var k: i32 = 0
    if k_f >= 0.0 { k = k_f as i32 } else { k = (k_f as i32) - 1 }
    let r = x - (k as f64) * ln2
    var sum = 1.0
    var term = 1.0
    var n = 1
    while n < 25 { term = term * r / (n as f64); sum = sum + term; n = n + 1 }
    var result = sum
    if k >= 0 { var i = 0; while i < k { result = result * 2.0; i = i + 1 } }
    else { var i = 0; while i < (0 - k) { result = result / 2.0; i = i + 1 } }
    result
}

fn dist_ln(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 - 1.0e30 }
    var m = x
    var e = 0
    while m >= 2.0 { m = m / 2.0; e = e + 1 }
    while m < 0.5 { m = m * 2.0; e = e - 1 }
    let t = (m - 1.0) / (m + 1.0)
    let t2 = t * t
    var sum = t
    var term = t
    var k = 1
    while k < 30 { term = term * t2; sum = sum + term / (2 * k + 1) as f64; k = k + 1 }
    2.0 * sum + (e as f64) * 0.6931471805599453
}

fn dist_cos(x: f64) -> f64 with Mut, Div, Panic {
    // Taylor series for cos(x)
    var sum = 1.0
    var term = 1.0
    var n = 1
    while n < 20 {
        term = 0.0 - term * x * x / ((2 * n - 1) * (2 * n)) as f64
        sum = sum + term
        n = n + 1
    }
    sum
}

fn dist_pi() -> f64 { 3.141592653589793 }
fn dist_sqrt_2pi() -> f64 { 2.5066282746310002 }
fn dist_ln_sqrt_2pi() -> f64 { 0.9189385332046727 }

// =============================================================================
// Normal Distribution
// =============================================================================

pub struct NormalDist {
    mu: f64,
    sigma: f64
}

pub fn normal_new(mu: f64, sigma: f64) -> NormalDist {
    NormalDist { mu: mu, sigma: sigma }
}

pub fn normal_standard() -> NormalDist {
    NormalDist { mu: 0.0, sigma: 1.0 }
}

pub fn standard_normal_cdf(z: f64) -> f64 with Mut, Div, Panic {
    let p = 0.3275911
    let a1 = 0.254829592
    let a2 = -0.284496736
    let a3 = 1.421413741
    let a4 = -1.453152027
    let a5 = 1.061405429

    // This is the A&S 7.1.26 rational approximation for erf(u); the normal
    // CDF is Phi(z) = 0.5*(1+erf(z/sqrt2)), so u = |z|/sqrt(2), not |z|.
    let abs_z = dist_abs(z) / 1.4142135623730951
    let t = 1.0 / (1.0 + p * abs_z)
    let t2 = t * t
    let t3 = t2 * t
    let t4 = t3 * t
    let t5 = t4 * t

    let exp_term = dist_exp(0.0 - abs_z * abs_z)
    let poly = a1 * t + a2 * t2 + a3 * t3 + a4 * t4 + a5 * t5
    let y = 1.0 - poly * exp_term

    let sign = if z < 0.0 { -1.0 } else { 1.0 }
    0.5 * (1.0 + sign * y)
}

pub fn normal_pdf(dist: NormalDist, x: f64) -> f64 with Mut, Div, Panic {
    let z = (x - dist.mu) / dist.sigma
    let arg = -0.5 * z * z
    let gauss = dist_exp(arg)
    gauss / (dist.sigma * dist_sqrt_2pi())
}

pub fn normal_cdf(dist: NormalDist, x: f64) -> f64 with Mut, Div, Panic {
    let z = (x - dist.mu) / dist.sigma
    standard_normal_cdf(z)
}

fn normal_sample(dist: NormalDist, u1: f64, u2: f64) -> f64 with Mut, Div, Panic {
    // Box-Muller transform
    let r = dist_sqrt(-2.0 * dist_ln(u1))
    let theta = 2.0 * dist_pi() * u2
    let phase = dist_cos(theta)
    dist.mu + dist.sigma * r * phase
}

// Inverse standard-normal CDF (quantile function, a.k.a. probit).
// Rational approximation of Peter J. Acklam (2003). Max abs error
// ~4.5e-9 on the open interval (0, 1); outside it returns a sentinel
// (-1e308 for p<=0, +1e308 for p>=1) rather than panicking, so BCa
// callers can clamp their tail samples.
pub fn inverse_standard_normal_cdf(p: f64) -> f64 with Mut, Div, Panic {
    if p <= 0.0 { return 0.0 - 1.0e308 }
    if p >= 1.0 { return 1.0e308 }

    let a1 = 0.0 - 39.69683028665376
    let a2 = 220.9460984245205
    let a3 = 0.0 - 275.9285104469687
    let a4 = 138.3577518672690
    let a5 = 0.0 - 30.66479806614716
    let a6 = 2.506628277153436

    let b1 = 0.0 - 54.47609879822406
    let b2 = 161.5858368580409
    let b3 = 0.0 - 155.6989798598866
    let b4 = 66.80131188771972
    let b5 = 0.0 - 13.28068155288572

    let c1 = 0.0 - 0.007784894002430293
    let c2 = 0.0 - 0.3223964580411365
    let c3 = 0.0 - 2.400758277161838
    let c4 = 0.0 - 2.549732539343734
    let c5 = 4.374664141464968
    let c6 = 2.938163982698783

    let d1 = 0.007784695709041462
    let d2 = 0.3224671290700398
    let d3 = 2.445134137142996
    let d4 = 3.754408661907416

    let p_low = 0.02425
    let p_high = 1.0 - p_low

    if p < p_low {
        let q = dist_sqrt(0.0 - 2.0 * dist_ln(p))
        let num = (((((c1 * q + c2) * q + c3) * q + c4) * q + c5) * q + c6)
        let den = ((((d1 * q + d2) * q + d3) * q + d4) * q + 1.0)
        return num / den
    }
    if p > p_high {
        let q = dist_sqrt(0.0 - 2.0 * dist_ln(1.0 - p))
        let num = (((((c1 * q + c2) * q + c3) * q + c4) * q + c5) * q + c6)
        let den = ((((d1 * q + d2) * q + d3) * q + d4) * q + 1.0)
        return 0.0 - num / den
    }
    let q = p - 0.5
    let r = q * q
    let num = (((((a1 * r + a2) * r + a3) * r + a4) * r + a5) * r + a6) * q
    let den = (((((b1 * r + b2) * r + b3) * r + b4) * r + b5) * r + 1.0)
    num / den
}

// =============================================================================
// Beta Distribution
// =============================================================================

pub struct BetaDist {
    alpha: f64,
    beta_param: f64
}

pub fn beta_dist_new(alpha: f64, beta_param: f64) -> BetaDist {
    BetaDist { alpha: alpha, beta_param: beta_param }
}

fn beta_dist_mean(d: BetaDist) -> f64 with Div, Panic {
    d.alpha / (d.alpha + d.beta_param)
}

fn beta_dist_variance(d: BetaDist) -> f64 with Div, Panic {
    let sum_ab = d.alpha + d.beta_param
    let num = d.alpha * d.beta_param
    num / (sum_ab * sum_ab * (sum_ab + 1.0))
}

fn lgamma_stirling(nf: f64) -> f64 with Mut, Div, Panic {
    let ln_sqrt_2pi = dist_ln_sqrt_2pi()
    let term1 = ln_sqrt_2pi + (nf + 0.5) * dist_ln(nf)
    let term2 = 1.0 / (12.0 * nf)
    term1 - nf + term2
}

fn betaln(a: f64, b: f64) -> f64 with Mut, Div, Panic {
    lgamma_stirling(a) + lgamma_stirling(b) - lgamma_stirling(a + b)
}

pub fn beta_pdf(dist: BetaDist, x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 || x >= 1.0 {
        0.0
    } else {
        let ln_x = dist_ln(x)
        let ln_1mx = dist_ln(1.0 - x)
        let alpha_m1 = dist.alpha - 1.0
        let beta_m1 = dist.beta_param - 1.0
        let lnum = alpha_m1 * ln_x + beta_m1 * ln_1mx
        let lden = betaln(dist.alpha, dist.beta_param)
        dist_exp(lnum - lden)
    }
}

fn beta_cdf(dist: BetaDist, x: f64) -> f64 with Mut, Div, Panic {
    // Normal approximation for CDF
    let m = beta_dist_mean(dist)
    let s = dist_sqrt(beta_dist_variance(dist))
    let z = (x - m) / s
    standard_normal_cdf(z)
}

// =============================================================================
// Tests
// =============================================================================

fn approx_eq(a: f64, b: f64) -> f64 {
    dist_abs(a - b)
}

fn test_normal_pdf() -> bool with Mut, Div, Panic {
    let dist = normal_standard()
    let pdf0 = normal_pdf(dist, 0.0)
    approx_eq(pdf0, 0.3989) < 0.001
}

fn test_normal_cdf() -> bool with Mut, Div, Panic {
    let dist = normal_standard()
    let cdf0 = normal_cdf(dist, 0.0)
    approx_eq(cdf0, 0.5) < 0.001
}

fn test_inverse_normal_cdf() -> bool with Mut, Div, Panic {
    let q50 = inverse_standard_normal_cdf(0.5)
    let q975 = inverse_standard_normal_cdf(0.975)
    let q025 = inverse_standard_normal_cdf(0.025)
    let ok_median = approx_eq(q50, 0.0) < 1.0e-6
    let ok_upper = approx_eq(q975, 1.959963984540054) < 1.0e-6
    let ok_lower = approx_eq(q025, 0.0 - 1.959963984540054) < 1.0e-6
    ok_median && ok_upper && ok_lower
}

fn test_beta_pdf() -> bool with Mut, Div, Panic {
    let dist = beta_dist_new(2.0, 2.0)
    let pdf05 = beta_pdf(dist, 0.5)
    approx_eq(pdf05, 1.5) < 0.01
}

fn run_distribution_tests() -> bool with Mut, Div, Panic {
    test_normal_pdf() && test_normal_cdf() && test_inverse_normal_cdf() && test_beta_pdf()
}

pub fn run_tests() -> bool with Mut, Div, Panic {
    run_distribution_tests()
}
