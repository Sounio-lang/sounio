//! Probability Distributions
//!
//! Common probability distributions with PDF, CDF, quantile, and sampling functions.
//!
//! # Distributions
//! - Normal (Gaussian)
//! - Uniform
//! - Exponential
//! - Poisson
//! - Binomial
//! - Student's t
//! - Chi-squared
//!
//! # References
//! - Abramowitz and Stegun: Handbook of Mathematical Functions
//! - NIST Digital Library of Mathematical Functions

extern "C" {
    fn sqrt(x: f64) -> f64;
    fn log(x: f64) -> f64;
    fn exp(x: f64) -> f64;
    fn pow(x: f64, y: f64) -> f64;
    fn fabs(x: f64) -> f64;
    fn sin(x: f64) -> f64;
    fn cos(x: f64) -> f64;
    fn floor(x: f64) -> f64;
}

// Mathematical constants
const PI: f64 = 3.141592653589793
const E: f64 = 2.718281828459045
const SQRT_2: f64 = 1.4142135623730951
const SQRT_2PI: f64 = 2.5066282746310002
const LN_SQRT_2PI: f64 = 0.9189385332046727

// =============================================================================
// Normal (Gaussian) Distribution
// =============================================================================

// Normal (Gaussian) distribution with mean mu and standard deviation sigma.
pub struct NormalDist {
    mu: f64,
    sigma: f64,
}

impl NormalDist {
    /// Create a standard normal distribution (mu=0, sigma=1).
    pub fn standard() -> NormalDist {
        NormalDist { mu: 0.0, sigma: 1.0 }
    }

    /// Create a normal distribution with given mean and standard deviation.
    pub fn new(mu: f64, sigma: f64) -> NormalDist with Panic {
        if sigma <= 0.0 {
            panic("Normal distribution sigma must be positive")
        }
        NormalDist { mu, sigma }
    }

    /// Mean of the distribution.
    pub fn mean(self: &NormalDist) -> f64 {
        self.mu
    }

    /// Standard deviation of the distribution.
    pub fn std_dev(self: &NormalDist) -> f64 {
        self.sigma
    }

    /// Variance of the distribution.
    pub fn variance(self: &NormalDist) -> f64 {
        self.sigma * self.sigma
    }
}

// Probability density function for normal distribution.
pub fn normal_pdf(d: &NormalDist, x: f64) -> f64 {
    let z = (x - d.mu) / d.sigma
    exp(-0.5 * z * z) / (d.sigma * SQRT_2PI)
}

// Cumulative distribution function for normal distribution.
//
// Uses Abramowitz and Stegun approximation (7.1.26).
pub fn normal_cdf(d: &NormalDist, x: f64) -> f64 {
    let z = (x - d.mu) / d.sigma
    standard_normal_cdf(z)
}

// Standard normal CDF (mu=0, sigma=1).
fn standard_normal_cdf(z: f64) -> f64 {
    // Abramowitz and Stegun approximation
    let a1 = 0.254829592
    let a2 = -0.284496736
    let a3 = 1.421413741
    let a4 = -1.453152027
    let a5 = 1.061405429
    let p = 0.3275911

    let sign = if z < 0.0 { -1.0 } else { 1.0 }
    let x = fabs(z) / SQRT_2

    let t = 1.0 / (1.0 + p * x)
    let t2 = t * t
    let t3 = t2 * t
    let t4 = t3 * t
    let t5 = t4 * t

    let y = 1.0 - (a1 * t + a2 * t2 + a3 * t3 + a4 * t4 + a5 * t5) * exp(-x * x)

    0.5 * (1.0 + sign * y)
}

// Quantile function (inverse CDF) for normal distribution.
//
// Uses Acklam's algorithm for rational approximation.
pub fn normal_quantile(d: &NormalDist, p: f64) -> f64 with Panic {
    if p <= 0.0 || p >= 1.0 {
        panic("Quantile p must be in (0, 1)")
    }
    d.mu + d.sigma * standard_normal_quantile(p)
}

// Standard normal quantile (Acklam's algorithm).
fn standard_normal_quantile(p: f64) -> f64 {
    // Coefficients for rational approximation
    let a1 = -3.969683028665376e+01
    let a2 = 2.209460984245205e+02
    let a3 = -2.759285104469687e+02
    let a4 = 1.383577518672690e+02
    let a5 = -3.066479806614716e+01
    let a6 = 2.506628277459239e+00

    let b1 = -5.447609879822406e+01
    let b2 = 1.615858368580409e+02
    let b3 = -1.556989798598866e+02
    let b4 = 6.680131188771972e+01
    let b5 = -1.328068155288572e+01

    let c1 = -7.784894002430293e-03
    let c2 = -3.223964580411365e-01
    let c3 = -2.400758277161838e+00
    let c4 = -2.549732539343734e+00
    let c5 = 4.374664141464968e+00
    let c6 = 2.938163982698783e+00

    let d1 = 7.784695709041462e-03
    let d2 = 3.224671290700398e-01
    let d3 = 2.445134137142996e+00
    let d4 = 3.754408661907416e+00

    let p_low = 0.02425
    let p_high = 1.0 - p_low

    if p < p_low {
        let q = sqrt(-2.0 * log(p))
        (c1 * q + c2 + (c3 + (c4 + (c5 + c6 * q) * q) * q) * q) /
        (1.0 + (d1 + (d2 + (d3 + d4 * q) * q) * q) * q)
    } else if p <= p_high {
        let q = p - 0.5
        let r = q * q
        (a1 + (a2 + (a3 + (a4 + (a5 + a6 * r) * r) * r) * r) * r) * q /
        (1.0 + (b1 + (b2 + (b3 + (b4 + b5 * r) * r) * r) * r) * r)
    } else {
        let q = sqrt(-2.0 * log(1.0 - p))
        -(c1 * q + c2 + (c3 + (c4 + (c5 + c6 * q) * q) * q) * q) /
        (1.0 + (d1 + (d2 + (d3 + d4 * q) * q) * q) * q)
    }
}

// Generate a random sample from normal distribution using Box-Muller.
pub fn normal_sample(d: &NormalDist, u1: f64, u2: f64) -> f64 {
    // Box-Muller transform
    let z = sqrt(-2.0 * log(u1)) * cos(2.0 * PI * u2)
    d.mu + d.sigma * z
}

// =============================================================================
// Uniform Distribution
// =============================================================================

// Continuous uniform distribution over [a, b].
pub struct UniformDist {
    a: f64,
    b: f64,
}

impl UniformDist {
    /// Create a uniform distribution over [0, 1].
    pub fn standard() -> UniformDist {
        UniformDist { a: 0.0, b: 1.0 }
    }

    /// Create a uniform distribution over [a, b].
    pub fn new(a: f64, b: f64) -> UniformDist with Panic {
        if a >= b {
            panic("Uniform distribution requires a < b")
        }
        UniformDist { a, b }
    }

    /// Mean of the distribution.
    pub fn mean(self: &UniformDist) -> f64 {
        (self.a + self.b) / 2.0
    }

    /// Variance of the distribution.
    pub fn variance(self: &UniformDist) -> f64 {
        let range = self.b - self.a
        range * range / 12.0
    }
}

// PDF for uniform distribution.
pub fn uniform_pdf(d: &UniformDist, x: f64) -> f64 {
    if x < d.a || x > d.b {
        0.0
    } else {
        1.0 / (d.b - d.a)
    }
}

// CDF for uniform distribution.
pub fn uniform_cdf(d: &UniformDist, x: f64) -> f64 {
    if x < d.a {
        0.0
    } else if x > d.b {
        1.0
    } else {
        (x - d.a) / (d.b - d.a)
    }
}

// Quantile for uniform distribution.
pub fn uniform_quantile(d: &UniformDist, p: f64) -> f64 with Panic {
    if p < 0.0 || p > 1.0 {
        panic("Quantile p must be in [0, 1]")
    }
    d.a + p * (d.b - d.a)
}

// Sample from uniform distribution.
pub fn uniform_sample(d: &UniformDist, u: f64) -> f64 {
    d.a + u * (d.b - d.a)
}

// =============================================================================
// Exponential Distribution
// =============================================================================

// Exponential distribution with rate parameter lambda.
pub struct ExponentialDist {
    lambda: f64,
}

impl ExponentialDist {
    /// Create an exponential distribution with rate lambda.
    pub fn new(lambda: f64) -> ExponentialDist with Panic {
        if lambda <= 0.0 {
            panic("Exponential distribution lambda must be positive")
        }
        ExponentialDist { lambda }
    }

    /// Mean of the distribution (1/lambda).
    pub fn mean(self: &ExponentialDist) -> f64 {
        1.0 / self.lambda
    }

    /// Variance of the distribution (1/lambda^2).
    pub fn variance(self: &ExponentialDist) -> f64 {
        1.0 / (self.lambda * self.lambda)
    }
}

// PDF for exponential distribution.
pub fn exponential_pdf(d: &ExponentialDist, x: f64) -> f64 {
    if x < 0.0 {
        0.0
    } else {
        d.lambda * exp(-d.lambda * x)
    }
}

// CDF for exponential distribution.
pub fn exponential_cdf(d: &ExponentialDist, x: f64) -> f64 {
    if x < 0.0 {
        0.0
    } else {
        1.0 - exp(-d.lambda * x)
    }
}

// Quantile for exponential distribution.
pub fn exponential_quantile(d: &ExponentialDist, p: f64) -> f64 with Panic {
    if p < 0.0 || p >= 1.0 {
        panic("Quantile p must be in [0, 1)")
    }
    -log(1.0 - p) / d.lambda
}

// Sample from exponential distribution using inverse transform.
pub fn exponential_sample(d: &ExponentialDist, u: f64) -> f64 {
    -log(1.0 - u) / d.lambda
}

// =============================================================================
// Poisson Distribution
// =============================================================================

// Poisson distribution with rate parameter lambda.
pub struct PoissonDist {
    lambda: f64,
}

impl PoissonDist {
    /// Create a Poisson distribution with rate lambda.
    pub fn new(lambda: f64) -> PoissonDist with Panic {
        if lambda <= 0.0 {
            panic("Poisson distribution lambda must be positive")
        }
        PoissonDist { lambda }
    }

    /// Mean of the distribution (lambda).
    pub fn mean(self: &PoissonDist) -> f64 {
        self.lambda
    }

    /// Variance of the distribution (lambda).
    pub fn variance(self: &PoissonDist) -> f64 {
        self.lambda
    }
}

// Probability mass function for Poisson distribution.
//
// P(X = k) = (lambda^k * e^(-lambda)) / k!
pub fn poisson_pmf(d: &PoissonDist, k: i64) -> f64 {
    if k < 0 {
        return 0.0
    }

    // Use log to avoid overflow: log(P) = k*log(lambda) - lambda - log(k!)
    let log_p = (k as f64) * log(d.lambda) - d.lambda - log_factorial(k)
    exp(log_p)
}

// CDF for Poisson distribution.
pub fn poisson_cdf(d: &PoissonDist, k: i64) -> f64 {
    if k < 0 {
        return 0.0
    }

    var sum = 0.0
    var i: i64 = 0
    while i <= k {
        sum = sum + poisson_pmf(d, i)
        i = i + 1
    }
    sum
}

// Log of factorial using Stirling's approximation for large n.
fn log_factorial(n: i64) -> f64 {
    if n <= 1 {
        return 0.0
    }

    if n <= 20 {
        // Direct computation for small n
        var result = 0.0
        var i: i64 = 2
        while i <= n {
            result = result + log(i as f64)
            i = i + 1
        }
        result
    } else {
        // Stirling's approximation
        let nf = n as f64
        LN_SQRT_2PI + (nf + 0.5) * log(nf) - nf + 1.0 / (12.0 * nf)
    }
}

// =============================================================================
// Binomial Distribution
// =============================================================================

// Binomial distribution with n trials and success probability p.
pub struct BinomialDist {
    n: i64,
    p: f64,
}

impl BinomialDist {
    /// Create a binomial distribution.
    pub fn new(n: i64, p: f64) -> BinomialDist with Panic {
        if n < 0 {
            panic("Binomial n must be non-negative")
        }
        if p < 0.0 || p > 1.0 {
            panic("Binomial p must be in [0, 1]")
        }
        BinomialDist { n, p }
    }

    /// Mean of the distribution (n*p).
    pub fn mean(self: &BinomialDist) -> f64 {
        (self.n as f64) * self.p
    }

    /// Variance of the distribution (n*p*(1-p)).
    pub fn variance(self: &BinomialDist) -> f64 {
        (self.n as f64) * self.p * (1.0 - self.p)
    }
}

// PMF for binomial distribution.
//
// P(X = k) = C(n,k) * p^k * (1-p)^(n-k)
pub fn binomial_pmf(d: &BinomialDist, k: i64) -> f64 {
    if k < 0 || k > d.n {
        return 0.0
    }

    // Use log to avoid overflow
    let log_p = log_binomial_coeff(d.n, k) +
                (k as f64) * log(d.p) +
                ((d.n - k) as f64) * log(1.0 - d.p)
    exp(log_p)
}

// CDF for binomial distribution.
pub fn binomial_cdf(d: &BinomialDist, k: i64) -> f64 {
    if k < 0 {
        return 0.0
    }
    if k >= d.n {
        return 1.0
    }

    var sum = 0.0
    var i: i64 = 0
    while i <= k {
        sum = sum + binomial_pmf(d, i)
        i = i + 1
    }
    sum
}

// Log of binomial coefficient C(n, k).
fn log_binomial_coeff(n: i64, k: i64) -> f64 {
    log_factorial(n) - log_factorial(k) - log_factorial(n - k)
}

// =============================================================================
// Student's t Distribution
// =============================================================================

// Student's t distribution with nu degrees of freedom.
pub struct StudentTDist {
    nu: f64,
}

impl StudentTDist {
    /// Create a Student's t distribution.
    pub fn new(nu: f64) -> StudentTDist with Panic {
        if nu <= 0.0 {
            panic("Student's t nu must be positive")
        }
        StudentTDist { nu }
    }

    /// Mean (0 for nu > 1, undefined otherwise).
    pub fn mean(self: &StudentTDist) -> f64 {
        if self.nu > 1.0 { 0.0 } else { 0.0 / 0.0 }  // NaN for nu <= 1
    }

    /// Variance (nu/(nu-2) for nu > 2).
    pub fn variance(self: &StudentTDist) -> f64 {
        if self.nu > 2.0 {
            self.nu / (self.nu - 2.0)
        } else {
            0.0 / 0.0  // NaN or infinity
        }
    }
}

// PDF for Student's t distribution.
pub fn student_t_pdf(d: &StudentTDist, x: f64) -> f64 {
    let nu = d.nu
    let coeff = gamma_func((nu + 1.0) / 2.0) / (sqrt(nu * PI) * gamma_func(nu / 2.0))
    coeff * pow(1.0 + x * x / nu, -(nu + 1.0) / 2.0)
}

// Gamma function approximation (Lanczos).
fn gamma_func(z: f64) -> f64 {
    // Lanczos approximation coefficients
    let g = 7.0
    let c: [f64; 9] = [
        0.99999999999980993,
        676.5203681218851,
        -1259.1392167224028,
        771.32342877765313,
        -176.61502916214059,
        12.507343278686905,
        -0.13857109526572012,
        9.9843695780195716e-6,
        1.5056327351493116e-7
    ]

    if z < 0.5 {
        // Reflection formula
        PI / (sin(PI * z) * gamma_func(1.0 - z))
    } else {
        let z = z - 1.0
        var x = c[0]
        var i: usize = 1
        while i < 9 {
            x = x + c[i] / (z + (i as f64))
            i = i + 1
        }
        let t = z + g + 0.5
        SQRT_2PI * pow(t, z + 0.5) * exp(-t) * x
    }
}

// =============================================================================
// Chi-Squared Distribution
// =============================================================================

// Chi-squared distribution with k degrees of freedom.
pub struct ChiSquaredDist {
    k: f64,
}

impl ChiSquaredDist {
    /// Create a chi-squared distribution.
    pub fn new(k: f64) -> ChiSquaredDist with Panic {
        if k <= 0.0 {
            panic("Chi-squared k must be positive")
        }
        ChiSquaredDist { k }
    }

    /// Mean of the distribution (k).
    pub fn mean(self: &ChiSquaredDist) -> f64 {
        self.k
    }

    /// Variance of the distribution (2k).
    pub fn variance(self: &ChiSquaredDist) -> f64 {
        2.0 * self.k
    }
}

// PDF for chi-squared distribution.
pub fn chi_squared_pdf(d: &ChiSquaredDist, x: f64) -> f64 {
    if x < 0.0 {
        return 0.0
    }

    let k = d.k
    let half_k = k / 2.0
    pow(x, half_k - 1.0) * exp(-x / 2.0) / (pow(2.0, half_k) * gamma_func(half_k))
}

// =============================================================================
// Convenience Functions
// =============================================================================

// Standard normal PDF (convenience function).
pub fn std_normal_pdf(x: f64) -> f64 {
    exp(-0.5 * x * x) / SQRT_2PI
}

// Standard normal CDF (convenience function).
pub fn std_normal_cdf(x: f64) -> f64 {
    standard_normal_cdf(x)
}

// Standard normal quantile (convenience function).
pub fn std_normal_quantile(p: f64) -> f64 with Panic {
    if p <= 0.0 || p >= 1.0 {
        panic("Quantile p must be in (0, 1)")
    }
    standard_normal_quantile(p)
}

// =============================================================================
// Tests
// =============================================================================

fn test_normal() -> bool {
    let d = NormalDist::standard()

    // PDF at 0 should be 1/sqrt(2*pi) ≈ 0.3989
    let pdf0 = normal_pdf(&d, 0.0)
    if fabs(pdf0 - 0.3989) > 0.001 { return false }

    // CDF at 0 should be 0.5
    let cdf0 = normal_cdf(&d, 0.0)
    if fabs(cdf0 - 0.5) > 0.001 { return false }

    // Quantile of 0.5 should be 0
    let q50 = normal_quantile(&d, 0.5)
    if fabs(q50) > 0.001 { return false }

    true
}

fn test_uniform() -> bool {
    let d = UniformDist::new(0.0, 10.0)

    // Mean should be 5
    if fabs(d.mean() - 5.0) > 0.001 { return false }

    // CDF at 5 should be 0.5
    let cdf5 = uniform_cdf(&d, 5.0)
    if fabs(cdf5 - 0.5) > 0.001 { return false }

    // Quantile of 0.5 should be 5
    let q50 = uniform_quantile(&d, 0.5)
    if fabs(q50 - 5.0) > 0.001 { return false }

    true
}

fn test_exponential() -> bool {
    let d = ExponentialDist::new(1.0)

    // Mean should be 1
    if fabs(d.mean() - 1.0) > 0.001 { return false }

    // CDF at 1 should be 1 - e^(-1) ≈ 0.632
    let cdf1 = exponential_cdf(&d, 1.0)
    if fabs(cdf1 - 0.632) > 0.001 { return false }

    true
}

fn test_poisson() -> bool {
    let d = PoissonDist::new(5.0)

    // Mean should be lambda
    if fabs(d.mean() - 5.0) > 0.001 { return false }

    // P(X=5) for Poisson(5) should be approximately 0.175
    let p5 = poisson_pmf(&d, 5)
    if fabs(p5 - 0.175) > 0.01 { return false }

    true
}

fn test_binomial() -> bool {
    let d = BinomialDist::new(10, 0.5)

    // Mean should be n*p = 5
    if fabs(d.mean() - 5.0) > 0.001 { return false }

    // P(X=5) for Binomial(10, 0.5) should be approximately 0.246
    let p5 = binomial_pmf(&d, 5)
    if fabs(p5 - 0.246) > 0.01 { return false }

    true
}

pub fn run_tests() -> bool {
    test_normal() &&
    test_uniform() &&
    test_exponential() &&
    test_poisson() &&
    test_binomial()
}
