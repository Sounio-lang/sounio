// Seeded percentile bootstrap for the mean. See RESAMPLING.md.
module stats::bootstrap
use math::pure::{sqrt, is_finite}
use stats::bca_normal::{bca_normal_cdf,bca_normal_quantile}

pub struct BootResult {
    pub mean: f64,
    pub se: f64,
    pub lo: f64,
    pub hi: f64,
    pub b: i64,
    pub status: i64, // 0 available; 1 size/budget; 2 confidence; 3 data; 4 arithmetic
    pub seed_used: i64,
}

fn bs_empty(status: i64) -> BootResult {
    BootResult { mean: 0.0, se: 0.0, lo: 0.0, hi: 0.0, b: 0, status: status, seed_used: 0 }
}


pub struct BcaResult {
    pub mean:f64, pub se:f64, pub lo:f64, pub hi:f64,
    pub b:i64, pub status:i64, pub seed_used:i64,
    pub bias_p:f64, pub z0:f64, pub acceleration:f64,
    pub lower_p:f64, pub upper_p:f64,
    pub less_count:i64, pub equal_count:i64, pub tail_resolved:bool,
}
fn bca_empty(status:i64)->BcaResult {
    BcaResult{mean:0.0,se:0.0,lo:0.0,hi:0.0,b:0,status:status,seed_used:0,
        bias_p:0.0,z0:0.0,acceleration:0.0,lower_p:0.0,upper_p:0.0,
        less_count:0,equal_count:0,tail_resolved:false}
}
fn bs_coordinate(v:f64,scale:f64,anchor:f64,centered:bool)->f64 with Div {
    if !centered {return v/scale}
    let delta=v-anchor
    if is_finite(delta) {delta/scale}else{v/scale-anchor/scale}
}
fn bs_restore(v:f64,scale:f64,anchor:f64)->f64 with Div {
    let delta=v*scale
    let direct=anchor+delta
    if is_finite(delta) && is_finite(direct) {direct}else{(anchor/scale+v)*scale}
}

// MINSTD integer product is bounded by 36092757638322, safely within i64.
fn bs_next(state: i64) -> i64 with Div {
    (16807 * state) % 2147483647
}

// In-place heapsort: O(b log b), constant auxiliary storage.
fn bs_sort(values: &![f64; 1024], n: i64) with Mut, Div, Panic {
    var start = n / 2
    var end = n
    while end > 1 {
        var root: i64 = 0
        if start > 0 {
            start = start - 1
            root = start
        } else {
            end = end - 1
            let tmp = values[end as usize]
            values[end as usize] = values[0]
            values[0] = tmp
        }
        var active = true
        while active {
            var child = root * 2 + 1
            if child >= end { active = false }
            else {
                if child + 1 < end {
                    if values[child as usize] < values[(child + 1) as usize] { child = child + 1 }
                }
                if values[root as usize] < values[child as usize] {
                    let tmp = values[root as usize]
                    values[root as usize] = values[child as usize]
                    values[child as usize] = tmp
                    root = child
                } else { active = false }
            }
        }
    }
}

fn bs_quantile(values: &[f64; 1024], n: i64, p: f64) -> f64 with Div, Panic {
    let h = ((n - 1) as f64) * p
    let k = h as i64
    if k >= n - 1 { return values[(n - 1) as usize] }
    let f = h - (k as f64)
    values[k as usize] * (1.0 - f) + values[(k + 1) as usize] * f
}

/// Percentile interval (type-7 empirical quantiles), sample SD of bootstrap means.
/// n=2..256; b=2..1024; 0<conf<1. Invalid requests return an explicit status.
/// Seed modulo 2147483647; shift nonpositive by 2147483646, then repair zero.
/// No sample copy or heap allocation. Caller data is borrowed and never changed.
fn bs_mean_core(x: &[f64; 256], n: i32, b: i32, conf: f64, seed: i64, use_bca:bool) -> BcaResult with Mut, Div, Panic {
    if n < 2 || n > 256 || b < 2 || b > 1024 { return bca_empty(1) }
    if !is_finite(conf) || conf <= 0.0 || conf >= 1.0 { return bca_empty(2) }
    if use_bca && (1.0-conf)*0.5 < 1.0e-6 {return bca_empty(7)}
    let anchor=if use_bca {x[0]}else{0.0}
    var scale = 0.0
    var i: i32 = 0
    while i < n {
        let v = x[i as usize]
        if !is_finite(v) { return bca_empty(3) }
        let a = if v < 0.0 { 0.0 - v } else { v }
        if a > scale { scale = a }
        i = i + 1
    }
    var state = seed % 2147483647
    if state <= 0 { state = state + 2147483646 }
    if state <= 0 { state = 2147483646 }
    let initial = state
    if scale == 0.0 {
        if use_bca {return bca_empty(5)}
        return BcaResult{mean:0.0,se:0.0,lo:0.0,hi:0.0,b:b as i64,status:0,seed_used:initial,
            bias_p:0.0,z0:0.0,acceleration:0.0,lower_p:0.0,upper_p:0.0,less_count:0,equal_count:0,tail_resolved:false}
    }
    // Kahan sums in normalized coordinates; each input in [-1,1].
    var total = 0.0
    var correction = 0.0
    i = 0
    while i < n {
        let term = bs_coordinate(x[i as usize],scale,anchor,use_bca) - correction
        let next = total + term
        correction = (next - total) - term
        total = next
        i = i + 1
    }
    let point = total / (n as f64)
    var spread=0.0
    var acceleration=0.0
    if use_bca {
        i=0
        while i<n {
            let d=bs_coordinate(x[i as usize],scale,anchor,true)-point
            let a=if d<0.0 {0.0-d}else{d}
            if a>spread {spread=a}
            i=i+1
        }
        if spread == 0.0 {return bca_empty(5)}
        var s2=0.0
        var c2=0.0
        var s3=0.0
        var c3=0.0
        i=0
        while i<n {
            let d=(bs_coordinate(x[i as usize],scale,anchor,true)-point)/spread
            let v2=d*d-c2
            let next2=s2+v2
            c2=(next2-s2)-v2
            s2=next2
            let v3=d*d*d-c3
            let next3=s3+v3
            c3=(next3-s3)-v3
            s3=next3
            i=i+1
        }
        acceleration=s3/(6.0*s2*sqrt(s2))
    }
    var means: [f64; 1024] = [0.0; 1024]
    let nn = n as i64
    let limit = (2147483646 / nn) * nn
    var rep: i32 = 0
    var center = 0.0
    var m2 = 0.0
    while rep < b {
        var acc = 0.0
        var comp = 0.0
        i = 0
        while i < n {
            state = bs_next(state)
            var draw = state - 1
            while draw >= limit { state = bs_next(state); draw = state - 1 }
            let idx = draw % nn
            let term = bs_coordinate(x[idx as usize],scale,anchor,use_bca) - comp
            let next = acc + term
            comp = (next - acc) - term
            acc = next
            i = i + 1
        }
        let value = acc / (n as f64)
        means[rep as usize] = value
        let delta = value - center
        center = center + delta / ((rep + 1) as f64)
        m2 = m2 + delta * (value - center)
        rep = rep + 1
    }
    let se = sqrt(m2 / ((b - 1) as f64)) * scale
    var lower_p=(1.0-conf)*0.5
    var upper_p=1.0-lower_p
    var bias_p=0.0
    var z0=0.0
    var less:i64=0
    var equal:i64=0
    var resolved=false
    if use_bca {
        if m2<=0.0 {return bca_empty(5)}
        let tie=1.4210854715202004e-14*spread
        rep=0
        while rep<b {
            let d=means[rep as usize]-point
            if d < 0.0-tie {less=less+1}
            else if d <= tie {equal=equal+1}
            rep=rep+1
        }
        bias_p=((less as f64)+0.5*(equal as f64))/(b as f64)
        if bias_p<=0.0 || bias_p>=1.0 {return bca_empty(6)}
        let bias=bca_normal_quantile(bias_p)
        let zl=bca_normal_quantile(lower_p)
        let zu=bca_normal_quantile(upper_p)
        if bias.status!=0 || zl.status!=0 || zu.status!=0 {return bca_empty(7)}
        z0=bias.value
        let dl=1.0-acceleration*(z0+zl.value)
        let du=1.0-acceleration*(z0+zu.value)
        if dl<=0.0 || du<=0.0 {return bca_empty(7)}
        let pl=bca_normal_cdf(z0+(z0+zl.value)/dl)
        let pu=bca_normal_cdf(z0+(z0+zu.value)/du)
        if pl.status!=0 || pu.status!=0 {return bca_empty(7)}
        lower_p=pl.value
        upper_p=pu.value
        if !is_finite(lower_p) || !is_finite(upper_p) || lower_p<=0.0 || upper_p>=1.0 || lower_p>=upper_p {return bca_empty(7)}
        resolved=lower_p*(b as f64)>=1.0 && (1.0-upper_p)*(b as f64)>=1.0
    }
    bs_sort(&!means,b as i64)
    let lo=bs_restore(bs_quantile(&means,b as i64,lower_p),scale,anchor)
    let hi=bs_restore(bs_quantile(&means,b as i64,upper_p),scale,anchor)
    let estimate=bs_restore(point,scale,anchor)
    if !is_finite(se) || !is_finite(lo) || !is_finite(hi) || !is_finite(estimate) {return bca_empty(4)}
    BcaResult{mean:estimate,se:se,lo:lo,hi:hi,b:b as i64,status:0,seed_used:initial,
        bias_p:bias_p,z0:z0,acceleration:acceleration,lower_p:lower_p,upper_p:upper_p,
        less_count:less,equal_count:equal,tail_resolved:resolved}
}

/// Existing percentile surface, using the same draw/sort/statistics kernel.
pub fn bootstrap_mean(x:&[f64;256],n:i32,b:i32,conf:f64,seed:i64)->BootResult with Mut, Div, Panic {
    let r=bs_mean_core(x,n,b,conf,seed,false)
    BootResult{mean:r.mean,se:r.se,lo:r.lo,hi:r.hi,b:r.b,status:r.status,seed_used:r.seed_used}
}

/// Mean BCa with explicit unavailable states and finite-resample diagnostics.
/// Status 1..4 as percentile; 5 degenerate, 6 extreme bias, 7 unsupported adjusted tails.
pub fn bootstrap_bca_mean(x:&[f64;256],n:i32,b:i32,conf:f64,seed:i64)->BcaResult with Mut, Div, Panic {
    bs_mean_core(x,n,b,conf,seed,true)
}
