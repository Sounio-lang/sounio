// Bounded standard-normal helpers for the BCa resampling contract.
// Marsaglia positive-term central integral; inverse by bracketed bisection.
module stats::bca_normal
use math::pure::{exp, is_finite}

pub struct BcaNormalValue { pub status:i64, pub value:f64 }

// Private kernel: finite |z|<=6. No subtraction of nearly equal polynomial terms.
fn bn_cdf(z:f64)->f64 with Mut, Div {
    if z == 0.0 { return 0.5 }
    let x=if z<0.0 {0.0-z}else{z}
    let q=x*x
    var term=x
    var sum=x
    var odd:i64=3
    var k:i64=0
    var active=true
    while k<256 && active {
        term=term*q/(odd as f64)
        let next=sum+term
        if next == sum { active=false }
        sum=next
        odd=odd+2
        k=k+1
    }
    let area=sum*exp(0.0-0.5*q)*0.39894228040143267794
    if z<0.0 {0.5-area}else{0.5+area}
}

/// status 0 available, 1 nonfinite, 2 outside bounded domain |z|<=6.
pub fn bca_normal_cdf(z:f64)->BcaNormalValue with Mut, Div {
    if !is_finite(z) {return BcaNormalValue{status:1,value:0.0}}
    if z<0.0-6.0 || z>6.0 {return BcaNormalValue{status:2,value:0.0}}
    BcaNormalValue{status:0,value:bn_cdf(z)}
}

/// Probability domain 1e-6..1-1e-6; no extrapolation into unresolved extreme tails.
pub fn bca_normal_quantile(p:f64)->BcaNormalValue with Mut, Div {
    if !is_finite(p) {return BcaNormalValue{status:1,value:0.0}}
    if p<1.0e-6 || p>1.0-1.0e-6 {return BcaNormalValue{status:2,value:0.0}}
    if p == 0.5 {return BcaNormalValue{status:0,value:0.0}}
    var lo=0.0-6.0
    var hi=6.0
    var i:i64=0
    while i<56 {
        let mid=lo+(hi-lo)*0.5
        if bn_cdf(mid)<p {lo=mid}else{hi=mid}
        i=i+1
    }
    BcaNormalValue{status:0,value:lo+(hi-lo)*0.5}
}
