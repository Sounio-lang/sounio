//@ run-pass
//@ expect-stdout: ALL PASS

// stdlib/stats/dirichlet_mult.sio — Dirichlet-Multinomial category posterior
//
// Bayesian inference for the category probabilities of a multinomial with a
// conjugate Dirichlet prior — the k-category generalisation of the
// Beta-Binomial:
//
//   dirichlet_mult(alpha_prior, counts, k, q) -> DirichletPosterior
//
// Posterior Dirichlet(α + counts); the queried category's marginal is
//   Beta(αq', α₀' − αq'),   mean = αq'/α₀',
// giving a per-category posterior mean and an equal-tailed credible interval
// (inverse incomplete beta).
//
// Pure Sounio: inline Lanczos log-gamma + continued-fraction incomplete beta,
// inverted by bisection. No external dependency, no nested data-array calls.
//
// References:
//   Gelman et al., "Bayesian Data Analysis" 3e, §3.4.

module stats::dirichlet_mult

fn dm_exp(x: f64) -> f64 with Mut, Div, Panic {
    if x < 0.0 { return 1.0 / dm_exp(0.0 - x) }
    var k = 0
    var r = x
    while r > 2.0 { r = r * 0.5; k = k + 1 }
    var term = 1.0
    var sum = 1.0
    var n = 1
    while n < 40 { term = term * r / (n as f64); sum = sum + term; n = n + 1 }
    var i = 0
    while i < k { sum = sum * sum; i = i + 1 }
    return sum
}

fn dm_ln(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var m = x
    var e = 0.0
    let LN2 = 0.6931471805599453
    while m >= 2.0 { m = m * 0.5; e = e + LN2 }
    while m < 1.0 { m = m * 2.0; e = e - LN2 }
    let t = (m - 1.0) / (m + 1.0)
    let t2 = t * t
    var term = t
    var sum = 0.0
    var n = 0
    while n < 40 { sum = sum + term / ((2 * n + 1) as f64); term = term * t2; n = n + 1 }
    return e + 2.0 * sum
}

fn dm_lgamma(x: f64) -> f64 with Mut, Div, Panic {
    let g = 7.0
    var c0 = 0.99999999999980993
    var c1 = 676.5203681218851
    var c2 = 0.0 - 1259.1392167224028
    var c3 = 771.32342877765313
    var c4 = 0.0 - 176.61502916214059
    var c5 = 12.507343278686905
    var c6 = 0.0 - 0.13857109526572012
    var c7 = 0.0000099843695780195716
    var c8 = 0.00000015056327351493116
    let xm = x - 1.0
    var a = c0
    a = a + c1 / (xm + 1.0)
    a = a + c2 / (xm + 2.0)
    a = a + c3 / (xm + 3.0)
    a = a + c4 / (xm + 4.0)
    a = a + c5 / (xm + 5.0)
    a = a + c6 / (xm + 6.0)
    a = a + c7 / (xm + 7.0)
    a = a + c8 / (xm + 8.0)
    let tt = xm + g + 0.5
    let HALF_LN_2PI = 0.9189385332046727
    return HALF_LN_2PI + (xm + 0.5) * dm_ln(tt) - tt + dm_ln(a)
}

fn dm_betacf(a: f64, b: f64, x: f64) -> f64 with Mut, Div, Panic {
    let qab = a + b
    let qap = a + 1.0
    let qam = a - 1.0
    var c = 1.0
    var d = 1.0 - qab * x / qap
    if d < 1.0e-300 && d > 0.0 - 1.0e-300 { d = 1.0e-300 }
    d = 1.0 / d
    var h = d
    var m = 1
    while m <= 200 {
        let mf = m as f64
        let m2 = 2.0 * mf
        var aa = mf * (b - mf) * x / ((qam + m2) * (a + m2))
        d = 1.0 + aa * d
        if d < 1.0e-300 && d > 0.0 - 1.0e-300 { d = 1.0e-300 }
        c = 1.0 + aa / c
        if c < 1.0e-300 && c > 0.0 - 1.0e-300 { c = 1.0e-300 }
        d = 1.0 / d
        h = h * d * c
        aa = 0.0 - (a + mf) * (qab + mf) * x / ((a + m2) * (qap + m2))
        d = 1.0 + aa * d
        if d < 1.0e-300 && d > 0.0 - 1.0e-300 { d = 1.0e-300 }
        c = 1.0 + aa / c
        if c < 1.0e-300 && c > 0.0 - 1.0e-300 { c = 1.0e-300 }
        d = 1.0 / d
        let del = d * c
        h = h * del
        let dd = if del - 1.0 < 0.0 { 1.0 - del } else { del - 1.0 }
        if dd < 1.0e-14 { m = 201 } else { m = m + 1 }
    }
    return h
}

fn dm_ibeta(a: f64, b: f64, x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    if x >= 1.0 { return 1.0 }
    let lbeta = dm_lgamma(a) + dm_lgamma(b) - dm_lgamma(a + b)
    let front = dm_exp(a * dm_ln(x) + b * dm_ln(1.0 - x) - lbeta)
    if x < (a + 1.0) / (a + b + 2.0) { return front * dm_betacf(a, b, x) / a }
    return 1.0 - front * dm_betacf(b, a, 1.0 - x) / b
}

fn dm_ibeta_inv(a: f64, b: f64, target: f64) -> f64 with Mut, Div, Panic {
    if target <= 0.0 { return 0.0 }
    if target >= 1.0 { return 1.0 }
    var lo = 0.0
    var hi = 1.0
    var mid = 0.5
    var it = 0
    while it < 80 {
        mid = 0.5 * (lo + hi)
        if dm_ibeta(a, b, mid) < target { lo = mid } else { hi = mid }
        it = it + 1
    }
    return mid
}

pub struct DirichletPosterior {
    pub mean: f64,       // posterior mean for the queried category
    pub lo: f64,         // credible interval lower
    pub hi: f64,         // credible interval upper
    pub alpha_post: f64, // posterior α for the queried category
    pub alpha0: f64,     // posterior concentration Σα'
}

/// Dirichlet-Multinomial posterior for one queried category probability.
///
/// Parâmetros: alpha_prior — Dirichlet prior (per category); counts — observed
///             counts; k — categories (2..64); q — queried category index; conf — level.
/// Retorno: DirichletPosterior (mean, lo, hi, alpha_post, alpha0).
/// Referências: Gelman et al. §3.4.
pub fn dirichlet_mult(alpha_prior: &[f64; 64], counts: &[f64; 64], k: i32, q: i32, conf: f64) -> DirichletPosterior with Mut, Div, Panic {
    if k < 2 || q < 0 || q >= k {
        return DirichletPosterior { mean: 0.0, lo: 0.0, hi: 0.0, alpha_post: 0.0, alpha0: 0.0 }
    }
    var alpha0 = 0.0
    var i = 0
    while i < k { alpha0 = alpha0 + alpha_prior[i as usize] + counts[i as usize]; i = i + 1 }
    let aq = alpha_prior[q as usize] + counts[q as usize]
    if alpha0 <= 0.0 || aq <= 0.0 {
        return DirichletPosterior { mean: 0.0, lo: 0.0, hi: 0.0, alpha_post: aq, alpha0: alpha0 }
    }
    let mean = aq / alpha0
    let bq = alpha0 - aq
    let alpha = 1.0 - conf
    let lo = dm_ibeta_inv(aq, bq, alpha * 0.5)
    let hi = dm_ibeta_inv(aq, bq, 1.0 - alpha * 0.5)
    return DirichletPosterior { mean: mean, lo: lo, hi: hi, alpha_post: aq, alpha0: alpha0 }
}

// ============================================================================
// INLINE TESTS
// ============================================================================

fn approx(a: f64, b: f64, tol: f64) -> bool {
    let d = if a > b { a - b } else { b - a }
    return d <= tol
}

fn check(name: i64, ok: bool) -> bool with IO {
    if ok { return true }
    print("FAIL at case "); print(name); print("\n")
    return false
}

// prior (1,1,1), counts (10,20,70). posterior α'=(11,21,71), α0=103.
// query cat 2: mean=71/103=0.689320; marginal Beta(71,32); CI brackets the mean.
fn test_dirichlet() -> bool with IO, Mut, Div, Panic {
    var ap: [f64; 64] = [0.0; 64]
    var ct: [f64; 64] = [0.0; 64]
    ap[0]=1.0; ap[1]=1.0; ap[2]=1.0
    ct[0]=10.0; ct[1]=20.0; ct[2]=70.0
    let r = dirichlet_mult(&ap, &ct, 3, 2, 0.95)
    var ok = true
    ok = check(1, approx(r.mean, 0.689320, 1.0e-5)) && ok
    ok = check(2, approx(r.alpha_post, 71.0, 1.0e-9)) && ok
    ok = check(3, approx(r.alpha0, 103.0, 1.0e-9)) && ok
    ok = check(4, r.lo < 0.689320 && r.hi > 0.689320) && ok
    return ok
}

// uniform prior, equal counts -> each category mean = 1/k.
fn test_uniform() -> bool with IO, Mut, Div, Panic {
    var ap: [f64; 64] = [0.0; 64]
    var ct: [f64; 64] = [0.0; 64]
    var i = 0
    while i < 4 { ap[i as usize] = 1.0; ct[i as usize] = 5.0; i = i + 1 }
    let r = dirichlet_mult(&ap, &ct, 4, 0, 0.95)
    return check(10, approx(r.mean, 0.25, 1.0e-9))       // (1+5)/(4·6)=6/24=0.25
}

pub fn run_tests() -> bool with IO, Mut, Div, Panic {
    var ok = true
    ok = test_dirichlet() && ok
    ok = test_uniform() && ok
    return ok
}

fn main() with IO, Mut, Div, Panic {
    if run_tests() {
        print("ALL PASS\n")
    } else {
        print("SOME FAILED\n")
    }
}
