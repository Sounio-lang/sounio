// Shapiro-Wilk with Royston AS R94 coefficient/calibration approximations.
// Mathematical coefficients: Royston (1995), JRSS C 44(4),547-551.
// Independently organized implementation: normalized projection residual norm,
// compensated moments, shared bounded quantiles and direct normal survival.
// Complete uncensored samples only; 3 <= n <= 100.
use math::pure::{sqrt,atan,exp,ln_checked,is_finite}
use stats::bca_normal::{bca_normal_quantile}
use stats::order::{sort100}
use special::igamma::{igamma_upper}
pub struct ShapiroResult {
 pub status:i64, pub n:i64, pub w:f64, pub one_minus_w:f64, pub p:f64,
 // calibration 0 analytic n=3, 1 Royston n=4..11, 2 Royston n=12..100.
 pub calibration:i64, pub p_approximate:bool, pub has_ties:bool,
}
fn sw_abs(x:f64)->f64 {if x<0.0{return -x} return x}
fn sw_exp(x: f64) -> f64 with Mut, Div, Panic {
    // Delegate to the shared full-range exp; a local series is not the contract.
    exp(x)
}
fn sw_empty(s:i64,n:i64)->ShapiroResult {
 return ShapiroResult{status:s,n:n,w:0.0,one_minus_w:0.0,p:0.0,
 calibration:if n==3 {0} else if n<=11 {1} else {2},
 p_approximate:n!=3,has_ties:false}
}
// Polynomial corrections to the two most extreme normal-order weights.
fn sw_c1(t:f64)->f64 {
 return t*(0.221157+t*(-0.147981+t*(-2.07119+t*(4.434685-2.706056*t))))
}
fn sw_c2(t:f64)->f64 {
 return t*(0.042981+t*(-0.293762+t*(-1.752461+t*(5.682633-3.582633*t))))
}
// status0 available;1 size;2 nonfinite;3 constant;4 arithmetic;
// 5 calibration unavailable (W and 1-W remain available).
pub fn shapiro_wilk(x:&[f64;100],n:i64)->ShapiroResult with Mut,Div,Panic {
 var out=sw_empty(1,n)
 if n<3 || n>100 {return out}
 var ordered:[f64;100]=[0.0;100]
 var a:[f64;50]=[0.0;50]
 var scale=0.0
 var i:i64=0
 while i<n {
  let v=x[i as usize]
  if !is_finite(v) {return sw_empty(2,n)}
  ordered[i as usize]=v
  if sw_abs(v)>scale {scale=sw_abs(v)}
  i=i+1
 }
 if !sort100(&!ordered,n) {return sw_empty(4,n)}
 let anchor=ordered[0]
 let range=ordered[(n-1) as usize]-anchor
 if range==0.0 {return sw_empty(3,n)}
 i=1
 while i<n {
  if ordered[i as usize]==ordered[(i-1) as usize] {out.has_ties=true}
  i=i+1
 }
 var sum=0.0
 var c=0.0
 i=0
 while i<n {
  var v=0.0
  if is_finite(range) {v=(ordered[i as usize]-anchor)/range}
  else {v=ordered[i as usize]/scale-anchor/scale}
  ordered[i as usize]=v
  let y=v-c
  let t=sum+y
  c=(t-sum)-y
  sum=t
  i=i+1
 }
 let nf=n as f64
 let mean=sum/nf
 let half=n/2
 if n==3 {a[0]=sqrt(0.5)}
 else {
  var qsum=0.0
  var qc=0.0
  i=0
  while i<half {
   let probability=((i as f64)+0.625)/(nf+0.25)
   let q=bca_normal_quantile(probability)
   if q.status!=0 {return sw_empty(4,n)}
   a[i as usize]=q.value
   let y=q.value*q.value-qc
   let t=qsum+y
   qc=(t-qsum)-y
   qsum=t
   i=i+1
  }
  let norm2=2.0*qsum
  let root=sqrt(norm2)
  let t=1.0/sqrt(nf)
  let first=sw_c1(t)-a[0]/root
  var removed=2.0*a[0]*a[0]
  var remaining=1.0-2.0*first*first
  var begin:i64=1
  if n>5 {
   let second=sw_c2(t)-a[1]/root
   removed=removed+2.0*a[1]*a[1]
   remaining=remaining-2.0*second*second
   a[1]=second
   begin=2
  }
  if remaining<=0.0 || norm2<=removed {return sw_empty(4,n)}
  let factor=sqrt((norm2-removed)/remaining)
  a[0]=first
  i=begin
  while i<half {a[i as usize]=-a[i as usize]/factor;i=i+1}
 }
 // Antisymmetric weights have exactly zero algebraic mean.
 var dot=0.0
 var dotc=0.0
 var anorm=0.0
 var ac=0.0
 i=0
 while i<half {
  let weight=a[i as usize]
  let y=weight*(ordered[(n-1-i) as usize]-ordered[i as usize])-dotc
  let t=dot+y
  dotc=(t-dot)-y
  dot=t
  let v=2.0*weight*weight-ac
  let u=anorm+v
  ac=(u-anorm)-v
  anorm=u
  i=i+1
 }
 if anorm<=0.0 || !is_finite(anorm) {return sw_empty(4,n)}
 let projection=dot/anorm
 var total=0.0
 var tc=0.0
 var residual=0.0
 var rc=0.0
 i=0
 while i<n {
  var weight=0.0
  if i<half {weight=-a[i as usize]}
  else if i>=n-half {weight=a[(n-1-i) as usize]}
  let d=ordered[i as usize]-mean
  let e=d-projection*weight
  let v=d*d-tc
  let t=total+v
  tc=(t-total)-v
  total=t
  let r=e*e-rc
  let u=residual+r
  rc=(u-residual)-r
  residual=u
  i=i+1
 }
 if total<=0.0 {return sw_empty(4,n)}
 let w1=residual/total
 if !is_finite(w1) || w1<0.0 || w1>1.0 {return sw_empty(4,n)}
 out.w=1.0-w1
 out.one_minus_w=w1
 out.status=0
 if n==3 {
  let p=1.0-1.9098593171027440292*atan(sqrt(w1/out.w))
  if p< -1.4210854715202004e-14 || p>1.0 {return sw_empty(4,n)}
  out.p=if p<0.0 {0.0} else {p}
  return out
 }
 if w1==0.0 {out.p=1.0;return out}
 let ly=ln_checked(w1)
 if ly.status!=0 {out.status=5;return out}
 var y=ly.value
 var location=0.0
 var sd=0.0
 if n<=11 {
  let gamma=-2.273+0.459*nf
  if y>=gamma {out.status=5;return out}
  let transform=ln_checked(gamma-y)
  if transform.status!=0 {out.status=5;return out}
  y=-transform.value
  location=0.544+nf*(-0.39978+nf*(0.025054-0.0006714*nf))
  sd=sw_exp(1.3822+nf*(-0.77857+nf*(0.062767-0.0020322*nf)))
 } else {
  let size=ln_checked(nf)
  if size.status!=0 {out.status=5;return out}
  let t=size.value
  location=-1.5861+t*(-0.31082+t*(-0.083751+0.0038915*t))
  sd=sw_exp(-0.4803+t*(-0.082676+0.0030302*t))
 }
 let z=(y-location)/sd
 if !is_finite(z) || sd<=0.0 {out.status=5;return out}
 let tail=0.5*igamma_upper(0.5,0.5*z*z)
 let p=if z>=0.0 {tail} else {1.0-tail}
 if !is_finite(p) || p<0.0 || p>1.0 {out.status=5;return out}
 out.p=p
 return out
}
