//@ run-pass
//@ expect-stdout: ALL PASS

// Bounded legacy two-group ordinary right-censoring facade. Array arguments and
// the five original scalar fields are preserved; Alloc is now explicit.
// Unsupported/undefined outputs fail closed. For complete availability/work
// metadata, dynamic curves and retained log tails use stats::checked_survival.
// hr is the observed/expected ratio diagnostic, not a fitted Cox hazard ratio.
module stats::logrank
use collections::numeric_buffer::{numeric_buffer_new,numeric_buffer_set,numeric_buffer_close}
use collections::integer_buffer::{integer_buffer_new,integer_buffer_set,integer_buffer_close}
use stats::checked_survival::{survival_workspace,survival_checked}

pub struct LogRankResult {
 pub chi2:f64,pub p:f64,pub o1:f64,pub e1:f64,pub hr:f64,
 pub log_p:f64,pub variance:f64,pub critical_evaluations:i64,pub tail_iterations:i64,
}
pub fn logrank(time:&[f64;256],event:&[i64;256],group:&[i64;256],n:i32)->LogRankResult with Alloc,Mut,Div,Panic {
 assert(n>=2 && n<=256)
 let count=n as i64
 let layout=survival_workspace(count,8000000)
 assert(layout.status==0)
 var times=numeric_buffer_new(count,count*8)
 var events=integer_buffer_new(count,count*8)
 var groups=integer_buffer_new(count,count*8)
 var order=integer_buffer_new(count,count*8)
 var curves=numeric_buffer_new(layout.curve_len,layout.curve_len*8)
 var counts=integer_buffer_new(layout.count_len,layout.count_len*8)
 var i:i64=0
 while i<count {
  numeric_buffer_set(&!times,i,time[i as usize]);integer_buffer_set(&!events,i,event[i as usize]);integer_buffer_set(&!groups,i,group[i as usize]);i=i+1
 }
 let checked=survival_checked(&times,&events,&groups,count,0.05,&!order,&!curves,&!counts,8000000,1000000,100000,100000,1.0e-13)
 let r=checked.logrank
 numeric_buffer_close(times);integer_buffer_close(events);integer_buffer_close(groups);integer_buffer_close(order);numeric_buffer_close(curves);integer_buffer_close(counts)
 assert(checked.status==0 && r.status==0 && r.available && r.p_available && r.log_p_available && r.oe_ratio_available)
 LogRankResult{chi2:r.chi2,p:r.p,o1:r.observed1 as f64,e1:r.expected1,hr:r.oe_ratio,log_p:r.log_p,variance:r.variance,critical_evaluations:checked.critical_evaluations,tail_iterations:r.kernel_iterations}
}

// ============================================================================
// INLINE TESTS
// ============================================================================

fn approx(a: f64, b: f64, tol: f64) -> bool {
    let d = if a > b { a - b } else { b - a }
    return d <= tol
}

fn check(name: i64, ok: bool) -> bool with IO {
    if ok { return true }
    print("FAIL at case "); print(name); print("\n")
    return false
}

// group0 deaths at 1,3,5; group1 deaths at 2,4,6 (all events, n=6).
// O1=3, E1=3.766667, V=1.212222 -> chi2=(0.766667)²/1.212222=0.484877.
// HR=(O1/E1)/(O0/E0)=(3/3.766667)/(3/2.233333)=0.796460/1.343284=0.592920.
fn test_logrank() -> bool with IO, Alloc, Mut, Div, Panic {
    var t: [f64; 256] = [0.0; 256]
    var e: [i64; 256] = [0; 256]
    var g: [i64; 256] = [0; 256]
    t[0]=1.0; t[1]=3.0; t[2]=5.0; t[3]=2.0; t[4]=4.0; t[5]=6.0
    e[0]=1; e[1]=1; e[2]=1; e[3]=1; e[4]=1; e[5]=1
    g[0]=0; g[1]=0; g[2]=0; g[3]=1; g[4]=1; g[5]=1
    let r = logrank(&t, &e, &g, 6)
    var ok = true
    ok = check(1, approx(r.chi2, 0.484877, 1.0e-4)) && ok
    ok = check(2, approx(r.o1, 3.0, 1.0e-9)) && ok
    ok = check(3, approx(r.e1, 3.766667, 1.0e-4)) && ok
    ok = check(4, approx(r.hr, 0.592920, 1.0e-4)) && ok
    return ok
}

// identical groups (interleaved, symmetric) -> chi2 ~ 0, HR ~ 1.
// group0 {1,2,3}, group1 {1,2,3}: every death time has equal risk sets.
fn test_logrank_null() -> bool with IO, Alloc, Mut, Div, Panic {
    var t: [f64; 256] = [0.0; 256]
    var e: [i64; 256] = [0; 256]
    var g: [i64; 256] = [0; 256]
    t[0]=1.0; t[1]=2.0; t[2]=3.0; t[3]=1.0; t[4]=2.0; t[5]=3.0
    e[0]=1; e[1]=1; e[2]=1; e[3]=1; e[4]=1; e[5]=1
    g[0]=0; g[1]=0; g[2]=0; g[3]=1; g[4]=1; g[5]=1
    let r = logrank(&t, &e, &g, 6)
    var ok = true
    ok = check(10, approx(r.chi2, 0.0, 1.0e-9)) && ok
    ok = check(11, approx(r.hr, 1.0, 1.0e-6)) && ok
    ok = check(12, approx(r.p, 1.0, 1.0e-6)) && ok
    return ok
}

pub fn run_tests() -> bool with IO, Alloc, Mut, Div, Panic {
    var ok = true
    ok = test_logrank() && ok
    ok = test_logrank_null() && ok
    return ok
}

fn main() with IO, Alloc, Mut, Div, Panic {
    if run_tests() {
        print("ALL PASS\n")
    } else {
        print("SOME FAILED\n")
    }
}
