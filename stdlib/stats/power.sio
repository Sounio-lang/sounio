//@ run-pass
//@ expect-stdout: ALL PASS
// Genuine noncentral-t power; checked variants expose unavailable/cap/work status.
// One-sided is the directional right-tail test. Only explicitly named
// shifted_t_approx functions retain the historical approximation.
module stats::power
use stats::checked_power::{power_onesample_checked,power_twosample_checked,n_for_power_onesample_checked,n_for_power_twosample_checked}
use stats::student_t::{t_cdf,t_sf,t_quantile}
use math::pure::{is_finite,sqrt}

pub fn power_ttest_onesample(d:f64,n:i64,alpha:f64,two_sided:bool)->f64 with Mut,Div,Panic {
 let r=power_onesample_checked(d,n,alpha,two_sided,4096,1.0e-11)
 assert(r.status==0 && r.value_available)
 r.value
}
pub fn power_ttest_twosample(d:f64,n:i64,alpha:f64,two_sided:bool)->f64 with Mut,Div,Panic {
 let r=power_twosample_checked(d,n,alpha,two_sided,4096,1.0e-11)
 assert(r.status==0 && r.value_available)
 r.value
}
pub fn n_for_power_onesample(d:f64,target:f64,alpha:f64,two_sided:bool)->i64 with Mut,Div,Panic {
 let r=n_for_power_onesample_checked(d,target,alpha,two_sided,1000000,4096,1.0e-11)
 assert(r.status==0 && r.available && r.verified)
 r.n
}
pub fn n_for_power_twosample(d:f64,target:f64,alpha:f64,two_sided:bool)->i64 with Mut,Div,Panic {
 let r=n_for_power_twosample_checked(d,target,alpha,two_sided,1000000,4096,1.0e-11)
 assert(r.status==0 && r.available && r.verified)
 r.n
}
fn pw_shifted_t_approx(d:f64,n:i64,alpha:f64,two_sided:bool,per_group:bool)->f64 with Mut,Div,Panic {
 assert(is_finite(d) && is_finite(alpha) && n>=2 && n<=1000000 && alpha>0.0 && alpha<1.0)
 let effect=if two_sided && d<0.0 {-d}else{d}
 let nf=n as f64
 let df=if per_group {2.0*nf-2.0}else{nf-1.0}
 let delta=effect*sqrt(if per_group {nf*0.5}else{nf})
 let tail=if two_sided {alpha*0.5}else{alpha}
 assert(is_finite(delta) && tail>0.0 && 1.0-tail<1.0)
 let critical=t_quantile(1.0-tail,df)
 var value=t_sf(critical-delta,df)
 if two_sided {value=value+t_cdf(-critical-delta,df)}
 assert(is_finite(value) && value>=0.0 && value<=1.0)
 value
}
// Explicit approximations use the historical central-Student kernel, including
// its documented large-df/Cornish-Fisher approximations; no checked path calls them.
pub fn power_ttest_onesample_shifted_t_approx(d:f64,n:i64,alpha:f64,two_sided:bool)->f64 with Mut,Div,Panic {pw_shifted_t_approx(d,n,alpha,two_sided,false)}
pub fn power_ttest_twosample_shifted_t_approx(d:f64,n:i64,alpha:f64,two_sided:bool)->f64 with Mut,Div,Panic {pw_shifted_t_approx(d,n,alpha,two_sided,true)}
pub fn run_tests()->bool with IO,Mut,Div,Panic {
 let n1=n_for_power_onesample(0.5,0.8,0.05,true)
 let n2=n_for_power_twosample(0.5,0.8,0.05,true)
 n1==34 && n2==64 &&
 power_ttest_onesample(0.5,n1-1,0.05,true)<0.8 &&
 power_ttest_onesample(0.5,n1,0.05,true)>=0.8 &&
 power_ttest_twosample(0.5,n2-1,0.05,true)<0.8 &&
 power_ttest_twosample(0.5,n2,0.05,true)>=0.8 &&
 power_ttest_onesample(0.0,50,0.05,true)==0.05 &&
 power_ttest_onesample(-0.5,10,0.05,false)<0.05
}
fn main() with IO,Mut,Div,Panic {
 if run_tests() {print("ALL PASS\n")}else{print("SOME FAILED\n")}
}
