// stats::shared — Canonical types shared across stats submodules
//
// Centralizes BetaConfidence and its core operations to avoid
// duplicate definitions across the stats module cluster.

pub struct BetaConfidence {
    pub alpha: f64,
    pub beta: f64
}

pub fn beta_new(a: f64, b: f64) -> BetaConfidence { BetaConfidence { alpha: a, beta: b } }
pub fn beta_mean(b: &BetaConfidence) -> f64 { b.alpha / (b.alpha + b.beta) }
pub fn beta_combine(b1: &BetaConfidence, b2: &BetaConfidence) -> BetaConfidence {
    BetaConfidence { alpha: b1.alpha + b2.alpha - 1.0, beta: b1.beta + b2.beta - 1.0 }
}

pub fn abs_f64(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }
pub fn max_f64(a: f64, b: f64) -> f64 { if a > b { a } else { b } }
pub fn min_f64(a: f64, b: f64) -> f64 { if a < b { a } else { b } }

let MAX_OBS: i64 = 100
