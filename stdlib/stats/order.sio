// Shared bounded in-place ordering for scientific scalar samples.
// Finite prefix only. Invalid size/data returns false before mutation.
use math::pure::{is_finite}
pub fn sort100(a:&![f64;100],n:i64)->bool with Mut,Div,Panic {
 if n<0 || n>100 {return false}
 var i:i64=0
 while i<n {if !is_finite(a[i as usize]) {return false} i=i+1}
 var start=n/2
 var end=n
 while end>1 {
  var root:i64=0
  if start>0 {start=start-1;root=start}
  else {end=end-1;let t=a[end as usize];a[end as usize]=a[0];a[0]=t}
  var active=true
  while active {
   var child=root*2+1
   if child>=end {active=false}
   else {
    if child+1<end && a[child as usize]<a[(child+1) as usize] {child=child+1}
    if a[root as usize]<a[child as usize] {
     let t=a[root as usize];a[root as usize]=a[child as usize];a[child as usize]=t
     root=child
    } else {active=false}
   }
  }
 }
 return true
}

// Same bounded heapsort for larger EDF samples.
pub fn sort256(a:&![f64;256],n:i64)->bool with Mut,Div,Panic {
 if n<0 || n>256 {return false}
 var i:i64=0
 while i<n {if !is_finite(a[i as usize]) {return false} i=i+1}
 var start=n/2
 var end=n
 while end>1 {
  var root:i64=0
  if start>0 {start=start-1;root=start}
  else {end=end-1;let t=a[end as usize];a[end as usize]=a[0];a[0]=t}
  var active=true
  while active {
   var child=root*2+1
   if child>=end {active=false}
   else {
    if child+1<end && a[child as usize]<a[(child+1) as usize] {child=child+1}
    if a[root as usize]<a[child as usize] {
     let t=a[root as usize];a[root as usize]=a[child as usize];a[child as usize]=t
     root=child
    } else {active=false}
   }
  }
 }
 return true
}
