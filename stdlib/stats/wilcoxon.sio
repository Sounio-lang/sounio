//@ run-pass
//@ expect-stdout: ALL PASS
// Fixed-array compatibility façade. The original argument and result fields
// remain; default p-values now use finite conditional sign-pattern counting.
// Alloc is explicit because bounded caller-owned dynamic scratch replaces the
// former quadratic sort, hidden near-zero floor and normal-only calculation.
// effect_r retains z/sqrt(n_eff); it is NOT matched-pairs rank-biserial.
module stats::wilcoxon
use collections::numeric_buffer::{NumericBuffer,numeric_buffer_new,numeric_buffer_set,numeric_buffer_close,numeric_buffer_status}
use collections::integer_buffer::{IntegerBuffer,integer_buffer_new,integer_buffer_close}
use stats::checked_wilcoxon::{CheckedWilcoxonRanks,CheckedWilcoxonProbability,wilcoxon_rank_workspace,wilcoxon_rank_checked,wilcoxon_exact_workspace,wilcoxon_exact_ranked_checked,wilcoxon_normal_approx_checked}
use math::pure::{is_finite}

pub struct WilcoxonResult {
 pub w_plus:f64,pub w_minus:f64,pub w_stat:f64,pub n_eff:i64,
 pub z:f64,pub p_value:f64,pub effect_r:f64,
 pub rank_biserial:f64,pub rank_biserial_available:bool,
 pub z_available:bool,pub effect_r_available:bool,
 pub p_value_available:bool,pub log_p_value:f64,pub log_p_available:bool,
 pub method:i64,pub zero_method:i64,
}
fn wx_merge(ranks:&CheckedWilcoxonRanks,p:&CheckedWilcoxonProbability)->WilcoxonResult with Panic {
 assert(ranks.status==0 && p.status==0 && p.value_available)
 WilcoxonResult{w_plus:ranks.w_plus,w_minus:ranks.w_minus,w_stat:if ranks.w_plus<ranks.w_minus {ranks.w_plus}else{ranks.w_minus},
 n_eff:ranks.n_eff,z:ranks.z,p_value:p.value,effect_r:ranks.z_over_sqrt_n,
 rank_biserial:ranks.rank_biserial,rank_biserial_available:ranks.rank_biserial_available,
 z_available:ranks.z_available,effect_r_available:ranks.z_available,p_value_available:p.value_available,
 log_p_value:p.log_value,log_p_available:p.log_available,method:p.method,zero_method:ranks.zero_method}
}
// Keep linear scratch owners in a function scope: the modular backend cannot
// currently lower their destruction from a nested if-expression scope.
fn wx_exact_result(ranks:&CheckedWilcoxonRanks,signed_ranks:&IntegerBuffer)->WilcoxonResult with Alloc,Mut,Div,Panic {
 let query=wilcoxon_exact_workspace(signed_ranks,ranks.n_eff,0,8388608,50000000)
 assert(query.status==0)
 var counts=integer_buffer_new(query.count_len,query.count_len*8)
 var numerator=integer_buffer_new(query.numerator_len,query.numerator_len*8)
 let probability=wilcoxon_exact_ranked_checked(signed_ranks,ranks.n_eff,0,&!counts,&!numerator,8388608,50000000)
 let result=wx_merge(ranks,&probability)
 integer_buffer_close(counts);integer_buffer_close(numerator)
 result
}
fn wx_approx_result(ranks:&CheckedWilcoxonRanks)->WilcoxonResult with Mut,Div,Panic {
 let probability=wilcoxon_normal_approx_checked(ranks,0,4096,1.0e-11)
 wx_merge(ranks,&probability)
}
fn wx_from_owned_diffs(differences:&NumericBuffer,n:i64,exact:bool)->WilcoxonResult with Alloc,Mut,Div,Panic {
 let layout=wilcoxon_rank_workspace(n,8388608)
 assert(layout.status==0)
 var magnitudes=numeric_buffer_new(n,n*8)
 var order=integer_buffer_new(n,n*8)
 var signed_ranks=integer_buffer_new(n,n*8)
 let ranks=wilcoxon_rank_checked(differences,n,0,true,&!magnitudes,&!order,&!signed_ranks,1000000)
 assert(ranks.status==0)
 let result=if exact {wx_exact_result(&ranks,&signed_ranks)}else{wx_approx_result(&ranks)}
 numeric_buffer_close(magnitudes);integer_buffer_close(order);integer_buffer_close(signed_ranks)
 result
}
fn wx_paired(x:&[f64;256],y:&[f64;256],n:i32,exact:bool)->WilcoxonResult with Alloc,Mut,Div,Panic {
 assert(n>=0 && n<=256)
 var differences=numeric_buffer_new(n as i64,(n as i64)*8)
 assert(numeric_buffer_status(&differences)==0)
 var i:i32=0
 while i<n {
  assert(is_finite(x[i as usize]) && is_finite(y[i as usize]))
  let value=x[i as usize]-y[i as usize]
  assert(is_finite(value))
  numeric_buffer_set(&!differences,i as i64,value);i=i+1
 }
 let result=wx_from_owned_diffs(&differences,n as i64,exact)
 numeric_buffer_close(differences)
 result
}
fn wx_one_sample(x:&[f64;256],n:i32,median0:f64,exact:bool)->WilcoxonResult with Alloc,Mut,Div,Panic {
 assert(n>=0 && n<=256 && is_finite(median0))
 var differences=numeric_buffer_new(n as i64,(n as i64)*8)
 assert(numeric_buffer_status(&differences)==0)
 var i:i32=0
 while i<n {
  assert(is_finite(x[i as usize]))
  let value=x[i as usize]-median0
  assert(is_finite(value))
  numeric_buffer_set(&!differences,i as i64,value);i=i+1
 }
 let result=wx_from_owned_diffs(&differences,n as i64,exact)
 numeric_buffer_close(differences)
 result
}
// Exact-zero Wilcox rule, exact magnitude ties, inclusive absolute-deviation
// two-sided conditional p. This does not merely test a median under asymmetry.
pub fn wilcoxon_signed_rank(x:&[f64;256],y:&[f64;256],n:i32)->WilcoxonResult with Alloc,Mut,Div,Panic {wx_paired(x,y,n,true)}
pub fn wilcoxon_one_sample(x:&[f64;256],n:i32,median0:f64)->WilcoxonResult with Alloc,Mut,Div,Panic {wx_one_sample(x,n,median0,true)}
// Explicit approximations retain a signed, continuity-corrected z diagnostic.
// No exact-method refusal calls either approximation as a fallback.
pub fn wilcoxon_signed_rank_normal_approx(x:&[f64;256],y:&[f64;256],n:i32)->WilcoxonResult with Alloc,Mut,Div,Panic {wx_paired(x,y,n,false)}
pub fn wilcoxon_one_sample_normal_approx(x:&[f64;256],n:i32,median0:f64)->WilcoxonResult with Alloc,Mut,Div,Panic {wx_one_sample(x,n,median0,false)}
pub fn run_tests()->bool with IO,Alloc,Mut,Div,Panic {
 var x:[f64;256]=[0.0;256]
 var y:[f64;256]=[0.0;256]
 x[0]=1.0;x[1]=2.0
 let positive=wilcoxon_signed_rank(&x,&y,2)
 assert(positive.n_eff==2 && positive.w_plus==3.0 && positive.w_minus==0.0 && positive.p_value==0.5 && positive.method==1)
 x[0]=0.0;x[1]=0.0
 let point=wilcoxon_one_sample(&x,2,0.0)
 assert(point.p_value==1.0 && !point.rank_biserial_available && !point.z_available && !point.effect_r_available)
 true
}
fn main() with IO,Alloc,Mut,Div,Panic {
 if run_tests() {print("ALL PASS\n")}else{print("SOME FAILED\n")}
}
