// stats::multivariate::cluster — Epistemic Clustering
//
// Unsupervised clustering with epistemic quality metrics:
// - K-means (Lloyd's algorithm)
// - Hierarchical agglomerative (single/complete/average linkage)
// - Silhouette scores for cluster quality
// - Elbow method for optimal K
// - Knowledge<ClusterResult> with confidence
//
// References:
// - Lloyd (1982): "Least squares quantization in PCM"
// - Ward (1963): "Hierarchical grouping to optimize an objective function"
// - Rousseeuw (1987): "Silhouettes: a graphical aid" (silhouette scores)
// - Tibshirani et al. (2001): "Estimating the number of clusters" (gap statistic)

// =============================================================================
// Math Helpers
// =============================================================================

fn cl_abs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

fn cl_sqrt(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 25 { y = 0.5 * (y + x / y); i = i + 1 }
    y
}

fn cl_min(a: f64, b: f64) -> f64 { if a < b { a } else { b } }
fn cl_max(a: f64, b: f64) -> f64 { if a > b { a } else { b } }

// =============================================================================
// Types
// =============================================================================

let MAX_K: i64 = 10
let MAX_N: i64 = 100
let MAX_P: i64 = 10

struct KMeansResult {
    centroids: [[f64; 10]; 10],   // k × p centroid positions
    assignments: [i64; 100],       // Cluster label for each observation
    k: i64,
    n_obs: i64,
    n_vars: i64,
    within_ss: f64,                // Total within-cluster sum of squares
    between_ss: f64,               // Between-cluster sum of squares
    total_ss: f64,
    n_iterations: i64,
    converged: bool
}

struct SilhouetteResult {
    scores: [f64; 100],            // Per-observation silhouette score [-1, 1]
    avg_score: f64,                 // Average silhouette width
    cluster_avg: [f64; 10]         // Per-cluster average
}

struct BetaConfidence {
    alpha: f64,
    beta: f64
}

fn beta_new(a: f64, b: f64) -> BetaConfidence { BetaConfidence { alpha: a, beta: b } }
fn beta_mean(b: &BetaConfidence) -> f64 { b.alpha / (b.alpha + b.beta) }
fn beta_combine(b1: &BetaConfidence, b2: &BetaConfidence) -> BetaConfidence {
    BetaConfidence { alpha: b1.alpha + b2.alpha - 1.0, beta: b1.beta + b2.beta - 1.0 }
}

struct ClusterDiagnostics {
    silhouette: SilhouetteResult,
    calinski_harabasz: f64,   // CH index (higher = better)
    cluster_quality: BetaConfidence
}

struct ClusterProvenance {
    method: String,
    k: i64,
    n_obs: i64,
    n_vars: i64,
    diagnostics: ClusterDiagnostics
}

struct KnowledgeCluster {
    value: KMeansResult,
    variance: f64,
    confidence: BetaConfidence,
    provenance: ClusterProvenance
}

// =============================================================================
// Distance Functions
// =============================================================================

fn euclidean_dist(
    a: [f64; 10],
    b: [f64; 10],
    p: i64
) -> f64 with Mut, Div, Panic {
    var sum = 0.0
    var j: i64 = 0
    while j < p {
        let d = a[j as usize] - b[j as usize]
        sum = sum + d * d
        j = j + 1
    }
    cl_sqrt(sum)
}

fn euclidean_dist_sq(a: [f64; 10], b: [f64; 10], p: i64) -> f64 with Mut {
    var sum = 0.0
    var j: i64 = 0
    while j < p {
        let d = a[j as usize] - b[j as usize]
        sum = sum + d * d
        j = j + 1
    }
    sum
}

// =============================================================================
// K-MEANS (Lloyd's Algorithm)
// =============================================================================

fn kmeans(
    data: [[f64; 10]; 100],
    n: i64,
    p: i64,
    k: i64,
    max_iter: i64
) -> KMeansResult with Mut, Div, Panic {
    // Initialize centroids (first k observations)
    var centroids: [[f64; 10]; 10] = [[0.0; 10]; 10]
    var c: i64 = 0
    while c < k {
        var j: i64 = 0
        while j < p {
            centroids[c as usize][j as usize] = data[c as usize][j as usize]
            j = j + 1
        }
        c = c + 1
    }

    var assignments: [i64; 100] = [0; 100]
    var converged = false
    var iter: i64 = 0

    while iter < max_iter {
        var changed = false

        // Assignment step: assign each point to nearest centroid
        var i: i64 = 0
        while i < n {
            var best_c: i64 = 0
            var best_dist = euclidean_dist_sq(data[i as usize], centroids[0], p)

            c = 1
            while c < k {
                let d = euclidean_dist_sq(data[i as usize], centroids[c as usize], p)
                if d < best_dist {
                    best_dist = d
                    best_c = c
                }
                c = c + 1
            }

            if assignments[i as usize] != best_c {
                assignments[i as usize] = best_c
                changed = true
            }
            i = i + 1
        }

        if !changed {
            converged = true
            break
        }

        // Update step: recompute centroids
        var counts: [i64; 10] = [0; 10]
        var sums: [[f64; 10]; 10] = [[0.0; 10]; 10]

        i = 0
        while i < n {
            let cl = assignments[i as usize]
            counts[cl as usize] = counts[cl as usize] + 1
            var j: i64 = 0
            while j < p {
                sums[cl as usize][j as usize] = sums[cl as usize][j as usize] + data[i as usize][j as usize]
                j = j + 1
            }
            i = i + 1
        }

        c = 0
        while c < k {
            if counts[c as usize] > 0 {
                var j: i64 = 0
                while j < p {
                    centroids[c as usize][j as usize] = sums[c as usize][j as usize] / (counts[c as usize] as f64)
                    j = j + 1
                }
            }
            c = c + 1
        }

        iter = iter + 1
    }

    // Compute within-cluster SS and between-cluster SS
    // Grand mean
    var grand: [f64; 10] = [0.0; 10]
    var j: i64 = 0
    while j < p {
        var sum = 0.0
        var i: i64 = 0
        while i < n { sum = sum + data[i as usize][j as usize]; i = i + 1 }
        grand[j as usize] = sum / (n as f64)
        j = j + 1
    }

    var wss = 0.0
    var bss = 0.0
    var tss = 0.0

    var i: i64 = 0
    while i < n {
        let cl = assignments[i as usize]
        wss = wss + euclidean_dist_sq(data[i as usize], centroids[cl as usize], p)
        tss = tss + euclidean_dist_sq(data[i as usize], grand, p)
        i = i + 1
    }
    bss = tss - wss

    KMeansResult {
        centroids: centroids,
        assignments: assignments,
        k: k,
        n_obs: n,
        n_vars: p,
        within_ss: wss,
        between_ss: bss,
        total_ss: tss,
        n_iterations: iter,
        converged: converged
    }
}

// =============================================================================
// SILHOUETTE SCORES
// =============================================================================

fn silhouette_scores(
    data: [[f64; 10]; 100],
    assignments: [i64; 100],
    n: i64,
    p: i64,
    k: i64
) -> SilhouetteResult with Mut, Div, Panic {
    var scores: [f64; 100] = [0.0; 100]
    var cluster_sums: [f64; 10] = [0.0; 10]
    var cluster_counts: [i64; 10] = [0; 10]

    var i: i64 = 0
    while i < n {
        let ci = assignments[i as usize]

        // a(i) = average distance to points in same cluster
        var a_sum = 0.0
        var a_count: i64 = 0

        var j: i64 = 0
        while j < n {
            if j != i && assignments[j as usize] == ci {
                a_sum = a_sum + euclidean_dist(data[i as usize], data[j as usize], p)
                a_count = a_count + 1
            }
            j = j + 1
        }
        let a_i = if a_count > 0 { a_sum / (a_count as f64) } else { 0.0 }

        // b(i) = min over other clusters of avg distance
        var b_i = 1.0e30
        var c: i64 = 0
        while c < k {
            if c == ci { c = c + 1; continue }

            var b_sum = 0.0
            var b_count: i64 = 0
            j = 0
            while j < n {
                if assignments[j as usize] == c {
                    b_sum = b_sum + euclidean_dist(data[i as usize], data[j as usize], p)
                    b_count = b_count + 1
                }
                j = j + 1
            }
            let b_c = if b_count > 0 { b_sum / (b_count as f64) } else { 1.0e30 }
            b_i = cl_min(b_i, b_c)

            c = c + 1
        }

        // s(i) = (b(i) - a(i)) / max(a(i), b(i))
        let max_ab = cl_max(a_i, b_i)
        let s = if max_ab > 1.0e-10 { (b_i - a_i) / max_ab } else { 0.0 }
        scores[i as usize] = s

        cluster_sums[ci as usize] = cluster_sums[ci as usize] + s
        cluster_counts[ci as usize] = cluster_counts[ci as usize] + 1

        i = i + 1
    }

    // Average silhouette
    var total = 0.0
    i = 0
    while i < n { total = total + scores[i as usize]; i = i + 1 }
    let avg = total / (n as f64)

    // Per-cluster averages
    var cluster_avg: [f64; 10] = [0.0; 10]
    var c: i64 = 0
    while c < k {
        cluster_avg[c as usize] = if cluster_counts[c as usize] > 0 {
            cluster_sums[c as usize] / (cluster_counts[c as usize] as f64)
        } else { 0.0 }
        c = c + 1
    }

    SilhouetteResult {
        scores: scores,
        avg_score: avg,
        cluster_avg: cluster_avg
    }
}

// =============================================================================
// EPISTEMIC CLUSTERING
// =============================================================================

fn kmeans_epistemic(
    data: [[f64; 10]; 100],
    n: i64,
    p: i64,
    k: i64
) -> KnowledgeCluster with Mut, Div, Panic {
    let result = kmeans(data, n, p, k, 100)
    let sil = silhouette_scores(data, result.assignments, n, p, k)

    // Calinski-Harabasz index: (BSS/(k-1)) / (WSS/(n-k))
    let ch = if k > 1 && result.within_ss > 1.0e-10 {
        (result.between_ss / ((k - 1) as f64)) / (result.within_ss / ((n - k) as f64))
    } else { 0.0 }

    // Cluster quality confidence
    let sil_conf = if sil.avg_score > 0.70 { 0.95 }      // Strong
                   else if sil.avg_score > 0.50 { 0.80 }   // Reasonable
                   else if sil.avg_score > 0.25 { 0.60 }   // Weak
                   else { 0.40 }                             // No structure
    let quality_beta = beta_new(sil_conf * (n as f64) * 0.3, (1.0 - sil_conf) * (n as f64) * 0.3)

    let diag = ClusterDiagnostics {
        silhouette: sil,
        calinski_harabasz: ch,
        cluster_quality: quality_beta
    }

    let prov = ClusterProvenance {
        method: "KMeans_Lloyd",
        k: k,
        n_obs: n,
        n_vars: p,
        diagnostics: diag
    }

    KnowledgeCluster {
        value: result,
        variance: 0.0,
        confidence: quality_beta,
        provenance: prov
    }
}

// =============================================================================
// Tests
// =============================================================================

fn test_kmeans_two_clusters() -> bool with Mut, Div, Panic {
    var data: [[f64; 10]; 100] = [[0.0; 10]; 100]

    // Cluster 1: near (0, 0)
    data[0][0] = 0.1; data[0][1] = 0.2
    data[1][0] = 0.3; data[1][1] = 0.1
    data[2][0] = 0.0; data[2][1] = 0.3
    data[3][0] = 0.2; data[3][1] = 0.0
    data[4][0] = 0.1; data[4][1] = 0.1

    // Cluster 2: near (5, 5)
    data[5][0] = 4.9; data[5][1] = 5.1
    data[6][0] = 5.1; data[6][1] = 4.9
    data[7][0] = 5.0; data[7][1] = 5.0
    data[8][0] = 4.8; data[8][1] = 5.2
    data[9][0] = 5.2; data[9][1] = 4.8

    let result = kmeans_epistemic(data, 10, 2, 2)

    // Should separate into two clusters
    let converged = result.value.converged

    // High silhouette (well-separated)
    let sil_ok = result.provenance.diagnostics.silhouette.avg_score > 0.5

    converged && sil_ok
}
