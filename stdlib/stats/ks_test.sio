// Checked KS statistics with a Stephens-corrected asymptotic reference.
// Known fixed normal CDF only; fitting mu/sigma needs different calibration.
// Pooled ties are flagged; continuous-null p validity is not established.
// See KS.md. Bounded in-place heapsort, no heap allocation.
module stats::ks_test
use math::pure::{sqrt,exp,is_finite}
use special::igamma::{igamma_upper}
use stats::order::{sort256}
pub struct KSResult {
 pub d:f64, pub p:f64, pub ne:f64,
 pub status:i32, pub n_x:i32, pub n_y:i32,
 pub asymptotic:bool, pub has_ties:bool,
}
fn ks_abs(x:f64)->f64 {if x<0.0{return -x} return x}
fn ks_empty(status:i32,nx:i32,ny:i32)->KSResult {
 return KSResult{d:0.0,p:0.0,ne:0.0,status:status,n_x:nx,n_y:ny,
 asymptotic:true,has_ties:false}
}
fn ks_normal_cdf(x:f64,mu:f64,sigma:f64)->f64 with Mut,Div,Panic {
 let delta=x-mu
 var z=delta/sigma
 // Half first only when subtraction overflowed; retain small differences otherwise.
 if !is_finite(delta) {z=((0.5*x-0.5*mu)/sigma)*2.0}
 if z>=40.0 {return 1.0}
 if z<= -40.0 {return 0.0}
 let tail=0.5*igamma_upper(0.5,0.5*z*z)
 return if z<0.0 {tail} else {1.0-tail}
}
fn ks_pvalue(ne:f64,d:f64)->f64 with Mut,Div,Panic {
 if d==0.0 {return 1.0}
 let root=sqrt(ne)
 let lambda=(root+0.12+0.11/root)*d
 // Below this value the theta CDF underflows in f64; survival rounds to one.
 if lambda<=0.04 {return 1.0}
 var sum=0.0
 var c=0.0
 var j:i32=1
 if lambda<1.0 {
  while j<=32 {
   let odd=(2*j-1) as f64
   let term=exp(-1.2337005501361698274*odd*odd/(lambda*lambda))
   let y=term-c
   let t=sum+y
   c=(t-sum)-y
   sum=t
   j=j+1
  }
  return 1.0-2.5066282746310005024*sum/lambda
 }
 var sign=1.0
 while j<=32 {
  let jf=j as f64
  let term=sign*exp(-2.0*jf*jf*lambda*lambda)
  let y=term-c
  let t=sum+y
  c=(t-sum)-y
  sum=t
  sign=-sign
  j=j+1
 }
 return 2.0*sum
}
pub fn ks_one_normal(x:&[f64;256],n:i32,mu:f64,sigma:f64)->KSResult with Mut,Div,Panic {
 if n<1 || n>256 {return ks_empty(1,n,0)}
 if !is_finite(mu) || !is_finite(sigma) || sigma<=0.0 {return ks_empty(3,n,0)}
 var a:[f64;256]=[0.0;256]
 var i:i32=0
 while i<n {
  if !is_finite(x[i as usize]) {return ks_empty(2,n,0)}
  a[i as usize]=x[i as usize]
  i=i+1
 }
 if !sort256(&!a,n as i64) {return ks_empty(4,n,0)}
 var out=ks_empty(0,n,0)
 var d=0.0
 let nf=n as f64
 i=0
 while i<n {
  if i>0 && a[i as usize]==a[(i-1) as usize] {out.has_ties=true}
  let f=ks_normal_cdf(a[i as usize],mu,sigma)
  if !is_finite(f) || f<0.0 || f>1.0 {return ks_empty(4,n,0)}
  let plus=((i+1) as f64)/nf-f
  let minus=f-(i as f64)/nf
  if plus>d {d=plus}
  if minus>d {d=minus}
  i=i+1
 }
 let p=ks_pvalue(nf,d)
 if !is_finite(p) || p<0.0 || p>1.0 {return ks_empty(4,n,0)}
 out.d=d
 out.p=p
 out.ne=nf
 return out
}
pub fn ks_two(x:&[f64;256],nx:i32,y:&[f64;256],ny:i32)->KSResult with Mut,Div,Panic {
 if nx<1 || nx>256 || ny<1 || ny>256 {return ks_empty(1,nx,ny)}
 var a:[f64;256]=[0.0;256]
 var b:[f64;256]=[0.0;256]
 var i:i32=0
 while i<nx {
  if !is_finite(x[i as usize]) {return ks_empty(2,nx,ny)}
  a[i as usize]=x[i as usize]
  i=i+1
 }
 i=0
 while i<ny {
  if !is_finite(y[i as usize]) {return ks_empty(2,nx,ny)}
  b[i as usize]=y[i as usize]
  i=i+1
 }
 if !sort256(&!a,nx as i64) || !sort256(&!b,ny as i64) {return ks_empty(4,nx,ny)}
 var out=ks_empty(0,nx,ny)
 let nxf=nx as f64
 let nyf=ny as f64
 var ia:i32=0
 var ib:i32=0
 var d=0.0
 while ia<nx || ib<ny {
  var pivot=0.0
  if ia==nx {pivot=b[ib as usize]}
  else if ib==ny {pivot=a[ia as usize]}
  else {pivot=if a[ia as usize]<=b[ib as usize] {a[ia as usize]} else {b[ib as usize]}}
  let before=ia+ib
  while ia<nx && a[ia as usize]==pivot {ia=ia+1}
  while ib<ny && b[ib as usize]==pivot {ib=ib+1}
  if ia+ib-before>1 {out.has_ties=true}
  // Integer-valued products remain exact; avoid cancellation of close ECDFs.
  let gap=ks_abs((ia as f64)*nyf-(ib as f64)*nxf)/(nxf*nyf)
  if gap>d {d=gap}
 }
 let ne=nxf*nyf/(nxf+nyf)
 let p=ks_pvalue(ne,d)
 if !is_finite(p) || p<0.0 || p>1.0 {return ks_empty(4,nx,ny)}
 out.d=d
 out.p=p
 out.ne=ne
 return out
}

// ============================================================================
// INLINE TESTS
// ============================================================================

fn approx(a: f64, b: f64, tol: f64) -> bool {
    let d = if a > b { a - b } else { b - a }
    return d <= tol
}

fn check(name: i64, ok: bool) -> bool with IO {
    if ok { return true }
    print("FAIL at case "); print(name); print("\n")
    return false
}

// One-sample: data {-1,0,1} vs standard normal.
// Φ(-1)=0.158655, Φ(0)=0.5, Φ(1)=0.841345.
// k=0 (x=-1): d+=1/3-0.158655=0.174679; d-=0.158655-0=0.158655
// k=1 (x=0):  d+=2/3-0.5=0.166667;      d-=0.5-1/3=0.166667
// k=2 (x=1):  d+=1-0.841345=0.158655;   d-=0.841345-2/3=0.174679
// D = 0.174679.
fn test_one() -> bool with IO, Mut, Div, Panic {
    var x: [f64; 256] = [0.0; 256]
    x[0] = 0.0 - 1.0; x[1] = 0.0; x[2] = 1.0
    let r = ks_one_normal(&x, 3, 0.0, 1.0)
    var ok = true
    ok = check(1, approx(r.d, 0.174679, 1.0e-4)) && ok
    ok = check(2, r.p > 0.9) && ok            // tiny sample, no evidence against normal
    return ok
}

// Two-sample, fully separated: x={1,2,3}, y={4,5,6} -> ECDFs never overlap, D=1.
fn test_two_separated() -> bool with IO, Mut, Div, Panic {
    var x: [f64; 256] = [0.0; 256]
    var y: [f64; 256] = [0.0; 256]
    x[0]=1.0; x[1]=2.0; x[2]=3.0
    y[0]=4.0; y[1]=5.0; y[2]=6.0
    let r = ks_two(&x, 3, &y, 3)
    var ok = true
    ok = check(10, approx(r.d, 1.0, 1.0e-9)) && ok
    ok = check(11, approx(r.ne, 1.5, 1.0e-9)) && ok   // 3·3/6
    return ok
}

// Two-sample identical samples -> D=0, p=1.
fn test_two_identical() -> bool with IO, Mut, Div, Panic {
    var x: [f64; 256] = [0.0; 256]
    x[0]=1.0; x[1]=2.0; x[2]=3.0; x[3]=4.0
    let r = ks_two(&x, 4, &x, 4)
    var ok = true
    ok = check(20, approx(r.d, 0.0, 1.0e-9)) && ok
    ok = check(21, approx(r.p, 1.0, 1.0e-9)) && ok
    return ok
}

// Two-sample partial overlap: x={1,2,3,4}, y={3,4,5,6}.
// walk: at 1 f1=.25,f2=0 gap .25; at 2 f1=.5 gap .5; at 3 both advance
// f1=.75,f2=.25 gap .5; at 4 f1=1,f2=.5 gap .5; then y 5,6. D=0.5.
fn test_two_overlap() -> bool with IO, Mut, Div, Panic {
    var x: [f64; 256] = [0.0; 256]
    var y: [f64; 256] = [0.0; 256]
    x[0]=1.0; x[1]=2.0; x[2]=3.0; x[3]=4.0
    y[0]=3.0; y[1]=4.0; y[2]=5.0; y[3]=6.0
    let r = ks_two(&x, 4, &y, 4)
    return check(30, approx(r.d, 0.5, 1.0e-9))
}

pub fn run_tests() -> bool with IO, Mut, Div, Panic {
    var ok = true
    ok = test_one() && ok
    ok = test_two_separated() && ok
    ok = test_two_identical() && ok
    ok = test_two_overlap() && ok
    return ok
}

fn main() with IO, Mut, Div, Panic {
    if run_tests() {
        print("ALL PASS\n")
    } else {
        print("SOME FAILED\n")
    }
}
