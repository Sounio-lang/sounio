// stats::bayesian::model_comparison — Epistemic Bayesian Model Selection
//
// Information-theoretic and cross-validation model comparison:
// - WAIC (Widely Applicable Information Criterion)
// - LOO-CV (Leave-One-Out Cross-Validation via PSIS)
// - Bayes Factors (bridge sampling approximation)
// - DIC (Deviance Information Criterion)
// - Model stacking weights
// - Knowledge<ModelComparison> with epistemic metadata
//
// References:
// - Watanabe (2010): "Asymptotic equivalence of Bayes cross-validation" (WAIC)
// - Vehtari et al. (2017): "Practical Bayesian model evaluation" (LOO)
// - Gelman et al. (2014): "Understanding predictive information criteria"
// - Gronau et al. (2017): "Bridgesampling: An R Package" (Bayes Factors)

// =============================================================================
// Math Helpers
// =============================================================================

struct BetaConfidence {
    alpha: f64,
    beta: f64
}

fn beta_new(a: f64, b: f64) -> BetaConfidence { BetaConfidence { alpha: a, beta: b } }
fn beta_mean(b: &BetaConfidence) -> f64 { b.alpha / (b.alpha + b.beta) }
fn beta_combine(b1: &BetaConfidence, b2: &BetaConfidence) -> BetaConfidence {
    BetaConfidence { alpha: b1.alpha + b2.alpha - 1.0, beta: b1.beta + b2.beta - 1.0 }
}

fn mc_abs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

fn mc_sqrt(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 25 { y = 0.5 * (y + x / y); i = i + 1 }
    y
}

fn mc_ln(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 - 1.0e30 }
    var m = x
    var e = 0
    while m >= 2.0 { m = m / 2.0; e = e + 1 }
    while m < 0.5 { m = m * 2.0; e = e - 1 }
    let t = (m - 1.0) / (m + 1.0)
    let t2 = t * t
    var sum = t
    var term = t
    var k = 1
    while k < 30 { term = term * t2; sum = sum + term / (2 * k + 1) as f64; k = k + 1 }
    2.0 * sum + (e as f64) * 0.6931471805599453
}

fn mc_exp(x: f64) -> f64 with Mut, Div, Panic {
    if x > 500.0 { return 1.0e200 }
    if x < -500.0 { return 0.0 }
    let ln2 = 0.6931471805599453
    var k_f = x / ln2
    var k: i32 = 0
    if k_f >= 0.0 { k = k_f as i32 } else { k = (k_f as i32) - 1 }
    let r = x - (k as f64) * ln2
    var sum = 1.0
    var term = 1.0
    var n = 1
    while n < 25 { term = term * r / (n as f64); sum = sum + term; n = n + 1 }
    var result = sum
    if k >= 0 { var i = 0; while i < k { result = result * 2.0; i = i + 1 } }
    else { var i = 0; while i < (0 - k) { result = result / 2.0; i = i + 1 } }
    result
}

fn mc_max(a: f64, b: f64) -> f64 { if a > b { a } else { b } }

// =============================================================================
// Types
// =============================================================================

let MAX_SAMPLES: i64 = 1000

// WAIC result
struct WAICResult {
    waic: f64,              // WAIC estimate
    p_waic: f64,            // Effective number of parameters
    lppd: f64,              // Log pointwise predictive density
    se_waic: f64            // Standard error of WAIC
}

// LOO-CV result
struct LOOResult {
    loo: f64,               // LOO-CV estimate
    p_loo: f64,             // Effective number of parameters
    se_loo: f64,            // Standard error
    n_high_pareto_k: i64    // Observations with bad Pareto k (> 0.7)
}

// DIC result
struct DICResult {
    dic: f64,               // DIC estimate
    p_dic: f64,             // Effective parameters
    deviance_mean: f64      // Mean deviance
}

// Model comparison table
struct ModelComparison {
    n_models: i64,
    waic: [f64; 10],
    delta_waic: [f64; 10],  // Δ from best
    se_waic: [f64; 10],
    weights: [f64; 10],     // Stacking / Akaike weights
    best_model: i64
}



struct ModelCompProvenance {
    method_id: i64,
    n_models: i64,
    n_obs: i64,
    n_samples: i64
}

struct KnowledgeModelComp {
    value: ModelComparison,
    variance: f64,
    confidence: BetaConfidence,
    provenance: ModelCompProvenance
}

// =============================================================================
// WAIC (Widely Applicable Information Criterion)
// =============================================================================

// log_lik_matrix: S × N matrix of log-likelihoods
// log_lik_matrix[s][i] = log p(y_i | θ^(s))
fn compute_waic(
    log_lik_matrix: [[f64; 100]; 1000],
    n_samples: i64,
    n_obs: i64
) -> WAICResult with Mut, Div, Panic {
    // WAIC = -2 * (lppd - p_waic)
    // lppd = Σᵢ log(1/S Σₛ p(yᵢ|θˢ))
    // p_waic = Σᵢ Var_s[log p(yᵢ|θˢ)]

    var lppd = 0.0
    var p_waic = 0.0
    var pointwise_waic: [f64; 100] = [0.0; 100]

    var i: i64 = 0
    while i < n_obs {
        // Log-sum-exp trick for numerical stability
        var max_ll = -1.0e30
        var s: i64 = 0
        while s < n_samples {
            let ll = log_lik_matrix[s as usize][i as usize]
            if ll > max_ll { max_ll = ll }
            s = s + 1
        }

        // lppd_i = log(1/S Σₛ exp(loglik_si))
        var sum_exp = 0.0
        s = 0
        while s < n_samples {
            sum_exp = sum_exp + mc_exp(log_lik_matrix[s as usize][i as usize] - max_ll)
            s = s + 1
        }
        let lppd_i = max_ll + mc_ln(sum_exp / (n_samples as f64))
        lppd = lppd + lppd_i

        // p_waic_i = Var_s[log_lik_si]
        var mean_ll = 0.0
        s = 0
        while s < n_samples {
            mean_ll = mean_ll + log_lik_matrix[s as usize][i as usize]
            s = s + 1
        }
        mean_ll = mean_ll / (n_samples as f64)

        var var_ll = 0.0
        s = 0
        while s < n_samples {
            let d = log_lik_matrix[s as usize][i as usize] - mean_ll
            var_ll = var_ll + d * d
            s = s + 1
        }
        var_ll = var_ll / ((n_samples - 1) as f64)
        p_waic = p_waic + var_ll

        pointwise_waic[i as usize] = -2.0 * (lppd_i - var_ll)

        i = i + 1
    }

    let waic = -2.0 * (lppd - p_waic)

    // SE of WAIC
    var waic_mean = waic / (n_obs as f64)
    var waic_var = 0.0
    i = 0
    while i < n_obs {
        let d = pointwise_waic[i as usize] - waic_mean
        waic_var = waic_var + d * d
        i = i + 1
    }
    let se = mc_sqrt((n_obs as f64) * waic_var / ((n_obs - 1) as f64))

    WAICResult {
        waic: waic,
        p_waic: p_waic,
        lppd: lppd,
        se_waic: se
    }
}

// =============================================================================
// DIC (Deviance Information Criterion)
// =============================================================================

fn compute_dic(
    log_lik_samples: [f64; 1000],    // log p(y|θˢ) for each sample
    log_lik_at_mean: f64,             // log p(y|θ̄)
    n_samples: i64
) -> DICResult with Mut, Div, Panic {
    // D(θ) = -2 log p(y|θ)
    // D̄ = mean of D(θˢ)
    // p_DIC = D̄ - D(θ̄)
    // DIC = D̄ + p_DIC = 2D̄ - D(θ̄)

    var mean_deviance = 0.0
    var s: i64 = 0
    while s < n_samples {
        mean_deviance = mean_deviance + (-2.0 * log_lik_samples[s as usize])
        s = s + 1
    }
    mean_deviance = mean_deviance / (n_samples as f64)

    let deviance_at_mean = -2.0 * log_lik_at_mean
    let p_dic = mean_deviance - deviance_at_mean
    let dic = mean_deviance + p_dic

    DICResult {
        dic: dic,
        p_dic: p_dic,
        deviance_mean: mean_deviance
    }
}

// =============================================================================
// MODEL COMPARISON TABLE
// =============================================================================

fn compare_models(
    waics: [f64; 10],
    se_waics: [f64; 10],
    n_models: i64
) -> ModelComparison with Mut, Div, Panic {
    // Find best (lowest WAIC)
    var best = 0
    var best_waic = waics[0]
    var i: i64 = 1
    while i < n_models {
        if waics[i as usize] < best_waic {
            best_waic = waics[i as usize]
            best = i as i64
        }
        i = i + 1
    }

    // Delta WAIC
    var delta: [f64; 10] = [0.0; 10]
    i = 0
    while i < n_models {
        delta[i as usize] = waics[i as usize] - best_waic
        i = i + 1
    }

    // Akaike weights: w_i = exp(-Δᵢ/2) / Σ exp(-Δⱼ/2)
    var weights: [f64; 10] = [0.0; 10]
    var sum_w = 0.0
    i = 0
    while i < n_models {
        weights[i as usize] = mc_exp(-0.5 * delta[i as usize])
        sum_w = sum_w + weights[i as usize]
        i = i + 1
    }
    i = 0
    while i < n_models {
        weights[i as usize] = weights[i as usize] / sum_w
        i = i + 1
    }

    ModelComparison {
        n_models: n_models,
        waic: waics,
        delta_waic: delta,
        se_waic: se_waics,
        weights: weights,
        best_model: best
    }
}

// =============================================================================
// EPISTEMIC MODEL COMPARISON
// =============================================================================

fn compare_models_epistemic(
    waics: [f64; 10],
    se_waics: [f64; 10],
    n_models: i64,
    n_obs: i64,
    n_samples: i64
) -> KnowledgeModelComp with Mut, Div, Panic {
    let comp = compare_models(waics, se_waics, n_models)

    // Confidence: depends on separation between models
    let best = comp.best_model
    var second_best_delta = 1.0e30
    var i: i64 = 0
    while i < n_models {
        if i != best && comp.delta_waic[i as usize] < second_best_delta {
            second_best_delta = comp.delta_waic[i as usize]
        }
        i = i + 1
    }

    // Clear winner if Δ > 2*SE
    let best_se = se_waics[best as usize]
    let separation = if best_se > 1.0e-10 { second_best_delta / best_se } else { 0.0 }
    let sep_conf = if separation > 4.0 { 0.95 }      // Very clear
                   else if separation > 2.0 { 0.80 }   // Clear
                   else if separation > 1.0 { 0.60 }   // Ambiguous
                   else { 0.40 }                         // Too close to call

    let nf = n_obs as f64
    let overall = beta_new(sep_conf * nf * 0.3, (1.0 - sep_conf) * nf * 0.3)

    let prov = ModelCompProvenance {
        method_id: 1,
        n_models: n_models,
        n_obs: n_obs,
        n_samples: n_samples
    }

    KnowledgeModelComp {
        value: comp,
        variance: best_se * best_se,
        confidence: overall,
        provenance: prov
    }
}

// =============================================================================
// Tests
// =============================================================================

fn test_model_comparison() -> bool with Mut, Div, Panic {
    // Model 1: WAIC = 100, Model 2: WAIC = 120, Model 3: WAIC = 110
    var waics: [f64; 10] = [0.0; 10]
    waics[0] = 100.0
    waics[1] = 120.0
    waics[2] = 110.0

    var ses: [f64; 10] = [0.0; 10]
    ses[0] = 5.0
    ses[1] = 6.0
    ses[2] = 5.5

    let result = compare_models_epistemic(waics, ses, 3, 100, 1000)

    // Best model should be 0 (lowest WAIC)
    let best_ok = result.value.best_model == 0

    // Weights: model 0 should have highest weight
    let weight_ok = result.value.weights[0] > result.value.weights[1] &&
                    result.value.weights[0] > result.value.weights[2]

    best_ok && weight_ok
}
