// Checked compatibility adapters for scientific assumption procedures.
// Read each procedure's status before its numerical payload.
// p-values are not posterior confidence. See the individual stats contracts.
use stats::heteroscedasticity::{KoenkerResult,koenker_bp_simple}
use stats::shapiro_wilk::{ShapiroResult,shapiro_wilk}
use stats::brown_forsythe::{BrownForsytheResult,brown_forsythe}
use stats::anderson_darling::{ADResult,anderson_darling}
pub fn shapiro_wilk_test(data:[f64;100],n:i64)->ShapiroResult with Mut,Div,Panic {
 return shapiro_wilk(&data,n)
}
pub fn levene_test(group1:[f64;100],n1:i64,group2:[f64;100],n2:i64)->BrownForsytheResult with Mut,Div,Panic {
 return brown_forsythe(&group1,n1,&group2,n2)
}
pub fn breusch_pagan_test(residuals:[f64;100],x:[f64;100],n:i64)->KoenkerResult with Mut,Div,Panic {
 return koenker_bp_simple(&residuals,&x,n)
}
// Former private toy adapter is now a public typed result; no p-to-Beta mapping.
pub fn anderson_darling_test(data:[f64;100],n:i64)->ADResult with Mut,Div,Panic {
 var expanded:[f64;256]=[0.0;256]
 // Check before copying or narrowing n to i32.
 if n<3 || n>100 {return anderson_darling(&expanded,0)}
 var i:i64=0
 while i<n {expanded[i as usize]=data[i as usize];i=i+1}
 return anderson_darling(&expanded,n as i32)
}
