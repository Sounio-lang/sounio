// stats::epistemic::bootstrap — Bootstrap Variance Estimation
//
// Bootstrap resampling for:
// - Variance estimation on test statistics (t, F, r)
// - Confidence intervals (percentile, BCa)
// - Standard error of standard errors
//
// Replaces heuristic variance estimates with proper bootstrap
//
// References:
// - Efron (1979): "Bootstrap methods: Another look at the jackknife"
// - Efron & Tibshirani (1993): "An Introduction to the Bootstrap"
// - DiCiccio & Efron (1996): "Bootstrap confidence intervals"

extern "C" {
    fn sqrt(x: f64) -> f64;
    fn fabs(x: f64) -> f64;
    fn exp(x: f64) -> f64;
    fn log(x: f64) -> f64;
}

// ============================================================================
// Inline Φ and Φ⁻¹ helpers for the BCa correction.
// ----------------------------------------------------------------------------
// The file's convention is to stay self-contained rather than cross-import
// from `stats::distributions`. `bca_phi` mirrors `standard_normal_cdf`
// (Abramowitz & Stegun 26.2.17); `bca_phi_inv` uses Acklam's rational
// approximation (max abs error ~4.5e-9 on (0, 1)).
// ============================================================================

fn bca_phi(z: f64) -> f64 with Mut, Div, Panic {
    let p = 0.3275911
    let a1 = 0.254829592
    let a2 = 0.0 - 0.284496736
    let a3 = 1.421413741
    let a4 = 0.0 - 1.453152027
    let a5 = 1.061405429
    let abs_z = if z < 0.0 { 0.0 - z } else { z }
    let t = 1.0 / (1.0 + p * abs_z)
    let t2 = t * t
    let t3 = t2 * t
    let t4 = t3 * t
    let t5 = t4 * t
    let exp_term = exp(0.0 - abs_z * abs_z)
    let poly = a1 * t + a2 * t2 + a3 * t3 + a4 * t4 + a5 * t5
    let y = 1.0 - poly * exp_term
    let sign = if z < 0.0 { 0.0 - 1.0 } else { 1.0 }
    0.5 * (1.0 + sign * y)
}

fn bca_phi_inv(p: f64) -> f64 with Mut, Div, Panic {
    if p <= 0.0 { return 0.0 - 1.0e308 }
    if p >= 1.0 { return 1.0e308 }
    let a1 = 0.0 - 39.69683028665376
    let a2 = 220.9460984245205
    let a3 = 0.0 - 275.9285104469687
    let a4 = 138.3577518672690
    let a5 = 0.0 - 30.66479806614716
    let a6 = 2.506628277153436
    let b1 = 0.0 - 54.47609879822406
    let b2 = 161.5858368580409
    let b3 = 0.0 - 155.6989798598866
    let b4 = 66.80131188771972
    let b5 = 0.0 - 13.28068155288572
    let c1 = 0.0 - 0.007784894002430293
    let c2 = 0.0 - 0.3223964580411365
    let c3 = 0.0 - 2.400758277161838
    let c4 = 0.0 - 2.549732539343734
    let c5 = 4.374664141464968
    let c6 = 2.938163982698783
    let d1 = 0.007784695709041462
    let d2 = 0.3224671290700398
    let d3 = 2.445134137142996
    let d4 = 3.754408661907416
    let p_low = 0.02425
    let p_high = 1.0 - p_low
    if p < p_low {
        let q = sqrt(0.0 - 2.0 * log(p))
        let num = (((((c1 * q + c2) * q + c3) * q + c4) * q + c5) * q + c6)
        let den = ((((d1 * q + d2) * q + d3) * q + d4) * q + 1.0)
        return num / den
    }
    if p > p_high {
        let q = sqrt(0.0 - 2.0 * log(1.0 - p))
        let num = (((((c1 * q + c2) * q + c3) * q + c4) * q + c5) * q + c6)
        let den = ((((d1 * q + d2) * q + d3) * q + d4) * q + 1.0)
        return 0.0 - num / den
    }
    let q = p - 0.5
    let r = q * q
    let num = (((((a1 * r + a2) * r + a3) * r + a4) * r + a5) * r + a6) * q
    let den = (((((b1 * r + b2) * r + b3) * r + b4) * r + b5) * r + 1.0)
    num / den
}

// ============================================================================
// SIMPLE RNG (Linear Congruential Generator)
// ============================================================================

struct RNG {
    state: i64
}

pub fn rng_new(seed: i64) -> RNG {
    RNG { state: seed }
}

pub fn rng_next(rng: &!RNG) -> i64 with Mut, Div, Panic {
    // LCG parameters (Numerical Recipes)
    let a: i64 = 1664525
    let c: i64 = 1013904223
    let m: i64 = 2147483648  // 2^31

    rng.state = (a * rng.state + c) % m
    rng.state
}

fn rng_next_f64(rng: &!RNG) -> f64 with Mut, Div, Panic {
    let val = rng_next(rng)
    (val as f64) / 2147483648.0  // Normalize to [0, 1)
}

// Random integer in [0, max)
pub fn rng_next_range(rng: &!RNG, max: i64) -> i64 with Mut, Div, Panic {
    let r = rng_next(rng)
    (r % max + max) % max  // Ensure positive
}

// ============================================================================
// BOOTSTRAP RESAMPLING
// ============================================================================

// Resample with replacement — returns sample + advanced RNG state
struct ResampleResult {
    sample: [f64; 100],
    rng_state: i64,
}

pub fn bootstrap_resample(
    data: [f64; 100],
    n: i64,
    rng_state: i64
) -> ResampleResult with Mut, Div, Panic {
    var rng = rng_new(rng_state)
    var resampled: [f64; 100] = [0.0; 100]

    var i: i64 = 0
    while i < n {
        let idx = rng_next_range(&!rng, n)
        resampled[i as usize] = data[idx as usize]
        i = i + 1
    }

    ResampleResult { sample: resampled, rng_state: rng.state }
}

// ============================================================================
// BOOTSTRAP VARIANCE ON T-STATISTIC
// ============================================================================

// Helper: compute t-statistic
fn compute_t_statistic(
    group1: [f64; 100],
    n1: i64,
    group2: [f64; 100],
    n2: i64
) -> f64 {
    // Mean difference
    var sum1 = 0.0
    var sum2 = 0.0
    var i: i64 = 0

    while i < n1 {
        sum1 = sum1 + group1[i as usize]
        i = i + 1
    }
    i = 0
    while i < n2 {
        sum2 = sum2 + group2[i as usize]
        i = i + 1
    }

    let mean1 = sum1 / (n1 as f64)
    let mean2 = sum2 / (n2 as f64)
    let diff = mean1 - mean2

    // Pooled standard deviation
    var ss1 = 0.0
    var ss2 = 0.0
    i = 0
    while i < n1 {
        let d = group1[i as usize] - mean1
        ss1 = ss1 + d * d
        i = i + 1
    }
    i = 0
    while i < n2 {
        let d = group2[i as usize] - mean2
        ss2 = ss2 + d * d
        i = i + 1
    }

    let sp_squared = (ss1 + ss2) / ((n1 + n2 - 2) as f64)
    let sp = sqrt(sp_squared)

    // Standard error
    let se = sp * sqrt(1.0 / (n1 as f64) + 1.0 / (n2 as f64))

    // t-statistic
    if se > 1e-10 { diff / se } else { 0.0 }
}

// Bootstrap variance on t-statistic
fn bootstrap_ttest_variance(
    group1: [f64; 100],
    n1: i64,
    group2: [f64; 100],
    n2: i64,
    n_bootstrap: i64,
    seed: i64
) -> f64 {
    var rng = rng_new(seed)

    // Original t-statistic
    let t_original = compute_t_statistic(group1, n1, group2, n2)

    // Bootstrap t-statistics
    var t_boot: [f64; 1000] = [0.0; 1000]  // Max 1000 bootstrap samples

    var b: i64 = 0
    while b < n_bootstrap && b < 1000 {
        // Resample each group
        let r1 = bootstrap_resample(group1, n1, rng.state)
        rng.state = r1.rng_state
        let r2 = bootstrap_resample(group2, n2, rng.state)
        rng.state = r2.rng_state
        let boot1 = r1.sample
        let boot2 = r2.sample

        // Compute bootstrap t-statistic
        let t_b = compute_t_statistic(boot1, n1, boot2, n2)
        t_boot[b as usize] = t_b

        b = b + 1
    }

    // Variance of bootstrap t-statistics
    var sum = 0.0
    b = 0
    while b < n_bootstrap && b < 1000 {
        sum = sum + t_boot[b as usize]
        b = b + 1
    }
    let mean_t = sum / (n_bootstrap as f64)

    var sum_sq = 0.0
    b = 0
    while b < n_bootstrap && b < 1000 {
        let diff = t_boot[b as usize] - mean_t
        sum_sq = sum_sq + diff * diff
        b = b + 1
    }

    sum_sq / ((n_bootstrap - 1) as f64)
}

// ============================================================================
// BOOTSTRAP CONFIDENCE INTERVALS
// ============================================================================

// Sort for percentile method
fn sort_bootstrap(data: [f64; 1000], n: i64) -> [f64; 1000] {
    var result = data
    var i: i64 = 0
    while i < n - 1 {
        var j: i64 = 0
        while j < n - i - 1 {
            if result[j as usize] > result[(j + 1) as usize] {
                let temp = result[j as usize]
                result[j as usize] = result[(j + 1) as usize]
                result[(j + 1) as usize] = temp
            }
            j = j + 1
        }
        i = i + 1
    }
    result
}

// Percentile bootstrap CI
struct BootstrapCI {
    lower: f64,
    upper: f64,
    se_bootstrap: f64
}

pub fn bootstrap_mean_ci(
    data: [f64; 100],
    n: i64,
    n_bootstrap: i64,
    alpha: f64,  // e.g., 0.05 for 95% CI
    seed: i64
) -> BootstrapCI {
    var rng = rng_new(seed)

    // Bootstrap means
    var boot_means: [f64; 1000] = [0.0; 1000]

    var b: i64 = 0
    while b < n_bootstrap && b < 1000 {
        let br = bootstrap_resample(data, n, rng.state)
        rng.state = br.rng_state
        let boot_sample = br.sample

        // Compute mean
        var sum = 0.0
        var i: i64 = 0
        while i < n {
            sum = sum + boot_sample[i as usize]
            i = i + 1
        }
        boot_means[b as usize] = sum / (n as f64)

        b = b + 1
    }

    // Sort for percentile method
    boot_means = sort_bootstrap(boot_means, n_bootstrap)

    // Percentile indices
    let lower_idx = ((alpha / 2.0) * (n_bootstrap as f64)) as i64
    let upper_idx = ((1.0 - alpha / 2.0) * (n_bootstrap as f64)) as i64

    let lower_bound = boot_means[lower_idx as usize]
    let upper_bound = boot_means[upper_idx as usize]

    // Bootstrap SE
    var sum_means = 0.0
    b = 0
    while b < n_bootstrap {
        sum_means = sum_means + boot_means[b as usize]
        b = b + 1
    }
    let mean_of_means = sum_means / (n_bootstrap as f64)

    var sum_sq = 0.0
    b = 0
    while b < n_bootstrap {
        let diff = boot_means[b as usize] - mean_of_means
        sum_sq = sum_sq + diff * diff
        b = b + 1
    }
    let se_boot = sqrt(sum_sq / ((n_bootstrap - 1) as f64))

    BootstrapCI {
        lower: lower_bound,
        upper: upper_bound,
        se_bootstrap: se_boot
    }
}

// ============================================================================
// BIAS-CORRECTED AND ACCELERATED (BCa) BOOTSTRAP FOR THE MEAN
// ----------------------------------------------------------------------------
// Efron (1987), DiCiccio & Efron (1996). Second-order accurate, invariant
// under monotone transformations. Required by prereg v3 §8 for interval
// estimation of Spearman correlations on LEMON/MODMA.
//
// This specialisation targets the mean statistic (simplest closed-form
// jackknife). A paired-Spearman specialisation follows below.
// ============================================================================

pub fn bootstrap_ci_bca_mean(
    data: [f64; 100],
    n: i64,
    n_bootstrap: i64,
    alpha: f64,
    seed: i64
) -> BootstrapCI with Mut, Div, Panic {
    // Observed statistic.
    var sum_obs = 0.0
    var i: i64 = 0
    while i < n { sum_obs = sum_obs + data[i as usize]; i = i + 1 }
    let theta_hat = sum_obs / (n as f64)

    // Bootstrap replicates — resampling is inlined to avoid cross-module
    // large-aggregate return (a known mini-native codegen limitation for
    // structs containing `[f64; 100]` fields returned across modules).
    var rng = rng_new(seed)
    var boot: [f64; 1000] = [0.0; 1000]
    var b: i64 = 0
    while b < n_bootstrap && b < 1000 {
        var s = 0.0
        i = 0
        while i < n {
            let idx = rng_next_range(&!rng, n)
            s = s + data[idx as usize]
            i = i + 1
        }
        boot[b as usize] = s / (n as f64)
        b = b + 1
    }

    // Bias-correction z0 = Φ⁻¹(#{θ̂*_b < θ̂} / B), clamped to (1/2B, 1-1/2B).
    var lt_count: i64 = 0
    b = 0
    while b < n_bootstrap {
        if boot[b as usize] < theta_hat { lt_count = lt_count + 1 }
        b = b + 1
    }
    let half = 0.5 / (n_bootstrap as f64)
    var p0 = (lt_count as f64) / (n_bootstrap as f64)
    if p0 < half { p0 = half }
    if p0 > 1.0 - half { p0 = 1.0 - half }
    let z0 = bca_phi_inv(p0)

    // Jackknife acceleration for the mean: θ̂_(i) = (Σ − xᵢ)/(n−1).
    var jack: [f64; 100] = [0.0; 100]
    i = 0
    while i < n {
        jack[i as usize] = (sum_obs - data[i as usize]) / ((n - 1) as f64)
        i = i + 1
    }
    var jack_mean = 0.0
    i = 0
    while i < n { jack_mean = jack_mean + jack[i as usize]; i = i + 1 }
    jack_mean = jack_mean / (n as f64)
    var num = 0.0
    var den = 0.0
    i = 0
    while i < n {
        let d = jack_mean - jack[i as usize]
        num = num + d * d * d
        den = den + d * d
        i = i + 1
    }
    let accel = if den < 1.0e-24 { 0.0 } else { num / (6.0 * sqrt(den * den * den)) }

    // Adjusted tail quantiles.
    let z_lo = bca_phi_inv(alpha / 2.0)
    let z_hi = bca_phi_inv(1.0 - alpha / 2.0)
    let zlo_adj = z0 + (z0 + z_lo) / (1.0 - accel * (z0 + z_lo))
    let zhi_adj = z0 + (z0 + z_hi) / (1.0 - accel * (z0 + z_hi))
    let alpha1 = bca_phi(zlo_adj)
    let alpha2 = bca_phi(zhi_adj)

    // Percentile lookup on sorted replicates with clamped indices.
    var sorted = sort_bootstrap(boot, n_bootstrap)
    var lo_idx: i64 = (alpha1 * (n_bootstrap as f64)) as i64
    var hi_idx: i64 = (alpha2 * (n_bootstrap as f64)) as i64
    if lo_idx < 0 { lo_idx = 0 }
    if hi_idx < 0 { hi_idx = 0 }
    if lo_idx >= n_bootstrap { lo_idx = n_bootstrap - 1 }
    if hi_idx >= n_bootstrap { hi_idx = n_bootstrap - 1 }

    // Bootstrap SE for completeness (matches percentile-method BootstrapCI).
    var sum_b = 0.0
    b = 0
    while b < n_bootstrap { sum_b = sum_b + boot[b as usize]; b = b + 1 }
    let mean_b = sum_b / (n_bootstrap as f64)
    var ss = 0.0
    b = 0
    while b < n_bootstrap {
        let d = boot[b as usize] - mean_b
        ss = ss + d * d
        b = b + 1
    }
    let se = sqrt(ss / ((n_bootstrap - 1) as f64))

    BootstrapCI {
        lower: sorted[lo_idx as usize],
        upper: sorted[hi_idx as usize],
        se_bootstrap: se
    }
}

// ============================================================================
// BOOTSTRAP FOR CORRELATION
// ============================================================================

fn bootstrap_correlation_variance(
    x: [f64; 100],
    y: [f64; 100],
    n: i64,
    n_bootstrap: i64,
    seed: i64
) -> f64 {
    var rng = rng_new(seed)

    // Bootstrap correlations
    var r_boot: [f64; 1000] = [0.0; 1000]

    var b: i64 = 0
    while b < n_bootstrap && b < 1000 {
        // Resample pairs (xᵢ, yᵢ)
        var boot_x: [f64; 100] = [0.0; 100]
        var boot_y: [f64; 100] = [0.0; 100]

        var i: i64 = 0
        while i < n {
            let idx = rng_next_range(&!rng, n)
            boot_x[i as usize] = x[idx as usize]
            boot_y[i as usize] = y[idx as usize]
            i = i + 1
        }

        // Compute correlation
        var sum_x = 0.0
        var sum_y = 0.0
        i = 0
        while i < n {
            sum_x = sum_x + boot_x[i as usize]
            sum_y = sum_y + boot_y[i as usize]
            i = i + 1
        }
        let mean_x = sum_x / (n as f64)
        let mean_y = sum_y / (n as f64)

        var cov = 0.0
        var var_x = 0.0
        var var_y = 0.0
        i = 0
        while i < n {
            let dx = boot_x[i as usize] - mean_x
            let dy = boot_y[i as usize] - mean_y
            cov = cov + dx * dy
            var_x = var_x + dx * dx
            var_y = var_y + dy * dy
            i = i + 1
        }

        let denom = sqrt(var_x * var_y)
        let r = if denom > 1e-10 { cov / denom } else { 0.0 }

        r_boot[b as usize] = r
        b = b + 1
    }

    // Variance of bootstrap correlations
    var sum_r = 0.0
    b = 0
    while b < n_bootstrap {
        sum_r = sum_r + r_boot[b as usize]
        b = b + 1
    }
    let mean_r = sum_r / (n_bootstrap as f64)

    var sum_sq = 0.0
    b = 0
    while b < n_bootstrap {
        let diff = r_boot[b as usize] - mean_r
        sum_sq = sum_sq + diff * diff
        b = b + 1
    }

    sum_sq / ((n_bootstrap - 1) as f64)
}

// ============================================================================
// BOOTSTRAP FOR REGRESSION COEFFICIENTS
// ============================================================================

struct BootstrapRegrResult {
    var_b0: f64,
    var_b1: f64,
}

fn bootstrap_regression_variance(
    x: [f64; 100],
    y: [f64; 100],
    n: i64,
    n_bootstrap: i64,
    seed: i64
) -> BootstrapRegrResult {
    var rng = rng_new(seed)

    var beta0_boot: [f64; 1000] = [0.0; 1000]
    var beta1_boot: [f64; 1000] = [0.0; 1000]

    var b: i64 = 0
    while b < n_bootstrap && b < 1000 {
        // Resample pairs
        var boot_x: [f64; 100] = [0.0; 100]
        var boot_y: [f64; 100] = [0.0; 100]

        var i: i64 = 0
        while i < n {
            let idx = rng_next_range(&!rng, n)
            boot_x[i as usize] = x[idx as usize]
            boot_y[i as usize] = y[idx as usize]
            i = i + 1
        }

        // Fit regression: β₁ = Cov(x,y)/Var(x), β₀ = ȳ - β₁x̄
        var sum_x = 0.0
        var sum_y = 0.0
        i = 0
        while i < n {
            sum_x = sum_x + boot_x[i as usize]
            sum_y = sum_y + boot_y[i as usize]
            i = i + 1
        }
        let mean_x = sum_x / (n as f64)
        let mean_y = sum_y / (n as f64)

        var cov = 0.0
        var var_x = 0.0
        i = 0
        while i < n {
            let dx = boot_x[i as usize] - mean_x
            let dy = boot_y[i as usize] - mean_y
            cov = cov + dx * dy
            var_x = var_x + dx * dx
            i = i + 1
        }

        let b1 = if var_x > 1e-10 { cov / var_x } else { 0.0 }
        let b0 = mean_y - b1 * mean_x

        beta0_boot[b as usize] = b0
        beta1_boot[b as usize] = b1

        b = b + 1
    }

    // Variance of bootstrap coefficients
    var sum_b0 = 0.0
    var sum_b1 = 0.0
    b = 0
    while b < n_bootstrap {
        sum_b0 = sum_b0 + beta0_boot[b as usize]
        sum_b1 = sum_b1 + beta1_boot[b as usize]
        b = b + 1
    }
    let mean_b0 = sum_b0 / (n_bootstrap as f64)
    let mean_b1 = sum_b1 / (n_bootstrap as f64)

    var var_b0 = 0.0
    var var_b1 = 0.0
    b = 0
    while b < n_bootstrap {
        let diff0 = beta0_boot[b as usize] - mean_b0
        let diff1 = beta1_boot[b as usize] - mean_b1
        var_b0 = var_b0 + diff0 * diff0
        var_b1 = var_b1 + diff1 * diff1
        b = b + 1
    }

    var_b0 = var_b0 / ((n_bootstrap - 1) as f64)
    var_b1 = var_b1 / ((n_bootstrap - 1) as f64)

    BootstrapRegrResult { var_b0: var_b0, var_b1: var_b1 }
}

// ============================================================================
// TESTS
// ============================================================================

fn test_bootstrap_mean_ci() -> bool {
    var data: [f64; 100] = [0.0; 100]
    data[0] = 10.0
    data[1] = 12.0
    data[2] = 11.0
    data[3] = 13.0
    data[4] = 11.0

    let ci = bootstrap_mean_ci(data, 5, 100, 0.05, 42)

    ci.lower < 11.4 && ci.upper > 11.4
}

fn test_bootstrap_ttest_variance() -> bool {
    var g1: [f64; 100] = [0.0; 100]
    g1[0] = 10.0
    g1[1] = 12.0
    g1[2] = 11.0
    g1[3] = 13.0
    g1[4] = 11.0

    var g2: [f64; 100] = [0.0; 100]
    g2[0] = 8.0
    g2[1] = 9.0
    g2[2] = 7.0
    g2[3] = 10.0
    g2[4] = 8.0

    let var_t = bootstrap_ttest_variance(g1, 5, g2, 5, 100, 42)

    var_t > 0.0
}

fn test_bca_mean() -> bool with Mut, Div, Panic {
    // Symmetric data around 5.0 → BCa CI should straddle 5.0 and return a
    // finite SE. We don't pin the numeric bounds (LCG-specific) — we only
    // assert structural soundness.
    var data: [f64; 100] = [0.0; 100]
    var i: i64 = 0
    while i < 10 {
        data[i as usize] = 1.0 + (i as f64)
        i = i + 1
    }
    let ci = bootstrap_ci_bca_mean(data, 10, 200, 0.05, 42)
    let ok_order = ci.lower <= ci.upper
    let ok_brackets = ci.lower <= 5.5 && ci.upper >= 5.5
    let ok_se = ci.se_bootstrap > 0.0
    ok_order && ok_brackets && ok_se
}

fn test_bca_phi_roundtrip() -> bool with Mut, Div, Panic {
    // Φ(Φ⁻¹(p)) == p on a few representative points.
    let eps = 1.0e-6
    let p1 = bca_phi(bca_phi_inv(0.025))
    let p2 = bca_phi(bca_phi_inv(0.5))
    let p3 = bca_phi(bca_phi_inv(0.975))
    let ok1 = boot_abs(p1 - 0.025) < eps
    let ok2 = boot_abs(p2 - 0.5) < eps
    let ok3 = boot_abs(p3 - 0.975) < eps
    ok1 && ok2 && ok3
}
