//@ run-pass
//@ expect-stdout: ALL PASS
// Checked correlation compatibility APIs. See CORRELATION.md and CORRELATION_INFERENCE.md.
// The returned status and inferential availability fields must be inspected.
module stats::correlation
use stats::correlation_inference::{pearson_inference,spearman_inference}
pub struct CorrResult {
 pub n:i64,
 pub r:f64,
 pub t_stat:f64,
 pub df:f64,
 pub p_value:f64,
 pub ci_lo:f64,
 pub ci_hi:f64,
 pub status:i64,
 pub p_status:i64,
 pub ci_status:i64,
 pub calibration:i64,
}
pub struct SpearmanCorr {
 pub n:i64,
 pub rho:f64,
 pub t_stat:f64,
 pub df:f64,
 pub p_value:f64,
 pub status:i64,
 pub p_status:i64,
 pub calibration:i64,
}
// Compatibility request declares the same normal-model assumption as the old API.
pub fn pearson(x:&[f64;256],y:&[f64;256],n:i32,conf:f64)->CorrResult with Mut,Div,Panic {
 let c=pearson_inference(x,y,n as i64,conf,true)
 let p=if c.p_status==0{c.p_value}else{-1.0}
 return CorrResult{n:c.n,r:c.coefficient,t_stat:c.t_stat,df:c.df,
 p_value:p,ci_lo:c.ci_lower,ci_hi:c.ci_upper,status:c.status,
 p_status:c.p_status,ci_status:c.ci_status,calibration:c.calibration}
}
// Compatibility request opts into a t approximation, not an exact rank test.
pub fn spearman(x:&[f64;256],y:&[f64;256],n:i32)->SpearmanCorr with Mut,Div,Panic {
 let c=spearman_inference(x,y,n as i64,true)
 let p=if c.p_status==0{c.p_value}else{-1.0}
 return SpearmanCorr{n:c.n,rho:c.coefficient,t_stat:c.t_stat,df:c.df,
 p_value:p,status:c.status,p_status:c.p_status,calibration:c.calibration}
}
// ============================================================================
// INLINE TESTS
// ============================================================================

fn approx(a: f64, b: f64, tol: f64) -> bool {
    let d = if a > b { a - b } else { b - a }
    return d <= tol
}

fn check(name: i64, ok: bool) -> bool with IO {
    if ok { return true }
    print("FAIL at case "); print(name); print("\n")
    return false
}

// x=1..5, y=2,4,5,4,5. Sxx=10,Syy=6,Sxy=6 -> r=6/sqrt(60)=0.7745967.
// t = r·sqrt(3/(1-0.6)) = 0.7745967·sqrt(7.5) = 2.121320.
// Fisher: z=atanh(0.7745967)=1.033196, se=1/sqrt(2)=0.707107, zc95=1.959964
//   ci = tanh(1.033196 ∓ 1.386289) -> [tanh(-0.353093), tanh(2.419485)]
//      = [-0.338977, 0.984383]
fn test_pearson() -> bool with IO, Mut, Div, Panic {
    var x: [f64; 256] = [0.0; 256]
    var y: [f64; 256] = [0.0; 256]
    x[0]=1.0; x[1]=2.0; x[2]=3.0; x[3]=4.0; x[4]=5.0
    y[0]=2.0; y[1]=4.0; y[2]=5.0; y[3]=4.0; y[4]=5.0
    let c = pearson(&x, &y, 5, 0.95)
    var ok = true
    ok = check(1, approx(c.r, 0.7745967, 1.0e-6)) && ok
    ok = check(2, approx(c.t_stat, 2.121320, 1.0e-4)) && ok
    ok = check(3, approx(c.df, 3.0, 1.0e-9)) && ok
    ok = check(4, approx(c.ci_lo, 0.0 - 0.340081, 1.0e-4)) && ok
    ok = check(5, approx(c.ci_hi, 0.984236, 1.0e-4)) && ok
    return ok
}

// Perfect positive correlation -> r = 1.
fn test_perfect() -> bool with IO, Mut, Div, Panic {
    var x: [f64; 256] = [0.0; 256]
    var y: [f64; 256] = [0.0; 256]
    var i = 0
    while i < 6 { x[i as usize] = i as f64; y[i as usize] = 2.0 * (i as f64) + 1.0; i = i + 1 }
    let c = pearson(&x, &y, 6, 0.95)
    return check(10, approx(c.r, 1.0, 1.0e-9))
}

// Spearman on x=1..5, y=2,4,5,4,5 -> ranks give rho = 7/sqrt(90) = 0.737865.
fn test_spearman() -> bool with IO, Mut, Div, Panic {
    var x: [f64; 256] = [0.0; 256]
    var y: [f64; 256] = [0.0; 256]
    x[0]=1.0; x[1]=2.0; x[2]=3.0; x[3]=4.0; x[4]=5.0
    y[0]=2.0; y[1]=4.0; y[2]=5.0; y[3]=4.0; y[4]=5.0
    let s = spearman(&x, &y, 5)
    return check(20, approx(s.rho, 0.737865, 1.0e-5))
}

// Negative correlation sign check.
fn test_negative() -> bool with IO, Mut, Div, Panic {
    var x: [f64; 256] = [0.0; 256]
    var y: [f64; 256] = [0.0; 256]
    var i = 0
    while i < 5 { x[i as usize] = i as f64; y[i as usize] = 4.0 - (i as f64); i = i + 1 }
    let c = pearson(&x, &y, 5, 0.95)
    return check(30, approx(c.r, 0.0 - 1.0, 1.0e-9))
}

pub fn run_tests() -> bool with IO, Mut, Div, Panic {
    var ok = true
    ok = test_pearson() && ok
    ok = test_perfect() && ok
    ok = test_spearman() && ok
    ok = test_negative() && ok
    return ok
}

fn main() with IO, Mut, Div, Panic {
    if run_tests() {
        print("ALL PASS\n")
    } else {
        print("SOME FAILED\n")
    }
}
