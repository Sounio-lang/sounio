// stats::causal::propensity — Epistemic Causal Inference
//
// Propensity score methods for observational causal inference:
// - Propensity score estimation (logistic regression)
// - Nearest-neighbor matching
// - Inverse probability weighting (IPW)
// - Average Treatment Effect (ATE, ATT)
// - Covariate balance assessment
// - Knowledge<CausalEffect> with epistemic metadata
//
// Also includes:
// - Mediation analysis (natural direct/indirect effects)
// - Sensitivity analysis (E-values)
//
// References:
// - Rosenbaum & Rubin (1983): "The central role of the propensity score"
// - Austin (2011): "An introduction to propensity score methods"
// - VanderWeele & Ding (2017): "Sensitivity analysis via the E-value"
// - Baron & Kenny (1986): "Moderator-mediator variables" (mediation)

// =============================================================================
// Math Helpers
// =============================================================================

fn cs_abs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

fn cs_sqrt(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 25 { y = 0.5 * (y + x / y); i = i + 1 }
    y
}

fn cs_ln(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 - 1.0e30 }
    var m = x
    var e = 0
    while m >= 2.0 { m = m / 2.0; e = e + 1 }
    while m < 0.5 { m = m * 2.0; e = e - 1 }
    let t = (m - 1.0) / (m + 1.0)
    let t2 = t * t
    var sum = t
    var term = t
    var k = 1
    while k < 30 { term = term * t2; sum = sum + term / (2 * k + 1) as f64; k = k + 1 }
    2.0 * sum + (e as f64) * 0.6931471805599453
}

fn cs_exp(x: f64) -> f64 with Mut, Div, Panic {
    if x > 500.0 { return 1.0e200 }
    if x < -500.0 { return 0.0 }
    let ln2 = 0.6931471805599453
    var k_f = x / ln2
    var k: i32 = 0
    if k_f >= 0.0 { k = k_f as i32 } else { k = (k_f as i32) - 1 }
    let r = x - (k as f64) * ln2
    var sum = 1.0
    var term = 1.0
    var n = 1
    while n < 25 { term = term * r / (n as f64); sum = sum + term; n = n + 1 }
    var result = sum
    if k >= 0 { var i = 0; while i < k { result = result * 2.0; i = i + 1 } }
    else { var i = 0; while i < (0 - k) { result = result / 2.0; i = i + 1 } }
    result
}

fn sigmoid(z: f64) -> f64 with Mut, Div, Panic {
    if z > 20.0 { return 1.0 - 1.0e-10 }
    if z < -20.0 { return 1.0e-10 }
    1.0 / (1.0 + cs_exp(0.0 - z))
}

fn cs_max(a: f64, b: f64) -> f64 { if a > b { a } else { b } }
fn cs_min(a: f64, b: f64) -> f64 { if a < b { a } else { b } }

// =============================================================================
// Types
// =============================================================================

struct CausalEffect {
    ate: f64,               // Average Treatment Effect
    att: f64,               // Average Treatment Effect on Treated
    se_ate: f64,
    se_att: f64,
    ci_ate_lower: f64,
    ci_ate_upper: f64,
    ci_att_lower: f64,
    ci_att_upper: f64,
    n_treated: i64,
    n_control: i64,
    n_matched: i64           // After matching
}

struct CovariateBalance {
    smd_before: [f64; 10],   // Standardized mean differences (before matching)
    smd_after: [f64; 10],    // After matching
    n_covariates: i64,
    balanced: bool            // All |SMD| < 0.1 after matching
}

struct PropensityScores {
    scores: [f64; 100],
    treatment: [i64; 100],   // 0 or 1
    n: i64
}

struct EValueResult {
    e_value_point: f64,      // E-value for point estimate
    e_value_ci: f64,         // E-value for CI bound
    robust_to_confounding: bool
}

struct MediationResult {
    total_effect: f64,
    direct_effect: f64,       // Natural direct effect (NDE)
    indirect_effect: f64,     // Natural indirect effect (NIE)
    proportion_mediated: f64,
    se_indirect: f64
}

struct BetaConfidence {
    alpha: f64,
    beta: f64
}

fn beta_new(a: f64, b: f64) -> BetaConfidence { BetaConfidence { alpha: a, beta: b } }
fn beta_mean(b: &BetaConfidence) -> f64 { b.alpha / (b.alpha + b.beta) }
fn beta_combine(b1: &BetaConfidence, b2: &BetaConfidence) -> BetaConfidence {
    BetaConfidence { alpha: b1.alpha + b2.alpha - 1.0, beta: b1.beta + b2.beta - 1.0 }
}

struct CausalDiagnostics {
    overlap_adequate: BetaConfidence,     // Propensity score overlap
    balance_achieved: BetaConfidence,     // Covariate balance
    positivity: BetaConfidence,           // P(T=1|X) bounded away from 0,1
    no_unmeasured_confounding: BetaConfidence
}

struct CausalProvenance {
    method: String,
    n_treated: i64,
    n_control: i64,
    n_matched: i64,
    diagnostics: CausalDiagnostics,
    e_value: EValueResult
}

struct KnowledgeCausal {
    value: CausalEffect,
    variance: f64,
    confidence: BetaConfidence,
    provenance: CausalProvenance
}

// =============================================================================
// PROPENSITY SCORE ESTIMATION
// =============================================================================

fn estimate_propensity_scores(
    covariate: [f64; 100],    // Single covariate (for simplicity)
    treatment: [i64; 100],    // 0 or 1
    n: i64
) -> PropensityScores with Mut, Div, Panic {
    // Logistic regression: logit(P(T=1)) = β₀ + β₁·X

    // Count treated
    var n_t: i64 = 0
    var i: i64 = 0
    while i < n {
        if treatment[i as usize] == 1 { n_t = n_t + 1 }
        i = i + 1
    }
    let p_bar = (n_t as f64) / (n as f64)

    // Simple logistic fit (5 IRLS iterations)
    var beta0 = cs_ln(p_bar / (1.0 - p_bar))
    var beta1 = 0.0

    var iter = 0
    while iter < 10 {
        var sw = 0.0
        var swx = 0.0
        var swy = 0.0
        var swxx = 0.0
        var swxy = 0.0

        i = 0
        while i < n {
            let eta = beta0 + beta1 * covariate[i as usize]
            let p = sigmoid(eta)
            let w = p * (1.0 - p)
            if w < 1.0e-10 { i = i + 1; continue }
            let z = eta + ((treatment[i as usize] as f64) - p) / w
            let xi = covariate[i as usize]

            sw = sw + w
            swx = swx + w * xi
            swy = swy + w * z
            swxx = swxx + w * xi * xi
            swxy = swxy + w * xi * z
            i = i + 1
        }

        let det = sw * swxx - swx * swx
        if cs_abs(det) < 1.0e-10 { break }
        beta0 = (swxx * swy - swx * swxy) / det
        beta1 = (sw * swxy - swx * swy) / det
        iter = iter + 1
    }

    var scores: [f64; 100] = [0.0; 100]
    i = 0
    while i < n {
        scores[i as usize] = sigmoid(beta0 + beta1 * covariate[i as usize])
        i = i + 1
    }

    PropensityScores {
        scores: scores,
        treatment: treatment,
        n: n
    }
}

// =============================================================================
// NEAREST-NEIGHBOR MATCHING
// =============================================================================

fn match_nearest_neighbor(
    ps: &PropensityScores,
    outcome: [f64; 100],
    caliper: f64
) -> CausalEffect with Mut, Div, Panic {
    let n = ps.n

    // For each treated, find nearest control
    var matched_treated: [f64; 50] = [0.0; 50]
    var matched_control: [f64; 50] = [0.0; 50]
    var n_matched: i64 = 0

    var used_control: [bool; 100] = [false; 100]

    var i: i64 = 0
    while i < n {
        if ps.treatment[i as usize] != 1 { i = i + 1; continue }

        // Find nearest unused control
        var best_j: i64 = -1
        var best_dist = 1.0e30

        var j: i64 = 0
        while j < n {
            if ps.treatment[j as usize] != 0 || used_control[j as usize] {
                j = j + 1
                continue
            }

            let dist = cs_abs(ps.scores[i as usize] - ps.scores[j as usize])
            if dist < best_dist && dist < caliper {
                best_dist = dist
                best_j = j
            }
            j = j + 1
        }

        if best_j >= 0 && n_matched < 50 {
            matched_treated[n_matched as usize] = outcome[i as usize]
            matched_control[n_matched as usize] = outcome[best_j as usize]
            used_control[best_j as usize] = true
            n_matched = n_matched + 1
        }

        i = i + 1
    }

    // ATT = mean(Y_treated - Y_matched_control)
    var sum_diff = 0.0
    var sum_diff_sq = 0.0
    i = 0
    while i < n_matched {
        let d = matched_treated[i as usize] - matched_control[i as usize]
        sum_diff = sum_diff + d
        sum_diff_sq = sum_diff_sq + d * d
        i = i + 1
    }

    let att = if n_matched > 0 { sum_diff / (n_matched as f64) } else { 0.0 }
    let var_att = if n_matched > 1 {
        (sum_diff_sq / (n_matched as f64) - att * att) / ((n_matched - 1) as f64)
    } else { 0.0 }
    let se_att = cs_sqrt(var_att)

    // Count treated and control
    var n_t: i64 = 0
    var n_c: i64 = 0
    i = 0
    while i < n {
        if ps.treatment[i as usize] == 1 { n_t = n_t + 1 }
        else { n_c = n_c + 1 }
        i = i + 1
    }

    CausalEffect {
        ate: att,  // Simplified: ATT ≈ ATE under no effect modification
        att: att,
        se_ate: se_att,
        se_att: se_att,
        ci_ate_lower: att - 1.96 * se_att,
        ci_ate_upper: att + 1.96 * se_att,
        ci_att_lower: att - 1.96 * se_att,
        ci_att_upper: att + 1.96 * se_att,
        n_treated: n_t,
        n_control: n_c,
        n_matched: n_matched
    }
}

// =============================================================================
// E-VALUE (Sensitivity Analysis)
// =============================================================================

fn compute_e_value(rr: f64, ci_bound: f64) -> EValueResult with Mut, Div, Panic {
    // E-value = RR + √(RR × (RR - 1))
    // Measures minimum confounding strength to explain away effect

    let e_point = if rr >= 1.0 {
        rr + cs_sqrt(rr * (rr - 1.0))
    } else {
        let inv_rr = 1.0 / rr
        inv_rr + cs_sqrt(inv_rr * (inv_rr - 1.0))
    }

    let e_ci = if ci_bound >= 1.0 {
        ci_bound + cs_sqrt(ci_bound * (ci_bound - 1.0))
    } else if ci_bound > 0.0 {
        let inv_ci = 1.0 / ci_bound
        inv_ci + cs_sqrt(inv_ci * (inv_ci - 1.0))
    } else { 1.0 }

    // Robust if E-value > 2 (confounding would need to be strong)
    let robust = e_point > 2.0 && e_ci > 1.5

    EValueResult {
        e_value_point: e_point,
        e_value_ci: e_ci,
        robust_to_confounding: robust
    }
}

// =============================================================================
// MEDIATION ANALYSIS
// =============================================================================

fn mediation_analysis(
    treatment: [f64; 100],   // 0 or 1 (as f64)
    mediator: [f64; 100],
    outcome: [f64; 100],
    n: i64
) -> MediationResult with Mut, Div, Panic {
    // Baron & Kenny (1986) approach:
    // Path a: T → M (regression)
    // Path b: M → Y (controlling for T)
    // Path c: T → Y (total)
    // Path c': T → Y (controlling for M, direct)
    // Indirect = a × b = c - c'

    // Path c: total effect (simple regression Y ~ T)
    var sum_t = 0.0
    var sum_y = 0.0
    var sum_tt = 0.0
    var sum_ty = 0.0
    var i: i64 = 0
    while i < n {
        sum_t = sum_t + treatment[i as usize]
        sum_y = sum_y + outcome[i as usize]
        sum_tt = sum_tt + treatment[i as usize] * treatment[i as usize]
        sum_ty = sum_ty + treatment[i as usize] * outcome[i as usize]
        i = i + 1
    }
    let nf = n as f64
    let mean_t = sum_t / nf
    let mean_y = sum_y / nf
    let cov_ty = sum_ty / nf - mean_t * mean_y
    let var_t = sum_tt / nf - mean_t * mean_t
    let total_effect = if var_t > 1.0e-10 { cov_ty / var_t } else { 0.0 }

    // Path a: T → M
    var sum_m = 0.0
    var sum_tm = 0.0
    i = 0
    while i < n {
        sum_m = sum_m + mediator[i as usize]
        sum_tm = sum_tm + treatment[i as usize] * mediator[i as usize]
        i = i + 1
    }
    let mean_m = sum_m / nf
    let cov_tm = sum_tm / nf - mean_t * mean_m
    let a_path = if var_t > 1.0e-10 { cov_tm / var_t } else { 0.0 }

    // Path b and c': M → Y and T → Y (multiple regression)
    // Simplified: b = Cor(M,Y|T) · SD(Y|T) / SD(M|T)
    // Using residualized approach
    var sum_mm = 0.0
    var sum_my = 0.0
    i = 0
    while i < n {
        sum_mm = sum_mm + mediator[i as usize] * mediator[i as usize]
        sum_my = sum_my + mediator[i as usize] * outcome[i as usize]
        i = i + 1
    }
    let var_m = sum_mm / nf - mean_m * mean_m
    let cov_my = sum_my / nf - mean_m * mean_y
    let b_path = if var_m > 1.0e-10 { cov_my / var_m } else { 0.0 }

    let indirect_effect = a_path * b_path
    let direct_effect = total_effect - indirect_effect

    let prop_mediated = if cs_abs(total_effect) > 1.0e-10 {
        indirect_effect / total_effect
    } else { 0.0 }

    // SE of indirect effect (Sobel test)
    // SE(a*b) ≈ √(a²·SE(b)² + b²·SE(a)²)
    // Simplified: use heuristic
    let se_indirect = cs_abs(indirect_effect) * 0.2  // ~20% relative SE

    MediationResult {
        total_effect: total_effect,
        direct_effect: direct_effect,
        indirect_effect: indirect_effect,
        proportion_mediated: prop_mediated,
        se_indirect: se_indirect
    }
}

// =============================================================================
// EPISTEMIC CAUSAL INFERENCE
// =============================================================================

fn propensity_matching_epistemic(
    covariate: [f64; 100],
    treatment: [i64; 100],
    outcome: [f64; 100],
    n: i64
) -> KnowledgeCausal with Mut, Div, Panic {
    let ps = estimate_propensity_scores(covariate, treatment, n)
    let effect = match_nearest_neighbor(&ps, outcome, 0.2)

    // Check overlap
    var min_ps_t = 1.0
    var max_ps_t = 0.0
    var min_ps_c = 1.0
    var max_ps_c = 0.0
    var i: i64 = 0
    while i < n {
        let s = ps.scores[i as usize]
        if treatment[i as usize] == 1 {
            min_ps_t = cs_min(min_ps_t, s)
            max_ps_t = cs_max(max_ps_t, s)
        } else {
            min_ps_c = cs_min(min_ps_c, s)
            max_ps_c = cs_max(max_ps_c, s)
        }
        i = i + 1
    }

    let overlap = cs_max(0.0, cs_min(max_ps_t, max_ps_c) - cs_max(min_ps_t, min_ps_c))
    let range = cs_max(max_ps_t, max_ps_c) - cs_min(min_ps_t, min_ps_c)
    let overlap_prop = if range > 1.0e-10 { overlap / range } else { 0.0 }

    let overlap_conf = if overlap_prop > 0.80 { 0.90 }
                       else if overlap_prop > 0.50 { 0.70 }
                       else { 0.40 }
    let overlap_beta = beta_new(overlap_conf * (n as f64) * 0.3, (1.0 - overlap_conf) * (n as f64) * 0.3)

    // Match rate
    let match_rate = (effect.n_matched as f64) / (effect.n_treated as f64)
    let match_conf = if match_rate > 0.90 { 0.90 }
                     else if match_rate > 0.70 { 0.75 }
                     else { 0.50 }
    let match_beta = beta_new(match_conf * (n as f64) * 0.3, (1.0 - match_conf) * (n as f64) * 0.3)

    // E-value
    let rr = if cs_abs(effect.att) > 0.0 { cs_exp(cs_abs(effect.att)) } else { 1.0 }
    let e_val = compute_e_value(rr, 1.0)

    // Positivity
    let positivity_conf = if min_ps_t > 0.05 && (1.0 - max_ps_c) > 0.05 { 0.90 }
                          else { 0.60 }
    let positivity_beta = beta_new(positivity_conf * (n as f64) * 0.3, (1.0 - positivity_conf) * (n as f64) * 0.3)

    // No unmeasured confounding (always uncertain; E-value gives sensitivity)
    let confound_conf = if e_val.robust_to_confounding { 0.70 } else { 0.40 }
    let confound_beta = beta_new(confound_conf * (n as f64) * 0.3, (1.0 - confound_conf) * (n as f64) * 0.3)

    let diag = CausalDiagnostics {
        overlap_adequate: overlap_beta,
        balance_achieved: match_beta,
        positivity: positivity_beta,
        no_unmeasured_confounding: confound_beta
    }

    let c1 = beta_combine(&overlap_beta, &match_beta)
    let c2 = beta_combine(&c1, &positivity_beta)
    let overall = beta_combine(&c2, &confound_beta)

    let prov = CausalProvenance {
        method: "PropensityScoreMatching",
        n_treated: effect.n_treated,
        n_control: effect.n_control,
        n_matched: effect.n_matched,
        diagnostics: diag,
        e_value: e_val
    }

    KnowledgeCausal {
        value: effect,
        variance: effect.se_att * effect.se_att,
        confidence: overall,
        provenance: prov
    }
}

// =============================================================================
// Tests
// =============================================================================

fn test_propensity_matching() -> bool with Mut, Div, Panic {
    // Treatment: higher covariate → more likely treated
    var cov: [f64; 100] = [0.0; 100]
    var trt: [i64; 100] = [0; 100]
    var outcome: [f64; 100] = [0.0; 100]

    // Control group (low covariate, low outcome)
    cov[0] = 1.0; trt[0] = 0; outcome[0] = 5.0
    cov[1] = 2.0; trt[1] = 0; outcome[1] = 6.0
    cov[2] = 3.0; trt[2] = 0; outcome[2] = 7.0
    cov[3] = 2.5; trt[3] = 0; outcome[3] = 6.5
    cov[4] = 1.5; trt[4] = 0; outcome[4] = 5.5

    // Treated group (higher covariate, higher outcome)
    cov[5] = 4.0; trt[5] = 1; outcome[5] = 12.0
    cov[6] = 5.0; trt[6] = 1; outcome[6] = 13.0
    cov[7] = 3.5; trt[7] = 1; outcome[7] = 11.0
    cov[8] = 4.5; trt[8] = 1; outcome[8] = 12.5
    cov[9] = 5.5; trt[9] = 1; outcome[9] = 14.0

    let result = propensity_matching_epistemic(cov, trt, outcome, 10)

    // ATT should be positive (treatment increases outcome)
    let effect_positive = result.value.att > 0.0

    // Some matches should be made
    let matched_ok = result.value.n_matched > 0

    effect_positive && matched_ok
}

fn test_e_value() -> bool with Mut, Div, Panic {
    // Strong effect: RR = 3.0
    let e1 = compute_e_value(3.0, 1.5)
    let strong_ok = e1.e_value_point > 4.0  // Strong E-value

    // Weak effect: RR = 1.2
    let e2 = compute_e_value(1.2, 0.9)
    let weak_ok = e2.e_value_point < 2.0  // Weak E-value

    strong_ok && weak_ok
}

fn test_mediation() -> bool with Mut, Div, Panic {
    var treatment: [f64; 100] = [0.0; 100]
    var mediator: [f64; 100] = [0.0; 100]
    var outcome: [f64; 100] = [0.0; 100]

    // T → M → Y (full mediation)
    treatment[0] = 0.0; mediator[0] = 1.0; outcome[0] = 2.0
    treatment[1] = 0.0; mediator[1] = 1.5; outcome[1] = 3.0
    treatment[2] = 1.0; mediator[2] = 3.0; outcome[2] = 6.0
    treatment[3] = 1.0; mediator[3] = 3.5; outcome[3] = 7.0
    treatment[4] = 0.0; mediator[4] = 1.2; outcome[4] = 2.5
    treatment[5] = 1.0; mediator[5] = 2.8; outcome[5] = 5.5

    let result = mediation_analysis(treatment, mediator, outcome, 6)

    // Should find indirect effect
    let indirect_ok = cs_abs(result.indirect_effect) > 0.0

    indirect_ok
}
