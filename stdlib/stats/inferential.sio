use stats::correlation_core::{spearman_checked}
use stats::correlation_inference::{spearman_inference}
// stats::inferential — Inferential Statistics with Uncertainty
//
// Public t-tests carry estimates, standard errors, t-calibrated 95% intervals,
// sample sizes, method identity, p-values and explicit result status.
// Other procedures retain their own approximation and validation contracts.
//
// References:
// - Student (1908): "The probable error of a mean"
// - Welch (1947): "The generalization of Student's problem"
// - Mann & Whitney (1947): "On a test of whether one of two random variables..."

use stats::student_t::{t_two_tail, t_ci_multiplier}
use math::pure::{sqrt, is_finite}
use stats::fisher_f::{f_sf}

extern "C" {
    fn exp(x: f64) -> f64;
    fn log(x: f64) -> f64;
    fn pow(x: f64, y: f64) -> f64;
    fn fabs(x: f64) -> f64;
}

// ============================================================================
// TEST RESULT TYPES
// ============================================================================

// Result of a t-test
pub struct TTestResult {
    pub t_stat: f64,        // t-statistic
    pub df: f64,            // degrees of freedom
    pub p_value: f64,       // two-tailed p-value
    pub mean_diff: f64,     // difference in means
    pub se_diff: f64,       // standard error of difference
    pub ci_lower: f64,      // 95% CI lower bound
    pub ci_upper: f64,      // 95% CI upper bound
    pub cohens_d: f64,      // effect size (Cohen's d)
    pub status: i64,
    pub confidence_level: f64,
    pub method: i64,
    pub n_x: i64,
    pub n_y: i64,
}

fn ttest_result_new() -> TTestResult {
    TTestResult {
        status: 1,
        confidence_level: 0.95,
        method: 0,
        n_x: 0,
        n_y: 0,
        t_stat: 0.0,
        df: 0.0,
        p_value: 1.0,
        mean_diff: 0.0,
        se_diff: 0.0,
        ci_lower: 0.0,
        ci_upper: 0.0,
        cohens_d: 0.0,
    }
}

// Result of ANOVA
struct AnovaResult {
    f_stat: f64,        // F-statistic
    df_between: i64,    // between-group df
    df_within: i64,     // within-group df
    p_value: f64,       // p-value
    ss_between: f64,    // sum of squares between
    ss_within: f64,     // sum of squares within
    eta_squared: f64,   // effect size (eta^2)
}

fn anova_result_new() -> AnovaResult {
    AnovaResult {
        f_stat: 0.0,
        df_between: 0,
        df_within: 0,
        p_value: 1.0,
        ss_between: 0.0,
        ss_within: 0.0,
        eta_squared: 0.0,
    }
}

// Result of Mann-Whitney U test
struct MannWhitneyResult {
    u_stat: f64,        // U statistic
    z_stat: f64,        // z-score (normal approx)
    p_value: f64,       // two-tailed p-value
    rank_biserial: f64, // effect size (r)
}

fn mannwhitney_result_new() -> MannWhitneyResult {
    MannWhitneyResult {
        u_stat: 0.0,
        z_stat: 0.0,
        p_value: 1.0,
        rank_biserial: 0.0,
    }
}

// ============================================================================
// HELPER FUNCTIONS
// ============================================================================

fn mean(data: [f64; 100], n: i64) -> f64 {
    var sum = 0.0
    var i: i64 = 0
    while i < n {
        sum = sum + data[i as usize]
        i = i + 1
    }
    sum / (n as f64)
}

fn variance(data: [f64; 100], n: i64) -> f64 {
    let m = mean(data, n)
    var sum_sq = 0.0
    var i: i64 = 0
    while i < n {
        let diff = data[i as usize] - m
        sum_sq = sum_sq + diff * diff
        i = i + 1
    }
    sum_sq / ((n - 1) as f64)
}

fn std_dev(data: [f64; 100], n: i64) -> f64 with Mut, Div, Panic {
    sqrt(variance(data, n))
}

// Two-sided Student probability; retains the degrees of freedom.
fn t_to_p(t: f64, df: f64) -> f64 with Mut, Div, Panic {
    t_two_tail(t, df)
}

// Upper-tail Fisher probability via the direct incomplete-beta complement.
fn f_to_p(f: f64, df1: i64, df2: i64) -> f64 with Mut, Div, Panic {
    f_sf(f, df1 as f64, df2 as f64)
}

// Approximate p-value from z-score (normal distribution)
fn z_to_p(z: f64) -> f64 {
    let abs_z = if z < 0.0 { -z } else { z }

    // Error function approximation
    let a1 = 0.254829592
    let a2 = -0.284496736
    let a3 = 1.421413741
    let a4 = -1.453152027
    let a5 = 1.061405429
    let p = 0.3275911

    let t = 1.0 / (1.0 + p * abs_z)
    let erf = 1.0 - (((((a5 * t + a4) * t) + a3) * t + a2) * t + a1) * t * exp(-abs_z * abs_z)

    // Two-tailed p-value
    1.0 - erf
}

// ============================================================================
// T-TESTS
// ============================================================================

// Public t-tests use fixed 95% confidence intervals and observable status.
// Numerical fields are meaningful only when status == T_TEST_OK.
pub let T_TEST_OK: i64 = 0
pub let T_TEST_INVALID_SAMPLE: i64 = 1
pub let T_TEST_NONFINITE: i64 = 2
pub let T_TEST_ZERO_VARIANCE: i64 = 3
pub let T_TEST_NUMERIC_FAILURE: i64 = 4
pub let T_METHOD_ONE_SAMPLE: i64 = 1
pub let T_METHOD_POOLED: i64 = 2
pub let T_METHOD_WELCH: i64 = 3
pub let T_METHOD_PAIRED: i64 = 4

struct TSampleMoments {
    mean: f64,
    variance: f64,
    status: i64,
}

// Welford moments avoid the cancellation of E[x*x] - E[x]^2.
fn t_sample_moments(data: &[f64; 100], n: i64) -> TSampleMoments with Mut, Div, Panic {
    var r = TSampleMoments { mean: 0.0, variance: 0.0, status: T_TEST_INVALID_SAMPLE }
    if n < 2 || n > 100 { return r }
    var m: f64 = 0.0
    var m2: f64 = 0.0
    var i: i64 = 0
    while i < n {
        let x = data[i as usize]
        if !is_finite(x) { r.status = T_TEST_NONFINITE; return r }
        let delta = x - m
        m = m + delta / ((i + 1) as f64)
        m2 = m2 + delta * (x - m)
        i = i + 1
    }
    r.mean = m
    r.variance = m2 / ((n - 1) as f64)
    r.status = T_TEST_OK
    if !is_finite(m) || !is_finite(r.variance) || r.variance < 0.0 { r.status = T_TEST_NUMERIC_FAILURE }
    r
}

fn t_test_finish(result: TTestResult, effect_sd: f64) -> TTestResult with Mut, Div, Panic {
    var r = result
    if !is_finite(r.mean_diff) || !is_finite(r.se_diff) || !is_finite(r.df) || r.df < 1.0 {
        r.status = T_TEST_NUMERIC_FAILURE
        return r
    }
    if r.se_diff <= 0.0 || effect_sd <= 0.0 {
        r.status = T_TEST_ZERO_VARIANCE
        return r
    }
    r.t_stat = r.mean_diff / r.se_diff
    r.p_value = t_to_p(r.t_stat, r.df)
    let critical = t_ci_multiplier(0.95, r.df)
    let half_width = critical * r.se_diff
    r.ci_lower = r.mean_diff - half_width
    r.ci_upper = r.mean_diff + half_width
    r.cohens_d = r.mean_diff / effect_sd
    r.status = T_TEST_OK
    if !is_finite(r.t_stat) || !is_finite(r.p_value) || r.p_value < 0.0 || r.p_value > 1.0 ||
       !is_finite(critical) || critical <= 0.0 || !is_finite(r.ci_lower) ||
       !is_finite(r.ci_upper) || !is_finite(r.cohens_d) {
        r.status = T_TEST_NUMERIC_FAILURE
    }
    r
}

/// One-sample t-test; CI is for mean(data) - mu0, not the uncentered mean.
pub fn t_test_one_sample(data: [f64; 100], n: i64, mu0: f64) -> TTestResult with Mut, Div, Panic {
    var r = ttest_result_new()
    r.method = T_METHOD_ONE_SAMPLE; r.n_x = n
    if !is_finite(mu0) { r.status = T_TEST_NONFINITE; return r }
    let sample = t_sample_moments(&data, n)
    if sample.status != T_TEST_OK { r.status = sample.status; return r }
    r.mean_diff = sample.mean - mu0
    r.df = (n - 1) as f64
    let sd = sqrt(sample.variance)
    r.se_diff = sd / sqrt(n as f64)
    t_test_finish(r, sd)
}

/// Equal-variance independent-samples t-test; CI is for mean(x) - mean(y).
pub fn t_test_independent(x: [f64; 100], nx: i64, y: [f64; 100], ny: i64) -> TTestResult with Mut, Div, Panic {
    var r = ttest_result_new()
    r.method = T_METHOD_POOLED; r.n_x = nx; r.n_y = ny
    let a = t_sample_moments(&x, nx)
    let b = t_sample_moments(&y, ny)
    if a.status != T_TEST_OK { r.status = a.status; return r }
    if b.status != T_TEST_OK { r.status = b.status; return r }
    r.mean_diff = a.mean - b.mean
    r.df = (nx + ny - 2) as f64
    let pooled = ((nx - 1) as f64) / r.df * a.variance + ((ny - 1) as f64) / r.df * b.variance
    let sd = sqrt(pooled)
    r.se_diff = sd * sqrt(1.0 / (nx as f64) + 1.0 / (ny as f64))
    t_test_finish(r, sd)
}

/// Welch test with scaled Satterthwaite df; fractional df are retained.
/// cohens_d uses sqrt((sample_variance_x + sample_variance_y)/2).
pub fn t_test_welch(x: [f64; 100], nx: i64, y: [f64; 100], ny: i64) -> TTestResult with Mut, Div, Panic {
    var r = ttest_result_new()
    r.method = T_METHOD_WELCH; r.n_x = nx; r.n_y = ny
    let a = t_sample_moments(&x, nx)
    let b = t_sample_moments(&y, ny)
    if a.status != T_TEST_OK { r.status = a.status; return r }
    if b.status != T_TEST_OK { r.status = b.status; return r }
    r.mean_diff = a.mean - b.mean
    let va = a.variance / (nx as f64)
    let vb = b.variance / (ny as f64)
    let total = va + vb
    if total <= 0.0 { r.status = T_TEST_ZERO_VARIANCE; return r }
    if !is_finite(total) { r.status = T_TEST_NUMERIC_FAILURE; return r }
    let wa = va / total
    let wb = vb / total
    r.df = 1.0 / (wa * wa / ((nx - 1) as f64) + wb * wb / ((ny - 1) as f64))
    r.se_diff = sqrt(total)
    let effect_sd = sqrt(0.5 * a.variance + 0.5 * b.variance)
    t_test_finish(r, effect_sd)
}

/// Paired t-test on x-y; a constant difference has undefined t significance.
pub fn t_test_paired(x: [f64; 100], y: [f64; 100], n: i64) -> TTestResult with Mut, Div, Panic {
    var r = ttest_result_new()
    r.method = T_METHOD_PAIRED; r.n_x = n; r.n_y = n
    if n < 2 || n > 100 { return r }
    var diff: [f64; 100] = [0.0; 100]
    var i: i64 = 0
    while i < n {
        if !is_finite(x[i as usize]) || !is_finite(y[i as usize]) { r.status = T_TEST_NONFINITE; return r }
        diff[i as usize] = x[i as usize] - y[i as usize]
        if !is_finite(diff[i as usize]) { r.status = T_TEST_NUMERIC_FAILURE; return r }
        i = i + 1
    }
    var answer = t_test_one_sample(diff, n, 0.0)
    answer.method = T_METHOD_PAIRED
    answer.n_x = n; answer.n_y = n
    answer
}

// ============================================================================
// ANOVA
// ============================================================================

// One-way ANOVA for 3 groups
fn anova_oneway_3(g1: [f64; 100], n1: i64,
                  g2: [f64; 100], n2: i64,
                  g3: [f64; 100], n3: i64) -> AnovaResult with Mut, Div, Panic {
    var result = anova_result_new()

    let n_total = n1 + n2 + n3
    let k = 3  // number of groups

    // Group means
    let m1 = mean(g1, n1)
    let m2 = mean(g2, n2)
    let m3 = mean(g3, n3)

    // Grand mean
    var sum_total = 0.0
    var i: i64 = 0
    while i < n1 {
        sum_total = sum_total + g1[i as usize]
        i = i + 1
    }
    i = 0
    while i < n2 {
        sum_total = sum_total + g2[i as usize]
        i = i + 1
    }
    i = 0
    while i < n3 {
        sum_total = sum_total + g3[i as usize]
        i = i + 1
    }
    let grand_mean = sum_total / (n_total as f64)

    // SS between
    result.ss_between = (n1 as f64) * (m1 - grand_mean) * (m1 - grand_mean)
                      + (n2 as f64) * (m2 - grand_mean) * (m2 - grand_mean)
                      + (n3 as f64) * (m3 - grand_mean) * (m3 - grand_mean)

    // SS within
    result.ss_within = 0.0
    i = 0
    while i < n1 {
        let diff = g1[i as usize] - m1
        result.ss_within = result.ss_within + diff * diff
        i = i + 1
    }
    i = 0
    while i < n2 {
        let diff = g2[i as usize] - m2
        result.ss_within = result.ss_within + diff * diff
        i = i + 1
    }
    i = 0
    while i < n3 {
        let diff = g3[i as usize] - m3
        result.ss_within = result.ss_within + diff * diff
        i = i + 1
    }

    result.df_between = k - 1
    result.df_within = n_total - k

    // Mean squares
    let ms_between = result.ss_between / (result.df_between as f64)
    let ms_within = result.ss_within / (result.df_within as f64)

    if ms_within > 1e-10 {
        result.f_stat = ms_between / ms_within
    }

    result.p_value = f_to_p(result.f_stat, result.df_between, result.df_within)

    // Eta squared
    let ss_total = result.ss_between + result.ss_within
    if ss_total > 1e-10 {
        result.eta_squared = result.ss_between / ss_total
    }

    result
}

// ============================================================================
// NON-PARAMETRIC TESTS
// ============================================================================

// Mann-Whitney U test (Wilcoxon rank-sum)
fn mann_whitney_u(x: [f64; 100], nx: i64, y: [f64; 100], ny: i64) -> MannWhitneyResult with Mut, Div, Panic {
    var result = mannwhitney_result_new()

    // Combine and rank
    // For simplicity, count pairwise comparisons
    var u_x = 0.0

    var i: i64 = 0
    while i < nx {
        var j: i64 = 0
        while j < ny {
            if x[i as usize] > y[j as usize] {
                u_x = u_x + 1.0
            } else if x[i as usize] == y[j as usize] {
                u_x = u_x + 0.5
            }
            j = j + 1
        }
        i = i + 1
    }

    let u_y = (nx as f64) * (ny as f64) - u_x
    result.u_stat = if u_x < u_y { u_x } else { u_y }

    // Normal approximation for z-score
    let n_xy = (nx as f64) * (ny as f64)
    let mu_u = n_xy / 2.0
    let sigma_u = sqrt(n_xy * ((nx + ny + 1) as f64) / 12.0)

    if sigma_u > 1e-10 {
        result.z_stat = (u_x - mu_u) / sigma_u
    }

    result.p_value = z_to_p(result.z_stat)

    // Rank-biserial correlation (effect size)
    if n_xy > 0.0 {
        result.rank_biserial = (2.0 * u_x - n_xy) / n_xy
    }

    result
}

// ============================================================================
// SPEARMAN RANK CORRELATION
// ============================================================================

// Result of Spearman rho test
pub struct SpearmanResult {
    pub status:i64,
    pub p_status:i64,
    pub calibration:i64,
    pub rho: f64,     // rank correlation in [-1, 1]
    pub t_stat: f64,  // t = rho * sqrt((n - 2) / (1 - rho^2))
    pub p_value: f64, // two-sided t approximation with n-2 df; not a permutation p-value
    pub df: f64,
}

fn spearman_result_new() -> SpearmanResult {
    SpearmanResult {
        status:1, p_status:1, calibration:0,
        rho: 0.0,
        t_stat: 0.0,
        p_value: -1.0,
        df: 0.0,
    }
}

// Checked adapters for the fixed100 legacy surface. No copy before size validation.
pub fn spearman_rho(x:[f64;100],y:[f64;100],n:i64)->f64 with Mut,Div,Panic {
 if n<2 || n>100 {return -2.0}
 var xx:[f64;256]=[0.0;256]
 var yy:[f64;256]=[0.0;256]
 var i:i64=0
 while i<n {xx[i as usize]=x[i as usize];yy[i as usize]=y[i as usize];i=i+1}
 let c=spearman_checked(&xx,&yy,n)
 if c.status!=0{return -2.0}
 return c.coefficient
}
pub fn spearman_test(x:[f64;100],y:[f64;100],n:i64)->SpearmanResult with Mut,Div,Panic {
 var result=spearman_result_new()
 if n<2 || n>100 {return result}
 var xx:[f64;256]=[0.0;256]
 var yy:[f64;256]=[0.0;256]
 var i:i64=0
 while i<n {xx[i as usize]=x[i as usize];yy[i as usize]=y[i as usize];i=i+1}
 let c=spearman_inference(&xx,&yy,n,true)
 result.status=c.status
 result.p_status=c.p_status
 result.calibration=c.calibration
 result.rho=c.coefficient
 result.t_stat=c.t_stat
 result.df=c.df
 if c.p_status==0{result.p_value=c.p_value}
 return result
}

// ============================================================================
// EFFECT SIZE INTERPRETATION
// ============================================================================

// Cohen's d interpretation
fn cohens_d_interpret(d: f64) -> i64 {
    let abs_d = if d < 0.0 { -d } else { d }
    if abs_d < 0.2 {
        return 0  // negligible
    }
    if abs_d < 0.5 {
        return 1  // small
    }
    if abs_d < 0.8 {
        return 2  // medium
    }
    3  // large
}

// Eta-squared interpretation
fn eta_squared_interpret(eta2: f64) -> i64 {
    if eta2 < 0.01 {
        return 0  // negligible
    }
    if eta2 < 0.06 {
        return 1  // small
    }
    if eta2 < 0.14 {
        return 2  // medium
    }
    3  // large
}

// ============================================================================
// TESTS
// ============================================================================

fn inf_abs_f64(x: f64) -> f64 {
    if x < 0.0 { -x } else { x }
}

fn test_one_sample_t() -> bool with Mut, Div, Panic {
    var data: [f64; 100] = [0.0; 100]
    data[0] = 5.0
    data[1] = 6.0
    data[2] = 7.0
    data[3] = 8.0
    data[4] = 9.0

    // Mean = 7, test against mu0 = 7 -> t should be ~0
    let result = t_test_one_sample(data, 5, 7.0)

    inf_abs_f64(result.t_stat) < 0.01
}

fn test_independent_t() -> bool with Mut, Div, Panic {
    var x: [f64; 100] = [0.0; 100]
    var y: [f64; 100] = [0.0; 100]

    // Group 1: mean = 10
    x[0] = 9.0
    x[1] = 10.0
    x[2] = 11.0
    x[3] = 10.0
    x[4] = 10.0

    // Group 2: mean = 15
    y[0] = 14.0
    y[1] = 15.0
    y[2] = 16.0
    y[3] = 15.0
    y[4] = 15.0

    let result = t_test_independent(x, 5, y, 5)

    // mean_diff should be -5
    inf_abs_f64(result.mean_diff - (-5.0)) < 0.1
}

fn test_paired_t() -> bool with Mut, Div, Panic {
    var pre: [f64; 100] = [0.0; 100]
    var post: [f64; 100] = [0.0; 100]

    // Pre-treatment: 100, 102, 104, 101, 103
    pre[0] = 100.0
    pre[1] = 102.0
    pre[2] = 104.0
    pre[3] = 101.0
    pre[4] = 103.0

    // Post-treatment: 95, 97, 99, 96, 98 (decrease of 5)
    post[0] = 95.0
    post[1] = 97.0
    post[2] = 99.0
    post[3] = 96.0
    post[4] = 98.0

    let result = t_test_paired(pre, post, 5)

    // mean difference should be 5
    inf_abs_f64(result.mean_diff - 5.0) < 0.1
}

fn test_mann_whitney() -> bool with Mut, Div, Panic {
    var x: [f64; 100] = [0.0; 100]
    var y: [f64; 100] = [0.0; 100]

    // Group with lower values
    x[0] = 1.0
    x[1] = 2.0
    x[2] = 3.0

    // Group with higher values
    y[0] = 4.0
    y[1] = 5.0
    y[2] = 6.0

    let result = mann_whitney_u(x, 3, y, 3)

    // With separated groups, the smaller U is zero.
    result.u_stat == 0.0
}

fn test_spearman_rho_perfect() -> bool with Mut, Div, Panic {
    var x: [f64; 100] = [0.0; 100]
    var y: [f64; 100] = [0.0; 100]
    var i: i64 = 0
    while i < 10 {
        x[i as usize] = i as f64
        y[i as usize] = 2.0 * (i as f64) + 1.0
        i = i + 1
    }
    // Monotone-increasing pair → rho == +1 exactly.
    let rho = spearman_rho(x, y, 10)
    inf_abs_f64(rho - 1.0) < 1.0e-9
}

fn test_spearman_rho_reversed() -> bool with Mut, Div, Panic {
    var x: [f64; 100] = [0.0; 100]
    var y: [f64; 100] = [0.0; 100]
    var i: i64 = 0
    while i < 10 {
        x[i as usize] = i as f64
        y[i as usize] = 0.0 - (i as f64)
        i = i + 1
    }
    // Monotone-decreasing pair → rho == -1 exactly.
    let rho = spearman_rho(x, y, 10)
    inf_abs_f64(rho + 1.0) < 1.0e-9
}

fn test_spearman_ties() -> bool with Mut, Div, Panic {
    var x: [f64; 100] = [0.0; 100]
    var y: [f64; 100] = [0.0; 100]
    // Two tied blocks in x, matching ties in y.
    x[0] = 1.0
    x[1] = 1.0
    x[2] = 2.0
    x[3] = 2.0
    x[4] = 3.0
    y[0] = 5.0
    y[1] = 5.0
    y[2] = 6.0
    y[3] = 6.0
    y[4] = 7.0
    let rho = spearman_rho(x, y, 5)
    // Ranks are identical after tie averaging → rho == +1.
    inf_abs_f64(rho - 1.0) < 1.0e-9
}
