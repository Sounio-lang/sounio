// stdlib/display/event.sio — Window event types
//
// Thin Sounio wrapper over X11 event codes.
// kind constants match X11 event type bytes (2=KeyPress, etc.)

// Event kind constants
let EV_NONE:          i64 = 0
let EV_KEY_PRESS:     i64 = 1
let EV_KEY_RELEASE:   i64 = 2
let EV_MOUSE_PRESS:   i64 = 3
let EV_MOUSE_RELEASE: i64 = 4
let EV_CLOSE:         i64 = 5
let EV_EXPOSE:        i64 = 6
let EV_MOTION:        i64 = 7

// Key constants (X11 keysyms for ASCII range pass through as-is;
// special keys use values below 32)
let KEY_ESCAPE:  i64 = 27
let KEY_RETURN:  i64 = 13
let KEY_TAB:     i64 = 9
let KEY_SPACE:   i64 = 32
let KEY_LEFT:    i64 = 1
let KEY_RIGHT:   i64 = 2
let KEY_UP:      i64 = 3
let KEY_DOWN:    i64 = 4
let KEY_BACKSPACE: i64 = 8
let KEY_DELETE:  i64 = 127

// Mouse button constants
let MOUSE_LEFT:   i64 = 1
let MOUSE_MIDDLE: i64 = 2
let MOUSE_RIGHT:  i64 = 3

pub struct Event {
    pub kind: i64,    // EV_* constant
    pub key: i64,     // keysym (key events) or button number (mouse events)
    pub x: i64,       // cursor X (mouse events) or 0
    pub y: i64,       // cursor Y (mouse events) or 0
    pub mods: i64,    // modifier bits (shift=1, ctrl=4, alt=8)
}

pub fn event_none() -> Event {
    Event { kind: 0, key: 0, x: 0, y: 0, mods: 0 }
}

pub fn event_is_key(ev: Event, k: i64) -> bool {
    ev.kind == EV_KEY_PRESS && ev.key == k
}

pub fn event_is_close(ev: Event) -> bool {
    ev.kind == EV_CLOSE
}
