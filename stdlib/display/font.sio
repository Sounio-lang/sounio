// stdlib/display/font.sio — 8×8 bitmap font (ASCII 32-127)
//
// Each character is 8 rows × 8 pixels packed into one i64: low byte = top row,
// and bit 0 = leftmost pixel in each row. See FONT_BITMAP.md.
// Public-domain font8x8_basic by Daniel Hepper, derived from Marcel Sondaar/IBM.
// Pinned source: dhepper/font8x8@8e279d2d864e79128e96188a6b9526cfa3fbfef9.
// Generated from the vendored primary byte table by C++23 under Slurm16413;
// there is no runtime dependency on the reference header.
//
// fn font_glyph(ch: i64) -> i64   — returns 8-row bitmask for character
// fn font_draw_char(pixels, width, height, ch, px, py, r, g, b)
// fn font_draw_string(pixels, width, height, s, len, px, py, r, g, b)

// Returns an 8-byte glyph packed as i64 (row 0 in bits 7-0, row 1 in bits 15-8, ...).
// ASCII 32 (space) through 127 (DEL) are supported; others render as space.
pub fn font_glyph(ch: i64) -> i64 {
    if ch == 32 { 0x0000000000000000 }
    else if ch == 33 { 0x00180018183c3c18 }
    else if ch == 34 { 0x0000000000003636 }
    else if ch == 35 { 0x0036367f367f3636 }
    else if ch == 36 { 0x000c1f301e033e0c }
    else if ch == 37 { 0x0063660c18336300 }
    else if ch == 38 { 0x006e333b6e1c361c }
    else if ch == 39 { 0x0000000000030606 }
    else if ch == 40 { 0x00180c0606060c18 }
    else if ch == 41 { 0x00060c1818180c06 }
    else if ch == 42 { 0x0000663cff3c6600 }
    else if ch == 43 { 0x00000c0c3f0c0c00 }
    else if ch == 44 { 0x060c0c0000000000 }
    else if ch == 45 { 0x000000003f000000 }
    else if ch == 46 { 0x000c0c0000000000 }
    else if ch == 47 { 0x000103060c183060 }
    else if ch == 48 { 0x003e676f7b73633e }
    else if ch == 49 { 0x003f0c0c0c0c0e0c }
    else if ch == 50 { 0x003f33061c30331e }
    else if ch == 51 { 0x001e33301c30331e }
    else if ch == 52 { 0x0078307f33363c38 }
    else if ch == 53 { 0x001e3330301f033f }
    else if ch == 54 { 0x001e33331f03061c }
    else if ch == 55 { 0x000c0c0c1830333f }
    else if ch == 56 { 0x001e33331e33331e }
    else if ch == 57 { 0x000e18303e33331e }
    else if ch == 58 { 0x000c0c00000c0c00 }
    else if ch == 59 { 0x060c0c00000c0c00 }
    else if ch == 60 { 0x00180c0603060c18 }
    else if ch == 61 { 0x00003f00003f0000 }
    else if ch == 62 { 0x00060c1830180c06 }
    else if ch == 63 { 0x000c000c1830331e }
    else if ch == 64 { 0x001e037b7b7b633e }
    else if ch == 65 { 0x0033333f33331e0c }
    else if ch == 66 { 0x003f66663e66663f }
    else if ch == 67 { 0x003c66030303663c }
    else if ch == 68 { 0x001f36666666361f }
    else if ch == 69 { 0x007f46161e16467f }
    else if ch == 70 { 0x000f06161e16467f }
    else if ch == 71 { 0x007c66730303663c }
    else if ch == 72 { 0x003333333f333333 }
    else if ch == 73 { 0x001e0c0c0c0c0c1e }
    else if ch == 74 { 0x001e333330303078 }
    else if ch == 75 { 0x006766361e366667 }
    else if ch == 76 { 0x007f66460606060f }
    else if ch == 77 { 0x0063636b7f7f7763 }
    else if ch == 78 { 0x006363737b6f6763 }
    else if ch == 79 { 0x001c36636363361c }
    else if ch == 80 { 0x000f06063e66663f }
    else if ch == 81 { 0x00381e3b3333331e }
    else if ch == 82 { 0x006766363e66663f }
    else if ch == 83 { 0x001e33380e07331e }
    else if ch == 84 { 0x001e0c0c0c0c2d3f }
    else if ch == 85 { 0x003f333333333333 }
    else if ch == 86 { 0x000c1e3333333333 }
    else if ch == 87 { 0x0063777f6b636363 }
    else if ch == 88 { 0x0063361c1c366363 }
    else if ch == 89 { 0x001e0c0c1e333333 }
    else if ch == 90 { 0x007f664c1831637f }
    else if ch == 91 { 0x001e06060606061e }
    else if ch == 92 { 0x00406030180c0603 }
    else if ch == 93 { 0x001e18181818181e }
    else if ch == 94 { 0x0000000063361c08 }
    else if ch == 95 { 0xff00000000000000 }
    else if ch == 96 { 0x0000000000180c0c }
    else if ch == 97 { 0x006e333e301e0000 }
    else if ch == 98 { 0x003b66663e060607 }
    else if ch == 99 { 0x001e3303331e0000 }
    else if ch == 100 { 0x006e33333e303038 }
    else if ch == 101 { 0x001e033f331e0000 }
    else if ch == 102 { 0x000f06060f06361c }
    else if ch == 103 { 0x1f303e33336e0000 }
    else if ch == 104 { 0x006766666e360607 }
    else if ch == 105 { 0x001e0c0c0c0e000c }
    else if ch == 106 { 0x1e33333030300030 }
    else if ch == 107 { 0x0067361e36660607 }
    else if ch == 108 { 0x001e0c0c0c0c0c0e }
    else if ch == 109 { 0x00636b7f7f330000 }
    else if ch == 110 { 0x00333333331f0000 }
    else if ch == 111 { 0x001e3333331e0000 }
    else if ch == 112 { 0x0f063e66663b0000 }
    else if ch == 113 { 0x78303e33336e0000 }
    else if ch == 114 { 0x000f06666e3b0000 }
    else if ch == 115 { 0x001f301e033e0000 }
    else if ch == 116 { 0x00182c0c0c3e0c08 }
    else if ch == 117 { 0x006e333333330000 }
    else if ch == 118 { 0x000c1e3333330000 }
    else if ch == 119 { 0x00367f7f6b630000 }
    else if ch == 120 { 0x0063361c36630000 }
    else if ch == 121 { 0x1f303e3333330000 }
    else if ch == 122 { 0x003f260c193f0000 }
    else if ch == 123 { 0x00380c0c070c0c38 }
    else if ch == 124 { 0x0018181800181818 }
    else if ch == 125 { 0x00070c0c380c0c07 }
    else if ch == 126 { 0x0000000000003b6e }
    else if ch == 127 { 0x0000000000000000 }
    else { 0 }
}

// Draw a single 8×8 character into a pixel buffer at (px, py).
// pixels: *mut i64 (one i64 per pixel, BGRX format)
// width/height: buffer dimensions (clip to bounds)
// r/g/b: text colour (0-255)
pub fn font_draw_char(
    pixels: *mut i64,
    buf_w: i64,
    buf_h: i64,
    ch: i64,
    px: i64,
    py: i64,
    r: i64,
    g: i64,
    b: i64,
) with Mut {
    let glyph = font_glyph(ch)
    let color = b | (g << 8) | (r << 16)
    var row: i64 = 0
    while row < 8 {
        let bits = (glyph >> (row * 8)) & 0xFF
        var col: i64 = 0
        while col < 8 {
            let set = (bits >> col) & 1
            if set == 1 {
                let sx = px + col
                let sy = py + row
                if sx >= 0 && sy >= 0 && sx < buf_w && sy < buf_h {
                    let idx = sy * buf_w + sx
                    write_i64(pixels, idx, color)
                }
            }
            col = col + 1
        }
        row = row + 1
    }
}

// Draw an ASCII string into a pixel buffer starting at (px, py).
// Characters advance 8 pixels per glyph; wraps at buf_w edge.
pub fn font_draw_string(
    pixels: *mut i64,
    buf_w: i64,
    buf_h: i64,
    s: &[i8; 256],
    len: i64,
    px: i64,
    py: i64,
    r: i64,
    g: i64,
    b: i64,
) with Mut {
    var cx = px
    var cy = py
    var i: i64 = 0
    while i < len {
        let ch = s[i as usize] as i64
        let uch = if ch < 0 { ch + 256 } else { ch }
        if uch == 10 {
            // newline
            cx = px
            cy = cy + 9
        } else {
            font_draw_char(pixels, buf_w, buf_h, uch, cx, cy, r, g, b)
            cx = cx + 8
            if cx + 8 > buf_w {
                cx = px
                cy = cy + 9
            }
        }
        i = i + 1
    }
}
