// stdlib/display/font.sio — 8×8 bitmap font (ASCII 32-127)
//
// Each character is 8 rows × 8 pixels packed into one i64 (low 8 bits = row 0).
// Font data: compact public-domain VGA-style 8×8 bitmap.
//
// fn font_glyph(ch: i64) -> i64   — returns 8-row bitmask for character
// fn font_draw_char(pixels, width, height, ch, px, py, r, g, b)
// fn font_draw_string(pixels, width, height, s, len, px, py, r, g, b)

// Returns an 8-byte glyph packed as i64 (row 0 in bits 7-0, row 1 in bits 15-8, ...).
// ASCII 32 (space) through 127 (DEL) are supported; others render as space.
pub fn font_glyph(ch: i64) -> i64 {
    // Characters 32-127 (96 glyphs). Index = ch - 32.
    // Each entry encodes 8 rows × 8 bits.
    //
    // Format: 0xROW7ROW6ROW5ROW4ROW3ROW2ROW1ROW0 (row0 = top = lowest byte)
    if ch == 32 { 0x0000000000000000 }       // space
    else if ch == 33 { 0x0018183C3C181800 }  // !
    else if ch == 34 { 0x000000006666FFFF }  // "
    else if ch == 35 { 0x0036367F367F3636 }  // #
    else if ch == 36 { 0x000C1E301C067C18 }  // $
    else if ch == 37 { 0x006333180C634363 }  // %
    else if ch == 38 { 0x006E333B6E1C361C }  // &
    else if ch == 39 { 0x0000000000181818 }  // '
    else if ch == 40 { 0x000C18303030180C }  // (
    else if ch == 41 { 0x0030180C0C0C1830 }  // )
    else if ch == 42 { 0x0000663CFF3C6600 }  // *
    else if ch == 43 { 0x000018187E181800 }  // +
    else if ch == 44 { 0x0C18180000000000 }  // ,
    else if ch == 45 { 0x000000007E000000 }  // -
    else if ch == 46 { 0x0018180000000000 }  // .
    else if ch == 47 { 0x000103060C183060 }  // /
    else if ch == 48 { 0x003E636B73633E00 }  // 0
    else if ch == 49 { 0x007E181818181C18 }  // 1
    else if ch == 50 { 0x007E060C18306346 }  // 2
    else if ch == 51 { 0x003E63301C30633E }  // 3
    else if ch == 52 { 0x0030307F33363C38 }  // 4
    else if ch == 53 { 0x003E6360603E067E }  // 5
    else if ch == 54 { 0x003E63633E06633C }  // 6
    else if ch == 55 { 0x00001818180C067E }  // 7
    else if ch == 56 { 0x003E63633E63633E }  // 8
    else if ch == 57 { 0x001E30607E63633E }  // 9
    else if ch == 58 { 0x0018180000181800 }  // :
    else if ch == 59 { 0x0C18180000181800 }  // ;
    else if ch == 60 { 0x000E18306030180E }  // <
    else if ch == 61 { 0x00007E00007E0000 }  // =
    else if ch == 62 { 0x0070180C060C1870 }  // >
    else if ch == 63 { 0x001818003C663E06 }  // ?
    else if ch == 64 { 0x003E037B7B7B6340 }  // @
    else if ch == 65 { 0x006363637F63361C }  // A
    else if ch == 66 { 0x003F66663E66663F }  // B
    else if ch == 67 { 0x003E63030303633E }  // C
    else if ch == 68 { 0x003F66666666663F }  // D
    else if ch == 69 { 0x007F46161E16467F }  // E
    else if ch == 70 { 0x000F06161E16467F }  // F
    else if ch == 71 { 0x007E63733303633E }  // G
    else if ch == 72 { 0x006363637F636363 }  // H
    else if ch == 73 { 0x003F0C0C0C0C0C3F }  // I
    else if ch == 74 { 0x001E33333030307C }  // J
    else if ch == 75 { 0x00666C6C786C6666 }  // K
    else if ch == 76 { 0x007E606060606060 }  // L
    else if ch == 77 { 0x006363636B7F7763 }  // M
    else if ch == 78 { 0x006363737B6F6763 }  // N
    else if ch == 79 { 0x003E63636363633E }  // O
    else if ch == 80 { 0x000F06063E66663F }  // P
    else if ch == 81 { 0x007063676363633E }  // Q
    else if ch == 82 { 0x006766666E76663F }  // R
    else if ch == 83 { 0x003E63601C06633E }  // S
    else if ch == 84 { 0x001818181818187E }  // T
    else if ch == 85 { 0x003E636363636363 }  // U
    else if ch == 86 { 0x000C0C1E36636363 }  // V
    else if ch == 87 { 0x006B6B7F7F376363 }  // W
    else if ch == 88 { 0x006363361C366363 }  // X
    else if ch == 89 { 0x001818183C666363 }  // Y
    else if ch == 90 { 0x007F63060C186362 }  // Z
    else if ch == 91 { 0x003F03030303033F }  // [
    else if ch == 92 { 0x006030180C060301 }  // \
    else if ch == 93 { 0x003F30303030303F }  // ]
    else if ch == 94 { 0x000000000063361C }  // ^
    else if ch == 95 { 0xFF00000000000000 }  // _
    else if ch == 96 { 0x000000000030180C }  // `
    else if ch == 97 { 0x006E33333E301E00 }  // a
    else if ch == 98 { 0x003B66663E060703 }  // b
    else if ch == 99 { 0x003E6303633E0000 }  // c
    else if ch == 100 { 0x006E33333E303038 } // d
    else if ch == 101 { 0x00003E607E663E00 } // e
    else if ch == 102 { 0x000F06060606363C } // f
    else if ch == 103 { 0x1E30607E33336E00 } // g
    else if ch == 104 { 0x006766666E060703 } // h
    else if ch == 105 { 0x003F0C0C0C0C1C00 } // i
    else if ch == 106 { 0x1E33333030003038 } // j
    else if ch == 107 { 0x00676E3B1B360607 } // k
    else if ch == 108 { 0x003F18181818181C } // l
    else if ch == 109 { 0x006B6B6B3E001E00 } // m
    else if ch == 110 { 0x006666666E3B0000 } // n
    else if ch == 111 { 0x003C666666663C00 } // o
    else if ch == 112 { 0x0F067E66663B0000 } // p
    else if ch == 113 { 0x78307E33336E0000 } // q
    else if ch == 114 { 0x000F060606363B00 } // r
    else if ch == 115 { 0x003C66063C603C00 } // s
    else if ch == 116 { 0x001E3330300C0C1C } // t
    else if ch == 117 { 0x006E333333330000 } // u
    else if ch == 118 { 0x0000183C66666600 } // v
    else if ch == 119 { 0x006B6B7F7F360000 } // w
    else if ch == 120 { 0x0000663C183C6600 } // x
    else if ch == 121 { 0x1E30607E63637700 } // y
    else if ch == 122 { 0x007E460C18327E00 } // z
    else if ch == 123 { 0x000E18183018180E } // {
    else if ch == 124 { 0x0018181800181818 } // |
    else if ch == 125 { 0x0070181818181870 } // }
    else if ch == 126 { 0x000000000063361C } // ~
    else { 0x0000000000000000 }              // unknown → space
}

// Draw a single 8×8 character into a pixel buffer at (px, py).
// pixels: *mut i64 (one i64 per pixel, BGRX format)
// width/height: buffer dimensions (clip to bounds)
// r/g/b: text colour (0-255)
pub fn font_draw_char(
    pixels: *mut i64,
    buf_w: i64,
    buf_h: i64,
    ch: i64,
    px: i64,
    py: i64,
    r: i64,
    g: i64,
    b: i64,
) with Mut {
    let glyph = font_glyph(ch)
    let color = b | (g << 8) | (r << 16)
    var row: i64 = 0
    while row < 8 {
        let bits = (glyph >> (row * 8)) & 0xFF
        var col: i64 = 0
        while col < 8 {
            let set = (bits >> (7 - col)) & 1
            if set == 1 {
                let sx = px + col
                let sy = py + row
                if sx >= 0 && sy >= 0 && sx < buf_w && sy < buf_h {
                    let idx = sy * buf_w + sx
                    write_i64(pixels, idx, color)
                }
            }
            col = col + 1
        }
        row = row + 1
    }
}

// Draw an ASCII string into a pixel buffer starting at (px, py).
// Characters advance 8 pixels per glyph; wraps at buf_w edge.
pub fn font_draw_string(
    pixels: *mut i64,
    buf_w: i64,
    buf_h: i64,
    s: &[i8; 256],
    len: i64,
    px: i64,
    py: i64,
    r: i64,
    g: i64,
    b: i64,
) with Mut {
    var cx = px
    var cy = py
    var i: i64 = 0
    while i < len {
        let ch = s[i as usize] as i64
        let uch = if ch < 0 { ch + 256 } else { ch }
        if uch == 10 {
            // newline
            cx = px
            cy = cy + 9
        } else {
            font_draw_char(pixels, buf_w, buf_h, uch, cx, cy, r, g, b)
            cx = cx + 8
            if cx + 8 > buf_w {
                cx = px
                cy = cy + 9
            }
        }
        i = i + 1
    }
}
