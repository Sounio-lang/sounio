// stdlib/tls/server_hello.sio -- ServerHello decode, split into its own
// module. See `stdlib/tls/handshake.sio`'s own doc comment (defect (1))
// for the full investigation trail: a real, measured Madaros compiler
// defect corrupts a returned struct's fixed-array field at a cross-
// module tuple-return boundary when another struct with an
// identically-named fixed-array field is compiled into the same final
// program. `ServerHelloInfo` here and `ClientHelloParams`
// (`stdlib/tls/client_hello.sio`) both need fields literally named
// `random`/`x25519_public` per this plan's own brief, so this file keeps
// `ServerHelloInfo`/`decode_server_hello` physically apart from
// `ClientHelloParams`/`encode_client_hello` -- re-exported together from
// `handshake.sio` via `pub use`, but never declared in the same source
// file.

use net::socket::*
use hash::sha256::*

pub const HS_SERVER_HELLO: u8 = 2

// RFC 8446 SS4.2 extension type numbers this file needs.
const EXT_COOKIE: i64 = 44
const EXT_KEY_SHARE: i64 = 51

// RFC 8446 SS4.2.7 NamedGroup -- X25519 only (see plan's Out of Scope).
const NAMED_GROUP_X25519: i64 = 0x001d

pub struct ServerHelloInfo {
    is_hello_retry_request: bool,
    random: [u8; 32],
    cipher_suite: u16,
    x25519_public: [u8; 32],
    has_key_share: bool,
    cookie: RawBuf,
    cookie_len: i64,
    // Final-review Fix 3: the raw NamedGroup value carried by the
    // key_share extension, recorded UNCONDITIONALLY -- regardless of
    // whether it equals NAMED_GROUP_X25519 -- so a caller can tell "server
    // asked for a different group" apart from "no key_share extension at
    // all" (previously indistinguishable: `has_key_share` stayed false in
    // both cases). On a HelloRetryRequest (RFC 8446 SS4.1.4), the
    // key_share extension_data IS the selected NamedGroup, a bare 2-byte
    // value, not a full KeyShareEntry -- this field is what the design
    // spec's own Scope Decision means by "the server's HRR ... demands a
    // key-exchange group other than X25519". Zero when no key_share
    // extension was present at all.
    selected_group: u16,
}

fn buf_get_u8(buf: &RawBuf, pos: i64) -> i64 with IO {
    rawbuf_get(buf, pos)
}

fn buf_get_u16(buf: &RawBuf, pos: i64) -> i64 with IO {
    (rawbuf_get(buf, pos) << 8) | rawbuf_get(buf, pos + 1)
}

fn buf_get_u24(buf: &RawBuf, pos: i64) -> i64 with IO {
    (rawbuf_get(buf, pos) << 16) | (rawbuf_get(buf, pos + 1) << 8) | rawbuf_get(buf, pos + 2)
}

fn server_hello_info_zero() -> ServerHelloInfo with IO {
    ServerHelloInfo {
        is_hello_retry_request: false,
        random: [(0 as u8); 32],
        cipher_suite: 0 as u16,
        x25519_public: [(0 as u8); 32],
        has_key_share: false,
        cookie: rawbuf_new(1),
        cookie_len: 0,
        selected_group: 0 as u16,
    }
}

// Decodes a ServerHello (RFC 8446 SS4.1.3), including detecting the
// HelloRetryRequest sentinel `random` value. Only the fields this plan
// needs downstream are extracted: cipher_suite, the X25519 key_share (if
// present -- absent on a HelloRetryRequest's own key_share-less case, or
// present as a bare NamedGroup with no key_exchange in the
// HelloRetryRequest's own SS4.1.4 variant, which this decoder treats the
// same as "no key share" since Task 7/8 re-derives the share itself on
// retry), and the cookie extension (HelloRetryRequest only).
pub fn decode_server_hello(msg_bytes: &RawBuf, msg_len: i64) -> (ServerHelloInfo, bool) with IO {
    var info = server_hello_info_zero()
    if msg_len < 4 {
        return (info, false)
    }
    if (buf_get_u8(msg_bytes, 0) as u8) != HS_SERVER_HELLO {
        return (info, false)
    }
    let body_len = buf_get_u24(msg_bytes, 1)
    if 4 + body_len > msg_len {
        return (info, false)
    }

    var pos: i64 = 4
    pos = pos + 2 // legacy_version, not needed

    var rj: i64 = 0
    while rj < 32 {
        info.random[rj as usize] = (buf_get_u8(msg_bytes, pos) as u8)
        pos = pos + 1
        rj = rj + 1
    }

    let sid_len = buf_get_u8(msg_bytes, pos)
    pos = pos + 1 + sid_len

    let cipher_suite = buf_get_u16(msg_bytes, pos)
    info.cipher_suite = cipher_suite as u16
    pos = pos + 2

    pos = pos + 1 // legacy_compression_method, always 0

    let ext_total = buf_get_u16(msg_bytes, pos)
    pos = pos + 2
    let ext_end = pos + ext_total

    while pos < ext_end {
        let ext_type = buf_get_u16(msg_bytes, pos)
        pos = pos + 2
        let ext_data_len = buf_get_u16(msg_bytes, pos)
        pos = pos + 2

        if ext_type == EXT_KEY_SHARE {
            // ServerHello's key_share extension_data is a single
            // KeyShareEntry (group + key_exchange), NOT a list, unlike
            // ClientHello's.
            let group = buf_get_u16(msg_bytes, pos)
            // Recorded unconditionally -- see `selected_group`'s own doc
            // comment on `ServerHelloInfo` above -- so a non-X25519 group
            // (most importantly on a HelloRetryRequest) is distinguishable
            // from "no key_share extension present" rather than silently
            // falling through as the same "no key share" case.
            info.selected_group = group as u16
            if group == NAMED_GROUP_X25519 {
                let key_len = buf_get_u16(msg_bytes, pos + 2)
                if key_len == 32 {
                    var kj: i64 = 0
                    while kj < 32 {
                        info.x25519_public[kj as usize] = (buf_get_u8(msg_bytes, pos + 4 + kj) as u8)
                        kj = kj + 1
                    }
                    info.has_key_share = true
                }
            }
        } else if ext_type == EXT_COOKIE {
            let clen = buf_get_u16(msg_bytes, pos)
            info.cookie = rawbuf_new(clen + 8)
            var cj: i64 = 0
            while cj < clen {
                rawbuf_set(&info.cookie, cj, buf_get_u8(msg_bytes, pos + 2 + cj))
                cj = cj + 1
            }
            info.cookie_len = clen
        }

        pos = pos + ext_data_len
    }

    // RFC 8446 SS4.1.3: a ServerHello whose `random` field equals
    // SHA-256("HelloRetryRequest") is a HelloRetryRequest, independently
    // of the wire message type (which is server_hello either way).
    // Computed at runtime via the existing `sha256` primitive rather
    // than a transcribed literal 32-byte array.
    let magic_text = rawbuf_new(17)
    let magic_bytes: [u8; 17] = [
        72 as u8, 101 as u8, 108 as u8, 108 as u8, 111 as u8, 82 as u8, 101 as u8, 116 as u8,
        114 as u8, 121 as u8, 82 as u8, 101 as u8, 113 as u8, 117 as u8, 101 as u8, 115 as u8, 116 as u8,
    ] // "HelloRetryRequest"
    var mi: i64 = 0
    while mi < 17 {
        rawbuf_set(&magic_text, mi, magic_bytes[mi as usize] as i64)
        mi = mi + 1
    }
    let digest = sha256(&magic_text, 17)

    var is_hrr = true
    var hi: i64 = 0
    while hi < 32 {
        if info.random[hi as usize] != digest[hi as usize] {
            is_hrr = false
        }
        hi = hi + 1
    }
    info.is_hello_retry_request = is_hrr

    (info, true)
}
