// stdlib/mem/arc.sio
// Atomic reference counting simulation using fixed arrays
//
// Since Sounio has no heap allocation or generics,
// this provides a slot-based ARC pool for i64 values.

// ARC pool: fixed slots for reference-counted values
// Each slot has: value, strong_count, weak_count
struct ArcPool {
    values: [i64; 64],
    strong: [i64; 64],
    weak: [i64; 64],
    next_free: i64,
}

fn arc_pool_new() -> ArcPool {
    ArcPool {
        values: [0; 64],
        strong: [0; 64],
        weak: [0; 64],
        next_free: 0,
    }
}

// Allocate a new arc slot, returns slot index (-1 if full)
fn arc_new(pool: &!ArcPool, value: i64) -> i64 {
    let idx = pool.next_free
    if idx >= 64 { return 0 - 1 }
    pool.values[idx] = value
    pool.strong[idx] = 1
    pool.weak[idx] = 0
    pool.next_free = idx + 1
    return idx
}

// Clone (increment strong count)
fn arc_clone(pool: &!ArcPool, idx: i64) -> i64 {
    if idx < 0 { return idx }
    if idx >= 64 { return idx }
    pool.strong[idx] = pool.strong[idx] + 1
    return idx
}

// Drop (decrement strong count), returns 1 if value was freed
fn arc_drop(pool: &!ArcPool, idx: i64) -> i64 {
    if idx < 0 { return 0 }
    if idx >= 64 { return 0 }
    pool.strong[idx] = pool.strong[idx] - 1
    if pool.strong[idx] == 0 {
        pool.values[idx] = 0
        return 1
    }
    return 0
}

// Get value
fn arc_get(pool: ArcPool, idx: i64) -> i64 {
    if idx < 0 { return 0 }
    if idx >= 64 { return 0 }
    return pool.values[idx]
}

// Get strong count
fn arc_strong_count(pool: ArcPool, idx: i64) -> i64 {
    if idx < 0 { return 0 }
    if idx >= 64 { return 0 }
    return pool.strong[idx]
}
