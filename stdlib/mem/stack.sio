//! Stack allocator (LIFO allocator)
//!
//! Stack provides fast LIFO (Last-In-First-Out) allocation where
//! deallocations must occur in reverse order of allocations.
//!
//! Ideal for:
//! - Function-scoped temporary allocations
//! - Recursive algorithms with bounded memory
//! - Any scenario with strictly nested lifetimes
//!
//! Functions:
//! - stack_new() -> Stack
//! - stack_with_size(size) -> Stack
//! - stack_marker(&stack) -> StackMarker
//! - stack_alloc_raw(&!stack, size, align) -> *mut u8
//! - stack_alloc_bytes(&!stack, count) -> *mut u8
//! - stack_reset_to(&!stack, marker)
//! - stack_reset(&!stack)
//! - stack_drop(&!stack)
//! - stack_used(&stack) -> usize
//! - stack_size(&stack) -> usize
//! - stack_available(&stack) -> usize
//! - stack_high_water_mark(&stack) -> usize
//! - stack_is_empty(&stack) -> bool
//! - stack_is_full(&stack) -> bool

extern "C" {
    fn malloc(size: usize) -> *mut u8;
    fn free(ptr: *mut u8);
}

// Default stack size (1 MB)
const DEFAULT_STACK_SIZE: usize = 1048576

// Marker for stack allocation positions.
// Used to reset the stack to a previous state.
pub struct StackMarker {
    offset: usize,
}

// Returns the byte offset this marker represents.
pub fn marker_offset(marker: &StackMarker) -> usize {
    return marker.offset
}

// A LIFO stack allocator.
pub struct Stack {
    base: *mut u8,
    size: usize,
    offset: usize,
    high_water: usize,
}

// Creates a new stack allocator with default size (1 MB).
pub fn stack_new() -> Stack with Alloc {
    let result = stack_with_size(DEFAULT_STACK_SIZE)
    return result
}

// Creates a new stack allocator with the specified size.
pub fn stack_with_size(size: usize) -> Stack with Alloc {
    let base = malloc(size)
    let result = Stack {
        base: base,
        size: size,
        offset: 0,
        high_water: 0,
    }
    return result
}

// Returns a marker for the current stack position.
pub fn stack_marker(stack: &Stack) -> StackMarker {
    let result = StackMarker { offset: stack.offset }
    return result
}

// Allocates raw bytes with the specified size and alignment.
// Returns a pointer to the allocated memory, or null if out of space.
pub fn stack_alloc_raw(stack: &!Stack, size: usize, align: usize) -> *mut u8 {
    // Calculate aligned offset
    let aligned = (stack.offset + align - 1) & !(align - 1)
    let new_offset = aligned + size

    if new_offset > stack.size {
        let null = null_mut()
        return null
    }

    stack.offset = new_offset

    // Update high water mark
    if new_offset > stack.high_water {
        stack.high_water = new_offset
    }

    // Compute pointer using integer arithmetic
    let base_addr = stack.base as usize
    let ptr_addr = base_addr + aligned
    let ptr = ptr_addr as *mut u8
    return ptr
}

// Allocates an array of bytes on the stack.
pub fn stack_alloc_bytes(stack: &!Stack, count: usize) -> *mut u8 {
    let ptr = stack_alloc_raw(stack, count, 1)
    return ptr
}

// Resets the stack to a previous marker position.
pub fn stack_reset_to(stack: &!Stack, marker: StackMarker) {
    stack.offset = marker.offset
}

// Resets the stack to empty, freeing all allocations.
pub fn stack_reset(stack: &!Stack) {
    stack.offset = 0
}

// Returns the current amount of memory used (in bytes).
pub fn stack_used(stack: &Stack) -> usize {
    return stack.offset
}

// Returns the total size of the stack (in bytes).
pub fn stack_size(stack: &Stack) -> usize {
    return stack.size
}

// Returns the remaining available space (in bytes).
pub fn stack_available(stack: &Stack) -> usize {
    return stack.size - stack.offset
}

// Returns the high water mark (maximum bytes ever used).
pub fn stack_high_water_mark(stack: &Stack) -> usize {
    return stack.high_water
}

// Returns true if the stack is empty.
pub fn stack_is_empty(stack: &Stack) -> bool {
    return stack.offset == 0
}

// Returns true if the stack is full.
pub fn stack_is_full(stack: &Stack) -> bool {
    return stack.offset == stack.size
}

// Frees all memory associated with the stack.
pub fn stack_drop(stack: &!Stack) with Alloc {
    if stack.base != null_mut() {
        free(stack.base)
        stack.base = null_mut()
    }
}
