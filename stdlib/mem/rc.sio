// stdlib/mem/rc.sio
// Single-threaded reference counting using fixed slot pool
//
// Rc pool for i64 values with strong/weak counts.

struct RcPool {
    values: [i64; 64],
    strong: [i64; 64],
    weak: [i64; 64],
    next_free: i64,
}

fn rc_pool_new() -> RcPool {
    RcPool {
        values: [0; 64],
        strong: [0; 64],
        weak: [0; 64],
        next_free: 0,
    }
}

fn rc_new(pool: &!RcPool, value: i64) -> i64 {
    let idx = pool.next_free
    if idx >= 64 { return 0 - 1 }
    pool.values[idx] = value
    pool.strong[idx] = 1
    pool.weak[idx] = 0
    pool.next_free = idx + 1
    return idx
}

fn rc_clone(pool: &!RcPool, idx: i64) -> i64 {
    if idx < 0 { return idx }
    if idx >= 64 { return idx }
    pool.strong[idx] = pool.strong[idx] + 1
    return idx
}

fn rc_drop(pool: &!RcPool, idx: i64) -> i64 {
    if idx < 0 { return 0 }
    if idx >= 64 { return 0 }
    pool.strong[idx] = pool.strong[idx] - 1
    if pool.strong[idx] == 0 {
        pool.values[idx] = 0
        return 1
    }
    return 0
}

fn rc_get(pool: RcPool, idx: i64) -> i64 {
    if idx < 0 { return 0 }
    if idx >= 64 { return 0 }
    return pool.values[idx]
}

fn rc_strong_count(pool: RcPool, idx: i64) -> i64 {
    if idx < 0 { return 0 }
    if idx >= 64 { return 0 }
    return pool.strong[idx]
}

fn rc_downgrade(pool: &!RcPool, idx: i64) {
    if idx < 0 { return }
    if idx >= 64 { return }
    pool.weak[idx] = pool.weak[idx] + 1
}

fn rc_weak_count(pool: RcPool, idx: i64) -> i64 {
    if idx < 0 { return 0 }
    if idx >= 64 { return 0 }
    return pool.weak[idx]
}
