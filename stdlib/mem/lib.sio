//! stdlib/mem/lib.sio - Memory management utilities
//!
//! This module provides memory management primitives and allocators.
//!
//! # Allocators
//!
//! The module includes three specialized allocators for different use cases:
//!
//! - **Arena** (arena.sio): Bump allocator with batch deallocation. Best for
//!   batch processing where all allocations share a lifetime (AST nodes, parse trees).
//!   Functions: `arena_new()`, `arena_alloc_*()`, `arena_reset()`, `arena_drop()`
//!
//! - **Pool** (pool.sio): Fixed-size object pool. Best for frequently allocated/
//!   deallocated objects of the same type (game entities, connections).
//!   Functions: `pool_new()`, `pool_alloc()`, `pool_free()`, `pool_drop()`
//!
//! - **Stack** (stack.sio): LIFO allocator with marker-based deallocation.
//!   Best for function-scoped temporaries and recursive algorithms.
//!   Functions: `stack_new()`, `stack_alloc_*()`, `stack_reset_to()`, `stack_drop()`
//!
//! # Usage Example
//!
//! ```sio
//! // Arena allocator - batch allocation, batch free
//! var arena = arena_new()
//! let x = arena_alloc_i32(&!arena, 42)
//! let y = arena_alloc_f64(&!arena, 3.14)
//! arena_drop(&!arena)  // Free all at once
//!
//! // Pool allocator - fixed-size objects
//! var pool = pool_new(32, 100)  // 32 bytes per slot, 100 slots
//! let obj = pool_alloc(&!pool)
//! pool_free(&!pool, obj)        // Individual free
//! pool_drop(&!pool)
//!
//! // Stack allocator - LIFO with markers
//! var stack = stack_new()
//! let marker = stack_marker(&stack)
//! let a = stack_alloc_i32(&!stack, 1)
//! let b = stack_alloc_i32(&!stack, 2)
//! stack_reset_to(&!stack, marker)  // Free a and b
//! stack_drop(&!stack)
//! ```
//!
//! # Note on Aspirational Code
//!
//! The files box.sio, rc.sio, arc.sio, and cell.sio contain aspirational
//! template code that uses traits and impl blocks not yet implemented in
//! the Sounio parser. They serve as design documentation for future
//! language features.

// Allocator modules
pub mod arena;
pub mod pool;
pub mod stack;
