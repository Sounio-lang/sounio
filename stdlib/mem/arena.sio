//! Arena allocator (bump allocator)
//!
//! Arena provides fast O(1) allocation with no individual deallocation.
//! All memory is freed at once when the arena is dropped or reset.
//!
//! Functions:
//! - arena_new() -> Arena
//! - arena_with_chunk_size(size) -> Arena
//! - arena_alloc_raw(&!arena, size, align) -> *mut u8
//! - arena_alloc_bytes(&!arena, count) -> *mut u8
//! - arena_reset(&!arena)
//! - arena_drop(&!arena)
//! - arena_allocated_bytes(&arena) -> usize
//! - arena_chunk_size(&arena) -> usize
//! - arena_available(&arena) -> usize
//! - arena_is_empty(&arena) -> bool

extern "C" {
    fn malloc(size: usize) -> *mut u8;
    fn free(ptr: *mut u8);
}

// Default chunk size (64 KB)
const DEFAULT_CHUNK_SIZE: usize = 65536

// A bump allocator that allocates memory in contiguous chunks.
pub struct Arena {
    base: *mut u8,
    chunk_size: usize,
    offset: usize,
    total_allocated: usize,
}

// Creates a new arena with default chunk size (64 KB).
pub fn arena_new() -> Arena with Alloc {
    let result = arena_with_chunk_size(DEFAULT_CHUNK_SIZE)
    return result
}

// Creates a new arena with the specified chunk size.
pub fn arena_with_chunk_size(chunk_size: usize) -> Arena with Alloc {
    let base = malloc(chunk_size)
    let result = Arena {
        base: base,
        chunk_size: chunk_size,
        offset: 0,
        total_allocated: 0,
    }
    return result
}

// Allocates raw bytes with the specified size and alignment.
// Returns a pointer to the allocated memory, or null if allocation fails.
pub fn arena_alloc_raw(arena: &!Arena, size: usize, align: usize) -> *mut u8 with Alloc, Mut {
    let null = 0 as *mut u8
    if align == 0 || (align & (align - 1)) != 0 { return null }
    if arena.base == null || arena.offset > arena.chunk_size { return null }
    // Align the actual address, including the allocator prefix.
    let current = (arena.base as usize) + arena.offset
    let remainder = current & (align - 1)
    let padding = if remainder == 0 { 0 } else { align - remainder }
    let available = arena.chunk_size - arena.offset
    if padding > available { return null }
    if size > available - padding { return null }
    let aligned_offset = arena.offset + padding
    let ptr = ((arena.base as usize) + aligned_offset) as *mut u8
    arena.offset = aligned_offset + size
    arena.total_allocated = arena.total_allocated + size
    ptr
}

// Allocates an array of bytes in the arena.
pub fn arena_alloc_bytes(arena: &!Arena, count: usize) -> *mut u8 with Alloc, Mut {
    let ptr = arena_alloc_raw(arena, count, 1)
    return ptr
}

// Resets the arena, making all memory available for reuse.
pub fn arena_reset(arena: &!Arena) with Mut {
    arena.offset = 0
    arena.total_allocated = 0
}

// Returns the total number of bytes allocated from this arena.
pub fn arena_allocated_bytes(arena: &Arena) -> usize {
    return arena.total_allocated
}

// Returns the chunk size used by this arena.
pub fn arena_chunk_size(arena: &Arena) -> usize {
    return arena.chunk_size
}

// Returns the remaining bytes available in the current chunk.
pub fn arena_available(arena: &Arena) -> usize {
    return arena.chunk_size - arena.offset
}

// Returns true if the arena is empty (no allocations since last reset).
pub fn arena_is_empty(arena: &Arena) -> bool {
    return arena.total_allocated == 0
}

// Frees all memory associated with the arena.
pub fn arena_drop(arena: &!Arena) with Alloc, Mut {
    if arena.base != (0 as *mut u8) {
        free(arena.base)
        arena.base = (0 as *mut u8)
    }
}
