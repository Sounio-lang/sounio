// stdlib/mem/mod.sio — Public exports for the mem module
//
// Per stdlib/CONVENTIONS.md §2, mod.sio declares only the public surface
// (pub use re-exports). Implementations live in the sibling files.

pub use mem::arena::{
    Arena,
    arena_alloc_bytes,
    arena_alloc_raw,
    arena_allocated_bytes,
    arena_available,
    arena_chunk_size,
    arena_drop,
    arena_is_empty,
    arena_new,
    arena_reset,
    arena_with_chunk_size,
}

pub use mem::pool::{
    Pool,
    pool_alloc,
    pool_allocated,
    pool_available,
    pool_capacity,
    pool_drop,
    pool_free,
    pool_is_empty,
    pool_is_full,
    pool_new,
    pool_reset,
    pool_slot_size,
    pool_with_default_capacity,
}

pub use mem::stack::{
    Stack,
    StackMarker,
    marker_offset,
    stack_alloc_bytes,
    stack_alloc_raw,
    stack_available,
    stack_drop,
    stack_high_water_mark,
    stack_is_empty,
    stack_is_full,
    stack_marker,
    stack_new,
    stack_reset,
    stack_reset_to,
    stack_size,
    stack_used,
    stack_with_size,
}

