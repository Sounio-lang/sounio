// stdlib/mem/box — Heap allocation wrappers via C FFI
//
// Provides alloc/dealloc functions for heap memory management.
// Uses libc malloc/free underneath.

extern "C" {
    fn malloc(size: usize) -> *mut u8;
    fn calloc(nmemb: usize, size: usize) -> *mut u8;
    fn realloc(ptr: *mut u8, size: usize) -> *mut u8;
    fn free(ptr: *mut u8);
}

// Allocate n bytes of heap memory, zero-initialized.
fn heap_alloc(n: i64) -> *mut u8 with Alloc {
    let size = n as usize
    let ptr = calloc(1 as usize, size)
    ptr
}

// Reallocate a heap block to a new size.
fn heap_realloc(ptr: *mut u8, new_size: i64) -> *mut u8 with Alloc {
    let size = new_size as usize
    let new_ptr = realloc(ptr, size)
    new_ptr
}

// Free a heap-allocated block.
fn heap_free(ptr: *mut u8) with Alloc {
    free(ptr)
}
