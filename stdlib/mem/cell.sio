// stdlib/mem/cell.sio
// Interior mutability primitives
//
// Cell: get/set through shared reference (simulated with &! pass pattern)
// Since Sounio has no interior mutability at the language level,
// we model Cell as a struct with explicit get/set functions.

struct CellI64 {
    value: i64,
}

fn cell_new(value: i64) -> CellI64 {
    CellI64 { value: value }
}

fn cell_get(c: CellI64) -> i64 {
    return c.value
}

fn cell_set(c: &!CellI64, value: i64) {
    c.value = value
}

fn cell_replace(c: &!CellI64, value: i64) -> i64 {
    let old = c.value
    c.value = value
    return old
}

fn cell_swap(a: &!CellI64, b: &!CellI64) {
    let tmp = a.value
    a.value = b.value
    b.value = tmp
}

// Float variant
struct CellF64 {
    value: f64,
}

fn cell_f64_new(value: f64) -> CellF64 {
    CellF64 { value: value }
}

fn cell_f64_get(c: CellF64) -> f64 {
    return c.value
}

fn cell_f64_set(c: &!CellF64, value: f64) {
    c.value = value
}

fn cell_f64_replace(c: &!CellF64, value: f64) -> f64 {
    let old = c.value
    c.value = value
    return old
}
