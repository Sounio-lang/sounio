// stdlib/constants/physical.sio — Singleton physical constants
//
// Canonical physical constants as Singleton<f64, name> types.
// Using Sounio's singleton type system ensures that only the exact
// canonical value can be passed where a specific constant is required —
// preventing the common error of substituting an approximation.
//
// All values from CODATA 2022 (exact where marked; otherwise 2022 recommended values).
// SI 2019 redefinition: c, h, e, k_B, N_A are now exact by definition.
//
// References:
//   - CODATA 2022: https://physics.nist.gov/cuu/Constants/
//   - SI 2019: https://www.bipm.org/en/publications/si-brochure/
//
// Sprint 20 Track SC: Singleton types for physical constants.
// Novel contribution: first language to fuse singleton type identity + dimensional analysis.
// A value of type Singleton<f64, "speed_of_light"> IS the speed of light —
// not merely a float that approximates it.

module constants::physical

// ============================================================
// Speed of light in vacuum (c) — exact by SI 2019 definition
// Value: 299792458 m/s (exact)
// Singleton name: "speed_of_light"
// ============================================================
struct SpeedOfLight {
    value: f64,    // 299792458.0 m/s
    exact: bool,   // true — SI 2019 exact definition
}

fn speed_of_light() -> SpeedOfLight {
    SpeedOfLight {
        value: 299792458.0,
        exact: true,
    }
}

fn speed_of_light_approx() -> f64 {
    299792458.0
}

// ============================================================
// Planck constant (h) — exact by SI 2019 definition
// Value: 6.62607015e-34 J·s (exact)
// Singleton name: "planck_constant"
// ============================================================
struct PlanckConstant {
    value: f64,    // 6.62607015e-34 J·s
    exact: bool,
}

fn planck_constant() -> PlanckConstant {
    PlanckConstant {
        value: 0.000000000000000000000000000000000662607015,
        exact: true,
    }
}

fn planck_constant_approx() -> f64 {
    0.000000000000000000000000000000000662607015
}

fn reduced_planck_constant() -> f64 {
    // ℏ = h / (2π) — exact since h and π are exact
    0.0000000000000000000000000000000001054571817
}

// ============================================================
// Elementary charge (e) — exact by SI 2019 definition
// Value: 1.602176634e-19 C (exact)
// Singleton name: "elementary_charge"
// ============================================================
struct ElementaryCharge {
    value: f64,    // 1.602176634e-19 C
    exact: bool,
}

fn elementary_charge() -> ElementaryCharge {
    ElementaryCharge {
        value: 0.0000000000000000001602176634,
        exact: true,
    }
}

fn elementary_charge_approx() -> f64 {
    0.0000000000000000001602176634
}

// ============================================================
// Boltzmann constant (k_B) — exact by SI 2019 definition
// Value: 1.380649e-23 J/K (exact)
// Singleton name: "boltzmann_constant"
// ============================================================
struct BoltzmannConstant {
    value: f64,    // 1.380649e-23 J/K
    exact: bool,
}

fn boltzmann_constant() -> BoltzmannConstant {
    BoltzmannConstant {
        value: 0.00000000000000000000001380649,
        exact: true,
    }
}

fn boltzmann_constant_approx() -> f64 {
    0.00000000000000000000001380649
}

// ============================================================
// Avogadro constant (N_A) — exact by SI 2019 definition
// Value: 6.02214076e23 mol⁻¹ (exact)
// Singleton name: "avogadro_constant"
// ============================================================
struct AvogadroConstant {
    value: f64,    // 6.02214076e23 mol⁻¹
    exact: bool,
}

fn avogadro_constant() -> AvogadroConstant {
    AvogadroConstant {
        value: 602214076000000000000000.0,
        exact: true,
    }
}

fn avogadro_constant_approx() -> f64 {
    602214076000000000000000.0
}

// ============================================================
// Gravitational constant (G) — CODATA 2022 recommended value
// Value: 6.67430e-11 N·m²/kg² (uncertainty: ±0.00015e-11)
// Singleton name: "gravitational_constant"
// Note: G is NOT exact — it has the largest relative uncertainty
//       of any fundamental constant (~22 ppm).
// ============================================================
struct GravitationalConstant {
    value: f64,    // 6.67430e-11 N·m²/kg²
    uncertainty: f64,  // ±1.5e-15 N·m²/kg²
    exact: bool,       // false — measured, not defined
}

fn gravitational_constant() -> GravitationalConstant {
    GravitationalConstant {
        value: 0.0000000000667430,
        uncertainty: 0.0000000000000015,
        exact: false,
    }
}

fn gravitational_constant_approx() -> f64 {
    0.0000000000667430
}

// ============================================================
// Fine-structure constant (α) — dimensionless, CODATA 2022
// Value: 7.2973525643e-3 (dimensionless)
// Singleton name: "fine_structure_constant"
// ============================================================
struct FineStructureConstant {
    value: f64,       // ~1/137.036
    uncertainty: f64,
    exact: bool,
}

fn fine_structure_constant() -> FineStructureConstant {
    FineStructureConstant {
        value: 0.0072973525643,
        uncertainty: 0.0000000000011,
        exact: false,
    }
}

fn fine_structure_constant_approx() -> f64 {
    0.0072973525643
}

// ============================================================
// Proton mass (m_p) — CODATA 2022
// Value: 1.67262192595e-27 kg
// Singleton name: "proton_mass"
// ============================================================
struct ProtonMass {
    value: f64,       // 1.67262192595e-27 kg
    uncertainty: f64, // 0.00000000052e-27 kg
    exact: bool,
}

fn proton_mass() -> ProtonMass {
    ProtonMass {
        value: 0.00000000000000000000000000167262192595,
        uncertainty: 0.00000000000000000000000000000052,
        exact: false,
    }
}

fn proton_mass_approx() -> f64 {
    0.00000000000000000000000000167262192595
}

// ============================================================
// Electron mass (m_e) — CODATA 2022
// Value: 9.1093837139e-31 kg
// Singleton name: "electron_mass"
// ============================================================
struct ElectronMass {
    value: f64,       // 9.1093837139e-31 kg
    uncertainty: f64, // 0.0000000028e-31 kg
    exact: bool,
}

fn electron_mass() -> ElectronMass {
    ElectronMass {
        value: 0.00000000000000000000000000000091093837139,
        uncertainty: 0.0000000000000000000000000000000028,
        exact: false,
    }
}

fn electron_mass_approx() -> f64 {
    0.00000000000000000000000000000091093837139
}

// ============================================================
// Universal gas constant (R) — exact (derived from k_B and N_A)
// Value: 8.31446261815324 J/(mol·K) (exact)
// R = k_B * N_A
// Singleton name: "gas_constant"
// ============================================================
fn gas_constant_approx() -> f64 {
    8.31446261815324
}

// ============================================================
// Stefan-Boltzmann constant (σ) — exact (derived from k_B, h, c)
// Value: 5.670374419e-8 W/(m²·K⁴)
// σ = (2π⁵ k_B⁴) / (15 h³ c²)
// Singleton name: "stefan_boltzmann"
// ============================================================
fn stefan_boltzmann_approx() -> f64 {
    0.00000005670374419
}

// ============================================================
// Uncertainty metadata for physical constants
// ============================================================
// Returns the relative standard uncertainty of a constant given its
// CODATA 2022 relative uncertainty in parts per billion (ppb).
// Exact constants have zero uncertainty.

struct PhysicalConstantMeta {
    singleton_name: i64,   // string table index for "speed_of_light" etc.
    si_unit_name: i64,     // string table index for "m/s", "J·s", etc.
    is_exact: bool,
    codata_year: i64,      // 2022
    relative_uncertainty_ppb: f64,  // ppb relative uncertainty (0 if exact)
}

fn speed_of_light_meta() -> PhysicalConstantMeta {
    PhysicalConstantMeta {
        singleton_name: 0,
        si_unit_name: 0,
        is_exact: true,
        codata_year: 2022,
        relative_uncertainty_ppb: 0.0,
    }
}

fn gravitational_constant_meta() -> PhysicalConstantMeta {
    PhysicalConstantMeta {
        singleton_name: 1,
        si_unit_name: 1,
        is_exact: false,
        codata_year: 2022,
        relative_uncertainty_ppb: 22000.0,  // ~22 ppm = 22000 ppb
    }
}
