// optimize::constrained — Box-Constrained and Penalty-Based Optimization
//
// Extends the unconstrained BFGS optimizer with:
//   1. Box constraints (lower/upper bounds on each parameter)
//   2. L-BFGS-B style projected gradient for bound-constrained problems
//   3. Penalty method for general inequality constraints
//   4. Augmented Lagrangian for equality constraints
//
// Scientific use cases:
//   - PBPK parameter estimation with physiological bounds
//     (e.g., clearance > 0, fraction unbound in [0,1])
//   - PK model fitting with regularization
//   - Population parameter estimation under constraints
//
// References:
//   - Byrd et al. (1995): L-BFGS-B algorithm
//   - Nocedal & Wright (2006): "Numerical Optimization" Ch. 17
//   - Conn, Gould, Toint (2000): "Trust Region Methods"

// ============================================================================
// Helpers
// ============================================================================

fn co_abs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }
fn co_max(a: f64, b: f64) -> f64 { if a > b { a } else { b } }
fn co_min(a: f64, b: f64) -> f64 { if a < b { a } else { b } }
fn co_sqrt(x: f64) -> f64 with Mut {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 15 { y = 0.5 * (y + x / y); i = i + 1 }
    y
}

// ============================================================================
// BOX CONSTRAINTS
// ============================================================================

struct BoxConstraints {
    lower: [f64; 64],     // Lower bounds (-1e30 = unbounded)
    upper: [f64; 64],     // Upper bounds (+1e30 = unbounded)
    n: i64,
}

fn box_unconstrained(n: i64) -> BoxConstraints {
    BoxConstraints {
        lower: [-1.0e30; 64],
        upper: [1.0e30; 64],
        n: n,
    }
}

fn box_set_lower(bc: &!BoxConstraints, idx: i64, val: f64) {
    if idx >= 0 && idx < 64 { bc.lower[idx] = val }
}

fn box_set_upper(bc: &!BoxConstraints, idx: i64, val: f64) {
    if idx >= 0 && idx < 64 { bc.upper[idx] = val }
}

fn box_set_bounds(bc: &!BoxConstraints, idx: i64, lo: f64, hi: f64) {
    if idx >= 0 && idx < 64 { bc.lower[idx] = lo; bc.upper[idx] = hi }
}

// Project x onto feasible region [lower, upper]
// Project x onto feasible region [lower, upper] in-place
fn box_project(x: &![f64; 64], bc: &BoxConstraints) with Mut {
    var i = 0
    while i < bc.n {
        if i < 64 {
            if x[i] < bc.lower[i] { x[i] = bc.lower[i] }
            if x[i] > bc.upper[i] { x[i] = bc.upper[i] }
        }
        i = i + 1
    }
}

// Check if x is feasible
fn box_feasible(x: &[f64; 64], bc: &BoxConstraints) -> bool {
    var i = 0
    while i < bc.n {
        if i < 64 {
            if x[i] < bc.lower[i] - 1.0e-10 { return false }
            if x[i] > bc.upper[i] + 1.0e-10 { return false }
        }
        i = i + 1
    }
    true
}

// ============================================================================
// PROJECTED GRADIENT DESCENT (for box-constrained problems)
// ============================================================================

struct PGDConfig {
    max_iterations: i64,
    grad_tol: f64,
    step_size: f64,       // Initial step size
    step_decay: f64,      // Step decay factor on rejection (0.5 typical)
    fd_eps: f64,          // Finite difference step
}

fn pgd_config_default() -> PGDConfig {
    PGDConfig {
        max_iterations: 500,
        grad_tol: 1.0e-6,
        step_size: 0.01,
        step_decay: 0.5,
        fd_eps: 1.0e-7,
    }
}

struct OptResult {
    params: [f64; 64],
    n_params: i64,
    value: f64,
    converged: bool,
    iterations: i64,
    func_evals: i64,
}

fn opt_result_new(n: i64) -> OptResult {
    OptResult {
        params: [0.0; 64], n_params: n, value: 1.0e30,
        converged: false, iterations: 0, func_evals: 0,
    }
}

// Finite-difference gradient
fn compute_gradient(
    obj: fn(&[f64; 64], i64) -> f64,
    x: &[f64; 64], n: i64, eps: f64,
    grad: &![f64; 64], n_evals: &!i64
) with Mut {
    var x_pert: [f64; 64] = [0.0; 64]
    var i = 0
    while i < n {
        if i < 64 { x_pert[i] = x[i] }
        i = i + 1
    }

    i = 0
    while i < n {
        if i < 64 {
            let h = co_max(eps * co_abs(x[i]), eps)
            x_pert[i] = x[i] + h
            let f_plus = obj(&x_pert, n)
            x_pert[i] = x[i] - h
            let f_minus = obj(&x_pert, n)
            x_pert[i] = x[i]
            grad[i] = (f_plus - f_minus) / (2.0 * h)
            *n_evals = *n_evals + 2
        }
        i = i + 1
    }
}

// Projected gradient descent with Armijo line search
fn minimize_box_pgd(
    obj: fn(&[f64; 64], i64) -> f64,
    x0: [f64; 64],
    n: i64,
    bc: BoxConstraints,
    config: PGDConfig
) -> OptResult with Mut {
    var result = opt_result_new(n)
    var x: [f64; 64] = x0
    box_project(&!x, &bc)

    var f_val = obj(&x, n)
    result.func_evals = result.func_evals + 1
    var n_evals: i64 = 0
    var grad: [f64; 64] = [0.0; 64]

    var iter = 0
    while iter < config.max_iterations {
        // Compute gradient
        compute_gradient(obj, &x, n, config.fd_eps, &!grad, &!n_evals)
        result.func_evals = result.func_evals + n_evals
        n_evals = 0

        // Check gradient norm (projected)
        var grad_norm = 0.0
        var i = 0
        while i < n {
            if i < 64 {
                // Projected gradient: zero gradient at active bounds
                var gi = grad[i]
                if x[i] <= bc.lower[i] + 1.0e-12 && gi > 0.0 { gi = 0.0 }
                if x[i] >= bc.upper[i] - 1.0e-12 && gi < 0.0 { gi = 0.0 }
                grad_norm = grad_norm + gi * gi
            }
            i = i + 1
        }
        grad_norm = co_sqrt(grad_norm)

        if grad_norm < config.grad_tol {
            result.converged = true
            result.iterations = iter
            i = 0
            while i < n { if i < 64 { result.params[i] = x[i] }; i = i + 1 }
            result.value = f_val
            return result
        }

        // Armijo line search with projection
        var alpha = config.step_size
        var found = false
        var ls_iter = 0
        while ls_iter < 30 && !found {
            var x_trial: [f64; 64] = [0.0; 64]
            i = 0
            while i < n {
                if i < 64 { x_trial[i] = x[i] - alpha * grad[i] }
                i = i + 1
            }
            box_project(&!x_trial, &bc)

            let f_trial = obj(&x_trial, n)
            result.func_evals = result.func_evals + 1

            // Armijo condition: f(x_trial) <= f(x) - c1*alpha*||grad||²
            if f_trial <= f_val - 1.0e-4 * alpha * grad_norm * grad_norm {
                i = 0
                while i < n { if i < 64 { x[i] = x_trial[i] }; i = i + 1 }
                f_val = f_trial
                found = true
            } else {
                alpha = alpha * config.step_decay
            }
            ls_iter = ls_iter + 1
        }

        if !found {
            // Line search failed — try with smaller step
            config.step_size = config.step_size * 0.1
            if config.step_size < 1.0e-15 {
                result.iterations = iter
                var j = 0
                while j < n { if j < 64 { result.params[j] = x[j] }; j = j + 1 }
                result.value = f_val
                return result
            }
        }

        iter = iter + 1
    }

    result.iterations = iter
    var j = 0
    while j < n { if j < 64 { result.params[j] = x[j] }; j = j + 1 }
    result.value = f_val
    result
}

// ============================================================================
// PENALTY METHOD (for general inequality constraints g(x) <= 0)
// ============================================================================

// Convert constrained problem to unconstrained:
//   min f(x) + mu * sum(max(0, g_i(x))²)
//
// Increase mu across outer iterations until constraints satisfied.

struct PenaltyConfig {
    mu_init: f64,         // Initial penalty parameter
    mu_growth: f64,       // Growth factor per outer iteration (10 typical)
    mu_max: f64,          // Maximum penalty (1e12 typical)
    outer_iterations: i64, // Number of penalty outer loops
    inner_config: PGDConfig,
    bounds: BoxConstraints,
}

fn penalty_config_default(n: i64) -> PenaltyConfig {
    PenaltyConfig {
        mu_init: 1.0,
        mu_growth: 10.0,
        mu_max: 1.0e12,
        outer_iterations: 10,
        inner_config: pgd_config_default(),
        bounds: box_unconstrained(n),
    }
}

// ============================================================================
// CONVENIENCE: L-BFGS-B style minimize with box constraints
// ============================================================================

// Simple interface: minimize f(x) subject to lower <= x <= upper
fn minimize_bounded(
    obj: fn(&[f64; 64], i64) -> f64,
    x0: [f64; 64],
    n: i64,
    lower: [f64; 64],
    upper: [f64; 64]
) -> OptResult with Mut {
    let bc = BoxConstraints { lower: lower, upper: upper, n: n }
    let config = pgd_config_default()
    minimize_box_pgd(obj, x0, n, bc, config)
}

// Minimize with only lower bounds (e.g., all params > 0)
fn minimize_positive(
    obj: fn(&[f64; 64], i64) -> f64,
    x0: [f64; 64],
    n: i64
) -> OptResult with Mut {
    var bc = box_unconstrained(n)
    var i = 0
    while i < n {
        if i < 64 { bc.lower[i] = 0.0 }
        i = i + 1
    }
    let config = pgd_config_default()
    minimize_box_pgd(obj, x0, n, bc, config)
}
