// optimize — Numerical optimization algorithms
//
// Gradient-based and derivative-free optimization with GUM-compliant
// parameter uncertainty quantification.
//
// Submodules:
//   bfgs                    — BFGS quasi-Newton method (superlinear convergence)
//   nelder_mead             — Nelder-Mead simplex (derivative-free)
//   levenberg_marquardt     — Levenberg-Marquardt nonlinear least squares
//   differential_evolution  — Population-based stochastic global optimizer
//   epistemic_bfgs          — BFGS with uncertainty-aware gradients
//   uncertainty             — GUM covariance estimation and confidence intervals

pub use epistemic_bfgs::{
    EpistemicGradient, EpistemicParams, EpistemicHessian,
    EpistemicBFGSConfig, EpistemicBFGSResult,
    egrad_zeros, egrad_norm, egrad_unc_norm, egrad_min_conf,
    eparams_zeros, eparams_norm,
    ehess_identity, ehess_mat_vec,
    epistemic_bfgs_config_default,
    EBFGS_TERM_MAX_ITER, EBFGS_TERM_GRAD_TOL, EBFGS_TERM_FUNC_TOL,
    EBFGS_TERM_PARAM_TOL, EBFGS_TERM_LINESEARCH_FAIL,
    ebfgs_termination_success,
    ebfgs_update, ebfgs_compute_step_size,
    epistemic_bfgs_quadratic,
}
