// Unicode18 UAX29 default segmentation.0=extended grapheme,1=word,2=sentence.
// No dictionary/locale tailoring and no UAX14 line breaking.
// Appends byte offsets, including0 and end, to caller's checked IntegerBuffer.
// Failure preserves all prior output. Scratch retained payload <=max_work_bytes:
// 24*floor((max_work_bytes-16)/24)+16 for nonempty input; empty input uses no scratch.
// RI parity and sentence suffix state are carried forward to avoid quadratic scans.
use collections::integer_buffer::{IntegerBuffer,integer_buffer_new,integer_buffer_status,integer_buffer_len,integer_buffer_get,integer_buffer_push,integer_buffer_reserve,integer_buffer_close}
use text::utf8::{Utf8Text,utf8_text_status,utf8_text_byte_len,utf8_text_next}
use text::ucd_data::{UnicodeData,UnicodeValue,unicode_data,unicode_data_status,ucd_property,ucd_property_value,ucd_string_matches}
struct SegProperties {mode:i64,main:i64,ep:i64,incb:i64}
struct SegState {ri:i64,close:i64,space:i64}
fn seg_word_ignore(c:i64)->bool {c==4 || c==5 || c==6}
fn seg_sentence_ignore(c:i64)->bool {c==4 || c==5}
fn seg_word_newline(c:i64)->bool {c>=1 && c<=3}
fn seg_ah(c:i64)->bool {c==8 || c==9}
fn seg_midletter(c:i64)->bool {c==11 || c==13 || c==14}
fn seg_midnum(c:i64)->bool {c==12 || c==13 || c==14}
fn seg_para(c:i64)->bool {c>=1 && c<=3}
fn seg_sat(c:i64)->bool {c==6 || c==7}
fn seg_class_at(codes:&IntegerBuffer,index:i64)->i64 {
 let v=integer_buffer_get(codes,index)
 if v.status!=0 {return 0-1}
 v.value&255
}
fn seg_previous(codes:&IntegerBuffer,index:i64,mode:i64)->i64 {
 var at=index
 while at>=0 {
  let c=seg_class_at(codes,at)
  if !(if mode==1 {seg_word_ignore(c)} else {seg_sentence_ignore(c)}) {break}
  at=at-1
 }
 at
}
fn seg_next(codes:&IntegerBuffer,index:i64,mode:i64)->i64 {
 var at=index
 let n=integer_buffer_len(codes)
 while at<n {
  let c=seg_class_at(codes,at)
  if !(if mode==1 {seg_word_ignore(c)} else {seg_sentence_ignore(c)}) {break}
  at=at+1
 }
 at
}
fn seg_lookup_class(data:&UnicodeData,property:i64,cp:i64,mode:i64)->i64 {
 let value=ucd_property_value(data,property,cp)
 if value.status!=0 {return 0-1}
 if mode==0 {
  if ucd_string_matches(data,value.id,"XX") {return 0}
  if ucd_string_matches(data,value.id,"CR") {return 1}
  if ucd_string_matches(data,value.id,"LF") {return 2}
  if ucd_string_matches(data,value.id,"CN") {return 3}
  if ucd_string_matches(data,value.id,"L") {return 4}
  if ucd_string_matches(data,value.id,"V") {return 5}
  if ucd_string_matches(data,value.id,"T") {return 6}
  if ucd_string_matches(data,value.id,"LV") {return 7}
  if ucd_string_matches(data,value.id,"LVT") {return 8}
  if ucd_string_matches(data,value.id,"EX") {return 9}
  if ucd_string_matches(data,value.id,"ZWJ") {return 10}
  if ucd_string_matches(data,value.id,"SM") {return 11}
  if ucd_string_matches(data,value.id,"PP") {return 12}
  if ucd_string_matches(data,value.id,"RI") {return 13}
 }
 if mode==1 {
  if ucd_string_matches(data,value.id,"XX") {return 0}
  if ucd_string_matches(data,value.id,"CR") {return 1}
  if ucd_string_matches(data,value.id,"LF") {return 2}
  if ucd_string_matches(data,value.id,"NL") {return 3}
  if ucd_string_matches(data,value.id,"Extend") {return 4}
  if ucd_string_matches(data,value.id,"FO") {return 5}
  if ucd_string_matches(data,value.id,"ZWJ") {return 6}
  if ucd_string_matches(data,value.id,"WSegSpace") {return 7}
  if ucd_string_matches(data,value.id,"LE") {return 8}
  if ucd_string_matches(data,value.id,"HL") {return 9}
  if ucd_string_matches(data,value.id,"NU") {return 10}
  if ucd_string_matches(data,value.id,"ML") {return 11}
  if ucd_string_matches(data,value.id,"MN") {return 12}
  if ucd_string_matches(data,value.id,"MB") {return 13}
  if ucd_string_matches(data,value.id,"SQ") {return 14}
  if ucd_string_matches(data,value.id,"DQ") {return 15}
  if ucd_string_matches(data,value.id,"KA") {return 16}
  if ucd_string_matches(data,value.id,"EX") {return 17}
  if ucd_string_matches(data,value.id,"RI") {return 18}
 }
 if mode==2 {
  if ucd_string_matches(data,value.id,"XX") {return 0}
  if ucd_string_matches(data,value.id,"CR") {return 1}
  if ucd_string_matches(data,value.id,"LF") {return 2}
  if ucd_string_matches(data,value.id,"SE") {return 3}
  if ucd_string_matches(data,value.id,"EX") {return 4}
  if ucd_string_matches(data,value.id,"FO") {return 5}
  if ucd_string_matches(data,value.id,"AT") {return 6}
  if ucd_string_matches(data,value.id,"ST") {return 7}
  if ucd_string_matches(data,value.id,"CL") {return 8}
  if ucd_string_matches(data,value.id,"SP") {return 9}
  if ucd_string_matches(data,value.id,"LO") {return 10}
  if ucd_string_matches(data,value.id,"UP") {return 11}
  if ucd_string_matches(data,value.id,"LE") {return 12}
  if ucd_string_matches(data,value.id,"NU") {return 13}
  if ucd_string_matches(data,value.id,"SC") {return 14}
 }
 0-1
}

fn seg_encode(data:&UnicodeData,props:&SegProperties,cp:i64,state:&!SegState)->UnicodeValue with Mut {
 let c=seg_lookup_class(data,props.main,cp,props.mode)
 if c<0 {return UnicodeValue {id:0,status:6}}
 var encoded=c
 if props.mode<2 {
  let ep=ucd_property_value(data,props.ep,cp)
  if ep.status!=0 {return UnicodeValue {id:0,status:6}}
  if ucd_string_matches(data,ep.id,"Y") {encoded=encoded+256}
 }
 if props.mode==0 {
  let incb=ucd_property_value(data,props.incb,cp)
  if incb.status!=0 {return UnicodeValue {id:0,status:6}}
  let k=if ucd_string_matches(data,incb.id,"None") {0} else if ucd_string_matches(data,incb.id,"Consonant") {1} else if ucd_string_matches(data,incb.id,"Extend") {2} else if ucd_string_matches(data,incb.id,"Linker") {3} else {0-1}
  if k<0 {return UnicodeValue {id:0,status:6}}
  encoded=encoded+k*512
  state.ri=if c==13 {1-state.ri} else {0}
 } else if props.mode==1 {
  if c==18 {state.ri=1-state.ri} else if !seg_word_ignore(c) {state.ri=0}
 } else {
  if c==6 || c==7 {state.close=c-5;state.space=state.close}
  else if c==8 {state.space=state.close}
  else if c==9 {state.close=0}
  else if !seg_sentence_ignore(c) {state.close=0;state.space=0}
  encoded=encoded+state.close*4096+state.space*16384
 }
 UnicodeValue {id:encoded+state.ri*2048,status:0}
}
fn seg_grapheme(codes:&IntegerBuffer,index:i64)->bool {
 let a=seg_class_at(codes,index-1)
 let z=seg_class_at(codes,index)
 if a==1 && z==2 {return false}
 if (a>=1 && a<=3) || (z>=1 && z<=3) {return true}
 if a==4 && (z==4 || z==5 || z==7 || z==8) {return false}
 if (a==5 || a==7) && (z==5 || z==6) {return false}
 if (a==6 || a==8) && z==6 {return false}
 if z==9 || z==10 || z==11 || a==12 {return false}
 // Unicode18 GB9c: Linker Extend* x Consonant. A preceding consonant is not required.
 if ((integer_buffer_get(codes,index).value>>9)&3)==1 {
  var j=index-1
  while j>=0 && ((integer_buffer_get(codes,j).value>>9)&3)==2 {j=j-1}
  if j>=0 && ((integer_buffer_get(codes,j).value>>9)&3)==3 {return false}
 }
 if a==10 && (integer_buffer_get(codes,index).value&256)!=0 {
  var j=index-2
  while j>=0 && seg_class_at(codes,j)==9 {j=j-1}
  if j>=0 && (integer_buffer_get(codes,j).value&256)!=0 {return false}
 }
 if a==13 && z==13 && (integer_buffer_get(codes,index-1).value&2048)!=0 {return false}
 true
}
fn seg_word(codes:&IntegerBuffer,index:i64)->bool {
 var a=seg_class_at(codes,index-1)
 let z=seg_class_at(codes,index)
 if a==1 && z==2 {return false}
 if seg_word_newline(a) || seg_word_newline(z) {return true}
 if a==6 && (integer_buffer_get(codes,index).value&256)!=0 {return false}
 if a==7 && z==7 {return false}
 if seg_word_ignore(z) {return false}
 let left=seg_previous(codes,index-1,1)
 if left<0 {return true}
 a=seg_class_at(codes,left)
 let before=seg_class_at(codes,seg_previous(codes,left-1,1))
 let after=seg_class_at(codes,seg_next(codes,index+1,1))
 if seg_ah(a) && seg_ah(z) {return false}
 if seg_ah(a) && seg_midletter(z) && seg_ah(after) {return false}
 if seg_midletter(a) && seg_ah(z) && seg_ah(before) {return false}
 if a==9 && z==14 {return false}
 if a==9 && z==15 && after==9 {return false}
 if a==15 && z==9 && before==9 {return false}
 if (a==10 && z==10) || (seg_ah(a) && z==10) || (a==10 && seg_ah(z)) {return false}
 if (a==10 && seg_midnum(z) && after==10) || (seg_midnum(a) && z==10 && before==10) {return false}
 if a==16 && z==16 {return false}
 if ((seg_ah(a) || a==10 || a==16 || a==17) && z==17) || (a==17 && (seg_ah(z) || z==10 || z==16)) {return false}
 if a==18 && z==18 && (integer_buffer_get(codes,left).value&2048)!=0 {return false}
 true
}
fn seg_sentence(codes:&IntegerBuffer,index:i64)->bool {
 let actual=seg_class_at(codes,index-1)
 let z=seg_class_at(codes,index)
 if actual==1 && z==2 {return false}
 if seg_para(actual) {return true}
 if seg_sentence_ignore(z) {return false}
 let left=seg_previous(codes,index-1,2)
 let a=seg_class_at(codes,left)
 if a==6 && z==13 {return false}
 let before=seg_class_at(codes,seg_previous(codes,left-1,2))
 if (before==10 || before==11) && a==6 && z==11 {return false}
 let suffix=integer_buffer_get(codes,index-1).value
 let close=(suffix>>12)&3
 let space=(suffix>>14)&3
 if close!=0 && (z==8 || z==9 || seg_para(z)) {return false}
 if space!=0 && (z==9 || seg_para(z)) {return false}
 if space==1 {
  var at=index
  let n=integer_buffer_len(codes)
  while at<n {
   let k=seg_class_at(codes,at)
   if k==10 {return false}
   if k==11 || k==12 || seg_para(k) || seg_sat(k) {break}
   at=at+1
  }
 }
 if space!=0 && (z==14 || seg_sat(z)) {return false}
 space!=0
}
pub fn unicode_segment_append(input:&Utf8Text,mode:i64,max_work_bytes:i64,out:&!IntegerBuffer)->i64 with Alloc,Mut,Div,Panic {
 if mode<0 || mode>2 || max_work_bytes<0 || max_work_bytes>9223372036854771704 {return 1}
 if utf8_text_status(input)!=0 {return utf8_text_status(input)}
 if integer_buffer_status(out)!=0 {return integer_buffer_status(out)}
 let data=unicode_data()
 if unicode_data_status(&data)!=0 {return 6}
 let old=integer_buffer_len(out)
 let bytes=utf8_text_byte_len(input)
 if bytes==0 {
  if old==9223372036854775807 {return 2}
  let status=integer_buffer_reserve(out,old+1)
  if status!=0 {return status}
  assert(integer_buffer_push(out,0)==0)
  return 0
 }
 if max_work_bytes<16 {return 2}
 let limit=(max_work_bytes-16)/24
 let props=SegProperties {mode:mode,main:ucd_property(&data,if mode==0 {"Grapheme_Cluster_Break"} else if mode==1 {"Word_Break"} else {"Sentence_Break"}),ep:if mode<2 {ucd_property(&data,"Extended_Pictographic")} else {0},incb:if mode==0 {ucd_property(&data,"Indic_Conjunct_Break")} else {0}}
 if props.main<0 || props.ep<0 || props.incb<0 {return 6}
 var codes=integer_buffer_new(0,limit*8)
 var offsets=integer_buffer_new(0,(limit+1)*8)
 var boundaries=integer_buffer_new(0,(limit+1)*8)
 var state=SegState {ri:0,close:0,space:0}
 var status:i64=0
 var offset:i64=0
 while status==0 && offset<bytes {
  let scalar=utf8_text_next(input,offset)
  if scalar.status!=0 {status=scalar.status}
  else {
   let code=seg_encode(&data,&props,scalar.codepoint,&!state)
   if code.status!=0 {status=code.status}
   else {
    status=integer_buffer_push(&!codes,code.id)
    if status==0 {status=integer_buffer_push(&!offsets,offset)}
   }
   offset=scalar.next
  }
 }
 if status==0 {status=integer_buffer_push(&!offsets,bytes)}
 if status==0 {status=integer_buffer_push(&!boundaries,0)}
 var at:i64=1
 let count=integer_buffer_len(&codes)
 while status==0 && at<count {
  let boundary=if mode==0 {seg_grapheme(&codes,at)} else if mode==1 {seg_word(&codes,at)} else {seg_sentence(&codes,at)}
  if boundary {status=integer_buffer_push(&!boundaries,integer_buffer_get(&offsets,at).value)}
  at=at+1
 }
 if status==0 {status=integer_buffer_push(&!boundaries,bytes)}
 let n=integer_buffer_len(&boundaries)
 if status==0 && n>9223372036854775807-old {status=2}
 if status==0 {status=integer_buffer_reserve(out,old+n)}
 at=0
 while status==0 && at<n {assert(integer_buffer_push(out,integer_buffer_get(&boundaries,at).value)==0);at=at+1}
 integer_buffer_close(boundaries)
 integer_buffer_close(offsets)
 integer_buffer_close(codes)
 status
}
