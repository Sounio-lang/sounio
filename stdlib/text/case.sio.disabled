//! stdlib/text/case.sio - Case Conversion
//!
//! Provides Unicode-aware case conversion functions.

// ============================================================================
// Character Case Conversion
// ============================================================================

// Convert a character to uppercase.
pub fn char_to_uppercase(c: char) -> char {
    let code = c as u32

    // ASCII lowercase
    if code >= 0x61 && code <= 0x7A {
        return ((code - 32) as char)
    }

    // Latin-1 lowercase
    if code >= 0xE0 && code <= 0xF6 {
        return ((code - 32) as char)
    }
    if code >= 0xF8 && code <= 0xFE {
        return ((code - 32) as char)
    }

    // Greek lowercase
    if code >= 0x3B1 && code <= 0x3C9 {
        return ((code - 32) as char)
    }

    // Cyrillic lowercase
    if code >= 0x430 && code <= 0x44F {
        return ((code - 32) as char)
    }

    // Special cases
    if code == 0xDF {   // ß -> ẞ (German sharp s)
        return (0x1E9E as char)
    }
    if code == 0xB5 {   // µ -> Μ (Micro sign to Greek Mu)
        return (0x039C as char)
    }

    c
}

// Convert a character to lowercase.
pub fn char_to_lowercase(c: char) -> char {
    let code = c as u32

    // ASCII uppercase
    if code >= 0x41 && code <= 0x5A {
        return ((code + 32) as char)
    }

    // Latin-1 uppercase
    if code >= 0xC0 && code <= 0xD6 {
        return ((code + 32) as char)
    }
    if code >= 0xD8 && code <= 0xDE {
        return ((code + 32) as char)
    }

    // Greek uppercase
    if code >= 0x391 && code <= 0x3A9 {
        return ((code + 32) as char)
    }

    // Cyrillic uppercase
    if code >= 0x410 && code <= 0x42F {
        return ((code + 32) as char)
    }

    c
}

// ============================================================================
// String Case Conversion
// ============================================================================

// Convert a string to uppercase.
pub fn to_uppercase(s: &str) -> String with Alloc {
    var result = string_new()
    string_reserve(&!result, s.len())

    for c in s.chars() {
        string_push(&!result, char_to_uppercase(c))
    }

    result
}

// Convert a string to lowercase.
pub fn to_lowercase(s: &str) -> String with Alloc {
    var result = string_new()
    string_reserve(&!result, s.len())

    for c in s.chars() {
        string_push(&!result, char_to_lowercase(c))
    }

    result
}

// Convert a string to titlecase (first letter of each word uppercase).
pub fn to_titlecase(s: &str) -> String with Alloc {
    var result = string_new()
    string_reserve(&!result, s.len())

    var at_word_start = true

    for c in s.chars() {
        if char_is_whitespace(c) || char_is_punctuation(c) {
            at_word_start = true
            string_push(&!result, c)
        } else if at_word_start {
            string_push(&!result, char_to_uppercase(c))
            at_word_start = false
        } else {
            string_push(&!result, char_to_lowercase(c))
        }
    }

    result
}

// Capitalize the first character of a string.
pub fn capitalize(s: &str) -> String with Alloc {
    if s.len() == 0 {
        return string_new()
    }

    var result = string_new()
    string_reserve(&!result, s.len())

    var first = true
    for c in s.chars() {
        if first {
            string_push(&!result, char_to_uppercase(c))
            first = false
        } else {
            string_push(&!result, c)
        }
    }

    result
}

// Capitalize the first character and lowercase the rest.
pub fn capitalize_first(s: &str) -> String with Alloc {
    if s.len() == 0 {
        return string_new()
    }

    var result = string_new()
    string_reserve(&!result, s.len())

    var first = true
    for c in s.chars() {
        if first {
            string_push(&!result, char_to_uppercase(c))
            first = false
        } else {
            string_push(&!result, char_to_lowercase(c))
        }
    }

    result
}

// Swap the case of each character.
pub fn swap_case(s: &str) -> String with Alloc {
    var result = string_new()
    string_reserve(&!result, s.len())

    for c in s.chars() {
        if char_is_uppercase(c) {
            string_push(&!result, char_to_lowercase(c))
        } else if char_is_lowercase(c) {
            string_push(&!result, char_to_uppercase(c))
        } else {
            string_push(&!result, c)
        }
    }

    result
}

// ============================================================================
// Case Checking
// ============================================================================

// Check if a string is all uppercase.
pub fn is_uppercase(s: &str) -> bool {
    for c in s.chars() {
        if char_is_alphabetic(c) && !char_is_uppercase(c) {
            return false
        }
    }
    true
}

// Check if a string is all lowercase.
pub fn is_lowercase(s: &str) -> bool {
    for c in s.chars() {
        if char_is_alphabetic(c) && !char_is_lowercase(c) {
            return false
        }
    }
    true
}

// Check if a string is titlecase.
pub fn is_titlecase(s: &str) -> bool {
    var at_word_start = true

    for c in s.chars() {
        if char_is_whitespace(c) || char_is_punctuation(c) {
            at_word_start = true
        } else if char_is_alphabetic(c) {
            if at_word_start {
                if !char_is_uppercase(c) {
                    return false
                }
            } else {
                if !char_is_lowercase(c) {
                    return false
                }
            }
            at_word_start = false
        }
    }

    true
}

// ============================================================================
// Identifier Case Styles
// ============================================================================

// Convert to snake_case.
pub fn to_snake_case(s: &str) -> String with Alloc {
    var result = string_new()
    var prev_lower = false

    for c in s.chars() {
        if char_is_whitespace(c) || c == '-' || c == '_' {
            if result.len() > 0 && !result.ends_with("_") {
                string_push(&!result, '_')
            }
            prev_lower = false
        } else if char_is_uppercase(c) {
            if prev_lower && result.len() > 0 {
                string_push(&!result, '_')
            }
            string_push(&!result, char_to_lowercase(c))
            prev_lower = false
        } else {
            string_push(&!result, c)
            prev_lower = char_is_lowercase(c)
        }
    }

    result
}

// Convert to SCREAMING_SNAKE_CASE.
pub fn to_screaming_snake_case(s: &str) -> String with Alloc {
    let snake = to_snake_case(s)
    to_uppercase(&snake)
}

// Convert to camelCase.
pub fn to_camel_case(s: &str) -> String with Alloc {
    var result = string_new()
    var capitalize_next = false
    var first = true

    for c in s.chars() {
        if char_is_whitespace(c) || c == '-' || c == '_' {
            capitalize_next = true
        } else if capitalize_next {
            string_push(&!result, char_to_uppercase(c))
            capitalize_next = false
        } else if first {
            string_push(&!result, char_to_lowercase(c))
            first = false
        } else {
            string_push(&!result, c)
        }
    }

    result
}

// Convert to PascalCase.
pub fn to_pascal_case(s: &str) -> String with Alloc {
    var result = string_new()
    var capitalize_next = true

    for c in s.chars() {
        if char_is_whitespace(c) || c == '-' || c == '_' {
            capitalize_next = true
        } else if capitalize_next {
            string_push(&!result, char_to_uppercase(c))
            capitalize_next = false
        } else {
            string_push(&!result, char_to_lowercase(c))
        }
    }

    result
}

// Convert to kebab-case.
pub fn to_kebab_case(s: &str) -> String with Alloc {
    var result = string_new()
    var prev_lower = false

    for c in s.chars() {
        if char_is_whitespace(c) || c == '_' || c == '-' {
            if result.len() > 0 && !result.ends_with("-") {
                string_push(&!result, '-')
            }
            prev_lower = false
        } else if char_is_uppercase(c) {
            if prev_lower && result.len() > 0 {
                string_push(&!result, '-')
            }
            string_push(&!result, char_to_lowercase(c))
            prev_lower = false
        } else {
            string_push(&!result, c)
            prev_lower = char_is_lowercase(c)
        }
    }

    result
}

// Import unicode functions
use super::unicode::{char_is_whitespace, char_is_punctuation, char_is_alphabetic,
                     char_is_uppercase, char_is_lowercase}
