//! stdlib/text/interpolate.sio — String template substitution
//
// Replaces {key} placeholders in a template string with provided values.
// Requires: str_concat, str_slice, str_len, str_eq (builtins)
// Requires: format_int, format_f64 (from stdlib/text/format.sio)

// Internal helper: find first occurrence of needle in haystack starting at
// position start. Returns index >= 0 if found, or -1 if not found.
fn interp_find(haystack: string, needle: string, start: i64) -> i64 with Mut, Div {
    let hlen = str_len(haystack)
    let nlen = str_len(needle)
    if nlen == 0 { return start }
    var i: i64 = start
    while i + nlen <= hlen {
        let sub = str_slice(haystack, i, i + nlen)
        if str_eq(sub, needle) { return i }
        i = i + 1
    }
    return 0 - 1
}

// Internal: replace first occurrence of {placeholder} in template with value.
fn interp_replace(template: string, placeholder: string, value: string) -> string with Mut, Div {
    // Build "{placeholder}" using intermediate var to avoid nested str_concat eval-order bug
    let ph_inner = str_concat(placeholder, "}")
    let ph = str_concat("{", ph_inner)
    let ph_len = str_len(ph)
    let t_len = str_len(template)
    let pos = interp_find(template, ph, 0)
    if pos < 0 { return template }
    let before = str_slice(template, 0, pos)
    let after = str_slice(template, pos + ph_len, t_len)
    let result = str_concat(before, value)
    str_concat(result, after)
}

// Replace {key} with string value in template.
pub fn interp_str(template: string, key: string, value: string) -> string with Mut, Div {
    interp_replace(template, key, value)
}

// Replace {key} with i64 value (decimal) in template.
pub fn interp_i64(template: string, key: string, value: i64) -> string with Mut, Div, Panic {
    interp_replace(template, key, format_int(value))
}

// Replace {key} with f64 value (4 decimal places) in template.
pub fn interp_f64(template: string, key: string, value: f64) -> string with Mut, Div, Panic {
    interp_replace(template, key, format_f64(value))
}
