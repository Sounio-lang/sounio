// Unicode18.0.0 immutable generated data. Format is documented in data/README.md.
// static_blob_bytes is a compiler intrinsic: pure, embedded, source-relative, static lifetime.
// This module never opens a file or calls a host Unicode library.
pub struct UnicodeData { ptr:*const u8, size:i64, status:i64 }
pub struct UnicodeValue { pub id:i64, pub status:i64 }
pub fn unicode_data_status(t:&UnicodeData)->i64 {t.status}
fn ucd_byte(t:&UnicodeData,index:i64)->i64 {
 if index<0 || index>=t.size {return 0-1}
 let p=((t.ptr as i64)+index) as *const u8
 (*p as i64)&255
}
fn ucd_u32(t:&UnicodeData,index:i64)->i64 {
 if index<0 || index>t.size || t.size-index<4 {return 0-1}
 ucd_byte(t,index)+ucd_byte(t,index+1)*256+ucd_byte(t,index+2)*65536+ucd_byte(t,index+3)*16777216
}
fn ucd_section(t:&UnicodeData,id:i64)->i64 {
 if t.status!=0 || id<1 || id>8 {return 0-1}
 let p=24+(id-1)*16
 if ucd_u32(t,p)!=id {return 0-1}
 let width=ucd_u32(t,p+4)
 let count=ucd_u32(t,p+8)
 let offset=ucd_u32(t,p+12)
 if width<=0 || width>28 || count<0 || offset<0 || offset>t.size {return 0-1}
 if count*width>t.size-offset {return 0-1}
 p
}
pub fn ucd_count(t:&UnicodeData,id:i64)->i64 {
 let section=ucd_section(t,id)
 if section<0 {return 0-1}
 ucd_u32(t,section+8)
}
pub fn ucd_field(t:&UnicodeData,id:i64,row:i64,column:i64)->i64 {
 let section=ucd_section(t,id)
 if section<0 {return 0-1}
 let width=ucd_u32(t,section+4)
 let count=ucd_u32(t,section+8)
 let offset=ucd_u32(t,section+12)
 if row<0 || row>=count || column<0 || column>6 {return 0-1}
 if column*4>=width {return 0-1}
 ucd_u32(t,offset+row*width+column*4)
}
pub fn ucd_string_byte(t:&UnicodeData,id:i64,index:i64)->i64 {
 let section=ucd_section(t,1)
 if section<0 {return 0-1}
 let size=ucd_u32(t,section+8)
 if id<0 || index<0 || id>=size || index>=size-id {return 0-1}
 ucd_byte(t,ucd_u32(t,section+12)+id+index)
}
fn ucd_skip(c:i64)->bool {c==32 || c==45 || c==95}
fn ucd_ascii_lower(c:i64)->i64 {if c>=65 && c<=90 {return c+32} c}
pub fn ucd_string_matches(t:&UnicodeData,id:i64,text:string)->bool {
 if id<0 {return false}
 var a:i64=0
 var b:i64=0
 let n=str_len(text)
 while true {
  var x=ucd_string_byte(t,id,a)
  while ucd_skip(x) {a=a+1;x=ucd_string_byte(t,id,a)}
  var y=if b<n {str_char_at(text,b)} else {0}
  while ucd_skip(y) {b=b+1;y=if b<n {str_char_at(text,b)} else {0}}
  if x<0 {return false}
  if ucd_ascii_lower(x)!=ucd_ascii_lower(y) {return false}
  if x==0 {return b==n}
  a=a+1
  b=b+1
 }
 false
}
fn ucd_string_ids_equal(t:&UnicodeData,a:i64,b:i64)->bool {
 if a<0 || b<0 {return false}
 var i:i64=0
 while true {
  let x=ucd_string_byte(t,a,i)
  let y=ucd_string_byte(t,b,i)
  if x<0 || y<0 || x!=y {return false}
  if x==0 {return true}
  i=i+1
 }
 false
}
pub fn ucd_property(t:&UnicodeData,name:string)->i64 {
 let n=ucd_count(t,2)
 var i:i64=0
 while i<n {if ucd_string_matches(t,ucd_field(t,2,i,0),name) {return i} i=i+1}
 // The generated alias directory includes normalized short and long aliases.
 var a:i64=0
 let aliases=ucd_count(t,7)
 while a<aliases {
  if ucd_string_matches(t,ucd_field(t,7,a,0),name) {
   let canonical=ucd_field(t,7,a,1)
   i=0
   while i<n {if ucd_string_ids_equal(t,ucd_field(t,2,i,0),canonical) {return i} i=i+1}
   return 0-1
  }
  a=a+1
 }
 0-1
}
fn ucd_raw_property_value(t:&UnicodeData,property:i64,cp:i64)->UnicodeValue {
 if t.status!=0 {return UnicodeValue {id:0,status:6}}
 if cp<0 || cp>1114111 {return UnicodeValue {id:0,status:5}}
 if property<0 || property>=ucd_count(t,2) {return UnicodeValue {id:0,status:4}}
 let first=ucd_field(t,2,property,1)
 var lo:i64=0
 var hi=ucd_field(t,2,property,2)
 while lo<hi {
  let mid=lo+((hi-lo)>>1)
  let row=first+mid
  if cp<ucd_field(t,3,row,0) {hi=mid}
  else if cp>ucd_field(t,3,row,1) {lo=mid+1}
  else {return UnicodeValue {id:ucd_field(t,3,row,2),status:0}}
 }
 UnicodeValue {id:ucd_field(t,2,property,3),status:0}
}
// Script_Extensions inherits Script when the UCD uses its <script> default.
pub fn ucd_property_value(t:&UnicodeData,property:i64,cp:i64)->UnicodeValue {
 let value=ucd_raw_property_value(t,property,cp)
 if value.status!=0 {return value}
 if ucd_string_matches(t,ucd_field(t,2,property,0),"Script_Extensions") && ucd_string_matches(t,value.id,"<script>") {
  let script=ucd_property(t,"Script")
  if script<0 {return UnicodeValue {id:0,status:6}}
  return ucd_raw_property_value(t,script,cp)
 }
 value
}
fn ucd_string_exact(t:&UnicodeData,id:i64,text:string)->bool {
 let n=str_len(text)
 var i:i64=0
 while i<n {if ucd_string_byte(t,id,i)!=str_char_at(text,i) {return false} i=i+1}
 ucd_string_byte(t,id,n)==0
}
fn ucd_alias_value(t:&UnicodeData,property:i64,name:string)->i64 {
 let canonical_property=ucd_field(t,2,property,0)
 var i:i64=0
 let n=ucd_count(t,8)
 while i<n {
  if ucd_string_ids_equal(t,canonical_property,ucd_field(t,8,i,0)) && ucd_string_matches(t,ucd_field(t,8,i,1),name) {return ucd_field(t,8,i,2)}
  i=i+1
 }
 0-1
}
fn ucd_list_contains(t:&UnicodeData,list:i64,word:i64)->bool {
 if list<0 || word<0 {return false}
 var at:i64=0
 while true {
  let c=ucd_string_byte(t,list,at)
  if c<0 || c==0 {return false}
  if c==32 {at=at+1;continue}
  var i:i64=0
  var equal=true
  while ucd_string_byte(t,list,at)>32 {
   if ucd_string_byte(t,list,at)!=ucd_string_byte(t,word,i) {equal=false}
   at=at+1
   i=i+1
  }
  if equal && ucd_string_byte(t,word,i)==0 {return true}
 }
 false
}
// Numeric and mapping/string properties require canonical UCD text, preserving minus signs.
// Enumerated/binary aliases use UAX44 loose matching; GC groups and scx sets are semantic.
pub fn ucd_value_matches(t:&UnicodeData,property:i64,value:i64,name:string)->bool {
 if property<0 || property>=ucd_count(t,2) || value<0 {return false}
 let canonical=ucd_field(t,2,property,0)
 if ucd_string_matches(t,canonical,"Numeric_Value") || ucd_string_matches(t,canonical,"Decimal_Digit_Value") || ucd_string_matches(t,canonical,"Digit_Value") || ucd_string_matches(t,canonical,"Bidi_Mirroring_Glyph") || ucd_string_matches(t,canonical,"Bidi_Paired_Bracket") || ucd_string_matches(t,canonical,"Equivalent_Unified_Ideograph") || ucd_string_matches(t,canonical,"FC_NFKC_Closure") || ucd_string_matches(t,canonical,"NFKC_Casefold") || ucd_string_matches(t,canonical,"NFKC_Simple_Casefold") {return ucd_string_exact(t,value,name)}
 if ucd_string_matches(t,value,name) {return true}
 if ucd_string_matches(t,canonical,"Script_Extensions") {
  let script=ucd_property(t,"Script")
  return script>=0 && ucd_list_contains(t,value,ucd_alias_value(t,script,name))
 }
 let wanted=ucd_alias_value(t,property,name)
 if wanted<0 {return false}
 if ucd_string_ids_equal(t,value,wanted) {return true}
 if ucd_string_matches(t,canonical,"General_Category") {
  if ucd_string_matches(t,wanted,"LC") {return ucd_string_matches(t,value,"Lu") || ucd_string_matches(t,value,"Ll") || ucd_string_matches(t,value,"Lt")}
  let first=ucd_string_byte(t,wanted,0)
  if ucd_string_byte(t,wanted,1)==0 && (first==67 || first==76 || first==77 || first==78 || first==80 || first==83 || first==90) {return ucd_string_byte(t,value,0)==first}
 }
 false
}
pub fn ucd_decimal_value(t:&UnicodeData,value:i64)->i64 {
 var n:i64=0
 var i:i64=0
 while true {
  let c=ucd_string_byte(t,value,i)
  if c==0 {return if i>0 {n} else {0-1}}
  if c<48 || c>57 {return 0-1}
  if n>922337203685477580 || (n==922337203685477580 && c-48>7) {return 0-1}
  n=n*10+c-48
  i=i+1
 }
 0-1
}
// Returns a row number; absent mappings are identity. kind1=decomposition,
// 3/4/5=simple upper/lower/title;6=defaultfold;7=Turkic override;
// 8/9/10=full lower/title/upper (condition string in field5).
pub fn ucd_mapping(t:&UnicodeData,kind:i64,cp:i64)->i64 {
 var lo:i64=0
 var hi=ucd_count(t,4)
 while lo<hi {
  let mid=lo+((hi-lo)>>1)
  let k=ucd_field(t,4,mid,0)
  let c=ucd_field(t,4,mid,1)
  if k<kind || (k==kind && c<cp) {lo=mid+1} else {hi=mid}
 }
 if lo>=ucd_count(t,4) {return 0-1}
 if ucd_field(t,4,lo,0)!=kind || ucd_field(t,4,lo,1)!=cp {return 0-1}
 lo
}
pub fn ucd_compose(t:&UnicodeData,a:i64,b:i64)->i64 with Div {
 if a>=4352 && a<4371 && b>=4449 && b<4470 {return 44032+(a-4352)*588+(b-4449)*28}
 if a>=44032 && a<55204 && (a-44032)%28==0 && b>4519 && b<4547 {return a+b-4519}
 var lo:i64=0
 var hi=ucd_count(t,6)
 while lo<hi {
  let mid=lo+((hi-lo)>>1)
  let x=ucd_field(t,6,mid,0)
  let y=ucd_field(t,6,mid,1)
  if x<a || (x==a && y<b) {lo=mid+1} else {hi=mid}
 }
 if lo>=ucd_count(t,6) {return 0}
 if ucd_field(t,6,lo,0)!=a || ucd_field(t,6,lo,1)!=b {return 0}
 ucd_field(t,6,lo,2)
}
pub fn unicode_data()->UnicodeData {
 let (ptr,size)=static_blob_bytes("data/unicode18.bin")
 var t=UnicodeData {ptr:ptr,size:size,status:0}
 if size<152 {t.status=6;return t}
 if ucd_byte(&t,0)!=83 || ucd_byte(&t,1)!=79 || ucd_byte(&t,2)!=85 || ucd_byte(&t,3)!=78 {t.status=6;return t}
 if ucd_byte(&t,4)!=85 || ucd_byte(&t,5)!=67 || ucd_byte(&t,6)!=68 || ucd_byte(&t,7)!=49 {t.status=6;return t}
 if ucd_u32(&t,8)!=1 || ucd_u32(&t,12)!=1179648 || ucd_u32(&t,16)!=8 {t.status=6;return t}
 var id:i64=1
 while id<=8 {
  let section=ucd_section(&t,id)
  if section<0 {t.status=6;return t}
  let width=ucd_u32(&t,section+4)
  let expected=if id==1 {1} else if id==2 {16} else if id==4 {28} else if id==5 {4} else if id==7 {8} else {12}
  if width!=expected || ucd_u32(&t,section+12)<152 {t.status=6;return t}
  id=id+1
 }
 t
}
pub fn unicode_property_value(cp:i64,property:string)->UnicodeValue {
 let data=unicode_data()
 ucd_property_value(&data,ucd_property(&data,property),cp)
}
pub fn unicode_property_is(cp:i64,property:string,value:string)->bool {
 let data=unicode_data()
 let prop=ucd_property(&data,property)
 let result=ucd_property_value(&data,prop,cp)
 result.status==0 && ucd_value_matches(&data,prop,result.id,value)
}
