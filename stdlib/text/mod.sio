// stdlib/text/mod.sio — Public exports for the text module
//
// Per stdlib/CONVENTIONS.md §2, mod.sio declares only the public surface
// (pub use re-exports). Implementations live in the sibling files.

pub use text::interpolate::{
    interp_f64,
    interp_i64,
    interp_str,
}


// Owned UTF8 is length-aware and preserves embedded NUL. Constructors copy;
// returned owners require explicit close. Legacy primitive strings remain C strings.
pub use text::utf8::{
 Utf8Text,utf8_next,utf8_text_new,utf8_text_from_bytes,utf8_text_from_string,
 utf8_text_status,utf8_text_byte_len,utf8_text_scalar_len,utf8_text_byte_at,
 utf8_text_next,utf8_text_append_bytes,utf8_text_append_scalar,
 utf8_text_copy_bytes,utf8_encode_append,utf8_text_close,
}
pub use text::utf8_scalar::{Utf8Scalar,utf8_decode4,utf8_scalar_width}

