//! stdlib/text/wrap.sio - Text Wrapping and Formatting
//!
//! Provides functions for wrapping and formatting text.

use super::unicode::{char_is_whitespace};

// ============================================================================
// Text Wrapping
// ============================================================================

// Wrap text to a maximum line width.
//
// Wraps at word boundaries when possible.
pub fn text_wrap(text: &str, width: usize) -> String with Alloc {
    if width == 0 {
        return string_from(text)
    }

    var result = string_new()
    var line_len = 0
    var word = string_new()

    for c in text.chars() {
        if c == '\n' {
            // Preserve explicit newlines
            if word.len() > 0 {
                if line_len > 0 && line_len + word.len() > width {
                    string_push(&!result, '\n')
                    line_len = 0
                }
                if line_len > 0 {
                    string_push(&!result, ' ')
                    line_len = line_len + 1
                }
                string_push_str(&!result, &word)
                line_len = line_len + word.len()
                string_clear(&!word)
            }
            string_push(&!result, '\n')
            line_len = 0
        } else if char_is_whitespace(c) {
            // End of word
            if word.len() > 0 {
                if line_len > 0 && line_len + 1 + word.len() > width {
                    string_push(&!result, '\n')
                    line_len = 0
                }
                if line_len > 0 {
                    string_push(&!result, ' ')
                    line_len = line_len + 1
                }
                string_push_str(&!result, &word)
                line_len = line_len + word.len()
                string_clear(&!word)
            }
        } else {
            // Part of a word
            string_push(&!word, c)

            // Handle very long words
            if word.len() > width && line_len == 0 {
                string_push_str(&!result, &word)
                string_push(&!result, '\n')
                string_clear(&!word)
            }
        }
    }

    // Add remaining word
    if word.len() > 0 {
        if line_len > 0 && line_len + 1 + word.len() > width {
            string_push(&!result, '\n')
        } else if line_len > 0 {
            string_push(&!result, ' ')
        }
        string_push_str(&!result, &word)
    }

    result
}

// Wrap text with a hanging indent.
//
// First line uses no indent, subsequent lines are indented.
pub fn text_wrap_indent(text: &str, width: usize, indent: &str) -> String with Alloc {
    let wrapped = text_wrap(text, width - indent.len())
    var result = string_new()
    var first = true

    for line in wrapped.lines() {
        if !first {
            string_push_str(&!result, indent)
        }
        string_push_str(&!result, line)
        string_push(&!result, '\n')
        first = false
    }

    // Remove trailing newline
    if result.len() > 0 && result.ends_with("\n") {
        string_pop(&!result)
    }

    result
}

// ============================================================================
// Text Alignment
// ============================================================================

// Left-align text within a given width.
pub fn text_align_left(text: &str, width: usize) -> String with Alloc {
    let len = text.len()
    if len >= width {
        return string_from(text)
    }

    var result = string_from(text)
    var i = len
    while i < width {
        string_push(&!result, ' ')
        i = i + 1
    }

    result
}

// Right-align text within a given width.
pub fn text_align_right(text: &str, width: usize) -> String with Alloc {
    let len = text.len()
    if len >= width {
        return string_from(text)
    }

    var result = string_new()
    var i = 0
    while i < width - len {
        string_push(&!result, ' ')
        i = i + 1
    }
    string_push_str(&!result, text)

    result
}

// Center text within a given width.
pub fn text_align_center(text: &str, width: usize) -> String with Alloc {
    let len = text.len()
    if len >= width {
        return string_from(text)
    }

    let padding = width - len
    let left_pad = padding / 2
    let right_pad = padding - left_pad

    var result = string_new()

    var i = 0
    while i < left_pad {
        string_push(&!result, ' ')
        i = i + 1
    }

    string_push_str(&!result, text)

    i = 0
    while i < right_pad {
        string_push(&!result, ' ')
        i = i + 1
    }

    result
}

// ============================================================================
// Text Indentation
// ============================================================================

// Indent each line of text.
pub fn text_indent(text: &str, indent: &str) -> String with Alloc {
    var result = string_new()
    var at_line_start = true

    for c in text.chars() {
        if at_line_start && c != '\n' {
            string_push_str(&!result, indent)
            at_line_start = false
        }

        string_push(&!result, c)

        if c == '\n' {
            at_line_start = true
        }
    }

    result
}

// Remove common leading whitespace from all lines (dedent).
pub fn text_dedent(text: &str) -> String with Alloc {
    // Find minimum indentation (excluding empty lines)
    var min_indent: Option<usize> = None

    for line in text.lines() {
        if line.is_empty() || line.chars().all(char_is_whitespace) {
            continue
        }

        var indent = 0
        for c in line.chars() {
            if char_is_whitespace(c) {
                indent = indent + 1
            } else {
                break
            }
        }

        match min_indent {
            None => min_indent = Some(indent),
            Some(m) => if indent < m { min_indent = Some(indent) },
        }
    }

    let remove = match min_indent {
        None => 0,
        Some(m) => m,
    }

    if remove == 0 {
        return string_from(text)
    }

    // Remove indentation
    var result = string_new()
    var line_start = true
    var removed = 0

    for c in text.chars() {
        if c == '\n' {
            string_push(&!result, c)
            line_start = true
            removed = 0
        } else if line_start && removed < remove && char_is_whitespace(c) {
            removed = removed + 1
        } else {
            line_start = false
            string_push(&!result, c)
        }
    }

    result
}

// ============================================================================
// Text Trimming
// ============================================================================

// Trim whitespace from both ends of a string.
pub fn text_trim(s: &str) -> String with Alloc {
    let start = string_find_first_not_whitespace(s)
    let end = string_find_last_not_whitespace(s)

    match (start, end) {
        (Some(s), Some(e)) => string_from(&s[s..e+1]),
        _ => string_new(),
    }
}

// Trim whitespace from the start of a string.
pub fn text_trim_start(s: &str) -> String with Alloc {
    let start = string_find_first_not_whitespace(s)

    match start {
        Some(idx) => string_from(&s[idx..]),
        None => string_new(),
    }
}

// Trim whitespace from the end of a string.
pub fn text_trim_end(s: &str) -> String with Alloc {
    let end = string_find_last_not_whitespace(s)

    match end {
        Some(idx) => string_from(&s[..idx+1]),
        None => string_new(),
    }
}

fn string_find_first_not_whitespace(s: &str) -> Option<usize> {
    var i = 0
    for c in s.chars() {
        if !char_is_whitespace(c) {
            return Some(i)
        }
        i = i + 1
    }
    None
}

fn string_find_last_not_whitespace(s: &str) -> Option<usize> {
    var last: Option<usize> = None
    var i = 0
    for c in s.chars() {
        if !char_is_whitespace(c) {
            last = Some(i)
        }
        i = i + 1
    }
    last
}

// ============================================================================
// Text Operations
// ============================================================================

// Truncate text to a maximum length, adding ellipsis if needed.
pub fn text_truncate(text: &str, max_len: usize, ellipsis: &str) -> String with Alloc {
    if text.len() <= max_len {
        return string_from(text)
    }

    let cut_len = max_len - ellipsis.len()
    if cut_len <= 0 {
        return string_from(&text[..max_len])
    }

    var result = string_from(&text[..cut_len])
    string_push_str(&!result, ellipsis)
    result
}

// Repeat a string n times.
pub fn text_repeat(s: &str, n: usize) -> String with Alloc {
    var result = string_new()
    string_reserve(&!result, s.len() * n)

    var i = 0
    while i < n {
        string_push_str(&!result, s)
        i = i + 1
    }

    result
}

// Pad a string on the left to a minimum length.
pub fn text_pad_left(s: &str, min_len: usize, pad_char: char) -> String with Alloc {
    if s.len() >= min_len {
        return string_from(s)
    }

    var result = string_new()
    var i = s.len()
    while i < min_len {
        string_push(&!result, pad_char)
        i = i + 1
    }
    string_push_str(&!result, s)

    result
}

// Pad a string on the right to a minimum length.
pub fn text_pad_right(s: &str, min_len: usize, pad_char: char) -> String with Alloc {
    if s.len() >= min_len {
        return string_from(s)
    }

    var result = string_from(s)
    var i = s.len()
    while i < min_len {
        string_push(&!result, pad_char)
        i = i + 1
    }

    result
}

// Remove multiple consecutive whitespace, replacing with single space.
pub fn text_collapse_whitespace(text: &str) -> String with Alloc {
    var result = string_new()
    var prev_whitespace = false

    for c in text.chars() {
        if char_is_whitespace(c) {
            if !prev_whitespace {
                string_push(&!result, ' ')
            }
            prev_whitespace = true
        } else {
            string_push(&!result, c)
            prev_whitespace = false
        }
    }

    result
}
