use text::utf8_scalar::{utf8_decode4,utf8_scalar_width}
use text::ucd_data::{unicode_data,unicode_property_is,ucd_property,ucd_property_value,ucd_string_byte,ucd_string_matches}
fn char_category_group(c:char,letter:i64)->bool {
 let data=unicode_data()
 let p=ucd_property(&data,"General_Category")
 let v=ucd_property_value(&data,p,c as i64)
 v.status==0 && ucd_string_byte(&data,v.id,0)==letter
}

//! stdlib/text/unicode.sio - Unicode Character Properties
//!
//! Provides Unicode character classification and properties.

// Check if a character is alphabetic (Unicode Letter category).
pub fn char_is_alphabetic(c:char)->bool {unicode_property_is(c as i64,"Alphabetic","Y")}

pub fn char_is_numeric(c:char)->bool {
 unicode_property_is(c as i64,"Numeric_Type","Decimal") || unicode_property_is(c as i64,"Numeric_Type","Digit") || unicode_property_is(c as i64,"Numeric_Type","Numeric")
}

pub fn char_is_alphanumeric(c: char) -> bool {
    char_is_alphabetic(c) || char_is_numeric(c)
}

pub fn char_is_whitespace(c:char)->bool {unicode_property_is(c as i64,"White_Space","Y")}

pub fn char_is_control(c:char)->bool {unicode_property_is(c as i64,"General_Category","Cc")}

pub fn char_is_punctuation(c:char)->bool {char_category_group(c,80)}

pub fn char_is_symbol(c:char)->bool {char_category_group(c,83)}

pub fn char_is_uppercase(c:char)->bool {unicode_property_is(c as i64,"Uppercase","Y")}

pub fn char_is_lowercase(c:char)->bool {unicode_property_is(c as i64,"Lowercase","Y")}

pub fn char_is_ascii(c: char) -> bool {
    (c as u32) < 128
}

pub fn char_is_ascii_digit(c:char)->bool {let cp=c as i64;cp>=48 && cp<=57}

pub fn char_is_ascii_hexdigit(c:char)->bool {let cp=c as i64;(cp>=48 && cp<=57) || (cp>=65 && cp<=70) || (cp>=97 && cp<=102)}

pub fn char_is_ascii_alphabetic(c:char)->bool {let cp=c as i64;(cp>=65 && cp<=90) || (cp>=97 && cp<=122)}

// Printable follows the Unicode L/M/N/P/S/Zs category definition.
pub fn char_is_printable(c:char)->bool {
 char_category_group(c,76) || char_category_group(c,77) || char_category_group(c,78) || char_category_group(c,80) || char_category_group(c,83) || unicode_property_is(c as i64,"General_Category","Zs")
}

pub fn char_code_point(c: char) -> u32 {
    c as u32
}

pub fn char_from_code_point(code: u32) -> Option<char> {
    if code <= 0x10FFFF && !(code >= 0xD800 && code <= 0xDFFF) {
        Some(code as char)
    } else {
        None
    }
}

pub fn is_valid_code_point(code: u32) -> bool {
    code <= 0x10FFFF && !(code >= 0xD800 && code <= 0xDFFF)
}

pub fn char_utf8_len(c:char)->usize {utf8_scalar_width(c as i64) as usize}

pub fn char_to_utf8(c: char) -> (usize, [u8; 4]) {
    let code = c as u32
    var bytes: [u8; 4] = [0; 4]
    if !is_valid_code_point(code) {return (0,bytes)}
    if code < 0x80 {
        bytes[0] = code as u8
        (1, bytes)
    } else if code < 0x800 {
        bytes[0] = (0xC0 | (code >> 6)) as u8
        bytes[1] = (0x80 | (code & 0x3F)) as u8
        (2, bytes)
    } else if code < 0x10000 {
        bytes[0] = (0xE0 | (code >> 12)) as u8
        bytes[1] = (0x80 | ((code >> 6) & 0x3F)) as u8
        bytes[2] = (0x80 | (code & 0x3F)) as u8
        (3, bytes)
    } else {
        bytes[0] = (0xF0 | (code >> 18)) as u8
        bytes[1] = (0x80 | ((code >> 12) & 0x3F)) as u8
        bytes[2] = (0x80 | ((code >> 6) & 0x3F)) as u8
        bytes[3] = (0x80 | (code & 0x3F)) as u8
        (4, bytes)
    }
}

pub fn char_from_utf8(bytes: &[u8]) -> Option<(char, usize)> {
    let n = bytes.len()
    if n == 0 { return None }
    let b0 = bytes[0] as i64
    let b1 = if n > 1 { bytes[1] as i64 } else { 0 }
    let b2 = if n > 2 { bytes[2] as i64 } else { 0 }
    let b3 = if n > 3 { bytes[3] as i64 } else { 0 }
    let scalar = utf8_decode4(b0, b1, b2, b3, n as i64, 0)
    if scalar.status != 0 { return None }
    Some((scalar.codepoint as char, scalar.next as usize))
}

pub enum GeneralCategory {
    UppercaseLetter,
    LowercaseLetter,
    TitlecaseLetter,
    ModifierLetter,
    OtherLetter,
    NonspacingMark,
    SpacingMark,
    EnclosingMark,
    DecimalNumber,
    LetterNumber,
    OtherNumber,
    ConnectorPunctuation,
    DashPunctuation,
    OpenPunctuation,
    ClosePunctuation,
    InitialPunctuation,
    FinalPunctuation,
    OtherPunctuation,
    MathSymbol,
    CurrencySymbol,
    ModifierSymbol,
    OtherSymbol,
    SpaceSeparator,
    LineSeparator,
    ParagraphSeparator,
    Control,
    Format,
    Surrogate,
    PrivateUse,
    Unassigned,
}

pub fn char_general_category(c:char)->GeneralCategory {
 let data=unicode_data()
 let p=ucd_property(&data,"General_Category")
 let v=ucd_property_value(&data,p,c as i64)
 if v.status!=0 {return GeneralCategory::Unassigned}
 if ucd_string_matches(&data,v.id,"Lu") {return GeneralCategory::UppercaseLetter}
 if ucd_string_matches(&data,v.id,"Ll") {return GeneralCategory::LowercaseLetter}
 if ucd_string_matches(&data,v.id,"Lt") {return GeneralCategory::TitlecaseLetter}
 if ucd_string_matches(&data,v.id,"Lm") {return GeneralCategory::ModifierLetter}
 if ucd_string_matches(&data,v.id,"Lo") {return GeneralCategory::OtherLetter}
 if ucd_string_matches(&data,v.id,"Mn") {return GeneralCategory::NonspacingMark}
 if ucd_string_matches(&data,v.id,"Mc") {return GeneralCategory::SpacingMark}
 if ucd_string_matches(&data,v.id,"Me") {return GeneralCategory::EnclosingMark}
 if ucd_string_matches(&data,v.id,"Nd") {return GeneralCategory::DecimalNumber}
 if ucd_string_matches(&data,v.id,"Nl") {return GeneralCategory::LetterNumber}
 if ucd_string_matches(&data,v.id,"No") {return GeneralCategory::OtherNumber}
 if ucd_string_matches(&data,v.id,"Pc") {return GeneralCategory::ConnectorPunctuation}
 if ucd_string_matches(&data,v.id,"Pd") {return GeneralCategory::DashPunctuation}
 if ucd_string_matches(&data,v.id,"Ps") {return GeneralCategory::OpenPunctuation}
 if ucd_string_matches(&data,v.id,"Pe") {return GeneralCategory::ClosePunctuation}
 if ucd_string_matches(&data,v.id,"Pi") {return GeneralCategory::InitialPunctuation}
 if ucd_string_matches(&data,v.id,"Pf") {return GeneralCategory::FinalPunctuation}
 if ucd_string_matches(&data,v.id,"Po") {return GeneralCategory::OtherPunctuation}
 if ucd_string_matches(&data,v.id,"Sm") {return GeneralCategory::MathSymbol}
 if ucd_string_matches(&data,v.id,"Sc") {return GeneralCategory::CurrencySymbol}
 if ucd_string_matches(&data,v.id,"Sk") {return GeneralCategory::ModifierSymbol}
 if ucd_string_matches(&data,v.id,"So") {return GeneralCategory::OtherSymbol}
 if ucd_string_matches(&data,v.id,"Zs") {return GeneralCategory::SpaceSeparator}
 if ucd_string_matches(&data,v.id,"Zl") {return GeneralCategory::LineSeparator}
 if ucd_string_matches(&data,v.id,"Zp") {return GeneralCategory::ParagraphSeparator}
 if ucd_string_matches(&data,v.id,"Cc") {return GeneralCategory::Control}
 if ucd_string_matches(&data,v.id,"Cf") {return GeneralCategory::Format}
 if ucd_string_matches(&data,v.id,"Cs") {return GeneralCategory::Surrogate}
 if ucd_string_matches(&data,v.id,"Co") {return GeneralCategory::PrivateUse}
 if ucd_string_matches(&data,v.id,"Cn") {return GeneralCategory::Unassigned}
 GeneralCategory::Unassigned
}
