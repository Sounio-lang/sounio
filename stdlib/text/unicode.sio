//! stdlib/text/unicode.sio - Unicode Character Properties
//!
//! Provides Unicode character classification and properties.

// Check if a character is alphabetic (Unicode Letter category).
fn char_is_alphabetic(c: char) -> bool {
    let code = c as u32
    if (code >= 0x41 && code <= 0x5A) || (code >= 0x61 && code <= 0x7A) {
        return true
    }
    if (code >= 0xC0 && code <= 0xD6) || (code >= 0xD8 && code <= 0xF6) || (code >= 0xF8 && code <= 0xFF) {
        return true
    }
    if code >= 0x370 && code <= 0x3FF { return true }
    if code >= 0x400 && code <= 0x4FF { return true }
    if code >= 0x5D0 && code <= 0x5EA { return true }
    if code >= 0x621 && code <= 0x64A { return true }
    if code >= 0x4E00 && code <= 0x9FFF { return true }
    if code >= 0x3040 && code <= 0x309F { return true }
    if code >= 0x30A0 && code <= 0x30FF { return true }
    false
}

fn char_is_numeric(c: char) -> bool {
    let code = c as u32
    if code >= 0x30 && code <= 0x39 { return true }
    if code >= 0xFF10 && code <= 0xFF19 { return true }
    if code >= 0x660 && code <= 0x669 { return true }
    if code >= 0x6F0 && code <= 0x6F9 { return true }
    false
}

fn char_is_alphanumeric(c: char) -> bool {
    char_is_alphabetic(c) || char_is_numeric(c)
}

fn char_is_whitespace(c: char) -> bool {
    let code = c as u32
    code == 0x20 || code == 0x09 || code == 0x0A || code == 0x0B ||
    code == 0x0C || code == 0x0D || code == 0xA0 || code == 0x1680 ||
    (code >= 0x2000 && code <= 0x200A) ||
    code == 0x2028 || code == 0x2029 || code == 0x202F || code == 0x205F || code == 0x3000
}

fn char_is_control(c: char) -> bool {
    let code = c as u32
    code < 0x20 || (code >= 0x7F && code <= 0x9F)
}

fn char_is_punctuation(c: char) -> bool {
    let code = c as u32
    (code >= 0x21 && code <= 0x2F) ||
    (code >= 0x3A && code <= 0x40) ||
    (code >= 0x5B && code <= 0x60) ||
    (code >= 0x7B && code <= 0x7E) ||
    (code >= 0x2000 && code <= 0x206F) ||
    (code >= 0x3000 && code <= 0x303F)
}

fn char_is_symbol(c: char) -> bool {
    let code = c as u32
    (code >= 0x24 && code <= 0x24) ||
    (code >= 0xA2 && code <= 0xA5) ||
    (code >= 0x20A0 && code <= 0x20CF) ||
    (code >= 0x2200 && code <= 0x22FF) ||
    (code >= 0x2600 && code <= 0x26FF) ||
    (code >= 0x2700 && code <= 0x27BF) ||
    (code >= 0x1F300 && code <= 0x1F9FF)
}

fn char_is_uppercase(c: char) -> bool {
    let code = c as u32
    if code >= 0x41 && code <= 0x5A { return true }
    if (code >= 0xC0 && code <= 0xD6) || (code >= 0xD8 && code <= 0xDE) { return true }
    if code >= 0x391 && code <= 0x3A9 { return true }
    if code >= 0x410 && code <= 0x42F { return true }
    false
}

fn char_is_lowercase(c: char) -> bool {
    let code = c as u32
    if code >= 0x61 && code <= 0x7A { return true }
    if (code >= 0xDF && code <= 0xF6) || (code >= 0xF8 && code <= 0xFF) { return true }
    if code >= 0x3B1 && code <= 0x3C9 { return true }
    if code >= 0x430 && code <= 0x44F { return true }
    false
}

fn char_is_ascii(c: char) -> bool {
    (c as u32) < 128
}

fn char_is_ascii_digit(c: char) -> bool {
    c >= '0' && c <= '9'
}

fn char_is_ascii_hexdigit(c: char) -> bool {
    (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')
}

fn char_is_ascii_alphabetic(c: char) -> bool {
    (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z')
}

fn char_is_printable(c: char) -> bool {
    !char_is_control(c) && c != (127 as char)
}

fn char_code_point(c: char) -> u32 {
    c as u32
}

fn char_from_code_point(code: u32) -> Option<char> {
    if code <= 0x10FFFF && !(code >= 0xD800 && code <= 0xDFFF) {
        Some(code as char)
    } else {
        None
    }
}

fn is_valid_code_point(code: u32) -> bool {
    code <= 0x10FFFF && !(code >= 0xD800 && code <= 0xDFFF)
}

fn char_utf8_len(c: char) -> usize {
    let code = c as u32
    if code < 0x80 { 1 }
    else if code < 0x800 { 2 }
    else if code < 0x10000 { 3 }
    else { 4 }
}

fn char_to_utf8(c: char) -> (usize, [u8; 4]) {
    let code = c as u32
    var bytes = [0u8; 4]
    if code < 0x80 {
        bytes[0] = code as u8
        (1, bytes)
    } else if code < 0x800 {
        bytes[0] = (0xC0 | (code >> 6)) as u8
        bytes[1] = (0x80 | (code & 0x3F)) as u8
        (2, bytes)
    } else if code < 0x10000 {
        bytes[0] = (0xE0 | (code >> 12)) as u8
        bytes[1] = (0x80 | ((code >> 6) & 0x3F)) as u8
        bytes[2] = (0x80 | (code & 0x3F)) as u8
        (3, bytes)
    } else {
        bytes[0] = (0xF0 | (code >> 18)) as u8
        bytes[1] = (0x80 | ((code >> 12) & 0x3F)) as u8
        bytes[2] = (0x80 | ((code >> 6) & 0x3F)) as u8
        bytes[3] = (0x80 | (code & 0x3F)) as u8
        (4, bytes)
    }
}

fn char_from_utf8(bytes: &[u8]) -> Option<(char, usize)> {
    if bytes.len() == 0 {
        return None
    }
    let b0 = bytes[0]
    if b0 < 0x80 {
        Some((b0 as char, 1))
    } else if b0 < 0xC0 {
        None
    } else if b0 < 0xE0 {
        if bytes.len() < 2 { return None }
        let code = ((b0 as u32 & 0x1F) << 6) | (bytes[1] as u32 & 0x3F)
        char_from_code_point(code).map(|c| (c, 2))
    } else if b0 < 0xF0 {
        if bytes.len() < 3 { return None }
        let code = ((b0 as u32 & 0x0F) << 12) | ((bytes[1] as u32 & 0x3F) << 6) | (bytes[2] as u32 & 0x3F)
        char_from_code_point(code).map(|c| (c, 3))
    } else if b0 < 0xF8 {
        if bytes.len() < 4 { return None }
        let code = ((b0 as u32 & 0x07) << 18) | ((bytes[1] as u32 & 0x3F) << 12) | ((bytes[2] as u32 & 0x3F) << 6) | (bytes[3] as u32 & 0x3F)
        char_from_code_point(code).map(|c| (c, 4))
    } else {
        None
    }
}

enum GeneralCategory {
    UppercaseLetter,
    LowercaseLetter,
    TitlecaseLetter,
    ModifierLetter,
    OtherLetter,
    NonspacingMark,
    SpacingMark,
    EnclosingMark,
    DecimalNumber,
    LetterNumber,
    OtherNumber,
    ConnectorPunctuation,
    DashPunctuation,
    OpenPunctuation,
    ClosePunctuation,
    InitialPunctuation,
    FinalPunctuation,
    OtherPunctuation,
    MathSymbol,
    CurrencySymbol,
    ModifierSymbol,
    OtherSymbol,
    SpaceSeparator,
    LineSeparator,
    ParagraphSeparator,
    Control,
    Format,
    Surrogate,
    PrivateUse,
    Unassigned,
}

fn char_general_category(c: char) -> GeneralCategory {
    let code = c as u32
    if code < 0x20 || (code >= 0x7F && code <= 0x9F) {
        return GeneralCategory::Control
    }
    if (code >= 0x30 && code <= 0x39) || (code >= 0xFF10 && code <= 0xFF19) {
        return GeneralCategory::DecimalNumber
    }
    if char_is_uppercase(c) { return GeneralCategory::UppercaseLetter }
    if char_is_lowercase(c) { return GeneralCategory::LowercaseLetter }
    if char_is_alphabetic(c) { return GeneralCategory::OtherLetter }
    if code == 0x20 || code == 0xA0 || code == 0x3000 {
        return GeneralCategory::SpaceSeparator
    }
    GeneralCategory::OtherSymbol
}
