//! stdlib/text/unicode.sio - Unicode Character Properties
//!
//! Provides Unicode character classification and properties.

// ============================================================================
// Character Classification
// ============================================================================

// Check if a character is alphabetic (Unicode Letter category).
pub fn char_is_alphabetic(c: char) -> bool {
    let code = c as u32

    // Basic Latin letters
    if (code >= 0x41 && code <= 0x5A) ||  // A-Z
       (code >= 0x61 && code <= 0x7A) {   // a-z
        return true
    }

    // Latin-1 Supplement letters
    if (code >= 0xC0 && code <= 0xD6) ||
       (code >= 0xD8 && code <= 0xF6) ||
       (code >= 0xF8 && code <= 0xFF) {
        return true
    }

    // Greek and Coptic
    if code >= 0x370 && code <= 0x3FF {
        return true
    }

    // Cyrillic
    if code >= 0x400 && code <= 0x4FF {
        return true
    }

    // Hebrew
    if code >= 0x5D0 && code <= 0x5EA {
        return true
    }

    // Arabic
    if code >= 0x621 && code <= 0x64A {
        return true
    }

    // CJK (simplified range check)
    if code >= 0x4E00 && code <= 0x9FFF {
        return true
    }

    // Hiragana
    if code >= 0x3040 && code <= 0x309F {
        return true
    }

    // Katakana
    if code >= 0x30A0 && code <= 0x30FF {
        return true
    }

    false
}

// Check if a character is numeric (Unicode Number category).
pub fn char_is_numeric(c: char) -> bool {
    let code = c as u32

    // ASCII digits
    if code >= 0x30 && code <= 0x39 {
        return true
    }

    // Fullwidth digits
    if code >= 0xFF10 && code <= 0xFF19 {
        return true
    }

    // Arabic-Indic digits
    if code >= 0x660 && code <= 0x669 {
        return true
    }

    // Extended Arabic-Indic digits
    if code >= 0x6F0 && code <= 0x6F9 {
        return true
    }

    false
}

// Check if a character is alphanumeric.
pub fn char_is_alphanumeric(c: char) -> bool {
    char_is_alphabetic(c) || char_is_numeric(c)
}

// Check if a character is whitespace.
pub fn char_is_whitespace(c: char) -> bool {
    let code = c as u32

    // Common whitespace characters
    code == 0x20 ||   // Space
    code == 0x09 ||   // Tab
    code == 0x0A ||   // Line Feed
    code == 0x0B ||   // Vertical Tab
    code == 0x0C ||   // Form Feed
    code == 0x0D ||   // Carriage Return
    code == 0xA0 ||   // No-Break Space
    code == 0x1680 || // Ogham Space Mark
    (code >= 0x2000 && code <= 0x200A) ||  // Various spaces
    code == 0x2028 || // Line Separator
    code == 0x2029 || // Paragraph Separator
    code == 0x202F || // Narrow No-Break Space
    code == 0x205F || // Medium Mathematical Space
    code == 0x3000    // Ideographic Space
}

// Check if a character is a control character.
pub fn char_is_control(c: char) -> bool {
    let code = c as u32
    code < 0x20 || (code >= 0x7F && code <= 0x9F)
}

// Check if a character is a punctuation character.
pub fn char_is_punctuation(c: char) -> bool {
    let code = c as u32

    // ASCII punctuation
    (code >= 0x21 && code <= 0x2F) ||
    (code >= 0x3A && code <= 0x40) ||
    (code >= 0x5B && code <= 0x60) ||
    (code >= 0x7B && code <= 0x7E) ||
    // General Punctuation
    (code >= 0x2000 && code <= 0x206F) ||
    // CJK punctuation
    (code >= 0x3000 && code <= 0x303F)
}

// Check if a character is a symbol.
pub fn char_is_symbol(c: char) -> bool {
    let code = c as u32

    // Currency symbols
    (code >= 0x24 && code <= 0x24) ||
    (code >= 0xA2 && code <= 0xA5) ||
    (code >= 0x20A0 && code <= 0x20CF) ||
    // Mathematical operators
    (code >= 0x2200 && code <= 0x22FF) ||
    // Miscellaneous symbols
    (code >= 0x2600 && code <= 0x26FF) ||
    // Dingbats
    (code >= 0x2700 && code <= 0x27BF) ||
    // Emoji
    (code >= 0x1F300 && code <= 0x1F9FF)
}

// Check if a character is uppercase.
pub fn char_is_uppercase(c: char) -> bool {
    let code = c as u32

    // ASCII uppercase
    if code >= 0x41 && code <= 0x5A {
        return true
    }

    // Latin-1 uppercase
    if (code >= 0xC0 && code <= 0xD6) ||
       (code >= 0xD8 && code <= 0xDE) {
        return true
    }

    // Greek uppercase
    if code >= 0x391 && code <= 0x3A9 {
        return true
    }

    // Cyrillic uppercase
    if code >= 0x410 && code <= 0x42F {
        return true
    }

    false
}

// Check if a character is lowercase.
pub fn char_is_lowercase(c: char) -> bool {
    let code = c as u32

    // ASCII lowercase
    if code >= 0x61 && code <= 0x7A {
        return true
    }

    // Latin-1 lowercase
    if (code >= 0xDF && code <= 0xF6) ||
       (code >= 0xF8 && code <= 0xFF) {
        return true
    }

    // Greek lowercase
    if code >= 0x3B1 && code <= 0x3C9 {
        return true
    }

    // Cyrillic lowercase
    if code >= 0x430 && code <= 0x44F {
        return true
    }

    false
}

// Check if a character is ASCII.
pub fn char_is_ascii(c: char) -> bool {
    (c as u32) < 128
}

// Check if a character is an ASCII digit.
pub fn char_is_ascii_digit(c: char) -> bool {
    c >= '0' && c <= '9'
}

// Check if a character is an ASCII hex digit.
pub fn char_is_ascii_hexdigit(c: char) -> bool {
    (c >= '0' && c <= '9') ||
    (c >= 'a' && c <= 'f') ||
    (c >= 'A' && c <= 'F')
}

// Check if a character is an ASCII alphabetic character.
pub fn char_is_ascii_alphabetic(c: char) -> bool {
    (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z')
}

// Check if a character is printable (non-control).
pub fn char_is_printable(c: char) -> bool {
    !char_is_control(c) && c != '\x7F'
}

// ============================================================================
// Unicode Code Point Operations
// ============================================================================

// Get the Unicode code point of a character.
pub fn char_code_point(c: char) -> u32 {
    c as u32
}

// Create a character from a Unicode code point.
pub fn char_from_code_point(code: u32) -> Option<char> {
    if code <= 0x10FFFF && !(code >= 0xD800 && code <= 0xDFFF) {
        Some(code as char)
    } else {
        None
    }
}

// Check if a code point is a valid Unicode scalar value.
pub fn is_valid_code_point(code: u32) -> bool {
    code <= 0x10FFFF && !(code >= 0xD800 && code <= 0xDFFF)
}

// ============================================================================
// UTF-8 Operations
// ============================================================================

// Get the number of UTF-8 bytes needed for a character.
pub fn char_utf8_len(c: char) -> usize {
    let code = c as u32
    if code < 0x80 {
        1
    } else if code < 0x800 {
        2
    } else if code < 0x10000 {
        3
    } else {
        4
    }
}

// Encode a character as UTF-8 bytes.
pub fn char_to_utf8(c: char) -> (usize, [u8; 4]) {
    let code = c as u32
    var bytes = [0u8; 4]

    if code < 0x80 {
        bytes[0] = code as u8
        (1, bytes)
    } else if code < 0x800 {
        bytes[0] = (0xC0 | (code >> 6)) as u8
        bytes[1] = (0x80 | (code & 0x3F)) as u8
        (2, bytes)
    } else if code < 0x10000 {
        bytes[0] = (0xE0 | (code >> 12)) as u8
        bytes[1] = (0x80 | ((code >> 6) & 0x3F)) as u8
        bytes[2] = (0x80 | (code & 0x3F)) as u8
        (3, bytes)
    } else {
        bytes[0] = (0xF0 | (code >> 18)) as u8
        bytes[1] = (0x80 | ((code >> 12) & 0x3F)) as u8
        bytes[2] = (0x80 | ((code >> 6) & 0x3F)) as u8
        bytes[3] = (0x80 | (code & 0x3F)) as u8
        (4, bytes)
    }
}

// Decode a character from UTF-8 bytes.
// Returns the character and number of bytes consumed.
pub fn char_from_utf8(bytes: &[u8]) -> Option<(char, usize)> {
    if bytes.len() == 0 {
        return None
    }

    let b0 = bytes[0]

    if b0 < 0x80 {
        // Single byte (ASCII)
        Some((b0 as char, 1))
    } else if b0 < 0xC0 {
        // Invalid start byte
        None
    } else if b0 < 0xE0 {
        // Two bytes
        if bytes.len() < 2 {
            return None
        }
        let code = ((b0 as u32 & 0x1F) << 6) |
                   (bytes[1] as u32 & 0x3F)
        char_from_code_point(code).map(|c| (c, 2))
    } else if b0 < 0xF0 {
        // Three bytes
        if bytes.len() < 3 {
            return None
        }
        let code = ((b0 as u32 & 0x0F) << 12) |
                   ((bytes[1] as u32 & 0x3F) << 6) |
                   (bytes[2] as u32 & 0x3F)
        char_from_code_point(code).map(|c| (c, 3))
    } else if b0 < 0xF8 {
        // Four bytes
        if bytes.len() < 4 {
            return None
        }
        let code = ((b0 as u32 & 0x07) << 18) |
                   ((bytes[1] as u32 & 0x3F) << 12) |
                   ((bytes[2] as u32 & 0x3F) << 6) |
                   (bytes[3] as u32 & 0x3F)
        char_from_code_point(code).map(|c| (c, 4))
    } else {
        None
    }
}

// Count the number of Unicode characters in a string.
pub fn string_char_count(s: &str) -> usize {
    var count = 0
    for _ in s.chars() {
        count = count + 1
    }
    count
}

// ============================================================================
// Unicode Categories
// ============================================================================

// Unicode General Category
pub enum GeneralCategory {
    // Letters
    UppercaseLetter,     // Lu
    LowercaseLetter,     // Ll
    TitlecaseLetter,     // Lt
    ModifierLetter,      // Lm
    OtherLetter,         // Lo

    // Marks
    NonspacingMark,      // Mn
    SpacingMark,         // Mc
    EnclosingMark,       // Me

    // Numbers
    DecimalNumber,       // Nd
    LetterNumber,        // Nl
    OtherNumber,         // No

    // Punctuation
    ConnectorPunctuation, // Pc
    DashPunctuation,      // Pd
    OpenPunctuation,      // Ps
    ClosePunctuation,     // Pe
    InitialPunctuation,   // Pi
    FinalPunctuation,     // Pf
    OtherPunctuation,     // Po

    // Symbols
    MathSymbol,          // Sm
    CurrencySymbol,      // Sc
    ModifierSymbol,      // Sk
    OtherSymbol,         // So

    // Separators
    SpaceSeparator,      // Zs
    LineSeparator,       // Zl
    ParagraphSeparator,  // Zp

    // Other
    Control,             // Cc
    Format,              // Cf
    Surrogate,           // Cs
    PrivateUse,          // Co
    Unassigned,          // Cn
}

// Get the general category of a character.
// Note: This is a simplified implementation covering common cases.
pub fn char_general_category(c: char) -> GeneralCategory {
    let code = c as u32

    // Control characters
    if code < 0x20 || (code >= 0x7F && code <= 0x9F) {
        return GeneralCategory::Control
    }

    // Digits
    if (code >= 0x30 && code <= 0x39) ||
       (code >= 0xFF10 && code <= 0xFF19) {
        return GeneralCategory::DecimalNumber
    }

    // Uppercase letters
    if char_is_uppercase(c) {
        return GeneralCategory::UppercaseLetter
    }

    // Lowercase letters
    if char_is_lowercase(c) {
        return GeneralCategory::LowercaseLetter
    }

    // Other letters (CJK, etc.)
    if char_is_alphabetic(c) {
        return GeneralCategory::OtherLetter
    }

    // Space
    if code == 0x20 || code == 0xA0 || code == 0x3000 {
        return GeneralCategory::SpaceSeparator
    }

    // Default
    GeneralCategory::OtherSymbol
}
