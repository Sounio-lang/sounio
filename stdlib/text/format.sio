// stdlib/text/format.sio — numeric-to-string conversion
//
// Functions:
//   format_int(n: i64)   -> string   (decimal, handles negatives)
//   format_f64(x: f64)   -> string   (decimal, 4 fractional digits)
//   i64_to_str(n: i64)   -> string   (alias for format_int)
//   f64_to_str(x: f64)   -> string   (alias for format_f64)
//
// Implementation uses str_concat + str_slice; no [i8;N] buffer needed.
// The [i8;N] element-size fix activates in the Gen22+ native build;
// this implementation works in both the JIT and native codegen.

// ============================================================
// format_int — i64 → decimal string
// ============================================================

fn format_int(n: i64) -> string with Mut, Panic, Div {
    if n == 0 { return "0" }
    var neg = n < 0
    var m: i64 = n
    if neg { m = 0 - n }
    var result = ""
    while m > 0 {
        let d = m % 10
        result = str_concat(str_slice("0123456789", d, d + 1), result)
        m = m / 10
    }
    if neg { result = str_concat("-", result) }
    result
}

// ============================================================
// format_f64 — f64 → decimal string (4 fractional digits)
// ============================================================
//
// Output format: ["-"]<int_part>"."<4-digit-frac>
// Example: 3.14 → "3.1400",  -0.5 → "-0.5000"

fn format_f64(x: f64) -> string with Mut, Panic, Div {
    var neg = x < 0.0
    var ax: f64 = x
    if neg { ax = 0.0 - x }

    let int_part = ax as i64
    let frac_raw = ((ax - int_part as f64) * 10000.0) as i64
    var frac_i: i64 = frac_raw
    if frac_i < 0 { frac_i = 0 }
    if frac_i > 9999 { frac_i = 9999 }

    // Build 4-digit fractional string with leading zeros
    var frac_str = ""
    var f = frac_i
    var fi: i64 = 0
    while fi < 4 {
        let d = f % 10
        frac_str = str_concat(str_slice("0123456789", d, d + 1), frac_str)
        f = f / 10
        fi = fi + 1
    }

    var result = str_concat(format_int(int_part), ".")
    result = str_concat(result, frac_str)
    if neg { result = str_concat("-", result) }
    result
}

// ============================================================
// Aliases (backward-compatible names)
// ============================================================

fn i64_to_str(n: i64) -> string with Mut, Panic, Div {
    format_int(n)
}

fn f64_to_str(x: f64) -> string with Mut, Panic, Div {
    format_f64(x)
}
