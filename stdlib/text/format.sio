// stdlib/text/format.sio — numeric-to-string conversion and format strings
//
// Functions:
//   pub i64_to_str(n)       -> string   (decimal, handles negatives)
//   pub f64_to_str(x)       -> string   (decimal, 4 fractional digits)
//   pub format1(t, a)       -> string   (replace first {} with string arg)
//   pub format2(t, a, b)    -> string   (replace first two {} with args)
//   pub format3(t, a, b, c) -> string   (replace first three {} with args)
//   pub format4(t, a, b, c, d) -> string
//
// Uses native string concatenation (++) and str_slice — no str_from_bytes.

// ============================================================
// Helpers (must precede callers)
// ============================================================

fn digit_char(d: i64) -> string with Panic {
    let chars = "0123456789"
    str_slice(chars, d, d + 1)
}

fn abs_i64(n: i64) -> i64 {
    if n < 0 { 0 - n } else { n }
}

fn u64_to_str(n: i64) -> string with Mut, Div, Panic {
    if n == 0 { return "0" }
    var m = n
    var result = ""
    while m > 0 {
        let d = m % 10
        result = digit_char(d) ++ result
        m = m / 10
    }
    result
}

// ============================================================
// i64 -> decimal string
// ============================================================

pub fn i64_to_str(n: i64) -> string with Mut, Div, Panic {
    if n == 0 { return "0" }
    if n < 0 {
        return "-" ++ u64_to_str(0 - n)
    }
    u64_to_str(n)
}

// ============================================================
// f64 -> decimal string (4 fractional digits)
// ============================================================

pub fn f64_to_str(x: f64) -> string with Mut, Div, Panic {
    var neg = x < 0.0
    var ax: f64 = x
    if neg { ax = 0.0 - x }

    let int_part = ax as i64

    // Fractional part — 4 digits, zero-padded
    var frac_i: i64 = ((ax - int_part as f64) * 10000.0) as i64
    if frac_i < 0 { frac_i = 0 }
    if frac_i > 9999 { frac_i = 9999 }

    var frac_str = ""
    var f = frac_i
    var digits: [string; 4] = ["", "", "", ""]
    var i: i64 = 3
    while i >= 0 {
        digits[i] = digit_char(f % 10)
        f = f / 10
        i = i - 1
    }
    frac_str = digits[0] ++ digits[1] ++ digits[2] ++ digits[3]

    let int_str = i64_to_str(int_part)
    var result = int_str ++ "." ++ frac_str
    if neg { result = "-" ++ result }
    result
}

// ============================================================
// format() — {} placeholder substitution
// ============================================================

// Find the position of "{}" in a string, return -1 if not found.
fn find_placeholder(s: string) -> i64 with Panic {
    let n = str_len(s)
    var i: i64 = 0
    while i < n - 1 {
        let c = str_char_at(s, i)
        let c2 = str_char_at(s, i + 1)
        if c == 123 && c2 == 125 {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

// Replace the first "{}" in template with value.
fn replace_one(template: string, value: string) -> string with Mut, Panic {
    let pos = find_placeholder(template)
    if pos < 0 { return template }
    let before = str_slice(template, 0, pos)
    let after_start = pos + 2
    let after = str_slice(template, after_start, str_len(template))
    before ++ value ++ after
}

pub fn format1(template: string, a: string) -> string with Mut, Panic {
    replace_one(template, a)
}

pub fn format2(template: string, a: string, b: string) -> string with Mut, Panic {
    let s = replace_one(template, a)
    replace_one(s, b)
}

pub fn format3(template: string, a: string, b: string, c: string) -> string with Mut, Panic {
    let s = replace_one(template, a)
    let s2 = replace_one(s, b)
    replace_one(s2, c)
}

pub fn format4(template: string, a: string, b: string, c: string, d: string) -> string with Mut, Panic {
    let s = replace_one(template, a)
    let s2 = replace_one(s, b)
    let s3 = replace_one(s2, c)
    replace_one(s3, d)
}
