//! stdlib/text - Text Processing Utilities
//!
//! This module provides text and Unicode utilities:
//! - `unicode` - Unicode character properties and classification
//! - `case` - Case conversion (upper, lower, title)
//! - `normalize` - Unicode normalization (NFC, NFD)
//! - `wrap` - Text wrapping and formatting
//!
//! # Examples
//!
//! ```sio
//! // Case conversion
//! let upper = to_uppercase("hello")     // "HELLO"
//! let lower = to_lowercase("WORLD")     // "world"
//! let title = to_titlecase("hello")     // "Hello"
//!
//! // Unicode properties
//! let is_letter = char_is_alphabetic('α')  // true
//! let is_digit = char_is_numeric('5')      // true
//!
//! // Text wrapping
//! let wrapped = text_wrap("Long text...", 80)
//! ```


// Submodules are resolved by path (`use text::<name>`);
// Sounio has no `mod` item, so the declarations that stood here were
// inert Rust syntax that also stopped this file parsing. Covered:
//   unicode, case, wrap, interpolate

pub use unicode::*;
pub use case::*;
pub use wrap::*;
pub use interpolate::*;
