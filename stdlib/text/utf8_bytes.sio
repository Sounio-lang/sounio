// A byte-oriented span tied directly to the original Utf8Text owner.
// All payload bytes, including NUL, remain borrowed. Slice offsets are bytes;
// unlike Utf8View, a slice may begin or end inside a multibyte scalar.
use core::result::{Result}
use collections::byte_buffer::{ByteValue}
use text::utf8::{Utf8Text,utf8_text_status,utf8_text_byte_len,utf8_text_byte_at}
pub struct Utf8Bytes {owner:&Utf8Text,start:i64,size:i64}
pub fn utf8_text_as_bytes(owner:&Utf8Text)->Result<Utf8Bytes,i64> {
 let status=utf8_text_status(owner)
 if status!=0 {return Result::Err(status)}
 Result::Ok(Utf8Bytes {owner:owner,start:0,size:utf8_text_byte_len(owner)})
}
pub fn utf8_bytes_len(view:&Utf8Bytes)->i64 {view.size}
pub fn utf8_bytes_get(view:&Utf8Bytes,index:i64)->ByteValue {
 if index<0 || index>=view.size {return ByteValue {value:0,status:4}}
 utf8_text_byte_at(view.owner,view.start+index)
}
pub fn utf8_bytes_slice(view:&Utf8Bytes,start:i64,end:i64)->Result<Utf8Bytes,i64> {
 if start<0 || end<start || end>view.size {return Result::Err(4)}
 Result::Ok(Utf8Bytes {owner:view.owner,start:view.start+start,size:end-start})
}
