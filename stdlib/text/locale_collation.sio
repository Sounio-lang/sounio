// Keys own their opaque encoding1 i64 cells. max_key_bytes charges requested
// IntegerBuffer payload capacity. max_work_bytes bounds all simultaneous scratch
// payload capacities; caller-owned input and returned key have separate budgets.
pub fn unicode_locale_collation_key(c:&UnicodeLocaleCollator,input:&Utf8Text,max_key_bytes:i64,max_work_bytes:i64)->LocaleCollationKey with Alloc,Mut,Div,Panic {
 var key=LocaleCollationKey {weights:integer_buffer_new(0,max_key_bytes),entry:c.entry,strength:c.strength,alternate:c.alternate,backwards:c.backwards,case_level:c.case_level,case_first:c.case_first,max_variable:c.max_variable,status:c.status}
 loc_build_key(&!key,c,input,max_work_bytes)
