}
fn loc_same_entry(d:&LocaleData,a:i64,b:i64)->bool {
 let n=loc_field(d,4,a,1)
 let pn=loc_field(d,4,a,3)
 if n!=loc_field(d,4,b,1) || pn!=loc_field(d,4,b,3) || n<1 || pn<0 {return false}
 var i:i64=0
 while i<n {if loc_field(d,2,loc_field(d,4,a,0)+i,0)!=loc_field(d,2,loc_field(d,4,b,0)+i,0) {return false} i=i+1}
 i=0
 while i<pn {if loc_field(d,2,loc_field(d,4,a,2)+i,0)!=loc_field(d,2,loc_field(d,4,b,2)+i,0) {return false} i=i+1}
