// 1 matched,0 not matched,-6 invalid internal data. The successful candidate is
// repeated with mark=true, avoiding an extra positions allocation in scratch.
fn loc_contract(d:&LocaleData,u:&UnicodeData,property:i64,row:i64,s:&!IntegerBuffer,at:i64,mark:bool)->i64 with Mut,Div {
 let first=loc_field(d,4,row,0)
 let n=loc_field(d,4,row,1)
 let prefix=loc_field(d,4,row,2)
 let pn=loc_field(d,4,row,3)
 if first<0 || n<1 || prefix<0 || pn<0 {return 0-6}
 if first>loc_count(d,2) || prefix>loc_count(d,2) {return 0-6}
 if n>loc_count(d,2)-first || pn>loc_count(d,2)-prefix {return 0-6}
 if at<0 || at>=integer_buffer_len(s) {return 0-6}
 if pn>at {return 0}
 var i:i64=0
 while i<pn {if loc_scalar(s,at-pn+i)!=loc_field(d,2,prefix+i,0) {return 0} i=i+1}
 if loc_scalar(s,at)!=loc_field(d,2,first,0) {return 0}
 if mark {let marked=loc_scalar(s,at)|2097152;if integer_buffer_set(s,at,marked)!=0 {return 0-6}}
 i=1
 var scan=at+1
 while i<n {
  let target=loc_field(d,2,first+i,0)
  let cls=loc_ccc(u,property,target)
  if target<0 || cls<0 {return 0-6}
  var found=false
  while scan<integer_buffer_len(s) {
   let value=integer_buffer_get(s,scan)
   if value.status!=0 {return 0-6}
   if value.value>=2097152 {scan=scan+1;continue}
   let other=value.value & 2097151
   if other==target {
    if mark {if integer_buffer_set(s,scan,other|2097152)!=0 {return 0-6}}
    scan=scan+1;found=true;break
   }
   let other_class=loc_ccc(u,property,other)
   if other_class<0 {return 0-6}
   if cls==0 || other_class==0 || other_class>=cls {break}
   scan=scan+1
  }
  if !found {return 0}
  i=i+1
 }
 1
}
fn loc_push_ce(out:&!IntegerBuffer,p:i64,s:i64,t:i64,q:i64,casing:i64,separator:i64)->i64 with Alloc,Mut,Div {
 var status=integer_buffer_push(out,p)
 if status==0 {status=integer_buffer_push(out,s)}
 if status==0 {status=integer_buffer_push(out,t)}
 if status==0 {status=integer_buffer_push(out,q)}
 if status==0 {status=integer_buffer_push(out,casing)}
 if status==0 {status=integer_buffer_push(out,separator)}
