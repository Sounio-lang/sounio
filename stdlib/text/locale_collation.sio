  let status=integer_buffer_push(text,cp)
  if status!=0 {return LocName {first:status,n:0-1,is_blob:false}}
  i=i+1
 }
 LocName {first:first,n:name.n,is_blob:false}
}
fn loc_append_component(d:&LocaleData,text:&!IntegerBuffer,name:&LocName)->i64 with Alloc,Mut,Div {
 if name.n==0 {return 0}
 let status=integer_buffer_push(text,95)
 if status!=0 {return status}
 let out=loc_append_name(d,text,name)
 if out.n<0 {return loc_name_failure(&out)}
 0
}
fn loc_join_parts(d:&LocaleData,text:&!IntegerBuffer,p:&LocParts)->LocName with Alloc,Mut,Div {
 let first=integer_buffer_len(text)
 let language=loc_append_name(d,text,&p.language)
 if language.n<0 {return language}
 let script_status=loc_append_component(d,text,&p.script)
 if script_status!=0 {return LocName {first:script_status,n:0-1,is_blob:false}}
 let region_status=loc_append_component(d,text,&p.region)
 if region_status!=0 {return LocName {first:region_status,n:0-1,is_blob:false}}
 let variants_status=loc_append_component(d,text,&p.variants)
 if variants_status!=0 {return LocName {first:variants_status,n:0-1,is_blob:false}}
 LocName {first:first,n:integer_buffer_len(text)-first,is_blob:false}
}
fn loc_part_pattern(d:&LocaleData,text:&IntegerBuffer,p:&LocParts,alias:&LocParts)->bool {
 if !loc_names_equal(d,text,&p.language,&alias.language) {return false}
 if alias.script.n>0 {if !loc_names_equal(d,text,&p.script,&alias.script) {return false}}
 if alias.region.n>0 {if !loc_names_equal(d,text,&p.region,&alias.region) {return false}}
 var at:i64=0
 while at<alias.variants.n {let end=loc_token_end(d,text,&alias.variants,at);let v=loc_sub(&alias.variants,at,end-at);if !loc_contains_variant(d,text,&p.variants,&v) {return false} at=end+1}
 true
}
// Section11 is generated in (kind, lowercase-key) order.
fn loc_alias_kind_lower(d:&LocaleData,kind:i64)->i64 {
 var lo:i64=0
 var hi=loc_count(d,11)
 while lo<hi {let mid=lo+((hi-lo)>>1);if loc_field(d,11,mid,0)<kind {lo=mid+1} else {hi=mid}}
 lo
}
fn loc_alias_row(d:&LocaleData,text:&IntegerBuffer,kind:i64,name:&LocName)->i64 {
 if name.n==0 {return 0-1}
 var lo=loc_alias_kind_lower(d,kind)
 let end=loc_alias_kind_lower(d,kind+1)
 var hi=end
 while lo<hi {let mid=lo+((hi-lo)>>1);let own=loc_record_name(d,11,mid,1);if loc_lex(d,text,&own,name)<0 {lo=mid+1} else {hi=mid}}
 if lo<end {let own=loc_record_name(d,11,lo,1);if loc_names_equal(d,text,&own,name) {return lo}}
 0-1
}
fn loc_alias_language_lower(d:&LocaleData,text:&IntegerBuffer,language:&LocName)->i64 {
 var lo=loc_alias_kind_lower(d,1)
 var hi=loc_alias_kind_lower(d,2)
 while lo<hi {
  let mid=lo+((hi-lo)>>1)
  let name=loc_record_name(d,11,mid,1)
  let end=loc_token_end(d,text,&name,0)
  let own=loc_sub(&name,0,end)
  if loc_lex(d,text,&own,language)<0 {lo=mid+1} else {hi=mid}
 }
 lo
}
fn loc_lex(d:&LocaleData,text:&IntegerBuffer,a:&LocName,b:&LocName)->i64 {
 var at:i64=0
 while at<a.n && at<b.n {let x=loc_name_byte(d,text,a,at);let y=loc_name_byte(d,text,b,at);if x<y {return 0-1} if x>y {return 1} at=at+1}
 if a.n<b.n {return 0-1}
 if a.n>b.n {return 1}
 0
}
fn loc_likely(d:&LocaleData,text:&IntegerBuffer,name:&LocName)->LocName {
 var lo:i64=0
 var hi=loc_count(d,12)
 while lo<hi {let mid=lo+((hi-lo)>>1);let key=loc_record_name(d,12,mid,0);if loc_lex(d,text,&key,name)<0 {lo=mid+1} else {hi=mid}}
 if lo<loc_count(d,12) {let key=loc_record_name(d,12,lo,0);if loc_names_equal(d,text,&key,name) {return loc_record_name(d,12,lo,2)}}
 loc_empty()
}
fn loc_language_is(d:&LocaleData,text:&IntegerBuffer,name:&LocName,a:i64,b:i64,c:i64)->bool {
 if name.n!=3 {return false}
 loc_name_byte(d,text,name,0)==a && loc_name_byte(d,text,name,1)==b && loc_name_byte(d,text,name,2)==c
}
fn loc_maximize(d:&LocaleData,text:&!IntegerBuffer,p:&LocParts)->LocParts with Alloc,Mut,Div {
 var result=LocParts {language:p.language,script:p.script,region:p.region,variants:p.variants,status:p.status}
 let root=loc_root_name(d)
 if loc_names_equal(d,text,&p.language,&root) || loc_language_is(d,text,&p.language,117,110,100) {return result}
 var mode:i64=0
 var found=loc_empty()
 while mode<4 {
  var key=LocParts {language:p.language,script:loc_empty(),region:loc_empty(),variants:loc_empty(),status:0}
  if mode==0 {key.script=p.script;key.region=p.region}
  if mode==1 {key.script=p.script}
  if mode==2 {key.region=p.region}
  let id=loc_join_parts(d,text,&key)
  if id.n<0 {result.status=loc_name_failure(&id);return result}
  found=loc_likely(d,text,&id)
  if found.n>0 {break}
  mode=mode+1
 }

 if found.n==0 {
  var mode:i64=0
  while mode<3 {
   var row:i64=0
   while row<loc_count(d,12) {
    let name=loc_record_name(d,12,row,0)
    let candidate=loc_parse_parts(d,text,&name)
    if loc_language_is(d,text,&candidate.language,117,110,100) {
     var matches=false
     if mode==0 {matches=p.script.n>0 && loc_names_equal(d,text,&p.script,&candidate.script) && candidate.region.n==0}
     if mode==1 {matches=p.region.n>0 && loc_names_equal(d,text,&p.region,&candidate.region) && candidate.script.n==0}
     if mode==2 {matches=candidate.script.n==0 && candidate.region.n==0}
     if matches {found=loc_record_name(d,12,row,2);break}
    }
    row=row+1
   }
   if found.n>0 {break}
   mode=mode+1
  }
 }
 if found.n>0 {let value=loc_parse_parts(d,text,&found);if result.script.n==0 {result.script=value.script} if result.region.n==0 {result.region=value.region}}
 result
}

fn loc_merge_alias_variants(d:&LocaleData,text:&!IntegerBuffer,original:&LocName,removed:&LocName,added:&LocName)->LocName with Alloc,Mut,Div {
 let first=integer_buffer_len(text)
 var count:i64=0
 var pass:i64=0
 while pass<2 {
  let list=if pass==0 {LocName {first:original.first,n:original.n,is_blob:original.is_blob}} else {LocName {first:added.first,n:added.n,is_blob:added.is_blob}}
  var at:i64=0
  while at<list.n {
   let end=loc_token_end(d,text,&list,at)
   let v=loc_sub(&list,at,end-at)
   var keep=true
   if pass==0 {if loc_contains_variant(d,text,removed,&v) {keep=false}}
   else {let current=LocName {first:first,n:integer_buffer_len(text)-first,is_blob:false};if loc_contains_variant(d,text,&current,&v) {keep=false}}
   if keep {
    if count>0 {let status=integer_buffer_push(text,95);if status!=0 {return LocName {first:status,n:0-1,is_blob:false}}}
    let copied=loc_append_name(d,text,&v)
    if copied.n<0 {return copied}
    count=count+1
   }
   at=end+1
  }
  pass=pass+1
 }
 LocName {first:first,n:integer_buffer_len(text)-first,is_blob:false}
}
fn loc_canonical_parts(d:&LocaleData,text:&!IntegerBuffer,name:&LocName)->LocParts with Alloc,Mut,Div {
 var p=loc_parse_parts(d,text,name)
 var original=LocName {first:name.first,n:name.n,is_blob:name.is_blob}
 var depth:i64=0
 while p.status!=0 && depth<16 {
  var best:i64=0-1
  var best_len:i64=0
  var row:i64=0
  while row<loc_count(d,11) {
   if loc_field(d,11,row,0)==1 {
    let key=loc_record_name(d,11,row,1)
    if key.n<=original.n && key.n>best_len {
     let prefix=loc_sub(&original,0,key.n)
     var boundary=key.n==original.n
     if key.n<original.n {boundary=loc_name_byte(d,text,&original,key.n)==95}
     if boundary {if loc_names_equal(d,text,&key,&prefix) {best=row;best_len=key.n}}
    }
   }
   row=row+1
  }
  if best<0 {return p}
  let target=loc_record_name(d,11,best,3)
  let first=integer_buffer_len(text)
  let copy=loc_append_name(d,text,&target)
  if copy.n<0 {p.status=loc_name_failure(&copy);return p}
  let rest=loc_sub(&original,best_len,original.n-best_len)
  let copy_rest=loc_append_name(d,text,&rest)
  if copy_rest.n<0 {p.status=loc_name_failure(&copy_rest);return p}
  original=LocName {first:first,n:integer_buffer_len(text)-first,is_blob:false}
  p=loc_parse_parts(d,text,&original)
  depth=depth+1
 }
 if p.status!=0 {return p}
 depth=0
 while depth<16 {
  var best:i64=0-1
  var score:i64=0
  var row=loc_alias_language_lower(d,text,&p.language)
  let language_end=loc_alias_kind_lower(d,2)
  while row<language_end {
   let source=loc_record_name(d,11,row,1)
   let token_end=loc_token_end(d,text,&source,0)
   let own_language=loc_sub(&source,0,token_end)
   if !loc_names_equal(d,text,&own_language,&p.language) {break}
   if loc_field(d,11,row,0)==1 {
    let alias=loc_parse_parts(d,text,&source)
    if alias.status==0 {if loc_part_pattern(d,text,&p,&alias) {
     let weight=1+(if alias.script.n>0 {1} else {0})+(if alias.region.n>0 {1} else {0})+loc_variant_count(d,text,&alias.variants)
     if weight>score {score=weight;best=row}
    }}
   }
   row=row+1
  }
  if best<0 {break}
  let source=loc_record_name(d,11,best,1)
  let target=loc_record_name(d,11,best,3)
  let alias=loc_parse_parts(d,text,&source)
  let value=loc_parse_parts(d,text,&target)
  if value.status!=0 {p.status=6;return p}
  var next=LocParts {language:value.language,script:p.script,region:p.region,variants:p.variants,status:0}
  if alias.script.n>0 || next.script.n==0 {next.script=value.script}
  if alias.region.n>0 || next.region.n==0 {next.region=value.region}
  let variants=loc_merge_alias_variants(d,text,&p.variants,&alias.variants,&value.variants)
  if variants.n<0 {p.status=loc_name_failure(&variants);return p}
  next.variants=variants
  let same=loc_names_equal(d,text,&next.language,&p.language) && loc_names_equal(d,text,&next.script,&p.script) && loc_names_equal(d,text,&next.region,&p.region) && loc_names_equal(d,text,&next.variants,&p.variants)
  p=next
  if same {break}
  depth=depth+1
 }
 if depth>=16 {p.status=6;return p}
 let script_alias=loc_alias_row(d,text,2,&p.script)
 if script_alias>=0 {p.script=loc_record_name(d,11,script_alias,3)}
 let territory_alias=loc_alias_row(d,text,3,&p.region)
 if territory_alias>=0 {
  let targets=loc_record_name(d,11,territory_alias,3)
  var at:i64=0
  var chosen=loc_empty()
  var preference=LocParts {language:p.language,script:p.script,region:loc_empty(),variants:loc_empty(),status:0}
  preference=loc_maximize(d,text,&preference)
  if preference.status!=0 {p.status=preference.status;return p}
  while at<targets.n {
   var end=at
   while end<targets.n {if loc_name_byte(d,text,&targets,end)==32 {break} end=end+1}
   let candidate=loc_sub(&targets,at,end-at)
   if chosen.n==0 {chosen=candidate}
   if loc_names_equal(d,text,&candidate,&preference.region) {chosen=candidate;break}
   at=end+1
  }
  p.region=chosen
 }
 let first=integer_buffer_len(text)
 var variants_count:i64=0
 var at:i64=0
 while at<p.variants.n {
  let end=loc_token_end(d,text,&p.variants,at)
  let own=loc_sub(&p.variants,at,end-at)
  let row=loc_alias_row(d,text,4,&own)
  let target=if row<0 {own} else {loc_record_name(d,11,row,3)}
  let current=LocName {first:first,n:integer_buffer_len(text)-first,is_blob:false}
  if !loc_contains_variant(d,text,&current,&target) {
   if variants_count>0 {let status=integer_buffer_push(text,95);if status!=0 {p.status=status;return p}}
   let added=loc_append_name(d,text,&target)
   if added.n<0 {p.status=loc_name_failure(&added);return p}
   variants_count=variants_count+1
  }
  at=end+1
 }
 p.variants=LocName {first:first,n:integer_buffer_len(text)-first,is_blob:false}
 if p.region.n>0 {if !(p.region.n==2 && loc_all(d,text,&p.region,1)) && !(p.region.n==3 && loc_all(d,text,&p.region,2)) {p.status=1}}
 p
}
fn loc_bundle(d:&LocaleData,text:&!IntegerBuffer,parts:&LocParts)->LocName with Alloc,Mut,Div {
 var p=LocParts {language:parts.language,script:parts.script,region:parts.region,variants:parts.variants,status:parts.status}
 let root=loc_root_name(d)
 if loc_names_equal(d,text,&p.language,&root) {return root}
 if loc_language_is(d,text,&p.language,117,110,100) {if p.script.n==0 && p.region.n==0 && p.variants.n==0 {return root}}
 if p.script.n>0 {
  let reduced=LocParts {language:p.language,script:loc_empty(),region:p.region,variants:loc_empty(),status:0}
  let likely=loc_maximize(d,text,&reduced)
  if likely.status!=0 {return LocName {first:likely.status,n:0-1,is_blob:false}}
  if loc_names_equal(d,text,&likely.script,&p.script) {p.script=loc_empty()}
 }
 let expanded=loc_maximize(d,text,&p)
 if expanded.status!=0 {return LocName {first:expanded.status,n:0-1,is_blob:false}}
 var regional=LocParts {language:p.language,script:p.script,region:p.region,variants:p.variants,status:0}
 if regional.region.n==0 {regional.region=expanded.region}
 var best=loc_empty()
 var best_variants:i64=0-1
 var row:i64=0
 var high=loc_count(d,9)
 while row<high {
  let mid=row+((high-row)>>1)
  let name=loc_record_name(d,9,mid,0)
  let end=loc_token_end(d,text,&name,0)
  let language=loc_sub(&name,0,end)
  if loc_lex(d,text,&language,&p.language)<0 {row=mid+1} else {high=mid}
 }
 while row<loc_count(d,9) {
  let name=loc_record_name(d,9,row,0)
  let end=loc_token_end(d,text,&name,0)
  let language=loc_sub(&name,0,end)
  if !loc_names_equal(d,text,&language,&p.language) {break}
  let candidate=loc_parse_parts(d,text,&name)
  if candidate.status==0 {
   let same_regional=loc_names_equal(d,text,&candidate.language,&regional.language) && loc_names_equal(d,text,&candidate.script,&regional.script) && loc_names_equal(d,text,&candidate.region,&regional.region)
   let same_expanded=loc_names_equal(d,text,&candidate.language,&expanded.language) && loc_names_equal(d,text,&candidate.script,&expanded.script) && loc_names_equal(d,text,&candidate.region,&expanded.region)
   if same_regional || same_expanded {
    var subset=true
    var at:i64=0
    while at<candidate.variants.n {let end=loc_token_end(d,text,&candidate.variants,at);let v=loc_sub(&candidate.variants,at,end-at);if !loc_contains_variant(d,text,&p.variants,&v) {subset=false;break} at=end+1}
    if subset {
     let count=loc_variant_count(d,text,&candidate.variants)
     if count>best_variants {best=name;best_variants=count}
     else {if count==best_variants {if loc_lex(d,text,&name,&best)<0 {best=name}}}
    }
   }
  }
  row=row+1
 }
 if best.n>0 {return best}
 var current=loc_join_parts(d,text,&expanded)
 if current.n<0 {return current}
 var steps:i64=0
 while current.n>0 && steps<256 {
  row=0
  while row<loc_count(d,9) {let own=loc_record_name(d,9,row,0);if loc_names_equal(d,text,&current,&own) {return own} row=row+1}
  current=loc_parent(d,text,&current)
  steps=steps+1
 }
 root
}


struct LocRequest {name:LocName,kind:LocName,status:i64}
fn loc_keyword(d:&LocaleData,text:&IntegerBuffer,name:&LocName,a:i64,b:i64)->bool {
 if name.n!=2 {return false}
 loc_name_byte(d,text,name,0)==a && loc_name_byte(d,text,name,1)==b
}
fn loc_request(d:&LocaleData,text:&!IntegerBuffer,n:i64,tn:i64)->LocRequest with Alloc,Mut,Div {
 let original=LocName {first:0,n:n,is_blob:false}
 var base=LocName {first:0,n:n,is_blob:false}
 let explicit_type=LocName {first:n,n:tn,is_blob:false}
 // Every bundled public source identifier is proved canonically reachable by
 // the C++ registry gate; this path avoids repeated metadata lookup per key.
 var direct:i64=0
 while direct<loc_count(d,5) {
  let own=loc_record_name(d,5,direct,0)
  if loc_names_equal(d,text,&original,&own) {let kind=loc_type_alias(d,text,&explicit_type);return LocRequest {name:own,kind:kind,status:0}}
  direct=direct+1
 }
 var inline_type=loc_empty()
 var posix=loc_empty()
 var at:i64=0
 var token:i64=0
 while at<n {
  let end=loc_token_end(d,text,&original,at)
  let own=loc_sub(&original,at,end-at)
  if token>0 && own.n==1 {
   base=loc_sub(&original,0,at-1)
   let singleton=loc_name_byte(d,text,&own,0)
   if singleton==120 {
    if end>=n {return LocRequest {name:base,kind:explicit_type,status:1}}
    var private_at=end+1
    while private_at<n {let private_end=loc_token_end(d,text,&original,private_at);let v=loc_sub(&original,private_at,private_end-private_at);if v.n>8 || !loc_all(d,text,&v,0) {return LocRequest {name:base,kind:explicit_type,status:1}} private_at=private_end+1}
    break
   }
   if singleton!=117 || end>=n {return LocRequest {name:base,kind:explicit_type,status:1}}
   var key_at=end+1
   while key_at<n {
    let key_end=loc_token_end(d,text,&original,key_at)
    let key=loc_sub(&original,key_at,key_end-key_at)
    if key.n==1 && loc_name_byte(d,text,&key,0)==120 {
     if key_end>=n {return LocRequest {name:base,kind:explicit_type,status:1}}
     var private_at=key_end+1
     while private_at<n {let private_end=loc_token_end(d,text,&original,private_at);let v=loc_sub(&original,private_at,private_end-private_at);if v.n>8 || !loc_all(d,text,&v,0) {return LocRequest {name:base,kind:explicit_type,status:1}} private_at=private_end+1}
     key_at=n
     break
    }
    let is_co=loc_keyword(d,text,&key,99,111)
    let is_va=loc_keyword(d,text,&key,118,97)
    if !is_co && !is_va {return LocRequest {name:base,kind:explicit_type,status:1}}
    if key_end>=n {return LocRequest {name:base,kind:explicit_type,status:1}}
    var value_end=key_end+1
    var value_count:i64=0
    while value_end<n {
     let sub_end=loc_token_end(d,text,&original,value_end)
     let sub=loc_sub(&original,value_end,sub_end-value_end)
     if sub.n<=2 {break}
     if sub.n>8 || !loc_all(d,text,&sub,0) {return LocRequest {name:base,kind:explicit_type,status:1}}
     value_count=value_count+1
     value_end=sub_end
     if value_end<n {value_end=value_end+1}
    }
    var value_n=value_end-key_end-1
    if value_end<n {value_n=value_n-1}
    if value_count==0 {return LocRequest {name:base,kind:explicit_type,status:1}}
    let value=loc_sub(&original,key_end+1,value_n)
    if is_co {if inline_type.n>0 {return LocRequest {name:base,kind:explicit_type,status:1}} inline_type=value}
    else {
     if posix.n>0 || value.n!=5 {return LocRequest {name:base,kind:explicit_type,status:1}}
     if loc_name_byte(d,text,&value,0)!=112 || loc_name_byte(d,text,&value,1)!=111 || loc_name_byte(d,text,&value,2)!=115 || loc_name_byte(d,text,&value,3)!=105 || loc_name_byte(d,text,&value,4)!=120 {return LocRequest {name:base,kind:explicit_type,status:1}}
     posix=value
    }
    key_at=value_end
   }
   break
  }
  at=end+1
  token=token+1
 }
 if posix.n>0 {
  let parsed=loc_parse_parts(d,text,&base)
  if parsed.status!=0 {return LocRequest {name:base,kind:explicit_type,status:1}}
  if !loc_contains_variant(d,text,&parsed.variants,&posix) {
   let copied=loc_append_name(d,text,&base)
   if copied.n<0 {return LocRequest {name:base,kind:explicit_type,status:loc_name_failure(&copied)}}
   let status=loc_append_component(d,text,&posix)
   if status!=0 {return LocRequest {name:base,kind:explicit_type,status:status}}
   base=LocName {first:copied.first,n:integer_buffer_len(text)-copied.first,is_blob:false}
  }
 }
 var requested=loc_type_alias(d,text,&explicit_type)
 if inline_type.n>0 {
  let selected=loc_type_alias(d,text,&inline_type)
  if requested.n>0 {if !loc_names_equal(d,text,&selected,&requested) {return LocRequest {name:base,kind:requested,status:1}}}
  requested=selected
 }
 let parts=loc_canonical_parts(d,text,&base)
 if parts.status!=0 {return LocRequest {name:base,kind:requested,status:parts.status}}
 let resolved=loc_bundle(d,text,&parts)
 if resolved.n<0 {return LocRequest {name:base,kind:requested,status:loc_name_failure(&resolved)}}
 LocRequest {name:resolved,kind:requested,status:0}
}
fn loc_resolve_copied(d:&LocaleData,copied:&!IntegerBuffer,n:i64,tn:i64,options:&UnicodeLocaleOptions)->UnicodeLocaleCollator with Alloc,Mut,Div {
 let request=loc_request(d,copied,n,tn)
 if request.status!=0 {return loc_bad(request.status)}
 let name=request.name
 let input_type=request.kind
 let def=loc_default(d,copied,&name)
 let requested=if input_type.n==0 {def} else {input_type}
 if loc_prefix_private(d,copied,&requested) {return loc_bad(1)}
 var found=loc_find(d,copied,&name,&requested)
 if found<0 && loc_prefix_search(d,copied,&requested) {let search=loc_search_name(d);found=loc_find(d,copied,&name,&search)}
 if found<0 {if !loc_names_equal(d,copied,&requested,def) {found=loc_find(d,copied,&name,def)}}
 if found<0 {let standard=loc_standard_name(d);found=loc_find(d,copied,&name,&standard)}
 if found<0 {return loc_bad(6)}
 loc_apply(d,found,options)
}
// -1 means inherit a setting; strength1..5, alternate/backwards/caseLevel0..1,
// caseFirst0off/1lower/2upper, maxVariable0space/1punct/2symbol/3currency.
// Name canonicalization and the complete pinned registry gate precede publication.
pub fn unicode_locale_collator(locale:&Utf8Text,collation_type:&Utf8Text,options:&UnicodeLocaleOptions,max_work_bytes:i64)->UnicodeLocaleCollator with Alloc,Mut,Div {
 let d=loc_data()
 if d.status!=0 {return loc_bad(d.status)}
 let n=utf8_text_byte_len(locale)
 let tn=utf8_text_byte_len(collation_type)
 if n>255 || tn>64 {return loc_bad(1)}
 if max_work_bytes<0 || (n+tn)*8>max_work_bytes {return loc_bad(2)}
 var copied=integer_buffer_new(0,max_work_bytes)
 var status=integer_buffer_status(&copied)
 if status==0 {status=loc_copy_ascii(locale,&!copied)}
 if status==0 {status=loc_copy_ascii(collation_type,&!copied)}
  var result=loc_bad(status)
 if status==0 {result=loc_resolve_copied(&d,&!copied,n,tn,options)}
 integer_buffer_close(copied)
