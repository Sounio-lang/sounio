fn loc_emit_key(key:&!LocaleCollationKey,c:&UnicodeLocaleCollator,d:&LocaleData,u:&UnicodeData,scalars:&!IntegerBuffer,ces:&!IntegerBuffer) with Alloc,Mut,Div,Panic {
 key.status=loc_extract(d,u,c,scalars,ces)
