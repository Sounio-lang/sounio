fn loc_level(d:&LocaleData,c:&UnicodeLocaleCollator,ces:&IntegerBuffer,level:i64,out:&!IntegerBuffer)->i64 with Alloc,Mut,Div,Panic {
 let top=loc_variable_top(d,c)
 if top<0 {return 6}
 let n=integer_buffer_len(ces)
 if n%6!=0 {return 6}
 var at:i64=0
 var shifted=false
 var segment=integer_buffer_len(out)
 while at<n {
  let p=integer_buffer_get(ces,at).value
  let s=integer_buffer_get(ces,at+1).value
  let t=integer_buffer_get(ces,at+2).value
  let q=integer_buffer_get(ces,at+3).value
  let casing=integer_buffer_get(ces,at+4).value
  let separator=integer_buffer_get(ces,at+5).value
  if separator==1 {
   shifted=false
   if level==1 && c.backwards==1 {loc_reverse(out,segment)}
  }
  let variable=p>0 && separator==0 && p<=top
  var status:i64=0
  if c.alternate==1 && variable {
   shifted=true
   if level==4 && c.strength>=4 {status=loc_primary_pair(d,c,out,p)}
   if status!=0 {return status}
   at=at+6;continue
  }
  if c.alternate==1 && shifted && p==0 {at=at+6;continue}
  if p>0 {shifted=false}
  var case_weight=casing+1
  if c.case_first==2 {case_weight=4-case_weight}
  if level==0 {
   if p>0 {status=loc_primary_pair(d,c,out,p)}
  } else if level==1 {
   if c.strength>=2 && s>0 {status=loc_weight(out,s)}
   if separator==1 {segment=integer_buffer_len(out)}
  } else if level==2 {
   if c.case_level==1 {
    let present=if c.strength==1 {p>0} else {p>0 || s>0}
    if present {status=loc_weight(out,case_weight)}
   }
  } else if level==3 {
   if c.strength>=3 && t>0 {
    if c.case_level==0 && c.case_first!=0 {
     let value=if p==0 && s==0 {3} else {case_weight}
     status=loc_weight(out,value)
    }
    if status==0 {status=loc_weight(out,t)}
   }
