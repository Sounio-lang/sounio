fn loc_group(d:&LocaleData,c:&UnicodeLocaleCollator,primary:i64)->i64 {
 let original=primary>>22
 if original<0x03000000 {return 0}
 if original>=0xe5000000 {return c.group_max+2}
 var lo=c.group_first
 var hi=c.group_first+c.group_count
 while lo<hi {let mid=lo+((hi-lo)>>1);if loc_field(d,7,mid,0)<=original {lo=mid+1} else {hi=mid}}
