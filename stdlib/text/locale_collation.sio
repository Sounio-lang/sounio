}
fn loc_extract(d:&LocaleData,u:&UnicodeData,c:&UnicodeLocaleCollator,scalars:&!IntegerBuffer,ces:&!IntegerBuffer)->i64 with Alloc,Mut,Div {
 let property=ucd_property(u,"Canonical_Combining_Class")
 if property<0 {return 6}
 let delta=loc_field(d,5,c.entry,6)
 let dn=loc_field(d,5,c.entry,7)
 let rn=loc_u32(d,24)
 if delta<0 || dn<0 || delta>loc_count(d,4) {return 6}
 if dn>loc_count(d,4)-delta {return 6}
 var at:i64=0
 while at<integer_buffer_len(scalars) {
  if integer_buffer_get(scalars,at).value>=2097152 {at=at+1;continue}
  let cp=loc_scalar(scalars,at)
  let df=loc_lower(d,delta,dn,cp)
  var de=df
  while de<delta+dn {if loc_first(d,de)!=cp {break} de=de+1}
  var best:i64=0-1
  var best_prefix:i64=0-1
  var best_len:i64=0
  var pass:i64=0
  while pass<2 {
   var row=if pass==0 {loc_lower(d,0,rn,cp)} else {df}
   let end=if pass==0 {rn} else {de}
   while row<end {
    if loc_first(d,row)!=cp {break}
    var usable=true
    if pass==0 {if loc_overridden(d,row,df,de) {usable=false}}
    if pass==1 {if loc_field(d,4,row,6)==1 {usable=false}}
    if usable {
     let matched=loc_contract(d,u,property,row,scalars,at,false)
     if matched<0 {return 6}
     if matched==1 {
      let prefix=loc_field(d,4,row,3)
      let n=loc_field(d,4,row,1)
      if prefix>best_prefix || (prefix==best_prefix && n>best_len) {best=row;best_prefix=prefix;best_len=n}
     }
