fn loc_scalar(s:&IntegerBuffer,i:i64)->i64 {integer_buffer_get(s,i).value & 2097151}
fn loc_first(d:&LocaleData,row:i64)->i64 {loc_field(d,2,loc_field(d,4,row,0),0)}
fn loc_lower(d:&LocaleData,first:i64,n:i64,cp:i64)->i64 {
 var lo=first
 var hi=first+n
 while lo<hi {let mid=lo+((hi-lo)>>1);if loc_first(d,mid)<cp {lo=mid+1} else {hi=mid}}
