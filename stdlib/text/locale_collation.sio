}
fn loc_reverse(out:&!IntegerBuffer,start:i64) with Mut,Panic {
 var left=start
 var right=integer_buffer_len(out)-1
 while left<right {
  let a=integer_buffer_get(out,left)
  let b=integer_buffer_get(out,right)
  assert(a.status==0 && b.status==0)
  assert(integer_buffer_set(out,left,b.value)==0)
  assert(integer_buffer_set(out,right,a.value)==0)
  left=left+1;right=right-1
 }
}

fn loc_weight(out:&!IntegerBuffer,value:i64)->i64 with Alloc,Mut,Div {
 if value<0 || value==9223372036854775807 {return 6}
 integer_buffer_push(out,value+1)
