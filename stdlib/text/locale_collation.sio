}
fn loc_build_key(key:&!LocaleCollationKey,c:&UnicodeLocaleCollator,input:&Utf8Text,max_work_bytes:i64) with Alloc,Mut,Div,Panic {
 if key.status==0 {key.status=integer_buffer_status(&key.weights)}
 if max_work_bytes<0 || max_work_bytes>9223372036854771704 {key.status=1}
 if key.status==0 {key.status=utf8_text_status(input)}
 let d=loc_data()
 let u=unicode_data()
 if key.status==0 {if d.status!=0 || unicode_data_status(&u)!=0 {key.status=6}}
 let part=if max_work_bytes>=0 {max_work_bytes/4} else {0}
 var normalized=utf8_text_new(part)
 if key.status==0 {key.status=unicode_normalize_append(input,1,part,&!normalized)}
 var scalars=integer_buffer_new(0,part)
 var ces=integer_buffer_new(0,part)
 var offset:i64=0
 while key.status==0 && offset<utf8_text_byte_len(&normalized) {
  let cp=utf8_text_next(&normalized,offset)
  if cp.status!=0 {key.status=cp.status}
  else {key.status=integer_buffer_push(&!scalars,cp.codepoint);offset=cp.next}
 }
 if key.status==0 {key.status=integer_buffer_status(&ces)}
 if key.status==0 {loc_emit_key(key,c,&d,&u,&!scalars,&!ces)}
 if key.status!=0 {if integer_buffer_len(&key.weights)>0 {assert(integer_buffer_resize(&!key.weights,0)==0)}}
