}
pub fn unicode_locale_uca_version()->i64 {1179648}
pub fn unicode_locale_cldr_version()->i64 {49}
pub fn unicode_locale_key_format_version()->i64 {1}
pub fn unicode_locale_bundled_count()->i64 {let d=loc_data();if d.status!=0 {0} else {loc_count(&d,5)}}
pub fn unicode_locale_bundled_collator(index:i64)->UnicodeLocaleCollator {
 let d=loc_data()
 if d.status!=0 {return loc_bad(d.status)}
