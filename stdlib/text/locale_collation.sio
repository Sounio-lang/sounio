}
fn loc_emit(d:&LocaleData,row:i64,out:&!IntegerBuffer)->i64 with Alloc,Mut,Div {
 let first=loc_field(d,4,row,4)
 let n=loc_field(d,4,row,5)
 if first<0 || n<0 || first>loc_count(d,3) {return 6}
 if n>loc_count(d,3)-first {return 6}
 var i:i64=0
 while i<n {
  let p=loc_long(d,3,first+i,0)
  let s=loc_long(d,3,first+i,2)
  let t=loc_long(d,3,first+i,4)
  let q=loc_field(d,3,first+i,6)
  let casing=loc_field(d,3,first+i,7)
  if p<0 || s<0 || t<0 || q<0 || casing<0 || casing>2 {return 6}
  let status=loc_push_ce(out,p,s,t,q,casing,if p==0x02000000*4194304 {1} else {0})
  if status!=0 {return status}
