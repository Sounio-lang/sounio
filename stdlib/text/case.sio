//! stdlib/text/case.sio - Case Conversion
//!
//! Provides Unicode-aware character case conversion functions.

// ============================================================================
// Character Case Helpers (inlined from unicode)
// ============================================================================

fn char_is_uppercase(c: char) -> bool {
    let code = c as u32
    if code >= 0x41 && code <= 0x5A { return true }
    if (code >= 0xC0 && code <= 0xD6) || (code >= 0xD8 && code <= 0xDE) { return true }
    if code >= 0x391 && code <= 0x3A9 { return true }
    if code >= 0x410 && code <= 0x42F { return true }
    false
}

fn char_is_lowercase(c: char) -> bool {
    let code = c as u32
    if code >= 0x61 && code <= 0x7A { return true }
    if (code >= 0xDF && code <= 0xF6) || (code >= 0xF8 && code <= 0xFF) { return true }
    if code >= 0x3B1 && code <= 0x3C9 { return true }
    if code >= 0x430 && code <= 0x44F { return true }
    false
}

fn char_is_alphabetic(c: char) -> bool {
    let code = c as u32
    if (code >= 0x41 && code <= 0x5A) || (code >= 0x61 && code <= 0x7A) { return true }
    if (code >= 0xC0 && code <= 0xD6) || (code >= 0xD8 && code <= 0xF6) || (code >= 0xF8 && code <= 0xFF) { return true }
    if code >= 0x370 && code <= 0x3FF { return true }
    if code >= 0x400 && code <= 0x4FF { return true }
    false
}

// ============================================================================
// Character Case Conversion
// ============================================================================

// Convert a character to uppercase.
fn char_to_uppercase(c: char) -> char {
    let code = c as u32
    if code >= 0x61 && code <= 0x7A { return ((code - 32) as char) }
    if code >= 0xE0 && code <= 0xF6 { return ((code - 32) as char) }
    if code >= 0xF8 && code <= 0xFE { return ((code - 32) as char) }
    if code >= 0x3B1 && code <= 0x3C9 { return ((code - 32) as char) }
    if code >= 0x430 && code <= 0x44F { return ((code - 32) as char) }
    if code == 0xDF { return (0x1E9E as char) }
    if code == 0xB5 { return (0x039C as char) }
    c
}

// Convert a character to lowercase.
fn char_to_lowercase(c: char) -> char {
    let code = c as u32
    if code >= 0x41 && code <= 0x5A { return ((code + 32) as char) }
    if code >= 0xC0 && code <= 0xD6 { return ((code + 32) as char) }
    if code >= 0xD8 && code <= 0xDE { return ((code + 32) as char) }
    if code >= 0x391 && code <= 0x3A9 { return ((code + 32) as char) }
    if code >= 0x410 && code <= 0x42F { return ((code + 32) as char) }
    c
}
