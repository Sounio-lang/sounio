// One strict Unicode scalar decoder, shared by byte/array adapters.
// Status:0 success,4 invalid offset/no input,5 malformed UTF-8. Errors do not advance.
pub struct Utf8Scalar { pub codepoint:i64, pub next:i64, pub status:i64 }
pub fn utf8_scalar_width(cp:i64)->i64 {
 if cp<0 || cp>1114111 || (cp>=55296 && cp<=57343) { return 0 }
 if cp<128 {1} else if cp<2048 {2} else if cp<65536 {3} else {4}
}
fn utf8_bad(offset:i64,status:i64)->Utf8Scalar { Utf8Scalar {codepoint:0,next:offset,status:status} }
pub fn utf8_decode4(b0:i64,b1:i64,b2:i64,b3:i64,available:i64,offset:i64)->Utf8Scalar {
 if offset<0 || available<=0 {return utf8_bad(offset,4)}
 if b0<0 || b0>244 || (b0>=128 && b0<194) {return utf8_bad(offset,5)}
 let width=if b0<128 {1} else if b0<224 {2} else if b0<240 {3} else {4}
 if width>available {return utf8_bad(offset,5)}
 if offset>9223372036854775807-width {return utf8_bad(offset,4)}
 if width>=2 && (b1<128 || b1>191) {return utf8_bad(offset,5)}
 if width>=3 && (b2<128 || b2>191) {return utf8_bad(offset,5)}
 if width>=4 && (b3<128 || b3>191) {return utf8_bad(offset,5)}
 let cp=if width==1 {b0} else if width==2 {(b0 & 31)*64+(b1 & 63)}
  else if width==3 {(b0 & 15)*4096+(b1 & 63)*64+(b2 & 63)}
  else {(b0 & 7)*262144+(b1 & 63)*4096+(b2 & 63)*64+(b3 & 63)}
 if (width==2 && cp<128) || (width==3 && cp<2048) || (width==4 && cp<65536) {return utf8_bad(offset,5)}
 if utf8_scalar_width(cp)==0 {return utf8_bad(offset,5)}
 return Utf8Scalar {codepoint:cp,next:offset+width,status:0}
}

