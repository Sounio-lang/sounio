//! stdlib/encoding - Data Encoding Utilities
//!
//! This module provides encoding/decoding for various formats:
//! - `base64` - Base64 encoding (standard and URL-safe)
//! - `hex` - Hexadecimal encoding
//!
//! # Examples
//!
//! ```sio
//! // Base64
//! let encoded = base64_encode("Hello, World!".as_bytes())
//! let decoded = base64_decode(&encoded)?
//!
//! // Hex
//! let hex = hex_encode(&[0xDE, 0xAD, 0xBE, 0xEF])  // "deadbeef"
//! let bytes = hex_decode("deadbeef")?
//! ```

pub mod base64;
pub mod hex;

pub use base64::*;
pub use hex::*;
