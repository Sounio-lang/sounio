// stdlib/encoding/base64.sio — Base64 Encoding / Decoding (RFC 4648)
//
// Standard and URL-safe Base64.
// Operates on fixed-size arrays (no heap allocation).
//
// # Capacity
//   - Encode: up to 192 input bytes → 256 output bytes (includes padding)
//   - Decode: up to 256 encoded bytes → 192 output bytes
//
// # Example
//   var out: [u8; 256] = [0; 256]
//   let len = base64_encode(&input, n, &!out)
//   // out[0..len] contains the Base64 string

// =============================================================================
// Alphabet helpers
// =============================================================================

// Standard Base64 alphabet: index → ASCII character (RFC 4648 §4)
fn b64_char_std(idx: u8) -> u8 {
    if idx < (26 as u8) { return (65 as u8) + idx }        // A-Z (ASCII 65-90)
    if idx < (52 as u8) { return (97 as u8) + (idx - (26 as u8)) }  // a-z (ASCII 97-122)
    if idx < (62 as u8) { return (48 as u8) + (idx - (52 as u8)) }  // 0-9 (ASCII 48-57)
    if idx == (62 as u8) { return (43 as u8) }              // + (ASCII 43)
    (47 as u8)                                         // / (ASCII 47)
}

// URL-safe Base64 alphabet (RFC 4648 §5): + → -, / → _, no padding
fn b64_char_url(idx: u8) -> u8 {
    if idx < (26 as u8) { return (65 as u8) + idx }
    if idx < (52 as u8) { return (97 as u8) + (idx - (26 as u8)) }
    if idx < (62 as u8) { return (48 as u8) + (idx - (52 as u8)) }
    if idx == (62 as u8) { return (45 as u8) }  // - (ASCII 45)
    (95 as u8)                            // _ (ASCII 95)
}

// Decode a base64 character to 6-bit value. Returns 255 for invalid/padding.
fn b64_decode_char(c: u8) -> u8 {
    if c >= (65 as u8) && c <= (90 as u8)  { return c - (65 as u8) }          // A-Z → 0-25
    if c >= (97 as u8) && c <= (122 as u8) { return c - (97 as u8) + (26 as u8) }   // a-z → 26-51
    if c >= (48 as u8) && c <= (57 as u8)  { return c - (48 as u8) + (52 as u8) }   // 0-9 → 52-61
    if c == (43 as u8) || c == (45 as u8)  { return (62 as u8) }               // + or - → 62
    if c == (47 as u8) || c == (95 as u8)  { return (63 as u8) }               // / or _ → 63
    (255 as u8)   // invalid or padding (=)
}

// =============================================================================
// Encode — Standard Base64
// =============================================================================

/// Encode bytes to standard Base64 (RFC 4648 §4, with = padding).
///
/// # Parameters
/// - `data`: Input byte array (max 192 bytes)
/// - `data_len`: Number of valid bytes in `data`
/// - `out`: Output array for the Base64 ASCII bytes
///
/// # Return
/// Number of bytes written to `out` (multiple of 4), or -1 on error.
pub fn base64_encode(data: &[u8; 256], data_len: i32, out: &![u8; 256]) -> i32 with Mut, Div, Panic {
    if data_len < 0 || data_len > 192 { return 0 - 1 }

    var out_pos: i32 = 0
    var i: i32 = 0

    while i + 2 < data_len {
        let b0 = data[i as usize]
        let b1 = data[(i + 1) as usize]
        let b2 = data[(i + 2) as usize]

        out[out_pos as usize]       = b64_char_std((b0 >> (2 as u8)) & (63 as u8))
        out[(out_pos + 1) as usize] = b64_char_std(((b0 << (4 as u8)) | (b1 >> (4 as u8))) & (63 as u8))
        out[(out_pos + 2) as usize] = b64_char_std(((b1 << (2 as u8)) | (b2 >> (6 as u8))) & (63 as u8))
        out[(out_pos + 3) as usize] = b64_char_std(b2 & (63 as u8))

        i = i + 3
        out_pos = out_pos + 4
    }

    // Handle remaining 1 or 2 bytes
    let rem = data_len - i
    if rem == 1 {
        let b0 = data[i as usize]
        out[out_pos as usize]       = b64_char_std((b0 >> (2 as u8)) & (63 as u8))
        out[(out_pos + 1) as usize] = b64_char_std((b0 << (4 as u8)) & (63 as u8))
        out[(out_pos + 2) as usize] = (61 as u8)   // =
        out[(out_pos + 3) as usize] = (61 as u8)   // =
        out_pos = out_pos + 4
    } else if rem == 2 {
        let b0 = data[i as usize]
        let b1 = data[(i + 1) as usize]
        out[out_pos as usize]       = b64_char_std((b0 >> (2 as u8)) & (63 as u8))
        out[(out_pos + 1) as usize] = b64_char_std(((b0 << (4 as u8)) | (b1 >> (4 as u8))) & (63 as u8))
        out[(out_pos + 2) as usize] = b64_char_std((b1 << (2 as u8)) & (63 as u8))
        out[(out_pos + 3) as usize] = (61 as u8)   // =
        out_pos = out_pos + 4
    }

    out_pos
}

// =============================================================================
// Encode — URL-safe Base64
// =============================================================================

/// Encode bytes to URL-safe Base64 (RFC 4648 §5).
/// Uses - and _ instead of + and /. No = padding.
///
/// # Return
/// Number of bytes written, or -1 on error.
pub fn base64_encode_url_safe(data: &[u8; 256], data_len: i32, out: &![u8; 256]) -> i32 with Mut, Div, Panic {
    if data_len < 0 || data_len > 192 { return 0 - 1 }

    var out_pos: i32 = 0
    var i: i32 = 0

    while i + 2 < data_len {
        let b0 = data[i as usize]
        let b1 = data[(i + 1) as usize]
        let b2 = data[(i + 2) as usize]

        out[out_pos as usize]       = b64_char_url((b0 >> (2 as u8)) & (63 as u8))
        out[(out_pos + 1) as usize] = b64_char_url(((b0 << (4 as u8)) | (b1 >> (4 as u8))) & (63 as u8))
        out[(out_pos + 2) as usize] = b64_char_url(((b1 << (2 as u8)) | (b2 >> (6 as u8))) & (63 as u8))
        out[(out_pos + 3) as usize] = b64_char_url(b2 & (63 as u8))

        i = i + 3
        out_pos = out_pos + 4
    }

    let rem = data_len - i
    if rem == 1 {
        let b0 = data[i as usize]
        out[out_pos as usize]       = b64_char_url((b0 >> (2 as u8)) & (63 as u8))
        out[(out_pos + 1) as usize] = b64_char_url((b0 << (4 as u8)) & (63 as u8))
        out_pos = out_pos + 2
    } else if rem == 2 {
        let b0 = data[i as usize]
        let b1 = data[(i + 1) as usize]
        out[out_pos as usize]       = b64_char_url((b0 >> (2 as u8)) & (63 as u8))
        out[(out_pos + 1) as usize] = b64_char_url(((b0 << (4 as u8)) | (b1 >> (4 as u8))) & (63 as u8))
        out[(out_pos + 2) as usize] = b64_char_url((b1 << (2 as u8)) & (63 as u8))
        out_pos = out_pos + 3
    }

    out_pos
}

// =============================================================================
// Decode
// =============================================================================

/// Decode standard or URL-safe Base64 to raw bytes.
///
/// # Parameters
/// - `data`: Base64 ASCII bytes (may include = padding; max 256 bytes)
/// - `data_len`: Number of valid bytes
/// - `out`: Output for decoded bytes (max 192 bytes)
///
/// # Return
/// Number of decoded bytes, or -1 on invalid input.
pub fn base64_decode(data: &[u8; 256], data_len: i32, out: &![u8; 256]) -> i32 with Mut, Div, Panic {
    if data_len < 0 || data_len > 256 { return 0 - 1 }

    var out_pos: i32 = 0
    var i: i32 = 0

    while i + 3 < data_len {
        let c0 = b64_decode_char(data[i as usize])
        let c1 = b64_decode_char(data[(i + 1) as usize])
        let c2 = b64_decode_char(data[(i + 2) as usize])
        let c3 = b64_decode_char(data[(i + 3) as usize])

        if c0 == (255 as u8) || c1 == (255 as u8) { return 0 - 1 }

        out[out_pos as usize] = ((c0 << (2 as u8)) | (c1 >> (4 as u8))) & (255 as u8)
        out_pos = out_pos + 1

        if data[(i + 2) as usize] != (61 as u8) {
            if c2 == (255 as u8) { return 0 - 1 }
            out[out_pos as usize] = ((c1 << (4 as u8)) | (c2 >> (2 as u8))) & (255 as u8)
            out_pos = out_pos + 1
        }

        if data[(i + 3) as usize] != (61 as u8) {
            if c3 == (255 as u8) { return 0 - 1 }
            out[out_pos as usize] = ((c2 << (6 as u8)) | c3) & (255 as u8)
            out_pos = out_pos + 1
        }

        i = i + 4
    }

    out_pos
}
