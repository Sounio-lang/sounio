//! stdlib/encoding/base64.sio - Base64 Encoding
//!
//! Implements RFC 4648 Base64 encoding with standard and URL-safe alphabets.

// ============================================================================
// Constants
// ============================================================================

// Standard Base64 alphabet
const BASE64_STANDARD: &str = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

// URL-safe Base64 alphabet (replaces + with - and / with _)
const BASE64_URL_SAFE: &str = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"

// Padding character
const PAD: char = '='

// ============================================================================
// Error Type
// ============================================================================

// Base64 decoding errors
pub enum Base64Error {
    /// Invalid character in input
    InvalidChar { char: char, position: usize },
    /// Invalid padding
    InvalidPadding,
    /// Invalid length (not a multiple of 4)
    InvalidLength,
}

// ============================================================================
// Encoding
// ============================================================================

// Encode bytes to standard Base64 string.
pub fn base64_encode(data: &[u8]) -> String with Alloc {
    base64_encode_with_alphabet(data, BASE64_STANDARD, true)
}

// Encode bytes to URL-safe Base64 string.
pub fn base64_encode_url_safe(data: &[u8]) -> String with Alloc {
    base64_encode_with_alphabet(data, BASE64_URL_SAFE, true)
}

// Encode bytes to Base64 without padding.
pub fn base64_encode_no_pad(data: &[u8]) -> String with Alloc {
    base64_encode_with_alphabet(data, BASE64_STANDARD, false)
}

// Encode bytes to URL-safe Base64 without padding.
pub fn base64_encode_url_safe_no_pad(data: &[u8]) -> String with Alloc {
    base64_encode_with_alphabet(data, BASE64_URL_SAFE, false)
}

fn base64_encode_with_alphabet(data: &[u8], alphabet: &str, pad: bool) -> String with Alloc {
    var result = string_new()

    let len = data.len()
    var i = 0

    // Process 3-byte chunks
    while i + 2 < len {
        let b0 = data[i] as u32
        let b1 = data[i + 1] as u32
        let b2 = data[i + 2] as u32

        // Convert 3 bytes to 4 base64 characters
        let n = (b0 << 16) | (b1 << 8) | b2

        string_push(&!result, alphabet.char_at(((n >> 18) & 0x3F) as usize))
        string_push(&!result, alphabet.char_at(((n >> 12) & 0x3F) as usize))
        string_push(&!result, alphabet.char_at(((n >> 6) & 0x3F) as usize))
        string_push(&!result, alphabet.char_at((n & 0x3F) as usize))

        i = i + 3
    }

    // Handle remaining bytes
    let remaining = len - i

    if remaining == 1 {
        let b0 = data[i] as u32
        let n = b0 << 16

        string_push(&!result, alphabet.char_at(((n >> 18) & 0x3F) as usize))
        string_push(&!result, alphabet.char_at(((n >> 12) & 0x3F) as usize))

        if pad {
            string_push(&!result, PAD)
            string_push(&!result, PAD)
        }
    } else if remaining == 2 {
        let b0 = data[i] as u32
        let b1 = data[i + 1] as u32
        let n = (b0 << 16) | (b1 << 8)

        string_push(&!result, alphabet.char_at(((n >> 18) & 0x3F) as usize))
        string_push(&!result, alphabet.char_at(((n >> 12) & 0x3F) as usize))
        string_push(&!result, alphabet.char_at(((n >> 6) & 0x3F) as usize))

        if pad {
            string_push(&!result, PAD)
        }
    }

    result
}

// ============================================================================
// Decoding
// ============================================================================

// Decode a standard Base64 string.
pub fn base64_decode(encoded: &str) -> Result<Vec<u8>, Base64Error> with Alloc {
    base64_decode_with_alphabet(encoded, BASE64_STANDARD)
}

// Decode a URL-safe Base64 string.
pub fn base64_decode_url_safe(encoded: &str) -> Result<Vec<u8>, Base64Error> with Alloc {
    base64_decode_with_alphabet(encoded, BASE64_URL_SAFE)
}

fn base64_decode_with_alphabet(encoded: &str, alphabet: &str) -> Result<Vec<u8>, Base64Error> with Alloc {
    // Build reverse lookup table
    var decode_table = [255u8; 256]
    var i = 0
    while i < 64 {
        let c = alphabet.char_at(i) as usize
        decode_table[c] = i as u8
        i = i + 1
    }

    // Remove whitespace and count padding
    var clean = string_new()
    var pad_count = 0

    for c in encoded.chars() {
        if c == ' ' || c == '\n' || c == '\r' || c == '\t' {
            continue
        }
        if c == PAD {
            pad_count = pad_count + 1
        }
        string_push(&!clean, c)
    }

    let len = clean.len()

    // Validate length (must be multiple of 4 or handle no-padding)
    if len == 0 {
        return Ok(vec_new())
    }

    // Handle non-padded input by adding padding
    let padded_len = ((len + 3) / 4) * 4
    while clean.len() < padded_len {
        string_push(&!clean, PAD)
        pad_count = pad_count + 1
    }

    let clean_len = clean.len()
    if clean_len % 4 != 0 {
        return Err(Base64Error::InvalidLength)
    }

    // Calculate output size
    let output_len = (clean_len / 4) * 3 - pad_count

    var result = vec_new::<u8>()
    vec_reserve(&!result, output_len)

    // Decode 4 characters at a time
    i = 0
    while i < clean_len {
        var values = [0u8; 4]
        var j = 0

        while j < 4 {
            let c = clean.char_at(i + j)

            if c == PAD {
                values[j] = 0
            } else {
                let idx = c as usize
                if idx >= 256 || decode_table[idx] == 255 {
                    return Err(Base64Error::InvalidChar { char: c, position: i + j })
                }
                values[j] = decode_table[idx]
            }
            j = j + 1
        }

        // Convert 4 base64 values to 3 bytes
        let n = ((values[0] as u32) << 18) |
                ((values[1] as u32) << 12) |
                ((values[2] as u32) << 6) |
                (values[3] as u32)

        vec_push(&!result, ((n >> 16) & 0xFF) as u8)

        if clean.char_at(i + 2) != PAD {
            vec_push(&!result, ((n >> 8) & 0xFF) as u8)
        }

        if clean.char_at(i + 3) != PAD {
            vec_push(&!result, (n & 0xFF) as u8)
        }

        i = i + 4
    }

    Ok(result)
}

// ============================================================================
// Streaming Encoder
// ============================================================================

// Streaming Base64 encoder.
pub struct Base64Encoder {
    buffer: [u8; 3],
    buffer_len: usize,
    output: String,
    alphabet: String,
    pad: bool,
}

// Create a new Base64 encoder.
pub fn base64_encoder_new() -> Base64Encoder with Alloc {
    Base64Encoder {
        buffer: [0u8; 3],
        buffer_len: 0,
        output: string_new(),
        alphabet: string_from(BASE64_STANDARD),
        pad: true,
    }
}

// Create a new URL-safe Base64 encoder.
pub fn base64_encoder_url_safe() -> Base64Encoder with Alloc {
    Base64Encoder {
        buffer: [0u8; 3],
        buffer_len: 0,
        output: string_new(),
        alphabet: string_from(BASE64_URL_SAFE),
        pad: true,
    }
}

// Feed data to the encoder.
pub fn base64_encoder_write(enc: &!Base64Encoder, data: &[u8]) with Alloc {
    var i = 0

    while i < data.len() {
        enc.buffer[enc.buffer_len] = data[i]
        enc.buffer_len = enc.buffer_len + 1

        if enc.buffer_len == 3 {
            // Encode 3 bytes
            let b0 = enc.buffer[0] as u32
            let b1 = enc.buffer[1] as u32
            let b2 = enc.buffer[2] as u32
            let n = (b0 << 16) | (b1 << 8) | b2

            string_push(&!enc.output, enc.alphabet.char_at(((n >> 18) & 0x3F) as usize))
            string_push(&!enc.output, enc.alphabet.char_at(((n >> 12) & 0x3F) as usize))
            string_push(&!enc.output, enc.alphabet.char_at(((n >> 6) & 0x3F) as usize))
            string_push(&!enc.output, enc.alphabet.char_at((n & 0x3F) as usize))

            enc.buffer_len = 0
        }

        i = i + 1
    }
}

// Finalize encoding and get the result.
pub fn base64_encoder_finish(enc: &!Base64Encoder) -> String with Alloc {
    // Handle remaining bytes
    if enc.buffer_len == 1 {
        let b0 = enc.buffer[0] as u32
        let n = b0 << 16

        string_push(&!enc.output, enc.alphabet.char_at(((n >> 18) & 0x3F) as usize))
        string_push(&!enc.output, enc.alphabet.char_at(((n >> 12) & 0x3F) as usize))

        if enc.pad {
            string_push(&!enc.output, PAD)
            string_push(&!enc.output, PAD)
        }
    } else if enc.buffer_len == 2 {
        let b0 = enc.buffer[0] as u32
        let b1 = enc.buffer[1] as u32
        let n = (b0 << 16) | (b1 << 8)

        string_push(&!enc.output, enc.alphabet.char_at(((n >> 18) & 0x3F) as usize))
        string_push(&!enc.output, enc.alphabet.char_at(((n >> 12) & 0x3F) as usize))
        string_push(&!enc.output, enc.alphabet.char_at(((n >> 6) & 0x3F) as usize))

        if enc.pad {
            string_push(&!enc.output, PAD)
        }
    }

    enc.buffer_len = 0
    string_from(&enc.output)
}

// ============================================================================
// Validation
// ============================================================================

// Check if a string is valid Base64.
pub fn base64_is_valid(s: &str) -> bool {
    for c in s.chars() {
        if c == ' ' || c == '\n' || c == '\r' || c == '\t' || c == PAD {
            continue
        }

        let valid = (c >= 'A' && c <= 'Z') ||
                    (c >= 'a' && c <= 'z') ||
                    (c >= '0' && c <= '9') ||
                    c == '+' || c == '/';

        if !valid {
            return false
        }
    }
    true
}

// Check if a string is valid URL-safe Base64.
pub fn base64_is_valid_url_safe(s: &str) -> bool {
    for c in s.chars() {
        if c == ' ' || c == '\n' || c == '\r' || c == '\t' || c == PAD {
            continue
        }

        let valid = (c >= 'A' && c <= 'Z') ||
                    (c >= 'a' && c <= 'z') ||
                    (c >= '0' && c <= '9') ||
                    c == '-' || c == '_';

        if !valid {
            return false
        }
    }
    true
}

// Calculate the encoded length for a given input length.
pub fn base64_encoded_len(input_len: usize, pad: bool) -> usize {
    if pad {
        ((input_len + 2) / 3) * 4
    } else {
        let full_chunks = input_len / 3
        let remainder = input_len % 3

        full_chunks * 4 + if remainder == 0 { 0 } else { remainder + 1 }
    }
}

// Calculate the decoded length for a given encoded string.
pub fn base64_decoded_len(encoded: &str) -> usize {
    let len = encoded.len()
    if len == 0 {
        return 0
    }

    // Count padding
    var pad_count = 0
    if len >= 1 && encoded.char_at(len - 1) == PAD {
        pad_count = pad_count + 1
    }
    if len >= 2 && encoded.char_at(len - 2) == PAD {
        pad_count = pad_count + 1
    }

    (len / 4) * 3 - pad_count
}
