//! stdlib/encoding/hex.sio - Hexadecimal Encoding
//!
//! Provides functions for encoding and decoding hexadecimal strings.

// ============================================================================
// String helpers (forward-declared for the type checker)
// ============================================================================

extern "C" {
    fn string_new() -> string;
    fn string_from(s: &str) -> string;
    fn string_reserve(s: &!string, n: usize);
    fn string_push(s: &!string, c: char);
    fn string_push_str(s: &!string, t: &str);
    fn string_clear(s: &!string);
}

// ============================================================================
// Constants
// ============================================================================

const HEX_LOWER: &str = "0123456789abcdef"
const HEX_UPPER: &str = "0123456789ABCDEF"

// ============================================================================
// Error Type
// ============================================================================

// Hex decoding errors
pub enum HexError {
    /// Invalid character in input
    InvalidChar { char: char, position: usize },
    /// Odd number of characters (must be even)
    OddLength,
}

// ============================================================================
// Encoding
// ============================================================================

// Encode bytes to lowercase hexadecimal string.
pub fn hex_encode(data: &[u8]) -> String with Alloc {
    var result = string_new()
    string_reserve(&!result, data.len() * 2)

    for b in data {
        string_push(&!result, HEX_LOWER.char_at(((*b >> 4) & 0x0F) as usize))
        string_push(&!result, HEX_LOWER.char_at((*b & 0x0F) as usize))
    }

    result
}

// Encode bytes to uppercase hexadecimal string.
pub fn hex_encode_upper(data: &[u8]) -> String with Alloc {
    var result = string_new()
    string_reserve(&!result, data.len() * 2)

    for b in data {
        string_push(&!result, HEX_UPPER.char_at(((*b >> 4) & 0x0F) as usize))
        string_push(&!result, HEX_UPPER.char_at((*b & 0x0F) as usize))
    }

    result
}

// Encode bytes with a prefix (e.g., "0x").
pub fn hex_encode_with_prefix(data: &[u8], prefix: &str) -> String with Alloc {
    var result = string_from(prefix)
    string_reserve(&!result, prefix.len() + data.len() * 2)

    for b in data {
        string_push(&!result, HEX_LOWER.char_at(((*b >> 4) & 0x0F) as usize))
        string_push(&!result, HEX_LOWER.char_at((*b & 0x0F) as usize))
    }

    result
}

// Encode a single byte as two hex characters.
pub fn hex_encode_byte(b: u8) -> (char, char) {
    let high = HEX_LOWER.char_at(((b >> 4) & 0x0F) as usize)
    let low = HEX_LOWER.char_at((b & 0x0F) as usize)
    (high, low)
}

// ============================================================================
// Decoding
// ============================================================================

// Decode a hexadecimal string to bytes.
pub fn hex_decode(hex: &str) -> Result<Vec<u8>, HexError> with Alloc {
    // Skip common prefixes
    var start = 0
    if hex.len() >= 2 {
        if (hex.char_at(0) == '0' && (hex.char_at(1) == 'x' || hex.char_at(1) == 'X')) {
            start = 2
        }
    }

    let data = &hex[start..]
    let len = data.len()

    if len % 2 != 0 {
        return Err(HexError::OddLength)
    }

    var result = vec_new::<u8>()
    vec_reserve(&!result, len / 2)

    var i = 0
    while i < len {
        let high = hex_char_to_nibble(data.char_at(i))?
        let low = hex_char_to_nibble(data.char_at(i + 1))?

        vec_push(&!result, (high << 4) | low)
        i = i + 2
    }

    Ok(result)
}

fn hex_char_to_nibble(c: char) -> Result<u8, HexError> {
    if c >= '0' && c <= '9' {
        Ok((c as u8) - ('0' as u8))
    } else if c >= 'a' && c <= 'f' {
        Ok((c as u8) - ('a' as u8) + 10)
    } else if c >= 'A' && c <= 'F' {
        Ok((c as u8) - ('A' as u8) + 10)
    } else {
        Err(HexError::InvalidChar { char: c, position: 0 })
    }
}

// Decode a single hex digit.
pub fn hex_decode_nibble(c: char) -> Option<u8> {
    if c >= '0' && c <= '9' {
        Some((c as u8) - ('0' as u8))
    } else if c >= 'a' && c <= 'f' {
        Some((c as u8) - ('a' as u8) + 10)
    } else if c >= 'A' && c <= 'F' {
        Some((c as u8) - ('A' as u8) + 10)
    } else {
        None
    }
}

// ============================================================================
// Validation
// ============================================================================

// Check if a string is valid hexadecimal.
pub fn hex_is_valid(s: &str) -> bool {
    for c in s.chars() {
        let valid = (c >= '0' && c <= '9') ||
                    (c >= 'a' && c <= 'f') ||
                    (c >= 'A' && c <= 'F');

        if !valid {
            return false
        }
    }
    true
}

// Check if a character is a valid hex digit.
pub fn hex_is_digit(c: char) -> bool {
    (c >= '0' && c <= '9') ||
    (c >= 'a' && c <= 'f') ||
    (c >= 'A' && c <= 'F')
}

// ============================================================================
// Integer Conversion
// ============================================================================

// Encode a u8 as hex string.
pub fn hex_from_u8(n: u8) -> String with Alloc {
    var s = string_new()
    string_push(&!s, HEX_LOWER.char_at(((n >> 4) & 0x0F) as usize))
    string_push(&!s, HEX_LOWER.char_at((n & 0x0F) as usize))
    s
}

// Encode a u16 as hex string (big-endian).
pub fn hex_from_u16(n: u16) -> String with Alloc {
    var s = string_new()
    string_push(&!s, HEX_LOWER.char_at(((n >> 12) & 0x0F) as usize))
    string_push(&!s, HEX_LOWER.char_at(((n >> 8) & 0x0F) as usize))
    string_push(&!s, HEX_LOWER.char_at(((n >> 4) & 0x0F) as usize))
    string_push(&!s, HEX_LOWER.char_at((n & 0x0F) as usize))
    s
}

// Encode a u32 as hex string (big-endian).
pub fn hex_from_u32(n: u32) -> String with Alloc {
    var s = string_new()
    var i = 28
    while i >= 0 {
        string_push(&!s, HEX_LOWER.char_at(((n >> i) & 0x0F) as usize))
        if i == 0 { break }
        i = i - 4
    }
    s
}

// Encode a u64 as hex string (big-endian).
pub fn hex_from_u64(n: u64) -> String with Alloc {
    var s = string_new()
    var i = 60i32
    while i >= 0 {
        string_push(&!s, HEX_LOWER.char_at(((n >> i) & 0x0F) as usize))
        if i == 0 { break }
        i = i - 4
    }
    s
}

// Parse a hex string as u8.
pub fn hex_to_u8(s: &str) -> Result<u8, HexError> with Alloc {
    let bytes = hex_decode(s)?
    if vec_len(&bytes) != 1 {
        return Err(HexError::OddLength)
    }
    Ok(bytes[0])
}

// Parse a hex string as u16.
pub fn hex_to_u16(s: &str) -> Result<u16, HexError> with Alloc {
    let bytes = hex_decode(s)?
    if vec_len(&bytes) > 2 {
        return Err(HexError::OddLength)
    }

    var result: u16 = 0
    for b in &bytes {
        result = (result << 8) | (*b as u16)
    }
    Ok(result)
}

// Parse a hex string as u32.
pub fn hex_to_u32(s: &str) -> Result<u32, HexError> with Alloc {
    let bytes = hex_decode(s)?
    if vec_len(&bytes) > 4 {
        return Err(HexError::OddLength)
    }

    var result: u32 = 0
    for b in &bytes {
        result = (result << 8) | (*b as u32)
    }
    Ok(result)
}

// Parse a hex string as u64.
pub fn hex_to_u64(s: &str) -> Result<u64, HexError> with Alloc {
    let bytes = hex_decode(s)?
    if vec_len(&bytes) > 8 {
        return Err(HexError::OddLength)
    }

    var result: u64 = 0
    for b in &bytes {
        result = (result << 8) | (*b as u64)
    }
    Ok(result)
}

// ============================================================================
// Formatting Utilities
// ============================================================================

// Format bytes as hex with a separator (e.g., "de:ad:be:ef").
pub fn hex_format_separated(data: &[u8], sep: &str) -> String with Alloc {
    var result = string_new()

    var i = 0
    for b in data {
        if i > 0 {
            string_push_str(&!result, sep)
        }

        string_push(&!result, HEX_LOWER.char_at(((*b >> 4) & 0x0F) as usize))
        string_push(&!result, HEX_LOWER.char_at((*b & 0x0F) as usize))

        i = i + 1
    }

    result
}

// Format bytes as hex with spaces every n bytes.
pub fn hex_format_grouped(data: &[u8], group_size: usize) -> String with Alloc {
    var result = string_new()

    var i = 0
    for b in data {
        if i > 0 && i % group_size == 0 {
            string_push(&!result, ' ')
        }

        string_push(&!result, HEX_LOWER.char_at(((*b >> 4) & 0x0F) as usize))
        string_push(&!result, HEX_LOWER.char_at((*b & 0x0F) as usize))

        i = i + 1
    }

    result
}

// Hex dump format (like xxd): offset | hex | ascii
pub fn hex_dump(data: &[u8], bytes_per_line: usize) -> String with Alloc {
    var result = string_new()
    var offset = 0

    while offset < data.len() {
        // Offset
        let offset_hex = hex_from_u32(offset as u32)
        string_push_str(&!result, &offset_hex)
        string_push_str(&!result, ": ")

        // Hex bytes
        var i = 0
        while i < bytes_per_line {
            if offset + i < data.len() {
                let b = data[offset + i]
                string_push(&!result, HEX_LOWER.char_at(((b >> 4) & 0x0F) as usize))
                string_push(&!result, HEX_LOWER.char_at((b & 0x0F) as usize))
            } else {
                string_push_str(&!result, "  ")
            }
            string_push(&!result, ' ')

            // Extra space in middle
            if i == bytes_per_line / 2 - 1 {
                string_push(&!result, ' ')
            }

            i = i + 1
        }

        // ASCII representation
        string_push(&!result, ' ')
        string_push(&!result, '|')

        i = 0
        while i < bytes_per_line && offset + i < data.len() {
            let b = data[offset + i]
            if b >= 32 && b < 127 {
                string_push(&!result, b as char)
            } else {
                string_push(&!result, '.')
            }
            i = i + 1
        }

        string_push(&!result, '|')
        string_push(&!result, '\n')

        offset = offset + bytes_per_line
    }

    result
}
