//! stdlib/database — SQL Database Interface
//!
//! Provides SQL database connectivity with both pure Sounio and FFI backends:
//! - `pure::engine` - In-memory SQLite-like engine (pure Sounio, no dependencies)
//! - `ffi::bindings` - FFI declarations for libsqlite3 and libpq
//! - `ffi::wrapper` - Sounio wrapper over FFI when available
//! - `ffi::fallback` - Graceful fallback when FFI unavailable
//!
//! # Quickstart
//! ```sio
//! use database::pure::engine
//!
//! let mut db = in_memory_db_new()
//! engine_create_table(&mut db, CreateTableStmt { ... })
//! engine_execute_sql(&mut db, "INSERT INTO t VALUES (1)".to_string())
//! let result = engine_execute_sql(&mut db, "SELECT * FROM t".to_string())
//! ```
//!
//! # Epistemic variants
//! For uncertainty-aware queries, use `EpistemicResultSet` which tracks
//! confidence and provenance for aggregate results.
//!
//! # References
//! - SQL-2011 Standard (ISO/IEC 9075:2011)
//! - SQLite C API (sqlite.org/c3ref/intro.html)
//! - libpq Documentation (postgresql.org/docs/current/libpq.html)

pub mod pure;
pub mod ffi;

pub use pure::types::*;
pub use pure::parser::*;
