// stdlib/database/pure/parser.sio — SQL Parser (Simplified)
// References: SQL-2011 Standard

pub fn parse_sql(sql: String) -> Result<SqlCmd, String> {
    if sql.len() == 0 {
        return Err("Empty query".to_string())
    }
    let lower = sql.to_lowercase()
    if starts_with(&lower, &"select ".to_string()) {
        Ok(SqlCmd::Select(SelectStmt {
            columns: Vec::new(),
            from: "".to_string(),
            where_clause: None,
            group_by: Vec::new(),
            having: None,
            order_by: Vec::new(),
            limit: None,
            offset: None,
            is_distinct: false,
        }))
    } else if starts_with(&lower, &"insert ".to_string()) {
        Ok(SqlCmd::Insert(InsertStmt {
            table: "".to_string(),
            columns: Vec::new(),
            values: Vec::new(),
        }))
    } else if starts_with(&lower, &"update ".to_string()) {
        Ok(SqlCmd::Update(UpdateStmt {
            table: "".to_string(),
            set: Vec::new(),
            where_clause: None,
        }))
    } else if starts_with(&lower, &"delete ".to_string()) {
        Ok(SqlCmd::Delete(DeleteStmt {
            from: "".to_string(),
            where_clause: None,
        }))
    } else if starts_with(&lower, &"create table ".to_string()) {
        Ok(SqlCmd::CreateTable(CreateTableStmt {
            name: "".to_string(),
            columns: Vec::new(),
            if_not_exists: false,
        }))
    } else if starts_with(&lower, &"drop table ".to_string()) {
        Ok(SqlCmd::DropTable(DropTableStmt {
            name: "".to_string(),
            if_exists: false,
        }))
    } else {
        Err("Unsupported SQL command".to_string())
    }
}

fn starts_with(s: &String, prefix: &String) -> bool {
    var i = 0
    while i < prefix.len() {
        if i >= s.len() { return false }
        if s.as_bytes()[i] != prefix.as_bytes()[i] { return false }
        i = i + 1
    }
    true
}

pub fn validate_sql(sql: String) -> bool {
    match parse_sql(sql) {
        Ok(_) => true,
        Err(_) => false,
    }
}