// stdlib/database/pure/types.sio — Minimal Database Types

pub enum QueryOutcome {
    Rows(ResultSet),
    Affected(i64),
    Empty,
}

pub struct ResultSet {
    pub columns: Vec<String>,
    pub rows: Vec<Vec<Value>>,
    pub row_count: i64,
}

pub enum Value {
    Null,
    Integer(i64),
    Real(f64),
    Text(String),
}

pub struct InMemoryDB {
    pub tables: Vec<TableDef>,
    pub data: Vec<TableData>,
}

pub struct TableDef {
    pub name: String,
    pub columns: Vec<ColumnDef>,
    pub row_count: i64,
}

pub struct ColumnDef {
    pub name: String,
    pub typ: ColumnType,
}

pub enum ColumnType {
    Integer,
    Real,
    Text,
}

pub struct TableData {
    pub table_name: String,
    pub rows: Vec<Vec<Value>>,
}

pub enum SqlCmd {
    Select(SelectStmt),
    Insert(InsertStmt),
    CreateTable(CreateTableStmt),
    DropTable(DropTableStmt),
}

pub struct SelectStmt {
    pub from: String,
}

pub struct InsertStmt {
    pub table: String,
    pub values: Vec<Vec<Value>>,
}

pub struct CreateTableStmt {
    pub name: String,
}

pub struct DropTableStmt {
    pub name: String,
}

pub struct QueryResult {
    pub sql: String,
    pub result: QueryOutcome,
}

pub fn in_memory_db_new() -> InMemoryDB {
    InMemoryDB {
        tables: Vec::new(),
        data: Vec::new(),
    }
}

pub fn result_set_new() -> ResultSet {
    ResultSet {
        columns: Vec::new(),
        rows: Vec::new(),
        row_count: 0,
    }
}

pub fn table_data_new(name: String) -> TableData {
    TableData { table_name: name, rows: Vec::new() }
}

pub fn query_result_new(sql: String, result: QueryOutcome) -> QueryResult {
    QueryResult { sql, result }
}

pub fn validate_sql(sql: String) -> bool {
    if sql.len() == 0 { return false }
    true
}

pub fn parse_sql(sql: String) -> Result<SqlCmd, String> {
    if sql.len() == 0 {
        return Err("Empty query".to_string())
    }
    Ok(SqlCmd::Select(SelectStmt { from: "".to_string() }))
}