// stdlib/database/pure/types.sio — Fixed-capacity in-memory database types.
//
// Capacities: max 4 tables, max 16 rows/table, max 4 i64 columns/row.
// Data stored flat in InMemoryDB.data[t*64 + r*4 + c].
// No heap allocation; no Vec/String — fully compatible with the running Sounio compiler.

pub struct InMemoryDB {
    pub table_count: i32,
    pub table_names: [string; 4],
    pub row_counts: [i32; 4],
    pub data: [i64; 256],
}

pub fn in_memory_db_new() -> InMemoryDB {
    InMemoryDB {
        table_count: 0,
        table_names: [""; 4],
        row_counts: [0; 4],
        data: [0; 256],
    }
}

pub fn db_cell_idx(t: i32, r: i32, c: i32) -> usize {
    (t * 64 + r * 4 + c) as usize
}
