// stdlib/database/ffi/fallback.sio — Fallback When FFI Unavailable
//
// When FFI bindings are not available (e.g., no compiled libsqlite3/libpq),
// this module provides graceful fallback to the pure Sounio in-memory engine.
// All public API functions have fallbacks here.

pub fn sqlite_available() -> bool { false }
pub fn postgres_available() -> bool { false }

pub fn use_fallback_engine() -> bool { true }

pub fn fallback_execute(sql: String) -> Result<ResultSet, String> {
    Err("FFI not available. Use pure Sounio in-memory engine.".to_string())
}