// stdlib/database/ffi/bindings.sio — FFI Bindings for SQLite3 and libpq
//
// FFI declarations for libsqlite3 and libpq (PostgreSQL).
// These are declarations only — actual linking happens at runtime via dlopen
// or at compile time when the library is available.
//
// References:
//   SQLite C API (sqlite.org/docs.html)
//   libpq Documentation (postgresql.org/docs/current/libpq.html)

extern "C" {
    // =============================================================================
    // SQLite3 C API
    // =============================================================================

    /// Opens a database file. Returns a database handle.
    /// flags: SQLITE_OPEN_READWRITE | SQLITE_OPEN_CREATE = 6
    fn sqlite3_open_v2(filename: *const u8, ppDb: *mut *mut SQLite3, flags: i32, zVfs: *const u8) -> i32

    /// Closes a database connection.
    fn sqlite3_close_v2(db: *mut SQLite3) -> i32

    /// Prepare a SQL statement for execution.
    fn sqlite3_prepare_v2(db: *mut SQLite3, zSql: *const u8, nByte: i32, ppStmt: *mut *mut SQLite3Stmt, pzTail: *mut *const u8) -> i32

    /// Execute a single SQL statement.
    fn sqlite3_exec(db: *mut SQLite3, sql: *const u8, callback: *const u8, pArg: *mut u8, errmsg: *mut *mut u8) -> i32

    /// Finalize (delete) a prepared statement.
    fn sqlite3_finalize(pStmt: *mut SQLite3Stmt) -> i32

    /// Reset a prepared statement.
    fn sqlite3_reset(pStmt: *mut SQLite3Stmt) -> i32

    /// Bind a text value to a parameter.
    fn sqlite3_bind_text(pStmt: *mut SQLite3Stmt, idx: i32, value: *const u8, len: i32, destructor: *const u8) -> i32

    /// Bind an integer value to a parameter.
    fn sqlite3_bind_int64(pStmt: *mut SQLite3Stmt, idx: i32, value: i64) -> i32

    /// Bind a double value to a parameter.
    fn sqlite3_bind_double(pStmt: *mut SQLite3Stmt, idx: i32, value: f64) -> i32

    /// Bind NULL to a parameter.
    fn sqlite3_bind_null(pStmt: *mut SQLite3Stmt, idx: i32) -> i32

    /// Number of columns in a result set.
    fn sqlite3_column_count(pStmt: *mut SQLite3Stmt) -> i32

    /// Column name in a result set.
    fn sqlite3_column_name(pStmt: *mut SQLite3Stmt, iCol: i32) -> *const u8

    /// Column type (SQLITE_INTEGER=1, SQLITE_FLOAT=2, SQLITE_TEXT=3, SQLITE_BLOB=4, SQLITE_NULL=5)
    fn sqlite3_column_type(pStmt: *mut SQLite3Stmt, iCol: i32) -> i32

    /// Get column value as integer.
    fn sqlite3_column_int64(pStmt: *mut SQLite3Stmt, iCol: i32) -> i64

    /// Get column value as double.
    fn sqlite3_column_double(pStmt: *mut SQLite3Stmt, iCol: i32) -> f64

    /// Get column value as text.
    fn sqlite3_column_text(pStmt: *mut SQLite3Stmt, iCol: i32) -> *const u8

    /// Get column value as blob.
    fn sqlite3_column_blob(pStmt: *mut SQLite3Stmt, iCol: i32) -> *const u8

    /// Get column value as blob size.
    fn sqlite3_column_bytes(pStmt: *mut SQLite3Stmt, iCol: i32) -> i32

    /// Number of rows modified/inserted/deleted.
    fn sqlite3_changes(db: *mut SQLite3) -> i32

    /// Last insert rowid.
    fn sqlite3_last_insert_rowid(db: *mut SQLite3) -> i64

    /// Get error message.
    fn sqlite3_errmsg(db: *mut SQLite3) -> *const u8

    /// Get error code.
    fn sqlite3_errcode(db: *mut SQLite3) -> i32

    /// Extended error codes.
    fn sqlite3_extended_errcode(db: *mut SQLite3) -> i32

    /// Test if a prepared statement has been stepped.
    fn sqlite3_stmt_busy(pStmt: *mut SQLite3Stmt) -> i32

    /// Total number of rows modified across all queries.
    fn sqlite3_total_changes(db: *mut SQLite3) -> i32

    // =============================================================================
    // libpq (PostgreSQL) C API
    // =============================================================================

    /// Connect to a PostgreSQL server.
    fn PQconnectdb(conninfo: *const u8) -> *mut PGconn

    /// Close the connection and free memory.
    fn PQfinish(conn: *mut PGconn) -> void

    /// Execute a query.
    fn PQexec(conn: *mut PGconn, query: *const u8) -> *mut PGresult

    /// Execute a query with parameters.
    fn PQexecParams(conn: *mut PGconn, command: *const u8, nParams: i32, paramTypes: *const i32, paramValues: *const *const u8, paramLengths: *const i32, paramFormats: *const i32, resultFormat: i32) -> *mut PGresult

    /// Get the connection status.
    fn PQstatus(conn: *mut PGconn) -> i32

    /// Get the result status.
    fn PQresultStatus(res: *mut PGresult) -> i32

    /// Get the number of rows in the result.
    fn PQntuples(res: *mut PGresult) -> i32

    /// Get the number of columns in the result.
    fn PQnfields(res: *mut PGresult) -> i32

    /// Get the error message.
    fn PQerrorMessage(conn: *mut PGconn) -> *const u8

    /// Get a single field value.
    fn PQgetvalue(res: *mut PGresult, row: i32, col: i32) -> *const u8

    /// Get the length of a field value.
    fn PQgetlength(res: *mut PGresult, row: i32, col: i32) -> i32

    /// Get the field type OID.
    fn PQftype(res: *mut PGresult, col: i32) -> u32

    /// Check if field is NULL.
    fn PQgetisnull(res: *mut PGresult, row: i32, col: i32) -> i32

    /// Clear a query result.
    fn PQclear(res: *mut PGresult) -> void

    /// Escape a string for use as a identifier.
    fn PQescapeIdentifier(conn: *mut PGconn, str: *const u8, len: i32) -> *mut u8

    /// Free memory allocated by PQescapeIdentifier.
    fn PQfreemem(addr: *mut u8) -> void
}

// SQLite3 constants
let SQLITE_OK: i32 = 0
let SQLITE_ERROR: i32 = 1
let SQLITE_BUSY: i32 = 5
let SQLITE_MISUSE: i32 = 21

let SQLITE_OPEN_READWRITE: i32 = 2
let SQLITE_OPEN_CREATE: i32 = 4
let SQLITE_OPEN_FULLMUTEX: i32 = 65536

let SQLITE_INTEGER: i32 = 1
let SQLITE_FLOAT: i32 = 2
let SQLITE_TEXT: i32 = 3
let SQLITE_BLOB: i32 = 4
let SQLITE_NULL: i32 = 5

// PostgreSQL constants
let CONNECTION_OK: i32 = 0
let CONNECTION_BAD: i32 = 1
let PGRES_TUPLES_OK: i32 = 2
let PGRES_COMMAND_OK: i32 = 1
let PGRES_EMPTY_QUERY: i32 = 0
let PGRES_BAD_RESPONSE: i32 = 3
let PGRES_NONFATAL_ERROR: i32 = 4
let PGRES_FATAL_ERROR: i32 = 5

struct SQLite3 { _private: [u8; 0] }
struct SQLite3Stmt { _private: [u8; 0] }
struct PGconn { _private: [u8; 0] }
struct PGresult { _private: [u8; 0] }
struct void {}

// Check if SQLite3 is available at runtime
pub fn sqlite3_available() -> bool { false }
pub fn libpq_available() -> bool { false }