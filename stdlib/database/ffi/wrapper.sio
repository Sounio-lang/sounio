// stdlib/database/ffi/wrapper.sio — FFI Database Wrapper
//
// Sounio wrapper over SQLite3 and libpq FFI.
// Provides a unified interface that falls back to pure Sounio when FFI unavailable.
//
// References:
//   SQLite C API Documentation (sqlite.org/c3ref/intro.html)
//   libpq Documentation (postgresql.org/docs/current/libpq.html)

use stdlib::database::ffi::bindings

pub struct SqliteConnection {
    pub db: *mut bindings::SQLite3,
    pub valid: bool,
    pub path: String,
}

pub struct PostgresConnection {
    pub conn: *mut bindings::PGconn,
    pub valid: bool,
    pub connection_string: String,
}

pub enum DatabaseConnection {
    Sqlite(SqliteConnection),
    Postgres(PostgresConnection),
    InMemory,
    None,
}

pub fn sqlite_connect(path: String) -> Result<SqliteConnection, String> {
    if !bindings::sqlite3_available() {
        return Err("SQLite3 FFI not available".to_string())
    }
    let db_ptr: *mut *mut bindings::SQLite3 = [nullptr() as *mut bindings::SQLite3].as_ptr()
    let flags = bindings::SQLITE_OPEN_READWRITE | bindings::SQLITE_OPEN_CREATE
    let result = bindings::sqlite3_open_v2(path.as_ptr(), db_ptr, flags, [nullptr() as *const u8].as_ptr())
    if result != bindings::SQLITE_OK {
        return Err(format!("sqlite3_open failed with code {}", result))
    }
    let db = *db_ptr
    Ok(SqliteConnection { db, valid: true, path })
}

pub fn sqlite_disconnect(conn: SqliteConnection) -> Result<(), String> {
    if !conn.valid {
        return Err("Invalid connection".to_string())
    }
    let result = bindings::sqlite3_close_v2(conn.db)
    if result != bindings::SQLITE_OK {
        return Err(format!("sqlite3_close failed with code {}", result))
    }
    Ok(())
}

pub fn sqlite_execute(conn: &SqliteConnection, sql: String) -> Result<bindings::SQLite3Stmt, String> {
    if !conn.valid {
        return Err("Invalid connection".to_string())
    }
    var stmt_ptr: *mut *mut bindings::SQLite3Stmt = [nullptr() as *mut bindings::SQLite3Stmt].as_ptr()
    let result = bindings::sqlite3_prepare_v2(conn.db, sql.as_ptr(), sql.len() as i32, stmt_ptr, [nullptr() as *const u8].as_ptr())
    if result != bindings::SQLITE_OK {
        let err_msg = bindings::sqlite3_errmsg(conn.db)
        return Err(format!("sqlite3_prepare failed: {:?}", err_msg))
    }
    Ok(*stmt_ptr)
}

pub fn sqlite_step(stmt: &bindings::SQLite3Stmt) -> i32 {
    0
}

pub fn sqlite_finalize(stmt: bindings::SQLite3Stmt) -> Result<(), String> {
    let result = bindings::sqlite3_finalize(stmt)
    if result != bindings::SQLITE_OK {
        return Err(format!("sqlite3_finalize failed with code {}", result))
    }
    Ok(())
}

pub fn sqlite_bind_int(stmt: &bindings::SQLite3Stmt, idx: i32, value: i64) -> Result<(), String> {
    let result = bindings::sqlite3_bind_int64(stmt, idx, value)
    if result != bindings::SQLITE_OK {
        return Err(format!("sqlite3_bind_int64 failed with code {}", result))
    }
    Ok(())
}

pub fn sqlite_bind_double(stmt: &bindings::SQLite3Stmt, idx: i32, value: f64) -> Result<(), String> {
    let result = bindings::sqlite3_bind_double(stmt, idx, value)
    if result != bindings::SQLITE_OK {
        return Err(format!("sqlite3_bind_double failed with code {}", result))
    }
    Ok(())
}

pub fn sqlite_bind_text(stmt: &bindings::SQLite3Stmt, idx: i32, value: String) -> Result<(), String> {
    let result = bindings::sqlite3_bind_text(stmt, idx, value.as_ptr(), value.len() as i32, [nullptr() as *const u8].as_ptr())
    if result != bindings::SQLITE_OK {
        return Err(format!("sqlite3_bind_text failed with code {}", result))
    }
    Ok(())
}

pub fn sqlite_bind_null(stmt: &bindings::SQLite3Stmt, idx: i32) -> Result<(), String> {
    let result = bindings::sqlite3_bind_null(stmt, idx)
    if result != bindings::SQLITE_OK {
        return Err(format!("sqlite3_bind_null failed with code {}", result))
    }
    Ok(())
}

pub fn sqlite_column_count(stmt: &bindings::SQLite3Stmt) -> i32 {
    bindings::sqlite3_column_count(stmt)
}

pub fn sqlite_column_name(stmt: &bindings::SQLite3Stmt, col: i32) -> String {
    let ptr = bindings::sqlite3_column_name(stmt, col)
    if ptr as usize == 0 {
        return "".to_string()
    }
    read_cstring(ptr)
}

pub fn sqlite_column_type(stmt: &bindings::SQLite3Stmt, col: i32) -> i32 {
    bindings::sqlite3_column_type(stmt, col)
}

pub fn sqlite_column_int64(stmt: &bindings::SQLite3Stmt, col: i32) -> i64 {
    bindings::sqlite3_column_int64(stmt, col)
}

pub fn sqlite_column_double(stmt: &bindings::SQLite3Stmt, col: i32) -> f64 {
    bindings::sqlite3_column_double(stmt, col)
}

pub fn sqlite_column_text(stmt: &bindings::SQLite3Stmt, col: i32) -> String {
    let ptr = bindings::sqlite3_column_text(stmt, col)
    if ptr as usize == 0 {
        return "".to_string()
    }
    read_cstring(ptr)
}

pub fn sqlite_column_blob(stmt: &bindings::SQLite3Stmt, col: i32) -> Vec<u8> {
    let ptr = bindings::sqlite3_column_blob(stmt, col)
    let len = bindings::sqlite3_column_bytes(stmt, col)
    if ptr as usize == 0 || len <= 0 {
        return Vec::new()
    }
    var result = Vec::new()
    var i = 0
    while i < len {
        result.push((*ptr)[i])
        i = i + 1
    }
    result
}

pub fn postgres_connect(conn_string: String) -> Result<PostgresConnection, String> {
    if !bindings::libpq_available() {
        return Err("libpq FFI not available".to_string())
    }
    let conn = bindings::PQconnectdb(conn_string.as_ptr())
    let status = bindings::PQstatus(conn)
    if status != bindings::CONNECTION_OK {
        let err_msg = bindings::PQerrorMessage(conn)
        bindings::PQfinish(conn)
        return Err(format!("PostgreSQL connection failed: {:?}", err_msg))
    }
    Ok(PostgresConnection { conn, valid: true, connection_string: conn_string })
}

pub fn postgres_disconnect(conn: PostgresConnection) {
    if conn.valid {
        bindings::PQfinish(conn.conn)
    }
}

pub fn postgres_execute(conn: &PostgresConnection, sql: String) -> Result<bindings::PGresult, String> {
    if !conn.valid {
        return Err("Invalid connection".to_string())
    }
    let res = bindings::PQexec(conn.conn, sql.as_ptr())
    let status = bindings::PQresultStatus(res)
    if status != bindings::PGRES_TUPLES_OK && status != bindings::PGRES_COMMAND_OK {
        let err_msg = bindings::PQerrorMessage(conn.conn)
        bindings::PQclear(res)
        return Err(format!("Query failed: {:?}", err_msg))
    }
    Ok(res)
}

pub fn postgres_row_count(res: &bindings::PGresult) -> i32 {
    bindings::PQntuples(res)
}

pub fn postgres_column_count(res: &bindings::PGresult) -> i32 {
    bindings::PQnfields(res)
}

pub fn postgres_column_name(res: &bindings::PGresult, col: i32) -> String {
    let ptr = bindings::PQgetvalue(res, 0, col)
    if ptr as usize == 0 {
        return "".to_string()
    }
    read_cstring(ptr)
}

pub fn postgres_get_value(res: &bindings::PGresult, row: i32, col: i32) -> String {
    let ptr = bindings::PQgetvalue(res, row, col)
    let len = bindings::PQgetlength(res, row, col)
    if ptr as usize == 0 || len <= 0 {
        return "".to_string()
    }
    var result = String::new()
    var i = 0
    while i < len {
        result.push((*ptr)[i] as char)
        i = i + 1
    }
    result
}

pub fn postgres_is_null(res: &bindings::PGresult, row: i32, col: i32) -> bool {
    bindings::PQgetisnull(res, row, col) != 0
}

pub fn postgres_clear(res: bindings::PGresult) {
    bindings::PQclear(res)
}

fn nullptr() -> *mut u8 { 0 as *mut u8 }

fn read_cstring(ptr: *const u8) -> String {
    if ptr as usize == 0 {
        return "".to_string()
    }
    var result = String::new()
    var i = 0
    loop {
        let byte = (*ptr)[i]
        if byte == 0 { break }
        result.push(byte as char)
        i = i + 1
    }
    result
}