pub struct CountPipelineWorkspace {pub status:i64,pub genes:i64,pub samples:i64,pub columns:i64,pub numeric_elements:i64,pub integer_elements:i64,pub payload_bytes:i64}
fn cp_add(a:i64,b:i64)->i64 {if a<0 || b<0 || b>1152921504606846463-a {return -1};a+b}
fn cp_workspace(g:i64,n:i64,p:i64,method:i64,local_normalization:bool)->CountPipelineWorkspace with Mut,Div {
 let bad=CountPipelineWorkspace{status:1,genes:g,samples:n,columns:p,numeric_elements:0,integer_elements:0,payload_bytes:0}
 if g<3 || g>1000000 || n<2 || n>1000000 || p<1 || p>=n || p>1024 {return bad}
 let norm=dynamic_median_ratio_size_factors_workspace(g,n)
 let dp=dynamic_dispersion_workspace(n,p,method)
 let fw=dynamic_count_fisher_workspace(n,p)
 let sh=dispersion_shrinkage_workspace(g)
 if norm.status!=0 || dp.status!=0 || fw.status!=0 || sh.status!=0 {return bad}
 var numeric:i64=0
 numeric=cp_add(numeric,n*p)
 numeric=cp_add(numeric,n)
 numeric=cp_add(numeric,p)
 numeric=cp_add(numeric,p)
 numeric=cp_add(numeric,n)
 numeric=cp_add(numeric,n)
 numeric=cp_add(numeric,if local_normalization {norm.numeric_elements}else{0})
 numeric=cp_add(numeric,dp.count_design_elements)
 numeric=cp_add(numeric,n)
 numeric=cp_add(numeric,p)
 numeric=cp_add(numeric,dp.qr_elements)
 numeric=cp_add(numeric,dp.count_stage_elements)
 numeric=cp_add(numeric,p)
 numeric=cp_add(numeric,n)
 numeric=cp_add(numeric,n)
 numeric=cp_add(numeric,p)
 numeric=cp_add(numeric,n)
 numeric=cp_add(numeric,n)
 numeric=cp_add(numeric,p)
 numeric=cp_add(numeric,n)
 numeric=cp_add(numeric,n)
 numeric=cp_add(numeric,dp.factor_r_elements)
 numeric=cp_add(numeric,dp.factor_scale_elements)
 numeric=cp_add(numeric,fw.square_elements)
 numeric=cp_add(numeric,p)
 numeric=cp_add(numeric,fw.square_elements)
 numeric=cp_add(numeric,p)
 numeric=cp_add(numeric,p)
 numeric=cp_add(numeric,p)
 numeric=cp_add(numeric,fw.square_elements)
 numeric=cp_add(numeric,fw.square_elements)
 numeric=cp_add(numeric,g)
 numeric=cp_add(numeric,g)
 numeric=cp_add(numeric,g)
 numeric=cp_add(numeric,g)
 numeric=cp_add(numeric,g)
 numeric=cp_add(numeric,g)
 numeric=cp_add(numeric,sh.jacobian_elements)
 numeric=cp_add(numeric,sh.response_elements)
 numeric=cp_add(numeric,sh.increment_elements)
 numeric=cp_add(numeric,sh.qr_elements)
 numeric=cp_add(numeric,sh.stage_elements)
 numeric=cp_add(numeric,g*24)
 numeric=cp_add(numeric,g*p)
 numeric=cp_add(numeric,g*p)
 numeric=cp_add(numeric,g)
 numeric=cp_add(numeric,g)
 numeric=cp_add(numeric,g)
 numeric=cp_add(numeric,g)
 var integer:i64=0
 integer=cp_add(integer,n)
 integer=cp_add(integer,if local_normalization {norm.integer_elements}else{0})
 integer=cp_add(integer,n)
 integer=cp_add(integer,n)
 integer=cp_add(integer,dp.permutation_elements)
 integer=cp_add(integer,p)
 integer=cp_add(integer,g)
 integer=cp_add(integer,g*12)
 integer=cp_add(integer,g)
 integer=cp_add(integer,g)
 let total=cp_add(numeric,integer)
 if total<0 {return bad}
 CountPipelineWorkspace{status:0,genes:g,samples:n,columns:p,numeric_elements:numeric,integer_elements:integer,payload_bytes:total*8}
}
// Global query omits only normalization work and anchors; transferred inputs excluded.
pub fn count_pipeline_workspace(g:i64,n:i64,p:i64,method:i64)->CountPipelineWorkspace with Mut,Div {cp_workspace(g,n,p,method,true)}
pub fn count_pipeline_workspace_global(g:i64,n:i64,p:i64,method:i64)->CountPipelineWorkspace with Mut,Div {cp_workspace(g,n,p,method,false)}
