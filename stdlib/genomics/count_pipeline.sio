pub fn count_pipeline_new(csr:CountCSR,gene_ids:CountIdentities,sample_ids:CountIdentities,p:i64,options:DispersionSearchOptions,max_bytes:i64)->CountPipeline with Alloc,Mut,Div,Panic {cp_new(csr,gene_ids,sample_ids,p,options,max_bytes,true)}
pub fn count_pipeline_new_global(csr:CountCSR,gene_ids:CountIdentities,sample_ids:CountIdentities,p:i64,options:DispersionSearchOptions,max_bytes:i64)->CountPipeline with Alloc,Mut,Div,Panic {cp_new(csr,gene_ids,sample_ids,p,options,max_bytes,false)}
// Preparation joins sample byte IDs explicitly; no positional fallback.
// Metadata design is row-major. exposure is a supplied log offset in metadata order.
// Initial coefficients and contrast are explicit; no inferred intercept.
fn cp_prepare_inputs(w:&!CountPipeline,metadata_ids:&CountIdentities,
 design:&NumericBuffer,log_exposure:&NumericBuffer,initial:&NumericBuffer,contrast:&NumericBuffer,
 join_byte_budget:i64)->i64 with Mut,Div,Panic {
 if w.status!=0 || w.phase!=0 {return 1}
 let n=w.n;let p=w.p
 if numeric_buffer_status(design)!=0 || numeric_buffer_status(log_exposure)!=0 ||
 numeric_buffer_status(initial)!=0 || numeric_buffer_status(contrast)!=0 ||
 numeric_buffer_len(design)!=n*p || numeric_buffer_len(log_exposure)!=n ||
 numeric_buffer_len(initial)!=p || numeric_buffer_len(contrast)!=p || count_identities_count(metadata_ids)!=n {return 2}
 if join_byte_budget<0 || join_byte_budget>9223372036854775807-w.join_comparisons {return 2}
 var i:i64=0
 while i<n*p {if !is_finite(numeric_buffer_at(design,i)) {return 3};i=i+1}
 i=0;while i<n {if !is_finite(numeric_buffer_at(log_exposure,i)) {return 3};i=i+1}
 i=0;while i<p {if !is_finite(numeric_buffer_at(initial,i)) || !is_finite(numeric_buffer_at(contrast,i)) {return 3};i=i+1}
 let joined=count_identities_join_into(&w.sample_ids,metadata_ids,0,join_byte_budget,&!w.join_stage,&!w.join_order)
 w.join_comparisons=w.join_comparisons+joined.comparisons
 if joined.status!=0 {return 10+joined.status}
 0
}
fn cp_prepare_finish(w:&!CountPipeline,design:&NumericBuffer,log_exposure:&NumericBuffer,initial:&NumericBuffer,contrast:&NumericBuffer,normalization_mode:i64,model_declared:bool,independence_declared:bool)->i64 with Mut,Div,Panic {
 let n=w.n;let p=w.p
 var i:i64=0
 while i<n {
  let from=integer_buffer_at(&w.join_order,i)
  let combined=numeric_buffer_at(log_exposure,from)+numeric_buffer_at(&w.norm_logs,i)
  let exposure=exp(combined)
  if !is_finite(combined) || !is_finite(exposure) || exposure<=0.0 {return 4}
  numeric_buffer_set(&!w.offsets,i,combined)
  var j:i64=0;while j<p {numeric_buffer_set(&!w.design,i*p+j,numeric_buffer_at(design,from*p+j));j=j+1}
  i=i+1
 }
 i=0;while i<p {numeric_buffer_set(&!w.initial,i,numeric_buffer_at(initial,i));numeric_buffer_set(&!w.contrast,i,numeric_buffer_at(contrast,i));i=i+1}
 w.normalization_mode=normalization_mode;w.model_declared=model_declared;w.independence_declared=independence_declared
 w.phase=1;0
}
pub fn count_pipeline_prepare(w:&!CountPipeline,metadata_ids:&CountIdentities,
 design:&NumericBuffer,log_exposure:&NumericBuffer,initial:&NumericBuffer,contrast:&NumericBuffer,
 normalization_mode:i64,join_byte_budget:i64,model_declared:bool,independence_declared:bool)->i64 with Mut,Div,Panic {
 if w.status!=0 || w.phase!=0 || w.normalization_scope!=0 {return 1}
 if normalization_mode<0 || normalization_mode>1 {return 2}
 let ready=cp_prepare_inputs(w,metadata_ids,design,log_exposure,initial,contrast,join_byte_budget)
 if ready!=0 {return ready}
 let normalized=count_csr_size_factors_into(&w.csr,normalization_mode,&!w.factors,&!w.norm_logs,&!w.norm_work,&!w.norm_anchors,&!w.normalization)
 if normalized!=0 {return 20+normalized}
 w.reference_genes=w.g;w.normalization_used=dynamic_size_factors_slot_genes_used(&w.normalization);w.normalization_excluded=dynamic_size_factors_slot_genes_excluded(&w.normalization)
 cp_prepare_finish(w,design,log_exposure,initial,contrast,normalization_mode,model_declared,independence_declared)
}
// The per-call byte budget is shared by metadata and normalization cohort joins.
// No factor/offset getter is available until the final phase1 publication.
pub fn count_pipeline_prepare_global(w:&!CountPipeline,normalization:&CountNormalization,metadata_ids:&CountIdentities,
 design:&NumericBuffer,log_exposure:&NumericBuffer,initial:&NumericBuffer,contrast:&NumericBuffer,
 join_byte_budget:i64,model_declared:bool,independence_declared:bool)->i64 with Mut,Div,Panic {
 if w.status!=0 || w.phase!=0 || w.normalization_scope!=1 {return 1}
 if count_normalization_status(normalization)!=0 {return 2}
 let before=w.join_comparisons
 let ready=cp_prepare_inputs(w,metadata_ids,design,log_exposure,initial,contrast,join_byte_budget)
 if ready!=0 {return ready}
 let remaining=join_byte_budget-(w.join_comparisons-before)
 let joined=count_normalization_join_into(normalization,&w.sample_ids,remaining,&!w.join_stage,&!w.counts)
 w.join_comparisons=w.join_comparisons+joined.comparisons
 if joined.status!=0 {return 30+joined.status}
 var i:i64=0
 while i<w.n {
  let from=integer_buffer_at(&w.counts,i)
  numeric_buffer_set(&!w.factors,i,count_normalization_factor(normalization,from))
  numeric_buffer_set(&!w.norm_logs,i,count_normalization_log(normalization,from));i=i+1
 }
 w.reference_genes=count_normalization_reference_genes(normalization)
 w.normalization_used=count_normalization_used(normalization);w.normalization_excluded=count_normalization_excluded(normalization)
 cp_prepare_finish(w,design,log_exposure,initial,contrast,count_normalization_mode(normalization),model_declared,independence_declared)
}
fn cp_load(w:&!CountPipeline,row:i64)->i64 with Mut,Div,Panic {
 var i:i64=0
 while i<w.n {integer_buffer_set(&!w.counts,i,0);i=i+1}
 let end=count_csr_row_start(&w.csr,row+1)
 i=count_csr_row_start(&w.csr,row)
 while i<end {
  let value=count_csr_stored_value(&w.csr,i)
  if value>9007199254740992 {return 5}
  integer_buffer_set(&!w.counts,count_csr_column(&w.csr,i),value);i=i+1
 }
 var mean:f64=0.0;var correction:f64=0.0;i=0
 while i<w.n {
  let y=integer_buffer_at(&w.counts,i)
  let term=((y as f64)/exp(numeric_buffer_at(&w.offsets,i)))/(w.n as f64)
  if !is_finite(term) || (y>0 && term==0.0) {return 4}
  let adjusted=term-correction;let next=mean+adjusted
  correction=(next-mean)-adjusted;mean=next;i=i+1
 }
 if !is_finite(mean) {return 4}
 cp_set(w,row,0,mean);0
}
fn cp_profile(w:&!CountPipeline,options:&DispersionSearchOptions)->DynamicDispersionFit with Mut,Div,Panic {
 dynamic_dispersion_fit(&w.design,&w.layout,&w.counts,&w.offsets,&w.initial,options,
 &!w.coefficients,&!w.means,&!w.eta,&!w.candidate_coefficients,&!w.candidate_means,&!w.candidate_eta,
 &!w.best_coefficients,&!w.best_means,&!w.best_eta,&!w.weighted,&!w.response,&!w.step,&!w.qr,&!w.count_stage,
 &!w.profile_r,&!w.profile_scales,&!w.profile_permutation)
}
fn cp_profile_seeded(w:&!CountPipeline,options:&DispersionSearchOptions,seed_alpha:f64)->DynamicDispersionFit with Mut,Div,Panic {
 dynamic_dispersion_fit_seeded(&w.design,&w.layout,&w.counts,&w.offsets,&w.initial,options,
 &!w.coefficients,&!w.means,&!w.eta,&!w.candidate_coefficients,&!w.candidate_means,&!w.candidate_eta,
 &!w.best_coefficients,&!w.best_means,&!w.best_eta,&!w.weighted,&!w.response,&!w.step,&!w.qr,&!w.count_stage,
 &!w.profile_r,&!w.profile_scales,&!w.profile_permutation,seed_alpha)
}
// A batch advances at most max_genes consecutive rows. Failures remain in place.
// Stored options are immutable; completed rows are never silently re-evaluated.
fn cp_point_batch(w:&!CountPipeline,max_genes:i64,seeded:bool,seed_alpha:f64)->i64 with Mut,Div,Panic {
 if w.status!=0 || w.phase!=1 || max_genes<1 {return 1}
 if seeded {
  if w.options.method!=0 || w.options.compute_curvature || !is_finite(seed_alpha) || seed_alpha<0.0 {return 1}
  if seed_alpha>0.0 {if seed_alpha<exp(w.options.log_alpha_lower) || seed_alpha>exp(w.options.log_alpha_upper) {return 1}}
 }
 var spent:i64=0
 while w.point_next<w.g && spent<max_genes {
  let row=w.point_next
  let loaded=cp_load(w,row)
  if loaded!=0 {cp_mark(w,row,0,100+loaded)}
  else {
   let options=w.options
   let fitted=if seeded {cp_profile_seeded(w,&options,seed_alpha)}else{cp_profile(w,&options)}
   w.point_evaluations=w.point_evaluations+fitted.evaluations
   cp_mark(w,row,0,fitted.status);cp_mark(w,row,1,fitted.profile_status)
   cp_mark(w,row,2,fitted.evaluations);cp_mark(w,row,3,fitted.curvature_status)
   cp_set(w,row,20,if fitted.left_censored {1.0}else{0.0});cp_set(w,row,21,if fitted.right_censored {1.0}else{0.0})
   cp_set(w,row,22,fitted.curvature_h);cp_set(w,row,23,fitted.curvature_half_h)
   if fitted.status==0 && fitted.point_available {
    cp_set(w,row,1,fitted.alpha);cp_set(w,row,2,fitted.log_alpha)
    cp_set(w,row,3,fitted.objective_mean);cp_set(w,row,4,fitted.full_log_likelihood_mean)
    var j:i64=0;while j<w.p {numeric_buffer_set(&!w.point_beta,row*w.p+j,numeric_buffer_at(&w.coefficients,j));j=j+1}
    cp_mark(w,row,4,0)
    if fitted.local_curvature_available && fitted.alpha>0.0 && fitted.log_alpha_available &&
     fitted.log_alpha_variance>0.0 && is_finite(fitted.log_alpha_variance) && cp_v(w,row,0)>0.0 &&
     !fitted.left_censored && !fitted.right_censored && !fitted.boundary_candidate {
     let k=w.eligible
     numeric_buffer_set(&!w.training_means,k,cp_v(w,row,0))
     numeric_buffer_set(&!w.training_alpha,k,fitted.alpha)
     numeric_buffer_set(&!w.training_variance,k,fitted.log_alpha_variance)
     integer_buffer_set(&!w.eligible_rows,k,row)
     cp_set(w,row,5,fitted.log_alpha_variance);cp_mark(w,row,4,1);w.eligible=k+1
    }
   }
  }
  w.point_next=row+1;spent=spent+1
 }
 if w.point_next==w.g {w.phase=2}
 0
}
pub fn count_pipeline_point_batch(w:&!CountPipeline,max_genes:i64)->i64 with Mut,Div,Panic {cp_point_batch(w,max_genes,false,0.0)}
// Explicit opt-in to the existing seeded ML/warm-start numerical algorithm.
// Only point-only ML (compute_curvature=false); the seed is not an accepted fit.
// Canonical search still evaluates all candidates and reports actual evaluations.
pub fn count_pipeline_point_batch_seeded(w:&!CountPipeline,max_genes:i64,seed_alpha:f64)->i64 with Mut,Div,Panic {cp_point_batch(w,max_genes,true,seed_alpha)}
// The Gaussian component estimates only a working log-dispersion prior.
// All numerically eligible rows participate; no silent trim or pseudo-variance floor.
pub fn count_pipeline_shrink(w:&!CountPipeline,a0:f64,a1:f64,rcond:f64,
 max_iterations:i64,tolerance:f64,outlier_sigma:f64)->i64 with Mut,Div,Panic {
 if w.status!=0 || w.phase!=2 {return 1}
 if w.eligible<3 {w.prior_status=8;w.phase=3;return 8}
 let fitted=dispersion_shrinkage_fit_prefix(&w.training_means,&w.training_alpha,&w.training_variance,w.eligible,
 a0,a1,rcond,max_iterations,tolerance,outlier_sigma,&!w.mapped_log,&!w.mapped_variance,&!w.outlier_flags,
 &!w.jacobian,&!w.shrink_response,&!w.increment,&!w.shrink_qr,&!w.shrink_stage)
 w.prior_status=fitted.status
 if fitted.status==0 {
  w.prior_a0=fitted.a0;w.prior_a1=fitted.a1;w.prior_variance=fitted.prior_log_variance
  var k:i64=0
  while k<w.eligible {
   let row=integer_buffer_at(&w.eligible_rows,k)
   cp_set(w,row,6,numeric_buffer_at(&w.mapped_log,k));cp_set(w,row,7,numeric_buffer_at(&w.mapped_variance,k))
   cp_mark(w,row,10,if numeric_buffer_at(&w.outlier_flags,k)>0.0 {1}else{0})
   // Compute the same positive trend a0+a1/mean; refusal if this representation fails.
   let trend=fitted.a0+fitted.a1/cp_v(w,row,0)
   ln_checked_into(trend,&!w.log_work)
   if w.log_work.status!=0 || !is_finite(trend) || trend<=0.0 {cp_mark(w,row,4,2)}
   else {cp_set(w,row,8,w.log_work.value)}
   k=k+1
  }
 }
 w.phase=3;fitted.status
}
fn cp_infer(w:&!CountPipeline,row:i64,alpha:f64,tail_budget:i64,tail_tolerance:f64) with Mut,Div,Panic {
 let options=w.options
 let fisher=dynamic_count_fit_fisher(&w.design,&w.layout,&w.counts,&w.offsets,&w.initial,
 alpha,true,w.model_declared,w.independence_declared,options.rcond,options.inner_iterations,options.inner_tolerance,
 &!w.coefficients,&!w.means,&!w.eta,&!w.covariance,&!w.standard_errors,&!w.weighted,&!w.response,&!w.step,
 &!w.qr,&!w.count_stage,&!w.fisher_r,&!w.fisher_scales,&!w.fisher_permutation,&!w.outer_scales,&!w.solve,&!w.influences,&!w.covariance_stage)
 cp_mark(w,row,7,fisher.covariance_status)
 if fisher.fit.status!=0 {cp_mark(w,row,5,200+fisher.fit.status);return}
 var j:i64=0;while j<w.p {numeric_buffer_set(&!w.final_beta,row*w.p+j,numeric_buffer_at(&w.coefficients,j));j=j+1}
 let contrast=dynamic_count_fisher_contrast(&fisher,&w.coefficients,&w.contrast,&w.fisher_r,&w.fisher_scales,&w.fisher_permutation,&w.outer_scales,&!w.solve)
 cp_mark(w,row,8,contrast.status)
 if contrast.status!=0 {return}
 cp_set(w,row,13,contrast.estimate);cp_set(w,row,14,contrast.standard_error)
 if !w.model_declared || !w.independence_declared {cp_mark(w,row,9,6);return}
 if !is_finite(contrast.standard_error) || contrast.standard_error<=0.0 {cp_mark(w,row,9,4);return}
 let z=contrast.estimate/contrast.standard_error
 let squared=(z*0.5)*z
 if !is_finite(z) || !is_finite(squared) || (z!=0.0 && squared<2.2250738585072014e-308) {cp_mark(w,row,9,4);return}
 cp_set(w,row,15,z)
 let tail=gamma_pq_checked(0.5,squared,tail_budget,tail_tolerance)
 w.tail_iterations=w.tail_iterations+tail.iterations;cp_mark(w,row,9,tail.status)
 if tail.status!=0 {return}
 if tail.upper_available {numeric_buffer_set(&!w.pvalues,row,tail.upper);cp_set(w,row,16,tail.upper);cp_set(w,row,18,1.0);integer_buffer_set(&!w.available,row,1)}
 if tail.log_upper_available {cp_set(w,row,17,tail.log_upper);cp_set(w,row,19,1.0)}
}
// Positive working prior -> actual penalized NB2/Cox-Reid log-alpha profile.
// Boundary tau2=0 -> fixed point prior alpha=trend. High outlier -> unshrunk point alpha.
// Noneligible rows and unavailable prior/refit/tests retain their IDs and p=1 family slot.
pub fn count_pipeline_refit_batch(w:&!CountPipeline,max_genes:i64,tail_budget:i64,tail_tolerance:f64)->i64 with Mut,Div,Panic {
 if w.status!=0 || w.phase!=3 || max_genes<1 || tail_budget<1 || tail_budget>1000000 ||
 !is_finite(tail_tolerance) || tail_tolerance<1.7763568394002505e-15 || tail_tolerance>1e-4 {return 1}
 var spent:i64=0
 while w.refit_next<w.g && spent<max_genes {
  let row=w.refit_next
  if w.prior_status!=0 || cp_m(w,row,4)!=1 {cp_mark(w,row,5,300)}
  else {
   let loaded=cp_load(w,row)
   if loaded!=0 {cp_mark(w,row,5,100+loaded)}
   else {
    var alpha=cp_v(w,row,1)
    var ready=true
    if cp_m(w,row,10)==1 {cp_mark(w,row,11,3);cp_mark(w,row,5,0)}
    else if w.prior_variance==0.0 {alpha=exp(cp_v(w,row,8));cp_mark(w,row,11,2);cp_mark(w,row,5,0)}
    else {
     var options=w.options
     options.prior_active=true;options.prior_center=cp_v(w,row,8);options.prior_variance=w.prior_variance;options.compute_curvature=false
     let fitted=cp_profile(w,&options)
     w.refit_evaluations=w.refit_evaluations+fitted.evaluations
     cp_mark(w,row,11,1);cp_mark(w,row,5,fitted.status);cp_mark(w,row,6,fitted.evaluations)
     if fitted.status!=0 || !fitted.point_available {ready=false}
     else if fitted.left_censored || fitted.right_censored || fitted.boundary_candidate {cp_mark(w,row,5,301);ready=false}
     else {alpha=fitted.alpha;cp_set(w,row,11,fitted.objective_mean);cp_set(w,row,12,fitted.full_log_likelihood_mean)}
    }
    if ready {
     if !is_finite(alpha) || alpha<=0.0 {cp_mark(w,row,5,4)}
     else {
      ln_checked_into(alpha,&!w.log_work)
      if w.log_work.status!=0 {cp_mark(w,row,5,4)}
      else {cp_set(w,row,9,alpha);cp_set(w,row,10,w.log_work.value);cp_infer(w,row,alpha,tail_budget,tail_tolerance)}
     }
    }
   }
  }
  w.refit_next=row+1;spent=spent+1
 }
 if w.refit_next==w.g {w.phase=4}
 0
}
pub fn count_pipeline_adjust(w:&!CountPipeline)->i64 with Mut,Div,Panic {
 if w.status!=0 || w.phase!=4 {return 1}
 let bh=dynamic_adjust_pvalues(&w.pvalues,&w.available,w.g,1,&!w.bh,&!w.adjust_indices,&!w.adjust_stage)
 if bh.status!=0 {return bh.status}
 let by=dynamic_adjust_by(&w.pvalues,&w.available,w.g,&!w.by,&!w.adjust_indices,&!w.adjust_stage)
 if by.status!=0 {return by.status}
 w.phase=5;0
}
pub fn count_pipeline_status(w:&CountPipeline)->i64 {w.status}
pub fn count_pipeline_phase(w:&CountPipeline)->i64 {w.phase}
pub fn count_pipeline_genes(w:&CountPipeline)->i64 {w.g}
pub fn count_pipeline_samples(w:&CountPipeline)->i64 {w.n}
pub fn count_pipeline_columns(w:&CountPipeline)->i64 {w.p}
pub fn count_pipeline_point_done(w:&CountPipeline)->i64 {w.point_next}
pub fn count_pipeline_refit_done(w:&CountPipeline)->i64 {w.refit_next}
pub fn count_pipeline_eligible(w:&CountPipeline)->i64 {w.eligible}
pub fn count_pipeline_prior_status(w:&CountPipeline)->i64 {w.prior_status}
pub fn count_pipeline_prior_a0(w:&CountPipeline)->f64 {w.prior_a0}
pub fn count_pipeline_prior_a1(w:&CountPipeline)->f64 {w.prior_a1}
pub fn count_pipeline_prior_variance(w:&CountPipeline)->f64 {w.prior_variance}
pub fn count_pipeline_point_evaluations(w:&CountPipeline)->i64 {w.point_evaluations}
pub fn count_pipeline_refit_evaluations(w:&CountPipeline)->i64 {w.refit_evaluations}
pub fn count_pipeline_tail_iterations(w:&CountPipeline)->i64 {w.tail_iterations}
pub fn count_pipeline_payload_bytes(w:&CountPipeline)->i64 {w.payload_bytes}
pub fn count_pipeline_normalization_scope(w:&CountPipeline)->i64 {if w.status==0 && w.phase>=1 {w.normalization_scope}else{-1}}
pub fn count_pipeline_normalization_reference_genes(w:&CountPipeline)->i64 {if w.status==0 && w.phase>=1 {w.reference_genes}else{0}}
pub fn count_pipeline_normalization_used(w:&CountPipeline)->i64 {if w.status==0 && w.phase>=1 {w.normalization_used}else{0}}
pub fn count_pipeline_normalization_excluded(w:&CountPipeline)->i64 {if w.status==0 && w.phase>=1 {w.normalization_excluded}else{0}}
pub fn count_pipeline_join_comparisons(w:&CountPipeline)->i64 {w.join_comparisons}
pub fn count_pipeline_gene_id_length(w:&CountPipeline,row:i64)->i64 with Panic {count_identities_id_length(&w.gene_ids,row)}
pub fn count_pipeline_gene_id_byte(w:&CountPipeline,row:i64,position:i64)->i64 with Panic {count_identities_id_byte(&w.gene_ids,row,position)}
pub fn count_pipeline_value(w:&CountPipeline,row:i64,column:i64)->f64 with Panic {assert(w.status==0 && row>=0 && row<w.g && column>=0 && column<24);cp_v(w,row,column)}
pub fn count_pipeline_gene_status(w:&CountPipeline,row:i64,column:i64)->i64 with Panic {assert(w.status==0 && row>=0 && row<w.g && column>=0 && column<12);cp_m(w,row,column)}
pub fn count_pipeline_adjusted(w:&CountPipeline,row:i64,method:i64)->f64 with Panic {assert(w.status==0 && row>=0 && row<w.g && (method==1 || method==2));if method==1 {numeric_buffer_at(&w.bh,row)}else{numeric_buffer_at(&w.by,row)}}
pub fn count_pipeline_coefficient_available(w:&CountPipeline,row:i64,refitted:bool)->bool with Panic {
 if w.status!=0 || row<0 || row>=w.g {return false}
 if refitted {return cp_m(w,row,5)==0 && cp_m(w,row,7)>=0}
 cp_m(w,row,0)==0 && cp_m(w,row,4)>=0
}
pub fn count_pipeline_coefficient(w:&CountPipeline,row:i64,column:i64,refitted:bool)->f64 with Panic {assert(count_pipeline_coefficient_available(w,row,refitted) && column>=0 && column<w.p);if refitted {numeric_buffer_at(&w.final_beta,row*w.p+column)}else{numeric_buffer_at(&w.point_beta,row*w.p+column)}}
pub fn count_pipeline_factor(w:&CountPipeline,sample:i64)->f64 with Panic {assert(w.status==0 && w.phase>=1 && sample>=0 && sample<w.n);numeric_buffer_at(&w.factors,sample)}
pub fn count_pipeline_offset(w:&CountPipeline,sample:i64)->f64 with Panic {assert(w.status==0 && w.phase>=1 && sample>=0 && sample<w.n);numeric_buffer_at(&w.offsets,sample)}
// Read original validated inputs without cloning their linear owners for plots.
pub fn count_pipeline_sample_id_length(w:&CountPipeline,sample:i64)->i64 with Panic {
 assert(w.status==0 && sample>=0 && sample<w.n);count_identities_id_length(&w.sample_ids,sample)
}
pub fn count_pipeline_sample_id_byte(w:&CountPipeline,sample:i64,position:i64)->i64 with Panic {
 assert(w.status==0 && sample>=0 && sample<w.n)
 assert(position>=0 && position<count_identities_id_length(&w.sample_ids,sample))
 count_identities_id_byte(&w.sample_ids,sample,position)
}
pub fn count_pipeline_count(w:&CountPipeline,row:i64,sample:i64)->i64 with Mut,Div,Panic {
 assert(w.status==0 && row>=0 && row<w.g && sample>=0 && sample<w.n)
 count_csr_at(&w.csr,row,sample)
}
pub fn count_pipeline_design(w:&CountPipeline,sample:i64,column:i64)->f64 with Panic {
 assert(w.status==0 && w.phase>=1 && sample>=0 && sample<w.n && column>=0 && column<w.p)
 numeric_buffer_at(&w.design,sample*w.p+column)
}
pub fn count_pipeline_close(w:CountPipeline) with Alloc {
 let CountPipeline{csr,gene_ids,sample_ids,g,n,p,status,phase,point_next,refit_next,eligible,options,layout,normalization,
 prior_status,prior_a0,prior_a1,prior_variance,point_evaluations,refit_evaluations,tail_iterations,
 normalization_mode,normalization_scope,reference_genes,normalization_used,normalization_excluded,join_comparisons,model_declared,independence_declared,payload_bytes,log_work,
