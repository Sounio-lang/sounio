fn cp_initialize(w:&!CountPipeline)->i64 with Mut,Panic {
 if w.status!=0 {return w.status}
 if !cp_storage_ok(w) {w.status=4;return 4}
 var i:i64=0
 while i<w.g {var j:i64=0
  while j<24 {cp_set(w,i,j,0.0);j=j+1}
  j=0;while j<12 {cp_mark(w,i,j,-1);j=j+1}
  j=0;while j<w.p {numeric_buffer_set(&!w.point_beta,i*w.p+j,0.0);numeric_buffer_set(&!w.final_beta,i*w.p+j,0.0);j=j+1}
  integer_buffer_set(&!w.available,i,0);numeric_buffer_set(&!w.pvalues,i,1.0)
  numeric_buffer_set(&!w.bh,i,1.0);numeric_buffer_set(&!w.by,i,1.0);i=i+1
 };0
}
