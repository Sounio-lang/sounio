//! stdlib/genomics/ontology.sio - Gene Ontology and Pathway Enrichment
//!
//! Gene symbol validation, pathway enrichment analysis with epistemic uncertainty.
//! Uses hypergeometric test for enrichment and Benjamini-Hochberg FDR correction.

use types::*;

// ============================================================================
// Gene Validation Types
// ============================================================================

/// Result of gene symbol validation
enum GeneValidationResult {
    Valid { symbol: str, gene_id: str, name: str },
    Alias { canonical: str, original: str },
    NotFound { symbol: str },
    Ambiguous { symbol: str, candidates: Vec<str> },
}

/// Gene record from database
struct GeneRecord {
    symbol: str,          // Official gene symbol (e.g., "TP53")
    gene_id: str,         // NCBI/Ensembl gene ID
    name: str,            // Full gene name
    aliases: Vec<str>,    // Alternative symbols
    chromosome: str,      // Chromosome location
    start_pos: u32,       // Start position
    end_pos: u32,         // End position
    strand: char,         // + or -
}

/// Pathway database entry
struct Pathway {
    pathway_id: str,      // Pathway identifier (e.g., "GO:0006915")
    name: str,            // Pathway name
    description: str,     // Full description
    genes: Vec<str>,      // Genes in this pathway
    category: str,        // Category (e.g., "biological_process")
}

// ============================================================================
// Gene Validation
// ============================================================================

/// Validate a gene symbol against the gene database
///
/// Checks for:
/// 1. Exact symbol match -> Valid
/// 2. Alias match -> Alias (returns canonical symbol)
/// 3. Fuzzy match -> Ambiguous (multiple candidates)
/// 4. No match -> NotFound
fn validate_gene(symbol: str) -> GeneValidationResult {
    // In a real implementation, this would query a gene database
    // For now, we implement the logic assuming a loaded gene_db

    let upper_symbol = to_uppercase(symbol)

    // Check common gene symbols (hardcoded examples for demonstration)
    // Production code would load from Gene Ontology / NCBI Gene
    let common_genes = get_common_genes()

    // Step 1: Exact match
    for gene in common_genes {
        if to_uppercase(gene.symbol) == upper_symbol {
            return GeneValidationResult::Valid {
                symbol: gene.symbol,
                gene_id: gene.gene_id,
                name: gene.name,
            }
        }
    }

    // Step 2: Check aliases
    for gene in common_genes {
        for alias in gene.aliases {
            if to_uppercase(alias) == upper_symbol {
                return GeneValidationResult::Alias {
                    canonical: gene.symbol,
                    original: symbol,
                }
            }
        }
    }

    // Step 3: Fuzzy match (simple prefix matching)
    var candidates = Vec::new()
    for gene in common_genes {
        if starts_with_ignore_case(gene.symbol, symbol) {
            candidates.push(gene.symbol)
        }
    }

    if candidates.len() > 1 {
        return GeneValidationResult::Ambiguous {
            symbol: symbol,
            candidates: candidates,
        }
    } else if candidates.len() == 1 {
        // Single fuzzy match - treat as valid
        for gene in common_genes {
            if gene.symbol == candidates[0] {
                return GeneValidationResult::Valid {
                    symbol: gene.symbol,
                    gene_id: gene.gene_id,
                    name: gene.name,
                }
            }
        }
    }

    // Step 4: Not found
    GeneValidationResult::NotFound { symbol: symbol }
}

/// Validate multiple gene symbols
fn validate_genes(symbols: Vec<str>) -> Vec<GeneValidationResult> {
    var results = Vec::new()
    for symbol in symbols {
        results.push(validate_gene(symbol))
    }
    results
}

/// Filter to only valid genes from validation results
fn filter_valid_genes(results: Vec<GeneValidationResult>) -> Vec<str> {
    var valid = Vec::new()
    for result in results {
        match result {
            GeneValidationResult::Valid { symbol, gene_id, name } => {
                valid.push(symbol)
            },
            GeneValidationResult::Alias { canonical, original } => {
                valid.push(canonical)
            },
            _ => {}
        }
    }
    valid
}

// ============================================================================
// Pathway Enrichment Types
// ============================================================================

/// Result of pathway enrichment analysis
struct EnrichmentResult {
    pathway_id: str,              // Pathway identifier
    pathway_name: str,            // Human-readable name
    p_value: Knowledge<f64>,      // Raw p-value with uncertainty
    fdr: Knowledge<f64>,          // FDR-adjusted p-value
    fold_enrichment: Knowledge<f64>,  // Enrichment fold change
    genes_in_pathway: Vec<str>,   // Query genes found in pathway
    overlap_count: u32,           // Number of overlapping genes
    pathway_size: u32,            // Total genes in pathway
}

// ============================================================================
// Pathway Enrichment Analysis
// ============================================================================

/// Perform pathway enrichment analysis using hypergeometric test
///
/// Tests whether differentially expressed genes are overrepresented
/// in biological pathways compared to a background gene set.
///
/// # Arguments
/// * `de_genes` - Differentially expressed gene symbols
/// * `background` - Background gene set (e.g., all expressed genes)
/// * `fdr_threshold` - False discovery rate threshold (e.g., 0.05)
///
/// # Returns
/// Vector of enrichment results for significant pathways
fn pathway_enrichment(
    de_genes: Vec<str>,
    background: Vec<str>,
    fdr_threshold: f64
) -> Vec<EnrichmentResult> {
    // Get pathways to test
    let pathways = get_pathways()

    let n_de = de_genes.len() as u32
    let n_bg = background.len() as u32

    if n_de == 0 || n_bg == 0 {
        return Vec::new()
    }

    // Calculate enrichment for each pathway
    var raw_results = Vec::new()

    for pathway in pathways {
        // Count genes in pathway that are in background
        let pathway_in_bg = count_overlap(pathway.genes, background)

        if pathway_in_bg == 0 {
            continue
        }

        // Count DE genes in pathway
        let overlap_genes = find_overlap(de_genes, pathway.genes)
        let overlap_count = overlap_genes.len() as u32

        if overlap_count == 0 {
            continue
        }

        // Hypergeometric test
        // P(X >= k) where X ~ Hypergeometric(N, K, n)
        // N = background size
        // K = pathway genes in background
        // n = DE genes
        // k = overlap count
        let p_value = hypergeometric_pvalue(n_bg, pathway_in_bg, n_de, overlap_count)

        // Calculate fold enrichment
        // Expected overlap = (n_de / n_bg) * pathway_in_bg
        let expected = ((n_de as f64) / (n_bg as f64)) * (pathway_in_bg as f64)
        let fold_enrichment = if expected > 0.0 {
            (overlap_count as f64) / expected
        } else {
            0.0
        }

        // Estimate uncertainty based on sample size
        let confidence = sample_size_confidence(overlap_count, pathway_in_bg)

        raw_results.push(EnrichmentResult {
            pathway_id: pathway.pathway_id,
            pathway_name: pathway.name,
            p_value: measure(p_value, confidence: confidence),
            fdr: measure(1.0, confidence: 0.0),  // Will be computed below
            fold_enrichment: measure(fold_enrichment, confidence: confidence),
            genes_in_pathway: overlap_genes,
            overlap_count: overlap_count,
            pathway_size: pathway_in_bg,
        })
    }

    // Apply Benjamini-Hochberg FDR correction
    let corrected = benjamini_hochberg(raw_results)

    // Filter by FDR threshold
    var significant = Vec::new()
    for result in corrected {
        if result.fdr.value() <= fdr_threshold {
            significant.push(result)
        }
    }

    // Sort by p-value (ascending)
    sort_by_pvalue(significant)
}

// ============================================================================
// Hypergeometric Test
// ============================================================================

/// Calculate p-value using hypergeometric distribution
///
/// P(X >= k) = sum_{i=k}^{min(n,K)} C(K,i) * C(N-K, n-i) / C(N, n)
///
/// Using log-space computation for numerical stability
fn hypergeometric_pvalue(N: u32, K: u32, n: u32, k: u32) -> f64 {
    // Compute cumulative probability P(X >= k)
    var p_value: f64 = 0.0

    let max_i = min_u32(n, K)

    for i in k..(max_i + 1) {
        let log_prob = log_hypergeometric_pmf(N, K, n, i)
        p_value = p_value + exp(log_prob)
    }

    // Clamp to [0, 1]
    if p_value > 1.0 {
        p_value = 1.0
    }
    if p_value < 0.0 {
        p_value = 0.0
    }

    p_value
}

/// Log probability mass function for hypergeometric distribution
///
/// log P(X = k) = log C(K,k) + log C(N-K, n-k) - log C(N, n)
fn log_hypergeometric_pmf(N: u32, K: u32, n: u32, k: u32) -> f64 {
    // Check bounds
    if k > K || k > n || (n - k) > (N - K) {
        return -1000000.0  // Log of ~0
    }

    log_binomial(K, k) + log_binomial(N - K, n - k) - log_binomial(N, n)
}

/// Log of binomial coefficient C(n, k)
///
/// log C(n, k) = log(n!) - log(k!) - log((n-k)!)
///            = sum_{i=1}^{n} log(i) - sum_{i=1}^{k} log(i) - sum_{i=1}^{n-k} log(i)
fn log_binomial(n: u32, k: u32) -> f64 {
    if k > n {
        return -1000000.0
    }
    if k == 0 || k == n {
        return 0.0
    }

    // Use smaller k for efficiency
    var kk = k
    if k > n - k {
        kk = n - k
    }

    // log C(n, k) = sum_{i=0}^{k-1} log(n-i) - sum_{i=1}^{k} log(i)
    var result: f64 = 0.0
    for i in 0..kk {
        result = result + ln((n - i) as f64) - ln((i + 1) as f64)
    }

    result
}

/// Natural logarithm
fn ln(x: f64) -> f64 {
    x.ln()
}

/// Exponential
fn exp(x: f64) -> f64 {
    x.exp()
}

// ============================================================================
// FDR Correction
// ============================================================================

/// Benjamini-Hochberg FDR correction
///
/// 1. Sort p-values in ascending order
/// 2. For rank i (1-indexed), FDR = p * n / i
/// 3. Ensure monotonicity: FDR[i] >= FDR[i+1]
fn benjamini_hochberg(results: Vec<EnrichmentResult>) -> Vec<EnrichmentResult> {
    let n = results.len()
    if n == 0 {
        return results
    }

    // Sort by p-value (ascending)
    var sorted = sort_by_pvalue_copy(results)

    // Calculate FDR for each result
    var fdr_values = Vec::new()
    for i in 0..n {
        let rank = i + 1
        let p = sorted[i].p_value.value()
        let fdr = p * (n as f64) / (rank as f64)
        fdr_values.push(fdr)
    }

    // Enforce monotonicity (from end to start)
    var i = n - 1
    while i > 0 {
        if fdr_values[i - 1] > fdr_values[i] {
            fdr_values[i - 1] = fdr_values[i]
        }
        i = i - 1
    }

    // Clamp to [0, 1]
    for i in 0..n {
        if fdr_values[i] > 1.0 {
            fdr_values[i] = 1.0
        }
    }

    // Create corrected results
    var corrected = Vec::new()
    for i in 0..n {
        let original = sorted[i]
        let fdr_conf = original.p_value.confidence()  // Same confidence as p-value

        corrected.push(EnrichmentResult {
            pathway_id: original.pathway_id,
            pathway_name: original.pathway_name,
            p_value: original.p_value,
            fdr: measure(fdr_values[i], confidence: fdr_conf),
            fold_enrichment: original.fold_enrichment,
            genes_in_pathway: original.genes_in_pathway,
            overlap_count: original.overlap_count,
            pathway_size: original.pathway_size,
        })
    }

    corrected
}

// ============================================================================
// Helper Functions
// ============================================================================

/// Count overlap between two gene lists
fn count_overlap(list_a: Vec<str>, list_b: Vec<str>) -> u32 {
    var count: u32 = 0
    for a in list_a {
        for b in list_b {
            if to_uppercase(a) == to_uppercase(b) {
                count = count + 1
                break
            }
        }
    }
    count
}

/// Find overlapping genes between two lists
fn find_overlap(list_a: Vec<str>, list_b: Vec<str>) -> Vec<str> {
    var overlap = Vec::new()
    for a in list_a {
        for b in list_b {
            if to_uppercase(a) == to_uppercase(b) {
                overlap.push(a)
                break
            }
        }
    }
    overlap
}

/// Convert string to uppercase
fn to_uppercase(s: str) -> str {
    var result = ""
    for c in s.chars() {
        if c >= 'a' && c <= 'z' {
            // Convert to uppercase: 'a' (97) -> 'A' (65)
            let upper = ((c as u8) - 32) as char
            result = result ++ upper.to_string()
        } else {
            result = result ++ c.to_string()
        }
    }
    result
}

/// Check if string starts with prefix (case insensitive)
fn starts_with_ignore_case(s: str, prefix: str) -> bool {
    let s_upper = to_uppercase(s)
    let prefix_upper = to_uppercase(prefix)

    if prefix_upper.len() > s_upper.len() {
        return false
    }

    for i in 0..prefix_upper.len() {
        if s_upper.char_at(i) != prefix_upper.char_at(i) {
            return false
        }
    }

    true
}

/// Confidence based on sample size
fn sample_size_confidence(k: u32, n: u32) -> f64 {
    // More samples = higher confidence
    // Using sqrt(k) / sqrt(n) as a simple heuristic
    if n == 0 {
        return 0.1
    }

    let ratio = (k as f64).sqrt() / (n as f64).sqrt()
    let base_conf = 0.5 + 0.4 * ratio

    // Also factor in absolute count
    let count_factor = 1.0 - 1.0 / (1.0 + (k as f64) / 5.0)

    (base_conf + count_factor) / 2.0
}

/// Sort enrichment results by p-value (ascending) - returns new vector
fn sort_by_pvalue_copy(results: Vec<EnrichmentResult>) -> Vec<EnrichmentResult> {
    var sorted = Vec::new()
    for r in results {
        sorted.push(r)
    }

    // Simple insertion sort
    for i in 1..sorted.len() {
        var j = i
        while j > 0 && sorted[j - 1].p_value.value() > sorted[j].p_value.value() {
            let tmp = sorted[j]
            sorted[j] = sorted[j - 1]
            sorted[j - 1] = tmp
            j = j - 1
        }
    }

    sorted
}

/// Sort enrichment results by p-value (ascending) - in place
fn sort_by_pvalue(results: &! Vec<EnrichmentResult>) {
    // Simple insertion sort
    for i in 1..results.len() {
        var j = i
        while j > 0 && results[j - 1].p_value.value() > results[j].p_value.value() {
            let tmp = results[j]
            results[j] = results[j - 1]
            results[j - 1] = tmp
            j = j - 1
        }
    }
}

