/// Get pathways for enrichment analysis (sample data)
fn get_pathways() -> Vec<Pathway> {
    var pathways = Vec::new()

    pathways.push(Pathway {
        pathway_id: "GO:0006915",
        name: "apoptotic process",
        description: "A programmed cell death process",
        genes: vec!["TP53", "BCL2", "BAX", "CASP3", "CASP9", "PTEN", "MYC"],
        category: "biological_process",
    })

    pathways.push(Pathway {
        pathway_id: "GO:0006281",
        name: "DNA repair",
        description: "The process of restoring DNA",
        genes: vec!["BRCA1", "BRCA2", "TP53", "ATM", "ATR", "RAD51", "XRCC1"],
        category: "biological_process",
    })

    pathways.push(Pathway {
        pathway_id: "GO:0008283",
        name: "cell population proliferation",
        description: "The multiplication or reproduction of cells",
        genes: vec!["EGFR", "KRAS", "MYC", "CCND1", "CDK4", "RB1", "E2F1"],
        category: "biological_process",
    })

    pathways.push(Pathway {
        pathway_id: "GO:0007165",
        name: "signal transduction",
        description: "The cellular process in which a signal is conveyed",
        genes: vec!["EGFR", "KRAS", "BRAF", "MEK1", "ERK1", "AKT1", "PTEN"],
        category: "biological_process",
    })

    pathways.push(Pathway {
        pathway_id: "hsa05200",
        name: "Pathways in cancer",
        description: "KEGG cancer pathway",
        genes: vec!["TP53", "BRCA1", "BRCA2", "EGFR", "KRAS", "MYC", "PTEN", "RB1", "APC", "PIK3CA"],
        category: "kegg",
    })

    pathways.push(Pathway {
        pathway_id: "R-HSA-212436",
        name: "Generic Transcription Pathway",
        description: "Reactome transcription pathway",
        genes: vec!["TP53", "MYC", "E2F1", "SP1", "JUN", "FOS", "CREB1"],
        category: "reactome",
    })

    pathways
}

/// Create a vector from elements (helper for sample data)
fn vec(elements: ..str) -> Vec<str> {
    var v = Vec::new()
    for e in elements {
        v.push(e)
    }
    v
}

// ============================================================================
// Ontology Query Functions
// ============================================================================

/// Get all genes in a pathway
fn genes_in_pathway(pathway_id: str) -> Vec<str> {
    let pathways = get_pathways()
    for p in pathways {
        if p.pathway_id == pathway_id {
            return p.genes
        }
    }
    Vec::new()
}

/// Find pathways containing a gene
fn pathways_for_gene(gene_symbol: str) -> Vec<Pathway> {
    let pathways = get_pathways()
    let upper_gene = to_uppercase(gene_symbol)

    var result = Vec::new()
    for p in pathways {
        for g in p.genes {
            if to_uppercase(g) == upper_gene {
                result.push(p)
                break
            }
        }
    }

    result
}

/// Get pathway by ID
fn get_pathway(pathway_id: str) -> Option<Pathway> {
    let pathways = get_pathways()
    for p in pathways {
        if p.pathway_id == pathway_id {
            return Option::Some(p)
        }
    }
    Option::None
}

/// Count genes shared between two pathways
fn pathway_overlap(pathway_id_a: str, pathway_id_b: str) -> u32 {
    let genes_a = genes_in_pathway(pathway_id_a)
    let genes_b = genes_in_pathway(pathway_id_b)
    count_overlap(genes_a, genes_b)
}

