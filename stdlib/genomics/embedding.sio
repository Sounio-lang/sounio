// stdlib/genomics/embedding.sio — Sequence Embedding & Motif Discovery
//
// k-mer frequency profiles, position weight matrices (PWMs), and motif
// scanning for DNA/RNA sequences. All operations use the GF(4) base
// encoding (A=0, C=1, G=2, T=3) from genomics/types.sio.
//
// Epistemic uncertainty on motif scores is derived from PWM entropy:
// high-entropy columns contribute less information, increasing score
// uncertainty.
//
// Checked k-mer counting/profile distance only; see KMER.md.
// PWM, motif scores and hashed embedding uncertainty remain uncalibrated.
//
// References:
//   - Stormo (2000): "DNA binding sites: representation and discovery"
//   - Altschul+ (2009): "PSI-BLAST position-specific scoring matrices"
//   - Lin (1991): "Divergence measures based on Shannon entropy"

use genomics::kmer::{kmer_new,kmer_push_chunk}
use math::pure::{sqrt,ln_checked,is_finite}
// =============================================================================
// Math Helpers
// =============================================================================

fn emb_abs(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn emb_sqrt(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 25 { y = 0.5 * (y + x / y); i = i + 1 }
    y
}

fn emb_ln(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 - 1.0e30 }
    var m = x
    var e = 0
    while m >= 2.0 { m = m / 2.0; e = e + 1 }
    while m < 0.5 { m = m * 2.0; e = e - 1 }
    let t = (m - 1.0) / (m + 1.0)
    let t2 = t * t
    var sum = t
    var term = t
    var k = 1
    while k < 30 { term = term * t2; sum = sum + term / (2 * k + 1) as f64; k = k + 1 }
    2.0 * sum + (e as f64) * 0.6931471805599453
}

fn emb_log2(x: f64) -> f64 with Mut, Div, Panic {
    emb_ln(x) / 0.6931471805599453
}

// =============================================================================
// k-mer Profile
// =============================================================================
// A k-mer profile counts all subsequences of length k in a DNA sequence.
// For k=1: 4 bins (A,C,G,T). For k=2: 16 bins. k=3: 64. k=4: 256.

pub struct KmerProfile {
 pub counts:[f64;256], pub n_kmers:i32, pub k:i32, pub total:f64,
 pub status:i64, pub normalized:bool,
}
pub struct KmerDistance {pub status:i64,pub value:f64}
fn profile_bins(k:i32)->i32 {
 if k==1{return 4} if k==2{return 16} if k==3{return 64} if k==4{return 256} return 0
}
fn profile_empty(k:i32,status:i64)->KmerProfile {
 return KmerProfile{counts:[0.0;256],n_kmers:0,k:k,total:0.0,status:status,normalized:false}
}
// Count through the shared rolling stream; chunk boundaries preserve windows.
pub fn kmer_count(seq:&[i32;4096],seq_len:i32,k:i32)->KmerProfile with Mut,Div,Panic {
 var state=kmer_new(k as i64)
 if state.status!=0 {return profile_empty(k,state.status)}
 if seq_len<0 || seq_len>4096 {return profile_empty(k,2)}
 var chunk:[i32;256]=[0;256]
 var start:i32=0
 while start<seq_len {
  let n:i32=if seq_len-start>256 {256} else {seq_len-start}
  var j:i32=0
  while j<n {chunk[j as usize]=seq[(start+j) as usize];j=j+1}
  if !kmer_push_chunk(&!state,&chunk,n as i64) {return profile_empty(k,state.status)}
  start=start+n
 }
 var out=profile_empty(k,0)
 out.n_kmers=state.n_bins as i32
 out.total=state.total_windows as f64
 var i:i32=0
 while i<out.n_kmers {out.counts[i as usize]=state.counts[i as usize] as f64;i=i+1}
 return out
}
// Complete bounded profile validation before exposing frequencies or distances.
fn profile_valid(p:&KmerProfile)->bool with Mut,Div,Panic {
 if p.status!=0 || p.n_kmers!=profile_bins(p.k) || p.n_kmers==0 {return false}
 if !is_finite(p.total) || p.total<0.0 || p.total>4096.0 {return false}
 if p.normalized && p.total==0.0 {return false}
 let expected=if p.normalized {1.0} else {p.total}
 var sum=0.0
 var c=0.0
 var i:i32=0
 while i<p.n_kmers {
  let v=p.counts[i as usize]
  if !is_finite(v) || v<0.0 || v>expected {return false}
  let y=v-c
  let t=sum+y
  c=(t-sum)-y
  sum=t
  i=i+1
 }
 return emb_abs(sum-expected)<=1.0e-12*(1.0+expected)
}
pub fn kmer_normalize(p:&!KmerProfile)->bool with Mut,Div,Panic {
 if p.status!=0 {return false}
 if !profile_valid(p) {p.status=3;return false}
 if p.total==0.0 {return false}
 if p.normalized {return true}
 var i:i32=0
 while i<p.n_kmers {p.counts[i as usize]=p.counts[i as usize]/p.total;i=i+1}
 p.normalized=true
 return true
}
// Positive symmetric JSD contribution in bits. Avoid cancellation near equality.
fn profile_js_term(p:f64,q:f64)->f64 with Mut,Div,Panic {
 let sum=p+q
 if sum==0.0 {return 0.0}
 let m=0.5*sum
 let r=emb_abs(p-q)/sum
 if r==1.0 {return m}
 var g=0.0
 if r<=0.5 {
  let r2=r*r
  var power=r2
  var j:i32=1
  while j<=24 {
   let jf=j as f64
   g=g+power/((2.0*jf)*(2.0*jf-1.0))
   power=power*r2
   j=j+1
  }
 } else {
  let plus=ln_checked(1.0+r)
  let minus=ln_checked(1.0-r)
  if plus.status!=0 || minus.status!=0 {return -1.0}
  g=0.5*((1.0+r)*plus.value+(1.0-r)*minus.value)
 }
 return m*g/0.69314718055994530942
}
pub fn kmer_distance_checked(a:&KmerProfile,b:&KmerProfile)->KmerDistance with Mut,Div,Panic {
 var out=KmerDistance{status:1,value:0.0}
 if !profile_valid(a) || !profile_valid(b) {return out}
 if a.k!=b.k {out.status=2;return out}
 if a.total==0.0 || b.total==0.0 {out.status=3;return out}
 var sum=0.0
 var c=0.0
 var i:i32=0
 while i<a.n_kmers {
  let p=if a.normalized {a.counts[i as usize]} else {a.counts[i as usize]/a.total}
  let q=if b.normalized {b.counts[i as usize]} else {b.counts[i as usize]/b.total}
  let term=profile_js_term(p,q)
  if !is_finite(term) || term<0.0 {out.status=4;return out}
  let y=term-c
  let t=sum+y
  c=(t-sum)-y
  sum=t
  i=i+1
 }
 if !is_finite(sum) || sum<0.0 || sum>1.0+1.0e-12 {out.status=4;return out}
 out.status=0
 out.value=sqrt(sum)
 return out
}
// Compatibility scalar: -1 means unavailable. Prefer the typed result.
pub fn kmer_distance(a:&KmerProfile,b:&KmerProfile)->f64 with Mut,Div,Panic {
 let result=kmer_distance_checked(a,b)
 if result.status!=0 {return -1.0}
 return result.value
}

// =============================================================================
// Position Weight Matrix (PWM)
// =============================================================================
// A PWM represents a DNA binding motif as a matrix of log-odds scores.
// Rows = positions (up to 256), Columns = 4 bases (A, C, G, T)
// Weight[pos][base] = log2(freq[pos][base] / background)

struct PWM {
    weights: [f64; 1024],   // n_positions * 4, row-major
    n_positions: i32,
    info_content: [f64; 256],  // information content per position (bits)
}

struct MotifHit {
    position: i32,
    score: f64,
    u_score: f64,           // uncertainty from low-info columns
    strand: i32,            // 1 = forward, -1 = reverse complement
}

struct MotifResult {
    hits: [MotifHit; 512],
    n_hits: i32,
    threshold: f64,
}

// Build PWM from aligned sequences
fn pwm_from_alignment(
    seqs: &[[i32; 256]; 128],
    n_seqs: i32,
    seq_len: i32,
) -> PWM with Mut, Div, Panic {
    var pwm = PWM {
        weights: [0.0; 1024],
        n_positions: seq_len,
        info_content: [0.0; 256],
    }

    // Count frequencies at each position
    var pos = 0
    while pos < seq_len {
        var base_counts: [f64; 4] = [0.0; 4]
        var s = 0
        while s < n_seqs {
            let b = seqs[s][pos]
            if b >= 0 {
                if b < 4 {
                    base_counts[b] = base_counts[b] + 1.0
                }
            }
            s = s + 1
        }

        // Add pseudocount (Laplace smoothing)
        var total = 0.0
        var b2 = 0
        while b2 < 4 {
            base_counts[b2] = base_counts[b2] + 0.5
            total = total + base_counts[b2]
            b2 = b2 + 1
        }

        // Compute log-odds and information content
        let bg = 0.25  // uniform background
        var entropy = 0.0
        var b3 = 0
        while b3 < 4 {
            let freq = base_counts[b3] / total
            pwm.weights[pos * 4 + b3] = emb_log2(freq / bg)
            if freq > 1.0e-15 {
                entropy = entropy - freq * emb_log2(freq)
            }
            b3 = b3 + 1
        }

        // Info content = 2 - H(position) bits
        pwm.info_content[pos] = 2.0 - entropy
        pos = pos + 1
    }

    pwm
}

// Add pseudocount to existing PWM (re-normalizes)
fn pwm_add_pseudocount(pwm: &!PWM, pseudo: f64) with Mut, Div, Panic {
    var pos = 0
    while pos < pwm.n_positions {
        var b = 0
        while b < 4 {
            // Convert back from log-odds, add pseudo, re-log
            let w = pwm.weights[pos * 4 + b]
            // Approximate: just shift weights slightly toward 0
            pwm.weights[pos * 4 + b] = w * (1.0 - pseudo) + 0.0 * pseudo
            b = b + 1
        }
        pos = pos + 1
    }
}

// Score a single position in a sequence against the PWM
fn pwm_score_position(
    pwm: &PWM,
    seq: &[i32; 4096],
    pos: i32,
) -> f64 with Mut, Div, Panic {
    var score = 0.0
    var i = 0
    while i < pwm.n_positions {
        let base = seq[pos + i]
        if base >= 0 {
            if base < 4 {
                score = score + pwm.weights[i * 4 + base]
            }
        }
        i = i + 1
    }
    score
}

// Uncertainty of a score based on PWM information content
fn pwm_score_uncertainty(pwm: &PWM) -> f64 with Mut, Div, Panic {
    // Low-info positions contribute more uncertainty
    var total_info = 0.0
    var max_info = 2.0 * (pwm.n_positions as f64)  // max 2 bits per position
    var i = 0
    while i < pwm.n_positions {
        total_info = total_info + pwm.info_content[i]
        i = i + 1
    }
    if max_info > 0.0 {
        1.0 - total_info / max_info  // 0 = certain, 1 = random
    } else {
        1.0
    }
}

// =============================================================================
// Motif Scanning
// =============================================================================

fn pwm_scan(
    pwm: &PWM,
    seq: &[i32; 4096],
    seq_len: i32,
    threshold: f64,
) -> MotifResult with Mut, Div, Panic {
    var result = MotifResult {
        hits: [MotifHit { position: 0, score: 0.0, u_score: 0.0, strand: 0 }; 512],
        n_hits: 0,
        threshold: threshold,
    }

    let u = pwm_score_uncertainty(pwm)

    var pos = 0
    while pos <= seq_len - pwm.n_positions {
        let score = pwm_score_position(pwm, seq, pos)
        if score >= threshold {
            if result.n_hits < 512 {
                result.hits[result.n_hits] = MotifHit {
                    position: pos,
                    score: score,
                    u_score: u * emb_abs(score),
                    strand: 1,
                }
                result.n_hits = result.n_hits + 1
            }
        }
        pos = pos + 1
    }

    result
}

// =============================================================================
// Sequence Embedding via k-mer feature hashing
// =============================================================================
// Project k-mer frequencies into a lower-dimensional space using
// deterministic hash-based projection (no randomness needed).

struct SeqEmbedding {
    vector: [f64; 64],
    u_vector: [f64; 64],    // uncertainty per dimension
    dim: i32,
    status: i64,
}

fn seq_embed_kmer(
    seq: &[i32; 4096],
    seq_len: i32,
    dim: i32,
) -> SeqEmbedding with Mut, Div, Panic {
    var emb = SeqEmbedding {
        vector: [0.0; 64],
        u_vector: [0.0; 64],
        dim: dim,
        status: 0,
    }
    if dim<1 || dim>64 {emb.status=1;emb.dim=0;return emb}

    // Use k=3 (64 trimers) projected into dim dimensions
    let profile = kmer_count(seq, seq_len, 3)
    if profile.status!=0 {emb.status=2;emb.dim=0;return emb}
    if profile.total==0.0 {emb.status=3;emb.dim=0;return emb}

    // Hash-based projection: kmer_idx mod dim determines target dimension
    // Sign: kmer_idx / dim determines +/-
    var i = 0
    while i < profile.n_kmers {
        let target = i % dim
        let sign = if (i / dim) % 2 == 0 { 1.0 } else { 0.0 - 1.0 }
        emb.vector[target] = emb.vector[target] + sign * profile.counts[i]
        i = i + 1
    }

    // Normalize to unit vector and compute uncertainty
    var norm = 0.0
    var j = 0
    while j < dim {
        norm = norm + emb.vector[j] * emb.vector[j]
        j = j + 1
    }
    norm = emb_sqrt(norm)

    if norm > 1.0e-15 {
        var k = 0
        while k < dim {
            emb.vector[k] = emb.vector[k] / norm
            // Legacy heuristic magnitude, not calibrated standard uncertainty
            emb.u_vector[k] = 1.0 / emb_sqrt(profile.total + 1.0)
            k = k + 1
        }
    }

    emb
}

// Cosine similarity between two embeddings
fn seq_cosine_similarity(a: &SeqEmbedding, b: &SeqEmbedding) -> f64 with Mut, Div, Panic {
    var dot = 0.0
    var na = 0.0
    var nb = 0.0
    var i = 0
    while i < a.dim {
        dot = dot + a.vector[i] * b.vector[i]
        na = na + a.vector[i] * a.vector[i]
        nb = nb + b.vector[i] * b.vector[i]
        i = i + 1
    }
    let denom = emb_sqrt(na) * emb_sqrt(nb)
    if denom > 1.0e-15 { dot / denom } else { 0.0 }
}

// Euclidean distance between embeddings
fn seq_embedding_distance(a: &SeqEmbedding, b: &SeqEmbedding) -> f64 with Mut, Div, Panic {
    var sum_sq = 0.0
    var i = 0
    while i < a.dim {
        let d = a.vector[i] - b.vector[i]
        sum_sq = sum_sq + d * d
        i = i + 1
    }
    emb_sqrt(sum_sq)
}
