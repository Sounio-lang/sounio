//! stdlib/genomics/expression.sio - RNA-seq Expression Analysis
//!
//! Quantification of gene expression levels with epistemic uncertainty.
//! FPKM: Fragments Per Kilobase of transcript per Million mapped reads
//! TPM: Transcripts Per Million (compositional, sums to 1M per sample)
//!
//! All calculations propagate uncertainty using Knowledge<T> types.

use types::*;

// ============================================================================
// FPKM Calculation
// ============================================================================

/// Calculate FPKM (Fragments Per Kilobase Million) with epistemic uncertainty
///
/// Formula: FPKM = (read_count × 10^9) / (gene_length × total_reads)
///
/// Uncertainty is derived from Poisson assumption on read counts:
/// Var(count) ~ count, propagated through division
///
/// # Arguments
/// * `read_counts` - Raw fragment counts per gene
/// * `gene_lengths` - Gene lengths in base pairs
/// * `total_reads` - Total mapped reads in sample
///
/// # Returns
/// Vector of FPKM values with epistemic uncertainty
fn calculate_fpkm(
    read_counts: Vec<u32>,
    gene_lengths: Vec<u32>,
    total_reads: u64
) -> Vec<Knowledge<f32>> {
    var results = Vec::new()
    let n = read_counts.len()

    // Validate input lengths match
    if n != gene_lengths.len() {
        return results
    }

    // Scaling factor: 10^9 / total_reads
    let scaling_factor = 1_000_000_000.0 / (total_reads as f64)

    for i in 0..n {
        let count = read_counts[i] as f64
        let length = gene_lengths[i] as f64

        // Skip genes with zero length
        if length == 0.0 {
            results.push(measure(0.0 as f32, confidence: 0.0))
            continue
        }

        // Calculate FPKM
        let fpkm = (count * scaling_factor) / length

        // Variance estimation using Poisson model
        // Var(FPKM) ~ (scaling_factor / length)^2 × count
        let scale_over_len = scaling_factor / length
        let var_fpkm = scale_over_len * scale_over_len * count

        // Confidence based on read count (more reads = higher confidence)
        // Using sqrt(count) as effective sample size
        let confidence = if count > 0.0 {
            let effective_n = count.sqrt()
            // Map to [0.5, 0.99] range based on read count
            0.5 + 0.49 * (1.0 - 1.0 / (1.0 + effective_n / 10.0))
        } else {
            0.1  // Low confidence for zero counts
        }

        results.push(measure(fpkm as f32, confidence: confidence))
    }

    results
}

// ============================================================================
// TPM Calculation
// ============================================================================

/// Calculate TPM (Transcripts Per Million) with epistemic uncertainty
///
/// TPM is a compositional measure that sums to 1 million per sample,
/// making it more comparable across samples than FPKM.
///
/// Formula:
/// 1. RPK = read_count / (gene_length / 1000)
/// 2. TPM = (RPK / sum(RPK)) × 10^6
///
/// # Arguments
/// * `read_counts` - Raw fragment counts per gene
/// * `gene_lengths` - Gene lengths in base pairs
///
/// # Returns
/// Vector of TPM values with epistemic uncertainty
fn calculate_tpm(
    read_counts: Vec<u32>,
    gene_lengths: Vec<u32>
) -> Vec<Knowledge<f32>> {
    var results = Vec::new()
    let n = read_counts.len()

    // Validate input lengths match
    if n != gene_lengths.len() {
        return results
    }

    // Step 1: Calculate RPK (Reads Per Kilobase) values
    var rpk_values = Vec::new()
    var rpk_sum: f64 = 0.0

    for i in 0..n {
        let count = read_counts[i] as f64
        let length_kb = (gene_lengths[i] as f64) / 1000.0

        let rpk = if length_kb > 0.0 {
            count / length_kb
        } else {
            0.0
        }

        rpk_values.push(rpk)
        rpk_sum = rpk_sum + rpk
    }

    // Step 2: Normalize to TPM
    let scaling_factor = if rpk_sum > 0.0 {
        1_000_000.0 / rpk_sum
    } else {
        0.0
    }

    for i in 0..n {
        let tpm = rpk_values[i] * scaling_factor
        let count = read_counts[i] as f64

        // Variance propagation for compositional data
        // Using multinomial approximation
        let var_tpm = if count > 0.0 && rpk_sum > 0.0 {
            // Variance of proportion: p(1-p)/n
            let p = tpm / 1_000_000.0
            let var_p = p * (1.0 - p) / rpk_sum
            var_p * 1_000_000.0 * 1_000_000.0
        } else {
            0.0
        }

        // Confidence based on read count
        let confidence = if count > 0.0 {
            let effective_n = count.sqrt()
            0.5 + 0.49 * (1.0 - 1.0 / (1.0 + effective_n / 10.0))
        } else {
            0.1
        }

        results.push(measure(tpm as f32, confidence: confidence))
    }

    results
}

// ============================================================================
// Expression Level Helpers
// ============================================================================

/// Create ExpressionLevel from raw counts and gene info
fn expression_from_counts(
    gene_id: str,
    transcript_id: str,
    read_count: u32,
    gene_length: u32,
    total_reads: u64,
    all_counts: Vec<u32>,
    all_lengths: Vec<u32>
) -> ExpressionLevel {
    // Calculate FPKM for this gene
    let fpkm_vec = calculate_fpkm(
        vec![read_count],
        vec![gene_length],
        total_reads
    )
    let fpkm = if fpkm_vec.len() > 0 { fpkm_vec[0] } else { measure(0.0, confidence: 0.0) }

    // Calculate TPM (need all genes for normalization)
    // Find index of this gene in all_counts
    var tpm = measure(0.0 as f32, confidence: 0.0)
    let tpm_vec = calculate_tpm(all_counts, all_lengths)
    for i in 0..all_counts.len() {
        if all_counts[i] == read_count && all_lengths[i] == gene_length {
            if i < tpm_vec.len() {
                tpm = tpm_vec[i]
            }
            break
        }
    }

    // Combined confidence
    let conf = (fpkm.confidence() + tpm.confidence()) / 2.0

    ExpressionLevel {
        gene_id: gene_id,
        transcript_id: transcript_id,
        read_count: read_count,
        fpkm: fpkm,
        tpm: tpm,
        confidence: measure(conf as f32, confidence: conf),
    }
}

/// Normalize expression values across samples (quantile normalization)
fn normalize_quantile(
    samples: Vec<Vec<f32>>
) -> Vec<Vec<f32>> {
    if samples.len() == 0 {
        return samples
    }

    let n_genes = samples[0].len()
    let n_samples = samples.len()

    // Step 1: Sort each sample and get ranks
    var sorted_samples = Vec::new()
    var rank_indices = Vec::new()

    for sample in samples {
        let sorted_with_idx = sort_with_indices(sample)
        sorted_samples.push(sorted_with_idx.0)
        rank_indices.push(sorted_with_idx.1)
    }

    // Step 2: Calculate mean at each rank
    var rank_means = Vec::new()
    for i in 0..n_genes {
        var sum: f32 = 0.0
        for j in 0..n_samples {
            sum = sum + sorted_samples[j][i]
        }
        rank_means.push(sum / (n_samples as f32))
    }

    // Step 3: Assign rank means back to original positions
    var normalized = Vec::new()
    for j in 0..n_samples {
        var norm_sample = Vec::new()
        for i in 0..n_genes {
            norm_sample.push(0.0)
        }
        // Map rank means back to original positions
        for i in 0..n_genes {
            let orig_idx = rank_indices[j][i]
            norm_sample[orig_idx] = rank_means[i]
        }
        normalized.push(norm_sample)
    }

    normalized
}

/// Sort values and return sorted values with original indices
fn sort_with_indices(values: Vec<f32>) -> (Vec<f32>, Vec<usize>) {
    var sorted = Vec::new()
    var indices = Vec::new()

    // Create index array
    for i in 0..values.len() {
        indices.push(i)
    }

    // Simple insertion sort (for correctness; production would use quicksort)
    for i in 0..values.len() {
        sorted.push(values[i])
    }

    for i in 1..sorted.len() {
        var j = i
        while j > 0 && sorted[j - 1] > sorted[j] {
            // Swap values
            let tmp = sorted[j]
            sorted[j] = sorted[j - 1]
            sorted[j - 1] = tmp
            // Swap indices
            let tmp_idx = indices[j]
            indices[j] = indices[j - 1]
            indices[j - 1] = tmp_idx
            j = j - 1
        }
    }

    (sorted, indices)
}

/// Calculate log2 fold change between conditions
fn log2_fold_change(
    expr_a: Vec<Knowledge<f32>>,
    expr_b: Vec<Knowledge<f32>>
) -> Vec<Knowledge<f32>> {
    var results = Vec::new()
    let n = min_u32(expr_a.len() as u32, expr_b.len() as u32)

    for i in 0..(n as usize) {
        let a = expr_a[i].value() as f64
        let b = expr_b[i].value() as f64

        // Add pseudocount to avoid log(0)
        let a_adj = a + 1.0
        let b_adj = b + 1.0

        let log2fc = (b_adj / a_adj).log2()

        // Propagate uncertainty
        let conf_a = expr_a[i].confidence()
        let conf_b = expr_b[i].confidence()
        let combined_conf = (conf_a + conf_b) / 2.0

        results.push(measure(log2fc as f32, confidence: combined_conf))
    }

    results
}

/// Filter differentially expressed genes by fold change and confidence
fn filter_de_genes(
    log2fc: Vec<Knowledge<f32>>,
    gene_ids: Vec<str>,
    min_log2fc: f32,
    min_confidence: f64
) -> Vec<(str, Knowledge<f32>)> {
    var de_genes = Vec::new()

    for i in 0..log2fc.len() {
        let fc = log2fc[i]
        let abs_fc = if fc.value() < 0.0 { 0.0 - fc.value() } else { fc.value() }

        if abs_fc >= min_log2fc && fc.confidence() >= min_confidence {
            if i < gene_ids.len() {
                de_genes.push((gene_ids[i], fc))
            }
        }
    }

    de_genes
}

/// Calculate expression statistics for a gene across samples
fn expression_stats(values: Vec<Knowledge<f32>>) -> (f32, f32, f32) {
    if values.len() == 0 {
        return (0.0, 0.0, 0.0)
    }

    // Mean
    var sum: f64 = 0.0
    for v in values {
        sum = sum + (v.value() as f64)
    }
    let mean = sum / (values.len() as f64)

    // Variance
    var var_sum: f64 = 0.0
    for v in values {
        let diff = (v.value() as f64) - mean
        var_sum = var_sum + diff * diff
    }
    let variance = if values.len() > 1 {
        var_sum / ((values.len() - 1) as f64)
    } else {
        0.0
    }

    // Coefficient of variation
    let cv = if mean > 0.0 {
        variance.sqrt() / mean
    } else {
        0.0
    }

    (mean as f32, variance.sqrt() as f32, cv as f32)
}
