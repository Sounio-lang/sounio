// stdlib/genomics/single_cell.sio — Single-Cell RNA-seq Analysis
//
// Library-size normalization, log1p transform, highly-variable gene
// selection, PCA via power iteration, k-means clustering, differential
// expression marker discovery, and silhouette scoring.
//
// Fixed-size arrays keep the entire pipeline on the stack (no allocator).
// Max capacity: 1024 cells x 512 genes, 32 principal components.
//
// SOTA references:
//   BEACON   (Chen+ 2024): context-aware scRNA-seq foundation model
//   OmniGenome (He+ 2024): unified genomic language model
//   GPU scRNA-seq benchmarks (Li+ 2025): Rapids single-cell at scale
//   Scanpy   (Wolf+ 2018): canonical Python pipeline (normalize -> log1p
//            -> HVG -> PCA -> neighbors -> Leiden -> rank_genes_groups)
//
// Theory:
//   Normalization: x_ij' = x_ij / sum_j(x_ij) * target_sum
//   Log1p:         x_ij' = log(1 + x_ij)
//   PCA:           power iteration on X^T X for leading eigenvectors
//   k-means:       Lloyd iterations with Euclidean distance
//   Markers:       log2 fold-change + Mann-Whitney U statistic -> AUROC

// ============================================================================
// Math Helpers (inline Taylor / Newton; no libm dependency)
// ============================================================================

fn sc_abs(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn sc_sqrt(x: f64) -> f64 with Mut, Div {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 30 { y = 0.5 * (y + x / y); i = i + 1 }
    y
}

fn sc_ln(x: f64) -> f64 with Mut, Div {
    if x <= 0.0 { return 0.0 - 1.0e30 }
    var m = x
    var e = 0
    while m >= 2.0 { m = m / 2.0; e = e + 1 }
    while m < 0.5  { m = m * 2.0; e = e - 1 }
    let t = (m - 1.0) / (m + 1.0)
    let t2 = t * t
    var sum = t
    var term = t
    var k = 1
    while k < 30 {
        term = term * t2
        sum = sum + term / (2 * k + 1) as f64
        k = k + 1
    }
    2.0 * sum + (e as f64) * 0.6931471805599453
}

// log(1 + x), numerically stable for small x via Taylor series
fn sc_log1p_val(x: f64) -> f64 with Mut, Div {
    if sc_abs(x) < 1.0e-4 {
        // Taylor: x - x^2/2 + x^3/3 - x^4/4
        let x2 = x * x
        let x3 = x2 * x
        let x4 = x3 * x
        x - x2 / 2.0 + x3 / 3.0 - x4 / 4.0
    } else {
        sc_ln(1.0 + x)
    }
}

fn sc_min(a: f64, b: f64) -> f64 {
    if a < b { a } else { b }
}

fn sc_max(a: f64, b: f64) -> f64 {
    if a > b { a } else { b }
}

fn sc_min_i(a: i32, b: i32) -> i32 {
    if a < b { a } else { b }
}

// ============================================================================
// Core Types
// ============================================================================

// Expression vector for a single cell (up to 512 genes)
struct CellExpression {
    counts: [f64; 512],
    n_genes: i32,
}

// Expression matrix: cells (rows) x genes (columns), column-major-ish
struct SCMatrix {
    cells: [CellExpression; 1024],
    n_cells: i32,
    n_genes: i32,
}

// PCA result.  components: n_cells x n_components row-major
//              loadings:   n_genes x n_components row-major (stored flat)
struct PCAResult {
    components: [f64; 4096],        // max 1024 cells x 32 components
    loadings: [f64; 4096],          // max 512 genes x 32 components (capped)
    variance_explained: [f64; 32],
    n_components: i32,
    n_cells: i32,
}

// Clustering output
struct CellCluster {
    assignments: [i32; 1024],
    n_clusters: i32,
    n_cells: i32,
    centroids: [f64; 8192],        // max 256 clusters x 32 dims
    silhouette: f64,
    u_silhouette: f64,             // uncertainty on silhouette
}

// Differential expression marker for one gene in one cluster
struct MarkerGene {
    gene_idx: i32,
    cluster_idx: i32,
    log_fc: f64,                    // log2 fold-change (cluster vs rest)
    u_log_fc: f64,                  // uncertainty on fold-change
    pvalue: f64,                    // Mann-Whitney U test p-value (approx)
    auroc: f64,                     // area under ROC
}

struct MarkerResult {
    markers: [MarkerGene; 256],
    n_markers: i32,
}

// ============================================================================
// Normalization — library-size to target_sum, then per-cell scaling
// ============================================================================

fn sc_normalize_total(mat: &!SCMatrix, target_sum: f64) with Mut, Div, Panic {
    var ci = 0
    while ci < mat.n_cells {
        // sum counts for this cell
        var total = 0.0
        var gi = 0
        while gi < mat.n_genes {
            total = total + mat.cells[ci].counts[gi]
            gi = gi + 1
        }

        if total > 0.0 {
            let scale = target_sum / total
            var gi2 = 0
            while gi2 < mat.n_genes {
                mat.cells[ci].counts[gi2] = mat.cells[ci].counts[gi2] * scale
                gi2 = gi2 + 1
            }
        }
        ci = ci + 1
    }
}

// ============================================================================
// Log1p Transform — element-wise log(1 + x)
// ============================================================================

fn sc_log1p_transform(mat: &!SCMatrix) with Mut, Div, Panic {
    var ci = 0
    while ci < mat.n_cells {
        var gi = 0
        while gi < mat.n_genes {
            mat.cells[ci].counts[gi] = sc_log1p_val(mat.cells[ci].counts[gi])
            gi = gi + 1
        }
        ci = ci + 1
    }
}

// ============================================================================
// Highly Variable Gene Selection (variance / mean ratio)
// ============================================================================
// Returns number of selected genes; writes indices into `result`.
// Selects the `n_top` genes with highest normalized dispersion
// (var / mean, a.k.a. Fano factor).

fn sc_highly_variable(
    mat: &SCMatrix,
    n_top: i32,
    result: &![i32; 512]
) -> i32 with Mut, Div, Panic {
    // per-gene mean and variance
    var means: [f64; 512] = [0.0; 512]
    var vars:  [f64; 512] = [0.0; 512]

    var gi = 0
    while gi < mat.n_genes {
        var sum = 0.0
        var ci = 0
        while ci < mat.n_cells {
            sum = sum + mat.cells[ci].counts[gi]
            ci = ci + 1
        }
        let mu = sum / (mat.n_cells as f64)
        means[gi] = mu

        var ss = 0.0
        var ci2 = 0
        while ci2 < mat.n_cells {
            let d = mat.cells[ci2].counts[gi] - mu
            ss = ss + d * d
            ci2 = ci2 + 1
        }
        vars[gi] = ss / (mat.n_cells as f64)
        gi = gi + 1
    }

    // Fano factor = var / mean  (skip genes with near-zero mean)
    var fano: [f64; 512] = [0.0; 512]
    var gi2 = 0
    while gi2 < mat.n_genes {
        if means[gi2] > 1.0e-12 {
            fano[gi2] = vars[gi2] / means[gi2]
        } else {
            fano[gi2] = 0.0
        }
        gi2 = gi2 + 1
    }

    // Select top-n_top by Fano factor (selection sort on indices)
    var indices: [i32; 512] = [0; 512]
    var k = 0
    while k < mat.n_genes { indices[k] = k; k = k + 1 }

    // partial selection sort: move the n_top largest to front
    let n_sel = sc_min_i(n_top, mat.n_genes)
    var s = 0
    while s < n_sel {
        var best = s
        var t = s + 1
        while t < mat.n_genes {
            if fano[indices[t]] > fano[indices[best]] {
                best = t
            }
            t = t + 1
        }
        // swap
        let tmp = indices[s]
        indices[s] = indices[best]
        indices[best] = tmp
        s = s + 1
    }

    // write output
    var w = 0
    while w < n_sel {
        result[w] = indices[w]
        w = w + 1
    }
    n_sel
}

// ============================================================================
// Center and Scale — zero-mean, unit-variance per gene (column)
// ============================================================================

fn sc_center_scale(mat: &!SCMatrix) with Mut, Div, Panic {
    var gi = 0
    while gi < mat.n_genes {
        // mean
        var sum = 0.0
        var ci = 0
        while ci < mat.n_cells {
            sum = sum + mat.cells[ci].counts[gi]
            ci = ci + 1
        }
        let mu = sum / (mat.n_cells as f64)

        // std dev
        var ss = 0.0
        var ci2 = 0
        while ci2 < mat.n_cells {
            let d = mat.cells[ci2].counts[gi] - mu
            ss = ss + d * d
            ci2 = ci2 + 1
        }
        let sigma = sc_sqrt(ss / (mat.n_cells as f64))

        // transform
        var ci3 = 0
        while ci3 < mat.n_cells {
            mat.cells[ci3].counts[gi] = mat.cells[ci3].counts[gi] - mu
            if sigma > 1.0e-12 {
                mat.cells[ci3].counts[gi] = mat.cells[ci3].counts[gi] / sigma
            }
            ci3 = ci3 + 1
        }
        gi = gi + 1
    }
}

// ============================================================================
// PCA — Power Iteration on Covariance Matrix
// ============================================================================
// Computes leading eigenvectors of (1/n) X^T X via repeated matrix-vector
// products with deflation.  Assumes mat is already centered + scaled.

fn sc_pca(mat: &SCMatrix, n_components: i32) -> PCAResult with Mut, Div, Panic {
    let nc = mat.n_cells
    let ng = mat.n_genes
    let ncomp = sc_min_i(n_components, sc_min_i(ng, 32))

    var res = PCAResult {
        components: [0.0; 4096],
        loadings: [0.0; 4096],
        variance_explained: [0.0; 32],
        n_components: ncomp,
        n_cells: nc,
    }

    // work copy of the matrix (for deflation)
    var work: [f64; 524288] = [0.0; 524288]   // 1024 * 512
    var ci = 0
    while ci < nc {
        var gi = 0
        while gi < ng {
            work[ci * 512 + gi] = mat.cells[ci].counts[gi]
            gi = gi + 1
        }
        ci = ci + 1
    }

    var comp = 0
    while comp < ncomp {
        // Initialize eigenvector v (length ng) with simple seed
        var v: [f64; 512] = [0.0; 512]
        var seed_i = 0
        while seed_i < ng {
            v[seed_i] = 1.0 / (1.0 + (seed_i as f64))
            seed_i = seed_i + 1
        }

        // Normalize v
        var vnorm = 0.0
        var ni = 0
        while ni < ng { vnorm = vnorm + v[ni] * v[ni]; ni = ni + 1 }
        vnorm = sc_sqrt(vnorm)
        if vnorm > 1.0e-15 {
            var ni2 = 0
            while ni2 < ng { v[ni2] = v[ni2] / vnorm; ni2 = ni2 + 1 }
        }

        // Power iteration: v <- X^T X v  (200 iters for convergence)
        var iter = 0
        while iter < 200 {
            // u = X v   (length nc)
            var u: [f64; 1024] = [0.0; 1024]
            var ri = 0
            while ri < nc {
                var dot = 0.0
                var gi2 = 0
                while gi2 < ng {
                    dot = dot + work[ri * 512 + gi2] * v[gi2]
                    gi2 = gi2 + 1
                }
                u[ri] = dot
                ri = ri + 1
            }

            // v_new = X^T u   (length ng)
            var v_new: [f64; 512] = [0.0; 512]
            var gi3 = 0
            while gi3 < ng {
                var s = 0.0
                var ri2 = 0
                while ri2 < nc {
                    s = s + work[ri2 * 512 + gi3] * u[ri2]
                    ri2 = ri2 + 1
                }
                v_new[gi3] = s
                gi3 = gi3 + 1
            }

            // normalize v_new
            var nn = 0.0
            var qi = 0
            while qi < ng { nn = nn + v_new[qi] * v_new[qi]; qi = qi + 1 }
            nn = sc_sqrt(nn)
            if nn > 1.0e-15 {
                var qi2 = 0
                while qi2 < ng { v[qi2] = v_new[qi2] / nn; qi2 = qi2 + 1 }
            }
            iter = iter + 1
        }

        // Eigenvalue estimate: lambda = ||X v||^2
        var u_final: [f64; 1024] = [0.0; 1024]
        var ri3 = 0
        while ri3 < nc {
            var dot = 0.0
            var gi4 = 0
            while gi4 < ng {
                dot = dot + work[ri3 * 512 + gi4] * v[gi4]
                gi4 = gi4 + 1
            }
            u_final[ri3] = dot
            ri3 = ri3 + 1
        }
        var eigenval = 0.0
        var ei = 0
        while ei < nc { eigenval = eigenval + u_final[ei] * u_final[ei]; ei = ei + 1 }
        res.variance_explained[comp] = eigenval / (nc as f64)

        // Store loading (eigenvector v, length ng -> capped at 128 per component)
        var li = 0
        let store_g = sc_min_i(ng, 128)
        while li < store_g {
            res.loadings[comp * 128 + li] = v[li]
            li = li + 1
        }

        // Project cells: component_i = X v
        var pi = 0
        while pi < nc {
            res.components[pi * 32 + comp] = u_final[pi]
            pi = pi + 1
        }

        // Deflation: X <- X - u v^T  (rank-1 subtraction)
        var di = 0
        while di < nc {
            var dj = 0
            while dj < ng {
                work[di * 512 + dj] = work[di * 512 + dj] - u_final[di] * v[dj]
                dj = dj + 1
            }
            di = di + 1
        }

        comp = comp + 1
    }

    res
}

// ============================================================================
// K-Means Clustering in PCA Space
// ============================================================================

fn sc_kmeans(pca: &PCAResult, k: i32, max_iter: i32) -> CellCluster with Mut, Div, Panic {
    let nc = pca.n_cells
    let nd = pca.n_components

    var cl = CellCluster {
        assignments: [0; 1024],
        n_clusters: k,
        n_cells: nc,
        centroids: [0.0; 8192],
        silhouette: 0.0,
        u_silhouette: 0.0,
    }

    // Initialize centroids: pick first k cells
    var ci = 0
    while ci < k {
        let src = ci
        var di = 0
        while di < nd {
            cl.centroids[ci * 32 + di] = pca.components[src * 32 + di]
            di = di + 1
        }
        ci = ci + 1
    }

    // Lloyd iterations
    var iter = 0
    while iter < max_iter {
        // Assign each cell to nearest centroid
        var changed = 0
        var ai = 0
        while ai < nc {
            var best_k = 0
            var best_d = 1.0e30
            var ki = 0
            while ki < k {
                var dist = 0.0
                var di2 = 0
                while di2 < nd {
                    let diff = pca.components[ai * 32 + di2] - cl.centroids[ki * 32 + di2]
                    dist = dist + diff * diff
                    di2 = di2 + 1
                }
                if dist < best_d {
                    best_d = dist
                    best_k = ki
                }
                ki = ki + 1
            }
            if cl.assignments[ai] != best_k { changed = changed + 1 }
            cl.assignments[ai] = best_k
            ai = ai + 1
        }

        // Recompute centroids
        var zi = 0
        while zi < k * 32 { cl.centroids[zi] = 0.0; zi = zi + 1 }
        var counts: [i32; 256] = [0; 256]

        var ui = 0
        while ui < nc {
            let c = cl.assignments[ui]
            counts[c] = counts[c] + 1
            var di3 = 0
            while di3 < nd {
                cl.centroids[c * 32 + di3] = cl.centroids[c * 32 + di3] + pca.components[ui * 32 + di3]
                di3 = di3 + 1
            }
            ui = ui + 1
        }

        var fi = 0
        while fi < k {
            if counts[fi] > 0 {
                var di4 = 0
                while di4 < nd {
                    cl.centroids[fi * 32 + di4] = cl.centroids[fi * 32 + di4] / (counts[fi] as f64)
                    di4 = di4 + 1
                }
            }
            fi = fi + 1
        }

        // Convergence check
        if changed == 0 { iter = max_iter }  // early exit
        else { iter = iter + 1 }
    }

    cl
}

// ============================================================================
// Silhouette Score
// ============================================================================
// For each cell: s(i) = (b(i) - a(i)) / max(a(i), b(i))
// a(i) = mean distance to cells in same cluster
// b(i) = min over other clusters of mean distance to that cluster

fn sc_silhouette(pca: &PCAResult, clusters: &CellCluster) -> f64 with Mut, Div, Panic {
    let nc = pca.n_cells
    let nd = pca.n_components
    let k = clusters.n_clusters

    var total_sil = 0.0
    var total_sil_sq = 0.0

    var i = 0
    while i < nc {
        let ci = clusters.assignments[i]

        // a(i): mean distance to same-cluster points
        var sum_a = 0.0
        var cnt_a = 0
        var j = 0
        while j < nc {
            if j != i {
                if clusters.assignments[j] == ci {
                    var dist = 0.0
                    var d = 0
                    while d < nd {
                        let diff = pca.components[i * 32 + d] - pca.components[j * 32 + d]
                        dist = dist + diff * diff
                        d = d + 1
                    }
                    sum_a = sum_a + sc_sqrt(dist)
                    cnt_a = cnt_a + 1
                }
            }
            j = j + 1
        }
        var a_val = 0.0
        if cnt_a > 0 { a_val = sum_a / (cnt_a as f64) }

        // b(i): min mean distance to any other cluster
        var b_val = 1.0e30
        var ki = 0
        while ki < k {
            if ki != ci {
                var sum_b = 0.0
                var cnt_b = 0
                var j2 = 0
                while j2 < nc {
                    if clusters.assignments[j2] == ki {
                        var dist2 = 0.0
                        var d2 = 0
                        while d2 < nd {
                            let diff2 = pca.components[i * 32 + d2] - pca.components[j2 * 32 + d2]
                            dist2 = dist2 + diff2 * diff2
                            d2 = d2 + 1
                        }
                        sum_b = sum_b + sc_sqrt(dist2)
                        cnt_b = cnt_b + 1
                    }
                    j2 = j2 + 1
                }
                if cnt_b > 0 {
                    let mean_b = sum_b / (cnt_b as f64)
                    if mean_b < b_val { b_val = mean_b }
                }
            }
            ki = ki + 1
        }

        // silhouette
        let denom = sc_max(a_val, b_val)
        var s = 0.0
        if denom > 1.0e-15 {
            s = (b_val - a_val) / denom
        }
        total_sil = total_sil + s
        total_sil_sq = total_sil_sq + s * s

        i = i + 1
    }

    if nc > 0 { total_sil / (nc as f64) } else { 0.0 }
}

// ============================================================================
// Marker Gene Discovery — log2 fold-change + Mann-Whitney U -> AUROC
// ============================================================================
// For a given cluster_id, compares expression in-cluster vs out-of-cluster
// for every gene, ranks by |log2FC| * AUROC, returns top markers.

fn sc_find_markers(
    mat: &SCMatrix,
    clusters: &CellCluster,
    cluster_id: i32
) -> MarkerResult with Mut, Div, Panic {
    var res = MarkerResult {
        markers: [MarkerGene {
            gene_idx: 0, cluster_idx: 0,
            log_fc: 0.0, u_log_fc: 0.0,
            pvalue: 1.0, auroc: 0.5,
        }; 256],
        n_markers: 0,
    }

    let nc = mat.n_cells
    let ng = mat.n_genes

    // Identify in-cluster and out-of-cluster cell counts
    var n_in = 0
    var n_out = 0
    var ci = 0
    while ci < nc {
        if clusters.assignments[ci] == cluster_id { n_in = n_in + 1 }
        else { n_out = n_out + 1 }
        ci = ci + 1
    }

    if n_in == 0 { return res }
    if n_out == 0 { return res }

    // For each gene: compute mean_in, mean_out, U-statistic
    var n_found = 0
    var gi = 0
    while gi < ng {
        // Means
        var sum_in = 0.0
        var sum_out = 0.0
        var ss_in = 0.0
        var ss_out = 0.0
        var ci2 = 0
        while ci2 < nc {
            let val = mat.cells[ci2].counts[gi]
            if clusters.assignments[ci2] == cluster_id {
                sum_in = sum_in + val
                ss_in = ss_in + val * val
            } else {
                sum_out = sum_out + val
                ss_out = ss_out + val * val
            }
            ci2 = ci2 + 1
        }
        let mean_in  = sum_in  / (n_in as f64)
        let mean_out = sum_out / (n_out as f64)

        // log2 fold-change: log2(mean_in + 1) - log2(mean_out + 1)
        let log2_in  = sc_ln(mean_in + 1.0) / 0.6931471805599453
        let log2_out = sc_ln(mean_out + 1.0) / 0.6931471805599453
        let lfc = log2_in - log2_out

        // Uncertainty on fold-change (delta method):
        // Var(mean) = var / n, propagated through log
        let var_in  = (ss_in  / (n_in as f64))  - mean_in * mean_in
        let var_out = (ss_out / (n_out as f64)) - mean_out * mean_out
        let se_in  = sc_sqrt(sc_max(var_in, 0.0)  / (n_in as f64))
        let se_out = sc_sqrt(sc_max(var_out, 0.0) / (n_out as f64))
        let u_lfc = sc_sqrt(se_in * se_in + se_out * se_out) / 0.6931471805599453

        // Mann-Whitney U statistic -> AUROC approximation
        // Count how many (in, out) pairs where in > out
        var u_count = 0.0
        var ci3 = 0
        while ci3 < nc {
            if clusters.assignments[ci3] == cluster_id {
                let v_in = mat.cells[ci3].counts[gi]
                var ci4 = 0
                while ci4 < nc {
                    if clusters.assignments[ci4] != cluster_id {
                        let v_out = mat.cells[ci4].counts[gi]
                        if v_in > v_out { u_count = u_count + 1.0 }
                        else if sc_abs(v_in - v_out) < 1.0e-15 { u_count = u_count + 0.5 }
                    }
                    ci4 = ci4 + 1
                }
            }
            ci3 = ci3 + 1
        }
        let auroc = u_count / ((n_in as f64) * (n_out as f64))

        // Approximate p-value from normal approximation of U
        let mu_u  = (n_in as f64) * (n_out as f64) / 2.0
        let sig_u = sc_sqrt((n_in as f64) * (n_out as f64) * ((n_in + n_out + 1) as f64) / 12.0)
        var z = 0.0
        if sig_u > 1.0e-15 {
            z = sc_abs(u_count - mu_u) / sig_u
        }
        // two-sided p-value approximation: p ~ 2 * exp(-0.5 * z^2) / (z * sqrt(2*pi))
        // simplified: use erfc approximation
        var pval = 1.0
        if z > 0.0 {
            // Abramowitz & Stegun approximation: erfc(z/sqrt(2)) ~ 2*Phi(-z)
            let t = 1.0 / (1.0 + 0.3275911 * z)
            let poly = t * (0.254829592 + t * (0.0 - 0.284496736 + t * (1.421413741 + t * (0.0 - 1.453152027 + t * 1.061405429))))
            let one_tail = poly * sc_sqrt(1.0 / (2.0 * 3.14159265358979)) * (0.0 - 0.5 * z * z)
            // Avoid underflow: use exp approximation
            var exp_neg = 1.0
            let neg_half_z2 = 0.0 - 0.5 * z * z
            // Taylor for exp
            var eterm = 1.0
            var esum = 1.0
            var en = 1
            while en < 30 {
                eterm = eterm * neg_half_z2 / (en as f64)
                esum = esum + eterm
                en = en + 1
            }
            exp_neg = esum
            pval = 2.0 * poly * exp_neg
            if pval > 1.0 { pval = 1.0 }
            if pval < 0.0 { pval = 0.0 }
        }

        // Store if |lfc| > 0.25 or auroc > 0.6 (basic filter)
        if sc_abs(lfc) > 0.25 {
            if n_found < 256 {
                res.markers[n_found] = MarkerGene {
                    gene_idx: gi,
                    cluster_idx: cluster_id,
                    log_fc: lfc,
                    u_log_fc: u_lfc,
                    pvalue: pval,
                    auroc: auroc,
                }
                n_found = n_found + 1
            }
        }
        gi = gi + 1
    }

    // Sort markers by |lfc| * auroc descending (insertion sort)
    var si = 1
    while si < n_found {
        let key_score = sc_abs(res.markers[si].log_fc) * res.markers[si].auroc
        let key = res.markers[si]
        var sj = si - 1
        while sj >= 0 {
            let sj_score = sc_abs(res.markers[sj].log_fc) * res.markers[sj].auroc
            if sj_score < key_score {
                res.markers[sj + 1] = res.markers[sj]
                sj = sj - 1
            } else {
                sj = -1  // break
            }
        }
        res.markers[sj + 1] = key
        si = si + 1
    }

    res.n_markers = n_found
    res
}
