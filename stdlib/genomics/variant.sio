//! stdlib/genomics/variant.sio - Epistemic Variant Calling with Knowledge<GF4>
//!
//! Variant calling with full epistemic uncertainty tracking.
//! Uses Beta distribution priors for quality scores and genotype likelihoods.

use types::*;

// ============================================================================
// Pileup Data Structure
// ============================================================================

/// A single position in a pileup (aggregated reads at one genomic position)
struct PileupEntry {
    chromosome: str,      // Chromosome/contig name
    position: u32,        // 1-based position
    ref_base: GF4,        // Reference base at this position
    coverage: u32,        // Total read coverage
    bases: Vec<GF4>,      // Observed bases from reads
    qualities: Vec<u8>,   // Base quality scores (Phred scale)
}

// ============================================================================
// Quality Score Conversion
// ============================================================================

/// Phred score to Beta distribution parameters
/// Converts quality score to prior belief about base accuracy
///
/// Phred score Q = -10 * log10(P_error)
/// P_error = 10^(-Q/10)
/// P_correct = 1 - P_error
///
/// Beta(α, β) where α ~ confidence, β ~ error
fn phred_to_beta(phred: u8) -> (f64, f64) {
    let error_prob = 10.0_f64.powf(0.0 - (phred as f64) / 10.0)
    let confidence = 1.0 - error_prob

    // Scale to get meaningful Beta distribution parameters
    // Higher quality -> higher α relative to β
    let alpha = confidence * 100.0
    let beta = error_prob * 100.0

    (alpha, beta)
}

/// Convert Beta parameters back to confidence
fn beta_to_confidence(alpha: f64, beta: f64) -> f64 {
    if alpha + beta > 0.0 {
        alpha / (alpha + beta)
    } else {
        0.5
    }
}

// ============================================================================
// Genotype Calling
// ============================================================================

/// Call genotype with epistemic uncertainty from observed bases and qualities
///
/// Uses Bayesian approach:
/// - Weight each base observation by quality score
/// - Accumulate support for ref vs alt alleles
/// - Determine genotype based on allele frequency
fn call_genotype(
    bases: Vec<GF4>,
    qualities: Vec<u8>,
    ref_base: GF4
) -> Knowledge<Genotype> {
    var ref_support: f64 = 0.0
    var alt_support: f64 = 0.0

    for i in 0..bases.len() {
        let (alpha, beta) = phred_to_beta(qualities[i])
        let confidence = alpha / (alpha + beta)

        if bases[i] == ref_base {
            ref_support = ref_support + confidence
        } else {
            alt_support = alt_support + confidence
        }
    }

    let total = ref_support + alt_support

    if total == 0.0 {
        return measure(Genotype::HomRef, confidence: 0.1)
    }

    let alt_freq = alt_support / total

    // Determine genotype based on alt allele frequency
    // 0-15%: Homozygous reference
    // 15-65%: Heterozygous
    // 65-100%: Homozygous alternate
    if alt_freq < 0.15 {
        let conf = 1.0 - alt_freq
        measure(Genotype::HomRef, confidence: conf)
    } else if alt_freq < 0.65 {
        // Confidence peaks at 0.5 (perfect het)
        let het_conf = 1.0 - ((alt_freq - 0.5) * 2.0).abs()
        measure(Genotype::Het, confidence: het_conf)
    } else {
        measure(Genotype::HomAlt, confidence: alt_freq)
    }
}

// ============================================================================
// Variant Calling
// ============================================================================

/// Call variants from pileup data with epistemic uncertainty
///
/// For each position in the pileup:
/// 1. Check minimum coverage threshold
/// 2. Count allele frequencies
/// 3. Call genotype with epistemic uncertainty
/// 4. Create Variant record if alternate allele present
///
/// # Arguments
/// * `pileup` - Vector of pileup entries
/// * `ref_seq` - Reference sequence as GF(4) elements
/// * `min_coverage` - Minimum read depth to call variant
/// * `min_alt_freq` - Minimum alternate allele frequency
///
/// # Returns
/// Vector of called variants with epistemic metadata
fn call_variants(
    pileup: Vec<PileupEntry>,
    ref_seq: Vec<GF4>,
    min_coverage: u32,
    min_alt_freq: f64
) -> Vec<Variant> {
    var variants = Vec::new()

    for entry in pileup {
        // Skip low coverage positions
        if entry.coverage < min_coverage {
            continue
        }

        // Count alleles
        var base_counts: [u32; 4] = [0, 0, 0, 0]  // A, C, G, T counts
        var qual_sums: [f64; 4] = [0.0, 0.0, 0.0, 0.0]  // Quality-weighted counts

        for i in 0..entry.bases.len() {
            let base = entry.bases[i]
            let qual = entry.qualities[i]
            let (alpha, beta) = phred_to_beta(qual)
            let weight = alpha / (alpha + beta)

            base_counts[base as usize] = base_counts[base as usize] + 1
            qual_sums[base as usize] = qual_sums[base as usize] + weight
        }

        let ref_base = entry.ref_base
        let ref_count = base_counts[ref_base as usize]

        // Check each potential alternate allele
        for alt in 0..4 {
            let alt_gf4 = alt as GF4

            // Skip if same as reference
            if alt_gf4 == ref_base {
                continue
            }

            let alt_count = base_counts[alt]
            let alt_freq = (alt_count as f64) / (entry.coverage as f64)

            // Skip if below threshold
            if alt_freq < min_alt_freq {
                continue
            }

            // Calculate quality score for this variant
            let avg_qual = calculate_variant_quality(entry.bases, entry.qualities, alt_gf4)
            let qual_var = calculate_quality_variance(entry.qualities)

            // Call genotype using existing function
            let genotype = call_genotype(entry.bases, entry.qualities, ref_base)

            // Calculate confidence from quality-weighted support
            let total_support = qual_sums[0] + qual_sums[1] + qual_sums[2] + qual_sums[3]
            let alt_support = qual_sums[alt]
            let confidence = if total_support > 0.0 {
                alt_support / total_support
            } else {
                0.5
            }

            // Create variant record
            variants.push(Variant {
                position: entry.position as bp,
                chromosome: entry.chromosome,
                ref_base: ref_base,
                alt_base: measure(alt_gf4, confidence: confidence),
                genotype: genotype,
                quality: measure(avg_qual as Phred, confidence: confidence),
                read_depth: measure(entry.coverage, confidence: 0.95),
                allele_frequency: measure(alt_freq as f32, confidence: confidence),
                provenance: generate_provenance_id(),
                filters: apply_variant_filters(entry.coverage, avg_qual, alt_freq),
            })
        }
    }

    variants
}

/// Calculate average quality for bases matching a specific allele
fn calculate_variant_quality(bases: Vec<GF4>, qualities: Vec<u8>, allele: GF4) -> f64 {
    var sum: f64 = 0.0
    var count: u32 = 0

    for i in 0..bases.len() {
        if bases[i] == allele {
            sum = sum + (qualities[i] as f64)
            count = count + 1
        }
    }

    if count > 0 {
        sum / (count as f64)
    } else {
        0.0
    }
}

/// Calculate variance of quality scores
fn calculate_quality_variance(qualities: Vec<u8>) -> f64 {
    if qualities.len() <= 1 {
        return 0.0
    }

    let mean = mean_quality(qualities)
    var sum_sq: f64 = 0.0

    for q in qualities {
        let diff = (q as f64) - mean
        sum_sq = sum_sq + diff * diff
    }

    sum_sq / ((qualities.len() - 1) as f64)
}

/// Apply standard variant filters
fn apply_variant_filters(coverage: u32, quality: f64, alt_freq: f64) -> Vec<str> {
    var filters = Vec::new()

    // Low coverage filter
    if coverage < 10 {
        filters.push("LowCoverage")
    }

    // Low quality filter
    if quality < 20.0 {
        filters.push("LowQuality")
    }

    // Strand bias would require strand information
    // Mapping quality would require mapping info

    // Low allele frequency (potential false positive)
    if alt_freq < 0.1 {
        filters.push("LowAF")
    }

    filters
}

// ============================================================================
// Variant Filtering and Statistics
// ============================================================================

/// Filter variants by minimum quality
fn filter_by_quality(variants: Vec<Variant>, min_qual: u8) -> Vec<Variant> {
    var filtered = Vec::new()
    for v in variants {
        if v.quality.value() >= min_qual {
            filtered.push(v)
        }
    }
    filtered
}

/// Filter variants by minimum coverage
fn filter_by_coverage(variants: Vec<Variant>, min_cov: u32) -> Vec<Variant> {
    var filtered = Vec::new()
    for v in variants {
        if v.read_depth.value() >= min_cov {
            filtered.push(v)
        }
    }
    filtered
}

/// Filter variants that passed all quality filters
fn filter_passed(variants: Vec<Variant>) -> Vec<Variant> {
    var filtered = Vec::new()
    for v in variants {
        if v.filters.len() == 0 {
            filtered.push(v)
        }
    }
    filtered
}

/// Count variants by type (SNP vs other)
fn count_snps(variants: Vec<Variant>) -> u32 {
    // All our variants are SNPs (single base changes)
    variants.len() as u32
}

/// Calculate transition/transversion ratio
/// Transitions: A<->G, C<->T (purine<->purine, pyrimidine<->pyrimidine)
/// Transversions: A<->C, A<->T, G<->C, G<->T
fn ti_tv_ratio(variants: Vec<Variant>) -> f64 {
    var transitions: u32 = 0
    var transversions: u32 = 0

    for v in variants {
        let ref_b = v.ref_base
        let alt_b = v.alt_base.value()

        // Check if transition (purine<->purine or pyrimidine<->pyrimidine)
        // A=0, G=2 are purines; C=1, T=3 are pyrimidines
        let is_transition =
            (ref_b == 0 && alt_b == 2) ||  // A -> G
            (ref_b == 2 && alt_b == 0) ||  // G -> A
            (ref_b == 1 && alt_b == 3) ||  // C -> T
            (ref_b == 3 && alt_b == 1)     // T -> C

        if is_transition {
            transitions = transitions + 1
        } else {
            transversions = transversions + 1
        }
    }

    if transversions > 0 {
        (transitions as f64) / (transversions as f64)
    } else {
        0.0
    }
}

/// Calculate heterozygosity (proportion of het calls)
fn heterozygosity(variants: Vec<Variant>) -> f64 {
    if variants.len() == 0 {
        return 0.0
    }

    var het_count: u32 = 0
    for v in variants {
        match v.genotype.value() {
            Genotype::Het => het_count = het_count + 1,
            Genotype::HetAlt => het_count = het_count + 1,
            _ => {}
        }
    }

    (het_count as f64) / (variants.len() as f64)
}

// ============================================================================
// Pileup Generation (from aligned reads)
// ============================================================================

/// Create pileup entry from aligned bases at a position
fn create_pileup_entry(
    chromosome: str,
    position: u32,
    ref_base: GF4,
    aligned_bases: Vec<GF4>,
    base_qualities: Vec<u8>
) -> PileupEntry {
    PileupEntry {
        chromosome: chromosome,
        position: position,
        ref_base: ref_base,
        coverage: aligned_bases.len() as u32,
        bases: aligned_bases,
        qualities: base_qualities,
    }
}

/// Merge overlapping pileup entries (from multiple sources)
fn merge_pileups(pileups: Vec<Vec<PileupEntry>>) -> Vec<PileupEntry> {
    // Simple implementation: concatenate and sort by position
    var merged = Vec::new()

    for pileup in pileups {
        for entry in pileup {
            merged.push(entry)
        }
    }

    // Sort by position (simple insertion sort)
    for i in 1..merged.len() {
        var j = i
        while j > 0 && merged[j - 1].position > merged[j].position {
            let tmp = merged[j]
            merged[j] = merged[j - 1]
            merged[j - 1] = tmp
            j = j - 1
        }
    }

    merged
}
