//! GFF/GTF format parser
//!
//! Parse GFF3 (General Feature Format) files for genomic annotations.
//! GFF format: seqid source type start end score strand phase attributes
//! Fields are tab-separated, attributes are key=value pairs separated by ;

use types::*
use io::*

/// A single GFF feature record
struct GffFeature {
    seqid: str,           // Sequence/chromosome ID
    source: str,          // Source of annotation (e.g., "RefSeq", "Ensembl")
    feature_type: str,    // Feature type (e.g., "gene", "exon", "CDS")
    start: u32,           // Start position (1-based, inclusive)
    end: u32,             // End position (1-based, inclusive)
    score: Option<f64>,   // Score (e.g., alignment score) or None if "."
    strand: char,         // '+', '-', or '.' for unknown
    phase: Option<u8>,    // Reading frame (0, 1, 2) for CDS, None for others
    attributes: Vec<(str, str)>,  // Key-value attribute pairs
}

/// Error type for GFF parsing
enum GffError {
    IoError { message: str },
    ParseError { line: u32, message: str },
    InvalidFormat { line: u32 },
}

/// Parse a GFF file and return vector of features
fn parse_gff(file_path: str) -> Result<Vec<GffFeature>, GffError> with IO {
    let content = match io::read_file(file_path) {
        Ok(c) => c,
        Err(e) => return Err(GffError::IoError { message: "Failed to read file" })
    }

    parse_gff_string(content)
}

/// Parse GFF format from string content
fn parse_gff_string(content: str) -> Result<Vec<GffFeature>, GffError> {
    let lines = split_by_newline(content)

    var features = Vec::new()
    var line_num: u32 = 0

    for line in lines {
        line_num = line_num + 1
        let trimmed = trim(line)

        // Skip empty lines and comments
        if trimmed.len() == 0 || trimmed.char_at(0) == '#' {
            continue
        }

        // Split by tab
        let fields = split_by_tab(trimmed)

        // GFF requires 9 fields
        if fields.len() < 9 {
            continue  // Skip malformed lines (could also error)
        }

        // Parse each field
        let seqid = fields[0]
        let source = fields[1]
        let feature_type = fields[2]
        let start = parse_u32(fields[3])
        let end = parse_u32(fields[4])

        // Score can be "." for missing
        let score = if fields[5] == "." {
            Option::None
        } else {
            Option::Some(parse_f64(fields[5]))
        }

        // Strand: +, -, or .
        let strand = if fields[6].len() > 0 {
            fields[6].char_at(0)
        } else {
            '.'
        }

        // Phase: 0, 1, 2 for CDS features, "." for others
        let phase = if fields[7] == "." {
            Option::None
        } else {
            Option::Some(parse_u8(fields[7]))
        }

        // Parse attributes (key=value pairs separated by ;)
        let attributes = parse_gff_attributes(fields[8])

        features.push(GffFeature {
            seqid: seqid,
            source: source,
            feature_type: feature_type,
            start: start,
            end: end,
            score: score,
            strand: strand,
            phase: phase,
            attributes: attributes,
        })
    }

    Ok(features)
}

/// Parse GFF attribute string into key-value pairs
/// Format: key1=value1;key2=value2;...
fn parse_gff_attributes(attr_str: str) -> Vec<(str, str)> {
    var attrs = Vec::new()
    let pairs = split_by_semicolon(attr_str)

    for pair in pairs {
        let kv = split_by_equals(pair)
        if kv.len() >= 2 {
            let key = trim(kv[0])
            let value = trim(kv[1])
            // Remove quotes if present
            let clean_value = if value.len() >= 2 && value.char_at(0) == '"' {
                value.slice(1, value.len() - 1)
            } else {
                value
            }
            attrs.push((key, clean_value))
        }
    }

    attrs
}

/// Get attribute value by key
fn gff_get_attribute(feature: GffFeature, key: str) -> Option<str> {
    for attr in feature.attributes {
        if attr.0 == key {
            return Option::Some(attr.1)
        }
    }
    Option::None
}

/// Filter features by type (e.g., "gene", "exon", "CDS")
fn gff_filter_by_type(features: Vec<GffFeature>, feature_type: str) -> Vec<GffFeature> {
    var filtered = Vec::new()
    for feature in features {
        if feature.feature_type == feature_type {
            filtered.push(feature)
        }
    }
    filtered
}

/// Filter features by seqid (chromosome/contig)
fn gff_filter_by_seqid(features: Vec<GffFeature>, seqid: str) -> Vec<GffFeature> {
    var filtered = Vec::new()
    for feature in features {
        if feature.seqid == seqid {
            filtered.push(feature)
        }
    }
    filtered
}

/// Filter features overlapping a region
fn gff_filter_by_region(
    features: Vec<GffFeature>,
    seqid: str,
    start: u32,
    end: u32
) -> Vec<GffFeature> {
    var filtered = Vec::new()
    for feature in features {
        if feature.seqid == seqid {
            // Check for overlap: feature.start <= end && feature.end >= start
            if feature.start <= end && feature.end >= start {
                filtered.push(feature)
            }
        }
    }
    filtered
}

/// Get gene names from features (extracts "gene_name" or "Name" attribute)
fn gff_get_gene_names(features: Vec<GffFeature>) -> Vec<str> {
    var names = Vec::new()
    for feature in features {
        // Try common gene name attributes
        match gff_get_attribute(feature, "gene_name") {
            Option::Some(name) => names.push(name),
            Option::None => {
                match gff_get_attribute(feature, "Name") {
                    Option::Some(name) => names.push(name),
                    Option::None => {
                        match gff_get_attribute(feature, "gene_id") {
                            Option::Some(name) => names.push(name),
                            Option::None => {}
                        }
                    }
                }
            }
        }
    }
    names
}

/// Calculate feature length
fn gff_feature_length(feature: GffFeature) -> u32 {
    feature.end - feature.start + 1  // GFF is 1-based, inclusive
}

/// Write GFF features to file
fn write_gff(file_path: str, features: Vec<GffFeature>) -> Result<(), GffError> with IO {
    var content = "##gff-version 3\n"

    for feature in features {
        // seqid source type start end
        content = content ++ feature.seqid ++ "\t"
        content = content ++ feature.source ++ "\t"
        content = content ++ feature.feature_type ++ "\t"
        content = content ++ feature.start.to_string() ++ "\t"
        content = content ++ feature.end.to_string() ++ "\t"

        // score
        match feature.score {
            Option::Some(s) => content = content ++ s.to_string(),
            Option::None => content = content ++ "."
        }
        content = content ++ "\t"

        // strand
        content = content ++ feature.strand.to_string() ++ "\t"

        // phase
        match feature.phase {
            Option::Some(p) => content = content ++ p.to_string(),
            Option::None => content = content ++ "."
        }
        content = content ++ "\t"

        // attributes
        var first = true
        for attr in feature.attributes {
            if !first {
                content = content ++ ";"
            }
            content = content ++ attr.0 ++ "=" ++ attr.1
            first = false
        }
        content = content ++ "\n"
    }

    match io::write_file(file_path, content) {
        Ok(_) => Ok(()),
        Err(e) => Err(GffError::IoError { message: "Failed to write file" })
    }
}
