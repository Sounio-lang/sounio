//! stdlib/genomics/io - File I/O for Genomics Formats

module genomics::io

pub fn genomics_io_module_ready() -> i32 { 1 }

pub use genomics::io::fasta;
pub use genomics::io::count_tsv;

// Owned readers plus separate graph/document/reference validation profiles.
