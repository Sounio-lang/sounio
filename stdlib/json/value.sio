// stdlib/json/value — Lightweight JSON leaf value
//
// Tagged-union style. Each JsonValue holds one of:
//   null, bool, int, float, or short string.
// For full JSON documents, see json/parser.sio.

fn JV_NULL() -> i32 { 0 }
fn JV_INT() -> i32 { 1 }
fn JV_FLOAT() -> i32 { 2 }
fn JV_STRING() -> i32 { 3 }
fn JV_BOOL() -> i32 { 4 }

struct JsonValue {
    kind: i32,
    int_val: i64,
    float_val: f64,
    str_val: [u8; 64],
    str_len: i32
}

fn jv_null() -> JsonValue {
    JsonValue { kind: 0, int_val: 0, float_val: 0.0, str_val: [0; 64], str_len: 0 }
}

fn jv_int(v: i64) -> JsonValue {
    JsonValue { kind: 1, int_val: v, float_val: 0.0, str_val: [0; 64], str_len: 0 }
}

fn jv_float(v: f64) -> JsonValue {
    JsonValue { kind: 2, int_val: 0, float_val: v, str_val: [0; 64], str_len: 0 }
}

fn jv_string(s: &[u8; 64], len: i32) -> JsonValue with Mut, Panic, Div {
    var jv = JsonValue { kind: 3, int_val: 0, float_val: 0.0, str_val: [0; 64], str_len: len }
    var i: i32 = 0
    while i < len && i < 64 {
        jv.str_val[i] = s[i]
        i = i + 1
    }
    jv
}

fn jv_bool(v: bool) -> JsonValue {
    JsonValue { kind: 4, int_val: if v { 1 } else { 0 }, float_val: 0.0, str_val: [0; 64], str_len: 0 }
}

fn jv_is_null(v: JsonValue) -> bool { v.kind == 0 }
fn jv_is_int(v: JsonValue) -> bool { v.kind == 1 }
fn jv_is_float(v: JsonValue) -> bool { v.kind == 2 }
fn jv_is_string(v: JsonValue) -> bool { v.kind == 3 }
fn jv_is_bool(v: JsonValue) -> bool { v.kind == 4 }

fn jv_get_int(v: JsonValue) -> i64 { v.int_val }
fn jv_get_float(v: JsonValue) -> f64 { v.float_val }
fn jv_get_bool(v: JsonValue) -> bool { v.int_val != 0 }

// =============================================================================
// Tests
// =============================================================================

fn test_jv_null() -> bool {
    let v = jv_null()
    jv_is_null(v) && !jv_is_int(v)
}

fn test_jv_int() -> bool {
    let v = jv_int(42)
    jv_is_int(v) && jv_get_int(v) == 42
}

fn test_jv_float() -> bool {
    let v = jv_float(3.14)
    jv_is_float(v) && jv_get_float(v) == 3.14
}

fn test_jv_bool() -> bool {
    let v = jv_bool(true)
    jv_is_bool(v) && jv_get_bool(v)
}

fn main() with IO {
    if test_jv_null() { print("json null: PASS\n") } else { print("json null: FAIL\n") }
    if test_jv_int() { print("json int: PASS\n") } else { print("json int: FAIL\n") }
    if test_jv_float() { print("json float: PASS\n") } else { print("json float: FAIL\n") }
    if test_jv_bool() { print("json bool: PASS\n") } else { print("json bool: FAIL\n") }
}
