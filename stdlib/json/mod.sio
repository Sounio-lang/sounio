// stdlib/json/mod.sio — Public exports for the json module
//
// Per stdlib/CONVENTIONS.md §2, mod.sio declares only the public surface
// (pub use re-exports). Implementations live in the sibling files.

pub use json::parser::{
    JSON_ARRAY,
    JSON_BOOL,
    JSON_NULL,
    JSON_NUMBER,
    JSON_OBJECT,
    JSON_STRING,
    JsonBuf,
    JsonDoc,
    JsonValue,
    json_doc_contains,
    json_doc_count,
    json_doc_get_bool,
    json_doc_get_number,
    json_doc_get_string,
    json_doc_new,
    json_doc_set_bool,
    json_doc_set_number,
    json_doc_set_string,
    json_parse,
    json_self_test,
    json_serialize,
    json_serialize_to_buf,
    json_value_bool,
    json_value_null,
    json_value_number,
    json_value_string,
}


// Owned DOM and incremental writer. Flat JsonDoc/parser APIs retain their names.
pub use json::dom::{
    JsonDom, JsonNode, json_dom_status, json_dom_error_offset,
    json_dom_len, json_dom_node, json_dom_parse, json_dom_token,
    json_dom_i64, json_dom_close, json_dom_string, json_dom_key,
    json_dom_bool, json_dom_serialize, json_dom_find,
}

pub use json::writer::{
    JsonWriter, json_writer_new, json_writer_status, json_writer_key,
    json_writer_string, json_writer_null, json_writer_bool, json_writer_i64,
    json_writer_number, json_writer_begin_array, json_writer_begin_object, json_writer_end_array,
    json_writer_end_object, json_writer_finish, json_writer_close,
}
