// stdlib/json — JSON value representation and basic operations
//
// JsonValue: tagged union representing JSON values.
// tag 0=Null, 1=Bool, 2=Int, 3=Float, 4=Array, 5=Object
//
// Uses flat-array storage for arrays and objects (max 256 elements).

let JSON_NULL: i64 = 0
let JSON_BOOL: i64 = 1
let JSON_INT: i64 = 2
let JSON_FLOAT: i64 = 3
let JSON_ARRAY: i64 = 4
let JSON_OBJECT: i64 = 5

struct JsonValue {
    tag: i64,
    int_val: i64,
    float_val: f64,
    bool_val: i64,
}

fn json_null() -> JsonValue {
    JsonValue { tag: JSON_NULL, int_val: 0, float_val: 0.0, bool_val: 0 }
}

fn json_bool(b: bool) -> JsonValue {
    let v = if b { 1 } else { 0 }
    JsonValue { tag: JSON_BOOL, int_val: 0, float_val: 0.0, bool_val: v }
}

fn json_int(n: i64) -> JsonValue {
    JsonValue { tag: JSON_INT, int_val: n, float_val: 0.0, bool_val: 0 }
}

fn json_float(f: f64) -> JsonValue {
    JsonValue { tag: JSON_FLOAT, int_val: 0, float_val: f, bool_val: 0 }
}

impl JsonValue {
    fn is_null(self: &JsonValue) -> bool { self.tag == JSON_NULL }
    fn is_bool(self: &JsonValue) -> bool { self.tag == JSON_BOOL }
    fn is_int(self: &JsonValue) -> bool { self.tag == JSON_INT }
    fn is_float(self: &JsonValue) -> bool { self.tag == JSON_FLOAT }
    fn is_array(self: &JsonValue) -> bool { self.tag == JSON_ARRAY }
    fn is_object(self: &JsonValue) -> bool { self.tag == JSON_OBJECT }

    fn as_int(self: &JsonValue) -> i64 { self.int_val }
    fn as_float(self: &JsonValue) -> f64 { self.float_val }
    fn as_bool(self: &JsonValue) -> bool { self.bool_val != 0 }
}

// JsonArray: flat-array storage for up to 256 JSON values
struct JsonArray {
    tags: [i64; 256],
    int_vals: [i64; 256],
    float_vals: [f64; 256],
    len: i64,
}

impl JsonArray {
    fn new() -> JsonArray {
        JsonArray {
            tags: [0; 256],
            int_vals: [0; 256],
            float_vals: [0.0; 256],
            len: 0,
        }
    }

    fn push_int(self: &! JsonArray, v: i64) {
        if self.len >= 256 { return }
        let i = self.len
        self.tags[i] = JSON_INT
        self.int_vals[i] = v
        self.len = self.len + 1
    }

    fn push_float(self: &! JsonArray, v: f64) {
        if self.len >= 256 { return }
        let i = self.len
        self.tags[i] = JSON_FLOAT
        self.float_vals[i] = v
        self.len = self.len + 1
    }

    fn push_null(self: &! JsonArray) {
        if self.len >= 256 { return }
        let i = self.len
        self.tags[i] = JSON_NULL
        self.len = self.len + 1
    }

    fn len(self: &JsonArray) -> i64 { self.len }

    fn get_tag(self: &JsonArray, idx: i64) -> i64 {
        if idx < 0 || idx >= self.len { return JSON_NULL }
        self.tags[idx]
    }

    fn get_int(self: &JsonArray, idx: i64) -> i64 {
        if idx < 0 || idx >= self.len { return 0 }
        self.int_vals[idx]
    }

    fn get_float(self: &JsonArray, idx: i64) -> f64 {
        if idx < 0 || idx >= self.len { return 0.0 }
        self.float_vals[idx]
    }
}
