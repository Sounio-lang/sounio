// stdlib/json — JSON parser and serializer
//
// Provides a minimal flat key-value JSON document representation.
// Import: use json::parser::{json_doc_new, json_serialize, json_parse, ...}


// Submodules are resolved by path (`use json::<name>`);
// Sounio has no `mod` item, so the declarations that stood here were
// inert Rust syntax that also stopped this file parsing. Covered:
//   parser

// Owned DOM and incremental writer. Flat JsonDoc/parser APIs retain their names.
pub use json::dom::{
    JsonDom, JsonNode, json_dom_status, json_dom_error_offset,
    json_dom_len, json_dom_node, json_dom_parse, json_dom_token,
    json_dom_i64, json_dom_close, json_dom_string, json_dom_key,
    json_dom_bool, json_dom_serialize, json_dom_find,
}

pub use json::writer::{
    JsonWriter, json_writer_new, json_writer_status, json_writer_key,
    json_writer_string, json_writer_null, json_writer_bool, json_writer_i64,
    json_writer_number, json_writer_begin_array, json_writer_begin_object, json_writer_end_array,
    json_writer_end_object, json_writer_finish, json_writer_close,
}
