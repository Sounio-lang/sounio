// stdlib/ui/widget.sio — Widget definitions and hit testing

// ============================================================
// Widget kinds
// ============================================================

let WIDGET_PANEL:  i64 = 0
let WIDGET_BUTTON: i64 = 1
let WIDGET_LABEL:  i64 = 2
let WIDGET_INPUT:  i64 = 3

// ============================================================
// Widget struct
//
// Fixed-size text[64] avoids heap allocation per widget.
// bg_*/fg_* are 0-255 RGB components.
// ============================================================

pub struct Widget {
    pub id: i64,
    pub kind: i64,
    pub x: i64,
    pub y: i64,
    pub w: i64,
    pub h: i64,
    pub text: [i8; 64],
    pub text_len: i64,
    pub bg_r: i64, pub bg_g: i64, pub bg_b: i64,
    pub fg_r: i64, pub fg_g: i64, pub fg_b: i64,
}

// ============================================================
// UI interaction state (one per application)
// ============================================================

pub struct UiState {
    pub hovered_id: i64,   // id of widget under cursor, or -1
    pub pressed_id: i64,   // id of widget currently held, or -1
    pub clicked_id: i64,   // id of widget that received a click this frame, or -1
    pub focused_id: i64,   // id of text-input with keyboard focus, or -1
    pub mouse_x: i64,
    pub mouse_y: i64,
}

pub fn ui_state_new() -> UiState {
    UiState {
        hovered_id: 0 - 1,
        pressed_id: 0 - 1,
        clicked_id: 0 - 1,
        focused_id: 0 - 1,
        mouse_x: 0,
        mouse_y: 0,
    }
}

// ============================================================
// Hit testing
// ============================================================

pub fn ui_widget_hit(wid: Widget, x: i64, y: i64) -> bool {
    x >= wid.x && y >= wid.y && x < wid.x + wid.w && y < wid.y + wid.h
}

// Find the topmost widget at (x, y); returns index in widgets array or -1.
pub fn ui_hit_test(widgets: &[Widget; 64], n: i64, x: i64, y: i64) -> i64 {
    var idx = n - 1
    var result: i64 = 0 - 1
    var found = false
    while idx >= 0 && !found {
        if ui_widget_hit(widgets[idx as usize], x, y) {
            result = idx
            found = true
        }
        idx = idx - 1
    }
    result
}

// ============================================================
// Widget constructors (helpers for common kinds)
// ============================================================

pub fn widget_zero() -> Widget {
    Widget {
        id: 0, kind: 0, x: 0, y: 0, w: 0, h: 0,
        text: [0; 64], text_len: 0,
        bg_r: 0, bg_g: 0, bg_b: 0, fg_r: 0, fg_g: 0, fg_b: 0,
    }
}

pub fn widget_panel(id: i64, x: i64, y: i64, w: i64, h: i64, r: i64, g: i64, b: i64) -> Widget {
    var wid = Widget {
        id: id,
        kind: WIDGET_PANEL,
        x: x, y: y, w: w, h: h,
        text: [0; 64],
        text_len: 0,
        bg_r: r, bg_g: g, bg_b: b,
        fg_r: 255, fg_g: 255, fg_b: 255,
    }
    wid
}

pub fn widget_label(
    id: i64,
    x: i64, y: i64, w: i64, h: i64,
    label: &[i8; 64], label_len: i64,
    bg_r: i64, bg_g: i64, bg_b: i64,
    fg_r: i64, fg_g: i64, fg_b: i64,
) -> Widget {
    var wid = Widget {
        id: id,
        kind: WIDGET_LABEL,
        x: x, y: y, w: w, h: h,
        text: [0; 64],
        text_len: label_len,
        bg_r: bg_r, bg_g: bg_g, bg_b: bg_b,
        fg_r: fg_r, fg_g: fg_g, fg_b: fg_b,
    }
    // Copy label text
    var i: i64 = 0
    while i < label_len {
        wid.text[i as usize] = label[i as usize]
        i = i + 1
    }
    wid
}

pub fn widget_button(
    id: i64,
    x: i64, y: i64, w: i64, h: i64,
    label: &[i8; 64], label_len: i64,
) -> Widget {
    var wid = Widget {
        id: id,
        kind: WIDGET_BUTTON,
        x: x, y: y, w: w, h: h,
        text: [0; 64],
        text_len: label_len,
        bg_r: 60, bg_g: 100, bg_b: 160,
        fg_r: 255, fg_g: 255, fg_b: 255,
    }
    var i: i64 = 0
    while i < label_len {
        wid.text[i as usize] = label[i as usize]
        i = i + 1
    }
    wid
}
