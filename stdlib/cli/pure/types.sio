// stdlib/cli/pure/types.sio — CLI Types
//
// Fixed-capacity argument parsing.

module cli::pure::types

pub struct Args {
    pub argc: i32,
    pub argv: [string; 32],
}

pub fn args_new() -> Args {
    Args { argc: 0, argv: [""; 32] }
}

pub fn args_push(arg: &! Args, s: string) with Mut {
    if arg.argc < 32 {
        arg.argv[arg.argc as usize] = s
        arg.argc = arg.argc + 1
    }
}

pub fn args_get(arg: &Args, idx: i32) -> string {
    if idx >= 0 && idx < arg.argc {
        arg.argv[idx as usize]
    } else {
        ""
    }
}

pub fn args_count(arg: &Args) -> i32 { arg.argc }