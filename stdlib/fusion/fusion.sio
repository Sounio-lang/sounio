// fusion/mod.sio — Sensor/Data Fusion
//
// Weighted mean fusion and Dempster-Shafer evidence combination.
//
// References:
// - Shafer (1976): "A Mathematical Theory of Evidence"
// - Hall & Llinas (2001): "Handbook of Multisensor Data Fusion"
// - JCGM 100:2008 (GUM) for weighted mean of measurements

fn fus_abs(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn fus_sqrt(x: f64) -> f64 {
    if x <= 0.0 { return 0.0 }
    var y = x
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y
}

// ============================================================================
// FUSION RESULT
// ============================================================================

pub struct FusionResult {
    pub value: f64,       // Fused estimate
    pub confidence: f64,  // Confidence/weight sum (0-1 scale)
    pub n_sources: i32,   // Number of sources combined
}

pub fn fusion_result_new(value: f64, confidence: f64, n_sources: i32) -> FusionResult {
    FusionResult { value: value, confidence: confidence, n_sources: n_sources }
}

// ============================================================================
// WEIGHTED MEAN FUSION
// ============================================================================
// Inverse-variance-like weighted combination: fused = sum(w_i * v_i) / sum(w_i)
// Confidence = normalized total weight (capped at 1.0)

pub fn fusion_weighted_mean(values: &[f64; 16], weights: &[f64; 16], n: i32) -> FusionResult {
    if n <= 0 {
        return FusionResult { value: 0.0, confidence: 0.0, n_sources: 0 }
    }

    var wsum = 0.0
    var vsum = 0.0
    var count: i32 = 0
    var i: i32 = 0
    while i < n {
        let w = weights[i as usize]
        if w > 0.0 {
            vsum = vsum + w * values[i as usize]
            wsum = wsum + w
            count = count + 1
        }
        i = i + 1
    }

    if wsum <= 0.0 {
        return FusionResult { value: 0.0, confidence: 0.0, n_sources: 0 }
    }

    let fused = vsum / wsum
    // Confidence: normalized weight per source, capped at 1.0
    var conf = wsum / (n as f64)
    if conf > 1.0 { conf = 1.0 }

    FusionResult { value: fused, confidence: conf, n_sources: count }
}

// ============================================================================
// DEMPSTER-SHAFER COMBINATION
// ============================================================================
// Combines belief mass functions from multiple independent sources.
// beliefs[i] = belief mass for hypothesis H from source i (0 <= bel <= 1)
//
// Dempster's rule (simplified for single hypothesis):
//   combined = product of belief masses / (1 - conflict)
//   conflict K = 1 - combined (for contradictory evidence)
//
// Returns the combined belief in hypothesis H.

pub fn fusion_dempster_shafer(beliefs: &[f64; 16], n: i32) -> f64 {
    if n <= 0 {
        return 0.0
    }
    if n == 1 {
        return beliefs[0]
    }

    // Start with first source
    var combined_bel = beliefs[0]
    var combined_disbelief = 1.0 - beliefs[0]

    var i: i32 = 1
    while i < n {
        let b = beliefs[i as usize]
        let d = 1.0 - b

        // Dempster's rule for focal elements:
        // Agreement: both believe H
        let agree = combined_bel * b
        // Both disbelieve
        let both_dis = combined_disbelief * d
        // Conflict: one believes, other disbelieves
        let conflict = combined_bel * d + combined_disbelief * b

        // Normalization factor
        let k = combined_bel * d + combined_disbelief * b
        // combined_bel * b + combined_disbelief * d is the non-conflicting mass
        let non_conflict = agree + both_dis

        if non_conflict <= 0.0 {
            return 0.0
        }

        // Normalize: redistribute conflict proportionally
        combined_bel = agree / non_conflict
        combined_disbelief = both_dis / non_conflict

        i = i + 1
    }

    combined_bel
}

// ============================================================================
// INLINE TESTS
// ============================================================================

//@ run-pass
fn test_weighted_mean_uniform() -> i32 {
    var values: [f64; 16] = [0.0; 16]
    var weights: [f64; 16] = [0.0; 16]
    values[0] = 10.0
    values[1] = 20.0
    values[2] = 30.0
    weights[0] = 1.0
    weights[1] = 1.0
    weights[2] = 1.0
    let r = fusion_weighted_mean(&values, &weights, 3)
    if fus_abs(r.value - 20.0) > 0.001 { return 1 }
    if r.n_sources != 3 { return 2 }
    0
}

//@ run-pass
fn test_weighted_mean_skewed() -> i32 {
    var values: [f64; 16] = [0.0; 16]
    var weights: [f64; 16] = [0.0; 16]
    values[0] = 0.0
    values[1] = 100.0
    weights[0] = 1.0
    weights[1] = 3.0
    let r = fusion_weighted_mean(&values, &weights, 2)
    // 0*1 + 100*3 / (1+3) = 75
    if fus_abs(r.value - 75.0) > 0.001 { return 1 }
    0
}

//@ run-pass
fn test_dempster_shafer_high_agreement() -> i32 {
    var beliefs: [f64; 16] = [0.0; 16]
    beliefs[0] = 0.9
    beliefs[1] = 0.9
    let c = fusion_dempster_shafer(&beliefs, 2)
    // Two sources both 0.9: combined should be > 0.9
    if c < 0.9 { return 1 }
    0
}

//@ run-pass
fn test_dempster_shafer_single() -> i32 {
    var beliefs: [f64; 16] = [0.0; 16]
    beliefs[0] = 0.7
    let c = fusion_dempster_shafer(&beliefs, 1)
    if fus_abs(c - 0.7) > 0.001 { return 1 }
    0
}
