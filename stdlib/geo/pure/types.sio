// stdlib/geo/pure/types.sio — Geometry Types
//
// Fixed-capacity geometric primitives.

module geo::pure::types

pub struct Point2D {
    pub x: f64,
    pub y: f64,
}

pub struct Point3D {
    pub x: f64,
    pub y: f64,
    pub z: f64,
}

pub struct LineSegment2D {
    pub p1: Point2D,
    pub p2: Point2D,
}

pub struct Triangle2D {
    pub p1: Point2D,
    pub p2: Point2D,
    pub p3: Point2D,
}

pub fn point2d_new(x: f64, y: f64) -> Point2D {
    Point2D { x: x, y: y }
}

pub fn point3d_new(x: f64, y: f64, z: f64) -> Point3D {
    Point3D { x: x, y: y, z: z }
}

pub fn point2d_distance(p1: &Point2D, p2: &Point2D) -> f64 with Div {
    let dx = p2.x - p1.x
    let dy = p2.y - p1.y
    sqrt(dx * dx + dy * dy)
}

pub fn point3d_distance(p1: &Point3D, p2: &Point3D) -> f64 with Div {
    let dx = p2.x - p1.x
    let dy = p2.y - p1.y
    let dz = p2.z - p1.z
    sqrt(dx * dx + dy * dy + dz * dz)
}

pub fn triangle_area_2d(t: &Triangle2D) -> f64 with Div {
    let ax = t.p2.x - t.p1.x
    let ay = t.p2.y - t.p1.y
    let bx = t.p3.x - t.p1.x
    let by = t.p3.y - t.p1.y
    let cross = ax * by - ay * bx
    abs(cross) / 2.0
}

pub fn line_segment_contains_point_2d(seg: &LineSegment2D, p: &Point2D) -> bool with Div {
    let d1 = point2d_distance(&seg.p1, p)
    let d2 = point2d_distance(&seg.p2, p)
    let seg_len = point2d_distance(&seg.p1, &seg.p2)
    let tol = 1e-9
    d1 + d2 - seg_len < tol
}

pub fn point2d_dot(p1: &Point2D, p2: &Point2D) -> f64 {
    p1.x * p2.x + p1.y * p2.y
}

pub fn point3d_dot(p1: &Point3D, p2: &Point3D) -> f64 {
    p1.x * p2.x + p1.y * p2.y + p1.z * p2.z
}

pub fn point2d_cross(p1: &Point2D, p2: &Point2D) -> f64 {
    p1.x * p2.y - p1.y * p2.x
}

fn abs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

fn sqrt(x: f64) -> f64 with Div { x }