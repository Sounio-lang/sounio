// stdlib/geo/pure/epistemic.sio — Epistemic Geometry Operations
//
// Epistemic variants of geo operations that propagate measurement uncertainty.
// Uses GUM variance propagation from stdlib/epistemic/knowledge.sio.

pub struct EPoint2D {
    pub x: Epistemic,
    pub y: Epistemic,
}

pub struct EPoint3D {
    pub x: Epistemic,
    pub y: Epistemic,
    pub z: Epistemic,
}

pub struct ETriangle2D {
    pub p1: EPoint2D,
    pub p2: EPoint2D,
    pub p3: EPoint2D,
}

pub fn epoint2d_new(x: f64, y: f64) -> EPoint2D {
    EPoint2D { x: Epistemic::certain(x), y: Epistemic::certain(y) }
}

pub fn epoint2d_measured(x: f64, x_std: f64, y: f64, y_std: f64) -> EPoint2D with Mut, Div {
    EPoint2D { x: Epistemic::measured(x, x_std), y: Epistemic::measured(y, y_std) }
}

pub fn epoint3d_new(x: f64, y: f64, z: f64) -> EPoint3D {
    EPoint3D { x: Epistemic::certain(x), y: Epistemic::certain(y), z: Epistemic::certain(z) }
}

pub fn epoint3d_measured(x: f64, x_std: f64, y: f64, y_std: f64, z: f64, z_std: f64) -> EPoint3D with Mut, Div {
    EPoint3D { x: Epistemic::measured(x, x_std), y: Epistemic::measured(y, y_std), z: Epistemic::measured(z, z_std) }
}

pub fn epoint2d_distance(p1: &EPoint2D, p2: &EPoint2D) -> Epistemic with Mut, Div {
    let dx = p2.x.sub(&p1.x)
    let dy = p2.y.sub(&p1.y)
    let dx2 = dx.square()
    let dy2 = dy.square()
    let dist2 = dx2.add(&dy2)
    dist2.sqrt()
}

pub fn epoint3d_distance(p1: &EPoint3D, p2: &EPoint3D) -> Epistemic with Mut, Div {
    let dx = p2.x.sub(&p1.x)
    let dy = p2.y.sub(&p1.y)
    let dz = p2.z.sub(&p1.z)
    let dx2 = dx.square()
    let dy2 = dy.square()
    let dz2 = dz.square()
    let dist2 = dx2.add(&dy2).add(&dz2)
    dist2.sqrt()
}

pub fn etriangle_area_2d(t: &ETriangle2D) -> Epistemic with Mut, Div {
    let ax = t.p2.x.sub(&t.p1.x)
    let ay = t.p2.y.sub(&t.p1.y)
    let bx = t.p3.x.sub(&t.p1.x)
    let by = t.p3.y.sub(&t.p1.y)
    let cross = ax.mul(&by).sub(&ay.mul(&bx))
    cross.abs().scale(0.5)
}

fn ep_abs(e: &Epistemic) -> Epistemic {
    if e.val >= 0.0 { *e } else { e.scale(-1.0) }
}