// Unit system: Natural / Planck / Geometric units
// Gen 19: In ℏ=c=1 natural units, all quantities are powers of energy.
// The compiler treats natural-unit quantities as dimensionless at the type level,
// since mixing natural and SI units requires explicit conversion.
//@ run-pass

// ── Planck units ──────────────────────────────────────────────────────────────
// All dimensionless in the type system — they encode ratios to Planck scale.
unit lP;    // Planck length    = 1.616e-35 m  [dimensionless]
unit tP;    // Planck time      = 5.391e-44 s  [dimensionless]
unit mP;    // Planck mass      = 2.176e-8 kg  [dimensionless]
unit TP;    // Planck temperature = 1.417e32 K [dimensionless]
unit EP;    // Planck energy    = 1.956e9 J    [dimensionless]

// ── Gaussian / Heaviside-Lorentz (field theory) ────────────────────────────────
// c=ε₀=μ₀=1 — electromagnetism uses unified [energy²] dimensions.
unit eVc2;  // eV/c² — natural mass unit in particle physics [dimensionless]

// Planck unit conversion constants (SI values)
let LP_TO_M:    f64 = 1.61622837e-35    // Planck length in metres
let TP_TO_S:    f64 = 5.39124760e-44    // Planck time in seconds
let MP_TO_KG:   f64 = 2.17643524e-8     // Planck mass in kg
let TP_TEMP_K:  f64 = 1.41678416e32     // Planck temperature in Kelvin
let EP_TO_J:    f64 = 1.95610526e9      // Planck energy in joules

// Physical constants (for natural-unit conversions)
let HBAR:       f64 = 1.054571817e-34   // J·s
let C_LIGHT:    f64 = 2.99792458e8      // m/s
let G_NEWTON:   f64 = 6.67430e-11       // N·m²/kg²
let KB:         f64 = 1.380649e-23      // J/K

// Conversion helpers: SI → natural units (all relative to energy in eV)
fn si_mass_to_eV(kg: f64) -> f64 {
    // E = mc² → mass in eV = kg × c² / e
    let eV_per_J: f64 = 6.241509074e18
    return kg * C_LIGHT * C_LIGHT * eV_per_J
}

fn si_length_to_eV_inv(m: f64) -> f64 {
    // length in ℏc/eV = m × eV / (ℏc)
    let hbar_c_eVm: f64 = 1.97326980459e-7  // ℏc in eV·m
    return m / hbar_c_eVm
}

fn si_time_to_eV_inv(sec: f64) -> f64 {
    let hbar_eV_s: f64 = 6.582119569e-16  // ℏ in eV·s
    return sec / hbar_eV_s
}

// Example: Planck scale ratios
fn natural_units_demo() -> i32 with IO {
    let proton_mass_kg: f64 = 1.67262192369e-27
    let proton_mass_eV: f64 = si_mass_to_eV(proton_mass_kg)
    println("Proton mass in natural units (eV):")
    print_f64(proton_mass_eV)
    println(" eV/c²")
    println("Expected: ~938.3e6 eV = 938.3 MeV")
    let electron_radius_m: f64 = 2.8179403227e-15  // classical electron radius
    let r_nat: f64 = si_length_to_eV_inv(electron_radius_m)
    println("Classical electron radius in natural units: ~14.4 eV^-1")
    return 0
}

fn main() -> i32 with IO {
    return natural_units_demo()
}
