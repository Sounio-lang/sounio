// Unit system: Atomic and Nuclear
// Gen 19: dimensional analysis — eV, keV, MeV, GeV, u, amu preloaded
//@ run-pass

// ── Energy ────────────────────────────────────────────────────────────────────
unit eV;    // electron-volt        = 1.602e-19 J
unit keV;   // kilo-electron-volt   = 1.602e-16 J
unit MeV;   // mega-electron-volt   = 1.602e-13 J
unit GeV;   // giga-electron-volt   = 1.602e-10 J
unit TeV;   // tera-electron-volt   = 1.602e-7 J

// ── Mass ──────────────────────────────────────────────────────────────────────
unit u;     // unified atomic mass unit = 1.66054e-27 kg  (also: Da, amu)
unit amu;   // alias for u
unit me;    // electron mass = 9.10938e-31 kg

// ── Length ────────────────────────────────────────────────────────────────────
unit nm;    // nanometre    = 1e-9 m
unit pm;    // picometre    = 1e-12 m  (bond lengths)
unit fm;    // femtometre   = 1e-15 m  (nuclear radii; 1 fm = 1 fermi)

// ── Natural units (ℏ=c=1 system) ─────────────────────────────────────────────
// In the natural unit system all quantities reduce to powers of energy (eV).
// Length = 1/energy, time = 1/energy, mass = energy.
// We declare these as dimensionless since mixing natural and SI units is undefined.
unit hbar_eV; // reduced Planck constant in eV·s (= 6.582e-16 eV·s) [dimensionless]
unit c_nat;   // speed of light in natural units = 1 [dimensionless]

// ── Atomic physics ────────────────────────────────────────────────────────────
unit Bohr;  // Bohr radius a₀ = 5.292e-11 m (length^1)
unit Hartree; // Hartree energy Eₕ = 27.211 eV (energy)

// Conversion constants
let EV_TO_J:       f64 = 1.60217663e-19
let KEV_TO_J:      f64 = 1.60217663e-16
let MEV_TO_J:      f64 = 1.60217663e-13
let GEV_TO_J:      f64 = 1.60217663e-10
let U_TO_KG:       f64 = 1.66053906660e-27
let ME_TO_KG:      f64 = 9.1093837015e-31
let NM_TO_M:       f64 = 1.0e-9
let PM_TO_M:       f64 = 1.0e-12
let FM_TO_M:       f64 = 1.0e-15
let BOHR_TO_M:     f64 = 5.29177210903e-11
let HARTREE_TO_EV: f64 = 27.211396132
let HARTREE_TO_J:  f64 = 4.3597447222071e-18
let ALPHA_FINE:    f64 = 7.2973525693e-3  // fine structure constant (dimensionless)
let HBAR_EV_S:     f64 = 6.582119569e-16  // ℏ in eV·s
let C_LIGHT:       f64 = 2.99792458e8     // m/s

// Example: nuclear binding energy
fn atomic_demo() -> i32 with IO {
    // He-4 binding energy
    let binding: MeV = 28.295673   // total binding energy
    let per_nucleon: f64 = binding / 4.0  // MeV per nucleon
    println("He-4 binding energy: 28.30 MeV")
    print("Per nucleon: ")
    print_f64(per_nucleon)
    println(" MeV/nucleon")
    // Hydrogen 1s orbital radius
    let r_hydrogen: Bohr = 1.0
    let r_m: f64 = r_hydrogen * BOHR_TO_M
    println("Hydrogen 1s radius = 1 Bohr = 5.29e-11 m")
    return 0
}

fn main() -> i32 with IO {
    return atomic_demo()
}
