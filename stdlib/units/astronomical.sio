// Unit system: Astronomical
// Gen 19: dimensional analysis — AU, pc, ly, Msun preloaded
//@ run-pass

// ── Astronomical length ───────────────────────────────────────────────────────
unit AU;    // astronomical unit = 1.496e11 m   (Earth–Sun mean distance)
unit pc;    // parsec            = 3.086e16 m   (1 AU / 1 arcsecond)
unit ly;    // light-year        = 9.461e15 m
unit kpc;   // kiloparsec        = 3.086e19 m
unit Mpc;   // megaparsec        = 3.086e22 m
unit Gpc;   // gigaparsec        = 3.086e25 m

// ── Astronomical mass ─────────────────────────────────────────────────────────
unit Msun;  // solar mass        = 1.989e30 kg
unit Mearth; // Earth mass       = 5.972e24 kg
unit Mjup;  // Jupiter mass      = 1.898e27 kg

// ── Astronomical time ─────────────────────────────────────────────────────────
unit yr;    // Julian year       = 3.156e7 s
unit kyr;   // kiloyear          = 3.156e10 s
unit Myr;   // megayear          = 3.156e13 s
unit Gyr;   // gigayear          = 3.156e16 s

// ── Flux density (radio/optical astronomy) ───────────────────────────────────
// Jansky: 1 Jy = 1e-26 W/(m²·Hz) — non-SI, cannot combine with SI dims cleanly
unit Jy;    // jansky (spectral flux density) [declared dimensionless at type level]
unit mJy;   // millijansky

// Conversion constants
let AU_TO_M:     f64 = 1.495978707e11
let PC_TO_M:     f64 = 3.085677581e16
let LY_TO_M:     f64 = 9.460730473e15
let KPC_TO_M:    f64 = 3.085677581e19
let MPC_TO_M:    f64 = 3.085677581e22
let MSUN_TO_KG:  f64 = 1.989e30
let MEARTH_TO_KG: f64 = 5.972e24
let YR_TO_S:     f64 = 3.15576e7
let C_LIGHT:     f64 = 2.99792458e8  // m/s

// Example: stellar distance ladder
fn astro_demo() -> i32 with IO {
    let dist_alpha_cen: ly  = 4.367    // distance to Alpha Centauri
    let dist_m31:       Mpc = 0.785    // distance to Andromeda galaxy
    let mass_sun:       Msun = 1.0
    let mass_sgr_a:     Msun = 4.0e6   // Sagittarius A* black hole
    let dist_m:   f64 = dist_alpha_cen * LY_TO_M
    let mass_kg:  f64 = mass_sgr_a * MSUN_TO_KG
    println("Alpha Centauri distance: 4.367 ly")
    println("Sgr A* mass: ~4e6 solar masses")
    return 0
}

fn main() -> i32 with IO {
    return astro_demo()
}
