// units/qudt.sio — QUDT-aligned unit system
// Provides dimensional analysis primitives compatible with QUDT ontology

struct UnitDim {
    length: i32,
    mass: i32,
    time: i32,
    current: i32,
    temperature: i32,
    amount: i32,
    luminosity: i32,
}

fn dim_dimensionless() -> UnitDim {
    UnitDim { length: 0, mass: 0, time: 0, current: 0, temperature: 0, amount: 0, luminosity: 0 }
}

fn dim_length() -> UnitDim {
    UnitDim { length: 1, mass: 0, time: 0, current: 0, temperature: 0, amount: 0, luminosity: 0 }
}

fn dim_mass() -> UnitDim {
    UnitDim { length: 0, mass: 1, time: 0, current: 0, temperature: 0, amount: 0, luminosity: 0 }
}

fn dim_time() -> UnitDim {
    UnitDim { length: 0, mass: 0, time: 1, current: 0, temperature: 0, amount: 0, luminosity: 0 }
}

fn dim_velocity() -> UnitDim {
    UnitDim { length: 1, mass: 0, time: 0 - 1, current: 0, temperature: 0, amount: 0, luminosity: 0 }
}

fn dim_force() -> UnitDim {
    UnitDim { length: 1, mass: 1, time: 0 - 2, current: 0, temperature: 0, amount: 0, luminosity: 0 }
}

fn dim_energy() -> UnitDim {
    UnitDim { length: 2, mass: 1, time: 0 - 2, current: 0, temperature: 0, amount: 0, luminosity: 0 }
}

fn dim_multiply(a: UnitDim, b: UnitDim) -> UnitDim {
    UnitDim {
        length: a.length + b.length,
        mass: a.mass + b.mass,
        time: a.time + b.time,
        current: a.current + b.current,
        temperature: a.temperature + b.temperature,
        amount: a.amount + b.amount,
        luminosity: a.luminosity + b.luminosity,
    }
}

fn dim_divide(a: UnitDim, b: UnitDim) -> UnitDim {
    UnitDim {
        length: a.length - b.length,
        mass: a.mass - b.mass,
        time: a.time - b.time,
        current: a.current - b.current,
        temperature: a.temperature - b.temperature,
        amount: a.amount - b.amount,
        luminosity: a.luminosity - b.luminosity,
    }
}

fn dim_equal(a: UnitDim, b: UnitDim) -> bool {
    a.length == b.length && a.mass == b.mass && a.time == b.time &&
    a.current == b.current && a.temperature == b.temperature &&
    a.amount == b.amount && a.luminosity == b.luminosity
}

fn dim_is_dimensionless(d: UnitDim) -> bool {
    dim_equal(d, dim_dimensionless())
}

struct Quantity {
    value: f64,
    dim: UnitDim,
}

fn quantity_new(value: f64, dim: UnitDim) -> Quantity {
    Quantity { value: value, dim: dim }
}

fn quantity_add(a: Quantity, b: Quantity) -> Quantity {
    // Only valid if dimensions match
    Quantity { value: a.value + b.value, dim: a.dim }
}

fn quantity_mul(a: Quantity, b: Quantity) -> Quantity {
    Quantity { value: a.value * b.value, dim: dim_multiply(a.dim, b.dim) }
}

fn quantity_div(a: Quantity, b: Quantity) -> Quantity with Div, Panic, Mut {
    Quantity { value: a.value / b.value, dim: dim_divide(a.dim, b.dim) }
}

fn test_velocity_dim() -> bool {
    let dist = quantity_new(100.0, dim_length())
    let time = quantity_new(10.0, dim_time())
    let vel = quantity_div(dist, time)
    dim_equal(vel.dim, dim_velocity())
}

fn test_force_dim() -> bool {
    let mass = quantity_new(10.0, dim_mass())
    let accel = quantity_new(9.8, UnitDim { length: 1, mass: 0, time: 0 - 2, current: 0, temperature: 0, amount: 0, luminosity: 0 })
    let force = quantity_mul(mass, accel)
    dim_equal(force.dim, dim_force())
}
