// Unit system: Imperial / US Customary
// Gen 19: dimensional analysis — all units preloaded in init_unit_table()
// This file provides documentation and Sounio-level declarations.
//@ run-pass

// ── Mass ──────────────────────────────────────────────────────────────────────
unit lb;     // pound           = 0.453592 kg
unit oz;     // ounce           = 0.028350 kg
unit ton;    // short ton       = 907.185 kg  (US ton)
unit stone;  // stone           = 6.35029 kg

// ── Length ────────────────────────────────────────────────────────────────────
unit in;     // inch            = 0.0254 m
unit ft;     // foot            = 0.3048 m
unit yd;     // yard            = 0.9144 m
unit mi;     // mile            = 1609.34 m
unit nmi;    // nautical mile   = 1852 m

// ── Pressure ──────────────────────────────────────────────────────────────────
unit psi;    // pounds/inch²   = 6894.76 Pa
unit atm;    // atmosphere     = 101325 Pa
unit bar;    // bar            = 100000 Pa

// ── Volume ────────────────────────────────────────────────────────────────────
unit gal;    // gallon (US)    = 3.785e-3 m³
unit qt;     // quart (US)     = 9.464e-4 m³
unit floz;   // fluid ounce    = 29.574e-6 m³

// ── Energy ────────────────────────────────────────────────────────────────────
unit BTU;    // British Thermal Unit = 1055.06 J
unit cal;    // thermochemical calorie = 4.184 J
unit kcal;   // kilocalorie    = 4184 J

// ── Temperature ───────────────────────────────────────────────────────────────
unit degF;   // Fahrenheit (offset from Kelvin: K = (°F + 459.67) × 5/9)

// ── Power ─────────────────────────────────────────────────────────────────────
unit hp;     // horsepower     = 745.7 W

// Conversion constants (scale-only, no dimension conversion needed at type level)
let LB_TO_KG:   f64 = 0.453592
let OZ_TO_KG:   f64 = 0.028350
let IN_TO_M:    f64 = 0.0254
let FT_TO_M:    f64 = 0.3048
let YD_TO_M:    f64 = 0.9144
let MI_TO_M:    f64 = 1609.344
let NMI_TO_M:   f64 = 1852.0
let GAL_TO_M3:  f64 = 0.003785411784
let BTU_TO_J:   f64 = 1055.06
let CAL_TO_J:   f64 = 4.184
let HP_TO_W:    f64 = 745.69987

// Example: dimensional type checking
fn imperial_demo() -> i32 with IO {
    let body_weight: lb  = 154.0     // 70 kg person
    let height:      ft  = 5.9       // ~180 cm
    let blood_press: psi = 1.74      // ~120 mmHg systolic
    // weight_kg = weight_lb * LB_TO_KG  (f64 * f64 → f64, unit tracking via runtime)
    let weight_kg: f64 = body_weight * LB_TO_KG
    println("weight in kg:")
    print_f64(weight_kg)
    println("")
    return 0
}

fn main() -> i32 with IO {
    return imperial_demo()
}
