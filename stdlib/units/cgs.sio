// Unit system: CGS (Centimetre-Gram-Second)
// Gen 19: dimensional analysis — base units cm, g, s are preloaded
//@ run-pass

// ── CGS base ──────────────────────────────────────────────────────────────────
unit cm;    // centimetre (length^1)  = 0.01 m
unit g;     // gram (mass^1)          = 0.001 kg
unit s;     // second (time^1)        — same as SI

// ── CGS mechanical ────────────────────────────────────────────────────────────
unit dyn;   // dyne (force)           = 1e-5 N   = g·cm/s²
unit erg;   // erg (energy)           = 1e-7 J   = g·cm²/s²
unit P;     // poise (dynamic viscosity) = 0.1 Pa·s  = g/(cm·s)
unit St;    // stokes (kinematic viscosity) = 1e-4 m²/s = cm²/s
unit Gal;   // galileo (acceleration) = 0.01 m/s²  = cm/s²

// ── CGS electromagnetic (Gaussian) ───────────────────────────────────────────
// Note: Gaussian units unify E and B in one system; dimensionality differs from SI.
// These are declared as dimensionless at the type-system level since they cannot
// be safely combined with SI electromagnetic units.
unit Gs;    // gauss (magnetic flux density) = 1e-4 T  [dimensionless in type system]
unit Oe;    // oersted (magnetic field)       = 79.577 A/m [dimensionless in type system]
unit Mx;    // maxwell (magnetic flux)        = 1e-8 Wb [dimensionless in type system]
unit statC; // statcoulomb (charge)           = 3.336e-10 C [dimensionless in type system]

// Conversion constants
let DYN_TO_N:      f64 = 1.0e-5
let ERG_TO_J:      f64 = 1.0e-7
let CM_TO_M:       f64 = 0.01
let G_TO_KG:       f64 = 0.001
let GS_TO_T:       f64 = 1.0e-4     // gauss → tesla
let OE_TO_AM:      f64 = 79.5774715 // oersted → A/m

// Example: CGS mechanics
fn cgs_demo() -> i32 with IO {
    let force:  dyn = 1.0e6     // 10 N in dynes
    let energy: erg = 1.0e7     // 1 J in ergs
    let force_n:  f64 = force  * DYN_TO_N
    let energy_j: f64 = energy * ERG_TO_J
    println("10 N in dynes: 1e6 dyn")
    println("1 J in ergs:   1e7 erg")
    return 0
}

fn main() -> i32 with IO {
    return cgs_demo()
}
