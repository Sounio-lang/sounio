// Unit system: Pharmacological
// Gen 19: dimensional analysis — mg, mcg, ng, mmHg, mEq, IU preloaded
// Clinical and laboratory medicine units.
//@ run-pass

// ── Pharmacological mass/dose ─────────────────────────────────────────────────
unit mg;    // milligram   (mass^1)   = 1e-6 kg
unit mcg;   // microgram   (mass^1)   = 1e-9 kg
unit ng;    // nanogram    (mass^1)   = 1e-12 kg

// ── Volume ────────────────────────────────────────────────────────────────────
unit mL;    // millilitre  (length^3) = 1e-6 m³
unit uL;    // microlitre  (length^3) = 1e-9 m³
unit dL;    // decilitre   (length^3) = 1e-4 m³

// ── Pressure ──────────────────────────────────────────────────────────────────
unit mmHg;  // millimetres of mercury (pressure) = 133.322 Pa

// ── Amount / concentration ────────────────────────────────────────────────────
unit mol;   // mole        (amount^1)
unit mmol;  // millimole   (amount^1) = 1e-3 mol
unit umol;  // micromole   (amount^1) = 1e-6 mol
unit mEq;   // milliequivalent (amount^1) ≈ mmol for monovalent ions

// ── Activity / biological ─────────────────────────────────────────────────────
unit IU;    // international unit (dimensionless biological activity)
unit mIU;   // milli-international unit

// ── Time ──────────────────────────────────────────────────────────────────────
unit h;     // hour  = 3600 s
unit min;   // minute = 60 s
unit d;     // day   = 86400 s

// Conversion constants
let MG_TO_KG:    f64 = 1.0e-6
let MCG_TO_KG:   f64 = 1.0e-9
let NG_TO_KG:    f64 = 1.0e-12
let ML_TO_M3:    f64 = 1.0e-6
let MMHG_TO_PA:  f64 = 133.322
let MMOL_TO_MOL: f64 = 1.0e-3

// Standard clinical dosing helpers

// Weight-based dose: mg/kg × body_weight_kg → dose_mg
fn dose_mg_per_kg(dose_per_kg: f64, weight_kg: f64) -> f64 {
    return dose_per_kg * weight_kg
}

// Blood pressure classification (systolic mmHg)
fn bp_classify(systolic: mmHg) -> i32 with IO {
    let s: f64 = systolic
    if s < 120.0 {
        println("Normal")
    } else if s < 130.0 {
        println("Elevated")
    } else if s < 140.0 {
        println("Hypertension Stage 1")
    } else {
        println("Hypertension Stage 2")
    }
    return 0
}

// Example: dosing calculation
fn pharma_demo() -> i32 with IO {
    let body_weight: f64 = 70.0         // kg
    let dose_rate:   f64 = 10.0         // mg/kg
    let dose: mg = dose_mg_per_kg(dose_rate, body_weight)  // 700 mg
    let bp_sys: mmHg = 135.0
    println("Dose calculation:")
    print("  10 mg/kg × 70 kg = ")
    print_f64(dose)
    println(" mg")
    println("Blood pressure classification (135 mmHg systolic):")
    let _ = bp_classify(bp_sys)
    return 0
}

fn main() -> i32 with IO {
    return pharma_demo()
}
