// stdlib/dataframe/lib.sio — Tabular Data Analysis
//
// Working DataFrame implementation uses flat fixed-array layout (max 4 cols, 64 rows).
// Import directly from stdlib/dataframe/pure/core.sio — that file is self-contained
// and exports all operations: df_new, df_head, df_tail, col_mean, col_std,
// col_correlation, col_covariance, col_quantile_50, df_unique_count.
//
// FFI (Arrow C Data Interface) is deferred until extern "C" ABI stability lands.
// Use arrow_available() → false to guard any FFI code paths.
//
// References:
//   Wickham (2014) "Tidy Data" — Journal of Statistical Software
//   Apache Arrow columnar format specification

pub fn arrow_available() -> bool { false }
