// stdlib/dataframe/ffi/wrapper.sio — Arrow FFI Wrapper

use stdlib::dataframe::ffi::bindings

pub fn arrow_dataframe_from_columns(columns: Vec<Column>, n_rows: i64) -> bool {
    if !bindings::arrow_available() {
        return false
    }
    true
}

pub fn arrow_dataframe_to_columns() -> Result<Vec<Column>, String> {
    Err("Arrow FFI not available".to_string())
}