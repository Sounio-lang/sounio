// stdlib/dataframe/ffi/bindings.sio — FFI Bindings for Apache Arrow
//
// FFI declarations for the Arrow C Data interface.

extern "C" {
    fn ArrowArrayInit(schema: *mut ArrowSchema) -> i32
    fn ArrowArrayRelease(array: *mut ArrowArray) -> void
    fn ArrowArrayAppend(array: *mut ArrowArray, typ: i32, data: *const u8, len: i64) -> i32
    fn ArrowSchemaInit(schema: *mut ArrowSchema, format: *const u8) -> i32
    fn ArrowSchemaRelease(schema: *mut ArrowSchema) -> void
}

struct ArrowArray { private: [u8; 0] }
struct ArrowSchema { private: [u8; 0] }

let ARROW_INT64: i32 = 1
let ARROW_DOUBLE: i32 = 2
let ARROW_STRING: i32 = 3
let ARROW_BINARY: i32 = 4

pub fn arrow_available() -> bool { false }