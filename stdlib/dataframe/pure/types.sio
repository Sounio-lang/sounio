// stdlib/dataframe/pure/types.sio — DataFrame Core Types (aspirational stub).
//
// A full generics-backed DataFrame requires Vec<T>, String, and enum payloads
// — features not yet available in the running compiler.
//
// The working flat-layout DataFrame used by tests/stdlib_dataframe is:
//   struct DataFrame { n_cols: i32, n_rows: i32, col_names: [string; 4], data: [f64; 256] }
// with cell indexing: data[col * 64 + row]
//
// Full type hierarchy (Select, Column, ColumnData, GroupBy, etc.) is deferred
// until Vec<T> lands. Enum variants with payloads are also deferred.

pub struct DataFrame {
    pub n_cols: i32,
    pub n_rows: i32,
    pub col_names: [string; 4],
    pub data: [f64; 256],
}

pub fn dataframe_new() -> DataFrame {
    DataFrame {
        n_cols: 0,
        n_rows: 0,
        col_names: [""; 4],
        data: [0.0; 256],
    }
}

pub fn df_cell_idx(col: i32, row: i32) -> usize {
    (col * 64 + row) as usize
}
