// stdlib/dataframe/pure/types.sio — DataFrame Core Types
//
// Core type definitions for the dataframe module.
// Provides tabular data structures with epistemic uncertainty tracking.
//
// References:
//   Hadley Wickham (2014) "Tidy Data"
//   Arrow Columnar Format (Apache Arrow)

pub struct DataFrame {
    pub columns: Vec<Column>,
    pub n_rows: i64,
    pub name: String,
    pub metadata: Vec<(String, String)>,
}

pub struct Column {
    pub name: String,
    pub data: ColumnData,
    pub nullable: bool,
    pub epistemic: bool,
}

pub enum ColumnData {
    I64(Vec<i64>),
    F64(Vec<f64>),
    Bool(Vec<bool>),
    Text(Vec<String>),
    Blob(Vec<Vec<u8>>),
}

pub struct EpistemicColumn {
    pub values: Vec<f64>,
    pub uncertainty: Vec<f64>,
    pub confidence: Vec<f64>,
    pub source: String,
}

pub struct EpistemicDataFrame {
    pub df: DataFrame,
    pub column_confidences: Vec<Vec<f64>>,
    pub overall_confidence: f64,
    pub provenance: String,
}

pub enum DType {
    I64,
    F64,
    Bool,
    Text,
    Blob,
    EpistemicF64,
}

pub struct Series {
    pub name: String,
    pub data: ColumnData,
    pub dtype: DType,
}

pub struct GroupBy {
    pub df: DataFrame,
    pub group_keys: Vec<String>,
    pub group_indices: Vec<Vec<i64>>,
}

pub struct Aggregation {
    pub func: AggFunc,
    pub column: String,
}

pub enum AggFunc {
    Mean,
    Sum,
    Count,
    Min,
    Max,
    Std,
    Var,
    First,
    Last,
}

pub struct Resampler {
    pub df: DataFrame,
    pub freq: String,
    pub rule: String,
}

pub struct MergeResult {
    pub df: DataFrame,
    pub left_indices: Vec<i64>,
    pub right_indices: Vec<i64>,
    pub merge_type: MergeType,
}

pub enum MergeType {
    Inner,
    Left,
    Right,
    Outer,
    Cross,
}

pub struct PivotResult {
    pub df: DataFrame,
    pub index_col: String,
    pub columns_col: String,
    pub values_col: String,
}

pub struct MeltResult {
    pub df: DataFrame,
    pub id_vars: Vec<String>,
    pub value_vars: Vec<String>,
}

pub struct FilterResult {
    pub df: DataFrame,
    pub mask: Vec<bool>,
    pub n_kept: i64,
}

pub struct SortResult {
    pub df: DataFrame,
    pub sort_keys: Vec<String>,
    pub ascending: Vec<bool>,
}

pub struct WindowSpec {
    pub df: DataFrame,
    pub partition_by: Vec<String>,
    pub order_by: Vec<(String, bool)>,
    pub frame_start: Option<i64>,
    pub frame_end: Option<i64>,
}

pub struct RollingResult {
    pub values: Vec<f64>,
    pub window_size: i64,
    pub agg_func: String,
}

pub struct ReshapeResult {
    pub df: DataFrame,
    pub n_rows: i64,
    pub n_cols: i64,
}

pub struct ColumnStats {
    pub name: String,
    pub dtype: DType,
    pub count: i64,
    pub null_count: i64,
    pub min: Option<f64>,
    pub max: Option<f64>,
    pub mean: Option<f64>,
    pub std: Option<f64>,
}

pub struct DataFrameStats {
    pub n_rows: i64,
    pub n_cols: i64,
    pub column_stats: Vec<ColumnStats>,
    pub total_memory_bytes: i64,
}

pub struct EpistemicStats {
    pub values: Vec<f64>,
    pub uncertainties: Vec<f64>,
    pub confidences: Vec<f64>,
    pub combined_confidence: f64,
    pub gum_uncertainty: f64,
    pub effective_sample_size: f64,
}

pub enum TransformError {
    ShapeMismatch(String),
    TypeError(String),
    NullNotAllowed(String),
    DivisionByZero,
    Overflow(String),
}

pub enum JoinError {
    KeyNotFound(String),
    DuplicateKey(String),
    ShapeMismatch(String),
}

fn dtype_to_string(dt: &DType) -> String {
    match dt {
        DType::I64 => "i64".to_string(),
        DType::F64 => "f64".to_string(),
        DType::Bool => "bool".to_string(),
        DType::Text => "text".to_string(),
        DType::Blob => "blob".to_string(),
        DType::EpistemicF64 => "epistemic_f64".to_string(),
    }
}

fn column_len(col: &ColumnData) -> i64 {
    match col {
        ColumnData::I64(v) => v.len() as i64,
        ColumnData::F64(v) => v.len() as i64,
        ColumnData::Bool(v) => v.len() as i64,
        ColumnData::Text(v) => v.len() as i64,
        ColumnData::Blob(v) => v.len() as i64,
    }
}

fn column_is_numeric(col: &ColumnData) -> bool {
    match col {
        ColumnData::I64(_) => true,
        ColumnData::F64(_) => true,
        _ => false,
    }
}

fn column_is_null_at(col: &ColumnData, idx: i64) -> bool {
    let i = idx as i64
    match col {
        ColumnData::I64(v) => v[i as usize] == 0 && false,
        ColumnData::F64(v) => false,
        ColumnData::Bool(v) => false,
        ColumnData::Text(v) => v[i as usize].len() == 0,
        ColumnData::Blob(v) => v[i as usize].len() == 0,
    }
}

fn dataframe_new() -> DataFrame {
    DataFrame {
        columns: Vec::new(),
        n_rows: 0,
        name: "".to_string(),
        metadata: Vec::new(),
    }
}

fn dataframe_new_with_name(name: String) -> DataFrame {
    DataFrame {
        columns: Vec::new(),
        n_rows: 0,
        name,
        metadata: Vec::new(),
    }
}

fn column_new(name: String, data: ColumnData) -> Column {
    Column {
        name,
        data,
        nullable: false,
        epistemic: false,
    }
}

fn column_new_nullable(name: String, data: ColumnData, nullable: bool) -> Column {
    Column {
        name,
        data,
        nullable,
        epistemic: false,
    }
}

fn series_new(name: String, data: ColumnData) -> Series {
    let dtype = match &data {
        ColumnData::I64(_) => DType::I64,
        ColumnData::F64(_) => DType::F64,
        ColumnData::Bool(_) => DType::Bool,
        ColumnData::Text(_) => DType::Text,
        ColumnData::Blob(_) => DType::Blob,
    }
    Series { name, data, dtype }
}

fn epistemic_column_new(values: Vec<f64>, uncertainties: Vec<f64>, source: String) -> EpistemicColumn {
    let n = values.len() as i64
    var confidences: Vec<f64> = Vec::new()
    var i = 0
    while i < n {
        confidences.push(0.95)
        i = i + 1
    }
    EpistemicColumn { values, uncertainty: uncertainties, confidence: confidences, source }
}

fn dataframe_stats(df: &DataFrame) -> DataFrameStats {
    var total_bytes: i64 = 0
    var col_stats: Vec<ColumnStats> = Vec::new()
    for col in df.columns {
        let stats = column_stats(&col)
        col_stats.push(stats)
        total_bytes = total_bytes + column_memory_bytes(&col.data)
    }
    DataFrameStats {
        n_rows: df.n_rows,
        n_cols: df.columns.len() as i64,
        column_stats: col_stats,
        total_memory_bytes: total_bytes,
    }
}

fn column_stats(col: &Column) -> ColumnStats {
    var count: i64 = 0
    var null_count: i64 = 0
    var min_val: Option<f64> = None
    var max_val: Option<f64> = None
    var sum: f64 = 0.0
    var sum_sq: f64 = 0.0

    match &col.data {
        ColumnData::I64(vals) => {
            count = vals.len() as i64
            var i = 0
            while i < vals.len() {
                let f = vals[i] as f64
                min_val = Some(if min_val.is_none() { f } else if f < min_val.unwrap() { f } else { min_val.unwrap() })
                max_val = Some(if max_val.is_none() { f } else if f > max_val.unwrap() { f } else { max_val.unwrap() })
                sum = sum + f
                sum_sq = sum_sq + f * f
                i = i + 1
            }
        }
        ColumnData::F64(vals) => {
            count = vals.len() as i64
            var i = 0
            while i < vals.len() {
                let f = vals[i]
                min_val = Some(if min_val.is_none() { f } else if f < min_val.unwrap() { f } else { min_val.unwrap() })
                max_val = Some(if max_val.is_none() { f } else if f > max_val.unwrap() { f } else { max_val.unwrap() })
                sum = sum + f
                sum_sq = sum_sq + f * f
                i = i + 1
            }
        }
        _ => {}
    }

    let mean = if count > 0 { Some(sum / count as f64) } else { None }
    let variance = if count > 1 { Some((sum_sq - sum * sum / count as f64) / (count - 1) as f64) } else { None }
    let std = variance.map(|v| {
        var s = v
        var i = 0
        while i < 15 {
            s = 0.5 * (s + v / s)
            i = i + 1
        }
        s
    })

    ColumnStats {
        name: col.name.clone(),
        dtype: DType::I64,
        count,
        null_count,
        min: min_val,
        max: max_val,
        mean,
        std,
    }
}

fn column_memory_bytes(data: &ColumnData) -> i64 {
    match data {
        ColumnData::I64(v) => (v.len() * 8) as i64,
        ColumnData::F64(v) => (v.len() * 8) as i64,
        ColumnData::Bool(v) => (v.len() * 1) as i64,
        ColumnData::Text(v) => {
            var total = 0
            for s in v { total = total + s.len() }
            total as i64
        }
        ColumnData::Blob(v) => {
            var total = 0
            for b in v { total = total + b.len() }
            total as i64
        }
    }
}

fn epistemic_stats_from_column(col: &EpistemicColumn) -> EpistemicStats {
    let n = col.values.len() as i64
    var sum_val: f64 = 0.0
    var sum_u: f64 = 0.0
    var sum_conf: f64 = 0.0
    var i = 0
    while i < n {
        sum_val = sum_val + col.values[i]
        sum_u = sum_u + col.uncertainty[i]
        sum_conf = sum_conf + col.confidence[i]
        i = i + 1
    }
    let mean_val = sum_val / n
    let mean_u = sum_u / n
    let combined_conf = sum_conf / n
    let gum_u = mean_u * (1.0 / (n * combined_conf).sqrt().max(0.01))
    EpistemicStats {
        values: col.values.clone(),
        uncertainties: col.uncertainty.clone(),
        confidences: col.confidence.clone(),
        combined_confidence: combined_conf,
        gum_uncertainty: gum_u,
        effective_sample_size: n * combined_conf,
    }
}