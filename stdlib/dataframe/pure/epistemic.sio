// stdlib/dataframe/pure/epistemic.sio — Epistemic DataFrame Operations
//
// Epistemic variants of dataframe operations with GUM variance propagation.

pub struct EColumn {
    pub name: string,
    pub n_vals: i32,
    pub values: [Epistemic; 256],
}

pub fn ecolumn_new(name: string) -> EColumn {
    EColumn { name: name, n_vals: 0, values: [Epistemic::certain(0.0); 256] }
}

pub fn ecolumn_push(c: &! EColumn, v: Epistemic) with Mut {
    if c.n_vals < 256 {
        c.values[c.n_vals as usize] = v
        c.n_vals = c.n_vals + 1
    }
}

pub fn ecolumn_mean(c: &EColumn) -> Epistemic with Mut, Div {
    if c.n_vals == 0 { return Epistemic::certain(0.0) }
    var sum = Epistemic::certain(0.0)
    var i = 0
    while i < c.n_vals {
        sum = sum.add(&c.values[i as usize])
        i = i + 1
    }
    let n = Epistemic::certain(c.n_vals as f64)
    sum.div(&n)
}

pub fn ecolumn_std(c: &EColumn) -> Epistemic with Mut, Div {
    if c.n_vals == 0 { return Epistemic::certain(0.0) }
    let mean = ecolumn_mean(c)
    var var_sum = Epistemic::certain(0.0)
    var i = 0
    while i < c.n_vals {
        let diff = c.values[i as usize].sub(&mean)
        var_sum = var_sum.add(&diff.square())
        i = i + 1
    }
    let n = Epistemic::certain(c.n_vals as f64)
    let variance = var_sum.div(&n)
    variance.sqrt()
}

pub fn ecolumn_sum(c: &EColumn) -> Epistemic with Mut, Div {
    var sum = Epistemic::certain(0.0)
    var i = 0
    while i < c.n_vals {
        sum = sum.add(&c.values[i as usize])
        i = i + 1
    }
    sum
}

pub fn ecolumn_correlation(c1: &EColumn, c2: &EColumn) -> Epistemic with Mut, Div {
    if c1.n_vals == 0 || c2.n_vals == 0 {
        return Epistemic::certain(0.0)
    }
    let mean1 = ecolumn_mean(c1)
    let mean2 = ecolumn_mean(c2)
    var cov_sum = Epistemic::certain(0.0)
    var var1_sum = Epistemic::certain(0.0)
    var var2_sum = Epistemic::certain(0.0)
    var i = 0
    while i < c1.n_vals && i < c2.n_vals {
        let d1 = c1.values[i as usize].sub(&mean1)
        let d2 = c2.values[i as usize].sub(&mean2)
        cov_sum = cov_sum.add(&d1.mul(&d2))
        var1_sum = var1_sum.add(&d1.square())
        var2_sum = var2_sum.add(&d2.square())
        i = i + 1
    }
    let n = Epistemic::certain(c1.n_vals as f64)
    let cov = cov_sum.div(&n)
    let var1 = var1_sum.div(&n)
    let var2 = var2_sum.div(&n)
    cov.div(&var1.sqrt()).div(&var2.sqrt())
}