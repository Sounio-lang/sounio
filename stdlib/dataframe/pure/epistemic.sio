// stdlib/dataframe/pure/epistemic.sio — Epistemic DataFrame (aspirational stub).
//
// GUM uncertainty propagation over DataFrame columns requires Vec<f64> and
// closures — features not yet in the running compiler.
//
// Working epistemic column statistics are implemented in the self-contained
// tests/stdlib_dataframe/test_dataframe_e2e.sio using flat fixed arrays.
//
// This file is a placeholder so that import paths resolve at the module level.
// Full implementation deferred until Vec<T> and fn-pointer arguments land.
//
// References:
//   GUM 2008 (JCGM 100:2008)

pub fn epistemic_gum_uncertainty(mean: f64, std_dev: f64, n: i32, confidence: f64) -> f64 with Div {
    if n <= 0 { return 0.0 }
    if confidence <= 0.0 { return 0.0 }
    let u = std_dev / (n as f64)
    let k = if n >= 30 { 2.0 } else if n >= 10 { 2.1 } else { 2.8 }
    u * k / confidence
}
