// stdlib/prob/epistemic.sio — Bridge from probability distributions to GUM epistemic measurements
//
// Converts distribution parameters (mean, variance) into GUMResult uncertainty quantities.
// Follows JCGM 100:2008 (GUM) conventions: standard uncertainty = sqrt(variance).
//
// References:
//   JCGM 100:2008 (GUM) — Guide to the Expression of Uncertainty in Measurement
//   Gelman et al. (2013) BDA3 — Bayesian Data Analysis, Chapter 2

use epistemic::gum::{GUMResult, gum_simple}

// ============================================================================
// Math helper (self-contained sqrt via Newton-Raphson)
// ============================================================================

fn ep_sqrt(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var scaled = x
    var scale_back = 1.0
    while scaled < 1.0 { scaled = scaled * 4.0; scale_back = scale_back * 2.0 }
    while scaled > 4.0 { scaled = scaled * 0.25; scale_back = scale_back * 0.5 }
    var y = 1.5
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    return y / scale_back
}

// ============================================================================
// Core bridge: distribution moments → GUMResult
// ============================================================================

/// Convert mean and variance from a distribution to a GUMResult.
/// The standard uncertainty is sqrt(variance), representing the spread
/// of the distribution as a Type B uncertainty contribution.
pub fn prob_to_gum(mean: f64, variance: f64) -> GUMResult with Mut, Div, Panic {
    let std_u = ep_sqrt(variance)
    gum_simple(mean, std_u)
}

// ============================================================================
// Distribution-specific epistemic bridges
// ============================================================================

/// Gamma(alpha, beta) distribution as epistemic measurement.
/// Mean = alpha/beta, Variance = alpha/beta^2, StdU = sqrt(alpha)/beta.
pub fn gamma_as_gum(alpha: f64, beta: f64) -> GUMResult with Mut, Div, Panic {
    let mean = alpha / beta
    let variance = alpha / (beta * beta)
    prob_to_gum(mean, variance)
}

/// Normal(mu, sigma) distribution as epistemic measurement.
/// Mean = mu, standard uncertainty = sigma (sigma is already std dev).
pub fn normal_as_gum(mu: f64, sigma: f64) -> GUMResult with Mut, Div, Panic {
    gum_simple(mu, sigma)
}

/// Exponential(lambda) distribution as epistemic measurement.
/// Mean = 1/lambda, Variance = 1/lambda^2, StdU = 1/lambda.
pub fn exponential_as_gum(lambda: f64) -> GUMResult with Mut, Div, Panic {
    let mean = 1.0 / lambda
    let std_u = 1.0 / lambda
    gum_simple(mean, std_u)
}

/// Uniform(a, b) distribution as epistemic measurement.
/// Mean = (a+b)/2, Variance = (b-a)^2/12, StdU = (b-a)/sqrt(12).
pub fn uniform_as_gum(a: f64, b: f64) -> GUMResult with Mut, Div, Panic {
    let mean = (a + b) / 2.0
    let width = b - a
    let std_u = width / 3.46410161513775  // 2*sqrt(3)
    gum_simple(mean, std_u)
}
