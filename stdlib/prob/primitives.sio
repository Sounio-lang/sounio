// prob::primitives — Probabilistic Primitives for Sounio
//
// Core probabilistic building blocks: Beta distribution family,
// Dirichlet distribution, information-theoretic measures, and
// numerical utilities (log-gamma via Lanczos, log-sum-exp, KL divergence).
//
// All functions prefixed `prob_` for namespace safety.
// Fixed-size arrays used throughout for stack-allocation compatibility.
//
// References:
// - Abramowitz & Stegun (1964): Handbook of Mathematical Functions
// - Lanczos (1964): "A precision approximation of the gamma function"
// - Blei, Ng & Jordan (2003): "Latent Dirichlet Allocation" (JMLR)
// - Cover & Thomas (2006): "Elements of Information Theory" 2nd ed.

// ============================================================================
// MATH HELPERS (must precede all callers)
// ============================================================================

// Absolute value of f64
fn prob_abs(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

// Maximum of two f64 values
fn prob_max_f64(a: f64, b: f64) -> f64 {
    if a > b { return a }
    return b
}

// Minimum of two f64 values
fn prob_min_f64(a: f64, b: f64) -> f64 {
    if a < b { return a }
    return b
}

// Exponential function via Taylor series
// Accurate for |x| <= 20; recursively handles larger values
fn prob_f64_exp(x: f64) -> f64 {
    // Handle large positive values via squaring
    if x > 20.0 {
        let half = prob_f64_exp(x / 2.0)
        return half * half
    }
    // Handle large negative values
    if x < 0.0 - 20.0 {
        return 1.0 / prob_f64_exp(0.0 - x)
    }
    // Taylor series: e^x = sum_{n=0}^{inf} x^n / n!  (20 terms)
    var sum = 1.0
    var term = 1.0
    term = term * x / 1.0;   sum = sum + term
    term = term * x / 2.0;   sum = sum + term
    term = term * x / 3.0;   sum = sum + term
    term = term * x / 4.0;   sum = sum + term
    term = term * x / 5.0;   sum = sum + term
    term = term * x / 6.0;   sum = sum + term
    term = term * x / 7.0;   sum = sum + term
    term = term * x / 8.0;   sum = sum + term
    term = term * x / 9.0;   sum = sum + term
    term = term * x / 10.0;  sum = sum + term
    term = term * x / 11.0;  sum = sum + term
    term = term * x / 12.0;  sum = sum + term
    term = term * x / 13.0;  sum = sum + term
    term = term * x / 14.0;  sum = sum + term
    term = term * x / 15.0;  sum = sum + term
    term = term * x / 16.0;  sum = sum + term
    term = term * x / 17.0;  sum = sum + term
    term = term * x / 18.0;  sum = sum + term
    term = term * x / 19.0;  sum = sum + term
    term = term * x / 20.0;  sum = sum + term
    return sum
}

// Natural logarithm via argument reduction + Pade-like series
// Panics if x <= 0.0
fn prob_f64_log(x: f64) -> f64 with Div, Mut, Panic {
    if x <= 0.0 {
        panic("prob_f64_log: argument must be positive")
    }
    // Argument reduction: write x = m * 2^e where 0.5 <= m < 1
    // Then ln(x) = ln(m) + e * ln(2)
    var m = x
    var e = 0
    // Reduce to [0.5, 1.0)
    while m >= 1.0 { m = m / 2.0; e = e + 1 }
    while m < 0.5  { m = m * 2.0; e = e - 1 }
    // Now compute ln(m) for m in [0.5, 1.0) using series:
    // ln(m) = 2 * sum_{k=0}^{inf} t^{2k+1} / (2k+1)  where t = (m-1)/(m+1)
    let t = (m - 1.0) / (m + 1.0)
    let t2 = t * t
    var s = t
    var term = t
    term = term * t2; s = s + term / 3.0
    term = term * t2; s = s + term / 5.0
    term = term * t2; s = s + term / 7.0
    term = term * t2; s = s + term / 9.0
    term = term * t2; s = s + term / 11.0
    term = term * t2; s = s + term / 13.0
    term = term * t2; s = s + term / 15.0
    term = term * t2; s = s + term / 17.0
    term = term * t2; s = s + term / 19.0
    term = term * t2; s = s + term / 21.0
    term = term * t2; s = s + term / 23.0
    term = term * t2; s = s + term / 25.0
    let ln2 = 0.6931471805599453
    return 2.0 * s + (e as f64) * ln2
}

// Square root via Newton-Raphson (20 iterations)
fn prob_sqrt(x: f64) -> f64 {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 20 {
        y = 0.5 * (y + x / y)
        i = i + 1
    }
    return y
}

// Power x^y = exp(y * ln(x)), with special-case for x <= 0
fn prob_pow(x: f64, y: f64) -> f64 with Div, Mut, Panic {
    if x <= 0.0 { return 0.0 }
    return prob_f64_exp(y * prob_f64_log(x))
}

// ============================================================================
// LOG-GAMMA (LANCZOS APPROXIMATION)
// ============================================================================
//
// The Lanczos approximation gives:
//   Gamma(z+1) = sqrt(2*pi) * (z + g + 0.5)^(z+0.5) * e^{-(z+g+0.5)} * A_g(z)
// where g=7, and the coefficients p[0..8] are tabulated below.
//
// Reference: Lanczos (1964), numerical Recipes §6.1

fn prob_log_gamma(x: f64) -> f64 with Div, Mut, Panic {
    // Lanczos g=7 coefficients (Spouge variant / NR table)
    let p0 = 0.99999999999980993
    let p1 = 676.5203681218851
    let p2 = 0.0 - 1259.1392167224028
    let p3 = 771.32342877765313
    let p4 = 0.0 - 176.61502916214059
    let p5 = 12.507343278686905
    let p6 = 0.0 - 0.13857109526572012
    let p7 = 9.9843695780195716e-6
    let p8 = 1.5056327351493116e-7
    let pi_val = 3.141592653589793

    // Reflection formula: Gamma(x) = pi / (sin(pi*x) * Gamma(1-x))  for x < 0.5
    if x < 0.5 {
        // We need ln|Gamma(x)| = ln(pi) - ln|sin(pi*x)| - ln_gamma(1-x)
        // Compute sin(pi * x) via Taylor (good for small |x|)
        let px = pi_val * x
        // sin approximation: only need magnitude
        var sin_px = px
        let px2 = px * px
        var t = px
        t = t * (0.0 - px2) / (2.0 * 3.0);         sin_px = sin_px + t
        t = t * (0.0 - px2) / (4.0 * 5.0);         sin_px = sin_px + t
        t = t * (0.0 - px2) / (6.0 * 7.0);         sin_px = sin_px + t
        t = t * (0.0 - px2) / (8.0 * 9.0);         sin_px = sin_px + t
        t = t * (0.0 - px2) / (10.0 * 11.0);       sin_px = sin_px + t
        t = t * (0.0 - px2) / (12.0 * 13.0);       sin_px = sin_px + t
        if sin_px < 0.0 { sin_px = 0.0 - sin_px }
        if sin_px < 1.0e-300 { sin_px = 1.0e-300 }
        let log_pi = prob_f64_log(pi_val)
        let log_sin = prob_f64_log(sin_px)
        let lg1mx = prob_log_gamma(1.0 - x)
        return log_pi - log_sin - lg1mx
    }

    // Main Lanczos sum for x >= 0.5
    let z = x - 1.0
    var acc = p0
    acc = acc + p1 / (z + 1.0)
    acc = acc + p2 / (z + 2.0)
    acc = acc + p3 / (z + 3.0)
    acc = acc + p4 / (z + 4.0)
    acc = acc + p5 / (z + 5.0)
    acc = acc + p6 / (z + 6.0)
    acc = acc + p7 / (z + 7.0)
    acc = acc + p8 / (z + 8.0)

    let g = 7.0
    let t2 = z + g + 0.5
    let log_sqrt2pi = 0.9189385332046727  // 0.5 * ln(2*pi)
    return log_sqrt2pi + (z + 0.5) * prob_f64_log(t2) - t2 + prob_f64_log(acc)
}

// Log-Beta function: ln B(a,b) = ln Gamma(a) + ln Gamma(b) - ln Gamma(a+b)
fn prob_log_beta(a: f64, b: f64) -> f64 with Div, Mut, Panic {
    return prob_log_gamma(a) + prob_log_gamma(b) - prob_log_gamma(a + b)
}

// ============================================================================
// BETA DISTRIBUTION
// ============================================================================
//
// The Beta(alpha, beta) distribution on [0,1]:
//   PDF(x) = x^{alpha-1} * (1-x)^{beta-1} / B(alpha, beta)
//   CDF(x) = I_x(alpha, beta)  (regularized incomplete beta)

// Beta PDF: returns p(x | alpha, beta)
// Panics if alpha <= 0 or beta <= 0
fn prob_beta_pdf(x: f64, alpha: f64, beta: f64) -> f64 with Div, Mut, Panic {
    if alpha <= 0.0 || beta <= 0.0 {
        panic("prob_beta_pdf: alpha and beta must be positive")
    }
    if x < 0.0 || x > 1.0 { return 0.0 }
    // At boundaries — handle edge carefully
    if x <= 0.0 {
        if alpha < 1.0 { return 1.0 / 0.0 }  // +inf
        if alpha == 1.0 { return prob_f64_exp(0.0 - prob_log_beta(alpha, beta)) }
        return 0.0
    }
    if x >= 1.0 {
        if beta < 1.0 { return 1.0 / 0.0 }
        if beta == 1.0 { return prob_f64_exp(0.0 - prob_log_beta(alpha, beta)) }
        return 0.0
    }
    let log_pdf = (alpha - 1.0) * prob_f64_log(x)
                + (beta  - 1.0) * prob_f64_log(1.0 - x)
                - prob_log_beta(alpha, beta)
    return prob_f64_exp(log_pdf)
}

// Regularized incomplete beta I_x(a,b) via continued fraction (Lentz method).
// This gives the Beta CDF.  Numerically stable for a,b > 0, 0 < x < 1.
//
// Reference: Numerical Recipes §6.4, Abramowitz & Stegun §26.5
fn prob_betacf(x: f64, a: f64, b: f64) -> f64 with Div, Mut, Panic {
    let max_iter = 200
    let eps = 3.0e-7
    let fpmin = 1.0e-300

    let qab = a + b
    let qap = a + 1.0
    let qam = a - 1.0
    var c = 1.0
    var d = 1.0 - qab * x / qap
    if prob_abs(d) < fpmin { d = fpmin }
    d = 1.0 / d
    var h = d

    var m = 1
    var done = false
    while m <= max_iter && !done {
        let m2 = 2 * m
        // Even step
        let aa_even = (m as f64) * (b - (m as f64)) * x / ((qam + (m2 as f64)) * (a + (m2 as f64)))
        d = 1.0 + aa_even * d
        if prob_abs(d) < fpmin { d = fpmin }
        c = 1.0 + aa_even / c
        if prob_abs(c) < fpmin { c = fpmin }
        d = 1.0 / d
        h = h * d * c
        // Odd step
        let aa_odd = 0.0 - (a + (m as f64)) * (qab + (m as f64)) * x / ((a + (m2 as f64)) * (qap + (m2 as f64)))
        d = 1.0 + aa_odd * d
        if prob_abs(d) < fpmin { d = fpmin }
        c = 1.0 + aa_odd / c
        if prob_abs(c) < fpmin { c = fpmin }
        d = 1.0 / d
        let del = d * c
        h = h * del
        if prob_abs(del - 1.0) < eps { done = true }
        m = m + 1
    }
    return h
}

// Regularized incomplete beta function I_x(a,b)  = CDF of Beta(a,b) at x
fn prob_betai(x: f64, a: f64, b: f64) -> f64 with Div, Mut, Panic {
    if x < 0.0 || x > 1.0 { panic("prob_betai: x must be in [0,1]") }
    if x == 0.0 { return 0.0 }
    if x == 1.0 { return 1.0 }
    let log_bt = prob_log_gamma(a + b) - prob_log_gamma(a) - prob_log_gamma(b)
                + a * prob_f64_log(x) + b * prob_f64_log(1.0 - x)
    let bt = prob_f64_exp(log_bt)
    // Use continued fraction for numerically stable branch
    if x < (a + 1.0) / (a + b + 2.0) {
        return bt * prob_betacf(x, a, b) / a
    } else {
        return 1.0 - bt * prob_betacf(1.0 - x, b, a) / b
    }
}

// Beta CDF approximation using regularized incomplete beta function
fn prob_beta_cdf_approx(x: f64, alpha: f64, beta: f64) -> f64 with Div, Mut, Panic {
    if alpha <= 0.0 || beta <= 0.0 {
        panic("prob_beta_cdf_approx: alpha and beta must be positive")
    }
    return prob_betai(x, alpha, beta)
}

// Beta distribution mean: E[X] = alpha / (alpha + beta)
fn prob_beta_mean(alpha: f64, beta: f64) -> f64 with Div, Mut, Panic {
    return alpha / (alpha + beta)
}

// Beta distribution variance: Var[X] = alpha*beta / ((alpha+beta)^2 * (alpha+beta+1))
fn prob_beta_variance(alpha: f64, beta: f64) -> f64 with Div, Mut, Panic {
    let s = alpha + beta
    return (alpha * beta) / (s * s * (s + 1.0))
}

// Beta distribution mode: (alpha-1) / (alpha + beta - 2)  for alpha,beta > 1
// Returns 0.0 for alpha <= 1, 1.0 for beta <= 1 (boundary modes)
fn prob_beta_mode(alpha: f64, beta: f64) -> f64 with Div, Mut, Panic {
    if alpha > 1.0 && beta > 1.0 {
        return (alpha - 1.0) / (alpha + beta - 2.0)
    }
    if alpha <= 1.0 && beta > 1.0 { return 0.0 }
    if alpha > 1.0 && beta <= 1.0 { return 1.0 }
    // alpha <= 1 and beta <= 1: bimodal at 0 and 1 — return 0.5 as convention
    return 0.5
}

// ============================================================================
// DIRICHLET DISTRIBUTION
// ============================================================================
//
// Dirichlet(alpha_1, ..., alpha_k) is a distribution over the simplex.
// Normalizing constant: B(alpha) = prod Gamma(alpha_i) / Gamma(sum alpha_i)
// Log normalizer: ln B(alpha) = sum ln Gamma(alpha_i) - ln Gamma(sum alpha_i)
//
// Reference: Blei et al. (2003), §2.1

// Log normalizer of Dirichlet distribution.
// alphas[0..k-1] are the concentration parameters; k is the active count.
fn prob_dirichlet_log_normalizer(alphas: [f64; 16], k: i64) -> f64 with Div, Mut, Panic {
    if k <= 0 || k > 16 { panic("prob_dirichlet_log_normalizer: k must be in [1,16]") }
    var sum_alpha = 0.0
    var log_gamma_sum = 0.0
    var i = 0 as i64
    while i < k {
        let ai = alphas[i as usize]
        if ai <= 0.0 { panic("prob_dirichlet_log_normalizer: all alpha_i must be positive") }
        sum_alpha = sum_alpha + ai
        log_gamma_sum = log_gamma_sum + prob_log_gamma(ai)
        i = i + 1
    }
    return log_gamma_sum - prob_log_gamma(sum_alpha)
}

// Dirichlet mode: (alpha_i - 1) / (sum alpha_j - k)  for all alpha_i > 1.
// If any alpha_i <= 1, mode is at a corner; in that case we write 0.0 for
// those components and 1.0 for the largest alpha.
// Writes result into out[0..k-1], returns k on success.
fn prob_dirichlet_mode(alphas: [f64; 16], k: i64, out: &! [f64; 16]) -> i64 with Mut, Div, Panic {
    if k <= 0 || k > 16 { panic("prob_dirichlet_mode: k must be in [1,16]") }
    // Check if all alpha_i > 1 (proper interior mode)
    var all_gt1 = true
    var sum_alpha = 0.0
    var i = 0 as i64
    while i < k {
        let ai = alphas[i as usize]
        if ai <= 0.0 { panic("prob_dirichlet_mode: all alpha_i must be positive") }
        sum_alpha = sum_alpha + ai
        if ai <= 1.0 { all_gt1 = false }
        i = i + 1
    }
    if all_gt1 {
        let denom = sum_alpha - (k as f64)
        i = 0 as i64
        while i < k {
            out[i as usize] = (alphas[i as usize] - 1.0) / denom
            i = i + 1
        }
        return k
    }
    // Degenerate: put mass on largest alpha, zero elsewhere
    var max_val = alphas[0]
    var max_idx = 0 as i64
    i = 1 as i64
    while i < k {
        if alphas[i as usize] > max_val {
            max_val = alphas[i as usize]
            max_idx = i
        }
        i = i + 1
    }
    i = 0 as i64
    while i < k {
        if i == max_idx {
            out[i as usize] = 1.0
        } else {
            out[i as usize] = 0.0
        }
        i = i + 1
    }
    return k
}

// ============================================================================
// LOG-SUM-EXP (numerically stable)
// ============================================================================
//
// log(sum_i exp(log_probs[i]))  computed as:
//   max_val + log(sum_i exp(log_probs[i] - max_val))
//
// Reference: Murphy (2012), "Machine Learning: a Probabilistic Perspective" §3.5.3

fn prob_log_sum_exp(log_probs: [f64; 64], n: i64) -> f64 with Div, Mut, Panic {
    if n <= 0 || n > 64 { panic("prob_log_sum_exp: n must be in [1,64]") }
    // Find maximum
    var max_val = log_probs[0]
    var i = 1 as i64
    while i < n {
        let v = log_probs[i as usize]
        if v > max_val { max_val = v }
        i = i + 1
    }
    // Sum shifted exponentials
    var sum = 0.0
    i = 0 as i64
    while i < n {
        sum = sum + prob_f64_exp(log_probs[i as usize] - max_val)
        i = i + 1
    }
    return max_val + prob_f64_log(sum)
}

// ============================================================================
// KL DIVERGENCE AND ENTROPY
// ============================================================================
//
// KL(P||Q) = sum_i p_i * (ln p_i - ln q_i)
// H(P)     = -sum_i p_i * ln(p_i)  (Shannon entropy in nats)
//
// Conventions: 0 * log(0) = 0, 0 * log(0/q) = 0.

// KL divergence KL(p || q) in nats.
// Both p and q are probability vectors of length n stored in [f64; 64].
// Panics if any q_i = 0 while p_i > 0 (undefined KL).
fn prob_kl_divergence(p: [f64; 64], q: [f64; 64], n: i64) -> f64 with Div, Mut, Panic {
    if n <= 0 || n > 64 { panic("prob_kl_divergence: n must be in [1,64]") }
    var kl = 0.0
    var i = 0 as i64
    while i < n {
        let pi = p[i as usize]
        let qi = q[i as usize]
        if pi > 0.0 {
            if qi <= 0.0 { panic("prob_kl_divergence: q_i=0 where p_i>0 — KL is infinite") }
            kl = kl + pi * (prob_f64_log(pi) - prob_f64_log(qi))
        }
        i = i + 1
    }
    return kl
}

// Shannon entropy H(p) = -sum_i p_i * ln(p_i) in nats.
fn prob_entropy(p: [f64; 64], n: i64) -> f64 with Div, Mut, Panic {
    if n <= 0 || n > 64 { panic("prob_entropy: n must be in [1,64]") }
    var h = 0.0
    var i = 0 as i64
    while i < n {
        let pi = p[i as usize]
        if pi > 0.0 {
            h = h - pi * prob_f64_log(pi)
        }
        i = i + 1
    }
    return h
}

// ============================================================================
// TEST HELPERS
// ============================================================================

fn prob_approx_eq(a: f64, b: f64, tol: f64) -> bool {
    return prob_abs(a - b) < tol
}

// ============================================================================
// UNIT TESTS — prob_log_gamma
// ============================================================================

// Gamma(1) = 0!  = 1  => log_gamma(1) = 0
fn test_log_gamma_one() -> bool with Div, Mut, Panic {
    let lg = prob_log_gamma(1.0)
    return prob_approx_eq(lg, 0.0, 1.0e-9)
}

// Gamma(2) = 1! = 1 => log_gamma(2) = 0
fn test_log_gamma_two() -> bool with Div, Mut, Panic {
    let lg = prob_log_gamma(2.0)
    return prob_approx_eq(lg, 0.0, 1.0e-9)
}

// Gamma(0.5) = sqrt(pi) => log_gamma(0.5) = 0.5*ln(pi) = 0.5724...
fn test_log_gamma_half() -> bool with Div, Mut, Panic {
    let lg = prob_log_gamma(0.5)
    let expected = 0.5723649429247001   // 0.5 * ln(pi)
    return prob_approx_eq(lg, expected, 1.0e-7)
}

// Gamma(5) = 4! = 24 => log_gamma(5) = ln(24)
fn test_log_gamma_five() -> bool with Div, Mut, Panic {
    let lg = prob_log_gamma(5.0)
    let expected = prob_f64_log(24.0)
    return prob_approx_eq(lg, expected, 1.0e-9)
}

// Gamma(10) = 9! = 362880 => log_gamma(10) = ln(362880)
fn test_log_gamma_ten() -> bool with Div, Mut, Panic {
    let lg = prob_log_gamma(10.0)
    let expected = prob_f64_log(362880.0)
    return prob_approx_eq(lg, expected, 1.0e-8)
}

// ============================================================================
// UNIT TESTS — prob_beta_pdf
// ============================================================================

// Beta(1,1) is Uniform[0,1]; pdf at any x in (0,1) = 1.0
fn test_beta_pdf_uniform() -> bool with Div, Mut, Panic {
    let v = prob_beta_pdf(0.5, 1.0, 1.0)
    return prob_approx_eq(v, 1.0, 1.0e-8)
}

// Beta(2,2): mode at 0.5; pdf(0.5) = 3/2 = 1.5
fn test_beta_pdf_symmetric() -> bool with Div, Mut, Panic {
    let v = prob_beta_pdf(0.5, 2.0, 2.0)
    return prob_approx_eq(v, 1.5, 1.0e-8)
}

// Beta(2,5): pdf(0.3) — computed reference
// pdf(x) = x^1 * (1-x)^4 / B(2,5) = x*(1-x)^4 * 30
// B(2,5) = 1/30, pdf(0.3) = 0.3*(0.7)^4*30 = 0.3*0.2401*30 = 2.1609
fn test_beta_pdf_25_at_03() -> bool with Div, Mut, Panic {
    let v = prob_beta_pdf(0.3, 2.0, 5.0)
    // 0.3 * (0.7^4) * 30 = 0.3 * 0.2401 * 30 = 2.1609
    let expected = 2.1609
    return prob_approx_eq(v, expected, 1.0e-4)
}

// Beta pdf must be 0 outside [0,1]
fn test_beta_pdf_outside_support() -> bool with Div, Mut, Panic {
    let v1 = prob_beta_pdf(0.0 - 0.1, 2.0, 3.0)
    let v2 = prob_beta_pdf(1.1, 2.0, 3.0)
    return prob_approx_eq(v1, 0.0, 1.0e-15) && prob_approx_eq(v2, 0.0, 1.0e-15)
}

// Beta(1,1) pdf at x=0.5 should be 1.0
fn test_beta_pdf_11_at_half() -> bool with Div, Mut, Panic {
    let v = prob_beta_pdf(0.5, 1.0, 1.0)
    return prob_approx_eq(v, 1.0, 0.001)
}

// ============================================================================
// UNIT TESTS — prob_beta_mean / variance / mode
// ============================================================================

// Beta(2,5): mean = 2/7 ≈ 0.28571
fn test_beta_mean_25() -> bool with Div, Mut, Panic {
    let m = prob_beta_mean(2.0, 5.0)
    // 2/7 = 0.285714...
    return prob_approx_eq(m, 2.0 / 7.0, 1.0e-12)
}

// Beta(3,3): mean = 0.5 (symmetric)
fn test_beta_mean_symmetric() -> bool with Div, Mut, Panic {
    let m = prob_beta_mean(3.0, 3.0)
    return prob_approx_eq(m, 0.5, 1.0e-12)
}

// Beta(2,2): variance = 2*2 / (4^2 * 5) = 4/80 = 0.05
fn test_beta_variance_22() -> bool with Div, Mut, Panic {
    let v = prob_beta_variance(2.0, 2.0)
    return prob_approx_eq(v, 0.05, 1.0e-12)
}

// Beta(2,5): variance = 2*5 / (7^2 * 8) = 10/392 ≈ 0.025510
fn test_beta_variance_25() -> bool with Div, Mut, Panic {
    let v = prob_beta_variance(2.0, 5.0)
    let expected = 10.0 / 392.0
    return prob_approx_eq(v, expected, 1.0e-10)
}

// Beta(3,5): mode = (3-1)/(3+5-2) = 2/6 = 1/3
fn test_beta_mode_35() -> bool with Div, Mut, Panic {
    let m = prob_beta_mode(3.0, 5.0)
    return prob_approx_eq(m, 1.0 / 3.0, 1.0e-12)
}

// Beta(2,2): mode = 0.5
fn test_beta_mode_22() -> bool with Div, Mut, Panic {
    let m = prob_beta_mode(2.0, 2.0)
    return prob_approx_eq(m, 0.5, 1.0e-12)
}

// Beta(1,1): mode returns 0.5 (bimodal convention)
fn test_beta_mode_uniform() -> bool with Div, Mut, Panic {
    let m = prob_beta_mode(1.0, 1.0)
    return prob_approx_eq(m, 0.5, 1.0e-12)
}

// ============================================================================
// UNIT TESTS — prob_beta_cdf_approx
// ============================================================================

// Beta(1,1) CDF = x  (uniform distribution)
fn test_beta_cdf_uniform_at_half() -> bool with Div, Mut, Panic {
    let c = prob_beta_cdf_approx(0.5, 1.0, 1.0)
    return prob_approx_eq(c, 0.5, 1.0e-6)
}

// Beta CDF at x=0 is 0, at x=1 is 1
fn test_beta_cdf_boundary() -> bool with Div, Mut, Panic {
    let c0 = prob_beta_cdf_approx(0.0, 2.0, 3.0)
    let c1 = prob_beta_cdf_approx(1.0, 2.0, 3.0)
    return prob_approx_eq(c0, 0.0, 1.0e-15) && prob_approx_eq(c1, 1.0, 1.0e-15)
}

// Beta(2,2) CDF at mode (0.5) = 0.5 by symmetry
fn test_beta_cdf_symmetric_mode() -> bool with Div, Mut, Panic {
    let c = prob_beta_cdf_approx(0.5, 2.0, 2.0)
    return prob_approx_eq(c, 0.5, 1.0e-6)
}

// Beta(2,5): CDF at mean (2/7) ≈ 0.50766 (lookup table value)
fn test_beta_cdf_25_at_mean() -> bool with Div, Mut, Panic {
    let mu = prob_beta_mean(2.0, 5.0)
    let c = prob_beta_cdf_approx(mu, 2.0, 5.0)
    // CDF at mean of Beta(2,5): approximately 0.4824 (from tables)
    // Just verify it's in (0.3, 0.7) and monotone
    return c > 0.3 && c < 0.7
}

// Beta(3,1): CDF at 0.5 should be 0.125 (x^3 at x=0.5 = 0.125)
fn test_beta_cdf_31_at_half() -> bool with Div, Mut, Panic {
    let c = prob_beta_cdf_approx(0.5, 3.0, 1.0)
    // Beta(a,1) pdf = a*x^{a-1}, CDF = x^a, so at x=0.5: 0.5^3 = 0.125
    return prob_approx_eq(c, 0.125, 1.0e-5)
}

