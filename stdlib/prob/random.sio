// random.sio - Simple random number generation for Sounio

// Linear congruential generator state
struct RandRngState {
    seed: i64
}

fn rand_rng_new(seed: i64) -> RandRngState {
    return RandRngState { seed: seed }
}

// Linear congruential generator step
fn rand_lcg_next(state: RandRngState) -> RandRngState {
    let a: i64 = 1664525
    let c: i64 = 1013904223
    // Modulo 2^32 via mask
    let mask: i64 = 4294967295
    let next = (a * state.seed + c) & mask
    return RandRngState { seed: next }
}

// Get a random i64 value
fn rng_next_i64(state: RandRngState) -> RandRngState {
    return rand_lcg_next(state)
}

// Get a random f64 in [0, 1)
fn rng_next_f64(state: RandRngState) -> f64 {
    let next = rand_lcg_next(state)
    return (next.seed as f64) / 4294967296.0
}

// Get a random f64 in [lo, hi)
fn rng_next_range(state: RandRngState, lo: f64, hi: f64) -> f64 {
    let u = rng_next_f64(state)
    return lo + u * (hi - lo)
}

// Simple test
fn random_main() {
    var rng = rand_rng_new(42)
    rng = rand_lcg_next(rng)
    let val = rng.seed
    println("LCG output: ", val)

    rng = rand_lcg_next(rng)
    let val2 = rng.seed
    println("LCG output 2: ", val2)
}
