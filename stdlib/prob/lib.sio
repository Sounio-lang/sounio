// prob — Probability distributions and probabilistic programming
//
// Distribution families (Normal, Gamma, Beta, Exponential, Uniform, Poisson, Dirichlet),
// conformal prediction, MCMC sampling, vectorized inference, and GUM epistemic bridge.
//
// Submodules:
//   distributions — PDF/CDF/quantile for Normal, Gamma, Exponential, Uniform, Poisson, Dirichlet
//   beta          — Beta distribution with variance-first API (epistemic primitive)
//   normal        — Normal (Gaussian) distribution
//   primitives    — Log-gamma (Lanczos), log-sum-exp, KL divergence, Dirichlet
//   conformal     — Distribution-free conformal prediction with coverage guarantees
//   epistemic     — Bridge from distribution moments to GUM uncertainty (prob_to_gum)
//   inference     — Rejection/importance sampling, likelihood weighting, Metropolis-Hastings
//   mcmc          — Metropolis-Hastings sampler foundation
//   random        — Simple LCG random number generation
//   vmap_traces   — Vectorized multi-chain MCMC with R-hat convergence diagnostics

pub use distributions::{
    dist_normal_pdf, normal_cdf_full,
    gamma_log_pdf, gamma_cdf, gamma_mean, gamma_variance,
    exponential_log_pdf, exponential_cdf, exponential_mean, exponential_quantile,
    uniform_log_pdf, uniform_cdf, uniform_mean, uniform_quantile,
    poisson_log_pmf, poisson_mean, poisson_variance,
    dirichlet_log_pdf_2,
}

pub use epistemic::{
    prob_to_gum,
    gamma_as_gum, normal_as_gum, exponential_as_gum, uniform_as_gum,
}
