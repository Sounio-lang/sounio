// stdlib/time/duration — Time duration with nanosecond precision
//
// Duration is a non-negative span of time stored as seconds + nanoseconds.
// Nanoseconds are always in [0, 999_999_999].

struct Duration {
    secs: i64,
    nanos: i32
}

fn dur_from_secs(s: i64) -> Duration {
    Duration { secs: s, nanos: 0 }
}

fn dur_from_millis(ms: i64) -> Duration with Div, Panic {
    let s = ms / 1000
    let remainder = ms - s * 1000
    Duration { secs: s, nanos: (remainder * 1000000) as i32 }
}

fn dur_from_nanos(ns: i64) -> Duration with Div, Panic {
    let s = ns / 1000000000
    let remainder = ns - s * 1000000000
    Duration { secs: s, nanos: remainder as i32 }
}

fn dur_add(a: Duration, b: Duration) -> Duration with Div, Panic {
    var total_nanos: i64 = a.nanos as i64 + b.nanos as i64
    var extra_secs = total_nanos / 1000000000
    var nanos = total_nanos - extra_secs * 1000000000
    Duration { secs: a.secs + b.secs + extra_secs, nanos: nanos as i32 }
}

fn dur_sub(a: Duration, b: Duration) -> Duration with Mut, Div, Panic {
    var secs = a.secs - b.secs
    var nanos: i64 = a.nanos as i64 - b.nanos as i64
    if nanos < 0 {
        secs = secs - 1
        nanos = nanos + 1000000000
    }
    if secs < 0 {
        return Duration { secs: 0, nanos: 0 }
    }
    Duration { secs: secs, nanos: nanos as i32 }
}

fn dur_to_millis(d: Duration) -> i64 {
    d.secs * 1000 + d.nanos as i64 / 1000000
}

fn dur_to_nanos(d: Duration) -> i64 {
    d.secs * 1000000000 + d.nanos as i64
}

fn dur_to_f64_secs(d: Duration) -> f64 {
    d.secs as f64 + d.nanos as f64 / 1000000000.0
}

fn dur_is_zero(d: Duration) -> bool {
    d.secs == 0 && d.nanos == 0
}

// =============================================================================
// Tests
// =============================================================================

fn test_from_secs() -> bool {
    let d = dur_from_secs(5)
    d.secs == 5 && d.nanos == 0
}

fn test_from_millis() -> bool with Div, Panic {
    let d = dur_from_millis(2500)
    d.secs == 2 && d.nanos == 500000000
}

fn test_add() -> bool with Div, Panic {
    let a = dur_from_millis(1500)
    let b = dur_from_millis(750)
    let c = dur_add(a, b)
    c.secs == 2 && c.nanos == 250000000
}

fn test_sub() -> bool with Mut, Div, Panic {
    let a = dur_from_secs(5)
    let b = dur_from_millis(2500)
    let c = dur_sub(a, b)
    c.secs == 2 && c.nanos == 500000000
}

fn test_to_millis() -> bool with Div, Panic {
    let d = dur_from_millis(3456)
    dur_to_millis(d) == 3456
}

fn test_to_f64() -> bool {
    let d = dur_from_secs(3)
    let f = dur_to_f64_secs(d)
    f == 3.0
}

fn main() with IO, Mut, Div, Panic {
    if test_from_secs() { print("duration from_secs: PASS\n") } else { print("duration from_secs: FAIL\n") }
    if test_from_millis() { print("duration from_millis: PASS\n") } else { print("duration from_millis: FAIL\n") }
    if test_add() { print("duration add: PASS\n") } else { print("duration add: FAIL\n") }
    if test_sub() { print("duration sub: PASS\n") } else { print("duration sub: FAIL\n") }
    if test_to_millis() { print("duration to_millis: PASS\n") } else { print("duration to_millis: FAIL\n") }
    if test_to_f64() { print("duration to_f64: PASS\n") } else { print("duration to_f64: FAIL\n") }
}
