//! stdlib/time/duration.sio - Duration type
//!
//! A Duration represents a span of time, stored as seconds and nanoseconds.

// ============================================================================
// Duration Type
// ============================================================================

// A span of time.
//
// Durations are always non-negative and store time with nanosecond precision.
pub struct Duration {
    /// Whole seconds
    secs: u64,
    /// Nanoseconds (0 to 999_999_999)
    nanos: u32,
}

// Nanoseconds per second
const NANOS_PER_SEC: u32 = 1_000_000_000
const NANOS_PER_MILLI: u32 = 1_000_000
const NANOS_PER_MICRO: u32 = 1_000
const MILLIS_PER_SEC: u64 = 1_000
const MICROS_PER_SEC: u64 = 1_000_000

// ============================================================================
// Constructors
// ============================================================================

// Create a zero duration.
pub fn duration_zero() -> Duration {
    Duration { secs: 0, nanos: 0 }
}

// Create a duration from seconds.
pub fn duration_from_secs(secs: u64) -> Duration {
    Duration { secs: secs, nanos: 0 }
}

// Create a duration from milliseconds.
pub fn duration_from_millis(millis: u64) -> Duration {
    Duration {
        secs: millis / MILLIS_PER_SEC,
        nanos: ((millis % MILLIS_PER_SEC) * (NANOS_PER_MILLI as u64)) as u32,
    }
}

// Create a duration from microseconds.
pub fn duration_from_micros(micros: u64) -> Duration {
    Duration {
        secs: micros / MICROS_PER_SEC,
        nanos: ((micros % MICROS_PER_SEC) * (NANOS_PER_MICRO as u64)) as u32,
    }
}

// Create a duration from nanoseconds.
pub fn duration_from_nanos(nanos: u64) -> Duration {
    Duration {
        secs: nanos / (NANOS_PER_SEC as u64),
        nanos: (nanos % (NANOS_PER_SEC as u64)) as u32,
    }
}

// Create a duration from seconds and nanoseconds.
pub fn duration_new(secs: u64, nanos: u32) -> Duration {
    // Normalize if nanos >= 1 billion
    let extra_secs = (nanos / NANOS_PER_SEC) as u64
    let normalized_nanos = nanos % NANOS_PER_SEC

    Duration {
        secs: secs + extra_secs,
        nanos: normalized_nanos,
    }
}

// Create a duration from a floating-point number of seconds.
pub fn duration_from_secs_f64(secs: f64) -> Duration {
    if secs < 0.0 {
        return duration_zero()
    }

    let whole_secs = secs as u64
    let frac = secs - (whole_secs as f64)
    let nanos = (frac * (NANOS_PER_SEC as f64)) as u32

    Duration {
        secs: whole_secs,
        nanos: nanos,
    }
}

// ============================================================================
// Accessors
// ============================================================================

// Get the whole seconds component.
pub fn duration_as_secs(d: &Duration) -> u64 {
    d.secs
}

// Get the nanoseconds component (0 to 999_999_999).
pub fn duration_subsec_nanos(d: &Duration) -> u32 {
    d.nanos
}

// Get the total duration as milliseconds.
pub fn duration_as_millis(d: &Duration) -> u64 {
    d.secs * MILLIS_PER_SEC + (d.nanos / NANOS_PER_MILLI) as u64
}

// Get the total duration as microseconds.
pub fn duration_as_micros(d: &Duration) -> u64 {
    d.secs * MICROS_PER_SEC + (d.nanos / NANOS_PER_MICRO) as u64
}

// Get the total duration as nanoseconds (may overflow for large durations).
pub fn duration_as_nanos(d: &Duration) -> u64 {
    d.secs * (NANOS_PER_SEC as u64) + d.nanos as u64
}

// Convert to floating-point seconds.
pub fn duration_as_secs_f64(d: &Duration) -> f64 {
    (d.secs as f64) + (d.nanos as f64) / (NANOS_PER_SEC as f64)
}

// ============================================================================
// Arithmetic
// ============================================================================

// Add two durations.
pub fn duration_add(a: &Duration, b: &Duration) -> Duration {
    let total_nanos = a.nanos + b.nanos
    let extra_secs = (total_nanos / NANOS_PER_SEC) as u64
    let nanos = total_nanos % NANOS_PER_SEC

    Duration {
        secs: a.secs + b.secs + extra_secs,
        nanos: nanos,
    }
}

// Subtract duration b from a. Returns zero if b > a.
pub fn duration_sub(a: &Duration, b: &Duration) -> Duration {
    if a.secs < b.secs || (a.secs == b.secs && a.nanos < b.nanos) {
        return duration_zero()
    }

    if a.nanos >= b.nanos {
        Duration {
            secs: a.secs - b.secs,
            nanos: a.nanos - b.nanos,
        }
    } else {
        Duration {
            secs: a.secs - b.secs - 1,
            nanos: NANOS_PER_SEC - (b.nanos - a.nanos),
        }
    }
}

// Multiply duration by a scalar.
pub fn duration_mul(d: &Duration, factor: u32) -> Duration {
    let total_nanos = (d.nanos as u64) * (factor as u64)
    let extra_secs = total_nanos / (NANOS_PER_SEC as u64)
    let nanos = (total_nanos % (NANOS_PER_SEC as u64)) as u32

    Duration {
        secs: d.secs * (factor as u64) + extra_secs,
        nanos: nanos,
    }
}

// Divide duration by a scalar.
pub fn duration_div(d: &Duration, divisor: u32) -> Duration with Div {
    if divisor == 0 {
        return duration_zero()
    }

    let total_nanos = duration_as_nanos(d)
    duration_from_nanos(total_nanos / (divisor as u64))
}

// ============================================================================
// Comparison
// ============================================================================

// Check if duration is zero.
pub fn duration_is_zero(d: &Duration) -> bool {
    d.secs == 0 && d.nanos == 0
}

// Compare two durations. Returns -1, 0, or 1.
pub fn duration_cmp(a: &Duration, b: &Duration) -> i32 {
    if a.secs < b.secs {
        -1
    } else if a.secs > b.secs {
        1
    } else if a.nanos < b.nanos {
        -1
    } else if a.nanos > b.nanos {
        1
    } else {
        0
    }
}

// Check if two durations are equal.
pub fn duration_eq(a: &Duration, b: &Duration) -> bool {
    a.secs == b.secs && a.nanos == b.nanos
}

// Check if a < b.
pub fn duration_lt(a: &Duration, b: &Duration) -> bool {
    duration_cmp(a, b) < 0
}

// Check if a <= b.
pub fn duration_le(a: &Duration, b: &Duration) -> bool {
    duration_cmp(a, b) <= 0
}

// Check if a > b.
pub fn duration_gt(a: &Duration, b: &Duration) -> bool {
    duration_cmp(a, b) > 0
}

// Check if a >= b.
pub fn duration_ge(a: &Duration, b: &Duration) -> bool {
    duration_cmp(a, b) >= 0
}

// Return the minimum of two durations.
pub fn duration_min(a: &Duration, b: &Duration) -> Duration {
    if duration_le(a, b) {
        Duration { secs: a.secs, nanos: a.nanos }
    } else {
        Duration { secs: b.secs, nanos: b.nanos }
    }
}

// Return the maximum of two durations.
pub fn duration_max(a: &Duration, b: &Duration) -> Duration {
    if duration_ge(a, b) {
        Duration { secs: a.secs, nanos: a.nanos }
    } else {
        Duration { secs: b.secs, nanos: b.nanos }
    }
}

// ============================================================================
// Formatting
// ============================================================================

// Format duration as a human-readable string.
//
// Examples: "5s", "2m 30s", "1h 15m 30s", "500ms", "100us", "50ns"
pub fn duration_format(d: &Duration) -> String with Alloc {
    var s = string_new()

    if d.secs >= 3600 {
        let hours = d.secs / 3600
        let mins = (d.secs % 3600) / 60
        let secs = d.secs % 60

        string_push_str(&!s, &u64_to_string(hours))
        string_push(&!s, 'h')

        if mins > 0 || secs > 0 {
            string_push(&!s, ' ')
            string_push_str(&!s, &u64_to_string(mins))
            string_push(&!s, 'm')
        }

        if secs > 0 {
            string_push(&!s, ' ')
            string_push_str(&!s, &u64_to_string(secs))
            string_push(&!s, 's')
        }
    } else if d.secs >= 60 {
        let mins = d.secs / 60
        let secs = d.secs % 60

        string_push_str(&!s, &u64_to_string(mins))
        string_push(&!s, 'm')

        if secs > 0 {
            string_push(&!s, ' ')
            string_push_str(&!s, &u64_to_string(secs))
            string_push(&!s, 's')
        }
    } else if d.secs > 0 {
        string_push_str(&!s, &u64_to_string(d.secs))
        string_push(&!s, 's')

        if d.nanos > 0 {
            let millis = d.nanos / NANOS_PER_MILLI
            if millis > 0 {
                string_push(&!s, ' ')
                string_push_str(&!s, &u32_to_string(millis))
                string_push_str(&!s, "ms")
            }
        }
    } else if d.nanos >= NANOS_PER_MILLI {
        let millis = d.nanos / NANOS_PER_MILLI
        string_push_str(&!s, &u32_to_string(millis))
        string_push_str(&!s, "ms")
    } else if d.nanos >= NANOS_PER_MICRO {
        let micros = d.nanos / NANOS_PER_MICRO
        string_push_str(&!s, &u32_to_string(micros))
        string_push_str(&!s, "us")
    } else if d.nanos > 0 {
        string_push_str(&!s, &u32_to_string(d.nanos))
        string_push_str(&!s, "ns")
    } else {
        string_push_str(&!s, "0s")
    }

    s
}

// Helper functions for number to string conversion
fn u64_to_string(n: u64) -> String with Alloc {
    if n == 0 {
        return string_from("0")
    }

    var s = string_new()
    var num = n

    while num > 0 {
        let digit = (num % 10) as u8 + ('0' as u8)
        string_push(&!s, digit as char)
        num = num / 10
    }

    string_reverse(&!s)
    s
}

fn u32_to_string(n: u32) -> String with Alloc {
    u64_to_string(n as u64)
}
