//! stdlib/time/instant.sio - Monotonic time for measuring elapsed duration
//!
//! Instant represents a point in time from a monotonic clock,
//! suitable for measuring elapsed time. Unlike wall-clock time,
//! Instant is guaranteed to be monotonically increasing.

use super::duration::{Duration, duration_new, duration_sub}

// ============================================================================
// System FFI
// ============================================================================

extern "C" {
    // POSIX clock_gettime
    fn clock_gettime(clk_id: i32, tp: *mut Timespec) -> i32
}

struct Timespec {
    tv_sec: i64,
    tv_nsec: i64,
}

// Clock IDs
const CLOCK_MONOTONIC: i32 = 1
const CLOCK_MONOTONIC_RAW: i32 = 4  // Linux-specific, not affected by NTP

// ============================================================================
// Instant Type
// ============================================================================

// A measurement of a monotonically nondecreasing clock.
//
// Instants are opaque; they can only be compared to one another
// or used to measure elapsed time.
pub struct Instant {
    secs: u64,
    nanos: u32,
}

// ============================================================================
// Core Functions
// ============================================================================

// Get the current instant from the monotonic clock.
pub fn instant_now() -> Instant with IO {
    var ts = Timespec { tv_sec: 0, tv_nsec: 0 }

    // Try CLOCK_MONOTONIC_RAW first (Linux), fall back to CLOCK_MONOTONIC
    let result = clock_gettime(CLOCK_MONOTONIC_RAW, &!ts)
    if result != 0 {
        clock_gettime(CLOCK_MONOTONIC, &!ts)
    }

    Instant {
        secs: ts.tv_sec as u64,
        nanos: ts.tv_nsec as u32,
    }
}

// Calculate the duration elapsed since this instant.
//
// # Panics
// May panic if the instant is later than the current time (clock went backwards).
pub fn instant_elapsed(start: &Instant) -> Duration with IO {
    let now = instant_now()
    instant_duration_since(&now, start)
}

// Calculate the duration between two instants.
//
// Returns zero if `earlier` is actually later than `later`.
pub fn instant_duration_since(later: &Instant, earlier: &Instant) -> Duration {
    if later.secs < earlier.secs ||
       (later.secs == earlier.secs && later.nanos < earlier.nanos) {
        return Duration { secs: 0, nanos: 0 }
    }

    if later.nanos >= earlier.nanos {
        Duration {
            secs: later.secs - earlier.secs,
            nanos: later.nanos - earlier.nanos,
        }
    } else {
        Duration {
            secs: later.secs - earlier.secs - 1,
            nanos: 1_000_000_000 - (earlier.nanos - later.nanos),
        }
    }
}

// Add a duration to an instant.
pub fn instant_add(i: &Instant, d: &Duration) -> Instant {
    let total_nanos = i.nanos + d.nanos
    let extra_secs = (total_nanos / 1_000_000_000) as u64
    let nanos = total_nanos % 1_000_000_000

    Instant {
        secs: i.secs + d.secs + extra_secs,
        nanos: nanos,
    }
}

// Subtract a duration from an instant.
pub fn instant_sub(i: &Instant, d: &Duration) -> Instant {
    if i.nanos >= d.nanos {
        Instant {
            secs: i.secs - d.secs,
            nanos: i.nanos - d.nanos,
        }
    } else {
        Instant {
            secs: i.secs - d.secs - 1,
            nanos: 1_000_000_000 - (d.nanos - i.nanos),
        }
    }
}

// ============================================================================
// Comparison
// ============================================================================

// Compare two instants. Returns -1, 0, or 1.
pub fn instant_cmp(a: &Instant, b: &Instant) -> i32 {
    if a.secs < b.secs {
        -1
    } else if a.secs > b.secs {
        1
    } else if a.nanos < b.nanos {
        -1
    } else if a.nanos > b.nanos {
        1
    } else {
        0
    }
}

// Check if two instants are equal.
pub fn instant_eq(a: &Instant, b: &Instant) -> bool {
    a.secs == b.secs && a.nanos == b.nanos
}

// Check if a is before b.
pub fn instant_lt(a: &Instant, b: &Instant) -> bool {
    instant_cmp(a, b) < 0
}

// Check if a is before or equal to b.
pub fn instant_le(a: &Instant, b: &Instant) -> bool {
    instant_cmp(a, b) <= 0
}

// Check if a is after b.
pub fn instant_gt(a: &Instant, b: &Instant) -> bool {
    instant_cmp(a, b) > 0
}

// Check if a is after or equal to b.
pub fn instant_ge(a: &Instant, b: &Instant) -> bool {
    instant_cmp(a, b) >= 0
}

// ============================================================================
// Utilities
// ============================================================================

// Check if a duration has passed since an instant.
pub fn instant_has_elapsed(start: &Instant, duration: &Duration) -> bool with IO {
    let elapsed = instant_elapsed(start)
    elapsed.secs > duration.secs ||
    (elapsed.secs == duration.secs && elapsed.nanos >= duration.nanos)
}

// Create a deadline (instant + duration).
pub fn instant_deadline(d: &Duration) -> Instant with IO {
    let now = instant_now()
    instant_add(&now, d)
}

// Check if a deadline has passed.
pub fn instant_deadline_passed(deadline: &Instant) -> bool with IO {
    let now = instant_now()
    instant_ge(&now, deadline)
}

// Time a closure and return its result along with elapsed duration.
pub fn instant_time<T, F: fn() -> T>(f: F) -> (T, Duration) with IO {
    let start = instant_now()
    let result = f()
    let elapsed = instant_elapsed(&start)
    (result, elapsed)
}

// ============================================================================
// Benchmarking Utilities
// ============================================================================

// Run a function multiple times and return the minimum duration.
pub fn instant_bench_min<F: fn()>(f: F, iterations: usize) -> Duration with IO {
    var min_duration = Duration { secs: u64::MAX, nanos: 0 }

    var i = 0
    while i < iterations {
        let start = instant_now()
        f()
        let elapsed = instant_elapsed(&start)

        if elapsed.secs < min_duration.secs ||
           (elapsed.secs == min_duration.secs && elapsed.nanos < min_duration.nanos) {
            min_duration = elapsed
        }

        i = i + 1
    }

    min_duration
}

// Run a function multiple times and return the average duration.
pub fn instant_bench_avg<F: fn()>(f: F, iterations: usize) -> Duration with IO {
    let start = instant_now()

    var i = 0
    while i < iterations {
        f()
        i = i + 1
    }

    let total = instant_elapsed(&start)

    Duration {
        secs: total.secs / (iterations as u64),
        nanos: ((total.secs % (iterations as u64)) * 1_000_000_000 + (total.nanos as u64)) / (iterations as u64) as u32,
    }
}

// Benchmark result with statistics.
pub struct BenchResult {
    /// Minimum duration
    min: Duration,
    /// Maximum duration
    max: Duration,
    /// Average duration
    avg: Duration,
    /// Total iterations
    iterations: usize,
}

// Run comprehensive benchmarks with statistics.
pub fn instant_benchmark<F: fn()>(f: F, iterations: usize) -> BenchResult with IO, Alloc {
    var min = Duration { secs: u64::MAX, nanos: 0 }
    var max = Duration { secs: 0, nanos: 0 }
    var total = Duration { secs: 0, nanos: 0 }

    var i = 0
    while i < iterations {
        let start = instant_now()
        f()
        let elapsed = instant_elapsed(&start)

        // Update min
        if elapsed.secs < min.secs ||
           (elapsed.secs == min.secs && elapsed.nanos < min.nanos) {
            min = Duration { secs: elapsed.secs, nanos: elapsed.nanos }
        }

        // Update max
        if elapsed.secs > max.secs ||
           (elapsed.secs == max.secs && elapsed.nanos > max.nanos) {
            max = Duration { secs: elapsed.secs, nanos: elapsed.nanos }
        }

        // Update total
        let total_nanos = total.nanos + elapsed.nanos
        let extra_secs = (total_nanos / 1_000_000_000) as u64
        total = Duration {
            secs: total.secs + elapsed.secs + extra_secs,
            nanos: total_nanos % 1_000_000_000,
        }

        i = i + 1
    }

    let avg = Duration {
        secs: total.secs / (iterations as u64),
        nanos: ((total.secs % (iterations as u64)) * 1_000_000_000 + (total.nanos as u64)) / (iterations as u64) as u32,
    }

    BenchResult {
        min: min,
        max: max,
        avg: avg,
        iterations: iterations,
    }
}
