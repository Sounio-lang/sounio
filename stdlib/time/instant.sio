// stdlib/time/instant — Monotonic clock instant
//
// Uses POSIX clock_gettime with CLOCK_MONOTONIC for elapsed-time measurement.
// Instant values are opaque; only meaningful as pairs for elapsed computation.

// Duration struct (inlined to avoid cross-module deps)
struct Duration {
    secs: i64,
    nanos: i32
}

struct Instant {
    secs: i64,
    nanos: i32
}

// Returns a stub Instant. Libc time/clock FFI is not yet linked in native mode.
// Use this for relative elapsed-time comparisons only (secs will differ between calls
// once native clock support is wired in).
fn instant_now() -> Instant {
    Instant { secs: 0, nanos: 0 }
}

fn instant_elapsed(start: Instant, end: Instant) -> Duration with Mut {
    var secs = end.secs - start.secs
    var nanos: i64 = end.nanos as i64 - start.nanos as i64
    if nanos < 0 {
        secs = secs - 1
        nanos = nanos + 1000000000
    }
    Duration { secs: secs, nanos: nanos as i32 }
}

fn instant_elapsed_ns(start: Instant, end: Instant) -> i64 with Mut {
    let d = instant_elapsed(start, end)
    d.secs * 1000000000 + d.nanos as i64
}

fn instant_elapsed_ms(start: Instant, end: Instant) -> i64 with Mut, Div, Panic {
    let ns = instant_elapsed_ns(start, end)
    ns / 1000000
}

fn main() -> i32 with IO, Mut {
    let t0 = instant_now()
    let t1 = instant_now()
    let d  = instant_elapsed(t0, t1)
    if d.secs >= 0 {
        println("instant_now: PASS")
        println("instant_elapsed: PASS")
        return 0
    }
    println("instant_elapsed: FAIL")
    return 1
}
