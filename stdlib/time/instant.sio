// Linux monotonic clock backed by the checked native platform ABI.
// Instants are process-local, opaque, and carry explicit acquisition status.
use ffi::platform::{Platform,PlatformValue,platform_call}
pub struct Instant {ticks:i64,status:i64}
pub fn instant_now(p:&Platform)->Instant with IO {
    let r=platform_call(p,30,0,0,0,0)
    return Instant {ticks:r.value,status:r.status}
}
pub fn instant_status(t:&Instant)->i64 {t.status}
pub fn instant_elapsed_ns(start:&Instant,end:&Instant)->PlatformValue {
    if start.status!=0 {return PlatformValue {value:0,status:start.status}}
    if end.status!=0 {return PlatformValue {value:0,status:end.status}}
    if end.ticks<start.ticks {return PlatformValue {value:0,status:22}}
    return PlatformValue {value:end.ticks-start.ticks,status:0}
}
pub fn instant_elapsed_ms(start:&Instant,end:&Instant)->PlatformValue with Div,Panic {
    let r=instant_elapsed_ns(start,end)
    if r.status!=0 {return r}
    return PlatformValue {value:r.value/1000000,status:0}
}
