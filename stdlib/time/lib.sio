//! stdlib/time - Time and Date Utilities
//!
//! This module provides types and functions for working with time:
//! - `Duration` - A span of time
//! - `Instant` - A monotonic point in time for measuring elapsed time
//! - `DateTime` - Calendar date and time
//!
//! # Examples
//!
//! ```sio
//! // Measure elapsed time
//! let start = instant_now()
//! // ... do work ...
//! let elapsed = instant_elapsed(&start)
//! println("Took {} ms", duration_as_millis(&elapsed))
//!
//! // Work with durations
//! let timeout = duration_from_secs(30)
//! let total = duration_add(&d1, &d2)
//!
//! // Get current date/time
//! let now = datetime_now()
//! let formatted = datetime_format(&now, "%Y-%m-%d %H:%M:%S")
//! ```

pub mod duration;
pub mod instant;
pub mod datetime;

pub use duration::*;
pub use instant::*;
pub use datetime::*;
