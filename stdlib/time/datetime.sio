//! stdlib/time/datetime.sio - Calendar date and time
//!
//! DateTime provides calendar date/time with timezone support.

use super::duration::Duration

// ============================================================================
// System FFI
// ============================================================================

extern "C" {
    // POSIX time functions
    fn time(tloc: *mut i64) -> i64
    fn gmtime_r(timep: *const i64, result: *mut Tm) -> *mut Tm
    fn localtime_r(timep: *const i64, result: *mut Tm) -> *mut Tm
    fn mktime(tm: *mut Tm) -> i64
    fn strftime(s: *mut u8, max: usize, format: *const u8, tm: *const Tm) -> usize
}

// C tm struct
struct Tm {
    tm_sec: i32,    // seconds [0, 60]
    tm_min: i32,    // minutes [0, 59]
    tm_hour: i32,   // hours [0, 23]
    tm_mday: i32,   // day of month [1, 31]
    tm_mon: i32,    // month [0, 11]
    tm_year: i32,   // years since 1900
    tm_wday: i32,   // day of week [0, 6] (Sunday = 0)
    tm_yday: i32,   // day of year [0, 365]
    tm_isdst: i32,  // daylight saving time flag
}

// ============================================================================
// DateTime Type
// ============================================================================

// A calendar date and time.
pub struct DateTime {
    /// Year (e.g., 2024)
    year: i32,
    /// Month (1-12)
    month: u8,
    /// Day of month (1-31)
    day: u8,
    /// Hour (0-23)
    hour: u8,
    /// Minute (0-59)
    minute: u8,
    /// Second (0-59, or 60 for leap second)
    second: u8,
    /// Nanoseconds (0-999_999_999)
    nanosecond: u32,
    /// UTC offset in seconds (e.g., -18000 for UTC-5)
    utc_offset: i32,
}

// Day of the week
pub enum Weekday {
    Sunday,
    Monday,
    Tuesday,
    Wednesday,
    Thursday,
    Friday,
    Saturday,
}

// Month of the year
pub enum Month {
    January,
    February,
    March,
    April,
    May,
    June,
    July,
    August,
    September,
    October,
    November,
    December,
}

// ============================================================================
// Constructors
// ============================================================================

// Get the current local date and time.
pub fn datetime_now() -> DateTime with IO {
    var timestamp: i64 = 0
    time(&!timestamp)

    var tm = Tm {
        tm_sec: 0, tm_min: 0, tm_hour: 0,
        tm_mday: 0, tm_mon: 0, tm_year: 0,
        tm_wday: 0, tm_yday: 0, tm_isdst: 0,
    }

    localtime_r(&timestamp, &!tm)

    // Calculate UTC offset by comparing with gmtime
    var tm_utc = Tm {
        tm_sec: 0, tm_min: 0, tm_hour: 0,
        tm_mday: 0, tm_mon: 0, tm_year: 0,
        tm_wday: 0, tm_yday: 0, tm_isdst: 0,
    }
    gmtime_r(&timestamp, &!tm_utc)

    let local_secs = tm.tm_hour * 3600 + tm.tm_min * 60 + tm.tm_sec
    let utc_secs = tm_utc.tm_hour * 3600 + tm_utc.tm_min * 60 + tm_utc.tm_sec
    var offset = local_secs - utc_secs

    // Handle day boundary
    if tm.tm_mday != tm_utc.tm_mday {
        if tm.tm_mday > tm_utc.tm_mday || (tm.tm_mday == 1 && tm_utc.tm_mday > 1) {
            offset = offset + 86400
        } else {
            offset = offset - 86400
        }
    }

    DateTime {
        year: tm.tm_year + 1900,
        month: (tm.tm_mon + 1) as u8,
        day: tm.tm_mday as u8,
        hour: tm.tm_hour as u8,
        minute: tm.tm_min as u8,
        second: tm.tm_sec as u8,
        nanosecond: 0,
        utc_offset: offset,
    }
}

// Get the current UTC date and time.
pub fn datetime_now_utc() -> DateTime with IO {
    var timestamp: i64 = 0
    time(&!timestamp)

    var tm = Tm {
        tm_sec: 0, tm_min: 0, tm_hour: 0,
        tm_mday: 0, tm_mon: 0, tm_year: 0,
        tm_wday: 0, tm_yday: 0, tm_isdst: 0,
    }

    gmtime_r(&timestamp, &!tm)

    DateTime {
        year: tm.tm_year + 1900,
        month: (tm.tm_mon + 1) as u8,
        day: tm.tm_mday as u8,
        hour: tm.tm_hour as u8,
        minute: tm.tm_min as u8,
        second: tm.tm_sec as u8,
        nanosecond: 0,
        utc_offset: 0,
    }
}

// Create a DateTime from components (assumes local timezone).
pub fn datetime_new(
    year: i32,
    month: u8,
    day: u8,
    hour: u8,
    minute: u8,
    second: u8
) -> DateTime {
    DateTime {
        year: year,
        month: month,
        day: day,
        hour: hour,
        minute: minute,
        second: second,
        nanosecond: 0,
        utc_offset: 0,  // Will be set when converted
    }
}

// Create a DateTime from a Unix timestamp (seconds since 1970-01-01 UTC).
pub fn datetime_from_timestamp(timestamp: i64) -> DateTime with IO {
    var tm = Tm {
        tm_sec: 0, tm_min: 0, tm_hour: 0,
        tm_mday: 0, tm_mon: 0, tm_year: 0,
        tm_wday: 0, tm_yday: 0, tm_isdst: 0,
    }

    gmtime_r(&timestamp, &!tm)

    DateTime {
        year: tm.tm_year + 1900,
        month: (tm.tm_mon + 1) as u8,
        day: tm.tm_mday as u8,
        hour: tm.tm_hour as u8,
        minute: tm.tm_min as u8,
        second: tm.tm_sec as u8,
        nanosecond: 0,
        utc_offset: 0,
    }
}

// Convert DateTime to Unix timestamp.
pub fn datetime_to_timestamp(dt: &DateTime) -> i64 with IO {
    var tm = Tm {
        tm_sec: dt.second as i32,
        tm_min: dt.minute as i32,
        tm_hour: dt.hour as i32,
        tm_mday: dt.day as i32,
        tm_mon: (dt.month - 1) as i32,
        tm_year: dt.year - 1900,
        tm_wday: 0,
        tm_yday: 0,
        tm_isdst: -1,  // Let mktime determine DST
    }

    let timestamp = mktime(&!tm)

    // Adjust for UTC offset
    timestamp - (dt.utc_offset as i64)
}

// ============================================================================
// Accessors
// ============================================================================

// Get the year.
pub fn datetime_year(dt: &DateTime) -> i32 {
    dt.year
}

// Get the month (1-12).
pub fn datetime_month(dt: &DateTime) -> u8 {
    dt.month
}

// Get the day of month (1-31).
pub fn datetime_day(dt: &DateTime) -> u8 {
    dt.day
}

// Get the hour (0-23).
pub fn datetime_hour(dt: &DateTime) -> u8 {
    dt.hour
}

// Get the minute (0-59).
pub fn datetime_minute(dt: &DateTime) -> u8 {
    dt.minute
}

// Get the second (0-59).
pub fn datetime_second(dt: &DateTime) -> u8 {
    dt.second
}

// Get the day of the week.
pub fn datetime_weekday(dt: &DateTime) -> Weekday with IO {
    let timestamp = datetime_to_timestamp(dt)

    var tm = Tm {
        tm_sec: 0, tm_min: 0, tm_hour: 0,
        tm_mday: 0, tm_mon: 0, tm_year: 0,
        tm_wday: 0, tm_yday: 0, tm_isdst: 0,
    }

    gmtime_r(&timestamp, &!tm)

    match tm.tm_wday {
        0 => Weekday::Sunday,
        1 => Weekday::Monday,
        2 => Weekday::Tuesday,
        3 => Weekday::Wednesday,
        4 => Weekday::Thursday,
        5 => Weekday::Friday,
        _ => Weekday::Saturday,
    }
}

// Get the day of the year (1-366).
pub fn datetime_day_of_year(dt: &DateTime) -> u16 with IO {
    let timestamp = datetime_to_timestamp(dt)

    var tm = Tm {
        tm_sec: 0, tm_min: 0, tm_hour: 0,
        tm_mday: 0, tm_mon: 0, tm_year: 0,
        tm_wday: 0, tm_yday: 0, tm_isdst: 0,
    }

    gmtime_r(&timestamp, &!tm)

    (tm.tm_yday + 1) as u16
}

// Check if the year is a leap year.
pub fn datetime_is_leap_year(dt: &DateTime) -> bool {
    let year = dt.year
    (year % 4 == 0 && year % 100 != 0) || (year % 400 == 0)
}

// Get the number of days in the month.
pub fn datetime_days_in_month(dt: &DateTime) -> u8 {
    match dt.month {
        1 => 31,
        2 => if datetime_is_leap_year(dt) { 29 } else { 28 },
        3 => 31,
        4 => 30,
        5 => 31,
        6 => 30,
        7 => 31,
        8 => 31,
        9 => 30,
        10 => 31,
        11 => 30,
        12 => 31,
        _ => 0,
    }
}

// ============================================================================
// Arithmetic
// ============================================================================

// Add a duration to a DateTime.
pub fn datetime_add(dt: &DateTime, d: &Duration) -> DateTime with IO {
    let timestamp = datetime_to_timestamp(dt) + (d.secs as i64)
    var result = datetime_from_timestamp(timestamp)
    result.nanosecond = dt.nanosecond + d.nanos
    if result.nanosecond >= 1_000_000_000 {
        result.nanosecond = result.nanosecond - 1_000_000_000
        result = datetime_from_timestamp(timestamp + 1)
        result.nanosecond = dt.nanosecond + d.nanos - 1_000_000_000
    }
    result.utc_offset = dt.utc_offset
    result
}

// Subtract a duration from a DateTime.
pub fn datetime_sub(dt: &DateTime, d: &Duration) -> DateTime with IO {
    let timestamp = datetime_to_timestamp(dt) - (d.secs as i64)
    var result = datetime_from_timestamp(timestamp)
    if dt.nanosecond >= d.nanos {
        result.nanosecond = dt.nanosecond - d.nanos
    } else {
        result = datetime_from_timestamp(timestamp - 1)
        result.nanosecond = 1_000_000_000 - (d.nanos - dt.nanosecond)
    }
    result.utc_offset = dt.utc_offset
    result
}

// Calculate the duration between two DateTimes.
pub fn datetime_diff(a: &DateTime, b: &DateTime) -> Duration with IO {
    let ts_a = datetime_to_timestamp(a)
    let ts_b = datetime_to_timestamp(b)

    if ts_a >= ts_b {
        let secs = (ts_a - ts_b) as u64
        let nanos = if a.nanosecond >= b.nanosecond {
            a.nanosecond - b.nanosecond
        } else {
            // Borrow from seconds
            1_000_000_000 - (b.nanosecond - a.nanosecond)
        }
        Duration { secs: secs, nanos: nanos }
    } else {
        let secs = (ts_b - ts_a) as u64
        let nanos = if b.nanosecond >= a.nanosecond {
            b.nanosecond - a.nanosecond
        } else {
            1_000_000_000 - (a.nanosecond - b.nanosecond)
        }
        Duration { secs: secs, nanos: nanos }
    }
}

// Add days to a DateTime.
pub fn datetime_add_days(dt: &DateTime, days: i32) -> DateTime with IO {
    let timestamp = datetime_to_timestamp(dt) + (days as i64) * 86400
    var result = datetime_from_timestamp(timestamp)
    result.nanosecond = dt.nanosecond
    result.utc_offset = dt.utc_offset
    result
}

// Add months to a DateTime.
pub fn datetime_add_months(dt: &DateTime, months: i32) -> DateTime {
    var year = dt.year
    var month = (dt.month as i32) + months

    while month > 12 {
        month = month - 12
        year = year + 1
    }
    while month < 1 {
        month = month + 12
        year = year - 1
    }

    // Clamp day to valid range for new month
    var result = DateTime {
        year: year,
        month: month as u8,
        day: dt.day,
        hour: dt.hour,
        minute: dt.minute,
        second: dt.second,
        nanosecond: dt.nanosecond,
        utc_offset: dt.utc_offset,
    }

    let max_day = datetime_days_in_month(&result)
    if result.day > max_day {
        result.day = max_day
    }

    result
}

// Add years to a DateTime.
pub fn datetime_add_years(dt: &DateTime, years: i32) -> DateTime {
    var result = DateTime {
        year: dt.year + years,
        month: dt.month,
        day: dt.day,
        hour: dt.hour,
        minute: dt.minute,
        second: dt.second,
        nanosecond: dt.nanosecond,
        utc_offset: dt.utc_offset,
    }

    // Handle Feb 29 in non-leap years
    if result.month == 2 && result.day == 29 && !datetime_is_leap_year(&result) {
        result.day = 28
    }

    result
}

// ============================================================================
// Comparison
// ============================================================================

// Compare two DateTimes. Returns -1, 0, or 1.
pub fn datetime_cmp(a: &DateTime, b: &DateTime) -> i32 with IO {
    let ts_a = datetime_to_timestamp(a)
    let ts_b = datetime_to_timestamp(b)

    if ts_a < ts_b {
        -1
    } else if ts_a > ts_b {
        1
    } else if a.nanosecond < b.nanosecond {
        -1
    } else if a.nanosecond > b.nanosecond {
        1
    } else {
        0
    }
}

// Check if two DateTimes are equal.
pub fn datetime_eq(a: &DateTime, b: &DateTime) -> bool with IO {
    datetime_cmp(a, b) == 0
}

// Check if a is before b.
pub fn datetime_lt(a: &DateTime, b: &DateTime) -> bool with IO {
    datetime_cmp(a, b) < 0
}

// Check if a is after b.
pub fn datetime_gt(a: &DateTime, b: &DateTime) -> bool with IO {
    datetime_cmp(a, b) > 0
}

// ============================================================================
// Formatting
// ============================================================================

// Format DateTime using strftime-style format string.
//
// Common format specifiers:
// - %Y: 4-digit year
// - %m: 2-digit month (01-12)
// - %d: 2-digit day (01-31)
// - %H: 2-digit hour (00-23)
// - %M: 2-digit minute (00-59)
// - %S: 2-digit second (00-59)
// - %F: %Y-%m-%d
// - %T: %H:%M:%S
// - %a: Abbreviated weekday
// - %A: Full weekday
// - %b: Abbreviated month
// - %B: Full month
pub fn datetime_format(dt: &DateTime, format: &str) -> String with IO, Alloc {
    var tm = Tm {
        tm_sec: dt.second as i32,
        tm_min: dt.minute as i32,
        tm_hour: dt.hour as i32,
        tm_mday: dt.day as i32,
        tm_mon: (dt.month - 1) as i32,
        tm_year: dt.year - 1900,
        tm_wday: 0,
        tm_yday: 0,
        tm_isdst: -1,
    }

    var buf = [0u8; 256]
    let format_cstr = string_to_cstr(format)

    let len = strftime(&!buf[0], 256, format_cstr.as_ptr(), &tm)

    var s = string_new()
    var i = 0
    while i < len {
        string_push(&!s, buf[i] as char)
        i = i + 1
    }

    s
}

// Format as ISO 8601: YYYY-MM-DDTHH:MM:SS
pub fn datetime_to_iso8601(dt: &DateTime) -> String with Alloc {
    var s = string_new()

    // Year
    string_push_str(&!s, &i32_to_padded_string(dt.year, 4))
    string_push(&!s, '-')

    // Month
    string_push_str(&!s, &u8_to_padded_string(dt.month, 2))
    string_push(&!s, '-')

    // Day
    string_push_str(&!s, &u8_to_padded_string(dt.day, 2))
    string_push(&!s, 'T')

    // Hour
    string_push_str(&!s, &u8_to_padded_string(dt.hour, 2))
    string_push(&!s, ':')

    // Minute
    string_push_str(&!s, &u8_to_padded_string(dt.minute, 2))
    string_push(&!s, ':')

    // Second
    string_push_str(&!s, &u8_to_padded_string(dt.second, 2))

    // Timezone
    if dt.utc_offset == 0 {
        string_push(&!s, 'Z')
    } else {
        let sign = if dt.utc_offset >= 0 { '+' } else { '-' }
        let abs_offset = if dt.utc_offset >= 0 { dt.utc_offset } else { -dt.utc_offset }
        let hours = abs_offset / 3600
        let minutes = (abs_offset % 3600) / 60

        string_push(&!s, sign)
        string_push_str(&!s, &i32_to_padded_string(hours, 2))
        string_push(&!s, ':')
        string_push_str(&!s, &i32_to_padded_string(minutes, 2))
    }

    s
}

// Format as RFC 2822: Mon, 02 Jan 2006 15:04:05 -0700
pub fn datetime_to_rfc2822(dt: &DateTime) -> String with IO, Alloc {
    let weekdays = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"]
    let months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun",
                  "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]

    let wd = datetime_weekday(dt)
    let wd_idx = match wd {
        Weekday::Sunday => 0,
        Weekday::Monday => 1,
        Weekday::Tuesday => 2,
        Weekday::Wednesday => 3,
        Weekday::Thursday => 4,
        Weekday::Friday => 5,
        Weekday::Saturday => 6,
    }

    var s = string_new()

    string_push_str(&!s, weekdays[wd_idx])
    string_push_str(&!s, ", ")
    string_push_str(&!s, &u8_to_padded_string(dt.day, 2))
    string_push(&!s, ' ')
    string_push_str(&!s, months[(dt.month - 1) as usize])
    string_push(&!s, ' ')
    string_push_str(&!s, &i32_to_padded_string(dt.year, 4))
    string_push(&!s, ' ')
    string_push_str(&!s, &u8_to_padded_string(dt.hour, 2))
    string_push(&!s, ':')
    string_push_str(&!s, &u8_to_padded_string(dt.minute, 2))
    string_push(&!s, ':')
    string_push_str(&!s, &u8_to_padded_string(dt.second, 2))
    string_push(&!s, ' ')

    // Timezone offset
    let sign = if dt.utc_offset >= 0 { '+' } else { '-' }
    let abs_offset = if dt.utc_offset >= 0 { dt.utc_offset } else { -dt.utc_offset }
    let hours = abs_offset / 3600
    let minutes = (abs_offset % 3600) / 60

    string_push(&!s, sign)
    string_push_str(&!s, &i32_to_padded_string(hours, 2))
    string_push_str(&!s, &i32_to_padded_string(minutes, 2))

    s
}

// Helper functions
fn i32_to_padded_string(n: i32, width: usize) -> String with Alloc {
    var s = string_new()
    var num = if n < 0 { -n } else { n }

    if n < 0 {
        string_push(&!s, '-')
    }

    var digits = vec_new::<char>()
    if num == 0 {
        vec_push(&!digits, '0')
    } else {
        while num > 0 {
            let digit = ((num % 10) as u8 + ('0' as u8)) as char
            vec_push(&!digits, digit)
            num = num / 10
        }
    }

    // Pad with zeros
    while vec_len(&digits) < width {
        vec_push(&!digits, '0')
    }

    // Reverse and append
    var i = vec_len(&digits)
    while i > 0 {
        i = i - 1
        string_push(&!s, digits[i])
    }

    s
}

fn u8_to_padded_string(n: u8, width: usize) -> String with Alloc {
    i32_to_padded_string(n as i32, width)
}

fn string_to_cstr(s: &str) -> Vec<u8> with Alloc {
    var v = vec_new::<u8>()
    for c in s.bytes() {
        vec_push(&!v, c)
    }
    vec_push(&!v, 0)  // null terminator
    v
}
