// epistemic/causal.sio — Causal Inference with Epistemic Uncertainty
// Pearl's do-calculus with Bayesian uncertainty tracking using fixed-size arrays

fn ec_abs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }
fn ec_sqrt(x: f64) -> f64 {
    if x <= 0.0 { return 0.0 }
    var r = x
    var i = 0
    while i < 15 { r = 0.5 * (r + x / r); i = i + 1 }
    r
}
fn ec_clamp01(x: f64) -> f64 { if x < 0.0 { 0.0 } else if x > 1.0 { 1.0 } else { x } }

// Node types in causal DAG
enum NodeType {
    Treatment,
    Outcome,
    Confounder,
    Mediator,
    Collider,
    Instrument,
}

// Beta distribution for edge existence probability
struct EcBeta {
    alpha: f64,
    beta_p: f64,
}

fn ec_beta_new(a: f64, b: f64) -> EcBeta { EcBeta { alpha: a, beta_p: b } }
fn ec_beta_mean(b: EcBeta) -> f64 { b.alpha / (b.alpha + b.beta_p) }
fn ec_beta_variance(b: EcBeta) -> f64 {
    let n = b.alpha + b.beta_p
    (b.alpha * b.beta_p) / (n * n * (n + 1.0))
}
fn ec_beta_update(prior: EcBeta, successes: f64, failures: f64) -> EcBeta {
    EcBeta { alpha: prior.alpha + successes, beta_p: prior.beta_p + failures }
}

struct EcEpistemicSummary {
    mean: f64,
    variance: f64,
    ci_lo: f64,
    ci_hi: f64,
}

fn ec_beta_summary(b: EcBeta) -> EcEpistemicSummary {
    let m = ec_beta_mean(b)
    let v = ec_beta_variance(b)
    let s = ec_sqrt(v)
    EcEpistemicSummary { mean: m, variance: v, ci_lo: ec_clamp01(m - 1.96 * s), ci_hi: ec_clamp01(m + 1.96 * s) }
}

fn ec_beta_from_mean_variance(mean: f64, variance: f64) -> EcBeta {
    let m = ec_clamp01(mean)
    let max_var = m * (1.0 - m)
    var v = variance
    if v > max_var * 0.99 { v = max_var * 0.99 }
    if v < 0.0001 { v = 0.0001 }
    let c = m * (1.0 - m) / v - 1.0
    let cc = if c < 2.0 { 2.0 } else { c }
    EcBeta { alpha: m * cc, beta_p: (1.0 - m) * cc }
}

// Causal edge with epistemic uncertainty
struct CausalEdge {
    from_id: i32,
    to_id: i32,
    exists: EcBeta,
    strength: f64,
    strength_var: f64,
}

// Causal DAG (fixed-size, up to 16 nodes, 64 edges)
struct CausalDAG {
    adj: [i32; 256],      // 16x16 adjacency matrix
    edge_exists: [EcBeta; 64],
    edge_strength: [f64; 64],
    edge_strength_var: [f64; 64],
    node_types: [i32; 16],
    n_nodes: i32,
    n_edges: i32,
}

fn causal_dag_new() -> CausalDAG {
    CausalDAG {
        adj: [0; 256],
        edge_exists: [ec_beta_new(1.0, 1.0); 64],
        edge_strength: [0.0; 64],
        edge_strength_var: [0.0; 64],
        node_types: [0; 16],
        n_nodes: 0,
        n_edges: 0,
    }
}

fn dag_add_node(dag: CausalDAG, node_type: i32) -> CausalDAG with Mut, Div, Panic {
    var result = dag
    if result.n_nodes < 16 {
        result.node_types[result.n_nodes] = node_type
        result.n_nodes = result.n_nodes + 1
    }
    result
}

fn dag_add_edge(dag: CausalDAG, from: i32, to: i32, exists: EcBeta, strength: f64, strength_var: f64) -> CausalDAG with Mut, Div, Panic {
    var result = dag
    result.adj[from * 16 + to] = 1
    if result.n_edges < 64 {
        result.edge_exists[result.n_edges] = exists
        result.edge_strength[result.n_edges] = strength
        result.edge_strength_var[result.n_edges] = strength_var
        result.n_edges = result.n_edges + 1
    }
    result
}

// Pearl's do-operator: remove incoming edges to a node
fn do_intervention(dag: CausalDAG, target: i32) -> CausalDAG with Mut, Div, Panic {
    var result = dag
    var i: i32 = 0
    while i < dag.n_nodes {
        result.adj[i * 16 + target] = 0
        i = i + 1
    }
    result
}

// Backdoor adjustment: ATE via blocking confounders
fn average_treatment_effect(
    dag: &CausalDAG,
    treatment: i32,
    outcome: i32,
    outcomes_treated: &[f64; 64],
    outcomes_control: &[f64; 64],
    n_treated: i32,
    n_control: i32
) -> EcEpistemicSummary with Mut, Div, Panic {
    if n_treated <= 0 || n_control <= 0 {
        return EcEpistemicSummary { mean: 0.0, variance: 1.0, ci_lo: 0.0 - 1.0, ci_hi: 1.0 }
    }
    var sum_t = 0.0
    var i: i32 = 0
    while i < n_treated { sum_t = sum_t + outcomes_treated[i]; i = i + 1 }
    let mean_t = sum_t / (n_treated as f64)

    var sum_c = 0.0
    i = 0
    while i < n_control { sum_c = sum_c + outcomes_control[i]; i = i + 1 }
    let mean_c = sum_c / (n_control as f64)

    let ate = mean_t - mean_c
    let se = ec_sqrt(1.0 / (n_treated as f64) + 1.0 / (n_control as f64))
    EcEpistemicSummary { mean: ate, variance: se * se, ci_lo: ate - 1.96 * se, ci_hi: ate + 1.96 * se }
}

fn test_dag_construction() -> bool with Mut, Div, Panic {
    var dag = causal_dag_new()
    dag = dag_add_node(dag, 0) // treatment
    dag = dag_add_node(dag, 1) // outcome
    dag = dag_add_edge(dag, 0, 1, ec_beta_new(8.0, 2.0), 0.5, 0.1)
    dag.n_nodes == 2 && dag.n_edges == 1
}

fn test_do_intervention() -> bool with Mut, Div, Panic {
    var dag = causal_dag_new()
    dag = dag_add_node(dag, 2) // confounder
    dag = dag_add_node(dag, 0) // treatment
    dag = dag_add_node(dag, 1) // outcome
    dag = dag_add_edge(dag, 0, 1, ec_beta_new(8.0, 2.0), 0.5, 0.1)
    dag = dag_add_edge(dag, 0, 2, ec_beta_new(6.0, 4.0), 0.3, 0.2)
    let intervened = do_intervention(dag, 1)
    intervened.adj[0 * 16 + 1] == 0
}
