// Proof-carrying epistemic model contest D2.
//
// This is an exact finite synthetic inference kernel. It does not represent a
// person, calibrated observation process, causal mechanism, subjective
// suffering, or clinical authority.

pub struct ContestHypothesisReceipt {
    hypothesis_id: i64,
    predictive_mode: i64,
    grouping_code: i64,
    synthetic_not_patient_model: bool,
}

pub struct FourHypothesisFamilyReceipt {
    family_id: i64,
    protocol_id: i64,
    h0: ContestHypothesisReceipt,
    h1: ContestHypothesisReceipt,
    h2: ContestHypothesisReceipt,
    h3: ContestHypothesisReceipt,
    declared_family_exhaustive: bool,
    globally_complete_claimed: bool,
}

pub struct SyntheticContestProbeReceipt {
    probe_id: i64,
    protocol_id: i64,
    probe_index: i64,
    burden_units: i64,
    same_input_for_every_hypothesis: bool,
    physical_intervention: bool,
    clinical_action: bool,
}

pub struct ObservationProvenanceReceipt {
    provenance_id: i64,
    source_id: i64,
    protocol_id: i64,
    tick: i64,
    previous_provenance_id: i64,
    chain_complete: bool,
    synthetic_source_only: bool,
}

pub struct AdmissibleContestObservationReceipt {
    observation_id: i64,
    family_id: i64,
    protocol_id: i64,
    probe_id: i64,
    probe_index: i64,
    burden_units: i64,
    tick: i64,
    value_numerator: i64,
    value_denominator: i64,
    provenance_id: i64,
    previous_provenance_id: i64,
    source_id: i64,
    value_present: bool,
    schema_matches: bool,
    provenance_complete: bool,
    common_probe: bool,
    physical_intervention: bool,
}

pub struct MissingContestObservationReceipt {
    observation_id: i64,
    family_id: i64,
    protocol_id: i64,
    probe_id: i64,
    probe_index: i64,
    tick: i64,
    value_present: bool,
    missingness_ignorable_assumed: bool,
}

pub struct UnauditedContestObservationReceipt {
    observation_id: i64,
    family_id: i64,
    protocol_id: i64,
    probe_id: i64,
    probe_index: i64,
    tick: i64,
    value_numerator: i64,
    value_denominator: i64,
    value_present: bool,
    provenance_complete: bool,
}

struct ContestStateReceipt {
    state_id: i64,
    family_id: i64,
    protocol_id: i64,
    h0_alive: bool,
    h1_alive: bool,
    h2_alive: bool,
    h3_alive: bool,
    survivor_mask: i64,
    survivor_count: i64,
    evidence_count: i64,
    last_tick: i64,
    last_observation_id: i64,
    last_provenance_id: i64,
    ordered_provenance_fingerprint: i64,
    burden_spent: i64,
    ambiguous: bool,
    family_refuted: bool,
    global_truth_established: bool,
    causal_mechanism_established: bool,
    clinical_authority: bool,
}

struct ContestTransitionReceipt {
    transition_id: i64,
    family_id: i64,
    protocol_id: i64,
    source_state_id: i64,
    source_h0_alive: bool,
    source_h1_alive: bool,
    source_h2_alive: bool,
    source_h3_alive: bool,
    source_survivor_count: i64,
    source_evidence_count: i64,
    source_last_tick: i64,
    source_last_provenance_id: i64,
    source_provenance_fingerprint: i64,
    source_burden_spent: i64,
    observation_id: i64,
    probe_id: i64,
    probe_index: i64,
    observed_value_numerator: i64,
    observed_value_denominator: i64,
    observation_burden_units: i64,
    provenance_id: i64,
    previous_provenance_id: i64,
    source_id: i64,
    tick: i64,
    source_survivor_mask: i64,
    result_survivor_mask: i64,
    eliminated_mask: i64,
    eliminated_count: i64,
    exact_prediction_table_replayed: bool,
    provenance_admissibility_checked: bool,
    same_probe_used_for_all_hypotheses: bool,
    result: ContestStateReceipt,
}

pub struct EpistemicAbstentionReceipt {
    pub abstention_id: i64,
