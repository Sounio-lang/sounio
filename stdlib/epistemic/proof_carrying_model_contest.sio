pub fn declare_contest_hypothesis(
    hypothesis_id: i64,
    predictive_mode: i64,
    grouping_code: i64,
) -> ContestHypothesisReceipt with Panic {
    assert(hypothesis_id > 0)
    assert(predictive_mode >= 0 && predictive_mode <= 3)
    assert(grouping_code == 1 || grouping_code == 2)
    if predictive_mode <= 1 {
        assert(grouping_code == 1)
    } else {
        assert(grouping_code == 2)
    }
    ContestHypothesisReceipt {
        hypothesis_id: hypothesis_id,
        predictive_mode: predictive_mode,
        grouping_code: grouping_code,
        synthetic_not_patient_model: true,
    }
}

pub fn declare_four_hypothesis_family(
    family_id: i64,
    protocol_id: i64,
    h0: ContestHypothesisReceipt,
    h1: ContestHypothesisReceipt,
    h2: ContestHypothesisReceipt,
    h3: ContestHypothesisReceipt,
) -> FourHypothesisFamilyReceipt with Panic {
    assert_contest_hypothesis_invariants(h0)
    assert_contest_hypothesis_invariants(h1)
    assert_contest_hypothesis_invariants(h2)
    assert_contest_hypothesis_invariants(h3)
    assert(family_id > 0 && protocol_id > 0)
    assert(h0.predictive_mode == 0 && h1.predictive_mode == 1)
    assert(h2.predictive_mode == 2 && h3.predictive_mode == 3)
    assert(h0.hypothesis_id != h1.hypothesis_id)
    assert(h0.hypothesis_id != h2.hypothesis_id)
    assert(h0.hypothesis_id != h3.hypothesis_id)
    assert(h1.hypothesis_id != h2.hypothesis_id)
    assert(h1.hypothesis_id != h3.hypothesis_id)
    assert(h2.hypothesis_id != h3.hypothesis_id)
    FourHypothesisFamilyReceipt {
        family_id: family_id,
        protocol_id: protocol_id,
        h0: h0,
        h1: h1,
        h2: h2,
        h3: h3,
        declared_family_exhaustive: true,
        globally_complete_claimed: false,
    }
}

pub fn declare_synthetic_contest_probe(
    probe_id: i64,
    protocol_id: i64,
    probe_index: i64,
) -> SyntheticContestProbeReceipt with Panic {
    assert(probe_id > 0 && protocol_id > 0)
    assert(probe_index >= 0 && probe_index <= 2)
    let burden = contest_probe_burden(probe_index)
    SyntheticContestProbeReceipt {
        probe_id: probe_id,
        protocol_id: protocol_id,
        probe_index: probe_index,
        burden_units: burden,
        same_input_for_every_hypothesis: true,
        physical_intervention: false,
        clinical_action: false,
    }
}

pub fn contest_probe_burden(probe_index: i64) -> i64 with Panic {
    assert(probe_index >= 0 && probe_index <= 2)
    if probe_index == 0 { 2 } else if probe_index == 1 { 3 } else { 5 }
}

pub fn contest_prediction_numerator(mode: i64, probe_index: i64) -> i64 with Panic {
    assert(mode >= 0 && mode <= 3)
    assert(probe_index >= 0 && probe_index <= 2)
    if mode == 0 {
        if probe_index == 0 { 400 } else if probe_index == 1 { 450 } else { 500 }
    } else if mode == 1 {
        if probe_index == 0 { 400 } else if probe_index == 1 { 550 } else { 500 }
    } else if mode == 2 {
        if probe_index == 0 { 600 } else if probe_index == 1 { 450 } else { 500 }
    } else {
        if probe_index == 0 { 600 } else if probe_index == 1 { 450 } else { 650 }
    }
}

pub fn contest_probe_separates_pair(
    first_mode: i64,
    second_mode: i64,
    probe_index: i64,
) -> bool with Panic {
    contest_prediction_numerator(first_mode, probe_index) !=
        contest_prediction_numerator(second_mode, probe_index)
}

pub fn contest_probe_separates_triple(
    first_mode: i64,
    second_mode: i64,
    third_mode: i64,
    probe_index: i64,
) -> bool with Panic {
    contest_probe_separates_pair(first_mode, second_mode, probe_index) &&
        contest_probe_separates_pair(first_mode, third_mode, probe_index) &&
        contest_probe_separates_pair(second_mode, third_mode, probe_index)
}

pub fn contest_probe_separates_four(probe_index: i64) -> bool with Panic {
    contest_probe_separates_triple(0, 1, 2, probe_index) &&
        contest_probe_separates_pair(0, 3, probe_index) &&
        contest_probe_separates_pair(1, 3, probe_index) &&
        contest_probe_separates_pair(2, 3, probe_index)
}

pub fn record_observation_provenance(
    provenance_id: i64,
    source_id: i64,
    protocol_id: i64,
    tick: i64,
    previous_provenance_id: i64,
) -> ObservationProvenanceReceipt with Panic {
    assert(provenance_id > 0 && provenance_id <= 1000000)
    assert(source_id > 0 && protocol_id > 0)
    assert(tick > 0 && previous_provenance_id >= 0)
    assert(previous_provenance_id != provenance_id)
    ObservationProvenanceReceipt {
        provenance_id: provenance_id,
        source_id: source_id,
        protocol_id: protocol_id,
        tick: tick,
        previous_provenance_id: previous_provenance_id,
        chain_complete: true,
        synthetic_source_only: true,
    }
}

pub fn admit_contest_observation(
    observation_id: i64,
    prior: ContestStateReceipt,
    family: FourHypothesisFamilyReceipt,
    probe: SyntheticContestProbeReceipt,
    provenance: ObservationProvenanceReceipt,
    value_numerator: i64,
    value_denominator: i64,
) -> AdmissibleContestObservationReceipt with Panic {
    assert_contest_state_invariants(prior)
    assert_contest_family_invariants(family)
    assert_synthetic_contest_probe_invariants(probe)
    assert_observation_provenance_invariants(provenance)
    assert(observation_id > 0)
    assert(family.family_id > 0)
    assert(prior.family_id == family.family_id)
    assert(prior.protocol_id == family.protocol_id)
    assert(probe.protocol_id == family.protocol_id)
    assert(provenance.protocol_id == family.protocol_id)
    assert(provenance.chain_complete && provenance.source_id > 0)
    assert(provenance.tick > prior.last_tick)
    assert(provenance.previous_provenance_id == prior.last_provenance_id)
    assert(probe.same_input_for_every_hypothesis)
    assert(value_numerator >= 0 && value_numerator <= 1000)
    assert(value_denominator == 1000)
    AdmissibleContestObservationReceipt {
        observation_id: observation_id,
        family_id: family.family_id,
        protocol_id: family.protocol_id,
        probe_id: probe.probe_id,
        probe_index: probe.probe_index,
        burden_units: probe.burden_units,
        tick: provenance.tick,
        value_numerator: value_numerator,
        value_denominator: value_denominator,
        provenance_id: provenance.provenance_id,
        previous_provenance_id: provenance.previous_provenance_id,
        source_id: provenance.source_id,
        value_present: true,
        schema_matches: true,
        provenance_complete: true,
        common_probe: true,
        physical_intervention: false,
    }
}

pub fn record_missing_contest_observation(
    observation_id: i64,
    family_id: i64,
    probe: SyntheticContestProbeReceipt,
    tick: i64,
) -> MissingContestObservationReceipt with Panic {
    assert_synthetic_contest_probe_invariants(probe)
    assert(observation_id > 0 && family_id > 0 && tick > 0)
    MissingContestObservationReceipt {
        observation_id: observation_id,
        family_id: family_id,
        protocol_id: probe.protocol_id,
        probe_id: probe.probe_id,
        probe_index: probe.probe_index,
        tick: tick,
        value_present: false,
        missingness_ignorable_assumed: false,
    }
}

pub fn record_unaudited_contest_observation(
    observation_id: i64,
    family_id: i64,
    probe: SyntheticContestProbeReceipt,
    tick: i64,
    value_numerator: i64,
) -> UnauditedContestObservationReceipt with Panic {
    assert_synthetic_contest_probe_invariants(probe)
    assert(observation_id > 0 && family_id > 0 && tick > 0)
    assert(value_numerator >= 0 && value_numerator <= 1000)
    UnauditedContestObservationReceipt {
        observation_id: observation_id,
        family_id: family_id,
        protocol_id: probe.protocol_id,
        probe_id: probe.probe_id,
        probe_index: probe.probe_index,
        tick: tick,
        value_numerator: value_numerator,
        value_denominator: 1000,
        value_present: true,
        provenance_complete: false,
    }
}

pub fn begin_proof_carrying_contest(
    state_id: i64,
    family: FourHypothesisFamilyReceipt,
) -> ContestStateReceipt with Panic {
    assert_contest_family_invariants(family)
    assert(state_id > 0 && family.declared_family_exhaustive)
    assert(!family.globally_complete_claimed)
    ContestStateReceipt {
        state_id: state_id,
        family_id: family.family_id,
        protocol_id: family.protocol_id,
        h0_alive: true,
        h1_alive: true,
        h2_alive: true,
        h3_alive: true,
        survivor_mask: 15,
        survivor_count: 4,
        evidence_count: 0,
        last_tick: 0,
        last_observation_id: 0,
        last_provenance_id: 0,
        ordered_provenance_fingerprint: 0,
        burden_spent: 0,
        ambiguous: true,
        family_refuted: false,
        global_truth_established: false,
        causal_mechanism_established: false,
        clinical_authority: false,
    }
}

pub fn update_proof_carrying_contest(
    transition_id: i64,
    next_state_id: i64,
    prior: ContestStateReceipt,
    family: FourHypothesisFamilyReceipt,
    observation: AdmissibleContestObservationReceipt,
) -> ContestTransitionReceipt with Panic {
    assert_contest_state_invariants(prior)
    assert_contest_family_invariants(family)
    assert_admissible_contest_observation_invariants(observation)
    assert(transition_id > 0 && next_state_id > 0)
    assert(next_state_id != prior.state_id)
    assert(prior.family_id == family.family_id)
    assert(prior.protocol_id == family.protocol_id)
    assert(observation.family_id == family.family_id)
    assert(observation.protocol_id == family.protocol_id)
    assert(observation.tick > prior.last_tick)
    assert(observation.value_present && observation.schema_matches)
    assert(observation.provenance_complete && observation.source_id > 0)
    assert(observation.previous_provenance_id == prior.last_provenance_id)
    assert(observation.provenance_id != prior.last_provenance_id)
    assert(observation.common_probe && !observation.physical_intervention)
    assert(observation.value_denominator == 1000)
    assert(prior.survivor_count > 0)
    assert(prior.evidence_count < 8)
    // With at most seven prior links and each ID <= 10^6, the largest
    // prior base-31 value is 917087137000000. Appending the eighth yields
    // 28429701248000000, safely inside signed i64.
    assert(prior.ordered_provenance_fingerprint >= 0)
    assert(prior.ordered_provenance_fingerprint <= 917087137000000)
    assert(observation.provenance_id <= 1000000)

    let h0_match = contest_prediction_numerator(
        family.h0.predictive_mode, observation.probe_index,
    ) == observation.value_numerator
    let h1_match = contest_prediction_numerator(
        family.h1.predictive_mode, observation.probe_index,
    ) == observation.value_numerator
    let h2_match = contest_prediction_numerator(
        family.h2.predictive_mode, observation.probe_index,
    ) == observation.value_numerator
    let h3_match = contest_prediction_numerator(
        family.h3.predictive_mode, observation.probe_index,
    ) == observation.value_numerator
    let h0_alive = prior.h0_alive && h0_match
    let h1_alive = prior.h1_alive && h1_match
    let h2_alive = prior.h2_alive && h2_match
    let h3_alive = prior.h3_alive && h3_match
    let count = bool_count(h0_alive) + bool_count(h1_alive) +
        bool_count(h2_alive) + bool_count(h3_alive)
    let mask = survivor_mask(h0_alive, h1_alive, h2_alive, h3_alive)
    let eliminated = prior.survivor_mask - mask
    let eliminated_count = prior.survivor_count - count
    let next_burden = prior.burden_spent + observation.burden_units
    let next_fingerprint = prior.ordered_provenance_fingerprint * 31 +
        observation.provenance_id
    assert(mask >= 0 && mask <= prior.survivor_mask)
    assert(eliminated >= 0 && eliminated_count >= 0)
    assert(next_burden >= prior.burden_spent && next_burden <= 100)
    assert(next_fingerprint > prior.ordered_provenance_fingerprint)
    let result = ContestStateReceipt {
        state_id: next_state_id,
        family_id: family.family_id,
        protocol_id: family.protocol_id,
        h0_alive: h0_alive,
        h1_alive: h1_alive,
        h2_alive: h2_alive,
        h3_alive: h3_alive,
        survivor_mask: mask,
        survivor_count: count,
        evidence_count: prior.evidence_count + 1,
        last_tick: observation.tick,
        last_observation_id: observation.observation_id,
        last_provenance_id: observation.provenance_id,
        ordered_provenance_fingerprint: next_fingerprint,
        burden_spent: next_burden,
        ambiguous: count > 1,
        family_refuted: count == 0,
        global_truth_established: false,
        causal_mechanism_established: false,
        clinical_authority: false,
    }
    ContestTransitionReceipt {
        transition_id: transition_id,
        family_id: family.family_id,
        protocol_id: family.protocol_id,
        source_state_id: prior.state_id,
        source_h0_alive: prior.h0_alive,
        source_h1_alive: prior.h1_alive,
        source_h2_alive: prior.h2_alive,
        source_h3_alive: prior.h3_alive,
        source_survivor_count: prior.survivor_count,
        source_evidence_count: prior.evidence_count,
        source_last_tick: prior.last_tick,
        source_last_provenance_id: prior.last_provenance_id,
        source_provenance_fingerprint: prior.ordered_provenance_fingerprint,
        source_burden_spent: prior.burden_spent,
        observation_id: observation.observation_id,
        probe_id: observation.probe_id,
        probe_index: observation.probe_index,
        observed_value_numerator: observation.value_numerator,
        observed_value_denominator: observation.value_denominator,
        observation_burden_units: observation.burden_units,
        provenance_id: observation.provenance_id,
        previous_provenance_id: observation.previous_provenance_id,
        source_id: observation.source_id,
        tick: observation.tick,
        source_survivor_mask: prior.survivor_mask,
        result_survivor_mask: mask,
        eliminated_mask: eliminated,
        eliminated_count: eliminated_count,
        exact_prediction_table_replayed: true,
        provenance_admissibility_checked: true,
        same_probe_used_for_all_hypotheses: true,
        result: result,
    }
}

pub fn abstain_on_missing_observation(
    abstention_id: i64,
    state: ContestStateReceipt,
    missing: MissingContestObservationReceipt,
) -> EpistemicAbstentionReceipt with Panic {
    assert_contest_state_invariants(state)
    assert(abstention_id > 0)
    assert(missing.family_id == state.family_id)
    assert(missing.protocol_id == state.protocol_id)
    assert(missing.tick > state.last_tick)
    assert(!missing.value_present)
    assert(!missing.missingness_ignorable_assumed)
    EpistemicAbstentionReceipt {
        abstention_id: abstention_id,
        source_state_id: state.state_id,
        observation_id: missing.observation_id,
        reason_code: 1,
        survivor_mask_unchanged: state.survivor_mask,
        survivor_count_unchanged: state.survivor_count,
        hypotheses_eliminated: 0,
        burden_added: 0,
        inference_deferred: true,
        clinical_authority: false,
    }
}

pub fn abstain_on_unaudited_observation(
    abstention_id: i64,
    state: ContestStateReceipt,
    unaudited: UnauditedContestObservationReceipt,
) -> EpistemicAbstentionReceipt with Panic {
    assert_contest_state_invariants(state)
    assert(abstention_id > 0)
    assert(unaudited.family_id == state.family_id)
    assert(unaudited.protocol_id == state.protocol_id)
    assert(unaudited.tick > state.last_tick)
    assert(unaudited.value_present && !unaudited.provenance_complete)
    EpistemicAbstentionReceipt {
        abstention_id: abstention_id,
        source_state_id: state.state_id,
        observation_id: unaudited.observation_id,
        reason_code: 2,
        survivor_mask_unchanged: state.survivor_mask,
        survivor_count_unchanged: state.survivor_count,
        hypotheses_eliminated: 0,
        burden_added: 0,
        inference_deferred: true,
        clinical_authority: false,
    }
}

pub fn abstain_on_disconnected_provenance(
    abstention_id: i64,
    state: ContestStateReceipt,
    observation_id: i64,
    probe: SyntheticContestProbeReceipt,
    provenance: ObservationProvenanceReceipt,
) -> EpistemicAbstentionReceipt with Panic {
    assert_contest_state_invariants(state)
    assert_synthetic_contest_probe_invariants(probe)
    assert_observation_provenance_invariants(provenance)
    assert(abstention_id > 0 && observation_id > 0)
    assert(probe.protocol_id == state.protocol_id)
    assert(provenance.protocol_id == state.protocol_id)
    assert(provenance.tick > state.last_tick)
    assert(provenance.previous_provenance_id != state.last_provenance_id)
    EpistemicAbstentionReceipt {
        abstention_id: abstention_id,
        source_state_id: state.state_id,
        observation_id: observation_id,
        reason_code: 3,
        survivor_mask_unchanged: state.survivor_mask,
        survivor_count_unchanged: state.survivor_count,
        hypotheses_eliminated: 0,
        burden_added: 0,
        inference_deferred: true,
        clinical_authority: false,
    }
}

pub fn certify_finite_family_identification(
    identification_id: i64,
    transition: ContestTransitionReceipt,
    family: FourHypothesisFamilyReceipt,
) -> FiniteFamilyIdentificationReceipt with Panic {
    assert_contest_transition_replays_family(transition, family)
    assert(identification_id > 0)
    assert(transition.result.family_id == family.family_id)
    assert(transition.result.survivor_count == 1)
    assert(!transition.result.family_refuted)
    let selected = if transition.result.h0_alive {
        family.h0.hypothesis_id
    } else if transition.result.h1_alive {
        family.h1.hypothesis_id
    } else if transition.result.h2_alive {
        family.h2.hypothesis_id
    } else {
        family.h3.hypothesis_id
    }
    FiniteFamilyIdentificationReceipt {
        identification_id: identification_id,
        family_id: family.family_id,
        result_state_id: transition.result.state_id,
        selected_hypothesis_id: selected,
        survivor_count: 1,
        evidence_count: transition.result.evidence_count,
        burden_spent: transition.result.burden_spent,
        provenance_fingerprint:
            transition.result.ordered_provenance_fingerprint,
        identification_within_declared_family: true,
        global_truth_established: false,
        causal_mechanism_established: false,
        clinical_authority: false,
    }
}

pub fn certify_declared_family_refutation(
    refutation_id: i64,
    transition: ContestTransitionReceipt,
    family: FourHypothesisFamilyReceipt,
) -> DeclaredFamilyRefutationReceipt with Panic {
    assert_contest_transition_replays_family(transition, family)
    assert(refutation_id > 0)
    assert(transition.result.survivor_count == 0)
    assert(transition.result.family_refuted)
    DeclaredFamilyRefutationReceipt {
        refutation_id: refutation_id,
        family_id: transition.result.family_id,
        result_state_id: transition.result.state_id,
        source_survivor_mask: transition.source_survivor_mask,
        survivor_count: 0,
        evidence_count: transition.result.evidence_count,
        family_refuted: true,
        reality_refuted: false,
        nearest_model_selected: false,
        clinical_authority: false,
    }
}

pub fn certify_adaptive_burden_policy(
    policy_id: i64,
    family: FourHypothesisFamilyReceipt,
) -> AdaptiveBurdenPolicyReceipt with Panic {
    assert_contest_family_invariants(family)
    assert(policy_id > 0)
    // Exhaust the three one-probe policies: none identifies all four modes.
    assert(!contest_probe_separates_four(0))
    assert(!contest_probe_separates_four(1))
    assert(!contest_probe_separates_four(2))

    // Root A creates exactly {H0,H1} and {H2,H3}. Only B separates the
    // first pair and only C separates the second, exhausting all child probes.
    assert(!contest_probe_separates_pair(0, 1, 0))
    assert(contest_probe_separates_pair(0, 1, 1))
    assert(!contest_probe_separates_pair(0, 1, 2))
    assert(!contest_probe_separates_pair(2, 3, 0))
    assert(!contest_probe_separates_pair(2, 3, 1))
    assert(contest_probe_separates_pair(2, 3, 2))
    assert(contest_probe_separates_pair(0, 2, 0))
    assert(contest_probe_separates_pair(1, 3, 0))

    // Root B leaves {H0,H2,H3}; root C leaves {H0,H1,H2}. Enumerating all
    // three possible child probes proves that neither root completes at depth 2.
    assert(!contest_probe_separates_triple(0, 2, 3, 0))
    assert(!contest_probe_separates_triple(0, 2, 3, 1))
    assert(!contest_probe_separates_triple(0, 2, 3, 2))
    assert(!contest_probe_separates_triple(0, 1, 2, 0))
    assert(!contest_probe_separates_triple(0, 1, 2, 1))
    assert(!contest_probe_separates_triple(0, 1, 2, 2))

    let root_burden = contest_probe_burden(0)
    let low_branch_burden = contest_probe_burden(1)
    let high_branch_burden = contest_probe_burden(2)
    let worst_child_burden = if low_branch_burden > high_branch_burden {
        low_branch_burden
    } else {
        high_branch_burden
    }
    let selected_worst_burden = root_burden + worst_child_burden
    let preset_burden = root_burden + low_branch_burden + high_branch_burden
    assert(selected_worst_burden == 7)
    assert(preset_burden == 10)
    AdaptiveBurdenPolicyReceipt {
        policy_id: policy_id,
        family_id: family.family_id,
        root_probe_index: 0,
        observation400_child_probe: 1,
        observation600_child_probe: 2,
        root_block_count: 2,
        final_leaf_count: 4,
        worst_case_burden: selected_worst_burden,
        preset_burden: preset_burden,
        one_probe_identification_possible: false,
        alternative_roots_complete_at_depth_two: false,
        selected_policy_complete_at_depth_two: true,
        declared_policy_space_exhausted: true,
        bounded_minimax_optimal: true,
        outside_declared_policy_space_optimality_claimed: false,
        burden_is_subjective_suffering: false,
        clinical_action: false,
    }
}

pub fn refuse_insufficient_burden_budget(
    policy: AdaptiveBurdenPolicyReceipt,
    available_burden: i64,
) -> BudgetInsufficientReceipt with Panic {
    assert(available_burden >= 0)
    assert(available_burden < policy.worst_case_burden)
    BudgetInsufficientReceipt {
        policy_id: policy.policy_id,
        available_burden: available_burden,
        required_worst_case_burden: policy.worst_case_burden,
        budget_insufficient: true,
        experiment_authorized: false,
    }
}

pub fn certify_hypothesis_relabel_invariance(
    control_id: i64,
    original: FourHypothesisFamilyReceipt,
    relabeled: FourHypothesisFamilyReceipt,
) -> HypothesisRelabelControlReceipt with Mut, Panic {
    assert_contest_family_invariants(original)
    assert_contest_family_invariants(relabeled)
    assert(control_id > 0)
    assert(original.family_id != relabeled.family_id)
    assert(original.h0.hypothesis_id != relabeled.h0.hypothesis_id)
    assert(original.h1.hypothesis_id != relabeled.h1.hypothesis_id)
    assert(original.h2.hypothesis_id != relabeled.h2.hypothesis_id)
    assert(original.h3.hypothesis_id != relabeled.h3.hypothesis_id)
    assert(original.h0.predictive_mode == relabeled.h0.predictive_mode)
    assert(original.h1.predictive_mode == relabeled.h1.predictive_mode)
    assert(original.h2.predictive_mode == relabeled.h2.predictive_mode)
    assert(original.h3.predictive_mode == relabeled.h3.predictive_mode)
    var probe: i64 = 0
    while probe < 3 {
        assert(contest_prediction_numerator(original.h0.predictive_mode, probe) ==
            contest_prediction_numerator(relabeled.h0.predictive_mode, probe))
        assert(contest_prediction_numerator(original.h1.predictive_mode, probe) ==
            contest_prediction_numerator(relabeled.h1.predictive_mode, probe))
        assert(contest_prediction_numerator(original.h2.predictive_mode, probe) ==
            contest_prediction_numerator(relabeled.h2.predictive_mode, probe))
        assert(contest_prediction_numerator(original.h3.predictive_mode, probe) ==
            contest_prediction_numerator(relabeled.h3.predictive_mode, probe))
        probe = probe + 1
    }
    HypothesisRelabelControlReceipt {
        original_family_id: original.family_id,
        relabeled_family_id: relabeled.family_id,
        hypothesis_ids_distinct: true,
        predictive_modes_equal: true,
        all_probe_predictions_equal: true,
        partition_and_policy_invariant: true,
    }
}
