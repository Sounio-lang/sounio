pub struct HypothesisRelabelControlReceipt {
    pub original_family_id: i64,
    pub relabeled_family_id: i64,
    pub hypothesis_ids_distinct: bool,
    pub predictive_modes_equal: bool,
    pub all_probe_predictions_equal: bool,
    pub partition_and_policy_invariant: bool,
}

pub struct GlobalModelTruthReceipt { pub truth_id: i64 }
pub struct CausalContestMechanismReceipt { pub mechanism_id: i64 }
pub struct ClinicalContestActionReceipt { pub action_id: i64 }
pub struct SubjectiveSufferingReceipt { pub suffering_id: i64 }
pub struct PhysicalContestInterventionReceipt { pub intervention_id: i64 }
pub struct NegativeEvidenceReceipt { pub evidence_id: i64 }

fn bool_count(value: bool) -> i64 {
    if value { 1 } else { 0 }
}

fn survivor_mask(h0: bool, h1: bool, h2: bool, h3: bool) -> i64 {
    bool_count(h0) + 2 * bool_count(h1) +
        4 * bool_count(h2) + 8 * bool_count(h3)
}

fn assert_contest_hypothesis_invariants(
    hypothesis: ContestHypothesisReceipt,
) with Panic {
    assert(hypothesis.hypothesis_id > 0)
    assert(hypothesis.predictive_mode >= 0 && hypothesis.predictive_mode <= 3)
    if hypothesis.predictive_mode <= 1 {
        assert(hypothesis.grouping_code == 1)
    } else {
        assert(hypothesis.grouping_code == 2)
    }
    assert(hypothesis.synthetic_not_patient_model)
}

fn assert_contest_family_invariants(
    family: FourHypothesisFamilyReceipt,
) with Panic {
    assert(family.family_id > 0 && family.protocol_id > 0)
    assert_contest_hypothesis_invariants(family.h0)
    assert_contest_hypothesis_invariants(family.h1)
    assert_contest_hypothesis_invariants(family.h2)
    assert_contest_hypothesis_invariants(family.h3)
    assert(family.h0.predictive_mode == 0 && family.h1.predictive_mode == 1)
    assert(family.h2.predictive_mode == 2 && family.h3.predictive_mode == 3)
    assert(family.h0.hypothesis_id != family.h1.hypothesis_id)
    assert(family.h0.hypothesis_id != family.h2.hypothesis_id)
    assert(family.h0.hypothesis_id != family.h3.hypothesis_id)
    assert(family.h1.hypothesis_id != family.h2.hypothesis_id)
    assert(family.h1.hypothesis_id != family.h3.hypothesis_id)
    assert(family.h2.hypothesis_id != family.h3.hypothesis_id)
    assert(family.declared_family_exhaustive)
    assert(!family.globally_complete_claimed)
}

fn assert_synthetic_contest_probe_invariants(
    probe: SyntheticContestProbeReceipt,
) with Panic {
    assert(probe.probe_id > 0 && probe.protocol_id > 0)
    assert(probe.probe_index >= 0 && probe.probe_index <= 2)
    assert(probe.burden_units == contest_probe_burden(probe.probe_index))
    assert(probe.same_input_for_every_hypothesis)
    assert(!probe.physical_intervention)
    assert(!probe.clinical_action)
}

fn assert_observation_provenance_invariants(
    provenance: ObservationProvenanceReceipt,
) with Panic {
    assert(provenance.provenance_id > 0 && provenance.provenance_id <= 1000000)
    assert(provenance.source_id > 0 && provenance.protocol_id > 0)
    assert(provenance.tick > 0 && provenance.previous_provenance_id >= 0)
    assert(provenance.previous_provenance_id != provenance.provenance_id)
    assert(provenance.chain_complete)
    assert(provenance.synthetic_source_only)
}

fn assert_admissible_contest_observation_invariants(
    observation: AdmissibleContestObservationReceipt,
) with Panic {
    assert(observation.observation_id > 0)
    assert(observation.family_id > 0 && observation.protocol_id > 0)
    assert(observation.probe_id > 0)
    assert(observation.probe_index >= 0 && observation.probe_index <= 2)
    assert(observation.burden_units ==
        contest_probe_burden(observation.probe_index))
    assert(observation.tick > 0)
    assert(observation.value_numerator >= 0 && observation.value_numerator <= 1000)
    assert(observation.value_denominator == 1000)
    assert(observation.provenance_id > 0 && observation.provenance_id <= 1000000)
    assert(observation.previous_provenance_id >= 0)
    assert(observation.source_id > 0)
    assert(observation.value_present && observation.schema_matches)
    assert(observation.provenance_complete && observation.common_probe)
    assert(!observation.physical_intervention)
}

fn assert_contest_state_invariants(state: ContestStateReceipt) with Panic {
    let count = bool_count(state.h0_alive) + bool_count(state.h1_alive) +
        bool_count(state.h2_alive) + bool_count(state.h3_alive)
    let mask = survivor_mask(
        state.h0_alive, state.h1_alive, state.h2_alive, state.h3_alive,
    )
    assert(state.state_id > 0 && state.family_id > 0 && state.protocol_id > 0)
    assert(state.survivor_count == count)
    assert(state.survivor_mask == mask)
    assert(state.ambiguous == (count > 1))
    assert(state.family_refuted == (count == 0))
    assert(state.evidence_count >= 0 && state.evidence_count <= 8)
    assert(state.last_tick >= 0 && state.last_observation_id >= 0)
    assert(state.last_provenance_id >= 0 && state.last_provenance_id <= 1000000)
    assert(state.ordered_provenance_fingerprint >= 0)
    assert(state.ordered_provenance_fingerprint <= 28429701248000000)
    assert(state.burden_spent >= 0 && state.burden_spent <= 100)
    if state.evidence_count == 0 {
        assert(state.last_tick == 0 && state.last_observation_id == 0)
        assert(state.last_provenance_id == 0)
        assert(state.ordered_provenance_fingerprint == 0)
        assert(state.burden_spent == 0)
    } else {
        assert(state.last_tick > 0 && state.last_observation_id > 0)
        assert(state.last_provenance_id > 0)
        assert(state.ordered_provenance_fingerprint > 0)
    }
    assert(!state.global_truth_established)
    assert(!state.causal_mechanism_established)
    assert(!state.clinical_authority)
}

fn assert_contest_transition_invariants(
    transition: ContestTransitionReceipt,
) with Panic {
    assert_contest_state_invariants(transition.result)
    assert(transition.transition_id > 0 && transition.source_state_id > 0)
    assert(transition.family_id == transition.result.family_id)
    assert(transition.protocol_id == transition.result.protocol_id)
    assert(transition.source_state_id != transition.result.state_id)
    assert(transition.source_survivor_count > 0 &&
        transition.source_survivor_count <= 4)
    assert(transition.source_survivor_mask == survivor_mask(
        transition.source_h0_alive,
        transition.source_h1_alive,
        transition.source_h2_alive,
        transition.source_h3_alive,
    ))
    assert(transition.source_survivor_count ==
        bool_count(transition.source_h0_alive) +
        bool_count(transition.source_h1_alive) +
        bool_count(transition.source_h2_alive) +
        bool_count(transition.source_h3_alive))
    assert(transition.source_evidence_count >= 0 &&
        transition.source_evidence_count < 8)
    assert(transition.source_last_tick >= 0)
    assert(transition.source_last_provenance_id >= 0 &&
        transition.source_last_provenance_id <= 1000000)
    assert(transition.source_provenance_fingerprint >= 0 &&
        transition.source_provenance_fingerprint <= 917087137000000)
    assert(transition.source_burden_spent >= 0 &&
        transition.source_burden_spent <= 100)
    if transition.source_evidence_count == 0 {
        assert(transition.source_last_tick == 0)
        assert(transition.source_last_provenance_id == 0)
        assert(transition.source_provenance_fingerprint == 0)
        assert(transition.source_burden_spent == 0)
    } else {
        assert(transition.source_last_tick > 0)
        assert(transition.source_last_provenance_id > 0)
        assert(transition.source_provenance_fingerprint > 0)
    }
    assert(transition.observation_id > 0 && transition.provenance_id > 0)
    assert(transition.probe_id > 0)
    assert(transition.probe_index >= 0 && transition.probe_index <= 2)
    assert(transition.observed_value_numerator >= 0 &&
        transition.observed_value_numerator <= 1000)
    assert(transition.observed_value_denominator == 1000)
    assert(transition.observation_burden_units ==
        contest_probe_burden(transition.probe_index))
    assert(transition.provenance_id <= 1000000)
    assert(transition.source_id > 0 && transition.tick > 0)
    assert(transition.tick > transition.source_last_tick)
    assert(transition.previous_provenance_id ==
        transition.source_last_provenance_id)
    assert(transition.result.last_observation_id == transition.observation_id)
    assert(transition.result.last_provenance_id == transition.provenance_id)
    assert(transition.result.last_tick == transition.tick)
    assert(transition.result_survivor_mask == transition.result.survivor_mask)
    assert(transition.result_survivor_mask <= transition.source_survivor_mask)
    assert(transition.result.evidence_count ==
        transition.source_evidence_count + 1)
    assert(transition.result.burden_spent ==
        transition.source_burden_spent + transition.observation_burden_units)
    assert(transition.result.ordered_provenance_fingerprint ==
        transition.source_provenance_fingerprint * 31 +
        transition.provenance_id)
    assert(transition.eliminated_mask ==
        transition.source_survivor_mask - transition.result_survivor_mask)
    assert(transition.eliminated_count >= 0 && transition.eliminated_count <= 4)
    assert(transition.eliminated_count ==
        transition.source_survivor_count - transition.result.survivor_count)
    assert(transition.exact_prediction_table_replayed)
    assert(transition.provenance_admissibility_checked)
    assert(transition.same_probe_used_for_all_hypotheses)
}

fn assert_contest_transition_replays_family(
    transition: ContestTransitionReceipt,
    family: FourHypothesisFamilyReceipt,
) with Panic {
    assert_contest_family_invariants(family)
    assert_contest_transition_invariants(transition)
    assert(transition.family_id == family.family_id)
    assert(transition.protocol_id == family.protocol_id)
    let h0_expected = transition.source_h0_alive &&
        contest_prediction_numerator(
            family.h0.predictive_mode, transition.probe_index,
        ) == transition.observed_value_numerator
    let h1_expected = transition.source_h1_alive &&
        contest_prediction_numerator(
            family.h1.predictive_mode, transition.probe_index,
        ) == transition.observed_value_numerator
    let h2_expected = transition.source_h2_alive &&
        contest_prediction_numerator(
            family.h2.predictive_mode, transition.probe_index,
        ) == transition.observed_value_numerator
    let h3_expected = transition.source_h3_alive &&
        contest_prediction_numerator(
            family.h3.predictive_mode, transition.probe_index,
        ) == transition.observed_value_numerator
    assert(transition.result.h0_alive == h0_expected)
    assert(transition.result.h1_alive == h1_expected)
    assert(transition.result.h2_alive == h2_expected)
    assert(transition.result.h3_alive == h3_expected)
}

