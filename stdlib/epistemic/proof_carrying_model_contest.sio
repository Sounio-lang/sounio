    pub final_leaf_count: i64,
    pub worst_case_burden: i64,
    pub preset_burden: i64,
    pub one_probe_identification_possible: bool,
    pub alternative_roots_complete_at_depth_two: bool,
    pub selected_policy_complete_at_depth_two: bool,
    pub declared_policy_space_exhausted: bool,
