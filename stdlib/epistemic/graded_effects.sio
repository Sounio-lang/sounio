// stdlib/epistemic/graded_effects.sio — Graded Epistemic Effects
//
// Fuses row-polymorphic algebraic effects (Track A) with the
// epistemic/aleatoric uncertainty split (Track B) into a unified
// graded modality system.
//
// Theory (PLDI 2027, Track C):
//   - Grade an effect row with an uncertainty bound: Prob<ε>
//   - Epistemic grade composition: Prob<ε1> ∘ Prob<ε2> = Prob<√(ε1² + ε2²)]
//   - Aleatoric grade composition: Prob<ε1> ∘ Prob<ε2> = Prob<ε1 + ε2>
//   - Subsumption: Prob<ε_tight> satisfies Prob<ε_loose> iff ε_tight ≤ ε_loose
//
// GUM compliance: grade composition is GUM-sound (ISO/IEC Guide 98-3).
//
// References:
//   - Granule: graded modal types (Orchard/McBride)
//   - GMDT: graded modal dependent types (Abel/Orchard POPL 2023)
//   - DEUP: decomposed epistemic/aleatoric uncertainty (Bengio 2021)

module epistemic::graded_effects

// GradedProb: runtime representation of a Prob<ε>-graded computation result.
// Carries the value, the achieved grade ε, and whether the grade is epistemic or aleatoric.
struct GradedProb {
    value: f64,
    epsilon: f64,       // achieved uncertainty grade ε ∈ [0,1]
    is_aleatoric: bool, // false = epistemic (reducible), true = aleatoric (irreducible)
}

// Construct an epistemic-graded value: reducible by more data
fn graded_epistemic(value: f64, epsilon: f64) -> GradedProb {
    GradedProb {
        value: value,
        epsilon: epsilon,
        is_aleatoric: false,
    }
}

// Construct an aleatoric-graded value: irreducible physical uncertainty
fn graded_aleatoric(value: f64, epsilon: f64) -> GradedProb {
    GradedProb {
        value: value,
        epsilon: epsilon,
        is_aleatoric: true,
    }
}

// Integer square root approximation (10 Newton iterations)
fn graded_sqrt(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 {
        0.0
    } else {
        var est: f64 = x
        var i: i64 = 0
        while i < 10 {
            est = (est + x / est) / 2.0
            i = i + 1
        }
        est
    }
}

// ============================================================================
// TESTEMUNHA DE INDEPENDÊNCIA
// ============================================================================
//
// 🚨 Até 28-ago-2026 `graded_compose` aplicava QUADRATURA INCONDICIONALMENTE quando as duas
// entradas eram epistêmicas — sem checagem de independência, sem termo de covariância, sem
// obrigação de prova.
//
// O GUM (JCGM 100, §5.2) exige u²(x+y) = u²(x) + u²(y) + 2ρ·u(x)·u(y). Com ρ > 0 a quadratura
// SUBESTIMA a incerteza. O SEMANTICS.md deste próprio projeto, Invariante 2, diz:
// "Violating this means your uncertainty bounds are lies."
//
// E violava no caso que o domínio mais produz: HRV × FC são correlacionadas; corpo × céu são
// correlacionados pela hora do dia — o confundidor primário pré-registrado no HELIO-N1 (D4).
//
// A ironia registrada: `stdlib/epistemic/gum.sio` JÁ trata covariância (Hessiano com Σ,
// `gum_first_order_variance`). A biblioteca madura tem o rigor; quem ignorava era esta camada —
// justamente a que reivindica ineditismo teórico (PLDI 2027, Track C).
//
// A inversão que este arquivo faz: o padrão passa a ser o LIMITE CONSERVADOR, e a quadratura
// passa a exigir testemunha. Antes era o contrário, e o contrário publica limites mais
// apertados que a verdade por omissão.
//
// ⚠️ Limite honesto desta camada: uma testemunha aqui é um valor, e valores podem ser forjados.
// A não-forjabilidade real exige `IndepKnowledge<T, A, B | Z>` no checador (TyCondIndep, que já
// existe em self-hosted/check/types.sio) ligado a esta lei de composição. O que esta camada
// garante é que toda alegação de independência NÃO PROVADA seja GREPÁVEL — `indep_declared` é a
// única porta, e o motivo textual é obrigatório. É a mesma disciplina de `.value` como efeito:
// o descarte fica auditável por grep, não impedido.
struct IndepWitness {
    // 0 = nenhuma (ρ desconhecido ⇒ pior caso)
    // 1 = provada por d-separação sobre um grafo causal declarado
    // 2 = DECLARADA sem prova (porta de escape auditável)
    // 3 = ρ conhecido, usa a fórmula completa do GUM
    kind: i64,
    rho: f64,
}

// Sem testemunha: ρ desconhecido. A composição vai para o pior caso.
fn indep_none() -> IndepWitness {
    IndepWitness { kind: 0, rho: 1.0 }
}

// Testemunha PROVADA. O `dsep` deve vir de `cat_d_separated` (stdlib/causal/base.sio) sobre o
// grafo causal do problema — esta função não inventa a prova, ela a transporta. Se a
// d-separação falhar, degrada para "sem testemunha" em vez de mentir.
fn indep_from_dsep(dsep: bool) -> IndepWitness {
    if dsep {
        IndepWitness { kind: 1, rho: 0.0 }
    } else {
        indep_none()
    }
}

// PORTA DE ESCAPE, deliberadamente feia e grepável: independência afirmada sem prova.
// Todo uso desta função é uma dívida epistêmica localizável por
//   grep -rn "indep_declared" --include=*.sio
// e é isso que a torna aceitável. Um sistema sem porta de escape ganha portas escondidas.
fn indep_declared(reason: &str) -> IndepWitness {
    IndepWitness { kind: 2, rho: 0.0 }
}

// ρ conhecido (medido ou derivado). Não é independência — é o caso honesto em que a correlação
// é conhecida e entra na fórmula.
fn indep_correlated(rho: f64) -> IndepWitness {
    IndepWitness { kind: 3, rho: rho }
}

fn indep_is_proved(w: IndepWitness) -> bool {
    w.kind == 1
}

// Combinação de duas incertezas sob uma correlação ρ, que é a fórmula do GUM §5.2 inteira:
//     u_c = sqrt(u1² + u2² + 2·ρ·u1·u2)
// Note que os dois extremos são casos particulares desta única expressão:
//     ρ = 0 → quadratura (o caso independente)
//     ρ = 1 → u1 + u2 (o limite de Cauchy–Schwarz, que é a soma aditiva)
// Por isso o "limite conservador" não é uma invenção defensiva: é a MESMA lei avaliada no pior ρ.
fn graded_combine_rho(u1: f64, u2: f64, rho: f64) -> f64 with Mut, Div, Panic {
    let sum_sq = u1 * u1 + u2 * u2 + 2.0 * rho * u1 * u2
    if sum_sq <= 0.0 {
        0.0
    } else {
        graded_sqrt(sum_sq)
    }
}

// Grade composition: a ∘ b, COM testemunha.
// Mixed (epistemic + aleatoric) → aleatoric (worst case, irreducibility dominates).
fn graded_compose_with(a: GradedProb, b: GradedProb, w: IndepWitness) -> GradedProb with Mut, Div, Panic {
    if a.is_aleatoric || b.is_aleatoric {
        // Aleatoric dominates: additive composition
        GradedProb {
            value: a.value,
            epsilon: a.epsilon + b.epsilon,
            is_aleatoric: true,
        }
    } else {
        // ρ efetivo segundo a testemunha. Sem testemunha, ρ = 1 — o pior caso admissível,
        // e não ρ = 0, que era o que a versão anterior assumia em silêncio.
        var rho: f64 = 1.0
        if w.kind == 1 {
            rho = 0.0
        } else if w.kind == 2 {
            rho = 0.0
        } else if w.kind == 3 {
            rho = w.rho
        }
        GradedProb {
            value: a.value,
            epsilon: graded_combine_rho(a.epsilon, b.epsilon, rho),
            is_aleatoric: false,
        }
    }
}

// Compatibilidade de assinatura, semântica INVERTIDA de propósito.
//
// Quem chama sem testemunha agora recebe o LIMITE CONSERVADOR (ρ = 1), não a quadratura. Isto
// muda o número que programas existentes produzem — e essa mudança é o resultado, não o efeito
// colateral: cada lugar onde o número afrouxa é um lugar onde o sistema vinha publicando um
// limite de incerteza mais apertado que a verdade.
fn graded_compose(a: GradedProb, b: GradedProb) -> GradedProb with Mut, Div, Panic {
    graded_compose_with(a, b, indep_none())
}

// Subsumption check: does `provided` satisfy `required` grade?
// Returns true iff provided.ε ≤ required.ε
fn graded_subsumes(provided: GradedProb, required_epsilon: f64) -> bool {
    provided.epsilon <= required_epsilon
}

// Bayesian update: reduce epistemic grade by n new samples
// New ε ~= ε_prior / sqrt(1 + n)  (Bernstein-von Mises convergence rate)
fn graded_epistemic_update(prior: GradedProb, n_samples: i64) -> GradedProb with Mut, Div, Panic {
    if prior.is_aleatoric || n_samples <= 0 {
        prior
    } else {
        let n_f = n_samples as f64
        let new_eps = prior.epsilon / graded_sqrt(1.0 + n_f)
        GradedProb {
            value: prior.value,
            epsilon: new_eps,
            is_aleatoric: false,
        }
    }
}

// Extract the grade (uncertainty bound)
fn graded_epsilon(g: GradedProb) -> f64 {
    g.epsilon
}

// Extract the value
fn graded_value(g: GradedProb) -> f64 {
    g.value
}

// Check if this grade is at the threshold for a safety-critical decision
// Returns true if epsilon <= threshold (safe to act on)
fn graded_is_safe(g: GradedProb, threshold: f64) -> bool {
    g.epsilon <= threshold
}
