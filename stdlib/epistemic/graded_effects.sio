// stdlib/epistemic/graded_effects.sio — Graded Epistemic Effects
//
// Fuses row-polymorphic algebraic effects (Track A) with the
// epistemic/aleatoric uncertainty split (Track B) into a unified
// graded modality system.
//
// Theory (PLDI 2027, Track C):
//   - Grade an effect row with an uncertainty bound: Prob<ε>
//   - Epistemic grade composition: Prob<ε1> ∘ Prob<ε2> = Prob<√(ε1² + ε2²)]
//   - Aleatoric grade composition: Prob<ε1> ∘ Prob<ε2> = Prob<ε1 + ε2>
//   - Subsumption: Prob<ε_tight> satisfies Prob<ε_loose> iff ε_tight ≤ ε_loose
//
// GUM compliance: grade composition is GUM-sound (ISO/IEC Guide 98-3).
//
// References:
//   - Granule: graded modal types (Orchard/McBride)
//   - GMDT: graded modal dependent types (Abel/Orchard POPL 2023)
//   - DEUP: decomposed epistemic/aleatoric uncertainty (Bengio 2021)

module epistemic::graded_effects

// GradedProb: runtime representation of a Prob<ε>-graded computation result.
// Carries the value, the achieved grade ε, and whether the grade is epistemic or aleatoric.
pub struct GradedProb {
    pub value: f64,
    pub epsilon: f64,       // achieved uncertainty grade ε ∈ [0,1]
    pub is_aleatoric: bool, // false = epistemic (reducible), true = aleatoric (irreducible)
}

// Construct an epistemic-graded value: reducible by more data
pub fn graded_epistemic(value: f64, epsilon: f64) -> GradedProb {
    GradedProb {
        value: value,
        epsilon: epsilon,
        is_aleatoric: false,
    }
}

// Construct an aleatoric-graded value: irreducible physical uncertainty
pub fn graded_aleatoric(value: f64, epsilon: f64) -> GradedProb {
    GradedProb {
        value: value,
        epsilon: epsilon,
        is_aleatoric: true,
    }
}

// Integer square root approximation (10 Newton iterations)
fn graded_sqrt(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 {
        0.0
    } else {
        var est: f64 = x
        var i: i64 = 0
        while i < 10 {
            est = (est + x / est) / 2.0
            i = i + 1
        }
        est
    }
}

// ============================================================================
// INDEPENDENCE AS A WITNESS
// ============================================================================
//
// Quadrature is not the general composition law. It is the law FOR INDEPENDENT
// inputs (JCGM 100:2008 eq. 10); the general form (eq. 13) carries a covariance
// term. Applying quadrature without independence emits a bound tighter than the
// truth whenever rho > 0 — see tests/run-pass/gum_independence_required.sio,
// which measures the gap.
//
// So independence stops being an unstated premise and becomes an argument that
// must be produced. This is the same discipline the rest of the system already
// applies to provenance: a claim carries how it came to be believed.
//
// The default inverts. Composition without a witness now yields the CONSERVATIVE
// bound. Only a discharged proof or an actual measurement buys the tight one —
// declaring independence buys nothing, because computation cannot create trust.

fn witness_none() -> i64 { return 0 }
fn witness_measured() -> i64 { return 1 }
fn witness_d_separated() -> i64 { return 2 }

// Evidence that two graded quantities may be composed in quadrature.
//   kind = witness_d_separated: discharged structurally. The causal graph proves
//          X ⫫ Y | Z by d-separation (self-hosted/check/causal.sio). This is the
//          witness the type-level lift will consume.
//   kind = witness_measured: rho estimated from n paired samples.
//   kind = witness_none: no evidence. Conservative bound.
pub struct Independence {
    pub kind: i64,
    pub rho: f64,   // measured correlation, kind = witness_measured
    pub n: i64,     // paired samples behind rho
}

pub fn indep_unknown() -> Independence {
    Independence { kind: witness_none(), rho: 0.0, n: 0, }
}

// Structural proof: X and Y are d-separated given Z in the declared causal graph.
pub fn indep_proven() -> Independence {
    Independence { kind: witness_d_separated(), rho: 0.0, n: 0, }
}

// Empirical estimate. `n` is not decoration: a correlation from a handful of
// pairs is not evidence of independence, and the composition below refuses to
// treat it as such.
pub fn indep_measured(rho: f64, n: i64) -> Independence {
    Independence { kind: witness_measured(), rho: rho, n: n, }
}

// Below this many paired samples a measured rho is too unstable to license a
// tighter bound. Chosen as the conventional floor for a stable correlation
// estimate; the point is that SOME floor must exist and be visible, not that
// this particular integer is sacred.
fn indep_min_samples() -> i64 { return 30 }

// Does this witness license quadrature (or the eq. 13 form)?
fn indep_is_usable(w: Independence) -> bool {
    if w.kind == witness_d_separated() { return true }
    if w.kind == witness_measured() {
        if w.n >= indep_min_samples() { return true }
        return false
    }
    return false
}

// ============================================================================
// COMPOSITION
// ============================================================================

// Grade composition: a ∘ b, WITHOUT evidence of independence.
//
// Yields the conservative additive bound. This used to return quadrature, which
// silently assumed independence — the assumption is now the caller's to produce
// via graded_compose_indep.
//
// Additive is the correct fallback: for any rho in [-1, +1],
//     sqrt(e1^2 + e2^2 + 2*rho*e1*e2) <= e1 + e2
// with equality at rho = 1. So the additive bound is never a lie; it is merely
// loose, and looseness is the safe direction (SEMANTICS.md Invariant 2).
pub fn graded_compose(a: GradedProb, b: GradedProb) -> GradedProb with Mut, Div, Panic {
    GradedProb {
        value: a.value,
        epsilon: a.epsilon + b.epsilon,
        is_aleatoric: a.is_aleatoric || b.is_aleatoric,
    }
}

// Grade composition WITH a witness.
//
// Aleatoric still dominates and still composes additively: irreducible noise
// does not become reducible because the inputs happen to be independent.
pub fn graded_compose_indep(a: GradedProb, b: GradedProb, w: Independence) -> GradedProb with Mut, Div, Panic {
    if a.is_aleatoric || b.is_aleatoric {
        return GradedProb {
            value: a.value,
            epsilon: a.epsilon + b.epsilon,
            is_aleatoric: true,
        }
    }

    if !indep_is_usable(w) {
        // No usable evidence: same conservative bound as the witness-free form.
        return GradedProb {
            value: a.value,
            epsilon: a.epsilon + b.epsilon,
            is_aleatoric: false,
        }
    }

    if w.kind == witness_measured() {
        // JCGM 100:2008 eq. (13) with the measured rho. Note this is not always
        // tighter than additive — with rho near 1 it converges to it, which is
        // exactly right.
        let base = a.epsilon * a.epsilon + b.epsilon * b.epsilon
        let cov = 2.0 * w.rho * a.epsilon * b.epsilon
        let total = base + cov
        if total <= 0.0 {
            return GradedProb { value: a.value, epsilon: 0.0, is_aleatoric: false, }
        }
        return GradedProb {
            value: a.value,
            epsilon: graded_sqrt(total),
            is_aleatoric: false,
        }
    }

    // Structurally proven independent: quadrature, eq. (10). This is the only
    // path on which the historic behaviour survives, and now it costs a proof.
    let sum_sq = a.epsilon * a.epsilon + b.epsilon * b.epsilon
    GradedProb {
        value: a.value,
        epsilon: graded_sqrt(sum_sq),
        is_aleatoric: false,
    }
}

// Subsumption check: does `provided` satisfy `required` grade?
// Returns true iff provided.ε ≤ required.ε
fn graded_subsumes(provided: GradedProb, required_epsilon: f64) -> bool {
    provided.epsilon <= required_epsilon
}

// Bayesian update: reduce epistemic grade by n new samples
// New ε ~= ε_prior / sqrt(1 + n)  (Bernstein-von Mises convergence rate)
fn graded_epistemic_update(prior: GradedProb, n_samples: i64) -> GradedProb with Mut, Div, Panic {
    if prior.is_aleatoric || n_samples <= 0 {
        prior
    } else {
        let n_f = n_samples as f64
        let new_eps = prior.epsilon / graded_sqrt(1.0 + n_f)
        GradedProb {
            value: prior.value,
            epsilon: new_eps,
            is_aleatoric: false,
        }
    }
}

// Extract the grade (uncertainty bound)
fn graded_epsilon(g: GradedProb) -> f64 {
    g.epsilon
}

// Extract the value
fn graded_value(g: GradedProb) -> f64 {
    g.value
}

// Check if this grade is at the threshold for a safety-critical decision
// Returns true if epsilon <= threshold (safe to act on)
fn graded_is_safe(g: GradedProb, threshold: f64) -> bool {
    g.epsilon <= threshold
}
