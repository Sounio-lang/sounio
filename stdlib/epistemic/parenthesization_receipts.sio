// stdlib/epistemic/parenthesization_receipts.sio
//
// Nominal receipt boundaries for the distinction between ordered processing and
// parenthesization-sensitive aggregation. These are synthetic research
// scaffolds: they do not establish a physical carrier, mechanism, empirical
// model fit, treatment effect, or clinical authority.

use epistemic::observation_provenance::{
    ObservationHistoryI64,
    op_observation_history_source_system_tag_i64,
    op_observation_history_tag_i64,
}

struct OrderedTransformationPathI64 {
    history_tag: i64,
    source_system_tag: i64,
    path_tag: i64,
}

struct AggregationBoundaryI64 {
    path_tag: i64,
    source_system_tag: i64,
    boundary_tag: i64,
    boundary_kind_tag: i64,
}

struct BracketingDesignI64 {
    boundary_tag: i64,
    source_system_tag: i64,
    left_grouping_tag: i64,
    right_grouping_tag: i64,
    target_feature_tag: i64,
}

struct AlgebraicAssociatorProbeI64 {
    boundary_tag: i64,
    source_system_tag: i64,
    left_grouping_tag: i64,
    right_grouping_tag: i64,
    target_feature_tag: i64,
    carrier_tag: i64,
    associator_tag: i64,
}

struct AssociativityContestI64 {
    boundary_tag: i64,
    source_system_tag: i64,
    left_grouping_tag: i64,
    right_grouping_tag: i64,
    target_feature_tag: i64,
    bag_model_tag: i64,
    ordered_model_tag: i64,
    bracket_model_tag: i64,
    evidence_tag: i64,
}

struct BracketDiscriminatingFeatureI64 {
    boundary_tag: i64,
    source_system_tag: i64,
    left_grouping_tag: i64,
    right_grouping_tag: i64,
    target_feature_tag: i64,
    evidence_tag: i64,
    ordered_feature_tag: i64,
    bracket_feature_tag: i64,
}

struct ParenthesizationSensitivityI64 {
    boundary_tag: i64,
    source_system_tag: i64,
    left_grouping_tag: i64,
    right_grouping_tag: i64,
    target_feature_tag: i64,
    evidence_tag: i64,
    discriminating_feature_tag: i64,
}

struct ParenthesizationAbstentionI64 {
    boundary_tag: i64,
    source_system_tag: i64,
    left_grouping_tag: i64,
    right_grouping_tag: i64,
    target_feature_tag: i64,
    evidence_tag: i64,
    reason_tag: i64,
}

fn pr_require_nonzero(tag: i64) -> i64 with Panic {
    assert(tag != 0)
    tag
}

// Ordered processing is anchored to an observation-history receipt. This is
// still an associative function-composition path, not a grouping claim.
pub fn pr_ordered_transformation_path_i64(
    history: ObservationHistoryI64,
    path_tag: i64
) -> OrderedTransformationPathI64 with Panic {
    OrderedTransformationPathI64 {
        history_tag: op_observation_history_tag_i64(history),
        source_system_tag: op_observation_history_source_system_tag_i64(history),
        path_tag: pr_require_nonzero(path_tag),
    }
}

// A grouping becomes meaningful only through an explicitly declared boundary.
// The tags identify a supplied protocol interpretation; they do not validate
// that interpretation or identify an underlying biological interaction.
pub fn pr_aggregation_boundary_i64(
    path: OrderedTransformationPathI64,
    boundary_tag: i64,
    boundary_kind_tag: i64
) -> AggregationBoundaryI64 with Panic {
    AggregationBoundaryI64 {
        path_tag: path.path_tag,
        source_system_tag: path.source_system_tag,
        boundary_tag: pr_require_nonzero(boundary_tag),
        boundary_kind_tag: pr_require_nonzero(boundary_kind_tag),
    }
}

// A bracketing design names two distinct declared groupings and a target
// feature before a comparison is formed. It is not a result.
pub fn pr_bracketing_design_i64(
    boundary: AggregationBoundaryI64,
    left_grouping_tag: i64,
    right_grouping_tag: i64,
    target_feature_tag: i64
) -> BracketingDesignI64 with Panic {
    let left = pr_require_nonzero(left_grouping_tag)
    let right = pr_require_nonzero(right_grouping_tag)
    assert(left != right)
    BracketingDesignI64 {
        boundary_tag: boundary.boundary_tag,
        source_system_tag: boundary.source_system_tag,
        left_grouping_tag: left,
        right_grouping_tag: right,
        target_feature_tag: pr_require_nonzero(target_feature_tag),
    }
}

// This records only a synthetic algebraic probe under a declared design. A
// nonzero tag may distinguish grouped arithmetic in that carrier; it is not a
// functional, causal, biological, or clinical interpretation.
pub fn pr_algebraic_associator_probe_i64(
    design: BracketingDesignI64,
    carrier_tag: i64,
    associator_tag: i64
) -> AlgebraicAssociatorProbeI64 with Panic {
    AlgebraicAssociatorProbeI64 {
        boundary_tag: design.boundary_tag,
        source_system_tag: design.source_system_tag,
        left_grouping_tag: design.left_grouping_tag,
        right_grouping_tag: design.right_grouping_tag,
        target_feature_tag: design.target_feature_tag,
        carrier_tag: pr_require_nonzero(carrier_tag),
        associator_tag: pr_require_nonzero(associator_tag),
    }
}

// A contest holds the candidate classes and evidence identifier explicit. It
// carries no conclusion about model adequacy or general superiority.
pub fn pr_associativity_contest_i64(
    design: BracketingDesignI64,
    bag_model_tag: i64,
    ordered_model_tag: i64,
    bracket_model_tag: i64,
    evidence_tag: i64
) -> AssociativityContestI64 with Panic {
    AssociativityContestI64 {
        boundary_tag: design.boundary_tag,
        source_system_tag: design.source_system_tag,
        left_grouping_tag: design.left_grouping_tag,
        right_grouping_tag: design.right_grouping_tag,
        target_feature_tag: design.target_feature_tag,
        bag_model_tag: pr_require_nonzero(bag_model_tag),
        ordered_model_tag: pr_require_nonzero(ordered_model_tag),
        bracket_model_tag: pr_require_nonzero(bracket_model_tag),
        evidence_tag: pr_require_nonzero(evidence_tag),
    }
}

// This is a declared synthetic collision: it only records that two supplied
// feature tags differ under the same contest. It is not an empirical result.
pub fn pr_bracket_discriminating_feature_i64(
    comparison: AssociativityContestI64,
    ordered_feature_tag: i64,
    bracket_feature_tag: i64
) -> BracketDiscriminatingFeatureI64 with Panic {
    let ordered = pr_require_nonzero(ordered_feature_tag)
    let bracket = pr_require_nonzero(bracket_feature_tag)
    assert(ordered != bracket)
    BracketDiscriminatingFeatureI64 {
        boundary_tag: comparison.boundary_tag,
        source_system_tag: comparison.source_system_tag,
        left_grouping_tag: comparison.left_grouping_tag,
        right_grouping_tag: comparison.right_grouping_tag,
        target_feature_tag: comparison.target_feature_tag,
        evidence_tag: comparison.evidence_tag,
        ordered_feature_tag: ordered,
        bracket_feature_tag: bracket,
    }
}

// Sensitivity is constructible only from a contest plus a discriminating
// feature receipt. It deliberately cannot be constructed from an associator
// probe or an ordered path alone.
pub fn pr_parenthesization_sensitivity_i64(
    comparison: AssociativityContestI64,
    feature: BracketDiscriminatingFeatureI64
) -> ParenthesizationSensitivityI64 with Panic {
    assert(feature.boundary_tag == comparison.boundary_tag)
    assert(feature.source_system_tag == comparison.source_system_tag)
    assert(feature.left_grouping_tag == comparison.left_grouping_tag)
    assert(feature.right_grouping_tag == comparison.right_grouping_tag)
    assert(feature.target_feature_tag == comparison.target_feature_tag)
    assert(feature.evidence_tag == comparison.evidence_tag)
    ParenthesizationSensitivityI64 {
        boundary_tag: feature.boundary_tag,
        source_system_tag: feature.source_system_tag,
        left_grouping_tag: feature.left_grouping_tag,
        right_grouping_tag: feature.right_grouping_tag,
        target_feature_tag: feature.target_feature_tag,
        evidence_tag: feature.evidence_tag,
        discriminating_feature_tag: feature.bracket_feature_tag,
    }
}

// When a contest cannot support a discriminating feature, callers can retain
// a separate abstention receipt rather than repurposing an ordered path.
pub fn pr_parenthesization_abstention_i64(
    comparison: AssociativityContestI64,
    reason_tag: i64
) -> ParenthesizationAbstentionI64 with Panic {
    ParenthesizationAbstentionI64 {
        boundary_tag: comparison.boundary_tag,
        source_system_tag: comparison.source_system_tag,
        left_grouping_tag: comparison.left_grouping_tag,
        right_grouping_tag: comparison.right_grouping_tag,
        target_feature_tag: comparison.target_feature_tag,
        evidence_tag: comparison.evidence_tag,
        reason_tag: pr_require_nonzero(reason_tag),
    }
}

pub fn pr_ordered_path_history_tag_i64(receipt: OrderedTransformationPathI64) -> i64 {
    receipt.history_tag
}

pub fn pr_ordered_path_source_system_tag_i64(receipt: OrderedTransformationPathI64) -> i64 {
    receipt.source_system_tag
}

pub fn pr_ordered_path_tag_i64(receipt: OrderedTransformationPathI64) -> i64 {
    receipt.path_tag
}

pub fn pr_aggregation_boundary_tag_i64(receipt: AggregationBoundaryI64) -> i64 {
    receipt.boundary_tag
}

pub fn pr_aggregation_boundary_kind_tag_i64(receipt: AggregationBoundaryI64) -> i64 {
    receipt.boundary_kind_tag
}

pub fn pr_aggregation_boundary_source_system_tag_i64(receipt: AggregationBoundaryI64) -> i64 {
    receipt.source_system_tag
}

pub fn pr_bracketing_design_target_feature_tag_i64(receipt: BracketingDesignI64) -> i64 {
    receipt.target_feature_tag
}

pub fn pr_bracketing_design_left_grouping_tag_i64(receipt: BracketingDesignI64) -> i64 {
    receipt.left_grouping_tag
}

pub fn pr_bracketing_design_right_grouping_tag_i64(receipt: BracketingDesignI64) -> i64 {
    receipt.right_grouping_tag
}

pub fn pr_algebraic_associator_probe_tag_i64(receipt: AlgebraicAssociatorProbeI64) -> i64 {
    receipt.associator_tag
}

pub fn pr_algebraic_associator_probe_source_system_tag_i64(receipt: AlgebraicAssociatorProbeI64) -> i64 {
    receipt.source_system_tag
}

pub fn pr_associativity_contest_evidence_tag_i64(receipt: AssociativityContestI64) -> i64 {
    receipt.evidence_tag
}

pub fn pr_associativity_contest_source_system_tag_i64(receipt: AssociativityContestI64) -> i64 {
    receipt.source_system_tag
}

pub fn pr_bracket_discriminating_ordered_feature_tag_i64(receipt: BracketDiscriminatingFeatureI64) -> i64 {
    receipt.ordered_feature_tag
}

pub fn pr_bracket_discriminating_feature_tag_i64(receipt: BracketDiscriminatingFeatureI64) -> i64 {
    receipt.bracket_feature_tag
}

pub fn pr_bracket_discriminating_feature_source_system_tag_i64(receipt: BracketDiscriminatingFeatureI64) -> i64 {
    receipt.source_system_tag
}

pub fn pr_parenthesization_sensitivity_feature_tag_i64(receipt: ParenthesizationSensitivityI64) -> i64 {
    receipt.discriminating_feature_tag
}

pub fn pr_parenthesization_sensitivity_source_system_tag_i64(receipt: ParenthesizationSensitivityI64) -> i64 {
    receipt.source_system_tag
}

pub fn pr_parenthesization_abstention_reason_tag_i64(receipt: ParenthesizationAbstentionI64) -> i64 {
    receipt.reason_tag
}

pub fn pr_parenthesization_abstention_source_system_tag_i64(receipt: ParenthesizationAbstentionI64) -> i64 {
    receipt.source_system_tag
}
