pub fn certify_d9_adequate_coverage(
    receipt_id: i64,
    coverage: D9WholeSetFiniteCoverageAReceipt,
) -> D9AdequateCoverageReceipt with Panic {
    assert(receipt_id == 20301)
    assert(coverage.coverage_id == 20201 && coverage.design_id == 20101)
    assert(coverage.numerator == 10 && coverage.denominator == 12)
    assert(coverage.permille_floor == 833 && coverage.permille_remainder == 4)
    assert(coverage.numerator * 1000 ==
        coverage.permille_floor * coverage.denominator +
        coverage.permille_remainder)
    let left = coverage.numerator * 4
    let right = 3 * coverage.denominator
    assert(left == 40 && right == 36 && left >= right)
    D9AdequateCoverageReceipt {
        receipt_id: receipt_id,
        source_coverage_id: coverage.coverage_id,
        numerator: coverage.numerator,
        denominator: coverage.denominator,
        threshold_numerator: 3,
        threshold_denominator: 4,
        left_cross_product: left,
        right_cross_product: right,
        exact_cross_product_comparison: true,
        adequate: true,
    }
}

pub fn refuse_d9_insufficient_coverage(
    receipt_id: i64,
    coverage: D9WholeSetFiniteCoverageBReceipt,
) -> D9InsufficientCoverageReceipt with Panic {
    assert(receipt_id == 20302)
    assert(coverage.coverage_id == 20202 && coverage.design_id == 20102)
    assert(coverage.numerator == 2 && coverage.denominator == 12)
    assert(coverage.permille_floor == 166 && coverage.permille_remainder == 8)
    assert(coverage.numerator * 1000 ==
        coverage.permille_floor * coverage.denominator +
        coverage.permille_remainder)
    let left = coverage.numerator * 4
    let right = 3 * coverage.denominator
    assert(left == 8 && right == 36 && left < right)
    D9InsufficientCoverageReceipt {
        receipt_id: receipt_id,
        source_coverage_id: coverage.coverage_id,
        numerator: coverage.numerator,
        denominator: coverage.denominator,
        threshold_numerator: 3,
        threshold_denominator: 4,
        left_cross_product: left,
        right_cross_product: right,
        exact_cross_product_comparison: true,
        adequate_coverage_issued: false,
    }
}

