pub fn abstain_from_d9_external_empirical_binding(
    abstention_id: i64,
    evaluation: D9ExternalEvaluationReceipt,
) -> D9ExternalBindingAbstentionReceipt with Panic {
    assert(abstention_id == 21002)
    assert(evaluation.receipt_id == 21001 && evaluation.dataset_id == 373)
    assert(evaluation.row_count == 1885 && evaluation.eligible_row_count == 1877)
    assert(evaluation.calibration_covered_count == 286)
    assert(evaluation.evaluation_covered_count == 265)
    assert(evaluation.calibration_adequate && !evaluation.evaluation_adequate)
    assert(evaluation.score_band_support_compatible)
    assert(!evaluation.metrological_calibration_available)
    assert(!evaluation.collection_window_verified)
    assert(!evaluation.external_custody_sealed)
    assert(!evaluation.sealed_validation_available)
    D9ExternalBindingAbstentionReceipt {
        abstention_id: abstention_id,
        external_evaluation_id: evaluation.receipt_id,
        preserved_prediction_set_mask: 3,
        reason_mask: 230,
        model_criticism_recorded: true,
        empirical_binding_issued: false,
        patient_state_issued: false,
        clinical_authority_issued: false,
    }
}

pub fn record_d9_causal_action_ambiguity(
    receipt_id: i64,
    predictive: D9PredictiveSetReceipt,
) -> D9CausalActionAmbiguityReceipt with Panic {
    assert(receipt_id == 21101)
    assert(predictive.set_id == 20403 && predictive.response_mask == 3)
    assert(!predictive.individual_conditional_coverage)
    D9CausalActionAmbiguityReceipt {
        receipt_id: receipt_id,
        predictive_artifact_id: predictive.set_id,
        observed_distribution_fingerprint_a: 424242,
        observed_distribution_fingerprint_b: 424242,
        treatment_effect_sign_a: 1,
        treatment_effect_sign_b: -1,
        observationally_indistinguishable: true,
        action_direction_identified: false,
        clinical_authority_issued: false,
    }
}

pub fn summarize_d9_statistical_coverage(
    summary_id: i64,
    declared: D9DeclaredContextBindingReceipt,
    external_abstention: D9ExternalBindingAbstentionReceipt,
) -> D9StatisticalCoverageSummaryReceipt with Panic {
    assert(summary_id == 21201)
    assert(declared.binding_id == 20901)
    assert(declared.all_declared_fixture_obligations_met)
    assert(!declared.external_empirical_binding)
    assert(external_abstention.abstention_id == 21002)
    assert(!external_abstention.empirical_binding_issued)
    D9StatisticalCoverageSummaryReceipt {
        summary_id: summary_id,
        synthetic_design_count: 455,
        positive_design_count: 165,
        positivity_failure_count: 290,
        adequate_design_count: 25,
        declared_context_binding_count: 1,
        external_evaluation_count: 1,
        empirical_binding_count: 0,
        patient_state_count: 0,
        clinical_action_authority_count: 0,
        compiler_rewrite_count: 0,
        ontology_transport_count: 0,
        exact_only_for_frozen_fixture: true,
    }
}
