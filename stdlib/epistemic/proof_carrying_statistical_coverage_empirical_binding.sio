    assert(a.table_fingerprint == b.table_fingerprint)
    assert(a.realized_region_mask == 3 && b.realized_region_mask == 3)
    assert(a.dataset_id != b.dataset_id)
    assert(a.instrument_version_id != b.instrument_version_id)
    assert(a.target_population_version_id != b.target_population_version_id)
    assert(a.collection_window_id != b.collection_window_id)
    D9ProvenanceMismatchReceipt {
        receipt_id: receipt_id,
        provenance_a_id: a.provenance_id,
        provenance_b_id: b.provenance_id,
        shared_table_fingerprint: a.table_fingerprint,
        shared_region_mask: a.realized_region_mask,
        distinct_dataset_ids: true,
        distinct_instrument_versions: true,
        distinct_population_versions: true,
        distinct_windows: true,
        lineages_substitutable: false,
    }
}

