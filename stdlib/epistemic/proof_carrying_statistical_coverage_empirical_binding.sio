    assert(provenance.target_population_version_id == population.population_version_id)
    assert(provenance.collection_window_id == window.collection_window_id)
    D9MatchedProvenanceReceipt {
        receipt_id: receipt_id,
        provenance_id: provenance.provenance_id,
        region_id: region.region_id,
        design_id: region.design_id,
        population_version_id: population.population_version_id,
        collection_window_id: window.collection_window_id,
        explicit_identity_match: true,
        external_custody_sealed: false,
    }
}

pub fn bind_d9_declared_fixture_context(
    binding_id: i64,
    region: D9ConfidenceRegionReceipt,
    adequate: D9AdequateCoverageReceipt,
    population: D9TargetPopulationReceipt,
    window: D9TargetTimeWindowReceipt,
    positivity: D9SamplingPositivityReceipt,
    coverage_calibration: D9FiniteCoverageCalibrationReceipt,
    instrument_calibration: D9InstrumentCalibrationReceipt,
    compatibility: D9InstrumentPopulationCompatibilityReceipt,
    provenance: D9MatchedProvenanceReceipt,
) -> D9DeclaredContextBindingReceipt with Panic {
    assert(binding_id == 20901)
    validate_d9_region_a(region)
    assert(adequate.receipt_id == 20301 && adequate.adequate)
    assert(population.population_id == 20701 && population.finite_fixture_population)
    assert(window.window_id == 20702 && window.nonempty_declared_intersection)
    assert(positivity.receipt_id == 20801 && positivity.sampling_support_positive)
    assert(coverage_calibration.receipt_id == 20811)
    assert(coverage_calibration.finite_fixture_calibrated)
    assert(instrument_calibration.receipt_id == 20821)
    assert(instrument_calibration.metrological_calibration_current)
    assert(compatibility.receipt_id == 20831 && compatibility.compatible)
    assert(provenance.receipt_id == 20841 && provenance.explicit_identity_match)
    D9DeclaredContextBindingReceipt {
        binding_id: binding_id,
        region_id: region.region_id,
        adequate_coverage_id: adequate.receipt_id,
        population_id: population.population_id,
        window_id: window.window_id,
        positivity_id: positivity.receipt_id,
        coverage_calibration_id: coverage_calibration.receipt_id,
        instrument_calibration_id: instrument_calibration.receipt_id,
        instrument_population_compatibility_id: compatibility.receipt_id,
        matched_provenance_id: provenance.receipt_id,
        all_declared_fixture_obligations_met: true,
        external_empirical_binding: false,
        patient_state: false,
        clinical_action_authority: false,
    }
}

