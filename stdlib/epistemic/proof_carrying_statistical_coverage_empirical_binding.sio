// Reserved authority categories. The structs themselves are module-private,
// public consumers expose their nominal walls, and bounded D9 has no positive
// constructor for any of them.
struct D9ExternalDataCustodyReceipt { receipt_id: i64 }
struct D9SealedValidationReceipt { receipt_id: i64 }
enum D9ReceiptSeal {}
pub struct D9EmpiricalBindingReceipt { receipt_id: D9ReceiptSeal }
pub struct D9PatientStateReceipt { receipt_id: D9ReceiptSeal }
pub struct D9ClinicalActionAuthorityReceipt { receipt_id: D9ReceiptSeal }
struct D9NegativePredictionReceipt { receipt_id: i64 }
struct D9ClinicalEscalationReceipt { receipt_id: i64 }
struct D9IntegrityReceipt { receipt_id: i64 }
struct D9AuthenticityReceipt { receipt_id: i64 }
struct D9MeasurementValidityReceipt { receipt_id: i64 }
struct D9CausalTreatmentEffectReceipt { receipt_id: i64 }

pub fn d9_accept_external_data_custody(
    receipt: D9ExternalDataCustodyReceipt,
) -> i64 { receipt.receipt_id }

