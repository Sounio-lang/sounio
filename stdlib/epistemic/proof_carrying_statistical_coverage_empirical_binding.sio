pub fn d9_accept_causal_treatment_effect(
    receipt: D9CausalTreatmentEffectReceipt,
) -> i64 { receipt.receipt_id }

fn validate_d9_target(target: D9CoverageTargetReceipt) with Panic {
    assert(target.target_id == 20001)
    assert(target.d8_set_id == 12301 && target.d8_model_id == 12200)
    assert(target.d8_assumption_set_id == 12210)
    assert(target.member_mask == 3 && target.member_count == 2)
    assert(target.exact_within_frozen_d8_family)
    assert(!target.confidence_region && !target.predictive_set)
    assert(!target.patient_state)
}

fn validate_d9_procedure(procedure: D9FrozenSetProcedureReceipt) with Panic {
    assert(procedure.procedure_id == 20002 && procedure.target_id == 20001)
    assert(procedure.outcome_count == 4)
    assert(procedure.outcome_0_region_mask == 3)
    assert(procedure.outcome_1_region_mask == 1)
    assert(procedure.outcome_2_region_mask == 2)
    assert(procedure.outcome_3_region_mask == 7)
    assert(procedure.common_mass_denominator == 12)
    assert(procedure.whole_set_coverage_target)
    assert(!procedure.memberwise_coverage_target)
    assert(!procedure.predictive_target)
    assert(procedure.frozen_synthetic_procedure)
}

fn validate_d9_design_a(design: D9SamplingDesignAReceipt) with Panic {
    assert(design.design_id == 20101 && design.procedure_id == 20002)
    assert(design.target_id == 20001)
    assert(design.weight_0 == 5 && design.weight_1 == 1)
    assert(design.weight_2 == 1 && design.weight_3 == 5)
    assert(design.total_mass == 12 && design.positive_outcome_count == 4)
    assert(design.sampling_positivity_in_fixture)
    assert(!design.real_sampling_law)
}

fn validate_d9_design_b(design: D9SamplingDesignBReceipt) with Panic {
    assert(design.design_id == 20102 && design.procedure_id == 20002)
    assert(design.target_id == 20001)
    assert(design.weight_0 == 1 && design.weight_1 == 5)
    assert(design.weight_2 == 5 && design.weight_3 == 1)
    assert(design.total_mass == 12 && design.positive_outcome_count == 4)
    assert(design.sampling_positivity_in_fixture)
    assert(!design.real_sampling_law)
}

fn validate_d9_region_a(region: D9ConfidenceRegionReceipt) with Panic {
    assert(region.region_id == 20401 && region.procedure_id == 20002)
    assert(region.design_id == 20101 && region.coverage_id == 20201)
    assert(region.sample_outcome_id == 0 && region.member_mask == 3)
    assert(region.lower_state_code == 1 && region.upper_state_code == 2)
    assert(region.coverage_attaches_to_procedure)
    assert(!region.per_realization_truth_probability)
    assert(!region.exact_identified_set && !region.predictive_set)
}

pub fn d9_accept_confidence_region(
    region: D9ConfidenceRegionReceipt,
) -> i64 { region.region_id }

pub fn bind_d8_exact_set_as_d9_coverage_target(
    target_id: i64,
    set: ExactABIdentifiedSetReceipt,
) -> D9CoverageTargetReceipt with Panic {
    assert(target_id == 20001)
    assert(set.set_id == 12301 && set.model_id == 12200)
    assert(set.model_version == 1 && set.assumption_set_id == 12210)
    assert(set.history_id == 12101 && set.path_code == 1)
    assert(set.member_mask == 3 && set.member_count == 2)
    assert(set.scalar_projection == 877 && set.set_audit_checksum == 25710287)
    assert(set.exact_within_frozen_family && set.sound_outer)
    assert(set.witnessed_inner && !set.heuristic)
    assert(!set.point_identified && !set.confidence_region && !set.predictive_set)
    let target = D9CoverageTargetReceipt {
        target_id: target_id,
        d8_set_id: set.set_id,
        d8_model_id: set.model_id,
        d8_assumption_set_id: set.assumption_set_id,
        member_mask: set.member_mask,
        member_count: set.member_count,
        exact_within_frozen_d8_family: true,
        confidence_region: false,
        predictive_set: false,
        patient_state: false,
    }
    validate_d9_target(target)
    target
}

pub fn declare_d9_frozen_set_procedure(
    procedure_id: i64,
    target: D9CoverageTargetReceipt,
) -> D9FrozenSetProcedureReceipt with Panic {
    assert(procedure_id == 20002)
    validate_d9_target(target)
    let procedure = D9FrozenSetProcedureReceipt {
        procedure_id: procedure_id,
        target_id: target.target_id,
        outcome_count: 4,
        outcome_0_region_mask: 3,
        outcome_1_region_mask: 1,
        outcome_2_region_mask: 2,
        outcome_3_region_mask: 7,
        common_mass_denominator: 12,
        whole_set_coverage_target: true,
        memberwise_coverage_target: false,
        predictive_target: false,
        frozen_synthetic_procedure: true,
    }
    validate_d9_procedure(procedure)
    procedure
}

pub fn declare_d9_sampling_design_a(
    design_id: i64,
    procedure: D9FrozenSetProcedureReceipt,
) -> D9SamplingDesignAReceipt with Panic {
    assert(design_id == 20101)
    validate_d9_procedure(procedure)
    let design = D9SamplingDesignAReceipt {
        design_id: design_id,
        procedure_id: procedure.procedure_id,
        target_id: procedure.target_id,
        weight_0: 5,
        weight_1: 1,
        weight_2: 1,
        weight_3: 5,
        total_mass: 12,
        positive_outcome_count: 4,
        sampling_positivity_in_fixture: true,
        real_sampling_law: false,
    }
    validate_d9_design_a(design)
    design
}

pub fn declare_d9_sampling_design_b(
    design_id: i64,
    procedure: D9FrozenSetProcedureReceipt,
) -> D9SamplingDesignBReceipt with Panic {
    assert(design_id == 20102)
    validate_d9_procedure(procedure)
    let design = D9SamplingDesignBReceipt {
        design_id: design_id,
        procedure_id: procedure.procedure_id,
        target_id: procedure.target_id,
        weight_0: 1,
        weight_1: 5,
        weight_2: 5,
        weight_3: 1,
        total_mass: 12,
        positive_outcome_count: 4,
        sampling_positivity_in_fixture: true,
        real_sampling_law: false,
    }
    validate_d9_design_b(design)
    design
}

pub fn enumerate_d9_whole_set_coverage_a(
    coverage_id: i64,
    target: D9CoverageTargetReceipt,
    procedure: D9FrozenSetProcedureReceipt,
    design: D9SamplingDesignAReceipt,
) -> D9WholeSetFiniteCoverageAReceipt with Panic {
    assert(coverage_id == 20201)
    validate_d9_target(target)
    validate_d9_procedure(procedure)
    validate_d9_design_a(design)
    assert(target.target_id == procedure.target_id)
    assert(design.procedure_id == procedure.procedure_id)
    D9WholeSetFiniteCoverageAReceipt {
        coverage_id: coverage_id,
        design_id: design.design_id,
        procedure_id: procedure.procedure_id,
        target_id: target.target_id,
        numerator: 10,
        denominator: 12,
        permille_floor: 833,
        permille_remainder: 4,
        simultaneous_whole_set_coverage: true,
        memberwise_only: false,
        exact_for_frozen_mass_function: true,
        external_coverage_theorem: false,
    }
}

