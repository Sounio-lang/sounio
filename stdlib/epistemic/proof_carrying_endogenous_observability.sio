pub fn derive_response_opportunity(
    opportunity_id: i64,
    delivery: DeliveryEventReceipt,
) -> ResponseOpportunityReceipt with Panic {
    validate_delivery(delivery)
    let opportunity = ResponseOpportunityReceipt {
        opportunity_id: opportunity_id,
        delivery_id: delivery.delivery_id,
        protocol_id: delivery.protocol_id,
        mode: delivery.mode,
        delivered: delivery.delivered,
        response_opportunity_existed: delivery.delivered,
        response_observed: false,
