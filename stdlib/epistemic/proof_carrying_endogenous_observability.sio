// Deliberately unrelated claim and authority types used by negative gates.
pub struct EmpiricalMissingnessTaxonomyReceipt { pub receipt_id: i64 }
pub struct BiologicalResponseMechanismReceipt { pub mechanism_id: i64 }
pub struct GlobalRecoverabilityReceipt { pub receipt_id: i64 }
pub struct ClinicalObservationActionReceipt { pub action_id: i64 }
pub struct RealPersonRandomizationReceipt { pub randomization_id: i64 }
pub struct SubjectiveSufferingReceipt { pub suffering_id: i64 }

fn as_i64(value: bool) -> i64 { if value { 1 } else { 0 } }

fn count_four_mask(mask: i64) -> i64 with Panic {
    assert(mask >= 0 && mask <= 15)
    as_i64(mask % 2 == 1) + as_i64((mask / 2) % 2 == 1) +
        as_i64((mask / 4) % 2 == 1) + as_i64((mask / 8) % 2 == 1)
}

fn hidden_target_for_mode(mode: i64) -> i64 with Panic {
    assert(mode >= 0 && mode <= 3)
    if mode <= 1 { 2 } else { 8 }
}

fn predicted_scheduled(mode: i64) -> bool with Panic {
    assert(mode >= 0 && mode <= 3)
    mode != 3
}

fn predicted_delivered(mode: i64) -> bool with Panic {
    assert(mode >= 0 && mode <= 3)
    mode == 1 || mode == 2
}

fn predicted_response_opportunity(mode: i64) -> bool with Panic {
    assert(mode >= 0 && mode <= 3)
    predicted_delivered(mode)
}

fn predicted_retry_response(mode: i64) -> bool with Panic {
    assert(mode >= 0 && mode <= 3)
    mode == 1
}

fn predicted_retry_value_present(mode: i64) -> bool with Panic {
    assert(mode >= 0 && mode <= 3)
    predicted_retry_response(mode)
}

fn predicted_retry_observed_value(mode: i64) -> i64 with Panic {
    assert(mode >= 0 && mode <= 3)
    if predicted_retry_response(mode) { 2 } else { -1 }
}

fn family_hypothesis_id(
    family: EndogenousObservationFamilyReceipt,
    mode: i64,
) -> i64 with Panic {
    validate_family(family)
    assert(mode >= 0 && mode <= 3)
    if mode == 0 {
        family.delivery_failure_hypothesis_id
    } else if mode == 1 {
        family.target_independent_hypothesis_id
    } else if mode == 2 {
        family.target_dependent_hypothesis_id
    } else {
        family.policy_withholding_hypothesis_id
    }
}

fn family_mode_for_hypothesis(
    family: EndogenousObservationFamilyReceipt,
    hypothesis_id: i64,
) -> i64 with Panic {
    validate_family(family)
    assert(hypothesis_id > 0 && hypothesis_id <= 1000000)
    if hypothesis_id == family.delivery_failure_hypothesis_id {
        0
    } else if hypothesis_id == family.target_independent_hypothesis_id {
        1
    } else if hypothesis_id == family.target_dependent_hypothesis_id {
        2
    } else {
        assert(hypothesis_id == family.policy_withholding_hypothesis_id)
        3
    }
}

fn custody_prediction_signature(mode: i64) -> i64 with Panic {
    assert(mode >= 0 && mode <= 3)
    100 * as_i64(predicted_scheduled(mode)) +
        10 * as_i64(predicted_delivered(mode)) +
        as_i64(predicted_response_opportunity(mode))
}

fn retry_prediction_signature(mode: i64) -> i64 with Panic {
    assert(mode >= 0 && mode <= 3)
    let encoded_value = if predicted_retry_observed_value(mode) > 0 {
        predicted_retry_observed_value(mode)
    } else {
        0
    }
    100 * as_i64(predicted_retry_response(mode)) +
        10 * as_i64(predicted_retry_value_present(mode)) + encoded_value
}

fn validate_hypothesis(h: DeclaredObservationHypothesisReceipt) with Panic {
    assert(h.hypothesis_id > 0 && h.hypothesis_id <= 1000000)
    assert(h.declared_family_id > 0)
    assert(h.mode >= 0 && h.mode <= 3)
    assert(h.hidden_target_value == hidden_target_for_mode(h.mode))
    assert(h.delivery_failure_mode == (h.mode == 0))
    assert(h.declared_target_independent_nonresponse_mode == (h.mode == 1))
    assert(h.declared_target_dependent_suppression_mode == (h.mode == 2))
    assert(h.policy_withholding_mode == (h.mode == 3))
    assert(!h.empirical_missingness_taxonomy_established)
    assert(!h.biological_mechanism_established)
    assert(!h.clinical_authority)
}

fn validate_family(f: EndogenousObservationFamilyReceipt) with Panic {
    assert(f.family_id > 0 && f.protocol_id > 0)
    assert(f.delivery_failure_hypothesis_id > 0)
    assert(f.target_independent_hypothesis_id > 0)
    assert(f.target_dependent_hypothesis_id > 0)
    assert(f.policy_withholding_hypothesis_id > 0)
    assert(f.delivery_failure_hypothesis_id <= 1000000)
    assert(f.target_independent_hypothesis_id <= 1000000)
    assert(f.target_dependent_hypothesis_id <= 1000000)
    assert(f.policy_withholding_hypothesis_id <= 1000000)
    assert(f.delivery_failure_hypothesis_id != f.target_independent_hypothesis_id)
    assert(f.delivery_failure_hypothesis_id != f.target_dependent_hypothesis_id)
    assert(f.delivery_failure_hypothesis_id != f.policy_withholding_hypothesis_id)
    assert(f.target_independent_hypothesis_id != f.target_dependent_hypothesis_id)
    assert(f.target_independent_hypothesis_id != f.policy_withholding_hypothesis_id)
    assert(f.target_dependent_hypothesis_id != f.policy_withholding_hypothesis_id)
    assert(f.hypothesis_count == 4)
    assert(!f.family_exhaustive_in_reality)
    assert(f.synthetic_scope_only)
}

fn validate_intent(intent: MeasurementIntentReceipt) with Panic {
    assert(intent.intent_id > 0 && intent.protocol_id > 0)
    assert(intent.prompt_tick == 2)
    assert(intent.response_window_ticks == 0)
    assert(intent.candidate_considered)
    assert(!intent.consent_authority)
    assert(!intent.clinical_authority)
}

fn validate_policy(policy: ObservationPolicyDecisionReceipt) with Panic {
    assert(policy.decision_id > 0 && policy.intent_id > 0 && policy.protocol_id > 0)
    assert(policy.mode >= 0 && policy.mode <= 3)
    assert(policy.candidate_considered)
    assert(policy.scheduled == predicted_scheduled(policy.mode))
    assert(policy.policy_retained_in_provenance)
    assert(!policy.participant_response_claimed)
    assert(!policy.clinical_authority)
}

fn validate_delivery(delivery: DeliveryEventReceipt) with Panic {
    assert(delivery.delivery_id > 0 && delivery.decision_id > 0)
    assert(delivery.protocol_id > 0)
    assert(delivery.mode >= 0 && delivery.mode <= 3)
    assert(delivery.scheduled == predicted_scheduled(delivery.mode))
    assert(delivery.delivered == predicted_delivered(delivery.mode))
    assert(!delivery.participant_nonresponse_claimed)
    assert(!delivery.physical_delivery_established)
}

fn validate_opportunity(opportunity: ResponseOpportunityReceipt) with Panic {
    assert(opportunity.opportunity_id > 0 && opportunity.delivery_id > 0)
    assert(opportunity.protocol_id > 0)
    assert(opportunity.mode >= 0 && opportunity.mode <= 3)
    assert(opportunity.delivered == predicted_delivered(opportunity.mode))
    assert(opportunity.response_opportunity_existed == opportunity.delivered)
    assert(!opportunity.response_observed)
}

fn validate_provenance(p: ObservationEvidenceProvenanceReceipt) with Panic {
    assert(p.provenance_id > 0 && p.provenance_id <= 1000000)
    assert(p.source_id > 0 && p.protocol_id > 0)
    assert(p.tick >= 0 && p.tick <= 100)
    assert(p.previous_provenance_id >= 0 && p.previous_provenance_id <= 1000000)
    assert(p.policy_decision_id > 0)
    assert(p.chain_complete)
    assert(p.policy_retained)
}

fn trace_matches_mode(
    mode: i64,
    trace: AdmissibleObservationCustodyTraceReceipt,
) -> bool with Panic {
    custody_values_match_mode(
        mode,
        trace.candidate_considered,
        trace.scheduled,
        trace.delivered,
        trace.response_opportunity_existed,
        trace.responded_within_window,
        trace.delayed_at_window_close,
        trace.value_present,
        trace.observed_value,
    )
}

fn custody_values_match_mode(
    mode: i64,
    candidate_considered: bool,
    scheduled: bool,
    delivered: bool,
    response_opportunity_existed: bool,
    responded_within_window: bool,
    delayed_at_window_close: bool,
    value_present: bool,
    observed_value: i64,
) -> bool with Panic {
    assert(mode >= 0 && mode <= 3)
    candidate_considered &&
        scheduled == predicted_scheduled(mode) &&
        delivered == predicted_delivered(mode) &&
        response_opportunity_existed == predicted_response_opportunity(mode) &&
        !responded_within_window &&
        !delayed_at_window_close &&
        !value_present &&
        observed_value == -1
}

fn trace_prediction_mask(trace: AdmissibleObservationCustodyTraceReceipt) -> i64 with Panic {
    as_i64(trace_matches_mode(0, trace)) +
        2 * as_i64(trace_matches_mode(1, trace)) +
        4 * as_i64(trace_matches_mode(2, trace)) +
        8 * as_i64(trace_matches_mode(3, trace))
}

fn custody_values_prediction_mask(
    candidate_considered: bool,
    scheduled: bool,
    delivered: bool,
    response_opportunity_existed: bool,
    responded_within_window: bool,
    delayed_at_window_close: bool,
    value_present: bool,
    observed_value: i64,
) -> i64 with Panic {
    as_i64(custody_values_match_mode(
        0, candidate_considered, scheduled, delivered,
        response_opportunity_existed, responded_within_window,
        delayed_at_window_close, value_present, observed_value,
    )) + 2 * as_i64(custody_values_match_mode(
        1, candidate_considered, scheduled, delivered,
        response_opportunity_existed, responded_within_window,
        delayed_at_window_close, value_present, observed_value,
    )) + 4 * as_i64(custody_values_match_mode(
        2, candidate_considered, scheduled, delivered,
        response_opportunity_existed, responded_within_window,
        delayed_at_window_close, value_present, observed_value,
    )) + 8 * as_i64(custody_values_match_mode(
        3, candidate_considered, scheduled, delivered,
        response_opportunity_existed, responded_within_window,
        delayed_at_window_close, value_present, observed_value,
    ))
}

fn validate_custody_trace(trace: AdmissibleObservationCustodyTraceReceipt) with Panic {
    assert(trace.trace_id > 0 && trace.family_id > 0 && trace.protocol_id > 0)
    assert(trace.intent_id > 0 && trace.policy_decision_id > 0)
    assert(trace.delivery_id > 0 && trace.opportunity_id > 0)
    assert(trace.candidate_considered)
    assert(!trace.responded_within_window)
    assert(!trace.delayed_at_window_close)
    assert(!trace.value_present)
    assert(trace.observed_value == -1)
    assert(trace.provenance_id > 0 && trace.provenance_id <= 1000000)
    assert(trace.previous_provenance_id >= 0 && trace.previous_provenance_id <= 1000000)
    assert(trace.declared_burden_units == 5)
    assert(trace.policy_retained_in_provenance)
    assert(!trace.physical_observation_claimed)
    assert(trace_prediction_mask(trace) > 0)
}

fn validate_legacy_missing_token(token: LegacyCoarsenedMissingTokenReceipt) with Panic {
    assert(token.token_id > 0)
    assert(token.family_id > 0 && token.protocol_id > 0)
    assert(token.legacy_missing_code == -1)
    assert(!token.value_present)
    assert(token.custody_erased)
    assert(token.hypotheses_eliminated == 0)
}

fn validate_contest_state(state: EndogenousObservabilityContestStateReceipt) with Panic {
    assert(state.state_id > 0 && state.family_id > 0 && state.protocol_id > 0)
    assert(state.survivor_mask >= 0 && state.survivor_mask <= 15)
    assert(state.survivor_count == count_four_mask(state.survivor_mask))
    assert(state.evidence_count >= 0 && state.evidence_count <= 2)
    assert(state.burden_spent >= 0 && state.burden_spent <= 9)
    assert(state.last_provenance_id >= 0 && state.last_provenance_id <= 1000000)
    assert(state.provenance_fingerprint >= 0 && state.provenance_fingerprint <= 32000000)
    assert(state.family_refuted == (state.survivor_count == 0))
    if state.evidence_count == 0 {
        assert(state.survivor_mask == 15)
        assert(state.survivor_count == 4)
        assert(state.burden_spent == 0)
        assert(state.last_provenance_id == 0)
        assert(state.provenance_fingerprint == 0)
    } else if state.evidence_count == 1 {
        assert(state.burden_spent == 5)
        assert(state.provenance_fingerprint == state.last_provenance_id)
    } else {
        assert(state.burden_spent == 9)
        assert(state.provenance_fingerprint >= 32)
        assert(state.provenance_fingerprint > state.last_provenance_id)
    }
}

fn validate_transition(t: EndogenousObservabilityContestTransitionReceipt) with Panic {
    assert(t.transition_id > 0)
    assert(t.evidence_kind == 1 || t.evidence_kind == 2)
    assert(t.family_id == t.result_state.family_id)
    assert(t.protocol_id == t.result_state.protocol_id)
    assert(t.source_state_id > 0)
    assert(t.source_state_id != t.result_state.state_id)
    assert(t.source_survivor_mask >= 0 && t.source_survivor_mask <= 15)
    assert(t.source_survivor_count == count_four_mask(t.source_survivor_mask))
    assert(t.source_evidence_count >= 0 && t.source_evidence_count <= 1)
    assert(t.source_burden_spent >= 0 && t.source_burden_spent <= 5)
    assert(t.source_last_provenance_id >= 0 && t.source_last_provenance_id <= 1000000)
    assert(t.source_provenance_fingerprint >= 0)
    assert(t.source_provenance_fingerprint <= 1000000)
    assert(t.result_survivor_mask == t.result_state.survivor_mask)
    assert(t.result_survivor_count == t.result_state.survivor_count)
    assert(t.provenance_id > 0 && t.provenance_id <= 1000000)
    assert(t.previous_provenance_id == t.source_last_provenance_id)
    assert(t.result_state.last_provenance_id == t.provenance_id)
    assert(t.result_state.evidence_count == t.source_evidence_count + 1)
    assert(t.result_state.burden_spent == t.source_burden_spent + t.declared_burden_units)
    assert(t.result_state.provenance_fingerprint ==
        t.source_provenance_fingerprint * 31 + t.provenance_id)
    if t.evidence_kind == 1 {
        assert(t.source_survivor_mask == 15)
        assert(t.source_survivor_count == 4)
        assert(t.source_evidence_count == 0)
        assert(t.source_burden_spent == 0)
        assert(t.source_last_provenance_id == 0)
        assert(t.source_provenance_fingerprint == 0)
        assert(t.previous_provenance_id == 0)
        assert(t.declared_burden_units == 5)
        let replayed_mask = custody_values_prediction_mask(
            t.custody_candidate_considered,
            t.custody_scheduled,
            t.custody_delivered,
            t.custody_response_opportunity_existed,
            t.custody_responded_within_window,
            t.custody_delayed_at_window_close,
            t.custody_value_present,
            t.custody_observed_value,
        )
        assert(replayed_mask > 0)
        assert(t.result_survivor_mask == replayed_mask)
        assert(!t.retry_responded_within_window)
        assert(!t.retry_value_present)
        assert(t.retry_observed_value == -1)
    } else {
        assert(t.source_survivor_mask == 6)
        assert(t.source_survivor_count == 2)
        assert(t.source_evidence_count == 1)
        assert(t.source_burden_spent == 5)
        assert(t.source_last_provenance_id > 0)
        assert(t.source_provenance_fingerprint == t.source_last_provenance_id)
        assert(t.declared_burden_units == 4)
        assert(!t.custody_candidate_considered)
        assert(!t.custody_scheduled)
        assert(!t.custody_delivered)
        assert(!t.custody_response_opportunity_existed)
        assert(!t.custody_responded_within_window)
        assert(!t.custody_delayed_at_window_close)
        assert(!t.custody_value_present)
        assert(t.custody_observed_value == -1)
        let replay_h1 = retry_values_match_mode(
            1,
            t.retry_responded_within_window,
            t.retry_value_present,
            t.retry_observed_value,
        )
        let replay_h2 = retry_values_match_mode(
            2,
            t.retry_responded_within_window,
            t.retry_value_present,
            t.retry_observed_value,
        )
        let replayed_mask = 2 * as_i64(replay_h1) + 4 * as_i64(replay_h2)
        assert(replayed_mask == 2 || replayed_mask == 4)
        assert(t.result_survivor_mask == replayed_mask)
    }
    assert(t.exact_prediction_replay)
    validate_contest_state(t.result_state)
}

fn retry_matches_mode(mode: i64, trace: AdmissibleRetryTraceReceipt) -> bool with Panic {
    retry_values_match_mode(
        mode,
        trace.responded_within_retry_window,
        trace.value_present,
        trace.observed_value,
    )
}

fn retry_values_match_mode(
    mode: i64,
    responded_within_retry_window: bool,
    value_present: bool,
    observed_value: i64,
) -> bool with Panic {
    assert(mode >= 0 && mode <= 3)
    let expected_response = predicted_retry_response(mode)
    let expected_present = predicted_retry_value_present(mode)
    let expected_value = predicted_retry_observed_value(mode)
    responded_within_retry_window == expected_response &&
        value_present == expected_present &&
        observed_value == expected_value
}

fn validate_retry_trace(trace: AdmissibleRetryTraceReceipt) with Panic {
    assert(trace.trace_id > 0 && trace.family_id > 0 && trace.protocol_id > 0)
    assert(trace.assignment_id > 0 && trace.retry_tick == 3)
    assert(trace.value_present == trace.responded_within_retry_window)
    assert(trace.observed_value == (if trace.value_present { 2 } else { -1 }))
    assert(trace.provenance_id > 0 && trace.provenance_id <= 1000000)
    assert(trace.previous_provenance_id > 0 && trace.previous_provenance_id <= 1000000)
    assert(trace.declared_burden_units == 4)
    assert(trace.policy_retained_in_provenance)
    assert(!trace.retroactive_original_tick_value_claimed)
}

pub fn declare_observation_hypothesis(
    hypothesis_id: i64,
    mode: i64,
    family_id: i64,
) -> DeclaredObservationHypothesisReceipt with Panic {
    let h = DeclaredObservationHypothesisReceipt {
        hypothesis_id: hypothesis_id,
        mode: mode,
        declared_family_id: family_id,
        hidden_target_value: hidden_target_for_mode(mode),
        delivery_failure_mode: mode == 0,
        declared_target_independent_nonresponse_mode: mode == 1,
        declared_target_dependent_suppression_mode: mode == 2,
        policy_withholding_mode: mode == 3,
        empirical_missingness_taxonomy_established: false,
        biological_mechanism_established: false,
        clinical_authority: false,
    }
    validate_hypothesis(h)
    h
}

pub fn declare_endogenous_observation_family(
    family_id: i64,
    protocol_id: i64,
    h0: DeclaredObservationHypothesisReceipt,
    h1: DeclaredObservationHypothesisReceipt,
    h2: DeclaredObservationHypothesisReceipt,
    h3: DeclaredObservationHypothesisReceipt,
) -> EndogenousObservationFamilyReceipt with Panic {
    validate_hypothesis(h0)
    validate_hypothesis(h1)
    validate_hypothesis(h2)
    validate_hypothesis(h3)
    assert(h0.mode == 0 && h1.mode == 1 && h2.mode == 2 && h3.mode == 3)
    assert(h0.declared_family_id == family_id)
    assert(h1.declared_family_id == family_id)
    assert(h2.declared_family_id == family_id)
    assert(h3.declared_family_id == family_id)
    let family = EndogenousObservationFamilyReceipt {
        family_id: family_id,
        protocol_id: protocol_id,
        delivery_failure_hypothesis_id: h0.hypothesis_id,
        target_independent_hypothesis_id: h1.hypothesis_id,
        target_dependent_hypothesis_id: h2.hypothesis_id,
        policy_withholding_hypothesis_id: h3.hypothesis_id,
        hypothesis_count: 4,
        family_exhaustive_in_reality: false,
        synthetic_scope_only: true,
    }
    validate_family(family)
    family
}

pub fn declare_measurement_intent(
    intent_id: i64,
