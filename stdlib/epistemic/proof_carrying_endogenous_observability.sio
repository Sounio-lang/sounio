    let state = EndogenousObservabilityContestStateReceipt {
        state_id: state_id,
        family_id: family.family_id,
        protocol_id: family.protocol_id,
        survivor_mask: 15,
        survivor_count: 4,
        evidence_count: 0,
        burden_spent: 0,
        last_provenance_id: 0,
        provenance_fingerprint: 0,
        family_refuted: false,
    }
    validate_contest_state(state)
    state
}

pub fn update_observability_contest_with_custody(
    transition_id: i64,
    result_state_id: i64,
    source: EndogenousObservabilityContestStateReceipt,
    family: EndogenousObservationFamilyReceipt,
    trace: AdmissibleObservationCustodyTraceReceipt,
) -> EndogenousObservabilityContestTransitionReceipt with Panic {
    validate_contest_state(source)
    validate_family(family)
    validate_custody_trace(trace)
    assert(source.family_id == family.family_id)
    assert(source.protocol_id == family.protocol_id)
    assert(trace.family_id == family.family_id)
    assert(trace.protocol_id == family.protocol_id)
    assert(trace.previous_provenance_id == source.last_provenance_id)
    let prediction_mask = trace_prediction_mask(trace)
    assert(source.survivor_mask == 15)
    let result_mask = prediction_mask
    let result = EndogenousObservabilityContestStateReceipt {
        state_id: result_state_id,
        family_id: family.family_id,
        protocol_id: family.protocol_id,
        survivor_mask: result_mask,
        survivor_count: count_four_mask(result_mask),
        evidence_count: source.evidence_count + 1,
        burden_spent: source.burden_spent + trace.declared_burden_units,
        last_provenance_id: trace.provenance_id,
        provenance_fingerprint: source.provenance_fingerprint * 31 + trace.provenance_id,
        family_refuted: result_mask == 0,
    }
    let transition = EndogenousObservabilityContestTransitionReceipt {
        transition_id: transition_id,
        evidence_kind: 1,
        family_id: family.family_id,
        protocol_id: family.protocol_id,
        source_state_id: source.state_id,
        source_survivor_mask: source.survivor_mask,
        source_survivor_count: source.survivor_count,
        source_evidence_count: source.evidence_count,
        source_burden_spent: source.burden_spent,
        source_last_provenance_id: source.last_provenance_id,
        source_provenance_fingerprint: source.provenance_fingerprint,
        result_survivor_mask: result_mask,
        result_survivor_count: count_four_mask(result_mask),
        provenance_id: trace.provenance_id,
        previous_provenance_id: trace.previous_provenance_id,
        declared_burden_units: trace.declared_burden_units,
        custody_candidate_considered: trace.candidate_considered,
        custody_scheduled: trace.scheduled,
        custody_delivered: trace.delivered,
        custody_response_opportunity_existed: trace.response_opportunity_existed,
        custody_responded_within_window: trace.responded_within_window,
        custody_delayed_at_window_close: trace.delayed_at_window_close,
        custody_value_present: trace.value_present,
        custody_observed_value: trace.observed_value,
        retry_responded_within_window: false,
        retry_value_present: false,
        retry_observed_value: -1,
        result_state: result,
        exact_prediction_replay: true,
    }
    validate_transition(transition)
    transition
}

pub fn observability_contest_transition_result(
    transition: EndogenousObservabilityContestTransitionReceipt,
) -> EndogenousObservabilityContestStateReceipt with Panic {
    validate_transition(transition)
    transition.result_state
