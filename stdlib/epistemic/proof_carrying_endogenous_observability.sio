pub fn abstain_on_legacy_missing(
    abstention_id: i64,
    state: EndogenousObservabilityContestStateReceipt,
    token: LegacyCoarsenedMissingTokenReceipt,
) -> EndogenousObservabilityAbstentionReceipt with Panic {
    validate_contest_state(state)
    validate_legacy_missing_token(token)
    assert(token.family_id == state.family_id && token.protocol_id == state.protocol_id)
    EndogenousObservabilityAbstentionReceipt {
        abstention_id: abstention_id,
        reason_code: 1,
        survivor_mask_unchanged: state.survivor_mask,
        survivor_count_unchanged: state.survivor_count,
        hypotheses_eliminated: 0,
        inference_deferred: true,
    }
}

pub fn abstain_on_policy_erased_custody(
    abstention_id: i64,
    state: EndogenousObservabilityContestStateReceipt,
    trace: PolicyErasedCustodyTraceReceipt,
) -> EndogenousObservabilityAbstentionReceipt with Panic {
    validate_contest_state(state)
    assert(trace.trace_id > 0)
    assert(trace.family_id == state.family_id && trace.protocol_id == state.protocol_id)
    assert(!trace.policy_retained_in_provenance)
    assert(trace.hypotheses_eliminated == 0)
    EndogenousObservabilityAbstentionReceipt {
        abstention_id: abstention_id,
        reason_code: 2,
        survivor_mask_unchanged: state.survivor_mask,
        survivor_count_unchanged: state.survivor_count,
        hypotheses_eliminated: 0,
        inference_deferred: true,
    }
}

pub fn certify_observed_trace_equivalence(
    equivalence_id: i64,
    left: DeclaredObservationHypothesisReceipt,
    right: DeclaredObservationHypothesisReceipt,
    left_trace: AdmissibleObservationCustodyTraceReceipt,
    right_trace: AdmissibleObservationCustodyTraceReceipt,
    left_token: LegacyCoarsenedMissingTokenReceipt,
    right_token: LegacyCoarsenedMissingTokenReceipt,
) -> ObservedTraceEquivalenceReceipt with Panic {
    validate_hypothesis(left)
    validate_hypothesis(right)
    validate_custody_trace(left_trace)
    validate_custody_trace(right_trace)
    validate_legacy_missing_token(left_token)
    validate_legacy_missing_token(right_token)
    assert(left.mode == 1 && right.mode == 2)
    assert(left.declared_family_id == right.declared_family_id)
    assert(left_trace.family_id == left.declared_family_id)
    assert(right_trace.family_id == right.declared_family_id)
    assert(left_trace.family_id == right_trace.family_id)
    assert(left_trace.protocol_id == right_trace.protocol_id)
    assert(trace_matches_mode(left.mode, left_trace))
    assert(trace_matches_mode(right.mode, right_trace))
    assert(left_token.family_id == left_trace.family_id)
    assert(right_token.family_id == right_trace.family_id)
    assert(left_token.protocol_id == left_trace.protocol_id)
    assert(right_token.protocol_id == right_trace.protocol_id)
    let custody_equal =
        left_trace.candidate_considered == right_trace.candidate_considered &&
        left_trace.scheduled == right_trace.scheduled &&
        left_trace.delivered == right_trace.delivered &&
        left_trace.response_opportunity_existed == right_trace.response_opportunity_existed &&
        left_trace.responded_within_window == right_trace.responded_within_window &&
        left_trace.delayed_at_window_close == right_trace.delayed_at_window_close &&
        left_trace.value_present == right_trace.value_present &&
        left_trace.observed_value == right_trace.observed_value
    let tokens_equal = left_token.legacy_missing_code == right_token.legacy_missing_code &&
        left_token.value_present == right_token.value_present
    assert(custody_equal)
    assert(tokens_equal)
    assert(left.hidden_target_value != right.hidden_target_value)
    assert(predicted_retry_response(left.mode) != predicted_retry_response(right.mode))
    ObservedTraceEquivalenceReceipt {
        equivalence_id: equivalence_id,
        left_hypothesis_id: left.hypothesis_id,
        right_hypothesis_id: right.hypothesis_id,
        left_mode: left.mode,
        right_mode: right.mode,
        left_hidden_target_value: left.hidden_target_value,
        right_hidden_target_value: right.hidden_target_value,
        original_custody_traces_equal: true,
        legacy_tokens_equal: true,
        retry_predictions_differ: true,
        empirically_identified_from_original_trace: false,
        global_recoverability_established: false,
        missingness_taxonomy_established: false,
    }
}

pub fn certify_endogenous_observability_ambiguity(
    ambiguity_id: i64,
    transition: EndogenousObservabilityContestTransitionReceipt,
    family: EndogenousObservationFamilyReceipt,
) -> EndogenousObservabilityAmbiguityReceipt with Panic {
    validate_transition(transition)
    validate_family(family)
    assert(transition.evidence_kind == 1)
    assert(transition.family_id == family.family_id)
    assert(transition.result_survivor_mask == 6)
    EndogenousObservabilityAmbiguityReceipt {
        ambiguity_id: ambiguity_id,
        family_id: family.family_id,
        survivor_mask: 6,
        survivor_count: 2,
        target_independent_hypothesis_survives: true,
        target_dependent_hypothesis_survives: true,
        custody_process_partially_identified: true,
        response_mechanism_identified: false,
        latent_target_observed: false,
        biological_mechanism_established: false,
        clinical_authority: false,
    }
}

pub fn declare_synthetic_exogenous_retry_assignment(
    assignment_id: i64,
    protocol_id: i64,
) -> SyntheticExogenousRetryAssignmentReceipt with Panic {
    assert(assignment_id > 0 && protocol_id > 0)
    SyntheticExogenousRetryAssignmentReceipt {
        assignment_id: assignment_id,
        protocol_id: protocol_id,
        retry_tick: 3,
        retry_window_ticks: 0,
        exogenously_assigned_within_fixture: true,
        real_person_randomization_claimed: false,
        consent_authority: false,
        clinical_authority: false,
    }
}

pub fn admit_retry_trace(
    trace_id: i64,
    family: EndogenousObservationFamilyReceipt,
    assignment: SyntheticExogenousRetryAssignmentReceipt,
    provenance: ObservationEvidenceProvenanceReceipt,
    responded_within_retry_window: bool,
) -> AdmissibleRetryTraceReceipt with Panic {
    validate_family(family)
    validate_provenance(provenance)
    assert(assignment.assignment_id > 0)
    assert(assignment.protocol_id == family.protocol_id)
    assert(assignment.retry_tick == 3 && assignment.retry_window_ticks == 0)
    assert(assignment.exogenously_assigned_within_fixture)
    assert(!assignment.real_person_randomization_claimed)
    assert(!assignment.consent_authority && !assignment.clinical_authority)
    assert(provenance.protocol_id == family.protocol_id)
    assert(provenance.tick == assignment.retry_tick)
    let trace = AdmissibleRetryTraceReceipt {
        trace_id: trace_id,
        family_id: family.family_id,
        protocol_id: family.protocol_id,
        assignment_id: assignment.assignment_id,
        retry_tick: assignment.retry_tick,
        responded_within_retry_window: responded_within_retry_window,
        value_present: responded_within_retry_window,
        observed_value: if responded_within_retry_window { 2 } else { -1 },
        provenance_id: provenance.provenance_id,
        previous_provenance_id: provenance.previous_provenance_id,
        declared_burden_units: 4,
        policy_retained_in_provenance: provenance.policy_retained,
        retroactive_original_tick_value_claimed: false,
    }
    validate_retry_trace(trace)
    trace
}

pub fn disconnect_retry_provenance(
    trace_id: i64,
    trace: AdmissibleRetryTraceReceipt,
) -> DisconnectedRetryTraceReceipt with Panic {
    validate_retry_trace(trace)
    DisconnectedRetryTraceReceipt {
        trace_id: trace_id,
        family_id: trace.family_id,
        protocol_id: trace.protocol_id,
        provenance_id: trace.provenance_id,
        previous_provenance_id: 0,
        chain_complete: false,
        hypotheses_eliminated: 0,
    }
}

pub fn abstain_on_disconnected_retry(
    abstention_id: i64,
    state: EndogenousObservabilityContestStateReceipt,
    trace: DisconnectedRetryTraceReceipt,
) -> EndogenousObservabilityAbstentionReceipt with Panic {
    validate_contest_state(state)
    assert(trace.trace_id > 0)
    assert(trace.family_id == state.family_id && trace.protocol_id == state.protocol_id)
    assert(!trace.chain_complete && trace.hypotheses_eliminated == 0)
    EndogenousObservabilityAbstentionReceipt {
        abstention_id: abstention_id,
        reason_code: 3,
        survivor_mask_unchanged: state.survivor_mask,
        survivor_count_unchanged: state.survivor_count,
        hypotheses_eliminated: 0,
        inference_deferred: true,
    }
}

pub fn update_observability_contest_with_retry(
    transition_id: i64,
    result_state_id: i64,
    source: EndogenousObservabilityContestStateReceipt,
    family: EndogenousObservationFamilyReceipt,
    trace: AdmissibleRetryTraceReceipt,
) -> EndogenousObservabilityContestTransitionReceipt with Panic {
    validate_contest_state(source)
    validate_family(family)
    validate_retry_trace(trace)
    assert(source.family_id == family.family_id && source.protocol_id == family.protocol_id)
    assert(trace.family_id == family.family_id && trace.protocol_id == family.protocol_id)
    assert(source.survivor_mask == 6 && source.evidence_count == 1)
    assert(trace.previous_provenance_id == source.last_provenance_id)
    let h1 = (source.survivor_mask / 2) % 2 == 1 && retry_matches_mode(1, trace)
    let h2 = (source.survivor_mask / 4) % 2 == 1 && retry_matches_mode(2, trace)
    let result_mask = 2 * as_i64(h1) + 4 * as_i64(h2)
    assert(result_mask == 2 || result_mask == 4)
    let result = EndogenousObservabilityContestStateReceipt {
        state_id: result_state_id,
        family_id: family.family_id,
        protocol_id: family.protocol_id,
        survivor_mask: result_mask,
        survivor_count: 1,
        evidence_count: source.evidence_count + 1,
        burden_spent: source.burden_spent + trace.declared_burden_units,
        last_provenance_id: trace.provenance_id,
        provenance_fingerprint: source.provenance_fingerprint * 31 + trace.provenance_id,
        family_refuted: false,
    }
    let transition = EndogenousObservabilityContestTransitionReceipt {
        transition_id: transition_id,
        evidence_kind: 2,
        family_id: family.family_id,
        protocol_id: family.protocol_id,
        source_state_id: source.state_id,
        source_survivor_mask: source.survivor_mask,
        source_survivor_count: source.survivor_count,
        source_evidence_count: source.evidence_count,
        source_burden_spent: source.burden_spent,
        source_last_provenance_id: source.last_provenance_id,
        source_provenance_fingerprint: source.provenance_fingerprint,
        result_survivor_mask: result_mask,
        result_survivor_count: 1,
        provenance_id: trace.provenance_id,
        previous_provenance_id: trace.previous_provenance_id,
        declared_burden_units: trace.declared_burden_units,
        custody_candidate_considered: false,
        custody_scheduled: false,
        custody_delivered: false,
        custody_response_opportunity_existed: false,
        custody_responded_within_window: false,
        custody_delayed_at_window_close: false,
        custody_value_present: false,
        custody_observed_value: -1,
        retry_responded_within_window: trace.responded_within_retry_window,
        retry_value_present: trace.value_present,
        retry_observed_value: trace.observed_value,
        result_state: result,
        exact_prediction_replay: true,
    }
    validate_transition(transition)
    transition
}

pub fn certify_declared_response_mechanism_identification(
    identification_id: i64,
    transition: EndogenousObservabilityContestTransitionReceipt,
    family: EndogenousObservationFamilyReceipt,
) -> DeclaredResponseMechanismIdentificationReceipt with Panic {
    validate_transition(transition)
    validate_family(family)
    assert(transition.evidence_kind == 2)
    assert(transition.family_id == family.family_id)
    assert(transition.result_survivor_mask == 2 || transition.result_survivor_mask == 4)
    let selected_mode = if transition.result_survivor_mask == 2 { 1 } else { 2 }
    let selected_id = if selected_mode == 1 {
        family.target_independent_hypothesis_id
    } else {
        family.target_dependent_hypothesis_id
    }
    DeclaredResponseMechanismIdentificationReceipt {
        identification_id: identification_id,
        family_id: family.family_id,
        selected_hypothesis_id: selected_id,
        selected_mode: selected_mode,
        survivor_mask: transition.result_survivor_mask,
        evidence_count: transition.result_state.evidence_count,
        burden_spent: transition.result_state.burden_spent,
        provenance_fingerprint: transition.result_state.provenance_fingerprint,
        mechanism_identified_within_declared_family: true,
        latent_original_target_observed: false,
        global_truth_established: false,
        empirical_missingness_taxonomy_established: false,
        biological_mechanism_established: false,
        clinical_authority: false,
    }
}

pub fn record_delayed_response(
    response_id: i64,
    intent: MeasurementIntentReceipt,
    opportunity: ResponseOpportunityReceipt,
    provenance: ObservationEvidenceProvenanceReceipt,
    arrival_tick: i64,
    observed_value: i64,
) -> DelayedResponseReceipt with Panic {
    validate_intent(intent)
    validate_opportunity(opportunity)
    validate_provenance(provenance)
    assert(opportunity.protocol_id == intent.protocol_id)
    assert(opportunity.response_opportunity_existed)
    assert(opportunity.mode == 2)
    assert(provenance.protocol_id == intent.protocol_id)
    assert(arrival_tick == 3)
    assert(provenance.tick == arrival_tick)
    assert(observed_value == hidden_target_for_mode(opportunity.mode))
    DelayedResponseReceipt {
        response_id: response_id,
        protocol_id: intent.protocol_id,
        prompt_tick: intent.prompt_tick,
        window_closed_tick: intent.prompt_tick + intent.response_window_ticks,
        arrival_tick: arrival_tick,
        elapsed_ticks: arrival_tick - intent.prompt_tick,
        observed_value: observed_value,
        value_present_at_arrival: true,
        response_arrived_after_window: true,
        contemporaneous_with_prompt: false,
        provenance_id: provenance.provenance_id,
    }
}

pub fn align_delayed_response_to_arrival(
    alignment_id: i64,
    response: DelayedResponseReceipt,
) -> TimeAlignedObservedValueReceipt with Panic {
    assert(response.response_id > 0 && response.protocol_id > 0)
    assert(response.arrival_tick > response.window_closed_tick)
    assert(response.elapsed_ticks == response.arrival_tick - response.prompt_tick)
    assert(response.value_present_at_arrival)
    assert(response.response_arrived_after_window)
    assert(!response.contemporaneous_with_prompt)
    TimeAlignedObservedValueReceipt {
        alignment_id: alignment_id,
        source_response_id: response.response_id,
        protocol_id: response.protocol_id,
        aligned_tick: response.arrival_tick,
        observed_value: response.observed_value,
        value_present: true,
        retroactively_assigned_to_prompt_tick: false,
    }
}

pub fn observed_value_at_prompt(
    observation: ContemporaneousObservedValueReceipt,
) -> i64 with Panic {
    assert(observation.observation_id > 0 && observation.protocol_id > 0)
    assert(observation.prompt_tick == observation.observed_tick)
    assert(observation.value_present && observation.contemporaneous_with_prompt)
    observation.observed_value
}

pub fn certify_observability_relabel_invariance(
    control_id: i64,
    original: EndogenousObservationFamilyReceipt,
    relabeled: EndogenousObservationFamilyReceipt,
) -> ObservabilityRelabelControlReceipt with Panic {
    validate_family(original)
    validate_family(relabeled)
    assert(original.protocol_id == relabeled.protocol_id)
    let corresponding_ids_changed =
        original.delivery_failure_hypothesis_id != relabeled.delivery_failure_hypothesis_id &&
        original.target_independent_hypothesis_id != relabeled.target_independent_hypothesis_id &&
        original.target_dependent_hypothesis_id != relabeled.target_dependent_hypothesis_id &&
        original.policy_withholding_hypothesis_id != relabeled.policy_withholding_hypothesis_id
    assert(corresponding_ids_changed)
    var mode: i64 = 0
    while mode < 4 {
        let original_id = family_hypothesis_id(original, mode)
        let relabeled_id = family_hypothesis_id(relabeled, mode)
        assert(original_id != relabeled_id)
        let original_mode = family_mode_for_hypothesis(original, original_id)
        let relabeled_mode = family_mode_for_hypothesis(relabeled, relabeled_id)
        assert(original_mode == mode)
        assert(relabeled_mode == mode)
        assert(custody_prediction_signature(original_mode) ==
            custody_prediction_signature(relabeled_mode))
        assert(retry_prediction_signature(original_mode) ==
            retry_prediction_signature(relabeled_mode))
        var rival: i64 = 0
        while rival < 4 {
            let original_rival_id = family_hypothesis_id(original, rival)
            let relabeled_rival_id = family_hypothesis_id(relabeled, rival)
            let original_rival_mode = family_mode_for_hypothesis(
                original, original_rival_id,
            )
            let relabeled_rival_mode = family_mode_for_hypothesis(
                relabeled, relabeled_rival_id,
            )
            let original_equivalent =
                custody_prediction_signature(original_mode) ==
                    custody_prediction_signature(original_rival_mode)
            let relabeled_equivalent =
                custody_prediction_signature(relabeled_mode) ==
                    custody_prediction_signature(relabeled_rival_mode)
            assert(original_equivalent == relabeled_equivalent)
            rival = rival + 1
        }
        mode = mode + 1
    }
    ObservabilityRelabelControlReceipt {
        control_id: control_id,
        corresponding_hypothesis_ids_changed: true,
        custody_predictions_equal: true,
        retry_predictions_equal: true,
        partitions_invariant: true,
    }
}
