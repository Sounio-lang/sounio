    let policy = ObservationPolicyDecisionReceipt {
        decision_id: decision_id,
        intent_id: intent.intent_id,
        protocol_id: intent.protocol_id,
        mode: h.mode,
        candidate_considered: true,
        scheduled: predicted_scheduled(h.mode),
        policy_retained_in_provenance: true,
        participant_response_claimed: false,
        clinical_authority: false,
    }
    validate_policy(policy)
    policy
}

pub fn derive_delivery_event(
    delivery_id: i64,
