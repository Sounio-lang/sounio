// Exact finite synthetic kernel for proof-carrying endogenous observability D4.
//
// The fixture separates measurement intent, policy, delivery, response
// opportunity, response timing, and value observation. It does not represent
// a real person, biological response mechanism, physical measurement,
// missing-data taxonomy, randomized clinical intervention, or clinical act.
// "Proof-carrying" means runtime-replayable bounded receipts, not a
// proof-assistant soundness theorem or compiler-sealed construction.

pub struct DeclaredObservationHypothesisReceipt {
    pub hypothesis_id: i64,
    pub mode: i64,
    pub declared_family_id: i64,
    pub hidden_target_value: i64,
    pub delivery_failure_mode: bool,
    pub declared_target_independent_nonresponse_mode: bool,
    pub declared_target_dependent_suppression_mode: bool,
    pub policy_withholding_mode: bool,
    pub empirical_missingness_taxonomy_established: bool,
    pub biological_mechanism_established: bool,
    pub clinical_authority: bool,
}

