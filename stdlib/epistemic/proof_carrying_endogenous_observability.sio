pub fn record_window_nonresponse(
    outcome_id: i64,
    intent: MeasurementIntentReceipt,
    opportunity: ResponseOpportunityReceipt,
) -> WindowNonresponseReceipt with Panic {
    validate_intent(intent)
    validate_opportunity(opportunity)
    assert(opportunity.protocol_id == intent.protocol_id)
    assert(opportunity.mode == 1 || opportunity.mode == 2)
    assert(opportunity.response_opportunity_existed)
    let result = WindowNonresponseReceipt {
        outcome_id: outcome_id,
        opportunity_id: opportunity.opportunity_id,
        protocol_id: intent.protocol_id,
        mode: opportunity.mode,
        window_closed_tick: intent.prompt_tick + intent.response_window_ticks,
        response_opportunity_existed: true,
        responded_within_window: false,
        response_never_occurs_claimed: false,
        numeric_target_observed: false,
    }
    assert(result.outcome_id > 0)
    assert(result.window_closed_tick == 2)
    result
}

pub fn record_observation_provenance(
    provenance_id: i64,
    source_id: i64,
    protocol_id: i64,
    tick: i64,
    previous_provenance_id: i64,
    policy_decision_id: i64,
) -> ObservationEvidenceProvenanceReceipt with Panic {
    let p = ObservationEvidenceProvenanceReceipt {
        provenance_id: provenance_id,
        source_id: source_id,
        protocol_id: protocol_id,
        tick: tick,
        previous_provenance_id: previous_provenance_id,
        policy_decision_id: policy_decision_id,
        chain_complete: true,
        policy_retained: true,
    }
    validate_provenance(p)
    p
}

pub fn admit_observation_custody_trace(
    trace_id: i64,
    family: EndogenousObservationFamilyReceipt,
    intent: MeasurementIntentReceipt,
    policy: ObservationPolicyDecisionReceipt,
    delivery: DeliveryEventReceipt,
    opportunity: ResponseOpportunityReceipt,
    provenance: ObservationEvidenceProvenanceReceipt,
) -> AdmissibleObservationCustodyTraceReceipt with Panic {
    validate_family(family)
    validate_intent(intent)
    validate_policy(policy)
    validate_delivery(delivery)
    validate_opportunity(opportunity)
    validate_provenance(provenance)
    assert(intent.protocol_id == family.protocol_id)
    assert(policy.intent_id == intent.intent_id)
    assert(policy.protocol_id == family.protocol_id)
    assert(delivery.decision_id == policy.decision_id)
    assert(delivery.protocol_id == family.protocol_id)
    assert(delivery.mode == policy.mode)
    assert(opportunity.delivery_id == delivery.delivery_id)
    assert(opportunity.protocol_id == family.protocol_id)
    assert(opportunity.mode == policy.mode)
    assert(provenance.protocol_id == family.protocol_id)
    assert(provenance.tick == 2)
    assert(provenance.policy_decision_id == policy.decision_id)
    let trace = AdmissibleObservationCustodyTraceReceipt {
        trace_id: trace_id,
        family_id: family.family_id,
        protocol_id: family.protocol_id,
        intent_id: intent.intent_id,
        policy_decision_id: policy.decision_id,
        delivery_id: delivery.delivery_id,
        opportunity_id: opportunity.opportunity_id,
        candidate_considered: intent.candidate_considered,
        scheduled: policy.scheduled,
        delivered: delivery.delivered,
        response_opportunity_existed: opportunity.response_opportunity_existed,
        responded_within_window: false,
        delayed_at_window_close: false,
        value_present: false,
        observed_value: -1,
        provenance_id: provenance.provenance_id,
        previous_provenance_id: provenance.previous_provenance_id,
        declared_burden_units: 5,
        policy_retained_in_provenance: provenance.policy_retained,
        physical_observation_claimed: false,
    }
    validate_custody_trace(trace)
    trace
}

pub fn coarsen_custody_to_legacy_missing(
    token_id: i64,
    trace: AdmissibleObservationCustodyTraceReceipt,
) -> LegacyCoarsenedMissingTokenReceipt with Panic {
    validate_custody_trace(trace)
    let token = LegacyCoarsenedMissingTokenReceipt {
        token_id: token_id,
        family_id: trace.family_id,
        protocol_id: trace.protocol_id,
        legacy_missing_code: -1,
        value_present: false,
        custody_erased: true,
        hypotheses_eliminated: 0,
    }
    assert(token.token_id > 0)
    validate_legacy_missing_token(token)
    token
}

pub fn erase_policy_from_custody_trace(
    erased_trace_id: i64,
    trace: AdmissibleObservationCustodyTraceReceipt,
) -> PolicyErasedCustodyTraceReceipt with Panic {
    validate_custody_trace(trace)
    let erased = PolicyErasedCustodyTraceReceipt {
        trace_id: erased_trace_id,
        family_id: trace.family_id,
        protocol_id: trace.protocol_id,
        original_policy_decision_id: trace.policy_decision_id,
        policy_retained_in_provenance: false,
        hypotheses_eliminated: 0,
    }
    assert(erased.trace_id > 0)
    erased
}

pub fn begin_endogenous_observability_contest(
    state_id: i64,
