// stdlib/epistemic/revocable.sio
//
// RevocableKnowledge<T> — knowledge with a zero-divisor-backed revocation
// primitive.  Given a ZD operator (e.g. A = e3 + e10) and a value v encoded
// in its 4-dimensional right-annihilator (the ZD kernel), the function
// `revoke(v)` returns the value whose stored representation has been
// algebraically zeroed.
//
// Unlike `Knowledge<T>.unwrap`, which trades an epistemic guarantee for a
// raw value, `revoke` *removes* the underlying contribution from the
// knowledge state — no residual, no epsilon.
//
// All functions in this module declare `with ZD`.  The compiler enforces
// this via error code 200 (see self-hosted/check/check.sio).
//
// Formal backing: `unlearning_kernel_exact` in
// formal/lean4/SounioSurgicalInterventions.lean.

// ZD kernel basis for A = e3 + e10 (verified operationally in
// examples/zd_model_editing_locality.sio).  These are 16D f64 vectors.
fn zd_basis_u1() -> [f64; 16] with Mut {
    var v: [f64; 16] = [0.0; 16]
    v[6]  = 0.707107
    v[15] = 0.0 - 0.707107
    v
}

fn zd_basis_u2() -> [f64; 16] with Mut {
    var v: [f64; 16] = [0.0; 16]
    v[7]  = 0.707107
    v[14] = 0.707107
    v
}

// kernel_project: compute the projection of v onto the ZD kernel
// (spanned by u1, u2).  Returns a 16D vector living in the kernel.
// `with ZD` is required because the caller is asserting this is an
// exact-annihilation operation.
fn kernel_project(v: &[f64; 16]) -> [f64; 16] with Mut, ZD {
    let u1 = zd_basis_u1()
    let u2 = zd_basis_u2()
    var c1 = 0.0; var c2 = 0.0
    var i = 0
    while i < 16 { c1 = c1 + (*v)[i] * u1[i]; c2 = c2 + (*v)[i] * u2[i]; i = i + 1 }
    var out: [f64; 16] = [0.0; 16]
    i = 0
    while i < 16 { out[i] = c1 * u1[i] + c2 * u2[i]; i = i + 1 }
    out
}

// revoke: subtract the kernel projection of `v` from `v`, leaving the
// complement intact.  This is the exact-unlearning primitive used by
// ExactlyPrivate<T> and RevocableKnowledge<T>.  Over the verified 2D
// kernel {e6-e15, e7+e14}/√2 this is a linear projection (fp exact).
fn revoke(v: &[f64; 16]) -> [f64; 16] with Mut, ZD {
    let k = kernel_project(v)
    var out: [f64; 16] = [0.0; 16]
    var i = 0
    while i < 16 { out[i] = (*v)[i] - k[i]; i = i + 1 }
    out
}
