pub fn prepare_d10_fixture_advisory(
    sequential: D10SequentialValidityToken,
    local: D10LocalDeploymentSafetyToken,
    deferral: D10SafeDeferralToken,
    oversight: D10EffectiveOversightToken,
    modification: D10AuthorizedModificationToken,
) -> D10AdvisoryReadyToken with Panic {
    assert(sequential.evidence_id == 30301 && sequential.stage == 3)
    assert(local.site_id == 30461 && local.workflow_id == 30471)
    assert(deferral.site_id == local.site_id && deferral.deferral_id == 30514)
    assert(deferral.destination_role_id == 30512)
    assert(deferral.capacity_case_count >= deferral.requested_case_count)
    assert(deferral.acknowledged_case_count == deferral.requested_case_count)
    assert(deferral.response_time_observed_minutes <=
        deferral.response_time_limit_minutes)
    assert(deferral.unresolved_case_policy_present)
    assert(oversight.site_id == local.site_id && oversight.oversight_id == 30515)
    assert(modification.plan_id == 30601 && modification.model_version == 30412)
    D10AdvisoryReadyToken {
        evidence_id: sequential.evidence_id,
        artifact_id: modification.model_version,
        site_id: local.site_id,
    }
}

pub fn observe_d10_fixture_advisory(
    receipt_id: i64,
    token: D10AdvisoryReadyToken,
) -> D10AdvisoryReadyObservationReceipt with Panic {
    assert(receipt_id == 30801)
    assert(token.evidence_id == 30301)
    assert(token.artifact_id == 30412 && token.site_id == 30461)
    D10AdvisoryReadyObservationReceipt {
        receipt_id: receipt_id,
        artifact_id: token.artifact_id,
        site_id: token.site_id,
        workflow_version_id: 30471,
        monitoring_epoch: 1,
        fixture_advisory_ready: true,
        production_deployment_ready: false,
        clinical_action_authority: false,
    }
}

pub fn open_d10_unspent_fixture_warrant(
    advisory: D10AdvisoryReadyToken,
) -> D10UnspentFixtureWarrantToken with Panic {
    assert(advisory.evidence_id == 30301)
    assert(advisory.artifact_id == 30412 && advisory.site_id == 30461)
    D10UnspentFixtureWarrantToken {
        evidence_id: advisory.evidence_id,
        budget: 100,
        ledger_epoch: 1,
        next_nonce: 30811,
    }
}

pub fn spend_d10_fixture_warrant(
    token: D10UnspentFixtureWarrantToken,
) -> D10SpentFixtureWarrantToken with Panic {
    assert(token.evidence_id == 30301 && token.budget == 100)
    assert(token.ledger_epoch == 1 && token.next_nonce == 30811)
    let after_first = token.budget - 40
    let after_second = after_first - 60
    let second_nonce = token.next_nonce + 1
    assert(after_first == 60 && after_second == 0)
    assert(second_nonce == 30812)
    D10SpentFixtureWarrantToken {
        evidence_id: token.evidence_id,
        budget_before: token.budget,
        first_spend: 40,
        second_spend: 60,
        budget_after: after_second,
        ledger_epoch: token.ledger_epoch,
        first_spend_nonce: token.next_nonce,
        second_spend_nonce: second_nonce,
        spend_count: 2,
    }
}

pub fn observe_d10_spend_transition(
    receipt_id: i64,
    token: D10SpentFixtureWarrantToken,
) -> D10SpendTransitionObservationReceipt with Panic {
    assert(receipt_id == 30802)
    assert(token.evidence_id == 30301 && token.budget_after == 0)
    assert(token.budget_before == 100)
    assert(token.first_spend == 40 && token.second_spend == 60)
    assert(token.ledger_epoch == 1 && token.spend_count == 2)
    assert(token.first_spend_nonce == 30811)
    assert(token.second_spend_nonce == token.first_spend_nonce + 1)
    D10SpendTransitionObservationReceipt {
        receipt_id: receipt_id,
        evidence_id: token.evidence_id,
        first_spend_nonce: token.first_spend_nonce,
        second_spend_nonce: token.second_spend_nonce,
        budget_before: token.budget_before,
        first_spend: token.first_spend,
        second_spend: token.second_spend,
        budget_after: token.budget_after,
        exact_local_transition_trace: true,
        affine_consumption_proven: false,
    }
}

pub fn refuse_d10_repeat_spend(
    receipt_id: i64,
    token: D10SpentFixtureWarrantToken,
) -> D10EvidenceReuseRefusalReceipt with Panic {
    assert(receipt_id == 30803)
    assert(token.evidence_id == 30301 && token.budget_after == 0)
    assert(token.spend_count == 2 && token.first_spend_nonce == 30811)
    D10EvidenceReuseRefusalReceipt {
        receipt_id: receipt_id,
        evidence_id: token.evidence_id,
        first_spend_nonce: token.first_spend_nonce,
        attempted_nonce: token.first_spend_nonce,
        reason_mask: 1,
        repeat_spend_accepted: false,
        static_alias_elimination_proven: false,
    }
}

pub fn refuse_d10_overspend(
    receipt_id: i64,
    token: D10SpentFixtureWarrantToken,
) -> D10EvidenceOverspendRefusalReceipt with Panic {
    assert(receipt_id == 30804)
    assert(token.evidence_id == 30301 && token.budget_after == 0)
    assert(token.ledger_epoch == 1 && token.spend_count == 2)
    D10EvidenceOverspendRefusalReceipt {
        receipt_id: receipt_id,
        evidence_id: token.evidence_id,
        budget_after: token.budget_after,
        attempted_additional_spend: 10,
        reason_mask: 2,
        overspend_accepted: false,
    }
}

pub fn issue_d10_fixture_canary_lease(
    token: D10SpentFixtureWarrantToken,
) -> D10FixtureCanaryLeaseToken with Panic {
    assert(token.evidence_id == 30301 && token.budget_after == 0)
    assert(token.ledger_epoch == 1 && token.spend_count == 2)
    assert(token.second_spend_nonce == 30812)
    D10FixtureCanaryLeaseToken {
        lease_id: 30821,
        evidence_id: token.evidence_id,
        site_id: 30461,
        spend_nonce: token.second_spend_nonce,
        ledger_epoch: token.ledger_epoch,
        issued_epoch: token.ledger_epoch,
        expires_after_epoch: token.ledger_epoch,
    }
}

pub fn observe_d10_fixture_canary_lease(
    receipt_id: i64,
    token: D10FixtureCanaryLeaseToken,
) -> D10FixtureCanaryLeaseObservationReceipt with Panic {
    assert(receipt_id == 30805)
    assert(token.lease_id == 30821 && token.evidence_id == 30301)
    assert(token.site_id == 30461)
    assert(token.spend_nonce == 30812 && token.ledger_epoch == 1)
    assert(token.issued_epoch == 1 && token.expires_after_epoch == 1)
    D10FixtureCanaryLeaseObservationReceipt {
        receipt_id: receipt_id,
        lease_id: token.lease_id,
        evidence_id: token.evidence_id,
        artifact_id: 30412,
        site_id: token.site_id,
        spend_nonce: token.spend_nonce,
        ledger_epoch: token.ledger_epoch,
        issued_epoch: token.issued_epoch,
        expires_after_epoch: token.expires_after_epoch,
        canary_only: true,
        production_authority: false,
        clinical_action_authority: false,
    }
}

pub fn open_d10_epoch_one_facet() -> D10LiveEpochOneFacet {
    D10LiveEpochOneFacet { registry_id: 30831, epoch: 1 }
}

pub fn observe_d10_live_lease_at_epoch_one(
    receipt_id: i64,
    lease: D10FixtureCanaryLeaseToken,
    facet: D10LiveEpochOneFacet,
) -> D10LiveLeaseObservationReceipt with Panic {
    assert(receipt_id == 30806)
    assert(lease.lease_id == 30821 && lease.site_id == 30461)
    assert(facet.registry_id == 30831 && facet.epoch == 1)
    assert(lease.ledger_epoch == facet.epoch)
    assert(lease.issued_epoch == facet.epoch)
    assert(facet.epoch <= lease.expires_after_epoch)
    D10LiveLeaseObservationReceipt {
        receipt_id: receipt_id,
        lease_id: lease.lease_id,
        observed_epoch: facet.epoch,
        lease_live_in_frozen_observation: true,
        live_reference_monitor_proven: false,
    }
}

pub fn revoke_d10_canary_at_epoch_two(
    receipt_id: i64,
    lease: D10FixtureCanaryLeaseToken,
    facet: D10LiveEpochOneFacet,
) -> D10RevokedCanaryLeaseReceipt with Panic {
    assert(receipt_id == 30807)
    assert(lease.lease_id == 30821 && lease.site_id == 30461)
    assert(facet.registry_id == 30831 && facet.epoch == 1)
    assert(lease.issued_epoch == facet.epoch)
    assert(lease.expires_after_epoch == facet.epoch)
    D10RevokedCanaryLeaseReceipt {
        receipt_id: receipt_id,
        lease_id: lease.lease_id,
        issued_epoch: lease.issued_epoch,
        revoked_epoch: facet.epoch + 1,
        reason_mask: 16,
        lease_live: false,
        copied_stale_facet_invalidated: false,
    }
}

pub fn summarize_d10_deployment_validity(
    receipt_id: i64,
    advisory: D10AdvisoryReadyObservationReceipt,
    lease: D10FixtureCanaryLeaseObservationReceipt,
    quarantine: D10QuarantinedDeploymentReceipt,
    revoked: D10RevokedCanaryLeaseReceipt,
) -> D10DeploymentSummaryReceipt with Panic {
    assert(receipt_id == 30901)
    assert(advisory.fixture_advisory_ready)
    assert(!advisory.production_deployment_ready)
    assert(lease.canary_only && !lease.production_authority)
    assert(!quarantine.advisory_ready && quarantine.reason_mask == 8)
    assert(!revoked.lease_live && revoked.revoked_epoch == 2)
    D10DeploymentSummaryReceipt {
        receipt_id: receipt_id,
        exact_contest_count: 8,
        private_typestate_stage_count: 15,
        fixture_canary_lease_count: 1,
        quarantine_count: 1,
        external_validation_count: 0,
        production_authority_count: 0,
        patient_state_count: 0,
        clinical_action_authority_count: 0,
        compiler_rewrite_count: 0,
        exact_only_for_frozen_fixtures: true,
    }
}

// Convenience replays preserve the complete frozen positive path inside the
// defining module. They exist for imported conformance and nominal-wall tests;
// they do not widen the lease beyond the synthetic fixture.
pub fn replay_d10_complete_fixture_advisory() -> D10AdvisoryReadyToken
with Panic {
    let time_uniform = certify_d10_finite_time_uniform_fixture(30203)
    let e_process = certify_d10_frozen_e_process(30206)
    let coverage = begin_d10_coverage_checked_fixture(30301)
    let provenance = bind_d10_fixture_provenance(coverage)
    let sequential = close_d10_fixture_sequential_validity(
        provenance, time_uniform, e_process,
    )
    let local = certify_d10_local_site_a_safety(30404)
    let abstention = record_d10_model_abstention(30501)
    let pending = record_d10_pending_deferral(30502, abstention)
    let handoff = acknowledge_d10_site_a_handoff(abstention, pending)
    let capacity = record_d10_site_a_deferral_capacity(30507)
    let response = record_d10_site_a_response_plan(30508)
    let safe = certify_d10_site_a_safe_deferral(handoff, capacity, response)
    let human = record_d10_human_present(30505)
    let oversight = certify_d10_effective_oversight(human, local)
    let plan = declare_d10_pccp_plan(30601)
    let impact = record_d10_impact_assessment(30671)
    let conformance = record_d10_change_conformance(30602, plan, impact)
    let modification = authorize_d10_fixture_modification(
        plan, impact, conformance,
    )
    prepare_d10_fixture_advisory(
        sequential, local, safe, oversight, modification,
    )
}

pub fn replay_d10_complete_spent_warrant() -> D10SpentFixtureWarrantToken
with Panic {
    let advisory = replay_d10_complete_fixture_advisory()
    let unspent = open_d10_unspent_fixture_warrant(advisory)
    spend_d10_fixture_warrant(unspent)
}

pub fn replay_d10_complete_fixture_canary() -> D10FixtureCanaryLeaseToken
with Panic {
    issue_d10_fixture_canary_lease(replay_d10_complete_spent_warrant())
}
