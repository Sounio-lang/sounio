pub fn record_d10_fixed_time_e_value(
    receipt_id: i64,
) -> D10FixedTimeEValueReceipt with Panic {
    assert(receipt_id == 30205)
    let fair_path_mass = 1
    let terminal_total_mass = 4
    let weighted_terminal_sum = 4 * fair_path_mass +
        0 * fair_path_mass + 0 * fair_path_mass + 0 * fair_path_mass
    assert(weighted_terminal_sum == terminal_total_mass)
    D10FixedTimeEValueReceipt {
        receipt_id: receipt_id,
        terminal_value_hh: 4,
        terminal_value_other: 0,
        expectation_numerator: 1,
        expectation_denominator: 1,
        process_history_certified: false,
    }
}

pub fn certify_d10_frozen_e_process(
    evidence_id: i64,
) -> D10EProcessValidityToken with Panic {
    assert(evidence_id == 30206)
    let branch_mass = 1
    let look_one_total_mass = 2
    let look_two_total_mass = 4
    let e1_weighted_sum = 2 * branch_mass + 0 * branch_mass
    let e2_weighted_sum = 4 * branch_mass + 0 * branch_mass +
        0 * branch_mass + 0 * branch_mass
    // Stop at the first-step H; otherwise continue to step two.
    let stopped_weighted_sum = 2 * branch_mass + 2 * branch_mass +
        0 * branch_mass + 0 * branch_mass
    assert(e1_weighted_sum == look_one_total_mass)
    assert(e2_weighted_sum == look_two_total_mass)
    assert(stopped_weighted_sum == look_two_total_mass)
    // Conditional martingale checks on the H and T nodes, denominator two.
    assert(4 + 0 == 2 * 2)
    assert(0 + 0 == 0 * 2)
    D10EProcessValidityToken { process_id: 30216, evidence_id: evidence_id }
}

pub fn observe_d10_frozen_e_process(
