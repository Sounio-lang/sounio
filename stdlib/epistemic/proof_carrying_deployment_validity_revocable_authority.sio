    assert(plan.acceptance_criteria_id == 30661)
    assert(plan.impact_assessment_id == impact.receipt_id)
    assert(impact.within_declared_change_scope)
    assert(impact.reference_standard_version_before ==
        impact.reference_standard_version_after)
    assert(conformance.receipt_id == 30602)
    assert(conformance.plan_id == plan.receipt_id)
    assert(conformance.impact_assessment_id == impact.receipt_id)
    assert(conformance.modification_description_matches)
    assert(conformance.modification_protocol_matches)
    assert(conformance.acceptance_criteria_match)
    assert(conformance.impact_identity_matches)
    assert(conformance.all_obligations_met)
    D10AuthorizedModificationToken {
        plan_id: plan.receipt_id,
        model_version: impact.model_version_after,
    }
}

