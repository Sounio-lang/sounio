pub fn observe_d10_d9_boundary(
    receipt_id: i64,
    summary: D9StatisticalCoverageSummaryReceipt,
) -> D10D9BoundaryObservationReceipt with Panic {
    assert(receipt_id == 30001)
    assert(summary.synthetic_design_count == 455)
    assert(summary.positive_design_count == 165)
    assert(summary.positivity_failure_count == 290)
    assert(summary.adequate_design_count == 25)
    assert(summary.external_evaluation_count == 1)
    assert(summary.empirical_binding_count == 0)
    assert(summary.patient_state_count == 0)
    assert(summary.clinical_action_authority_count == 0)
    assert(summary.exact_only_for_frozen_fixture)
    D10D9BoundaryObservationReceipt {
        receipt_id: receipt_id,
        d9_summary_id: summary.summary_id,
        synthetic_design_count: summary.synthetic_design_count,
        external_evaluation_count: summary.external_evaluation_count,
        empirical_binding_count: summary.empirical_binding_count,
        patient_state_count: summary.patient_state_count,
        clinical_action_authority_count: summary.clinical_action_authority_count,
        frozen_fixture_only: true,
    }
}

pub fn record_d10_discrimination(
    receipt_id: i64,
) -> D10DiscriminationReceipt with Panic {
    assert(receipt_id == 30101)
    D10DiscriminationReceipt {
        receipt_id: receipt_id,
        outcome_count: 4,
        positive_negative_pair_count: 4,
        correctly_ranked_pair_count_a: 4,
        correctly_ranked_pair_count_b: 4,
        threshold_permille: 500,
        correct_decision_count_a: 4,
        correct_decision_count_b: 4,
        perfect_rank_discrimination_a: true,
        perfect_rank_discrimination_b: true,
        calibration_established: false,
    }
}

pub fn calculate_d10_calibration_profile_a(
    receipt_id: i64,
) -> D10CalibrationProfileAReceipt with Panic {
    assert(receipt_id == 30102)
    let sum = 100 * 100 + 200 * 200 + 200 * 200 + 100 * 100
    assert(sum == 100000)
    assert(sum * 40 == 4000000)
    D10CalibrationProfileAReceipt {
        receipt_id: receipt_id,
        artifact_id: 30112,
        score_0_permille: 100,
        score_1_permille: 200,
        score_2_permille: 800,
        score_3_permille: 900,
        squared_error_sum: sum,
        squared_error_scale: 4000000,
        brier_numerator: 1,
        brier_denominator: 40,
        exact_for_frozen_four_cases: true,
    }
}

pub fn calculate_d10_calibration_profile_b(
    receipt_id: i64,
) -> D10CalibrationProfileBReceipt with Panic {
    assert(receipt_id == 30103)
    let sum = 400 * 400 + 450 * 450 + 450 * 450 + 400 * 400
    assert(sum == 725000)
    assert(sum * 160 == 4000000 * 29)
    D10CalibrationProfileBReceipt {
        receipt_id: receipt_id,
        artifact_id: 30113,
        score_0_permille: 400,
        score_1_permille: 450,
        score_2_permille: 550,
        score_3_permille: 600,
        squared_error_sum: sum,
        squared_error_scale: 4000000,
        brier_numerator: 29,
        brier_denominator: 160,
        exact_for_frozen_four_cases: true,
    }
}

pub fn compare_d10_calibration_profiles(
    receipt_id: i64,
    discrimination: D10DiscriminationReceipt,
    a: D10CalibrationProfileAReceipt,
    b: D10CalibrationProfileBReceipt,
) -> D10CalibrationDivergenceReceipt with Panic {
    assert(receipt_id == 30104)
    assert(discrimination.correctly_ranked_pair_count_a == 4)
    assert(discrimination.correctly_ranked_pair_count_b == 4)
    assert(discrimination.correct_decision_count_a == 4)
    assert(discrimination.correct_decision_count_b == 4)
    assert(a.brier_numerator == 1 && a.brier_denominator == 40)
    assert(b.brier_numerator == 29 && b.brier_denominator == 160)
    assert(1 * 160 < 29 * 40)
    assert(29 * 40 - 1 * 160 == 1000)
    D10CalibrationDivergenceReceipt {
        receipt_id: receipt_id,
        profile_a_id: a.receipt_id,
        profile_b_id: b.receipt_id,
        shared_correct_rank_pairs: 4,
        shared_correct_decisions: 4,
        brier_a_numerator: 1,
        brier_a_denominator: 40,
        brier_b_numerator: 29,
        brier_b_denominator: 160,
        exact_gap_numerator: 5,
        exact_gap_denominator: 32,
        discrimination_substitutes_for_calibration: false,
    }
}

pub fn record_d10_fixed_horizon_coverage(
    receipt_id: i64,
) -> D10FixedHorizonCoverageReceipt with Panic {
    assert(receipt_id == 30201)
    let total = 9 + 3 + 3 + 1
    let look_one = 9 + 3
    let look_two = 9 + 3
    assert(total == 16 && look_one == 12 && look_two == 12)
    D10FixedHorizonCoverageReceipt {
        receipt_id: receipt_id,
        look_count: 2,
        path_cc_mass: 9,
        path_cm_mass: 3,
        path_mc_mass: 3,
        path_mm_mass: 1,
        total_mass: total,
        look_one_covered_mass: look_one,
        look_two_covered_mass: look_two,
        each_look_numerator: 3,
        each_look_denominator: 4,
        time_uniform: false,
    }
}

pub fn record_d10_optional_stopping_failure(
    receipt_id: i64,
    fixed: D10FixedHorizonCoverageReceipt,
) -> D10OptionalStoppingFailureReceipt with Panic {
    assert(receipt_id == 30202)
    assert(fixed.look_one_covered_mass == 12)
    assert(fixed.look_two_covered_mass == 12)
    assert(fixed.path_cc_mass == 9 && fixed.total_mass == 16)
    assert(9 * 1000 == 562 * 16 + 8)
    D10OptionalStoppingFailureReceipt {
        receipt_id: receipt_id,
        fixed_horizon_id: fixed.receipt_id,
        stopping_rule_id: 30212,
        stop_at_first_miss: true,
        stopped_covered_mass: 9,
        stopped_total_mass: 16,
        stopped_permille_floor: 562,
        stopped_permille_remainder: 8,
        fixed_horizon_promoted_to_time_uniform: false,
    }
}

