pub fn certify_d10_site_a_safe_deferral(
    handoff: D10HandoffAcknowledgedToken,
    capacity: D10DeferralCapacityReceipt,
    response: D10DeferralResponsePlanReceipt,
) -> D10SafeDeferralToken with Panic {
    assert(handoff.site_id == 30461 && handoff.handoff_id == 30513)
    assert(handoff.destination_role_id == 30512)
    assert(handoff.requested_case_count == 2)
    assert(handoff.acknowledged_case_count == handoff.requested_case_count)
    assert(capacity.receipt_id == 30507 && capacity.site_id == handoff.site_id)
    assert(capacity.destination_role_id == handoff.destination_role_id)
    assert(capacity.requested_case_count == handoff.requested_case_count)
    assert(capacity.capacity_case_count >= handoff.requested_case_count)
    assert(capacity.capacity_adequate)
    assert(response.receipt_id == 30508 && response.site_id == handoff.site_id)
    assert(response.destination_role_id == handoff.destination_role_id)
    assert(response.response_time_limit_minutes == 30)
    assert(response.response_time_observed_minutes <=
        response.response_time_limit_minutes)
    assert(response.unresolved_case_policy_present && response.response_sla_met)
    D10SafeDeferralToken {
        site_id: handoff.site_id,
        deferral_id: 30514,
        destination_role_id: handoff.destination_role_id,
        requested_case_count: handoff.requested_case_count,
        capacity_case_count: capacity.capacity_case_count,
        acknowledged_case_count: handoff.acknowledged_case_count,
        response_time_limit_minutes: response.response_time_limit_minutes,
        response_time_observed_minutes: response.response_time_observed_minutes,
        unresolved_case_policy_present: response.unresolved_case_policy_present,
    }
}

