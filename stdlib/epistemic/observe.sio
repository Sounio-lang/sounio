// stdlib/epistemic/observe.sio
// Observation of epistemic values with Bayesian update.
//
// Unobserved<Knowledge<f64>> → Knowledge<f64> via conjugate update.
// When you observe a Knowledge value, you can provide a prior to
// narrow the variance (Bayesian posterior update).
//
// The observation is the epistemic payoff: looking sharpens knowledge.

// --- Bayesian conjugate update for normal-normal model ---
// Given:
//   measurement: value ± measurement_variance
//   prior: prior_mean ± prior_variance
// Returns:
//   posterior_mean = (prior_var * value + meas_var * prior_mean) / (prior_var + meas_var)
//   posterior_var = (prior_var * meas_var) / (prior_var + meas_var)
//
// This is the normal-normal conjugate: observation always narrows variance.

fn bayesian_update_mean(
    value: f64,
    meas_var: f64,
    prior_mean: f64,
    prior_var: f64
) -> f64 with Div {
    let total = prior_var + meas_var
    if total == 0.0 { return value }
    let pv = prior_var * value
    let mv = meas_var * prior_mean
    (pv + mv) / total
}

fn bayesian_update_variance(
    meas_var: f64,
    prior_var: f64
) -> f64 with Div {
    let total = prior_var + meas_var
    if total == 0.0 { return 0.0 }
    let product = prior_var * meas_var
    product / total
}

// --- Observation without prior (identity: returns measurement as-is) ---
fn observe_bare(value: f64, variance: f64) -> f64 with Observe {
    // The act of observing collapses Unobserved → Observed.
    // Without a prior, the measurement stands unchanged.
    value
}

// --- Observation with prior (Bayesian update: narrows variance) ---
fn observe_with_prior(
    value: f64,
    meas_var: f64,
    prior_mean: f64,
    prior_var: f64
) -> f64 with Observe, Div {
    // Observation WITH prior knowledge narrows uncertainty.
    // This is the epistemic payoff: the more you know, the sharper you see.
    bayesian_update_mean(value, meas_var, prior_mean, prior_var)
}

// --- Variance after observation ---
fn observed_variance(
    meas_var: f64,
    prior_var: f64
) -> f64 with Div {
    bayesian_update_variance(meas_var, prior_var)
}

// --- Information gain from observation ---
// Measures how much the observation reduced uncertainty (in nats).
// gain = 0.5 * ln(prior_var / posterior_var)
// For the normal-normal case: gain = 0.5 * ln(1 + prior_var/meas_var)
fn observation_information_gain(
    meas_var: f64,
    prior_var: f64
) -> f64 with Div {
    if meas_var == 0.0 { return 0.0 }
    let ratio = prior_var / meas_var
    // ln(1+x) ≈ x - x²/2 + x³/3 for small x (Taylor)
    // For larger x, use: ln(1+x) ≈ x/(1 + x/2) (Padé [1/1])
    let x = ratio
    let approx = x / (1.0 + x / 2.0)
    0.5 * approx
}
