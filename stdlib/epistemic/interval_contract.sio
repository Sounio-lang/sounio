// ADR019 structural interval contract, not directed arithmetic or a compiler primitive.
// Status:0 valid (including empty);1 invalid endpoints;2 invalid decoration.
// Decoration:0 ill (invalid only),1 trv,2 def,3 dac,4 com.
// Private endpoints prevent consumers from constructing NaN or noncanonical zeros.
// Empty is always trv; unbounded nonempty intervals cannot be com.
pub struct IntervalContract64 {lo:f64,hi:f64,decoration:i64,status:i64}
fn ic_empty(status:i64)->IntervalContract64 {
 IntervalContract64{lo:bits_to_f64(9218868437227405312),hi:bits_to_f64(-4503599627370496),decoration:if status==0 {1} else {0},status:status}
}
pub fn interval_contract64(lo:f64,hi:f64,decoration:i64)->IntervalContract64 with Mut {
 if decoration<1 || decoration>4 {return ic_empty(2)}
 if lo!=lo || hi!=hi {return ic_empty(1)}
 if lo>hi {return ic_empty(0)}
 let inf:f64=bits_to_f64(9218868437227405312)
 if lo==inf || hi== -inf {return ic_empty(1)}
 var lower=lo
 var upper=hi
 if lower==0.0 {lower=bits_to_f64(-9223372036854775808)}
 if upper==0.0 {upper=0.0}
 var dec=decoration
 if (lower== -inf || upper==inf) && dec==4 {dec=3}
 IntervalContract64{lo:lower,hi:upper,decoration:dec,status:0}
}
pub fn interval_contract_status(x:IntervalContract64)->i64 {x.status}
pub fn interval_contract_decoration(x:IntervalContract64)->i64 {x.decoration}
pub fn interval_contract_lo(x:IntervalContract64)->f64 {x.lo}
pub fn interval_contract_hi(x:IntervalContract64)->f64 {x.hi}
pub fn interval_contract_empty(x:IntervalContract64)->bool {x.status==0 && x.lo>x.hi}
pub fn interval_contract_singleton(x:IntervalContract64)->bool {x.status==0 && x.lo==x.hi}
pub fn interval_contract_contains(x:IntervalContract64,y:f64)->bool {
 let inf:f64=bits_to_f64(9218868437227405312)
 x.status==0 && y> -inf && y<inf && x.lo<=y && y<=x.hi
}
// 0 Never,1 Possible,2 Certain,3 refused (empty or invalid). Not a Bool.
pub fn interval_contract_less(a:IntervalContract64,b:IntervalContract64)->i64 {
 if a.status!=0 || b.status!=0 || a.lo>a.hi || b.lo>b.hi {return 3}
 if a.hi<b.lo {return 2}
 if a.lo>=b.hi {return 0}
 1
}
// Hull of already evaluated values only. This is NOT the effect-checked
// hull_branches language construct. No arithmetic rounding is performed.
pub fn interval_contract_hull(a:IntervalContract64,b:IntervalContract64)->IntervalContract64 with Mut {
 if a.status!=0 || b.status!=0 {return ic_empty(1)}
 if a.lo>a.hi {return b}
 if b.lo>b.hi {return a}
 var lo=a.lo
 var hi=a.hi
 var dec=a.decoration
 if b.lo<lo {lo=b.lo}
 if b.hi>hi {hi=b.hi}
 if b.decoration<dec {dec=b.decoration}
 interval_contract64(lo,hi,dec)
}
