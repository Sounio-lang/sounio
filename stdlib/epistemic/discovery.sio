// stdlib/epistemic/discovery.sio
//
// Causal Discovery with Epistemic Uncertainty
//
// Core: adjacency matrix representation of causal graph,
// Fisher-Z conditional independence test, PC algorithm skeleton.
// Max 32 variables.

// ============================================================================
// Helpers
// ============================================================================

fn disc_sqrt(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 15 {
        y = 0.5 * (y + x / y)
        i = i + 1
    }
    y
}

fn disc_abs(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn disc_ln(x: f64) -> f64 with Mut, Div, Panic {
    // Series approximation of ln(x) for x > 0
    if x <= 0.0 { return 0.0 - 1000000.0 }
    var v = x
    var adj = 0.0
    while v > 2.0 { v = v / 2.0; adj = adj + 0.6931471805599453 }
    while v < 0.5 { v = v * 2.0; adj = adj - 0.6931471805599453 }
    let t = (v - 1.0) / (v + 1.0)
    let t2 = t * t
    var result = t
    var term = t
    var k = 1
    while k < 20 {
        term = term * t2
        let denom = (2 * k + 1) as f64
        result = result + term / denom
        k = k + 1
    }
    adj + 2.0 * result
}

// ============================================================================
// Data Matrix: n_obs observations, n_vars variables
// Fixed max: 32 variables, observations stored as flat array
// ============================================================================

struct DataMatrix {
    // Flat storage: data[obs * n_vars + var]
    data: [f64; 4096],
    n_obs: i64,
    n_vars: i64,
}

fn data_matrix_new(n_obs: i64, n_vars: i64) -> DataMatrix {
    DataMatrix {
        data: [0.0; 4096],
        n_obs: n_obs,
        n_vars: n_vars,
    }
}

fn data_matrix_set(dm: &!DataMatrix, obs: i64, v: i64, val: f64) {
    let idx = obs * dm.n_vars + v
    if idx >= 0 && idx < 4096 {
        dm.data[idx] = val
    }
}

fn data_matrix_get(dm: &DataMatrix, obs: i64, v: i64) -> f64 {
    let idx = obs * dm.n_vars + v
    if idx >= 0 && idx < 4096 { dm.data[idx] } else { 0.0 }
}

// Compute mean of variable v
fn data_mean(dm: &DataMatrix, v: i64) -> f64 with Mut, Div, Panic {
    var sum = 0.0
    var i = 0
    while i < dm.n_obs {
        sum = sum + data_matrix_get(dm, i, v)
        i = i + 1
    }
    sum / (dm.n_obs as f64)
}

// Compute covariance between variables a and b
fn data_cov(dm: &DataMatrix, a: i64, b: i64) -> f64 with Mut, Div, Panic {
    let ma = data_mean(dm, a)
    let mb = data_mean(dm, b)
    var sum = 0.0
    var i = 0
    while i < dm.n_obs {
        let da = data_matrix_get(dm, i, a) - ma
        let db = data_matrix_get(dm, i, b) - mb
        sum = sum + da * db
        i = i + 1
    }
    sum / ((dm.n_obs - 1) as f64)
}

// Compute correlation between variables a and b
fn data_cor(dm: &DataMatrix, a: i64, b: i64) -> f64 with Mut, Div, Panic {
    let cov_ab = data_cov(dm, a, b)
    let var_a = data_cov(dm, a, a)
    let var_b = data_cov(dm, b, b)
    let denom = disc_sqrt(var_a * var_b)
    if denom < 1.0e-15 { return 0.0 }
    cov_ab / denom
}

// ============================================================================
// Correlation Matrix (max 32x32)
// ============================================================================

struct CorMatrix {
    vals: [f64; 1024],
    n: i64,
}

fn cor_matrix_from_data(dm: &DataMatrix) -> CorMatrix with Mut, Div, Panic {
    var cm = CorMatrix { vals: [0.0; 1024], n: dm.n_vars }
    var i = 0
    while i < dm.n_vars {
        var j = 0
        while j < dm.n_vars {
            cm.vals[i * dm.n_vars + j] = data_cor(dm, i, j)
            j = j + 1
        }
        i = i + 1
    }
    cm
}

fn cor_get(cm: &CorMatrix, i: i64, j: i64) -> f64 {
    cm.vals[i * cm.n + j]
}

// ============================================================================
// Causal Graph: adjacency matrix (max 32 variables)
// ============================================================================

// Edge types as i64
fn EDGE_NONE() -> i64 { 0 }
fn EDGE_UNDIRECTED() -> i64 { 1 }
fn EDGE_DIRECTED() -> i64 { 2 }

struct CausalGraph {
    // adj[i * 32 + j] = edge type from i to j
    adj: [i64; 1024],
    // confidence[i * 32 + j] = confidence of edge existence [0,1]
    confidence: [f64; 1024],
    // p_values[i * 32 + j] = p-value of independence test
    p_values: [f64; 1024],
    n_vars: i64,
}

fn causal_graph_new(n_vars: i64) -> CausalGraph with Mut, Div, Panic {
    // Start fully connected (undirected)
    var g = CausalGraph {
        adj: [0; 1024],
        confidence: [0.0; 1024],
        p_values: [1.0; 1024],
        n_vars: n_vars,
    }
    var i = 0
    while i < n_vars {
        var j = 0
        while j < n_vars {
            if i != j {
                g.adj[i * 32 + j] = EDGE_UNDIRECTED()
                g.confidence[i * 32 + j] = 0.5
            }
            j = j + 1
        }
        i = i + 1
    }
    g
}

fn graph_has_edge(g: &CausalGraph, i: i64, j: i64) -> bool {
    g.adj[i * 32 + j] != EDGE_NONE()
}

fn graph_remove_edge(g: &!CausalGraph, i: i64, j: i64) {
    g.adj[i * 32 + j] = EDGE_NONE()
    g.adj[j * 32 + i] = EDGE_NONE()
    g.confidence[i * 32 + j] = 0.0
    g.confidence[j * 32 + i] = 0.0
}

fn graph_orient_edge(g: &!CausalGraph, from: i64, to: i64) {
    g.adj[from * 32 + to] = EDGE_DIRECTED()
    g.adj[to * 32 + from] = EDGE_NONE()
}

// ============================================================================
// Fisher-Z Conditional Independence Test
// ============================================================================

// Fisher-Z test: test independence of X and Y given conditioning set is empty
// Returns p-value approximation
fn fisher_z_test_unconditional(
    r: f64,
    n: i64
) -> f64 with Mut, Div, Panic {
    if disc_abs(r) > 0.9999 { return 0.0 }
    let z = 0.5 * disc_ln((1.0 + r) / (1.0 - r))
    let se = 1.0 / disc_sqrt((n - 3) as f64)
    let stat = disc_abs(z) / se
    // Approximate p-value from normal CDF tail
    // Using simple approximation: p ~ exp(-0.5 * stat^2) / stat for large stat
    if stat < 0.1 { return 1.0 }
    if stat > 6.0 { return 0.0 }
    // Rough normal tail approximation
    let t = stat
    let p = 2.0 * (0.5 - 0.5 * (1.0 - disc_sqrt(1.0 - (0.0 - (t * t / 2.0)) + 0.5)))
    // Very rough: just use exp approximation
    var exp_approx = 1.0
    let x = 0.0 - 0.5 * t * t
    // Taylor: e^x ~ 1 + x + x^2/2 + x^3/6 + x^4/24
    exp_approx = 1.0 + x + x * x * 0.5 + x * x * x / 6.0 + x * x * x * x / 24.0
    if exp_approx < 0.0 { exp_approx = 0.0 }
    exp_approx
}

// ============================================================================
// PC Algorithm (simplified skeleton)
// ============================================================================

// PC algorithm step 0: remove edges where unconditional independence holds
fn pc_step0(
    g: &!CausalGraph,
    cm: &CorMatrix,
    n_obs: i64,
    alpha: f64
) with Mut, Div, Panic {
    var i = 0
    while i < g.n_vars {
        var j = i + 1
        while j < g.n_vars {
            let r = cor_get(cm, i, j)
            let p = fisher_z_test_unconditional(r, n_obs)
            g.p_values[i * 32 + j] = p
            g.p_values[j * 32 + i] = p
            if p > alpha {
                graph_remove_edge(g, i, j)
            }
            j = j + 1
        }
        i = i + 1
    }
}

// Count edges in the graph
fn graph_edge_count(g: &CausalGraph) -> i64 with Mut, Div, Panic {
    var count = 0
    var i = 0
    while i < g.n_vars {
        var j = i + 1
        while j < g.n_vars {
            if graph_has_edge(g, i, j) { count = count + 1 }
            j = j + 1
        }
        i = i + 1
    }
    count
}

// Compute structural confidence: fraction of tested edges that survived
fn graph_structural_confidence(g: &CausalGraph) -> f64 with Mut, Div, Panic {
    let n = g.n_vars
    let max_edges = (n * (n - 1)) / 2
    if max_edges == 0 { return 1.0 }
    let surviving = graph_edge_count(g)
    (surviving as f64) / (max_edges as f64)
}

// Run simplified PC algorithm on data
fn pc_discover(dm: &DataMatrix, alpha: f64) -> CausalGraph with Mut, Div, Panic {
    let cm = cor_matrix_from_data(dm)
    var g = causal_graph_new(dm.n_vars)
    pc_step0(&!g, &cm, dm.n_obs, alpha)
    g
}
