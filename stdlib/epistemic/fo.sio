//@ run-pass
//@ expect-stdout: ALL PASS

// stdlib/epistemic/fo.sio — First-order GUM / FO helpers for Madaros science code
//
// The FO engine is compiler-injected:
//   variance_of(expr), uncertainty_of(expr), second_order_mean(expr),
//   hessian_diag_of(expr), correlate(a, b, rho)
//
// These builtins walk the *expression AST* for multi-channel FO. Wrapping them
// as `fn wrap(x: f64) { variance_of(x) }` would only see the parameter and
// destroy FO structure — so they are NOT re-exported as ordinary functions.
//
// This module provides:
//   1. Pure helpers with FO-transferable bodies (interproc FO / nested expand)
//   2. Documentation of the preferred peel + measure style
//
// USAGE: `use epistemic::fo::*`
// Prefer peel: `let x = k.value; variance_of(x * y)` or Knowledge ops:
// `variance_of((kA * kB).value)`.
//
// Madaros FO stack (measured 2026-07-27): multi-channel, interproc unary/nested,
// Knowledge⊗Knowledge, multi-pass reverse-order, correlate + off-diag H.

// ── PK-style pure helpers (FO-transfer when callees registered / multipass) ──

/// Oral infusion rate F·Dose/τ (arithmetic FO).
pub fn fo_infusion_rate(f: f64, dose: f64, tau: f64) -> f64 {
    (f * dose) / tau
}

/// Clearance CL0·exp(η) — interproc FO through exp (unary bytecode).
pub fn fo_clearance(cl0: f64, eta: f64) -> f64 {
    cl0 * exp(eta)
}

/// Steady-state Css = rate / CL via nested pure helpers.
pub fn fo_css(f: f64, dose: f64, tau: f64, cl0: f64, eta: f64) -> f64 {
    fo_infusion_rate(f, dose, tau) / fo_clearance(cl0, eta)
}

/// Oral AUC = F·Dose/CL (single-dose / total exposure FO).
pub fn fo_auc(f: f64, dose: f64, cl0: f64, eta: f64) -> f64 {
    (f * dose) / fo_clearance(cl0, eta)
}

/// Volume of distribution V0·exp(η).
pub fn fo_volume(v0: f64, eta: f64) -> f64 {
    v0 * exp(eta)
}

/// Elimination rate kel = CL/V (shared η cancels when eta_cl = eta_v).
pub fn fo_kel(cl0: f64, v0: f64, eta: f64) -> f64 {
    fo_clearance(cl0, eta) / fo_volume(v0, eta)
}

/// Half-life t½ = ln(2)/kel (FO after shared-η cancel uses CL0, V0 only).
pub fn fo_thalf(cl0: f64, v0: f64, eta: f64) -> f64 {
    0.6931471805599453 / fo_kel(cl0, v0, eta)
}

/// Residual fraction after interval τ: exp(-kel·τ) (shared η cancels in kel).
pub fn fo_frac_rem(cl0: f64, v0: f64, tau: f64, eta: f64) -> f64 {
    exp(0.0 - fo_kel(cl0, v0, eta) * tau)
}

/// Accumulation ratio Rac = 1/(1 - exp(-kel·τ)).
pub fn fo_rac(cl0: f64, v0: f64, tau: f64, eta: f64) -> f64 {
    1.0 / (1.0 - fo_frac_rem(cl0, v0, tau, eta))
}

/// Multi-dose peak Css: Cmax_ss = (F·Dose/V)·Rac.
pub fn fo_cmax(f: f64, dose: f64, cl0: f64, v0: f64, tau: f64, eta: f64) -> f64 {
    (f * dose) / fo_volume(v0, eta) * fo_rac(cl0, v0, tau, eta)
}

/// Multi-dose trough Css: Cmin_ss = (F·Dose/V)·f_rem/(1-f_rem).
pub fn fo_cmin(f: f64, dose: f64, cl0: f64, v0: f64, tau: f64, eta: f64) -> f64 {
    let frem = fo_frac_rem(cl0, v0, tau, eta)
    (f * dose) / fo_volume(v0, eta) * (frem / (1.0 - frem))
}

/// Peak–trough fluctuation index (Cmax−Cmin)/Css_avg = kel·τ (shared η cancels).
pub fn fo_ptf(cl0: f64, v0: f64, tau: f64, eta: f64) -> f64 {
    fo_kel(cl0, v0, eta) * tau
}

/// Linear scale c·x (FO identity-scaled).
pub fn fo_scale(x: f64, c: f64) -> f64 {
    c * x
}

/// Sum of two peeled seeds (FO add).
pub fn fo_add2(a: f64, b: f64) -> f64 {
    a + b
}

/// Product of two peeled seeds (FO mul / Hessian).
pub fn fo_mul2(a: f64, b: f64) -> f64 {
    a * b
}

/// Quotient of two peeled seeds (FO div / off-diag Hessian).
pub fn fo_div2(a: f64, b: f64) -> f64 {
    a / b
}

// ── Selftest (stdlib style; peels + builtins, not imports of builtins as fns) ──

fn fo_mod_abs(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

pub fn main() with IO, Mut, Div, Epistemic {
    let kF: Knowledge<f64> = measure(0.8, uncertainty: 0.05)
    let kDose: Knowledge<f64> = measure(500.0, uncertainty: 10.0)
    let kTau: Knowledge<f64> = measure(12.0, uncertainty: 0.0)
    let kCL0: Knowledge<f64> = measure(5.0, uncertainty: 0.3)
    let kEta: Knowledge<f64> = measure(0.0, uncertainty: 0.1)
    let f = kF.value
    let dose = kDose.value
    let tau = kTau.value
    let cl0 = kCL0.value
    let eta = kEta.value

    let kV0: Knowledge<f64> = measure(50.0, uncertainty: 2.0)
    let v0 = kV0.value

    let v_css = variance_of(fo_css(f, dose, tau, cl0, eta))
    let v_site = variance_of(fo_infusion_rate(f, dose, tau) / fo_clearance(cl0, eta))
    let v_auc = variance_of(fo_auc(f, dose, cl0, eta))
    let v_auc_site = variance_of((f * dose) / fo_clearance(cl0, eta))
    let v_thalf = variance_of(fo_thalf(cl0, v0, eta))
    let v_thalf_peel = variance_of(0.6931471805599453 * v0 / cl0)
    let v_rac = variance_of(fo_rac(cl0, v0, tau, eta))
    let v_rac_peel = variance_of(1.0 / (1.0 - exp(0.0 - (cl0 / v0) * tau)))
    let v_ptf = variance_of(fo_ptf(cl0, v0, tau, eta))
    let v_ptf_peel = variance_of((cl0 / v0) * tau)
    let ok = fo_mod_abs(v_css - v_site) < 1.0e-9 && v_css > 0.1
        && fo_mod_abs(v_auc - v_auc_site) < 1.0e-9 && v_auc > 1.0
        && fo_mod_abs(v_thalf - v_thalf_peel) < 1.0e-9 && v_thalf > 0.01
        && fo_mod_abs(v_rac - v_rac_peel) < 1.0e-9 && v_rac > 0.0
        && fo_mod_abs(v_ptf - v_ptf_peel) < 1.0e-9 && v_ptf > 0.001
    if ok {
        print("ALL PASS\n")
    } else {
        print("FAIL\n")
    }
}
