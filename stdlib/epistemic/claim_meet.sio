// stdlib/epistemic/claim_meet.sio
//
// Two models of one quantity, each a mean and a variance.
// The shared interval is the overlap of the two mean +/- sigma bars.
// The excess is the width claimed by exactly one model.
// This is arithmetic on moments the caller already read. It does not
// call variance_of: wrapping that builtin would drop the channels.

pub struct ClaimMeet {
    pub lo: f64
    pub hi: f64
    pub shared: bool
    pub excess: f64
}

pub fn claim_sqrt(x: f64) -> f64 with Mut, Div {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 40 {
        y = 0.5 * (y + x / y)
        i = i + 1
    }
    y
}

pub fn claim_meet(mean_a: f64, var_a: f64, mean_b: f64, var_b: f64) -> ClaimMeet with Mut, Div {
    let sa = claim_sqrt(var_a)
    let sb = claim_sqrt(var_b)
    let lo_a = mean_a - sa
    let hi_a = mean_a + sa
    let lo_b = mean_b - sb
    let hi_b = mean_b + sb
    var lo = lo_a
    if lo_b > lo { lo = lo_b }
    var hi = hi_a
    if hi_b < hi { hi = hi_b }
    let shared = lo <= hi
    var shared_w = 0.0
    if shared { shared_w = hi - lo }
    let excess = (hi_a - lo_a) + (hi_b - lo_b) - 2.0 * shared_w
    ClaimMeet { lo: lo, hi: hi, shared: shared, excess: excess }
}

// The shared band is not a licence to read either centre.
// BothInside keeps both witnesses and yields no single centre.
// OnlyA and OnlyB yield the one centre the band still contains.
// NeitherInside is a band with no centre in it.
// ReviseModel is an empty overlap: there is no band and no centre.

pub enum CentreSeat {
    BothInside,
    OnlyA,
    OnlyB,
    NeitherInside,
    ReviseModel,
}

pub struct HeldCentre {
    pub held: bool
    pub centre: f64
}

pub fn centre_seat(
    lo_a: f64, hi_a: f64, centre_a: f64,
    lo_b: f64, hi_b: f64, centre_b: f64,
) -> CentreSeat with Mut {
    var lo = lo_a
    if lo_b > lo { lo = lo_b }
    var hi = hi_a
    if hi_b < hi { hi = hi_b }
    if lo > hi { return CentreSeat::ReviseModel }
    let a_in = centre_a >= lo && centre_a <= hi
    let b_in = centre_b >= lo && centre_b <= hi
    if a_in && b_in { return CentreSeat::BothInside }
    if a_in { return CentreSeat::OnlyA }
    if b_in { return CentreSeat::OnlyB }
    CentreSeat::NeitherInside
}

pub fn seat_code(seat: CentreSeat) -> i64 {
    match seat {
        CentreSeat::BothInside => 0
        CentreSeat::OnlyA => 1
        CentreSeat::OnlyB => 2
        CentreSeat::NeitherInside => 3
        CentreSeat::ReviseModel => 4
    }
}

pub fn held_centre(seat: CentreSeat, centre_a: f64, centre_b: f64) -> HeldCentre {
    let code = seat_code(seat)
    if code == 1 { return HeldCentre { held: true, centre: centre_a } }
    if code == 2 { return HeldCentre { held: true, centre: centre_b } }
    HeldCentre { held: false, centre: 0.0 }
}
