// Seed content for zero-provenance claims in the Falsification Ledger.
// One claim per zero-event category from stdlib/epistemic/zero_event.sio.

// @claim zero_absent_no_effect
// @hypothesis a zero surface value can mean absence of effect
// @falsifier a claim that absence is the only possible provenance of zero
// @evidence instrument_controlled
// @harness stdlib/epistemic/zero_event.sio
// @gate scripts/ci/zero_event_gate.sh
// @verdict alive
// @provenance absent

// @claim zero_cancelled_opposite_effects
// @hypothesis a zero surface value can arise from cancellation of opposite nonzero effects
// @falsifier a nonzero sum of asserted opposite effects
// @evidence instrument_controlled
// @harness stdlib/epistemic/zero_event.sio
// @gate scripts/ci/zero_event_gate.sh
// @verdict alive
// @provenance cancelled

// @claim zero_annihilated_nonzero_factors
// @hypothesis the sedenions contain nonzero zero-divisor pairs (a,b) with ab = 0 exactly
// @falsifier every pair of nonzero sedenions has nonzero product
// @evidence instrument_controlled
// @harness stdlib/epistemic/zero_event.sio
// @gate scripts/ci/zero_event_gate.sh
// @verdict alive
// @provenance annihilated

// @claim zero_below_resolution_latent
// @hypothesis a zero surface value can arise from a latent value below measurement resolution
// @falsifier a latent value above resolution that is rounded to zero
// @evidence instrument_controlled
// @harness stdlib/epistemic/zero_event.sio
// @gate scripts/ci/zero_event_gate.sh
// @verdict alive
// @provenance below_resolution

// @claim zero_rounded_correction_trail
// @hypothesis a zero surface value can arise from a nonzero correction trail whose f64 lane rounds to zero
// @falsifier a rounded-to-zero value with zero correction trail
// @evidence instrument_controlled
// @harness stdlib/epistemic/zero_event.sio
// @gate scripts/ci/zero_event_gate.sh
// @verdict alive
// @provenance rounded

// @claim zero_gated_original_nonzero
// @hypothesis a zero surface value can arise from gating an original nonzero value
// @falsifier a gated zero that was originally zero
// @evidence instrument_controlled
// @harness stdlib/epistemic/zero_event.sio
// @gate scripts/ci/zero_event_gate.sh
// @verdict alive
// @provenance gated

// @claim zero_unknown_provenance
// @hypothesis a zero surface value can have unknown provenance
// @falsifier a forced assignment of provenance to every observed zero
// @evidence instrument_controlled
// @harness stdlib/epistemic/zero_event.sio
// @gate scripts/ci/zero_event_gate.sh
// @verdict alive
// @provenance unknown
