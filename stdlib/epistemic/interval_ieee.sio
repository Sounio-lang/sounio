//! Interval Arithmetic Semantics in the style of IEEE 1788-2015
//!
//! This module follows the SHAPE of IEEE 1788 (empty/entire intervals,
//! decorations, defined division by zero-spanning intervals) but is NOT a
//! conforming IEEE 1788 implementation, for two stated reasons:
//!   1. Outward rounding is done with the predecessor/successor push of
//!      epistemic::sound_enclosure (se_down/se_up — Rump–Zimmermann–Boldo–
//!      Melquiond 2009), not with hardware directed roundings, which Sounio
//!      does not expose. Every computed endpoint is pushed strictly outward.
//!   2. Transcendental functions are absent: libm exp/log are not correctly
//!      rounded, so enclosing with them would be a lie (cf.
//!      epistemic::sound_enclosure's stated scope). Only sqrt is provided,
//!      because IEEE 754 mandates a correctly rounded sqrt, and even that
//!      endpoint is pushed outward.
//!
//! "Entire" really is [-inf, +inf]: Sounio f64 has infinities (finite range
//! extends to ~1.8e308; 1.0e308 * 10.0 overflows to +inf), and the old
//! ±1e308 sentinel did NOT contain them. The entire interval reuses
//! epistemic::sound_enclosure::se_entire — the same construction, not a copy
//! (lie corpus item 1d).
//!
//! Key concepts (IEEE 1788-flavoured, with the deviations above):
//!   - Empty interval: {} (result of impossible constraints)
//!   - Entire interval: [-inf, +inf] (maximum ignorance)
//!   - Exception handling for division by interval spanning zero
//!   - Decorations for tracking validity
//!
//! References:
//!   - IEEE 1788-2015: "Standard for Interval Arithmetic" (NOT fully
//!     implemented; deviations are the three points above)
//!   - IEEE 1788.1-2017: "Simplified subset (Level 1)"
//!   - Rump, Zimmermann, Boldo, Melquiond — "Computing predecessor and
//!     successor in rounding to nearest", BIT 49 (2009) 419-431

// Outward rounding and the entire interval reuse epistemic::sound_enclosure
// (se_down/se_up/se_entire/se_lo/se_hi) — the same constructions, not
// copies (lie corpus item 1d).
use epistemic::sound_enclosure::{se_down, se_up, se_entire, se_lo, se_hi}

// Only sqrt is imported: IEEE 754 mandates a correctly rounded sqrt, so with
// an outward push its enclosure is rigorous. exp/log are deliberately NOT
// imported (libm does not correctly round them; enclosing with them would be
// a lie — lie corpus item 1d).
extern "C" {
    fn sqrt(x: f64) -> f64;
}

fn sqrt_f64(x: f64) -> f64 {
    if x < 0.0 { return 0.0 }
    return sqrt(x)
}

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn min_f64(a: f64, b: f64) -> f64 {
    if a < b { a } else { b }
}

fn max_f64(a: f64, b: f64) -> f64 {
    if a > b { a } else { b }
}

// ============================================================================
// IEEE 1788 INTERVAL REPRESENTATION
// ============================================================================

// IEEE 1788 bare interval [a, b]
// Special cases:
//   - Empty: is_empty = true
//   - Entire: lo = -inf, hi = +inf
//   - Point: lo == hi
pub struct Interval {
    lo: f64,
    hi: f64,
    is_empty: bool,
}

pub fn interval_empty() -> Interval {
    return Interval {
        lo: 0.0,
        hi: 0.0,
        is_empty: true,
    }
}

// Entire interval [-inf, +inf] via se_entire (1.0e308 * 10.0 overflows to
// +inf); reused, not copied. The old ±1e308 sentinel did not contain finite
// values above 1e308 or infinities, so it was not "entire" (item 1d).
pub fn interval_entire() -> Interval {
    let e = se_entire()
    return Interval {
        lo: se_lo(e),
        hi: se_hi(e),
        is_empty: false,
    }
}

// ±inf for the half-bounded division branches, via se_entire (reused).
fn ieee_neg_inf() -> f64 {
    return se_lo(se_entire())
}

fn ieee_pos_inf() -> f64 {
    return se_hi(se_entire())
}

pub fn interval_new(lo: f64, hi: f64) -> Interval {
    if lo > hi {
        // Invalid bounds -> empty
        return interval_empty()
    }
    return Interval {
        lo: lo,
        hi: hi,
        is_empty: false,
    }
}

pub fn interval_point(x: f64) -> Interval {
    return Interval {
        lo: x,
        hi: x,
        is_empty: false,
    }
}

// Computed bounds: pushed outward like every other computed value here.
fn interval_symmetric(center: f64, half_width: f64) -> Interval with Panic {
    return interval_new(se_down(center - half_width), se_up(center + half_width))
}

// ============================================================================
// IEEE 1788 DECORATIONS
// ============================================================================

// Decorations track interval validity through computations
// Per IEEE 1788 Section 9
// 0 = ill (undefined/invalid)
// 1 = trv (trivial - could be any value)
// 2 = def (defined but possibly unbounded)
// 3 = dac (defined and continuous)
// 4 = com (common - bounded and continuous)
struct Decoration {
    value: i32,
}

fn dec_ill() -> Decoration { return Decoration { value: 0 } }  // Invalid
fn dec_trv() -> Decoration { return Decoration { value: 1 } }  // Trivial
fn dec_def() -> Decoration { return Decoration { value: 2 } }  // Defined
fn dec_dac() -> Decoration { return Decoration { value: 3 } }  // DAC
fn dec_com() -> Decoration { return Decoration { value: 4 } }  // Common

// Decorated interval: interval + decoration
pub struct DecoratedInterval {
    interval: Interval,
    decoration: Decoration,
}

fn decorated_new(interval: Interval, dec: Decoration) -> DecoratedInterval {
    return DecoratedInterval {
        interval: interval,
        decoration: dec,
    }
}

fn decorated_common(lo: f64, hi: f64) -> DecoratedInterval {
    let interval = interval_new(lo, hi)
    if interval.is_empty {
        return DecoratedInterval { interval: interval, decoration: dec_ill() }
    }
    return DecoratedInterval { interval: interval, decoration: dec_com() }
}

// Combine decorations (take minimum)
fn dec_combine(a: Decoration, b: Decoration) -> Decoration {
    if a.value < b.value {
        return a
    }
    return b
}

// ============================================================================
// IEEE 1788 BASIC OPERATIONS
// ============================================================================

// Addition: [a, b] + [c, d] = [a+c, b+d], endpoints pushed strictly outward
// (a round-to-nearest endpoint alone excludes the true sum on a bad rounding).
pub fn interval_add(x: Interval, y: Interval) -> Interval with Panic {
    if x.is_empty || y.is_empty {
        return interval_empty()
    }
    return interval_new(se_down(x.lo + y.lo), se_up(x.hi + y.hi))
}

// Subtraction: [a, b] - [c, d] = [a-d, b-c], endpoints pushed outward.
pub fn interval_sub(x: Interval, y: Interval) -> Interval with Panic {
    if x.is_empty || y.is_empty {
        return interval_empty()
    }
    return interval_new(se_down(x.lo - y.hi), se_up(x.hi - y.lo))
}

// Multiplication: [a, b] × [c, d], min/max of round-to-nearest products
// pushed once outward each end (same argument as verify::interval iv_mul).
pub fn interval_mul(x: Interval, y: Interval) -> Interval with Panic {
    if x.is_empty || y.is_empty {
        return interval_empty()
    }

    // All four products
    let p1 = x.lo * y.lo
    let p2 = x.lo * y.hi
    let p3 = x.hi * y.lo
    let p4 = x.hi * y.hi

    let lo = se_down(min_f64(min_f64(p1, p2), min_f64(p3, p4)))
    let hi = se_up(max_f64(max_f64(p1, p2), max_f64(p3, p4)))

    return interval_new(lo, hi)
}

// ============================================================================
// IEEE 1788 DIVISION: THE CRITICAL OPERATION
// ============================================================================

// Division result with exception handling
pub struct DivisionResult {
    result: Interval,
    exception: i32,    // 0=none, 1=div_by_zero, 2=entire_result
    decoration: Decoration,
}

// Division: [a, b] / [c, d]
// Per IEEE 1788, division by interval containing zero is well-defined
// but requires careful handling:
//   - If 0 ∈ [c, d]: result may be unbounded or split
//   - If [c, d] = [0, 0]: result is empty (not infinity!)
// All computed endpoints below are pushed strictly outward (item 1d); the
// ±1e308 ends are exact finite sentinels, not computed values.
pub fn interval_div(x: Interval, y: Interval) -> DivisionResult with Panic {
    if x.is_empty || y.is_empty {
        return DivisionResult {
            result: interval_empty(),
            exception: 0,
            decoration: dec_ill(),
        }
    }

    // Check if y contains zero
    let y_contains_zero = y.lo <= 0.0 && y.hi >= 0.0

    if y_contains_zero {
        // Special cases per IEEE 1788
        if y.lo == 0.0 && y.hi == 0.0 {
            // [c, d] = [0, 0]: division by zero interval -> empty
            return DivisionResult {
                result: interval_empty(),
                exception: 1,  // Division by zero
                decoration: dec_ill(),
            }
        }

        if y.lo == 0.0 {
            // [0, d] with d > 0: result is [a/d, +inf]
            if x.lo >= 0.0 {
                return DivisionResult {
                    result: interval_new(se_down(x.lo / y.hi), ieee_pos_inf()),
                    exception: 2,  // Entire result
                    decoration: dec_def(),
                }
            } else if x.hi <= 0.0 {
                return DivisionResult {
                    result: interval_new(ieee_neg_inf(), se_up(x.hi / y.hi)),
                    exception: 2,
                    decoration: dec_def(),
                }
            }
        }

        if y.hi == 0.0 {
            // [c, 0] with c < 0: result is [-inf, a/c]
            if x.lo >= 0.0 {
                return DivisionResult {
                    result: interval_new(ieee_neg_inf(), se_up(x.lo / y.lo)),
                    exception: 2,
                    decoration: dec_def(),
                }
            } else if x.hi <= 0.0 {
                return DivisionResult {
                    result: interval_new(se_down(x.hi / y.lo), ieee_pos_inf()),
                    exception: 2,
                    decoration: dec_def(),
                }
            }
        }

        // General case: 0 strictly inside [c, d]
        // Result is entire (two disconnected pieces reunited; finite entire)
        return DivisionResult {
            result: interval_entire(),
            exception: 2,
            decoration: dec_trv(),
        }
    }

    // Normal division: 0 ∉ [c, d]
    // [a, b] / [c, d] = [a, b] × [1/d, 1/c], reciprocal pushed outward first
    // (for y strictly positive or strictly negative, 1/y.hi <= 1/y.lo).
    let inv_lo = se_down(1.0 / y.hi)
    let inv_hi = se_up(1.0 / y.lo)

    let p1 = x.lo * inv_lo
    let p2 = x.lo * inv_hi
    let p3 = x.hi * inv_lo
    let p4 = x.hi * inv_hi

    let lo = se_down(min_f64(min_f64(p1, p2), min_f64(p3, p4)))
    let hi = se_up(max_f64(max_f64(p1, p2), max_f64(p3, p4)))

    return DivisionResult {
        result: interval_new(lo, hi),
        exception: 0,
        decoration: dec_com(),
    }
}

// ============================================================================
// IEEE 1788 ELEMENTARY FUNCTIONS
// ============================================================================

// Square root: sqrt([a, b]).
// IEEE 754 mandates a correctly rounded sqrt, so RN(sqrt) is within half an
// ulp of the true root; the outward push moves at least a full ulp, keeping
// containment. (Without the push, sqrt's half-ulp error would already be a
// lie — item 1d.)
pub fn interval_sqrt(x: Interval) -> DecoratedInterval with Panic {
    if x.is_empty {
        return decorated_new(interval_empty(), dec_ill())
    }

    if x.hi < 0.0 {
        // Entirely negative -> empty (no real square root)
        return decorated_new(interval_empty(), dec_ill())
    }

    let lo = max_f64(0.0, x.lo)
    return decorated_new(
        interval_new(se_down(sqrt_f64(lo)), se_up(sqrt_f64(x.hi))),
        if x.lo >= 0.0 { dec_com() } else { dec_def() }
    )
}

// NOTE (lie corpus item 1d): interval_exp and interval_log were REMOVED from
// this module. libm exp/log are not correctly rounded (typical error 1-2
// ulp with no stated bound), so no fixed push can enclose them, and this
// module states no per-function ulp bound it could cite. Exponentials
// enclosed with an explicit Taylor tail live with the PBPK gate (cf.
// epistemic::sound_enclosure's stated scope). Reintroduce them here only
// with a stated, cited ulp bound and a push that covers it.

// ============================================================================
// IEEE 1788 SET OPERATIONS
// ============================================================================

// Intersection: [a, b] ∩ [c, d]
fn interval_intersect(x: Interval, y: Interval) -> Interval {
    if x.is_empty || y.is_empty {
        return interval_empty()
    }

    let lo = max_f64(x.lo, y.lo)
    let hi = min_f64(x.hi, y.hi)

    if lo > hi {
        return interval_empty()
    }
    return interval_new(lo, hi)
}

// Hull (convex union): hull([a, b], [c, d])
fn interval_hull(x: Interval, y: Interval) -> Interval {
    if x.is_empty { return y }
    if y.is_empty { return x }

    return interval_new(
        min_f64(x.lo, y.lo),
        max_f64(x.hi, y.hi)
    )
}

// ============================================================================
// IEEE 1788 COMPARISONS
// ============================================================================

// Check if interval is subset of another
pub fn interval_subset(x: Interval, y: Interval) -> bool {
    if x.is_empty { return true }  // Empty is subset of everything
    if y.is_empty { return false } // Non-empty not subset of empty

    return x.lo >= y.lo && x.hi <= y.hi
}

// Check if intervals overlap
fn interval_overlaps(x: Interval, y: Interval) -> bool {
    if x.is_empty || y.is_empty { return false }

    return x.lo <= y.hi && y.lo <= x.hi
}

// Width of interval
pub fn interval_width(x: Interval) -> f64 {
    if x.is_empty { return 0.0 }
    return x.hi - x.lo
}

// Midpoint of interval
fn interval_mid(x: Interval) -> f64 {
    if x.is_empty { return 0.0 }
    return (x.lo + x.hi) / 2.0
}

// Radius of interval
fn interval_rad(x: Interval) -> f64 {
    if x.is_empty { return 0.0 }
    return (x.hi - x.lo) / 2.0
}

// ============================================================================
// IEEE 1788 EXCEPTION HANDLING
// ============================================================================

// Exception flags per IEEE 1788
struct IntervalException {
    undefined_operation: bool,   // e.g., sqrt of negative
    possibly_undefined: bool,    // e.g., sqrt of interval spanning 0
    division_by_zero: bool,
    overflow: bool,
}

fn exception_none() -> IntervalException {
    return IntervalException {
        undefined_operation: false,
        possibly_undefined: false,
        division_by_zero: false,
        overflow: false,
    }
}

fn exception_from_div(result: DivisionResult) -> IntervalException {
    return IntervalException {
        undefined_operation: result.exception == 1,
        possibly_undefined: result.exception == 2,
        division_by_zero: result.exception == 1,
        overflow: false,
    }
}

// ============================================================================
// TESTS
// ============================================================================

fn test_interval_add() -> bool with Panic {
    let a = interval_new(1.0, 2.0)
    let b = interval_new(3.0, 4.0)
    let c = interval_add(a, b)

    if abs_f64(c.lo - 4.0) > 0.001 { return false }
    if abs_f64(c.hi - 6.0) > 0.001 { return false }

    return true
}

fn test_interval_mul() -> bool with Panic {
    let a = interval_new(-2.0, 3.0)
    let b = interval_new(1.0, 2.0)
    let c = interval_mul(a, b)

    // Products: -2*1=-2, -2*2=-4, 3*1=3, 3*2=6
    // Min = -4, Max = 6
    if abs_f64(c.lo - (0.0 - 4.0)) > 0.001 { return false }
    if abs_f64(c.hi - 6.0) > 0.001 { return false }

    return true
}

fn test_interval_div_normal() -> bool with Panic {
    let a = interval_new(2.0, 4.0)
    let b = interval_new(1.0, 2.0)
    let result = interval_div(a, b)

    // [2,4] / [1,2] = [2/2, 4/1] = [1, 4]
    if result.exception != 0 { return false }
    if abs_f64(result.result.lo - 1.0) > 0.001 { return false }
    if abs_f64(result.result.hi - 4.0) > 0.001 { return false }

    return true
}

fn test_interval_div_by_zero() -> bool with Panic {
    let a = interval_new(1.0, 2.0)
    let b = interval_new(0.0, 0.0)
    let result = interval_div(a, b)

    // Division by [0,0] -> empty with exception
    if !result.result.is_empty { return false }
    if result.exception != 1 { return false }

    return true
}

fn test_interval_div_spanning_zero() -> bool with Panic {
    let a = interval_new(1.0, 2.0)
    let b = interval_new(-1.0, 1.0)  // Spans zero
    let result = interval_div(a, b)

    // Should be entire or have exception
    if result.exception != 2 { return false }

    return true
}

fn test_interval_sqrt() -> bool with Panic {
    let a = interval_new(4.0, 9.0)
    let result = interval_sqrt(a)

    if result.interval.is_empty { return false }
    if abs_f64(result.interval.lo - 2.0) > 0.001 { return false }
    if abs_f64(result.interval.hi - 3.0) > 0.001 { return false }

    // Negative interval -> empty
    let b = interval_new(-4.0, -1.0)
    let result2 = interval_sqrt(b)
    if !result2.interval.is_empty { return false }

    return true
}

fn test_decorated_operations() -> bool {
    let a = decorated_common(1.0, 2.0)
    let b = decorated_common(3.0, 4.0)

    if a.decoration.value != 4 { return false }  // com
    if b.decoration.value != 4 { return false }

    return true
}

// ============================================================================
// MAIN
