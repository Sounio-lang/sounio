//! Contest witness structs for disagreement and audit projections.
//!
//! These are ordinary named structs, not new type constructors. The compiler
//! lowers witness builtins such as `disagreement(c)` and `posterior_weights(c)`
//! into literals that target these shapes.

struct ContestDisagreement {
    contest_id: i64,
    family_id: i64,
    family_name: string,
    policy_id: i64,
    policy_name: string,
    sign_consensus: f64,
    relative_band: f64,
    max_tail_risk: f64,
    identifiability_floor: f64,
    mechanistic_divergence: f64,
    latent_state_divergence: f64,
    causal_decomposition_divergence: f64,
    intervention_response_divergence: f64,
    parameter_role_divergence: f64,
    structural_explanation_distance: f64,
    counterexample_id: i64,
    posterior_weights_id: i64,
}

struct ContestCounterexample {
    model_name: string,
    subgroup_name: string,
    metric_name: string,
    observed_value: f64,
    threshold_value: f64,
    summary: string,
}

struct ContestWeights {
    count: i64,
    model_names: [string; 16],
    weights: [f64; 16],
}
