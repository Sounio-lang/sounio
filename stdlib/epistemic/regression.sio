// stdlib/epistemic/regression.sio
//
// Straight-line fit y = a + b x, with the covariance of (a, b).
// The correlation of a van t Hoff pair is this object: it is fixed by the
// temperature window and the residual, and it is a runtime number.
// correlate() still demands a compile-time literal, so a fitted rho cannot
// be pushed back through that builtin. gum_var takes the covariance as data.

pub struct LineFit {
    pub intercept: f64
    pub slope: f64
    pub var_intercept: f64
    pub var_slope: f64
    pub cov: f64
    pub rho: f64
    pub s2: f64
    pub xbar: f64
    pub sxx: f64
    pub n: f64
}

pub fn reg_sqrt(x: f64) -> f64 with Mut, Div {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 40 {
        y = 0.5 * (y + x / y)
        i = i + 1
    }
    y
}

pub fn ols_line(xs: [f64; 8], ys: [f64; 8], n: i64) -> LineFit with Mut, Div {
    if n < 3 {
        return LineFit {
            intercept: 0.0, slope: 0.0, var_intercept: 0.0, var_slope: 0.0, cov: 0.0, rho: 0.0,
            s2: 0.0, xbar: 0.0, sxx: 0.0, n: 0.0
        }
    }
    let nf = n as f64
    var sx = 0.0
    var sy = 0.0
    var i: i64 = 0
    while i < n {
        sx = sx + xs[i as usize]
        sy = sy + ys[i as usize]
        i = i + 1
    }
    let xb = sx / nf
    let yb = sy / nf
    var sxx = 0.0
    var sxy = 0.0
    i = 0
    while i < n {
        let dx = xs[i as usize] - xb
        let dy = ys[i as usize] - yb
        sxx = sxx + dx * dx
        sxy = sxy + dx * dy
        i = i + 1
    }
    let slope = sxy / sxx
    let intercept = yb - slope * xb
    var sse = 0.0
    i = 0
    while i < n {
        let e = ys[i as usize] - intercept - slope * xs[i as usize]
        sse = sse + e * e
        i = i + 1
    }
    let s2 = sse / (nf - 2.0)
    let var_slope = s2 / sxx
    let var_intercept = s2 * (1.0 / nf + xb * xb / sxx)
    let cov = 0.0 - s2 * xb / sxx
    let rho = cov / reg_sqrt(var_intercept * var_slope)
    LineFit {
        intercept: intercept,
        slope: slope,
        var_intercept: var_intercept,
        var_slope: var_slope,
        cov: cov,
        rho: rho,
        s2: s2,
        xbar: xb,
        sxx: sxx,
        n: nf
    }
}

// Variance of the fitted line at x. Equals gum_var(1, x, var_intercept, var_slope, cov).
pub fn ols_mean_var(fit: LineFit, x: f64) -> f64 with Div {
    if fit.sxx <= 0.0 { return 0.0 }
    let d = x - fit.xbar
    fit.s2 * (1.0 / fit.n + d * d / fit.sxx)
}

// Variance of a new observation at x: the line, plus the residual already seen.
pub fn ols_predict_var(fit: LineFit, x: f64) -> f64 with Div {
    ols_mean_var(fit, x) + fit.s2
}

// Variance of s0*u + s1*v when Cov(u, v) = cov. Runtime covariance.
pub fn gum_var(s0: f64, s1: f64, v0: f64, v1: f64, cov: f64) -> f64 {
    s0 * s0 * v0 + s1 * s1 * v1 + 2.0 * s0 * s1 * cov
}

// Outside the temperatures that entered the fit, a centre is refused when
// the weighted residual sum of squares exceeds the 5% critical value of
// chi-square with 2 degrees of freedom. That critical value is -2 ln(0.05).
// Four plateau pressures and two parameters are that case. The band is
// not this function's business.
pub fn fit_centre_refused(chi_red: f64, df: f64, t_star: f64, t_min: f64, t_max: f64) -> bool {
    if t_star >= t_min && t_star <= t_max { return false }
    var crit = 0.0
    if df == 2.0 { crit = 0.0 - 2.0 * log(0.05) }
    if df == 3.0 { crit = 7.814727903251172 }
    if crit == 0.0 { return false }
    chi_red * df > crit
}

// What a plateau fit publishes. There is no centre field.
pub struct PlateauPressure {
    pub lo: f64
    pub hi: f64
    pub open: bool
    pub refused: bool
    pub chi: f64
}

fn higher_f(a: f64, b: f64) -> f64 {
    if b > a { return b }
    a
}

fn lower_f(a: f64, b: f64) -> f64 {
    if b < a { return b }
    a
}

// xs are 1/T, ys are ln(P/P°), uln are u(P)/P.
// The band is the overlap of the two log bands. If the weighted
// chi-square rejects the parentheses and t_star is outside the
// temperatures that were fitted, the result stays the band.
pub fn plateau_pressure(
    xs: [f64; 8],
    ys: [f64; 8],
    uln: [f64; 8],
    n: i64,
    x_star: f64,
    t_star: f64,
    t_min: f64,
    t_max: f64,
    p_std: f64,
) -> PlateauPressure with Mut, Div {
    let unw = ols_line(xs, ys, n)
    let pu = p_std * exp(unw.intercept + unw.slope * x_star)
    let uu = reg_sqrt(ols_mean_var(unw, x_star))
    var sw = 0.0
    var swx = 0.0
    var swy = 0.0
    var swxx = 0.0
    var swxy = 0.0
    var i: i64 = 0
    while i < n {
        let u = uln[i as usize]
        let w = 1.0 / (u * u)
        let x = xs[i as usize]
        let y = ys[i as usize]
        sw = sw + w
        swx = swx + w * x
        swy = swy + w * y
        swxx = swxx + w * x * x
        swxy = swxy + w * x * y
        i = i + 1
    }
    let dw = sw * swxx - swx * swx
    let aw = (swy * swxx - swx * swxy) / dw
    let bw = (sw * swxy - swx * swy) / dw
    var chi_num = 0.0
    i = 0
    while i < n {
        let e = ys[i as usize] - aw - bw * xs[i as usize]
        let u = uln[i as usize]
        let w = 1.0 / (u * u)
        chi_num = chi_num + w * e * e
        i = i + 1
    }
    let df = (n - 2) as f64
    let chi = chi_num / df
    let vaa = swxx / dw
    let vab = (0.0 - swx) / dw
    let vbb = sw / dw
    let v_known = vaa + 2.0 * x_star * vab + x_star * x_star * vbb
    let pw = p_std * exp(aw + bw * x_star)
    let uw = reg_sqrt(chi * v_known)
    let lo = higher_f(pu * exp(0.0 - uu), pw * exp(0.0 - uw))
    let hi = lower_f(pu * exp(uu), pw * exp(uw))
    let open = lo <= hi
    let refused = fit_centre_refused(chi, df, t_star, t_min, t_max)
    PlateauPressure { lo: lo, hi: hi, open: open, refused: refused, chi: chi }
}
