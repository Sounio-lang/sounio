pub fn declare_path_conditioned_finite_model(
    model_id: i64,
    context: IndividualContextReceipt,
    history_ab: OrderedHistoryABReceipt,
    history_ba: OrderedHistoryBAReceipt,
    collision: ProjectionCollisionReceipt,
    d7_refusal: D7CrossOccurrenceReuseRefusalReceipt,
) -> PathConditionedFiniteModelReceipt with Panic {
    assert(model_id == 12200)
    assert(context.context_id == 12150 && context.subject_id == 15001)
    assert(context.window_id == 15002 && context.instrument_id == 15003)
    assert(context.measurement_policy_id == 15004)
    assert(context.individual_context && !context.dyadic_context)
    assert(context.synthetic_context)
    validate_ab_history(history_ab)
    validate_ba_history(history_ba)
    assert(history_ab.history_fingerprint != history_ba.history_fingerprint)
    assert(collision.receipt_id == 11902 && collision.family_id == 12100)
    assert(collision.collision_mask == 7 && collision.compatible_state_count == 3)
    assert(collision.collision_audit_checksum == 369428683)
    assert(!collision.scalar_identifies_state)
    assert(d7_refusal.refusal_id == 11901 && d7_refusal.d7_decision_id == 10201)
    assert(d7_refusal.reason_mask == 3)
    assert(d7_refusal.refusal_audit_checksum == 2175470118)
    assert(d7_refusal.cross_occurrence_reuse_refused)
    assert(!d7_refusal.d8_rebracketing_performed)
    assert(!d7_refusal.path_order_substitution_authorized)
    assert(!d7_refusal.compiler_authority_issued)
    let checksum = ((((model_id * 31 + context.subject_id) * 31 +
        context.window_id) * 31 + context.instrument_id) * 31 +
        context.measurement_policy_id)
    assert(checksum == 11728748010)
    let model = PathConditionedFiniteModelReceipt {
        model_id: model_id,
        model_version: 1,
        protocol_id: 8800,
        family_id: 12100,
        subject_id: context.subject_id,
        window_id: context.window_id,
        instrument_id: context.instrument_id,
        measurement_policy_id: context.measurement_policy_id,
        universe_mask: 7,
        universe_count: 3,
        shared_scalar_projection: 877,
        ab_history_id: history_ab.history_id,
        ba_history_id: history_ba.history_id,
        d7_cross_occurrence_refusal_id: d7_refusal.refusal_id,
        assumption_set_id: 12210,
        model_audit_checksum: checksum,
        finite_family_exhaustively_enumerated: true,
        path_conditioning_enabled: true,
        histories_interchangeable: false,
        d7_cross_occurrence_reuse_refused: true,
        public_model_receipt: true,
        receipt_construction_sealed: false,
        empirical_adequacy_established: false,
        clinical_authority: false,
    }
    validate_model(model)
    model
}

