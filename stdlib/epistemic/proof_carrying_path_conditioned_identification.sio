pub fn witness_initial_exact_compatibility(
    receipt_id: i64,
    ab: ExactABIdentifiedSetReceipt,
    ba: ExactBAIdentifiedSetReceipt,
    common: D8LatentStateReceipt,
) -> WitnessedInitialCompatibilityReceipt with Panic {
    assert(receipt_id == 12701)
    validate_ab_set(ab)
    validate_ba_set(ba)
    validate_d8_state(common)
    assert(common.state_id == 12002 && common.state_code == 2)
    let intersection_mask = 2
    let checksum = (((ab.set_id * 31 + ba.set_id) * 31 +
        common.state_id) * 31 + intersection_mask)
    assert(checksum == 378653377)
    WitnessedInitialCompatibilityReceipt {
        receipt_id: receipt_id,
        ab_set_id: ab.set_id,
        ba_set_id: ba.set_id,
        common_state_id: common.state_id,
        exact_intersection_mask: intersection_mask,
        compatibility_audit_checksum: checksum,
        common_member_witnessed: true,
        exact_sets_overlap: true,
        guaranteed_separation: false,
    }
}

pub fn refuse_initial_exact_separation(
    refusal_id: i64,
    compatibility: WitnessedInitialCompatibilityReceipt,
) -> InitialSeparationRefusalReceipt with Panic {
    assert(refusal_id == 12702)
    assert(compatibility.receipt_id == 12701)
    assert(compatibility.exact_intersection_mask == 2)
    assert(compatibility.compatibility_audit_checksum == 378653377)
    assert(compatibility.common_member_witnessed && compatibility.exact_sets_overlap)
    assert(!compatibility.guaranteed_separation)
    let reason_mask = 1 + 2
    let checksum = compatibility.compatibility_audit_checksum * 7 + reason_mask
    assert(reason_mask == 3 && checksum == 2650573642)
    InitialSeparationRefusalReceipt {
        refusal_id: refusal_id,
        compatibility_receipt_id: compatibility.receipt_id,
        reason_mask: reason_mask,
        refusal_audit_checksum: checksum,
        nonempty_intersection_observed: true,
        common_member_witnessed: true,
        guaranteed_separation_issued: false,
    }
}

