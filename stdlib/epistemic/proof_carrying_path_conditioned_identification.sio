) -> ExactSeparationReceipt with Panic {
    assert(receipt_id == 13002)
    validate_refined_ab(ab)
    validate_refined_ba(ba)
    assert(ab_subset.receipt_id == 12601 && ab_subset.subset_certified)
    assert(ba_subset.receipt_id == 12602 && ba_subset.subset_certified)
    assert(ab_subset.result_set_id == ab.set_id)
    assert(ba_subset.result_set_id == ba.set_id)
    assert(ab.model_id == ba.model_id)
    assert(ab.assumption_set_id == ba.assumption_set_id)
    assert(ab.observation_id == ba.observation_id)
    assert(ab.observation_provenance_id == ba.observation_provenance_id)
    assert(ab.observation_provenance_fingerprint ==
        ba.observation_provenance_fingerprint)
    let checksum = (ab.set_id * 31 + ba.set_id) * 31
    assert(checksum == 12401023)
    ExactSeparationReceipt {
        receipt_id: receipt_id,
        ab_refined_set_id: ab.set_id,
        ba_refined_set_id: ba.set_id,
        model_id: ab.model_id,
        assumption_set_id: ab.assumption_set_id,
        ab_history_id: ab.history_id,
        ba_history_id: ba.history_id,
        observation_id: ab.observation_id,
        observation_provenance_id: ab.observation_provenance_id,
        observation_provenance_fingerprint: ab.observation_provenance_fingerprint,
        ab_member_mask: ab.member_mask,
        ba_member_mask: ba.member_mask,
        exact_intersection_mask: 0,
        separation_audit_checksum: checksum,
        both_exact: true,
        both_singleton: true,
        disjoint: true,
        guaranteed_separation: true,
        global_separation_claimed: false,
        causal_authority: false,
        clinical_authority: false,
