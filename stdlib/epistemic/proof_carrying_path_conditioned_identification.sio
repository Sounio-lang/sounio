pub fn summarize_path_conditioned_identification(
    summary_id: i64,
    model: PathConditionedFiniteModelReceipt,
    collision: ProjectionCollisionReceipt,
    compatibility: WitnessedInitialCompatibilityReceipt,
    refusal: InitialSeparationRefusalReceipt,
    outer_undecided: OuterOnlyOverlapUndecidedReceipt,
    ab_subset: ABSubsetReceipt,
    ba_subset: BASubsetReceipt,
    ab_point: ABFinitePointIdentificationReceipt,
    ba_point: BAFinitePointIdentificationReceipt,
    separation: ExactSeparationReceipt,
    missing_abstention: MissingnessRefinementAbstentionReceipt,
    conflict: ModelEvidenceConflictReceipt,
    association: PathAssociationReceipt,
    proxy: SyntheticSufferingProxyReceipt,
) -> PathConditionedIdentificationSummaryReceipt with Panic {
    assert(summary_id == 13201)
    validate_model(model)
    assert(collision.receipt_id == 11902 && collision.compatible_state_count == 3)
    assert(!collision.scalar_identifies_state)
    assert(compatibility.receipt_id == 12701 && compatibility.exact_sets_overlap)
    assert(refusal.refusal_id == 12702 && refusal.reason_mask == 3)
    assert(!refusal.guaranteed_separation_issued)
    assert(outer_undecided.receipt_id == 12803 && outer_undecided.undecided)
    assert(!outer_undecided.real_overlap_certified)
    assert(!outer_undecided.real_separation_certified)
    assert(ab_subset.receipt_id == 12601 && ab_subset.subset_certified)
    assert(ba_subset.receipt_id == 12602 && ba_subset.subset_certified)
    assert(ab_point.receipt_id == 12611 && ab_point.state_id == 12001)
    assert(ab_point.refined_set_id == ab_subset.result_set_id)
    assert(ab_point.observation_provenance_id == 12351)
    assert(ab_point.observation_provenance_fingerprint == 477185883)
    assert(ab_point.point_audit_checksum == 384337994)
    assert(ab_point.exact_within_frozen_family && ab_point.singleton_witnessed)
    assert(!ab_point.global_identification_claimed)
    assert(!ab_point.causal_authority && !ab_point.clinical_authority)
    assert(ba_point.receipt_id == 12612 && ba_point.state_id == 12003)
    assert(ba_point.refined_set_id == ba_subset.result_set_id)
    assert(ba_point.observation_provenance_id == 12351)
    assert(ba_point.observation_provenance_fingerprint == 477185883)
    assert(ba_point.point_audit_checksum == 384369739)
    assert(ba_point.exact_within_frozen_family && ba_point.singleton_witnessed)
    assert(!ba_point.global_identification_claimed)
    assert(!ba_point.causal_authority && !ba_point.clinical_authority)
    assert(separation.receipt_id == 13002 && separation.guaranteed_separation)
    assert(separation.model_id == model.model_id)
    assert(separation.assumption_set_id == model.assumption_set_id)
    assert(separation.ab_history_id == 12101 && separation.ba_history_id == 12102)
    assert(separation.observation_id == 12401)
    assert(separation.observation_provenance_id == 12351)
    assert(separation.observation_provenance_fingerprint == 477185883)
    assert(!separation.global_separation_claimed)
    assert(!separation.causal_authority && !separation.clinical_authority)
    assert(missing_abstention.abstention_id == 12903)
    assert(missing_abstention.set_preserved && !missing_abstention.refinement_performed)
    assert(conflict.conflict_id == 13102 && conflict.empty_identified_set)
    assert(!conflict.latent_state_selected && !conflict.nearest_state_fallback_used)
    assert(association.receipt_id == 13001 && association.ordered_history_association)
    assert(!association.intervention_authority && !association.counterfactual_authority)
    assert(proxy.receipt_id == 13003 && proxy.synthetic_proxy)
    assert(!proxy.human_suffering_observed)
    let checksum = (((((summary_id * 31 + model.protocol_id) * 31 + 2) *
        31 + 4) * 31 + 1) * 31)
    assert(checksum == 386060470608)
    PathConditionedIdentificationSummaryReceipt {
        summary_id: summary_id,
        protocol_id: model.protocol_id,
        model_id: model.model_id,
        latent_state_count: 3,
        scalar_compatible_state_count: 3,
        ordered_history_count: 2,
        initial_exact_set_count: 2,
        exact_refinement_count: 2,
        subset_receipt_count: 2,
