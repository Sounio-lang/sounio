    validate_model(model)
    validate_ab_history(history)
    assert(history.history_id == model.ab_history_id)
    let mask = d8_ab_mask()
    let checksum = (set_id * 31 + history.history_fingerprint) * 31 + mask
    assert(mask == 3 && checksum == 25710287)
    ExactABIdentifiedSetReceipt {
        set_id: set_id,
        model_id: model.model_id,
        model_version: model.model_version,
        assumption_set_id: model.assumption_set_id,
        history_id: history.history_id,
        history_fingerprint: history.history_fingerprint,
        path_code: history.path_code,
        member_mask: mask,
        member_count: 2,
        scalar_projection: model.shared_scalar_projection,
        set_audit_checksum: checksum,
        exact_within_frozen_family: true,
        sound_outer: true,
        witnessed_inner: true,
        heuristic: false,
        point_identified: false,
        confidence_region: false,
        predictive_set: false,
    }
}

