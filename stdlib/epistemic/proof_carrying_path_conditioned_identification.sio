pub fn declare_d8_latent_state(
    state_id: i64,
    state_code: i64,
) -> D8LatentStateReceipt with Panic {
    assert((state_id == 12001 && state_code == 1) ||
        (state_id == 12002 && state_code == 2) ||
        (state_id == 12003 && state_code == 3))
    D8LatentStateReceipt {
        state_id: state_id,
        family_id: 12100,
        state_code: state_code,
        scalar_projection: 877,
        synthetic_state: true,
    }
}

pub fn record_scalar_projection_collision(
    observation_id: i64,
    a: D8LatentStateReceipt,
    b: D8LatentStateReceipt,
    c: D8LatentStateReceipt,
) -> ScalarProjectionObservationReceipt with Panic {
    validate_d8_state(a)
    validate_d8_state(b)
    validate_d8_state(c)
    assert(a.state_id == 12001 && b.state_id == 12002 && c.state_id == 12003)
    assert(a.scalar_projection == b.scalar_projection)
    assert(b.scalar_projection == c.scalar_projection)
    assert(observation_id == 12400)
    ScalarProjectionObservationReceipt {
        observation_id: observation_id,
        family_id: 12100,
        scalar_value: 877,
        compatible_state_mask: 7,
        compatible_state_count: 3,
        observation_is_state: false,
        unique_state_identified: false,
    }
}

pub fn certify_projection_collision(
    receipt_id: i64,
    observation: ScalarProjectionObservationReceipt,
    a: D8LatentStateReceipt,
    b: D8LatentStateReceipt,
    c: D8LatentStateReceipt,
) -> ProjectionCollisionReceipt with Panic {
    assert(receipt_id == 11902)
    validate_d8_state(a)
    validate_d8_state(b)
    validate_d8_state(c)
    assert(observation.observation_id == 12400 && observation.family_id == 12100)
    assert(observation.scalar_value == 877 && observation.compatible_state_mask == 7)
    assert(observation.compatible_state_count == 3)
    assert(!observation.observation_is_state && !observation.unique_state_identified)
    let family_fingerprint = (a.state_id * 31 + b.state_id) * 31 + c.state_id
    let checksum = family_fingerprint * 31 + observation.scalar_value
    assert(family_fingerprint == 11917026 && checksum == 369428683)
    ProjectionCollisionReceipt {
        receipt_id: receipt_id,
        family_id: 12100,
        a_state_id: a.state_id,
        b_state_id: b.state_id,
        c_state_id: c.state_id,
        shared_scalar_projection: observation.scalar_value,
        collision_mask: observation.compatible_state_mask,
        compatible_state_count: observation.compatible_state_count,
        state_family_fingerprint: family_fingerprint,
        collision_audit_checksum: checksum,
        scalar_identifies_state: false,
    }
}

pub fn refuse_d7_cross_occurrence_reuse(
    refusal_id: i64,
    requested_d8_occurrence_id: i64,
    decision: LocalRebracketingEqualityDecisionReceipt,
) -> D7CrossOccurrenceReuseRefusalReceipt with Panic {
    assert(refusal_id == 11901 && requested_d8_occurrence_id == 17001)
    assert(decision.decision_id == 10201 && decision.request_id == 10101)
    assert(decision.protocol_id == 8700 && decision.fixture_occurrence_id == 11001)
    assert(decision.decision_audit_checksum == 322833)
    assert(decision.exact_equal_on_frozen_occurrence)
    assert(decision.fixture_occurrence_bound && !decision.reusable_across_occurrences)
    assert(decision.model_equality_decision_only && decision.public_model_receipt)
    assert(!decision.receipt_construction_sealed)
    assert(!decision.compiler_capability_bound)
    let reason_mask = 1 + 2
    let checksum = ((decision.decision_audit_checksum * 31 +
        requested_d8_occurrence_id) * 31 + refusal_id) * 7 + reason_mask
    assert(reason_mask == 3 && checksum == 2175470118)
    D7CrossOccurrenceReuseRefusalReceipt {
        refusal_id: refusal_id,
        d7_decision_id: decision.decision_id,
        d7_request_id: decision.request_id,
        d7_protocol_id: decision.protocol_id,
        d7_bound_fixture_occurrence_id: decision.fixture_occurrence_id,
        requested_d8_occurrence_id: requested_d8_occurrence_id,
        reason_mask: reason_mask,
        refusal_audit_checksum: checksum,
        d7_local_equality_preserved: true,
        cross_occurrence_reuse_refused: true,
        d8_rebracketing_performed: false,
        path_order_substitution_authorized: false,
        compiler_authority_issued: false,
    }
}

