pub fn record_outer_overlap_as_undecided(
    receipt_id: i64,
    ab_outer: SoundOuterABIdentifiedSetReceipt,
    ba_outer: SoundOuterBAIdentifiedSetReceipt,
) -> OuterOnlyOverlapUndecidedReceipt with Panic {
    assert(receipt_id == 12803)
    assert(ab_outer.outer_id == 12801 && ab_outer.path_code == 1)
    assert(ab_outer.member_mask == 3 && ab_outer.outer_audit_checksum == 12683095)
    assert(ba_outer.outer_id == 12802 && ba_outer.path_code == 2)
    assert(ba_outer.member_mask == 6 && ba_outer.outer_audit_checksum == 12684090)
    assert(ab_outer.sound_outer && ba_outer.sound_outer)
    assert(!ab_outer.exactness_retained && !ba_outer.exactness_retained)
    let checksum = ((((ab_outer.outer_audit_checksum * 31 +
        ba_outer.outer_audit_checksum) * 31 + 9) * 31 + 4) * 31 + 5)
    assert(checksum == 12090976311463)
    OuterOnlyOverlapUndecidedReceipt {
        receipt_id: receipt_id,
        ab_outer_id: ab_outer.outer_id,
        ba_outer_id: ba_outer.outer_id,
        outer_intersection_mask: 2,
        admissible_completion_pair_count: 9,
        overlapping_completion_pair_count: 4,
        disjoint_completion_pair_count: 5,
        undecided_audit_checksum: checksum,
        outer_overlap_observed: true,
        real_overlap_certified: false,
        real_separation_certified: false,
        undecided: true,
    }
}

pub fn record_discriminating_observation(
    observation_id: i64,
    model: PathConditionedFiniteModelReceipt,
    provenance: D8ObservationProvenanceReceipt,
) -> SyntheticDiscriminatingObservationReceipt with Panic {
    assert(observation_id == 12401)
    validate_model(model)
    validate_d8_observation_provenance(provenance)
    assert(provenance.provenance_id == 12351)
    assert(provenance.measurement_policy_id == model.measurement_policy_id)
    let mask = d8_discriminating_mask()
    let checksum = (observation_id * 31 + model.measurement_policy_id) * 31 + mask
    assert(mask == 5 && checksum == 12382490)
    SyntheticDiscriminatingObservationReceipt {
        observation_id: observation_id,
        model_id: model.model_id,
        measurement_policy_id: model.measurement_policy_id,
        assumption_set_id: model.assumption_set_id,
        compatibility_mask: mask,
        compatible_state_count: 2,
        provenance_id: provenance.provenance_id,
        source_id: provenance.source_id,
        observation_tick: provenance.observation_tick,
        policy_decision_id: provenance.policy_decision_id,
        predecessor_provenance_id: provenance.predecessor_provenance_id,
        provenance_fingerprint: provenance.provenance_fingerprint,
        observation_audit_checksum: checksum,
        observed: true,
        fixture_source_audited: provenance.fixture_source_audited,
        missing: false,
        declared_provenance_bound: true,
    }
}

pub fn refine_ab_identified_set(
    set_id: i64,
    source: ExactABIdentifiedSetReceipt,
    observation: SyntheticDiscriminatingObservationReceipt,
) -> RefinedABIdentifiedSetReceipt with Panic {
    assert(set_id == 12501)
    validate_ab_set(source)
    validate_discriminating_observation(observation)
    assert(source.model_id == observation.model_id)
    assert(source.assumption_set_id == observation.assumption_set_id)
    let result_mask = d8_bool_i64(
        d8_state_is_ab_compatible(12001) &&
        d8_state_is_discriminating_compatible(12001),
    ) + 2 * d8_bool_i64(
        d8_state_is_ab_compatible(12002) &&
        d8_state_is_discriminating_compatible(12002),
    ) + 4 * d8_bool_i64(
        d8_state_is_ab_compatible(12003) &&
        d8_state_is_discriminating_compatible(12003),
    )
    let checksum = (source.set_audit_checksum * 31 +
        observation.observation_audit_checksum) * 31 + result_mask
    assert(result_mask == 1 && checksum == 25091442998)
    RefinedABIdentifiedSetReceipt {
        set_id: set_id,
        source_set_id: source.set_id,
        observation_id: observation.observation_id,
        observation_provenance_id: observation.provenance_id,
        observation_provenance_fingerprint: observation.provenance_fingerprint,
        model_id: source.model_id,
        assumption_set_id: source.assumption_set_id,
        history_id: source.history_id,
        source_mask: source.member_mask,
        evidence_mask: observation.compatibility_mask,
        member_mask: result_mask,
        member_count: 1,
        refinement_audit_checksum: checksum,
        exact_within_frozen_family: true,
        subset_of_source: true,
        point_identified: true,
    }
}

