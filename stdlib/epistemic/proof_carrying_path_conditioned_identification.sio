fn d8_bool_i64(value: bool) -> i64 { if value { 1 } else { 0 } }

fn d8_state_is_ab_compatible(state_id: i64) -> bool with Panic {
    assert(state_id == 12001 || state_id == 12002 || state_id == 12003)
    state_id == 12001 || state_id == 12002
}

fn d8_state_is_ba_compatible(state_id: i64) -> bool with Panic {
    assert(state_id == 12001 || state_id == 12002 || state_id == 12003)
    state_id == 12002 || state_id == 12003
}

fn d8_state_is_discriminating_compatible(state_id: i64) -> bool with Panic {
    assert(state_id == 12001 || state_id == 12002 || state_id == 12003)
    state_id == 12001 || state_id == 12003
}

fn d8_ab_mask() -> i64 with Panic {
    let mask = d8_bool_i64(d8_state_is_ab_compatible(12001)) +
        2 * d8_bool_i64(d8_state_is_ab_compatible(12002)) +
        4 * d8_bool_i64(d8_state_is_ab_compatible(12003))
    assert(mask == 3)
    mask
}

fn d8_ba_mask() -> i64 with Panic {
    let mask = d8_bool_i64(d8_state_is_ba_compatible(12001)) +
        2 * d8_bool_i64(d8_state_is_ba_compatible(12002)) +
        4 * d8_bool_i64(d8_state_is_ba_compatible(12003))
    assert(mask == 6)
    mask
}

fn d8_discriminating_mask() -> i64 with Panic {
    let mask = d8_bool_i64(d8_state_is_discriminating_compatible(12001)) +
        2 * d8_bool_i64(d8_state_is_discriminating_compatible(12002)) +
        4 * d8_bool_i64(d8_state_is_discriminating_compatible(12003))
    assert(mask == 5)
    mask
}

fn validate_d8_state(state: D8LatentStateReceipt) with Panic {
    assert(state.family_id == 12100)
    assert(state.state_id == 12001 || state.state_id == 12002 ||
        state.state_id == 12003)
    if state.state_id == 12001 { assert(state.state_code == 1) }
    if state.state_id == 12002 { assert(state.state_code == 2) }
    if state.state_id == 12003 { assert(state.state_code == 3) }
    assert(state.scalar_projection == 877 && state.synthetic_state)
}

fn validate_ab_history(history: OrderedHistoryABReceipt) with Panic {
    assert(history.history_id == 12101 && history.family_id == 12100)
    assert(history.first_action_id == 14001 && history.second_action_id == 14002)
    assert(history.path_code == 1 && history.history_fingerprint == 448033)
    assert(history.order_preserved)
}

fn validate_ba_history(history: OrderedHistoryBAReceipt) with Panic {
    assert(history.history_id == 12102 && history.family_id == 12100)
    assert(history.first_action_id == 14002 && history.second_action_id == 14001)
    assert(history.path_code == 2 && history.history_fingerprint == 448063)
    assert(history.order_preserved)
}

fn validate_model(model: PathConditionedFiniteModelReceipt) with Panic {
    assert(model.model_id == 12200 && model.model_version == 1)
    assert(model.protocol_id == 8800 && model.family_id == 12100)
    assert(model.subject_id == 15001 && model.window_id == 15002)
    assert(model.instrument_id == 15003 && model.measurement_policy_id == 15004)
    assert(model.universe_mask == 7 && model.universe_count == 3)
    assert(model.shared_scalar_projection == 877)
    assert(model.ab_history_id == 12101 && model.ba_history_id == 12102)
    assert(model.d7_cross_occurrence_refusal_id == 11901)
    assert(model.assumption_set_id == 12210)
    assert(model.model_audit_checksum == 11728748010)
    assert(model.finite_family_exhaustively_enumerated)
    assert(model.path_conditioning_enabled && !model.histories_interchangeable)
    assert(model.d7_cross_occurrence_reuse_refused)
    assert(model.public_model_receipt && !model.receipt_construction_sealed)
    assert(!model.empirical_adequacy_established && !model.clinical_authority)
}

fn validate_ab_set(set: ExactABIdentifiedSetReceipt) with Panic {
    assert(set.set_id == 12301 && set.model_id == 12200)
    assert(set.model_version == 1 && set.assumption_set_id == 12210)
    assert(set.history_id == 12101 && set.history_fingerprint == 448033)
    assert(set.path_code == 1 && set.member_mask == 3 && set.member_count == 2)
    assert(set.scalar_projection == 877 && set.set_audit_checksum == 25710287)
    assert(set.exact_within_frozen_family && set.sound_outer && set.witnessed_inner)
    assert(!set.heuristic && !set.point_identified)
    assert(!set.confidence_region && !set.predictive_set)
}

fn validate_ba_set(set: ExactBAIdentifiedSetReceipt) with Panic {
    assert(set.set_id == 12302 && set.model_id == 12200)
    assert(set.model_version == 1 && set.assumption_set_id == 12210)
    assert(set.history_id == 12102 && set.history_fingerprint == 448063)
    assert(set.path_code == 2 && set.member_mask == 6 && set.member_count == 2)
    assert(set.scalar_projection == 877 && set.set_audit_checksum == 25712181)
    assert(set.exact_within_frozen_family && set.sound_outer && set.witnessed_inner)
    assert(!set.heuristic && !set.point_identified)
    assert(!set.confidence_region && !set.predictive_set)
}

fn validate_discriminating_observation(
    observation: SyntheticDiscriminatingObservationReceipt,
) with Panic {
    assert(observation.observation_id == 12401 && observation.model_id == 12200)
    assert(observation.measurement_policy_id == 15004)
    assert(observation.assumption_set_id == 12210)
    assert(observation.compatibility_mask == 5)
    assert(observation.compatible_state_count == 2)
    assert(observation.provenance_id == 12351 && observation.source_id == 16001)
    assert(observation.observation_tick == 1)
    assert(observation.policy_decision_id == 16101)
    assert(observation.predecessor_provenance_id == 0)
    assert(observation.provenance_fingerprint == 477185883)
    assert(observation.observation_audit_checksum == 12382490)
    assert(observation.observed && observation.fixture_source_audited)
    assert(!observation.missing && observation.declared_provenance_bound)
}

fn validate_d8_observation_provenance(
    provenance: D8ObservationProvenanceReceipt,
) with Panic {
    assert(provenance.measurement_policy_id == 15004)
    assert(provenance.declared_within_frozen_fixture)
    assert(provenance.fixture_source_audited)
    assert(!provenance.real_world_custody_established)
    assert(!provenance.receipt_construction_sealed)
    if provenance.provenance_id == 12351 {
        assert(provenance.source_id == 16001 && provenance.observation_tick == 1)
        assert(provenance.policy_decision_id == 16101)
        assert(provenance.predecessor_provenance_id == 0)
        assert(provenance.provenance_fingerprint == 477185883)
    } else {
        if provenance.provenance_id == 12352 {
            assert(provenance.source_id == 16002 && provenance.observation_tick == 2)
            assert(provenance.policy_decision_id == 16102)
            assert(provenance.predecessor_provenance_id == 12351)
            assert(provenance.provenance_fingerprint == 477229017)
        } else {
            assert(provenance.provenance_id == 12353)
            assert(provenance.source_id == 16003 && provenance.observation_tick == 3)
            assert(provenance.policy_decision_id == 16103)
            assert(provenance.predecessor_provenance_id == 12351)
            assert(provenance.provenance_fingerprint == 477259800)
        }
    }
}

fn validate_d8_synthetic_policy_decision(
    decision: D8SyntheticPolicyDecisionReceipt,
) with Panic {
    assert(decision.measurement_policy_id == 15004)
    assert(decision.declared_within_frozen_fixture)
    assert(!decision.real_policy_decision)
    assert(!decision.receipt_construction_sealed)
    if decision.decision_id == 16101 {
        assert(decision.decision_tick == 1 && decision.branch_code == 0)
        assert(decision.decision_audit_checksum == 111567302)
    } else {
        if decision.decision_id == 16102 {
            assert(decision.decision_tick == 2 && decision.branch_code == 1)
            assert(decision.decision_audit_checksum == 111574037)
        } else {
            assert(decision.decision_id == 16103)
            assert(decision.decision_tick == 3 && decision.branch_code == 2)
            assert(decision.decision_audit_checksum == 111580772)
        }
    }
}

fn validate_refined_ab(set: RefinedABIdentifiedSetReceipt) with Panic {
    assert(set.set_id == 12501 && set.source_set_id == 12301)
    assert(set.observation_id == 12401 && set.model_id == 12200)
    assert(set.observation_provenance_id == 12351)
