pub fn detect_model_evidence_conflict(
    conflict_id: i64,
    source: RefinedABIdentifiedSetReceipt,
    observation: ConflictingSyntheticObservationReceipt,
) -> ModelEvidenceConflictReceipt with Panic {
    assert(conflict_id == 13102)
    validate_refined_ab(source)
    assert(observation.observation_id == 13101)
    assert(observation.model_id == source.model_id)
    assert(observation.measurement_policy_id == 15004)
    assert(observation.compatibility_mask == 4)
    assert(observation.provenance_id == 12353 && observation.source_id == 16003)
    assert(observation.observation_tick == 3)
    assert(observation.policy_decision_id == 16103)
    assert(observation.predecessor_provenance_id == 12351)
    assert(observation.provenance_fingerprint == 477259800)
    assert(observation.observation_audit_checksum == 13055189)
    assert(observation.observed && observation.fixture_source_audited)
    let checksum = (source.refinement_audit_checksum * 31 +
        observation.observation_audit_checksum) * 31
    assert(checksum == 24113281431937)
    ModelEvidenceConflictReceipt {
        conflict_id: conflict_id,
        source_set_id: source.set_id,
        observation_id: observation.observation_id,
        source_mask: source.member_mask,
        evidence_mask: observation.compatibility_mask,
        result_mask: 0,
        conflict_audit_checksum: checksum,
        empty_identified_set: true,
        model_evidence_conflict: true,
        latent_state_selected: false,
        nearest_state_fallback_used: false,
    }
}

