pub fn bind_missing_under_policy(
    receipt_id: i64,
    not_measured: NotMeasuredReceipt,
    model: PathConditionedFiniteModelReceipt,
) -> MissingUnderPolicyReceipt with Panic {
    assert(receipt_id == 12902)
    validate_model(model)
    assert(not_measured.receipt_id == 12901)
    assert(not_measured.model_id == model.model_id)
    assert(not_measured.measurement_policy_id == model.measurement_policy_id)
    assert(not_measured.provenance_id == 12352 && not_measured.source_id == 16002)
    assert(not_measured.observation_tick == 2)
    assert(not_measured.policy_decision_id == 16102)
    assert(not_measured.predecessor_provenance_id == 12351)
    assert(not_measured.provenance_fingerprint == 477229017)
    assert(not_measured.opportunity_observed && !not_measured.value_observed)
    let checksum = (not_measured.receipt_id * 31 +
        model.measurement_policy_id) * 31 + receipt_id
    assert(checksum == 12875887)
    MissingUnderPolicyReceipt {
        receipt_id: receipt_id,
        not_measured_receipt_id: not_measured.receipt_id,
        model_id: model.model_id,
        measurement_policy_id: model.measurement_policy_id,
        provenance_id: not_measured.provenance_id,
        provenance_fingerprint: not_measured.provenance_fingerprint,
        missingness_audit_checksum: checksum,
        declared_provenance_bound: true,
        observed_false: false,
    }
}

pub fn abstain_from_missingness_refinement(
    abstention_id: i64,
    source: ExactABIdentifiedSetReceipt,
    missing: MissingUnderPolicyReceipt,
) -> MissingnessRefinementAbstentionReceipt with Panic {
    assert(abstention_id == 12903)
    validate_ab_set(source)
    assert(missing.receipt_id == 12902 && missing.model_id == source.model_id)
    assert(missing.measurement_policy_id == 15004)
    assert(missing.missingness_audit_checksum == 12875887)
    assert(missing.provenance_id == 12352)
    assert(missing.provenance_fingerprint == 477229017)
    assert(missing.declared_provenance_bound && !missing.observed_false)
    let reason_mask = 1 + 2
    let checksum = (missing.missingness_audit_checksum * 31 +
        source.member_mask) * 31 + abstention_id
    assert(reason_mask == 3 && checksum == 12373740403)
    MissingnessRefinementAbstentionReceipt {
        abstention_id: abstention_id,
        missing_receipt_id: missing.receipt_id,
        source_set_id: source.set_id,
        source_mask: source.member_mask,
        result_mask: source.member_mask,
        reason_mask: reason_mask,
        abstention_audit_checksum: checksum,
        set_preserved: true,
        refinement_performed: false,
    }
}

