pub fn declare_d8_synthetic_policy_decision(
    decision_id: i64,
    decision_tick: i64,
    branch_code: i64,
) -> D8SyntheticPolicyDecisionReceipt with Panic {
    assert((decision_id == 16101 && decision_tick == 1 && branch_code == 0) ||
        (decision_id == 16102 && decision_tick == 2 && branch_code == 1) ||
        (decision_id == 16103 && decision_tick == 3 && branch_code == 2))
    let checksum = ((decision_id * 31 + 15004) * 31 +
        decision_tick) * 7 + branch_code
    let decision = D8SyntheticPolicyDecisionReceipt {
        decision_id: decision_id,
        measurement_policy_id: 15004,
        decision_tick: decision_tick,
        branch_code: branch_code,
        decision_audit_checksum: checksum,
        declared_within_frozen_fixture: true,
        real_policy_decision: false,
        receipt_construction_sealed: false,
    }
    validate_d8_synthetic_policy_decision(decision)
    decision
}

pub fn declare_d8_root_observation_provenance(
    provenance_id: i64,
    source_id: i64,
    decision: D8SyntheticPolicyDecisionReceipt,
) -> D8ObservationProvenanceReceipt with Panic {
    assert(provenance_id == 12351 && source_id == 16001)
    validate_d8_synthetic_policy_decision(decision)
    assert(decision.decision_id == 16101)
    assert(decision.decision_tick == 1 && decision.branch_code == 0)
    let fingerprint = ((source_id * 31 + decision.decision_tick) * 31 +
        decision.decision_id) * 31
    let provenance = D8ObservationProvenanceReceipt {
        provenance_id: provenance_id,
        source_id: source_id,
        observation_tick: decision.decision_tick,
        measurement_policy_id: 15004,
        policy_decision_id: decision.decision_id,
        predecessor_provenance_id: 0,
        provenance_fingerprint: fingerprint,
        declared_within_frozen_fixture: true,
        fixture_source_audited: true,
        real_world_custody_established: false,
        receipt_construction_sealed: false,
    }
    validate_d8_observation_provenance(provenance)
    provenance
}

pub fn declare_d8_child_observation_provenance(
    provenance_id: i64,
    source_id: i64,
    decision: D8SyntheticPolicyDecisionReceipt,
    predecessor: D8ObservationProvenanceReceipt,
) -> D8ObservationProvenanceReceipt with Panic {
    validate_d8_synthetic_policy_decision(decision)
    validate_d8_observation_provenance(predecessor)
    assert(predecessor.provenance_id == 12351)
    assert(predecessor.observation_tick == 1)
    assert(predecessor.provenance_fingerprint == 477185883)
    assert((provenance_id == 12352 && source_id == 16002 &&
        decision.decision_id == 16102 && decision.decision_tick == 2 &&
        decision.branch_code == 1) ||
        (provenance_id == 12353 && source_id == 16003 &&
        decision.decision_id == 16103 && decision.decision_tick == 3 &&
        decision.branch_code == 2))
    let fingerprint = ((source_id * 31 + decision.decision_tick) * 31 +
        decision.decision_id) * 31 + predecessor.provenance_id
    let provenance = D8ObservationProvenanceReceipt {
        provenance_id: provenance_id,
        source_id: source_id,
        observation_tick: decision.decision_tick,
        measurement_policy_id: decision.measurement_policy_id,
        policy_decision_id: decision.decision_id,
        predecessor_provenance_id: predecessor.provenance_id,
        provenance_fingerprint: fingerprint,
        declared_within_frozen_fixture: true,
        fixture_source_audited: true,
        real_world_custody_established: false,
        receipt_construction_sealed: false,
    }
    validate_d8_observation_provenance(provenance)
    provenance
}

