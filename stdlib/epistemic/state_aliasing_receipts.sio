// stdlib/epistemic/state_aliasing_receipts.sio
//
// Nominal boundaries for a common failure in longitudinal modeling: two
// histories can share one observed proxy without being interchangeable for a
// declared future prediction. These are synthetic research receipts. They do
// not establish latent-state identity, prediction quality, causality, a
// biological mechanism, treatment effect, or clinical authority.

use epistemic::observation_provenance::{
    ObservationHistoryI64,
    op_observation_history_source_system_tag_i64,
    op_observation_history_tag_i64,
}

struct ObservedProxyI64 {
    history_tag: i64,
    source_system_tag: i64,
    observed_proxy_tag: i64,
}

struct ObservedProxyCollisionI64 {
    source_system_tag: i64,
    observed_proxy_tag: i64,
    left_history_tag: i64,
    right_history_tag: i64,
}

struct PredictiveChallengeI64 {
    source_system_tag: i64,
    observed_proxy_tag: i64,
    left_history_tag: i64,
    right_history_tag: i64,
    horizon_tag: i64,
    target_feature_tag: i64,
    comparator_tag: i64,
}

struct PredictiveSeparationI64 {
    source_system_tag: i64,
    observed_proxy_tag: i64,
    left_history_tag: i64,
    right_history_tag: i64,
    horizon_tag: i64,
    target_feature_tag: i64,
    comparator_tag: i64,
    left_output_tag: i64,
    right_output_tag: i64,
}

struct StateRefinementRequestI64 {
    source_system_tag: i64,
    observed_proxy_tag: i64,
    left_history_tag: i64,
    right_history_tag: i64,
    horizon_tag: i64,
    target_feature_tag: i64,
    comparator_tag: i64,
    omitted_state_tag: i64,
}

struct StateEquivalenceAbstentionI64 {
    source_system_tag: i64,
    observed_proxy_tag: i64,
    left_history_tag: i64,
    right_history_tag: i64,
    reason_tag: i64,
}

fn sar_require_nonzero(tag: i64) -> i64 with Panic {
    assert(tag != 0)
    tag
}

// A proxy is deliberately anchored to one history. Equal proxy tags are not
// state equivalence; they only name a supplied shared observation in a
// synthetic fixture.
pub fn sar_observed_proxy_i64(
    history: ObservationHistoryI64,
    observed_proxy_tag: i64
) -> ObservedProxyI64 with Panic {
    ObservedProxyI64 {
        history_tag: op_observation_history_tag_i64(history),
        source_system_tag: op_observation_history_source_system_tag_i64(history),
        observed_proxy_tag: sar_require_nonzero(observed_proxy_tag),
    }
}

// A collision records distinct histories with the same declared observed
// proxy. It does not say that a hidden state exists or that either history
// changes a future outcome.
pub fn sar_observed_proxy_collision_i64(
    left: ObservedProxyI64,
    right: ObservedProxyI64
) -> ObservedProxyCollisionI64 with Panic {
    assert(left.source_system_tag == right.source_system_tag)
    assert(left.observed_proxy_tag == right.observed_proxy_tag)
    assert(left.history_tag != right.history_tag)
    ObservedProxyCollisionI64 {
        source_system_tag: left.source_system_tag,
        observed_proxy_tag: left.observed_proxy_tag,
        left_history_tag: left.history_tag,
        right_history_tag: right.history_tag,
    }
}

// A challenge predeclares the horizon, target feature, and comparator before a
// synthetic output difference is recorded. It is not a fitted predictor or a
// transportable clinical model.
pub fn sar_predictive_challenge_i64(
    collision: ObservedProxyCollisionI64,
    horizon_tag: i64,
    target_feature_tag: i64,
    comparator_tag: i64
) -> PredictiveChallengeI64 with Panic {
    PredictiveChallengeI64 {
        source_system_tag: collision.source_system_tag,
        observed_proxy_tag: collision.observed_proxy_tag,
        left_history_tag: collision.left_history_tag,
        right_history_tag: collision.right_history_tag,
        horizon_tag: sar_require_nonzero(horizon_tag),
        target_feature_tag: sar_require_nonzero(target_feature_tag),
        comparator_tag: sar_require_nonzero(comparator_tag),
    }
}

// Separation records only a declared synthetic difference under one matched
// challenge. It proves neither predictive accuracy nor a causal effect.
pub fn sar_predictive_separation_i64(
    challenge: PredictiveChallengeI64,
    left_output_tag: i64,
    right_output_tag: i64
) -> PredictiveSeparationI64 with Panic {
    let left_output = sar_require_nonzero(left_output_tag)
    let right_output = sar_require_nonzero(right_output_tag)
    assert(left_output != right_output)
    PredictiveSeparationI64 {
        source_system_tag: challenge.source_system_tag,
        observed_proxy_tag: challenge.observed_proxy_tag,
        left_history_tag: challenge.left_history_tag,
        right_history_tag: challenge.right_history_tag,
        horizon_tag: challenge.horizon_tag,
        target_feature_tag: challenge.target_feature_tag,
        comparator_tag: challenge.comparator_tag,
        left_output_tag: left_output,
        right_output_tag: right_output,
    }
}

// A refinement request retains the specific observed proxy and challenge that
// failed to collapse two histories. It is a modeling obligation, not proof of
// a unique latent state or a recommendation to alter care.
pub fn sar_state_refinement_request_i64(
    challenge: PredictiveChallengeI64,
    separation: PredictiveSeparationI64,
    omitted_state_tag: i64
) -> StateRefinementRequestI64 with Panic {
    assert(separation.source_system_tag == challenge.source_system_tag)
    assert(separation.observed_proxy_tag == challenge.observed_proxy_tag)
    assert(separation.left_history_tag == challenge.left_history_tag)
    assert(separation.right_history_tag == challenge.right_history_tag)
    assert(separation.horizon_tag == challenge.horizon_tag)
    assert(separation.target_feature_tag == challenge.target_feature_tag)
    assert(separation.comparator_tag == challenge.comparator_tag)
    StateRefinementRequestI64 {
        source_system_tag: challenge.source_system_tag,
        observed_proxy_tag: challenge.observed_proxy_tag,
        left_history_tag: challenge.left_history_tag,
        right_history_tag: challenge.right_history_tag,
        horizon_tag: challenge.horizon_tag,
        target_feature_tag: challenge.target_feature_tag,
        comparator_tag: challenge.comparator_tag,
        omitted_state_tag: sar_require_nonzero(omitted_state_tag),
    }
}

// When no valid separation is available, callers keep an explicit abstention
// instead of treating proxy equality as state equivalence.
pub fn sar_state_equivalence_abstention_i64(
    collision: ObservedProxyCollisionI64,
    reason_tag: i64
) -> StateEquivalenceAbstentionI64 with Panic {
    StateEquivalenceAbstentionI64 {
        source_system_tag: collision.source_system_tag,
        observed_proxy_tag: collision.observed_proxy_tag,
        left_history_tag: collision.left_history_tag,
        right_history_tag: collision.right_history_tag,
        reason_tag: sar_require_nonzero(reason_tag),
    }
}

pub fn sar_observed_proxy_history_tag_i64(receipt: ObservedProxyI64) -> i64 {
    receipt.history_tag
}

pub fn sar_observed_proxy_source_system_tag_i64(receipt: ObservedProxyI64) -> i64 {
    receipt.source_system_tag
}

pub fn sar_observed_proxy_tag_i64(receipt: ObservedProxyI64) -> i64 {
    receipt.observed_proxy_tag
}

pub fn sar_collision_source_system_tag_i64(receipt: ObservedProxyCollisionI64) -> i64 {
    receipt.source_system_tag
}

pub fn sar_collision_observed_proxy_tag_i64(receipt: ObservedProxyCollisionI64) -> i64 {
    receipt.observed_proxy_tag
}

pub fn sar_collision_left_history_tag_i64(receipt: ObservedProxyCollisionI64) -> i64 {
    receipt.left_history_tag
}

pub fn sar_collision_right_history_tag_i64(receipt: ObservedProxyCollisionI64) -> i64 {
    receipt.right_history_tag
}

pub fn sar_predictive_challenge_horizon_tag_i64(receipt: PredictiveChallengeI64) -> i64 {
    receipt.horizon_tag
}

pub fn sar_predictive_challenge_target_feature_tag_i64(receipt: PredictiveChallengeI64) -> i64 {
    receipt.target_feature_tag
}

pub fn sar_predictive_challenge_comparator_tag_i64(receipt: PredictiveChallengeI64) -> i64 {
    receipt.comparator_tag
}

pub fn sar_predictive_separation_left_output_tag_i64(receipt: PredictiveSeparationI64) -> i64 {
    receipt.left_output_tag
}

pub fn sar_predictive_separation_right_output_tag_i64(receipt: PredictiveSeparationI64) -> i64 {
    receipt.right_output_tag
}

pub fn sar_predictive_separation_source_system_tag_i64(receipt: PredictiveSeparationI64) -> i64 {
    receipt.source_system_tag
}

pub fn sar_state_refinement_observed_proxy_tag_i64(receipt: StateRefinementRequestI64) -> i64 {
    receipt.observed_proxy_tag
}

pub fn sar_state_refinement_left_history_tag_i64(receipt: StateRefinementRequestI64) -> i64 {
    receipt.left_history_tag
}

pub fn sar_state_refinement_right_history_tag_i64(receipt: StateRefinementRequestI64) -> i64 {
    receipt.right_history_tag
}

pub fn sar_state_refinement_horizon_tag_i64(receipt: StateRefinementRequestI64) -> i64 {
    receipt.horizon_tag
}

pub fn sar_state_refinement_target_feature_tag_i64(receipt: StateRefinementRequestI64) -> i64 {
    receipt.target_feature_tag
}

pub fn sar_state_refinement_comparator_tag_i64(receipt: StateRefinementRequestI64) -> i64 {
    receipt.comparator_tag
}

pub fn sar_state_refinement_omitted_state_tag_i64(receipt: StateRefinementRequestI64) -> i64 {
    receipt.omitted_state_tag
}

pub fn sar_state_equivalence_abstention_reason_tag_i64(receipt: StateEquivalenceAbstentionI64) -> i64 {
    receipt.reason_tag
}

pub fn sar_state_equivalence_abstention_observed_proxy_tag_i64(receipt: StateEquivalenceAbstentionI64) -> i64 {
    receipt.observed_proxy_tag
}
