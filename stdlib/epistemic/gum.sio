// stdlib/epistemic/gum.d
// GUM (Guide to the Expression of Uncertainty in Measurement) Compliant
// Uncertainty Propagation
//
// Implements:
// - Coverage factors (k) for expanded uncertainty
// - Degrees of freedom (ν) tracking
// - Welch-Satterthwaite approximation for combined DoF
// - Type A (statistical) and Type B (other) uncertainty components
//
// Reference: JCGM 100:2008 (GUM)

// =============================================================================
// Helper Functions
// =============================================================================

fn sqrt_f64(x: f64) -> f64 with Mut, Div {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i: i64 = 0
    while i < 15 {
        y = 0.5 * (y + x / y)
        i = i + 1
    }
    y
}

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn min_f64(a: f64, b: f64) -> f64 {
    if a < b { a } else { b }
}

fn max_f64(a: f64, b: f64) -> f64 {
    if a > b { a } else { b }
}

// =============================================================================
// GUM Uncertainty Type
// =============================================================================

/// GUM-compliant uncertainty with degrees of freedom.
///
/// # Builder Pattern
///
/// ```sio
/// let u = GUMUncertainty::type_a(0.1, 10)
///     .with_sensitivity(2.0);
///
/// let u_b = GUMUncertainty::type_b(0.05)
///     .with_sensitivity(1.0);
/// ```
pub struct GUMUncertainty {
    // Standard uncertainty u(x)
    pub std_uncertainty: f64,

    // Degrees of freedom ν (infinity represented as 1e9)
    // For Type A: ν = n - 1
    // For Type B: ν = ∞ (use 1e9)
    pub degrees_of_freedom: f64,

    // Sensitivity coefficient (∂f/∂x)
    pub sensitivity: f64,
}


// Coverage probability constants (as functions since pub const is not supported)
pub fn COVERAGE_68() -> f64 { 0.68 }
pub fn COVERAGE_90() -> f64 { 0.90 }
pub fn COVERAGE_95() -> f64 { 0.95 }
pub fn COVERAGE_99() -> f64 { 0.99 }
pub fn COVERAGE_9973() -> f64 { 0.9973 }

// =============================================================================
// Constructors
// =============================================================================

// Create Type A uncertainty from statistical data
// std_dev: sample standard deviation
// n: number of observations
pub fn type_a_uncertainty(std_dev: f64, n: i64) -> GUMUncertainty with Mut, Div {
    // Standard uncertainty of the mean = s / sqrt(n)
    let std_u = if n > 0 {
        std_dev / sqrt_f64(n as f64)
    } else {
        std_dev
    };

    // Degrees of freedom = n - 1
    let dof = if n > 1 { (n - 1) as f64 } else { 1.0 };

    GUMUncertainty {
        std_uncertainty: std_u,
        degrees_of_freedom: dof,
        sensitivity: 1.0,
    }
}

// Create Type B uncertainty from a priori knowledge
// For Type B, degrees of freedom is effectively infinite
pub fn type_b_uncertainty(std_u: f64) -> GUMUncertainty {
    GUMUncertainty {
        std_uncertainty: abs_f64(std_u),
        degrees_of_freedom: 1.0e9,
        sensitivity: 1.0,
    }
}

// Create Type B uncertainty from a uniform distribution
// half_width: a in the interval [-a, +a]
pub fn type_b_uniform(half_width: f64) -> GUMUncertainty {
    // For uniform: u = a / sqrt(3)
    let std_u = abs_f64(half_width) / 1.732050808;
    type_b_uncertainty(std_u)
}

// Create Type B uncertainty from a triangular distribution
// half_width: a in the interval [-a, +a]
pub fn type_b_triangular(half_width: f64) -> GUMUncertainty {
    // For triangular: u = a / sqrt(6)
    let std_u = abs_f64(half_width) / 2.449489743;
    type_b_uncertainty(std_u)
}

// Create Type B uncertainty from expanded uncertainty
// expanded_u: U (expanded uncertainty)
// k: coverage factor used
pub fn type_b_from_expanded(expanded_u: f64, k: f64) -> GUMUncertainty {
    let std_u = if k > 0.0 { expanded_u / k } else { expanded_u };
    type_b_uncertainty(std_u)
}

// =============================================================================
// Coverage Factor Tables (t-distribution)
// =============================================================================

// t-distribution quantiles for 95% coverage
// Index = degrees of freedom - 1 (for ν=1 to ν=20)
fn t_quantile_95(dof: usize) -> f64 {
    // Tabulated values from standard t-tables
    if dof >= 100 { return 1.96; }  // Normal approximation
    if dof >= 20 { return 2.086; }
    if dof == 0 { return 12.71; }

    let idx = dof - 1;
    if idx == 0 { return 12.71; }
    if idx == 1 { return 4.303; }
    if idx == 2 { return 3.182; }
    if idx == 3 { return 2.776; }
    if idx == 4 { return 2.571; }
    if idx == 5 { return 2.447; }
    if idx == 6 { return 2.365; }
    if idx == 7 { return 2.306; }
    if idx == 8 { return 2.262; }
    if idx == 9 { return 2.228; }
    if idx == 10 { return 2.201; }
    if idx == 11 { return 2.179; }
    if idx == 12 { return 2.160; }
    if idx == 13 { return 2.145; }
    if idx == 14 { return 2.131; }
    if idx == 15 { return 2.120; }
    if idx == 16 { return 2.110; }
    if idx == 17 { return 2.101; }
    if idx == 18 { return 2.093; }
    2.086  // ν >= 20
}

// t-distribution quantiles for 99% coverage
fn t_quantile_99(dof: usize) -> f64 {
    if dof >= 100 { return 2.576; }
    if dof >= 20 { return 2.845; }
    if dof == 0 { return 63.66; }

    let idx = dof - 1;
    if idx == 0 { return 63.66; }
    if idx == 1 { return 9.925; }
    if idx == 2 { return 5.841; }
    if idx == 3 { return 4.604; }
    if idx == 4 { return 4.032; }
    if idx == 5 { return 3.707; }
    if idx == 6 { return 3.499; }
    if idx == 7 { return 3.355; }
    if idx == 8 { return 3.250; }
    if idx == 9 { return 3.169; }
    2.845  // ν >= 10
}

// Get coverage factor k for 95% probability at given degrees of freedom
pub fn coverage_factor_95(dof: f64) -> f64 {
    let d = dof as usize;
    let d_safe = if d < 1 { 1 } else { d };
    t_quantile_95(d_safe)
}

// Get coverage factor k for 99% probability at given degrees of freedom
pub fn coverage_factor_99(dof: f64) -> f64 {
    let d = dof as usize;
    let d_safe = if d < 1 { 1 } else { d };
    t_quantile_99(d_safe)
}

// Standard coverage factors for normal distribution (infinite DoF)
pub fn k_normal_68() -> f64 { 1.0 }
pub fn k_normal_90() -> f64 { 1.645 }
pub fn k_normal_95() -> f64 { 1.96 }
pub fn k_normal_99() -> f64 { 2.576 }
pub fn k_normal_9973() -> f64 { 3.0 }

// =============================================================================
// Welch-Satterthwaite Approximation
// =============================================================================

// Calculate effective degrees of freedom for two uncertainty components
// Formula: ν_eff = u_c^4 / (u1^4/ν1 + u2^4/ν2)
pub fn welch_satterthwaite_2(u1: GUMUncertainty, u2: GUMUncertainty) -> f64 with Div {
    let c1 = u1.sensitivity;
    let c2 = u2.sensitivity;
    let s1 = u1.std_uncertainty;
    let s2 = u2.std_uncertainty;
    let v1 = u1.degrees_of_freedom;
    let v2 = u2.degrees_of_freedom;

    // Combined variance
    let u_c_sq = c1*c1*s1*s1 + c2*c2*s2*s2;
    let u_c_4 = u_c_sq * u_c_sq;

    // Denominator
    let term1 = c1*c1*c1*c1 * s1*s1*s1*s1 / v1;
    let term2 = c2*c2*c2*c2 * s2*s2*s2*s2 / v2;
    let denom = term1 + term2;

    if denom < 1.0e-30 {
        return 1.0e9;
    }

    let v_eff = u_c_4 / denom;
    min_f64(v_eff, 1.0e9)
}

// Calculate effective degrees of freedom for three uncertainty components
// ν_eff = u_c^4 / (c1^4·s1^4/ν1 + c2^4·s2^4/ν2 + c3^4·s3^4/ν3)
// Terms with ν > 1e8 (Type B, DOF=∞) contribute 0 to the denominator.
pub fn welch_satterthwaite_3(u1: GUMUncertainty, u2: GUMUncertainty, u3: GUMUncertainty) -> f64 with Div {
    let c1 = u1.sensitivity
    let s1 = u1.std_uncertainty
    let v1 = u1.degrees_of_freedom
    let c2 = u2.sensitivity
    let s2 = u2.std_uncertainty
    let v2 = u2.degrees_of_freedom
    let c3 = u3.sensitivity
    let s3 = u3.std_uncertainty
    let v3 = u3.degrees_of_freedom
    let u_c_sq = c1*c1*s1*s1 + c2*c2*s2*s2 + c3*c3*s3*s3
    let u_c_4 = u_c_sq * u_c_sq
    let t1 = if v1 > 1.0e8 { 0.0 } else { c1*c1*c1*c1 * s1*s1*s1*s1 / v1 }
    let t2 = if v2 > 1.0e8 { 0.0 } else { c2*c2*c2*c2 * s2*s2*s2*s2 / v2 }
    let t3 = if v3 > 1.0e8 { 0.0 } else { c3*c3*c3*c3 * s3*s3*s3*s3 / v3 }
    let denom = t1 + t2 + t3
    if denom < 1.0e-30 {
        return 1.0e9
    }
    let v_eff = u_c_4 / denom
    min_f64(v_eff, 1.0e9)
}

// =============================================================================
// GUM Result Type
// =============================================================================

/// Complete GUM measurement result.
///
/// # Builder Pattern
///
/// ```sio
/// let result = GUMResult::from_value(10.0)
///     .with_uncertainty(0.1)
///     .with_dof(9);
///
/// let type_a = GUMResult::type_a(10.0, 0.5, 10);
/// let type_b = GUMResult::type_b(10.0, 0.1);
///
/// let combined = type_a.combine(&type_b);
/// ```
pub struct GUMResult {
    // Best estimate (measured value)
    pub value: f64,

    // Combined standard uncertainty u_c
    pub std_uncertainty: f64,

    // Effective degrees of freedom
    pub degrees_of_freedom: f64,

    // Coverage factor k (for 95% expanded uncertainty)
    pub coverage_factor_95: f64,

    // Expanded uncertainty U = k * u_c (at 95%)
    pub expanded_uncertainty_95: f64,
}

// =============================================================================
// GUMResult Builder Pattern
// =============================================================================

impl GUMResult {
    /// Create a GUM result from just a value (zero uncertainty).
    pub fn from_value(value: f64) -> GUMResult {
        GUMResult {
            value: value,
            std_uncertainty: 0.0,
            degrees_of_freedom: 1.0e9,
            coverage_factor_95: 1.96,
            expanded_uncertainty_95: 0.0,
        }
    }

    /// Create a simple GUM result from value and standard uncertainty.
    /// Assumes infinite degrees of freedom (Type B).
    pub fn simple(value: f64, std_u: f64) -> GUMResult {
        let k = k_normal_95();
        GUMResult {
            value: value,
            std_uncertainty: abs_f64(std_u),
            degrees_of_freedom: 1.0e9,
            coverage_factor_95: k,
            expanded_uncertainty_95: k * abs_f64(std_u),
        }
    }

    /// Create GUM result from Type A uncertainty.
    pub fn type_a(value: f64, std_dev: f64, n: usize) -> GUMResult {
        let u = GUMUncertainty::type_a(std_dev, n);
        let k = coverage_factor_95(u.degrees_of_freedom);
        GUMResult {
            value: value,
            std_uncertainty: u.std_uncertainty,
            degrees_of_freedom: u.degrees_of_freedom,
            coverage_factor_95: k,
            expanded_uncertainty_95: k * u.std_uncertainty,
        }
    }

    /// Create GUM result from Type B uncertainty.
    pub fn type_b(value: f64, std_u: f64) -> GUMResult {
        let u = GUMUncertainty::type_b(std_u);
        let k = k_normal_95();
        GUMResult {
            value: value,
            std_uncertainty: u.std_uncertainty,
            degrees_of_freedom: u.degrees_of_freedom,
            coverage_factor_95: k,
            expanded_uncertainty_95: k * u.std_uncertainty,
        }
    }

    /// Set uncertainty for method chaining.
    pub fn with_uncertainty(self: GUMResult, std_u: f64) -> GUMResult with Mut {
        var result = self
        result.std_uncertainty = abs_f64(std_u)
        result.expanded_uncertainty_95 = result.coverage_factor_95 * result.std_uncertainty
        result
    }

    /// Set degrees of freedom for method chaining.
    pub fn with_dof(self: GUMResult, dof: f64) -> GUMResult with Mut {
        var result = self
        result.degrees_of_freedom = dof
        result.coverage_factor_95 = coverage_factor_95(dof)
        result.expanded_uncertainty_95 = result.coverage_factor_95 * result.std_uncertainty
        result
    }

    /// Add another GUM result (uncertainty propagation).
    pub fn add(self: &GUMResult, other: &GUMResult) -> GUMResult with Mut, Div {
        gum_add(GUMResult { value: self.value, std_uncertainty: self.std_uncertainty, degrees_of_freedom: self.degrees_of_freedom, coverage_factor_95: self.coverage_factor_95, expanded_uncertainty_95: self.expanded_uncertainty_95 }, GUMResult { value: other.value, std_uncertainty: other.std_uncertainty, degrees_of_freedom: other.degrees_of_freedom, coverage_factor_95: other.coverage_factor_95, expanded_uncertainty_95: other.expanded_uncertainty_95 })
    }

    /// Subtract another GUM result (uncertainty propagation).
    pub fn sub(self: &GUMResult, other: &GUMResult) -> GUMResult with Mut, Div {
        gum_sub(GUMResult { value: self.value, std_uncertainty: self.std_uncertainty, degrees_of_freedom: self.degrees_of_freedom, coverage_factor_95: self.coverage_factor_95, expanded_uncertainty_95: self.expanded_uncertainty_95 }, GUMResult { value: other.value, std_uncertainty: other.std_uncertainty, degrees_of_freedom: other.degrees_of_freedom, coverage_factor_95: other.coverage_factor_95, expanded_uncertainty_95: other.expanded_uncertainty_95 })
    }

    /// Multiply by another GUM result (uncertainty propagation).
    pub fn mul(self: &GUMResult, other: &GUMResult) -> GUMResult with Mut, Div {
        gum_mul(GUMResult { value: self.value, std_uncertainty: self.std_uncertainty, degrees_of_freedom: self.degrees_of_freedom, coverage_factor_95: self.coverage_factor_95, expanded_uncertainty_95: self.expanded_uncertainty_95 }, GUMResult { value: other.value, std_uncertainty: other.std_uncertainty, degrees_of_freedom: other.degrees_of_freedom, coverage_factor_95: other.coverage_factor_95, expanded_uncertainty_95: other.expanded_uncertainty_95 })
    }

    /// Divide by another GUM result (uncertainty propagation).
    pub fn div(self: &GUMResult, other: &GUMResult) -> GUMResult with Mut, Div {
        gum_div(GUMResult { value: self.value, std_uncertainty: self.std_uncertainty, degrees_of_freedom: self.degrees_of_freedom, coverage_factor_95: self.coverage_factor_95, expanded_uncertainty_95: self.expanded_uncertainty_95 }, GUMResult { value: other.value, std_uncertainty: other.std_uncertainty, degrees_of_freedom: other.degrees_of_freedom, coverage_factor_95: other.coverage_factor_95, expanded_uncertainty_95: other.expanded_uncertainty_95 })
    }

    /// Scale by a constant.
    pub fn scale(&self, factor: f64) -> GUMResult {
        let k = coverage_factor_95(self.degrees_of_freedom);
        GUMResult {
            value: self.value * factor,
            std_uncertainty: abs_f64(factor) * self.std_uncertainty,
            degrees_of_freedom: self.degrees_of_freedom,
            coverage_factor_95: k,
            expanded_uncertainty_95: k * abs_f64(factor) * self.std_uncertainty,
        }
    }

    /// Get relative uncertainty (u / |value|).
    pub fn relative_uncertainty(&self) -> f64 {
        if abs_f64(self.value) < 1.0e-30 {
            return 0.0;
        }
        self.std_uncertainty / abs_f64(self.value)
    }

    /// Get relative uncertainty (u / |value|) as percentage [0, 100].
    pub fn relative_uncertainty_pct(&self) -> f64 {
        if abs_f64(self.value) < 1.0e-30 { return 100.0 }
        100.0 * self.std_uncertainty / abs_f64(self.value)
    }
}

// =============================================================================
// Standalone Functions (Backward Compatibility)
// =============================================================================

/// Create a simple GUM result from value and standard uncertainty.
/// Assumes infinite degrees of freedom (Type B).
pub fn gum_simple(value: f64, std_u: f64) -> GUMResult {
    let k = k_normal_95()
    GUMResult {
        value: value,
        std_uncertainty: abs_f64(std_u),
        degrees_of_freedom: 1.0e9,
        coverage_factor_95: k,
        expanded_uncertainty_95: k * abs_f64(std_u),
    }
}

/// Create GUM result from Type A uncertainty.
pub fn gum_type_a(value: f64, std_dev: f64, n: i64) -> GUMResult with Mut, Div {
    let u = type_a_uncertainty(std_dev, n)
    let k = coverage_factor_95(u.degrees_of_freedom)
    GUMResult {
        value: value,
        std_uncertainty: u.std_uncertainty,
        degrees_of_freedom: u.degrees_of_freedom,
        coverage_factor_95: k,
        expanded_uncertainty_95: k * u.std_uncertainty,
    }
}

// =============================================================================
// Uncertainty Propagation
// =============================================================================

// Propagate uncertainty through addition: y = x1 + x2
pub fn gum_add(x1: GUMResult, x2: GUMResult) -> GUMResult with Mut, Div {
    let value = x1.value + x2.value;

    // Combined variance (sensitivities both = 1)
    let var1 = x1.std_uncertainty * x1.std_uncertainty;
    let var2 = x2.std_uncertainty * x2.std_uncertainty;
    let std_u = sqrt_f64(var1 + var2);

    // Effective DoF via Welch-Satterthwaite
    let u1 = GUMUncertainty {
        std_uncertainty: x1.std_uncertainty,
        degrees_of_freedom: x1.degrees_of_freedom,
        sensitivity: 1.0,
    };
    let u2 = GUMUncertainty {
        std_uncertainty: x2.std_uncertainty,
        degrees_of_freedom: x2.degrees_of_freedom,
        sensitivity: 1.0,
    };
    let dof = welch_satterthwaite_2(u1, u2);
    let k = coverage_factor_95(dof);

    GUMResult {
        value: value,
        std_uncertainty: std_u,
        degrees_of_freedom: dof,
        coverage_factor_95: k,
        expanded_uncertainty_95: k * std_u,
    }
}

// Propagate uncertainty through subtraction: y = x1 - x2
pub fn gum_sub(x1: GUMResult, x2: GUMResult) -> GUMResult with Mut, Div {
    let value = x1.value - x2.value;

    // Same as addition for variance
    let var1 = x1.std_uncertainty * x1.std_uncertainty;
    let var2 = x2.std_uncertainty * x2.std_uncertainty;
    let std_u = sqrt_f64(var1 + var2);

    let u1 = GUMUncertainty {
        std_uncertainty: x1.std_uncertainty,
        degrees_of_freedom: x1.degrees_of_freedom,
        sensitivity: 1.0,
    };
    let u2 = GUMUncertainty {
        std_uncertainty: x2.std_uncertainty,
        degrees_of_freedom: x2.degrees_of_freedom,
        sensitivity: 1.0,
    };
    let dof = welch_satterthwaite_2(u1, u2);
    let k = coverage_factor_95(dof);

    GUMResult {
        value: value,
        std_uncertainty: std_u,
        degrees_of_freedom: dof,
        coverage_factor_95: k,
        expanded_uncertainty_95: k * std_u,
    }
}

// Propagate uncertainty through multiplication: y = x1 * x2
pub fn gum_mul(x1: GUMResult, x2: GUMResult) -> GUMResult with Mut, Div {
    let value = x1.value * x2.value;

    // Sensitivity coefficients: ∂y/∂x1 = x2, ∂y/∂x2 = x1
    let c1 = abs_f64(x2.value);
    let c2 = abs_f64(x1.value);

    let var1 = c1 * c1 * x1.std_uncertainty * x1.std_uncertainty;
    let var2 = c2 * c2 * x2.std_uncertainty * x2.std_uncertainty;
    let std_u = sqrt_f64(var1 + var2);

    let u1 = GUMUncertainty {
        std_uncertainty: x1.std_uncertainty,
        degrees_of_freedom: x1.degrees_of_freedom,
        sensitivity: c1,
    };
    let u2 = GUMUncertainty {
        std_uncertainty: x2.std_uncertainty,
        degrees_of_freedom: x2.degrees_of_freedom,
        sensitivity: c2,
    };
    let dof = welch_satterthwaite_2(u1, u2);
    let k = coverage_factor_95(dof);

    GUMResult {
        value: value,
        std_uncertainty: std_u,
        degrees_of_freedom: dof,
        coverage_factor_95: k,
        expanded_uncertainty_95: k * std_u,
    }
}

// Propagate uncertainty through division: y = x1 / x2
pub fn gum_div(x1: GUMResult, x2: GUMResult) -> GUMResult with Mut, Div {
    if abs_f64(x2.value) < 1.0e-15 {
        return GUMResult {
            value: 0.0,
            std_uncertainty: 1.0e308,
            degrees_of_freedom: 1.0,
            coverage_factor_95: 12.71,
            expanded_uncertainty_95: 1.0e308,
        };
    }

    let value = x1.value / x2.value;

    // Sensitivity coefficients: ∂y/∂x1 = 1/x2, ∂y/∂x2 = -x1/x2^2
    let c1 = 1.0 / abs_f64(x2.value);
    let c2 = abs_f64(x1.value) / (x2.value * x2.value);

    let var1 = c1 * c1 * x1.std_uncertainty * x1.std_uncertainty;
    let var2 = c2 * c2 * x2.std_uncertainty * x2.std_uncertainty;
    let std_u = sqrt_f64(var1 + var2);

    let u1 = GUMUncertainty {
        std_uncertainty: x1.std_uncertainty,
        degrees_of_freedom: x1.degrees_of_freedom,
        sensitivity: c1,
    };
    let u2 = GUMUncertainty {
        std_uncertainty: x2.std_uncertainty,
        degrees_of_freedom: x2.degrees_of_freedom,
        sensitivity: c2,
    };
    let dof = welch_satterthwaite_2(u1, u2);
    let k = coverage_factor_95(dof);

    GUMResult {
        value: value,
        std_uncertainty: std_u,
        degrees_of_freedom: dof,
        coverage_factor_95: k,
        expanded_uncertainty_95: k * std_u,
    }
}

// =============================================================================
// Convenience Functions
// =============================================================================

pub struct GUMInterval {
    lo: f64,
    hi: f64,
}

// Get 95% confidence interval from GUM result
pub fn gum_interval_95(result: GUMResult) -> GUMInterval {
    let lo = result.value - result.expanded_uncertainty_95;
    let hi = result.value + result.expanded_uncertainty_95;
    GUMInterval { lo: lo, hi: hi }
}

// Get relative uncertainty as percentage
pub fn relative_uncertainty_percent(result: GUMResult) -> f64 {
    if abs_f64(result.value) < 1.0e-15 {
        return 100.0;
    }
    100.0 * result.std_uncertainty / abs_f64(result.value)
}

// =============================================================================
// Second-Order GUM Variance (β⁸-verified)
// =============================================================================
//
// Closes Butterfly #1 from the β⁸ plan: wires the compiler's Hessian-AD
// shadow channels into GUM uncertainty propagation.
//
// The classical first-order GUM formula σ²_1st(f) = JᵀΣJ is exact only for
// linear functions.  For nonlinear f, ISO GUM §5.1.2 notes that a
// second-order correction is required:
//
//     σ²_2nd(f) = Jᵀ·Σ·J + ½·tr(H·Σ·H·Σ)
//
// where J is the 8-vector of first-order sensitivities (∂f/∂x_k), H is the
// 8×8 symmetric Hessian (∂²f/∂x_j∂x_k), and Σ is the input covariance.
//
// The formal counterpart (proving σ²_2nd ≥ σ²_1st under symmetric H and PSD Σ)
// is in `formal/SecondOrderGUM.lean`, theorem `second_order_dominates_first_order_float`.
//
// Usage pattern (caller computes J, H at the call site via `sensitivity_of`
// and `hessian_of` compiler builtins):
//
//   fn my_model(...) -> f64 with IO, Epistemic {
//       let k0: Knowledge<f64> = measure(...)
//       let k1: Knowledge<f64> = measure(...)
//       let x = k0.value
//       let y = k1.value
//       let z = x * x * y   // some nonlinear function
//       let j: [f64; 8] = [
//           sensitivity_of(z, 0), sensitivity_of(z, 1),
//           sensitivity_of(z, 2), sensitivity_of(z, 3),
//           sensitivity_of(z, 4), sensitivity_of(z, 5),
//           sensitivity_of(z, 6), sensitivity_of(z, 7),
//       ]
//       let h: [f64; 36] = hessian_upper_from_expr_z()  // user collects all 36
//       let sigma = ...  // CovarianceMatrix
//       let sigma2 = gum_second_order_variance(j, h, sigma)
//   }

// Upper-triangular index for an 8-variable Hessian, row-major.
// For (i, j) with 0 <= i <= j < 8, returns index into [f64; 36].
//
//   row 0 starts at offset 0  (8 elements: 0..7)
//   row 1 starts at offset 8  (7 elements: 8..14)
//   row 2 starts at offset 15 (6 elements: 15..20)
//   ...
//   row i starts at offset 8*i - i*(i-1)/2
//   (i,j) index = 8*i - i*(i-1)/2 + (j - i)
fn hess_tri_idx_8(i: i32, j: i32) -> i32 {
    var r = i
    var c = j
    if r > c {
        r = j
        c = i
    }
    return 8 * r - (r * (r - 1)) / 2 + (c - r)
}

// Fetch Hessian entry H_{i,j} from the 36-element upper-triangle array.
fn hess_get_8(h: [f64; 36], i: i32, j: i32) -> f64 {
    return h[hess_tri_idx_8(i, j)]
}

// Classical first-order GUM quadratic form:
//   σ²_1st = Σ_{i,k} J[i] · Σ[i,k] · J[k]
// Exposed as helper for tests that compare first- vs second-order results.
pub fn gum_first_order_variance(j: [f64; 8], sigma: &CovarianceMatrix) -> f64 {
    var acc: f64 = 0.0
    var i: i32 = 0
    while i < 8 {
        var k: i32 = 0
        while k < 8 {
            let sij = cov_get(sigma, i, k)
            acc = acc + j[i] * sij * j[k]
            k = k + 1
        }
        i = i + 1
    }
    return acc
}

// Second-order GUM trace correction:
//   tr(H Σ H Σ) = Σ_{i,j,k,l} H_{i,j} · Σ_{j,k} · H_{k,l} · Σ_{l,i}
//
// Returns tr(HΣHΣ) (unnormalised).  The caller multiplies by 0.5 when
// assembling the full second-order variance, mirroring the Lean definitions
// in `formal/SecondOrderGUM.lean`.
pub fn gum_trace_hshs(h: [f64; 36], sigma: &CovarianceMatrix) -> f64 {
    var acc: f64 = 0.0
    var i: i32 = 0
    while i < 8 {
        var j: i32 = 0
        while j < 8 {
            let h_ij = hess_get_8(h, i, j)
            var k: i32 = 0
            while k < 8 {
                let s_jk = cov_get(sigma, j, k)
                var l: i32 = 0
                while l < 8 {
                    let h_kl = hess_get_8(h, k, l)
                    let s_li = cov_get(sigma, l, i)
                    acc = acc + h_ij * s_jk * h_kl * s_li
                    l = l + 1
                }
                k = k + 1
            }
            j = j + 1
        }
        i = i + 1
    }
    return acc
}

// Full second-order GUM variance:
//   σ²_2nd(f) = J^T Σ J + ½ · tr(H Σ H Σ)
//
// See `formal/SecondOrderGUM.lean` for the formal proof of the domination
// inequality σ²_2nd ≥ σ²_1st under symmetric H and PSD Σ.
pub fn gum_second_order_variance(
    j: [f64; 8],
    h: [f64; 36],
    sigma: &CovarianceMatrix,
) -> f64 with Mut, Div {
    let v1 = gum_first_order_variance(j, sigma)
    let trace = gum_trace_hshs(h, sigma)
    return v1 + 0.5 * trace
}

