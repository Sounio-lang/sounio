//@ run-pass
//@ expect-stdout: ALL PASS

// stdlib/epistemic/gum.sio — GUM-compliant uncertainty propagation
//
// Implements JCGM 100:2008 uncertainty framework:
//   - Type A (statistical) and Type B (a priori) uncertainty components
//   - Combined standard uncertainty via sensitivity coefficients
//   - Welch-Satterthwaite effective degrees of freedom
//   - Coverage factors from t-distribution table
//   - Expanded uncertainty at 95% and 99% confidence
//
// Reference: JCGM 100:2008 (GUM)
//
// USAGE: `use epistemic::gum::*`, `use epistemic::gum::{name}`, or path-form
// `use epistemic::gum::name` (path-form named import fixed under Madaros D4;
// see docs/audit/MADAROS_MULTIMODULE_PRINT_IMPORT_BUGS_2026-07-13.md).
// print_f64 is allowed in multi-module programs after the visibility allow-list fix (#1239).

// ============================================================================
// HELPERS
// ============================================================================

fn gum_sqrt(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y
}

fn gum_abs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }
fn gum_min(a: f64, b: f64) -> f64 { if a < b { a } else { b } }
fn gum_max(a: f64, b: f64) -> f64 { if a > b { a } else { b } }

// t-distribution 95% quantile by degrees of freedom (1-based lookup)
fn t95(dof: i64) -> f64 with Div, Panic {
    if dof <= 0 { return 12.71 }
    if dof == 1 { return 12.71 }
    if dof == 2 { return 4.303 }
    if dof == 3 { return 3.182 }
    if dof == 4 { return 2.776 }
    if dof == 5 { return 2.571 }
    if dof == 6 { return 2.447 }
    if dof == 7 { return 2.365 }
    if dof == 8 { return 2.306 }
    if dof == 9 { return 2.262 }
    if dof == 10 { return 2.228 }
    if dof == 11 { return 2.201 }
    if dof == 12 { return 2.179 }
    if dof == 13 { return 2.160 }
    if dof == 14 { return 2.145 }
    if dof == 15 { return 2.131 }
    if dof == 16 { return 2.120 }
    if dof == 17 { return 2.110 }
    if dof == 18 { return 2.101 }
    if dof == 19 { return 2.093 }
    if dof < 30 { return 2.086 }
    if dof < 60 { return 2.042 }
    if dof < 120 { return 2.000 }
    1.96  // normal approximation
}

fn t99(dof: i64) -> f64 with Div, Panic {
    if dof <= 0 { return 63.66 }
    if dof == 1 { return 63.66 }
    if dof == 2 { return 9.925 }
    if dof == 3 { return 5.841 }
    if dof == 4 { return 4.604 }
    if dof == 5 { return 4.032 }
    if dof == 6 { return 3.707 }
    if dof == 7 { return 3.499 }
    if dof == 8 { return 3.355 }
    if dof == 9 { return 3.250 }
    if dof == 10 { return 3.169 }
    if dof < 20 { return 2.845 }
    if dof < 30 { return 2.763 }
    2.576  // normal approximation
}

// Convert f64 dof to i64 for table lookup (infinity → large value).
// Madaros D1 (#983): casting an f64 *parameter* to i64 is a bitcast, not trunc.
// Arithmetic-source first so the cast is on a local and emits IrFloatToInt.
// Also round to nearest: Welch–Satterthwaite often yields 3.999999 for ν=4;
// truncate-toward-zero would select t95(3)=3.182 instead of t95(4)=2.776.
// Do NOT set param scalar_kind=2 globally — that unmasks D5 (#986).
fn dof_to_i64(dof: f64) -> i64 with Div, Panic {
    if dof > 1.0e8 { return 10000 }
    let d = dof + 0.5
    return d as i64
}

// ============================================================================
// UNCERTAINTY COMPONENT
// ============================================================================

// A single uncertainty source with sensitivity coefficient and degrees of freedom.
pub struct GUMComponent {
    std_u: f64,        // standard uncertainty u(x_i)
    sensitivity: f64,  // sensitivity coefficient c_i = ∂f/∂x_i
    dof: f64,          // degrees of freedom ν_i (1e9 = infinity for Type B)
}

// Type A: statistical, u = std_dev / sqrt(n), ν = n-1
pub fn gum_type_a(std_dev: f64, n: i64) -> GUMComponent with Mut, Div, Panic {
    let denom = if n > 0 { gum_sqrt(n as f64) } else { 1.0 }
    let std_u = if n > 0 { std_dev / denom } else { std_dev }
    let dof = if n > 1 { (n - 1) as f64 } else { 1.0 }
    GUMComponent { std_u: std_u, sensitivity: 1.0, dof: dof }
}

// Type B: a priori, ν = ∞ (1e9)
pub fn gum_type_b(std_u: f64) -> GUMComponent {
    GUMComponent { std_u: gum_abs(std_u), sensitivity: 1.0, dof: 1.0e9 }
}

// Type B from uniform distribution ±a: u = a/sqrt(3)
pub fn gum_type_b_uniform(half_width: f64) -> GUMComponent {
    let std_u = gum_abs(half_width) / 1.732050808
    GUMComponent { std_u: std_u, sensitivity: 1.0, dof: 1.0e9 }
}

// Type B from triangular distribution ±a: u = a/sqrt(6)
pub fn gum_type_b_triangular(half_width: f64) -> GUMComponent {
    let std_u = gum_abs(half_width) / 2.449489743
    GUMComponent { std_u: std_u, sensitivity: 1.0, dof: 1.0e9 }
}

// Type B from expanded uncertainty U with coverage factor k
pub fn gum_type_b_expanded(expanded_u: f64, k: f64) -> GUMComponent with Div, Panic {
    let std_u = if k > 0.0 { expanded_u / k } else { expanded_u }
    GUMComponent { std_u: gum_abs(std_u), sensitivity: 1.0, dof: 1.0e9 }
}

pub fn gum_with_sensitivity(c: GUMComponent, s: f64) -> GUMComponent {
    GUMComponent { std_u: c.std_u, sensitivity: s, dof: c.dof }
}

// ============================================================================
// GUM RESULT
// ============================================================================

pub struct GUMResult {
    value: f64,
    std_u: f64,        // combined standard uncertainty u_c
    dof: f64,          // effective degrees of freedom ν_eff
    k95: f64,          // coverage factor at 95%
    u95: f64,          // expanded uncertainty at 95%
    k99: f64,          // coverage factor at 99%
    u99: f64,          // expanded uncertainty at 99%
}

fn gum_result_from_parts(value: f64, std_u: f64, dof: f64) -> GUMResult with Div, Panic {
    let di = dof_to_i64(dof)
    let k95v = t95(di)
    let k99v = t99(di)
    GUMResult {
        value: value,
        std_u: std_u,
        dof: dof,
        k95: k95v,
        u95: k95v * std_u,
        k99: k99v,
        u99: k99v * std_u,
    }
}

// Welch-Satterthwaite: ν_eff = u_c^4 / Σ (c_i u_i)^4 / ν_i
// Two-component version
fn ws2(u1: GUMComponent, u2: GUMComponent) -> f64 with Div, Panic {
    let cu1 = u1.sensitivity * u1.std_u
    let cu2 = u2.sensitivity * u2.std_u
    let u_c_sq = cu1 * cu1 + cu2 * cu2
    let u_c_4 = u_c_sq * u_c_sq
    let t1 = if u1.dof > 1.0e8 { 0.0 } else { cu1 * cu1 * cu1 * cu1 / u1.dof }
    let t2 = if u2.dof > 1.0e8 { 0.0 } else { cu2 * cu2 * cu2 * cu2 / u2.dof }
    let denom = t1 + t2
    if denom < 1.0e-30 { return 1.0e9 }
    gum_min(u_c_4 / denom, 1.0e9)
}

// Combine two GUM components with sensitivity coefficients
pub fn gum_combine2(value: f64, u1: GUMComponent, u2: GUMComponent) -> GUMResult with Mut, Div, Panic {
    let cu1 = u1.sensitivity * u1.std_u
    let cu2 = u2.sensitivity * u2.std_u
    let std_u = gum_sqrt(cu1 * cu1 + cu2 * cu2)
    let dof = ws2(u1, u2)
    gum_result_from_parts(value, std_u, dof)
}

// Combine three GUM components
pub fn gum_combine3(value: f64, u1: GUMComponent, u2: GUMComponent, u3: GUMComponent) -> GUMResult with Mut, Div, Panic {
    let cu1 = u1.sensitivity * u1.std_u
    let cu2 = u2.sensitivity * u2.std_u
    let cu3 = u3.sensitivity * u3.std_u
    let std_u = gum_sqrt(cu1*cu1 + cu2*cu2 + cu3*cu3)
    let t1 = if u1.dof > 1.0e8 { 0.0 } else { cu1*cu1*cu1*cu1 / u1.dof }
    let t2 = if u2.dof > 1.0e8 { 0.0 } else { cu2*cu2*cu2*cu2 / u2.dof }
    let t3 = if u3.dof > 1.0e8 { 0.0 } else { cu3*cu3*cu3*cu3 / u3.dof }
    let u_c_sq = cu1*cu1 + cu2*cu2 + cu3*cu3
    let u_c_4 = u_c_sq * u_c_sq
    let denom = t1 + t2 + t3
    let dof = if denom < 1.0e-30 { 1.0e9 } else { gum_min(u_c_4 / denom, 1.0e9) }
    gum_result_from_parts(value, std_u, dof)
}

// ============================================================================
// ARITHMETIC PROPAGATION (standalone GUM-compliant operations)
// ============================================================================

// y = x1 + x2: sensitivities both 1, Var(y) = Var(x1) + Var(x2)
pub fn gum_add(x1: GUMResult, x2: GUMResult) -> GUMResult with Mut, Div, Panic {
    let u1 = GUMComponent { std_u: x1.std_u, sensitivity: 1.0, dof: x1.dof }
    let u2 = GUMComponent { std_u: x2.std_u, sensitivity: 1.0, dof: x2.dof }
    gum_combine2(x1.value + x2.value, u1, u2)
}

// y = x1 - x2: same variance as addition
pub fn gum_sub(x1: GUMResult, x2: GUMResult) -> GUMResult with Mut, Div, Panic {
    let u1 = GUMComponent { std_u: x1.std_u, sensitivity: 1.0, dof: x1.dof }
    let u2 = GUMComponent { std_u: x2.std_u, sensitivity: 1.0, dof: x2.dof }
    gum_combine2(x1.value - x2.value, u1, u2)
}

// y = x1 * x2: c1 = |x2|, c2 = |x1| (delta method)
pub fn gum_mul(x1: GUMResult, x2: GUMResult) -> GUMResult with Mut, Div, Panic {
    let u1 = GUMComponent { std_u: x1.std_u, sensitivity: gum_abs(x2.value), dof: x1.dof }
    let u2 = GUMComponent { std_u: x2.std_u, sensitivity: gum_abs(x1.value), dof: x2.dof }
    gum_combine2(x1.value * x2.value, u1, u2)
}

// y = x1 / x2: c1 = 1/|x2|, c2 = |x1|/x2² (delta method)
pub fn gum_div(x1: GUMResult, x2: GUMResult) -> GUMResult with Mut, Div, Panic {
    if gum_abs(x2.value) < 1.0e-15 {
        return gum_result_from_parts(0.0, 1.0e308, 1.0)
    }
    let c1 = 1.0 / gum_abs(x2.value)
    let c2 = gum_abs(x1.value) / (x2.value * x2.value)
    let u1 = GUMComponent { std_u: x1.std_u, sensitivity: c1, dof: x1.dof }
    let u2 = GUMComponent { std_u: x2.std_u, sensitivity: c2, dof: x2.dof }
    gum_combine2(x1.value / x2.value, u1, u2)
}

// Scale by constant c: c1 = |c|, Var(c·x) = c²·Var(x)
pub fn gum_scale(x: GUMResult, c: f64) -> GUMResult with Div, Panic {
    gum_result_from_parts(x.value * c, gum_abs(c) * x.std_u, x.dof)
}

// Accessors
pub fn gum_value(r: GUMResult) -> f64 { r.value }
pub fn gum_std_u(r: GUMResult) -> f64 { r.std_u }
pub fn gum_u95(r: GUMResult) -> f64 { r.u95 }
pub fn gum_u99(r: GUMResult) -> f64 { r.u99 }
pub fn gum_dof(r: GUMResult) -> f64 { r.dof }
pub fn gum_k95(r: GUMResult) -> f64 { r.k95 }

// Formatted ISO-GUM report to stdout. Floats print via print(f64) (never print_f64
// in importing programs — Madaros bug, see module header).
pub fn gum_report(label: string, unit: string, r: GUMResult) with IO, Mut, Div, Panic {
    print(label)
    print(" = ")
    // negative-safe: print(f64) drops the magnitude of negatives on current Madaros
    // (docs/audit/MADAROS_PRINT_NEGATIVE_F64_2026-07-14.md); the value may be negative.
    let v = gum_value(r)
    if v < 0.0 { print("-"); print(0.0 - v) } else { print(v) }
    print(" ± ")
    print(gum_u95(r))
    print(" ")
    print(unit)
    print("   (k = ")
    print(gum_k95(r))
    print(", 95%)\n    u_c = ")
    print(gum_std_u(r))
    print(" ")
    print(unit)
    print(",  nu_eff = ")
    print(gum_dof(r))
    print("\n")
}

pub fn gum_rel_uncertainty(r: GUMResult) -> f64 with Div, Panic {
    if gum_abs(r.value) < 1.0e-15 { return 0.0 }
    r.std_u / gum_abs(r.value)
}

// Simple constructors
pub fn gum_simple(value: f64, std_u: f64) -> GUMResult with Div, Panic {
    gum_result_from_parts(value, std_u, 1.0e9)
}

// ============================================================================
// BACKWARD-COMPATIBILITY: GUMUncertainty (legacy struct used by some tests)
// ============================================================================

pub struct GUMUncertainty {
    std_uncertainty: f64,
    degrees_of_freedom: f64,
    sensitivity: f64,
}

/// Welch-Satterthwaite for three components (legacy API).
pub fn welch_satterthwaite_3(u1: GUMUncertainty, u2: GUMUncertainty, u3: GUMUncertainty) -> f64 with Mut, Div, Panic {
    let c1 = u1.sensitivity * u1.std_uncertainty
    let c2 = u2.sensitivity * u2.std_uncertainty
    let c3 = u3.sensitivity * u3.std_uncertainty
    let u_c_sq = c1*c1 + c2*c2 + c3*c3
    let u_c_4 = u_c_sq * u_c_sq
    let t1 = if u1.degrees_of_freedom > 1.0e8 { 0.0 } else { c1*c1*c1*c1 / u1.degrees_of_freedom }
    let t2 = if u2.degrees_of_freedom > 1.0e8 { 0.0 } else { c2*c2*c2*c2 / u2.degrees_of_freedom }
    let t3 = if u3.degrees_of_freedom > 1.0e8 { 0.0 } else { c3*c3*c3*c3 / u3.degrees_of_freedom }
    let denom = t1 + t2 + t3
    if denom < 1.0e-30 { return 1.0e9 }
    gum_min(u_c_4 / denom, 1.0e9)
}

/// Coverage factor at 95 %% from effective DOF (legacy API).
pub fn coverage_factor_95(dof: f64) -> f64 with Div, Panic {
    t95(dof_to_i64(dof))
}

// ============================================================================
// TESTS
// ============================================================================

var CNT: [i64; 2] = [0; 2]

fn chk(label: i64, ok: i64) with IO, Mut {
    if ok == 1 {
        print("  PASS ["); print(label); print("]\n")
        CNT[0] = CNT[0] + 1
    } else {
        print("  FAIL ["); print(label); print("]\n")
        CNT[1] = CNT[1] + 1
    }
}

fn near(a: f64, b: f64, tol: f64) -> i64 {
    let d = a - b
    let d2 = if d < 0.0 { 0.0 - d } else { d }
    if d2 <= tol { 1 } else { 0 }
}

fn test_components() with IO, Mut, Div, Panic {
    // Type A: 5 measurements, std_dev = 0.1 → u = 0.1/sqrt(5) ≈ 0.04472, ν = 4
    let a = gum_type_a(0.1, 5)
    chk(1, near(a.std_u, 0.04472135955, 1e-8))
    chk(2, near(a.dof, 4.0, 1e-12))
    chk(3, near(a.sensitivity, 1.0, 1e-12))

    // Type B: std_u = 0.05, ν = ∞
    let b = gum_type_b(0.05)
    chk(4, near(b.std_u, 0.05, 1e-12))
    chk(5, if b.dof > 1.0e8 { 1 } else { 0 })

    // Type B uniform: half_width = 0.1 → u = 0.1/sqrt(3) ≈ 0.05774
    let u = gum_type_b_uniform(0.1)
    chk(6, near(u.std_u, 0.05773502692, 1e-8))
}

fn test_combine() with IO, Mut, Div, Panic {
    // Two Type B components: u1=0.1, c1=1; u2=0.2, c2=1
    // Combined: u_c = sqrt(0.01 + 0.04) = sqrt(0.05) ≈ 0.22361
    let u1 = gum_type_b(0.1)
    let u2 = gum_type_b(0.2)
    let r = gum_combine2(5.0, u1, u2)
    chk(7, near(r.value, 5.0, 1e-12))
    chk(8, near(r.std_u, 0.2236067977, 1e-8))
    // Both Type B → ν_eff = ∞ → k95 = 1.96
    chk(9, near(r.k95, 1.96, 1e-12))
    chk(10, near(r.u95, 1.96 * 0.2236067977, 1e-6))
}

fn test_welch_satterthwaite() with IO, Mut, Div, Panic {
    // Type A: n=5 (ν=4), u=0.1; Type B: u=0.05 (ν=∞)
    // Combined variance: 0.01 + 0.0025 = 0.0125 → u_c = sqrt(0.0125) ≈ 0.11180
    // W-S: only Type A contributes to finite dof sum
    // ν_eff ≈ u_c^4 / (0.1^4/4) = 0.01125² / (0.0001/4) = 0.0000125 / 0.000025... let me compute
    let u1 = gum_type_a(0.1, 5)    // std_u=0.04472, ν=4
    let u2 = gum_type_b(0.05)      // std_u=0.05, ν=∞
    let r = gum_combine2(10.0, u1, u2)
    chk(11, near(r.value, 10.0, 1e-12))
    // u_c = sqrt(0.04472² + 0.05²) = sqrt(0.002 + 0.0025) = sqrt(0.0045) ≈ 0.06708
    chk(12, near(r.std_u, 0.067082039, 1e-6))
    // ν_eff ≈ 0.06708^4 / (0.04472^4/4) ≈ large (Type B dominates)
    // With Type B having ∞ dof, ν_eff gets inflated — just check it's > 10
    chk(13, if r.dof > 5.0 { 1 } else { 0 })
}

fn test_arithmetic() with IO, Mut, Div, Panic {
    // r1 = 10 ± 0.1, r2 = 5 ± 0.2 (both Type B, ν=∞)
    let r1 = gum_simple(10.0, 0.1)
    let r2 = gum_simple(5.0, 0.2)

    // Add: value=15, u_c=sqrt(0.01+0.04)=sqrt(0.05)≈0.22361
    let s = gum_add(r1, r2)
    chk(14, near(s.value, 15.0, 1e-12))
    chk(15, near(s.std_u, 0.2236067977, 1e-8))

    // Sub: value=5, same u_c
    let d = gum_sub(r1, r2)
    chk(16, near(d.value, 5.0, 1e-12))
    chk(17, near(d.std_u, 0.2236067977, 1e-8))

    // Mul: value=50, c1=|r2|=5, c2=|r1|=10
    // u_c = sqrt(25·0.01 + 100·0.04) = sqrt(0.25 + 4.0) = sqrt(4.25) ≈ 2.0616
    let p = gum_mul(r1, r2)
    chk(18, near(p.value, 50.0, 1e-12))
    chk(19, near(p.std_u, 2.0615528, 1e-5))

    // Div: value=2, c1=1/5=0.2, c2=10/25=0.4
    // u_c = sqrt(0.04·0.01 + 0.16·0.04) = sqrt(0.0004 + 0.0064) = sqrt(0.0068) ≈ 0.08246
    let q = gum_div(r1, r2)
    chk(20, near(q.value, 2.0, 1e-12))
    chk(21, near(q.std_u, 0.08246211, 1e-6))

    // Scale: value=20, u_c=0.2
    let sc = gum_scale(r1, 2.0)
    chk(22, near(sc.value, 20.0, 1e-12))
    chk(23, near(sc.std_u, 0.2, 1e-12))
}

fn test_coverage_factors() with IO, Mut, Div, Panic {
    // Normal approximation (ν=∞): k95=1.96
    let r = gum_simple(5.0, 1.0)
    chk(24, near(r.k95, 1.96, 1e-12))
    chk(25, near(r.u95, 1.96, 1e-12))

    // Small DoF: Type A n=3 (ν=2), k95=4.303
    let u = gum_type_a(0.1, 3)   // ν=2
    let r2 = gum_combine2(0.0, u, gum_type_b(0.0))
    chk(26, near(r2.k95, 4.303, 1e-3))
}

pub fn main() -> i32 with IO, Mut, Div, Panic {
    CNT[0] = 0; CNT[1] = 0
    print("─── stdlib/epistemic/gum tests ───\n")
    test_components()
    test_combine()
    test_welch_satterthwaite()
    test_arithmetic()
    test_coverage_factors()
    print("─── "); print(CNT[0]); print("/"); print(CNT[0]+CNT[1]); print(" PASS ───\n")
    if CNT[1] == 0 { print("ALL PASS\n"); 0 } else { 1 }
}
