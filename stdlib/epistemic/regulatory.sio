//! Regulatory context helpers for layered audit tagging.

struct RegulatoryContext {
    iso_17025: bool
    ich_e6: bool
    cfr_part11: bool
}

fn regulatory_default() -> RegulatoryContext {
    RegulatoryContext { iso_17025: true, ich_e6: false, cfr_part11: false }
}

fn regulatory_clinical() -> RegulatoryContext {
    RegulatoryContext { iso_17025: true, ich_e6: true, cfr_part11: false }
}

fn regulatory_fda() -> RegulatoryContext {
    RegulatoryContext { iso_17025: true, ich_e6: true, cfr_part11: true }
}

fn regulatory_layer_tag(ctx: RegulatoryContext) -> i32 {
    if ctx.cfr_part11 { return 3 }
    if ctx.ich_e6 { return 2 }
    if ctx.iso_17025 { return 1 }
    0
}
