// stdlib/epistemic/path.sio
//
// Epistemic Fermentation: path-bearing knowledge surfaces.
//
// This module keeps two notions separate:
//   - value-confidence equivalence: same value and confidence
//   - fermentation equivalence: same admissibility path
//   - knowledge equivalence: both value-confidence and fermentation match
// "Fermentation" is the local Garden name for the route by which a value became
// admissible: measured, imputed, simulated, or later path families.
//
// The typed wrappers are deliberately small. They let current Sounio reject a
// wrong-path call at type-check time while constructors and accessors keep path
// tags inspectable by ordinary runtime gates.
//
// Opacity boundary: non-pub structs are module-private in the active compiler
// path. External callers can receive and pass these witness values, but direct
// struct literal construction and field access are rejected by compile-fail
// tests. The public accessor and constructor functions below remain the narrow
// admissibility surface.
//
// Local checks:
//   - tests/stdlib/epistemic/test_path_fermentation.sio
//   - tests/run-pass/epistemic_fermentation.sio
//   - tests/compile-fail/epistemic_fermentation_wrong_path.sio
//   - tests/compile-fail/epistemic_path_wrong_wrapper.sio
//   - tests/compile-fail/epistemic_path_erasure_requires_discharge.sio
//   - tests/compile-fail/epistemic_path_direct_payload_construction.sio
//   - tests/compile-fail/epistemic_path_direct_wrapper_construction.sio
//   - tests/compile-fail/epistemic_path_private_field_access.sio

struct PathKnowledgeI64 {
    value_i64: i64,
    confidence_permille: i64,
    path_family: i64,
    path_label: i64,
}

struct MeasuredGUMI64 {
    payload: PathKnowledgeI64,
}

struct ImputedModelI64 {
    payload: PathKnowledgeI64,
}

struct SimulationI64 {
    payload: PathKnowledgeI64,
}

struct ErasedPathI64 {
    value_i64: i64,
    confidence_permille: i64,
    source_family: i64,
    discharge_reason_tag: i64,
    discharge_present: bool,
}

fn ep_validate_confidence_permille(confidence_permille: i64) -> i64 with Panic {
    assert(confidence_permille >= 0)
    assert(confidence_permille <= 1000)
    return confidence_permille
}

pub fn ep_path_measured_gum() -> i64 {
    // Family ids are public audit categories. Labels below stay private so
    // external code uses the named predicates instead of reimplementing gates.
    return 1
}

pub fn ep_path_imputed_model() -> i64 {
    // Family ids are public audit categories. Labels below stay private so
    // external code uses the named predicates instead of reimplementing gates.
    return 2
}

pub fn ep_path_simulation() -> i64 {
    // Family ids are public audit categories. Labels below stay private so
    // external code uses the named predicates instead of reimplementing gates.
    return 3
}

fn ep_path_label_measured_gum() -> i64 {
    // Audit label only: not a cryptographic commitment or anti-forgery token.
    return 1101
}

fn ep_path_label_imputed_model() -> i64 {
    // Audit label only: not a cryptographic commitment or anti-forgery token.
    return 2202
}

fn ep_path_label_simulation() -> i64 {
    // Audit label only: not a cryptographic commitment or anti-forgery token.
    return 3303
}

pub fn ep_invalid_reason_tag() -> i64 {
    // Zero is reserved as "no discharge reason supplied" for this witness.
    return 0
}

pub fn ep_discharge_reason_display() -> i64 {
    // Current local display-only discharge reason. Add a registry before adding
    // more public reasons or using this outside internal witnesses.
    return 4404
}

pub fn ep_measured_min_confidence_permille() -> i64 {
    // Non-clinical witness threshold. Values below this remain representable
    // but do not satisfy the current acceptance predicates.
    return 950
}

pub fn ep_imputed_audit_min_confidence_permille() -> i64 {
    // Non-clinical witness threshold for the imputed audit lane.
    return 970
}

pub fn ep_simulation_min_confidence_permille() -> i64 {
    // Non-clinical witness threshold for the simulation lane.
    return 990
}

fn ep_path_payload(value_i64: i64, confidence_permille: i64, path_family: i64, path_label: i64) -> PathKnowledgeI64 with Panic {
    return PathKnowledgeI64 {
        value_i64: value_i64,
        confidence_permille: ep_validate_confidence_permille(confidence_permille),
        path_family: path_family,
        path_label: path_label,
    }
}

// Separate constructors preserve distinct wrapper return types. A single public
// constructor taking a raw family id would erase the call-boundary witness.
pub fn ep_measured_gum_i64(value_i64: i64, confidence_permille: i64) -> MeasuredGUMI64 with Panic {
    return MeasuredGUMI64 {
        payload: ep_path_payload(value_i64, confidence_permille, ep_path_measured_gum(), ep_path_label_measured_gum()),
    }
}

pub fn ep_imputed_model_i64(value_i64: i64, confidence_permille: i64) -> ImputedModelI64 with Panic {
    return ImputedModelI64 {
        payload: ep_path_payload(value_i64, confidence_permille, ep_path_imputed_model(), ep_path_label_imputed_model()),
    }
}

pub fn ep_simulation_i64(value_i64: i64, confidence_permille: i64) -> SimulationI64 with Panic {
    return SimulationI64 {
        payload: ep_path_payload(value_i64, confidence_permille, ep_path_simulation(), ep_path_label_simulation()),
    }
}

pub fn ep_payload_from_measured_gum(k: MeasuredGUMI64) -> PathKnowledgeI64 with Panic {
    // Defense in depth: the compiler blocks external fabrication, and this
    // runtime assertion protects future trusted-module changes.
    assert(ep_accept_measured_gum(k))
    return k.payload
}

pub fn ep_payload_from_imputed_model(k: ImputedModelI64) -> PathKnowledgeI64 with Panic {
    // Defense in depth: the compiler blocks external fabrication, and this
    // runtime assertion protects future trusted-module changes.
    assert(ep_accept_imputed_audit(k))
    return k.payload
}

pub fn ep_payload_from_simulation(k: SimulationI64) -> PathKnowledgeI64 with Panic {
    // Defense in depth: the compiler blocks external fabrication, and this
    // runtime assertion protects future trusted-module changes.
    assert(ep_accept_simulation(k))
    return k.payload
}

pub fn ep_value_i64(k: PathKnowledgeI64) -> i64 {
    return k.value_i64
}

pub fn ep_confidence_permille(k: PathKnowledgeI64) -> i64 {
    return k.confidence_permille
}

pub fn ep_erased_value_i64(k: ErasedPathI64) -> i64 {
    return k.value_i64
}

pub fn ep_erased_confidence_permille(k: ErasedPathI64) -> i64 {
    return k.confidence_permille
}

pub fn ep_erased_source_family(k: ErasedPathI64) -> i64 {
    return k.source_family
}

pub fn ep_erased_reason_tag(k: ErasedPathI64) -> i64 {
    return k.discharge_reason_tag
}

pub fn ep_erased_has_discharge(k: ErasedPathI64) -> bool {
    return k.discharge_present
}

pub fn ep_same_value_confidence(a: PathKnowledgeI64, b: PathKnowledgeI64) -> bool {
    return a.value_i64 == b.value_i64 && a.confidence_permille == b.confidence_permille
}

pub fn ep_same_fermentation(a: PathKnowledgeI64, b: PathKnowledgeI64) -> bool {
    // Unknown families are treated as non-equivalent. This favors false
    // negatives over accidental equivalence.
    if ep_is_known_path_family(a.path_family) == false {
        return false
    }
    if ep_is_known_path_family(b.path_family) == false {
        return false
    }
    return a.path_family == b.path_family && a.path_label == b.path_label
}

pub fn ep_same_knowledge(a: PathKnowledgeI64, b: PathKnowledgeI64) -> bool {
    return ep_same_value_confidence(a, b) && ep_same_fermentation(a, b)
}

fn ep_accept_path_family(k: PathKnowledgeI64, path_family: i64, path_label: i64, min_confidence_permille: i64) -> bool {
    return k.path_family == path_family && k.path_label == path_label && k.confidence_permille >= min_confidence_permille
}

fn ep_is_known_path_family(path_family: i64) -> bool {
    return path_family == ep_path_measured_gum() || path_family == ep_path_imputed_model() || path_family == ep_path_simulation()
}

fn ep_accept_any_known_path(k: PathKnowledgeI64) -> bool {
    if k.path_family == ep_path_measured_gum() {
        return ep_accept_path_family(k, ep_path_measured_gum(), ep_path_label_measured_gum(), ep_measured_min_confidence_permille())
    }
    if k.path_family == ep_path_imputed_model() {
        return ep_accept_path_family(k, ep_path_imputed_model(), ep_path_label_imputed_model(), ep_imputed_audit_min_confidence_permille())
    }
    if k.path_family == ep_path_simulation() {
        return ep_accept_path_family(k, ep_path_simulation(), ep_path_label_simulation(), ep_simulation_min_confidence_permille())
    }
    return false
}

pub fn ep_accept_measured_payload(k: PathKnowledgeI64) -> bool {
    return ep_accept_path_family(k, ep_path_measured_gum(), ep_path_label_measured_gum(), ep_measured_min_confidence_permille())
}

pub fn ep_accept_measured_gum(k: MeasuredGUMI64) -> bool {
    return ep_accept_measured_payload(k.payload)
}

pub fn ep_accept_imputed_audit(k: ImputedModelI64) -> bool {
    return ep_accept_path_family(k.payload, ep_path_imputed_model(), ep_path_label_imputed_model(), ep_imputed_audit_min_confidence_permille())
}

pub fn ep_accept_simulation(k: SimulationI64) -> bool {
    return ep_accept_path_family(k.payload, ep_path_simulation(), ep_path_label_simulation(), ep_simulation_min_confidence_permille())
}

pub fn ep_discharge_path(k: PathKnowledgeI64, reason_tag: i64) -> ErasedPathI64 with Panic {
    assert(ep_accept_any_known_path(k))
    assert(reason_tag != ep_invalid_reason_tag())
    return ErasedPathI64 {
        value_i64: k.value_i64,
        confidence_permille: k.confidence_permille,
        source_family: k.path_family,
        discharge_reason_tag: reason_tag,
        discharge_present: true,
    }
}

pub fn ep_accept_erased_for_display(k: ErasedPathI64) -> bool {
    if k.discharge_present == false {
        return false
    }
    if k.discharge_reason_tag == ep_invalid_reason_tag() {
        return false
    }
    if k.source_family == ep_path_measured_gum() {
        return k.confidence_permille >= ep_measured_min_confidence_permille()
    }
    if k.source_family == ep_path_imputed_model() {
        return k.confidence_permille >= ep_imputed_audit_min_confidence_permille()
    }
    if k.source_family == ep_path_simulation() {
        return k.confidence_permille >= ep_simulation_min_confidence_permille()
    }
    return false
}
