// ============================================================
// Private compact affine capabilities
// ============================================================

affine struct D12SyntheticMonitorRoot {
    serial: i64,
}

affine struct D12CurrentTargetCapability {
    serial: i64,
}

affine struct D12DegradedTargetCapability {
    serial: i64,
}

affine struct D12SuspendedTargetCapability {
    serial: i64,
}

affine struct D12RevokedTargetCapability {
    serial: i64,
}

// These types deliberately have no producers in the standard library.
affine struct D12ProductionDeploymentAuthority {
    authority_id: i64,
}

affine struct D12ClinicalActionAuthority {
    authority_id: i64,
}

affine struct D12InstitutionalMonitorAuthority {
    authority_id: i64,
}

affine struct D12TrustedExternalMonitorRoot {
    root_id: i64,
}

pub fn d12_accept_synthetic_monitor_root(
    root: D12SyntheticMonitorRoot,
) -> i64 { root.serial }

pub fn d12_accept_current_capability(
    cap: D12CurrentTargetCapability,
) -> i64 { cap.serial }

pub fn d12_accept_degraded_capability(
    cap: D12DegradedTargetCapability,
) -> i64 { cap.serial }

pub fn d12_accept_suspended_capability(
    cap: D12SuspendedTargetCapability,
) -> i64 { cap.serial }

pub fn d12_accept_revoked_capability(
    cap: D12RevokedTargetCapability,
) -> i64 { cap.serial }

pub fn d12_accept_production_authority(
    authority: D12ProductionDeploymentAuthority,
) -> i64 { authority.authority_id }

pub fn d12_accept_clinical_action_authority(
    authority: D12ClinicalActionAuthority,
) -> i64 { authority.authority_id }

pub fn d12_accept_institutional_monitor_authority(
    authority: D12InstitutionalMonitorAuthority,
) -> i64 { authority.authority_id }

pub fn d12_accept_trusted_external_monitor_root(
    root: D12TrustedExternalMonitorRoot,
) -> i64 { root.root_id }

// ============================================================
// Private sink state and transition calculation
// ============================================================

struct D12CompletionRecord {
    active: bool,
    operation_id: i64,
    payload_fingerprint: i64,
    fence: i64,
    context_commitment: i64,
    result_code: i64,
}

struct D12SinkState {
    resource_id: i64,
    context_commitment: i64,
    highest_fence: i64,
    completion_a: D12CompletionRecord,
    completion_b: D12CompletionRecord,
    completion_c: D12CompletionRecord,
    applied_effect_count: i64,
    durable_completion_count: i64,
    journal_sequence: i64,
    journal_fingerprint: i64,
}

struct D12SinkStep {
    state: D12SinkState,
    accepted: bool,
    replayed: bool,
    stale_rejected: bool,
    payload_rejected: bool,
    resource_rejected: bool,
    overflow_rejected: bool,
    capacity_rejected: bool,
    context_rejected: bool,
    result_code: i64,
}

fn d12_hash_step(seed: i64, value: i64) -> i64 {
    (seed * 131 + value) % 1000000007
}

fn d12_context_commitment(
    model_version_id: i64,
    site_id: i64,
    target_population_id: i64,
) -> i64 {
    var context = d12_hash_step(12, 32031)
    context = d12_hash_step(context, 32032)
    context = d12_hash_step(context, 31100)
    context = d12_hash_step(context, model_version_id)
    context = d12_hash_step(context, site_id)
    context = d12_hash_step(context, 30471)
    context = d12_hash_step(context, target_population_id)
    context = d12_hash_step(context, 31711)
    context = d12_hash_step(context, 31512)
    context = d12_hash_step(context, 30413)
    d12_hash_step(context, 31121)
}

fn d12_fixture_context_commitment() -> i64 {
    d12_context_commitment(30412, 30461, 31112)
}

fn d12_empty_completion_record() -> D12CompletionRecord {
    D12CompletionRecord {
        active: false,
        operation_id: 0,
        payload_fingerprint: 0,
        fence: 0,
        context_commitment: 0,
        result_code: 0,
    }
}

fn d12_initial_sink_state() -> D12SinkState {
    D12SinkState {
        resource_id: 32041,
        context_commitment: d12_fixture_context_commitment(),
        highest_fence: 1,
        completion_a: d12_empty_completion_record(),
        completion_b: d12_empty_completion_record(),
        completion_c: d12_empty_completion_record(),
        applied_effect_count: 0,
        durable_completion_count: 0,
        journal_sequence: 1,
        journal_fingerprint: 3204101,
    }
}

fn d12_refused_sink_step(
    state: D12SinkState,
    stale: bool,
    payload: bool,
    resource: bool,
    overflow: bool,
    capacity: bool,
    context: bool,
) -> D12SinkStep {
    D12SinkStep {
        state: state,
        accepted: false,
        replayed: false,
        stale_rejected: stale,
        payload_rejected: payload,
        resource_rejected: resource,
        overflow_rejected: overflow,
        capacity_rejected: capacity,
        context_rejected: context,
        result_code: 0 - 1,
    }
}

fn d12_replay_completion(
    state: D12SinkState,
    completion: D12CompletionRecord,
    payload_fingerprint: i64,
    submitted_fence: i64,
) -> D12SinkStep {
    if payload_fingerprint != completion.payload_fingerprint {
        return d12_refused_sink_step(
            state, false, true, false, false, false, false,
        )
    }
    if submitted_fence != completion.fence {
        return d12_refused_sink_step(
            state, true, false, false, false, false, false,
        )
    }
    D12SinkStep {
        state: state,
        accepted: true,
        replayed: true,
        stale_rejected: false,
        payload_rejected: false,
        resource_rejected: false,
        overflow_rejected: false,
        capacity_rejected: false,
        context_rejected: false,
        result_code: completion.result_code,
    }
}

fn d12_record_fresh_completion(
    state: D12SinkState,
    completion_a: D12CompletionRecord,
    completion_b: D12CompletionRecord,
    completion_c: D12CompletionRecord,
    resource_id: i64,
    operation_id: i64,
    payload_fingerprint: i64,
    submitted_fence: i64,
    context_commitment: i64,
    result_code: i64,
) -> D12SinkStep {
    var journal = d12_hash_step(state.journal_fingerprint, resource_id)
    journal = d12_hash_step(journal, context_commitment)
    journal = d12_hash_step(journal, operation_id)
    journal = d12_hash_step(journal, payload_fingerprint)
    journal = d12_hash_step(journal, submitted_fence)
    journal = d12_hash_step(journal, result_code)
    let next_state = D12SinkState {
        resource_id: state.resource_id,
        context_commitment: state.context_commitment,
        highest_fence: submitted_fence,
        completion_a: completion_a,
        completion_b: completion_b,
        completion_c: completion_c,
        applied_effect_count: state.applied_effect_count + 1,
        durable_completion_count: state.durable_completion_count + 1,
        journal_sequence: state.journal_sequence + 1,
        journal_fingerprint: journal,
    }
    D12SinkStep {
        state: next_state,
        accepted: true,
        replayed: false,
        stale_rejected: false,
        payload_rejected: false,
        resource_rejected: false,
        overflow_rejected: false,
        capacity_rejected: false,
        context_rejected: false,
        result_code: result_code,
    }
}

fn d12_sink_apply(
    state: D12SinkState,
    resource_id: i64,
    context_commitment: i64,
    operation_id: i64,
    payload_fingerprint: i64,
    submitted_fence: i64,
    result_code: i64,
) -> D12SinkStep {
    if resource_id != state.resource_id {
        return d12_refused_sink_step(
            state, false, false, true, false, false, false,
        )
    }
    if context_commitment != state.context_commitment {
        return d12_refused_sink_step(
            state, false, false, false, false, false, true,
        )
    }

    // Retained completions are checked before the stale-fence rule. Operation
    // identifiers are opaque; an exact historical retry returns its recorded
    // result without repeating the protected effect.
    if state.completion_a.active &&
        operation_id == state.completion_a.operation_id {
        return d12_replay_completion(
            state, state.completion_a, payload_fingerprint, submitted_fence,
        )
    }
    if state.completion_b.active &&
        operation_id == state.completion_b.operation_id {
        return d12_replay_completion(
            state, state.completion_b, payload_fingerprint, submitted_fence,
        )
    }
    if state.completion_c.active &&
        operation_id == state.completion_c.operation_id {
        return d12_replay_completion(
            state, state.completion_c, payload_fingerprint, submitted_fence,
        )
    }

    if state.highest_fence == 9223372036854775807 {
        return d12_refused_sink_step(
            state, false, false, false, true, false, false,
        )
    }
    if submitted_fence <= state.highest_fence {
        return d12_refused_sink_step(
            state, true, false, false, false, false, false,
        )
    }

    let completion = D12CompletionRecord {
        active: true,
        operation_id: operation_id,
        payload_fingerprint: payload_fingerprint,
        fence: submitted_fence,
        context_commitment: context_commitment,
        result_code: result_code,
    }
    if !state.completion_a.active {
        return d12_record_fresh_completion(
            state, completion, state.completion_b, state.completion_c,
            resource_id, operation_id, payload_fingerprint,
            submitted_fence, context_commitment, result_code,
        )
    }
    if !state.completion_b.active {
        return d12_record_fresh_completion(
            state, state.completion_a, completion, state.completion_c,
            resource_id, operation_id, payload_fingerprint,
            submitted_fence, context_commitment, result_code,
        )
    }
    if !state.completion_c.active {
        return d12_record_fresh_completion(
            state, state.completion_a, state.completion_b, completion,
            resource_id, operation_id, payload_fingerprint,
            submitted_fence, context_commitment, result_code,
        )
    }
    d12_refused_sink_step(state, false, false, false, false, true, false)
}

fn d12_state_after_degradation() -> D12SinkState with Panic {
    let step = d12_sink_apply(
        d12_initial_sink_state(), 32041, d12_fixture_context_commitment(),
        32101, 32201, 2, 32301,
    )
    assert(step.accepted && !step.replayed)
    assert(step.state.applied_effect_count == 1)
    step.state
}

fn d12_state_after_suspension() -> D12SinkState with Panic {
    let step = d12_sink_apply(
        d12_state_after_degradation(), 32041,
        d12_fixture_context_commitment(), 32102, 32202, 3, 32302,
    )
    assert(step.accepted && !step.replayed)
    assert(step.state.applied_effect_count == 2)
    step.state
}

fn d12_state_after_revocation() -> D12SinkState with Panic {
    let step = d12_sink_apply(
        d12_state_after_suspension(), 32041,
        d12_fixture_context_commitment(), 32103, 32203, 4, 32303,
    )
    assert(step.accepted && !step.replayed)
    assert(step.state.applied_effect_count == 3)
    step.state
}

// ============================================================
// Affine typestate path
// ============================================================

pub fn issue_d12_fixture_synthetic_monitor_root(
) -> D12SyntheticMonitorRoot {
    D12SyntheticMonitorRoot { serial: 32001 }
}

pub fn bind_d12_fixture_current_target_capability(
    root: D12SyntheticMonitorRoot,
) -> D12CurrentTargetCapability with Panic {
    let root_serial = root.serial
    assert(root_serial == 32001)
    let d11 = replay_d11_target_canary_continuation()
    assert(d11_accept_target_continuation(d11) == 31100)
    D12CurrentTargetCapability { serial: 32401 }
}

pub fn degrade_d12_target_capability(
    cap: D12CurrentTargetCapability,
) -> D12DegradedTargetCapability with Panic {
    let serial = cap.serial
    assert(serial == 32401)
    let state = d12_state_after_degradation()
    assert(state.highest_fence == 2)
    assert(state.applied_effect_count == 1)
    D12DegradedTargetCapability { serial: 32402 }
}

pub fn suspend_d12_target_capability(
    cap: D12DegradedTargetCapability,
) -> D12SuspendedTargetCapability with Panic {
    let serial = cap.serial
    assert(serial == 32402)
    let state = d12_state_after_suspension()
    assert(state.highest_fence == 3)
    assert(state.applied_effect_count == 2)
    D12SuspendedTargetCapability { serial: 32403 }
}

pub fn revoke_d12_target_capability(
    cap: D12SuspendedTargetCapability,
) -> D12RevokedTargetCapability with Panic {
    let serial = cap.serial
    assert(serial == 32403)
    let state = d12_state_after_revocation()
    assert(state.highest_fence == 4)
    assert(state.applied_effect_count == 3)
    D12RevokedTargetCapability { serial: 32404 }
}

pub fn observe_d12_affine_attenuation_trace(
    receipt_id: i64,
    cap: D12RevokedTargetCapability,
) -> D12AffineAttenuationTraceReceipt with Panic {
    let serial = cap.serial
    assert(receipt_id == 32501 && serial == 32404)
    let state = d12_state_after_revocation()
    D12AffineAttenuationTraceReceipt {
        receipt_id: receipt_id,
        warrant_id: 31100,
        monitor_id: 32031,
        sink_id: 32032,
        resource_id: state.resource_id,
        start_rank: 3,
        degraded_rank: 2,
        suspended_rank: 1,
        revoked_rank: 0,
        start_scope: 4,
        degraded_scope: 2,
        suspended_scope: 0,
        revoked_scope: 0,
        start_epoch: 1,
        final_epoch: 4,
        start_fence: 1,
        final_fence: state.highest_fence,
        protected_effect_count: state.applied_effect_count,
        durable_completion_count: state.durable_completion_count,
        affine_capability_required: true,
        rank_promoted: false,
        scope_widened: false,
        production_authority: false,
        clinical_action_authority: false,
    }
}

pub fn run_d12_fixture_affine_attenuation_trace(
) -> D12AffineAttenuationTraceReceipt with Panic {
    let root = issue_d12_fixture_synthetic_monitor_root()
    let current = bind_d12_fixture_current_target_capability(root)
    let degraded = degrade_d12_target_capability(current)
    let suspended = suspend_d12_target_capability(degraded)
    let revoked = revoke_d12_target_capability(suspended)
    observe_d12_affine_attenuation_trace(32501, revoked)
}

// ============================================================
// Fencing, retry, crash, and evidence contests
// ============================================================

pub fn observe_d12_fencing_replay_contest(
) -> D12FencingReplayContestReceipt with Panic {
    let context = d12_fixture_context_commitment()
    let first = d12_sink_apply(
        d12_initial_sink_state(), 32041, context, 32101, 32201, 2, 32301,
    )
    assert(first.accepted && !first.replayed)

    let retry = d12_sink_apply(
        first.state, 32041, context, 32101, 32201, 2, 99999,
    )
    assert(retry.accepted && retry.replayed)
    assert(retry.result_code == 32301)

    let wrong_payload = d12_sink_apply(
        retry.state, 32041, context, 32101, 32299, 2, 32301,
    )
    let stale = d12_sink_apply(
        retry.state, 32041, context, 32100, 32200, 1, 32300,
    )
    let wrong_resource = d12_sink_apply(
        retry.state, 32999, context, 32102, 32202, 3, 32302,
    )
    let wrong_model = d12_sink_apply(
        retry.state, 32041, d12_context_commitment(30499, 30461, 31112),
        32102, 32202, 3, 32302,
    )
    let wrong_site = d12_sink_apply(
        retry.state, 32041, d12_context_commitment(30412, 30499, 31112),
        32102, 32202, 3, 32302,
    )
    let wrong_population = d12_sink_apply(
        retry.state, 32041, d12_context_commitment(30412, 30461, 31199),
        32102, 32202, 3, 32302,
    )
    assert(wrong_model.context_rejected)
    assert(wrong_site.context_rejected)
    assert(wrong_population.context_rejected)

    let second = d12_sink_apply(
        retry.state, 32041, context, 32102, 32202, 3, 32302,
    )
    assert(second.accepted && second.state.applied_effect_count == 2)
    let third = d12_sink_apply(
        second.state, 32041, context, 32103, 32203, 4, 32303,
    )
    assert(third.accepted && third.state.applied_effect_count == 3)

    // Operation identifiers are opaque. The retained first completion remains
    // replayable after later operations, but changing its tuple is refused.
    let historical_retry = d12_sink_apply(
        third.state, 32041, context, 32101, 32201, 2, 99999,
    )
    let historical_wrong_payload = d12_sink_apply(
        third.state, 32041, context, 32101, 32299, 2, 32301,
    )
    let replay_with_new_fence = d12_sink_apply(
        third.state, 32041, context, 32101, 32201, 5, 32301,
    )
    let capacity = d12_sink_apply(
        third.state, 32041, context, 32104, 32204, 5, 32304,
    )
    assert(historical_retry.accepted && historical_retry.replayed)
    assert(historical_retry.result_code == 32301)
    assert(historical_retry.state.applied_effect_count == 3)
    assert(historical_retry.state.durable_completion_count == 3)
    assert(historical_wrong_payload.payload_rejected)
    assert(replay_with_new_fence.stale_rejected)
    assert(capacity.capacity_rejected)

    let overflow_state = D12SinkState {
        resource_id: 32041,
        context_commitment: context,
        highest_fence: 9223372036854775807,
        completion_a: d12_empty_completion_record(),
        completion_b: d12_empty_completion_record(),
        completion_c: d12_empty_completion_record(),
        applied_effect_count: 0,
        durable_completion_count: 0,
        journal_sequence: 1,
        journal_fingerprint: 3204101,
    }
    let overflow = d12_sink_apply(
        overflow_state, 32041, context,
        32104, 32204, 9223372036854775807, 32304,
    )

    D12FencingReplayContestReceipt {
        receipt_id: 32502,
        resource_id: third.state.resource_id,
        first_operation_id: 32101,
        second_operation_id: 32102,
        third_operation_id: 32103,
        first_effect_count: first.state.applied_effect_count,
        retry_effect_count: retry.state.applied_effect_count,
        final_effect_count: third.state.applied_effect_count,
        final_completion_count: third.state.durable_completion_count,
        final_fence: third.state.highest_fence,
        exact_retry_returned_recorded_result:
            retry.replayed && retry.result_code == first.result_code,
        historical_retry_returned_recorded_result:
            historical_retry.replayed &&
            historical_retry.result_code == first.result_code,
        historical_retry_effect_count:
            historical_retry.state.applied_effect_count,
        stale_fence_rejected: stale.stale_rejected,
        wrong_payload_rejected: wrong_payload.payload_rejected,
        historical_wrong_payload_rejected:
            historical_wrong_payload.payload_rejected,
        replay_with_new_fence_rejected:
            replay_with_new_fence.stale_rejected,
        wrong_model_rejected: wrong_model.context_rejected,
        wrong_site_rejected: wrong_site.context_rejected,
        wrong_population_rejected: wrong_population.context_rejected,
        wrong_resource_rejected: wrong_resource.resource_rejected,
        overflow_successor_rejected: overflow.overflow_rejected,
        completion_capacity_rejected: capacity.capacity_rejected,
        completion_records_retained:
            historical_retry.state.durable_completion_count,
        context_commitment: context,
        context_commitment_is_cryptographic: false,
        protected_effect_repeated_on_retry:
            retry.state.applied_effect_count != first.state.applied_effect_count,
        client_side_check_is_sufficient: false,
        sink_mediation_required: true,
        journal_fingerprint: third.state.journal_fingerprint,
    }
}

pub fn observe_d12_crash_recovery_contest(
) -> D12CrashRecoveryContestReceipt with Panic {
    let prior = d12_initial_sink_state()

    // Crash before durable intent: the protected sink saw no operation.
    let before_intent_effects = prior.applied_effect_count

    // Durable intent is replayed after restart. The sink applies it once and
    // durably records the completion before a result can be replayed.
    let recovered_apply = d12_sink_apply(
        prior, 32041, d12_fixture_context_commitment(),
        32101, 32201, 2, 32301,
    )
    let lost_reply_retry = d12_sink_apply(
        recovered_apply.state, 32041, d12_fixture_context_commitment(),
        32101, 32201, 2, 99999,
    )
    assert(recovered_apply.accepted && !recovered_apply.replayed)
    assert(lost_reply_retry.accepted && lost_reply_retry.replayed)

    // A restored monitor presents an old fence to a sink whose durable high
    // water mark already reached four. The protected sink refuses it.
    let current_sink = d12_state_after_revocation()
    let rollback = d12_sink_apply(
        current_sink, 32041, d12_fixture_context_commitment(),
        32109, 32209, 2, 32309,
    )

    D12CrashRecoveryContestReceipt {
        receipt_id: 32503,
        operation_id: 32101,
        effect_count_before_intent: before_intent_effects,
        effect_count_after_intent_recovery:
            recovered_apply.state.applied_effect_count,
        effect_count_after_lost_reply_retry:
            lost_reply_retry.state.applied_effect_count,
        completion_count_after_retry:
            lost_reply_retry.state.durable_completion_count,
        crash_before_intent_recovers_prior_state:
            before_intent_effects == prior.applied_effect_count,
        durable_intent_replay_applies_once:
            recovered_apply.state.applied_effect_count == 1,
        lost_reply_retry_returns_recorded_result:
            lost_reply_retry.result_code == recovered_apply.result_code &&
            lost_reply_retry.state.applied_effect_count ==
                recovered_apply.state.applied_effect_count,
        nontransactional_unknown_outcome_code: 3,
        nontransactional_unknown_is_indeterminate: true,
        indeterminate_authorizes_continuation: false,
        backup_rollback_fence_rejected: rollback.stale_rejected,
        real_durable_storage_proven: false,
        distributed_exactly_once_proven: false,
    }
}

