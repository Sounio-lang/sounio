// Bounded proof-carrying affine warrant and trusted target monitor D12.
//
// Compact private affine capabilities gate typestate transitions. Rich monitor
// records remain ordinary private values so reading their fields does not spend
// authority. Public values are observations or refusals and never authorize a
// production or clinical action.

use epistemic::proof_carrying_shift_robust_risk_transport::{
    d11_accept_target_continuation,
    replay_d11_target_canary_continuation,
}

// ============================================================
// Public observation and refusal records
// ============================================================

pub struct D12AffineAttenuationTraceReceipt {
    pub receipt_id: i64,
    pub warrant_id: i64,
    pub monitor_id: i64,
    pub sink_id: i64,
    pub resource_id: i64,
    pub start_rank: i64,
    pub degraded_rank: i64,
    pub suspended_rank: i64,
    pub revoked_rank: i64,
    pub start_scope: i64,
    pub degraded_scope: i64,
    pub suspended_scope: i64,
    pub revoked_scope: i64,
    pub start_epoch: i64,
    pub final_epoch: i64,
    pub start_fence: i64,
    pub final_fence: i64,
    pub protected_effect_count: i64,
    pub durable_completion_count: i64,
    pub affine_capability_required: bool,
    pub rank_promoted: bool,
    pub scope_widened: bool,
    pub production_authority: bool,
    pub clinical_action_authority: bool,
}

pub struct D12FencingReplayContestReceipt {
    pub receipt_id: i64,
    pub resource_id: i64,
    pub first_operation_id: i64,
    pub second_operation_id: i64,
    pub third_operation_id: i64,
    pub first_effect_count: i64,
    pub retry_effect_count: i64,
    pub final_effect_count: i64,
    pub final_completion_count: i64,
    pub final_fence: i64,
    pub exact_retry_returned_recorded_result: bool,
    pub historical_retry_returned_recorded_result: bool,
    pub historical_retry_effect_count: i64,
    pub stale_fence_rejected: bool,
    pub wrong_payload_rejected: bool,
    pub historical_wrong_payload_rejected: bool,
    pub replay_with_new_fence_rejected: bool,
    pub wrong_model_rejected: bool,
    pub wrong_site_rejected: bool,
    pub wrong_population_rejected: bool,
    pub wrong_resource_rejected: bool,
    pub overflow_successor_rejected: bool,
    pub completion_capacity_rejected: bool,
    pub completion_records_retained: i64,
    pub context_commitment: i64,
    pub context_commitment_is_cryptographic: bool,
    pub protected_effect_repeated_on_retry: bool,
    pub client_side_check_is_sufficient: bool,
    pub sink_mediation_required: bool,
    pub journal_fingerprint: i64,
}

pub struct D12CrashRecoveryContestReceipt {
    pub receipt_id: i64,
    pub operation_id: i64,
    pub effect_count_before_intent: i64,
    pub effect_count_after_intent_recovery: i64,
    pub effect_count_after_lost_reply_retry: i64,
    pub completion_count_after_retry: i64,
    pub crash_before_intent_recovers_prior_state: bool,
    pub durable_intent_replay_applies_once: bool,
    pub lost_reply_retry_returns_recorded_result: bool,
    pub nontransactional_unknown_outcome_code: i64,
    pub nontransactional_unknown_is_indeterminate: bool,
    pub indeterminate_authorizes_continuation: bool,
    pub backup_rollback_fence_rejected: bool,
    pub real_durable_storage_proven: bool,
    pub distributed_exactly_once_proven: bool,
}

pub struct D12MonitorUnavailableRefusalReceipt {
    pub receipt_id: i64,
    pub monitor_id: i64,
    pub resource_id: i64,
    pub requested_operation_id: i64,
    pub monitor_reachable: bool,
    pub freshness_established: bool,
    pub protected_effect_applied: bool,
    pub continuation_authorized: bool,
    pub failed_closed: bool,
}

pub struct D12CompletionGcRefusalReceipt {
