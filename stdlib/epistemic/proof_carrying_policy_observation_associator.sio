fn d6_bool_i64(value: bool) -> i64 { if value { 1 } else { 0 } }

fn flat_factor(leaf_count: i64) -> i64 with Panic {
    assert(leaf_count >= 1 && leaf_count <= 3)
    if leaf_count == 1 {
        101
    } else if leaf_count == 2 {
        10201
    } else {
        1030301
    }
}

fn concat_flat(
    left_fingerprint: i64,
    right_fingerprint: i64,
    right_leaf_count: i64,
) -> i64 with Panic {
    assert(left_fingerprint > 0 && right_fingerprint > 0)
    left_fingerprint * flat_factor(right_leaf_count) + right_fingerprint
}

fn flat_three(first: i64, second: i64, third: i64) -> i64 with Panic {
    let first_two = concat_flat(first, second, 1)
    concat_flat(first_two, third, 1)
}

fn evidence_factor(evidence_count: i64) -> i64 with Panic {
    assert(evidence_count >= 0 && evidence_count <= 2)
    if evidence_count == 0 { 1 } else if evidence_count == 1 { 31 } else { 961 }
}

fn origin_overlap(left_mask: i64, right_mask: i64) -> i64 {
    left_mask % 2 * (right_mask % 2) +
        ((left_mask / 2) % 2) * ((right_mask / 2) % 2) +
        ((left_mask / 4) % 2) * ((right_mask / 4) % 2)
}

fn expected_flat_fingerprint(origin_mask: i64) -> i64 with Panic {
    if origin_mask == 1 {
        9101
    } else if origin_mask == 2 {
        9102
    } else if origin_mask == 4 {
        9103
    } else if origin_mask == 3 {
        928303
    } else if origin_mask == 6 {
        928405
    } else {
        assert(origin_mask == 7)
        93767706
    }
}

fn replay_frozen_probe_status_from_tree(
    grouping_tree_fingerprint: i64,
) -> i64 with Panic {
    if grouping_tree_fingerprint == 9037326 {
        2
    } else {
        assert(grouping_tree_fingerprint == 573396)
        3
    }
}

fn validate_carrier(c: PolicyObservationCarrierReceipt) with Panic {
    assert(c.carrier_id > 0)
    assert(c.operator_id == 9601)
    assert(c.family_id == 520 && c.protocol_id == 8400)
    assert(c.burden_capacity == 7)
    assert(c.first_position >= 1 && c.last_position <= 3)
    assert(c.first_position <= c.last_position)
    assert(c.leaf_count == c.last_position - c.first_position + 1)
    assert(c.atom_origin_mask == 1 || c.atom_origin_mask == 2 ||
        c.atom_origin_mask == 3 || c.atom_origin_mask == 4 ||
        c.atom_origin_mask == 6 || c.atom_origin_mask == 7)
    assert(c.ordered_atom_id_1 == if c.atom_origin_mask % 2 == 1 { 9101 } else { 0 })
    assert(c.ordered_atom_id_2 ==
        if (c.atom_origin_mask / 2) % 2 == 1 { 9102 } else { 0 })
    assert(c.ordered_atom_id_3 ==
        if (c.atom_origin_mask / 4) % 2 == 1 { 9103 } else { 0 })
    assert(c.flat_trace_fingerprint ==
        expected_flat_fingerprint(c.atom_origin_mask))
    assert(c.probe_status_code >= 0 && c.probe_status_code <= 3)
    assert(c.survivor_mask == 2 || c.survivor_mask == 3)
    assert(c.evidence_count >= 0 && c.evidence_count <= 2)
    assert(c.burden_spent >= 0 && c.burden_spent <= c.burden_capacity)
    assert(c.synthetic_scope_only)

    if c.atom_origin_mask == 1 {
        assert(c.first_position == 1 && c.last_position == 1)
        assert(c.grouping_tree_fingerprint == 9101)
    } else if c.atom_origin_mask == 2 {
        assert(c.first_position == 2 && c.last_position == 2)
        assert(c.grouping_tree_fingerprint == 9102)
    } else if c.atom_origin_mask == 4 {
        assert(c.first_position == 3 && c.last_position == 3)
        assert(c.grouping_tree_fingerprint == 9103)
    } else if c.atom_origin_mask == 3 {
        assert(c.first_position == 1 && c.last_position == 2)
        assert(c.grouping_tree_fingerprint == 291233)
    } else if c.atom_origin_mask == 6 {
        assert(c.first_position == 2 && c.last_position == 3)
        assert(c.grouping_tree_fingerprint == 291265)
    } else {
        assert(c.first_position == 1 && c.last_position == 3)
        assert(c.grouping_tree_fingerprint == 9037326 ||
            c.grouping_tree_fingerprint == 573396)
    }

    assert(c.contains_policy_context == (c.atom_origin_mask % 2 == 1))
    assert(c.contains_commit_boundary ==
        ((c.atom_origin_mask / 2) % 2 == 1))
    assert(c.contains_pending_probe_atom ==
        ((c.atom_origin_mask / 4) % 2 == 1))
    assert(c.anchor_provenance_retained == c.contains_policy_context)

    if !c.contains_pending_probe_atom {
        assert(c.probe_status_code == 0)
        assert(c.target_candidate_value == -1)
        assert(c.observed_target_value == -1)
        assert(!c.probe_provenance_retained)
        assert(!c.policy_was_in_scope_when_probe_resolved)
        assert(!c.probe_committed_without_policy_scope)
    } else {
        assert(c.target_candidate_value == 8)
        if c.probe_status_code == 1 {
            assert(c.observed_target_value == -1)
            assert(!c.probe_provenance_retained)
            assert(!c.policy_was_in_scope_when_probe_resolved)
            assert(!c.probe_committed_without_policy_scope)
        } else if c.probe_status_code == 2 {
            assert(c.observed_target_value == -1)
            assert(!c.probe_provenance_retained)
            assert(c.policy_was_in_scope_when_probe_resolved)
            assert(!c.probe_committed_without_policy_scope)
        } else {
            assert(c.probe_status_code == 3)
            assert(c.observed_target_value == 8)
            assert(c.probe_provenance_retained)
            assert(!c.policy_was_in_scope_when_probe_resolved)
            assert(c.probe_committed_without_policy_scope)
        }
    }

    let expected_evidence_count = d6_bool_i64(c.contains_policy_context) +
        d6_bool_i64(c.probe_status_code == 3)
    let expected_burden = d6_bool_i64(c.contains_policy_context) * 3 +
        d6_bool_i64(c.probe_status_code == 3) * 4
    assert(c.evidence_count == expected_evidence_count)
    assert(c.burden_spent == expected_burden)
    assert(c.survivor_mask == if c.probe_status_code == 3 { 2 } else { 3 })

    if c.evidence_count == 0 {
        assert(c.last_evidence_provenance_id == 0)
        assert(c.evidence_fingerprint == 0)
    } else if c.contains_policy_context && c.probe_status_code == 3 {
        assert(c.evidence_count == 2)
        assert(c.last_evidence_provenance_id == 8103)
        assert(c.evidence_fingerprint == 259234)
    } else if c.contains_policy_context {
        assert(c.evidence_count == 1)
        assert(c.last_evidence_provenance_id == 8101)
        assert(c.evidence_fingerprint == 8101)
    } else {
        assert(c.probe_status_code == 3 && c.evidence_count == 1)
        assert(c.last_evidence_provenance_id == 8103)
        assert(c.evidence_fingerprint == 8103)
    }

    if c.atom_origin_mask == 4 {
        assert(c.probe_status_code == 1)
    } else if c.atom_origin_mask == 6 {
        assert(c.probe_status_code == 3)
    } else if c.atom_origin_mask == 7 {
        assert(c.probe_status_code == replay_frozen_probe_status_from_tree(
            c.grouping_tree_fingerprint,
        ))
    }
}

pub fn declare_d5_policy_context_atom(
    atom_id: i64,
    family: AdaptiveObservationPolicyFamilyReceipt,
    budget: DeclaredSyntheticObservationBudgetReceipt,
    anchor: ObservedAnchorValueReceipt,
    decision: AdaptiveObservationPolicyDecisionReceipt,
    gap: PolicyCoverageGapReceipt,
) -> PolicyObservationCarrierReceipt with Panic {
    assert(atom_id == 9101)
    assert(family.family_id == 520 && family.protocol_id == 8400)
    assert(family.low_hypothesis_id == 510 && family.high_hypothesis_id == 511)
    assert(family.hypothesis_count == 2 && family.synthetic_scope_only)
    assert(budget.budget_id == 8500 && budget.protocol_id == family.protocol_id)
    assert(budget.capacity_units == 7 && budget.anchor_cost_units == 3)
    assert(budget.coverage_probe_cost_units == 4)
    assert(anchor.protocol_id == family.protocol_id)
    assert(anchor.tick == 1 && anchor.observed_value == 2 && anchor.value_present)
    assert(anchor.provenance_id == 8101 && anchor.declared_burden_units == 3)
    assert(!anchor.target_tick_observed)
    assert(decision.decision_id == 8102 && decision.family_id == family.family_id)
    assert(decision.protocol_id == family.protocol_id && decision.candidate_tick == 2)
    assert(decision.candidate_considered && !decision.eligible_under_adaptive_policy)
    assert(!decision.scheduled && decision.withheld_by_adaptive_policy)
    assert(decision.policy_retained_in_provenance)
    assert(gap.coverage_id == 8301 && gap.decision_id == decision.decision_id)
    assert(gap.eligible_opportunities == 0 && gap.observed_opportunities == 0)
    assert(!gap.support_for_policy_comparison_present)
    let atom = PolicyObservationCarrierReceipt {
        carrier_id: atom_id,
        operator_id: 9601,
        family_id: family.family_id,
        protocol_id: family.protocol_id,
        burden_capacity: budget.capacity_units,
        first_position: 1,
        last_position: 1,
        leaf_count: 1,
        atom_origin_mask: 1,
        ordered_atom_id_1: 9101,
        ordered_atom_id_2: 0,
        ordered_atom_id_3: 0,
        flat_trace_fingerprint: atom_id,
        grouping_tree_fingerprint: atom_id,
        contains_policy_context: true,
        contains_commit_boundary: false,
        contains_pending_probe_atom: false,
        probe_status_code: 0,
        target_candidate_value: -1,
        observed_target_value: -1,
        survivor_mask: 3,
        evidence_count: 1,
        burden_spent: 3,
        last_evidence_provenance_id: 8101,
        evidence_fingerprint: 8101,
        policy_was_in_scope_when_probe_resolved: false,
        probe_committed_without_policy_scope: false,
        anchor_provenance_retained: true,
        probe_provenance_retained: false,
        synthetic_scope_only: true,
    }
    validate_carrier(atom)
    atom
}

