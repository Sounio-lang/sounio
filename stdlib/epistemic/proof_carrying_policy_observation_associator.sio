pub fn declare_d5_pending_probe_atom(
    atom_id: i64,
    family: AdaptiveObservationPolicyFamilyReceipt,
    budget: DeclaredSyntheticObservationBudgetReceipt,
    assignment: SyntheticExogenousCoverageAssignmentReceipt,
    provenance: PolicyEvidenceProvenanceReceipt,
    target_value: i64,
) -> PolicyObservationCarrierReceipt with Panic {
    assert(atom_id == 9103 && target_value == 8)
    assert(family.family_id == 520 && family.protocol_id == 8400)
    assert(budget.protocol_id == family.protocol_id && budget.capacity_units == 7)
    assert(assignment.assignment_id == 8600)
    assert(assignment.protocol_id == family.protocol_id)
    assert(assignment.coverage_id == 8301)
    assert(assignment.logging_policy_decision_id == 8102)
    assert(assignment.target_tick == 2 && assignment.declared_probe_cost_units == 4)
    assert(assignment.outside_adaptive_policy)
    assert(assignment.exogenous_within_frozen_fixture)
    assert(!assignment.real_person_randomization_claimed)
    assert(provenance.provenance_id == 8103 && provenance.protocol_id == 8400)
    assert(provenance.tick == 2 && provenance.previous_provenance_id == 8101)
    assert(provenance.policy_decision_id == 8102)
    assert(provenance.chain_complete && provenance.policy_retained)
    assert(provenance.exogenous_override_within_fixture)
    let atom = PolicyObservationCarrierReceipt {
        carrier_id: atom_id,
        operator_id: 9601,
        family_id: family.family_id,
        protocol_id: family.protocol_id,
        burden_capacity: budget.capacity_units,
        first_position: 3,
        last_position: 3,
        leaf_count: 1,
        atom_origin_mask: 4,
        ordered_atom_id_1: 0,
        ordered_atom_id_2: 0,
        ordered_atom_id_3: 9103,
        flat_trace_fingerprint: atom_id,
        grouping_tree_fingerprint: atom_id,
        contains_policy_context: false,
        contains_commit_boundary: false,
        contains_pending_probe_atom: true,
        probe_status_code: 1,
        target_candidate_value: target_value,
        observed_target_value: -1,
        survivor_mask: 3,
        evidence_count: 0,
        burden_spent: 0,
        last_evidence_provenance_id: 0,
        evidence_fingerprint: 0,
        policy_was_in_scope_when_probe_resolved: false,
        probe_committed_without_policy_scope: false,
        anchor_provenance_retained: false,
        probe_provenance_retained: false,
        synthetic_scope_only: true,
    }
    validate_carrier(atom)
    atom
}

pub fn certify_policy_observation_composable(
    pair_id: i64,
    left: PolicyObservationCarrierReceipt,
    right: PolicyObservationCarrierReceipt,
) -> PolicyObservationComposabilityReceipt with Panic {
    validate_carrier(left)
    validate_carrier(right)
    assert(pair_id > 0)
    assert(left.last_position + 1 == right.first_position)
    assert(origin_overlap(left.atom_origin_mask, right.atom_origin_mask) == 0)
    assert(left.family_id == right.family_id)
    assert(left.protocol_id == right.protocol_id)
    assert(left.burden_capacity == right.burden_capacity)
    PolicyObservationComposabilityReceipt {
        pair_id: pair_id,
        operator_id: 9601,
        left_carrier_id: left.carrier_id,
        right_carrier_id: right.carrier_id,
        left_origin_mask: left.atom_origin_mask,
        right_origin_mask: right.atom_origin_mask,
        adjacent_fragments: true,
        disjoint_origins: true,
        same_family: true,
        same_protocol: true,
        same_budget: true,
    }
}

pub fn certify_policy_observation_noncomposable(
    receipt_id: i64,
    left: PolicyObservationCarrierReceipt,
    right: PolicyObservationCarrierReceipt,
) -> PolicyObservationNonComposabilityReceipt with Panic {
    validate_carrier(left)
    validate_carrier(right)
    assert(receipt_id > 0)
    let adjacent = left.last_position + 1 == right.first_position
    let disjoint = origin_overlap(
        left.atom_origin_mask, right.atom_origin_mask,
    ) == 0
    let same_family = left.family_id == right.family_id
    let same_protocol = left.protocol_id == right.protocol_id
    let same_budget = left.burden_capacity == right.burden_capacity
    assert(!(adjacent && disjoint && same_family && same_protocol && same_budget))
    let reason = if !adjacent {
        1
    } else if !disjoint {
        2
    } else if !same_family {
        3
    } else if !same_protocol {
        4
    } else {
        assert(!same_budget)
        5
    }
    PolicyObservationNonComposabilityReceipt {
        receipt_id: receipt_id,
        operator_id: 9601,
        left_carrier_id: left.carrier_id,
        right_carrier_id: right.carrier_id,
        adjacent_fragments: adjacent,
        disjoint_origins: disjoint,
        same_family: same_family,
        same_protocol: same_protocol,
        same_budget: same_budget,
        reason_code: reason,
        composition_refused: true,
    }
}

pub fn compose_policy_observation_carriers(
    result_id: i64,
    composable: PolicyObservationComposabilityReceipt,
    left: PolicyObservationCarrierReceipt,
    right: PolicyObservationCarrierReceipt,
) -> PolicyObservationCarrierReceipt with Panic {
    validate_carrier(left)
    validate_carrier(right)
    assert(result_id > 0 && result_id != left.carrier_id && result_id != right.carrier_id)
    assert(composable.pair_id > 0 && composable.operator_id == 9601)
    assert(composable.left_carrier_id == left.carrier_id)
    assert(composable.right_carrier_id == right.carrier_id)
    assert(composable.left_origin_mask == left.atom_origin_mask)
    assert(composable.right_origin_mask == right.atom_origin_mask)
    assert(composable.adjacent_fragments && composable.disjoint_origins)
    assert(composable.same_family && composable.same_protocol && composable.same_budget)
    assert(left.last_position + 1 == right.first_position)

    let boundary_applies = left.contains_commit_boundary &&
        right.probe_status_code == 1
    let execute_now = boundary_applies && !left.contains_policy_context
    let withhold_now = boundary_applies && left.contains_policy_context
    let committed_before = left.probe_status_code == 3 ||
        right.probe_status_code == 3
    let withheld_before = left.probe_status_code == 2 ||
        right.probe_status_code == 2
    let contains_probe = left.contains_pending_probe_atom ||
        right.contains_pending_probe_atom
    let status = if committed_before {
        3
    } else if withheld_before {
        2
    } else if execute_now {
        3
    } else if withhold_now {
        2
    } else if contains_probe {
        1
    } else {
        0
    }

    let evidence_before_count = left.evidence_count + right.evidence_count
    let evidence_before_fingerprint = left.evidence_fingerprint *
        evidence_factor(right.evidence_count) + right.evidence_fingerprint
    let result_evidence_count = evidence_before_count + d6_bool_i64(execute_now)
    let result_evidence_fingerprint = if execute_now {
        evidence_before_fingerprint * 31 + 8103
    } else {
        evidence_before_fingerprint
    }
    let result_last_provenance = if execute_now {
        8103
    } else if right.evidence_count > 0 {
        right.last_evidence_provenance_id
    } else {
        left.last_evidence_provenance_id
    }

    let result = PolicyObservationCarrierReceipt {
        carrier_id: result_id,
        operator_id: 9601,
        family_id: left.family_id,
        protocol_id: left.protocol_id,
        burden_capacity: left.burden_capacity,
        first_position: left.first_position,
        last_position: right.last_position,
        leaf_count: left.leaf_count + right.leaf_count,
        atom_origin_mask: left.atom_origin_mask + right.atom_origin_mask,
        ordered_atom_id_1: left.ordered_atom_id_1 + right.ordered_atom_id_1,
        ordered_atom_id_2: left.ordered_atom_id_2 + right.ordered_atom_id_2,
        ordered_atom_id_3: left.ordered_atom_id_3 + right.ordered_atom_id_3,
        flat_trace_fingerprint: concat_flat(
            left.flat_trace_fingerprint,
            right.flat_trace_fingerprint,
            right.leaf_count,
        ),
        grouping_tree_fingerprint: left.grouping_tree_fingerprint * 31 +
            right.grouping_tree_fingerprint,
        contains_policy_context: left.contains_policy_context ||
            right.contains_policy_context,
        contains_commit_boundary: left.contains_commit_boundary ||
            right.contains_commit_boundary,
        contains_pending_probe_atom: contains_probe,
        probe_status_code: status,
        target_candidate_value: if contains_probe { 8 } else { -1 },
        observed_target_value: if status == 3 { 8 } else { -1 },
        survivor_mask: if status == 3 { 2 } else { 3 },
        evidence_count: result_evidence_count,
        burden_spent: left.burden_spent + right.burden_spent +
            d6_bool_i64(execute_now) * 4,
        last_evidence_provenance_id: result_last_provenance,
        evidence_fingerprint: result_evidence_fingerprint,
        policy_was_in_scope_when_probe_resolved:
            left.policy_was_in_scope_when_probe_resolved ||
            right.policy_was_in_scope_when_probe_resolved || withhold_now,
        probe_committed_without_policy_scope:
            left.probe_committed_without_policy_scope ||
            right.probe_committed_without_policy_scope || execute_now,
        anchor_provenance_retained: left.anchor_provenance_retained ||
            right.anchor_provenance_retained,
        probe_provenance_retained: status == 3,
        synthetic_scope_only: true,
    }
    validate_carrier(result)
    result
}

pub fn certify_policy_observation_nonassociativity(
    witness_id: i64,
    a: PolicyObservationCarrierReceipt,
    b: PolicyObservationCarrierReceipt,
    c: PolicyObservationCarrierReceipt,
    left_grouped: PolicyObservationCarrierReceipt,
    right_grouped: PolicyObservationCarrierReceipt,
) -> PolicyObservationNonAssociativityReceipt with Panic {
    validate_carrier(a)
    validate_carrier(b)
    validate_carrier(c)
    validate_carrier(left_grouped)
    validate_carrier(right_grouped)
    assert(witness_id > 0)
    assert(a.atom_origin_mask == 1 && b.atom_origin_mask == 2 &&
        c.atom_origin_mask == 4)
    assert(a.carrier_id == 9101 && b.carrier_id == 9102 && c.carrier_id == 9103)
    assert(left_grouped.atom_origin_mask == 7)
    assert(right_grouped.atom_origin_mask == 7)
    assert(left_grouped.ordered_atom_id_1 == a.carrier_id &&
        left_grouped.ordered_atom_id_2 == b.carrier_id &&
        left_grouped.ordered_atom_id_3 == c.carrier_id)
    assert(right_grouped.ordered_atom_id_1 == a.carrier_id &&
        right_grouped.ordered_atom_id_2 == b.carrier_id &&
        right_grouped.ordered_atom_id_3 == c.carrier_id)
    assert(left_grouped.flat_trace_fingerprint == 93767706)
    assert(right_grouped.flat_trace_fingerprint == 93767706)
    assert(left_grouped.grouping_tree_fingerprint == 9037326)
    assert(right_grouped.grouping_tree_fingerprint == 573396)
    assert(left_grouped.probe_status_code == 2)
    assert(right_grouped.probe_status_code == 3)
    let status_diff = left_grouped.probe_status_code !=
        right_grouped.probe_status_code
    let mask_diff = left_grouped.survivor_mask != right_grouped.survivor_mask
    let burden_diff = left_grouped.burden_spent != right_grouped.burden_spent
    let evidence_diff = left_grouped.evidence_count != right_grouped.evidence_count
    let difference_bitset = d6_bool_i64(status_diff) + 2 * d6_bool_i64(mask_diff) +
        4 * d6_bool_i64(burden_diff) + 8 * d6_bool_i64(evidence_diff)
    assert(difference_bitset == 15)
    PolicyObservationNonAssociativityReceipt {
        witness_id: witness_id,
        operator_id: 9601,
        a_atom_id: a.carrier_id,
        b_atom_id: b.carrier_id,
        c_atom_id: c.carrier_id,
        ordered_atom_fingerprint: left_grouped.flat_trace_fingerprint,
        left_grouping_tree_fingerprint: left_grouped.grouping_tree_fingerprint,
        right_grouping_tree_fingerprint: right_grouped.grouping_tree_fingerprint,
        left_probe_status_code: left_grouped.probe_status_code,
        right_probe_status_code: right_grouped.probe_status_code,
        left_survivor_mask: left_grouped.survivor_mask,
        right_survivor_mask: right_grouped.survivor_mask,
        left_burden_spent: left_grouped.burden_spent,
        right_burden_spent: right_grouped.burden_spent,
        left_evidence_count: left_grouped.evidence_count,
        right_evidence_count: right_grouped.evidence_count,
        left_evidence_fingerprint: left_grouped.evidence_fingerprint,
        right_evidence_fingerprint: right_grouped.evidence_fingerprint,
        difference_bitset: difference_bitset,
        same_typed_operands: true,
        same_ordered_operands: true,
        same_partial_operator: true,
        both_parenthesizations_defined: true,
        results_unequal: true,
        declared_partial_operator_nonassociative_on_witness: true,
        total_magma_theorem_established: false,
        ordinary_function_composition_targeted: false,
        causal_feedback_mechanism_established: false,
        empirical_psychiatric_order_effect_established: false,
        clinical_authority: false,
    }
}

pub fn certify_flat_trace_associative_control(
    control_id: i64,
    a: PolicyObservationCarrierReceipt,
    b: PolicyObservationCarrierReceipt,
    c: PolicyObservationCarrierReceipt,
) -> FlatTraceAssociativeControlReceipt with Panic {
    validate_carrier(a)
    validate_carrier(b)
    validate_carrier(c)
    assert(control_id > 0)
    let ab = concat_flat(a.flat_trace_fingerprint, b.flat_trace_fingerprint, 1)
    let left = concat_flat(ab, c.flat_trace_fingerprint, 1)
    let bc = concat_flat(b.flat_trace_fingerprint, c.flat_trace_fingerprint, 1)
    let right = concat_flat(a.flat_trace_fingerprint, bc, 2)
    assert(left == 93767706 && right == 93767706)
    let p0 = flat_three(9101, 9102, 9103)
    let p1 = flat_three(9101, 9103, 9102)
    let p2 = flat_three(9102, 9101, 9103)
    let p3 = flat_three(9102, 9103, 9101)
    let p4 = flat_three(9103, 9101, 9102)
    let p5 = flat_three(9103, 9102, 9101)
    assert(p0 == 93767706 && p1 == 93767806)
    assert(p2 == 93777806 && p3 == 93778006)
    assert(p4 == 93788006 && p5 == 93788106)
    assert(p0 != p1 && p0 != p2 && p0 != p3 && p0 != p4 && p0 != p5)
    assert(p1 != p2 && p1 != p3 && p1 != p4 && p1 != p5)
    assert(p2 != p3 && p2 != p4 && p2 != p5)
    assert(p3 != p4 && p3 != p5 && p4 != p5)
    assert(p5 < 9223372036854775807)
    FlatTraceAssociativeControlReceipt {
        control_id: control_id,
        left_grouped_fingerprint: left,
        right_grouped_fingerprint: right,
        leaf_count: 3,
        exact_equal: true,
        concatenation_associative_on_witness: true,
        all_six_frozen_label_orders_encoded: true,
        frozen_label_order_checksums_distinct: true,
        semantic_carrier_associative_claimed: false,
    }
}

pub fn certify_grouping_retained_rival(
    rival_id: i64,
    left_grouped: PolicyObservationCarrierReceipt,
    right_grouped: PolicyObservationCarrierReceipt,
) -> GroupingRetainedRivalReceipt with Panic {
    validate_carrier(left_grouped)
    validate_carrier(right_grouped)
    assert(rival_id > 0)
    assert(left_grouped.atom_origin_mask == 7 && right_grouped.atom_origin_mask == 7)
    assert(left_grouped.carrier_id != right_grouped.carrier_id)
    assert(left_grouped.flat_trace_fingerprint == right_grouped.flat_trace_fingerprint)
    assert(left_grouped.grouping_tree_fingerprint !=
        right_grouped.grouping_tree_fingerprint)
    assert(left_grouped.probe_status_code != right_grouped.probe_status_code)
    let replayed_left_status = replay_frozen_probe_status_from_tree(
        left_grouped.grouping_tree_fingerprint,
    )
    let replayed_right_status = replay_frozen_probe_status_from_tree(
        right_grouped.grouping_tree_fingerprint,
    )
    assert(replayed_left_status == left_grouped.probe_status_code)
    assert(replayed_right_status == right_grouped.probe_status_code)
    GroupingRetainedRivalReceipt {
        rival_id: rival_id,
        flat_trace_fingerprint: left_grouped.flat_trace_fingerprint,
        left_grouping_tree_fingerprint: left_grouped.grouping_tree_fingerprint,
        right_grouping_tree_fingerprint: right_grouped.grouping_tree_fingerprint,
        projected_flat_payloads_equal: true,
        projected_receipt_identities_equal: false,
        expanded_grouping_states_distinct: true,
        frozen_outcomes_reproduced_from_grouping: true,
        same_complete_state_claimed: false,
        irreducible_memory_claimed: false,
    }
}

pub fn certify_committed_evidence_monotonicity(
    receipt_id: i64,
    inner_commit: PolicyObservationCarrierReceipt,
    outer_policy_result: PolicyObservationCarrierReceipt,
) -> CommittedEvidenceMonotonicityReceipt with Panic {
    validate_carrier(inner_commit)
    validate_carrier(outer_policy_result)
    assert(receipt_id > 0)
    assert(inner_commit.atom_origin_mask == 6)
    assert(inner_commit.probe_status_code == 3)
    assert(inner_commit.observed_target_value == 8)
    assert(inner_commit.last_evidence_provenance_id == 8103)
    assert(outer_policy_result.atom_origin_mask == 7)
    assert(outer_policy_result.grouping_tree_fingerprint == 573396)
    assert(outer_policy_result.probe_status_code == 3)
    assert(outer_policy_result.observed_target_value == 8)
    assert(outer_policy_result.last_evidence_provenance_id == 8103)
    assert(outer_policy_result.evidence_count >= inner_commit.evidence_count)
    CommittedEvidenceMonotonicityReceipt {
        receipt_id: receipt_id,
        inner_commit_carrier_id: inner_commit.carrier_id,
        outer_policy_carrier_id: outer_policy_result.carrier_id,
        inner_target_value: inner_commit.observed_target_value,
        outer_target_value: outer_policy_result.observed_target_value,
        inner_probe_provenance_id: inner_commit.last_evidence_provenance_id,
        outer_probe_provenance_id: outer_policy_result.last_evidence_provenance_id,
        committed_before_outer_policy: true,
        committed_after_outer_policy: true,
        retroactive_erasure_permitted: false,
        monotone_only_in_declared_fixture: true,
    }
}

