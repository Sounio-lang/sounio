// Exact finite synthetic kernel for proof-carrying policy-observation
// non-associativity D6.
//
// The carrier operation is partial: it composes adjacent, disjoint fragments
// of the frozen ordered program [policy context, commit boundary, pending
// probe]. Both parenthesizations of that one ordered triple are defined. The
// fixture does not claim a total magma, ordinary function-composition result,
// empirical psychiatric law, causal mechanism, or clinical authority.

use epistemic::proof_carrying_policy_state_feedback::{
    AdaptiveObservationPolicyFamilyReceipt,
    DeclaredSyntheticObservationBudgetReceipt,
    ObservedAnchorValueReceipt,
    AdaptiveObservationPolicyDecisionReceipt,
    PolicyCoverageGapReceipt,
    SyntheticExogenousCoverageAssignmentReceipt,
    PolicyEvidenceProvenanceReceipt,
}

pub struct PolicyObservationCarrierReceipt {
    carrier_id: i64,
    operator_id: i64,
    family_id: i64,
    protocol_id: i64,
    burden_capacity: i64,
    first_position: i64,
    last_position: i64,
    leaf_count: i64,
    atom_origin_mask: i64,
    ordered_atom_id_1: i64,
    ordered_atom_id_2: i64,
    ordered_atom_id_3: i64,
    flat_trace_fingerprint: i64,
    grouping_tree_fingerprint: i64,
    contains_policy_context: bool,
    contains_commit_boundary: bool,
    contains_pending_probe_atom: bool,
    probe_status_code: i64,
    target_candidate_value: i64,
    observed_target_value: i64,
    survivor_mask: i64,
    evidence_count: i64,
    burden_spent: i64,
    last_evidence_provenance_id: i64,
    evidence_fingerprint: i64,
    policy_was_in_scope_when_probe_resolved: bool,
    probe_committed_without_policy_scope: bool,
    anchor_provenance_retained: bool,
    probe_provenance_retained: bool,
    synthetic_scope_only: bool,
}

