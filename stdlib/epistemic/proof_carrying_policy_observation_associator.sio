        ordered_atom_id_2: 9102,
        ordered_atom_id_3: 0,
        flat_trace_fingerprint: atom_id,
        grouping_tree_fingerprint: atom_id,
        contains_policy_context: false,
        contains_commit_boundary: true,
        contains_pending_probe_atom: false,
        probe_status_code: 0,
