pub fn replay_frozen_grouping_probe_status(
    state: GroupingRetainedPolicyObservationStateReceipt,
) -> i64 with Panic {
    assert(state.carrier_id > 0)
    assert(state.flat_trace_fingerprint == 93767706)
    assert(state.grouping_retained)
    replay_frozen_probe_status_from_tree(state.grouping_tree_fingerprint)
}

