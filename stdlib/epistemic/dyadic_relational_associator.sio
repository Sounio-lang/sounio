// Exact finite synthetic kernel for relational associator D1.
//
// The frozen operation is a model construction. It does not represent a real
// person, therapeutic relation, causal mechanism, or clinical instruction.

pub struct AssociatorProductBoundReceipt {
    pub component_max: i64,
    pub initial_product_max: i64,
    pub carrier_max: i64,
    pub checked_before_multiplication: bool,
    pub dynamic_products_require_runtime_check: bool,
}

pub struct AssociatorRationalReceipt {
    pub numerator: i64,
    pub denominator: i64,
    pub exact_not_floating_point: bool,
}

pub struct MediationRuleReceipt {
    pub rule_id: i64,
    pub retained_left_weight: i64,
    pub incoming_right_weight: i64,
    pub weight_denominator: i64,
    pub intermediate_context_closed: bool,
    pub ordinary_function_composition_targeted: bool,
    pub empirically_calibrated: bool,
    pub clinical_authority: bool,
}

pub struct OrderedRelationalLeavesReceipt {
    pub leaves_id: i64,
    pub a: AssociatorRationalReceipt,
    pub b: AssociatorRationalReceipt,
    pub c: AssociatorRationalReceipt,
    pub order_fixed: bool,
    pub synthetic_not_patient_data: bool,
}

pub struct MediatedPairReceipt {
    pub rule_id: i64,
    pub left: AssociatorRationalReceipt,
    pub right: AssociatorRationalReceipt,
    pub result: AssociatorRationalReceipt,
    pub exact_formula_replayed: bool,
    pub result_within_runtime_carrier_bound: bool,
}

pub struct GroupedRelationalEvaluationReceipt {
    evaluation_id: i64,
    leaves_id: i64,
    rule_id: i64,
    grouping_code: i64,
    first_intermediate: AssociatorRationalReceipt,
    result: AssociatorRationalReceipt,
    same_ordered_leaves: bool,
    grouping_retained: bool,
}

pub struct ExactRelationalAssociatorReceipt {
    pub witness_id: i64,
    pub left_grouped_evaluation_id: i64,
    pub right_grouped_evaluation_id: i64,
    pub raw_signed_numerator: i64,
    pub raw_denominator: i64,
    pub reduced_signed_numerator: i64,
    pub reduced_denominator: i64,
    pub exact_nonzero: bool,
    pub same_rule: bool,
    pub same_ordered_leaves: bool,
    pub grouping_only_declared_difference: bool,
    pub bounded_synthetic_scope_only: bool,
    pub causal_mechanism_established: bool,
    pub clinical_authority: bool,
}

pub struct AssociativeControlReceipt {
    pub control_id: i64,
    pub left_grouped: AssociatorRationalReceipt,
    pub right_grouped: AssociatorRationalReceipt,
    pub exact_equal: bool,
    pub addition_associator_zero: bool,
    pub same_ordered_leaves: bool,
}

pub struct GroupingStateExpansionReceipt {
    pub rival_id: i64,
    pub left_grouping_code: i64,
    pub right_grouping_code: i64,
    pub unexpanded_leaf_state_equal: bool,
    pub expanded_states_distinct: bool,
    pub frozen_transition_table_total: bool,
    pub exact_outputs_reproduced: bool,
    pub future_output_is_function_of_grouping_code: bool,
}

pub struct CausalRelationalMechanismReceipt {
    pub mechanism_id: i64,
}

pub struct ClinicalRelationalAuthorityReceipt {
    pub authority_id: i64,
}

pub fn authorize_associator_products(
    component_max: i64,
    carrier_max: i64,
) -> AssociatorProductBoundReceipt with Div, Panic {
    assert(component_max > 0)
    assert(carrier_max > 0)
    // Leaves are small; every larger intermediate product is separately
    // authorized at runtime against the carrier before multiplication.
    assert(component_max <= 1000000)
    assert(component_max <= carrier_max / component_max)
    let product_max = component_max * component_max
    AssociatorProductBoundReceipt {
        component_max: component_max,
        initial_product_max: product_max,
        carrier_max: carrier_max,
        checked_before_multiplication: true,
        dynamic_products_require_runtime_check: true,
    }
}

pub fn associator_rational(
    numerator: i64,
    denominator: i64,
    bound: AssociatorProductBoundReceipt,
) -> AssociatorRationalReceipt with Panic {
    assert(numerator >= 0)
    assert(denominator > 0)
    assert(numerator <= bound.component_max)
    assert(denominator <= bound.component_max)
    AssociatorRationalReceipt {
        numerator: numerator,
        denominator: denominator,
        exact_not_floating_point: true,
    }
}

pub fn declare_mediation_rule(rule_id: i64) -> MediationRuleReceipt with Panic {
    assert(rule_id > 0)
    MediationRuleReceipt {
        rule_id: rule_id,
        retained_left_weight: 2,
        incoming_right_weight: 1,
        weight_denominator: 3,
        intermediate_context_closed: true,
        ordinary_function_composition_targeted: false,
        empirically_calibrated: false,
        clinical_authority: false,
    }
}

pub fn declare_ordered_relational_leaves(
    leaves_id: i64,
    a: AssociatorRationalReceipt,
    b: AssociatorRationalReceipt,
    c: AssociatorRationalReceipt,
) -> OrderedRelationalLeavesReceipt with Panic {
    assert(leaves_id > 0)
    OrderedRelationalLeavesReceipt {
        leaves_id: leaves_id,
        a: a,
        b: b,
        c: c,
        order_fixed: true,
        synthetic_not_patient_data: true,
    }
}

pub fn mediate_exact(
    left: AssociatorRationalReceipt,
    right: AssociatorRationalReceipt,
    rule: MediationRuleReceipt,
    bound: AssociatorProductBoundReceipt,
) -> MediatedPairReceipt with Div, Panic {
    assert(left.numerator >= 0 && left.numerator <= bound.carrier_max)
    assert(left.denominator > 0 && left.denominator <= bound.carrier_max)
    assert(right.numerator >= 0 && right.numerator <= bound.carrier_max)
    assert(right.denominator > 0 && right.denominator <= bound.carrier_max)
    let left_cross = checked_nonnegative_product(
        left.numerator, right.denominator, bound.carrier_max,
    )
    let right_cross = checked_nonnegative_product(
        right.numerator, left.denominator, bound.carrier_max,
    )
    let weighted_left = checked_nonnegative_product(
        rule.retained_left_weight, left_cross, bound.carrier_max,
    )
    let weighted_right = checked_nonnegative_product(
        rule.incoming_right_weight, right_cross, bound.carrier_max,
    )
    assert(weighted_left <= bound.carrier_max - weighted_right)
    let denominator_cross = checked_nonnegative_product(
        left.denominator, right.denominator, bound.carrier_max,
    )
    let denominator = checked_nonnegative_product(
        rule.weight_denominator, denominator_cross, bound.carrier_max,
    )
    assert(weighted_left >= 0 && weighted_right >= 0 && denominator > 0)
    MediatedPairReceipt {
        rule_id: rule.rule_id,
        left: left,
        right: right,
        result: AssociatorRationalReceipt {
            numerator: weighted_left + weighted_right,
            denominator: denominator,
            exact_not_floating_point: true,
        },
        exact_formula_replayed: true,
        result_within_runtime_carrier_bound: true,
    }
}

fn checked_nonnegative_product(
    left: i64,
    right: i64,
    carrier_max: i64,
) -> i64 with Div, Panic {
    assert(left >= 0 && right >= 0 && carrier_max > 0)
    if right > 0 {
        assert(left <= carrier_max / right)
    }
    left * right
}

pub fn evaluate_left_grouped(
    evaluation_id: i64,
    leaves: OrderedRelationalLeavesReceipt,
    rule: MediationRuleReceipt,
    bound: AssociatorProductBoundReceipt,
) -> GroupedRelationalEvaluationReceipt with Div, Panic {
    assert(evaluation_id > 0)
    let ab = mediate_exact(leaves.a, leaves.b, rule, bound)
    let abc = mediate_exact(ab.result, leaves.c, rule, bound)
    GroupedRelationalEvaluationReceipt {
        evaluation_id: evaluation_id,
        leaves_id: leaves.leaves_id,
        rule_id: rule.rule_id,
        grouping_code: 1,
        first_intermediate: ab.result,
        result: abc.result,
        same_ordered_leaves: true,
        grouping_retained: true,
    }
}

pub fn evaluate_right_grouped(
    evaluation_id: i64,
    leaves: OrderedRelationalLeavesReceipt,
    rule: MediationRuleReceipt,
    bound: AssociatorProductBoundReceipt,
) -> GroupedRelationalEvaluationReceipt with Div, Panic {
    assert(evaluation_id > 0)
    let bc = mediate_exact(leaves.b, leaves.c, rule, bound)
    let abc = mediate_exact(leaves.a, bc.result, rule, bound)
    GroupedRelationalEvaluationReceipt {
        evaluation_id: evaluation_id,
        leaves_id: leaves.leaves_id,
        rule_id: rule.rule_id,
        grouping_code: 2,
        first_intermediate: bc.result,
        result: abc.result,
        same_ordered_leaves: true,
        grouping_retained: true,
    }
}

fn associator_gcd(a0: i64, b0: i64) -> i64 with Mut {
    var a = if a0 < 0 { -a0 } else { a0 }
    var b = if b0 < 0 { -b0 } else { b0 }
    while b != 0 {
        let r = a % b
        a = b
        b = r
    }
    if a == 0 { 1 } else { a }
}

pub fn certify_exact_relational_associator_witness(
    witness_id: i64,
    left: GroupedRelationalEvaluationReceipt,
    right: GroupedRelationalEvaluationReceipt,
    bound: AssociatorProductBoundReceipt,
) -> ExactRelationalAssociatorReceipt with Div, Mut, Panic {
    assert(witness_id > 0)
    assert(left.rule_id == right.rule_id)
    assert(left.leaves_id == right.leaves_id)
    assert(left.grouping_code == 1 && right.grouping_code == 2)
    assert(left.result.numerator >= 0 && right.result.numerator >= 0)
    assert(left.result.denominator > 0 && right.result.denominator > 0)
    assert(left.result.numerator <= bound.carrier_max)
    assert(right.result.numerator <= bound.carrier_max)
    assert(left.result.denominator <= bound.carrier_max)
    assert(right.result.denominator <= bound.carrier_max)
    let left_cross = checked_nonnegative_product(
        left.result.numerator, right.result.denominator, bound.carrier_max,
    )
    let right_cross = checked_nonnegative_product(
        right.result.numerator, left.result.denominator, bound.carrier_max,
    )
    let raw = left_cross - right_cross
    let denominator = checked_nonnegative_product(
        left.result.denominator, right.result.denominator, bound.carrier_max,
    )
    assert(raw != 0)
    let divisor = associator_gcd(raw, denominator)
    assert(divisor > 0)
    ExactRelationalAssociatorReceipt {
        witness_id: witness_id,
        left_grouped_evaluation_id: left.evaluation_id,
        right_grouped_evaluation_id: right.evaluation_id,
        raw_signed_numerator: raw,
        raw_denominator: denominator,
        reduced_signed_numerator: raw / divisor,
        reduced_denominator: denominator / divisor,
        exact_nonzero: true,
        same_rule: true,
        same_ordered_leaves: true,
        grouping_only_declared_difference: true,
        bounded_synthetic_scope_only: true,
        causal_mechanism_established: false,
        clinical_authority: false,
    }
}

fn add_exact(
    left: AssociatorRationalReceipt,
    right: AssociatorRationalReceipt,
) -> AssociatorRationalReceipt {
    AssociatorRationalReceipt {
        numerator: left.numerator * right.denominator +
            right.numerator * left.denominator,
        denominator: left.denominator * right.denominator,
        exact_not_floating_point: true,
    }
}

fn rational_equal(
    left: AssociatorRationalReceipt,
    right: AssociatorRationalReceipt,
) -> bool {
    left.numerator * right.denominator ==
        right.numerator * left.denominator
}

pub fn prove_associative_control(
    control_id: i64,
    leaves: OrderedRelationalLeavesReceipt,
) -> AssociativeControlReceipt with Panic {
    assert(control_id > 0)
    // This receipt certifies the frozen D1 leaves, not arbitrary unchecked
    // rationals passed through the private addition helper.
    assert(leaves.a.numerator == 3 && leaves.a.denominator == 10)
    assert(leaves.b.numerator == 3 && leaves.b.denominator == 5)
    assert(leaves.c.numerator == 9 && leaves.c.denominator == 10)
    let left = add_exact(add_exact(leaves.a, leaves.b), leaves.c)
    let right = add_exact(leaves.a, add_exact(leaves.b, leaves.c))
    assert(rational_equal(left, right))
    AssociativeControlReceipt {
        control_id: control_id,
        left_grouped: left,
        right_grouped: right,
        exact_equal: true,
        addition_associator_zero: true,
        same_ordered_leaves: true,
    }
}

pub fn record_grouping_state_expansion(
    rival_id: i64,
    left: GroupedRelationalEvaluationReceipt,
    right: GroupedRelationalEvaluationReceipt,
) -> GroupingStateExpansionReceipt with Panic {
    assert(rival_id > 0)
    assert(left.leaves_id == right.leaves_id)
    assert(left.grouping_code != right.grouping_code)
    assert(left.grouping_code == 1 && right.grouping_code == 2)
    // A total transition table on the frozen two-state family. Future output
    // is now a function of the expanded grouping code rather than of an
    // unobserved history label.
    let predicted_left = AssociatorRationalReceipt {
        numerator: 2550,
        denominator: 4500,
        exact_not_floating_point: true,
    }
    let predicted_right = AssociatorRationalReceipt {
        numerator: 1950,
        denominator: 4500,
        exact_not_floating_point: true,
    }
    assert(rational_equal(predicted_left, left.result))
    assert(rational_equal(predicted_right, right.result))
    GroupingStateExpansionReceipt {
        rival_id: rival_id,
        left_grouping_code: left.grouping_code,
        right_grouping_code: right.grouping_code,
        unexpanded_leaf_state_equal: true,
        expanded_states_distinct: true,
        frozen_transition_table_total: true,
        exact_outputs_reproduced: true,
        future_output_is_function_of_grouping_code: true,
    }
}
