// epistemic/uplift.sio — Uplift Modeling with Epistemic Uncertainty
// CATE estimation with credible intervals

fn uplift_abs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }
fn uplift_sqrt(x: f64) -> f64 {
    if x <= 0.0 { return 0.0 }
    var r = x
    var i = 0
    while i < 15 { r = 0.5 * (r + x / r); i = i + 1 }
    r
}
fn uplift_max(a: f64, b: f64) -> f64 { if a > b { a } else { b } }
fn uplift_min(a: f64, b: f64) -> f64 { if a < b { a } else { b } }

// Treatment effect estimate with uncertainty
struct CATEEstimate {
    value: f64,
    variance: f64,
    ci_lo: f64,
    ci_hi: f64,
    n_treated: i64,
    n_control: i64,
}

fn cate_estimate_new() -> CATEEstimate {
    CATEEstimate { value: 0.0, variance: 0.0, ci_lo: 0.0, ci_hi: 0.0, n_treated: 0, n_control: 0 }
}

// Simple difference-in-means estimator
fn estimate_ate(
    treated_outcomes: &[f64; 256], n_treated: i64,
    control_outcomes: &[f64; 256], n_control: i64
) -> CATEEstimate with Mut, Div, Panic {
    var result = cate_estimate_new()
    if n_treated <= 0 || n_control <= 0 { return result }

    var sum_t = 0.0
    var i: i64 = 0
    while i < n_treated { sum_t = sum_t + treated_outcomes[i as usize]; i = i + 1 }
    let mean_t = sum_t / (n_treated as f64)

    var sum_c = 0.0
    i = 0
    while i < n_control { sum_c = sum_c + control_outcomes[i as usize]; i = i + 1 }
    let mean_c = sum_c / (n_control as f64)

    result.value = mean_t - mean_c
    result.n_treated = n_treated
    result.n_control = n_control

    // Variance of difference in means
    var ss_t = 0.0
    i = 0
    while i < n_treated { let d = treated_outcomes[i as usize] - mean_t; ss_t = ss_t + d * d; i = i + 1 }
    var ss_c = 0.0
    i = 0
    while i < n_control { let d = control_outcomes[i as usize] - mean_c; ss_c = ss_c + d * d; i = i + 1 }

    let var_t = ss_t / (n_treated as f64)
    let var_c = ss_c / (n_control as f64)
    result.variance = var_t / (n_treated as f64) + var_c / (n_control as f64)

    let se = uplift_sqrt(result.variance)
    result.ci_lo = result.value - 1.96 * se
    result.ci_hi = result.value + 1.96 * se

    result
}

// Uplift tree node (simplified)
struct UpliftNode {
    split_feature: i32,
    split_value: f64,
    left_cate: f64,
    right_cate: f64,
    is_leaf: bool,
}

fn uplift_leaf(cate: f64) -> UpliftNode {
    UpliftNode { split_feature: 0, split_value: 0.0, left_cate: cate, right_cate: cate, is_leaf: true }
}

// Qini coefficient (area between uplift and random curves)
fn qini_coefficient(
    predicted_uplift: &[f64; 256],
    actual_outcome: &[f64; 256],
    treatment: &[i32; 256],
    n: i64
) -> f64 with Mut, Div, Panic {
    if n <= 0 { return 0.0 }
    // Simplified: compute average uplift for treated vs control
    var sum_treated = 0.0
    var sum_control = 0.0
    var n_t: i64 = 0
    var n_c: i64 = 0
    var i: i64 = 0
    while i < n {
        if treatment[i as usize] == 1 {
            sum_treated = sum_treated + actual_outcome[i as usize]
            n_t = n_t + 1
        } else {
            sum_control = sum_control + actual_outcome[i as usize]
            n_c = n_c + 1
        }
        i = i + 1
    }
    if n_t == 0 || n_c == 0 { return 0.0 }
    (sum_treated / (n_t as f64)) - (sum_control / (n_c as f64))
}

fn test_ate_estimate() -> bool with Mut, Div, Panic {
    var treated: [f64; 256] = [0.0; 256]
    var control: [f64; 256] = [0.0; 256]
    treated[0] = 5.0
    treated[1] = 6.0
    treated[2] = 7.0
    control[0] = 3.0
    control[1] = 4.0
    control[2] = 5.0
    let ate = estimate_ate(&treated, 3, &control, 3)
    uplift_abs(ate.value - 2.0) < 0.01
}

fn test_zero_uplift() -> bool with Mut, Div, Panic {
    var outcomes: [f64; 256] = [0.0; 256]
    outcomes[0] = 5.0
    outcomes[1] = 5.0
    let ate = estimate_ate(&outcomes, 2, &outcomes, 2)
    uplift_abs(ate.value) < 0.01
}
