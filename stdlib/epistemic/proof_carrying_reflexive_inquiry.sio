    let state = ReflexiveInquiryContestStateReceipt {
        state_id: state_id,
        family_id: family.family_id,
        protocol_id: family.protocol_id,
        survivor_mask: 7,
        survivor_count: 3,
        evidence_count: 0,
        burden_spent: 0,
        last_provenance_id: 0,
        provenance_fingerprint: 0,
        family_refuted: false,
    }
    validate_contest_state(state)
    state
}

pub fn record_missing_order_trace_observation(
    observation_id: i64,
    family: ThreeLocusInquiryFamilyReceipt,
    tick: i64,
) -> MissingOrderTraceObservationReceipt with Panic {
    validate_family(family)
    assert(observation_id > 0 && tick > 0)
    let missing = MissingOrderTraceObservationReceipt {
        observation_id: observation_id,
        family_id: family.family_id,
        protocol_id: family.protocol_id,
        tick: tick,
        value_present: false,
        hypotheses_eliminated: 0,
    }
    validate_missing_order_trace(missing)
    missing
}

pub fn record_unaudited_order_trace_observation(
    observation_id: i64,
    family: ThreeLocusInquiryFamilyReceipt,
    tick: i64,
) -> UnauditedOrderTraceObservationReceipt with Panic {
    validate_family(family)
    assert(observation_id > 0 && tick > 0)
    let unaudited = UnauditedOrderTraceObservationReceipt {
        observation_id: observation_id,
        family_id: family.family_id,
        protocol_id: family.protocol_id,
        tick: tick,
        value_present: true,
        provenance_complete: false,
        hypotheses_eliminated: 0,
    }
    validate_unaudited_order_trace(unaudited)
    unaudited
}

pub fn abstain_on_missing_order_trace(
    abstention_id: i64,
    state: ReflexiveInquiryContestStateReceipt,
    missing: MissingOrderTraceObservationReceipt,
) -> ReflexiveInquiryAbstentionReceipt with Panic {
    assert(abstention_id > 0)
    validate_contest_state(state)
    validate_missing_order_trace(missing)
    assert(missing.family_id == state.family_id)
    assert(missing.protocol_id == state.protocol_id)
    assert(!missing.value_present && missing.hypotheses_eliminated == 0)
    ReflexiveInquiryAbstentionReceipt {
        abstention_id: abstention_id,
        reason_code: 1,
        survivor_mask_unchanged: state.survivor_mask,
        survivor_count_unchanged: state.survivor_count,
        hypotheses_eliminated: 0,
        inference_deferred: true,
    }
}

pub fn abstain_on_unaudited_order_trace(
    abstention_id: i64,
    state: ReflexiveInquiryContestStateReceipt,
    unaudited: UnauditedOrderTraceObservationReceipt,
) -> ReflexiveInquiryAbstentionReceipt with Panic {
    assert(abstention_id > 0)
    validate_contest_state(state)
    validate_unaudited_order_trace(unaudited)
    assert(unaudited.family_id == state.family_id)
    assert(unaudited.protocol_id == state.protocol_id)
    assert(unaudited.value_present && !unaudited.provenance_complete)
    assert(unaudited.hypotheses_eliminated == 0)
    ReflexiveInquiryAbstentionReceipt {
        abstention_id: abstention_id,
        reason_code: 2,
        survivor_mask_unchanged: state.survivor_mask,
        survivor_count_unchanged: state.survivor_count,
        hypotheses_eliminated: 0,
        inference_deferred: true,
    }
}

pub fn admit_order_trace_observation(
    observation_id: i64,
    state: ReflexiveInquiryContestStateReceipt,
    family: ThreeLocusInquiryFamilyReceipt,
    pair: MatchedSyntheticProtocolPairReceipt,
    provenance: InquiryEvidenceProvenanceReceipt,
    p_then_q_first: i64,
    p_then_q_second: i64,
    q_then_p_first: i64,
    q_then_p_second: i64,
) -> AdmissibleOrderTraceObservationReceipt with Panic {
    assert(observation_id > 0)
    validate_contest_state(state)
    validate_family(family)
    validate_matched_pair(pair)
    validate_evidence_provenance(provenance)
    assert(state.family_id == family.family_id)
    assert(state.protocol_id == family.protocol_id)
    assert(pair.protocol_id == family.protocol_id)
    assert(pair.schedules_start_from_equal_full_state)
    assert(pair.synthetic_reset_declared)
    assert(!pair.same_real_person_counterfactual_claimed)
    assert(provenance.chain_complete)
    assert(provenance.protocol_id == family.protocol_id)
    assert(provenance.previous_provenance_id == state.last_provenance_id)
    assert(provenance.tick == state.evidence_count + 1)
    assert(p_then_q_first >= 0 && p_then_q_first <= 100)
    assert(p_then_q_second >= 0 && p_then_q_second <= 100)
    assert(q_then_p_first >= 0 && q_then_p_first <= 100)
    assert(q_then_p_second >= 0 && q_then_p_second <= 100)
    let observation = AdmissibleOrderTraceObservationReceipt {
        observation_id: observation_id,
        family_id: family.family_id,
        protocol_id: family.protocol_id,
        matched_pair_id: pair.pair_id,
        p_then_q_first_observation: p_then_q_first,
        p_then_q_second_observation: p_then_q_second,
        q_then_p_first_observation: q_then_p_first,
        q_then_p_second_observation: q_then_p_second,
        provenance_id: provenance.provenance_id,
        previous_provenance_id: provenance.previous_provenance_id,
        source_id: provenance.source_id,
        tick: provenance.tick,
        declared_burden_units: 4,
        value_present: true,
        matched_schedule_provenance_complete: true,
        physical_observation_claimed: false,
    }
    validate_order_trace_observation(observation)
    observation
}

pub fn update_reflexive_contest_with_order_trace(
    transition_id: i64,
    result_state_id: i64,
    source: ReflexiveInquiryContestStateReceipt,
    family: ThreeLocusInquiryFamilyReceipt,
    observation: AdmissibleOrderTraceObservationReceipt,
) -> ReflexiveInquiryContestTransitionReceipt with Panic {
    assert(transition_id > 0 && result_state_id > 0)
    validate_contest_state(source)
    validate_family(family)
    validate_order_trace_observation(observation)
    assert(source.evidence_count < 2)
    assert(source.survivor_count > 0)
    assert(source.family_id == family.family_id)
    assert(observation.family_id == family.family_id)
    assert(observation.protocol_id == family.protocol_id)
    assert(observation.value_present)
    assert(observation.matched_schedule_provenance_complete)
    assert(!observation.physical_observation_claimed)
    assert(observation.previous_provenance_id == source.last_provenance_id)
    assert(observation.tick == source.evidence_count + 1)
    let passive_alive = source.survivor_mask % 2 == 1 &&
        prediction_matches_order_trace(0, observation)
    let relational_alive = (source.survivor_mask / 2) % 2 == 1 &&
        prediction_matches_order_trace(1, observation)
    let instrument_alive = (source.survivor_mask / 4) % 2 == 1 &&
        prediction_matches_order_trace(2, observation)
    let mask = as_i64(passive_alive) + 2 * as_i64(relational_alive) +
        4 * as_i64(instrument_alive)
    let count = count_three_mask(mask)
    let result = ReflexiveInquiryContestStateReceipt {
        state_id: result_state_id,
        family_id: source.family_id,
        protocol_id: source.protocol_id,
        survivor_mask: mask,
        survivor_count: count,
        evidence_count: source.evidence_count + 1,
        burden_spent: source.burden_spent + observation.declared_burden_units,
        last_provenance_id: observation.provenance_id,
        provenance_fingerprint: source.provenance_fingerprint * 31 +
            observation.provenance_id,
        family_refuted: count == 0,
    }
    validate_contest_state(result)
    ReflexiveInquiryContestTransitionReceipt {
        transition_id: transition_id,
        evidence_kind: 0,
        family_id: source.family_id,
        protocol_id: source.protocol_id,
        source_state_id: source.state_id,
        source_survivor_mask: source.survivor_mask,
        source_survivor_count: source.survivor_count,
        source_evidence_count: source.evidence_count,
        source_burden_spent: source.burden_spent,
        source_last_provenance_id: source.last_provenance_id,
        source_provenance_fingerprint: source.provenance_fingerprint,
        result_survivor_mask: mask,
        result_survivor_count: count,
        eliminated_mask: source.survivor_mask - mask,
        eliminated_count: source.survivor_count - count,
        provenance_id: observation.provenance_id,
        previous_provenance_id: observation.previous_provenance_id,
        declared_burden_units: observation.declared_burden_units,
        p_then_q_first_observation: observation.p_then_q_first_observation,
        p_then_q_second_observation: observation.p_then_q_second_observation,
        q_then_p_first_observation: observation.q_then_p_first_observation,
        q_then_p_second_observation: observation.q_then_p_second_observation,
        audit_layer_index: -1,
        audit_observed_value: -1,
        result_state: result,
        exact_prediction_replay: true,
    }
}

pub fn certify_reactive_locus_ambiguity(
    ambiguity_id: i64,
    transition: ReflexiveInquiryContestTransitionReceipt,
    family: ThreeLocusInquiryFamilyReceipt,
) -> ReactiveLocusAmbiguityReceipt with Panic {
    assert(ambiguity_id > 0)
    validate_family(family)
    validate_contest_transition(transition)
    assert(transition.family_id == family.family_id)
    assert(transition.protocol_id == family.protocol_id)
    assert(transition.evidence_kind == 0)
    assert(transition.source_survivor_mask == 7)
    assert(transition.result_survivor_mask == 6)
    assert(transition.result_survivor_count == 2)
    assert(transition.eliminated_mask == 1)
    assert(transition.exact_prediction_replay)
    ReactiveLocusAmbiguityReceipt {
        ambiguity_id: ambiguity_id,
        family_id: family.family_id,
        survivor_mask: 6,
        survivor_count: 2,
        passive_hypothesis_eliminated: true,
        relational_hypothesis_survives: true,
        instrument_hypothesis_survives: true,
        order_effect_established_within_family: true,
        reactivity_locus_identified: false,
        causal_mechanism_established: false,
        clinical_authority: false,
    }
}

pub fn declare_synthetic_layer_audit_probe(
    probe_id: i64,
    protocol_id: i64,
    layer_index: i64,
) -> SyntheticLayerAuditProbeReceipt with Panic {
    assert(probe_id > 0 && protocol_id > 0)
    assert(layer_index == 0 || layer_index == 1)
    let probe = SyntheticLayerAuditProbeReceipt {
        probe_id: probe_id,
        protocol_id: protocol_id,
        layer_index: layer_index,
        declared_burden_units: 3,
        synthetic_layer_access: true,
        physical_measurement_claimed: false,
        clinical_authority: false,
    }
    validate_layer_audit_probe(probe)
    probe
}

pub fn admit_layer_audit_observation(
    observation_id: i64,
    state: ReflexiveInquiryContestStateReceipt,
    family: ThreeLocusInquiryFamilyReceipt,
    probe: SyntheticLayerAuditProbeReceipt,
    provenance: InquiryEvidenceProvenanceReceipt,
    observed_value: i64,
) -> AdmissibleLayerAuditObservationReceipt with Panic {
    assert(observation_id > 0)
    validate_contest_state(state)
    validate_family(family)
    validate_layer_audit_probe(probe)
    validate_evidence_provenance(provenance)
    assert(state.family_id == family.family_id)
    assert(probe.protocol_id == family.protocol_id)
    assert(probe.synthetic_layer_access)
    assert(!probe.physical_measurement_claimed)
    assert(!probe.clinical_authority)
    assert(provenance.chain_complete)
    assert(provenance.protocol_id == family.protocol_id)
    assert(provenance.previous_provenance_id == state.last_provenance_id)
    assert(provenance.tick == state.evidence_count + 1)
    assert(observed_value >= 0 && observed_value <= 100)
    let observation = AdmissibleLayerAuditObservationReceipt {
        observation_id: observation_id,
        family_id: family.family_id,
        protocol_id: family.protocol_id,
        probe_id: probe.probe_id,
        layer_index: probe.layer_index,
        observed_value: observed_value,
        schedule_code: 0,
        provenance_id: provenance.provenance_id,
        previous_provenance_id: provenance.previous_provenance_id,
        source_id: provenance.source_id,
        tick: provenance.tick,
        declared_burden_units: probe.declared_burden_units,
        provenance_complete: true,
        physical_measurement_claimed: false,
    }
    validate_layer_audit_observation(observation)
    observation
}

pub fn update_reflexive_contest_with_layer_audit(
    transition_id: i64,
    result_state_id: i64,
    source: ReflexiveInquiryContestStateReceipt,
    family: ThreeLocusInquiryFamilyReceipt,
    observation: AdmissibleLayerAuditObservationReceipt,
) -> ReflexiveInquiryContestTransitionReceipt with Panic {
    assert(transition_id > 0 && result_state_id > 0)
    validate_contest_state(source)
    validate_family(family)
    validate_layer_audit_observation(observation)
    assert(source.evidence_count < 2)
    assert(source.survivor_count > 0)
    assert(source.family_id == family.family_id)
    assert(observation.family_id == family.family_id)
    assert(observation.protocol_id == family.protocol_id)
    assert(observation.schedule_code == 0)
    assert(observation.provenance_complete)
    assert(!observation.physical_measurement_claimed)
    assert(observation.previous_provenance_id == source.last_provenance_id)
    assert(observation.tick == source.evidence_count + 1)
    let passive_alive = source.survivor_mask % 2 == 1 &&
        predicted_layer_after_p_then_q(0, observation.layer_index) ==
            observation.observed_value
    let relational_alive = (source.survivor_mask / 2) % 2 == 1 &&
        predicted_layer_after_p_then_q(1, observation.layer_index) ==
            observation.observed_value
    let instrument_alive = (source.survivor_mask / 4) % 2 == 1 &&
        predicted_layer_after_p_then_q(2, observation.layer_index) ==
            observation.observed_value
    let mask = as_i64(passive_alive) + 2 * as_i64(relational_alive) +
        4 * as_i64(instrument_alive)
    let count = count_three_mask(mask)
    let result = ReflexiveInquiryContestStateReceipt {
        state_id: result_state_id,
        family_id: source.family_id,
        protocol_id: source.protocol_id,
        survivor_mask: mask,
        survivor_count: count,
        evidence_count: source.evidence_count + 1,
        burden_spent: source.burden_spent + observation.declared_burden_units,
        last_provenance_id: observation.provenance_id,
        provenance_fingerprint: source.provenance_fingerprint * 31 +
            observation.provenance_id,
        family_refuted: count == 0,
    }
    validate_contest_state(result)
    ReflexiveInquiryContestTransitionReceipt {
        transition_id: transition_id,
        evidence_kind: 1,
        family_id: source.family_id,
        protocol_id: source.protocol_id,
        source_state_id: source.state_id,
        source_survivor_mask: source.survivor_mask,
        source_survivor_count: source.survivor_count,
        source_evidence_count: source.evidence_count,
        source_burden_spent: source.burden_spent,
        source_last_provenance_id: source.last_provenance_id,
        source_provenance_fingerprint: source.provenance_fingerprint,
        result_survivor_mask: mask,
        result_survivor_count: count,
        eliminated_mask: source.survivor_mask - mask,
        eliminated_count: source.survivor_count - count,
        provenance_id: observation.provenance_id,
        previous_provenance_id: observation.previous_provenance_id,
        declared_burden_units: observation.declared_burden_units,
        p_then_q_first_observation: -1,
        p_then_q_second_observation: -1,
        q_then_p_first_observation: -1,
        q_then_p_second_observation: -1,
        audit_layer_index: observation.layer_index,
        audit_observed_value: observation.observed_value,
        result_state: result,
        exact_prediction_replay: true,
    }
}

pub fn reflexive_contest_transition_result(
    transition: ReflexiveInquiryContestTransitionReceipt,
) -> ReflexiveInquiryContestStateReceipt with Panic {
    validate_contest_transition(transition)
    transition.result_state
}

pub fn reflexive_contest_survivor_mask(
    state: ReflexiveInquiryContestStateReceipt,
) -> i64 with Panic {
    validate_contest_state(state)
    state.survivor_mask
}

pub fn reflexive_contest_survivor_count(
    state: ReflexiveInquiryContestStateReceipt,
) -> i64 with Panic {
    validate_contest_state(state)
    state.survivor_count
}

pub fn reflexive_contest_burden_spent(
    state: ReflexiveInquiryContestStateReceipt,
) -> i64 with Panic {
    validate_contest_state(state)
    state.burden_spent
}

pub fn reflexive_contest_provenance_fingerprint(
    state: ReflexiveInquiryContestStateReceipt,
) -> i64 with Panic {
    validate_contest_state(state)
    state.provenance_fingerprint
}

pub fn certify_declared_locus_identification(
    identification_id: i64,
    transition: ReflexiveInquiryContestTransitionReceipt,
    family: ThreeLocusInquiryFamilyReceipt,
) -> DeclaredLocusIdentificationReceipt with Panic {
    assert(identification_id > 0)
    validate_family(family)
    validate_contest_transition(transition)
    assert(transition.family_id == family.family_id)
    assert(transition.protocol_id == family.protocol_id)
    assert(transition.evidence_kind == 1)
    assert(transition.result_survivor_count == 1)
    assert(transition.result_survivor_mask == 2 ||
        transition.result_survivor_mask == 4)
    assert(transition.exact_prediction_replay)
    let selected_mode = if transition.result_survivor_mask == 2 { 1 } else { 2 }
    DeclaredLocusIdentificationReceipt {
        identification_id: identification_id,
        family_id: family.family_id,
        selected_hypothesis_id: family_hypothesis_id(family, selected_mode),
        selected_mode: selected_mode,
        survivor_mask: transition.result_survivor_mask,
        evidence_count: transition.result_state.evidence_count,
        burden_spent: transition.result_state.burden_spent,
        provenance_fingerprint: transition.result_state.provenance_fingerprint,
        locus_identified_within_declared_family: true,
        global_truth_established: false,
        biological_mechanism_established: false,
        clinical_authority: false,
    }
}

pub fn certify_inquiry_relabel_invariance(
    control_id: i64,
    family: ThreeLocusInquiryFamilyReceipt,
    relabeled: ThreeLocusInquiryFamilyReceipt,
) -> InquiryRelabelControlReceipt with Panic {
    assert(control_id > 0)
    validate_family(family)
    validate_family(relabeled)
    assert(family.protocol_id == relabeled.protocol_id)
    assert(family.passive_hypothesis_id != relabeled.passive_hypothesis_id)
    assert(family.relational_hypothesis_id != relabeled.relational_hypothesis_id)
    assert(family.instrument_hypothesis_id != relabeled.instrument_hypothesis_id)
    InquiryRelabelControlReceipt {
        control_id: control_id,
        hypothesis_ids_distinct: true,
        all_trace_and_audit_predictions_equal: true,
        partitions_invariant: true,
    }
}
