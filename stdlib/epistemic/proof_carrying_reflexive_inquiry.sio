// Deliberately unrelated authority and claim types used by negative gates.
pub struct NonAssociativeInquiryReceipt { pub receipt_id: i64 }
pub struct BiologicalReactivityMechanismReceipt { pub mechanism_id: i64 }
pub struct ClinicalInquiryActionReceipt { pub action_id: i64 }
pub struct RealPersonCounterfactualReceipt { pub counterfactual_id: i64 }
pub struct PhysicalInquiryObservationReceipt { pub observation_id: i64 }
pub struct SubjectiveInquirySufferingReceipt { pub suffering_id: i64 }

fn as_i64(value: bool) -> i64 { if value { 1 } else { 0 } }

fn validate_hypothesis(hypothesis: LayeredInquiryHypothesisReceipt) with Panic {
    assert(hypothesis.hypothesis_id > 0)
    assert(hypothesis.hypothesis_id <= 1000000)
    assert(hypothesis.declared_family_id > 0)
    assert(hypothesis.mode >= 0 && hypothesis.mode <= 2)
    assert(hypothesis.passive_mode == (hypothesis.mode == 0))
    assert(hypothesis.relational_reactivity_mode == (hypothesis.mode == 1))
    assert(hypothesis.instrument_adaptation_mode == (hypothesis.mode == 2))
    assert(!hypothesis.empirically_established)
    assert(!hypothesis.clinical_authority)
}

fn validate_family(family: ThreeLocusInquiryFamilyReceipt) with Panic {
    assert(family.family_id > 0 && family.protocol_id > 0)
    assert(family.passive_hypothesis_id > 0)
    assert(family.relational_hypothesis_id > 0)
    assert(family.instrument_hypothesis_id > 0)
    assert(family.passive_hypothesis_id <= 1000000)
    assert(family.relational_hypothesis_id <= 1000000)
    assert(family.instrument_hypothesis_id <= 1000000)
    assert(family.passive_hypothesis_id != family.relational_hypothesis_id)
    assert(family.passive_hypothesis_id != family.instrument_hypothesis_id)
    assert(family.relational_hypothesis_id != family.instrument_hypothesis_id)
    assert(family.hypothesis_count == 3)
    assert(!family.family_exhaustive_in_reality)
    assert(family.synthetic_scope_only)
}

fn validate_action(action: SyntheticInquiryActionReceipt) with Panic {
    assert(action.action_id > 0 && action.protocol_id > 0)
    assert(action.action_index >= 0 && action.action_index <= 2)
    assert(action.operation_code == action.action_index)
    let expected_burden = if action.action_index == 2 { 3 } else { 2 }
    assert(action.declared_burden_units == expected_burden)
    assert(action.may_write_relational_layer)
    assert(action.may_write_instrument_layer)
    assert(action.writes_epistemic_trace)
    assert(!action.physical_intervention_claimed)
    assert(!action.clinical_authority)
}

fn validate_footprint(footprint: InquiryEffectFootprintReceipt) with Panic {
    assert(footprint.footprint_id > 0)
    assert(footprint.hypothesis_id > 0)
    assert(footprint.hypothesis_id <= 1000000)
    assert(footprint.mode >= 0 && footprint.mode <= 2)
    assert(footprint.action_id > 0)
    assert(footprint.action_index >= 0 && footprint.action_index <= 2)
    assert(footprint.reads_relational_layer)
    assert(footprint.writes_relational_layer == (footprint.mode == 1))
    assert(footprint.reads_instrument_layer)
    assert(footprint.writes_instrument_layer == (footprint.mode == 2))
    assert(footprint.writes_epistemic_trace)
    assert(footprint.exact_for_declared_fixture)
}

fn validate_matched_pair(pair: MatchedSyntheticProtocolPairReceipt) with Panic {
    assert(pair.pair_id > 0 && pair.protocol_id > 0)
    assert(pair.initial_relational_state == 1)
    assert(pair.initial_instrument_state == 0)
    assert(pair.initial_projection == 1)
    assert(pair.schedules_start_from_equal_full_state)
    assert(pair.synthetic_reset_declared)
    assert(!pair.same_real_person_counterfactual_claimed)
    assert(!pair.physical_reset_established)
}

fn validate_interference(
    interference: PotentialInquiryInterferenceReceipt,
) with Panic {
    assert(interference.interference_id > 0)
    assert(interference.hypothesis_id > 0)
    assert(interference.hypothesis_id <= 1000000)
    assert(interference.mode >= 0 && interference.mode <= 2)
    assert(interference.left_action_id > 0)
    assert(interference.right_action_id > 0)
    assert(interference.left_action_id != interference.right_action_id)
    assert(interference.left_action_index >= 0)
    assert(interference.left_action_index <= 2)
    assert(interference.right_action_index >= 0)
    assert(interference.right_action_index <= 2)
    assert(interference.left_action_index != interference.right_action_index)
    assert(interference.writes_same_relational_layer ==
        (interference.mode == 1))
    assert(interference.writes_same_instrument_layer ==
        (interference.mode == 2))
    assert(interference.footprint_overlap ==
        (interference.mode == 1 || interference.mode == 2))
    assert(!interference.exact_noncommutation_established)
}

fn validate_passive_commutation_receipt(
    receipt: PassiveInquiryCommutationReceipt,
) with Panic {
    assert(receipt.receipt_id > 0)
    assert(receipt.hypothesis_id > 0)
    assert(receipt.hypothesis_id <= 1000000)
    assert(receipt.mode == 0)
    assert(prediction_matches_order_values(
        0,
        receipt.p_then_q_first_observation,
        receipt.p_then_q_second_observation,
        receipt.q_then_p_first_observation,
        receipt.q_then_p_second_observation,
    ))
    let pq_r1 = next_relational_state(0, 0, 1)
    let pq_i1 = next_instrument_state(0, 0, 0)
    let pq_r2 = next_relational_state(0, 1, pq_r1)
    let pq_i2 = next_instrument_state(0, 1, pq_i1)
    let qp_r1 = next_relational_state(0, 1, 1)
    let qp_i1 = next_instrument_state(0, 1, 0)
    let qp_r2 = next_relational_state(0, 0, qp_r1)
    let qp_i2 = next_instrument_state(0, 0, qp_i1)
    assert(receipt.p_then_q_final_relational_state == pq_r2)
    assert(receipt.p_then_q_final_instrument_state == pq_i2)
    assert(receipt.q_then_p_final_relational_state == qp_r2)
    assert(receipt.q_then_p_final_instrument_state == qp_i2)
    assert(receipt.p_then_q_final_projection == pq_r2 + pq_i2)
    assert(receipt.q_then_p_final_projection == qp_r2 + qp_i2)
    assert(receipt.final_process_and_instrument_layers_equal ==
        (pq_r2 == qp_r2 && pq_i2 == qp_i2))
    assert(receipt.emitted_observation_traces_equal ==
        (receipt.p_then_q_first_observation ==
            receipt.q_then_p_first_observation &&
         receipt.p_then_q_second_observation ==
            receipt.q_then_p_second_observation))
    assert(receipt.final_process_and_instrument_layers_equal)
    assert(receipt.emitted_observation_traces_equal)
    assert(receipt.exact_commutation_on_witness)
    assert(receipt.passive_within_declared_fixture)
    assert(!receipt.universal_observation_commutation_claimed)
}

fn validate_state(state: LayeredInquiryStateReceipt) with Panic {
    assert(state.state_id > 0)
    assert(state.family_id > 0 && state.protocol_id > 0)
    assert(state.hypothesis_id > 0)
    assert(state.mode >= 0 && state.mode <= 2)
    assert(state.tick >= 0 && state.tick <= 8)
    assert(state.relational_state >= 0 && state.relational_state <= 2001)
    assert(state.instrument_state >= 0 && state.instrument_state <= 2001)
    assert(state.observable_projection == state.relational_state + state.instrument_state)
    assert(state.action_count >= 0 && state.action_count <= 3)
    assert(state.tick == state.action_count)
    assert(state.action_mask >= 0 && state.action_mask <= 7)
    assert(state.action_count == count_three_mask(state.action_mask))
    if state.action_count == 0 {
        assert(state.last_action_index == -1)
    } else {
        assert(state.last_action_index >= 0 && state.last_action_index <= 2)
        let last_bit = if state.last_action_index == 0 {
            1
        } else if state.last_action_index == 1 {
            2
        } else {
            4
        }
        assert((state.action_mask / last_bit) % 2 == 1)
    }
    assert(state.trace_fingerprint >= 0)
    if state.action_count == 0 {
        assert(state.last_trace_provenance_id == 0)
        assert(state.trace_fingerprint == 0)
    } else if state.action_count == 1 {
        assert(state.last_trace_provenance_id > 0)
        assert(state.last_trace_provenance_id <= 1000000)
        assert(state.trace_fingerprint == state.last_trace_provenance_id)
    } else if state.action_count == 2 {
        assert(state.last_trace_provenance_id > 0)
        assert(state.last_trace_provenance_id <= 1000000)
        assert(state.trace_fingerprint <= 32000000)
    } else {
        assert(state.last_trace_provenance_id > 0)
        assert(state.last_trace_provenance_id <= 1000000)
        assert(state.trace_fingerprint <= 993000000)
    }
    assert(state.synthetic_scope_only)
    assert(!state.clinical_authority)
}

fn next_relational_state(mode: i64, action_index: i64, relational: i64) -> i64 with Panic {
    assert(mode >= 0 && mode <= 2)
    assert(action_index >= 0 && action_index <= 2)
    assert(relational >= 0 && relational <= 1000)
    if mode != 1 {
        relational
    } else if action_index == 0 {
        relational * 2
    } else if action_index == 1 {
        relational + 1
    } else {
        relational + 2
    }
}

fn next_instrument_state(mode: i64, action_index: i64, instrument: i64) -> i64 with Panic {
    assert(mode >= 0 && mode <= 2)
    assert(action_index >= 0 && action_index <= 2)
    assert(instrument >= 0 && instrument <= 1000)
    if mode != 2 {
        instrument
    } else if action_index == 0 {
        instrument * 2 + 1
    } else if action_index == 1 {
        instrument + 1
    } else {
        instrument + 2
    }
}

fn action_bit(action_index: i64) -> i64 with Panic {
    assert(action_index >= 0 && action_index <= 2)
    if action_index == 0 { 1 } else if action_index == 1 { 2 } else { 4 }
}

fn validate_transition(transition: LayeredInquiryTransitionReceipt) with Panic {
    assert(transition.transition_id > 0)
    assert(transition.family_id == transition.result_state.family_id)
    assert(transition.protocol_id == transition.result_state.protocol_id)
    assert(transition.hypothesis_id == transition.result_state.hypothesis_id)
    assert(transition.mode == transition.result_state.mode)
    assert(transition.action_id > 0)
    assert(transition.action_index >= 0 && transition.action_index <= 2)
    let current_action_bit = action_bit(transition.action_index)
    assert((transition.source_action_mask / current_action_bit) % 2 == 0)
    assert(transition.source_state_id > 0)
    assert(transition.result_state.state_id != transition.source_state_id)
    assert(transition.source_relational_state >= 0)
    assert(transition.source_relational_state <= 1000)
    assert(transition.source_instrument_state >= 0)
    assert(transition.source_instrument_state <= 1000)
    assert(transition.source_projection ==
        transition.source_relational_state + transition.source_instrument_state)
    assert(transition.source_action_count >= 0)
    assert(transition.source_action_count <= 2)
    assert(transition.source_action_mask >= 0)
    assert(transition.source_action_mask <= 7)
    assert(transition.source_action_count ==
        count_three_mask(transition.source_action_mask))
    assert(transition.source_tick == transition.source_action_count)
    assert(transition.source_trace_fingerprint >= 0)
    if transition.source_action_count == 0 {
        assert(transition.source_trace_provenance_id == 0)
        assert(transition.source_trace_fingerprint == 0)
    } else if transition.source_action_count == 1 {
        assert(transition.source_trace_provenance_id > 0)
        assert(transition.source_trace_provenance_id <= 1000000)
        assert(transition.source_trace_fingerprint ==
            transition.source_trace_provenance_id)
    } else {
        assert(transition.source_trace_provenance_id > 0)
        assert(transition.source_trace_provenance_id <= 1000000)
        assert(transition.source_trace_fingerprint <= 32000000)
    }
    assert(transition.source_tick + 1 == transition.result_state.tick)
    assert(transition.result_relational_state == transition.result_state.relational_state)
    assert(transition.result_instrument_state == transition.result_state.instrument_state)
    assert(transition.observed_projection == transition.result_state.observable_projection)
    assert(transition.result_relational_state == next_relational_state(
        transition.mode, transition.action_index, transition.source_relational_state,
    ))
    assert(transition.result_instrument_state == next_instrument_state(
        transition.mode, transition.action_index, transition.source_instrument_state,
    ))
    assert(transition.trace_provenance_id > 0)
    assert(transition.trace_provenance_id <= 1000000)
    assert(transition.result_state.last_trace_provenance_id == transition.trace_provenance_id)
    assert(transition.result_state.action_count ==
        transition.source_action_count + 1)
    assert(transition.result_state.last_action_index == transition.action_index)
    assert(transition.result_state.action_mask ==
        transition.source_action_mask + action_bit(transition.action_index))
    assert(transition.result_state.trace_fingerprint ==
        transition.source_trace_fingerprint * 31 +
            transition.trace_provenance_id)
    assert(transition.exact_transition_replayed)
    assert(!transition.clinical_authority)
    validate_state(transition.result_state)
}

fn validate_schedule_link(
    first: LayeredInquiryTransitionReceipt,
    second: LayeredInquiryTransitionReceipt,
) with Panic {
    validate_transition(first)
    validate_transition(second)
    assert(second.source_state_id == first.result_state.state_id)
    assert(second.source_tick == first.result_state.tick)
    assert(second.source_relational_state == first.result_relational_state)
    assert(second.source_instrument_state == first.result_instrument_state)
    assert(second.source_projection == first.observed_projection)
    assert(second.source_action_count == first.result_state.action_count)
    assert(second.source_action_mask == first.result_state.action_mask)
    assert(second.source_trace_provenance_id == first.trace_provenance_id)
    assert(second.source_trace_fingerprint == first.result_state.trace_fingerprint)
    assert(first.family_id == second.family_id)
    assert(first.protocol_id == second.protocol_id)
    assert(first.hypothesis_id == second.hypothesis_id)
    assert(first.mode == second.mode)
}

fn validate_matched_schedule_roots(
    left: LayeredInquiryTransitionReceipt,
    right: LayeredInquiryTransitionReceipt,
) with Panic {
    validate_transition(left)
    validate_transition(right)
    assert(left.family_id == right.family_id)
    assert(left.protocol_id == right.protocol_id)
    assert(left.hypothesis_id == right.hypothesis_id)
    assert(left.mode == right.mode)
    assert(left.source_tick == 0 && right.source_tick == 0)
    assert(left.source_action_count == 0 && right.source_action_count == 0)
    assert(left.source_action_mask == 0 && right.source_action_mask == 0)
    assert(left.source_trace_provenance_id == 0)
    assert(right.source_trace_provenance_id == 0)
    assert(left.source_trace_fingerprint == 0)
    assert(right.source_trace_fingerprint == 0)
    assert(left.source_relational_state == right.source_relational_state)
    assert(left.source_instrument_state == right.source_instrument_state)
    assert(left.source_projection == right.source_projection)
}

fn validate_interference_schedule_binding(
    interference: PotentialInquiryInterferenceReceipt,
    forward_first: LayeredInquiryTransitionReceipt,
    forward_second: LayeredInquiryTransitionReceipt,
    reverse_first: LayeredInquiryTransitionReceipt,
    reverse_second: LayeredInquiryTransitionReceipt,
) with Panic {
    validate_interference(interference)
    validate_schedule_link(forward_first, forward_second)
    validate_schedule_link(reverse_first, reverse_second)
    validate_matched_schedule_roots(forward_first, reverse_first)
    assert(interference.hypothesis_id == forward_first.hypothesis_id)
    assert(interference.mode == forward_first.mode)
    assert(interference.left_action_id == forward_first.action_id)
    assert(interference.left_action_index == forward_first.action_index)
    assert(interference.right_action_id == forward_second.action_id)
    assert(interference.right_action_index == forward_second.action_index)
    assert(interference.right_action_id == reverse_first.action_id)
    assert(interference.right_action_index == reverse_first.action_index)
    assert(interference.left_action_id == reverse_second.action_id)
    assert(interference.left_action_index == reverse_second.action_index)
}

fn validate_noncommutation_receipt(
    receipt: ExactInquiryNonCommutationWitnessReceipt,
) with Panic {
    assert(receipt.receipt_id > 0)
    assert(receipt.hypothesis_id > 0 && receipt.hypothesis_id <= 1000000)
    assert(receipt.mode == 1 || receipt.mode == 2)
    assert(prediction_matches_order_values(
        receipt.mode,
        receipt.p_then_q_first_observation,
        receipt.p_then_q_second_observation,
        receipt.q_then_p_first_observation,
        receipt.q_then_p_second_observation,
    ))
    let pq_r1 = next_relational_state(receipt.mode, 0, 1)
    let pq_i1 = next_instrument_state(receipt.mode, 0, 0)
    let pq_r2 = next_relational_state(receipt.mode, 1, pq_r1)
    let pq_i2 = next_instrument_state(receipt.mode, 1, pq_i1)
    let qp_r1 = next_relational_state(receipt.mode, 1, 1)
    let qp_i1 = next_instrument_state(receipt.mode, 1, 0)
    let qp_r2 = next_relational_state(receipt.mode, 0, qp_r1)
    let qp_i2 = next_instrument_state(receipt.mode, 0, qp_i1)
    assert(receipt.p_then_q_final_relational_state == pq_r2)
    assert(receipt.p_then_q_final_instrument_state == pq_i2)
    assert(receipt.q_then_p_final_relational_state == qp_r2)
    assert(receipt.q_then_p_final_instrument_state == qp_i2)
    assert(receipt.projected_commutator ==
        receipt.p_then_q_second_observation -
            receipt.q_then_p_second_observation)
    assert(receipt.projected_commutator != 0)
    assert(receipt.same_action_multiset)
    assert(receipt.footprint_conflict_replayed)
    assert(receipt.exact_noncommutation_on_witness)
    assert(!receipt.nonassociativity_established)
    assert(!receipt.biological_reactivity_established)
    assert(!receipt.clinical_authority)
}

fn family_hypothesis_id(
    family: ThreeLocusInquiryFamilyReceipt,
    mode: i64,
) -> i64 with Panic {
    validate_family(family)
    assert(mode >= 0 && mode <= 2)
    if mode == 0 {
        family.passive_hypothesis_id
    } else if mode == 1 {
        family.relational_hypothesis_id
    } else {
        family.instrument_hypothesis_id
    }
}

fn prediction_matches_order_trace(
    mode: i64,
    observation: AdmissibleOrderTraceObservationReceipt,
) -> bool with Panic {
    prediction_matches_order_values(
        mode,
        observation.p_then_q_first_observation,
        observation.p_then_q_second_observation,
        observation.q_then_p_first_observation,
        observation.q_then_p_second_observation,
    )
}

fn prediction_matches_order_values(
    mode: i64,
    p_then_q_first: i64,
    p_then_q_second: i64,
    q_then_p_first: i64,
    q_then_p_second: i64,
) -> bool with Panic {
    assert(mode >= 0 && mode <= 2)
    let pq_r1 = next_relational_state(mode, 0, 1)
    let pq_i1 = next_instrument_state(mode, 0, 0)
    let pq_r2 = next_relational_state(mode, 1, pq_r1)
    let pq_i2 = next_instrument_state(mode, 1, pq_i1)
    let qp_r1 = next_relational_state(mode, 1, 1)
    let qp_i1 = next_instrument_state(mode, 1, 0)
    let qp_r2 = next_relational_state(mode, 0, qp_r1)
    let qp_i2 = next_instrument_state(mode, 0, qp_i1)
    let pq_first = pq_r1 + pq_i1
    let pq_second = pq_r2 + pq_i2
    let qp_first = qp_r1 + qp_i1
    let qp_second = qp_r2 + qp_i2
    p_then_q_first == pq_first && p_then_q_second == pq_second &&
        q_then_p_first == qp_first && q_then_p_second == qp_second
}

fn predicted_layer_after_p_then_q(mode: i64, layer_index: i64) -> i64 with Panic {
    assert(mode >= 0 && mode <= 2)
    assert(layer_index == 0 || layer_index == 1)
    let after_p_relational = next_relational_state(mode, 0, 1)
    let after_p_instrument = next_instrument_state(mode, 0, 0)
    let after_q_relational = next_relational_state(mode, 1, after_p_relational)
    let after_q_instrument = next_instrument_state(mode, 1, after_p_instrument)
    if layer_index == 0 { after_q_relational } else { after_q_instrument }
}

fn count_three_mask(mask: i64) -> i64 with Panic {
    assert(mask >= 0 && mask <= 7)
    as_i64(mask % 2 == 1) + as_i64((mask / 2) % 2 == 1) +
        as_i64((mask / 4) % 2 == 1)
}

fn validate_evidence_provenance(
    provenance: InquiryEvidenceProvenanceReceipt,
) with Panic {
    assert(provenance.provenance_id > 0)
    assert(provenance.provenance_id <= 1000000)
    assert(provenance.source_id > 0)
    assert(provenance.source_id <= 1000000)
    assert(provenance.protocol_id > 0)
    assert(provenance.tick > 0 && provenance.tick <= 8)
    assert(provenance.previous_provenance_id >= 0)
    assert(provenance.previous_provenance_id <= 1000000)
    assert(provenance.previous_provenance_id != provenance.provenance_id)
    assert(provenance.chain_complete)
}

fn validate_order_trace_observation(
    observation: AdmissibleOrderTraceObservationReceipt,
) with Panic {
    assert(observation.observation_id > 0)
    assert(observation.family_id > 0 && observation.protocol_id > 0)
    assert(observation.matched_pair_id > 0)
    assert(observation.p_then_q_first_observation >= 0)
    assert(observation.p_then_q_first_observation <= 100)
    assert(observation.p_then_q_second_observation >= 0)
    assert(observation.p_then_q_second_observation <= 100)
    assert(observation.q_then_p_first_observation >= 0)
    assert(observation.q_then_p_first_observation <= 100)
    assert(observation.q_then_p_second_observation >= 0)
    assert(observation.q_then_p_second_observation <= 100)
    assert(observation.provenance_id > 0)
    assert(observation.provenance_id <= 1000000)
    assert(observation.previous_provenance_id >= 0)
    assert(observation.previous_provenance_id <= 1000000)
    assert(observation.previous_provenance_id != observation.provenance_id)
    assert(observation.source_id > 0 && observation.source_id <= 1000000)
    assert(observation.tick > 0 && observation.tick <= 8)
    assert(observation.declared_burden_units == 4)
    assert(observation.value_present)
    assert(observation.matched_schedule_provenance_complete)
    assert(!observation.physical_observation_claimed)
}

fn validate_missing_order_trace(
    missing: MissingOrderTraceObservationReceipt,
) with Panic {
    assert(missing.observation_id > 0)
    assert(missing.family_id > 0 && missing.protocol_id > 0)
    assert(missing.tick > 0 && missing.tick <= 8)
    assert(!missing.value_present)
    assert(missing.hypotheses_eliminated == 0)
}

fn validate_unaudited_order_trace(
    unaudited: UnauditedOrderTraceObservationReceipt,
) with Panic {
    assert(unaudited.observation_id > 0)
    assert(unaudited.family_id > 0 && unaudited.protocol_id > 0)
    assert(unaudited.tick > 0 && unaudited.tick <= 8)
    assert(unaudited.value_present)
    assert(!unaudited.provenance_complete)
    assert(unaudited.hypotheses_eliminated == 0)
}

fn validate_layer_audit_probe(
    probe: SyntheticLayerAuditProbeReceipt,
) with Panic {
    assert(probe.probe_id > 0 && probe.protocol_id > 0)
    assert(probe.layer_index == 0 || probe.layer_index == 1)
    assert(probe.declared_burden_units == 3)
    assert(probe.synthetic_layer_access)
    assert(!probe.physical_measurement_claimed)
    assert(!probe.clinical_authority)
}

fn validate_layer_audit_observation(
    observation: AdmissibleLayerAuditObservationReceipt,
) with Panic {
    assert(observation.observation_id > 0)
    assert(observation.family_id > 0 && observation.protocol_id > 0)
    assert(observation.probe_id > 0)
    assert(observation.layer_index == 0 || observation.layer_index == 1)
    assert(observation.observed_value >= 0 && observation.observed_value <= 100)
    assert(observation.schedule_code == 0)
    assert(observation.provenance_id > 0)
    assert(observation.provenance_id <= 1000000)
    assert(observation.previous_provenance_id >= 0)
    assert(observation.previous_provenance_id <= 1000000)
    assert(observation.previous_provenance_id != observation.provenance_id)
    assert(observation.source_id > 0 && observation.source_id <= 1000000)
    assert(observation.tick > 0 && observation.tick <= 8)
    assert(observation.declared_burden_units == 3)
    assert(observation.provenance_complete)
    assert(!observation.physical_measurement_claimed)
}

fn validate_contest_state(state: ReflexiveInquiryContestStateReceipt) with Panic {
    assert(state.state_id > 0)
    assert(state.family_id > 0 && state.protocol_id > 0)
    assert(state.survivor_mask >= 0 && state.survivor_mask <= 7)
    assert(state.survivor_count == count_three_mask(state.survivor_mask))
    assert(state.evidence_count >= 0 && state.evidence_count <= 2)
    assert(state.burden_spent >= 0 && state.burden_spent <= 7)
    assert(state.provenance_fingerprint >= 0)
    assert(state.provenance_fingerprint <= 32000000)
    if state.evidence_count == 0 {
        assert(state.survivor_mask == 7)
        assert(state.survivor_count == 3)
        assert(state.burden_spent == 0)
        assert(state.last_provenance_id == 0)
        assert(state.provenance_fingerprint == 0)
    } else if state.evidence_count == 1 {
        assert(state.burden_spent == 3 || state.burden_spent == 4)
        assert(state.last_provenance_id > 0)
        assert(state.last_provenance_id <= 1000000)
        assert(state.provenance_fingerprint == state.last_provenance_id)
    } else {
        assert(state.burden_spent == 7)
        assert(state.last_provenance_id > 0)
        assert(state.last_provenance_id <= 1000000)
    }
    assert(state.family_refuted == (state.survivor_count == 0))
}

fn validate_contest_transition(
    transition: ReflexiveInquiryContestTransitionReceipt,
) with Panic {
    assert(transition.transition_id > 0)
    assert(transition.evidence_kind == 0 || transition.evidence_kind == 1)
    assert(transition.family_id > 0 && transition.protocol_id > 0)
    assert(transition.source_state_id > 0)
    assert(transition.source_survivor_mask >= 0)
    assert(transition.source_survivor_mask <= 7)
    assert(transition.result_survivor_mask >= 0)
    assert(transition.result_survivor_mask <= 7)
    assert(transition.source_survivor_count ==
        count_three_mask(transition.source_survivor_mask))
    assert(transition.result_survivor_count ==
        count_three_mask(transition.result_survivor_mask))
    assert(transition.source_evidence_count >= 0)
    assert(transition.source_evidence_count <= 1)
    assert(transition.source_burden_spent >= 0)
    assert(transition.source_burden_spent <= 4)
    assert(transition.source_last_provenance_id >= 0)
    assert(transition.source_last_provenance_id <= 1000000)
    assert(transition.source_provenance_fingerprint >= 0)
    assert(transition.source_provenance_fingerprint <= 1000000)
    if transition.source_evidence_count == 0 {
        assert(transition.source_survivor_mask == 7)
        assert(transition.source_survivor_count == 3)
        assert(transition.source_burden_spent == 0)
        assert(transition.source_last_provenance_id == 0)
        assert(transition.source_provenance_fingerprint == 0)
    } else {
        assert(transition.source_burden_spent == 3 ||
            transition.source_burden_spent == 4)
        assert(transition.source_last_provenance_id > 0)
        assert(transition.source_provenance_fingerprint ==
            transition.source_last_provenance_id)
    }
    assert(transition.result_survivor_mask % 2 <=
        transition.source_survivor_mask % 2)
    assert((transition.result_survivor_mask / 2) % 2 <=
        (transition.source_survivor_mask / 2) % 2)
    assert((transition.result_survivor_mask / 4) % 2 <=
        (transition.source_survivor_mask / 4) % 2)
    assert(transition.eliminated_mask ==
        transition.source_survivor_mask - transition.result_survivor_mask)
    assert(transition.eliminated_count ==
        transition.source_survivor_count - transition.result_survivor_count)
    assert(transition.provenance_id > 0 && transition.provenance_id <= 1000000)
    assert(transition.previous_provenance_id >= 0)
    assert(transition.previous_provenance_id <= 1000000)
    assert(transition.previous_provenance_id ==
        transition.source_last_provenance_id)
    assert(transition.result_state.state_id != transition.source_state_id)
    assert(transition.result_state.family_id == transition.family_id)
    assert(transition.result_state.protocol_id == transition.protocol_id)
    assert(transition.result_state.survivor_mask ==
        transition.result_survivor_mask)
    assert(transition.result_state.survivor_count ==
        transition.result_survivor_count)
    assert(transition.result_state.evidence_count ==
        transition.source_evidence_count + 1)
    assert(transition.result_state.burden_spent ==
        transition.source_burden_spent + transition.declared_burden_units)
    assert(transition.result_state.last_provenance_id == transition.provenance_id)
    assert(transition.result_state.provenance_fingerprint ==
        transition.source_provenance_fingerprint * 31 +
            transition.provenance_id)
    let expected_mask = if transition.evidence_kind == 0 {
        assert(transition.declared_burden_units == 4)
        assert(transition.p_then_q_first_observation >= 0)
        assert(transition.p_then_q_first_observation <= 100)
        assert(transition.p_then_q_second_observation >= 0)
        assert(transition.p_then_q_second_observation <= 100)
        assert(transition.q_then_p_first_observation >= 0)
        assert(transition.q_then_p_first_observation <= 100)
        assert(transition.q_then_p_second_observation >= 0)
        assert(transition.q_then_p_second_observation <= 100)
        assert(transition.audit_layer_index == -1)
        assert(transition.audit_observed_value == -1)
        let passive_alive = transition.source_survivor_mask % 2 == 1 &&
            prediction_matches_order_values(
                0,
                transition.p_then_q_first_observation,
                transition.p_then_q_second_observation,
                transition.q_then_p_first_observation,
                transition.q_then_p_second_observation,
            )
        let relational_alive =
            (transition.source_survivor_mask / 2) % 2 == 1 &&
            prediction_matches_order_values(
                1,
                transition.p_then_q_first_observation,
                transition.p_then_q_second_observation,
                transition.q_then_p_first_observation,
                transition.q_then_p_second_observation,
            )
        let instrument_alive =
            (transition.source_survivor_mask / 4) % 2 == 1 &&
            prediction_matches_order_values(
                2,
                transition.p_then_q_first_observation,
                transition.p_then_q_second_observation,
                transition.q_then_p_first_observation,
                transition.q_then_p_second_observation,
            )
        as_i64(passive_alive) + 2 * as_i64(relational_alive) +
            4 * as_i64(instrument_alive)
    } else {
        assert(transition.declared_burden_units == 3)
        assert(transition.p_then_q_first_observation == -1)
        assert(transition.p_then_q_second_observation == -1)
        assert(transition.q_then_p_first_observation == -1)
        assert(transition.q_then_p_second_observation == -1)
        assert(transition.audit_layer_index == 0 ||
            transition.audit_layer_index == 1)
        assert(transition.audit_observed_value >= 0)
        assert(transition.audit_observed_value <= 100)
        let passive_alive = transition.source_survivor_mask % 2 == 1 &&
            predicted_layer_after_p_then_q(
                0,
                transition.audit_layer_index,
            ) == transition.audit_observed_value
        let relational_alive =
            (transition.source_survivor_mask / 2) % 2 == 1 &&
            predicted_layer_after_p_then_q(
                1,
                transition.audit_layer_index,
            ) == transition.audit_observed_value
        let instrument_alive =
            (transition.source_survivor_mask / 4) % 2 == 1 &&
            predicted_layer_after_p_then_q(
                2,
                transition.audit_layer_index,
            ) == transition.audit_observed_value
        as_i64(passive_alive) + 2 * as_i64(relational_alive) +
            4 * as_i64(instrument_alive)
    }
    assert(transition.result_survivor_mask == expected_mask)
    assert(transition.exact_prediction_replay)
    validate_contest_state(transition.result_state)
}

pub fn declare_layered_inquiry_hypothesis(
    hypothesis_id: i64,
    mode: i64,
    family_id: i64,
) -> LayeredInquiryHypothesisReceipt with Panic {
    assert(hypothesis_id > 0 && hypothesis_id <= 1000000)
    assert(mode >= 0 && mode <= 2)
    assert(family_id > 0)
    LayeredInquiryHypothesisReceipt {
        hypothesis_id: hypothesis_id,
        mode: mode,
        declared_family_id: family_id,
        passive_mode: mode == 0,
        relational_reactivity_mode: mode == 1,
        instrument_adaptation_mode: mode == 2,
        empirically_established: false,
        clinical_authority: false,
    }
}

pub fn declare_three_locus_inquiry_family(
    family_id: i64,
    protocol_id: i64,
    passive: LayeredInquiryHypothesisReceipt,
    relational: LayeredInquiryHypothesisReceipt,
    instrument: LayeredInquiryHypothesisReceipt,
) -> ThreeLocusInquiryFamilyReceipt with Panic {
    validate_hypothesis(passive)
    validate_hypothesis(relational)
    validate_hypothesis(instrument)
    assert(passive.mode == 0 && relational.mode == 1 && instrument.mode == 2)
    assert(passive.declared_family_id == family_id)
    assert(relational.declared_family_id == family_id)
    assert(instrument.declared_family_id == family_id)
    let family = ThreeLocusInquiryFamilyReceipt {
        family_id: family_id,
        protocol_id: protocol_id,
        passive_hypothesis_id: passive.hypothesis_id,
        relational_hypothesis_id: relational.hypothesis_id,
        instrument_hypothesis_id: instrument.hypothesis_id,
        hypothesis_count: 3,
        family_exhaustive_in_reality: false,
        synthetic_scope_only: true,
    }
    validate_family(family)
    family
}

pub fn declare_synthetic_inquiry_action(
    action_id: i64,
    protocol_id: i64,
    action_index: i64,
) -> SyntheticInquiryActionReceipt with Panic {
    assert(action_id > 0 && protocol_id > 0)
    assert(action_index >= 0 && action_index <= 2)
    SyntheticInquiryActionReceipt {
        action_id: action_id,
        protocol_id: protocol_id,
        action_index: action_index,
        operation_code: action_index,
        declared_burden_units: if action_index == 0 { 2 } else if action_index == 1 { 2 } else { 3 },
        may_write_relational_layer: true,
        may_write_instrument_layer: true,
        writes_epistemic_trace: true,
        physical_intervention_claimed: false,
        clinical_authority: false,
    }
}

pub fn derive_inquiry_effect_footprint(
    footprint_id: i64,
    hypothesis: LayeredInquiryHypothesisReceipt,
    action: SyntheticInquiryActionReceipt,
) -> InquiryEffectFootprintReceipt with Panic {
    assert(footprint_id > 0)
    validate_hypothesis(hypothesis)
    validate_action(action)
    let footprint = InquiryEffectFootprintReceipt {
        footprint_id: footprint_id,
        hypothesis_id: hypothesis.hypothesis_id,
        mode: hypothesis.mode,
        action_id: action.action_id,
        action_index: action.action_index,
        reads_relational_layer: true,
        writes_relational_layer: hypothesis.mode == 1,
        reads_instrument_layer: true,
        writes_instrument_layer: hypothesis.mode == 2,
        writes_epistemic_trace: true,
        exact_for_declared_fixture: true,
    }
    validate_footprint(footprint)
    footprint
}

pub fn declare_matched_synthetic_protocol_pair(
    pair_id: i64,
    protocol_id: i64,
    initial_relational_state: i64,
    initial_instrument_state: i64,
) -> MatchedSyntheticProtocolPairReceipt with Panic {
    assert(pair_id > 0 && protocol_id > 0)
    assert(initial_relational_state == 1)
    assert(initial_instrument_state == 0)
    let pair = MatchedSyntheticProtocolPairReceipt {
        pair_id: pair_id,
        protocol_id: protocol_id,
        initial_relational_state: initial_relational_state,
        initial_instrument_state: initial_instrument_state,
        initial_projection: initial_relational_state + initial_instrument_state,
        schedules_start_from_equal_full_state: true,
        synthetic_reset_declared: true,
        same_real_person_counterfactual_claimed: false,
        physical_reset_established: false,
    }
    validate_matched_pair(pair)
    pair
}

pub fn begin_layered_inquiry_state(
    state_id: i64,
    family: ThreeLocusInquiryFamilyReceipt,
    hypothesis: LayeredInquiryHypothesisReceipt,
    pair: MatchedSyntheticProtocolPairReceipt,
) -> LayeredInquiryStateReceipt with Panic {
    validate_family(family)
    validate_hypothesis(hypothesis)
    validate_matched_pair(pair)
    assert(hypothesis.declared_family_id == family.family_id)
    assert(hypothesis.hypothesis_id == family_hypothesis_id(family, hypothesis.mode))
    assert(pair.protocol_id == family.protocol_id)
    assert(pair.schedules_start_from_equal_full_state)
    assert(pair.synthetic_reset_declared)
    assert(!pair.same_real_person_counterfactual_claimed)
    let state = LayeredInquiryStateReceipt {
        state_id: state_id,
        family_id: family.family_id,
        protocol_id: family.protocol_id,
        hypothesis_id: hypothesis.hypothesis_id,
        mode: hypothesis.mode,
        tick: 0,
        relational_state: pair.initial_relational_state,
        instrument_state: pair.initial_instrument_state,
        observable_projection: pair.initial_projection,
        action_count: 0,
        action_mask: 0,
        last_action_index: -1,
        last_trace_provenance_id: 0,
        trace_fingerprint: 0,
        synthetic_scope_only: true,
        clinical_authority: false,
    }
    validate_state(state)
    state
}

pub fn apply_synthetic_inquiry_action(
    transition_id: i64,
    result_state_id: i64,
    source: LayeredInquiryStateReceipt,
    action: SyntheticInquiryActionReceipt,
    trace_provenance_id: i64,
) -> LayeredInquiryTransitionReceipt with Panic {
    assert(transition_id > 0 && result_state_id > 0)
    validate_state(source)
    validate_action(action)
    assert(action.protocol_id == source.protocol_id)
    assert(trace_provenance_id > 0 && trace_provenance_id <= 1000000)
    assert((source.action_mask / action_bit(action.action_index)) % 2 == 0)
    let relational = next_relational_state(
        source.mode, action.action_index, source.relational_state,
    )
    let instrument = next_instrument_state(
        source.mode, action.action_index, source.instrument_state,
    )
    let result = LayeredInquiryStateReceipt {
        state_id: result_state_id,
        family_id: source.family_id,
        protocol_id: source.protocol_id,
        hypothesis_id: source.hypothesis_id,
        mode: source.mode,
        tick: source.tick + 1,
        relational_state: relational,
        instrument_state: instrument,
        observable_projection: relational + instrument,
        action_count: source.action_count + 1,
        action_mask: source.action_mask + action_bit(action.action_index),
        last_action_index: action.action_index,
        last_trace_provenance_id: trace_provenance_id,
        trace_fingerprint: source.trace_fingerprint * 31 + trace_provenance_id,
        synthetic_scope_only: true,
        clinical_authority: false,
    }
    let transition = LayeredInquiryTransitionReceipt {
        transition_id: transition_id,
        family_id: source.family_id,
        protocol_id: source.protocol_id,
        hypothesis_id: source.hypothesis_id,
        mode: source.mode,
        action_id: action.action_id,
        action_index: action.action_index,
        source_state_id: source.state_id,
        source_tick: source.tick,
        source_relational_state: source.relational_state,
        source_instrument_state: source.instrument_state,
        source_projection: source.observable_projection,
        source_action_count: source.action_count,
        source_action_mask: source.action_mask,
        source_trace_provenance_id: source.last_trace_provenance_id,
        source_trace_fingerprint: source.trace_fingerprint,
        result_state: result,
        result_relational_state: relational,
        result_instrument_state: instrument,
        observed_projection: relational + instrument,
        trace_provenance_id: trace_provenance_id,
        exact_transition_replayed: true,
        clinical_authority: false,
    }
    validate_transition(transition)
    transition
}

pub fn layered_inquiry_transition_result(
    transition: LayeredInquiryTransitionReceipt,
) -> LayeredInquiryStateReceipt with Panic {
    validate_transition(transition)
    transition.result_state
}

pub fn layered_inquiry_observed_projection(
    transition: LayeredInquiryTransitionReceipt,
) -> i64 with Panic {
    validate_transition(transition)
    transition.observed_projection
}

pub fn layered_inquiry_relational_state(state: LayeredInquiryStateReceipt) -> i64 with Panic {
    validate_state(state)
    state.relational_state
}

pub fn layered_inquiry_instrument_state(state: LayeredInquiryStateReceipt) -> i64 with Panic {
    validate_state(state)
    state.instrument_state
}

pub fn layered_inquiry_trace_fingerprint(state: LayeredInquiryStateReceipt) -> i64 with Panic {
    validate_state(state)
    state.trace_fingerprint
}

pub fn record_potential_inquiry_interference(
    interference_id: i64,
    left: InquiryEffectFootprintReceipt,
    right: InquiryEffectFootprintReceipt,
) -> PotentialInquiryInterferenceReceipt with Panic {
    assert(interference_id > 0)
    validate_footprint(left)
    validate_footprint(right)
    assert(left.hypothesis_id == right.hypothesis_id)
    assert(left.mode == right.mode)
    assert(left.action_id != right.action_id)
    assert(left.action_index != right.action_index)
    assert(left.exact_for_declared_fixture && right.exact_for_declared_fixture)
    let relational_overlap = left.writes_relational_layer && right.writes_relational_layer
    let instrument_overlap = left.writes_instrument_layer && right.writes_instrument_layer
    let interference = PotentialInquiryInterferenceReceipt {
        interference_id: interference_id,
        hypothesis_id: left.hypothesis_id,
        mode: left.mode,
        left_action_id: left.action_id,
        right_action_id: right.action_id,
        left_action_index: left.action_index,
        right_action_index: right.action_index,
        writes_same_relational_layer: relational_overlap,
        writes_same_instrument_layer: instrument_overlap,
        footprint_overlap: relational_overlap || instrument_overlap,
        exact_noncommutation_established: false,
    }
    validate_interference(interference)
    interference
}

pub fn certify_passive_inquiry_commutation(
    receipt_id: i64,
    p_then_q_first: LayeredInquiryTransitionReceipt,
    p_then_q_second: LayeredInquiryTransitionReceipt,
    q_then_p_first: LayeredInquiryTransitionReceipt,
    q_then_p_second: LayeredInquiryTransitionReceipt,
) -> PassiveInquiryCommutationReceipt with Panic {
    assert(receipt_id > 0)
    validate_schedule_link(p_then_q_first, p_then_q_second)
    validate_schedule_link(q_then_p_first, q_then_p_second)
    validate_matched_schedule_roots(p_then_q_first, q_then_p_first)
    assert(p_then_q_first.mode == 0 && q_then_p_first.mode == 0)
    assert(p_then_q_first.action_index == 0 && p_then_q_second.action_index == 1)
    assert(q_then_p_first.action_index == 1 && q_then_p_second.action_index == 0)
    assert(p_then_q_first.source_relational_state == q_then_p_first.source_relational_state)
    assert(p_then_q_first.source_instrument_state == q_then_p_first.source_instrument_state)
    assert(p_then_q_second.result_relational_state == q_then_p_second.result_relational_state)
    assert(p_then_q_second.result_instrument_state == q_then_p_second.result_instrument_state)
    assert(p_then_q_first.observed_projection == q_then_p_first.observed_projection)
    assert(p_then_q_second.observed_projection == q_then_p_second.observed_projection)
    let receipt = PassiveInquiryCommutationReceipt {
        receipt_id: receipt_id,
        hypothesis_id: p_then_q_first.hypothesis_id,
        mode: p_then_q_first.mode,
        p_then_q_first_observation: p_then_q_first.observed_projection,
        p_then_q_second_observation: p_then_q_second.observed_projection,
        q_then_p_first_observation: q_then_p_first.observed_projection,
        q_then_p_second_observation: q_then_p_second.observed_projection,
        p_then_q_final_relational_state: p_then_q_second.result_relational_state,
        p_then_q_final_instrument_state: p_then_q_second.result_instrument_state,
        q_then_p_final_relational_state: q_then_p_second.result_relational_state,
        q_then_p_final_instrument_state: q_then_p_second.result_instrument_state,
        p_then_q_final_projection: p_then_q_second.observed_projection,
        q_then_p_final_projection: q_then_p_second.observed_projection,
        final_process_and_instrument_layers_equal: true,
        emitted_observation_traces_equal: true,
        exact_commutation_on_witness: true,
        passive_within_declared_fixture: true,
        universal_observation_commutation_claimed: false,
    }
    validate_passive_commutation_receipt(receipt)
    receipt
}

pub fn authorize_inquiry_reordering(
    authorization_id: i64,
    commutation: PassiveInquiryCommutationReceipt,
) -> InquiryReorderAuthorizationReceipt with Panic {
    assert(authorization_id > 0)
    validate_passive_commutation_receipt(commutation)
    InquiryReorderAuthorizationReceipt {
        authorization_id: authorization_id,
        source_commutation_receipt_id: commutation.receipt_id,
        process_layers_and_emitted_values_commute: true,
        complete_ordered_state_equivalence_claimed: false,
        declared_fixture_only: true,
    }
}

pub fn certify_overlapping_write_state_commutation(
    receipt_id: i64,
    interference: PotentialInquiryInterferenceReceipt,
    q_then_r_first: LayeredInquiryTransitionReceipt,
    q_then_r_second: LayeredInquiryTransitionReceipt,
    r_then_q_first: LayeredInquiryTransitionReceipt,
    r_then_q_second: LayeredInquiryTransitionReceipt,
) -> OverlappingWriteStateCommutationReceipt with Panic {
    assert(receipt_id > 0)
    validate_interference(interference)
    assert(interference.footprint_overlap)
    assert(!interference.exact_noncommutation_established)
    validate_interference_schedule_binding(
        interference,
        q_then_r_first,
        q_then_r_second,
        r_then_q_first,
        r_then_q_second,
    )
    assert(q_then_r_first.mode == 1 && r_then_q_first.mode == 1)
    assert(q_then_r_first.hypothesis_id == interference.hypothesis_id)
    assert(q_then_r_first.action_index == 1 && q_then_r_second.action_index == 2)
    assert(r_then_q_first.action_index == 2 && r_then_q_second.action_index == 1)
    assert(q_then_r_second.result_relational_state == r_then_q_second.result_relational_state)
    assert(q_then_r_second.result_instrument_state == r_then_q_second.result_instrument_state)
    assert(q_then_r_first.observed_projection != r_then_q_first.observed_projection)
    assert(q_then_r_second.observed_projection == r_then_q_second.observed_projection)
    OverlappingWriteStateCommutationReceipt {
        receipt_id: receipt_id,
        hypothesis_id: q_then_r_first.hypothesis_id,
        first_action_index: 1,
        second_action_index: 2,
        write_footprints_overlap: true,
        final_process_and_instrument_layers_equal: true,
        emitted_observation_traces_equal: false,
        state_commutator_zero: true,
        full_inquiry_reordering_authorized: false,
    }
}

pub fn certify_exact_inquiry_noncommutation_witness(
    receipt_id: i64,
    interference: PotentialInquiryInterferenceReceipt,
    p_then_q_first: LayeredInquiryTransitionReceipt,
    p_then_q_second: LayeredInquiryTransitionReceipt,
    q_then_p_first: LayeredInquiryTransitionReceipt,
    q_then_p_second: LayeredInquiryTransitionReceipt,
) -> ExactInquiryNonCommutationWitnessReceipt with Panic {
    assert(receipt_id > 0)
    validate_interference(interference)
    assert(interference.footprint_overlap)
    assert(!interference.exact_noncommutation_established)
    validate_interference_schedule_binding(
        interference,
        p_then_q_first,
        p_then_q_second,
        q_then_p_first,
        q_then_p_second,
    )
    assert(p_then_q_first.mode == q_then_p_first.mode)
    assert(p_then_q_first.mode == 1 || p_then_q_first.mode == 2)
    assert(p_then_q_first.hypothesis_id == interference.hypothesis_id)
    assert(p_then_q_first.action_index == 0 && p_then_q_second.action_index == 1)
    assert(q_then_p_first.action_index == 1 && q_then_p_second.action_index == 0)
    assert(p_then_q_first.source_relational_state == q_then_p_first.source_relational_state)
    assert(p_then_q_first.source_instrument_state == q_then_p_first.source_instrument_state)
    let commutator = p_then_q_second.observed_projection -
        q_then_p_second.observed_projection
    assert(commutator != 0)
    ExactInquiryNonCommutationWitnessReceipt {
        receipt_id: receipt_id,
        hypothesis_id: p_then_q_first.hypothesis_id,
        mode: p_then_q_first.mode,
        p_then_q_first_observation: p_then_q_first.observed_projection,
        p_then_q_second_observation: p_then_q_second.observed_projection,
        q_then_p_first_observation: q_then_p_first.observed_projection,
        q_then_p_second_observation: q_then_p_second.observed_projection,
        p_then_q_final_relational_state: p_then_q_second.result_relational_state,
        p_then_q_final_instrument_state: p_then_q_second.result_instrument_state,
        q_then_p_final_relational_state: q_then_p_second.result_relational_state,
        q_then_p_final_instrument_state: q_then_p_second.result_instrument_state,
        projected_commutator: commutator,
        same_action_multiset: true,
        footprint_conflict_replayed: true,
        exact_noncommutation_on_witness: true,
        nonassociativity_established: false,
        biological_reactivity_established: false,
        clinical_authority: false,
    }
}

pub fn record_full_state_expansion(
    expansion_id: i64,
    noncommutation: ExactInquiryNonCommutationWitnessReceipt,
) -> FullStateExpansionReceipt with Panic {
    assert(expansion_id > 0)
    validate_noncommutation_receipt(noncommutation)
    FullStateExpansionReceipt {
        expansion_id: expansion_id,
        noncommutation_receipt_id: noncommutation.receipt_id,
        relational_layer_retained: true,
        instrument_layer_retained: true,
        action_history_retained: true,
        transition_is_deterministic_on_expanded_state: true,
        observable_projection_markov_sufficient: false,
        projected_order_effect_preserved: true,
        nonassociativity_established: false,
    }
}

pub fn record_inquiry_evidence_provenance(
    provenance_id: i64,
    source_id: i64,
    protocol_id: i64,
    tick: i64,
    previous_provenance_id: i64,
) -> InquiryEvidenceProvenanceReceipt with Panic {
    assert(provenance_id > 0 && provenance_id <= 1000000)
    assert(source_id > 0 && source_id <= 1000000)
    assert(protocol_id > 0)
    assert(tick > 0 && tick <= 8)
    assert(previous_provenance_id >= 0 && previous_provenance_id <= 1000000)
    assert(previous_provenance_id != provenance_id)
    let provenance = InquiryEvidenceProvenanceReceipt {
        provenance_id: provenance_id,
        source_id: source_id,
        protocol_id: protocol_id,
        tick: tick,
        previous_provenance_id: previous_provenance_id,
        chain_complete: true,
    }
    validate_evidence_provenance(provenance)
    provenance
}

