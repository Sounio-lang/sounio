// Exact finite synthetic kernel for proof-carrying reflexive inquiry D3.
//
// The fixture separates passive observation, relational reactivity, and
// instrument adaptation. It does not represent a real person, psychiatric
// mechanism, physical measurement, counterfactual outcome, or clinical act.
// "Proof-carrying" here means runtime-replayable receipts. This module claims
// neither a proof-assistant soundness theorem nor compiler-sealed construction.

pub struct LayeredInquiryHypothesisReceipt {
    pub hypothesis_id: i64,
    pub mode: i64,
    pub declared_family_id: i64,
    pub passive_mode: bool,
    pub relational_reactivity_mode: bool,
    pub instrument_adaptation_mode: bool,
    pub empirically_established: bool,
    pub clinical_authority: bool,
}

