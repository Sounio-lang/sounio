// stdlib/epistemic/sign.sio
//
// Two Knowledge readings of one quantity. What leaves is only the interval
// both still sign. The wings of a single reading do not travel with it.
// If the intervals do not meet, the leaving sigma is wider than either bar:
// an empty intersection is not a precise number.

use epistemic::claim_meet::{claim_meet, claim_sqrt}

pub struct Signed {
    pub lo: f64
    pub hi: f64
    pub mid: f64
    pub sigma: f64
    pub agreed: bool
    pub excess: f64
}

pub fn sign_interval(mean_a: f64, var_a: f64, mean_b: f64, var_b: f64) -> Signed with Mut, Div {
    let m = claim_meet(mean_a, var_a, mean_b, var_b)
    let sa = claim_sqrt(var_a)
    let sb = claim_sqrt(var_b)
    var mid = (mean_a + mean_b) * 0.5
    var sigma = sa + sb
    if m.shared {
        mid = (m.lo + m.hi) * 0.5
        sigma = (m.hi - m.lo) * 0.5
    } else {
        var gap = m.lo - m.hi
        if gap < 0.0 { gap = 0.0 }
        sigma = sa + sb + gap
    }
    Signed {
        lo: m.lo,
        hi: m.hi,
        mid: mid,
        sigma: sigma,
        agreed: m.shared,
        excess: m.excess
    }
}

pub fn sign_knowledge(a: Knowledge<f64>, b: Knowledge<f64>) -> Knowledge<f64> with Epistemic, Mut, Div {
    let ma = second_order_mean(a.value)
    let mb = second_order_mean(b.value)
    let va = variance_of(a.value)
    let vb = variance_of(b.value)
    let s = sign_interval(ma, va, mb, vb)
    let tag = s.mid
    measure(tag, uncertainty: s.sigma)
}

// sigma / |value| of a Knowledge that has already left a contest.
// The caller cannot pass the reading that was discarded.
pub fn relative_half_width(k: Knowledge<f64>) -> f64 with Epistemic, Mut, Div {
    let s = claim_sqrt(variance_of(k.value))
    let v = k.value
    if v == 0.0 { return s }
    if v < 0.0 { return s / (0.0 - v) }
    s / v
}

pub fn inside_window(k: Knowledge<f64>, lo: f64, hi: f64) -> bool with Epistemic, Mut, Div {
    let s = claim_sqrt(variance_of(k.value))
    let v = k.value
    (v - s) >= lo && (v + s) <= hi
}
