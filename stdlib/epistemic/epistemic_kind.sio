// Epistemic uncertainty type — reducible model uncertainty
//
// Epistemic<T> wraps a value with reducible uncertainty.
// Epistemic uncertainty can in principle be reduced by:
//   - Collecting more data
//   - Improving the model
//   - Bayesian updating
//
// Contrast with Aleatoric<T> which is irreducible.

module epistemic::epistemic_kind

// Epistemic uncertainty value wrapper.
struct EpistemicValue {
    value: f64,
    epsilon: f64,
    reducible_by_n_samples: i64,   // samples needed to halve uncertainty (-1 = unknown)
}

// Construct an epistemic value
fn epistemic_new(value: f64, epsilon: f64) -> EpistemicValue {
    EpistemicValue {
        value: value,
        epsilon: epsilon,
        reducible_by_n_samples: -1,
    }
}

// Integer square root approximation (Newton's method, 10 iterations)
fn sqrt_ep_approx(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 {
        0.0
    } else {
        var est: f64 = x
        var i: i64 = 0
        while i < 10 {
            est = (est + x / est) / 2.0
            i = i + 1
        }
        est
    }
}

// Bayesian update: combine prior epistemic estimate with new data
// New epsilon ~= prior_eps / sqrt(1 + n_new_samples)
fn epistemic_update(prior: EpistemicValue, n_new_samples: i64) -> EpistemicValue with Mut, Div, Panic {
    if n_new_samples <= 0 {
        prior
    } else {
        let n_f = n_new_samples as f64
        let new_eps = prior.epsilon / sqrt_ep_approx(1.0 + n_f)
        EpistemicValue {
            value: prior.value,
            epsilon: new_eps,
            reducible_by_n_samples: prior.reducible_by_n_samples,
        }
    }
}

fn epistemic_value(e: EpistemicValue) -> f64 {
    e.value
}

fn epistemic_epsilon(e: EpistemicValue) -> f64 {
    e.epsilon
}
