// Aleatoric uncertainty type — irreducible inherent randomness
//
// Aleatoric<T> wraps a value with irreducible uncertainty.
// Unlike Epistemic<T>, aleatoric uncertainty cannot be reduced
// by collecting more data or improving the model.
//
// Examples:
//   - Thermal sensor noise (physical limit)
//   - Quantum measurement outcomes
//   - Molecular Brownian motion

module epistemic::aleatoric

// Aleatoric uncertainty value wrapper.
// epsilon: relative uncertainty bound in [0, 1]
struct AleatoricValue {
    value: f64,
    epsilon: f64,
    source_description: i64,  // string table index for description
}

// Construct an aleatoric value with given uncertainty
fn aleatoric_new(value: f64, epsilon: f64) -> AleatoricValue {
    AleatoricValue {
        value: value,
        epsilon: epsilon,
        source_description: -1,
    }
}

// Integer square root approximation (Newton's method, 10 iterations)
fn sqrt_approx(x: f64) -> f64 with Div {
    if x <= 0.0 {
        0.0
    } else {
        var est: f64 = x
        var i: i64 = 0
        while i < 10 {
            est = (est + x / est) / 2.0
            i = i + 1
        }
        est
    }
}

// Propagate through addition: a + b
// Rule: independent aleatoric uncertainties add in quadrature (they are uncorrelated)
fn aleatoric_add(a: AleatoricValue, b: AleatoricValue) -> AleatoricValue with Div {
    let combined_eps = sqrt_approx(a.epsilon * a.epsilon + b.epsilon * b.epsilon)
    AleatoricValue {
        value: a.value + b.value,
        epsilon: combined_eps,
        source_description: -1,
    }
}

// Propagate through multiplication
fn aleatoric_mul(a: AleatoricValue, b: AleatoricValue) -> AleatoricValue with Div {
    let combined_eps = sqrt_approx(a.epsilon * a.epsilon + b.epsilon * b.epsilon)
    AleatoricValue {
        value: a.value * b.value,
        epsilon: combined_eps,
        source_description: -1,
    }
}

// Extract the raw value (discarding uncertainty metadata)
fn aleatoric_value(a: AleatoricValue) -> f64 {
    a.value
}

// Extract the epsilon bound
fn aleatoric_epsilon(a: AleatoricValue) -> f64 {
    a.epsilon
}
