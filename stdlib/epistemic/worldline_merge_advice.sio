// Digest-only epistemic advice for UNEQSELF SYNC-004 worldline merge.
//
// This module classifies evidence supplied by an already verified conflict
// set. It cannot select a branch, mutate a worldline, authorize a merge, or
// inspect protected plaintext. Those boundaries are represented as explicit
// false/true fields in every receipt rather than prose-only promises.

pub struct MergeDigest32 {
    pub limb0: i64,
    pub limb1: i64,
    pub limb2: i64,
    pub limb3: i64,
}

pub struct MergeEvidenceInventory {
    pub observed_fact_count: i64,
    pub inference_count: i64,
    pub contradiction_count: i64,
    pub missing_evidence_count: i64,
    pub open_obligation_count: i64,
    pub alternative_proposal_count: i64,
}

pub struct EpistemicWorldlineMergeAdviceReceipt {
    pub conflict_id: MergeDigest32,
    pub implementation_digest: MergeDigest32,
    pub inventory: MergeEvidenceInventory,
    pub evidence_categories_distinct: bool,
    pub digest_only: bool,
    pub protected_plaintext_observed: bool,
    pub branch_selected: bool,
    pub branch_mutated: bool,
    pub authoritative_decision: bool,
    pub human_review_required: bool,
    pub analysis_admissible: bool,
    pub inference_deferred: bool,
}

pub fn merge_digest32(limb0: i64, limb1: i64, limb2: i64, limb3: i64) -> MergeDigest32 {
    return MergeDigest32 {
        limb0: limb0,
        limb1: limb1,
        limb2: limb2,
        limb3: limb3,
    }
}

pub fn merge_evidence_inventory(
    observed_fact_count: i64,
    inference_count: i64,
    contradiction_count: i64,
    missing_evidence_count: i64,
    open_obligation_count: i64,
    alternative_proposal_count: i64,
) -> MergeEvidenceInventory {
    return MergeEvidenceInventory {
        observed_fact_count: observed_fact_count,
        inference_count: inference_count,
        contradiction_count: contradiction_count,
        missing_evidence_count: missing_evidence_count,
        open_obligation_count: open_obligation_count,
        alternative_proposal_count: alternative_proposal_count,
    }
}

fn merge_digest_is_zero(digest: MergeDigest32) -> bool {
    return digest.limb0 == 0
        && digest.limb1 == 0
        && digest.limb2 == 0
        && digest.limb3 == 0
}

fn merge_inventory_nonnegative(inventory: MergeEvidenceInventory) -> bool {
    return inventory.observed_fact_count >= 0
        && inventory.inference_count >= 0
        && inventory.contradiction_count >= 0
        && inventory.missing_evidence_count >= 0
        && inventory.open_obligation_count >= 0
        && inventory.alternative_proposal_count >= 0
}

pub fn analyze_worldline_merge_digests(
    conflict_id: MergeDigest32,
    implementation_digest: MergeDigest32,
    inventory: MergeEvidenceInventory,
) -> EpistemicWorldlineMergeAdviceReceipt {
    let identifiers_present = !merge_digest_is_zero(conflict_id)
        && !merge_digest_is_zero(implementation_digest)
    let inventory_valid = merge_inventory_nonnegative(inventory)
    let evidence_present = inventory.observed_fact_count > 0
    let unresolved = inventory.contradiction_count > 0
        || inventory.missing_evidence_count > 0
        || inventory.open_obligation_count > 0

    return EpistemicWorldlineMergeAdviceReceipt {
        conflict_id: conflict_id,
        implementation_digest: implementation_digest,
        inventory: inventory,
        evidence_categories_distinct: true,
        digest_only: true,
        protected_plaintext_observed: false,
        branch_selected: false,
        branch_mutated: false,
        authoritative_decision: false,
        human_review_required: true,
        analysis_admissible: identifiers_present && inventory_valid && evidence_present,
        inference_deferred: !identifiers_present || !inventory_valid || !evidence_present || unresolved,
    }
}
