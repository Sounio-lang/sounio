// stdlib/epistemic/observation_provenance.sio
//
// Narrow, generic provenance receipts for how an observation reached a record.
//
// The module deliberately separates opportunity, presence, selection, and the
// measurement act. It also keeps a derived, regularized representation distinct
// from the observation-history reference it used. It is a library-level
// boundary, not a clinical model, an empirical missingness theorem, an
// authority capability, or a claim that an observation changes a person's
// state.

struct ObservationOpportunityI64 {
    protocol_id: i64,
    source_system_tag: i64,
}

struct EncounterPresenceI64 {
    channel_tag: i64,
    encounter_tag: i64,
}

struct MeasurementSelectionI64 {
    selection_tag: i64,
    trigger_tag: i64,
}

struct MeasurementActI64 {
    instrument_tag: i64,
    response_window_tag: i64,
}

struct RecordedMeasurementI64 {
    route_tag: i64,
}

struct ObservationHistoryI64 {
    anchor_recorded_tag: i64,
    history_tag: i64,
}

struct ObservationTransformationI64 {
    method_tag: i64,
    parameterization_tag: i64,
}

struct RegularizedObservationI64 {
    representation_tag: i64,
}

struct ObservationFeatureUseI64 {
    feature_tag: i64,
}

struct ObservationProcessAbstentionI64 {
    protocol_id: i64,
    reason_tag: i64,
}

fn op_require_nonzero(tag: i64) -> i64 with Panic {
    assert(tag != 0)
    tag
}

pub fn op_observation_opportunity_i64(protocol_id: i64, source_system_tag: i64) -> ObservationOpportunityI64 with Panic {
    ObservationOpportunityI64 {
        protocol_id: op_require_nonzero(protocol_id),
        source_system_tag: op_require_nonzero(source_system_tag),
    }
}

pub fn op_encounter_presence_i64(channel_tag: i64, encounter_tag: i64) -> EncounterPresenceI64 with Panic {
    EncounterPresenceI64 {
        channel_tag: op_require_nonzero(channel_tag),
        encounter_tag: op_require_nonzero(encounter_tag),
    }
}

pub fn op_measurement_selection_i64(selection_tag: i64, trigger_tag: i64) -> MeasurementSelectionI64 with Panic {
    MeasurementSelectionI64 {
        selection_tag: op_require_nonzero(selection_tag),
        trigger_tag: op_require_nonzero(trigger_tag),
    }
}

pub fn op_measurement_act_i64(instrument_tag: i64, response_window_tag: i64) -> MeasurementActI64 with Panic {
    MeasurementActI64 {
        instrument_tag: op_require_nonzero(instrument_tag),
        response_window_tag: op_require_nonzero(response_window_tag),
    }
}

// A recorded measurement is constructible only from all four declared route
// categories. This is a nominal API boundary, not a statement that the route
// is complete or empirically ignorable.
pub fn op_record_measurement_i64(
    opportunity: ObservationOpportunityI64,
    presence: EncounterPresenceI64,
    selection: MeasurementSelectionI64,
    act: MeasurementActI64
) -> RecordedMeasurementI64 with Panic {
    RecordedMeasurementI64 {
        route_tag: opportunity.protocol_id + presence.encounter_tag + selection.selection_tag + act.instrument_tag,
    }
}

// An observation-history receipt is anchored to a declared recorded
// measurement. The opaque history tag identifies a supplied history reference;
// it does not assert that the reference is complete or empirically valid.
pub fn op_observation_history_from_recorded_i64(
    recorded: RecordedMeasurementI64,
    history_tag: i64
) -> ObservationHistoryI64 with Panic {
    ObservationHistoryI64 {
        anchor_recorded_tag: recorded.route_tag,
        history_tag: op_require_nonzero(history_tag),
    }
}

// The transformation receipt names a method and parameterization. It is not a
// claim that resampling, aggregation, or imputation recovers raw history.
pub fn op_observation_transformation_i64(
    method_tag: i64,
    parameterization_tag: i64
) -> ObservationTransformationI64 with Panic {
    ObservationTransformationI64 {
        method_tag: op_require_nonzero(method_tag),
        parameterization_tag: op_require_nonzero(parameterization_tag),
    }
}

// A regularized representation can be built only from a history reference and
// a declared transformation receipt. The result deliberately remains a new
// nominal category rather than becoming an observation history.
pub fn op_regularize_observation_i64(
    history: ObservationHistoryI64,
    transformation: ObservationTransformationI64
) -> RegularizedObservationI64 {
    RegularizedObservationI64 {
        representation_tag: history.history_tag + transformation.method_tag + transformation.parameterization_tag,
    }
}

// A feature can be declared for a prediction or descriptive task without
// promoting it into identification or transport evidence.
pub fn op_observation_feature_i64(
    presence: EncounterPresenceI64,
    selection: MeasurementSelectionI64
) -> ObservationFeatureUseI64 with Panic {
    ObservationFeatureUseI64 {
        feature_tag: presence.channel_tag + selection.trigger_tag,
    }
}

pub fn op_abstain_unresolved_route_i64(
    opportunity: ObservationOpportunityI64,
    reason_tag: i64
) -> ObservationProcessAbstentionI64 with Panic {
    ObservationProcessAbstentionI64 {
        protocol_id: opportunity.protocol_id,
        reason_tag: op_require_nonzero(reason_tag),
    }
}

pub fn op_recorded_measurement_tag_i64(receipt: RecordedMeasurementI64) -> i64 {
    receipt.route_tag
}

pub fn op_observation_history_tag_i64(receipt: ObservationHistoryI64) -> i64 {
    receipt.history_tag
}

pub fn op_observation_history_anchor_tag_i64(receipt: ObservationHistoryI64) -> i64 {
    receipt.anchor_recorded_tag
}

pub fn op_observation_transformation_method_tag_i64(receipt: ObservationTransformationI64) -> i64 {
    receipt.method_tag
}

pub fn op_regularized_observation_tag_i64(receipt: RegularizedObservationI64) -> i64 {
    receipt.representation_tag
}

pub fn op_observation_feature_tag_i64(receipt: ObservationFeatureUseI64) -> i64 {
    receipt.feature_tag
}

pub fn op_abstention_reason_tag_i64(receipt: ObservationProcessAbstentionI64) -> i64 {
    receipt.reason_tag
}

pub fn op_abstention_protocol_id_i64(receipt: ObservationProcessAbstentionI64) -> i64 {
    receipt.protocol_id
}
