pub fn certify_d11_subgroup_risk_bound(
    law: D11LabeledExactJointFixtureToken,
) -> D11SubgroupRiskBoundToken with Panic {
    validate_d11_labeled_exact_joint_fixture(law)
    let observation = observe_d11_balanced_subgroup_risk(31502)
    assert(observation.group_a_case_count ==
        law.positive_group_a_case_count)
    assert(observation.group_a_error_count ==
        law.positive_group_a_error_count)
    assert(observation.group_b_case_count ==
        law.positive_group_b_case_count)
    assert(observation.group_b_error_count ==
        law.positive_group_b_error_count)
    assert(observation.marginal_case_count == law.common_mass_denominator)
    assert(observation.marginal_error_count == law.target_mass_0)
    assert(observation.baseline_joint_law_fingerprint ==
        law.joint_law_fingerprint)
    assert(observation.group_plan_id == law.group_plan_id)
    assert(observation.loss_id == law.loss_id)
    assert(observation.prespecified_groups && observation.bound_met)
    assert(observation.worst_group_risk_numerator == 1)
    assert(observation.worst_group_risk_denominator == 2)
    assert(observation.baseline_joint_law_fingerprint ==
        law.joint_law_fingerprint)
    D11SubgroupRiskBoundToken {
        evidence_id: observation.receipt_id,
        evidence_window_id: law.evidence_window_id,
        model_version_id: law.model_version_id,
        target_population_id: law.target_population_id,
        group_plan_id: law.group_plan_id,
        worst_risk_numerator: observation.worst_group_risk_numerator,
        worst_risk_denominator: observation.worst_group_risk_denominator,
        fixture_run_id: law.fixture_run_id,
        joint_law_fingerprint: law.joint_law_fingerprint,
        loss_id: law.loss_id,
    }
}

pub fn observe_d11_source_marginal_calibration(
    receipt_id: i64,
) -> D11SourceMarginalCalibrationReceipt with Panic {
    assert(receipt_id == 31601)
    // The diagnostic score is 1/4; masses and outcomes come from the exact law.
    let source_residual_scaled = 3 * (4 * 1 - 1) + 9 * (4 * 0 - 1)
    let source_residual_scaled_denominator = 12 * 4
    assert(source_residual_scaled == 0)
    assert(source_residual_scaled_denominator == 48)
    D11SourceMarginalCalibrationReceipt {
        receipt_id: receipt_id,
        source_mass_a: 3,
        source_mass_b: 9,
        prediction_a_numerator: 1,
        prediction_b_numerator: 1,
        prediction_denominator: 4,
        source_residual_numerator: 0,
        source_residual_denominator: 1,
        marginally_calibrated_in_source: true,
        target_local_calibration_established: false,
        baseline_joint_law_fingerprint: 92352734845403155,
        diagnostic_score_policy_id: 31621,
    }
}

pub fn observe_d11_target_calibration_drift(
    receipt_id: i64,
) -> D11TargetCalibrationDriftReceipt with Panic {
    assert(receipt_id == 31602)
    // The same 1/4 diagnostic score has residual 12/48 = 1/4 in target.
    let target_residual_scaled = 6 * (4 * 1 - 1) + 6 * (4 * 0 - 1)
    let target_residual_scaled_denominator = 12 * 4
    assert(target_residual_scaled == 12)
    assert(target_residual_scaled_denominator == 48)
    assert(target_residual_scaled * 4 == target_residual_scaled_denominator)
    D11TargetCalibrationDriftReceipt {
        receipt_id: receipt_id,
        target_mass_a: 6,
        target_mass_b: 6,
        target_residual_numerator: 1,
        target_residual_denominator: 4,
        weighted_source_residual_numerator: 1,
        weighted_source_residual_denominator: 4,
        source_marginal_calibration_preserved: false,
        soft_drift_warning: true,
        automatic_recalibration_authorized: false,
        baseline_joint_law_fingerprint: 92352734845403155,
        diagnostic_score_policy_id: 31621,
        authorizes_state_transition: false,
    }
}

