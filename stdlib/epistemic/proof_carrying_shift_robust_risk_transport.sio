pub fn observe_d11_covariate_shift_transport(
    receipt_id: i64,
) -> D11CovariateShiftTransportObservationReceipt with Panic {
    assert(receipt_id == 31201)
    let source_risk_num = 1
    let source_risk_den = 4
    let target_risk_num = 1
    let target_risk_den = 2
    // A is atom 0; B is atoms 1..3. The common weight denominator is 3.
    let weighted_scaled_num = 3 * 2 * 3 * 1 + 9 * 2 * 0
    let weighted_scaled_den = 12 * 3
    assert(source_risk_num * 4 == source_risk_den)
    assert(target_risk_num * 2 == target_risk_den)
    assert(weighted_scaled_num == 18 && weighted_scaled_den == 36)
    assert(weighted_scaled_num * target_risk_den ==
        target_risk_num * weighted_scaled_den)
    D11CovariateShiftTransportObservationReceipt {
        receipt_id: receipt_id,
        source_population_id: 31111,
        target_population_id: 31112,
        source_mass_a: 3,
        source_mass_b: 9,
        target_mass_a: 6,
        target_mass_b: 6,
        mass_denominator: 12,
        weight_a_numerator: 2,
        weight_a_denominator: 1,
        weight_b_numerator: 2,
        weight_b_denominator: 3,
        source_risk_numerator: source_risk_num,
        source_risk_denominator: source_risk_den,
        target_risk_numerator: target_risk_num,
        target_risk_denominator: target_risk_den,
        weighted_source_risk_numerator: 1,
        weighted_source_risk_denominator: 2,
        conditional_law_invariant: true,
        overlap_established: true,
        exact_for_two_cells: true,
        joint_law_fingerprint: 92352734845403155,
        loss_id: 31711,
    }
}

pub fn observe_d11_covariate_overlap_failure(
