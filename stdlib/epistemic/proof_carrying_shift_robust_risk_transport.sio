fn validate_d11_labeled_exact_joint_fixture(
    token: D11LabeledExactJointFixtureToken,
) -> i64 with Panic {
    assert(token.fixture_run_id == 31911 && token.warrant_id == 31100)
    assert(token.d10_lease_id == 30821 && token.d10_evidence_id == 30301)
    assert(token.joint_fixture_id == 31131)
    assert(token.joint_law_fingerprint == 92352734845403155)
    assert(token.evidence_window_id == 31121 && token.monitoring_epoch == 1)
    assert(token.model_version_id == 30412 && token.site_id == 30461)
    assert(token.workflow_version_id == 30471)
    assert(token.source_population_id == 31111)
    assert(token.target_population_id == 31112)
    assert(token.label_probe_id == 31311 && token.loss_id == 31711)
    assert(token.group_plan_id == 31512)
    assert(token.calibrator_version_id == 30413)
    assert(token.diagnostic_score_policy_id == 31621)
    assert(token.common_mass_denominator == 12)
    assert(token.source_mass_0 == 3 && token.source_mass_1 == 3)
    assert(token.source_mass_2 == 3 && token.source_mass_3 == 3)
    assert(token.target_mass_0 == 6 && token.target_mass_1 == 2)
    assert(token.target_mass_2 == 2 && token.target_mass_3 == 2)
    assert(token.loss_0 == 1 && token.loss_1 == 0)
    assert(token.loss_2 == 0 && token.loss_3 == 0)
    assert(token.coarse_cell_0 == 0 && token.coarse_cell_1 == 1)
    assert(token.coarse_cell_2 == 1 && token.coarse_cell_3 == 1)
    assert(token.label_0 == token.coarse_cell_0)
    assert(token.label_1 == token.coarse_cell_1)
    assert(token.label_2 == token.coarse_cell_2)
    assert(token.label_3 == token.coarse_cell_3)
    assert(token.probe_confusion_00 == 1 && token.probe_confusion_01 == 0)
    assert(token.probe_confusion_10 == 0 && token.probe_confusion_11 == 1)
    assert(token.diagnostic_score_a_numerator == 1)
    assert(token.diagnostic_score_b_numerator == 1)
    assert(token.diagnostic_score_denominator == 4)
    assert(token.active_score_a_numerator == 1)
    assert(token.active_score_b_numerator == 0)
    assert(token.active_score_denominator == 1)
    assert(token.positive_group_a_case_count == 6)
    assert(token.positive_group_a_error_count == 3)
    assert(token.positive_group_b_case_count == 6)
    assert(token.positive_group_b_error_count == 3)
    assert(token.positive_group_a_case_count +
        token.positive_group_b_case_count == token.common_mass_denominator)
    assert(token.positive_group_a_error_count +
        token.positive_group_b_error_count == token.target_mass_0)
    token.joint_law_fingerprint
}

pub fn certify_d11_labeled_exact_joint_fixture(
) -> D11LabeledExactJointFixtureToken with Panic {
    let d10_token = replay_d10_complete_fixture_canary()
    let d10 = observe_d10_fixture_canary_lease(30805, d10_token)
    assert(d10.lease_id == 30821 && d10.evidence_id == 30301)
    assert(d10.artifact_id == 30412 && d10.site_id == 30461)
    assert(d10.canary_only && !d10.production_authority)
    let source_mass_code = ((3 * 31 + 3) * 31 + 3) * 31 + 3
    let target_mass_code = ((6 * 31 + 2) * 31 + 2) * 31 + 2
    let loss_code = ((1 * 31 + 0) * 31 + 0) * 31 + 0
    let joint_law_fingerprint =
        (source_mass_code * 1000003 + target_mass_code) * 1000003 + loss_code
    assert(source_mass_code == 92352 && target_mass_code == 180732)
    assert(loss_code == 29791)
    assert(joint_law_fingerprint == 92352734845403155)
    D11LabeledExactJointFixtureToken {
        fixture_run_id: 31911,
        warrant_id: 31100,
        d10_lease_id: d10.lease_id,
        d10_evidence_id: d10.evidence_id,
        joint_fixture_id: 31131,
        joint_law_fingerprint: joint_law_fingerprint,
        evidence_window_id: 31121,
        monitoring_epoch: 1,
        model_version_id: d10.artifact_id,
        site_id: d10.site_id,
        workflow_version_id: 30471,
        source_population_id: 31111,
        target_population_id: 31112,
        label_probe_id: 31311,
        loss_id: 31711,
        group_plan_id: 31512,
        calibrator_version_id: 30413,
        diagnostic_score_policy_id: 31621,
        common_mass_denominator: 12,
        source_mass_0: 3,
        source_mass_1: 3,
        source_mass_2: 3,
        source_mass_3: 3,
        target_mass_0: 6,
        target_mass_1: 2,
        target_mass_2: 2,
        target_mass_3: 2,
        loss_0: 1,
        loss_1: 0,
        loss_2: 0,
        loss_3: 0,
        coarse_cell_0: 0,
        coarse_cell_1: 1,
        coarse_cell_2: 1,
        coarse_cell_3: 1,
        label_0: 0,
        label_1: 1,
        label_2: 1,
        label_3: 1,
        probe_confusion_00: 1,
        probe_confusion_01: 0,
        probe_confusion_10: 0,
        probe_confusion_11: 1,
        diagnostic_score_a_numerator: 1,
        diagnostic_score_b_numerator: 1,
        diagnostic_score_denominator: 4,
        active_score_a_numerator: 1,
        active_score_b_numerator: 0,
        active_score_denominator: 1,
        positive_group_a_case_count: 6,
        positive_group_a_error_count: 3,
        positive_group_b_case_count: 6,
        positive_group_b_error_count: 3,
    }
}

pub fn certify_d11_fixture_scope_subset(
    law: D11LabeledExactJointFixtureToken,
) -> D11FixtureScopeSubsetToken with Panic {
    validate_d11_labeled_exact_joint_fixture(law)
    let token = D11FixtureScopeSubsetToken {
        fixture_run_id: law.fixture_run_id,
        source_population_id: law.source_population_id,
        target_population_id: law.target_population_id,
        scope_universe_id: 31140,
        source_scope_id: 31141,
        target_scope_id: 31142,
        source_scope_count: 8,
        target_scope_count: 4,
        source_member_0: 3114101,
        source_member_1: 3114102,
        source_member_2: 3114103,
        source_member_3: 3114104,
        source_member_4: 3114105,
        source_member_5: 3114106,
        source_member_6: 3114107,
        source_member_7: 3114108,
        target_member_0: 3114101,
        target_member_1: 3114102,
        target_member_2: 3114103,
        target_member_3: 3114104,
        subset_membership_count: 4,
    }
    assert(token.source_member_0 < token.source_member_1)
    assert(token.source_member_1 < token.source_member_2)
    assert(token.source_member_2 < token.source_member_3)
    assert(token.source_member_3 < token.source_member_4)
    assert(token.source_member_4 < token.source_member_5)
    assert(token.source_member_5 < token.source_member_6)
    assert(token.source_member_6 < token.source_member_7)
    assert(token.target_member_0 < token.target_member_1)
    assert(token.target_member_1 < token.target_member_2)
    assert(token.target_member_2 < token.target_member_3)
    assert(token.target_member_0 == token.source_member_0)
    assert(token.target_member_1 == token.source_member_1)
    assert(token.target_member_2 == token.source_member_2)
    assert(token.target_member_3 == token.source_member_3)
    token
}

pub fn observe_d11_d10_source_boundary(
    receipt_id: i64,
) -> D11D10BoundaryObservationReceipt with Panic {
    assert(receipt_id == 31101)
    let d10_token = replay_d10_complete_fixture_canary()
    let d10 = observe_d10_fixture_canary_lease(30805, d10_token)
    assert(d10.lease_id == 30821 && d10.evidence_id == 30301)
    assert(d10.artifact_id == 30412 && d10.site_id == 30461)
    assert(d10.canary_only && !d10.production_authority)
    assert(!d10.clinical_action_authority)
    D11D10BoundaryObservationReceipt {
        receipt_id: receipt_id,
        d10_lease_id: d10.lease_id,
        d10_evidence_id: d10.evidence_id,
        model_version_id: d10.artifact_id,
        site_id: d10.site_id,
        source_population_id: 31111,
        target_population_id: 31112,
        source_scope_count: 8,
        target_scope_count: 4,
        d10_attests_d11_scope_subset: false,
        canary_only: true,
        production_authority: false,
        clinical_action_authority: false,
        public_observation_is_authority: false,
    }
}

