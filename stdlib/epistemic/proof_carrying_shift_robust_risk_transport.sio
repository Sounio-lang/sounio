pub fn certify_d11_label_transport(
    law: D11LabeledExactJointFixtureToken,
) -> D11LabelTransportToken with Panic {
    validate_d11_labeled_exact_joint_fixture(law)
    let observation = observe_d11_label_shift_transport(31301)
    assert(observation.source_prior_y0 == law.source_mass_0)
    assert(observation.source_prior_y1 == law.source_mass_1 +
        law.source_mass_2 + law.source_mass_3)
    assert(observation.target_prior_y0 == law.target_mass_0)
    assert(observation.target_prior_y1 == law.target_mass_1 +
        law.target_mass_2 + law.target_mass_3)
    assert(observation.prior_denominator == law.common_mass_denominator)
    assert(observation.weight_y0_numerator * law.source_mass_0 ==
        law.target_mass_0 * observation.weight_y0_denominator)
    assert(observation.weight_y1_numerator * observation.source_prior_y1 ==
        observation.target_prior_y1 * observation.weight_y1_denominator)
    assert(observation.source_risk_numerator * law.common_mass_denominator ==
        law.source_mass_0 * observation.source_risk_denominator)
    assert(observation.target_risk_numerator * law.common_mass_denominator ==
        law.target_mass_0 * observation.target_risk_denominator)
    assert(observation.weighted_source_risk_numerator *
        observation.target_risk_denominator ==
        observation.target_risk_numerator *
        observation.weighted_source_risk_denominator)
    let probe_determinant = law.probe_confusion_00 *
        law.probe_confusion_11 - law.probe_confusion_01 *
        law.probe_confusion_10
    assert(observation.confusion_determinant == probe_determinant)
    assert(observation.joint_law_fingerprint == law.joint_law_fingerprint)
    assert(observation.label_probe_id == law.label_probe_id)
    assert(observation.evaluated_loss_id == law.loss_id)
    assert(observation.confusion_determinant == 1)
    assert(observation.class_conditional_law_invariant)
    assert(observation.target_prior_identified)
    D11LabelTransportToken {
        evidence_id: observation.receipt_id,
        joint_fixture_id: law.joint_fixture_id,
        evidence_window_id: law.evidence_window_id,
        model_version_id: law.model_version_id,
        source_population_id: law.source_population_id,
        target_population_id: law.target_population_id,
        target_risk_numerator: observation.target_risk_numerator,
        target_risk_denominator: observation.target_risk_denominator,
        fixture_run_id: law.fixture_run_id,
        joint_law_fingerprint: law.joint_law_fingerprint,
        label_probe_id: law.label_probe_id,
        loss_id: law.loss_id,
    }
}

