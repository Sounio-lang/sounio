pub fn certify_d11_target_local_calibration(
    law: D11LabeledExactJointFixtureToken,
) -> D11TargetLocalCalibrationToken with Panic {
    validate_d11_labeled_exact_joint_fixture(law)
    let observation = observe_d11_target_local_calibration(31603)
    assert(observation.target_cell_a_prediction_numerator ==
        law.active_score_a_numerator)
    assert(observation.target_cell_b_prediction_numerator ==
        law.active_score_b_numerator)
    assert(observation.common_denominator == law.active_score_denominator)
    assert(observation.target_cell_a_outcome_numerator == law.loss_0)
    assert(observation.target_cell_b_outcome_numerator == law.loss_1)
    assert(observation.target_cell_a_residual_numerator ==
        observation.target_cell_a_outcome_numerator -
        observation.target_cell_a_prediction_numerator)
    assert(observation.target_cell_b_residual_numerator ==
        observation.target_cell_b_outcome_numerator -
        observation.target_cell_b_prediction_numerator)
    assert(observation.baseline_joint_law_fingerprint ==
        law.joint_law_fingerprint)
    assert(observation.calibrator_version_id == law.calibrator_version_id)
    assert(observation.target_local_calibration_established)
    assert(observation.declared_two_cell_class_only)
    assert(!observation.universal_calibration_claimed)
    D11TargetLocalCalibrationToken {
        evidence_id: observation.receipt_id,
        evidence_window_id: law.evidence_window_id,
        model_version_id: law.model_version_id,
        target_population_id: law.target_population_id,
        calibrator_version_id: law.calibrator_version_id,
        fixture_run_id: law.fixture_run_id,
        joint_law_fingerprint: law.joint_law_fingerprint,
    }
}

pub fn observe_d11_active_calibrator_drift(
    receipt_id: i64,
) -> D11ActiveCalibratorDriftObservationReceipt with Panic {
    assert(receipt_id == 31604)
    // The active score (1,0) meets outcomes (0,0) in the later labeled snapshot.
    let residual_scaled = 6 * (0 - 1) + 6 * (0 - 0)
    assert(residual_scaled == -6)
    D11ActiveCalibratorDriftObservationReceipt {
        receipt_id: receipt_id,
        fixture_run_id: 31911,
        baseline_joint_law_fingerprint: 92352734845403155,
        later_snapshot_fingerprint: 3162401,
        model_version_id: 30412,
        site_id: 30461,
        workflow_version_id: 30471,
        target_population_id: 31112,
        loss_id: 31711,
        calibrator_version_id: 30413,
        prior_window_id: 31121,
        monitoring_window_id: 31122,
        prior_epoch: 1,
        monitoring_epoch: 2,
        target_residual_numerator: -1,
        target_residual_denominator: 2,
        calibration_threshold_numerator: 1,
        calibration_threshold_denominator: 4,
        threshold_breached: true,
        automatic_recalibration_authorized: false,
    }
}

