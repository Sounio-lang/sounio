pub fn bind_d11_complete_target_evidence(
    source: D11SourceCanaryBoundToken,
    law: D11LabeledExactJointFixtureToken,
    scope_token: D11FixtureScopeSubsetToken,
    covariate: D11CovariateTransportToken,
    label: D11LabelTransportToken,
    concept: D11ConceptStabilityToken,
    subgroup: D11SubgroupRiskBoundToken,
    calibration: D11TargetLocalCalibrationToken,
    risk: D11ShiftRobustTargetRiskToken,
) -> D11TargetEvidenceBoundToken with Panic {
    validate_d11_labeled_exact_joint_fixture(law)
    assert(source.fixture_run_id == law.fixture_run_id)
    assert(source.warrant_id == 31100 && source.d10_lease_id == 30821)
    assert(source.d10_evidence_id == law.d10_evidence_id)
    assert(source.model_version_id == 30412 && source.site_id == 30461)
    assert(source.workflow_version_id == 30471)
    assert(source.source_population_id == 31111)
    assert(source.scope_universe_id == scope_token.scope_universe_id)
    assert(source.source_scope_id == scope_token.source_scope_id)
    assert(source.source_scope_count == 8 && source.authority_rank == 3)
    assert(scope_token.fixture_run_id == law.fixture_run_id)
    assert(scope_token.source_population_id == source.source_population_id)
    assert(scope_token.target_population_id == law.target_population_id)
    assert(scope_token.source_scope_count == source.source_scope_count)
    assert(scope_token.target_scope_count == 4 && scope_token.subset_membership_count == 4)
    assert(scope_token.target_member_0 == scope_token.source_member_0)
    assert(scope_token.target_member_1 == scope_token.source_member_1)
    assert(scope_token.target_member_2 == scope_token.source_member_2)
    assert(scope_token.target_member_3 == scope_token.source_member_3)
    assert(covariate.joint_fixture_id == 31131)
    assert(label.joint_fixture_id == covariate.joint_fixture_id)
    assert(concept.joint_fixture_id == covariate.joint_fixture_id)
    assert(risk.joint_fixture_id == covariate.joint_fixture_id)
    assert(covariate.joint_law_fingerprint == law.joint_law_fingerprint)
    assert(label.joint_law_fingerprint == law.joint_law_fingerprint)
    assert(concept.joint_law_fingerprint == law.joint_law_fingerprint)
    assert(subgroup.joint_law_fingerprint == law.joint_law_fingerprint)
    assert(calibration.joint_law_fingerprint == law.joint_law_fingerprint)
    assert(risk.joint_law_fingerprint == law.joint_law_fingerprint)
    assert(covariate.fixture_run_id == law.fixture_run_id)
    assert(label.fixture_run_id == law.fixture_run_id)
    assert(concept.fixture_run_id == law.fixture_run_id)
    assert(subgroup.fixture_run_id == law.fixture_run_id)
    assert(calibration.fixture_run_id == law.fixture_run_id)
    assert(risk.fixture_run_id == law.fixture_run_id)
    assert(covariate.evidence_window_id == 31121)
    assert(label.evidence_window_id == covariate.evidence_window_id)
    assert(concept.evidence_window_id == covariate.evidence_window_id)
    assert(subgroup.evidence_window_id == covariate.evidence_window_id)
    assert(calibration.evidence_window_id == covariate.evidence_window_id)
    assert(risk.evidence_window_id == covariate.evidence_window_id)
    assert(covariate.model_version_id == source.model_version_id)
    assert(label.model_version_id == source.model_version_id)
    assert(concept.model_version_id == source.model_version_id)
    assert(subgroup.model_version_id == source.model_version_id)
    assert(calibration.model_version_id == source.model_version_id)
    assert(risk.model_version_id == source.model_version_id)
    assert(covariate.source_population_id == source.source_population_id)
    assert(label.source_population_id == source.source_population_id)
    assert(concept.source_population_id == source.source_population_id)
    assert(covariate.target_population_id == 31112)
    assert(label.target_population_id == covariate.target_population_id)
    assert(concept.target_population_id == covariate.target_population_id)
    assert(subgroup.target_population_id == covariate.target_population_id)
    assert(calibration.target_population_id == covariate.target_population_id)
    assert(risk.target_population_id == covariate.target_population_id)
    assert(covariate.loss_id == law.loss_id)
    assert(label.loss_id == law.loss_id && label.label_probe_id == law.label_probe_id)
    assert(concept.loss_id == law.loss_id)
    assert(subgroup.loss_id == law.loss_id)
    assert(risk.loss_id == law.loss_id)
    assert(concept.target_label_count == 12)
    assert(subgroup.group_plan_id == 31512)
    assert(subgroup.worst_risk_numerator == 1)
    assert(subgroup.worst_risk_denominator == 2)
    assert(calibration.calibrator_version_id == 30413)
    assert(risk.target_bound_numerator == 1)
    assert(risk.target_bound_denominator == 2)
    D11TargetEvidenceBoundToken {
        fixture_run_id: law.fixture_run_id,
        warrant_id: source.warrant_id,
        d10_lease_id: source.d10_lease_id,
        joint_fixture_id: covariate.joint_fixture_id,
        evidence_window_id: covariate.evidence_window_id,
        model_version_id: source.model_version_id,
        site_id: source.site_id,
        workflow_version_id: source.workflow_version_id,
        source_population_id: source.source_population_id,
        target_population_id: covariate.target_population_id,
        loss_id: risk.loss_id,
        group_plan_id: subgroup.group_plan_id,
        calibrator_version_id: calibration.calibrator_version_id,
        source_scope_count: source.source_scope_count,
        target_scope_count: 4,
        authority_rank: source.authority_rank,
        evidence_epoch: source.epoch,
        dimension_count: 6,
        d10_evidence_id: source.d10_evidence_id,
        joint_law_fingerprint: law.joint_law_fingerprint,
        label_probe_id: law.label_probe_id,
        diagnostic_score_policy_id: law.diagnostic_score_policy_id,
        scope_universe_id: scope_token.scope_universe_id,
        source_scope_id: scope_token.source_scope_id,
        target_scope_id: scope_token.target_scope_id,
        subset_membership_count: scope_token.subset_membership_count,
    }
}

