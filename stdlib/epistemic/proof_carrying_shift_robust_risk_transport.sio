pub fn certify_d11_source_conformal_risk(
    law: D11LabeledExactJointFixtureToken,
) -> D11SourceConformalRiskToken with Panic {
    validate_d11_labeled_exact_joint_fixture(law)
    let observation = observe_d11_source_conformal_risk(31701)
    assert(observation.loss_0 == law.loss_0)
    assert(observation.loss_1 == law.loss_1)
    assert(observation.loss_2 == law.loss_2)
    assert(observation.loss_3 == law.loss_3)
    assert(observation.source_mass_0 == law.source_mass_0)
    assert(observation.source_mass_1 == law.source_mass_1)
    assert(observation.source_mass_2 == law.source_mass_2)
    assert(observation.source_mass_3 == law.source_mass_3)
    assert(observation.source_risk_numerator * law.common_mass_denominator ==
        law.source_mass_0 * observation.source_risk_denominator)
    assert(observation.loss_bound == 1)
    assert(observation.source_exchangeable_fixture)
    assert(!observation.target_risk_established)
    assert(!observation.general_conformal_theorem)
    D11SourceConformalRiskToken {
        evidence_id: observation.receipt_id,
        evidence_window_id: law.evidence_window_id,
        model_version_id: law.model_version_id,
        source_population_id: law.source_population_id,
        loss_id: law.loss_id,
        source_risk_numerator: observation.source_risk_numerator,
        source_risk_denominator: observation.source_risk_denominator,
        fixture_run_id: law.fixture_run_id,
        joint_fixture_id: law.joint_fixture_id,
        joint_law_fingerprint: law.joint_law_fingerprint,
    }
}

pub fn certify_d11_joint_tv_radius(
    law: D11LabeledExactJointFixtureToken,
) -> D11JointTVRadiusToken with Panic {
    validate_d11_labeled_exact_joint_fixture(law)
    let observation = observe_d11_given_joint_tv_radius(31702)
    assert(observation.source_mass_0 == law.source_mass_0)
    assert(observation.source_mass_1 == law.source_mass_1)
    assert(observation.source_mass_2 == law.source_mass_2)
    assert(observation.source_mass_3 == law.source_mass_3)
    assert(observation.target_mass_0 == law.target_mass_0)
    assert(observation.target_mass_1 == law.target_mass_1)
    assert(observation.target_mass_2 == law.target_mass_2)
    assert(observation.target_mass_3 == law.target_mass_3)
    assert(observation.common_mass_denominator == law.common_mass_denominator)
    assert(observation.l1_difference_numerator * law.common_mass_denominator ==
        6 * observation.l1_difference_denominator)
    assert(observation.tv_radius_numerator * 2 *
        observation.l1_difference_denominator ==
        observation.l1_difference_numerator * observation.tv_radius_denominator)
    assert(observation.given_joint_radius)
    assert(!observation.estimated_point_only)
    assert(observation.tv_radius_numerator == 1)
    D11JointTVRadiusToken {
        evidence_id: observation.receipt_id,
        joint_fixture_id: law.joint_fixture_id,
        evidence_window_id: law.evidence_window_id,
        source_population_id: law.source_population_id,
        target_population_id: law.target_population_id,
        radius_numerator: observation.tv_radius_numerator,
        radius_denominator: observation.tv_radius_denominator,
        fixture_run_id: law.fixture_run_id,
        joint_law_fingerprint: law.joint_law_fingerprint,
        model_version_id: law.model_version_id,
        loss_id: law.loss_id,
    }
}

