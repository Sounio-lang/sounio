pub fn bind_d11_nominal_trace(
    continuation: D11TargetCanaryContinuationToken,
    degraded: D11DegradedCanaryToken,
    suspended: D11SuspendedCanaryToken,
    revoked: D11RevokedCanaryToken,
) -> D11NominalTraceToken with Panic {
    assert(continuation.warrant_id == 31100)
    assert(continuation.fixture_run_id == 31911)
    assert(degraded.warrant_id == continuation.warrant_id)
