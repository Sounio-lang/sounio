pub fn certify_d11_concept_stability(
    law: D11LabeledExactJointFixtureToken,
) -> D11ConceptStabilityToken with Panic {
    validate_d11_labeled_exact_joint_fixture(law)
    let observation = observe_d11_concept_stability(31401)
    assert(observation.source_input_a_count == law.source_mass_0)
    assert(observation.source_input_b_count == law.source_mass_1 +
        law.source_mass_2 + law.source_mass_3)
    assert(observation.target_input_a_count == law.target_mass_0)
    assert(observation.target_input_b_count == law.target_mass_1 +
        law.target_mass_2 + law.target_mass_3)
    assert(observation.target_label_count == law.target_mass_0 +
        law.target_mass_1 + law.target_mass_2 + law.target_mass_3)
    assert(observation.source_risk_numerator * law.common_mass_denominator ==
        law.source_mass_0 * observation.source_risk_denominator)
    assert(observation.target_risk_numerator * law.common_mass_denominator ==
        law.target_mass_0 * observation.target_risk_denominator)
    assert(observation.joint_law_fingerprint == law.joint_law_fingerprint)
    assert(observation.loss_id == law.loss_id)
    assert(observation.target_label_count == 12)
    assert(observation.conditional_law_invariant)
    assert(!observation.unlabeled_only)
    D11ConceptStabilityToken {
        evidence_id: observation.receipt_id,
        joint_fixture_id: law.joint_fixture_id,
        evidence_window_id: law.evidence_window_id,
        model_version_id: law.model_version_id,
        source_population_id: law.source_population_id,
        target_population_id: law.target_population_id,
        target_label_count: observation.target_label_count,
        fixture_run_id: law.fixture_run_id,
        joint_law_fingerprint: law.joint_law_fingerprint,
        loss_id: law.loss_id,
    }
}

