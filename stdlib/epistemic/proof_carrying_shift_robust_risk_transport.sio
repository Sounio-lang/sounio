        target_point_risk_identified: false,
    }
}

pub fn certify_d11_covariate_transport(
    law: D11LabeledExactJointFixtureToken,
) -> D11CovariateTransportToken with Panic {
    validate_d11_labeled_exact_joint_fixture(law)
    let observation = observe_d11_covariate_shift_transport(31201)
    assert(observation.source_population_id == law.source_population_id)
    assert(observation.target_population_id == law.target_population_id)
    assert(observation.source_mass_a == law.source_mass_0)
    assert(observation.source_mass_b == law.source_mass_1 +
        law.source_mass_2 + law.source_mass_3)
    assert(observation.target_mass_a == law.target_mass_0)
    assert(observation.target_mass_b == law.target_mass_1 +
        law.target_mass_2 + law.target_mass_3)
    assert(observation.mass_denominator == law.common_mass_denominator)
    assert(observation.weight_a_numerator * law.source_mass_0 ==
        law.target_mass_0 * observation.weight_a_denominator)
    assert(observation.weight_b_numerator * observation.source_mass_b ==
        observation.target_mass_b * observation.weight_b_denominator)
    assert(observation.source_risk_numerator * law.common_mass_denominator ==
        law.source_mass_0 * observation.source_risk_denominator)
    assert(observation.target_risk_numerator * law.common_mass_denominator ==
        law.target_mass_0 * observation.target_risk_denominator)
    assert(observation.weighted_source_risk_numerator *
        observation.target_risk_denominator ==
        observation.target_risk_numerator *
        observation.weighted_source_risk_denominator)
    assert(observation.joint_law_fingerprint == law.joint_law_fingerprint)
    assert(observation.loss_id == law.loss_id)
    assert(observation.conditional_law_invariant)
    assert(observation.overlap_established)
    assert(observation.exact_for_two_cells)
    assert(observation.target_risk_numerator == 1)
    D11CovariateTransportToken {
        evidence_id: observation.receipt_id,
        joint_fixture_id: law.joint_fixture_id,
        evidence_window_id: law.evidence_window_id,
        model_version_id: law.model_version_id,
        source_population_id: observation.source_population_id,
        target_population_id: observation.target_population_id,
        target_risk_numerator: observation.target_risk_numerator,
        target_risk_denominator: observation.target_risk_denominator,
        fixture_run_id: law.fixture_run_id,
        joint_law_fingerprint: law.joint_law_fingerprint,
        loss_id: law.loss_id,
    }
}

