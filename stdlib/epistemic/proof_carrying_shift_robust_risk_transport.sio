// Type-level seal: the `receipt_id` field is a distinct issuer-only token type,
// not a bare i64. Forging a receipt with a plain integer (`{ receipt_id: 1 }`)
// is therefore a TYPE error (E009), which BOTH `souc check` and `souc compile`
// reject — unlike constructor-privacy (E176), which only `check` enforces and
// which Sounio's own stdlib violates (math::sedenion builds math::octonion's
// non-pub Octonion cross-module). See audit 2026-07-25.
// The receipt types are `pub` (nameable by importers) but their `receipt_id`
// field is the NON-pub seal type `D11ReceiptSeal`. So a naive forge
// `{ receipt_id: 1 }` is a TYPE mismatch (E009: i64 vs D11ReceiptSeal) that
// BOTH verbs reject — not a constructor-privacy error (E176), which only
// `check` enforces and which stdlib itself violates. Making the receipt pub
// stops E176 from preempting the E009 under `check`, so both verbs agree.
enum D11ReceiptSeal {}
pub struct D11ExternalTransportValidationReceipt { receipt_id: D11ReceiptSeal }
pub struct D11NoShiftReceipt { receipt_id: D11ReceiptSeal }
pub struct D11ProductionDeploymentAuthorityReceipt { receipt_id: D11ReceiptSeal }
pub struct D11PatientStateReceipt { receipt_id: D11ReceiptSeal }
pub struct D11ClinicalActionAuthorityReceipt { receipt_id: D11ReceiptSeal }
pub struct D11InstitutionalRevocationAuthorityReceipt { receipt_id: D11ReceiptSeal }

