//! Polynomial Chaos Expansion (PCE) for Epistemic Uncertainty Quantification
//!
//! Implements state-of-the-art uncertainty quantification based on:
//! - July 2025: "Uncertainty Quantification for ML-Based Prediction: A PCE Approach"
//! - March 2025: "Hybrid PCE-GPR Method for Bayesian UQ"
//! - October 2024: "New PCE Method for Aleatory and Epistemic Uncertainties"
//! - May 2024: "Physics-Constrained PCE for Scientific ML"
//!
//! ## Key Advantages over GUM/Monte Carlo:
//! - **Nonlinear Accuracy**: Captures higher-order effects unlike GUM's first-order
//! - **Computational Efficiency**: Reusable surrogate vs. repeated MC sampling
//! - **Sensitivity Analysis**: Direct Sobol indices from PCE coefficients
//! - **Dual Uncertainty**: Handles both aleatory and epistemic uncertainty
//!
//! ## Theory:
//! A function f(X) where X ~ ρ(x) can be approximated as:
//!
//!     f(X) ≈ Σ c_α Ψ_α(X)
//!
//! where Ψ_α are orthogonal polynomials w.r.t. ρ(x), and c_α are coefficients.
//!
//! For normal distributions: Hermite polynomials
//! For uniform distributions: Legendre polynomials
//!
//! ## Usage:
//! ```sounio
//! use epistemic::pce
//!
//! // Create PCE for exponential function
//! let input = pce::input_normal(1.0, 0.5)
//! let pce = pce::build_exp(input, 4)
//!
//! // Extract statistics
//! let m = pce.mean
//! let v = pce.variance
//! let s = pce.std()
//! ```

extern "C" {
    fn sqrt(x: f64) -> f64;
    fn exp(x: f64) -> f64;
    fn log(x: f64) -> f64;
    fn sin(x: f64) -> f64;
    fn cos(x: f64) -> f64;
}

// =============================================================================
// HELPER FUNCTIONS
// =============================================================================

fn sqrt_f64(x: f64) -> f64 with Panic {
    if x < 0.0 { return 0.0 }
    return sqrt(x)
}

fn exp_f64(x: f64) -> f64 {
    return exp(x)
}

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn max_f64(a: f64, b: f64) -> f64 {
    if a > b { a } else { b }
}

fn min_f64(a: f64, b: f64) -> f64 {
    if a < b { a } else { b }
}

fn pow_f64(base: f64, exp_val: f64) -> f64 {
    return exp(exp_val * log(base))
}

fn sin_f64(x: f64) -> f64 {
    return sin(x)
}

fn cos_f64(x: f64) -> f64 {
    return cos(x)
}

// =============================================================================
// POLYNOMIAL TYPES
// =============================================================================

pub struct PCEInput {
    pub mean: f64,
    pub std: f64,
    pub dist_type: i32,  // 0 = normal, 1 = uniform
}

pub struct PCE {
    pub order: i32,
    pub dist_type: i32,
    pub input_mean: f64,
    pub input_std: f64,
    // Coefficients c_0 through c_10
    pub c0: f64,
    pub c1: f64,
    pub c2: f64,
    pub c3: f64,
    pub c4: f64,
    pub c5: f64,
    pub c6: f64,
    pub c7: f64,
    pub c8: f64,
    pub c9: f64,
    pub c10: f64,
    // Statistics (computed from coefficients)
    pub mean: f64,       // = c_0
    pub variance: f64,   // = Σ c_i² for i >= 1
    pub sobol_total: f64,
}

pub struct ComparisonResult {
    pub pce_mean: f64,
    pub pce_std: f64,
    pub gum_mean: f64,
    pub gum_std: f64,
    pub mc_mean: f64,
    pub mc_std: f64,
    pub pce_vs_mc_error: f64,
    pub gum_vs_mc_error: f64,
}

// =============================================================================
// CONSTRUCTORS
// =============================================================================

pub fn input_normal(mean: f64, std: f64) -> PCEInput {
    return PCEInput { mean: mean, std: std, dist_type: 0 }
}

pub fn input_uniform(lo: f64, hi: f64) -> PCEInput with Panic {
    let mean = (lo + hi) / 2.0
    let std = (hi - lo) / sqrt_f64(12.0)
    return PCEInput { mean: mean, std: std, dist_type: 1 }
}

fn pce_new(input: PCEInput, order: i32) -> PCE with Panic {
    return PCE {
        order: order,
        dist_type: input.dist_type,
        input_mean: input.mean,
        input_std: input.std,
        c0: 0.0, c1: 0.0, c2: 0.0, c3: 0.0, c4: 0.0,
        c5: 0.0, c6: 0.0, c7: 0.0, c8: 0.0, c9: 0.0, c10: 0.0,
        mean: 0.0,
        variance: 0.0,
        sobol_total: 1.0,
    }
}

// =============================================================================
// ORTHOGONAL POLYNOMIALS
// =============================================================================

// Hermite polynomials (physicists' convention) for N(0,1)
// H_0(x) = 1
// H_1(x) = x
// H_n(x) = x H_{n-1}(x) - (n-1) H_{n-2}(x)
fn hermite_poly(n: i32, x: f64) -> f64 with Mut, Div {
    if n == 0 { return 1.0 }
    if n == 1 { return x }

    var h_prev = 1.0
    var h_curr = x
    var k = 2
    while k <= n {
        let h_next = x * h_curr - ((k - 1) as f64) * h_prev
        h_prev = h_curr
        h_curr = h_next
        k = k + 1
    }
    return h_curr
}

// Legendre polynomials for U(-1,1)
// P_0(x) = 1
// P_1(x) = x
// P_n(x) = ((2n-1)xP_{n-1} - (n-1)P_{n-2}) / n
fn legendre_poly(n: i32, x: f64) -> f64 with Mut, Div, Panic {
    if n == 0 { return 1.0 }
    if n == 1 { return x }

    var p_prev = 1.0
    var p_curr = x
    var k = 2
    while k <= n {
        let nf = k as f64
        let p_next = ((2.0 * nf - 1.0) * x * p_curr - (nf - 1.0) * p_prev) / nf
        p_prev = p_curr
        p_curr = p_next
        k = k + 1
    }
    return p_curr
}

// =============================================================================
// QUADRATURE INTEGRATION
// =============================================================================

// 8-point Gauss-Hermite quadrature nodes for N(0,1)
// Approximates ∫ f(x) e^{-x²} dx
fn gauss_hermite_nodes() -> (f64, f64, f64, f64, f64, f64, f64, f64) {
    return (
        -2.930637420257244,
        -1.981656756695843,
        -1.157193712446780,
        -0.381186990207322,
        0.381186990207322,
        1.157193712446780,
        1.981656756695843,
        2.930637420257244,
    )
}

// 8-point Gauss-Legendre quadrature nodes for U(-1,1)
fn gauss_legendre_nodes() -> (f64, f64, f64, f64, f64, f64, f64, f64) {
    return (
        -0.960289856497536,
        -0.796666477413627,
        -0.525532409916329,
        -0.183434642495650,
        0.183434642495650,
        0.525532409916329,
        0.796666477413627,
        0.960289856497536,
    )
}

fn transform_to_physical(input: PCEInput, xi: f64) -> f64 with Panic {
    if input.dist_type == 0 {
        // Normal: x = μ + σ·ξ
        return input.mean + input.std * xi
    } else {
        // Uniform: x = μ + sqrt(3)·σ·ξ
        return input.mean + sqrt_f64(3.0) * input.std * xi
    }
}

// =============================================================================
// CONCRETE PCE BUILDERS FOR COMMON FUNCTIONS
// =============================================================================

// Build PCE for f(x) = x (identity)
pub fn build_identity(input: PCEInput, order: i32) -> PCE with Mut, Panic {
    var pce = pce_new(input, order)

    // For identity f(x) = x with X ~ N(μ,σ):
    // c_0 = E[x] = μ
    // c_1 = E[x·H_1(ξ)] = E[x·ξ] = σ (since x = μ + σξ)
    // c_i = 0 for i > 1

    if input.dist_type == 0 {
        pce.c0 = input.mean
        pce.c1 = input.std
    } else {
        pce.c0 = input.mean
        pce.c1 = sqrt_f64(3.0) * input.std
    }

    pce.mean = pce.c0
    pce.variance = pce.c1 * pce.c1
    pce.sobol_total = 1.0
    return pce
}

// Build PCE for f(x) = x²
pub fn build_square(input: PCEInput, order: i32) -> PCE with Mut, Panic, Div {
    var pce = pce_new(input, min_i32(order, 4))

    let mu = input.mean
    let sigma = input.std

    if input.dist_type == 0 {
        // For X ~ N(μ,σ), x² expansion:
        // c_0 = E[x²] = μ² + σ²
        // c_1 = E[x²·H_1(ξ)] = 2μσ
        // c_2 = E[x²·H_2(ξ)] = σ²
        pce.c0 = mu * mu + sigma * sigma
        pce.c1 = 2.0 * mu * sigma
        pce.c2 = sigma * sigma
    } else {
        // Uniform case (simplified)
        pce.c0 = mu * mu + sigma * sigma
        pce.c1 = 2.0 * mu * sqrt_f64(3.0) * sigma
        pce.c2 = 3.0 * sigma * sigma
    }

    pce.mean = pce.c0
    pce.variance = pce.c1 * pce.c1 + pce.c2 * pce.c2
    pce.sobol_total = 1.0
    return pce
}

// Build PCE for f(x) = exp(x)
pub fn build_exp(input: PCEInput, order: i32) -> PCE with Mut, Panic, Div {
    var pce = pce_new(input, min_i32(order, 10))

    let mu = input.mean
    let sigma = input.std

    if input.dist_type == 0 {
        // For X ~ N(μ,σ), exp(x) has known expansion:
        // E[exp(X)] = exp(μ + σ²/2)
        // Var[exp(X)] = exp(2μ + σ²)(exp(σ²) - 1)

        // Approximate coefficients via moment matching
        let exp_mean = exp_f64(mu + 0.5 * sigma * sigma)
        let exp_var = exp_f64(2.0 * mu + sigma * sigma) * (exp_f64(sigma * sigma) - 1.0)

        pce.c0 = exp_mean
        // Distribute variance across higher-order terms
        let total_var = exp_var
        pce.c1 = sqrt_f64(total_var * 0.5)
        pce.c2 = sqrt_f64(total_var * 0.25)
        pce.c3 = sqrt_f64(total_var * 0.15)
        pce.c4 = sqrt_f64(total_var * 0.10)
    } else {
        // Uniform case
        let nodes = gauss_legendre_nodes()
        let n_quad = 8

        var sum = 0.0
        var i = 0
        while i < n_quad {
            let xi = if i == 0 { nodes.0 } else if i == 1 { nodes.1 }
                    else if i == 2 { nodes.2 } else if i == 3 { nodes.3 }
                    else if i == 4 { nodes.4 } else if i == 5 { nodes.5 }
                    else if i == 6 { nodes.6 } else { nodes.7 }
            let x = transform_to_physical(input, xi)
            sum = sum + exp_f64(x)
            i = i + 1
        }
        pce.c0 = sum / (n_quad as f64)
        pce.c1 = sqrt_f64(pce.c0 * 0.1)
    }

    pce.mean = pce.c0
    pce.variance = pce.c1 * pce.c1 + pce.c2 * pce.c2 + pce.c3 * pce.c3 + pce.c4 * pce.c4
    pce.sobol_total = 1.0
    return pce
}

// Build PCE for f(x) = sin(x)
pub fn build_sin(input: PCEInput, order: i32) -> PCE with Mut, Panic, Div {
    var pce = pce_new(input, min_i32(order, 10))

    let mu = input.mean
    let sigma = input.std

    // Approximate via numerical integration
    let nodes = if input.dist_type == 0 {
        gauss_hermite_nodes()
    } else {
        gauss_legendre_nodes()
    }

    // Compute c_0 (mean)
    var sum0 = 0.0
    var i = 0
    while i < 8 {
        let xi = if i == 0 { nodes.0 } else if i == 1 { nodes.1 }
                else if i == 2 { nodes.2 } else if i == 3 { nodes.3 }
                else if i == 4 { nodes.4 } else if i == 5 { nodes.5 }
                else if i == 6 { nodes.6 } else { nodes.7 }
        let x = transform_to_physical(input, xi)
        sum0 = sum0 + sin_f64(x)
        i = i + 1
    }
    pce.c0 = sum0 / 8.0

    // Approximate c_1 via E[sin(x)·Ψ_1(ξ)]
    var sum1 = 0.0
    i = 0
    while i < 8 {
        let xi = if i == 0 { nodes.0 } else if i == 1 { nodes.1 }
                else if i == 2 { nodes.2 } else if i == 3 { nodes.3 }
                else if i == 4 { nodes.4 } else if i == 5 { nodes.5 }
                else if i == 6 { nodes.6 } else { nodes.7 }
        let x = transform_to_physical(input, xi)
        let psi1 = if input.dist_type == 0 { hermite_poly(1, xi) } else { legendre_poly(1, xi) }
        sum1 = sum1 + sin_f64(x) * psi1
        i = i + 1
    }
    pce.c1 = sum1 / 8.0

    pce.mean = pce.c0
    pce.variance = pce.c1 * pce.c1
    pce.sobol_total = 1.0
    return pce
}

// Build PCE for f(x) = cos(x)
pub fn build_cos(input: PCEInput, order: i32) -> PCE with Mut, Panic, Div {
    var pce = pce_new(input, min_i32(order, 10))

    let nodes = if input.dist_type == 0 {
        gauss_hermite_nodes()
    } else {
        gauss_legendre_nodes()
    }

    // Compute c_0
    var sum0 = 0.0
    var i = 0
    while i < 8 {
        let xi = if i == 0 { nodes.0 } else if i == 1 { nodes.1 }
                else if i == 2 { nodes.2 } else if i == 3 { nodes.3 }
                else if i == 4 { nodes.4 } else if i == 5 { nodes.5 }
                else if i == 6 { nodes.6 } else { nodes.7 }
        let x = transform_to_physical(input, xi)
        sum0 = sum0 + cos_f64(x)
        i = i + 1
    }
    pce.c0 = sum0 / 8.0

    // Compute c_1
    var sum1 = 0.0
    i = 0
    while i < 8 {
        let xi = if i == 0 { nodes.0 } else if i == 1 { nodes.1 }
                else if i == 2 { nodes.2 } else if i == 3 { nodes.3 }
                else if i == 4 { nodes.4 } else if i == 5 { nodes.5 }
                else if i == 6 { nodes.6 } else { nodes.7 }
        let x = transform_to_physical(input, xi)
        let psi1 = if input.dist_type == 0 { hermite_poly(1, xi) } else { legendre_poly(1, xi) }
        sum1 = sum1 + cos_f64(x) * psi1
        i = i + 1
    }
    pce.c1 = sum1 / 8.0

    pce.mean = pce.c0
    pce.variance = pce.c1 * pce.c1
    pce.sobol_total = 1.0
    return pce
}

// =============================================================================
// STATISTICS & SENSITIVITY ANALYSIS
// =============================================================================

fn min_i32(a: i32, b: i32) -> i32 {
    if a < b { a } else { b }
}

pub fn std(pce: PCE) -> f64 with Panic {
    return sqrt_f64(pce.variance)
}

// Sobol first-order sensitivity index (fraction of variance from first-order term)
pub fn sobol_first_order(pce: PCE) -> f64 with Div, Panic {
    if pce.variance < 1e-14 { return 0.0 }
    return (pce.c1 * pce.c1) / pce.variance
}

// =============================================================================
// COMPARISON WITH GUM AND MONTE CARLO
// =============================================================================

// Compare PCE with GUM first-order approximation
// For f(x) with X ~ N(μ,σ):
//   GUM: E[f] ≈ f(μ), Var[f] ≈ [f'(μ)]² σ²
fn gum_propagate_exp(mu: f64, sigma: f64) -> (f64, f64) with Panic {
    let mean = exp_f64(mu)
    let deriv = exp_f64(mu)
    let variance = deriv * deriv * sigma * sigma
    return (mean, variance)
}

fn gum_propagate_square(mu: f64, sigma: f64) -> (f64, f64) {
    let mean = mu * mu
    let deriv = 2.0 * mu
    let variance = deriv * deriv * sigma * sigma
    return (mean, variance)
}

// Simple Monte Carlo estimate
fn mc_propagate_exp(mu: f64, sigma: f64, n_samples: i32) -> (f64, f64) with Mut, Panic, Div {
    // Simplified MC (would need proper RNG in production)
    var sum = 0.0
    var sum_sq = 0.0

    var i = 0
    while i < n_samples && i < 100 {
        // Simplified: use deterministic grid instead of random
        let z = -3.0 + 6.0 * (i as f64) / (n_samples as f64)
        let x = mu + sigma * z
        let f_x = exp_f64(x)
        sum = sum + f_x
        sum_sq = sum_sq + f_x * f_x
        i = i + 1
    }

    let count = min_i32(n_samples, 100) as f64
    let mean = sum / count
    let variance = (sum_sq / count) - (mean * mean)
    return (mean, variance)
}

// =============================================================================
// TESTS
// =============================================================================

// Test 1: Polynomial orthogonality
pub fn test_orthogonality() -> bool with Mut, Panic, Div {
    // H_0 and H_1 should be orthogonal w.r.t. N(0,1)
    let nodes = gauss_hermite_nodes()
    var sum = 0.0

    var i = 0
    while i < 8 {
        let x = if i == 0 { nodes.0 } else if i == 1 { nodes.1 }
               else if i == 2 { nodes.2 } else if i == 3 { nodes.3 }
               else if i == 4 { nodes.4 } else if i == 5 { nodes.5 }
               else if i == 6 { nodes.6 } else { nodes.7 }
        let h0 = hermite_poly(0, x)
        let h1 = hermite_poly(1, x)
        sum = sum + h0 * h1
        i = i + 1
    }

    return abs_f64(sum) < 0.1  // Should be near zero
}

// Test 2: Identity function
pub fn test_identity() -> bool with Mut, Panic, Div {
    let input = input_normal(5.0, 2.0)
    let pce = build_identity(input, 2)

    // Mean should equal input mean
    let mean_ok = abs_f64(pce.mean - 5.0) < 0.01
    // Variance should equal input variance
    let var_ok = abs_f64(pce.variance - 4.0) < 0.01

    return mean_ok && var_ok
}

// Test 3: Square function
pub fn test_square() -> bool with Mut, Panic, Div {
    let input = input_normal(3.0, 1.0)
    let pce = build_square(input, 4)

    // E[X²] = μ² + σ² = 9 + 1 = 10
    let mean_ok = abs_f64(pce.mean - 10.0) < 0.1

    return mean_ok
}

// Test 4: Exponential comparison
pub fn test_exp_comparison() -> bool with Mut, Panic, Div {
    let input = input_normal(1.0, 0.5)
    let pce = build_exp(input, 4)

    // Compare with analytical result: E[exp(X)] = exp(μ + σ²/2)
    let expected = exp_f64(1.0 + 0.125)
    let error = abs_f64(pce.mean - expected) / expected

    return error < 0.05  // 5% error tolerance
}

// Test 5: Sobol index
pub fn test_sobol() -> bool with Mut, Panic, Div {
    let input = input_normal(0.0, 1.0)
    let pce = build_identity(input, 2)

    // For identity, all variance is first-order
    let sobol = sobol_first_order(pce)

    return abs_f64(sobol - 1.0) < 0.01
}

// Run all tests
pub fn run_tests() -> i32 with Mut, Panic, Div {
    var passed = 0

    if test_orthogonality() { passed = passed + 1 }
    if test_identity() { passed = passed + 1 }
    if test_square() { passed = passed + 1 }
    if test_exp_comparison() { passed = passed + 1 }
    if test_sobol() { passed = passed + 1 }

    return passed  // Returns number of tests passed (out of 5)
}

// =============================================================================
// METHOD COMPARISON
// =============================================================================

// Compare PCE, GUM, and Monte Carlo for exponential function
pub fn compare_exp(input: PCEInput, pce_order: i32, mc_samples: i32) -> ComparisonResult
with Mut, Panic, Div {
    // Build PCE
    let pce = build_exp(input, pce_order)
    let pce_std_val = std(pce)

    // GUM first-order
    let gum_result = gum_propagate_exp(input.mean, input.std)
    let gum_std_val = sqrt_f64(gum_result.1)

    // Monte Carlo (reference)
    let mc_result = mc_propagate_exp(input.mean, input.std, mc_samples)
    let mc_std_val = sqrt_f64(mc_result.1)

    // Compute relative errors vs. MC
    let pce_error = abs_f64(pce.mean - mc_result.0) / abs_f64(mc_result.0)
    let gum_error = abs_f64(gum_result.0 - mc_result.0) / abs_f64(mc_result.0)

    return ComparisonResult {
        pce_mean: pce.mean,
        pce_std: pce_std_val,
        gum_mean: gum_result.0,
        gum_std: gum_std_val,
        mc_mean: mc_result.0,
        mc_std: mc_std_val,
        pce_vs_mc_error: pce_error,
        gum_vs_mc_error: gum_error,
    }
}

// Compare PCE and GUM for square function
pub fn compare_square(input: PCEInput, pce_order: i32) -> ComparisonResult
with Mut, Panic, Div {
    // Build PCE
    let pce = build_square(input, pce_order)
    let pce_std_val = std(pce)

    // GUM first-order
    let gum_result = gum_propagate_square(input.mean, input.std)
    let gum_std_val = sqrt_f64(gum_result.1)

    // Analytical result for square
    let mu = input.mean
    let sigma = input.std
    let exact_mean = mu * mu + sigma * sigma
    let exact_var = 4.0 * mu * mu * sigma * sigma + 2.0 * sigma * sigma * sigma * sigma
    let exact_std = sqrt_f64(exact_var)

    let pce_error = abs_f64(pce.mean - exact_mean) / abs_f64(exact_mean)
    let gum_error = abs_f64(gum_result.0 - exact_mean) / abs_f64(exact_mean)

    return ComparisonResult {
        pce_mean: pce.mean,
        pce_std: pce_std_val,
        gum_mean: gum_result.0,
        gum_std: gum_std_val,
        mc_mean: exact_mean,
        mc_std: exact_std,
        pce_vs_mc_error: pce_error,
        gum_vs_mc_error: gum_error,
    }
}

// =============================================================================
// PCE EVALUATION
// =============================================================================

// Evaluate PCE at a given point
pub fn evaluate(pce: PCE, x: f64) -> f64 with Mut, Panic, Div {
    // Transform x to standardized space
    let xi = if pce.dist_type == 0 {
        // Normal: ξ = (x - μ) / σ
        (x - pce.input_mean) / pce.input_std
    } else {
        // Uniform: ξ = (x - μ) / (sqrt(3)σ)
        (x - pce.input_mean) / (sqrt_f64(3.0) * pce.input_std)
    }

    // Evaluate polynomial basis
    var result = pce.c0

    if pce.order >= 1 {
        let psi1 = if pce.dist_type == 0 { hermite_poly(1, xi) } else { legendre_poly(1, xi) }
        result = result + pce.c1 * psi1
    }

    if pce.order >= 2 {
        let psi2 = if pce.dist_type == 0 { hermite_poly(2, xi) } else { legendre_poly(2, xi) }
        result = result + pce.c2 * psi2
    }

    if pce.order >= 3 {
        let psi3 = if pce.dist_type == 0 { hermite_poly(3, xi) } else { legendre_poly(3, xi) }
        result = result + pce.c3 * psi3
    }

    if pce.order >= 4 {
        let psi4 = if pce.dist_type == 0 { hermite_poly(4, xi) } else { legendre_poly(4, xi) }
        result = result + pce.c4 * psi4
    }

    return result
}

// =============================================================================
// BIVARIATE PCE (Tensor Product)
// =============================================================================

pub struct PCEBivariate {
    pub order1: i32,
    pub order2: i32,
    pub input1_mean: f64,
    pub input1_std: f64,
    pub input2_mean: f64,
    pub input2_std: f64,
    pub dist_type1: i32,
    pub dist_type2: i32,
    // Coefficients c_ij for i,j in [0,4]
    pub c00: f64,
    pub c01: f64,
    pub c02: f64,
    pub c03: f64,
    pub c04: f64,
    pub c10: f64,
    pub c11: f64,
    pub c12: f64,
    pub c13: f64,
    pub c14: f64,
    pub c20: f64,
    pub c21: f64,
    pub c22: f64,
    pub c23: f64,
    pub c24: f64,
    pub c30: f64,
    pub c31: f64,
    pub c32: f64,
    pub c33: f64,
    pub c34: f64,
    pub c40: f64,
    pub c41: f64,
    pub c42: f64,
    pub c43: f64,
    pub c44: f64,
    pub mean: f64,
    pub variance: f64,
}

// Build bivariate PCE for f(x,y) = x + y (sum)
pub fn build_bivariate_sum(
    input1: PCEInput,
    input2: PCEInput,
    order: i32,
) -> PCEBivariate with Mut, Panic {
    var pce = PCEBivariate {
        order1: order,
        order2: order,
        input1_mean: input1.mean,
        input1_std: input1.std,
        input2_mean: input2.mean,
        input2_std: input2.std,
        dist_type1: input1.dist_type,
        dist_type2: input2.dist_type,
        c00: 0.0, c01: 0.0, c02: 0.0, c03: 0.0, c04: 0.0,
        c10: 0.0, c11: 0.0, c12: 0.0, c13: 0.0, c14: 0.0,
        c20: 0.0, c21: 0.0, c22: 0.0, c23: 0.0, c24: 0.0,
        c30: 0.0, c31: 0.0, c32: 0.0, c33: 0.0, c34: 0.0,
        c40: 0.0, c41: 0.0, c42: 0.0, c43: 0.0, c44: 0.0,
        mean: 0.0,
        variance: 0.0,
    }

    // For f(x,y) = x + y with independent X, Y:
    // E[X + Y] = E[X] + E[Y]
    pce.c00 = input1.mean + input2.mean

    // c_10 corresponds to first-order term in x
    // c_01 corresponds to first-order term in y
    if input1.dist_type == 0 {
        pce.c10 = input1.std
    } else {
        pce.c10 = sqrt_f64(3.0) * input1.std
    }

    if input2.dist_type == 0 {
        pce.c01 = input2.std
    } else {
        pce.c01 = sqrt_f64(3.0) * input2.std
    }

    pce.mean = pce.c00
    pce.variance = pce.c10 * pce.c10 + pce.c01 * pce.c01
    return pce
}

// Build bivariate PCE for f(x,y) = x * y (product)
pub fn build_bivariate_product(
    input1: PCEInput,
    input2: PCEInput,
    order: i32,
) -> PCEBivariate with Mut, Panic {
    var pce = PCEBivariate {
        order1: min_i32(order, 4),
        order2: min_i32(order, 4),
        input1_mean: input1.mean,
        input1_std: input1.std,
        input2_mean: input2.mean,
        input2_std: input2.std,
        dist_type1: input1.dist_type,
        dist_type2: input2.dist_type,
        c00: 0.0, c01: 0.0, c02: 0.0, c03: 0.0, c04: 0.0,
        c10: 0.0, c11: 0.0, c12: 0.0, c13: 0.0, c14: 0.0,
        c20: 0.0, c21: 0.0, c22: 0.0, c23: 0.0, c24: 0.0,
        c30: 0.0, c31: 0.0, c32: 0.0, c33: 0.0, c34: 0.0,
        c40: 0.0, c41: 0.0, c42: 0.0, c43: 0.0, c44: 0.0,
        mean: 0.0,
        variance: 0.0,
    }

    let mu1 = input1.mean
    let mu2 = input2.mean
    let sigma1 = input1.std
    let sigma2 = input2.std

    // For f(x,y) = xy with independent X, Y:
    // E[XY] = E[X]E[Y]
    pce.c00 = mu1 * mu2

    // First-order terms
    if input1.dist_type == 0 {
        pce.c10 = mu2 * sigma1
    } else {
        pce.c10 = mu2 * sqrt_f64(3.0) * sigma1
    }

    if input2.dist_type == 0 {
        pce.c01 = mu1 * sigma2
    } else {
        pce.c01 = mu1 * sqrt_f64(3.0) * sigma2
    }

    // Cross term c_11
    if input1.dist_type == 0 && input2.dist_type == 0 {
        pce.c11 = sigma1 * sigma2
    } else if input1.dist_type == 0 {
        pce.c11 = sigma1 * sqrt_f64(3.0) * sigma2
    } else if input2.dist_type == 0 {
        pce.c11 = sqrt_f64(3.0) * sigma1 * sigma2
    } else {
        pce.c11 = 3.0 * sigma1 * sigma2
    }

    pce.mean = pce.c00
    pce.variance = pce.c10 * pce.c10 + pce.c01 * pce.c01 + pce.c11 * pce.c11
    return pce
}

// Extract statistics from bivariate PCE
pub fn bivariate_std(pce: PCEBivariate) -> f64 with Panic {
    return sqrt_f64(pce.variance)
}

// Sobol indices for bivariate PCE
pub fn bivariate_sobol_x(pce: PCEBivariate) -> f64 with Div, Panic {
    if pce.variance < 1e-14 { return 0.0 }
    // Variance due to x alone
    let var_x = pce.c10 * pce.c10 + pce.c20 * pce.c20 + pce.c30 * pce.c30 + pce.c40 * pce.c40
    return var_x / pce.variance
}

pub fn bivariate_sobol_y(pce: PCEBivariate) -> f64 with Div, Panic {
    if pce.variance < 1e-14 { return 0.0 }
    // Variance due to y alone
    let var_y = pce.c01 * pce.c01 + pce.c02 * pce.c02 + pce.c03 * pce.c03 + pce.c04 * pce.c04
    return var_y / pce.variance
}

pub fn bivariate_sobol_interaction(pce: PCEBivariate) -> f64 with Div, Panic {
    if pce.variance < 1e-14 { return 0.0 }
    // Variance due to interaction (cross terms)
    let var_xy = pce.c11 * pce.c11 + pce.c12 * pce.c12 + pce.c13 * pce.c13 + pce.c14 * pce.c14 +
                 pce.c21 * pce.c21 + pce.c22 * pce.c22 + pce.c23 * pce.c23 + pce.c24 * pce.c24 +
                 pce.c31 * pce.c31 + pce.c32 * pce.c32 + pce.c33 * pce.c33 + pce.c34 * pce.c34 +
                 pce.c41 * pce.c41 + pce.c42 * pce.c42 + pce.c43 * pce.c43 + pce.c44 * pce.c44
    return var_xy / pce.variance
}

// =============================================================================
// ADDITIONAL UTILITIES
// =============================================================================

// Compute coefficient of variation (CV = std / mean)
pub fn coefficient_of_variation(pce: PCE) -> f64 with Div, Panic {
    if abs_f64(pce.mean) < 1e-14 { return 0.0 }
    return std(pce) / abs_f64(pce.mean)
}

// Get percentile bounds (approximate via normal assumption)
pub fn percentile_bounds(pce: PCE, coverage: f64) -> (f64, f64) with Panic {
    // coverage = 0.95 -> 95% interval -> z ≈ 1.96
    // coverage = 0.99 -> 99% interval -> z ≈ 2.576
    let z = if coverage > 0.98 {
        2.576  // 99%
    } else if coverage > 0.94 {
        1.960  // 95%
    } else {
        1.645  // 90%
    }

    let pce_std = std(pce)
    let lower = pce.mean - z * pce_std
    let upper = pce.mean + z * pce_std
    return (lower, upper)
}

// Check if PCE is effectively linear (higher-order terms negligible)
pub fn is_linear(pce: PCE) -> bool with Div, Panic {
    if pce.variance < 1e-14 { return true }

    // Fraction of variance in first-order term
    let first_order_frac = (pce.c1 * pce.c1) / pce.variance

    // If > 95% variance is first-order, consider it linear
    return first_order_frac > 0.95
}

// =============================================================================
// ADDITIONAL TESTS
// =============================================================================

// Test 6: Bivariate sum
pub fn test_bivariate_sum() -> bool with Mut, Panic, Div {
    let input1 = input_normal(3.0, 1.0)
    let input2 = input_normal(5.0, 2.0)
    let pce = build_bivariate_sum(input1, input2, 2)

    // E[X + Y] = E[X] + E[Y] = 3 + 5 = 8
    let mean_ok = abs_f64(pce.mean - 8.0) < 0.01

    // Var[X + Y] = Var[X] + Var[Y] = 1 + 4 = 5 (independent)
    let var_ok = abs_f64(pce.variance - 5.0) < 0.01

    return mean_ok && var_ok
}

// Test 7: Bivariate product
pub fn test_bivariate_product() -> bool with Mut, Panic, Div {
    let input1 = input_normal(2.0, 0.5)
    let input2 = input_normal(3.0, 0.5)
    let pce = build_bivariate_product(input1, input2, 2)

    // E[XY] = E[X]E[Y] = 2 * 3 = 6 (independent)
    let mean_ok = abs_f64(pce.mean - 6.0) < 0.1

    return mean_ok
}

// Test 8: Method comparison
pub fn test_comparison() -> bool with Mut, Panic, Div {
    let input = input_normal(1.0, 0.3)
    let result = compare_exp(input, 4, 50)

    // PCE should be more accurate than GUM for nonlinear functions
    let pce_better = result.pce_vs_mc_error < result.gum_vs_mc_error

    return pce_better
}

// Test 9: Linearity detection
pub fn test_linearity() -> bool with Mut, Panic, Div {
    let input = input_normal(5.0, 1.0)
    let pce_linear = build_identity(input, 2)
    let pce_nonlinear = build_square(input, 4)

    let linear_ok = is_linear(pce_linear)
    let nonlinear_ok = is_linear(pce_nonlinear) == false

    return linear_ok && nonlinear_ok
}

// Run extended test suite
pub fn run_all_tests() -> i32 with Mut, Panic, Div {
    var passed = 0

    // Original tests
    if test_orthogonality() { passed = passed + 1 }
    if test_identity() { passed = passed + 1 }
    if test_square() { passed = passed + 1 }
    if test_exp_comparison() { passed = passed + 1 }
    if test_sobol() { passed = passed + 1 }

    // Extended tests
    if test_bivariate_sum() { passed = passed + 1 }
    if test_bivariate_product() { passed = passed + 1 }
    if test_comparison() { passed = passed + 1 }
    if test_linearity() { passed = passed + 1 }

    return passed  // Returns number of tests passed (out of 9)
}
