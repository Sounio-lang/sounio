// stdlib/epistemic/merkle.sio
//
// Merkle Provenance: Cryptographic Audit Trails for Epistemic Computing
//
// Every computation leaves a hash. Every result can be verified.
// The provenance DAG is tamper-evident.
//
// Uses fixed-size arrays (no heap). Max 256 nodes, max 8 parents per node.

// ============================================================================
// HASH TYPE
// ============================================================================

// 256-bit hash (represented as 4 i64s for simplicity)
struct Hash256 {
    h0: i64,
    h1: i64,
    h2: i64,
    h3: i64,
}

fn hash256_zero() -> Hash256 {
    Hash256 { h0: 0, h1: 0, h2: 0, h3: 0 }
}

fn hash256_is_zero(h: Hash256) -> bool {
    h.h0 == 0 && h.h1 == 0 && h.h2 == 0 && h.h3 == 0
}

fn hash256_eq(a: Hash256, b: Hash256) -> bool {
    a.h0 == b.h0 && a.h1 == b.h1 && a.h2 == b.h2 && a.h3 == b.h3
}

// Simple hash combine via XOR with shifts
fn hash256_combine(a: Hash256, b: Hash256) -> Hash256 {
    Hash256 {
        h0: a.h0 ^ ((b.h1 * 31) + 17),
        h1: a.h1 ^ ((b.h2 * 37) + 19),
        h2: a.h2 ^ ((b.h3 * 41) + 23),
        h3: a.h3 ^ ((b.h0 * 43) + 29),
    }
}

// Hash from an f64 value (approximate bit-level hash)
fn hash256_from_f64(v: f64) -> Hash256 {
    // Use multiplication to spread bits
    let iv = (v * 1000000.0) as i64
    Hash256 {
        h0: iv ^ 6364136223846793005,
        h1: (iv * 31) ^ 1442695040888963407,
        h2: (iv * 37) ^ 3141592653589793238,
        h3: (iv * 41) ^ 2718281828459045235,
    }
}

// Hash from an integer tag (used for operation type hashing)
fn hash256_from_tag(tag: i64) -> Hash256 {
    Hash256 {
        h0: tag ^ 6364136223846793005,
        h1: (tag * 2654435761) ^ 1442695040888963407,
        h2: (tag * 40503) ^ 3141592653589793238,
        h3: (tag * 12345) ^ 2718281828459045235,
    }
}

// ============================================================================
// OPERATION TYPES (as i64 constants)
// ============================================================================

fn OP_LEAF() -> i64 { 0 }
fn OP_TRANSFORM() -> i64 { 1 }
fn OP_AGGREGATE() -> i64 { 2 }
fn OP_IMPORT() -> i64 { 3 }

// ============================================================================
// MERKLE NODE (fixed-size, no heap)
// ============================================================================

// A node in the Merkle provenance DAG
// Max 8 parents per node
struct MerkleNode {
    hash: Hash256,
    content_hash: Hash256,
    operation: i64,
    op_tag: i64,
    parent_hashes: [Hash256; 8],
    parent_count: i64,
    valid: bool,
}

fn merkle_node_empty() -> MerkleNode {
    MerkleNode {
        hash: hash256_zero(),
        content_hash: hash256_zero(),
        operation: OP_LEAF(),
        op_tag: 0,
        parent_hashes: [hash256_zero(); 8],
        parent_count: 0,
        valid: false,
    }
}

// Create a leaf node from a data hash
fn merkle_leaf(content_hash: Hash256) -> MerkleNode {
    let leaf_tag = hash256_from_tag(OP_LEAF())
    let h = hash256_combine(content_hash, leaf_tag)
    MerkleNode {
        hash: h,
        content_hash: content_hash,
        operation: OP_LEAF(),
        op_tag: 0,
        parent_hashes: [hash256_zero(); 8],
        parent_count: 0,
        valid: true,
    }
}

// Create a transform node from parent hashes and result hash
// parents_arr: array of parent hashes, n_parents: how many are valid
fn merkle_transform(
    op_tag: i64,
    parents_arr: [Hash256; 8],
    n_parents: i64,
    content_hash: Hash256
) -> MerkleNode {
    var combined = hash256_from_tag(op_tag)
    var i = 0
    while i < n_parents {
        if i < 8 {
            combined = hash256_combine(combined, parents_arr[i])
        }
        i = i + 1
    }
    combined = hash256_combine(combined, content_hash)

    MerkleNode {
        hash: combined,
        content_hash: content_hash,
        operation: OP_TRANSFORM(),
        op_tag: op_tag,
        parent_hashes: parents_arr,
        parent_count: n_parents,
        valid: true,
    }
}

// Verify a node by recomputing its hash
fn merkle_node_verify(node: MerkleNode) -> bool {
    if !node.valid { return false }

    if node.operation == OP_LEAF() {
        let expected = hash256_combine(node.content_hash, hash256_from_tag(OP_LEAF()))
        return hash256_eq(node.hash, expected)
    }

    // Transform/Aggregate/Import: recompute from op_tag + parents + content
    var combined = hash256_from_tag(node.op_tag)
    var i = 0
    while i < node.parent_count {
        if i < 8 {
            combined = hash256_combine(combined, node.parent_hashes[i])
        }
        i = i + 1
    }
    combined = hash256_combine(combined, node.content_hash)
    hash256_eq(node.hash, combined)
}

// ============================================================================
// MERKLE DAG (fixed-size, max 256 nodes)
// ============================================================================

struct MerkleDAG {
    nodes: [MerkleNode; 256],
    count: i64,
}

fn merkle_dag_new() -> MerkleDAG {
    MerkleDAG {
        nodes: [merkle_node_empty(); 256],
        count: 0,
    }
}

// Add a leaf node for a single f64 value, return its hash
fn merkle_dag_add_leaf(dag: &!MerkleDAG, value: f64) -> Hash256 {
    if dag.count >= 256 { return hash256_zero() }
    let content_hash = hash256_from_f64(value)
    let node = merkle_leaf(content_hash)
    let h = node.hash
    dag.nodes[dag.count] = node
    dag.count = dag.count + 1
    h
}

// Add a transform node with one parent
fn merkle_dag_add_transform_1(
    dag: &!MerkleDAG,
    op_tag: i64,
    parent: Hash256,
    result_value: f64
) -> Hash256 {
    if dag.count >= 256 { return hash256_zero() }
    var parents = [hash256_zero(); 8]
    parents[0] = parent
    let content_hash = hash256_from_f64(result_value)
    let node = merkle_transform(op_tag, parents, 1, content_hash)
    let h = node.hash
    dag.nodes[dag.count] = node
    dag.count = dag.count + 1
    h
}

// Add a transform node with two parents
fn merkle_dag_add_transform_2(
    dag: &!MerkleDAG,
    op_tag: i64,
    parent1: Hash256,
    parent2: Hash256,
    result_value: f64
) -> Hash256 {
    if dag.count >= 256 { return hash256_zero() }
    var parents = [hash256_zero(); 8]
    parents[0] = parent1
    parents[1] = parent2
    let content_hash = hash256_from_f64(result_value)
    let node = merkle_transform(op_tag, parents, 2, content_hash)
    let h = node.hash
    dag.nodes[dag.count] = node
    dag.count = dag.count + 1
    h
}

// Find node index by hash, returns -1 if not found
fn merkle_dag_find(dag: &MerkleDAG, hash: Hash256) -> i64 {
    var i = 0
    while i < dag.count {
        if dag.nodes[i].valid && hash256_eq(dag.nodes[i].hash, hash) {
            return i
        }
        i = i + 1
    }
    0 - 1
}

// Verify a single node by hash
fn merkle_dag_verify_node(dag: &MerkleDAG, hash: Hash256) -> bool {
    let idx = merkle_dag_find(dag, hash)
    if idx < 0 { return false }
    merkle_node_verify(dag.nodes[idx])
}

// Verify entire chain from a node back to leaves (iterative with stack)
fn merkle_dag_verify_chain(dag: &MerkleDAG, hash: Hash256) -> bool {
    // Use a fixed stack for traversal
    var stack: [Hash256; 64] = [hash256_zero(); 64]
    stack[0] = hash
    var sp = 1

    while sp > 0 {
        sp = sp - 1
        let current = stack[sp]

        let idx = merkle_dag_find(dag, current)
        if idx < 0 { return false }

        let node = dag.nodes[idx]
        if !merkle_node_verify(node) { return false }

        // Push parents onto stack
        var j = 0
        while j < node.parent_count {
            if j < 8 && sp < 64 {
                stack[sp] = node.parent_hashes[j]
                sp = sp + 1
            }
            j = j + 1
        }
    }
    true
}

// Get the count of nodes in the DAG
fn merkle_dag_len(dag: &MerkleDAG) -> i64 {
    dag.count
}
