//@ run-pass
//@ expect-stdout: ALL PASS

// stdlib/epistemic/knowledge.sio — Epistemic value type with GUM variance propagation
//
// Epistemic wraps a scalar value with:
//   - val:        point estimate (f64)
//   - variance:   GUM variance (f64, σ²)
//   - confidence: integer 0-1000 (mirrors compiler Knowledge<T> scale)
//
// Arithmetic propagates variance via the delta method.
// Confidence decays multiplicatively through operations.
// No heap, no strings, no generics — pure flat-struct arithmetic.
//
// MADAROS D3 (2026-07-19): free-function surface is the native-import-safe API.
// Method-call form (`Epistemic::measured`, `e.val()`) still trips Madaros Root 2
// (null-deref on method call lowering — MADAROS_SRET_ROOT_SYNTHESIS). Thin `impl`
// wrappers remain for lean_single / source-compat; selftests and Madaros E2E use
// free functions only. Do not name a free function `measure` — collides with the
// language Knowledge<T> builtin.

// ============================================================================
// SQRT HELPER
// ============================================================================

pub fn ep_sqrt(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y
}

fn ep_abs(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

// Madaros multi-module (2026-07-20): E175 hard-errors on non-pub imports.
// propagate / monte_carlo name these; lean_single only warned historically.
pub fn ep_min_conf(a: i64, b: i64) -> i64 {
    if a < b { a } else { b }
}

pub fn ep_clamp_conf(c: i64) -> i64 {
    if c < 0 { return 0 }
    if c > 1000 { return 1000 }
    c
}

// ============================================================================
// EPISTEMIC STRUCT + FREE API (Madaros-import-safe)
// ============================================================================

pub struct Epistemic {
    val: f64,
    variance: f64,
    confidence: i64,
}

pub fn ep_new(val: f64, variance: f64, confidence: i64) -> Epistemic {
    Epistemic { val: val, variance: variance, confidence: ep_clamp_conf(confidence) }
}

pub fn ep_certain(val: f64) -> Epistemic {
    Epistemic { val: val, variance: 0.0, confidence: 1000 }
}

pub fn ep_measured(val: f64, std_dev: f64) -> Epistemic with Mut, Div, Panic {
    Epistemic { val: val, variance: std_dev * std_dev, confidence: 900 }
}

pub fn ep_val(e: &Epistemic) -> f64 { e.val }
pub fn ep_variance(e: &Epistemic) -> f64 { e.variance }
pub fn ep_confidence(e: &Epistemic) -> i64 { e.confidence }

pub fn ep_std(e: &Epistemic) -> f64 with Mut, Div, Panic {
    ep_sqrt(e.variance)
}

pub fn ep_is_credible(e: &Epistemic, min_conf: i64) -> bool {
    // Direct field compare is correct after #1511 (Knowledge.confidence is_float=3).
    e.confidence >= min_conf
}

// GUM: Var(X+Y) = Var(X) + Var(Y); conf = min scaled
pub fn ep_add(a: &Epistemic, b: &Epistemic) -> Epistemic {
    Epistemic {
        val: a.val + b.val,
        variance: a.variance + b.variance,
        confidence: ep_clamp_conf(ep_min_conf(a.confidence, b.confidence) * 99 / 100),
    }
}

// GUM: Var(X-Y) = Var(X) + Var(Y)
pub fn ep_sub(a: &Epistemic, b: &Epistemic) -> Epistemic {
    Epistemic {
        val: a.val - b.val,
        variance: a.variance + b.variance,
        confidence: ep_clamp_conf(ep_min_conf(a.confidence, b.confidence) * 99 / 100),
    }
}

// GUM delta method: Var(XY) ≈ Y²·Var(X) + X²·Var(Y)
pub fn ep_mul(a: &Epistemic, b: &Epistemic) -> Epistemic {
    let new_var = b.val * b.val * a.variance + a.val * a.val * b.variance
    Epistemic {
        val: a.val * b.val,
        variance: new_var,
        confidence: ep_clamp_conf(ep_min_conf(a.confidence, b.confidence) * 98 / 100),
    }
}

// GUM delta method: Var(X/Y) ≈ Var(X)/Y² + X²·Var(Y)/Y⁴
pub fn ep_div(a: &Epistemic, b: &Epistemic) -> Epistemic with Div, Panic {
    let y2 = b.val * b.val
    let y4 = y2 * y2
    let new_var = a.variance / y2 + a.val * a.val * b.variance / y4
    Epistemic {
        val: a.val / b.val,
        variance: new_var,
        confidence: ep_clamp_conf(ep_min_conf(a.confidence, b.confidence) * 97 / 100),
    }
}

// Var(c·X) = c²·Var(X)
pub fn ep_scale(a: &Epistemic, c: f64) -> Epistemic {
    Epistemic {
        val: a.val * c,
        variance: a.variance * c * c,
        confidence: a.confidence,
    }
}

// Var(X+c) = Var(X)
pub fn ep_shift(a: &Epistemic, c: f64) -> Epistemic {
    Epistemic {
        val: a.val + c,
        variance: a.variance,
        confidence: a.confidence,
    }
}

// Var(X²) ≈ 4X²·Var(X)
pub fn ep_square(a: &Epistemic) -> Epistemic {
    Epistemic {
        val: a.val * a.val,
        variance: 4.0 * a.val * a.val * a.variance,
        confidence: ep_clamp_conf(a.confidence * 98 / 100),
    }
}

// Var(√X) ≈ Var(X)/(4X)
pub fn ep_sqrt_ep(a: &Epistemic) -> Epistemic with Mut, Div, Panic {
    let new_val = ep_sqrt(a.val)
    let new_var = if a.val > 0.0 { a.variance / (4.0 * a.val) } else { 0.0 }
    Epistemic {
        val: new_val,
        variance: new_var,
        confidence: ep_clamp_conf(a.confidence * 98 / 100),
    }
}

pub fn ep_rel_uncertainty(a: &Epistemic) -> f64 with Mut, Div, Panic {
    let abs_val = ep_abs(a.val)
    if abs_val < 1e-15 { return 0.0 }
    ep_sqrt(a.variance) / abs_val
}

// ============================================================================
// GATE / MERGE / CONFIDENCE
// ============================================================================

/// Soft gate: returns 1 if confidence ≥ min_conf, 0 otherwise.
pub fn ep_gate(e: &Epistemic, min_conf: i64) -> i64 {
    if e.confidence >= min_conf { 1 } else { 0 }
}

/// Hard gate: GATE_FAIL sentinel when below threshold (confidence=0).
pub fn ep_require_conf(e: Epistemic, min_conf: i64) -> Epistemic {
    if e.confidence >= min_conf {
        e
    } else {
        Epistemic { val: e.val, variance: e.variance, confidence: 0 }
    }
}

/// Budget report: (rel_unc_ppm, confidence) where rel_unc_ppm = (σ/|μ|) × 10⁶.
pub fn ep_budget(e: &Epistemic) -> (f64, i64) with Mut, Div, Panic {
    let abs_val = if e.val < 0.0 { 0.0 - e.val } else { e.val }
    let std = ep_sqrt(e.variance)
    let rel_ppm = if abs_val > 1e-15 { std / abs_val * 1e6 } else { 0.0 }
    (rel_ppm, e.confidence)
}

// Inverse-variance weighted merge
pub fn ep_merge(a: &Epistemic, b: &Epistemic) -> Epistemic with Div, Panic {
    let w_a = if a.variance > 0.0 { 1.0 / a.variance } else { 1e15 }
    let w_b = if b.variance > 0.0 { 1.0 / b.variance } else { 1e15 }
    let w_total = w_a + w_b
    let combined_val = (w_a * a.val + w_b * b.val) / w_total
    let combined_var = 1.0 / w_total
    let combined_conf = ep_clamp_conf((a.confidence + b.confidence) / 2)
    Epistemic { val: combined_val, variance: combined_var, confidence: combined_conf }
}

pub fn ep_decay(confidence: i64, factor: f64) -> i64 {
    let scaled = (confidence as f64) * factor
    ep_clamp_conf(scaled as i64)
}

pub fn ep_combine(c1: i64, c2: i64) -> i64 {
    ep_clamp_conf((c1 + c2) / 2)
}

// ============================================================================
// THIN IMPL WRAPPERS — free-function bodies + method call sites
// Free functions remain the preferred portable surface. Method form
// (Epistemic::measured / e.val() / e.add) is TRUSTWORTHY under default Madaros
// multi-module after Root 2 multi-module method landing (Wave9 residual closeout).
// Parity gate: scripts/madaros_knowledge_method_residual_gate.sh
// ============================================================================

impl Epistemic {
    pub fn new(val: f64, variance: f64, confidence: i64) -> Epistemic {
        ep_new(val, variance, confidence)
    }
    pub fn certain(val: f64) -> Epistemic {
        ep_certain(val)
    }
    pub fn measured(val: f64, std_dev: f64) -> Epistemic with Mut, Div, Panic {
        ep_measured(val, std_dev)
    }
    pub fn val(self: &Epistemic) -> f64 { ep_val(self) }
    pub fn variance(self: &Epistemic) -> f64 { ep_variance(self) }
    pub fn confidence(self: &Epistemic) -> i64 { ep_confidence(self) }
    pub fn std(self: &Epistemic) -> f64 with Mut, Div, Panic { ep_std(self) }
    pub fn is_credible(self: &Epistemic, min_conf: i64) -> bool {
        ep_is_credible(self, min_conf)
    }
    pub fn add(self: &Epistemic, other: &Epistemic) -> Epistemic { ep_add(self, other) }
    pub fn sub(self: &Epistemic, other: &Epistemic) -> Epistemic { ep_sub(self, other) }
    pub fn mul(self: &Epistemic, other: &Epistemic) -> Epistemic { ep_mul(self, other) }
    pub fn div(self: &Epistemic, other: &Epistemic) -> Epistemic with Div, Panic {
        ep_div(self, other)
    }
    pub fn scale(self: &Epistemic, c: f64) -> Epistemic { ep_scale(self, c) }
    pub fn shift(self: &Epistemic, c: f64) -> Epistemic { ep_shift(self, c) }
    pub fn square(self: &Epistemic) -> Epistemic { ep_square(self) }
    pub fn sqrt(self: &Epistemic) -> Epistemic with Mut, Div, Panic { ep_sqrt_ep(self) }
    pub fn rel_uncertainty(self: &Epistemic) -> f64 with Mut, Div, Panic {
        ep_rel_uncertainty(self)
    }
}

// ============================================================================
// SELFTEST — free-function only (Madaros-safe call sites)
// ============================================================================

var CNT: [i64; 2] = [0; 2]

// Avoid print(i64) under Madaros (can SIGSEGV); tally only, labels in comments at call sites.
fn chk(label: i64, ok: i64) with IO, Mut {
    if ok == 1 {
        CNT[0] = CNT[0] + 1
    } else {
        print("  FAIL chk\n")
        CNT[1] = CNT[1] + 1
    }
    let _keep = label
}

fn near(a: f64, b: f64, tol: f64) -> i64 {
    let d = a - b
    let d2 = if d < 0.0 { 0.0 - d } else { d }
    if d2 <= tol { 1 } else { 0 }
}

fn test_basic() with IO, Mut, Div, Panic {
    let x = ep_new(3.0, 0.01, 900)
    let y = ep_new(4.0, 0.04, 800)

    chk(1, near(ep_val(&x), 3.0, 1e-12))
    chk(2, near(ep_variance(&x), 0.01, 1e-12))
    chk(3, if ep_confidence(&x) == 900 { 1 } else { 0 })
    chk(4, near(ep_std(&x), 0.1, 1e-9))

    let s = ep_add(&x, &y)
    chk(5, near(ep_val(&s), 7.0, 1e-12))
    chk(6, near(ep_variance(&s), 0.05, 1e-12))
    chk(7, if ep_confidence(&s) <= 800 { 1 } else { 0 })

    let d = ep_sub(&x, &y)
    chk(8, near(ep_val(&d), 0.0 - 1.0, 1e-12))
    chk(9, near(ep_variance(&d), 0.05, 1e-12))
}

fn test_mul_div() with IO, Mut, Div, Panic {
    let x = ep_new(3.0, 0.01, 900)
    let y = ep_new(4.0, 0.04, 800)

    let p = ep_mul(&x, &y)
    chk(10, near(ep_val(&p), 12.0, 1e-12))
    chk(11, near(ep_variance(&p), 0.52, 1e-10))

    let q = ep_div(&x, &y)
    chk(12, near(ep_val(&q), 0.75, 1e-12))
    chk(13, near(ep_variance(&q), 0.00203125, 1e-10))
}

fn test_scale_shift() with IO, Mut, Div, Panic {
    let x = ep_new(2.0, 0.04, 850)

    let s = ep_scale(&x, 3.0)
    chk(14, near(ep_val(&s), 6.0, 1e-12))
    chk(15, near(ep_variance(&s), 0.36, 1e-12))
    chk(16, if ep_confidence(&s) == 850 { 1 } else { 0 })

    let sh = ep_shift(&s, 10.0)
    chk(17, near(ep_val(&sh), 16.0, 1e-12))
    chk(18, near(ep_variance(&sh), 0.36, 1e-12))
}

fn test_sqrt_square() with IO, Mut, Div, Panic {
    let x = ep_new(4.0, 0.16, 900)

    let sq_val = ep_sqrt(ep_val(&x))
    chk(19, near(sq_val, 2.0, 1e-9))

    let sq_var = ep_variance(&x) / (4.0 * ep_val(&x))
    chk(20, near(sq_var, 0.01, 1e-10))

    let sq2 = ep_square(&x)
    chk(21, near(ep_val(&sq2), 16.0, 1e-12))
    chk(22, near(ep_variance(&sq2), 10.24, 1e-10))
}

fn test_credibility() with IO, Mut, Div, Panic {
    let x = ep_new(1.0, 0.001, 800)
    chk(23, if ep_is_credible(&x, 700) { 1 } else { 0 })
    chk(24, if ep_is_credible(&x, 900) { 0 } else { 1 })
    chk(25, if ep_gate(&x, 700) == 1 { 1 } else { 0 })
    chk(26, if ep_gate(&x, 900) == 0 { 1 } else { 0 })
}

fn test_combine() with IO, Mut, Div, Panic {
    let a = ep_new(1.0, 0.01, 900)
    let b = ep_new(1.0, 0.04, 800)
    let c = ep_merge(&a, &b)
    chk(27, near(ep_val(&c), 1.0, 1e-10))
    chk(28, near(ep_variance(&c), 0.008, 1e-10))
}

fn test_certain() with IO, Mut, Div, Panic {
    let c = ep_certain(42.0)
    chk(29, near(ep_val(&c), 42.0, 1e-12))
    chk(30, near(ep_variance(&c), 0.0, 1e-12))
    chk(31, if ep_confidence(&c) == 1000 { 1 } else { 0 })
    chk(32, if ep_is_credible(&c, 1000) { 1 } else { 0 })
}

pub fn main() -> i32 with IO, Mut, Div, Panic {
    CNT[0] = 0; CNT[1] = 0
    print("─── stdlib/epistemic/knowledge tests ───\n")
    test_basic()
    test_mul_div()
    test_scale_shift()
    test_sqrt_square()
    test_credibility()
    test_combine()
    test_certain()
    // Avoid print(i64); report only via sentinel + exit code.
    if CNT[1] == 0 {
        if CNT[0] == 32 {
            print("─── 32/32 PASS ───\n")
            print("ALL PASS\n")
            return 0
        }
        print("─── PASS count mismatch ───\n")
        return 2
    }
    print("─── HAS FAILS ───\n")
    return 1
}
