// AST-native claim representation for the Falsification Ledger.
// A claim is a compile-time value with provenance, not a runtime effect.

module epistemic::claim_ast

pub enum Evidence {
    Conceived,
    Implemented,
    TypeCheck,
    Compiles,
    Executes,
    GateGreen,
    InstrumentControlled,
    ClaimReady,
}

pub enum Verdict {
    Alive,
    Negative,
    Dormant,
    Refuted,
}

pub enum Provenance {
    Absent,
    Cancelled,
    Annihilated,
    BelowResolution,
    Rounded,
    Gated,
    Unknown,
}

pub struct Claim {
    hypothesis: str,
    falsifier: str,
    evidence: Evidence,
    harness: str,
    gate: str,
    verdict: Verdict,
    provenance: Option<Provenance>,
}

pub fn claim_new(
    hypothesis: str,
    falsifier: str,
    evidence: Evidence,
    harness: str,
    gate: str,
    verdict: Verdict,
) -> Claim {
    Claim {
        hypothesis: hypothesis,
        falsifier: falsifier,
        evidence: evidence,
        harness: harness,
        gate: gate,
        verdict: verdict,
        provenance: None,
    }
}

pub fn claim_with_provenance(
    hypothesis: str,
    falsifier: str,
    evidence: Evidence,
    harness: str,
    gate: str,
    verdict: Verdict,
    provenance: Provenance,
) -> Claim {
    Claim {
        hypothesis: hypothesis,
        falsifier: falsifier,
        evidence: evidence,
        harness: harness,
        gate: gate,
        verdict: verdict,
        provenance: Some(provenance),
    }
}
