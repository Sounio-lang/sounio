// stdlib/epistemic/timeseries.sio
//
// Time Series Analysis with Epistemic Uncertainty
//
// Kalman filter, exponential smoothing, and ARIMA core with uncertainty.
// Fixed arrays: max 1024 observations, max 16 state dimensions.

// ============================================================================
// Helpers
// ============================================================================

fn ts_sqrt(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 15 {
        y = 0.5 * (y + x / y)
        i = i + 1
    }
    y
}

fn ts_abs(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

// ============================================================================
// Time Series Data: value + variance per observation
// ============================================================================

struct TimeSeries {
    values: [f64; 1024],
    variances: [f64; 1024],
    n: i64,
}

fn ts_new(n: i64) -> TimeSeries {
    TimeSeries {
        values: [0.0; 1024],
        variances: [0.0; 1024],
        n: n,
    }
}

fn ts_set(ts: &!TimeSeries, idx: i64, val: f64, var_: f64) {
    if idx >= 0 && idx < 1024 {
        ts.values[idx] = val
        ts.variances[idx] = var_
    }
}

fn ts_mean(ts: &TimeSeries) -> f64 with Mut, Div, Panic {
    var sum = 0.0
    var i = 0
    while i < ts.n {
        if i < 1024 { sum = sum + ts.values[i] }
        i = i + 1
    }
    sum / (ts.n as f64)
}

fn ts_variance(ts: &TimeSeries) -> f64 with Mut, Div, Panic {
    let m = ts_mean(ts)
    var sum = 0.0
    var i = 0
    while i < ts.n {
        if i < 1024 {
            let d = ts.values[i] - m
            sum = sum + d * d
        }
        i = i + 1
    }
    sum / ((ts.n - 1) as f64)
}

// ============================================================================
// Forecast result
// ============================================================================

struct Forecast {
    values: [f64; 64],
    variances: [f64; 64],
    n: i64,
}

fn forecast_new(n: i64) -> Forecast {
    Forecast {
        values: [0.0; 64],
        variances: [0.0; 64],
        n: n,
    }
}

// ============================================================================
// Exponential Smoothing (Simple)
// ============================================================================

struct ExpSmoothResult {
    smoothed: TimeSeries,
    alpha_used: f64,
    residual_variance: f64,
}

fn exp_smooth(ts: &TimeSeries, alpha: f64) -> ExpSmoothResult with Mut, Div, Panic {
    var result = ts_new(ts.n)
    if ts.n == 0 {
        return ExpSmoothResult { smoothed: result, alpha_used: alpha, residual_variance: 0.0 }
    }

    // Initialize with first value
    result.values[0] = ts.values[0]
    result.variances[0] = ts.variances[0]

    var i = 1
    while i < ts.n {
        if i < 1024 {
            // s[i] = alpha * y[i] + (1-alpha) * s[i-1]
            result.values[i] = alpha * ts.values[i] + (1.0 - alpha) * result.values[i - 1]
            // Variance: alpha^2 * Var(y[i]) + (1-alpha)^2 * Var(s[i-1])
            result.variances[i] = alpha * alpha * ts.variances[i]
                + (1.0 - alpha) * (1.0 - alpha) * result.variances[i - 1]
        }
        i = i + 1
    }

    // Compute residual variance
    var res_sum = 0.0
    i = 1
    while i < ts.n {
        if i < 1024 {
            let r = ts.values[i] - result.values[i]
            res_sum = res_sum + r * r
        }
        i = i + 1
    }
    let res_var = if ts.n > 1 { res_sum / ((ts.n - 1) as f64) } else { 0.0 }

    ExpSmoothResult { smoothed: result, alpha_used: alpha, residual_variance: res_var }
}

// Forecast from exponential smoothing
fn exp_smooth_forecast(
    result: &ExpSmoothResult,
    n_ahead: i64
) -> Forecast with Mut, Div, Panic {
    var fc = forecast_new(n_ahead)
    let last_val = if result.smoothed.n > 0 {
        result.smoothed.values[result.smoothed.n - 1]
    } else { 0.0 }
    let last_var = if result.smoothed.n > 0 {
        result.smoothed.variances[result.smoothed.n - 1]
    } else { 0.0 }

    var i = 0
    while i < n_ahead {
        if i < 64 {
            // Forecast is constant (simple ES)
            fc.values[i] = last_val
            // Variance grows with horizon
            fc.variances[i] = last_var + result.residual_variance * ((i + 1) as f64)
        }
        i = i + 1
    }
    fc
}

// ============================================================================
// Kalman Filter (scalar observation model)
// State: x_t = F * x_{t-1} + w_t, w ~ N(0, Q)
// Obs:   y_t = H * x_t + v_t,     v ~ N(0, R)
// ============================================================================

struct KalmanConfig {
    f_coeff: f64,
    h_coeff: f64,
    q_var: f64,
    r_var: f64,
}

fn kalman_config_default() -> KalmanConfig {
    KalmanConfig {
        f_coeff: 1.0,
        h_coeff: 1.0,
        q_var: 0.01,
        r_var: 0.1,
    }
}

struct KalmanState {
    x: f64,
    p: f64,
}

struct KalmanResult {
    filtered: TimeSeries,
    innovations: TimeSeries,
    log_likelihood: f64,
}

fn kalman_filter(
    ts: &TimeSeries,
    cfg: &KalmanConfig
) -> KalmanResult with Mut, Div, Panic {
    var filtered = ts_new(ts.n)
    var innovations = ts_new(ts.n)
    var log_lik = 0.0

    // Initialize state
    var x = if ts.n > 0 { ts.values[0] } else { 0.0 }
    var p = 1.0

    var i = 0
    while i < ts.n {
        if i < 1024 {
            // Predict
            let x_pred = cfg.f_coeff * x
            let p_pred = cfg.f_coeff * cfg.f_coeff * p + cfg.q_var

            // Innovation
            let y = ts.values[i]
            let innov = y - cfg.h_coeff * x_pred
            let s = cfg.h_coeff * cfg.h_coeff * p_pred + cfg.r_var

            // Kalman gain
            let k = if s > 1.0e-15 { p_pred * cfg.h_coeff / s } else { 0.0 }

            // Update
            x = x_pred + k * innov
            p = (1.0 - k * cfg.h_coeff) * p_pred

            filtered.values[i] = x
            filtered.variances[i] = p
            innovations.values[i] = innov
            innovations.variances[i] = s

            // Log-likelihood contribution (approximate)
            if s > 1.0e-15 {
                log_lik = log_lik - 0.5 * (innov * innov / s)
            }
        }
        i = i + 1
    }
    filtered.n = ts.n
    innovations.n = ts.n

    KalmanResult {
        filtered: filtered,
        innovations: innovations,
        log_likelihood: log_lik,
    }
}

// Kalman forecast
fn kalman_forecast(
    kr: &KalmanResult,
    cfg: &KalmanConfig,
    n_ahead: i64
) -> Forecast with Mut, Div, Panic {
    var fc = forecast_new(n_ahead)

    var x = if kr.filtered.n > 0 { kr.filtered.values[kr.filtered.n - 1] } else { 0.0 }
    var p = if kr.filtered.n > 0 { kr.filtered.variances[kr.filtered.n - 1] } else { 1.0 }

    var i = 0
    while i < n_ahead {
        x = cfg.f_coeff * x
        p = cfg.f_coeff * cfg.f_coeff * p + cfg.q_var
        if i < 64 {
            fc.values[i] = x
            fc.variances[i] = p + cfg.r_var
        }
        i = i + 1
    }
    fc
}

// ============================================================================
// AR(1) model fitting (method of moments)
// ============================================================================

struct AR1Result {
    phi: f64,
    phi_variance: f64,
    sigma2: f64,
    intercept: f64,
}

fn fit_ar1(ts: &TimeSeries) -> AR1Result with Mut, Div, Panic {
    let m = ts_mean(ts)
    let v = ts_variance(ts)

    // Lag-1 autocovariance
    var cov1 = 0.0
    var i = 1
    while i < ts.n {
        if i < 1024 {
            cov1 = cov1 + (ts.values[i] - m) * (ts.values[i - 1] - m)
        }
        i = i + 1
    }
    cov1 = if ts.n > 1 { cov1 / ((ts.n - 1) as f64) } else { 0.0 }

    let phi = if v > 1.0e-15 { cov1 / v } else { 0.0 }
    let sigma2 = v * (1.0 - phi * phi)
    let intercept = m * (1.0 - phi)

    // Variance of phi estimate ~ (1 - phi^2) / n
    let phi_var = if ts.n > 2 { (1.0 - phi * phi) / (ts.n as f64) } else { 1.0 }

    AR1Result {
        phi: phi,
        phi_variance: phi_var,
        sigma2: if sigma2 > 0.0 { sigma2 } else { 0.001 },
        intercept: intercept,
    }
}

// Forecast from AR(1)
fn ar1_forecast(ar: &AR1Result, last_val: f64, n_ahead: i64) -> Forecast with Mut, Div, Panic {
    var fc = forecast_new(n_ahead)
    var x = last_val

    var i = 0
    while i < n_ahead {
        x = ar.intercept + ar.phi * x
        if i < 64 {
            fc.values[i] = x
            // Variance grows with horizon for AR(1)
            var total_var = 0.0
            var k = 0
            var phi_pow = 1.0
            while k <= i {
                total_var = total_var + phi_pow * phi_pow * ar.sigma2
                phi_pow = phi_pow * ar.phi
                k = k + 1
            }
            // Add parameter uncertainty contribution
            total_var = total_var + (i + 1) as f64 * ar.phi_variance * x * x
            fc.variances[i] = total_var
        }
        i = i + 1
    }
    fc
}

// ============================================================================
// Change Point Detection (CUSUM)
// ============================================================================

struct ChangePoint {
    location: i64,
    statistic: f64,
    confidence: f64,
}

fn cusum_detect(ts: &TimeSeries, threshold: f64) -> ChangePoint with Mut, Div, Panic {
    let m = ts_mean(ts)
    let sd = ts_sqrt(ts_variance(ts))
    if sd < 1.0e-15 {
        return ChangePoint { location: 0 - 1, statistic: 0.0, confidence: 0.0 }
    }

    var s_pos = 0.0
    var s_neg = 0.0
    var max_stat = 0.0
    var max_loc: i64 = 0 - 1

    var i = 0
    while i < ts.n {
        if i < 1024 {
            let z = (ts.values[i] - m) / sd
            s_pos = s_pos + z
            if s_pos < 0.0 { s_pos = 0.0 }
            s_neg = s_neg - z
            if s_neg < 0.0 { s_neg = 0.0 }

            let stat = if s_pos > s_neg { s_pos } else { s_neg }
            if stat > max_stat {
                max_stat = stat
                max_loc = i
            }
        }
        i = i + 1
    }

    let detected = max_stat > threshold
    let conf = if detected { 0.95 } else { 0.1 }

    ChangePoint {
        location: if detected { max_loc } else { 0 - 1 },
        statistic: max_stat,
        confidence: conf,
    }
}
