//! Decision witness structs for explicit action admission and deferral.
//!
//! These are ordinary named structs. The compiler lowers `deferral_reason(d)`
//! into a literal targeting `DeferralReason`.

struct DeferralReason {
    policy_name: string,
    route_name: string,
    evidence_kind: i64,
    reason_code: i64,
    audit_name: string,
}

// plan_acquisition(...) lowers into this witness through acquisition_reason(...).
struct AcquisitionReason {
    policy_name: string,
    route_name: string,
    objective_name: string,
    deferred_reason: i64,
    audit_name: string,
    contest_id: i64,
    metric_snapshot: [f64; 8],
}

// plan_recourse(...) lowers into this witness through recourse_reason(...).
struct RecourseReason {
    policy_name: string,
    route_name: string,
    strategy_name: string,
    deferred_reason: i64,
    audit_name: string,
    contest_id: i64,
    metric_snapshot: [f64; 8],
}
