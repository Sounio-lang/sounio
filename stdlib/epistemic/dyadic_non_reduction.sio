pub struct DyadicSearchIncompleteReceipt {
    pub family_id: i64,
    pub requested_node_budget: i64,
    pub required_node_count: i64,
    pub node_budget_exhausted: bool,
    pub search_complete: bool,
    pub ambiguity_authorized: bool,
    pub minimality_authorized: bool,
}

pub fn authorize_dyadic_product(
    left_max: i64,
    right_max: i64,
    carrier_max: i64,
) -> BoundedDyadicProductReceipt with Div, Panic {
    assert(left_max >= 0)
    assert(right_max >= 0)
    assert(carrier_max > 0)
    if right_max > 0 {
        assert(left_max <= carrier_max / right_max)
    }
    BoundedDyadicProductReceipt {
        left_max: left_max,
        right_max: right_max,
        product_max: left_max * right_max,
        carrier_max: carrier_max,
        checked_before_multiplication: true,
        multiplication_authorized: true,
    }
}

pub fn exact_dyadic_rational(
    numerator: i64,
    denominator: i64,
    component_bound: i64,
) -> ExactDyadicRationalReceipt with Panic {
    assert(numerator >= 0)
    assert(denominator > 0)
    assert(component_bound > 0)
    assert(numerator <= component_bound)
    assert(denominator <= component_bound)
    ExactDyadicRationalReceipt {
        numerator: numerator,
        denominator: denominator,
        component_bound: component_bound,
        exact_not_floating_point: true,
    }
}

pub fn exact_dyadic_equal(
    left: ExactDyadicRationalReceipt,
    right: ExactDyadicRationalReceipt,
    bound: BoundedDyadicProductReceipt,
) -> bool with Panic {
    assert(bound.multiplication_authorized)
    assert(left.numerator <= bound.left_max)
    assert(right.numerator <= bound.left_max)
    assert(left.denominator <= bound.right_max)
    assert(right.denominator <= bound.right_max)
    left.numerator * right.denominator ==
        right.numerator * left.denominator
}

pub fn declare_dyadic_observation_schema(
    schema_id: i64,
) -> DyadicObservationSchemaReceipt with Panic {
    assert(schema_id > 0)
    DyadicObservationSchemaReceipt {
        schema_id: schema_id,
        exposes_left_projection: true,
        exposes_right_projection: true,
        exposes_relational_projection: true,
        exposes_candidate_id: false,
        exposes_history_id: false,
        exact_dimensionless: true,
        physically_calibrated: false,
        clinical_authority: false,
    }
}

pub fn reject_leaking_dyadic_schema(
    schema_id: i64,
    exposes_candidate_id: bool,
    exposes_history_id: bool,
) -> bool with Panic {
    assert(schema_id > 0)
    assert(exposes_candidate_id || exposes_history_id)
    true
}

pub fn declare_dyadic_participant(
    participant_state_id: i64,
    role: i64,
    numerator: i64,
    denominator: i64,
    component_bound: i64,
) -> DyadicParticipantStateReceipt with Panic {
    assert(participant_state_id > 0)
    assert(role == 0 || role == 1)
    let value = exact_dyadic_rational(numerator, denominator, component_bound)
    DyadicParticipantStateReceipt {
        participant_state_id: participant_state_id,
        role: role,
        projection_numerator: value.numerator,
        projection_denominator: value.denominator,
        synthetic_role_only: true,
        real_person_identified: false,
    }
}

pub fn declare_relational_state(
    relational_state_id: i64,
    numerator: i64,
    denominator: i64,
    component_bound: i64,
) -> RelationalStateReceipt with Panic {
    assert(relational_state_id > 0)
    let value = exact_dyadic_rational(numerator, denominator, component_bound)
    RelationalStateReceipt {
        relational_state_id: relational_state_id,
        projection_numerator: value.numerator,
        projection_denominator: value.denominator,
        declared_state_complete: false,
        therapeutic_alliance_claimed: false,
    }
}

pub fn declare_relational_history(
    history_state_id: i64,
    predictive_mode: i64,
    annotation_id: i64,
    provenance_id: i64,
) -> RelationalHistoryStateReceipt with Panic {
    assert(history_state_id > 0)
    assert(predictive_mode >= 0 && predictive_mode <= 4)
    assert(annotation_id > 0)
    assert(provenance_id > 0)
    RelationalHistoryStateReceipt {
        history_state_id: history_state_id,
        predictive_mode: predictive_mode,
        annotation_id: annotation_id,
        provenance_id: provenance_id,
        ordered_history_retained: true,
        unbounded_history_claimed: false,
    }
}

pub fn declare_dyadic_context(
    context_id: i64,
    context_code: i64,
) -> DyadicContextReceipt with Panic {
    assert(context_id > 0)
    assert(context_code >= 0)
    DyadicContextReceipt {
        context_id: context_id,
        declared_context_code: context_code,
        context_complete_claimed: false,
        physically_bound: false,
    }
}

pub fn declare_dyadic_candidate(
    candidate_id: i64,
    rule_id: i64,
    schema: DyadicObservationSchemaReceipt,
    left: DyadicParticipantStateReceipt,
    right: DyadicParticipantStateReceipt,
    relation: RelationalStateReceipt,
    history: RelationalHistoryStateReceipt,
    context: DyadicContextReceipt,
) -> DyadicCandidateStateReceipt with Panic {
    assert(candidate_id > 0 && rule_id > 0)
    assert(left.role == 0 && right.role == 1)
    assert(!schema.exposes_candidate_id && !schema.exposes_history_id)
    DyadicCandidateStateReceipt {
        candidate_id: candidate_id,
        rule_id: rule_id,
        schema_id: schema.schema_id,
        left_state_id: left.participant_state_id,
        left_numerator: left.projection_numerator,
        left_denominator: left.projection_denominator,
        right_state_id: right.participant_state_id,
        right_numerator: right.projection_numerator,
        right_denominator: right.projection_denominator,
        relational_state_id: relation.relational_state_id,
        relational_numerator: relation.projection_numerator,
        relational_denominator: relation.projection_denominator,
        history_state_id: history.history_state_id,
        predictive_mode: history.predictive_mode,
        history_annotation_id: history.annotation_id,
        history_provenance_id: history.provenance_id,
        context_id: context.context_id,
        context_code: context.declared_context_code,
        synthetic_not_patient_data: true,
        subjective_experience_claimed: false,
        clinical_authority: false,
    }
}

pub fn prove_dyadic_collision(
    collision_id: i64,
    left: DyadicCandidateStateReceipt,
    right: DyadicCandidateStateReceipt,
    comparison_bound: BoundedDyadicProductReceipt,
) -> DyadicProjectionCollisionReceipt with Panic {
    assert(collision_id > 0)
    assert(left.candidate_id != right.candidate_id)
    assert(left.rule_id == right.rule_id)
    assert(left.schema_id == right.schema_id)
    assert(left.left_state_id == right.left_state_id)
    assert(left.left_numerator == right.left_numerator)
    assert(left.left_denominator == right.left_denominator)
    assert(left.right_state_id == right.right_state_id)
    assert(left.right_numerator == right.right_numerator)
    assert(left.right_denominator == right.right_denominator)
    assert(left.relational_state_id == right.relational_state_id)
    let left_relation = exact_dyadic_rational(
        left.relational_numerator, left.relational_denominator,
        comparison_bound.left_max,
    )
    let right_relation = exact_dyadic_rational(
        right.relational_numerator, right.relational_denominator,
        comparison_bound.left_max,
    )
    assert(exact_dyadic_equal(left_relation, right_relation, comparison_bound))
    assert(left.context_id == right.context_id)
    assert(left.context_code == right.context_code)
    assert(left.history_state_id != right.history_state_id)
    assert(left.predictive_mode != right.predictive_mode ||
        left.history_annotation_id != right.history_annotation_id)
    DyadicProjectionCollisionReceipt {
        collision_id: collision_id,
        rule_id: left.rule_id,
        schema_id: left.schema_id,
        left_candidate_id: left.candidate_id,
        right_candidate_id: right.candidate_id,
        full_left_states_equal: true,
        full_right_states_equal: true,
        full_relational_states_equal: true,
        contexts_equal: true,
        current_observations_equal: true,
        relational_histories_distinct: true,
        history_only_candidate_difference: true,
        real_dyadic_identity_established: false,
    }
}

pub fn declare_common_dyadic_input(
    input_id: i64,
    rule_id: i64,
    tick: i64,
    probe_index: i64,
    payload_numerator: i64,
    payload_denominator: i64,
) -> CommonDyadicInputReceipt with Panic {
    assert(input_id > 0 && rule_id > 0 && tick > 0)
    assert(probe_index >= 0 && probe_index <= 2)
    assert(payload_numerator >= 0 && payload_denominator > 0)
    CommonDyadicInputReceipt {
        input_id: input_id,
        rule_id: rule_id,
        tick: tick,
        probe_index: probe_index,
        payload_numerator: payload_numerator,
        payload_denominator: payload_denominator,
        candidate_specific: false,
        same_schedule_for_compared_paths: true,
        physical_intervention_claimed: false,
        clinical_authority: false,
    }
}

pub fn dyadic_observation_numerator(
    predictive_mode: i64,
    probe_index: i64,
) -> i64 with Panic {
    assert(predictive_mode >= 0 && predictive_mode <= 4)
    assert(probe_index >= 0 && probe_index <= 2)
    if predictive_mode == 0 {
        if probe_index == 0 { 400 }
        else if probe_index == 1 { 450 }
        else { 500 }
    } else if predictive_mode == 1 {
        if probe_index == 0 { 400 }
        else if probe_index == 1 { 550 }
        else { 500 }
    } else if predictive_mode == 2 {
        if probe_index == 0 { 600 }
        else if probe_index == 1 { 450 }
        else { 500 }
    } else if predictive_mode == 3 {
        if probe_index == 0 { 600 }
        else if probe_index == 1 { 450 }
        else { 650 }
    } else {
        500
    }
}

pub fn advance_dyadic_candidate(
    step_id: i64,
    candidate: DyadicCandidateStateReceipt,
    input: CommonDyadicInputReceipt,
) -> DyadicTransitionStepReceipt with Panic {
    assert(step_id > 0)
    assert(candidate.rule_id == input.rule_id)
    assert(!input.candidate_specific)
    assert(input.same_schedule_for_compared_paths)
    let result_numerator = dyadic_observation_numerator(
        candidate.predictive_mode, input.probe_index,
    )
    DyadicTransitionStepReceipt {
        step_id: step_id,
        rule_id: candidate.rule_id,
        schema_id: candidate.schema_id,
        candidate_id: candidate.candidate_id,
        input_id: input.input_id,
        probe_index: input.probe_index,
        source_relational_numerator: candidate.relational_numerator,
        source_relational_denominator: candidate.relational_denominator,
        result_relational_numerator: result_numerator,
        result_relational_denominator: 1000,
        predictive_mode_retained: candidate.predictive_mode,
        history_annotation_retained: candidate.history_annotation_id,
        context_code_retained: candidate.context_code,
        participant_states_unchanged: true,
        common_input_verified: true,
        exact_transition_replayed: true,
    }
}

pub fn prove_dyadic_non_reduction(
    witness_id: i64,
    collision: DyadicProjectionCollisionReceipt,
    left_step: DyadicTransitionStepReceipt,
    right_step: DyadicTransitionStepReceipt,
    comparison_bound: BoundedDyadicProductReceipt,
) -> DyadicNonReductionWitness with Div, Panic {
    assert(witness_id > 0)
    assert(collision.history_only_candidate_difference)
    assert(left_step.candidate_id == collision.left_candidate_id)
    assert(right_step.candidate_id == collision.right_candidate_id)
    assert(left_step.input_id == right_step.input_id)
    assert(left_step.probe_index == right_step.probe_index)
    assert(left_step.common_input_verified && right_step.common_input_verified)
    let left = exact_dyadic_rational(
        left_step.result_relational_numerator,
        left_step.result_relational_denominator,
        comparison_bound.left_max,
    )
    let right = exact_dyadic_rational(
        right_step.result_relational_numerator,
        right_step.result_relational_denominator,
        comparison_bound.left_max,
    )
    assert(!exact_dyadic_equal(left, right, comparison_bound))
    let denominator_bound = authorize_dyadic_product(
        comparison_bound.right_max,
        comparison_bound.right_max,
        comparison_bound.carrier_max,
    )
    assert(left.denominator <= denominator_bound.left_max)
    assert(right.denominator <= denominator_bound.right_max)
    let left_cross = left.numerator * right.denominator
    let right_cross = right.numerator * left.denominator
    let separation = DyadicExactSeparationReceipt {
        separation_id: witness_id,
        left_numerator: left.numerator,
        left_denominator: left.denominator,
        right_numerator: right.numerator,
        right_denominator: right.denominator,
        signed_cross_difference: left_cross - right_cross,
        cross_denominator: left.denominator * right.denominator,
        exact_nonzero: true,
    }
    DyadicNonReductionWitness {
        witness_id: witness_id,
        collision_id: collision.collision_id,
        common_input_id: left_step.input_id,
        exact_separation: separation,
        history_adds_predictive_information: true,
        participant_product_sufficient: false,
        declared_current_state_markov_sufficient: false,
        bounded_synthetic_scope_only: true,
        causal_mechanism_established: false,
        subjective_suffering_established: false,
        clinical_authority: false,
    }
}

pub fn prove_factorable_dyadic_null(
    family_id: i64,
    left: DyadicCandidateStateReceipt,
    right: DyadicCandidateStateReceipt,
) -> FactorableDyadicNullReceipt with Panic {
    assert(family_id > 0)
    assert(left.predictive_mode == right.predictive_mode)
    assert(left.history_annotation_id != right.history_annotation_id)
    assert(dyadic_observation_numerator(left.predictive_mode, 0) ==
        dyadic_observation_numerator(right.predictive_mode, 0))
    assert(dyadic_observation_numerator(left.predictive_mode, 1) ==
        dyadic_observation_numerator(right.predictive_mode, 1))
    assert(dyadic_observation_numerator(left.predictive_mode, 2) ==
        dyadic_observation_numerator(right.predictive_mode, 2))
    FactorableDyadicNullReceipt {
        family_id: family_id,
        predictive_modes_equal: true,
        annotations_distinct: true,
        annotation_not_read_by_transition: true,
        every_probe_trace_equal: true,
        residual_block_count: 1,
        non_reduction_authorized: false,
        global_equivalence_claimed: false,
    }
}

pub fn record_horizon_limited_dyadic_ambiguity(
    null_receipt: FactorableDyadicNullReceipt,
    horizon_bound: i64,
) -> HorizonLimitedDyadicAmbiguityReceipt with Panic {
    assert(horizon_bound > 0)
    assert(null_receipt.every_probe_trace_equal)
    assert(null_receipt.residual_block_count > 0)
    assert(!null_receipt.global_equivalence_claimed)
    HorizonLimitedDyadicAmbiguityReceipt {
        family_id: null_receipt.family_id,
        horizon_bound: horizon_bound,
        residual_block_count: null_receipt.residual_block_count,
        bounded_search_complete: true,
        global_equivalence_established: false,
    }
}

pub fn record_context_expansion_rival(
    rival_id: i64,
    promoted_left_context: i64,
    promoted_right_context: i64,
) -> ContextExpansionRivalReceipt with Panic {
    assert(rival_id > 0)
    assert(promoted_left_context >= 0 && promoted_right_context >= 0)
    assert(promoted_left_context != promoted_right_context)
    ContextExpansionRivalReceipt {
        rival_id: rival_id,
        apparent_history_separation: true,
        promoted_contexts_equal: false,
        omitted_context_explains_separation: true,
        history_only_claim_authorized: false,
    }
}

pub fn record_markov_state_expansion_rival(
    rival_id: i64,
    left_statistic: i64,
    right_statistic: i64,
    probe_index: i64,
    left_observed: i64,
    right_observed: i64,
) -> MarkovStateExpansionRivalReceipt with Panic {
    assert(rival_id > 0)
    assert(left_statistic != right_statistic)
    assert(left_observed == dyadic_observation_numerator(left_statistic, probe_index))
    assert(right_observed == dyadic_observation_numerator(right_statistic, probe_index))
    MarkovStateExpansionRivalReceipt {
        rival_id: rival_id,
        sufficient_statistic_promoted: true,
        expanded_relational_states_distinct: true,
        expanded_state_reproduces_both_outputs: true,
        markov_factorability_restored: true,
        participant_product_non_reduction_preserved: true,
        unbounded_history_irreducibility_claimed: false,
    }
}

pub fn force_dyadic_search_incomplete(
    family_id: i64,
    requested_node_budget: i64,
    required_node_count: i64,
) -> DyadicSearchIncompleteReceipt with Panic {
    assert(family_id > 0)
    assert(requested_node_budget >= 0)
    assert(required_node_count > requested_node_budget)
    DyadicSearchIncompleteReceipt {
        family_id: family_id,
        requested_node_budget: requested_node_budget,
        required_node_count: required_node_count,
        node_budget_exhausted: true,
        search_complete: false,
        ambiguity_authorized: false,
        minimality_authorized: false,
    }
}

// Boundary-only types. D0 has no constructors for these stronger claims.
pub struct PairOfParticipantStates {
    pub left_state_id: i64,
