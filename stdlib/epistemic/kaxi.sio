// stdlib/epistemic/kaxi.sio — K-axis batched epistemic reduction.
//
// kaxi_fuse fuses N INDEPENDENT Knowledge<f64> measurements of the SAME scalar quantity
// into one posterior, by inverse-variance (precision) weighting — the N-measurement
// generalization of the pairwise normal-normal `observe` update (M1-reviewed, xai/Grok):
//
//   precision_i = 1 / σ_i²       (σ_i = uncertainty_of(k_i))
//   σ²_post     = 1 / Σ precision_i
//   μ_post      = σ²_post · Σ (μ_i · precision_i)
//
// Order-independent (Σ commutes). Requires σ_i > 0 for every element. Empty Seq returns a
// no-information default (mean 0, very large uncertainty).

pub fn kaxi_fuse(s: Seq<Knowledge<f64>>) -> Knowledge<f64> with Alloc, Mut, Epistemic, Div, Panic {
    let n: i64 = s.count()
    if n <= 0 {
        return measure(0.0, uncertainty: 1000000.0)
    }
    var i: i64 = 0
    var acc_prec: f64 = 0.0
    var acc_mean: f64 = 0.0
    while i < n {
        let k: Knowledge<f64> = s[i]
        let v: f64 = acknowledge(k, "kaxi_fuse element")
        let sigma: f64 = uncertainty_of(k)
        let prec: f64 = 1.0 / (sigma * sigma)
        acc_prec = acc_prec + prec
        acc_mean = acc_mean + v * prec
        i = i + 1
    }
    let var_post: f64 = 1.0 / acc_prec
    let mean_post: f64 = var_post * acc_mean
    return measure(mean_post, uncertainty: sqrt(var_post))
}
