pub struct ClinicalRebracketingActionReceipt { pub action_id: i64 }
pub struct RebracketingConsentReceipt { pub consent_id: i64 }
pub struct RebracketingSufferingReceipt { pub suffering_id: i64 }

fn bounded_semantic_result_code(
    status: i64,
    survivor_mask: i64,
    burden: i64,
    evidence_count: i64,
    evidence_fingerprint: i64,
) -> i64 with Panic {
    assert(status >= 0 && status <= 3)
    assert(survivor_mask >= 0 && survivor_mask <= 3)
    assert(burden >= 0 && burden <= 7)
    assert(evidence_count >= 0 && evidence_count <= 2)
    assert(evidence_fingerprint >= 0 && evidence_fingerprint < 1000000)
    let code = (((status * 31 + survivor_mask) * 31 + burden) * 31 +
        evidence_count) * 1000000 + evidence_fingerprint
    assert(code >= 0 && code <= 92475999999)
    code
}

fn frozen_flat_left(a_atom_id: i64, b_atom_id: i64, c_atom_id: i64) -> i64
with Panic {
    assert(a_atom_id == 9101 && b_atom_id == 9102 && c_atom_id == 9103)
    (a_atom_id * 101 + b_atom_id) * 101 + c_atom_id
}

fn frozen_flat_right(a_atom_id: i64, b_atom_id: i64, c_atom_id: i64) -> i64
with Panic {
    assert(a_atom_id == 9101 && b_atom_id == 9102 && c_atom_id == 9103)
    a_atom_id * 10201 + (b_atom_id * 101 + c_atom_id)
}

fn validate_d7_protocol_request(request: RebracketingProtocolRequestReceipt) with Panic {
    assert(request.request_id > 0 && request.fixture_occurrence_id > 0)
    assert(request.protocol_id == 8700)
    assert(request.candidate_kind_code == 1 || request.candidate_kind_code == 2)
    assert(request.operator_id == 9801 || request.operator_id == 9601)
    assert(request.a_atom_id == 9101 && request.b_atom_id == 9102)
    assert(request.c_atom_id == 9103)
    assert(request.ordered_atom_fingerprint == 93767706)
    assert(request.source_tree_fingerprint == 9037326)
    assert(request.target_tree_fingerprint == 573396)
    assert(request.same_typed_operands && request.same_ordered_operands)
    assert(request.same_operator && request.both_trees_defined)
    assert(request.local_scope_requested && !request.global_scope_requested)
    assert(request.exact_ordered_atom_ids_carried)
    assert(!request.fingerprint_used_as_identity)
    assert(request.public_model_receipt)
    assert(!request.compiler_capability_bound)
    assert(!request.native_contest_carrier_established)
    if request.candidate_kind_code == 1 {
        assert(request.fixture_occurrence_id == 11001)
        assert(request.operator_id == 9801)
        assert(request.source_result_code == 93767706)
        assert(request.target_result_code == 93767706)
        assert(request.results_equal_on_supplied_evidence)
    } else {
        assert(request.fixture_occurrence_id == 11002)
        assert(request.operator_id == 9601)
        assert(request.source_result_code == 62559008101)
        assert(request.target_result_code == 91514259234)
        assert(!request.results_equal_on_supplied_evidence)
    }
}

fn validate_d7_local_equality_decision(decision: LocalRebracketingEqualityDecisionReceipt)
with Panic {
    assert(decision.decision_id == 10201 && decision.request_id == 10101)
    assert(decision.protocol_id == 8700 && decision.fixture_occurrence_id == 11001)
    assert(decision.operator_id == 9801)
    assert(decision.a_atom_id == 9101 && decision.b_atom_id == 9102)
    assert(decision.c_atom_id == 9103)
    assert(decision.source_tree_fingerprint == 9037326)
    assert(decision.target_tree_fingerprint == 573396)
    assert(decision.source_result_code == 93767706)
    assert(decision.target_result_code == 93767706)
    assert(decision.evidence_control_id == 9702)
    assert(decision.decision_audit_checksum == 322833)
    assert(decision.exact_equal_on_frozen_occurrence)
    assert(decision.same_typed_operands && decision.same_ordered_operands)
    assert(decision.same_operator && decision.both_trees_defined)
    assert(decision.exact_ordered_atom_ids_carried)
    assert(decision.fixture_occurrence_bound)
    assert(!decision.reusable_across_occurrences)
    assert(decision.model_equality_decision_only && decision.public_model_receipt)
    assert(!decision.receipt_construction_sealed)
    assert(!decision.universal_associativity_law_established)
    assert(!decision.compiler_operator_admission_evidence_supplied)
    assert(!decision.compiler_capability_bound)
    assert(!decision.native_contest_carrier_established)
}

pub fn declare_local_flat_rebracketing_request(
    request_id: i64,
    fixture_occurrence_id: i64,
    control: FlatTraceAssociativeControlReceipt,
    witness: PolicyObservationNonAssociativityReceipt,
) -> RebracketingProtocolRequestReceipt with Panic {
    assert(request_id > 0 && fixture_occurrence_id > 0)
    assert(control.control_id > 0)
    assert(control.left_grouped_fingerprint == 93767706)
    assert(control.right_grouped_fingerprint == 93767706)
    assert(control.leaf_count == 3)
    assert(control.exact_equal && control.concatenation_associative_on_witness)
    assert(control.all_six_frozen_label_orders_encoded)
    assert(control.frozen_label_order_checksums_distinct)
    assert(!control.semantic_carrier_associative_claimed)
    assert(witness.witness_id == 9701 && witness.operator_id == 9601)
    assert(witness.a_atom_id == 9101 && witness.b_atom_id == 9102)
    assert(witness.c_atom_id == 9103)
    assert(witness.ordered_atom_fingerprint == 93767706)
    assert(witness.left_grouping_tree_fingerprint == 9037326)
    assert(witness.right_grouping_tree_fingerprint == 573396)
    assert(witness.same_typed_operands && witness.same_ordered_operands)
    assert(witness.both_parenthesizations_defined)
    let flat_left = frozen_flat_left(
        witness.a_atom_id, witness.b_atom_id, witness.c_atom_id,
    )
    let flat_right = frozen_flat_right(
        witness.a_atom_id, witness.b_atom_id, witness.c_atom_id,
    )
    assert(flat_left == control.left_grouped_fingerprint)
    assert(flat_right == control.right_grouped_fingerprint)
    let request = RebracketingProtocolRequestReceipt {
        request_id: request_id,
        protocol_id: 8700,
        fixture_occurrence_id: fixture_occurrence_id,
        candidate_kind_code: 1,
        operator_id: 9801,
        a_atom_id: witness.a_atom_id,
        b_atom_id: witness.b_atom_id,
        c_atom_id: witness.c_atom_id,
        ordered_atom_fingerprint: witness.ordered_atom_fingerprint,
        source_tree_fingerprint: witness.left_grouping_tree_fingerprint,
        target_tree_fingerprint: witness.right_grouping_tree_fingerprint,
        source_result_code: control.left_grouped_fingerprint,
        target_result_code: control.right_grouped_fingerprint,
        same_typed_operands: witness.same_typed_operands,
        same_ordered_operands: witness.same_ordered_operands,
        same_operator: true,
        both_trees_defined: true,
        results_equal_on_supplied_evidence: true,
        local_scope_requested: true,
        global_scope_requested: false,
        exact_ordered_atom_ids_carried: true,
        fingerprint_used_as_identity: false,
        public_model_receipt: true,
        compiler_capability_bound: false,
        native_contest_carrier_established: false,
    }
    validate_d7_protocol_request(request)
    request
}

pub fn declare_semantic_policy_rebracketing_request(
    request_id: i64,
    fixture_occurrence_id: i64,
    witness: PolicyObservationNonAssociativityReceipt,
) -> RebracketingProtocolRequestReceipt with Panic {
    assert(request_id > 0 && fixture_occurrence_id > 0)
    assert(witness.witness_id > 0 && witness.operator_id == 9601)
    assert(witness.a_atom_id == 9101 && witness.b_atom_id == 9102)
    assert(witness.c_atom_id == 9103)
    assert(witness.ordered_atom_fingerprint == 93767706)
    assert(witness.left_grouping_tree_fingerprint == 9037326)
    assert(witness.right_grouping_tree_fingerprint == 573396)
    assert(witness.same_typed_operands && witness.same_ordered_operands)
    assert(witness.same_partial_operator && witness.both_parenthesizations_defined)
    assert(witness.results_unequal && witness.difference_bitset == 15)
    let source_result = bounded_semantic_result_code(
        witness.left_probe_status_code,
        witness.left_survivor_mask,
        witness.left_burden_spent,
        witness.left_evidence_count,
        witness.left_evidence_fingerprint,
    )
    let target_result = bounded_semantic_result_code(
        witness.right_probe_status_code,
        witness.right_survivor_mask,
        witness.right_burden_spent,
        witness.right_evidence_count,
        witness.right_evidence_fingerprint,
    )
    assert(source_result == 62559008101)
    assert(target_result == 91514259234)
    let request = RebracketingProtocolRequestReceipt {
        request_id: request_id,
        protocol_id: 8700,
        fixture_occurrence_id: fixture_occurrence_id,
        candidate_kind_code: 2,
        operator_id: witness.operator_id,
        a_atom_id: witness.a_atom_id,
        b_atom_id: witness.b_atom_id,
        c_atom_id: witness.c_atom_id,
        ordered_atom_fingerprint: witness.ordered_atom_fingerprint,
        source_tree_fingerprint: witness.left_grouping_tree_fingerprint,
        target_tree_fingerprint: witness.right_grouping_tree_fingerprint,
        source_result_code: source_result,
        target_result_code: target_result,
        same_typed_operands: witness.same_typed_operands,
        same_ordered_operands: witness.same_ordered_operands,
        same_operator: witness.same_partial_operator,
        both_trees_defined: witness.both_parenthesizations_defined,
        results_equal_on_supplied_evidence: false,
        local_scope_requested: true,
        global_scope_requested: false,
        exact_ordered_atom_ids_carried: true,
        fingerprint_used_as_identity: false,
        public_model_receipt: true,
        compiler_capability_bound: false,
        native_contest_carrier_established: false,
    }
    validate_d7_protocol_request(request)
    request
}

pub fn decide_local_flat_rebracketing_equality(
    decision_id: i64,
    request: RebracketingProtocolRequestReceipt,
    control: FlatTraceAssociativeControlReceipt,
) -> LocalRebracketingEqualityDecisionReceipt with Panic {
    validate_d7_protocol_request(request)
    assert(decision_id > 0)
    assert(request.candidate_kind_code == 1 && request.operator_id == 9801)
    assert(control.control_id == 9702)
    assert(control.left_grouped_fingerprint == request.source_result_code)
    assert(control.right_grouped_fingerprint == request.target_result_code)
    assert(control.exact_equal && control.concatenation_associative_on_witness)
    assert(control.all_six_frozen_label_orders_encoded)
    assert(control.frozen_label_order_checksums_distinct)
    assert(!control.semantic_carrier_associative_claimed)
    let audit_checksum = request.request_id * 31 + control.control_id
    assert(audit_checksum == 322833)
    LocalRebracketingEqualityDecisionReceipt {
        decision_id: decision_id,
        request_id: request.request_id,
        protocol_id: request.protocol_id,
        fixture_occurrence_id: request.fixture_occurrence_id,
        operator_id: request.operator_id,
        a_atom_id: request.a_atom_id,
        b_atom_id: request.b_atom_id,
        c_atom_id: request.c_atom_id,
        source_tree_fingerprint: request.source_tree_fingerprint,
        target_tree_fingerprint: request.target_tree_fingerprint,
        source_result_code: request.source_result_code,
        target_result_code: request.target_result_code,
        evidence_control_id: control.control_id,
        decision_audit_checksum: audit_checksum,
        exact_equal_on_frozen_occurrence: true,
        same_typed_operands: request.same_typed_operands,
        same_ordered_operands: request.same_ordered_operands,
        same_operator: request.same_operator,
        both_trees_defined: request.both_trees_defined,
        exact_ordered_atom_ids_carried: request.exact_ordered_atom_ids_carried,
        fixture_occurrence_bound: true,
        reusable_across_occurrences: false,
        model_equality_decision_only: true,
        public_model_receipt: true,
        receipt_construction_sealed: false,
        universal_associativity_law_established: false,
        compiler_operator_admission_evidence_supplied: false,
        compiler_capability_bound: false,
        native_contest_carrier_established: false,
    }
}

pub fn replay_local_flat_rebracketing_model(
    replay_id: i64,
    decision: LocalRebracketingEqualityDecisionReceipt,
) -> LocalRebracketingModelReplayReceipt with Panic {
    assert(replay_id > 0)
    validate_d7_local_equality_decision(decision)
    let source_result = frozen_flat_left(
        decision.a_atom_id, decision.b_atom_id, decision.c_atom_id,
    )
    let target_result = frozen_flat_right(
        decision.a_atom_id, decision.b_atom_id, decision.c_atom_id,
    )
    assert(source_result == decision.source_result_code)
    assert(target_result == decision.target_result_code)
    assert(source_result == target_result)
    let audit_checksum = decision.decision_audit_checksum * 31 + replay_id
    assert(audit_checksum == 10018124)
    LocalRebracketingModelReplayReceipt {
        replay_id: replay_id,
        decision_id: decision.decision_id,
        request_id: decision.request_id,
        protocol_id: decision.protocol_id,
        fixture_occurrence_id: decision.fixture_occurrence_id,
        operator_id: decision.operator_id,
        a_atom_id: decision.a_atom_id,
        b_atom_id: decision.b_atom_id,
        c_atom_id: decision.c_atom_id,
        source_tree_fingerprint: decision.source_tree_fingerprint,
        target_tree_fingerprint: decision.target_tree_fingerprint,
        replayed_result_code: target_result,
        replay_audit_checksum: audit_checksum,
        exact_result_replayed: true,
        fixture_occurrence_bound: true,
        model_replay_recorded: true,
        model_replay_only: true,
        compiler_capability_consumed: false,
        source_ir_mutated: false,
        compiler_pass_executed: false,
    }
}

pub fn refuse_mismatched_fixture_occurrence_replay(
    refusal_id: i64,
    requested_fixture_occurrence_id: i64,
    decision: LocalRebracketingEqualityDecisionReceipt,
) -> FixtureOccurrenceReplayRefusalReceipt with Panic {
    assert(refusal_id > 0 && requested_fixture_occurrence_id > 0)
    validate_d7_local_equality_decision(decision)
    assert(requested_fixture_occurrence_id != decision.fixture_occurrence_id)
    let reason_mask = 1 + 2
    let base_checksum = (decision.decision_audit_checksum * 31 +
        requested_fixture_occurrence_id) * 31 + refusal_id
    let audit_checksum = base_checksum * 7 + reason_mask
    assert(reason_mask == 3 && base_checksum == 310594407)
    assert(audit_checksum == 2174160852)
    FixtureOccurrenceReplayRefusalReceipt {
        refusal_id: refusal_id,
        protocol_id: decision.protocol_id,
        decision_id: decision.decision_id,
        bound_fixture_occurrence_id: decision.fixture_occurrence_id,
        requested_fixture_occurrence_id: requested_fixture_occurrence_id,
        reason_mask: reason_mask,
        refusal_audit_checksum: audit_checksum,
        occurrence_mismatch_observed: true,
        cross_occurrence_reuse_refused: true,
        model_replay_recorded: false,
        compiler_authority_issued: false,
    }
}

pub fn refuse_semantic_policy_rebracketing(
    refusal_id: i64,
    request: RebracketingProtocolRequestReceipt,
    witness: PolicyObservationNonAssociativityReceipt,
    monotonicity: CommittedEvidenceMonotonicityReceipt,
    rival: GroupingRetainedRivalReceipt,
) -> SemanticRebracketingRefusalReceipt with Panic {
    validate_d7_protocol_request(request)
    assert(refusal_id > 0)
    assert(request.candidate_kind_code == 2 && request.operator_id == 9601)
    assert(witness.witness_id == 9701 && witness.operator_id == request.operator_id)
    assert(witness.results_unequal && witness.difference_bitset == 15)
    assert(witness.declared_partial_operator_nonassociative_on_witness)
    assert(!witness.total_magma_theorem_established)
    assert(monotonicity.receipt_id == 9704)
    assert(monotonicity.committed_before_outer_policy)
    assert(monotonicity.committed_after_outer_policy)
    assert(!monotonicity.retroactive_erasure_permitted)
    assert(monotonicity.monotone_only_in_declared_fixture)
    assert(rival.rival_id == 9703)
    assert(rival.projected_flat_payloads_equal)
    assert(!rival.projected_receipt_identities_equal)
    assert(rival.expanded_grouping_states_distinct)
    assert(rival.frozen_outcomes_reproduced_from_grouping)
    assert(!rival.same_complete_state_claimed)
    let reason_mask = 1 + 2 + 4 + 8 + 16
    let audit_checksum = ((request.request_id * 31 + witness.witness_id) * 31 +
        monotonicity.receipt_id) * 31 + rival.rival_id
    assert(reason_mask == 31 && audit_checksum == 310581870)
    SemanticRebracketingRefusalReceipt {
        refusal_id: refusal_id,
        request_id: request.request_id,
        protocol_id: request.protocol_id,
        fixture_occurrence_id: request.fixture_occurrence_id,
        operator_id: request.operator_id,
        nonassociativity_witness_id: witness.witness_id,
        monotonicity_receipt_id: monotonicity.receipt_id,
        grouping_rival_id: rival.rival_id,
        source_result_code: request.source_result_code,
        target_result_code: request.target_result_code,
        reason_mask: reason_mask,
        refusal_audit_checksum: audit_checksum,
        semantic_inequality_observed: true,
        committed_evidence_would_change: true,
        grouping_states_distinct: true,
        operator_nonassociative_on_witness: true,
        universal_law_absent: true,
        local_compiler_authority_issued: false,
        global_compiler_authority_issued: false,
    }
}

pub fn request_compiler_authority_promotion(
    promotion_request_id: i64,
    decision: LocalRebracketingEqualityDecisionReceipt,
) -> CompilerAuthorityPromotionRequestReceipt with Panic {
    assert(promotion_request_id > 0)
    validate_d7_local_equality_decision(decision)
    let audit_checksum = decision.decision_audit_checksum * 31 +
        promotion_request_id
    assert(audit_checksum == 10018324)
    CompilerAuthorityPromotionRequestReceipt {
        promotion_request_id: promotion_request_id,
        protocol_id: decision.protocol_id,
        local_decision_id: decision.decision_id,
        origin_fixture_occurrence_id: decision.fixture_occurrence_id,
        operator_id: decision.operator_id,
        promotion_request_audit_checksum: audit_checksum,
        global_scope_requested: true,
        universal_law_evidence_supplied: false,
        compiler_binding_evidence_supplied: false,
        sealed_capability_evidence_supplied: false,
        native_contest_evidence_supplied: false,
        compiler_operator_admission_evidence_supplied: false,
    }
}

pub fn abstain_from_compiler_authority_promotion(
    abstention_id: i64,
    promotion: CompilerAuthorityPromotionRequestReceipt,
    decision: LocalRebracketingEqualityDecisionReceipt,
) -> CompilerAuthorityPromotionAbstentionReceipt with Panic {
    assert(abstention_id > 0)
    validate_d7_local_equality_decision(decision)
    assert(promotion.promotion_request_id == 10501)
    assert(promotion.protocol_id == decision.protocol_id)
    assert(promotion.local_decision_id == decision.decision_id)
    assert(promotion.origin_fixture_occurrence_id == decision.fixture_occurrence_id)
    assert(promotion.operator_id == decision.operator_id)
    assert(promotion.global_scope_requested)
    assert(!promotion.universal_law_evidence_supplied)
    assert(!promotion.compiler_binding_evidence_supplied)
    assert(!promotion.sealed_capability_evidence_supplied)
    assert(!promotion.native_contest_evidence_supplied)
    assert(!promotion.compiler_operator_admission_evidence_supplied)
    let reason_mask = 1 + 2 + 4 + 8 + 16 + 32
    let base_checksum = promotion.promotion_request_audit_checksum * 31 +
        abstention_id
    let audit_checksum = base_checksum * 127 + reason_mask
    assert(reason_mask == 63 && base_checksum == 310578645)
    assert(audit_checksum == 39443487978)
    CompilerAuthorityPromotionAbstentionReceipt {
        abstention_id: abstention_id,
        promotion_request_id: promotion.promotion_request_id,
        protocol_id: decision.protocol_id,
        local_decision_id: decision.decision_id,
        origin_fixture_occurrence_id: decision.fixture_occurrence_id,
        operator_id: decision.operator_id,
        reason_mask: reason_mask,
        abstention_audit_checksum: audit_checksum,
        evidence_is_local_only: true,
        universal_quantification_absent: true,
        compiler_binding_absent: true,
        sealed_capability_absent: true,
        native_contest_evidence_absent: true,
        compiler_operator_admission_evidence_absent: true,
        global_law_issued: false,
        compiler_authority_issued: false,
    }
}

pub fn summarize_rebracketing_protocol(
    summary_id: i64,
    decision: LocalRebracketingEqualityDecisionReceipt,
    replay: LocalRebracketingModelReplayReceipt,
    replay_refusal: FixtureOccurrenceReplayRefusalReceipt,
    refusal: SemanticRebracketingRefusalReceipt,
    abstention: CompilerAuthorityPromotionAbstentionReceipt,
) -> RebracketingProtocolSummaryReceipt with Panic {
    assert(summary_id > 0)
    validate_d7_local_equality_decision(decision)
    assert(replay.replay_id == 10301)
    assert(replay.decision_id == decision.decision_id)
    assert(replay.protocol_id == decision.protocol_id)
    assert(replay.exact_result_replayed && replay.fixture_occurrence_bound)
    assert(replay.model_replay_recorded && replay.model_replay_only)
    assert(!replay.compiler_capability_consumed && !replay.source_ir_mutated)
    assert(!replay.compiler_pass_executed)
    assert(replay_refusal.refusal_id == 10801)
    assert(replay_refusal.protocol_id == decision.protocol_id)
    assert(replay_refusal.decision_id == decision.decision_id)
    assert(replay_refusal.bound_fixture_occurrence_id ==
        decision.fixture_occurrence_id)
    assert(replay_refusal.requested_fixture_occurrence_id == 11003)
    assert(replay_refusal.reason_mask == 3)
    assert(replay_refusal.occurrence_mismatch_observed)
    assert(replay_refusal.cross_occurrence_reuse_refused)
    assert(!replay_refusal.model_replay_recorded)
    assert(!replay_refusal.compiler_authority_issued)
    assert(refusal.refusal_id == 10401 && refusal.reason_mask == 31)
    assert(!refusal.local_compiler_authority_issued && !refusal.global_compiler_authority_issued)
    assert(abstention.abstention_id == 10601 && abstention.reason_mask == 63)
    assert(abstention.protocol_id == decision.protocol_id)
    assert(!abstention.global_law_issued)
    assert(!abstention.compiler_authority_issued)
    RebracketingProtocolSummaryReceipt {
        summary_id: summary_id,
        protocol_id: decision.protocol_id,
        decision_case_count: 3,
        local_equality_decision_count: 1,
        semantic_refusal_count: 1,
        compiler_promotion_abstention_count: 1,
        model_replay_count: 1,
        mismatched_fixture_replay_refusal_count: 1,
        compiler_capability_issue_count: 0,
        actual_compiler_rewrite_count: 0,
        native_contest_receipt_count: 0,
        all_three_declared_cases_recorded: true,
        sealed_receipt_construction_established: false,
        global_law_established: false,
        canonical_compiler_authority_established: false,
        native_contest_integration_established: false,
        ontology_runtime_transport_established: false,
        empirical_claim_established: false,
        clinical_authority: false,
    }
}
