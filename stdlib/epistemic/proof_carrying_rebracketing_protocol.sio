// Exact finite synthetic kernel for proof-carrying rebracketing protocol D7.
//
// An equality witness for one frozen occurrence can support one local model
// decision and replay. It cannot authorize a source or IR rewrite. The D6
// semantic counterexample instead produces a typed refusal. These public
// receipts are not sealed compiler capabilities, native Contest carriers,
// proof-assistant objects, or empirical/clinical authority.

use epistemic::proof_carrying_policy_observation_associator::{
    PolicyObservationNonAssociativityReceipt,
    FlatTraceAssociativeControlReceipt,
    GroupingRetainedRivalReceipt,
    CommittedEvidenceMonotonicityReceipt,
}

pub struct RebracketingProtocolRequestReceipt {
    pub request_id: i64,
    pub protocol_id: i64,
    pub fixture_occurrence_id: i64,
    pub candidate_kind_code: i64,
    pub operator_id: i64,
    pub a_atom_id: i64,
    pub b_atom_id: i64,
    pub c_atom_id: i64,
    pub ordered_atom_fingerprint: i64,
    pub source_tree_fingerprint: i64,
    pub target_tree_fingerprint: i64,
    pub source_result_code: i64,
    pub target_result_code: i64,
    pub same_typed_operands: bool,
    pub same_ordered_operands: bool,
    pub same_operator: bool,
    pub both_trees_defined: bool,
    pub results_equal_on_supplied_evidence: bool,
    pub local_scope_requested: bool,
    pub global_scope_requested: bool,
    pub exact_ordered_atom_ids_carried: bool,
    pub fingerprint_used_as_identity: bool,
    pub public_model_receipt: bool,
    pub compiler_capability_bound: bool,
    pub native_contest_carrier_established: bool,
}

