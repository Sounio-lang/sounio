// Deliberately unrelated authority and interpretation categories for negative
// gates. Their non-interchangeability is the executable policy boundary.
pub struct GlobalAssociativityLawReceipt { pub law_id: i64 }
pub struct CompilerOwnedRebracketingCapabilityBoundary { authority_id: i64 }
pub struct SemanticCarrierRewriteCapabilityBoundary {
    authority_id: i64,
}
pub struct ProofAssistantRebracketingTheoremReceipt { pub theorem_id: i64 }
pub struct EmpiricalRebracketingEquivalenceReceipt { pub receipt_id: i64 }
