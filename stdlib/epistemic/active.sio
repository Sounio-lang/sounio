// stdlib/epistemic/active.sio
//
// Active Inference: Uncertainty-Driven Exploration
//
// In Active Inference, agents minimize expected free energy by:
// 1. Reducing uncertainty about hidden states (exploration)
// 2. Achieving preferred outcomes (exploitation)
//
// High variance in an Epistemic value signals where to explore next.
//
// Core concepts
//
// - Expected Free Energy (EFE): combines epistemic value (information gain)
//   and pragmatic value (goal achievement).
// - Precision: inverse variance; high precision = confident knowledge.
// - Information gain: how much we expect to learn from an action.
//
// Representation
//
// Every function reads the flat `epistemic::knowledge::Epistemic`
// (val, variance, confidence: i64 on the 0..1000 scale). That struct carries
// no provenance and no Beta distribution; the confidence is a single integer.
//
// Belief update and the Beta posterior
//
// Before 2026-03-15 confidence was a `BetaConfidence` (a Beta(alpha, beta)
// distribution), and `update_belief` advanced it with
// `confidence.update(trunc(10 * evidence_ratio), 1)`: alpha += successes,
// beta += failures, then exploration read the Beta mean alpha / (alpha + beta).
// The integer confidence keeps that rule. The prior Beta is reconstructed
// from the integer as the Beta whose mean is c / 1000 and whose
// concentration alpha + beta is `prior_strength`:
//
//     alpha0 = prior_strength * c / 1000
//     beta0  = prior_strength * (1000 - c) / 1000
//
// the evidence is added as counts (successes = trunc(10 * evidence_ratio),
// failures = 1, exactly as before), and the posterior is mapped back to the
// integer scale through its mean:
//
//     c' = round(1000 * alpha / (alpha + beta))
//
// The integer carries the mean of the old Beta but not its concentration, so
// the concentration has to be chosen. `update_belief` uses 2, the
// concentration of Beta(1, 1): `Knowledge::measured` built every measured
// value with `BetaConfidence::uniform()`, so a fresh measured value at c = 500
// reconstructs exactly the prior the old code started from. Callers that know
// how much evidence stands behind a confidence pass it to
// `update_belief_with_prior_strength`.
//
// Collections
//
// Functions over several candidates take `&[Epistemic]` (and `&[f64]`
// for scalar side data). Action and observation lists are passed as two
// parallel `&[f64]` slices, not as a slice of tuples: a `&[(f64, f64)]`
// parameter reads zeros on Madaros native-v2 (measured 2026-10-30), and
// lean_single refuses the call. A selector given parallel slices of different
// lengths, or an empty candidate list, returns None: nothing is chosen from
// inputs that do not describe one candidate per index. `update_sequential`
// has no None to return and panics on mismatched lengths instead.
//
// Example
//
//     use epistemic::knowledge::{ep_new, Epistemic}
//     use epistemic::active::{exploration_priority}
//
//     let drug_a = ep_new(0.65, 0.0100, 500)   // small trial
//     let drug_b = ep_new(0.60, 0.0004, 500)   // large trial
//     let arms = [drug_a, drug_b]
//     let explore_first = exploration_priority(&arms)   // 0: drug_a

use epistemic::knowledge::{Epistemic, ep_new, ep_sqrt, ep_clamp_conf}
use math::pure::{ln}

// Floor applied to every variance before it is inverted, so that a certain
// value (variance 0) has a large finite precision instead of a division by 0.
pub fn active_variance_floor() -> f64 { 0.0000001 }

// Concentration (alpha + beta) of the Beta prior reconstructed from an integer
// confidence by `update_belief`. 2 = Beta(1, 1); see the header.
pub fn active_default_prior_strength() -> f64 { 2.0 }

// ============================================================================
// HELPERS
// ============================================================================

fn act_abs(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn act_max(a: f64, b: f64) -> f64 {
    if a > b { a } else { b }
}

fn act_min(a: f64, b: f64) -> f64 {
    if a < b { a } else { b }
}

// Truncation toward zero of a non-negative count. Values at or beyond 2^53
// are already integers in f64, and are returned unchanged rather than cast
// through i64 (which would overflow past 9.2e18).
fn act_trunc_count(x: f64) -> f64 {
    if x <= 0.0 { return 0.0 }
    if x >= 9007199254740992.0 { return x }
    (x as i64) as f64
}

// ============================================================================
// PRECISION AND INFORMATION METRICS
// ============================================================================

// Precision: inverse of variance (how confident are we?)
// Higher precision = more confident = less need to explore
pub fn precision(k: &Epistemic) -> f64 with Div {
    1.0 / act_max(k.variance, active_variance_floor())
}

// Differential entropy of a Gaussian belief: H = 0.5 * ln(2*pi*e * variance)
pub fn entropy(k: &Epistemic) -> f64 with Mut, Div, Panic {
    let two_pi_e = 17.079468445347132   // 2 * pi * e
    0.5 * ln(two_pi_e * act_max(k.variance, active_variance_floor()))
}

// Expected information gain from observing a variable
// For a Gaussian: IG = 0.5 * ln(prior_var / posterior_var)
//
// If we expect the posterior variance to be the prior variance times r:
// IG = 0.5 * ln(1 / r) = -0.5 * ln(r), with r clamped to [0.01, 1].
pub fn expected_info_gain(k: &Epistemic, expected_reduction: f64) -> f64 with Mut, Div, Panic {
    0.0 - 0.5 * ln(act_max(act_min(expected_reduction, 1.0), 0.01))
}

// Relative uncertainty: variance / value^2
// Useful for comparing uncertainties across different scales
pub fn relative_uncertainty(k: &Epistemic) -> f64 with Div {
    k.variance / act_max(k.val * k.val, active_variance_floor())
}

// Coefficient of variation: std / |mean|
pub fn coefficient_of_variation(k: &Epistemic) -> f64 with Mut, Div, Panic {
    ep_sqrt(k.variance) / act_max(act_abs(k.val), active_variance_floor())
}

// Confidence as a probability in [0, 1] (the mean of the Beta it encodes).
pub fn confidence_probability(k: &Epistemic) -> f64 with Div {
    (ep_clamp_conf(k.confidence) as f64) / 1000.0
}

// ============================================================================
// EXPLORATION PRIORITY
// ============================================================================

// Exploration score for a single Epistemic value
// Higher score = should explore this more
//
// Components:
// - Variance contribution: high variance -> high score
// - Confidence penalty: low confidence -> high score
// - Value bonus: important values get priority
pub fn exploration_score(k: &Epistemic, importance: f64) -> f64 with Mut, Div, Panic {
    let variance_term = ln(1.0 + act_max(k.variance, 0.0))
    let confidence_term = 1.0 - confidence_probability(k)
    variance_term + confidence_term + importance
}

// Index with the highest exploration priority (highest score = explore first).
// Ties keep the first index. An empty list returns 0; use `most_uncertain`
// when the list may be empty.
pub fn exploration_priority(values: &[Epistemic]) -> usize with Mut, Div, Panic {
    let n = values.len()
    if n == 0 { return 0 }

    // Elements are copied into a local before borrowing: lean_single refuses
    // `&values[i]` on a slice parameter ("value is not indexable").
    let first = values[0]
    var best_idx: usize = 0
    var best_score = exploration_score(&first, 1.0)

    var i: usize = 1
    while i < n {
        let vi = values[i]
        let s = exploration_score(&vi, 1.0)
        if s > best_score {
            best_score = s
            best_idx = i
        }
        i = i + 1
    }

    best_idx
}

// Index of the value most worth exploring, or None for an empty list.
// (An index, not the value: `Option` over a struct payload segfaults on
// Madaros native-v2, measured 2026-10-30; read the value as values[i].)
pub fn most_uncertain(values: &[Epistemic]) -> Option<usize> with Mut, Div, Panic {
    if values.len() == 0 {
        return None
    }
    let priority = exploration_priority(values)
    Some(priority)
}

// ============================================================================
// EXPECTED FREE ENERGY
// ============================================================================

// Expected Free Energy components
pub struct EFEComponents {
    // Epistemic value: expected information gain (never negative)
    pub epistemic: f64,

    // Pragmatic value: expected reward times its weight
    pub pragmatic: f64,

    // Total EFE = -epistemic - pragmatic (lower is better)
    pub total: f64,
}

pub fn efe_epistemic(e: &EFEComponents) -> f64 { e.epistemic }
pub fn efe_pragmatic(e: &EFEComponents) -> f64 { e.pragmatic }
pub fn efe_total(e: &EFEComponents) -> f64 { e.total }

// Compute Expected Free Energy for an action
//
// EFE = -epistemic_value - pragmatic_value
//     = -E[info_gain] - E[reward]
//
// We want to MINIMIZE EFE (maximize epistemic + pragmatic value)
pub fn expected_free_energy(
    current: &Epistemic,
    expected_posterior_var: f64,
    expected_reward: f64,
    reward_weight: f64,
) -> EFEComponents with Mut, Div, Panic {
    // Epistemic value: how much will we learn?
    let prior_var = act_max(current.variance, active_variance_floor())
    let post_var = act_max(expected_posterior_var, active_variance_floor())
    let info_gain = 0.5 * ln(prior_var / post_var)
    let epistemic = act_max(info_gain, 0.0)

    // Pragmatic value: how much reward do we expect?
    let pragmatic = expected_reward * reward_weight

    // EFE: we want to minimize this (so negate the values we want to maximize)
    let total = 0.0 - epistemic - pragmatic

    EFEComponents {
        epistemic: epistemic,
        pragmatic: pragmatic,
        total: total,
    }
}

// Select the action index that minimizes EFE.
// Action i reduces the variance by the factor var_reductions[i] and yields
// expected_rewards[i]. Ties keep the first index. Returns None for an empty
// action list or slices of different lengths.
pub fn select_action_idx(
    var_reductions: &[f64],
    expected_rewards: &[f64],
    current: &Epistemic,
    reward_weight: f64,
) -> Option<usize> with Mut, Div, Panic {
    let n = var_reductions.len()
    if n == 0 || expected_rewards.len() != n {
        return None
    }

    var best_idx: usize = 0
    var best_efe = 0.0
    var i: usize = 0
    while i < n {
        let posterior_var = current.variance * var_reductions[i]
        let efe = expected_free_energy(current, posterior_var, expected_rewards[i], reward_weight)
        if i == 0 || efe.total < best_efe {
            best_efe = efe.total
            best_idx = i
        }
        i = i + 1
    }

    Some(best_idx)
}

// ============================================================================
// BELIEF UPDATING (PREDICTIVE PROCESSING)
// ============================================================================

// Prediction error: difference between observation and belief
pub fn prediction_error(belief: &Epistemic, observation: f64) -> f64 {
    observation - belief.val
}

// Precision-weighted prediction error
// This is the key quantity in predictive processing
pub fn precision_weighted_error(belief: &Epistemic, observation: f64) -> f64 with Div {
    precision(belief) * (observation - belief.val)
}

// Beta posterior over the integer confidence (see the header).
//
// The prior Beta has mean confidence / 1000 and concentration prior_strength;
// successes and failures are added as counts; the result is the posterior
// mean on the 0..1000 scale, rounded half up. A confidence outside 0..1000 is
// clamped first. A prior_strength <= 0 is not a Beta prior and returns -1,
// as does a total with no mass (prior_strength + successes + failures <= 0),
// or negative counts.
pub fn beta_posterior_confidence(
    confidence: i64,
    prior_strength: f64,
    successes: f64,
    failures: f64,
) -> i64 with Div {
    if prior_strength <= 0.0 || successes < 0.0 || failures < 0.0 { return 0 - 1 }
    let p = (ep_clamp_conf(confidence) as f64) / 1000.0
    let alpha = prior_strength * p + successes
    let beta = prior_strength * (1.0 - p) + failures
    let total = alpha + beta
    if total <= 0.0 { return 0 - 1 }
    let scaled = 1000.0 * alpha / total + 0.5
    ep_clamp_conf(scaled as i64)
}

// Update belief with an observation using precision weighting
//
// posterior_mean = (prior_precision * prior_mean + obs_precision * obs)
//                / (prior_precision + obs_precision)
// posterior_var  = 1 / (prior_precision + obs_precision)
//
// Confidence: Beta posterior with successes = trunc(10 * obs_prec / prior_prec)
// and failures = 1, over a prior of concentration prior_strength.
// A prior_strength <= 0 leaves the confidence at 0 (no valid prior, no claim).
pub fn update_belief_with_prior_strength(
    prior: &Epistemic,
    observation: f64,
    observation_variance: f64,
    prior_strength: f64,
) -> Epistemic with Mut, Div, Panic {
    let prior_prec = precision(prior)
    let obs_prec = 1.0 / act_max(observation_variance, active_variance_floor())
    let total_prec = prior_prec + obs_prec

    let posterior_mean = (prior_prec * prior.val + obs_prec * observation) / total_prec
    let posterior_var = 1.0 / total_prec

    let evidence_ratio = obs_prec / prior_prec
    let successes = act_trunc_count(evidence_ratio * 10.0)
    var new_conf = beta_posterior_confidence(prior.confidence, prior_strength, successes, 1.0)
    if new_conf < 0 { new_conf = 0 }

    ep_new(posterior_mean, posterior_var, new_conf)
}

pub fn update_belief(
    prior: &Epistemic,
    observation: f64,
    observation_variance: f64,
) -> Epistemic with Mut, Div, Panic {
    update_belief_with_prior_strength(prior, observation, observation_variance,
                                      active_default_prior_strength())
}

// Sequential belief updating: observation i has value obs_values[i] and
// variance obs_variances[i].
//
// The confidence is exact cumulative Bayes: the Beta prior is rebuilt from
// prior.confidence once (mean c/1000, concentration
// active_default_prior_strength()), every observation adds its counts
// (successes = trunc(10 * obs_precision / current_precision), failures = 1) to
// the same alpha and beta, and the result is rounded to 0..1000 only at the end.
// Chaining update_belief instead would re-round the confidence and rebuild a
// strength-2 prior at every step, discarding the evidence already counted.
// The mean and variance follow the same precision weighting as update_belief.
//
// Slices of different lengths do not describe an observation sequence and
// panic (fail closed) rather than updating on a prefix.
pub fn update_sequential(
    prior: &Epistemic,
    obs_values: &[f64],
    obs_variances: &[f64],
) -> Epistemic with Mut, Div, Panic {
    let n = obs_values.len()
    if obs_variances.len() != n {
        panic("update_sequential: obs_values and obs_variances differ in length")
    }
    let n0 = active_default_prior_strength()
    let p0 = (ep_clamp_conf(prior.confidence) as f64) / 1000.0
    var alpha = n0 * p0
    var beta = n0 * (1.0 - p0)
    var mean = prior.val
    var variance = prior.variance
    var i: usize = 0
    while i < n {
        let ov = obs_values[i]
        let ou = obs_variances[i]
        let prior_prec = 1.0 / act_max(variance, active_variance_floor())
        let obs_prec = 1.0 / act_max(ou, active_variance_floor())
        let total_prec = prior_prec + obs_prec
        mean = (prior_prec * mean + obs_prec * ov) / total_prec
        variance = 1.0 / total_prec
        alpha = alpha + act_trunc_count(obs_prec / prior_prec * 10.0)
        beta = beta + 1.0
        i = i + 1
    }
    let conf = if n == 0 {
        ep_clamp_conf(prior.confidence)
    } else {
        ep_clamp_conf((1000.0 * alpha / (alpha + beta) + 0.5) as i64)
    }
    ep_new(mean, variance, conf)
}

// ============================================================================
// EXPLORATION STRATEGIES
// ============================================================================

// Index of the highest point estimate (ties keep the first index).
fn act_argmax_val(values: &[Epistemic]) -> usize with Mut {
    var best_idx: usize = 0
    var best_val = values[0].val
    var i: usize = 1
    while i < values.len() {
        if values[i].val > best_val {
            best_val = values[i].val
            best_idx = i
        }
        i = i + 1
    }
    best_idx
}

// Epsilon-greedy exploration
// With probability epsilon, explore (pick most uncertain)
// Otherwise exploit (pick highest value)
pub fn epsilon_greedy(
    values: &[Epistemic],
    epsilon: f64,
    random_value: f64,  // Should be in [0, 1]
) -> Option<usize> with Mut, Div, Panic {
    if values.len() == 0 {
        return None
    }
    if random_value < epsilon {
        let explore = exploration_priority(values)
        return Some(explore)
    }
    let exploit = act_argmax_val(values)
    Some(exploit)
}

// Upper Confidence Bound (UCB) selection
// Balances exploitation (high value) with exploration (high uncertainty)
//
// UCB = value + c * sqrt(variance)
pub fn ucb_select(values: &[Epistemic], exploration_constant: f64) -> Option<usize> with Mut, Div, Panic {
    if values.len() == 0 {
        return None
    }

    var best_idx: usize = 0
    var best_ucb = values[0].val + exploration_constant * ep_sqrt(values[0].variance)

    var i: usize = 1
    while i < values.len() {
        let ucb = values[i].val + exploration_constant * ep_sqrt(values[i].variance)
        if ucb > best_ucb {
            best_ucb = ucb
            best_idx = i
        }
        i = i + 1
    }

    Some(best_idx)
}

// Thompson Sampling: sample from posterior and pick highest
// Approximation: sample_i = value_i + z_i * sqrt(variance_i), z_i standard normal
// supplied by the caller. Fewer normals than values returns None.
pub fn thompson_select(values: &[Epistemic], random_normals: &[f64]) -> Option<usize> with Mut, Div, Panic {
    if values.len() == 0 || random_normals.len() < values.len() {
        return None
    }

    var best_idx: usize = 0
    var best_sample = values[0].val + random_normals[0] * ep_sqrt(values[0].variance)

    var i: usize = 1
    while i < values.len() {
        let sample = values[i].val + random_normals[i] * ep_sqrt(values[i].variance)
        if sample > best_sample {
            best_sample = sample
            best_idx = i
        }
        i = i + 1
    }

    Some(best_idx)
}
