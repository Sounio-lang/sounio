// Exact finite synthetic kernel for proof-carrying policy-state feedback D5.
//
// The fixture separates an observed anchor, a state summary, an adaptive
// policy decision, a coverage gap, a declared burden budget, and an observed
// target. It does not represent a real person, clinical policy, statistical
// positivity proof, causal feedback mechanism, consent, or treatment act.
// "Proof-carrying" means runtime-replayable bounded receipts, not a
// proof-assistant soundness theorem or compiler-sealed construction.

pub struct DeclaredPolicyTargetHypothesisReceipt {
    pub hypothesis_id: i64,
    pub mode: i64,
    pub declared_family_id: i64,
    pub anchor_value: i64,
    pub hidden_target_value: i64,
    pub synthetic_scope_only: bool,
    pub empirical_model_established: bool,
    pub clinical_authority: bool,
}

