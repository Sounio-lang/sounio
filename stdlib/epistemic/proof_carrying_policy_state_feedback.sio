struct PolicyStateContestStateReceipt {
    state_id: i64,
    family_id: i64,
    protocol_id: i64,
    budget_id: i64,
    survivor_mask: i64,
    survivor_count: i64,
    evidence_count: i64,
    burden_capacity: i64,
    burden_spent: i64,
    last_provenance_id: i64,
    provenance_fingerprint: i64,
    family_refuted: bool,
}

struct PolicyStateContestTransitionReceipt {
    transition_id: i64,
    evidence_kind: i64,
    family_id: i64,
    protocol_id: i64,
    budget_id: i64,
    source_state_id: i64,
    source_survivor_mask: i64,
    source_survivor_count: i64,
    source_evidence_count: i64,
    source_burden_capacity: i64,
    source_burden_spent: i64,
    source_last_provenance_id: i64,
    source_provenance_fingerprint: i64,
    result_survivor_mask: i64,
    result_survivor_count: i64,
    evidence_tick: i64,
    observed_value: i64,
    value_present: bool,
    provenance_id: i64,
    previous_provenance_id: i64,
    policy_decision_id: i64,
    assignment_id: i64,
    coverage_id: i64,
    declared_burden_units: i64,
    outside_adaptive_policy: bool,
    result_state: PolicyStateContestStateReceipt,
    exact_prediction_replay: bool,
}

fn as_i64(value: bool) -> i64 { if value { 1 } else { 0 } }

fn count_two_mask(mask: i64) -> i64 with Panic {
    assert(mask >= 0 && mask <= 3)
    as_i64(mask % 2 == 1) + as_i64((mask / 2) % 2 == 1)
}

fn anchor_for_mode(mode: i64) -> i64 with Panic {
    assert(mode == 0 || mode == 1)
    2
}

fn target_for_mode(mode: i64) -> i64 with Panic {
    assert(mode == 0 || mode == 1)
    if mode == 0 { 2 } else { 8 }
}

fn adaptive_probe_eligible_for_summary(summary_code: i64) -> bool with Panic {
    assert(summary_code == 2)
    false
}

fn validate_hypothesis(h: DeclaredPolicyTargetHypothesisReceipt) with Panic {
    assert(h.hypothesis_id > 0 && h.hypothesis_id <= 1000000)
    assert(h.mode == 0 || h.mode == 1)
    assert(h.declared_family_id > 0)
    assert(h.anchor_value == anchor_for_mode(h.mode))
    assert(h.hidden_target_value == target_for_mode(h.mode))
    assert(h.synthetic_scope_only)
    assert(!h.empirical_model_established)
    assert(!h.clinical_authority)
}

fn validate_family(f: AdaptiveObservationPolicyFamilyReceipt) with Panic {
    assert(f.family_id > 0 && f.protocol_id > 0)
    assert(f.low_hypothesis_id > 0 && f.low_hypothesis_id <= 1000000)
    assert(f.high_hypothesis_id > 0 && f.high_hypothesis_id <= 1000000)
    assert(f.low_hypothesis_id != f.high_hypothesis_id)
    assert(f.hypothesis_count == 2)
    assert(target_for_mode(0) != target_for_mode(1))
    assert(!f.family_exhaustive_in_reality)
    assert(f.synthetic_scope_only)
}

fn family_mode_for_hypothesis(
    family: AdaptiveObservationPolicyFamilyReceipt,
    hypothesis_id: i64,
) -> i64 with Panic {
    validate_family(family)
    assert(hypothesis_id == family.low_hypothesis_id ||
        hypothesis_id == family.high_hypothesis_id)
    if hypothesis_id == family.low_hypothesis_id { 0 } else { 1 }
}

fn family_anchor_prediction(
    family: AdaptiveObservationPolicyFamilyReceipt,
    hypothesis_id: i64,
) -> i64 with Panic {
    anchor_for_mode(family_mode_for_hypothesis(family, hypothesis_id))
}

fn family_target_prediction(
    family: AdaptiveObservationPolicyFamilyReceipt,
    hypothesis_id: i64,
) -> i64 with Panic {
    target_for_mode(family_mode_for_hypothesis(family, hypothesis_id))
}

fn family_policy_prediction(
    family: AdaptiveObservationPolicyFamilyReceipt,
    hypothesis_id: i64,
) -> bool with Panic {
    adaptive_probe_eligible_for_summary(
        family_anchor_prediction(family, hypothesis_id),
    )
}

fn validate_budget(b: DeclaredSyntheticObservationBudgetReceipt) with Panic {
    assert(b.budget_id > 0 && b.protocol_id > 0)
    assert(b.capacity_units == 7)
    assert(b.anchor_cost_units == 3)
    assert(b.coverage_probe_cost_units == 4)
    assert(b.anchor_cost_units + b.coverage_probe_cost_units == b.capacity_units)
    assert(b.synthetic_accounting_only)
    assert(!b.consent_authority)
    assert(!b.ethics_approval)
    assert(!b.subjective_suffering_measured)
    assert(!b.clinical_authority)
}

fn validate_provenance(p: PolicyEvidenceProvenanceReceipt) with Panic {
    assert(p.provenance_id > 0 && p.provenance_id <= 1000000)
    assert(p.source_id > 0 && p.protocol_id > 0)
    assert(p.tick == 1 || p.tick == 2)
    assert(p.previous_provenance_id >= 0 && p.previous_provenance_id <= 1000000)
    assert(p.policy_decision_id >= 0 && p.policy_decision_id <= 1000000)
    assert(p.chain_complete)
    assert(p.policy_retained)
}

fn validate_anchor(a: ObservedAnchorValueReceipt) with Panic {
    assert(a.observation_id > 0 && a.protocol_id > 0)
    assert(a.tick == 1 && a.observed_value == 2 && a.value_present)
    assert(a.provenance_id > 0 && a.provenance_id <= 1000000)
    assert(a.previous_provenance_id == 0)
    assert(a.declared_burden_units == 3)
    assert(!a.target_tick_observed)
    assert(!a.clinical_authority)
}

fn validate_state(s: PolicyStateContestStateReceipt) with Panic {
    assert(s.state_id > 0 && s.family_id > 0 && s.protocol_id > 0)
    assert(s.budget_id > 0)
    assert(s.survivor_mask >= 0 && s.survivor_mask <= 3)
    assert(s.survivor_count == count_two_mask(s.survivor_mask))
    assert(s.evidence_count >= 0 && s.evidence_count <= 2)
    assert(s.burden_capacity == 7)
    assert(s.burden_spent == 0 || s.burden_spent == 3 || s.burden_spent == 7)
    assert(s.burden_spent <= s.burden_capacity)
    assert(s.last_provenance_id >= 0 && s.last_provenance_id <= 1000000)
    assert(s.provenance_fingerprint >= 0 && s.provenance_fingerprint <= 32000000)
    assert(s.family_refuted == (s.survivor_count == 0))
    if s.evidence_count == 0 {
        assert(s.survivor_mask == 3 && s.survivor_count == 2)
        assert(s.burden_spent == 0)
        assert(s.last_provenance_id == 0 && s.provenance_fingerprint == 0)
    } else if s.evidence_count == 1 {
        assert(s.survivor_mask == 3 && s.survivor_count == 2)
        assert(s.burden_spent == 3)
        assert(s.last_provenance_id > 0)
        assert(s.provenance_fingerprint == s.last_provenance_id)
    } else {
        assert(s.survivor_mask == 1 || s.survivor_mask == 2)
        assert(s.survivor_count == 1 && s.burden_spent == 7)
        assert(s.last_provenance_id > 0)
        assert(s.provenance_fingerprint > s.last_provenance_id)
    }
}

fn validate_transition(t: PolicyStateContestTransitionReceipt) with Panic {
    assert(t.transition_id > 0)
    assert(t.evidence_kind == 1 || t.evidence_kind == 2)
    assert(t.family_id == t.result_state.family_id)
    assert(t.protocol_id == t.result_state.protocol_id)
    assert(t.budget_id == t.result_state.budget_id)
    assert(t.source_state_id > 0 && t.source_state_id != t.result_state.state_id)
    assert(t.source_survivor_mask >= 0 && t.source_survivor_mask <= 3)
    assert(t.source_survivor_count == count_two_mask(t.source_survivor_mask))
    assert(t.source_evidence_count >= 0 && t.source_evidence_count <= 1)
    assert(t.source_burden_capacity == 7)
    assert(t.source_burden_spent == 0 || t.source_burden_spent == 3)
    assert(t.source_last_provenance_id >= 0 && t.source_last_provenance_id <= 1000000)
    assert(t.source_provenance_fingerprint >= 0 &&
        t.source_provenance_fingerprint <= 1000000)
    assert(t.result_survivor_mask == t.result_state.survivor_mask)
    assert(t.result_survivor_count == t.result_state.survivor_count)
    assert(t.provenance_id > 0 && t.provenance_id <= 1000000)
    assert(t.previous_provenance_id == t.source_last_provenance_id)
    assert(t.result_state.last_provenance_id == t.provenance_id)
    assert(t.result_state.evidence_count == t.source_evidence_count + 1)
    assert(t.result_state.burden_capacity == t.source_burden_capacity)
    assert(t.result_state.burden_spent ==
        t.source_burden_spent + t.declared_burden_units)
    assert(t.result_state.provenance_fingerprint ==
        t.source_provenance_fingerprint * 31 + t.provenance_id)
    if t.evidence_kind == 1 {
        assert(t.source_survivor_mask == 3 && t.source_survivor_count == 2)
        assert(t.source_evidence_count == 0 && t.source_burden_spent == 0)
        assert(t.source_last_provenance_id == 0)
        assert(t.source_provenance_fingerprint == 0)
        assert(t.evidence_tick == 1 && t.observed_value == 2 && t.value_present)
        assert(t.previous_provenance_id == 0 && t.policy_decision_id == 0)
        assert(t.assignment_id == 0 && t.coverage_id == 0)
        assert(t.declared_burden_units == 3)
        assert(!t.outside_adaptive_policy)
        assert(t.result_survivor_mask == 3 && t.result_survivor_count == 2)
    } else {
        assert(t.source_survivor_mask == 3 && t.source_survivor_count == 2)
        assert(t.source_evidence_count == 1 && t.source_burden_spent == 3)
        assert(t.source_last_provenance_id > 0)
        assert(t.source_provenance_fingerprint == t.source_last_provenance_id)
        assert(t.evidence_tick == 2 && t.value_present)
        assert(t.observed_value == 2 || t.observed_value == 8)
        assert(t.policy_decision_id > 0 && t.policy_decision_id <= 1000000)
        assert(t.assignment_id > 0 && t.coverage_id > 0)
        assert(t.declared_burden_units == 4)
        assert(t.outside_adaptive_policy)
        let replayed_mask = if t.observed_value == 2 { 1 } else { 2 }
        assert(t.result_survivor_mask == replayed_mask)
        assert(t.result_survivor_count == 1)
    }
    assert(t.exact_prediction_replay)
    validate_state(t.result_state)
}

fn validate_summary(s: PolicyStateSummaryReceipt) with Panic {
    assert(s.summary_id > 0 && s.family_id > 0 && s.protocol_id > 0)
    assert(s.source_provenance_id > 0)
    assert(s.source_survivor_mask == 3 && s.source_survivor_count == 2)
    assert(s.summary_code == 2)
    assert(s.based_only_on_observed_anchor)
    assert(!s.hidden_target_value_included)
    assert(!s.target_identified)
    assert(!s.clinical_authority)
}

fn validate_decision(d: AdaptiveObservationPolicyDecisionReceipt) with Panic {
    assert(d.decision_id > 0 && d.decision_id <= 1000000)
    assert(d.summary_id > 0)
    assert(d.family_id > 0 && d.protocol_id > 0)
    assert(d.candidate_tick == 2 && d.summary_code == 2)
    assert(d.candidate_considered)
    assert(!d.eligible_under_adaptive_policy)
    assert(!d.scheduled)
    assert(d.withheld_by_adaptive_policy)
    assert(d.policy_retained_in_provenance)
    assert(!d.observed_target_claimed)
    assert(!d.participant_nonresponse_claimed)
    assert(!d.clinical_authority)
}

fn validate_feedback(f: BoundedPolicyStateFeedbackReceipt) with Panic {
    assert(f.feedback_id > 0 && f.family_id > 0 && f.protocol_id > 0)
    assert(f.bounded_iteration_count == 2)
    assert(f.first_summary_code == 2 && f.second_summary_code == 2)
    assert(!f.first_probe_eligible && !f.second_probe_eligible)
    assert(!f.first_probe_scheduled && !f.second_probe_scheduled)
    assert(f.observed_trace_equal_across_hypotheses)
    assert(f.policy_trace_equal_across_hypotheses)
    assert(f.absorbing_within_frozen_fixture)
    assert(f.feedback_fingerprint >= 0 && f.feedback_fingerprint <= 32000000)
    assert(!f.global_equilibrium_established)
    assert(!f.causal_feedback_mechanism_established)
    assert(!f.clinical_authority)
}

fn validate_coverage_gap(c: PolicyCoverageGapReceipt) with Panic {
    assert(c.coverage_id > 0 && c.decision_id > 0)
    assert(c.family_id > 0 && c.protocol_id > 0 && c.candidate_tick == 2)
    assert(c.eligible_opportunities == 0 && c.observed_opportunities == 0)
    assert(!c.discriminating_cell_covered)
    assert(!c.support_for_policy_comparison_present)
    assert(!c.statistical_positivity_established)
    assert(!c.global_overlap_established)
}

fn validate_probe(p: AdmissibleExogenousCoverageProbeReceipt) with Panic {
    assert(p.probe_id > 0 && p.family_id > 0 && p.protocol_id > 0)
    assert(p.assignment_id > 0 && p.coverage_id > 0 && p.target_tick == 2)
    assert(p.observed_value == 2 || p.observed_value == 8)
    assert(p.value_present)
    assert(p.provenance_id > 0 && p.provenance_id <= 1000000)
    assert(p.previous_provenance_id > 0 && p.previous_provenance_id <= 1000000)
    assert(p.policy_decision_id > 0 && p.policy_decision_id <= 1000000)
    assert(p.declared_burden_units == 4)
    assert(p.outside_adaptive_policy)
    assert(p.policy_withholding_overridden)
    assert(!p.global_positivity_established)
    assert(!p.clinical_authority)
}

fn validate_observed_target(v: ObservedTargetValueReceipt) with Panic {
    assert(v.observation_id > 0 && v.family_id > 0 && v.protocol_id > 0)
    assert(v.target_tick == 2)
    assert(v.observed_value == 2 || v.observed_value == 8)
    assert(v.provenance_id > 0 && v.provenance_id <= 1000000)
    assert(v.value_present)
    assert(v.synthetic_fixture_only)
    assert(!v.clinical_authority)
}

pub fn declare_policy_target_hypothesis(
    hypothesis_id: i64,
    mode: i64,
    family_id: i64,
) -> DeclaredPolicyTargetHypothesisReceipt with Panic {
    let h = DeclaredPolicyTargetHypothesisReceipt {
        hypothesis_id: hypothesis_id,
        mode: mode,
        declared_family_id: family_id,
        anchor_value: anchor_for_mode(mode),
        hidden_target_value: target_for_mode(mode),
        synthetic_scope_only: true,
        empirical_model_established: false,
        clinical_authority: false,
    }
    validate_hypothesis(h)
    h
}

pub fn declare_adaptive_observation_policy_family(
    family_id: i64,
    protocol_id: i64,
    low: DeclaredPolicyTargetHypothesisReceipt,
    high: DeclaredPolicyTargetHypothesisReceipt,
) -> AdaptiveObservationPolicyFamilyReceipt with Panic {
    validate_hypothesis(low)
    validate_hypothesis(high)
    assert(low.declared_family_id == family_id)
    assert(high.declared_family_id == family_id)
    assert(low.mode == 0 && high.mode == 1)
    let family = AdaptiveObservationPolicyFamilyReceipt {
        family_id: family_id,
        protocol_id: protocol_id,
        low_hypothesis_id: low.hypothesis_id,
        high_hypothesis_id: high.hypothesis_id,
        hypothesis_count: 2,
        family_exhaustive_in_reality: false,
        synthetic_scope_only: true,
    }
    validate_family(family)
    family
}

pub fn declare_synthetic_observation_budget(
    budget_id: i64,
    protocol_id: i64,
) -> DeclaredSyntheticObservationBudgetReceipt with Panic {
    let budget = DeclaredSyntheticObservationBudgetReceipt {
        budget_id: budget_id,
        protocol_id: protocol_id,
        capacity_units: 7,
        anchor_cost_units: 3,
        coverage_probe_cost_units: 4,
        synthetic_accounting_only: true,
        consent_authority: false,
        ethics_approval: false,
        subjective_suffering_measured: false,
        clinical_authority: false,
    }
    validate_budget(budget)
    budget
}

pub fn record_policy_evidence_provenance(
    provenance_id: i64,
    source_id: i64,
    protocol_id: i64,
    tick: i64,
    previous_provenance_id: i64,
    policy_decision_id: i64,
    exogenous_override_within_fixture: bool,
) -> PolicyEvidenceProvenanceReceipt with Panic {
    let p = PolicyEvidenceProvenanceReceipt {
        provenance_id: provenance_id,
        source_id: source_id,
        protocol_id: protocol_id,
        tick: tick,
        previous_provenance_id: previous_provenance_id,
        policy_decision_id: policy_decision_id,
        chain_complete: true,
        policy_retained: true,
        exogenous_override_within_fixture: exogenous_override_within_fixture,
    }
    validate_provenance(p)
    p
}

pub fn record_observed_anchor_value(
    observation_id: i64,
    provenance: PolicyEvidenceProvenanceReceipt,
) -> ObservedAnchorValueReceipt with Panic {
    validate_provenance(provenance)
    assert(provenance.tick == 1)
    assert(provenance.previous_provenance_id == 0)
    assert(provenance.policy_decision_id == 0)
    assert(!provenance.exogenous_override_within_fixture)
    let anchor = ObservedAnchorValueReceipt {
        observation_id: observation_id,
        protocol_id: provenance.protocol_id,
        tick: 1,
        observed_value: 2,
        value_present: true,
        provenance_id: provenance.provenance_id,
        previous_provenance_id: 0,
        declared_burden_units: 3,
        target_tick_observed: false,
        clinical_authority: false,
    }
    validate_anchor(anchor)
    anchor
}

pub fn begin_policy_state_contest(
    state_id: i64,
    family: AdaptiveObservationPolicyFamilyReceipt,
    budget: DeclaredSyntheticObservationBudgetReceipt,
) -> PolicyStateContestStateReceipt with Panic {
    validate_family(family)
    validate_budget(budget)
    assert(family.protocol_id == budget.protocol_id)
    let state = PolicyStateContestStateReceipt {
        state_id: state_id,
        family_id: family.family_id,
        protocol_id: family.protocol_id,
        budget_id: budget.budget_id,
        survivor_mask: 3,
        survivor_count: 2,
        evidence_count: 0,
        burden_capacity: budget.capacity_units,
        burden_spent: 0,
        last_provenance_id: 0,
        provenance_fingerprint: 0,
        family_refuted: false,
    }
    validate_state(state)
    state
}

pub fn update_policy_state_contest_with_anchor(
    transition_id: i64,
    result_state_id: i64,
    source: PolicyStateContestStateReceipt,
    family: AdaptiveObservationPolicyFamilyReceipt,
    anchor: ObservedAnchorValueReceipt,
) -> PolicyStateContestTransitionReceipt with Panic {
    validate_state(source)
    validate_family(family)
    validate_anchor(anchor)
    assert(source.family_id == family.family_id)
    assert(source.protocol_id == family.protocol_id)
    assert(anchor.protocol_id == family.protocol_id)
    assert(source.evidence_count == 0 && source.survivor_mask == 3)
    assert(source.last_provenance_id == 0)
    assert(source.burden_spent + anchor.declared_burden_units <= source.burden_capacity)
    let result = PolicyStateContestStateReceipt {
        state_id: result_state_id,
        family_id: source.family_id,
        protocol_id: source.protocol_id,
        budget_id: source.budget_id,
        survivor_mask: 3,
        survivor_count: 2,
        evidence_count: 1,
        burden_capacity: source.burden_capacity,
        burden_spent: source.burden_spent + anchor.declared_burden_units,
        last_provenance_id: anchor.provenance_id,
        provenance_fingerprint: source.provenance_fingerprint * 31 + anchor.provenance_id,
        family_refuted: false,
    }
    validate_state(result)
    PolicyStateContestTransitionReceipt {
        transition_id: transition_id,
        evidence_kind: 1,
        family_id: source.family_id,
        protocol_id: source.protocol_id,
        budget_id: source.budget_id,
        source_state_id: source.state_id,
        source_survivor_mask: source.survivor_mask,
        source_survivor_count: source.survivor_count,
        source_evidence_count: source.evidence_count,
        source_burden_capacity: source.burden_capacity,
        source_burden_spent: source.burden_spent,
        source_last_provenance_id: source.last_provenance_id,
        source_provenance_fingerprint: source.provenance_fingerprint,
        result_survivor_mask: result.survivor_mask,
        result_survivor_count: result.survivor_count,
        evidence_tick: anchor.tick,
        observed_value: anchor.observed_value,
        value_present: anchor.value_present,
        provenance_id: anchor.provenance_id,
        previous_provenance_id: anchor.previous_provenance_id,
        policy_decision_id: 0,
        assignment_id: 0,
        coverage_id: 0,
        declared_burden_units: anchor.declared_burden_units,
        outside_adaptive_policy: false,
        result_state: result,
        exact_prediction_replay: true,
    }
}

pub fn policy_state_transition_result(
    transition: PolicyStateContestTransitionReceipt,
) -> PolicyStateContestStateReceipt with Panic {
    validate_transition(transition)
    transition.result_state
}

pub fn policy_state_survivor_mask(state: PolicyStateContestStateReceipt) -> i64 with Panic {
    validate_state(state)
    state.survivor_mask
}

pub fn policy_state_survivor_count(state: PolicyStateContestStateReceipt) -> i64 with Panic {
    validate_state(state)
    state.survivor_count
}

pub fn policy_state_burden_spent(state: PolicyStateContestStateReceipt) -> i64 with Panic {
    validate_state(state)
    state.burden_spent
}

pub fn policy_state_burden_remaining(state: PolicyStateContestStateReceipt) -> i64 with Panic {
    validate_state(state)
    state.burden_capacity - state.burden_spent
}

pub fn policy_state_provenance_fingerprint(
    state: PolicyStateContestStateReceipt,
) -> i64 with Panic {
    validate_state(state)
    state.provenance_fingerprint
}

pub fn summarize_policy_state_after_anchor(
    summary_id: i64,
    state: PolicyStateContestStateReceipt,
) -> PolicyStateSummaryReceipt with Panic {
    validate_state(state)
    assert(state.evidence_count == 1 && state.survivor_mask == 3)
    assert(state.burden_spent == 3 && state.last_provenance_id > 0)
    let summary = PolicyStateSummaryReceipt {
        summary_id: summary_id,
        family_id: state.family_id,
        protocol_id: state.protocol_id,
        source_provenance_id: state.last_provenance_id,
        source_survivor_mask: state.survivor_mask,
        source_survivor_count: state.survivor_count,
        summary_code: 2,
        based_only_on_observed_anchor: true,
        hidden_target_value_included: false,
        target_identified: false,
        clinical_authority: false,
    }
    validate_summary(summary)
    summary
}

pub fn derive_adaptive_exploit_policy_decision(
    decision_id: i64,
    summary: PolicyStateSummaryReceipt,
) -> AdaptiveObservationPolicyDecisionReceipt with Panic {
    validate_summary(summary)
    let eligible = adaptive_probe_eligible_for_summary(summary.summary_code)
    let decision = AdaptiveObservationPolicyDecisionReceipt {
        decision_id: decision_id,
        summary_id: summary.summary_id,
        family_id: summary.family_id,
        protocol_id: summary.protocol_id,
        candidate_tick: 2,
        summary_code: summary.summary_code,
        candidate_considered: true,
        eligible_under_adaptive_policy: eligible,
        scheduled: eligible,
        withheld_by_adaptive_policy: !eligible,
        policy_retained_in_provenance: true,
        observed_target_claimed: false,
        participant_nonresponse_claimed: false,
        clinical_authority: false,
    }
    validate_decision(decision)
    decision
}

pub fn certify_policy_coverage_gap(
    coverage_id: i64,
    decision: AdaptiveObservationPolicyDecisionReceipt,
) -> PolicyCoverageGapReceipt with Panic {
    validate_decision(decision)
    let gap = PolicyCoverageGapReceipt {
        coverage_id: coverage_id,
        decision_id: decision.decision_id,
        family_id: decision.family_id,
        protocol_id: decision.protocol_id,
        candidate_tick: decision.candidate_tick,
        eligible_opportunities: 0,
        observed_opportunities: 0,
        discriminating_cell_covered: false,
        support_for_policy_comparison_present: false,
        statistical_positivity_established: false,
        global_overlap_established: false,
    }
    validate_coverage_gap(gap)
    gap
}

pub fn certify_policy_comparison_nonidentification(
    receipt_id: i64,
    gap: PolicyCoverageGapReceipt,
) -> PolicyComparisonNonidentificationReceipt with Panic {
    validate_coverage_gap(gap)
    PolicyComparisonNonidentificationReceipt {
        receipt_id: receipt_id,
        family_id: gap.family_id,
        protocol_id: gap.protocol_id,
        logging_policy_decision_id: gap.decision_id,
        support_present: false,
        statistical_positivity_established: false,
        target_policy_value_identified: false,
        counterfactual_policy_order_identified: false,
        global_policy_claim_authorized: false,
    }
}

pub fn certify_bounded_policy_state_feedback(
    feedback_id: i64,
    summary: PolicyStateSummaryReceipt,
    decision: AdaptiveObservationPolicyDecisionReceipt,
) -> BoundedPolicyStateFeedbackReceipt with Panic {
    validate_summary(summary)
    validate_decision(decision)
    assert(summary.summary_id == decision.summary_id)
    assert(summary.family_id == decision.family_id)
    assert(summary.protocol_id == decision.protocol_id)
    let observed_equal = anchor_for_mode(0) == anchor_for_mode(1)
    let policy_equal =
        adaptive_probe_eligible_for_summary(anchor_for_mode(0)) ==
            adaptive_probe_eligible_for_summary(anchor_for_mode(1))
    let bounded_absorbing =
        summary.summary_code == 2 &&
        decision.summary_code == summary.summary_code &&
        !decision.eligible_under_adaptive_policy && !decision.scheduled
    assert(observed_equal && policy_equal && bounded_absorbing)
    let feedback = BoundedPolicyStateFeedbackReceipt {
        feedback_id: feedback_id,
        family_id: summary.family_id,
        protocol_id: summary.protocol_id,
        bounded_iteration_count: 2,
        first_summary_code: summary.summary_code,
        second_summary_code: summary.summary_code,
        first_probe_eligible: decision.eligible_under_adaptive_policy,
        second_probe_eligible: decision.eligible_under_adaptive_policy,
        first_probe_scheduled: decision.scheduled,
        second_probe_scheduled: decision.scheduled,
        observed_trace_equal_across_hypotheses: observed_equal,
        policy_trace_equal_across_hypotheses: policy_equal,
        absorbing_within_frozen_fixture: bounded_absorbing,
        feedback_fingerprint: summary.source_provenance_id * 31 + decision.decision_id,
        global_equilibrium_established: false,
        causal_feedback_mechanism_established: false,
        clinical_authority: false,
    }
    validate_feedback(feedback)
    feedback
}

pub fn certify_policy_induced_target_ambiguity(
    ambiguity_id: i64,
    low: DeclaredPolicyTargetHypothesisReceipt,
    high: DeclaredPolicyTargetHypothesisReceipt,
    family: AdaptiveObservationPolicyFamilyReceipt,
    state: PolicyStateContestStateReceipt,
    summary: PolicyStateSummaryReceipt,
    decision: AdaptiveObservationPolicyDecisionReceipt,
    gap: PolicyCoverageGapReceipt,
) -> PolicyInducedTargetAmbiguityReceipt with Panic {
    validate_hypothesis(low)
    validate_hypothesis(high)
    validate_family(family)
    validate_state(state)
    validate_summary(summary)
    validate_decision(decision)
    validate_coverage_gap(gap)
    assert(low.mode == 0 && high.mode == 1)
    assert(low.hypothesis_id == family.low_hypothesis_id)
    assert(high.hypothesis_id == family.high_hypothesis_id)
    assert(family.family_id == state.family_id)
    assert(family.protocol_id == state.protocol_id)
    assert(low.declared_family_id == state.family_id)
    assert(high.declared_family_id == state.family_id)
    assert(summary.family_id == state.family_id)
    assert(decision.family_id == state.family_id)
    assert(gap.family_id == state.family_id)
    assert(summary.protocol_id == state.protocol_id)
    assert(decision.protocol_id == state.protocol_id)
    assert(gap.protocol_id == state.protocol_id)
    assert(summary.source_provenance_id == state.last_provenance_id)
    assert(summary.summary_id == decision.summary_id)
    assert(decision.decision_id == gap.decision_id)
    assert(state.survivor_mask == 3 && state.survivor_count == 2)
    assert(low.anchor_value == high.anchor_value)
    assert(low.hidden_target_value != high.hidden_target_value)
    let observed_equal = low.anchor_value == high.anchor_value
    let policies_equal =
        adaptive_probe_eligible_for_summary(low.anchor_value) ==
            adaptive_probe_eligible_for_summary(high.anchor_value)
    let coverage_present =
        !gap.discriminating_cell_covered &&
        gap.eligible_opportunities == 0 && gap.observed_opportunities == 0
    assert(observed_equal && policies_equal && coverage_present)
    PolicyInducedTargetAmbiguityReceipt {
        ambiguity_id: ambiguity_id,
        family_id: state.family_id,
        protocol_id: state.protocol_id,
        survivor_mask: state.survivor_mask,
        survivor_count: state.survivor_count,
        low_hypothesis_survives: true,
        high_hypothesis_survives: true,
        low_hidden_target_value: low.hidden_target_value,
        high_hidden_target_value: high.hidden_target_value,
        observed_anchor_traces_equal: observed_equal,
        adaptive_policy_traces_equal: policies_equal,
        coverage_gap_present: coverage_present,
        target_value_observed: false,
        target_identified: false,
        causal_mechanism_established: false,
        clinical_authority: false,
    }
}

pub fn declare_synthetic_exogenous_coverage_assignment(
    assignment_id: i64,
    protocol_id: i64,
    budget: DeclaredSyntheticObservationBudgetReceipt,
    gap: PolicyCoverageGapReceipt,
) -> SyntheticExogenousCoverageAssignmentReceipt with Panic {
    validate_budget(budget)
    validate_coverage_gap(gap)
    assert(protocol_id == budget.protocol_id)
    assert(protocol_id == gap.protocol_id)
    SyntheticExogenousCoverageAssignmentReceipt {
        assignment_id: assignment_id,
        protocol_id: protocol_id,
        coverage_id: gap.coverage_id,
        logging_policy_decision_id: gap.decision_id,
        target_tick: 2,
        declared_probe_cost_units: budget.coverage_probe_cost_units,
        outside_adaptive_policy: true,
        exogenous_within_frozen_fixture: true,
        real_person_randomization_claimed: false,
        consent_authority: false,
        ethics_approval: false,
        clinical_authority: false,
    }
}

pub fn admit_exogenous_coverage_probe(
    probe_id: i64,
    family: AdaptiveObservationPolicyFamilyReceipt,
    assignment: SyntheticExogenousCoverageAssignmentReceipt,
    gap: PolicyCoverageGapReceipt,
    decision: AdaptiveObservationPolicyDecisionReceipt,
    provenance: PolicyEvidenceProvenanceReceipt,
    observed_value: i64,
) -> AdmissibleExogenousCoverageProbeReceipt with Panic {
    validate_family(family)
    validate_coverage_gap(gap)
    validate_decision(decision)
    validate_provenance(provenance)
    assert(assignment.assignment_id > 0)
    assert(assignment.protocol_id == family.protocol_id)
    assert(assignment.coverage_id == gap.coverage_id)
    assert(assignment.logging_policy_decision_id == decision.decision_id)
    assert(assignment.target_tick == 2)
    assert(assignment.declared_probe_cost_units == 4)
    assert(assignment.outside_adaptive_policy)
    assert(assignment.exogenous_within_frozen_fixture)
    assert(!assignment.real_person_randomization_claimed)
    assert(!assignment.consent_authority && !assignment.ethics_approval)
    assert(!assignment.clinical_authority)
    assert(decision.family_id == family.family_id)
    assert(decision.protocol_id == family.protocol_id)
    assert(gap.family_id == family.family_id)
    assert(gap.protocol_id == family.protocol_id)
    assert(gap.decision_id == decision.decision_id)
    assert(decision.candidate_tick == assignment.target_tick)
    assert(decision.withheld_by_adaptive_policy)
    assert(provenance.protocol_id == family.protocol_id)
    assert(provenance.tick == 2)
    assert(provenance.previous_provenance_id > 0)
    assert(provenance.policy_decision_id == decision.decision_id)
    assert(provenance.exogenous_override_within_fixture)
    assert(observed_value == 2 || observed_value == 8)
    let probe = AdmissibleExogenousCoverageProbeReceipt {
        probe_id: probe_id,
        family_id: family.family_id,
        protocol_id: family.protocol_id,
        assignment_id: assignment.assignment_id,
        coverage_id: assignment.coverage_id,
        target_tick: 2,
        observed_value: observed_value,
        value_present: true,
        provenance_id: provenance.provenance_id,
        previous_provenance_id: provenance.previous_provenance_id,
        policy_decision_id: provenance.policy_decision_id,
        declared_burden_units: assignment.declared_probe_cost_units,
        outside_adaptive_policy: true,
        policy_withholding_overridden: true,
        global_positivity_established: false,
        clinical_authority: false,
    }
    validate_probe(probe)
    probe
}

pub fn observed_target_from_probe(
    observation_id: i64,
    probe: AdmissibleExogenousCoverageProbeReceipt,
) -> ObservedTargetValueReceipt with Panic {
    validate_probe(probe)
    let observed = ObservedTargetValueReceipt {
        observation_id: observation_id,
        family_id: probe.family_id,
        protocol_id: probe.protocol_id,
        target_tick: probe.target_tick,
        observed_value: probe.observed_value,
        provenance_id: probe.provenance_id,
        value_present: true,
        synthetic_fixture_only: true,
        clinical_authority: false,
    }
    validate_observed_target(observed)
    observed
}

pub fn update_policy_state_contest_with_probe(
    transition_id: i64,
    result_state_id: i64,
    source: PolicyStateContestStateReceipt,
    family: AdaptiveObservationPolicyFamilyReceipt,
    probe: AdmissibleExogenousCoverageProbeReceipt,
) -> PolicyStateContestTransitionReceipt with Panic {
    validate_state(source)
    validate_family(family)
    validate_probe(probe)
    assert(source.family_id == family.family_id)
    assert(probe.family_id == family.family_id)
    assert(source.protocol_id == family.protocol_id)
    assert(probe.protocol_id == family.protocol_id)
    assert(source.protocol_id == probe.protocol_id)
    assert(source.evidence_count == 1 && source.survivor_mask == 3)
    assert(source.last_provenance_id == probe.previous_provenance_id)
    assert(source.burden_spent + probe.declared_burden_units <= source.burden_capacity)
    let probe_mask = if probe.observed_value == 2 { 1 } else { 2 }
    let result_mask = source.survivor_mask - (if probe_mask == 1 { 2 } else { 1 })
    assert(result_mask == probe_mask)
    let result = PolicyStateContestStateReceipt {
        state_id: result_state_id,
        family_id: source.family_id,
        protocol_id: source.protocol_id,
        budget_id: source.budget_id,
        survivor_mask: result_mask,
        survivor_count: 1,
        evidence_count: 2,
        burden_capacity: source.burden_capacity,
        burden_spent: source.burden_spent + probe.declared_burden_units,
        last_provenance_id: probe.provenance_id,
        provenance_fingerprint: source.provenance_fingerprint * 31 + probe.provenance_id,
        family_refuted: false,
    }
    validate_state(result)
    PolicyStateContestTransitionReceipt {
        transition_id: transition_id,
        evidence_kind: 2,
        family_id: source.family_id,
        protocol_id: source.protocol_id,
        budget_id: source.budget_id,
        source_state_id: source.state_id,
        source_survivor_mask: source.survivor_mask,
        source_survivor_count: source.survivor_count,
        source_evidence_count: source.evidence_count,
        source_burden_capacity: source.burden_capacity,
        source_burden_spent: source.burden_spent,
        source_last_provenance_id: source.last_provenance_id,
        source_provenance_fingerprint: source.provenance_fingerprint,
        result_survivor_mask: result.survivor_mask,
        result_survivor_count: result.survivor_count,
        evidence_tick: probe.target_tick,
        observed_value: probe.observed_value,
        value_present: probe.value_present,
        provenance_id: probe.provenance_id,
        previous_provenance_id: probe.previous_provenance_id,
        policy_decision_id: probe.policy_decision_id,
        assignment_id: probe.assignment_id,
        coverage_id: probe.coverage_id,
        declared_burden_units: probe.declared_burden_units,
        outside_adaptive_policy: probe.outside_adaptive_policy,
        result_state: result,
        exact_prediction_replay: true,
    }
}

pub fn certify_declared_within_family_target_identification(
    identification_id: i64,
    transition: PolicyStateContestTransitionReceipt,
    family: AdaptiveObservationPolicyFamilyReceipt,
    observed: ObservedTargetValueReceipt,
) -> DeclaredWithinFamilyTargetIdentificationReceipt with Panic {
    validate_family(family)
    validate_transition(transition)
    assert(transition.evidence_kind == 2)
    let state = transition.result_state
    assert(state.family_id == family.family_id)
    assert(state.survivor_count == 1 && state.evidence_count == 2)
    validate_observed_target(observed)
    assert(observed.family_id == family.family_id)
    assert(observed.protocol_id == family.protocol_id)
    assert(observed.provenance_id == state.last_provenance_id)
    assert(observed.target_tick == transition.evidence_tick)
    assert(observed.observed_value == transition.observed_value)
    assert(observed.provenance_id == transition.provenance_id)
    let selected_mode = if state.survivor_mask == 1 { 0 } else { 1 }
    assert(observed.observed_value == target_for_mode(selected_mode))
    let selected_id = if selected_mode == 0 {
        family.low_hypothesis_id
    } else {
        family.high_hypothesis_id
    }
    DeclaredWithinFamilyTargetIdentificationReceipt {
        identification_id: identification_id,
        family_id: family.family_id,
        protocol_id: family.protocol_id,
        selected_hypothesis_id: selected_id,
        selected_mode: selected_mode,
        observed_target_value: observed.observed_value,
        survivor_mask: state.survivor_mask,
        burden_spent: state.burden_spent,
        provenance_fingerprint: state.provenance_fingerprint,
        target_identified_within_declared_family: true,
        policy_value_identified: false,
        global_positivity_established: false,
        empirical_model_established: false,
        clinical_authority: false,
    }
}

pub fn refuse_observation_action_over_budget(
    refusal_id: i64,
    state: PolicyStateContestStateReceipt,
    requested_units: i64,
) -> BudgetExceededObservationActionReceipt with Panic {
    validate_state(state)
    assert(state.burden_spent == state.burden_capacity)
    assert(requested_units > 0 && requested_units <= 1000)
    let remaining = state.burden_capacity - state.burden_spent
    assert(requested_units > remaining)
    BudgetExceededObservationActionReceipt {
        refusal_id: refusal_id,
        budget_id: state.budget_id,
        protocol_id: state.protocol_id,
        capacity_units: state.burden_capacity,
        already_spent_units: state.burden_spent,
        remaining_units: remaining,
        requested_units: requested_units,
        excess_units: requested_units - remaining,
        action_executed: false,
        target_value_observed: false,
        consent_withdrawal_claimed: false,
        subjective_suffering_claimed: false,
        clinical_authority: false,
    }
}

pub fn disconnect_coverage_probe(
    probe: AdmissibleExogenousCoverageProbeReceipt,
) -> DisconnectedCoverageProbeReceipt with Panic {
    validate_probe(probe)
    DisconnectedCoverageProbeReceipt {
        probe_id: probe.probe_id,
        family_id: probe.family_id,
        protocol_id: probe.protocol_id,
        provenance_id: probe.provenance_id,
        previous_provenance_id: 0,
        chain_complete: false,
        hypotheses_eliminated: 0,
    }
}

pub fn erase_policy_from_feedback(
    trace_id: i64,
    feedback: BoundedPolicyStateFeedbackReceipt,
    decision: AdaptiveObservationPolicyDecisionReceipt,
) -> PolicyErasedFeedbackTraceReceipt with Panic {
    validate_feedback(feedback)
    validate_decision(decision)
    assert(feedback.family_id == decision.family_id)
    PolicyErasedFeedbackTraceReceipt {
        trace_id: trace_id,
        family_id: feedback.family_id,
        protocol_id: feedback.protocol_id,
        original_policy_decision_id: decision.decision_id,
        policy_retained: false,
        hypotheses_eliminated: 0,
    }
}

pub fn abstain_on_disconnected_coverage_probe(
    abstention_id: i64,
    state: PolicyStateContestStateReceipt,
    probe: DisconnectedCoverageProbeReceipt,
) -> PolicyStateAbstentionReceipt with Panic {
    validate_state(state)
    assert(!probe.chain_complete && probe.hypotheses_eliminated == 0)
    assert(probe.family_id == state.family_id)
    PolicyStateAbstentionReceipt {
        abstention_id: abstention_id,
        reason_code: 1,
        survivor_mask_unchanged: state.survivor_mask,
        survivor_count_unchanged: state.survivor_count,
        hypotheses_eliminated: 0,
        inference_deferred: true,
    }
}

pub fn abstain_on_policy_erased_feedback(
    abstention_id: i64,
    state: PolicyStateContestStateReceipt,
    erased: PolicyErasedFeedbackTraceReceipt,
) -> PolicyStateAbstentionReceipt with Panic {
    validate_state(state)
    assert(!erased.policy_retained && erased.hypotheses_eliminated == 0)
    assert(erased.family_id == state.family_id)
    PolicyStateAbstentionReceipt {
        abstention_id: abstention_id,
        reason_code: 2,
        survivor_mask_unchanged: state.survivor_mask,
        survivor_count_unchanged: state.survivor_count,
        hypotheses_eliminated: 0,
        inference_deferred: true,
    }
}

pub fn certify_policy_state_relabel_invariance(
    control_id: i64,
    original: AdaptiveObservationPolicyFamilyReceipt,
    relabeled: AdaptiveObservationPolicyFamilyReceipt,
) -> PolicyStateRelabelControlReceipt with Panic {
    validate_family(original)
    validate_family(relabeled)
    assert(original.protocol_id == relabeled.protocol_id)
    assert(original.low_hypothesis_id != relabeled.low_hypothesis_id)
    assert(original.high_hypothesis_id != relabeled.high_hypothesis_id)
    let anchors_equal =
        family_anchor_prediction(original, original.low_hypothesis_id) ==
            family_anchor_prediction(relabeled, relabeled.low_hypothesis_id) &&
        family_anchor_prediction(original, original.high_hypothesis_id) ==
            family_anchor_prediction(relabeled, relabeled.high_hypothesis_id)
    let targets_equal =
        family_target_prediction(original, original.low_hypothesis_id) ==
            family_target_prediction(relabeled, relabeled.low_hypothesis_id) &&
        family_target_prediction(original, original.high_hypothesis_id) ==
            family_target_prediction(relabeled, relabeled.high_hypothesis_id)
    let policies_equal =
        family_policy_prediction(original, original.low_hypothesis_id) ==
            family_policy_prediction(relabeled, relabeled.low_hypothesis_id) &&
        family_policy_prediction(original, original.high_hypothesis_id) ==
            family_policy_prediction(relabeled, relabeled.high_hypothesis_id)
    assert(anchors_equal && targets_equal && policies_equal)
    let control = PolicyStateRelabelControlReceipt {
        control_id: control_id,
        corresponding_hypothesis_ids_changed: true,
        anchor_predictions_equal: anchors_equal,
        target_predictions_equal: targets_equal,
        adaptive_policy_predictions_equal: policies_equal,
        partitions_invariant: anchors_equal && targets_equal && policies_equal,
    }
    assert(control.partitions_invariant)
    control
}
