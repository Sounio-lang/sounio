// stdlib/epistemic/editable.sio
//
// Editable<T> helpers — locality-bounded model editing backed by the
// sedenion ZD kernel.
//
// Given a stored fact encoded as a sedenion value v_i with a key k_i
// living in the 4-dimensional right-annihilator of A = e3 + e10, a
// ZD-class edit delta ∈ span(e3 + e10) produces zero ripple on facts
// whose keys stay inside the kernel.
//
// Formal backing: `editing_locality_kernel_bound` in
// formal/lean4/SounioSurgicalInterventions.lean.
// Operational benchmark: examples/zd_model_editing_locality.sio
// (safe-fact ripple = 0.000000, ROME ripple ≈ 0.509902).

// zd_edit_delta: a canonical edit delta in span(e3 + e10), scaled by
// magnitude `alpha`.  The result is guaranteed to annihilate any stored
// value whose key lies in the kernel.
fn zd_edit_delta(alpha: f64) -> [f64; 16] with Mut, ZD {
    var d: [f64; 16] = [0.0; 16]
    d[3]  = alpha
    d[10] = alpha
    d
}

// is_kernel_key: a sanity check that a key has no support outside the
// kernel basis {e6-e15, e7+e14}/√2.  Returns true when the key is a
// linear combination of the two basis vectors.  In production this
// would be a compile-time refinement; here it is a runtime assertion.
fn is_kernel_key(k: &[f64; 16]) -> bool with Mut, ZD {
    let s = 0.707107
    // The only non-zero supports allowed are indices 6, 7, 14, 15
    // and they must satisfy k[6] = -k[15]  (for u1 direction) and
    //                      k[7] =  k[14]  (for u2 direction).
    var i = 0
    var ok = true
    while i < 16 {
        if i == 6 || i == 7 || i == 14 || i == 15 {
            // allowed
        } else {
            if (*k)[i] > 0.000001 || (*k)[i] < 0.0 - 0.000001 { ok = false }
        }
        i = i + 1
    }
    let d1 = (*k)[6] + (*k)[15]    // must be ~0
    let d2 = (*k)[7] - (*k)[14]    // must be ~0
    if d1 > 0.000001 || d1 < 0.0 - 0.000001 { ok = false }
    if d2 > 0.000001 || d2 < 0.0 - 0.000001 { ok = false }
    ok
}
