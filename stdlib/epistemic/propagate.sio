//! stdlib/epistemic/propagate.d
//!
//! Variance Propagation: The Delta Method
//!
//! When computing f(X) where X has variance, the result has variance:
//! Var(f(X)) ≈ (df/dx)² · Var(X)
//!
//! This module provides explicit propagation rules for:
//! - Univariate functions (exp, log, sin, cos, etc.)
//! - Multivariate functions (products, quotients, compositions)
//! - Monte Carlo propagation for complex cases

use epistemic::knowledge::{Epistemic, ep_clamp_conf, ep_min_conf, ep_decay, ep_combine};
// product_nonassoc moved to epistemic::product_nonassoc (Madaros-native leaf,
// 2026-07-20): self-contained PnOct associator — no algebra:: exclusive-ref path.

// ============================================================================
// UNIVARIATE PROPAGATION
// ============================================================================

// Propagate variance through exponential: e^x
// Var(e^X) ≈ e^(2X) · Var(X)
pub fn exp(x: Epistemic) -> Epistemic with Mut, Div, Panic {
    let value = exp_f64(x.val)
    let variance = exp_f64(2.0 * x.val) * x.variance

    Epistemic {
        val: value,
        variance: variance,
        confidence: ep_decay(x.confidence, 0.95),
    }
}

// Propagate variance through natural log: ln(x)
// Var(ln X) ≈ Var(X) / X²
pub fn ln(x: Epistemic) -> Epistemic with Mut, Div, Panic {
    let value = ln_f64(x.val)
    let variance = x.variance / (x.val * x.val)

    Epistemic {
        val: value,
        variance: variance,
        confidence: ep_decay(x.confidence, 0.95),
    }
}

// Propagate variance through power: x^n
// Var(X^n) ≈ n² · X^(2n-2) · Var(X)
pub fn pow(x: Epistemic, n: f64) -> Epistemic with Mut, Div, Panic {
    let value = pow_f64(x.val, n)
    let derivative = n * pow_f64(x.val, n - 1.0)
    let variance = derivative * derivative * x.variance

    Epistemic {
        val: value,
        variance: variance,
        confidence: ep_decay(x.confidence, 0.95),
    }
}

// Propagate variance through sine: sin(x)
// Var(sin X) ≈ cos²(X) · Var(X)
pub fn sin(x: Epistemic) -> Epistemic with Mut, Div, Panic {
    let value = sin_f64(x.val)
    let cos_x = cos_f64(x.val)
    let variance = cos_x * cos_x * x.variance

    Epistemic {
        val: value,
        variance: variance,
        confidence: ep_decay(x.confidence, 0.98),
    }
}

// Propagate variance through cosine: cos(x)
// Var(cos X) ≈ sin²(X) · Var(X)
pub fn cos(x: Epistemic) -> Epistemic with Mut, Div, Panic {
    let value = cos_f64(x.val)
    let sin_x = sin_f64(x.val)
    let variance = sin_x * sin_x * x.variance

    Epistemic {
        val: value,
        variance: variance,
        confidence: ep_decay(x.confidence, 0.98),
    }
}

// Propagate variance through tangent: tan(x)
// Var(tan X) ≈ sec⁴(X) · Var(X)
pub fn tan(x: Epistemic) -> Epistemic with Mut, Div, Panic {
    let value = sin_f64(x.val) / cos_f64(x.val)
    let sec = 1.0 / cos_f64(x.val)
    let sec4 = sec * sec * sec * sec
    let variance = sec4 * x.variance

    Epistemic {
        val: value,
        variance: variance,
        confidence: ep_decay(x.confidence, 0.95),
    }
}

// Propagate variance through inverse: 1/x
// Var(1/X) ≈ Var(X) / X⁴
pub fn inverse(x: Epistemic) -> Epistemic with Mut, Div, Panic {
    let value = 1.0 / x.val
    let x4 = x.val * x.val * x.val * x.val
    let variance = x.variance / x4

    Epistemic {
        val: value,
        variance: variance,
        confidence: ep_decay(x.confidence, 0.97),
    }
}

// Propagate variance through logistic sigmoid: 1/(1 + e^(-x))
// Var(σ(X)) ≈ σ(X)² · (1 - σ(X))² · Var(X)
pub fn sigmoid(x: Epistemic) -> Epistemic with Mut, Div, Panic {
    let s = 1.0 / (1.0 + exp_f64(0.0 - x.val))
    let derivative = s * (1.0 - s)
    let variance = derivative * derivative * x.variance

    Epistemic {
        val: s,
        variance: variance,
        confidence: ep_decay(x.confidence, 0.95),
    }
}

// ============================================================================
// BIVARIATE PROPAGATION
// ============================================================================

// Sum with variance propagation (independent variables)
// Var(X + Y) = Var(X) + Var(Y)
pub fn sum(x: Epistemic, y: Epistemic) -> Epistemic {
    Epistemic {
        val: x.val + y.val,
        variance: x.variance + y.variance,
        confidence: ep_combine(x.confidence, y.confidence),
    }
}

// Difference with variance propagation
// Var(X - Y) = Var(X) + Var(Y)
pub fn diff(x: Epistemic, y: Epistemic) -> Epistemic {
    Epistemic {
        val: x.val - y.val,
        variance: x.variance + y.variance,
        confidence: ep_combine(x.confidence, y.confidence),
    }
}

// Product with variance propagation
// Var(XY) ≈ Y²Var(X) + X²Var(Y)
pub fn product(x: Epistemic, y: Epistemic) -> Epistemic {
    let variance = y.val * y.val * x.variance
                 + x.val * x.val * y.variance

    Epistemic {
        val: x.val * y.val,
        variance: variance,
        confidence: ep_combine(x.confidence, y.confidence),
    }
}

// Quotient with variance propagation
// Var(X/Y) ≈ (1/Y²)Var(X) + (X²/Y⁴)Var(Y)
pub fn quotient(x: Epistemic, y: Epistemic) -> Epistemic with Div, Panic {
    let y2 = y.val * y.val
    let y4 = y2 * y2
    let variance = x.variance / y2 + x.val * x.val * y.variance / y4

    Epistemic {
        val: x.val / y.val,
        variance: variance,
        confidence: ep_combine(x.confidence, y.confidence),
    }
}

// Linear combination: a*X + b*Y
// Var(aX + bY) = a²Var(X) + b²Var(Y)
pub fn linear_combo(
    a: f64, x: Epistemic,
    b: f64, y: Epistemic,
) -> Epistemic {
    Epistemic {
        val: a * x.val + b * y.val,
        variance: a * a * x.variance + b * b * y.variance,
        confidence: ep_combine(x.confidence, y.confidence),
    }
}

// ============================================================================
// CORRELATED PROPAGATION
// ============================================================================

// Sum with known correlation
// Var(X + Y) = Var(X) + Var(Y) + 2·ρ·σ_X·σ_Y
pub fn sum_correlated(
    x: Epistemic,
    y: Epistemic,
    correlation: f64,
) -> Epistemic with Mut, Div, Panic {
    let cov = correlation * sqrt_f64(x.variance) * sqrt_f64(y.variance)
    let variance = x.variance + y.variance + 2.0 * cov

    Epistemic {
        val: x.val + y.val,
        variance: max_f64(variance, 0.0),
        confidence: ep_combine(x.confidence, y.confidence),
    }
}

// Product with known correlation
// Var(XY) ≈ Y²Var(X) + X²Var(Y) + 2XY·ρ·σ_X·σ_Y
pub fn product_correlated(
    x: Epistemic,
    y: Epistemic,
    correlation: f64,
) -> Epistemic with Mut, Div, Panic {
    let cov = correlation * sqrt_f64(x.variance) * sqrt_f64(y.variance)
    let variance = y.val * y.val * x.variance
                 + x.val * x.val * y.variance
                 + 2.0 * x.val * y.val * cov

    Epistemic {
        val: x.val * y.val,
        variance: max_f64(variance, 0.0),
        confidence: ep_combine(x.confidence, y.confidence),
    }
}

// ============================================================================
// NON-ASSOCIATIVE STRUCTURAL PROPAGATION
// ============================================================================
//
// When a scalar observable is computed through a product of non-associative
// quantities (octonions, sedenions), the *order* of multiplication is not
// free: (a·b)·c ≠ a·(b·c). That order-indeterminacy is a genuine, structural
// uncertainty on the result — distinct from measurement variance — and the
// associator [a,b,c] = (a·b)·c − a·(b·c) measures it exactly.
//
// This is the join of the two theses the language is built on: non-associativity
// is not merely *blocked* at the optimizer (the Fano reassociation gate in
// ir/egraph.sio) — it *feeds* the uncertainty budget here. Certainty about
// evaluation order is something you must earn (an associative / Fano triple,
// where ‖α‖² = 0), not something assumed for convenience:
//
//   Var_total = Var_GUM + κ·‖[a,b,c]‖²
//
// Associative triple   ⇒ ‖α‖² = 0 ⇒ no augmentation (order was safe).
// Non-associative triple ⇒ variance grows by exactly the order-ambiguity carried.
//
// Canonical implementation lives in epistemic::product_nonassoc (PnOct leaf).
// Import that module directly — do not reintroduce algebra::associator_field
// into this file (exclusive-ref multi-module path SEGVs under Madaros native).

// ============================================================================
// FINITE-DIFF JACOBIAN HELPERS (for bivariate propagation)
// ============================================================================

// Propagate bivariate f(x,y) with uncertainty via central-difference Jacobian.
// Uses delta method: Var(f) ≈ (df/dx)²·Var(x) + (df/dy)²·Var(y)
// plus cross-term for correlated propagation.
pub fn propagate_fn_2d(
    f: fn(f64, f64) -> f64,
    x: Epistemic,
    y: Epistemic,
) -> Epistemic with Mut, Div, Panic {
    let eps = 1.0e-7

    // Central differences for partial derivatives
    let hx = if x.val != 0.0 { eps * abs_f64(x.val) } else { eps }
    let hy = if y.val != 0.0 { eps * abs_f64(y.val) } else { eps }

    let f_xy = f(x.val, y.val)
    let f_xp = f(x.val + hx, y.val)
    let f_xm = f(x.val - hx, y.val)
    let f_yp = f(x.val, y.val + hy)
    let f_ym = f(x.val, y.val - hy)

    let df_dx = (f_xp - f_xm) / (2.0 * hx)
    let df_dy = (f_yp - f_ym) / (2.0 * hy)

    let variance = df_dx * df_dx * x.variance + df_dy * df_dy * y.variance

    Epistemic {
        val: f_xy,
        variance: max_f64(variance, 0.0),
        confidence: ep_combine(x.confidence, y.confidence),
    }
}

// Bivariate propagation with explicit partial derivatives (analytical)
pub fn propagate_2d_analytic(
    f_val: f64,
    df_dx: f64, x: Epistemic,
    df_dy: f64, y: Epistemic
) -> Epistemic {
    let variance = df_dx * df_dx * x.variance + df_dy * df_dy * y.variance
    Epistemic {
        val: f_val,
        variance: max_f64(variance, 0.0),
        confidence: ep_combine(x.confidence, y.confidence),
    }
}

// ============================================================================
// MONTE CARLO PROPAGATION (using xoshiro)
// ============================================================================

use random::xoshiro::{Xoshiro256, xoshiro_seed, standard_normal}

// Helper: draw two N(0,1) samples in one call.
// Workaround for ownership::double_mut_borrow on consecutive `standard_normal(&!rng)` in a loop.
fn standard_normal_pair(rng: &!Xoshiro256) -> (f64, f64) with Prob, Mut, Div, Panic {
    let a = standard_normal(rng)
    let b = standard_normal(rng)
    (a, b)
}

// Monte Carlo variance propagation for arbitrary functions
pub fn monte_carlo(
    x: Epistemic,
    f: fn(f64) -> f64,
    n_samples: i64,
) -> Epistemic with Prob, Mut, Div, Panic {
    let std = sqrt_f64(x.variance)

    var sum = 0.0
    var sum_sq = 0.0
    var rng = xoshiro_seed(12345)

    var i = 0
    while i < n_samples {
        let z = standard_normal(&!rng)
        let sample = x.val + z * std

        let y = f(sample)
        sum = sum + y
        sum_sq = sum_sq + y * y

        i = i + 1
    }

    let n = n_samples as f64
    let mean = sum / n
    let variance = (sum_sq / n) - (mean * mean)

    Epistemic {
        val: mean,
        variance: max_f64(variance, 0.0),
        confidence: ep_clamp_conf((900.0 * min_f64(n, 1000.0) / 1000.0) as i64),
    }
}

// Monte Carlo for bivariate function
pub fn monte_carlo_2d(
    x: Epistemic,
    y: Epistemic,
    f: fn(f64, f64) -> f64,
    n_samples: i64,
) -> Epistemic with Prob, Mut, Div, Panic {
    let std_x = sqrt_f64(x.variance)
    let std_y = sqrt_f64(y.variance)

    var sum = 0.0
    var sum_sq = 0.0
    var rng = xoshiro_seed(67890)

    var i = 0
    while i < n_samples {
        let zz = standard_normal_pair(&!rng)
        let sample_x = x.val + zz.0 * std_x
        let sample_y = y.val + zz.1 * std_y

        let result = f(sample_x, sample_y)
        sum = sum + result
        sum_sq = sum_sq + result * result

        i = i + 1
    }

    let n = n_samples as f64
    let mean = sum / n
    let variance = (sum_sq / n) - (mean * mean)

    Epistemic {
        val: mean,
        variance: max_f64(variance, 0.0),
        confidence: ep_clamp_conf((900.0 * min_f64(n, 1000.0) / 1000.0) as i64),
    }
}

// ============================================================================
// HELPER FUNCTIONS
// ============================================================================

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn exp_f64(x: f64) -> f64 with Mut, Div, Panic {
    if x > 10.0 { return 22026.465794806718 * exp_f64(x - 10.0) }
    if x < -10.0 { return 0.00004539992976248485 * exp_f64(x + 10.0) }

    var result = 1.0
    var term = 1.0
    var i = 1
    while i < 20 {
        term = term * x / (i as f64)
        result = result + term
        i = i + 1
    }
    result
}

fn ln_f64(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 - 999999.0 }
    if x == 1.0 { return 0.0 }

    let y = (x - 1.0) / (x + 1.0)
    var result = 0.0
    var term = y
    var i = 1
    while i < 30 {
        result = result + term / (i as f64)
        term = term * y * y
        i = i + 2
    }
    2.0 * result
}

fn sqrt_f64(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y
}

fn pow_f64(base: f64, exp: f64) -> f64 with Mut, Div, Panic {
    exp_f64(exp * ln_f64(base))
}

fn sin_f64(x: f64) -> f64 with Mut, Div, Panic {
    let pi = 3.141592653589793
    var x_mod = x
    while x_mod > pi { x_mod = x_mod - 2.0 * pi }
    while x_mod < 0.0 - pi { x_mod = x_mod + 2.0 * pi }
    let x2 = x_mod * x_mod
    var result = x_mod
    var term = x_mod
    var i = 1
    while i < 10 {
        term = 0.0 - term * x2 / ((2.0 * i as f64) * (2.0 * i as f64 + 1.0))
        result = result + term
        i = i + 1
    }
    result
}

fn cos_f64(x: f64) -> f64 with Mut, Div, Panic {
    sin_f64(x + 1.5707963267948966)
}

fn max_f64(a: f64, b: f64) -> f64 {
    if a > b { a } else { b }
}

fn min_f64(a: f64, b: f64) -> f64 {
    if a < b { a } else { b }
}

fn random_pair(state: u64) -> (f64, f64, u64) {
    let a = 6364136223846793005_u64
    let c = 1442695040888963407_u64

    let s1 = state * a + c
    let s2 = s1 * a + c

    let u1 = ((s1 >> 32) as f64) / 4294967296.0
    let u2 = ((s2 >> 32) as f64) / 4294967296.0

    (max_f64(u1, 0.0000001), u2, s2)
}