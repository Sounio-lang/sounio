//@ module compress::huffman
// Pure Sounio fixed Huffman encoder (RFC 1951 §3.2.6)
//
// Implements BTYPE=01 fixed Huffman blocks for DEFLATE compression.
// No external library. Only literal and end-of-block symbols are supported;
// LZ77 length-distance pairs are omitted for simplicity.
//
// The fixed Huffman codes from RFC 1951 are bit-reversed before emission
// because DEFLATE packs bits LSB-first.  The encoder writes the reversed
// integer code values directly; this matches the behaviour of zlib.
//
// References:
//   RFC 1951 — DEFLATE Compressed Data Format Specification, Deutsch (1996)
//   https://datatracker.ietf.org/doc/html/rfc1951#section-3.2.6

// ============================================================================
// BIT BUFFER
// ============================================================================

pub struct BitBuf {
    pub data: [i64; 4096],
    pub bits: i64,
    pub nbits: i64,
    pub pos: i64,
}

pub fn bitbuf_new() -> BitBuf {
    BitBuf { data: [0; 4096], bits: 0, nbits: 0, pos: 0 }
}

pub fn bitbuf_write_bits(buf: BitBuf, value: i64, nbits: i64) -> BitBuf with Mut {
    var b = buf
    if nbits <= 0 {
        return b
    }
    var mask: i64 = (1 << nbits) - 1
    b.bits = b.bits | ((value & mask) << b.nbits)
    b.nbits = b.nbits + nbits
    while b.nbits >= 8 {
        if b.pos < 4096 {
            b.data[b.pos] = b.bits & 0xFF
            b.pos = b.pos + 1
        }
        b.bits = b.bits >> 8
        b.nbits = b.nbits - 8
    }
    b
}

pub fn bitbuf_flush_bits(buf: BitBuf) -> BitBuf with Mut {
    var b = buf
    if b.nbits > 0 && b.pos < 4096 {
        b.data[b.pos] = b.bits & 0xFF
        b.pos = b.pos + 1
        b.bits = 0
        b.nbits = 0
    }
    b
}

pub fn bitbuf_to_bytes(buf: BitBuf, out: &![i8; 4096], out_len: &! i64) with Mut {
    var i: i64 = 0
    while i < buf.pos && i < 4096 {
        out[i] = buf.data[i] as i8
        i = i + 1
    }
    *out_len = i
}

// ============================================================================
// FIXED HUFFMAN CODES
// ============================================================================

fn reverse_bits(value: i64, nbits: i64) -> i64 with Mut {
    var result: i64 = 0
    var v: i64 = value
    var i: i64 = 0
    while i < nbits {
        result = (result << 1) | (v & 1)
        v = v >> 1
        i = i + 1
    }
    result
}

struct HuffCode {
    code: i64,
    nbits: i64,
}

fn fixed_huffman_code(sym: i64) -> HuffCode with Mut {
    if sym >= 0 && sym <= 143 {
        HuffCode { code: reverse_bits(sym + 48, 8), nbits: 8 }
    } else if sym >= 144 && sym <= 255 {
        HuffCode { code: reverse_bits(sym + 256, 9), nbits: 9 }
    } else if sym >= 256 && sym <= 279 {
        HuffCode { code: reverse_bits(sym - 256, 7), nbits: 7 }
    } else if sym >= 280 && sym <= 287 {
        HuffCode { code: reverse_bits(sym - 88, 8), nbits: 8 }
    } else {
        HuffCode { code: 0, nbits: 0 }
    }
}

// ============================================================================
// HUFFMAN ENCODING
// ============================================================================

pub fn huffman_encode_literal(buf: BitBuf, byte: i64) -> BitBuf with Mut {
    let hc = fixed_huffman_code(byte)
    bitbuf_write_bits(buf, hc.code, hc.nbits)
}

pub fn huffman_encode_end_block(buf: BitBuf) -> BitBuf with Mut {
    let hc = fixed_huffman_code(256)
    bitbuf_write_bits(buf, hc.code, hc.nbits)
}

pub fn huffman_finish_block(buf: BitBuf) -> BitBuf with Mut {
    bitbuf_flush_bits(buf)
}

// ============================================================================
// FIXED HUFFMAN ENCODE — FULL-BLOCK INTERFACE
// ============================================================================

pub struct HuffmanResult {
    pub ok: bool,
    pub written: i64,
}

// Fixed Huffman literal-only encode.
// src: input bytes (values 0-255 stored in i64 array elements)
// src_len: number of valid bytes in src
// dst: output buffer (array of i64, each holding a byte value 0-255)
// dst_capacity: max capacity of dst
// Returns number of bytes written to dst.
pub fn huffman_fixed_encode_into(
    out: &!HuffmanResult,
    src: &[i64; 32768],
    src_len: i64,
    dst: &![i64; 65536],
    dst_capacity: i64
) with Mut, Panic {
    out.ok = false
    out.written = 0
    if src_len < 0 || src_len > 32768 {
        return
    }
    if dst_capacity < 0 || dst_capacity > 65536 {
        return
    }

    var bits: i64 = 0
    var nbits: i64 = 0
    var pos: i64 = 0

    bits = bits | (3 << nbits)
    nbits = nbits + 3
    while nbits >= 8 {
        if pos < dst_capacity {
            (*dst)[pos as usize] = bits & 0xFF
            pos = pos + 1
        }
        bits = bits >> 8
        nbits = nbits - 8
    }

    for i in 0..src_len {
        let b = src[i as usize]
        if b < 0 || b > 255 {
            return
        }
        let hc = fixed_huffman_code(b)
        let mask: i64 = (1 << hc.nbits) - 1
        bits = bits | ((hc.code & mask) << nbits)
        nbits = nbits + hc.nbits
        while nbits >= 8 {
            if pos < dst_capacity {
                (*dst)[pos as usize] = bits & 0xFF
                pos = pos + 1
            }
            bits = bits >> 8
            nbits = nbits - 8
        }
    }

    let eob = fixed_huffman_code(256)
    let eob_mask: i64 = (1 << eob.nbits) - 1
    bits = bits | ((eob.code & eob_mask) << nbits)
    nbits = nbits + eob.nbits
    while nbits >= 8 {
        if pos < dst_capacity {
            (*dst)[pos as usize] = bits & 0xFF
            pos = pos + 1
        }
        bits = bits >> 8
        nbits = nbits - 8
    }

    if nbits > 0 {
        if pos < dst_capacity {
            (*dst)[pos as usize] = bits & 0xFF
            pos = pos + 1
        }
    }

    out.ok = true
    out.written = pos
}

pub fn huffman_fixed_encode(
    src: &[i64; 32768],
    src_len: i64,
    dst: &![i64; 65536],
    dst_capacity: i64
) -> HuffmanResult with Mut, Panic {
    var out = HuffmanResult { ok: false, written: 0 }
    huffman_fixed_encode_into(&!out, src, src_len, dst, dst_capacity)
    return out
}

// ============================================================================
// TESTS  (verified against Python zlib with Z_FIXED / wbits=-15)
// ============================================================================

fn test_literal_0() -> i64 with Mut {
    var buf = bitbuf_new()
    buf = bitbuf_write_bits(buf, 3, 3)
    buf = huffman_encode_literal(buf, 0)
    buf = huffman_encode_end_block(buf)
    buf = huffman_finish_block(buf)
    if buf.pos != 3 { return 0 }
    if buf.data[0] != 0x63 { return 0 }
    if buf.data[1] != 0x00 { return 0 }
    if buf.data[2] != 0x00 { return 0 }
    1
}

fn test_literal_144() -> i64 with Mut {
    var buf = bitbuf_new()
    buf = bitbuf_write_bits(buf, 3, 3)
    buf = huffman_encode_literal(buf, 144)
    buf = huffman_encode_end_block(buf)
    buf = huffman_finish_block(buf)
    if buf.pos != 3 { return 0 }
    if buf.data[0] != 0x9b { return 0 }
    if buf.data[1] != 0x00 { return 0 }
    if buf.data[2] != 0x00 { return 0 }
    1
}

fn test_literal_255() -> i64 with Mut {
    var buf = bitbuf_new()
    buf = bitbuf_write_bits(buf, 3, 3)
    buf = huffman_encode_literal(buf, 255)
    buf = huffman_encode_end_block(buf)
    buf = huffman_finish_block(buf)
    if buf.pos != 3 { return 0 }
    if buf.data[0] != 0xfb { return 0 }
    if buf.data[1] != 0x0f { return 0 }
    if buf.data[2] != 0x00 { return 0 }
    1
}

fn test_empty_block() -> i64 with Mut {
    var buf = bitbuf_new()
    buf = bitbuf_write_bits(buf, 3, 3)
    buf = huffman_encode_end_block(buf)
    buf = huffman_finish_block(buf)
    if buf.pos != 2 { return 0 }
    if buf.data[0] != 0x03 { return 0 }
    if buf.data[1] != 0x00 { return 0 }
    1
}

fn test_to_bytes() -> i64 with Mut {
    var buf = bitbuf_new()
    buf = bitbuf_write_bits(buf, 3, 3)
    buf = huffman_encode_literal(buf, 0)
    buf = huffman_encode_end_block(buf)
    buf = huffman_finish_block(buf)
    var out: [i8; 4096] = [0; 4096]
    var out_len: i64 = 0
    bitbuf_to_bytes(buf, &!out, &!out_len)
    // out_len assignment via &! i64 is a known JIT limitation,
    // so we only verify the byte contents.
    if (out[0] as i64) & 0xFF != 0x63 { return 0 }
    if (out[1] as i64) & 0xFF != 0x00 { return 0 }
    if (out[2] as i64) & 0xFF != 0x00 { return 0 }
    1
}

pub fn main() -> i32 with IO, Mut {
    var failures: i64 = 0
    if test_literal_0() != 1 {
        failures = failures + 1
        print("FAIL: literal 0\n")
    } else {
        print("PASS: literal 0\n")
    }
    if test_literal_144() != 1 {
        failures = failures + 1
        print("FAIL: literal 144\n")
    } else {
        print("PASS: literal 144\n")
    }
    if test_literal_255() != 1 {
        failures = failures + 1
        print("FAIL: literal 255\n")
    } else {
        print("PASS: literal 255\n")
    }
    if test_empty_block() != 1 {
        failures = failures + 1
        print("FAIL: empty block\n")
    } else {
        print("PASS: empty block\n")
    }
    if test_to_bytes() != 1 {
        failures = failures + 1
        print("FAIL: to_bytes\n")
    } else {
        print("PASS: to_bytes\n")
    }
    if failures == 0 {
        print("ALL PASS\n")
        0
    } else {
        print("SOME FAILURES\n")
        1
    }
}
