// stdlib/compress/zstd.sio — Zstandard Compression
//
// Level constants / clamp / pure compress_bound stay pure-Sounio. compress and
// decompress resolve ZSTD_* via Madaros dynlink (DT_NEEDED libzstd.so.1).
//
// NOTE: All pointer parameters use *mut u8 — *const u8 in function-call
// position causes arity mismatch in the current compiler.
//
// References:
//   RFC 8478 — Zstandard Compression and the 'application/zstd' Media Type
//   Collet, Y. (2016) — Zstandard: Real-Time Data Compression Algorithm

extern "C" {
    fn ZSTD_compress(dst: *mut u8, dst_cap: i64, src: *mut u8, src_len: i64, level: i32) -> i64
    fn ZSTD_decompress(dst: *mut u8, dst_cap: i64, src: *mut u8, src_len: i64) -> i64
    fn ZSTD_isError(code: i64) -> i32
}

// ============================================================================
// Types
// ============================================================================

pub struct ZstdError { pub code: i64 }
pub struct ZstdResult { pub ok: bool, pub size: i64, pub error: ZstdError }

// ============================================================================
// Level constants (pure, no FFI)
// ============================================================================

/// Returns the default compression level (ZSTD_defaultCLevel = 3).
pub fn zstd_default_level() -> i32 {
    3 as i32
}

/// Back-compat alias used by older stdlib E2E tests.
pub fn zstd_level_default() -> i32 {
    zstd_default_level()
}

/// Returns the minimum valid compression level (1).
pub fn zstd_min_level() -> i32 {
    1 as i32
}

/// Returns the maximum valid compression level (22).
pub fn zstd_max_level() -> i32 {
    22 as i32
}

/// Clamps a compression level to the valid [min, max] range.
pub fn zstd_clamp_level(level: i32) -> i32 {
    let lo = zstd_min_level()
    let hi = zstd_max_level()
    if level < lo { return lo }
    if level > hi { return hi }
    level
}

/// Upper bound on compressed size for src_size bytes of input.
/// Formula: src_size + (src_size / 8) + 128 (conservative estimate).
pub fn zstd_compress_bound(src_size: i64) -> i64 with Div {
    src_size + src_size / 8 + 128
}

/// Returns a documented stub version number (pure; does not call libzstd).
pub fn zstd_version() -> i32 {
    10505 as i32
}

// ============================================================================
// Error helpers
// ============================================================================

/// Returns true if code represents a ZSTD error (large values near i64::MAX).
/// Pure heuristic so lean_single tests stay free of libzstd; compress/decompress
/// use ZSTD_isError at the FFI boundary.
pub fn zstd_is_error(code: i64) -> bool {
    let threshold: i64 = 4611686018427387904  // 2^62
    code > threshold
}

/// Returns true if ZstdResult indicates success.
pub fn zstd_is_ok(r: ZstdResult) -> bool {
    r.ok
}

// ============================================================================
// Compress / decompress (libzstd via GOT)
// ============================================================================

/// Compress src into dst at the given compression level.
pub fn zstd_compress(src: *mut u8, src_len: i64, dst: *mut u8, dst_cap: i64, level: i32) -> ZstdResult with Mut {
    let lvl = zstd_clamp_level(level)
    let code = ZSTD_compress(dst, dst_cap, src, src_len, lvl)
    if ZSTD_isError(code) != 0 {
        return ZstdResult { ok: false, size: 0, error: ZstdError { code: code } }
    }
    ZstdResult { ok: true, size: code, error: ZstdError { code: 0 } }
}

/// Decompress src into dst.
pub fn zstd_decompress(src: *mut u8, src_len: i64, dst: *mut u8, dst_cap: i64) -> ZstdResult with Mut {
    let code = ZSTD_decompress(dst, dst_cap, src, src_len)
    if ZSTD_isError(code) != 0 {
        return ZstdResult { ok: false, size: 0, error: ZstdError { code: code } }
    }
    ZstdResult { ok: true, size: code, error: ZstdError { code: 0 } }
}

/// Frame content size — not wired in KL-14d2 (would need ZSTD_getFrameContentSize).
pub fn zstd_frame_content_size(src: *mut u8, src_len: i64) -> i64 with Mut {
    0 - 1
}
