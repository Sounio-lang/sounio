// compress — Compression library via system FFI
//
// Provides one-shot compress/decompress through zlib and Zstandard.
//
// Submodules:
//   gzip  — Gzip via zlib compress2/uncompress + CRC32
//   zstd  — Zstandard via libzstd one-shot API

pub use gzip::{
    GzipResult, GzipError,
    gzip_compress, gzip_compress_level, gzip_decompress,
    gzip_crc32, crc32_compute,
    gzip_is_ok, gzip_error_message,
    gzip_default_level, gzip_best_speed, gzip_best_compression,
}

pub use zstd::{
    ZstdResult, ZstdError,
    zstd_compress, zstd_decompress,
    zstd_compress_bound, zstd_frame_content_size,
    zstd_is_error, zstd_is_ok,
    zstd_version, zstd_default_level, zstd_min_level, zstd_max_level, zstd_clamp_level,
}
