// compress — Compression library
//
// Submodules:
//   deflate — Pure Sounio DEFLATE stored blocks (RFC 1951 BTYPE=00, no FFI)
//   gzip    — Gzip via zlib compress2/uncompress + CRC32 (requires integer FFI)
//   zstd    — Zstandard via libzstd one-shot API (requires integer FFI)

pub use deflate::{
    DeflateResult, DeflateHeader,
    SrcBuf, DstBuf,
    DEFLATE_OK, DEFLATE_ERR_SRC_TOO_LARGE, DEFLATE_ERR_DST_TOO_SMALL,
    DEFLATE_ERR_BAD_HEADER, DEFLATE_ERR_NLEN_MISMATCH, DEFLATE_ERR_TRUNCATED,
    deflate_stored, inflate_stored, deflate_read_header,
}

pub use gzip::{
    GzipResult, GzipError,
    gzip_compress, gzip_compress_level, gzip_decompress,
    gzip_crc32, crc32_compute,
    gzip_is_ok, gzip_error_message,
    gzip_default_level, gzip_best_speed, gzip_best_compression,
}

pub use zstd::{
    ZstdResult, ZstdError,
    zstd_compress, zstd_decompress,
    zstd_compress_bound, zstd_frame_content_size,
    zstd_is_error, zstd_is_ok,
    zstd_version, zstd_default_level, zstd_min_level, zstd_max_level, zstd_clamp_level,
}
