//! Gzip Compression and Decompression
//!
//! Provides gzip (RFC 1952) compression and decompression using zlib.
//! All operations require the `IO` effect for file operations.

use io::IoError;

// =============================================================================
// Error Types
// =============================================================================

/// Compression/decompression error
pub enum GzipError {
    /// Invalid gzip header
    InvalidHeader,
    /// Data corruption detected
    DataCorruption { message: String },
    /// Checksum mismatch
    ChecksumMismatch { expected: u32, actual: u32 },
    /// Unexpected end of input
    UnexpectedEof,
    /// Decompression buffer too small
    BufferTooSmall,
    /// zlib internal error
    ZlibError { code: i32, message: String },
    /// I/O error
    IoError(IoError),
}

impl GzipError {
    pub fn message(&self) -> String {
        match self {
            GzipError::InvalidHeader => "Invalid gzip header".to_string(),
            GzipError::DataCorruption { message } => "Data corruption: " ++ message,
            GzipError::ChecksumMismatch { expected, actual } =>
                "Checksum mismatch: expected " ++ expected.to_string() ++ ", got " ++ actual.to_string(),
            GzipError::UnexpectedEof => "Unexpected end of input".to_string(),
            GzipError::BufferTooSmall => "Output buffer too small".to_string(),
            GzipError::ZlibError { code, message } =>
                "zlib error " ++ code.to_string() ++ ": " ++ message,
            GzipError::IoError(e) => "I/O error: " ++ e.message(),
        }
    }
}

// =============================================================================
// Gzip Header
// =============================================================================

/// Gzip header flags
const FTEXT: u8 = 0x01;
const FHCRC: u8 = 0x02;
const FEXTRA: u8 = 0x04;
const FNAME: u8 = 0x08;
const FCOMMENT: u8 = 0x10;

/// Gzip magic bytes
const GZIP_MAGIC_1: u8 = 0x1f;
const GZIP_MAGIC_2: u8 = 0x8b;

/// Deflate compression method
const CM_DEFLATE: u8 = 8;

/// Parsed gzip header info
pub struct GzipHeader {
    /// Original filename (if present)
    pub filename: Option<String>,
    /// Comment (if present)
    pub comment: Option<String>,
    /// Modification time (Unix timestamp)
    pub mtime: u32,
    /// Operating system
    pub os: u8,
    /// Whether this is text data
    pub is_text: bool,
}

// =============================================================================
// Decompression
// =============================================================================

/// Decompress gzip data
///
/// # Arguments
/// * `data` - Gzip compressed data
///
/// # Returns
/// * `Ok(bytes)` - Decompressed data
/// * `Err(GzipError)` - Error if decompression fails
///
/// # Example
/// ```sio
/// let compressed = read_bytes("data.gz")?;
/// let decompressed = gzip::decompress(&compressed)?;
/// ```
pub fn decompress(data: &[u8]) -> Result<[u8], GzipError> {
    // Validate minimum size (header + trailer)
    if data.len() < 18 {
        return Err(GzipError::UnexpectedEof);
    }

    // Check magic bytes
    if data[0] != GZIP_MAGIC_1 || data[1] != GZIP_MAGIC_2 {
        return Err(GzipError::InvalidHeader);
    }

    // Check compression method
    if data[2] != CM_DEFLATE {
        return Err(GzipError::InvalidHeader);
    }

    let flags = data[3];
    var offset: usize = 10;  // Skip fixed header

    // Skip extra field if present
    if (flags & FEXTRA) != 0 {
        if offset + 2 > data.len() {
            return Err(GzipError::UnexpectedEof);
        }
        let xlen = (data[offset] as usize) | ((data[offset + 1] as usize) << 8);
        offset = offset + 2 + xlen;
    }

    // Skip filename if present (null-terminated)
    if (flags & FNAME) != 0 {
        while offset < data.len() && data[offset] != 0 {
            offset = offset + 1;
        }
        offset = offset + 1;  // Skip null terminator
    }

    // Skip comment if present (null-terminated)
    if (flags & FCOMMENT) != 0 {
        while offset < data.len() && data[offset] != 0 {
            offset = offset + 1;
        }
        offset = offset + 1;  // Skip null terminator
    }

    // Skip header CRC if present
    if (flags & FHCRC) != 0 {
        offset = offset + 2;
    }

    if offset >= data.len() - 8 {
        return Err(GzipError::UnexpectedEof);
    }

    // Get compressed data (between header and 8-byte trailer)
    let compressed_end = data.len() - 8;
    let compressed_data = &data[offset..compressed_end];

    // Read trailer: CRC32 and original size
    let trailer_offset = data.len() - 8;
    let expected_crc = read_u32_le(data, trailer_offset);
    let original_size = read_u32_le(data, trailer_offset + 4);

    // Decompress using zlib raw deflate
    let decompressed = inflate_raw(compressed_data, original_size as usize)?;

    // Verify CRC32
    let actual_crc = crc32(&decompressed);
    if actual_crc != expected_crc {
        return Err(GzipError::ChecksumMismatch {
            expected: expected_crc,
            actual: actual_crc
        });
    }

    Ok(decompressed)
}

/// Decompress gzip file
///
/// # Arguments
/// * `path` - Path to gzip file
///
/// # Returns
/// * `Ok(bytes)` - Decompressed data
/// * `Err(GzipError)` - Error if decompression fails
pub fn decompress_file(path: &str) -> Result<[u8], GzipError> with IO {
    extern "C" {
        fn __sounio_read_bytes(path: *const u8, path_len: i64, out_ptr: *mut *mut u8, out_len: *mut i64) -> i32;
    }

    var out_ptr: *mut u8 = null_ptr();
    var out_len: i64 = 0;

    let result = unsafe {
        __sounio_read_bytes(path.as_ptr(), path.len() as i64, &out_ptr, &out_len)
    };

    if result != 0 {
        return Err(GzipError::IoError(IoError::not_found(path.to_string())));
    }

    let data = unsafe { slice_from_raw_parts(out_ptr, out_len as usize) };
    decompress(&data)
}

// =============================================================================
// Compression
// =============================================================================

/// Compress data using gzip
///
/// # Arguments
/// * `data` - Data to compress
///
/// # Returns
/// * `Ok(bytes)` - Gzip compressed data
/// * `Err(GzipError)` - Error if compression fails
pub fn compress(data: &[u8]) -> Result<[u8], GzipError> {
    // Build header
    var header: [u8] = [
        GZIP_MAGIC_1,      // Magic byte 1
        GZIP_MAGIC_2,      // Magic byte 2
        CM_DEFLATE,        // Compression method
        0,                 // Flags (no extras)
        0, 0, 0, 0,        // Modification time (0 = not set)
        0,                 // Extra flags
        255,               // OS: unknown
    ];

    // Compress using deflate
    let compressed = deflate_raw(data)?;

    // Build trailer
    let crc = crc32(data);
    let size = (data.len() as u32) & 0xFFFFFFFF;

    var trailer: [u8] = [];
    trailer.push((crc & 0xFF) as u8);
    trailer.push(((crc >> 8) & 0xFF) as u8);
    trailer.push(((crc >> 16) & 0xFF) as u8);
    trailer.push(((crc >> 24) & 0xFF) as u8);
    trailer.push((size & 0xFF) as u8);
    trailer.push(((size >> 8) & 0xFF) as u8);
    trailer.push(((size >> 16) & 0xFF) as u8);
    trailer.push(((size >> 24) & 0xFF) as u8);

    // Concatenate: header + compressed + trailer
    Ok(header ++ compressed ++ trailer)
}

// =============================================================================
// Internal Functions
// =============================================================================

/// Read little-endian u32 from byte array
fn read_u32_le(data: &[u8], offset: usize) -> u32 {
    (data[offset] as u32)
        | ((data[offset + 1] as u32) << 8)
        | ((data[offset + 2] as u32) << 16)
        | ((data[offset + 3] as u32) << 24)
}

/// Raw DEFLATE decompression via zlib
fn inflate_raw(data: &[u8], expected_size: usize) -> Result<[u8], GzipError> {
    extern "C" {
        fn __sounio_zlib_inflate(
            input: *const u8, input_len: i64,
            output: *mut u8, output_len: i64,
            actual_len: *mut i64
        ) -> i32;
    }

    // Allocate output buffer (allow some slack for size estimate errors)
    let buf_size = if expected_size > 0 { expected_size + 256 } else { data.len() * 10 };
    var output: [u8] = [];
    output.resize(buf_size, 0);

    var actual_len: i64 = 0;

    let result = unsafe {
        __sounio_zlib_inflate(
            data.as_ptr(), data.len() as i64,
            output.as_mut_ptr(), buf_size as i64,
            &actual_len
        )
    };

    match result {
        0 => {
            output.truncate(actual_len as usize);
            Ok(output)
        },
        -5 => Err(GzipError::BufferTooSmall),
        code => Err(GzipError::ZlibError {
            code: code,
            message: "inflate failed".to_string()
        }),
    }
}

/// Raw DEFLATE compression via zlib
fn deflate_raw(data: &[u8]) -> Result<[u8], GzipError> {
    extern "C" {
        fn __sounio_zlib_deflate(
            input: *const u8, input_len: i64,
            output: *mut u8, output_len: i64,
            actual_len: *mut i64
        ) -> i32;
    }

    // Allocate output buffer (compressed is usually smaller, but allocate same size + overhead)
    let buf_size = data.len() + 128;
    var output: [u8] = [];
    output.resize(buf_size, 0);

    var actual_len: i64 = 0;

    let result = unsafe {
        __sounio_zlib_deflate(
            data.as_ptr(), data.len() as i64,
            output.as_mut_ptr(), buf_size as i64,
            &actual_len
        )
    };

    match result {
        0 => {
            output.truncate(actual_len as usize);
            Ok(output)
        },
        code => Err(GzipError::ZlibError {
            code: code,
            message: "deflate failed".to_string()
        }),
    }
}

/// CRC32 checksum (ISO 3309 polynomial)
fn crc32(data: &[u8]) -> u32 {
    // CRC32 lookup table
    let table = crc32_table();

    var crc: u32 = 0xFFFFFFFF;
    var i: usize = 0;
    while i < data.len() {
        let index = ((crc ^ (data[i] as u32)) & 0xFF) as usize;
        crc = (crc >> 8) ^ table[index];
        i = i + 1;
    }
    crc ^ 0xFFFFFFFF
}

/// Generate CRC32 lookup table
fn crc32_table() -> [u32; 256] {
    const POLYNOMIAL: u32 = 0xEDB88320;

    var table: [u32; 256] = [0; 256];
    var i: usize = 0;
    while i < 256 {
        var crc: u32 = i as u32;
        var j: usize = 0;
        while j < 8 {
            if (crc & 1) != 0 {
                crc = (crc >> 1) ^ POLYNOMIAL;
            } else {
                crc = crc >> 1;
            }
            j = j + 1;
        }
        table[i] = crc;
        i = i + 1;
    }
    table
}

// =============================================================================
// Tests
// =============================================================================

pub fn test_crc32() -> bool {
    // Test vector: "123456789" should have CRC32 = 0xCBF43926
    let data: [u8] = [0x31, 0x32, 0x33, 0x34, 0x35, 0x36, 0x37, 0x38, 0x39];
    let expected: u32 = 0xCBF43926;
    let actual = crc32(&data);
    actual == expected
}

pub fn test_roundtrip() -> bool {
    let original: [u8] = [72, 101, 108, 108, 111, 44, 32, 87, 111, 114, 108, 100, 33];  // "Hello, World!"

    match compress(&original) {
        Ok(compressed) => {
            match decompress(&compressed) {
                Ok(decompressed) => {
                    if decompressed.len() != original.len() {
                        return false;
                    }
                    var i: usize = 0;
                    while i < original.len() {
                        if decompressed[i] != original[i] {
                            return false;
                        }
                        i = i + 1;
                    }
                    true
                },
                Err(_) => false,
            }
        },
        Err(_) => false,
    }
}
