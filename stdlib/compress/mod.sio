//! Compression Module
//!
//! Provides compression and decompression for various formats:
//! - gzip: GNU zip compression
//! - zstd: Zstandard compression (high performance)

pub mod gzip;
pub mod zstd;

// Re-export main types
pub use gzip::{GzipError, GzipHeader, decompress, compress, decompress_file};
pub use zstd::{ZstdError, zstd_compress, zstd_decompress, zstd_compress_default};
