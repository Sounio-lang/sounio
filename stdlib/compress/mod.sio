    crc32_compute,
    gzip_best_compression,
    gzip_best_speed,
    gzip_compress,
    gzip_compress_level,
    gzip_crc32,
    gzip_decompress,
    gzip_default_level,
    gzip_error_message,
    gzip_is_ok,
    gzip_level_default,
}

pub use compress::huffman::{
    BitBuf,
