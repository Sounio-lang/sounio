// stdlib/compress/mod.sio — Public exports for the compress module
//
// Per stdlib/CONVENTIONS.md §2, mod.sio declares only the public surface
// (pub use re-exports). Implementations live in the sibling files.

pub use compress::deflate::{
    DEFLATE_ERR_BAD_HEADER,
    DEFLATE_ERR_DST_TOO_SMALL,
    DEFLATE_ERR_NLEN_MISMATCH,
    DEFLATE_ERR_SRC_TOO_LARGE,
