// stdlib/experimental/heuristic/provenance.sio
// ┌────────────────────────────────────────────────────────────────────────────┐
// │ ⚠️ METAPHOR FIREWALL — SPECULATIVE HEURISTIC, NEVER LOAD-BEARING ⚠️          │
// │                                                                              │
// │ Feature C-b. A provenance DAG read as a CAUSAL SET: order + a counting       │
// │ measure → a quasi-metric "evidential distance" (Bombelli–Lee–Meyer–Sorkin,   │
// │ "order + number = geometry"). A conclusion timelike-separated from its       │
// │ evidence reads as "properly derived"; spacelike as an "unjustified leap".    │
// │                                                                              │
// │ THIS IS GENERATIVE ANALOGY, NOT ISOMORPHISM. Imposing a Lorentzian/causal-   │
// │ set structure on a provenance graph because it is elegant is the same trap   │
// │ as imposing Lorentz invariance on a psychiatric state space. Causal-set →    │
// │ metric recovery needs extra axioms (manifoldlikeness, an embeddability       │
// │ condition) that a real provenance DAG has NO a priori reason to satisfy.     │
// │                                                                              │
// │ HARD CONSTRAINTS (enforced by scripts/ci/heuristic_firewall_gate.sh):        │
// │   • Use ONLY as an evidence-RANKING heuristic. Never a metric guarantee.     │
// │   • NEVER on a correctness path. Correctness-critical modules (stdlib except  │
// │     experimental/, self-hosted/, bootstrap/) MUST NOT import this namespace;  │
// │     the firewall gate FAILS THE BUILD if they do.                            │
// │   • Every public symbol below is documented as speculative.                  │
// └────────────────────────────────────────────────────────────────────────────┘

// Maximum number of provenance nodes (adjacency is N×N flat bits).
fn prov_maxn() -> i64 { 64 }

// A provenance DAG over up to 64 nodes. Edge i→j means "i is evidence used to derive
// j" — i lies in j's causal PAST (i ≺ j). The graph is assumed ACYCLIC (a derivation
// cannot use its own conclusion); behaviour on a cycle is unspecified.
pub struct ProvDag {
    adj: [bool; 4096],   // 64*64 row-major: adj[from*64 + to]
    n: i64,
}

// SPECULATIVE. Construct an empty provenance DAG on `n` nodes (0 <= n <= 64).
pub fn prov_new(n: i64) -> ProvDag {
    var nn = n
    if nn < 0 { nn = 0 }
    if nn > 64 { nn = 64 }
    ProvDag { adj: [false; 4096], n: nn }
}

// SPECULATIVE. Record a derivation edge: `from` (evidence) ≺ `to` (derived claim).
pub fn prov_add_edge(d: &! ProvDag, from: i64, to: i64) with Mut, Panic, Div {
    if from < 0 || to < 0 || from >= d.n || to >= d.n { return }
    d.adj[(from * 64 + to) as usize] = true
}

fn prov_edge(d: &ProvDag, from: i64, to: i64) -> bool with Panic, Div {
    if from < 0 || to < 0 || from >= d.n || to >= d.n { return false }
    d.adj[(from * 64 + to) as usize]
}

// SPECULATIVE — THE COUNTING MEASURE. Longest directed chain (number of derivation
// steps) from `a` to `b`: the causal-set discrete "proper time". Returns 0 if a == b,
// a positive length if b is derivable from a, and -1 if b is NOT in a's causal future
// (no derivation chain a → … → b). This is the evidential distance's magnitude; it is
// a RANKING signal, not a metric. (DAG longest path by memo-free recursion; the node
// bound keeps it cheap for provenance-sized graphs.)
pub fn prov_longest_chain(d: &ProvDag, a: i64, b: i64) -> i64 with Panic, Div {
    if a == b { return 0 }
    var best: i64 = 0 - 1
    var s: i64 = 0
    while s < d.n {
        if prov_edge(d, a, s) {
            let sub = prov_longest_chain(d, s, b)
            if sub >= 0 {
                let cand = 1 + sub
                if cand > best { best = cand }
            }
        }
        s = s + 1
    }
    best
}

// SPECULATIVE. Is `b` in the causal future of `a` (b derivable from a)?
pub fn prov_reachable(d: &ProvDag, a: i64, b: i64) -> bool with Panic, Div {
    prov_longest_chain(d, a, b) >= 0
}

// SPECULATIVE. Are two claims TIMELIKE-separated — one causally derived from the
// other (a derivation chain connects them in some direction)? Read as: their
// evidential relationship is "properly ordered".
pub fn prov_is_timelike(d: &ProvDag, a: i64, b: i64) -> bool with Panic, Div {
    if a == b { return false }
    prov_reachable(d, a, b) || prov_reachable(d, b, a)
}

// SPECULATIVE. Are two claims SPACELIKE-separated — neither derives the other? Read
// (heuristically!) as: relating them is an "unjustified leap" with no derivation path.
pub fn prov_is_spacelike(d: &ProvDag, a: i64, b: i64) -> bool with Panic, Div {
    if a == b { return false }
    !prov_reachable(d, a, b) && !prov_reachable(d, b, a)
}

// SPECULATIVE — THE QUASI-METRIC. Asymmetric "evidential distance" from evidence `a`
// to claim `b`: the longest derivation chain if a ≺ b (timelike future), else a
// SPACELIKE sentinel (-1) meaning "no derivation path — do not treat as derived".
// Asymmetric by construction (d(a,b) ≠ d(b,a)); a RANKING signal only.
pub fn prov_evidential_distance(d: &ProvDag, a: i64, b: i64) -> i64 with Panic, Div {
    prov_longest_chain(d, a, b)
}

// SPECULATIVE. Sentinel returned by prov_evidential_distance for a spacelike pair.
pub fn prov_spacelike_sentinel() -> i64 { 0 - 1 }
