// stdlib/qpu/hyper.sio — hypercomplex witness for the QPU track.
//
// Octonion multiplication does not associate. That associator is an
// oct_mul computation on eight real components. It is not a statevector.
//
// The quaternion subalgebra does associate, and the SU(2) map
//   w + x i + y j + z k
//     -> [[ w + i x,  y + i z ],
//         [-y + i z,  w - i x ]]
// sends that product to ordinary 2x2 complex matrix multiplication,
// which associates. A nonzero associator in those entries would be a bug.
//
// Sedenion zero divisors are witnessed only by sed_mul.

use math::octonion::{Octonion, oct_mul, oct_norm}
use math::sedenion::{
    sed_known_zero_divisor,
    sed_complementary_zero_divisor,
    sed_mul,
    sed_norm,
}

pub struct C64 {
    pub re: f64,
    pub im: f64,
}

// Rows [a b; c d].
pub struct U2 {
    pub a: C64,
    pub b: C64,
    pub c: C64,
    pub d: C64,
}

fn c_mul(p: C64, q: C64) -> C64 {
    C64 {
        re: p.re * q.re - p.im * q.im,
        im: p.re * q.im + p.im * q.re,
    }
}

fn c_add(p: C64, q: C64) -> C64 {
    C64 {
        re: p.re + q.re,
        im: p.im + q.im,
    }
}

// (a*b)*c - a*(b*c), componentwise. oct_mul only.
pub fn qpu_assoc(a: Octonion, b: Octonion, c: Octonion) -> Octonion {
    let left = oct_mul(oct_mul(a, b), c)
    let right = oct_mul(a, oct_mul(b, c))
    Octonion {
        a: left.a - right.a,
        b: left.b - right.b,
        c: left.c - right.c,
        d: left.d - right.d,
        e: left.e - right.e,
        f: left.f - right.f,
        g: left.g - right.g,
        h: left.h - right.h,
    }
}

pub fn qpu_assoc_norm(a: Octonion, b: Octonion, c: Octonion) -> f64 {
    oct_norm(qpu_assoc(a, b, c))
}

// Frozen SU(2) homomorphism. Do not replace this formula.
pub fn qpu_quat_u(w: f64, x: f64, y: f64, z: f64) -> U2 {
    U2 {
        a: C64 { re: w, im: x },
        b: C64 { re: y, im: z },
        c: C64 { re: 0.0 - y, im: z },
        d: C64 { re: w, im: 0.0 - x },
    }
}

pub fn qpu_u_mul(p: U2, q: U2) -> U2 {
    U2 {
        a: c_add(c_mul(p.a, q.a), c_mul(p.b, q.c)),
        b: c_add(c_mul(p.a, q.b), c_mul(p.b, q.d)),
        c: c_add(c_mul(p.c, q.a), c_mul(p.d, q.c)),
        d: c_add(c_mul(p.c, q.b), c_mul(p.d, q.d)),
    }
}

pub fn qpu_zero_divisor_norm() -> f64 with Panic {
    let prod = sed_mul(sed_known_zero_divisor(), sed_complementary_zero_divisor())
    let n = sed_norm(prod)
    n
}
