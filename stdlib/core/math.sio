/// Standard Math Library for Sounio
///
/// This module provides high-performance mathematical functions via FFI bindings
/// to the system math library (libm). These functions are 10-100x faster than
/// Taylor series approximations and provide IEEE 754 compliance.
///
/// # Design Philosophy
///
/// All functions are external C functions mapped to libm, ensuring:
/// - Maximum performance (native CPU instructions where available)
/// - IEEE 754 floating-point compliance
/// - Correct handling of special values (NaN, Inf, -0.0)
/// - Thread-safe, reentrant implementations
///
/// # Usage
///
/// ```sio
/// use core::math::*;
///
/// let x = 2.0;
/// let y = exp(x);        // e^2 ≈ 7.389
/// let z = log(y);        // ln(y) ≈ 2.0
/// let w = sqrt(16.0);    // 4.0
/// ```
///
/// # Integration with Epistemic Types
///
/// Math functions integrate seamlessly with `Knowledge<T>` for uncertainty propagation:
///
/// ```sio
/// use epistemic::Knowledge;
/// use core::math::*;
///
/// let measurement = Knowledge::new(value: 10.0, uncertainty: 0.5, confidence: 0.95);
/// let result = log(measurement.value);  // Transform via math function
/// // Uncertainty propagates via delta method in epistemic module
/// ```

module math;

// ============================================================================
// Exponential and Logarithmic Functions
// ============================================================================

/// Compute e^x (exponential function)
///
/// # Arguments
/// * `x` - Input value
///
/// # Returns
/// e raised to the power x
///
/// # Special Cases
/// * exp(+Inf) = +Inf
/// * exp(-Inf) = 0
/// * exp(NaN) = NaN
///
/// # Performance
/// Typical: 10-20 CPU cycles (vs 200+ for Taylor series)
///
/// # Examples
/// ```sio
/// let y = exp(1.0);      // e ≈ 2.718281828
/// let z = exp(0.0);      // 1.0
/// let w = exp(-1.0);     // 1/e ≈ 0.367879441
/// ```
extern "C" {
    pub fn exp(x: f64) -> f64;
}

/// Compute natural logarithm (base e)
///
/// # Arguments
/// * `x` - Input value (must be positive)
///
/// # Returns
/// Natural logarithm of x
///
/// # Special Cases
/// * log(+Inf) = +Inf
/// * log(0) = -Inf
/// * log(x) = NaN if x < 0
/// * log(NaN) = NaN
///
/// # Examples
/// ```sio
/// let y = log(2.718281828);  // ≈ 1.0
/// let z = log(1.0);          // 0.0
/// let w = log(10.0);         // ≈ 2.302585093
/// ```
extern "C" {
    pub fn log(x: f64) -> f64;
}

/// Compute base-10 logarithm
///
/// # Arguments
/// * `x` - Input value (must be positive)
///
/// # Returns
/// Base-10 logarithm of x
///
/// # Special Cases
/// Same as log(), but returns log₁₀(x)
///
/// # Examples
/// ```sio
/// let y = log10(100.0);    // 2.0
/// let z = log10(1000.0);   // 3.0
/// ```
extern "C" {
    pub fn log10(x: f64) -> f64;
}

/// Compute base-2 logarithm
///
/// # Arguments
/// * `x` - Input value (must be positive)
///
/// # Returns
/// Base-2 logarithm of x
///
/// # Examples
/// ```sio
/// let y = log2(8.0);     // 3.0
/// let z = log2(1024.0);  // 10.0
/// ```
extern "C" {
    pub fn log2(x: f64) -> f64;
}

/// Compute e^x - 1 accurately for small x
///
/// # Arguments
/// * `x` - Input value
///
/// # Returns
/// e^x - 1
///
/// # Why This Exists
/// For small x, exp(x) - 1 loses precision due to catastrophic cancellation.
/// expm1(x) computes this accurately even for tiny x values.
///
/// # Examples
/// ```sio
/// let y = expm1(1e-10);    // Accurate for tiny values
/// let z = expm1(0.0);      // 0.0
/// ```
extern "C" {
    pub fn expm1(x: f64) -> f64;
}

/// Compute log(1 + x) accurately for small x
///
/// # Arguments
/// * `x` - Input value
///
/// # Returns
/// log(1 + x)
///
/// # Why This Exists
/// For small x, log(1 + x) computed as log(1.0 + x) loses precision.
/// log1p(x) computes this accurately even for tiny x values.
///
/// # Examples
/// ```sio
/// let y = log1p(1e-10);    // Accurate for tiny values
/// let z = log1p(0.0);      // 0.0
/// ```
extern "C" {
    pub fn log1p(x: f64) -> f64;
}

// ============================================================================
// Power Functions
// ============================================================================

/// Compute x^y (x raised to the power y)
///
/// # Arguments
/// * `x` - Base
/// * `y` - Exponent
///
/// # Returns
/// x raised to the power y
///
/// # Special Cases
/// * pow(x, 0) = 1 for any x (even NaN)
/// * pow(1, y) = 1 for any y (even NaN)
/// * pow(x, NaN) = NaN
/// * pow(NaN, y) = NaN (except y = 0)
///
/// # Examples
/// ```sio
/// let y = pow(2.0, 10.0);    // 1024.0
/// let z = pow(27.0, 1.0/3.0); // 3.0 (cube root)
/// ```
extern "C" {
    pub fn pow(x: f64, y: f64) -> f64;
}

/// Compute √x (square root)
///
/// # Arguments
/// * `x` - Input value (must be non-negative)
///
/// # Returns
/// Square root of x
///
/// # Special Cases
/// * sqrt(+Inf) = +Inf
/// * sqrt(0) = 0
/// * sqrt(x) = NaN if x < 0
///
/// # Performance
/// Typically uses hardware SQRT instruction (single-cycle on modern CPUs)
///
/// # Examples
/// ```sio
/// let y = sqrt(16.0);     // 4.0
/// let z = sqrt(2.0);      // ≈ 1.414213562
/// ```
extern "C" {
    pub fn sqrt(x: f64) -> f64;
}

/// Compute ∛x (cube root)
///
/// # Arguments
/// * `x` - Input value (can be negative)
///
/// # Returns
/// Cube root of x
///
/// # Special Cases
/// * cbrt(-x) = -cbrt(x) (preserves sign)
/// * cbrt(±0) = ±0
/// * cbrt(±Inf) = ±Inf
///
/// # Examples
/// ```sio
/// let y = cbrt(27.0);     // 3.0
/// let z = cbrt(-8.0);     // -2.0
/// ```
extern "C" {
    pub fn cbrt(x: f64) -> f64;
}

/// Compute √(x² + y²) without intermediate overflow or underflow
///
/// # Arguments
/// * `x` - First value
/// * `y` - Second value
///
/// # Returns
/// Euclidean distance √(x² + y²)
///
/// # Why This Exists
/// Computing sqrt(x*x + y*y) directly can overflow or underflow for large/small values.
/// hypot() handles this correctly.
///
/// # Examples
/// ```sio
/// let dist = hypot(3.0, 4.0);    // 5.0
/// let huge = hypot(1e200, 1e200); // Doesn't overflow
/// ```
extern "C" {
    pub fn hypot(x: f64, y: f64) -> f64;
}

// ============================================================================
// Trigonometric Functions
// ============================================================================

/// Compute sin(x) (sine function)
///
/// # Arguments
/// * `x` - Input angle in radians
///
/// # Returns
/// Sine of x, value in [-1, 1]
///
/// # Special Cases
/// * sin(±0) = ±0
/// * sin(±Inf) = NaN
/// * sin(NaN) = NaN
///
/// # Examples
/// ```sio
/// let y = sin(0.0);           // 0.0
/// let z = sin(PI / 2.0);      // 1.0
/// let w = sin(PI);            // ≈ 0.0 (actually tiny positive due to rounding)
/// ```
extern "C" {
    pub fn sin(x: f64) -> f64;
}

/// Compute cos(x) (cosine function)
///
/// # Arguments
/// * `x` - Input angle in radians
///
/// # Returns
/// Cosine of x, value in [-1, 1]
///
/// # Special Cases
/// * cos(±0) = 1
/// * cos(±Inf) = NaN
/// * cos(NaN) = NaN
///
/// # Examples
/// ```sio
/// let y = cos(0.0);           // 1.0
/// let z = cos(PI / 2.0);      // ≈ 0.0
/// let w = cos(PI);            // -1.0
/// ```
extern "C" {
    pub fn cos(x: f64) -> f64;
}

/// Compute tan(x) (tangent function)
///
/// # Arguments
/// * `x` - Input angle in radians
///
/// # Returns
/// Tangent of x
///
/// # Special Cases
/// * tan(±0) = ±0
/// * tan(±Inf) = NaN
/// * tan(NaN) = NaN
/// * tan(π/2 + nπ) = ±Inf (poles)
///
/// # Examples
/// ```sio
/// let y = tan(0.0);           // 0.0
/// let z = tan(PI / 4.0);      // ≈ 1.0
/// ```
extern "C" {
    pub fn tan(x: f64) -> f64;
}

// ============================================================================
// Inverse Trigonometric Functions
// ============================================================================

/// Compute arcsin(x) (inverse sine), result in [-π/2, π/2]
///
/// # Arguments
/// * `x` - Input value, must be in [-1, 1]
///
/// # Returns
/// Arcsine of x in radians
///
/// # Special Cases
/// * asin(±0) = ±0
/// * asin(x) = NaN if |x| > 1
/// * asin(NaN) = NaN
///
/// # Examples
/// ```sio
/// let y = asin(0.5);          // π/6 ≈ 0.523598776
/// let z = asin(1.0);          // π/2 ≈ 1.570796327
/// ```
extern "C" {
    pub fn asin(x: f64) -> f64;
}

/// Compute arccos(x) (inverse cosine), result in [0, π]
///
/// # Arguments
/// * `x` - Input value, must be in [-1, 1]
///
/// # Returns
/// Arccosine of x in radians
///
/// # Special Cases
/// * acos(1) = 0
/// * acos(x) = NaN if |x| > 1
/// * acos(NaN) = NaN
///
/// # Examples
/// ```sio
/// let y = acos(0.5);          // π/3 ≈ 1.047197551
/// let z = acos(-1.0);         // π ≈ 3.141592654
/// ```
extern "C" {
    pub fn acos(x: f64) -> f64;
}

/// Compute arctan(x) (inverse tangent), result in (-π/2, π/2)
///
/// # Arguments
/// * `x` - Input value (any real number)
///
/// # Returns
/// Arctangent of x in radians
///
/// # Special Cases
/// * atan(±0) = ±0
/// * atan(±Inf) = ±π/2
/// * atan(NaN) = NaN
///
/// # Examples
/// ```sio
/// let y = atan(1.0);          // π/4 ≈ 0.785398163
/// let z = atan(0.0);          // 0.0
/// ```
extern "C" {
    pub fn atan(x: f64) -> f64;
}

/// Compute arctan(y/x) using signs of both arguments to determine quadrant
///
/// # Arguments
/// * `y` - y-coordinate
/// * `x` - x-coordinate
///
/// # Returns
/// Arctangent of y/x in radians, in range [-π, π]
///
/// # Why This Exists
/// atan(y/x) loses sign information and can't distinguish quadrants.
/// atan2(y, x) returns the correct angle in all four quadrants.
///
/// # Special Cases
/// * atan2(±0, x) = ±0 if x > 0
/// * atan2(±0, x) = ±π if x < 0
/// * atan2(y, ±0) = ±π/2 if y > 0
///
/// # Examples
/// ```sio
/// let angle1 = atan2(1.0, 1.0);      // π/4 (quadrant I)
/// let angle2 = atan2(1.0, -1.0);     // 3π/4 (quadrant II)
/// let angle3 = atan2(-1.0, -1.0);    // -3π/4 (quadrant III)
/// let angle4 = atan2(-1.0, 1.0);     // -π/4 (quadrant IV)
/// ```
extern "C" {
    pub fn atan2(y: f64, x: f64) -> f64;
}

// ============================================================================
// Hyperbolic Functions
// ============================================================================

/// Compute sinh(x) (hyperbolic sine)
///
/// # Arguments
/// * `x` - Input value
///
/// # Returns
/// Hyperbolic sine of x: (e^x - e^(-x)) / 2
///
/// # Special Cases
/// * sinh(±0) = ±0
/// * sinh(±Inf) = ±Inf
/// * sinh(NaN) = NaN
///
/// # Examples
/// ```sio
/// let y = sinh(0.0);          // 0.0
/// let z = sinh(1.0);          // ≈ 1.175201194
/// ```
extern "C" {
    pub fn sinh(x: f64) -> f64;
}

/// Compute cosh(x) (hyperbolic cosine)
///
/// # Arguments
/// * `x` - Input value
///
/// # Returns
/// Hyperbolic cosine of x: (e^x + e^(-x)) / 2
///
/// # Special Cases
/// * cosh(±0) = 1
/// * cosh(±Inf) = +Inf
/// * cosh(NaN) = NaN
///
/// # Examples
/// ```sio
/// let y = cosh(0.0);          // 1.0
/// let z = cosh(1.0);          // ≈ 1.543080635
/// ```
extern "C" {
    pub fn cosh(x: f64) -> f64;
}

/// Compute tanh(x) (hyperbolic tangent)
///
/// # Arguments
/// * `x` - Input value
///
/// # Returns
/// Hyperbolic tangent of x: sinh(x) / cosh(x)
///
/// # Special Cases
/// * tanh(±0) = ±0
/// * tanh(±Inf) = ±1
/// * tanh(NaN) = NaN
///
/// # Examples
/// ```sio
/// let y = tanh(0.0);          // 0.0
/// let z = tanh(1.0);          // ≈ 0.761594156
/// ```
extern "C" {
    pub fn tanh(x: f64) -> f64;
}

/// Compute asinh(x) (inverse hyperbolic sine)
///
/// # Arguments
/// * `x` - Input value (any real number)
///
/// # Returns
/// Inverse hyperbolic sine of x: log(x + sqrt(x² + 1))
///
/// # Examples
/// ```sio
/// let y = asinh(0.0);         // 0.0
/// let z = asinh(1.0);         // ≈ 0.881373587
/// ```
extern "C" {
    pub fn asinh(x: f64) -> f64;
}

/// Compute acosh(x) (inverse hyperbolic cosine)
///
/// # Arguments
/// * `x` - Input value, must be >= 1
///
/// # Returns
/// Inverse hyperbolic cosine of x: log(x + sqrt(x² - 1))
///
/// # Special Cases
/// * acosh(x) = NaN if x < 1
///
/// # Examples
/// ```sio
/// let y = acosh(1.0);         // 0.0
/// let z = acosh(2.0);         // ≈ 1.316957897
/// ```
extern "C" {
    pub fn acosh(x: f64) -> f64;
}

/// Compute atanh(x) (inverse hyperbolic tangent)
///
/// # Arguments
/// * `x` - Input value, must be in (-1, 1)
///
/// # Returns
/// Inverse hyperbolic tangent of x: 0.5 * log((1+x)/(1-x))
///
/// # Special Cases
/// * atanh(±1) = ±Inf
/// * atanh(x) = NaN if |x| > 1
///
/// # Examples
/// ```sio
/// let y = atanh(0.0);         // 0.0
/// let z = atanh(0.5);         // ≈ 0.549306144
/// ```
extern "C" {
    pub fn atanh(x: f64) -> f64;
}

// ============================================================================
// Special Functions (Error Function, Gamma Function)
// ============================================================================

/// Compute erf(x) (error function)
///
/// # Arguments
/// * `x` - Input value
///
/// # Returns
/// Error function of x: (2/√π) ∫₀ˣ e^(-t²) dt
///
/// # Properties
/// * erf(-x) = -erf(x)
/// * erf(0) = 0
/// * erf(±Inf) = ±1
/// * Range: (-1, 1)
///
/// # Applications
/// * Cumulative distribution function of normal distribution
/// * Diffusion problems
/// * Heat transfer
///
/// # Examples
/// ```sio
/// let y = erf(0.0);           // 0.0
/// let z = erf(1.0);           // ≈ 0.842700793
/// ```
extern "C" {
    pub fn erf(x: f64) -> f64;
}

/// Compute erfc(x) (complementary error function)
///
/// # Arguments
/// * `x` - Input value
///
/// # Returns
/// Complementary error function: 1 - erf(x)
///
/// # Why This Exists
/// For large x, erf(x) ≈ 1, so 1 - erf(x) loses precision.
/// erfc(x) computes this accurately even for large x.
///
/// # Examples
/// ```sio
/// let y = erfc(0.0);          // 1.0
/// let z = erfc(1.0);          // ≈ 0.157299207
/// ```
extern "C" {
    pub fn erfc(x: f64) -> f64;
}

/// Compute Γ(x) (gamma function)
///
/// # Arguments
/// * `x` - Input value
///
/// # Returns
/// Gamma function of x: ∫₀^∞ t^(x-1) e^(-t) dt
///
/// # Properties
/// * Γ(n+1) = n! for positive integers n
/// * Γ(x+1) = x·Γ(x)
/// * Γ(1/2) = √π
///
/// # Applications
/// * Beta distribution
/// * Chi-squared distribution
/// * Combinatorics
/// * Special functions
///
/// # Examples
/// ```sio
/// let y = tgamma(1.0);        // 1.0 (0!)
/// let z = tgamma(5.0);        // 24.0 (4!)
/// let w = tgamma(0.5);        // √π ≈ 1.772453851
/// ```
extern "C" {
    pub fn tgamma(x: f64) -> f64;
}

/// Compute log(Γ(x)) (logarithm of gamma function)
///
/// # Arguments
/// * `x` - Input value, must be positive
///
/// # Returns
/// Natural logarithm of Γ(x)
///
/// # Why This Exists
/// Γ(x) grows very rapidly, overflowing for moderate x.
/// lgamma(x) = log(Γ(x)) remains computable for much larger x.
///
/// # Examples
/// ```sio
/// let y = lgamma(10.0);       // log(9!) ≈ 12.80182748
/// let z = lgamma(100.0);      // log(99!) ≈ 359.1342054
/// ```
extern "C" {
    pub fn lgamma(x: f64) -> f64;
}

// ============================================================================
// Rounding and Remainder Functions
// ============================================================================

/// Round x to nearest integer (banker's rounding: ties to even)
///
/// # Arguments
/// * `x` - Input value
///
/// # Returns
/// x rounded to nearest integer as f64
///
/// # Examples
/// ```sio
/// let y = round(2.3);         // 2.0
/// let z = round(2.5);         // 2.0 (banker's rounding)
/// let w = round(3.5);         // 4.0 (banker's rounding)
/// ```
extern "C" {
    pub fn round(x: f64) -> f64;
}

/// Round x down to largest integer <= x
///
/// # Arguments
/// * `x` - Input value
///
/// # Returns
/// Floor of x as f64
///
/// # Examples
/// ```sio
/// let y = floor(2.9);         // 2.0
/// let z = floor(-2.1);        // -3.0
/// ```
extern "C" {
    pub fn floor(x: f64) -> f64;
}

/// Round x up to smallest integer >= x
///
/// # Arguments
/// * `x` - Input value
///
/// # Returns
/// Ceiling of x as f64
///
/// # Examples
/// ```sio
/// let y = ceil(2.1);          // 3.0
/// let z = ceil(-2.9);         // -2.0
/// ```
extern "C" {
    pub fn ceil(x: f64) -> f64;
}

/// Round x toward zero (truncate fractional part)
///
/// # Arguments
/// * `x` - Input value
///
/// # Returns
/// x truncated toward zero
///
/// # Examples
/// ```sio
/// let y = trunc(2.9);         // 2.0
/// let z = trunc(-2.9);        // -2.0
/// ```
extern "C" {
    pub fn trunc(x: f64) -> f64;
}

/// Compute floating-point remainder of x/y
///
/// # Arguments
/// * `x` - Dividend
/// * `y` - Divisor
///
/// # Returns
/// Remainder of x/y with same sign as x
///
/// # Examples
/// ```sio
/// let r = fmod(5.3, 2.0);     // 1.3
/// let s = fmod(-5.3, 2.0);    // -1.3
/// ```
extern "C" {
    pub fn fmod(x: f64, y: f64) -> f64;
}

/// Compute IEEE remainder of x/y
///
/// # Arguments
/// * `x` - Dividend
/// * `y` - Divisor
///
/// # Returns
/// IEEE remainder: x - n*y where n = round(x/y)
///
/// # Difference from fmod
/// remainder() uses round(x/y) while fmod() uses trunc(x/y)
///
/// # Examples
/// ```sio
/// let r = remainder(5.3, 2.0);   // -0.7 (5.3 - 3*2.0)
/// ```
extern "C" {
    pub fn remainder(x: f64, y: f64) -> f64;
}

// ============================================================================
// Floating-Point Manipulation
// ============================================================================

/// Compute x * 2^n efficiently
///
/// # Arguments
/// * `x` - Value to scale
/// * `n` - Power of 2 exponent
///
/// # Returns
/// x * 2^n computed by adjusting exponent (no actual multiplication)
///
/// # Why This Exists
/// Computing x * pow(2.0, n) is slow. ldexp() is 10-20x faster.
///
/// # Examples
/// ```sio
/// let y = ldexp(1.5, 4);      // 1.5 * 16 = 24.0
/// let z = ldexp(3.0, -2);     // 3.0 / 4 = 0.75
/// ```
extern "C" {
    pub fn ldexp(x: f64, n: i32) -> f64;
}

/// Extract mantissa and exponent from x
///
/// # Arguments
/// * `x` - Input value
/// * `exp` - Pointer to store exponent
///
/// # Returns
/// Mantissa m in [0.5, 1.0) such that x = m * 2^exp
///
/// # Examples
/// ```sio
/// var exp: i32 = 0;
/// let mantissa = frexp(12.0, &!exp);  // mantissa ≈ 0.75, exp = 4 (12 = 0.75 * 2^4)
/// ```
extern "C" {
    pub fn frexp(x: f64, exp: &!i32) -> f64;
}

/// Split x into integer and fractional parts
///
/// # Arguments
/// * `x` - Input value
/// * `iptr` - Pointer to store integer part
///
/// # Returns
/// Fractional part of x (same sign as x)
///
/// # Examples
/// ```sio
/// var int_part: f64 = 0.0;
/// let frac = modf(3.14159, &!int_part);  // frac ≈ 0.14159, int_part = 3.0
/// ```
extern "C" {
    pub fn modf(x: f64, iptr: &!f64) -> f64;
}

/// Copy sign of y to magnitude of x
///
/// # Arguments
/// * `x` - Value providing magnitude
/// * `y` - Value providing sign
///
/// # Returns
/// |x| with sign of y
///
/// # Examples
/// ```sio
/// let a = copysign(3.0, -1.0);    // -3.0
/// let b = copysign(-5.0, 2.0);    // 5.0
/// ```
extern "C" {
    pub fn copysign(x: f64, y: f64) -> f64;
}

/// Return next representable value after x in direction of y
///
/// # Arguments
/// * `x` - Starting value
/// * `y` - Direction
///
/// # Returns
/// Next floating-point value after x toward y
///
/// # Applications
/// * Numerical differentiation
/// * ULP (unit in last place) calculations
/// * Testing floating-point precision
///
/// # Examples
/// ```sio
/// let next = nextafter(1.0, 2.0);     // Smallest float > 1.0
/// let prev = nextafter(1.0, 0.0);     // Largest float < 1.0
/// ```
extern "C" {
    pub fn nextafter(x: f64, y: f64) -> f64;
}

// ============================================================================
// Classification and Comparison
// ============================================================================

/// Check if x is finite (not Inf or NaN)
///
/// # Arguments
/// * `x` - Value to test
///
/// # Returns
/// true if x is finite, false if Inf or NaN
///
/// # Examples
/// ```sio
/// let a = isfinite(3.14);         // true
/// let b = isfinite(1.0 / 0.0);    // false (Inf)
/// let c = isfinite(0.0 / 0.0);    // false (NaN)
/// ```
extern "C" {
    pub fn isfinite(x: f64) -> bool;
}

/// Check if x is infinite (+Inf or -Inf)
///
/// # Arguments
/// * `x` - Value to test
///
/// # Returns
/// true if x is ±Inf, false otherwise
extern "C" {
    pub fn isinf(x: f64) -> bool;
}

/// Check if x is NaN (not a number)
///
/// # Arguments
/// * `x` - Value to test
///
/// # Returns
/// true if x is NaN, false otherwise
///
/// # Note
/// NaN != NaN, so use this function instead of x != x
extern "C" {
    pub fn isnan(x: f64) -> bool;
}

/// Check if x is normal (not zero, subnormal, Inf, or NaN)
///
/// # Arguments
/// * `x` - Value to test
///
/// # Returns
/// true if x is a normal number
extern "C" {
    pub fn isnormal(x: f64) -> bool;
}

/// Return sign of x
///
/// # Arguments
/// * `x` - Value to test
///
/// # Returns
/// -1 if x < 0, +1 if x >= 0 (handles -0.0 correctly)
extern "C" {
    pub fn signbit(x: f64) -> bool;
}

// ============================================================================
// Mathematical Constants
// ============================================================================

/// π (pi): ratio of circumference to diameter
pub const PI: f64 = 3.14159265358979323846;

/// e: base of natural logarithm
pub const E: f64 = 2.71828182845904523536;

/// log₂(e): logarithm base 2 of e
pub const LOG2_E: f64 = 1.44269504088896340736;

/// log₁₀(e): logarithm base 10 of e
pub const LOG10_E: f64 = 0.43429448190325182765;

/// ln(2): natural logarithm of 2
pub const LN_2: f64 = 0.69314718055994530942;

/// ln(10): natural logarithm of 10
pub const LN_10: f64 = 2.30258509299404568402;

/// √2: square root of 2
pub const SQRT_2: f64 = 1.41421356237309504880;

/// 1/√2: reciprocal of square root of 2
pub const FRAC_1_SQRT_2: f64 = 0.70710678118654752440;

/// 2/√π: 2 divided by square root of π
pub const FRAC_2_SQRT_PI: f64 = 1.12837916709551257390;

/// π/2
pub const FRAC_PI_2: f64 = 1.57079632679489661923;

/// π/4
pub const FRAC_PI_4: f64 = 0.78539816339744830962;

/// 1/π
pub const FRAC_1_PI: f64 = 0.31830988618379067154;

/// 2/π
pub const FRAC_2_PI: f64 = 0.63661977236758134308;

// ============================================================================
// Helper Functions for Common Patterns
// ============================================================================

/// Compute x² efficiently
///
/// # Arguments
/// * `x` - Value to square
///
/// # Returns
/// x * x
///
/// # Note
/// Compiler may optimize this to use FMA (fused multiply-add) instruction
pub fn sq(x: f64) -> f64 {
    return x * x
}

/// Clamp x to range [min, max]
///
/// # Arguments
/// * `x` - Value to clamp
/// * `min` - Minimum value
/// * `max` - Maximum value
///
/// # Returns
/// x clamped to [min, max]
///
/// # Examples
/// ```sio
/// let y = clamp(5.0, 0.0, 10.0);      // 5.0
/// let z = clamp(-2.0, 0.0, 10.0);     // 0.0
/// let w = clamp(15.0, 0.0, 10.0);     // 10.0
/// ```
pub fn clamp(x: f64, min: f64, max: f64) -> f64 {
    if x < min { return min }
    if x > max { return max }
    return x
}

/// Linear interpolation between a and b
///
/// # Arguments
/// * `a` - Start value (when t=0)
/// * `b` - End value (when t=1)
/// * `t` - Interpolation parameter
///
/// # Returns
/// (1-t)*a + t*b
///
/// # Examples
/// ```sio
/// let y = lerp(0.0, 10.0, 0.5);       // 5.0
/// let z = lerp(0.0, 10.0, 0.0);       // 0.0
/// let w = lerp(0.0, 10.0, 1.0);       // 10.0
/// ```
pub fn lerp(a: f64, b: f64, t: f64) -> f64 {
    return a * (1.0 - t) + b * t
}

/// Convert degrees to radians
///
/// # Arguments
/// * `deg` - Angle in degrees
///
/// # Returns
/// Angle in radians
pub fn radians(deg: f64) -> f64 {
    return deg * (PI / 180.0)
}

/// Convert radians to degrees
///
/// # Arguments
/// * `rad` - Angle in radians
///
/// # Returns
/// Angle in degrees
pub fn degrees(rad: f64) -> f64 {
    return rad * (180.0 / PI)
}

/// Smoothstep interpolation (smooth cubic Hermite interpolation)
///
/// # Arguments
/// * `edge0` - Lower edge
/// * `edge1` - Upper edge
/// * `x` - Input value
///
/// # Returns
/// Smooth interpolation in [0, 1] using cubic Hermite
///
/// # Applications
/// * Graphics: smooth transitions
/// * Animation easing
/// * Smooth thresholding
pub fn smoothstep(edge0: f64, edge1: f64, x: f64) -> f64 {
    let t = clamp((x - edge0) / (edge1 - edge0), 0.0, 1.0);
    return t * t * (3.0 - 2.0 * t)
}
