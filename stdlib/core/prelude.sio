// stdlib/core/prelude — Minimal prelude for bootstrap code
//
// Common utility functions available without explicit imports.

fn abs_i64(x: i64) -> i64 {
    if x < 0 { return 0 - x }
    x
}

fn min_i64(a: i64, b: i64) -> i64 {
    if a < b { return a }
    b
}

fn max_i64(a: i64, b: i64) -> i64 {
    if a > b { return a }
    b
}

fn clamp_i64(x: i64, lo: i64, hi: i64) -> i64 {
    if x < lo { return lo }
    if x > hi { return hi }
    x
}

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    x
}

fn min_f64(a: f64, b: f64) -> f64 {
    if a < b { return a }
    b
}

fn max_f64(a: f64, b: f64) -> f64 {
    if a > b { return a }
    b
}

fn clamp_f64(x: f64, lo: f64, hi: f64) -> f64 {
    if x < lo { return lo }
    if x > hi { return hi }
    x
}
