//! stdlib/core/mod.sio - Core module root
//!
//! This module exists to make core imports deterministic.
//!
//! Note: Collection types like Vec are compiler builtins today, so stdlib
//! code should prefer using Vec directly (or import from collections::*)
//! rather than relying on core::Vec re-exports.

pub use core::option::Option
pub use core::result::Result
