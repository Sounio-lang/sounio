// stdlib/core/result — Integer result type
//
// IntResult: result of i64 computation. tag 0=Ok, 1=Err (i64 error code).
// FloatResult: result of f64 computation.

struct IntResult {
    tag: i64,
    ok_val: i64,
    err_val: i64,
}

fn int_ok(v: i64) -> IntResult {
    IntResult { tag: 0, ok_val: v, err_val: 0 }
}

fn int_err(e: i64) -> IntResult {
    IntResult { tag: 1, ok_val: 0, err_val: e }
}

impl IntResult {
    fn is_ok(self: &IntResult) -> bool {
        self.tag == 0
    }

    fn is_err(self: &IntResult) -> bool {
        self.tag == 1
    }

    fn unwrap(self: &IntResult) -> i64 {
        self.ok_val
    }

    fn unwrap_or(self: &IntResult, default: i64) -> i64 {
        if self.tag == 0 { return self.ok_val }
        default
    }

    fn err(self: &IntResult) -> i64 {
        self.err_val
    }
}

struct FloatResult {
    tag: i64,
    ok_val: f64,
    err_val: i64,
}

fn float_ok(v: f64) -> FloatResult {
    FloatResult { tag: 0, ok_val: v, err_val: 0 }
}

fn float_err(e: i64) -> FloatResult {
    FloatResult { tag: 1, ok_val: 0.0, err_val: e }
}

impl FloatResult {
    fn is_ok(self: &FloatResult) -> bool {
        self.tag == 0
    }

    fn is_err(self: &FloatResult) -> bool {
        self.tag == 1
    }

    fn unwrap(self: &FloatResult) -> f64 {
        self.ok_val
    }

    fn unwrap_or(self: &FloatResult, default: f64) -> f64 {
        if self.tag == 0 { return self.ok_val }
        default
    }

    fn err(self: &FloatResult) -> i64 {
        self.err_val
    }
}
