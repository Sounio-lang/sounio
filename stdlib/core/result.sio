// stdlib/core/result — Result types
//
// Concrete integer/float result types.
// IntResult: result of i64 computation. tag 0=Ok, 1=Err (i64 error code).
// FloatResult: result of f64 computation.

pub struct IntResult {
    tag: i64,
    ok_val: i64,
    err_val: i64,
}

pub fn int_ok(v: i64) -> IntResult {
    IntResult { tag: 0, ok_val: v, err_val: 0 }
}

pub fn int_err(e: i64) -> IntResult {
    IntResult { tag: 1, ok_val: 0, err_val: e }
}

pub fn int_result_is_ok(r: &IntResult) -> bool {
    r.tag == 0
}

pub fn int_result_is_err(r: &IntResult) -> bool {
    r.tag == 1
}

pub fn int_result_unwrap(r: &IntResult) -> i64 {
    r.ok_val
}

pub fn int_result_unwrap_or(r: &IntResult, default: i64) -> i64 {
    if r.tag == 0 { return r.ok_val }
    default
}

pub fn int_result_err(r: &IntResult) -> i64 {
    r.err_val
}

pub struct FloatResult {
    tag: i64,
    ok_val: f64,
    err_val: i64,
}

pub fn float_ok(v: f64) -> FloatResult {
    FloatResult { tag: 0, ok_val: v, err_val: 0 }
}

pub fn float_err(e: i64) -> FloatResult {
    FloatResult { tag: 1, ok_val: 0.0, err_val: e }
}

pub fn float_result_is_ok(r: &FloatResult) -> bool {
    r.tag == 0
}

pub fn float_result_is_err(r: &FloatResult) -> bool {
    r.tag == 1
}

pub fn float_result_unwrap(r: &FloatResult) -> f64 {
    r.ok_val
}

pub fn float_result_unwrap_or(r: &FloatResult, default: f64) -> f64 {
    if r.tag == 0 { return r.ok_val }
    default
}

pub fn float_result_err(r: &FloatResult) -> i64 {
    r.err_val
}

// Short-name method aliases for IntResult
pub fn is_ok(r: &IntResult) -> bool { int_result_is_ok(r) }
pub fn is_err(r: &IntResult) -> bool { int_result_is_err(r) }
pub fn unwrap(r: &IntResult) -> i64 { int_result_unwrap(r) }
pub fn unwrap_or(r: &IntResult, default: i64) -> i64 { int_result_unwrap_or(r, default) }
pub fn err(r: &IntResult) -> i64 { int_result_err(r) }
