// stdlib/core/option — Option types
//
// Generic Option<T> enum and concrete integer/float helpers.
// IntOption: optional i64 value. Uses tag field (0=None, 1=Some).
// FloatOption: optional f64 value.

pub enum Option<T> {
    Some(T),
    None,
}

impl<T> Option<T> {
    fn is_some(self: &Option<T>) -> bool {
        match self {
            Option::Some(_) => true,
            Option::None => false,
        }
    }

    fn is_none(self: &Option<T>) -> bool {
        match self {
            Option::None => true,
            Option::Some(_) => false,
        }
    }

    fn unwrap(self: Option<T>) -> T {
        match self {
            Option::Some(v) => v,
            Option::None => panic("called unwrap on None"),
        }
    }
}

struct IntOption {
    tag: i64,
    val: i64,
}

fn int_none() -> IntOption {
    IntOption { tag: 0, val: 0 }
}

fn int_some(v: i64) -> IntOption {
    IntOption { tag: 1, val: v }
}

impl IntOption {
    fn is_some(self: &IntOption) -> bool {
        self.tag == 1
    }

    fn is_none(self: &IntOption) -> bool {
        self.tag == 0
    }

    fn unwrap(self: &IntOption) -> i64 {
        self.val
    }

    fn unwrap_or(self: &IntOption, default: i64) -> i64 {
        if self.tag == 1 { return self.val }
        default
    }
}

struct FloatOption {
    tag: i64,
    val: f64,
}

fn float_none() -> FloatOption {
    FloatOption { tag: 0, val: 0.0 }
}

fn float_some(v: f64) -> FloatOption {
    FloatOption { tag: 1, val: v }
}

impl FloatOption {
    fn is_some(self: &FloatOption) -> bool {
        self.tag == 1
    }

    fn is_none(self: &FloatOption) -> bool {
        self.tag == 0
    }

    fn unwrap(self: &FloatOption) -> f64 {
        self.val
    }

    fn unwrap_or(self: &FloatOption, default: f64) -> f64 {
        if self.tag == 1 { return self.val }
        default
    }
}
