//! stdlib/interpolation/lib.sio - Interpolation functions
//!
//! Provides interpolation utilities for scientific computing:
//! - Linear interpolation (lerp)
//! - Piecewise linear interpolation
//! - Cubic spline interpolation
//!
//! These functions are essential for resampling data, function approximation,
//! and visualization of irregular datasets.

/// Linearly interpolates between two values a and b using parameter t.
/// When t=0 returns a, when t=1 returns b.
/// Extrapolates if t is outside [0, 1].
pub fn lerp(a: f64, b: f64, t: f64) -> f64 {
    a + t * (b - a)
}

/// Inverse lerp: given a, b, and a value v, returns the t such that lerp(a, b, t) = v.
/// Returns 0.0 if a == b to avoid division by zero.
pub fn inverse_lerp(a: f64, b: f64, v: f64) -> f64 {
    if a == b {
        return 0.0
    }
    (v - a) / (b - a)
}

/// Remaps a value from one range to another.
/// Equivalent to lerp(out_min, out_max, inverse_lerp(in_min, in_max, value)).
pub fn remap(value: f64, in_min: f64, in_max: f64, out_min: f64, out_max: f64) -> f64 {
    let t = inverse_lerp(in_min, in_max, value)
    lerp(out_min, out_max, t)
}

/// Clamps t to [0, 1] then performs lerp.
pub fn lerp_clamped(a: f64, b: f64, t: f64) -> f64 {
    let t_clamped = if t < 0.0 { 0.0 } else { if t > 1.0 { 1.0 } else { t } }
    lerp(a, b, t_clamped)
}

/// Smooth step interpolation using 3t² - 2t³ (Hermite interpolation).
/// Provides smooth acceleration and deceleration.
pub fn smoothstep(a: f64, b: f64, t: f64) -> f64 {
    let t_clamped = if t < 0.0 { 0.0 } else { if t > 1.0 { 1.0 } else { t } }
    let s = t_clamped * t_clamped * (3.0 - 2.0 * t_clamped)
    lerp(a, b, s)
}

/// Smoother step interpolation using 6t⁵ - 15t⁴ + 10t³ (Perlin's improved interpolation).
/// Has zero first and second derivatives at endpoints.
pub fn smootherstep(a: f64, b: f64, t: f64) -> f64 {
    let t_clamped = if t < 0.0 { 0.0 } else { if t > 1.0 { 1.0 } else { t } }
    let s = t_clamped * t_clamped * t_clamped * (t_clamped * (t_clamped * 6.0 - 15.0) + 10.0)
    lerp(a, b, s)
}

/// Bilinear interpolation on a 2D grid.
/// c00, c01, c10, c11 are the four corner values.
/// tx is the x interpolation parameter [0,1], ty is the y parameter [0,1].
pub fn bilerp(c00: f64, c10: f64, c01: f64, c11: f64, tx: f64, ty: f64) -> f64 {
    let a = lerp(c00, c10, tx)
    let b = lerp(c01, c11, tx)
    lerp(a, b, ty)
}

/// Trilinear interpolation on a 3D grid.
/// Takes 8 corner values and 3 interpolation parameters.
pub fn trilerp(
    c000: f64, c100: f64, c010: f64, c110: f64,
    c001: f64, c101: f64, c011: f64, c111: f64,
    tx: f64, ty: f64, tz: f64
) -> f64 {
    let a = bilerp(c000, c100, c010, c110, tx, ty)
    let b = bilerp(c001, c101, c011, c111, tx, ty)
    lerp(a, b, tz)
}

/// Cosine interpolation for smoother transitions than linear.
pub fn cosine_interp(a: f64, b: f64, t: f64) -> f64 {
    let t2 = (1.0 - cos(t * 3.141592653589793)) / 2.0
    a * (1.0 - t2) + b * t2
}

/// Struct for storing linear interpolation data.
pub struct LinearInterp {
    xs: [f64; 256],
    ys: [f64; 256],
    len: i32
}

/// Struct for cubic spline coefficients.
pub struct CubicSpline {
    xs: [f64; 256],
    a: [f64; 256],
    b: [f64; 256],
    c: [f64; 256],
    d: [f64; 256],
    len: i32
}
