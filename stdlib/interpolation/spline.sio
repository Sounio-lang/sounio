// stdlib/interpolation/spline.sio
// Cubic spline interpolation with epistemic uncertainty propagation.
//
// Provides:
//   - Natural cubic spline fit/eval/derivatives (SplineCoeffs)
//   - Simple linear interpolation (lerp on arrays)
//   - Epistemic spline: GUM uncertainty propagation through spline basis
//     (EpistemicSpline, espline_fit, espline_eval)
//
// References:
//   de Boor (1978) "A Practical Guide to Splines"
//   JCGM 100:2008 (GUM) — uncertainty propagation
//   Thomas algorithm: Golub & Van Loan (1996) §4.3

// ============================================================================
// HELPERS (must precede callers — no forward refs in Sounio)
// ============================================================================

fn sp_abs(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    x
}

// Newton-Raphson square root (20 iterations → ~15 digits accuracy).
fn sp_sqrt(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 20 {
        y = 0.5 * (y + x / y)
        i = i + 1
    }
    y
}

// Binary search: return index i such that knots[i] <= x < knots[i+1].
// Returns 0 for x below range, n-2 for x at/above upper boundary.
pub fn spline_find_interval(knots: &[f64; 64], n: i32, x: f64) -> i32 with Mut, Div, Panic {
    if n < 2 { return 0 }
    if x <= knots[0] { return 0 }
    if x >= knots[n - 1] { return n - 2 }
    var lo: i32 = 0
    var hi: i32 = n - 1
    while hi - lo > 1 {
        let mid = lo + (hi - lo) / 2
        if knots[mid] <= x {
            lo = mid
        } else {
            hi = mid
        }
    }
    lo
}

// Thomas algorithm (forward sweep + back substitution) for tridiagonal system.
// Solves: sub[i]*x[i-1] + diag[i]*x[i] + sup[i]*x[i+1] = rhs[i]
// sub[0] and sup[n-1] are unused (natural BCs).
// Result written into sol (passed by exclusive ref).
fn thomas_solve(
    sub: &[f64; 64],
    diag: &[f64; 64],
    sup: &[f64; 64],
    rhs: &[f64; 64],
    n: i32
) -> [f64; 64] with Mut, Div, Panic {
    var cp: [f64; 64] = [0.0; 64]
    var dp: [f64; 64] = [0.0; 64]
    var sol: [f64; 64] = [0.0; 64]

    // Forward sweep
    if sp_abs(diag[0]) < 1.0e-30 {
        cp[0] = 0.0
        dp[0] = 0.0
    } else {
        cp[0] = sup[0] / diag[0]
        dp[0] = rhs[0] / diag[0]
    }

    var i: i32 = 1
    while i < n {
        let denom = diag[i] - sub[i] * cp[i - 1]
        if sp_abs(denom) < 1.0e-30 {
            cp[i] = 0.0
            dp[i] = 0.0
        } else {
            cp[i] = sup[i] / denom
            dp[i] = (rhs[i] - sub[i] * dp[i - 1]) / denom
        }
        i = i + 1
    }

    // Back substitution
    sol[n - 1] = dp[n - 1]
    i = n - 2
    while i >= 0 {
        sol[i] = dp[i] - cp[i] * sol[i + 1]
        i = i - 1
    }
    sol
}

// ============================================================================
// DATA STRUCTURES
// ============================================================================

// Coefficients for a natural cubic spline over n intervals.
// Interval i covers [x[i], x[i+1]] and evaluates as:
//   S_i(t) = a[i] + b[i]*dx + c[i]*dx^2 + d[i]*dx^3,  dx = t - x[i]
// n = number of intervals = number of data points - 1.
pub struct SplineCoeffs {
    pub a: [f64; 64],
    pub b: [f64; 64],
    pub c: [f64; 64],
    pub d: [f64; 64],
    pub x: [f64; 64],
    pub n: i32
}

// Epistemic spline: spline fitted to data with known measurement uncertainty.
// y_unc[i] = standard uncertainty on the i-th data point y[i].
// interp_unc[i] = propagated standard uncertainty at knot i (GUM §5.1).
pub struct EpistemicSpline {
    pub coeffs: SplineCoeffs,
    pub y_unc: [f64; 64],
    pub interp_unc: [f64; 64]
}

// ============================================================================
// NATURAL CUBIC SPLINE FIT
// ============================================================================

// Fit a natural cubic spline through n data points (n >= 2, n <= 64).
// xs must be strictly increasing. Natural BCs: c[0] = c[n-1] = 0.
pub fn spline_fit(x: &[f64; 64], y: &[f64; 64], n: i32) -> SplineCoeffs with Mut, Div, Panic {
    var s = SplineCoeffs {
        a: [0.0; 64],
        b: [0.0; 64],
        c: [0.0; 64],
        d: [0.0; 64],
        x: [0.0; 64],
        n: n
    }

    // Copy x and a = y
    var k: i32 = 0
    while k < n {
        s.x[k] = x[k]
        s.a[k] = y[k]
        k = k + 1
    }

    if n < 2 { return s }

    // Compute interval lengths h[i] = x[i+1] - x[i]
    var h: [f64; 64] = [0.0; 64]
    k = 0
    while k < n - 1 {
        h[k] = x[k + 1] - x[k]
        k = k + 1
    }

    // Special case n == 2: linear segment
    if n == 2 {
        if sp_abs(h[0]) > 1.0e-30 {
            s.b[0] = (y[1] - y[0]) / h[0]
        }
        return s
    }

    // Build tridiagonal system for interior second derivatives c[1..n-2].
    // Using the standard natural spline formulation (n-2 interior equations):
    //   h[i-1]*c[i-1] + 2*(h[i-1]+h[i])*c[i] + h[i]*c[i+1]
    //     = 3*((y[i+1]-y[i])/h[i] - (y[i]-y[i-1])/h[i-1])
    let m = n - 2    // number of interior unknowns
    var sub:  [f64; 64] = [0.0; 64]
    var diag: [f64; 64] = [0.0; 64]
    var sup:  [f64; 64] = [0.0; 64]
    var rhs:  [f64; 64] = [0.0; 64]
    var cp: [f64; 64] = [0.0; 64]
    var dp: [f64; 64] = [0.0; 64]

    var i: i32 = 0
    while i < m {
        let idx = i + 1
        diag[i] = 2.0 * (h[idx - 1] + h[idx])
        if i > 0 {
            sub[i] = h[idx - 1]
        }
        if i < m - 1 {
            sup[i] = h[idx]
        }
        let sr = (y[idx + 1] - y[idx]) / h[idx]
        let sl = (y[idx] - y[idx - 1]) / h[idx - 1]
        rhs[i] = 3.0 * (sr - sl)
        i = i + 1
    }

    // Thomas algorithm inlined — forward sweep
    if sp_abs(diag[0]) < 1.0e-30 {
        cp[0] = 0.0
        dp[0] = 0.0
    } else {
        cp[0] = sup[0] / diag[0]
        dp[0] = rhs[0] / diag[0]
    }
    i = 1
    while i < m {
        let denom = diag[i] - sub[i] * cp[i - 1]
        if sp_abs(denom) < 1.0e-30 {
            cp[i] = 0.0
            dp[i] = 0.0
        } else {
            cp[i] = sup[i] / denom
            dp[i] = (rhs[i] - sub[i] * dp[i - 1]) / denom
        }
        i = i + 1
    }

    // Back substitution — solve into dp, then copy to s.c
    i = m - 2
    while i >= 0 {
        dp[i] = dp[i] - cp[i] * dp[i + 1]
        i = i - 1
    }
    s.c[0] = 0.0
    i = 0
    while i < m {
        s.c[i + 1] = dp[i]
        i = i + 1
    }
    s.c[n - 1] = 0.0

    // Compute b[i] and d[i] for each interval
    i = 0
    while i < n - 1 {
        let hi = h[i]
        if sp_abs(hi) < 1.0e-30 {
            s.b[i] = 0.0
            s.d[i] = 0.0
        } else {
            s.b[i] = (y[i + 1] - y[i]) / hi - hi * (2.0 * s.c[i] + s.c[i + 1]) / 3.0
            s.d[i] = (s.c[i + 1] - s.c[i]) / (3.0 * hi)
        }
        i = i + 1
    }

    s
}

// ============================================================================
// SPLINE EVALUATION
// ============================================================================

// Evaluate spline value at x_eval.
// Clamps to data range for x_eval outside [x[0], x[n]].
pub fn spline_eval(s: &SplineCoeffs, x_eval: f64) -> f64 with Mut, Div, Panic {
    if s.n < 1 { return 0.0 }
    if s.n == 1 { return s.a[0] }

    let np1 = s.n
    var xc: f64 = x_eval
    if xc < s.x[0] { xc = s.x[0] }
    if xc > s.x[np1 - 1] { xc = s.x[np1 - 1] }

    let i = spline_find_interval_in_s(s, np1, xc)
    let dx = xc - s.x[i]
    s.a[i] + dx * (s.b[i] + dx * (s.c[i] + dx * s.d[i]))
}

fn spline_find_interval_in_s(s: &SplineCoeffs, n: i32, x: f64) -> i32 with Mut, Div, Panic {
    if n < 2 { return 0 }
    if x <= s.x[0] { return 0 }
    if x >= s.x[n - 1] { return n - 2 }
    var lo: i32 = 0
    var hi: i32 = n - 1
    while hi - lo > 1 {
        let mid = lo + (hi - lo) / 2
        if s.x[mid] <= x {
            lo = mid
        } else {
            hi = mid
        }
    }
    lo
}

// Evaluate first derivative S'(x_eval) = b + 2c*dx + 3d*dx^2.
pub fn spline_eval_deriv(s: &SplineCoeffs, x_eval: f64) -> f64 with Mut, Div, Panic {
    if s.n < 2 { return 0.0 }

    let np1 = s.n
    var xc: f64 = x_eval
    if xc < s.x[0] { xc = s.x[0] }
    if xc > s.x[np1 - 1] { xc = s.x[np1 - 1] }

    let i = spline_find_interval_in_s(s, np1, xc)
    let dx = xc - s.x[i]
    s.b[i] + dx * (2.0 * s.c[i] + 3.0 * s.d[i] * dx)
}

// Evaluate second derivative S''(x_eval) = 2c + 6d*dx.
pub fn spline_eval_deriv2(s: &SplineCoeffs, x_eval: f64) -> f64 with Mut, Div, Panic {
    if s.n < 2 { return 0.0 }

    let np1 = s.n
    var xc: f64 = x_eval
    if xc < s.x[0] { xc = s.x[0] }
    if xc > s.x[np1 - 1] { xc = s.x[np1 - 1] }

    let i = spline_find_interval_in_s(s, np1, xc)
    let dx = xc - s.x[i]
    2.0 * s.c[i] + 6.0 * s.d[i] * dx
}

// ============================================================================
// SIMPLE LINEAR INTERPOLATION (array-based)
// ============================================================================

// Piecewise linear interpolation through n data points.
// xs must be sorted ascending. Clamps for x_eval outside [xs[0], xs[n-1]].
pub fn lerp(x: &[f64; 64], y: &[f64; 64], n: i32, x_eval: f64) -> f64 with Mut, Div, Panic {
    if n < 1 { return 0.0 }
    if n == 1 { return y[0] }

    if x_eval <= x[0] { return y[0] }
    if x_eval >= x[n - 1] { return y[n - 1] }

    let i = spline_find_interval(x, n, x_eval)
    let h = x[i + 1] - x[i]
    if sp_abs(h) < 1.0e-30 { return y[i] }
    let t = (x_eval - x[i]) / h
    y[i] + t * (y[i + 1] - y[i])
}

// ============================================================================
// EPISTEMIC SPLINE — GUM UNCERTAINTY PROPAGATION
// ============================================================================
//
// Each data value y[i] has standard uncertainty u[i] (Type A or B).
// The spline value at x_eval is a linear function of the y[i]:
//   S(x_eval) = sum_i  phi_i(x_eval) * y[i]
// where phi_i is the i-th "basis" (Lagrange-like influence).
//
// GUM §5.1 (linear propagation):
//   u(S)^2 = sum_i  (phi_i(x_eval) * u[i])^2
//
// We approximate phi_i numerically by finite difference:
//   phi_i ≈ [S(x_eval | y[i]+eps) - S(x_eval | y[i]-eps)] / (2*eps)
// This is exact for cubic splines because S is linear in y[i].

fn spline_basis_sensitivity(
    x: &[f64; 64],
    y: &[f64; 64],
    n: i32,
    idx: i32,
    x_eval: f64,
    eps: f64
) -> f64 with Mut, Div, Panic {
    var yp: [f64; 64] = [0.0; 64]
    var ym: [f64; 64] = [0.0; 64]
    var k: i32 = 0
    while k < n {
        yp[k] = y[k]
        ym[k] = y[k]
        k = k + 1
    }
    yp[idx] = y[idx] + eps
    ym[idx] = y[idx] - eps

    let sp = spline_fit(x, &yp, n)
    let sm = spline_fit(x, &ym, n)
    let vp = spline_eval(&sp, x_eval)
    let vm = spline_eval(&sm, x_eval)

    if sp_abs(2.0 * eps) < 1.0e-30 { return 0.0 }
    (vp - vm) / (2.0 * eps)
}

// Fit a spline and propagate data uncertainty to the knot positions.
// y_unc[i] is the standard uncertainty on y[i].
// interp_unc[i] gives the propagated uncertainty evaluated at x[i] itself.
pub fn espline_fit(
    x: &[f64; 64],
    y: &[f64; 64],
    y_unc: &[f64; 64],
    n: i32
) -> EpistemicSpline with Mut, Div, Panic {
    let coeffs = spline_fit(x, y, n)

    var unc_at_knots: [f64; 64] = [0.0; 64]
    var unc_copy: [f64; 64] = [0.0; 64]

    var ki: i32 = 0
    while ki < n {
        unc_copy[ki] = y_unc[ki]
        ki = ki + 1
    }

    // For each knot, propagate uncertainty using GUM (finite-difference sensitivities)
    var j: i32 = 0
    while j < n {
        var sum_sq: f64 = 0.0
        let x_eval = x[j]
        let eps = 1.0e-6

        var i: i32 = 0
        while i < n {
            let phi_i = spline_basis_sensitivity(x, y, n, i, x_eval, eps)
            let contrib = phi_i * unc_copy[i]
            sum_sq = sum_sq + contrib * contrib
            i = i + 1
        }
        unc_at_knots[j] = sp_sqrt(sum_sq)
        j = j + 1
    }

    EpistemicSpline {
        coeffs: coeffs,
        y_unc: unc_copy,
        interp_unc: unc_at_knots
    }
}

fn espline_find_interval(s: &EpistemicSpline, n: i32, x: f64) -> i32 with Mut, Div, Panic {
    if n < 2 { return 0 }
    if x <= s.coeffs.x[0] { return 0 }
    if x >= s.coeffs.x[n - 1] { return n - 2 }
    var lo: i32 = 0
    var hi: i32 = n - 1
    while hi - lo > 1 {
        let mid = lo + (hi - lo) / 2
        if s.coeffs.x[mid] <= x { lo = mid } else { hi = mid }
    }
    lo
}

pub fn espline_eval_val(s: &EpistemicSpline, x_eval: f64) -> f64 with Mut, Div, Panic {
    let n = s.coeffs.n
    if n < 1 { return 0.0 }
    if n == 1 { return s.coeffs.a[0] }
    var xc: f64 = x_eval
    if xc < s.coeffs.x[0] { xc = s.coeffs.x[0] }
    if xc > s.coeffs.x[n - 1] { xc = s.coeffs.x[n - 1] }
    let i = espline_find_interval(s, n, xc)
    let dx = xc - s.coeffs.x[i]
    s.coeffs.a[i] + dx * (s.coeffs.b[i] + dx * (s.coeffs.c[i] + dx * s.coeffs.d[i]))
}

// Evaluate epistemic spline: returns (value, standard_uncertainty) at x_eval.
// Uncertainty is computed by GUM finite-difference propagation.
pub fn espline_eval_unc(s: &EpistemicSpline, x_eval: f64) -> f64 with Mut, Div, Panic {
    let n = s.coeffs.n
    let eps = 1.0e-6
    var sum_sq: f64 = 0.0

    // Copy x, a, y_unc to locals — avoids nested field reference bug
    var lx: [f64; 64] = [0.0; 64]
    var la: [f64; 64] = [0.0; 64]
    var lyunc: [f64; 64] = [0.0; 64]
    var k: i32 = 0
    while k < n {
        lx[k] = s.coeffs.x[k]
        la[k] = s.coeffs.a[k]
        lyunc[k] = s.y_unc[k]
        k = k + 1
    }

    var i: i32 = 0
    while i < n {
        let phi_i = spline_basis_sensitivity(&lx, &la, n, i, x_eval, eps)
        let contrib = phi_i * lyunc[i]
        sum_sq = sum_sq + contrib * contrib
        i = i + 1
    }
    sp_sqrt(sum_sq)
}
