    pub graphics_restores: i64,
    pub matrix_concats: i64,
    pub rectangles: i64,
    pub move_tos: i64,
    pub line_tos: i64,
    pub close_paths: i64,
    pub curve_tos: i64,
    pub paint_paths: i64,
    pub clip_paths: i64,
    pub stroke_segments: i64,
    pub fill_segments: i64,
    pub fill_stroke_segments: i64,
    pub discarded_segments: i64,
    pub fill_paths: i64,
    pub filled_rectangles: i64,
    pub nonrectangular_fills: i64,
    pub segments: i64,
    pub horizontal_segments: i64,
    pub vertical_segments: i64,
    pub oblique_segments: i64,
    pub quantized_numbers: i64,
    pub max_graphics_depth: i64,
    pub scan_page: i64,
    pub scan_offset: i64,
    pub scan_stack: i64,
    pub scan_operator_length: i64,
    pub scan_operator_bytes: [i64; 16],
    pub page_segment_count: [i64; 64],
    pub page_stroke_horizontal: [i64; 64],
    pub page_stroke_vertical: [i64; 64],
    pub page_fill_horizontal: [i64; 64],
    pub page_fill_vertical: [i64; 64],
    pub page_discarded_segments: [i64; 64],
    pub page_filled_rectangles: [i64; 64],
    pub segment_page: [i64; 32768],
    pub segment_x0: [i64; 32768],
    pub segment_y0: [i64; 32768],
    pub segment_x1: [i64; 32768],
    pub segment_y1: [i64; 32768],
    pub segment_source: [i64; 32768],
    pub segment_paint: [i64; 32768],
    pub rectangle_page: [i64; 4096],
    pub rectangle_min_x: [i64; 4096],
    pub rectangle_min_y: [i64; 4096],
    pub rectangle_max_x: [i64; 4096],
    pub rectangle_max_y: [i64; 4096],
}

pub struct SounioPdfTableCellProjection {
    pub error: i64,
    pub pages: i64,
    pub source_rectangles: i64,
    pub duplicate_rectangles: i64,
    pub cells: i64,
    pub nonempty_cells: i64,
    pub empty_cells: i64,
    pub text_objects: i64,
    pub empty_text_objects: i64,
    pub assigned_objects: i64,
    pub unassigned_objects: i64,
    pub nested_resolutions: i64,
    pub exact_tie_objects: i64,
    pub containment_matches: i64,
    pub cell_page: [i64; 4096],
    pub cell_min_x: [i64; 4096],
    pub cell_min_y: [i64; 4096],
    pub cell_max_x: [i64; 4096],
    pub cell_max_y: [i64; 4096],
    pub cell_object_count: [i64; 4096],
    pub cell_scalar_count: [i64; 4096],
    pub object_cell: [i64; 4096],
}

pub struct SounioPdfTableCellDigest {
    pub error: i64,
    pub serialized_bytes: i64,
    pub bytes: [i64; 32],
}

struct PdfTableDigestBuilder {
    state: SHA256State,
    chunk: [u8; 256],
    chunk_length: i64,
    total_length: i64,
    error: i64,
}

