//@ module document::pdf_table
//! Bounded Sounio-owned projection of PDF path geometry for table recovery.

use document::pdf_flatedecode::{
    SounioPdfFlateInventory,
    SOUNIO_PDF_OK,
    sounio_pdf_flate_import,
    sounio_pdf_expected_inventory,
    sounio_pdf_decode_flate_object,
}
use compress::inflate::{
    SounioInflateResult,
    SOUNIO_INFLATE_OK,
}
use document::pdf_text::{
    SounioPdfTextProjection,
    SounioPdfTextProjectionDigest,
}
use crypto::sha256::{
    SHA256State,
    sha256_init,
    sha256_update,
    sha256_finalize,
    sha256_digest_byte,
}

pub const SOUNIO_PDF_TABLE_OK: i64 = 0
pub const SOUNIO_PDF_TABLE_ERR_BASE: i64 = 301
pub const SOUNIO_PDF_TABLE_ERR_LEXER: i64 = 302
pub const SOUNIO_PDF_TABLE_ERR_STATE: i64 = 303
pub const SOUNIO_PDF_TABLE_ERR_CAPACITY: i64 = 304
pub const SOUNIO_PDF_TABLE_ERR_DIGEST: i64 = 305

pub const SOUNIO_PDF_TABLE_FIXED_SCALE: i64 = 1000000
pub const SOUNIO_PDF_TABLE_GRAPHICS_DEPTH: i64 = 128
pub const SOUNIO_PDF_TABLE_SEGMENT_CAPACITY: i64 = 32768
pub const SOUNIO_PDF_TABLE_CELL_CAPACITY: i64 = 4096

