        base_error: 0,
        pages: 0,
        decoded_bytes: 0,
        operators: 0,
        graphics_saves: 0,
        graphics_restores: 0,
        matrix_concats: 0,
        rectangles: 0,
        move_tos: 0,
        line_tos: 0,
        close_paths: 0,
        curve_tos: 0,
        paint_paths: 0,
        clip_paths: 0,
        stroke_segments: 0,
        fill_segments: 0,
        fill_stroke_segments: 0,
        discarded_segments: 0,
        fill_paths: 0,
        filled_rectangles: 0,
        nonrectangular_fills: 0,
        segments: 0,
        horizontal_segments: 0,
        vertical_segments: 0,
        oblique_segments: 0,
        quantized_numbers: 0,
        max_graphics_depth: 0,
        scan_page: -1,
        scan_offset: -1,
        scan_stack: 0,
        scan_operator_length: 0,
        scan_operator_bytes: [0; 16],
        page_segment_count: [0; 64],
        page_stroke_horizontal: [0; 64],
        page_stroke_vertical: [0; 64],
        page_fill_horizontal: [0; 64],
        page_fill_vertical: [0; 64],
        page_discarded_segments: [0; 64],
        page_filled_rectangles: [0; 64],
        segment_page: [0; 32768],
        segment_x0: [0; 32768],
        segment_y0: [0; 32768],
        segment_x1: [0; 32768],
        segment_y1: [0; 32768],
        segment_source: [0; 32768],
        segment_paint: [0; 32768],
        rectangle_page: [0; 4096],
        rectangle_min_x: [0; 4096],
        rectangle_min_y: [0; 4096],
        rectangle_max_x: [0; 4096],
        rectangle_max_y: [0; 4096],
    }
}

