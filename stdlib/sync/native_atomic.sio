// Sequentially consistent atomic i64 backed by the native platform ABI.
use ffi::platform::{Platform,PlatformValue,platform_call}
pub linear struct NativeAtomic {id:i64,status:i64}
pub fn native_atomic_new(p:&Platform,value:i64)->NativeAtomic with IO {
    let r=platform_call(p,10,value,0,0,0)
    return NativeAtomic {id:r.value,status:r.status}
}
pub fn native_atomic_status(a:&NativeAtomic)->i64 {a.status}
pub fn native_atomic_load(p:&Platform,a:&NativeAtomic)->PlatformValue with IO {
    if a.status!=0 {return PlatformValue {value:0,status:a.status}}
    return platform_call(p,11,a.id,0,0,0)
}
pub fn native_atomic_store(p:&Platform,a:&NativeAtomic,value:i64)->i64 with IO {
    if a.status!=0 {return a.status}
    return platform_call(p,12,a.id,value,0,0).status
}
pub fn native_atomic_fetch_add(p:&Platform,a:&NativeAtomic,delta:i64)->PlatformValue with IO {
    if a.status!=0 {return PlatformValue {value:0,status:a.status}}
    return platform_call(p,13,a.id,delta,0,0)
}
pub fn native_atomic_compare_exchange(p:&Platform,a:&NativeAtomic,expected:i64,desired:i64)->PlatformValue with IO {
    if a.status!=0 {return PlatformValue {value:0,status:a.status}}
    return platform_call(p,14,a.id,expected,desired,0)
}
pub fn native_atomic_close(p:&Platform,a:NativeAtomic)->i64 with IO {
    let NativeAtomic {id,status}=a
    if status!=0 {return status}
    return platform_call(p,2,id,0,0,0).status
}
