//! Atomic Operations
//!
//! Lock-free atomic operations for concurrent programming.
//!
//! # Memory Ordering
//! - `Relaxed` - No ordering guarantees beyond atomicity
//! - `Acquire` - Subsequent reads see all writes before the release
//! - `Release` - All previous writes visible to acquiring thread
//! - `AcqRel` - Both acquire and release semantics
//! - `SeqCst` - Sequentially consistent (strongest, default)
//!
//! # Examples
//! ```sio
//! var counter = atomic_i64_new(0)
//!
//! // Atomic increment
//! let old = atomic_i64_fetch_add(&!counter, 1, Ordering::SeqCst)
//!
//! // Compare-and-swap
//! let result = atomic_i64_compare_exchange(
//!     &!counter, 1, 2, Ordering::SeqCst, Ordering::SeqCst
//! )
//! ```

// =============================================================================
// Memory Ordering
// =============================================================================

// Memory ordering for atomic operations.
pub enum Ordering {
    // No ordering constraints (only atomicity).
    Relaxed,
    // Prevents reads from being reordered before this operation.
    Acquire,
    // Prevents writes from being reordered after this operation.
    Release,
    // Both Acquire and Release semantics.
    AcqRel,
    // Sequentially consistent - total global order.
    SeqCst,
}

fn ordering_to_int(ord: Ordering) -> i32 {
    match ord {
        Ordering::Relaxed => 0 as i32,
        Ordering::Acquire => 2 as i32,
        Ordering::Release => 3 as i32,
        Ordering::AcqRel => 4 as i32,
        Ordering::SeqCst => 5 as i32,
    }
}

// =============================================================================
// AtomicBool
// =============================================================================

// Atomic boolean value.
pub struct AtomicBool {
    value: u8,
}

// Create a new atomic boolean.
pub fn atomic_bool_new(v: bool) -> AtomicBool {
    AtomicBool { value: if v { 1 } else { 0 } }
}

// Load the value atomically.
pub fn atomic_bool_load(ab: &AtomicBool, ord: Ordering) -> bool {
    // Intrinsic: atomic load with memory ordering
    let _ = ordering_to_int(ord)
    ab.value != 0
}

// Store a value atomically.
pub fn atomic_bool_store(ab: &!AtomicBool, v: bool, ord: Ordering) with Mut {
    // Intrinsic: atomic store with memory ordering
    let _ = ordering_to_int(ord)
    ab.value = if v { 1 } else { 0 }
}

// Swap and return the previous value atomically.
pub fn atomic_bool_swap(ab: &!AtomicBool, v: bool, ord: Ordering) -> bool with Mut {
    let prev = atomic_bool_load(ab, ord)
    atomic_bool_store(ab, v, ord)
    prev
}

// =============================================================================
// AtomicI32
// =============================================================================

// Atomic 32-bit signed integer.
pub struct AtomicI32 {
    value: i32,
}

// Create a new atomic i32.
pub fn atomic_i32_new(v: i32) -> AtomicI32 {
    AtomicI32 { value: v }
}

// Load the value atomically.
pub fn atomic_i32_load(a: &AtomicI32, ord: Ordering) -> i32 {
    // Intrinsic: atomic load with memory ordering
    let _ = ordering_to_int(ord)
    a.value
}

// Store a value atomically.
pub fn atomic_i32_store(a: &!AtomicI32, v: i32, ord: Ordering) with Mut {
    // Intrinsic: atomic store with memory ordering
    let _ = ordering_to_int(ord)
    a.value = v
}

// Swap and return the previous value atomically.
pub fn atomic_i32_swap(a: &!AtomicI32, v: i32, ord: Ordering) -> i32 with Mut {
    // Intrinsic: atomic exchange
    let prev = atomic_i32_load(a, ord)
    atomic_i32_store(a, v, ord)
    prev
}

// Compare and exchange atomically.
//
// If current value equals `current`, sets to `new` and returns Ok(current).
// Otherwise returns Err(actual_value).
pub fn atomic_i32_compare_exchange(
    a: &!AtomicI32,
    current: i32,
    new: i32,
    success: Ordering,
    failure: Ordering
) -> Result<i32, i32> with Mut {
    // Intrinsic: atomic compare-and-swap
    let _ = ordering_to_int(success)
    let _ = ordering_to_int(failure)
    let actual = a.value
    if actual == current {
        a.value = new
        Ok(actual)
    } else {
        Err(actual)
    }
}

// Atomically add and return the previous value.
pub fn atomic_i32_fetch_add(a: &!AtomicI32, v: i32, ord: Ordering) -> i32 with Mut {
    // Intrinsic: atomic fetch-and-add
    let _ = ordering_to_int(ord)
    let prev = a.value
    a.value = prev + v
    prev
}

// Atomically subtract and return the previous value.
pub fn atomic_i32_fetch_sub(a: &!AtomicI32, v: i32, ord: Ordering) -> i32 with Mut {
    let zero: i32 = 0 as i32
    atomic_i32_fetch_add(a, zero - v, ord)
}

// =============================================================================
// AtomicI64
// =============================================================================

// Atomic 64-bit signed integer.
pub struct AtomicI64 {
    value: i64,
}

// Create a new atomic i64.
pub fn atomic_i64_new(v: i64) -> AtomicI64 {
    AtomicI64 { value: v }
}

// Load the value atomically.
pub fn atomic_i64_load(a: &AtomicI64, ord: Ordering) -> i64 {
    // Intrinsic: atomic load with memory ordering
    let _ = ordering_to_int(ord)
    a.value
}

// Store a value atomically.
pub fn atomic_i64_store(a: &!AtomicI64, v: i64, ord: Ordering) with Mut {
    // Intrinsic: atomic store with memory ordering
    let _ = ordering_to_int(ord)
    a.value = v
}

// Swap and return the previous value atomically.
pub fn atomic_i64_swap(a: &!AtomicI64, v: i64, ord: Ordering) -> i64 with Mut {
    // Intrinsic: atomic exchange
    let prev = atomic_i64_load(a, ord)
    atomic_i64_store(a, v, ord)
    prev
}

// Compare and exchange atomically.
pub fn atomic_i64_compare_exchange(
    a: &!AtomicI64,
    current: i64,
    new: i64,
    success: Ordering,
    failure: Ordering
) -> Result<i64, i64> with Mut {
    // Intrinsic: atomic compare-and-swap
    let _ = ordering_to_int(success)
    let _ = ordering_to_int(failure)
    let actual = a.value
    if actual == current {
        a.value = new
        Ok(actual)
    } else {
        Err(actual)
    }
}

// Weak compare and exchange (may spuriously fail).
pub fn atomic_i64_compare_exchange_weak(
    a: &!AtomicI64,
    current: i64,
    new: i64,
    success: Ordering,
    failure: Ordering
) -> Result<i64, i64> with Mut {
    // For now, same as strong version
    atomic_i64_compare_exchange(a, current, new, success, failure)
}

// Atomically add and return the previous value.
pub fn atomic_i64_fetch_add(a: &!AtomicI64, v: i64, ord: Ordering) -> i64 with Mut {
    // Intrinsic: atomic fetch-and-add
    let _ = ordering_to_int(ord)
    let prev = a.value
    a.value = prev + v
    prev
}

// Atomically subtract and return the previous value.
pub fn atomic_i64_fetch_sub(a: &!AtomicI64, v: i64, ord: Ordering) -> i64 with Mut {
    // Intrinsic: atomic fetch-and-sub
    let _ = ordering_to_int(ord)
    let prev = a.value
    a.value = prev - v
    prev
}

// Atomically AND and return the previous value.
pub fn atomic_i64_fetch_and(a: &!AtomicI64, v: i64, ord: Ordering) -> i64 with Mut {
    // Intrinsic: atomic fetch-and-and
    let _ = ordering_to_int(ord)
    let prev = a.value
    a.value = prev & v
    prev
}

// Atomically OR and return the previous value.
pub fn atomic_i64_fetch_or(a: &!AtomicI64, v: i64, ord: Ordering) -> i64 with Mut {
    // Intrinsic: atomic fetch-and-or
    let _ = ordering_to_int(ord)
    let prev = a.value
    a.value = prev | v
    prev
}

// Atomically XOR and return the previous value.
pub fn atomic_i64_fetch_xor(a: &!AtomicI64, v: i64, ord: Ordering) -> i64 with Mut {
    // Intrinsic: atomic fetch-and-xor
    let _ = ordering_to_int(ord)
    let prev = a.value
    a.value = prev ^ v
    prev
}

// Atomically set to max(current, v) and return previous value.
pub fn atomic_i64_fetch_max(a: &!AtomicI64, v: i64, ord: Ordering) -> i64 with Mut {
    // Intrinsic: atomic fetch-max (simplified - real impl needs CAS loop)
    let _ = ordering_to_int(ord)
    let current = a.value
    if v > current {
        a.value = v
    }
    current
}

// Atomically set to min(current, v) and return previous value.
pub fn atomic_i64_fetch_min(a: &!AtomicI64, v: i64, ord: Ordering) -> i64 with Mut {
    // Intrinsic: atomic fetch-min (simplified - real impl needs CAS loop)
    let _ = ordering_to_int(ord)
    let current = a.value
    if v < current {
        a.value = v
    }
    current
}

// =============================================================================
// AtomicUsize
// =============================================================================

// Atomic pointer-sized unsigned integer.
pub struct AtomicUsize {
    value: usize,
}

// Create a new atomic usize.
pub fn atomic_usize_new(v: usize) -> AtomicUsize {
    AtomicUsize { value: v }
}

// Load the value atomically.
pub fn atomic_usize_load(a: &AtomicUsize, ord: Ordering) -> usize {
    // Intrinsic: atomic load with memory ordering
    let _ = ordering_to_int(ord)
    a.value
}

// Store a value atomically.
pub fn atomic_usize_store(a: &!AtomicUsize, v: usize, ord: Ordering) with Mut {
    // Intrinsic: atomic store with memory ordering
    let _ = ordering_to_int(ord)
    a.value = v
}

// Atomically add and return the previous value.
pub fn atomic_usize_fetch_add(a: &!AtomicUsize, v: usize, ord: Ordering) -> usize with Mut {
    // Intrinsic: atomic fetch-and-add
    let _ = ordering_to_int(ord)
    let prev = a.value
    a.value = prev + v
    prev
}

// Atomically subtract and return the previous value.
pub fn atomic_usize_fetch_sub(a: &!AtomicUsize, v: usize, ord: Ordering) -> usize with Mut {
    // Intrinsic: atomic fetch-and-sub
    let _ = ordering_to_int(ord)
    let prev = a.value
    a.value = prev - v
    prev
}

// =============================================================================
// Memory Fence
// =============================================================================

// Issue a memory fence with specified ordering.
pub fn fence(ord: Ordering) {
    // Intrinsic: memory fence
    let _ = ordering_to_int(ord)
}

// Compiler fence (prevents compiler reordering, not hardware).
pub fn compiler_fence(ord: Ordering) {
    // Intrinsic: compiler fence
    let _ = ordering_to_int(ord)
}

// =============================================================================
// Spin Lock (Disabled - borrow checker limitation)
// =============================================================================
// SpinLock commented out due to borrow checker limitations with nested
// mutable/immutable borrows of struct fields within loops.

// =============================================================================
// Tests (disabled due to ownership checker limitations with sequential borrows)
// =============================================================================
// The ownership checker doesn't yet support multiple sequential exclusive
// borrows of the same variable in a function scope.
