// Sequentially consistent atomic i64 backed by the native platform ABI.
use ffi::platform::{Platform,PlatformValue,platform_call}
pub linear struct AtomicI64 {id:i64,status:i64}
pub fn atomic_new(p:&Platform,value:i64)->AtomicI64 with IO {
    let r=platform_call(p,10,value,0,0,0)
    return AtomicI64 {id:r.value,status:r.status}
}
pub fn atomic_status(a:&AtomicI64)->i64 {a.status}
pub fn atomic_load(p:&Platform,a:&AtomicI64)->PlatformValue with IO {
    if a.status!=0 {return PlatformValue {value:0,status:a.status}}
    return platform_call(p,11,a.id,0,0,0)
}
pub fn atomic_store(p:&Platform,a:&AtomicI64,value:i64)->i64 with IO {
    if a.status!=0 {return a.status}
    return platform_call(p,12,a.id,value,0,0).status
}
pub fn atomic_add(p:&Platform,a:&AtomicI64,delta:i64)->PlatformValue with IO {
    if a.status!=0 {return PlatformValue {value:0,status:a.status}}
    return platform_call(p,13,a.id,delta,0,0)
}
pub fn atomic_cas(p:&Platform,a:&AtomicI64,expected:i64,desired:i64)->PlatformValue with IO {
    if a.status!=0 {return PlatformValue {value:0,status:a.status}}
    return platform_call(p,14,a.id,expected,desired,0)
}
pub fn atomic_close(p:&Platform,a:AtomicI64)->i64 with IO {
    let AtomicI64 {id,status}=a
    if status!=0 {return status}
    return platform_call(p,2,id,0,0,0).status
}

pub fn atomic_sub(p:&Platform,a:&AtomicI64,delta:i64)->PlatformValue with IO {
    if a.status!=0 {return PlatformValue {value:0,status:a.status}}
    return platform_call(p,15,a.id,delta,0,0)
}
