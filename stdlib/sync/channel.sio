// stdlib/sync/channel — Single-producer single-consumer i64 channel
//
// IntChannel: bounded ring buffer for sending i64 between contexts.
// Capacity: 1024 elements.

let CHANNEL_CAP: i64 = 1024

struct IntChannel {
    buf: [i64; 1024],
    head: i64,
    tail: i64,
    count: i64,
    closed: i64,
}

impl IntChannel {
    fn new() -> IntChannel {
        IntChannel { buf: [0; 1024], head: 0, tail: 0, count: 0, closed: 0 }
    }

    fn send(self: &! IntChannel, val: i64) -> bool {
        if self.closed == 1 { return false }
        if self.count >= CHANNEL_CAP { return false }
        self.buf[self.tail] = val
        self.tail = (self.tail + 1) % CHANNEL_CAP
        self.count = self.count + 1
        true
    }

    fn recv(self: &! IntChannel) -> i64 {
        if self.count == 0 { return 0 }
        let val = self.buf[self.head]
        self.head = (self.head + 1) % CHANNEL_CAP
        self.count = self.count - 1
        val
    }

    fn is_empty(self: &IntChannel) -> bool {
        self.count == 0
    }

    fn len(self: &IntChannel) -> i64 {
        self.count
    }

    fn close(self: &! IntChannel) {
        self.closed = 1
    }

    fn is_closed(self: &IntChannel) -> bool {
        self.closed == 1
    }
}

pub fn channel_new() -> IntChannel {
    IntChannel { buf: [0; 1024], head: 0, tail: 0, count: 0, closed: 0 }
}

pub fn channel_send(ch: &! IntChannel, val: i64) -> bool with Mut {
    if ch.closed == 1 { return false }
    if ch.count >= CHANNEL_CAP { return false }
    ch.buf[ch.tail] = val
    ch.tail = (ch.tail + 1) % CHANNEL_CAP
    ch.count = ch.count + 1
    true
}

pub fn channel_recv(ch: &! IntChannel) -> i64 with Mut {
    if ch.count == 0 { return 0 }
    let v = ch.buf[ch.head]
    ch.head = (ch.head + 1) % CHANNEL_CAP
    ch.count = ch.count - 1
    v
}

pub fn channel_is_empty(ch: &IntChannel) -> bool {
    ch.count == 0
}

pub fn channel_len(ch: &IntChannel) -> i64 {
    ch.count
}

pub fn channel_close(ch: &! IntChannel) with Mut {
    ch.closed = 1
}

pub fn channel_is_closed(ch: &IntChannel) -> bool {
    ch.closed == 1
}
