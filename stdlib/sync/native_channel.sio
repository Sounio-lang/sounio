// Bounded native MPMC i64 channels. Owner closes/destroys; tokens never own storage.
use ffi::platform::{Platform,PlatformValue,platform_call}
pub linear struct NativeChannel {id:i64,status:i64}
pub struct ChannelToken {id:i64,status:i64}
pub struct ChannelRead {pub value:i64,pub status:i64,pub closed:bool}
pub fn native_channel_new(p:&Platform,capacity:i64,max_bytes:i64)->NativeChannel with IO {
 let r=platform_call(p,70,capacity,max_bytes,0,0)
 return NativeChannel {id:r.value,status:r.status}
}
pub fn native_channel_status(c:&NativeChannel)->i64 {c.status}
pub fn native_channel_token(c:&NativeChannel)->ChannelToken {ChannelToken {id:c.id,status:c.status}}
pub fn channel_token_argument(t:&ChannelToken)->i64 {t.id}
pub fn channel_token_from_argument(p:&Platform,argument:i64)->ChannelToken with IO {
 let r=platform_call(p,76,argument,0,0,0)
 return ChannelToken {id:argument,status:r.status}
}
pub fn native_channel_try_send(p:&Platform,t:&ChannelToken,value:i64)->i64 with IO {
 if t.status!=0 {return t.status}
 return platform_call(p,71,t.id,value,0,0).status
}
pub fn native_channel_send(p:&Platform,t:&ChannelToken,value:i64,timeout_ms:i64)->i64 with IO {
 if t.status!=0 {return t.status}
 return platform_call(p,73,t.id,value,timeout_ms,0).status
}
fn channel_read_result(r:PlatformValue)->ChannelRead {
 if r.status==61 {return ChannelRead {value:0,status:0,closed:true}}
 return ChannelRead {value:r.value,status:r.status,closed:false}
}
pub fn native_channel_try_receive(p:&Platform,t:&ChannelToken)->ChannelRead with IO {
 if t.status!=0 {return ChannelRead {value:0,status:t.status,closed:false}}
 return channel_read_result(platform_call(p,72,t.id,0,0,0))
}
pub fn native_channel_receive(p:&Platform,t:&ChannelToken,timeout_ms:i64)->ChannelRead with IO {
 if t.status!=0 {return ChannelRead {value:0,status:t.status,closed:false}}
 return channel_read_result(platform_call(p,74,t.id,timeout_ms,0,0))
}
pub fn native_channel_close(p:&Platform,c:&NativeChannel)->i64 with IO {
 if c.status!=0 {return c.status}
 return platform_call(p,75,c.id,0,0,0).status
}
pub fn native_channel_destroy(p:&Platform,c:NativeChannel)->i64 with IO {
 let NativeChannel {id,status}=c
 if status!=0 {return status}
 return platform_call(p,2,id,0,0,0).status
}
