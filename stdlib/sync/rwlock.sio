// stdlib/sync/rwlock — Reader-writer lock
//
// RwLock: allows multiple concurrent readers or one exclusive writer.
// Single-threaded simulation using counters.

struct RwLock {
    readers: i64,
    writer: i64,
}

impl RwLock {
    fn new() -> RwLock {
        RwLock { readers: 0, writer: 0 }
    }

    fn read_lock(self: &! RwLock) -> bool {
        if self.writer != 0 { return false }
        self.readers = self.readers + 1
        true
    }

    fn read_unlock(self: &! RwLock) {
        if self.readers > 0 {
            self.readers = self.readers - 1
        }
    }

    fn write_lock(self: &! RwLock) -> bool {
        if self.writer != 0 { return false }
        if self.readers != 0 { return false }
        self.writer = 1
        true
    }

    fn write_unlock(self: &! RwLock) {
        self.writer = 0
    }

    fn reader_count(self: &RwLock) -> i64 {
        self.readers
    }

    fn is_write_locked(self: &RwLock) -> bool {
        self.writer != 0
    }
}

pub fn rwlock_new() -> RwLock {
    RwLock { readers: 0, writer: 0 }
}

pub fn rwlock_read_lock(rw: &! RwLock) -> bool with Mut {
    if rw.writer != 0 { return false }
    rw.readers = rw.readers + 1
    true
}

pub fn rwlock_read_unlock(rw: &! RwLock) with Mut {
    if rw.readers > 0 {
        rw.readers = rw.readers - 1
    }
}

pub fn rwlock_write_lock(rw: &! RwLock) -> bool with Mut {
    if rw.writer != 0 { return false }
    if rw.readers != 0 { return false }
    rw.writer = 1
    true
}

pub fn rwlock_write_unlock(rw: &! RwLock) with Mut {
    rw.writer = 0
}

pub fn rwlock_reader_count(rw: &RwLock) -> i64 {
    rw.readers
}

pub fn rwlock_is_write_locked(rw: &RwLock) -> bool {
    rw.writer != 0
}
