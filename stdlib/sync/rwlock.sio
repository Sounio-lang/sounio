// stdlib/sync/rwlock — Shared-memory reader/writer lock handles
//
// RwLock is a copyable handle into module-global shared state so cloned tasks
// coordinate on the same lock record by ID.

let RWLOCK_MAX: i64 = 64

var RWLOCK_USED: [i64; 64] = [0; 64]
var RWLOCK_READERS: [i64; 64] = [0; 64]
var RWLOCK_WRITER: [i64; 64] = [0; 64]

pub struct RwLock {
    id: i64,
}

fn rwlock_slot_valid(id: i64) -> bool {
    return id >= 0 && id < RWLOCK_MAX && RWLOCK_USED[id as usize] == 1
}

pub fn rwlock_new() -> RwLock {
    var i: i64 = 0
    while i < RWLOCK_MAX {
        if RWLOCK_USED[i as usize] == 0 {
            RWLOCK_USED[i as usize] = 1
            RWLOCK_READERS[i as usize] = 0
            RWLOCK_WRITER[i as usize] = 0
            return RwLock { id: i }
        }
        i = i + 1
    }
    return RwLock { id: -1 }
}

pub fn rwlock_read_lock(rw: &! RwLock) -> bool {
    let id = rw.id
    if !rwlock_slot_valid(id) { return false }
    if RWLOCK_WRITER[id as usize] != 0 { return false }
    RWLOCK_READERS[id as usize] = RWLOCK_READERS[id as usize] + 1
    return true
}

pub fn rwlock_read_unlock(rw: &! RwLock) {
    let id = rw.id
    if !rwlock_slot_valid(id) { return }
    if RWLOCK_READERS[id as usize] > 0 {
        RWLOCK_READERS[id as usize] = RWLOCK_READERS[id as usize] - 1
    }
}

pub fn rwlock_write_lock(rw: &! RwLock) -> bool {
    let id = rw.id
    if !rwlock_slot_valid(id) { return false }
    if RWLOCK_WRITER[id as usize] != 0 { return false }
    if RWLOCK_READERS[id as usize] != 0 { return false }
    RWLOCK_WRITER[id as usize] = 1
    return true
}

pub fn rwlock_write_unlock(rw: &! RwLock) {
    let id = rw.id
    if !rwlock_slot_valid(id) { return }
    RWLOCK_WRITER[id as usize] = 0
}

pub fn rwlock_reader_count(rw: &! RwLock) -> i64 {
    let id = rw.id
    if !rwlock_slot_valid(id) { return 0 }
    return RWLOCK_READERS[id as usize]
}

pub fn rwlock_is_write_locked(rw: &! RwLock) -> bool {
    let id = rw.id
    if !rwlock_slot_valid(id) { return false }
    return RWLOCK_WRITER[id as usize] != 0
}
