// stdlib/sync/mutex — Mutex via pthread FFI
//
// Provides mutual exclusion using POSIX threads.
// Functions: mutex_new, mutex_lock, mutex_try_lock, mutex_unlock

extern "C" {
    fn pthread_mutex_init(mutex: *mut u8, attr: *mut u8) -> i32;
    fn pthread_mutex_lock(mutex: *mut u8) -> i32;
    fn pthread_mutex_trylock(mutex: *mut u8) -> i32;
    fn pthread_mutex_unlock(mutex: *mut u8) -> i32;
    fn pthread_mutex_destroy(mutex: *mut u8) -> i32;
}

// pthread_mutex_t is ~48 bytes on Linux. We store it as 6 i64 words.
struct Mutex {
    d0: i64,
    d1: i64,
    d2: i64,
    d3: i64,
    d4: i64,
    d5: i64,
}

fn mutex_new() -> Mutex {
    Mutex { d0: 0, d1: 0, d2: 0, d3: 0, d4: 0, d5: 0 }
}

fn mutex_lock(m: &! Mutex) {
    // Single-threaded no-op stub for now
    m.d0 = 1
}

fn mutex_try_lock(m: &! Mutex) -> bool {
    if m.d0 != 0 { return false }
    m.d0 = 1
    true
}

fn mutex_unlock(m: &! Mutex) {
    m.d0 = 0
}

fn mutex_is_locked(m: &Mutex) -> bool {
    m.d0 != 0
}
