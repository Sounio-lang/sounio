// Checked error-checking native mutex. Close consumes the owner after unlock.
use ffi::platform::{Platform,PlatformValue,platform_call}
pub linear struct Mutex {id:i64,status:i64}
pub fn mutex_new(p:&Platform)->Mutex with IO {
    let r=platform_call(p,16,0,0,0,0)
    return Mutex {id:r.value,status:r.status}
}
pub fn mutex_status(m:&Mutex)->i64 {m.status}
pub fn mutex_is_valid(m:&Mutex)->bool {m.status==0 && m.id>0}
pub fn mutex_lock(p:&Platform,m:&Mutex)->i64 with IO {
    if m.status!=0 {return m.status}
    return platform_call(p,17,m.id,0,0,0).status
}
pub fn mutex_try_lock(p:&Platform,m:&Mutex)->PlatformValue with IO {
    if m.status!=0 {return PlatformValue {value:0,status:m.status}}
    return platform_call(p,18,m.id,0,0,0)
}
pub fn mutex_unlock(p:&Platform,m:&Mutex)->i64 with IO {
    if m.status!=0 {return m.status}
    return platform_call(p,19,m.id,0,0,0).status
}
// On EBUSY the caller retains ownership and can unlock before retrying.
pub fn mutex_destroy(p:&Platform,m:&!Mutex)->i64 with IO,Mut {
    if m.status!=0 {return m.status}
    let status=platform_call(p,2,m.id,0,0,0).status
    if status==0 {m.id=0;m.status=9}
    return status
}
pub fn mutex_close(m:Mutex) with Panic {
    let Mutex {id,status}=m
    assert(id==0)
}
