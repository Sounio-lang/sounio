//! Mutex primitives using pthread FFI
//!
//! Provides mutual exclusion synchronization using POSIX threads (pthread) library.
//! This is a low-level implementation using freestanding functions and FFI.
//!
//! Functions:
//! - mutex_new() -> Mutex
//! - mutex_lock(m: &!Mutex)
//! - mutex_try_lock(m: &!Mutex) -> bool
//! - mutex_unlock(m: &!Mutex)
//! - mutex_drop(m: &!Mutex)
//!
//! Example:
//!   var m = mutex_new()
//!   mutex_lock(&!m)
//!   // ... critical section ...
//!   mutex_unlock(&!m)
//!   mutex_drop(&!m)

// FFI declarations for pthread mutex functions
extern "C" {
    fn pthread_mutex_init(mutex: *mut u8, attr: *mut u8) -> i32;
    fn pthread_mutex_lock(mutex: *mut u8) -> i32;
    fn pthread_mutex_trylock(mutex: *mut u8) -> i32;
    fn pthread_mutex_unlock(mutex: *mut u8) -> i32;
    fn pthread_mutex_destroy(mutex: *mut u8) -> i32;
}

// Size for pthread_mutex_t on Linux/macOS (typically 40-48 bytes)
// We use 48 bytes to be safe across platforms
const MUTEX_SIZE: usize = 48

// A mutex wrapping pthread_mutex_t.
// The data array holds the opaque pthread mutex structure.
pub struct Mutex {
    data: [u8; MUTEX_SIZE],
}

// Creates a new mutex in an unlocked state.
// Initializes the underlying pthread_mutex_t structure.
pub fn mutex_new() -> Mutex with Alloc, Panic {
    var mutex = Mutex {
        data: [0; MUTEX_SIZE],
    }

    // Get pointer to the data array
    let mutex_ptr = &!mutex.data[0]
    let null_ptr = null_mut()

    // Initialize pthread mutex with default attributes (null)
    let result = pthread_mutex_init(mutex_ptr, null_ptr)

    if result != 0 {
        panic("Failed to initialize mutex")
    }

    return mutex
}

// Acquires the mutex, blocking until it becomes available.
// If the mutex is already locked by another thread, this function
// will block until the mutex is unlocked.
pub fn mutex_lock(m: &!Mutex) with Panic {
    let mutex_ptr = &!m.data[0]
    let result = pthread_mutex_lock(mutex_ptr)

    if result != 0 {
        panic("Failed to lock mutex")
    }
}

// Attempts to acquire the mutex without blocking.
// Returns true if the lock was successfully acquired, false otherwise.
// This is a non-blocking operation - if the mutex is already locked,
// it returns immediately with false.
pub fn mutex_try_lock(m: &!Mutex) -> bool with Panic {
    let mutex_ptr = &!m.data[0]
    let result = pthread_mutex_trylock(mutex_ptr)

    // pthread_trylock returns 0 on success, EBUSY (16) if already locked
    return result == 0
}

// Releases the mutex.
// The mutex must have been previously locked by the calling thread.
// Unlocking a mutex that is not locked by the calling thread results
// in undefined behavior.
pub fn mutex_unlock(m: &!Mutex) with Panic {
    let mutex_ptr = &!m.data[0]
    let result = pthread_mutex_unlock(mutex_ptr)

    if result != 0 {
        panic("Failed to unlock mutex")
    }
}

// Destroys the mutex and frees associated resources.
// The mutex must not be locked when calling this function.
// After calling mutex_drop, the mutex should not be used again.
pub fn mutex_drop(m: &!Mutex) with Panic {
    let mutex_ptr = &!m.data[0]
    let result = pthread_mutex_destroy(mutex_ptr)

    if result != 0 {
        panic("Failed to destroy mutex")
    }
}

//
// Test functions
//

// Test basic mutex creation and destruction
fn test_mutex_new_drop() with Alloc, Panic {
    var m = mutex_new()
    mutex_drop(&!m)
}

// Test mutex lock and unlock
fn test_mutex_lock_unlock() with Alloc, Panic {
    var m = mutex_new()

    mutex_lock(&!m)
    mutex_unlock(&!m)

    mutex_drop(&!m)
}

// Test mutex try_lock
fn test_mutex_try_lock() with Alloc, Panic {
    var m = mutex_new()

    // First try_lock should succeed
    let acquired = mutex_try_lock(&!m)
    if !acquired {
        panic("First try_lock should succeed")
    }

    // Second try_lock should fail (mutex already locked)
    let acquired2 = mutex_try_lock(&!m)
    if acquired2 {
        panic("Second try_lock should fail")
    }

    // Unlock and try again
    mutex_unlock(&!m)
    let acquired3 = mutex_try_lock(&!m)
    if !acquired3 {
        panic("Third try_lock should succeed after unlock")
    }

    mutex_unlock(&!m)
    mutex_drop(&!m)
}

// Test multiple lock/unlock cycles
fn test_mutex_multiple_cycles() with Alloc, Panic, Div {
    var m = mutex_new()

    var i = 0
    while i < 10 {
        mutex_lock(&!m)
        mutex_unlock(&!m)
        i = i + 1
    }

    mutex_drop(&!m)
}

// Test mutex with critical section
fn test_mutex_critical_section() with Alloc, Panic {
    var m = mutex_new()
    var counter = 0

    mutex_lock(&!m)
    counter = counter + 1
    let value = counter
    mutex_unlock(&!m)

    if value != 1 {
        panic("Counter should be 1")
    }

    mutex_drop(&!m)
}

// Demonstrates safe mutex usage pattern
fn example_mutex_usage() with Alloc, Panic, IO, Div {
    var shared_counter = 0
    var m = mutex_new()

    // Simulate multiple operations on shared data
    var i = 0
    while i < 5 {
        mutex_lock(&!m)

        // Critical section - only one thread can execute this at a time
        shared_counter = shared_counter + 1
        let current = shared_counter

        mutex_unlock(&!m)

        i = i + 1
    }

    // Final value should be 5
    mutex_lock(&!m)
    let final_value = shared_counter
    mutex_unlock(&!m)

    mutex_drop(&!m)
}

// Example with try_lock for non-blocking mutex acquisition
fn example_try_lock_pattern() with Alloc, Panic, IO, Div {
    var m = mutex_new()
    var attempts = 0
    var max_attempts = 3

    while attempts < max_attempts {
        let acquired = mutex_try_lock(&!m)

        if acquired {
            // Got the lock - do work
            // ... critical section ...
            mutex_unlock(&!m)
            break
        }

        // Didn't get lock - could do other work here
        attempts = attempts + 1
    }

    if attempts == max_attempts {
        panic("Failed to acquire lock after max attempts")
    }

    mutex_drop(&!m)
}
