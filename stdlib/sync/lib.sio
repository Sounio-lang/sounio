//! stdlib/sync - Synchronization Primitives
//!
//! Thread-safe synchronization primitives for concurrent programming.
//!
//! # Modules
//! - `atomic` - Atomic integer operations
//! - `mutex` - Mutual exclusion locks
//! - `channel` - Message passing channels (MPSC)
//!
//! # Examples
//! ```sio
//! // Atomic counter
//! var counter = AtomicI64::new(0)
//! atomic_i64_fetch_add(&!counter, 1, Ordering::SeqCst)
//!
//! // Mutex-protected data
//! var lock = mutex_new()
//! mutex_lock(&!lock)
//! // ... critical section ...
//! mutex_unlock(&!lock)
//! ```

pub mod atomic;
pub mod mutex;
pub mod channel;
