//! stdlib/sync/lib.sio - Synchronization primitives
//!
//! This module provides thread-safe synchronization primitives for concurrent programming.
//!
//! # Synchronization Primitives
//!
//! The module includes four categories of synchronization mechanisms:
//!
//! - **Atomic** (atomic.sio): Lock-free atomic operations for primitive types.
//!   Best for simple counters, flags, and coordination without blocking.
//!   Functions: `atomic_i64_new()`, `atomic_i64_fetch_add()`, `atomic_i64_load()`, etc.
//!
//! - **Mutex** (mutex.sio): Mutual exclusion locks for protecting shared data.
//!   Best for critical sections with exclusive access to shared state.
//!   Functions: `mutex_new()`, `mutex_lock()`, `mutex_unlock()`, `mutex_try_lock()`
//!
//! - **RwLock** (rwlock.sio): Reader-writer locks allowing multiple readers or one writer.
//!   Best for data with frequent reads and infrequent writes.
//!   Functions: `rwlock_new()`, `rwlock_read()`, `rwlock_write()`, `rwlock_try_read()`
//!
//! - **Channel** (channel.sio): Multi-producer single-consumer message passing channels.
//!   Best for thread communication via message passing instead of shared memory.
//!   Functions: `channel_new()`, `channel_send()`, `channel_recv()`, `channel_try_recv()`
//!
//! # Usage Example
//!
//! ```sio
//! // Atomic counter - lock-free
//! var counter = atomic_i64_new(0)
//! atomic_i64_fetch_add(&!counter, 1, Ordering::SeqCst)
//! let value = atomic_i64_load(&counter, Ordering::Acquire)
//!
//! // Mutex - exclusive access
//! var lock = mutex_new()
//! mutex_lock(&!lock)
//! // ... critical section ...
//! mutex_unlock(&!lock)
//!
//! // RwLock - multiple readers
//! var data = rwlock_new(vec![1, 2, 3])
//! let read_guard = rwlock_read(&data)   // Many readers OK
//! let write_guard = rwlock_write(&!data)  // Exclusive writer
//!
//! // Channel - message passing
//! var (tx, rx) = channel_new()
//! channel_send(&!tx, 42)
//! let msg = channel_recv(&!rx)
//! ```

// Synchronization modules
pub mod atomic;
pub mod mutex;
pub mod rwlock;
pub mod channel;
