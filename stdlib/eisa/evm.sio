module eisa::evm

use math::dd64::*
use math::qd128::*
use eisa::core::*
use eisa::core_v2::*
use eisa::format::*

// Err-lane storage note (v2 widening, arch doc 2026-07-05 §4): on v0/v1
// images only reg_ehi/reg_elo carry the dd64 err lane (hi/lo) and
// reg_e2/reg_e3 stay 0. On v2 images the four arrays reg_ehi/reg_elo/
// reg_e2/reg_e3 are the Qd128 err components x0/x1/x2/x3 respectively
// (names kept so the v0/v1 code paths are byte-untouched). Same convention
// for mem_ehi/mem_elo/mem_e2/mem_e3.
pub struct EvmMachine {
    pub reg_val: [f64; 64],
    pub reg_ehi: [f64; 64],
    pub reg_elo: [f64; 64],
    pub reg_e2: [f64; 64],
    pub reg_e3: [f64; 64],
    pub reg_u: [f64; 64],
    pub reg_poison: [i64; 64],
    pub mem_val: [f64; 32],
    pub mem_ehi: [f64; 32],
    pub mem_elo: [f64; 32],
    pub mem_e2: [f64; 32],
    pub mem_e3: [f64; 32],
    pub mem_u: [f64; 32],
    pub mem_poison: [i64; 32],
    pub gate_count: i64,
    pub halted: i64,
    pub error: i64,
    pub loaded: i64,
    pub pc: i64,
    pub n_code: i64,
    pub n_const: i64,
    pub prog_hash: i64,
    pub code_op: [i64; 256],
    pub code_dst: [i64; 256],
    pub code_a: [i64; 256],
    pub code_b: [i64; 256],
    pub const_pool: [f64; 64],
    pub version: i64,
    pub fuel_left: i64,
    pub initial_fuel: i64,
    pub stop_kind: i64,
    pub br_poisoned: i64,
    pub frail_branches: i64,
    pub last_written_reg: i64,
}

fn make_inf_runtime() -> f64 with Mut {
    var buf: [f64; 3] = [0.0; 3]
    buf[0] = 0.0
    buf[1] = 1.0e308
    buf[2] = 10.0
    buf[1] * buf[2]
}

fn make_nan_runtime() -> f64 with Div, Panic {
    var buf: [f64; 1] = [0.0; 1]
    buf[0] = 0.0
    let z = buf[0]
    z / z
}

fn evm_is_v1(m: &EvmMachine) -> bool {
    m.version == eisax_version_v1()
}

fn evm_is_v2(m: &EvmMachine) -> bool {
    m.version == eisax_version_v2()
}

// v1-or-v2: v2 shares every v1 structural/control-flow rule (caps, fuel,
// branches, ehalt); only the err-lane depth and receipt version differ.
fn evm_is_v1plus(m: &EvmMachine) -> bool {
    evm_is_v1(m) || evm_is_v2(m)
}

fn evm_reg_cap(m: &EvmMachine) -> i64 {
    if evm_is_v1plus(m) { 64 } else { 16 }
}

fn evm_mem_cap(m: &EvmMachine) -> i64 {
    if evm_is_v1plus(m) { 32 } else { 8 }
}

fn evm_idx_reg_ok(m: &EvmMachine, i: i64) -> bool {
    i >= 0 && i < evm_reg_cap(m)
}

fn evm_idx_mem_ok(m: &EvmMachine, i: i64) -> bool {
    i >= 0 && i < evm_mem_cap(m)
}

fn lane_tuple_ok(v: f64, ehi: f64, elo: f64, u: f64) -> bool {
    if u < 0.0 { return false }
    is_finite_f64(v) && is_finite_f64(ehi) && is_finite_f64(elo) && is_finite_f64(u)
}

fn abs_f64_local(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn normalize_u_write(version: i64, u: f64) -> f64 with Div {
    if version != eisax_version_v1() && version != eisax_version_v2() { return u }
    if u == 0.0 {
        let inv = 1.0 / u
        if inv < 0.0 {
            return 0.0
        }
    }
    u
}

fn write_reg_raw(
    m: &!EvmMachine,
    r: i64,
    val: f64,
    ehi: f64,
    elo: f64,
    u: f64,
    poisoned: i64
) with Mut, Div, Panic {
    m.reg_val[r as usize] = val
    m.reg_ehi[r as usize] = ehi
    m.reg_elo[r as usize] = elo
    // v2: the two-word write clears the deep components; v2-aware writers
    // (evm_write_reg_clean2, eload/emov copies) set them explicitly after.
    if m.version == eisax_version_v2() {
        m.reg_e2[r as usize] = 0.0
        m.reg_e3[r as usize] = 0.0
    }
    m.reg_u[r as usize] = normalize_u_write(m.version, u)
    m.reg_poison[r as usize] = poisoned
    m.last_written_reg = r
}

fn write_mem_raw(
    m: &!EvmMachine,
    s: i64,
    val: f64,
    ehi: f64,
    elo: f64,
    u: f64,
    poisoned: i64
) with Mut, Div, Panic {
    m.mem_val[s as usize] = val
    m.mem_ehi[s as usize] = ehi
    m.mem_elo[s as usize] = elo
    if m.version == eisax_version_v2() {
        m.mem_e2[s as usize] = 0.0
        m.mem_e3[s as usize] = 0.0
    }
    m.mem_u[s as usize] = normalize_u_write(m.version, u)
    m.mem_poison[s as usize] = poisoned
}

fn evm_set_reg_poison(m: &!EvmMachine, r: i64) with Mut, Div, Panic {
    write_reg_raw(m, r, make_nan_runtime(), 0.0, 0.0, make_inf_runtime(), 1)
}

fn evm_set_mem_poison(m: &!EvmMachine, s: i64) with Mut, Div, Panic {
    write_mem_raw(m, s, make_nan_runtime(), 0.0, 0.0, make_inf_runtime(), 1)
}

fn evm_reg_to_ereg(m: &EvmMachine, r: i64) -> EReg with Panic {
    // Residual: EvmMachine has no origin lane. See eisa::isa::reg_to_ereg.
    EReg {
        val: m.reg_val[r as usize],
        err: Dd64 { hi: m.reg_ehi[r as usize], lo: m.reg_elo[r as usize] },
        u: m.reg_u[r as usize],
        origin: 0,
    }
}

fn evm_write_reg_clean(m: &!EvmMachine, r: i64, z: EReg) with Mut, Div, Panic {
    write_reg_raw(m, r, z.val, z.err.hi, z.err.lo, z.u, 0)
}

// v2 path: reg_ehi/reg_elo/reg_e2/reg_e3 hold the Qd128 components x0..x3.
fn evm_reg_to_ereg2(m: &EvmMachine, r: i64) -> EReg2 with Panic {
    EReg2 {
        val: m.reg_val[r as usize],
        err: Qd128 {
            x0: m.reg_ehi[r as usize],
            x1: m.reg_elo[r as usize],
            x2: m.reg_e2[r as usize],
            x3: m.reg_e3[r as usize],
        },
        u: m.reg_u[r as usize],
    }
}

fn evm_write_reg_clean2(m: &!EvmMachine, r: i64, z: EReg2) with Mut, Div, Panic {
    write_reg_raw(m, r, z.val, z.err.x0, z.err.x1, z.u, 0)
    m.reg_e2[r as usize] = z.err.x2
    m.reg_e3[r as usize] = z.err.x3
}

fn normalize_reg_lane(m: &!EvmMachine, r: i64) -> bool with Mut, Div, Panic {
    if m.reg_poison[r as usize] == 1 {
        evm_set_reg_poison(m, r)
        return false
    }
    m.reg_u[r as usize] = normalize_u_write(m.version, m.reg_u[r as usize])
    if !lane_tuple_ok(
        m.reg_val[r as usize],
        m.reg_ehi[r as usize],
        m.reg_elo[r as usize],
        m.reg_u[r as usize]
    ) {
        evm_set_reg_poison(m, r)
        return false
    }
    // I3 on v2 (arch doc §1): poison iff ANY of the four stored err
    // components is non-finite (dual-semantics detector from eisa::format).
    if m.version == eisax_version_v2() {
        if !is_finite_f64(m.reg_e2[r as usize]) || !is_finite_f64(m.reg_e3[r as usize]) {
            evm_set_reg_poison(m, r)
            return false
        }
    }
    true
}

fn normalize_mem_lane(m: &!EvmMachine, s: i64) -> bool with Mut, Div, Panic {
    if m.mem_poison[s as usize] == 1 {
        evm_set_mem_poison(m, s)
        return false
    }
    m.mem_u[s as usize] = normalize_u_write(m.version, m.mem_u[s as usize])
    if !lane_tuple_ok(
        m.mem_val[s as usize],
        m.mem_ehi[s as usize],
        m.mem_elo[s as usize],
        m.mem_u[s as usize]
    ) {
        evm_set_mem_poison(m, s)
        return false
    }
    if m.version == eisax_version_v2() {
        if !is_finite_f64(m.mem_e2[s as usize]) || !is_finite_f64(m.mem_e3[s as usize]) {
            evm_set_mem_poison(m, s)
            return false
        }
    }
    true
}

fn print_i64_dec(n: i64) with IO, Mut, Div {
    if n == 0 {
        print("0")
        return
    }

    var v = n
    if v < 0 {
        print("-")
        v = 0 - v
    }

    var buf: [i64; 20] = [0; 20]
    var len = 0
    while v > 0 {
        buf[len as usize] = v - (v / 10) * 10
        v = v / 10
        len = len + 1
    }

    var i = len - 1
    while i >= 0 {
        let d = buf[i as usize]
        if d == 0 { print("0") }
        if d == 1 { print("1") }
        if d == 2 { print("2") }
        if d == 3 { print("3") }
        if d == 4 { print("4") }
        if d == 5 { print("5") }
        if d == 6 { print("6") }
        if d == 7 { print("7") }
        if d == 8 { print("8") }
        if d == 9 { print("9") }
        i = i - 1
    }
}

fn print_f64_parts_field(p: F64Parts) with IO, Mut, Div {
    print("s")
    print_i64_dec(p.sign)
    print("e")
    print_i64_dec(p.exp)
    print("m")
    print_i64_dec(p.mant)
}

fn emit_receipt_v1(m: &EvmMachine, r: i64) with IO, Mut, Div, Panic {
    let vb = f64_parts(m.reg_val[r as usize])
    let rb = f64_parts(m.reg_ehi[r as usize])
    let ub = f64_parts(m.reg_u[r as usize])
    let poisoned = m.reg_poison[r as usize]

    print("eisa-receipt: v=1 prog=")
    print_i64_dec(m.prog_hash)
    print(" gate=")
    print_i64_dec(m.gate_count)
    print(" reg=e")
    print_i64_dec(r)
    print(" val=")
    print_f64_parts_field(vb)
    print(" roundoff=")
    print_f64_parts_field(rb)
    print(" u=")
    print_f64_parts_field(ub)
    print(" poisoned=")
    print_i64_dec(poisoned)
    println("")
}

fn emit_receipt_v2(
    m: &EvmMachine,
    r: i64,
    poisoned: i64,
    emit_stop_fuel: i64
) with IO, Mut, Div, Panic {
    let vb = f64_parts(m.reg_val[r as usize])
    let rb = f64_parts(m.reg_ehi[r as usize])
    let ub = f64_parts(m.reg_u[r as usize])

    print("eisa-receipt: v=2 prog=")
    print_i64_dec(m.prog_hash)
    print(" gate=")
    print_i64_dec(m.gate_count)
    print(" reg=e")
    print_i64_dec(r)
    print(" val=")
    print_f64_parts_field(vb)
    print(" roundoff=")
    print_f64_parts_field(rb)
    print(" u=")
    print_f64_parts_field(ub)
    print(" poisoned=")
    print_i64_dec(poisoned)
    print(" frail=")
    print_i64_dec(m.frail_branches)
    if emit_stop_fuel == 1 {
        print(" stop=fuel")
    }
    println("")
}

// Receipt v3 (arch doc §3): emitted ONLY by version-2 images. All four err
// components in f64_parts decomposition; roundoff0 is field-compatible with
// v2's roundoff for leading-term readers.
fn emit_receipt_v3(
    m: &EvmMachine,
    r: i64,
    poisoned: i64,
    emit_stop_fuel: i64
) with IO, Mut, Div, Panic {
    let vb = f64_parts(m.reg_val[r as usize])
    let r0 = f64_parts(m.reg_ehi[r as usize])
    let r1 = f64_parts(m.reg_elo[r as usize])
    let r2 = f64_parts(m.reg_e2[r as usize])
    let r3 = f64_parts(m.reg_e3[r as usize])
    let ub = f64_parts(m.reg_u[r as usize])

    print("eisa-receipt: v=3 prog=")
    print_i64_dec(m.prog_hash)
    print(" gate=")
    print_i64_dec(m.gate_count)
    print(" reg=e")
    print_i64_dec(r)
    print(" val=")
    print_f64_parts_field(vb)
    print(" roundoff0=")
    print_f64_parts_field(r0)
    print(" roundoff1=")
    print_f64_parts_field(r1)
    print(" roundoff2=")
    print_f64_parts_field(r2)
    print(" roundoff3=")
    print_f64_parts_field(r3)
    print(" u=")
    print_f64_parts_field(ub)
    print(" poisoned=")
    print_i64_dec(poisoned)
    print(" frail=")
    print_i64_dec(m.frail_branches)
    if emit_stop_fuel == 1 {
        print(" stop=fuel")
    }
    println("")
}

fn emit_gate_receipt(m: &EvmMachine, r: i64) with IO, Mut, Div, Panic {
    if evm_is_v2(m) {
        let poisoned = if m.reg_poison[r as usize] == 1 || m.br_poisoned == 1 { 1 } else { 0 }
        emit_receipt_v3(m, r, poisoned, 0)
    } else {
        if evm_is_v1(m) {
            let poisoned = if m.reg_poison[r as usize] == 1 || m.br_poisoned == 1 { 1 } else { 0 }
            emit_receipt_v2(m, r, poisoned, 0)
        } else {
            emit_receipt_v1(m, r)
        }
    }
}

fn emit_fuel_stop_receipt(m: &!EvmMachine) with IO, Mut, Div, Panic {
    var r = m.last_written_reg
    if !evm_idx_reg_ok(m, r) {
        r = 0
    }
    if evm_is_v2(m) {
        emit_receipt_v3(m, r, 1, 1)
    } else {
        emit_receipt_v2(m, r, 1, 1)
    }
}

fn branch_frail_predicate(val: f64, ehi: f64, u: f64) -> bool {
    let band = if u > abs_f64_local(ehi) { u } else { abs_f64_local(ehi) }
    if band == 0.0 { return false }
    abs_f64_local(val) <= band
}

pub fn evm_new() -> EvmMachine {
    EvmMachine {
        reg_val: [0.0; 64],
        reg_ehi: [0.0; 64],
        reg_elo: [0.0; 64],
        reg_e2: [0.0; 64],
        reg_e3: [0.0; 64],
        reg_u: [0.0; 64],
        reg_poison: [0; 64],
        mem_val: [0.0; 32],
        mem_ehi: [0.0; 32],
        mem_elo: [0.0; 32],
        mem_e2: [0.0; 32],
        mem_e3: [0.0; 32],
        mem_u: [0.0; 32],
        mem_poison: [0; 32],
        gate_count: 0,
        halted: 0,
        error: 0,
        loaded: 0,
        pc: 0,
        n_code: 0,
        n_const: 0,
        prog_hash: 0,
        code_op: [0; 256],
        code_dst: [0; 256],
        code_a: [0; 256],
        code_b: [0; 256],
        const_pool: [0.0; 64],
        version: 0,
        fuel_left: 0,
        initial_fuel: 0,
        stop_kind: 0,
        br_poisoned: 0,
        frail_branches: 0,
        last_written_reg: 0 - 1,
    }
}

pub fn evm_load(img: EisaxImage) -> EvmMachine with Mut, Div, Panic {
    var m = evm_new()
    let rc = eisax_validate(img)
    if rc != 0 {
        m.error = 1
        m.halted = 1
        return m
    }

    m.loaded = 1
    m.halted = 0
    m.error = 0
    m.pc = 0
    m.n_code = eisax_n_code(img)
    m.n_const = img.c_len
    m.prog_hash = eisax_prog_hash(img)
    m.version = img.w[1]
    if m.version == eisax_version_v1() || m.version == eisax_version_v2() {
        m.fuel_left = eisax_fuel(img)
        m.initial_fuel = m.fuel_left
    } else {
        m.fuel_left = 0
        m.initial_fuel = 0
    }
    m.stop_kind = 0
    m.br_poisoned = 0
    m.frail_branches = 0
    m.last_written_reg = 0 - 1

    var i = 0
    while i < m.n_code {
        m.code_op[i as usize] = eisax_code_op(img, i)
        m.code_dst[i as usize] = eisax_code_dst(img, i)
        m.code_a[i as usize] = eisax_code_a(img, i)
        m.code_b[i as usize] = eisax_code_b(img, i)
        i = i + 1
    }

    i = 0
    while i < m.n_const {
        m.const_pool[i as usize] = eisax_const(img, i)
        i = i + 1
    }

    m
}

pub fn evm_step(m: &!EvmMachine) -> i64 with IO, Mut, Div, Panic {
    if m.error != 0 { return 1 }
    if m.halted != 0 { return 0 }
    if m.loaded == 0 {
        m.error = 1
        m.halted = 1
        return 1
    }
    if m.pc >= m.n_code {
        m.halted = 1
        m.stop_kind = 0
        return 0
    }

    if evm_is_v1plus(m) && m.fuel_left <= 0 {
        m.stop_kind = 1
        m.halted = 1
        emit_fuel_stop_receipt(m)
        return 0
    }

    if evm_is_v1plus(m) {
        m.fuel_left = m.fuel_left - 1
    }

    let op = m.code_op[m.pc as usize]
    let dst = m.code_dst[m.pc as usize]
    let a = m.code_a[m.pc as usize]
    let b = m.code_b[m.pc as usize]

    if op == op_econst() {
        if !evm_idx_reg_ok(m, dst) {
            m.error = 1
            m.halted = 1
            return 1
        }
        if a < 0 || a >= m.n_const {
            m.error = 1
            m.halted = 1
            return 1
        }
        let c = m.const_pool[a as usize]
        if !is_finite_f64(c) {
            evm_set_reg_poison(m, dst)
        } else {
            write_reg_raw(m, dst, c, 0.0, 0.0, 0.0, 0)
        }
        m.pc = m.pc + 1
        return 0
    }

    if op == op_eload() {
        if !evm_idx_reg_ok(m, dst) || !evm_idx_mem_ok(m, a) {
            m.error = 1
            m.halted = 1
            return 1
        }
        let mem_ok = normalize_mem_lane(m, a)
        if !mem_ok {
            evm_set_reg_poison(m, dst)
        } else {
            write_reg_raw(
                m,
                dst,
                m.mem_val[a as usize],
                m.mem_ehi[a as usize],
                m.mem_elo[a as usize],
                m.mem_u[a as usize],
                m.mem_poison[a as usize]
            )
            if evm_is_v2(m) {
                m.reg_e2[dst as usize] = m.mem_e2[a as usize]
                m.reg_e3[dst as usize] = m.mem_e3[a as usize]
            }
            let _norm = normalize_reg_lane(m, dst)
        }
        m.pc = m.pc + 1
        return 0
    }

    if op == op_estore() {
        if !evm_idx_reg_ok(m, dst) || !evm_idx_mem_ok(m, a) {
            m.error = 1
            m.halted = 1
            return 1
        }
        let reg_ok = normalize_reg_lane(m, dst)
        if !reg_ok {
            evm_set_mem_poison(m, a)
        } else {
            write_mem_raw(
                m,
                a,
                m.reg_val[dst as usize],
                m.reg_ehi[dst as usize],
                m.reg_elo[dst as usize],
                m.reg_u[dst as usize],
                m.reg_poison[dst as usize]
            )
            if evm_is_v2(m) {
                m.mem_e2[a as usize] = m.reg_e2[dst as usize]
                m.mem_e3[a as usize] = m.reg_e3[dst as usize]
            }
            let _norm = normalize_mem_lane(m, a)
        }
        m.pc = m.pc + 1
        return 0
    }

    if op == op_emov() {
        if !evm_idx_reg_ok(m, dst) || !evm_idx_reg_ok(m, a) {
            m.error = 1
            m.halted = 1
            return 1
        }
        let src_ok = normalize_reg_lane(m, a)
        if !src_ok {
            evm_set_reg_poison(m, dst)
        } else {
            // Read the deep components BEFORE write_reg_raw clears them
            // (dst may alias a on emov).
            let src_e2 = m.reg_e2[a as usize]
            let src_e3 = m.reg_e3[a as usize]
            write_reg_raw(
                m,
                dst,
                m.reg_val[a as usize],
                m.reg_ehi[a as usize],
                m.reg_elo[a as usize],
                m.reg_u[a as usize],
                m.reg_poison[a as usize]
            )
            if evm_is_v2(m) {
                m.reg_e2[dst as usize] = src_e2
                m.reg_e3[dst as usize] = src_e3
            }
            let _dst_ok = normalize_reg_lane(m, dst)
        }
        m.pc = m.pc + 1
        return 0
    }

    if op == op_ebr() {
        if !evm_is_v1plus(m) {
            m.error = 1
            m.halted = 1
            return 1
        }
        if a == m.n_code {
            m.pc = m.n_code
            m.halted = 1
            m.stop_kind = 0
            return 0
        }
        m.pc = a
        return 0
    }

    if op == op_ebrz() || op == op_ebrn() {
        if !evm_is_v1plus(m) {
            m.error = 1
            m.halted = 1
            return 1
        }
        if !evm_idx_reg_ok(m, a) {
            m.error = 1
            m.halted = 1
            return 1
        }
        let ok = normalize_reg_lane(m, a)
        if !ok {
            m.br_poisoned = 1
            m.pc = m.pc + 1
            return 0
        }

        if branch_frail_predicate(m.reg_val[a as usize], m.reg_ehi[a as usize], m.reg_u[a as usize]) {
            m.frail_branches = m.frail_branches + 1
        }

        var take = 0
        if op == op_ebrz() {
            if m.reg_val[a as usize] == 0.0 {
                take = 1
            }
        } else {
            if m.reg_val[a as usize] < 0.0 {
                take = 1
            }
        }
        if take == 1 {
            if b == m.n_code {
                m.pc = m.n_code
                m.halted = 1
                m.stop_kind = 0
                return 0
            }
            m.pc = b
            return 0
        }
        m.pc = m.pc + 1
        return 0
    }

    if op == op_eadd() || op == op_esub() || op == op_emul() || op == op_ediv() {
        if !evm_idx_reg_ok(m, dst) || !evm_idx_reg_ok(m, a) || !evm_idx_reg_ok(m, b) {
            m.error = 1
            m.halted = 1
            return 1
        }
        let a_ok = normalize_reg_lane(m, a)
        let b_ok = normalize_reg_lane(m, b)
        if !a_ok || !b_ok {
            evm_set_reg_poison(m, dst)
            m.pc = m.pc + 1
            return 0
        }

        // v2 path: closure contract over qd128 via eisa::core_v2 (the EVM
        // calls the reference module so EVM and reference cannot drift).
        if evm_is_v2(m) {
            let ra2 = evm_reg_to_ereg2(m, a)
            let rb2 = evm_reg_to_ereg2(m, b)
            if op == op_ediv() && rb2.val == 0.0 {
                evm_set_reg_poison(m, dst)
                m.pc = m.pc + 1
                return 0
            }

            let rz2 = if op == op_eadd() {
                eadd2(ra2, rb2)
            } else {
                if op == op_esub() {
                    esub2(ra2, rb2)
                } else {
                    if op == op_emul() {
                        emul2(ra2, rb2)
                    } else {
                        ediv2(ra2, rb2)
                    }
                }
            }

            // I3 on v2: poison iff val, u or ANY of the four err components
            // is non-finite.
            if !lane_tuple_ok(rz2.val, rz2.err.x0, rz2.err.x1, rz2.u) ||
               !is_finite_f64(rz2.err.x2) || !is_finite_f64(rz2.err.x3) {
                evm_set_reg_poison(m, dst)
            } else {
                evm_write_reg_clean2(m, dst, rz2)
            }

            m.pc = m.pc + 1
            return 0
        }

        let ra = evm_reg_to_ereg(m, a)
        let rb = evm_reg_to_ereg(m, b)
        if op == op_ediv() && rb.val == 0.0 {
            evm_set_reg_poison(m, dst)
            m.pc = m.pc + 1
            return 0
        }

        let rz = if op == op_eadd() {
            eadd(ra, rb)
        } else {
            if op == op_esub() {
                esub(ra, rb)
            } else {
                if op == op_emul() {
                    emul(ra, rb)
                } else {
                    ediv(ra, rb)
                }
            }
        }

        if !lane_tuple_ok(rz.val, rz.err.hi, rz.err.lo, rz.u) {
            evm_set_reg_poison(m, dst)
        } else {
            evm_write_reg_clean(m, dst, rz)
        }

        m.pc = m.pc + 1
        return 0
    }

    if op == op_esqrt() {
        if !evm_idx_reg_ok(m, dst) || !evm_idx_reg_ok(m, a) {
            m.error = 1
            m.halted = 1
            return 1
        }
        let a_ok = normalize_reg_lane(m, a)
        if !a_ok {
            evm_set_reg_poison(m, dst)
            m.pc = m.pc + 1
            return 0
        }

        if evm_is_v2(m) {
            let ra2 = evm_reg_to_ereg2(m, a)
            let rz2 = esqrt2(ra2)
            if !lane_tuple_ok(rz2.val, rz2.err.x0, rz2.err.x1, rz2.u) ||
               !is_finite_f64(rz2.err.x2) || !is_finite_f64(rz2.err.x3) {
                evm_set_reg_poison(m, dst)
            } else {
                evm_write_reg_clean2(m, dst, rz2)
            }
            m.pc = m.pc + 1
            return 0
        }

        let ra = evm_reg_to_ereg(m, a)
        let rz = esqrt(ra)
        if !lane_tuple_ok(rz.val, rz.err.hi, rz.err.lo, rz.u) {
            evm_set_reg_poison(m, dst)
        } else {
            evm_write_reg_clean(m, dst, rz)
        }
        m.pc = m.pc + 1
        return 0
    }

    if op == op_egate() {
        if !evm_idx_reg_ok(m, dst) {
            m.error = 1
            m.halted = 1
            return 1
        }
        let _dst_ok = normalize_reg_lane(m, dst)
        m.gate_count = m.gate_count + 1
        let receipt_poisoned = if evm_is_v1plus(m) && m.br_poisoned == 1 {
            1
        } else {
            m.reg_poison[dst as usize]
        }
        let _code = if receipt_poisoned == 1 {
            2
        } else {
            if evm_is_v2(m) {
                let r2 = evm_reg_to_ereg2(m, dst)
                egate2(r2, 2)
            } else {
                let r = evm_reg_to_ereg(m, dst)
                egate(r, 2)
            }
        }
        emit_gate_receipt(m, dst)
        m.pc = m.pc + 1
        return 0
    }

    if op == op_ehalt() {
        if !evm_is_v1plus(m) {
            m.error = 1
            m.halted = 1
            return 1
        }
        m.halted = 1
        m.stop_kind = 0
        m.pc = m.n_code
        return 0
    }

    m.error = 1
    m.halted = 1
    1
}

pub fn evm_run(m: &!EvmMachine) -> i64 with IO, Mut, Div, Panic {
    if m.loaded == 0 {
        m.error = 1
        m.halted = 1
        return 1
    }
    if m.error != 0 { return 1 }

    while m.halted == 0 {
        let rc = evm_step(m)
        if rc != 0 { return 1 }
    }
    m.error
}

pub fn evm_reg_val(m: &EvmMachine, r: i64) -> f64 with Panic {
    m.reg_val[r as usize]
}

pub fn evm_reg_ehi(m: &EvmMachine, r: i64) -> f64 with Panic {
    m.reg_ehi[r as usize]
}

pub fn evm_reg_elo(m: &EvmMachine, r: i64) -> f64 with Panic {
    m.reg_elo[r as usize]
}

pub fn evm_reg_e2(m: &EvmMachine, r: i64) -> f64 with Panic {
    m.reg_e2[r as usize]
}

pub fn evm_reg_e3(m: &EvmMachine, r: i64) -> f64 with Panic {
    m.reg_e3[r as usize]
}

pub fn evm_reg_u(m: &EvmMachine, r: i64) -> f64 with Panic {
    m.reg_u[r as usize]
}

/// Derived zero-event flags for an EVM register. This is a receipt view over
/// the existing val/err lanes; it does not alter machine state or infer cause.
pub fn evm_reg_zero_flags(m: &EvmMachine, r: i64) -> i64 with Panic {
    core_v2_zero_flags_raw(
        m.reg_val[r as usize],
        m.reg_ehi[r as usize],
        m.reg_elo[r as usize],
        m.reg_e2[r as usize],
        m.reg_e3[r as usize],
    )
}

pub fn evm_reg_poison(m: &EvmMachine, r: i64) -> i64 with Panic {
    m.reg_poison[r as usize]
}

pub fn evm_mem_val(m: &EvmMachine, s: i64) -> f64 with Panic {
    m.mem_val[s as usize]
}

pub fn evm_mem_ehi(m: &EvmMachine, s: i64) -> f64 with Panic {
    m.mem_ehi[s as usize]
