}

pub fn evm_mem_poison(m: &EvmMachine, s: i64) -> i64 with Panic {
    m.mem_poison[s as usize]
}

pub fn evm_gate_count(m: &EvmMachine) -> i64 {
    m.gate_count
}

pub fn evm_error(m: &EvmMachine) -> i64 {
    m.error
}

pub fn evm_loaded(m: &EvmMachine) -> i64 {
