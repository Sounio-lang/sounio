module eisa::asm

use eisa::format::*
use str::lib::*

pub struct AsmResult {
    pub build: EisaxBuild,
    pub status: i64,
}

struct SymLookup {
    pub ok: bool,
    pub slot: i64,
    pub next_count: i64,
}

struct TwoRegs {
    pub ok: bool,
    pub a: i64,
    pub b: i64,
}

fn asm_fail(line: i64) -> AsmResult {
    AsmResult { build: eisax_build_new(), status: line }
}

fn is_space(ch: i8) -> bool {
    ch == 32 as i8 || ch == 9 as i8
}

fn is_digit(ch: i8) -> bool {
    ch >= 48 as i8 && ch <= 57 as i8
}

fn is_alpha(ch: i8) -> bool {
    (ch >= 65 as i8 && ch <= 90 as i8) || (ch >= 97 as i8 && ch <= 122 as i8)
}

fn is_ident_char(ch: i8) -> bool {
    is_alpha(ch) || is_digit(ch) || ch == 95 as i8
}

fn str_lit(s: string) -> Str with Mut, Div, Panic {
    str_from_literal(s)
}

fn str_copy(s: &Str) -> Str with Mut, Div, Panic {
    str_sub(s, 0, s.len)
}

fn strip_comment(line: &Str) -> Str with Mut, Div, Panic {
    var i = 0
    while i < line.len {
        if line.data[i as usize] == 59 as i8 {
            return str_sub(line, 0, i)
        }
        i = i + 1
    }
    str_copy(line)
}

fn parse_i64_token(tok: &Str, ok: &!bool) -> i64 with Mut, Div, Panic {
    if tok.len <= 0 {
        *ok = false
        return 0
    }
    var i = 0
    while i < tok.len {
        if !is_digit(tok.data[i as usize]) {
            *ok = false
            return 0
        }
        i = i + 1
    }
    *ok = true
    str_to_i64(tok)
}

fn parse_reg(tok: &Str, ok: &!bool) -> i64 with Mut, Div, Panic {
    if tok.len < 2 {
        *ok = false
        return 0
    }
    if tok.data[0] != 101 as i8 {
        *ok = false
        return 0
    }
    let rest = str_sub(tok, 1, tok.len)
    var n_ok = false
    let n = parse_i64_token(&rest, &!n_ok)
    if !n_ok || n < 0 || n >= 16 {
        *ok = false
        return 0
    }
    *ok = true
    n
}

fn valid_float_token(tok: &Str) -> bool with Mut, Panic {
    if tok.len <= 0 { return false }
    var i = 0
    if tok.data[0] == 45 as i8 {
        i = 1
        if i >= tok.len { return false }
    }

    var pre = 0
    while i < tok.len && is_digit(tok.data[i as usize]) {
        pre = pre + 1
        i = i + 1
    }
    if i >= tok.len || tok.data[i as usize] != 46 as i8 { return false }
    if pre <= 0 { return false }
    i = i + 1

    var post = 0
    while i < tok.len && is_digit(tok.data[i as usize]) {
        post = post + 1
        i = i + 1
    }
    if post <= 0 { return false }

    if i < tok.len && (tok.data[i as usize] == 101 as i8 || tok.data[i as usize] == 69 as i8) {
        i = i + 1
        if i < tok.len && (tok.data[i as usize] == 45 as i8 || tok.data[i as usize] == 43 as i8) {
            i = i + 1
        }
        var expd = 0
        while i < tok.len && is_digit(tok.data[i as usize]) {
            expd = expd + 1
            i = i + 1
        }
        if expd <= 0 { return false }
    }

    i == tok.len
}

fn parse_bracket_symbol(tok: &Str, out: &!Str) -> bool with Mut, Div, Panic {
    let t = str_trim(tok)
    if t.len < 3 { return false }
    if t.data[0] != 91 as i8 { return false }
    if t.data[(t.len - 1) as usize] != 93 as i8 { return false }
    let inner = str_sub(&t, 1, t.len - 1)
    let mid = str_trim(&inner)
    if mid.len <= 0 { return false }
    if !is_alpha(mid.data[0]) { return false }
    var i = 1
    while i < mid.len {
        if !is_ident_char(mid.data[i as usize]) { return false }
        i = i + 1
    }
    *out = mid
    true
}

fn sym_eq(
    sym_data: &[i8; 2048],
    sym_lens: &[i32; 8],
    idx: i64,
    name: &Str
) -> bool with Mut, Panic {
    if sym_lens[idx as usize] != name.len { return false }
    var i: i64 = 0
    while i < name.len {
        let off = idx * 256 + i
        if sym_data[off as usize] != name.data[i as usize] {
            return false
        }
        i = i + 1
    }
    true
}

fn sym_store(
    sym_data: &![i8; 2048],
    sym_lens: &![i32; 8],
    idx: i64,
    name: &Str
) with Mut, Panic {
    sym_lens[idx as usize] = name.len
    var i: i64 = 0
    while i < name.len {
        let off = idx * 256 + i
        sym_data[off as usize] = name.data[i as usize]
        i = i + 1
    }
}

fn sym_slot(
    sym_data: &![i8; 2048],
    sym_lens: &![i32; 8],
    sym_count: i64,
    name: &Str
) -> SymLookup with Mut, Div, Panic {
    var i: i64 = 0
    while i < sym_count {
        if sym_eq(sym_data, sym_lens, i, name) {
            return SymLookup { ok: true, slot: i, next_count: sym_count }
        }
        i = i + 1
    }
    if sym_count >= 8 {
        return SymLookup { ok: false, slot: 0, next_count: sym_count }
    }
    sym_store(sym_data, sym_lens, sym_count, name)
    SymLookup { ok: true, slot: sym_count, next_count: sym_count + 1 }
}

fn parse_two_regs(body: &Str) -> TwoRegs with Mut, Div, Panic {
    let comma_tok = str_lit(",")
    let comma = str_index_of(body, &comma_tok)
    if comma < 0 { return TwoRegs { ok: false, a: 0, b: 0 } }
    let left_raw = str_sub(body, 0, comma)
    let right_raw = str_sub(body, comma + (1 as i32), body.len)
    let left = str_trim(&left_raw)
    let right = str_trim(&right_raw)
    var ok_l = false
    var ok_r = false
    let ra = parse_reg(&left, &!ok_l)
    let rb = parse_reg(&right, &!ok_r)
    if !ok_l || !ok_r { return TwoRegs { ok: false, a: 0, b: 0 } }
    TwoRegs { ok: true, a: ra, b: rb }
}

fn add_instr(
    b: &!EisaxBuild,
    op: i64,
    dst: i64,
    a: i64,
    bb: i64
) -> bool with Mut, Panic {
    if b.n_code >= 32 { return false }
    b.ops[b.n_code as usize] = op
    b.dsts[b.n_code as usize] = dst
    b.as_[b.n_code as usize] = a
    b.bs_[b.n_code as usize] = bb
    b.n_code = b.n_code + 1
    true
}

fn const_find_or_add(b: &!EisaxBuild, v: f64) -> i64 with Mut, Div, Panic {
    let vp = f64_parts(v)
    var i = 0
    while i < b.n_const {
        let p = f64_parts(b.consts[i as usize])
        if p.sign == vp.sign && p.exp == vp.exp && p.mant == vp.mant {
            return i
        }
        i = i + 1
    }
    if b.n_const >= 16 { return 0 - 1 }
    b.consts[b.n_const as usize] = v
    b.n_const = b.n_const + 1
    b.n_const - 1
}

fn parse_assignment_rhs(
    rhs: &Str,
    dst: i64,
    b: &!EisaxBuild,
    sym_data: &![i8; 2048],
    sym_lens: &![i32; 8],
    sym_count: &!i64
) -> bool with Mut, Div, Panic {
    let kw_econst = str_lit("econst")
    let kw_eload = str_lit("eload")
    let kw_eadd = str_lit("eadd")
    let kw_esub = str_lit("esub")
    let kw_emul = str_lit("emul")
    let kw_ediv = str_lit("ediv")
    let kw_esqrt = str_lit("esqrt")

    if str_starts_with(rhs, &kw_econst) {
        let arg_raw = str_sub(rhs, 6, rhs.len)
        let arg = str_trim(&arg_raw)
        if arg.len <= 0 { return false }
        var idx = 0
        if arg.data[0] == 35 as i8 {
            let raw0 = str_sub(&arg, 1, arg.len)
            let raw = str_trim(&raw0)
            var ok = false
            idx = parse_i64_token(&raw, &!ok)
            if !ok || idx < 0 || idx >= 16 { return false }
            if idx + 1 > b.n_const { b.n_const = idx + 1 }
        } else {
            if !valid_float_token(&arg) { return false }
            let v = str_to_f64(&arg)
            if !is_finite_f64(v) { return false }
            idx = const_find_or_add(b, v)
            if idx < 0 { return false }
        }
        return add_instr(b, op_econst(), dst, idx, 0)
    }

    if str_starts_with(rhs, &kw_eload) {
        let arg_raw = str_sub(rhs, 5, rhs.len)
        let arg = str_trim(&arg_raw)
        var sym = str_new()
        if !parse_bracket_symbol(&arg, &!sym) { return false }
        let sres = sym_slot(sym_data, sym_lens, *sym_count, &sym)
        if !sres.ok { return false }
        *sym_count = sres.next_count
        let slot = sres.slot
        return add_instr(b, op_eload(), dst, slot, 0)
    }

    if str_starts_with(rhs, &kw_eadd) {
        let body_raw = str_sub(rhs, 4, rhs.len)
        let body = str_trim(&body_raw)
        let regs = parse_two_regs(&body)
        if !regs.ok { return false }
        return add_instr(b, op_eadd(), dst, regs.a, regs.b)
    }
    if str_starts_with(rhs, &kw_esub) {
        let body_raw = str_sub(rhs, 4, rhs.len)
        let body = str_trim(&body_raw)
        let regs = parse_two_regs(&body)
        if !regs.ok { return false }
        return add_instr(b, op_esub(), dst, regs.a, regs.b)
    }
    if str_starts_with(rhs, &kw_emul) {
        let body_raw = str_sub(rhs, 4, rhs.len)
        let body = str_trim(&body_raw)
        let regs = parse_two_regs(&body)
        if !regs.ok { return false }
        return add_instr(b, op_emul(), dst, regs.a, regs.b)
    }
    if str_starts_with(rhs, &kw_ediv) {
        let body_raw = str_sub(rhs, 4, rhs.len)
        let body = str_trim(&body_raw)
        let regs = parse_two_regs(&body)
        if !regs.ok { return false }
        return add_instr(b, op_ediv(), dst, regs.a, regs.b)
    }
    if str_starts_with(rhs, &kw_esqrt) {
        let body_raw = str_sub(rhs, 5, rhs.len)
        let body = str_trim(&body_raw)
        var ok = false
        let a = parse_reg(&body, &!ok)
        if !ok { return false }
        return add_instr(b, op_esqrt(), dst, a, 0)
    }

    false
}

fn parse_line_instr(
    line: &Str,
    b: &!EisaxBuild,
    sym_data: &![i8; 2048],
    sym_lens: &![i32; 8],
    sym_count: &!i64
) -> bool with Mut, Div, Panic {
    let kw_egate = str_lit("egate")
    let kw_estore = str_lit("estore")
    let arrow = str_lit("<-")

    if str_starts_with(line, &kw_egate) {
        let arg_raw = str_sub(line, 5, line.len)
        let arg = str_trim(&arg_raw)
        var ok = false
        let r = parse_reg(&arg, &!ok)
        if !ok { return false }
        return add_instr(b, op_egate(), r, 0, 0)
    }

    if str_starts_with(line, &kw_estore) {
        let p = str_index_of(line, &arrow)
        if p < 0 { return false }
        let left_raw = str_sub(line, 6, p)
        let right_raw = str_sub(line, p + 2, line.len)
        let left = str_trim(&left_raw)
        let right = str_trim(&right_raw)
        var sym = str_new()
        if !parse_bracket_symbol(&left, &!sym) { return false }
        let sres = sym_slot(sym_data, sym_lens, *sym_count, &sym)
        if !sres.ok { return false }
        *sym_count = sres.next_count
        let slot = sres.slot
        var ok_r = false
        let r = parse_reg(&right, &!ok_r)
        if !ok_r { return false }
        return add_instr(b, op_estore(), r, slot, 0)
    }

    let p = str_index_of(line, &arrow)
    if p < 0 { return false }
    let lhs_raw = str_sub(line, 0, p)
    let rhs_raw = str_sub(line, p + 2, line.len)
    let lhs = str_trim(&lhs_raw)
    let rhs = str_trim(&rhs_raw)
    var ok_lhs = false
    let dst = parse_reg(&lhs, &!ok_lhs)
    if !ok_lhs { return false }
    parse_assignment_rhs(&rhs, dst, b, sym_data, sym_lens, sym_count)
}

fn is_ident(tok: &Str) -> bool with Mut, Panic {
    if tok.len <= 0 { return false }
    if !is_alpha(tok.data[0]) { return false }
    var i = 1
    while i < tok.len {
        if !is_ident_char(tok.data[i as usize]) { return false }
        i = i + 1
    }
    true
}

fn strip_optional_label(line: &Str, ok: &!bool) -> Str with Mut, Div, Panic {
    var i = 0
    while i < line.len {
        if line.data[i as usize] == 58 as i8 {
            let left_raw = str_sub(line, 0, i)
            let left = str_trim(&left_raw)
            if !is_ident(&left) {
                *ok = false
                return str_new()
            }
            *ok = true
            let right_raw = str_sub(line, i + 1, line.len)
            return str_trim(&right_raw)
        }
        i = i + 1
    }
    *ok = true
    str_copy(line)
}

fn reg_to_str(n: i64) -> Str with Mut, Div, Panic {
    let e = str_lit("e")
    let n_s = str_from_i64(n)
    str_cat(&e, &n_s)
}

fn slot_to_str(n: i64) -> Str with Mut, Div, Panic {
    let p0 = str_lit("[ m")
    let n_s = str_from_i64(n)
    let a = str_cat(&p0, &n_s)
    let p1 = str_lit(" ]")
    str_cat(&a, &p1)
}

fn line_arith(dst: i64, opn: string, a: i64, b: i64) -> Str with Mut, Div, Panic {
    let d = reg_to_str(dst)
    let s0 = str_lit(" <- ")
    let p0 = str_cat(&d, &s0)
    let op = str_lit(opn)
    let p1 = str_cat(&p0, &op)
    let s1 = str_lit(" ")
    let p2 = str_cat(&p1, &s1)
    let ra = reg_to_str(a)
    let p3 = str_cat(&p2, &ra)
    let s2 = str_lit(" , ")
    let p4 = str_cat(&p3, &s2)
    let rb = reg_to_str(b)
    str_cat(&p4, &rb)
}

fn is_header_v0(line: &Str) -> bool with Panic {
    if line.len != 8 { return false }
    if line.data[0] != 46 as i8 { return false }
    if line.data[1] != 101 as i8 { return false }
    if line.data[2] != 105 as i8 { return false }
    if line.data[3] != 115 as i8 { return false }
    if line.data[4] != 97 as i8 { return false }
    if line.data[5] != 32 as i8 { return false }
    if line.data[6] != 118 as i8 { return false }
    if line.data[7] != 48 as i8 { return false }
    true
}

pub fn eisa_assemble(src: Str) -> AsmResult with Mut, Div, Panic {
    var b = eisax_build_new()
    b.prov_source = 0
    b.prov_flags = 0

    var sym_data: [i8; 2048] = [0; 2048]
    var sym_lens: [i32; 8] = [0; 8]
    var sym_count: i64 = 0

    var header_seen = false
    var line_no = 1
    var pos = 0
    while pos <= src.len {
        var next = pos
        while next < src.len && src.data[next as usize] != 10 as i8 {
            next = next + 1
        }

        var line = str_sub(&src, pos, next)
        line = strip_comment(&line)
        line = str_trim(&line)

        if line.len > 0 {
            if !header_seen {
                if !is_header_v0(&line) {
                    return asm_fail(line_no as i64)
                }
                header_seen = true
            } else {
                var lbl_ok = false
                line = strip_optional_label(&line, &!lbl_ok)
                if !lbl_ok { return asm_fail(line_no as i64) }
                if line.len > 0 {
                    if !parse_line_instr(&line, &!b, &!sym_data, &!sym_lens, &!sym_count) {
                        return asm_fail(line_no as i64)
                    }
                }
            }
        }

        if next == src.len {
            pos = src.len + 1
        } else {
            pos = next + 1
        }
        line_no = line_no + 1
    }

    if !header_seen { return asm_fail(1) }
    AsmResult { build: b, status: 0 }
}

pub fn eisa_disassemble_line(img: EisaxImage, i: i64) -> Str with Mut, Div, Panic {
    let op = eisax_code_op(img, i)
    let dst = eisax_code_dst(img, i)
    let a = eisax_code_a(img, i)
    let b = eisax_code_b(img, i)

    if op == op_econst() {
        let d = reg_to_str(dst)
        let s = str_lit(" <- econst #")
        let p0 = str_cat(&d, &s)
        let aa = str_from_i64(a)
        return str_cat(&p0, &aa)
    }
    if op == op_eload() {
        let d = reg_to_str(dst)
        let s = str_lit(" <- eload ")
        let p0 = str_cat(&d, &s)
        let sl = slot_to_str(a)
        return str_cat(&p0, &sl)
    }
    if op == op_eadd() { return line_arith(dst, "eadd", a, b) }
    if op == op_esub() { return line_arith(dst, "esub", a, b) }
    if op == op_emul() { return line_arith(dst, "emul", a, b) }
    if op == op_ediv() { return line_arith(dst, "ediv", a, b) }
    if op == op_esqrt() {
        let d = reg_to_str(dst)
        let s = str_lit(" <- esqrt ")
        let p0 = str_cat(&d, &s)
        let ra = reg_to_str(a)
        return str_cat(&p0, &ra)
    }
    if op == op_egate() {
        let p0 = str_lit("egate ")
        let d = reg_to_str(dst)
        return str_cat(&p0, &d)
    }
    if op == op_estore() {
        let s0 = str_lit("estore ")
        let sl = slot_to_str(a)
        let p0 = str_cat(&s0, &sl)
        let s1 = str_lit(" <- ")
        let p1 = str_cat(&p0, &s1)
        let d = reg_to_str(dst)
        return str_cat(&p1, &d)
    }
    str_lit("unknown")
}
