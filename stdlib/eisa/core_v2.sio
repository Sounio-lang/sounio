// stdlib/eisa/core_v2.sio — EISA v2 runtime reference semantics (qd128 err lane)
//
// v2 closure contract (docs/research/eisa-v2-arch-2026-07-05.md §1):
//
//   true(z) := qd(z.val) + z.err                    (a Qd128 quantity)
//   v2 contract:  true(z) = round_qd( true(x) op true(y) )
//
// Per arithmetic op:
//   val_z = fl64(x.val op y.val)          # unchanged: what plain hardware does
//   t     = qd_op( qd(x.val) + x.err ,  qd(y.val) + y.err )
//   err_z = qd_sub(t, qd_from_f64(val_z))
//
// The val lane stays the bit-exact IEEE-754 double result; the err lane is a
// correction trail computed in quad-double (~212 bits). eadd2/esub2/emul2 are
// exact to qd precision; ediv2/esqrt2 are correctly rounded to qd by the HLB
// algorithms' guarantees. Unlike v0/v1 (dd64, formulaic), no cross terms are
// dropped: emul2 keeps x.err*y.err inside qd_mul.
//
// The u lane is UNCHANGED from v0: first-order GUM propagation (JCGM
// 100:2008), formulas copied verbatim from eisa::core — depth of the roundoff
// trail is orthogonal to input uncertainty propagation.
//
// Priest-renorm caveat inherited verbatim from stdlib/math/qd128.sio:
// necessary conditions for Priest renormalisation (HLB Algorithm 9) to always
// succeed are not known; Priest proves sufficiency for <=51 overlap bits,
// which the HLB operators maintain. This module relies on the same assumption
// as the qd literature for expansions generated by those operators; the
// failure mode is made observable at the conformance-harness level (W4+), not
// silently assumed away here.
//
// Storage note: one f64 val + four f64 err components + one f64 u. The v0
// reference (eisa::core, EReg with Dd64 err) is FROZEN as the v0 oracle;
// this module is the v2 oracle. Helpers are prefixed core_v2_ to avoid
// bundle-level name collisions.
module eisa::core_v2

use math::qd128::*

pub struct EReg2 {
    pub val: f64,
    pub err: Qd128,
    pub u: f64,
}

fn core_v2_sqrt_f64(x: f64) -> f64 with Mut, Div {
    if x <= 0.0 { return 0.0 }
    var g = x
    if g > 1.0 { g = x * 0.5 } else { g = 1.0 }
    var i = 0
    while i < 40 {
        g = 0.5 * (g + x / g)
        i = i + 1
    }
    g
}

fn core_v2_abs_f64(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

pub fn ereg2_exact(v: f64) -> EReg2 {
    EReg2 { val: v, err: qd_zero(), u: 0.0 }
}

pub fn ereg2_measured(v: f64, sigma: f64) -> EReg2 {
    EReg2 { val: v, err: qd_zero(), u: sigma }
}

pub fn ereg2_true(x: EReg2) -> Qd128 with Mut, Panic {
    qd_add(qd_from_f64(x.val), x.err)
}

// Minimal zero-event flags derived from the existing lanes. These do not
// change val/err/u storage and do not infer a physical cause.
pub fn eisa_zero_flag_observed() -> i64 { 1 }
pub fn eisa_zero_flag_correction_nonzero() -> i64 { 2 }

pub fn core_v2_zero_flags_raw(
    val: f64,
    err0: f64,
    err1: f64,
    err2: f64,
    err3: f64
) -> i64 {
    var flags = 0
    if val == 0.0 {
        flags = flags + eisa_zero_flag_observed()
    }
    if err0 != 0.0 || err1 != 0.0 || err2 != 0.0 || err3 != 0.0 {
        flags = flags + eisa_zero_flag_correction_nonzero()
    }
    flags
}

pub fn ereg2_zero_flags(x: EReg2) -> i64 {
    core_v2_zero_flags_raw(x.val, x.err.x0, x.err.x1, x.err.x2, x.err.x3)
}

pub fn eadd2(x: EReg2, y: EReg2) -> EReg2 with Mut, Div, Panic {
    let v = x.val + y.val
    let t = qd_add(ereg2_true(x), ereg2_true(y))
    let ux = x.u * x.u
    let uy = y.u * y.u
    EReg2 {
        val: v,
        err: qd_sub(t, qd_from_f64(v)),
        u: core_v2_sqrt_f64(ux + uy),
    }
}

pub fn esub2(x: EReg2, y: EReg2) -> EReg2 with Mut, Div, Panic {
    let v = x.val - y.val
    let t = qd_sub(ereg2_true(x), ereg2_true(y))
    let ux = x.u * x.u
    let uy = y.u * y.u
    EReg2 {
        val: v,
        err: qd_sub(t, qd_from_f64(v)),
        u: core_v2_sqrt_f64(ux + uy),
    }
}

pub fn emul2(x: EReg2, y: EReg2) -> EReg2 with Mut, Div, Panic {
    let v = x.val * y.val
    let t = qd_mul(ereg2_true(x), ereg2_true(y))
    let t1 = y.val * x.u
    let t2 = x.val * y.u
    EReg2 {
        val: v,
        err: qd_sub(t, qd_from_f64(v)),
        u: core_v2_sqrt_f64(t1 * t1 + t2 * t2),
    }
}

pub fn ediv2(x: EReg2, y: EReg2) -> EReg2 with Mut, Div, Panic {
    let q = x.val / y.val
    let t = qd_div(ereg2_true(x), ereg2_true(y))
    let ay = core_v2_abs_f64(y.val)
    let inner = x.u * x.u + (q * y.u) * (q * y.u)
    EReg2 {
        val: q,
        err: qd_sub(t, qd_from_f64(q)),
        u: (1.0 / ay) * core_v2_sqrt_f64(inner),
    }
}

pub fn esqrt2(x: EReg2) -> EReg2 with Mut, Div, Panic {
    if x.val <= 0.0 { return ereg2_exact(0.0) }
    let z = core_v2_sqrt_f64(x.val)
    let t = qd_sqrt(ereg2_true(x))
    EReg2 {
        val: z,
        err: qd_sub(t, qd_from_f64(z)),
        u: x.u / (2.0 * z),
    }
}

// Same 10x/100x gate policy as v0/v1, with roundoff := |err| collapsed to
// f64 = |err.x0| (arch doc §1: x1..x3 contribute < 1 ulp of the leading term).
pub fn egate2(x: EReg2, k: i64) -> i64 with Mut, Div {
    let roundoff = core_v2_abs_f64(x.err.x0)
    let budget = x.u
    if budget <= 0.0 {
        if roundoff == 0.0 { return 0 } else { return 2 }
    }
    if roundoff * 10.0 >= budget { return 2 }
    if roundoff * 100.0 >= budget { return 1 }
    let _keep_k = k
    0
}
