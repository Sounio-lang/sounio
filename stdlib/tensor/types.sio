// stdlib::tensor::types - Dynamic f64 tensor metadata and indexing.
//
// V1 tensors are rank <= 8, contiguous row-major, f64-only, and manually freed.

pub struct TensorShape {
    rank: usize,
    dims: [usize; 8],
    strides: [usize; 8],
    len: usize,
}

pub struct Tensor {
    data: *mut f64,
    shape: TensorShape,
    storage_owner: bool,
}

pub fn shape_empty_dims() -> [usize; 8] {
    [0 as usize; 8]
}

pub fn shape_scalar() -> TensorShape with Mut, Panic, Div {
    shape_from_dims([0 as usize; 8], 0 as usize)
}

pub fn shape1(d0: usize) -> TensorShape with Mut, Panic, Div {
    var dims = [0 as usize; 8]
    dims[0] = d0
    shape_from_dims(dims, 1 as usize)
}

pub fn shape2(d0: usize, d1: usize) -> TensorShape with Mut, Panic, Div {
    var dims = [0 as usize; 8]
    dims[0] = d0
    dims[1] = d1
    shape_from_dims(dims, 2 as usize)
}

pub fn shape3(d0: usize, d1: usize, d2: usize) -> TensorShape with Mut, Panic, Div {
    var dims = [0 as usize; 8]
    dims[0] = d0
    dims[1] = d1
    dims[2] = d2
    shape_from_dims(dims, 3 as usize)
}

pub fn shape4(d0: usize, d1: usize, d2: usize, d3: usize) -> TensorShape with Mut, Panic, Div {
    var dims = [0 as usize; 8]
    dims[0] = d0
    dims[1] = d1
    dims[2] = d2
    dims[3] = d3
    shape_from_dims(dims, 4 as usize)
}

pub fn shape_from_dims(dims: [usize; 8], rank: usize) -> TensorShape with Mut, Panic, Div {
    if rank > 8 as usize { assert(false) }
    var out_dims = [0 as usize; 8]
    var i: usize = 0 as usize
    while i < rank {
        out_dims[i] = dims[i]
        i = i + 1 as usize
    }
    let base = TensorShape {
        rank: rank,
        dims: out_dims,
        strides: [0 as usize; 8],
        len: 0 as usize,
    }
    let strides = shape_strides(base)
    TensorShape {
        rank: rank,
        dims: out_dims,
        strides: strides,
        len: shape_numel(base),
    }
}

pub fn shape_numel(shape: TensorShape) -> usize with Mut, Panic, Div {
    if shape.rank == 0 as usize { return 1 as usize }
    var total: usize = 1 as usize
    var i: usize = 0 as usize
    while i < shape.rank {
        total = total * shape.dims[i]
        i = i + 1 as usize
    }
    total
}

pub fn shape_strides(shape: TensorShape) -> [usize; 8] with Mut, Panic, Div {
    var strides = [0 as usize; 8]
    if shape.rank == 0 as usize { return strides }
    var i = shape.rank
    var stride: usize = 1 as usize
    while i > 0 as usize {
        i = i - 1 as usize
        strides[i] = stride
        stride = stride * shape.dims[i]
    }
    strides
}

pub fn shape_eq(a: TensorShape, b: TensorShape) -> bool with Mut, Panic, Div {
    if a.rank != b.rank { return false }
    var i: usize = 0 as usize
    while i < a.rank {
        if a.dims[i] != b.dims[i] { return false }
        i = i + 1 as usize
    }
    true
}

pub fn tensor_index(shape: TensorShape, indices: [usize; 8]) -> usize with Mut, Panic, Div {
    var offset: usize = 0 as usize
    var i: usize = 0 as usize
    while i < shape.rank {
        if indices[i] >= shape.dims[i] { assert(false) }
        offset = offset + indices[i] * shape.strides[i]
        i = i + 1 as usize
    }
    offset
}

pub fn tensor_rank(t: &Tensor) -> usize {
    t.shape.rank
}

pub fn tensor_len(t: &Tensor) -> usize {
    t.shape.len
}

pub fn tensor_dim(t: &Tensor, axis: usize) -> usize with Panic {
    t.shape.dims[axis]
}

pub fn tensor_get(t: &Tensor, offset: usize) -> f64 with Panic {
    read_f64(t.data, offset as i64)
}

pub fn tensor_set(t: &!Tensor, offset: usize, value: f64) with Mut, Panic {
    write_f64(t.data, offset as i64, value)
}
