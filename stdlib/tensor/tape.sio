// stdlib::tensor::tape - Closure-free reverse-mode autograd for D.1 tensors.
//
// Storage intentionally uses primitive parallel arrays. The current compiler
// accepts array-of-struct fields but can miscompile their initialization.

use tensor::types::{
    Tensor, TensorShape,
    shape_from_dims, shape_eq,
    tensor_get, tensor_set,
}
use tensor::ops::{
    tensor_free, tensor_clone, tensor_full, tensor_ones,
    tensor_add, tensor_sub, tensor_mul, tensor_div,
    tensor_matmul, tensor_sum, tensor_mean, sum_to_shape,
    tensor_reshape, tensor_transpose, tensor_permute,
    tensor_tanh, tensor_sigmoid, tensor_relu, tensor_gelu,
    tensor_scalar,
}
use special::caputo::{
    caputo_l1_derivative,
    caputo_l1_scale,
    caputo_l1_weight,
}

pub fn TAPE_ADD() -> i32 { 1 }
pub fn TAPE_SUB() -> i32 { 2 }
pub fn TAPE_MUL() -> i32 { 3 }
pub fn TAPE_DIV() -> i32 { 4 }
pub fn TAPE_MATMUL() -> i32 { 5 }
pub fn TAPE_SUM() -> i32 { 6 }
pub fn TAPE_MEAN() -> i32 { 7 }
pub fn TAPE_TANH() -> i32 { 8 }
pub fn TAPE_SIGMOID() -> i32 { 9 }
pub fn TAPE_RELU() -> i32 { 10 }
pub fn TAPE_GELU() -> i32 { 11 }
pub fn TAPE_RESHAPE() -> i32 { 12 }
pub fn TAPE_TRANSPOSE() -> i32 { 13 }
pub fn TAPE_PERMUTE() -> i32 { 14 }
pub fn TAPE_CAPUTO_L1() -> i32 { 15 }
pub fn TAPE_INDEX() -> i32 { 16 }

fn tape_value_capacity() -> usize { 128 as usize }
fn tape_node_capacity() -> usize { 128 as usize }

pub struct TapeNode {
    op: i32,
    out: i32,
    a: i32,
    b: i32,
    aux0: i32,
    aux1: i32,
    in_shape_a: TensorShape,
    in_shape_b: TensorShape,
    out_shape: TensorShape,
    axis: usize,
    has_axis: bool,
    keepdims: bool,
    scalar: f64,
    alpha: f64,
    permutation: [usize; 8],
    rank: usize,
}

pub struct TensorTape {
    node_op: [i32; 128],
    node_out: [i32; 128],
    node_a: [i32; 128],
    node_b: [i32; 128],
    node_axis: [usize; 128],
    node_has_axis: [bool; 128],
    node_keepdims: [bool; 128],
    node_scalar: [f64; 128],
    node_alpha: [f64; 128],
    node_perm: [usize; 1024],
    node_rank: [usize; 128],
    node_len: usize,

    value_data: [*mut f64; 128],
    value_rank: [usize; 128],
    value_dims: [usize; 1024],
    value_len_elems: [usize; 128],
    value_len: usize,

    grad_data: [*mut f64; 128],
    grad_rank: [usize; 128],
    grad_dims: [usize; 1024],
    grad_len_elems: [usize; 128],
    grad_present: [bool; 128],
    requires_grad: [bool; 128],
    owns_value: [bool; 128],
}

fn tape_inferred_rank(tape: &TensorTape, id: i32, stored_rank: usize) -> usize with Mut, Panic, Div {
    let slot = id as usize
    if tape.value_dims[slot * 8 as usize] == 0 as usize { return 0 as usize }
    var i: usize = 0 as usize
    while i < 8 as usize {
        let dim = tape.value_dims[slot * 8 as usize + i]
        if dim == 0 as usize {
            return i
        }
        i = i + 1 as usize
    }
    8 as usize
}

fn tape_inferred_len(tape: &TensorTape, id: i32) -> usize with Mut, Panic, Div {
    let slot = id as usize
    let rank = tape_inferred_rank(tape, id, tape.value_rank[slot])
    if rank == 0 as usize { return 1 as usize }
    var product: usize = 1 as usize
    var i: usize = 0 as usize
    while i < rank {
        let dim = tape.value_dims[slot * 8 as usize + i]
        if dim == 0 as usize { return tape.value_len_elems[slot] }
        product = product * dim
        i = i + 1 as usize
    }
    if product > tape.value_len_elems[slot] { return product }
    tape.value_len_elems[slot]
}

fn tape_value_shape(tape: &TensorTape, id: i32) -> TensorShape with Mut, Panic, Div {
    let slot = id as usize
    let rank = tape_inferred_rank(tape, id, tape.value_rank[slot])
    var dims = [0 as usize; 8]
    var i: usize = 0 as usize
    while i < rank {
        dims[i] = tape.value_dims[slot * 8 as usize + i]
        i = i + 1 as usize
    }
    shape_from_dims(dims, rank)
}

fn tape_tensor_view(tape: &TensorTape, id: i32, owner: bool) -> Tensor with Mut, Panic, Div {
    Tensor {
        data: tape.value_data[id as usize],
        shape: tape_value_shape(tape, id),
        storage_owner: owner,
    }
}

fn tape_grad_view(tape: &TensorTape, id: i32, owner: bool) -> Tensor with Mut, Panic, Div {
    Tensor {
        data: tape.grad_data[id as usize],
        shape: tape_value_shape(tape, id),
        storage_owner: owner,
    }
}

fn tape_store_shape(tape: &!TensorTape, id: usize, shape: TensorShape) with Mut {
    tape.value_rank[id] = shape.rank
    tape.value_len_elems[id] = shape.len
    var i: usize = 0 as usize
    while i < 8 as usize {
        if i < shape.rank {
            tape.value_dims[id * 8 as usize + i] = shape.dims[i]
        } else {
            tape.value_dims[id * 8 as usize + i] = 0 as usize
        }
        i = i + 1 as usize
    }
}

fn tape_store_grad_shape(tape: &!TensorTape, id: usize, shape: TensorShape) with Mut {
    tape.grad_rank[id] = shape.rank
    tape.grad_len_elems[id] = shape.len
    var i: usize = 0 as usize
    while i < 8 as usize {
        if i < shape.rank {
            tape.grad_dims[id * 8 as usize + i] = shape.dims[i]
        } else {
            tape.grad_dims[id * 8 as usize + i] = 0 as usize
        }
        i = i + 1 as usize
    }
}

fn tape_clear_grad_shape(tape: &!TensorTape, id: usize) with Mut {
    tape.grad_rank[id] = 0 as usize
    tape.grad_len_elems[id] = 0 as usize
    var i: usize = 0 as usize
    while i < 8 as usize {
        tape.grad_dims[id * 8 as usize + i] = 0 as usize
        i = i + 1 as usize
    }
}

fn tape_grad_shape(tape: &TensorTape, id: i32) -> TensorShape with Mut, Panic, Div {
    let slot = id as usize
    let rank = tape.grad_rank[slot]
    var dims = [0 as usize; 8]
    var i: usize = 0 as usize
    while i < rank {
        dims[i] = tape.grad_dims[slot * 8 as usize + i]
        i = i + 1 as usize
    }
    shape_from_dims(dims, rank)
}

fn tape_node_at(tape: &TensorTape, idx: usize) -> TapeNode with Mut, Panic, Div {
    var perm = [0 as usize; 8]
    var i: usize = 0 as usize
    while i < 8 as usize {
        perm[i] = tape.node_perm[idx * 8 as usize + i]
        i = i + 1 as usize
    }
    TapeNode {
        op: tape.node_op[idx],
        out: tape.node_out[idx],
        a: tape.node_a[idx],
        b: tape.node_b[idx],
        aux0: 0,
        aux1: 0,
        in_shape_a: tape_value_shape(tape, tape.node_a[idx]),
        in_shape_b: if tape.node_b[idx] >= 0 { tape_value_shape(tape, tape.node_b[idx]) } else { shape_from_dims([0 as usize; 8], 0 as usize) },
        out_shape: tape_value_shape(tape, tape.node_out[idx]),
        axis: tape.node_axis[idx],
        has_axis: tape.node_has_axis[idx],
        keepdims: tape.node_keepdims[idx],
        scalar: tape.node_scalar[idx],
        alpha: tape.node_alpha[idx],
        permutation: perm,
        rank: tape.node_rank[idx],
    }
}

pub fn tape_begin() -> TensorTape {
    TensorTape {
        node_op: [0; 128],
        node_out: [-1; 128],
        node_a: [-1; 128],
        node_b: [-1; 128],
        node_axis: [0 as usize; 128],
        node_has_axis: [false; 128],
        node_keepdims: [false; 128],
        node_scalar: [0.0; 128],
        node_alpha: [0.0; 128],
        node_perm: [0 as usize; 1024],
        node_rank: [0 as usize; 128],
        node_len: 0 as usize,
        value_data: [0 as *mut f64; 128],
        value_rank: [0 as usize; 128],
        value_dims: [0 as usize; 1024],
        value_len_elems: [0 as usize; 128],
        value_len: 0 as usize,
        grad_data: [0 as *mut f64; 128],
        grad_rank: [0 as usize; 128],
        grad_dims: [0 as usize; 1024],
        grad_len_elems: [0 as usize; 128],
        grad_present: [false; 128],
        requires_grad: [false; 128],
        owns_value: [false; 128],
    }
}

pub fn tape_reset(tape: &!TensorTape) with Alloc, Mut, Panic, Div {
    var i: usize = 0 as usize
    while i < tape.value_len {
        if tape.owns_value[i] {
            var v = tape_tensor_view(tape, i as i32, true)
            tensor_free(&!v)
        }
        if tape.grad_data[i] != 0 as *mut f64 {
            var g = tape_grad_view(tape, i as i32, true)
            tensor_free(&!g)
        }
        tape.value_data[i] = 0 as *mut f64
        tape.grad_data[i] = 0 as *mut f64
        tape_clear_grad_shape(tape, i)
        tape.owns_value[i] = false
        tape.requires_grad[i] = false
        i = i + 1 as usize
    }
    tape.node_len = 0 as usize
    tape.value_len = 0 as usize
}

pub fn tape_drop(tape: &!TensorTape) with Alloc, Mut, Panic, Div {
    tape_reset(tape)
}

fn tape_push_value_raw(tape: &!TensorTape, data: *mut f64, shape: TensorShape, requires_grad: bool) -> i32 with Alloc, Mut, Panic, Div {
    if tape.value_len >= tape_value_capacity() { assert(false) }
    let idx = tape.value_len
    tape.value_data[idx] = data
    tape_store_shape(tape, idx, shape)
    tape.requires_grad[idx] = requires_grad
    tape.owns_value[idx] = true
    let grad = tensor_full(shape, 0.0)
    tape.grad_data[idx] = grad.data
    tape_store_grad_shape(tape, idx, shape)
    tape.value_len = tape.value_len + 1 as usize
    idx as i32
}

pub fn tape_leaf(tape: &!TensorTape, value: &Tensor, requires_grad: bool) -> i32 with Alloc, Mut, Panic, Div {
    let saved = tensor_clone(value)
    tape_push_value_raw(tape, saved.data, saved.shape, requires_grad)
}

fn tape_push_node(tape: &!TensorTape, op: i32, out: i32, a: i32, b: i32, axis: usize, has_axis: bool, keepdims: bool, scalar: f64, perm: [usize; 8], rank: usize) with Mut, Panic {
    tape_push_node_alpha(tape, op, out, a, b, axis, has_axis, keepdims, scalar, 0.0, perm, rank)
}

fn tape_push_node_alpha(tape: &!TensorTape, op: i32, out: i32, a: i32, b: i32, axis: usize, has_axis: bool, keepdims: bool, scalar: f64, alpha: f64, perm: [usize; 8], rank: usize) with Mut, Panic {
    if tape.node_len >= tape_node_capacity() { assert(false) }
    let idx = tape.node_len
    tape.node_op[idx] = op
    tape.node_out[idx] = out
    tape.node_a[idx] = a
    tape.node_b[idx] = b
    tape.node_axis[idx] = axis
    tape.node_has_axis[idx] = has_axis
    tape.node_keepdims[idx] = keepdims
    tape.node_scalar[idx] = scalar
    tape.node_alpha[idx] = alpha
    tape.node_rank[idx] = rank
    var i: usize = 0 as usize
    while i < 8 as usize {
        tape.node_perm[idx * 8 as usize + i] = perm[i]
        i = i + 1 as usize
    }
    tape.node_len = tape.node_len + 1 as usize
}

fn tape_binary_out(tape: &!TensorTape, a: i32, b: i32, value: Tensor, op: i32, req: bool) -> i32 with Alloc, Mut, Panic, Div {
    let out_dims = value.shape.dims
    let out_rank = value.shape.rank
    let out = tape_push_value_raw(tape, value.data, value.shape, req)
    if req {
        tape_push_node(tape, op, out, a, b, 0 as usize, false, false, 0.0, out_dims, out_rank)
    }
    out
}

fn tape_unary_out(tape: &!TensorTape, a: i32, value: Tensor, op: i32, req: bool) -> i32 with Alloc, Mut, Panic, Div {
    let out_dims = value.shape.dims
    let out_rank = value.shape.rank
    let out = tape_push_value_raw(tape, value.data, value.shape, req)
    if req {
        tape_push_node(tape, op, out, a, -1, 0 as usize, false, false, 0.0, out_dims, out_rank)
    }
    out
}

pub fn tape_tensor_add(tape: &!TensorTape, a: i32, b: i32) -> i32 with Alloc, Mut, Panic, Div {
    var av = tape_tensor_view(tape, a, false)
    var bv = tape_tensor_view(tape, b, false)
    let out = tensor_add(&av, &bv)
    let req = tape.requires_grad[a as usize] || tape.requires_grad[b as usize]
    tape_binary_out(tape, a, b, out, TAPE_ADD(), req)
}

pub fn tape_tensor_sub(tape: &!TensorTape, a: i32, b: i32) -> i32 with Alloc, Mut, Panic, Div {
    var av = tape_tensor_view(tape, a, false)
    var bv = tape_tensor_view(tape, b, false)
    let out = tensor_sub(&av, &bv)
    let req = tape.requires_grad[a as usize] || tape.requires_grad[b as usize]
    tape_binary_out(tape, a, b, out, TAPE_SUB(), req)
}

pub fn tape_tensor_mul(tape: &!TensorTape, a: i32, b: i32) -> i32 with Alloc, Mut, Panic, Div {
    var av = tape_tensor_view(tape, a, false)
    var bv = tape_tensor_view(tape, b, false)
    let out = tensor_mul(&av, &bv)
    let req = tape.requires_grad[a as usize] || tape.requires_grad[b as usize]
    tape_binary_out(tape, a, b, out, TAPE_MUL(), req)
}

pub fn tape_tensor_div(tape: &!TensorTape, a: i32, b: i32) -> i32 with Alloc, Mut, Panic, Div {
    var av = tape_tensor_view(tape, a, false)
    var bv = tape_tensor_view(tape, b, false)
    let out = tensor_div(&av, &bv)
    let req = tape.requires_grad[a as usize] || tape.requires_grad[b as usize]
    tape_binary_out(tape, a, b, out, TAPE_DIV(), req)
}

pub fn tape_tensor_matmul(tape: &!TensorTape, a: i32, b: i32) -> i32 with Alloc, Mut, Panic, Div {
    var av = tape_tensor_view(tape, a, false)
    var bv = tape_tensor_view(tape, b, false)
    let out = tensor_matmul(&av, &bv)
    let req = tape.requires_grad[a as usize] || tape.requires_grad[b as usize]
    tape_binary_out(tape, a, b, out, TAPE_MATMUL(), req)
}

pub fn tape_tensor_sum(tape: &!TensorTape, a: i32, axis: Option<usize>, keepdims: bool) -> i32 with Alloc, Mut, Panic, Div {
    var av = tape_tensor_view(tape, a, false)
    var has_axis = false
    var axis_value: usize = 0 as usize
    match axis {
        None => {},
        Some(ax) => {
            has_axis = true
            axis_value = ax
        },
    }
    let out_value = tensor_sum(&av, axis, keepdims)
    let req = tape.requires_grad[a as usize]
    let out = tape_push_value_raw(tape, out_value.data, out_value.shape, req)
    if req {
        tape_push_node(tape, TAPE_SUM(), out, a, -1, axis_value, has_axis, keepdims, 1.0, av.shape.dims, av.shape.rank)
    }
    out
}

pub fn tape_tensor_mean(tape: &!TensorTape, a: i32, axis: Option<usize>, keepdims: bool) -> i32 with Alloc, Mut, Panic, Div {
    var av = tape_tensor_view(tape, a, false)
    var has_axis = false
    var axis_value: usize = 0 as usize
    var denom = av.shape.len as f64
    match axis {
        None => {},
        Some(ax) => {
            has_axis = true
            axis_value = ax
            denom = av.shape.dims[ax] as f64
        },
    }
    let out_value = tensor_mean(&av, axis, keepdims)
    let req = tape.requires_grad[a as usize]
    let out = tape_push_value_raw(tape, out_value.data, out_value.shape, req)
    if req {
        tape_push_node(tape, TAPE_MEAN(), out, a, -1, axis_value, has_axis, keepdims, denom, av.shape.dims, av.shape.rank)
    }
    out
}

pub fn tape_tensor_reshape(tape: &!TensorTape, a: i32, new_shape: TensorShape) -> i32 with Alloc, Mut, Panic, Div {
    var av = tape_tensor_view(tape, a, false)
    let out = tensor_reshape(&av, new_shape)
    let req = tape.requires_grad[a as usize]
    tape_unary_out(tape, a, out, TAPE_RESHAPE(), req)
}

pub fn tape_tensor_transpose(tape: &!TensorTape, a: i32) -> i32 with Alloc, Mut, Panic, Div {
    var av = tape_tensor_view(tape, a, false)
    let out = tensor_transpose(&av)
    let req = tape.requires_grad[a as usize]
    tape_unary_out(tape, a, out, TAPE_TRANSPOSE(), req)
}

pub fn tape_tensor_permute(tape: &!TensorTape, a: i32, axes: [usize; 8]) -> i32 with Alloc, Mut, Panic, Div {
    var av = tape_tensor_view(tape, a, false)
    let out_value = tensor_permute(&av, axes)
    let req = tape.requires_grad[a as usize]
    let out = tape_push_value_raw(tape, out_value.data, out_value.shape, req)
    if req {
        tape_push_node(tape, TAPE_PERMUTE(), out, a, -1, 0 as usize, false, false, 0.0, axes, av.shape.rank)
    }
    out
}

pub fn tape_tensor_tanh(tape: &!TensorTape, a: i32) -> i32 with Alloc, Mut, Panic, Div {
    var av = tape_tensor_view(tape, a, false)
    let out = tensor_tanh(&av)
    let req = tape.requires_grad[a as usize]
    tape_unary_out(tape, a, out, TAPE_TANH(), req)
}

pub fn tape_tensor_sigmoid(tape: &!TensorTape, a: i32) -> i32 with Alloc, Mut, Panic, Div {
    var av = tape_tensor_view(tape, a, false)
    let out = tensor_sigmoid(&av)
    let req = tape.requires_grad[a as usize]
    tape_unary_out(tape, a, out, TAPE_SIGMOID(), req)
}

pub fn tape_tensor_relu(tape: &!TensorTape, a: i32) -> i32 with Alloc, Mut, Panic, Div {
    var av = tape_tensor_view(tape, a, false)
    let out = tensor_relu(&av)
    let req = tape.requires_grad[a as usize]
    tape_unary_out(tape, a, out, TAPE_RELU(), req)
}

pub fn tape_tensor_gelu(tape: &!TensorTape, a: i32) -> i32 with Alloc, Mut, Panic, Div {
    var av = tape_tensor_view(tape, a, false)
    let out = tensor_gelu(&av)
    let req = tape.requires_grad[a as usize]
    tape_unary_out(tape, a, out, TAPE_GELU(), req)
}

pub fn tape_tensor_caputo_l1(tape: &!TensorTape, a: i32, dt: f64, alpha: f64) -> i32 with Alloc, Mut, Panic, Div {
    var av = tape_tensor_view(tape, a, false)
    if av.shape.rank != 1 as usize { assert(false) }
    if av.shape.len < 2 as usize { assert(false) }
    if av.shape.len > 512 as usize { assert(false) }

    var samples: [f64; 512] = [0.0; 512]
    var i: usize = 0 as usize
    while i < av.shape.len {
        samples[i] = tensor_get(&av, i)
        i = i + 1 as usize
    }

    let intervals = (av.shape.len - 1 as usize) as i32
    let value = caputo_l1_derivative(samples, intervals, dt, alpha)
    let out_value = tensor_scalar(value)
    let req = tape.requires_grad[a as usize]
    let out = tape_push_value_raw(tape, out_value.data, out_value.shape, req)
    if req {
        tape_push_node_alpha(tape, TAPE_CAPUTO_L1(), out, a, -1, 0 as usize, false, false, dt, alpha, av.shape.dims, av.shape.rank)
    }
    out
}

pub fn tape_tensor_index(tape: &!TensorTape, a: i32, idx: usize) -> i32 with Alloc, Mut, Panic, Div {
    var av = tape_tensor_view(tape, a, false)
    if idx >= av.shape.len { assert(false) }
    let value = tensor_get(&av, idx)
    let out_value = tensor_scalar(value)
    let req = tape.requires_grad[a as usize]
    let out = tape_push_value_raw(tape, out_value.data, out_value.shape, req)
    if req {
        tape_push_node(tape, TAPE_INDEX(), out, a, -1, idx, true, false, 0.0, av.shape.dims, av.shape.rank)
    }
    out
}

fn tape_ensure_grad(tape: &!TensorTape, id: i32) with Alloc, Mut, Panic, Div {
    let idx = id as usize
    if tape.grad_data[idx] == 0 as *mut f64 {
        let shape = tape_value_shape(tape, id)
        let g = tensor_full(shape, 0.0)
        tape.grad_data[idx] = g.data
        tape_store_grad_shape(tape, idx, shape)
    }
}

fn tape_accumulate_grad(tape: &!TensorTape, id: i32, delta: &Tensor) with Alloc, Mut, Panic, Div {
    let idx = id as usize
    if tape.requires_grad[idx] == false { return }
    if tape.grad_data[idx] == 0 as *mut f64 {
        var first = tensor_full(delta.shape, 0.0)
        tape.grad_data[idx] = first.data
        tape_store_grad_shape(tape, idx, delta.shape)
    }
    var g = tape_grad_view(tape, id, false)
    if shape_eq(g.shape, delta.shape) == false { assert(false) }
    var i: usize = 0 as usize
    while i < g.shape.len {
        let cur = tensor_get(&g, i)
        let inc = tensor_get(delta, i)
        tensor_set(&!g, i, cur + inc)
        i = i + 1 as usize
    }
}

fn tape_clear_grads(tape: &!TensorTape) with Alloc, Mut, Panic, Div {
    var i: usize = 0 as usize
    while i < tape.value_len {
        if tape.grad_data[i] != 0 as *mut f64 {
            var g = tape_grad_view(tape, i as i32, false)
            var j: usize = 0 as usize
            while j < g.shape.len {
                tensor_set(&!g, j, 0.0)
                j = j + 1 as usize
            }
        }
        i = i + 1 as usize
    }
}

fn tape_scale(x: &Tensor, scale: f64) -> Tensor with Alloc, Mut, Panic, Div {
    var out = tensor_full(x.shape, 0.0)
    var i: usize = 0 as usize
    while i < x.shape.len {
        tensor_set(&!out, i, tensor_get(x, i) * scale)
        i = i + 1 as usize
    }
    out
}

fn tape_square(x: &Tensor) -> Tensor with Alloc, Mut, Panic, Div {
    var out = tensor_full(x.shape, 0.0)
    var i: usize = 0 as usize
    while i < x.shape.len {
        let v = tensor_get(x, i)
        tensor_set(&!out, i, v * v)
        i = i + 1 as usize
    }
    out
}

fn tape_reduction_grad_to_shape(grad: &Tensor, in_shape: TensorShape, has_axis: bool, axis: usize, keepdims: bool, scale: f64) -> Tensor with Alloc, Mut, Panic, Div {
    var out = tensor_full(in_shape, 0.0)
    var src: usize = 0 as usize
    while src < in_shape.len {
        var rem = src
        var dst: usize = 0 as usize
        var d: usize = 0 as usize
        var od: usize = 0 as usize
        while d < in_shape.rank {
            let coord = rem / in_shape.strides[d]
            rem = rem - coord * in_shape.strides[d]
            if has_axis == false {
            } else if d == axis {
                if keepdims { od = od + 1 as usize }
            } else {
                dst = dst + coord * grad.shape.strides[od]
                od = od + 1 as usize
            }
            d = d + 1 as usize
        }
        tensor_set(&!out, src, tensor_get(grad, dst) * scale)
        src = src + 1 as usize
    }
    out
}

fn tape_broadcast_source_offset(out_shape: TensorShape, in_shape: TensorShape, out_linear: usize) -> usize with Mut, Panic, Div {
    if in_shape.rank == 0 as usize { return 0 as usize }
    var rem = out_linear
    var src_offset: usize = 0 as usize
    var axis: usize = 0 as usize
    while axis < out_shape.rank {
        let coord = rem / out_shape.strides[axis]
        rem = rem - coord * out_shape.strides[axis]
        let trailing = out_shape.rank - axis
        if trailing <= in_shape.rank {
            let in_axis = in_shape.rank - trailing
            if in_shape.dims[in_axis] != 1 as usize {
                src_offset = src_offset + coord * in_shape.strides[in_axis]
            }
        }
        axis = axis + 1 as usize
    }
    src_offset
}

fn tape_sum_to_shape(x: &Tensor, target: TensorShape) -> Tensor with Alloc, Mut, Panic, Div {
    if shape_eq(x.shape, target) {
        var out_same = tensor_full(target, 0.0)
        var j: usize = 0 as usize
        while j < target.len {
            tensor_set(&!out_same, j, tensor_get(x, j))
            j = j + 1 as usize
        }
        return out_same
    }
    var out = tensor_full(target, 0.0)
    var i: usize = 0 as usize
    while i < x.shape.len {
        let dst = tape_broadcast_source_offset(x.shape, target, i)
        let cur = tensor_get(&out, dst)
        tensor_set(&!out, dst, cur + tensor_get(x, i))
        i = i + 1 as usize
    }
    out
}

fn tape_node_saved_shape(tape: &TensorTape, idx: usize) -> TensorShape with Mut, Panic, Div {
    var dims = [0 as usize; 8]
    var i: usize = 0 as usize
    while i < tape.node_rank[idx] {
        dims[i] = tape.node_perm[idx * 8 as usize + i]
        i = i + 1 as usize
    }
    shape_from_dims(dims, tape.node_rank[idx])
}

fn tape_i32_to_usize(x: i32) -> usize with Panic {
    if x < 0 { assert(false) }
    x as usize
}

fn tape_node_b_read(tape: &TensorTape, idx: usize) -> i32 {
    tape.node_b[idx]
}

fn tape_exp_local(x: f64) -> f64 with Mut, Div, Panic {
    if x > 500.0 { return 1.0e200 }
    if x < 0.0 - 500.0 { return 0.0 }
    let ln2 = 0.6931471805599453
    var kf = x / ln2
    var k: i32 = 0
    if kf >= 0.0 { k = kf as i32 } else { k = (kf as i32) - 1 }
    let r = x - (k as f64) * ln2
    var sum = 1.0
    var term = 1.0
    var n = 1
    while n < 25 {
        term = term * r / (n as f64)
        sum = sum + term
        n = n + 1
    }
    var result = sum
    if k >= 0 {
        var i = 0
        while i < k {
            result = result * 2.0
            i = i + 1
        }
    } else {
        var i = 0
        while i < 0 - k {
            result = result / 2.0
            i = i + 1
        }
    }
    result
}

fn tape_tanh_local(x: f64) -> f64 with Mut, Div, Panic {
    if x > 20.0 { return 1.0 }
    if x < 0.0 - 20.0 { return 0.0 - 1.0 }
    let e2 = tape_exp_local(2.0 * x)
    (e2 - 1.0) / (e2 + 1.0)
}

fn tape_gelu_deriv_at(x: f64) -> f64 with Mut, Div, Panic {
    let c = 0.7978845608028654
    let q = c * (x + 0.044715 * x * x * x)
    let th = tape_tanh_local(q)
    let dq = c * (1.0 + 3.0 * 0.044715 * x * x)
    0.5 * (1.0 + th) + 0.5 * x * (1.0 - th * th) * dq
}

fn tape_relu_mask_grad(grad: &Tensor, x: &Tensor) -> Tensor with Alloc, Mut, Panic, Div {
    var out = tensor_full(x.shape, 0.0)
    var i: usize = 0 as usize
    while i < x.shape.len {
        if tensor_get(x, i) > 0.0 {
            tensor_set(&!out, i, tensor_get(grad, i))
        }
        i = i + 1 as usize
    }
    out
}

fn tape_gelu_grad(grad: &Tensor, x: &Tensor) -> Tensor with Alloc, Mut, Panic, Div {
    var out = tensor_full(x.shape, 0.0)
    var i: usize = 0 as usize
    while i < x.shape.len {
        tensor_set(&!out, i, tensor_get(grad, i) * tape_gelu_deriv_at(tensor_get(x, i)))
        i = i + 1 as usize
    }
    out
}

fn backward_add(tape: &!TensorTape, idx: usize) with Alloc, Mut, Panic, Div {
    let out = tape.node_out[idx]
    let a = tape.node_a[idx]
    let b = tape.node_b[idx]
    let out_len = tape_node_saved_shape(tape, idx).len
    if tape.requires_grad[a as usize] {
        var i: usize = 0 as usize
        while i < out_len {
            let cur = read_f64(tape.grad_data[a as usize], i as i64)
            let inc = read_f64(tape.grad_data[out as usize], i as i64)
            write_f64(tape.grad_data[a as usize], i as i64, cur + inc)
            i = i + 1 as usize
        }
    }
    if tape.requires_grad[b as usize] {
        let b_len = tape_inferred_len(tape, b)
        var i: usize = 0 as usize
        while i < out_len {
            var dst = i
            if b_len == 1 as usize {
                dst = 0 as usize
            } else if b_len < out_len {
                let cols = out_len / b_len
                dst = i / cols
            }
            let cur = read_f64(tape.grad_data[b as usize], dst as i64)
            let inc = read_f64(tape.grad_data[out as usize], i as i64)
            write_f64(tape.grad_data[b as usize], dst as i64, cur + inc)
            i = i + 1 as usize
        }
    }
}

fn backward_sub(tape: &!TensorTape, idx: usize) with Alloc, Mut, Panic, Div {
    let out = tape.node_out[idx]
    let a = tape.node_a[idx]
    let b = tape.node_b[idx]
    let out_len = tape_node_saved_shape(tape, idx).len
    if tape.requires_grad[a as usize] {
        var i: usize = 0 as usize
        while i < out_len {
            let cur = read_f64(tape.grad_data[a as usize], i as i64)
            let inc = read_f64(tape.grad_data[out as usize], i as i64)
            write_f64(tape.grad_data[a as usize], i as i64, cur + inc)
            i = i + 1 as usize
        }
    }
    if tape.requires_grad[b as usize] {
        let b_len = tape_inferred_len(tape, b)
        var i: usize = 0 as usize
        while i < out_len {
            var dst = i
            if b_len == 1 as usize {
                dst = 0 as usize
            } else if b_len < out_len {
                let cols = out_len / b_len
                dst = i / cols
            }
            let cur = read_f64(tape.grad_data[b as usize], dst as i64)
            let inc = read_f64(tape.grad_data[out as usize], i as i64)
            write_f64(tape.grad_data[b as usize], dst as i64, cur - inc)
            i = i + 1 as usize
        }
    }
}

fn backward_mul(tape: &!TensorTape, idx: usize) with Alloc, Mut, Panic, Div {
    let out = tape.node_out[idx]
    let a = tape.node_a[idx]
    let b = tape.node_b[idx]
    let out_len = tape_node_saved_shape(tape, idx).len
    if tape.requires_grad[a as usize] {
        var i: usize = 0 as usize
        while i < out_len {
            let cur = read_f64(tape.grad_data[a as usize], i as i64)
            let inc = read_f64(tape.grad_data[out as usize], i as i64) * read_f64(tape.value_data[b as usize], i as i64)
            write_f64(tape.grad_data[a as usize], i as i64, cur + inc)
            i = i + 1 as usize
        }
    }
    if tape.requires_grad[b as usize] {
        var i: usize = 0 as usize
        while i < out_len {
            let cur = read_f64(tape.grad_data[b as usize], i as i64)
            let inc = read_f64(tape.grad_data[out as usize], i as i64) * read_f64(tape.value_data[a as usize], i as i64)
            write_f64(tape.grad_data[b as usize], i as i64, cur + inc)
            i = i + 1 as usize
        }
    }
}

fn backward_div(tape: &!TensorTape, idx: usize) with Alloc, Mut, Panic, Div {
    let out = tape.node_out[idx]
    let a = tape.node_a[idx]
    let b = tape.node_b[idx]
    var gout = tape_grad_view(tape, out, false)
    var av = tape_tensor_view(tape, a, false)
    var bv = tape_tensor_view(tape, b, false)
    if tape.requires_grad[a as usize] {
        var ga_raw = tensor_div(&gout, &bv)
        var da = tape_sum_to_shape(&ga_raw, tape_value_shape(tape, a))
        tape_accumulate_grad(tape, a, &da)
        tensor_free(&!ga_raw)
    }
    if tape.requires_grad[b as usize] {
        var b2 = tape_square(&bv)
        var top = tensor_mul(&gout, &av)
        var raw = tensor_div(&top, &b2)
        var neg = tape_scale(&raw, 0.0 - 1.0)
        var db = tape_sum_to_shape(&neg, tape_value_shape(tape, b))
        tape_accumulate_grad(tape, b, &db)
        tensor_free(&!b2)
        tensor_free(&!top)
        tensor_free(&!raw)
    }
}

fn backward_matmul(tape: &!TensorTape, idx: usize) with Alloc, Mut, Panic, Div {
    let out_id = tape.node_out[idx]
    let a = tape.node_a[idx]
    let rhs = tape_node_b_read(tape, idx)
    let a_slot = tape_i32_to_usize(a)
    let b_slot = tape_i32_to_usize(rhs)
    let out_slot = tape_i32_to_usize(out_id)
    let m = tape.node_perm[idx * 8 as usize]
    let n = tape.node_perm[idx * 8 as usize + 1 as usize]
    if m == 0 as usize { assert(false) }
    if n == 0 as usize { assert(false) }
    if tape.value_len_elems[out_slot] != m * n { assert(false) }
    if tape.value_len_elems[a_slot] % m != 0 as usize { assert(false) }
    let k = tape.value_len_elems[a_slot] / m
    if tape.value_len_elems[b_slot] != k * n { assert(false) }
    if tape.requires_grad[a as usize] {
        var i: usize = 0 as usize
        while i < m {
            var kk: usize = 0 as usize
            while kk < k {
                var acc = 0.0
                var j: usize = 0 as usize
                while j < n {
                    acc = acc + read_f64(tape.grad_data[out_slot], (i * n + j) as i64) * read_f64(tape.value_data[b_slot], (kk * n + j) as i64)
                    j = j + 1 as usize
                }
                let off = i * k + kk
                let cur = read_f64(tape.grad_data[a_slot], off as i64)
                write_f64(tape.grad_data[a_slot], off as i64, cur + acc)
                kk = kk + 1 as usize
            }
            i = i + 1 as usize
        }
    }
    if tape.requires_grad[rhs as usize] {
        var kk: usize = 0 as usize
        while kk < k {
            var j: usize = 0 as usize
            while j < n {
                var acc = 0.0
                var i: usize = 0 as usize
                while i < m {
                    acc = acc + read_f64(tape.value_data[a_slot], (i * k + kk) as i64) * read_f64(tape.grad_data[out_slot], (i * n + j) as i64)
                    i = i + 1 as usize
                }
                let off = kk * n + j
                let cur = read_f64(tape.grad_data[b_slot], off as i64)
                write_f64(tape.grad_data[b_slot], off as i64, cur + acc)
                j = j + 1 as usize
            }
            kk = kk + 1 as usize
        }
    }
}

fn backward_sum(tape: &!TensorTape, idx: usize) with Alloc, Mut, Panic, Div {
    let out = tape.node_out[idx]
    let a = tape.node_a[idx]
    if tape.node_has_axis[idx] == false {
        let scale = read_f64(tape.grad_data[out as usize], 0)
        var i: usize = 0 as usize
        while i < tape.value_len_elems[a as usize] {
            let cur = read_f64(tape.grad_data[a as usize], i as i64)
            write_f64(tape.grad_data[a as usize], i as i64, cur + scale)
            i = i + 1 as usize
        }
        return
    }
    var gout = tape_grad_view(tape, out, false)
    var expanded = tape_reduction_grad_to_shape(&gout, tape_node_saved_shape(tape, idx), tape.node_has_axis[idx], tape.node_axis[idx], tape.node_keepdims[idx], 1.0)
    tape_accumulate_grad(tape, a, &expanded)
}

fn backward_mean(tape: &!TensorTape, idx: usize) with Alloc, Mut, Panic, Div {
    let out = tape.node_out[idx]
    let a = tape.node_a[idx]
    if tape.node_has_axis[idx] == false {
        let scale = read_f64(tape.grad_data[out as usize], 0) / (tape.value_len_elems[a as usize] as f64)
        var i: usize = 0 as usize
        while i < tape.value_len_elems[a as usize] {
            let cur = read_f64(tape.grad_data[a as usize], i as i64)
            write_f64(tape.grad_data[a as usize], i as i64, cur + scale)
            i = i + 1 as usize
        }
        return
    }
    var gout = tape_grad_view(tape, out, false)
    var expanded = tape_reduction_grad_to_shape(&gout, tape_node_saved_shape(tape, idx), tape.node_has_axis[idx], tape.node_axis[idx], tape.node_keepdims[idx], 1.0 / tape.node_scalar[idx])
    tape_accumulate_grad(tape, a, &expanded)
}

fn backward_tanh(tape: &!TensorTape, idx: usize) with Alloc, Mut, Panic, Div {
    let out = tape.node_out[idx]
    let a = tape.node_a[idx]
    let out_slot = out as usize
    let a_slot = a as usize
    var i: usize = 0 as usize
    while i < tape.value_len_elems[out_slot] {
        let y = read_f64(tape.value_data[out_slot], i as i64)
        let inc = read_f64(tape.grad_data[out_slot], i as i64) * (1.0 - y * y)
        let cur = read_f64(tape.grad_data[a_slot], i as i64)
        write_f64(tape.grad_data[a_slot], i as i64, cur + inc)
        i = i + 1 as usize
    }
}

fn backward_sigmoid(tape: &!TensorTape, idx: usize) with Alloc, Mut, Panic, Div {
    let out = tape.node_out[idx]
    let a = tape.node_a[idx]
    let out_slot = out as usize
    let a_slot = a as usize
    var i: usize = 0 as usize
    while i < tape.value_len_elems[out_slot] {
        let y = read_f64(tape.value_data[out_slot], i as i64)
        let inc = read_f64(tape.grad_data[out_slot], i as i64) * y * (1.0 - y)
        let cur = read_f64(tape.grad_data[a_slot], i as i64)
        write_f64(tape.grad_data[a_slot], i as i64, cur + inc)
        i = i + 1 as usize
    }
}

fn backward_relu(tape: &!TensorTape, idx: usize) with Alloc, Mut, Panic, Div {
    let out = tape.node_out[idx]
    let a = tape.node_a[idx]
    let out_slot = out as usize
    let a_slot = a as usize
    var i: usize = 0 as usize
    while i < tape.value_len_elems[out_slot] {
        if read_f64(tape.value_data[a_slot], i as i64) > 0.0 {
            let cur = read_f64(tape.grad_data[a_slot], i as i64)
            let inc = read_f64(tape.grad_data[out_slot], i as i64)
            write_f64(tape.grad_data[a_slot], i as i64, cur + inc)
        }
        i = i + 1 as usize
    }
}

fn backward_gelu(tape: &!TensorTape, idx: usize) with Alloc, Mut, Panic, Div {
    let out = tape.node_out[idx]
    let a = tape.node_a[idx]
    var gout = tape_grad_view(tape, out, false)
    var av = tape_tensor_view(tape, a, false)
    var delta = tape_gelu_grad(&gout, &av)
    tape_accumulate_grad(tape, a, &delta)
}

fn backward_reshape(tape: &!TensorTape, idx: usize) with Alloc, Mut, Panic, Div {
    let out = tape.node_out[idx]
    let a = tape.node_a[idx]
    var gout = tape_grad_view(tape, out, false)
    var reshaped = tensor_reshape(&gout, tape_value_shape(tape, a))
    tape_accumulate_grad(tape, a, &reshaped)
}

fn backward_transpose(tape: &!TensorTape, idx: usize) with Alloc, Mut, Panic, Div {
    let out = tape.node_out[idx]
    let a = tape.node_a[idx]
    var gout = tape_grad_view(tape, out, false)
    var delta = tensor_transpose(&gout)
    tape_accumulate_grad(tape, a, &delta)
}

fn backward_permute(tape: &!TensorTape, idx: usize) with Alloc, Mut, Panic, Div {
    let out = tape.node_out[idx]
    let a = tape.node_a[idx]
    var gout = tape_grad_view(tape, out, false)
    var inverse = [0 as usize; 8]
    var i: usize = 0 as usize
    while i < tape.node_rank[idx] {
        inverse[tape.node_perm[idx * 8 as usize + i]] = i
        i = i + 1 as usize
    }
    var delta = tensor_permute(&gout, inverse)
    tape_accumulate_grad(tape, a, &delta)
}

fn backward_caputo_l1(tape: &!TensorTape, idx: usize) with Alloc, Mut, Panic, Div {
    let out = tape.node_out[idx]
    let a = tape.node_a[idx]
    let a_slot = a as usize
    let len = tape.value_len_elems[a_slot]
    if len < 2 as usize { assert(false) }
    if len > 512 as usize { assert(false) }

    let intervals = len - 1 as usize
    let scale = caputo_l1_scale(tape.node_alpha[idx], tape.node_scalar[idx])
    let gout = read_f64(tape.grad_data[out as usize], 0)

    var k: usize = 0 as usize
    while k < len {
        var coeff = 0.0
        if k == 0 as usize {
            coeff = 0.0 - caputo_l1_weight(tape.node_alpha[idx], (intervals - 1 as usize) as i32) * scale
        } else if k == intervals {
            coeff = caputo_l1_weight(tape.node_alpha[idx], 0) * scale
        } else {
            coeff = (caputo_l1_weight(tape.node_alpha[idx], (intervals - k) as i32)
                - caputo_l1_weight(tape.node_alpha[idx], (intervals - 1 as usize - k) as i32)) * scale
        }
        let cur = read_f64(tape.grad_data[a_slot], k as i64)
        write_f64(tape.grad_data[a_slot], k as i64, cur + gout * coeff)
        k = k + 1 as usize
    }
}

fn backward_index(tape: &!TensorTape, idx: usize) with Mut, Panic {
    let out = tape.node_out[idx]
    let a = tape.node_a[idx]
    let a_slot = a as usize
    let at = tape.node_axis[idx]
    if at >= tape.value_len_elems[a_slot] { assert(false) }
    let gout = read_f64(tape.grad_data[out as usize], 0)
    let cur = read_f64(tape.grad_data[a_slot], at as i64)
    write_f64(tape.grad_data[a_slot], at as i64, cur + gout)
}

pub fn tape_backward(tape: &!TensorTape, output_id: i32) with Alloc, Mut, Panic, Div {
    tape_clear_grads(tape)
    let out_shape = tape_value_shape(tape, output_id)
    var seed_view = tape_grad_view(tape, output_id, false)
    var si: usize = 0 as usize
    while si < out_shape.len {
        tensor_set(&!seed_view, si, 1.0)
        si = si + 1 as usize
    }

    var i = tape.node_len
    while i > 0 as usize {
        i = i - 1 as usize
        let out = tape.node_out[i]
        let op = tape.node_op[i]
        if tape.grad_data[out as usize] != 0 as *mut f64 {
            if op == TAPE_ADD() {
                backward_add(tape, i)
            }
            if op == TAPE_SUB() {
                backward_sub(tape, i)
            }
            if op == TAPE_MUL() {
                backward_mul(tape, i)
            }
            if op == TAPE_DIV() {
                backward_div(tape, i)
            }
            if op == TAPE_MATMUL() {
                backward_matmul(tape, i)
            }
            if op == TAPE_SUM() {
                backward_sum(tape, i)
            }
            if op == TAPE_MEAN() {
                backward_mean(tape, i)
            }
            if op == TAPE_TANH() {
                backward_tanh(tape, i)
            }
            if op == TAPE_SIGMOID() {
                backward_sigmoid(tape, i)
            }
            if op == TAPE_RELU() {
                backward_relu(tape, i)
            }
            if op == TAPE_GELU() {
                backward_gelu(tape, i)
            }
            if op == TAPE_RESHAPE() {
                backward_reshape(tape, i)
            }
            if op == TAPE_TRANSPOSE() {
                backward_transpose(tape, i)
            }
            if op == TAPE_PERMUTE() {
                backward_permute(tape, i)
            }
            if op == TAPE_CAPUTO_L1() {
                backward_caputo_l1(tape, i)
            }
            if op == TAPE_INDEX() {
                backward_index(tape, i)
            }
        }
    }
}

pub fn tape_value_at(tape: &TensorTape, id: i32, offset: usize) -> f64 with Mut, Panic, Div {
    var v = tape_tensor_view(tape, id, false)
    tensor_get(&v, offset)
}

pub fn tape_grad_at(tape: &TensorTape, id: i32, offset: usize) -> f64 with Mut, Panic, Div {
    if tape.grad_data[id as usize] == 0 as *mut f64 { return 0.0 }
    if offset >= tape.grad_len_elems[id as usize] { assert(false) }
    read_f64(tape.grad_data[id as usize], offset as i64)
}

pub fn tape_grad_len(tape: &TensorTape, id: i32) -> usize {
    tape.grad_len_elems[id as usize]
}

pub fn tape_has_grad(tape: &TensorTape, id: i32) -> bool {
    tape.grad_data[id as usize] != 0 as *mut f64
}

pub fn tape_value_count(tape: &TensorTape) -> usize {
    tape.value_len
}

pub fn tape_node_count(tape: &TensorTape) -> usize {
    tape.node_len
}
