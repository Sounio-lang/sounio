// stdlib::tensor::ops - Dynamic f64 tensor operations.
//
// Pure deterministic loops, no BLAS or FFI acceleration.

use tensor::types::*

fn tensor_alloc(shape: TensorShape) -> Tensor with Alloc, Mut, Panic, Div {
    let len = shape_numel(shape)
    let bytes = len * 8 as usize
    let ptr = heap_alloc(bytes) as *mut f64
    Tensor { data: ptr, shape: shape, storage_owner: true }
}

pub fn tensor_free(t: &!Tensor) with Alloc, Mut {
    if t.storage_owner && t.data != 0 as *mut f64 {
        heap_free(t.data as *mut i8)
        t.data = 0 as *mut f64
        t.storage_owner = false
    }
}

pub fn tensor_zeros(shape: TensorShape) -> Tensor with Alloc, Mut, Panic, Div {
    tensor_alloc(shape)
}

pub fn tensor_full(shape: TensorShape, value: f64) -> Tensor with Alloc, Mut, Panic, Div {
    var t = tensor_alloc(shape)
    var i: usize = 0 as usize
    while i < t.shape.len {
        tensor_set(&!t, i, value)
        i = i + 1 as usize
    }
    t
}

pub fn tensor_ones(shape: TensorShape) -> Tensor with Alloc, Mut, Panic, Div {
    tensor_full(shape, 1.0)
}

pub fn tensor_from_slice(src: &[f64; 4096], n: usize, shape: TensorShape) -> Tensor with Alloc, Mut, Panic, Div {
    if n != shape_numel(shape) { assert(false) }
    var t = tensor_alloc(shape)
    var i: usize = 0 as usize
    while i < n {
        tensor_set(&!t, i, src[i])
        i = i + 1 as usize
    }
    t
}

pub fn tensor_scalar(value: f64) -> Tensor with Alloc, Mut, Panic, Div {
    var t = tensor_alloc(shape_scalar())
    tensor_set(&!t, 0 as usize, value)
    t
}

pub fn tensor_linspace(start: f64, stop: f64, n: usize) -> Tensor with Alloc, Mut, Panic, Div {
    var t = tensor_alloc(shape1(n))
    if n == 0 as usize { return t }
    if n == 1 as usize {
        tensor_set(&!t, 0 as usize, start)
        return t
    }
    let step = (stop - start) / ((n - 1 as usize) as f64)
    var i: usize = 0 as usize
    while i < n {
        tensor_set(&!t, i, start + step * (i as f64))
        i = i + 1 as usize
    }
    t
}

pub fn tensor_clone(x: &Tensor) -> Tensor with Alloc, Mut, Panic, Div {
    var out = tensor_alloc(x.shape)
    var i: usize = 0 as usize
    while i < x.shape.len {
        tensor_set(&!out, i, tensor_get(x, i))
        i = i + 1 as usize
    }
    out
}

pub fn broadcast_shape(a: TensorShape, b: TensorShape) -> TensorShape with Mut, Panic, Div {
    var out_rank = a.rank
    if b.rank > out_rank { out_rank = b.rank }
    var dims = [0 as usize; 8]
    var i: usize = 0 as usize
    while i < out_rank {
        let a_rel = out_rank - i
        let b_rel = out_rank - i
        var da: usize = 1 as usize
        var db: usize = 1 as usize
        if a_rel <= a.rank { da = a.dims[a.rank - a_rel] }
        if b_rel <= b.rank { db = b.dims[b.rank - b_rel] }
        if da == db {
            dims[i] = da
        } else if da == 1 as usize {
            dims[i] = db
        } else if db == 1 as usize {
            dims[i] = da
        } else {
            assert(false)
        }
        i = i + 1 as usize
    }
    shape_from_dims(dims, out_rank)
}

fn broadcast_source_offset(out_shape: TensorShape, in_shape: TensorShape, out_linear: usize) -> usize with Mut, Panic, Div {
    if in_shape.rank == 0 as usize { return 0 as usize }
    var rem = out_linear
    var src_offset: usize = 0 as usize
    var axis: usize = 0 as usize
    while axis < out_shape.rank {
        let coord = rem / out_shape.strides[axis]
        rem = rem - coord * out_shape.strides[axis]
        let trailing = out_shape.rank - axis
        if trailing <= in_shape.rank {
            let in_axis = in_shape.rank - trailing
            if in_shape.dims[in_axis] != 1 as usize {
                src_offset = src_offset + coord * in_shape.strides[in_axis]
            }
        }
        axis = axis + 1 as usize
    }
    src_offset
}

fn tensor_binary(a: &Tensor, b: &Tensor, op: i32) -> Tensor with Alloc, Mut, Panic, Div {
    let out_shape = broadcast_shape(a.shape, b.shape)
    var out = tensor_alloc(out_shape)
    var i: usize = 0 as usize
    while i < out.shape.len {
        let ai = broadcast_source_offset(out.shape, a.shape, i)
        let bi = broadcast_source_offset(out.shape, b.shape, i)
        if op == 0 {
            tensor_set(&!out, i, tensor_get(a, ai) + tensor_get(b, bi))
        } else if op == 1 {
            tensor_set(&!out, i, tensor_get(a, ai) - tensor_get(b, bi))
        } else if op == 2 {
            tensor_set(&!out, i, tensor_get(a, ai) * tensor_get(b, bi))
        } else {
            tensor_set(&!out, i, tensor_get(a, ai) / tensor_get(b, bi))
        }
        i = i + 1 as usize
    }
    out
}

pub fn tensor_add(a: &Tensor, b: &Tensor) -> Tensor with Alloc, Mut, Panic, Div { tensor_binary(a, b, 0) }
pub fn tensor_sub(a: &Tensor, b: &Tensor) -> Tensor with Alloc, Mut, Panic, Div { tensor_binary(a, b, 1) }
pub fn tensor_mul(a: &Tensor, b: &Tensor) -> Tensor with Alloc, Mut, Panic, Div { tensor_binary(a, b, 2) }
pub fn tensor_div(a: &Tensor, b: &Tensor) -> Tensor with Alloc, Mut, Panic, Div { tensor_binary(a, b, 3) }

pub fn sum_to_shape(x: &Tensor, target: TensorShape) -> Tensor with Alloc, Mut, Panic, Div {
    var out = tensor_zeros(target)
    var i: usize = 0 as usize
    while i < x.shape.len {
        let dst = broadcast_source_offset(x.shape, target, i)
        tensor_set(&!out, dst, tensor_get(&out, dst) + tensor_get(x, i))
        i = i + 1 as usize
    }
    out
}

pub fn tensor_matmul(a: &Tensor, b: &Tensor) -> Tensor with Alloc, Mut, Panic, Div {
    if a.shape.rank < 2 as usize || b.shape.rank < 2 as usize { assert(false) }
    let a_m_axis = a.shape.rank - 2 as usize
    let a_k_axis = a.shape.rank - 1 as usize
    let b_k_axis = b.shape.rank - 2 as usize
    let b_n_axis = b.shape.rank - 1 as usize
    let m = a.shape.dims[a_m_axis]
    let k = a.shape.dims[a_k_axis]
    let bk = b.shape.dims[b_k_axis]
    let n = b.shape.dims[b_n_axis]
    if k != bk { assert(false) }

    var a_batch_dims = [0 as usize; 8]
    var b_batch_dims = [0 as usize; 8]
    var i: usize = 0 as usize
    while i < a_m_axis {
        a_batch_dims[i] = a.shape.dims[i]
        i = i + 1 as usize
    }
    i = 0 as usize
    while i < b_k_axis {
        b_batch_dims[i] = b.shape.dims[i]
        i = i + 1 as usize
    }
    let batch_shape = broadcast_shape(shape_from_dims(a_batch_dims, a_m_axis), shape_from_dims(b_batch_dims, b_k_axis))
    if batch_shape.rank + 2 as usize > 8 as usize { assert(false) }

    var out_dims = [0 as usize; 8]
    i = 0 as usize
    while i < batch_shape.rank {
        out_dims[i] = batch_shape.dims[i]
        i = i + 1 as usize
    }
    out_dims[batch_shape.rank] = m
    out_dims[batch_shape.rank + 1 as usize] = n
    var out = tensor_zeros(shape_from_dims(out_dims, batch_shape.rank + 2 as usize))

    let batch_len = batch_shape.len
    var batch: usize = 0 as usize
    while batch < batch_len {
        var ii: usize = 0 as usize
        while ii < m {
            var jj: usize = 0 as usize
            while jj < n {
                var acc = 0.0
                var kk: usize = 0 as usize
                while kk < k {
                    let out_prefix = batch * m * n
                    let a_batch_off = broadcast_source_offset(batch_shape, shape_from_dims(a_batch_dims, a_m_axis), batch)
                    let b_batch_off = broadcast_source_offset(batch_shape, shape_from_dims(b_batch_dims, b_k_axis), batch)
                    let ai = a_batch_off * m * k + ii * k + kk
                    let bi = b_batch_off * k * n + kk * n + jj
                    acc = acc + tensor_get(a, ai) * tensor_get(b, bi)
                    kk = kk + 1 as usize
                }
                tensor_set(&!out, batch * m * n + ii * n + jj, acc)
                jj = jj + 1 as usize
            }
            ii = ii + 1 as usize
        }
        batch = batch + 1 as usize
    }
    out
}

pub fn tensor_sum(x: &Tensor, axis: Option<usize>, keepdims: bool) -> Tensor with Alloc, Mut, Panic, Div {
    match axis {
        None => {
            var out_shape = shape_scalar()
            if keepdims {
                var dims = [1 as usize; 8]
                out_shape = shape_from_dims(dims, x.shape.rank)
            }
            var out = tensor_zeros(out_shape)
            var i: usize = 0 as usize
            while i < x.shape.len {
                tensor_set(&!out, 0 as usize, tensor_get(&out, 0 as usize) + tensor_get(x, i))
                i = i + 1 as usize
            }
            return out
        },
        Some(ax) => {
            if ax >= x.shape.rank { assert(false) }
            var dims = [0 as usize; 8]
            var out_rank: usize = 0 as usize
            var d: usize = 0 as usize
            while d < x.shape.rank {
                if d == ax {
                    if keepdims {
                        dims[out_rank] = 1 as usize
                        out_rank = out_rank + 1 as usize
                    }
                } else {
                    dims[out_rank] = x.shape.dims[d]
                    out_rank = out_rank + 1 as usize
                }
                d = d + 1 as usize
            }
            var out = tensor_zeros(shape_from_dims(dims, out_rank))
            var src: usize = 0 as usize
            while src < x.shape.len {
                var rem = src
                var dst: usize = 0 as usize
                d = 0 as usize
                var od: usize = 0 as usize
                while d < x.shape.rank {
                    let coord = rem / x.shape.strides[d]
                    rem = rem - coord * x.shape.strides[d]
                    if d == ax {
                        if keepdims { od = od + 1 as usize }
                    } else {
                        dst = dst + coord * out.shape.strides[od]
                        od = od + 1 as usize
                    }
                    d = d + 1 as usize
                }
                tensor_set(&!out, dst, tensor_get(&out, dst) + tensor_get(x, src))
                src = src + 1 as usize
            }
            return out
        },
    }
}

pub fn tensor_mean(x: &Tensor, axis: Option<usize>, keepdims: bool) -> Tensor with Alloc, Mut, Panic, Div {
    var out = tensor_sum(x, axis, keepdims)
    var denom: f64 = x.shape.len as f64
    match axis {
        None => {},
        Some(ax) => { denom = x.shape.dims[ax] as f64 },
    }
    var i: usize = 0 as usize
    while i < out.shape.len {
        tensor_set(&!out, i, tensor_get(&out, i) / denom)
        i = i + 1 as usize
    }
    out
}

pub fn tensor_reshape(x: &Tensor, new_shape: TensorShape) -> Tensor with Alloc, Mut, Panic, Div {
    if x.shape.len != new_shape.len { assert(false) }
    var out = tensor_zeros(new_shape)
    var i: usize = 0 as usize
    while i < x.shape.len {
        tensor_set(&!out, i, tensor_get(x, i))
        i = i + 1 as usize
    }
    out
}

pub fn tensor_transpose(x: &Tensor) -> Tensor with Alloc, Mut, Panic, Div {
    if x.shape.rank != 2 as usize { assert(false) }
    let rows = x.shape.dims[0]
    let cols = x.shape.dims[1]
    var out = tensor_zeros(shape2(cols, rows))
    var i: usize = 0 as usize
    while i < rows {
        var j: usize = 0 as usize
        while j < cols {
            tensor_set(&!out, j * rows + i, tensor_get(x, i * cols + j))
            j = j + 1 as usize
        }
        i = i + 1 as usize
    }
    out
}

pub fn tensor_permute(x: &Tensor, axes: [usize; 8]) -> Tensor with Alloc, Mut, Panic, Div {
    var dims = [0 as usize; 8]
    var i: usize = 0 as usize
    while i < x.shape.rank {
        if axes[i] >= x.shape.rank { assert(false) }
        dims[i] = x.shape.dims[axes[i]]
        i = i + 1 as usize
    }
    var out = tensor_zeros(shape_from_dims(dims, x.shape.rank))
    var src: usize = 0 as usize
    while src < x.shape.len {
        var coords = [0 as usize; 8]
        var rem = src
        var d: usize = 0 as usize
        while d < x.shape.rank {
            coords[d] = rem / x.shape.strides[d]
            rem = rem - coords[d] * x.shape.strides[d]
            d = d + 1 as usize
        }
        var dst_coords = [0 as usize; 8]
        d = 0 as usize
        while d < x.shape.rank {
            dst_coords[d] = coords[axes[d]]
            d = d + 1 as usize
        }
        let dst = tensor_index(out.shape, dst_coords)
        tensor_set(&!out, dst, tensor_get(x, src))
        src = src + 1 as usize
    }
    out
}

fn t_abs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

fn t_exp(x: f64) -> f64 with Mut, Div, Panic {
    if x > 500.0 { return 1.0e200 }
    if x < -500.0 { return 0.0 }
    let ln2 = 0.6931471805599453
    var kf = x / ln2
    var k: i32 = 0
    if kf >= 0.0 { k = kf as i32 } else { k = (kf as i32) - 1 }
    let r = x - (k as f64) * ln2
    var sum = 1.0
    var term = 1.0
    var n = 1
    while n < 25 {
        term = term * r / (n as f64)
        sum = sum + term
        n = n + 1
    }
    var result = sum
    if k >= 0 {
        var i = 0
        while i < k { result = result * 2.0; i = i + 1 }
    } else {
        var i = 0
        while i < 0 - k { result = result / 2.0; i = i + 1 }
    }
    result
}

fn t_tanh_scalar(x: f64) -> f64 with Mut, Div, Panic {
    if x > 20.0 { return 1.0 }
    if x < 0.0 - 20.0 { return 0.0 - 1.0 }
    let e2 = t_exp(2.0 * x)
    (e2 - 1.0) / (e2 + 1.0)
}

fn t_sigmoid_scalar(x: f64) -> f64 with Mut, Div, Panic {
    if x >= 0.0 {
        let z = t_exp(0.0 - x)
        return 1.0 / (1.0 + z)
    }
    let z = t_exp(x)
    z / (1.0 + z)
}

fn t_unary(x: &Tensor, op: i32) -> Tensor with Alloc, Mut, Panic, Div {
    var out = tensor_zeros(x.shape)
    var i: usize = 0 as usize
    while i < x.shape.len {
        let v = tensor_get(x, i)
        if op == 0 {
            tensor_set(&!out, i, t_tanh_scalar(v))
        } else if op == 1 {
            tensor_set(&!out, i, t_sigmoid_scalar(v))
        } else if op == 2 {
            if v > 0.0 { tensor_set(&!out, i, v) } else { tensor_set(&!out, i, 0.0) }
        } else {
            let c = 0.7978845608028654
            let q = c * (v + 0.044715 * v * v * v)
            tensor_set(&!out, i, 0.5 * v * (1.0 + t_tanh_scalar(q)))
        }
        i = i + 1 as usize
    }
    out
}

pub fn tensor_tanh(x: &Tensor) -> Tensor with Alloc, Mut, Panic, Div { t_unary(x, 0) }
pub fn tensor_sigmoid(x: &Tensor) -> Tensor with Alloc, Mut, Panic, Div { t_unary(x, 1) }
pub fn tensor_relu(x: &Tensor) -> Tensor with Alloc, Mut, Panic, Div { t_unary(x, 2) }
pub fn tensor_gelu(x: &Tensor) -> Tensor with Alloc, Mut, Panic, Div { t_unary(x, 3) }
