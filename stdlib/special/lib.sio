//! stdlib/special/lib.sio - Special mathematical functions
//!
//! Provides special functions commonly used in scientific computing:
//! - Gamma and log-gamma functions
//! - Error functions (erf, erfc)
//! - Bessel functions (J0, J1, Y0, Y1)
//!
//! All functions bind to libm via FFI.

// Computes the Gamma function Γ(x).
// The gamma function generalizes the factorial: Γ(n) = (n-1)!
#[extern("tgamma")]
pub fn gamma(x: f64) -> f64 { }

// Computes the natural logarithm of the Gamma function ln(Γ(x)).
// Useful for large arguments where Γ(x) would overflow.
#[extern("lgamma")]
pub fn lgamma(x: f64) -> f64 { }

// Computes the error function erf(x).
// erf(x) = (2/√π) ∫₀ˣ e^(-t²) dt
#[extern("erf")]
pub fn erf(x: f64) -> f64 { }

// Computes the complementary error function erfc(x) = 1 - erf(x).
// More accurate than computing 1 - erf(x) for large x.
#[extern("erfc")]
pub fn erfc(x: f64) -> f64 { }

// Computes the Bessel function of the first kind of order 0, J₀(x).
#[extern("j0")]
pub fn bessel_j0(x: f64) -> f64 { }

// Computes the Bessel function of the first kind of order 1, J₁(x).
#[extern("j1")]
pub fn bessel_j1(x: f64) -> f64 { }

// Computes the Bessel function of the second kind of order 0, Y₀(x).
#[extern("y0")]
pub fn bessel_y0(x: f64) -> f64 { }

// Computes the Bessel function of the second kind of order 1, Y₁(x).
#[extern("y1")]
pub fn bessel_y1(x: f64) -> f64 { }

// Computes the Bessel function of the first kind of order n, Jₙ(x).
#[extern("jn")]
pub fn bessel_jn(n: i32, x: f64) -> f64 { }

// Computes the Bessel function of the second kind of order n, Yₙ(x).
#[extern("yn")]
pub fn bessel_yn(n: i32, x: f64) -> f64 { }
