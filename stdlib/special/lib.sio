// stdlib/special/lib.sio - FFI bindings to libm special functions
//
// These provide high-performance special functions via the system's libm.
// For a pure Sounio implementation (no FFI), see mod.sio.

extern "C" {
    fn tgamma(x: f64) -> f64;
    fn lgamma(x: f64) -> f64;
    fn erf(x: f64) -> f64;
    fn erfc(x: f64) -> f64;
    fn j0(x: f64) -> f64;
    fn j1(x: f64) -> f64;
    fn y0(x: f64) -> f64;
    fn y1(x: f64) -> f64;
    fn jn(n: i32, x: f64) -> f64;
    fn yn(n: i32, x: f64) -> f64;
}

// Wrapper functions with clearer names

fn libm_gamma(x: f64) -> f64 {
    return tgamma(x)
}

fn libm_lgamma(x: f64) -> f64 {
    return lgamma(x)
}

fn libm_erf(x: f64) -> f64 {
    return erf(x)
}

fn libm_erfc(x: f64) -> f64 {
    return erfc(x)
}

fn bessel_j0(x: f64) -> f64 {
    return j0(x)
}

fn bessel_j1(x: f64) -> f64 {
    return j1(x)
}

fn bessel_y0(x: f64) -> f64 {
    return y0(x)
}

fn bessel_y1(x: f64) -> f64 {
    return y1(x)
}

fn bessel_jn(n: i32, x: f64) -> f64 {
    return jn(n, x)
}

fn bessel_yn(n: i32, x: f64) -> f64 {
    return yn(n, x)
}
