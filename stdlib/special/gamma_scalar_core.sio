// Canonical incomplete-gamma recurrence loops, without result records.
// Scalar outputs and references to caller-owned scalar locals only.
// The checked wrappers retain domain/prefix validation and status policy.
// status0 converged,3 exhausted budget,4 unavailable arithmetic.
use math::pure::{is_finite}
fn gamma_scalar_abs(x:f64)->f64 {if x<0.0 {-x}else{x}}
pub fn gamma_scalar_nonzero(x:f64)->f64 {
 if !is_finite(x) {return x}
 if gamma_scalar_abs(x)>=1.0e-300 {return x}
 if x<0.0 {-1.0e-300}else{1.0e-300}
}
pub fn gamma_series_sum_scalar(a:f64,x:f64,budget:i64,tol:f64,status:&!i64,iterations:&!i64)->f64 with Mut,Div,Panic {
 *status=3;*iterations=0
 var term:f64=1.0
 var sum:f64=1.0
 var correction:f64=0.0
 var n:i64=1
 while n<=budget {
  term=term*(x/(a+(n as f64)))
  let adjusted=term-correction
  let next=sum+adjusted
  correction=(next-sum)-adjusted
  sum=next
  *iterations=n
  if !is_finite(term) || !is_finite(sum) || sum<=0.0 {*status=4;return 0.0}
  if term<=sum*tol {*status=0;return sum}
  n=n+1
 }
 *iterations=budget
 0.0
}
pub fn gamma_cf_factor_scalar(a:f64,x:f64,budget:i64,tol:f64,status:&!i64,iterations:&!i64)->f64 with Mut,Div,Panic {
 *status=3;*iterations=0
 var b=x+1.0-a
 var c:f64=1.0e300
 var d=1.0/gamma_scalar_nonzero(b)
 var h=d
 var n:i64=1
 while n<=budget {
  let nf=n as f64
  let an= -nf*(nf-a)
  b=b+2.0
  d=1.0/gamma_scalar_nonzero(an*d+b)
  c=gamma_scalar_nonzero(b+an/c)
  let ratio=d*c
  h=h*ratio
  *iterations=n
  if !is_finite(h) || !is_finite(ratio) {*status=4;return 0.0}
  if gamma_scalar_abs(ratio-1.0)<=tol {
   if h<=0.0 {*status=4;return 0.0}
   *status=0
   return h
  }
  n=n+1
 }
 *iterations=budget
 0.0
}
