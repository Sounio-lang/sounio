// stdlib/special/mod.sio - Pure Sounio Special Mathematical Functions
//
// Implements classical special functions without FFI dependencies:
//   - Gamma function (Lanczos approximation, g=7)
//   - Log-gamma function (Stirling series for large x)
//   - Beta function via log-gamma
//   - Error function (Abramowitz & Stegun 7.1.26)
//   - Complementary error function
//   - Regularized incomplete gamma (series expansion)
//   - Regularized incomplete beta (Lentz continued fraction)
//   - Digamma / psi function (recurrence + asymptotic)
//
// References:
//   Lanczos (1964) "A Precision Approximation of the Gamma Function"
//   Abramowitz & Stegun (1964) "Handbook of Mathematical Functions"
//   Press et al. (2007) "Numerical Recipes" 3rd ed., Ch. 6

// ============================================================================
// CONSTANTS
// ============================================================================

fn sp_pi() -> f64 {
    3.14159265358979323846
}

fn sp_two_pi() -> f64 {
    6.28318530717958647692
}

fn sp_sqrt_two_pi() -> f64 {
    2.5066282746310005
}

fn sp_euler_mascheroni() -> f64 {
    0.5772156649015329
}

fn sp_ln2() -> f64 {
    0.6931471805599453
}

// ============================================================================
// HELPER FUNCTIONS (must precede callers)
// ============================================================================

fn sp_abs(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn sp_max(a: f64, b: f64) -> f64 {
    if a > b { return a }
    return b
}

fn sp_min(a: f64, b: f64) -> f64 {
    if a < b { return a }
    return b
}

// Floor function: largest integer <= x
fn sp_floor(x: f64) -> f64 with Mut, Panic, Div {
    if x >= 0.0 {
        if x < 1.0 { return 0.0 }
        var result = 0.0
        var remaining = x
        var power = 1000000000000000.0
        while power >= 1.0 {
            while remaining >= power {
                remaining = remaining - power
                result = result + power
            }
            power = power / 10.0
        }
        return result
    } else {
        let pos = 0.0 - x
        let pos_floor = sp_floor(pos)
        if pos > pos_floor {
            return 0.0 - pos_floor - 1.0
        }
        return 0.0 - pos_floor
    }
}

// Square root via Newton-Raphson with range reduction into [1, 4)
fn sp_sqrt(x: f64) -> f64 with Mut, Panic, Div {
    if x <= 0.0 { return 0.0 }
    var scaled = x
    var scale_back = 1.0
    while scaled < 1.0 {
        scaled = scaled * 4.0
        scale_back = scale_back * 2.0
    }
    while scaled > 4.0 {
        scaled = scaled * 0.25
        scale_back = scale_back * 0.5
    }
    var y = 1.5
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    return y / scale_back
}

// Exponential via Taylor series with range reduction
// For |x| > 20, use recursive halving: e^x = (e^(x/2))^2
fn sp_exp(x: f64) -> f64 with Mut, Panic, Div {
    if x > 20.0 { return sp_exp(x / 2.0) * sp_exp(x / 2.0) }
    if x < 0.0 - 20.0 { return 1.0 / sp_exp(0.0 - x) }
    var sum = 1.0
    var term = 1.0
    var i = 1
    while i <= 25 {
        term = term * x / (i as f64)
        sum = sum + term
        i = i + 1
    }
    return sum
}

// Natural logarithm via range reduction to [0.5, 2) then series
// ln(x) = 2 * (t + t^3/3 + t^5/5 + ...) where t = (m-1)/(m+1)
// plus e * ln(2) for the exponent
fn sp_ln(x: f64) -> f64 with Mut, Panic, Div {
    if x <= 0.0 { return 0.0 - 1.0e30 }
    if x == 1.0 { return 0.0 }
    var m = x
    var e = 0
    while m >= 2.0 { m = m / 2.0; e = e + 1 }
    while m < 0.5 { m = m * 2.0; e = e - 1 }
    let t = (m - 1.0) / (m + 1.0)
    let t2 = t * t
    var sum = t
    var term = t
    var k = 1
    while k < 30 {
        term = term * t2
        sum = sum + term / ((2 * k + 1) as f64)
        k = k + 1
    }
    return 2.0 * sum + (e as f64) * sp_ln2()
}

// Sine via range reduction mod 2pi then Taylor series
fn sp_sin(x: f64) -> f64 with Mut, Panic, Div {
    var a = x
    let tp = sp_two_pi()
    if a > tp || a < 0.0 - tp {
        let n = sp_floor(a / tp)
        a = a - n * tp
    }
    while a > sp_pi() { a = a - tp }
    while a < 0.0 - sp_pi() { a = a + tp }
    let a2 = a * a
    var sum = a
    var term = a
    var n = 1
    while n < 18 {
        term = 0.0 - term * a2 / ((2 * n) * (2 * n + 1)) as f64
        sum = sum + term
        n = n + 1
    }
    return sum
}

// Cosine via cos(x) = sin(x + pi/2)
fn sp_cos(x: f64) -> f64 with Mut, Panic, Div {
    return sp_sin(x + sp_pi() / 2.0)
}

// Power function: base^exp = exp(exp * ln(base))
fn sp_pow(base: f64, exponent: f64) -> f64 with Mut, Panic, Div {
    if exponent == 0.0 { return 1.0 }
    if base == 0.0 {
        if exponent > 0.0 { return 0.0 }
        return 1.0e30
    }
    if base == 1.0 { return 1.0 }
    if base > 0.0 {
        return sp_exp(exponent * sp_ln(base))
    }
    let abs_base = sp_abs(base)
    let iexp = sp_floor(exponent)
    if sp_abs(exponent - iexp) < 1.0e-12 {
        let result = sp_exp(exponent * sp_ln(abs_base))
        let half = iexp / 2.0
        let half_floor = sp_floor(half)
        if sp_abs(half - half_floor) > 0.25 {
            return 0.0 - result
        }
        return result
    }
    return 0.0 - 1.0e30
}

// ============================================================================
// GAMMA FUNCTION - Lanczos approximation (g = 7, n = 9)
// ============================================================================
// Gamma(z) = sqrt(2*pi) * (z + g - 0.5)^(z - 0.5) * exp(-(z + g - 0.5)) * Ag(z)
// where Ag(z) = c0 + c1/(z) + c2/(z+1) + ... + c8/(z+7)
//
// For z < 0.5, use the reflection formula:
//   Gamma(z) * Gamma(1 - z) = pi / sin(pi * z)
//
// Coefficients from Paul Godfrey's Lanczos implementation (g=7, n=9).

fn sp_gamma(z: f64) -> f64 with Mut, Panic, Div {
    if z < 0.5 {
        let sin_pz = sp_sin(sp_pi() * z)
        if sp_abs(sin_pz) < 1.0e-15 {
            return 1.0e30
        }
        return sp_pi() / (sin_pz * sp_gamma(1.0 - z))
    }

    var p: [f64; 9] = [0.0; 9]
    p[0] = 0.99999999999980993
    p[1] = 676.5203681218851
    p[2] = 0.0 - 1259.1392167224028
    p[3] = 771.32342877765313
    p[4] = 0.0 - 176.61502916214059
    p[5] = 12.507343278686905
    p[6] = 0.0 - 0.13857109526572012
    p[7] = 9.9843695780195716e-6
    p[8] = 1.5056327351493116e-7

    let w = z - 1.0
    var ag = p[0]
    var i = 1
    while i < 9 {
        ag = ag + p[i] / (w + (i as f64))
        i = i + 1
    }

    let t = w + 7.0 - 0.5
    return sp_sqrt_two_pi() * sp_pow(t, w + 0.5) * sp_exp(0.0 - t) * ag
}

// ============================================================================
// LOG-GAMMA FUNCTION
// ============================================================================
// For x >= 10, use Stirling's asymptotic series:
//   ln(Gamma(x)) ~ (x - 0.5) * ln(x) - x + 0.5 * ln(2*pi)
//                  + 1/(12*x) - 1/(360*x^3) + 1/(1260*x^5)
// For x < 10, use recurrence: ln(Gamma(x)) = ln(Gamma(x+1)) - ln(x)

fn sp_lgamma(x: f64) -> f64 with Mut, Panic, Div {
    if x <= 0.0 { return 1.0e30 }

    var val = x
    var shift = 0.0
    while val < 10.0 {
        shift = shift + sp_ln(val)
        val = val + 1.0
    }

    let ln_2pi = 1.8378770664093453
    var result = (val - 0.5) * sp_ln(val) - val + 0.5 * ln_2pi

    let inv_v = 1.0 / val
    let inv_v2 = inv_v * inv_v
    result = result + inv_v / 12.0
    result = result - inv_v * inv_v2 / 360.0
    result = result + inv_v * inv_v2 * inv_v2 / 1260.0
    result = result - inv_v * inv_v2 * inv_v2 * inv_v2 / 1680.0

    return result - shift
}

// ============================================================================
// BETA FUNCTION
// ============================================================================
// B(a, b) = Gamma(a) * Gamma(b) / Gamma(a + b)
// Implemented via log-gamma for numerical stability.

fn sp_beta(a: f64, b: f64) -> f64 with Mut, Panic, Div {
    return sp_exp(sp_lgamma(a) + sp_lgamma(b) - sp_lgamma(a + b))
}

// ============================================================================
// ERROR FUNCTION (erf)
// ============================================================================
// Abramowitz & Stegun approximation 7.1.26 (maximum error |e| < 1.5e-7):
//   erf(x) ~ 1 - (a1*t + a2*t^2 + a3*t^3 + a4*t^4 + a5*t^5) * exp(-x^2)
//   where t = 1 / (1 + 0.3275911 * x)

fn sp_erf(x: f64) -> f64 with Mut, Panic, Div {
    if x < 0.0 {
        return 0.0 - sp_erf(0.0 - x)
    }
    if x == 0.0 { return 0.0 }
    if x > 6.0 { return 1.0 }

    let p = 0.3275911
    let a1 = 0.254829592
    let a2 = 0.0 - 0.284496736
    let a3 = 1.421413741
    let a4 = 0.0 - 1.453152027
    let a5 = 1.061405429

    let t = 1.0 / (1.0 + p * x)
    let t2 = t * t
    let t3 = t2 * t
    let t4 = t3 * t
    let t5 = t4 * t

    let poly = a1 * t + a2 * t2 + a3 * t3 + a4 * t4 + a5 * t5
    return 1.0 - poly * sp_exp(0.0 - x * x)
}

// ============================================================================
// COMPLEMENTARY ERROR FUNCTION (erfc)
// ============================================================================

fn sp_erfc(x: f64) -> f64 with Mut, Panic, Div {
    if x < 0.0 {
        return 2.0 - sp_erfc(0.0 - x)
    }
    if x == 0.0 { return 1.0 }
    if x > 6.0 { return 0.0 }

    let p = 0.3275911
    let a1 = 0.254829592
    let a2 = 0.0 - 0.284496736
    let a3 = 1.421413741
    let a4 = 0.0 - 1.453152027
    let a5 = 1.061405429

    let t = 1.0 / (1.0 + p * x)
    let t2 = t * t
    let t3 = t2 * t
    let t4 = t3 * t
    let t5 = t4 * t

    let poly = a1 * t + a2 * t2 + a3 * t3 + a4 * t4 + a5 * t5
    return poly * sp_exp(0.0 - x * x)
}

// ============================================================================
// REGULARIZED INCOMPLETE GAMMA FUNCTION - P(a, x)
// ============================================================================
// Series expansion (good for x < a + 1):
//   gamma(a, x) = e^(-x) * x^a * sum x^n / (a*(a+1)*...*(a+n))

fn sp_gamma_inc_series(a: f64, x: f64) -> f64 with Mut, Panic, Div {
    var ap = a
    var sum = 1.0 / a
    var term = 1.0 / a
    var n = 0
    while n < 200 {
        ap = ap + 1.0
        term = term * x / ap
        sum = sum + term
        if sp_abs(term) < sp_abs(sum) * 1.0e-12 {
            return sum * sp_exp(0.0 - x + a * sp_ln(x) - sp_lgamma(a))
        }
        n = n + 1
    }
    return sum * sp_exp(0.0 - x + a * sp_ln(x) - sp_lgamma(a))
}

// Continued fraction for upper incomplete gamma Q(a,x) via Lentz
fn sp_gamma_inc_cf(a: f64, x: f64) -> f64 with Mut, Panic, Div {
    let tiny = 1.0e-30
    let b0 = x + 1.0 - a
    var f = b0
    if sp_abs(b0) < tiny { f = tiny }
    var c = f
    var d = 0.0

    var n = 1
    while n < 200 {
        let an = (n as f64) * ((n as f64) - a)
        let bn = x + 2.0 * (n as f64) + 1.0 - a

        d = bn + an * d
        if sp_abs(d) < tiny { d = tiny }
        d = 1.0 / d

        c = bn + an / c
        if sp_abs(c) < tiny { c = tiny }

        let delta = c * d
        f = f * delta

        if sp_abs(delta - 1.0) < 1.0e-12 {
            n = 200
        } else {
            n = n + 1
        }
    }

    let log_prefix = 0.0 - x + a * sp_ln(x) - sp_lgamma(a)
    return sp_exp(log_prefix) / f
}

fn sp_gamma_inc_p(a: f64, x: f64) -> f64 with Mut, Panic, Div {
    if x < 0.0 { return 0.0 }
    if x == 0.0 { return 0.0 }
    if a <= 0.0 { return 1.0 }

    if x < a + 1.0 {
        return sp_gamma_inc_series(a, x)
    } else {
        return 1.0 - sp_gamma_inc_cf(a, x)
    }
}

// ============================================================================
// REGULARIZED INCOMPLETE BETA FUNCTION - I_x(a, b)
// ============================================================================
// Continued fraction via Lentz's method.
// If x > (a+1)/(a+b+2), use symmetry: I_x(a,b) = 1 - I_{1-x}(b,a)

fn sp_beta_inc_cf(a: f64, b: f64, x: f64) -> f64 with Mut, Panic, Div {
    let tiny = 1.0e-30

    var d = 1.0 - (a + b) * x / (a + 1.0)
    if sp_abs(d) < tiny { d = tiny }
    d = 1.0 / d
    var f = d
    var c = 1.0

    var m = 1
    while m < 200 {
        let mf = m as f64

        let num_even = mf * (b - mf) * x / ((a + 2.0 * mf - 1.0) * (a + 2.0 * mf))

        d = 1.0 + num_even * d
        if sp_abs(d) < tiny { d = tiny }
        d = 1.0 / d

        c = 1.0 + num_even / c
        if sp_abs(c) < tiny { c = tiny }

        f = f * d * c

        let num_odd = 0.0 - (a + mf) * (a + b + mf) * x / ((a + 2.0 * mf) * (a + 2.0 * mf + 1.0))

        d = 1.0 + num_odd * d
        if sp_abs(d) < tiny { d = tiny }
        d = 1.0 / d

        c = 1.0 + num_odd / c
        if sp_abs(c) < tiny { c = tiny }

        let delta = d * c
        f = f * delta

        if sp_abs(delta - 1.0) < 1.0e-12 {
            m = 200
        } else {
            m = m + 1
        }
    }

    return f
}

fn sp_beta_inc(a: f64, b: f64, x: f64) -> f64 with Mut, Panic, Div {
    if x <= 0.0 { return 0.0 }
    if x >= 1.0 { return 1.0 }

    let pivot = (a + 1.0) / (a + b + 2.0)
    if x > pivot {
        return 1.0 - sp_beta_inc(b, a, 1.0 - x)
    }

    let log_prefix = a * sp_ln(x) + b * sp_ln(1.0 - x) - sp_ln(a) - sp_lgamma(a) - sp_lgamma(b) + sp_lgamma(a + b)
    let prefix = sp_exp(log_prefix)

    let cf = sp_beta_inc_cf(a, b, x)
    return prefix * cf
}

// ============================================================================
// DIGAMMA / PSI FUNCTION
// ============================================================================
// psi(x) = d/dx ln(Gamma(x))
//
// Algorithm:
//   1. Use recurrence psi(x+1) = psi(x) + 1/x to shift x >= 7
//   2. Asymptotic: psi(x) ~ ln(x) - 1/(2x) - B_{2k}/(2k*x^{2k})

fn sp_digamma(x: f64) -> f64 with Mut, Panic, Div {
    if x < 0.0 {
        let s = sp_sin(sp_pi() * x)
        if sp_abs(s) < 1.0e-15 { return 1.0e30 }
        return sp_digamma(1.0 - x) - sp_pi() * sp_cos(sp_pi() * x) / s
    }

    if x == 0.0 { return 0.0 - 1.0e30 }

    var val = x
    var shift = 0.0
    while val < 7.0 {
        shift = shift - 1.0 / val
        val = val + 1.0
    }

    let inv_v = 1.0 / val
    let inv_v2 = inv_v * inv_v

    var result = sp_ln(val) - 0.5 * inv_v
    result = result - inv_v2 / 12.0
    result = result + inv_v2 * inv_v2 / 120.0
    result = result - inv_v2 * inv_v2 * inv_v2 / 252.0
    result = result + inv_v2 * inv_v2 * inv_v2 * inv_v2 / 240.0
    result = result - 5.0 * inv_v2 * inv_v2 * inv_v2 * inv_v2 * inv_v2 / 660.0

    return result + shift
}
