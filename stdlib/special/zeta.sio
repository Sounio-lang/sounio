// stdlib/special/zeta.sio — Riemann zeta and related functions
//
// Pure Sounio implementations:
//   zeta(s)          — Riemann zeta function for real s
//   hurwitz_zeta(s,a) — Hurwitz zeta function
//   dirichlet_eta(s) — Dirichlet eta function
//   polylogarithm(s,z) — Polylogarithm Li_s(z) for real s, |z| <= 1
//   bernoulli_poly(n,x) — Bernoulli polynomials B_n(x)
//   euler_poly(n,x)     — Euler polynomials E_n(x)
//   clausen(x)          — Clausen function Cl_2(x)
//
// Algorithms:
//   Riemann zeta: Borwein's algorithm (alternating series acceleration) for s > 0,
//     functional equation for s < 0, direct summation near s = 1.
//   Hurwitz zeta: Euler-Maclaurin summation with Bernoulli corrections.
//   Polylogarithm: direct series for |z| < 0.5, accelerated for |z| near 1.
//
// References:
//   DLMF Ch. 25 (https://dlmf.nist.gov/25)
//   Borwein (2000): "An Efficient Algorithm for the Riemann Zeta Function"
//   Borwein, Bailey & Girgensohn (2004): "Experimentation in Mathematics"
//   Apostol (1976): "Introduction to Analytic Number Theory"

// =============================================================================
// Helpers
// =============================================================================

fn zt_abs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

fn zt_exp(x: f64) -> f64 with Mut, Div, Panic {
    if x > 500.0 { return 1.0e200 }
    if x < -500.0 { return 0.0 }
    var kf = x / 0.6931471805599453
    var k: i32 = 0
    if kf >= 0.0 { k = kf as i32 } else { k = (kf as i32) - 1 }
    let r = x - (k as f64) * 0.6931471805599453
    var sum = 1.0
    var term = 1.0
    var n = 1
    while n < 25 { term = term * r / (n as f64); sum = sum + term; n = n + 1 }
    var result = sum
    if k >= 0 { var i = 0; while i < k { result = result * 2.0; i = i + 1 } }
    else { var i = 0; while i < (0 - k) { result = result / 2.0; i = i + 1 } }
    result
}

fn zt_ln(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 - 1.0e30 }
    if x == 1.0 { return 0.0 }
    var m = x
    var e = 0
    while m >= 2.0 { m = m / 2.0; e = e + 1 }
    while m < 0.5 { m = m * 2.0; e = e - 1 }
    let t = (m - 1.0) / (m + 1.0)
    let t2 = t * t
    var sum = t
    var term = t
    var k = 1
    while k < 30 { term = term * t2; sum = sum + term / ((2 * k + 1) as f64); k = k + 1 }
    2.0 * sum + (e as f64) * 0.6931471805599453
}

fn zt_sin(x: f64) -> f64 with Mut, Div, Panic {
    var a = x
    let tp = 6.28318530717958647692
    while a >= tp { a = a - tp }
    while a < 0.0 { a = a + tp }
    if a > 3.14159265358979323846 { a = a - tp }
    let a2 = a * a
    var sum = a
    var term = a
    var n = 1
    while n < 18 { term = 0.0 - term * a2 / ((2 * n) * (2 * n + 1)) as f64; sum = sum + term; n = n + 1 }
    sum
}

fn zt_lgamma(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 1.0e30 }
    var val = x
    var shift = 0.0
    while val < 8.0 { shift = shift + zt_ln(val); val = val + 1.0 }
    var result = (val - 0.5) * zt_ln(val) - val + 0.5 * 1.8378770664093453
    let iv = 1.0 / val
    let iv2 = iv * iv
    result = result + iv / 12.0 - iv * iv2 / 360.0 + iv * iv2 * iv2 / 1260.0
    result - shift
}

fn zt_gamma(x: f64) -> f64 with Mut, Div, Panic { zt_exp(zt_lgamma(x)) }

fn zt_pi() -> f64 { 3.14159265358979323846 }

fn zt_pow(base: f64, exp: f64) -> f64 with Mut, Div, Panic {
    if base == 0.0 { if exp > 0.0 { return 0.0 } else { return 1.0e30 } }
    if exp == 0.0 { return 1.0 }
    if base > 0.0 { return zt_exp(exp * zt_ln(base)) }
    let ab = zt_abs(base)
    zt_exp(exp * zt_ln(ab))
}

// =============================================================================
// Riemann zeta function zeta(s) for real s
// =============================================================================

// Borwein's algorithm: uses Chebyshev-like coefficients for series acceleration.
// zeta(s) = -1/(1 - 2^{1-s}) * 1/d_n * sum_{k=0}^{n-1} (-1)^k (d_k - d_n) / (k+1)^s
// where d_k = n * sum_{i=0}^{k} (n+i-1)! * 4^i / ((n-i)! * (2i)!)
pub fn riemann_zeta(s: f64) -> f64 with Mut, Div, Panic {
    // Trivial zeros
    if s == 1.0 { return 1.0e30 }  // pole

    // Known values
    if s == 0.0 { return 0.0 - 0.5 }
    if s == 2.0 { return zt_pi() * zt_pi() / 6.0 }
    if s == 4.0 { return zt_pi() * zt_pi() * zt_pi() * zt_pi() / 90.0 }

    // For s < 0: functional equation
    // zeta(s) = 2^s * pi^{s-1} * sin(pi*s/2) * Gamma(1-s) * zeta(1-s)
    if s < 0.0 {
        let one_ms = 1.0 - s
        let z1 = riemann_zeta(one_ms)
        let sin_val = zt_sin(zt_pi() * s / 2.0)
        let pow2 = zt_pow(2.0, s)
        let pow_pi = zt_pow(zt_pi(), s - 1.0)
        let gam = zt_gamma(one_ms)
        return pow2 * pow_pi * sin_val * gam * z1
    }

    // For 0 < s < 1 or s > 1: Borwein acceleration with n = 32
    let n: i32 = 32

    // Compute d_k coefficients
    var d: [f64; 33] = [0.0; 33]
    d[0] = 1.0
    var k = 1
    while k <= n {
        // d_k = d_{k-1} + n * (n+k-1)! * 4^k / ((n-k)! * (2k)!)
        // Use recurrence: d_k = d_{k-1} * (n+k-1)*(n-k+1)*4 / (2k*(2k-1))... no.
        // Actually d_k = n * sum_{i=0}^{k} C(n+i-1, 2i) * 4^i
        // Simpler: compute each term and accumulate
        var term_sum = 0.0
        var i = 0
        while i <= k {
            // C(n+i-1, 2i) * 4^i
            var binom_val = 1.0
            // C(n+i-1, 2i) = (n+i-1)! / ((2i)! * (n-i-1)!)
            // Use product form
            var j = 0
            while j < 2 * i {
                binom_val = binom_val * ((n + i - 1 - j) as f64) / ((j + 1) as f64)
                j = j + 1
            }
            var pow4 = 1.0
            var pi = 0
            while pi < i { pow4 = pow4 * 4.0; pi = pi + 1 }
            term_sum = term_sum + binom_val * pow4
            i = i + 1
        }
        d[k] = (n as f64) * term_sum
        k = k + 1
    }

    let dn = d[n]
    var sum = 0.0
    k = 0
    while k < n {
        let sign = if k - (k / 2) * 2 == 0 { 1.0 } else { 0.0 - 1.0 }
        sum = sum + sign * (d[k] - dn) / zt_pow((k + 1) as f64, s)
        k = k + 1
    }

    let factor = 0.0 - 1.0 / (dn * (1.0 - zt_pow(2.0, 1.0 - s)))
    factor * sum
}

// =============================================================================
// Hurwitz zeta function zeta(s, a)
// =============================================================================

// Hurwitz zeta: zeta(s, a) = sum_{n=0}^{inf} 1/(n+a)^s for s > 1.
// Uses Euler-Maclaurin formula with Bernoulli number corrections.
pub fn hurwitz_zeta(s: f64, a: f64) -> f64 with Mut, Div, Panic {
    if a <= 0.0 { return 1.0e30 }
    if s <= 1.0 { return 1.0e30 }  // divergent

    // Direct sum for first N terms, then Euler-Maclaurin
    let n_direct: i32 = 50
    var sum = 0.0
    var k = 0
    while k < n_direct {
        sum = sum + 1.0 / zt_pow(a + (k as f64), s)
        k = k + 1
    }

    let x = a + (n_direct as f64)
    // Integral term: x^{1-s} / (s-1)
    sum = sum + zt_pow(x, 1.0 - s) / (s - 1.0)
    // Midpoint correction: 0.5 / x^s
    sum = sum + 0.5 * zt_pow(x, 0.0 - s)

    // Bernoulli corrections: sum_{j=1}^{p} B_{2j}/(2j)! * s*(s+1)*...*(s+2j-2) * x^{-s-2j+1}
    // First few Bernoulli numbers: B_2=1/6, B_4=-1/30, B_6=1/42, B_8=-1/30, B_10=5/66
    var bernoulli: [f64; 6] = [0.0; 6]
    bernoulli[0] = 1.0 / 6.0
    bernoulli[1] = 0.0 - 1.0 / 30.0
    bernoulli[2] = 1.0 / 42.0
    bernoulli[3] = 0.0 - 1.0 / 30.0
    bernoulli[4] = 5.0 / 66.0
    bernoulli[5] = 0.0 - 691.0 / 2730.0

    var running_s = s
    var j = 0
    while j < 6 {
        let j2 = 2 * (j + 1)
        // s*(s+1)*...*(s+2j-1) / (2j)!
        var falling = 1.0
        var m = 0
        while m < j2 {
            falling = falling * (s + (m as f64))
            m = m + 1
        }
        // Divide by (2j)!
        var fact = 1.0
        m = 1
        while m <= j2 { fact = fact * (m as f64); m = m + 1 }
        falling = falling / fact

        sum = sum + bernoulli[j] * falling * zt_pow(x, 0.0 - s - (j2 as f64) + 1.0)
        j = j + 1
    }
    sum
}

// =============================================================================
// Dirichlet eta function
// =============================================================================

// eta(s) = (1 - 2^{1-s}) * zeta(s) = sum_{n=1}^{inf} (-1)^{n-1} / n^s
// Converges for all s (unlike zeta).
pub fn dirichlet_eta(s: f64) -> f64 with Mut, Div, Panic {
    if s == 1.0 { return zt_ln(2.0) }
    (1.0 - zt_pow(2.0, 1.0 - s)) * riemann_zeta(s)
}

// =============================================================================
// Polylogarithm Li_s(z) for real s and |z| <= 1
// =============================================================================

// Li_s(z) = sum_{k=1}^{inf} z^k / k^s
fn polylogarithm(s: f64, z: f64) -> f64 with Mut, Div, Panic {
    if z == 0.0 { return 0.0 }
    if z == 1.0 { return riemann_zeta(s) }
    if zt_abs(z) > 1.0 { return 0.0 - 1.0e30 }  // not defined

    // Special cases
    if s == 1.0 { return 0.0 - zt_ln(1.0 - z) }
    if s == 0.0 { return z / (1.0 - z) }
    if s == -1.0 { return z / ((1.0 - z) * (1.0 - z)) }

    // Direct series for |z| < 0.8
    if zt_abs(z) < 0.8 {
        var sum = 0.0
        var zk = z
        var k = 1
        while k < 500 {
            sum = sum + zk / zt_pow(k as f64, s)
            zk = zk * z
            if zt_abs(zk) / zt_pow(k as f64, s) < 1.0e-15 { k = 500 }
            else { k = k + 1 }
        }
        return sum
    }

    // |z| close to 1: use series expansion around z = 1
    // Li_s(z) = Gamma(1-s)*(-ln(z))^{s-1} + sum_{k=0}^{inf} zeta(s-k)*ln(z)^k/k!
    // For |z| near 1 but z != 1
    let ln_z = zt_ln(zt_abs(z))
    if z > 0.0 && z < 1.0 {
        var sum = 0.0
        var zk = z
        var k = 1
        while k < 2000 {
            sum = sum + zk / zt_pow(k as f64, s)
            zk = zk * z
            if zt_abs(zk) < 1.0e-15 { k = 2000 }
            else { k = k + 1 }
        }
        return sum
    }

    // z < 0, |z| near 1: direct series
    var sum = 0.0
    var zk = z
    var k = 1
    while k < 2000 {
        sum = sum + zk / zt_pow(k as f64, s)
        zk = zk * z
        if zt_abs(zk) / zt_pow(k as f64, s) < 1.0e-15 { k = 2000 }
        else { k = k + 1 }
    }
    sum
}

// =============================================================================
// Bernoulli and Euler polynomials
// =============================================================================

// Bernoulli polynomial B_n(x) = sum_{k=0}^{n} C(n,k) * B_k * x^{n-k}
// where B_k are Bernoulli numbers.
fn bernoulli_poly(n: i32, x: f64) -> f64 with Mut, Div, Panic {
    if n == 0 { return 1.0 }
    if n == 1 { return x - 0.5 }

    // Compute Bernoulli numbers B_0 ... B_n via Akiyama-Tanigawa
    var b: [f64; 31] = [0.0; 31]
    var i = 0
    while i <= n && i <= 30 {
        b[i] = 0.0
        // Akiyama-Tanigawa
        var a_arr: [f64; 31] = [0.0; 31]
        var j = 0
        while j <= i { a_arr[j] = 1.0 / ((j + 1) as f64); j = j + 1 }
        j = i
        while j >= 1 {
            var jj = 0
            while jj < j { a_arr[jj] = (jj + 1) as f64 * (a_arr[jj] - a_arr[jj + 1]); jj = jj + 1 }
            j = j - 1
        }
        b[i] = a_arr[0]
        i = i + 1
    }

    // B_n(x) = sum_{k=0}^{n} C(n,k) * B_k * x^{n-k}
    var result = 0.0
    var binom: i64 = 1
    var k = 0
    while k <= n {
        var x_pow = 1.0
        var p = 0
        while p < n - k { x_pow = x_pow * x; p = p + 1 }
        result = result + (binom as f64) * b[k] * x_pow
        // Update binomial: C(n, k+1) = C(n,k) * (n-k) / (k+1)
        binom = binom * ((n - k) as i64) / ((k + 1) as i64)
        k = k + 1
    }
    result
}

// Euler polynomial E_n(x).
// E_n(x) = 2/(n+1) * (B_{n+1}(x) - 2^{n+1} * B_{n+1}(x/2))
fn euler_poly(n: i32, x: f64) -> f64 with Mut, Div, Panic {
    let nm1 = n + 1
    let b1 = bernoulli_poly(nm1, x)
    let b2 = bernoulli_poly(nm1, x / 2.0)
    var pow2 = 1.0
    var i = 0
    while i <= n { pow2 = pow2 * 2.0; i = i + 1 }
    2.0 / (nm1 as f64) * (b1 - pow2 * b2)
}

// =============================================================================
// Clausen function
// =============================================================================

// Clausen function Cl_2(theta) = -integral from 0 to theta of ln|2*sin(t/2)| dt
// = sum_{k=1}^{inf} sin(k*theta) / k^2
fn clausen(theta: f64) -> f64 with Mut, Div, Panic {
    // Reduce theta to [0, 2*pi)
    var t = theta
    let tp = 6.28318530717958647692
    while t >= tp { t = t - tp }
    while t < 0.0 { t = t + tp }

    // Direct series: converges well for theta not near 0 or 2*pi
    var sum = 0.0
    var k = 1
    while k < 500 {
        let kf = k as f64
        sum = sum + zt_sin(kf * t) / (kf * kf)
        if k > 10 && zt_abs(zt_sin(kf * t) / (kf * kf)) < 1.0e-15 { k = 500 }
        else { k = k + 1 }
    }
    sum
}
