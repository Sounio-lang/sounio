// stdlib/hydride/mhhc.sio -- metal-hydride hydrogen compression, as a
// COUPLED cascade rather than a chain of independent pressure ratios.
//
// WHY THIS EXISTS. A metal-hydride compressor is usually modelled, outside
// a full CFD code, as a product of per-stage van 't Hoff ratios
// P_des(T_hot)/P_abs(T_cold) with a lumped efficiency absorbing whatever
// does not fit. That model cannot be right, and the arithmetic says so
// loudly: fed the measured per-stage enthalpies of the seven-stage system
// in Gkanas et al. 2020 (Renewable Energy 147:164-178,
// DOI 10.1016/j.renene.2019.08.104 -- Table 3, transcribed in
// demos/hydrogen/data/gkanas2020_seven_stage.md), the free-ratio product
// gives a compression ratio of 6640x where the paper reports 18.7x.
//
// The missing physics is the COUPLING. Stage k does not compress into a
// vacuum: it desorbs into an interconnector volume that stage k+1 is
// simultaneously absorbing from, so the pressure each stage actually sees
// is set by a running mass balance between the two, not by its own plateau.
// The paper's eq. 12 is exactly this -- n_t = n_in + n_des - n_abs -- and
// it is what this module implements.
//
// WHAT THIS IS, STATED BEFORE ANY NUMBER. The paper solves a 3D
// reaction-diffusion-heat problem whose mesh exceeded 15 million elements
// (and shortened its own reactors from 12 m to 6 m to make that tractable).
// THIS IS NOT THAT. This is a LUMPED, zero-dimensional-per-reactor model:
// one temperature and one hydrogen content per bed, no spatial gradient, no
// Darcy flow, no Zehner-Bauer-Schlunder conductivity. It is the standard
// reduced model in the field, and its purpose is different from the CFD's:
// to be cheap enough to run thousands of times, which is what uncertainty
// propagation over a cycle needs and what the paper does not do.
//
// Where it deviates from the paper, that is a result to report, not an
// error to tune away. There is no fitted efficiency anywhere in this file.
//
// CONSTANTS THE PAPER DOES NOT GIVE, and which are therefore sourced or
// declared rather than silently chosen: the kinetic pre-exponentials and
// activation energies C_a, C_d, E_a, E_d are cited by the paper to its own
// ref. [95] without values, and the plateau-slope and hysteresis factors
// sigma_s, sigma_0 and Y likewise. This module takes them as explicit
// parameters with no defaults buried in the physics, and the demo that
// drives it says where each one came from.
//
// LANGUAGE CONSTRAINTS, all paid for once already elsewhere in this tree:
// negative module-level constants are `var`, never `let`; no closures, so
// helpers precede callers; a returned fixed-size array is a heap handle on
// Madaros, not a stack copy, so the integrator writes through `&![f64; N]`
// output parameters and allocates nothing inside its step loop.

module hydride::mhhc

use math::pure::{exp, ln}

// ============================================================================
// 0. CONSTANTS AND SHAPE
// ============================================================================

pub fn r_gas() -> f64 { 8.314462618 }          // J/(mol K)
pub fn h2_molar_mass() -> f64 { 0.00201588 }   // kg/mol

fn abs_f64(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }
fn check_near(a: f64, b: f64, tol: f64) -> bool { abs_f64(a - b) < tol }

// A single hydride bed. Thermodynamics are per-direction because absorption
// and desorption are measured separately -- the gap between dh_abs and
// dh_des IS the hysteresis, and lumping it into an efficiency is what this
// module exists to avoid.
pub struct HydrideBed {
    dh_abs: f64,      // J/mol H2
    ds_abs: f64,      // J/(mol H2 K)
    dh_des: f64,      // J/mol H2
    ds_des: f64,      // J/(mol H2 K)
    m_alloy: f64,     // kg
    m_steel: f64,     // kg of tank wall heated and cooled with the bed
    cap_mol: f64,     // mol H2 per kg alloy at full loading
    cp_alloy: f64,    // J/(kg K)
    cp_steel: f64,    // J/(kg K)
    ua: f64           // W/K, bed-to-heat-transfer-fluid conductance
}

// Kinetics, kept separate from the bed because the paper gives the FORM of
// these and not their values: a caller must supply them and say where from.
pub struct HydrideKinetics {
    c_abs: f64,       // 1/s
    e_abs: f64,       // J/mol
    c_des: f64,       // 1/s
    e_des: f64        // J/mol
}

// Plateau shape and the phase boundaries that bound it.
//
// sigma is the plateau slope as d(ln P)/dx, LINEAR and finite -- not the
// coefficient of a tangent. hyst is the isotherm hysteresis of the paper's
// eq. 11. x_alpha and x_beta are the loadings at which the solid-solution and
// beta branches take over from the plateau.
//
// WHY THE TANGENT FORM IS GONE, measured rather than argued. The paper's
// eq. 11 writes the whole isotherm as van 't Hoff plus
// (sigma_s + sigma_0)*tan(pi*(X/X_max - 1/2)), which diverges at both ends of
// the loading range. At x = 0.001 with sigma = 0.25 that gives
// tan(pi*(-0.499)) ~ -318 and an equilibrium pressure of 3e-35 bar: the model
// then says an empty bed absorbs hydrogen out of a vacuum of 1e-35 bar. It is
// not a stiff problem to be integrated harder -- it is the tangent evaluated
// outside the region it describes. Measured consequence, on p-box corner 101:
// the interconnector is driven negative, the clamp that rescues it cannot
// conserve, and 0.4% to 6% of the hydrogen disappears. Adaptive step
// rejection does not help, because reaching the true asymptote means
// resolving the gas inventory across 35 orders of magnitude.
//
// A real PCT isotherm has three regions and the tangent is a one-formula
// caricature of all three. Modelling them separately makes every branch
// finite: the terminal steepness becomes a POWER divergence in 1/(1-x)^2,
// which is what "the last sites are hard to fill" actually means, instead of
// an exponential of a tangent.
pub struct PlateauShape {
    sigma: f64,       // d(ln P)/dx across the plateau
    hyst: f64,        // isotherm hysteresis, ln P units
    x_alpha: f64,     // upper edge of the alpha solid-solution branch
    x_beta: f64       // lower edge of the beta branch
}

// The flat, reversible, single-region idealisation: no slope, no hysteresis,
// and phase boundaries pushed to the ends so the plateau covers everything.
// This is what the module used before the branches existed, kept so its cost
// can still be measured by switching it on.
pub fn flat_plateau() -> PlateauShape {
    PlateauShape { sigma: 0.0, hyst: 0.0, x_alpha: 0.0, x_beta: 1.0 }
}

// A sloped plateau with explicit phase boundaries.
pub fn pct_plateau(sigma: f64, hyst: f64, x_alpha: f64, x_beta: f64) -> PlateauShape {
    PlateauShape { sigma: sigma, hyst: hyst, x_alpha: x_alpha, x_beta: x_beta }
}

// ============================================================================
// 1. EQUILIBRIUM PRESSURE
// ============================================================================

// van 't Hoff: ln P_eq = dS/R - dH/(R T), P in bar.
pub fn p_eq_flat(dh: f64, ds: f64, t_k: f64) -> f64 with Mut, Div, Panic {
    if t_k <= 0.0 { return 0.0 }
    exp(ds / r_gas() - dh / (r_gas() * t_k))
}

// The equilibrium pressure across all three regions of the isotherm.
//
//   x <= x_alpha   ALPHA, solid solution. Hydrogen dissolves atomically, so
//                  the loading follows Sieverts' law x ~ sqrt(P) and the
//                  pressure therefore goes as x^2. Anchored to meet the
//                  plateau exactly at x_alpha.
//
//   in between     PLATEAU. van 't Hoff with a linear slope in loading,
//                  centred on the middle of the plateau so that a zero slope
//                  reproduces flat van 't Hoff exactly at every x.
//
//   x >= x_beta    BETA. The mirror of alpha: the remaining sites fill
//                  against a pressure rising as 1/(1-x)^2. Divergent at full
//                  loading, which is the physical statement that a lattice
//                  cannot be overfilled -- but divergent as a POWER, so an
//                  integrator can follow it.
//
// Continuity is by construction: each branch is anchored to the plateau value
// at its own boundary, so the isotherm is continuous at x_alpha and x_beta for
// every sigma. With x_alpha = 0 and x_beta = 1 the branches vanish and this is
// the plateau alone, which is what flat_plateau() selects.
pub fn p_eq_pct(dh: f64, ds: f64, t_k: f64, x: f64, shape: PlateauShape,
                absorbing: bool) -> f64 with Mut, Div, Panic {
    if t_k <= 0.0 { return 0.0 }
    let base = ds / r_gas() - dh / (r_gas() * t_k)
    let hyst_term = if absorbing { 0.0 - shape.hyst * 0.5 } else { shape.hyst * 0.5 }
    let xa = shape.x_alpha
    let xb = shape.x_beta
    let xm = 0.5 * (xa + xb)

    if x <= xa {
        if xa <= 0.0 {
            return exp(base + shape.sigma * (x - xm) + hyst_term)
        }
        let p_a = exp(base + shape.sigma * (xa - xm) + hyst_term)
        var xr = x
        if xr < 0.0 { xr = 0.0 }
        let r = xr / xa
        return p_a * r * r
    }

    if x >= xb {
        if xb >= 1.0 {
            return exp(base + shape.sigma * (x - xm) + hyst_term)
        }
        let p_b = exp(base + shape.sigma * (xb - xm) + hyst_term)
        var den = 1.0 - x
        // A lattice at exactly full loading has an infinite equilibrium
        // pressure. The floor here is a representational limit of f64, not a
        // physical statement, and it is placed far enough out that the beta
        // branch is many orders above any plateau before it is reached.
        if den < 1.0e-9 { den = 1.0e-9 }
        let r = (1.0 - xb) / den
        return p_b * r * r
    }

    exp(base + shape.sigma * (x - xm) + hyst_term)
}

// ============================================================================
// 2. REACTION KINETICS
// ============================================================================
//
// Gkanas et al. eq. 9 and 10, in fractional-loading form. The driving force
// is logarithmic in the pressure ratio for absorption and linear in the
// relative pressure deficit for desorption -- an asymmetry that is in the
// source equations, not a modelling choice made here.

pub fn rate_abs(kin: HydrideKinetics, t_k: f64, p_gas: f64, p_eq: f64, x: f64) -> f64 with Mut, Div, Panic {
    if p_eq <= 0.0 { return 0.0 }
    if p_gas <= p_eq { return 0.0 }
    if x >= 1.0 { return 0.0 }
    let k = kin.c_abs * exp(0.0 - kin.e_abs / (r_gas() * t_k))
    k * ln(p_gas / p_eq) * (1.0 - x)
}

pub fn rate_des(kin: HydrideKinetics, t_k: f64, p_gas: f64, p_eq: f64, x: f64) -> f64 with Mut, Div, Panic {
    if p_eq <= 0.0 { return 0.0 }
    if p_gas >= p_eq { return 0.0 }
    if x <= 0.0 { return 0.0 }
    let k = kin.c_des * exp(0.0 - kin.e_des / (r_gas() * t_k))
    k * ((p_eq - p_gas) / p_eq) * x
}

// ============================================================================
// 3. INVENTORY AND THERMAL MASS
// ============================================================================

pub fn bed_capacity_mol(bed: HydrideBed) -> f64 { bed.m_alloy * bed.cap_mol }

// The heat capacity that must be swung every cycle. The steel term is not a
// refinement: in the seven-stage system the SS 316L shell is 136 kg against
// 29.5 kg of alloy, and the paper's Table 5 puts 88 % of the sensible load
// in the walls. A model that omits it is not slightly optimistic about
// cycle energy; it is wrong by a factor of eight.
pub fn bed_thermal_mass(bed: HydrideBed) -> f64 {
    bed.m_alloy * bed.cp_alloy + bed.m_steel * bed.cp_steel
}

// ============================================================================
// 4. THE COUPLING
// ============================================================================
//
// Two beds and the pipe between them. Bed A is hot and desorbing; bed B is
// cold and absorbing; both see the SAME gas pressure, which is whatever the
// running mass balance in the interconnector makes it. That single shared
// pressure is the whole difference between a cascade and seven independent
// compressors, and it is why the free-ratio product overestimates by two
// orders of magnitude.
//
// State layout, 5 entries:
//   0  x_a    fractional loading of the desorbing bed
//   1  x_b    fractional loading of the absorbing bed
//   2  n_ic   moles of H2 in the interconnector
//   3  t_a    temperature of bed A, K
//   4  t_b    temperature of bed B, K
//
// HYDROGEN IS CONSERVED, and it is CHECKED rather than assumed:
//   x_a * N_a + x_b * N_b + n_ic  is invariant.
// Same discipline as site conservation in chemistry::surface -- a quantity
// the physics guarantees is a quantity the integrator should be made to
// demonstrate, because an integrator that quietly loses hydrogen looks
// exactly like a compressor that works.

pub fn coupling_inventory(s: &[f64; 8], n_a: f64, n_b: f64) -> f64 {
    s[0] * n_a + s[1] * n_b + s[2]
}

pub fn interconnector_pressure(n_ic: f64, v_ic: f64, t_gas: f64) -> f64 with Div, Panic {
    if v_ic <= 0.0 { return 0.0 }
    // n R T / V, in bar (1 bar = 1e5 Pa)
    (n_ic * r_gas() * t_gas) / (v_ic * 100000.0)
}

// One explicit derivative evaluation, written through an output parameter so
// the step loop allocates nothing.
pub fn coupling_derivative(s: &[f64; 8], bed_a: HydrideBed, bed_b: HydrideBed,
                           kin: HydrideKinetics, shape: PlateauShape,
                           v_ic: f64, t_gas: f64,
                           t_fluid_hot: f64, t_fluid_cold: f64,
                           out: &![f64; 8]) with Mut, Div, Panic {
    let x_a = s[0]
    let x_b = s[1]
    let n_ic = s[2]
    let t_a = s[3]
    let t_b = s[4]

    let n_cap_a = bed_capacity_mol(bed_a)
    let n_cap_b = bed_capacity_mol(bed_b)
    let p = interconnector_pressure(n_ic, v_ic, t_gas)

    let peq_a = p_eq_pct(bed_a.dh_des, bed_a.ds_des, t_a, x_a, shape, false)
    let peq_b = p_eq_pct(bed_b.dh_abs, bed_b.ds_abs, t_b, x_b, shape, true)

    let r_des = rate_des(kin, t_a, p, peq_a, x_a)   // fraction per second, >= 0
    let r_abs = rate_abs(kin, t_b, p, peq_b, x_b)   // fraction per second, >= 0

    out[0] = 0.0 - r_des
    out[1] = r_abs
    out[2] = r_des * n_cap_a - r_abs * n_cap_b

    // Desorption is endothermic: it cools bed A against the hot fluid.
    // Absorption is exothermic: it heats bed B against the cold fluid.
    let c_a = bed_thermal_mass(bed_a)
    let c_b = bed_thermal_mass(bed_b)
    if c_a > 0.0 {
        out[3] = (bed_a.ua * (t_fluid_hot - t_a) - bed_a.dh_des * n_cap_a * r_des) / c_a
    } else {
        out[3] = 0.0
    }
    if c_b > 0.0 {
        out[4] = (bed_b.ua * (t_fluid_cold - t_b) + bed_b.dh_abs * n_cap_b * r_abs) / c_b
    } else {
        out[4] = 0.0
    }
    out[5] = 0.0
    out[6] = 0.0
    out[7] = 0.0
}

// RK4 over the coupling, run until the transfer rate falls below `tol`
// (fraction per second) or `max_steps` is spent. Reports, through
// `report`:
//   0  elapsed seconds
//   1  final interconnector pressure, bar
//   2  moles transferred from A to B
//   3  worst relative inventory drift observed (the conservation check)
//   4  1.0 if the transfer converged, 0.0 if it ran out of steps
pub fn run_coupling(s0: &[f64; 8], bed_a: HydrideBed, bed_b: HydrideBed,
                    kin: HydrideKinetics, shape: PlateauShape,
                    v_ic: f64, t_gas: f64,
                    t_fluid_hot: f64, t_fluid_cold: f64,
                    dt: f64, max_steps: i64, tol: f64,
                    out: &![f64; 8], report: &![f64; 8]) with Mut, Div, Panic {
    var y: [f64; 8] = [0.0; 8]
    var y2: [f64; 8] = [0.0; 8]
    var k1: [f64; 8] = [0.0; 8]
    var k2: [f64; 8] = [0.0; 8]
    var k3: [f64; 8] = [0.0; 8]
    var k4: [f64; 8] = [0.0; 8]
    var i: i64 = 0
    while i < 8 { y[i] = s0[i]; i = i + 1 }

    let n_cap_a = bed_capacity_mol(bed_a)
    let n_cap_b = bed_capacity_mol(bed_b)
    let inv0 = coupling_inventory(s0, n_cap_a, n_cap_b)
    let x_b0 = s0[1]

    var elapsed = 0.0
    var worst_drift = 0.0
    var converged = false
    var n: i64 = 0
    // Stop when the transfer has converged instead of spinning out the
    // remaining budget. With max_steps sized for the slowest corner, a
    // fast coupling was running millions of empty iterations after it had
    // already finished -- ~140k steps of work inside a 3e6 budget. This
    // changes no result, only the time taken to reach it, which is what
    // makes a cyclic-steady-state fixed point affordable inside a p-box.
    while n < max_steps && !converged {
        if !converged {
            coupling_derivative(&y, bed_a, bed_b, kin, shape, v_ic, t_gas, t_fluid_hot, t_fluid_cold, &! k1)
            var j: i64 = 0
            while j < 5 { y2[j] = y[j] + 0.5 * dt * k1[j]; j = j + 1 }
            coupling_derivative(&y2, bed_a, bed_b, kin, shape, v_ic, t_gas, t_fluid_hot, t_fluid_cold, &! k2)
            j = 0
            while j < 5 { y2[j] = y[j] + 0.5 * dt * k2[j]; j = j + 1 }
            coupling_derivative(&y2, bed_a, bed_b, kin, shape, v_ic, t_gas, t_fluid_hot, t_fluid_cold, &! k3)
            j = 0
            while j < 5 { y2[j] = y[j] + dt * k3[j]; j = j + 1 }
            coupling_derivative(&y2, bed_a, bed_b, kin, shape, v_ic, t_gas, t_fluid_hot, t_fluid_cold, &! k4)
            j = 0
            while j < 5 {
                y[j] = y[j] + (dt / 6.0) * (k1[j] + 2.0 * k2[j] + 2.0 * k3[j] + k4[j])
                j = j + 1
            }
            if y[0] < 0.0 { y[0] = 0.0 }
            if y[0] > 1.0 { y[0] = 1.0 }
            if y[1] < 0.0 { y[1] = 0.0 }
            if y[1] > 1.0 { y[1] = 1.0 }
            if y[2] < 0.0 { y[2] = 0.0 }
            elapsed = elapsed + dt

            if (n % 64) == 0 {
                let inv = coupling_inventory(&y, n_cap_a, n_cap_b)
                var drift = abs_f64(inv - inv0)
                if inv0 > 0.0 { drift = drift / inv0 }
                if drift > worst_drift { worst_drift = drift }
                coupling_derivative(&y, bed_a, bed_b, kin, shape, v_ic, t_gas, t_fluid_hot, t_fluid_cold, &! k1)
                if abs_f64(k1[1]) < tol && abs_f64(k1[0]) < tol { converged = true }
            }
        }
        n = n + 1
    }

    var c: i64 = 0
    while c < 8 { out[c] = y[c]; c = c + 1 }
    report[0] = elapsed
    report[1] = interconnector_pressure(y[2], v_ic, t_gas)
    report[2] = (y[1] - x_b0) * n_cap_b
    report[3] = worst_drift
    if converged { report[4] = 1.0 } else { report[4] = 0.0 }
    report[5] = y[3]
    report[6] = y[4]
    report[7] = 0.0
}

// ============================================================================
// 5. THE SEVEN-STAGE SYSTEM OF GKANAS ET AL. 2020, AS MEASURED
// ============================================================================
//
// Table 3 verbatim. Nothing here is representative, fitted or chosen: these
// are the authors' own Sievert-apparatus measurements, and the ladder runs
// DOWNWARD in enthalpy because van 't Hoff requires the high-pressure stage
// to carry the lowest one.
//
// NEGATIVE CONSTANTS WOULD BE `var`; all of these are positive, so `fn`
// returning a literal is used, which also keeps them inlinable.

pub fn gkanas_dh_abs(stage: i64) -> f64 {
    if stage == 0 { 25242.0 } else if stage == 1 { 21466.0 } else if stage == 2 { 20354.0 }
    else if stage == 3 { 19991.0 } else if stage == 4 { 18198.0 } else if stage == 5 { 16232.0 }
    else if stage == 6 { 14702.0 } else { 0.0 }
}
pub fn gkanas_ds_abs(stage: i64) -> f64 {
    if stage == 0 { 104.6 } else if stage == 1 { 94.7 } else if stage == 2 { 101.1 }
    else if stage == 3 { 100.2 } else if stage == 4 { 98.12 } else if stage == 5 { 98.05 }
    else if stage == 6 { 98.1 } else { 0.0 }
}
pub fn gkanas_dh_des(stage: i64) -> f64 {
    if stage == 0 { 28195.0 } else if stage == 1 { 26133.0 } else if stage == 2 { 24823.0 }
    else if stage == 3 { 20252.0 } else if stage == 4 { 19856.0 } else if stage == 5 { 19125.0 }
    else if stage == 6 { 18916.0 } else { 0.0 }
}
pub fn gkanas_ds_des(stage: i64) -> f64 {
    if stage == 0 { 106.8 } else if stage == 1 { 107.1 } else if stage == 2 { 108.7 }
    else if stage == 3 { 100.8 } else if stage == 4 { 101.4 } else if stage == 5 { 101.5 }
    else if stage == 6 { 106.2 } else { 0.0 }
}

// Geometry and inventory, also from the paper: 31 kg of AB5 in stage 1 and
// 29.5 kg of AB2 in each of the rest, a 136 kg SS 316L shell per stage, and
// 0.425 kg H2 delivered per cycle. The capacity below is DERIVED from those
// two facts rather than assumed: 0.425 kg is 210.8 mol H2, and a stage that
// must pass it holds that much at full swing.
pub fn gkanas_alloy_mass(stage: i64) -> f64 { if stage == 0 { 31.0 } else { 29.5 } }
pub fn gkanas_steel_mass() -> f64 { 136.0 }
pub fn gkanas_h2_per_cycle_kg() -> f64 { 0.425 }
pub fn gkanas_capacity_mol_per_kg() -> f64 {
    (gkanas_h2_per_cycle_kg() / h2_molar_mass()) / 29.5
}

pub fn gkanas_bed(stage: i64, cp_alloy: f64, cp_steel: f64, ua: f64) -> HydrideBed {
    HydrideBed {
        dh_abs: gkanas_dh_abs(stage), ds_abs: gkanas_ds_abs(stage),
        dh_des: gkanas_dh_des(stage), ds_des: gkanas_ds_des(stage),
        m_alloy: gkanas_alloy_mass(stage), m_steel: gkanas_steel_mass(),
        cap_mol: gkanas_capacity_mol_per_kg(),
        cp_alloy: cp_alloy, cp_steel: cp_steel, ua: ua
    }
}

// ============================================================================
// 6. TESTS
// ============================================================================

// --- 6.1 van 't Hoff against the measured Table 3 ---
//
// S1 absorbing at 10 C: exp(104.6/R - 25242/(R*283.15)) = 6.4136 bar.
// S7 absorbing at 10 C: exp(98.1/R - 14702/(R*283.15)) = 258.22 bar.
// The second is forty times the first, at the same temperature, purely
// because its enthalpy is 10.5 kJ/mol lower -- which is the cascade's
// entire design principle, and is invisible in a ladder that runs the
// other way.
pub fn test_vant_hoff_matches_table3() -> bool with Mut, Div, Panic {
    let p1 = p_eq_flat(gkanas_dh_abs(0), gkanas_ds_abs(0), 283.15)
    let p7 = p_eq_flat(gkanas_dh_abs(6), gkanas_ds_abs(6), 283.15)
    let ladder_descends =
        gkanas_dh_abs(0) > gkanas_dh_abs(1) && gkanas_dh_abs(1) > gkanas_dh_abs(2)
        && gkanas_dh_abs(2) > gkanas_dh_abs(3) && gkanas_dh_abs(3) > gkanas_dh_abs(4)
        && gkanas_dh_abs(4) > gkanas_dh_abs(5) && gkanas_dh_abs(5) > gkanas_dh_abs(6)
    check_near(p1, 6.4136, 0.01) && check_near(p7, 258.22, 0.5) && p7 > p1 && ladder_descends
}

// --- 6.2 hysteresis is measured, not lumped ---
//
// Every stage desorbs at a higher enthalpy than it absorbs, so at a common
// temperature the desorption plateau sits above the absorption plateau.
// That gap is the hysteresis the ratio-chain model replaces with a fitted
// efficiency.
pub fn test_hysteresis_is_per_stage() -> bool with Mut, Div, Panic {
    var all_positive = true
    var s: i64 = 0
    while s < 7 {
        if gkanas_dh_des(s) <= gkanas_dh_abs(s) { all_positive = false }
        s = s + 1
    }
    let gap_s1 = gkanas_dh_des(0) - gkanas_dh_abs(0)
    let gap_s7 = gkanas_dh_des(6) - gkanas_dh_abs(6)
    all_positive && check_near(gap_s1, 2953.0, 1.0) && check_near(gap_s7, 4214.0, 1.0) && gap_s7 > gap_s1
}

// --- 6.3 the plateau-slope term is exactly neutral at half loading ---
pub fn test_plateau_slope_neutral_at_half() -> bool with Mut, Div, Panic {
    let shape = pct_plateau(0.35, 0.0, 0.10, 0.90)
    let flat = p_eq_flat(20000.0, 100.0, 313.15)
    let sloped = p_eq_pct(20000.0, 100.0, 313.15, 0.5, shape, true)
    let low = p_eq_pct(20000.0, 100.0, 313.15, 0.2, shape, true)
    let high = p_eq_pct(20000.0, 100.0, 313.15, 0.8, shape, true)
    check_near(sloped, flat, 1.0e-9) && low < flat && high > flat
}

// --- 6.4 the free-ratio product is the model this module rejects ---
//
// Multiplying each stage's own P_des(80 C)/P_abs(10 C) over seven stages
// gives a compression ratio in the thousands, against the paper's 18.7.
// This test asserts that discrepancy rather than hiding it: it is the
// measurement that motivates the coupled model, and if a future change
// made the free product plausible, that would mean the thermodynamics had
// been altered and this file should fail.
pub fn test_free_ratio_product_is_absurd() -> bool with Mut, Div, Panic {
    var product = 1.0
    var s: i64 = 0
    while s < 7 {
        let pa = p_eq_flat(gkanas_dh_abs(s), gkanas_ds_abs(s), 283.15)
        let pd = p_eq_flat(gkanas_dh_des(s), gkanas_ds_des(s), 353.15)
        if pa > 0.0 { product = product * (pd / pa) }
        s = s + 1
    }
    product > 1000.0
}

// --- 6.5 hydrogen is conserved through a coupling ---
pub fn test_coupling_conserves_hydrogen() -> bool with Mut, Div, Panic {
    let bed_a = gkanas_bed(0, 419.0, 500.0, 400.0)
    let bed_b = gkanas_bed(1, 419.0, 500.0, 400.0)
    let kin = HydrideKinetics { c_abs: 59.187, e_abs: 21179.6, c_des: 9.57, e_des: 16420.0 }
    let shape = flat_plateau()

    var s0: [f64; 8] = [0.0; 8]
    s0[0] = 1.0        // A fully loaded
    s0[1] = 0.0        // B empty
    s0[2] = 0.5        // a little gas already in the pipe
    s0[3] = 353.15
    s0[4] = 283.15

    var out: [f64; 8] = [0.0; 8]
    var rep: [f64; 8] = [0.0; 8]
    run_coupling(&s0, bed_a, bed_b, kin, shape, 0.05, 300.0, 353.15, 283.15,
                 0.05, 40000 as i64, 1.0e-9, &! out, &! rep)

    let drift_ok = rep[3] < 1.0e-9
    let moved = rep[2] > 0.0
    let physical = out[0] >= 0.0 && out[0] <= 1.0 && out[1] >= 0.0 && out[1] <= 1.0
    drift_ok && moved && physical
}

pub fn main() -> i32 with Mut, Div, Panic, IO {
    var p: i64 = 0
    var f: i64 = 0
    if test_vant_hoff_matches_table3() { p = p + 1 } else { f = f + 1; println("FAIL vant_hoff_matches_table3") }
    if test_hysteresis_is_per_stage() { p = p + 1 } else { f = f + 1; println("FAIL hysteresis_is_per_stage") }
    if test_plateau_slope_neutral_at_half() { p = p + 1 } else { f = f + 1; println("FAIL plateau_slope_neutral_at_half") }
    if test_free_ratio_product_is_absurd() { p = p + 1 } else { f = f + 1; println("FAIL free_ratio_product_is_absurd") }
    if test_coupling_conserves_hydrogen() { p = p + 1 } else { f = f + 1; println("FAIL coupling_conserves_hydrogen") }
    print("MHHC: ") print(p) print(" passed, ") print(f) println(" failed")
    if f == 0 { println("MHHC ALL PASS") return 0 }
    1
}
