//! stdlib/systems/lorenz_i256_rho_x_minus_y_bridge.sio
//!
//! Portable composition bridge for the Lorenz y-derivative term fragment
//! rho*x - y, restricted to z=0 so no x*z product is claimed. This composes
//! decimal-limb small-scalar multiplication with the signed-delta bridge.

use systems::lorenz_i256_limb_scale_bridge::*
use systems::lorenz_i256_signed_delta_bridge::*

pub fn lorenz_i256_rho_x_term_limb(
    x0: i64,
    x1: i64,
    x2: i64,
    x3: i64,
    limb_index: i64) -> i64 with Div {
    return lorenz_dec4_mul_small_limb(x0, x1, x2, x3, 28, limb_index)
}

pub fn lorenz_i256_rho_x_minus_y_term_sign(
    x0: i64,
    x1: i64,
    x2: i64,
    x3: i64,
    y0: i64,
    y1: i64,
    y2: i64,
    y3: i64) -> i64 with Div {
    let r0 = lorenz_i256_rho_x_term_limb(x0, x1, x2, x3, 0)
    let r1 = lorenz_i256_rho_x_term_limb(x0, x1, x2, x3, 1)
    let r2 = lorenz_i256_rho_x_term_limb(x0, x1, x2, x3, 2)
    let r3 = lorenz_i256_rho_x_term_limb(x0, x1, x2, x3, 3)
    if r0 < 0 { return 0 - 2 }
    if r1 < 0 { return 0 - 2 }
    if r2 < 0 { return 0 - 2 }
    if r3 < 0 { return 0 - 2 }
    return lorenz_i256_signed_delta_sign(r0, r1, r2, r3, y0, y1, y2, y3)
}

pub fn lorenz_i256_rho_x_minus_y_term_abs_limb(
    x0: i64,
    x1: i64,
    x2: i64,
    x3: i64,
    y0: i64,
    y1: i64,
    y2: i64,
    y3: i64,
    limb_index: i64) -> i64 with Div {
    let r0 = lorenz_i256_rho_x_term_limb(x0, x1, x2, x3, 0)
    let r1 = lorenz_i256_rho_x_term_limb(x0, x1, x2, x3, 1)
    let r2 = lorenz_i256_rho_x_term_limb(x0, x1, x2, x3, 2)
    let r3 = lorenz_i256_rho_x_term_limb(x0, x1, x2, x3, 3)
    if r0 < 0 { return 0 - 1 }
    if r1 < 0 { return 0 - 1 }
    if r2 < 0 { return 0 - 1 }
    if r3 < 0 { return 0 - 1 }
    return lorenz_i256_signed_delta_abs_limb(r0, r1, r2, r3, y0, y1, y2, y3, limb_index)
}

pub fn lorenz_i256_rho_x_minus_y_term_check(
    x0: i64,
    x1: i64,
    x2: i64,
    x3: i64,
    y0: i64,
    y1: i64,
    y2: i64,
    y3: i64,
    expected_sign: i64,
    expected_l0: i64,
    expected_l1: i64,
    expected_l2: i64,
    expected_l3: i64) -> i64 with Div {
    let sign = lorenz_i256_rho_x_minus_y_term_sign(x0, x1, x2, x3, y0, y1, y2, y3)
    let r0 = lorenz_i256_rho_x_minus_y_term_abs_limb(x0, x1, x2, x3, y0, y1, y2, y3, 0)
    let r1 = lorenz_i256_rho_x_minus_y_term_abs_limb(x0, x1, x2, x3, y0, y1, y2, y3, 1)
    let r2 = lorenz_i256_rho_x_minus_y_term_abs_limb(x0, x1, x2, x3, y0, y1, y2, y3, 2)
    let r3 = lorenz_i256_rho_x_minus_y_term_abs_limb(x0, x1, x2, x3, y0, y1, y2, y3, 3)
    if sign != expected_sign { return 0 }
    if r0 != expected_l0 { return 0 }
    if r1 != expected_l1 { return 0 }
    if r2 != expected_l2 { return 0 }
    if r3 != expected_l3 { return 0 }
    return 1
}

pub fn lorenz_i256_rho_x_minus_y_bridge_receipt_check(
    positive_term_ok: i64,
    negative_term_ok: i64,
    zero_term_ok: i64,
    invalid_limb_rejected: i64,
    scale_anchor_ok: i64,
    delta_anchor_ok: i64,
    target_integer_width: i64,
    limb_base: i64,
    native_i256_evidence_mask: i64,
    imported_runtime_evidence_mask: i64,
    bridge_status: i64) -> i64 {
    if positive_term_ok != 1 { return 0 - 1 }
    if negative_term_ok != 1 { return 0 - 1 }
    if zero_term_ok != 1 { return 0 - 1 }
    if invalid_limb_rejected != 1 { return 0 - 1 }
    if scale_anchor_ok != 1 { return 0 - 1 }
    if delta_anchor_ok != 1 { return 0 - 1 }
    if target_integer_width != 256 { return 0 - 1 }
    if limb_base != 1000000000 { return 0 - 1 }
    if native_i256_evidence_mask != 0 { return 0 - 1 }
    if imported_runtime_evidence_mask != 0 { return 0 - 1 }
    if bridge_status != 107 { return 0 - 1 }
    return 570239184
}

pub fn lorenz_i256_rho_x_minus_y_bridge_audit_fingerprint(
    artifact_fp: i64,
    instance_fp: i64,
    certificate_fp: i64,
    scale_fp: i64,
    scale_audit_fp: i64,
    delta_fp: i64,
    delta_audit_fp: i64,
    positive_term_ok: i64,
    negative_term_ok: i64,
    zero_term_ok: i64,
    invalid_limb_rejected: i64,
    target_integer_width: i64,
    limb_base: i64,
    native_i256_evidence_mask: i64,
    imported_runtime_evidence_mask: i64,
    public_claim_mask: i64,
    formal_theorem_ready: i64,
    bridge_status: i64,
    ok_mask: i64) -> i64 {
    if artifact_fp != 570239184 { return 0 - 1 }
    if instance_fp != 314762905 { return 0 - 1 }
    if certificate_fp != 726591438 { return 0 - 1 }
    if scale_fp != 734815269 { return 0 - 1 }
    if scale_audit_fp != 216903584 { return 0 - 1 }
    if delta_fp != 492681735 { return 0 - 1 }
    if delta_audit_fp != 837260419 { return 0 - 1 }
    if positive_term_ok != 1 { return 0 - 1 }
    if negative_term_ok != 1 { return 0 - 1 }
    if zero_term_ok != 1 { return 0 - 1 }
    if invalid_limb_rejected != 1 { return 0 - 1 }
    if target_integer_width != 256 { return 0 - 1 }
    if limb_base != 1000000000 { return 0 - 1 }
    if native_i256_evidence_mask != 0 { return 0 - 1 }
    if imported_runtime_evidence_mask != 0 { return 0 - 1 }
    if public_claim_mask != 0 { return 0 - 1 }
    if formal_theorem_ready != 0 { return 0 - 1 }
    if bridge_status != 107 { return 0 - 1 }
    if ok_mask != 1023 { return 0 - 1 }
    return 908416527
}
