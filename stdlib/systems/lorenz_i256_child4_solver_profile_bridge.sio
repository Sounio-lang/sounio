//! stdlib/systems/lorenz_i256_child4_solver_profile_bridge.sio
//!
//! Bridge between the shared solver proof-profile gate and the Lorenz i256
//! child-4 boundary-gluing input guard. This records that the Lorenz numeric
//! receipt is admissible only as a private checked artifact under proof format
//! 6. It does not promote a public theorem, prove boundary gluing, discharge
//! child-4, certify a finite cover, or assert a global flowpipe claim.

pub fn lorenz_i256_cover_child4_solver_profile_bridge_check(
    solver_proof_profile_fp: i64,
    solver_proof_profile_audit_fp: i64,
    child4_boundary_gluing_input_guard_fp: i64,
    child4_boundary_gluing_input_guard_audit_fp: i64,
    solver_domain: i64,
    proof_format: i64,
    accepted_profile_mask: i64,
    rejected_profile_mask: i64,
    lorenz_numeric_gate: i64,
    private_acceptance_level: i64,
    formal_theorem_ready: i64,
    public_claim_mask: i64,
    global_flowpipe_claim_mask: i64,
    boundary_gluing_proof_mask: i64,
    child4_discharge_mask: i64,
    finite_cover_certificate_mask: i64,
    bridge_status: i64) -> i64 with Mod {
    var anchor_mask: i64 = 0
    if solver_proof_profile_fp == 964210753 {
        if solver_proof_profile_audit_fp == 526184309 {
            anchor_mask = anchor_mask + 1
        }
    }
    if child4_boundary_gluing_input_guard_fp == 508913246 {
        if child4_boundary_gluing_input_guard_audit_fp == 672184905 {
            anchor_mask = anchor_mask + 2
        }
    }
    if solver_domain == 4 { anchor_mask = anchor_mask + 4 }
    if proof_format == 6 { anchor_mask = anchor_mask + 8 }
    if bridge_status == 89 { anchor_mask = anchor_mask + 16 }

    let profile_status: i64 = 88
    let guard_status: i64 = 87
    let solver_profile_bridge_mask: i64 = 31
    let lorenz_receipt_family_mask: i64 = 16
    let bridge_dependency_mask: i64 = 31
    let checked_private_receipt_mask: i64 = 1
    let public_theorem_ready_mask: i64 = 0
    let global_promotion_ready_mask: i64 = 0
    let solver_bridge_next_action_mask: i64 = 31

    var bridge_ok: i64 = 1
    if profile_status != 88 { bridge_ok = 0 }
    if guard_status != 87 { bridge_ok = 0 }
    if accepted_profile_mask != 15 { bridge_ok = 0 }
    if rejected_profile_mask != 48 { bridge_ok = 0 }
    if lorenz_numeric_gate != 1 { bridge_ok = 0 }
    if private_acceptance_level != 2 { bridge_ok = 0 }
    if solver_profile_bridge_mask != 31 { bridge_ok = 0 }
    if lorenz_receipt_family_mask != 16 { bridge_ok = 0 }
    if bridge_dependency_mask != 31 { bridge_ok = 0 }
    if checked_private_receipt_mask != 1 { bridge_ok = 0 }
    if public_theorem_ready_mask != 0 { bridge_ok = 0 }
    if global_promotion_ready_mask != 0 { bridge_ok = 0 }
    if solver_bridge_next_action_mask != 31 { bridge_ok = 0 }

    var nonclaim_ok: i64 = 1
    if formal_theorem_ready != 0 { nonclaim_ok = 0 }
    if public_claim_mask != 0 { nonclaim_ok = 0 }
    if global_flowpipe_claim_mask != 0 { nonclaim_ok = 0 }
    if boundary_gluing_proof_mask != 0 { nonclaim_ok = 0 }
    if child4_discharge_mask != 0 { nonclaim_ok = 0 }
    if finite_cover_certificate_mask != 0 { nonclaim_ok = 0 }

    var ok_mask: i64 = 0
    if anchor_mask == 31 { ok_mask = ok_mask + 1 }
    if bridge_ok == 1 { ok_mask = ok_mask + 2 }
    if nonclaim_ok == 1 { ok_mask = ok_mask + 4 }
    if checked_private_receipt_mask == 1 { ok_mask = ok_mask + 8 }
    if public_theorem_ready_mask == 0 { ok_mask = ok_mask + 16 }
    if global_promotion_ready_mask == 0 { ok_mask = ok_mask + 32 }
    if solver_bridge_next_action_mask == 31 { ok_mask = ok_mask + 64 }
    if bridge_status == 89 { ok_mask = ok_mask + 128 }

    if ok_mask != 255 { return 0 - 1 }
    return 784215609
}

pub fn lorenz_i256_cover_child4_solver_profile_bridge_audit_fingerprint(
    artifact_fp: i64,
    instance_fp: i64,
    certificate_fp: i64,
    solver_proof_profile_fp: i64,
    solver_proof_profile_audit_fp: i64,
    child4_boundary_gluing_input_guard_fp: i64,
    child4_boundary_gluing_input_guard_audit_fp: i64,
    solver_domain: i64,
    proof_format: i64,
    profile_status: i64,
    guard_status: i64,
    accepted_profile_mask: i64,
    rejected_profile_mask: i64,
    lorenz_numeric_gate: i64,
    private_acceptance_level: i64,
    solver_profile_bridge_mask: i64,
    lorenz_receipt_family_mask: i64,
    bridge_dependency_mask: i64,
    checked_private_receipt_mask: i64,
    public_theorem_ready_mask: i64,
    global_promotion_ready_mask: i64,
    solver_bridge_next_action_mask: i64,
    formal_theorem_ready: i64,
    public_claim_mask: i64,
    global_flowpipe_claim_mask: i64,
    boundary_gluing_proof_mask: i64,
    child4_discharge_mask: i64,
    finite_cover_certificate_mask: i64,
    bridge_status: i64,
    ok_mask: i64) -> i64 with Mod {
    if artifact_fp != 784215609 { return 0 - 1 }
    if instance_fp != 284903761 { return 0 - 1 }
    if certificate_fp != 731582406 { return 0 - 1 }
    if solver_proof_profile_fp != 964210753 { return 0 - 1 }
    if solver_proof_profile_audit_fp != 526184309 { return 0 - 1 }
    if child4_boundary_gluing_input_guard_fp != 508913246 { return 0 - 1 }
    if child4_boundary_gluing_input_guard_audit_fp != 672184905 { return 0 - 1 }
    if solver_domain != 4 { return 0 - 1 }
    if proof_format != 6 { return 0 - 1 }
    if profile_status != 88 { return 0 - 1 }
    if guard_status != 87 { return 0 - 1 }
    if accepted_profile_mask != 15 { return 0 - 1 }
    if rejected_profile_mask != 48 { return 0 - 1 }
    if lorenz_numeric_gate != 1 { return 0 - 1 }
    if private_acceptance_level != 2 { return 0 - 1 }
    if solver_profile_bridge_mask != 31 { return 0 - 1 }
    if lorenz_receipt_family_mask != 16 { return 0 - 1 }
    if bridge_dependency_mask != 31 { return 0 - 1 }
    if checked_private_receipt_mask != 1 { return 0 - 1 }
    if public_theorem_ready_mask != 0 { return 0 - 1 }
    if global_promotion_ready_mask != 0 { return 0 - 1 }
    if solver_bridge_next_action_mask != 31 { return 0 - 1 }
    if formal_theorem_ready != 0 { return 0 - 1 }
    if public_claim_mask != 0 { return 0 - 1 }
    if global_flowpipe_claim_mask != 0 { return 0 - 1 }
    if boundary_gluing_proof_mask != 0 { return 0 - 1 }
    if child4_discharge_mask != 0 { return 0 - 1 }
    if finite_cover_certificate_mask != 0 { return 0 - 1 }
    if bridge_status != 89 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }
    return 639104872
}
