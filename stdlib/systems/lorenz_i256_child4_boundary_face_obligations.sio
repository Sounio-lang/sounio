//! stdlib/systems/lorenz_i256_child4_boundary_face_obligations.sio
//!
//! Per-face boundary-gluing obligations for child-4 in the Lorenz i256 cover
//! lane. This refines the proof skeleton into five face-local obligations, but
//! does not prove gluing, discharge, finite-cover certification, or any global
//! flowpipe claim.

pub fn lorenz_i256_cover_child4_boundary_face_obligations_check(
    child4_boundary_gluing_proof_skeleton_fp: i64,
    child4_boundary_gluing_proof_skeleton_audit_fp: i64,
    child4_boundary_gluing_obligation_seed_fp: i64,
    child4_boundary_gluing_obligation_seed_audit_fp: i64,
    boundary_gluing_obligation_mask: i64,
    boundary_gluing_pending_mask: i64,
    face0_obligation_mask: i64,
    face1_obligation_mask: i64,
    face2_obligation_mask: i64,
    face3_obligation_mask: i64,
    face4_obligation_mask: i64,
    boundary_gluing_verified_mask: i64,
    boundary_gluing_proof_mask: i64,
    finite_cover_certificate_mask: i64,
    global_certificate_candidate_mask: i64,
    global_flowpipe_claim_mask: i64,
    face_obligation_status: i64) -> i64 with Mod {
    var anchor_mask: i64 = 0
    if child4_boundary_gluing_proof_skeleton_fp == 836470291 {
        if child4_boundary_gluing_proof_skeleton_audit_fp == 190735846 {
            anchor_mask = anchor_mask + 1
        }
    }
    if child4_boundary_gluing_obligation_seed_fp == 604182937 {
        if child4_boundary_gluing_obligation_seed_audit_fp == 218570463 {
            anchor_mask = anchor_mask + 2
        }
    }
    if boundary_gluing_obligation_mask == 31 { anchor_mask = anchor_mask + 4 }
    if boundary_gluing_pending_mask == 31 { anchor_mask = anchor_mask + 8 }
    if face_obligation_status == 80 { anchor_mask = anchor_mask + 16 }

    let boundary_face_count: i64 = 5
    let face_obligation_mask: i64 = 31
    let face_topology_mask: i64 = 31
    let face_orientation_mask: i64 = 31
    let face_adjacency_mask: i64 = 31
    let face_trace_mask: i64 = 31
    let face_verified_mask: i64 = 0
    let face_proof_mask: i64 = 0
    let solver_face_action_mask: i64 = 31
    let ready_for_boundary_gluing_proof_mask: i64 = 0

    var face_bits_ok: i64 = 1
    if face0_obligation_mask != 1 { face_bits_ok = 0 }
    if face1_obligation_mask != 2 { face_bits_ok = 0 }
    if face2_obligation_mask != 4 { face_bits_ok = 0 }
    if face3_obligation_mask != 8 { face_bits_ok = 0 }
    if face4_obligation_mask != 16 { face_bits_ok = 0 }

    var obligation_ok: i64 = 1
    if boundary_face_count != 5 { obligation_ok = 0 }
    if face_obligation_mask != 31 { obligation_ok = 0 }
    if face_topology_mask != 31 { obligation_ok = 0 }
    if face_orientation_mask != 31 { obligation_ok = 0 }
    if face_adjacency_mask != 31 { obligation_ok = 0 }
    if face_trace_mask != 31 { obligation_ok = 0 }
    if face_verified_mask != 0 { obligation_ok = 0 }
    if face_proof_mask != 0 { obligation_ok = 0 }
    if solver_face_action_mask != 31 { obligation_ok = 0 }
    if ready_for_boundary_gluing_proof_mask != 0 { obligation_ok = 0 }

    var nonclaim_ok: i64 = 1
    if boundary_gluing_verified_mask != 0 { nonclaim_ok = 0 }
    if boundary_gluing_proof_mask != 0 { nonclaim_ok = 0 }
    if finite_cover_certificate_mask != 0 { nonclaim_ok = 0 }
    if global_certificate_candidate_mask != 0 { nonclaim_ok = 0 }
    if global_flowpipe_claim_mask != 0 { nonclaim_ok = 0 }

    var ok_mask: i64 = 0
    if anchor_mask == 31 { ok_mask = ok_mask + 1 }
    if face_bits_ok == 1 { ok_mask = ok_mask + 2 }
    if obligation_ok == 1 { ok_mask = ok_mask + 4 }
    if nonclaim_ok == 1 { ok_mask = ok_mask + 8 }
    if boundary_gluing_obligation_mask == 31 { ok_mask = ok_mask + 16 }
    if face_obligation_mask == 31 { ok_mask = ok_mask + 32 }
    if ready_for_boundary_gluing_proof_mask == 0 { ok_mask = ok_mask + 64 }
    if face_obligation_status == 80 { ok_mask = ok_mask + 128 }

    if ok_mask != 255 { return 0 - 1 }
    return 458306927
}

pub fn lorenz_i256_cover_child4_boundary_face_obligations_audit_fingerprint(
    artifact_fp: i64,
    instance_fp: i64,
    certificate_fp: i64,
    child4_boundary_gluing_proof_skeleton_fp: i64,
    child4_boundary_gluing_proof_skeleton_audit_fp: i64,
    child4_boundary_gluing_obligation_seed_fp: i64,
    child4_boundary_gluing_obligation_seed_audit_fp: i64,
    boundary_gluing_obligation_mask: i64,
    boundary_gluing_pending_mask: i64,
    boundary_face_count: i64,
    face0_obligation_mask: i64,
    face1_obligation_mask: i64,
    face2_obligation_mask: i64,
    face3_obligation_mask: i64,
    face4_obligation_mask: i64,
    face_obligation_mask: i64,
    face_topology_mask: i64,
    face_orientation_mask: i64,
    face_adjacency_mask: i64,
    face_trace_mask: i64,
    face_verified_mask: i64,
    face_proof_mask: i64,
    solver_face_action_mask: i64,
    ready_for_boundary_gluing_proof_mask: i64,
    boundary_gluing_verified_mask: i64,
    boundary_gluing_proof_mask: i64,
    finite_cover_certificate_mask: i64,
    global_certificate_candidate_mask: i64,
    global_flowpipe_claim_mask: i64,
    face_obligation_status: i64,
    ok_mask: i64) -> i64 with Mod {
    if artifact_fp != 458306927 { return 0 - 1 }
    if instance_fp != 328691604 { return 0 - 1 }
    if certificate_fp != 948157216 { return 0 - 1 }
    if child4_boundary_gluing_proof_skeleton_fp != 836470291 { return 0 - 1 }
    if child4_boundary_gluing_proof_skeleton_audit_fp != 190735846 { return 0 - 1 }
    if child4_boundary_gluing_obligation_seed_fp != 604182937 { return 0 - 1 }
    if child4_boundary_gluing_obligation_seed_audit_fp != 218570463 { return 0 - 1 }
    if boundary_gluing_obligation_mask != 31 { return 0 - 1 }
    if boundary_gluing_pending_mask != 31 { return 0 - 1 }
    if boundary_face_count != 5 { return 0 - 1 }
    if face0_obligation_mask != 1 { return 0 - 1 }
    if face1_obligation_mask != 2 { return 0 - 1 }
    if face2_obligation_mask != 4 { return 0 - 1 }
    if face3_obligation_mask != 8 { return 0 - 1 }
    if face4_obligation_mask != 16 { return 0 - 1 }
    if face_obligation_mask != 31 { return 0 - 1 }
    if face_topology_mask != 31 { return 0 - 1 }
    if face_orientation_mask != 31 { return 0 - 1 }
    if face_adjacency_mask != 31 { return 0 - 1 }
    if face_trace_mask != 31 { return 0 - 1 }
    if face_verified_mask != 0 { return 0 - 1 }
    if face_proof_mask != 0 { return 0 - 1 }
    if solver_face_action_mask != 31 { return 0 - 1 }
    if ready_for_boundary_gluing_proof_mask != 0 { return 0 - 1 }
    if boundary_gluing_verified_mask != 0 { return 0 - 1 }
    if boundary_gluing_proof_mask != 0 { return 0 - 1 }
    if finite_cover_certificate_mask != 0 { return 0 - 1 }
    if global_certificate_candidate_mask != 0 { return 0 - 1 }
    if global_flowpipe_claim_mask != 0 { return 0 - 1 }
    if face_obligation_status != 80 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }
    return 766184391
}
