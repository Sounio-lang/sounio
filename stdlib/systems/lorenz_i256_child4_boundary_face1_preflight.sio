//! stdlib/systems/lorenz_i256_child4_boundary_face1_preflight.sio
//!
//! Face-1 boundary-gluing preflight for child-4 in the Lorenz i256 cover lane.
//! This extends the face-local preflight chain after face-0, but does not verify
//! the face, prove gluing, discharge child-4, or certify any finite-cover/global
//! flowpipe claim.

pub fn lorenz_i256_cover_child4_boundary_face1_preflight_check(
    child4_boundary_face0_preflight_fp: i64,
    child4_boundary_face0_preflight_audit_fp: i64,
    child4_boundary_face_obligations_fp: i64,
    child4_boundary_face_obligations_audit_fp: i64,
    boundary_gluing_obligation_mask: i64,
    face_obligation_mask: i64,
    prior_face_preflight_mask: i64,
    selected_face_index: i64,
    selected_face_mask: i64,
    face1_obligation_mask: i64,
    face1_verified_mask: i64,
    face1_proof_mask: i64,
    boundary_gluing_verified_mask: i64,
    boundary_gluing_proof_mask: i64,
    finite_cover_certificate_mask: i64,
    global_certificate_candidate_mask: i64,
    global_flowpipe_claim_mask: i64,
    face1_preflight_status: i64) -> i64 with Mod {
    var anchor_mask: i64 = 0
    if child4_boundary_face0_preflight_fp == 629184705 {
        if child4_boundary_face0_preflight_audit_fp == 884062113 {
            anchor_mask = anchor_mask + 1
        }
    }
    if child4_boundary_face_obligations_fp == 458306927 {
        if child4_boundary_face_obligations_audit_fp == 766184391 {
            anchor_mask = anchor_mask + 2
        }
    }
    if boundary_gluing_obligation_mask == 31 { anchor_mask = anchor_mask + 4 }
    if face_obligation_mask == 31 { anchor_mask = anchor_mask + 8 }
    if face1_preflight_status == 82 { anchor_mask = anchor_mask + 16 }

    let boundary_face_count: i64 = 5
    let face1_topology_mask: i64 = 2
    let face1_orientation_mask: i64 = 2
    let face1_adjacency_mask: i64 = 2
    let face1_trace_mask: i64 = 2
    let face1_dependency_mask: i64 = 3
    let face1_preflight_mask: i64 = 2
    let face_preflight_progress_mask: i64 = 3
    let face1_pending_proof_mask: i64 = 2
    let solver_face1_action_mask: i64 = 2
    let ready_for_face1_proof_mask: i64 = 0

    var selected_face_ok: i64 = 1
    if prior_face_preflight_mask != 1 { selected_face_ok = 0 }
    if selected_face_index != 1 { selected_face_ok = 0 }
    if selected_face_mask != 2 { selected_face_ok = 0 }
    if face1_obligation_mask != 2 { selected_face_ok = 0 }

    var preflight_ok: i64 = 1
    if boundary_face_count != 5 { preflight_ok = 0 }
    if face1_topology_mask != 2 { preflight_ok = 0 }
    if face1_orientation_mask != 2 { preflight_ok = 0 }
    if face1_adjacency_mask != 2 { preflight_ok = 0 }
    if face1_trace_mask != 2 { preflight_ok = 0 }
    if face1_dependency_mask != 3 { preflight_ok = 0 }
    if face1_preflight_mask != 2 { preflight_ok = 0 }
    if face_preflight_progress_mask != 3 { preflight_ok = 0 }
    if face1_pending_proof_mask != 2 { preflight_ok = 0 }
    if solver_face1_action_mask != 2 { preflight_ok = 0 }
    if ready_for_face1_proof_mask != 0 { preflight_ok = 0 }

    var nonclaim_ok: i64 = 1
    if face1_verified_mask != 0 { nonclaim_ok = 0 }
    if face1_proof_mask != 0 { nonclaim_ok = 0 }
    if boundary_gluing_verified_mask != 0 { nonclaim_ok = 0 }
    if boundary_gluing_proof_mask != 0 { nonclaim_ok = 0 }
    if finite_cover_certificate_mask != 0 { nonclaim_ok = 0 }
    if global_certificate_candidate_mask != 0 { nonclaim_ok = 0 }
    if global_flowpipe_claim_mask != 0 { nonclaim_ok = 0 }

    var ok_mask: i64 = 0
    if anchor_mask == 31 { ok_mask = ok_mask + 1 }
    if selected_face_ok == 1 { ok_mask = ok_mask + 2 }
    if preflight_ok == 1 { ok_mask = ok_mask + 4 }
    if nonclaim_ok == 1 { ok_mask = ok_mask + 8 }
    if boundary_gluing_obligation_mask == 31 { ok_mask = ok_mask + 16 }
    if face_preflight_progress_mask == 3 { ok_mask = ok_mask + 32 }
    if ready_for_face1_proof_mask == 0 { ok_mask = ok_mask + 64 }
    if face1_preflight_status == 82 { ok_mask = ok_mask + 128 }

    if ok_mask != 255 { return 0 - 1 }
    return 715930842
}

pub fn lorenz_i256_cover_child4_boundary_face1_preflight_audit_fingerprint(
    artifact_fp: i64,
    instance_fp: i64,
    certificate_fp: i64,
    child4_boundary_face0_preflight_fp: i64,
    child4_boundary_face0_preflight_audit_fp: i64,
    child4_boundary_face_obligations_fp: i64,
    child4_boundary_face_obligations_audit_fp: i64,
    boundary_gluing_obligation_mask: i64,
    face_obligation_mask: i64,
    boundary_face_count: i64,
    prior_face_preflight_mask: i64,
    selected_face_index: i64,
    selected_face_mask: i64,
    face1_obligation_mask: i64,
    face1_topology_mask: i64,
    face1_orientation_mask: i64,
    face1_adjacency_mask: i64,
    face1_trace_mask: i64,
    face1_dependency_mask: i64,
    face1_preflight_mask: i64,
    face_preflight_progress_mask: i64,
    face1_pending_proof_mask: i64,
    solver_face1_action_mask: i64,
    ready_for_face1_proof_mask: i64,
    face1_verified_mask: i64,
    face1_proof_mask: i64,
    boundary_gluing_verified_mask: i64,
    boundary_gluing_proof_mask: i64,
    finite_cover_certificate_mask: i64,
    global_certificate_candidate_mask: i64,
    global_flowpipe_claim_mask: i64,
    face1_preflight_status: i64,
    ok_mask: i64) -> i64 with Mod {
    if artifact_fp != 715930842 { return 0 - 1 }
    if instance_fp != 834572019 { return 0 - 1 }
    if certificate_fp != 450916328 { return 0 - 1 }
    if child4_boundary_face0_preflight_fp != 629184705 { return 0 - 1 }
    if child4_boundary_face0_preflight_audit_fp != 884062113 { return 0 - 1 }
    if child4_boundary_face_obligations_fp != 458306927 { return 0 - 1 }
    if child4_boundary_face_obligations_audit_fp != 766184391 { return 0 - 1 }
    if boundary_gluing_obligation_mask != 31 { return 0 - 1 }
    if face_obligation_mask != 31 { return 0 - 1 }
    if boundary_face_count != 5 { return 0 - 1 }
    if prior_face_preflight_mask != 1 { return 0 - 1 }
    if selected_face_index != 1 { return 0 - 1 }
    if selected_face_mask != 2 { return 0 - 1 }
    if face1_obligation_mask != 2 { return 0 - 1 }
    if face1_topology_mask != 2 { return 0 - 1 }
    if face1_orientation_mask != 2 { return 0 - 1 }
    if face1_adjacency_mask != 2 { return 0 - 1 }
    if face1_trace_mask != 2 { return 0 - 1 }
    if face1_dependency_mask != 3 { return 0 - 1 }
    if face1_preflight_mask != 2 { return 0 - 1 }
    if face_preflight_progress_mask != 3 { return 0 - 1 }
    if face1_pending_proof_mask != 2 { return 0 - 1 }
    if solver_face1_action_mask != 2 { return 0 - 1 }
    if ready_for_face1_proof_mask != 0 { return 0 - 1 }
    if face1_verified_mask != 0 { return 0 - 1 }
    if face1_proof_mask != 0 { return 0 - 1 }
    if boundary_gluing_verified_mask != 0 { return 0 - 1 }
    if boundary_gluing_proof_mask != 0 { return 0 - 1 }
    if finite_cover_certificate_mask != 0 { return 0 - 1 }
    if global_certificate_candidate_mask != 0 { return 0 - 1 }
    if global_flowpipe_claim_mask != 0 { return 0 - 1 }
    if face1_preflight_status != 82 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }
    return 268401557
}
