//! stdlib/systems/lorenz_i256_child4_boundary_gluing_input_guard.sio
//!
//! Input guard for the future child-4 boundary-gluing proof in the Lorenz i256
//! cover lane. This records that the current gluing skeleton, obligation seed,
//! and five-face preflight bundle are mutually anchored, but it does not prove
//! gluing, discharge child-4, certify a finite cover, or assert any global
//! flowpipe claim.

pub fn lorenz_i256_cover_child4_boundary_gluing_input_guard_check(
    child4_boundary_face_preflight_bundle_fp: i64,
    child4_boundary_face_preflight_bundle_audit_fp: i64,
    child4_boundary_gluing_proof_skeleton_fp: i64,
    child4_boundary_gluing_proof_skeleton_audit_fp: i64,
    child4_boundary_gluing_obligation_seed_fp: i64,
    child4_boundary_gluing_obligation_seed_audit_fp: i64,
    boundary_gluing_obligation_mask: i64,
    face_preflight_bundle_mask: i64,
    face_pending_proof_mask: i64,
    skeleton_slot_mask: i64,
    skeleton_verified_mask: i64,
    face_verified_mask: i64,
    face_proof_mask: i64,
    boundary_gluing_verified_mask: i64,
    boundary_gluing_proof_mask: i64,
    finite_cover_certificate_mask: i64,
    global_certificate_candidate_mask: i64,
    global_flowpipe_claim_mask: i64,
    guard_status: i64) -> i64 with Mod {
    var anchor_mask: i64 = 0
    if child4_boundary_face_preflight_bundle_fp == 812640573 {
        if child4_boundary_face_preflight_bundle_audit_fp == 294736811 {
            anchor_mask = anchor_mask + 1
        }
    }
    if child4_boundary_gluing_proof_skeleton_fp == 836470291 {
        if child4_boundary_gluing_proof_skeleton_audit_fp == 190735846 {
            anchor_mask = anchor_mask + 2
        }
    }
    if child4_boundary_gluing_obligation_seed_fp == 604182937 {
        if child4_boundary_gluing_obligation_seed_audit_fp == 218570463 {
            anchor_mask = anchor_mask + 4
        }
    }
    if boundary_gluing_obligation_mask == 31 { anchor_mask = anchor_mask + 8 }
    if guard_status == 87 { anchor_mask = anchor_mask + 16 }

    let boundary_face_count: i64 = 5
    let boundary_gluing_input_guard_mask: i64 = 31
    let face_preflight_dependency_mask: i64 = 31
    let skeleton_dependency_mask: i64 = 31
    let gluing_seed_dependency_mask: i64 = 31
    let boundary_gluing_goal_pending_mask: i64 = 31
    let solver_gluing_next_action_mask: i64 = 31
    let ready_for_boundary_gluing_proof_mask: i64 = 0

    var input_ok: i64 = 1
    if boundary_face_count != 5 { input_ok = 0 }
    if boundary_gluing_input_guard_mask != 31 { input_ok = 0 }
    if face_preflight_bundle_mask != 31 { input_ok = 0 }
    if face_pending_proof_mask != 31 { input_ok = 0 }
    if skeleton_slot_mask != 31 { input_ok = 0 }
    if face_preflight_dependency_mask != 31 { input_ok = 0 }
    if skeleton_dependency_mask != 31 { input_ok = 0 }
    if gluing_seed_dependency_mask != 31 { input_ok = 0 }
    if boundary_gluing_goal_pending_mask != 31 { input_ok = 0 }
    if solver_gluing_next_action_mask != 31 { input_ok = 0 }
    if ready_for_boundary_gluing_proof_mask != 0 { input_ok = 0 }

    var nonclaim_ok: i64 = 1
    if skeleton_verified_mask != 0 { nonclaim_ok = 0 }
    if face_verified_mask != 0 { nonclaim_ok = 0 }
    if face_proof_mask != 0 { nonclaim_ok = 0 }
    if boundary_gluing_verified_mask != 0 { nonclaim_ok = 0 }
    if boundary_gluing_proof_mask != 0 { nonclaim_ok = 0 }
    if finite_cover_certificate_mask != 0 { nonclaim_ok = 0 }
    if global_certificate_candidate_mask != 0 { nonclaim_ok = 0 }
    if global_flowpipe_claim_mask != 0 { nonclaim_ok = 0 }

    var ok_mask: i64 = 0
    if anchor_mask == 31 { ok_mask = ok_mask + 1 }
    if input_ok == 1 { ok_mask = ok_mask + 2 }
    if nonclaim_ok == 1 { ok_mask = ok_mask + 4 }
    if face_preflight_bundle_mask == 31 { ok_mask = ok_mask + 8 }
    if skeleton_slot_mask == 31 { ok_mask = ok_mask + 16 }
    if boundary_gluing_goal_pending_mask == 31 { ok_mask = ok_mask + 32 }
    if ready_for_boundary_gluing_proof_mask == 0 { ok_mask = ok_mask + 64 }
    if guard_status == 87 { ok_mask = ok_mask + 128 }

    if ok_mask != 255 { return 0 - 1 }
    return 508913246
}

pub fn lorenz_i256_cover_child4_boundary_gluing_input_guard_audit_fingerprint(
    artifact_fp: i64,
    instance_fp: i64,
    certificate_fp: i64,
    child4_boundary_face_preflight_bundle_fp: i64,
    child4_boundary_face_preflight_bundle_audit_fp: i64,
    child4_boundary_gluing_proof_skeleton_fp: i64,
    child4_boundary_gluing_proof_skeleton_audit_fp: i64,
    child4_boundary_gluing_obligation_seed_fp: i64,
    child4_boundary_gluing_obligation_seed_audit_fp: i64,
    boundary_gluing_obligation_mask: i64,
    boundary_face_count: i64,
    boundary_gluing_input_guard_mask: i64,
    face_preflight_bundle_mask: i64,
    face_pending_proof_mask: i64,
    skeleton_slot_mask: i64,
    face_preflight_dependency_mask: i64,
    skeleton_dependency_mask: i64,
    gluing_seed_dependency_mask: i64,
    boundary_gluing_goal_pending_mask: i64,
    solver_gluing_next_action_mask: i64,
    ready_for_boundary_gluing_proof_mask: i64,
    skeleton_verified_mask: i64,
    face_verified_mask: i64,
    face_proof_mask: i64,
    boundary_gluing_verified_mask: i64,
    boundary_gluing_proof_mask: i64,
    finite_cover_certificate_mask: i64,
    global_certificate_candidate_mask: i64,
    global_flowpipe_claim_mask: i64,
    guard_status: i64,
    ok_mask: i64) -> i64 with Mod {
    if artifact_fp != 508913246 { return 0 - 1 }
    if instance_fp != 901436527 { return 0 - 1 }
    if certificate_fp != 245690813 { return 0 - 1 }
    if child4_boundary_face_preflight_bundle_fp != 812640573 { return 0 - 1 }
    if child4_boundary_face_preflight_bundle_audit_fp != 294736811 { return 0 - 1 }
    if child4_boundary_gluing_proof_skeleton_fp != 836470291 { return 0 - 1 }
    if child4_boundary_gluing_proof_skeleton_audit_fp != 190735846 { return 0 - 1 }
    if child4_boundary_gluing_obligation_seed_fp != 604182937 { return 0 - 1 }
    if child4_boundary_gluing_obligation_seed_audit_fp != 218570463 { return 0 - 1 }
    if boundary_gluing_obligation_mask != 31 { return 0 - 1 }
    if boundary_face_count != 5 { return 0 - 1 }
    if boundary_gluing_input_guard_mask != 31 { return 0 - 1 }
    if face_preflight_bundle_mask != 31 { return 0 - 1 }
    if face_pending_proof_mask != 31 { return 0 - 1 }
    if skeleton_slot_mask != 31 { return 0 - 1 }
    if face_preflight_dependency_mask != 31 { return 0 - 1 }
    if skeleton_dependency_mask != 31 { return 0 - 1 }
    if gluing_seed_dependency_mask != 31 { return 0 - 1 }
    if boundary_gluing_goal_pending_mask != 31 { return 0 - 1 }
    if solver_gluing_next_action_mask != 31 { return 0 - 1 }
    if ready_for_boundary_gluing_proof_mask != 0 { return 0 - 1 }
    if skeleton_verified_mask != 0 { return 0 - 1 }
    if face_verified_mask != 0 { return 0 - 1 }
    if face_proof_mask != 0 { return 0 - 1 }
    if boundary_gluing_verified_mask != 0 { return 0 - 1 }
    if boundary_gluing_proof_mask != 0 { return 0 - 1 }
    if finite_cover_certificate_mask != 0 { return 0 - 1 }
    if global_certificate_candidate_mask != 0 { return 0 - 1 }
    if global_flowpipe_claim_mask != 0 { return 0 - 1 }
    if guard_status != 87 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }
    return 672184905
}
