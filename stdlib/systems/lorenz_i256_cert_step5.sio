pub fn lorenz_i256_step5_taylor2_replay_executor_check(
    replay_preflight_fp: i64,
    proof_trace_skeleton_fp: i64,
    completed_bundle_fp: i64,
    node_receipt_mask: i64,
    edge_receipt_mask: i64,
    replayed_node_mask: i64,
    predecessor_ready_mask: i64,
    replay_status_executed: i64,
    global_flowpipe_claim_mask: i64) -> i64 with Mod {
    var anchor_ok: i64 = 1
    if replay_preflight_fp != 847188269 { anchor_ok = 0 }
    if proof_trace_skeleton_fp != 971755585 { anchor_ok = 0 }
    if completed_bundle_fp != 989883403 { anchor_ok = 0 }

    var node_receipts_ok: i64 = 1
    if node_receipt_mask != 15 { node_receipts_ok = 0 }
    if 422368008 <= 0 { node_receipts_ok = 0 }
    if 171451971 <= 0 { node_receipts_ok = 0 }
    if 815806077 <= 0 { node_receipts_ok = 0 }
    if 69995750 <= 0 { node_receipts_ok = 0 }

    var edge_receipts_ok: i64 = 1
    if edge_receipt_mask != 15 { edge_receipts_ok = 0 }
    if edge_receipt_mask != node_receipt_mask { edge_receipts_ok = 0 }

    var replay_execution_ok: i64 = 1
    if replayed_node_mask != node_receipt_mask { replay_execution_ok = 0 }
    if predecessor_ready_mask != edge_receipt_mask { replay_execution_ok = 0 }

    var status_ok: i64 = 1
    if replay_status_executed != 7 { status_ok = 0 }

    var not_validated_ok: i64 = 1
    let validated_enclosure_mask: i64 = 0
    if validated_enclosure_mask != 0 { not_validated_ok = 0 }

    var distinct_predecessors_ok: i64 = 1
    if replay_preflight_fp == proof_trace_skeleton_fp { distinct_predecessors_ok = 0 }
    if replay_preflight_fp == completed_bundle_fp { distinct_predecessors_ok = 0 }
    if proof_trace_skeleton_fp == completed_bundle_fp { distinct_predecessors_ok = 0 }

    let local_containment_proof_mask: i64 = 0
    var nonclaim_ok: i64 = 1
    if local_containment_proof_mask != 0 { nonclaim_ok = 0 }
    if global_flowpipe_claim_mask != 0 { nonclaim_ok = 0 }

    var ok_mask: i64 = 0
    if anchor_ok == 1 { ok_mask = ok_mask + 1 }
    if node_receipts_ok == 1 { ok_mask = ok_mask + 2 }
    if edge_receipts_ok == 1 { ok_mask = ok_mask + 4 }
    if replay_execution_ok == 1 { ok_mask = ok_mask + 8 }
    if status_ok == 1 { ok_mask = ok_mask + 16 }
    if not_validated_ok == 1 { ok_mask = ok_mask + 32 }
    if distinct_predecessors_ok == 1 { ok_mask = ok_mask + 64 }
    if nonclaim_ok == 1 { ok_mask = ok_mask + 128 }
    if ok_mask != 255 { return 0 - 1 }

    let instance_fp = lorenz_i256_step5_taylor2_replay_executor_instance_fingerprint(
        5, replay_preflight_fp, 425385087, proof_trace_skeleton_fp,
        completed_bundle_fp, 422368008, 171451971, 815806077, 69995750,
        1, 1, 4, 4, node_receipt_mask, edge_receipt_mask,
        replayed_node_mask, predecessor_ready_mask, validated_enclosure_mask,
        replay_status_executed, local_containment_proof_mask,
        global_flowpipe_claim_mask)
    let certificate_fp = lorenz_i256_step5_taylor2_replay_executor_certificate_fingerprint(
        instance_fp, 4, 4, node_receipt_mask, edge_receipt_mask,
        replayed_node_mask, predecessor_ready_mask, validated_enclosure_mask,
        replay_status_executed, ok_mask, local_containment_proof_mask,
        global_flowpipe_claim_mask)

    return lorenz_i256_step5_taylor2_replay_executor_fingerprint(
        instance_fp, certificate_fp, 8, 5, 1, 1,
        replay_status_executed, ok_mask, local_containment_proof_mask,
        global_flowpipe_claim_mask)
}

