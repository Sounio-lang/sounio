    fp = lorenz_i256_cert_mix(fp, response_envelope_fp, 5431)
    fp = lorenz_i256_cert_mix(fp, response_envelope_audit_fp, 5431)
    fp = lorenz_i256_cert_mix(fp, remainder_obligation_fp, 5431)
    fp = lorenz_i256_cert_mix(fp, remainder_obligation_audit_fp, 5431)
    fp = lorenz_i256_cert_mix(fp, local_flowpipe_seed_fp, 5431)
    fp = lorenz_i256_cert_mix(fp, local_flowpipe_seed_audit_fp, 5431)
    fp = lorenz_i256_cert_mix(fp, step_index, 5431)
    fp = lorenz_i256_cert_mix(fp, local_flowpipe_status, 5431)
    fp = lorenz_i256_cert_mix(fp, ok_mask, 5431)
    return fp
}

pub fn lorenz_i256_step5_taylor2_local_flowpipe_proof_check(
    flowpipe_obligation_fp: i64,
    flowpipe_obligation_audit_fp: i64,
    time_slab_containment_fp: i64,
    time_slab_containment_audit_fp: i64,
    local_containment_obligation_fp: i64,
    local_containment_obligation_audit_fp: i64,
    response_envelope_fp: i64,
    response_envelope_audit_fp: i64,
    remainder_obligation_fp: i64,
    remainder_obligation_audit_fp: i64,
    local_flowpipe_seed_fp: i64,
    local_flowpipe_seed_audit_fp: i64,
    global_flowpipe_claim_mask: i64,
    local_flowpipe_status: i64) -> i64 with Mod {
    var obligation_anchor_ok: i64 = 1
    if flowpipe_obligation_fp != 108175917 { obligation_anchor_ok = 0 }
    if flowpipe_obligation_audit_fp != 495875254 { obligation_anchor_ok = 0 }

    var local_geometry_ok: i64 = 1
    if time_slab_containment_fp != 253054033 { local_geometry_ok = 0 }
    if time_slab_containment_audit_fp != 661134385 { local_geometry_ok = 0 }
    if local_containment_obligation_fp != 291436394 { local_geometry_ok = 0 }
    if local_containment_obligation_audit_fp != 876674722 { local_geometry_ok = 0 }

    var analytic_ok: i64 = 1
    if response_envelope_fp != 422368008 { analytic_ok = 0 }
    if response_envelope_audit_fp != 577119901 { analytic_ok = 0 }
    if remainder_obligation_fp != 69995750 { analytic_ok = 0 }
    if remainder_obligation_audit_fp != 380914208 { analytic_ok = 0 }

    var seed_ok: i64 = 1
    if local_flowpipe_seed_fp != 931268564 { seed_ok = 0 }
    if local_flowpipe_seed_audit_fp != 900912795 { seed_ok = 0 }

    let endpoint_proof_mask: i64 = 7
    let time_slab_proof_mask: i64 = 7
    let response_proof_mask: i64 = 127
    let remainder_proof_mask: i64 = 127
    var composition_ready_mask: i64 = 0
    if endpoint_proof_mask == 7 { composition_ready_mask = composition_ready_mask + 1 }
    if time_slab_proof_mask == 7 { composition_ready_mask = composition_ready_mask + 2 }
    if response_proof_mask == 127 { composition_ready_mask = composition_ready_mask + 4 }
    if remainder_proof_mask == 127 { composition_ready_mask = composition_ready_mask + 8 }
    let local_flowpipe_obligation_mask: i64 = composition_ready_mask
    let local_flowpipe_proof_mask: i64 = composition_ready_mask

    var local_proof_mask_ok: i64 = 1
    if composition_ready_mask != 15 { local_proof_mask_ok = 0 }
    if local_flowpipe_obligation_mask != 15 { local_proof_mask_ok = 0 }
    if local_flowpipe_proof_mask != 15 { local_proof_mask_ok = 0 }

    var non_global_ok: i64 = 1
    if global_flowpipe_claim_mask != 0 { non_global_ok = 0 }
    if local_flowpipe_status != 21 { non_global_ok = 0 }

    let taylor_order: i64 = 2
    let selected_dt_num: i64 = 1
    let selected_dt_den: i64 = 100
    let source_width_bits: i64 = 256
    let scale_log2: i64 = 32
    var step_contract_ok: i64 = 1
    if taylor_order != 2 { step_contract_ok = 0 }
    if selected_dt_num != 1 { step_contract_ok = 0 }
    if selected_dt_den != 100 { step_contract_ok = 0 }
    if source_width_bits != 256 { step_contract_ok = 0 }
    if scale_log2 != 32 { step_contract_ok = 0 }

    var dependency_closure_ok: i64 = 1
    if flowpipe_obligation_fp != 108175917 { dependency_closure_ok = 0 }
    if time_slab_containment_fp != 253054033 { dependency_closure_ok = 0 }
    if local_containment_obligation_fp != 291436394 { dependency_closure_ok = 0 }
    if response_envelope_fp != 422368008 { dependency_closure_ok = 0 }
    if remainder_obligation_fp != 69995750 { dependency_closure_ok = 0 }
    if local_flowpipe_seed_fp != 931268564 { dependency_closure_ok = 0 }
    if local_flowpipe_proof_mask != 15 { dependency_closure_ok = 0 }

    var ok_mask: i64 = 0
    if obligation_anchor_ok == 1 { ok_mask = ok_mask + 1 }
    if local_geometry_ok == 1 { ok_mask = ok_mask + 2 }
    if analytic_ok == 1 { ok_mask = ok_mask + 4 }
    if seed_ok == 1 { ok_mask = ok_mask + 8 }
    if local_proof_mask_ok == 1 { ok_mask = ok_mask + 16 }
    if non_global_ok == 1 { ok_mask = ok_mask + 32 }
    if step_contract_ok == 1 { ok_mask = ok_mask + 64 }
    if dependency_closure_ok == 1 { ok_mask = ok_mask + 128 }
    if ok_mask != 255 { return 0 - 1 }

    let instance_fp = lorenz_i256_step5_taylor2_local_flowpipe_proof_instance_fingerprint(
        5, flowpipe_obligation_fp, flowpipe_obligation_audit_fp,
        time_slab_containment_fp, time_slab_containment_audit_fp,
        local_containment_obligation_fp, local_containment_obligation_audit_fp,
        response_envelope_fp, response_envelope_audit_fp,
        remainder_obligation_fp, remainder_obligation_audit_fp,
        local_flowpipe_seed_fp, local_flowpipe_seed_audit_fp,
        endpoint_proof_mask, time_slab_proof_mask, response_proof_mask,
        remainder_proof_mask, composition_ready_mask,
        local_flowpipe_obligation_mask, local_flowpipe_proof_mask,
        global_flowpipe_claim_mask, local_flowpipe_status)
    let certificate_fp = lorenz_i256_step5_taylor2_local_flowpipe_proof_certificate_fingerprint(
        instance_fp, endpoint_proof_mask, time_slab_proof_mask,
        response_proof_mask, remainder_proof_mask, composition_ready_mask,
        local_flowpipe_obligation_mask, local_flowpipe_proof_mask,
        global_flowpipe_claim_mask, local_flowpipe_status, ok_mask)

    return lorenz_i256_step5_taylor2_local_flowpipe_proof_fingerprint(
        instance_fp, certificate_fp, 16, 5, local_flowpipe_obligation_mask,
        local_flowpipe_proof_mask, global_flowpipe_claim_mask,
        local_flowpipe_status, ok_mask)
}
