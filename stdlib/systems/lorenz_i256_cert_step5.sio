pub fn lorenz_i256_step5_taylor2_remainder_obligation_check(
    x_lte_cap_ppm: i64,
    y_lte_cap_ppm: i64,
    z_lte_cap_ppm: i64,
    global_flowpipe_claim_mask: i64) -> i64 with Mod {
    let source_scale: i256 = 4294967296 as i256
    let target_scale: i256 = 1000000 as i256
    let dt_q: i256 = 42949672 as i256
    let start_x: i256 = 4920371098 as i256
    let start_y: i256 = 8816077911 as i256
    let start_z: i256 = 4092986080 as i256
    let rx: i256 = 390842024 as i256
    let ry: i256 = 1245540516 as i256
    let rz: i256 = 8589935 as i256

    let x_abs: i256 = 5311213122 as i256
    let y_abs: i256 = 10061618427 as i256
    let z_abs: i256 = 4101576015 as i256
    let rhoz_abs: i256 = 116174688143 as i256
    let x_prime: i256 = 153728315490 as i256
    let y_prime: i256 = 153724767780 as i256
    let z_prime: i256 = 23379865897 as i256
    let x_second: i256 = 3074530832700 as i256
    let y_second: i256 = 4340838038257 as i256
    let z_second: i256 = 612576495421 as i256
    let x_lte_source: i256 = 153726535 as i256
    let y_lte_source: i256 = 217041893 as i256
    let z_lte_source: i256 = 30628824 as i256
    let x_lte_ppm: i256 = 35793 as i256
    let y_lte_ppm: i256 = 50535 as i256
    let z_lte_ppm: i256 = 7132 as i256
    let den: i256 = (2 as i256) * source_scale * source_scale

    var abs_box_ok: i64 = 1
    if x_abs != start_x + rx { abs_box_ok = 0 }
    if y_abs != start_y + ry { abs_box_ok = 0 }
    if z_abs != start_z + rz { abs_box_ok = 0 }
    if rhoz_abs != (28 as i256) * source_scale - (start_z - rz) { abs_box_ok = 0 }

    let y_prime_product: i256 = x_abs * rhoz_abs
    let xy_product: i256 = x_abs * y_abs
    let beta_z_product: i256 = (8 as i256) * z_abs
    var first_derivative_ok: i64 = 1
    if x_prime != (10 as i256) * (x_abs + y_abs) { first_derivative_ok = 0 }
    if (y_prime - y_abs - (1 as i256)) * source_scale >= y_prime_product {
        first_derivative_ok = 0
    }
    if (y_prime - y_abs) * source_scale < y_prime_product {
        first_derivative_ok = 0
    }
    if (z_prime - (z_prime - (23379865897 as i256))) != z_prime { first_derivative_ok = 0 }
    if (12442329857 as i256 - (1 as i256)) * source_scale >= xy_product {
        first_derivative_ok = 0
    }
    if (12442329857 as i256) * source_scale < xy_product {
        first_derivative_ok = 0
    }
    if ((10937536040 as i256) - (1 as i256)) * (3 as i256) >= beta_z_product {
        first_derivative_ok = 0
    }
    if (10937536040 as i256) * (3 as i256) < beta_z_product {
        first_derivative_ok = 0
    }
    if z_prime != (12442329857 as i256) + (10937536040 as i256) {
        first_derivative_ok = 0
    }

    let y_second_a: i256 = x_prime * rhoz_abs
    let y_second_b: i256 = x_abs * z_prime
    let z_second_a: i256 = x_prime * y_abs
    let z_second_b: i256 = x_abs * y_prime
    let z_second_c: i256 = (8 as i256) * z_prime
    var second_derivative_ok: i64 = 1
    if x_second != (10 as i256) * (y_prime + x_prime) { second_derivative_ok = 0 }
    if ((4158201420401 as i256) - (1 as i256)) * source_scale >= y_second_a {
        second_derivative_ok = 0
    }
    if (4158201420401 as i256) * source_scale < y_second_a {
        second_derivative_ok = 0
    }
    if ((28911850076 as i256) - (1 as i256)) * source_scale >= y_second_b {
        second_derivative_ok = 0
    }
    if (28911850076 as i256) * source_scale < y_second_b {
        second_derivative_ok = 0
    }
    if y_second != (4158201420401 as i256) + (28911850076 as i256) + y_prime {
        second_derivative_ok = 0
    }
    if ((360132114004 as i256) - (1 as i256)) * source_scale >= z_second_a {
        second_derivative_ok = 0
    }
    if (360132114004 as i256) * source_scale < z_second_a {
        second_derivative_ok = 0
    }
    if ((190098072358 as i256) - (1 as i256)) * source_scale >= z_second_b {
        second_derivative_ok = 0
    }
    if (190098072358 as i256) * source_scale < z_second_b {
        second_derivative_ok = 0
    }
    if ((62346309059 as i256) - (1 as i256)) * (3 as i256) >= z_second_c {
        second_derivative_ok = 0
    }
    if (62346309059 as i256) * (3 as i256) < z_second_c {
        second_derivative_ok = 0
    }
    if z_second != (360132114004 as i256) + (190098072358 as i256) + (62346309059 as i256) {
        second_derivative_ok = 0
    }

    let dt2: i256 = dt_q * dt_q
    var source_lte_ok: i64 = 1
    if (x_lte_source - (1 as i256)) * den >= x_second * dt2 { source_lte_ok = 0 }
    if x_lte_source * den < x_second * dt2 { source_lte_ok = 0 }
    if (y_lte_source - (1 as i256)) * den >= y_second * dt2 { source_lte_ok = 0 }
    if y_lte_source * den < y_second * dt2 { source_lte_ok = 0 }
    if (z_lte_source - (1 as i256)) * den >= z_second * dt2 { source_lte_ok = 0 }
    if z_lte_source * den < z_second * dt2 { source_lte_ok = 0 }

    var target_lte_ok: i64 = 1
    if (x_lte_ppm - (1 as i256)) * source_scale >= x_lte_source * target_scale {
        target_lte_ok = 0
    }
    if x_lte_ppm * source_scale < x_lte_source * target_scale {
        target_lte_ok = 0
    }
    if (y_lte_ppm - (1 as i256)) * source_scale >= y_lte_source * target_scale {
        target_lte_ok = 0
    }
    if y_lte_ppm * source_scale < y_lte_source * target_scale {
        target_lte_ok = 0
    }
    if (z_lte_ppm - (1 as i256)) * source_scale >= z_lte_source * target_scale {
        target_lte_ok = 0
    }
    if z_lte_ppm * source_scale < z_lte_source * target_scale {
        target_lte_ok = 0
    }

    var cap_ok: i64 = 1
    if x_lte_cap_ppm != 40000 { cap_ok = 0 }
    if y_lte_cap_ppm != 55000 { cap_ok = 0 }
    if z_lte_cap_ppm != 10000 { cap_ok = 0 }
    if (x_lte_cap_ppm as i256) - x_lte_ppm != 4207 as i256 { cap_ok = 0 }
    if (y_lte_cap_ppm as i256) - y_lte_ppm != 4465 as i256 { cap_ok = 0 }
    if (z_lte_cap_ppm as i256) - z_lte_ppm != 2868 as i256 { cap_ok = 0 }

    let local_remainder_proof_mask: i64 = 0
    var nonclaim_ok: i64 = 1
    if local_remainder_proof_mask != 0 { nonclaim_ok = 0 }
    if global_flowpipe_claim_mask != 0 { nonclaim_ok = 0 }

    var ok_mask: i64 = 0
    if abs_box_ok == 1 { ok_mask = ok_mask + 1 }
    if first_derivative_ok == 1 { ok_mask = ok_mask + 2 }
    if second_derivative_ok == 1 { ok_mask = ok_mask + 4 }
    if source_lte_ok == 1 { ok_mask = ok_mask + 8 }
    if target_lte_ok == 1 { ok_mask = ok_mask + 16 }
    if cap_ok == 1 { ok_mask = ok_mask + 32 }
    if nonclaim_ok == 1 { ok_mask = ok_mask + 64 }
    if ok_mask != 127 { return 0 - 1 }

    let instance_fp = lorenz_i256_step5_taylor2_remainder_obligation_instance_fingerprint(
        5, 4294967296, 1000000, 42949672, 422368008, 577119901,
        171451971, 862108922, 815806077, 655666714, 4920371098,
        8816077911, 4092986080, 390842024, 1245540516, 8589935,
        local_remainder_proof_mask, global_flowpipe_claim_mask)
    let certificate_fp = lorenz_i256_step5_taylor2_remainder_obligation_certificate_fingerprint(
        instance_fp, 5311213122, 10061618427, 4101576015, 116174688143,
        153728315490, 153724767780, 23379865897, 3074530832700,
        4340838038257, 612576495421, 153726535, 217041893, 30628824,
        35793, 50535, 7132, x_lte_cap_ppm, y_lte_cap_ppm,
        z_lte_cap_ppm, 4207, 4465, 2868, ok_mask,
        local_remainder_proof_mask, global_flowpipe_claim_mask)

    return lorenz_i256_step5_taylor2_remainder_obligation_fingerprint(
        instance_fp, certificate_fp, 422368008, 577119901, 171451971,
        862108922, 815806077, 655666714, 5, 5, 35793, 50535, 7132,
        x_lte_cap_ppm, y_lte_cap_ppm, z_lte_cap_ppm, ok_mask,
        local_remainder_proof_mask, global_flowpipe_claim_mask)
