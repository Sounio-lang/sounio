    let selected_dt_den: i64 = 100
    let dx_bound: i64 = 9070400
    let dy_bound: i64 = 28932778
    let dz_bound: i64 = 189714
    let x_sweep: i64 = 90704
    let y_sweep: i64 = 289328
    let z_sweep: i64 = 1898

    var ceil_sweep_ok: i64 = 1
    if (x_sweep - 1) * selected_dt_den >= dx_bound { ceil_sweep_ok = 0 }
    if x_sweep * selected_dt_den < dx_bound { ceil_sweep_ok = 0 }
    if (y_sweep - 1) * selected_dt_den >= dy_bound { ceil_sweep_ok = 0 }
    if y_sweep * selected_dt_den < dy_bound { ceil_sweep_ok = 0 }
    if (z_sweep - 1) * selected_dt_den >= dz_bound { ceil_sweep_ok = 0 }
    if z_sweep * selected_dt_den < dz_bound { ceil_sweep_ok = 0 }

    let x_slab_margin: i64 = 91000
    let y_slab_margin: i64 = 290000
    let z_slab_margin: i64 = 2000
    let x_slab_slack: i64 = x_slab_margin - x_sweep
    let y_slab_slack: i64 = y_slab_margin - y_sweep
    let z_slab_slack: i64 = z_slab_margin - z_sweep

    var slab_margin_ok: i64 = 1
    if x_slab_slack != 296 { slab_margin_ok = 0 }
    if y_slab_slack != 672 { slab_margin_ok = 0 }
    if z_slab_slack != 102 { slab_margin_ok = 0 }
    if x_slab_slack <= 0 { slab_margin_ok = 0 }
    if y_slab_slack <= 0 { slab_margin_ok = 0 }
    if z_slab_slack <= 0 { slab_margin_ok = 0 }

    var time_slab_containment_mask: i64 = 0
    if x_sweep <= x_slab_margin { time_slab_containment_mask = time_slab_containment_mask + 1 }
    if y_sweep <= y_slab_margin { time_slab_containment_mask = time_slab_containment_mask + 2 }
    if z_sweep <= z_slab_margin { time_slab_containment_mask = time_slab_containment_mask + 4 }

    var time_contract_ok: i64 = 1
    if selected_dt_num != 1 { time_contract_ok = 0 }
    if selected_dt_den != 100 { time_contract_ok = 0 }

    let local_time_slab_obligation_mask: i64 = time_slab_containment_mask
    var local_obligation_ok: i64 = 1
    if local_time_slab_obligation_mask != 7 { local_obligation_ok = 0 }
    if time_slab_status_local != 13 { local_obligation_ok = 0 }

    var non_global_claim_ok: i64 = 1
    if global_flowpipe_claim_mask != 0 { non_global_claim_ok = 0 }

    var v79_bridge_ok: i64 = 1
    if local_containment_obligation_fp != 291436394 { v79_bridge_ok = 0 }
    if time_slab_containment_mask != 7 { v79_bridge_ok = 0 }

    var ok_mask: i64 = 0
    if anchor_ok == 1 { ok_mask = ok_mask + 1 }
    if remainder_anchor_ok == 1 { ok_mask = ok_mask + 2 }
    if ceil_sweep_ok == 1 { ok_mask = ok_mask + 4 }
    if slab_margin_ok == 1 { ok_mask = ok_mask + 8 }
    if time_contract_ok == 1 { ok_mask = ok_mask + 16 }
    if local_obligation_ok == 1 { ok_mask = ok_mask + 32 }
    if non_global_claim_ok == 1 { ok_mask = ok_mask + 64 }
    if v79_bridge_ok == 1 { ok_mask = ok_mask + 128 }
    if ok_mask != 255 { return 0 - 1 }

    let instance_fp = lorenz_i256_step5_taylor2_time_slab_containment_instance_fingerprint(
        5, local_containment_obligation_fp, local_containment_obligation_audit_fp,
        point_time_slab_fp, point_time_slab_audit_fp, remainder_obligation_fp,
        dx_bound, dy_bound, dz_bound, selected_dt_num, selected_dt_den,
