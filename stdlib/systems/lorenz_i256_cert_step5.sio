pub fn lorenz_i256_step5_taylor2_time_slab_containment_check(
    local_containment_obligation_fp: i64,
    local_containment_obligation_audit_fp: i64,
    point_time_slab_fp: i64,
    point_time_slab_audit_fp: i64,
    remainder_obligation_fp: i64,
    global_flowpipe_claim_mask: i64,
    time_slab_status_local: i64) -> i64 with Mod {
    var anchor_ok: i64 = 1
    if local_containment_obligation_fp != 291436394 { anchor_ok = 0 }
    if local_containment_obligation_audit_fp != 876674722 { anchor_ok = 0 }
