//! stdlib/systems/lorenz_i256_x_step_bridge.sio
//!
//! Portable one-axis Lorenz x-step receipt over decimal i256-like limbs. This
//! composes sigma*(y-x) with a dt=1 state update for bounded toy cases. It is
//! not a scientific integrator or a full Lorenz stepper.

use systems::lorenz_i256_sigma_x_term_bridge::*
use systems::lorenz_i256_limb_bridge::*
use systems::lorenz_i256_signed_delta_bridge::*

pub fn lorenz_i256_x_step_limb(
    x0: i64,
    x1: i64,
    x2: i64,
    x3: i64,
    y0: i64,
    y1: i64,
    y2: i64,
    y3: i64,
    limb_index: i64) -> i64 with Div {
    let term_sign = lorenz_i256_sigma_x_term_sign(y0, y1, y2, y3, x0, x1, x2, x3)
    let t0 = lorenz_i256_sigma_x_term_abs_limb(y0, y1, y2, y3, x0, x1, x2, x3, 0)
    let t1 = lorenz_i256_sigma_x_term_abs_limb(y0, y1, y2, y3, x0, x1, x2, x3, 1)
    let t2 = lorenz_i256_sigma_x_term_abs_limb(y0, y1, y2, y3, x0, x1, x2, x3, 2)
    let t3 = lorenz_i256_sigma_x_term_abs_limb(y0, y1, y2, y3, x0, x1, x2, x3, 3)
    if term_sign == 0 - 2 { return 0 - 1 }
    if t0 < 0 { return 0 - 1 }
    if t1 < 0 { return 0 - 1 }
    if t2 < 0 { return 0 - 1 }
    if t3 < 0 { return 0 - 1 }

    if term_sign > 0 {
        return lorenz_dec4_add_limb(x0, x1, x2, x3, t0, t1, t2, t3, limb_index)
    }
    if term_sign == 0 {
        if limb_index == 0 { return x0 }
        if limb_index == 1 { return x1 }
        if limb_index == 2 { return x2 }
        if limb_index == 3 { return x3 }
        return 0 - 1
    }

    let subtract_ok = lorenz_i256_signed_delta_sign(x0, x1, x2, x3, t0, t1, t2, t3)
    if subtract_ok < 0 { return 0 - 1 }
    return lorenz_i256_signed_delta_abs_limb(x0, x1, x2, x3, t0, t1, t2, t3, limb_index)
}

pub fn lorenz_i256_x_step_check(
    x0: i64,
    x1: i64,
    x2: i64,
    x3: i64,
    y0: i64,
    y1: i64,
    y2: i64,
    y3: i64,
    expected_l0: i64,
    expected_l1: i64,
    expected_l2: i64,
    expected_l3: i64) -> i64 with Div {
    let r0 = lorenz_i256_x_step_limb(x0, x1, x2, x3, y0, y1, y2, y3, 0)
    let r1 = lorenz_i256_x_step_limb(x0, x1, x2, x3, y0, y1, y2, y3, 1)
    let r2 = lorenz_i256_x_step_limb(x0, x1, x2, x3, y0, y1, y2, y3, 2)
    let r3 = lorenz_i256_x_step_limb(x0, x1, x2, x3, y0, y1, y2, y3, 3)
    if r0 != expected_l0 { return 0 }
    if r1 != expected_l1 { return 0 }
    if r2 != expected_l2 { return 0 }
    if r3 != expected_l3 { return 0 }
    return 1
}

pub fn lorenz_i256_x_step_bridge_receipt_check(
    positive_step_ok: i64,
    negative_step_ok: i64,
    zero_step_ok: i64,
    underflow_rejected: i64,
    sigma_term_anchor_ok: i64,
    target_integer_width: i64,
    limb_base: i64,
    native_i256_evidence_mask: i64,
    imported_runtime_evidence_mask: i64,
    bridge_status: i64) -> i64 {
    if positive_step_ok != 1 { return 0 - 1 }
    if negative_step_ok != 1 { return 0 - 1 }
    if zero_step_ok != 1 { return 0 - 1 }
    if underflow_rejected != 1 { return 0 - 1 }
    if sigma_term_anchor_ok != 1 { return 0 - 1 }
    if target_integer_width != 256 { return 0 - 1 }
    if limb_base != 1000000000 { return 0 - 1 }
    if native_i256_evidence_mask != 0 { return 0 - 1 }
    if imported_runtime_evidence_mask != 0 { return 0 - 1 }
    if bridge_status != 106 { return 0 - 1 }
    return 645218970
}

pub fn lorenz_i256_x_step_bridge_audit_fingerprint(
    artifact_fp: i64,
    instance_fp: i64,
    certificate_fp: i64,
    sigma_x_term_fp: i64,
    sigma_x_term_audit_fp: i64,
    positive_step_ok: i64,
    negative_step_ok: i64,
    zero_step_ok: i64,
    underflow_rejected: i64,
    target_integer_width: i64,
    limb_base: i64,
    native_i256_evidence_mask: i64,
    imported_runtime_evidence_mask: i64,
    public_claim_mask: i64,
    formal_theorem_ready: i64,
    bridge_status: i64,
    ok_mask: i64) -> i64 {
    if artifact_fp != 645218970 { return 0 - 1 }
    if instance_fp != 927405816 { return 0 - 1 }
    if certificate_fp != 360918274 { return 0 - 1 }
    if sigma_x_term_fp != 318704692 { return 0 - 1 }
    if sigma_x_term_audit_fp != 729516083 { return 0 - 1 }
    if positive_step_ok != 1 { return 0 - 1 }
    if negative_step_ok != 1 { return 0 - 1 }
    if zero_step_ok != 1 { return 0 - 1 }
    if underflow_rejected != 1 { return 0 - 1 }
    if target_integer_width != 256 { return 0 - 1 }
    if limb_base != 1000000000 { return 0 - 1 }
    if native_i256_evidence_mask != 0 { return 0 - 1 }
    if imported_runtime_evidence_mask != 0 { return 0 - 1 }
    if public_claim_mask != 0 { return 0 - 1 }
    if formal_theorem_ready != 0 { return 0 - 1 }
    if bridge_status != 106 { return 0 - 1 }
    if ok_mask != 1023 { return 0 - 1 }
    return 184760392
}
