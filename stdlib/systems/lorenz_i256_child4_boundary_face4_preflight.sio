//! stdlib/systems/lorenz_i256_child4_boundary_face4_preflight.sio
//!
//! Face-4 boundary-gluing preflight for child-4 in the Lorenz i256 cover lane.
//! This completes the face-local preflight chain, but does not verify any face,
//! prove gluing, discharge child-4, or certify any finite-cover/global flowpipe
//! claim.

pub fn lorenz_i256_cover_child4_boundary_face4_preflight_check(
    child4_boundary_face3_preflight_fp: i64,
    child4_boundary_face3_preflight_audit_fp: i64,
    child4_boundary_face_obligations_fp: i64,
    child4_boundary_face_obligations_audit_fp: i64,
    boundary_gluing_obligation_mask: i64,
    face_obligation_mask: i64,
    prior_face_preflight_mask: i64,
    selected_face_index: i64,
    selected_face_mask: i64,
    face4_obligation_mask: i64,
    face4_verified_mask: i64,
    face4_proof_mask: i64,
    boundary_gluing_verified_mask: i64,
    boundary_gluing_proof_mask: i64,
    finite_cover_certificate_mask: i64,
    global_certificate_candidate_mask: i64,
    global_flowpipe_claim_mask: i64,
    face4_preflight_status: i64) -> i64 with Mod {
    var anchor_mask: i64 = 0
    if child4_boundary_face3_preflight_fp == 371946280 {
        if child4_boundary_face3_preflight_audit_fp == 809527416 {
            anchor_mask = anchor_mask + 1
        }
    }
    if child4_boundary_face_obligations_fp == 458306927 {
        if child4_boundary_face_obligations_audit_fp == 766184391 {
            anchor_mask = anchor_mask + 2
        }
    }
    if boundary_gluing_obligation_mask == 31 { anchor_mask = anchor_mask + 4 }
    if face_obligation_mask == 31 { anchor_mask = anchor_mask + 8 }
    if face4_preflight_status == 85 { anchor_mask = anchor_mask + 16 }

    let boundary_face_count: i64 = 5
    let face4_topology_mask: i64 = 16
    let face4_orientation_mask: i64 = 16
    let face4_adjacency_mask: i64 = 16
    let face4_trace_mask: i64 = 16
    let face4_dependency_mask: i64 = 31
    let face4_preflight_mask: i64 = 16
    let face_preflight_progress_mask: i64 = 31
    let face4_pending_proof_mask: i64 = 16
    let solver_face4_action_mask: i64 = 16
    let ready_for_face4_proof_mask: i64 = 0

    var selected_face_ok: i64 = 1
    if prior_face_preflight_mask != 15 { selected_face_ok = 0 }
    if selected_face_index != 4 { selected_face_ok = 0 }
    if selected_face_mask != 16 { selected_face_ok = 0 }
    if face4_obligation_mask != 16 { selected_face_ok = 0 }

    var preflight_ok: i64 = 1
    if boundary_face_count != 5 { preflight_ok = 0 }
    if face4_topology_mask != 16 { preflight_ok = 0 }
    if face4_orientation_mask != 16 { preflight_ok = 0 }
    if face4_adjacency_mask != 16 { preflight_ok = 0 }
    if face4_trace_mask != 16 { preflight_ok = 0 }
    if face4_dependency_mask != 31 { preflight_ok = 0 }
    if face4_preflight_mask != 16 { preflight_ok = 0 }
    if face_preflight_progress_mask != 31 { preflight_ok = 0 }
    if face4_pending_proof_mask != 16 { preflight_ok = 0 }
    if solver_face4_action_mask != 16 { preflight_ok = 0 }
    if ready_for_face4_proof_mask != 0 { preflight_ok = 0 }

    var nonclaim_ok: i64 = 1
    if face4_verified_mask != 0 { nonclaim_ok = 0 }
    if face4_proof_mask != 0 { nonclaim_ok = 0 }
    if boundary_gluing_verified_mask != 0 { nonclaim_ok = 0 }
    if boundary_gluing_proof_mask != 0 { nonclaim_ok = 0 }
    if finite_cover_certificate_mask != 0 { nonclaim_ok = 0 }
    if global_certificate_candidate_mask != 0 { nonclaim_ok = 0 }
    if global_flowpipe_claim_mask != 0 { nonclaim_ok = 0 }

    var ok_mask: i64 = 0
    if anchor_mask == 31 { ok_mask = ok_mask + 1 }
    if selected_face_ok == 1 { ok_mask = ok_mask + 2 }
    if preflight_ok == 1 { ok_mask = ok_mask + 4 }
    if nonclaim_ok == 1 { ok_mask = ok_mask + 8 }
    if boundary_gluing_obligation_mask == 31 { ok_mask = ok_mask + 16 }
    if face_preflight_progress_mask == 31 { ok_mask = ok_mask + 32 }
    if ready_for_face4_proof_mask == 0 { ok_mask = ok_mask + 64 }
    if face4_preflight_status == 85 { ok_mask = ok_mask + 128 }

    if ok_mask != 255 { return 0 - 1 }
    return 486720951
}

pub fn lorenz_i256_cover_child4_boundary_face4_preflight_audit_fingerprint(
    artifact_fp: i64,
    instance_fp: i64,
    certificate_fp: i64,
    child4_boundary_face3_preflight_fp: i64,
    child4_boundary_face3_preflight_audit_fp: i64,
    child4_boundary_face_obligations_fp: i64,
    child4_boundary_face_obligations_audit_fp: i64,
    boundary_gluing_obligation_mask: i64,
    face_obligation_mask: i64,
    boundary_face_count: i64,
    prior_face_preflight_mask: i64,
    selected_face_index: i64,
    selected_face_mask: i64,
    face4_obligation_mask: i64,
    face4_topology_mask: i64,
    face4_orientation_mask: i64,
    face4_adjacency_mask: i64,
    face4_trace_mask: i64,
    face4_dependency_mask: i64,
    face4_preflight_mask: i64,
    face_preflight_progress_mask: i64,
    face4_pending_proof_mask: i64,
    solver_face4_action_mask: i64,
    ready_for_face4_proof_mask: i64,
    face4_verified_mask: i64,
    face4_proof_mask: i64,
    boundary_gluing_verified_mask: i64,
    boundary_gluing_proof_mask: i64,
    finite_cover_certificate_mask: i64,
    global_certificate_candidate_mask: i64,
    global_flowpipe_claim_mask: i64,
    face4_preflight_status: i64,
    ok_mask: i64) -> i64 with Mod {
    if artifact_fp != 486720951 { return 0 - 1 }
    if instance_fp != 918374062 { return 0 - 1 }
    if certificate_fp != 604283791 { return 0 - 1 }
    if child4_boundary_face3_preflight_fp != 371946280 { return 0 - 1 }
    if child4_boundary_face3_preflight_audit_fp != 809527416 { return 0 - 1 }
    if child4_boundary_face_obligations_fp != 458306927 { return 0 - 1 }
    if child4_boundary_face_obligations_audit_fp != 766184391 { return 0 - 1 }
    if boundary_gluing_obligation_mask != 31 { return 0 - 1 }
    if face_obligation_mask != 31 { return 0 - 1 }
    if boundary_face_count != 5 { return 0 - 1 }
    if prior_face_preflight_mask != 15 { return 0 - 1 }
    if selected_face_index != 4 { return 0 - 1 }
    if selected_face_mask != 16 { return 0 - 1 }
    if face4_obligation_mask != 16 { return 0 - 1 }
    if face4_topology_mask != 16 { return 0 - 1 }
    if face4_orientation_mask != 16 { return 0 - 1 }
    if face4_adjacency_mask != 16 { return 0 - 1 }
    if face4_trace_mask != 16 { return 0 - 1 }
    if face4_dependency_mask != 31 { return 0 - 1 }
    if face4_preflight_mask != 16 { return 0 - 1 }
    if face_preflight_progress_mask != 31 { return 0 - 1 }
    if face4_pending_proof_mask != 16 { return 0 - 1 }
    if solver_face4_action_mask != 16 { return 0 - 1 }
    if ready_for_face4_proof_mask != 0 { return 0 - 1 }
    if face4_verified_mask != 0 { return 0 - 1 }
    if face4_proof_mask != 0 { return 0 - 1 }
    if boundary_gluing_verified_mask != 0 { return 0 - 1 }
    if boundary_gluing_proof_mask != 0 { return 0 - 1 }
    if finite_cover_certificate_mask != 0 { return 0 - 1 }
    if global_certificate_candidate_mask != 0 { return 0 - 1 }
    if global_flowpipe_claim_mask != 0 { return 0 - 1 }
    if face4_preflight_status != 85 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }
    return 730519284
}
