//! stdlib/systems/lorenz_i256_y_step_bounded_bridge.sio
//!
//! Portable Lorenz y-axis bounded step over decimal i256-like limbs. This
//! applies dt=1 to the bounded y-derivative bridge x*(rho-z)-y. It is not a
//! complete Lorenz stepper or a general signed-state integrator.

use systems::lorenz_i256_y_derivative_bounded_bridge::*
use systems::lorenz_i256_limb_bridge::*
use systems::lorenz_i256_signed_delta_bridge::*

pub fn lorenz_i256_y_step_bounded_limb(
    x0: i64,
    x1: i64,
    x2: i64,
    x3: i64,
    y0: i64,
    y1: i64,
    y2: i64,
    y3: i64,
    z0: i64,
    z1: i64,
    z2: i64,
    z3: i64,
    limb_index: i64) -> i64 with Div {
    let term_sign = lorenz_i256_y_derivative_bounded_sign(x0, x1, x2, x3, z0, z1, z2, z3, y0, y1, y2, y3)
    let t0 = lorenz_i256_y_derivative_bounded_abs_limb(x0, x1, x2, x3, z0, z1, z2, z3, y0, y1, y2, y3, 0)
    let t1 = lorenz_i256_y_derivative_bounded_abs_limb(x0, x1, x2, x3, z0, z1, z2, z3, y0, y1, y2, y3, 1)
    let t2 = lorenz_i256_y_derivative_bounded_abs_limb(x0, x1, x2, x3, z0, z1, z2, z3, y0, y1, y2, y3, 2)
    let t3 = lorenz_i256_y_derivative_bounded_abs_limb(x0, x1, x2, x3, z0, z1, z2, z3, y0, y1, y2, y3, 3)
    if term_sign == 0 - 2 { return 0 - 1 }
    if t0 < 0 { return 0 - 1 }
    if t1 < 0 { return 0 - 1 }
    if t2 < 0 { return 0 - 1 }
    if t3 < 0 { return 0 - 1 }

    if term_sign > 0 {
        return lorenz_dec4_add_limb(y0, y1, y2, y3, t0, t1, t2, t3, limb_index)
    }
    if term_sign == 0 {
        if limb_index == 0 { return y0 }
        if limb_index == 1 { return y1 }
        if limb_index == 2 { return y2 }
        if limb_index == 3 { return y3 }
        return 0 - 1
    }

    let subtract_ok = lorenz_i256_signed_delta_sign(y0, y1, y2, y3, t0, t1, t2, t3)
    if subtract_ok < 0 { return 0 - 1 }
    return lorenz_i256_signed_delta_abs_limb(y0, y1, y2, y3, t0, t1, t2, t3, limb_index)
}

pub fn lorenz_i256_y_step_bounded_check(
    x0: i64,
    x1: i64,
    x2: i64,
    x3: i64,
    y0: i64,
    y1: i64,
    y2: i64,
    y3: i64,
    z0: i64,
    z1: i64,
    z2: i64,
    z3: i64,
    expected_l0: i64,
    expected_l1: i64,
    expected_l2: i64,
    expected_l3: i64) -> i64 with Div {
    let r0 = lorenz_i256_y_step_bounded_limb(x0, x1, x2, x3, y0, y1, y2, y3, z0, z1, z2, z3, 0)
    let r1 = lorenz_i256_y_step_bounded_limb(x0, x1, x2, x3, y0, y1, y2, y3, z0, z1, z2, z3, 1)
    let r2 = lorenz_i256_y_step_bounded_limb(x0, x1, x2, x3, y0, y1, y2, y3, z0, z1, z2, z3, 2)
    let r3 = lorenz_i256_y_step_bounded_limb(x0, x1, x2, x3, y0, y1, y2, y3, z0, z1, z2, z3, 3)
    if r0 != expected_l0 { return 0 }
    if r1 != expected_l1 { return 0 }
    if r2 != expected_l2 { return 0 }
    if r3 != expected_l3 { return 0 }
    return 1
}

pub fn lorenz_i256_y_step_bounded_bridge_receipt_check(
    positive_step_ok: i64,
    negative_step_ok: i64,
    zero_step_ok: i64,
    underflow_rejected: i64,
    derivative_anchor_ok: i64,
    limb_add_anchor_ok: i64,
    target_integer_width: i64,
    limb_base: i64,
    native_i256_evidence_mask: i64,
    imported_runtime_evidence_mask: i64,
    bridge_status: i64) -> i64 {
    if positive_step_ok != 1 { return 0 - 1 }
    if negative_step_ok != 1 { return 0 - 1 }
    if zero_step_ok != 1 { return 0 - 1 }
    if underflow_rejected != 1 { return 0 - 1 }
    if derivative_anchor_ok != 1 { return 0 - 1 }
    if limb_add_anchor_ok != 1 { return 0 - 1 }
    if target_integer_width != 256 { return 0 - 1 }
    if limb_base != 1000000000 { return 0 - 1 }
    if native_i256_evidence_mask != 0 { return 0 - 1 }
    if imported_runtime_evidence_mask != 0 { return 0 - 1 }
    if bridge_status != 111 { return 0 - 1 }
    return 286140975
}

pub fn lorenz_i256_y_step_bounded_bridge_audit_fingerprint(
    artifact_fp: i64,
    instance_fp: i64,
    certificate_fp: i64,
    derivative_fp: i64,
    derivative_audit_fp: i64,
    limb_add_fp: i64,
    limb_add_audit_fp: i64,
    positive_step_ok: i64,
    negative_step_ok: i64,
    zero_step_ok: i64,
    underflow_rejected: i64,
    target_integer_width: i64,
    limb_base: i64,
    native_i256_evidence_mask: i64,
    imported_runtime_evidence_mask: i64,
    public_claim_mask: i64,
    formal_theorem_ready: i64,
    bridge_status: i64,
    ok_mask: i64) -> i64 {
    if artifact_fp != 286140975 { return 0 - 1 }
    if instance_fp != 731064852 { return 0 - 1 }
    if certificate_fp != 508216749 { return 0 - 1 }
    if derivative_fp != 742619083 { return 0 - 1 }
    if derivative_audit_fp != 396508712 { return 0 - 1 }
    if limb_add_fp != 681429570 { return 0 - 1 }
    if limb_add_audit_fp != 352908746 { return 0 - 1 }
    if positive_step_ok != 1 { return 0 - 1 }
    if negative_step_ok != 1 { return 0 - 1 }
    if zero_step_ok != 1 { return 0 - 1 }
    if underflow_rejected != 1 { return 0 - 1 }
    if target_integer_width != 256 { return 0 - 1 }
    if limb_base != 1000000000 { return 0 - 1 }
    if native_i256_evidence_mask != 0 { return 0 - 1 }
    if imported_runtime_evidence_mask != 0 { return 0 - 1 }
    if public_claim_mask != 0 { return 0 - 1 }
    if formal_theorem_ready != 0 { return 0 - 1 }
    if bridge_status != 111 { return 0 - 1 }
    if ok_mask != 1023 { return 0 - 1 }
    return 653928410
}
