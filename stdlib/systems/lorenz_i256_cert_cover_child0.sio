pub fn lorenz_i256_cover_child0_obligation_seed_check(
    cover_refinement_ledger_fp: i64,
    cover_refinement_ledger_audit_fp: i64,
    v150_portfolio_entry_fp: i64,
    v150_manifest_fp: i64,
    v150_readiness_fp: i64,
    finite_cover_candidate_fp: i64,
    finite_cover_candidate_audit_fp: i64,
    dependency_dag_fp: i64,
    dependency_dag_audit_fp: i64,
    projection_certificate_envelope_fp: i64,
    projection_certificate_envelope_audit_fp: i64,
    child_index: i64,
    child_x_slot: i64,
    child_y_slot: i64,
    child_z_slot: i64,
    global_flowpipe_claim_mask: i64,
    obligation_status: i64) -> i64 with Mod {
    var inherited_anchor_mask: i64 = 0
    if cover_refinement_ledger_fp == 239912256 {
        if cover_refinement_ledger_audit_fp == 937619929 { inherited_anchor_mask = inherited_anchor_mask + 1 }
    }
    if finite_cover_candidate_fp == 911169246 {
        if finite_cover_candidate_audit_fp == 785916873 { inherited_anchor_mask = inherited_anchor_mask + 2 }
    }
    if dependency_dag_fp == 713010204 {
        if dependency_dag_audit_fp == 725222703 { inherited_anchor_mask = inherited_anchor_mask + 4 }
    }
    if projection_certificate_envelope_fp == 77888110 {
        if projection_certificate_envelope_audit_fp == 245178976 { inherited_anchor_mask = inherited_anchor_mask + 8 }
    }

    var child_coordinate_mask: i64 = 0
    if child_index == 0 { child_coordinate_mask = child_coordinate_mask + 1 }
    if child_x_slot == 0 {
        if child_y_slot == 0 {
            if child_z_slot == 0 { child_coordinate_mask = child_coordinate_mask + 2 }
        }
    }
    let split_axis_count: i64 = 3
    let split_factor_per_axis: i64 = 2
    let child_cell_count: i64 = 8
    if split_axis_count == 3 {
        if split_factor_per_axis == 2 {
            if child_cell_count == 8 { child_coordinate_mask = child_coordinate_mask + 4 }
        }
    }

    let parent_refinement_level: i64 = 1
    let child_refinement_level: i64 = 1
    let selected_child_count: i64 = 1
    let pending_child_obligation_count: i64 = 8
    let resolved_child_count: i64 = 0
    let source_width_bits: i64 = 256
    let scale_log2: i64 = 32
    let target_scale: i64 = 1000000
    let step_count: i64 = 5
    let selected_child_mask: i64 = 1
    let local_flowpipe_proof_mask: i64 = 0
    let child_validated_mask: i64 = 0
    let global_cover_certificate_mask: i64 = 0
    let obligation_version: i64 = 1

    var portfolio_anchor_ok: i64 = 1
    if v150_portfolio_entry_fp != 974395903 { portfolio_anchor_ok = 0 }
    if v150_manifest_fp != 568368767 { portfolio_anchor_ok = 0 }
    if v150_readiness_fp != 228495843 { portfolio_anchor_ok = 0 }

    var nonclaim_ok: i64 = 1
    if local_flowpipe_proof_mask != 0 { nonclaim_ok = 0 }
    if child_validated_mask != 0 { nonclaim_ok = 0 }
    if global_cover_certificate_mask != 0 { nonclaim_ok = 0 }
    if global_flowpipe_claim_mask != 0 { nonclaim_ok = 0 }
    if obligation_status != 30 { nonclaim_ok = 0 }

    var contract_ok: i64 = 1
    if source_width_bits != 256 { contract_ok = 0 }
    if scale_log2 != 32 { contract_ok = 0 }
    if target_scale != 1000000 { contract_ok = 0 }
    if step_count != 5 { contract_ok = 0 }
    if pending_child_obligation_count != 8 { contract_ok = 0 }
    if resolved_child_count != 0 { contract_ok = 0 }

    var ok_mask: i64 = 0
    if inherited_anchor_mask == 15 { ok_mask = ok_mask + 1 }
    if child_coordinate_mask == 7 { ok_mask = ok_mask + 2 }
    if portfolio_anchor_ok == 1 { ok_mask = ok_mask + 4 }
    if selected_child_mask == 1 { ok_mask = ok_mask + 8 }
    if selected_child_count == 1 { ok_mask = ok_mask + 16 }
    if nonclaim_ok == 1 { ok_mask = ok_mask + 32 }
    if contract_ok == 1 { ok_mask = ok_mask + 64 }
    if obligation_version == 1 { ok_mask = ok_mask + 128 }
    if ok_mask != 255 { return 0 - 1 }

    let instance_fp = lorenz_i256_cover_child0_obligation_seed_instance_fingerprint(
        cover_refinement_ledger_fp, cover_refinement_ledger_audit_fp,
        v150_portfolio_entry_fp, v150_manifest_fp, v150_readiness_fp,
        finite_cover_candidate_fp, finite_cover_candidate_audit_fp,
        dependency_dag_fp, dependency_dag_audit_fp,
        projection_certificate_envelope_fp,
        projection_certificate_envelope_audit_fp, child_index, child_x_slot,
        child_y_slot, child_z_slot, split_axis_count, split_factor_per_axis,
        child_cell_count, parent_refinement_level, child_refinement_level,
        selected_child_count, pending_child_obligation_count,
        resolved_child_count, source_width_bits, scale_log2, target_scale,
        step_count, selected_child_mask, child_coordinate_mask,
