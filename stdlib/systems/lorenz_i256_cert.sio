    validated_enclosure_mask: i64,
    validator_status_guarded: i64,
    global_flowpipe_claim_mask: i64) -> i64 with Mod {
    var anchor_ok: i64 = 1
    if replay_executor_fp != 424013491 { anchor_ok = 0 }
    if completed_bundle_fp != 725374434 { anchor_ok = 0 }
    if radius_artifact_fp != 443171640 { anchor_ok = 0 }
