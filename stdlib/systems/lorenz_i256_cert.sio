pub fn lorenz_i256_step1_taylor2_remainder_obligation_check(
    x_lte_cap_ppm: i64,
    y_lte_cap_ppm: i64,
    z_lte_cap_ppm: i64,
    global_flowpipe_claim_mask: i64) -> i64 with Mod {
    let source_scale: i256 = 4294967296 as i256
    let target_scale: i256 = 1000000 as i256
    let dt_q: i256 = 42949672 as i256
    let start_x: i256 = 4294967296 as i256
    let start_y: i256 = 5411658768 as i256
    let start_z: i256 = 4223384510 as i256
    let rx: i256 = 4295 as i256
    let ry: i256 = 1116695792 as i256
    let rz: i256 = 71584220 as i256

    let x_abs: i256 = 4294971591 as i256
    let y_abs: i256 = 6528354560 as i256
    let z_abs: i256 = 4294968730 as i256
    let rhoz_abs: i256 = 116107283998 as i256
    let x_prime: i256 = 108233261510 as i256
    let y_prime: i256 = 122635754667 as i256
    let z_prime: i256 = 17981611036 as i256
    let x_second: i256 = 2308690161770 as i256
    let y_second: i256 = 3066523255862 as i256
    let z_second: i256 = 335101505169 as i256
    let x_lte_source: i256 = 115434503 as i256
    let y_lte_source: i256 = 153326156 as i256
    let z_lte_source: i256 = 16755075 as i256
    let x_lte_ppm: i256 = 26877 as i256
    let y_lte_ppm: i256 = 35700 as i256
    let z_lte_ppm: i256 = 3902 as i256
    let den: i256 = (2 as i256) * source_scale * source_scale

    var abs_box_ok: i64 = 1
    if x_abs != start_x + rx { abs_box_ok = 0 }
    if y_abs != start_y + ry { abs_box_ok = 0 }
    if z_abs != start_z + rz { abs_box_ok = 0 }
    if rhoz_abs != (28 as i256) * source_scale - (start_z - rz) { abs_box_ok = 0 }

    let y_prime_product: i256 = x_abs * rhoz_abs
    let xy_product: i256 = x_abs * y_abs
    let beta_z_product: i256 = (8 as i256) * z_abs
    var first_derivative_ok: i64 = 1
    if x_prime != (10 as i256) * (x_abs + y_abs) { first_derivative_ok = 0 }
    if (y_prime - y_abs - (1 as i256)) * source_scale >= y_prime_product {
        first_derivative_ok = 0
    }
    if (y_prime - y_abs) * source_scale < y_prime_product {
        first_derivative_ok = 0
    }
    if ((6528361089 as i256) - (1 as i256)) * source_scale >= xy_product {
        first_derivative_ok = 0
    }
    if (6528361089 as i256) * source_scale < xy_product {
        first_derivative_ok = 0
    }
    if ((11453249947 as i256) - (1 as i256)) * (3 as i256) >= beta_z_product {
        first_derivative_ok = 0
    }
    if (11453249947 as i256) * (3 as i256) < beta_z_product {
        first_derivative_ok = 0
    }
    if z_prime != (6528361089 as i256) + (11453249947 as i256) {
        first_derivative_ok = 0
    }

    let y_second_a: i256 = x_prime * rhoz_abs
    let y_second_b: i256 = x_abs * z_prime
    let z_second_a: i256 = x_prime * y_abs
    let z_second_b: i256 = x_abs * y_prime
    let z_second_c: i256 = (8 as i256) * z_prime
    var second_derivative_ok: i64 = 1
    if x_second != (10 as i256) * (y_prime + x_prime) { second_derivative_ok = 0 }
    if ((2925905872177 as i256) - (1 as i256)) * source_scale >= y_second_a {
        second_derivative_ok = 0
    }
    if (2925905872177 as i256) * source_scale < y_second_a {
        second_derivative_ok = 0
    }
    if ((17981629018 as i256) - (1 as i256)) * source_scale >= y_second_b {
        second_derivative_ok = 0
    }
    if (17981629018 as i256) * source_scale < y_second_b {
        second_derivative_ok = 0
    }
    if y_second != (2925905872177 as i256) + (17981629018 as i256) + y_prime {
        second_derivative_ok = 0
    }
    if ((164514665102 as i256) - (1 as i256)) * source_scale >= z_second_a {
        second_derivative_ok = 0
    }
    if (164514665102 as i256) * source_scale < z_second_a {
        second_derivative_ok = 0
    }
    if ((122635877304 as i256) - (1 as i256)) * source_scale >= z_second_b {
        second_derivative_ok = 0
    }
    if (122635877304 as i256) * source_scale < z_second_b {
        second_derivative_ok = 0
    }
    if ((47950962763 as i256) - (1 as i256)) * (3 as i256) >= z_second_c {
        second_derivative_ok = 0
    }
    if (47950962763 as i256) * (3 as i256) < z_second_c {
        second_derivative_ok = 0
    }
    if z_second != (164514665102 as i256) + (122635877304 as i256) + (47950962763 as i256) {
        second_derivative_ok = 0
    }

    let dt2: i256 = dt_q * dt_q
    var source_lte_ok: i64 = 1
    if (x_lte_source - (1 as i256)) * den >= x_second * dt2 { source_lte_ok = 0 }
    if x_lte_source * den < x_second * dt2 { source_lte_ok = 0 }
    if (y_lte_source - (1 as i256)) * den >= y_second * dt2 { source_lte_ok = 0 }
    if y_lte_source * den < y_second * dt2 { source_lte_ok = 0 }
    if (z_lte_source - (1 as i256)) * den >= z_second * dt2 { source_lte_ok = 0 }
    if z_lte_source * den < z_second * dt2 { source_lte_ok = 0 }

    var target_lte_ok: i64 = 1
    if (x_lte_ppm - (1 as i256)) * source_scale >= x_lte_source * target_scale {
        target_lte_ok = 0
    }
    if x_lte_ppm * source_scale < x_lte_source * target_scale {
        target_lte_ok = 0
    }
    if (y_lte_ppm - (1 as i256)) * source_scale >= y_lte_source * target_scale {
        target_lte_ok = 0
    }
    if y_lte_ppm * source_scale < y_lte_source * target_scale {
        target_lte_ok = 0
    }
    if (z_lte_ppm - (1 as i256)) * source_scale >= z_lte_source * target_scale {
        target_lte_ok = 0
    }
    if z_lte_ppm * source_scale < z_lte_source * target_scale {
        target_lte_ok = 0
    }

    var cap_ok: i64 = 1
    if x_lte_cap_ppm != 35000 { cap_ok = 0 }
    if y_lte_cap_ppm != 45000 { cap_ok = 0 }
    if z_lte_cap_ppm != 10000 { cap_ok = 0 }
    if (x_lte_cap_ppm as i256) - x_lte_ppm != 8123 as i256 { cap_ok = 0 }
    if (y_lte_cap_ppm as i256) - y_lte_ppm != 9300 as i256 { cap_ok = 0 }
    if (z_lte_cap_ppm as i256) - z_lte_ppm != 6098 as i256 { cap_ok = 0 }

    let local_remainder_proof_mask: i64 = 0
    var nonclaim_ok: i64 = 1
    if local_remainder_proof_mask != 0 { nonclaim_ok = 0 }
    if global_flowpipe_claim_mask != 0 { nonclaim_ok = 0 }

    var ok_mask: i64 = 0
    if abs_box_ok == 1 { ok_mask = ok_mask + 1 }
    if first_derivative_ok == 1 { ok_mask = ok_mask + 2 }
    if second_derivative_ok == 1 { ok_mask = ok_mask + 4 }
    if source_lte_ok == 1 { ok_mask = ok_mask + 8 }
    if target_lte_ok == 1 { ok_mask = ok_mask + 16 }
    if cap_ok == 1 { ok_mask = ok_mask + 32 }
    if nonclaim_ok == 1 { ok_mask = ok_mask + 64 }
    if ok_mask != 127 { return 0 - 1 }

    let instance_fp = lorenz_i256_step1_taylor2_remainder_obligation_instance_fingerprint(
        1, 4294967296, 1000000, 42949672, 496675613, 467471545,
        472667880, 286326819, 133154696, 194048456, 4294967296,
        5411658768, 4223384510, 4295, 1116695792, 71584220,
        local_remainder_proof_mask, global_flowpipe_claim_mask)
    let certificate_fp = lorenz_i256_step1_taylor2_remainder_obligation_certificate_fingerprint(
        instance_fp, 4294971591, 6528354560, 4294968730, 116107283998,
        108233261510, 122635754667, 17981611036, 2308690161770,
        3066523255862, 335101505169, 115434503, 153326156, 16755075,
        26877, 35700, 3902, x_lte_cap_ppm, y_lte_cap_ppm,
        z_lte_cap_ppm, 8123, 9300, 6098, ok_mask,
        local_remainder_proof_mask, global_flowpipe_claim_mask)

    return lorenz_i256_step1_taylor2_remainder_obligation_fingerprint(
        instance_fp, certificate_fp, 496675613, 467471545, 472667880,
        286326819, 133154696, 194048456, 5, 1, 26877, 35700, 3902,
        x_lte_cap_ppm, y_lte_cap_ppm, z_lte_cap_ppm, ok_mask,
        local_remainder_proof_mask, global_flowpipe_claim_mask)
}

