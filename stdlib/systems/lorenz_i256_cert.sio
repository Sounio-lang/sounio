pub fn lorenz_i256_step6_taylor2_local_containment_obligation_check(
    taylor2_link_preflight_fp: i64,
    taylor2_link_preflight_audit_fp: i64,
    repaired_projection_inclusion_fp: i64,
    repaired_projection_inclusion_audit_fp: i64,
    remainder_obligation_fp: i64,
    remainder_obligation_audit_fp: i64,
    z_margin_repair_fp: i64,
    z_margin_repair_audit_fp: i64,
    global_flowpipe_claim_mask: i64,
    obligation_status_local: i64) -> i64 with Mod {
    var anchor_ok: i64 = 1
    if taylor2_link_preflight_fp != 956152878 { anchor_ok = 0 }
    if taylor2_link_preflight_audit_fp != 916252082 { anchor_ok = 0 }
    if repaired_projection_inclusion_fp != 316597079 { anchor_ok = 0 }
    if repaired_projection_inclusion_audit_fp != 476878195 { anchor_ok = 0 }

    var remainder_anchor_ok: i64 = 1
    if remainder_obligation_fp != 652877359 { remainder_anchor_ok = 0 }
    if remainder_obligation_audit_fp != 344816971 { remainder_anchor_ok = 0 }
    if z_margin_repair_fp != 617386880 { remainder_anchor_ok = 0 }
    if z_margin_repair_audit_fp != 478471574 { remainder_anchor_ok = 0 }

    let x_projected_radius: i64 = 243366
    let y_projected_radius: i64 = 319640
    let z_projected_radius: i64 = 42448
    let x_lte: i64 = 47276
    let y_lte: i64 = 66549
    let z_lte: i64 = 12083
    let x_need: i64 = x_projected_radius + x_lte
    let y_need: i64 = y_projected_radius + y_lte
    let z_need: i64 = z_projected_radius + z_lte
    let x_margin: i64 = 299663
    let y_margin: i64 = 389292
    let z_margin: i64 = 55000
    let x_slack: i64 = x_margin - x_need
    let y_slack: i64 = y_margin - y_need
    let z_slack: i64 = z_margin - z_need

    var decomposition_ok: i64 = 1
    if x_need != 290642 { decomposition_ok = 0 }
    if y_need != 386189 { decomposition_ok = 0 }
    if z_need != 54531 { decomposition_ok = 0 }
    if x_slack != 9021 { decomposition_ok = 0 }
    if y_slack != 3103 { decomposition_ok = 0 }
    if z_slack != 469 { decomposition_ok = 0 }

    var axis_containment_mask: i64 = 0
    if x_need <= x_margin { axis_containment_mask = axis_containment_mask + 1 }
    if y_need <= y_margin { axis_containment_mask = axis_containment_mask + 2 }
    if z_need <= z_margin { axis_containment_mask = axis_containment_mask + 4 }

    var axis_containment_ok: i64 = 1
    if axis_containment_mask != 7 { axis_containment_ok = 0 }
    if x_slack <= 0 { axis_containment_ok = 0 }
    if y_slack <= 0 { axis_containment_ok = 0 }
    if z_slack <= 0 { axis_containment_ok = 0 }

    let taylor_order: i64 = 2
    let target_scale: i64 = 1000000
    let selected_dt_num: i64 = 1
    let selected_dt_den: i64 = 100

    var taylor_contract_ok: i64 = 1
    if taylor_order != 2 { taylor_contract_ok = 0 }
    if target_scale != 1000000 { taylor_contract_ok = 0 }
    if selected_dt_num != 1 { taylor_contract_ok = 0 }
    if selected_dt_den != 100 { taylor_contract_ok = 0 }

    let local_flowpipe_obligation_mask: i64 = axis_containment_mask
    var local_obligation_ok: i64 = 1
    if local_flowpipe_obligation_mask != 7 { local_obligation_ok = 0 }
    if obligation_status_local != 12 { local_obligation_ok = 0 }

    var non_global_claim_ok: i64 = 1
    if global_flowpipe_claim_mask != 0 { non_global_claim_ok = 0 }

    var repair_consumption_ok: i64 = 1
    if z_margin != 55000 { repair_consumption_ok = 0 }
    if z_slack != 469 { repair_consumption_ok = 0 }

    var ok_mask: i64 = 0
    if anchor_ok == 1 { ok_mask = ok_mask + 1 }
    if remainder_anchor_ok == 1 { ok_mask = ok_mask + 2 }
    if decomposition_ok == 1 { ok_mask = ok_mask + 4 }
    if axis_containment_ok == 1 { ok_mask = ok_mask + 8 }
    if taylor_contract_ok == 1 { ok_mask = ok_mask + 16 }
    if local_obligation_ok == 1 { ok_mask = ok_mask + 32 }
    if non_global_claim_ok == 1 { ok_mask = ok_mask + 64 }
    if repair_consumption_ok == 1 { ok_mask = ok_mask + 128 }
    if ok_mask != 255 { return 0 - 1 }

    let instance_fp = lorenz_i256_step6_taylor2_local_containment_obligation_instance_fingerprint(
        6, taylor2_link_preflight_fp, taylor2_link_preflight_audit_fp,
        repaired_projection_inclusion_fp, repaired_projection_inclusion_audit_fp,
        remainder_obligation_fp, remainder_obligation_audit_fp,
        z_margin_repair_fp, z_margin_repair_audit_fp, taylor_order,
        target_scale, selected_dt_num, selected_dt_den, x_projected_radius,
        y_projected_radius, z_projected_radius, x_lte, y_lte, z_lte,
        x_need, y_need, z_need, x_margin, y_margin, z_margin,
        x_slack, y_slack, z_slack, axis_containment_mask,
        local_flowpipe_obligation_mask, global_flowpipe_claim_mask,
        obligation_status_local)
    let certificate_fp = lorenz_i256_step6_taylor2_local_containment_obligation_certificate_fingerprint(
        instance_fp, x_projected_radius, y_projected_radius,
        z_projected_radius, x_lte, y_lte, z_lte, x_need, y_need,
        z_need, x_margin, y_margin, z_margin, x_slack, y_slack,
        z_slack, axis_containment_mask, local_flowpipe_obligation_mask,
        global_flowpipe_claim_mask, obligation_status_local, ok_mask)

    return lorenz_i256_step6_taylor2_local_containment_obligation_fingerprint(
        instance_fp, certificate_fp, 13, 6, axis_containment_mask,
        local_flowpipe_obligation_mask, global_flowpipe_claim_mask,
        obligation_status_local, ok_mask)
