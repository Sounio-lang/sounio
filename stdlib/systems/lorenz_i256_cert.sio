    xy_scaled_q_i64: i64,
    xy_scaled_r_i64: i64,
    beta_q_i64: i64,
    beta_r_i64: i64,
    x_inc_q_i64: i64,
    x_inc_r_i64: i64,
    y_inc_q_i64: i64,
    y_inc_r_i64: i64,
    z_drop_q_i64: i64,
    z_drop_r_i64: i64,
    final_x_i64: i64,
