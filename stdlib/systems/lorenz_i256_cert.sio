    step_count: i64,
    taylor_order: i64,
    dt_num: i64,
    dt_den: i64,
    source_integer_bits: i64,
    source_scale_log2: i64,
    bit_headroom: i64,
    final_xr: i64,
    final_yr: i64,
    final_zr: i64,
    x_radius_cap: i64,
    y_radius_cap: i64,
    z_radius_cap: i64,
