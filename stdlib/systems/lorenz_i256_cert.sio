pub fn lorenz_i256_step3_taylor2_local_flowpipe_seed_check(
    trajectory3_manifest_fp: i64,
    three_step_chain_anchor_fp: i64,
    step3_certificate_fp: i64,
    four_step_chain_anchor_fp: i64,
    step4_certificate_fp: i64,
    global_flowpipe_claim_mask: i64,
    seed_status: i64) -> i64 with Mod {
    let scale: i256 = 4294967296 as i256
    let dt: i256 = 42949672 as i256
    let x2: i256 = 4406636440 as i256
    let y2: i256 = 6517899153 as i256
    let z2: i256 = 4164877513 as i256
    let dy_scaled_q: i256 = 119112655997 as i256
    let dy_scaled_r: i256 = 796606888 as i256
    let xy_scaled_q: i256 = 6687364522 as i256
    let xy_scaled_r: i256 = 1434262808 as i256
    let beta_q: i256 = 11106340034 as i256
    let beta_r: i256 = 2 as i256
    let x_inc_q: i256 = 211126266 as i256
    let x_inc_r: i256 = 2495204624 as i256
    let y_inc_q: i256 = 1125947543 as i256
    let y_inc_r: i256 = 1173001440 as i256
    let z_drop_q: i256 = 44189754 as i256
    let z_drop_r: i256 = 568146880 as i256

    let dx_num: i256 = (10 as i256) * (y2 - x2)
    let dy_num: i256 = x2 * ((28 as i256) * scale - z2)
    let xy_num: i256 = x2 * y2
    let beta_num_z: i256 = (8 as i256) * z2
    let dy: i256 = dy_scaled_q - y2
    let dz_drop_num: i256 = beta_q - xy_scaled_q

    var point_replay_mask: i64 = 0
    if div_witness_check_i256(scale, 100 as i256, dt, 96 as i256) == 1 {
        point_replay_mask = point_replay_mask + 1
    }
    if div_witness_check_i256(dy_num, scale, dy_scaled_q, dy_scaled_r) == 1 {
        point_replay_mask = point_replay_mask + 2
    }
    if div_witness_check_i256(xy_num, scale, xy_scaled_q, xy_scaled_r) == 1 {
        point_replay_mask = point_replay_mask + 4
    }
    if div_witness_check_i256(beta_num_z, 3 as i256, beta_q, beta_r) == 1 {
        point_replay_mask = point_replay_mask + 8
    }
    if div_witness_check_i256(dt * dx_num, scale, x_inc_q, x_inc_r) == 1 {
        point_replay_mask = point_replay_mask + 16
    }
    if div_witness_check_i256(dt * dy, scale, y_inc_q, y_inc_r) == 1 {
        point_replay_mask = point_replay_mask + 32
    }
    if div_witness_check_i256(dt * dz_drop_num, scale, z_drop_q, z_drop_r) == 1 {
        point_replay_mask = point_replay_mask + 64
    }

    var endpoint_mask: i64 = 0
    if x2 + x_inc_q == 4617762706 as i256 { endpoint_mask = endpoint_mask + 1 }
    if y2 + y_inc_q == 7643846696 as i256 { endpoint_mask = endpoint_mask + 2 }
    if z2 - z_drop_q == 4120687759 as i256 { endpoint_mask = endpoint_mask + 4 }

    var trajectory_anchor_mask: i64 = 0
    if trajectory3_manifest_fp == 449592233 { trajectory_anchor_mask = trajectory_anchor_mask + 1 }
    if three_step_chain_anchor_fp == 249889958 { trajectory_anchor_mask = trajectory_anchor_mask + 2 }
    if step3_certificate_fp == 603078026 { trajectory_anchor_mask = trajectory_anchor_mask + 4 }

    var suffix_anchor_mask: i64 = 0
