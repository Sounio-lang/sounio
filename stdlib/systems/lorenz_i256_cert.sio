    if validated_enclosure_mask != 0 { containment_blocked_ok = 0 }
    if local_containment_proof_mask != 0 { containment_blocked_ok = 0 }

    var nonclaim_ok: i64 = 1
    if global_flowpipe_claim_mask != 0 { nonclaim_ok = 0 }

    var ok_mask: i64 = 0
