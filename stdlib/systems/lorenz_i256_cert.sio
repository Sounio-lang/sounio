pub fn lorenz_i256_step5_taylor2_local_flowpipe_seed_check(
    trajectory5_manifest_fp: i64,
    chain_anchor_fp: i64,
    final_step_certificate_fp: i64,
    trajectory5_step6_bridge_fp: i64,
    trajectory5_step6_bridge_audit_fp: i64,
    global_flowpipe_claim_mask: i64,
    seed_status: i64) -> i64 with Mod {
    let scale: i256 = 4294967296 as i256
    let dt: i256 = 42949672 as i256
    let x4: i256 = 4920371098 as i256
    let y4: i256 = 8816077911 as i256
    let z4: i256 = 4092986080 as i256
    let dy_scaled_q: i256 = 133081411987 as i256
    let dy_scaled_r: i256 = 405415232 as i256
    let xy_scaled_q: i256 = 10099814960 as i256
    let xy_scaled_r: i256 = 2149068118 as i256
    let beta_q: i256 = 10914629546 as i256
    let beta_r: i256 = 2 as i256
    let x_inc_q: i256 = 389570672 as i256
    let x_inc_r: i256 = 2544410448 as i256
    let y_inc_q: i256 = 1242653312 as i256
    let y_inc_r: i256 = 4228538720 as i256
    let z_drop_q: i256 = 8148145 as i256
    let z_drop_r: i256 = 2911449872 as i256

    let dx_num: i256 = (10 as i256) * (y4 - x4)
    let dy_num: i256 = x4 * ((28 as i256) * scale - z4)
    let xy_num: i256 = x4 * y4
    let beta_num_z: i256 = (8 as i256) * z4
    let dy: i256 = dy_scaled_q - y4
    let dz_drop_num: i256 = beta_q - xy_scaled_q

    var point_replay_mask: i64 = 0
    if div_witness_check_i256(scale, 100 as i256, dt, 96 as i256) == 1 {
        point_replay_mask = point_replay_mask + 1
    }
    if div_witness_check_i256(dy_num, scale, dy_scaled_q, dy_scaled_r) == 1 {
        point_replay_mask = point_replay_mask + 2
    }
    if div_witness_check_i256(xy_num, scale, xy_scaled_q, xy_scaled_r) == 1 {
        point_replay_mask = point_replay_mask + 4
    }
    if div_witness_check_i256(beta_num_z, 3 as i256, beta_q, beta_r) == 1 {
        point_replay_mask = point_replay_mask + 8
    }
    if div_witness_check_i256(dt * dx_num, scale, x_inc_q, x_inc_r) == 1 {
        point_replay_mask = point_replay_mask + 16
    }
    if div_witness_check_i256(dt * dy, scale, y_inc_q, y_inc_r) == 1 {
        point_replay_mask = point_replay_mask + 32
    }
    if div_witness_check_i256(dt * dz_drop_num, scale, z_drop_q, z_drop_r) == 1 {
        point_replay_mask = point_replay_mask + 64
    }

    var endpoint_mask: i64 = 0
    if x4 + x_inc_q == 5309941770 as i256 { endpoint_mask = endpoint_mask + 1 }
    if y4 + y_inc_q == 10058731223 as i256 { endpoint_mask = endpoint_mask + 2 }
    if z4 - z_drop_q == 4084837935 as i256 { endpoint_mask = endpoint_mask + 4 }

    var trajectory_anchor_mask: i64 = 0
    if trajectory5_manifest_fp == 214180161 { trajectory_anchor_mask = trajectory_anchor_mask + 1 }
    if chain_anchor_fp == 23144051 { trajectory_anchor_mask = trajectory_anchor_mask + 2 }
    if final_step_certificate_fp == 561641681 { trajectory_anchor_mask = trajectory_anchor_mask + 4 }

    var bridge_anchor_mask: i64 = 0
    if trajectory5_step6_bridge_fp == 881240986 { bridge_anchor_mask = bridge_anchor_mask + 1 }
    if trajectory5_step6_bridge_audit_fp == 732374685 { bridge_anchor_mask = bridge_anchor_mask + 2 }

    var local_flowpipe_seed_mask: i64 = 0
    if point_replay_mask == 127 { local_flowpipe_seed_mask = local_flowpipe_seed_mask + 1 }
    if endpoint_mask == 7 { local_flowpipe_seed_mask = local_flowpipe_seed_mask + 2 }
    if trajectory_anchor_mask == 7 { local_flowpipe_seed_mask = local_flowpipe_seed_mask + 4 }
    if bridge_anchor_mask == 3 { local_flowpipe_seed_mask = local_flowpipe_seed_mask + 8 }

    let local_flowpipe_proof_mask: i64 = 0

    var non_global_ok: i64 = 1
    if global_flowpipe_claim_mask != 0 { non_global_ok = 0 }
    if seed_status != 17 { non_global_ok = 0 }

    var step_contract_ok: i64 = 1
    if 5 + 1 != 6 { step_contract_ok = 0 }
    if 256 != 256 { step_contract_ok = 0 }
    if 32 != 32 { step_contract_ok = 0 }
    if 1 != 1 { step_contract_ok = 0 }
    if 100 != 100 { step_contract_ok = 0 }

    var dependency_closure_ok: i64 = 1
    if trajectory_anchor_mask != 7 { dependency_closure_ok = 0 }
    if bridge_anchor_mask != 3 { dependency_closure_ok = 0 }
    if local_flowpipe_seed_mask != 15 { dependency_closure_ok = 0 }
    if local_flowpipe_proof_mask != 0 { dependency_closure_ok = 0 }

    var ok_mask: i64 = 0
    if point_replay_mask == 127 { ok_mask = ok_mask + 1 }
    if endpoint_mask == 7 { ok_mask = ok_mask + 2 }
    if trajectory_anchor_mask == 7 { ok_mask = ok_mask + 4 }
    if bridge_anchor_mask == 3 { ok_mask = ok_mask + 8 }
    if local_flowpipe_seed_mask == 15 { ok_mask = ok_mask + 16 }
    if non_global_ok == 1 { ok_mask = ok_mask + 32 }
    if step_contract_ok == 1 { ok_mask = ok_mask + 64 }
    if dependency_closure_ok == 1 { ok_mask = ok_mask + 128 }
    if ok_mask != 255 { return 0 - 1 }

    let instance_fp = lorenz_i256_step5_taylor2_local_flowpipe_seed_instance_fingerprint(
        trajectory5_manifest_fp, chain_anchor_fp, final_step_certificate_fp,
        trajectory5_step6_bridge_fp, trajectory5_step6_bridge_audit_fp,
        5, 5, 6, 256, 32, 1, 100, 4920371098, 8816077911, 4092986080,
        5309941770, 10058731223, 4084837935, 133081411987, 405415232,
        10099814960, 2149068118, 10914629546, 2, 389570672, 2544410448,
        1242653312, 4228538720, 8148145, 2911449872, point_replay_mask,
        endpoint_mask, trajectory_anchor_mask, bridge_anchor_mask,
        local_flowpipe_seed_mask, local_flowpipe_proof_mask,
        global_flowpipe_claim_mask, seed_status)
    let certificate_fp = lorenz_i256_step5_taylor2_local_flowpipe_seed_certificate_fingerprint(
        instance_fp, point_replay_mask, endpoint_mask, trajectory_anchor_mask,
        bridge_anchor_mask, local_flowpipe_seed_mask, local_flowpipe_proof_mask,
        global_flowpipe_claim_mask, seed_status, ok_mask)

    return lorenz_i256_step5_taylor2_local_flowpipe_seed_fingerprint(
        instance_fp, certificate_fp, 18, 5, point_replay_mask,
        local_flowpipe_seed_mask, local_flowpipe_proof_mask,
        global_flowpipe_claim_mask, seed_status, ok_mask)
