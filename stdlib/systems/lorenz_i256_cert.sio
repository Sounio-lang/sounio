    instance_fp: i64,
    certificate_fp: i64,
    five_step_local_chain_fp: i64,
    five_step_local_chain_audit_fp: i64,
    v147_portfolio_entry_fp: i64,
    v147_manifest_fp: i64,
    v147_readiness_fp: i64,
    trajectory5_manifest_fp: i64,
    five_step_chain_anchor_fp: i64,
    step5_certificate_fp: i64,
    step_count: i64,
    bridge_count: i64,
    source_width_bits: i64,
    scale_log2: i64,
    selected_dt_num: i64,
    selected_dt_den: i64,
    available_evidence_mask: i64,
    missing_global_obligation_mask: i64,
    global_claim_ready_mask: i64,
    global_flowpipe_claim_mask: i64,
    preflight_version: i64,
    blocker_count: i64,
    preflight_status: i64,
    ok_mask: i64) -> i64 with Mod {
    if artifact_fp != 461075499 { return 0 - 1 }
    if instance_fp != 549978893 { return 0 - 1 }
    if certificate_fp != 696181837 { return 0 - 1 }
    if five_step_local_chain_fp != 911209450 { return 0 - 1 }
    if five_step_local_chain_audit_fp != 709377850 { return 0 - 1 }
    if v147_portfolio_entry_fp != 657988743 { return 0 - 1 }
    if v147_manifest_fp != 867133305 { return 0 - 1 }
    if v147_readiness_fp != 31177321 { return 0 - 1 }
    if trajectory5_manifest_fp != 214180161 { return 0 - 1 }
    if five_step_chain_anchor_fp != 23144051 { return 0 - 1 }
    if step5_certificate_fp != 561641681 { return 0 - 1 }
    if step_count != 5 { return 0 - 1 }
    if bridge_count != 4 { return 0 - 1 }
    if source_width_bits != 256 { return 0 - 1 }
    if scale_log2 != 32 { return 0 - 1 }
    if selected_dt_num != 1 { return 0 - 1 }
    if selected_dt_den != 100 { return 0 - 1 }
    if available_evidence_mask != 15 { return 0 - 1 }
    if missing_global_obligation_mask != 15 { return 0 - 1 }
    if global_claim_ready_mask != 0 { return 0 - 1 }
    if global_flowpipe_claim_mask != 0 { return 0 - 1 }
    if preflight_version != 1 { return 0 - 1 }
    if blocker_count != 4 { return 0 - 1 }
    if preflight_status != 27 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1759
    fp = lorenz_i256_cert_mix(fp, artifact_fp, 5683)
    fp = lorenz_i256_cert_mix(fp, instance_fp, 5683)
    fp = lorenz_i256_cert_mix(fp, certificate_fp, 5683)
    fp = lorenz_i256_cert_mix(fp, five_step_local_chain_fp, 5683)
    fp = lorenz_i256_cert_mix(fp, five_step_local_chain_audit_fp, 5683)
    fp = lorenz_i256_cert_mix(fp, v147_portfolio_entry_fp, 5683)
    fp = lorenz_i256_cert_mix(fp, v147_manifest_fp, 5683)
    fp = lorenz_i256_cert_mix(fp, v147_readiness_fp, 5683)
    fp = lorenz_i256_cert_mix(fp, trajectory5_manifest_fp, 5683)
    fp = lorenz_i256_cert_mix(fp, five_step_chain_anchor_fp, 5683)
    fp = lorenz_i256_cert_mix(fp, step5_certificate_fp, 5683)
    fp = lorenz_i256_cert_mix(fp, step_count, 5683)
    fp = lorenz_i256_cert_mix(fp, bridge_count, 5683)
    fp = lorenz_i256_cert_mix(fp, source_width_bits, 5683)
    fp = lorenz_i256_cert_mix(fp, scale_log2, 5683)
    fp = lorenz_i256_cert_mix(fp, selected_dt_num, 5683)
    fp = lorenz_i256_cert_mix(fp, selected_dt_den, 5683)
    fp = lorenz_i256_cert_mix(fp, available_evidence_mask, 5683)
    fp = lorenz_i256_cert_mix(fp, missing_global_obligation_mask, 5683)
    fp = lorenz_i256_cert_mix(fp, global_claim_ready_mask, 5683)
    fp = lorenz_i256_cert_mix(fp, global_flowpipe_claim_mask, 5683)
    fp = lorenz_i256_cert_mix(fp, preflight_version, 5683)
    fp = lorenz_i256_cert_mix(fp, blocker_count, 5683)
    fp = lorenz_i256_cert_mix(fp, preflight_status, 5683)
    fp = lorenz_i256_cert_mix(fp, ok_mask, 5683)
    return fp
}

pub fn lorenz_i256_global_flowpipe_claim_preflight_check(
    five_step_local_chain_fp: i64,
    five_step_local_chain_audit_fp: i64,
    v147_portfolio_entry_fp: i64,
    v147_manifest_fp: i64,
    v147_readiness_fp: i64,
    trajectory5_manifest_fp: i64,
    five_step_chain_anchor_fp: i64,
    step5_certificate_fp: i64,
    global_flowpipe_claim_mask: i64,
    preflight_status: i64) -> i64 with Mod {
    var available_evidence_mask: i64 = 0
    if five_step_local_chain_fp == 911209450 {
        if five_step_local_chain_audit_fp == 709377850 { available_evidence_mask = available_evidence_mask + 1 }
    }
    if v147_portfolio_entry_fp == 657988743 {
        if v147_manifest_fp == 867133305 { available_evidence_mask = available_evidence_mask + 2 }
    }
    if v147_readiness_fp == 31177321 { available_evidence_mask = available_evidence_mask + 4 }
    if trajectory5_manifest_fp == 214180161 {
        if five_step_chain_anchor_fp == 23144051 {
            if step5_certificate_fp == 561641681 { available_evidence_mask = available_evidence_mask + 8 }
        }
    }

    let invariant_certificate_mask: i64 = 0
    let shadowing_certificate_mask: i64 = 0
    let global_cover_certificate_mask: i64 = 0
    let unbounded_time_certificate_mask: i64 = 0
    var missing_global_obligation_mask: i64 = 0
    if invariant_certificate_mask == 0 { missing_global_obligation_mask = missing_global_obligation_mask + 1 }
    if shadowing_certificate_mask == 0 { missing_global_obligation_mask = missing_global_obligation_mask + 2 }
    if global_cover_certificate_mask == 0 { missing_global_obligation_mask = missing_global_obligation_mask + 4 }
    if unbounded_time_certificate_mask == 0 { missing_global_obligation_mask = missing_global_obligation_mask + 8 }

    let step_count: i64 = 5
    let bridge_count: i64 = 4
    let source_width_bits: i64 = 256
    let scale_log2: i64 = 32
    let selected_dt_num: i64 = 1
    let selected_dt_den: i64 = 100
    let preflight_version: i64 = 1
    let blocker_count: i64 = 4
    let global_claim_ready_mask: i64 = 0

    var nonclaim_ok: i64 = 1
    if global_flowpipe_claim_mask != 0 { nonclaim_ok = 0 }
    if preflight_status != 27 { nonclaim_ok = 0 }
    if global_claim_ready_mask != 0 { nonclaim_ok = 0 }

    var blocker_mask_ok: i64 = 1
    if missing_global_obligation_mask != 15 { blocker_mask_ok = 0 }
    if blocker_count != 4 { blocker_mask_ok = 0 }

    var local_scope_ok: i64 = 1
    if available_evidence_mask != 15 { local_scope_ok = 0 }
    if step_count != 5 { local_scope_ok = 0 }
    if bridge_count != 4 { local_scope_ok = 0 }

    var contract_ok: i64 = 1
    if source_width_bits != 256 { contract_ok = 0 }
    if scale_log2 != 32 { contract_ok = 0 }
    if selected_dt_num != 1 { contract_ok = 0 }
    if selected_dt_den != 100 { contract_ok = 0 }

    var ok_mask: i64 = 0
    if available_evidence_mask == 15 { ok_mask = ok_mask + 1 }
    if missing_global_obligation_mask == 15 { ok_mask = ok_mask + 2 }
    if global_claim_ready_mask == 0 { ok_mask = ok_mask + 4 }
    if nonclaim_ok == 1 { ok_mask = ok_mask + 8 }
    if blocker_mask_ok == 1 { ok_mask = ok_mask + 16 }
    if local_scope_ok == 1 { ok_mask = ok_mask + 32 }
    if contract_ok == 1 { ok_mask = ok_mask + 64 }
    if preflight_version == 1 { ok_mask = ok_mask + 128 }
    if ok_mask != 255 { return 0 - 1 }

    let instance_fp = lorenz_i256_global_flowpipe_claim_preflight_instance_fingerprint(
        five_step_local_chain_fp, five_step_local_chain_audit_fp,
        v147_portfolio_entry_fp, v147_manifest_fp, v147_readiness_fp,
        trajectory5_manifest_fp, five_step_chain_anchor_fp, step5_certificate_fp,
        step_count, bridge_count, source_width_bits, scale_log2,
        selected_dt_num, selected_dt_den, available_evidence_mask,
        missing_global_obligation_mask, global_claim_ready_mask,
        global_flowpipe_claim_mask, preflight_version, blocker_count,
        preflight_status)
    let certificate_fp = lorenz_i256_global_flowpipe_claim_preflight_certificate_fingerprint(
        instance_fp, available_evidence_mask, missing_global_obligation_mask,
        global_claim_ready_mask, global_flowpipe_claim_mask, preflight_version,
        blocker_count, preflight_status, ok_mask)

    return lorenz_i256_global_flowpipe_claim_preflight_fingerprint(
        instance_fp, certificate_fp, 19, step_count,
        missing_global_obligation_mask, global_claim_ready_mask,
        global_flowpipe_claim_mask, preflight_status, ok_mask)
}

