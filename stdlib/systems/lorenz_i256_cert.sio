    if fail_mask != 0 { inclusion_mask_ok = 0 }
    if inclusion_pass_mask != pass_mask { inclusion_mask_ok = 0 }
    if inclusion_fail_mask != fail_mask { inclusion_mask_ok = 0 }

    var guarded_status_ok: i64 = 1
    if validated_enclosure_mask != 0 { guarded_status_ok = 0 }
    if validator_status_guarded != 8 { guarded_status_ok = 0 }

    var margin_slack_ok: i64 = 1
    if x_need_ppm > x_margin_ppm { margin_slack_ok = 0 }
    if y_need_ppm > y_margin_ppm { margin_slack_ok = 0 }
    if z_need_ppm > z_margin_ppm { margin_slack_ok = 0 }
    if x_margin_ppm - x_need_ppm != 269 { margin_slack_ok = 0 }
    if y_margin_ppm - y_need_ppm != 543 { margin_slack_ok = 0 }
    if z_margin_ppm - z_need_ppm != 128 { margin_slack_ok = 0 }

    var not_validated_ok: i64 = 1
    if validated_enclosure_mask != 0 { not_validated_ok = 0 }

    let local_containment_proof_mask: i64 = 0
    var containment_blocked_ok: i64 = 1
    if validated_enclosure_mask != 0 { containment_blocked_ok = 0 }
    if local_containment_proof_mask != 0 { containment_blocked_ok = 0 }

    var nonclaim_ok: i64 = 1
    if global_flowpipe_claim_mask != 0 { nonclaim_ok = 0 }

    var ok_mask: i64 = 0
    if anchor_ok == 1 { ok_mask = ok_mask + 1 }
    if operand_ok == 1 { ok_mask = ok_mask + 2 }
    if inclusion_mask_ok == 1 { ok_mask = ok_mask + 4 }
    if guarded_status_ok == 1 { ok_mask = ok_mask + 8 }
