    if fail_mask != 0 { inclusion_mask_ok = 0 }
    if inclusion_pass_mask != pass_mask { inclusion_mask_ok = 0 }
    if inclusion_fail_mask != fail_mask { inclusion_mask_ok = 0 }

    var guarded_status_ok: i64 = 1
    if validated_enclosure_mask != 0 { guarded_status_ok = 0 }
    if validator_status_guarded != 8 { guarded_status_ok = 0 }

    var margin_slack_ok: i64 = 1
