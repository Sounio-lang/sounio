pub fn lorenz_i256_step3_taylor2_remainder_obligation_check(
    x_lte_cap_ppm: i64,
    y_lte_cap_ppm: i64,
    z_lte_cap_ppm: i64,
    global_flowpipe_claim_mask: i64) -> i64 with Mod {
    let source_scale: i256 = 4294967296 as i256
    let target_scale: i256 = 1000000 as i256
    let dt_q: i256 = 42949672 as i256
    let start_x: i256 = 4617762706 as i256
    let start_y: i256 = 7643846696 as i256
    let start_z: i256 = 4120687759 as i256
    let rx: i256 = 212600882 as i256
    let ry: i256 = 1127428916 as i256
    let rz: i256 = 45097157 as i256

    let x_abs: i256 = 4830363588 as i256
    let y_abs: i256 = 8771275612 as i256
    let z_abs: i256 = 4165784916 as i256
    let rhoz_abs: i256 = 116183493686 as i256
    let x_prime: i256 = 136016392000 as i256
    let y_prime: i256 = 139437815949 as i256
    let z_prime: i256 = 20973433339 as i256
    let x_second: i256 = 2754542079490 as i256
    let y_second: i256 = 3842415704665 as i256
    let z_second: i256 = 490524458002 as i256
    let x_lte_source: i256 = 137727098 as i256
    let y_lte_source: i256 = 192120777 as i256
    let z_lte_source: i256 = 24526222 as i256
    let x_lte_ppm: i256 = 32068 as i256
    let y_lte_ppm: i256 = 44732 as i256
    let z_lte_ppm: i256 = 5711 as i256
    let den: i256 = (2 as i256) * source_scale * source_scale

    var abs_box_ok: i64 = 1
    if x_abs != start_x + rx { abs_box_ok = 0 }
    if y_abs != start_y + ry { abs_box_ok = 0 }
    if z_abs != start_z + rz { abs_box_ok = 0 }
    if rhoz_abs != (28 as i256) * source_scale - (start_z - rz) { abs_box_ok = 0 }

    let y_prime_product: i256 = x_abs * rhoz_abs
    let xy_product: i256 = x_abs * y_abs
    let beta_z_product: i256 = (8 as i256) * z_abs
    var first_derivative_ok: i64 = 1
    if x_prime != (10 as i256) * (x_abs + y_abs) { first_derivative_ok = 0 }
    if (y_prime - y_abs - (1 as i256)) * source_scale >= y_prime_product {
        first_derivative_ok = 0
