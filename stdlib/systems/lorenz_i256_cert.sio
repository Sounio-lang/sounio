        first_derivative_ok = 0
    }
    if ((9864673563 as i256) - (1 as i256)) * source_scale >= xy_product {
        first_derivative_ok = 0
    }
    if (9864673563 as i256) * source_scale < xy_product {
        first_derivative_ok = 0
    }
    if ((11108759776 as i256) - (1 as i256)) * (3 as i256) >= beta_z_product {
        first_derivative_ok = 0
    }
    if (11108759776 as i256) * (3 as i256) < beta_z_product {
        first_derivative_ok = 0
    }
    if z_prime != (9864673563 as i256) + (11108759776 as i256) {
        first_derivative_ok = 0
    }

    let y_second_a: i256 = x_prime * rhoz_abs
    let y_second_b: i256 = x_abs * z_prime
    let z_second_a: i256 = x_prime * y_abs
    let z_second_b: i256 = x_abs * y_prime
    let z_second_c: i256 = (8 as i256) * z_prime
    var second_derivative_ok: i64 = 1
    if x_second != (10 as i256) * (y_prime + x_prime) { second_derivative_ok = 0 }
    if ((3679389977159 as i256) - (1 as i256)) * source_scale >= y_second_a {
