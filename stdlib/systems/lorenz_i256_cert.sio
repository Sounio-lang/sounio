    let y_radius: i64 = 273500
    let z_radius: i64 = 6500
    let x_lte: i64 = 32524
    let y_lte: i64 = 45203
    let z_lte: i64 = 5836
    let x_need: i64 = x_radius + x_lte
    let y_need: i64 = y_radius + y_lte
    let z_need: i64 = z_radius + z_lte
    let x_margin: i64 = 104000
    let y_margin: i64 = 319000
    let z_margin: i64 = 12500
    let x_slack: i64 = x_margin - x_need
    let y_slack: i64 = y_margin - y_need
    let z_slack: i64 = z_margin - z_need

    var need_arithmetic_ok: i64 = 1
    if x_need != 103524 { need_arithmetic_ok = 0 }
    if y_need != 318703 { need_arithmetic_ok = 0 }
    if z_need != 12336 { need_arithmetic_ok = 0 }

    var axis_containment_mask: i64 = 0
