//! stdlib/systems/lorenz_i256_cert.sio
//!
//! Proof-carrying Lorenz i256 step-certificate helpers.
//!
//! This module verifies supplied quotient/remainder witnesses for one fixed
//! Lorenz Euler step at scale 2^32. It does not execute source-level i256
//! division, and it is not a validated enclosure, shadowing argument, or
//! long-time Lorenz theorem.

use theorem::div_witness::*
use theorem::portfolio::*

fn lorenz_i256_cert_mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

pub fn lorenz_i256_cert_ready() -> i64 {
    return 1
}

pub fn lorenz_i256_step4_instance_fingerprint(step_index: i64,
                                              sigma: i64, rho: i64,
                                              beta_num: i64, beta_den: i64,
                                              scale: i64, dt_q: i64, dt_r: i64,
                                              start_x: i64, start_y: i64,
                                              start_z: i64) -> i64 with Mod {
    if step_index != 4 { return 0 - 1 }
    if sigma != 10 { return 0 - 1 }
    if rho != 28 { return 0 - 1 }
    if beta_num != 8 { return 0 - 1 }
    if beta_den != 3 { return 0 - 1 }
    if scale != 4294967296 { return 0 - 1 }
    if dt_q != 42949672 { return 0 - 1 }
    if dt_r != 96 { return 0 - 1 }
    if start_x != 4617762706 { return 0 - 1 }
    if start_y != 7643846696 { return 0 - 1 }
    if start_z != 4120687759 { return 0 - 1 }

    var fp: i64 = 223
    fp = lorenz_i256_cert_mix(fp, step_index, 1709)
    fp = lorenz_i256_cert_mix(fp, sigma, 1709)
    fp = lorenz_i256_cert_mix(fp, rho, 1709)
    fp = lorenz_i256_cert_mix(fp, beta_num, 1709)
    fp = lorenz_i256_cert_mix(fp, beta_den, 1709)
    fp = lorenz_i256_cert_mix(fp, scale, 1709)
    fp = lorenz_i256_cert_mix(fp, dt_q, 1709)
    fp = lorenz_i256_cert_mix(fp, dt_r, 1709)
    fp = lorenz_i256_cert_mix(fp, start_x, 1709)
    fp = lorenz_i256_cert_mix(fp, start_y, 1709)
    fp = lorenz_i256_cert_mix(fp, start_z, 1709)
    return fp
}

pub fn lorenz_i256_step4_certificate_fingerprint(instance_fp: i64,
                                                 dy_scaled_q: i64, dy_scaled_r: i64,
                                                 xy_scaled_q: i64, xy_scaled_r: i64,
                                                 beta_q: i64, beta_r: i64,
                                                 x_inc_q: i64, x_inc_r: i64,
                                                 y_inc_q: i64, y_inc_r: i64,
                                                 z_drop_q: i64, z_drop_r: i64,
                                                 final_x: i64, final_y: i64,
                                                 final_z: i64, ok_mask: i64) -> i64 with Mod {
    if instance_fp != 924803514 { return 0 - 1 }
    if ok_mask != 127 { return 0 - 1 }

    var fp: i64 = 227
    fp = lorenz_i256_cert_mix(fp, instance_fp, 1721)
    fp = lorenz_i256_cert_mix(fp, dy_scaled_q, 1721)
    fp = lorenz_i256_cert_mix(fp, dy_scaled_r, 1721)
    fp = lorenz_i256_cert_mix(fp, xy_scaled_q, 1721)
    fp = lorenz_i256_cert_mix(fp, xy_scaled_r, 1721)
    fp = lorenz_i256_cert_mix(fp, beta_q, 1721)
    fp = lorenz_i256_cert_mix(fp, beta_r, 1721)
    fp = lorenz_i256_cert_mix(fp, x_inc_q, 1721)
    fp = lorenz_i256_cert_mix(fp, x_inc_r, 1721)
    fp = lorenz_i256_cert_mix(fp, y_inc_q, 1721)
    fp = lorenz_i256_cert_mix(fp, y_inc_r, 1721)
    fp = lorenz_i256_cert_mix(fp, z_drop_q, 1721)
    fp = lorenz_i256_cert_mix(fp, z_drop_r, 1721)
    fp = lorenz_i256_cert_mix(fp, final_x, 1721)
    fp = lorenz_i256_cert_mix(fp, final_y, 1721)
    fp = lorenz_i256_cert_mix(fp, final_z, 1721)
    fp = lorenz_i256_cert_mix(fp, ok_mask, 1721)
    return fp
}

pub fn lorenz_i256_step4_contract_fingerprint(instance_fp: i64,
                                              certificate_fp: i64,
                                              ok_mask: i64,
                                              local_step_fp: i64,
                                              chain_fp: i64) -> i64 with Mod {
    if instance_fp != 924803514 { return 0 - 1 }
    if certificate_fp != 700498889 { return 0 - 1 }
    if ok_mask != 127 { return 0 - 1 }
    if local_step_fp != 753371133 { return 0 - 1 }
    if chain_fp != 737039167 { return 0 - 1 }

    var fp: i64 = 229
    fp = lorenz_i256_cert_mix(fp, instance_fp, 1733)
    fp = lorenz_i256_cert_mix(fp, certificate_fp, 1733)
    fp = lorenz_i256_cert_mix(fp, ok_mask, 1733)
    fp = lorenz_i256_cert_mix(fp, local_step_fp, 1733)
    fp = lorenz_i256_cert_mix(fp, chain_fp, 1733)
    return fp
}

pub fn lorenz_i256_step4_certificate_check(dt_q: i64, dt_r: i64,
                                           dy_scaled_q_i64: i64, dy_scaled_r_i64: i64,
                                           xy_scaled_q_i64: i64, xy_scaled_r_i64: i64,
                                           beta_q_i64: i64, beta_r_i64: i64,
                                           x_inc_q_i64: i64, x_inc_r_i64: i64,
                                           y_inc_q_i64: i64, y_inc_r_i64: i64,
                                           z_drop_q_i64: i64, z_drop_r_i64: i64,
                                           final_x_i64: i64, final_y_i64: i64,
                                           final_z_i64: i64) -> i64 with Mod {
    let scale: i256 = 4294967296 as i256
    let x3: i256 = 4617762706 as i256
    let y3: i256 = 7643846696 as i256
    let z3: i256 = 4120687759 as i256

    let dt: i256 = dt_q as i256
    let dy_scaled_q: i256 = dy_scaled_q_i64 as i256
    let dy_scaled_r: i256 = dy_scaled_r_i64 as i256
    let xy_scaled_q: i256 = xy_scaled_q_i64 as i256
    let xy_scaled_r: i256 = xy_scaled_r_i64 as i256
    let beta_q: i256 = beta_q_i64 as i256
    let beta_r: i256 = beta_r_i64 as i256
    let x_inc_q: i256 = x_inc_q_i64 as i256
    let x_inc_r: i256 = x_inc_r_i64 as i256
    let y_inc_q: i256 = y_inc_q_i64 as i256
    let y_inc_r: i256 = y_inc_r_i64 as i256
    let z_drop_q: i256 = z_drop_q_i64 as i256
    let z_drop_r: i256 = z_drop_r_i64 as i256

    let dx_num: i256 = (10 as i256) * (y3 - x3)
    let dy_num: i256 = x3 * ((28 as i256) * scale - z3)
    let xy_num: i256 = x3 * y3
    let beta_num_z: i256 = (8 as i256) * z3
    let dy: i256 = dy_scaled_q - y3
    let dz_drop_num: i256 = beta_q - xy_scaled_q

    let dt_ok = div_witness_check_i256(scale, 100 as i256, dt, dt_r as i256)
    let dy_scaled_ok = div_witness_check_i256(dy_num, scale, dy_scaled_q, dy_scaled_r)
    let xy_scaled_ok = div_witness_check_i256(xy_num, scale, xy_scaled_q, xy_scaled_r)
    let beta_ok = div_witness_check_i256(beta_num_z, 3 as i256, beta_q, beta_r)
    let x_inc_ok = div_witness_check_i256(dt * dx_num, scale, x_inc_q, x_inc_r)
    let y_inc_ok = div_witness_check_i256(dt * dy, scale, y_inc_q, y_inc_r)
    let z_drop_ok = div_witness_check_i256(dt * dz_drop_num, scale, z_drop_q, z_drop_r)

    var ok_mask: i64 = 0
    if dt_ok == 1 { ok_mask = ok_mask + 1 }
    if dy_scaled_ok == 1 { ok_mask = ok_mask + 2 }
    if xy_scaled_ok == 1 { ok_mask = ok_mask + 4 }
    if beta_ok == 1 { ok_mask = ok_mask + 8 }
    if x_inc_ok == 1 { ok_mask = ok_mask + 16 }
    if y_inc_ok == 1 { ok_mask = ok_mask + 32 }
    if z_drop_ok == 1 { ok_mask = ok_mask + 64 }
    if ok_mask != 127 { return 0 - 1 }

    if x3 + x_inc_q != final_x_i64 as i256 { return 0 - 1 }
    if y3 + y_inc_q != final_y_i64 as i256 { return 0 - 1 }
    if z3 - z_drop_q != final_z_i64 as i256 { return 0 - 1 }

    let instance_fp = lorenz_i256_step4_instance_fingerprint(
        4, 10, 28, 8, 3, 4294967296, dt_q, dt_r, 4617762706, 7643846696, 4120687759)
    let certificate_fp = lorenz_i256_step4_certificate_fingerprint(
        instance_fp,
        dy_scaled_q_i64, dy_scaled_r_i64, xy_scaled_q_i64, xy_scaled_r_i64,
        beta_q_i64, beta_r_i64, x_inc_q_i64, x_inc_r_i64,
        y_inc_q_i64, y_inc_r_i64, z_drop_q_i64, z_drop_r_i64,
        final_x_i64, final_y_i64, final_z_i64, ok_mask)

    return lorenz_i256_step4_contract_fingerprint(
        instance_fp, certificate_fp, ok_mask, 753371133, 737039167)
}

pub fn lorenz_i256_step5_certificate_fingerprint(start_x: i64,
                                                 start_y: i64,
                                                 start_z: i64,
                                                 dy_scaled_q: i64,
                                                 dy_scaled_r: i64,
                                                 xy_scaled_q: i64,
                                                 xy_scaled_r: i64,
                                                 beta_q: i64,
                                                 beta_r: i64,
                                                 x_inc_q: i64,
                                                 x_inc_r: i64,
                                                 y_inc_q: i64,
                                                 y_inc_r: i64,
                                                 z_drop_q: i64,
                                                 z_drop_r: i64,
                                                 final_x: i64,
                                                 final_y: i64,
                                                 final_z: i64,
                                                 all_divisions_ok: i64) -> i64 with Mod {
    if start_x != 4920371098 { return 0 - 1 }
    if start_y != 8816077911 { return 0 - 1 }
    if start_z != 4092986080 { return 0 - 1 }
    if dy_scaled_q != 133081411987 { return 0 - 1 }
    if dy_scaled_r != 405415232 { return 0 - 1 }
    if xy_scaled_q != 10099814960 { return 0 - 1 }
    if xy_scaled_r != 2149068118 { return 0 - 1 }
    if beta_q != 10914629546 { return 0 - 1 }
    if beta_r != 2 { return 0 - 1 }
    if x_inc_q != 389570672 { return 0 - 1 }
    if x_inc_r != 2544410448 { return 0 - 1 }
    if y_inc_q != 1242653312 { return 0 - 1 }
    if y_inc_r != 4228538720 { return 0 - 1 }
    if z_drop_q != 8148145 { return 0 - 1 }
    if z_drop_r != 2911449872 { return 0 - 1 }
    if final_x != 5309941770 { return 0 - 1 }
    if final_y != 10058731223 { return 0 - 1 }
    if final_z != 4084837935 { return 0 - 1 }
    if all_divisions_ok != 1 { return 0 - 1 }

    var fp: i64 = 233
    fp = lorenz_i256_cert_mix(fp, start_x, 1601)
    fp = lorenz_i256_cert_mix(fp, start_y, 1601)
    fp = lorenz_i256_cert_mix(fp, start_z, 1601)
    fp = lorenz_i256_cert_mix(fp, dy_scaled_q, 1601)
    fp = lorenz_i256_cert_mix(fp, dy_scaled_r, 1601)
    fp = lorenz_i256_cert_mix(fp, xy_scaled_q, 1601)
    fp = lorenz_i256_cert_mix(fp, xy_scaled_r, 1601)
    fp = lorenz_i256_cert_mix(fp, beta_q, 1601)
    fp = lorenz_i256_cert_mix(fp, beta_r, 1601)
    fp = lorenz_i256_cert_mix(fp, x_inc_q, 1601)
    fp = lorenz_i256_cert_mix(fp, x_inc_r, 1601)
    fp = lorenz_i256_cert_mix(fp, y_inc_q, 1601)
    fp = lorenz_i256_cert_mix(fp, y_inc_r, 1601)
    fp = lorenz_i256_cert_mix(fp, z_drop_q, 1601)
    fp = lorenz_i256_cert_mix(fp, z_drop_r, 1601)
    fp = lorenz_i256_cert_mix(fp, final_x, 1601)
    fp = lorenz_i256_cert_mix(fp, final_y, 1601)
    fp = lorenz_i256_cert_mix(fp, final_z, 1601)
    fp = lorenz_i256_cert_mix(fp, all_divisions_ok, 1601)
    return fp
}

pub fn lorenz_i256_five_step_chain_fingerprint(step_count: i64,
                                               step1_certificate_fp: i64,
                                               step2_certificate_fp: i64,
                                               step3_certificate_fp: i64,
                                               step4_certificate_fp: i64,
                                               step5_certificate_fp: i64,
                                               final_x: i64,
                                               final_y: i64,
                                               final_z: i64) -> i64 with Mod {
    if step_count != 5 { return 0 - 1 }
    if step1_certificate_fp != 510854875 { return 0 - 1 }
    if step2_certificate_fp != 899209716 { return 0 - 1 }
    if step3_certificate_fp != 603078026 { return 0 - 1 }
    if step4_certificate_fp != 753371133 { return 0 - 1 }
    if step5_certificate_fp != 561641681 { return 0 - 1 }
    if final_x != 5309941770 { return 0 - 1 }
    if final_y != 10058731223 { return 0 - 1 }
    if final_z != 4084837935 { return 0 - 1 }

    var fp: i64 = 239
    fp = lorenz_i256_cert_mix(fp, step_count, 1613)
    fp = lorenz_i256_cert_mix(fp, step1_certificate_fp, 1613)
    fp = lorenz_i256_cert_mix(fp, step2_certificate_fp, 1613)
    fp = lorenz_i256_cert_mix(fp, step3_certificate_fp, 1613)
    fp = lorenz_i256_cert_mix(fp, step4_certificate_fp, 1613)
    fp = lorenz_i256_cert_mix(fp, step5_certificate_fp, 1613)
    fp = lorenz_i256_cert_mix(fp, final_x, 1613)
    fp = lorenz_i256_cert_mix(fp, final_y, 1613)
    fp = lorenz_i256_cert_mix(fp, final_z, 1613)
    return fp
}

pub fn lorenz_i256_step5_certificate_check(dt_q: i64, dt_r: i64,
                                           dy_scaled_q_i64: i64,
                                           dy_scaled_r_i64: i64,
                                           xy_scaled_q_i64: i64,
                                           xy_scaled_r_i64: i64,
                                           beta_q_i64: i64,
                                           beta_r_i64: i64,
                                           x_inc_q_i64: i64,
                                           x_inc_r_i64: i64,
                                           y_inc_q_i64: i64,
                                           y_inc_r_i64: i64,
                                           z_drop_q_i64: i64,
                                           z_drop_r_i64: i64,
                                           final_x_i64: i64,
                                           final_y_i64: i64,
                                           final_z_i64: i64) -> i64 with Mod {
    let scale: i256 = 4294967296 as i256
    let x4: i256 = 4920371098 as i256
    let y4: i256 = 8816077911 as i256
    let z4: i256 = 4092986080 as i256

    let dt: i256 = dt_q as i256
    let dy_scaled_q: i256 = dy_scaled_q_i64 as i256
    let dy_scaled_r: i256 = dy_scaled_r_i64 as i256
    let xy_scaled_q: i256 = xy_scaled_q_i64 as i256
    let xy_scaled_r: i256 = xy_scaled_r_i64 as i256
    let beta_q: i256 = beta_q_i64 as i256
    let beta_r: i256 = beta_r_i64 as i256
    let x_inc_q: i256 = x_inc_q_i64 as i256
    let x_inc_r: i256 = x_inc_r_i64 as i256
    let y_inc_q: i256 = y_inc_q_i64 as i256
    let y_inc_r: i256 = y_inc_r_i64 as i256
    let z_drop_q: i256 = z_drop_q_i64 as i256
    let z_drop_r: i256 = z_drop_r_i64 as i256

    let dx_num: i256 = (10 as i256) * (y4 - x4)
    let dy_num: i256 = x4 * ((28 as i256) * scale - z4)
    let xy_num: i256 = x4 * y4
    let beta_num_z: i256 = (8 as i256) * z4
    let dy: i256 = dy_scaled_q - y4
    let dz_drop_num: i256 = beta_q - xy_scaled_q

    let dt_ok = div_witness_check_i256(scale, 100 as i256, dt, dt_r as i256)
    let dy_scaled_ok = div_witness_check_i256(dy_num, scale, dy_scaled_q, dy_scaled_r)
    let xy_scaled_ok = div_witness_check_i256(xy_num, scale, xy_scaled_q, xy_scaled_r)
    let beta_ok = div_witness_check_i256(beta_num_z, 3 as i256, beta_q, beta_r)
    let x_inc_ok = div_witness_check_i256(dt * dx_num, scale, x_inc_q, x_inc_r)
    let y_inc_ok = div_witness_check_i256(dt * dy, scale, y_inc_q, y_inc_r)
    let z_drop_ok = div_witness_check_i256(dt * dz_drop_num, scale, z_drop_q, z_drop_r)

    if dt_ok != 1 { return 0 - 1 }

    var all_divisions_ok: i64 = 0
    if dy_scaled_ok == 1 {
        if xy_scaled_ok == 1 {
            if beta_ok == 1 {
                if x_inc_ok == 1 {
                    if y_inc_ok == 1 {
                        if z_drop_ok == 1 { all_divisions_ok = 1 }
                    }
                }
            }
        }
    }
    if all_divisions_ok != 1 { return 0 - 1 }

    if x4 + x_inc_q != final_x_i64 as i256 { return 0 - 1 }
    if y4 + y_inc_q != final_y_i64 as i256 { return 0 - 1 }
    if z4 - z_drop_q != final_z_i64 as i256 { return 0 - 1 }

    let certificate_fp = lorenz_i256_step5_certificate_fingerprint(
        4920371098, 8816077911, 4092986080,
        dy_scaled_q_i64, dy_scaled_r_i64, xy_scaled_q_i64, xy_scaled_r_i64,
        beta_q_i64, beta_r_i64, x_inc_q_i64, x_inc_r_i64,
        y_inc_q_i64, y_inc_r_i64, z_drop_q_i64, z_drop_r_i64,
        final_x_i64, final_y_i64, final_z_i64, all_divisions_ok)
    if certificate_fp != 561641681 { return 0 - 1 }

    return lorenz_i256_five_step_chain_fingerprint(
        5, 510854875, 899209716, 603078026, 753371133, certificate_fp,
        final_x_i64, final_y_i64, final_z_i64)
}

pub fn lorenz_i256_trajectory5_manifest_fingerprint(scale_log2: i64,
                                                    dt_q: i64, dt_r: i64,
                                                    step_count: i64,
                                                    initial_x: i64,
                                                    initial_y: i64,
                                                    initial_z: i64,
                                                    chain_anchor: i64,
                                                    final_step_certificate: i64,
                                                    final_x: i64,
                                                    final_y: i64,
                                                    final_z: i64) -> i64 with Mod {
    if scale_log2 != 32 { return 0 - 1 }
    if dt_q != 42949672 { return 0 - 1 }
    if dt_r != 96 { return 0 - 1 }
    if step_count != 5 { return 0 - 1 }
    if initial_x != 4294967296 { return 0 - 1 }
    if initial_y != 4294967296 { return 0 - 1 }
    if initial_z != 4294967296 { return 0 - 1 }
    if chain_anchor != 23144051 { return 0 - 1 }
    if final_step_certificate != 561641681 { return 0 - 1 }
    if final_x != 5309941770 { return 0 - 1 }
    if final_y != 10058731223 { return 0 - 1 }
    if final_z != 4084837935 { return 0 - 1 }

    var fp: i64 = 191
    fp = lorenz_i256_cert_mix(fp, scale_log2, 1487)
    fp = lorenz_i256_cert_mix(fp, dt_q, 1487)
    fp = lorenz_i256_cert_mix(fp, dt_r, 1487)
    fp = lorenz_i256_cert_mix(fp, step_count, 1487)
    fp = lorenz_i256_cert_mix(fp, initial_x, 1487)
    fp = lorenz_i256_cert_mix(fp, initial_y, 1487)
    fp = lorenz_i256_cert_mix(fp, initial_z, 1487)
    fp = lorenz_i256_cert_mix(fp, chain_anchor, 1487)
    fp = lorenz_i256_cert_mix(fp, final_step_certificate, 1487)
    fp = lorenz_i256_cert_mix(fp, final_x, 1487)
    fp = lorenz_i256_cert_mix(fp, final_y, 1487)
    fp = lorenz_i256_cert_mix(fp, final_z, 1487)
    return fp
}

pub fn lorenz_i256_trajectory5_manifest_valid(scale_log2: i64,
                                              dt_q: i64, dt_r: i64,
                                              step_count: i64,
                                              chain_anchor: i64,
                                              final_step_certificate: i64,
                                              manifest_fp: i64) -> i64 {
    if scale_log2 != 32 { return 0 }
    if dt_q != 42949672 { return 0 }
    if dt_r != 96 { return 0 }
    if step_count != 5 { return 0 }
    if chain_anchor != 23144051 { return 0 }
    if final_step_certificate != 561641681 { return 0 }
    if manifest_fp != 214180161 { return 0 }
    return 1
}

pub fn lorenz_i256_step6_center_instance_fingerprint(
    step_index: i64,
    sigma: i64,
    rho: i64,
    beta_num: i64,
    beta_den: i64,
    scale: i64,
    dt_q: i64,
    dt_r: i64,
    start_x: i64,
    start_y: i64,
    start_z: i64,
    trajectory_manifest_fp: i64,
    response_envelope_fp: i64,
    response_envelope_audit_fp: i64) -> i64 with Mod {
    if step_index != 6 { return 0 - 1 }
    if sigma != 10 { return 0 - 1 }
    if rho != 28 { return 0 - 1 }
    if beta_num != 8 { return 0 - 1 }
    if beta_den != 3 { return 0 - 1 }
    if scale != 4294967296 { return 0 - 1 }
    if dt_q != 42949672 { return 0 - 1 }
    if dt_r != 96 { return 0 - 1 }
    if start_x != 5309941770 { return 0 - 1 }
    if start_y != 10058731223 { return 0 - 1 }
    if start_z != 4084837935 { return 0 - 1 }
    if trajectory_manifest_fp != 214180161 { return 0 - 1 }
    if response_envelope_fp != 506104143 { return 0 - 1 }
    if response_envelope_audit_fp != 956295573 { return 0 - 1 }

    var fp: i64 = 251
    fp = lorenz_i256_cert_mix(fp, step_index, 3203)
    fp = lorenz_i256_cert_mix(fp, sigma, 3203)
    fp = lorenz_i256_cert_mix(fp, rho, 3203)
    fp = lorenz_i256_cert_mix(fp, beta_num, 3203)
    fp = lorenz_i256_cert_mix(fp, beta_den, 3203)
    fp = lorenz_i256_cert_mix(fp, scale, 3203)
