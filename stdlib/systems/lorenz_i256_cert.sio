pub fn lorenz_i256_five_step_local_flowpipe_chain_check(
    step1_local_flowpipe_proof_fp: i64,
    step1_local_flowpipe_proof_audit_fp: i64,
    step2_local_flowpipe_proof_fp: i64,
    step2_local_flowpipe_proof_audit_fp: i64,
    step3_local_flowpipe_proof_fp: i64,
    step3_local_flowpipe_proof_audit_fp: i64,
    step4_local_flowpipe_proof_fp: i64,
    step4_local_flowpipe_proof_audit_fp: i64,
    step5_local_flowpipe_proof_fp: i64,
    step5_local_flowpipe_proof_audit_fp: i64,
    step1_step2_bridge_fp: i64,
    step1_step2_bridge_audit_fp: i64,
    step2_step3_bridge_fp: i64,
    step2_step3_bridge_audit_fp: i64,
    step3_step4_bridge_fp: i64,
    step3_step4_bridge_audit_fp: i64,
    step4_step5_bridge_fp: i64,
    step4_step5_bridge_audit_fp: i64,
    trajectory5_manifest_fp: i64,
    five_step_chain_anchor_fp: i64,
    step5_certificate_fp: i64,
    global_flowpipe_claim_mask: i64,
    chain_status: i64) -> i64 with Mod {
    var local_proof_chain_mask: i64 = 0
    if step1_local_flowpipe_proof_fp == 908974219 {
        if step1_local_flowpipe_proof_audit_fp == 890221848 { local_proof_chain_mask = local_proof_chain_mask + 1 }
    }
    if step2_local_flowpipe_proof_fp == 418029869 {
        if step2_local_flowpipe_proof_audit_fp == 518930343 { local_proof_chain_mask = local_proof_chain_mask + 2 }
    }
    if step3_local_flowpipe_proof_fp == 78860411 {
        if step3_local_flowpipe_proof_audit_fp == 972719127 { local_proof_chain_mask = local_proof_chain_mask + 4 }
    }
    if step4_local_flowpipe_proof_fp == 354200144 {
        if step4_local_flowpipe_proof_audit_fp == 97568991 { local_proof_chain_mask = local_proof_chain_mask + 8 }
    }
    if step5_local_flowpipe_proof_fp == 965829478 {
        if step5_local_flowpipe_proof_audit_fp == 618466007 { local_proof_chain_mask = local_proof_chain_mask + 16 }
    }

    var bridge_chain_mask: i64 = 0
    if step1_step2_bridge_fp == 595466240 {
        if step1_step2_bridge_audit_fp == 382059454 { bridge_chain_mask = bridge_chain_mask + 1 }
    }
    if step2_step3_bridge_fp == 158202075 {
        if step2_step3_bridge_audit_fp == 952956886 { bridge_chain_mask = bridge_chain_mask + 2 }
    }
    if step3_step4_bridge_fp == 692714944 {
        if step3_step4_bridge_audit_fp == 627937430 { bridge_chain_mask = bridge_chain_mask + 4 }
    }
    if step4_step5_bridge_fp == 880867663 {
        if step4_step5_bridge_audit_fp == 674753000 { bridge_chain_mask = bridge_chain_mask + 8 }
    }

    var chain_anchor_mask: i64 = 0
    if trajectory5_manifest_fp == 214180161 { chain_anchor_mask = chain_anchor_mask + 1 }
    if five_step_chain_anchor_fp == 23144051 { chain_anchor_mask = chain_anchor_mask + 2 }
    if step5_certificate_fp == 561641681 { chain_anchor_mask = chain_anchor_mask + 4 }

    let step_count: i64 = 5
    let bridge_count: i64 = 4
    let source_width_bits: i64 = 256
    let scale_log2: i64 = 32
    let selected_dt_num: i64 = 1
    let selected_dt_den: i64 = 100
    let adjacency_chain_mask: i64 = bridge_chain_mask

    var chain_composition_mask: i64 = 0
    if local_proof_chain_mask == 31 { chain_composition_mask = chain_composition_mask + 1 }
    if bridge_chain_mask == 15 { chain_composition_mask = chain_composition_mask + 2 }
    if chain_anchor_mask == 7 { chain_composition_mask = chain_composition_mask + 4 }
    if adjacency_chain_mask == 15 { chain_composition_mask = chain_composition_mask + 8 }
    if step_count == 5 {
        if bridge_count == 4 { chain_composition_mask = chain_composition_mask + 16 }
    }

    var non_global_ok: i64 = 1
    if global_flowpipe_claim_mask != 0 { non_global_ok = 0 }
    if chain_status != 26 { non_global_ok = 0 }

    var contract_ok: i64 = 1
    if source_width_bits != 256 { contract_ok = 0 }
    if scale_log2 != 32 { contract_ok = 0 }
    if selected_dt_num != 1 { contract_ok = 0 }
    if selected_dt_den != 100 { contract_ok = 0 }

    var dependency_closure_ok: i64 = 1
    if local_proof_chain_mask != 31 { dependency_closure_ok = 0 }
    if bridge_chain_mask != 15 { dependency_closure_ok = 0 }
    if chain_anchor_mask != 7 { dependency_closure_ok = 0 }
    if chain_composition_mask != 31 { dependency_closure_ok = 0 }

    var ok_mask: i64 = 0
    if local_proof_chain_mask == 31 { ok_mask = ok_mask + 1 }
    if bridge_chain_mask == 15 { ok_mask = ok_mask + 2 }
    if chain_anchor_mask == 7 { ok_mask = ok_mask + 4 }
    if contract_ok == 1 { ok_mask = ok_mask + 8 }
    if chain_composition_mask == 31 { ok_mask = ok_mask + 16 }
    if non_global_ok == 1 { ok_mask = ok_mask + 32 }
    if dependency_closure_ok == 1 { ok_mask = ok_mask + 64 }
    if adjacency_chain_mask == 15 { ok_mask = ok_mask + 128 }
    if ok_mask != 255 { return 0 - 1 }

    let instance_fp = lorenz_i256_five_step_local_flowpipe_chain_instance_fingerprint(
        step_count, bridge_count,
        step1_local_flowpipe_proof_fp, step1_local_flowpipe_proof_audit_fp,
        step2_local_flowpipe_proof_fp, step2_local_flowpipe_proof_audit_fp,
        step3_local_flowpipe_proof_fp, step3_local_flowpipe_proof_audit_fp,
        step4_local_flowpipe_proof_fp, step4_local_flowpipe_proof_audit_fp,
        step5_local_flowpipe_proof_fp, step5_local_flowpipe_proof_audit_fp,
        step1_step2_bridge_fp, step1_step2_bridge_audit_fp,
        step2_step3_bridge_fp, step2_step3_bridge_audit_fp,
        step3_step4_bridge_fp, step3_step4_bridge_audit_fp,
        step4_step5_bridge_fp, step4_step5_bridge_audit_fp,
        trajectory5_manifest_fp, five_step_chain_anchor_fp, step5_certificate_fp,
        source_width_bits, scale_log2, selected_dt_num, selected_dt_den,
        local_proof_chain_mask, bridge_chain_mask, chain_anchor_mask,
        adjacency_chain_mask, chain_composition_mask, global_flowpipe_claim_mask,
        chain_status)
    let certificate_fp = lorenz_i256_five_step_local_flowpipe_chain_certificate_fingerprint(
        instance_fp, local_proof_chain_mask, bridge_chain_mask,
        chain_anchor_mask, adjacency_chain_mask, chain_composition_mask,
        global_flowpipe_claim_mask, chain_status, ok_mask)

    return lorenz_i256_five_step_local_flowpipe_chain_fingerprint(
        instance_fp, certificate_fp, 18, step_count, bridge_count,
        chain_composition_mask, global_flowpipe_claim_mask, chain_status,
        ok_mask)
}

