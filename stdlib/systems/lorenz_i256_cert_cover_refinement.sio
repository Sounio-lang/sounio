pub fn lorenz_i256_cover_refinement_ledger_check(
    finite_cover_candidate_fp: i64,
    finite_cover_candidate_audit_fp: i64,
    v149_portfolio_entry_fp: i64,
    v149_manifest_fp: i64,
    v149_readiness_fp: i64,
    preflight_fp: i64,
    preflight_audit_fp: i64,
    dependency_dag_fp: i64,
    dependency_dag_audit_fp: i64,
    projection_certificate_envelope_fp: i64,
    projection_certificate_envelope_audit_fp: i64,
    final_enclosure_receipt_fp: i64,
    ball_fixed_enclosure_fp: i64,
    global_flowpipe_claim_mask: i64,
    refinement_status: i64) -> i64 with Mod {
    var cover_refinement_input_mask: i64 = 0
    if finite_cover_candidate_fp == 911169246 {
        if finite_cover_candidate_audit_fp == 785916873 { cover_refinement_input_mask = cover_refinement_input_mask + 1 }
    }
    if v149_portfolio_entry_fp == 820916947 {
        if v149_manifest_fp == 527721765 {
            if v149_readiness_fp == 437511874 { cover_refinement_input_mask = cover_refinement_input_mask + 2 }
        }
    }
    if preflight_fp == 461075499 {
        if preflight_audit_fp == 641858696 { cover_refinement_input_mask = cover_refinement_input_mask + 4 }
    }
    if dependency_dag_fp == 713010204 {
        if dependency_dag_audit_fp == 725222703 { cover_refinement_input_mask = cover_refinement_input_mask + 8 }
    }
    if projection_certificate_envelope_fp == 77888110 {
        if projection_certificate_envelope_audit_fp == 245178976 { cover_refinement_input_mask = cover_refinement_input_mask + 16 }
    }

    let candidate_cell_count: i64 = 1
    let parent_cell_count: i64 = 1
    let split_axis_count: i64 = 3
    let split_factor_per_axis: i64 = 2
    let child_cell_count: i64 = 8
    let pending_child_obligation_count: i64 = 8
    let resolved_child_count: i64 = 0
    let source_width_bits: i64 = 256
    let scale_log2: i64 = 32
    let target_scale: i64 = 1000000
    let step_count: i64 = 5
    let refinement_level: i64 = 1
    let refinement_version: i64 = 1
    let global_cover_certificate_mask: i64 = 0

    var subdivision_plan_mask: i64 = 0
    if split_axis_count == 3 { subdivision_plan_mask = subdivision_plan_mask + 1 }
    if split_factor_per_axis == 2 { subdivision_plan_mask = subdivision_plan_mask + 2 }
    if child_cell_count == 8 { subdivision_plan_mask = subdivision_plan_mask + 4 }

    var child_obligation_mask: i64 = 0
    if pending_child_obligation_count == 8 { child_obligation_mask = child_obligation_mask + 1 }
    if resolved_child_count == 0 { child_obligation_mask = child_obligation_mask + 2 }
    if refinement_level == 1 { child_obligation_mask = child_obligation_mask + 4 }
    if parent_cell_count == candidate_cell_count { child_obligation_mask = child_obligation_mask + 8 }

    var nonclaim_ok: i64 = 1
    if global_cover_certificate_mask != 0 { nonclaim_ok = 0 }
    if global_flowpipe_claim_mask != 0 { nonclaim_ok = 0 }
    if refinement_status != 29 { nonclaim_ok = 0 }

    var contract_ok: i64 = 1
    if final_enclosure_receipt_fp != 114244647 { contract_ok = 0 }
    if ball_fixed_enclosure_fp != 166945519 { contract_ok = 0 }
    if source_width_bits != 256 { contract_ok = 0 }
    if scale_log2 != 32 { contract_ok = 0 }
    if target_scale != 1000000 { contract_ok = 0 }
    if step_count != 5 { contract_ok = 0 }

    var ok_mask: i64 = 0
    if cover_refinement_input_mask == 31 { ok_mask = ok_mask + 1 }
    if subdivision_plan_mask == 7 { ok_mask = ok_mask + 2 }
    if child_obligation_mask == 15 { ok_mask = ok_mask + 4 }
    if pending_child_obligation_count == child_cell_count { ok_mask = ok_mask + 8 }
    if resolved_child_count == 0 { ok_mask = ok_mask + 16 }
    if nonclaim_ok == 1 { ok_mask = ok_mask + 32 }
    if contract_ok == 1 { ok_mask = ok_mask + 64 }
    if refinement_version == 1 { ok_mask = ok_mask + 128 }
    if ok_mask != 255 { return 0 - 1 }

    let instance_fp = lorenz_i256_cover_refinement_ledger_instance_fingerprint(
        finite_cover_candidate_fp, finite_cover_candidate_audit_fp,
        v149_portfolio_entry_fp, v149_manifest_fp, v149_readiness_fp,
        preflight_fp, preflight_audit_fp, dependency_dag_fp,
        dependency_dag_audit_fp, projection_certificate_envelope_fp,
        projection_certificate_envelope_audit_fp, final_enclosure_receipt_fp,
        ball_fixed_enclosure_fp, candidate_cell_count, parent_cell_count,
        split_axis_count, split_factor_per_axis, child_cell_count,
        pending_child_obligation_count, resolved_child_count, source_width_bits,
        scale_log2, target_scale, step_count, refinement_level,
        cover_refinement_input_mask, subdivision_plan_mask,
        child_obligation_mask, global_cover_certificate_mask,
        global_flowpipe_claim_mask, refinement_status)
    let certificate_fp = lorenz_i256_cover_refinement_ledger_certificate_fingerprint(
        instance_fp, cover_refinement_input_mask, subdivision_plan_mask,
        child_obligation_mask, child_cell_count, pending_child_obligation_count,
        resolved_child_count, global_cover_certificate_mask,
        global_flowpipe_claim_mask, refinement_version, refinement_status,
        ok_mask)

    return lorenz_i256_cover_refinement_ledger_fingerprint(
        instance_fp, certificate_fp, 21, child_cell_count,
        pending_child_obligation_count, resolved_child_count, refinement_level,
        global_cover_certificate_mask, global_flowpipe_claim_mask,
        refinement_status, ok_mask)
}
