    if projection_certificate_envelope_audit_fp != 245178976 { return 0 - 1 }
    if final_enclosure_receipt_fp != 114244647 { return 0 - 1 }
    if ball_fixed_enclosure_fp != 166945519 { return 0 - 1 }
    if candidate_cell_count != 1 { return 0 - 1 }
    if parent_cell_count != 1 { return 0 - 1 }
    if split_axis_count != 3 { return 0 - 1 }
    if split_factor_per_axis != 2 { return 0 - 1 }
    if child_cell_count != 8 { return 0 - 1 }
    if pending_child_obligation_count != 8 { return 0 - 1 }
    if resolved_child_count != 0 { return 0 - 1 }
    if source_width_bits != 256 { return 0 - 1 }
    if scale_log2 != 32 { return 0 - 1 }
    if target_scale != 1000000 { return 0 - 1 }
    if step_count != 5 { return 0 - 1 }
    if refinement_level != 1 { return 0 - 1 }
    if cover_refinement_input_mask != 31 { return 0 - 1 }
    if subdivision_plan_mask != 7 { return 0 - 1 }
    if child_obligation_mask != 15 { return 0 - 1 }
    if global_cover_certificate_mask != 0 { return 0 - 1 }
    if global_flowpipe_claim_mask != 0 { return 0 - 1 }
    if refinement_status != 29 { return 0 - 1 }

    var fp: i64 = 1801
    fp = lorenz_i256_cert_mix(fp, finite_cover_candidate_fp, 5741)
    fp = lorenz_i256_cert_mix(fp, finite_cover_candidate_audit_fp, 5741)
    fp = lorenz_i256_cert_mix(fp, v149_portfolio_entry_fp, 5741)
    fp = lorenz_i256_cert_mix(fp, v149_manifest_fp, 5741)
    fp = lorenz_i256_cert_mix(fp, v149_readiness_fp, 5741)
    fp = lorenz_i256_cert_mix(fp, preflight_fp, 5741)
    fp = lorenz_i256_cert_mix(fp, preflight_audit_fp, 5741)
    fp = lorenz_i256_cert_mix(fp, dependency_dag_fp, 5741)
    fp = lorenz_i256_cert_mix(fp, dependency_dag_audit_fp, 5741)
    fp = lorenz_i256_cert_mix(fp, projection_certificate_envelope_fp, 5741)
    fp = lorenz_i256_cert_mix(fp, projection_certificate_envelope_audit_fp, 5741)
    fp = lorenz_i256_cert_mix(fp, final_enclosure_receipt_fp, 5741)
    fp = lorenz_i256_cert_mix(fp, ball_fixed_enclosure_fp, 5741)
    fp = lorenz_i256_cert_mix(fp, candidate_cell_count, 5741)
    fp = lorenz_i256_cert_mix(fp, parent_cell_count, 5741)
    fp = lorenz_i256_cert_mix(fp, split_axis_count, 5741)
    fp = lorenz_i256_cert_mix(fp, split_factor_per_axis, 5741)
    fp = lorenz_i256_cert_mix(fp, child_cell_count, 5741)
    fp = lorenz_i256_cert_mix(fp, pending_child_obligation_count, 5741)
    fp = lorenz_i256_cert_mix(fp, resolved_child_count, 5741)
    fp = lorenz_i256_cert_mix(fp, source_width_bits, 5741)
    fp = lorenz_i256_cert_mix(fp, scale_log2, 5741)
    fp = lorenz_i256_cert_mix(fp, target_scale, 5741)
    fp = lorenz_i256_cert_mix(fp, step_count, 5741)
    fp = lorenz_i256_cert_mix(fp, refinement_level, 5741)
    fp = lorenz_i256_cert_mix(fp, cover_refinement_input_mask, 5741)
    fp = lorenz_i256_cert_mix(fp, subdivision_plan_mask, 5741)
    fp = lorenz_i256_cert_mix(fp, child_obligation_mask, 5741)
    fp = lorenz_i256_cert_mix(fp, global_cover_certificate_mask, 5741)
    fp = lorenz_i256_cert_mix(fp, global_flowpipe_claim_mask, 5741)
    fp = lorenz_i256_cert_mix(fp, refinement_status, 5741)
