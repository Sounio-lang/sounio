    source_width_bits: i64,
    scale_log2: i64,
    target_scale: i64,
    step_count: i64,
    refinement_level: i64,
    cover_refinement_input_mask: i64,
    subdivision_plan_mask: i64,
    child_obligation_mask: i64,
    global_cover_certificate_mask: i64,
    global_flowpipe_claim_mask: i64,
    refinement_status: i64) -> i64 with Mod {
    if finite_cover_candidate_fp != 911169246 { return 0 - 1 }
    if finite_cover_candidate_audit_fp != 785916873 { return 0 - 1 }
    if v149_portfolio_entry_fp != 820916947 { return 0 - 1 }
    if v149_manifest_fp != 527721765 { return 0 - 1 }
    if v149_readiness_fp != 437511874 { return 0 - 1 }
    if preflight_fp != 461075499 { return 0 - 1 }
    if preflight_audit_fp != 641858696 { return 0 - 1 }
    if dependency_dag_fp != 713010204 { return 0 - 1 }
    if dependency_dag_audit_fp != 725222703 { return 0 - 1 }
