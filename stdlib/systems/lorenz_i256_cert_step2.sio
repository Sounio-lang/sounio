        time_slab_containment_mask, local_time_slab_seed_mask,
        candidate_kind_ball_enclosure, required_artifact_count,
        required_center_artifact, required_radius_artifact,
        required_remainder_artifact, required_proof_trace_artifact,
        anchor_mask, contract_mask, candidate_requirement_mask,
        response_envelope_mask, local_response_seed_mask,
        local_response_proof_mask, global_flowpipe_claim_mask, response_status)
    let certificate_fp = lorenz_i256_step2_taylor2_response_envelope_certificate_fingerprint(
        instance_fp, anchor_mask, contract_mask, candidate_requirement_mask,
        response_envelope_mask, local_response_seed_mask,
        local_response_proof_mask, global_flowpipe_claim_mask,
        response_status, ok_mask)

    return lorenz_i256_step2_taylor2_response_envelope_fingerprint(
        instance_fp, certificate_fp, 20, step_index, response_envelope_mask,
