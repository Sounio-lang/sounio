pub fn lorenz_i256_step2_taylor2_point_time_slab_containment_check(
    local_flowpipe_seed_fp: i64,
    local_flowpipe_seed_audit_fp: i64,
    global_flowpipe_claim_mask: i64,
    time_slab_status: i64) -> i64 with Mod {
    let scale: i256 = 4294967296 as i256
    let target_scale: i256 = 1000000 as i256
    let x1: i256 = 4294967296 as i256
    let y1: i256 = 5411658768 as i256
    let dy_scaled_q: i256 = 116035699778 as i256
    let beta_q: i256 = 11262358693 as i256
    let xy_scaled_q: i256 = 5411658768 as i256
    let dx_num: i256 = (10 as i256) * (y1 - x1)
    let dy_num: i256 = dy_scaled_q - y1
    let dz_drop_num: i256 = beta_q - xy_scaled_q

    let dx_bound: i64 = 2600000
    let dy_bound: i64 = 25756667
    let dz_bound: i64 = 1362223
    var derivative_bound_mask: i64 = 0
    if ((dx_bound - 1) as i256) * scale < dx_num * target_scale {
        if (dx_bound as i256) * scale >= dx_num * target_scale {
            derivative_bound_mask = derivative_bound_mask + 1
        }
    }
    if ((dy_bound - 1) as i256) * scale < dy_num * target_scale {
        if (dy_bound as i256) * scale >= dy_num * target_scale {
            derivative_bound_mask = derivative_bound_mask + 2
        }
    }
    if ((dz_bound - 1) as i256) * scale < dz_drop_num * target_scale {
        if (dz_bound as i256) * scale >= dz_drop_num * target_scale {
            derivative_bound_mask = derivative_bound_mask + 4
        }
    }

    let selected_dt_num: i64 = 1
    let selected_dt_den: i64 = 100
    let x_sweep: i64 = 26000
    let y_sweep: i64 = 257567
    let z_sweep: i64 = 13623
    var sweep_ceiling_mask: i64 = 0
    if (x_sweep - 1) * selected_dt_den < dx_bound {
        if x_sweep * selected_dt_den >= dx_bound { sweep_ceiling_mask = sweep_ceiling_mask + 1 }
    }
    if (y_sweep - 1) * selected_dt_den < dy_bound {
        if y_sweep * selected_dt_den >= dy_bound { sweep_ceiling_mask = sweep_ceiling_mask + 2 }
    }
    if (z_sweep - 1) * selected_dt_den < dz_bound {
        if z_sweep * selected_dt_den >= dz_bound { sweep_ceiling_mask = sweep_ceiling_mask + 4 }
    }

    let x_slab_margin: i64 = 26100
    let y_slab_margin: i64 = 257700
    let z_slab_margin: i64 = 13700
    let x_slab_slack: i64 = x_slab_margin - x_sweep
    let y_slab_slack: i64 = y_slab_margin - y_sweep
    let z_slab_slack: i64 = z_slab_margin - z_sweep

    var slab_margin_mask: i64 = 0
    if x_slab_slack == 100 {
        if x_slab_slack > 0 { slab_margin_mask = slab_margin_mask + 1 }
    }
    if y_slab_slack == 133 {
        if y_slab_slack > 0 { slab_margin_mask = slab_margin_mask + 2 }
    }
    if z_slab_slack == 77 {
        if z_slab_slack > 0 { slab_margin_mask = slab_margin_mask + 4 }
    }

    var time_slab_containment_mask: i64 = 0
    if x_sweep <= x_slab_margin { time_slab_containment_mask = time_slab_containment_mask + 1 }
    if y_sweep <= y_slab_margin { time_slab_containment_mask = time_slab_containment_mask + 2 }
    if z_sweep <= z_slab_margin { time_slab_containment_mask = time_slab_containment_mask + 4 }

    var seed_anchor_mask: i64 = 0
    if local_flowpipe_seed_fp == 633359277 { seed_anchor_mask = seed_anchor_mask + 1 }
    if local_flowpipe_seed_audit_fp == 421619310 { seed_anchor_mask = seed_anchor_mask + 2 }

    var local_time_slab_seed_mask: i64 = 0
    if seed_anchor_mask == 3 { local_time_slab_seed_mask = local_time_slab_seed_mask + 1 }
    if derivative_bound_mask == 7 { local_time_slab_seed_mask = local_time_slab_seed_mask + 2 }
    if sweep_ceiling_mask == 7 { local_time_slab_seed_mask = local_time_slab_seed_mask + 4 }
    if slab_margin_mask == 7 {
        if time_slab_containment_mask == 7 { local_time_slab_seed_mask = local_time_slab_seed_mask + 8 }
    }

    let local_time_slab_proof_mask: i64 = 0

    var time_contract_ok: i64 = 1
    if selected_dt_num != 1 { time_contract_ok = 0 }
    if selected_dt_den != 100 { time_contract_ok = 0 }

    var non_global_ok: i64 = 1
    if global_flowpipe_claim_mask != 0 { non_global_ok = 0 }
    if time_slab_status != 23 { non_global_ok = 0 }

    var dependency_closure_ok: i64 = 1
    if seed_anchor_mask != 3 { dependency_closure_ok = 0 }
    if local_time_slab_seed_mask != 15 { dependency_closure_ok = 0 }
    if local_time_slab_proof_mask != 0 { dependency_closure_ok = 0 }

    var ok_mask: i64 = 0
    if seed_anchor_mask == 3 { ok_mask = ok_mask + 1 }
    if derivative_bound_mask == 7 { ok_mask = ok_mask + 2 }
    if sweep_ceiling_mask == 7 { ok_mask = ok_mask + 4 }
    if slab_margin_mask == 7 { ok_mask = ok_mask + 8 }
    if time_contract_ok == 1 { ok_mask = ok_mask + 16 }
    if local_time_slab_seed_mask == 15 { ok_mask = ok_mask + 32 }
    if non_global_ok == 1 { ok_mask = ok_mask + 64 }
    if dependency_closure_ok == 1 { ok_mask = ok_mask + 128 }
    if ok_mask != 255 { return 0 - 1 }

    let instance_fp = lorenz_i256_step2_taylor2_point_time_slab_containment_instance_fingerprint(
        local_flowpipe_seed_fp, local_flowpipe_seed_audit_fp, 2, 256, 32,
        selected_dt_num, selected_dt_den, dx_bound, dy_bound, dz_bound,
        x_sweep, y_sweep, z_sweep, x_slab_margin, y_slab_margin,
        z_slab_margin, x_slab_slack, y_slab_slack, z_slab_slack,
        seed_anchor_mask, derivative_bound_mask, sweep_ceiling_mask,
        slab_margin_mask, time_slab_containment_mask,
        local_time_slab_seed_mask, local_time_slab_proof_mask,
        global_flowpipe_claim_mask, time_slab_status)
    let certificate_fp = lorenz_i256_step2_taylor2_point_time_slab_containment_certificate_fingerprint(
        instance_fp, dx_bound, dy_bound, dz_bound, x_sweep, y_sweep,
        z_sweep, x_slab_slack, y_slab_slack, z_slab_slack,
        seed_anchor_mask, derivative_bound_mask, sweep_ceiling_mask,
        slab_margin_mask, time_slab_containment_mask,
        local_time_slab_seed_mask, local_time_slab_proof_mask,
        global_flowpipe_claim_mask, time_slab_status, ok_mask)

    return lorenz_i256_step2_taylor2_point_time_slab_containment_fingerprint(
        instance_fp, certificate_fp, 19, 2, time_slab_containment_mask,
        local_time_slab_seed_mask, local_time_slab_proof_mask,
        global_flowpipe_claim_mask, time_slab_status, ok_mask)
}

