pub fn lorenz_i256_step2_taylor2_remainder_obligation_check(
    x_lte_cap_ppm: i64,
    y_lte_cap_ppm: i64,
    z_lte_cap_ppm: i64,
    global_flowpipe_claim_mask: i64) -> i64 with Mod {
    let source_scale: i256 = 4294967296 as i256
    let target_scale: i256 = 1000000 as i256
    let dt_q: i256 = 42949672 as i256
    let start_x: i256 = 4406636440 as i256
    let start_y: i256 = 6517899153 as i256
    let start_z: i256 = 4164877513 as i256
    // Remainder replay uses the input source radii anchored by v117, matching step-3 v103.
    let rx: i256 = 112098647 as i256
    let ry: i256 = 1106813073 as i256
    let rz: i256 = 58841052 as i256

    let x_abs: i256 = 4518735087 as i256
    let y_abs: i256 = 7624712226 as i256
    let z_abs: i256 = 4223718565 as i256
    let rhoz_abs: i256 = 116153047827 as i256
    let x_prime: i256 = 121434473130 as i256
    let y_prime: i256 = 129829333707 as i256
    let z_prime: i256 = 19285209231 as i256
    let x_second: i256 = 2512638068370 as i256
    let y_second: i256 = 3434191844255 as i256
    let z_second: i256 = 403599237402 as i256
    let x_lte_source: i256 = 125631898 as i256
    let y_lte_source: i256 = 171709585 as i256
    let z_lte_source: i256 = 20179961 as i256
    let x_lte_ppm: i256 = 29251 as i256
    let y_lte_ppm: i256 = 39980 as i256
    let z_lte_ppm: i256 = 4699 as i256
    let den: i256 = (2 as i256) * source_scale * source_scale

    var abs_box_ok: i64 = 1
    if x_abs != start_x + rx { abs_box_ok = 0 }
    if y_abs != start_y + ry { abs_box_ok = 0 }
    if z_abs != start_z + rz { abs_box_ok = 0 }
    if rhoz_abs != (28 as i256) * source_scale - (start_z - rz) { abs_box_ok = 0 }

    let y_prime_product: i256 = x_abs * rhoz_abs
    let xy_product: i256 = x_abs * y_abs
    let beta_z_product: i256 = (8 as i256) * z_abs
    var first_derivative_ok: i64 = 1
    if x_prime != (10 as i256) * (x_abs + y_abs) { first_derivative_ok = 0 }
    if (y_prime - y_abs - (1 as i256)) * source_scale >= y_prime_product {
        first_derivative_ok = 0
    }
    if (y_prime - y_abs) * source_scale < y_prime_product {
        first_derivative_ok = 0
    }
    if ((8021959724 as i256) - (1 as i256)) * source_scale >= xy_product {
        first_derivative_ok = 0
    }
    if (8021959724 as i256) * source_scale < xy_product {
        first_derivative_ok = 0
    }
    if ((11263249507 as i256) - (1 as i256)) * (3 as i256) >= beta_z_product {
        first_derivative_ok = 0
    }
    if (11263249507 as i256) * (3 as i256) < beta_z_product {
        first_derivative_ok = 0
    }
    if z_prime != (8021959724 as i256) + (11263249507 as i256) {
        first_derivative_ok = 0
    }

    let y_second_a: i256 = x_prime * rhoz_abs
    let y_second_b: i256 = x_abs * z_prime
    let z_second_a: i256 = x_prime * y_abs
    let z_second_b: i256 = x_abs * y_prime
    let z_second_c: i256 = (8 as i256) * z_prime
    var second_derivative_ok: i64 = 1
    if x_second != (10 as i256) * (y_prime + x_prime) { second_derivative_ok = 0 }
    if ((3284072541939 as i256) - (1 as i256)) * source_scale >= y_second_a {
        second_derivative_ok = 0
    }
    if (3284072541939 as i256) * source_scale < y_second_a {
        second_derivative_ok = 0
    }
    if ((20289968609 as i256) - (1 as i256)) * source_scale >= y_second_b {
        second_derivative_ok = 0
    }
    if (20289968609 as i256) * source_scale < y_second_b {
        second_derivative_ok = 0
    }
    if y_second != (3284072541939 as i256) + (20289968609 as i256) + y_prime {
        second_derivative_ok = 0
    }
    if ((215578570947 as i256) - (1 as i256)) * source_scale >= z_second_a {
        second_derivative_ok = 0
    }
    if (215578570947 as i256) * source_scale < z_second_a {
        second_derivative_ok = 0
    }
    if ((136593441839 as i256) - (1 as i256)) * source_scale >= z_second_b {
        second_derivative_ok = 0
    }
    if (136593441839 as i256) * source_scale < z_second_b {
        second_derivative_ok = 0
    }
    if ((51427224616 as i256) - (1 as i256)) * (3 as i256) >= z_second_c {
        second_derivative_ok = 0
    }
    if (51427224616 as i256) * (3 as i256) < z_second_c {
        second_derivative_ok = 0
    }
    if z_second != (215578570947 as i256) + (136593441839 as i256) + (51427224616 as i256) {
        second_derivative_ok = 0
    }

    let dt2: i256 = dt_q * dt_q
    var source_lte_ok: i64 = 1
    if (x_lte_source - (1 as i256)) * den >= x_second * dt2 { source_lte_ok = 0 }
    if x_lte_source * den < x_second * dt2 { source_lte_ok = 0 }
    if (y_lte_source - (1 as i256)) * den >= y_second * dt2 { source_lte_ok = 0 }
    if y_lte_source * den < y_second * dt2 { source_lte_ok = 0 }
    if (z_lte_source - (1 as i256)) * den >= z_second * dt2 { source_lte_ok = 0 }
    if z_lte_source * den < z_second * dt2 { source_lte_ok = 0 }

    var target_lte_ok: i64 = 1
    if (x_lte_ppm - (1 as i256)) * source_scale >= x_lte_source * target_scale {
        target_lte_ok = 0
    }
    if x_lte_ppm * source_scale < x_lte_source * target_scale {
        target_lte_ok = 0
    }
    if (y_lte_ppm - (1 as i256)) * source_scale >= y_lte_source * target_scale {
        target_lte_ok = 0
    }
    if y_lte_ppm * source_scale < y_lte_source * target_scale {
        target_lte_ok = 0
    }
    if (z_lte_ppm - (1 as i256)) * source_scale >= z_lte_source * target_scale {
        target_lte_ok = 0
    }
    if z_lte_ppm * source_scale < z_lte_source * target_scale {
        target_lte_ok = 0
    }

    var cap_ok: i64 = 1
    if x_lte_cap_ppm != 40000 { cap_ok = 0 }
