pub fn lorenz_i256_step2_taylor2_time_slab_containment_check(
    local_containment_obligation_fp: i64,
    local_containment_obligation_audit_fp: i64,
    point_time_slab_fp: i64,
    point_time_slab_audit_fp: i64,
    remainder_obligation_fp: i64,
    global_flowpipe_claim_mask: i64,
    time_slab_status_local: i64) -> i64 with Mod {
    var anchor_ok: i64 = 1
    if local_containment_obligation_fp != 311696236 { anchor_ok = 0 }
    if local_containment_obligation_audit_fp != 301485983 { anchor_ok = 0 }
    if point_time_slab_fp != 268229078 { anchor_ok = 0 }
    if point_time_slab_audit_fp != 223161586 { anchor_ok = 0 }

    var remainder_anchor_ok: i64 = 1
    if remainder_obligation_fp != 444092349 { remainder_anchor_ok = 0 }

    let selected_dt_num: i64 = 1
    let selected_dt_den: i64 = 100
    let dx_bound: i64 = 2600000
    let dy_bound: i64 = 25756667
    let dz_bound: i64 = 1362223
    let x_sweep: i64 = 26000
    let y_sweep: i64 = 257567
    let z_sweep: i64 = 13623

    var ceil_sweep_ok: i64 = 1
    if (x_sweep - 1) * selected_dt_den >= dx_bound { ceil_sweep_ok = 0 }
    if x_sweep * selected_dt_den < dx_bound { ceil_sweep_ok = 0 }
    if (y_sweep - 1) * selected_dt_den >= dy_bound { ceil_sweep_ok = 0 }
    if y_sweep * selected_dt_den < dy_bound { ceil_sweep_ok = 0 }
    if (z_sweep - 1) * selected_dt_den >= dz_bound { ceil_sweep_ok = 0 }
    if z_sweep * selected_dt_den < dz_bound { ceil_sweep_ok = 0 }

    let x_slab_margin: i64 = 26100
    let y_slab_margin: i64 = 257700
    let z_slab_margin: i64 = 13700
    let x_slab_slack: i64 = x_slab_margin - x_sweep
    let y_slab_slack: i64 = y_slab_margin - y_sweep
    let z_slab_slack: i64 = z_slab_margin - z_sweep

    var slab_margin_ok: i64 = 1
    if x_slab_slack != 100 { slab_margin_ok = 0 }
    if y_slab_slack != 133 { slab_margin_ok = 0 }
    if z_slab_slack != 77 { slab_margin_ok = 0 }
    if x_slab_slack <= 0 { slab_margin_ok = 0 }
    if y_slab_slack <= 0 { slab_margin_ok = 0 }
    if z_slab_slack <= 0 { slab_margin_ok = 0 }

    var time_slab_containment_mask: i64 = 0
    if x_sweep <= x_slab_margin { time_slab_containment_mask = time_slab_containment_mask + 1 }
    if y_sweep <= y_slab_margin { time_slab_containment_mask = time_slab_containment_mask + 2 }
    if z_sweep <= z_slab_margin { time_slab_containment_mask = time_slab_containment_mask + 4 }

    var time_contract_ok: i64 = 1
    if selected_dt_num != 1 { time_contract_ok = 0 }
    if selected_dt_den != 100 { time_contract_ok = 0 }

    let local_time_slab_obligation_mask: i64 = time_slab_containment_mask
    var local_obligation_ok: i64 = 1
    if local_time_slab_obligation_mask != 7 { local_obligation_ok = 0 }
    if time_slab_status_local != 13 { local_obligation_ok = 0 }

    var non_global_claim_ok: i64 = 1
    if global_flowpipe_claim_mask != 0 { non_global_claim_ok = 0 }

    var v124_bridge_ok: i64 = 1
    if local_containment_obligation_fp != 311696236 { v124_bridge_ok = 0 }
    if time_slab_containment_mask != 7 { v124_bridge_ok = 0 }

    var ok_mask: i64 = 0
    if anchor_ok == 1 { ok_mask = ok_mask + 1 }
    if remainder_anchor_ok == 1 { ok_mask = ok_mask + 2 }
    if ceil_sweep_ok == 1 { ok_mask = ok_mask + 4 }
    if slab_margin_ok == 1 { ok_mask = ok_mask + 8 }
    if time_contract_ok == 1 { ok_mask = ok_mask + 16 }
    if local_obligation_ok == 1 { ok_mask = ok_mask + 32 }
    if non_global_claim_ok == 1 { ok_mask = ok_mask + 64 }
    if v124_bridge_ok == 1 { ok_mask = ok_mask + 128 }
    if ok_mask != 255 { return 0 - 1 }

    let instance_fp = lorenz_i256_step2_taylor2_time_slab_containment_instance_fingerprint(
        2, local_containment_obligation_fp, local_containment_obligation_audit_fp,
        point_time_slab_fp, point_time_slab_audit_fp, remainder_obligation_fp,
        dx_bound, dy_bound, dz_bound, selected_dt_num, selected_dt_den,
        x_sweep, y_sweep, z_sweep, x_slab_margin, y_slab_margin,
        z_slab_margin, x_slab_slack, y_slab_slack, z_slab_slack,
        time_slab_containment_mask, local_time_slab_obligation_mask,
        global_flowpipe_claim_mask, time_slab_status_local)
    let certificate_fp = lorenz_i256_step2_taylor2_time_slab_containment_certificate_fingerprint(
        instance_fp, dx_bound, dy_bound, dz_bound, selected_dt_num,
        selected_dt_den, x_sweep, y_sweep, z_sweep, x_slab_margin,
        y_slab_margin, z_slab_margin, x_slab_slack, y_slab_slack,
        z_slab_slack, time_slab_containment_mask,
        local_time_slab_obligation_mask, global_flowpipe_claim_mask,
        time_slab_status_local, ok_mask)

    return lorenz_i256_step2_taylor2_time_slab_containment_fingerprint(
        instance_fp, certificate_fp, 14, 2, time_slab_containment_mask,
        local_time_slab_obligation_mask, global_flowpipe_claim_mask,
        time_slab_status_local, ok_mask)
}

