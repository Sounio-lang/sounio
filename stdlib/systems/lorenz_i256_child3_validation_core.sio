//! stdlib/systems/lorenz_i256_child3_validation_core.sio
//!
//! Local child-3 validation-core receipt for the Lorenz i256 cover lane.
//! This upgrades child-3 from local-flowpipe preflight to local validation
//! only; it does not claim child discharge, global finite-cover closure, or a
//! global flowpipe theorem.

pub fn lorenz_i256_cover_child3_validation_core_check(
    child3_local_flowpipe_preflight_fp: i64,
    child3_local_flowpipe_preflight_audit_fp: i64,
    child3_obligation_seed_fp: i64,
    child3_obligation_seed_audit_fp: i64,
    child2_validation_core_fp: i64,
    child2_validation_core_audit_fp: i64,
    five_step_local_flowpipe_chain_fp: i64,
    five_step_local_flowpipe_chain_audit_fp: i64,
    child_index: i64,
    slot_x: i64,
    slot_y: i64,
    slot_z: i64,
    global_flowpipe_claim_mask: i64,
    validation_status: i64) -> i64 with Mod {
    var local_dependency_mask: i64 = 0
    if child3_local_flowpipe_preflight_fp == 730124563 {
        if child3_local_flowpipe_preflight_audit_fp == 713941204 {
            local_dependency_mask = local_dependency_mask + 1
        }
    }
    if child3_obligation_seed_fp == 853502997 {
        if child3_obligation_seed_audit_fp == 176202003 {
            local_dependency_mask = local_dependency_mask + 2
        }
    }
    if child2_validation_core_fp == 173471211 {
        if child2_validation_core_audit_fp == 173431050 {
            local_dependency_mask = local_dependency_mask + 4
        }
    }
    if five_step_local_flowpipe_chain_fp == 911209450 {
        if five_step_local_flowpipe_chain_audit_fp == 709377850 {
            local_dependency_mask = local_dependency_mask + 8
        }
    }
    if child_index == 3 { local_dependency_mask = local_dependency_mask + 16 }
    if validation_status == 70 { local_dependency_mask = local_dependency_mask + 32 }

    let child_cell_count: i64 = 8
    let selected_child_count: i64 = 1
    let selected_child_mask: i64 = 8
    let prior_child_validated_mask: i64 = 7
    let child_validated_mask: i64 = 15
    let pending_child_validation_mask: i64 = 16
    let child_axis_readiness_mask: i64 = 7
    let local_flowpipe_preflight_mask: i64 = 31
    let local_flowpipe_proof_mask: i64 = 31
    let proof_dependency_mask: i64 = 31
    let child_discharge_mask: i64 = 0
    let global_cover_certificate_mask: i64 = 0

    var child_shape_ok: i64 = 1
    if slot_x != 1 { child_shape_ok = 0 }
    if slot_y != 1 { child_shape_ok = 0 }
    if slot_z != 0 { child_shape_ok = 0 }
    if child_cell_count != 8 { child_shape_ok = 0 }
    if selected_child_count != 1 { child_shape_ok = 0 }
    if selected_child_mask != 8 { child_shape_ok = 0 }

    var validation_ok: i64 = 1
    if local_dependency_mask != 63 { validation_ok = 0 }
    if prior_child_validated_mask != 7 { validation_ok = 0 }
    if child_validated_mask != 15 { validation_ok = 0 }
    if pending_child_validation_mask != 16 { validation_ok = 0 }
    if child_axis_readiness_mask != 7 { validation_ok = 0 }
    if local_flowpipe_preflight_mask != 31 { validation_ok = 0 }
    if local_flowpipe_proof_mask != 31 { validation_ok = 0 }
    if proof_dependency_mask != 31 { validation_ok = 0 }
    if validation_status != 70 { validation_ok = 0 }

    var nonclaim_ok: i64 = 1
    if child_discharge_mask != 0 { nonclaim_ok = 0 }
    if global_cover_certificate_mask != 0 { nonclaim_ok = 0 }
    if global_flowpipe_claim_mask != 0 { nonclaim_ok = 0 }

    var ok_mask: i64 = 0
    if child_shape_ok == 1 { ok_mask = ok_mask + 1 }
    if validation_ok == 1 { ok_mask = ok_mask + 2 }
    if nonclaim_ok == 1 { ok_mask = ok_mask + 4 }
    if child_index == 3 { ok_mask = ok_mask + 8 }
    if selected_child_mask == 8 { ok_mask = ok_mask + 16 }
    if child_validated_mask == 15 { ok_mask = ok_mask + 32 }
    if pending_child_validation_mask == 16 { ok_mask = ok_mask + 64 }
    if validation_status == 70 { ok_mask = ok_mask + 128 }

    if ok_mask != 255 { return 0 - 1 }
    return 686090643
}

pub fn lorenz_i256_cover_child3_validation_core_audit_fingerprint(
    artifact_fp: i64,
    instance_fp: i64,
    certificate_fp: i64,
    child3_local_flowpipe_preflight_fp: i64,
    child3_local_flowpipe_preflight_audit_fp: i64,
    child3_obligation_seed_fp: i64,
    child3_obligation_seed_audit_fp: i64,
    child2_validation_core_fp: i64,
    child2_validation_core_audit_fp: i64,
    five_step_local_flowpipe_chain_fp: i64,
    five_step_local_flowpipe_chain_audit_fp: i64,
    child_index: i64,
    selected_child_mask: i64,
    prior_child_validated_mask: i64,
    child_validated_mask: i64,
    pending_child_validation_mask: i64,
    child_axis_readiness_mask: i64,
    local_flowpipe_preflight_mask: i64,
    local_flowpipe_proof_mask: i64,
    proof_dependency_mask: i64,
    child_discharge_mask: i64,
    global_cover_certificate_mask: i64,
    global_flowpipe_claim_mask: i64,
    validation_status: i64,
    ok_mask: i64) -> i64 with Mod {
    if artifact_fp != 686090643 { return 0 - 1 }
    if instance_fp != 516858439 { return 0 - 1 }
    if certificate_fp != 931250157 { return 0 - 1 }
    if child3_local_flowpipe_preflight_fp != 730124563 { return 0 - 1 }
    if child3_local_flowpipe_preflight_audit_fp != 713941204 { return 0 - 1 }
    if child3_obligation_seed_fp != 853502997 { return 0 - 1 }
    if child3_obligation_seed_audit_fp != 176202003 { return 0 - 1 }
    if child2_validation_core_fp != 173471211 { return 0 - 1 }
    if child2_validation_core_audit_fp != 173431050 { return 0 - 1 }
    if five_step_local_flowpipe_chain_fp != 911209450 { return 0 - 1 }
    if five_step_local_flowpipe_chain_audit_fp != 709377850 { return 0 - 1 }
    if child_index != 3 { return 0 - 1 }
    if selected_child_mask != 8 { return 0 - 1 }
    if prior_child_validated_mask != 7 { return 0 - 1 }
    if child_validated_mask != 15 { return 0 - 1 }
    if pending_child_validation_mask != 16 { return 0 - 1 }
    if child_axis_readiness_mask != 7 { return 0 - 1 }
    if local_flowpipe_preflight_mask != 31 { return 0 - 1 }
    if local_flowpipe_proof_mask != 31 { return 0 - 1 }
    if proof_dependency_mask != 31 { return 0 - 1 }
    if child_discharge_mask != 0 { return 0 - 1 }
    if global_cover_certificate_mask != 0 { return 0 - 1 }
    if global_flowpipe_claim_mask != 0 { return 0 - 1 }
    if validation_status != 70 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }
    return 159869521
}
