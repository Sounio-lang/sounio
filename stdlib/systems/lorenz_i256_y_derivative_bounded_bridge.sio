//! stdlib/systems/lorenz_i256_y_derivative_bounded_bridge.sio
//!
//! Portable bounded Lorenz y-derivative fragment over decimal i256-like limbs:
//! x*(rho-z)-y with rho=28 and z<=rho. This composes signed delta with the
//! fixed-scale product bridge, then compares the product against y.

use systems::lorenz_i256_scaled_product_bridge::*
use systems::lorenz_i256_signed_delta_bridge::*

pub fn lorenz_i256_rho_minus_z_abs_limb(
    z0: i64,
    z1: i64,
    z2: i64,
    z3: i64,
    limb_index: i64) -> i64 {
    let sign = lorenz_i256_signed_delta_sign(0, 28, 0, 0, z0, z1, z2, z3)
    if sign < 0 { return 0 - 1 }
    return lorenz_i256_signed_delta_abs_limb(0, 28, 0, 0, z0, z1, z2, z3, limb_index)
}

pub fn lorenz_i256_x_rho_minus_z_product_limb(
    x0: i64,
    x1: i64,
    x2: i64,
    x3: i64,
    z0: i64,
    z1: i64,
    z2: i64,
    z3: i64,
    limb_index: i64) -> i64 with Div {
    let d0 = lorenz_i256_rho_minus_z_abs_limb(z0, z1, z2, z3, 0)
    let d1 = lorenz_i256_rho_minus_z_abs_limb(z0, z1, z2, z3, 1)
    let d2 = lorenz_i256_rho_minus_z_abs_limb(z0, z1, z2, z3, 2)
    let d3 = lorenz_i256_rho_minus_z_abs_limb(z0, z1, z2, z3, 3)
    if d0 < 0 { return 0 - 1 }
    if d1 < 0 { return 0 - 1 }
    if d2 < 0 { return 0 - 1 }
    if d3 < 0 { return 0 - 1 }
    return lorenz_dec2_scaled_product_limb(x0, x1, x2, x3, d0, d1, d2, d3, limb_index)
}

pub fn lorenz_i256_y_derivative_bounded_sign(
    x0: i64,
    x1: i64,
    x2: i64,
    x3: i64,
    z0: i64,
    z1: i64,
    z2: i64,
    z3: i64,
    y0: i64,
    y1: i64,
    y2: i64,
    y3: i64) -> i64 with Div {
    let p0 = lorenz_i256_x_rho_minus_z_product_limb(x0, x1, x2, x3, z0, z1, z2, z3, 0)
    let p1 = lorenz_i256_x_rho_minus_z_product_limb(x0, x1, x2, x3, z0, z1, z2, z3, 1)
    let p2 = lorenz_i256_x_rho_minus_z_product_limb(x0, x1, x2, x3, z0, z1, z2, z3, 2)
    let p3 = lorenz_i256_x_rho_minus_z_product_limb(x0, x1, x2, x3, z0, z1, z2, z3, 3)
    if p0 < 0 { return 0 - 2 }
    if p1 < 0 { return 0 - 2 }
    if p2 < 0 { return 0 - 2 }
    if p3 < 0 { return 0 - 2 }
    return lorenz_i256_signed_delta_sign(p0, p1, p2, p3, y0, y1, y2, y3)
}

pub fn lorenz_i256_y_derivative_bounded_abs_limb(
    x0: i64,
    x1: i64,
    x2: i64,
    x3: i64,
    z0: i64,
    z1: i64,
    z2: i64,
    z3: i64,
    y0: i64,
    y1: i64,
    y2: i64,
    y3: i64,
    limb_index: i64) -> i64 with Div {
    let p0 = lorenz_i256_x_rho_minus_z_product_limb(x0, x1, x2, x3, z0, z1, z2, z3, 0)
    let p1 = lorenz_i256_x_rho_minus_z_product_limb(x0, x1, x2, x3, z0, z1, z2, z3, 1)
    let p2 = lorenz_i256_x_rho_minus_z_product_limb(x0, x1, x2, x3, z0, z1, z2, z3, 2)
    let p3 = lorenz_i256_x_rho_minus_z_product_limb(x0, x1, x2, x3, z0, z1, z2, z3, 3)
    if p0 < 0 { return 0 - 1 }
    if p1 < 0 { return 0 - 1 }
    if p2 < 0 { return 0 - 1 }
    if p3 < 0 { return 0 - 1 }
    return lorenz_i256_signed_delta_abs_limb(p0, p1, p2, p3, y0, y1, y2, y3, limb_index)
}

pub fn lorenz_i256_y_derivative_bounded_check(
    x0: i64,
    x1: i64,
    x2: i64,
    x3: i64,
    z0: i64,
    z1: i64,
    z2: i64,
    z3: i64,
    y0: i64,
    y1: i64,
    y2: i64,
    y3: i64,
    expected_sign: i64,
    expected_l0: i64,
    expected_l1: i64,
    expected_l2: i64,
    expected_l3: i64) -> i64 with Div {
    let sign = lorenz_i256_y_derivative_bounded_sign(x0, x1, x2, x3, z0, z1, z2, z3, y0, y1, y2, y3)
    let r0 = lorenz_i256_y_derivative_bounded_abs_limb(x0, x1, x2, x3, z0, z1, z2, z3, y0, y1, y2, y3, 0)
    let r1 = lorenz_i256_y_derivative_bounded_abs_limb(x0, x1, x2, x3, z0, z1, z2, z3, y0, y1, y2, y3, 1)
    let r2 = lorenz_i256_y_derivative_bounded_abs_limb(x0, x1, x2, x3, z0, z1, z2, z3, y0, y1, y2, y3, 2)
    let r3 = lorenz_i256_y_derivative_bounded_abs_limb(x0, x1, x2, x3, z0, z1, z2, z3, y0, y1, y2, y3, 3)
    if sign != expected_sign { return 0 }
    if r0 != expected_l0 { return 0 }
    if r1 != expected_l1 { return 0 }
    if r2 != expected_l2 { return 0 }
    if r3 != expected_l3 { return 0 }
    return 1
}

pub fn lorenz_i256_y_derivative_bounded_bridge_receipt_check(
    positive_term_ok: i64,
    negative_term_ok: i64,
    zero_term_ok: i64,
    z_gt_rho_rejected: i64,
    inexact_product_rejected: i64,
    product_anchor_ok: i64,
    delta_anchor_ok: i64,
    target_integer_width: i64,
    limb_base: i64,
    native_i256_evidence_mask: i64,
    imported_runtime_evidence_mask: i64,
    bridge_status: i64) -> i64 {
    if positive_term_ok != 1 { return 0 - 1 }
    if negative_term_ok != 1 { return 0 - 1 }
    if zero_term_ok != 1 { return 0 - 1 }
    if z_gt_rho_rejected != 1 { return 0 - 1 }
    if inexact_product_rejected != 1 { return 0 - 1 }
    if product_anchor_ok != 1 { return 0 - 1 }
    if delta_anchor_ok != 1 { return 0 - 1 }
    if target_integer_width != 256 { return 0 - 1 }
    if limb_base != 1000000000 { return 0 - 1 }
    if native_i256_evidence_mask != 0 { return 0 - 1 }
    if imported_runtime_evidence_mask != 0 { return 0 - 1 }
    if bridge_status != 110 { return 0 - 1 }
    return 742619083
}

pub fn lorenz_i256_y_derivative_bounded_bridge_audit_fingerprint(
    artifact_fp: i64,
    instance_fp: i64,
    certificate_fp: i64,
    product_fp: i64,
    product_audit_fp: i64,
    delta_fp: i64,
    delta_audit_fp: i64,
    positive_term_ok: i64,
    negative_term_ok: i64,
    zero_term_ok: i64,
    z_gt_rho_rejected: i64,
    inexact_product_rejected: i64,
    target_integer_width: i64,
    limb_base: i64,
    native_i256_evidence_mask: i64,
    imported_runtime_evidence_mask: i64,
    public_claim_mask: i64,
    formal_theorem_ready: i64,
    bridge_status: i64,
    ok_mask: i64) -> i64 {
    if artifact_fp != 742619083 { return 0 - 1 }
    if instance_fp != 815204637 { return 0 - 1 }
    if certificate_fp != 204973856 { return 0 - 1 }
    if product_fp != 920174638 { return 0 - 1 }
    if product_audit_fp != 481036275 { return 0 - 1 }
    if delta_fp != 492681735 { return 0 - 1 }
    if delta_audit_fp != 837260419 { return 0 - 1 }
    if positive_term_ok != 1 { return 0 - 1 }
    if negative_term_ok != 1 { return 0 - 1 }
    if zero_term_ok != 1 { return 0 - 1 }
    if z_gt_rho_rejected != 1 { return 0 - 1 }
    if inexact_product_rejected != 1 { return 0 - 1 }
    if target_integer_width != 256 { return 0 - 1 }
    if limb_base != 1000000000 { return 0 - 1 }
    if native_i256_evidence_mask != 0 { return 0 - 1 }
    if imported_runtime_evidence_mask != 0 { return 0 - 1 }
    if public_claim_mask != 0 { return 0 - 1 }
    if formal_theorem_ready != 0 { return 0 - 1 }
    if bridge_status != 110 { return 0 - 1 }
    if ok_mask != 1023 { return 0 - 1 }
    return 396508712
}
