//! stdlib/systems/lorenz_i256_child1_validation_core.sio
//!
//! Local child-1 validation-core receipt for the Lorenz i256 cover lane.
//! This module records a local validation step only; it does not claim child
//! discharge, global finite-cover closure, or a global flowpipe theorem.

pub fn lorenz_i256_cover_child1_validation_core_check(
    axis_arithmetic_readiness_fp: i64,
    axis_arithmetic_readiness_audit_fp: i64,
    validation_guard_fp: i64,
    validation_guard_audit_fp: i64,
    containment_obligation_fp: i64,
    containment_obligation_audit_fp: i64,
    axis_arithmetic_bundle_fp: i64,
    axis_arithmetic_bundle_audit_fp: i64,
    child_index: i64,
    axis_count: i64,
    global_flowpipe_claim_mask: i64,
    validation_status: i64) -> i64 with Mod {
    var axis_readiness_dependency_mask: i64 = 0
    if axis_arithmetic_readiness_fp == 915034032 {
        if axis_arithmetic_readiness_audit_fp == 801472810 {
            axis_readiness_dependency_mask = axis_readiness_dependency_mask + 1
        }
    }
    if axis_arithmetic_bundle_fp == 12112784 {
        if axis_arithmetic_bundle_audit_fp == 2218347 {
            axis_readiness_dependency_mask = axis_readiness_dependency_mask + 2
        }
    }
    if child_index == 1 { axis_readiness_dependency_mask = axis_readiness_dependency_mask + 4 }
    if validation_status == 62 { axis_readiness_dependency_mask = axis_readiness_dependency_mask + 8 }

    var validation_guard_dependency_mask: i64 = 0
    if validation_guard_fp == 399287919 {
        if validation_guard_audit_fp == 812182729 {
            validation_guard_dependency_mask = validation_guard_dependency_mask + 1
        }
    }
    if containment_obligation_fp == 697916891 {
        if containment_obligation_audit_fp == 284547222 {
            validation_guard_dependency_mask = validation_guard_dependency_mask + 2
        }
    }
    if child_index == 1 { validation_guard_dependency_mask = validation_guard_dependency_mask + 4 }
    if validation_status == 62 { validation_guard_dependency_mask = validation_guard_dependency_mask + 8 }

    var containment_dependency_mask: i64 = 0
    if containment_obligation_fp == 697916891 {
        if containment_obligation_audit_fp == 284547222 {
            containment_dependency_mask = containment_dependency_mask + 1
        }
    }
    if validation_guard_fp == 399287919 {
        if validation_guard_audit_fp == 812182729 {
            containment_dependency_mask = containment_dependency_mask + 2
        }
    }
    if child_index == 1 { containment_dependency_mask = containment_dependency_mask + 4 }
    if validation_status == 62 { containment_dependency_mask = containment_dependency_mask + 8 }

    var axis_bundle_dependency_mask: i64 = 0
    if axis_arithmetic_bundle_fp == 12112784 {
        if axis_arithmetic_bundle_audit_fp == 2218347 {
            axis_bundle_dependency_mask = axis_bundle_dependency_mask + 1
        }
    }
    if axis_arithmetic_readiness_fp == 915034032 {
        if axis_arithmetic_readiness_audit_fp == 801472810 {
            axis_bundle_dependency_mask = axis_bundle_dependency_mask + 2
        }
    }
    if axis_count == 3 { axis_bundle_dependency_mask = axis_bundle_dependency_mask + 4 }
    if validation_status == 62 { axis_bundle_dependency_mask = axis_bundle_dependency_mask + 8 }

    let step_count: i64 = 5
    let target_scale: i64 = 1000000
    let source_width_bits: i64 = 256
    let scale_log2: i64 = 32
    let total_axis_need_ppm: i64 = 2344801
    let min_axis_slack_ppm: i64 = 122
    let axis_arithmetic_ready_mask: i64 = 7
    let pending_child_validation_mask: i64 = 28
    let child_axis_readiness_mask: i64 = 7
    let local_flowpipe_proof_mask: i64 = 31
    let child_validated_mask: i64 = 3
    let child_discharge_mask: i64 = 0
    let global_cover_certificate_mask: i64 = 0

    var child_validation_dependency_mask: i64 = 0
    if axis_readiness_dependency_mask == 15 {
        child_validation_dependency_mask = child_validation_dependency_mask + 1
    }
    if validation_guard_dependency_mask == 15 {
        child_validation_dependency_mask = child_validation_dependency_mask + 2
    }
    if containment_dependency_mask == 15 {
        child_validation_dependency_mask = child_validation_dependency_mask + 4
    }
    if axis_bundle_dependency_mask == 15 {
        child_validation_dependency_mask = child_validation_dependency_mask + 8
    }
    if child_index == 1 { child_validation_dependency_mask = child_validation_dependency_mask + 16 }
    if axis_count == 3 { child_validation_dependency_mask = child_validation_dependency_mask + 32 }

    var validation_ok: i64 = 1
    if child_validation_dependency_mask != 63 { validation_ok = 0 }
    if pending_child_validation_mask != 28 { validation_ok = 0 }
    if child_axis_readiness_mask != 7 { validation_ok = 0 }
    if local_flowpipe_proof_mask != 31 { validation_ok = 0 }
    if child_validated_mask != 3 { validation_ok = 0 }
    if validation_status != 62 { validation_ok = 0 }

    var nonclaim_ok: i64 = 1
    if child_discharge_mask != 0 { nonclaim_ok = 0 }
    if global_cover_certificate_mask != 0 { nonclaim_ok = 0 }
    if global_flowpipe_claim_mask != 0 { nonclaim_ok = 0 }

    var ok_mask: i64 = 0
    if validation_ok == 1 { ok_mask = ok_mask + 1 }
    if nonclaim_ok == 1 { ok_mask = ok_mask + 2 }
    if axis_arithmetic_ready_mask == 7 { ok_mask = ok_mask + 4 }
    if child_index == 1 { ok_mask = ok_mask + 8 }
    if axis_count == 3 { ok_mask = ok_mask + 16 }
    if step_count == 5 { ok_mask = ok_mask + 32 }
    if target_scale == 1000000 { ok_mask = ok_mask + 64 }
    if source_width_bits == 256 { ok_mask = ok_mask + 128 }

    if scale_log2 != 32 { return 0 - 1 }
    if total_axis_need_ppm != 2344801 { return 0 - 1 }
    if min_axis_slack_ppm != 122 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }
    return 648831016
}

