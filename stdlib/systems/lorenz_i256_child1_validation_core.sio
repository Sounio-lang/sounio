    global_flowpipe_claim_mask: i64,
    validation_status: i64,
    ok_mask: i64) -> i64 with Mod {
    if artifact_fp != 648831016 { return 0 - 1 }
    if instance_fp != 485012761 { return 0 - 1 }
    if certificate_fp != 571272160 { return 0 - 1 }
    if axis_arithmetic_readiness_fp != 915034032 { return 0 - 1 }
    if axis_arithmetic_readiness_audit_fp != 801472810 { return 0 - 1 }
    if validation_guard_fp != 399287919 { return 0 - 1 }
    if validation_guard_audit_fp != 812182729 { return 0 - 1 }
    if containment_obligation_fp != 697916891 { return 0 - 1 }
    if containment_obligation_audit_fp != 284547222 { return 0 - 1 }
    if axis_arithmetic_bundle_fp != 12112784 { return 0 - 1 }
    if axis_arithmetic_bundle_audit_fp != 2218347 { return 0 - 1 }
    if total_axis_need_ppm != 2344801 { return 0 - 1 }
    if min_axis_slack_ppm != 122 { return 0 - 1 }
    if axis_arithmetic_ready_mask != 7 { return 0 - 1 }
    if child_validation_dependency_mask != 63 { return 0 - 1 }
    if pending_child_validation_mask != 28 { return 0 - 1 }
    if child_axis_readiness_mask != 7 { return 0 - 1 }
    if local_flowpipe_proof_mask != 31 { return 0 - 1 }
    if child_validated_mask != 3 { return 0 - 1 }
    if child_discharge_mask != 0 { return 0 - 1 }
    if global_cover_certificate_mask != 0 { return 0 - 1 }
    if global_flowpipe_claim_mask != 0 { return 0 - 1 }
    if validation_status != 62 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }
    return 63312412
}
