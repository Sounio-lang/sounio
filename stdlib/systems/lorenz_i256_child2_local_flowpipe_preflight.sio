//! stdlib/systems/lorenz_i256_child2_local_flowpipe_preflight.sio
//!
//! Child-2 local-flowpipe preflight for the Lorenz i256 cover lane.
//! This attaches the child-2 obligation seed to existing five-step local-chain
//! evidence, but it is not a local-flowpipe proof.

pub fn lorenz_i256_cover_child2_local_flowpipe_preflight_check(
    child2_obligation_seed_fp: i64,
    child2_obligation_seed_audit_fp: i64,
    child1_discharge_preflight_fp: i64,
    child1_discharge_preflight_audit_fp: i64,
    five_step_local_flowpipe_chain_fp: i64,
    five_step_local_flowpipe_chain_audit_fp: i64,
    child_index: i64,
    slot_x: i64,
    slot_y: i64,
    slot_z: i64,
    global_flowpipe_claim_mask: i64,
    preflight_status: i64) -> i64 with Mod {
    var inherited_anchor_mask: i64 = 0
    if child2_obligation_seed_fp == 844216507 {
        if child2_obligation_seed_audit_fp == 781563019 {
            inherited_anchor_mask = inherited_anchor_mask + 1
        }
    }
    if child1_discharge_preflight_fp == 719480263 {
        if child1_discharge_preflight_audit_fp == 602184970 {
            inherited_anchor_mask = inherited_anchor_mask + 2
        }
    }
    if five_step_local_flowpipe_chain_fp == 911209450 {
        if five_step_local_flowpipe_chain_audit_fp == 709377850 {
            inherited_anchor_mask = inherited_anchor_mask + 4
        }
    }
    if child_index == 2 { inherited_anchor_mask = inherited_anchor_mask + 8 }
    if preflight_status == 65 { inherited_anchor_mask = inherited_anchor_mask + 16 }

    let child_cell_count: i64 = 8
    let selected_child_count: i64 = 1
    let pending_child_obligation_count: i64 = 8
    let resolved_child_count: i64 = 0
    let selected_child_mask: i64 = 4
    let prior_child_validated_mask: i64 = 3
    let pending_child_validation_mask: i64 = 28
    let local_flowpipe_preflight_mask: i64 = 31
    let proof_dependency_mask: i64 = 31
    let available_local_chain_mask: i64 = 31
    let pending_local_proof_mask: i64 = 31
    let local_flowpipe_proof_mask: i64 = 0
    let child_validated_mask: i64 = 0
    let child_discharge_mask: i64 = 0
    let global_cover_certificate_mask: i64 = 0

    var child_shape_ok: i64 = 1
    if slot_x != 0 { child_shape_ok = 0 }
    if slot_y != 1 { child_shape_ok = 0 }
    if slot_z != 0 { child_shape_ok = 0 }
    if child_cell_count != 8 { child_shape_ok = 0 }
    if selected_child_count != 1 { child_shape_ok = 0 }
    if pending_child_obligation_count != 8 { child_shape_ok = 0 }
    if resolved_child_count != 0 { child_shape_ok = 0 }
    if selected_child_mask != 4 { child_shape_ok = 0 }

    var preflight_ok: i64 = 1
    if inherited_anchor_mask != 31 { preflight_ok = 0 }
    if prior_child_validated_mask != 3 { preflight_ok = 0 }
    if pending_child_validation_mask != 28 { preflight_ok = 0 }
    if local_flowpipe_preflight_mask != 31 { preflight_ok = 0 }
    if proof_dependency_mask != 31 { preflight_ok = 0 }
    if available_local_chain_mask != 31 { preflight_ok = 0 }
    if pending_local_proof_mask != 31 { preflight_ok = 0 }

    var nonclaim_ok: i64 = 1
    if local_flowpipe_proof_mask != 0 { nonclaim_ok = 0 }
    if child_validated_mask != 0 { nonclaim_ok = 0 }
    if child_discharge_mask != 0 { nonclaim_ok = 0 }
    if global_cover_certificate_mask != 0 { nonclaim_ok = 0 }
    if global_flowpipe_claim_mask != 0 { nonclaim_ok = 0 }

    var ok_mask: i64 = 0
    if child_shape_ok == 1 { ok_mask = ok_mask + 1 }
    if preflight_ok == 1 { ok_mask = ok_mask + 2 }
    if nonclaim_ok == 1 { ok_mask = ok_mask + 4 }
    if child_index == 2 { ok_mask = ok_mask + 8 }
    if selected_child_mask == 4 { ok_mask = ok_mask + 16 }
    if local_flowpipe_preflight_mask == 31 { ok_mask = ok_mask + 32 }
    if pending_local_proof_mask == 31 { ok_mask = ok_mask + 64 }
    if preflight_status == 65 { ok_mask = ok_mask + 128 }

    if ok_mask != 255 { return 0 - 1 }
    return 312780944
}

pub fn lorenz_i256_cover_child2_local_flowpipe_preflight_audit_fingerprint(
    artifact_fp: i64,
    instance_fp: i64,
    certificate_fp: i64,
    child2_obligation_seed_fp: i64,
    child2_obligation_seed_audit_fp: i64,
    child1_discharge_preflight_fp: i64,
    child1_discharge_preflight_audit_fp: i64,
    five_step_local_flowpipe_chain_fp: i64,
    five_step_local_flowpipe_chain_audit_fp: i64,
    child_index: i64,
    selected_child_mask: i64,
    prior_child_validated_mask: i64,
    pending_child_validation_mask: i64,
    local_flowpipe_preflight_mask: i64,
    proof_dependency_mask: i64,
    available_local_chain_mask: i64,
    pending_local_proof_mask: i64,
    local_flowpipe_proof_mask: i64,
    child_validated_mask: i64,
    child_discharge_mask: i64,
    global_cover_certificate_mask: i64,
    global_flowpipe_claim_mask: i64,
    preflight_status: i64,
    ok_mask: i64) -> i64 with Mod {
    if artifact_fp != 312780944 { return 0 - 1 }
    if instance_fp != 586307202 { return 0 - 1 }
    if certificate_fp != 103884775 { return 0 - 1 }
    if child2_obligation_seed_fp != 844216507 { return 0 - 1 }
    if child2_obligation_seed_audit_fp != 781563019 { return 0 - 1 }
    if child1_discharge_preflight_fp != 719480263 { return 0 - 1 }
    if child1_discharge_preflight_audit_fp != 602184970 { return 0 - 1 }
    if five_step_local_flowpipe_chain_fp != 911209450 { return 0 - 1 }
    if five_step_local_flowpipe_chain_audit_fp != 709377850 { return 0 - 1 }
    if child_index != 2 { return 0 - 1 }
    if selected_child_mask != 4 { return 0 - 1 }
    if prior_child_validated_mask != 3 { return 0 - 1 }
    if pending_child_validation_mask != 28 { return 0 - 1 }
    if local_flowpipe_preflight_mask != 31 { return 0 - 1 }
    if proof_dependency_mask != 31 { return 0 - 1 }
    if available_local_chain_mask != 31 { return 0 - 1 }
    if pending_local_proof_mask != 31 { return 0 - 1 }
    if local_flowpipe_proof_mask != 0 { return 0 - 1 }
    if child_validated_mask != 0 { return 0 - 1 }
    if child_discharge_mask != 0 { return 0 - 1 }
    if global_cover_certificate_mask != 0 { return 0 - 1 }
    if global_flowpipe_claim_mask != 0 { return 0 - 1 }
    if preflight_status != 65 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }
    return 542916038
}
