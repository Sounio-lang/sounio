//! stdlib/systems/lorenz_i256_child4_boundary_gluing_obligation_seed.sio
//!
//! Boundary-gluing obligation seed for child-4 in the Lorenz i256 cover lane.
//! This opens the boundary-gluing proof surface but does not prove gluing,
//! discharge, finite-cover certification, or any global flowpipe claim.

pub fn lorenz_i256_cover_child4_boundary_gluing_obligation_seed_check(
    child4_discharge_obligation_bundle_fp: i64,
    child4_discharge_obligation_bundle_audit_fp: i64,
    child4_promotion_guard_fp: i64,
    child4_promotion_guard_audit_fp: i64,
    required_boundary_gluing_mask: i64,
    missing_discharge_proof_mask: i64,
    pending_child_discharge_mask: i64,
    boundary_gluing_proof_mask: i64,
    finite_cover_certificate_mask: i64,
    global_certificate_candidate_mask: i64,
    global_flowpipe_claim_mask: i64,
    gluing_status: i64) -> i64 with Mod {
    var anchor_mask: i64 = 0
    if child4_discharge_obligation_bundle_fp == 741805623 {
        if child4_discharge_obligation_bundle_audit_fp == 529164708 {
            anchor_mask = anchor_mask + 1
        }
    }
    if child4_promotion_guard_fp == 657240918 {
        if child4_promotion_guard_audit_fp == 312489670 {
            anchor_mask = anchor_mask + 2
        }
    }
    if required_boundary_gluing_mask == 31 { anchor_mask = anchor_mask + 4 }
    if pending_child_discharge_mask == 255 { anchor_mask = anchor_mask + 8 }
    if gluing_status == 78 { anchor_mask = anchor_mask + 16 }

    let boundary_face_count: i64 = 5
    let boundary_gluing_obligation_mask: i64 = 31
    let boundary_gluing_pending_mask: i64 = 31
    let boundary_gluing_verified_mask: i64 = 0
    let boundary_gluing_candidate_mask: i64 = 0
    let boundary_gluing_audit_mask: i64 = 31
    let solver_boundary_action_mask: i64 = 31
    let ready_for_child_discharge_mask: i64 = 0

    var obligation_ok: i64 = 1
    if boundary_face_count != 5 { obligation_ok = 0 }
    if boundary_gluing_obligation_mask != 31 { obligation_ok = 0 }
    if boundary_gluing_pending_mask != 31 { obligation_ok = 0 }
    if boundary_gluing_verified_mask != 0 { obligation_ok = 0 }
    if boundary_gluing_candidate_mask != 0 { obligation_ok = 0 }
    if boundary_gluing_audit_mask != 31 { obligation_ok = 0 }
    if solver_boundary_action_mask != 31 { obligation_ok = 0 }
    if ready_for_child_discharge_mask != 0 { obligation_ok = 0 }
    if missing_discharge_proof_mask != 255 { obligation_ok = 0 }

    var nonclaim_ok: i64 = 1
    if boundary_gluing_proof_mask != 0 { nonclaim_ok = 0 }
    if finite_cover_certificate_mask != 0 { nonclaim_ok = 0 }
    if global_certificate_candidate_mask != 0 { nonclaim_ok = 0 }
    if global_flowpipe_claim_mask != 0 { nonclaim_ok = 0 }

    var ok_mask: i64 = 0
    if anchor_mask == 31 { ok_mask = ok_mask + 1 }
    if obligation_ok == 1 { ok_mask = ok_mask + 2 }
    if nonclaim_ok == 1 { ok_mask = ok_mask + 4 }
    if required_boundary_gluing_mask == 31 { ok_mask = ok_mask + 8 }
    if boundary_gluing_pending_mask == 31 { ok_mask = ok_mask + 16 }
    if boundary_gluing_verified_mask == 0 { ok_mask = ok_mask + 32 }
    if ready_for_child_discharge_mask == 0 { ok_mask = ok_mask + 64 }
    if gluing_status == 78 { ok_mask = ok_mask + 128 }

    if ok_mask != 255 { return 0 - 1 }
    return 604182937
}

pub fn lorenz_i256_cover_child4_boundary_gluing_obligation_seed_audit_fingerprint(
    artifact_fp: i64,
    instance_fp: i64,
    certificate_fp: i64,
    child4_discharge_obligation_bundle_fp: i64,
    child4_discharge_obligation_bundle_audit_fp: i64,
    child4_promotion_guard_fp: i64,
    child4_promotion_guard_audit_fp: i64,
    required_boundary_gluing_mask: i64,
    missing_discharge_proof_mask: i64,
    pending_child_discharge_mask: i64,
    boundary_face_count: i64,
    boundary_gluing_obligation_mask: i64,
    boundary_gluing_pending_mask: i64,
    boundary_gluing_verified_mask: i64,
    boundary_gluing_candidate_mask: i64,
    boundary_gluing_audit_mask: i64,
    solver_boundary_action_mask: i64,
    ready_for_child_discharge_mask: i64,
    boundary_gluing_proof_mask: i64,
    finite_cover_certificate_mask: i64,
    global_certificate_candidate_mask: i64,
    global_flowpipe_claim_mask: i64,
    gluing_status: i64,
    ok_mask: i64) -> i64 with Mod {
    if artifact_fp != 604182937 { return 0 - 1 }
    if instance_fp != 785604219 { return 0 - 1 }
    if certificate_fp != 140926774 { return 0 - 1 }
    if child4_discharge_obligation_bundle_fp != 741805623 { return 0 - 1 }
    if child4_discharge_obligation_bundle_audit_fp != 529164708 { return 0 - 1 }
    if child4_promotion_guard_fp != 657240918 { return 0 - 1 }
    if child4_promotion_guard_audit_fp != 312489670 { return 0 - 1 }
    if required_boundary_gluing_mask != 31 { return 0 - 1 }
    if missing_discharge_proof_mask != 255 { return 0 - 1 }
    if pending_child_discharge_mask != 255 { return 0 - 1 }
    if boundary_face_count != 5 { return 0 - 1 }
    if boundary_gluing_obligation_mask != 31 { return 0 - 1 }
    if boundary_gluing_pending_mask != 31 { return 0 - 1 }
    if boundary_gluing_verified_mask != 0 { return 0 - 1 }
    if boundary_gluing_candidate_mask != 0 { return 0 - 1 }
    if boundary_gluing_audit_mask != 31 { return 0 - 1 }
    if solver_boundary_action_mask != 31 { return 0 - 1 }
    if ready_for_child_discharge_mask != 0 { return 0 - 1 }
    if boundary_gluing_proof_mask != 0 { return 0 - 1 }
    if finite_cover_certificate_mask != 0 { return 0 - 1 }
    if global_certificate_candidate_mask != 0 { return 0 - 1 }
    if global_flowpipe_claim_mask != 0 { return 0 - 1 }
    if gluing_status != 78 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }
    return 218570463
}
