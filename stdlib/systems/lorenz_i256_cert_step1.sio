    replay_executor_audit_fp: i64,
    completed_bundle_fp: i64,
    radius_artifact_fp: i64,
    remainder_obligation_fp: i64,
    global_flowpipe_claim_mask: i64,
    obligation_status_local: i64) -> i64 with Mod {
    var anchor_ok: i64 = 1
    if enclosure_guard_fp != 737436919 { anchor_ok = 0 }
    if enclosure_guard_audit_fp != 387055804 { anchor_ok = 0 }
    if replay_executor_fp != 815221512 { anchor_ok = 0 }
