        x_need, y_need, z_need, x_margin, y_margin, z_margin, x_slack,
        y_slack, z_slack, axis_containment_mask, local_flowpipe_obligation_mask,
        global_flowpipe_claim_mask, obligation_status_local, ok_mask)

    return lorenz_i256_step1_taylor2_local_containment_obligation_fingerprint(
        instance_fp, certificate_fp, 13, 1, axis_containment_mask,
        local_flowpipe_obligation_mask, global_flowpipe_claim_mask,
