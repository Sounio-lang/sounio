pub fn lorenz_i256_step1_taylor2_radius_artifact_check(
    prior_x_radius_source_i64: i64,
    prior_y_radius_source_i64: i64,
    prior_z_radius_source_i64: i64,
    dx_rad_i64: i64,
    prod_x_rhoz_i64: i64,
    dy_rad_i64: i64,
    prod_xy_i64: i64,
    beta_rad_i64: i64,
    dz_rad_i64: i64,
    next_x_radius_i64: i64,
    next_y_radius_i64: i64,
    next_z_radius_i64: i64,
    x_radius_cap_i64: i64,
    y_radius_cap_i64: i64,
    z_radius_cap_i64: i64,
    global_flowpipe_claim_mask: i64) -> i64 with Mod {
    let source_scale: i256 = 4294967296 as i256
    let target_scale: i256 = 1000000 as i256
    let x1_abs: i256 = 4294967296 as i256
    let y1_abs: i256 = 5411658768 as i256
    let z1: i256 = 4223384510 as i256
    let rhoz_abs: i256 = (28 as i256) * source_scale - z1
    let dt_q: i256 = 42949672 as i256

    let prior_x_radius_source: i256 = prior_x_radius_source_i64 as i256
    let prior_y_radius_source: i256 = prior_y_radius_source_i64 as i256
    let prior_z_radius_source: i256 = prior_z_radius_source_i64 as i256
    let dx_rad: i256 = dx_rad_i64 as i256
    let prod_x_rhoz: i256 = prod_x_rhoz_i64 as i256
    let dy_rad: i256 = dy_rad_i64 as i256
    let prod_xy: i256 = prod_xy_i64 as i256
    let beta_rad: i256 = beta_rad_i64 as i256
    let dz_rad: i256 = dz_rad_i64 as i256
    let next_x_radius: i256 = next_x_radius_i64 as i256
    let next_y_radius: i256 = next_y_radius_i64 as i256
    let next_z_radius: i256 = next_z_radius_i64 as i256
    let x_radius_cap: i256 = x_radius_cap_i64 as i256
    let y_radius_cap: i256 = y_radius_cap_i64 as i256
    let z_radius_cap: i256 = z_radius_cap_i64 as i256

    let x_conv_excess: i256 = prior_x_radius_source * target_scale - (1 as i256) * source_scale
    let y_conv_excess: i256 = prior_y_radius_source * target_scale - (260001 as i256) * source_scale
    let z_conv_excess: i256 = prior_z_radius_source * target_scale - (16667 as i256) * source_scale

    var conversion_ok: i64 = 1
    if x_conv_excess < (0 as i256) { conversion_ok = 0 }
    if y_conv_excess < (0 as i256) { conversion_ok = 0 }
    if z_conv_excess < (0 as i256) { conversion_ok = 0 }
    if x_conv_excess >= target_scale { conversion_ok = 0 }
    if y_conv_excess >= target_scale { conversion_ok = 0 }
    if z_conv_excess >= target_scale { conversion_ok = 0 }

    var dx_ok: i64 = 0
    if dx_rad == (10 as i256) * (prior_x_radius_source + prior_y_radius_source) {
        dx_ok = 1
    }

    let xrhoz_total: i256 =
        x1_abs * prior_z_radius_source +
        rhoz_abs * prior_x_radius_source +
        prior_x_radius_source * prior_z_radius_source
    var xrhoz_ok: i64 = 1
    if (prod_x_rhoz - (1 as i256)) * source_scale > xrhoz_total { xrhoz_ok = 0 }
    if prod_x_rhoz * source_scale <= xrhoz_total { xrhoz_ok = 0 }

    var dy_ok: i64 = 0
    if dy_rad == prod_x_rhoz + prior_y_radius_source {
        dy_ok = 1
    }

    let xy_total: i256 =
        x1_abs * prior_y_radius_source +
        y1_abs * prior_x_radius_source +
        prior_x_radius_source * prior_y_radius_source
    let beta_total: i256 = (8 as i256) * prior_z_radius_source
    var z_derivative_ok: i64 = 1
    if (prod_xy - (1 as i256)) * source_scale > xy_total { z_derivative_ok = 0 }
    if prod_xy * source_scale <= xy_total { z_derivative_ok = 0 }
    if (beta_rad - (2 as i256)) * (3 as i256) >= beta_total { z_derivative_ok = 0 }
    if (beta_rad - (1 as i256)) * (3 as i256) < beta_total { z_derivative_ok = 0 }
    if dz_rad != prod_xy + beta_rad { z_derivative_ok = 0 }

    let x_step_total: i256 = dt_q * dx_rad
    let y_step_total: i256 = dt_q * dy_rad
    let z_step_total: i256 = dt_q * dz_rad
    var next_ok: i64 = 1
    if (next_x_radius - prior_x_radius_source - (1 as i256)) * source_scale > x_step_total { next_ok = 0 }
    if (next_x_radius - prior_x_radius_source) * source_scale <= x_step_total { next_ok = 0 }
    if (next_y_radius - prior_y_radius_source - (1 as i256)) * source_scale > y_step_total { next_ok = 0 }
    if (next_y_radius - prior_y_radius_source) * source_scale <= y_step_total { next_ok = 0 }
    if (next_z_radius - prior_z_radius_source - (1 as i256)) * source_scale > z_step_total { next_ok = 0 }
    if (next_z_radius - prior_z_radius_source) * source_scale <= z_step_total { next_ok = 0 }

    var cap_ok: i64 = 1
    if next_x_radius > x_radius_cap { cap_ok = 0 }
    if next_y_radius > y_radius_cap { cap_ok = 0 }
    if next_z_radius > z_radius_cap { cap_ok = 0 }
    if x_radius_cap != 120000000 as i256 { cap_ok = 0 }
    if y_radius_cap != 1200000000 as i256 { cap_ok = 0 }
    if z_radius_cap != 90000000 as i256 { cap_ok = 0 }

    let local_radius_proof_mask: i64 = 0
    if global_flowpipe_claim_mask != 0 { return 0 - 1 }

    var ok_mask: i64 = 0
    if conversion_ok == 1 { ok_mask = ok_mask + 1 }
