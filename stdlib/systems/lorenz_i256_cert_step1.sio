    if global_flowpipe_claim_mask != 0 { non_global_claim_ok = 0 }

    var v139_bridge_ok: i64 = 1
    if local_containment_obligation_fp != 473585568 { v139_bridge_ok = 0 }
    if time_slab_containment_mask != 7 { v139_bridge_ok = 0 }

