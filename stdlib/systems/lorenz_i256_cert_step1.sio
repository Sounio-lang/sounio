    if time_contract_ok == 1 { ok_mask = ok_mask + 16 }
    if local_obligation_ok == 1 { ok_mask = ok_mask + 32 }
    if non_global_claim_ok == 1 { ok_mask = ok_mask + 64 }
    if v139_bridge_ok == 1 { ok_mask = ok_mask + 128 }
