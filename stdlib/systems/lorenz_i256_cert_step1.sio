pub fn lorenz_i256_step1_taylor2_response_envelope_check(
    point_time_slab_fp: i64,
    point_time_slab_audit_fp: i64,
    local_flowpipe_seed_fp: i64,
    local_flowpipe_seed_audit_fp: i64,
    global_flowpipe_claim_mask: i64,
    response_status: i64) -> i64 with Mod {
    let step_index: i64 = 1
    let taylor_order: i64 = 2
    let selected_dt_num: i64 = 1
    let selected_dt_den: i64 = 100
    let scale_log2: i64 = 32
    let source_width_bits: i64 = 256
    let time_slab_containment_mask: i64 = 7
    let local_time_slab_seed_mask: i64 = 15
    let candidate_kind_ball_enclosure: i64 = 1
    let required_artifact_count: i64 = 4
    let required_center_artifact: i64 = 1
    let required_radius_artifact: i64 = 1
    let required_remainder_artifact: i64 = 1
    let required_proof_trace_artifact: i64 = 1

    var anchor_mask: i64 = 0
    if point_time_slab_fp == 44353214 { anchor_mask = anchor_mask + 1 }
    if point_time_slab_audit_fp == 431845922 { anchor_mask = anchor_mask + 2 }
    if local_flowpipe_seed_fp == 301347724 { anchor_mask = anchor_mask + 4 }
    if local_flowpipe_seed_audit_fp == 777254975 { anchor_mask = anchor_mask + 8 }

    var contract_mask: i64 = 0
    if step_index == 1 { contract_mask = contract_mask + 1 }
    if taylor_order == 2 { contract_mask = contract_mask + 2 }
    if selected_dt_num == 1 {
        if selected_dt_den == 100 { contract_mask = contract_mask + 4 }
    }
    if source_width_bits == 256 {
        if scale_log2 == 32 { contract_mask = contract_mask + 8 }
    }

    var candidate_requirement_mask: i64 = 0
    if candidate_kind_ball_enclosure == 1 { candidate_requirement_mask = candidate_requirement_mask + 1 }
    if required_center_artifact == 1 { candidate_requirement_mask = candidate_requirement_mask + 2 }
    if required_radius_artifact == 1 { candidate_requirement_mask = candidate_requirement_mask + 4 }
    if required_remainder_artifact == 1 {
        if required_proof_trace_artifact == 1 {
            if required_artifact_count == 4 { candidate_requirement_mask = candidate_requirement_mask + 8 }
        }
    }

    var response_envelope_mask: i64 = 0
    if anchor_mask == 15 { response_envelope_mask = response_envelope_mask + 1 }
    if contract_mask == 15 { response_envelope_mask = response_envelope_mask + 2 }
    if time_slab_containment_mask == 7 { response_envelope_mask = response_envelope_mask + 4 }
    if local_time_slab_seed_mask == 15 { response_envelope_mask = response_envelope_mask + 8 }
    if candidate_requirement_mask == 15 { response_envelope_mask = response_envelope_mask + 16 }
    if response_status == 24 { response_envelope_mask = response_envelope_mask + 32 }
    if global_flowpipe_claim_mask == 0 { response_envelope_mask = response_envelope_mask + 64 }

    var local_response_seed_mask: i64 = 0
    if anchor_mask == 15 { local_response_seed_mask = local_response_seed_mask + 1 }
    if contract_mask == 15 { local_response_seed_mask = local_response_seed_mask + 2 }
    if candidate_requirement_mask == 15 { local_response_seed_mask = local_response_seed_mask + 4 }
    if response_envelope_mask == 127 { local_response_seed_mask = local_response_seed_mask + 8 }

    let local_response_proof_mask: i64 = 0

    var non_global_ok: i64 = 1
    if global_flowpipe_claim_mask != 0 { non_global_ok = 0 }
    if response_status != 24 { non_global_ok = 0 }

    var dependency_closure_ok: i64 = 1
    if point_time_slab_fp != 44353214 { dependency_closure_ok = 0 }
    if local_response_seed_mask != 15 { dependency_closure_ok = 0 }
    if local_response_proof_mask != 0 { dependency_closure_ok = 0 }

    var ok_mask: i64 = 0
    if anchor_mask == 15 { ok_mask = ok_mask + 1 }
    if contract_mask == 15 { ok_mask = ok_mask + 2 }
    if candidate_requirement_mask == 15 { ok_mask = ok_mask + 4 }
    if response_envelope_mask == 127 { ok_mask = ok_mask + 8 }
    if local_response_seed_mask == 15 { ok_mask = ok_mask + 16 }
    if non_global_ok == 1 { ok_mask = ok_mask + 32 }
    if time_slab_containment_mask == 7 { ok_mask = ok_mask + 64 }
    if dependency_closure_ok == 1 { ok_mask = ok_mask + 128 }
    if ok_mask != 255 { return 0 - 1 }

    let instance_fp = lorenz_i256_step1_taylor2_response_envelope_instance_fingerprint(
        point_time_slab_fp, point_time_slab_audit_fp, local_flowpipe_seed_fp,
        local_flowpipe_seed_audit_fp, step_index, taylor_order,
        selected_dt_num, selected_dt_den, scale_log2, source_width_bits,
        time_slab_containment_mask, local_time_slab_seed_mask,
        candidate_kind_ball_enclosure, required_artifact_count,
        required_center_artifact, required_radius_artifact,
        required_remainder_artifact, required_proof_trace_artifact,
        anchor_mask, contract_mask, candidate_requirement_mask,
        response_envelope_mask, local_response_seed_mask,
        local_response_proof_mask, global_flowpipe_claim_mask, response_status)
    let certificate_fp = lorenz_i256_step1_taylor2_response_envelope_certificate_fingerprint(
        instance_fp, anchor_mask, contract_mask, candidate_requirement_mask,
        response_envelope_mask, local_response_seed_mask,
        local_response_proof_mask, global_flowpipe_claim_mask,
        response_status, ok_mask)

    return lorenz_i256_step1_taylor2_response_envelope_fingerprint(
        instance_fp, certificate_fp, 20, step_index, response_envelope_mask,
        local_response_seed_mask, local_response_proof_mask,
        global_flowpipe_claim_mask, response_status, ok_mask)
}

