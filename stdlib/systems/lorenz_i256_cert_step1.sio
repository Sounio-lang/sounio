pub fn lorenz_i256_step1_taylor2_remainder_obligation_check(
    x_lte_cap_ppm: i64,
    y_lte_cap_ppm: i64,
    z_lte_cap_ppm: i64,
    global_flowpipe_claim_mask: i64) -> i64 with Mod {
    let source_scale: i256 = 4294967296 as i256
    let target_scale: i256 = 1000000 as i256
    let dt_q: i256 = 42949672 as i256
    let start_x: i256 = 4294967296 as i256
    let start_y: i256 = 5411658768 as i256
    let start_z: i256 = 4223384510 as i256
    let rx: i256 = 4295 as i256
    let ry: i256 = 1116695792 as i256
    let rz: i256 = 71584220 as i256

    let x_abs: i256 = 4294971591 as i256
    let y_abs: i256 = 6528354560 as i256
    let z_abs: i256 = 4294968730 as i256
    let rhoz_abs: i256 = 116107283998 as i256
    let x_prime: i256 = 108233261510 as i256
    let y_prime: i256 = 122635754667 as i256
    let z_prime: i256 = 17981611036 as i256
    let x_second: i256 = 2308690161770 as i256
    let y_second: i256 = 3066523255862 as i256
    let z_second: i256 = 335101505169 as i256
    let x_lte_source: i256 = 115434503 as i256
    let y_lte_source: i256 = 153326156 as i256
    let z_lte_source: i256 = 16755075 as i256
    let x_lte_ppm: i256 = 26877 as i256
    let y_lte_ppm: i256 = 35700 as i256
    let z_lte_ppm: i256 = 3902 as i256
    let den: i256 = (2 as i256) * source_scale * source_scale

    var abs_box_ok: i64 = 1
    if x_abs != start_x + rx { abs_box_ok = 0 }
    if y_abs != start_y + ry { abs_box_ok = 0 }
    if z_abs != start_z + rz { abs_box_ok = 0 }
    if rhoz_abs != (28 as i256) * source_scale - (start_z - rz) { abs_box_ok = 0 }

