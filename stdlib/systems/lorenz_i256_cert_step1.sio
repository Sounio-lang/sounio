    var candidate_artifacts_ok: i64 = 1
    if completed_bundle_fp != 620127047 { candidate_artifacts_ok = 0 }
    if radius_artifact_fp != 133154696 { candidate_artifacts_ok = 0 }
    if remainder_obligation_fp != 265853299 { candidate_artifacts_ok = 0 }

    let x_radius: i64 = 1
    let y_radius: i64 = 260001
    let z_radius: i64 = 16667
    let x_lte: i64 = 26877
    let y_lte: i64 = 35700
    let z_lte: i64 = 3902
    let x_need: i64 = x_radius + x_lte
    let y_need: i64 = y_radius + y_lte
    let z_need: i64 = z_radius + z_lte
    let x_margin: i64 = 27000
    let y_margin: i64 = 296000
    let z_margin: i64 = 21000
    let x_slack: i64 = x_margin - x_need
    let y_slack: i64 = y_margin - y_need
    let z_slack: i64 = z_margin - z_need

    var need_arithmetic_ok: i64 = 1
    if x_need != 26878 { need_arithmetic_ok = 0 }
    if y_need != 295701 { need_arithmetic_ok = 0 }
    if z_need != 20569 { need_arithmetic_ok = 0 }

    var axis_containment_mask: i64 = 0
    if x_need <= x_margin { axis_containment_mask = axis_containment_mask + 1 }
    if y_need <= y_margin { axis_containment_mask = axis_containment_mask + 2 }
    if z_need <= z_margin { axis_containment_mask = axis_containment_mask + 4 }

    var axis_containment_ok: i64 = 1
    if axis_containment_mask != 7 { axis_containment_ok = 0 }
    if x_slack <= 0 { axis_containment_ok = 0 }
    if y_slack <= 0 { axis_containment_ok = 0 }
    if z_slack <= 0 { axis_containment_ok = 0 }

    var taylor_contract_ok: i64 = 1
    let taylor_order: i64 = 2
    let target_scale: i64 = 1000000
    let selected_dt_num: i64 = 1
    let selected_dt_den: i64 = 100
    if taylor_order != 2 { taylor_contract_ok = 0 }
    if target_scale != 1000000 { taylor_contract_ok = 0 }
    if selected_dt_num != 1 { taylor_contract_ok = 0 }
    if selected_dt_den != 100 { taylor_contract_ok = 0 }

    let local_flowpipe_obligation_mask: i64 = 7
    var obligation_status_ok: i64 = 1
    if axis_containment_mask != 7 { obligation_status_ok = 0 }
    if local_flowpipe_obligation_mask != 7 { obligation_status_ok = 0 }
    if obligation_status_local != 12 { obligation_status_ok = 0 }

    var nonclaim_ok: i64 = 1
    if global_flowpipe_claim_mask != 0 { nonclaim_ok = 0 }

    var slack_profile_ok: i64 = 1
    if x_slack != 122 { slack_profile_ok = 0 }
    if y_slack != 299 { slack_profile_ok = 0 }
    if z_slack != 431 { slack_profile_ok = 0 }

    var ok_mask: i64 = 0
    if anchor_ok == 1 { ok_mask = ok_mask + 1 }
    if candidate_artifacts_ok == 1 { ok_mask = ok_mask + 2 }
    if need_arithmetic_ok == 1 { ok_mask = ok_mask + 4 }
    if axis_containment_ok == 1 { ok_mask = ok_mask + 8 }
    if taylor_contract_ok == 1 { ok_mask = ok_mask + 16 }
    if obligation_status_ok == 1 { ok_mask = ok_mask + 32 }
    if nonclaim_ok == 1 { ok_mask = ok_mask + 64 }
    if slack_profile_ok == 1 { ok_mask = ok_mask + 128 }
    if ok_mask != 255 { return 0 - 1 }

    let instance_fp = lorenz_i256_step1_taylor2_local_containment_obligation_instance_fingerprint(
        1, enclosure_guard_fp, enclosure_guard_audit_fp, replay_executor_fp,
        replay_executor_audit_fp, completed_bundle_fp, radius_artifact_fp,
        remainder_obligation_fp, taylor_order, target_scale, selected_dt_num,
        selected_dt_den, x_radius, y_radius, z_radius, x_lte, y_lte, z_lte,
        x_need, y_need, z_need, x_margin, y_margin, z_margin, x_slack,
