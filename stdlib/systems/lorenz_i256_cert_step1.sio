    dt_r: i64,
    dy_scaled_q_i64: i64,
    dy_scaled_r_i64: i64,
    xy_scaled_q_i64: i64,
    xy_scaled_r_i64: i64,
    beta_q_i64: i64,
    beta_r_i64: i64,
    x_inc_q_i64: i64,
    x_inc_r_i64: i64,
    y_inc_q_i64: i64,
    y_inc_r_i64: i64,
    z_drop_q_i64: i64,
    z_drop_r_i64: i64,
    final_x_i64: i64,
    final_y_i64: i64,
    final_z_i64: i64) -> i64 with Mod {
    let scale: i256 = 4294967296 as i256
    let x0: i256 = scale
    let y0: i256 = scale
    let z0: i256 = scale

    let dt: i256 = dt_q as i256
    let dy_scaled_q: i256 = dy_scaled_q_i64 as i256
    let dy_scaled_r: i256 = dy_scaled_r_i64 as i256
    let xy_scaled_q: i256 = xy_scaled_q_i64 as i256
    let xy_scaled_r: i256 = xy_scaled_r_i64 as i256
    let beta_q: i256 = beta_q_i64 as i256
    let beta_r: i256 = beta_r_i64 as i256
    let x_inc_q: i256 = x_inc_q_i64 as i256
    let x_inc_r: i256 = x_inc_r_i64 as i256
    let y_inc_q: i256 = y_inc_q_i64 as i256
    let y_inc_r: i256 = y_inc_r_i64 as i256
    let z_drop_q: i256 = z_drop_q_i64 as i256
    let z_drop_r: i256 = z_drop_r_i64 as i256

    let dx_num: i256 = (10 as i256) * (y0 - x0)
    let dy_num: i256 = x0 * ((28 as i256) * scale - z0)
    let xy_num: i256 = x0 * y0
    let beta_num_z: i256 = (8 as i256) * z0
    let dy: i256 = dy_scaled_q - y0
    let z_drop_num: i256 = beta_q - xy_scaled_q
    if z_drop_num <= (0 as i256) { return 0 - 1 }

    let dt_ok = div_witness_check_i256(scale, 100 as i256, dt, dt_r as i256)
    let dy_scaled_ok = div_witness_check_i256(dy_num, scale, dy_scaled_q, dy_scaled_r)
    let xy_scaled_ok = div_witness_check_i256(xy_num, scale, xy_scaled_q, xy_scaled_r)
    let beta_ok = div_witness_check_i256(beta_num_z, 3 as i256, beta_q, beta_r)
    let x_inc_ok = div_witness_check_i256(dt * dx_num, scale, x_inc_q, x_inc_r)
    let y_inc_ok = div_witness_check_i256(dt * dy, scale, y_inc_q, y_inc_r)
    let z_drop_ok = div_witness_check_i256(dt * z_drop_num, scale, z_drop_q, z_drop_r)

    var point_replay_mask: i64 = 0
    if dt_ok == 1 { point_replay_mask = point_replay_mask + 1 }
    if dy_scaled_ok == 1 { point_replay_mask = point_replay_mask + 2 }
    if xy_scaled_ok == 1 { point_replay_mask = point_replay_mask + 4 }
    if beta_ok == 1 { point_replay_mask = point_replay_mask + 8 }
    if x_inc_ok == 1 { point_replay_mask = point_replay_mask + 16 }
    if y_inc_ok == 1 { point_replay_mask = point_replay_mask + 32 }
    if z_drop_ok == 1 { point_replay_mask = point_replay_mask + 64 }

    var anchor_mask: i64 = 0
    if response_envelope_fp == 496675613 { anchor_mask = anchor_mask + 1 }
    if response_envelope_audit_fp == 467471545 { anchor_mask = anchor_mask + 2 }
    if point_time_slab_fp == 44353214 { anchor_mask = anchor_mask + 4 }
    if point_time_slab_audit_fp == 431845922 { anchor_mask = anchor_mask + 8 }
    if local_flowpipe_seed_fp == 301347724 { anchor_mask = anchor_mask + 16 }
    if local_flowpipe_seed_audit_fp == 777254975 { anchor_mask = anchor_mask + 32 }

    var final_center_mask: i64 = 0
    if x0 + x_inc_q == final_x_i64 as i256 { final_center_mask = final_center_mask + 1 }
    if y0 + y_inc_q == final_y_i64 as i256 { final_center_mask = final_center_mask + 2 }
    if z0 - z_drop_q == final_z_i64 as i256 { final_center_mask = final_center_mask + 4 }

    let local_center_proof_mask: i64 = 0
    var center_candidate_mask: i64 = 0
    if point_replay_mask == 127 { center_candidate_mask = center_candidate_mask + 1 }
    if anchor_mask == 63 { center_candidate_mask = center_candidate_mask + 2 }
    if final_center_mask == 7 { center_candidate_mask = center_candidate_mask + 4 }
    if local_center_proof_mask == 0 {
        if global_flowpipe_claim_mask == 0 { center_candidate_mask = center_candidate_mask + 8 }
    }

    var ok_mask: i64 = 0
    if anchor_mask == 63 { ok_mask = ok_mask + 1 }
    if point_replay_mask == 127 { ok_mask = ok_mask + 2 }
    if final_center_mask == 7 { ok_mask = ok_mask + 4 }
    if center_candidate_mask == 15 { ok_mask = ok_mask + 8 }
    if response_envelope_fp == 496675613 { ok_mask = ok_mask + 16 }
    if dt_q == 42949672 {
        if dt_r == 96 { ok_mask = ok_mask + 32 }
    }
    if local_center_proof_mask == 0 { ok_mask = ok_mask + 64 }
    if global_flowpipe_claim_mask == 0 { ok_mask = ok_mask + 128 }
    if ok_mask != 255 { return 0 - 1 }

    let instance_fp = lorenz_i256_step1_taylor2_center_artifact_instance_fingerprint(
        1, 10, 28, 8, 3, 4294967296, dt_q, dt_r,
        4294967296, 4294967296, 4294967296,
        final_x_i64, final_y_i64, final_z_i64,
        response_envelope_fp, response_envelope_audit_fp,
        point_time_slab_fp, point_time_slab_audit_fp,
        local_flowpipe_seed_fp, local_flowpipe_seed_audit_fp,
        local_center_proof_mask, global_flowpipe_claim_mask)
    let certificate_fp = lorenz_i256_step1_taylor2_center_artifact_certificate_fingerprint(
        instance_fp, dy_scaled_q_i64, dy_scaled_r_i64,
        xy_scaled_q_i64, xy_scaled_r_i64, beta_q_i64, beta_r_i64,
        x_inc_q_i64, x_inc_r_i64, y_inc_q_i64, y_inc_r_i64,
        z_drop_q_i64, z_drop_r_i64, final_x_i64, final_y_i64,
        final_z_i64, point_replay_mask, anchor_mask, final_center_mask,
        center_candidate_mask, local_center_proof_mask,
        global_flowpipe_claim_mask, ok_mask)

    return lorenz_i256_step1_taylor2_center_artifact_fingerprint(
        instance_fp, certificate_fp, response_envelope_fp,
        response_envelope_audit_fp, point_time_slab_fp,
        point_time_slab_audit_fp, local_flowpipe_seed_fp,
        local_flowpipe_seed_audit_fp, 1, 1, final_x_i64, final_y_i64,
        final_z_i64, center_candidate_mask, local_center_proof_mask,
        global_flowpipe_claim_mask, ok_mask)
}

