    if ((2925905872177 as i256) - (1 as i256)) * source_scale >= y_second_a {
        second_derivative_ok = 0
    }
    if (2925905872177 as i256) * source_scale < y_second_a {
        second_derivative_ok = 0
    }
    if ((17981629018 as i256) - (1 as i256)) * source_scale >= y_second_b {
        second_derivative_ok = 0
    }
    if (17981629018 as i256) * source_scale < y_second_b {
