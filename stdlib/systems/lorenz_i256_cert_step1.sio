    var fp: i64 = 1621
    fp = lorenz_i256_cert_mix(fp, local_flowpipe_seed_fp, 5519)
    fp = lorenz_i256_cert_mix(fp, local_flowpipe_seed_audit_fp, 5519)
    fp = lorenz_i256_cert_mix(fp, step_index, 5519)
