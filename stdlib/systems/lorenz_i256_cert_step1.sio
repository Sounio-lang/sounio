pub fn lorenz_i256_step1_taylor2_local_flowpipe_seed_check(
    division_instance_fp: i64,
    step1_certificate_fp: i64,
    two_step_chain_anchor_fp: i64,
    step2_certificate_fp: i64,
    global_flowpipe_claim_mask: i64,
    seed_status: i64) -> i64 with Mod {
    let scale: i256 = 4294967296 as i256
    let dt: i256 = 42949672 as i256
    let x0: i256 = scale
    let y0: i256 = scale
    let z0: i256 = scale
    let dy_scaled_q: i256 = 115964116992 as i256
    let dy_scaled_r: i256 = 0 as i256
    let xy_scaled_q: i256 = scale
    let xy_scaled_r: i256 = 0 as i256
    let beta_q: i256 = 11453246122 as i256
    let beta_r: i256 = 2 as i256
    let x_inc_q: i256 = 0 as i256
    let x_inc_r: i256 = 0 as i256
    let y_inc_q: i256 = 1116691472 as i256
    let y_inc_r: i256 = 0 as i256
    let z_drop_q: i256 = 71582786 as i256
    let z_drop_r: i256 = 2834678416 as i256

    let dx_num: i256 = (10 as i256) * (y0 - x0)
    let dy_num: i256 = x0 * ((28 as i256) * scale - z0)
    let xy_num: i256 = x0 * y0
    let beta_num_z: i256 = (8 as i256) * z0
    let dy: i256 = dy_scaled_q - y0
    let dz_drop_num: i256 = beta_q - xy_scaled_q

    var point_replay_mask: i64 = 0
    if div_witness_check_i256(scale, 100 as i256, dt, 96 as i256) == 1 {
        point_replay_mask = point_replay_mask + 1
    }
    if div_witness_check_i256(dy_num, scale, dy_scaled_q, dy_scaled_r) == 1 {
        point_replay_mask = point_replay_mask + 2
    }
    if div_witness_check_i256(xy_num, scale, xy_scaled_q, xy_scaled_r) == 1 {
        point_replay_mask = point_replay_mask + 4
    }
    if div_witness_check_i256(beta_num_z, 3 as i256, beta_q, beta_r) == 1 {
        point_replay_mask = point_replay_mask + 8
    }
    if div_witness_check_i256(dt * dx_num, scale, x_inc_q, x_inc_r) == 1 {
        point_replay_mask = point_replay_mask + 16
    }
    if div_witness_check_i256(dt * dy, scale, y_inc_q, y_inc_r) == 1 {
        point_replay_mask = point_replay_mask + 32
    }
    if div_witness_check_i256(dt * dz_drop_num, scale, z_drop_q, z_drop_r) == 1 {
        point_replay_mask = point_replay_mask + 64
    }

    var endpoint_mask: i64 = 0
    if x0 + x_inc_q == 4294967296 as i256 { endpoint_mask = endpoint_mask + 1 }
    if y0 + y_inc_q == 5411658768 as i256 { endpoint_mask = endpoint_mask + 2 }
    if z0 - z_drop_q == 4223384510 as i256 { endpoint_mask = endpoint_mask + 4 }

    var trajectory_anchor_mask: i64 = 0
    if division_instance_fp == 660429472 { trajectory_anchor_mask = trajectory_anchor_mask + 1 }
    if step1_certificate_fp == 510854875 { trajectory_anchor_mask = trajectory_anchor_mask + 2 }

    var suffix_anchor_mask: i64 = 0
    if two_step_chain_anchor_fp == 335080767 { suffix_anchor_mask = suffix_anchor_mask + 1 }
    if step2_certificate_fp == 899209716 { suffix_anchor_mask = suffix_anchor_mask + 2 }

    var local_flowpipe_seed_mask: i64 = 0
    if point_replay_mask == 127 { local_flowpipe_seed_mask = local_flowpipe_seed_mask + 1 }
    if endpoint_mask == 7 { local_flowpipe_seed_mask = local_flowpipe_seed_mask + 2 }
    if trajectory_anchor_mask == 3 { local_flowpipe_seed_mask = local_flowpipe_seed_mask + 4 }
    if suffix_anchor_mask == 3 { local_flowpipe_seed_mask = local_flowpipe_seed_mask + 8 }

    let local_flowpipe_proof_mask: i64 = 0

    var non_global_ok: i64 = 1
    if global_flowpipe_claim_mask != 0 { non_global_ok = 0 }
    if seed_status != 22 { non_global_ok = 0 }

    var step_contract_ok: i64 = 1
    if 1 + 1 != 2 { step_contract_ok = 0 }
    if 256 != 256 { step_contract_ok = 0 }
    if 32 != 32 { step_contract_ok = 0 }
    if 1 != 1 { step_contract_ok = 0 }
    if 100 != 100 { step_contract_ok = 0 }

    var dependency_closure_ok: i64 = 1
    if trajectory_anchor_mask != 3 { dependency_closure_ok = 0 }
    if suffix_anchor_mask != 3 { dependency_closure_ok = 0 }
    if local_flowpipe_seed_mask != 15 { dependency_closure_ok = 0 }
    if local_flowpipe_proof_mask != 0 { dependency_closure_ok = 0 }

    var ok_mask: i64 = 0
    if point_replay_mask == 127 { ok_mask = ok_mask + 1 }
    if endpoint_mask == 7 { ok_mask = ok_mask + 2 }
    if trajectory_anchor_mask == 3 { ok_mask = ok_mask + 4 }
    if suffix_anchor_mask == 3 { ok_mask = ok_mask + 8 }
    if local_flowpipe_seed_mask == 15 { ok_mask = ok_mask + 16 }
    if non_global_ok == 1 { ok_mask = ok_mask + 32 }
    if step_contract_ok == 1 { ok_mask = ok_mask + 64 }
    if dependency_closure_ok == 1 { ok_mask = ok_mask + 128 }
    if ok_mask != 255 { return 0 - 1 }

    let instance_fp = lorenz_i256_step1_taylor2_local_flowpipe_seed_instance_fingerprint(
        division_instance_fp, step1_certificate_fp, two_step_chain_anchor_fp,
        step2_certificate_fp, 1, 1, 2, 256, 32, 1, 100,
        4294967296, 4294967296, 4294967296, 4294967296,
        5411658768, 4223384510, 115964116992, 0, 4294967296,
        0, 11453246122, 2, 0, 0, 1116691472, 0, 71582786,
        2834678416, point_replay_mask, endpoint_mask,
        trajectory_anchor_mask, suffix_anchor_mask, local_flowpipe_seed_mask,
        local_flowpipe_proof_mask, global_flowpipe_claim_mask, seed_status)
    let certificate_fp = lorenz_i256_step1_taylor2_local_flowpipe_seed_certificate_fingerprint(
        instance_fp, point_replay_mask, endpoint_mask, trajectory_anchor_mask,
        suffix_anchor_mask, local_flowpipe_seed_mask, local_flowpipe_proof_mask,
        global_flowpipe_claim_mask, seed_status, ok_mask)

    return lorenz_i256_step1_taylor2_local_flowpipe_seed_fingerprint(
        instance_fp, certificate_fp, 18, 1, point_replay_mask,
        local_flowpipe_seed_mask, local_flowpipe_proof_mask,
        global_flowpipe_claim_mask, seed_status, ok_mask)
}

