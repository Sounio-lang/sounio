//! stdlib/systems/lorenz_i256_child2_discharge_preflight.sio
//!
//! Child-2 discharge preflight for the Lorenz i256 cover lane.
//! This is a blocker ledger after local validation, not a discharge receipt.

pub fn lorenz_i256_cover_child2_discharge_preflight_check(
    child2_validation_core_fp: i64,
    child2_validation_core_audit_fp: i64,
    child1_discharge_preflight_fp: i64,
    child1_discharge_preflight_audit_fp: i64,
    child_index: i64,
    child_validated_mask: i64,
    global_flowpipe_claim_mask: i64,
    discharge_status: i64) -> i64 with Mod {
    var validation_anchor_mask: i64 = 0
    if child2_validation_core_fp == 173471211 {
        if child2_validation_core_audit_fp == 173431050 {
            validation_anchor_mask = validation_anchor_mask + 1
        }
    }
    if child_index == 2 { validation_anchor_mask = validation_anchor_mask + 2 }
    if child_validated_mask == 7 { validation_anchor_mask = validation_anchor_mask + 4 }
    if discharge_status == 67 { validation_anchor_mask = validation_anchor_mask + 8 }

    var inherited_anchor_mask: i64 = 0
    if child1_discharge_preflight_fp == 719480263 {
        if child1_discharge_preflight_audit_fp == 602184970 {
            inherited_anchor_mask = inherited_anchor_mask + 1
        }
    }
    if child_index == 2 { inherited_anchor_mask = inherited_anchor_mask + 2 }
    if child_validated_mask == 7 { inherited_anchor_mask = inherited_anchor_mask + 4 }
    if discharge_status == 67 { inherited_anchor_mask = inherited_anchor_mask + 8 }

    let pending_child_validation_mask: i64 = 24
    let remaining_child_validation_mask: i64 = 24
    let child_validation_dependency_mask: i64 = 63
    let child2_validation_receipt_mask: i64 = 31
    let child2_discharge_preflight_mask: i64 = 4
    let discharge_blocker_mask: i64 = 15
    let missing_child_validation_mask: i64 = 24
    let pending_child_discharge_mask: i64 = 255
    let child_discharge_mask: i64 = 0
    let global_cover_certificate_mask: i64 = 0
    let finite_cover_certificate_mask: i64 = 0

    var blocker_ok: i64 = 1
    if pending_child_validation_mask != 24 { blocker_ok = 0 }
    if remaining_child_validation_mask != 24 { blocker_ok = 0 }
    if child_validation_dependency_mask != 63 { blocker_ok = 0 }
    if child2_validation_receipt_mask != 31 { blocker_ok = 0 }
    if child2_discharge_preflight_mask != 4 { blocker_ok = 0 }
    if discharge_blocker_mask != 15 { blocker_ok = 0 }
    if missing_child_validation_mask != 24 { blocker_ok = 0 }
    if pending_child_discharge_mask != 255 { blocker_ok = 0 }

    var nonclaim_ok: i64 = 1
    if child_discharge_mask != 0 { nonclaim_ok = 0 }
    if global_cover_certificate_mask != 0 { nonclaim_ok = 0 }
    if finite_cover_certificate_mask != 0 { nonclaim_ok = 0 }
    if global_flowpipe_claim_mask != 0 { nonclaim_ok = 0 }

    var ok_mask: i64 = 0
    if validation_anchor_mask == 15 { ok_mask = ok_mask + 1 }
    if inherited_anchor_mask == 15 { ok_mask = ok_mask + 2 }
    if blocker_ok == 1 { ok_mask = ok_mask + 4 }
    if nonclaim_ok == 1 { ok_mask = ok_mask + 8 }
    if child2_discharge_preflight_mask == 4 { ok_mask = ok_mask + 16 }
    if child_validated_mask == 7 { ok_mask = ok_mask + 32 }
    if pending_child_validation_mask == 24 { ok_mask = ok_mask + 64 }
    if discharge_status == 67 { ok_mask = ok_mask + 128 }

    if ok_mask != 255 { return 0 - 1 }
    return 865117026
}

pub fn lorenz_i256_cover_child2_discharge_preflight_audit_fingerprint(
    artifact_fp: i64,
    instance_fp: i64,
    certificate_fp: i64,
    child2_validation_core_fp: i64,
    child2_validation_core_audit_fp: i64,
    child1_discharge_preflight_fp: i64,
    child1_discharge_preflight_audit_fp: i64,
    child_index: i64,
    child_validated_mask: i64,
    pending_child_validation_mask: i64,
    remaining_child_validation_mask: i64,
    child_validation_dependency_mask: i64,
    child2_validation_receipt_mask: i64,
    child2_discharge_preflight_mask: i64,
    discharge_blocker_mask: i64,
    missing_child_validation_mask: i64,
    pending_child_discharge_mask: i64,
    child_discharge_mask: i64,
    global_cover_certificate_mask: i64,
    finite_cover_certificate_mask: i64,
    global_flowpipe_claim_mask: i64,
    discharge_status: i64,
    ok_mask: i64) -> i64 with Mod {
    if artifact_fp != 865117026 { return 0 - 1 }
    if instance_fp != 362446006 { return 0 - 1 }
    if certificate_fp != 449775673 { return 0 - 1 }
    if child2_validation_core_fp != 173471211 { return 0 - 1 }
    if child2_validation_core_audit_fp != 173431050 { return 0 - 1 }
    if child1_discharge_preflight_fp != 719480263 { return 0 - 1 }
    if child1_discharge_preflight_audit_fp != 602184970 { return 0 - 1 }
    if child_index != 2 { return 0 - 1 }
    if child_validated_mask != 7 { return 0 - 1 }
    if pending_child_validation_mask != 24 { return 0 - 1 }
    if remaining_child_validation_mask != 24 { return 0 - 1 }
    if child_validation_dependency_mask != 63 { return 0 - 1 }
    if child2_validation_receipt_mask != 31 { return 0 - 1 }
    if child2_discharge_preflight_mask != 4 { return 0 - 1 }
    if discharge_blocker_mask != 15 { return 0 - 1 }
    if missing_child_validation_mask != 24 { return 0 - 1 }
    if pending_child_discharge_mask != 255 { return 0 - 1 }
    if child_discharge_mask != 0 { return 0 - 1 }
    if global_cover_certificate_mask != 0 { return 0 - 1 }
    if finite_cover_certificate_mask != 0 { return 0 - 1 }
    if global_flowpipe_claim_mask != 0 { return 0 - 1 }
    if discharge_status != 67 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }
    return 22656757
}
