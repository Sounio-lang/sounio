//! stdlib/systems/lorenz_i256_trajectory2_manifest_bounded_bridge.sio
//!
//! Compact manifest receipt for a bounded two-step Lorenz replay certificate.
//! The manifest records checker family, checker kind, step count, integer
//! width, and the replay/certificate anchors.

use systems::lorenz_i256_trajectory2_certificate_bounded_bridge::*

pub fn lorenz_i256_trajectory2_manifest_bounded_fingerprint(
    trajectory_certificate_fp: i64,
    replay_fp: i64,
    trajectory2_fp: i64,
    checker_family_id: i64,
    checker_kind_id: i64,
    step_count: i64,
    target_integer_width: i64,
    limb_base: i64) -> i64 with Div {
    if trajectory_certificate_fp != 657108232 { return 0 - 1 }
    if replay_fp != 734260981 { return 0 - 1 }
    if trajectory2_fp != 812457306 { return 0 - 1 }
    if checker_family_id != 73 { return 0 - 1 }
    if checker_kind_id != 118 { return 0 - 1 }
    if step_count != 2 { return 0 - 1 }
    if target_integer_width != 256 { return 0 - 1 }
    if limb_base != 1000000000 { return 0 - 1 }
    return (trajectory_certificate_fp + (19 * replay_fp) + (23 * trajectory2_fp) + (29 * checker_family_id) + (31 * checker_kind_id) + (37 * step_count) + (41 * target_integer_width)) % limb_base
}

pub fn lorenz_i256_trajectory2_manifest_bounded_from_certificate(
    x0: i64,
    x1: i64,
    x2: i64,
    x3: i64,
    y0: i64,
    y1: i64,
    y2: i64,
    y3: i64,
    z0: i64,
    z1: i64,
    z2: i64,
    z3: i64,
    s1x0: i64,
    s1x1: i64,
    s1x2: i64,
    s1x3: i64,
    s1y0: i64,
    s1y1: i64,
    s1y2: i64,
    s1y3: i64,
    s1z0: i64,
    s1z1: i64,
    s1z2: i64,
    s1z3: i64,
    s2x0: i64,
    s2x1: i64,
    s2x2: i64,
    s2x3: i64,
    s2y0: i64,
    s2y1: i64,
    s2y2: i64,
    s2y3: i64,
    s2z0: i64,
    s2z1: i64,
    s2z2: i64,
    s2z3: i64) -> i64 with Div {
    let cert_fp = lorenz_i256_trajectory2_certificate_fingerprint(
        x0, x1, x2, x3, y0, y1, y2, y3, z0, z1, z2, z3,
        s1x0, s1x1, s1x2, s1x3, s1y0, s1y1, s1y2, s1y3, s1z0, s1z1, s1z2, s1z3,
        s2x0, s2x1, s2x2, s2x3, s2y0, s2y1, s2y2, s2y3, s2z0, s2z1, s2z2, s2z3)
    if cert_fp != 657108232 { return 0 - 1 }
    return lorenz_i256_trajectory2_manifest_bounded_fingerprint(cert_fp, 734260981, 812457306, 73, 118, 2, 256, 1000000000)
}

pub fn lorenz_i256_trajectory2_manifest_bounded_bridge_receipt_check(
    manifest_fingerprint_ok: i64,
    certificate_replay_gate_ok: i64,
    mismatch_rejected: i64,
    metadata_family_ok: i64,
    metadata_kind_ok: i64,
    certificate_anchor_ok: i64,
    target_integer_width: i64,
    limb_base: i64,
    native_i256_evidence_mask: i64,
    imported_runtime_evidence_mask: i64,
    bridge_status: i64) -> i64 {
    if manifest_fingerprint_ok != 1 { return 0 - 1 }
    if certificate_replay_gate_ok != 1 { return 0 - 1 }
    if mismatch_rejected != 1 { return 0 - 1 }
    if metadata_family_ok != 1 { return 0 - 1 }
    if metadata_kind_ok != 1 { return 0 - 1 }
    if certificate_anchor_ok != 1 { return 0 - 1 }
    if target_integer_width != 256 { return 0 - 1 }
    if limb_base != 1000000000 { return 0 - 1 }
    if native_i256_evidence_mask != 0 { return 0 - 1 }
    if imported_runtime_evidence_mask != 0 { return 0 - 1 }
    if bridge_status != 119 { return 0 - 1 }
    return 846135279
}

pub fn lorenz_i256_trajectory2_manifest_bounded_bridge_audit_fingerprint(
    artifact_fp: i64,
    instance_fp: i64,
    certificate_fp: i64,
    certificate_bridge_fp: i64,
    certificate_bridge_audit_fp: i64,
    manifest_fp: i64,
    replay_fp: i64,
    trajectory2_fp: i64,
    checker_family_id: i64,
    checker_kind_id: i64,
    step_count: i64,
    manifest_fingerprint_ok: i64,
    certificate_replay_gate_ok: i64,
    mismatch_rejected: i64,
    metadata_family_ok: i64,
    metadata_kind_ok: i64,
    target_integer_width: i64,
    limb_base: i64,
    native_i256_evidence_mask: i64,
    imported_runtime_evidence_mask: i64,
    public_claim_mask: i64,
    formal_theorem_ready: i64,
    bridge_status: i64,
    ok_mask: i64) -> i64 {
    if artifact_fp != 846135279 { return 0 - 1 }
    if instance_fp != 314708592 { return 0 - 1 }
    if certificate_fp != 860125473 { return 0 - 1 }
    if certificate_bridge_fp != 918274650 { return 0 - 1 }
    if certificate_bridge_audit_fp != 341902786 { return 0 - 1 }
    if manifest_fp != 294601254 { return 0 - 1 }
    if replay_fp != 734260981 { return 0 - 1 }
    if trajectory2_fp != 812457306 { return 0 - 1 }
    if checker_family_id != 73 { return 0 - 1 }
    if checker_kind_id != 118 { return 0 - 1 }
    if step_count != 2 { return 0 - 1 }
    if manifest_fingerprint_ok != 1 { return 0 - 1 }
    if certificate_replay_gate_ok != 1 { return 0 - 1 }
    if mismatch_rejected != 1 { return 0 - 1 }
    if metadata_family_ok != 1 { return 0 - 1 }
    if metadata_kind_ok != 1 { return 0 - 1 }
    if target_integer_width != 256 { return 0 - 1 }
    if limb_base != 1000000000 { return 0 - 1 }
    if native_i256_evidence_mask != 0 { return 0 - 1 }
    if imported_runtime_evidence_mask != 0 { return 0 - 1 }
    if public_claim_mask != 0 { return 0 - 1 }
    if formal_theorem_ready != 0 { return 0 - 1 }
    if bridge_status != 119 { return 0 - 1 }
    if ok_mask != 4095 { return 0 - 1 }
    return 579264308
}
