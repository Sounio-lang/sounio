//! stdlib/systems/lorenz_i256_trajectory2_replay_bounded_bridge.sio
//!
//! Portable replay verifier for a bounded two-step Lorenz trajectory over
//! decimal i256-like limbs. The checker accepts supplied state limbs only when
//! both component-wise dt=1 xyz-step transitions replay exactly.

use systems::lorenz_i256_xyz_step_bounded_bridge::*
use systems::lorenz_i256_trajectory2_bounded_bridge::*

pub fn lorenz_i256_trajectory2_replay_step_match(
    x0: i64,
    x1: i64,
    x2: i64,
    x3: i64,
    y0: i64,
    y1: i64,
    y2: i64,
    y3: i64,
    z0: i64,
    z1: i64,
    z2: i64,
    z3: i64,
    nx0: i64,
    nx1: i64,
    nx2: i64,
    nx3: i64,
    ny0: i64,
    ny1: i64,
    ny2: i64,
    ny3: i64,
    nz0: i64,
    nz1: i64,
    nz2: i64,
    nz3: i64) -> i64 with Div {
    let rx0 = lorenz_i256_xyz_step_bounded_limb(x0, x1, x2, x3, y0, y1, y2, y3, z0, z1, z2, z3, 0, 0)
    let rx1 = lorenz_i256_xyz_step_bounded_limb(x0, x1, x2, x3, y0, y1, y2, y3, z0, z1, z2, z3, 0, 1)
    let rx2 = lorenz_i256_xyz_step_bounded_limb(x0, x1, x2, x3, y0, y1, y2, y3, z0, z1, z2, z3, 0, 2)
    let rx3 = lorenz_i256_xyz_step_bounded_limb(x0, x1, x2, x3, y0, y1, y2, y3, z0, z1, z2, z3, 0, 3)
    let ry0 = lorenz_i256_xyz_step_bounded_limb(x0, x1, x2, x3, y0, y1, y2, y3, z0, z1, z2, z3, 1, 0)
    let ry1 = lorenz_i256_xyz_step_bounded_limb(x0, x1, x2, x3, y0, y1, y2, y3, z0, z1, z2, z3, 1, 1)
    let ry2 = lorenz_i256_xyz_step_bounded_limb(x0, x1, x2, x3, y0, y1, y2, y3, z0, z1, z2, z3, 1, 2)
    let ry3 = lorenz_i256_xyz_step_bounded_limb(x0, x1, x2, x3, y0, y1, y2, y3, z0, z1, z2, z3, 1, 3)
    let rz0 = lorenz_i256_xyz_step_bounded_limb(x0, x1, x2, x3, y0, y1, y2, y3, z0, z1, z2, z3, 2, 0)
    let rz1 = lorenz_i256_xyz_step_bounded_limb(x0, x1, x2, x3, y0, y1, y2, y3, z0, z1, z2, z3, 2, 1)
    let rz2 = lorenz_i256_xyz_step_bounded_limb(x0, x1, x2, x3, y0, y1, y2, y3, z0, z1, z2, z3, 2, 2)
    let rz3 = lorenz_i256_xyz_step_bounded_limb(x0, x1, x2, x3, y0, y1, y2, y3, z0, z1, z2, z3, 2, 3)
    if rx0 < 0 { return 0 }
    if rx1 < 0 { return 0 }
    if rx2 < 0 { return 0 }
    if rx3 < 0 { return 0 }
    if ry0 < 0 { return 0 }
    if ry1 < 0 { return 0 }
    if ry2 < 0 { return 0 }
    if ry3 < 0 { return 0 }
    if rz0 < 0 { return 0 }
    if rz1 < 0 { return 0 }
    if rz2 < 0 { return 0 }
    if rz3 < 0 { return 0 }
    if rx0 != nx0 { return 0 }
    if rx1 != nx1 { return 0 }
    if rx2 != nx2 { return 0 }
    if rx3 != nx3 { return 0 }
    if ry0 != ny0 { return 0 }
    if ry1 != ny1 { return 0 }
    if ry2 != ny2 { return 0 }
    if ry3 != ny3 { return 0 }
    if rz0 != nz0 { return 0 }
    if rz1 != nz1 { return 0 }
    if rz2 != nz2 { return 0 }
    if rz3 != nz3 { return 0 }
    return 1
}

pub fn lorenz_i256_trajectory2_replay_bounded_check(
    x0: i64,
    x1: i64,
    x2: i64,
    x3: i64,
    y0: i64,
    y1: i64,
    y2: i64,
    y3: i64,
    z0: i64,
    z1: i64,
    z2: i64,
    z3: i64,
    s1x0: i64,
    s1x1: i64,
    s1x2: i64,
    s1x3: i64,
    s1y0: i64,
    s1y1: i64,
    s1y2: i64,
    s1y3: i64,
    s1z0: i64,
    s1z1: i64,
    s1z2: i64,
    s1z3: i64,
    s2x0: i64,
    s2x1: i64,
    s2x2: i64,
    s2x3: i64,
    s2y0: i64,
    s2y1: i64,
    s2y2: i64,
    s2y3: i64,
    s2z0: i64,
    s2z1: i64,
    s2z2: i64,
    s2z3: i64) -> i64 with Div {
    let step1_ok = lorenz_i256_trajectory2_replay_step_match(
        x0, x1, x2, x3, y0, y1, y2, y3, z0, z1, z2, z3,
        s1x0, s1x1, s1x2, s1x3, s1y0, s1y1, s1y2, s1y3, s1z0, s1z1, s1z2, s1z3)
    if step1_ok != 1 { return 0 }
    let step2_ok = lorenz_i256_trajectory2_replay_step_match(
        s1x0, s1x1, s1x2, s1x3, s1y0, s1y1, s1y2, s1y3, s1z0, s1z1, s1z2, s1z3,
        s2x0, s2x1, s2x2, s2x3, s2y0, s2y1, s2y2, s2y3, s2z0, s2z1, s2z2, s2z3)
    if step2_ok != 1 { return 0 }
    return 1
}

pub fn lorenz_i256_trajectory2_replay_bounded_bridge_receipt_check(
    accepted_replay_ok: i64,
    first_step_mismatch_rejected: i64,
    second_step_mismatch_rejected: i64,
    invalid_step_rejected: i64,
    trajectory2_anchor_ok: i64,
    xyz_step_anchor_ok: i64,
    target_integer_width: i64,
    limb_base: i64,
    native_i256_evidence_mask: i64,
    imported_runtime_evidence_mask: i64,
    bridge_status: i64) -> i64 {
    if accepted_replay_ok != 1 { return 0 - 1 }
    if first_step_mismatch_rejected != 1 { return 0 - 1 }
    if second_step_mismatch_rejected != 1 { return 0 - 1 }
    if invalid_step_rejected != 1 { return 0 - 1 }
    if trajectory2_anchor_ok != 1 { return 0 - 1 }
    if xyz_step_anchor_ok != 1 { return 0 - 1 }
    if target_integer_width != 256 { return 0 - 1 }
    if limb_base != 1000000000 { return 0 - 1 }
    if native_i256_evidence_mask != 0 { return 0 - 1 }
    if imported_runtime_evidence_mask != 0 { return 0 - 1 }
    if bridge_status != 117 { return 0 - 1 }
    return 734260981
}

pub fn lorenz_i256_trajectory2_replay_bounded_bridge_audit_fingerprint(
    artifact_fp: i64,
    instance_fp: i64,
    certificate_fp: i64,
    trajectory2_fp: i64,
    trajectory2_audit_fp: i64,
    xyz_step_fp: i64,
    xyz_step_audit_fp: i64,
    accepted_replay_ok: i64,
    first_step_mismatch_rejected: i64,
    second_step_mismatch_rejected: i64,
    invalid_step_rejected: i64,
    target_integer_width: i64,
    limb_base: i64,
    native_i256_evidence_mask: i64,
    imported_runtime_evidence_mask: i64,
    public_claim_mask: i64,
    formal_theorem_ready: i64,
    bridge_status: i64,
    ok_mask: i64) -> i64 {
    if artifact_fp != 734260981 { return 0 - 1 }
    if instance_fp != 482709136 { return 0 - 1 }
    if certificate_fp != 193840625 { return 0 - 1 }
    if trajectory2_fp != 812457306 { return 0 - 1 }
    if trajectory2_audit_fp != 459028173 { return 0 - 1 }
    if xyz_step_fp != 701846329 { return 0 - 1 }
    if xyz_step_audit_fp != 263917508 { return 0 - 1 }
    if accepted_replay_ok != 1 { return 0 - 1 }
    if first_step_mismatch_rejected != 1 { return 0 - 1 }
    if second_step_mismatch_rejected != 1 { return 0 - 1 }
    if invalid_step_rejected != 1 { return 0 - 1 }
    if target_integer_width != 256 { return 0 - 1 }
    if limb_base != 1000000000 { return 0 - 1 }
    if native_i256_evidence_mask != 0 { return 0 - 1 }
    if imported_runtime_evidence_mask != 0 { return 0 - 1 }
    if public_claim_mask != 0 { return 0 - 1 }
    if formal_theorem_ready != 0 { return 0 - 1 }
    if bridge_status != 117 { return 0 - 1 }
    if ok_mask != 2047 { return 0 - 1 }
    return 605913274
}
