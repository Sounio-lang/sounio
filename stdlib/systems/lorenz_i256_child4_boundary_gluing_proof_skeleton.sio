//! stdlib/systems/lorenz_i256_child4_boundary_gluing_proof_skeleton.sio
//!
//! Boundary-gluing proof skeleton for child-4 in the Lorenz i256 cover lane.
//! This records the structural skeleton for a future gluing proof but does not
//! verify gluing, discharge, finite-cover certification, or any global claim.

pub fn lorenz_i256_cover_child4_boundary_gluing_proof_skeleton_check(
    child4_boundary_gluing_obligation_seed_fp: i64,
    child4_boundary_gluing_obligation_seed_audit_fp: i64,
    child4_discharge_obligation_bundle_fp: i64,
    child4_discharge_obligation_bundle_audit_fp: i64,
    boundary_gluing_obligation_mask: i64,
    boundary_gluing_pending_mask: i64,
    boundary_gluing_verified_mask: i64,
    boundary_gluing_proof_mask: i64,
    finite_cover_certificate_mask: i64,
    global_certificate_candidate_mask: i64,
    global_flowpipe_claim_mask: i64,
    skeleton_status: i64) -> i64 with Mod {
    var anchor_mask: i64 = 0
    if child4_boundary_gluing_obligation_seed_fp == 604182937 {
        if child4_boundary_gluing_obligation_seed_audit_fp == 218570463 {
            anchor_mask = anchor_mask + 1
        }
    }
    if child4_discharge_obligation_bundle_fp == 741805623 {
        if child4_discharge_obligation_bundle_audit_fp == 529164708 {
            anchor_mask = anchor_mask + 2
        }
    }
    if boundary_gluing_obligation_mask == 31 { anchor_mask = anchor_mask + 4 }
    if boundary_gluing_pending_mask == 31 { anchor_mask = anchor_mask + 8 }
    if skeleton_status == 79 { anchor_mask = anchor_mask + 16 }

    let boundary_face_count: i64 = 5
    let skeleton_slot_mask: i64 = 31
    let skeleton_topology_mask: i64 = 31
    let skeleton_dependency_mask: i64 = 31
    let skeleton_trace_mask: i64 = 31
    let skeleton_verified_mask: i64 = 0
    let solver_skeleton_action_mask: i64 = 31
    let ready_for_boundary_gluing_proof_mask: i64 = 0

    var skeleton_ok: i64 = 1
    if boundary_face_count != 5 { skeleton_ok = 0 }
    if skeleton_slot_mask != 31 { skeleton_ok = 0 }
    if skeleton_topology_mask != 31 { skeleton_ok = 0 }
    if skeleton_dependency_mask != 31 { skeleton_ok = 0 }
    if skeleton_trace_mask != 31 { skeleton_ok = 0 }
    if skeleton_verified_mask != 0 { skeleton_ok = 0 }
    if solver_skeleton_action_mask != 31 { skeleton_ok = 0 }
    if ready_for_boundary_gluing_proof_mask != 0 { skeleton_ok = 0 }

    var nonclaim_ok: i64 = 1
    if boundary_gluing_verified_mask != 0 { nonclaim_ok = 0 }
    if boundary_gluing_proof_mask != 0 { nonclaim_ok = 0 }
    if finite_cover_certificate_mask != 0 { nonclaim_ok = 0 }
    if global_certificate_candidate_mask != 0 { nonclaim_ok = 0 }
    if global_flowpipe_claim_mask != 0 { nonclaim_ok = 0 }

    var ok_mask: i64 = 0
    if anchor_mask == 31 { ok_mask = ok_mask + 1 }
    if skeleton_ok == 1 { ok_mask = ok_mask + 2 }
    if nonclaim_ok == 1 { ok_mask = ok_mask + 4 }
    if boundary_gluing_obligation_mask == 31 { ok_mask = ok_mask + 8 }
    if skeleton_slot_mask == 31 { ok_mask = ok_mask + 16 }
    if skeleton_verified_mask == 0 { ok_mask = ok_mask + 32 }
    if ready_for_boundary_gluing_proof_mask == 0 { ok_mask = ok_mask + 64 }
    if skeleton_status == 79 { ok_mask = ok_mask + 128 }

    if ok_mask != 255 { return 0 - 1 }
    return 836470291
}

pub fn lorenz_i256_cover_child4_boundary_gluing_proof_skeleton_audit_fingerprint(
    artifact_fp: i64,
    instance_fp: i64,
    certificate_fp: i64,
    child4_boundary_gluing_obligation_seed_fp: i64,
    child4_boundary_gluing_obligation_seed_audit_fp: i64,
    child4_discharge_obligation_bundle_fp: i64,
    child4_discharge_obligation_bundle_audit_fp: i64,
    boundary_gluing_obligation_mask: i64,
    boundary_gluing_pending_mask: i64,
    boundary_face_count: i64,
    skeleton_slot_mask: i64,
    skeleton_topology_mask: i64,
    skeleton_dependency_mask: i64,
    skeleton_trace_mask: i64,
    skeleton_verified_mask: i64,
    solver_skeleton_action_mask: i64,
    ready_for_boundary_gluing_proof_mask: i64,
    boundary_gluing_verified_mask: i64,
    boundary_gluing_proof_mask: i64,
    finite_cover_certificate_mask: i64,
    global_certificate_candidate_mask: i64,
    global_flowpipe_claim_mask: i64,
    skeleton_status: i64,
    ok_mask: i64) -> i64 with Mod {
    if artifact_fp != 836470291 { return 0 - 1 }
    if instance_fp != 472619308 { return 0 - 1 }
    if certificate_fp != 619284057 { return 0 - 1 }
    if child4_boundary_gluing_obligation_seed_fp != 604182937 { return 0 - 1 }
    if child4_boundary_gluing_obligation_seed_audit_fp != 218570463 { return 0 - 1 }
    if child4_discharge_obligation_bundle_fp != 741805623 { return 0 - 1 }
    if child4_discharge_obligation_bundle_audit_fp != 529164708 { return 0 - 1 }
    if boundary_gluing_obligation_mask != 31 { return 0 - 1 }
    if boundary_gluing_pending_mask != 31 { return 0 - 1 }
    if boundary_face_count != 5 { return 0 - 1 }
    if skeleton_slot_mask != 31 { return 0 - 1 }
    if skeleton_topology_mask != 31 { return 0 - 1 }
    if skeleton_dependency_mask != 31 { return 0 - 1 }
    if skeleton_trace_mask != 31 { return 0 - 1 }
    if skeleton_verified_mask != 0 { return 0 - 1 }
    if solver_skeleton_action_mask != 31 { return 0 - 1 }
    if ready_for_boundary_gluing_proof_mask != 0 { return 0 - 1 }
    if boundary_gluing_verified_mask != 0 { return 0 - 1 }
    if boundary_gluing_proof_mask != 0 { return 0 - 1 }
    if finite_cover_certificate_mask != 0 { return 0 - 1 }
    if global_certificate_candidate_mask != 0 { return 0 - 1 }
    if global_flowpipe_claim_mask != 0 { return 0 - 1 }
    if skeleton_status != 79 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }
    return 190735846
}
