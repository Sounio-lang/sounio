//! stdlib/systems/lorenz_i256_beta_z_bridge.sio
//!
//! Portable exact beta*z bridge for Lorenz i256 receipts, with beta = 8/3.
//! The bridge multiplies z by 8 and then divides the four-limb decimal value
//! by 3 using exact long division. Non-divisible cases are rejected.

use systems::lorenz_i256_limb_scale_bridge::*

pub fn lorenz_i256_beta_z_limb_base() -> i64 { return 1000000000 }

fn lorenz_beta_limb_ok(x: i64) -> i64 {
    if x < 0 { return 0 }
    if x >= lorenz_i256_beta_z_limb_base() { return 0 }
    return 1
}

fn lorenz_beta_inputs_ok(l0: i64, l1: i64, l2: i64, l3: i64) -> i64 {
    if lorenz_beta_limb_ok(l0) != 1 { return 0 }
    if lorenz_beta_limb_ok(l1) != 1 { return 0 }
    if lorenz_beta_limb_ok(l2) != 1 { return 0 }
    if lorenz_beta_limb_ok(l3) != 1 { return 0 }
    return 1
}

pub fn lorenz_dec4_div3_exact_limb(
    l0: i64,
    l1: i64,
    l2: i64,
    l3: i64,
    limb_index: i64) -> i64 with Div {
    if lorenz_beta_inputs_ok(l0, l1, l2, l3) != 1 { return 0 - 1 }
    let base = lorenz_i256_beta_z_limb_base()

    let q3 = l3 / 3
    let rem3 = l3 % 3

    let v2 = (rem3 * base) + l2
    let q2 = v2 / 3
    let rem2 = v2 % 3

    let v1 = (rem2 * base) + l1
    let q1 = v1 / 3
    let rem1 = v1 % 3

    let v0 = (rem1 * base) + l0
    let q0 = v0 / 3
    let rem0 = v0 % 3

    if rem0 != 0 { return 0 - 1 }
    if limb_index == 0 { return q0 }
    if limb_index == 1 { return q1 }
    if limb_index == 2 { return q2 }
    if limb_index == 3 { return q3 }
    return 0 - 1
}

pub fn lorenz_i256_beta_z_limb(
    z0: i64,
    z1: i64,
    z2: i64,
    z3: i64,
    limb_index: i64) -> i64 with Div {
    let s0 = lorenz_dec4_mul_small_limb(z0, z1, z2, z3, 8, 0)
    let s1 = lorenz_dec4_mul_small_limb(z0, z1, z2, z3, 8, 1)
    let s2 = lorenz_dec4_mul_small_limb(z0, z1, z2, z3, 8, 2)
    let s3 = lorenz_dec4_mul_small_limb(z0, z1, z2, z3, 8, 3)
    if s0 < 0 { return 0 - 1 }
    if s1 < 0 { return 0 - 1 }
    if s2 < 0 { return 0 - 1 }
    if s3 < 0 { return 0 - 1 }
    return lorenz_dec4_div3_exact_limb(s0, s1, s2, s3, limb_index)
}

pub fn lorenz_i256_beta_z_check(
    z0: i64,
    z1: i64,
    z2: i64,
    z3: i64,
    expected_l0: i64,
    expected_l1: i64,
    expected_l2: i64,
    expected_l3: i64) -> i64 with Div {
    let r0 = lorenz_i256_beta_z_limb(z0, z1, z2, z3, 0)
    let r1 = lorenz_i256_beta_z_limb(z0, z1, z2, z3, 1)
    let r2 = lorenz_i256_beta_z_limb(z0, z1, z2, z3, 2)
    let r3 = lorenz_i256_beta_z_limb(z0, z1, z2, z3, 3)
    if r0 != expected_l0 { return 0 }
    if r1 != expected_l1 { return 0 }
    if r2 != expected_l2 { return 0 }
    if r3 != expected_l3 { return 0 }
    return 1
}

pub fn lorenz_i256_beta_z_bridge_receipt_check(
    exact_one_point_five_ok: i64,
    exact_three_eighths_ok: i64,
    exact_two_point_twofive_ok: i64,
    inexact_rejected: i64,
    invalid_limb_rejected: i64,
    scale_anchor_ok: i64,
    target_integer_width: i64,
    limb_base: i64,
    native_i256_evidence_mask: i64,
    imported_runtime_evidence_mask: i64,
    bridge_status: i64) -> i64 {
    if exact_one_point_five_ok != 1 { return 0 - 1 }
    if exact_three_eighths_ok != 1 { return 0 - 1 }
    if exact_two_point_twofive_ok != 1 { return 0 - 1 }
    if inexact_rejected != 1 { return 0 - 1 }
    if invalid_limb_rejected != 1 { return 0 - 1 }
    if scale_anchor_ok != 1 { return 0 - 1 }
    if target_integer_width != 256 { return 0 - 1 }
    if limb_base != 1000000000 { return 0 - 1 }
    if native_i256_evidence_mask != 0 { return 0 - 1 }
    if imported_runtime_evidence_mask != 0 { return 0 - 1 }
    if bridge_status != 112 { return 0 - 1 }
    return 639182704
}

pub fn lorenz_i256_beta_z_bridge_audit_fingerprint(
    artifact_fp: i64,
    instance_fp: i64,
    certificate_fp: i64,
    scale_fp: i64,
    scale_audit_fp: i64,
    exact_one_point_five_ok: i64,
    exact_three_eighths_ok: i64,
    exact_two_point_twofive_ok: i64,
    inexact_rejected: i64,
    invalid_limb_rejected: i64,
    target_integer_width: i64,
    limb_base: i64,
    native_i256_evidence_mask: i64,
    imported_runtime_evidence_mask: i64,
    public_claim_mask: i64,
    formal_theorem_ready: i64,
    bridge_status: i64,
    ok_mask: i64) -> i64 {
    if artifact_fp != 639182704 { return 0 - 1 }
    if instance_fp != 582607319 { return 0 - 1 }
    if certificate_fp != 918340256 { return 0 - 1 }
    if scale_fp != 734815269 { return 0 - 1 }
    if scale_audit_fp != 216903584 { return 0 - 1 }
    if exact_one_point_five_ok != 1 { return 0 - 1 }
    if exact_three_eighths_ok != 1 { return 0 - 1 }
    if exact_two_point_twofive_ok != 1 { return 0 - 1 }
    if inexact_rejected != 1 { return 0 - 1 }
    if invalid_limb_rejected != 1 { return 0 - 1 }
    if target_integer_width != 256 { return 0 - 1 }
    if limb_base != 1000000000 { return 0 - 1 }
    if native_i256_evidence_mask != 0 { return 0 - 1 }
    if imported_runtime_evidence_mask != 0 { return 0 - 1 }
    if public_claim_mask != 0 { return 0 - 1 }
    if formal_theorem_ready != 0 { return 0 - 1 }
    if bridge_status != 112 { return 0 - 1 }
    if ok_mask != 1023 { return 0 - 1 }
    return 174905863
}
