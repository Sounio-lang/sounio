//! stdlib/systems/lib.sio - Dynamical systems
//!
//! Provides numerical integration of classical continuous dynamical systems:
//! Lorenz attractor, Rössler attractor, van der Pol oscillator, pendulum.
//!
//! All integrators use explicit forward Euler with configurable step size.
//! For production use, prefer stdlib/ode for adaptive RK4/RK45.
//!
//! Effects:
//!   Mut   — functions use mutable local state
//!   Div   — functions contain loops (may diverge)
//!   Panic — functions perform division or array indexing
//!
//! References:
//!   - Lorenz (1963): "Deterministic Nonperiodic Flow", J. Atmos. Sci.
//!   - Rössler (1976): "An equation for continuous chaos", Phys. Lett. A
//!   - Van der Pol (1926): "On relaxation-oscillations", Phil. Mag.
//!   - Strogatz (1994): "Nonlinear Dynamics and Chaos"

use math::pure::*

// =============================================================================
// SystemState — generic n-dimensional state vector (n ≤ 16)
// =============================================================================

pub struct SystemState {
    pub x: [f64; 16],
    pub n: i32,
    pub t: f64,
}

// Create a zeroed SystemState with dimension n
pub fn system_state_new(n: i32) -> SystemState with Mut, Panic {
    var s: SystemState
    s.n = n
    s.t = 0.0
    s.x[0] = 0.0
    s.x[1] = 0.0
    s.x[2] = 0.0
    s.x[3] = 0.0
    s.x[4] = 0.0
    s.x[5] = 0.0
    s.x[6] = 0.0
    s.x[7] = 0.0
    s.x[8] = 0.0
    s.x[9] = 0.0
    s.x[10] = 0.0
    s.x[11] = 0.0
    s.x[12] = 0.0
    s.x[13] = 0.0
    s.x[14] = 0.0
    s.x[15] = 0.0
    return s
}

// =============================================================================
// Lorenz attractor
// dx/dt = σ(y - x)
// dy/dt = x(ρ - z) - y
// dz/dt = xy - βz
//
// State layout: x[0]=x, x[1]=y, x[2]=z
// Standard chaotic parameters: σ=10, ρ=28, β=8/3
// =============================================================================

pub fn lorenz_step(state: SystemState, dt: f64, sigma: f64, rho: f64, beta: f64) -> SystemState with Mut, Panic {
    let cx = state.x[0]
    let cy = state.x[1]
    let cz = state.x[2]

    let dx = sigma * (cy - cx)
    let dy = cx * (rho - cz) - cy
    let dz = cx * cy - beta * cz

    var ns: SystemState
    ns.n = state.n
    ns.t = state.t + dt
    ns.x[0] = cx + dt * dx
    ns.x[1] = cy + dt * dy
    ns.x[2] = cz + dt * dz
    ns.x[3] = 0.0
    ns.x[4] = 0.0
    ns.x[5] = 0.0
    ns.x[6] = 0.0
    ns.x[7] = 0.0
    ns.x[8] = 0.0
    ns.x[9] = 0.0
    ns.x[10] = 0.0
    ns.x[11] = 0.0
    ns.x[12] = 0.0
    ns.x[13] = 0.0
    ns.x[14] = 0.0
    ns.x[15] = 0.0
    return ns
}

// Simulate Lorenz attractor from (x0,y0,z0) with default parameters σ=10, ρ=28, β=8/3
// Returns final state after n_steps steps
pub fn lorenz_simulate(x0: f64, y0: f64, z0: f64, dt: f64, n_steps: i32) -> SystemState with Mut, Div, Panic {
    var state = system_state_new(3)
    state.x[0] = x0
    state.x[1] = y0
    state.x[2] = z0

    let sigma = 10.0
    let rho = 28.0
    let beta = 2.6666666666666665

    var i = 0
    while i < n_steps {
        state = lorenz_step(state, dt, sigma, rho, beta)
        i = i + 1
    }
    return state
}

// =============================================================================
// Rössler attractor
// dx/dt = -y - z
// dy/dt = x + ay
// dz/dt = b + z(x - c)
//
// State layout: x[0]=x, x[1]=y, x[2]=z
// Standard chaotic parameters: a=0.2, b=0.2, c=5.7
// =============================================================================

pub fn rossler_step(state: SystemState, dt: f64, a: f64, b: f64, c: f64) -> SystemState with Mut, Panic {
    let cx = state.x[0]
    let cy = state.x[1]
    let cz = state.x[2]

    let dx = (0.0 - cy) - cz
    let dy = cx + a * cy
    let dz = b + cz * (cx - c)

    var ns: SystemState
    ns.n = state.n
    ns.t = state.t + dt
    ns.x[0] = cx + dt * dx
    ns.x[1] = cy + dt * dy
    ns.x[2] = cz + dt * dz
    ns.x[3] = 0.0
    ns.x[4] = 0.0
    ns.x[5] = 0.0
    ns.x[6] = 0.0
    ns.x[7] = 0.0
    ns.x[8] = 0.0
    ns.x[9] = 0.0
    ns.x[10] = 0.0
    ns.x[11] = 0.0
    ns.x[12] = 0.0
    ns.x[13] = 0.0
    ns.x[14] = 0.0
    ns.x[15] = 0.0
    return ns
}

// =============================================================================
// Van der Pol oscillator
// dx/dt = y
// dy/dt = μ(1 - x²)y - x
//
// State layout: x[0]=x (position), x[1]=y (velocity)
// μ>0 gives self-sustained limit cycle oscillations
// =============================================================================

pub fn van_der_pol_step(state: SystemState, dt: f64, mu: f64) -> SystemState with Mut, Panic {
    let cx = state.x[0]
    let cy = state.x[1]

    let dx = cy
    let dy = mu * (1.0 - cx * cx) * cy - cx

    var ns: SystemState
    ns.n = state.n
    ns.t = state.t + dt
    ns.x[0] = cx + dt * dx
    ns.x[1] = cy + dt * dy
    ns.x[2] = 0.0
    ns.x[3] = 0.0
    ns.x[4] = 0.0
    ns.x[5] = 0.0
    ns.x[6] = 0.0
    ns.x[7] = 0.0
    ns.x[8] = 0.0
    ns.x[9] = 0.0
    ns.x[10] = 0.0
    ns.x[11] = 0.0
    ns.x[12] = 0.0
    ns.x[13] = 0.0
    ns.x[14] = 0.0
    ns.x[15] = 0.0
    return ns
}

// =============================================================================
// Simple pendulum
// dθ/dt = ω
// dω/dt = -(g/l) sin(θ)
//
// State layout: x[0]=θ (angle, rad), x[1]=ω (angular velocity, rad/s)
// =============================================================================

pub fn pendulum_step(state: SystemState, dt: f64, g: f64, l: f64) -> SystemState with Mut, Div, Panic {
    let theta = state.x[0]
    let omega = state.x[1]

    let dtheta = omega
    let domega = (0.0 - g) / l * sin(theta)

    var ns: SystemState
    ns.n = state.n
    ns.t = state.t + dt
    ns.x[0] = theta + dt * dtheta
    ns.x[1] = omega + dt * domega
    ns.x[2] = 0.0
    ns.x[3] = 0.0
    ns.x[4] = 0.0
    ns.x[5] = 0.0
    ns.x[6] = 0.0
    ns.x[7] = 0.0
    ns.x[8] = 0.0
    ns.x[9] = 0.0
    ns.x[10] = 0.0
    ns.x[11] = 0.0
    ns.x[12] = 0.0
    ns.x[13] = 0.0
    ns.x[14] = 0.0
    ns.x[15] = 0.0
    return ns
}

// =============================================================================
// Lyapunov exponent estimate
//
// Crude finite-difference estimate of the largest Lyapunov exponent from
// a scalar trajectory stored in states[0..n-1].
// Uses log of mean separation between successive pairs of adjacent points.
//
// Method: approximate λ ≈ (1/T) * Σ log(|x_{i+1} - x_i| / δ₀)
// where δ₀ is the initial separation (first difference).
// Returns a crude estimate suitable for sign-based chaos detection.
//
// Reference: Sprott (2003) "Chaos and Time-Series Analysis" §5.2
// =============================================================================

pub fn lyapunov_estimate(states: &[f64; 256], n: i32, dt: f64) -> f64 with Mut, Div, Panic {
    if n < 4 { return 0.0 }

    // Use the first difference as reference separation
    let d0 = states[1] - states[0]
    let abs_d0 = if d0 < 0.0 { 0.0 - d0 } else { d0 }
    if abs_d0 < 1.0e-15 { return 0.0 }

    var sum = 0.0
    var count = 0
    var i = 1
    while i < n - 1 {
        let d = states[i + 1] - states[i]
        let abs_d = if d < 0.0 { 0.0 - d } else { d }
        if abs_d > 1.0e-15 {
            let ratio = abs_d / abs_d0
            if ratio > 0.0 {
                sum = sum + ln(ratio)
                count = count + 1
            }
        }
        i = i + 1
    }

    if count == 0 { return 0.0 }

    let total_time = dt * count
    if total_time < 1.0e-15 { return 0.0 }

    return sum / total_time
}
