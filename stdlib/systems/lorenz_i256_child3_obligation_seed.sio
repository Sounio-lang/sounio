//! stdlib/systems/lorenz_i256_child3_obligation_seed.sio
//!
//! Child-3 obligation seed for the Lorenz i256 cover lane.
//! This selects the next child cell after the child-2 discharge preflight. It is
//! an obligation seed only, not child-3 validation or discharge.

pub fn lorenz_i256_cover_child3_obligation_seed_check(
    child2_discharge_preflight_fp: i64,
    child2_discharge_preflight_audit_fp: i64,
    child2_validation_core_fp: i64,
    child2_validation_core_audit_fp: i64,
    child_index: i64,
    slot_x: i64,
    slot_y: i64,
    slot_z: i64,
    global_flowpipe_claim_mask: i64,
    seed_status: i64) -> i64 with Mod {
    var inherited_anchor_mask: i64 = 0
    if child2_discharge_preflight_fp == 865117026 {
        if child2_discharge_preflight_audit_fp == 22656757 {
            inherited_anchor_mask = inherited_anchor_mask + 1
        }
    }
    if child2_validation_core_fp == 173471211 {
        if child2_validation_core_audit_fp == 173431050 {
            inherited_anchor_mask = inherited_anchor_mask + 2
        }
    }
    if child_index == 3 { inherited_anchor_mask = inherited_anchor_mask + 4 }
    if seed_status == 68 { inherited_anchor_mask = inherited_anchor_mask + 8 }

    let split_axis_count: i64 = 3
    let split_factor_per_axis: i64 = 2
    let child_cell_count: i64 = 8
    let selected_child_count: i64 = 1
    let pending_child_obligation_count: i64 = 8
    let resolved_child_count: i64 = 0
    let selected_child_mask: i64 = 8
    let child_coordinate_mask: i64 = 7
    let prior_child_validated_mask: i64 = 7
    let pending_child_validation_mask: i64 = 24
    let local_flowpipe_proof_mask: i64 = 0
    let child_validated_mask: i64 = 0
    let child_discharge_mask: i64 = 0
    let global_cover_certificate_mask: i64 = 0

    var child_shape_ok: i64 = 1
    if slot_x != 1 { child_shape_ok = 0 }
    if slot_y != 1 { child_shape_ok = 0 }
    if slot_z != 0 { child_shape_ok = 0 }
    if split_axis_count != 3 { child_shape_ok = 0 }
    if split_factor_per_axis != 2 { child_shape_ok = 0 }
    if child_cell_count != 8 { child_shape_ok = 0 }
    if selected_child_count != 1 { child_shape_ok = 0 }
    if pending_child_obligation_count != 8 { child_shape_ok = 0 }
    if resolved_child_count != 0 { child_shape_ok = 0 }
    if selected_child_mask != 8 { child_shape_ok = 0 }
    if child_coordinate_mask != 7 { child_shape_ok = 0 }

    var inherited_ok: i64 = 1
    if inherited_anchor_mask != 15 { inherited_ok = 0 }
    if prior_child_validated_mask != 7 { inherited_ok = 0 }
    if pending_child_validation_mask != 24 { inherited_ok = 0 }

    var nonclaim_ok: i64 = 1
    if local_flowpipe_proof_mask != 0 { nonclaim_ok = 0 }
    if child_validated_mask != 0 { nonclaim_ok = 0 }
    if child_discharge_mask != 0 { nonclaim_ok = 0 }
    if global_cover_certificate_mask != 0 { nonclaim_ok = 0 }
    if global_flowpipe_claim_mask != 0 { nonclaim_ok = 0 }

    var ok_mask: i64 = 0
    if child_shape_ok == 1 { ok_mask = ok_mask + 1 }
    if inherited_ok == 1 { ok_mask = ok_mask + 2 }
    if nonclaim_ok == 1 { ok_mask = ok_mask + 4 }
    if child_index == 3 { ok_mask = ok_mask + 8 }
    if selected_child_mask == 8 { ok_mask = ok_mask + 16 }
    if prior_child_validated_mask == 7 { ok_mask = ok_mask + 32 }
    if pending_child_validation_mask == 24 { ok_mask = ok_mask + 64 }
    if seed_status == 68 { ok_mask = ok_mask + 128 }

    if ok_mask != 255 { return 0 - 1 }
    return 853502997
}

pub fn lorenz_i256_cover_child3_obligation_seed_audit_fingerprint(
    artifact_fp: i64,
    instance_fp: i64,
    certificate_fp: i64,
    child2_discharge_preflight_fp: i64,
    child2_discharge_preflight_audit_fp: i64,
    child2_validation_core_fp: i64,
    child2_validation_core_audit_fp: i64,
    child_index: i64,
    slot_x: i64,
    slot_y: i64,
    slot_z: i64,
    selected_child_mask: i64,
    prior_child_validated_mask: i64,
    pending_child_validation_mask: i64,
    local_flowpipe_proof_mask: i64,
    child_validated_mask: i64,
    child_discharge_mask: i64,
    global_cover_certificate_mask: i64,
    global_flowpipe_claim_mask: i64,
    seed_status: i64,
    ok_mask: i64) -> i64 with Mod {
    if artifact_fp != 853502997 { return 0 - 1 }
    if instance_fp != 669599681 { return 0 - 1 }
    if certificate_fp != 307153093 { return 0 - 1 }
    if child2_discharge_preflight_fp != 865117026 { return 0 - 1 }
    if child2_discharge_preflight_audit_fp != 22656757 { return 0 - 1 }
    if child2_validation_core_fp != 173471211 { return 0 - 1 }
    if child2_validation_core_audit_fp != 173431050 { return 0 - 1 }
    if child_index != 3 { return 0 - 1 }
    if slot_x != 1 { return 0 - 1 }
    if slot_y != 1 { return 0 - 1 }
    if slot_z != 0 { return 0 - 1 }
    if selected_child_mask != 8 { return 0 - 1 }
    if prior_child_validated_mask != 7 { return 0 - 1 }
    if pending_child_validation_mask != 24 { return 0 - 1 }
    if local_flowpipe_proof_mask != 0 { return 0 - 1 }
    if child_validated_mask != 0 { return 0 - 1 }
    if child_discharge_mask != 0 { return 0 - 1 }
    if global_cover_certificate_mask != 0 { return 0 - 1 }
    if global_flowpipe_claim_mask != 0 { return 0 - 1 }
    if seed_status != 68 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }
    return 176202003
}
