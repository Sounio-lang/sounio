//! stdlib/systems/lorenz_i256_scaled_product_bridge.sio
//!
//! Portable bounded fixed-scale product bridge for Lorenz i256 receipts. This
//! multiplies two nonnegative two-limb decimal values and rescales by the limb
//! base, opening the arithmetic path toward the Lorenz x*z product term.

pub fn lorenz_i256_product_limb_base() -> i64 { return 1000000000 }

fn lorenz_product_limb_ok(x: i64) -> i64 {
    if x < 0 { return 0 }
    if x >= lorenz_i256_product_limb_base() { return 0 }
    return 1
}

fn lorenz_product_inputs_ok(
    a0: i64,
    a1: i64,
    a2: i64,
    a3: i64,
    b0: i64,
    b1: i64,
    b2: i64,
    b3: i64) -> i64 {
    if lorenz_product_limb_ok(a0) != 1 { return 0 }
    if lorenz_product_limb_ok(a1) != 1 { return 0 }
    if lorenz_product_limb_ok(a2) != 1 { return 0 }
    if lorenz_product_limb_ok(a3) != 1 { return 0 }
    if lorenz_product_limb_ok(b0) != 1 { return 0 }
    if lorenz_product_limb_ok(b1) != 1 { return 0 }
    if lorenz_product_limb_ok(b2) != 1 { return 0 }
    if lorenz_product_limb_ok(b3) != 1 { return 0 }
    if a2 != 0 { return 0 }
    if a3 != 0 { return 0 }
    if b2 != 0 { return 0 }
    if b3 != 0 { return 0 }
    return 1
}

pub fn lorenz_dec2_scaled_product_limb(
    a0: i64,
    a1: i64,
    a2: i64,
    a3: i64,
    b0: i64,
    b1: i64,
    b2: i64,
    b3: i64,
    limb_index: i64) -> i64 with Div {
    if lorenz_product_inputs_ok(a0, a1, a2, a3, b0, b1, b2, b3) != 1 { return 0 - 1 }
    let base = lorenz_i256_product_limb_base()

    let c0 = a0 * b0
    let rem0 = c0 % base
    if rem0 != 0 { return 0 - 1 }
    let q0 = c0 / base

    let c1_left = a0 * b1
    let c1_right = a1 * b0
    let c1 = c1_left + c1_right

    let tmp0 = q0 + c1
    let r0 = tmp0 % base
    let carry0 = tmp0 / base

    let c2 = a1 * b1
    let tmp1 = c2 + carry0
    let r1 = tmp1 % base
    let carry1 = tmp1 / base

    let r2 = carry1 % base
    let r3 = carry1 / base
    if r3 >= base { return 0 - 1 }

    if limb_index == 0 { return r0 }
    if limb_index == 1 { return r1 }
    if limb_index == 2 { return r2 }
    if limb_index == 3 { return r3 }
    return 0 - 1
}

pub fn lorenz_i256_scaled_product_check(
    a0: i64,
    a1: i64,
    a2: i64,
    a3: i64,
    b0: i64,
    b1: i64,
    b2: i64,
    b3: i64,
    expected_l0: i64,
    expected_l1: i64,
    expected_l2: i64,
    expected_l3: i64) -> i64 with Div {
    let r0 = lorenz_dec2_scaled_product_limb(a0, a1, a2, a3, b0, b1, b2, b3, 0)
    let r1 = lorenz_dec2_scaled_product_limb(a0, a1, a2, a3, b0, b1, b2, b3, 1)
    let r2 = lorenz_dec2_scaled_product_limb(a0, a1, a2, a3, b0, b1, b2, b3, 2)
    let r3 = lorenz_dec2_scaled_product_limb(a0, a1, a2, a3, b0, b1, b2, b3, 3)
    if r0 != expected_l0 { return 0 }
    if r1 != expected_l1 { return 0 }
    if r2 != expected_l2 { return 0 }
    if r3 != expected_l3 { return 0 }
    return 1
}

pub fn lorenz_i256_scaled_product_bridge_receipt_check(
    low_product_ok: i64,
    mixed_product_ok: i64,
    carry_product_ok: i64,
    inexact_product_rejected: i64,
    upper_limb_rejected: i64,
    target_integer_width: i64,
    limb_base: i64,
    native_i256_evidence_mask: i64,
    imported_runtime_evidence_mask: i64,
    bridge_status: i64) -> i64 {
    if low_product_ok != 1 { return 0 - 1 }
    if mixed_product_ok != 1 { return 0 - 1 }
    if carry_product_ok != 1 { return 0 - 1 }
    if inexact_product_rejected != 1 { return 0 - 1 }
    if upper_limb_rejected != 1 { return 0 - 1 }
    if target_integer_width != 256 { return 0 - 1 }
    if limb_base != 1000000000 { return 0 - 1 }
    if native_i256_evidence_mask != 0 { return 0 - 1 }
    if imported_runtime_evidence_mask != 0 { return 0 - 1 }
    if bridge_status != 109 { return 0 - 1 }
    return 920174638
}

pub fn lorenz_i256_scaled_product_bridge_audit_fingerprint(
    artifact_fp: i64,
    instance_fp: i64,
    certificate_fp: i64,
    low_product_ok: i64,
    mixed_product_ok: i64,
    carry_product_ok: i64,
    inexact_product_rejected: i64,
    upper_limb_rejected: i64,
    target_integer_width: i64,
    limb_base: i64,
    native_i256_evidence_mask: i64,
    imported_runtime_evidence_mask: i64,
    public_claim_mask: i64,
    formal_theorem_ready: i64,
    bridge_status: i64,
    ok_mask: i64) -> i64 {
    if artifact_fp != 920174638 { return 0 - 1 }
    if instance_fp != 703918426 { return 0 - 1 }
    if certificate_fp != 268540197 { return 0 - 1 }
    if low_product_ok != 1 { return 0 - 1 }
    if mixed_product_ok != 1 { return 0 - 1 }
    if carry_product_ok != 1 { return 0 - 1 }
    if inexact_product_rejected != 1 { return 0 - 1 }
    if upper_limb_rejected != 1 { return 0 - 1 }
    if target_integer_width != 256 { return 0 - 1 }
    if limb_base != 1000000000 { return 0 - 1 }
    if native_i256_evidence_mask != 0 { return 0 - 1 }
    if imported_runtime_evidence_mask != 0 { return 0 - 1 }
    if public_claim_mask != 0 { return 0 - 1 }
    if formal_theorem_ready != 0 { return 0 - 1 }
    if bridge_status != 109 { return 0 - 1 }
    if ok_mask != 1023 { return 0 - 1 }
    return 481036275
}
