//! stdlib/systems/lorenz_i256_child4_boundary_face_preflight_bundle.sio
//!
//! Bundle receipt for the five child-4 boundary-face preflights in the Lorenz
//! i256 cover lane. This records that all face-local preflight surfaces exist,
//! but it does not verify any face, prove boundary gluing, discharge child-4, or
//! certify any finite-cover/global flowpipe claim.

pub fn lorenz_i256_cover_child4_boundary_face_preflight_bundle_check(
    child4_boundary_face4_preflight_fp: i64,
    child4_boundary_face4_preflight_audit_fp: i64,
    child4_boundary_face_obligations_fp: i64,
    child4_boundary_face_obligations_audit_fp: i64,
    boundary_gluing_obligation_mask: i64,
    face_obligation_mask: i64,
    face_preflight_progress_mask: i64,
    face_verified_mask: i64,
    face_proof_mask: i64,
    boundary_gluing_verified_mask: i64,
    boundary_gluing_proof_mask: i64,
    finite_cover_certificate_mask: i64,
    global_certificate_candidate_mask: i64,
    global_flowpipe_claim_mask: i64,
    bundle_status: i64) -> i64 with Mod {
    var anchor_mask: i64 = 0
    if child4_boundary_face4_preflight_fp == 486720951 {
        if child4_boundary_face4_preflight_audit_fp == 730519284 {
            anchor_mask = anchor_mask + 1
        }
    }
    if child4_boundary_face_obligations_fp == 458306927 {
        if child4_boundary_face_obligations_audit_fp == 766184391 {
            anchor_mask = anchor_mask + 2
        }
    }
    if boundary_gluing_obligation_mask == 31 { anchor_mask = anchor_mask + 4 }
    if face_obligation_mask == 31 { anchor_mask = anchor_mask + 8 }
    if bundle_status == 86 { anchor_mask = anchor_mask + 16 }

    let boundary_face_count: i64 = 5
    let face_preflight_bundle_mask: i64 = 31
    let face_preflight_dependency_mask: i64 = 31
    let face_preflight_trace_mask: i64 = 31
    let face_preflight_ready_mask: i64 = 31
    let face_pending_proof_mask: i64 = 31
    let solver_boundary_next_action_mask: i64 = 31
    let ready_for_boundary_gluing_proof_mask: i64 = 0

    var bundle_ok: i64 = 1
    if boundary_face_count != 5 { bundle_ok = 0 }
    if face_preflight_bundle_mask != 31 { bundle_ok = 0 }
    if face_preflight_dependency_mask != 31 { bundle_ok = 0 }
    if face_preflight_trace_mask != 31 { bundle_ok = 0 }
    if face_preflight_ready_mask != 31 { bundle_ok = 0 }
    if face_pending_proof_mask != 31 { bundle_ok = 0 }
    if solver_boundary_next_action_mask != 31 { bundle_ok = 0 }
    if ready_for_boundary_gluing_proof_mask != 0 { bundle_ok = 0 }

    var nonclaim_ok: i64 = 1
    if face_preflight_progress_mask != 31 { nonclaim_ok = 0 }
    if face_verified_mask != 0 { nonclaim_ok = 0 }
    if face_proof_mask != 0 { nonclaim_ok = 0 }
    if boundary_gluing_verified_mask != 0 { nonclaim_ok = 0 }
    if boundary_gluing_proof_mask != 0 { nonclaim_ok = 0 }
    if finite_cover_certificate_mask != 0 { nonclaim_ok = 0 }
    if global_certificate_candidate_mask != 0 { nonclaim_ok = 0 }
    if global_flowpipe_claim_mask != 0 { nonclaim_ok = 0 }

    var ok_mask: i64 = 0
    if anchor_mask == 31 { ok_mask = ok_mask + 1 }
    if bundle_ok == 1 { ok_mask = ok_mask + 2 }
    if nonclaim_ok == 1 { ok_mask = ok_mask + 4 }
    if boundary_gluing_obligation_mask == 31 { ok_mask = ok_mask + 8 }
    if face_preflight_bundle_mask == 31 { ok_mask = ok_mask + 16 }
    if face_pending_proof_mask == 31 { ok_mask = ok_mask + 32 }
    if ready_for_boundary_gluing_proof_mask == 0 { ok_mask = ok_mask + 64 }
    if bundle_status == 86 { ok_mask = ok_mask + 128 }

    if ok_mask != 255 { return 0 - 1 }
    return 812640573
}

pub fn lorenz_i256_cover_child4_boundary_face_preflight_bundle_audit_fingerprint(
    artifact_fp: i64,
    instance_fp: i64,
    certificate_fp: i64,
    child4_boundary_face4_preflight_fp: i64,
    child4_boundary_face4_preflight_audit_fp: i64,
    child4_boundary_face_obligations_fp: i64,
    child4_boundary_face_obligations_audit_fp: i64,
    boundary_gluing_obligation_mask: i64,
    face_obligation_mask: i64,
    boundary_face_count: i64,
    face_preflight_progress_mask: i64,
    face_preflight_bundle_mask: i64,
    face_preflight_dependency_mask: i64,
    face_preflight_trace_mask: i64,
    face_preflight_ready_mask: i64,
    face_pending_proof_mask: i64,
    solver_boundary_next_action_mask: i64,
    ready_for_boundary_gluing_proof_mask: i64,
    face_verified_mask: i64,
    face_proof_mask: i64,
    boundary_gluing_verified_mask: i64,
    boundary_gluing_proof_mask: i64,
    finite_cover_certificate_mask: i64,
    global_certificate_candidate_mask: i64,
    global_flowpipe_claim_mask: i64,
    bundle_status: i64,
    ok_mask: i64) -> i64 with Mod {
    if artifact_fp != 812640573 { return 0 - 1 }
    if instance_fp != 673205948 { return 0 - 1 }
    if certificate_fp != 138729456 { return 0 - 1 }
    if child4_boundary_face4_preflight_fp != 486720951 { return 0 - 1 }
    if child4_boundary_face4_preflight_audit_fp != 730519284 { return 0 - 1 }
    if child4_boundary_face_obligations_fp != 458306927 { return 0 - 1 }
    if child4_boundary_face_obligations_audit_fp != 766184391 { return 0 - 1 }
    if boundary_gluing_obligation_mask != 31 { return 0 - 1 }
    if face_obligation_mask != 31 { return 0 - 1 }
    if boundary_face_count != 5 { return 0 - 1 }
    if face_preflight_progress_mask != 31 { return 0 - 1 }
    if face_preflight_bundle_mask != 31 { return 0 - 1 }
    if face_preflight_dependency_mask != 31 { return 0 - 1 }
    if face_preflight_trace_mask != 31 { return 0 - 1 }
    if face_preflight_ready_mask != 31 { return 0 - 1 }
    if face_pending_proof_mask != 31 { return 0 - 1 }
    if solver_boundary_next_action_mask != 31 { return 0 - 1 }
    if ready_for_boundary_gluing_proof_mask != 0 { return 0 - 1 }
    if face_verified_mask != 0 { return 0 - 1 }
    if face_proof_mask != 0 { return 0 - 1 }
    if boundary_gluing_verified_mask != 0 { return 0 - 1 }
    if boundary_gluing_proof_mask != 0 { return 0 - 1 }
    if finite_cover_certificate_mask != 0 { return 0 - 1 }
    if global_certificate_candidate_mask != 0 { return 0 - 1 }
    if global_flowpipe_claim_mask != 0 { return 0 - 1 }
    if bundle_status != 86 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }
    return 294736811
}
