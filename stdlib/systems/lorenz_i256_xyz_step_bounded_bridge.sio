//! stdlib/systems/lorenz_i256_xyz_step_bounded_bridge.sio
//!
//! Portable bounded Lorenz xyz-step receipt over decimal i256-like limbs. This
//! composes the bounded dt=1 x, y, and z step bridges from one shared input
//! state. It is not a scientific integrator or a global flowpipe proof.

use systems::lorenz_i256_x_step_bridge::*
use systems::lorenz_i256_y_step_bounded_bridge::*
use systems::lorenz_i256_z_step_bounded_bridge::*

pub fn lorenz_i256_xyz_step_bounded_limb(
    x0: i64,
    x1: i64,
    x2: i64,
    x3: i64,
    y0: i64,
    y1: i64,
    y2: i64,
    y3: i64,
    z0: i64,
    z1: i64,
    z2: i64,
    z3: i64,
    axis_index: i64,
    limb_index: i64) -> i64 with Div {
    if axis_index == 0 {
        return lorenz_i256_x_step_limb(x0, x1, x2, x3, y0, y1, y2, y3, limb_index)
    }
    if axis_index == 1 {
        return lorenz_i256_y_step_bounded_limb(x0, x1, x2, x3, y0, y1, y2, y3, z0, z1, z2, z3, limb_index)
    }
    if axis_index == 2 {
        return lorenz_i256_z_step_bounded_limb(x0, x1, x2, x3, y0, y1, y2, y3, z0, z1, z2, z3, limb_index)
    }
    return 0 - 1
}

pub fn lorenz_i256_xyz_step_bounded_check(
    x0: i64,
    x1: i64,
    x2: i64,
    x3: i64,
    y0: i64,
    y1: i64,
    y2: i64,
    y3: i64,
    z0: i64,
    z1: i64,
    z2: i64,
    z3: i64,
    expected_x0: i64,
    expected_x1: i64,
    expected_x2: i64,
    expected_x3: i64,
    expected_y0: i64,
    expected_y1: i64,
    expected_y2: i64,
    expected_y3: i64,
    expected_z0: i64,
    expected_z1: i64,
    expected_z2: i64,
    expected_z3: i64) -> i64 with Div {
    let rx0 = lorenz_i256_xyz_step_bounded_limb(x0, x1, x2, x3, y0, y1, y2, y3, z0, z1, z2, z3, 0, 0)
    let rx1 = lorenz_i256_xyz_step_bounded_limb(x0, x1, x2, x3, y0, y1, y2, y3, z0, z1, z2, z3, 0, 1)
    let rx2 = lorenz_i256_xyz_step_bounded_limb(x0, x1, x2, x3, y0, y1, y2, y3, z0, z1, z2, z3, 0, 2)
    let rx3 = lorenz_i256_xyz_step_bounded_limb(x0, x1, x2, x3, y0, y1, y2, y3, z0, z1, z2, z3, 0, 3)
    let ry0 = lorenz_i256_xyz_step_bounded_limb(x0, x1, x2, x3, y0, y1, y2, y3, z0, z1, z2, z3, 1, 0)
    let ry1 = lorenz_i256_xyz_step_bounded_limb(x0, x1, x2, x3, y0, y1, y2, y3, z0, z1, z2, z3, 1, 1)
    let ry2 = lorenz_i256_xyz_step_bounded_limb(x0, x1, x2, x3, y0, y1, y2, y3, z0, z1, z2, z3, 1, 2)
    let ry3 = lorenz_i256_xyz_step_bounded_limb(x0, x1, x2, x3, y0, y1, y2, y3, z0, z1, z2, z3, 1, 3)
    let rz0 = lorenz_i256_xyz_step_bounded_limb(x0, x1, x2, x3, y0, y1, y2, y3, z0, z1, z2, z3, 2, 0)
    let rz1 = lorenz_i256_xyz_step_bounded_limb(x0, x1, x2, x3, y0, y1, y2, y3, z0, z1, z2, z3, 2, 1)
    let rz2 = lorenz_i256_xyz_step_bounded_limb(x0, x1, x2, x3, y0, y1, y2, y3, z0, z1, z2, z3, 2, 2)
    let rz3 = lorenz_i256_xyz_step_bounded_limb(x0, x1, x2, x3, y0, y1, y2, y3, z0, z1, z2, z3, 2, 3)
    if rx0 != expected_x0 { return 0 }
    if rx1 != expected_x1 { return 0 }
    if rx2 != expected_x2 { return 0 }
    if rx3 != expected_x3 { return 0 }
    if ry0 != expected_y0 { return 0 }
    if ry1 != expected_y1 { return 0 }
    if ry2 != expected_y2 { return 0 }
    if ry3 != expected_y3 { return 0 }
    if rz0 != expected_z0 { return 0 }
    if rz1 != expected_z1 { return 0 }
    if rz2 != expected_z2 { return 0 }
    if rz3 != expected_z3 { return 0 }
    return 1
}

pub fn lorenz_i256_xyz_step_bounded_bridge_receipt_check(
    vector_step_ok: i64,
    x_rejection_ok: i64,
    y_rejection_ok: i64,
    z_rejection_ok: i64,
    x_step_anchor_ok: i64,
    y_step_anchor_ok: i64,
    z_step_anchor_ok: i64,
    target_integer_width: i64,
    limb_base: i64,
    native_i256_evidence_mask: i64,
    imported_runtime_evidence_mask: i64,
    bridge_status: i64) -> i64 {
    if vector_step_ok != 1 { return 0 - 1 }
    if x_rejection_ok != 1 { return 0 - 1 }
    if y_rejection_ok != 1 { return 0 - 1 }
    if z_rejection_ok != 1 { return 0 - 1 }
    if x_step_anchor_ok != 1 { return 0 - 1 }
    if y_step_anchor_ok != 1 { return 0 - 1 }
    if z_step_anchor_ok != 1 { return 0 - 1 }
    if target_integer_width != 256 { return 0 - 1 }
    if limb_base != 1000000000 { return 0 - 1 }
    if native_i256_evidence_mask != 0 { return 0 - 1 }
    if imported_runtime_evidence_mask != 0 { return 0 - 1 }
    if bridge_status != 115 { return 0 - 1 }
    return 701846329
}

pub fn lorenz_i256_xyz_step_bounded_bridge_audit_fingerprint(
    artifact_fp: i64,
    instance_fp: i64,
    certificate_fp: i64,
    x_step_fp: i64,
    x_step_audit_fp: i64,
    y_step_fp: i64,
    y_step_audit_fp: i64,
    z_step_fp: i64,
    z_step_audit_fp: i64,
    vector_step_ok: i64,
    x_rejection_ok: i64,
    y_rejection_ok: i64,
    z_rejection_ok: i64,
    target_integer_width: i64,
    limb_base: i64,
    native_i256_evidence_mask: i64,
    imported_runtime_evidence_mask: i64,
    public_claim_mask: i64,
    formal_theorem_ready: i64,
    bridge_status: i64,
    ok_mask: i64) -> i64 {
    if artifact_fp != 701846329 { return 0 - 1 }
    if instance_fp != 538104672 { return 0 - 1 }
    if certificate_fp != 916470253 { return 0 - 1 }
    if x_step_fp != 645218970 { return 0 - 1 }
    if x_step_audit_fp != 184760392 { return 0 - 1 }
    if y_step_fp != 286140975 { return 0 - 1 }
    if y_step_audit_fp != 653928410 { return 0 - 1 }
    if z_step_fp != 902461738 { return 0 - 1 }
    if z_step_audit_fp != 317604925 { return 0 - 1 }
    if vector_step_ok != 1 { return 0 - 1 }
    if x_rejection_ok != 1 { return 0 - 1 }
    if y_rejection_ok != 1 { return 0 - 1 }
    if z_rejection_ok != 1 { return 0 - 1 }
    if target_integer_width != 256 { return 0 - 1 }
    if limb_base != 1000000000 { return 0 - 1 }
    if native_i256_evidence_mask != 0 { return 0 - 1 }
    if imported_runtime_evidence_mask != 0 { return 0 - 1 }
    if public_claim_mask != 0 { return 0 - 1 }
    if formal_theorem_ready != 0 { return 0 - 1 }
    if bridge_status != 115 { return 0 - 1 }
    if ok_mask != 2047 { return 0 - 1 }
    return 263917508
}
