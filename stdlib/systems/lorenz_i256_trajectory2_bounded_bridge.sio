//! stdlib/systems/lorenz_i256_trajectory2_bounded_bridge.sio
//!
//! Portable bounded two-step Lorenz trajectory receipt over decimal i256-like
//! limbs. This composes the bounded xyz-step bridge twice for exact toy states.
//! It is not a scientific integrator, stability theorem, or flowpipe proof.

use systems::lorenz_i256_xyz_step_bounded_bridge::*

pub fn lorenz_i256_trajectory2_bounded_limb(
    x0: i64,
    x1: i64,
    x2: i64,
    x3: i64,
    y0: i64,
    y1: i64,
    y2: i64,
    y3: i64,
    z0: i64,
    z1: i64,
    z2: i64,
    z3: i64,
    step_index: i64,
    axis_index: i64,
    limb_index: i64) -> i64 with Div {
    if step_index == 0 {
        if axis_index == 0 {
            if limb_index == 0 { return x0 }
            if limb_index == 1 { return x1 }
            if limb_index == 2 { return x2 }
            if limb_index == 3 { return x3 }
            return 0 - 1
        }
        if axis_index == 1 {
            if limb_index == 0 { return y0 }
            if limb_index == 1 { return y1 }
            if limb_index == 2 { return y2 }
            if limb_index == 3 { return y3 }
            return 0 - 1
        }
        if axis_index == 2 {
            if limb_index == 0 { return z0 }
            if limb_index == 1 { return z1 }
            if limb_index == 2 { return z2 }
            if limb_index == 3 { return z3 }
            return 0 - 1
        }
        return 0 - 1
    }

    let sx0 = lorenz_i256_xyz_step_bounded_limb(x0, x1, x2, x3, y0, y1, y2, y3, z0, z1, z2, z3, 0, 0)
    let sx1 = lorenz_i256_xyz_step_bounded_limb(x0, x1, x2, x3, y0, y1, y2, y3, z0, z1, z2, z3, 0, 1)
    let sx2 = lorenz_i256_xyz_step_bounded_limb(x0, x1, x2, x3, y0, y1, y2, y3, z0, z1, z2, z3, 0, 2)
    let sx3 = lorenz_i256_xyz_step_bounded_limb(x0, x1, x2, x3, y0, y1, y2, y3, z0, z1, z2, z3, 0, 3)
    let sy0 = lorenz_i256_xyz_step_bounded_limb(x0, x1, x2, x3, y0, y1, y2, y3, z0, z1, z2, z3, 1, 0)
    let sy1 = lorenz_i256_xyz_step_bounded_limb(x0, x1, x2, x3, y0, y1, y2, y3, z0, z1, z2, z3, 1, 1)
    let sy2 = lorenz_i256_xyz_step_bounded_limb(x0, x1, x2, x3, y0, y1, y2, y3, z0, z1, z2, z3, 1, 2)
    let sy3 = lorenz_i256_xyz_step_bounded_limb(x0, x1, x2, x3, y0, y1, y2, y3, z0, z1, z2, z3, 1, 3)
    let sz0 = lorenz_i256_xyz_step_bounded_limb(x0, x1, x2, x3, y0, y1, y2, y3, z0, z1, z2, z3, 2, 0)
    let sz1 = lorenz_i256_xyz_step_bounded_limb(x0, x1, x2, x3, y0, y1, y2, y3, z0, z1, z2, z3, 2, 1)
    let sz2 = lorenz_i256_xyz_step_bounded_limb(x0, x1, x2, x3, y0, y1, y2, y3, z0, z1, z2, z3, 2, 2)
    let sz3 = lorenz_i256_xyz_step_bounded_limb(x0, x1, x2, x3, y0, y1, y2, y3, z0, z1, z2, z3, 2, 3)
    if sx0 < 0 { return 0 - 1 }
    if sx1 < 0 { return 0 - 1 }
    if sx2 < 0 { return 0 - 1 }
    if sx3 < 0 { return 0 - 1 }
    if sy0 < 0 { return 0 - 1 }
    if sy1 < 0 { return 0 - 1 }
    if sy2 < 0 { return 0 - 1 }
    if sy3 < 0 { return 0 - 1 }
    if sz0 < 0 { return 0 - 1 }
    if sz1 < 0 { return 0 - 1 }
    if sz2 < 0 { return 0 - 1 }
    if sz3 < 0 { return 0 - 1 }

    if step_index == 1 {
        return lorenz_i256_trajectory2_bounded_limb(sx0, sx1, sx2, sx3, sy0, sy1, sy2, sy3, sz0, sz1, sz2, sz3, 0, axis_index, limb_index)
    }
    if step_index == 2 {
        return lorenz_i256_xyz_step_bounded_limb(sx0, sx1, sx2, sx3, sy0, sy1, sy2, sy3, sz0, sz1, sz2, sz3, axis_index, limb_index)
    }
    return 0 - 1
}

pub fn lorenz_i256_trajectory2_bounded_check(
    x0: i64,
    x1: i64,
    x2: i64,
    x3: i64,
    y0: i64,
    y1: i64,
    y2: i64,
    y3: i64,
    z0: i64,
    z1: i64,
    z2: i64,
    z3: i64,
    step2_x0: i64,
    step2_x1: i64,
    step2_x2: i64,
    step2_x3: i64,
    step2_y0: i64,
    step2_y1: i64,
    step2_y2: i64,
    step2_y3: i64,
    step2_z0: i64,
    step2_z1: i64,
    step2_z2: i64,
    step2_z3: i64) -> i64 with Div {
    let rx0 = lorenz_i256_trajectory2_bounded_limb(x0, x1, x2, x3, y0, y1, y2, y3, z0, z1, z2, z3, 2, 0, 0)
    let rx1 = lorenz_i256_trajectory2_bounded_limb(x0, x1, x2, x3, y0, y1, y2, y3, z0, z1, z2, z3, 2, 0, 1)
    let rx2 = lorenz_i256_trajectory2_bounded_limb(x0, x1, x2, x3, y0, y1, y2, y3, z0, z1, z2, z3, 2, 0, 2)
    let rx3 = lorenz_i256_trajectory2_bounded_limb(x0, x1, x2, x3, y0, y1, y2, y3, z0, z1, z2, z3, 2, 0, 3)
    let ry0 = lorenz_i256_trajectory2_bounded_limb(x0, x1, x2, x3, y0, y1, y2, y3, z0, z1, z2, z3, 2, 1, 0)
    let ry1 = lorenz_i256_trajectory2_bounded_limb(x0, x1, x2, x3, y0, y1, y2, y3, z0, z1, z2, z3, 2, 1, 1)
    let ry2 = lorenz_i256_trajectory2_bounded_limb(x0, x1, x2, x3, y0, y1, y2, y3, z0, z1, z2, z3, 2, 1, 2)
    let ry3 = lorenz_i256_trajectory2_bounded_limb(x0, x1, x2, x3, y0, y1, y2, y3, z0, z1, z2, z3, 2, 1, 3)
    let rz0 = lorenz_i256_trajectory2_bounded_limb(x0, x1, x2, x3, y0, y1, y2, y3, z0, z1, z2, z3, 2, 2, 0)
    let rz1 = lorenz_i256_trajectory2_bounded_limb(x0, x1, x2, x3, y0, y1, y2, y3, z0, z1, z2, z3, 2, 2, 1)
    let rz2 = lorenz_i256_trajectory2_bounded_limb(x0, x1, x2, x3, y0, y1, y2, y3, z0, z1, z2, z3, 2, 2, 2)
    let rz3 = lorenz_i256_trajectory2_bounded_limb(x0, x1, x2, x3, y0, y1, y2, y3, z0, z1, z2, z3, 2, 2, 3)
    if rx0 != step2_x0 { return 0 }
    if rx1 != step2_x1 { return 0 }
    if rx2 != step2_x2 { return 0 }
    if rx3 != step2_x3 { return 0 }
    if ry0 != step2_y0 { return 0 }
    if ry1 != step2_y1 { return 0 }
    if ry2 != step2_y2 { return 0 }
    if ry3 != step2_y3 { return 0 }
    if rz0 != step2_z0 { return 0 }
    if rz1 != step2_z1 { return 0 }
    if rz2 != step2_z2 { return 0 }
    if rz3 != step2_z3 { return 0 }
    return 1
}

pub fn lorenz_i256_trajectory2_bounded_bridge_receipt_check(
    initial_state_ok: i64,
    step1_state_ok: i64,
    step2_state_ok: i64,
    rejection_propagated: i64,
    xyz_step_anchor_ok: i64,
    target_integer_width: i64,
    limb_base: i64,
    native_i256_evidence_mask: i64,
    imported_runtime_evidence_mask: i64,
    bridge_status: i64) -> i64 {
    if initial_state_ok != 1 { return 0 - 1 }
    if step1_state_ok != 1 { return 0 - 1 }
    if step2_state_ok != 1 { return 0 - 1 }
    if rejection_propagated != 1 { return 0 - 1 }
    if xyz_step_anchor_ok != 1 { return 0 - 1 }
    if target_integer_width != 256 { return 0 - 1 }
    if limb_base != 1000000000 { return 0 - 1 }
    if native_i256_evidence_mask != 0 { return 0 - 1 }
    if imported_runtime_evidence_mask != 0 { return 0 - 1 }
    if bridge_status != 116 { return 0 - 1 }
    return 812457306
}

pub fn lorenz_i256_trajectory2_bounded_bridge_audit_fingerprint(
    artifact_fp: i64,
    instance_fp: i64,
    certificate_fp: i64,
    xyz_step_fp: i64,
    xyz_step_audit_fp: i64,
    initial_state_ok: i64,
    step1_state_ok: i64,
    step2_state_ok: i64,
    rejection_propagated: i64,
    target_integer_width: i64,
    limb_base: i64,
    native_i256_evidence_mask: i64,
    imported_runtime_evidence_mask: i64,
    public_claim_mask: i64,
    formal_theorem_ready: i64,
    bridge_status: i64,
    ok_mask: i64) -> i64 {
    if artifact_fp != 812457306 { return 0 - 1 }
    if instance_fp != 690314528 { return 0 - 1 }
    if certificate_fp != 237861904 { return 0 - 1 }
    if xyz_step_fp != 701846329 { return 0 - 1 }
    if xyz_step_audit_fp != 263917508 { return 0 - 1 }
    if initial_state_ok != 1 { return 0 - 1 }
    if step1_state_ok != 1 { return 0 - 1 }
    if step2_state_ok != 1 { return 0 - 1 }
    if rejection_propagated != 1 { return 0 - 1 }
    if target_integer_width != 256 { return 0 - 1 }
    if limb_base != 1000000000 { return 0 - 1 }
    if native_i256_evidence_mask != 0 { return 0 - 1 }
    if imported_runtime_evidence_mask != 0 { return 0 - 1 }
    if public_claim_mask != 0 { return 0 - 1 }
    if formal_theorem_ready != 0 { return 0 - 1 }
    if bridge_status != 116 { return 0 - 1 }
    if ok_mask != 2047 { return 0 - 1 }
    return 459028173
}
