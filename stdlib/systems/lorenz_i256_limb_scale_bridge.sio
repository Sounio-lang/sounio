//! stdlib/systems/lorenz_i256_limb_scale_bridge.sio
//!
//! Portable decimal-limb scalar multiplication seed for Lorenz i256 receipts.
//! This extends the limb-add bridge toward Lorenz derivative terms such as
//! sigma*(y-x), while native i256 values remain unavailable in executable
//! self-hosted Sounio.

pub fn lorenz_i256_scale_limb_base() -> i64 { return 1000000000 }

fn lorenz_scale_limb_ok(x: i64) -> i64 {
    if x < 0 { return 0 }
    if x >= lorenz_i256_scale_limb_base() { return 0 }
    return 1
}

fn lorenz_scale_inputs_ok(l0: i64, l1: i64, l2: i64, l3: i64, scale: i64) -> i64 {
    if scale < 0 { return 0 }
    if scale > 1000000 { return 0 }
    if lorenz_scale_limb_ok(l0) != 1 { return 0 }
    if lorenz_scale_limb_ok(l1) != 1 { return 0 }
    if lorenz_scale_limb_ok(l2) != 1 { return 0 }
    if lorenz_scale_limb_ok(l3) != 1 { return 0 }
    return 1
}

pub fn lorenz_dec4_mul_small_limb(
    l0: i64,
    l1: i64,
    l2: i64,
    l3: i64,
    scale: i64,
    limb_index: i64) -> i64 with Div {
    if lorenz_scale_inputs_ok(l0, l1, l2, l3, scale) != 1 { return 0 - 1 }
    let base = lorenz_i256_scale_limb_base()

    let p0 = l0 * scale
    let r0 = p0 % base
    let c0 = p0 / base

    let p1 = (l1 * scale) + c0
    let r1 = p1 % base
    let c1 = p1 / base

    let p2 = (l2 * scale) + c1
    let r2 = p2 % base
    let c2 = p2 / base

    let p3 = (l3 * scale) + c2
    let r3 = p3 % base
    let c3 = p3 / base

    if c3 != 0 { return 0 - 1 }
    if limb_index == 0 { return r0 }
    if limb_index == 1 { return r1 }
    if limb_index == 2 { return r2 }
    if limb_index == 3 { return r3 }
    return 0 - 1
}

pub fn lorenz_i256_limb_scale_check(
    l0: i64,
    l1: i64,
    l2: i64,
    l3: i64,
    scale: i64,
    expected_l0: i64,
    expected_l1: i64,
    expected_l2: i64,
    expected_l3: i64) -> i64 with Div {
    let r0 = lorenz_dec4_mul_small_limb(l0, l1, l2, l3, scale, 0)
    let r1 = lorenz_dec4_mul_small_limb(l0, l1, l2, l3, scale, 1)
    let r2 = lorenz_dec4_mul_small_limb(l0, l1, l2, l3, scale, 2)
    let r3 = lorenz_dec4_mul_small_limb(l0, l1, l2, l3, scale, 3)
    if r0 != expected_l0 { return 0 }
    if r1 != expected_l1 { return 0 }
    if r2 != expected_l2 { return 0 }
    if r3 != expected_l3 { return 0 }
    return 1
}

pub fn lorenz_i256_sigma_delta10_check(
    delta_l0: i64,
    delta_l1: i64,
    delta_l2: i64,
    delta_l3: i64,
    expected_l0: i64,
    expected_l1: i64,
    expected_l2: i64,
    expected_l3: i64) -> i64 with Div {
    return lorenz_i256_limb_scale_check(
        delta_l0, delta_l1, delta_l2, delta_l3, 10,
        expected_l0, expected_l1, expected_l2, expected_l3)
}

pub fn lorenz_i256_limb_scale_bridge_receipt_check(
    scale_200m_by_10_ok: i64,
    scale_1150m_by_10_ok: i64,
    wrong_scale_rejected: i64,
    invalid_scale_rejected: i64,
    invalid_limb_rejected: i64,
    target_integer_width: i64,
    limb_base: i64,
    native_i256_evidence_mask: i64,
    imported_runtime_evidence_mask: i64,
    bridge_status: i64) -> i64 {
    if scale_200m_by_10_ok != 1 { return 0 - 1 }
    if scale_1150m_by_10_ok != 1 { return 0 - 1 }
    if wrong_scale_rejected != 1 { return 0 - 1 }
    if invalid_scale_rejected != 1 { return 0 - 1 }
    if invalid_limb_rejected != 1 { return 0 - 1 }
    if target_integer_width != 256 { return 0 - 1 }
    if limb_base != 1000000000 { return 0 - 1 }
    if native_i256_evidence_mask != 0 { return 0 - 1 }
    if imported_runtime_evidence_mask != 0 { return 0 - 1 }
    if bridge_status != 103 { return 0 - 1 }
    return 734815269
}

pub fn lorenz_i256_limb_scale_bridge_audit_fingerprint(
    artifact_fp: i64,
    instance_fp: i64,
    certificate_fp: i64,
    scale_200m_by_10_ok: i64,
    scale_1150m_by_10_ok: i64,
    wrong_scale_rejected: i64,
    invalid_scale_rejected: i64,
    invalid_limb_rejected: i64,
    target_integer_width: i64,
    limb_base: i64,
    native_i256_evidence_mask: i64,
    imported_runtime_evidence_mask: i64,
    public_claim_mask: i64,
    formal_theorem_ready: i64,
    bridge_status: i64,
    ok_mask: i64) -> i64 {
    if artifact_fp != 734815269 { return 0 - 1 }
    if instance_fp != 508642719 { return 0 - 1 }
    if certificate_fp != 971304826 { return 0 - 1 }
    if scale_200m_by_10_ok != 1 { return 0 - 1 }
    if scale_1150m_by_10_ok != 1 { return 0 - 1 }
    if wrong_scale_rejected != 1 { return 0 - 1 }
    if invalid_scale_rejected != 1 { return 0 - 1 }
    if invalid_limb_rejected != 1 { return 0 - 1 }
    if target_integer_width != 256 { return 0 - 1 }
    if limb_base != 1000000000 { return 0 - 1 }
    if native_i256_evidence_mask != 0 { return 0 - 1 }
    if imported_runtime_evidence_mask != 0 { return 0 - 1 }
    if public_claim_mask != 0 { return 0 - 1 }
    if formal_theorem_ready != 0 { return 0 - 1 }
    if bridge_status != 103 { return 0 - 1 }
    if ok_mask != 1023 { return 0 - 1 }
    return 216903584
}
