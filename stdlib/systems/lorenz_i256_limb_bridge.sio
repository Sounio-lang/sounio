//! stdlib/systems/lorenz_i256_limb_bridge.sio
//!
//! Portable Lorenz i256 limb bridge. This is a small decimal-limb arithmetic
//! seed for high-precision Lorenz receipts while native i256 values are not yet
//! executable in the current self-hosted compiler.

pub fn lorenz_i256_limb_base() -> i64 { return 1000000000 }

fn lorenz_limb_ok(x: i64) -> i64 {
    if x < 0 { return 0 }
    if x >= lorenz_i256_limb_base() { return 0 }
    return 1
}

fn lorenz_dec4_inputs_ok(
    a0: i64,
    a1: i64,
    a2: i64,
    a3: i64,
    b0: i64,
    b1: i64,
    b2: i64,
    b3: i64) -> i64 {
    if lorenz_limb_ok(a0) != 1 { return 0 }
    if lorenz_limb_ok(a1) != 1 { return 0 }
    if lorenz_limb_ok(a2) != 1 { return 0 }
    if lorenz_limb_ok(a3) != 1 { return 0 }
    if lorenz_limb_ok(b0) != 1 { return 0 }
    if lorenz_limb_ok(b1) != 1 { return 0 }
    if lorenz_limb_ok(b2) != 1 { return 0 }
    if lorenz_limb_ok(b3) != 1 { return 0 }
    return 1
}

pub fn lorenz_dec4_add_limb(
    a0: i64,
    a1: i64,
    a2: i64,
    a3: i64,
    b0: i64,
    b1: i64,
    b2: i64,
    b3: i64,
    limb_index: i64) -> i64 with Div {
    if lorenz_dec4_inputs_ok(a0, a1, a2, a3, b0, b1, b2, b3) != 1 { return 0 - 1 }
    let base = lorenz_i256_limb_base()

    let s0 = a0 + b0
    let r0 = s0 % base
    let c0 = s0 / base

    let s1 = a1 + b1 + c0
    let r1 = s1 % base
    let c1 = s1 / base

    let s2 = a2 + b2 + c1
    let r2 = s2 % base
    let c2 = s2 / base

    let s3 = a3 + b3 + c2
    let r3 = s3 % base
    let c3 = s3 / base

    if c3 != 0 { return 0 - 1 }
    if limb_index == 0 { return r0 }
    if limb_index == 1 { return r1 }
    if limb_index == 2 { return r2 }
    if limb_index == 3 { return r3 }
    return 0 - 1
}

pub fn lorenz_i256_limb_increment_check(
    x0_l0: i64,
    x0_l1: i64,
    x0_l2: i64,
    x0_l3: i64,
    dx_l0: i64,
    dx_l1: i64,
    dx_l2: i64,
    dx_l3: i64,
    expected_l0: i64,
    expected_l1: i64,
    expected_l2: i64,
    expected_l3: i64) -> i64 with Div {
    let r0 = lorenz_dec4_add_limb(x0_l0, x0_l1, x0_l2, x0_l3, dx_l0, dx_l1, dx_l2, dx_l3, 0)
    let r1 = lorenz_dec4_add_limb(x0_l0, x0_l1, x0_l2, x0_l3, dx_l0, dx_l1, dx_l2, dx_l3, 1)
    let r2 = lorenz_dec4_add_limb(x0_l0, x0_l1, x0_l2, x0_l3, dx_l0, dx_l1, dx_l2, dx_l3, 2)
    let r3 = lorenz_dec4_add_limb(x0_l0, x0_l1, x0_l2, x0_l3, dx_l0, dx_l1, dx_l2, dx_l3, 3)
    if r0 != expected_l0 { return 0 }
    if r1 != expected_l1 { return 0 }
    if r2 != expected_l2 { return 0 }
    if r3 != expected_l3 { return 0 }
    return 1
}

pub fn lorenz_i256_limb_bridge_receipt_check(
    carry_add_ok: i64,
    lorenz_increment_ok: i64,
    wrong_increment_rejected: i64,
    invalid_limb_rejected: i64,
    target_integer_width: i64,
    limb_base: i64,
    native_i256_evidence_mask: i64,
    imported_runtime_evidence_mask: i64,
    public_claim_mask: i64,
    bridge_status: i64) -> i64 {
    if carry_add_ok != 1 { return 0 - 1 }
    if lorenz_increment_ok != 1 { return 0 - 1 }
    if wrong_increment_rejected != 1 { return 0 - 1 }
    if invalid_limb_rejected != 1 { return 0 - 1 }
    if target_integer_width != 256 { return 0 - 1 }
    if limb_base != 1000000000 { return 0 - 1 }
    if native_i256_evidence_mask != 0 { return 0 - 1 }
    if imported_runtime_evidence_mask != 0 { return 0 - 1 }
    if public_claim_mask != 0 { return 0 - 1 }
    if bridge_status != 102 { return 0 - 1 }
    return 681429570
}

pub fn lorenz_i256_limb_bridge_audit_fingerprint(
    artifact_fp: i64,
    instance_fp: i64,
    certificate_fp: i64,
    carry_add_ok: i64,
    lorenz_increment_ok: i64,
    wrong_increment_rejected: i64,
    invalid_limb_rejected: i64,
    target_integer_width: i64,
    limb_base: i64,
    native_i256_evidence_mask: i64,
    imported_runtime_evidence_mask: i64,
    public_claim_mask: i64,
    formal_theorem_ready: i64,
    bridge_status: i64,
    ok_mask: i64) -> i64 {
    if artifact_fp != 681429570 { return 0 - 1 }
    if instance_fp != 905714263 { return 0 - 1 }
    if certificate_fp != 247816039 { return 0 - 1 }
    if carry_add_ok != 1 { return 0 - 1 }
    if lorenz_increment_ok != 1 { return 0 - 1 }
    if wrong_increment_rejected != 1 { return 0 - 1 }
    if invalid_limb_rejected != 1 { return 0 - 1 }
    if target_integer_width != 256 { return 0 - 1 }
    if limb_base != 1000000000 { return 0 - 1 }
    if native_i256_evidence_mask != 0 { return 0 - 1 }
    if imported_runtime_evidence_mask != 0 { return 0 - 1 }
    if public_claim_mask != 0 { return 0 - 1 }
    if formal_theorem_ready != 0 { return 0 - 1 }
    if bridge_status != 102 { return 0 - 1 }
    if ok_mask != 1023 { return 0 - 1 }
    return 352908746
}
