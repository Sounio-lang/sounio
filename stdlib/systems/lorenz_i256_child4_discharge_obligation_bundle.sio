//! stdlib/systems/lorenz_i256_child4_discharge_obligation_bundle.sio
//!
//! Child-4 discharge-obligation bundle for the Lorenz i256 cover lane.
//! This records the proof obligations that remain after the finite-cover
//! promotion guard; it is not a discharge proof or certificate.

pub fn lorenz_i256_cover_child4_discharge_obligation_bundle_check(
    child4_promotion_guard_fp: i64,
    child4_promotion_guard_audit_fp: i64,
    child4_discharge_preflight_fp: i64,
    child4_discharge_preflight_audit_fp: i64,
    child_validated_mask: i64,
    pending_child_validation_mask: i64,
    pending_child_discharge_mask: i64,
    promotion_allowed_mask: i64,
    finite_cover_candidate_mask: i64,
    global_certificate_candidate_mask: i64,
    global_flowpipe_claim_mask: i64,
    obligation_status: i64) -> i64 with Mod {
    var anchor_mask: i64 = 0
    if child4_promotion_guard_fp == 657240918 {
        if child4_promotion_guard_audit_fp == 312489670 {
            anchor_mask = anchor_mask + 1
        }
    }
    if child4_discharge_preflight_fp == 938615204 {
        if child4_discharge_preflight_audit_fp == 405118337 {
            anchor_mask = anchor_mask + 2
        }
    }
    if child_validated_mask == 31 { anchor_mask = anchor_mask + 4 }
    if pending_child_validation_mask == 0 { anchor_mask = anchor_mask + 8 }
    if obligation_status == 77 { anchor_mask = anchor_mask + 16 }

    let discharge_obligation_mask: i64 = 255
    let required_child_discharge_proof_mask: i64 = 255
    let required_boundary_gluing_mask: i64 = 31
    let required_finite_cover_certificate_mask: i64 = 15
    let required_global_claim_review_mask: i64 = 15
    let missing_discharge_proof_mask: i64 = 255
    let missing_certificate_proof_mask: i64 = 15
    let solver_next_action_mask: i64 = 31
    let ready_for_promotion_mask: i64 = 0

    var obligation_ok: i64 = 1
    if discharge_obligation_mask != 255 { obligation_ok = 0 }
    if required_child_discharge_proof_mask != 255 { obligation_ok = 0 }
    if required_boundary_gluing_mask != 31 { obligation_ok = 0 }
    if required_finite_cover_certificate_mask != 15 { obligation_ok = 0 }
    if required_global_claim_review_mask != 15 { obligation_ok = 0 }
    if missing_discharge_proof_mask != 255 { obligation_ok = 0 }
    if missing_certificate_proof_mask != 15 { obligation_ok = 0 }
    if solver_next_action_mask != 31 { obligation_ok = 0 }
    if ready_for_promotion_mask != 0 { obligation_ok = 0 }

    var nonclaim_ok: i64 = 1
    if pending_child_discharge_mask != 255 { nonclaim_ok = 0 }
    if promotion_allowed_mask != 0 { nonclaim_ok = 0 }
    if finite_cover_candidate_mask != 0 { nonclaim_ok = 0 }
    if global_certificate_candidate_mask != 0 { nonclaim_ok = 0 }
    if global_flowpipe_claim_mask != 0 { nonclaim_ok = 0 }

    var ok_mask: i64 = 0
    if anchor_mask == 31 { ok_mask = ok_mask + 1 }
    if obligation_ok == 1 { ok_mask = ok_mask + 2 }
    if nonclaim_ok == 1 { ok_mask = ok_mask + 4 }
    if child_validated_mask == 31 { ok_mask = ok_mask + 8 }
    if pending_child_validation_mask == 0 { ok_mask = ok_mask + 16 }
    if pending_child_discharge_mask == 255 { ok_mask = ok_mask + 32 }
    if ready_for_promotion_mask == 0 { ok_mask = ok_mask + 64 }
    if obligation_status == 77 { ok_mask = ok_mask + 128 }

    if ok_mask != 255 { return 0 - 1 }
    return 741805623
}

pub fn lorenz_i256_cover_child4_discharge_obligation_bundle_audit_fingerprint(
    artifact_fp: i64,
    instance_fp: i64,
    certificate_fp: i64,
    child4_promotion_guard_fp: i64,
    child4_promotion_guard_audit_fp: i64,
    child4_discharge_preflight_fp: i64,
    child4_discharge_preflight_audit_fp: i64,
    child_validated_mask: i64,
    pending_child_validation_mask: i64,
    pending_child_discharge_mask: i64,
    discharge_obligation_mask: i64,
    required_child_discharge_proof_mask: i64,
    required_boundary_gluing_mask: i64,
    required_finite_cover_certificate_mask: i64,
    required_global_claim_review_mask: i64,
    missing_discharge_proof_mask: i64,
    missing_certificate_proof_mask: i64,
    solver_next_action_mask: i64,
    ready_for_promotion_mask: i64,
    promotion_allowed_mask: i64,
    finite_cover_candidate_mask: i64,
    global_certificate_candidate_mask: i64,
    global_flowpipe_claim_mask: i64,
    obligation_status: i64,
    ok_mask: i64) -> i64 with Mod {
    if artifact_fp != 741805623 { return 0 - 1 }
    if instance_fp != 364918255 { return 0 - 1 }
    if certificate_fp != 971203684 { return 0 - 1 }
    if child4_promotion_guard_fp != 657240918 { return 0 - 1 }
    if child4_promotion_guard_audit_fp != 312489670 { return 0 - 1 }
    if child4_discharge_preflight_fp != 938615204 { return 0 - 1 }
    if child4_discharge_preflight_audit_fp != 405118337 { return 0 - 1 }
    if child_validated_mask != 31 { return 0 - 1 }
    if pending_child_validation_mask != 0 { return 0 - 1 }
    if pending_child_discharge_mask != 255 { return 0 - 1 }
    if discharge_obligation_mask != 255 { return 0 - 1 }
    if required_child_discharge_proof_mask != 255 { return 0 - 1 }
    if required_boundary_gluing_mask != 31 { return 0 - 1 }
    if required_finite_cover_certificate_mask != 15 { return 0 - 1 }
    if required_global_claim_review_mask != 15 { return 0 - 1 }
    if missing_discharge_proof_mask != 255 { return 0 - 1 }
    if missing_certificate_proof_mask != 15 { return 0 - 1 }
    if solver_next_action_mask != 31 { return 0 - 1 }
    if ready_for_promotion_mask != 0 { return 0 - 1 }
    if promotion_allowed_mask != 0 { return 0 - 1 }
    if finite_cover_candidate_mask != 0 { return 0 - 1 }
    if global_certificate_candidate_mask != 0 { return 0 - 1 }
    if global_flowpipe_claim_mask != 0 { return 0 - 1 }
    if obligation_status != 77 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }
    return 529164708
}
