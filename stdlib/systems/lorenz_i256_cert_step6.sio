pub fn lorenz_i256_step6_taylor2_time_slab_containment_check(
    local_containment_obligation_fp: i64,
    local_containment_obligation_audit_fp: i64,
    taylor2_link_preflight_fp: i64,
    taylor2_link_preflight_audit_fp: i64,
    remainder_obligation_fp: i64,
    remainder_obligation_audit_fp: i64,
    global_flowpipe_claim_mask: i64,
    time_slab_status_local: i64) -> i64 with Mod {
    var anchor_ok: i64 = 1
    if local_containment_obligation_fp != 963265870 { anchor_ok = 0 }
    if local_containment_obligation_audit_fp != 344106968 { anchor_ok = 0 }
    if taylor2_link_preflight_fp != 956152878 { anchor_ok = 0 }
    if taylor2_link_preflight_audit_fp != 916252082 { anchor_ok = 0 }

