    if x_slack <= 0 { axis_containment_ok = 0 }
    if y_slack <= 0 { axis_containment_ok = 0 }
    if z_slack <= 0 { axis_containment_ok = 0 }

    let taylor_order: i64 = 2
    let target_scale: i64 = 1000000
    let selected_dt_num: i64 = 1
    let selected_dt_den: i64 = 100

    var taylor_contract_ok: i64 = 1
    if taylor_order != 2 { taylor_contract_ok = 0 }
    if target_scale != 1000000 { taylor_contract_ok = 0 }
    if selected_dt_num != 1 { taylor_contract_ok = 0 }
    if selected_dt_den != 100 { taylor_contract_ok = 0 }

    let local_flowpipe_obligation_mask: i64 = axis_containment_mask
    var local_obligation_ok: i64 = 1
    if local_flowpipe_obligation_mask != 7 { local_obligation_ok = 0 }
    if obligation_status_local != 12 { local_obligation_ok = 0 }

    var non_global_claim_ok: i64 = 1
    if global_flowpipe_claim_mask != 0 { non_global_claim_ok = 0 }

    var repair_consumption_ok: i64 = 1
    if z_margin != 55000 { repair_consumption_ok = 0 }
    if z_slack != 469 { repair_consumption_ok = 0 }

