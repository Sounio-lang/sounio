    if remainder_obligation_audit_fp != 344816971 { remainder_anchor_ok = 0 }
    if z_margin_repair_fp != 617386880 { remainder_anchor_ok = 0 }
    if z_margin_repair_audit_fp != 478471574 { remainder_anchor_ok = 0 }

    let x_projected_radius: i64 = 243366
    let y_projected_radius: i64 = 319640
    let z_projected_radius: i64 = 42448
    let x_lte: i64 = 47276
    let y_lte: i64 = 66549
    let z_lte: i64 = 12083
    let x_need: i64 = x_projected_radius + x_lte
    let y_need: i64 = y_projected_radius + y_lte
    let z_need: i64 = z_projected_radius + z_lte
    let x_margin: i64 = 299663
    let y_margin: i64 = 389292
    let z_margin: i64 = 55000
    let x_slack: i64 = x_margin - x_need
    let y_slack: i64 = y_margin - y_need
    let z_slack: i64 = z_margin - z_need

    var decomposition_ok: i64 = 1
    if x_need != 290642 { decomposition_ok = 0 }
    if y_need != 386189 { decomposition_ok = 0 }
    if z_need != 54531 { decomposition_ok = 0 }
    if x_slack != 9021 { decomposition_ok = 0 }
    if y_slack != 3103 { decomposition_ok = 0 }
    if z_slack != 469 { decomposition_ok = 0 }

    var axis_containment_mask: i64 = 0
    if x_need <= x_margin { axis_containment_mask = axis_containment_mask + 1 }
    if y_need <= y_margin { axis_containment_mask = axis_containment_mask + 2 }
    if z_need <= z_margin { axis_containment_mask = axis_containment_mask + 4 }

    var axis_containment_ok: i64 = 1
