//! Split from systems/lorenz_i256_cert.sio — Lorenz i256 step-certificate helpers.
//! Do not re-merge into a single file over the lexer source-byte ceiling (2097152).
//! Parent façade: systems/lorenz_i256_cert.sio (pub use only).

use theorem::div_witness::*
use systems::lorenz_i256_cert_core::*


pub fn lorenz_i256_step6_center_instance_fingerprint(
    step_index: i64,
    sigma: i64,
    rho: i64,
    beta_num: i64,
    beta_den: i64,
    scale: i64,
    dt_q: i64,
    dt_r: i64,
    start_x: i64,
    start_y: i64,
    start_z: i64,
    trajectory_manifest_fp: i64,
    response_envelope_fp: i64,
    response_envelope_audit_fp: i64) -> i64 with Mod {
    if step_index != 6 { return 0 - 1 }
    if sigma != 10 { return 0 - 1 }
    if rho != 28 { return 0 - 1 }
    if beta_num != 8 { return 0 - 1 }
    if beta_den != 3 { return 0 - 1 }
    if scale != 4294967296 { return 0 - 1 }
    if dt_q != 42949672 { return 0 - 1 }
    if dt_r != 96 { return 0 - 1 }
    if start_x != 5309941770 { return 0 - 1 }
    if start_y != 10058731223 { return 0 - 1 }
    if start_z != 4084837935 { return 0 - 1 }
    if trajectory_manifest_fp != 214180161 { return 0 - 1 }
    if response_envelope_fp != 506104143 { return 0 - 1 }
    if response_envelope_audit_fp != 956295573 { return 0 - 1 }

    var fp: i64 = 251
    fp = lorenz_i256_cert_mix(fp, step_index, 3203)
    fp = lorenz_i256_cert_mix(fp, sigma, 3203)
    fp = lorenz_i256_cert_mix(fp, rho, 3203)
    fp = lorenz_i256_cert_mix(fp, beta_num, 3203)
    fp = lorenz_i256_cert_mix(fp, beta_den, 3203)
    fp = lorenz_i256_cert_mix(fp, scale, 3203)
    fp = lorenz_i256_cert_mix(fp, dt_q, 3203)
    fp = lorenz_i256_cert_mix(fp, dt_r, 3203)
    fp = lorenz_i256_cert_mix(fp, start_x, 3203)
    fp = lorenz_i256_cert_mix(fp, start_y, 3203)
    fp = lorenz_i256_cert_mix(fp, start_z, 3203)
    fp = lorenz_i256_cert_mix(fp, trajectory_manifest_fp, 3203)
    fp = lorenz_i256_cert_mix(fp, response_envelope_fp, 3203)
    fp = lorenz_i256_cert_mix(fp, response_envelope_audit_fp, 3203)
    return fp
}

