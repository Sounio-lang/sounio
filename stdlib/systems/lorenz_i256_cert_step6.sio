        x_slab_slack, y_slab_slack, z_slab_slack,
        time_slab_containment_mask, local_time_slab_obligation_mask,
        global_flowpipe_claim_mask, time_slab_status_local)
    let certificate_fp = lorenz_i256_step6_taylor2_time_slab_containment_certificate_fingerprint(
        instance_fp, dx_bound, dy_bound, dz_bound, selected_dt_num,
        selected_dt_den, x_sweep, y_sweep, z_sweep, x_slab_margin,
        y_slab_margin, z_slab_margin, x_slab_slack, y_slab_slack,
        z_slab_slack, time_slab_containment_mask,
        local_time_slab_obligation_mask, global_flowpipe_claim_mask,
        time_slab_status_local, ok_mask)

    return lorenz_i256_step6_taylor2_time_slab_containment_fingerprint(
        instance_fp, certificate_fp, 14, 6, time_slab_containment_mask,
        local_time_slab_obligation_mask, global_flowpipe_claim_mask,
