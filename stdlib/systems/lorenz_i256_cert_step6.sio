    if anchor_ok == 1 { ok_mask = ok_mask + 1 }
    if remainder_anchor_ok == 1 { ok_mask = ok_mask + 2 }
    if decomposition_ok == 1 { ok_mask = ok_mask + 4 }
    if axis_containment_ok == 1 { ok_mask = ok_mask + 8 }
    if taylor_contract_ok == 1 { ok_mask = ok_mask + 16 }
    if local_obligation_ok == 1 { ok_mask = ok_mask + 32 }
    if non_global_claim_ok == 1 { ok_mask = ok_mask + 64 }
    if repair_consumption_ok == 1 { ok_mask = ok_mask + 128 }
    if ok_mask != 255 { return 0 - 1 }

    let instance_fp = lorenz_i256_step6_taylor2_local_containment_obligation_instance_fingerprint(
