        next_z_radius_i64, x_radius_cap_i64, y_radius_cap_i64,
        z_radius_cap_i64, ok_mask)

    return lorenz_i256_step6_radius_artifact_fingerprint(
        instance_fp, certificate_fp, 134624236, 643317565, 2, 6,
