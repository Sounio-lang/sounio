    if radius_artifact_fp <= 0 { dependency_ok = 0 }
    if projection_artifact_fp <= 0 { dependency_ok = 0 }

    var provided_ok: i64 = 1
    if provided_artifact_mask != 7 { provided_ok = 0 }
    if required_artifact_mask != 15 { provided_ok = 0 }
    if missing_artifact_mask != required_artifact_mask - provided_artifact_mask { provided_ok = 0 }

    var count_ok: i64 = 1
    if 3 != 3 { count_ok = 0 }
    if 4 != 4 { count_ok = 0 }
    if 1 != 1 { count_ok = 0 }

    var partial_status_ok: i64 = 1
    if candidate_status_partial != 3 { partial_status_ok = 0 }
    if missing_artifact_mask == 0 { partial_status_ok = 0 }

    var not_validated_ok: i64 = 1
    let validated_enclosure_mask: i64 = 0
    if validated_enclosure_mask != 0 { not_validated_ok = 0 }
    if provided_artifact_mask == required_artifact_mask { not_validated_ok = 0 }

    var missing_guard_ok: i64 = 1
    if missing_artifact_mask != 8 { missing_guard_ok = 0 }
    if provided_artifact_mask + missing_artifact_mask != required_artifact_mask { missing_guard_ok = 0 }

    var ok_mask: i64 = 0
    if anchor_ok == 1 { ok_mask = ok_mask + 1 }
    if dependency_ok == 1 { ok_mask = ok_mask + 2 }
    if provided_ok == 1 { ok_mask = ok_mask + 4 }
    if count_ok == 1 { ok_mask = ok_mask + 8 }
    if partial_status_ok == 1 { ok_mask = ok_mask + 16 }
    if not_validated_ok == 1 { ok_mask = ok_mask + 32 }
    if missing_guard_ok == 1 { ok_mask = ok_mask + 64 }
    if ok_mask != 127 { return 0 - 1 }

    let instance_fp = lorenz_i256_step6_enclosure_candidate_bundle_instance_fingerprint(
        6, 506104143, 956295573, center_artifact_fp, 643317565,
