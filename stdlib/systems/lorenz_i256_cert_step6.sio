pub fn lorenz_i256_step6_center_artifact_check(
    dt_q: i64,
    dt_r: i64,
    dy_scaled_q_i64: i64,
    dy_scaled_r_i64: i64,
    xy_scaled_q_i64: i64,
    xy_scaled_r_i64: i64,
    beta_q_i64: i64,
    beta_r_i64: i64,
    x_inc_q_i64: i64,
    x_inc_r_i64: i64,
    y_inc_q_i64: i64,
    y_inc_r_i64: i64,
    z_inc_q_i64: i64,
    z_inc_r_i64: i64,
    final_x_i64: i64,
    final_y_i64: i64,
    final_z_i64: i64) -> i64 with Mod {
    let scale: i256 = 4294967296 as i256
    let x5: i256 = 5309941770 as i256
    let y5: i256 = 10058731223 as i256
    let z5: i256 = 4084837935 as i256

    let dt: i256 = dt_q as i256
    let dy_scaled_q: i256 = dy_scaled_q_i64 as i256
    let dy_scaled_r: i256 = dy_scaled_r_i64 as i256
    let xy_scaled_q: i256 = xy_scaled_q_i64 as i256
    let xy_scaled_r: i256 = xy_scaled_r_i64 as i256
    let beta_q: i256 = beta_q_i64 as i256
    let beta_r: i256 = beta_r_i64 as i256
    let x_inc_q: i256 = x_inc_q_i64 as i256
    let x_inc_r: i256 = x_inc_r_i64 as i256
    let y_inc_q: i256 = y_inc_q_i64 as i256
    let y_inc_r: i256 = y_inc_r_i64 as i256
    let z_inc_q: i256 = z_inc_q_i64 as i256
    let z_inc_r: i256 = z_inc_r_i64 as i256

    let dx_num: i256 = (10 as i256) * (y5 - x5)
    let dy_num: i256 = x5 * ((28 as i256) * scale - z5)
    let xy_num: i256 = x5 * y5
    let beta_num_z: i256 = (8 as i256) * z5
    let dy: i256 = dy_scaled_q - y5
    let z_inc_num: i256 = xy_scaled_q - beta_q
    if z_inc_num <= (0 as i256) { return 0 - 1 }

    let dt_ok = div_witness_check_i256(scale, 100 as i256, dt, dt_r as i256)
    let dy_scaled_ok = div_witness_check_i256(dy_num, scale, dy_scaled_q, dy_scaled_r)
    let xy_scaled_ok = div_witness_check_i256(xy_num, scale, xy_scaled_q, xy_scaled_r)
    let beta_ok = div_witness_check_i256(beta_num_z, 3 as i256, beta_q, beta_r)
    let x_inc_ok = div_witness_check_i256(dt * dx_num, scale, x_inc_q, x_inc_r)
    let y_inc_ok = div_witness_check_i256(dt * dy, scale, y_inc_q, y_inc_r)
    let z_inc_ok = div_witness_check_i256(dt * z_inc_num, scale, z_inc_q, z_inc_r)

    var ok_mask: i64 = 0
    if dt_ok == 1 { ok_mask = ok_mask + 1 }
    if dy_scaled_ok == 1 { ok_mask = ok_mask + 2 }
    if xy_scaled_ok == 1 { ok_mask = ok_mask + 4 }
    if beta_ok == 1 { ok_mask = ok_mask + 8 }
    if x_inc_ok == 1 { ok_mask = ok_mask + 16 }
    if y_inc_ok == 1 { ok_mask = ok_mask + 32 }
    if z_inc_ok == 1 { ok_mask = ok_mask + 64 }
    if ok_mask != 127 { return 0 - 1 }

    if x5 + x_inc_q != final_x_i64 as i256 { return 0 - 1 }
    if y5 + y_inc_q != final_y_i64 as i256 { return 0 - 1 }
    if z5 + z_inc_q != final_z_i64 as i256 { return 0 - 1 }

    let instance_fp = lorenz_i256_step6_center_instance_fingerprint(
        6, 10, 28, 8, 3, 4294967296, dt_q, dt_r,
        5309941770, 10058731223, 4084837935,
        214180161, 506104143, 956295573)
    let certificate_fp = lorenz_i256_step6_center_certificate_fingerprint(
        instance_fp, dy_scaled_q_i64, dy_scaled_r_i64,
        xy_scaled_q_i64, xy_scaled_r_i64, beta_q_i64, beta_r_i64,
        x_inc_q_i64, x_inc_r_i64, y_inc_q_i64, y_inc_r_i64,
        z_inc_q_i64, z_inc_r_i64, final_x_i64, final_y_i64,
        final_z_i64, ok_mask)

    return lorenz_i256_step6_center_artifact_fingerprint(
        instance_fp, certificate_fp, 214180161, 23144051, 561641681,
        506104143, 956295573, 1, 6, final_x_i64, final_y_i64,
        final_z_i64, ok_mask)
}

