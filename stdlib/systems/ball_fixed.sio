pub fn ball_fixed_lorenz_taylor2_step_request_fingerprint(
    step_schedule_fp: i64,
    step_schedule_audit_fp: i64,
    v47_step_schedule_receipt_fp: i64,
    v47_step_schedule_portfolio_audit_fp: i64,
    v47_readiness_fp: i64,
    expected_step_index: i64,
    expected_request_mask: i64) -> i64 with Mod {
    if step_schedule_fp != 353612555 { return 0 - 1 }
    if step_schedule_audit_fp != 335541872 { return 0 - 1 }
    if v47_step_schedule_receipt_fp != 842631931 { return 0 - 1 }
    if v47_step_schedule_portfolio_audit_fp != 13881891 { return 0 - 1 }
    if v47_readiness_fp != 224324310 { return 0 - 1 }
    if expected_step_index != 6 { return 0 - 1 }
    if expected_request_mask != 127 { return 0 - 1 }

    let trajectory_manifest_fp: i64 = 214180161
    let final_enclosure_receipt_fp: i64 = 114244647
    let dependency_dag_fp: i64 = 713010204
    let step_index: i64 = 6
    let taylor_order: i64 = 2
    let selected_dt_num: i64 = 1
    let selected_dt_den: i64 = 100
    let scale_log2: i64 = 32
    let source_width_bits: i64 = 256
    let bit_headroom: i64 = 184
    let min_bit_headroom: i64 = 180
    let target_remainder_ppm: i64 = 15000
    let max_dt_den_cap: i64 = 200
    let schedule_mask: i64 = 127
    let request_status_pending: i64 = 1

    var request_mask: i64 = 0
    if step_index == expected_step_index { request_mask = request_mask + 1 }
    if taylor_order == 2 { request_mask = request_mask + 2 }
    if selected_dt_num == 1 {
        if selected_dt_den == 100 {
            request_mask = request_mask + 4
        }
    }
    if source_width_bits == 256 {
        if scale_log2 == 32 {
            request_mask = request_mask + 8
        }
    }
    if bit_headroom >= min_bit_headroom { request_mask = request_mask + 16 }
    if target_remainder_ppm <= 15000 { request_mask = request_mask + 32 }
    if schedule_mask == 127 {
        if selected_dt_den <= max_dt_den_cap {
            request_mask = request_mask + 64
        }
    }
    if request_mask != expected_request_mask { return 0 - 1 }
    if request_mask != 127 { return 0 - 1 }

    var fp: i64 = 593
    fp = ball_fixed_trajectory_quality_mix(fp, step_schedule_fp)
    fp = ball_fixed_trajectory_quality_mix(fp, step_schedule_audit_fp)
    fp = ball_fixed_trajectory_quality_mix(fp, v47_step_schedule_receipt_fp)
    fp = ball_fixed_trajectory_quality_mix(fp, v47_step_schedule_portfolio_audit_fp)
    fp = ball_fixed_trajectory_quality_mix(fp, v47_readiness_fp)
    fp = ball_fixed_trajectory_quality_mix(fp, trajectory_manifest_fp)
    fp = ball_fixed_trajectory_quality_mix(fp, final_enclosure_receipt_fp)
    fp = ball_fixed_trajectory_quality_mix(fp, dependency_dag_fp)
    fp = ball_fixed_trajectory_quality_mix(fp, step_index)
    fp = ball_fixed_trajectory_quality_mix(fp, taylor_order)
    fp = ball_fixed_trajectory_quality_mix(fp, selected_dt_num)
    fp = ball_fixed_trajectory_quality_mix(fp, selected_dt_den)
    fp = ball_fixed_trajectory_quality_mix(fp, scale_log2)
    fp = ball_fixed_trajectory_quality_mix(fp, source_width_bits)
    fp = ball_fixed_trajectory_quality_mix(fp, bit_headroom)
    fp = ball_fixed_trajectory_quality_mix(fp, min_bit_headroom)
    fp = ball_fixed_trajectory_quality_mix(fp, target_remainder_ppm)
    fp = ball_fixed_trajectory_quality_mix(fp, max_dt_den_cap)
    fp = ball_fixed_trajectory_quality_mix(fp, request_mask)
    fp = ball_fixed_trajectory_quality_mix(fp, request_status_pending)
    return fp
}

