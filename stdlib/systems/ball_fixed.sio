pub fn ball_fixed_rational_leq_nonneg(
    left_num: i64,
    left_den: i64,
    right_num: i64,
    right_den: i64) -> i64 {
    if left_num < 0 { return 0 }
    if right_num < 0 { return 0 }
    if left_den <= 0 { return 0 }
    if right_den <= 0 { return 0 }
    if left_num * right_den <= right_num * left_den { return 1 }
    return 0
}

pub fn ball_fixed_lorenz_taylor2_step_schedule_fingerprint(
    adaptive_step_decision_fp: i64,
    adaptive_step_decision_audit_fp: i64,
