    let rx: i64 = ball_fixed_taylor2_remainder_radius_from_ratio(third_x_abs, step_den)
    let ry: i64 = ball_fixed_taylor2_remainder_radius_from_ratio(third_y_abs, step_den)
    let rz: i64 = ball_fixed_taylor2_remainder_radius_from_ratio(third_z_abs, step_den)
    if rx != expected_rx { return 0 - 1 }
    if ry != expected_ry { return 0 - 1 }
    if rz != expected_rz { return 0 - 1 }
    if rx != 102 { return 0 - 1 }
    if ry != 135 { return 0 - 1 }
    if rz != 20 { return 0 - 1 }

    let x_slack: i64 = x_radius_cap - final_xr
    let y_slack: i64 = y_radius_cap - final_yr
    let z_slack: i64 = z_radius_cap - final_zr
    if x_slack != 6634 { return 0 - 1 }
    if y_slack != 5360 { return 0 - 1 }
    if z_slack != 7552 { return 0 - 1 }

    let x_after_remainder: i64 = x_slack - rx
    let y_after_remainder: i64 = y_slack - ry
    let z_after_remainder: i64 = z_slack - rz
    if x_after_remainder != 6532 { return 0 - 1 }
    if y_after_remainder != 5225 { return 0 - 1 }
    if z_after_remainder != 7532 { return 0 - 1 }

    var validation_mask: i64 = 0
    if rx == 102 { validation_mask = validation_mask + 1 }
    if ry == 135 { validation_mask = validation_mask + 2 }
    if rz == 20 { validation_mask = validation_mask + 4 }
    if x_after_remainder >= 0 { validation_mask = validation_mask + 8 }
    if y_after_remainder >= 0 { validation_mask = validation_mask + 16 }
    if z_after_remainder >= 0 { validation_mask = validation_mask + 32 }
    if taylor_ball_bridge_fp == 979362768 { validation_mask = validation_mask + 64 }
    if validation_mask != expected_validation_mask { return 0 - 1 }

    var fp: i64 = 503
    fp = ball_fixed_trajectory_quality_mix(fp, taylor_ball_bridge_fp)
    fp = ball_fixed_trajectory_quality_mix(fp, scale)
    fp = ball_fixed_trajectory_quality_mix(fp, step_count)
    fp = ball_fixed_trajectory_quality_mix(fp, taylor_order)
    fp = ball_fixed_trajectory_quality_mix(fp, step_den)
    fp = ball_fixed_trajectory_quality_mix(fp, third_x_abs)
    fp = ball_fixed_trajectory_quality_mix(fp, third_y_abs)
    fp = ball_fixed_trajectory_quality_mix(fp, third_z_abs)
    fp = ball_fixed_trajectory_quality_mix(fp, rx)
    fp = ball_fixed_trajectory_quality_mix(fp, ry)
    fp = ball_fixed_trajectory_quality_mix(fp, rz)
    fp = ball_fixed_trajectory_quality_mix(fp, final_xr)
    fp = ball_fixed_trajectory_quality_mix(fp, final_yr)
    fp = ball_fixed_trajectory_quality_mix(fp, final_zr)
    fp = ball_fixed_trajectory_quality_mix(fp, x_radius_cap)
    fp = ball_fixed_trajectory_quality_mix(fp, y_radius_cap)
    fp = ball_fixed_trajectory_quality_mix(fp, z_radius_cap)
    fp = ball_fixed_trajectory_quality_mix(fp, x_slack)
    fp = ball_fixed_trajectory_quality_mix(fp, y_slack)
    fp = ball_fixed_trajectory_quality_mix(fp, z_slack)
