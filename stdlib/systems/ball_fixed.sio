//! stdlib/systems/ball_fixed.sio
//!
//! ABI-safe fixed-point ball helpers for validated dynamical-system gates.
//!
//! Scope:
//! - helper signatures stay in i64 so they do not cross the current source-level
//!   i128 user-function ABI boundary;
//! - centers may still be carried inline as i128/i256 by callers;
//! - every radius operation uses an explicit outward rounding unit or status
//!   check instead of relying on ambient floating-point behaviour.
//!
//! This is a staging layer for Lorenz-style validated integration, not yet a
//! long-time shadowing theorem or a Taylor-model engine.

use theorem::portfolio::*

pub fn ball_fixed_abs64(x: i64) -> i64 {
    if x < 0 { return 0 - x }
    return x
}

pub fn ball_fixed_status_ok(radius: i64, scale: i64, limit: i64) -> i64 {
    if radius < 0 { return 0 }
    if scale <= 0 { return 0 }
    if limit < 0 { return 0 }
    if radius > limit { return 0 }
    return 1
}

pub fn ball_fixed_floor_div_nonneg(n: i64, d: i64) -> i64 with Div {
    if n < 0 { return 0 - 1 }
    if d <= 0 { return 0 - 1 }
    return n / d
}

pub fn ball_fixed_ceil_div_nonneg(n: i64, d: i64) -> i64 with Div {
    if n < 0 { return 0 - 1 }
    if d <= 0 { return 0 - 1 }
    return (n + d - 1) / d
}

pub fn ball_fixed_mul_radius_guarded(abs_x: i64, rx: i64, abs_y: i64, ry: i64, scale: i64) -> i64 with Div {
    if abs_x < 0 { return 0 - 1 }
    if abs_y < 0 { return 0 - 1 }
    if ball_fixed_status_ok(rx, scale, 1000000000) == 0 { return 0 - 1 }
    if ball_fixed_status_ok(ry, scale, 1000000000) == 0 { return 0 - 1 }

    let total: i64 = (abs_x * ry) + (abs_y * rx) + (rx * ry)
    return ball_fixed_floor_div_nonneg(total, scale) + 1
}

pub fn ball_fixed_beta_radius_tight(zr: i64) -> i64 with Div {
    if zr < 0 { return 0 - 1 }
    return ball_fixed_ceil_div_nonneg(8 * zr, 3)
}

pub fn ball_fixed_beta_radius_guarded(zr: i64) -> i64 with Div {
    if zr < 0 { return 0 - 1 }
    return ball_fixed_beta_radius_tight(zr) + 1
}

pub fn ball_fixed_euler_radius_guarded(radius: i64, derivative_radius: i64, dt: i64, scale: i64) -> i64 with Div {
    if ball_fixed_status_ok(radius, scale, 1000000000) == 0 { return 0 - 1 }
    if derivative_radius < 0 { return 0 - 1 }
    if dt < 0 { return 0 - 1 }

    return radius + ball_fixed_floor_div_nonneg(dt * derivative_radius, scale) + 1
}

pub fn ball_fixed_dt_square(dt: i64) -> i64 {
    if dt < 0 { return 0 - 1 }
    if dt > 1000000000 { return 0 - 1 }
    return dt * dt
}

pub fn ball_fixed_lte_den(scale: i64) -> i64 {
    if scale <= 0 { return 0 - 1 }
    if scale > 1000000000 { return 0 - 1 }
    return 2 * scale * scale
}

pub fn ball_fixed_lte_radius_from_h2(dd_abs: i64, h2: i64, lte_den: i64) -> i64 with Div {
    if dd_abs < 0 { return 0 - 1 }
    if dd_abs > 4000000000 { return 0 - 1 }
    if h2 < 0 { return 0 - 1 }
    if h2 > 1000000000 { return 0 - 1 }
    if lte_den <= 0 { return 0 - 1 }
    return ball_fixed_ceil_div_nonneg(h2 * dd_abs, lte_den)
}

pub fn ball_fixed_lte_radius(dd_abs: i64, dt: i64, scale: i64) -> i64 with Div {
    let h2: i64 = ball_fixed_dt_square(dt)
    if h2 < 0 { return 0 - 1 }
    let den: i64 = ball_fixed_lte_den(scale)
    if den < 0 { return 0 - 1 }
    return ball_fixed_lte_radius_from_h2(dd_abs, h2, den)
}

pub fn ball_fixed_add_lte_radius(euler_radius: i64, lte_radius: i64) -> i64 {
    if euler_radius < 0 { return 0 - 1 }
    if lte_radius < 0 { return 0 - 1 }
    return euler_radius + lte_radius
}

pub fn ball_fixed_bound_lo(center: i64, radius: i64) -> i64 {
    return center - radius
}

pub fn ball_fixed_bound_hi(center: i64, radius: i64) -> i64 {
    return center + radius
}

pub fn ball_fixed_bounds_match(center: i64, radius: i64, lo: i64, hi: i64) -> i64 {
    if radius < 0 { return 0 }
    if lo != ball_fixed_bound_lo(center, radius) { return 0 }
    if hi != ball_fixed_bound_hi(center, radius) { return 0 }
    return 1
}

pub fn ball_fixed_contains_value(center: i64, radius: i64, value: i64) -> i64 {
    if radius < 0 { return 0 }
    if value < ball_fixed_bound_lo(center, radius) { return 0 }
    if value > ball_fixed_bound_hi(center, radius) { return 0 }
    return 1
}

pub fn ball_fixed_contains_ball(outer_center: i64, outer_radius: i64, inner_center: i64, inner_radius: i64) -> i64 {
    if outer_radius < 0 { return 0 }
    if inner_radius < 0 { return 0 }
    let center_delta: i64 = ball_fixed_abs64(inner_center - outer_center)
    if center_delta + inner_radius > outer_radius { return 0 }
    return 1
}

pub struct BallFixedEnclosure1 {
    pub scale: i64,
    pub center: i64,
    pub radius: i64,
    pub lo: i64,
    pub hi: i64,
    pub status_mask: i64,
    pub fingerprint: i64,
}

pub struct BallFixedEnclosure3 {
    pub scale: i64,
    pub center_x: i64,
    pub center_y: i64,
    pub center_z: i64,
    pub radius_x: i64,
    pub radius_y: i64,
    pub radius_z: i64,
    pub x_lo: i64,
    pub x_hi: i64,
    pub y_lo: i64,
    pub y_hi: i64,
    pub z_lo: i64,
    pub z_hi: i64,
    pub axis_mask: i64,
    pub fingerprint: i64,
}

fn ball_fixed_enclosure_mix(acc: i64, value: i64) -> i64 {
    return ((acc * 16777619) + value + 353) % 1000000007
}

pub fn ball_fixed_enclosure1_status_mask(scale: i64, center: i64, radius: i64,
                                         lo: i64, hi: i64) -> i64 {
    var mask: i64 = 0
    if scale > 0 { mask = mask + 1 }
    if radius >= 0 { mask = mask + 2 }
    if ball_fixed_bounds_match(center, radius, lo, hi) == 1 { mask = mask + 4 }
    return mask
}

pub fn ball_fixed_enclosure1_fingerprint(scale: i64, center: i64, radius: i64,
                                         lo: i64, hi: i64,
                                         expected_mask: i64) -> i64 {
    let mask = ball_fixed_enclosure1_status_mask(scale, center, radius, lo, hi)
    if mask != expected_mask { return 0 - 1 }
    if mask != 7 { return 0 - 1 }

    var acc: i64 = 31
    acc = ball_fixed_enclosure_mix(acc, scale)
    acc = ball_fixed_enclosure_mix(acc, center)
    acc = ball_fixed_enclosure_mix(acc, radius)
    acc = ball_fixed_enclosure_mix(acc, lo)
    acc = ball_fixed_enclosure_mix(acc, hi)
    acc = ball_fixed_enclosure_mix(acc, mask)
    return acc
}

pub fn ball_fixed_enclosure3_axis_mask(scale: i64,
                                       center_x: i64, center_y: i64, center_z: i64,
                                       radius_x: i64, radius_y: i64, radius_z: i64,
                                       x_lo: i64, x_hi: i64,
                                       y_lo: i64, y_hi: i64,
                                       z_lo: i64, z_hi: i64) -> i64 {
    var mask: i64 = 0
    if ball_fixed_enclosure1_status_mask(scale, center_x, radius_x, x_lo, x_hi) == 7 {
        mask = mask + 1
    }
    if ball_fixed_enclosure1_status_mask(scale, center_y, radius_y, y_lo, y_hi) == 7 {
        mask = mask + 2
    }
    if ball_fixed_enclosure1_status_mask(scale, center_z, radius_z, z_lo, z_hi) == 7 {
        mask = mask + 4
    }
    return mask
}

pub fn ball_fixed_enclosure3_fingerprint(scale: i64,
                                         center_x: i64, center_y: i64, center_z: i64,
                                         radius_x: i64, radius_y: i64, radius_z: i64,
                                         x_lo: i64, x_hi: i64,
                                         y_lo: i64, y_hi: i64,
                                         z_lo: i64, z_hi: i64,
                                         expected_axis_mask: i64) -> i64 {
    let axis_mask = ball_fixed_enclosure3_axis_mask(
        scale, center_x, center_y, center_z,
        radius_x, radius_y, radius_z,
        x_lo, x_hi, y_lo, y_hi, z_lo, z_hi)
    if axis_mask != expected_axis_mask { return 0 - 1 }
    if axis_mask != 7 { return 0 - 1 }

    let x_fp = ball_fixed_enclosure1_fingerprint(scale, center_x, radius_x, x_lo, x_hi, 7)
    let y_fp = ball_fixed_enclosure1_fingerprint(scale, center_y, radius_y, y_lo, y_hi, 7)
    let z_fp = ball_fixed_enclosure1_fingerprint(scale, center_z, radius_z, z_lo, z_hi, 7)
    if x_fp < 0 { return 0 - 1 }
    if y_fp < 0 { return 0 - 1 }
    if z_fp < 0 { return 0 - 1 }

    var acc: i64 = 47
    acc = ball_fixed_enclosure_mix(acc, scale)
    acc = ball_fixed_enclosure_mix(acc, axis_mask)
    acc = ball_fixed_enclosure_mix(acc, x_fp)
    acc = ball_fixed_enclosure_mix(acc, y_fp)
    acc = ball_fixed_enclosure_mix(acc, z_fp)
    return acc
}

pub fn ball_fixed_enclosure_from_euler_lte(center: i64, euler_radius: i64, lte_radius: i64, lo: i64, hi: i64) -> i64 {
    let final_radius: i64 = ball_fixed_add_lte_radius(euler_radius, lte_radius)
    if final_radius < 0 { return 0 }
    return ball_fixed_bounds_match(center, final_radius, lo, hi)
}

pub fn ball_fixed_validated_step3(center_x: i64, center_y: i64, center_z: i64,
                                  euler_xr: i64, euler_yr: i64, euler_zr: i64,
                                  lte_xr: i64, lte_yr: i64, lte_zr: i64,
                                  x_lo: i64, x_hi: i64,
                                  y_lo: i64, y_hi: i64,
                                  z_lo: i64, z_hi: i64) -> i64 {
    let final_xr: i64 = ball_fixed_add_lte_radius(euler_xr, lte_xr)
    let final_yr: i64 = ball_fixed_add_lte_radius(euler_yr, lte_yr)
    let final_zr: i64 = ball_fixed_add_lte_radius(euler_zr, lte_zr)
    if final_xr < 0 { return 0 }
    if final_yr < 0 { return 0 }
    if final_zr < 0 { return 0 }

    if ball_fixed_bounds_match(center_x, final_xr, x_lo, x_hi) == 0 { return 0 }
    if ball_fixed_bounds_match(center_y, final_yr, y_lo, y_hi) == 0 { return 0 }
    if ball_fixed_bounds_match(center_z, final_zr, z_lo, z_hi) == 0 { return 0 }

    if ball_fixed_contains_ball(center_x, final_xr, center_x, euler_xr) == 0 { return 0 }
    if ball_fixed_contains_ball(center_y, final_yr, center_y, euler_yr) == 0 { return 0 }
    if ball_fixed_contains_ball(center_z, final_zr, center_z, euler_zr) == 0 { return 0 }
    return 1
}

fn ball_fixed_step3_fingerprint_mix(acc: i64, value: i64) -> i64 {
    return ((acc * 16777619) + value + 193) % 1000000007
}

pub fn ball_fixed_validated_step3_fingerprint(center_x: i64, center_y: i64, center_z: i64,
                                              euler_xr: i64, euler_yr: i64, euler_zr: i64,
                                              lte_xr: i64, lte_yr: i64, lte_zr: i64,
                                              x_lo: i64, x_hi: i64,
                                              y_lo: i64, y_hi: i64,
                                              z_lo: i64, z_hi: i64) -> i64 {
    if ball_fixed_validated_step3(center_x, center_y, center_z,
                                  euler_xr, euler_yr, euler_zr,
                                  lte_xr, lte_yr, lte_zr,
                                  x_lo, x_hi, y_lo, y_hi, z_lo, z_hi) == 0 { return 0 - 1 }

    let final_xr: i64 = ball_fixed_add_lte_radius(euler_xr, lte_xr)
    let final_yr: i64 = ball_fixed_add_lte_radius(euler_yr, lte_yr)
    let final_zr: i64 = ball_fixed_add_lte_radius(euler_zr, lte_zr)
    var acc: i64 = 23
    acc = ball_fixed_step3_fingerprint_mix(acc, center_x)
    acc = ball_fixed_step3_fingerprint_mix(acc, center_y)
    acc = ball_fixed_step3_fingerprint_mix(acc, center_z)
    acc = ball_fixed_step3_fingerprint_mix(acc, euler_xr)
    acc = ball_fixed_step3_fingerprint_mix(acc, euler_yr)
    acc = ball_fixed_step3_fingerprint_mix(acc, euler_zr)
    acc = ball_fixed_step3_fingerprint_mix(acc, lte_xr)
    acc = ball_fixed_step3_fingerprint_mix(acc, lte_yr)
    acc = ball_fixed_step3_fingerprint_mix(acc, lte_zr)
    acc = ball_fixed_step3_fingerprint_mix(acc, x_lo)
    acc = ball_fixed_step3_fingerprint_mix(acc, x_hi)
    acc = ball_fixed_step3_fingerprint_mix(acc, y_lo)
    acc = ball_fixed_step3_fingerprint_mix(acc, y_hi)
    acc = ball_fixed_step3_fingerprint_mix(acc, z_lo)
    acc = ball_fixed_step3_fingerprint_mix(acc, z_hi)
    acc = ball_fixed_step3_fingerprint_mix(acc, final_xr)
    acc = ball_fixed_step3_fingerprint_mix(acc, final_yr)
    acc = ball_fixed_step3_fingerprint_mix(acc, final_zr)
    return acc
}

fn ball_fixed_step3_chain_mix(acc: i64, value: i64) -> i64 {
    return ((acc * 16777619) + value + 241) % 1000000007
}

pub fn ball_fixed_validated_step3_chain_fingerprint(previous_anchor: i64, step_index: i64,
                                                    scale: i64, dt: i64, step_fingerprint: i64) -> i64 {
    if previous_anchor < 0 { return 0 - 1 }
    if step_index <= 0 { return 0 - 1 }
    if scale <= 0 { return 0 - 1 }
    if dt < 0 { return 0 - 1 }
    if step_fingerprint < 0 { return 0 - 1 }

    var acc: i64 = 41
    acc = ball_fixed_step3_chain_mix(acc, previous_anchor)
    acc = ball_fixed_step3_chain_mix(acc, step_index)
    acc = ball_fixed_step3_chain_mix(acc, scale)
    acc = ball_fixed_step3_chain_mix(acc, dt)
    acc = ball_fixed_step3_chain_mix(acc, step_fingerprint)
    return acc
}

fn ball_fixed_trajectory_manifest_mix(acc: i64, value: i64) -> i64 {
    return ((acc * 16777619) + value + 701) % 1000000007
}

fn ball_fixed_trajectory_quality_mix(acc: i64, value: i64) -> i64 {
    return ((acc * 16777619) + value + 811) % 1000000007
}

pub fn ball_fixed_max3_i64(a: i64, b: i64, c: i64) -> i64 {
    if a >= b {
        if a >= c { return a }
        return c
    }
    if b >= c { return b }
    return c
}

pub fn ball_fixed_min3_i64(a: i64, b: i64, c: i64) -> i64 {
    if a <= b {
        if a <= c { return a }
        return c
    }
    if b <= c { return b }
    return c
}

pub fn ball_fixed_lorenz_trajectory5_radius_budget_fingerprint(
    scale: i64, steps: i64,
    final_xr: i64, final_yr: i64, final_zr: i64,
    x_radius_cap: i64, y_radius_cap: i64, z_radius_cap: i64) -> i64 {
    if scale != 1000000 { return 0 - 1 }
    if steps != 5 { return 0 - 1 }
    if final_xr < 0 { return 0 - 1 }
    if final_yr < 0 { return 0 - 1 }
    if final_zr < 0 { return 0 - 1 }
    if x_radius_cap < final_xr { return 0 - 1 }
    if y_radius_cap < final_yr { return 0 - 1 }
    if z_radius_cap < final_zr { return 0 - 1 }

    let x_slack = x_radius_cap - final_xr
    let y_slack = y_radius_cap - final_yr
    let z_slack = z_radius_cap - final_zr
    let total_slack = x_slack + y_slack + z_slack

    var acc: i64 = 79
    acc = ball_fixed_trajectory_quality_mix(acc, scale)
    acc = ball_fixed_trajectory_quality_mix(acc, steps)
    acc = ball_fixed_trajectory_quality_mix(acc, final_xr)
    acc = ball_fixed_trajectory_quality_mix(acc, final_yr)
    acc = ball_fixed_trajectory_quality_mix(acc, final_zr)
    acc = ball_fixed_trajectory_quality_mix(acc, x_radius_cap)
    acc = ball_fixed_trajectory_quality_mix(acc, y_radius_cap)
    acc = ball_fixed_trajectory_quality_mix(acc, z_radius_cap)
    acc = ball_fixed_trajectory_quality_mix(acc, x_slack)
    acc = ball_fixed_trajectory_quality_mix(acc, y_slack)
    acc = ball_fixed_trajectory_quality_mix(acc, z_slack)
    acc = ball_fixed_trajectory_quality_mix(acc, total_slack)
    return acc
}

pub fn ball_fixed_lorenz_trajectory5_quality_profile_fingerprint(
    scale: i64, steps: i64,
    trajectory_manifest_fp: i64,
    radius_budget_fp: i64,
    final_xr: i64, final_yr: i64, final_zr: i64,
    x_radius_cap: i64, y_radius_cap: i64, z_radius_cap: i64,
    x_lo: i64, x_hi: i64,
    y_lo: i64, y_hi: i64,
    z_lo: i64, z_hi: i64) -> i64 with Div {
    if scale != 1000000 { return 0 - 1 }
    if steps != 5 { return 0 - 1 }
    if trajectory_manifest_fp != 508132668 { return 0 - 1 }
    if radius_budget_fp != 565673886 { return 0 - 1 }
    if final_xr < 0 { return 0 - 1 }
    if final_yr < 0 { return 0 - 1 }
    if final_zr < 0 { return 0 - 1 }
    if x_radius_cap < final_xr { return 0 - 1 }
    if y_radius_cap < final_yr { return 0 - 1 }
    if z_radius_cap < final_zr { return 0 - 1 }
    if x_hi < x_lo { return 0 - 1 }
    if y_hi < y_lo { return 0 - 1 }
    if z_hi < z_lo { return 0 - 1 }

    let x_slack = x_radius_cap - final_xr
    let y_slack = y_radius_cap - final_yr
    let z_slack = z_radius_cap - final_zr
    let total_slack = x_slack + y_slack + z_slack
    let radius_sum = final_xr + final_yr + final_zr
    let cap_sum = x_radius_cap + y_radius_cap + z_radius_cap
    if cap_sum <= 0 { return 0 - 1 }

    let max_radius = ball_fixed_max3_i64(final_xr, final_yr, final_zr)
    let min_radius = ball_fixed_min3_i64(final_xr, final_yr, final_zr)
    if min_radius <= 0 { return 0 - 1 }

    let aspect_q = max_radius / min_radius
    let aspect_r = max_radius - (aspect_q * min_radius)
    let radius_fill_ppm = (radius_sum * 1000000) / cap_sum
    let slack_ppm = (total_slack * 1000000) / cap_sum
    let x_width = x_hi - x_lo
    let y_width = y_hi - y_lo
    let z_width = z_hi - z_lo
    let box_volume = x_width * y_width * z_width

    if x_slack != 6634 { return 0 - 1 }
    if y_slack != 5360 { return 0 - 1 }
    if z_slack != 7552 { return 0 - 1 }
    if total_slack != 19546 { return 0 - 1 }
    if radius_sum != 605454 { return 0 - 1 }
    if max_radius != 319640 { return 0 - 1 }
    if min_radius != 42448 { return 0 - 1 }
    if aspect_q != 7 { return 0 - 1 }
    if aspect_r != 22504 { return 0 - 1 }
    if radius_fill_ppm != 968726 { return 0 - 1 }
    if slack_ppm != 31273 { return 0 - 1 }
    if x_width != 486732 { return 0 - 1 }
    if y_width != 639280 { return 0 - 1 }
    if z_width != 84896 { return 0 - 1 }
    if box_volume != 26416072366172160 { return 0 - 1 }

    var acc: i64 = 89
    acc = ball_fixed_trajectory_quality_mix(acc, scale)
    acc = ball_fixed_trajectory_quality_mix(acc, steps)
    acc = ball_fixed_trajectory_quality_mix(acc, trajectory_manifest_fp)
    acc = ball_fixed_trajectory_quality_mix(acc, radius_budget_fp)
    acc = ball_fixed_trajectory_quality_mix(acc, final_xr)
    acc = ball_fixed_trajectory_quality_mix(acc, final_yr)
    acc = ball_fixed_trajectory_quality_mix(acc, final_zr)
    acc = ball_fixed_trajectory_quality_mix(acc, x_radius_cap)
    acc = ball_fixed_trajectory_quality_mix(acc, y_radius_cap)
    acc = ball_fixed_trajectory_quality_mix(acc, z_radius_cap)
    acc = ball_fixed_trajectory_quality_mix(acc, x_slack)
    acc = ball_fixed_trajectory_quality_mix(acc, y_slack)
    acc = ball_fixed_trajectory_quality_mix(acc, z_slack)
    acc = ball_fixed_trajectory_quality_mix(acc, total_slack)
    acc = ball_fixed_trajectory_quality_mix(acc, radius_sum)
    acc = ball_fixed_trajectory_quality_mix(acc, max_radius)
    acc = ball_fixed_trajectory_quality_mix(acc, min_radius)
    acc = ball_fixed_trajectory_quality_mix(acc, aspect_q)
    acc = ball_fixed_trajectory_quality_mix(acc, aspect_r)
    acc = ball_fixed_trajectory_quality_mix(acc, radius_fill_ppm)
    acc = ball_fixed_trajectory_quality_mix(acc, slack_ppm)
    acc = ball_fixed_trajectory_quality_mix(acc, x_width)
    acc = ball_fixed_trajectory_quality_mix(acc, y_width)
    acc = ball_fixed_trajectory_quality_mix(acc, z_width)
    acc = ball_fixed_trajectory_quality_mix(acc, box_volume)
    return acc
}

pub fn ball_fixed_lorenz_trajectory5_final_enclosure_fingerprint(
    trajectory_manifest_fp: i64,
    quality_profile_fp: i64,
    radius_budget_fp: i64,
    scale: i64,
    final_x: i64, final_y: i64, final_z: i64,
    final_xr: i64, final_yr: i64, final_zr: i64,
    x_lo: i64, x_hi: i64,
    y_lo: i64, y_hi: i64,
    z_lo: i64, z_hi: i64,
    expected_axis_mask: i64) -> i64 {
    if trajectory_manifest_fp != 508132668 { return 0 - 1 }
    if quality_profile_fp != 70877465 { return 0 - 1 }
    if radius_budget_fp != 565673886 { return 0 - 1 }

    let enclosure_fp = ball_fixed_enclosure3_fingerprint(
        scale, final_x, final_y, final_z,
        final_xr, final_yr, final_zr,
        x_lo, x_hi, y_lo, y_hi, z_lo, z_hi,
        expected_axis_mask)
    if enclosure_fp != 166945519 { return 0 - 1 }

    var acc: i64 = 181
    acc = ball_fixed_enclosure_mix(acc, trajectory_manifest_fp)
    acc = ball_fixed_enclosure_mix(acc, quality_profile_fp)
    acc = ball_fixed_enclosure_mix(acc, radius_budget_fp)
    acc = ball_fixed_enclosure_mix(acc, enclosure_fp)
    acc = ball_fixed_enclosure_mix(acc, expected_axis_mask)
    return acc
}

pub fn ball_fixed_lorenz_trajectory5_step_policy_fingerprint(
    quality_profile_fp: i64,
    radius_fill_limit_ppm: i64,
    min_slack_ppm: i64,
    max_aspect_q: i64,
    max_box_volume: i64) -> i64 {
    if quality_profile_fp != 70877465 { return 0 - 1 }
    if radius_fill_limit_ppm != 970000 { return 0 - 1 }
    if min_slack_ppm != 30000 { return 0 - 1 }
    if max_aspect_q != 8 { return 0 - 1 }
