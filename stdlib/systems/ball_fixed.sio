    if v46_decision_receipt_fp != 279109641 { return 0 - 1 }
    if v46_decision_portfolio_audit_fp != 207228249 { return 0 - 1 }
    if v46_readiness_fp != 984799877 { return 0 - 1 }
    if expected_action_code != 2 { return 0 - 1 }
    if expected_schedule_mask != 127 { return 0 - 1 }

    let action_code: i64 = 2
    let base_dt_num: i64 = 1
    let base_dt_den: i64 = 100
    let min_dt_num: i64 = 1
    let min_dt_den: i64 = 200
    let selected_dt_num: i64 = 1
    let selected_dt_den: i64 = 100
    let max_dt_num: i64 = 3
    let max_dt_den: i64 = 200
    let shrink_dt_num: i64 = 1
    let shrink_dt_den: i64 = 200
    let hold_dt_num: i64 = 1
    let hold_dt_den: i64 = 100
    let grow_dt_num: i64 = 3
    let grow_dt_den: i64 = 200
    let max_dt_den_cap: i64 = 200

    var schedule_mask: i64 = 0
    if ball_fixed_rational_leq_nonneg(min_dt_num, min_dt_den, selected_dt_num, selected_dt_den) == 1 {
        schedule_mask = schedule_mask + 1
    }
    if ball_fixed_rational_leq_nonneg(selected_dt_num, selected_dt_den, max_dt_num, max_dt_den) == 1 {
        schedule_mask = schedule_mask + 2
    }
    if action_code == expected_action_code { schedule_mask = schedule_mask + 4 }
    if selected_dt_num == hold_dt_num {
        if selected_dt_den == hold_dt_den {
            schedule_mask = schedule_mask + 8
        }
    }
    if ball_fixed_rational_leq_nonneg(shrink_dt_num, shrink_dt_den, hold_dt_num, hold_dt_den) == 1 {
        if ball_fixed_rational_leq_nonneg(hold_dt_num, hold_dt_den, grow_dt_num, grow_dt_den) == 1 {
            schedule_mask = schedule_mask + 16
        }
    }
    if adaptive_step_decision_fp == 120259197 { schedule_mask = schedule_mask + 32 }
    if selected_dt_den <= max_dt_den_cap { schedule_mask = schedule_mask + 64 }
    if schedule_mask != expected_schedule_mask { return 0 - 1 }
    if schedule_mask != 127 { return 0 - 1 }

