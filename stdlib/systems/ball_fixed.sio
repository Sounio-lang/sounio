pub fn ball_fixed_max_abs_pair(lo: i64, hi: i64) -> i64 {
    let a: i64 = ball_fixed_abs64(lo)
    let b: i64 = ball_fixed_abs64(hi)
    if b > a { return b }
    return a
}

pub fn ball_fixed_lorenz_dx_radius(sigma_abs: i64, xr: i64, yr: i64) -> i64 {
    if sigma_abs < 0 { return 0 - 1 }
    if xr < 0 { return 0 - 1 }
    if yr < 0 { return 0 - 1 }
    return sigma_abs * (xr + yr)
}

pub fn ball_fixed_lorenz_dy_radius(abs_x: i64, xr: i64, abs_rhoz: i64, rhoz_radius: i64, yr: i64, scale: i64) -> i64 with Div {
    if yr < 0 { return 0 - 1 }
    let prod_radius = ball_fixed_mul_radius_guarded(abs_x, xr, abs_rhoz, rhoz_radius, scale)
    if prod_radius < 0 { return 0 - 1 }
    return prod_radius + yr
}

pub fn ball_fixed_lorenz_dz_radius(abs_x: i64, xr: i64, abs_y: i64, yr: i64, zr: i64, scale: i64) -> i64 with Div {
    let xy_radius = ball_fixed_mul_radius_guarded(abs_x, xr, abs_y, yr, scale)
    if xy_radius < 0 { return 0 - 1 }
    let beta_radius = ball_fixed_beta_radius_guarded(zr)
    if beta_radius < 0 { return 0 - 1 }
    return xy_radius + beta_radius
}

pub fn ball_fixed_lorenz_dx_abs_bound(x_abs: i64, y_abs: i64, sigma_abs: i64) -> i64 {
    if x_abs < 0 { return 0 - 1 }
    if y_abs < 0 { return 0 - 1 }
    if sigma_abs < 0 { return 0 - 1 }
    return sigma_abs * (x_abs + y_abs)
}

pub fn ball_fixed_lorenz_dy_abs_bound(x_abs: i64, rhoz_abs: i64, y_abs: i64, scale: i64) -> i64 with Div {
    if x_abs < 0 { return 0 - 1 }
    if rhoz_abs < 0 { return 0 - 1 }
    if y_abs < 0 { return 0 - 1 }
    if scale <= 0 { return 0 - 1 }
    return ball_fixed_ceil_div_nonneg(x_abs * rhoz_abs, scale) + y_abs
}

pub fn ball_fixed_lorenz_dz_abs_bound(x_abs: i64, y_abs: i64, z_abs: i64, scale: i64) -> i64 with Div {
    if x_abs < 0 { return 0 - 1 }
    if y_abs < 0 { return 0 - 1 }
    if z_abs < 0 { return 0 - 1 }
    if scale <= 0 { return 0 - 1 }
    let xy_abs: i64 = ball_fixed_ceil_div_nonneg(x_abs * y_abs, scale)
    let beta_abs: i64 = ball_fixed_ceil_div_nonneg(8 * z_abs, 3)
    return xy_abs + beta_abs
}

pub fn ball_fixed_lorenz_ddx_abs_bound(dx_abs: i64, dy_abs: i64, sigma_abs: i64) -> i64 {
    if dx_abs < 0 { return 0 - 1 }
    if dy_abs < 0 { return 0 - 1 }
    if sigma_abs < 0 { return 0 - 1 }
    return sigma_abs * (dy_abs + dx_abs)
}

pub fn ball_fixed_lorenz_ddy_abs_bound(dx_abs: i64, rhoz_abs: i64, x_abs: i64, dz_abs: i64, dy_abs: i64, scale: i64) -> i64 with Div {
    if dx_abs < 0 { return 0 - 1 }
    if rhoz_abs < 0 { return 0 - 1 }
    if x_abs < 0 { return 0 - 1 }
    if dz_abs < 0 { return 0 - 1 }
    if dy_abs < 0 { return 0 - 1 }
    if scale <= 0 { return 0 - 1 }
    let dx_rhoz_abs: i64 = ball_fixed_ceil_div_nonneg(dx_abs * rhoz_abs, scale)
    let x_dz_abs: i64 = ball_fixed_ceil_div_nonneg(x_abs * dz_abs, scale)
    return dx_rhoz_abs + x_dz_abs + dy_abs
}

pub fn ball_fixed_lorenz_ddz_abs_bound(dx_abs: i64, y_abs: i64, x_abs: i64, dy_abs: i64, dz_abs: i64, scale: i64) -> i64 with Div {
    if dx_abs < 0 { return 0 - 1 }
    if y_abs < 0 { return 0 - 1 }
    if x_abs < 0 { return 0 - 1 }
    if dy_abs < 0 { return 0 - 1 }
    if dz_abs < 0 { return 0 - 1 }
    if scale <= 0 { return 0 - 1 }
    let dx_y_abs: i64 = ball_fixed_ceil_div_nonneg(dx_abs * y_abs, scale)
    let x_dy_abs: i64 = ball_fixed_ceil_div_nonneg(x_abs * dy_abs, scale)
    let beta_dz_abs: i64 = ball_fixed_ceil_div_nonneg(8 * dz_abs, 3)
    return dx_y_abs + x_dy_abs + beta_dz_abs
}

pub fn ball_fixed_taylor2_remainder_den(step_den: i64) -> i64 {
    if step_den <= 0 { return 0 - 1 }
    if step_den > 10000 { return 0 - 1 }
    return 6 * step_den * step_den * step_den
}

pub fn ball_fixed_taylor2_remainder_radius_from_ratio(third_abs: i64, step_den: i64) -> i64 with Div {
    if third_abs < 0 { return 0 - 1 }
    if third_abs > 4000000000 { return 0 - 1 }
    let den: i64 = ball_fixed_taylor2_remainder_den(step_den)
    if den <= 0 { return 0 - 1 }
    return ball_fixed_ceil_div_nonneg(third_abs, den)
}

pub fn ball_fixed_lorenz_taylor2_remainder_fingerprint(
    taylor_ball_bridge_fp: i64,
    scale: i64,
    step_count: i64,
    taylor_order: i64,
    step_den: i64,
    third_x_abs: i64,
    third_y_abs: i64,
    third_z_abs: i64,
    expected_rx: i64,
    expected_ry: i64,
    expected_rz: i64,
    final_xr: i64,
    final_yr: i64,
    final_zr: i64,
    x_radius_cap: i64,
