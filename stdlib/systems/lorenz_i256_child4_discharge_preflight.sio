//! stdlib/systems/lorenz_i256_child4_discharge_preflight.sio
//!
//! Child-4 discharge preflight for the Lorenz i256 cover lane.
//! This is a blocker ledger after local validation, not a discharge receipt.

pub fn lorenz_i256_cover_child4_discharge_preflight_check(
    child4_validation_core_fp: i64,
    child4_validation_core_audit_fp: i64,
    child3_discharge_preflight_fp: i64,
    child3_discharge_preflight_audit_fp: i64,
    child_index: i64,
    child_validated_mask: i64,
    global_flowpipe_claim_mask: i64,
    discharge_status: i64) -> i64 with Mod {
    var validation_anchor_mask: i64 = 0
    if child4_validation_core_fp == 392846115 {
        if child4_validation_core_audit_fp == 644973208 {
            validation_anchor_mask = validation_anchor_mask + 1
        }
    }
    if child_index == 4 { validation_anchor_mask = validation_anchor_mask + 2 }
    if child_validated_mask == 31 { validation_anchor_mask = validation_anchor_mask + 4 }
    if discharge_status == 75 { validation_anchor_mask = validation_anchor_mask + 8 }

    var inherited_anchor_mask: i64 = 0
    if child3_discharge_preflight_fp == 57643306 {
        if child3_discharge_preflight_audit_fp == 784781218 {
            inherited_anchor_mask = inherited_anchor_mask + 1
        }
    }
    if child_index == 4 { inherited_anchor_mask = inherited_anchor_mask + 2 }
    if child_validated_mask == 31 { inherited_anchor_mask = inherited_anchor_mask + 4 }
    if discharge_status == 75 { inherited_anchor_mask = inherited_anchor_mask + 8 }

    let pending_child_validation_mask: i64 = 0
    let remaining_child_validation_mask: i64 = 0
    let child_validation_dependency_mask: i64 = 63
    let child4_validation_receipt_mask: i64 = 31
    let child4_discharge_preflight_mask: i64 = 16
    let discharge_blocker_mask: i64 = 15
    let missing_child_validation_mask: i64 = 0
    let pending_child_discharge_mask: i64 = 255
    let child_discharge_mask: i64 = 0
    let global_cover_certificate_mask: i64 = 0
    let finite_cover_certificate_mask: i64 = 0

    var blocker_ok: i64 = 1
    if pending_child_validation_mask != 0 { blocker_ok = 0 }
    if remaining_child_validation_mask != 0 { blocker_ok = 0 }
    if child_validation_dependency_mask != 63 { blocker_ok = 0 }
    if child4_validation_receipt_mask != 31 { blocker_ok = 0 }
    if child4_discharge_preflight_mask != 16 { blocker_ok = 0 }
    if discharge_blocker_mask != 15 { blocker_ok = 0 }
    if missing_child_validation_mask != 0 { blocker_ok = 0 }
    if pending_child_discharge_mask != 255 { blocker_ok = 0 }

    var nonclaim_ok: i64 = 1
    if child_discharge_mask != 0 { nonclaim_ok = 0 }
    if global_cover_certificate_mask != 0 { nonclaim_ok = 0 }
    if finite_cover_certificate_mask != 0 { nonclaim_ok = 0 }
    if global_flowpipe_claim_mask != 0 { nonclaim_ok = 0 }

    var ok_mask: i64 = 0
    if validation_anchor_mask == 15 { ok_mask = ok_mask + 1 }
    if inherited_anchor_mask == 15 { ok_mask = ok_mask + 2 }
    if blocker_ok == 1 { ok_mask = ok_mask + 4 }
    if nonclaim_ok == 1 { ok_mask = ok_mask + 8 }
    if child4_discharge_preflight_mask == 16 { ok_mask = ok_mask + 16 }
    if child_validated_mask == 31 { ok_mask = ok_mask + 32 }
    if pending_child_validation_mask == 0 { ok_mask = ok_mask + 64 }
    if discharge_status == 75 { ok_mask = ok_mask + 128 }

    if ok_mask != 255 { return 0 - 1 }
    return 938615204
}

pub fn lorenz_i256_cover_child4_discharge_preflight_audit_fingerprint(
    artifact_fp: i64,
    instance_fp: i64,
    certificate_fp: i64,
    child4_validation_core_fp: i64,
    child4_validation_core_audit_fp: i64,
    child3_discharge_preflight_fp: i64,
    child3_discharge_preflight_audit_fp: i64,
    child_index: i64,
    child_validated_mask: i64,
    pending_child_validation_mask: i64,
    remaining_child_validation_mask: i64,
    child_validation_dependency_mask: i64,
    child4_validation_receipt_mask: i64,
    child4_discharge_preflight_mask: i64,
    discharge_blocker_mask: i64,
    missing_child_validation_mask: i64,
    pending_child_discharge_mask: i64,
    child_discharge_mask: i64,
    global_cover_certificate_mask: i64,
    finite_cover_certificate_mask: i64,
    global_flowpipe_claim_mask: i64,
    discharge_status: i64,
    ok_mask: i64) -> i64 with Mod {
    if artifact_fp != 938615204 { return 0 - 1 }
    if instance_fp != 182647903 { return 0 - 1 }
    if certificate_fp != 719306552 { return 0 - 1 }
    if child4_validation_core_fp != 392846115 { return 0 - 1 }
    if child4_validation_core_audit_fp != 644973208 { return 0 - 1 }
    if child3_discharge_preflight_fp != 57643306 { return 0 - 1 }
    if child3_discharge_preflight_audit_fp != 784781218 { return 0 - 1 }
    if child_index != 4 { return 0 - 1 }
    if child_validated_mask != 31 { return 0 - 1 }
    if pending_child_validation_mask != 0 { return 0 - 1 }
    if remaining_child_validation_mask != 0 { return 0 - 1 }
    if child_validation_dependency_mask != 63 { return 0 - 1 }
    if child4_validation_receipt_mask != 31 { return 0 - 1 }
    if child4_discharge_preflight_mask != 16 { return 0 - 1 }
    if discharge_blocker_mask != 15 { return 0 - 1 }
    if missing_child_validation_mask != 0 { return 0 - 1 }
    if pending_child_discharge_mask != 255 { return 0 - 1 }
    if child_discharge_mask != 0 { return 0 - 1 }
    if global_cover_certificate_mask != 0 { return 0 - 1 }
    if finite_cover_certificate_mask != 0 { return 0 - 1 }
    if global_flowpipe_claim_mask != 0 { return 0 - 1 }
    if discharge_status != 75 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }
    return 405118337
}
