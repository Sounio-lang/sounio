//! stdlib/systems/lorenz_i256_child4_finite_cover_promotion_guard.sio
//!
//! Fail-closed finite-cover promotion guard for the Lorenz i256 cover lane.
//! This records that the child4 discharge preflight is not promotable to a
//! finite-cover or global-flowpipe certificate while discharge bits remain zero.

pub fn lorenz_i256_cover_child4_finite_cover_promotion_guard_check(
    child4_discharge_preflight_fp: i64,
    child4_discharge_preflight_audit_fp: i64,
    child4_validation_core_fp: i64,
    child4_validation_core_audit_fp: i64,
    child_validated_mask: i64,
    pending_child_validation_mask: i64,
    pending_child_discharge_mask: i64,
    child_discharge_mask: i64,
    finite_cover_certificate_mask: i64,
    global_cover_certificate_mask: i64,
    global_flowpipe_claim_mask: i64,
    guard_status: i64) -> i64 with Mod {
    var anchor_mask: i64 = 0
    if child4_discharge_preflight_fp == 938615204 {
        if child4_discharge_preflight_audit_fp == 405118337 {
            anchor_mask = anchor_mask + 1
        }
    }
    if child4_validation_core_fp == 392846115 {
        if child4_validation_core_audit_fp == 644973208 {
            anchor_mask = anchor_mask + 2
        }
    }
    if child_validated_mask == 31 { anchor_mask = anchor_mask + 4 }
    if pending_child_validation_mask == 0 { anchor_mask = anchor_mask + 8 }
    if guard_status == 76 { anchor_mask = anchor_mask + 16 }

    let child_validation_closed_mask: i64 = 31
    let discharge_dependency_mask: i64 = 31
    let discharge_blocker_mask: i64 = 255
    let promotion_blocker_mask: i64 = 15
    let nonpromotion_guard_mask: i64 = 31
    let promotion_allowed_mask: i64 = 0
    let finite_cover_candidate_mask: i64 = 0
    let global_certificate_candidate_mask: i64 = 0

    var blocker_ok: i64 = 1
    if child_validation_closed_mask != 31 { blocker_ok = 0 }
    if discharge_dependency_mask != 31 { blocker_ok = 0 }
    if discharge_blocker_mask != 255 { blocker_ok = 0 }
    if promotion_blocker_mask != 15 { blocker_ok = 0 }
    if nonpromotion_guard_mask != 31 { blocker_ok = 0 }
    if pending_child_discharge_mask != 255 { blocker_ok = 0 }
    if promotion_allowed_mask != 0 { blocker_ok = 0 }
    if finite_cover_candidate_mask != 0 { blocker_ok = 0 }
    if global_certificate_candidate_mask != 0 { blocker_ok = 0 }

    var nonclaim_ok: i64 = 1
    if child_discharge_mask != 0 { nonclaim_ok = 0 }
    if finite_cover_certificate_mask != 0 { nonclaim_ok = 0 }
    if global_cover_certificate_mask != 0 { nonclaim_ok = 0 }
    if global_flowpipe_claim_mask != 0 { nonclaim_ok = 0 }

    var ok_mask: i64 = 0
    if anchor_mask == 31 { ok_mask = ok_mask + 1 }
    if blocker_ok == 1 { ok_mask = ok_mask + 2 }
    if nonclaim_ok == 1 { ok_mask = ok_mask + 4 }
    if child_validated_mask == 31 { ok_mask = ok_mask + 8 }
    if pending_child_validation_mask == 0 { ok_mask = ok_mask + 16 }
    if pending_child_discharge_mask == 255 { ok_mask = ok_mask + 32 }
    if promotion_allowed_mask == 0 { ok_mask = ok_mask + 64 }
    if guard_status == 76 { ok_mask = ok_mask + 128 }

    if ok_mask != 255 { return 0 - 1 }
    return 657240918
}

pub fn lorenz_i256_cover_child4_finite_cover_promotion_guard_audit_fingerprint(
    artifact_fp: i64,
    instance_fp: i64,
    certificate_fp: i64,
    child4_discharge_preflight_fp: i64,
    child4_discharge_preflight_audit_fp: i64,
    child4_validation_core_fp: i64,
    child4_validation_core_audit_fp: i64,
    child_validated_mask: i64,
    pending_child_validation_mask: i64,
    pending_child_discharge_mask: i64,
    child_discharge_mask: i64,
    finite_cover_certificate_mask: i64,
    global_cover_certificate_mask: i64,
    global_flowpipe_claim_mask: i64,
    child_validation_closed_mask: i64,
    discharge_dependency_mask: i64,
    discharge_blocker_mask: i64,
    promotion_blocker_mask: i64,
    nonpromotion_guard_mask: i64,
    promotion_allowed_mask: i64,
    finite_cover_candidate_mask: i64,
    global_certificate_candidate_mask: i64,
    guard_status: i64,
    ok_mask: i64) -> i64 with Mod {
    if artifact_fp != 657240918 { return 0 - 1 }
    if instance_fp != 880163417 { return 0 - 1 }
    if certificate_fp != 246971305 { return 0 - 1 }
    if child4_discharge_preflight_fp != 938615204 { return 0 - 1 }
    if child4_discharge_preflight_audit_fp != 405118337 { return 0 - 1 }
    if child4_validation_core_fp != 392846115 { return 0 - 1 }
    if child4_validation_core_audit_fp != 644973208 { return 0 - 1 }
    if child_validated_mask != 31 { return 0 - 1 }
    if pending_child_validation_mask != 0 { return 0 - 1 }
    if pending_child_discharge_mask != 255 { return 0 - 1 }
    if child_discharge_mask != 0 { return 0 - 1 }
    if finite_cover_certificate_mask != 0 { return 0 - 1 }
    if global_cover_certificate_mask != 0 { return 0 - 1 }
    if global_flowpipe_claim_mask != 0 { return 0 - 1 }
    if child_validation_closed_mask != 31 { return 0 - 1 }
    if discharge_dependency_mask != 31 { return 0 - 1 }
    if discharge_blocker_mask != 255 { return 0 - 1 }
    if promotion_blocker_mask != 15 { return 0 - 1 }
    if nonpromotion_guard_mask != 31 { return 0 - 1 }
    if promotion_allowed_mask != 0 { return 0 - 1 }
    if finite_cover_candidate_mask != 0 { return 0 - 1 }
    if global_certificate_candidate_mask != 0 { return 0 - 1 }
    if guard_status != 76 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }
    return 312489670
}
