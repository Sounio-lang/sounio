pub fn lorenz_i256_trajectory5_manifest_fingerprint(scale_log2: i64,
                                                    dt_q: i64, dt_r: i64,
                                                    step_count: i64,
                                                    initial_x: i64,
                                                    initial_y: i64,
                                                    initial_z: i64,
                                                    chain_anchor: i64,
                                                    final_step_certificate: i64,
                                                    final_x: i64,
                                                    final_y: i64,
                                                    final_z: i64) -> i64 with Mod {
    if scale_log2 != 32 { return 0 - 1 }
    if dt_q != 42949672 { return 0 - 1 }
    if dt_r != 96 { return 0 - 1 }
    if step_count != 5 { return 0 - 1 }
    if initial_x != 4294967296 { return 0 - 1 }
    if initial_y != 4294967296 { return 0 - 1 }
    if initial_z != 4294967296 { return 0 - 1 }
    if chain_anchor != 23144051 { return 0 - 1 }
    if final_step_certificate != 561641681 { return 0 - 1 }
    if final_x != 5309941770 { return 0 - 1 }
    if final_y != 10058731223 { return 0 - 1 }
    if final_z != 4084837935 { return 0 - 1 }

    var fp: i64 = 191
    fp = lorenz_i256_cert_mix(fp, scale_log2, 1487)
    fp = lorenz_i256_cert_mix(fp, dt_q, 1487)
    fp = lorenz_i256_cert_mix(fp, dt_r, 1487)
    fp = lorenz_i256_cert_mix(fp, step_count, 1487)
    fp = lorenz_i256_cert_mix(fp, initial_x, 1487)
    fp = lorenz_i256_cert_mix(fp, initial_y, 1487)
    fp = lorenz_i256_cert_mix(fp, initial_z, 1487)
    fp = lorenz_i256_cert_mix(fp, chain_anchor, 1487)
    fp = lorenz_i256_cert_mix(fp, final_step_certificate, 1487)
    fp = lorenz_i256_cert_mix(fp, final_x, 1487)
    fp = lorenz_i256_cert_mix(fp, final_y, 1487)
    fp = lorenz_i256_cert_mix(fp, final_z, 1487)
    return fp
}

