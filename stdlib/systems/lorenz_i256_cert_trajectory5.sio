pub fn lorenz_i256_portfolio_v16_readiness_check(
    dt_q: i64,
    dt_r: i64,
    dy_scaled_q_i64: i64,
    dy_scaled_r_i64: i64,
    xy_scaled_q_i64: i64,
    xy_scaled_r_i64: i64,
    beta_q_i64: i64,
    beta_r_i64: i64,
    x_inc_q_i64: i64,
    x_inc_r_i64: i64,
    y_inc_q_i64: i64,
    y_inc_r_i64: i64,
    z_drop_q_i64: i64,
    z_drop_r_i64: i64,
    final_x_i64: i64,
    final_y_i64: i64,
    final_z_i64: i64) -> i64 with Mod {
    let trajectory_manifest_fp = lorenz_i256_trajectory5_certificate_check(
        dt_q, dt_r,
        dy_scaled_q_i64, dy_scaled_r_i64, xy_scaled_q_i64, xy_scaled_r_i64,
        beta_q_i64, beta_r_i64, x_inc_q_i64, x_inc_r_i64,
        y_inc_q_i64, y_inc_r_i64, z_drop_q_i64, z_drop_r_i64,
        final_x_i64, final_y_i64, final_z_i64)
    if trajectory_manifest_fp != 214180161 { return 0 - 1 }

    let portfolio_fp = solver_portfolio_v16_lorenz_i256_trajectory5_bundle_fingerprint(
        660429472, trajectory_manifest_fp, 827916944)
    if portfolio_fp != 320118125 { return 0 - 1 }

    let result_coverage_fp = solver_portfolio_v16_result_coverage_fingerprint(
        16, 20, 7, 11, 1, 1, portfolio_fp)
    if result_coverage_fp != 685105937 { return 0 - 1 }

    let family_coverage_fp = solver_portfolio_v16_checker_family_coverage_fingerprint(
        16, 20, 4, 2, 2, 1, 11, portfolio_fp)
    if family_coverage_fp != 210011781 { return 0 - 1 }

    let acceptance_receipt_fp = solver_portfolio_v16_acceptance_receipt_fingerprint(
        16, portfolio_fp, result_coverage_fp)
    if acceptance_receipt_fp != 629028996 { return 0 - 1 }

    let audit_receipt_fp = solver_portfolio_v16_audit_receipt_fingerprint(
        16, portfolio_fp, result_coverage_fp, family_coverage_fp,
        acceptance_receipt_fp)
    if audit_receipt_fp != 932551699 { return 0 - 1 }

    return solver_portfolio_v16_readiness_fingerprint(
        16, portfolio_fp, result_coverage_fp, family_coverage_fp,
        acceptance_receipt_fp, audit_receipt_fp)
}

pub fn lorenz_i256_trajectory5_range_budget_fingerprint(
