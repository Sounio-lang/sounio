    if final_y != 10058731223 { return 0 - 1 }
    if final_z != 4084837935 { return 0 - 1 }
    if final_x >= 17179869184 { return 0 - 1 }
    if final_y >= 17179869184 { return 0 - 1 }
    if final_z >= 17179869184 { return 0 - 1 }
    if signed_positive_limit_exp - quotient_product_bound_log2 != 184 { return 0 - 1 }

    var fp: i64 = 293
    fp = lorenz_i256_cert_mix(fp, scale_log2, 2519)
    fp = lorenz_i256_cert_mix(fp, step_count, 2519)
    fp = lorenz_i256_cert_mix(fp, state_bound_log2, 2519)
    fp = lorenz_i256_cert_mix(fp, derivative_num_bound_log2, 2519)
    fp = lorenz_i256_cert_mix(fp, quotient_product_bound_log2, 2519)
