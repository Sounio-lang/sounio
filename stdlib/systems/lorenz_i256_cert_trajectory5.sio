pub fn lorenz_i256_trajectory5_step6_local_flowpipe_bridge_check(
    trajectory5_manifest_fp: i64,
    chain_anchor_fp: i64,
    final_step_certificate_fp: i64,
    step6_center_artifact_fp: i64,
    step6_center_artifact_audit_fp: i64,
    local_flowpipe_proof_fp: i64,
    local_flowpipe_proof_audit_fp: i64,
    global_flowpipe_claim_mask: i64,
    bridge_status: i64) -> i64 with Mod {
    var trajectory_anchor_ok: i64 = 1
    if trajectory5_manifest_fp != 214180161 { trajectory_anchor_ok = 0 }
    if chain_anchor_fp != 23144051 { trajectory_anchor_ok = 0 }
    if final_step_certificate_fp != 561641681 { trajectory_anchor_ok = 0 }

    var center_anchor_ok: i64 = 1
    if step6_center_artifact_fp != 134624236 { center_anchor_ok = 0 }
    if step6_center_artifact_audit_fp != 643317565 { center_anchor_ok = 0 }

    var local_proof_anchor_ok: i64 = 1
    if local_flowpipe_proof_fp != 813941448 { local_proof_anchor_ok = 0 }
    if local_flowpipe_proof_audit_fp != 693709162 { local_proof_anchor_ok = 0 }

    let prefix_final_x: i64 = 5309941770
    let prefix_final_y: i64 = 10058731223
    let prefix_final_z: i64 = 4084837935
    let step6_start_x: i64 = 5309941770
    let step6_start_y: i64 = 10058731223
    let step6_start_z: i64 = 4084837935
    let step6_center_x: i64 = 5784820704
    let step6_center_y: i64 = 11394426024
    let step6_center_z: i64 = 4100266743

    var adjacency_mask: i64 = 0
    if prefix_final_x == step6_start_x { adjacency_mask = adjacency_mask + 1 }
    if prefix_final_y == step6_start_y { adjacency_mask = adjacency_mask + 2 }
    if prefix_final_z == step6_start_z { adjacency_mask = adjacency_mask + 4 }

    let trajectory_anchor_mask: i64 = 7
    let center_anchor_mask: i64 = 7
    let local_flowpipe_proof_mask: i64 = 15
    var chain_extension_mask: i64 = 0
    if trajectory_anchor_mask == 7 { chain_extension_mask = chain_extension_mask + 1 }
    if center_anchor_mask == 7 { chain_extension_mask = chain_extension_mask + 2 }
    if local_flowpipe_proof_mask == 15 { chain_extension_mask = chain_extension_mask + 4 }
    if adjacency_mask == 7 { chain_extension_mask = chain_extension_mask + 8 }

    var step_contract_ok: i64 = 1
    if 5 + 1 != 6 { step_contract_ok = 0 }
    if 256 != 256 { step_contract_ok = 0 }
    if 32 != 32 { step_contract_ok = 0 }
    if 1 != 1 { step_contract_ok = 0 }
    if 100 != 100 { step_contract_ok = 0 }

    var non_global_ok: i64 = 1
    if global_flowpipe_claim_mask != 0 { non_global_ok = 0 }
    if bridge_status != 16 { non_global_ok = 0 }

    var dependency_closure_ok: i64 = 1
    if trajectory5_manifest_fp != 214180161 { dependency_closure_ok = 0 }
    if step6_center_artifact_fp != 134624236 { dependency_closure_ok = 0 }
    if local_flowpipe_proof_fp != 813941448 { dependency_closure_ok = 0 }
    if chain_extension_mask != 15 { dependency_closure_ok = 0 }

    var ok_mask: i64 = 0
    if trajectory_anchor_ok == 1 { ok_mask = ok_mask + 1 }
    if center_anchor_ok == 1 { ok_mask = ok_mask + 2 }
    if local_proof_anchor_ok == 1 { ok_mask = ok_mask + 4 }
    if adjacency_mask == 7 { ok_mask = ok_mask + 8 }
    if step_contract_ok == 1 { ok_mask = ok_mask + 16 }
    if chain_extension_mask == 15 { ok_mask = ok_mask + 32 }
    if non_global_ok == 1 { ok_mask = ok_mask + 64 }
    if dependency_closure_ok == 1 { ok_mask = ok_mask + 128 }
    if ok_mask != 255 { return 0 - 1 }

    let instance_fp = lorenz_i256_trajectory5_step6_local_flowpipe_bridge_instance_fingerprint(
        trajectory5_manifest_fp, chain_anchor_fp, final_step_certificate_fp,
        step6_center_artifact_fp, step6_center_artifact_audit_fp,
        local_flowpipe_proof_fp, local_flowpipe_proof_audit_fp,
        5, 6, 6, 256, 32, 1, 100, prefix_final_x, prefix_final_y,
        prefix_final_z, step6_start_x, step6_start_y, step6_start_z,
        step6_center_x, step6_center_y, step6_center_z,
        trajectory_anchor_mask, center_anchor_mask, local_flowpipe_proof_mask,
        adjacency_mask, chain_extension_mask, global_flowpipe_claim_mask,
        bridge_status)
    let certificate_fp = lorenz_i256_trajectory5_step6_local_flowpipe_bridge_certificate_fingerprint(
        instance_fp, trajectory_anchor_mask, center_anchor_mask,
        local_flowpipe_proof_mask, adjacency_mask, chain_extension_mask,
        global_flowpipe_claim_mask, bridge_status, 5, 6, 6, 256, 32, 1, 100,
        ok_mask)

    return lorenz_i256_trajectory5_step6_local_flowpipe_bridge_fingerprint(
        instance_fp, certificate_fp, 17, 5, 6, 6, local_flowpipe_proof_mask,
        adjacency_mask, chain_extension_mask, global_flowpipe_claim_mask,
        bridge_status, ok_mask)
}

pub fn lorenz_i256_trajectory5_certificate_check(
    dt_q: i64,
    dt_r: i64,
    dy_scaled_q_i64: i64,
    dy_scaled_r_i64: i64,
    xy_scaled_q_i64: i64,
    xy_scaled_r_i64: i64,
    beta_q_i64: i64,
    beta_r_i64: i64,
    x_inc_q_i64: i64,
    x_inc_r_i64: i64,
    y_inc_q_i64: i64,
    y_inc_r_i64: i64,
    z_drop_q_i64: i64,
    z_drop_r_i64: i64,
    final_x_i64: i64,
    final_y_i64: i64,
    final_z_i64: i64) -> i64 with Mod {
    let chain_anchor = lorenz_i256_step5_certificate_check(
        dt_q, dt_r,
        dy_scaled_q_i64, dy_scaled_r_i64, xy_scaled_q_i64, xy_scaled_r_i64,
        beta_q_i64, beta_r_i64, x_inc_q_i64, x_inc_r_i64,
        y_inc_q_i64, y_inc_r_i64, z_drop_q_i64, z_drop_r_i64,
        final_x_i64, final_y_i64, final_z_i64)
    if chain_anchor != 23144051 { return 0 - 1 }

    let manifest_fp = lorenz_i256_trajectory5_manifest_fingerprint(
        32, dt_q, dt_r, 5,
        4294967296, 4294967296, 4294967296,
        chain_anchor, 561641681,
        final_x_i64, final_y_i64, final_z_i64)
    if manifest_fp != 214180161 { return 0 - 1 }
    if lorenz_i256_trajectory5_manifest_valid(
        32, dt_q, dt_r, 5, chain_anchor, 561641681,
        manifest_fp) != 1 { return 0 - 1 }

    return manifest_fp
}

pub fn lorenz_i256_trajectory5_projection_inclusion_fingerprint(
    trajectory_manifest_fp: i64,
    final_x_2p32: i64,
    final_y_2p32: i64,
    final_z_2p32: i64,
    scale_log2: i64,
    target_scale: i64,
    x_q: i64,
    x_r: i64,
    y_q: i64,
    y_r: i64,
    z_q: i64,
    z_r: i64,
    x_lo: i64,
    x_hi: i64,
    y_lo: i64,
    y_hi: i64,
    z_lo: i64,
    z_hi: i64) -> i64 with Mod {
    if trajectory_manifest_fp != 214180161 { return 0 - 1 }
    if final_x_2p32 != 5309941770 { return 0 - 1 }
    if final_y_2p32 != 10058731223 { return 0 - 1 }
    if final_z_2p32 != 4084837935 { return 0 - 1 }
    if scale_log2 != 32 { return 0 - 1 }
    if target_scale != 1000000 { return 0 - 1 }
    if x_q != 1236317 { return 0 - 1 }
    if x_r != 687511168 { return 0 - 1 }
    if y_q != 2341980 { return 0 - 1 }
    if y_r != 3715113920 { return 0 - 1 }
    if z_q != 951075 { return 0 - 1 }
    if z_r != 1913956800 { return 0 - 1 }
    if x_lo != 992950 { return 0 - 1 }
    if x_hi != 1479682 { return 0 - 1 }
    if y_lo != 2022339 { return 0 - 1 }
    if y_hi != 2661619 { return 0 - 1 }
    if z_lo != 908630 { return 0 - 1 }
    if z_hi != 993526 { return 0 - 1 }

    let source_scale: i256 = 4294967296 as i256
    let million: i256 = target_scale as i256
    if div_witness_check_i256((final_x_2p32 as i256) * million, source_scale,
                              x_q as i256, x_r as i256) != 1 { return 0 - 1 }
    if div_witness_check_i256((final_y_2p32 as i256) * million, source_scale,
                              y_q as i256, y_r as i256) != 1 { return 0 - 1 }
    if div_witness_check_i256((final_z_2p32 as i256) * million, source_scale,
                              z_q as i256, z_r as i256) != 1 { return 0 - 1 }

    var inclusion_mask: i64 = 0
    if x_q >= x_lo {
        if x_q < x_hi { inclusion_mask = inclusion_mask + 1 }
        if x_q == x_hi {
            if x_r == 0 { inclusion_mask = inclusion_mask + 1 }
        }
    }
    if y_q >= y_lo {
        if y_q < y_hi { inclusion_mask = inclusion_mask + 2 }
        if y_q == y_hi {
            if y_r == 0 { inclusion_mask = inclusion_mask + 2 }
        }
    }
    if z_q >= z_lo {
        if z_q < z_hi { inclusion_mask = inclusion_mask + 4 }
        if z_q == z_hi {
            if z_r == 0 { inclusion_mask = inclusion_mask + 4 }
        }
    }
    if inclusion_mask != 7 { return 0 - 1 }

    var fp: i64 = 251
    fp = lorenz_i256_cert_mix(fp, trajectory_manifest_fp, 2411)
    fp = lorenz_i256_cert_mix(fp, final_x_2p32, 2411)
    fp = lorenz_i256_cert_mix(fp, final_y_2p32, 2411)
    fp = lorenz_i256_cert_mix(fp, final_z_2p32, 2411)
    fp = lorenz_i256_cert_mix(fp, scale_log2, 2411)
    fp = lorenz_i256_cert_mix(fp, target_scale, 2411)
    fp = lorenz_i256_cert_mix(fp, x_q, 2411)
    fp = lorenz_i256_cert_mix(fp, x_r, 2411)
    fp = lorenz_i256_cert_mix(fp, y_q, 2411)
    fp = lorenz_i256_cert_mix(fp, y_r, 2411)
    fp = lorenz_i256_cert_mix(fp, z_q, 2411)
    fp = lorenz_i256_cert_mix(fp, z_r, 2411)
    fp = lorenz_i256_cert_mix(fp, x_lo, 2411)
    fp = lorenz_i256_cert_mix(fp, x_hi, 2411)
    fp = lorenz_i256_cert_mix(fp, y_lo, 2411)
    fp = lorenz_i256_cert_mix(fp, y_hi, 2411)
    fp = lorenz_i256_cert_mix(fp, z_lo, 2411)
    fp = lorenz_i256_cert_mix(fp, z_hi, 2411)
    fp = lorenz_i256_cert_mix(fp, inclusion_mask, 2411)
    return fp
}

