    let bridge_instance_check = lorenz_i256_ball_fixed_bridge_instance_fingerprint(
        32, 4294967296, 1000000, trajectory_manifest_fp,
        final_x_i64, final_y_i64, final_z_i64)
    if bridge_instance_check != bridge_instance_fp { return 0 - 1 }
    if bridge_instance_fp != 149359034 { return 0 - 1 }

    let bridge_certificate_check = lorenz_i256_ball_fixed_bridge_certificate_fingerprint(
        bridge_instance_fp, projection_inclusion_fp, projection_contract_fp,
        final_enclosure_receipt_fp, ball_fixed_enclosure_fp, 7)
    if bridge_certificate_check != bridge_certificate_fp { return 0 - 1 }
    if bridge_certificate_fp != 138609006 { return 0 - 1 }

    let bridge_audit_check = lorenz_i256_ball_fixed_bridge_audit_fingerprint(
        bridge_instance_fp, bridge_certificate_fp,
        326517892, 291678314, 413118064, 31)
    if bridge_audit_check != bridge_audit_fp { return 0 - 1 }
    if bridge_audit_fp != 488107916 { return 0 - 1 }

    let portfolio_v36_readiness_check = solver_portfolio_v36_readiness_fingerprint(
