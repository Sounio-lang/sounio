    var fp: i64 = 383
    fp = lorenz_i256_cert_mix(fp, trajectory_manifest_fp, 2683)
    fp = lorenz_i256_cert_mix(fp, 23144051, 2683)
    fp = lorenz_i256_cert_mix(fp, 561641681, 2683)
    fp = lorenz_i256_cert_mix(fp, projection_inclusion_fp, 2683)
    fp = lorenz_i256_cert_mix(fp, projection_contract_fp, 2683)
    fp = lorenz_i256_cert_mix(fp, projection_div_witness_fp, 2683)
    fp = lorenz_i256_cert_mix(fp, directed_rounding_fp, 2683)
    fp = lorenz_i256_cert_mix(fp, interval_containment_fp, 2683)
