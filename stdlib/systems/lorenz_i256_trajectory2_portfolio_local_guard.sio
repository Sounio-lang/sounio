//! stdlib/systems/lorenz_i256_trajectory2_portfolio_local_guard.sio
//!
//! Local portfolio-local guard (status 122) for the bounded two-step Lorenz
//! manifest lane. This programmatically enforces the no-global-promotion
//! boundary on the dispatch(121) readiness: it requires the dispatch envelope
//! fingerprint (9387383) to be anchored and requires every promotion/claim mask
//! to be zero. Any nonzero promotion mask is rejected (return -1). This is a
//! local no-overclaim safety guard, not portfolio wiring or a theorem promotion.

use systems::lorenz_i256_trajectory2_readiness_dispatch_envelope::*

pub fn lorenz_i256_trajectory2_portfolio_local_scoping_mask(
    dispatch_envelope_fp: i64,
    public_claim_mask: i64,
    global_promotion_ready: i64,
    formal_theorem_ready: i64,
    native_i256_evidence_mask: i64,
    imported_runtime_evidence_mask: i64) -> i64 {
    var mask = 0
    if dispatch_envelope_fp == 9387383 { mask = mask + 1 }
    if public_claim_mask == 0 { mask = mask + 2 }
    if global_promotion_ready == 0 { mask = mask + 4 }
    if formal_theorem_ready == 0 { mask = mask + 8 }
    if native_i256_evidence_mask == 0 { mask = mask + 16 }
    if imported_runtime_evidence_mask == 0 { mask = mask + 32 }
    return mask
}

pub fn lorenz_i256_trajectory2_portfolio_local_guard_fingerprint(
    dispatch_envelope_fp: i64,
    local_scoping_mask: i64,
    checker_family_id: i64,
    checker_kind_id: i64,
    bridge_status: i64,
    public_claim_mask: i64,
    global_promotion_ready: i64,
    formal_theorem_ready: i64,
    target_integer_width: i64,
    limb_base: i64) -> i64 with Div {
    if dispatch_envelope_fp != 9387383 { return 0 - 1 }
    if local_scoping_mask != 63 { return 0 - 1 }
    if checker_family_id != 73 { return 0 - 1 }
    if checker_kind_id != 118 { return 0 - 1 }
    if bridge_status != 122 { return 0 - 1 }
    if public_claim_mask != 0 { return 0 - 1 }
    if global_promotion_ready != 0 { return 0 - 1 }
    if formal_theorem_ready != 0 { return 0 - 1 }
    if target_integer_width != 256 { return 0 - 1 }
    if limb_base != 1000000000 { return 0 - 1 }
    return (dispatch_envelope_fp + (29 * local_scoping_mask) + (31 * checker_family_id) + (37 * checker_kind_id) + (41 * bridge_status)) % limb_base
}

pub fn lorenz_i256_trajectory2_portfolio_local_guard_receipt_check(
    dispatch_anchor_ok: i64,
    local_scoping_ok: i64,
    guard_fp_ok: i64,
    public_claim_mask: i64,
    global_promotion_ready: i64,
    formal_theorem_ready: i64,
    native_i256_evidence_mask: i64,
    imported_runtime_evidence_mask: i64,
    target_integer_width: i64,
    limb_base: i64,
    bridge_status: i64) -> i64 {
    if dispatch_anchor_ok != 1 { return 0 - 1 }
    if local_scoping_ok != 1 { return 0 - 1 }
    if guard_fp_ok != 1 { return 0 - 1 }
    if public_claim_mask != 0 { return 0 - 1 }
    if global_promotion_ready != 0 { return 0 - 1 }
    if formal_theorem_ready != 0 { return 0 - 1 }
    if native_i256_evidence_mask != 0 { return 0 - 1 }
    if imported_runtime_evidence_mask != 0 { return 0 - 1 }
    if target_integer_width != 256 { return 0 - 1 }
    if limb_base != 1000000000 { return 0 - 1 }
    if bridge_status != 122 { return 0 - 1 }
    return 517294038
}
