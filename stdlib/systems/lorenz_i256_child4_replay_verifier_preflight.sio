//! stdlib/systems/lorenz_i256_child4_replay_verifier_preflight.sio
//!
//! Preflight receipt for a future Lorenz i256 child-4 replay verifier. This
//! checks the replay manifest anchors and records which verifier inputs are
//! locally available. It does not execute replay, verify replay, prove boundary
//! gluing, discharge child-4, certify a finite cover, or assert a global Lorenz
//! flowpipe theorem.

pub fn lorenz_i256_cover_child4_replay_verifier_preflight_check(
    replay_manifest_fp: i64,
    replay_manifest_audit_fp: i64,
    solver_profile_bridge_fp: i64,
    solver_profile_bridge_audit_fp: i64,
    solver_proof_profile_fp: i64,
    solver_proof_profile_audit_fp: i64,
    child4_boundary_gluing_input_guard_fp: i64,
    child4_boundary_gluing_input_guard_audit_fp: i64,
    child4_boundary_face_preflight_bundle_fp: i64,
    child4_boundary_face_preflight_bundle_audit_fp: i64,
    solver_domain: i64,
    proof_format: i64,
    replay_manifest_status: i64,
    verifier_preflight_status: i64,
    manifest_focused_gate_mask: i64,
    manifest_offload_review_mask: i64,
    verifier_phase_mask: i64,
    verifier_dependency_mask: i64,
    verifier_input_mask: i64,
    verifier_reject_mask: i64,
    known_failure_mask: i64,
    full_portfolio_green_mask: i64,
    heavy_validation_mask: i64,
    replay_execution_mask: i64,
    replay_verified_mask: i64,
    formal_theorem_ready: i64,
    public_claim_mask: i64,
    global_flowpipe_claim_mask: i64,
    boundary_gluing_proof_mask: i64,
    child4_discharge_mask: i64,
    finite_cover_certificate_mask: i64) -> i64 with Mod {
    var anchor_mask: i64 = 0
    if replay_manifest_fp == 916482305 {
        if replay_manifest_audit_fp == 274650918 {
            anchor_mask = anchor_mask + 1
        }
    }
    if solver_profile_bridge_fp == 784215609 {
        if solver_profile_bridge_audit_fp == 639104872 {
            anchor_mask = anchor_mask + 2
        }
    }
    if solver_proof_profile_fp == 964210753 {
        if solver_proof_profile_audit_fp == 526184309 {
            anchor_mask = anchor_mask + 4
        }
    }
    if child4_boundary_gluing_input_guard_fp == 508913246 {
        if child4_boundary_gluing_input_guard_audit_fp == 672184905 {
            anchor_mask = anchor_mask + 8
        }
    }
    if child4_boundary_face_preflight_bundle_fp == 812640573 {
        if child4_boundary_face_preflight_bundle_audit_fp == 294736811 {
            anchor_mask = anchor_mask + 16
        }
    }
    if solver_domain == 4 { anchor_mask = anchor_mask + 32 }
    if proof_format == 6 { anchor_mask = anchor_mask + 64 }
    if verifier_preflight_status == 91 { anchor_mask = anchor_mask + 128 }

    let verifier_anchor_mask: i64 = 255
    let verifier_status_mask: i64 = 3
    let verifier_available_phase_mask: i64 = 31
    let verifier_required_input_mask: i64 = 31
    let verifier_required_reject_mask: i64 = 63
    let known_imported_native_lowering_failure_mask: i64 = 1
    let no_full_portfolio_evidence_mask: i64 = 0
    let no_heavy_validation_evidence_mask: i64 = 0
    let replay_not_executed_mask: i64 = 0
    let replay_not_verified_mask: i64 = 0
    let public_theorem_ready_mask: i64 = 0
    let global_promotion_ready_mask: i64 = 0
    let verifier_next_action_mask: i64 = 31

    var verifier_ok: i64 = 1
    if replay_manifest_status != 90 { verifier_ok = 0 }
    if verifier_preflight_status != 91 { verifier_ok = 0 }
    if manifest_focused_gate_mask != 15 { verifier_ok = 0 }
    if manifest_offload_review_mask != 3 { verifier_ok = 0 }
    if verifier_phase_mask != 31 { verifier_ok = 0 }
    if verifier_dependency_mask != 31 { verifier_ok = 0 }
    if verifier_input_mask != 31 { verifier_ok = 0 }
    if verifier_reject_mask != 63 { verifier_ok = 0 }
    if known_failure_mask != 1 { verifier_ok = 0 }
    if full_portfolio_green_mask != 0 { verifier_ok = 0 }
    if heavy_validation_mask != 0 { verifier_ok = 0 }
    if replay_execution_mask != 0 { verifier_ok = 0 }
    if replay_verified_mask != 0 { verifier_ok = 0 }
    if verifier_anchor_mask != 255 { verifier_ok = 0 }
    if verifier_status_mask != 3 { verifier_ok = 0 }
    if verifier_available_phase_mask != 31 { verifier_ok = 0 }
    if verifier_required_input_mask != 31 { verifier_ok = 0 }
    if verifier_required_reject_mask != 63 { verifier_ok = 0 }
    if known_imported_native_lowering_failure_mask != 1 { verifier_ok = 0 }
    if no_full_portfolio_evidence_mask != 0 { verifier_ok = 0 }
    if no_heavy_validation_evidence_mask != 0 { verifier_ok = 0 }
    if replay_not_executed_mask != 0 { verifier_ok = 0 }
    if replay_not_verified_mask != 0 { verifier_ok = 0 }
    if public_theorem_ready_mask != 0 { verifier_ok = 0 }
    if global_promotion_ready_mask != 0 { verifier_ok = 0 }
    if verifier_next_action_mask != 31 { verifier_ok = 0 }

    var nonclaim_ok: i64 = 1
    if formal_theorem_ready != 0 { nonclaim_ok = 0 }
    if public_claim_mask != 0 { nonclaim_ok = 0 }
    if global_flowpipe_claim_mask != 0 { nonclaim_ok = 0 }
    if boundary_gluing_proof_mask != 0 { nonclaim_ok = 0 }
    if child4_discharge_mask != 0 { nonclaim_ok = 0 }
    if finite_cover_certificate_mask != 0 { nonclaim_ok = 0 }

    var ok_mask: i64 = 0
    if anchor_mask == 255 { ok_mask = ok_mask + 1 }
    if verifier_ok == 1 { ok_mask = ok_mask + 2 }
    if nonclaim_ok == 1 { ok_mask = ok_mask + 4 }
    if verifier_phase_mask == 31 { ok_mask = ok_mask + 8 }
    if verifier_reject_mask == 63 { ok_mask = ok_mask + 16 }
    if replay_execution_mask == 0 { ok_mask = ok_mask + 32 }
    if replay_verified_mask == 0 { ok_mask = ok_mask + 64 }
    if verifier_preflight_status == 91 { ok_mask = ok_mask + 128 }

    if ok_mask != 255 { return 0 - 1 }
    return 391742608
}

pub fn lorenz_i256_cover_child4_replay_verifier_preflight_audit_fingerprint(
    artifact_fp: i64,
    instance_fp: i64,
    certificate_fp: i64,
    replay_manifest_fp: i64,
    replay_manifest_audit_fp: i64,
    solver_profile_bridge_fp: i64,
    solver_profile_bridge_audit_fp: i64,
    solver_proof_profile_fp: i64,
    solver_proof_profile_audit_fp: i64,
    child4_boundary_gluing_input_guard_fp: i64,
    child4_boundary_gluing_input_guard_audit_fp: i64,
    child4_boundary_face_preflight_bundle_fp: i64,
    child4_boundary_face_preflight_bundle_audit_fp: i64,
    solver_domain: i64,
    proof_format: i64,
    replay_manifest_status: i64,
    verifier_preflight_status: i64,
    manifest_focused_gate_mask: i64,
    manifest_offload_review_mask: i64,
    verifier_phase_mask: i64,
    verifier_dependency_mask: i64,
    verifier_input_mask: i64,
    verifier_reject_mask: i64,
    known_failure_mask: i64,
    full_portfolio_green_mask: i64,
    heavy_validation_mask: i64,
    replay_execution_mask: i64,
    replay_verified_mask: i64,
    verifier_anchor_mask: i64,
    verifier_status_mask: i64,
    verifier_available_phase_mask: i64,
    verifier_required_input_mask: i64,
    verifier_required_reject_mask: i64,
    known_imported_native_lowering_failure_mask: i64,
    no_full_portfolio_evidence_mask: i64,
    no_heavy_validation_evidence_mask: i64,
    replay_not_executed_mask: i64,
    replay_not_verified_mask: i64,
    public_theorem_ready_mask: i64,
    global_promotion_ready_mask: i64,
    verifier_next_action_mask: i64,
    formal_theorem_ready: i64,
    public_claim_mask: i64,
    global_flowpipe_claim_mask: i64,
    boundary_gluing_proof_mask: i64,
    child4_discharge_mask: i64,
    finite_cover_certificate_mask: i64,
    ok_mask: i64) -> i64 with Mod {
    if artifact_fp != 391742608 { return 0 - 1 }
    if instance_fp != 184903726 { return 0 - 1 }
    if certificate_fp != 709561238 { return 0 - 1 }
    if replay_manifest_fp != 916482305 { return 0 - 1 }
    if replay_manifest_audit_fp != 274650918 { return 0 - 1 }
    if solver_profile_bridge_fp != 784215609 { return 0 - 1 }
    if solver_profile_bridge_audit_fp != 639104872 { return 0 - 1 }
    if solver_proof_profile_fp != 964210753 { return 0 - 1 }
    if solver_proof_profile_audit_fp != 526184309 { return 0 - 1 }
    if child4_boundary_gluing_input_guard_fp != 508913246 { return 0 - 1 }
    if child4_boundary_gluing_input_guard_audit_fp != 672184905 { return 0 - 1 }
    if child4_boundary_face_preflight_bundle_fp != 812640573 { return 0 - 1 }
    if child4_boundary_face_preflight_bundle_audit_fp != 294736811 { return 0 - 1 }
    if solver_domain != 4 { return 0 - 1 }
    if proof_format != 6 { return 0 - 1 }
    if replay_manifest_status != 90 { return 0 - 1 }
    if verifier_preflight_status != 91 { return 0 - 1 }
    if manifest_focused_gate_mask != 15 { return 0 - 1 }
    if manifest_offload_review_mask != 3 { return 0 - 1 }
    if verifier_phase_mask != 31 { return 0 - 1 }
    if verifier_dependency_mask != 31 { return 0 - 1 }
    if verifier_input_mask != 31 { return 0 - 1 }
    if verifier_reject_mask != 63 { return 0 - 1 }
    if known_failure_mask != 1 { return 0 - 1 }
    if full_portfolio_green_mask != 0 { return 0 - 1 }
    if heavy_validation_mask != 0 { return 0 - 1 }
    if replay_execution_mask != 0 { return 0 - 1 }
    if replay_verified_mask != 0 { return 0 - 1 }
    if verifier_anchor_mask != 255 { return 0 - 1 }
    if verifier_status_mask != 3 { return 0 - 1 }
    if verifier_available_phase_mask != 31 { return 0 - 1 }
    if verifier_required_input_mask != 31 { return 0 - 1 }
    if verifier_required_reject_mask != 63 { return 0 - 1 }
    if known_imported_native_lowering_failure_mask != 1 { return 0 - 1 }
    if no_full_portfolio_evidence_mask != 0 { return 0 - 1 }
    if no_heavy_validation_evidence_mask != 0 { return 0 - 1 }
    if replay_not_executed_mask != 0 { return 0 - 1 }
    if replay_not_verified_mask != 0 { return 0 - 1 }
    if public_theorem_ready_mask != 0 { return 0 - 1 }
    if global_promotion_ready_mask != 0 { return 0 - 1 }
    if verifier_next_action_mask != 31 { return 0 - 1 }
    if formal_theorem_ready != 0 { return 0 - 1 }
    if public_claim_mask != 0 { return 0 - 1 }
    if global_flowpipe_claim_mask != 0 { return 0 - 1 }
    if boundary_gluing_proof_mask != 0 { return 0 - 1 }
    if child4_discharge_mask != 0 { return 0 - 1 }
    if finite_cover_certificate_mask != 0 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }
    return 650219347
}
