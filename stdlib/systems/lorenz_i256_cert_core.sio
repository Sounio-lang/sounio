pub fn lorenz_i256_taylor_ball_bridge_fingerprint(
    trajectory_manifest_fp: i64,
    dependency_dag_fp: i64,
    final_enclosure_receipt_fp: i64,
    ball_fixed_enclosure_fp: i64,
    range_budget_fp: i64,
    roundoff_budget_fp: i64,
    projection_margin_budget_fp: i64,
    scale: i64,
    step_count: i64,
    taylor_order: i64,
    dt_num: i64,
    dt_den: i64,
    source_integer_bits: i64,
    source_scale_log2: i64,
    bit_headroom: i64,
    final_xr: i64,
    final_yr: i64,
    final_zr: i64,
    x_radius_cap: i64,
    y_radius_cap: i64,
    z_radius_cap: i64,
    bridge_mask: i64) -> i64 with Mod {
    if trajectory_manifest_fp != 214180161 { return 0 - 1 }
    if dependency_dag_fp != 713010204 { return 0 - 1 }
    if final_enclosure_receipt_fp != 114244647 { return 0 - 1 }
    if ball_fixed_enclosure_fp != 166945519 { return 0 - 1 }
    if range_budget_fp != 87220662 { return 0 - 1 }
    if roundoff_budget_fp != 677514412 { return 0 - 1 }
    if projection_margin_budget_fp != 69322697 { return 0 - 1 }
    if scale != 1000000 { return 0 - 1 }
    if step_count != 5 { return 0 - 1 }
    if taylor_order != 2 { return 0 - 1 }
    if dt_num != 1 { return 0 - 1 }
    if dt_den != 100 { return 0 - 1 }
    if source_integer_bits != 256 { return 0 - 1 }
    if source_scale_log2 != 32 { return 0 - 1 }
    if bit_headroom != 184 { return 0 - 1 }
    if final_xr != 243366 { return 0 - 1 }
    if final_yr != 319640 { return 0 - 1 }
    if final_zr != 42448 { return 0 - 1 }
    if x_radius_cap != 250000 { return 0 - 1 }
    if y_radius_cap != 325000 { return 0 - 1 }
    if z_radius_cap != 50000 { return 0 - 1 }
    if bridge_mask != 127 { return 0 - 1 }

    let x_slack: i64 = x_radius_cap - final_xr
    let y_slack: i64 = y_radius_cap - final_yr
    let z_slack: i64 = z_radius_cap - final_zr
    let radius_sum: i64 = final_xr + final_yr + final_zr
    if x_slack != 6634 { return 0 - 1 }
    if y_slack != 5360 { return 0 - 1 }
    if z_slack != 7552 { return 0 - 1 }
    if radius_sum != 605454 { return 0 - 1 }

    var fp: i64 = 467
    fp = lorenz_i256_cert_mix(fp, trajectory_manifest_fp, 2903)
    fp = lorenz_i256_cert_mix(fp, dependency_dag_fp, 2903)
    fp = lorenz_i256_cert_mix(fp, final_enclosure_receipt_fp, 2903)
    fp = lorenz_i256_cert_mix(fp, ball_fixed_enclosure_fp, 2903)
    fp = lorenz_i256_cert_mix(fp, range_budget_fp, 2903)
    fp = lorenz_i256_cert_mix(fp, roundoff_budget_fp, 2903)
    fp = lorenz_i256_cert_mix(fp, projection_margin_budget_fp, 2903)
    fp = lorenz_i256_cert_mix(fp, scale, 2903)
    fp = lorenz_i256_cert_mix(fp, step_count, 2903)
    fp = lorenz_i256_cert_mix(fp, taylor_order, 2903)
    fp = lorenz_i256_cert_mix(fp, dt_num, 2903)
    fp = lorenz_i256_cert_mix(fp, dt_den, 2903)
    fp = lorenz_i256_cert_mix(fp, source_integer_bits, 2903)
    fp = lorenz_i256_cert_mix(fp, source_scale_log2, 2903)
    fp = lorenz_i256_cert_mix(fp, bit_headroom, 2903)
    fp = lorenz_i256_cert_mix(fp, final_xr, 2903)
    fp = lorenz_i256_cert_mix(fp, final_yr, 2903)
    fp = lorenz_i256_cert_mix(fp, final_zr, 2903)
    fp = lorenz_i256_cert_mix(fp, x_radius_cap, 2903)
    fp = lorenz_i256_cert_mix(fp, y_radius_cap, 2903)
    fp = lorenz_i256_cert_mix(fp, z_radius_cap, 2903)
    fp = lorenz_i256_cert_mix(fp, x_slack, 2903)
    fp = lorenz_i256_cert_mix(fp, y_slack, 2903)
    fp = lorenz_i256_cert_mix(fp, z_slack, 2903)
    fp = lorenz_i256_cert_mix(fp, radius_sum, 2903)
    fp = lorenz_i256_cert_mix(fp, bridge_mask, 2903)
    return fp
}

