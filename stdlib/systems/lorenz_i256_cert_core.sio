pub fn lorenz_i256_five_step_local_flowpipe_chain_check(
    step1_local_flowpipe_proof_fp: i64,
    step1_local_flowpipe_proof_audit_fp: i64,
    step2_local_flowpipe_proof_fp: i64,
    step2_local_flowpipe_proof_audit_fp: i64,
    step3_local_flowpipe_proof_fp: i64,
    step3_local_flowpipe_proof_audit_fp: i64,
    step4_local_flowpipe_proof_fp: i64,
    step4_local_flowpipe_proof_audit_fp: i64,
    step5_local_flowpipe_proof_fp: i64,
    step5_local_flowpipe_proof_audit_fp: i64,
    step1_step2_bridge_fp: i64,
    step1_step2_bridge_audit_fp: i64,
    step2_step3_bridge_fp: i64,
