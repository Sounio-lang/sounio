pub fn lorenz_i256_finite_cover_candidate_check(
    preflight_fp: i64,
    preflight_audit_fp: i64,
    v148_portfolio_entry_fp: i64,
    v148_manifest_fp: i64,
    v148_readiness_fp: i64,
    projection_certificate_envelope_fp: i64,
    projection_certificate_envelope_audit_fp: i64,
    dependency_dag_fp: i64,
    dependency_dag_audit_fp: i64,
    v38_readiness_fp: i64,
    trajectory5_manifest_fp: i64,
    final_enclosure_receipt_fp: i64,
    ball_fixed_enclosure_fp: i64,
    range_budget_fp: i64,
    roundoff_budget_fp: i64,
    projection_margin_budget_fp: i64,
    five_step_local_chain_fp: i64,
    five_step_local_chain_audit_fp: i64,
    global_flowpipe_claim_mask: i64,
    candidate_status: i64) -> i64 with Mod {
    var finite_cover_candidate_mask: i64 = 0
    if preflight_fp == 461075499 {
        if preflight_audit_fp == 641858696 {
            if v148_portfolio_entry_fp == 467412992 {
                if v148_manifest_fp == 978167597 {
                    if v148_readiness_fp == 329959989 { finite_cover_candidate_mask = finite_cover_candidate_mask + 1 }
                }
            }
        }
    }
    if projection_certificate_envelope_fp == 77888110 {
        if projection_certificate_envelope_audit_fp == 245178976 { finite_cover_candidate_mask = finite_cover_candidate_mask + 2 }
    }
    if dependency_dag_fp == 713010204 {
        if dependency_dag_audit_fp == 725222703 {
            if v38_readiness_fp == 845057161 { finite_cover_candidate_mask = finite_cover_candidate_mask + 4 }
        }
    }
    if final_enclosure_receipt_fp == 114244647 {
        if ball_fixed_enclosure_fp == 166945519 {
            if range_budget_fp == 87220662 {
                if roundoff_budget_fp == 677514412 {
                    if projection_margin_budget_fp == 69322697 { finite_cover_candidate_mask = finite_cover_candidate_mask + 8 }
                }
            }
        }
    }
    if five_step_local_chain_fp == 911209450 {
        if five_step_local_chain_audit_fp == 709377850 {
            if trajectory5_manifest_fp == 214180161 { finite_cover_candidate_mask = finite_cover_candidate_mask + 16 }
        }
    }

    let global_cover_certificate_mask: i64 = 0
    let candidate_cell_count: i64 = 1
    let covered_cell_count: i64 = 1
    let source_width_bits: i64 = 256
    let scale_log2: i64 = 32
    let target_scale: i64 = 1000000
    let step_count: i64 = 5
    let selected_dt_num: i64 = 1
    let selected_dt_den: i64 = 100
    let candidate_version: i64 = 1

    var nonclaim_ok: i64 = 1
    if global_cover_certificate_mask != 0 { nonclaim_ok = 0 }
    if global_flowpipe_claim_mask != 0 { nonclaim_ok = 0 }
    if candidate_status != 28 { nonclaim_ok = 0 }

    var cell_ok: i64 = 1
    if candidate_cell_count != 1 { cell_ok = 0 }
    if covered_cell_count != 1 { cell_ok = 0 }

    var contract_ok: i64 = 1
    if source_width_bits != 256 { contract_ok = 0 }
    if scale_log2 != 32 { contract_ok = 0 }
    if target_scale != 1000000 { contract_ok = 0 }
    if step_count != 5 { contract_ok = 0 }
    if selected_dt_num != 1 { contract_ok = 0 }
    if selected_dt_den != 100 { contract_ok = 0 }

    var ok_mask: i64 = 0
    if finite_cover_candidate_mask == 31 { ok_mask = ok_mask + 1 }
    if global_cover_certificate_mask == 0 { ok_mask = ok_mask + 2 }
    if global_flowpipe_claim_mask == 0 { ok_mask = ok_mask + 4 }
    if nonclaim_ok == 1 { ok_mask = ok_mask + 8 }
    if cell_ok == 1 { ok_mask = ok_mask + 16 }
    if contract_ok == 1 { ok_mask = ok_mask + 32 }
    if preflight_fp == 461075499 { ok_mask = ok_mask + 64 }
    if projection_certificate_envelope_fp == 77888110 { ok_mask = ok_mask + 128 }
    if ok_mask != 255 { return 0 - 1 }

    let instance_fp = lorenz_i256_finite_cover_candidate_instance_fingerprint(
        preflight_fp, preflight_audit_fp, v148_portfolio_entry_fp,
        v148_manifest_fp, v148_readiness_fp, projection_certificate_envelope_fp,
        projection_certificate_envelope_audit_fp, dependency_dag_fp,
        dependency_dag_audit_fp, v38_readiness_fp, trajectory5_manifest_fp,
        final_enclosure_receipt_fp, ball_fixed_enclosure_fp, range_budget_fp,
        roundoff_budget_fp, projection_margin_budget_fp, five_step_local_chain_fp,
        five_step_local_chain_audit_fp, candidate_cell_count, covered_cell_count,
        source_width_bits, scale_log2, target_scale, step_count,
        selected_dt_num, selected_dt_den, finite_cover_candidate_mask,
        global_cover_certificate_mask, global_flowpipe_claim_mask,
        candidate_status)
    let certificate_fp = lorenz_i256_finite_cover_candidate_certificate_fingerprint(
        instance_fp, finite_cover_candidate_mask, global_cover_certificate_mask,
        global_flowpipe_claim_mask, candidate_cell_count, covered_cell_count,
        candidate_version, candidate_status, ok_mask)

    return lorenz_i256_finite_cover_candidate_fingerprint(
        instance_fp, certificate_fp, 20, candidate_cell_count,
        finite_cover_candidate_mask, global_cover_certificate_mask,
        global_flowpipe_claim_mask, candidate_status, ok_mask)
}

