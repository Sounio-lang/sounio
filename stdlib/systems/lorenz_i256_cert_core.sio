pub fn lorenz_i256_cert_mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

pub fn lorenz_i256_cert_ready() -> i64 {
    return 1
}

pub fn lorenz_i256_five_step_chain_fingerprint(step_count: i64,
                                               step1_certificate_fp: i64,
                                               step2_certificate_fp: i64,
                                               step3_certificate_fp: i64,
                                               step4_certificate_fp: i64,
                                               step5_certificate_fp: i64,
                                               final_x: i64,
                                               final_y: i64,
                                               final_z: i64) -> i64 with Mod {
    if step_count != 5 { return 0 - 1 }
    if step1_certificate_fp != 510854875 { return 0 - 1 }
    if step2_certificate_fp != 899209716 { return 0 - 1 }
    if step3_certificate_fp != 603078026 { return 0 - 1 }
    if step4_certificate_fp != 753371133 { return 0 - 1 }
    if step5_certificate_fp != 561641681 { return 0 - 1 }
    if final_x != 5309941770 { return 0 - 1 }
    if final_y != 10058731223 { return 0 - 1 }
    if final_z != 4084837935 { return 0 - 1 }

    var fp: i64 = 239
    fp = lorenz_i256_cert_mix(fp, step_count, 1613)
    fp = lorenz_i256_cert_mix(fp, step1_certificate_fp, 1613)
    fp = lorenz_i256_cert_mix(fp, step2_certificate_fp, 1613)
    fp = lorenz_i256_cert_mix(fp, step3_certificate_fp, 1613)
    fp = lorenz_i256_cert_mix(fp, step4_certificate_fp, 1613)
    fp = lorenz_i256_cert_mix(fp, step5_certificate_fp, 1613)
    fp = lorenz_i256_cert_mix(fp, final_x, 1613)
    fp = lorenz_i256_cert_mix(fp, final_y, 1613)
    fp = lorenz_i256_cert_mix(fp, final_z, 1613)
    return fp
}

