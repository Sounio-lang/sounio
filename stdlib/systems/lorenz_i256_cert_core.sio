    step3_step4_bridge_audit_fp: i64,
    step4_step5_bridge_fp: i64,
    step4_step5_bridge_audit_fp: i64,
    trajectory5_manifest_fp: i64,
    five_step_chain_anchor_fp: i64,
    step5_certificate_fp: i64,
    global_flowpipe_claim_mask: i64,
    chain_status: i64) -> i64 with Mod {
    var local_proof_chain_mask: i64 = 0
    if step1_local_flowpipe_proof_fp == 908974219 {
        if step1_local_flowpipe_proof_audit_fp == 890221848 { local_proof_chain_mask = local_proof_chain_mask + 1 }
    }
    if step2_local_flowpipe_proof_fp == 418029869 {
        if step2_local_flowpipe_proof_audit_fp == 518930343 { local_proof_chain_mask = local_proof_chain_mask + 2 }
    }
    if step3_local_flowpipe_proof_fp == 78860411 {
        if step3_local_flowpipe_proof_audit_fp == 972719127 { local_proof_chain_mask = local_proof_chain_mask + 4 }
    }
    if step4_local_flowpipe_proof_fp == 354200144 {
        if step4_local_flowpipe_proof_audit_fp == 97568991 { local_proof_chain_mask = local_proof_chain_mask + 8 }
    }
    if step5_local_flowpipe_proof_fp == 965829478 {
        if step5_local_flowpipe_proof_audit_fp == 618466007 { local_proof_chain_mask = local_proof_chain_mask + 16 }
    }

    var bridge_chain_mask: i64 = 0
    if step1_step2_bridge_fp == 595466240 {
        if step1_step2_bridge_audit_fp == 382059454 { bridge_chain_mask = bridge_chain_mask + 1 }
    }
    if step2_step3_bridge_fp == 158202075 {
        if step2_step3_bridge_audit_fp == 952956886 { bridge_chain_mask = bridge_chain_mask + 2 }
    }
    if step3_step4_bridge_fp == 692714944 {
        if step3_step4_bridge_audit_fp == 627937430 { bridge_chain_mask = bridge_chain_mask + 4 }
    }
    if step4_step5_bridge_fp == 880867663 {
        if step4_step5_bridge_audit_fp == 674753000 { bridge_chain_mask = bridge_chain_mask + 8 }
    }

    var chain_anchor_mask: i64 = 0
    if trajectory5_manifest_fp == 214180161 { chain_anchor_mask = chain_anchor_mask + 1 }
    if five_step_chain_anchor_fp == 23144051 { chain_anchor_mask = chain_anchor_mask + 2 }
    if step5_certificate_fp == 561641681 { chain_anchor_mask = chain_anchor_mask + 4 }

    let step_count: i64 = 5
    let bridge_count: i64 = 4
    let source_width_bits: i64 = 256
    let scale_log2: i64 = 32
    let selected_dt_num: i64 = 1
    let selected_dt_den: i64 = 100
    let adjacency_chain_mask: i64 = bridge_chain_mask

    var chain_composition_mask: i64 = 0
