//! stdlib/systems/lorenz_i256_trajectory2_certificate_bounded_bridge.sio
//!
//! Compact certificate fingerprinting for bounded two-step Lorenz replay over
//! decimal i256-like limbs. The certificate fingerprint is emitted only after
//! the supplied trajectory replays exactly.

use systems::lorenz_i256_trajectory2_replay_bounded_bridge::*

pub fn lorenz_i256_trajectory2_certificate_limb_base() -> i64 { return 1000000000 }

fn lorenz_i256_trajectory2_certificate_limb_ok(x: i64) -> i64 {
    if x < 0 { return 0 }
    if x >= lorenz_i256_trajectory2_certificate_limb_base() { return 0 }
    return 1
}

pub fn lorenz_i256_trajectory2_certificate_axis_fingerprint(
    l0: i64,
    l1: i64,
    l2: i64,
    l3: i64) -> i64 with Div {
    if lorenz_i256_trajectory2_certificate_limb_ok(l0) != 1 { return 0 - 1 }
    if lorenz_i256_trajectory2_certificate_limb_ok(l1) != 1 { return 0 - 1 }
    if lorenz_i256_trajectory2_certificate_limb_ok(l2) != 1 { return 0 - 1 }
    if lorenz_i256_trajectory2_certificate_limb_ok(l3) != 1 { return 0 - 1 }
    let base = lorenz_i256_trajectory2_certificate_limb_base()
    return (l0 + (17 * l1) + (31 * l2) + (43 * l3)) % base
}

pub fn lorenz_i256_trajectory2_certificate_state_fingerprint(
    state_index: i64,
    x0: i64,
    x1: i64,
    x2: i64,
    x3: i64,
    y0: i64,
    y1: i64,
    y2: i64,
    y3: i64,
    z0: i64,
    z1: i64,
    z2: i64,
    z3: i64) -> i64 with Div {
    if state_index < 0 { return 0 - 1 }
    if state_index > 2 { return 0 - 1 }
    let xf = lorenz_i256_trajectory2_certificate_axis_fingerprint(x0, x1, x2, x3)
    let yf = lorenz_i256_trajectory2_certificate_axis_fingerprint(y0, y1, y2, y3)
    let zf = lorenz_i256_trajectory2_certificate_axis_fingerprint(z0, z1, z2, z3)
    if xf < 0 { return 0 - 1 }
    if yf < 0 { return 0 - 1 }
    if zf < 0 { return 0 - 1 }
    let base = lorenz_i256_trajectory2_certificate_limb_base()
    return ((1000003 * state_index) + (3 * xf) + (5 * yf) + (7 * zf)) % base
}

pub fn lorenz_i256_trajectory2_certificate_fingerprint(
    x0: i64,
    x1: i64,
    x2: i64,
    x3: i64,
    y0: i64,
    y1: i64,
    y2: i64,
    y3: i64,
    z0: i64,
    z1: i64,
    z2: i64,
    z3: i64,
    s1x0: i64,
    s1x1: i64,
    s1x2: i64,
    s1x3: i64,
    s1y0: i64,
    s1y1: i64,
    s1y2: i64,
    s1y3: i64,
    s1z0: i64,
    s1z1: i64,
    s1z2: i64,
    s1z3: i64,
    s2x0: i64,
    s2x1: i64,
    s2x2: i64,
    s2x3: i64,
    s2y0: i64,
    s2y1: i64,
    s2y2: i64,
    s2y3: i64,
    s2z0: i64,
    s2z1: i64,
    s2z2: i64,
    s2z3: i64) -> i64 with Div {
    let replay_ok = lorenz_i256_trajectory2_replay_bounded_check(
        x0, x1, x2, x3, y0, y1, y2, y3, z0, z1, z2, z3,
        s1x0, s1x1, s1x2, s1x3, s1y0, s1y1, s1y2, s1y3, s1z0, s1z1, s1z2, s1z3,
        s2x0, s2x1, s2x2, s2x3, s2y0, s2y1, s2y2, s2y3, s2z0, s2z1, s2z2, s2z3)
    if replay_ok != 1 { return 0 - 1 }

    let f0 = lorenz_i256_trajectory2_certificate_state_fingerprint(0, x0, x1, x2, x3, y0, y1, y2, y3, z0, z1, z2, z3)
    let f1 = lorenz_i256_trajectory2_certificate_state_fingerprint(1, s1x0, s1x1, s1x2, s1x3, s1y0, s1y1, s1y2, s1y3, s1z0, s1z1, s1z2, s1z3)
    let f2 = lorenz_i256_trajectory2_certificate_state_fingerprint(2, s2x0, s2x1, s2x2, s2x3, s2y0, s2y1, s2y2, s2y3, s2z0, s2z1, s2z2, s2z3)
    if f0 < 0 { return 0 - 1 }
    if f1 < 0 { return 0 - 1 }
    if f2 < 0 { return 0 - 1 }
    let base = lorenz_i256_trajectory2_certificate_limb_base()
    return (734260981 + (11 * f0) + (13 * f1) + (17 * f2)) % base
}

pub fn lorenz_i256_trajectory2_certificate_bounded_bridge_receipt_check(
    state0_fingerprint_ok: i64,
    state1_fingerprint_ok: i64,
    state2_fingerprint_ok: i64,
    certificate_fingerprint_ok: i64,
    mismatch_rejected: i64,
    invalid_limb_rejected: i64,
    replay_anchor_ok: i64,
    target_integer_width: i64,
    limb_base: i64,
    native_i256_evidence_mask: i64,
    imported_runtime_evidence_mask: i64,
    bridge_status: i64) -> i64 {
    if state0_fingerprint_ok != 1 { return 0 - 1 }
    if state1_fingerprint_ok != 1 { return 0 - 1 }
    if state2_fingerprint_ok != 1 { return 0 - 1 }
    if certificate_fingerprint_ok != 1 { return 0 - 1 }
    if mismatch_rejected != 1 { return 0 - 1 }
    if invalid_limb_rejected != 1 { return 0 - 1 }
    if replay_anchor_ok != 1 { return 0 - 1 }
    if target_integer_width != 256 { return 0 - 1 }
    if limb_base != 1000000000 { return 0 - 1 }
    if native_i256_evidence_mask != 0 { return 0 - 1 }
    if imported_runtime_evidence_mask != 0 { return 0 - 1 }
    if bridge_status != 118 { return 0 - 1 }
    return 918274650
}

pub fn lorenz_i256_trajectory2_certificate_bounded_bridge_audit_fingerprint(
    artifact_fp: i64,
    instance_fp: i64,
    certificate_fp: i64,
    replay_fp: i64,
    replay_audit_fp: i64,
    trajectory_certificate_fp: i64,
    state0_fp: i64,
    state1_fp: i64,
    state2_fp: i64,
    state0_fingerprint_ok: i64,
    state1_fingerprint_ok: i64,
    state2_fingerprint_ok: i64,
    certificate_fingerprint_ok: i64,
    mismatch_rejected: i64,
    invalid_limb_rejected: i64,
    target_integer_width: i64,
    limb_base: i64,
    native_i256_evidence_mask: i64,
    imported_runtime_evidence_mask: i64,
    public_claim_mask: i64,
    formal_theorem_ready: i64,
    bridge_status: i64,
    ok_mask: i64) -> i64 {
    if artifact_fp != 918274650 { return 0 - 1 }
    if instance_fp != 675230419 { return 0 - 1 }
    if certificate_fp != 208746531 { return 0 - 1 }
    if replay_fp != 734260981 { return 0 - 1 }
    if replay_audit_fp != 605913274 { return 0 - 1 }
    if trajectory_certificate_fp != 657108232 { return 0 - 1 }
    if state0_fp != 250000085 { return 0 - 1 }
    if state1_fp != 626001669 { return 0 - 1 }
    if state2_fp != 2048507 { return 0 - 1 }
    if state0_fingerprint_ok != 1 { return 0 - 1 }
    if state1_fingerprint_ok != 1 { return 0 - 1 }
    if state2_fingerprint_ok != 1 { return 0 - 1 }
    if certificate_fingerprint_ok != 1 { return 0 - 1 }
    if mismatch_rejected != 1 { return 0 - 1 }
    if invalid_limb_rejected != 1 { return 0 - 1 }
    if target_integer_width != 256 { return 0 - 1 }
    if limb_base != 1000000000 { return 0 - 1 }
    if native_i256_evidence_mask != 0 { return 0 - 1 }
    if imported_runtime_evidence_mask != 0 { return 0 - 1 }
    if public_claim_mask != 0 { return 0 - 1 }
    if formal_theorem_ready != 0 { return 0 - 1 }
    if bridge_status != 118 { return 0 - 1 }
    if ok_mask != 4095 { return 0 - 1 }
    return 341902786
}
