//! stdlib/systems/lorenz_i256_child4_obligation_seed.sio
//!
//! Child-4 obligation seed for the Lorenz i256 cover lane.
//! This selects the next child cell after the child-3 discharge preflight. It is
//! an obligation seed only, not child-4 validation or discharge.

pub fn lorenz_i256_cover_child4_obligation_seed_check(
    child3_discharge_preflight_fp: i64,
    child3_discharge_preflight_audit_fp: i64,
    child3_validation_core_fp: i64,
    child3_validation_core_audit_fp: i64,
    child_index: i64,
    slot_x: i64,
    slot_y: i64,
    slot_z: i64,
    global_flowpipe_claim_mask: i64,
    seed_status: i64) -> i64 with Mod {
    var inherited_anchor_mask: i64 = 0
    if child3_discharge_preflight_fp == 57643306 {
        if child3_discharge_preflight_audit_fp == 784781218 {
            inherited_anchor_mask = inherited_anchor_mask + 1
        }
    }
    if child3_validation_core_fp == 686090643 {
        if child3_validation_core_audit_fp == 159869521 {
            inherited_anchor_mask = inherited_anchor_mask + 2
        }
    }
    if child_index == 4 { inherited_anchor_mask = inherited_anchor_mask + 4 }
    if seed_status == 72 { inherited_anchor_mask = inherited_anchor_mask + 8 }

    let split_axis_count: i64 = 3
    let split_factor_per_axis: i64 = 2
    let child_cell_count: i64 = 8
    let selected_child_count: i64 = 1
    let pending_child_obligation_count: i64 = 8
    let resolved_child_count: i64 = 0
    let selected_child_mask: i64 = 16
    let child_coordinate_mask: i64 = 7
    let prior_child_validated_mask: i64 = 15
    let pending_child_validation_mask: i64 = 16
    let local_flowpipe_proof_mask: i64 = 0
    let child_validated_mask: i64 = 0
    let child_discharge_mask: i64 = 0
    let global_cover_certificate_mask: i64 = 0

    var child_shape_ok: i64 = 1
    if slot_x != 0 { child_shape_ok = 0 }
    if slot_y != 0 { child_shape_ok = 0 }
    if slot_z != 1 { child_shape_ok = 0 }
    if split_axis_count != 3 { child_shape_ok = 0 }
    if split_factor_per_axis != 2 { child_shape_ok = 0 }
    if child_cell_count != 8 { child_shape_ok = 0 }
    if selected_child_count != 1 { child_shape_ok = 0 }
    if pending_child_obligation_count != 8 { child_shape_ok = 0 }
    if resolved_child_count != 0 { child_shape_ok = 0 }
    if selected_child_mask != 16 { child_shape_ok = 0 }
    if child_coordinate_mask != 7 { child_shape_ok = 0 }

    var inherited_ok: i64 = 1
    if inherited_anchor_mask != 15 { inherited_ok = 0 }
    if prior_child_validated_mask != 15 { inherited_ok = 0 }
    if pending_child_validation_mask != 16 { inherited_ok = 0 }

    var nonclaim_ok: i64 = 1
    if local_flowpipe_proof_mask != 0 { nonclaim_ok = 0 }
    if child_validated_mask != 0 { nonclaim_ok = 0 }
    if child_discharge_mask != 0 { nonclaim_ok = 0 }
    if global_cover_certificate_mask != 0 { nonclaim_ok = 0 }
    if global_flowpipe_claim_mask != 0 { nonclaim_ok = 0 }

    var ok_mask: i64 = 0
    if child_shape_ok == 1 { ok_mask = ok_mask + 1 }
    if inherited_ok == 1 { ok_mask = ok_mask + 2 }
    if nonclaim_ok == 1 { ok_mask = ok_mask + 4 }
    if child_index == 4 { ok_mask = ok_mask + 8 }
    if selected_child_mask == 16 { ok_mask = ok_mask + 16 }
    if prior_child_validated_mask == 15 { ok_mask = ok_mask + 32 }
    if pending_child_validation_mask == 16 { ok_mask = ok_mask + 64 }
    if seed_status == 72 { ok_mask = ok_mask + 128 }

    if ok_mask != 255 { return 0 - 1 }
    return 17166205
}

pub fn lorenz_i256_cover_child4_obligation_seed_audit_fingerprint(
    artifact_fp: i64,
    instance_fp: i64,
    certificate_fp: i64,
    child3_discharge_preflight_fp: i64,
    child3_discharge_preflight_audit_fp: i64,
    child3_validation_core_fp: i64,
    child3_validation_core_audit_fp: i64,
    child_index: i64,
    slot_x: i64,
    slot_y: i64,
    slot_z: i64,
    selected_child_mask: i64,
    prior_child_validated_mask: i64,
    pending_child_validation_mask: i64,
    local_flowpipe_proof_mask: i64,
    child_validated_mask: i64,
    child_discharge_mask: i64,
    global_cover_certificate_mask: i64,
    global_flowpipe_claim_mask: i64,
    seed_status: i64,
    ok_mask: i64) -> i64 with Mod {
    if artifact_fp != 17166205 { return 0 - 1 }
    if instance_fp != 75459241 { return 0 - 1 }
    if certificate_fp != 224045073 { return 0 - 1 }
    if child3_discharge_preflight_fp != 57643306 { return 0 - 1 }
    if child3_discharge_preflight_audit_fp != 784781218 { return 0 - 1 }
    if child3_validation_core_fp != 686090643 { return 0 - 1 }
    if child3_validation_core_audit_fp != 159869521 { return 0 - 1 }
    if child_index != 4 { return 0 - 1 }
    if slot_x != 0 { return 0 - 1 }
    if slot_y != 0 { return 0 - 1 }
    if slot_z != 1 { return 0 - 1 }
    if selected_child_mask != 16 { return 0 - 1 }
    if prior_child_validated_mask != 15 { return 0 - 1 }
    if pending_child_validation_mask != 16 { return 0 - 1 }
    if local_flowpipe_proof_mask != 0 { return 0 - 1 }
    if child_validated_mask != 0 { return 0 - 1 }
    if child_discharge_mask != 0 { return 0 - 1 }
    if global_cover_certificate_mask != 0 { return 0 - 1 }
    if global_flowpipe_claim_mask != 0 { return 0 - 1 }
    if seed_status != 72 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }
    return 78794130
}
