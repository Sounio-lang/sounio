//! stdlib/systems/lorenz_i256_trajectory2_acceptance_bounded_bridge.sio
//!
//! Local acceptance envelope for the bounded two-step Lorenz manifest lane.
//! This is a solver-router readiness receipt, not portfolio wiring or a global
//! theorem promotion.

use systems::lorenz_i256_trajectory2_manifest_bounded_bridge::*

pub fn lorenz_i256_trajectory2_acceptance_bounded_mask(
    manifest_fp: i64,
    certificate_gate_ok: i64,
    checker_family_id: i64,
    checker_kind_id: i64,
    native_i256_evidence_mask: i64,
    imported_runtime_evidence_mask: i64,
    public_claim_mask: i64,
    formal_theorem_ready: i64) -> i64 {
    var mask = 0
    if manifest_fp == 294601254 { mask = mask + 1 }
    if certificate_gate_ok == 1 { mask = mask + 2 }
    if checker_family_id == 73 { mask = mask + 4 }
    if checker_kind_id == 118 { mask = mask + 8 }
    if native_i256_evidence_mask == 0 {
        if imported_runtime_evidence_mask == 0 {
            if public_claim_mask == 0 {
                if formal_theorem_ready == 0 { mask = mask + 16 }
            }
        }
    }
    return mask
}

pub fn lorenz_i256_trajectory2_acceptance_bounded_readiness_fingerprint(
    manifest_fp: i64,
    manifest_artifact_fp: i64,
    certificate_bridge_fp: i64,
    acceptance_mask: i64,
    checker_family_id: i64,
    checker_kind_id: i64,
    bridge_status: i64,
    target_integer_width: i64,
    limb_base: i64) -> i64 with Div {
    if manifest_fp != 294601254 { return 0 - 1 }
    if manifest_artifact_fp != 846135279 { return 0 - 1 }
    if certificate_bridge_fp != 918274650 { return 0 - 1 }
    if acceptance_mask != 31 { return 0 - 1 }
    if checker_family_id != 73 { return 0 - 1 }
    if checker_kind_id != 118 { return 0 - 1 }
    if bridge_status != 120 { return 0 - 1 }
    if target_integer_width != 256 { return 0 - 1 }
    if limb_base != 1000000000 { return 0 - 1 }
    return (manifest_artifact_fp + (7 * manifest_fp) + (11 * certificate_bridge_fp) + (13 * acceptance_mask) + (17 * checker_family_id) + (19 * checker_kind_id) + (23 * bridge_status)) % limb_base
}

pub fn lorenz_i256_trajectory2_acceptance_bounded_bridge_receipt_check(
    manifest_anchor_ok: i64,
    certificate_gate_ok: i64,
    acceptance_mask_ok: i64,
    readiness_fingerprint_ok: i64,
    metadata_rejection_ok: i64,
    claim_masks_zero_ok: i64,
    target_integer_width: i64,
    limb_base: i64,
    native_i256_evidence_mask: i64,
    imported_runtime_evidence_mask: i64,
    bridge_status: i64) -> i64 {
    if manifest_anchor_ok != 1 { return 0 - 1 }
    if certificate_gate_ok != 1 { return 0 - 1 }
    if acceptance_mask_ok != 1 { return 0 - 1 }
    if readiness_fingerprint_ok != 1 { return 0 - 1 }
    if metadata_rejection_ok != 1 { return 0 - 1 }
    if claim_masks_zero_ok != 1 { return 0 - 1 }
    if target_integer_width != 256 { return 0 - 1 }
    if limb_base != 1000000000 { return 0 - 1 }
    if native_i256_evidence_mask != 0 { return 0 - 1 }
    if imported_runtime_evidence_mask != 0 { return 0 - 1 }
    if bridge_status != 120 { return 0 - 1 }
    return 769418205
}

pub fn lorenz_i256_trajectory2_acceptance_bounded_bridge_audit_fingerprint(
    artifact_fp: i64,
    instance_fp: i64,
    certificate_fp: i64,
    manifest_artifact_fp: i64,
    manifest_audit_fp: i64,
    manifest_fp: i64,
    certificate_bridge_fp: i64,
    readiness_fp: i64,
    acceptance_mask: i64,
    checker_family_id: i64,
    checker_kind_id: i64,
    manifest_anchor_ok: i64,
    certificate_gate_ok: i64,
    acceptance_mask_ok: i64,
    readiness_fingerprint_ok: i64,
    metadata_rejection_ok: i64,
    claim_masks_zero_ok: i64,
    target_integer_width: i64,
    limb_base: i64,
    native_i256_evidence_mask: i64,
    imported_runtime_evidence_mask: i64,
    public_claim_mask: i64,
    formal_theorem_ready: i64,
    bridge_status: i64,
    ok_mask: i64) -> i64 {
    if artifact_fp != 769418205 { return 0 - 1 }
    if instance_fp != 926035714 { return 0 - 1 }
    if certificate_fp != 158407263 { return 0 - 1 }
    if manifest_artifact_fp != 846135279 { return 0 - 1 }
    if manifest_audit_fp != 579264308 { return 0 - 1 }
    if manifest_fp != 294601254 { return 0 - 1 }
    if certificate_bridge_fp != 918274650 { return 0 - 1 }
    if readiness_fp != 9371853 { return 0 - 1 }
    if acceptance_mask != 31 { return 0 - 1 }
    if checker_family_id != 73 { return 0 - 1 }
    if checker_kind_id != 118 { return 0 - 1 }
    if manifest_anchor_ok != 1 { return 0 - 1 }
    if certificate_gate_ok != 1 { return 0 - 1 }
    if acceptance_mask_ok != 1 { return 0 - 1 }
    if readiness_fingerprint_ok != 1 { return 0 - 1 }
    if metadata_rejection_ok != 1 { return 0 - 1 }
    if claim_masks_zero_ok != 1 { return 0 - 1 }
    if target_integer_width != 256 { return 0 - 1 }
    if limb_base != 1000000000 { return 0 - 1 }
    if native_i256_evidence_mask != 0 { return 0 - 1 }
    if imported_runtime_evidence_mask != 0 { return 0 - 1 }
    if public_claim_mask != 0 { return 0 - 1 }
    if formal_theorem_ready != 0 { return 0 - 1 }
    if bridge_status != 120 { return 0 - 1 }
    if ok_mask != 4095 { return 0 - 1 }
    return 487690132
}
