//! stdlib/systems/lorenz_i256_signed_delta_bridge.sio
//!
//! Portable signed-delta bridge for Lorenz i256 receipts. This computes the
//! sign and absolute limb difference for two nonnegative four-limb decimal
//! values, making terms such as y-x explicit before scalar multiplication.

pub fn lorenz_i256_delta_limb_base() -> i64 { return 1000000000 }

fn lorenz_delta_limb_ok(x: i64) -> i64 {
    if x < 0 { return 0 }
    if x >= lorenz_i256_delta_limb_base() { return 0 }
    return 1
}

fn lorenz_delta_inputs_ok(
    a0: i64,
    a1: i64,
    a2: i64,
    a3: i64,
    b0: i64,
    b1: i64,
    b2: i64,
    b3: i64) -> i64 {
    if lorenz_delta_limb_ok(a0) != 1 { return 0 }
    if lorenz_delta_limb_ok(a1) != 1 { return 0 }
    if lorenz_delta_limb_ok(a2) != 1 { return 0 }
    if lorenz_delta_limb_ok(a3) != 1 { return 0 }
    if lorenz_delta_limb_ok(b0) != 1 { return 0 }
    if lorenz_delta_limb_ok(b1) != 1 { return 0 }
    if lorenz_delta_limb_ok(b2) != 1 { return 0 }
    if lorenz_delta_limb_ok(b3) != 1 { return 0 }
    return 1
}

pub fn lorenz_dec4_cmp(
    a0: i64,
    a1: i64,
    a2: i64,
    a3: i64,
    b0: i64,
    b1: i64,
    b2: i64,
    b3: i64) -> i64 {
    if lorenz_delta_inputs_ok(a0, a1, a2, a3, b0, b1, b2, b3) != 1 { return 0 - 2 }
    if a3 > b3 { return 1 }
    if a3 < b3 { return 0 - 1 }
    if a2 > b2 { return 1 }
    if a2 < b2 { return 0 - 1 }
    if a1 > b1 { return 1 }
    if a1 < b1 { return 0 - 1 }
    if a0 > b0 { return 1 }
    if a0 < b0 { return 0 - 1 }
    return 0
}

fn lorenz_dec4_sub_ge_limb(
    a0: i64,
    a1: i64,
    a2: i64,
    a3: i64,
    b0: i64,
    b1: i64,
    b2: i64,
    b3: i64,
    limb_index: i64) -> i64 {
    let cmp = lorenz_dec4_cmp(a0, a1, a2, a3, b0, b1, b2, b3)
    if cmp < 0 { return 0 - 1 }
    let base = lorenz_i256_delta_limb_base()

    var borrow0: i64 = 0
    var r0 = a0 - b0
    if r0 < 0 {
        r0 = r0 + base
        borrow0 = 1
    }

    var borrow1: i64 = 0
    var r1 = a1 - b1 - borrow0
    if r1 < 0 {
        r1 = r1 + base
        borrow1 = 1
    }

    var borrow2: i64 = 0
    var r2 = a2 - b2 - borrow1
    if r2 < 0 {
        r2 = r2 + base
        borrow2 = 1
    }

    let r3 = a3 - b3 - borrow2
    if r3 < 0 { return 0 - 1 }

    if limb_index == 0 { return r0 }
    if limb_index == 1 { return r1 }
    if limb_index == 2 { return r2 }
    if limb_index == 3 { return r3 }
    return 0 - 1
}

pub fn lorenz_i256_signed_delta_sign(
    a0: i64,
    a1: i64,
    a2: i64,
    a3: i64,
    b0: i64,
    b1: i64,
    b2: i64,
    b3: i64) -> i64 {
    return lorenz_dec4_cmp(a0, a1, a2, a3, b0, b1, b2, b3)
}

pub fn lorenz_i256_signed_delta_abs_limb(
    a0: i64,
    a1: i64,
    a2: i64,
    a3: i64,
    b0: i64,
    b1: i64,
    b2: i64,
    b3: i64,
    limb_index: i64) -> i64 {
    let cmp = lorenz_dec4_cmp(a0, a1, a2, a3, b0, b1, b2, b3)
    if cmp == 0 - 2 { return 0 - 1 }
    if cmp >= 0 {
        return lorenz_dec4_sub_ge_limb(a0, a1, a2, a3, b0, b1, b2, b3, limb_index)
    }
    return lorenz_dec4_sub_ge_limb(b0, b1, b2, b3, a0, a1, a2, a3, limb_index)
}

pub fn lorenz_i256_signed_delta_check(
    a0: i64,
    a1: i64,
    a2: i64,
    a3: i64,
    b0: i64,
    b1: i64,
    b2: i64,
    b3: i64,
    expected_sign: i64,
    expected_l0: i64,
    expected_l1: i64,
    expected_l2: i64,
    expected_l3: i64) -> i64 {
    let sign = lorenz_i256_signed_delta_sign(a0, a1, a2, a3, b0, b1, b2, b3)
    let r0 = lorenz_i256_signed_delta_abs_limb(a0, a1, a2, a3, b0, b1, b2, b3, 0)
    let r1 = lorenz_i256_signed_delta_abs_limb(a0, a1, a2, a3, b0, b1, b2, b3, 1)
    let r2 = lorenz_i256_signed_delta_abs_limb(a0, a1, a2, a3, b0, b1, b2, b3, 2)
    let r3 = lorenz_i256_signed_delta_abs_limb(a0, a1, a2, a3, b0, b1, b2, b3, 3)
    if sign != expected_sign { return 0 }
    if r0 != expected_l0 { return 0 }
    if r1 != expected_l1 { return 0 }
    if r2 != expected_l2 { return 0 }
    if r3 != expected_l3 { return 0 }
    return 1
}

pub fn lorenz_i256_signed_delta_bridge_receipt_check(
    positive_delta_ok: i64,
    negative_delta_ok: i64,
    zero_delta_ok: i64,
    borrow_delta_ok: i64,
    invalid_limb_rejected: i64,
    target_integer_width: i64,
    limb_base: i64,
    native_i256_evidence_mask: i64,
    imported_runtime_evidence_mask: i64,
    bridge_status: i64) -> i64 {
    if positive_delta_ok != 1 { return 0 - 1 }
    if negative_delta_ok != 1 { return 0 - 1 }
    if zero_delta_ok != 1 { return 0 - 1 }
    if borrow_delta_ok != 1 { return 0 - 1 }
    if invalid_limb_rejected != 1 { return 0 - 1 }
    if target_integer_width != 256 { return 0 - 1 }
    if limb_base != 1000000000 { return 0 - 1 }
    if native_i256_evidence_mask != 0 { return 0 - 1 }
    if imported_runtime_evidence_mask != 0 { return 0 - 1 }
    if bridge_status != 104 { return 0 - 1 }
    return 492681735
}

pub fn lorenz_i256_signed_delta_bridge_audit_fingerprint(
    artifact_fp: i64,
    instance_fp: i64,
    certificate_fp: i64,
    positive_delta_ok: i64,
    negative_delta_ok: i64,
    zero_delta_ok: i64,
    borrow_delta_ok: i64,
    invalid_limb_rejected: i64,
    target_integer_width: i64,
    limb_base: i64,
    native_i256_evidence_mask: i64,
    imported_runtime_evidence_mask: i64,
    public_claim_mask: i64,
    formal_theorem_ready: i64,
    bridge_status: i64,
    ok_mask: i64) -> i64 {
    if artifact_fp != 492681735 { return 0 - 1 }
    if instance_fp != 604913728 { return 0 - 1 }
    if certificate_fp != 195740286 { return 0 - 1 }
    if positive_delta_ok != 1 { return 0 - 1 }
    if negative_delta_ok != 1 { return 0 - 1 }
    if zero_delta_ok != 1 { return 0 - 1 }
    if borrow_delta_ok != 1 { return 0 - 1 }
    if invalid_limb_rejected != 1 { return 0 - 1 }
    if target_integer_width != 256 { return 0 - 1 }
    if limb_base != 1000000000 { return 0 - 1 }
    if native_i256_evidence_mask != 0 { return 0 - 1 }
    if imported_runtime_evidence_mask != 0 { return 0 - 1 }
    if public_claim_mask != 0 { return 0 - 1 }
    if formal_theorem_ready != 0 { return 0 - 1 }
    if bridge_status != 104 { return 0 - 1 }
    if ok_mask != 1023 { return 0 - 1 }
    return 837260419
}
