//! stdlib/systems/lorenz_i256_trajectory2_readiness_dispatch_envelope.sio
//!
//! Local readiness dispatch envelope (status 121) for the bounded two-step
//! Lorenz manifest lane. This exposes the acceptance(120) readiness receipt to
//! a local router query: given the bounded profile metadata, a valid query
//! returns the acceptance readiness fingerprint (9371853); mismatches are
//! rejected. This is a solver-router readiness receipt, not portfolio wiring
//! or a global theorem promotion.

use systems::lorenz_i256_trajectory2_acceptance_bounded_bridge::*

pub fn lorenz_i256_trajectory2_readiness_dispatch_mask(
    query_family_id: i64,
    query_kind_id: i64,
    query_status_lineage_ok: i64,
    acceptance_mask_ok: i64,
    readiness_fp_ok: i64,
    claim_masks_zero_ok: i64,
    native_i256_evidence_mask: i64,
    imported_runtime_evidence_mask: i64,
    public_claim_mask: i64,
    formal_theorem_ready: i64) -> i64 {
    var mask = 0
    if query_family_id == 73 { mask = mask + 1 }
    if query_kind_id == 118 { mask = mask + 2 }
    if query_status_lineage_ok == 1 { mask = mask + 4 }
    if acceptance_mask_ok == 1 { mask = mask + 8 }
    if readiness_fp_ok == 1 { mask = mask + 16 }
    if claim_masks_zero_ok == 1 {
        if native_i256_evidence_mask == 0 {
            if imported_runtime_evidence_mask == 0 {
                if public_claim_mask == 0 {
                    if formal_theorem_ready == 0 { mask = mask + 32 }
                }
            }
        }
    }
    return mask
}

pub fn lorenz_i256_trajectory2_readiness_dispatch_query(
    query_family_id: i64,
    query_kind_id: i64,
    acceptance_mask: i64,
    readiness_fp: i64,
    dispatch_mask: i64,
    claim_masks_zero_ok: i64,
    native_i256_evidence_mask: i64,
    imported_runtime_evidence_mask: i64,
    public_claim_mask: i64,
    formal_theorem_ready: i64,
    target_integer_width: i64,
    limb_base: i64) -> i64 {
    if query_family_id != 73 { return 0 - 1 }
    if query_kind_id != 118 { return 0 - 1 }
    if acceptance_mask != 31 { return 0 - 1 }
    if readiness_fp != 9371853 { return 0 - 1 }
    if dispatch_mask != 63 { return 0 - 1 }
    if claim_masks_zero_ok != 1 { return 0 - 1 }
    if native_i256_evidence_mask != 0 { return 0 - 1 }
    if imported_runtime_evidence_mask != 0 { return 0 - 1 }
    if public_claim_mask != 0 { return 0 - 1 }
    if formal_theorem_ready != 0 { return 0 - 1 }
    if target_integer_width != 256 { return 0 - 1 }
    if limb_base != 1000000000 { return 0 - 1 }
    return 9371853
}

pub fn lorenz_i256_trajectory2_readiness_dispatch_envelope_fingerprint(
    acceptance_readiness_fp: i64,
    acceptance_mask: i64,
    dispatch_mask: i64,
    checker_family_id: i64,
    checker_kind_id: i64,
    bridge_status: i64,
    target_integer_width: i64,
    limb_base: i64) -> i64 with Div {
    if acceptance_readiness_fp != 9371853 { return 0 - 1 }
    if acceptance_mask != 31 { return 0 - 1 }
    if dispatch_mask != 63 { return 0 - 1 }
    if checker_family_id != 73 { return 0 - 1 }
    if checker_kind_id != 118 { return 0 - 1 }
    if bridge_status != 121 { return 0 - 1 }
    if target_integer_width != 256 { return 0 - 1 }
    if limb_base != 1000000000 { return 0 - 1 }
    return (acceptance_readiness_fp + (29 * dispatch_mask) + (31 * acceptance_mask) + (37 * checker_family_id) + (41 * checker_kind_id) + (43 * bridge_status)) % limb_base
}

pub fn lorenz_i256_trajectory2_readiness_dispatch_receipt_check(
    query_profile_ok: i64,
    acceptance_receipt_ok: i64,
    dispatch_mask_ok: i64,
    envelope_fp_ok: i64,
    claim_masks_zero_ok: i64,
    target_integer_width: i64,
    limb_base: i64,
    native_i256_evidence_mask: i64,
    imported_runtime_evidence_mask: i64,
    public_claim_mask: i64,
    formal_theorem_ready: i64,
    bridge_status: i64) -> i64 {
    if query_profile_ok != 1 { return 0 - 1 }
    if acceptance_receipt_ok != 1 { return 0 - 1 }
    if dispatch_mask_ok != 1 { return 0 - 1 }
    if envelope_fp_ok != 1 { return 0 - 1 }
    if claim_masks_zero_ok != 1 { return 0 - 1 }
    if target_integer_width != 256 { return 0 - 1 }
    if limb_base != 1000000000 { return 0 - 1 }
    if native_i256_evidence_mask != 0 { return 0 - 1 }
    if imported_runtime_evidence_mask != 0 { return 0 - 1 }
    if public_claim_mask != 0 { return 0 - 1 }
    if formal_theorem_ready != 0 { return 0 - 1 }
    if bridge_status != 121 { return 0 - 1 }
    return 682914503
}
