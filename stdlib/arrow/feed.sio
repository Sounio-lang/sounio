// stdlib/arrow/feed.sio — device batches from native Arrow IPC
//
// A training step wants one contiguous host buffer per step, because the
// device copy is a single transfer. This module walks a native IPC stream
// or file and packs each record batch into that shape.
//
// Layout of one slab, little-endian, column-major:
//   float32 features, index (col * rows + row) * 4
//   then, when a column is named "label", zero pad to 8 bytes and int64 labels
// The whole slab is `nbytes` bytes. Copy that many bytes once. Do not gather
// rows, and do not split one record batch into several copies.
//
// The native codec bounds the transfer: 16 rows, 8 columns, and an 8192-byte
// IPC buffer. Eight float32 columns and 16 rows are 512 feature bytes. That
// is the largest matrix this codec can hold. `arrow_feed_rows_for_payload`
// is that ceiling applied to a requested byte count. It is not a measured
// bandwidth.
//
// Feature columns are non-null float32 (precision 1). An optional root column
// named "label" is non-null int64. Nulls, float64, nested lists, and
// dictionaries return -4: the device copy has no validity bitmap and must
// not cast on the copy. `dataframe::arrow_available` stays false. This is
// not the Arrow C Data Interface.
//
// Status: 0 a batch, 1 end, -4 unsupported, -6 malformed, -7 over capacity,
// -8 shape mismatch.

use arrow::lib::{
    ArrowBatch,
    ArrowBuf,
    ArrowCursor,
    ArrowSchema,
    arrow_batch_i64,
    arrow_batch_is_null,
    arrow_batch_new,
    arrow_cursor_new,
    arrow_ipc_next,
    arrow_ipc_open,
    arrow_schema_new,
    arrow_type_float,
    arrow_type_int,
}

/// One device step. `offset` is the first byte of this step in `ArrowFeed.host`.
/// `nbytes` is the transfer length. `features_bytes` is the float32 matrix;
/// the label bytes, when present, follow an 8-byte alignment pad.
pub struct ArrowFeedBatch {
    pub index: i64,
    pub rows: i64,
    pub cols: i64,
    pub offset: i64,
    pub features_bytes: i64,
    pub nbytes: i64,
    pub has_label: i64,
}

/// Every record batch of one IPC buffer, packed and ready to copy.
/// At most 8 batches. Each slab is 1024 bytes. The cursor starts at 0.
pub struct ArrowFeed {
    pub n_batches: i64,
    pub index: i64,
    pub cols: i64,
    pub has_label: i64,
    pub rows: [i64; 8],
    pub feature_bytes: [i64; 8],
    pub nbytes: [i64; 8],
    pub labels: [i64; 128],
    pub host: [u8; 8192],
}

fn u8_of(feed: &ArrowFeed, i: i64) -> i64 with Panic {
    if i < 0 || i >= 8192 { return 0 }
    let v = feed.host[i as usize] as i64
    if v < 0 { v + 256 } else { v }
}

fn put_u8(feed: &!ArrowFeed, i: i64, v: i64) with Mut, Panic {
    var x = v & 255
    if x < 0 { x = x + 256 }
    feed.host[i as usize] = (x as i32) as u8
}

fn put_le(feed: &!ArrowFeed, at: i64, v: i64, width: i64) with Mut, Panic {
    var x = v
    var k: i64 = 0
    while k < width {
        put_u8(feed, at + k, x)
        x = x >> 8
        k = k + 1
    }
}

fn name_is(schema: &ArrowSchema, col: i64, text: string) -> i64 with Panic {
    let n = str_len(text)
    if schema.name_lens[col as usize] != n { return 0 }
    var i: i64 = 0
    while i < n {
        var want = text[i as usize] as i64
        if want < 0 { want = want + 256 }
        var got = schema.name_bytes[(col * 32 + i) as usize] as i64
        if got < 0 { got = got + 256 }
        if got != want { return 0 }
        i = i + 1
    }
    1
}

fn is_f32(schema: &ArrowSchema, col: i64) -> i64 with Panic {
    if schema.parent[col as usize] != -1 { return 0 }
    if schema.type_tag[col as usize] != arrow_type_float() { return 0 }
    if schema.precision[col as usize] != 1 { return 0 }
    if schema.nullable[col as usize] != 0 { return 0 }
    if schema.dict_id[col as usize] >= 0 { return 0 }
    if schema.n_child[col as usize] != 0 { return 0 }
    1
}

fn is_i64_label(schema: &ArrowSchema, col: i64) -> i64 with Panic {
    if schema.parent[col as usize] != -1 { return 0 }
    if schema.type_tag[col as usize] != arrow_type_int() { return 0 }
    if schema.bit_width[col as usize] != 64 { return 0 }
    if schema.is_signed[col as usize] == 0 { return 0 }
    if schema.nullable[col as usize] != 0 { return 0 }
    if schema.dict_id[col as usize] >= 0 { return 0 }
    if schema.n_child[col as usize] != 0 { return 0 }
    1
}

fn any_null(batch: &ArrowBatch, col: i64, rows: i64) -> i64 with Panic {
    var r: i64 = 0
    while r < rows {
        if arrow_batch_is_null(batch, col, r) != 0 { return 1 }
        r = r + 1
    }
    0
}

fn clear_feed(feed: &!ArrowFeed) with Mut, Panic {
    feed.n_batches = 0
    feed.index = 0
    feed.cols = 0
    feed.has_label = 0
    var i: i64 = 0
    while i < 8 {
        feed.rows[i as usize] = 0
        feed.feature_bytes[i as usize] = 0
        feed.nbytes[i as usize] = 0
        i = i + 1
    }
    i = 0
    while i < 128 {
        feed.labels[i as usize] = 0
        i = i + 1
    }
    i = 0
    while i < 8192 {
        feed.host[i as usize] = 0
        i = i + 1
    }
}

fn label_at(features_bytes: i64) -> i64 with Div, Panic {
    let m = features_bytes % 8
    if m == 0 { features_bytes } else { features_bytes + (8 - m) }
}

fn pack_batch(
    feed: &!ArrowFeed,
    batch: &ArrowBatch,
    feat: [i64; 8],
    nfeat: i64,
    label_col: i64,
    slot: i64,
) -> i64 with Mut, Panic, Div {
    let rows = batch.n_rows
    if rows < 1 || rows > 16 { return -7 }
    var c: i64 = 0
    while c < nfeat {
        if any_null(batch, feat[c as usize], rows) != 0 { return -4 }
        c = c + 1
    }
    if label_col >= 0 {
        if any_null(batch, label_col, rows) != 0 { return -4 }
    }
    let features_bytes = rows * nfeat * 4
    var nbytes = features_bytes
    var lab_off: i64 = 0
    if label_col >= 0 {
        lab_off = label_at(features_bytes)
        nbytes = lab_off + rows * 8
    }
    if nbytes > 1024 { return -7 }
    let base = slot * 1024
    c = 0
    while c < nfeat {
        var r: i64 = 0
        while r < rows {
            let bits = arrow_batch_i64(batch, feat[c as usize], r)
            let at = base + (c * rows + r) * 4
            put_le(feed, at, bits, 4)
            r = r + 1
        }
        c = c + 1
    }
    if label_col >= 0 {
        var r: i64 = 0
        while r < rows {
            let v = arrow_batch_i64(batch, label_col, r)
            feed.labels[(slot * 16 + r) as usize] = v
            put_le(feed, base + lab_off + r * 8, v, 8)
            r = r + 1
        }
    }
    feed.rows[slot as usize] = rows
    feed.feature_bytes[slot as usize] = features_bytes
    feed.nbytes[slot as usize] = nbytes
    0
}

/// Empty feed. `arrow_feed_open` fills it.
pub fn arrow_feed_new() -> ArrowFeed {
    ArrowFeed {
        n_batches: 0,
        index: 0,
        cols: 0,
        has_label: 0,
        rows: [0; 8],
        feature_bytes: [0; 8],
        nbytes: [0; 8],
        labels: [0; 128],
        host: [0; 8192],
    }
}

/// Row count whose float32 matrix meets `target_bytes`, capped at 16.
///
/// Eight features and a multi-megabyte target still return 16. The native
/// IPC body cannot hold more rows than that. The return value is a size,
/// not a measured transfer rate. `n_features` outside 1..=8 returns -7.
pub fn arrow_feed_rows_for_payload(n_features: i64, target_bytes: i64) -> i64 with Div, Panic {
    if n_features < 1 || n_features > 8 { return -7 }
    if target_bytes < 1 { return -7 }
    let row_bytes = n_features * 4
    var n = (target_bytes + row_bytes - 1) / row_bytes
    if n > 16 { n = 16 }
    if n < 1 { n = 1 }
    n
}

/// Bytes in the float32 matrix. Labels and alignment padding are extra.
pub fn arrow_feed_payload_bytes(rows: i64, cols: i64) -> i64 {
    if rows < 0 || cols < 0 { return -7 }
    rows * cols * 4
}

/// Decode `buf` and pack every record batch.
///
/// One IPC record batch becomes one slab. Batches are not merged and rows
/// are not reordered. A ninth batch returns -7.
pub fn arrow_feed_open(buf: &ArrowBuf, feed: &!ArrowFeed) -> i64 with Mut, Panic, Div {
    clear_feed(feed)
    var schema = arrow_schema_new()
    var cur = arrow_cursor_new()
    let opened = arrow_ipc_open(buf, &!schema, &!cur)
    if opened != 0 { return opened }
    if schema.endian != 0 { return -4 }
    if schema.n_nodes != schema.n_fields { return -4 }
    if schema.n_fields < 1 || schema.n_fields > 8 { return -7 }
    var feat: [i64; 8] = [0; 8]
    var nfeat: i64 = 0
    var label_col: i64 = -1
    var col: i64 = 0
    while col < schema.n_fields {
        if name_is(&schema, col, "label") != 0 {
            if label_col >= 0 { return -4 }
            if is_i64_label(&schema, col) == 0 { return -4 }
            label_col = col
        } else {
            if is_f32(&schema, col) == 0 { return -4 }
            feat[nfeat as usize] = col
            nfeat = nfeat + 1
        }
        col = col + 1
    }
    if nfeat < 1 { return -4 }
    feed.cols = nfeat
    if label_col >= 0 { feed.has_label = 1 }
    var batch = arrow_batch_new()
    while true {
        let nxt = arrow_ipc_next(buf, &schema, &!cur, &!batch)
        if nxt == 1 { return 0 }
        if nxt != 0 { return nxt }
        if feed.n_batches >= 8 { return -7 }
        if batch.n_cols != schema.n_fields { return -8 }
        let slot = feed.n_batches
        let packed = pack_batch(feed, &batch, feat, nfeat, label_col, slot)
        if packed != 0 { return packed }
        feed.n_batches = slot + 1
    }
    0
}

/// Next slab. Returns 0 and fills `out`, or 1 when the cursor is exhausted.
pub fn arrow_feed_next(feed: &!ArrowFeed, out: &!ArrowFeedBatch) -> i64 with Mut, Panic {
    if feed.index >= feed.n_batches { return 1 }
    let i = feed.index
    out.index = i
    out.rows = feed.rows[i as usize]
    out.cols = feed.cols
    out.offset = i * 1024
    out.features_bytes = feed.feature_bytes[i as usize]
    out.nbytes = feed.nbytes[i as usize]
    out.has_label = feed.has_label
    feed.index = i + 1
    0
}

/// Put the cursor back on the first slab. The packed bytes stay.
pub fn arrow_feed_reset(feed: &!ArrowFeed) with Mut {
    feed.index = 0
}

/// Exchange two whole slabs. Row order inside a slab does not change.
pub fn arrow_feed_swap(feed: &!ArrowFeed, a: i64, b: i64) -> i64 with Mut, Panic {
    if a < 0 || b < 0 || a >= feed.n_batches || b >= feed.n_batches { return -6 }
    if a == b { return 0 }
    let rows_a = feed.rows[a as usize]
    feed.rows[a as usize] = feed.rows[b as usize]
    feed.rows[b as usize] = rows_a
    let fb_a = feed.feature_bytes[a as usize]
    feed.feature_bytes[a as usize] = feed.feature_bytes[b as usize]
    feed.feature_bytes[b as usize] = fb_a
    let nb_a = feed.nbytes[a as usize]
    feed.nbytes[a as usize] = feed.nbytes[b as usize]
    feed.nbytes[b as usize] = nb_a
    var r: i64 = 0
    while r < 16 {
        let ia = a * 16 + r
        let ib = b * 16 + r
        let lv = feed.labels[ia as usize]
        feed.labels[ia as usize] = feed.labels[ib as usize]
        feed.labels[ib as usize] = lv
        r = r + 1
    }
    var i: i64 = 0
    while i < 1024 {
        let oa = a * 1024 + i
        let ob = b * 1024 + i
        let tmp = feed.host[oa as usize]
        feed.host[oa as usize] = feed.host[ob as usize]
        feed.host[ob as usize] = tmp
        i = i + 1
    }
    0
}

/// Bytes the device copy moves for slab `index`.
pub fn arrow_feed_copy_bytes(feed: &ArrowFeed, index: i64) -> i64 with Panic {
    if index < 0 || index >= feed.n_batches { return -6 }
    feed.nbytes[index as usize]
}

/// Label stored for `batch` and `row`. Zero when the file has no label column.
pub fn arrow_feed_label(feed: &ArrowFeed, batch: i64, row: i64) -> i64 with Panic {
    if batch < 0 || batch >= 8 || row < 0 || row >= 16 { return 0 }
    feed.labels[(batch * 16 + row) as usize]
}

/// One byte of the packed host slab.
pub fn arrow_feed_u8(feed: &ArrowFeed, at: i64) -> i64 with Panic {
    u8_of(feed, at)
}

/// Four little-endian bytes of the packed host slab, as a non-negative integer.
pub fn arrow_feed_u32(feed: &ArrowFeed, at: i64) -> i64 with Panic {
    if at < 0 || at + 4 > 8192 { return 0 }
    let b0 = u8_of(feed, at)
    let b1 = u8_of(feed, at + 1)
    let b2 = u8_of(feed, at + 2)
    let b3 = u8_of(feed, at + 3)
    b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
}
