// stdlib/arrow/flatbuf.sio — downward FlatBuffers builder
//
// Enough of the FlatBuffers binary format to emit and the Arrow reader walks
// the same layout. Bytes are written from the end of a fixed buffer toward
// the start, matching the C++ FlatBufferBuilder / pyarrow writer.
//
// Vtable soffset: the int32 at the front of a table is a signed distance.
// The vtable is at `table_pos - soffset` (flatbuffers table.h GetVTable).
// This builder always writes a fresh vtable below the table, so the stored
// distance is positive. A reader must also accept a negative distance: that
// is how a shared vtable that lives above the table is encoded.
// Uoffsets are positive distances added to the address of the offset field.
//
// Capacity is 4096 bytes. `head` is the first occupied index; the finished
// buffer is `data[head .. 4096]`.

pub struct FbBuilder {
    pub data: [u8; 4096],
    pub head: i64,
    pub minalign: i64,
    pub vt: [i64; 16],
    pub nfields: i64,
    pub object_end: i64,
    pub vector_count: i64,
    pub err: i64,
}

pub struct FbBytes {
    pub data: [u8; 64],
    pub len: i64,
}

pub fn fb_bytes_new() -> FbBytes {
    FbBytes { data: [0; 64], len: 0 }
}

pub fn fb_new() -> FbBuilder {
    FbBuilder {
        data: [0; 4096],
        head: 4096,
        minalign: 1,
        vt: [0; 16],
        nfields: 0,
        object_end: 0,
        vector_count: 0,
        err: 0,
    }
}

pub fn fb_reset(b: &!FbBuilder) with Mut {
    b.head = 4096
    b.minalign = 1
    b.nfields = 0
    b.object_end = 0
    b.vector_count = 0
    b.err = 0
}

pub fn fb_len(b: &FbBuilder) -> i64 {
    4096 - b.head
}

fn fb_set_err(b: &!FbBuilder) -> i64 with Mut {
    b.err = 1
    0 - 1
}

fn fb_byte_of(v: i64) -> i64 {
    let x = v & 255
    if x < 0 { x + 256 } else { x }
}

// Pad so that (offset + additional + pad) is a multiple of `size`.
// Also reserves `size + additional` bytes for the write that follows,
// which is the FlatBuffers Prep space check.
pub fn fb_prep(b: &!FbBuilder, size: i64, additional: i64) -> i64 with Mut, Panic, Div {
    if b.err != 0 { return 0 - 1 }
    if size > b.minalign { b.minalign = size }
    let mark = (4096 - b.head) + additional
    var pad: i64 = 0
    if size > 1 {
        let m = mark % size
        if m != 0 { pad = size - m }
    }
    if b.head < pad + size + additional { return fb_set_err(b) }
    var i: i64 = 0
    while i < pad {
        b.head = b.head - 1
        b.data[b.head as usize] = 0 as u8
        i = i + 1
    }
    0
}

pub fn fb_place_u8(b: &!FbBuilder, v: i64) -> i64 with Mut, Panic {
    if b.err != 0 { return 0 - 1 }
    if b.head < 1 { return fb_set_err(b) }
    b.head = b.head - 1
    b.data[b.head as usize] = (fb_byte_of(v) as i32) as u8
    0
}

fn fb_place_u16(b: &!FbBuilder, v: i64) -> i64 with Mut, Panic {
    if b.err != 0 { return 0 - 1 }
    if b.head < 2 { return fb_set_err(b) }
    b.head = b.head - 2
    b.data[b.head as usize] = (fb_byte_of(v) as i32) as u8
    b.data[(b.head + 1) as usize] = (fb_byte_of(v >> 8) as i32) as u8
    0
}

fn fb_place_u32(b: &!FbBuilder, v: i64) -> i64 with Mut, Panic {
    if b.err != 0 { return 0 - 1 }
    if b.head < 4 { return fb_set_err(b) }
    b.head = b.head - 4
    b.data[b.head as usize] = (fb_byte_of(v) as i32) as u8
    b.data[(b.head + 1) as usize] = (fb_byte_of(v >> 8) as i32) as u8
    b.data[(b.head + 2) as usize] = (fb_byte_of(v >> 16) as i32) as u8
    b.data[(b.head + 3) as usize] = (fb_byte_of(v >> 24) as i32) as u8
    0
}

fn fb_place_u64(b: &!FbBuilder, v: i64) -> i64 with Mut, Panic {
    if b.err != 0 { return 0 - 1 }
    if b.head < 8 { return fb_set_err(b) }
    b.head = b.head - 8
    b.data[b.head as usize] = (fb_byte_of(v) as i32) as u8
    b.data[(b.head + 1) as usize] = (fb_byte_of(v >> 8) as i32) as u8
    b.data[(b.head + 2) as usize] = (fb_byte_of(v >> 16) as i32) as u8
    b.data[(b.head + 3) as usize] = (fb_byte_of(v >> 24) as i32) as u8
    b.data[(b.head + 4) as usize] = (fb_byte_of(v >> 32) as i32) as u8
    b.data[(b.head + 5) as usize] = (fb_byte_of(v >> 40) as i32) as u8
    b.data[(b.head + 6) as usize] = (fb_byte_of(v >> 48) as i32) as u8
    b.data[(b.head + 7) as usize] = (fb_byte_of(v >> 56) as i32) as u8
    0
}

fn fb_poke_u32(b: &!FbBuilder, idx: i64, v: i64) -> i64 with Mut, Panic {
    if idx < 0 || idx + 4 > 4096 { return fb_set_err(b) }
    b.data[idx as usize] = (fb_byte_of(v) as i32) as u8
    b.data[(idx + 1) as usize] = (fb_byte_of(v >> 8) as i32) as u8
    b.data[(idx + 2) as usize] = (fb_byte_of(v >> 16) as i32) as u8
    b.data[(idx + 3) as usize] = (fb_byte_of(v >> 24) as i32) as u8
    0
}

pub fn fb_uoffset_rel(b: &!FbBuilder, off: i64) -> i64 with Mut, Panic, Div {
    if fb_prep(b, 4, 0) != 0 { return 0 - 1 }
    let rel = (4096 - b.head) - off + 4
    if rel < 0 { return fb_set_err(b) }
    fb_place_u32(b, rel)
}

pub fn fb_start_object(b: &!FbBuilder, n: i64) -> i64 with Mut, Panic {
    if b.err != 0 { return 0 - 1 }
    if n < 0 || n > 16 { return fb_set_err(b) }
    b.nfields = n
    b.object_end = 4096 - b.head
    var i: i64 = 0
    while i < 16 {
        b.vt[i as usize] = 0
        i = i + 1
    }
    0
}

pub fn fb_slot(b: &!FbBuilder, slot: i64) with Mut, Panic {
    if slot >= 0 && slot < 16 {
        b.vt[slot as usize] = 4096 - b.head
    }
}

pub fn fb_end_object(b: &!FbBuilder) -> i64 with Mut, Panic, Div {
    if b.err != 0 { return 0 - 1 }
    if fb_prep(b, 4, 0) != 0 { return 0 - 1 }
    if fb_place_u32(b, 0) != 0 { return 0 - 1 }
    let object_offset = 4096 - b.head
    var i: i64 = b.nfields - 1
    while i >= 0 {
        if b.vt[i as usize] != 0 { break }
        i = i - 1
    }
    var j: i64 = i
    while j >= 0 {
        var off: i64 = 0
        let at = b.vt[j as usize]
        if at != 0 { off = object_offset - at }
        if fb_prep(b, 2, 0) != 0 { return 0 - 1 }
        if fb_place_u16(b, off) != 0 { return 0 - 1 }
        j = j - 1
    }
    let obj_size = object_offset - b.object_end
    if fb_prep(b, 2, 0) != 0 { return 0 - 1 }
    if fb_place_u16(b, obj_size) != 0 { return 0 - 1 }
    let vt_size = (i + 3) * 2
    if fb_prep(b, 2, 0) != 0 { return 0 - 1 }
    if fb_place_u16(b, vt_size) != 0 { return 0 - 1 }
    let vt_off = 4096 - b.head
    let stored = vt_off - object_offset
    if fb_poke_u32(b, 4096 - object_offset, stored) != 0 { return 0 - 1 }
    if b.err != 0 { return 0 - 1 }
    object_offset
}

pub fn fb_start_vector(b: &!FbBuilder, elem_size: i64, count: i64, alignment: i64) -> i64 with Mut, Panic, Div {
    if b.err != 0 { return 0 - 1 }
    if count < 0 { return fb_set_err(b) }
    b.vector_count = count
    let bytes = elem_size * count
    if fb_prep(b, 4, bytes) != 0 { return 0 - 1 }
    fb_prep(b, alignment, bytes)
}

pub fn fb_end_vector(b: &!FbBuilder) -> i64 with Mut, Panic {
    if fb_place_u32(b, b.vector_count) != 0 { return 0 - 1 }
    if b.err != 0 { return 0 - 1 }
    4096 - b.head
}

pub fn fb_create_string(b: &!FbBuilder, src: &FbBytes) -> i64 with Mut, Panic, Div {
    if b.err != 0 { return 0 - 1 }
    let n = src.len
    if n < 0 || n > 64 { return fb_set_err(b) }
    if fb_prep(b, 4, n + 1) != 0 { return 0 - 1 }
    if fb_place_u8(b, 0) != 0 { return 0 - 1 }
    if b.head < n { return fb_set_err(b) }
    b.head = b.head - n
    var i: i64 = 0
    while i < n {
        b.data[(b.head + i) as usize] = src.data[i as usize]
        i = i + 1
    }
    b.vector_count = n
    fb_end_vector(b)
}

pub fn fb_slot_u8(b: &!FbBuilder, slot: i64, val: i64, default_val: i64) -> i64 with Mut, Panic, Div {
    if val == default_val { return 0 }
    if fb_prep(b, 1, 0) != 0 { return 0 - 1 }
    if fb_place_u8(b, val) != 0 { return 0 - 1 }
    fb_slot(b, slot)
    0
}

pub fn fb_slot_i16(b: &!FbBuilder, slot: i64, val: i64, default_val: i64) -> i64 with Mut, Panic, Div {
    if val == default_val { return 0 }
    if fb_prep(b, 2, 0) != 0 { return 0 - 1 }
    if fb_place_u16(b, val) != 0 { return 0 - 1 }
    fb_slot(b, slot)
    0
}

pub fn fb_slot_i32(b: &!FbBuilder, slot: i64, val: i64, default_val: i64) -> i64 with Mut, Panic, Div {
    if val == default_val { return 0 }
    if fb_prep(b, 4, 0) != 0 { return 0 - 1 }
    if fb_place_u32(b, val) != 0 { return 0 - 1 }
    fb_slot(b, slot)
    0
}

pub fn fb_slot_i64(b: &!FbBuilder, slot: i64, val: i64, default_val: i64) -> i64 with Mut, Panic, Div {
    if val == default_val { return 0 }
    if fb_prep(b, 8, 0) != 0 { return 0 - 1 }
    if fb_place_u64(b, val) != 0 { return 0 - 1 }
    fb_slot(b, slot)
    0
}

pub fn fb_slot_off(b: &!FbBuilder, slot: i64, off: i64, default_val: i64) -> i64 with Mut, Panic, Div {
    if off == default_val { return 0 }
    if fb_uoffset_rel(b, off) != 0 { return 0 - 1 }
    fb_slot(b, slot)
    0
}

pub fn fb_finish(b: &!FbBuilder, root: i64) -> i64 with Mut, Panic, Div {
    if b.err != 0 { return 0 - 1 }
    if fb_prep(b, b.minalign, 4) != 0 { return 0 - 1 }
    if fb_uoffset_rel(b, root) != 0 { return 0 - 1 }
    if b.err != 0 { return 0 - 1 }
    0
}
