// stdlib/arrow/mod.sio — Public exports for native Arrow IPC
//
// Per stdlib/CONVENTIONS.md §2, mod.sio declares only the public surface
// (pub use re-exports). Implementations live in the sibling files.

pub use arrow::lib::{
    ArrowBatch,
    ArrowBuf,
    ArrowSchema,
    arrow_batch_f64,
    arrow_batch_i64,
    arrow_batch_is_null,
    arrow_batch_new,
    arrow_batch_set_bool,
    arrow_batch_set_f64,
    arrow_batch_set_i64,
    arrow_batch_set_str,
    arrow_batch_shape,
    arrow_batch_str_byte,
    arrow_batch_str_len,
    arrow_buf_new,
    arrow_ipc_read,
    arrow_ipc_write_file,
    arrow_ipc_write_path,
    arrow_ipc_write_stream,
    arrow_schema_add,
    arrow_schema_new,
    arrow_type_binary,
    arrow_type_bool,
    arrow_type_float,
    arrow_type_int,
    arrow_type_null,
    arrow_type_utf8,
}
