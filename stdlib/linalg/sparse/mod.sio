/// linalg::sparse — Sparse Linear Algebra
///
/// Production-grade sparse matrix formats and iterative solvers for large-scale
/// scientific computing. Designed for problems with 10K-1M+ unknowns.
///
/// # Overview
///
/// This module provides:
///
/// 1. **Sparse Matrix Formats**
///    - CSR (Compressed Sparse Row): Optimal for SpMV and row operations
///    - CSC (Compressed Sparse Column): Optimal for column operations and triangular solves
///    - COO (Coordinate/Triplet): Easy construction, convert to CSR/CSC for operations
///
/// 2. **Iterative Solvers**
///    - CG: Conjugate Gradient for symmetric positive definite systems
///    - BiCGSTAB: For general non-symmetric systems (memory efficient)
///    - GMRES: For general systems (guaranteed convergence)
///
/// 3. **Preconditioners**
///    - Jacobi: Simple diagonal scaling
///    - SSOR: Symmetric successive over-relaxation
///    - ILU(0): Incomplete LU with no fill-in
///
/// # Quick Start
///
/// ```sio
/// use linalg::sparse::*
///
/// // Build a 2D Laplacian (Poisson equation on 100x100 grid)
/// let coo = coo_laplacian_2d(100)  // 10000 unknowns
/// let A = coo_to_csr(&coo)
///
/// // Right-hand side
/// let b = vec_ones(10000)
///
/// // Solve with preconditioned CG
/// let M = jacobi_precond(&A)
/// let config = solver_config_default()
/// let result = pcg_solve_jacobi(&A, &b, &zeros(10000), &M, &config)
///
/// if result.converged {
///     println("Solved in ", result.iterations, " iterations")
/// }
/// ```
///
/// # Format Selection Guide
///
/// | Operation                | Recommended Format |
/// |--------------------------|-------------------|
/// | Build matrix             | COO               |
/// | Matrix-vector multiply   | CSR               |
/// | Transpose multiply       | CSC               |
/// | Row slicing              | CSR               |
/// | Column slicing           | CSC               |
/// | Forward triangular solve | CSC               |
/// | Backward triangular solve| CSR               |
///
/// # Solver Selection Guide
///
/// | Matrix Property              | Recommended Solver |
/// |-----------------------------|-------------------|
/// | Symmetric positive definite  | CG or PCG         |
/// | Symmetric indefinite         | MINRES (TODO)     |
/// | General non-symmetric        | BiCGSTAB or GMRES |
/// | Guaranteed convergence needed| GMRES             |
/// | Memory constrained           | BiCGSTAB          |
///
/// # Performance Tips
///
/// 1. **Build with COO, compute with CSR/CSC**: COO allows O(1) insertion;
///    convert once, then do all SpMV operations
///
/// 2. **Use preconditioners**: For ill-conditioned systems, Jacobi gives 2-5x
///    speedup; ILU(0) can give 10-100x for structured problems
///
/// 3. **Choose right format**: CSR for y = A*x, CSC for y = A^T*x
///
/// 4. **Reuse matrix structure**: If solving many systems with same sparsity,
///    keep the preconditioner

module linalg::sparse

