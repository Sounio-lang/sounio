// mod.d - Linear Algebra Module for Sounio
//
// Comprehensive linear algebra library providing:
//
// ## Fixed-Size Types (Stack-Allocated, SIMD-Optimized)
// - Vec2, Vec3, Vec4: Small fixed-size vectors
// - Vec14: 14-element vector for PBPK compartment states
// - Mat2, Mat3, Mat4: Fixed-size matrices
// - Mat14Diag, Mat14Tridiag: Sparse PBPK Jacobian matrices
//
// ## Dynamic Types (Heap-Allocated, BLAS-Accelerated)
// - DenseVector: Arbitrary-length vector backed by BLAS
// - DenseMatrix: Arbitrary-size matrix backed by BLAS
//
// ## BLAS Operations (Level 1, 2, 3)
// - Level 1: Vector-vector operations (daxpy, ddot, dnrm2, dscal)
// - Level 2: Matrix-vector operations (dgemv, dsymv, dtrsv)
// - Level 3: Matrix-matrix operations (dgemm, dsyrk, dtrsm)
//
// ## LAPACK Operations
// - LU factorization and solve
// - Cholesky, QR, SVD decompositions
// - Eigenvalue problems (eig, eigh)
// - Matrix functions (inv, det, cond, rank, pinv)
//
// All fixed-size types are stack-allocated and optimized for small dimensions.
// Dynamic types use BLAS when available, with pure D fallback otherwise.

module linalg

// ============================================================================
// RE-EXPORTS: Fixed-Size Types
// ============================================================================

// Export all fixed-size vector operations
pub use vector::*

// Export all fixed-size matrix operations
pub use matrix::*

// ============================================================================
// RE-EXPORTS: BLAS Operations
// ============================================================================

// Level 1 BLAS: Vector-vector operations
pub use blas::daxpy      // y = alpha*x + y
pub use blas::ddot       // dot product
pub use blas::dnrm2      // Euclidean norm
pub use blas::dscal      // x = alpha*x
pub use blas::dasum      // sum of absolute values
pub use blas::idamax     // index of max absolute value
pub use blas::dcopy      // copy vector

// Level 2 BLAS: Matrix-vector operations
pub use blas::dgemv      // y = alpha*A*x + beta*y
pub use blas::dsymv      // symmetric matrix-vector multiply
pub use blas::dtrsv      // triangular solve

// Level 3 BLAS: Matrix-matrix operations
pub use blas::dgemm      // C = alpha*A*B + beta*C
pub use blas::dsyrk      // symmetric rank-k update
pub use blas::dtrsm      // triangular matrix solve

// BLAS enums
pub use blas::BlasOrder
pub use blas::BlasTranspose
pub use blas::BlasUplo
pub use blas::BlasDiag
pub use blas::BlasSide

// ============================================================================
// RE-EXPORTS: LAPACK Operations
// ============================================================================

// Matrix factorizations
pub use lapack::lu           // LU factorization
pub use lapack::cholesky     // Cholesky factorization
pub use lapack::qr           // QR factorization
pub use lapack::svd          // Singular value decomposition

// Linear solvers
pub use lapack::solve        // Solve Ax = b via LU

// Matrix properties
pub use lapack::inv          // Matrix inverse
pub use lapack::det          // Determinant
pub use lapack::cond         // Condition number
pub use lapack::rank         // Matrix rank
pub use lapack::pinv         // Pseudoinverse

// Eigenvalue problems
pub use lapack::eig          // General eigenvalue problem
pub use lapack::eigh         // Symmetric/Hermitian eigenvalue problem

// ============================================================================
// DYNAMIC VECTOR TYPE
// ============================================================================

/// A dynamically-sized vector backed by contiguous memory.
/// Uses BLAS operations when available for high performance.
pub struct DenseVector {
    /// Contiguous storage for vector elements
    data: &![f64],
    /// Number of elements
    len: usize,
}

impl DenseVector {
    /// Create a new zero vector of given length
    pub fn zeros(n: usize) -> DenseVector with Alloc {
        let data = alloc_array::<f64>(n)
        for i in 0..n {
            data[i] = 0.0
        }
        DenseVector { data, len: n }
    }

    /// Create a new vector filled with ones
    pub fn ones(n: usize) -> DenseVector with Alloc {
        let data = alloc_array::<f64>(n)
        for i in 0..n {
            data[i] = 1.0
        }
        DenseVector { data, len: n }
    }

    /// Create a vector from a slice
    pub fn from_slice(slice: &[f64]) -> DenseVector with Alloc {
        let n = slice.len()
        let data = alloc_array::<f64>(n)
        for i in 0..n {
            data[i] = slice[i]
        }
        DenseVector { data, len: n }
    }

    /// Get the length of the vector
    pub fn len(&self) -> usize {
        self.len
    }

    /// Check if vector is empty
    pub fn is_empty(&self) -> bool {
        self.len == 0
    }

    /// Get element at index
    pub fn get(&self, i: usize) -> f64 {
        self.data[i]
    }

    /// Set element at index
    pub fn set(&!self, i: usize, value: f64) {
        self.data[i] = value
    }

    /// Get raw data pointer for BLAS operations
    pub fn as_ptr(&self) -> &[f64] {
        self.data
    }

    /// Get mutable raw data pointer for BLAS operations
    pub fn as_mut_ptr(&!self) -> &![f64] {
        self.data
    }

    // --- BLAS Level 1 Operations ---

    /// Compute dot product: self . other
    /// Uses BLAS ddot when available
    pub fn dot(&self, other: &DenseVector) -> f64 {
        ddot(self.len as i32, self.data, 1, other.data, 1)
    }

    /// Compute Euclidean norm: ||self||_2
    /// Uses BLAS dnrm2
    pub fn norm2(&self) -> f64 {
        dnrm2(self.len as i32, self.data, 1)
    }

    /// Compute L1 norm: ||self||_1 = sum(|x_i|)
    /// Uses BLAS dasum
    pub fn norm1(&self) -> f64 {
        dasum(self.len as i32, self.data, 1)
    }

    /// Scale vector in-place: self = alpha * self
    /// Uses BLAS dscal
    pub fn scale(&!self, alpha: f64) {
        dscal(self.len as i32, alpha, self.data, 1)
    }

    /// AXPY operation: self = alpha * x + self
    /// Uses BLAS daxpy
    pub fn axpy(&!self, alpha: f64, x: &DenseVector) {
        daxpy(self.len as i32, alpha, x.data, 1, self.data, 1)
    }

    /// Find index of element with maximum absolute value
    /// Uses BLAS idamax
    pub fn imax_abs(&self) -> usize {
        idamax(self.len as i32, self.data, 1) as usize
    }

    /// Copy from another vector
    /// Uses BLAS dcopy
    pub fn copy_from(&!self, other: &DenseVector) {
        dcopy(self.len as i32, other.data, 1, self.data, 1)
    }

    // --- Element-wise Operations ---

    /// Add two vectors: self + other
    pub fn add(&self, other: &DenseVector) -> DenseVector with Alloc {
        let mut result = DenseVector::zeros(self.len)
        result.copy_from(self)
        result.axpy(1.0, other)
        result
    }

    /// Subtract two vectors: self - other
    pub fn sub(&self, other: &DenseVector) -> DenseVector with Alloc {
        let mut result = DenseVector::zeros(self.len)
        result.copy_from(self)
        result.axpy(-1.0, other)
        result
    }

    /// Element-wise multiply: self .* other
    pub fn hadamard(&self, other: &DenseVector) -> DenseVector with Alloc {
        let mut result = DenseVector::zeros(self.len)
        for i in 0..self.len {
            result.data[i] = self.data[i] * other.data[i]
        }
        result
    }

    /// Sum of all elements
    pub fn sum(&self) -> f64 {
        let mut s = 0.0
        for i in 0..self.len {
            s = s + self.data[i]
        }
        s
    }

    /// Normalize vector in-place (L2 normalization)
    pub fn normalize(&!self) {
        let n = self.norm2()
        if n > 1e-15 {
            self.scale(1.0 / n)
        }
    }

    /// Return normalized copy
    pub fn normalized(&self) -> DenseVector with Alloc {
        let mut result = DenseVector::zeros(self.len)
        result.copy_from(self)
        result.normalize()
        result
    }
}

// ============================================================================
// DYNAMIC MATRIX TYPE
// ============================================================================

/// A dynamically-sized matrix stored in column-major order (for BLAS compatibility).
/// Uses BLAS/LAPACK operations when available for high performance.
pub struct DenseMatrix {
    /// Contiguous column-major storage
    data: &![f64],
    /// Number of rows
    rows: usize,
    /// Number of columns
    cols: usize,
}

impl DenseMatrix {
    /// Create a new zero matrix of given dimensions
    pub fn zeros(rows: usize, cols: usize) -> DenseMatrix with Alloc {
        let data = alloc_array::<f64>(rows * cols)
        for i in 0..(rows * cols) {
            data[i] = 0.0
        }
        DenseMatrix { data, rows, cols }
    }

    /// Create an identity matrix
    pub fn eye(n: usize) -> DenseMatrix with Alloc {
        let mut m = DenseMatrix::zeros(n, n)
        for i in 0..n {
            m.set(i, i, 1.0)
        }
        m
    }

    /// Create a diagonal matrix from a vector
    pub fn diag(v: &DenseVector) -> DenseMatrix with Alloc {
        let n = v.len()
        let mut m = DenseMatrix::zeros(n, n)
        for i in 0..n {
            m.set(i, i, v.get(i))
        }
        m
    }

    /// Create matrix from 2D slice (row-major input, stored column-major)
    pub fn from_rows(data: &[&[f64]]) -> DenseMatrix with Alloc {
        let rows = data.len()
        let cols = if rows > 0 { data[0].len() } else { 0 }
        let mut m = DenseMatrix::zeros(rows, cols)
        for i in 0..rows {
            for j in 0..cols {
                m.set(i, j, data[i][j])
            }
        }
        m
    }

    /// Get number of rows
    pub fn rows(&self) -> usize {
        self.rows
    }

    /// Get number of columns
    pub fn cols(&self) -> usize {
        self.cols
    }

    /// Check if matrix is square
    pub fn is_square(&self) -> bool {
        self.rows == self.cols
    }

    /// Get element at (i, j) - column-major indexing
    pub fn get(&self, i: usize, j: usize) -> f64 {
        self.data[j * self.rows + i]  // column-major
    }

    /// Set element at (i, j)
    pub fn set(&!self, i: usize, j: usize, value: f64) {
        self.data[j * self.rows + i] = value
    }

    /// Get raw data pointer for BLAS operations
    pub fn as_ptr(&self) -> &[f64] {
        self.data
    }

    /// Get mutable raw data pointer
    pub fn as_mut_ptr(&!self) -> &![f64] {
        self.data
    }

    /// Get leading dimension (for BLAS, this is rows for column-major)
    pub fn ld(&self) -> i32 {
        self.rows as i32
    }

    // --- BLAS Level 2 Operations ---

    /// Matrix-vector multiply: y = alpha * A * x + beta * y
    /// Uses BLAS dgemv
    pub fn gemv(&self, alpha: f64, x: &DenseVector, beta: f64, y: &!DenseVector) {
        dgemv(
            BlasOrder::ColMajor,
            BlasTranspose::NoTrans,
            self.rows as i32,
            self.cols as i32,
            alpha,
            self.data,
            self.ld(),
            x.data,
            1,
            beta,
            y.data,
            1
        )
    }

    /// Simple matrix-vector multiply: A * x
    pub fn mul_vec(&self, x: &DenseVector) -> DenseVector with Alloc {
        let mut y = DenseVector::zeros(self.rows)
        self.gemv(1.0, x, 0.0, &!y)
        y
    }

    // --- BLAS Level 3 Operations ---

    /// General matrix multiply: C = alpha * A * B + beta * C
    /// Uses BLAS dgemm
    pub fn gemm(&self, alpha: f64, b: &DenseMatrix, beta: f64, c: &!DenseMatrix) {
        dgemm(
            BlasOrder::ColMajor,
            BlasTranspose::NoTrans,
            BlasTranspose::NoTrans,
            self.rows as i32,
            b.cols as i32,
            self.cols as i32,
            alpha,
            self.data,
            self.ld(),
            b.data,
            b.ld(),
            beta,
            c.data,
            c.ld()
        )
    }

    /// Simple matrix multiply: A * B
    pub fn mul(&self, b: &DenseMatrix) -> DenseMatrix with Alloc {
        let mut c = DenseMatrix::zeros(self.rows, b.cols)
        self.gemm(1.0, b, 0.0, &!c)
        c
    }

    /// Matrix addition: A + B
    pub fn add(&self, b: &DenseMatrix) -> DenseMatrix with Alloc {
        let mut c = DenseMatrix::zeros(self.rows, self.cols)
        for i in 0..(self.rows * self.cols) {
            c.data[i] = self.data[i] + b.data[i]
        }
        c
    }

    /// Matrix subtraction: A - B
    pub fn sub(&self, b: &DenseMatrix) -> DenseMatrix with Alloc {
        let mut c = DenseMatrix::zeros(self.rows, self.cols)
        for i in 0..(self.rows * self.cols) {
            c.data[i] = self.data[i] - b.data[i]
        }
        c
    }

    /// Scalar multiply: alpha * A
    pub fn scale(&self, alpha: f64) -> DenseMatrix with Alloc {
        let mut c = DenseMatrix::zeros(self.rows, self.cols)
        for i in 0..(self.rows * self.cols) {
            c.data[i] = alpha * self.data[i]
        }
        c
    }

    /// Transpose: A^T
    pub fn transpose(&self) -> DenseMatrix with Alloc {
        let mut c = DenseMatrix::zeros(self.cols, self.rows)
        for i in 0..self.rows {
            for j in 0..self.cols {
                c.set(j, i, self.get(i, j))
            }
        }
        c
    }

    /// Trace: sum of diagonal elements
    pub fn trace(&self) -> f64 {
        let n = if self.rows < self.cols { self.rows } else { self.cols }
        let mut t = 0.0
        for i in 0..n {
            t = t + self.get(i, i)
        }
        t
    }

    /// Frobenius norm: ||A||_F = sqrt(sum(a_ij^2))
    pub fn frobenius_norm(&self) -> f64 {
        let v = DenseVector { data: self.data, len: self.rows * self.cols }
        v.norm2()
    }

    // --- LAPACK Operations ---

    /// Solve linear system: A * x = b
    /// Returns x
    pub fn solve(&self, b: &DenseVector) -> Result<DenseVector, string> with Alloc {
        lapack::solve(self, b)
    }

    /// Compute matrix inverse: A^(-1)
    pub fn inverse(&self) -> Result<DenseMatrix, string> with Alloc {
        lapack::inv(self)
    }

    /// Compute determinant
    pub fn determinant(&self) -> Result<f64, string> with Alloc {
        lapack::det(self)
    }

    /// Compute condition number
    pub fn condition_number(&self) -> Result<f64, string> with Alloc {
        lapack::cond(self)
    }

    /// Compute matrix rank
    pub fn rank(&self, tol: f64) -> Result<usize, string> with Alloc {
        lapack::rank(self, tol)
    }

    /// LU factorization: A = P * L * U
    pub fn lu(&self) -> Result<LUFactorization, string> with Alloc {
        lapack::lu(self)
    }

    /// QR factorization: A = Q * R
    pub fn qr(&self) -> Result<QRFactorization, string> with Alloc {
        lapack::qr(self)
    }

    /// Cholesky factorization: A = L * L^T (for symmetric positive definite)
    pub fn cholesky(&self) -> Result<DenseMatrix, string> with Alloc {
        lapack::cholesky(self)
    }

    /// SVD: A = U * S * V^T
    pub fn svd(&self) -> Result<SVDFactorization, string> with Alloc {
        lapack::svd(self)
    }

    /// Eigenvalue decomposition (general matrix)
    pub fn eig(&self) -> Result<EigenDecomposition, string> with Alloc {
        lapack::eig(self)
    }

    /// Eigenvalue decomposition (symmetric matrix)
    pub fn eigh(&self) -> Result<SymmetricEigenDecomposition, string> with Alloc {
        lapack::eigh(self)
    }

    /// Pseudoinverse (Moore-Penrose)
    pub fn pinv(&self) -> Result<DenseMatrix, string> with Alloc {
        lapack::pinv(self)
    }

    // --- Row/Column Operations ---

    /// Get row as vector
    pub fn row(&self, i: usize) -> DenseVector with Alloc {
        let mut v = DenseVector::zeros(self.cols)
        for j in 0..self.cols {
            v.set(j, self.get(i, j))
        }
        v
    }

    /// Get column as vector
    pub fn col(&self, j: usize) -> DenseVector with Alloc {
        let mut v = DenseVector::zeros(self.rows)
        for i in 0..self.rows {
            v.set(i, self.get(i, j))
        }
        v
    }

    /// Set row from vector
    pub fn set_row(&!self, i: usize, v: &DenseVector) {
        for j in 0..self.cols {
            self.set(i, j, v.get(j))
        }
    }

    /// Set column from vector
    pub fn set_col(&!self, j: usize, v: &DenseVector) {
        for i in 0..self.rows {
            self.set(i, j, v.get(i))
        }
    }
}

// ============================================================================
// FACTORIZATION RESULT TYPES
// ============================================================================

/// LU factorization result: A = P * L * U
pub struct LUFactorization {
    /// Combined L and U (L is unit lower triangular, U is upper triangular)
    pub lu: DenseMatrix,
    /// Pivot indices
    pub ipiv: &[i32],
}

/// QR factorization result: A = Q * R
pub struct QRFactorization {
    /// Orthogonal matrix Q
    pub q: DenseMatrix,
    /// Upper triangular matrix R
    pub r: DenseMatrix,
}

/// SVD result: A = U * diag(S) * V^T
pub struct SVDFactorization {
    /// Left singular vectors (m x m)
    pub u: DenseMatrix,
    /// Singular values (min(m,n) vector)
    pub s: DenseVector,
    /// Right singular vectors transposed (n x n)
    pub vt: DenseMatrix,
}

/// Eigenvalue decomposition result
pub struct EigenDecomposition {
    /// Eigenvalues (may be complex, stored as pairs)
    pub eigenvalues_real: DenseVector,
    pub eigenvalues_imag: DenseVector,
    /// Right eigenvectors (columns)
    pub eigenvectors: DenseMatrix,
}

/// Symmetric eigenvalue decomposition result
pub struct SymmetricEigenDecomposition {
    /// Eigenvalues (real for symmetric)
    pub eigenvalues: DenseVector,
    /// Eigenvectors (columns, orthonormal)
    pub eigenvectors: DenseMatrix,
}

// ============================================================================
// SPARSE MATRIX TYPES (CSR Format)
// ============================================================================

/// Compressed Sparse Row (CSR) format matrix.
/// Efficient for row slicing and matrix-vector products.
pub struct SparseMatrixCSR {
    /// Number of rows
    rows: usize,
    /// Number of columns
    cols: usize,
    /// Non-zero values (in row-major order within each row)
    values: &![f64],
    /// Column indices for each value
    col_indices: &![usize],
    /// Row pointers: row_ptr[i] is the index in values/col_indices where row i starts
    /// row_ptr has length rows + 1
    row_ptr: &![usize],
    /// Number of non-zero elements
    nnz: usize,
}

impl SparseMatrixCSR {
    /// Create a new CSR matrix from COO (coordinate) format triplets
    pub fn from_triplets(
        rows: usize,
        cols: usize,
        row_indices: &[usize],
        col_indices: &[usize],
        values: &[f64]
    ) -> SparseMatrixCSR with Alloc {
        let nnz = values.len()

        // Count elements per row
        let row_counts = alloc_array::<usize>(rows)
        for i in 0..rows {
            row_counts[i] = 0
        }
        for i in 0..nnz {
            row_counts[row_indices[i]] = row_counts[row_indices[i]] + 1
        }

        // Build row pointers (cumulative sum)
        let row_ptr = alloc_array::<usize>(rows + 1)
        row_ptr[0] = 0
        for i in 0..rows {
            row_ptr[i + 1] = row_ptr[i] + row_counts[i]
        }

        // Fill values and column indices
        let csr_values = alloc_array::<f64>(nnz)
        let csr_col_indices = alloc_array::<usize>(nnz)
        let current_pos = alloc_array::<usize>(rows)
        for i in 0..rows {
            current_pos[i] = row_ptr[i]
        }

        for i in 0..nnz {
            let row = row_indices[i]
            let pos = current_pos[row]
            csr_values[pos] = values[i]
            csr_col_indices[pos] = col_indices[i]
            current_pos[row] = pos + 1
        }

        SparseMatrixCSR {
            rows, cols,
            values: csr_values,
            col_indices: csr_col_indices,
            row_ptr,
            nnz
        }
    }

    /// Create an identity matrix in CSR format
    pub fn eye(n: usize) -> SparseMatrixCSR with Alloc {
        let values = alloc_array::<f64>(n)
        let col_indices = alloc_array::<usize>(n)
        let row_ptr = alloc_array::<usize>(n + 1)

        for i in 0..n {
            values[i] = 1.0
            col_indices[i] = i
            row_ptr[i] = i
        }
        row_ptr[n] = n

        SparseMatrixCSR {
            rows: n, cols: n,
            values, col_indices, row_ptr,
            nnz: n
        }
    }

    /// Number of rows
    pub fn rows(&self) -> usize {
        self.rows
    }

    /// Number of columns
    pub fn cols(&self) -> usize {
        self.cols
    }

    /// Number of non-zero elements
    pub fn nnz(&self) -> usize {
        self.nnz
    }

    /// Sparsity ratio (nnz / total)
    pub fn sparsity(&self) -> f64 {
        self.nnz as f64 / (self.rows * self.cols) as f64
    }

    /// Get element at (i, j) - O(nnz_in_row) lookup
    pub fn get(&self, i: usize, j: usize) -> f64 {
        let row_start = self.row_ptr[i]
        let row_end = self.row_ptr[i + 1]

        for k in row_start..row_end {
            if self.col_indices[k] == j {
                return self.values[k]
            }
        }
        0.0
    }

    /// Sparse matrix-vector multiply: y = A * x
    pub fn mul_vec(&self, x: &DenseVector) -> DenseVector with Alloc {
        let mut y = DenseVector::zeros(self.rows)

        for i in 0..self.rows {
            let row_start = self.row_ptr[i]
            let row_end = self.row_ptr[i + 1]
            var sum = 0.0

            for k in row_start..row_end {
                let j = self.col_indices[k]
                sum = sum + self.values[k] * x.get(j)
            }
            y.set(i, sum)
        }
        y
    }

    /// Sparse matrix-vector multiply with scaling: y = alpha * A * x + beta * y
    pub fn spmv(&self, alpha: f64, x: &DenseVector, beta: f64, y: &!DenseVector) {
        for i in 0..self.rows {
            let row_start = self.row_ptr[i]
            let row_end = self.row_ptr[i + 1]
            var sum = 0.0

            for k in row_start..row_end {
                let j = self.col_indices[k]
                sum = sum + self.values[k] * x.get(j)
            }
            y.set(i, alpha * sum + beta * y.get(i))
        }
    }

    /// Convert to dense matrix
    pub fn to_dense(&self) -> DenseMatrix with Alloc {
        let mut m = DenseMatrix::zeros(self.rows, self.cols)

        for i in 0..self.rows {
            let row_start = self.row_ptr[i]
            let row_end = self.row_ptr[i + 1]

            for k in row_start..row_end {
                let j = self.col_indices[k]
                m.set(i, j, self.values[k])
            }
        }
        m
    }
}

// ============================================================================
// ITERATIVE SOLVERS
// ============================================================================

/// Configuration for iterative solvers
pub struct IterativeSolverConfig {
    /// Maximum iterations
    pub max_iter: usize,
    /// Convergence tolerance (relative residual)
    pub tol: f64,
    /// Initial guess (None = zero vector)
    pub x0: Option<DenseVector>,
}

impl IterativeSolverConfig {
    /// Default configuration
    pub fn default() -> IterativeSolverConfig {
        IterativeSolverConfig {
            max_iter: 1000,
            tol: 1e-10,
            x0: None
        }
    }
}

/// Result from an iterative solver
pub struct IterativeSolverResult {
    /// Solution vector
    pub x: DenseVector,
    /// Number of iterations performed
    pub iterations: usize,
    /// Final residual norm
    pub residual: f64,
    /// Convergence flag
    pub converged: bool,
}

/// Conjugate Gradient solver for symmetric positive definite systems.
/// Solves A * x = b where A is SPD.
pub fn cg(
    A: &SparseMatrixCSR,
    b: &DenseVector,
    config: &IterativeSolverConfig
) -> IterativeSolverResult with Alloc {
    let n = b.len()

    // Initial guess
    var x = match config.x0 {
        Some(ref x0) => x0.clone(),
        None => DenseVector::zeros(n)
    }

    // r = b - A*x
    var r = A.mul_vec(&x)
    for i in 0..n {
        r.set(i, b.get(i) - r.get(i))
    }

    // p = r
    var p = DenseVector::zeros(n)
    p.copy_from(&r)

    var rsold = r.dot(&r)
    let b_norm = b.norm2()

    var iterations = 0
    var converged = false

    for iter in 0..config.max_iter {
        iterations = iter + 1

        // Ap = A * p
        let Ap = A.mul_vec(&p)

        // alpha = rsold / (p^T * Ap)
        let pAp = p.dot(&Ap)
        if pAp < 1e-30 {
            break
        }
        let alpha = rsold / pAp

        // x = x + alpha * p
        x.axpy(alpha, &p)

        // r = r - alpha * Ap
        r.axpy(-alpha, &Ap)

        // Check convergence
        let rsnew = r.dot(&r)
        let rel_residual = rsnew.sqrt() / b_norm

        if rel_residual < config.tol {
            converged = true
            break
        }

        // p = r + (rsnew/rsold) * p
        let beta = rsnew / rsold
        for i in 0..n {
            p.set(i, r.get(i) + beta * p.get(i))
        }

        rsold = rsnew
    }

    IterativeSolverResult {
        x,
        iterations,
        residual: r.norm2(),
        converged
    }
}

/// GMRES solver for general (possibly non-symmetric) systems.
/// Solves A * x = b using Generalized Minimal Residual method.
pub fn gmres(
    A: &SparseMatrixCSR,
    b: &DenseVector,
    config: &IterativeSolverConfig,
    restart: usize  // Restart parameter (typical: 20-50)
) -> IterativeSolverResult with Alloc {
    let n = b.len()
    let m = if restart < n { restart } else { n }

    // Initial guess
    var x = match config.x0 {
        Some(ref x0) => x0.clone(),
        None => DenseVector::zeros(n)
    }

    let b_norm = b.norm2()
    var iterations = 0
    var converged = false
    var final_residual = 0.0

    for outer in 0..(config.max_iter / m + 1) {
        // r = b - A*x
        var r = A.mul_vec(&x)
        for i in 0..n {
            r.set(i, b.get(i) - r.get(i))
        }

        let r_norm = r.norm2()
        if r_norm / b_norm < config.tol {
            converged = true
            final_residual = r_norm
            break
        }

        // Arnoldi process: build orthonormal basis V and upper Hessenberg H
        // V is (n x m+1), H is (m+1 x m)
        let mut V_cols: &![DenseVector] = alloc_array::<DenseVector>(m + 1)
        let mut H = DenseMatrix::zeros(m + 1, m)

        // v_0 = r / ||r||
        V_cols[0] = DenseVector::zeros(n)
        for i in 0..n {
            V_cols[0].set(i, r.get(i) / r_norm)
        }

        // g = [||r||, 0, 0, ...] (m+1 elements)
        var g = DenseVector::zeros(m + 1)
        g.set(0, r_norm)

        var k = 0
        for j in 0..m {
            iterations = iterations + 1

            // w = A * v_j
            let w_temp = A.mul_vec(&V_cols[j])
            var w = w_temp

            // Gram-Schmidt orthogonalization
            for i in 0..(j + 1) {
                let h_ij = w.dot(&V_cols[i])
                H.set(i, j, h_ij)
                w.axpy(-h_ij, &V_cols[i])
            }

            let w_norm = w.norm2()
            H.set(j + 1, j, w_norm)

            if w_norm < 1e-14 {
                k = j + 1
                break
            }

            // v_{j+1} = w / ||w||
            V_cols[j + 1] = DenseVector::zeros(n)
            for i in 0..n {
                V_cols[j + 1].set(i, w.get(i) / w_norm)
            }

            // Apply Givens rotations to H and g (for least squares)
            // This is the QR factorization step
            // Simplified: we'll use direct least squares at the end

            k = j + 1

            if iterations >= config.max_iter {
                break
            }
        }

        // Solve least squares: min ||H_k * y - g_k||
        // H_k is (k+1) x k upper Hessenberg
        // Use back substitution on R from QR(H)
        if k > 0 {
            // Simplified: solve using normal equations for small systems
            // y = (H^T H)^{-1} H^T g
            let H_k = extract_submatrix(&H, k + 1, k)
            let g_k = extract_subvector(&g, k + 1)

            // Solve via back substitution on upper triangular part
            let y = solve_upper_hessenberg(&H_k, &g_k)

            // x = x + V_k * y
            for j in 0..k {
                x.axpy(y.get(j), &V_cols[j])
            }
        }

        // Compute actual residual
        r = A.mul_vec(&x)
        for i in 0..n {
            r.set(i, b.get(i) - r.get(i))
        }
        final_residual = r.norm2()

        if final_residual / b_norm < config.tol {
            converged = true
            break
        }
    }

    IterativeSolverResult {
        x,
        iterations,
        residual: final_residual,
        converged
    }
}

// Helper: extract submatrix
fn extract_submatrix(m: &DenseMatrix, rows: usize, cols: usize) -> DenseMatrix with Alloc {
    let mut sub = DenseMatrix::zeros(rows, cols)
    for i in 0..rows {
        for j in 0..cols {
            sub.set(i, j, m.get(i, j))
        }
    }
    sub
}

// Helper: extract subvector
fn extract_subvector(v: &DenseVector, len: usize) -> DenseVector with Alloc {
    let mut sub = DenseVector::zeros(len)
    for i in 0..len {
        sub.set(i, v.get(i))
    }
    sub
}

// Helper: solve upper Hessenberg system (simplified)
fn solve_upper_hessenberg(H: &DenseMatrix, g: &DenseVector) -> DenseVector with Alloc {
    let m = H.cols()
    var y = DenseVector::zeros(m)

    // Back substitution (assuming H is essentially upper triangular after Givens)
    for i in (0..m).rev() {
        var sum = g.get(i)
        for j in (i + 1)..m {
            sum = sum - H.get(i, j) * y.get(j)
        }
        let h_ii = H.get(i, i)
        if h_ii.abs() > 1e-14 {
            y.set(i, sum / h_ii)
        }
    }
    y
}

/// BiCGSTAB solver for general non-symmetric systems.
/// Bi-Conjugate Gradient Stabilized method.
pub fn bicgstab(
    A: &SparseMatrixCSR,
    b: &DenseVector,
    config: &IterativeSolverConfig
) -> IterativeSolverResult with Alloc {
    let n = b.len()

    // Initial guess
    var x = match config.x0 {
        Some(ref x0) => x0.clone(),
        None => DenseVector::zeros(n)
    }

    // r = b - A*x
    var r = A.mul_vec(&x)
    for i in 0..n {
        r.set(i, b.get(i) - r.get(i))
    }

    // r_hat = r (shadow residual, kept constant)
    let r_hat = r.clone()

    var rho = 1.0
    var alpha = 1.0
    var omega = 1.0

    var v = DenseVector::zeros(n)
    var p = DenseVector::zeros(n)

    let b_norm = b.norm2()
    var iterations = 0
    var converged = false

    for iter in 0..config.max_iter {
        iterations = iter + 1

        let rho_new = r_hat.dot(&r)
        if rho_new.abs() < 1e-30 {
            break  // Method breakdown
        }

        let beta = (rho_new / rho) * (alpha / omega)

        // p = r + beta * (p - omega * v)
        for i in 0..n {
            p.set(i, r.get(i) + beta * (p.get(i) - omega * v.get(i)))
        }

        // v = A * p
        v = A.mul_vec(&p)

        let r_hat_v = r_hat.dot(&v)
        if r_hat_v.abs() < 1e-30 {
            break
        }
        alpha = rho_new / r_hat_v

        // s = r - alpha * v
        var s = DenseVector::zeros(n)
        for i in 0..n {
            s.set(i, r.get(i) - alpha * v.get(i))
        }

        // Check early convergence
        let s_norm = s.norm2()
        if s_norm / b_norm < config.tol {
            x.axpy(alpha, &p)
            converged = true
            break
        }

        // t = A * s
        let t = A.mul_vec(&s)

        // omega = (t^T s) / (t^T t)
        let t_s = t.dot(&s)
        let t_t = t.dot(&t)
        if t_t < 1e-30 {
            break
        }
        omega = t_s / t_t

        // x = x + alpha * p + omega * s
        x.axpy(alpha, &p)
        x.axpy(omega, &s)

        // r = s - omega * t
        for i in 0..n {
            r.set(i, s.get(i) - omega * t.get(i))
        }

        // Check convergence
        let r_norm = r.norm2()
        if r_norm / b_norm < config.tol {
            converged = true
            break
        }

        rho = rho_new
    }

    IterativeSolverResult {
        x,
        iterations,
        residual: r.norm2(),
        converged
    }
}

// ============================================================================
// EPISTEMIC LINEAR ALGEBRA (Numerical Accuracy Tracking)
// ============================================================================

/// Linear algebra result with epistemic uncertainty tracking.
/// Wraps numerical results with condition number-based error estimates.
pub struct EpistemicMatrixResult<T> {
    /// The computed value
    pub value: T,
    /// Estimated relative error (based on condition number and machine epsilon)
    pub error_estimate: f64,
    /// Condition number of the problem (if applicable)
    pub condition_number: f64,
    /// Warning if result may be unreliable
    pub warning: Option<string>,
}

impl<T> EpistemicMatrixResult<T> {
    /// Check if result is reliable (error estimate < threshold)
    pub fn is_reliable(&self, threshold: f64) -> bool {
        self.error_estimate < threshold
    }

    /// Get confidence level (1 - relative error)
    pub fn confidence(&self) -> f64 {
        let conf = 1.0 - self.error_estimate
        if conf < 0.0 { 0.0 } else { conf }
    }
}

/// Solve Ax = b with epistemic uncertainty tracking
pub fn epistemic_solve(
    A: &DenseMatrix,
    b: &DenseVector
) -> Result<EpistemicMatrixResult<DenseVector>, string> with Alloc {
    // Compute condition number first
    let cond = match A.condition_number() {
        Ok(c) => c,
        Err(e) => return Err(e)
    }

    // Solve the system
    let x = match A.solve(b) {
        Ok(solution) => solution,
        Err(e) => return Err(e)
    }

    // Machine epsilon for f64
    let eps = 2.220446049250313e-16

    // Estimate relative error: kappa * eps
    let error_estimate = cond * eps

    // Generate warning if ill-conditioned
    let warning = if cond > 1e10 {
        Some("Matrix is ill-conditioned (kappa > 1e10). Results may have significant numerical error.")
    } else if cond > 1e6 {
        Some("Matrix is moderately ill-conditioned. Consider using higher precision.")
    } else {
        None
    }

    Ok(EpistemicMatrixResult {
        value: x,
        error_estimate,
        condition_number: cond,
        warning
    })
}

/// Compute matrix inverse with epistemic uncertainty tracking
pub fn epistemic_inverse(
    A: &DenseMatrix
) -> Result<EpistemicMatrixResult<DenseMatrix>, string> with Alloc {
    let cond = match A.condition_number() {
        Ok(c) => c,
        Err(e) => return Err(e)
    }

    let inv = match A.inverse() {
        Ok(m) => m,
        Err(e) => return Err(e)
    }

    let eps = 2.220446049250313e-16
    let error_estimate = cond * eps

    let warning = if cond > 1e10 {
        Some("Matrix is nearly singular. Inverse may be unreliable.")
    } else {
        None
    }

    Ok(EpistemicMatrixResult {
        value: inv,
        error_estimate,
        condition_number: cond,
        warning
    })
}

/// Eigenvalue decomposition with numerical stability assessment
pub fn epistemic_eig(
    A: &DenseMatrix
) -> Result<EpistemicMatrixResult<EigenDecomposition>, string> with Alloc {
    let eig_result = match A.eig() {
        Ok(e) => e,
        Err(e) => return Err(e)
    }

    // Estimate eigenvalue condition: ||A|| / min(|lambda|)
    let a_norm = A.frobenius_norm()
    var min_eigenvalue = f64::MAX
    let n = eig_result.eigenvalues_real.len()
    for i in 0..n {
        let re = eig_result.eigenvalues_real.get(i)
        let im = eig_result.eigenvalues_imag.get(i)
        let mag = (re * re + im * im).sqrt()
        if mag > 1e-15 && mag < min_eigenvalue {
            min_eigenvalue = mag
        }
    }

    let cond = if min_eigenvalue > 1e-15 {
        a_norm / min_eigenvalue
    } else {
        f64::MAX
    }

    let eps = 2.220446049250313e-16
    let error_estimate = cond * eps

    let warning = if min_eigenvalue < 1e-10 * a_norm {
        Some("Matrix has eigenvalues near zero. Results may be sensitive to perturbations.")
    } else {
        None
    }

    Ok(EpistemicMatrixResult {
        value: eig_result,
        error_estimate,
        condition_number: cond,
        warning
    })
}

