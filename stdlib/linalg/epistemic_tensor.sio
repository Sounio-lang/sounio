// stdlib/linalg/epistemic_tensor.sio — Epistemic Tensors (Rank-3)
//
// Generalizes EpistemicMatrix to batched tensors (batch x rows x cols).
// Max size: batch*rows*cols <= 256 elements.
// GUM-compliant uncertainty propagation through all tensor operations.
//
// When you multiply two epistemic tensors, the uncertainty PROPAGATES
// according to the law of propagation of uncertainty (GUM Section 5.1).
// Confidence DEGRADES monotonically through compositions.
//
// This is the tensor algebra that scientific ML SHOULD have:
// every result knows how uncertain it is.
//
// References:
//   JCGM 100:2008: "Evaluation of measurement data" (GUM)
//   Golub & Van Loan (2013) "Matrix Computations" 4th ed.
//
// # Exemplo
// ```sio
// let a = etensor_constant(1, 2, 2, 1.0);  // 1x2x2 tensor of 1.0
// let b = etensor_measured(1, 2, 2, data, unc, conf);
// let c = etensor_matmul(&a, &b);
// let summary = etensor_confidence_summary(&c);
// assert(summary.min_confidence <= 1.0);
// ```

// =============================================================================
// Math helpers
// =============================================================================

fn sqrt_et(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 20 { y = 0.5 * (y + x / y); i = i + 1 }
    y
}

fn abs_et(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn min_et(a: f64, b: f64) -> f64 {
    if a < b { a } else { b }
}

fn max_et(a: f64, b: f64) -> f64 {
    if a > b { a } else { b }
}

// =============================================================================
// Core Type
// =============================================================================

/// EpistemicTensor - Rank-3 tensor with per-element uncertainty and confidence.
///
/// Each element carries:
/// - value: the point estimate
/// - uncertainty: standard uncertainty (u)
/// - confidence: confidence level [0, 1]
///
/// Storage: flat array of size batch * rows * cols <= 256
/// Index: element (b, i, j) at index b * rows * cols + i * cols + j
pub struct EpistemicTensor {
    values: [f64; 256],
    uncertainties: [f64; 256],
    confidences: [f64; 256],
    batch: i64,
    rows: i64,
    cols: i64,
}

// =============================================================================
// Epistemic Scalar (for reductions)
// =============================================================================

pub struct EpistemicScalar {
    value: f64,
    uncertainty: f64,
    confidence: f64,
}

// =============================================================================
// Constructors
// =============================================================================

/// Create zero tensor with given shape.
pub fn etensor_zeros(batch: i64, rows: i64, cols: i64) -> EpistemicTensor with Panic {
    let total = batch * rows * cols
    if total > 256 { panic("EpistemicTensor: size exceeds 256 elements") }
    EpistemicTensor {
        values: [0.0; 256],
        uncertainties: [0.0; 256],
        confidences: [1.0; 256],
        batch: batch,
        rows: rows,
        cols: cols,
    }
}

/// Create batched identity matrices.
pub fn etensor_identity(batch: i64, n: i64) -> EpistemicTensor with Mut, Div, Panic {
    var m = etensor_zeros(batch, n, n)
    var b = 0
    while b < batch {
        var i = 0
        while i < n {
            let idx = b * n * n + i * n + i
            m.values[idx] = 1.0
            m.uncertainties[idx] = 0.0
            m.confidences[idx] = 1.0
            i = i + 1
        }
        b = b + 1
    }
    m
}

/// Create tensor filled with constant value.
pub fn etensor_constant(batch: i64, rows: i64, cols: i64, val: f64) -> EpistemicTensor with Mut, Div, Panic {
    var m = etensor_zeros(batch, rows, cols)
    let total = batch * rows * cols
    var i = 0
    while i < total {
        m.values[i] = val
        m.uncertainties[i] = 0.0
        m.confidences[i] = 1.0
        i = i + 1
    }
    m
}

// =============================================================================
// Element Access
// =============================================================================

/// Compute flat index from (batch, row, col).
fn etensor_idx(t: &EpistemicTensor, b: i64, r: i64, c: i64) -> i64 {
    b * t.rows * t.cols + r * t.cols + c
}

/// Get value at (b, r, c).
pub fn etensor_get_val(t: &EpistemicTensor, b: i64, r: i64, c: i64) -> f64 with Panic {
    let idx = etensor_idx(t, b, r, c)
    t.values[idx]
}

/// Get uncertainty at (b, r, c).
pub fn etensor_get_unc(t: &EpistemicTensor, b: i64, r: i64, c: i64) -> f64 with Panic {
    let idx = etensor_idx(t, b, r, c)
    t.uncertainties[idx]
}

/// Get confidence at (b, r, c).
pub fn etensor_get_conf(t: &EpistemicTensor, b: i64, r: i64, c: i64) -> f64 with Panic {
    let idx = etensor_idx(t, b, r, c)
    t.confidences[idx]
}

/// Set element with full epistemic metadata.
pub fn etensor_set(
    m: &!EpistemicTensor,
    b: i64, r: i64, c: i64,
    val: f64, unc: f64, conf: f64,
) with Mut, Panic {
    let idx = etensor_idx(m, b, r, c)
    m.values[idx] = val
    m.uncertainties[idx] = unc
    m.confidences[idx] = conf
}

// =============================================================================
// Elementwise Addition — GUM propagation
// =============================================================================

pub fn etensor_add(a: &EpistemicTensor, b: &EpistemicTensor) -> EpistemicTensor with Mut, Div, Panic {
    if a.batch != b.batch || a.rows != b.rows || a.cols != b.cols {
        panic("etensor_add: shape mismatch")
    }
    var c = etensor_zeros(a.batch, a.rows, a.cols)
    var bb = 0
    while bb < a.batch {
        var i = 0
        while i < a.rows {
            var j = 0
            while j < a.cols {
                let idx = etensor_idx(&c, bb, i, j)
                let va = etensor_get_val(a, bb, i, j)
                let vb = etensor_get_val(b, bb, i, j)
                let ua = etensor_get_unc(a, bb, i, j)
                let ub = etensor_get_unc(b, bb, i, j)
                let ca = etensor_get_conf(a, bb, i, j)
                let cb = etensor_get_conf(b, bb, i, j)
                
                c.values[idx] = va + vb
                c.uncertainties[idx] = sqrt_et(ua * ua + ub * ub)
                c.confidences[idx] = min_et(ca, cb)
                j = j + 1
            }
            i = i + 1
        }
        bb = bb + 1
    }
    c
}

// =============================================================================
// Elementwise Subtraction
// =============================================================================

pub fn etensor_sub(a: &EpistemicTensor, b: &EpistemicTensor) -> EpistemicTensor with Mut, Div, Panic {
    if a.batch != b.batch || a.rows != b.rows || a.cols != b.cols {
        panic("etensor_sub: shape mismatch")
    }
    var c = etensor_zeros(a.batch, a.rows, a.cols)
    var bb = 0
    while bb < a.batch {
        var i = 0
        while i < a.rows {
            var j = 0
            while j < a.cols {
                let idx = etensor_idx(&c, bb, i, j)
                let va = etensor_get_val(a, bb, i, j)
                let vb = etensor_get_val(b, bb, i, j)
                let ua = etensor_get_unc(a, bb, i, j)
                let ub = etensor_get_unc(b, bb, i, j)
                let ca = etensor_get_conf(a, bb, i, j)
                let cb = etensor_get_conf(b, bb, i, j)
                
                c.values[idx] = va - vb
                c.uncertainties[idx] = sqrt_et(ua * ua + ub * ub)
                c.confidences[idx] = min_et(ca, cb)
                j = j + 1
            }
            i = i + 1
        }
        bb = bb + 1
    }
    c
}

// =============================================================================
// Scalar Operations
// =============================================================================

/// Scale by constant: u(c*A) = |c| * u(A), conf unchanged.
pub fn etensor_scale(m: &EpistemicTensor, scalar: f64) -> EpistemicTensor with Mut, Div, Panic {
    var result = etensor_zeros(m.batch, m.rows, m.cols)
    let as_val = abs_et(scalar)
    let total = m.batch * m.rows * m.cols
    var i = 0
    while i < total {
        result.values[i] = scalar * m.values[i]
        result.uncertainties[i] = as_val * m.uncertainties[i]
        result.confidences[i] = m.confidences[i]
        i = i + 1
    }
    result
}

// =============================================================================
// Batch Matrix Multiplication — GUM quadrature propagation
// =============================================================================

pub fn etensor_matmul(a: &EpistemicTensor, b: &EpistemicTensor) -> EpistemicTensor with Mut, Div, Panic {
    if a.batch != b.batch {
        panic("etensor_matmul: batch dimension mismatch")
    }
    if a.cols != b.rows {
        panic("etensor_matmul: inner dimension mismatch")
    }
    
    var c = etensor_zeros(a.batch, a.rows, b.cols)
    let k_inner = a.cols
    
    var bb = 0
    while bb < a.batch {
        var i = 0
        while i < a.rows {
            var j = 0
            while j < b.cols {
                var sum_val: f64 = 0.0
                var sum_unc_sq: f64 = 0.0
                var min_conf: f64 = 1.0
                
                var l = 0
                while l < k_inner {
                    let a_val = etensor_get_val(a, bb, i, l)
                    let b_val = etensor_get_val(b, bb, l, j)
                    let ua = etensor_get_unc(a, bb, i, l)
                    let ub = etensor_get_unc(b, bb, l, j)
                    let ca = etensor_get_conf(a, bb, i, l)
                    let cb = etensor_get_conf(b, bb, l, j)
                    
                    sum_val = sum_val + a_val * b_val
                    sum_unc_sq = sum_unc_sq + ua * ua * b_val * b_val + a_val * a_val * ub * ub
                    min_conf = min_et(min_conf, min_et(ca, cb))
                    
                    l = l + 1
                }
                
                let idx = etensor_idx(&c, bb, i, j)
                c.values[idx] = sum_val
                c.uncertainties[idx] = sqrt_et(sum_unc_sq)
                c.confidences[idx] = min_conf
                
                j = j + 1
            }
            i = i + 1
        }
        bb = bb + 1
    }
    c
}

// =============================================================================
// Transpose (per batch slice)
// =============================================================================

pub fn etensor_transpose(m: &EpistemicTensor) -> EpistemicTensor with Mut, Div, Panic {
    var result = etensor_zeros(m.batch, m.cols, m.rows)
    var bb = 0
    while bb < m.batch {
        var i = 0
        while i < m.rows {
            var j = 0
            while j < m.cols {
                let src = etensor_idx(m, bb, i, j)
                let dst = etensor_idx(&result, bb, j, i)
                result.values[dst] = m.values[src]
                result.uncertainties[dst] = m.uncertainties[src]
                result.confidences[dst] = m.confidences[src]
                j = j + 1
            }
            i = i + 1
        }
        bb = bb + 1
    }
    result
}

// =============================================================================
// Frobenius Norm (with uncertainty)
// =============================================================================

pub fn etensor_frobenius(m: &EpistemicTensor) -> EpistemicScalar with Mut, Div, Panic {
    var sum_sq: f64 = 0.0
    var sum_unc_sq: f64 = 0.0
    var min_conf: f64 = 1.0
    
    let total = m.batch * m.rows * m.cols
    var i = 0
    while i < total {
        let v = m.values[i]
        let u = m.uncertainties[i]
        sum_sq = sum_sq + v * v
        sum_unc_sq = sum_unc_sq + 4.0 * v * v * u * u
        min_conf = min_et(min_conf, m.confidences[i])
        i = i + 1
    }
    
    let norm = sqrt_et(sum_sq)
    let norm_unc = if norm > 1.0e-30 { sqrt_et(sum_unc_sq) / (2.0 * norm) } else { 0.0 }
    
    EpistemicScalar {
        value: norm,
        uncertainty: norm_unc,
        confidence: min_conf,
    }
}

// =============================================================================
// Confidence Summary
// =============================================================================

pub struct TensorConfidenceSummary {
    min_confidence: f64,
    max_confidence: f64,
    mean_confidence: f64,
    max_relative_uncertainty: f64,
}

pub fn etensor_confidence_summary(m: &EpistemicTensor) -> TensorConfidenceSummary with Mut, Div, Panic {
    var min_c: f64 = 1.0
    var max_c: f64 = 0.0
    var sum_c: f64 = 0.0
    var max_rel: f64 = 0.0
    let n = m.batch * m.rows * m.cols
    
    var i = 0
    while i < n {
        let c = m.confidences[i]
        if c < min_c { min_c = c }
        if c > max_c { max_c = c }
        sum_c = sum_c + c
        
        let v = abs_et(m.values[i])
        if v > 1.0e-30 {
            let rel = m.uncertainties[i] / v
            if rel > max_rel { max_rel = rel }
        }
        i = i + 1
    }
    
    TensorConfidenceSummary {
        min_confidence: min_c,
        max_confidence: max_c,
        mean_confidence: sum_c / (n as f64),
        max_relative_uncertainty: max_rel,
    }
}

// =============================================================================
// SVD Approximation with GUM propagation
// =============================================================================

pub fn etensor_svd_approx(m: &EpistemicTensor, batch_idx: i64) -> [EpistemicScalar; 16] with Mut, Div, Panic {
    if batch_idx < 0 || batch_idx >= m.batch {
        panic("etensor_svd_approx: invalid batch index")
    }
    
    var sigmas: [EpistemicScalar; 16] = [
        EpistemicScalar { value: 0.0, uncertainty: 0.0, confidence: 0.0 }; 16
    ]
    
    // Compute Frobenius norm of slice for energy estimate
    var sum_sq: f64 = 0.0
    var sum_unc_sq: f64 = 0.0
    var min_conf: f64 = 1.0
    
    var i = 0
    while i < m.rows {
        var j = 0
        while j < m.cols {
            let idx = etensor_idx(m, batch_idx, i, j)
            let v = m.values[idx]
            let u = m.uncertainties[idx]
            sum_sq = sum_sq + v * v
            sum_unc_sq = sum_unc_sq + 4.0 * v * v * u * u
            min_conf = min_et(min_conf, m.confidences[idx])
            j = j + 1
        }
        i = i + 1
    }
    
    let frob = sqrt_et(sum_sq)
    let frob_unc = if frob > 1.0e-30 { sqrt_et(sum_unc_sq) / (2.0 * frob) } else { 0.0 }
    
    let n = if m.rows < m.cols { m.rows } else { m.cols }
    let n_f = n as f64
    
    var k = 0
    while k < n {
        let decay = 1.0 - (k as f64) / (n_f + 1.0) * 0.3
        sigmas[k as usize] = EpistemicScalar {
            value: frob / sqrt_et(n_f) * decay,
            uncertainty: frob_unc / sqrt_et(n_f) * (2.0 - decay),
            confidence: min_conf,
        }
        k = k + 1
    }
    
    sigmas
}

// =============================================================================
// Tests
// =============================================================================

fn test_etensor_add_gum() with Mut, Div, Panic {
    var a = etensor_zeros(1, 2, 2)
    var b = etensor_zeros(1, 2, 2)
    
    etensor_set(&!a, 0, 0, 0, 1.0, 0.1, 0.95)
    etensor_set(&!b, 0, 0, 0, 2.0, 0.2, 0.90)
    
    let c = etensor_add(&a, &b)
    
    let val = etensor_get_val(&c, 0, 0, 0)
    let unc = etensor_get_unc(&c, 0, 0, 0)
    let conf = etensor_get_conf(&c, 0, 0, 0)
    
    assert(val > 2.99 && val < 3.01)
    
    let expected_unc = sqrt_et(0.01 + 0.04)
    assert(unc > expected_unc - 0.01 && unc < expected_unc + 0.01)
    
    assert(conf > 0.89 && conf < 0.91)
}

fn test_etensor_matmul_gum() with Mut, Div, Panic {
    var a = etensor_zeros(1, 2, 2)
    var b = etensor_zeros(1, 2, 2)
    
    etensor_set(&!a, 0, 0, 0, 1.0, 0.1, 0.95)
    etensor_set(&!a, 0, 0, 1, 0.0, 0.0, 1.0)
    etensor_set(&!a, 0, 1, 0, 0.0, 0.0, 1.0)
    etensor_set(&!a, 0, 1, 1, 1.0, 0.1, 0.95)
    
    etensor_set(&!b, 0, 0, 0, 2.0, 0.2, 0.90)
    etensor_set(&!b, 0, 0, 1, 0.0, 0.0, 1.0)
    etensor_set(&!b, 0, 1, 0, 0.0, 0.0, 1.0)
    etensor_set(&!b, 0, 1, 1, 2.0, 0.2, 0.90)
    
    let c = etensor_matmul(&a, &b)
    
    let val = etensor_get_val(&c, 0, 0, 0)
    let unc = etensor_get_unc(&c, 0, 0, 0)
    
    assert(val > 1.99 && val < 2.01)
    let expected_unc = sqrt_et(0.08)
    assert(unc > expected_unc - 0.01 && unc < expected_unc + 0.01)
}

fn test_etensor_chain_degradation() with Mut, Div, Panic {
    var a = etensor_constant(1, 2, 2, 1.0)
    etensor_set(&!a, 0, 0, 0, 1.0, 0.1, 0.95)
    etensor_set(&!a, 0, 0, 1, 1.0, 0.1, 0.90)
    etensor_set(&!a, 0, 1, 0, 1.0, 0.1, 0.85)
    etensor_set(&!a, 0, 1, 1, 1.0, 0.1, 0.80)
    
    var b = etensor_constant(1, 2, 2, 1.0)
    
    let ab = etensor_matmul(&a, &b)
    let abc = etensor_matmul(&ab, &b)
    
    let summary_a = etensor_confidence_summary(&a)
    let summary_abc = etensor_confidence_summary(&abc)
    
    assert(summary_abc.min_confidence <= summary_a.min_confidence)
}

pub fn main() with Mut, Div, Panic {
    test_etensor_add_gum()
    test_etensor_matmul_gum()
    test_etensor_chain_degradation()
}
