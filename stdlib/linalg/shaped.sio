// stdlib/linalg/shaped.sio — Shape-Typed Linear Algebra Utilities
// Sprint 23 Track V: Vec<T,n>, Matrix<T,m,n> shape-safe operations
//
// References:
//   Golub & Van Loan (2013) "Matrix Computations" 4th ed.
//   Henriksen et al. (2017) PLDI "Futhark"
//   Trefethen & Bau (1997) "Numerical Linear Algebra"

// ============================================================
// Shape validation helpers
// ============================================================

fn matmul_shapes_valid(left_rows: i64, left_cols: i64, right_rows: i64, right_cols: i64) -> bool with IO {
    // Matrix multiply valid iff left_cols == right_rows
    if left_cols == -1 { return true }
    if right_rows == -1 { return true }
    left_cols == right_rows
}

fn cholesky_shape_valid(m: i64, n: i64) -> bool with IO {
    // Cholesky requires square matrix
    m == n || m == -1 || n == -1
}

fn qr_shape_valid(m: i64, n: i64) -> bool with IO {
    // QR requires m >= n (overdetermined)
    if m == -1 || n == -1 { return true }
    m >= n
}

fn broadcast_shape_compatible(a_m: i64, a_n: i64, b_m: i64, b_n: i64) -> bool with IO {
    // NumPy broadcast: dim of 1 broadcasts to any
    let m_ok = (a_m == 1) || (b_m == 1) || (a_m == b_m) || (a_m == -1) || (b_m == -1)
    let n_ok = (a_n == 1) || (b_n == 1) || (a_n == b_n) || (a_n == -1) || (b_n == -1)
    m_ok && n_ok
}

// ============================================================
// Dot product (Vec<f64, n>)
// ============================================================

fn dot_8(v1: [f64; 8], v2: [f64; 8], n: i64) -> f64 with IO, Div, Mut, Panic {
    var s: f64 = 0.0
    var i: i64 = 0
    while i < n && i < 8 {
        s = s + v1[i as usize] * v2[i as usize]
        i = i + 1
    }
    s
}

fn vec_norm_8(v: [f64; 8], n: i64) -> f64 with IO, Div, Mut, Panic {
    let sq = dot_8(v, v, n)
    if sq <= 0.0 { return 0.0 }
    var y = sq / 2.0
    var i: i64 = 0
    while i < 20 {
        y = (y + sq / y) / 2.0
        i = i + 1
    }
    y
}

// ============================================================
// Frobenius norm (Matrix<f64, m, n>)
// ============================================================

fn frobenius_norm(vals: [f64; 16], m: i64, n: i64) -> f64 with IO, Div, Mut, Panic {
    var s: f64 = 0.0
    let total = m * n
    var i: i64 = 0
    while i < total && i < 16 {
        s = s + vals[i as usize] * vals[i as usize]
        i = i + 1
    }
    if s <= 0.0 { return 0.0 }
    var y = s / 2.0
    var j: i64 = 0
    while j < 20 {
        y = (y + s / y) / 2.0
        j = j + 1
    }
    y
}

// ============================================================
// Kronecker product shape: (m1 x n1) otimes (m2 x n2) = (m1*m2 x n1*n2)
// ============================================================

fn kronecker_product_rows(m1: i64, m2: i64) -> i64 with IO { m1 * m2 }
fn kronecker_product_cols(n1: i64, n2: i64) -> i64 with IO { n1 * n2 }

// ============================================================
// Hadamard product shape check: requires same shape
// ============================================================

fn hadamard_shape_valid(m1: i64, n1: i64, m2: i64, n2: i64) -> bool with IO {
    (m1 == m2 || m1 == -1 || m2 == -1) && (n1 == n2 || n1 == -1 || n2 == -1)
}

// ============================================================
// Cholesky forward substitution (for Lx = b where L is lower-triangular 2x2)
// ============================================================

fn cholesky_forward_sub_2x2(l11: f64, l21: f64, l22: f64, b1: f64, b2: f64) -> [f64; 2] with IO, Div, Panic {
    let x1 = b1 / l11
    let x2 = (b2 + (0.0 - l21 * x1)) / l22
    [x1, x2]
}

// ============================================================
// QR via Gram-Schmidt (3x2 = 3 rows, 2 cols, m >= n check)
// ============================================================

fn gram_schmidt_3x2_col0(col0: [f64; 3]) -> [f64; 3] with IO, Div, Mut, Panic {
    // Normalize first column
    let n = col0[0]*col0[0] + col0[1]*col0[1] + col0[2]*col0[2]
    var y = n / 2.0
    var i: i64 = 0
    while i < 20 { if y > 0.0 { y = (y + n / y) / 2.0 } i = i + 1 }
    [col0[0]/y, col0[1]/y, col0[2]/y]
}
