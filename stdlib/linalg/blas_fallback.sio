// stdlib/linalg/blas_fallback.sio
// Pure Sounio fallback implementations for BLAS Level 1-3
//
// Uses fixed arrays. Suitable for small matrices (n < 16).

fn bls_abs_f64(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn bls_sqrt_f64(x: f64) -> f64 {
    if x <= 0.0 { return 0.0 }
    var y = x
    var iter: i64 = 0
    while iter < 20 {
        y = 0.5 * (y + x / y)
        iter = iter + 1
    }
    return y
}

// DAXPY: y = alpha * x + y
fn daxpy_fallback(n: i64, alpha: f64, x: [f64; 64], y: &![f64; 64]) {
    if alpha == 0.0 { return }
    var i: i64 = 0
    while i < n {
        y[i] = y[i] + alpha * x[i]
        i = i + 1
    }
}

// DDOT: dot product
fn ddot_fallback(n: i64, x: [f64; 64], y: [f64; 64]) -> f64 {
    var result = 0.0
    var i: i64 = 0
    while i < n {
        result = result + x[i] * y[i]
        i = i + 1
    }
    return result
}

// DNRM2: Euclidean norm
fn dnrm2_fallback(n: i64, x: [f64; 64]) -> f64 {
    var sum = 0.0
    var scale = 0.0
    var i: i64 = 0
    while i < n {
        let val = bls_abs_f64(x[i])
        if val > 0.0 {
            if scale < val {
                let ratio = scale / val
                sum = 1.0 + sum * ratio * ratio
                scale = val
            } else {
                let ratio = val / scale
                sum = sum + ratio * ratio
            }
        }
        i = i + 1
    }
    return scale * bls_sqrt_f64(sum)
}

// DSCAL: x = alpha * x
fn dscal_fallback(n: i64, alpha: f64, x: &![f64; 64]) {
    var i: i64 = 0
    while i < n {
        x[i] = alpha * x[i]
        i = i + 1
    }
}

// DASUM: sum of absolute values
fn dasum_fallback(n: i64, x: [f64; 64]) -> f64 {
    var sum = 0.0
    var i: i64 = 0
    while i < n {
        sum = sum + bls_abs_f64(x[i])
        i = i + 1
    }
    return sum
}

// IDAMAX: index of max absolute value
fn idamax_fallback(n: i64, x: [f64; 64]) -> i64 {
    if n <= 0 { return 0 }
    var max_idx: i64 = 0
    var max_val = bls_abs_f64(x[0])
    var i: i64 = 1
    while i < n {
        let val = bls_abs_f64(x[i])
        if val > max_val {
            max_val = val
            max_idx = i
        }
        i = i + 1
    }
    return max_idx
}

// DCOPY: y = x
fn dcopy_fallback(n: i64, x: [f64; 64], y: &![f64; 64]) {
    var i: i64 = 0
    while i < n {
        y[i] = x[i]
        i = i + 1
    }
}

// DSWAP: swap x and y
fn dswap_fallback(n: i64, x: &![f64; 64], y: &![f64; 64]) {
    var i: i64 = 0
    while i < n {
        let temp = x[i]
        x[i] = y[i]
        y[i] = temp
        i = i + 1
    }
}

// DGEMV: y = alpha * A * x + beta * y (row-major, no transpose)
// A is [m x n], x is [n], y is [m]
fn dgemv_fallback(m: i64, n: i64, alpha: f64, a: [f64; 256], x: [f64; 64], beta: f64, y: &![f64; 64]) {
    // Scale y by beta
    if beta != 1.0 {
        var i: i64 = 0
        while i < m {
            y[i] = beta * y[i]
            i = i + 1
        }
    }
    if alpha == 0.0 { return }

    var i: i64 = 0
    while i < m {
        var sum = 0.0
        var j: i64 = 0
        while j < n {
            sum = sum + a[i * n + j] * x[j]
            j = j + 1
        }
        y[i] = y[i] + alpha * sum
        i = i + 1
    }
}

// DGEMM: C = alpha * A * B + beta * C (row-major, no transpose)
// A is [m x k], B is [k x n], C is [m x n]
fn dgemm_fallback(m: i64, n: i64, k: i64, alpha: f64, a: [f64; 256], b: [f64; 256], beta: f64, c: &![f64; 256]) {
    // Scale C by beta
    var i: i64 = 0
    while i < m {
        var j: i64 = 0
        while j < n {
            c[i * n + j] = beta * c[i * n + j]
            j = j + 1
        }
        i = i + 1
    }
    if alpha == 0.0 { return }

    i = 0
    while i < m {
        var j: i64 = 0
        while j < n {
            var sum = 0.0
            var l: i64 = 0
            while l < k {
                sum = sum + a[i * k + l] * b[l * n + j]
                l = l + 1
            }
            c[i * n + j] = c[i * n + j] + alpha * sum
            j = j + 1
        }
        i = i + 1
    }
}

fn blas_fallback_approx_eq(a: f64, b: f64, eps: f64) -> i64 {
    let diff = a - b
    let ad = if diff < 0.0 { 0.0 - diff } else { diff }
    if ad < eps { return 1 }
    return 0
}
