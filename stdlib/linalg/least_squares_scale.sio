// Shared scalar restoration for bounded least-squares kernels.
use math::pure::{is_finite}
pub struct LeastSquaresNumber {
    pub status: i64,
    pub value: f64,
}
fn least_squares_scale_abs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }
// Restore one normalized scalar. Try three orders rather than overflowing
// a scale ratio or silently losing a nonzero final value to underflow.
pub fn least_squares_restore(value: f64, factor: f64, divisor: f64) -> LeastSquaresNumber with Mut, Div, Panic {
    if value == 0.0 { return LeastSquaresNumber { status: 0, value: 0.0 } }
    let product = value * factor
    if is_finite(product) && least_squares_scale_abs(product) >= 2.2250738585072014e-308 {
        let first = product / divisor
        if is_finite(first) && first != 0.0 { return LeastSquaresNumber { status: 0, value: first } }
    }
    let quotient = value / divisor
    if is_finite(quotient) && least_squares_scale_abs(quotient) >= 2.2250738585072014e-308 {
        let second = quotient * factor
        if is_finite(second) && second != 0.0 { return LeastSquaresNumber { status: 0, value: second } }
    }
    let ratio = factor / divisor
    if is_finite(ratio) && ratio >= 2.2250738585072014e-308 {
        let third = value * ratio
        if is_finite(third) && third != 0.0 { return LeastSquaresNumber { status: 0, value: third } }
    }
    LeastSquaresNumber { status: 4, value: 0.0 }
}

struct LeastSquaresScaleParts {
    mantissa: f64,
    exponent: i64,
}
// Nonzero finite input. Exact binary power scaling, without logarithms.
fn least_squares_scale_parts(value: f64) -> LeastSquaresScaleParts with Mut, Div, Panic {
    var mantissa = least_squares_scale_abs(value)
    var exponent: i64 = 0
    while mantissa >= 2.0 { mantissa = mantissa * 0.5; exponent = exponent + 1 }
    while mantissa < 1.0 { mantissa = mantissa * 2.0; exponent = exponent - 1 }
    LeastSquaresScaleParts { mantissa: mantissa, exponent: exponent }
}
// Balanced six-factor scaling. Final IEEE underflow to zero is allowed;
// callers decide whether such a zero makes their own output unavailable.
pub fn least_squares_scaled_product(value: f64, multiplier1: f64, multiplier2: f64,
    divisor1: f64, divisor2: f64, divisor3: f64) -> LeastSquaresNumber with Mut, Div, Panic {
    if !is_finite(value) || !is_finite(multiplier1) || !is_finite(multiplier2) ||
       !is_finite(divisor1) || !is_finite(divisor2) || !is_finite(divisor3) {
        return LeastSquaresNumber { status: 4, value: 0.0 }
    }
    if multiplier1 < 0.0 || multiplier2 < 0.0 ||
       divisor1 <= 0.0 || divisor2 <= 0.0 || divisor3 <= 0.0 {
        return LeastSquaresNumber { status: 4, value: 0.0 }
    }
    if value == 0.0 || multiplier1 == 0.0 || multiplier2 == 0.0 {
        return LeastSquaresNumber { status: 0, value: 0.0 }
    }
    let v = least_squares_scale_parts(value)
    let a = least_squares_scale_parts(multiplier1)
    let b = least_squares_scale_parts(multiplier2)
    let c = least_squares_scale_parts(divisor1)
    let d = least_squares_scale_parts(divisor2)
    let f = least_squares_scale_parts(divisor3)
    var mantissa = ((v.mantissa * a.mantissa) * b.mantissa) /
        ((c.mantissa * d.mantissa) * f.mantissa)
    var exponent: i64 = v.exponent + a.exponent + b.exponent -
        c.exponent - d.exponent - f.exponent
    while mantissa >= 2.0 { mantissa = mantissa * 0.5; exponent = exponent + 1 }
    while mantissa < 1.0 { mantissa = mantissa * 2.0; exponent = exponent - 1 }
    if exponent > 1023 { return LeastSquaresNumber { status: 4, value: 0.0 } }
    if exponent < -1075 { return LeastSquaresNumber { status: 0, value: 0.0 } }
    var factor: f64 = 1.0
    var result: f64 = 0.0
    var j: i64 = 0
    if exponent < -1022 {
        // First product remains normal and exact; only the final multiply
        // rounds into the subnormal range, including the half-minimum tie.
        let normal = mantissa * 2.2250738585072014e-308
        let shift: i64 = 0 - (exponent + 1022)
        while j < shift { factor = factor * 0.5; j = j + 1 }
        result = normal * factor
    } else {
        if exponent >= 0 {
            while j < exponent { factor = factor * 2.0; j = j + 1 }
        } else {
            while j < (0 - exponent) { factor = factor * 0.5; j = j + 1 }
        }
        result = mantissa * factor
    }
    if !is_finite(result) { return LeastSquaresNumber { status: 4, value: 0.0 } }
    if value < 0.0 { result = -result }
    LeastSquaresNumber { status: 0, value: result }
}
