// stdlib/linalg/slice_ops.sio — Fixed-size linear algebra operations
//
// Pure Sounio implementations of fundamental BLAS-like operations on
// fixed-size f64 arrays: dot product, norms, scaling, AXPY, matrix-vector,
// matrix-matrix multiply, and transpose.
//
// All operations take an explicit size parameter n (or m, k) so the same
// fixed-size buffer can be used for different logical dimensions.
//
// References:
//   Lawson, Hanson, Kincaid, Krogh (1979): "Basic Linear Algebra
//     Subprograms for Fortran Usage" ACM TOMS 5(3)
//   Golub & Van Loan (2013): "Matrix Computations" (4th ed.)

// ============================================================================
// VECTOR OPERATIONS
// ============================================================================

// Dot product of two f64 arrays (first n elements).
pub fn slop_dot(a: &[f64; 64], b: &[f64; 64], n: i32) -> f64 with Mut, Panic {
    var sum: f64 = 0.0
    var i: i32 = 0
    while i < n {
        sum = sum + a[i] * b[i]
        i = i + 1
    }
    sum
}

// Euclidean (L2) norm of first n elements.
pub fn slop_norm(a: &[f64; 64], n: i32) -> f64 with Mut, Div, Panic {
    var sum: f64 = 0.0
    var i: i32 = 0
    while i < n {
        sum = sum + a[i] * a[i]
        i = i + 1
    }
    slop_sqrt(sum)
}

// Scale: out[i] = alpha * a[i] for first n elements.
pub fn slop_scale(a: &[f64; 64], alpha: f64, out: &![f64; 64], n: i32) with Mut, Panic {
    var i: i32 = 0
    while i < n {
        out[i] = alpha * a[i]
        i = i + 1
    }
}

// AXPY: out[i] = alpha * a[i] + b[i] for first n elements.
pub fn slop_axpy(alpha: f64, a: &[f64; 64], b: &[f64; 64], out: &![f64; 64], n: i32) with Mut, Panic {
    var i: i32 = 0
    while i < n {
        out[i] = alpha * a[i] + b[i]
        i = i + 1
    }
}

// ============================================================================
// MATRIX OPERATIONS (row-major, flat storage in [f64; 4096])
// ============================================================================

// Matrix-vector multiply: out = A * x
// A is m x n stored row-major in a[0..m*n], x is n-vector, out is m-vector.
pub fn slop_matvec(a: &[f64; 4096], x: &[f64; 64], out: &![f64; 64],
                   m: i32, n: i32) with Mut, Panic {
    var i: i32 = 0
    while i < m {
        var sum: f64 = 0.0
        var j: i32 = 0
        while j < n {
            sum = sum + a[i * n + j] * x[j]
            j = j + 1
        }
        out[i] = sum
        i = i + 1
    }
}

// Matrix-matrix multiply: C = A * B
// A is m x k, B is k x n, C is m x n. All stored row-major in [f64; 4096].
pub fn slop_matmul(a: &[f64; 4096], b: &[f64; 4096], c: &![f64; 4096],
                   m: i32, k: i32, n: i32) with Mut, Panic {
    var i: i32 = 0
    while i < m {
        var j: i32 = 0
        while j < n {
            var sum: f64 = 0.0
            var p: i32 = 0
            while p < k {
                sum = sum + a[i * k + p] * b[p * n + j]
                p = p + 1
            }
            c[i * n + j] = sum
            j = j + 1
        }
        i = i + 1
    }
}

// Transpose: B = A^T where A is m x n, B is n x m.
// Both stored row-major in [f64; 4096].
pub fn slop_transpose(a: &[f64; 4096], b: &![f64; 4096], m: i32, n: i32) with Mut, Panic {
    var i: i32 = 0
    while i < m {
        var j: i32 = 0
        while j < n {
            b[j * m + i] = a[i * n + j]
            j = j + 1
        }
        i = i + 1
    }
}

// ============================================================================
// INTERNAL HELPERS
// ============================================================================

// Newton-Raphson square root (60 iterations, no FFI dependency).
fn slop_sqrt(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    if y < 1.0 { y = 1.0 }
    var i: i32 = 0
    while i < 60 {
        y = 0.5 * (y + x / y)
        i = i + 1
    }
    y
}
