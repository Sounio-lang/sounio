// stdlib::tensor2::types - Tensor v2 core types.
//
// Tensor v2 replaces the f64-only, manually-freed v1 tensor
// (stdlib/tensor/types.sio) for ML/DL and LLM work:
//   - dtype: f32 / f16 / bf16 / f64 / i32 / i64 / u8, stored as real bytes
//     (low-precision dtypes are encoded IEEE-754, see convert.sio - they are
//     NOT f64 in disguise, so memory and rounding match GPU tensors).
//   - device: a code today (CPU reference), a Backend device id from Fase 2.
//   - storage: byte buffer shared by views/clones with a refcount; the last
//     release frees it. No manual free of shared tensors.
// Design: docs/design/heterogeneous-gpu-framework.md

pub fn t2_dtype_f32() -> i32 { 1 }
pub fn t2_dtype_f16() -> i32 { 2 }
pub fn t2_dtype_bf16() -> i32 { 3 }
pub fn t2_dtype_i32() -> i32 { 4 }
pub fn t2_dtype_i64() -> i32 { 5 }
pub fn t2_dtype_u8() -> i32 { 6 }
pub fn t2_dtype_f64() -> i32 { 7 }

pub fn t2_device_cpu() -> i32 { 0 }

pub struct T2Shape {
    pub rank: usize,
    pub dims: [usize; 8],
    pub strides: [usize; 8],
    pub len: usize,
}

pub struct Tensor2 {
    pub data: *mut u8,
    pub rc: *mut i64,
    pub offset: i64,
    pub shape: T2Shape,
    pub dtype: i32,
    pub device: i32,
    pub owner: bool,
}

/// Bytes per element of a Tensor v2 dtype code.
///
/// # Parameters
/// - `dtype`: dtype code (`t2_dtype_*`).
///
/// # Return
/// 4 for f32/i32, 2 for f16/bf16, 8 for f64/i64, 1 for u8.
///
/// # Complexity
/// O(1)
pub fn t2_dtype_bytes(dtype: i32) -> i64 {
    if dtype == t2_dtype_f32() { return 4 }
    if dtype == t2_dtype_i32() { return 4 }
    if dtype == t2_dtype_f16() { return 2 }
    if dtype == t2_dtype_bf16() { return 2 }
    if dtype == t2_dtype_f64() { return 8 }
    if dtype == t2_dtype_i64() { return 8 }
    1
}

pub fn t2_shape_scalar() -> T2Shape {
    T2Shape { rank: 0 as usize, dims: [0 as usize; 8], strides: [0 as usize; 8], len: 1 as usize }
}

pub fn t2_shape1(d0: usize) -> T2Shape with Mut, Panic, Div {
    var dims = [0 as usize; 8]
    dims[0] = d0
    t2_shape_from(dims, 1 as usize)
}

pub fn t2_shape2(d0: usize, d1: usize) -> T2Shape with Mut, Panic, Div {
    var dims = [0 as usize; 8]
    dims[0] = d0
    dims[1] = d1
    t2_shape_from(dims, 2 as usize)
}

pub fn t2_shape3(d0: usize, d1: usize, d2: usize) -> T2Shape with Mut, Panic, Div {
    var dims = [0 as usize; 8]
    dims[0] = d0
    dims[1] = d1
    dims[2] = d2
    t2_shape_from(dims, 3 as usize)
}

pub fn t2_shape_from(dims: [usize; 8], rank: usize) -> T2Shape with Mut, Panic, Div {
    if rank > 8 as usize { assert(false) }
    var out_dims = [0 as usize; 8]
    var i: usize = 0 as usize
    while i < rank {
        out_dims[i] = dims[i]
        i = i + 1 as usize
    }
    var strides = [0 as usize; 8]
    var len: usize = 1 as usize
    if rank == 0 as usize { len = 1 as usize }
    var stride: usize = 1 as usize
    var k = rank
    while k > 0 as usize {
        k = k - 1 as usize
        strides[k] = stride
        stride = stride * out_dims[k]
    }
    if rank > 0 as usize { len = stride }
    T2Shape { rank: rank, dims: out_dims, strides: strides, len: len }
}

pub fn t2_shape_eq(a: T2Shape, b: T2Shape) -> bool with Mut {
    if a.rank != b.rank { return false }
    var i: usize = 0 as usize
    while i < a.rank {
        if a.dims[i] != b.dims[i] { return false }
        i = i + 1 as usize
    }
    true
}
