//! stdlib/tensor2 — Tensor v2: dtype/device-aware tensor with refcounted storage.
//!
//! The canonical tensor for ML/DL and LLM work (Fase 1 of
//! docs/design/heterogeneous-gpu-framework.md). v1 (stdlib/tensor) remains
//! for existing consumers; new ML code uses Tensor2.

module tensor2

pub use tensor2::types::{
    T2Shape,
    Tensor2,
    t2_device_cpu,
    t2_dtype_bf16,
    t2_dtype_bytes,
    t2_dtype_f16,
    t2_dtype_f32,
    t2_dtype_f64,
    t2_dtype_i32,
    t2_dtype_i64,
    t2_dtype_u8,
    t2_shape1,
    t2_shape2,
    t2_shape3,
    t2_shape_eq,
    t2_shape_from,
    t2_shape_scalar,
}

pub use tensor2::convert::{
    bf16_bits_to_f64,
    f16_bits_to_f64,
    f32_bits_to_f64,
    f64_to_bf16_bits,
    f64_to_f16_bits,
    f64_to_f32_bits,
}

pub use tensor2::ops::{
    t2_add,
    t2_alloc,
    t2_clone_shared,
    t2_full,
    t2_get,
    t2_get2,
    t2_matmul,
    t2_mul,
    t2_refcount,
    t2_release,
    t2_rmsnorm_rows,
    t2_set,
    t2_set2,
    t2_softmax_rows,
    t2_sum_all,
    t2_transpose2,
    t2_zeros,
}

pub use tensor2::cpu_kernel::{
    CpuBuf,
    ck_alloc,
    ck_fill_pattern,
    ck_gemm,
    ck_gemv,
    ck_gemm_rows,
    ck_get,
    ck_max_abs_diff,
    ck_set,
    ck_zero,
}
