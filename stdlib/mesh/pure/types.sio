// stdlib/mesh/pure/types.sio — Mesh Types
//
// Fixed-capacity mesh for 3D graphics.

pub struct Mesh {
    pub n_vertices: i32,
    pub n_faces: i32,
    pub vertices: [f64; 768],  // max 256 vertices * 3 (x,y,z)
    pub faces: [i32; 384],     // max 128 faces * 3 (indices)
}

pub fn mesh_new() -> Mesh {
    Mesh { n_vertices: 0, n_faces: 0, vertices: [0.0; 768], faces: [0; 384] }
}

pub fn mesh_add_vertex(m: &! Mesh, x: f64, y: f64, z: f64) with Mut {
    if m.n_vertices < 256 {
        let i = m.n_vertices as usize
        m.vertices[i * 3] = x
        m.vertices[i * 3 + 1] = y
        m.vertices[i * 3 + 2] = z
        m.n_vertices = m.n_vertices + 1
    }
}

pub fn mesh_add_face(m: &! Mesh, i0: i32, i1: i32, i2: i32) with Mut {
    if m.n_faces < 128 {
        let i = m.n_faces as usize
        m.faces[i * 3] = i0
        m.faces[i * 3 + 1] = i1
        m.faces[i * 3 + 2] = i2
        m.n_faces = m.n_faces + 1
    }
}

pub fn mesh_vertex_count(m: &Mesh) -> i32 { m.n_vertices }

pub fn mesh_face_count(m: &Mesh) -> i32 { m.n_faces }

pub fn mesh_get_vertex(m: &Mesh, idx: i32) -> [f64; 3] {
    let i = idx as usize
    [m.vertices[i * 3], m.vertices[i * 3 + 1], m.vertices[i * 3 + 2]]
}