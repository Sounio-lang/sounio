// stdlib/mesh/pure/types.sio — Mesh Types
//
// Fixed-capacity mesh for 3D graphics.

module mesh::pure::types

extern "C" {
    fn sqrt(x: f64) -> f64;
}

pub struct Mesh {
    pub n_vertices: i32,
    pub n_faces: i32,
    pub vertices: [f64; 768],
    pub faces: [i32; 384],
}

pub fn mesh_new() -> Mesh {
    Mesh { n_vertices: 0, n_faces: 0, vertices: [0.0; 768], faces: [0; 384] }
}

pub fn mesh_add_vertex(m: &!Mesh, x: f64, y: f64, z: f64) with Mut {
    if m.n_vertices < 256 as i32 {
        let i = m.n_vertices as usize
        m.vertices[i * 3] = x
        m.vertices[i * 3 + 1] = y
        m.vertices[i * 3 + 2] = z
        m.n_vertices = m.n_vertices + 1
    }
}

pub fn mesh_add_face(m: &!Mesh, i0: i32, i1: i32, i2: i32) with Mut {
    if m.n_faces < 128 as i32 {
        let i = m.n_faces as usize
        m.faces[i * 3] = i0
        m.faces[i * 3 + 1] = i1
        m.faces[i * 3 + 2] = i2
        m.n_faces = m.n_faces + 1
    }
}

pub fn mesh_vertex_count(m: &Mesh) -> i32 { m.n_vertices }
pub fn mesh_face_count(m: &Mesh) -> i32 { m.n_faces }

pub fn mesh_get_vertex(m: &Mesh, idx: i32) -> [f64; 3] {
    let i = idx as usize
    let x = m.vertices[i * 3]
    let y = m.vertices[i * 3 + 1]
    let z = m.vertices[i * 3 + 2]
    let result: [f64; 3] = [x, y, z]
    result
}

pub fn mesh_get_face(m: &Mesh, idx: i32) -> [i32; 3] {
    let i = idx as usize
    let i0 = m.faces[i * 3]
    let i1 = m.faces[i * 3 + 1]
    let i2 = m.faces[i * 3 + 2]
    let result: [i32; 3] = [i0, i1, i2]
    result
}

pub fn mesh_triangle_area(m: &Mesh, face_idx: i32) -> f64 with Div {
    let f = mesh_get_face(m, face_idx)
    let v0 = mesh_get_vertex(m, f[0])
    let v1 = mesh_get_vertex(m, f[1])
    let v2 = mesh_get_vertex(m, f[2])
    let ax = v1[0] - v0[0]
    let ay = v1[1] - v0[1]
    let az = v1[2] - v0[2]
    let bx = v2[0] - v0[0]
    let by = v2[1] - v0[1]
    let bz = v2[2] - v0[2]
    let cx = ay * bz - az * by
    let cy = az * bx - ax * bz
    let cz = ax * by - ay * bx
    let cross = sqrt(cx * cx + cy * cy + cz * cz)
    cross / 2.0
}

pub fn mesh_total_surface_area(m: &Mesh) -> f64 with Div {
    var total = 0.0
    var i: i32 = 0
    while i < m.n_faces {
        total = total + mesh_triangle_area(m, i)
        i = i + 1
    }
    total
}

pub fn mesh_centroid(m: &Mesh) -> [f64; 3] with Div {
    if m.n_vertices == 0 {
        let zero: [f64; 3] = [0.0, 0.0, 0.0]
        return zero
    }
    var cx = 0.0
    var cy = 0.0
    var cz = 0.0
    var i: i32 = 0
    while i < m.n_vertices {
        cx = cx + m.vertices[i * 3]
        cy = cy + m.vertices[i * 3 + 1]
        cz = cz + m.vertices[i * 3 + 2]
        i = i + 1
    }
    let n = m.n_vertices as f64
    let result: [f64; 3] = [cx / n, cy / n, cz / n]
    result
}


