//! stdlib/mesh — Fixed-capacity 3D mesh + render FFI stubs

module mesh

pub use mesh::pure::types::{
    Mesh,
    mesh_add_face,
    mesh_add_vertex,
    mesh_centroid,
    mesh_face_count,
    mesh_get_face,
    mesh_get_vertex,
    mesh_new,
