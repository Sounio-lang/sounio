// stdlib/dialogue/mod.sio — Public exports for the dialogue module
//
// Per stdlib/CONVENTIONS.md §2, mod.sio declares only the public surface
// (pub use re-exports). Implementations live in the sibling files
// (embed.sio, trajectory.sio).

pub use dialogue::embed::{
    halton, embed_row_into, embed_into,
}

pub use dialogue::trajectory::{
    Trajectory,
    traj_empty, traj_push, traj_set_payload,
    traj_speaker, traj_hash, traj_affect, traj_rupture, traj_dim,
    traj_payload_at, traj_len,
    traj_count_speaker, traj_count_rupture,
}

pub use dialogue::bracket::{
    bracket_left, bracket_right, grouping_effect, grouping_magnitude_sq,
    associator_antisymmetric, associator_alternative,
    traj_turn_oct, traj_fold3_left, traj_fold3_right,
    traj_bracket_sensitivity3,
}

pub use dialogue::catalan::{
    catalan_eval4, catalan_spectrum4, catalan_diameter4, catalan_distinct4,
}
