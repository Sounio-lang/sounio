// stdlib/audio/pure/types.sio — Audio Types

module audio::pure::types

fn audio_zero() -> f32 { 0.0 as f32 }

pub struct AudioBuffer {
    pub sample_rate: i32,
    pub n_samples: i32,
    pub samples: [f32; 131072],  // max 131072 samples (~3 sec at 44100 Hz)
}

pub fn audio_buffer_new(rate: i32) -> AudioBuffer {
    AudioBuffer { sample_rate: rate, n_samples: 0, samples: [audio_zero(); 131072] }
}

pub fn audio_buffer_push(b: &! AudioBuffer, s: f32) with Mut {
    if b.n_samples < 131072 {
        b.samples[b.n_samples as usize] = s
        b.n_samples = b.n_samples + 1
    }
}

pub fn audio_buffer_get(b: &AudioBuffer, idx: i32) -> f32 {
    if idx >= 0 && idx < b.n_samples {
        b.samples[idx as usize]
    } else {
        audio_zero()
    }
}

pub fn audio_buffer_sample_rate(b: &AudioBuffer) -> i32 { b.sample_rate }

pub fn audio_buffer_size(b: &AudioBuffer) -> i32 { b.n_samples }