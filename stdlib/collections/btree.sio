// stdlib/collections/btree — Flat-array B-tree (order 4)
//
// IntBTree: sorted i64 key → i64 value map.
// B-tree with branching factor 4, max 4096 nodes.
// Each node stores up to 3 keys and 3 values with 4 child pointers.
// All nodes stored in flat arrays (no pointers/allocation).

let BTREE_ORDER: i64 = 4
let BTREE_MAX_KEYS: i64 = 3
let BTREE_MAX_NODES: i64 = 4096
let BTREE_NIL: i64 = 0 - 1

struct IntBTree {
    // Per-node data: node i has keys[i*3..i*3+2], vals[i*3..i*3+2]
    node_keys: [i64; 12288],
    node_vals: [i64; 12288],
    node_children: [i64; 16384],
    node_key_count: [i64; 4096],
    node_is_leaf: [i64; 4096],
    node_count: i64,
    root: i64,
}

fn btree_node_key(tree: &IntBTree, node: i64, k: i64) -> i64 {
    tree.node_keys[node * BTREE_MAX_KEYS + k]
}

fn btree_node_val(tree: &IntBTree, node: i64, k: i64) -> i64 {
    tree.node_vals[node * BTREE_MAX_KEYS + k]
}

fn btree_node_child(tree: &IntBTree, node: i64, c: i64) -> i64 {
    tree.node_children[node * BTREE_ORDER + c]
}

fn btree_set_key(tree: &! IntBTree, node: i64, k: i64, val: i64) {
    tree.node_keys[node * BTREE_MAX_KEYS + k] = val
}

fn btree_set_val(tree: &! IntBTree, node: i64, k: i64, val: i64) {
    tree.node_vals[node * BTREE_MAX_KEYS + k] = val
}

fn btree_set_child(tree: &! IntBTree, node: i64, c: i64, child: i64) {
    tree.node_children[node * BTREE_ORDER + c] = child
}

fn btree_alloc_node(tree: &! IntBTree, is_leaf: i64) -> i64 {
    if tree.node_count >= BTREE_MAX_NODES { return BTREE_NIL }
    let id = tree.node_count
    tree.node_key_count[id] = 0
    tree.node_is_leaf[id] = is_leaf
    var c: i64 = 0
    while c < BTREE_ORDER {
        btree_set_child(tree, id, c, BTREE_NIL)
        c = c + 1
    }
    tree.node_count = tree.node_count + 1
    id
}

impl IntBTree {
    fn new() -> IntBTree {
        var tree = IntBTree {
            node_keys: [0; 12288],
            node_vals: [0; 12288],
            node_children: [0; 16384],
            node_key_count: [0; 4096],
            node_is_leaf: [0; 4096],
            node_count: 0,
            root: BTREE_NIL,
        }
        tree
    }

    fn is_empty(self: &IntBTree) -> bool {
        self.root == BTREE_NIL
    }
}

fn btree_search_node(tree: &IntBTree, node: i64, key: i64) -> i64 {
    if node == BTREE_NIL { return 0 }
    let n = tree.node_key_count[node]
    var i: i64 = 0
    while i < n {
        let k = btree_node_key(tree, node, i)
        if key == k { return btree_node_val(tree, node, i) }
        if key < k {
            return btree_search_node(tree, btree_node_child(tree, node, i), key)
        }
        i = i + 1
    }
    return btree_search_node(tree, btree_node_child(tree, node, n), key)
}

fn btree_contains_node(tree: &IntBTree, node: i64, key: i64) -> bool {
    if node == BTREE_NIL { return false }
    let n = tree.node_key_count[node]
    var i: i64 = 0
    while i < n {
        let k = btree_node_key(tree, node, i)
        if key == k { return true }
        if key < k {
            return btree_contains_node(tree, btree_node_child(tree, node, i), key)
        }
        i = i + 1
    }
    return btree_contains_node(tree, btree_node_child(tree, node, n), key)
}

fn btree_search(tree: &IntBTree, key: i64) -> i64 {
    btree_search_node(tree, tree.root, key)
}

fn btree_contains(tree: &IntBTree, key: i64) -> bool {
    btree_contains_node(tree, tree.root, key)
}

// Simple insert into non-full leaf (for basic usage)
fn btree_insert_simple(tree: &! IntBTree, key: i64, val: i64) {
    if tree.root == BTREE_NIL {
        let r = btree_alloc_node(tree, 1)
        tree.root = r
        btree_set_key(tree, r, 0, key)
        btree_set_val(tree, r, 0, val)
        tree.node_key_count[r] = 1
        return
    }
    // Walk to leaf and insert (no splitting — works for < MAX_KEYS per node)
    var node = tree.root
    while tree.node_is_leaf[node] == 0 {
        let n = tree.node_key_count[node]
        var i: i64 = 0
        var found = false
        while i < n && !found {
            if key < btree_node_key(tree, node, i) {
                node = btree_node_child(tree, node, i)
                found = true
            }
            i = i + 1
        }
        if !found {
            node = btree_node_child(tree, node, n)
        }
    }
    // Insert into leaf (sorted position)
    let n = tree.node_key_count[node]
    if n >= BTREE_MAX_KEYS { return }
    // Find position
    var pos: i64 = 0
    while pos < n && btree_node_key(tree, node, pos) < key {
        pos = pos + 1
    }
    // Check for duplicate
    if pos < n && btree_node_key(tree, node, pos) == key {
        btree_set_val(tree, node, pos, val)
        return
    }
    // Shift right
    var j = n
    while j > pos {
        btree_set_key(tree, node, j, btree_node_key(tree, node, j - 1))
        btree_set_val(tree, node, j, btree_node_val(tree, node, j - 1))
        j = j - 1
    }
    btree_set_key(tree, node, pos, key)
    btree_set_val(tree, node, pos, val)
    tree.node_key_count[node] = n + 1
}
