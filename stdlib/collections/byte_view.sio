// A checked byte span borrowing the original ByteBuffer owner.
// Constructors return an owner-bound carrier; reserve/growth/close while live
// must be rejected by the compiler, including through subviews and Result.
// No pointer escapes and no payload bytes are copied.
use core::result::{Result}
use collections::byte_buffer::{ByteBuffer,ByteValue,byte_buffer_status,byte_buffer_len,byte_buffer_get}
pub struct ByteView {owner:&ByteBuffer,start:i64,size:i64}
pub fn byte_view_new(owner:&ByteBuffer,start:i64,end:i64)->Result<ByteView,i64> {
 let status=byte_buffer_status(owner)
 if status!=0 {return Result::Err(status)}
 let count=byte_buffer_len(owner)
 if start<0 || end<start || end>count {return Result::Err(4)}
 Result::Ok(ByteView {owner:owner,start:start,size:end-start})
}
pub fn byte_view_len(view:&ByteView)->i64 {view.size}
pub fn byte_view_get(view:&ByteView,index:i64)->ByteValue {
 if index<0 || index>=view.size {return ByteValue {value:0,status:4}}
 byte_buffer_get(view.owner,view.start+index)
}
pub fn byte_view_slice(view:&ByteView,start:i64,end:i64)->Result<ByteView,i64> {
 if start<0 || end<start || end>view.size {return Result::Err(4)}
 byte_view_new(view.owner,view.start+start,view.start+end)
}
