// stdlib/collections/deque — Ring buffer double-ended queue
//
// IntDeque: i64 ring buffer, capacity 4096.
// push_front/push_back/pop_front/pop_back O(1).

let DEQUE_CAP: i64 = 4096

struct IntDeque {
    data: [i64; 4096],
    head: i64,
    tail: i64,
    count: i64,
}

impl IntDeque {
    pub fn new() -> IntDeque {
        IntDeque { data: [0; 4096], head: 0, tail: 0, count: 0 }
    }

    pub fn len(self: &IntDeque) -> i64 {
        self.count
    }

    pub fn is_empty(self: &IntDeque) -> bool {
        self.count == 0
    }

    pub fn is_full(self: &IntDeque) -> bool {
        self.count >= DEQUE_CAP
    }

    pub fn push_back(self: &! IntDeque, val: i64) {
        if self.count >= DEQUE_CAP { return }
        self.data[self.tail] = val
        self.tail = (self.tail + 1) % DEQUE_CAP
        self.count = self.count + 1
    }

    pub fn push_front(self: &! IntDeque, val: i64) {
        if self.count >= DEQUE_CAP { return }
        self.head = (self.head - 1 + DEQUE_CAP) % DEQUE_CAP
        self.data[self.head] = val
        self.count = self.count + 1
    }

    pub fn pop_front(self: &! IntDeque) -> i64 {
        if self.count == 0 { return 0 }
        let val = self.data[self.head]
        self.head = (self.head + 1) % DEQUE_CAP
        self.count = self.count - 1
        val
    }

    pub fn pop_back(self: &! IntDeque) -> i64 {
        if self.count == 0 { return 0 }
        self.tail = (self.tail - 1 + DEQUE_CAP) % DEQUE_CAP
        let val = self.data[self.tail]
        self.count = self.count - 1
        val
    }

    pub fn front(self: &IntDeque) -> i64 {
        if self.count == 0 { return 0 }
        self.data[self.head]
    }

    pub fn back(self: &IntDeque) -> i64 {
        if self.count == 0 { return 0 }
        let idx = (self.tail - 1 + DEQUE_CAP) % DEQUE_CAP
        self.data[idx]
    }

    pub fn get(self: &IntDeque, idx: i64) -> i64 {
        if idx < 0 || idx >= self.count { return 0 }
        let actual = (self.head + idx) % DEQUE_CAP
        self.data[actual]
    }

    pub fn clear(self: &! IntDeque) {
        self.head = 0
        self.tail = 0
        self.count = 0
    }
}
