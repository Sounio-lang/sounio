// Dynamic i64 set reuses map allocation, hashing, budgets and tombstones.
use collections::dynamic_map::{DynamicMap,dynamic_map_new,dynamic_map_status,dynamic_map_len,dynamic_map_get,dynamic_map_put,dynamic_map_remove,dynamic_map_close}
pub linear struct DynamicSet {data:DynamicMap}
pub fn dynamic_set_new(max_bytes:i64)->DynamicSet {DynamicSet {data:dynamic_map_new(max_bytes)}}
pub fn dynamic_set_status(s:&DynamicSet)->i64 {dynamic_map_status(&s.data)}
pub fn dynamic_set_len(s:&DynamicSet)->i64 {dynamic_map_len(&s.data)}
pub fn dynamic_set_contains(s:&DynamicSet,value:i64)->bool with Mut,Div {dynamic_map_get(&s.data,value).status==0}
pub fn dynamic_set_insert(s:&!DynamicSet,value:i64)->i64 with Alloc,Mut,Div {dynamic_map_put(&!s.data,value,1)}
pub fn dynamic_set_remove(s:&!DynamicSet,value:i64)->i64 with Mut,Div {dynamic_map_remove(&!s.data,value).status}
pub fn dynamic_set_close(s:DynamicSet) with Alloc {let DynamicSet {data}=s;dynamic_map_close(data)}
