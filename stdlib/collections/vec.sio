// stdlib/collections/vec — Monomorphic fixed-capacity vectors
//
// IntVec:   growable i64 array (capacity 4096)
// FloatVec: growable f64 array (capacity 4096)
// BoolVec:  packed bit array (64K bits via 1024 i64 words)
//
// All use impl blocks with &/&! self — no generics needed.

let VEC_CAP: i64 = 4096

// ============================================================================
// IntVec — growable i64 array
// ============================================================================

struct IntVec {
    data: [i64; 4096],
    len: i64,
}

impl IntVec {
    fn new() -> IntVec {
        IntVec { data: [0; 4096], len: 0 }
    }

    fn len(self: &IntVec) -> i64 {
        self.len
    }

    fn is_empty(self: &IntVec) -> bool {
        self.len == 0
    }

    fn push(self: &! IntVec, val: i64) with Mut {
        if self.len < VEC_CAP {
            self.data[self.len] = val
            self.len = self.len + 1
        }
    }

    fn pop(self: &! IntVec) -> i64 with Mut {
        if self.len > 0 {
            self.len = self.len - 1
            return self.data[self.len]
        }
        return 0
    }

    fn get(self: &IntVec, idx: i64) -> i64 {
        if idx >= 0 && idx < self.len {
            return self.data[idx]
        }
        return 0
    }

    fn set(self: &! IntVec, idx: i64, val: i64) with Mut {
        if idx >= 0 && idx < self.len {
            self.data[idx] = val
        }
    }

    fn first(self: &IntVec) -> i64 {
        if self.len > 0 { return self.data[0] }
        return 0
    }

    fn last(self: &IntVec) -> i64 {
        if self.len > 0 { return self.data[self.len - 1] }
        return 0
    }

    fn clear(self: &! IntVec) with Mut {
        self.len = 0
    }

    fn swap(self: &! IntVec, i: i64, j: i64) with Mut {
        if i >= 0 && i < self.len && j >= 0 && j < self.len {
            let tmp = self.data[i]
            self.data[i] = self.data[j]
            self.data[j] = tmp
        }
    }

    fn contains(self: &IntVec, val: i64) -> bool with Mut {
        var i: i64 = 0
        while i < self.len {
            if self.data[i] == val { return true }
            i = i + 1
        }
        return false
    }

    fn index_of(self: &IntVec, val: i64) -> i64 with Mut {
        var i: i64 = 0
        while i < self.len {
            if self.data[i] == val { return i }
            i = i + 1
        }
        return 0 - 1
    }

    fn reverse(self: &! IntVec) with Mut {
        var lo: i64 = 0
        var hi: i64 = self.len - 1
        while lo < hi {
            let tmp = self.data[lo]
            self.data[lo] = self.data[hi]
            self.data[hi] = tmp
            lo = lo + 1
            hi = hi - 1
        }
    }

    fn sum(self: &IntVec) -> i64 with Mut {
        var total: i64 = 0
        var i: i64 = 0
        while i < self.len {
            total = total + self.data[i]
            i = i + 1
        }
        total
    }

    fn min(self: &IntVec) -> i64 with Mut {
        if self.len == 0 { return 0 }
        var m = self.data[0]
        var i: i64 = 1
        while i < self.len {
            if self.data[i] < m { m = self.data[i] }
            i = i + 1
        }
        m
    }

    fn max(self: &IntVec) -> i64 with Mut {
        if self.len == 0 { return 0 }
        var m = self.data[0]
        var i: i64 = 1
        while i < self.len {
            if self.data[i] > m { m = self.data[i] }
            i = i + 1
        }
        m
    }

    fn copy_from(self: &! IntVec, other: &IntVec) with Mut {
        self.len = other.len
        var i: i64 = 0
        while i < other.len {
            self.data[i] = other.data[i]
            i = i + 1
        }
    }
}

// ============================================================================
// FloatVec — growable f64 array
// ============================================================================

struct FloatVec {
    data: [f64; 4096],
    len: i64,
}

impl FloatVec {
    fn new() -> FloatVec {
        FloatVec { data: [0.0; 4096], len: 0 }
    }

    fn len(self: &FloatVec) -> i64 {
        self.len
    }

    fn is_empty(self: &FloatVec) -> bool {
        self.len == 0
    }

    fn push(self: &! FloatVec, val: f64) with Mut {
        if self.len < VEC_CAP {
            self.data[self.len] = val
            self.len = self.len + 1
        }
    }

    fn pop(self: &! FloatVec) -> f64 with Mut {
        if self.len > 0 {
            self.len = self.len - 1
            return self.data[self.len]
        }
        return 0.0
    }

    fn get(self: &FloatVec, idx: i64) -> f64 {
        if idx >= 0 && idx < self.len {
            return self.data[idx]
        }
        return 0.0
    }

    fn set(self: &! FloatVec, idx: i64, val: f64) with Mut {
        if idx >= 0 && idx < self.len {
            self.data[idx] = val
        }
    }

    fn first(self: &FloatVec) -> f64 {
        if self.len > 0 { return self.data[0] }
        return 0.0
    }

    fn last(self: &FloatVec) -> f64 {
        if self.len > 0 { return self.data[self.len - 1] }
        return 0.0
    }

    fn clear(self: &! FloatVec) with Mut {
        self.len = 0
    }

    fn swap(self: &! FloatVec, i: i64, j: i64) with Mut {
        if i >= 0 && i < self.len && j >= 0 && j < self.len {
            let tmp = self.data[i]
            self.data[i] = self.data[j]
            self.data[j] = tmp
        }
    }

    fn sum(self: &FloatVec) -> f64 with Mut {
        var total: f64 = 0.0
        var i: i64 = 0
        while i < self.len {
            total = total + self.data[i]
            i = i + 1
        }
        total
    }

    fn min(self: &FloatVec) -> f64 with Mut {
        if self.len == 0 { return 0.0 }
        var m = self.data[0]
        var i: i64 = 1
        while i < self.len {
            if self.data[i] < m { m = self.data[i] }
            i = i + 1
        }
        m
    }

    fn max(self: &FloatVec) -> f64 with Mut {
        if self.len == 0 { return 0.0 }
        var m = self.data[0]
        var i: i64 = 1
        while i < self.len {
            if self.data[i] > m { m = self.data[i] }
            i = i + 1
        }
        m
    }

    fn mean(self: &FloatVec) -> f64 with Mut, Div {
        if self.len == 0 { return 0.0 }
        let s = self.sum()
        s / (self.len as f64)
    }

    fn copy_from(self: &! FloatVec, other: &FloatVec) with Mut {
        self.len = other.len
        var i: i64 = 0
        while i < other.len {
            self.data[i] = other.data[i]
            i = i + 1
        }
    }
}

// ============================================================================
// VecF64 — fixed-capacity f64 growable array (1024 elements)
// Standalone-function API (no impl block)
// ============================================================================

let VECF64_CAP: i64 = 1024

pub struct VecF64 {
    data:     [f64; 1024],
    len:      i64,
    capacity: i64,   // always 1024
}

pub fn vec_new() -> VecF64 {
    VecF64 { data: [0.0; 1024], len: 0, capacity: 1024 }
}

pub fn vec_push(v: &! VecF64, value: f64) -> bool {
    if v.len >= VECF64_CAP { return false }
    v.data[v.len] = value
    v.len = v.len + 1
    true
}

pub fn vec_pop(v: &! VecF64) -> f64 {
    if v.len <= 0 { return 0.0 }
    v.len = v.len - 1
    v.data[v.len]
}

pub fn vec_get(v: &VecF64, idx: i64) -> f64 {
    if idx >= 0 && idx < v.len { return v.data[idx] }
    0.0
}

pub fn vec_set(v: &! VecF64, idx: i64, value: f64) with Mut {
    if idx >= 0 && idx < v.len {
        v.data[idx] = value
    }
}

pub fn vec_len(v: &VecF64) -> i64 {
    v.len
}

pub fn vec_clear(v: &! VecF64) with Mut {
    v.len = 0
}

pub fn vec_sum(v: &VecF64) -> f64 with Mut {
    var total: f64 = 0.0
    var i: i64 = 0
    while i < v.len {
        total = total + v.data[i]
        i = i + 1
    }
    total
}

pub fn vec_mean(v: &VecF64) -> f64 with Mut, Div {
    if v.len == 0 { return 0.0 }
    let s = vec_sum(v)
    s / (v.len as f64)
}

pub fn vec_swap(v: &! VecF64, i: i64, j: i64) with Mut, Panic {
    if i >= 0 && i < v.len && j >= 0 && j < v.len {
        let tmp: f64 = v.data[i]
        v.data[i] = v.data[j]
        v.data[j] = tmp
    }
}

pub fn vec_reverse(v: &! VecF64) with Mut, Panic {
    var lo: i64 = 0
    var hi: i64 = v.len - 1
    while lo < hi {
        let tmp: f64 = v.data[lo]
        v.data[lo] = v.data[hi]
        v.data[hi] = tmp
        lo = lo + 1
        hi = hi - 1
    }
}
