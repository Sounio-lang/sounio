//@ run-pass
//@ expect-stdout: ALL PASS

// stdlib/collections/vec — Fixed-capacity vectors (no heap)
//
// IntVec:   i64 array up to 256 elements
// FloatVec: f64 array up to 256 elements
// VecF64:   standalone-function f64 vec, capacity 1024

let VEC_CAP: i64 = 256

// ============================================================================
// IntVec — growable i64 array (capacity 256)
// ============================================================================

struct IntVec {
    data: [i64; 256],
    len: i64,
}

impl IntVec {
    fn new() -> IntVec {
        IntVec { data: [0; 256], len: 0 }
    }
    fn len(self: &IntVec) -> i64 { self.len }
    fn push(self: &!IntVec, val: i64) with Mut {
        if self.len < VEC_CAP {
            self.data[self.len] = val
            self.len = self.len + 1
        }
    }
    fn pop(self: &!IntVec) -> i64 with Mut {
        if self.len > 0 {
            self.len = self.len - 1
            return self.data[self.len]
        }
        0
    }
    fn get(self: &IntVec, idx: i64) -> i64 {
        if idx >= 0 && idx < self.len { self.data[idx] } else { 0 }
    }
    fn set(self: &!IntVec, idx: i64, val: i64) with Mut {
        if idx >= 0 && idx < self.len { self.data[idx] = val }
    }
    fn first(self: &IntVec) -> i64 {
        if self.len > 0 { self.data[0] } else { 0 }
    }
    fn last(self: &IntVec) -> i64 {
        if self.len > 0 { self.data[self.len - 1] } else { 0 }
    }
    fn clear(self: &!IntVec) with Mut { self.len = 0 }
    fn swap(self: &!IntVec, i: i64, j: i64) with Mut {
        if i >= 0 && i < self.len && j >= 0 && j < self.len {
            let tmp = self.data[i]
            self.data[i] = self.data[j]
            self.data[j] = tmp
        }
    }
    fn reverse(self: &!IntVec) with Mut, Div {
        var lo: i64 = 0
        var hi: i64 = self.len - 1
        while lo < hi {
            let tmp = self.data[lo]
            self.data[lo] = self.data[hi]
            self.data[hi] = tmp
            lo = lo + 1
            hi = hi - 1
        }
    }
    fn sum(self: &IntVec) -> i64 with Mut, Div {
        var total: i64 = 0
        var i: i64 = 0
        while i < self.len { total = total + self.data[i]; i = i + 1 }
        total
    }
    fn min(self: &IntVec) -> i64 with Mut, Div {
        if self.len == 0 { return 0 }
        var m = self.data[0]
        var i: i64 = 1
        while i < self.len { if self.data[i] < m { m = self.data[i] }; i = i + 1 }
        m
    }
    fn max(self: &IntVec) -> i64 with Mut, Div {
        if self.len == 0 { return 0 }
        var m = self.data[0]
        var i: i64 = 1
        while i < self.len { if self.data[i] > m { m = self.data[i] }; i = i + 1 }
        m
    }
    fn contains(self: &IntVec, val: i64) -> bool with Mut {
        var i: i64 = 0
        while i < self.len { if self.data[i] == val { return true }; i = i + 1 }
        false
    }
    fn index_of(self: &IntVec, val: i64) -> i64 with Mut {
        var i: i64 = 0
        while i < self.len { if self.data[i] == val { return i }; i = i + 1 }
        0 - 1
    }
    fn is_empty(self: &IntVec) -> bool { self.len == 0 }
}

// ============================================================================
// FloatVec — growable f64 array (capacity 256)
// ============================================================================

struct FloatVec {
    data: [f64; 256],
    len: i64,
}

impl FloatVec {
    fn new() -> FloatVec {
        FloatVec { data: [0.0; 256], len: 0 }
    }
    fn len(self: &FloatVec) -> i64 { self.len }
    fn push(self: &!FloatVec, val: f64) with Mut {
        if self.len < VEC_CAP {
            self.data[self.len] = val
            self.len = self.len + 1
        }
    }
    fn pop(self: &!FloatVec) -> f64 with Mut {
        if self.len > 0 {
            self.len = self.len - 1
            return self.data[self.len]
        }
        0.0
    }
    fn get(self: &FloatVec, idx: i64) -> f64 {
        if idx >= 0 && idx < self.len { self.data[idx] } else { 0.0 }
    }
    fn set(self: &!FloatVec, idx: i64, val: f64) with Mut {
        if idx >= 0 && idx < self.len { self.data[idx] = val }
    }
    fn clear(self: &!FloatVec) with Mut { self.len = 0 }
    fn sum(self: &FloatVec) -> f64 with Mut, Div {
        var s: f64 = 0.0
        var i: i64 = 0
        while i < self.len { s = s + self.data[i]; i = i + 1 }
        s
    }
    fn mean(self: &FloatVec) -> f64 with Mut, Div, Panic {
        if self.len == 0 { return 0.0 }
        let s = self.sum()
        s / (self.len as f64)
    }
    fn min(self: &FloatVec) -> f64 with Mut, Div {
        if self.len == 0 { return 0.0 }
        var m = self.data[0]
        var i: i64 = 1
        while i < self.len { if self.data[i] < m { m = self.data[i] }; i = i + 1 }
        m
    }
    fn max(self: &FloatVec) -> f64 with Mut, Div {
        if self.len == 0 { return 0.0 }
        var m = self.data[0]
        var i: i64 = 1
        while i < self.len { if self.data[i] > m { m = self.data[i] }; i = i + 1 }
        m
    }
    fn reverse(self: &!FloatVec) with Mut, Div {
        var lo: i64 = 0
        var hi: i64 = self.len - 1
        while lo < hi {
            let tmp = self.data[lo]
            self.data[lo] = self.data[hi]
            self.data[hi] = tmp
            lo = lo + 1
            hi = hi - 1
        }
    }
}

// ============================================================================
// VecF64 — standalone-function f64 vec (capacity 1024), pub API
// ============================================================================

let VECF64_CAP: i64 = 256

pub struct VecF64 {
    data: [f64; 256],
    len: i64,
}

pub fn vec_new() -> VecF64 {
    VecF64 { data: [0.0; 256], len: 0 }
}

pub fn vec_push(v: &!VecF64, value: f64) with Mut {
    if v.len < VECF64_CAP {
        v.data[v.len] = value
        v.len = v.len + 1
    }
}

pub fn vec_pop(v: &!VecF64) -> f64 with Mut {
    if v.len <= 0 { return 0.0 }
    v.len = v.len - 1
    v.data[v.len]
}

pub fn vec_get(v: &VecF64, idx: i64) -> f64 {
    if idx >= 0 && idx < v.len { v.data[idx] } else { 0.0 }
}

pub fn vec_set(v: &!VecF64, idx: i64, value: f64) with Mut {
    if idx >= 0 && idx < v.len { v.data[idx] = value }
}

pub fn vec_len(v: &VecF64) -> i64 { v.len }

pub fn vec_clear(v: &!VecF64) with Mut { v.len = 0 }

pub fn vec_sum(v: &VecF64) -> f64 with Mut, Div {
    var total: f64 = 0.0
    var i: i64 = 0
    while i < v.len { total = total + v.data[i]; i = i + 1 }
    total
}

pub fn vec_mean(v: &VecF64) -> f64 with Mut, Div, Panic {
    if v.len == 0 { return 0.0 }
    vec_sum(v) / (v.len as f64)
}

pub fn vec_swap(v: &!VecF64, i: i64, j: i64) with Mut {
    if i >= 0 && i < v.len && j >= 0 && j < v.len {
        let tmp = v.data[i]
        v.data[i] = v.data[j]
        v.data[j] = tmp
    }
}

pub fn vec_reverse(v: &!VecF64) with Mut, Div {
    var lo: i64 = 0
    var hi: i64 = v.len - 1
    while lo < hi {
        let tmp = v.data[lo]
        v.data[lo] = v.data[hi]
        v.data[hi] = tmp
        lo = lo + 1
        hi = hi - 1
    }
}

// ============================================================================
// Inline tests
// ============================================================================

var CNT: [i64; 2] = [0; 2]

fn chk(label: i64, ok: i64) with IO, Mut {
    if ok == 1 {
        print("  PASS ["); print(label); print("]\n")
        CNT[0] = CNT[0] + 1
    } else {
        print("  FAIL ["); print(label); print("]\n")
        CNT[1] = CNT[1] + 1
    }
}

fn test_intvec() with IO, Mut, Div {
    var v = IntVec { data: [0; 256], len: 0 }
    v.push(10); v.push(20); v.push(30)
    chk(1, if v.len() == 3 { 1 } else { 0 })
    chk(2, if v.get(0) == 10 { 1 } else { 0 })
    chk(3, if v.get(2) == 30 { 1 } else { 0 })
    chk(4, if v.sum() == 60 { 1 } else { 0 })
    chk(5, if v.min() == 10 { 1 } else { 0 })
    chk(6, if v.max() == 30 { 1 } else { 0 })
    v.reverse()
    chk(7, if v.get(0) == 30 { 1 } else { 0 })
    let popped = v.pop()
    chk(8, if popped == 10 { 1 } else { 0 })
    chk(9, if v.len() == 2 { 1 } else { 0 })
    v.clear()
    chk(10, if v.len() == 0 { 1 } else { 0 })
}

fn test_floatvec() with IO, Mut, Div, Panic {
    var v = FloatVec { data: [0.0; 256], len: 0 }
    v.push(1.0); v.push(2.0); v.push(3.0)
    chk(11, if v.len() == 3 { 1 } else { 0 })
    let s = v.sum()
    chk(12, if s > 5.9 && s < 6.1 { 1 } else { 0 })
    let m = v.mean()
    chk(13, if m > 1.9 && m < 2.1 { 1 } else { 0 })
    chk(14, if v.min() < 1.1 { 1 } else { 0 })
    chk(15, if v.max() > 2.9 { 1 } else { 0 })
    v.reverse()
    chk(16, if v.get(0) > 2.9 { 1 } else { 0 })
}

fn test_vecf64() with IO, Mut, Div, Panic {
    var v = VecF64 { data: [0.0; 256], len: 0 }
    vec_push(&!v, 5.0)
    vec_push(&!v, 10.0)
    chk(17, if vec_len(&v) == 2 { 1 } else { 0 })
    chk(18, if vec_get(&v, 0) > 4.9 { 1 } else { 0 })
    chk(19, if vec_mean(&v) > 7.4 && vec_mean(&v) < 7.6 { 1 } else { 0 })
    vec_reverse(&!v)
    chk(20, if vec_get(&v, 0) > 9.9 { 1 } else { 0 })
    let popped = vec_pop(&!v)
    chk(21, if popped > 4.9 { 1 } else { 0 })
    vec_clear(&!v)
    chk(22, if vec_len(&v) == 0 { 1 } else { 0 })
}

pub fn main() -> i32 with IO, Mut, Div, Panic {
    CNT[0] = 0; CNT[1] = 0
    print("─── stdlib/collections/vec tests ───\n")
    test_intvec()
    test_floatvec()
    test_vecf64()
    print("─── "); print(CNT[0]); print("/"); print(CNT[0]+CNT[1]); print(" PASS ───\n")
    if CNT[1] == 0 { print("ALL PASS\n"); 0 } else { 1 }
}
