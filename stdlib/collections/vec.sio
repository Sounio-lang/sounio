// stdlib/collections/vec — Monomorphic fixed-capacity vectors
//
// IntVec:   growable i64 array (capacity 4096)
// FloatVec: growable f64 array (capacity 4096)
// BoolVec:  packed bit array (64K bits via 1024 i64 words)
//
// All use impl blocks with &/&! self — no generics needed.

let VEC_CAP: i64 = 4096

// ============================================================================
// IntVec — growable i64 array
// ============================================================================

struct IntVec {
    data: [i64; 4096],
    len: i64,
}

impl IntVec {
    fn new() -> IntVec {
        IntVec { data: [0; 4096], len: 0 }
    }

    fn len(self: &IntVec) -> i64 {
        self.len
    }

    fn is_empty(self: &IntVec) -> bool {
        self.len == 0
    }

    fn push(self: &! IntVec, val: i64) {
        if self.len < VEC_CAP {
            self.data[self.len] = val
            self.len = self.len + 1
        }
    }

    fn pop(self: &! IntVec) -> i64 {
        if self.len > 0 {
            self.len = self.len - 1
            return self.data[self.len]
        }
        return 0
    }

    fn get(self: &IntVec, idx: i64) -> i64 {
        if idx >= 0 && idx < self.len {
            return self.data[idx]
        }
        return 0
    }

    fn set(self: &! IntVec, idx: i64, val: i64) {
        if idx >= 0 && idx < self.len {
            self.data[idx] = val
        }
    }

    fn first(self: &IntVec) -> i64 {
        if self.len > 0 { return self.data[0] }
        return 0
    }

    fn last(self: &IntVec) -> i64 {
        if self.len > 0 { return self.data[self.len - 1] }
        return 0
    }

    fn clear(self: &! IntVec) {
        self.len = 0
    }

    fn swap(self: &! IntVec, i: i64, j: i64) {
        if i >= 0 && i < self.len && j >= 0 && j < self.len {
            let tmp = self.data[i]
            self.data[i] = self.data[j]
            self.data[j] = tmp
        }
    }

    fn contains(self: &IntVec, val: i64) -> bool {
        var i: i64 = 0
        while i < self.len {
            if self.data[i] == val { return true }
            i = i + 1
        }
        return false
    }

    fn index_of(self: &IntVec, val: i64) -> i64 {
        var i: i64 = 0
        while i < self.len {
            if self.data[i] == val { return i }
            i = i + 1
        }
        return 0 - 1
    }

    fn reverse(self: &! IntVec) {
        var lo: i64 = 0
        var hi: i64 = self.len - 1
        while lo < hi {
            let tmp = self.data[lo]
            self.data[lo] = self.data[hi]
            self.data[hi] = tmp
            lo = lo + 1
            hi = hi - 1
        }
    }

    fn sum(self: &IntVec) -> i64 {
        var total: i64 = 0
        var i: i64 = 0
        while i < self.len {
            total = total + self.data[i]
            i = i + 1
        }
        total
    }

    fn min(self: &IntVec) -> i64 {
        if self.len == 0 { return 0 }
        var m = self.data[0]
        var i: i64 = 1
        while i < self.len {
            if self.data[i] < m { m = self.data[i] }
            i = i + 1
        }
        m
    }

    fn max(self: &IntVec) -> i64 {
        if self.len == 0 { return 0 }
        var m = self.data[0]
        var i: i64 = 1
        while i < self.len {
            if self.data[i] > m { m = self.data[i] }
            i = i + 1
        }
        m
    }

    fn copy_from(self: &! IntVec, other: &IntVec) {
        self.len = other.len
        var i: i64 = 0
        while i < other.len {
            self.data[i] = other.data[i]
            i = i + 1
        }
    }
}

// ============================================================================
// FloatVec — growable f64 array
// ============================================================================

struct FloatVec {
    data: [f64; 4096],
    len: i64,
}

impl FloatVec {
    fn new() -> FloatVec {
        FloatVec { data: [0.0; 4096], len: 0 }
    }

    fn len(self: &FloatVec) -> i64 {
        self.len
    }

    fn is_empty(self: &FloatVec) -> bool {
        self.len == 0
    }

    fn push(self: &! FloatVec, val: f64) {
        if self.len < VEC_CAP {
            self.data[self.len] = val
            self.len = self.len + 1
        }
    }

    fn pop(self: &! FloatVec) -> f64 {
        if self.len > 0 {
            self.len = self.len - 1
            return self.data[self.len]
        }
        return 0.0
    }

    fn get(self: &FloatVec, idx: i64) -> f64 {
        if idx >= 0 && idx < self.len {
            return self.data[idx]
        }
        return 0.0
    }

    fn set(self: &! FloatVec, idx: i64, val: f64) {
        if idx >= 0 && idx < self.len {
            self.data[idx] = val
        }
    }

    fn first(self: &FloatVec) -> f64 {
        if self.len > 0 { return self.data[0] }
        return 0.0
    }

    fn last(self: &FloatVec) -> f64 {
        if self.len > 0 { return self.data[self.len - 1] }
        return 0.0
    }

    fn clear(self: &! FloatVec) {
        self.len = 0
    }

    fn swap(self: &! FloatVec, i: i64, j: i64) {
        if i >= 0 && i < self.len && j >= 0 && j < self.len {
            let tmp = self.data[i]
            self.data[i] = self.data[j]
            self.data[j] = tmp
        }
    }

    fn sum(self: &FloatVec) -> f64 {
        var total: f64 = 0.0
        var i: i64 = 0
        while i < self.len {
            total = total + self.data[i]
            i = i + 1
        }
        total
    }

    fn min(self: &FloatVec) -> f64 {
        if self.len == 0 { return 0.0 }
        var m = self.data[0]
        var i: i64 = 1
        while i < self.len {
            if self.data[i] < m { m = self.data[i] }
            i = i + 1
        }
        m
    }

    fn max(self: &FloatVec) -> f64 {
        if self.len == 0 { return 0.0 }
        var m = self.data[0]
        var i: i64 = 1
        while i < self.len {
            if self.data[i] > m { m = self.data[i] }
            i = i + 1
        }
        m
    }

    fn mean(self: &FloatVec) -> f64 {
        if self.len == 0 { return 0.0 }
        let s = self.sum()
        s / (self.len as f64)
    }

    fn copy_from(self: &! FloatVec, other: &FloatVec) {
        self.len = other.len
        var i: i64 = 0
        while i < other.len {
            self.data[i] = other.data[i]
            i = i + 1
        }
    }
}

// ============================================================================
// BoolVec — packed bit array (up to 65536 bits)
// ============================================================================

let BOOLVEC_WORDS: i64 = 1024

struct BoolVec {
    words: [i64; 1024],
    bit_len: i64,
}

impl BoolVec {
    fn new() -> BoolVec {
        BoolVec { words: [0; 1024], bit_len: 0 }
    }

    fn with_len(n: i64) -> BoolVec {
        BoolVec { words: [0; 1024], bit_len: n }
    }

    fn len(self: &BoolVec) -> i64 {
        self.bit_len
    }

    fn get(self: &BoolVec, idx: i64) -> bool {
        if idx < 0 || idx >= self.bit_len { return false }
        let word_idx = idx / 64
        let bit_idx = idx - word_idx * 64
        let mask = 1 << bit_idx
        (self.words[word_idx] & mask) != 0
    }

    fn set(self: &! BoolVec, idx: i64, val: bool) {
        if idx < 0 || idx >= 65536 { return }
        if idx >= self.bit_len { self.bit_len = idx + 1 }
        let word_idx = idx / 64
        let bit_idx = idx - word_idx * 64
        let mask = 1 << bit_idx
        if val {
            self.words[word_idx] = self.words[word_idx] | mask
        } else {
            self.words[word_idx] = self.words[word_idx] & (0 - 1 - mask)
        }
    }

    fn count_ones(self: &BoolVec) -> i64 {
        var count: i64 = 0
        let num_words = (self.bit_len + 63) / 64
        var i: i64 = 0
        while i < num_words {
            var w = self.words[i]
            while w != 0 {
                count = count + (w & 1)
                w = w >> 1
            }
            i = i + 1
        }
        count
    }

    fn clear(self: &! BoolVec) {
        var i: i64 = 0
        let num_words = (self.bit_len + 63) / 64
        while i < num_words {
            self.words[i] = 0
            i = i + 1
        }
        self.bit_len = 0
    }
}
