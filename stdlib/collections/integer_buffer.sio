// Checked native-only numerical storage. Public owners are linear; payloads
// never escape through a raw-pointer view. Status 0=OK, 1=invalid shape/budget,
// 2=budget exceeded, 3=allocation failure, 4=index out of bounds.
// Budget is requested payload bytes (not allocator pages or process RSS).
pub linear struct IntegerBuffer {
    ptr: *mut i64,
    size: i64,
    capacity: i64,
    max_bytes: i64,
    status: i64,
}
pub struct IntegerValue { pub value: i64, pub status: i64 }

pub fn integer_buffer_new(n: i64, max_bytes: i64) -> IntegerBuffer with Alloc, Mut, Div {
    var code:i64 = 0
    var ptr = 0 as *mut i64
    var size:i64 = 0
    var cap:i64 = 0
    if n < 0 || max_bytes < 0 || max_bytes > 9223372036854771704 {
        code = 1
    } else if n > max_bytes / 8 {
        code = 2
    } else if n > 0 {
        let allocated = heap_alloc(n * 8)
        if (allocated as i64) <= 0 { code = 3 } else {
            ptr = allocated as *mut i64
            size = n
            cap = n
        }
    }
    return IntegerBuffer { ptr: ptr, size: size, capacity: cap, max_bytes: max_bytes, status: code }
}
pub fn integer_buffer_status(b: &IntegerBuffer) -> i64 { b.status }
pub fn integer_buffer_len(b: &IntegerBuffer) -> i64 { b.size }
pub fn integer_buffer_capacity(b: &IntegerBuffer) -> i64 { b.capacity }
pub fn integer_buffer_budget(b: &IntegerBuffer) -> i64 { b.max_bytes }

// Failure leaves size, allocation, contents, and construction status unchanged.
pub fn integer_buffer_reserve(b: &!IntegerBuffer, required: i64) -> i64 with Alloc, Mut, Div {
    if b.status != 0 { return b.status }
    if required < 0 { return 1 }
    if required > b.max_bytes / 8 { return 2 }
    if required <= b.capacity { return 0 }
    let bytes = required * 8
    let next = if b.capacity == 0 { heap_alloc(bytes) } else { heap_realloc(b.ptr as *mut i8, bytes) }
    if (next as i64) <= 0 { return 3 }
    b.ptr = next as *mut i64
    b.capacity = required
    return 0
}
pub fn integer_buffer_resize(b: &!IntegerBuffer, n: i64) -> i64 with Alloc, Mut, Div {
    let status = integer_buffer_reserve(b, n)
    if status != 0 { return status }
    var i = b.size
    while i < n {
        write_i64(b.ptr, i, 0)
        i = i + 1
    }
    b.size = n
    return 0
}
pub fn integer_buffer_get(b: &IntegerBuffer, index: i64) -> IntegerValue {
    if b.status != 0 { return IntegerValue { value: 0, status: b.status } }
    if index < 0 || index >= b.size { return IntegerValue { value: 0, status: 4 } }
    return IntegerValue { value: read_i64(b.ptr, index), status: 0 }
}
// Fast kernel accessor with checked bounds. A caller requiring a status uses get.
pub fn integer_buffer_at(b: &IntegerBuffer, index: i64) -> i64 with Panic {
    assert(b.status == 0 && index >= 0 && index < b.size)
    return read_i64(b.ptr, index)
}
pub fn integer_buffer_set(b: &!IntegerBuffer, index: i64, value: i64) -> i64 with Mut {
    if b.status != 0 { return b.status }
    if index < 0 || index >= b.size { return 4 }
    write_i64(b.ptr, index, value)
    return 0
}
pub fn integer_buffer_push(b: &!IntegerBuffer, value: i64) -> i64 with Alloc, Mut, Div {
    if b.status != 0 { return b.status }
    // Avoid size+1 overflow and grow geometrically within the explicit budget.
    let limit = b.max_bytes / 8
    if b.size >= limit { return 2 }
    if b.size == b.capacity {
        var next = if b.capacity == 0 { 4 } else { b.capacity }
        if next > limit / 2 { next = limit } else { next = next * 2 }
        if next > limit { next = limit }
        if next < b.size + 1 { next = b.size + 1 }
        let status = integer_buffer_reserve(b, next)
        if status != 0 { return status }
    }
    write_i64(b.ptr, b.size, value)
    b.size = b.size + 1
    return 0
}
pub fn integer_buffer_close(b: IntegerBuffer) with Alloc {
    let IntegerBuffer { ptr, size, capacity, max_bytes, status } = b
    if capacity > 0 { heap_free(ptr as *mut i8) }
}
