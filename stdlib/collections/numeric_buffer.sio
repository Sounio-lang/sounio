use math::pure::{is_finite}
// Checked native-only numerical storage. Public owners are linear; payloads
// never escape through a raw-pointer view. Status 0=OK, 1=invalid shape/budget,
// 2=budget exceeded, 3=allocation failure, 4=index out of bounds.
// Budget is requested payload bytes (not allocator pages or process RSS).
pub linear struct NumericBuffer {
    ptr: *mut f64,
    size: i64,
    capacity: i64,
    max_bytes: i64,
    status: i64,
}
pub struct NumericValue { pub value: f64, pub status: i64 }

pub fn numeric_buffer_new(n: i64, max_bytes: i64) -> NumericBuffer with Alloc, Mut, Div {
    var code:i64 = 0
    var ptr = 0 as *mut f64
    var size:i64 = 0
    var cap:i64 = 0
    if n < 0 || max_bytes < 0 || max_bytes > 9223372036854771704 {
        code = 1
    } else if n > max_bytes / 8 {
        code = 2
    } else if n > 0 {
        let allocated = heap_alloc(n * 8)
        if (allocated as i64) <= 0 { code = 3 } else {
            ptr = allocated as *mut f64
            size = n
            cap = n
        }
    }
    return NumericBuffer { ptr: ptr, size: size, capacity: cap, max_bytes: max_bytes, status: code }
}
pub fn numeric_buffer_status(b: &NumericBuffer) -> i64 { b.status }
pub fn numeric_buffer_len(b: &NumericBuffer) -> i64 { b.size }
pub fn numeric_buffer_capacity(b: &NumericBuffer) -> i64 { b.capacity }
pub fn numeric_buffer_budget(b: &NumericBuffer) -> i64 { b.max_bytes }

// Failure leaves size, allocation, contents, and construction status unchanged.
pub fn numeric_buffer_reserve(b: &!NumericBuffer, required: i64) -> i64 with Alloc, Mut, Div {
    if b.status != 0 { return b.status }
    if required < 0 { return 1 }
    if required > b.max_bytes / 8 { return 2 }
    if required <= b.capacity { return 0 }
    let bytes = required * 8
    let next = if b.capacity == 0 { heap_alloc(bytes) } else { heap_realloc(b.ptr as *mut i8, bytes) }
    if (next as i64) <= 0 { return 3 }
    b.ptr = next as *mut f64
    b.capacity = required
    return 0
}
pub fn numeric_buffer_resize(b: &!NumericBuffer, n: i64) -> i64 with Alloc, Mut, Div {
    let status = numeric_buffer_reserve(b, n)
    if status != 0 { return status }
    var i = b.size
    while i < n {
        write_f64(b.ptr, i, 0.0)
        i = i + 1
    }
    b.size = n
    return 0
}
pub fn numeric_buffer_get(b: &NumericBuffer, index: i64) -> NumericValue {
    if b.status != 0 { return NumericValue { value: 0.0, status: b.status } }
    if index < 0 || index >= b.size { return NumericValue { value: 0.0, status: 4 } }
    return NumericValue { value: read_f64(b.ptr, index), status: 0 }
}
// Fast kernel accessor with checked bounds. A caller requiring a status uses get.
pub fn numeric_buffer_at(b: &NumericBuffer, index: i64) -> f64 with Panic {
    assert(b.status == 0 && index >= 0 && index < b.size)
    return read_f64(b.ptr, index)
}
pub fn numeric_buffer_set(b: &!NumericBuffer, index: i64, value: f64) -> i64 with Mut {
    if b.status != 0 { return b.status }
    if index < 0 || index >= b.size { return 4 }
    write_f64(b.ptr, index, value)
    return 0
}
pub fn numeric_buffer_push(b: &!NumericBuffer, value: f64) -> i64 with Alloc, Mut, Div {
    if b.status != 0 { return b.status }
    // Avoid size+1 overflow and grow geometrically within the explicit budget.
    let limit = b.max_bytes / 8
    if b.size >= limit { return 2 }
    if b.size == b.capacity {
        var next = if b.capacity == 0 { 4 } else { b.capacity }
        if next > limit / 2 { next = limit } else { next = next * 2 }
        if next > limit { next = limit }
        if next < b.size + 1 { next = b.size + 1 }
        let status = numeric_buffer_reserve(b, next)
        if status != 0 { return status }
    }
    write_f64(b.ptr, b.size, value)
    b.size = b.size + 1
    return 0
}
pub fn numeric_buffer_close(b: NumericBuffer) with Alloc {
    let NumericBuffer { ptr, size, capacity, max_bytes, status } = b
    if capacity > 0 { heap_free(ptr as *mut i8) }
}

// Descriptors hold no pointer and cannot outlive the allocation through an alias.
// Every access borrows the owner and rechecks its current length.
pub struct NumericMatrix {
    rows: i64, cols: i64, row_stride: i64, col_stride: i64,
    offset: i64, end: i64, status: i64,
}
pub fn numeric_matrix(n: i64, rows: i64, cols: i64, row_stride: i64,
                     col_stride: i64, offset: i64) -> NumericMatrix with Mut, Div {
    var m = NumericMatrix { rows: rows, cols: cols, row_stride: row_stride,
        col_stride: col_stride, offset: offset, end: offset, status: 1 }
    if n < 0 || rows < 0 || cols < 0 || row_stride < 0 || col_stride < 0 || offset < 0 || offset > n { return m }
    if rows == 0 || cols == 0 { m.status = 0; return m }
    if offset >= n { return m }
    var available = n - 1 - offset
    if rows > 1 {
        if row_stride > available / (rows - 1) { return m }
        available = available - row_stride * (rows - 1)
    }
    if cols > 1 {
        if col_stride > available / (cols - 1) { return m }
    }
    m.end = n - available + col_stride * (cols - 1)
    m.status = 0
    return m
}
pub fn numeric_matrix_status(m: &NumericMatrix) -> i64 { m.status }
pub fn numeric_matrix_rows(m: &NumericMatrix) -> i64 { m.rows }
pub fn numeric_matrix_cols(m: &NumericMatrix) -> i64 { m.cols }
pub fn numeric_matrix_get(b: &NumericBuffer, m: &NumericMatrix, row: i64, col: i64) -> NumericValue {
    if m.status != 0 { return NumericValue { value: 0.0, status: 1 } }
    if row < 0 || row >= m.rows || col < 0 || col >= m.cols { return NumericValue { value: 0.0, status: 4 } }
    if m.end > b.size { return NumericValue { value: 0.0, status: 4 } }
    return numeric_buffer_get(b, m.offset + row * m.row_stride + col * m.col_stride)
}
// Scalar checked accessor for kernels that already validate a matrix layout.
// Same assertion contract as numeric_buffer_at; no NumericValue snapshot per read.
pub fn numeric_matrix_fits(b:&NumericBuffer,m:&NumericMatrix)->bool {
 b.status==0 && m.status==0 && m.end<=b.size
}
pub fn numeric_matrix_at(b:&NumericBuffer,m:&NumericMatrix,row:i64,col:i64)->f64 with Panic {
 assert(b.status==0 && m.status==0)
 assert(row>=0 && row<m.rows && col>=0 && col<m.cols)
 assert(m.end<=b.size)
 return read_f64(b.ptr,m.offset+row*m.row_stride+col*m.col_stride)
}
pub fn numeric_matrix_set(b: &!NumericBuffer, m: &NumericMatrix, row: i64, col: i64, value: f64) -> i64 with Mut {
    if m.status != 0 { return 1 }
    if row < 0 || row >= m.rows || col < 0 || col >= m.cols || m.end > b.size { return 4 }
    return numeric_buffer_set(b, m.offset + row * m.row_stride + col * m.col_stride, value)
}

 // Checked bulk Givens row rotation for numerical workspaces. No pointer escapes.
 // Ranges must be disjoint. Arithmetic failure may alter the scratch prefix;
 // callers stage public outputs separately. No allocation and one bounds check.
pub fn numeric_buffer_rotate_rows(b:&!NumericBuffer,first:i64,second:i64,n:i64,c:f64,s:f64)->i64 with Mut,Div {
    if b.status!=0 {return b.status}
    if first<0 || second<0 || n<0 || first>b.size || second>b.size {return 4}
    if n>b.size-first || n>b.size-second {return 4}
    if n>0 && !(first+n<=second || second+n<=first) {return 4}
    if !is_finite(c) || !is_finite(s) {return 5}
    var i:i64=0
    while i<n {
        let top=read_f64(b.ptr,first+i)
        let bottom=read_f64(b.ptr,second+i)
        let upper=c*top+s*bottom
        let lower=c*bottom-s*top
        if !is_finite(upper) || !is_finite(lower) {return 5}
        write_f64(b.ptr,first+i,upper)
        write_f64(b.ptr,second+i,lower)
        i=i+1
    }
    return 0
}
