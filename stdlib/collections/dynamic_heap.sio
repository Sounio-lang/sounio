// Budgeted dynamic i64 minimum heap, backed by the canonical owned buffer.
use collections::integer_buffer::{IntegerBuffer,IntegerValue,integer_buffer_new,integer_buffer_status,integer_buffer_len,integer_buffer_at,integer_buffer_set,integer_buffer_push,integer_buffer_resize,integer_buffer_close}
pub linear struct DynamicHeap {data:IntegerBuffer}
pub fn dynamic_heap_new(max_bytes:i64)->DynamicHeap with Alloc,Mut,Div {
 return DynamicHeap {data:integer_buffer_new(0,max_bytes)}
}
pub fn dynamic_heap_status(h:&DynamicHeap)->i64 {integer_buffer_status(&h.data)}
pub fn dynamic_heap_len(h:&DynamicHeap)->i64 {integer_buffer_len(&h.data)}
pub fn dynamic_heap_push(h:&!DynamicHeap,value:i64)->i64 with Alloc,Mut,Div,Panic {
 let status=integer_buffer_push(&!h.data,value)
 if status!=0 {return status}
 var child=integer_buffer_len(&h.data)-1
 while child>0 {
  let parent=(child-1)/2
  let above=integer_buffer_at(&h.data,parent)
  if above<=value {return 0}
  assert(integer_buffer_set(&!h.data,child,above)==0)
  assert(integer_buffer_set(&!h.data,parent,value)==0)
  child=parent
 }
 return 0
}
pub fn dynamic_heap_pop(h:&!DynamicHeap)->IntegerValue with Alloc,Mut,Div,Panic {
 let status=integer_buffer_status(&h.data)
 if status!=0 {return IntegerValue {value:0,status:status}}
 let n=integer_buffer_len(&h.data)
 if n==0 {return IntegerValue {value:0,status:4}}
 let result=integer_buffer_at(&h.data,0)
 let tail=integer_buffer_at(&h.data,n-1)
 assert(integer_buffer_resize(&!h.data,n-1)==0)
 if n==1 {return IntegerValue {value:result,status:0}}
 assert(integer_buffer_set(&!h.data,0,tail)==0)
 var parent:i64=0
 let length=n-1
 // parent < length/2 guarantees 2*parent+1 is a valid index without overflow.
 while parent<length/2 {
  let left=parent*2+1
  if left>=length {break}
  var child=left
  if left+1<length {
   if integer_buffer_at(&h.data,left+1)<integer_buffer_at(&h.data,left) {child=left+1}
  }
  let below=integer_buffer_at(&h.data,child)
  if tail<=below {break}
  assert(integer_buffer_set(&!h.data,parent,below)==0)
  assert(integer_buffer_set(&!h.data,child,tail)==0)
  parent=child
 }
 return IntegerValue {value:result,status:0}
}
pub fn dynamic_heap_close(h:DynamicHeap) with Alloc {
 let DynamicHeap {data}=h
 integer_buffer_close(data)
}
