//@ run-pass
//@ expect-stdout: ALL PASS

// stdlib/collections/bitset — Dense bit set
//
// BitSet: 65536 bits (1024 i64 words). O(1) set/clear/test.
// Supports union, intersection, xor, and popcount.

let BITSET_WORDS: i64 = 1024
let BITSET_MAX_BITS: i64 = 65536

pub struct BitSet {
    words: [i64; 1024],
}

impl BitSet {
    fn set(self: &!BitSet, bit: i64) with Mut, Div, Panic {
        if bit < 0 || bit >= BITSET_MAX_BITS { return }
        let word_idx = bit / 64
        let bit_idx = bit - word_idx * 64
        self.words[word_idx] = self.words[word_idx] | (1 << bit_idx)
    }

    fn clear_bit(self: &!BitSet, bit: i64) with Mut, Div, Panic {
        if bit < 0 || bit >= BITSET_MAX_BITS { return }
        let word_idx = bit / 64
        let bit_idx = bit - word_idx * 64
        let mask = 1 << bit_idx
        self.words[word_idx] = self.words[word_idx] & (0 - 1 - mask)
    }

    fn test(self: &BitSet, bit: i64) -> bool with Div, Panic {
        if bit < 0 || bit >= BITSET_MAX_BITS { return false }
        let word_idx = bit / 64
        let bit_idx = bit - word_idx * 64
        (self.words[word_idx] & (1 << bit_idx)) != 0
    }

    fn count(self: &BitSet) -> i64 with Mut, Div, Panic {
        var total: i64 = 0
        var i: i64 = 0
        while i < BITSET_WORDS {
            var w = self.words[i]
            // Brian Kernighan: w & (w-1) clears lowest set bit, avoids shift of negative i64
            while w != 0 {
                w = w & (w - 1)
                total = total + 1
            }
            i = i + 1
        }
        total
    }

    fn union_with(self: &!BitSet, other: &BitSet) with Mut, Div, Panic {
        var i: i64 = 0
        while i < BITSET_WORDS {
            self.words[i] = self.words[i] | other.words[i]
            i = i + 1
        }
    }

    fn intersect_with(self: &!BitSet, other: &BitSet) with Mut, Div, Panic {
        var i: i64 = 0
        while i < BITSET_WORDS {
            self.words[i] = self.words[i] & other.words[i]
            i = i + 1
        }
    }

    fn xor_with(self: &!BitSet, other: &BitSet) with Mut, Div, Panic {
        var i: i64 = 0
        while i < BITSET_WORDS {
            self.words[i] = self.words[i] ^ other.words[i]
            i = i + 1
        }
    }

    fn clear(self: &!BitSet) with Mut, Div, Panic {
        var i: i64 = 0
        while i < BITSET_WORDS {
            self.words[i] = 0
            i = i + 1
        }
    }

    fn is_subset_of(self: &BitSet, other: &BitSet) -> bool with Mut, Div, Panic {
        var i: i64 = 0
        while i < BITSET_WORDS {
            if (self.words[i] & other.words[i]) != self.words[i] {
                return false
            }
            i = i + 1
        }
        return true
    }

    fn equals(self: &BitSet, other: &BitSet) -> bool with Mut, Div, Panic {
        var i: i64 = 0
        while i < BITSET_WORDS {
            if self.words[i] != other.words[i] { return false }
            i = i + 1
        }
        return true
    }
}

// ============================================================================
// TESTS
// ============================================================================

var CNT: [i64; 2] = [0; 2]

fn chk(label: i64, ok: i64) with IO, Mut {
    if ok == 1 {
        print("  PASS ["); print(label); print("]\n")
        CNT[0] = CNT[0] + 1
    } else {
        print("  FAIL ["); print(label); print("]\n")
        CNT[1] = CNT[1] + 1
    }
}

fn test_bitset() with IO, Mut, Div, Panic {
    var b = BitSet { words: [0; 1024] }

    // Initially empty
    chk(1, if b.test(0) { 0 } else { 1 })
    chk(2, if b.count() == 0 { 1 } else { 0 })

    // Set some bits
    b.set(0)
    b.set(1)
    b.set(63)
    b.set(64)
    b.set(65535)

    chk(3, if b.test(0) { 1 } else { 0 })
    chk(4, if b.test(1) { 1 } else { 0 })
    chk(5, if b.test(63) { 1 } else { 0 })
    chk(6, if b.test(64) { 1 } else { 0 })
    chk(7, if b.test(65535) { 1 } else { 0 })
    chk(8, if b.test(2) { 0 } else { 1 })
    chk(9, if b.count() == 5 { 1 } else { 0 })

    // Clear a bit
    b.clear_bit(1)
    chk(10, if b.test(1) { 0 } else { 1 })
    chk(11, if b.count() == 4 { 1 } else { 0 })

    // Union
    var c = BitSet { words: [0; 1024] }
    c.set(2)
    c.set(3)
    b.union_with(&c)
    chk(12, if b.test(2) { 1 } else { 0 })
    chk(13, if b.test(3) { 1 } else { 0 })

    // Intersection
    var d = BitSet { words: [0; 1024] }
    d.set(0)
    d.set(2)
    b.intersect_with(&d)
    chk(14, if b.test(0) { 1 } else { 0 })
    chk(15, if b.test(2) { 1 } else { 0 })
    chk(16, if b.test(63) { 0 } else { 1 })

    // XOR
    var e = BitSet { words: [0; 1024] }
    e.set(0)
    b.xor_with(&e)
    chk(17, if b.test(0) { 0 } else { 1 })
    chk(18, if b.test(2) { 1 } else { 0 })

    // Clear all
    b.clear()
    chk(19, if b.count() == 0 { 1 } else { 0 })
    chk(20, if b.test(2) { 0 } else { 1 })

    // Subset
    var f = BitSet { words: [0; 1024] }
    f.set(5)
    f.set(10)
    var g = BitSet { words: [0; 1024] }
    g.set(5)
    chk(21, if g.is_subset_of(&f) { 1 } else { 0 })
    chk(22, if f.is_subset_of(&g) { 0 } else { 1 })

    // Equals
    var h = BitSet { words: [0; 1024] }
    h.set(5)
    chk(23, if g.equals(&h) { 1 } else { 0 })
    chk(24, if g.equals(&f) { 0 } else { 1 })
}

pub fn main() -> i32 with IO, Mut, Div, Panic {
    CNT[0] = 0; CNT[1] = 0
    print("─── stdlib/collections/bitset tests ───\n")
    test_bitset()
    print("─── "); print(CNT[0]); print("/"); print(CNT[0]+CNT[1]); print(" PASS ───\n")
    if CNT[1] == 0 { print("ALL PASS\n"); 0 } else { 1 }
}
