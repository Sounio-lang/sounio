// stdlib/collections/bitset — Dense bit set
//
// BitSet: 65536 bits (1024 i64 words). O(1) set/clear/test.
// Supports union, intersection, xor, and popcount.

let BITSET_WORDS: i64 = 1024
let BITSET_MAX_BITS: i64 = 65536

struct BitSet {
    words: [i64; 1024],
}

impl BitSet {
    pub fn new() -> BitSet {
        BitSet { words: [0; 1024] }
    }

    pub fn set(self: &! BitSet, bit: i64) {
        if bit < 0 || bit >= BITSET_MAX_BITS { return }
        let word_idx = bit / 64
        let bit_idx = bit - word_idx * 64
        self.words[word_idx] = self.words[word_idx] | (1 << bit_idx)
    }

    pub fn clear_bit(self: &! BitSet, bit: i64) {
        if bit < 0 || bit >= BITSET_MAX_BITS { return }
        let word_idx = bit / 64
        let bit_idx = bit - word_idx * 64
        let mask = 1 << bit_idx
        self.words[word_idx] = self.words[word_idx] & (0 - 1 - mask)
    }

    pub fn test(self: &BitSet, bit: i64) -> bool {
        if bit < 0 || bit >= BITSET_MAX_BITS { return false }
        let word_idx = bit / 64
        let bit_idx = bit - word_idx * 64
        (self.words[word_idx] & (1 << bit_idx)) != 0
    }

    pub fn count(self: &BitSet) -> i64 {
        var total: i64 = 0
        var i: i64 = 0
        while i < BITSET_WORDS {
            var w = self.words[i]
            while w != 0 {
                total = total + 1
                w = w & (w - 1)
            }
            i = i + 1
        }
        total
    }

    pub fn union_with(self: &! BitSet, other: &BitSet) {
        var i: i64 = 0
        while i < BITSET_WORDS {
            self.words[i] = self.words[i] | other.words[i]
            i = i + 1
        }
    }

    pub fn intersect_with(self: &! BitSet, other: &BitSet) {
        var i: i64 = 0
        while i < BITSET_WORDS {
            self.words[i] = self.words[i] & other.words[i]
            i = i + 1
        }
    }

    pub fn xor_with(self: &! BitSet, other: &BitSet) {
        var i: i64 = 0
        while i < BITSET_WORDS {
            self.words[i] = self.words[i] ^ other.words[i]
            i = i + 1
        }
    }

    pub fn clear(self: &! BitSet) {
        var i: i64 = 0
        while i < BITSET_WORDS {
            self.words[i] = 0
            i = i + 1
        }
    }

    pub fn is_subset_of(self: &BitSet, other: &BitSet) -> bool {
        var i: i64 = 0
        while i < BITSET_WORDS {
            if (self.words[i] & other.words[i]) != self.words[i] {
                return false
            }
            i = i + 1
        }
        return true
    }

    fn equals(self: &BitSet, other: &BitSet) -> bool {
        var i: i64 = 0
        while i < BITSET_WORDS {
            if self.words[i] != other.words[i] { return false }
            i = i + 1
        }
        return true
    }
}
