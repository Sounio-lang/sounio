//! Binary Heap (Priority Queue)
//!
//! A binary min-heap implementation providing O(log n) push and pop operations.
//! The smallest element is always at the front.
//!
//! # Examples
//! ```sio
//! var heap = BinaryHeap::new()
//! heap.push(3)
//! heap.push(1)
//! heap.push(2)
//! // heap.pop() returns Some(1), Some(2), Some(3)
//! ```
//!
//! For a max-heap, use MaxHeap or wrap values in Reverse.

// =============================================================================
// Binary Heap (Min-Heap)
// =============================================================================

/// A priority queue implemented with a binary min-heap.
///
/// The smallest element is always at the root and is returned first by pop().
/// Push and pop operations are O(log n).
pub struct BinaryHeap<T> {
    data: Vec<T>,
}

impl<T> BinaryHeap<T> {
    /// Creates an empty BinaryHeap.
    pub fn new() -> BinaryHeap<T> {
        BinaryHeap { data: Vec::new() }
    }

    /// Creates a BinaryHeap with the specified capacity.
    pub fn with_capacity(capacity: usize) -> BinaryHeap<T> with Alloc {
        BinaryHeap { data: Vec::with_capacity(capacity) }
    }

    /// Returns the number of elements in the heap.
    pub fn len(self: &BinaryHeap<T>) -> usize {
        self.data.len()
    }

    /// Returns true if the heap contains no elements.
    pub fn is_empty(self: &BinaryHeap<T>) -> bool {
        self.data.is_empty()
    }

    /// Returns a reference to the smallest element, or None if empty.
    pub fn peek(self: &BinaryHeap<T>) -> Option<&T> {
        if self.data.is_empty() {
            None
        } else {
            Some(&self.data[0])
        }
    }

    /// Pushes an element onto the heap.
    ///
    /// Time complexity: O(log n)
    pub fn push(self: &!BinaryHeap<T>, item: T) with Alloc {
        self.data.push(item)
        self.sift_up(self.data.len() - 1)
    }

    /// Removes and returns the smallest element, or None if empty.
    ///
    /// Time complexity: O(log n)
    pub fn pop(self: &!BinaryHeap<T>) -> Option<T> {
        if self.data.is_empty() {
            return None
        }

        let len = self.data.len()
        if len == 1 {
            return self.data.pop()
        }

        // Swap root with last element, then sift down
        self.data.swap(0, len - 1)
        let result = self.data.pop()
        if !self.data.is_empty() {
            self.sift_down(0)
        }
        result
    }

    /// Pushes an element and pops the smallest element.
    ///
    /// More efficient than push followed by pop.
    /// Time complexity: O(log n)
    pub fn push_pop(self: &!BinaryHeap<T>, item: T) -> T {
        if self.data.is_empty() {
            return item
        }

        // If new item is smaller than or equal to root, just return it
        if item <= self.data[0] {
            return item
        }

        // Replace root with new item, sift down, return old root
        let result = self.data[0]
        self.data[0] = item
        self.sift_down(0)
        result
    }

    /// Removes all elements from the heap.
    pub fn clear(self: &!BinaryHeap<T>) {
        self.data.clear()
    }

    /// Returns the heap as a sorted Vec (ascending order).
    ///
    /// This consumes the heap.
    /// Time complexity: O(n log n)
    pub fn into_sorted_vec(self: BinaryHeap<T>) -> Vec<T> with Alloc {
        var heap = self
        var result = Vec::with_capacity(heap.len())

        while !heap.is_empty() {
            match heap.pop() {
                Some(item) => result.push(item),
                None => break,
            }
        }

        result
    }

    /// Creates a heap from a Vec in O(n) time (heapify).
    pub fn from_vec(v: Vec<T>) -> BinaryHeap<T> {
        var heap = BinaryHeap { data: v }
        heap.heapify()
        heap
    }

    /// Converts the heap into a Vec without sorting.
    pub fn into_vec(self: BinaryHeap<T>) -> Vec<T> {
        self.data
    }

    // =========================================================================
    // Internal helpers
    // =========================================================================

    /// Restore heap property by moving element at pos up.
    fn sift_up(self: &!BinaryHeap<T>, pos: usize) {
        var current = pos

        while current > 0 {
            let parent = (current - 1) / 2

            if self.data[current] >= self.data[parent] {
                break
            }

            self.data.swap(current, parent)
            current = parent
        }
    }

    /// Restore heap property by moving element at pos down.
    fn sift_down(self: &!BinaryHeap<T>, pos: usize) {
        let len = self.data.len()
        var current = pos

        while true {
            let left = 2 * current + 1
            let right = 2 * current + 2
            var smallest = current

            if left < len && self.data[left] < self.data[smallest] {
                smallest = left
            }

            if right < len && self.data[right] < self.data[smallest] {
                smallest = right
            }

            if smallest == current {
                break
            }

            self.data.swap(current, smallest)
            current = smallest
        }
    }

    /// Convert arbitrary Vec into a valid heap (Floyd's algorithm).
    /// Time complexity: O(n)
    fn heapify(self: &!BinaryHeap<T>) {
        let len = self.data.len()
        if len <= 1 {
            return
        }

        // Start from last non-leaf node and sift down each
        var i = (len / 2) as i64 - 1
        while i >= 0 {
            self.sift_down(i as usize)
            i = i - 1
        }
    }
}

// =============================================================================
// Reverse wrapper for max-heap behavior
// =============================================================================

/// Wrapper that reverses the ordering of T.
/// Use with BinaryHeap to create a max-heap.
///
/// # Example
/// ```sio
/// var max_heap: BinaryHeap<Reverse<i64>> = BinaryHeap::new()
/// max_heap.push(Reverse(1))
/// max_heap.push(Reverse(3))
/// max_heap.push(Reverse(2))
/// // max_heap.pop() returns Reverse(3), Reverse(2), Reverse(1)
/// ```
pub struct Reverse<T>(T);

impl<T> Reverse<T> {
    /// Create a new Reverse wrapper.
    pub fn new(value: T) -> Reverse<T> {
        Reverse(value)
    }

    /// Get the inner value.
    pub fn into_inner(self: Reverse<T>) -> T {
        match self {
            Reverse(v) => v,
        }
    }
}

impl<T: Ord> Ord for Reverse<T> {
    fn cmp(self: &Reverse<T>, other: &Reverse<T>) -> Ordering {
        // Reverse the comparison
        match self {
            Reverse(a) => match other {
                Reverse(b) => b.cmp(a),
            },
        }
    }
}

impl<T: PartialOrd> PartialOrd for Reverse<T> {
    fn partial_cmp(self: &Reverse<T>, other: &Reverse<T>) -> Option<Ordering> {
        match self {
            Reverse(a) => match other {
                Reverse(b) => b.partial_cmp(a),
            },
        }
    }
}

impl<T: Eq> Eq for Reverse<T> {}

impl<T: PartialEq> PartialEq for Reverse<T> {
    fn eq(self: &Reverse<T>, other: &Reverse<T>) -> bool {
        match self {
            Reverse(a) => match other {
                Reverse(b) => a == b,
            },
        }
    }
}

// =============================================================================
// MaxHeap convenience type
// =============================================================================

/// A max-heap: largest element is returned first.
///
/// This is a convenience wrapper around BinaryHeap<Reverse<T>>.
pub struct MaxHeap<T> {
    inner: BinaryHeap<Reverse<T>>,
}

impl<T> MaxHeap<T> {
    /// Creates an empty MaxHeap.
    pub fn new() -> MaxHeap<T> {
        MaxHeap { inner: BinaryHeap::new() }
    }

    /// Creates a MaxHeap with the specified capacity.
    pub fn with_capacity(capacity: usize) -> MaxHeap<T> with Alloc {
        MaxHeap { inner: BinaryHeap::with_capacity(capacity) }
    }

    /// Returns the number of elements.
    pub fn len(self: &MaxHeap<T>) -> usize {
        self.inner.len()
    }

    /// Returns true if empty.
    pub fn is_empty(self: &MaxHeap<T>) -> bool {
        self.inner.is_empty()
    }

    /// Returns a reference to the largest element.
    pub fn peek(self: &MaxHeap<T>) -> Option<&T> {
        match self.inner.peek() {
            Some(Reverse(v)) => Some(v),
            None => None,
        }
    }

    /// Pushes an element onto the heap.
    pub fn push(self: &!MaxHeap<T>, item: T) with Alloc {
        self.inner.push(Reverse(item))
    }

    /// Removes and returns the largest element.
    pub fn pop(self: &!MaxHeap<T>) -> Option<T> {
        match self.inner.pop() {
            Some(rev) => Some(rev.into_inner()),
            None => None,
        }
    }

    /// Removes all elements.
    pub fn clear(self: &!MaxHeap<T>) {
        self.inner.clear()
    }
}

// =============================================================================
// Priority Queue Entry (for explicit priorities)
// =============================================================================

/// Entry with explicit priority for use in priority queues.
///
/// Ordered by priority only; value is ignored in comparisons.
pub struct PriorityEntry<P, V> {
    priority: P,
    value: V,
}

impl<P, V> PriorityEntry<P, V> {
    /// Create a new priority entry.
    pub fn new(priority: P, value: V) -> PriorityEntry<P, V> {
        PriorityEntry { priority, value }
    }

    /// Get the priority.
    pub fn priority(self: &PriorityEntry<P, V>) -> &P {
        &self.priority
    }

    /// Get the value.
    pub fn value(self: &PriorityEntry<P, V>) -> &V {
        &self.value
    }

    /// Consume and return the value.
    pub fn into_value(self: PriorityEntry<P, V>) -> V {
        self.value
    }
}

impl<P: Ord, V> Ord for PriorityEntry<P, V> {
    fn cmp(self: &PriorityEntry<P, V>, other: &PriorityEntry<P, V>) -> Ordering {
        self.priority.cmp(&other.priority)
    }
}

impl<P: PartialOrd, V> PartialOrd for PriorityEntry<P, V> {
    fn partial_cmp(self: &PriorityEntry<P, V>, other: &PriorityEntry<P, V>) -> Option<Ordering> {
        self.priority.partial_cmp(&other.priority)
    }
}

impl<P: Eq, V> Eq for PriorityEntry<P, V> {}

impl<P: PartialEq, V> PartialEq for PriorityEntry<P, V> {
    fn eq(self: &PriorityEntry<P, V>, other: &PriorityEntry<P, V>) -> bool {
        self.priority == other.priority
    }
}

// =============================================================================
// Tests
// =============================================================================

fn test_basic_operations() -> bool {
    var heap: BinaryHeap<i64> = BinaryHeap::new()

    heap.push(3)
    heap.push(1)
    heap.push(4)
    heap.push(1)
    heap.push(5)

    // Should be min-heap
    match heap.pop() {
        Some(1) => {},
        _ => return false,
    }
    match heap.pop() {
        Some(1) => {},
        _ => return false,
    }
    match heap.pop() {
        Some(3) => {},
        _ => return false,
    }

    true
}

fn test_from_vec() -> bool {
    let v = vec![5, 3, 7, 1, 9, 2]
    var heap = BinaryHeap::from_vec(v)

    match heap.pop() {
        Some(1) => {},
        _ => return false,
    }
    match heap.pop() {
        Some(2) => {},
        _ => return false,
    }
    match heap.pop() {
        Some(3) => {},
        _ => return false,
    }

    true
}

fn test_max_heap() -> bool {
    var heap: MaxHeap<i64> = MaxHeap::new()

    heap.push(3)
    heap.push(1)
    heap.push(4)

    match heap.pop() {
        Some(4) => {},
        _ => return false,
    }
    match heap.pop() {
        Some(3) => {},
        _ => return false,
    }
    match heap.pop() {
        Some(1) => {},
        _ => return false,
    }

    true
}

pub fn run_tests() -> bool {
    test_basic_operations() &&
    test_from_vec() &&
    test_max_heap()
}
