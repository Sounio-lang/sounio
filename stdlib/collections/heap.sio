//! Binary Heap (Priority Queue)
//!
//! A binary min-heap implementation providing O(log n) push and pop operations.
//! The smallest element is always at the front.
//!
//! # Usage
//! ```sio
//! var heap = heap_new()
//! heap_push(&!heap, 3)
//! heap_push(&!heap, 1)
//! heap_push(&!heap, 2)
//! // heap_pop(&!heap) returns Some(1), Some(2), Some(3)
//! ```

extern "C" {
    fn malloc(size: usize) -> *mut u8;
    fn free(ptr: *mut u8);
    fn realloc(ptr: *mut u8, size: usize) -> *mut u8;
}

// A binary min-heap for i64 values
pub struct BinaryHeap {
    data: *mut i64,
    len: usize,
    cap: usize,
}

// Creates an empty binary heap with initial capacity of 16 elements
pub fn heap_new() -> BinaryHeap with Alloc {
    let initial_cap = 16
    let size_bytes = initial_cap * 8
    let ptr = malloc(size_bytes) as *mut i64

    let result = BinaryHeap {
        data: ptr,
        len: 0,
        cap: initial_cap,
    }
    return result
}

// Returns the number of elements in the heap
pub fn heap_len(h: &BinaryHeap) -> usize {
    return h.len
}

// Returns true if the heap contains no elements
pub fn heap_is_empty(h: &BinaryHeap) -> bool {
    return h.len == 0
}

// Returns the smallest element, or None if empty
pub fn heap_peek(h: &BinaryHeap) -> Option<i64> with Panic {
    if heap_is_empty(h) {
        return None
    }
    return Some(h.data[0])
}

// Pushes an element onto the heap (O(log n))
pub fn heap_push(h: &!BinaryHeap, item: i64) with Alloc, Panic, Div {
    // Resize if needed
    if h.len >= h.cap {
        let new_cap = h.cap * 2
        let size_bytes = new_cap * 8
        let new_ptr = realloc(h.data as *mut u8, size_bytes) as *mut i64
        h.data = new_ptr
        h.cap = new_cap
    }

    h.data[h.len] = item
    h.len = h.len + 1
    heap_sift_up(&!h, h.len - 1)
}

// Removes and returns the smallest element, or None if empty (O(log n))
pub fn heap_pop(h: &!BinaryHeap) -> Option<i64> with Panic, Div {
    if h.len == 0 {
        return None
    }

    let root = h.data[0]
    h.len = h.len - 1

    if h.len > 0 {
        // Move last element to root
        h.data[0] = h.data[h.len]
        heap_sift_down(&!h, 0)
    }

    return Some(root)
}

// Removes all elements from the heap
pub fn heap_clear(h: &!BinaryHeap) {
    h.len = 0
}

// Frees the heap
pub fn heap_drop(h: &!BinaryHeap) with Alloc {
    if h.data != null_mut() {
        free(h.data as *mut u8)
        h.data = null_mut()
    }
}

// Internal: Restore heap property by moving element up
fn heap_sift_up(h: &!BinaryHeap, pos: usize) with Panic, Div {
    var current = pos

    while current > 0 {
        let parent = (current - 1) / 2

        if h.data[current] >= h.data[parent] {
            break
        }

        // Swap with parent
        let temp = h.data[current]
        h.data[current] = h.data[parent]
        h.data[parent] = temp

        current = parent
    }
}

// Internal: Restore heap property by moving element down
fn heap_sift_down(h: &!BinaryHeap, pos: usize) with Panic, Div {
    let len = h.len
    var current = pos

    while true {
        let left = 2 * current + 1
        let right = 2 * current + 2
        var smallest = current

        if left < len && h.data[left] < h.data[smallest] {
            smallest = left
        }

        if right < len && h.data[right] < h.data[smallest] {
            smallest = right
        }

        if smallest == current {
            break
        }

        // Swap with smallest child
        let temp = h.data[current]
        h.data[current] = h.data[smallest]
        h.data[smallest] = temp

        current = smallest
    }
}

// Tests
fn test_basic_heap_operations() -> bool with Alloc, Panic, Div {
    var heap = heap_new()

    heap_push(&!heap, 3)
    heap_push(&!heap, 1)
    heap_push(&!heap, 4)
    heap_push(&!heap, 1)
    heap_push(&!heap, 5)

    // Should be min-heap
    match heap_pop(&!heap) {
        Some(1) => {},
        _ => return false,
    }
    match heap_pop(&!heap) {
        Some(1) => {},
        _ => return false,
    }
    match heap_pop(&!heap) {
        Some(3) => {},
        _ => return false,
    }

    heap_drop(&!heap)
    return true
}

pub fn heap_run_tests() -> bool with Alloc, Panic, Div {
    return test_basic_heap_operations()
}
