// stdlib/collections/heap — Binary min-heap
//
// IntHeap: min-heap of i64 values, capacity 4096.
// push O(log n), pop_min O(log n), peek_min O(1).

let HEAP_CAP: i64 = 4096

struct IntHeap {
    data: [i64; 4096],
    len: i64,
}

impl IntHeap {
    fn new() -> IntHeap {
        IntHeap { data: [0; 4096], len: 0 }
    }

    fn len(self: &IntHeap) -> i64 {
        self.len
    }

    fn is_empty(self: &IntHeap) -> bool {
        self.len == 0
    }

    fn peek_min(self: &IntHeap) -> i64 {
        if self.len > 0 { return self.data[0] }
        return 0
    }

    fn push(self: &! IntHeap, val: i64) {
        if self.len >= HEAP_CAP { return }
        self.data[self.len] = val
        self.len = self.len + 1
        // Swim up
        var i = self.len - 1
        while i > 0 {
            let parent = (i - 1) / 2
            if self.data[i] < self.data[parent] {
                let tmp = self.data[i]
                self.data[i] = self.data[parent]
                self.data[parent] = tmp
                i = parent
            } else {
                return
            }
        }
    }

    fn pop_min(self: &! IntHeap) -> i64 {
        if self.len == 0 { return 0 }
        let result = self.data[0]
        self.len = self.len - 1
        if self.len == 0 { return result }
        self.data[0] = self.data[self.len]
        // Sink down
        var i: i64 = 0
        var done = false
        while !done {
            let left = 2 * i + 1
            let right = 2 * i + 2
            var smallest = i
            if left < self.len && self.data[left] < self.data[smallest] {
                smallest = left
            }
            if right < self.len && self.data[right] < self.data[smallest] {
                smallest = right
            }
            if smallest == i {
                done = true
            } else {
                let tmp = self.data[i]
                self.data[i] = self.data[smallest]
                self.data[smallest] = tmp
                i = smallest
            }
        }
        result
    }

    fn clear(self: &! IntHeap) {
        self.len = 0
    }
}

// ============================================================================
// FloatHeap — min-heap of f64 values
// ============================================================================

struct FloatHeap {
    data: [f64; 4096],
    len: i64,
}

impl FloatHeap {
    fn new() -> FloatHeap {
        FloatHeap { data: [0.0; 4096], len: 0 }
    }

    fn len(self: &FloatHeap) -> i64 {
        self.len
    }

    fn is_empty(self: &FloatHeap) -> bool {
        self.len == 0
    }

    fn peek_min(self: &FloatHeap) -> f64 {
        if self.len > 0 { return self.data[0] }
        return 0.0
    }

    fn push(self: &! FloatHeap, val: f64) {
        if self.len >= HEAP_CAP { return }
        self.data[self.len] = val
        self.len = self.len + 1
        var i = self.len - 1
        while i > 0 {
            let parent = (i - 1) / 2
            if self.data[i] < self.data[parent] {
                let tmp = self.data[i]
                self.data[i] = self.data[parent]
                self.data[parent] = tmp
                i = parent
            } else {
                return
            }
        }
    }

    fn pop_min(self: &! FloatHeap) -> f64 {
        if self.len == 0 { return 0.0 }
        let result = self.data[0]
        self.len = self.len - 1
        if self.len == 0 { return result }
        self.data[0] = self.data[self.len]
        var i: i64 = 0
        var done = false
        while !done {
            let left = 2 * i + 1
            let right = 2 * i + 2
            var smallest = i
            if left < self.len && self.data[left] < self.data[smallest] {
                smallest = left
            }
            if right < self.len && self.data[right] < self.data[smallest] {
                smallest = right
            }
            if smallest == i {
                done = true
            } else {
                let tmp = self.data[i]
                self.data[i] = self.data[smallest]
                self.data[smallest] = tmp
                i = smallest
            }
        }
        result
    }

    fn clear(self: &! FloatHeap) {
        self.len = 0
    }
}
