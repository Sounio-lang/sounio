// stdlib/collections/trie — Integer-keyed prefix trie
//
// IntTrie: maps i64 keys to i64 values using digit decomposition.
// Each key is decomposed into base-256 digits (8 levels max for i64).
// Flat-array storage: 4096 nodes, each with 256 children slots.
//
// For practical use with small key spaces (0..255 per level).

let TRIE_MAX_NODES: i64 = 4096
let TRIE_CHILDREN: i64 = 16
let TRIE_NIL: i64 = 0 - 1

struct IntTrie {
    children: [i64; 65536],
    values: [i64; 4096],
    has_value: [i64; 4096],
    node_count: i64,
}

fn trie_alloc_node(trie: &! IntTrie) -> i64 {
    if trie.node_count >= TRIE_MAX_NODES { return TRIE_NIL }
    let id = trie.node_count
    trie.has_value[id] = 0
    trie.values[id] = 0
    var c: i64 = 0
    while c < TRIE_CHILDREN {
        trie.children[id * TRIE_CHILDREN + c] = TRIE_NIL
        c = c + 1
    }
    trie.node_count = trie.node_count + 1
    id
}

fn trie_child(trie: &IntTrie, node: i64, digit: i64) -> i64 {
    trie.children[node * TRIE_CHILDREN + digit]
}

fn trie_set_child(trie: &! IntTrie, node: i64, digit: i64, child: i64) {
    trie.children[node * TRIE_CHILDREN + digit] = child
}

// Extract nibble (4-bit digit) at position pos from key
fn trie_nibble(key: i64, pos: i64) -> i64 {
    let shift = pos * 4
    (key >> shift) & 0xF
}

impl IntTrie {
    fn new() -> IntTrie {
        var trie = IntTrie {
            children: [0; 65536],
            values: [0; 4096],
            has_value: [0; 4096],
            node_count: 0,
        }
        // Allocate root
        trie.node_count = 1
        trie.has_value[0] = 0
        var c: i64 = 0
        while c < TRIE_CHILDREN {
            trie.children[c] = TRIE_NIL
            c = c + 1
        }
        trie
    }

    fn is_empty(self: &IntTrie) -> bool {
        self.node_count <= 1
    }
}

fn trie_insert(trie: &! IntTrie, key: i64, val: i64) {
    var node: i64 = 0
    // Use 16 nibbles (64 bits / 4 bits per nibble)
    var level: i64 = 15
    while level >= 0 {
        let digit = trie_nibble(key, level)
        var child = trie_child(trie, node, digit)
        if child == TRIE_NIL {
            child = trie_alloc_node(trie)
            if child == TRIE_NIL { return }
            trie_set_child(trie, node, digit, child)
        }
        node = child
        level = level - 1
    }
    trie.values[node] = val
    trie.has_value[node] = 1
}

fn trie_lookup(trie: &IntTrie, key: i64) -> i64 {
    var node: i64 = 0
    var level: i64 = 15
    while level >= 0 {
        let digit = trie_nibble(key, level)
        let child = trie_child(trie, node, digit)
        if child == TRIE_NIL { return 0 }
        node = child
        level = level - 1
    }
    if trie.has_value[node] == 1 { return trie.values[node] }
    return 0
}

fn trie_contains(trie: &IntTrie, key: i64) -> bool {
    var node: i64 = 0
    var level: i64 = 15
    while level >= 0 {
        let digit = trie_nibble(key, level)
        let child = trie_child(trie, node, digit)
        if child == TRIE_NIL { return false }
        node = child
        level = level - 1
    }
    trie.has_value[node] == 1
}
