//! stdlib/collections/lib.sio - Collection data structures
//!
//! This module provides fundamental collection types:
//! - Vec: Dynamic array/vector
//! - HashMap: Hash map/dictionary
//! - HashSet: Hash set
//! - Deque: Double-ended queue
//! - BinaryHeap: Priority queue (min-heap)
//! - BitSet: Efficient bit operations
//! - BTreeMap/BTreeSet: Sorted map/set with O(log n) operations
//! - Trie: Prefix tree for string operations

// Vec is a core collection type
pub use vec::*;

// HashMap provides key-value storage
pub use hashmap::*;

// HashSet provides unique value storage
pub use hashset::*;

// Deque provides efficient double-ended queue operations
pub use deque::*;

// BinaryHeap provides priority queue operations
pub use heap::*;

// BitSet provides efficient bit vector operations
pub use bitset::*;

// BTreeMap/BTreeSet provides sorted collections
pub use btree::*;

// Trie provides prefix-based string operations
pub use trie::*;
