//! stdlib/collections/lib.sio - Collection data structures
//!
//! This module provides fundamental collection types:
//! - Vec: Dynamic array/vector
//! - HashMap: Hash map/dictionary
//! - HashSet: Hash set
//! - Deque: Double-ended queue

// Vec is a core collection type
pub use vec::*;

// HashMap provides key-value storage
pub use hashmap::*;

// HashSet provides unique value storage
pub use hashset::*;

// Deque provides efficient double-ended queue operations
pub use deque::*;
