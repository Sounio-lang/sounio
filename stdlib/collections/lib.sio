// stdlib/collections — Monomorphic collection data structures
//
// All collections use fixed-capacity flat arrays with impl blocks.
// No generics needed — type-specialized structs for i64, f64, bool.
//
// Modules:
//   vec      — IntVec, FloatVec, BoolVec
//   hashmap  — IntIntMap, IntFloatMap
//   hashset  — IntSet
//   heap     — IntHeap, FloatHeap
//   deque    — IntDeque
//   bitset   — BitSet
//   btree    — IntBTree
//   trie     — IntTrie


// Submodules are resolved by path (`use collections::<name>`);
// Sounio has no `mod` item, so the declarations that stood here were
// inert Rust syntax that also stopped this file parsing. Covered:
//   vec, hashmap, hashset, heap, deque, bitset, btree, trie, stack
