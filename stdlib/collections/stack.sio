//! stdlib/collections/stack.sio — Fixed-capacity stack (64 elements)

pub struct Stack64 { data: [i64; 64], top: i64 }

pub fn stack_new() -> Stack64 with Mut {
    Stack64 { data: [0; 64], top: 0 }
}

pub fn stack_push(s: &! Stack64, val: i64) -> bool with Mut {
    if s.top >= 64 { return false }
    s.data[s.top as usize] = val
    s.top = s.top + 1
    true
}

pub fn stack_pop(s: &! Stack64) -> i64 with Mut {
    if s.top <= 0 { return 0 - 1 }
    s.top = s.top - 1
    s.data[s.top as usize]
}

pub fn stack_peek(s: &Stack64) -> i64 {
    if s.top <= 0 { return 0 - 1 }
    s.data[(s.top - 1) as usize]
}

pub fn stack_empty(s: &Stack64) -> bool { s.top == 0 }

pub fn stack_size(s: &Stack64) -> i64 { s.top }
