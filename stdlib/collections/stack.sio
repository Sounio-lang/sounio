//@ run-pass
//@ expect-stdout: ALL PASS

// stdlib/collections/stack.sio — Fixed-capacity i64 stack (64 elements)

pub struct Stack64 { data: [i64; 64], top: i64 }

pub fn stack_new() -> Stack64 {
    Stack64 { data: [0; 64], top: 0 }
}

pub fn stack_push(s: &!Stack64, val: i64) -> bool with Mut, Panic {
    if s.top >= 64 { return false }
    s.data[s.top] = val
    s.top = s.top + 1
    true
}

pub fn stack_pop(s: &!Stack64) -> i64 with Mut, Panic {
    if s.top <= 0 { return 0 - 1 }
    s.top = s.top - 1
    s.data[s.top]
}

pub fn stack_peek(s: &Stack64) -> i64 with Panic {
    if s.top <= 0 { return 0 - 1 }
    s.data[s.top - 1]
}

pub fn stack_empty(s: &Stack64) -> bool { s.top == 0 }

pub fn stack_size(s: &Stack64) -> i64 { s.top }

pub fn stack_clear(s: &!Stack64) with Mut { s.top = 0 }

// ============================================================================
// TESTS
// ============================================================================

var CNT: [i64; 2] = [0; 2]

fn chk(label: i64, ok: i64) with IO, Mut {
    if ok == 1 {
        print("  PASS ["); print(label); print("]\n")
        CNT[0] = CNT[0] + 1
    } else {
        print("  FAIL ["); print(label); print("]\n")
        CNT[1] = CNT[1] + 1
    }
}

fn test_stack() with IO, Mut, Panic {
    var s = Stack64 { data: [0; 64], top: 0 }

    chk(1, if stack_empty(&s) { 1 } else { 0 })
    chk(2, if stack_size(&s) == 0 { 1 } else { 0 })

    stack_push(&!s, 10)
    stack_push(&!s, 20)
    stack_push(&!s, 30)

    chk(3, if stack_size(&s) == 3 { 1 } else { 0 })
    chk(4, if stack_empty(&s) { 0 } else { 1 })
    chk(5, if stack_peek(&s) == 30 { 1 } else { 0 })

    let v1 = stack_pop(&!s)
    chk(6, if v1 == 30 { 1 } else { 0 })
    chk(7, if stack_size(&s) == 2 { 1 } else { 0 })

    let v2 = stack_pop(&!s)
    chk(8, if v2 == 20 { 1 } else { 0 })

    stack_clear(&!s)
    chk(9, if stack_empty(&s) { 1 } else { 0 })

    // Pop from empty stack returns -1
    let empty_pop = stack_pop(&!s)
    chk(10, if empty_pop == 0 - 1 { 1 } else { 0 })

    // Fill to capacity
    var i: i64 = 0
    while i < 64 {
        stack_push(&!s, i)
        i = i + 1
    }
    chk(11, if stack_size(&s) == 64 { 1 } else { 0 })

    // Push beyond capacity returns false
    let overflow = stack_push(&!s, 999)
    chk(12, if overflow { 0 } else { 1 })
}

pub fn main() -> i32 with IO, Mut, Panic, Div {
    CNT[0] = 0; CNT[1] = 0
    print("─── stdlib/collections/stack tests ───\n")
    test_stack()
    print("─── "); print(CNT[0]); print("/"); print(CNT[0]+CNT[1]); print(" PASS ───\n")
    if CNT[1] == 0 { print("ALL PASS\n"); 0 } else { 1 }
}
