// Owned i64 ring. 0 OK, 1 invalid argument, 2 budget, 3 allocation,
// 4 empty/out of bounds. No sentinel ambiguity; failed mutations preserve state.
pub linear struct DynamicDeque {
    ptr: *mut i64, head: i64, size: i64, capacity: i64, max_bytes: i64, status: i64,
}
pub struct DequeValue { pub value:i64, pub status:i64 }
pub fn dynamic_deque_new(max_bytes:i64)->DynamicDeque {
    DynamicDeque { ptr:0 as *mut i64,head:0,size:0,capacity:0,max_bytes:max_bytes,status:if max_bytes<0 {1} else {0} }
}
pub fn dynamic_deque_status(d:&DynamicDeque)->i64 {d.status}
pub fn dynamic_deque_len(d:&DynamicDeque)->i64 {d.size}
pub fn dynamic_deque_reserve(d:&!DynamicDeque,n:i64)->i64 with Alloc,Mut,Div {
    if d.status!=0 {return d.status}
    if n<0 {return 1}
    if n>d.max_bytes/8 {return 2}
    if n<=d.capacity {return 0}
    let next=heap_alloc(n*8) as *mut i64
    if (next as i64)<=0 {return 3}
    var i:i64=0
    while i<d.size {
        write_i64(next,i,read_i64(d.ptr,(d.head+i)%d.capacity))
        i=i+1
    }
    if d.capacity>0 {heap_free(d.ptr as *mut i8)}
    d.ptr=next;d.capacity=n;d.head=0
    return 0
}
fn dynamic_deque_grow(d:&!DynamicDeque)->i64 with Alloc,Mut,Div {
    if d.status!=0 {return d.status}
    let limit=d.max_bytes/8
    if d.size>=limit {return 2}
    if d.size<d.capacity {return 0}
    var n=if d.capacity==0 {4} else {d.capacity}
    if n>limit/2 {n=limit} else {n=n*2}
    if n>limit {n=limit}
    return dynamic_deque_reserve(d,n)
}
pub fn dynamic_deque_push_back(d:&!DynamicDeque,value:i64)->i64 with Alloc,Mut,Div {
    let status=dynamic_deque_grow(d)
    if status!=0 {return status}
    write_i64(d.ptr,(d.head+d.size)%d.capacity,value)
    d.size=d.size+1
    return 0
}
pub fn dynamic_deque_push_front(d:&!DynamicDeque,value:i64)->i64 with Alloc,Mut,Div {
    let status=dynamic_deque_grow(d)
    if status!=0 {return status}
    if d.head==0 {d.head=d.capacity-1} else {d.head=d.head-1}
    write_i64(d.ptr,d.head,value)
    d.size=d.size+1
    return 0
}
pub fn dynamic_deque_get(d:&DynamicDeque,index:i64)->DequeValue with Div {
    if d.status!=0 {return DequeValue {value:0,status:d.status}}
    if index<0 || index>=d.size {return DequeValue {value:0,status:4}}
    return DequeValue {value:read_i64(d.ptr,(d.head+index)%d.capacity),status:0}
}
pub fn dynamic_deque_pop_front(d:&!DynamicDeque)->DequeValue with Mut,Div {
    if d.status!=0 {return DequeValue {value:0,status:d.status}}
    if d.size==0 {return DequeValue {value:0,status:4}}
    let value=read_i64(d.ptr,d.head)
    d.head=(d.head+1)%d.capacity
    d.size=d.size-1
    return DequeValue {value:value,status:0}
}
pub fn dynamic_deque_pop_back(d:&!DynamicDeque)->DequeValue with Mut,Div {
    if d.status!=0 {return DequeValue {value:0,status:d.status}}
    if d.size==0 {return DequeValue {value:0,status:4}}
    let index=(d.head+d.size-1)%d.capacity
    let value=read_i64(d.ptr,index)
    d.size=d.size-1
    return DequeValue {value:value,status:0}
}
pub fn dynamic_deque_close(d:DynamicDeque) with Alloc {
    let DynamicDeque {ptr,head,size,capacity,max_bytes,status}=d
    if capacity>0 {heap_free(ptr as *mut i8)}
}
