// stdlib/collections/hashset — Integer hash set
//
// IntSet: set of i64 values, backed by open-addressing hash table.
// Capacity: 2048. Uses same FNV-1a hash as hashmap.

let HASHSET_CAP: i64 = 2048

fn hashset_fnv1a(key: i64) -> i64 {
    var hash: i64 = 0x00000100000001B3
    var k = key
    var i: i64 = 0
    while i < 8 {
        let byte = k & 0xFF
        hash = (hash ^ byte) * 0x01000193
        k = k >> 8
        i = i + 1
    }
    if hash < 0 { hash = 0 - hash }
    hash
}

struct IntSet {
    keys: [i64; 2048],
    used: [i64; 2048],
    count: i64,
}

impl IntSet {
    pub fn new() -> IntSet {
        IntSet {
            keys: [0; 2048],
            used: [0; 2048],
            count: 0,
        }
    }

    pub fn len(self: &IntSet) -> i64 {
        self.count
    }

    pub fn is_empty(self: &IntSet) -> bool {
        self.count == 0
    }

    pub fn insert(self: &! IntSet, key: i64) -> bool {
        if self.count >= HASHSET_CAP - 1 { return false }
        let h = hashset_fnv1a(key)
        var idx = h % HASHSET_CAP
        if idx < 0 { idx = 0 - idx }
        var probes: i64 = 0
        while probes < HASHSET_CAP {
            if self.used[idx] == 0 {
                self.keys[idx] = key
                self.used[idx] = 1
                self.count = self.count + 1
                return true
            }
            if self.used[idx] == 1 && self.keys[idx] == key {
                return false
            }
            idx = (idx + 1) % HASHSET_CAP
            probes = probes + 1
        }
        return false
    }

    pub fn contains(self: &IntSet, key: i64) -> bool {
        let h = hashset_fnv1a(key)
        var idx = h % HASHSET_CAP
        if idx < 0 { idx = 0 - idx }
        var probes: i64 = 0
        while probes < HASHSET_CAP {
            if self.used[idx] == 0 { return false }
            if self.used[idx] == 1 && self.keys[idx] == key {
                return true
            }
            idx = (idx + 1) % HASHSET_CAP
            probes = probes + 1
        }
        return false
    }

    pub fn remove(self: &! IntSet, key: i64) -> bool {
        let h = hashset_fnv1a(key)
        var idx = h % HASHSET_CAP
        if idx < 0 { idx = 0 - idx }
        var probes: i64 = 0
        while probes < HASHSET_CAP {
            if self.used[idx] == 0 { return false }
            if self.used[idx] == 1 && self.keys[idx] == key {
                self.used[idx] = 2
                self.count = self.count - 1
                return true
            }
            idx = (idx + 1) % HASHSET_CAP
            probes = probes + 1
        }
        return false
    }

    pub fn clear(self: &! IntSet) {
        var i: i64 = 0
        while i < HASHSET_CAP {
            self.used[i] = 0
            i = i + 1
        }
        self.count = 0
    }
}
