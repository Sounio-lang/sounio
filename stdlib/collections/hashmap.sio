// stdlib/collections/hashmap — Open-addressing hash maps
//
// IntIntMap:   i64 → i64
// IntFloatMap: i64 → f64
//
// Hash: FNV-1a. Collision: linear probing. Capacity: 2048 slots.

let HASHMAP_CAP: i64 = 2048
let FNV_OFFSET: i64 = 0x00000100000001B3
let FNV_PRIME: i64 = 0x01000193

// ============================================================================
// Hash function
// ============================================================================

fn fnv1a_i64(key: i64) -> i64 {
    var hash: i64 = FNV_OFFSET
    var k = key
    var i: i64 = 0
    while i < 8 {
        let byte = k & 0xFF
        hash = (hash ^ byte) * FNV_PRIME
        k = k >> 8
        i = i + 1
    }
    if hash < 0 { hash = 0 - hash }
    hash
}

// ============================================================================
// IntIntMap — i64 keys, i64 values
// ============================================================================

struct IntIntMap {
    keys: [i64; 2048],
    vals: [i64; 2048],
    used: [i64; 2048],
    count: i64,
}

impl IntIntMap {
    fn new() -> IntIntMap {
        IntIntMap {
            keys: [0; 2048],
            vals: [0; 2048],
            used: [0; 2048],
            count: 0,
        }
    }

    fn len(self: &IntIntMap) -> i64 {
        self.count
    }

    fn is_empty(self: &IntIntMap) -> bool {
        self.count == 0
    }

    fn insert(self: &! IntIntMap, key: i64, val: i64) {
        if self.count >= HASHMAP_CAP - 1 { return }
        let h = fnv1a_i64(key)
        var idx = h % HASHMAP_CAP
        if idx < 0 { idx = 0 - idx }
        var probes: i64 = 0
        while probes < HASHMAP_CAP {
            if self.used[idx] == 0 {
                self.keys[idx] = key
                self.vals[idx] = val
                self.used[idx] = 1
                self.count = self.count + 1
                return
            }
            if self.used[idx] == 1 && self.keys[idx] == key {
                self.vals[idx] = val
                return
            }
            idx = (idx + 1) % HASHMAP_CAP
            probes = probes + 1
        }
    }

    fn get(self: &IntIntMap, key: i64) -> i64 {
        let h = fnv1a_i64(key)
        var idx = h % HASHMAP_CAP
        if idx < 0 { idx = 0 - idx }
        var probes: i64 = 0
        while probes < HASHMAP_CAP {
            if self.used[idx] == 0 { return 0 }
            if self.used[idx] == 1 && self.keys[idx] == key {
                return self.vals[idx]
            }
            idx = (idx + 1) % HASHMAP_CAP
            probes = probes + 1
        }
        return 0
    }

    fn contains(self: &IntIntMap, key: i64) -> bool {
        let h = fnv1a_i64(key)
        var idx = h % HASHMAP_CAP
        if idx < 0 { idx = 0 - idx }
        var probes: i64 = 0
        while probes < HASHMAP_CAP {
            if self.used[idx] == 0 { return false }
            if self.used[idx] == 1 && self.keys[idx] == key {
                return true
            }
            idx = (idx + 1) % HASHMAP_CAP
            probes = probes + 1
        }
        return false
    }

    fn remove(self: &! IntIntMap, key: i64) -> bool {
        let h = fnv1a_i64(key)
        var idx = h % HASHMAP_CAP
        if idx < 0 { idx = 0 - idx }
        var probes: i64 = 0
        while probes < HASHMAP_CAP {
            if self.used[idx] == 0 { return false }
            if self.used[idx] == 1 && self.keys[idx] == key {
                self.used[idx] = 2
                self.count = self.count - 1
                return true
            }
            idx = (idx + 1) % HASHMAP_CAP
            probes = probes + 1
        }
        return false
    }

    fn clear(self: &! IntIntMap) {
        var i: i64 = 0
        while i < HASHMAP_CAP {
            self.used[i] = 0
            i = i + 1
        }
        self.count = 0
    }
}

// ============================================================================
// IntFloatMap — i64 keys, f64 values
// ============================================================================

struct IntFloatMap {
    keys: [i64; 2048],
    vals: [f64; 2048],
    used: [i64; 2048],
    count: i64,
}

impl IntFloatMap {
    fn new() -> IntFloatMap {
        IntFloatMap {
            keys: [0; 2048],
            vals: [0.0; 2048],
            used: [0; 2048],
            count: 0,
        }
    }

    fn len(self: &IntFloatMap) -> i64 {
        self.count
    }

    fn is_empty(self: &IntFloatMap) -> bool {
        self.count == 0
    }

    fn insert(self: &! IntFloatMap, key: i64, val: f64) {
        if self.count >= HASHMAP_CAP - 1 { return }
        let h = fnv1a_i64(key)
        var idx = h % HASHMAP_CAP
        if idx < 0 { idx = 0 - idx }
        var probes: i64 = 0
        while probes < HASHMAP_CAP {
            if self.used[idx] == 0 {
                self.keys[idx] = key
                self.vals[idx] = val
                self.used[idx] = 1
                self.count = self.count + 1
                return
            }
            if self.used[idx] == 1 && self.keys[idx] == key {
                self.vals[idx] = val
                return
            }
            idx = (idx + 1) % HASHMAP_CAP
            probes = probes + 1
        }
    }

    fn get(self: &IntFloatMap, key: i64) -> f64 {
        let h = fnv1a_i64(key)
        var idx = h % HASHMAP_CAP
        if idx < 0 { idx = 0 - idx }
        var probes: i64 = 0
        while probes < HASHMAP_CAP {
            if self.used[idx] == 0 { return 0.0 }
            if self.used[idx] == 1 && self.keys[idx] == key {
                return self.vals[idx]
            }
            idx = (idx + 1) % HASHMAP_CAP
            probes = probes + 1
        }
        return 0.0
    }

    fn contains(self: &IntFloatMap, key: i64) -> bool {
        let h = fnv1a_i64(key)
        var idx = h % HASHMAP_CAP
        if idx < 0 { idx = 0 - idx }
        var probes: i64 = 0
        while probes < HASHMAP_CAP {
            if self.used[idx] == 0 { return false }
            if self.used[idx] == 1 && self.keys[idx] == key {
                return true
            }
            idx = (idx + 1) % HASHMAP_CAP
            probes = probes + 1
        }
        return false
    }

    fn remove(self: &! IntFloatMap, key: i64) -> bool {
        let h = fnv1a_i64(key)
        var idx = h % HASHMAP_CAP
        if idx < 0 { idx = 0 - idx }
        var probes: i64 = 0
        while probes < HASHMAP_CAP {
            if self.used[idx] == 0 { return false }
            if self.used[idx] == 1 && self.keys[idx] == key {
                self.used[idx] = 2
                self.count = self.count - 1
                return true
            }
            idx = (idx + 1) % HASHMAP_CAP
            probes = probes + 1
        }
        return false
    }

    fn clear(self: &! IntFloatMap) {
        var i: i64 = 0
        while i < HASHMAP_CAP {
            self.used[i] = 0
            i = i + 1
        }
        self.count = 0
    }
}
