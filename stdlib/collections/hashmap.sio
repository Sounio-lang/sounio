// stdlib/collections/hashmap — Open-addressing hash maps
//
// IntIntMap:   i64 → i64
// IntFloatMap: i64 → f64
//
// Hash: FNV-1a. Collision: linear probing. Capacity: 2048 slots.

let HASHMAP_CAP: i64 = 2048
let FNV_OFFSET: i64 = 0x00000100000001B3
let FNV_PRIME: i64 = 0x01000193

// ============================================================================
// Hash function
// ============================================================================

fn fnv1a_i64(key: i64) -> i64 {
    var hash: i64 = FNV_OFFSET
    var k = key
    var i: i64 = 0
    while i < 8 {
        let byte = k & 0xFF
        hash = (hash ^ byte) * FNV_PRIME
        k = k >> (8 as u8)
        i = i + 1
    }
    if hash < 0 { hash = 0 - hash }
    hash
}

// ============================================================================
// IntIntMap — i64 keys, i64 values
// ============================================================================

struct IntIntMap {
    keys: [i64; 2048],
    vals: [i64; 2048],
    used: [i64; 2048],
    iim_cnt: i64,
}

impl IntIntMap {
    fn new() -> IntIntMap {
        IntIntMap {
            keys: [0; 2048],
            vals: [0; 2048],
            used: [0; 2048],
            iim_cnt: 0,
        }
    }

    fn len(self: &IntIntMap) -> i64 {
        self.iim_cnt
    }

    fn is_empty(self: &IntIntMap) -> bool {
        self.iim_cnt == 0
    }

    fn insert(self: &! IntIntMap, key: i64, val: i64) {
        if self.iim_cnt >= HASHMAP_CAP - 1 { return }
        let h = fnv1a_i64(key)
        var idx = h % HASHMAP_CAP
        if idx < 0 { idx = 0 - idx }
        var probes: i64 = 0
        while probes < HASHMAP_CAP {
            if self.used[idx] == 0 {
                self.keys[idx] = key
                self.vals[idx] = val
                self.used[idx] = 1
                self.iim_cnt = self.iim_cnt + 1
                return
            }
            if self.used[idx] == 1 && self.keys[idx] == key {
                self.vals[idx] = val
                return
            }
            idx = (idx + 1) % HASHMAP_CAP
            probes = probes + 1
        }
    }

    fn get(self: &IntIntMap, key: i64) -> i64 {
        let h = fnv1a_i64(key)
        var idx = h % HASHMAP_CAP
        if idx < 0 { idx = 0 - idx }
        var probes: i64 = 0
        while probes < HASHMAP_CAP {
            if self.used[idx] == 0 { return 0 }
            if self.used[idx] == 1 && self.keys[idx] == key {
                return self.vals[idx]
            }
            idx = (idx + 1) % HASHMAP_CAP
            probes = probes + 1
        }
        return 0
    }

    fn contains(self: &IntIntMap, key: i64) -> bool {
        let h = fnv1a_i64(key)
        var idx = h % HASHMAP_CAP
        if idx < 0 { idx = 0 - idx }
        var probes: i64 = 0
        while probes < HASHMAP_CAP {
            if self.used[idx] == 0 { return false }
            if self.used[idx] == 1 && self.keys[idx] == key {
                return true
            }
            idx = (idx + 1) % HASHMAP_CAP
            probes = probes + 1
        }
        return false
    }

    fn remove(self: &! IntIntMap, key: i64) -> bool {
        let h = fnv1a_i64(key)
        var idx = h % HASHMAP_CAP
        if idx < 0 { idx = 0 - idx }
        var probes: i64 = 0
        while probes < HASHMAP_CAP {
            if self.used[idx] == 0 { return false }
            if self.used[idx] == 1 && self.keys[idx] == key {
                self.used[idx] = 2
                self.iim_cnt = self.iim_cnt - 1
                return true
            }
            idx = (idx + 1) % HASHMAP_CAP
            probes = probes + 1
        }
        return false
    }

    fn clear(self: &! IntIntMap) {
        var i: i64 = 0
        while i < HASHMAP_CAP {
            self.used[i] = 0
            i = i + 1
        }
        self.iim_cnt = 0
    }
}

// ============================================================================
// IntFloatMap — i64 keys, f64 values
// ============================================================================

struct IntFloatMap {
    keys: [i64; 2048],
    vals: [f64; 2048],
    used: [i64; 2048],
    ifm_cnt: i64,
}

impl IntFloatMap {
    fn new() -> IntFloatMap {
        IntFloatMap {
            keys: [0; 2048],
            vals: [0.0; 2048],
            used: [0; 2048],
            ifm_cnt: 0,
        }
    }

    fn len(self: &IntFloatMap) -> i64 {
        self.ifm_cnt
    }

    fn is_empty(self: &IntFloatMap) -> bool {
        self.ifm_cnt == 0
    }

    fn insert(self: &! IntFloatMap, key: i64, val: f64) {
        if self.ifm_cnt >= HASHMAP_CAP - 1 { return }
        let h = fnv1a_i64(key)
        var idx = h % HASHMAP_CAP
        if idx < 0 { idx = 0 - idx }
        var probes: i64 = 0
        while probes < HASHMAP_CAP {
            if self.used[idx] == 0 {
                self.keys[idx] = key
                self.vals[idx] = val
                self.used[idx] = 1
                self.ifm_cnt = self.ifm_cnt + 1
                return
            }
            if self.used[idx] == 1 && self.keys[idx] == key {
                self.vals[idx] = val
                return
            }
            idx = (idx + 1) % HASHMAP_CAP
            probes = probes + 1
        }
    }

    fn get(self: &IntFloatMap, key: i64) -> f64 {
        let h = fnv1a_i64(key)
        var idx = h % HASHMAP_CAP
        if idx < 0 { idx = 0 - idx }
        var probes: i64 = 0
        while probes < HASHMAP_CAP {
            if self.used[idx] == 0 { return 0.0 }
            if self.used[idx] == 1 && self.keys[idx] == key {
                return self.vals[idx]
            }
            idx = (idx + 1) % HASHMAP_CAP
            probes = probes + 1
        }
        return 0.0
    }

    fn contains(self: &IntFloatMap, key: i64) -> bool {
        let h = fnv1a_i64(key)
        var idx = h % HASHMAP_CAP
        if idx < 0 { idx = 0 - idx }
        var probes: i64 = 0
        while probes < HASHMAP_CAP {
            if self.used[idx] == 0 { return false }
            if self.used[idx] == 1 && self.keys[idx] == key {
                return true
            }
            idx = (idx + 1) % HASHMAP_CAP
            probes = probes + 1
        }
        return false
    }

    fn remove(self: &! IntFloatMap, key: i64) -> bool {
        let h = fnv1a_i64(key)
        var idx = h % HASHMAP_CAP
        if idx < 0 { idx = 0 - idx }
        var probes: i64 = 0
        while probes < HASHMAP_CAP {
            if self.used[idx] == 0 { return false }
            if self.used[idx] == 1 && self.keys[idx] == key {
                self.used[idx] = 2
                self.ifm_cnt = self.ifm_cnt - 1
                return true
            }
            idx = (idx + 1) % HASHMAP_CAP
            probes = probes + 1
        }
        return false
    }

    fn clear(self: &! IntFloatMap) {
        var i: i64 = 0
        while i < HASHMAP_CAP {
            self.used[i] = 0
            i = i + 1
        }
        self.ifm_cnt = 0
    }
}

// ============================================================================
// HashMap64 — i64 → f64, capacity 256, open-addressing with linear probing
// Standalone-function API (no impl block)
// ============================================================================

let HM64_CAP: i64 = 256

pub struct HashMap64 {
    keys:     [i64; 256],
    values:   [f64; 256],
    occupied: [i64; 256],   // 0=empty, 1=occupied, 2=tombstone
    count:    i64,
    capacity: i64,          // always 256
}

fn hash_i64(key: i64) -> i64 {
    let h = (key * 6364136223846793005) >> (33 as u8)
    let r = h & 255
    if r < 0 { 0 - r } else { r }
}

pub fn hashmap_new() -> HashMap64 {
    HashMap64 {
        keys:     [0; 256],
        values:   [0.0; 256],
        occupied: [0; 256],
        count:    0,
        capacity: 256,
    }
}

pub fn hashmap_insert(m: &! HashMap64, key: i64, value: f64) -> bool {
    if m.count >= HM64_CAP - 1 { return false }
    var idx = hash_i64(key)
    var probes: i64 = 0
    while probes < HM64_CAP {
        if m.occupied[idx] == 0 {
            m.keys[idx]     = key
            m.values[idx]   = value
            m.occupied[idx] = 1
            m.count = m.count + 1
            return true
        }
        if m.occupied[idx] == 1 && m.keys[idx] == key {
            m.values[idx] = value
            return true
        }
        idx = (idx + 1) & 255
        probes = probes + 1
    }
    false
}

pub fn hashmap_get(m: &HashMap64, key: i64) -> f64 {
    var idx = hash_i64(key)
    var probes: i64 = 0
    while probes < HM64_CAP {
        if m.occupied[idx] == 0 { return 0.0 }
        if m.occupied[idx] == 1 && m.keys[idx] == key {
            return m.values[idx]
        }
        idx = (idx + 1) & 255
        probes = probes + 1
    }
    0.0
}

pub fn hashmap_contains(m: &HashMap64, key: i64) -> bool {
    var idx = hash_i64(key)
    var probes: i64 = 0
    while probes < HM64_CAP {
        if m.occupied[idx] == 0 { return false }
        if m.occupied[idx] == 1 && m.keys[idx] == key { return true }
        idx = (idx + 1) & 255
        probes = probes + 1
    }
    false
}

pub fn hashmap_remove(m: &! HashMap64, key: i64) -> bool {
    var idx = hash_i64(key)
    var probes: i64 = 0
    while probes < HM64_CAP {
        if m.occupied[idx] == 0 { return false }
        if m.occupied[idx] == 1 && m.keys[idx] == key {
            m.occupied[idx] = 2
            m.count = m.count - 1
            return true
        }
        idx = (idx + 1) & 255
        probes = probes + 1
    }
    false
}

pub fn hashmap_count(m: &HashMap64) -> i64 {
    m.count
}
