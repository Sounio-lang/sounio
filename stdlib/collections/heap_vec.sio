// Heap-allocated growable vectors.
// Backed by heap_alloc / heap_realloc / heap_free (mmap/mremap underneath).
// Usable in native mode only (not JIT).
//
// Method API:
//   var v = HeapI64Vec { ptr: 0 as *mut i64, len: 0, cap: 0 }
//   v.push(42)
//   let x = v.get(0)
//   print_int(v.len())
//   v.free()
//
// IMPORTANT: Always use heap_alloc for the FIRST allocation.
// heap_realloc uses mremap which reads a header 8 bytes before the pointer —
// it must never be called with a null/initial pointer.

// ============================================
// HeapVec<T> - generic heap vector
// ============================================
// CONTRACT, not a suggestion: T must be a scalar that fits and round-trips
// through exactly 8 bytes -- i64, f64, bool, a pointer, or any other type
// whose bit pattern is 8 bytes wide. Every slot is read and written through
// read_i64/write_i64 regardless of what T actually is (pop()'s own comment
// explains why: a cast back to T would reinterpret the bits, not just
// relabel them). Sounio has no generic-parameter size/layout bound to
// enforce this at instantiation, so HeapVec<SomeMultiwordStruct> compiles
// and silently corrupts adjacent heap storage instead of refusing -- until
// this language has layout-aware generic allocation (the honest fix), stick
// to HeapI64Vec / HeapF64Vec below for anything that is not an 8-byte
// scalar, or verify by inspection that T is.
pub struct HeapVec<T> {
    pub ptr: *mut i64,
    pub len: i64,
    pub cap: i64,
}

impl HeapVec<T> {
    pub fn new() -> HeapVec<T> {
        HeapVec { ptr: 0 as *mut i64, len: 0, cap: 0 }
    }
    // A non-positive cap normalizes to the same empty state new() returns.
    // Left un-normalized, a negative cap survived into the struct: len (0)
    // >= a negative cap is true, so the next push() took the GROWTH branch
    // with a null ptr (heap_alloc(cap*8) on a negative byte count) and called
    // heap_realloc on it -- exactly the null/initial pointer this file's own
    // header warns heap_realloc must never see.
    pub fn with_capacity(cap: i64) -> HeapVec<T> with Alloc, Panic {
        if cap <= 0 {
            return HeapVec { ptr: 0 as *mut i64, len: 0, cap: 0 }
        }
        let bytes = cap * 8
        let ptr = heap_alloc(bytes) as *mut i64
        if ptr == 0 as *mut i64 { panic("HeapVec::with_capacity: allocation failed") }
        HeapVec { ptr: ptr, len: 0, cap: cap }
    }
    // Both heap_alloc and heap_realloc return a null pointer on failure and
    // leave any PRIOR allocation untouched -- overwriting self.ptr with that
    // null before checking loses the old allocation (if any) and turns the
    // write below into a null-pointer write. Trap instead: self.ptr / self.cap
    // are only updated once the new allocation is known good.
    pub fn push(self: &!HeapVec<T>, val: T) with Alloc, Mut, Panic {
        if self.len >= self.cap {
            let new_cap = if self.cap == 0 { 4 } else { self.cap * 2 }
            let new_bytes = new_cap * 8
            var new_ptr: *mut i64 = 0 as *mut i64
            if self.cap == 0 {
                new_ptr = heap_alloc(new_bytes) as *mut i64
            } else {
                new_ptr = heap_realloc(self.ptr as *mut i8, new_bytes) as *mut i64
            }
            if new_ptr == 0 as *mut i64 { panic("HeapVec::push: allocation failed") }
            self.ptr = new_ptr
            self.cap = new_cap
        }
        write_i64(self.ptr, self.len, val)
        self.len = self.len + 1
    }
    pub fn pop(self: &!HeapVec<T>) -> T with Mut {
        if self.len > 0 {
            self.len = self.len - 1
            // No `as T`: the slot holds T's raw 64-bit pattern, and a cast
            // would convert the number (2.5 came back as 4612811918334230528.0).
            return read_i64(self.ptr, self.len)
        }
        return 0 as T
    }
    pub fn get(self: &HeapVec<T>, idx: i64) -> T {
        if idx >= 0 && idx < self.len {
            return read_i64(self.ptr, idx)
        }
        return 0 as T
    }
    pub fn set(self: &!HeapVec<T>, idx: i64, val: T) with Mut {
        if idx >= 0 && idx < self.len {
            write_i64(self.ptr, idx, val)
        }
    }
    pub fn len(self: &HeapVec<T>) -> i64 {
        self.len
    }
    pub fn cap(self: &HeapVec<T>) -> i64 {
        self.cap
    }
    pub fn is_empty(self: &HeapVec<T>) -> bool {
        self.len == 0
    }
    pub fn clear(self: &!HeapVec<T>) with Mut {
        self.len = 0
    }
    pub fn contains(self: &HeapVec<T>, val: T) -> bool {
        var i: i64 = 0
        while i < self.len {
            if read_i64(self.ptr, i) == val { return true }
            i = i + 1
        }
        return false
    }
    pub fn sum(self: &HeapVec<T>) -> i64 {
        var s: i64 = 0
        var i: i64 = 0
        while i < self.len {
            s = s + read_i64(self.ptr, i)
            i = i + 1
        }
        return s
    }
    pub fn free(self: &!HeapVec<T>) with Alloc, Mut {
        if self.cap > 0 {
            heap_free(self.ptr as *mut i8)
        }
        self.ptr = 0 as *mut i64
        self.len = 0
        self.cap = 0
    }
}

// ============================================
// HeapI64Vec - 64-bit integer heap vector
// ============================================
pub struct HeapI64Vec {
    pub ptr: *mut i64,
    pub len: i64,
    pub cap: i64,
}

impl HeapI64Vec {
    // See HeapVec<T>::push above: heap_alloc/heap_realloc return null on
    // failure without disturbing a prior allocation; overwrite self.ptr only
    // once the new allocation is confirmed good, and trap otherwise.
    pub fn push(self: &!HeapI64Vec, val: i64) with Alloc, Mut, Panic {
        if self.len >= self.cap {
            let new_cap = if self.cap == 0 { 4 } else { self.cap * 2 }
            let new_bytes = new_cap * 8
            var new_ptr: *mut i64 = 0 as *mut i64
            if self.cap == 0 {
                new_ptr = heap_alloc(new_bytes) as *mut i64
            } else {
                new_ptr = heap_realloc(self.ptr as *mut i8, new_bytes) as *mut i64
            }
            if new_ptr == 0 as *mut i64 { panic("HeapI64Vec::push: allocation failed") }
            self.ptr = new_ptr
            self.cap = new_cap
        }
        write_i64(self.ptr, self.len, val)
        self.len = self.len + 1
    }

    pub fn pop(self: &!HeapI64Vec) -> i64 with Mut {
        if self.len > 0 {
            self.len = self.len - 1
            return read_i64(self.ptr, self.len)
        }
        return 0
    }

    pub fn get(self: &HeapI64Vec, idx: i64) -> i64 {
        if idx >= 0 && idx < self.len {
            return read_i64(self.ptr, idx)
        }
        return 0
    }

    pub fn set(self: &!HeapI64Vec, idx: i64, val: i64) with Mut {
        if idx >= 0 && idx < self.len {
            write_i64(self.ptr, idx, val)
        }
    }

    pub fn len(self: &HeapI64Vec) -> i64 {
        self.len
    }

    pub fn cap(self: &HeapI64Vec) -> i64 {
        self.cap
    }

    pub fn clear(self: &!HeapI64Vec) with Mut {
        self.len = 0
    }

    pub fn contains(self: &HeapI64Vec, val: i64) -> bool {
        var i: i64 = 0
        while i < self.len {
            if read_i64(self.ptr, i) == val { return true }
            i = i + 1
        }
        return false
    }

    pub fn free(self: &!HeapI64Vec) with Alloc, Mut {
        if self.cap > 0 {
            heap_free(self.ptr as *mut i8)
        }
        self.ptr = 0 as *mut i64
        self.len = 0
        self.cap = 0
    }
}

// Free-function aliases for backward compat
pub fn heap_i64_vec_new() -> HeapI64Vec {
    HeapI64Vec { ptr: 0 as *mut i64, len: 0, cap: 0 }
}

// Same non-positive-cap normalization as HeapVec::with_capacity above.
pub fn heap_i64_vec_with_capacity(cap: i64) -> HeapI64Vec with Alloc, Panic {
    if cap <= 0 {
        return HeapI64Vec { ptr: 0 as *mut i64, len: 0, cap: 0 }
    }
    let bytes = cap * 8
    let ptr = heap_alloc(bytes) as *mut i64
    if ptr == 0 as *mut i64 { panic("heap_i64_vec_with_capacity: allocation failed") }
    HeapI64Vec { ptr: ptr, len: 0, cap: cap }
}

pub fn heap_i64_vec_push(v: &! HeapI64Vec, val: i64) with Alloc, Mut, Panic {
    if v.len >= v.cap {
        let new_cap = if v.cap == 0 { 4 } else { v.cap * 2 }
        let new_bytes = new_cap * 8
        var new_ptr: *mut i64 = 0 as *mut i64
        if v.cap == 0 {
            new_ptr = heap_alloc(new_bytes) as *mut i64
        } else {
            new_ptr = heap_realloc(v.ptr as *mut i8, new_bytes) as *mut i64
        }
        if new_ptr == 0 as *mut i64 { panic("heap_i64_vec_push: allocation failed") }
        v.ptr = new_ptr
        v.cap = new_cap
    }
    write_i64(v.ptr, v.len, val)
    v.len = v.len + 1
}

pub fn heap_i64_vec_pop(v: &! HeapI64Vec) -> i64 with Mut {
    if v.len > 0 {
        v.len = v.len - 1
        return read_i64(v.ptr, v.len)
    }
    return 0
}

pub fn heap_i64_vec_get(v: &HeapI64Vec, idx: i64) -> i64 {
    if idx >= 0 && idx < v.len {
        return read_i64(v.ptr, idx)
    }
    return 0
}

pub fn heap_i64_vec_set(v: &! HeapI64Vec, idx: i64, val: i64) with Mut {
    if idx >= 0 && idx < v.len {
        write_i64(v.ptr, idx, val)
    }
}

pub fn heap_i64_vec_len(v: &HeapI64Vec) -> i64 {
    v.len
}

pub fn heap_i64_vec_cap(v: &HeapI64Vec) -> i64 {
    v.cap
}

pub fn heap_i64_vec_free(v: &! HeapI64Vec) with Alloc, Mut {
    if v.cap > 0 {
        heap_free(v.ptr as *mut i8)
    }
    v.ptr = 0 as *mut i64
    v.len = 0
    v.cap = 0
}

// ============================================
// HeapF64Vec - 64-bit float heap vector
// ============================================
pub struct HeapF64Vec {
    pub ptr: *mut f64,
    pub len: i64,
    pub cap: i64,
}

impl HeapF64Vec {
    // See HeapVec<T>::push above: heap_alloc/heap_realloc return null on
    // failure without disturbing a prior allocation; overwrite self.ptr only
    // once the new allocation is confirmed good, and trap otherwise.
    pub fn push(self: &!HeapF64Vec, val: f64) with Alloc, Mut, Panic {
        if self.len >= self.cap {
            let new_cap = if self.cap == 0 { 4 } else { self.cap * 2 }
            let new_bytes = new_cap * 8
            var new_ptr: *mut f64 = 0 as *mut f64
            if self.cap == 0 {
                new_ptr = heap_alloc(new_bytes) as *mut f64
            } else {
                new_ptr = heap_realloc(self.ptr as *mut i8, new_bytes) as *mut f64
            }
            if new_ptr == 0 as *mut f64 { panic("HeapF64Vec::push: allocation failed") }
            self.ptr = new_ptr
            self.cap = new_cap
        }
        write_f64(self.ptr, self.len, val)
        self.len = self.len + 1
    }

    pub fn pop(self: &!HeapF64Vec) -> f64 with Mut {
        if self.len > 0 {
            self.len = self.len - 1
            return read_f64(self.ptr, self.len)
        }
        return 0.0
    }

    pub fn get(self: &HeapF64Vec, idx: i64) -> f64 {
        if idx >= 0 && idx < self.len {
            return read_f64(self.ptr, idx)
        }
        return 0.0
    }

    pub fn set(self: &!HeapF64Vec, idx: i64, val: f64) with Mut {
        if idx >= 0 && idx < self.len {
            write_f64(self.ptr, idx, val)
        }
    }

    pub fn len(self: &HeapF64Vec) -> i64 {
        self.len
    }

    pub fn cap(self: &HeapF64Vec) -> i64 {
        self.cap
    }

    pub fn clear(self: &!HeapF64Vec) with Mut {
        self.len = 0
    }

    pub fn sum(self: &HeapF64Vec) -> f64 {
        var s: f64 = 0.0
        var i: i64 = 0
        while i < self.len {
            s = s + read_f64(self.ptr, i)
            i = i + 1
        }
        return s
    }

    pub fn free(self: &!HeapF64Vec) with Alloc, Mut {
        if self.cap > 0 {
            heap_free(self.ptr as *mut i8)
        }
        self.ptr = 0 as *mut f64
        self.len = 0
        self.cap = 0
    }
}

// Free-function aliases for backward compat
pub fn heap_f64_vec_new() -> HeapF64Vec {
    HeapF64Vec { ptr: 0 as *mut f64, len: 0, cap: 0 }
}

// Same non-positive-cap normalization as HeapVec::with_capacity above.
