// Heap-allocated growable vectors
// 
// NOTE: The heap_i64_vec_* and heap_f64_vec_* free functions work with
// mutable struct borrows, but callers may encounter borrow checker issues
// when mixing &! and & borrows on the same variable.
//
// For now, the recommended pattern is to use raw pointers directly as shown
// in tests/run-pass/heap_vec_pattern.sio and heap_vec_growth.sio.
//
// Known issues:
// - Method dispatch with `self: &! T` in impl blocks doesn't work (receiver 
//   hash mismatch in compiler)
// - Borrow checker is overly aggressive with struct field borrows

// ============================================
// HeapI64Vec - 64-bit integer heap vector
// ============================================
struct HeapI64Vec {
    ptr: *mut i64,
    len: i64,
    cap: i64,
}

fn heap_i64_vec_new() -> HeapI64Vec {
    HeapI64Vec { ptr: 0 as *mut i64, len: 0, cap: 0 }
}

fn heap_i64_vec_with_capacity(cap: i64) -> HeapI64Vec with Alloc {
    let bytes = cap * 8
    let ptr = heap_alloc(bytes) as *mut i64
    HeapI64Vec { ptr: ptr, len: 0, cap: cap }
}

fn heap_i64_vec_push(v: &! HeapI64Vec, val: i64) with Alloc {
    if v.len >= v.cap {
        let new_cap = if v.cap == 0 { 4 } else { v.cap * 2 }
        let new_bytes = new_cap * 8
        v.ptr = heap_realloc(v.ptr as *mut i8, new_bytes) as *mut i64
        v.cap = new_cap
    }
    write_i64(v.ptr, v.len, val)
    v.len = v.len + 1
}

fn heap_i64_vec_pop(v: &! HeapI64Vec) -> i64 with Mut {
    if v.len > 0 {
        v.len = v.len - 1
        return read_i64(v.ptr, v.len)
    }
    return 0
}

fn heap_i64_vec_get(v: &HeapI64Vec, idx: i64) -> i64 {
    if idx >= 0 && idx < v.len {
        return read_i64(v.ptr, idx)
    }
    return 0
}

fn heap_i64_vec_set(v: &! HeapI64Vec, idx: i64, val: i64) with Mut {
    if idx >= 0 && idx < v.len {
        write_i64(v.ptr, idx, val)
    }
}

fn heap_i64_vec_len(v: &HeapI64Vec) -> i64 {
    v.len
}

fn heap_i64_vec_cap(v: &HeapI64Vec) -> i64 {
    v.cap
}

fn heap_i64_vec_free(v: &! HeapI64Vec) with Alloc {
    heap_free(v.ptr as *mut i8)
    v.ptr = 0 as *mut i64
    v.len = 0
    v.cap = 0
}

// ============================================
// HeapF64Vec - 64-bit float heap vector  
// ============================================
struct HeapF64Vec {
    ptr: *mut f64,
    len: i64,
    cap: i64,
}

fn heap_f64_vec_new() -> HeapF64Vec {
    HeapF64Vec { ptr: 0 as *mut f64, len: 0, cap: 0 }
}

fn heap_f64_vec_with_capacity(cap: i64) -> HeapF64Vec with Alloc {
    let bytes = cap * 8
    let ptr = heap_alloc(bytes) as *mut f64
    HeapF64Vec { ptr: ptr, len: 0, cap: cap }
}

fn heap_f64_vec_push(v: &! HeapF64Vec, val: f64) with Alloc {
    if v.len >= v.cap {
        let new_cap = if v.cap == 0 { 4 } else { v.cap * 2 }
        let new_bytes = new_cap * 8
        v.ptr = heap_realloc(v.ptr as *mut i8, new_bytes) as *mut f64
        v.cap = new_cap
    }
    write_f64(v.ptr, v.len, val)
    v.len = v.len + 1
}

fn heap_f64_vec_pop(v: &! HeapF64Vec) -> f64 with Mut {
    if v.len > 0 {
        v.len = v.len - 1
        return read_f64(v.ptr, v.len)
    }
    return 0.0
}

fn heap_f64_vec_get(v: &HeapF64Vec, idx: i64) -> f64 {
    if idx >= 0 && idx < v.len {
        return read_f64(v.ptr, idx)
    }
    return 0.0
}

fn heap_f64_vec_set(v: &! HeapF64Vec, idx: i64, val: f64) with Mut {
    if idx >= 0 && idx < v.len {
        write_f64(v.ptr, idx, val)
    }
}

fn heap_f64_vec_len(v: &HeapF64Vec) -> i64 {
    v.len
}

fn heap_f64_vec_cap(v: &HeapF64Vec) -> i64 {
    v.cap
}

fn heap_f64_vec_free(v: &! HeapF64Vec) with Alloc {
    heap_free(v.ptr as *mut i8)
    v.ptr = 0 as *mut f64
    v.len = 0
    v.cap = 0
}
