// stdlib/collections/mod.sio — Public exports for the collections module
//
// Per stdlib/CONVENTIONS.md §2, mod.sio declares only the public surface
// (pub use re-exports). Implementations live in the sibling files.

pub use collections::bitset::{
    BitSet,
    main,
}

pub use collections::hashmap::{
    HashMap64,
    hashmap_contains,
    hashmap_count,
    hashmap_get,
    hashmap_insert,
    hashmap_new,
    hashmap_remove,
}

pub use collections::heap_map::{
    HeapIntIntMap,
}

pub use collections::heap_vec::{
    HeapF64Vec,
    HeapI64Vec,
}

pub use collections::stack::{
    Stack64,
    main,
    stack_clear,
    stack_empty,
    stack_new,
    stack_peek,
    stack_pop,
    stack_push,
    stack_size,
}

pub use collections::vec::{
    VecF64,
    main,
    vec_clear,
    vec_get,
    vec_len,
    vec_mean,
    vec_new,
    vec_pop,
    vec_push,
    vec_reverse,
    vec_set,
    vec_sum,
    vec_swap,
}

