// stdlib/iter/lib.sio — Iterator-like operations on fixed arrays
//
// Since Sounio has no closures or traits, iteration is expressed as
// free functions over ArrayView (a fixed [f64; 256] slice with length).
//
// fn_id dispatch for iter_map_id:
//   0 = square (x*x)
//   1 = double (x*2)
//   2 = negate (-x)
//   3 = abs    (|x|)
//   4 = increment (x+1)

pub struct ArrayView {
    pub data: [f64; 256],
    pub len: i32,
}

// ============================================================================
// CONSTRUCTOR
// ============================================================================

pub fn array_view_new(data: &[f64; 256], len: i32) -> ArrayView with Panic, Div, Mut {
    var v: ArrayView = ArrayView { data: [0.0; 256], len: 0 }
    var cap = len
    if cap < 0 { cap = 0 }
    if cap > 256 { cap = 256 }
    var i: i32 = 0
    while i < cap {
        v.data[i] = data[i]
        i = i + 1
    }
    v.len = cap
    v
}

// ============================================================================
// MAP — apply a function (by id) to each element, return new ArrayView
// ============================================================================

fn apply_fn(x: f64, fn_id: i32) -> f64 {
    if fn_id == 0 { return x * x }         // square
    if fn_id == 1 { return x * 2.0 }       // double
    if fn_id == 2 { return 0.0 - x }       // negate
    if fn_id == 3 {                          // abs
        if x < 0.0 { return 0.0 - x }
        return x
    }
    if fn_id == 4 { return x + 1.0 }       // increment
    x
}

pub fn iter_map_id(v: ArrayView, fn_id: i32) -> ArrayView {
    var out: ArrayView = ArrayView { data: [0.0; 256], len: v.len }
    var i: i32 = 0
    while i < v.len {
        out.data[i] = apply_fn(v.data[i], fn_id)
        i = i + 1
    }
    out
}

// ============================================================================
// FILTER
// ============================================================================

pub fn iter_filter_positive(v: ArrayView) -> ArrayView {
    var out: ArrayView = ArrayView { data: [0.0; 256], len: 0 }
    var i: i32 = 0
    while i < v.len {
        if v.data[i] > 0.0 {
            out.data[out.len] = v.data[i]
            out.len = out.len + 1
        }
        i = i + 1
    }
    out
}

pub fn iter_filter_gt(v: ArrayView, threshold: f64) -> ArrayView {
    var out: ArrayView = ArrayView { data: [0.0; 256], len: 0 }
    var i: i32 = 0
    while i < v.len {
        if v.data[i] > threshold {
            out.data[out.len] = v.data[i]
            out.len = out.len + 1
        }
        i = i + 1
    }
    out
}

// ============================================================================
// REDUCE
// ============================================================================

pub fn iter_reduce_sum(v: &ArrayView) -> f64 {
    var acc = 0.0
    var i: i32 = 0
    while i < v.len {
        acc = acc + v.data[i]
        i = i + 1
    }
    acc
}

pub fn iter_reduce_product(v: &ArrayView) -> f64 {
    var acc = 1.0
    var i: i32 = 0
    while i < v.len {
        acc = acc * v.data[i]
        i = i + 1
    }
    acc
}

pub fn iter_reduce_max(v: &ArrayView) -> f64 {
    if v.len == 0 { return 0.0 }
    var m = v.data[0]
    var i: i32 = 1
    while i < v.len {
        if v.data[i] > m { m = v.data[i] }
        i = i + 1
    }
    m
}

pub fn iter_reduce_min(v: &ArrayView) -> f64 {
    if v.len == 0 { return 0.0 }
    var m = v.data[0]
    var i: i32 = 1
    while i < v.len {
        if v.data[i] < m { m = v.data[i] }
        i = i + 1
    }
    m
}

// ============================================================================
// ZIP
// ============================================================================

pub fn iter_zip_add(a: &ArrayView, b: &ArrayView) -> ArrayView {
    var n = a.len
    if b.len < n { n = b.len }
    var out: ArrayView = ArrayView { data: [0.0; 256], len: n }
    var i: i32 = 0
    while i < n {
        out.data[i] = a.data[i] + b.data[i]
        i = i + 1
    }
    out
}

pub fn iter_zip_mul(a: &ArrayView, b: &ArrayView) -> ArrayView {
    var n = a.len
    if b.len < n { n = b.len }
    var out: ArrayView = ArrayView { data: [0.0; 256], len: n }
    var i: i32 = 0
    while i < n {
        out.data[i] = a.data[i] * b.data[i]
        i = i + 1
    }
    out
}

// ============================================================================
// SLICE
// ============================================================================

pub fn iter_take(v: ArrayView, n: i32) -> ArrayView {
    var cap = n
    if cap < 0 { cap = 0 }
    if cap > v.len { cap = v.len }
    var out: ArrayView = ArrayView { data: [0.0; 256], len: cap }
    var i: i32 = 0
    while i < cap {
        out.data[i] = v.data[i]
        i = i + 1
    }
    out
}

pub fn iter_skip(v: ArrayView, n: i32) -> ArrayView {
    var start = n
    if start < 0 { start = 0 }
    if start > v.len { start = v.len }
    let new_len = v.len - start
    var out: ArrayView = ArrayView { data: [0.0; 256], len: new_len }
    var i: i32 = 0
    while i < new_len {
        out.data[i] = v.data[start + i]
        i = i + 1
    }
    out
}

// ============================================================================
// INDEXED REDUCTION
// ============================================================================

// Sigma(i * v[i]) for i = 0..len-1
pub fn iter_enumerate_sum_indexed(v: &ArrayView) -> f64 {
    var acc = 0.0
    var i: i32 = 0
    while i < v.len {
        acc = acc + (i as f64) * v.data[i]
        i = i + 1
    }
    acc
}

// ============================================================================
// PREDICATES
// ============================================================================

pub fn iter_all_positive(v: &ArrayView) -> bool {
    var i: i32 = 0
    while i < v.len {
        if v.data[i] <= 0.0 { return false }
        i = i + 1
    }
    true
}

pub fn iter_any_negative(v: &ArrayView) -> bool {
    var i: i32 = 0
    while i < v.len {
        if v.data[i] < 0.0 { return true }
        i = i + 1
    }
    false
}

pub fn iter_count_gt(v: &ArrayView, threshold: f64) -> i32 {
    var count: i32 = 0
    var i: i32 = 0
    while i < v.len {
        if v.data[i] > threshold { count = count + 1 }
        i = i + 1
    }
    count
}
