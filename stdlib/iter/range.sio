//! stdlib/iter/range.sio — Numeric range iterator

pub struct Range {
    start: i64,
    end: i64,
    step: i64,
    current: i64,
}

pub struct RangeArr64 { data: [i64; 64], len: i64 }

pub fn range_new(start: i64, end_val: i64) -> Range with Mut {
    Range { start: start, end: end_val, step: 1, current: start }
}

pub fn range_step(start: i64, end_val: i64, step: i64) -> Range with Mut {
    Range { start: start, end: end_val, step: step, current: start }
}

pub fn range_has_next(r: &Range) -> bool {
    r.current < r.end
}

pub fn range_next(r: &! Range) -> i64 with Mut {
    let v = r.current
    r.current = r.current + r.step
    v
}

pub fn range_reset(r: &! Range) with Mut {
    r.current = r.start
}

pub fn range_len(r: &Range) -> i64 with Div {
    let span = r.end - r.start
    if span <= 0 { return 0 }
    (span + r.step - 1) / r.step
}

pub fn range_collect(r: &! Range) -> RangeArr64 with Mut {
    var data: [i64; 64] = [0; 64]
    var len: i64 = 0
    range_reset(r)
    while range_has_next(r) && len < 64 {
        data[len as usize] = range_next(r)
        len = len + 1
    }
    RangeArr64 { data: data, len: len }
}
