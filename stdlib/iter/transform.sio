//! stdlib/iter/transform.sio — Functional transforms on RangeArr64

use iter::range::RangeArr64

pub fn arr64_sum(arr: &RangeArr64) -> i64 {
    var s: i64 = 0
    var i: i64 = 0
    while i < arr.len { s = s + arr.data[i as usize]; i = i + 1 }
    s
}

pub fn arr64_min(arr: &RangeArr64) -> i64 {
    if arr.len == 0 { return 0 }
    var m: i64 = arr.data[0]
    var i: i64 = 1
    while i < arr.len { if arr.data[i as usize] < m { m = arr.data[i as usize] } i = i + 1 }
    m
}

pub fn arr64_max(arr: &RangeArr64) -> i64 {
    if arr.len == 0 { return 0 }
    var m: i64 = arr.data[0]
    var i: i64 = 1
    while i < arr.len { if arr.data[i as usize] > m { m = arr.data[i as usize] } i = i + 1 }
    m
}

pub fn arr64_contains(arr: &RangeArr64, value: i64) -> bool {
    var i: i64 = 0
    while i < arr.len { if arr.data[i as usize] == value { return true } i = i + 1 }
    false
}

pub fn arr64_filter_gt(arr: &RangeArr64, threshold: i64) -> RangeArr64 {
    var data: [i64; 64] = [0; 64]
    var len: i64 = 0
    var i: i64 = 0
    while i < arr.len && len < 64 {
        if arr.data[i as usize] > threshold { data[len as usize] = arr.data[i as usize]; len = len + 1 }
        i = i + 1
    }
    RangeArr64 { data: data, len: len }
}

pub fn arr64_filter_lt(arr: &RangeArr64, threshold: i64) -> RangeArr64 {
    var data: [i64; 64] = [0; 64]
    var len: i64 = 0
    var i: i64 = 0
    while i < arr.len && len < 64 {
        if arr.data[i as usize] < threshold { data[len as usize] = arr.data[i as usize]; len = len + 1 }
        i = i + 1
    }
    RangeArr64 { data: data, len: len }
}

pub fn arr64_filter_eq(arr: &RangeArr64, value: i64) -> RangeArr64 {
    var data: [i64; 64] = [0; 64]
    var len: i64 = 0
    var i: i64 = 0
    while i < arr.len && len < 64 {
        if arr.data[i as usize] == value { data[len as usize] = arr.data[i as usize]; len = len + 1 }
        i = i + 1
    }
    RangeArr64 { data: data, len: len }
}
