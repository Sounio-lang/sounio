// stdlib/iter/iterator.sio
// Iterator-like utilities for fixed arrays
//
// Since Sounio uses fixed arrays and has no closures/traits,
// we provide functional iteration as free functions.

// Sum all elements up to n
fn iter_sum(data: [f64; 256], n: i64) -> f64 {
    var sum = 0.0
    var i: i64 = 0
    while i < n {
        sum = sum + data[i]
        i = i + 1
    }
    return sum
}

// Sum i64 elements up to n
fn iter_sum_i64(data: [i64; 256], n: i64) -> i64 {
    var sum: i64 = 0
    var i: i64 = 0
    while i < n {
        sum = sum + data[i]
        i = i + 1
    }
    return sum
}

// Find minimum element, returns index (-1 if n==0)
fn iter_min_index(data: [f64; 256], n: i64) -> i64 {
    if n == 0 { return 0 - 1 }
    var min_idx: i64 = 0
    var min_val = data[0]
    var i: i64 = 1
    while i < n {
        if data[i] < min_val {
            min_val = data[i]
            min_idx = i
        }
        i = i + 1
    }
    return min_idx
}

// Find maximum element, returns index (-1 if n==0)
fn iter_max_index(data: [f64; 256], n: i64) -> i64 {
    if n == 0 { return 0 - 1 }
    var max_idx: i64 = 0
    var max_val = data[0]
    var i: i64 = 1
    while i < n {
        if data[i] > max_val {
            max_val = data[i]
            max_idx = i
        }
        i = i + 1
    }
    return max_idx
}

// Count elements satisfying a threshold (data[i] > threshold)
fn iter_count_gt(data: [f64; 256], n: i64, threshold: f64) -> i64 {
    var count: i64 = 0
    var i: i64 = 0
    while i < n {
        if data[i] > threshold {
            count = count + 1
        }
        i = i + 1
    }
    return count
}

// Check if all elements satisfy data[i] > 0
fn iter_all_positive(data: [f64; 256], n: i64) -> i64 {
    var i: i64 = 0
    while i < n {
        if data[i] <= 0.0 { return 0 }
        i = i + 1
    }
    return 1
}

// Copy n elements from src to dst
fn iter_copy(src: [f64; 256], n: i64, dst: &![f64; 256]) {
    var i: i64 = 0
    while i < n {
        dst[i] = src[i]
        i = i + 1
    }
}

// Reverse n elements in-place
fn iter_reverse(data: &![f64; 256], n: i64) {
    var lo: i64 = 0
    var hi = n - 1
    while lo < hi {
        let tmp = data[lo]
        data[lo] = data[hi]
        data[hi] = tmp
        lo = lo + 1
        hi = hi - 1
    }
}
