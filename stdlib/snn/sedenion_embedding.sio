//! stdlib/snn/sedenion_embedding.sio
//! Sedenion embedding tables, knowledge graph models, and epistemic wrappers.
//!
//! Provides high-level API for sedenion-valued knowledge graph embeddings.
//! Embeddings are stored in flat f64 arrays (16 f64s per sedenion).
//!
//! Design constraint: uses fixed-capacity storage to avoid dynamic slice issues.
//!   - Max 64 entities, 32 relations in a KG model
//!   - EmbeddingTable: fixed-capacity, tracks actual count
//!   - Uses math::sedenion::Sedenion for computation (named fields e0..e15)
//!
//! All embedding storage is in [f64; N] arrays where each sedenion occupies
//! 16 consecutive slots starting at index * 16.

use math::sedenion::*
use snn::sedenion_similarity::*

// ============================================================================
// EPISTEMIC WRAPPER
// ============================================================================

// An epistemic sedenion: a value paired with its measurement uncertainty.
pub struct EpistemicSedenion {
    value: Sedenion,
    uncertainty: f32,
}

// An epistemic float: scalar value with uncertainty.
pub struct EpistemicF32 {
    value: f32,
    uncertainty: f32,
}

// ============================================================================
// EMBEDDING TABLE (fixed capacity: 64 entries)
// ============================================================================

// Capacity constants
fn EMBED_TABLE_CAP() -> i32 { 64 }

// EmbeddingTable stores up to 64 sedenion embeddings as flat f64 storage.
// Each sedenion occupies 16 f64s at offset idx*16.
pub struct EmbeddingTable {
    data: [f64; 1024],   // 64 sedenions × 16 components
    n: i32,
    normalized: bool,
}

// Deterministic pseudo-random f64 in (-0.5, 0.5) from entity and component index.
fn embed_rand(entity: i32, component: i32) -> f64 {
    let h = entity as i64 * 2654435761 + component as i64 * 40503
    let h2 = h ^ (h >> 13)
    let h3 = h2 * 6364136223846793005
    let h4 = h3 ^ (h3 >> 17)
    let raw = (h4 & 0x0fffffff) as f64
    (raw / 268435455.0) - 0.5
}

// Helper: sqrt via Newton iterations
fn embed_sqrt(x: f64) -> f64 {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i: i32 = 0
    while i < 25 { y = (y + x / y) * 0.5; i = i + 1 }
    y
}

// Fill slot idx with a unit-norm sedenion, writing into data array at idx*16.
fn fill_normalized_embedding(data: &![f64; 1024], idx: i32) with Mut {
    let base = idx * 16
    // Compute norm-squared first
    var nsq = 0.0
    var i: i32 = 0
    while i < 16 {
        let v = embed_rand(idx + 1, i)
        data[base + i] = v
        nsq = nsq + v * v
        i = i + 1
    }
    // Normalize
    let norm = embed_sqrt(nsq)
    if norm > 0.0001 {
        i = 0
        while i < 16 { data[base + i] = data[base + i] / norm; i = i + 1 }
    }
}

// Create an embedding table with n entries (max 64).
pub fn create_embedding_table(n: i32, normalize: bool) -> EmbeddingTable with Panic, Mut {
    var data = [0.0; 1024]
    let cap = if n < 64 { n } else { 64 }
    var i: i32 = 0
    while i < cap {
        if normalize {
            fill_normalized_embedding(&!data, i)
        } else {
            let base = i * 16
            var j: i32 = 0
            while j < 16 { data[base + j] = embed_rand(i + 1, j); j = j + 1 }
        }
        i = i + 1
    }
    EmbeddingTable { data: data, n: cap, normalized: normalize }
}

// Return the number of embeddings in the table.
pub fn embedding_table_size(table: EmbeddingTable) -> i32 {
    table.n
}

// Extract sedenion at index from table's flat data.
fn table_get_sedenion(data: &[f64; 1024], idx: i32) -> Sedenion with Panic {
    let b = idx * 16
    Sedenion {
        e0: data[b], e1: data[b + 1], e2: data[b + 2], e3: data[b + 3],
        e4: data[b + 4], e5: data[b + 5], e6: data[b + 6], e7: data[b + 7],
        e8: data[b + 8], e9: data[b + 9], e10: data[b + 10], e11: data[b + 11],
        e12: data[b + 12], e13: data[b + 13], e14: data[b + 14], e15: data[b + 15]
    }
}

// Look up an embedding by index, returning an EpistemicSedenion.
pub fn embedding_lookup(table: EmbeddingTable, idx: i32) -> EpistemicSedenion with Panic {
    EpistemicSedenion {
        value: table_get_sedenion(&table.data, idx),
        uncertainty: 1.0,
    }
}

// ============================================================================
// KG SCORING FUNCTION ENUM
// ============================================================================

pub enum SedScoringFn {
    CayleyProduct,
    DistMult,
    Bilinear,
}

// ============================================================================
// KNOWLEDGE GRAPH MODEL (fixed capacity: 64 entities, 32 relations)
// ============================================================================

pub struct SedKGModel {
    entity_data: [f64; 1024],    // up to 64 entities × 16 components
    relation_data: [f64; 512],   // up to 32 relations × 16 components
    n_entities: i32,
    n_relations: i32,
    scoring_fn: SedScoringFn,
}

// Extract sedenion from flat KG entity/relation data.
fn kg_get_entity(data: &[f64; 1024], idx: i32) -> Sedenion with Panic {
    let b = idx * 16
    Sedenion {
        e0: data[b], e1: data[b + 1], e2: data[b + 2], e3: data[b + 3],
        e4: data[b + 4], e5: data[b + 5], e6: data[b + 6], e7: data[b + 7],
        e8: data[b + 8], e9: data[b + 9], e10: data[b + 10], e11: data[b + 11],
        e12: data[b + 12], e13: data[b + 13], e14: data[b + 14], e15: data[b + 15]
    }
}

fn kg_get_relation(data: &[f64; 512], idx: i32) -> Sedenion with Panic {
    let b = idx * 16
    Sedenion {
        e0: data[b], e1: data[b + 1], e2: data[b + 2], e3: data[b + 3],
        e4: data[b + 4], e5: data[b + 5], e6: data[b + 6], e7: data[b + 7],
        e8: data[b + 8], e9: data[b + 9], e10: data[b + 10], e11: data[b + 11],
        e12: data[b + 12], e13: data[b + 13], e14: data[b + 14], e15: data[b + 15]
    }
}

// Fill entity slot with normalized embedding.
fn fill_kg_entity(data: &![f64; 1024], idx: i32, seed: i32) with Mut {
    let base = idx * 16
    var nsq = 0.0
    var i: i32 = 0
    while i < 16 {
        let v = embed_rand(seed, i + 16)
        data[base + i] = v
        nsq = nsq + v * v
        i = i + 1
    }
    let norm = embed_sqrt(nsq)
    if norm > 0.0001 {
        i = 0
        while i < 16 { data[base + i] = data[base + i] / norm; i = i + 1 }
    }
}

fn fill_kg_relation(data: &![f64; 512], idx: i32, seed: i32) with Mut {
    let base = idx * 16
    var nsq = 0.0
    var i: i32 = 0
    while i < 16 {
        let v = embed_rand(seed, i + 32)
        data[base + i] = v
        nsq = nsq + v * v
        i = i + 1
    }
    let norm = embed_sqrt(nsq)
    if norm > 0.0001 {
        i = 0
        while i < 16 { data[base + i] = data[base + i] / norm; i = i + 1 }
    }
}

// Create a new KG model with random normalized embeddings.
pub fn create_kg_model(
    n_entities: i32,
    n_relations: i32,
    scoring_fn: SedScoringFn
) -> SedKGModel with Panic, Mut {
    var entity_data = [0.0; 1024]
    var relation_data = [0.0; 512]
    let ne = if n_entities < 64 { n_entities } else { 64 }
    let nr = if n_relations < 32 { n_relations } else { 32 }
    var i: i32 = 0
    while i < ne { fill_kg_entity(&!entity_data, i, i + 1000); i = i + 1 }
    i = 0
    while i < nr { fill_kg_relation(&!relation_data, i, i + 2000); i = i + 1 }
    SedKGModel {
        entity_data: entity_data,
        relation_data: relation_data,
        n_entities: ne,
        n_relations: nr,
        scoring_fn: scoring_fn,
    }
}

// Score a (head, relation, tail) triple using the model's scoring function.
pub fn kg_score_triple(model: SedKGModel, h: i32, r: i32, t: i32) -> f32 with Panic {
    let he = kg_get_entity(&model.entity_data, h)
    let re = kg_get_relation(&model.relation_data, r)
    let te = kg_get_entity(&model.entity_data, t)
    match model.scoring_fn {
        SedScoringFn::CayleyProduct => sed_cayley_score(he, re, te),
        SedScoringFn::DistMult => sed_distmult_score(he, re, te),
        SedScoringFn::Bilinear => sed_bilinear_score(he, re, te),
    }
}

// Score with epistemic uncertainty.
pub fn kg_score_triple_epistemic(model: SedKGModel, h: i32, r: i32, t: i32) -> EpistemicF32 with Panic {
    let score = kg_score_triple(model, h, r, t)
    EpistemicF32 { value: score, uncertainty: 0.1 }
}

// ============================================================================
// ZERO DIVISOR DETECTION
// ============================================================================

// Check if sedenion at idx is near a zero divisor.
fn check_zero_divisor(data: &[f64; 1024], idx: i32) -> bool with Panic {
    let s = kg_get_entity(data, idx)
    let test = Sedenion {
        e0: 0.0, e1: 1.0, e2: 0.0, e3: 0.0, e4: 0.0, e5: 0.0,
        e6: 0.0, e7: 0.0, e8: 0.0, e9: 0.0, e10: 1.0, e11: 0.0,
        e12: 0.0, e13: 0.0, e14: 0.0, e15: 0.0
    }
    let prod = sed_mul(s, test)
    let prod_norm = sed_norm(prod)
    let s_norm = sed_norm(s)
    if s_norm < 0.0001 { return false }
    prod_norm < 0.01 * s_norm
}

// Count zero divisors in the model's entity embeddings.
pub fn count_zero_divisors_model(model: SedKGModel) -> i32 with Panic, Mut {
    var count: i32 = 0
    var i: i32 = 0
    while i < model.n_entities {
        if check_zero_divisor(&model.entity_data, i) { count = count + 1 }
        i = i + 1
    }
    count
}

// Zero-divisor loss for entity embeddings.
pub fn entity_zero_divisor_loss(model: SedKGModel) -> f32 with Panic, Mut {
    var total: f32 = 0.0
    let test = Sedenion {
        e0: 0.0, e1: 1.0, e2: 0.0, e3: 0.0, e4: 0.0, e5: 0.0,
        e6: 0.0, e7: 0.0, e8: 0.0, e9: 0.0, e10: 1.0, e11: 0.0,
        e12: 0.0, e13: 0.0, e14: 0.0, e15: 0.0
    }
    var i: i32 = 0
    while i < model.n_entities {
        let s = kg_get_entity(&model.entity_data, i)
        let prod = sed_mul(s, test)
        let ratio = sed_norm(prod) / sed_norm(s)
        if ratio < 0.1 { total = total + (0.1 as f32 - ratio as f32) }
        i = i + 1
    }
    total
}

// Raw sedenion from entity data (for backward pass).
pub fn entity_embedding_raw(model: SedKGModel, idx: i32) -> Sedenion with Panic {
    kg_get_entity(&model.entity_data, idx)
}

// Raw sedenion from relation data (for backward pass).
pub fn relation_embedding_raw(model: SedKGModel, idx: i32) -> Sedenion with Panic {
    kg_get_relation(&model.relation_data, idx)
}

// ============================================================================
// NEAREST NEIGHBOR SEARCH (within EmbeddingTable)
// ============================================================================

// Find the index of the embedding most similar to query.
pub fn table_nearest_neighbor(query: Sedenion, table: EmbeddingTable) -> i32 with Panic, Mut {
    var best_idx: i32 = 0
    var best_sim: f32 = -2.0
    var i: i32 = 0
    while i < table.n {
        let emb = table_get_sedenion(&table.data, i)
        let sim = sed_cosine_similarity(query, emb)
        if sim > best_sim { best_sim = sim; best_idx = i }
        i = i + 1
    }
    best_idx
}
