//! stdlib/snn/sedenion_embedding.sio
//! Sedenion embedding tables, knowledge graph models, and epistemic wrappers.
//!
//! Provides a high-level API for sedenion-valued knowledge graph embeddings:
//!   - EmbeddingTable: normalized sedenion lookup with epistemic uncertainty
//!   - SedKGModel: multi-scoring KG model (Cayley, DistMult, Bilinear)
//!   - Epistemic wrappers: uncertainty propagation through scoring
//!   - Zero-divisor detection and regularization loss
//!
//! Uses math::sedenion::Sedenion (named fields e0..e15, f64 components).

use math::sedenion::*
use snn::sedenion_similarity::*

// ============================================================================
// EPISTEMIC WRAPPER
// ============================================================================

// An epistemic sedenion: a value paired with its measurement uncertainty.
// uncertainty = 0.0 means fully known; 1.0 means maximally uncertain.
pub struct EpistemicSedenion {
    value: Sedenion,
    uncertainty: f32,
}

// An epistemic float: scalar value with uncertainty.
pub struct EpistemicF32 {
    value: f32,
    uncertainty: f32,
}

// ============================================================================
// EMBEDDING TABLE
// ============================================================================

// A table of sedenion embeddings, each with associated epistemic uncertainty.
pub struct EmbeddingTable {
    embeddings: [Sedenion],
    uncertainties: [f32],
    n: i32,
    normalized: bool,
}

// Deterministic pseudo-random float in [-1, 1] from seed and index.
// Uses a simple LCG suitable for embedding initialization.
fn embed_init_val(seed: i64, idx: i64) -> f64 {
    let h = (seed * 6364136223846793005 + 1442695040888963407) + idx * 2654435761
    let h2 = h ^ (h >> 30)
    let h3 = h2 * 6364136223846793005
    let h4 = h3 ^ (h3 >> 27)
    // Map i64 to [-1.0, 1.0]
    let raw = (h4 & 0x7fffffff) as f64
    (raw / 1073741823.0) - 1.0
}

// Helper: integer square root for normalization
fn embed_sqrt_f64(x: f64) -> f64 {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i: i32 = 0
    while i < 30 {
        y = (y + x / y) / 2.0
        i = i + 1
    }
    y
}

// Build a single initialized sedenion from a seed row
fn make_init_sedenion(row: i64) -> Sedenion {
    Sedenion {
        e0: embed_init_val(row, 0),
        e1: embed_init_val(row, 1),
        e2: embed_init_val(row, 2),
        e3: embed_init_val(row, 3),
        e4: embed_init_val(row, 4),
        e5: embed_init_val(row, 5),
        e6: embed_init_val(row, 6),
        e7: embed_init_val(row, 7),
        e8: embed_init_val(row, 8),
        e9: embed_init_val(row, 9),
        e10: embed_init_val(row, 10),
        e11: embed_init_val(row, 11),
        e12: embed_init_val(row, 12),
        e13: embed_init_val(row, 13),
        e14: embed_init_val(row, 14),
        e15: embed_init_val(row, 15)
    }
}

// Create an embedding table with n entries.
// If normalize=true, each embedding is normalized to unit norm on S^15.
// Initial uncertainty is 1.0 (maximally uncertain) for all entries.
pub fn create_embedding_table(n: i32, normalize: bool) -> EmbeddingTable with Panic, Mut {
    var embs: [Sedenion] = []
    var uncs: [f32] = []
    for i in 0..n {
        let raw = make_init_sedenion(i as i64 + 1)
        let emb = if normalize { sed_normalize(raw) } else { raw }
        embs = embs ++ [emb]
        uncs = uncs ++ [1.0]
    }
    EmbeddingTable {
        embeddings: embs,
        uncertainties: uncs,
        n: n,
        normalized: normalize,
    }
}

// Return the number of embeddings in the table.
pub fn embedding_table_size(table: EmbeddingTable) -> i32 {
    table.n
}

// Look up an embedding by index, returning an EpistemicSedenion.
pub fn embedding_lookup(table: EmbeddingTable, idx: i32) -> EpistemicSedenion with Panic {
    EpistemicSedenion {
        value: table.embeddings[idx],
        uncertainty: table.uncertainties[idx],
    }
}

// Look up a raw Sedenion from a flat embedding array by index.
pub fn embedding_lookup_raw(embeddings: [Sedenion], idx: i32) -> Sedenion with Panic {
    embeddings[idx]
}

// ============================================================================
// KG SCORING FUNCTION ENUM
// ============================================================================

pub enum SedScoringFn {
    CayleyProduct,
    DistMult,
    Bilinear,
}

// ============================================================================
// KNOWLEDGE GRAPH MODEL
// ============================================================================

// A knowledge graph embedding model using sedenion embeddings.
pub struct SedKGModel {
    entity_embeddings: [Sedenion],
    relation_embeddings: [Sedenion],
    n_entities: i32,
    n_relations: i32,
    scoring_fn: SedScoringFn,
}

// Create a new KG model with random normalized embeddings.
pub fn create_kg_model(
    n_entities: i32,
    n_relations: i32,
    scoring_fn: SedScoringFn
) -> SedKGModel with Panic, Mut {
    var entity_embs: [Sedenion] = []
    var rel_embs: [Sedenion] = []

    for i in 0..n_entities {
        let raw = make_init_sedenion(i as i64 + 1000)
        entity_embs = entity_embs ++ [sed_normalize(raw)]
    }
    for i in 0..n_relations {
        let raw = make_init_sedenion(i as i64 + 2000)
        rel_embs = rel_embs ++ [sed_normalize(raw)]
    }

    SedKGModel {
        entity_embeddings: entity_embs,
        relation_embeddings: rel_embs,
        n_entities: n_entities,
        n_relations: n_relations,
        scoring_fn: scoring_fn,
    }
}

// Score a (head, relation, tail) triple using the model's scoring function.
pub fn kg_score_triple(model: SedKGModel, h: i32, r: i32, t: i32) -> f32 with Panic {
    let he = model.entity_embeddings[h]
    let re = model.relation_embeddings[r]
    let te = model.entity_embeddings[t]
    match model.scoring_fn {
        SedScoringFn::CayleyProduct => sed_cayley_score(he, re, te),
        SedScoringFn::DistMult => sed_distmult_score(he, re, te),
        SedScoringFn::Bilinear => sed_bilinear_score(he, re, te),
    }
}

// Score a triple with epistemic uncertainty propagation.
// Uncertainty is computed as the normalized variance of component magnitudes.
pub fn kg_score_triple_epistemic(model: SedKGModel, h: i32, r: i32, t: i32) -> EpistemicF32 with Panic {
    let score = kg_score_triple(model, h, r, t)
    // Uncertainty: average uncertainty of the embeddings (simplified: 0.1 for normalized inputs)
    let unc = 0.1
    EpistemicF32 {
        value: score,
        uncertainty: unc,
    }
}

// ============================================================================
// ZERO DIVISOR DETECTION
// ============================================================================

// Sedenion zero divisors: non-zero s, t where s * t = 0.
// A sedenion is near a zero divisor if ||s * s_perp|| < eps for some direction s_perp.
// Practical heuristic: s is a potential zero divisor if its norm deviates from 1
// after multiplication with a test vector — uses the Cawagas characterization.
fn is_near_zero_divisor(s: Sedenion) -> bool with Panic {
    // Quick check: multiply s by a fixed test vector and check if result is near zero.
    // Test vector: e1 + e10 (a known factor pair from Cawagas 2004)
    let test = Sedenion {
        e0: 0.0, e1: 1.0, e2: 0.0, e3: 0.0, e4: 0.0, e5: 0.0,
        e6: 0.0, e7: 0.0, e8: 0.0, e9: 0.0, e10: 1.0, e11: 0.0,
        e12: 0.0, e13: 0.0, e14: 0.0, e15: 0.0
    }
    let prod = sed_mul(s, test)
    let prod_norm = sed_norm(prod) as f32
    let s_norm = sed_norm(s) as f32
    // If ||s * test|| << ||s|| * ||test||, s is near a zero divisor
    if s_norm < 0.0001 { return false }
    prod_norm < 0.01 * s_norm
}

// Count how many embeddings are near zero divisors.
pub fn count_zero_divisors(embeddings: [Sedenion]) -> i32 with Panic, Mut {
    var count: i32 = 0
    let n = len(embeddings) as i32
    for i in 0..n {
        if is_near_zero_divisor(embeddings[i]) {
            count = count + 1
        }
    }
    count
}

// Compute a zero-divisor regularization loss.
// Penalizes embeddings that are near zero divisors by measuring how close
// ||s * test|| is to zero relative to ||s||.
pub fn embedding_zero_divisor_loss(embeddings: [Sedenion]) -> f32 with Panic, Mut {
    let test = Sedenion {
        e0: 0.0, e1: 1.0, e2: 0.0, e3: 0.0, e4: 0.0, e5: 0.0,
        e6: 0.0, e7: 0.0, e8: 0.0, e9: 0.0, e10: 1.0, e11: 0.0,
        e12: 0.0, e13: 0.0, e14: 0.0, e15: 0.0
    }
    var total_loss: f32 = 0.0
    let n = len(embeddings) as i32
    for i in 0..n {
        let s = embeddings[i]
        let prod = sed_mul(s, test)
        let prod_norm = sed_norm(prod) as f32
        let s_norm = sed_norm(s) as f32
        if s_norm > 0.0001 {
            // Loss = how much prod_norm falls below s_norm (zero-divisor penalty)
            let ratio = prod_norm / s_norm
            if ratio < 0.1 {
                total_loss = total_loss + (0.1 - ratio)
            }
        }
    }
    total_loss
}
