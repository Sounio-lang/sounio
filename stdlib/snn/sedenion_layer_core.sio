// Sounio Standard Library: Sedenion Neural Network Layers (Core)
//
// Dense (fully connected) layers operating on sedenion-valued inputs/outputs.
// Designed for 16-dimensional data like hyperspectral imaging and multi-omics.
//
// Key Considerations:
// - NON-ASSOCIATIVITY: Sedenions are NOT associative! (a*b)*c != a*(b*c)
//   Forward pass uses LEFT-TO-RIGHT accumulation for consistency.
// - ZERO DIVISORS: Sedenions have zero divisors (x*y=0 where x,y != 0)
//   We include regularization to avoid the zero divisor subspace.
//
// Parameter Efficiency:
// - SedenionLayer with N weights has N * 16 scalar parameters
// - Equivalent real-valued layer needs 16N * 16N = 256N scalar parameters
// - Kill switch test: sedenion must match real accuracy with 1/16th params
//
// References:
// - Moreno (1998) Zero divisors of the Cayley-Dickson algebras
// - Cawagas (2004) Structure of the sedenion algebra

// IMPORT NOTE: Parser currently rejects stdlib's forward-slash import syntax.
// The import `use math/sedenion` is used by other stdlib files but fails to parse.
// Until parser is fixed to accept forward-slash syntax, this file requires the
// Sedenion type and functions to be available externally.
// See: stdlib/math/sedenion.sio for the Sedenion type definition.

// Note: epistemic/knowledge import removed - not used in core module
// This reduces type checking overhead by avoiding 31,962-line epistemic module

use math::sedenion::*;

// Activation functions for sedenion layers.
// Keep this near imports so module import resolution discovers it in all modes.
pub enum SedenionActivation {
    None,        // Identity
    ReLU,        // Component-wise ReLU
    Sigmoid,     // Component-wise sigmoid
    Tanh,        // Component-wise tanh
    Normalize,   // Normalize to unit sedenion
}

// ============================================================================
// UTILITY FUNCTIONS (must be defined before use)
// ============================================================================

fn core_sqrt_f64(x: f64) -> f64 with Panic, Mut {
    if x <= 0.0 { return 0.0 }
    var guess = x / 2.0
    for i in 0..20 {
        guess = (guess + x / guess) / 2.0
    }
    guess
}

fn exp_f64(x: f64) -> f64 with Panic, Mut {
    if x > 20.0 { return exp_f64(x / 2.0) * exp_f64(x / 2.0) }
    if x < -20.0 { return 1.0 / exp_f64(-x) }
    var sum = 1.0
    var term = 1.0
    for i in 1..20 {
        term = term * x / (i as f64)
        sum = sum + term
    }
    sum
}

fn core_ln_f64(x: f64) -> f64 with Panic, Mut {
    if x <= 0.0 { return -1e30 }
    let y = (x - 1.0) / (x + 1.0)
    var result = 0.0
    var term = y
    for i in 0..30 {
        let n = 2 * i + 1
        result = result + term / (n as f64)
        term = term * y * y
    }
    2.0 * result
}

fn min_i32(a: i32, b: i32) -> i32 {
    if a < b { a } else { b }
}

// Array length builtin. Same declaration idiom as stdlib/quantum/vqe.sio;
// the checker has no implicit `len`, so the module that calls it must declare it.

// ============================================================================
// DENSE SEDENION LAYER
// ============================================================================

// Dense layer for sedenion-valued inputs/outputs
//
// Architecture: N_in sedenions -> N_out sedenions
// Each sedenion = 16 scalar components
// Forward: y[i] = activation(sum_j(W[i,j] * x[j]) + b[i])
//
// CRITICAL: Accumulation is left-to-right due to non-associativity!
pub struct SedenionLayer {
    // Combined params array: first (in*out) are weights, last (out) are biases
    // Layout: params[0..in*out] = weights, params[in*out..in*out+out] = biases
    // This works around a compiler bug with multiple [Sedenion] fields
    params: [Sedenion],

    // Input size (number of input sedenions)
    input_size: i32,

    // Output size (number of output sedenions)
    output_size: i32,

    // Activation function
    activation: SedenionActivation,
}

// ============================================================================
// CONSTRUCTORS
// ============================================================================

// Create a new dense sedenion layer with Xavier initialization
pub fn sedenion_layer_new(
    input_size: i32,
    output_size: i32,
    activation: SedenionActivation
) -> SedenionLayer with Panic, Mut
  // requires input_size > 0
  // requires output_size > 0
{
    let total_weights = input_size * output_size

    // Xavier/Glorot initialization for sedenions
    // Scale by sqrt(2 / (fan_in + fan_out)) / 4 for 16D
    let scale = core_sqrt_f64(2.0 / ((input_size + output_size) as f64)) / 4.0

    // Combined params: weights first, then biases
    var params: [Sedenion] = []

    // Add weights
    for i in 0..total_weights {
        params = params ++ [sedenion_scale(sedenion_one(), scale)]
    }

    // Add biases
    for i in 0..output_size {
        params = params ++ [sedenion_zero()]
    }

    SedenionLayer {
        params: params,
        input_size: input_size,
        output_size: output_size,
        activation: activation,
    }
}

// Create layer with custom initialization scale
pub fn sedenion_layer_from_scale(
    input_size: i32,
    output_size: i32,
    activation: SedenionActivation,
    init_scale: f64
) -> SedenionLayer with Panic, Mut {
    let total_weights = input_size * output_size

    // Combined params: weights first, then biases
    var params: [Sedenion] = []

    // Add weights
    for i in 0..total_weights {
        let real_part = init_scale * (1.0 - 2.0 * ((i % 17) as f64) / 17.0)
        params = params ++ [sedenion_scale(sedenion_one(), real_part)]
    }

    // Add biases
    for i in 0..output_size {
        params = params ++ [sedenion_zero()]
    }

    SedenionLayer {
        params: params,
        input_size: input_size,
        output_size: output_size,
        activation: activation,
    }
}

// ============================================================================
// FORWARD PASS
// ============================================================================

// Forward pass through dense sedenion layer
//
// CRITICAL: Uses LEFT-TO-RIGHT accumulation due to non-associativity!
// The order is: ((bias + w0*x0) + w1*x1) + w2*x2 + ...
//
// Arguments:
//   layer - the dense sedenion layer
//   inputs - vector of input sedenions (length = input_size)
//
// Returns:
//   Vector of output sedenions (length = output_size)
pub fn sedenion_layer_forward(
    layer: SedenionLayer,
    inputs: [Sedenion]
) -> [Sedenion] with Panic, Mut
  // requires len(inputs) == layer.input_size
  // ensures len(result) == layer.output_size
{
    var outputs: [Sedenion] = []
    let num_weights = layer.input_size * layer.output_size

    for out_idx in 0..layer.output_size {
        // Bias is stored after weights: params[num_weights + out_idx]
        let bias_idx = num_weights + out_idx
        var sum = layer.params[bias_idx]

        // Left-to-right accumulation
        // IMPORTANT: This order must match backprop for gradients!
        for in_idx in 0..layer.input_size {
            let weight_idx = out_idx * layer.input_size + in_idx
            let weight = layer.params[weight_idx]
            let input = inputs[in_idx]

            // Sedenion multiplication: weight * input
            let weighted = sedenion_mul(weight, input)

            // Check for zero divisor and handle
            if sedenion_is_zero_divisor(weighted) {
                // Add small perturbation to escape zero divisor
                let perturbed = sedenion_add(weighted, sedenion_scale(sedenion_one(), 0.000001))
                sum = sedenion_add(sum, perturbed)
            } else {
                sum = sedenion_add(sum, weighted)
            }
        }

        // Apply activation function
        let activated = apply_sedenion_activation(layer.activation, sum)
        outputs = outputs ++ [activated]
    }

    outputs
}

// Apply activation function to sedenion
pub fn apply_sedenion_activation(activation: SedenionActivation, input: Sedenion) -> Sedenion with Panic {
    match activation {
        SedenionActivation::None => input,
        SedenionActivation::ReLU => sedenion_relu(input),
        SedenionActivation::Sigmoid => sedenion_sigmoid(input),
        SedenionActivation::Tanh => sedenion_tanh(input),
        SedenionActivation::Normalize => sedenion_normalize(input),
    }
}

// ============================================================================
// PARAMETER ACCESS
// ============================================================================

// Get total parameter count (in scalar values)
pub fn sedenion_layer_param_count(layer: SedenionLayer) -> i64 {
    let weight_params = layer.input_size * layer.output_size * 16
    let bias_params = layer.output_size * 16
    (weight_params + bias_params) as i64
}

// Get weight at specific indices
pub fn sedenion_layer_get_weight(
    layer: SedenionLayer,
    in_idx: i32,
    out_idx: i32
) -> Sedenion with Panic
  // requires in_idx >= 0 && in_idx < layer.input_size
  // requires out_idx >= 0 && out_idx < layer.output_size
{
    let idx = out_idx * layer.input_size + in_idx
    layer.params[idx]
}

// Set weight at specific indices (returns new layer)
pub fn sedenion_layer_set_weight(
    layer: SedenionLayer,
    in_idx: i32,
    out_idx: i32,
    weight: Sedenion
) -> SedenionLayer with Panic, Mut {
    let idx = out_idx * layer.input_size + in_idx
    var new_params = layer.params
    new_params[idx] = weight

    SedenionLayer {
        params: new_params,
        input_size: layer.input_size,
        output_size: layer.output_size,
        activation: layer.activation,
    }
}

// Get bias at specific index
pub fn sedenion_layer_get_bias(layer: SedenionLayer, out_idx: i32) -> Sedenion with Panic
  // requires out_idx >= 0 && out_idx < layer.output_size
{
    let num_weights = layer.input_size * layer.output_size
    layer.params[num_weights + out_idx]
}

// Set bias at specific index (returns new layer)
pub fn sedenion_layer_set_bias(
    layer: SedenionLayer,
    out_idx: i32,
    bias: Sedenion
) -> SedenionLayer with Panic, Mut {
    let num_weights = layer.input_size * layer.output_size
    var new_params = layer.params
    new_params[num_weights + out_idx] = bias

    SedenionLayer {
        params: new_params,
        input_size: layer.input_size,
        output_size: layer.output_size,
        activation: layer.activation,
    }
}

// ============================================================================
// ZERO DIVISOR REGULARIZATION
// ============================================================================

// Compute zero divisor regularization loss
// Penalizes weights that are close to zero divisor subspace
//
// Loss = mean(||w * w^(-1) - 1||^2) over all weights
pub fn zero_divisor_loss(layer: SedenionLayer) -> f64 with Panic, Mut {
    var total_loss = 0.0
    let n_weights = layer.input_size * layer.output_size

    for i in 0..n_weights {
        let w = layer.params[i]

        // Compute putative inverse
        let w_inv = sedenion_putative_inv(w)

        // Product should be identity if not near zero divisor
        let product = sedenion_mul(w, w_inv)

        // Distance from identity
        let diff = sedenion_sub(product, sedenion_one())
        let deviation = sedenion_norm_sq(diff)

        total_loss = total_loss + deviation as f64
    }

    total_loss / (n_weights as f64)
}

// Check what fraction of weights are near zero divisors
pub fn zero_divisor_fraction(layer: SedenionLayer, threshold: f32) -> f64 with Panic, Mut {
    var count = 0
    let n_weights = layer.input_size * layer.output_size

    for i in 0..n_weights {
        if sedenion_is_zero_divisor(layer.params[i]) {
            count = count + 1
        }
    }

    (count as f64) / (n_weights as f64)
}

// ============================================================================
// MULTILAYER PERCEPTRON (MLP)
// ============================================================================

// MLP composed of multiple dense sedenion layers
pub struct SedenionMLP {
    layers: [SedenionLayer],
    layer_count: i32,
}

// Create MLP with specified architecture
// architecture = [input_size, hidden1, hidden2, ..., output_size]
pub fn sedenion_mlp_new(architecture: [i32]) -> SedenionMLP with Panic, Mut
  // requires len(architecture) >= 2
{
    var layers: [SedenionLayer] = []
    let n_layers = architecture.len() - 1

    for i in 0..(n_layers as i32) {
        let in_size = architecture[i]
        let out_size = architecture[i + 1]

        // ReLU for hidden layers, None for output
        let activation = if i < (n_layers as i32) - 1 {
            SedenionActivation::ReLU
        } else {
            SedenionActivation::None
        }

        let layer = sedenion_layer_new(in_size, out_size, activation)
        layers = layers ++ [layer]
    }

    SedenionMLP {
        layers: layers,
        layer_count: n_layers as i32,
    }
}

// Forward pass through MLP
pub fn sedenion_mlp_forward(mlp: SedenionMLP, inputs: [Sedenion]) -> [Sedenion] with Panic, Mut {
    var current = inputs

    for i in 0..mlp.layer_count {
        let layer = mlp.layers[i]
        current = sedenion_layer_forward(layer, current)
    }

    current
}

// Get total parameter count for MLP
pub fn sedenion_mlp_param_count(mlp: SedenionMLP) -> i64 with Panic, Mut {
    var total: i64 = 0
    for i in 0..mlp.layer_count {
        total = total + sedenion_layer_param_count(mlp.layers[i])
    }
    total
}

// ============================================================================
// LOSS FUNCTIONS
// ============================================================================

// Mean Squared Error loss for sedenion outputs
pub fn sedenion_mse_loss(predicted: [Sedenion], target: [Sedenion]) -> f64 with Panic, Mut {
    var total_loss = 0.0
    var count = 0

    let n = min_i32(predicted.len() as i32, target.len() as i32)

    for i in 0..n {
        let diff = sedenion_sub(predicted[i], target[i])
        let sq_norm = sedenion_norm_sq(diff)
        total_loss = total_loss + sq_norm as f64
        count = count + 16  // 16 components per sedenion
    }

    if count > 0 {
        total_loss / (count as f64)
    } else {
        0.0
    }
}

// Cross-entropy loss for classification (using real component)
pub fn sedenion_cross_entropy_loss(
    predicted: [Sedenion],
    target_classes: [i32],
    num_classes: i32
) -> f64 with Panic, Mut {
    var total_loss = 0.0
    let n = min_i32(predicted.len() as i32, target_classes.len() as i32)

    for i in 0..n {
        let pred = predicted[i]
        let target = target_classes[i]

        // Use sedenion components as class logits (up to num_classes)
        var max_logit = -1e30
        for c in 0..min_i32(16, num_classes) {
            let logit = sedenion_get_component(pred, c as i32)
            if (logit as f64) > max_logit {
                max_logit = logit as f64
            }
        }

        // Softmax + cross-entropy
        var sum_exp = 0.0
        for c in 0..min_i32(16, num_classes) {
            let logit = sedenion_get_component(pred, c as i32)
            sum_exp = sum_exp + exp_f64((logit as f64) - max_logit)
        }

        let target_logit = sedenion_get_component(pred, target)
        let log_softmax = ((target_logit as f64) - max_logit) - core_ln_f64(sum_exp)
        total_loss = total_loss - log_softmax
    }

    if n > 0 {
        total_loss / (n as f64)
    } else {
        0.0
    }
}
