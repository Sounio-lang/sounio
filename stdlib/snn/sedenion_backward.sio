//! stdlib/snn/sedenion_backward.sio
//! Backward pass (gradient computation) for sedenion operations.
//!
//! Provides differentiable sedenion operations for training sedenion-valued
//! knowledge graph embeddings and neural networks.
//!
//! Gradient derivations:
//!   - sed_mul_backward: grad via conjugate transpose (Wirtinger calculus analog)
//!   - sed_cayley_score_backward: gradients of Re(conj(h*r)*t) w.r.t. h, r, t
//!   - sed_bilinear_score_backward: gradients of sum_i(h_i*r_i*t_i) w.r.t. h, r, t
//!
//! References:
//!   - Wirtinger calculus for hypercomplex numbers
//!   - Parcollet et al. (2020) "A survey of quaternion neural networks"

use math::sedenion::*

// ============================================================================
// GRADIENT CONTAINERS
// ============================================================================

// Triple gradient result for 3-operand functions (head, relation, tail).
// Used as return type for backward passes to avoid 3-tuple limitations.
pub struct SedGrad3 {
    grad_h: Sedenion,
    grad_r: Sedenion,
    grad_t: Sedenion,
}

// ============================================================================
// ELEMENT-WISE BACKWARD HELPERS
// ============================================================================

// Gradient of sedenion multiplication w.r.t. the left operand a.
// For f(a) = a * b, df/da[grad] = grad * conj(b)
// (This is the Wirtinger-style gradient for non-associative algebras)
pub fn sed_mul_backward_a(grad: Sedenion, a: Sedenion, b: Sedenion) -> Sedenion {
    sed_mul(grad, sed_conj(b))
}

// Gradient of sedenion multiplication w.r.t. the right operand b.
// For f(b) = a * b, df/db[grad] = conj(a) * grad
pub fn sed_mul_backward_b(grad: Sedenion, a: Sedenion, b: Sedenion) -> Sedenion {
    sed_mul(sed_conj(a), grad)
}

// Gradient of sed_add w.r.t. both operands (both equal grad_out)
pub fn sed_add_backward_a(grad: Sedenion) -> Sedenion {
    grad
}

pub fn sed_add_backward_b(grad: Sedenion) -> Sedenion {
    grad
}

// Gradient of sed_scale(a, s) w.r.t. a
pub fn sed_scale_backward_a(grad: Sedenion, s: f64) -> Sedenion {
    sed_scale(grad, s)
}

// ============================================================================
// KNOWLEDGE GRAPH SCORING BACKWARD PASSES
// ============================================================================

// Cayley score: score(h,r,t) = Re(conj(h * r) * t) = dot(h * r, t)
// Gradients:
//   d_score/d_h: t * conj(r) (chain rule through h * r)
//   d_score/d_r: conj(h) * t
//   d_score/d_t: h * r (the transformed head)
//
// All scaled by the incoming gradient scalar.
pub fn sed_cayley_score_backward(
    grad_scalar: f32,
    h: Sedenion,
    r: Sedenion,
    t: Sedenion
) -> SedGrad3 with Panic {
    let g = grad_scalar as f64
    // Forward: transformed = h * r; score = dot(transformed, t)
    let transformed = sed_mul(h, r)

    // Gradient of dot(transformed, t) w.r.t. transformed = t (since dot is bilinear)
    // Gradient of h*r w.r.t. h via chain rule: grad_h = grad_transformed * conj(r)
    let grad_h = sed_scale(sed_mul(t, sed_conj(r)), g)

    // Gradient of h*r w.r.t. r via chain rule: grad_r = conj(h) * grad_transformed
    let grad_r = sed_scale(sed_mul(sed_conj(h), t), g)

    // Gradient of dot(transformed, t) w.r.t. t = transformed
    let grad_t = sed_scale(transformed, g)

    SedGrad3 { grad_h: grad_h, grad_r: grad_r, grad_t: grad_t }
}

// Bilinear score: score(h,r,t) = sum_i(h_i * r_i * t_i)
// Gradients:
//   d_score/d_h_i = r_i * t_i
//   d_score/d_r_i = h_i * t_i
//   d_score/d_t_i = h_i * r_i
pub fn sed_bilinear_score_backward(
    grad_scalar: f32,
    h: Sedenion,
    r: Sedenion,
    t: Sedenion
) -> SedGrad3 {
    let g = grad_scalar as f64
    let grad_h = Sedenion {
        e0: g * r.e0 * t.e0, e1: g * r.e1 * t.e1, e2: g * r.e2 * t.e2, e3: g * r.e3 * t.e3,
        e4: g * r.e4 * t.e4, e5: g * r.e5 * t.e5, e6: g * r.e6 * t.e6, e7: g * r.e7 * t.e7,
        e8: g * r.e8 * t.e8, e9: g * r.e9 * t.e9, e10: g * r.e10 * t.e10, e11: g * r.e11 * t.e11,
        e12: g * r.e12 * t.e12, e13: g * r.e13 * t.e13, e14: g * r.e14 * t.e14, e15: g * r.e15 * t.e15
    }
    let grad_r = Sedenion {
        e0: g * h.e0 * t.e0, e1: g * h.e1 * t.e1, e2: g * h.e2 * t.e2, e3: g * h.e3 * t.e3,
        e4: g * h.e4 * t.e4, e5: g * h.e5 * t.e5, e6: g * h.e6 * t.e6, e7: g * h.e7 * t.e7,
        e8: g * h.e8 * t.e8, e9: g * h.e9 * t.e9, e10: g * h.e10 * t.e10, e11: g * h.e11 * t.e11,
        e12: g * h.e12 * t.e12, e13: g * h.e13 * t.e13, e14: g * h.e14 * t.e14, e15: g * h.e15 * t.e15
    }
    let grad_t = Sedenion {
        e0: g * h.e0 * r.e0, e1: g * h.e1 * r.e1, e2: g * h.e2 * r.e2, e3: g * h.e3 * r.e3,
        e4: g * h.e4 * r.e4, e5: g * h.e5 * r.e5, e6: g * h.e6 * r.e6, e7: g * h.e7 * r.e7,
        e8: g * h.e8 * r.e8, e9: g * h.e9 * r.e9, e10: g * h.e10 * r.e10, e11: g * h.e11 * r.e11,
        e12: g * h.e12 * r.e12, e13: g * h.e13 * r.e13, e14: g * h.e14 * r.e14, e15: g * h.e15 * r.e15
    }
    SedGrad3 { grad_h: grad_h, grad_r: grad_r, grad_t: grad_t }
}
