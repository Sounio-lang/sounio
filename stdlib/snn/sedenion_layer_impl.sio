// Sounio Standard Library: Sedenion Neural Network Layers (Trait Impl)
//
// PAC Learning integration for SedenionMLP
// This module is separate to avoid expensive associated type resolution
// during type checking of the core module.

use snn/sedenion_layer_core
use ml/pac

// ============================================================================
// PAC LEARNING INTEGRATION
// ============================================================================

// Implement Learnable trait for SedenionMLP
//
// VC dimension for neural networks with:
// - W = total number of parameters (scalar)
// - L = number of layers
//
// For sedenions: each sedenion parameter = 16 scalars
// VC dimension ≈ O(W * L) by Bartlett et al. (1998)
impl Learnable for SedenionMLP {
    fn vc_dim() -> VCDim {
        // Simplified: VC dimension is approximately the number of learnable parameters
        // For an MLP with W weight parameters and L layers:
        // VC dimension ≤ W*L (tight upper bound from neural network theory)
        // Compute as: total_sedenion_parameters * layer_count * 16
        // (16 because each sedenion = 16 scalars in the counting)

        // This will be computed from a specific instance in practice,
        // but for the trait definition we return a representative value.
        // In actual use, create an instance and pass its param count.
        1024i64  // Placeholder - will be overridden per instance
    }

    type Model = SedenionMLP
}

// Helper function to compute VC dimension from a specific SedenionMLP instance
fn sedenion_mlp_vc_dim(mlp: SedenionMLP) -> VCDim {
    let total_params = sedenion_mlp_param_count(mlp)
    // Each sedenion parameter is 16 scalars, so param_count already includes this factor
    // VC dimension ≈ 1/16 of total scalar parameters for hypercomplex structure
    // But for conservative bound, use: VC ≤ param_count / 16
    let vc = (total_params / 16) as i64
    if vc < 1i64 { 1i64 } else { vc }
}

// Get total zero divisor loss for MLP
fn sedenion_mlp_zd_loss(mlp: SedenionMLP) -> f64 {
    var total = 0.0
    for i in 0..mlp.layer_count {
        total = total + zero_divisor_loss(mlp.layers[i])
    }
    total / (mlp.layer_count as f64)
}
