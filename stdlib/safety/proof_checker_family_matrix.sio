//! stdlib/safety/proof_checker_family_matrix.sio
//!
//! Records the proof-checker family runtime matrix for the solver/proof-checker
//! upgrade lane. The matrix names the certificate families that need imported
//! native runtime evidence before public promotion: SAT/LRAT, SAT/FRAT,
//! PB/VeriPB, SMT/Farkas, and Lorenz i128/i256 numeric receipts. This is not a
//! checker implementation and does not assert any current imported runtime
//! evidence.

pub fn proof_checker_family_matrix_check(
    solver_proof_profile_fp: i64,
    solver_proof_profile_audit_fp: i64,
    imported_runtime_lift_contract_fp: i64,
    imported_runtime_lift_contract_audit_fp: i64,
    private_envelope_fp: i64,
    private_envelope_audit_fp: i64,
    solver_proof_profile_status: i64,
    imported_runtime_lift_status: i64,
    private_envelope_status: i64,
    planned_family_mask: i64,
    sat_lrat_runtime_mask: i64,
    sat_frat_runtime_mask: i64,
    pb_veripb_runtime_mask: i64,
    smt_farkas_runtime_mask: i64,
    lorenz_i256_runtime_mask: i64,
    current_runtime_family_mask: i64,
    missing_runtime_family_mask: i64,
    imported_runtime_promotion_mask: i64,
    portable_runtime_evidence_mask: i64,
    family_matrix_next_action_mask: i64,
    public_claim_mask: i64,
    global_flowpipe_claim_mask: i64,
    finite_cover_certificate_mask: i64,
    boundary_gluing_proof_mask: i64,
    formal_theorem_ready: i64) -> i64 with Mod {
    var anchor_mask: i64 = 0
    if solver_proof_profile_fp == 964210753 {
        if solver_proof_profile_audit_fp == 526184309 {
            anchor_mask = anchor_mask + 1
        }
    }
    if imported_runtime_lift_contract_fp == 642810357 {
        if imported_runtime_lift_contract_audit_fp == 508176294 {
            anchor_mask = anchor_mask + 2
        }
    }
    if private_envelope_fp == 834620917 {
        if private_envelope_audit_fp == 276591483 {
            anchor_mask = anchor_mask + 4
        }
    }
    if solver_proof_profile_status == 88 { anchor_mask = anchor_mask + 8 }
    if imported_runtime_lift_status == 95 { anchor_mask = anchor_mask + 16 }
    if private_envelope_status == 94 { anchor_mask = anchor_mask + 32 }

    let family_anchor_mask: i64 = 63
    let required_planned_family_mask: i64 = 31
    let required_current_runtime_family_mask: i64 = 0
    let required_missing_runtime_family_mask: i64 = 31
    let required_imported_runtime_promotion_mask: i64 = 0
    let required_portable_runtime_evidence_mask: i64 = 0
    let required_family_matrix_next_action_mask: i64 = 31
    let family_matrix_status: i64 = 96

    var family_ok: i64 = 1
    if planned_family_mask != 31 { family_ok = 0 }
    if sat_lrat_runtime_mask != 0 { family_ok = 0 }
    if sat_frat_runtime_mask != 0 { family_ok = 0 }
    if pb_veripb_runtime_mask != 0 { family_ok = 0 }
    if smt_farkas_runtime_mask != 0 { family_ok = 0 }
    if lorenz_i256_runtime_mask != 0 { family_ok = 0 }
    if current_runtime_family_mask != 0 { family_ok = 0 }
    if missing_runtime_family_mask != 31 { family_ok = 0 }
    if imported_runtime_promotion_mask != 0 { family_ok = 0 }
    if portable_runtime_evidence_mask != 0 { family_ok = 0 }
    if family_matrix_next_action_mask != 31 { family_ok = 0 }
    if family_anchor_mask != 63 { family_ok = 0 }
    if required_planned_family_mask != 31 { family_ok = 0 }
    if required_current_runtime_family_mask != 0 { family_ok = 0 }
    if required_missing_runtime_family_mask != 31 { family_ok = 0 }
    if required_imported_runtime_promotion_mask != 0 { family_ok = 0 }
    if required_portable_runtime_evidence_mask != 0 { family_ok = 0 }
    if required_family_matrix_next_action_mask != 31 { family_ok = 0 }
    if family_matrix_status != 96 { family_ok = 0 }

    var nonclaim_ok: i64 = 1
    if public_claim_mask != 0 { nonclaim_ok = 0 }
    if global_flowpipe_claim_mask != 0 { nonclaim_ok = 0 }
    if finite_cover_certificate_mask != 0 { nonclaim_ok = 0 }
    if boundary_gluing_proof_mask != 0 { nonclaim_ok = 0 }
    if formal_theorem_ready != 0 { nonclaim_ok = 0 }

    var ok_mask: i64 = 0
    if anchor_mask == 63 { ok_mask = ok_mask + 1 }
    if family_ok == 1 { ok_mask = ok_mask + 2 }
    if nonclaim_ok == 1 { ok_mask = ok_mask + 4 }
    if planned_family_mask == 31 { ok_mask = ok_mask + 8 }
    if current_runtime_family_mask == 0 { ok_mask = ok_mask + 16 }
    if missing_runtime_family_mask == 31 { ok_mask = ok_mask + 32 }
    if imported_runtime_promotion_mask == 0 { ok_mask = ok_mask + 64 }
    if portable_runtime_evidence_mask == 0 { ok_mask = ok_mask + 128 }
    if family_matrix_next_action_mask == 31 { ok_mask = ok_mask + 256 }
    if family_matrix_status == 96 { ok_mask = ok_mask + 512 }

    if ok_mask != 1023 { return 0 - 1 }
    return 193746582
}

pub fn proof_checker_family_matrix_audit_fingerprint(
    artifact_fp: i64,
    instance_fp: i64,
    certificate_fp: i64,
    solver_proof_profile_fp: i64,
    solver_proof_profile_audit_fp: i64,
    imported_runtime_lift_contract_fp: i64,
    imported_runtime_lift_contract_audit_fp: i64,
    private_envelope_fp: i64,
    private_envelope_audit_fp: i64,
    solver_proof_profile_status: i64,
    imported_runtime_lift_status: i64,
    private_envelope_status: i64,
    planned_family_mask: i64,
    sat_lrat_runtime_mask: i64,
    sat_frat_runtime_mask: i64,
    pb_veripb_runtime_mask: i64,
    smt_farkas_runtime_mask: i64,
    lorenz_i256_runtime_mask: i64,
    current_runtime_family_mask: i64,
    missing_runtime_family_mask: i64,
    imported_runtime_promotion_mask: i64,
    portable_runtime_evidence_mask: i64,
    family_matrix_next_action_mask: i64,
    family_anchor_mask: i64,
    required_planned_family_mask: i64,
    required_current_runtime_family_mask: i64,
    required_missing_runtime_family_mask: i64,
    required_imported_runtime_promotion_mask: i64,
    required_portable_runtime_evidence_mask: i64,
    required_family_matrix_next_action_mask: i64,
    family_matrix_status: i64,
    public_claim_mask: i64,
    global_flowpipe_claim_mask: i64,
    finite_cover_certificate_mask: i64,
    boundary_gluing_proof_mask: i64,
    formal_theorem_ready: i64,
    ok_mask: i64) -> i64 with Mod {
    if artifact_fp != 193746582 { return 0 - 1 }
    if instance_fp != 471829306 { return 0 - 1 }
    if certificate_fp != 902174635 { return 0 - 1 }
    if solver_proof_profile_fp != 964210753 { return 0 - 1 }
    if solver_proof_profile_audit_fp != 526184309 { return 0 - 1 }
    if imported_runtime_lift_contract_fp != 642810357 { return 0 - 1 }
    if imported_runtime_lift_contract_audit_fp != 508176294 { return 0 - 1 }
    if private_envelope_fp != 834620917 { return 0 - 1 }
    if private_envelope_audit_fp != 276591483 { return 0 - 1 }
    if solver_proof_profile_status != 88 { return 0 - 1 }
    if imported_runtime_lift_status != 95 { return 0 - 1 }
    if private_envelope_status != 94 { return 0 - 1 }
    if planned_family_mask != 31 { return 0 - 1 }
    if sat_lrat_runtime_mask != 0 { return 0 - 1 }
    if sat_frat_runtime_mask != 0 { return 0 - 1 }
    if pb_veripb_runtime_mask != 0 { return 0 - 1 }
    if smt_farkas_runtime_mask != 0 { return 0 - 1 }
    if lorenz_i256_runtime_mask != 0 { return 0 - 1 }
    if current_runtime_family_mask != 0 { return 0 - 1 }
    if missing_runtime_family_mask != 31 { return 0 - 1 }
    if imported_runtime_promotion_mask != 0 { return 0 - 1 }
    if portable_runtime_evidence_mask != 0 { return 0 - 1 }
    if family_matrix_next_action_mask != 31 { return 0 - 1 }
    if family_anchor_mask != 63 { return 0 - 1 }
    if required_planned_family_mask != 31 { return 0 - 1 }
    if required_current_runtime_family_mask != 0 { return 0 - 1 }
    if required_missing_runtime_family_mask != 31 { return 0 - 1 }
    if required_imported_runtime_promotion_mask != 0 { return 0 - 1 }
    if required_portable_runtime_evidence_mask != 0 { return 0 - 1 }
    if required_family_matrix_next_action_mask != 31 { return 0 - 1 }
    if family_matrix_status != 96 { return 0 - 1 }
    if public_claim_mask != 0 { return 0 - 1 }
    if global_flowpipe_claim_mask != 0 { return 0 - 1 }
    if finite_cover_certificate_mask != 0 { return 0 - 1 }
    if boundary_gluing_proof_mask != 0 { return 0 - 1 }
    if formal_theorem_ready != 0 { return 0 - 1 }
    if ok_mask != 1023 { return 0 - 1 }
    return 682540913
}
