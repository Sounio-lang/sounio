//! stdlib/safety/runtime_abi_gate_blocker_query_envelope.sio
//!
//! Local query envelope (status 93) for the runtime ABI gate blocker. It lets a
//! router ask "is the imported/native runtime ABI blocker active / is
//! imported-runtime evidence gated?" and get the blocker receipt. A valid query
//! returns the blocker artifact (584291376); mismatches return -1. This records
//! the BLOCKER STATE (known_madaros_runtime_blocker_mask=7, runtime ABI level
//! 2 = unsatisfied) as router-queryable metadata. It does NOT fix the blocker
//! (BLK-20260623-madaros-mm-seed-segfault, owned by the madaros lane) and is NOT
//! runtime evidence.

use safety::runtime_abi_gate_blocker::*

pub fn runtime_abi_gate_blocker_query_mask(
    blocker_artifact_fp: i64,
    known_madaros_runtime_blocker_mask: i64,
    runtime_evidence_private_level: i64,
    imported_runtime_missing_mask: i64,
    imported_runtime_promotion_mask: i64,
    public_claim_mask: i64,
    formal_theorem_ready: i64,
    global_flowpipe_claim_mask: i64,
    boundary_gluing_proof_mask: i64,
    finite_cover_certificate_mask: i64) -> i64 {
    var mask = 0
    if blocker_artifact_fp == 584291376 { mask = mask + 1 }
    if known_madaros_runtime_blocker_mask == 7 { mask = mask + 2 }
    if runtime_evidence_private_level == 2 { mask = mask + 4 }
    if imported_runtime_missing_mask == 7 { mask = mask + 8 }
    if imported_runtime_promotion_mask == 0 { mask = mask + 16 }
    if public_claim_mask == 0 {
        if formal_theorem_ready == 0 {
            if global_flowpipe_claim_mask == 0 {
                if boundary_gluing_proof_mask == 0 {
                    if finite_cover_certificate_mask == 0 { mask = mask + 32 }
                }
            }
        }
    }
    return mask
}

pub fn runtime_abi_gate_blocker_query(
    blocker_artifact_fp: i64,
    known_madaros_runtime_blocker_mask: i64,
    runtime_evidence_private_level: i64,
    imported_runtime_missing_mask: i64,
    query_mask: i64,
    imported_runtime_promotion_mask: i64,
    public_claim_mask: i64,
    formal_theorem_ready: i64,
    global_flowpipe_claim_mask: i64,
    boundary_gluing_proof_mask: i64,
    finite_cover_certificate_mask: i64,
    limb_base: i64) -> i64 {
    if blocker_artifact_fp != 584291376 { return 0 - 1 }
    if known_madaros_runtime_blocker_mask != 7 { return 0 - 1 }
    if runtime_evidence_private_level != 2 { return 0 - 1 }
    if imported_runtime_missing_mask != 7 { return 0 - 1 }
    if query_mask != 63 { return 0 - 1 }
    if imported_runtime_promotion_mask != 0 { return 0 - 1 }
    if public_claim_mask != 0 { return 0 - 1 }
    if formal_theorem_ready != 0 { return 0 - 1 }
    if global_flowpipe_claim_mask != 0 { return 0 - 1 }
    if boundary_gluing_proof_mask != 0 { return 0 - 1 }
    if finite_cover_certificate_mask != 0 { return 0 - 1 }
    if limb_base != 1000000000 { return 0 - 1 }
    return 584291376
}

pub fn runtime_abi_gate_blocker_query_envelope_fingerprint(
    blocker_artifact_fp: i64,
    query_mask: i64,
    known_madaros_runtime_blocker_mask: i64,
    runtime_evidence_private_level: i64,
    bridge_status: i64,
    limb_base: i64) -> i64 with Div {
    if blocker_artifact_fp != 584291376 { return 0 - 1 }
    if query_mask != 63 { return 0 - 1 }
    if known_madaros_runtime_blocker_mask != 7 { return 0 - 1 }
    if runtime_evidence_private_level != 2 { return 0 - 1 }
    if bridge_status != 124 { return 0 - 1 }
    if limb_base != 1000000000 { return 0 - 1 }
    return (blocker_artifact_fp + (29 * query_mask) + (31 * known_madaros_runtime_blocker_mask) + (37 * runtime_evidence_private_level) + (41 * bridge_status)) % limb_base
}

pub fn runtime_abi_gate_blocker_query_receipt_check(
    blocker_anchor_ok: i64,
    query_mask_ok: i64,
    query_ok: i64,
    envelope_fp_ok: i64,
    claim_masks_zero_ok: i64,
    limb_base: i64,
    known_madaros_runtime_blocker_mask: i64,
    runtime_evidence_private_level: i64,
    imported_runtime_promotion_mask: i64,
    bridge_status: i64) -> i64 {
    if blocker_anchor_ok != 1 { return 0 - 1 }
    if query_mask_ok != 1 { return 0 - 1 }
    if query_ok != 1 { return 0 - 1 }
    if envelope_fp_ok != 1 { return 0 - 1 }
    if claim_masks_zero_ok != 1 { return 0 - 1 }
    if limb_base != 1000000000 { return 0 - 1 }
    if known_madaros_runtime_blocker_mask != 7 { return 0 - 1 }
    if runtime_evidence_private_level != 2 { return 0 - 1 }
    if imported_runtime_promotion_mask != 0 { return 0 - 1 }
    if bridge_status != 124 { return 0 - 1 }
    return 426913058
}
