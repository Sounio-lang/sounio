//! stdlib/safety/imported_runtime_lift_contract.sio
//!
//! Records the current imported-runtime lift contract for solver and proof
//! checker receipts. This contract does not lift the runtime ABI blocker; it
//! names the exact future evidence required before a private envelope can be
//! promoted to imported/native runtime evidence. Numeric values are opaque
//! traceability tokens and local gate masks only.

pub fn imported_runtime_lift_contract_check(
    private_envelope_fp: i64,
    private_envelope_audit_fp: i64,
    runtime_abi_blocker_fp: i64,
    runtime_abi_blocker_audit_fp: i64,
    kernel_replay_router_fp: i64,
    kernel_replay_router_audit_fp: i64,
    private_envelope_status: i64,
    runtime_abi_blocker_status: i64,
    kernel_replay_router_status: i64,
    multimodule_witness_pass_mask: i64,
    wide_call_runtime_pass_mask: i64,
    imported_solver_runtime_pass_mask: i64,
    imported_kernel_replay_pass_mask: i64,
    known_blocker_mask: i64,
    future_lift_requirement_mask: i64,
    current_missing_lift_mask: i64,
    ready_to_lift_mask: i64,
    imported_runtime_promotion_mask: i64,
    portable_runtime_evidence_mask: i64,
    lift_contract_next_action_mask: i64,
    public_claim_mask: i64,
    global_flowpipe_claim_mask: i64,
    finite_cover_certificate_mask: i64,
    boundary_gluing_proof_mask: i64,
    formal_theorem_ready: i64) -> i64 with Mod {
    var anchor_mask: i64 = 0
    if private_envelope_fp == 834620917 {
        if private_envelope_audit_fp == 276591483 {
            anchor_mask = anchor_mask + 1
        }
    }
    if runtime_abi_blocker_fp == 584291376 {
        if runtime_abi_blocker_audit_fp == 936740152 {
            anchor_mask = anchor_mask + 2
        }
    }
    if kernel_replay_router_fp == 709284613 {
        if kernel_replay_router_audit_fp == 418905276 {
            anchor_mask = anchor_mask + 4
        }
    }
    if private_envelope_status == 94 { anchor_mask = anchor_mask + 8 }
    if runtime_abi_blocker_status == 92 { anchor_mask = anchor_mask + 16 }
    if kernel_replay_router_status == 93 { anchor_mask = anchor_mask + 32 }

    let lift_anchor_mask: i64 = 63
    let required_future_lift_requirement_mask: i64 = 31
    let required_current_missing_lift_mask: i64 = 31
    let required_ready_to_lift_mask: i64 = 0
    let required_imported_runtime_promotion_mask: i64 = 0
    let required_portable_runtime_evidence_mask: i64 = 0
    let required_lift_contract_next_action_mask: i64 = 31
    let imported_lift_status: i64 = 95

    var lift_ok: i64 = 1
    if multimodule_witness_pass_mask != 0 { lift_ok = 0 }
    if wide_call_runtime_pass_mask != 0 { lift_ok = 0 }
    if imported_solver_runtime_pass_mask != 0 { lift_ok = 0 }
    if imported_kernel_replay_pass_mask != 0 { lift_ok = 0 }
    if known_blocker_mask != 7 { lift_ok = 0 }
    if future_lift_requirement_mask != 31 { lift_ok = 0 }
    if current_missing_lift_mask != 31 { lift_ok = 0 }
    if ready_to_lift_mask != 0 { lift_ok = 0 }
    if imported_runtime_promotion_mask != 0 { lift_ok = 0 }
    if portable_runtime_evidence_mask != 0 { lift_ok = 0 }
    if lift_contract_next_action_mask != 31 { lift_ok = 0 }
    if lift_anchor_mask != 63 { lift_ok = 0 }
    if required_future_lift_requirement_mask != 31 { lift_ok = 0 }
    if required_current_missing_lift_mask != 31 { lift_ok = 0 }
    if required_ready_to_lift_mask != 0 { lift_ok = 0 }
    if required_imported_runtime_promotion_mask != 0 { lift_ok = 0 }
    if required_portable_runtime_evidence_mask != 0 { lift_ok = 0 }
    if required_lift_contract_next_action_mask != 31 { lift_ok = 0 }
    if imported_lift_status != 95 { lift_ok = 0 }

    var nonclaim_ok: i64 = 1
    if public_claim_mask != 0 { nonclaim_ok = 0 }
    if global_flowpipe_claim_mask != 0 { nonclaim_ok = 0 }
    if finite_cover_certificate_mask != 0 { nonclaim_ok = 0 }
    if boundary_gluing_proof_mask != 0 { nonclaim_ok = 0 }
    if formal_theorem_ready != 0 { nonclaim_ok = 0 }

    var ok_mask: i64 = 0
    if anchor_mask == 63 { ok_mask = ok_mask + 1 }
    if lift_ok == 1 { ok_mask = ok_mask + 2 }
    if nonclaim_ok == 1 { ok_mask = ok_mask + 4 }
    if future_lift_requirement_mask == 31 { ok_mask = ok_mask + 8 }
    if current_missing_lift_mask == 31 { ok_mask = ok_mask + 16 }
    if known_blocker_mask == 7 { ok_mask = ok_mask + 32 }
    if ready_to_lift_mask == 0 { ok_mask = ok_mask + 64 }
    if imported_runtime_promotion_mask == 0 { ok_mask = ok_mask + 128 }
    if portable_runtime_evidence_mask == 0 { ok_mask = ok_mask + 256 }
    if lift_contract_next_action_mask == 31 { ok_mask = ok_mask + 512 }

    if ok_mask != 1023 { return 0 - 1 }
    return 642810357
}

pub fn imported_runtime_lift_contract_audit_fingerprint(
    artifact_fp: i64,
    instance_fp: i64,
    certificate_fp: i64,
    private_envelope_fp: i64,
    private_envelope_audit_fp: i64,
    runtime_abi_blocker_fp: i64,
    runtime_abi_blocker_audit_fp: i64,
    kernel_replay_router_fp: i64,
    kernel_replay_router_audit_fp: i64,
    private_envelope_status: i64,
    runtime_abi_blocker_status: i64,
    kernel_replay_router_status: i64,
    multimodule_witness_pass_mask: i64,
    wide_call_runtime_pass_mask: i64,
    imported_solver_runtime_pass_mask: i64,
    imported_kernel_replay_pass_mask: i64,
    known_blocker_mask: i64,
    future_lift_requirement_mask: i64,
    current_missing_lift_mask: i64,
    ready_to_lift_mask: i64,
    imported_runtime_promotion_mask: i64,
    portable_runtime_evidence_mask: i64,
    lift_contract_next_action_mask: i64,
    lift_anchor_mask: i64,
    required_future_lift_requirement_mask: i64,
    required_current_missing_lift_mask: i64,
    required_ready_to_lift_mask: i64,
    required_imported_runtime_promotion_mask: i64,
    required_portable_runtime_evidence_mask: i64,
    required_lift_contract_next_action_mask: i64,
    imported_lift_status: i64,
    public_claim_mask: i64,
    global_flowpipe_claim_mask: i64,
    finite_cover_certificate_mask: i64,
    boundary_gluing_proof_mask: i64,
    formal_theorem_ready: i64,
    ok_mask: i64) -> i64 with Mod {
    if artifact_fp != 642810357 { return 0 - 1 }
    if instance_fp != 276304915 { return 0 - 1 }
    if certificate_fp != 819273604 { return 0 - 1 }
    if private_envelope_fp != 834620917 { return 0 - 1 }
    if private_envelope_audit_fp != 276591483 { return 0 - 1 }
    if runtime_abi_blocker_fp != 584291376 { return 0 - 1 }
    if runtime_abi_blocker_audit_fp != 936740152 { return 0 - 1 }
    if kernel_replay_router_fp != 709284613 { return 0 - 1 }
    if kernel_replay_router_audit_fp != 418905276 { return 0 - 1 }
    if private_envelope_status != 94 { return 0 - 1 }
    if runtime_abi_blocker_status != 92 { return 0 - 1 }
    if kernel_replay_router_status != 93 { return 0 - 1 }
    if multimodule_witness_pass_mask != 0 { return 0 - 1 }
    if wide_call_runtime_pass_mask != 0 { return 0 - 1 }
    if imported_solver_runtime_pass_mask != 0 { return 0 - 1 }
    if imported_kernel_replay_pass_mask != 0 { return 0 - 1 }
    if known_blocker_mask != 7 { return 0 - 1 }
    if future_lift_requirement_mask != 31 { return 0 - 1 }
    if current_missing_lift_mask != 31 { return 0 - 1 }
    if ready_to_lift_mask != 0 { return 0 - 1 }
    if imported_runtime_promotion_mask != 0 { return 0 - 1 }
    if portable_runtime_evidence_mask != 0 { return 0 - 1 }
    if lift_contract_next_action_mask != 31 { return 0 - 1 }
    if lift_anchor_mask != 63 { return 0 - 1 }
    if required_future_lift_requirement_mask != 31 { return 0 - 1 }
    if required_current_missing_lift_mask != 31 { return 0 - 1 }
    if required_ready_to_lift_mask != 0 { return 0 - 1 }
    if required_imported_runtime_promotion_mask != 0 { return 0 - 1 }
    if required_portable_runtime_evidence_mask != 0 { return 0 - 1 }
    if required_lift_contract_next_action_mask != 31 { return 0 - 1 }
    if imported_lift_status != 95 { return 0 - 1 }
    if public_claim_mask != 0 { return 0 - 1 }
    if global_flowpipe_claim_mask != 0 { return 0 - 1 }
    if finite_cover_certificate_mask != 0 { return 0 - 1 }
    if boundary_gluing_proof_mask != 0 { return 0 - 1 }
    if formal_theorem_ready != 0 { return 0 - 1 }
    if ok_mask != 1023 { return 0 - 1 }
    return 508176294
}
