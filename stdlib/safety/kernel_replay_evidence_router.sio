//! stdlib/safety/kernel_replay_evidence_router.sio
//!
//! Routes local kernel-replay evidence separately from imported native runtime
//! evidence. This lets proof-checker and Lorenz receipt work record private
//! self-contained replay while the runtime ABI blocker remains active. Numeric
//! inputs are opaque traceability tokens only, not proof receipts produced or
//! reasserted here.

pub fn kernel_replay_evidence_router_check(
    runtime_abi_blocker_fp: i64,
    runtime_abi_blocker_audit_fp: i64,
    solver_proof_profile_fp: i64,
    solver_proof_profile_audit_fp: i64,
    lorenz_replay_verifier_preflight_fp: i64,
    lorenz_replay_verifier_preflight_audit_fp: i64,
    runtime_abi_blocker_status: i64,
    profile_status: i64,
    verifier_preflight_status: i64,
    local_kernel_replay_mask: i64,
    local_checker_trace_mask: i64,
    local_scope_gate_mask: i64,
    imported_kernel_replay_mask: i64,
    portable_runtime_evidence_mask: i64,
    imported_runtime_promotion_mask: i64,
    abi_blocker_active_mask: i64,
    private_acceptance_mask: i64,
    public_claim_mask: i64,
    global_flowpipe_claim_mask: i64,
    finite_cover_certificate_mask: i64,
    boundary_gluing_proof_mask: i64) -> i64 with Mod {
    var anchor_mask: i64 = 0
    if runtime_abi_blocker_fp == 584291376 {
        if runtime_abi_blocker_audit_fp == 936740152 {
            anchor_mask = anchor_mask + 1
        }
    }
    if solver_proof_profile_fp == 964210753 {
        if solver_proof_profile_audit_fp == 526184309 {
            anchor_mask = anchor_mask + 2
        }
    }
    if lorenz_replay_verifier_preflight_fp == 391742608 {
        if lorenz_replay_verifier_preflight_audit_fp == 650219347 {
            anchor_mask = anchor_mask + 4
        }
    }
    if runtime_abi_blocker_status == 92 { anchor_mask = anchor_mask + 8 }
    if profile_status == 88 { anchor_mask = anchor_mask + 16 }
    if verifier_preflight_status == 91 { anchor_mask = anchor_mask + 32 }

    let router_anchor_mask: i64 = 63
    let local_replay_available_mask: i64 = 7
    let imported_replay_missing_mask: i64 = 7
    let abi_blocker_required_mask: i64 = 1
    let private_only_acceptance_level: i64 = 2
    let public_promotion_blocked_mask: i64 = 0
    let global_promotion_blocked_mask: i64 = 0
    let finite_cover_promotion_blocked_mask: i64 = 0
    let boundary_gluing_promotion_blocked_mask: i64 = 0
    let router_next_action_mask: i64 = 31

    var route_ok: i64 = 1
    if local_kernel_replay_mask != 1 { route_ok = 0 }
    if local_checker_trace_mask != 1 { route_ok = 0 }
    if local_scope_gate_mask != 1 { route_ok = 0 }
    if imported_kernel_replay_mask != 0 { route_ok = 0 }
    if portable_runtime_evidence_mask != 0 { route_ok = 0 }
    if imported_runtime_promotion_mask != 0 { route_ok = 0 }
    if abi_blocker_active_mask != 1 { route_ok = 0 }
    if private_acceptance_mask != 1 { route_ok = 0 }
    if router_anchor_mask != 63 { route_ok = 0 }
    if local_replay_available_mask != 7 { route_ok = 0 }
    if imported_replay_missing_mask != 7 { route_ok = 0 }
    if abi_blocker_required_mask != 1 { route_ok = 0 }
    if private_only_acceptance_level != 2 { route_ok = 0 }
    if public_promotion_blocked_mask != 0 { route_ok = 0 }
    if global_promotion_blocked_mask != 0 { route_ok = 0 }
    if finite_cover_promotion_blocked_mask != 0 { route_ok = 0 }
    if boundary_gluing_promotion_blocked_mask != 0 { route_ok = 0 }
    if router_next_action_mask != 31 { route_ok = 0 }

    var nonclaim_ok: i64 = 1
    if public_claim_mask != 0 { nonclaim_ok = 0 }
    if global_flowpipe_claim_mask != 0 { nonclaim_ok = 0 }
    if finite_cover_certificate_mask != 0 { nonclaim_ok = 0 }
    if boundary_gluing_proof_mask != 0 { nonclaim_ok = 0 }

    var ok_mask: i64 = 0
    if anchor_mask == 63 { ok_mask = ok_mask + 1 }
    if route_ok == 1 { ok_mask = ok_mask + 2 }
    if nonclaim_ok == 1 { ok_mask = ok_mask + 4 }
    if local_replay_available_mask == 7 { ok_mask = ok_mask + 8 }
    if imported_replay_missing_mask == 7 { ok_mask = ok_mask + 16 }
    if abi_blocker_active_mask == 1 { ok_mask = ok_mask + 32 }
    if private_acceptance_mask == 1 { ok_mask = ok_mask + 64 }
    if imported_runtime_promotion_mask == 0 { ok_mask = ok_mask + 128 }

    if ok_mask != 255 { return 0 - 1 }
    return 709284613
}

pub fn kernel_replay_evidence_router_audit_fingerprint(
    artifact_fp: i64,
    instance_fp: i64,
    certificate_fp: i64,
    runtime_abi_blocker_fp: i64,
    runtime_abi_blocker_audit_fp: i64,
    solver_proof_profile_fp: i64,
    solver_proof_profile_audit_fp: i64,
    lorenz_replay_verifier_preflight_fp: i64,
    lorenz_replay_verifier_preflight_audit_fp: i64,
    runtime_abi_blocker_status: i64,
    profile_status: i64,
    verifier_preflight_status: i64,
    local_kernel_replay_mask: i64,
    local_checker_trace_mask: i64,
    local_scope_gate_mask: i64,
    imported_kernel_replay_mask: i64,
    portable_runtime_evidence_mask: i64,
    imported_runtime_promotion_mask: i64,
    abi_blocker_active_mask: i64,
    private_acceptance_mask: i64,
    router_anchor_mask: i64,
    local_replay_available_mask: i64,
    imported_replay_missing_mask: i64,
    abi_blocker_required_mask: i64,
    private_only_acceptance_level: i64,
    public_promotion_blocked_mask: i64,
    global_promotion_blocked_mask: i64,
    finite_cover_promotion_blocked_mask: i64,
    boundary_gluing_promotion_blocked_mask: i64,
    router_next_action_mask: i64,
    public_claim_mask: i64,
    global_flowpipe_claim_mask: i64,
    finite_cover_certificate_mask: i64,
    boundary_gluing_proof_mask: i64,
    ok_mask: i64) -> i64 with Mod {
    if artifact_fp != 709284613 { return 0 - 1 }
    if instance_fp != 627341890 { return 0 - 1 }
    if certificate_fp != 149286735 { return 0 - 1 }
    if runtime_abi_blocker_fp != 584291376 { return 0 - 1 }
    if runtime_abi_blocker_audit_fp != 936740152 { return 0 - 1 }
    if solver_proof_profile_fp != 964210753 { return 0 - 1 }
    if solver_proof_profile_audit_fp != 526184309 { return 0 - 1 }
    if lorenz_replay_verifier_preflight_fp != 391742608 { return 0 - 1 }
    if lorenz_replay_verifier_preflight_audit_fp != 650219347 { return 0 - 1 }
    if runtime_abi_blocker_status != 92 { return 0 - 1 }
    if profile_status != 88 { return 0 - 1 }
    if verifier_preflight_status != 91 { return 0 - 1 }
    if local_kernel_replay_mask != 1 { return 0 - 1 }
    if local_checker_trace_mask != 1 { return 0 - 1 }
    if local_scope_gate_mask != 1 { return 0 - 1 }
    if imported_kernel_replay_mask != 0 { return 0 - 1 }
    if portable_runtime_evidence_mask != 0 { return 0 - 1 }
    if imported_runtime_promotion_mask != 0 { return 0 - 1 }
    if abi_blocker_active_mask != 1 { return 0 - 1 }
    if private_acceptance_mask != 1 { return 0 - 1 }
    if router_anchor_mask != 63 { return 0 - 1 }
    if local_replay_available_mask != 7 { return 0 - 1 }
    if imported_replay_missing_mask != 7 { return 0 - 1 }
    if abi_blocker_required_mask != 1 { return 0 - 1 }
    if private_only_acceptance_level != 2 { return 0 - 1 }
    if public_promotion_blocked_mask != 0 { return 0 - 1 }
    if global_promotion_blocked_mask != 0 { return 0 - 1 }
    if finite_cover_promotion_blocked_mask != 0 { return 0 - 1 }
    if boundary_gluing_promotion_blocked_mask != 0 { return 0 - 1 }
    if router_next_action_mask != 31 { return 0 - 1 }
    if public_claim_mask != 0 { return 0 - 1 }
    if global_flowpipe_claim_mask != 0 { return 0 - 1 }
    if finite_cover_certificate_mask != 0 { return 0 - 1 }
    if boundary_gluing_proof_mask != 0 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }
    return 418905276
}
