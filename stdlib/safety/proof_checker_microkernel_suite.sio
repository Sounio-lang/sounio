//! stdlib/safety/proof_checker_microkernel_suite.sio
//!
//! Local suite manifest for the first executable proof-checker microkernels:
//! SAT/RUP chain, PB high-width row kernel, and SMT/Farkas scalar kernel. This
//! is integration bookkeeping, not a solver result and not imported/native
//! runtime evidence.

pub fn proof_checker_microkernel_suite_check(
    sat_rup_chain_fp: i64,
    sat_rup_chain_audit_fp: i64,
    pb_highwidth_fp: i64,
    pb_highwidth_audit_fp: i64,
    smt_farkas_fp: i64,
    smt_farkas_audit_fp: i64,
    sat_rup_chain_status: i64,
    pb_highwidth_status: i64,
    smt_farkas_status: i64,
    self_contained_runtime_mask: i64,
    imported_runtime_evidence_mask: i64,
    covered_family_mask: i64,
    covered_proof_format_mask: i64,
    suite_next_action_mask: i64,
    public_claim_mask: i64,
    formal_theorem_ready: i64) -> i64 {
    var anchor_mask: i64 = 0
    if sat_rup_chain_fp == 428619705 {
        if sat_rup_chain_audit_fp == 917264038 { anchor_mask = anchor_mask + 1 }
    }
    if pb_highwidth_fp == 671902843 {
        if pb_highwidth_audit_fp == 238570416 { anchor_mask = anchor_mask + 2 }
    }
    if smt_farkas_fp == 583104927 {
        if smt_farkas_audit_fp == 719460238 { anchor_mask = anchor_mask + 4 }
    }
    if sat_rup_chain_status == 98 { anchor_mask = anchor_mask + 8 }
    if pb_highwidth_status == 99 { anchor_mask = anchor_mask + 16 }
    if smt_farkas_status == 100 { anchor_mask = anchor_mask + 32 }

    let required_anchor_mask: i64 = 63
    let required_self_contained_runtime_mask: i64 = 7
    let required_imported_runtime_evidence_mask: i64 = 0
    let required_covered_family_mask: i64 = 7
    let required_covered_proof_format_mask: i64 = 7
    let required_suite_next_action_mask: i64 = 15
    let suite_status: i64 = 101

    var suite_ok: i64 = 1
    if anchor_mask != 63 { suite_ok = 0 }
    if self_contained_runtime_mask != 7 { suite_ok = 0 }
    if imported_runtime_evidence_mask != 0 { suite_ok = 0 }
    if covered_family_mask != 7 { suite_ok = 0 }
    if covered_proof_format_mask != 7 { suite_ok = 0 }
    if suite_next_action_mask != 15 { suite_ok = 0 }
    if required_anchor_mask != 63 { suite_ok = 0 }
    if required_self_contained_runtime_mask != 7 { suite_ok = 0 }
    if required_imported_runtime_evidence_mask != 0 { suite_ok = 0 }
    if required_covered_family_mask != 7 { suite_ok = 0 }
    if required_covered_proof_format_mask != 7 { suite_ok = 0 }
    if required_suite_next_action_mask != 15 { suite_ok = 0 }
    if suite_status != 101 { suite_ok = 0 }

    var nonclaim_ok: i64 = 1
    if public_claim_mask != 0 { nonclaim_ok = 0 }
    if formal_theorem_ready != 0 { nonclaim_ok = 0 }

    if suite_ok != 1 { return 0 - 1 }
    if nonclaim_ok != 1 { return 0 - 1 }
    return 857420631
}

pub fn proof_checker_microkernel_suite_audit_fingerprint(
    artifact_fp: i64,
    instance_fp: i64,
    certificate_fp: i64,
    sat_rup_chain_fp: i64,
    sat_rup_chain_audit_fp: i64,
    pb_highwidth_fp: i64,
    pb_highwidth_audit_fp: i64,
    smt_farkas_fp: i64,
    smt_farkas_audit_fp: i64,
    sat_rup_chain_status: i64,
    pb_highwidth_status: i64,
    smt_farkas_status: i64,
    anchor_mask: i64,
    self_contained_runtime_mask: i64,
    imported_runtime_evidence_mask: i64,
    covered_family_mask: i64,
    covered_proof_format_mask: i64,
    suite_next_action_mask: i64,
    public_claim_mask: i64,
    formal_theorem_ready: i64,
    suite_status: i64,
    ok_mask: i64) -> i64 {
    if artifact_fp != 857420631 { return 0 - 1 }
    if instance_fp != 738291604 { return 0 - 1 }
    if certificate_fp != 159640872 { return 0 - 1 }
    if sat_rup_chain_fp != 428619705 { return 0 - 1 }
    if sat_rup_chain_audit_fp != 917264038 { return 0 - 1 }
    if pb_highwidth_fp != 671902843 { return 0 - 1 }
    if pb_highwidth_audit_fp != 238570416 { return 0 - 1 }
    if smt_farkas_fp != 583104927 { return 0 - 1 }
    if smt_farkas_audit_fp != 719460238 { return 0 - 1 }
    if sat_rup_chain_status != 98 { return 0 - 1 }
    if pb_highwidth_status != 99 { return 0 - 1 }
    if smt_farkas_status != 100 { return 0 - 1 }
    if anchor_mask != 63 { return 0 - 1 }
    if self_contained_runtime_mask != 7 { return 0 - 1 }
    if imported_runtime_evidence_mask != 0 { return 0 - 1 }
    if covered_family_mask != 7 { return 0 - 1 }
    if covered_proof_format_mask != 7 { return 0 - 1 }
    if suite_next_action_mask != 15 { return 0 - 1 }
    if public_claim_mask != 0 { return 0 - 1 }
    if formal_theorem_ready != 0 { return 0 - 1 }
    if suite_status != 101 { return 0 - 1 }
    if ok_mask != 1023 { return 0 - 1 }
    return 460917285
}
