// stdlib/functional/mod.sio — Public exports for the functional module
//
// Per stdlib/CONVENTIONS.md §2, mod.sio declares only the public surface
// (pub use re-exports). Implementations live in the sibling files
// (calculus.sio, ops.sio).

pub use functional::calculus::{
    fc_abs, fc_sqrt,
    deriv, deriv_h, deriv2, deriv4,
    newton, bisect, secant,
    integrate_n, integrate, trapezoid,
    minimize, maximize, fixed_point,
}

pub use functional::ops::{
    map4_i64, map6_i64, map4_f64, map6_f64, map8_f64,
    fold4_i64, fold6_i64, fold4_f64, fold6_f64, fold8_f64,
    for_each4_i64, for_each6_i64, for_each6_f64,
    FilterResult6_i64, filter6_i64,
    FilterResult6_f64, filter6_f64,
    any6_i64, any6_f64, all6_i64, all6_f64,
    zip_map6_f64, zip_map4_f64,
    reduce6_f64, reduce6_i64,
    apply_n_f64, apply_n_i64,
    sort6_f64, sort6_i64,
}
