// stdlib/functional/ops.sio — Higher-order array operations
//
// Sprint 228: First-class functions enable map, filter, fold, for_each, any, all.
// Monomorphized for common types and sizes. Each function takes a fn(...) -> ...
// argument that can be either a named function reference or a closure literal.
//
// Usage:
//   use functional::ops::{map6_f64, fold6_f64, filter6_f64, for_each6_f64}
//
//   let doubled = map6_f64(data, |x: f64| -> f64 { x * 2.0 })
//   let sum = fold6_f64(data, 0.0, |acc: f64, x: f64| -> f64 { acc + x })
//   let positives = filter6_f64(data, |x: f64| -> i64 { if x > 0.0 { 1 } else { 0 } })

module functional::ops

// ============================================================================
// map — transform each element
// ============================================================================

pub fn map4_i64(arr: [i64; 4], f: fn(i64) -> i64) -> [i64; 4] with Mut, Panic, Div {
    var out: [i64; 4] = [0; 4]
    var i: i64 = 0
    while i < 4 {
        out[i] = f(arr[i])
        i = i + 1
    }
    out
}

pub fn map6_i64(arr: [i64; 6], f: fn(i64) -> i64) -> [i64; 6] with Mut, Panic, Div {
    var out: [i64; 6] = [0; 6]
    var i: i64 = 0
    while i < 6 {
        out[i] = f(arr[i])
        i = i + 1
    }
    out
}

pub fn map4_f64(arr: [f64; 4], f: fn(f64) -> f64) -> [f64; 4] with Mut, Panic, Div {
    var out: [f64; 4] = [0.0; 4]
    var i: i64 = 0
    while i < 4 {
        out[i] = f(arr[i])
        i = i + 1
    }
    out
}

pub fn map6_f64(arr: [f64; 6], f: fn(f64) -> f64) -> [f64; 6] with Mut, Panic, Div {
    var out: [f64; 6] = [0.0; 6]
    var i: i64 = 0
    while i < 6 {
        out[i] = f(arr[i])
        i = i + 1
    }
    out
}

pub fn map8_f64(arr: [f64; 8], f: fn(f64) -> f64) -> [f64; 8] with Mut, Panic, Div {
    var out: [f64; 8] = [0.0; 8]
    var i: i64 = 0
    while i < 8 {
        out[i] = f(arr[i])
        i = i + 1
    }
    out
}

// ============================================================================
// fold — accumulate a result across all elements
// ============================================================================

pub fn fold4_i64(arr: [i64; 4], init: i64, f: fn(i64, i64) -> i64) -> i64 with Mut, Panic, Div {
    var acc = init
    var i: i64 = 0
    while i < 4 {
        acc = f(acc, arr[i])
        i = i + 1
    }
    acc
}

pub fn fold6_i64(arr: [i64; 6], init: i64, f: fn(i64, i64) -> i64) -> i64 with Mut, Panic, Div {
    var acc = init
    var i: i64 = 0
    while i < 6 {
        acc = f(acc, arr[i])
        i = i + 1
    }
    acc
}

pub fn fold4_f64(arr: [f64; 4], init: f64, f: fn(f64, f64) -> f64) -> f64 with Mut, Panic, Div {
    var acc = init
    var i: i64 = 0
    while i < 4 {
        acc = f(acc, arr[i])
        i = i + 1
    }
    acc
}

pub fn fold6_f64(arr: [f64; 6], init: f64, f: fn(f64, f64) -> f64) -> f64 with Mut, Panic, Div {
    var acc = init
    var i: i64 = 0
    while i < 6 {
        acc = f(acc, arr[i])
        i = i + 1
    }
    acc
}

pub fn fold8_f64(arr: [f64; 8], init: f64, f: fn(f64, f64) -> f64) -> f64 with Mut, Panic, Div {
    var acc = init
    var i: i64 = 0
    while i < 8 {
        acc = f(acc, arr[i])
        i = i + 1
    }
    acc
}

// ============================================================================
// for_each — apply a side-effecting function to each element
// ============================================================================

pub fn for_each4_i64(arr: [i64; 4], f: fn(i64) -> i64) with Mut, Panic, Div {
    var i: i64 = 0
    while i < 4 {
        let _discard = f(arr[i])
        i = i + 1
    }
}

pub fn for_each6_i64(arr: [i64; 6], f: fn(i64) -> i64) with Mut, Panic, Div {
    var i: i64 = 0
    while i < 6 {
        let _discard = f(arr[i])
        i = i + 1
    }
}

pub fn for_each6_f64(arr: [f64; 6], f: fn(f64) -> f64) with Mut, Panic, Div {
    var i: i64 = 0
    while i < 6 {
        let _discard = f(arr[i])
        i = i + 1
    }
}

// ============================================================================
// filter — returns array + count of elements satisfying predicate
// ============================================================================

// Filter result: filtered array + count of elements kept.
// Predicate returns i64: nonzero = keep, zero = discard.
pub struct FilterResult6_i64 {
    data: [i64; 6],
    count: i64,
}

pub fn filter6_i64(arr: [i64; 6], pred: fn(i64) -> i64) -> FilterResult6_i64 with Mut, Panic, Div {
    var result = FilterResult6_i64 { data: [0; 6], count: 0 }
    var i: i64 = 0
    while i < 6 {
        if pred(arr[i]) != 0 {
            result.data[result.count] = arr[i]
            result.count = result.count + 1
        }
        i = i + 1
    }
    result
}

pub struct FilterResult6_f64 {
    data: [f64; 6],
    count: i64,
}

pub fn filter6_f64(arr: [f64; 6], pred: fn(f64) -> i64) -> FilterResult6_f64 with Mut, Panic, Div {
    var result = FilterResult6_f64 { data: [0.0; 6], count: 0 }
    var i: i64 = 0
    while i < 6 {
        if pred(arr[i]) != 0 {
            result.data[result.count] = arr[i]
            result.count = result.count + 1
        }
        i = i + 1
    }
    result
}

// ============================================================================
// any / all — short-circuit boolean predicates
// ============================================================================

// Returns 1 if any element satisfies predicate, 0 otherwise.
pub fn any6_i64(arr: [i64; 6], pred: fn(i64) -> i64) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < 6 {
        if pred(arr[i]) != 0 {
            return 1
        }
        i = i + 1
    }
    0
}

pub fn any6_f64(arr: [f64; 6], pred: fn(f64) -> i64) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < 6 {
        if pred(arr[i]) != 0 {
            return 1
        }
        i = i + 1
    }
    0
}

// Returns 1 if all elements satisfy predicate, 0 otherwise.
pub fn all6_i64(arr: [i64; 6], pred: fn(i64) -> i64) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < 6 {
        if pred(arr[i]) == 0 {
            return 0
        }
        i = i + 1
    }
    1
}

pub fn all6_f64(arr: [f64; 6], pred: fn(f64) -> i64) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < 6 {
        if pred(arr[i]) == 0 {
            return 0
        }
        i = i + 1
    }
    1
}

// ============================================================================
// zip_map — combine two arrays element-wise
// ============================================================================

pub fn zip_map6_f64(a: [f64; 6], b: [f64; 6], f: fn(f64, f64) -> f64) -> [f64; 6] with Mut, Panic, Div {
    var out: [f64; 6] = [0.0; 6]
    var i: i64 = 0
    while i < 6 {
        out[i] = f(a[i], b[i])
        i = i + 1
    }
    out
}

pub fn zip_map4_f64(a: [f64; 4], b: [f64; 4], f: fn(f64, f64) -> f64) -> [f64; 4] with Mut, Panic, Div {
    var out: [f64; 4] = [0.0; 4]
    var i: i64 = 0
    while i < 4 {
        out[i] = f(a[i], b[i])
        i = i + 1
    }
    out
}

// ============================================================================
// reduce — fold without initial value (uses first element)
// ============================================================================

pub fn reduce6_f64(arr: [f64; 6], f: fn(f64, f64) -> f64) -> f64 with Mut, Panic, Div {
    var acc = arr[0]
    var i: i64 = 1
    while i < 6 {
        acc = f(acc, arr[i])
        i = i + 1
    }
    acc
}

pub fn reduce6_i64(arr: [i64; 6], f: fn(i64, i64) -> i64) -> i64 with Mut, Panic, Div {
    var acc = arr[0]
    var i: i64 = 1
    while i < 6 {
        acc = f(acc, arr[i])
        i = i + 1
    }
    acc
}

// ============================================================================
// Function composition and application
// ============================================================================

// Apply a function N times: f(f(f(...f(x)...)))
pub fn apply_n_f64(x: f64, n: i64, f: fn(f64) -> f64) -> f64 with Mut, Panic, Div {
    var result = x
    var i: i64 = 0
    while i < n {
        result = f(result)
        i = i + 1
    }
    result
}

pub fn apply_n_i64(x: i64, n: i64, f: fn(i64) -> i64) -> i64 with Mut, Panic, Div {
    var result = x
    var i: i64 = 0
    while i < n {
        result = f(result)
        i = i + 1
    }
    result
}

// ============================================================================
// sort_by — in-place sort with comparison function
// ============================================================================

// Comparison function returns: negative = a < b, 0 = equal, positive = a > b
// Bubble sort (simple, works for small fixed arrays)
pub fn sort6_f64(arr: [f64; 6], cmp: fn(f64, f64) -> i64) -> [f64; 6] with Mut, Panic, Div {
    var out = arr
    var swapped: i64 = 1
    while swapped != 0 {
        swapped = 0
        var i: i64 = 0
        while i < 5 {
            if cmp(out[i], out[i + 1]) > 0 {
                let tmp = out[i]
                out[i] = out[i + 1]
                out[i + 1] = tmp
                swapped = 1
            }
            i = i + 1
        }
    }
    out
}

pub fn sort6_i64(arr: [i64; 6], cmp: fn(i64, i64) -> i64) -> [i64; 6] with Mut, Panic, Div {
    var out = arr
    var swapped: i64 = 1
    while swapped != 0 {
        swapped = 0
        var i: i64 = 0
        while i < 5 {
            if cmp(out[i], out[i + 1]) > 0 {
                let tmp = out[i]
                out[i] = out[i + 1]
                out[i + 1] = tmp
                swapped = 1
            }
            i = i + 1
        }
    }
    out
}
