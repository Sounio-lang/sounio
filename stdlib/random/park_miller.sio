// stdlib/random/park_miller.sio
//
// Park-Miller minimal-standard multiplicative congruential RNG.
//
//   x_{n+1} = (a · x_n) mod m       with a = 16807, m = 2^31 − 1 = 2147483647
//
// Reference: Park & Miller 1988, "Random Number Generators: Good Ones Are
// Hard to Find" (CACM 31:10). Period ≈ 2.147e9.
//
// QUALITY DISCLAIMER
//   - Passes all 1980-era diehard tests.
//   - FAILS TestU01 SmallCrush::LinearComp (linear-complexity test).
//   - Adequate for biological PBPK Monte Carlo with N ≪ 10^8 samples per
//     cohort: synthesis of 200 patients × 18 time points × 5 replicates =
//     18 000 samples is well within Park-Miller's reliable regime.
//   - NOT suitable for cryptography, high-dimensional stratified sampling,
//     or anything where TestU01-level uniformity matters.
//
// Why this module exists alongside stdlib/random/distributions.sio:
//   The 4-field DstPcg64 struct in distributions.sio currently exhibits a
//   state-aliasing bug under the pinned souc binary (Sounio-Pure dispatch
//   R.2.1 Phase D, 2026-05-16). Park-Miller uses a single f64 state and
//   bypasses that aliasing entirely. Once the codegen issue is resolved,
//   distributions.sio PCG64 becomes the preferred path; this module
//   remains for low-quality-acceptable use cases.
//
// API:
//   pm_new(seed: i64) -> ParkMiller
//   pm_uniform(rng: &!ParkMiller) -> f64           // U[0, 1)
//   pm_normal(rng: &!ParkMiller, mean, std) -> f64 // N(mean, std)
//   pm_lognormal(rng: &!ParkMiller, mean, cv) -> f64
//
// All samplers mutate the rng in place via &!. Deterministic given seed.
//
// Numerical note on storing state in f64:
//   a × m = 16807 × 2147483647 ≈ 3.6 × 10^13 < 2^53 ≈ 9.0 × 10^15.
//   Exact integer arithmetic in f64 holds for all intermediate products,
//   so the recurrence is bit-identical to a pure-integer Park-Miller.

extern "C" {
    fn sqrt(x: f64) -> f64
    fn log(x: f64) -> f64
    fn exp(x: f64) -> f64
}

pub struct ParkMiller { state: f64 }

pub fn pm_new(seed: i64) -> ParkMiller with Mut, Div, Panic {
    // Seed must be in [1, m-1]. Map any i64 to that range deterministically;
    // for any positive seed < m it is the identity, preserving the simple
    // form used in B.1 reference implementations.
    let m: i64 = 2147483647
    var s = seed
    if s < 0 { s = 0 - s }
    if s >= m { s = (s % (m - 1)) + 1 }
    if s == 0 { s = 1 }
    ParkMiller { state: s as f64 }
}

// One Park-Miller step. Returns U[0, 1).
pub fn pm_uniform(rng: &!ParkMiller) -> f64 with Mut, Div, Panic {
    let m = 2147483647.0
    let a = 16807.0
    let next = rng.state * a
    let q = next / m
    let q_floor = (q as i64) as f64
    let r = next - q_floor * m
    rng.state = r
    r / m
}

// Marsaglia polar method for one standard-normal draw.
// Uses two uniforms; rejects if u1²+u2² ≥ 1 (≤ 21.5% per attempt under
// uniform input on the unit square ↔ disc test). Max 20 attempts; on the
// astronomically unlikely event of 20 consecutive rejections returns 0.
pub fn pm_standard_normal(rng: &!ParkMiller) -> f64 with Mut, Div, Panic {
    var attempts: i64 = 0
    while attempts < 20 {
        let u1 = pm_uniform(rng) * 2.0 - 1.0
        let u2 = pm_uniform(rng) * 2.0 - 1.0
        let s = u1 * u1 + u2 * u2
        if s > 0.0 {
            if s < 1.0 {
                let factor = sqrt(0.0 - 2.0 * log(s) / s)
                return u1 * factor
            }
        }
        attempts = attempts + 1
    }
    0.0
}

pub fn pm_normal(rng: &!ParkMiller, mean: f64, std: f64) -> f64
    with Mut, Div, Panic
{
    let z = pm_standard_normal(rng)
    mean + std * z
}

// LogNormal parameterized by mean and CV (coefficient of variation = σ/μ).
// σ_log = sqrt(ln(1 + CV²))
// x = mean · exp(σ_log · z − σ_log²/2)
pub fn pm_lognormal(rng: &!ParkMiller, mean: f64, cv: f64) -> f64
    with Mut, Div, Panic
{
    if mean <= 0.0 { return 0.0 }
    if cv <= 0.0 { return mean }
    let sigma_log = sqrt(log(1.0 + cv * cv))
    let z = pm_standard_normal(rng)
    mean * exp(sigma_log * z - 0.5 * sigma_log * sigma_log)
}

// Self-test entry point. Exits 0 if all sanity checks pass.
pub fn main() -> i32 with IO, Mut, Div, Panic {
    var rng = pm_new(31415)
    let u1 = pm_uniform(&!rng)
    let u2 = pm_uniform(&!rng)
    let u3 = pm_uniform(&!rng)
    println(u1)   // expect 0.245865 (verified in B.1 V3 runner)
    println(u2)   // expect 0.259615
    println(u3)   // expect 0.341197

    // Determinism check: re-seed and confirm first draw matches.
    var rng2 = pm_new(31415)
    let v1 = pm_uniform(&!rng2)
    println(v1 - u1)  // expect 0.0

    // Standard normal sample
    let z = pm_standard_normal(&!rng)
    println(z)        // some value in roughly [-3, 3]

    // LogNormal at (4.5, CV=0.30)
    let cl = pm_lognormal(&!rng, 4.5, 0.30)
    println(cl)       // ~ 4.5 with 30% CV

    0
}
