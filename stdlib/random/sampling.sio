// random::sampling — Random Sampling Utilities
//
// Functions for sampling from collections, shuffling, and PK/PD variability.
//
// Features:
// - sample: Random selection from arrays
// - sample_weighted: Weighted random selection
// - shuffle: Random permutation
// - resample: Bootstrap resampling
// - pk_variability: PK parameter variability (IIV, IOV)
//
// References:
// - Knuth (1997): "The Art of Computer Programming, Vol. 2"
// - Lavielle (2014): "Mixed Effects Models for the Population Approach"

// ============================================================================
// RNG (inline from rng.d for self-contained module)
// ============================================================================

struct SmpPcg64 {
    state_hi: i64,
    state_lo: i64,
    inc_hi: i64,
    inc_lo: i64,
}

struct SmpU128 {
    hi: i64,
    lo: i64,
}

// ─── Unsigned 128-bit helpers (canonical per R.2.4 / pcg-cpp) ─────────────

fn smp_pcg_u_lt(a: i64, b: i64) -> bool {
    let top: i64 = 1
    let mask = top << 63
    (a ^ mask) < (b ^ mask)
}

fn smp_pcg_lshr(x: i64, n: i64) -> i64 {
    if n <= 0 { return x }
    if n >= 64 { return 0 }
    let raw = x >> n
    let one: i64 = 1
    let mask = (one << (64 - n)) - 1
    return raw & mask
}

fn smp_pcg_umul64_high(a: i64, b: i64) -> i64 {
    let mask32: i64 = 4294967295
    let al = a & mask32
    let ah = smp_pcg_lshr(a, 32)
    let bl = b & mask32
    let bh = smp_pcg_lshr(b, 32)
    let ll = al * bl
    let lh = al * bh
    let hl = ah * bl
    let hh = ah * bh
    let t = smp_pcg_lshr(ll, 32) + (lh & mask32) + (hl & mask32)
    return smp_pcg_lshr(t, 32) + smp_pcg_lshr(lh, 32) + smp_pcg_lshr(hl, 32) + hh
}

fn smp_pcg_u128_add(a_hi: i64, a_lo: i64, b_hi: i64, b_lo: i64) -> SmpU128 {
    let res_lo = a_lo + b_lo
    let carry: i64 = if smp_pcg_u_lt(res_lo, a_lo) { 1 } else { 0 }
    let res_hi = a_hi + b_hi + carry
    return SmpU128 { hi: res_hi, lo: res_lo }
}

fn smp_pcg_u128_mul(a_hi: i64, a_lo: i64, b_hi: i64, b_lo: i64) -> SmpU128 {
    let res_lo = a_lo * b_lo
    let res_hi = smp_pcg_umul64_high(a_lo, b_lo) + a_hi * b_lo + a_lo * b_hi
    return SmpU128 { hi: res_hi, lo: res_lo }
}

fn smp_pcg_rotr64(x: i64, rot: i64) -> i64 {
    let r = rot & 63
    if r == 0 { return x }
    let right = smp_pcg_lshr(x, r)
    let left = x << (64 - r)
    return right | left
}

// ─── PCG64-XSL-RR-128/64 step + canonical seeding (matches pcg-cpp) ───────

fn smp_pcg64_new(seed: i64) -> SmpPcg64 {
    let inc_hi: i64 = 6364136223846793005
    let inc_lo: i64 = 1442695040888963407
    let s0 = SmpPcg64 { state_hi: 0, state_lo: 0, inc_hi: inc_hi, inc_lo: inc_lo }
    let r1 = smp_pcg64_next_i64(s0)
    let mid = r1.0
    let add = smp_pcg_u128_add(mid.state_hi, mid.state_lo, 0, seed)
    let s2 = SmpPcg64 { state_hi: add.hi, state_lo: add.lo, inc_hi: inc_hi, inc_lo: inc_lo }
    let r2 = smp_pcg64_next_i64(s2)
    return r2.0
}

fn smp_pcg64_next_i64(rng: SmpPcg64) -> (SmpPcg64, i64) {
    let mult_hi: i64 = 2549297995355413924
    let mult_lo: i64 = 4865540595714422341
    let mul = smp_pcg_u128_mul(rng.state_hi, rng.state_lo, mult_hi, mult_lo)
    let add = smp_pcg_u128_add(mul.hi, mul.lo, rng.inc_hi, rng.inc_lo)
    let new_hi = add.hi
    let new_lo = add.lo
    let xorshifted = new_hi ^ new_lo
    let rot = smp_pcg_lshr(new_hi, 58) & 63
    let output = smp_pcg_rotr64(xorshifted, rot)
    return (SmpPcg64 {
        state_hi: new_hi,
        state_lo: new_lo,
        inc_hi: rng.inc_hi,
        inc_lo: rng.inc_lo,
    }, output)
}

fn smp_pcg64_next_f64(rng: SmpPcg64) -> (SmpPcg64, f64) {
    let result = smp_pcg64_next_i64(rng)
    let mantissa = smp_pcg_lshr(result.1, 11)
    let fraction = (mantissa as f64) / 9007199254740992.0
    return (result.0, fraction)
}

// Generate integer in [0, n) with unbiased rejection-modulo.
// threshold = (2^64 mod n) = ((-n as u64) mod n); reject if u64(x) < threshold.
fn smp_pcg64_bounded(rng: SmpPcg64, n: i64) -> (SmpPcg64, i64) {
    if n <= 0 { return (rng, 0) }
    // threshold = (0 - n) mod n in u64 semantics.
    // For n > 0 (i64), (0 - n) wraps to large u64; we need its remainder mod n.
    // Since n < 2^63 here, the standard u64 trick:
    let neg_n = 0 - n
    var threshold: i64 = 0
    // Compute u64(neg_n) % u64(n) via repeated subtraction-style loop guarded
    // by unsigned compare. Bounded iterations: at most one full pass since
    // we only need the residue, and divisor n is large compared to typical
    // workloads. Use simple algorithm: keep subtracting n while unsigned ≥ n.
    var t: i64 = neg_n
    // Fast path: if n is a power of two, threshold is 0.
    let one: i64 = 1
    let n_minus_1 = n - 1
    if (n & n_minus_1) == 0 {
        threshold = 0
    } else {
        // u64 division by n via repeated halving + subtract; bounded by 64 steps.
        // Compute t mod n where t is unsigned. Use binary long division.
        var rem: i64 = 0
        var i: i64 = 63
        while i >= 0 {
            // rem = rem * 2 + bit i of t
            let bit = smp_pcg_lshr(t, i) & 1
            rem = rem + rem + bit
            // After shift+add, rem fits in u64; check rem >= n unsigned.
            if !smp_pcg_u_lt(rem, n) {
                rem = rem - n
            }
            i = i - 1
        }
        threshold = rem
    }

    var current = rng
    var attempts: i64 = 0
    while attempts < 100 {
        let r = smp_pcg64_next_i64(current)
        current = r.0
        if !smp_pcg_u_lt(r.1, threshold) {
            // Unbiased: reduce by n.
            var x: i64 = r.1
            // Same binary mod algorithm for r.1 mod n.
            if (n & n_minus_1) == 0 {
                return (current, x & n_minus_1)
            }
            var rem2: i64 = 0
            var j: i64 = 63
            while j >= 0 {
                let bit2 = smp_pcg_lshr(x, j) & 1
                rem2 = rem2 + rem2 + bit2
                if !smp_pcg_u_lt(rem2, n) {
                    rem2 = rem2 - n
                }
                j = j - 1
            }
            return (current, rem2)
        }
        attempts = attempts + 1
    }
    // Fallback (should be unreachable in practice; rejection rate ≤ 50% per call):
    return (current, 0)
}

// ============================================================================
// NORMAL DISTRIBUTION (for variability)
// ============================================================================

extern "C" {
    fn sqrt(x: f64) -> f64;
    fn log(x: f64) -> f64;
    fn exp(x: f64) -> f64;
    fn cos(x: f64) -> f64;
}

fn smp_pi() -> f64 { 3.14159265358979323846 }

fn smp_pcg64_next_f64_nonzero(rng: SmpPcg64) -> (SmpPcg64, f64) {
    var current = rng
    var attempts = 0
    while attempts < 10 {
        let result = smp_pcg64_next_f64(current)
        current = result.0
        if result.1 > 0.0 {
            return (current, result.1)
        }
        attempts = attempts + 1
    }
    return (current, 0.0000001)
}

fn sample_normal(mean: f64, std: f64, rng: SmpPcg64) -> (SmpPcg64, f64) {
    let r1 = smp_pcg64_next_f64_nonzero(rng)
    let r2 = smp_pcg64_next_f64(r1.0)

    let mag = sqrt(-2.0 * log(r1.1))
    let z = mag * cos(2.0 * smp_pi() * r2.1)

    return (r2.0, mean + std * z)
}

// ============================================================================
// BASIC SAMPLING
// ============================================================================

// Sample a single random index from [0, n)
fn sample_index(n: i64, rng: SmpPcg64) -> (SmpPcg64, i64) {
    return smp_pcg64_bounded(rng, n)
}

// Sample a single element from an f64 array
fn sample_one_f64(arr: [f64], rng: SmpPcg64) -> (SmpPcg64, f64) {
    let n = arr.len() as i64
    let idx_result = smp_pcg64_bounded(rng, n)
    return (idx_result.0, arr[idx_result.1 as usize])
}

// Sample a single element from an i64 array
fn sample_one_i64(arr: [i64], rng: SmpPcg64) -> (SmpPcg64, i64) {
    let n = arr.len() as i64
    let idx_result = smp_pcg64_bounded(rng, n)
    return (idx_result.0, arr[idx_result.1 as usize])
}

// ============================================================================
// WEIGHTED SAMPLING
// ============================================================================

// Sample index with weights (weights don't need to sum to 1)
fn sample_weighted_index(weights: [f64], rng: SmpPcg64) -> (SmpPcg64, i64) {
    // Compute total weight
    var total = 0.0
    var i: usize = 0
    while i < weights.len() {
        total = total + weights[i]
        i = i + 1
    }

    // Sample uniform [0, total)
    let u_result = smp_pcg64_next_f64(rng)
    let threshold = u_result.1 * total

    // Find which bucket
    var cumsum = 0.0
    i = 0
    while i < weights.len() {
        cumsum = cumsum + weights[i]
        if cumsum > threshold {
            return (u_result.0, i as i64)
        }
        i = i + 1
    }

    // Fallback to last index
    return (u_result.0, (weights.len() - 1) as i64)
}

// ============================================================================
// SHUFFLING (Fisher-Yates)
// ============================================================================

// Shuffle an array in place using Fisher-Yates
fn smp_shuffle_f64(arr: [f64], rng: SmpPcg64) -> (SmpPcg64, [f64]) {
    var result = arr
    var current_rng = rng
    var i = result.len()

    while i > 1 {
        i = i - 1
        let j_result = smp_pcg64_bounded(current_rng, (i + 1) as i64)
        current_rng = j_result.0
        let j = j_result.1 as usize

        // Swap result[i] and result[j]
        let temp = result[i]
        result[i] = result[j]
        result[j] = temp
    }

    return (current_rng, result)
}

// Shuffle an i64 array
fn shuffle_i64(arr: [i64], rng: SmpPcg64) -> (SmpPcg64, [i64]) {
    var result = arr
    var current_rng = rng
    var i = result.len()

    while i > 1 {
        i = i - 1
        let j_result = smp_pcg64_bounded(current_rng, (i + 1) as i64)
        current_rng = j_result.0
        let j = j_result.1 as usize

        let temp = result[i]
        result[i] = result[j]
        result[j] = temp
    }

    return (current_rng, result)
}

// ============================================================================
// RESAMPLING (BOOTSTRAP)
// ============================================================================

// Bootstrap resample: sample n items with replacement
fn resample_f64(arr: [f64], n: i64, rng: SmpPcg64) -> (SmpPcg64, [f64]) {
    var result: [f64] = []
    var current_rng = rng
    let arr_len = arr.len() as i64

    var i: i64 = 0
    while i < n {
        let idx_result = smp_pcg64_bounded(current_rng, arr_len)
        current_rng = idx_result.0
        result.push(arr[idx_result.1 as usize])
        i = i + 1
    }

    return (current_rng, result)
}

// ============================================================================
// PK/PD VARIABILITY
// ============================================================================

// Inter-Individual Variability (IIV) parameters
struct IIV {
    omega_cl: f64,   // CV for clearance
    omega_vc: f64,   // CV for central volume
    omega_ka: f64,   // CV for absorption rate
}

fn iiv_new(omega_cl: f64, omega_vc: f64, omega_ka: f64) -> IIV {
    IIV {
        omega_cl: omega_cl,
        omega_vc: omega_vc,
        omega_ka: omega_ka,
    }
}

fn iiv_typical() -> IIV {
    // Typical PK variability (30% CV)
    IIV {
        omega_cl: 0.3,
        omega_vc: 0.3,
        omega_ka: 0.5,
    }
}

// Generate individual PK parameters with IIV
struct IndividualPK {
    cl: f64,   // Individual clearance
    vc: f64,   // Individual central volume
    ka: f64,   // Individual absorption rate constant
}

fn generate_individual_pk(
    pop_cl: f64, pop_vc: f64, pop_ka: f64,
    iiv: IIV, rng: SmpPcg64
) -> (SmpPcg64, IndividualPK) {
    // Sample eta values (random effects)
    let eta_cl_result = sample_normal(0.0, iiv.omega_cl, rng)
    let eta_vc_result = sample_normal(0.0, iiv.omega_vc, eta_cl_result.0)
    let eta_ka_result = sample_normal(0.0, iiv.omega_ka, eta_vc_result.0)

    // Apply exponential transformation
    let ind = IndividualPK {
        cl: pop_cl * exp(eta_cl_result.1),
        vc: pop_vc * exp(eta_vc_result.1),
        ka: pop_ka * exp(eta_ka_result.1),
    }

    return (eta_ka_result.0, ind)
}

// Generate a virtual population
fn generate_population(
    pop_cl: f64, pop_vc: f64, pop_ka: f64,
    iiv: IIV, n_subjects: i64, rng: SmpPcg64
) -> (SmpPcg64, [IndividualPK]) {
    var population: [IndividualPK] = []
    var current_rng = rng

    var i: i64 = 0
    while i < n_subjects {
        let result = generate_individual_pk(pop_cl, pop_vc, pop_ka, iiv, current_rng)
        current_rng = result.0
        population.push(result.1)
        i = i + 1
    }

    return (current_rng, population)
}

// ============================================================================
// RESIDUAL ERROR MODELS
// ============================================================================

// Add proportional residual error
fn add_proportional_error(value: f64, sigma: f64, rng: SmpPcg64) -> (SmpPcg64, f64) {
    let eps_result = sample_normal(0.0, sigma, rng)
    return (eps_result.0, value * (1.0 + eps_result.1))
}

// Add additive residual error
fn add_additive_error(value: f64, sigma: f64, rng: SmpPcg64) -> (SmpPcg64, f64) {
    let eps_result = sample_normal(0.0, sigma, rng)
    return (eps_result.0, value + eps_result.1)
}

// Add combined (additive + proportional) residual error
fn add_combined_error(value: f64, sigma_add: f64, sigma_prop: f64, rng: SmpPcg64) -> (SmpPcg64, f64) {
    let eps1_result = sample_normal(0.0, sigma_add, rng)
    let eps2_result = sample_normal(0.0, sigma_prop, eps1_result.0)
    return (eps2_result.0, value * (1.0 + eps2_result.1) + eps1_result.1)
}

