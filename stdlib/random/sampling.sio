// random::sampling — Random Sampling Utilities
//
// Functions for sampling from collections, shuffling, and PK/PD variability.
//
// Features:
// - sample: Random selection from arrays
// - sample_weighted: Weighted random selection
// - shuffle: Random permutation
// - resample: Bootstrap resampling
// - pk_variability: PK parameter variability (IIV, IOV)
//
// References:
// - Knuth (1997): "The Art of Computer Programming, Vol. 2"
// - Lavielle (2014): "Mixed Effects Models for the Population Approach"

// ============================================================================
// RNG (inline from rng.d for self-contained module)
// ============================================================================

// R.2.8 Phase D — SmpPcg64 unified via type alias over canonical PcgState.
use stdlib::random::pcg64_core::{
    PcgState, pcg_u_lt, pcg_u128_add, pcg_umod, pcg_step, pcg_next_f64, pcg_next_f64_nonzero,
}

type SmpPcg64 = PcgState

// ─── PCG64-XSL-RR-128/64 step + canonical seeding (matches pcg-cpp) ───────

fn smp_pcg64_new(seed: i64) -> SmpPcg64 {
    let inc_hi: i64 = 6364136223846793005
    let inc_lo: i64 = 1442695040888963407
    let s0 = PcgState { state_hi: 0, state_lo: 0, inc_hi: inc_hi, inc_lo: inc_lo }
    let r1 = pcg_step(s0)
    let mid = r1.0
    let add = pcg_u128_add(mid.state_hi, mid.state_lo, 0, seed)
    let s2 = PcgState { state_hi: add.hi, state_lo: add.lo, inc_hi: inc_hi, inc_lo: inc_lo }
    let r2 = pcg_step(s2)
    return r2.0
}

fn smp_pcg64_next_i64(rng: SmpPcg64) -> (SmpPcg64, i64) { return pcg_step(rng) }

fn smp_pcg64_next_f64(rng: SmpPcg64) -> (SmpPcg64, f64) { return pcg_next_f64(rng) }

// Generate integer in [0, n) with unbiased rejection-modulo.
fn smp_pcg64_bounded(rng: SmpPcg64, n: i64) -> (SmpPcg64, i64) {
    if n <= 0 { return (rng, 0) }
    let neg_n = 0 - n
    let threshold = pcg_umod(neg_n, n)
    var current = rng
    var attempts: i64 = 0
    while attempts < 100 {
        let r = pcg_step(current)
        current = r.0
        if !pcg_u_lt(r.1, threshold) {
            return (current, pcg_umod(r.1, n))
        }
        attempts = attempts + 1
    }
    return (current, 0)
}

// ============================================================================
// NORMAL DISTRIBUTION (for variability)
// ============================================================================

extern "C" {
    fn sqrt(x: f64) -> f64;
    fn log(x: f64) -> f64;
    fn exp(x: f64) -> f64;
    fn cos(x: f64) -> f64;
}

fn smp_pi() -> f64 { 3.14159265358979323846 }

fn smp_pcg64_next_f64_nonzero(rng: SmpPcg64) -> (SmpPcg64, f64) {
    return pcg_next_f64_nonzero(rng)
}

fn sample_normal(mean: f64, std: f64, rng: SmpPcg64) -> (SmpPcg64, f64) {
    let r1 = smp_pcg64_next_f64_nonzero(rng)
    let r2 = smp_pcg64_next_f64(r1.0)

    let mag = sqrt(-2.0 * log(r1.1))
    let z = mag * cos(2.0 * smp_pi() * r2.1)

    return (r2.0, mean + std * z)
}

// ============================================================================
// BASIC SAMPLING
// ============================================================================

// Sample a single random index from [0, n)
fn sample_index(n: i64, rng: SmpPcg64) -> (SmpPcg64, i64) {
    return smp_pcg64_bounded(rng, n)
}

// Sample a single element from an f64 array
fn sample_one_f64(arr: [f64], rng: SmpPcg64) -> (SmpPcg64, f64) {
    let n = arr.len() as i64
    let idx_result = smp_pcg64_bounded(rng, n)
    return (idx_result.0, arr[idx_result.1 as usize])
}

// Sample a single element from an i64 array
fn sample_one_i64(arr: [i64], rng: SmpPcg64) -> (SmpPcg64, i64) {
    let n = arr.len() as i64
    let idx_result = smp_pcg64_bounded(rng, n)
    return (idx_result.0, arr[idx_result.1 as usize])
}

// ============================================================================
// WEIGHTED SAMPLING
// ============================================================================

// Sample index with weights (weights don't need to sum to 1)
fn sample_weighted_index(weights: [f64], rng: SmpPcg64) -> (SmpPcg64, i64) {
    // Compute total weight
    var total = 0.0
    var i: usize = 0
    while i < weights.len() {
        total = total + weights[i]
        i = i + 1
    }

    // Sample uniform [0, total)
    let u_result = smp_pcg64_next_f64(rng)
    let threshold = u_result.1 * total

    // Find which bucket
    var cumsum = 0.0
    i = 0
    while i < weights.len() {
        cumsum = cumsum + weights[i]
        if cumsum > threshold {
            return (u_result.0, i as i64)
        }
        i = i + 1
    }

    // Fallback to last index
    return (u_result.0, (weights.len() - 1) as i64)
}

// ============================================================================
// SHUFFLING (Fisher-Yates)
// ============================================================================

// Shuffle an array in place using Fisher-Yates
fn smp_shuffle_f64(arr: [f64], rng: SmpPcg64) -> (SmpPcg64, [f64]) {
    var result = arr
    var current_rng = rng
    var i = result.len()

    while i > 1 {
        i = i - 1
        let j_result = smp_pcg64_bounded(current_rng, (i + 1) as i64)
        current_rng = j_result.0
        let j = j_result.1 as usize

        // Swap result[i] and result[j]
        let temp = result[i]
        result[i] = result[j]
        result[j] = temp
    }

    return (current_rng, result)
}

// Shuffle an i64 array
fn shuffle_i64(arr: [i64], rng: SmpPcg64) -> (SmpPcg64, [i64]) {
    var result = arr
    var current_rng = rng
    var i = result.len()

    while i > 1 {
        i = i - 1
        let j_result = smp_pcg64_bounded(current_rng, (i + 1) as i64)
        current_rng = j_result.0
        let j = j_result.1 as usize

        let temp = result[i]
        result[i] = result[j]
        result[j] = temp
    }

    return (current_rng, result)
}

// ============================================================================
// RESAMPLING (BOOTSTRAP)
// ============================================================================

// Bootstrap resample: sample n items with replacement
fn resample_f64(arr: [f64], n: i64, rng: SmpPcg64) -> (SmpPcg64, [f64]) {
    var result: [f64] = []
    var current_rng = rng
    let arr_len = arr.len() as i64

    var i: i64 = 0
    while i < n {
        let idx_result = smp_pcg64_bounded(current_rng, arr_len)
        current_rng = idx_result.0
        result.push(arr[idx_result.1 as usize])
        i = i + 1
    }

    return (current_rng, result)
}

// ============================================================================
// PK/PD VARIABILITY
// ============================================================================

// Inter-Individual Variability (IIV) parameters
struct IIV {
    omega_cl: f64,   // CV for clearance
    omega_vc: f64,   // CV for central volume
    omega_ka: f64,   // CV for absorption rate
}

fn iiv_new(omega_cl: f64, omega_vc: f64, omega_ka: f64) -> IIV {
    IIV {
        omega_cl: omega_cl,
        omega_vc: omega_vc,
        omega_ka: omega_ka,
    }
}

fn iiv_typical() -> IIV {
    // Typical PK variability (30% CV)
    IIV {
        omega_cl: 0.3,
        omega_vc: 0.3,
        omega_ka: 0.5,
    }
}

// Generate individual PK parameters with IIV
struct IndividualPK {
    cl: f64,   // Individual clearance
    vc: f64,   // Individual central volume
    ka: f64,   // Individual absorption rate constant
}

fn generate_individual_pk(
    pop_cl: f64, pop_vc: f64, pop_ka: f64,
    iiv: IIV, rng: SmpPcg64
) -> (SmpPcg64, IndividualPK) {
    // Sample eta values (random effects)
    let eta_cl_result = sample_normal(0.0, iiv.omega_cl, rng)
    let eta_vc_result = sample_normal(0.0, iiv.omega_vc, eta_cl_result.0)
    let eta_ka_result = sample_normal(0.0, iiv.omega_ka, eta_vc_result.0)

    // Apply exponential transformation
    let ind = IndividualPK {
        cl: pop_cl * exp(eta_cl_result.1),
        vc: pop_vc * exp(eta_vc_result.1),
        ka: pop_ka * exp(eta_ka_result.1),
    }

    return (eta_ka_result.0, ind)
}

// Generate a virtual population
fn generate_population(
    pop_cl: f64, pop_vc: f64, pop_ka: f64,
    iiv: IIV, n_subjects: i64, rng: SmpPcg64
) -> (SmpPcg64, [IndividualPK]) {
    var population: [IndividualPK] = []
    var current_rng = rng

    var i: i64 = 0
    while i < n_subjects {
        let result = generate_individual_pk(pop_cl, pop_vc, pop_ka, iiv, current_rng)
        current_rng = result.0
        population.push(result.1)
        i = i + 1
    }

    return (current_rng, population)
}

// ============================================================================
// RESIDUAL ERROR MODELS
// ============================================================================

// Add proportional residual error
fn add_proportional_error(value: f64, sigma: f64, rng: SmpPcg64) -> (SmpPcg64, f64) {
    let eps_result = sample_normal(0.0, sigma, rng)
    return (eps_result.0, value * (1.0 + eps_result.1))
}

// Add additive residual error
fn add_additive_error(value: f64, sigma: f64, rng: SmpPcg64) -> (SmpPcg64, f64) {
    let eps_result = sample_normal(0.0, sigma, rng)
    return (eps_result.0, value + eps_result.1)
}

// Add combined (additive + proportional) residual error
fn add_combined_error(value: f64, sigma_add: f64, sigma_prop: f64, rng: SmpPcg64) -> (SmpPcg64, f64) {
    let eps1_result = sample_normal(0.0, sigma_add, rng)
    let eps2_result = sample_normal(0.0, sigma_prop, eps1_result.0)
    return (eps2_result.0, value * (1.0 + eps2_result.1) + eps1_result.1)
}

