// random::rng — Random Number Generators
//
// Fast, high-quality PRNGs for scientific computing.
// PCG64: Default, excellent statistical quality
// RngXoshiro256++: Fast for simulations
// SplitMix64: For seeding other generators
//
// References:
// - O'Neill (2014): "PCG: A Family of Simple Fast Space-Efficient PRNGs"
// - Blackman & Vigna (2018): "Scrambled Linear Pseudorandom Number Generators"

// ============================================================================
// SPLITMIX64 — FOR SEEDING
// ============================================================================

struct SplitMix64 {
    state: i64,
}

fn splitmix64_new(seed: i64) -> SplitMix64 {
    SplitMix64 { state: seed }
}

fn splitmix64_next(rng: SplitMix64) -> (SplitMix64, i64) {
    // state += 0x9e3779b97f4a7c15
    let new_state = rng.state + 0x9e3779b97f4a7c15 as i64
    var z = new_state

    // z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9
    z = z ^ (z >> 30)
    // Simplified multiplication for interpreter
    z = z * 0xbf58476d as i64

    // z = (z ^ (z >> 27)) * 0x94d049bb133111eb
    z = z ^ (z >> 27)
    z = z * 0x94d049bb as i64

    z = z ^ (z >> 31)

    (SplitMix64 { state: new_state }, z)
}

// ============================================================================
// PCG64 — DEFAULT GENERATOR
// ============================================================================

// R.3.1 Phase D — Pcg64 unified via type alias over canonical PcgState.
// The R.2.8/R.2.9 deferred wiring lands here: TUP_CACHE_KEY collisions
// in Pass 1c.5 are now resolved (R.3.1 compiler patch).
use stdlib::random::pcg64_core::{
    PcgState, pcg_u_lt, pcg_umod, pcg_step, pcg_next_f64, pcg_next_f64_nonzero,
}

type Pcg64 = PcgState

fn pcg64_new(seed: i64) -> Pcg64 {
    // Preserves the multi-stream design rng.sio was built around: each
    // (seed, state_hi, state_lo, inc_hi, inc_lo) tuple is derived from
    // four splitmix64 outputs, giving independent streams across seeds.
    // inc_hi|1 and inc_lo|1 ensure the stream constant is odd (PCG req).
    var sm = splitmix64_new(seed)
    let r1 = splitmix64_next(sm)
    sm = r1.0
    let s1 = r1.1
    let r2 = splitmix64_next(sm)
    sm = r2.0
    let s2 = r2.1
    let r3 = splitmix64_next(sm)
    sm = r3.0
    let s3 = r3.1
    let r4 = splitmix64_next(sm)
    let s4 = r4.1
    PcgState {
        state_hi: s1,
        state_lo: s2,
        inc_hi: s3 | 1,
        inc_lo: s4 | 1,
    }
}

fn pcg64_next_i64(rng: Pcg64) -> (Pcg64, i64) { return pcg_step(rng) }

fn pcg64_next_f64(rng: Pcg64) -> (Pcg64, f64) { return pcg_next_f64(rng) }

fn pcg64_next_f64_nonzero(rng: Pcg64) -> (Pcg64, f64) { return pcg_next_f64_nonzero(rng) }

fn pcg64_next_bool(rng: Pcg64, p: f64) -> (Pcg64, bool) {
    let result = pcg_next_f64(rng)
    (result.0, result.1 < p)
}

fn pcg64_bounded(rng: Pcg64, n: i64) -> (Pcg64, i64) {
    if n <= 0 { return (rng, 0) }
    let neg_n = 0 - n
    let threshold = pcg_umod(neg_n, n)
    var current = rng
    var attempts: i64 = 0
    while attempts < 100 {
        let r = pcg_step(current)
        current = r.0
        if !pcg_u_lt(r.1, threshold) {
            return (current, pcg_umod(r.1, n))
        }
        attempts = attempts + 1
    }
    (current, 0)
}

// ============================================================================
// XOSHIRO256++ — FAST SIMULATION RNG
// ============================================================================

struct RngXoshiro256 {
    s0: i64,
    s1: i64,
    s2: i64,
    s3: i64,
}

fn xoshiro256_new(seed: i64) -> RngXoshiro256 {
    var sm = splitmix64_new(seed)

    let r1 = splitmix64_next(sm)
    sm = r1.0
    let r2 = splitmix64_next(sm)
    sm = r2.0
    let r3 = splitmix64_next(sm)
    sm = r3.0
    let r4 = splitmix64_next(sm)

    RngXoshiro256 {
        s0: r1.1,
        s1: r2.1,
        s2: r3.1,
        s3: r4.1,
    }
}

fn rng_rotl(x: i64, k: i64) -> i64 {
    (x << k) | (x >> (64 - k))
}

fn xoshiro256_next_i64(rng: RngXoshiro256) -> (RngXoshiro256, i64) {
    // result = rng_rotl(s0 + s3, 23) + s0
    let result = rng_rotl(rng.s0 + rng.s3, 23) + rng.s0

    let t = rng.s1 << 17

    var s2 = rng.s2 ^ rng.s0
    var s3 = rng.s3 ^ rng.s1
    var s1 = rng.s1 ^ s2
    var s0 = rng.s0 ^ s3

    s2 = s2 ^ t
    s3 = rng_rotl(s3, 45)

    (RngXoshiro256 { s0: s0, s1: s1, s2: s2, s3: s3 }, result)
}

fn xoshiro256_next_f64(rng: RngXoshiro256) -> (RngXoshiro256, f64) {
    let result = xoshiro256_next_i64(rng)
    let new_rng = result.0
    let bits = result.1

    let positive = if bits < 0 { 0 - bits } else { bits }
    let fraction = (positive as f64) / 9223372036854775807.0

    (new_rng, fraction)
}

// ============================================================================
// RNG WRAPPER (functional approach)
// ============================================================================

// Since global mutable state isn't supported, we use a functional approach
// where the RNG state is passed through and returned

pub struct RngPcgWrapper {
    rng: Pcg64,
}

pub fn rng_pcg_new(seed: i64) -> RngPcgWrapper {
    RngPcgWrapper { rng: pcg64_new(seed) }
}

fn rng_pcg_next_f64(state: RngPcgWrapper) -> (RngPcgWrapper, f64) {
    let result = pcg64_next_f64(state.rng)
    (RngPcgWrapper { rng: result.0 }, result.1)
}

fn rng_pcg_next_i64(state: RngPcgWrapper) -> (RngPcgWrapper, i64) {
    let result = pcg64_next_i64(state.rng)
    (RngPcgWrapper { rng: result.0 }, result.1)
}

fn rng_pcg_next_bool(state: RngPcgWrapper, p: f64) -> (RngPcgWrapper, bool) {
    let result = pcg64_next_bool(state.rng, p)
    (RngPcgWrapper { rng: result.0 }, result.1)
}

pub fn rng_pcg_bounded(state: RngPcgWrapper, n: i64) -> (RngPcgWrapper, i64) {
    let result = pcg64_bounded(state.rng, n)
    (RngPcgWrapper { rng: result.0 }, result.1)
}

// ============================================================================
// XORSHIFT128+ RNG WITH FUNCTIONAL (VALUE-PASSING) API
// ============================================================================
//
// Design: Explicit state threading — no global mutable state.
// Algorithm: xorshift128+ (Vigna 2014) with splitmix64 seeding.
// Each function returns (value, new_state) so callers chain state.

// ----------------------------------------------------------------------------
// Inline math helpers — no imports required
// ----------------------------------------------------------------------------

fn rng_sqrt(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 20 {
        y = 0.5 * (y + x / y)
        i = i + 1
    }
    y
}

fn rng_ln(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 - 1.0e30 }
    if x == 1.0 { return 0.0 }
    var m = x
    var e_val = 0
    while m >= 2.0 { m = m / 2.0; e_val = e_val + 1 }
    while m < 0.5 { m = m * 2.0; e_val = e_val - 1 }
    let t = (m - 1.0) / (m + 1.0)
    let t2 = t * t
    var sum = t
    var term = t
    var k = 1
    while k < 30 {
        term = term * t2
        sum = sum + term / (2 * k + 1) as f64
        k = k + 1
    }
    2.0 * sum + (e_val as f64) * 0.6931471805599453
}

fn rng_cos(x: f64) -> f64 with Mut, Div, Panic {
    let twopi = 6.28318530717958647692
    var a = x
    while a >= twopi { a = a - twopi }
    while a < 0.0 { a = a + twopi }
    if a > 3.14159265358979323846 { a = a - twopi }
    let a2 = a * a
    var sum = 1.0
    var term = 1.0
    var n = 1
    while n < 15 {
        term = 0.0 - term * a2 / ((2 * n - 1) * 2 * n) as f64
        sum = sum + term
        n = n + 1
    }
    sum
}

fn rng_sin(x: f64) -> f64 with Mut, Div, Panic {
    let twopi = 6.28318530717958647692
    var a = x
    while a >= twopi { a = a - twopi }
    while a < 0.0 { a = a + twopi }
    if a > 3.14159265358979323846 { a = a - twopi }
    let a2 = a * a
    var sum = a
    var term = a
    var n = 1
    while n < 15 {
        term = 0.0 - term * a2 / ((2 * n) * (2 * n + 1)) as f64
        sum = sum + term
        n = n + 1
    }
    sum
}

// ----------------------------------------------------------------------------
// RngState — xorshift128+ state (two 64-bit words)
// ----------------------------------------------------------------------------

struct RngState {
    s0: i64,
    s1: i64,
}

// splitmix64 step: expand a single seed word into well-mixed output
fn rng_splitmix_step(s: i64) -> (i64, i64) with Mut {
    let next = s + 0x9e3779b97f4a7c15
    var z = next
    z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9
    z = (z ^ (z >> 27)) * 0x94d049bb133111eb
    let out = z ^ (z >> 31)
    (next, out)
}

// Initialize RngState from a seed using splitmix64
fn rng_new(seed: i64) -> RngState with Mut {
    let step1 = rng_splitmix_step(seed)
    let s = step1.0
    let s0 = step1.1
    let step2 = rng_splitmix_step(s)
    let s1 = step2.1
    RngState { s0: s0, s1: s1 }
}

// xorshift128+: returns (random i64, new state)
fn rng_next(state: RngState) -> (i64, RngState) with Mut {
    var x = state.s0
    let y = state.s1
    x = x ^ (x << 23)
    x = x ^ (x >> 17)
    x = x ^ y
    x = x ^ (y >> 26)
    let out = state.s0 + y
    (out, RngState { s0: y, s1: x })
}

// Uniform [0, 1) — clears sign bit via AND, maps to [0, 1) by dividing by 2^63-1
fn rng_uniform(state: RngState) -> (f64, RngState) with Mut, Div, Panic {
    let r = rng_next(state)
    let bits = r.0
    // Clear sign bit: AND with 0x7fffffffffffffff gives value in [0, 2^63-1]
    let pos = bits & 0x7fffffffffffffff
    let f = (pos as f64) / 9223372036854775807.0
    (f, r.1)
}

// Uniform [lo, hi)
fn rng_uniform_range(state: RngState, lo: f64, hi: f64) -> (f64, RngState) with Mut, Div, Panic {
    let r = rng_uniform(state)
    (lo + r.0 * (hi - lo), r.1)
}

// ----------------------------------------------------------------------------
// Distributions
// ----------------------------------------------------------------------------

// Normal N(mu, sigma) — Box-Muller transform
fn rng_normal(state: RngState, mu: f64, sigma: f64) -> (f64, RngState) with Mut, Div, Panic {
    // Need u1 > 0 for log; retry up to 10 times
    var cur = state
    var u1 = 0.0
    var attempts = 0
    while attempts < 10 {
        let r = rng_uniform(cur)
        cur = r.1
        if r.0 > 0.0 {
            u1 = r.0
            attempts = 100  // break
        } else {
            attempts = attempts + 1
        }
    }
    if u1 <= 0.0 { u1 = 1.0e-10 }
    let r2 = rng_uniform(cur)
    let u2 = r2.0
    let new_state = r2.1
    let mag = rng_sqrt(0.0 - 2.0 * rng_ln(u1))
    let z = mag * rng_cos(2.0 * 3.14159265358979323846 * u2)
    (mu + sigma * z, new_state)
}

// Exponential Exp(lambda) — inverse CDF: -ln(u)/lambda
fn rng_exponential(state: RngState, lambda: f64) -> (f64, RngState) with Mut, Div, Panic {
    var cur = state
    var u = 0.0
    var attempts = 0
    while attempts < 10 {
        let r = rng_uniform(cur)
        cur = r.1
        if r.0 > 0.0 {
            u = r.0
            attempts = 100
        } else {
            attempts = attempts + 1
        }
    }
    if u <= 0.0 { u = 1.0e-10 }
    ((0.0 - rng_ln(u)) / lambda, cur)
}

// Poisson Pois(lambda) — Knuth's algorithm (good for lambda < 30)
fn rng_poisson(state: RngState, lambda: f64) -> (i64, RngState) with Mut, Div, Panic {
    let l = rng_ln(1.0)  // just 0 — used as a warmup call
    // e^-lambda as a product threshold
    // We compute exp(-lambda) via repeated multiply on ln comparison
    // Using Knuth: generate uniform products until < e^-lambda
    // e^-lambda: approximate via rng_ln(p) < -lambda
    var cur = state
    var k: i64 = 0
    var log_p = 0.0
    var done = false
    while !done {
        let r = rng_uniform(cur)
        cur = r.1
        var u = r.0
        if u <= 0.0 { u = 1.0e-10 }
        log_p = log_p + rng_ln(u)
        if log_p < (0.0 - lambda) {
            done = true
        } else {
            k = k + 1
        }
    }
    (k, cur)
}

// Bernoulli(p) — 1 with probability p, 0 otherwise
fn rng_bernoulli(state: RngState, p: f64) -> (i32, RngState) with Mut, Div, Panic {
    let r = rng_uniform(state)
    let v: i32 = if r.0 < p { 1 } else { 0 }
    (v, r.1)
}

// Geometric(p) — number of trials until first success (1-indexed)
fn rng_geometric(state: RngState, p: f64) -> (i64, RngState) with Mut, Div, Panic {
    var cur = state
    var u = 0.0
    var attempts = 0
    while attempts < 10 {
        let r = rng_uniform(cur)
        cur = r.1
        if r.0 > 0.0 {
            u = r.0
            attempts = 100
        } else {
            attempts = attempts + 1
        }
    }
    if u <= 0.0 { u = 1.0e-10 }
    // ceiling(ln(u) / ln(1-p))
    let log_u = rng_ln(u)
    let log_1mp = rng_ln(1.0 - p)
    var k = log_u / log_1mp
    // ceiling: if k is not already integer
    let ki = k as i64
    let result: i64 = if (ki as f64) < k { ki + 1 } else { ki }
    let final_k: i64 = if result < 1 { 1 } else { result }
    (final_k, cur)
}

// ----------------------------------------------------------------------------
// Sampling utilities — fixed-size array operations
// ----------------------------------------------------------------------------

// Fisher-Yates shuffle of first n elements in arr (max 256)
// Returns (new_state, shuffled_array) — by-value for JIT compatibility
fn rng_shuffle(state: RngState, arr: [f64; 256], n: i32) -> (RngState, [f64; 256]) with Mut, Div, Panic {
    var cur = state
    var out = arr
    var i = n - 1
    while i > 0 {
        // Get random j in [0, i]
        let r = rng_next(cur)
        cur = r.1
        let bits = r.0
        let positive = if bits < 0 { 0 - bits } else { bits }
        let j = (positive % ((i + 1) as i64)) as i32
        let tmp = out[i]
        out[i] = out[j]
        out[j] = tmp
        i = i - 1
    }
    (cur, out)
}

// Fill first n elements with uniform [0, 1) samples
// Returns (new_state, filled_array) — by-value for JIT compatibility
fn rng_fill_uniform(state: RngState, n: i32) -> (RngState, [f64; 256]) with Mut, Div, Panic {
    var cur = state
    var arr: [f64; 256] = [0.0; 256]
    var i = 0
    while i < n {
        let r = rng_uniform(cur)
        arr[i] = r.0
        cur = r.1
        i = i + 1
    }
    (cur, arr)
}

// Fill first n elements with normal samples N(mu, sigma)
// Returns (new_state, filled_array) — by-value for JIT compatibility
pub fn rng_fill_normal(state: RngState, n: i32, mu: f64, sigma: f64) -> (RngState, [f64; 256]) with Mut, Div, Panic {
    var cur = state
    var arr: [f64; 256] = [0.0; 256]
    var i = 0
    while i < n {
        let r = rng_normal(cur, mu, sigma)
        arr[i] = r.0
        cur = r.1
        i = i + 1
    }
    (cur, arr)
}

