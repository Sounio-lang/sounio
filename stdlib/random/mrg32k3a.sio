// random::mrg32k3a — MRG32k3a combined multiple-recursive generator
// (L Ecuyer 1999) with RngStreams streams/substreams (2002).
//
// Constants below (moduli, multipliers, jump matrices, norm) follow the
// RngStream.c reference implementation. The oracle test pins the first
// outputs, the post-8 state, and the first substream against vectors
// generated by compiling that reference C code.
//
// Purpose: reproducible MRG32k3a substreams for GPU population Monte
// Carlo (one stream per draw, skip-ahead per draw index). State advance
// uses exact i64 arithmetic (single-step intermediates below 2^54);
// only the final combination touches f64 (differences below 2^32).
//
// GPU note: mrg32k3a_mod_mul uses a bounded while loop (32 iterations).
// Loop-carried state does not lower to GPU today (HLIR PHI refusal), so
// the GPU kernel port must unroll it (or precompute stream starts).
//
// Stdlib-internal like pcg64_core: callers import explicitly via
// use stdlib::random::mrg32k3a.

pub struct Mrg32k3aState {
    pub s0: i64,
    pub s1: i64,
    pub s2: i64,
    pub s3: i64,
    pub s4: i64,
    pub s5: i64,
}

// Default package seed: all six components 12345 per the reference.
pub fn mrg32k3a_default_seed() -> Mrg32k3aState {
    Mrg32k3aState { s0: 12345, s1: 12345, s2: 12345, s3: 12345, s4: 12345, s5: 12345 }
}

// One MRG32k3a step; returns (uniform in [0,1), next state).
// Matches the reference U01 exactly (truncated division).
pub fn mrg32k3a_next_u01(st: Mrg32k3aState) -> (f64, Mrg32k3aState) with Mut, Div {
    let m1: i64 = 4294967087
    let m2: i64 = 4294944443
    let norm: f64 = 2.328306549295727688e-10
    // Component 1: x_n = (1403580*x_{n-2} - 810728*x_{n-3}) mod m1.
    let p1raw = 1403580 * st.s1 - 810728 * st.s0
    let k1 = p1raw / m1
    var p1 = p1raw - k1 * m1
    if p1 < 0 { p1 = p1 + m1 }
    // Component 2: y_n = (527612*y_{n-1} - 1370589*y_{n-3}) mod m2.
    let p2raw = 527612 * st.s5 - 1370589 * st.s3
    let k2 = p2raw / m2
    var p2 = p2raw - k2 * m2
    if p2 < 0 { p2 = p2 + m2 }
    // Combination: u = (p1 - p2)/2^32 (plus m1 wrap), norm = 2^-32.
    let diff = p1 - p2
    let z = if p1 > p2 { diff } else { diff + m1 }
    let u = (z as f64) * norm
    let next = Mrg32k3aState { s0: st.s1, s1: st.s2, s2: p1, s3: st.s4, s4: st.s5, s5: p2 }
    (u, next)
}

// (a * b) mod m for 0 <= a, b < m < 2^32 via Russian-peasant doubling;
// all intermediates stay below 2*m. Bounded: at most 32 iterations.
pub fn mrg32k3a_mod_mul(a: i64, b: i64, m: i64) -> i64 with Mut, Div {
    var x = a
    var y = b
    var r: i64 = 0
    while y > 0 {
        if y % 2 == 1 {
            r = r + x
            if r >= m { r = r - m }
        }
        x = x + x
        if x >= m { x = x - m }
        y = y / 2
    }
    r
}

// Advance state by one substream (2^76 steps) via the A1p76/A2p76 jump
// matrices, matching the reference ResetNextSubstream.
pub fn mrg32k3a_next_substream(st: Mrg32k3aState) -> Mrg32k3aState with Mut, Div {
    let m1: i64 = 4294967087
    let m2: i64 = 4294944443
    let n0 = mrg32k3a_mod_add3(82758667, st.s0, 1871391091, st.s1, 4127413238, st.s2, m1)
    let n1 = mrg32k3a_mod_add3(3672831523, st.s0, 69195019, st.s1, 1871391091, st.s2, m1)
    let n2 = mrg32k3a_mod_add3(3672091415, st.s0, 3528743235, st.s1, 69195019, st.s2, m1)
    let n3 = mrg32k3a_mod_add3(1511326704, st.s3, 3759209742, st.s4, 1610795712, st.s5, m2)
    let n4 = mrg32k3a_mod_add3(4292754251, st.s3, 1511326704, st.s4, 3889917532, st.s5, m2)
    let n5 = mrg32k3a_mod_add3(3859662829, st.s3, 4292754251, st.s4, 3708466080, st.s5, m2)
    Mrg32k3aState { s0: n0, s1: n1, s2: n2, s3: n3, s4: n4, s5: n5 }
}

// (a*x + b*y + c*z) mod m via exact modular multiply-adds.
fn mrg32k3a_mod_add3(a: i64, x: i64, b: i64, y: i64, c: i64, z: i64, m: i64) -> i64 with Mut, Div {
    var r = mrg32k3a_mod_mul(a, x, m)
    r = r + mrg32k3a_mod_mul(b, y, m)
    if r >= m { r = r - m }
    r = r + mrg32k3a_mod_mul(c, z, m)
    if r >= m { r = r - m }
    r
}
