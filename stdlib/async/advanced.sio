// async/advanced.sio — Cooperative scheduling primitives for advanced
// Sounio async model: cooperative, fixed-size, no heap

struct AsyncAdvancedState {
    ready: bool,
    value: i64,
    tag: i64,
}

fn async_advanced_state_new() -> AsyncAdvancedState {
    AsyncAdvancedState { ready: false, value: 0, tag: 0 }
}

fn async_advanced_is_ready(s: AsyncAdvancedState) -> bool {
    s.ready
}

fn async_advanced_complete(s: AsyncAdvancedState, val: i64) -> AsyncAdvancedState {
    AsyncAdvancedState { ready: true, value: val, tag: s.tag }
}

fn async_advanced_get_value(s: AsyncAdvancedState) -> i64 {
    s.value
}

struct AdvancedRingBuffer {
    data: [i64; 64],
    head: i32,
    tail: i32,
    count: i32,
}

fn advanced_ring_new() -> AdvancedRingBuffer {
    AdvancedRingBuffer { data: [0; 64], head: 0, tail: 0, count: 0 }
}

fn advanced_ring_push(rb: AdvancedRingBuffer, val: i64) -> AdvancedRingBuffer with Mut, Div, Panic {
    if rb.count >= 64 { return rb }
    var result = rb
    result.data[result.tail] = val
    result.tail = (result.tail + 1) % 64
    result.count = result.count + 1
    result
}

fn advanced_ring_pop(rb: AdvancedRingBuffer) -> AdvancedRingBuffer with Mut, Div, Panic {
    if rb.count <= 0 { return rb }
    var result = rb
    result.head = (result.head + 1) % 64
    result.count = result.count - 1
    result
}

fn advanced_ring_peek(rb: AdvancedRingBuffer) -> i64 {
    if rb.count <= 0 { return 0 }
    rb.data[rb.head]
}

fn advanced_ring_is_empty(rb: AdvancedRingBuffer) -> bool {
    rb.count <= 0
}

fn test_advanced_ring_basic() -> bool with Mut, Div, Panic {
    var rb = advanced_ring_new()
    rb = advanced_ring_push(rb, 42)
    let val = advanced_ring_peek(rb)
    val == 42
}

fn test_advanced_state_lifecycle() -> bool {
    var s = async_advanced_state_new()
    let not_ready = !async_advanced_is_ready(s)
    s = async_advanced_complete(s, 99)
    let is_ready = async_advanced_is_ready(s)
    not_ready && is_ready && async_advanced_get_value(s) == 99
}
