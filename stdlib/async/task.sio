// stdlib/async/task — Async task representation
//
// Task: a unit of async work with status tracking.
// TaskQueue: fixed-capacity queue of tasks.

let TASK_PENDING: i64 = 0
let TASK_RUNNING: i64 = 1
let TASK_COMPLETED: i64 = 2
let TASK_CANCELLED: i64 = 3

struct Task {
    id: i64,
    status: i64,
    result: i64,
    priority: i64,
}

fn task_new(id: i64) -> Task {
    Task { id: id, status: TASK_PENDING, result: 0, priority: 0 }
}

fn task_with_priority(id: i64, priority: i64) -> Task {
    Task { id: id, status: TASK_PENDING, result: 0, priority: priority }
}

impl Task {
    fn is_pending(self: &Task) -> bool { self.status == TASK_PENDING }
    fn is_running(self: &Task) -> bool { self.status == TASK_RUNNING }
    fn is_completed(self: &Task) -> bool { self.status == TASK_COMPLETED }
    fn is_cancelled(self: &Task) -> bool { self.status == TASK_CANCELLED }
}

let TASK_QUEUE_CAP: i64 = 256

struct TaskQueue {
    tasks_id: [i64; 256],
    tasks_status: [i64; 256],
    tasks_result: [i64; 256],
    tasks_priority: [i64; 256],
    count: i64,
}

impl TaskQueue {
    fn new() -> TaskQueue {
        TaskQueue {
            tasks_id: [0; 256],
            tasks_status: [0; 256],
            tasks_result: [0; 256],
            tasks_priority: [0; 256],
            count: 0,
        }
    }

    fn len(self: &TaskQueue) -> i64 { self.count }
    fn is_empty(self: &TaskQueue) -> bool { self.count == 0 }

    fn push(self: &! TaskQueue, t: Task) {
        if self.count >= TASK_QUEUE_CAP { return }
        let i = self.count
        self.tasks_id[i] = t.id
        self.tasks_status[i] = t.status
        self.tasks_result[i] = t.result
        self.tasks_priority[i] = t.priority
        self.count = self.count + 1
    }

    fn get_status(self: &TaskQueue, idx: i64) -> i64 {
        if idx < 0 || idx >= self.count { return 0 - 1 }
        self.tasks_status[idx]
    }

    fn set_status(self: &! TaskQueue, idx: i64, status: i64) {
        if idx >= 0 && idx < self.count {
            self.tasks_status[idx] = status
        }
    }

    fn set_result(self: &! TaskQueue, idx: i64, result: i64) {
        if idx >= 0 && idx < self.count {
            self.tasks_result[idx] = result
        }
    }
}
