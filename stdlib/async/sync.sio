// async/sync.sio — Cooperative scheduling primitives for sync
// Sounio async model: cooperative, fixed-size, no heap

struct AsyncSyncState {
    ready: bool,
    value: i64,
    tag: i64,
}

fn async_sync_state_new() -> AsyncSyncState {
    AsyncSyncState { ready: false, value: 0, tag: 0 }
}

fn async_sync_is_ready(s: AsyncSyncState) -> bool {
    s.ready
}

fn async_sync_complete(s: AsyncSyncState, val: i64) -> AsyncSyncState {
    AsyncSyncState { ready: true, value: val, tag: s.tag }
}

fn async_sync_get_value(s: AsyncSyncState) -> i64 {
    s.value
}

struct SyncRingBuffer {
    data: [i64; 64],
    head: i32,
    tail: i32,
    count: i32,
}

fn sync_ring_new() -> SyncRingBuffer {
    SyncRingBuffer { data: [0; 64], head: 0, tail: 0, count: 0 }
}

fn sync_ring_push(rb: SyncRingBuffer, val: i64) -> SyncRingBuffer with Mut, Div, Panic {
    if rb.count >= 64 { return rb }
    var result = rb
    result.data[result.tail] = val
    result.tail = (result.tail + 1) % 64
    result.count = result.count + 1
    result
}

fn sync_ring_pop(rb: SyncRingBuffer) -> SyncRingBuffer with Mut, Div, Panic {
    if rb.count <= 0 { return rb }
    var result = rb
    result.head = (result.head + 1) % 64
    result.count = result.count - 1
    result
}

fn sync_ring_peek(rb: SyncRingBuffer) -> i64 {
    if rb.count <= 0 { return 0 }
    rb.data[rb.head]
}

fn sync_ring_is_empty(rb: SyncRingBuffer) -> bool {
    rb.count <= 0
}

fn test_sync_ring_basic() -> bool with Mut, Div, Panic {
    var rb = sync_ring_new()
    rb = sync_ring_push(rb, 42)
    let val = sync_ring_peek(rb)
    val == 42
}

fn test_sync_state_lifecycle() -> bool {
    var s = async_sync_state_new()
    let not_ready = !async_sync_is_ready(s)
    s = async_sync_complete(s, 99)
    let is_ready = async_sync_is_ready(s)
    not_ready && is_ready && async_sync_get_value(s) == 99
}
