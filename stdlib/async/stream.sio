// async/stream.sio — Cooperative scheduling primitives for stream
// Sounio async model: cooperative, fixed-size, no heap

struct AsyncStreamState {
    ready: bool,
    value: i64,
    tag: i64,
}

fn async_stream_state_new() -> AsyncStreamState {
    AsyncStreamState { ready: false, value: 0, tag: 0 }
}

fn async_stream_is_ready(s: AsyncStreamState) -> bool {
    s.ready
}

fn async_stream_complete(s: AsyncStreamState, val: i64) -> AsyncStreamState {
    AsyncStreamState { ready: true, value: val, tag: s.tag }
}

fn async_stream_get_value(s: AsyncStreamState) -> i64 {
    s.value
}

struct StreamRingBuffer {
    data: [i64; 64],
    head: i32,
    tail: i32,
    count: i32,
}

fn stream_ring_new() -> StreamRingBuffer {
    StreamRingBuffer { data: [0; 64], head: 0, tail: 0, count: 0 }
}

fn stream_ring_push(rb: StreamRingBuffer, val: i64) -> StreamRingBuffer with Mut, Div, Panic {
    if rb.count >= 64 { return rb }
    var result = rb
    result.data[result.tail] = val
    result.tail = (result.tail + 1) % 64
    result.count = result.count + 1
    result
}

fn stream_ring_pop(rb: StreamRingBuffer) -> StreamRingBuffer with Mut, Div, Panic {
    if rb.count <= 0 { return rb }
    var result = rb
    result.head = (result.head + 1) % 64
    result.count = result.count - 1
    result
}

fn stream_ring_peek(rb: StreamRingBuffer) -> i64 {
    if rb.count <= 0 { return 0 }
    rb.data[rb.head]
}

fn stream_ring_is_empty(rb: StreamRingBuffer) -> bool {
    rb.count <= 0
}

fn test_stream_ring_basic() -> bool with Mut, Div, Panic {
    var rb = stream_ring_new()
    rb = stream_ring_push(rb, 42)
    let val = stream_ring_peek(rb)
    val == 42
}

fn test_stream_state_lifecycle() -> bool {
    var s = async_stream_state_new()
    let not_ready = !async_stream_is_ready(s)
    s = async_stream_complete(s, 99)
    let is_ready = async_stream_is_ready(s)
    not_ready && is_ready && async_stream_get_value(s) == 99
}
