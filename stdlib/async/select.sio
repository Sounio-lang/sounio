// async/select.sio — Cooperative scheduling primitives for select
// Sounio async model: cooperative, fixed-size, no heap

struct AsyncSelectState {
    ready: bool,
    value: i64,
    tag: i64,
}

fn async_select_state_new() -> AsyncSelectState {
    AsyncSelectState { ready: false, value: 0, tag: 0 }
}

fn async_select_is_ready(s: AsyncSelectState) -> bool {
    s.ready
}

fn async_select_complete(s: AsyncSelectState, val: i64) -> AsyncSelectState {
    AsyncSelectState { ready: true, value: val, tag: s.tag }
}

fn async_select_get_value(s: AsyncSelectState) -> i64 {
    s.value
}

struct SelectRingBuffer {
    data: [i64; 64],
    head: i32,
    tail: i32,
    count: i32,
}

fn select_ring_new() -> SelectRingBuffer {
    SelectRingBuffer { data: [0; 64], head: 0, tail: 0, count: 0 }
}

fn select_ring_push(rb: SelectRingBuffer, val: i64) -> SelectRingBuffer with Mut, Div, Panic {
    if rb.count >= 64 { return rb }
    var result = rb
    result.data[result.tail] = val
    result.tail = (result.tail + 1) % 64
    result.count = result.count + 1
    result
}

fn select_ring_pop(rb: SelectRingBuffer) -> SelectRingBuffer with Mut, Div, Panic {
    if rb.count <= 0 { return rb }
    var result = rb
    result.head = (result.head + 1) % 64
    result.count = result.count - 1
    result
}

fn select_ring_peek(rb: SelectRingBuffer) -> i64 {
    if rb.count <= 0 { return 0 }
    rb.data[rb.head]
}

fn select_ring_is_empty(rb: SelectRingBuffer) -> bool {
    rb.count <= 0
}

fn test_select_ring_basic() -> bool with Mut, Div, Panic {
    var rb = select_ring_new()
    rb = select_ring_push(rb, 42)
    let val = select_ring_peek(rb)
    val == 42
}

fn test_select_state_lifecycle() -> bool {
    var s = async_select_state_new()
    let not_ready = !async_select_is_ready(s)
    s = async_select_complete(s, 99)
    let is_ready = async_select_is_ready(s)
    not_ready && is_ready && async_select_get_value(s) == 99
}
