// stdlib/async/lib.sio — Module entry point


// Submodules are resolved by path (`use async::<name>`);
// Sounio has no `mod` item, so the declarations that stood here were
// inert Rust syntax that also stopped this file parsing. Covered:
//   future, task, executor

// Cooperative typed polling, cancellation and explicit task reaping.
pub use async::poll_executor::{
    PollStep, PollExecutor, PollTask, poll_executor_new,
    poll_executor_pending, poll_executor_spawn, poll_executor_result, poll_executor_cancel,
    poll_executor_tick, poll_executor_close, poll_executor_reap, poll_executor_task_count,
}
