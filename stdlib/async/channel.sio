// async/channel.sio — Cooperative scheduling primitives for channel
// Sounio async model: cooperative, fixed-size, no heap

struct AsyncChannelState {
    ready: bool,
    value: i64,
    tag: i64,
}

fn async_channel_state_new() -> AsyncChannelState {
    AsyncChannelState { ready: false, value: 0, tag: 0 }
}

fn async_channel_is_ready(s: AsyncChannelState) -> bool {
    s.ready
}

fn async_channel_complete(s: AsyncChannelState, val: i64) -> AsyncChannelState {
    AsyncChannelState { ready: true, value: val, tag: s.tag }
}

fn async_channel_get_value(s: AsyncChannelState) -> i64 {
    s.value
}

struct ChannelRingBuffer {
    data: [i64; 64],
    head: i32,
    tail: i32,
    count: i32,
}

fn channel_ring_new() -> ChannelRingBuffer {
    ChannelRingBuffer { data: [0; 64], head: 0, tail: 0, count: 0 }
}

fn channel_ring_push(rb: ChannelRingBuffer, val: i64) -> ChannelRingBuffer with Mut, Div, Panic {
    if rb.count >= 64 { return rb }
    var result = rb
    result.data[result.tail] = val
    result.tail = (result.tail + 1) % 64
    result.count = result.count + 1
    result
}

fn channel_ring_pop(rb: ChannelRingBuffer) -> ChannelRingBuffer with Mut, Div, Panic {
    if rb.count <= 0 { return rb }
    var result = rb
    result.head = (result.head + 1) % 64
    result.count = result.count - 1
    result
}

fn channel_ring_peek(rb: ChannelRingBuffer) -> i64 {
    if rb.count <= 0 { return 0 }
    rb.data[rb.head]
}

fn channel_ring_is_empty(rb: ChannelRingBuffer) -> bool {
    rb.count <= 0
}

fn test_channel_ring_basic() -> bool with Mut, Div, Panic {
    var rb = channel_ring_new()
    rb = channel_ring_push(rb, 42)
    let val = channel_ring_peek(rb)
    val == 42
}

fn test_channel_state_lifecycle() -> bool {
    var s = async_channel_state_new()
    let not_ready = !async_channel_is_ready(s)
    s = async_channel_complete(s, 99)
    let is_ready = async_channel_is_ready(s)
    not_ready && is_ready && async_channel_get_value(s) == 99
}
