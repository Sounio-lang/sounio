// async/time.sio — Cooperative scheduling primitives for time
// Sounio async model: cooperative, fixed-size, no heap

struct AsyncTimeState {
    ready: bool,
    value: i64,
    tag: i64,
}

fn async_time_state_new() -> AsyncTimeState {
    AsyncTimeState { ready: false, value: 0, tag: 0 }
}

fn async_time_is_ready(s: AsyncTimeState) -> bool {
    s.ready
}

fn async_time_complete(s: AsyncTimeState, val: i64) -> AsyncTimeState {
    AsyncTimeState { ready: true, value: val, tag: s.tag }
}

fn async_time_get_value(s: AsyncTimeState) -> i64 {
    s.value
}

struct TimeRingBuffer {
    data: [i64; 64],
    head: i32,
    tail: i32,
    count: i32,
}

fn time_ring_new() -> TimeRingBuffer {
    TimeRingBuffer { data: [0; 64], head: 0, tail: 0, count: 0 }
}

fn time_ring_push(rb: TimeRingBuffer, val: i64) -> TimeRingBuffer with Mut, Div, Panic {
    if rb.count >= 64 { return rb }
    var result = rb
    result.data[result.tail] = val
    result.tail = (result.tail + 1) % 64
    result.count = result.count + 1
    result
}

fn time_ring_pop(rb: TimeRingBuffer) -> TimeRingBuffer with Mut, Div, Panic {
    if rb.count <= 0 { return rb }
    var result = rb
    result.head = (result.head + 1) % 64
    result.count = result.count - 1
    result
}

fn time_ring_peek(rb: TimeRingBuffer) -> i64 {
    if rb.count <= 0 { return 0 }
    rb.data[rb.head]
}

fn time_ring_is_empty(rb: TimeRingBuffer) -> bool {
    rb.count <= 0
}

fn test_time_ring_basic() -> bool with Mut, Div, Panic {
    var rb = time_ring_new()
    rb = time_ring_push(rb, 42)
    let val = time_ring_peek(rb)
    val == 42
}

fn test_time_state_lifecycle() -> bool {
    var s = async_time_state_new()
    let not_ready = !async_time_is_ready(s)
    s = async_time_complete(s, 99)
    let is_ready = async_time_is_ready(s)
    not_ready && is_ready && async_time_get_value(s) == 99
}
