// async/io.sio — Cooperative scheduling primitives for io
// Sounio async model: cooperative, fixed-size, no heap

struct AsyncIoState {
    ready: bool,
    value: i64,
    tag: i64,
}

fn async_io_state_new() -> AsyncIoState {
    AsyncIoState { ready: false, value: 0, tag: 0 }
}

fn async_io_is_ready(s: AsyncIoState) -> bool {
    s.ready
}

fn async_io_complete(s: AsyncIoState, val: i64) -> AsyncIoState {
    AsyncIoState { ready: true, value: val, tag: s.tag }
}

fn async_io_get_value(s: AsyncIoState) -> i64 {
    s.value
}

struct IoRingBuffer {
    data: [i64; 64],
    head: i32,
    tail: i32,
    count: i32,
}

fn io_ring_new() -> IoRingBuffer {
    IoRingBuffer { data: [0; 64], head: 0, tail: 0, count: 0 }
}

fn io_ring_push(rb: IoRingBuffer, val: i64) -> IoRingBuffer with Mut, Div, Panic {
    if rb.count >= 64 { return rb }
    var result = rb
    result.data[result.tail] = val
    result.tail = (result.tail + 1) % 64
    result.count = result.count + 1
    result
}

fn io_ring_pop(rb: IoRingBuffer) -> IoRingBuffer with Mut, Div, Panic {
    if rb.count <= 0 { return rb }
    var result = rb
    result.head = (result.head + 1) % 64
    result.count = result.count - 1
    result
}

fn io_ring_peek(rb: IoRingBuffer) -> i64 {
    if rb.count <= 0 { return 0 }
    rb.data[rb.head]
}

fn io_ring_is_empty(rb: IoRingBuffer) -> bool {
    rb.count <= 0
}

fn test_io_ring_basic() -> bool with Mut, Div, Panic {
    var rb = io_ring_new()
    rb = io_ring_push(rb, 42)
    let val = io_ring_peek(rb)
    val == 42
}

fn test_io_state_lifecycle() -> bool {
    var s = async_io_state_new()
    let not_ready = !async_io_is_ready(s)
    s = async_io_complete(s, 99)
    let is_ready = async_io_is_ready(s)
    not_ready && is_ready && async_io_get_value(s) == 99
}
