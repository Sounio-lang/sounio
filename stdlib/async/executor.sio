// stdlib/async/executor — Simple cooperative task executor
//
// Executor: runs tasks from a queue in round-robin order.

pub struct Executor {
    task_ids: [i64; 256],
    task_status: [i64; 256],
    task_result: [i64; 256],
    count: i64,
    completed: i64,
}

let EXEC_PENDING: i64 = 0
let EXEC_COMPLETED: i64 = 2

impl Executor {
    fn new() -> Executor {
        Executor {
            task_ids: [0; 256],
            task_status: [0; 256],
            task_result: [0; 256],
            count: 0,
            completed: 0,
        }
    }

    fn spawn(self: &! Executor, task_id: i64) {
        if self.count >= 256 { return }
        let i = self.count
        self.task_ids[i] = task_id
        self.task_status[i] = EXEC_PENDING
        self.task_result[i] = 0
        self.count = self.count + 1
    }

    fn complete_task(self: &! Executor, idx: i64, result: i64) {
        if idx >= 0 && idx < self.count {
            self.task_status[idx] = EXEC_COMPLETED
            self.task_result[idx] = result
            self.completed = self.completed + 1
        }
    }

    fn all_done(self: &Executor) -> bool {
        self.completed >= self.count
    }

    fn pending_count(self: &Executor) -> i64 {
        self.count - self.completed
    }

    fn task_count(self: &Executor) -> i64 {
        self.count
    }
}

pub fn executor_new() -> Executor {
    Executor {
        task_ids: [0; 256],
        task_status: [0; 256],
        task_result: [0; 256],
        count: 0,
        completed: 0,
    }
}

pub fn executor_spawn(ex: &! Executor, task_id: i64) {
    if ex.count >= 256 { return }
    let i = ex.count
    ex.task_ids[i] = task_id
    ex.task_status[i] = EXEC_PENDING
    ex.task_result[i] = 0
    ex.count = ex.count + 1
}

pub fn executor_complete_task(ex: &! Executor, idx: i64, result: i64) {
    if idx >= 0 && idx < ex.count {
        ex.task_status[idx] = EXEC_COMPLETED
        ex.task_result[idx] = result
        ex.completed = ex.completed + 1
    }
}

pub fn executor_all_done(ex: &! Executor) -> bool {
    ex.completed >= ex.count
}

pub fn executor_pending_count(ex: &! Executor) -> i64 {
    ex.count - ex.completed
}

pub fn executor_task_count(ex: &! Executor) -> i64 {
    ex.count
}
