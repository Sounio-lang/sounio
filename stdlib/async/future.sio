// stdlib/async/future — Poll result and future state
//
// PollResult: represents the state of an async computation.
// tag 0 = Pending, 1 = Ready with value.

pub struct PollResult {
    tag: i64,
    val: i64,
}

pub fn poll_pending() -> PollResult {
    PollResult { tag: 0, val: 0 }
}

pub fn poll_ready(v: i64) -> PollResult {
    PollResult { tag: 1, val: v }
}

pub fn poll_is_ready(p: &PollResult) -> bool {
    p.tag == 1
}

pub fn poll_is_pending(p: &PollResult) -> bool {
    p.tag == 0
}

pub fn poll_value(p: &PollResult) -> i64 {
    p.val
}
