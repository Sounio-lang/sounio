// async/net.sio — Cooperative scheduling primitives for net
// Sounio async model: cooperative, fixed-size, no heap

struct AsyncNetState {
    ready: bool,
    value: i64,
    tag: i64,
}

fn async_net_state_new() -> AsyncNetState {
    AsyncNetState { ready: false, value: 0, tag: 0 }
}

fn async_net_is_ready(s: AsyncNetState) -> bool {
    s.ready
}

fn async_net_complete(s: AsyncNetState, val: i64) -> AsyncNetState {
    AsyncNetState { ready: true, value: val, tag: s.tag }
}

fn async_net_get_value(s: AsyncNetState) -> i64 {
    s.value
}

struct NetRingBuffer {
    data: [i64; 64],
    head: i32,
    tail: i32,
    count: i32,
}

fn net_ring_new() -> NetRingBuffer {
    NetRingBuffer { data: [0; 64], head: 0, tail: 0, count: 0 }
}

fn net_ring_push(rb: NetRingBuffer, val: i64) -> NetRingBuffer with Mut, Div, Panic {
    if rb.count >= 64 { return rb }
    var result = rb
    result.data[result.tail] = val
    result.tail = (result.tail + 1) % 64
    result.count = result.count + 1
    result
}

fn net_ring_pop(rb: NetRingBuffer) -> NetRingBuffer with Mut, Div, Panic {
    if rb.count <= 0 { return rb }
    var result = rb
    result.head = (result.head + 1) % 64
    result.count = result.count - 1
    result
}

fn net_ring_peek(rb: NetRingBuffer) -> i64 {
    if rb.count <= 0 { return 0 }
    rb.data[rb.head]
}

fn net_ring_is_empty(rb: NetRingBuffer) -> bool {
    rb.count <= 0
}

fn test_net_ring_basic() -> bool with Mut, Div, Panic {
    var rb = net_ring_new()
    rb = net_ring_push(rb, 42)
    let val = net_ring_peek(rb)
    val == 42
}

fn test_net_state_lifecycle() -> bool {
    var s = async_net_state_new()
    let not_ready = !async_net_is_ready(s)
    s = async_net_complete(s, 99)
    let is_ready = async_net_is_ready(s)
    not_ready && is_ready && async_net_get_value(s) == 99
}
