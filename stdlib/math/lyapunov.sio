// stdlib/math/lyapunov.sio — Largest Lyapunov exponent for 1-D maps (A-layer-2 substrate)
//
// The largest Lyapunov exponent λ of a 1-D map x_{n+1} = f(x_n) is
//     λ = lim_{N→∞} (1/N) Σ_{n=0}^{N-1} ln |f'(x_n)|.
// λ > 0 ⇒ sensitive dependence (chaos): a perturbation grows ~ e^{λn}. This is exactly
// the amplification Feature A-layer-2 must budget for before permitting an f64
// reassociation on a chaotic integration path. The values here are DERIVED (computed),
// not retrofitted, and are checked against closed forms in tests/run-pass/lyapunov_*.
//
// NOTE (epistemic flag, per the design): using a Lyapunov exponent as a compiler
// optimisation parameter is a CLAIM TO VERIFY, not an established practice. This module
// provides the measurable substrate; the gate that consumes it is Feature A-layer-2.
//
// Self-contained (private ln) so it runs through the multimodule path with only public
// cross-module calls.

fn lyap_ln2() -> f64 { 0.6931471805599453 }

fn lyap_ln(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 - 1.0e30 }
    if x == 1.0 { return 0.0 }
    var m = x
    var e_val = 0
    while m >= 2.0 { m = m / 2.0; e_val = e_val + 1 }
    while m < 0.5 { m = m * 2.0; e_val = e_val - 1 }
    let t = (m - 1.0) / (m + 1.0)
    let t2 = t * t
    var sum = t
    var term = t
    var k = 1
    while k < 30 {
        term = term * t2
        let denom = (2 * k + 1) as f64
        sum = sum + term / denom
        k = k + 1
    }
    2.0 * sum + (e_val as f64) * lyap_ln2()
}

fn lyap_abs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

// Largest Lyapunov exponent of the logistic map f(x) = r·x·(1-x), f'(x) = r·(1-2x).
// Warmup discards the transient; the average of ln|f'| over the attractor estimates λ.
// Closed forms for validation: r = 4 ⇒ λ = ln 2 (conjugate to the tent map); a periodic
// window (e.g. r = 3.2) ⇒ λ < 0.
pub fn lyap_logistic(r: f64) -> f64 with Mut, Div, Panic {
    var x = 0.4
    var w = 0
    while w < 2000 { x = r * x * (1.0 - x); w = w + 1 }
    var s = 0.0
    var cnt = 0
    var n = 0
    while n < 200000 {
        x = r * x * (1.0 - x)
        let d = lyap_abs(r * (1.0 - 2.0 * x))
        if d > 1.0e-12 { s = s + lyap_ln(d); cnt = cnt + 1 }
        n = n + 1
    }
    if cnt == 0 { return 0.0 }
    s / (cnt as f64)
}

// Tent map f(x) = μ·min(x, 1-x): |f'| = μ everywhere, so λ = ln μ exactly.
pub fn lyap_tent(mu: f64) -> f64 with Mut, Div, Panic {
    if mu <= 0.0 { return 0.0 - 1.0e30 }
    lyap_ln(mu)
}

// A system is (numerically) chaotic when its largest Lyapunov exponent is positive.
pub fn lyap_is_chaotic(lambda: f64) -> bool { lambda > 0.0 }
