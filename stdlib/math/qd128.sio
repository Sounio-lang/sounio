// stdlib/math/qd128.sio — quad-double (~212-bit) arithmetic (finite domain)
//
// Madaros native-v2: constructor-only import lives in math::qd128_core
// (tests/run-pass/qd128_core_import_native_v2_smoke.sio). This full module
// still fails closed on qd_mul emission (rc=12) — see
// docs/handoff/BLK-20260804-p0b-qd128-native-v2.md.
//
// Representation: x = x0 + x1 + x2 + x3, with x0 most significant and
// canonical non-overlap target |x_{i+1}| <= 0.5 ulp(x_i).
//
// This module follows Hida, Li, Bailey (ARITH-15, 2001), using:
// - renormalisation variant of Priest (Algorithm 9),
// - accurate addition via merge + Double-Accumulate (Algorithms 13/14),
// - 13-term multiplication accumulation boxes (Three/Six-Three/Nine-Two/Nine-One),
// - long division (5-term quotient expansion),
// - inverse-sqrt Newton for sqrt.
//
// Honest caveat (paper's own statement): necessary conditions for Algorithm 9
// to always succeed are not known; Priest proves sufficiency for <=51 overlap
// bits. We rely on the same assumption as the qd literature for expansions
// generated by these operators.
//
// Scope discipline for W1: finite-domain only. Non-finite inputs (NaN/Inf) are
// caller responsibility; this module does not branch on NaN payload semantics.
// (lean_single's comparisons are NaN-unsound anyway: x != x is inert here.)
//
// EFT reuse: two_sum / quick_two_sum / two_prod and the Dd64 helpers are
// imported from math::dd64 (the exact Knuth/Dekker kernels already witnessed
// bit-exactly by tests/stdlib/math/test_dd64_eft_exact.sio).

use math::dd64::*

pub struct Qd128 {
    pub x0: f64,
    pub x1: f64,
    pub x2: f64,
    pub x3: f64,
}

struct QdAcc3 {
    s: f64,
    u: f64,
    v: f64,
}

struct QdTriple {
    r0: f64,
    r1: f64,
    r2: f64,
}

struct QdPair {
    r0: f64,
    r1: f64,
}

fn qd_mag(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

pub fn qd_zero() -> Qd128 {
    Qd128 { x0: 0.0, x1: 0.0, x2: 0.0, x3: 0.0 }
}

pub fn qd_from_f64(a: f64) -> Qd128 {
    Qd128 { x0: a, x1: 0.0, x2: 0.0, x3: 0.0 }
}

pub fn qd_from_dd(a: Dd64) -> Qd128 with Mut {
    qd_renorm4(a.hi, a.lo, 0.0, 0.0)
}

pub fn qd_to_dd(a: Qd128) -> Dd64 {
    let s0 = quick_two_sum(a.x0, a.x1)
    let s1 = quick_two_sum(s0.hi, s0.lo + a.x2)
    quick_two_sum(s1.hi, s1.lo + a.x3)
}

pub fn qd_to_f64(a: Qd128) -> f64 {
    ((a.x0 + a.x1) + a.x2) + a.x3
}

// Algorithm 9 (5-term): bottom-up Quick-Two-Sum chain + unrolled top-down pass.
pub fn qd_renorm5(a0: f64, a1: f64, a2: f64, a3: f64, a4: f64) -> Qd128 with Mut {
    let s4 = quick_two_sum(a3, a4)
    let s3 = quick_two_sum(a2, s4.hi)
    let s2 = quick_two_sum(a1, s3.hi)
    let s1 = quick_two_sum(a0, s2.hi)

    var s = s1.hi
    var b0 = 0.0
    var b1 = 0.0
    var b2 = 0.0
    var b3 = 0.0
    var k = 0

    let t1 = s1.lo
    let t2 = s2.lo
    let t3 = s3.lo
    let t4 = s4.lo

    let r1 = quick_two_sum(s, t1)
    s = r1.hi
    if r1.lo != 0.0 {
        if k == 0 { b0 = s } else {
            if k == 1 { b1 = s } else {
                if k == 2 { b2 = s } else { b3 = s }
            }
        }
        s = r1.lo
        k = k + 1
    }

    let r2 = quick_two_sum(s, t2)
    s = r2.hi
    if r2.lo != 0.0 {
        if k == 0 { b0 = s } else {
            if k == 1 { b1 = s } else {
                if k == 2 { b2 = s } else { b3 = s }
            }
        }
        s = r2.lo
        k = k + 1
    }

    let r3 = quick_two_sum(s, t3)
    s = r3.hi
    if r3.lo != 0.0 {
        if k == 0 { b0 = s } else {
            if k == 1 { b1 = s } else {
                if k == 2 { b2 = s } else { b3 = s }
            }
        }
        s = r3.lo
        k = k + 1
    }

    let r4 = quick_two_sum(s, t4)
    s = r4.hi
    if r4.lo != 0.0 {
        if k == 0 { b0 = s } else {
            if k == 1 { b1 = s } else {
                if k == 2 { b2 = s } else { b3 = s }
            }
        }
        s = r4.lo
        k = k + 1
    }

    // Final residual: only stored if fewer than four components were emitted.
    // When k == 4 the residual is BELOW the 4-component precision and must be
    // discarded (storing it would overwrite b3 with an O(eps^4) term).
    if k < 4 {
        if k == 0 { b0 = s } else {
            if k == 1 { b1 = s } else {
                if k == 2 { b2 = s } else { b3 = s }
            }
        }
    }

    Qd128 { x0: b0, x1: b1, x2: b2, x3: b3 }
}

pub fn qd_renorm4(a0: f64, a1: f64, a2: f64, a3: f64) -> Qd128 with Mut {
    qd_renorm5(a0, a1, a2, a3, 0.0)
}

pub fn qd_add_f64(a: Qd128, b: f64) -> Qd128 with Mut {
    let s0 = two_sum(a.x0, b)
    let s1 = two_sum(a.x1, s0.lo)
    let s2 = two_sum(a.x2, s1.lo)
    let s3 = two_sum(a.x3, s2.lo)
    qd_renorm5(s0.hi, s1.hi, s2.hi, s3.hi, s3.lo)
}

fn qd_double_accumulate(u: f64, v: f64, x: f64) -> QdAcc3 with Mut {
    let s0 = two_sum(v, x)
    let s1 = two_sum(u, s0.hi)
    var s = s1.hi
    var uu = s1.lo
    var vv = s0.lo
    if uu == 0.0 {
        uu = s
        s = 0.0
    }
    if vv == 0.0 {
        vv = uu
        uu = s
        s = 0.0
    }
    QdAcc3 { s: s, u: uu, v: vv }
}

fn qd_components_sorted8(a: Qd128, b: Qd128) -> [f64; 8] with Mut, Panic {
    var x: [f64; 8] = [0.0; 8]
    x[0] = a.x0
    x[1] = a.x1
    x[2] = a.x2
    x[3] = a.x3
    x[4] = b.x0
    x[5] = b.x1
    x[6] = b.x2
    x[7] = b.x3

    // Deterministic insertion sort by descending magnitude.
    var i = 1
    while i < 8 {
        let key = x[i]
        let akey = qd_mag(key)
        var j = i
        while j > 0 {
            if qd_mag(x[j - 1]) >= akey { break }
            x[j] = x[j - 1]
            j = j - 1
        }
        x[j] = key
        i = i + 1
    }
    x
}

// QD-Add-Accurate (HLB Algorithm 14): merge the 8 components by decreasing
// magnitude, then Double-Accumulate (Algorithm 13) until 4 are emitted.
// We deliberately choose the ACCURATE scheme over the faster Cray-style
// variant: the future EISA v2 err lane requires the IEEE-style bound
// fl(a+b) = (1+d)(a+b), |d| <= 2*eps_qd, plus cross-executor determinism —
// the sorted merge makes the accumulation order input-canonical.
pub fn qd_add(a: Qd128, b: Qd128) -> Qd128 with Mut, Panic {
    let x = qd_components_sorted8(a, b)
    var u = 0.0
    var v = 0.0
    var c0 = 0.0
    var c1 = 0.0
    var c2 = 0.0
    var c3 = 0.0
    var k = 0
    var i = 0
    while k < 4 && i < 8 {
        let da = qd_double_accumulate(u, v, x[i])
        u = da.u
        v = da.v
        if da.s != 0.0 {
            if k == 0 { c0 = da.s } else {
                if k == 1 { c1 = da.s } else {
                    if k == 2 { c2 = da.s } else { c3 = da.s }
                }
            }
            k = k + 1
        }
        i = i + 1
    }
    // The `!= 0.0` guards match the emission rule inside the loop above.
    // Without them a residue of the shape (u, v) = (0.0, eps) spends the last
    // of the four output slots on the zero and then silently drops eps, which
    // is a REAL loss: u + v is the exact unemitted remainder. Witnessed at
    // 1.05e-49 relative (6.9e14 qd ulps) on qd_add(2u, u*u) inside qd_exp,
    // and covered by tests/stdlib/math/test_qd128_transcendental.sio.
    if k < 4 && u != 0.0 {
        if k == 0 { c0 = u } else {
            if k == 1 { c1 = u } else {
                if k == 2 { c2 = u } else { c3 = u }
            }
        }
        k = k + 1
    }
    if k < 4 && v != 0.0 {
        if k == 0 { c0 = v } else {
            if k == 1 { c1 = v } else {
                if k == 2 { c2 = v } else { c3 = v }
            }
        }
    }
    qd_renorm4(c0, c1, c2, c3)
}

pub fn qd_neg(a: Qd128) -> Qd128 {
    Qd128 { x0: 0.0 - a.x0, x1: 0.0 - a.x1, x2: 0.0 - a.x2, x3: 0.0 - a.x3 }
}

pub fn qd_sub(a: Qd128, b: Qd128) -> Qd128 with Mut, Panic {
    qd_add(a, qd_neg(b))
}

pub fn qd_mul_f64(a: Qd128, b: f64) -> Qd128 with Mut, Panic {
    let p0 = two_prod(a.x0, b)
    let p1 = two_prod(a.x1, b)
    let p2 = two_prod(a.x2, b)
    let p3 = a.x3 * b

    // HLB §3.4.1: first three terms with Two-Prod, a3*b in plain f64.
    var r = qd_zero()
    r = qd_add_f64(r, p0.hi)
    r = qd_add_f64(r, p0.lo)
    r = qd_add_f64(r, p1.hi)
    r = qd_add_f64(r, p1.lo)
    r = qd_add_f64(r, p2.hi)
    r = qd_add_f64(r, p2.lo)
    qd_add_f64(r, p3)
}

fn qd_three_sum(a: f64, b: f64, c: f64) -> QdTriple {
    let s0 = two_sum(a, b)
    let s1 = two_sum(c, s0.hi)
    let s2 = two_sum(s0.lo, s1.lo)
    QdTriple { r0: s1.hi, r1: s2.hi, r2: s2.lo }
}

fn qd_six_three_sum(a0: f64, a1: f64, a2: f64, b0: f64, b1: f64, b2: f64) -> QdTriple with Mut, Panic {
    let t0 = qd_three_sum(a0, a1, a2)
    let t1 = qd_three_sum(b0, b1, b2)
    var acc = qd_zero()
    acc = qd_add_f64(acc, t0.r0)
    acc = qd_add_f64(acc, t0.r1)
    acc = qd_add_f64(acc, t0.r2)
    acc = qd_add_f64(acc, t1.r0)
    acc = qd_add_f64(acc, t1.r1)
    acc = qd_add_f64(acc, t1.r2)
    QdTriple { r0: acc.x0, r1: acc.x1, r2: acc.x2 }
}

// Pack nine f64s into one array arg: Madaros native-v2 rejects IrCall with
// 9+ float scalar args from *imported* module bodies (main-unit calls work;
// ≤8 float scalars also work). Array-by-value keeps the HLB nine-sum shape.
fn qd_nine_two_sum(xs: [f64; 9]) -> QdPair with Panic {
    let d0 = dd_add(two_sum(xs[0], xs[1]), two_sum(xs[2], xs[3]))
    let d1 = dd_add(two_sum(xs[4], xs[5]), two_sum(xs[6], xs[7]))
    let d2 = dd_add(d0, d1)
    let d3 = dd_add_f64(d2, xs[8])
    QdPair { r0: d3.hi, r1: d3.lo }
}

fn qd_nine_one_sum(xs: [f64; 9]) -> f64 with Panic {
    ((((((((xs[0] + xs[1]) + xs[2]) + xs[3]) + xs[4]) + xs[5]) + xs[6]) + xs[7]) + xs[8])
}

pub fn qd_mul(a: Qd128, b: Qd128) -> Qd128 with Mut, Panic {
    // 13-term HLB scheme: i+j<=3 via Two-Prod, O(eps^4) terms as plain f64.
    let p00 = two_prod(a.x0, b.x0)
    let p01 = two_prod(a.x0, b.x1)
    let p10 = two_prod(a.x1, b.x0)
    let p02 = two_prod(a.x0, b.x2)
    let p11 = two_prod(a.x1, b.x1)
    let p20 = two_prod(a.x2, b.x0)
    let p03 = two_prod(a.x0, b.x3)
    let p12 = two_prod(a.x1, b.x2)
    let p21 = two_prod(a.x2, b.x1)
    let p30 = two_prod(a.x3, b.x0)

    let o4_0 = a.x1 * b.x3
    let o4_1 = a.x2 * b.x2
    let o4_2 = a.x3 * b.x1

    let e1 = qd_three_sum(p01.hi, p10.hi, p00.lo)
    let e2 = qd_six_three_sum(p02.hi, p11.hi, p20.hi, p01.lo, p10.lo, 0.0)
    let e3_in: [f64; 9] = [p03.hi, p12.hi, p21.hi, p30.hi, p02.lo, p11.lo, p20.lo, 0.0, 0.0]
    let e4_in: [f64; 9] = [p03.lo, p12.lo, p21.lo, p30.lo, o4_0, o4_1, o4_2, 0.0, 0.0]
    let e3 = qd_nine_two_sum(e3_in)
    let e4 = qd_nine_one_sum(e4_in)

    var r = qd_zero()
    r = qd_add_f64(r, p00.hi)
    r = qd_add_f64(r, e1.r0)
    r = qd_add_f64(r, e1.r1)
    r = qd_add_f64(r, e1.r2)
    r = qd_add_f64(r, e2.r0)
    r = qd_add_f64(r, e2.r1)
    r = qd_add_f64(r, e2.r2)
    r = qd_add_f64(r, e3.r0)
    r = qd_add_f64(r, e3.r1)
    qd_add_f64(r, e4)
}

// Long division (HLB §3.5): q_i = r_i[0]/b0 with full qd remainder updates
// (full multiply-subtract is required — most bits cancel at q3/q4), then a
// 5-term renormalisation of (q0..q4).
pub fn qd_div(a: Qd128, b: Qd128) -> Qd128 with Mut, Div, Panic {
    let q0 = a.x0 / b.x0
    let r0 = qd_sub(a, qd_mul_f64(b, q0))
    let q1 = r0.x0 / b.x0
    let r1 = qd_sub(r0, qd_mul_f64(b, q1))
    let q2 = r1.x0 / b.x0
    let r2 = qd_sub(r1, qd_mul_f64(b, q2))
    let q3 = r2.x0 / b.x0
    let r3 = qd_sub(r2, qd_mul_f64(b, q3))
    let q4 = r3.x0 / b.x0
    qd_renorm5(q0, q1, q2, q3, q4)
}

fn qd128_sqrt_f64(x: f64) -> f64 with Mut, Div {
    if x <= 0.0 { return 0.0 }
    var g = x
    if g > 1.0 { g = x * 0.5 } else { g = 1.0 }
    var i = 0
    while i < 40 {
        g = 0.5 * (g + x / g)
        i = i + 1
    }
    g
}

// sqrt via division-free Newton on f(x) = 1/x^2 - a (HLB §4.2):
//   x_{k+1} = x_k + x_k*(1 - a*x_k^2)/2, three iterations from the f64 seed
// (same self-contained Newton seed style as dd64's dd64_sqrt_f64), then
// sqrt(a) = a*x. a == 0 returns qd zero; a < 0 also returns qd zero —
// this module is finite-domain and W1 explicitly does not signal NaN
// (lean_single's NaN-unsound comparisons would make x != x inert anyway);
// rejecting negative inputs is the CALLER's responsibility.
pub fn qd_sqrt(a: Qd128) -> Qd128 with Mut, Div, Panic {
    if a.x0 == 0.0 { return qd_zero() }
    if a.x0 < 0.0 {
        return qd_zero()
    }

    let seed = qd128_sqrt_f64(a.x0)
    var x = qd_from_f64(1.0 / seed)
    var i = 0
    while i < 3 {
        let x2 = qd_mul(x, x)
        let ax2 = qd_mul(a, x2)
        let one_minus = qd_sub(qd_from_f64(1.0), ax2)
        let corr = qd_mul_f64(qd_mul(x, one_minus), 0.5)
        x = qd_add(x, corr)
        i = i + 1
    }
    qd_mul(a, x)
}

pub fn qd_abs(a: Qd128) -> Qd128 {
    if a.x0 < 0.0 { qd_neg(a) } else {
        if a.x0 == 0.0 && a.x1 < 0.0 { qd_neg(a) } else { a }
    }
}

pub fn qd_cmp(a: Qd128, b: Qd128) -> i64 {
    if a.x0 < b.x0 { return 0 - 1 }
    if a.x0 > b.x0 { return 1 }
    if a.x1 < b.x1 { return 0 - 1 }
    if a.x1 > b.x1 { return 1 }
    if a.x2 < b.x2 { return 0 - 1 }
    if a.x2 > b.x2 { return 1 }
    if a.x3 < b.x3 { return 0 - 1 }
    if a.x3 > b.x3 { return 1 }
    0
}

pub fn qd_eq(a: Qd128, b: Qd128) -> bool {
    a.x0 == b.x0 && a.x1 == b.x1 && a.x2 == b.x2 && a.x3 == b.x3
}

pub fn qd_lt(a: Qd128, b: Qd128) -> bool {
    qd_cmp(a, b) < 0
}

// =============================================================================
// Transcendentals — exp / log / pow / log10 (finite domain)
// =============================================================================
//
// Reference: Hida, Li & Bailey (2001) §5 (the qd library's exp/log), i.e.
// k*ln2 + r reduction with a Taylor core for exp, and Newton on exp for log.
//
// Same scope discipline as qd_sqrt above: this module is finite-domain and
// deliberately does not signal NaN (lean_single's comparisons are NaN-unsound,
// so x != x is inert here). Out-of-domain inputs return qd zero, and rejecting
// them is the CALLER's responsibility:
//   qd_log(a),   a.x0 <= 0.0                    -> qd_zero()
//   qd_log10(a), a.x0 <= 0.0                    -> qd_zero()
//   qd_pow(a,b), a.x0 <= 0.0, b non-integral    -> qd_zero()
// Overflow/underflow of exp is NOT trapped either: the 2^k scaling is a plain
// f64 multiply, so |x| past the binary64 exponent range degrades the way
// binary64 does. Callers that need a decision must range-check first.
//
// Two ACCURACY CAVEATS that are properties of the quad-double format, not of
// these routines, and that the corpus in tests/vectors/qd128_transcendental
// measures rather than hides:
//
// 1. Denormal tail. A Qd128 needs ~159 bits of exponent room BELOW its leading
//    limb to carry all 212 bits. For |result| < 2^-916 (~1e-276) the low limbs
//    fall into the binary64 subnormals and the format itself can only hold
//    about (1074 - |log2 result|) bits. exp(-700) = 2^-1010 therefore carries
//    ~64 bits, not 212 — measured 6.8e43 qd ulps, which is ~1 ulp of what the
//    format can actually represent there.
//
// 2. log near 1. qd_log carries ABSOLUTE quad-double accuracy in y = log(a):
//    the Newton residual a*exp(-y) - 1 is formed near 1, so for a -> 1 the
//    relative accuracy of the (tiny) result degrades exactly like log() vs
//    log1p() in binary64. There is no qd_log1p here; do not use qd_log when
//    |a - 1| << 1 and you need relative accuracy.

// Exact limb reconstruction: m * 2^e, |m| < 2^53, no subnormal intermediate.
//
// This exists because souc's decimal literal parser is NOT correctly rounded:
// writing the low limbs of ln2 as decimal literals lands 1-3 ulp off, which
// silently caps every constant-driven result at double-double (~1e-32) accuracy
// instead of quad-double. i64 -> f64 conversion is exact for |m| < 2^53 and the
// halving/doubling chain is exact, so this route is parser-independent.
fn qd_limb(m: i64, e: i64) -> f64 with Mut {
    var r = m as f64
    var n = e
    while n < 0 {
        r = r * 0.5
        n = n + 1
    }
    while n > 0 {
        r = r * 2.0
        n = n - 1
    }
    r
}

// ln 2 and ln 10 as non-overlapping 4-limb expansions.
//
// Produced with mpmath (greedy nearest-f64 limb split, each limb then decomposed
// with math.frexp into an exact m * 2^e). These limbs are constants of this
// module: they are NOT emitted by the corpus generator in
// tests/vectors/qd128_transcendental/gen/, which builds test vectors only.
//
// Re-verified 2026-09-02 against mpmath at mp.prec = 600. Residual of the
// 4-limb sum minus the reference, relative:
//     ln2   +1.9507685e-66
//     ln10  -8.3771042e-66
// i.e. ~0.013 and ~0.055 of the quad-double ulp 2^-212 = 1.5192908e-64.
pub fn qd_ln2() -> Qd128 with Mut {
    Qd128 {
        x0: qd_limb(6243314768165359, 0 - 53),
        x1: qd_limb(7525737178955839, 0 - 108),
        x2: qd_limb(6673460182522164, 0 - 163),
        x3: qd_limb(0 - 7545482916914641, 0 - 217)
    }
}

pub fn qd_ln10() -> Qd128 with Mut {
    Qd128 {
        x0: qd_limb(5184960683398422, 0 - 51),
        x1: qd_limb(0 - 8805633374462953, 0 - 105),
        x2: qd_limb(0 - 7296007962371596, 0 - 159),
        x3: qd_limb(0 - 5296362421624049, 0 - 213)
    }
}

// Cody-Waite split of ln2. ln2_hi keeps only 42 mantissa bits, so k * ln2_hi is
// EXACT in binary64 for |k| <= 2048 — which covers the whole binary64 range of
// exp (|k| <= 1075). Without this split the reduction x - k*ln2 inherits the
// quad-double representation error of k*ln2, i.e. |k*ln2| * 2^-212, which shows
// up as ~|x|/ln2 ulps of relative error in the result (measured 19 ulps at
// x = 500 before the split, 0.15 ulps after).
fn qd_ln2_hi() -> f64 with Mut {
    qd_limb(6243314768164864, 0 - 53)
}

// ln2 - ln2_hi ~ 5.4979e-14, to 4 limbs (residual 1.36e-80 relative to ln2).
fn qd_ln2_lo() -> Qd128 with Mut {
    Qd128 {
        x0: qd_limb(8711806768342832, 0 - 97),
        x1: qd_limb(8892529970223641, 0 - 155),
        x2: qd_limb(7259400309188660, 0 - 210),
        x3: qd_limb(6574579891448808, 0 - 264)
    }
}

// 2^k as an exact f64 for |k| <= 1023; outside that the binary64 exponent range
// decides (overflow to inf, or gradual underflow through the subnormals).
fn qd_pow2_f64(k: i64) -> f64 with Mut {
    var n = k
    var step = 2.0
    if n < 0 {
        n = 0 - n
        step = 0.5
    }
    var r = 1.0
    var i = 0
    while i < n {
        r = r * step
        i = i + 1
    }
    r
}

// Limb-wise scaling by an exact power of two. qd_mul_f64 cannot be used for
// this at the top of the exponent range: its two_prod does a Veltkamp split
// (a * (2^27 + 1)), which overflows to inf for |a| > ~2^996, so exp(709) came
// back NaN. Multiplying each limb by a power of two is exact anyway, so this
// is both safer and cheaper than routing through the EFT.
fn qd_scale_pow2(a: Qd128, s: f64) -> Qd128 {
    Qd128 { x0: a.x0 * s, x1: a.x1 * s, x2: a.x2 * s, x3: a.x3 * s }
}

// Round-half-away-from-zero: `as i64` truncates toward zero on this backend.
fn qd_round_f64(x: f64) -> i64 {
    if x < 0.0 { (x - 0.5) as i64 } else { (x + 0.5) as i64 }
}

// floor(log2(|x|)) for finite nonzero x, by exact power-of-two scaling.
fn qd_ilog2_f64(x: f64) -> i64 with Mut {
    var m = qd_mag(x)
    var e = 0
    while m >= 2.0 {
        m = m * 0.5
        e = e + 1
    }
    while m < 1.0 {
        m = m * 2.0
        e = e - 1
    }
    e
}

// exp via HLB §5 reduction: x = k*ln2 + r with |r| <= ln2/2, then w = r/64 so
// that |w| <= 5.42e-3.
//
// The Taylor core accumulates expm1(w) rather than exp(w), so the leading 1
// never absorbs the series; the six doublings then use the cancellation-free
// identity expm1(2w) = expm1(w) * (2 + expm1(w)). Its derivative ratio
// (2+2u)/(2+u) is ~1, so the unrolling is relative-error neutral instead of the
// ~2x-per-squaring amplification of squaring exp(w) directly. Term 25 of the
// series is ~1e-79, far under the 1.53e-64 quad-double ulp.
pub fn qd_exp(a: Qd128) -> Qd128 with Mut, Div, Panic {
    if a.x0 == 0.0 { return qd_from_f64(1.0) }

    let k = qd_round_f64(qd_to_f64(a) / 0.6931471805599453)
    let kf = k as f64
    // kf * ln2_hi is exact, so qd_add_f64 here is an exact two_sum chain and
    // the cancellation of the leading digits costs nothing.
    var r = qd_add_f64(a, 0.0 - kf * qd_ln2_hi())
    r = qd_sub(r, qd_mul_f64(qd_ln2_lo(), kf))

    // Exact: 1/64 is a power of two, so every limb scales without rounding.
    let w = qd_mul_f64(r, 0.015625)

    var term = w
    var u = w
    var i = 2
    while i <= 25 {
        term = qd_div(qd_mul(term, w), qd_from_f64(i as f64))
        u = qd_add(u, term)
        i = i + 1
    }

    var j = 0
    while j < 6 {
        u = qd_mul(u, qd_add_f64(u, 2.0))
        j = j + 1
    }

    let er = qd_add_f64(u, 1.0)
    qd_scale_pow2(er, qd_pow2_f64(k))
}

// Self-contained f64 log seed (no libm dependency, matching the style of
// qd128_sqrt_f64 / dd64_sqrt_f64): x = m*2^e with m in [1,2), then
// log(m) = 2*atanh((m-1)/(m+1)) with |z| <= 1/3, so z^59 <= 1e-28.
fn qd128_log_f64(x: f64) -> f64 with Mut, Div {
    if x <= 0.0 { return 0.0 }
    var m = x
    var e = 0
    while m >= 2.0 {
        m = m * 0.5
        e = e + 1
    }
    while m < 1.0 {
        m = m * 2.0
        e = e - 1
    }
    let z = (m - 1.0) / (m + 1.0)
    let z2 = z * z
    var term = z
    var sum = z
    var i = 1
    while i < 30 {
        term = term * z2
        sum = sum + term / ((2 * i + 1) as f64)
        i = i + 1
    }
    2.0 * sum + (e as f64) * 0.6931471805599453
}

// log via Newton on exp (HLB §5): y_{n+1} = y_n + m*exp(-y_n) - 1, seeded from
// the f64 log. Quadratic: 1e-16 -> 5e-33 -> 1.3e-65, so three iterations clear
// the 212-bit target.
//
// The argument is first scaled to m in [1,2) by EXACT powers of two and the
// e*ln2 term added back afterwards. Running Newton on the raw argument instead
// would evaluate exp(-y) at, for a = 1e300, y ~ 690 — i.e. at 1e-300, where the
// low limbs are subnormal and the residual only carries ~77 bits. That measured
// 6.6e36 qd ulps; scaling first brings the same case to 0.16 ulps.
pub fn qd_log(a: Qd128) -> Qd128 with Mut, Div, Panic {
    if a.x0 <= 0.0 { return qd_zero() }
    if a.x0 == 1.0 && a.x1 == 0.0 && a.x2 == 0.0 && a.x3 == 0.0 { return qd_zero() }

    let e = qd_ilog2_f64(a.x0)
    // Split the scaling in two so that 2^(-e) itself never overflows for a
    // subnormal leading limb (|e| can reach 1074).
    let e1 = e / 2
    let e2 = e - e1
    var m = qd_scale_pow2(a, qd_pow2_f64(0 - e1))
    m = qd_scale_pow2(m, qd_pow2_f64(0 - e2))

    var y = qd_from_f64(qd128_log_f64(qd_to_f64(m)))
    var i = 0
    while i < 3 {
        let corr = qd_sub(qd_mul(m, qd_exp(qd_neg(y))), qd_from_f64(1.0))
        y = qd_add(y, corr)
        i = i + 1
    }

    // Cody-Waite again: (e as f64) * ln2_hi is exact for |e| <= 2048.
    let ef = e as f64
    let t = qd_add(y, qd_mul_f64(qd_ln2_lo(), ef))
    qd_add_f64(t, ef * qd_ln2_hi())
}

// Binary exponentiation: an exact integer exponent must NOT go through the
// log/exp round trip (that loses the bits log() cannot recover near a = 1, and
// throws away negative bases entirely).
pub fn qd_powi(a: Qd128, n: i64) -> Qd128 with Mut, Div, Panic {
    if n == 0 { return qd_from_f64(1.0) }
    var e = n
    if e < 0 { e = 0 - e }
    var base = a
    var acc = qd_from_f64(1.0)
    while e > 0 {
        if e % 2 == 1 {
            acc = qd_mul(acc, base)
        }
        e = e / 2
        // Guarded: squaring past the last needed power would overflow a large
        // base to inf and poison acc on the final multiply.
        if e > 0 {
            base = qd_mul(base, base)
        }
    }
    if n < 0 {
        return qd_div(qd_from_f64(1.0), acc)
    }
    acc
}

pub fn qd_pow(a: Qd128, b: Qd128) -> Qd128 with Mut, Div, Panic {
    if b.x1 == 0.0 && b.x2 == 0.0 && b.x3 == 0.0 {
        if qd_mag(b.x0) <= 1.0e15 {
            let n = b.x0 as i64
            if (n as f64) == b.x0 {
                return qd_powi(a, n)
            }
        }
    }
    if a.x0 <= 0.0 { return qd_zero() }
    qd_exp(qd_mul(b, qd_log(a)))
}

pub fn qd_log10(a: Qd128) -> Qd128 with Mut, Div, Panic {
    if a.x0 <= 0.0 { return qd_zero() }
    qd_div(qd_log(a), qd_ln10())
}
