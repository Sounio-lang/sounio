// Shared compensated artanh branch of canonical log1p_checked_into.
// This scalar kernel is valid on [-0.5,0.5]; no result record or allocator.
// Tiny increments (including signed zero/subnormals) are returned unchanged.
use math::pure::{is_finite}
fn scalar_log_nan()->f64 {let inf=1.0e308*10.0;inf-inf}
fn scalar_log_abs(x:f64)->f64 {if x<0.0 {-x}else{x}}
pub fn log1p_small_scalar(x:f64)->f64 with Mut,Div {
 if !is_finite(x) || x< -0.5 || x>0.5 {return scalar_log_nan()}
 if scalar_log_abs(x)<1.0e-16 {return x}
 let t=x/(2.0+x)
 let square=t*t
 var term=t
 var sum=t
 var correction:f64=0.0
 var k:i64=1
 while k<32 {
  term=term*square
  let contribution=term/((2*k+1) as f64)
  let adjusted=contribution-correction
  let next=sum+adjusted
  correction=(next-sum)-adjusted
  sum=next
  k=k+1
 }
 2.0*sum
}
