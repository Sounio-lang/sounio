// stdlib/math/interpolation.sio — Interpolation methods
//
// Pure Sounio implementations:
//   Barycentric Lagrange interpolation (O(n) evaluation after O(n) setup)
//   Newton divided differences
//   Hermite interpolation (values + derivatives)
//   PCHIP (Piecewise Cubic Hermite Interpolating Polynomial) — shape preserving
//   Rational interpolation (Stoer-Bulirsch)
//   Linear interpolation (1D)
//
// References:
//   Berrut & Trefethen (2004): "Barycentric Lagrange Interpolation" SIAM Review
//   Fritsch & Carlson (1980): "Monotone Piecewise Cubic Interpolation"
//   Stoer & Bulirsch (2002): "Introduction to Numerical Analysis"
//   de Boor (2001): "A Practical Guide to Splines"

// =============================================================================
// Helpers
// =============================================================================

fn ip_abs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }
fn ip_sign(x: f64) -> f64 { if x > 0.0 { 1.0 } else if x < 0.0 { 0.0 - 1.0 } else { 0.0 } }
fn ip_min(a: f64, b: f64) -> f64 { if a < b { a } else { b } }
fn ip_max(a: f64, b: f64) -> f64 { if a > b { a } else { b } }

// =============================================================================
// Linear interpolation
// =============================================================================

// 1D linear interpolation: given sorted x[0..n-1] and y[0..n-1], evaluate at t.
// Uses binary search to find the enclosing interval.
fn interp_linear(x: &[f64; 256], y: &[f64; 256], n: i32, t: f64) -> f64 with Mut, Div {
    // Clamp to domain
    if t <= x[0] { return y[0] }
    if t >= x[n - 1] { return y[n - 1] }

    // Binary search
    var lo = 0
    var hi = n - 1
    while hi - lo > 1 {
        let mid = (lo + hi) / 2
        if x[mid] > t { hi = mid } else { lo = mid }
    }

    let h = x[hi] - x[lo]
    if ip_abs(h) < 1.0e-30 { return y[lo] }
    let alpha = (t - x[lo]) / h
    y[lo] + alpha * (y[hi] - y[lo])
}

// =============================================================================
// Barycentric Lagrange interpolation
// =============================================================================

// Compute barycentric weights for nodes x[0..n-1].
// w[i] = 1 / prod_{j != i} (x[i] - x[j])
fn bary_weights(x: &[f64; 256], n: i32, w: &![f64; 256]) with Mut, Div {
    var i = 0
    while i < n {
        w[i] = 1.0
        var j = 0
        while j < n {
            if j != i {
                w[i] = w[i] / (x[i] - x[j])
            }
            j = j + 1
        }
        i = i + 1
    }
}

// Evaluate barycentric interpolant at t.
// x, y: data points; w: barycentric weights; n: count.
// Uses the second (stable) form of the barycentric formula:
//   p(t) = (sum w[i]*y[i]/(t-x[i])) / (sum w[i]/(t-x[i]))
fn bary_eval(x: &[f64; 256], y: &[f64; 256], w: &[f64; 256],
             n: i32, t: f64) -> f64 with Mut, Div {
    // Check if t coincides with a node
    var i = 0
    while i < n {
        if ip_abs(t - x[i]) < 1.0e-15 { return y[i] }
        i = i + 1
    }

    var numer = 0.0
    var denom = 0.0
    i = 0
    while i < n {
        let term = w[i] / (t - x[i])
        numer = numer + term * y[i]
        denom = denom + term
        i = i + 1
    }
    numer / denom
}

// =============================================================================
// Newton divided differences
// =============================================================================

// Compute Newton divided difference coefficients c[0..n-1].
// After this, p(t) = c[0] + c[1]*(t-x[0]) + c[2]*(t-x[0])*(t-x[1]) + ...
fn newton_coeffs(x: &[f64; 256], y: &[f64; 256], n: i32,
                 c: &![f64; 256]) with Mut, Div {
    // Initialize c = y
    var i = 0
    while i < n { c[i] = y[i]; i = i + 1 }

    // Build divided difference table in-place
    var j = 1
    while j < n {
        i = n - 1
        while i >= j {
            c[i] = (c[i] - c[i - 1]) / (x[i] - x[i - j])
            i = i - 1
        }
        j = j + 1
    }
}

// Evaluate Newton interpolant via Horner-like nesting.
fn newton_eval(x: &[f64; 256], c: &[f64; 256], n: i32, t: f64) -> f64 with Mut, Div {
    var result = c[n - 1]
    var i = n - 2
    while i >= 0 {
        result = result * (t - x[i]) + c[i]
        i = i - 1
    }
    result
}

// =============================================================================
// Hermite interpolation
// =============================================================================

// Hermite interpolation using values y[i] and derivatives dy[i] at nodes x[i].
// Returns the value of the 2n-1 degree polynomial at t.
fn hermite_interp(x: &[f64; 128], y: &[f64; 128], dy: &[f64; 128],
                  n: i32, t: f64) -> f64 with Mut, Div {
    // Build divided difference table for doubled nodes
    var z: [f64; 256] = [0.0; 256]
    var q: [f64; 256] = [0.0; 256]

    var i = 0
    while i < n {
        z[2 * i] = x[i]
        z[2 * i + 1] = x[i]
        q[2 * i] = y[i]
        q[2 * i + 1] = y[i]
        i = i + 1
    }

    // First divided differences
    let nn = 2 * n
    // For coincident nodes, use derivative
    i = 0
    while i < n {
        q[2 * i + 1] = dy[i]  // f[x_i, x_i] = f'(x_i)
        i = i + 1
    }
    // Non-coincident first divided differences
    i = nn - 1
    while i >= 2 {
        if ip_abs(z[i] - z[i - 1]) > 1.0e-30 {
            // Already have q[i] = f[x_i], now compute f[x_{i-1}, x_i]
        }
        i = i - 1
    }

    // Actually, let's use the standard Hermite approach via
    // Newton's form on doubled nodes.
    // Re-initialize properly
    var dd: [f64; 256] = [0.0; 256]
    i = 0
    while i < nn { dd[i] = q[i]; i = i + 1 }

    // First divided differences
    i = 1
    while i < nn {
        if ip_abs(z[i] - z[i - 1]) < 1.0e-30 {
            // Coincident: use derivative
            dd[i] = dy[i / 2]
        } else {
            dd[i] = (dd[i] - dd[i - 1]) / (z[i] - z[i - 1])
        }
        i = i + 1
    }

    // Higher order divided differences
    var j = 2
    while j < nn {
        i = nn - 1
        while i >= j {
            dd[i] = (dd[i] - dd[i - 1]) / (z[i] - z[i - j])
            i = i - 1
        }
        j = j + 1
    }

    // Evaluate via nested form
    var result = dd[nn - 1]
    i = nn - 2
    while i >= 0 {
        result = result * (t - z[i]) + dd[i]
        i = i - 1
    }
    result
}

// =============================================================================
// PCHIP — Piecewise Cubic Hermite Interpolating Polynomial
// =============================================================================

// Compute PCHIP slopes d[0..n-1] from data (x, y).
// Ensures monotonicity preservation: if data is locally monotone, so is the interpolant.
// Uses Fritsch-Carlson (1980) algorithm.
fn pchip_slopes(x: &[f64; 256], y: &[f64; 256], n: i32,
                d: &![f64; 256]) with Mut, Div, Panic {
    if n < 2 { d[0] = 0.0; return }
    if n == 2 {
        let s = (y[1] - y[0]) / (x[1] - x[0])
        d[0] = s
        d[1] = s
        return
    }

    // Compute secant slopes
    var delta: [f64; 256] = [0.0; 256]
    var i = 0
    while i < n - 1 {
        delta[i] = (y[i + 1] - y[i]) / (x[i + 1] - x[i])
        i = i + 1
    }

    // Interior slopes via Fritsch-Carlson
    i = 1
    while i < n - 1 {
        if delta[i - 1] * delta[i] <= 0.0 {
            // Local extremum: zero slope
            d[i] = 0.0
        } else {
            // Weighted harmonic mean
            let h1 = x[i] - x[i - 1]
            let h2 = x[i + 1] - x[i]
            let w1 = 2.0 * h2 + h1
            let w2 = h2 + 2.0 * h1
            d[i] = (w1 + w2) / (w1 / delta[i - 1] + w2 / delta[i])
        }
        i = i + 1
    }

    // Endpoint slopes: one-sided shape-preserving
    // Left endpoint
    d[0] = ((2.0 * (x[1] - x[0]) + (x[2] - x[1])) * delta[0] - (x[1] - x[0]) * delta[1]) / (x[2] - x[0])
    if ip_sign(d[0]) != ip_sign(delta[0]) {
        d[0] = 0.0
    } else if ip_sign(delta[0]) != ip_sign(delta[1]) && ip_abs(d[0]) > ip_abs(3.0 * delta[0]) {
        d[0] = 3.0 * delta[0]
    }

    // Right endpoint
    let nm1 = n - 1
    let nm2 = n - 2
    let nm3 = n - 3
    d[nm1] = ((2.0 * (x[nm1] - x[nm2]) + (x[nm2] - x[nm3])) * delta[nm2] - (x[nm1] - x[nm2]) * delta[nm3]) / (x[nm1] - x[nm3])
    if ip_sign(d[nm1]) != ip_sign(delta[nm2]) {
        d[nm1] = 0.0
    } else if ip_sign(delta[nm2]) != ip_sign(delta[nm3]) && ip_abs(d[nm1]) > ip_abs(3.0 * delta[nm2]) {
        d[nm1] = 3.0 * delta[nm2]
    }
}

// Evaluate PCHIP interpolant at t.
fn pchip_eval(x: &[f64; 256], y: &[f64; 256], d: &[f64; 256],
              n: i32, t: f64) -> f64 with Mut, Div {
    // Clamp
    if t <= x[0] { return y[0] }
    if t >= x[n - 1] { return y[n - 1] }

    // Binary search
    var lo = 0
    var hi = n - 1
    while hi - lo > 1 {
        let mid = (lo + hi) / 2
        if x[mid] > t { hi = mid } else { lo = mid }
    }

    let h = x[hi] - x[lo]
    let s = (t - x[lo]) / h
    let s2 = s * s
    let s3 = s2 * s

    // Hermite basis functions
    let h00 = 2.0 * s3 - 3.0 * s2 + 1.0
    let h10 = s3 - 2.0 * s2 + s
    let h01 = 0.0 - 2.0 * s3 + 3.0 * s2
    let h11 = s3 - s2

    h00 * y[lo] + h10 * h * d[lo] + h01 * y[hi] + h11 * h * d[hi]
}

// =============================================================================
// Rational interpolation (Stoer-Bulirsch)
// =============================================================================

// Rational interpolation through (x[i], y[i]) evaluated at t.
// Returns value in out[0], error estimate in out[1].
// Based on the diagonal rational interpolation algorithm of
// Stoer & Bulirsch via the Neville-like scheme.
fn rational_interp(x: &[f64; 64], y: &[f64; 64], n: i32, t: f64,
                   out: &![f64; 2]) with Mut, Div, Panic {
    let tiny = 1.0e-25

    var c: [f64; 64] = [0.0; 64]
    var d: [f64; 64] = [0.0; 64]

    // Find closest point to t
    var ns = 0
    var min_dist = ip_abs(t - x[0])
    var i = 0
    while i < n {
        let dist = ip_abs(t - x[i])
        if dist == 0.0 {
            out[0] = y[i]
            out[1] = 0.0
            return
        }
        if dist < min_dist { min_dist = dist; ns = i }
        c[i] = y[i]
        d[i] = y[i] + tiny  // small perturbation to avoid 0/0
        i = i + 1
    }

    out[0] = y[ns]
    ns = ns - 1

    var m = 1
    while m < n {
        i = 0
        while i < n - m {
            let w = c[i + 1] - d[i]
            let h_val = t - x[i + m]
            let t_val = (t - x[i]) * d[i] / h_val
            let dd = t_val - c[i + 1]
            if ip_abs(dd) < 1.0e-30 {
                // Pole: return current estimate
                out[1] = 1.0e30
                return
            }
            let dd2 = w / dd
            d[i] = c[i + 1] * dd2
            c[i] = t_val * dd2
            i = i + 1
        }

        if 2 * (ns + 1) < n - m {
            out[1] = c[ns + 1]
        } else {
            out[1] = d[ns]
            ns = ns - 1
        }
        out[0] = out[0] + out[1]
        m = m + 1
    }
}

// =============================================================================
// Cubic spline interpolation (natural boundary conditions)
// =============================================================================

// Compute natural cubic spline second derivatives s[0..n-1].
// Natural BC: s[0] = s[n-1] = 0.
fn spline_natural(x: &[f64; 256], y: &[f64; 256], n: i32,
                  s: &![f64; 256]) with Mut, Div, Panic {
    if n < 3 { s[0] = 0.0; if n > 1 { s[1] = 0.0 } return }

    // Tridiagonal system
    var a: [f64; 256] = [0.0; 256]  // sub-diagonal
    var b: [f64; 256] = [0.0; 256]  // diagonal
    var c: [f64; 256] = [0.0; 256]  // super-diagonal
    var r: [f64; 256] = [0.0; 256]  // RHS

    s[0] = 0.0
    s[n - 1] = 0.0

    var i = 1
    while i < n - 1 {
        let h0 = x[i] - x[i - 1]
        let h1 = x[i + 1] - x[i]
        a[i] = h0
        b[i] = 2.0 * (h0 + h1)
        c[i] = h1
        r[i] = 6.0 * ((y[i + 1] - y[i]) / h1 - (y[i] - y[i - 1]) / h0)
        i = i + 1
    }

    // Thomas algorithm (tridiagonal solver)
    i = 2
    while i < n - 1 {
        let m = a[i] / b[i - 1]
        b[i] = b[i] - m * c[i - 1]
        r[i] = r[i] - m * r[i - 1]
        i = i + 1
    }

    // Back substitution
    s[n - 2] = r[n - 2] / b[n - 2]
    i = n - 3
    while i >= 1 {
        s[i] = (r[i] - c[i] * s[i + 1]) / b[i]
        i = i - 1
    }
}

// Evaluate cubic spline at t.
fn spline_eval(x: &[f64; 256], y: &[f64; 256], s: &[f64; 256],
               n: i32, t: f64) -> f64 with Mut, Div {
    if t <= x[0] { return y[0] }
    if t >= x[n - 1] { return y[n - 1] }

    // Binary search
    var lo = 0
    var hi = n - 1
    while hi - lo > 1 {
        let mid = (lo + hi) / 2
        if x[mid] > t { hi = mid } else { lo = mid }
    }

    let h = x[hi] - x[lo]
    let a_val = (x[hi] - t) / h
    let b_val = (t - x[lo]) / h

    a_val * y[lo] + b_val * y[hi]
    + ((a_val * a_val * a_val - a_val) * s[lo] + (b_val * b_val * b_val - b_val) * s[hi]) * h * h / 6.0
}
