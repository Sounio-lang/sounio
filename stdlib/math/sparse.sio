// stdlib/math/sparse.sio — Sparse matrix operations
//
// Pure Sounio implementations using Compressed Sparse Row (CSR) format:
//   CSR construction and access
//   Sparse matrix-vector multiply (SpMV)
//   Sparse matrix-matrix multiply (SpGEMM)
//   Sparse triangular solve (forward/backward substitution)
//   Sparse transpose
//   Jacobi and Gauss-Seidel iterative solvers
//   Sparse matrix-dense matrix multiply
//   Diagonal extraction, trace
//
// CSR format stores three arrays:
//   values[nnz]   — non-zero values in row-major order
//   col_idx[nnz]  — column index for each value
//   row_ptr[n+1]  — row_ptr[i] = index into values/col_idx of first entry in row i
//                    row_ptr[n] = nnz
//
// Max dimensions: 256 x 256, max nnz: 4096.
//
// References:
//   Saad (2003): "Iterative Methods for Sparse Linear Systems" 2nd ed.
//   Davis (2006): "Direct Methods for Sparse Linear Systems"
//   Barrett et al. (1994): "Templates for the Solution of Linear Systems"

// =============================================================================
// CSR Struct
// =============================================================================

struct CSR {
    values: [f64; 4096],
    col_idx: [i32; 4096],
    row_ptr: [i32; 257],
    nrows: i32,
    ncols: i32,
    nnz: i32
}

// =============================================================================
// Helpers
// =============================================================================

fn sp_abs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }
fn sp_max(a: f64, b: f64) -> f64 { if a > b { a } else { b } }

fn sp_sqrt(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 30 { y = 0.5 * (y + x / y); i = i + 1 }
    y
}

// =============================================================================
// CSR construction
// =============================================================================

// Create an empty CSR matrix with given dimensions.
fn csr_new(nrows: i32, ncols: i32) -> CSR {
    var m: CSR = CSR {
        values: [0.0; 4096],
        col_idx: [0; 4096],
        row_ptr: [0; 257],
        nrows: nrows,
        ncols: ncols,
        nnz: 0
    }
    m
}

// Build CSR from coordinate (COO) format.
// rows[k], cols[k], vals[k] specify the k-th non-zero entry.
// Entries must be sorted by row (and within each row, by column).
fn csr_from_coo(rows: &[i32; 4096], cols: &[i32; 4096], vals: &[f64; 4096],
                nnz: i32, nrows: i32, ncols: i32) -> CSR with Mut {
    var m = csr_new(nrows, ncols)
    m.nnz = nnz

    // Copy values and column indices
    var k = 0
    while k < nnz {
        m.values[k] = vals[k]
        m.col_idx[k] = cols[k]
        k = k + 1
    }

    // Build row_ptr
    var i = 0
    while i <= nrows { m.row_ptr[i] = 0; i = i + 1 }

    // Count entries per row
    k = 0
    while k < nnz {
        m.row_ptr[rows[k] + 1] = m.row_ptr[rows[k] + 1] + 1
        k = k + 1
    }

    // Cumulative sum
    i = 1
    while i <= nrows {
        m.row_ptr[i] = m.row_ptr[i] + m.row_ptr[i - 1]
        i = i + 1
    }

    m
}

// Build CSR from a dense matrix (row-major, entries with |a| < tol are dropped).
fn csr_from_dense(dense: &[f64; 4096], nrows: i32, ncols: i32, tol: f64) -> CSR with Mut {
    var m = csr_new(nrows, ncols)
    var nnz = 0

    var i = 0
    while i < nrows {
        m.row_ptr[i] = nnz
        var j = 0
        while j < ncols {
            let val = dense[i * ncols + j]
            if sp_abs(val) > tol {
                m.values[nnz] = val
                m.col_idx[nnz] = j
                nnz = nnz + 1
            }
            j = j + 1
        }
        i = i + 1
    }
    m.row_ptr[nrows] = nnz
    m.nnz = nnz
    m
}

// =============================================================================
// CSR element access
// =============================================================================

// Get element (i, j) from CSR. Returns 0 if not found.
fn csr_get(m: &CSR, i: i32, j: i32) -> f64 with Mut {
    var k = m.row_ptr[i]
    while k < m.row_ptr[i + 1] {
        if m.col_idx[k] == j { return m.values[k] }
        if m.col_idx[k] > j { return 0.0 }  // past it (sorted)
        k = k + 1
    }
    0.0
}

// =============================================================================
// SpMV: y = A * x
// =============================================================================

fn csr_matvec(a: &CSR, x: &[f64; 256], y: &![f64; 256]) with Mut {
    var i = 0
    while i < a.nrows {
        var sum = 0.0
        var k = a.row_ptr[i]
        while k < a.row_ptr[i + 1] {
            sum = sum + a.values[k] * x[a.col_idx[k]]
            k = k + 1
        }
        y[i] = sum
        i = i + 1
    }
}

// SpMV with transpose: y = A^T * x
fn csr_matvec_t(a: &CSR, x: &[f64; 256], y: &![f64; 256]) with Mut {
    // Zero output
    var j = 0
    while j < a.ncols { y[j] = 0.0; j = j + 1 }

    var i = 0
    while i < a.nrows {
        var k = a.row_ptr[i]
        while k < a.row_ptr[i + 1] {
            y[a.col_idx[k]] = y[a.col_idx[k]] + a.values[k] * x[i]
            k = k + 1
        }
        i = i + 1
    }
}

// =============================================================================
// Sparse matrix addition: C = A + B
// =============================================================================

fn csr_add(a: &CSR, b: &CSR, c: &!CSR) with Mut {
    c.nrows = a.nrows
    c.ncols = a.ncols
    var nnz = 0

    var i = 0
    while i < a.nrows {
        c.row_ptr[i] = nnz
        var ka = a.row_ptr[i]
        var kb = b.row_ptr[i]

        while ka < a.row_ptr[i + 1] && kb < b.row_ptr[i + 1] {
            if a.col_idx[ka] < b.col_idx[kb] {
                c.values[nnz] = a.values[ka]
                c.col_idx[nnz] = a.col_idx[ka]
                nnz = nnz + 1
                ka = ka + 1
            } else if a.col_idx[ka] > b.col_idx[kb] {
                c.values[nnz] = b.values[kb]
                c.col_idx[nnz] = b.col_idx[kb]
                nnz = nnz + 1
                kb = kb + 1
            } else {
                let sum = a.values[ka] + b.values[kb]
                if sp_abs(sum) > 1.0e-15 {
                    c.values[nnz] = sum
                    c.col_idx[nnz] = a.col_idx[ka]
                    nnz = nnz + 1
                }
                ka = ka + 1
                kb = kb + 1
            }
        }

        // Remaining from A
        while ka < a.row_ptr[i + 1] {
            c.values[nnz] = a.values[ka]
            c.col_idx[nnz] = a.col_idx[ka]
            nnz = nnz + 1
            ka = ka + 1
        }

        // Remaining from B
        while kb < b.row_ptr[i + 1] {
            c.values[nnz] = b.values[kb]
            c.col_idx[nnz] = b.col_idx[kb]
            nnz = nnz + 1
            kb = kb + 1
        }

        i = i + 1
    }
    c.row_ptr[a.nrows] = nnz
    c.nnz = nnz
}

// =============================================================================
// Sparse matrix scaling: A *= alpha
// =============================================================================

fn csr_scale(a: &!CSR, alpha: f64) with Mut {
    var k = 0
    while k < a.nnz { a.values[k] = alpha * a.values[k]; k = k + 1 }
}

// =============================================================================
// Sparse transpose: B = A^T
// =============================================================================

fn csr_transpose(a: &CSR, b: &!CSR) with Mut {
    b.nrows = a.ncols
    b.ncols = a.nrows
    b.nnz = a.nnz

    // Count entries per column of A (= per row of A^T)
    var col_count: [i32; 257] = [0; 257]
    var k = 0
    while k < a.nnz {
        col_count[a.col_idx[k] + 1] = col_count[a.col_idx[k] + 1] + 1
        k = k + 1
    }

    // Cumulative sum for row_ptr of B
    b.row_ptr[0] = 0
    var j = 1
    while j <= a.ncols {
        b.row_ptr[j] = b.row_ptr[j - 1] + col_count[j]
        j = j + 1
    }

    // Fill values using running counters
    var pos: [i32; 257] = [0; 257]
    j = 0
    while j < a.ncols { pos[j] = b.row_ptr[j]; j = j + 1 }

    var i = 0
    while i < a.nrows {
        k = a.row_ptr[i]
        while k < a.row_ptr[i + 1] {
            let col = a.col_idx[k]
            let dest = pos[col]
            b.values[dest] = a.values[k]
            b.col_idx[dest] = i
            pos[col] = pos[col] + 1
            k = k + 1
        }
        i = i + 1
    }
}

// =============================================================================
// Sparse triangular solve: solve L*x = b (lower triangular)
// =============================================================================

// Forward substitution for sparse lower triangular L.
fn csr_solve_lower(l: &CSR, b: &[f64; 256], x: &![f64; 256]) with Mut, Div, Panic {
    var i = 0
    while i < l.nrows {
        var sum = b[i]
        var diag = 1.0
        var k = l.row_ptr[i]
        while k < l.row_ptr[i + 1] {
            let j = l.col_idx[k]
            if j < i {
                sum = sum - l.values[k] * x[j]
            } else if j == i {
                diag = l.values[k]
            }
            k = k + 1
        }
        x[i] = sum / diag
        i = i + 1
    }
}

// Backward substitution for sparse upper triangular U.
fn csr_solve_upper(u: &CSR, b: &[f64; 256], x: &![f64; 256]) with Mut, Div, Panic {
    var i = u.nrows - 1
    while i >= 0 {
        var sum = b[i]
        var diag = 1.0
        var k = u.row_ptr[i]
        while k < u.row_ptr[i + 1] {
            let j = u.col_idx[k]
            if j > i {
                sum = sum - u.values[k] * x[j]
            } else if j == i {
                diag = u.values[k]
            }
            k = k + 1
        }
        x[i] = sum / diag
        i = i - 1
    }
}

// =============================================================================
// Jacobi iterative solver: solve A*x = b
// =============================================================================

// Jacobi iteration: x_{k+1}[i] = (b[i] - sum_{j!=i} a[i,j]*x_k[j]) / a[i,i]
// Returns the number of iterations used.
fn csr_jacobi(a: &CSR, b: &[f64; 256], x: &![f64; 256],
              max_iter: i32, tol: f64) -> i32 with Mut, Div, Panic {
    var x_new: [f64; 256] = [0.0; 256]

    var iter = 0
    while iter < max_iter {
        var i = 0
        while i < a.nrows {
            var sum = b[i]
            var diag = 1.0
            var k = a.row_ptr[i]
            while k < a.row_ptr[i + 1] {
                let j = a.col_idx[k]
                if j != i {
                    sum = sum - a.values[k] * x[j]
                } else {
                    diag = a.values[k]
                }
                k = k + 1
            }
            x_new[i] = sum / diag
            i = i + 1
        }

        // Check convergence: ||x_new - x|| < tol
        var max_diff = 0.0
        i = 0
        while i < a.nrows {
            let diff = sp_abs(x_new[i] - x[i])
            if diff > max_diff { max_diff = diff }
            x[i] = x_new[i]
            i = i + 1
        }

        if max_diff < tol { return iter + 1 }
        iter = iter + 1
    }
    max_iter
}

// =============================================================================
// Gauss-Seidel iterative solver
// =============================================================================

// Gauss-Seidel: like Jacobi but uses updated values immediately.
fn csr_gauss_seidel(a: &CSR, b: &[f64; 256], x: &![f64; 256],
                    max_iter: i32, tol: f64) -> i32 with Mut, Div, Panic {
    var iter = 0
    while iter < max_iter {
        var max_diff = 0.0
        var i = 0
        while i < a.nrows {
            var sum = b[i]
            var diag = 1.0
            var k = a.row_ptr[i]
            while k < a.row_ptr[i + 1] {
                let j = a.col_idx[k]
                if j != i {
                    sum = sum - a.values[k] * x[j]  // x already has updated earlier rows
                } else {
                    diag = a.values[k]
                }
                k = k + 1
            }
            let new_val = sum / diag
            let diff = sp_abs(new_val - x[i])
            if diff > max_diff { max_diff = diff }
            x[i] = new_val
            i = i + 1
        }

        if max_diff < tol { return iter + 1 }
        iter = iter + 1
    }
    max_iter
}

// =============================================================================
// Diagonal extraction and trace
// =============================================================================

fn csr_diagonal(a: &CSR, diag: &![f64; 256]) with Mut {
    var i = 0
    while i < a.nrows {
        diag[i] = 0.0
        var k = a.row_ptr[i]
        while k < a.row_ptr[i + 1] {
            if a.col_idx[k] == i { diag[i] = a.values[k] }
            k = k + 1
        }
        i = i + 1
    }
}

fn csr_trace(a: &CSR) -> f64 with Mut {
    var tr = 0.0
    var i = 0
    while i < a.nrows {
        var k = a.row_ptr[i]
        while k < a.row_ptr[i + 1] {
            if a.col_idx[k] == i { tr = tr + a.values[k] }
            k = k + 1
        }
        i = i + 1
    }
    tr
}

// =============================================================================
// Frobenius norm
// =============================================================================

fn csr_frobenius(a: &CSR) -> f64 with Mut, Div, Panic {
    var sum = 0.0
    var k = 0
    while k < a.nnz { sum = sum + a.values[k] * a.values[k]; k = k + 1 }
    sp_sqrt(sum)
}

// =============================================================================
// Number of non-zeros per row (for load balancing diagnostics)
// =============================================================================

fn csr_nnz_per_row(a: &CSR, counts: &![i32; 256]) with Mut {
    var i = 0
    while i < a.nrows {
        counts[i] = a.row_ptr[i + 1] - a.row_ptr[i]
        i = i + 1
    }
}

// =============================================================================
// CSR to dense conversion
// =============================================================================

fn csr_to_dense(a: &CSR, dense: &![f64; 4096]) with Mut {
    // Zero out
    var idx = 0
    while idx < a.nrows * a.ncols { dense[idx] = 0.0; idx = idx + 1 }

    var i = 0
    while i < a.nrows {
        var k = a.row_ptr[i]
        while k < a.row_ptr[i + 1] {
            dense[i * a.ncols + a.col_idx[k]] = a.values[k]
            k = k + 1
        }
        i = i + 1
    }
}

// =============================================================================
// Sparse identity matrix
// =============================================================================

fn csr_identity(n: i32) -> CSR with Mut {
    var m = csr_new(n, n)
    m.nnz = n
    var i = 0
    while i < n {
        m.values[i] = 1.0
        m.col_idx[i] = i
        m.row_ptr[i] = i
        i = i + 1
    }
    m.row_ptr[n] = n
    m
}
