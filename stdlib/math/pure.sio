//@ run-pass
//@ expect-stdout: ALL PASS

// stdlib/math/pure.sio — Pure Sounio mathematical functions (zero FFI)
//
// Canonical implementations of core math functions. All modules that
// need math should use these instead of reimplementing locally.
//
// Effect annotations follow Sounio's effect system:
//   Mut   — function uses mutable local state (var)
//   Div   — function contains loops (may diverge)
//   Panic — function contains division or indexing (may panic)
//
// Algorithms:
//   sqrt   — Newton-Raphson (20 iterations)
//   ln     — Range reduction to [0.5, 2) + artanh series
//   exp    — Range reduction by ln2 + Taylor series (25 terms)
//   sin    — fdlibm: exact reduction mod pi/2 + fitted kernels (bit-identical to OpenLibm)
//   cos    — fdlibm: exact reduction mod pi/2 + fitted kernels (bit-identical to OpenLibm)
//   atan   — Argument reduction + Taylor series
//   lgamma — Recurrence to x >= 8 + Stirling series with Bernoulli corrections
//   erf    — Abramowitz-Stegun 5-term rational approximation (max error 1.5e-7)
//
// References:
//   - Abramowitz & Stegun (1964): "Handbook of Mathematical Functions"
//   - Cody & Waite (1980): "Software Manual for the Elementary Functions"

// =============================================================================
// Constants (pure — no effects)
// =============================================================================

fn pi() -> f64 { 3.14159265358979323846 }
fn two_pi() -> f64 { 6.28318530717958647692 }
fn half_pi() -> f64 { 1.57079632679489661923 }
fn e() -> f64 { 2.71828182845904523536 }
fn ln2() -> f64 { 0.6931471805599453 }
fn ln10() -> f64 { 2.302585092994046 }
fn ln_2pi() -> f64 { 1.8378770664093453 }
fn sqrt2() -> f64 { 1.4142135623730951 }
fn inv_sqrt_2pi() -> f64 { 0.3989422804014327 }

// =============================================================================
// Arithmetic helpers (pure — no effects)
// =============================================================================

fn abs(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn max(a: f64, b: f64) -> f64 {
    if a > b { a } else { b }
}

fn min(a: f64, b: f64) -> f64 {
    if a < b { a } else { b }
}

fn clamp(x: f64, lo: f64, hi: f64) -> f64 {
    if x < lo { lo }
    else if x > hi { hi }
    else { x }
}

fn sign(x: f64) -> f64 {
    if x > 0.0 { 1.0 }
    else if x < 0.0 { 0.0 - 1.0 }
    else { 0.0 }
}

fn abs_i32(x: i32) -> i32 {
    if x < 0 { 0 - x } else { x }
}

fn max_i32(a: i32, b: i32) -> i32 {
    if a > b { a } else { b }
}

fn min_i32(a: i32, b: i32) -> i32 {
    if a < b { a } else { b }
}

// =============================================================================
// Square root — Newton-Raphson
// =============================================================================

// Newton-Raphson with range reduction: sqrt(x) = sqrt(x · 4^k) / 2^k.
// For x < 1 we scale up by 4^k until v ∈ [1, 4), then run Newton on the
// well-conditioned reduced argument. Without this, Newton starting at
// y₀ = x with x ~ 10⁻¹⁵ halves each step and needs ≫ 20 iterations to
// reach the true sqrt — returning ~10⁻⁶ instead of ~10⁻⁸. Range
// reduction is bit-deterministic and adds at worst ~30 multiplications
// for f64-representable inputs.
pub fn sqrt(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var v = x
    var s = 1.0
    while v < 1.0 {
        v = v * 4.0
        s = s * 2.0
    }
    var y = v
    var i = 0
    while i < 20 {
        y = 0.5 * (y + v / y)
        i = i + 1
    }
    y / s
}

// =============================================================================
// Natural logarithm — range reduction + artanh series
// =============================================================================
// ln(x) = ln(m * 2^e) = ln(m) + e*ln(2)
// where m in [0.5, 2). Series: ln(m) = 2*(t + t^3/3 + t^5/5 + ...)
// with t = (m-1)/(m+1)

pub fn ln(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 - 1.0e30 }
    if x == 1.0 { return 0.0 }

    // Range reduce to [0.5, 2)
    var m = x
    var e_val = 0
    while m >= 2.0 {
        m = m / 2.0
        e_val = e_val + 1
    }
    while m < 0.5 {
        m = m * 2.0
        e_val = e_val - 1
    }

    // artanh series: ln(m) = 2 * sum_{k=0}^{N} t^(2k+1)/(2k+1)
    let t = (m - 1.0) / (m + 1.0)
    let t2 = t * t
    var sum = t
    var term = t
    var k = 1
    while k < 30 {
        term = term * t2
        let denom = (2 * k + 1) as f64
        sum = sum + term / denom
        k = k + 1
    }
    let ln_m = 2.0 * sum

    return ln_m + (e_val as f64) * ln2()
}

// Common logarithm
pub fn log10(x: f64) -> f64 with Mut, Div, Panic {
    ln(x) / ln10()
}

// Base-2 logarithm
pub fn log2(x: f64) -> f64 with Mut, Div, Panic {
    ln(x) / ln2()
}

// =============================================================================
// Exponential — range reduction + Taylor
// =============================================================================
// exp(x) = 2^k * exp(r) where r = x - k*ln2, |r| < ln2

pub fn exp(x: f64) -> f64 with Mut, Div, Panic {
    if x > 500.0 { return 1.0e200 }
    if x < -500.0 { return 0.0 }

    // Range reduce: find k such that r = x - k*ln2 is in [-ln2/2, ln2/2]
    var k_f = x / ln2()
    var k: i32 = 0
    if k_f >= 0.0 {
        k = k_f as i32
    } else {
        k = (k_f as i32) - 1
    }
    let r = x - (k as f64) * ln2()

    // Taylor series for exp(r) where |r| < ln2
    var sum = 1.0
    var term = 1.0
    var n = 1
    while n < 25 {
        term = term * r / (n as f64)
        sum = sum + term
        n = n + 1
    }

    // Multiply by 2^k
    var result = sum
    if k >= 0 {
        var i = 0
        while i < k {
            result = result * 2.0
            i = i + 1
        }
    } else {
        var i = 0
        while i < (0 - k) {
            result = result / 2.0
            i = i + 1
        }
    }
    return result
}

// General power: x^n = exp(n * ln(x))
pub fn pow(x: f64, n: f64) -> f64 with Mut, Div, Panic {
    if x == 0.0 {
        if n > 0.0 { return 0.0 }
        else { return 1.0e30 }
    }
    if n == 0.0 { return 1.0 }
    if n == 1.0 { return x }
    if n == 2.0 { return x * x }
    exp(n * ln(x))
}

// =============================================================================
// Trigonometric — fdlibm
// =============================================================================
//
// sin and cos are fdlibm as shipped by OpenLibm (s_sin.c, s_cos.c, e_rem_pio2.c,
// k_rem_pio2.c with prec 1, k_sin.c, k_cos.c), kept operation for operation and
// bit-identical to it. The same block, renamed, is lean_single's native sin/cos,
// and the Madaros builtins are printed from an instruction list checked against
// the same reference: docs/audit/NATIVE_SIN_COS_FDLIBM_DISPATCH_2026-09-14.md.
//
// Constants are exact integer mantissas scaled by exact powers of two rather
// than decimal literals, because lean_single does not read decimal literals
// correctly rounded (#1626 follow-up).

// BEGIN GENERATED fdlibm sin/cos -- python3 scripts/dev/gen_fdlibm_trig.py; do not hand-edit.
// constants: exact integer mantissa over exact powers of two (see the note above)
fn fdlibm_c_S1() -> f64 { 0.0 - ((6004799503160649 as f64) / ((1 << 55) as f64)) }
fn fdlibm_c_S2() -> f64 { (2401919801261139 as f64) / ((1 << 58) as f64) }
fn fdlibm_c_S3() -> f64 { 0.0 - ((7320136532976085 as f64) / ((1 << 62) as f64) / ((1 << 3) as f64)) }
fn fdlibm_c_S4() -> f64 { (6506786730409597 as f64) / ((1 << 62) as f64) / ((1 << 9) as f64) }
fn fdlibm_c_S5() -> f64 { 0.0 - ((7571127717829867 as f64) / ((1 << 62) as f64) / ((1 << 16) as f64)) }
fn fdlibm_c_S6() -> f64 { (1537454791456095 as f64) / ((1 << 62) as f64) / ((1 << 21) as f64) }
fn fdlibm_c_C1() -> f64 { (1501199875790163 as f64) / ((1 << 55) as f64) }
fn fdlibm_c_C2() -> f64 { 0.0 - ((6405119470031223 as f64) / ((1 << 62) as f64)) }
fn fdlibm_c_C3() -> f64 { (457508533350745 as f64) / ((1 << 62) as f64) / ((1 << 2) as f64) }
fn fdlibm_c_C4() -> f64 { 0.0 - ((5205429506036397 as f64) / ((1 << 62) as f64) / ((1 << 12) as f64)) }
fn fdlibm_c_C5() -> f64 { (1261860039765105 as f64) / ((1 << 62) as f64) / ((1 << 17) as f64) }
fn fdlibm_c_C6() -> f64 { 0.0 - ((1757820317994549 as f64) / ((1 << 62) as f64) / ((1 << 25) as f64)) }
fn fdlibm_c_invpio2() -> f64 { (5734161139222659 as f64) / ((1 << 53) as f64) }
fn fdlibm_c_pio2_1() -> f64 { (1686629713 as f64) / ((1 << 30) as f64) }
fn fdlibm_c_pio2_1t() -> f64 { (4701928774853425 as f64) / ((1 << 62) as f64) / ((1 << 24) as f64) }
fn fdlibm_c_pio2_2() -> f64 { (2242054355 as f64) / ((1 << 62) as f64) / ((1 << 3) as f64) }
fn fdlibm_c_pio2_2t() -> f64 { (5376105825661043 as f64) / ((1 << 62) as f64) / ((1 << 59) as f64) }
fn fdlibm_c_pio2_3() -> f64 { (160220439 as f64) / ((1 << 62) as f64) / ((1 << 34) as f64) }
fn fdlibm_c_pio2_3t() -> f64 { (7744522442262977 as f64) / ((1 << 62) as f64) / ((1 << 62) as f64) / ((1 << 32) as f64) }
fn fdlibm_c_two24() -> f64 { (1 as f64) * ((1 << 24) as f64) }
fn fdlibm_c_twon24() -> f64 { (1 as f64) / ((1 << 24) as f64) }
fn fdlibm_c_p52x15() -> f64 { (3 as f64) * ((1 << 51) as f64) }

// k_rem_pio2.c ipio2[]: 2/pi in 24-bit chunks
fn fdlibm_ipio2(i: i64) -> i64 with Panic {
    let t: [i64; 66] = [0xA2F983, 0x6E4E44, 0x1529FC, 0x2757D1, 0xF534DD, 0xC0DB62, 0x95993C, 0x439041, 0xFE5163, 0xABDEBB, 0xC561B7, 0x246E3A, 0x424DD2, 0xE00649, 0x2EEA09, 0xD1921C, 0xFE1DEB, 0x1CB129, 0xA73EE8, 0x8235F5, 0x2EBB44, 0x84E99C, 0x7026B4, 0x5F7E41, 0x3991D6, 0x398353, 0x39F49C, 0x845F8B, 0xBDF928, 0x3B1FF8, 0x97FFDE, 0x05980F, 0xEF2F11, 0x8B5A0A, 0x6D1F6D, 0x367ECF, 0x27CB09, 0xB74F46, 0x3F669E, 0x5FEA2D, 0x7527BA, 0xC7EBE5, 0xF17B3D, 0x0739F7, 0x8A5292, 0xEA6BFB, 0x5FB11F, 0x8D5D08, 0x560330, 0x46FC7B, 0x6BABF0, 0xCFBC20, 0x9AF436, 0x1DA9E3, 0x91615E, 0xE61B08, 0x659985, 0x5F14A0, 0x68408D, 0xFFD880, 0x4D7327, 0x310606, 0x1556CA, 0x73A8C9, 0x60E27B, 0xC08C6B]
    t[i]
}

// k_rem_pio2.c PIo2[]: pi/2 in 24-bit pieces
fn fdlibm_pio2_tab(k: i64) -> f64 with Mut, Div, Panic {
    if k == 0 { return (6588397 as f64) / ((1 << 22) as f64) }
    if k == 1 { return (1328173 as f64) / ((1 << 44) as f64) }
    if k == 2 { return (3181873 as f64) / ((1 << 62) as f64) / ((1 << 7) as f64) }
    if k == 3 { return (13001355 as f64) / ((1 << 62) as f64) / ((1 << 33) as f64) }
    if k == 4 { return (2111239 as f64) / ((1 << 62) as f64) / ((1 << 55) as f64) }
    if k == 5 { return (6853761 as f64) / ((1 << 62) as f64) / ((1 << 62) as f64) / ((1 << 18) as f64) }
    if k == 6 { return (2556997 as f64) / ((1 << 62) as f64) / ((1 << 62) as f64) / ((1 << 42) as f64) }
    if k == 7 { return (1700637 as f64) / ((1 << 62) as f64) / ((1 << 62) as f64) / ((1 << 62) as f64) / ((1 << 3) as f64) }
    0.0
}

// v * 2^k, exact whenever v and the result are finite and every intermediate
// stays normal -- true at every call site below (|k| <= 1001, |v| >= 2^-200).
fn fdlibm_scalbn(v: f64, k: i64) -> f64 with Mut, Div, Panic {
    var r = v
    var n = k
    while n > 60 {
        r = r * ((1 << 60) as f64)
        n = n - 60
    }
    while n < 0 - 60 {
        r = r / ((1 << 60) as f64)
        n = n + 60
    }
    if n >= 0 { return r * ((1 << n) as f64) }
    r / ((1 << (0 - n)) as f64)
}

// floor for 0 <= v < 2^63; truncation is floor there.
fn fdlibm_floor_nonneg(v: f64) -> f64 {
    (v as i64) as f64
}

// IEEE negation, including the sign of a zero. Written as a multiplication
// because `-v` is lowered as a subtraction by Madaros, where -(+0.0) is +0.0.
fn fdlibm_neg(v: f64) -> f64 {
    v * (0.0 - 1.0)
}

struct FdlibmRemPio2 { n: i64, y0: f64, y1: f64 }

// k_sin.c
fn fdlibm_k_sin(x: f64, y: f64, iy: i64) -> f64 with Mut, Div, Panic {
    let z = x * x
    let w = z * z
    let r = (fdlibm_c_S2() + z * (fdlibm_c_S3() + z * fdlibm_c_S4())) + (z * w) * (fdlibm_c_S5() + z * fdlibm_c_S6())
    let v = z * x
    if iy == 0 { return x + v * (fdlibm_c_S1() + z * r) }
    x - (((z * (0.5 * y - v * r)) - y) - v * fdlibm_c_S1())
}

// k_cos.c
fn fdlibm_k_cos(x: f64, y: f64) -> f64 with Mut, Div, Panic {
    let z = x * x
    let w = z * z
    let r = (z * (fdlibm_c_C1() + z * (fdlibm_c_C2() + z * fdlibm_c_C3()))) + (w * w) * (fdlibm_c_C4() + z * (fdlibm_c_C5() + z * fdlibm_c_C6()))
    let hz = 0.5 * z
    let w1 = 1.0 - hz
    w1 + (((1.0 - w1) - hz) + (z * r - x * y))
}

// k_rem_pio2.c with prec = 1 (jk = jp = 4). x0..x2 are the 24-bit chunks tx[].
fn fdlibm_k_rem_pio2(x0: f64, x1: f64, x2: f64, e0: i64, nx: i64) -> FdlibmRemPio2 with Mut, Div, Panic {
    var xa: [f64; 3] = [0.0; 3]
    xa[0] = x0
    xa[1] = x1
    xa[2] = x2
    var f: [f64; 20] = [0.0; 20]
    var q: [f64; 20] = [0.0; 20]
    var fq: [f64; 20] = [0.0; 20]
    var iq: [i64; 20] = [0; 20]
    let jk: i64 = 4
    let jp: i64 = 4
    let jx = nx - 1
    var jv = (e0 - 3) / 24
    if jv < 0 { jv = 0 }
    var q0 = e0 - 24 * (jv + 1)

    // f[0] .. f[jx+jk] = ipio2[jv-jx] .. ipio2[jv+jk]
    var j = jv - jx
    let m = jx + jk
    var i: i64 = 0
    while i <= m {
        if j < 0 { f[i] = 0.0 } else { f[i] = fdlibm_ipio2(j) as f64 }
        i = i + 1
        j = j + 1
    }

    // q[0] .. q[jk]
    var fw = 0.0
    i = 0
    while i <= jk {
        fw = 0.0
        j = 0
        while j <= jx {
            fw = fw + xa[j] * f[jx + i - j]
            j = j + 1
        }
        q[i] = fw
        i = i + 1
    }

    var jz = jk
    var z = 0.0
    var n: i64 = 0
    var ih: i64 = 0
    while true {
        // distill q[] into iq[] reversingly
        i = 0
        j = jz
        z = q[jz]
        while j > 0 {
            fw = ((fdlibm_c_twon24() * z) as i64) as f64
            iq[i] = (z - fdlibm_c_two24() * fw) as i64
            z = q[j - 1] + fw
            i = i + 1
            j = j - 1
        }

        // n
        z = fdlibm_scalbn(z, q0)
        z = z - 8.0 * fdlibm_floor_nonneg(z * 0.125)
        n = z as i64
        z = z - (n as f64)
        ih = 0
        if q0 > 0 {
            i = iq[jz - 1] >> (24 - q0)
            n = n + i
            iq[jz - 1] = iq[jz - 1] - (i << (24 - q0))
            ih = iq[jz - 1] >> (23 - q0)
        } else if q0 == 0 {
            ih = iq[jz - 1] >> 23
        } else if z >= 0.5 {
            ih = 2
        }

        if ih > 0 {
            n = n + 1
            var carry: i64 = 0
            i = 0
            while i < jz {
                j = iq[i]
                if carry == 0 {
                    if j != 0 {
                        carry = 1
                        iq[i] = 0x1000000 - j
                    }
                } else {
                    iq[i] = 0xffffff - j
                }
                i = i + 1
            }
            if q0 == 1 {
                iq[jz - 1] = iq[jz - 1] & 0x7fffff
            } else if q0 == 2 {
                iq[jz - 1] = iq[jz - 1] & 0x3fffff
            }
            if ih == 2 {
                z = 1.0 - z
                if carry != 0 { z = z - fdlibm_scalbn(1.0, q0) }
            }
        }

        // recompute when every fraction chunk vanished
        var again: i64 = 0
        if z == 0.0 {
            j = 0
            i = jz - 1
            while i >= jk {
                j = j | iq[i]
                i = i - 1
            }
            if j == 0 {
                var k: i64 = 1
                while iq[jk - k] == 0 { k = k + 1 }
                i = jz + 1
                while i <= jz + k {
                    f[jx + i] = fdlibm_ipio2(jv + i) as f64
                    fw = 0.0
                    j = 0
                    while j <= jx {
                        fw = fw + xa[j] * f[jx + i - j]
                        j = j + 1
                    }
                    q[i] = fw
                    i = i + 1
                }
                jz = jz + k
                again = 1
            }
        }
        if again == 0 { break }
    }

    // chop off zero terms
    if z == 0.0 {
        jz = jz - 1
        q0 = q0 - 24
        while iq[jz] == 0 {
            jz = jz - 1
            q0 = q0 - 24
        }
    } else {
        z = fdlibm_scalbn(z, 0 - q0)
        if z >= fdlibm_c_two24() {
            fw = ((fdlibm_c_twon24() * z) as i64) as f64
            iq[jz] = (z - fdlibm_c_two24() * fw) as i64
            jz = jz + 1
            q0 = q0 + 24
            iq[jz] = fw as i64
        } else {
            iq[jz] = z as i64
        }
    }

    // integer chunks back to floating point
    fw = fdlibm_scalbn(1.0, q0)
    i = jz
    while i >= 0 {
        q[i] = fw * (iq[i] as f64)
        fw = fw * fdlibm_c_twon24()
        i = i - 1
    }

    // PIo2[0..jp] * q[jz..0]
    i = jz
    while i >= 0 {
        fw = 0.0
        var kk: i64 = 0
        while kk <= jp && kk <= jz - i {
            fw = fw + fdlibm_pio2_tab(kk) * q[i + kk]
            kk = kk + 1
        }
        fq[jz - i] = fw
        i = i - 1
    }

    // compress fq[] into y[] (prec 1)
    fw = 0.0
    i = jz
    while i >= 0 {
        fw = fw + fq[i]
        i = i - 1
    }
    var y0 = fw
    if ih != 0 { y0 = fdlibm_neg(fw) }
    fw = fq[0] - fw
    i = 1
    while i <= jz {
        fw = fw + fq[i]
        i = i + 1
    }
    var y1 = fw
    if ih != 0 { y1 = fdlibm_neg(fw) }
    FdlibmRemPio2 { n: n & 7, y0: y0, y1: y1 }
}

// e_rem_pio2.c. The caller has already handled |x| <= pi/4.
fn fdlibm_rem_pio2(x: f64) -> FdlibmRemPio2 with Mut, Div, Panic {
    let hx = f64_to_bits(x) >> 32
    let ix = hx & 0x7fffffff
    var medium: i64 = 0
    if ix <= 0x400f6a7a {
        if (ix & 0xfffff) == 0x921fb {
            medium = 1
        } else if ix <= 0x4002d97c {
            if hx > 0 {
                let z = x - fdlibm_c_pio2_1()
                let y0 = z - fdlibm_c_pio2_1t()
                let y1 = (z - y0) - fdlibm_c_pio2_1t()
                return FdlibmRemPio2 { n: 1, y0: y0, y1: y1 }
            }
            let z = x + fdlibm_c_pio2_1()
            let y0 = z + fdlibm_c_pio2_1t()
            let y1 = (z - y0) + fdlibm_c_pio2_1t()
            return FdlibmRemPio2 { n: 0 - 1, y0: y0, y1: y1 }
        } else {
            if hx > 0 {
                let z = x - 2.0 * fdlibm_c_pio2_1()
                let y0 = z - 2.0 * fdlibm_c_pio2_1t()
                let y1 = (z - y0) - 2.0 * fdlibm_c_pio2_1t()
                return FdlibmRemPio2 { n: 2, y0: y0, y1: y1 }
            }
            let z = x + 2.0 * fdlibm_c_pio2_1()
            let y0 = z + 2.0 * fdlibm_c_pio2_1t()
            let y1 = (z - y0) + 2.0 * fdlibm_c_pio2_1t()
            return FdlibmRemPio2 { n: 0 - 2, y0: y0, y1: y1 }
        }
    }
    if medium == 0 && ix <= 0x401c463b {
        if ix <= 0x4015fdbc {
            if ix == 0x4012d97c {
                medium = 1
            } else {
                if hx > 0 {
                    let z = x - 3.0 * fdlibm_c_pio2_1()
                    let y0 = z - 3.0 * fdlibm_c_pio2_1t()
                    let y1 = (z - y0) - 3.0 * fdlibm_c_pio2_1t()
                    return FdlibmRemPio2 { n: 3, y0: y0, y1: y1 }
                }
                let z = x + 3.0 * fdlibm_c_pio2_1()
                let y0 = z + 3.0 * fdlibm_c_pio2_1t()
                let y1 = (z - y0) + 3.0 * fdlibm_c_pio2_1t()
                return FdlibmRemPio2 { n: 0 - 3, y0: y0, y1: y1 }
            }
        } else {
            if ix == 0x401921fb {
                medium = 1
            } else {
                if hx > 0 {
                    let z = x - 4.0 * fdlibm_c_pio2_1()
                    let y0 = z - 4.0 * fdlibm_c_pio2_1t()
                    let y1 = (z - y0) - 4.0 * fdlibm_c_pio2_1t()
                    return FdlibmRemPio2 { n: 4, y0: y0, y1: y1 }
                }
                let z = x + 4.0 * fdlibm_c_pio2_1()
                let y0 = z + 4.0 * fdlibm_c_pio2_1t()
                let y1 = (z - y0) + 4.0 * fdlibm_c_pio2_1t()
                return FdlibmRemPio2 { n: 0 - 4, y0: y0, y1: y1 }
            }
        }
    }
    if medium == 1 || ix < 0x413921fb {
        // |x| ~< 2^20*(pi/2): n = nearest(x*2/pi), then one to three rounds of pi/2
        var fnv = x * fdlibm_c_invpio2() + fdlibm_c_p52x15()
        fnv = fnv - fdlibm_c_p52x15()
        let n = fnv as i64
        var r = x - fnv * fdlibm_c_pio2_1()
        var w = fnv * fdlibm_c_pio2_1t()
        let j = ix >> 20
        var y0 = r - w
        var i = j - ((f64_to_bits(y0) >> 52) & 0x7ff)
        if i > 16 {
            var t = r
            w = fnv * fdlibm_c_pio2_2()
            r = t - w
            w = fnv * fdlibm_c_pio2_2t() - ((t - r) - w)
            y0 = r - w
            i = j - ((f64_to_bits(y0) >> 52) & 0x7ff)
            if i > 49 {
                t = r
                w = fnv * fdlibm_c_pio2_3()
                r = t - w
                w = fnv * fdlibm_c_pio2_3t() - ((t - r) - w)
                y0 = r - w
            }
        }
        let y1 = (r - y0) - w
        return FdlibmRemPio2 { n: n, y0: y0, y1: y1 }
    }
    if ix >= 0x7ff00000 {
        let d = x - x
        return FdlibmRemPio2 { n: 0, y0: d, y1: d }
    }
    // large |x|: z = |x| * 2^-e0 lies in [2^23, 2^24); split it into 24-bit chunks.
    // (C does this with INSERT_WORDS; lowering the exponent field by e0 is exactly
    // this multiplication by a power of two.)
    let e0 = (ix >> 20) - 1046
    var ax = x
    if x < 0.0 { ax = fdlibm_neg(x) }
    var z = fdlibm_scalbn(ax, 0 - e0)
    let tx0 = (z as i64) as f64
    z = (z - tx0) * fdlibm_c_two24()
    let tx1 = (z as i64) as f64
    z = (z - tx1) * fdlibm_c_two24()
    let tx2 = z
    var nx: i64 = 3
    if tx2 == 0.0 {
        nx = 2
        if tx1 == 0.0 { nx = 1 }
    }
    let kr = fdlibm_k_rem_pio2(tx0, tx1, tx2, e0, nx)
    if hx < 0 {
        return FdlibmRemPio2 { n: 0 - kr.n, y0: fdlibm_neg(kr.y0), y1: fdlibm_neg(kr.y1) }
    }
    kr
}

// s_sin.c
fn fdlibm_sin(x: f64) -> f64 with Mut, Div, Panic {
    let ix = (f64_to_bits(x) >> 32) & 0x7fffffff
    if ix <= 0x3fe921fb {
        if ix < 0x3e500000 { return x }
        return fdlibm_k_sin(x, 0.0, 0)
    }
    if ix >= 0x7ff00000 { return x - x }
    let rp = fdlibm_rem_pio2(x)
    let quad = rp.n & 3
    if quad == 0 { return fdlibm_k_sin(rp.y0, rp.y1, 1) }
    if quad == 1 { return fdlibm_k_cos(rp.y0, rp.y1) }
    if quad == 2 { return fdlibm_neg(fdlibm_k_sin(rp.y0, rp.y1, 1)) }
    fdlibm_neg(fdlibm_k_cos(rp.y0, rp.y1))
}

// s_cos.c
fn fdlibm_cos(x: f64) -> f64 with Mut, Div, Panic {
    let ix = (f64_to_bits(x) >> 32) & 0x7fffffff
    if ix <= 0x3fe921fb {
        if ix < 0x3e46a09e { return 1.0 }
        return fdlibm_k_cos(x, 0.0)
    }
    if ix >= 0x7ff00000 { return x - x }
    let rp = fdlibm_rem_pio2(x)
    let quad = rp.n & 3
    if quad == 0 { return fdlibm_k_cos(rp.y0, rp.y1) }
    if quad == 1 { return fdlibm_neg(fdlibm_k_sin(rp.y0, rp.y1, 1)) }
    if quad == 2 { return fdlibm_neg(fdlibm_k_cos(rp.y0, rp.y1)) }
    fdlibm_k_sin(rp.y0, rp.y1, 1)
}
// END GENERATED fdlibm sin/cos

// pub like tan, atan and sqrt: without it Madaros refuses every cross-module
// call (E175), so `use math::pure::*` could not reach sin or cos at all.
pub fn cos(x: f64) -> f64 with Mut, Div, Panic {
    fdlibm_cos(x)
}

pub fn sin(x: f64) -> f64 with Mut, Div, Panic {
    fdlibm_sin(x)
}

// Tangent
pub fn tan(x: f64) -> f64 with Mut, Div, Panic {
    let c = cos(x)
    if abs(c) < 1.0e-15 { return sign(sin(x)) * 1.0e30 }
    return sin(x) / c
}

// =============================================================================
// Inverse trigonometric
// =============================================================================

// atan via Taylor series with argument reduction
// For |x| <= 1: atan(x) = x - x^3/3 + x^5/5 - x^7/7 + ...
// For |x| > 1: atan(x) = pi/2 - atan(1/x)
pub fn atan(x: f64) -> f64 with Mut, Div, Panic {
    if x > 1.0 {
        return half_pi() - atan(1.0 / x)
    }
    if x < -1.0 {
        return 0.0 - half_pi() - atan(1.0 / x)
    }
    // |x| <= 1: Taylor series
    var sum = x
    var term = x
    let x2 = x * x
    var k = 1
    while k < 40 {
        term = 0.0 - term * x2
        sum = sum + term / (2 * k + 1) as f64
        k = k + 1
    }
    return sum
}

// atan2(y, x) — full-quadrant arctangent
fn atan2(y: f64, x: f64) -> f64 with Mut, Div, Panic {
    if x > 0.0 { return atan(y / x) }
    if x < 0.0 {
        if y >= 0.0 { return atan(y / x) + pi() }
        else { return atan(y / x) - pi() }
    }
    // x == 0
    if y > 0.0 { return half_pi() }
    if y < 0.0 { return 0.0 - half_pi() }
    return 0.0
}

// asin(x) = atan(x / sqrt(1 - x^2))
pub fn asin(x: f64) -> f64 with Mut, Div, Panic {
    if x >= 1.0 { return half_pi() }
    if x <= -1.0 { return 0.0 - half_pi() }
    return atan(x / sqrt(1.0 - x * x))
}

// acos(x) = pi/2 - asin(x)
pub fn acos(x: f64) -> f64 with Mut, Div, Panic {
    return half_pi() - asin(x)
}

// =============================================================================
// Hyperbolic functions
// =============================================================================

fn sinh(x: f64) -> f64 with Mut, Div, Panic {
    let ex = exp(x)
    (ex - 1.0 / ex) / 2.0
}

fn cosh(x: f64) -> f64 with Mut, Div, Panic {
    let ex = exp(x)
    (ex + 1.0 / ex) / 2.0
}

pub fn tanh(x: f64) -> f64 with Mut, Div, Panic {
    if x > 20.0 { return 1.0 }
    if x < -20.0 { return 0.0 - 1.0 }
    let e2x = exp(2.0 * x)
    (e2x - 1.0) / (e2x + 1.0)
}

// =============================================================================
// Gamma function — Stirling series with recurrence
// =============================================================================
// For x >= 8: ln(Gamma(x)) ~ (x-0.5)*ln(x) - x + 0.5*ln(2*pi) + Bernoulli corrections
// For x < 8: use recurrence Gamma(x) = Gamma(x+1)/x

fn lgamma(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 1.0e30 }

    // Recurrence: shift to x >= 8 for Stirling accuracy
    var val = x
    var shift: f64 = 0.0
    while val < 8.0 {
        shift = shift + ln(val)
        val = val + 1.0
    }

    // Stirling series for val >= 8
    var result = (val - 0.5) * ln(val) - val + 0.5 * ln_2pi()

    // Bernoulli correction terms
    let inv_v = 1.0 / val
    let inv_v2 = inv_v * inv_v
    result = result + inv_v / 12.0
    result = result - inv_v * inv_v2 / 360.0
    result = result + inv_v * inv_v2 * inv_v2 / 1260.0
    result = result - inv_v * inv_v2 * inv_v2 * inv_v2 / 1680.0

    return result - shift
}

// Gamma function via exp(lgamma(x))
fn gamma(x: f64) -> f64 with Mut, Div, Panic {
    exp(lgamma(x))
}

// Beta function: B(a,b) = Gamma(a)*Gamma(b)/Gamma(a+b)
fn lbeta(a: f64, b: f64) -> f64 with Mut, Div, Panic {
    lgamma(a) + lgamma(b) - lgamma(a + b)
}

fn beta(a: f64, b: f64) -> f64 with Mut, Div, Panic {
    exp(lbeta(a, b))
}

// Factorial via lgamma (for integer arguments)
fn factorial(n: i32) -> f64 with Mut, Div, Panic {
    if n <= 1 { return 1.0 }
    gamma((n + 1) as f64)
}

// Log-factorial
fn lfactorial(n: i32) -> f64 with Mut, Div, Panic {
    if n <= 1 { return 0.0 }
    lgamma((n + 1) as f64)
}

// =============================================================================
// Error function — Abramowitz-Stegun 5-term rational approximation
// =============================================================================
// erf(x) = 1 - (a1*t + a2*t^2 + ... + a5*t^5) * exp(-x^2)
// where t = 1/(1 + p*|x|)
// Maximum error: 1.5e-7

fn erf(x: f64) -> f64 with Mut, Div, Panic {
    let a1 = 0.254829592
    let a2 = 0.0 - 0.284496736
    let a3 = 1.421413741
    let a4 = 0.0 - 1.453152027
    let a5 = 1.061405429
    let p = 0.3275911

    let ax = abs(x)
    let t = 1.0 / (1.0 + p * ax)
    let t2 = t * t
    let t3 = t2 * t
    let t4 = t3 * t
    let t5 = t4 * t

    let y = 1.0 - (a1 * t + a2 * t2 + a3 * t3 + a4 * t4 + a5 * t5) * exp(0.0 - x * x)

    if x >= 0.0 { y } else { 0.0 - y }
}

// Complementary error function
fn erfc(x: f64) -> f64 with Mut, Div, Panic {
    1.0 - erf(x)
}

// =============================================================================
// Rounding
// =============================================================================

fn floor(x: f64) -> f64 {
    let i = x as i32
    if (i as f64) > x { (i - 1) as f64 } else { i as f64 }
}

fn ceil(x: f64) -> f64 {
    let i = x as i32
    if (i as f64) < x { (i + 1) as f64 } else { i as f64 }
}

fn round(x: f64) -> f64 {
    floor(x + 0.5)
}

fn trunc(x: f64) -> f64 {
    (x as i32) as f64
}

// Fractional part
fn frac(x: f64) -> f64 {
    x - floor(x)
}

// Modulo (Euclidean)
fn fmod(x: f64, y: f64) -> f64 with Panic {
    x - floor(x / y) * y
}

// =============================================================================
// Statistical helper functions
// =============================================================================

// Standard normal PDF: phi(x) = (1/sqrt(2*pi)) * exp(-x^2/2)
fn normal_pdf(x: f64, mu: f64, sigma: f64) -> f64 with Mut, Div, Panic {
    let z = (x - mu) / sigma
    inv_sqrt_2pi() / sigma * exp(0.0 - 0.5 * z * z)
}

// Standard normal log-PDF
fn normal_log_pdf(x: f64, mu: f64, sigma: f64) -> f64 with Mut, Div, Panic {
    if sigma <= 0.0 { return 0.0 - 1.0e30 }
    let z = (x - mu) / sigma
    0.0 - 0.5 * ln_2pi() - ln(sigma) - 0.5 * z * z
}

// Standard normal CDF via erf
fn normal_cdf(x: f64, mu: f64, sigma: f64) -> f64 with Mut, Div, Panic {
    let z = (x - mu) / (sigma * sqrt2())
    0.5 * (1.0 + erf(z))
}

// =============================================================================
// Miscellaneous
// =============================================================================

// Cube root via Newton's method
fn cbrt(x: f64) -> f64 with Mut, Div, Panic {
    if x == 0.0 { return 0.0 }
    let neg = x < 0.0
    var y = abs(x)
    // Initial guess: x^(1/3) ~ exp(ln(x)/3)
    y = exp(ln(y) / 3.0)
    // Newton iterations: y_{n+1} = (2*y_n + x/y_n^2) / 3
    var i = 0
    while i < 10 {
        y = (2.0 * y + abs(x) / (y * y)) / 3.0
        i = i + 1
    }
    if neg { 0.0 - y } else { y }
}

// Hypotenuse: sqrt(a^2 + b^2) without overflow
fn hypot(a: f64, b: f64) -> f64 with Mut, Div, Panic {
    let ax = abs(a)
    let bx = abs(b)
    if ax > bx {
        let r = bx / ax
        ax * sqrt(1.0 + r * r)
    } else if bx > 0.0 {
        let r = ax / bx
        bx * sqrt(1.0 + r * r)
    } else {
        0.0
    }
}

// Linear interpolation (pure — no effects)
fn lerp(a: f64, b: f64, t: f64) -> f64 {
    a + t * (b - a)
}

// Check if two floats are approximately equal (pure — no effects)
fn approx_eq(a: f64, b: f64, tol: f64) -> bool {
    abs(a - b) <= tol
}

// Sigmoid function: 1/(1 + exp(-x))
fn sigmoid(x: f64) -> f64 with Mut, Div, Panic {
    if x > 20.0 { return 1.0 }
    if x < -20.0 { return 0.0 }
    1.0 / (1.0 + exp(0.0 - x))
}

// Softplus: ln(1 + exp(x))
fn softplus(x: f64) -> f64 with Mut, Div, Panic {
    if x > 20.0 { return x }
    if x < -20.0 { return 0.0 }
    ln(1.0 + exp(x))
}

// Log-sum-exp for two values: ln(exp(a) + exp(b))
pub fn log_sum_exp(a: f64, b: f64) -> f64 with Mut, Div, Panic {
    let m = max(a, b)
    m + ln(exp(a - m) + exp(b - m))
}

// =============================================================================
// Inline tests
// =============================================================================

// CNT[0] = pass, CNT[1] = fail  (array avoids JIT large-offset scalar global bug)
var CNT: [i64; 2] = [0; 2]

fn check(label: i64, ok: i64) with IO, Mut {
    if ok == 1 {
        print("  PASS ["); print(label); print("]\n")
        CNT[0] = CNT[0] + 1
    } else {
        print("  FAIL ["); print(label); print("]\n")
        CNT[1] = CNT[1] + 1
    }
}

fn near(a: f64, b: f64, tol: f64) -> i64 {
    let d = a - b
    let d2 = if d < 0.0 { 0.0 - d } else { d }
    if d2 <= tol { 1 } else { 0 }
}

fn test_sqrt() with IO, Mut, Div, Panic {
    check(1, near(sqrt(4.0), 2.0, 1.0e-12))
    check(2, near(sqrt(2.0), sqrt2(), 1.0e-12))
    check(3, near(sqrt(0.0), 0.0, 1.0e-30))
}

fn test_ln_exp() with IO, Mut, Div, Panic {
    check(4, near(ln(1.0), 0.0, 1.0e-12))
    check(5, near(exp(0.0), 1.0, 1.0e-12))
    check(6, near(exp(1.0), e(), 1.0e-8))
    check(7, near(ln(e()), 1.0, 1.0e-8))
    check(8, near(exp(ln(3.0)), 3.0, 1.0e-8))
    check(9, near(log10(100.0), 2.0, 1.0e-8))
    check(10, near(log2(8.0), 3.0, 1.0e-8))
}

fn test_trig() with IO, Mut, Div, Panic {
    check(11, near(sin(0.0), 0.0, 1.0e-12))
    check(12, near(sin(half_pi()), 1.0, 1.0e-10))
    check(13, near(cos(0.0), 1.0, 1.0e-12))
    check(14, near(cos(pi()), 0.0 - 1.0, 1.0e-10))
    check(15, near(sin(pi()), 0.0, 1.0e-10))
    check(16, near(atan(1.0), pi() / 4.0, 1.0e-10))
    check(17, near(atan2(1.0, 1.0), pi() / 4.0, 1.0e-10))
    check(18, near(asin(1.0), half_pi(), 1.0e-10))
    check(19, near(acos(0.0), half_pi(), 1.0e-10))
}

fn test_hyper() with IO, Mut, Div, Panic {
    check(20, near(sinh(0.0), 0.0, 1.0e-12))
    check(21, near(cosh(0.0), 1.0, 1.0e-12))
    check(22, near(tanh(0.0), 0.0, 1.0e-12))
    check(23, near(tanh(100.0), 1.0, 1.0e-10))
}

fn test_gamma() with IO, Mut, Div, Panic {
    // lgamma(1) = 0, lgamma(2) = 0, lgamma(3) = ln(2)
    check(24, near(lgamma(1.0), 0.0, 1.0e-6))
    check(25, near(lgamma(2.0), 0.0, 1.0e-6))
    check(26, near(lgamma(3.0), ln(2.0), 1.0e-6))
    // gamma(5) = 4! = 24
    check(27, near(gamma(5.0), 24.0, 1.0e-4))
    // beta(2,3) = 1/12
    check(28, near(beta(2.0, 3.0), 1.0 / 12.0, 1.0e-6))
}

fn test_erf() with IO, Mut, Div, Panic {
    check(29, near(erf(0.0), 0.0, 1.0e-6))    // A&S rational has ~1e-9 error at x=0
    check(30, near(erf(1.0), 0.8427007929497149, 1.0e-6))
    check(31, near(erfc(0.0), 1.0, 1.0e-6))
    check(32, near(erf(0.0 - 1.0), 0.0 - 0.8427007929497149, 1.0e-6))
}

fn test_rounding() with IO, Mut, Div, Panic {
    check(33, near(floor(3.7), 3.0, 1.0e-15))
    check(34, near(ceil(3.2), 4.0, 1.0e-15))
    check(35, near(round(3.5), 4.0, 1.0e-15))
    check(36, near(trunc(3.9), 3.0, 1.0e-15))
}

fn test_misc() with IO, Mut, Div, Panic {
    check(37, near(abs(0.0 - 5.0), 5.0, 1.0e-15))
    check(38, near(hypot(3.0, 4.0), 5.0, 1.0e-10))
    check(39, near(cbrt(8.0), 2.0, 1.0e-8))
    check(40, near(sigmoid(0.0), 0.5, 1.0e-10))
    check(41, near(normal_cdf(0.0, 0.0, 1.0), 0.5, 1.0e-6))
    check(42, near(lerp(0.0, 10.0, 0.3), 3.0, 1.0e-12))
    check(43, near(pow(2.0, 10.0), 1024.0, 1.0e-4))
    check(44, near(log_sum_exp(0.0, 0.0), ln(2.0), 1.0e-8))
}

pub fn main() -> i32 with IO, Mut, Div, Panic {
    CNT[0] = 0; CNT[1] = 0
    print("─── stdlib/math/pure tests ───\n")
    test_sqrt()
    test_ln_exp()
    test_trig()
    test_hyper()
    test_gamma()
    test_erf()
    test_rounding()
    test_misc()
    print("─── "); print(CNT[0]); print("/"); print(CNT[0] + CNT[1]); print(" PASS ───\n")
    if CNT[1] == 0 {
        print("ALL PASS\n")
        0
    } else {
        1
    }
}
