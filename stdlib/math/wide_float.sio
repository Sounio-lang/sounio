//! stdlib/math/wide_float.sio — V0-E.1 limb surface for binary128 / binary256
//!
//! Semantic-Lane-ID: WS-G-V0E-STDLIB-GUM-SURFACE (print/API slice)
//!
//! Language `f128`/`f256` source arithmetic remains Madaros-E004 until full
//! V0-E lowering. This module is the runnable wire-limb API aligned with
//! V0-D softfloat corpora (LSW-first i64 limbs).

pub struct F128Bits {
    pub lo: i64,
    pub hi: i64,
}

pub struct F256Bits {
    pub l0: i64,
    pub l1: i64,
    pub l2: i64,
    pub l3: i64,
}

pub fn f128_bits_zero() -> F128Bits {
    F128Bits { lo: 0, hi: 0 }
}

pub fn f128_bits_one() -> F128Bits {
    F128Bits { lo: 0, hi: 4611404543450677248 }
}

pub fn f128_bits_two() -> F128Bits {
    F128Bits { lo: 0, hi: 4611686018427387904 }
}

pub fn f128_bits_half() -> F128Bits {
    F128Bits { lo: 0, hi: 4611123068473966592 }
}

pub fn f128_bits_neg_one() -> F128Bits {
    F128Bits { lo: 0, hi: -4611967493404098560 }
}

pub fn f256_bits_one() -> F256Bits {
    F256Bits { l0: 0, l1: 0, l2: 0, l3: 4611668426241343488 }
}

pub fn f128_bits_eq(a: F128Bits, b: F128Bits) -> bool {
    a.lo == b.lo && a.hi == b.hi
}

pub fn f256_bits_eq(a: F256Bits, b: F256Bits) -> bool {
    a.l0 == b.l0 && a.l1 == b.l1 && a.l2 == b.l2 && a.l3 == b.l3
}

fn print_hex_nibble(n: i64) with IO {
    if n == 0 { print("0"); return }
    if n == 1 { print("1"); return }
    if n == 2 { print("2"); return }
    if n == 3 { print("3"); return }
    if n == 4 { print("4"); return }
    if n == 5 { print("5"); return }
    if n == 6 { print("6"); return }
    if n == 7 { print("7"); return }
    if n == 8 { print("8"); return }
    if n == 9 { print("9"); return }
    if n == 10 { print("a"); return }
    if n == 11 { print("b"); return }
    if n == 12 { print("c"); return }
    if n == 13 { print("d"); return }
    if n == 14 { print("e"); return }
    print("f")
}

fn print_u32_hex8(u: i64) with IO, Mut, Panic, Div {
    // u holds an unsigned 32-bit value in the low half of i64
    var shift: i64 = 28
    var i: i64 = 0
    while i < 8 {
        let nibble = (u >> shift) & 15
        print_hex_nibble(nibble)
        shift = shift - 4
        i = i + 1
    }
}

/// Print one i64 limb as 16 lowercase hex digits of its raw u64 bits.
pub fn print_limb_hex16(limb: i64) with IO, Mut, Panic, Div {
    let mask: i64 = 4294967295
    let hi32 = (limb >> 32) & mask
    let lo32 = limb & mask
    print_u32_hex8(hi32)
    print_u32_hex8(lo32)
}

/// LSW-first wire: `lo:hi` — matches softfloat_limb.limbs_to_hex_wire(f128).
pub fn print_f128_bits_hex_wire(x: F128Bits) with IO, Mut, Panic, Div {
    print_limb_hex16(x.lo)
    print(":")
    print_limb_hex16(x.hi)
}

pub fn print_f256_bits_hex_wire(x: F256Bits) with IO, Mut, Panic, Div {
    print_limb_hex16(x.l0)
    print(":")
    print_limb_hex16(x.l1)
    print(":")
    print_limb_hex16(x.l2)
    print(":")
    print_limb_hex16(x.l3)
}
