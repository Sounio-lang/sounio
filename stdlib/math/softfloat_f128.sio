//! stdlib/math/softfloat_f128.sio — IEEE binary128 add/sub/mul/div/neg/cmp in sio (V0-E.5 / V0-E.5.2 / V0-E.5.3)
//!
//! Semantic-Lane-ID: WS-G-V0E-STDLIB-GUM-SURFACE
//! Claim clock: ADR-008 / ADR-009 — callers must judge with sounio_native_expected
//! hex wires, never Python/Rust as authority.
//!
//! This is general finite-domain IEEE-754 binary128 add/sub (RNE), not the
//! V0-E.4 `f128_bits_exact_case_*` table. Language `f128` Madaros-run `+`/`−`
//! (V0-E.5.1) desugars via `F128Bits` + `f128_bits_soft_add`/`_sub`.
//!
//! Working store: four unsigned 32-bit words in i64 containers (128-bit
//! significand + GRS). Host f64 is never used on the payload path.

use math::wide_float::{F128Bits}

struct SfU128 {
    w0: i64,
    w1: i64,
    w2: i64,
    w3: i64,
}

struct SfShift {
    val: SfU128,
    sticky: i64,
}

struct SfGrs {
    body: SfU128,
    grs: i64,
}

fn sf_u32(x: i64) -> i64 {
    x & 4294967295
}

fn sf_join_u32(lo32: i64, hi32: i64) -> i64 {
    sf_u32(lo32) | (sf_u32(hi32) << 32)
}

fn sf_u32_lo(x: i64) -> i64 {
    x & 4294967295
}

fn sf_u32_hi(x: i64) -> i64 {
    (x >> 32) & 4294967295
}

fn sf_u128_zero() -> SfU128 {
    SfU128 { w0: 0, w1: 0, w2: 0, w3: 0 }
}

fn sf_u128_is_zero(a: SfU128) -> bool {
    a.w0 == 0 && a.w1 == 0 && a.w2 == 0 && a.w3 == 0
}

fn sf_u128_one() -> SfU128 {
    SfU128 { w0: 1, w1: 0, w2: 0, w3: 0 }
}

fn sf_u128_cmp(a: SfU128, b: SfU128) -> i64 {
    if a.w3 > b.w3 { return 1 }
    if a.w3 < b.w3 { return 0 - 1 }
    if a.w2 > b.w2 { return 1 }
    if a.w2 < b.w2 { return 0 - 1 }
    if a.w1 > b.w1 { return 1 }
    if a.w1 < b.w1 { return 0 - 1 }
    if a.w0 > b.w0 { return 1 }
    if a.w0 < b.w0 { return 0 - 1 }
    0
}

fn sf_u128_add(a: SfU128, b: SfU128) -> SfU128 {
    let s0 = a.w0 + b.w0
    let c0 = s0 >> 32
    let w0 = s0 & 4294967295
    let s1 = a.w1 + b.w1 + c0
    let c1 = s1 >> 32
    let w1 = s1 & 4294967295
    let s2 = a.w2 + b.w2 + c1
    let c2 = s2 >> 32
    let w2 = s2 & 4294967295
    let s3 = a.w3 + b.w3 + c2
    let w3 = s3 & 4294967295
    SfU128 { w0: w0, w1: w1, w2: w2, w3: w3 }
}

fn sf_u128_sub(a: SfU128, b: SfU128) -> SfU128 {
    var br: i64 = 0
    var v0 = a.w0 - b.w0
    if v0 < 0 {
        v0 = v0 + 4294967296
        br = 1
    } else {
        br = 0
    }
    var v1 = a.w1 - b.w1 - br
    if v1 < 0 {
        v1 = v1 + 4294967296
        br = 1
    } else {
        br = 0
    }
    var v2 = a.w2 - b.w2 - br
    if v2 < 0 {
        v2 = v2 + 4294967296
        br = 1
    } else {
        br = 0
    }
    var v3 = a.w3 - b.w3 - br
    if v3 < 0 {
        v3 = v3 + 4294967296
    }
    SfU128 { w0: v0, w1: v1, w2: v2, w3: v3 }
}

fn sf_u128_shl1(a: SfU128) -> SfU128 {
    SfU128 {
        w0: (a.w0 << 1) & 4294967295,
        w1: ((a.w1 << 1) & 4294967295) | ((a.w0 >> 31) & 1),
        w2: ((a.w2 << 1) & 4294967295) | ((a.w1 >> 31) & 1),
        w3: ((a.w3 << 1) & 4294967295) | ((a.w2 >> 31) & 1),
    }
}

fn sf_u128_shr1(a: SfU128) -> SfShift {
    SfShift {
        val: SfU128 {
            w0: ((a.w0 >> 1) | ((a.w1 & 1) << 31)) & 4294967295,
            w1: ((a.w1 >> 1) | ((a.w2 & 1) << 31)) & 4294967295,
            w2: ((a.w2 >> 1) | ((a.w3 & 1) << 31)) & 4294967295,
            w3: (a.w3 >> 1) & 4294967295,
        },
        sticky: a.w0 & 1,
    }
}

fn sf_u128_shl_n(a: SfU128, n: i64) -> SfU128 with Mut {
    var out = a
    var i: i64 = 0
    var cap = n
    if cap > 128 { cap = 128 }
    while i < cap {
        out = sf_u128_shl1(out)
        i = i + 1
    }
    out
}

fn sf_u128_shr_n_trunc(a: SfU128, n: i64) -> SfU128 with Mut {
    var out = a
    var i: i64 = 0
    var cap = n
    if cap > 128 { cap = 128 }
    while i < cap {
        let sh = sf_u128_shr1(out)
        out = sh.val
        i = i + 1
    }
    out
}

fn sf_u128_shr_n_sticky(a: SfU128, n: i64) -> SfU128 with Mut {
    var out = a
    var sticky: i64 = 0
    var i: i64 = 0
    var cap = n
    if cap > 160 { cap = 160 }
    while i < cap {
        let sh = sf_u128_shr1(out)
        out = sh.val
        sticky = sticky | sh.sticky
        i = i + 1
    }
    if sticky != 0 {
        out = SfU128 { w0: out.w0 | 1, w1: out.w1, w2: out.w2, w3: out.w3 }
    }
    out
}

fn sf_u128_bit(a: SfU128, bit: i64) -> i64 {
    if bit < 32 { return (a.w0 >> bit) & 1 }
    if bit < 64 { return (a.w1 >> (bit - 32)) & 1 }
    if bit < 96 { return (a.w2 >> (bit - 64)) & 1 }
    (a.w3 >> (bit - 96)) & 1
}

fn sf_unpack_sign(hi: i64) -> i64 {
    if hi < 0 { 1 } else { 0 }
}

fn sf_unpack_exp(hi: i64) -> i64 {
    (sf_u32_hi(hi) >> 16) & 32767
}

fn sf_unpack_frac(lo: i64, hi: i64) -> SfU128 {
    SfU128 {
        w0: sf_u32_lo(lo),
        w1: sf_u32_hi(lo),
        w2: sf_u32_lo(hi),
        w3: sf_u32_hi(hi) & 65535,
    }
}

fn sf_pack(sign: i64, exp: i64, frac: SfU128) -> F128Bits {
    let lo = sf_join_u32(frac.w0, frac.w1)
    var hi_top = (frac.w3 & 65535) | ((exp & 32767) << 16)
    if sign != 0 {
        hi_top = hi_top | 2147483648
    }
    let hi = sf_join_u32(frac.w2, hi_top)
    F128Bits { lo: lo, hi: hi }
}

fn sf_qnan_frac() -> SfU128 {
    // 1 << 111  (quiet bit, mant_bits-1)
    SfU128 { w0: 0, w1: 0, w2: 0, w3: 32768 }
}

fn sf_sig_from(exp: i64, frac: SfU128) -> (i64, SfU128) with Mut {
    if exp == 0 {
        if sf_u128_is_zero(frac) {
            return (0, sf_u128_zero())
        }
        var sig = frac
        var exp_u: i64 = 0 - 16382
        while sf_u128_bit(sig, 112) == 0 {
            sig = sf_u128_shl1(sig)
            exp_u = exp_u - 1
        }
        return (exp_u, sig)
    }
    var sig2 = frac
    sig2 = SfU128 { w0: sig2.w0, w1: sig2.w1, w2: sig2.w2, w3: sig2.w3 | 65536 }
    (exp - 16383, sig2)
}

fn sf_rne_up(body: SfU128, grs: i64) -> bool {
    let g = (grs >> 2) & 1
    let r = (grs >> 1) & 1
    let s = grs & 1
    if g == 0 { return false }
    if r != 0 || s != 0 { return true }
    (body.w0 & 1) == 1
}

fn sf_take_grs(sig: SfU128) -> SfGrs {
    let grs = sig.w0 & 7
    let s0 = sf_u128_shr1(sig)
    let s1 = sf_u128_shr1(s0.val)
    let s2 = sf_u128_shr1(s1.val)
    SfGrs { body: s2.val, grs: grs }
}

fn sf_is_pow2_112(body: SfU128) -> bool {
    body.w0 == 0 && body.w1 == 0 && body.w2 == 0 && body.w3 == 65536
}

fn sf_pack_wide(sign: i64, exp_u0: i64, sig0: SfU128) -> F128Bits with Mut {
    var exp_u = exp_u0
    var sig_wide = sig0
    let total: i64 = 116
    if sf_u128_is_zero(sig_wide) {
        return sf_pack(sign, 0, sf_u128_zero())
    }
    while sf_u128_bit(sig_wide, 116) == 1 {
        sig_wide = sf_u128_shr_n_sticky(sig_wide, 1)
        exp_u = exp_u + 1
    }
    while !sf_u128_is_zero(sig_wide) && sf_u128_bit(sig_wide, 115) == 0 {
        sig_wide = sf_u128_shl1(sig_wide)
        exp_u = exp_u - 1
    }
    let emin: i64 = 0 - 16382
    let emax: i64 = 16383
    if exp_u < emin {
        let shift = emin - exp_u
        if shift >= total + 8 {
            return sf_pack(sign, 0, sf_u128_zero())
        }
        sig_wide = sf_u128_shr_n_sticky(sig_wide, shift)
        let g = sf_take_grs(sig_wide)
        var body = g.body
        if sf_rne_up(body, g.grs) {
            body = sf_u128_add(body, sf_u128_one())
            if sf_is_pow2_112(body) {
                return sf_pack(sign, 1, sf_u128_zero())
            }
        }
        if sf_u128_is_zero(body) {
            return sf_pack(sign, 0, sf_u128_zero())
        }
        body = SfU128 { w0: body.w0, w1: body.w1, w2: body.w2, w3: body.w3 & 65535 }
        return sf_pack(sign, 0, body)
    }
    if exp_u > emax {
        return sf_pack(sign, 32767, sf_u128_zero())
    }
    let g2 = sf_take_grs(sig_wide)
    var body2 = g2.body
    if sf_rne_up(body2, g2.grs) {
        body2 = sf_u128_add(body2, sf_u128_one())
        if sf_u128_bit(body2, 113) == 1 {
            let sh = sf_u128_shr1(body2)
            body2 = sh.val
            exp_u = exp_u + 1
            if exp_u > emax {
                return sf_pack(sign, 32767, sf_u128_zero())
            }
        }
    }
    let frac = SfU128 { w0: body2.w0, w1: body2.w1, w2: body2.w2, w3: body2.w3 & 65535 }
    let biased = exp_u + 16383
    if biased <= 0 { return sf_pack(sign, 0, sf_u128_zero()) }
    if biased >= 32767 { return sf_pack(sign, 32767, sf_u128_zero()) }
    sf_pack(sign, biased, frac)
}

fn sf_is_nan(exp: i64, frac: SfU128) -> bool {
    exp == 32767 && !sf_u128_is_zero(frac)
}

fn sf_is_inf(exp: i64, frac: SfU128) -> bool {
    exp == 32767 && sf_u128_is_zero(frac)
}

fn sf_is_zero(exp: i64, frac: SfU128) -> bool {
    exp == 0 && sf_u128_is_zero(frac)
}

/// IEEE binary128 addition, round-to-nearest-even.
pub fn f128_bits_soft_add(a: F128Bits, b: F128Bits) -> F128Bits with Mut, Panic, Div {
    let sa = sf_unpack_sign(a.hi)
    let ea = sf_unpack_exp(a.hi)
    let fa = sf_unpack_frac(a.lo, a.hi)
    let sb = sf_unpack_sign(b.hi)
    let eb = sf_unpack_exp(b.hi)
    let fb = sf_unpack_frac(b.lo, b.hi)
    let exp_ones: i64 = 32767
    if sf_is_nan(ea, fa) {
        var f = fa
        if sf_u128_is_zero(f) { f = sf_qnan_frac() }
        return sf_pack(0, exp_ones, f)
    }
    if sf_is_nan(eb, fb) {
        var f2 = fb
        if sf_u128_is_zero(f2) { f2 = sf_qnan_frac() }
        return sf_pack(0, exp_ones, f2)
    }
    if sf_is_inf(ea, fa) && sf_is_inf(eb, fb) && sa != sb {
        return sf_pack(0, exp_ones, sf_qnan_frac())
    }
    if sf_is_inf(ea, fa) { return sf_pack(sa, exp_ones, sf_u128_zero()) }
    if sf_is_inf(eb, fb) { return sf_pack(sb, exp_ones, sf_u128_zero()) }
    if sf_is_zero(ea, fa) && sf_is_zero(eb, fb) {
        let zsign = if sa == 1 && sb == 1 { 1 } else { 0 }
        return sf_pack(zsign, 0, sf_u128_zero())
    }
    if sf_is_zero(ea, fa) { return b }
    if sf_is_zero(eb, fb) { return a }

    let pair_a = sf_sig_from(ea, fa)
    let pair_b = sf_sig_from(eb, fb)
    var ea_u = pair_a.0
    var eb_u = pair_b.0
    var sa3 = sf_u128_shl_n(pair_a.1, 3)
    var sb3 = sf_u128_shl_n(pair_b.1, 3)
    var sign_a = sa
    var sign_b = sb
    if ea_u < eb_u {
        let tmp_e = ea_u
        ea_u = eb_u
        eb_u = tmp_e
        let tmp_s = sa3
        sa3 = sb3
        sb3 = tmp_s
        let tmp_sign = sign_a
        sign_a = sign_b
        sign_b = tmp_sign
    }
    let shift = ea_u - eb_u
    if shift > 0 {
        sb3 = sf_u128_shr_n_sticky(sb3, shift)
    }
    var sum3 = sf_u128_zero()
    var sign: i64 = sign_a
    if sign_a == sign_b {
        sum3 = sf_u128_add(sa3, sb3)
        sign = sign_a
    } else {
        if sf_u128_cmp(sa3, sb3) >= 0 {
            sum3 = sf_u128_sub(sa3, sb3)
            sign = sign_a
        } else {
            sum3 = sf_u128_sub(sb3, sa3)
            sign = sign_b
        }
        if sf_u128_is_zero(sum3) {
            return sf_pack(0, 0, sf_u128_zero())
        }
    }
    sf_pack_wide(sign, ea_u, sum3)
}

/// IEEE binary128 subtraction, round-to-nearest-even.
pub fn f128_bits_soft_sub(a: F128Bits, b: F128Bits) -> F128Bits with Mut, Panic, Div {
    let sb = sf_unpack_sign(b.hi)
    let eb = sf_unpack_exp(b.hi)
    let fb = sf_unpack_frac(b.lo, b.hi)
    if eb == 32767 && !sf_u128_is_zero(fb) {
        return f128_bits_soft_add(a, b)
    }
    let bneg = sf_pack(1 - sb, eb, fb)
    f128_bits_soft_add(a, bneg)
}

// ---------------------------------------------------------------------------
// V0-E.5.2: mul / neg / cmp
// ---------------------------------------------------------------------------

/// Eight unsigned 32-bit words in i64 containers (256-bit product store).
struct SfU256 {
    w0: i64,
    w1: i64,
    w2: i64,
    w3: i64,
    w4: i64,
    w5: i64,
    w6: i64,
    w7: i64,
}

fn sf_u256_zero() -> SfU256 {
    SfU256 { w0: 0, w1: 0, w2: 0, w3: 0, w4: 0, w5: 0, w6: 0, w7: 0 }
}

fn sf_u256_add(a: SfU256, b: SfU256) -> SfU256 {
    let s0 = a.w0 + b.w0
    let s1 = a.w1 + b.w1 + (s0 >> 32)
    let s2 = a.w2 + b.w2 + (s1 >> 32)
    let s3 = a.w3 + b.w3 + (s2 >> 32)
    let s4 = a.w4 + b.w4 + (s3 >> 32)
    let s5 = a.w5 + b.w5 + (s4 >> 32)
    let s6 = a.w6 + b.w6 + (s5 >> 32)
    let s7 = a.w7 + b.w7 + (s6 >> 32)
    SfU256 {
        w0: s0 & 4294967295,
        w1: s1 & 4294967295,
        w2: s2 & 4294967295,
        w3: s3 & 4294967295,
        w4: s4 & 4294967295,
        w5: s5 & 4294967295,
        w6: s6 & 4294967295,
        w7: s7 & 4294967295,
    }
}

/// Shift left by 16 bits (one multiplier half-word).
fn sf_u256_shl16(a: SfU256) -> SfU256 {
    SfU256 {
        w0: (a.w0 << 16) & 4294967295,
        w1: ((a.w1 << 16) & 4294967295) | (a.w0 >> 16),
        w2: ((a.w2 << 16) & 4294967295) | (a.w1 >> 16),
        w3: ((a.w3 << 16) & 4294967295) | (a.w2 >> 16),
        w4: ((a.w4 << 16) & 4294967295) | (a.w3 >> 16),
        w5: ((a.w5 << 16) & 4294967295) | (a.w4 >> 16),
        w6: ((a.w6 << 16) & 4294967295) | (a.w5 >> 16),
        w7: ((a.w7 << 16) & 4294967295) | (a.w6 >> 16),
    }
}

/// 128-bit × 16-bit → 144-bit partial product. Every 32×16 product is < 2^48,
/// so nothing here depends on i64 wrap-around semantics.
fn sf_u128_mul_u16(a: SfU128, h: i64) -> SfU256 {
    let m = h & 65535
    let p0 = a.w0 * m
    let p1 = a.w1 * m + (p0 >> 32)
    let p2 = a.w2 * m + (p1 >> 32)
    let p3 = a.w3 * m + (p2 >> 32)
    SfU256 {
        w0: p0 & 4294967295,
        w1: p1 & 4294967295,
        w2: p2 & 4294967295,
        w3: p3 & 4294967295,
        w4: p3 >> 32,
        w5: 0,
        w6: 0,
        w7: 0,
    }
}

/// Full 128×128 → 256 product by Horner over the eight 16-bit halves of `b`
/// (most significant half first).
fn sf_u128_mul_wide(a: SfU128, b: SfU128) -> SfU256 with Mut {
    var acc = sf_u256_zero()
    acc = sf_u256_add(acc, sf_u128_mul_u16(a, b.w3 >> 16))
    acc = sf_u256_shl16(acc)
    acc = sf_u256_add(acc, sf_u128_mul_u16(a, b.w3))
    acc = sf_u256_shl16(acc)
    acc = sf_u256_add(acc, sf_u128_mul_u16(a, b.w2 >> 16))
    acc = sf_u256_shl16(acc)
    acc = sf_u256_add(acc, sf_u128_mul_u16(a, b.w2))
    acc = sf_u256_shl16(acc)
    acc = sf_u256_add(acc, sf_u128_mul_u16(a, b.w1 >> 16))
    acc = sf_u256_shl16(acc)
    acc = sf_u256_add(acc, sf_u128_mul_u16(a, b.w1))
    acc = sf_u256_shl16(acc)
    acc = sf_u256_add(acc, sf_u128_mul_u16(a, b.w0 >> 16))
    acc = sf_u256_shl16(acc)
    acc = sf_u256_add(acc, sf_u128_mul_u16(a, b.w0))
    acc
}

/// Drop the low 109 bits of a 226-bit significand product with sticky, leaving
/// a 116/117-bit wide significand for `sf_pack_wide` (leading bit 115 or 116).
fn sf_u256_shr109_sticky(p: SfU256) -> SfU128 {
    var sticky: i64 = 0
    if p.w0 != 0 || p.w1 != 0 || p.w2 != 0 { sticky = 1 }
    if (p.w3 & 8191) != 0 { sticky = 1 }
    let r0 = ((p.w3 >> 13) | ((p.w4 << 19) & 4294967295)) | sticky
    let r1 = (p.w4 >> 13) | ((p.w5 << 19) & 4294967295)
    let r2 = (p.w5 >> 13) | ((p.w6 << 19) & 4294967295)
    let r3 = (p.w6 >> 13) | ((p.w7 << 19) & 4294967295)
    SfU128 { w0: r0, w1: r1, w2: r2, w3: r3 }
}

/// IEEE binary128 multiplication, round-to-nearest-even.
pub fn f128_bits_soft_mul(a: F128Bits, b: F128Bits) -> F128Bits with Mut, Panic, Div {
    let sa = sf_unpack_sign(a.hi)
    let ea = sf_unpack_exp(a.hi)
    let fa = sf_unpack_frac(a.lo, a.hi)
    let sb = sf_unpack_sign(b.hi)
    let eb = sf_unpack_exp(b.hi)
    let fb = sf_unpack_frac(b.lo, b.hi)
    let exp_ones: i64 = 32767
    let sign = if sa == sb { 0 } else { 1 }
    if sf_is_nan(ea, fa) {
        var f = fa
        if sf_u128_is_zero(f) { f = sf_qnan_frac() }
        return sf_pack(0, exp_ones, f)
    }
    if sf_is_nan(eb, fb) {
        var f2 = fb
        if sf_u128_is_zero(f2) { f2 = sf_qnan_frac() }
        return sf_pack(0, exp_ones, f2)
    }
    if sf_is_inf(ea, fa) || sf_is_inf(eb, fb) {
        if sf_is_zero(ea, fa) || sf_is_zero(eb, fb) {
            return sf_pack(0, exp_ones, sf_qnan_frac())
        }
        return sf_pack(sign, exp_ones, sf_u128_zero())
    }
    if sf_is_zero(ea, fa) || sf_is_zero(eb, fb) {
        return sf_pack(sign, 0, sf_u128_zero())
    }
    let pair_a = sf_sig_from(ea, fa)
    let pair_b = sf_sig_from(eb, fb)
    // value = (sig_a · 2^(ea_u-112)) · (sig_b · 2^(eb_u-112)) = P · 2^(ea_u+eb_u-224);
    // P has its leading bit at 224 or 225, so P >> 109 sits at 115/116 with
    // exp_u = ea_u + eb_u under the sf_pack_wide convention (bit 115 = 2^exp_u).
    let prod = sf_u128_mul_wide(pair_a.1, pair_b.1)
    let sig_wide = sf_u256_shr109_sticky(prod)
    sf_pack_wide(sign, pair_a.0 + pair_b.0, sig_wide)
}

/// Restoring long division of significands: Q = floor(sig_a · 2^116 / sig_b)
/// (117 quotient bits, leading bit 115 or 116 since sig_a/sig_b ∈ (1/2, 2)),
/// with the non-zero remainder folded into bit 0 as sticky. Both operands are
/// normalised 113-bit significands (bit 112 set), so rem < 2·sig_b < 2^114
/// always fits the 128-bit store.
fn sf_u128_div_wide(sig_a: SfU128, sig_b: SfU128) -> SfU128 with Mut {
    var rem = sig_a
    var q = sf_u128_zero()
    var i: i64 = 0
    while i < 117 {
        q = sf_u128_shl1(q)
        if sf_u128_cmp(rem, sig_b) >= 0 {
            rem = sf_u128_sub(rem, sig_b)
            q = SfU128 { w0: q.w0 | 1, w1: q.w1, w2: q.w2, w3: q.w3 }
        }
        rem = sf_u128_shl1(rem)
        i = i + 1
    }
    if !sf_u128_is_zero(rem) {
        q = SfU128 { w0: q.w0 | 1, w1: q.w1, w2: q.w2, w3: q.w3 }
    }
    q
}

/// Truncate a finite binary128 toward zero (KL-8 helper for `%`).
fn f128_bits_soft_trunc(x: F128Bits) -> F128Bits with Mut, Panic, Div {
    let sa = sf_unpack_sign(x.hi)
    let ea = sf_unpack_exp(x.hi)
    let fa = sf_unpack_frac(x.lo, x.hi)
    let exp_ones: i64 = 32767
    if sf_is_nan(ea, fa) {
        var f = fa
        if sf_u128_is_zero(f) { f = sf_qnan_frac() }
        return sf_pack(0, exp_ones, f)
    }
    if sf_is_inf(ea, fa) {
        return sf_pack(0, exp_ones, sf_qnan_frac())
    }
    if sf_is_zero(ea, fa) {
        return sf_pack(sa, 0, sf_u128_zero())
    }
    let pair = sf_sig_from(ea, fa)
    let exp_u = pair.0
    let sig = pair.1
    if exp_u < 0 {
        return sf_pack(sa, 0, sf_u128_zero())
    }
    if exp_u >= 112 {
        return x
    }
    let shift = 112 - exp_u
    let truncated = sf_u128_shr_n_trunc(sig, shift)
    sf_pack_wide(sa, exp_u, truncated)
}

/// IEEE binary128 remainder: a - trunc(a/b)*b (trunc toward zero, fmod family).
pub fn f128_bits_soft_rem(a: F128Bits, b: F128Bits) -> F128Bits with Mut, Panic, Div {
    let sa = sf_unpack_sign(a.hi)
    let ea = sf_unpack_exp(a.hi)
    let fa = sf_unpack_frac(a.lo, a.hi)
    let sb = sf_unpack_sign(b.hi)
    let eb = sf_unpack_exp(b.hi)
    let fb = sf_unpack_frac(b.lo, b.hi)
    let exp_ones: i64 = 32767
    if sf_is_nan(ea, fa) {
        var f = fa
        if sf_u128_is_zero(f) { f = sf_qnan_frac() }
        return sf_pack(0, exp_ones, f)
    }
    if sf_is_nan(eb, fb) {
        var f2 = fb
        if sf_u128_is_zero(f2) { f2 = sf_qnan_frac() }
        return sf_pack(0, exp_ones, f2)
    }
    let inf_a = sf_is_inf(ea, fa)
    let inf_b = sf_is_inf(eb, fb)
    let zero_a = sf_is_zero(ea, fa)
    let zero_b = sf_is_zero(eb, fb)
    if zero_b {
        if zero_a || inf_a {
            return sf_pack(0, exp_ones, sf_qnan_frac())
        }
        return sf_pack(sa, exp_ones, sf_u128_zero())
    }
    if zero_a || inf_a {
        if inf_a && !inf_b {
            return sf_pack(0, exp_ones, sf_qnan_frac())
        }
        return sf_pack(sa, 0, sf_u128_zero())
    }
    if inf_b {
        return a
    }
    let q = f128_bits_soft_div(a, b)
    let t = f128_bits_soft_trunc(q)
    let prod = f128_bits_soft_mul(t, b)
    f128_bits_soft_sub(a, prod)
}

/// IEEE binary128 division, round-to-nearest-even. x/0 → ±inf, 0/0 and
/// inf/inf → qNaN (no trapping; flags are not modelled).
pub fn f128_bits_soft_div(a: F128Bits, b: F128Bits) -> F128Bits with Mut, Panic, Div {
    let sa = sf_unpack_sign(a.hi)
    let ea = sf_unpack_exp(a.hi)
    let fa = sf_unpack_frac(a.lo, a.hi)
    let sb = sf_unpack_sign(b.hi)
    let eb = sf_unpack_exp(b.hi)
    let fb = sf_unpack_frac(b.lo, b.hi)
    let exp_ones: i64 = 32767
    let sign = if sa == sb { 0 } else { 1 }
    if sf_is_nan(ea, fa) {
        var f = fa
        if sf_u128_is_zero(f) { f = sf_qnan_frac() }
        return sf_pack(0, exp_ones, f)
    }
    if sf_is_nan(eb, fb) {
        var f2 = fb
        if sf_u128_is_zero(f2) { f2 = sf_qnan_frac() }
        return sf_pack(0, exp_ones, f2)
    }
    let inf_a = sf_is_inf(ea, fa)
    let inf_b = sf_is_inf(eb, fb)
    let zero_a = sf_is_zero(ea, fa)
    let zero_b = sf_is_zero(eb, fb)
    if (inf_a && inf_b) || (zero_a && zero_b) {
        return sf_pack(0, exp_ones, sf_qnan_frac())
    }
    if inf_a || zero_b {
        return sf_pack(sign, exp_ones, sf_u128_zero())
    }
    if zero_a || inf_b {
        return sf_pack(sign, 0, sf_u128_zero())
    }
    let pair_a = sf_sig_from(ea, fa)
    let pair_b = sf_sig_from(eb, fb)
    // value = (sig_a/sig_b) · 2^(ea_u-eb_u) = Q · 2^-116 · 2^(ea_u-eb_u)
    //       = Q · 2^(exp_u - 115)  with exp_u = ea_u - eb_u - 1.
    let q = sf_u128_div_wide(pair_a.1, pair_b.1)
    sf_pack_wide(sign, pair_a.0 - pair_b.0 - 1, q)
}

/// Four-limb ABI for V0-E.5.3 language `f128` `/` (seed-run gate surface).
pub fn f128_soft_div_limbs(a_lo: i64, a_hi: i64, b_lo: i64, b_hi: i64) -> F128Bits with Mut, Panic, Div {
    f128_bits_soft_div(F128Bits { lo: a_lo, hi: a_hi }, F128Bits { lo: b_lo, hi: b_hi })
}

/// IEEE negate: flips the sign bit only (NaN payload preserved).
pub fn f128_bits_soft_neg(a: F128Bits) -> F128Bits with Mut, Panic, Div {
    let sa = sf_unpack_sign(a.hi)
    let ea = sf_unpack_exp(a.hi)
    let fa = sf_unpack_frac(a.lo, a.hi)
    sf_pack(1 - sa, ea, fa)
}

/// Three-way IEEE comparison: -1 (a < b), 0 (a == b, incl. ±0), 1 (a > b),
/// 2 = unordered (either operand NaN).
pub fn f128_bits_soft_cmp(a: F128Bits, b: F128Bits) -> i64 with Mut, Panic, Div {
    let sa = sf_unpack_sign(a.hi)
    let ea = sf_unpack_exp(a.hi)
    let fa = sf_unpack_frac(a.lo, a.hi)
    let sb = sf_unpack_sign(b.hi)
    let eb = sf_unpack_exp(b.hi)
    let fb = sf_unpack_frac(b.lo, b.hi)
    if sf_is_nan(ea, fa) || sf_is_nan(eb, fb) { return 2 }
    let za = sf_is_zero(ea, fa)
    let zb = sf_is_zero(eb, fb)
    if za && zb { return 0 }
    if sa != sb {
        if sa == 1 { return 0 - 1 }
        return 1
    }
    var mag: i64 = 0
    if ea > eb {
        mag = 1
    } else if ea < eb {
        mag = 0 - 1
    } else {
        mag = sf_u128_cmp(fa, fb)
    }
    if sa == 1 { return 0 - mag }
    mag
}

/// Language `f128` `<` (V0-E.5.2 desugar target). NaN → false.
pub fn f128_bits_soft_lt(a: F128Bits, b: F128Bits) -> bool with Mut, Panic, Div {
    f128_bits_soft_cmp(a, b) == 0 - 1
}

/// Language `f128` `<=`. NaN → false.
pub fn f128_bits_soft_le(a: F128Bits, b: F128Bits) -> bool with Mut, Panic, Div {
    let c = f128_bits_soft_cmp(a, b)
    c == 0 - 1 || c == 0
}

/// Language `f128` `>`. NaN → false.
pub fn f128_bits_soft_gt(a: F128Bits, b: F128Bits) -> bool with Mut, Panic, Div {
    f128_bits_soft_cmp(a, b) == 1
}

/// Language `f128` `>=`. NaN → false.
pub fn f128_bits_soft_ge(a: F128Bits, b: F128Bits) -> bool with Mut, Panic, Div {
    let c = f128_bits_soft_cmp(a, b)
    c == 1 || c == 0
}

/// Language `f128` `==`. NaN → false; +0 == -0.
pub fn f128_bits_soft_eq(a: F128Bits, b: F128Bits) -> bool with Mut, Panic, Div {
    f128_bits_soft_cmp(a, b) == 0
}

/// Language `f128` `!=`. NaN → true.
pub fn f128_bits_soft_ne(a: F128Bits, b: F128Bits) -> bool with Mut, Panic, Div {
    f128_bits_soft_cmp(a, b) != 0
}

/// Four-limb ABI for V0-E.5.2 language `f128` `*` (seed-run gate surface).
pub fn f128_soft_mul_limbs(a_lo: i64, a_hi: i64, b_lo: i64, b_hi: i64) -> F128Bits with Mut, Panic, Div {
    f128_bits_soft_mul(F128Bits { lo: a_lo, hi: a_hi }, F128Bits { lo: b_lo, hi: b_hi })
}

/// Four-limb ABI for V0-E.5.1 language `f128` `+` (compiler desugar).
pub fn f128_soft_add_limbs(a_lo: i64, a_hi: i64, b_lo: i64, b_hi: i64) -> F128Bits with Mut, Panic, Div {
    f128_bits_soft_add(F128Bits { lo: a_lo, hi: a_hi }, F128Bits { lo: b_lo, hi: b_hi })
}

/// Four-limb ABI for V0-E.5.1 language `f128` `-`.
pub fn f128_soft_sub_limbs(a_lo: i64, a_hi: i64, b_lo: i64, b_hi: i64) -> F128Bits with Mut, Panic, Div {
    f128_bits_soft_sub(F128Bits { lo: a_lo, hi: a_hi }, F128Bits { lo: b_lo, hi: b_hi })
}

/// Language `f128` constructor from IEEE limbs. Call sites are intercepted by
/// Madaros lower (V0-E.5.1); the body is a placeholder and must not run.
pub fn f128_from_limbs(lo: i64, hi: i64) -> f128 {
    let z: f128 = 0.0
    z
}

/// Extract LSW limb. Call sites are intercepted by Madaros lower (V0-E.5.1).
pub fn f128_to_lo(x: f128) -> i64 {
    0
}

/// Extract MSW limb. Call sites are intercepted by Madaros lower (V0-E.5.1).
pub fn f128_to_hi(x: f128) -> i64 {
    0
}
