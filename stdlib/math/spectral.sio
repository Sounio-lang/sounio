// stdlib/math/spectral.sio — Spectral methods for differential equations
//
// Pure Sounio implementations:
//   Chebyshev-Gauss-Lobatto collocation points
//   Chebyshev differentiation matrices (1st and 2nd order)
//   Mapped Chebyshev methods on [a,b]
//   Spectral BVP solver for 2nd-order ODEs
//   Spectral eigenvalue solver (Sturm-Liouville)
//   Fourier differentiation matrices (periodic domains)
//   Clenshaw-Curtis quadrature
//   Spectral interpolation
//
// References:
//   Trefethen (2000): "Spectral Methods in MATLAB"
//   Boyd (2001): "Chebyshev and Fourier Spectral Methods"
//   Canuto et al. (2006): "Spectral Methods: Fundamentals"

// =============================================================================
// Helpers (all prefixed sp_ to avoid collisions)
// =============================================================================

fn sp_abs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }
fn sp_max(a: f64, b: f64) -> f64 { if a > b { a } else { b } }
fn sp_min(a: f64, b: f64) -> f64 { if a < b { a } else { b } }

fn sp_pi() -> f64 { 3.14159265358979323846 }

fn sp_sqrt(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 20 { y = 0.5 * (y + x / y); i = i + 1 }
    y
}

fn sp_sin(x: f64) -> f64 with Mut, Div, Panic {
    var a = x
    let tp = 6.28318530717958647692
    while a >= tp { a = a - tp }
    while a < 0.0 { a = a + tp }
    if a > 3.14159265358979323846 { a = a - tp }
    let a2 = a * a
    var sum = a
    var term = a
    var n = 1
    while n < 18 { term = 0.0 - term * a2 / ((2 * n) * (2 * n + 1)) as f64; sum = sum + term; n = n + 1 }
    sum
}

fn sp_cos(x: f64) -> f64 with Mut, Div, Panic {
    sp_sin(x + 1.57079632679489661923)
}

fn sp_exp(x: f64) -> f64 with Mut, Div, Panic {
    // Range reduction: e^x = 2^k * e^r, where r = x - k*ln(2)
    let ln2 = 0.6931471805599453
    var k_f = x / ln2
    var k: i32 = 0
    if k_f >= 0.0 { k = k_f as i32 } else { k = (k_f as i32) - 1 }
    let r = x - (k as f64) * ln2
    // Taylor series for e^r, |r| < ln(2)
    var sum = 1.0
    var term = 1.0
    var n = 1
    while n < 25 { term = term * r / (n as f64); sum = sum + term; n = n + 1 }
    // Multiply by 2^k
    var result = sum
    if k >= 0 {
        var i = 0
        while i < k { result = result * 2.0; i = i + 1 }
    } else {
        var i = 0
        while i < (0 - k) { result = result * 0.5; i = i + 1 }
    }
    result
}

fn sp_ln(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 - 1.0e30 }
    // Reduce to [1, 2): x = m * 2^e, ln(x) = ln(m) + e*ln(2)
    let ln2 = 0.6931471805599453
    var m = x
    var e: i32 = 0
    while m >= 2.0 { m = m * 0.5; e = e + 1 }
    while m < 1.0 { m = m * 2.0; e = e - 1 }
    // Now m in [1, 2). Use series: ln(m) = 2 * sum_{k=0}^{inf} ((m-1)/(m+1))^{2k+1} / (2k+1)
    let t = (m - 1.0) / (m + 1.0)
    let t2 = t * t
    var sum = t
    var power = t
    var k = 1
    while k < 30 { power = power * t2; sum = sum + power / (2 * k + 1) as f64; k = k + 1 }
    2.0 * sum + (e as f64) * ln2
}

// =============================================================================
// Gaussian elimination with partial pivoting
// =============================================================================

// Solve A*x = b for x, where A is n x n stored row-major in flat array.
// Overwrites A and b in place; result stored in x.
fn sp_gauss_solve(A: &![f64; 4096], b: &![f64; 256], x: &![f64; 256], n: i32) with Mut, Div, Panic {
    // Forward elimination with partial pivoting
    var col = 0
    while col < n {
        // Find pivot
        var max_val = sp_abs(A[col * n + col])
        var max_row = col
        var row = col + 1
        while row < n {
            let val = sp_abs(A[row * n + col])
            if val > max_val { max_val = val; max_row = row }
            row = row + 1
        }

        // Swap rows col and max_row in A and b
        if max_row != col {
            var j = 0
            while j < n {
                let tmp = A[col * n + j]
                A[col * n + j] = A[max_row * n + j]
                A[max_row * n + j] = tmp
                j = j + 1
            }
            let tmp_b = b[col]
            b[col] = b[max_row]
            b[max_row] = tmp_b
        }

        // Eliminate below
        let pivot = A[col * n + col]
        if sp_abs(pivot) < 1.0e-30 {
            col = col + 1
            // Skip singular column
        } else {
            row = col + 1
            while row < n {
                let factor = A[row * n + col] / pivot
                var j = col + 1
                while j < n {
                    A[row * n + j] = A[row * n + j] - factor * A[col * n + j]
                    j = j + 1
                }
                A[row * n + col] = 0.0
                b[row] = b[row] - factor * b[col]
                row = row + 1
            }
            col = col + 1
        }
    }

    // Back substitution
    var i = n - 1
    while i >= 0 {
        var sum = b[i]
        var j = i + 1
        while j < n { sum = sum - A[i * n + j] * x[j]; j = j + 1 }
        if sp_abs(A[i * n + i]) < 1.0e-30 {
            x[i] = 0.0
        } else {
            x[i] = sum / A[i * n + i]
        }
        i = i - 1
    }
}

// =============================================================================
// Chebyshev-Gauss-Lobatto nodes
// =============================================================================

// Chebyshev-Gauss-Lobatto collocation points on [-1, 1].
// x_j = cos(j * pi / n), j = 0, ..., n. Stores n+1 points in x[0..n].
fn cheb_nodes(n: i32, x: &![f64; 256]) with Panic, Mut, Div {
    var j = 0
    while j <= n {
        x[j] = sp_cos((j as f64) * sp_pi() / (n as f64))
        j = j + 1
    }
}

// Chebyshev-Gauss-Lobatto nodes mapped to [a, b].
// x_j = (a+b)/2 + (b-a)/2 * cos(j * pi / n), j = 0, ..., n.
fn cheb_nodes_ab(n: i32, a: f64, b: f64, x: &![f64; 256]) with Panic, Mut, Div {
    let mid = 0.5 * (a + b)
    let half = 0.5 * (b - a)
    var j = 0
    while j <= n {
        x[j] = mid + half * sp_cos((j as f64) * sp_pi() / (n as f64))
        j = j + 1
    }
}

// =============================================================================
// Chebyshev differentiation matrix (1st order)
// =============================================================================

// Build (n+1) x (n+1) Chebyshev differentiation matrix on [-1, 1].
// Stored row-major in D[i * (n+1) + j]. Uses Trefethen's formula.
//
// D_{ij} = c_i * (-1)^{i+j} / (c_j * (x_i - x_j))   for i != j
// D_{ii} = -x_i / (2 * (1 - x_i^2))                   for 0 < i < n
// D_{00} = (2*n^2 + 1) / 6
// D_{nn} = -(2*n^2 + 1) / 6
//
// where c_0 = c_n = 2, c_j = 1 otherwise.
fn cheb_diffmat(n: i32, D: &![f64; 4096]) with Panic, Mut, Div {
    let np = n + 1

    // Compute CGL nodes
    var x: [f64; 256] = [0.0; 256]
    var j = 0
    while j <= n { x[j] = sp_cos((j as f64) * sp_pi() / (n as f64)); j = j + 1 }

    // c_i coefficients: c_0 = c_n = 2, rest = 1
    var c: [f64; 256] = [0.0; 256]
    var i = 0
    while i <= n { c[i] = 1.0; i = i + 1 }
    c[0] = 2.0
    c[n] = 2.0

    // Fill matrix
    i = 0
    while i <= n {
        j = 0
        while j <= n {
            if i != j {
                // (-1)^{i+j}
                var sign = 1.0
                if (i + j) - ((i + j) / 2) * 2 != 0 { sign = 0.0 - 1.0 }
                D[i * np + j] = c[i] * sign / (c[j] * (x[i] - x[j]))
            }
            j = j + 1
        }
        i = i + 1
    }

    // Diagonal entries for interior points: D_{ii} = -x_i / (2*(1 - x_i^2))
    i = 1
    while i < n {
        D[i * np + i] = 0.0 - x[i] / (2.0 * (1.0 - x[i] * x[i]))
        i = i + 1
    }

    // Corner entries
    let n2 = (n as f64) * (n as f64)
    D[0] = (2.0 * n2 + 1.0) / 6.0
    D[n * np + n] = 0.0 - (2.0 * n2 + 1.0) / 6.0
}

// =============================================================================
// Chebyshev differentiation matrix (2nd order)
// =============================================================================

// Second derivative matrix: D2 = D * D (matrix product).
// Both are (n+1) x (n+1) stored row-major.
fn cheb_diffmat2(n: i32, D2: &![f64; 4096]) with Panic, Mut, Div {
    let np = n + 1

    // Build D1 first
    var D1: [f64; 4096] = [0.0; 4096]
    cheb_diffmat(n, &!D1)

    // Matrix multiply: D2 = D1 * D1
    var i = 0
    while i < np {
        var j = 0
        while j < np {
            var sum = 0.0
            var k = 0
            while k < np {
                sum = sum + D1[i * np + k] * D1[k * np + j]
                k = k + 1
            }
            D2[i * np + j] = sum
            j = j + 1
        }
        i = i + 1
    }
}

// =============================================================================
// Mapped Chebyshev differentiation matrices on [a, b]
// =============================================================================

// First derivative matrix mapped to [a, b]: D_ab = (2/(b-a)) * D.
fn cheb_diffmat_ab(n: i32, a: f64, b: f64, D: &![f64; 4096]) with Panic, Mut, Div {
    let np = n + 1
    cheb_diffmat(n, D)
    let scale = 2.0 / (b - a)
    var i = 0
    while i < np {
        var j = 0
        while j < np {
            D[i * np + j] = D[i * np + j] * scale
            j = j + 1
        }
        i = i + 1
    }
}

// Second derivative matrix mapped to [a, b]: D2_ab = (2/(b-a))^2 * D2.
fn cheb_diffmat2_ab(n: i32, a: f64, b: f64, D2: &![f64; 4096]) with Panic, Mut, Div {
    let np = n + 1
    cheb_diffmat2(n, D2)
    let scale = 2.0 / (b - a)
    let scale2 = scale * scale
    var i = 0
    while i < np {
        var j = 0
        while j < np {
            D2[i * np + j] = D2[i * np + j] * scale2
            j = j + 1
        }
        i = i + 1
    }
}

// =============================================================================
// Spectral BVP solver for 2nd-order ODEs
// =============================================================================

// Solve:  -u''(x) + p(x)*u'(x) + q(x)*u(x) = f(x)  on [a, b]
// with boundary conditions u(a) = alpha, u(b) = beta.
//
// Method: Chebyshev collocation. Build the operator matrix
//   L = -D2 + diag(p(x_j)) * D1 + diag(q(x_j))
// at n+1 Chebyshev-Gauss-Lobatto nodes mapped to [a, b].
// Replace rows 0 and n with boundary conditions, then solve the linear system.
//
// Result: u[0..n] contains the solution at the n+1 CGL nodes.
fn spectral_bvp_2nd(n: i32, a: f64, b: f64,
                    p_fn: fn(f64) -> f64 with Mut, Div, Panic,
                    q_fn: fn(f64) -> f64 with Mut, Div, Panic,
                    f_fn: fn(f64) -> f64 with Mut, Div, Panic,
                    alpha: f64, beta: f64,
                    u: &![f64; 256]) with Mut, Div, Panic {
    let np = n + 1

    // Compute CGL nodes on [a, b]
    var x: [f64; 256] = [0.0; 256]
    cheb_nodes_ab(n, a, b, &!x)

    // Build D1 and D2 on [a, b]
    var D1: [f64; 4096] = [0.0; 4096]
    var D2: [f64; 4096] = [0.0; 4096]
    cheb_diffmat_ab(n, a, b, &!D1)
    cheb_diffmat2_ab(n, a, b, &!D2)

    // Build operator matrix L = -D2 + diag(p) * D1 + diag(q)
    var L: [f64; 4096] = [0.0; 4096]
    var i = 0
    while i < np {
        let p_val = p_fn(x[i])
        let q_val = q_fn(x[i])
        var j = 0
        while j < np {
            L[i * np + j] = 0.0 - D2[i * np + j] + p_val * D1[i * np + j]
            j = j + 1
        }
        // Add q(x_i) on diagonal
        L[i * np + i] = L[i * np + i] + q_val
        i = i + 1
    }

    // Build RHS
    var rhs: [f64; 256] = [0.0; 256]
    i = 0
    while i < np { rhs[i] = f_fn(x[i]); i = i + 1 }

    // Apply boundary conditions: replace row 0 and row n
    // Row 0: u(x_0) = alpha. CGL node 0 is cos(0) = 1 -> maps to rightmost
    // Note: CGL nodes are ordered x_0 > x_1 > ... > x_n (decreasing).
    // On [a, b], x_0 = b, x_n = a (since cos(0)=1 -> right end, cos(pi)=-1 -> left end).
    // So u(x_0) = beta (right BC), u(x_n) = alpha (left BC).
    var j = 0
    while j < np { L[0 * np + j] = 0.0; j = j + 1 }
    L[0 * np + 0] = 1.0
    rhs[0] = beta

    j = 0
    while j < np { L[n * np + j] = 0.0; j = j + 1 }
    L[n * np + n] = 1.0
    rhs[n] = alpha

    // Solve the linear system L * u = rhs
    sp_gauss_solve(&!L, &!rhs, u, np)
}

// =============================================================================
// Arctangent helpers (needed by eigenvalue solver — must precede caller)
// =============================================================================

// Core atan Taylor series for |t| <= 1: atan(t) = t - t^3/3 + t^5/5 - ...
fn sp_atan_core(t: f64) -> f64 with Panic, Mut, Div {
    let t2 = t * t
    var sum = t
    var power = t
    var k = 1
    while k < 30 {
        power = 0.0 - power * t2
        sum = sum + power / (2 * k + 1) as f64
        k = k + 1
    }
    sum
}

// Arctangent via series: atan(t) for any t.
// Uses identity: for |t| > 1, atan(t) = pi/2 - atan(1/t).
fn sp_atan_series(t: f64) -> f64 with Mut, Div, Panic {
    if sp_abs(t) > 1.0 {
        let inv = 1.0 / t
        let a = sp_atan_core(inv)
        if t > 0.0 { return sp_pi() / 2.0 - a }
        return 0.0 - sp_pi() / 2.0 - a
    }
    sp_atan_core(t)
}

// Helper: atan2 via series.
fn sp_atan2(y: f64, x: f64) -> f64 with Mut, Div, Panic {
    if sp_abs(x) < 1.0e-30 {
        if y > 0.0 { return sp_pi() / 2.0 }
        if y < 0.0 { return 0.0 - sp_pi() / 2.0 }
        return 0.0
    }
    let ratio = y / x
    var a = sp_atan_series(ratio)
    if x < 0.0 {
        if y >= 0.0 { a = a + sp_pi() } else { a = a - sp_pi() }
    }
    a
}

// =============================================================================
// Spectral eigenvalue solver (Sturm-Liouville)
// =============================================================================

// Find eigenvalues of the Sturm-Liouville problem:
//   -u''(x) + V(x)*u(x) = lambda * u(x)  on [a, b]
//   u(a) = 0, u(b) = 0
//
// Method: Build the operator L = -D2 + diag(V(x_j)) at interior CGL nodes
// (rows/columns 1..n-1, removing boundary points 0 and n).
// Solve the (n-1) x (n-1) symmetric eigenvalue problem using the Jacobi method.
//
// Returns sorted eigenvalues in eigenvalues[0..n_found-1].
fn spectral_eigval(n: i32, a: f64, b: f64,
                   V_fn: fn(f64) -> f64 with Mut, Div, Panic,
                   eigenvalues: &![f64; 256],
                   n_found: &!i32) with Mut, Div, Panic {
    let np = n + 1

    // Compute CGL nodes on [a, b]
    var x: [f64; 256] = [0.0; 256]
    cheb_nodes_ab(n, a, b, &!x)

    // Build D2 on [a, b]
    var D2: [f64; 4096] = [0.0; 4096]
    cheb_diffmat2_ab(n, a, b, &!D2)

    // Build reduced operator matrix: L_int = -D2_int + diag(V)
    // Interior points are indices 1..n-1, so dimension is m = n-1
    let m = n - 1
    if m <= 0 { n_found[0] = 0; return }

    // Extract interior block into a flat m x m matrix
    var L: [f64; 4096] = [0.0; 4096]
    var i = 0
    while i < m {
        var j = 0
        while j < m {
            // Map interior index (i, j) to full index (i+1, j+1)
            L[i * m + j] = 0.0 - D2[(i + 1) * np + (j + 1)]
            j = j + 1
        }
        // Add potential on diagonal
        L[i * m + i] = L[i * m + i] + V_fn(x[i + 1])
        i = i + 1
    }

    // Jacobi eigenvalue algorithm for symmetric matrices
    // Iteratively apply Givens rotations to diagonalize L
    var max_iter = 100 * m * m
    if max_iter > 100000 { max_iter = 100000 }
    var iter = 0
    while iter < max_iter {
        // Find largest off-diagonal element
        var max_off = 0.0
        var p = 0
        var q = 1
        i = 0
        while i < m {
            var j = i + 1
            while j < m {
                let val = sp_abs(L[i * m + j])
                if val > max_off { max_off = val; p = i; q = j }
                j = j + 1
            }
            i = i + 1
        }

        // Convergence check
        if max_off < 1.0e-12 { iter = max_iter }
        else {
            // Compute rotation angle
            let app = L[p * m + p]
            let aqq = L[q * m + q]
            let apq = L[p * m + q]

            var theta = 0.0
            let diff = aqq - app
            if sp_abs(diff) < 1.0e-30 {
                theta = sp_pi() / 4.0
            } else {
                theta = 0.5 * sp_atan2(2.0 * apq, diff)
            }

            let cos_t = sp_cos(theta)
            let sin_t = sp_sin(theta)

            // Apply rotation: update rows and columns p, q
            // For each row k: update L[k,p] and L[k,q]
            var k = 0
            while k < m {
                if k != p && k != q {
                    let lkp = L[k * m + p]
                    let lkq = L[k * m + q]
                    L[k * m + p] = cos_t * lkp + sin_t * lkq
                    L[k * m + q] = 0.0 - sin_t * lkp + cos_t * lkq
                    L[p * m + k] = L[k * m + p]
                    L[q * m + k] = L[k * m + q]
                }
                k = k + 1
            }

            // Update diagonal and off-diagonal at (p, q)
            let new_pp = cos_t * cos_t * app + 2.0 * cos_t * sin_t * apq + sin_t * sin_t * aqq
            let new_qq = sin_t * sin_t * app - 2.0 * cos_t * sin_t * apq + cos_t * cos_t * aqq
            L[p * m + p] = new_pp
            L[q * m + q] = new_qq
            L[p * m + q] = 0.0
            L[q * m + p] = 0.0

            iter = iter + 1
        }
    }

    // Extract eigenvalues from diagonal
    i = 0
    while i < m { eigenvalues[i] = L[i * m + i]; i = i + 1 }

    // Sort eigenvalues (insertion sort, ascending)
    i = 1
    while i < m {
        let key = eigenvalues[i]
        var j = i - 1
        while j >= 0 && eigenvalues[j] > key {
            eigenvalues[j + 1] = eigenvalues[j]
            j = j - 1
        }
        eigenvalues[j + 1] = key
        i = i + 1
    }

    n_found[0] = m
}

// =============================================================================
// Fourier differentiation matrix (1st order)
// =============================================================================

// n x n differentiation matrix for periodic domain [0, 2*pi) with h = 2*pi/n.
// D_{ij} = 0.5 * (-1)^{i+j} * cot((i-j)*h/2)   for i != j
// D_{ii} = 0
//
// Reference: Trefethen (2000), Chapter 3.
fn fourier_diffmat(n: i32, D: &![f64; 4096]) with Panic, Mut, Div {
    let h = 2.0 * sp_pi() / (n as f64)

    var i = 0
    while i < n {
        var j = 0
        while j < n {
            if i == j {
                D[i * n + j] = 0.0
            } else {
                let diff = i - j
                // (-1)^{i+j}: same parity as diff
                var sign = 1.0
                let abs_diff = if diff > 0 { diff } else { 0 - diff }
                if abs_diff - (abs_diff / 2) * 2 != 0 { sign = 0.0 - 1.0 }

                let arg = (diff as f64) * h / 2.0
                let sin_val = sp_sin(arg)
                let cos_val = sp_cos(arg)

                if sp_abs(sin_val) < 1.0e-30 {
                    D[i * n + j] = 0.0
                } else {
                    D[i * n + j] = 0.5 * sign * cos_val / sin_val
                }
            }
            j = j + 1
        }
        i = i + 1
    }
}

// =============================================================================
// Fourier differentiation matrix (2nd order)
// =============================================================================

// Second derivative matrix for periodic domain [0, 2*pi).
// D2_{ij} = -0.5 * (-1)^{i+j} / sin^2((i-j)*h/2)   for i != j
// D2_{ii} = -(n^2 - 1)/12 for odd n, or -(n^2)/12 for even n.
//
// Reference: Trefethen (2000), Eq. (3.7).
fn fourier_diffmat2(n: i32, D2: &![f64; 4096]) with Panic, Mut, Div {
    let h = 2.0 * sp_pi() / (n as f64)

    // Determine if n is even or odd
    let n_even = (n - (n / 2) * 2) == 0

    var i = 0
    while i < n {
        var j = 0
        while j < n {
            if i == j {
                if n_even {
                    D2[i * n + j] = 0.0 - (n as f64) * (n as f64) / 12.0
                } else {
                    D2[i * n + j] = 0.0 - ((n as f64) * (n as f64) - 1.0) / 12.0
                }
            } else {
                let diff = i - j
                let abs_diff = if diff > 0 { diff } else { 0 - diff }
                var sign = 1.0
                if abs_diff - (abs_diff / 2) * 2 != 0 { sign = 0.0 - 1.0 }

                let arg = (diff as f64) * h / 2.0
                let sin_val = sp_sin(arg)
                let sin2 = sin_val * sin_val

                if sp_abs(sin2) < 1.0e-30 {
                    D2[i * n + j] = 0.0
                } else {
                    D2[i * n + j] = 0.0 - 0.5 * sign / sin2
                }
            }
            j = j + 1
        }
        i = i + 1
    }
}

// =============================================================================
// Clenshaw-Curtis quadrature weights
// =============================================================================

// Compute Clenshaw-Curtis quadrature weights for n+1 Chebyshev-Gauss-Lobatto
// points on [-1, 1].
//
// w_j = (c_j / n) * sum_{k=0}^{floor(n/2)} b_k * cos(2*k*j*pi/n)
// where b_0 = 1, b_{n/2} = 1, b_k = 2 for 0 < k < n/2,
// and the sum terms include the factor 1/(1 - 4*k^2).
//
// Reference: Trefethen (2000), Chapter 12; Waldvogel (2006).
fn cc_weights(n: i32, w: &![f64; 256]) with Panic, Mut, Div {
    // Special cases
    if n == 0 { w[0] = 2.0; return }
    if n == 1 { w[0] = 1.0; w[1] = 1.0; return }

    let np = n + 1

    // Compute theta_j values
    // theta_j = j * pi / n

    // Compute weights using the formula:
    // w_j = (2/n) * sum_{k=0}^{n/2} '' cos(2*k*j*pi / n) / (1 - 4*k^2)
    // where '' means first and last terms halved.
    let half_n = n / 2

    var j = 0
    while j <= n {
        var sum = 0.0
        var k = 0
        while k <= half_n {
            let denom = 1.0 - 4.0 * (k as f64) * (k as f64)
            let theta = 2.0 * (k as f64) * (j as f64) * sp_pi() / (n as f64)
            var term = sp_cos(theta) / denom

            // Double-prime sum: halve first and last terms
            if k == 0 { term = term * 0.5 }
            if k == half_n { term = term * 0.5 }

            sum = sum + term
            k = k + 1
        }

        w[j] = 2.0 * sum / (n as f64)
        j = j + 1
    }
}

// =============================================================================
// Clenshaw-Curtis integration on [-1, 1]
// =============================================================================

// Integrate f(x) on [-1, 1] given function values at n+1 CGL points.
// f_vals[j] = f(x_j) where x_j = cos(j*pi/n), j = 0, ..., n.
// Returns the integral approximation.
fn cc_integrate(f_vals: &[f64; 256], n: i32) -> f64 with Panic, Mut, Div {
    var w: [f64; 256] = [0.0; 256]
    cc_weights(n, &!w)

    var sum = 0.0
    var j = 0
    while j <= n {
        sum = sum + w[j] * f_vals[j]
        j = j + 1
    }
    sum
}

// =============================================================================
// Clenshaw-Curtis integration on [a, b]
// =============================================================================

// Integrate f(x) on [a, b] via Clenshaw-Curtis.
// f_vals[j] = f(x_j) where x_j are CGL nodes mapped to [a, b].
// Scaling: integral on [a,b] = (b-a)/2 * integral on [-1,1].
fn cc_integrate_ab(f_vals: &[f64; 256], n: i32, a: f64, b: f64) -> f64 with Panic, Mut, Div {
    let scale = 0.5 * (b - a)
    let I_ref = cc_integrate(f_vals, n)
    scale * I_ref
}

// =============================================================================
// Spectral (barycentric Chebyshev) interpolation on [-1, 1]
// =============================================================================

// Barycentric Chebyshev interpolation at an arbitrary point x in [-1, 1].
// f_vals[j] = f(x_j) at the n+1 CGL nodes x_j = cos(j*pi/n), j = 0, ..., n.
//
// Uses the second barycentric form with weights:
//   w_j = (-1)^j * delta_j, where delta_0 = delta_n = 0.5, delta_j = 1 otherwise.
//
// p(x) = sum_j w_j * f_j / (x - x_j)  /  sum_j w_j / (x - x_j)
//
// Reference: Berrut & Trefethen (2004), SIAM Review.
fn cheb_interpolate(f_vals: &[f64; 256], n: i32, x: f64) -> f64 with Panic, Mut, Div {
    // Compute CGL nodes
    var nodes: [f64; 256] = [0.0; 256]
    var j = 0
    while j <= n { nodes[j] = sp_cos((j as f64) * sp_pi() / (n as f64)); j = j + 1 }

    // Check if x coincides with a node
    j = 0
    while j <= n {
        if sp_abs(x - nodes[j]) < 1.0e-15 { return f_vals[j] }
        j = j + 1
    }

    // Barycentric interpolation
    var numer = 0.0
    var denom = 0.0
    j = 0
    while j <= n {
        // w_j = (-1)^j * delta_j
        var w = 1.0
        if j - (j / 2) * 2 != 0 { w = 0.0 - 1.0 }
        if j == 0 || j == n { w = w * 0.5 }

        let term = w / (x - nodes[j])
        numer = numer + term * f_vals[j]
        denom = denom + term
        j = j + 1
    }
    numer / denom
}

// =============================================================================
// Spectral interpolation on [a, b]
// =============================================================================

// Barycentric Chebyshev interpolation mapped to [a, b].
// Maps x from [a, b] to xi in [-1, 1] via xi = (2*x - a - b) / (b - a).
fn cheb_interpolate_ab(f_vals: &[f64; 256], n: i32, a: f64, b: f64, x: f64) -> f64 with Panic, Mut, Div {
    let xi = (2.0 * x - a - b) / (b - a)
    cheb_interpolate(f_vals, n, xi)
}

// =============================================================================
// Chebyshev coefficients from function values (DCT-I)
// =============================================================================

// Compute Chebyshev expansion coefficients from function values at CGL points.
// Given f_vals[j] = f(x_j) at n+1 CGL nodes, compute coefficients a_k such that
//   f(x) approx sum_{k=0}^{n} a_k * T_k(x)
//
// Using the DCT-I relation:
//   a_k = (2/n) * sum_{j=0}^{n} '' f(x_j) * cos(k*j*pi/n)
// where '' means first and last terms halved.
fn cheb_coeffs_from_values(f_vals: &[f64; 256], n: i32, coeffs: &![f64; 256]) with Panic, Mut, Div {
    var k = 0
    while k <= n {
        var sum = 0.0
        var j = 0
        while j <= n {
            let theta = (k as f64) * (j as f64) * sp_pi() / (n as f64)
            var term = f_vals[j] * sp_cos(theta)

            // Double-prime: halve j=0 and j=n terms
            if j == 0 { term = term * 0.5 }
            if j == n { term = term * 0.5 }

            sum = sum + term
            j = j + 1
        }

        coeffs[k] = 2.0 * sum / (n as f64)
        k = k + 1
    }

    // The k=0 and k=n coefficients have an extra factor of 0.5
    coeffs[0] = coeffs[0] * 0.5
    if n > 0 { coeffs[n] = coeffs[n] * 0.5 }
}

// =============================================================================
// Clenshaw recurrence evaluation from Chebyshev coefficients
// =============================================================================

// Evaluate the Chebyshev expansion sum_{k=0}^{n} a_k * T_k(x) at point x
// using Clenshaw's recurrence algorithm.
//
// Clenshaw recurrence:
//   b_{n+2} = 0, b_{n+1} = 0
//   b_k = 2*x*b_{k+1} - b_{k+2} + a_k,  k = n, n-1, ..., 1
//   result = a_0 + x*b_1 - b_2
//
// This is numerically stable and O(n).
fn cheb_eval_from_coeffs(coeffs: &[f64; 256], n: i32, x: f64) -> f64 with Panic, Mut, Div {
    if n == 0 { return coeffs[0] }
    if n == 1 { return coeffs[0] + coeffs[1] * x }

    var b_next = 0.0    // b_{k+2}
    var b_curr = 0.0    // b_{k+1}

    var k = n
    while k >= 1 {
        let b_new = 2.0 * x * b_curr - b_next + coeffs[k]
        b_next = b_curr
        b_curr = b_new
        k = k - 1
    }

    // result = a_0 + x*b_1 - b_2
    coeffs[0] + x * b_curr - b_next
}
