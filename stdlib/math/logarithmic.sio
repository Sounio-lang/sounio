// Checked logarithmic increments and cancellation kernels. See LOGARITHMIC.md.
// Into variants reuse caller-owned CheckedLog storage; legacy wrappers own one
// fresh local result. No into/helper allocates a result record.
use math::pure::{CheckedLog,is_finite,ln_checked_into}

fn logarithmic_input_status(x:f64)->i64 {
 if !is_finite(x) {return 2}
 if x<= -1.0 {return 1}
 0
}
fn logarithmic_unavailable_into(status:i64,out:&!CheckedLog)->i64 with Mut {
 out.status=status;out.value=0.0;status
}
fn logarithmic_abs(x:f64)->f64 {if x<0.0 {-x} else {x}}

pub fn log1p_checked_into(x:f64,out:&!CheckedLog)->i64 with Mut,Div {
 out.status=2;out.value=0.0
 let status=logarithmic_input_status(x)
 if status!=0 {return logarithmic_unavailable_into(status,out)}
 let magnitude=logarithmic_abs(x)
 // Before halving: preserve tiny represented increments and signed zero.
 if magnitude<1.0e-16 {out.status=0;out.value=x;return 0}
 var value:f64=0.0
 if magnitude<=0.5 {
  let t=x/(2.0+x)
  let square=t*t
  var term=t
  var sum=t
  var correction:f64=0.0
  var k:i64=1
  while k<32 {
   term=term*square
   let contribution=term/((2*k+1) as f64)
   let adjusted=contribution-correction
   let next=sum+adjusted
   correction=(next-sum)-adjusted
   sum=next
   k=k+1
  }
  value=2.0*sum
 } else {
  let u=1.0+x
  let logged_status=ln_checked_into(u,out)
  if logged_status!=0 {return logarithmic_unavailable_into(logged_status,out)}
  let logged_value:f64=out.value
  // Low part of the addition, ordered by the larger addend.
  let low=if x>1.0 {1.0-(u-x)} else {x-(u-1.0)}
  value=logged_value+low/u
 }
 if !is_finite(value) {return logarithmic_unavailable_into(2,out)}
 out.status=0;out.value=value;0
}
pub fn log1p_checked(x:f64)->CheckedLog with Mut,Div {
 var out=CheckedLog{status:2,value:0.0}
 let ignored=log1p_checked_into(x,&!out)
 out
}

// ln(1+x)-x: do not subtract the linear term close to zero.
pub fn log1pmx_checked_into(x:f64,out:&!CheckedLog)->i64 with Mut,Div {
 out.status=2;out.value=0.0
 let status=logarithmic_input_status(x)
 if status!=0 {return logarithmic_unavailable_into(status,out)}
 if x==0.0 {out.status=0;out.value=0.0;return 0}
 var value:f64=0.0
 if logarithmic_abs(x)<=0.25 {
  // Factor the degree-32 series before multiplying by x twice.
  var term:f64= -0.5
  var factor=term
  var correction:f64=0.0
  var n:i64=2
  while n<32 {
   term=((-term*x)*(n as f64))/((n+1) as f64)
   let adjusted=term-correction
   let next=factor+adjusted
   correction=(next-factor)-adjusted
   factor=next
   n=n+1
  }
  value=x*(x*factor)
 } else {
  let logged_status=log1p_checked_into(x,out)
  if logged_status!=0 {return logarithmic_unavailable_into(logged_status,out)}
  let logged_value:f64=out.value
  value=logged_value-x
 }
 if !is_finite(value) || value>0.0 {return logarithmic_unavailable_into(2,out)}
 // Quadratic results normalize all represented zeros to +0.
 if value==0.0 {out.status=0;out.value=0.0;return 0}
 out.status=0;out.value=value;0
}
pub fn log1pmx_checked(x:f64)->CheckedLog with Mut,Div {
 var out=CheckedLog{status:2,value:0.0}
 let ignored=log1pmx_checked_into(x,&!out)
 out
}

// (1+x)ln(1+x)-x, shared by local Poisson deviance and generalized KL.
// Common domain is x>-1; callers retain their exact count/probability-zero cases.
pub fn log1p_phi_checked_into(x:f64,out:&!CheckedLog)->i64 with Mut,Div {
 out.status=2;out.value=0.0
 let status=logarithmic_input_status(x)
 if status!=0 {return logarithmic_unavailable_into(status,out)}
 if x==0.0 {out.status=0;out.value=0.0;return 0}
 var value:f64=0.0
 if logarithmic_abs(x)<=0.25 {
  var term:f64=0.5
  var factor=term
  var correction:f64=0.0
  var n:i64=2
  while n<32 {
   term=((-term*x)*((n-1) as f64))/((n+1) as f64)
   let adjusted=term-correction
   let next=factor+adjusted
   correction=(next-factor)-adjusted
   factor=next
   n=n+1
  }
  value=x*(x*factor)
 } else {
  let logged_status=log1p_checked_into(x,out)
  if logged_status!=0 {return logarithmic_unavailable_into(logged_status,out)}
  let logged_value:f64=out.value
  value=(1.0+x)*logged_value-x
 }
 if !is_finite(value) || value<0.0 {return logarithmic_unavailable_into(2,out)}
 if value==0.0 {out.status=0;out.value=0.0;return 0}
 out.status=0;out.value=value;0
}
pub fn log1p_phi_checked(x:f64)->CheckedLog with Mut,Div {
 var out=CheckedLog{status:2,value:0.0}
 let ignored=log1p_phi_checked_into(x,&!out)
 out
}
