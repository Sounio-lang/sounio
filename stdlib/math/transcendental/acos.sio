// Implicit import target for a bare `acos(x)` under Madaros (#2507).
//
// acos(x) = 2 atan(sqrt(1 - x^2) / (1 + x)), with 1 - x^2 formed as
// (1 - x)(1 + x). Computing it as pi/2 - asin(x) instead cancels badly as
// x -> 1, where the answer is small and pi/2 and asin(x) agree in most digits.
// x = -1 would divide by zero, so it returns pi directly.
//
// Outside [-1, 1] the result is NaN, as in C.
use math::transcendental::kernel::{transcendental_atan_core}

pub fn acos(x: f64) -> f64 {
    if x != x {
        return x
    }
    if x > 1.0 || x < 0.0 - 1.0 {
        return (x - x) / (x - x)
    }
    if x == 0.0 - 1.0 {
        return 3.141592653589793
    }
    let r = sqrt((1.0 - x) * (1.0 + x))
    2.0 * transcendental_atan_core(r / (1.0 + x))
}
