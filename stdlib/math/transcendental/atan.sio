// Implicit import target for a bare `atan(x)` under Madaros (#2507).
//
// The module defines exactly one public name. Madaros loads it only when a
// program calls `atan` and no loaded module defines a function of that name, so
// a user's own `atan` (or `use math::pure::{atan}`) is never shadowed.
use math::transcendental::kernel::{transcendental_atan_core}

pub fn atan(x: f64) -> f64 {
    transcendental_atan_core(x)
}
