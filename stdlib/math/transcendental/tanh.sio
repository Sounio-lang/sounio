// Implicit import target for a bare `tanh(x)` under Madaros (#2507).
//
// The obvious (exp(2x) - 1) / (exp(2x) + 1) loses every digit near 0, where
// exp(2x) - 1 cancels. Two regimes instead, neither of which subtracts nearly
// equal numbers:
//   |x| < 1  : sinh(|x|) from its Taylor series (all terms positive), then
//              tanh = sinh / sqrt(1 + sinh^2).
//   |x| >= 1 : e = exp(-2|x|) <= e^-2, tanh = (1 - e) / (1 + e).
// Past |x| = 22 the answer rounds to +-1 (1 - tanh(22) ~= 1.5e-19 < ulp/2).
// tanh is odd, so the sign is applied last and -0.0 is preserved.
pub fn tanh(x: f64) -> f64 {
    if x != x {
        return x
    }
    var a = x
    var sign: f64 = 1.0
    if a < 0.0 {
        a = 0.0 - a
        sign = 0.0 - 1.0
    }
    if a > 22.0 {
        return sign
    }
    if a < 1.0 {
        // sinh(a)/a = 1 + a^2/(2*3) (1 + a^2/(4*5) (1 + a^2/(6*7) (...))).
        // Thirteen levels: the last factor is a^2/(26*27) and the truncated
        // tail is below 1/27! ~= 9e-29.
        let a2 = a * a
        var s: f64 = 0.0
        var k: i64 = 13
        while k >= 1 {
            s = a2 / (((2 * k) * (2 * k + 1)) as f64) * (1.0 + s)
            k = k - 1
        }
        let sh = a * (1.0 + s)
        return sign * (sh / sqrt(1.0 + sh * sh))
    }
    let e = exp(0.0 - 2.0 * a)
    sign * ((1.0 - e) / (1.0 + e))
}
