// Implicit import target for a bare `asin(x)` under Madaros (#2507).
//
// asin(x) = 2 atan(x / (1 + sqrt(1 - x^2))), with 1 - x^2 formed as
// (1 - x)(1 + x). The denominator is at least 1 on the whole domain, so this
// stays accurate as |x| -> 1, where the textbook atan(x / sqrt(1 - x^2)) divides
// by a cancelled difference. asin(+-1) = +-pi/2 exactly as 2 atan(+-1).
//
// Outside [-1, 1] the result is NaN, as in C. Clamping to +-pi/2 (what
// math::pure::asin does) would hand back a confident number for an argument
// that has no arcsine.
use math::transcendental::kernel::{transcendental_atan_core}

pub fn asin(x: f64) -> f64 {
    if x != x {
        return x
    }
    if x > 1.0 || x < 0.0 - 1.0 {
        return (x - x) / (x - x)
    }
    let r = sqrt((1.0 - x) * (1.0 + x))
    2.0 * transcendental_atan_core(x / (1.0 + r))
}
