// stdlib/math/wavelet.sio — Discrete Wavelet Transform
//
// Pure Sounio implementations:
//   Haar wavelet (simplest orthogonal wavelet)
//   Daubechies D4 (4-tap, 2 vanishing moments)
//   Daubechies D6 (6-tap, 3 vanishing moments)
//   1D DWT/IDWT (decimated, in-place, max signal length 4096)
//   Multiresolution analysis (decompose to specified level)
//   Wavelet packet transform
//   Wavelet denoising (hard/soft thresholding)
//
// The DWT decomposes a signal into approximation (low-pass) and detail
// (high-pass) coefficients at each level. The IDWT reconstructs from
// these coefficients. Perfect reconstruction is guaranteed for orthogonal
// wavelets when using the correct reconstruction filters.
//
// Filter convention: analysis lowpass h, highpass g (from h by alternating flip).
// Reconstruction: lowpass h_tilde = h, highpass g_tilde = g (orthogonal case).
//
// References:
//   Daubechies (1992): "Ten Lectures on Wavelets"
//   Mallat (2008): "A Wavelet Tour of Signal Processing" 3rd ed.
//   Strang & Nguyen (1996): "Wavelets and Filter Banks"

// =============================================================================
// Helpers
// =============================================================================

fn wav_abs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }
fn wav_max(a: f64, b: f64) -> f64 { if a > b { a } else { b } }
fn wav_min(a: f64, b: f64) -> f64 { if a < b { a } else { b } }

fn wav_sqrt(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 30 { y = 0.5 * (y + x / y); i = i + 1 }
    y
}

// =============================================================================
// Haar wavelet coefficients
// =============================================================================

// Haar lowpass: h = [1/sqrt(2), 1/sqrt(2)]
// Haar highpass: g = [1/sqrt(2), -1/sqrt(2)]

fn haar_h0() -> f64 { 0.7071067811865475 }  // 1/sqrt(2)
fn haar_h1() -> f64 { 0.7071067811865475 }
fn haar_g0() -> f64 { 0.7071067811865475 }
fn haar_g1() -> f64 { 0.0 - 0.7071067811865475 }

// =============================================================================
// Daubechies D4 wavelet coefficients
// =============================================================================

// D4 lowpass filter (4 taps, 2 vanishing moments):
//   h0 = (1 + sqrt(3)) / (4*sqrt(2))
//   h1 = (3 + sqrt(3)) / (4*sqrt(2))
//   h2 = (3 - sqrt(3)) / (4*sqrt(2))
//   h3 = (1 - sqrt(3)) / (4*sqrt(2))

fn db4_h() -> [f64; 4] {
    let s2 = 0.7071067811865475   // 1/sqrt(2)
    let s3 = 1.7320508075688772   // sqrt(3)
    [
        (1.0 + s3) / (4.0 * 1.4142135623730951),
        (3.0 + s3) / (4.0 * 1.4142135623730951),
        (3.0 - s3) / (4.0 * 1.4142135623730951),
        (1.0 - s3) / (4.0 * 1.4142135623730951)
    ]
}

// D4 highpass from lowpass: g[k] = (-1)^k * h[N-1-k]
fn db4_g() -> [f64; 4] {
    let h = db4_h()
    [h[3], 0.0 - h[2], h[1], 0.0 - h[0]]
}

// =============================================================================
// Daubechies D6 wavelet coefficients
// =============================================================================

// D6 lowpass filter (6 taps, 3 vanishing moments)
fn db6_h() -> [f64; 6] {
    [
         0.33267055295008261,
         0.80689150931109835,
         0.45987750211849154,
        -0.13501102001025458,
        -0.08544127388202666,
         0.03522629188570953
    ]
}

fn db6_g() -> [f64; 6] {
    let h = db6_h()
    [h[5], 0.0 - h[4], h[3], 0.0 - h[2], h[1], 0.0 - h[0]]
}

// =============================================================================
// 1-level DWT (Haar)
// =============================================================================

// Forward Haar DWT: one decomposition level.
// Input: x[0..n-1] (n must be even).
// Output: approx coefficients in x[0..n/2-1], detail in x[n/2..n-1].
fn dwt_haar_1level(x: &![f64; 4096], n: i32) with Mut {
    let half = n / 2
    var temp: [f64; 4096] = [0.0; 4096]

    var i = 0
    while i < half {
        temp[i] = haar_h0() * x[2 * i] + haar_h1() * x[2 * i + 1]
        temp[half + i] = haar_g0() * x[2 * i] + haar_g1() * x[2 * i + 1]
        i = i + 1
    }

    i = 0
    while i < n { x[i] = temp[i]; i = i + 1 }
}

// Inverse Haar DWT: one reconstruction level.
fn idwt_haar_1level(x: &![f64; 4096], n: i32) with Mut {
    let half = n / 2
    var temp: [f64; 4096] = [0.0; 4096]

    var i = 0
    while i < half {
        let a = x[i]
        let d = x[half + i]
        temp[2 * i] = haar_h0() * a + haar_g0() * d
        temp[2 * i + 1] = haar_h1() * a + haar_g1() * d
        i = i + 1
    }

    i = 0
    while i < n { x[i] = temp[i]; i = i + 1 }
}

// =============================================================================
// 1-level DWT (Daubechies D4)
// =============================================================================

// Forward D4 DWT: one decomposition level with periodic boundary.
fn dwt_db4_1level(x: &![f64; 4096], n: i32) with Mut {
    let h = db4_h()
    let g = db4_g()
    let half = n / 2
    var temp: [f64; 4096] = [0.0; 4096]

    var i = 0
    while i < half {
        var a = 0.0
        var d = 0.0
        var k = 0
        while k < 4 {
            let idx = (2 * i + k) - ((2 * i + k) / n) * n  // mod n (periodic)
            a = a + h[k] * x[idx]
            d = d + g[k] * x[idx]
            k = k + 1
        }
        temp[i] = a
        temp[half + i] = d
        i = i + 1
    }

    i = 0
    while i < n { x[i] = temp[i]; i = i + 1 }
}

// Inverse D4 DWT: one reconstruction level.
fn idwt_db4_1level(x: &![f64; 4096], n: i32) with Mut {
    let h = db4_h()
    let g = db4_g()
    let half = n / 2
    var temp: [f64; 4096] = [0.0; 4096]

    // Zero temp
    var idx = 0
    while idx < n { temp[idx] = 0.0; idx = idx + 1 }

    // Upsampling + filtering
    var i = 0
    while i < half {
        var k = 0
        while k < 4 {
            let j = (2 * i + k) - ((2 * i + k) / n) * n
            temp[j] = temp[j] + h[k] * x[i] + g[k] * x[half + i]
            k = k + 1
        }
        i = i + 1
    }

    i = 0
    while i < n { x[i] = temp[i]; i = i + 1 }
}

// =============================================================================
// Multi-level DWT
// =============================================================================

// Multi-level Haar DWT: decompose 'levels' times.
// After decomposition, x contains:
//   [approx_L | detail_L | detail_{L-1} | ... | detail_1]
fn dwt_haar(x: &![f64; 4096], n: i32, levels: i32) with Mut {
    var len = n
    var l = 0
    while l < levels && len >= 2 {
        dwt_haar_1level(x, len)
        len = len / 2
        l = l + 1
    }
}

// Multi-level Haar IDWT: reconstruct from 'levels' decomposition.
fn idwt_haar(x: &![f64; 4096], n: i32, levels: i32) with Mut {
    // Find the smallest subband length
    var len = n
    var l = 0
    while l < levels { len = len / 2; l = l + 1 }

    l = 0
    while l < levels {
        len = len * 2
        idwt_haar_1level(x, len)
        l = l + 1
    }
}

// Multi-level D4 DWT
fn dwt_db4(x: &![f64; 4096], n: i32, levels: i32) with Mut {
    var len = n
    var l = 0
    while l < levels && len >= 4 {
        dwt_db4_1level(x, len)
        len = len / 2
        l = l + 1
    }
}

// Multi-level D4 IDWT
fn idwt_db4(x: &![f64; 4096], n: i32, levels: i32) with Mut {
    var len = n
    var l = 0
    while l < levels { len = len / 2; l = l + 1 }
    l = 0
    while l < levels {
        len = len * 2
        idwt_db4_1level(x, len)
        l = l + 1
    }
}

// =============================================================================
// Wavelet denoising
// =============================================================================

// Hard thresholding: set coefficients below threshold to zero.
fn threshold_hard(x: &![f64; 4096], n: i32, start: i32, threshold: f64) with Mut {
    var i = start
    while i < n {
        if wav_abs(x[i]) < threshold { x[i] = 0.0 }
        i = i + 1
    }
}

// Soft thresholding: shrink coefficients toward zero.
// soft(x, t) = sign(x) * max(|x| - t, 0)
fn threshold_soft(x: &![f64; 4096], n: i32, start: i32, threshold: f64) with Mut {
    var i = start
    while i < n {
        let ax = wav_abs(x[i])
        if ax <= threshold {
            x[i] = 0.0
        } else {
            if x[i] > 0.0 { x[i] = ax - threshold }
            else { x[i] = 0.0 - (ax - threshold) }
        }
        i = i + 1
    }
}

// Universal threshold (VisuShrink): t = sigma * sqrt(2 * ln(n))
// sigma estimated from median absolute deviation of finest detail coefficients:
//   sigma = MAD(detail_1) / 0.6745
fn visu_shrink_threshold(x: &[f64; 4096], n: i32) -> f64 with Mut, Div, Panic {
    // Finest detail coefficients are in x[n/2 .. n-1]
    let half = n / 2
    let num_detail = n - half

    // Copy detail coefficients and compute MAD
    var detail: [f64; 2048] = [0.0; 2048]
    var i = 0
    while i < num_detail {
        detail[i] = wav_abs(x[half + i])
        i = i + 1
    }

    // Simple selection sort to find median (fine for moderate n)
    i = 0
    while i < num_detail / 2 + 1 {
        var min_idx = i
        var j = i + 1
        while j < num_detail {
            if detail[j] < detail[min_idx] { min_idx = j }
            j = j + 1
        }
        if min_idx != i {
            let tmp = detail[i]
            detail[i] = detail[min_idx]
            detail[min_idx] = tmp
        }
        i = i + 1
    }

    let median = detail[num_detail / 2]
    let sigma = median / 0.6745

    // Universal threshold
    let ln_n = wav_ln(n as f64)
    sigma * wav_sqrt(2.0 * ln_n)
}

fn wav_ln(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 - 1.0e30 }
    var m = x
    var e = 0
    while m >= 2.0 { m = m / 2.0; e = e + 1 }
    while m < 0.5 { m = m * 2.0; e = e - 1 }
    let t = (m - 1.0) / (m + 1.0)
    let t2 = t * t
    var sum = t
    var term = t
    var k = 1
    while k < 30 { term = term * t2; sum = sum + term / ((2 * k + 1) as f64); k = k + 1 }
    2.0 * sum + (e as f64) * 0.6931471805599453
}

// Denoise a signal using Haar DWT + soft thresholding.
fn denoise_haar(x: &![f64; 4096], n: i32, levels: i32) with Mut, Div, Panic {
    dwt_haar(x, n, levels)
    let threshold = visu_shrink_threshold(x, n)
    // Threshold all detail coefficients (keep approximation intact)
    var approx_len = n
    var l = 0
    while l < levels { approx_len = approx_len / 2; l = l + 1 }
    threshold_soft(x, n, approx_len, threshold)
    idwt_haar(x, n, levels)
}

// =============================================================================
// Energy and statistics
// =============================================================================

// Compute energy (sum of squares) of a signal segment.
fn wav_energy(x: &[f64; 4096], start: i32, end: i32) -> f64 with Mut {
    var s = 0.0
    var i = start
    while i < end { s = s + x[i] * x[i]; i = i + 1 }
    s
}

// Parseval's theorem: energy preserved after DWT.
// Total energy = energy(approx_L) + sum energy(detail_k) for k=1..L.
fn wav_total_energy(x: &[f64; 4096], n: i32, levels: i32) -> f64 with Mut {
    var total = 0.0
    var len = n
    var l = 0
    while l < levels {
        let half = len / 2
        // Detail coefficients at this level
        total = total + wav_energy(x, half, len)
        len = half
        l = l + 1
    }
    // Add approximation energy
    total = total + wav_energy(x, 0, len)
    total
}

// =============================================================================
// Stationary (non-decimated) Wavelet Transform — à trous algorithm
// =============================================================================

// The stationary wavelet transform (SWT) is translation-invariant unlike the
// standard DWT. It does NOT downsample; instead, filters are upsampled by
// inserting zeros (à trous = "with holes").
//
// One level of SWT using Haar: output approximation and detail both of length n.
fn swt_haar_1level(x: &[f64; 4096], n: i32, level: i32,
                   approx: &![f64; 4096], detail: &![f64; 4096]) with Mut {
    let step = 1
    // At level l, filter spacing is 2^l
    var spacing = 1
    var l = 0
    while l < level { spacing = spacing * 2; l = l + 1 }

    var i = 0
    while i < n {
        let j = (i + spacing) - ((i + spacing) / n) * n  // (i + spacing) mod n
        approx[i] = haar_h0() * x[i] + haar_h1() * x[j]
        detail[i] = haar_g0() * x[i] + haar_g1() * x[j]
        i = i + 1
    }
}

// =============================================================================
// Wavelet packet decomposition (single node)
// =============================================================================

// In a wavelet packet tree, we can decompose both approximation AND detail
// subbands further. This gives a richer time-frequency analysis.
//
// wavelet_packet_node: decompose a segment of x starting at 'offset' with
// length 'len' into approximation and detail using Haar.
fn wavelet_packet_haar(x: &[f64; 4096], offset: i32, len: i32,
                       approx: &![f64; 2048], detail: &![f64; 2048]) with Mut {
    let half = len / 2
    var i = 0
    while i < half {
        approx[i] = haar_h0() * x[offset + 2 * i] + haar_h1() * x[offset + 2 * i + 1]
        detail[i] = haar_g0() * x[offset + 2 * i] + haar_g1() * x[offset + 2 * i + 1]
        i = i + 1
    }
}

// =============================================================================
// Lifting scheme (for Haar — pedagogical)
// =============================================================================

// The lifting scheme is a faster, in-place way to compute wavelets.
// Haar via lifting:
//   Split: even[i] = x[2i], odd[i] = x[2i+1]
//   Predict: d[i] = odd[i] - even[i]  (detail)
//   Update: a[i] = even[i] + d[i]/2   (approximation)
fn dwt_haar_lifting(x: &![f64; 4096], n: i32) with Mut, Div {
    let half = n / 2
    // Split into even/odd
    var even: [f64; 2048] = [0.0; 2048]
    var odd: [f64; 2048] = [0.0; 2048]
    var i = 0
    while i < half {
        even[i] = x[2 * i]
        odd[i] = x[2 * i + 1]
        i = i + 1
    }

    // Predict step: detail = odd - even
    i = 0
    while i < half { x[half + i] = odd[i] - even[i]; i = i + 1 }

    // Update step: approx = even + detail/2
    i = 0
    while i < half { x[i] = even[i] + x[half + i] / 2.0; i = i + 1 }

    // Scale to match orthogonal convention
    let s = 1.4142135623730951  // sqrt(2)
    i = 0
    while i < half {
        x[i] = x[i] * s
        x[half + i] = x[half + i] / s
        i = i + 1
    }
}
