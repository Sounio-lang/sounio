// Compatibility names for checked information theory kernels.
// The historical "_exact" names are retained; results are numerical, not proofs.
// Entropies/divergences nats; BSC bits/use; real AWGN nats/use.
// Invalid inputs return -1; KL support mismatch returns positive infinity.
use math::probability::{InformationResult,information_shannon,information_collision,information_min,information_kl,information_js}
use math::channels::{bsc_capacity_bits,awgn_capacity_nats,pinsker_bound_nats,cramer_rao_bound}
fn information_legacy_value(r:InformationResult)->f64 {
 if r.status==5 && r.infinite{return 1e308*2.0}
 if r.status!=0{return -1.0}
 return r.value
}
pub fn shannon_entropy_exact(p:[f64;8],k:i64)->f64 with Mut,Div,Panic {
 information_legacy_value(information_shannon(&p,k))
}
pub fn renyi_entropy_alpha2(p:[f64;8],k:i64)->f64 with Mut,Div,Panic {
 information_legacy_value(information_collision(&p,k))
}
pub fn min_entropy(p:[f64;8],k:i64)->f64 with Mut,Div,Panic {
 information_legacy_value(information_min(&p,k))
}
pub fn kl_divergence_exact(p:[f64;8],q:[f64;8],k:i64)->f64 with Mut,Div,Panic {
 information_legacy_value(information_kl(&p,&q,k))
}
pub fn jsd_divergence_exact(p:[f64;8],q:[f64;8],k:i64)->f64 with Mut,Div,Panic {
 information_legacy_value(information_js(&p,&q,k))
}
pub fn pinsker_tv_bound(kl:f64)->f64 with Mut,Div,Panic {
 information_legacy_value(pinsker_bound_nats(kl))
}
pub fn channel_capacity_bsc(p:f64)->f64 with Mut,Div,Panic {
 information_legacy_value(bsc_capacity_bits(p))
}
pub fn channel_capacity_awgn(snr:f64)->f64 with Mut,Div,Panic {
 information_legacy_value(awgn_capacity_nats(snr))
}
pub fn cramer_rao_lower_bound(info:f64)->f64 with Mut,Div,Panic {
 information_legacy_value(cramer_rao_bound(info))
}
