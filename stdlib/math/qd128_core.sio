//! stdlib/math/qd128_core.sio — Madaros-native thin leaf for Qd128 constructors.
//!
//! Full arithmetic (`qd_mul`, renorm, division, …) lives in `math::qd128` and
//! still fails closed under native-v2 emission (`qd_mul` → rc=12). This leaf
//! exists so import/smoke of the representation does not pull that surface.

pub struct Qd128 {
    pub x0: f64,
    pub x1: f64,
    pub x2: f64,
    pub x3: f64,
}

pub fn qd_zero() -> Qd128 {
    Qd128 { x0: 0.0, x1: 0.0, x2: 0.0, x3: 0.0 }
}

pub fn qd_from_f64(a: f64) -> Qd128 {
    Qd128 { x0: a, x1: 0.0, x2: 0.0, x3: 0.0 }
}
