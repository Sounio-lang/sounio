// stdlib::math::ga::quaternion — Quaternion as Cl(0,2) specialization
//
// Quaternions are the even subalgebra of Cl(0,2):
//   1 (scalar), e12 (bivector) mapped to i, j, k as:
//   In Cl(0,2): basis = {1, e1, e2, e12}
//   Quaternion components: w=1, x=e1, y=e2, z=e12
//   But as even subalgebra: q = w + x*e12 + y*e13 + z*e23 (in Cl(0,3))
//   Simpler: direct 4-component representation using Cl(0,2) layout.
//
// Cl(0,2) has 2^2 = 4 basis blades: {1, e1, e2, e12}
// Metric: e1^2 = -1, e2^2 = -1
// So e12*e12 = e1*e2*e1*e2 = -e1*e1*e2*e2 = -(-1)(-1) = -1
// This gives us quaternion multiplication rules.

fn quat_sig() -> AlgebraSignature {
    ga_sig_quaternion()  // Cl(0,2)
}

// Create quaternion from (w, x, y, z) components.
// Maps to Cl(0,2): w -> scalar, x -> e1, y -> e2, z -> e12
fn quat_new(w: f64, x: f64, y: f64, z: f64) -> Multivector with Mut {
    let sig = quat_sig()
    var mv = ga_zero(sig)
    mv.components[0 as usize] = w    // scalar (grade 0)
    mv.components[1 as usize] = x    // e1 (grade 1)
    mv.components[2 as usize] = y    // e2 (grade 1)
    mv.components[3 as usize] = z    // e12 (grade 2)
    mv.grade_mask = 7  // 0b111 = grades 0,1,2 all potentially active
    mv
}

fn quat_w(q: Multivector) -> f64 { ga_get(q, 0) }
fn quat_x(q: Multivector) -> f64 { ga_get(q, 1) }
fn quat_y(q: Multivector) -> f64 { ga_get(q, 2) }
fn quat_z(q: Multivector) -> f64 { ga_get(q, 3) }

// Quaternion multiplication via geometric product in Cl(0,2)
fn quat_mul(a: Multivector, b: Multivector) -> Multivector with Mut {
    ga_product(a, b)
}

// Quaternion conjugate: negate vector (grade 1) and bivector (grade 2) parts, keep scalar
fn quat_conjugate(q: Multivector) -> Multivector with Mut {
    var result = ga_zero(q.sig)
    result.components[0 as usize] = quat_w(q)
    result.components[1 as usize] = 0.0 - quat_x(q)
    result.components[2 as usize] = 0.0 - quat_y(q)
    result.components[3 as usize] = 0.0 - quat_z(q)
    result.grade_mask = q.grade_mask
    result
}

// Quaternion norm squared
fn quat_norm_sq(q: Multivector) -> f64 {
    let w = quat_w(q)
    let x = quat_x(q)
    let y = quat_y(q)
    let z = quat_z(q)
    w * w + x * x + y * y + z * z
}

// Quaternion identity
fn quat_identity() -> Multivector with Mut {
    quat_new(1.0, 0.0, 0.0, 0.0)
}

// Rotate a 3D vector by a unit quaternion: q * v * q_conj
// Vector v is represented as a pure quaternion (0, vx, vy, 0)
fn quat_rotate_vec3(q: Multivector, vx: f64, vy: f64, vz: f64) -> Multivector with Mut {
    // Represent the vector as pure quaternion in Cl(0,2)
    let v = quat_new(0.0, vx, vy, vz)
    let q_conj = quat_conjugate(q)
    let tmp = quat_mul(q, v)
    quat_mul(tmp, q_conj)
}
