// stdlib/math/interval.sio — Interval arithmetic for verified computing
//
// Pure Sounio implementation of IEEE 1788-2015 style interval arithmetic.
// Every result carries rigorous bounds — if f(x) is in interval [lo, hi],
// the true mathematical result is guaranteed to lie within that range.
//
// Outward rounding is simulated via epsilon padding since Sounio does not
// directly control hardware rounding mode. The padding factor is 4*eps
// to account for multiple sequential operations.
//
// References:
//   Moore, Kearfott & Cloud (2009): "Introduction to Interval Analysis"
//   IEEE 1788-2015: "Standard for Interval Arithmetic"
//   Tucker (2011): "Validated Numerics"
//   Rump (2010): "Verification methods: Rigorous results using floating-point"

// =============================================================================
// Helpers
// =============================================================================

fn iv_fabs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }
fn iv_fmin(a: f64, b: f64) -> f64 { if a < b { a } else { b } }
fn iv_fmax(a: f64, b: f64) -> f64 { if a > b { a } else { b } }

fn iv_sqrt_f(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 20 { y = 0.5 * (y + x / y); i = i + 1 }
    y
}

fn iv_ln_f(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 - 1.0e30 }
    if x == 1.0 { return 0.0 }
    var m = x
    var e = 0
    while m >= 2.0 { m = m / 2.0; e = e + 1 }
    while m < 0.5 { m = m * 2.0; e = e - 1 }
    let t = (m - 1.0) / (m + 1.0)
    let t2 = t * t
    var sum = t
    var term = t
    var k = 1
    while k < 30 { term = term * t2; sum = sum + term / ((2 * k + 1) as f64); k = k + 1 }
    2.0 * sum + (e as f64) * 0.6931471805599453
}

fn iv_exp_f(x: f64) -> f64 with Mut, Div, Panic {
    if x > 500.0 { return 1.0e200 }
    if x < -500.0 { return 0.0 }
    var kf = x / 0.6931471805599453
    var k: i32 = 0
    if kf >= 0.0 { k = kf as i32 } else { k = (kf as i32) - 1 }
    let r = x - (k as f64) * 0.6931471805599453
    var sum = 1.0
    var term = 1.0
    var n = 1
    while n < 25 { term = term * r / (n as f64); sum = sum + term; n = n + 1 }
    var result = sum
    if k >= 0 { var i = 0; while i < k { result = result * 2.0; i = i + 1 } }
    else { var i = 0; while i < (0 - k) { result = result / 2.0; i = i + 1 } }
    result
}

fn iv_sin_f(x: f64) -> f64 with Mut, Div, Panic {
    var a = x
    let tp = 6.28318530717958647692
    while a >= tp { a = a - tp }
    while a < 0.0 { a = a + tp }
    if a > 3.14159265358979323846 { a = a - tp }
    let a2 = a * a
    var sum = a
    var term = a
    var n = 1
    while n < 18 { term = 0.0 - term * a2 / ((2 * n) * (2 * n + 1)) as f64; sum = sum + term; n = n + 1 }
    sum
}

fn iv_cos_f(x: f64) -> f64 with Mut, Div, Panic {
    iv_sin_f(x + 1.57079632679489661923)
}

// Rounding error padding (4 * machine epsilon)
fn iv_pad() -> f64 { 8.881784197001252e-16 }

// =============================================================================
// Interval type and constructors
// =============================================================================

struct Interval {
    lo: f64,
    hi: f64
}

fn iv_new(lo: f64, hi: f64) -> Interval {
    Interval { lo: lo, hi: hi }
}

fn iv_point(x: f64) -> Interval {
    Interval { lo: x, hi: x }
}

fn iv_entire() -> Interval {
    Interval { lo: 0.0 - 1.0e308, hi: 1.0e308 }
}

fn iv_empty() -> Interval {
    Interval { lo: 1.0, hi: 0.0 }  // lo > hi signals empty
}

// =============================================================================
// Properties
// =============================================================================

fn iv_is_empty(a: Interval) -> bool { a.lo > a.hi }
fn iv_width(a: Interval) -> f64 { a.hi - a.lo }
fn iv_midpoint(a: Interval) -> f64 { 0.5 * (a.lo + a.hi) }
fn iv_radius(a: Interval) -> f64 { 0.5 * (a.hi - a.lo) }
fn iv_contains(a: Interval, x: f64) -> bool { x >= a.lo && x <= a.hi }

fn iv_overlaps(a: Interval, b: Interval) -> bool {
    a.lo <= b.hi && b.lo <= a.hi
}

fn iv_is_subset(a: Interval, b: Interval) -> bool {
    a.lo >= b.lo && a.hi <= b.hi
}

// =============================================================================
// Arithmetic
// =============================================================================

fn iv_add(a: Interval, b: Interval) -> Interval {
    let lo = a.lo + b.lo
    let hi = a.hi + b.hi
    let pad = iv_pad() * iv_fmax(iv_fabs(lo), iv_fabs(hi))
    Interval { lo: lo - pad, hi: hi + pad }
}

fn iv_sub(a: Interval, b: Interval) -> Interval {
    let lo = a.lo - b.hi
    let hi = a.hi - b.lo
    let pad = iv_pad() * iv_fmax(iv_fabs(lo), iv_fabs(hi))
    Interval { lo: lo - pad, hi: hi + pad }
}

fn iv_neg(a: Interval) -> Interval {
    Interval { lo: 0.0 - a.hi, hi: 0.0 - a.lo }
}

fn iv_mul(a: Interval, b: Interval) -> Interval {
    let p1 = a.lo * b.lo
    let p2 = a.lo * b.hi
    let p3 = a.hi * b.lo
    let p4 = a.hi * b.hi
    let lo = iv_fmin(iv_fmin(p1, p2), iv_fmin(p3, p4))
    let hi = iv_fmax(iv_fmax(p1, p2), iv_fmax(p3, p4))
    let pad = iv_pad() * iv_fmax(iv_fabs(lo), iv_fabs(hi))
    Interval { lo: lo - pad, hi: hi + pad }
}

fn iv_div(a: Interval, b: Interval) -> Interval with Panic {
    if b.lo <= 0.0 && b.hi >= 0.0 {
        // Division by interval containing zero -> entire
        return iv_entire()
    }
    let inv_b = Interval { lo: 1.0 / b.hi, hi: 1.0 / b.lo }
    iv_mul(a, inv_b)
}

fn iv_scalar_mul(a: Interval, s: f64) -> Interval {
    if s >= 0.0 {
        let pad = iv_pad() * iv_fmax(iv_fabs(a.lo * s), iv_fabs(a.hi * s))
        Interval { lo: a.lo * s - pad, hi: a.hi * s + pad }
    } else {
        let pad = iv_pad() * iv_fmax(iv_fabs(a.lo * s), iv_fabs(a.hi * s))
        Interval { lo: a.hi * s - pad, hi: a.lo * s + pad }
    }
}

// =============================================================================
// Set operations
// =============================================================================

fn iv_intersect(a: Interval, b: Interval) -> Interval {
    let lo = iv_fmax(a.lo, b.lo)
    let hi = iv_fmin(a.hi, b.hi)
    if lo > hi { return iv_empty() }
    Interval { lo: lo, hi: hi }
}

fn iv_hull(a: Interval, b: Interval) -> Interval {
    Interval { lo: iv_fmin(a.lo, b.lo), hi: iv_fmax(a.hi, b.hi) }
}

// =============================================================================
// Power and absolute value
// =============================================================================

fn iv_abs(a: Interval) -> Interval {
    if a.lo >= 0.0 { return a }
    if a.hi <= 0.0 { return Interval { lo: 0.0 - a.hi, hi: 0.0 - a.lo } }
    Interval { lo: 0.0, hi: iv_fmax(0.0 - a.lo, a.hi) }
}

fn iv_sqr(a: Interval) -> Interval {
    if a.lo >= 0.0 {
        let pad = iv_pad() * a.hi * a.hi
        return Interval { lo: a.lo * a.lo - pad, hi: a.hi * a.hi + pad }
    }
    if a.hi <= 0.0 {
        let pad = iv_pad() * a.lo * a.lo
        return Interval { lo: a.hi * a.hi - pad, hi: a.lo * a.lo + pad }
    }
    // Contains zero
    let m = iv_fmax(0.0 - a.lo, a.hi)
    let pad = iv_pad() * m * m
    Interval { lo: 0.0, hi: m * m + pad }
}

fn iv_pow_int(a: Interval, n: i32) -> Interval with Mut, Div, Panic {
    if n == 0 { return iv_point(1.0) }
    if n == 1 { return a }
    if n == 2 { return iv_sqr(a) }
    // General: use repeated squaring
    if n < 0 {
        let inv_a = iv_div(iv_point(1.0), a)
        return iv_pow_int(inv_a, 0 - n)
    }
    if n - (n / 2) * 2 == 0 {
        let half = iv_pow_int(a, n / 2)
        return iv_sqr(half)
    }
    let half = iv_pow_int(a, (n - 1) / 2)
    iv_mul(iv_sqr(half), a)
}

// =============================================================================
// Elementary functions on intervals
// =============================================================================

fn iv_sqrt(a: Interval) -> Interval with Mut, Div, Panic {
    if a.hi < 0.0 { return iv_empty() }
    let lo_val = if a.lo <= 0.0 { 0.0 } else { iv_sqrt_f(a.lo) }
    let hi_val = iv_sqrt_f(a.hi)
    let pad = iv_pad() * hi_val
    Interval { lo: lo_val - pad, hi: hi_val + pad }
}

fn iv_exp(a: Interval) -> Interval with Mut, Div, Panic {
    let lo_val = iv_exp_f(a.lo)
    let hi_val = iv_exp_f(a.hi)
    let pad_lo = iv_pad() * iv_fabs(lo_val)
    let pad_hi = iv_pad() * iv_fabs(hi_val)
    Interval { lo: lo_val - pad_lo, hi: hi_val + pad_hi }
}

fn iv_ln(a: Interval) -> Interval with Mut, Div, Panic {
    if a.hi <= 0.0 { return iv_empty() }
    let lo_in = if a.lo <= 0.0 { 1.0e-308 } else { a.lo }
    let lo_val = iv_ln_f(lo_in)
    let hi_val = iv_ln_f(a.hi)
    let pad = iv_pad() * iv_fmax(iv_fabs(lo_val), iv_fabs(hi_val))
    Interval { lo: lo_val - pad, hi: hi_val + pad }
}

fn iv_sin(a: Interval) -> Interval with Mut, Div, Panic {
    // Conservative bound: if width >= 2*pi, return [-1, 1]
    let w = a.hi - a.lo
    if w >= 6.28318530717958647692 {
        return Interval { lo: 0.0 - 1.0, hi: 1.0 }
    }

    // Evaluate at endpoints and check for extrema
    let s_lo = iv_sin_f(a.lo)
    let s_hi = iv_sin_f(a.hi)

    var lo_val = iv_fmin(s_lo, s_hi)
    var hi_val = iv_fmax(s_lo, s_hi)

    // Check if any maximum (pi/2 + 2k*pi) is in interval
    // Check if any minimum (3pi/2 + 2k*pi) is in interval
    let tp = 6.28318530717958647692
    let hp = 1.57079632679489661923

    // Check for max: sin = 1 at pi/2 + 2k*pi
    var k_max = ((a.lo - hp) / tp) as i32
    if (a.lo - hp) < 0.0 { k_max = k_max - 1 }
    var x_max = hp + ((k_max + 1) as f64) * tp
    if x_max >= a.lo && x_max <= a.hi { hi_val = 1.0 }

    // Check for min: sin = -1 at -pi/2 + 2k*pi = 3pi/2 + 2k*pi
    let min_phase = 0.0 - hp
    var k_min = ((a.lo - min_phase) / tp) as i32
    if (a.lo - min_phase) < 0.0 { k_min = k_min - 1 }
    var x_min = min_phase + ((k_min + 1) as f64) * tp
    if x_min >= a.lo && x_min <= a.hi { lo_val = 0.0 - 1.0 }

    let pad = iv_pad()
    Interval { lo: lo_val - pad, hi: hi_val + pad }
}

fn iv_cos(a: Interval) -> Interval with Mut, Div, Panic {
    // cos(x) = sin(x + pi/2)
    let shifted = Interval { lo: a.lo + 1.57079632679489661923, hi: a.hi + 1.57079632679489661923 }
    iv_sin(shifted)
}
