//! stdlib/math/cayley_dickson.sio - Cayley-Dickson Construction Helpers (f64)
//!
//! Concrete helper functions for the Cayley-Dickson doubling construction:
//!   R -> C -> H -> O -> S
//! Provides f64-precision octonionic multiplication and conjugation components
//! used by sedenion64.sio for the FSNN pipeline.
//!
//! The Cayley-Dickson product rule for (a,b)*(c,d):
//!   real part = a*c - conj(d)*b
//!   imag part = d*a + b*conj(c)
//! where a,b,c,d are elements of the algebra at the previous level.
//!
//! References:
//! - Baez, "The Octonions", Bull. AMS 2002
//! - Cayley-Dickson construction: each level doubles dimension, loses one property
//!   C: loses ordering | H: loses commutativity | O: loses associativity | S: loses alternativity

// ============================================================================
// RESULT TYPES (structs to avoid tuple index limitations)
// ============================================================================

// 8-component result for octonionic operations
pub struct Oct8 {
    c0: f64,
    c1: f64,
    c2: f64,
    c3: f64,
    c4: f64,
    c5: f64,
    c6: f64,
    c7: f64,
}

// 16-component result for sedenion multiplication
pub struct Sed16Comp {
    r0: f64,
    r1: f64,
    r2: f64,
    r3: f64,
    r4: f64,
    r5: f64,
    r6: f64,
    r7: f64,
    r8: f64,
    r9: f64,
    r10: f64,
    r11: f64,
    r12: f64,
    r13: f64,
    r14: f64,
    r15: f64,
}

// ============================================================================
// OCTONIONIC MULTIPLICATION (f64)
// ============================================================================
// Standard Cayley-Dickson multiplication table for octonions.
// Same formula as oct_mul in octonion.sio but with f64 precision.
// Verified for norm multiplicativity |ab| = |a||b| and Moufang identities.
// Complexity: 64 multiplications + 56 additions = 120 FLOPs

fn oct64_mul_components(
    a0: f64, a1: f64, a2: f64, a3: f64, a4: f64, a5: f64, a6: f64, a7: f64,
    b0: f64, b1: f64, b2: f64, b3: f64, b4: f64, b5: f64, b6: f64, b7: f64
) -> Oct8 {
    let c0 = a0*b0 - a1*b1 - a2*b2 - a3*b3 - a4*b4 - a5*b5 - a6*b6 - a7*b7
    let c1 = a0*b1 + a1*b0 + a2*b3 - a3*b2 + a4*b5 - a5*b4 - a6*b7 + a7*b6
    let c2 = a0*b2 - a1*b3 + a2*b0 + a3*b1 + a4*b6 + a5*b7 - a6*b4 - a7*b5
    let c3 = a0*b3 + a1*b2 - a2*b1 + a3*b0 + a4*b7 - a5*b6 + a6*b5 - a7*b4
    let c4 = a0*b4 - a1*b5 - a2*b6 - a3*b7 + a4*b0 + a5*b1 + a6*b2 + a7*b3
    let c5 = a0*b5 + a1*b4 - a2*b7 + a3*b6 - a4*b1 + a5*b0 - a6*b3 + a7*b2
    let c6 = a0*b6 + a1*b7 + a2*b4 - a3*b5 - a4*b2 + a5*b3 + a6*b0 - a7*b1
    let c7 = a0*b7 - a1*b6 + a2*b5 + a3*b4 - a4*b3 - a5*b2 + a6*b1 + a7*b0
    Oct8 { c0: c0, c1: c1, c2: c2, c3: c3, c4: c4, c5: c5, c6: c6, c7: c7 }
}

// ============================================================================
// OCTONIONIC CONJUGATION (f64)
// ============================================================================
// conj(a0 + a1*e1 + ... + a7*e7) = a0 - a1*e1 - ... - a7*e7
// Property: conj(ab) = conj(b)*conj(a) (anti-automorphism)

fn oct64_conj_components(
    a0: f64, a1: f64, a2: f64, a3: f64, a4: f64, a5: f64, a6: f64, a7: f64
) -> Oct8 {
    Oct8 {
        c0: a0,
        c1: 0.0 - a1,
        c2: 0.0 - a2,
        c3: 0.0 - a3,
        c4: 0.0 - a4,
        c5: 0.0 - a5,
        c6: 0.0 - a6,
        c7: 0.0 - a7,
    }
}

// ============================================================================
// CAYLEY-DICKSON SEDENION PRODUCT (f64)
// ============================================================================
// Given sedenion s1 = (a, b) and s2 = (c, d) where a,b,c,d are octonions:
//   (a,b) * (c,d) = (a*c - conj(d)*b, d*a + b*conj(c))
//
// This requires 4 octonionic multiplications + 2 conjugations:
//   p1 = a * c
//   p2 = conj(d) * b
//   p3 = d * a
//   p4 = b * conj(c)
//   result_lo = p1 - p2
//   result_hi = p3 + p4
//
// Complexity: 4 * 120 + 16 + 16 = 512 FLOPs

fn cd_product_16(
    a0: f64, a1: f64, a2: f64, a3: f64, a4: f64, a5: f64, a6: f64, a7: f64,
    b0: f64, b1: f64, b2: f64, b3: f64, b4: f64, b5: f64, b6: f64, b7: f64,
    c0: f64, c1: f64, c2: f64, c3: f64, c4: f64, c5: f64, c6: f64, c7: f64,
    d0: f64, d1: f64, d2: f64, d3: f64, d4: f64, d5: f64, d6: f64, d7: f64
) -> Sed16Comp {

    // p1 = a * c
    let p1 = oct64_mul_components(a0, a1, a2, a3, a4, a5, a6, a7,
                                   c0, c1, c2, c3, c4, c5, c6, c7)

    // p2 = conj(d) * b
    let cd = oct64_conj_components(d0, d1, d2, d3, d4, d5, d6, d7)
    let p2 = oct64_mul_components(cd.c0, cd.c1, cd.c2, cd.c3, cd.c4, cd.c5, cd.c6, cd.c7,
                                   b0, b1, b2, b3, b4, b5, b6, b7)

    // p3 = d * a
    let p3 = oct64_mul_components(d0, d1, d2, d3, d4, d5, d6, d7,
                                   a0, a1, a2, a3, a4, a5, a6, a7)

    // p4 = b * conj(c)
    let cc = oct64_conj_components(c0, c1, c2, c3, c4, c5, c6, c7)
    let p4 = oct64_mul_components(b0, b1, b2, b3, b4, b5, b6, b7,
                                   cc.c0, cc.c1, cc.c2, cc.c3, cc.c4, cc.c5, cc.c6, cc.c7)

    // result_lo = p1 - p2 (real octonion half)
    // result_hi = p3 + p4 (imaginary octonion half)
    Sed16Comp {
        r0:  p1.c0 - p2.c0,
        r1:  p1.c1 - p2.c1,
        r2:  p1.c2 - p2.c2,
        r3:  p1.c3 - p2.c3,
        r4:  p1.c4 - p2.c4,
        r5:  p1.c5 - p2.c5,
        r6:  p1.c6 - p2.c6,
        r7:  p1.c7 - p2.c7,
        r8:  p3.c0 + p4.c0,
        r9:  p3.c1 + p4.c1,
        r10: p3.c2 + p4.c2,
        r11: p3.c3 + p4.c3,
        r12: p3.c4 + p4.c4,
        r13: p3.c5 + p4.c5,
        r14: p3.c6 + p4.c6,
        r15: p3.c7 + p4.c7,
    }
}

// ============================================================================
// OCTONIONIC NORM SQUARED (f64)
// ============================================================================

fn oct64_norm_sq_components(
    a0: f64, a1: f64, a2: f64, a3: f64, a4: f64, a5: f64, a6: f64, a7: f64
) -> f64 {
    a0*a0 + a1*a1 + a2*a2 + a3*a3 + a4*a4 + a5*a5 + a6*a6 + a7*a7
}
