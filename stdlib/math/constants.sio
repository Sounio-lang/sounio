// stdlib/math/constants.sio — Extended mathematical constants
//
// Provides fundamental mathematical constants beyond PI and E.
// All values are given to full f64 precision (15-17 significant digits).
//
// References:
//   OEIS (https://oeis.org)
//   DLMF (https://dlmf.nist.gov)
//   Borwein & Bailey (2004): "Mathematics by Experiment"

// =============================================================================
// Circle constants
// =============================================================================

fn pi() -> f64 { 3.14159265358979323846 }
fn two_pi() -> f64 { 6.28318530717958647692 }
fn half_pi() -> f64 { 1.57079632679489661923 }
fn quarter_pi() -> f64 { 0.78539816339744830962 }
fn inv_pi() -> f64 { 0.31830988618379067154 }
fn two_inv_pi() -> f64 { 0.63661977236758134308 }
fn sqrt_pi() -> f64 { 1.77245385090551602730 }
fn inv_sqrt_pi() -> f64 { 0.56418958354775628695 }

// Tau (2*pi) — full turn in radians
fn tau() -> f64 { 6.28318530717958647692 }

// =============================================================================
// Euler's number and natural logarithm constants
// =============================================================================

fn e() -> f64 { 2.71828182845904523536 }
fn inv_e() -> f64 { 0.36787944117144232160 }
fn ln2() -> f64 { 0.69314718055994530942 }
fn ln10() -> f64 { 2.30258509299404568402 }
fn log2_e() -> f64 { 1.44269504088896340736 }
fn log10_e() -> f64 { 0.43429448190325182765 }
fn ln_2pi() -> f64 { 1.83787706640934548356 }
fn sqrt_2pi() -> f64 { 2.50662827463100050242 }
fn inv_sqrt_2pi() -> f64 { 0.39894228040143267794 }

// =============================================================================
// Square roots
// =============================================================================

fn sqrt2() -> f64 { 1.41421356237309504880 }
fn sqrt3() -> f64 { 1.73205080756887729353 }
fn sqrt5() -> f64 { 2.23606797749978969641 }
fn inv_sqrt2() -> f64 { 0.70710678118654752440 }
fn inv_sqrt3() -> f64 { 0.57735026918962576451 }
fn cbrt2() -> f64 { 1.25992104989487316477 }
fn cbrt3() -> f64 { 1.44224957030740838232 }

// =============================================================================
// Golden ratio and related
// =============================================================================

// Golden ratio phi = (1 + sqrt(5)) / 2  (OEIS A001622)
fn golden_ratio() -> f64 { 1.61803398874989484820 }

// Conjugate golden ratio 1/phi = phi - 1
fn inv_golden_ratio() -> f64 { 0.61803398874989484820 }

// Silver ratio 1 + sqrt(2)
fn silver_ratio() -> f64 { 2.41421356237309504880 }

// Plastic number — real root of x^3 = x + 1  (OEIS A060006)
fn plastic() -> f64 { 1.32471795724474602596 }

// =============================================================================
// Euler-Mascheroni and related
// =============================================================================

// Euler-Mascheroni constant gamma  (OEIS A001620)
fn euler_gamma() -> f64 { 0.57721566490153286061 }

// exp(gamma)
fn exp_euler_gamma() -> f64 { 1.78107241799019798524 }

// =============================================================================
// Number-theoretic constants
// =============================================================================

// Catalan's constant G = sum_{n>=0} (-1)^n / (2n+1)^2  (OEIS A006752)
fn catalan() -> f64 { 0.91596559417721901505 }

// Apery's constant zeta(3) = sum_{n>=1} 1/n^3  (OEIS A002117)
fn apery() -> f64 { 1.20205690315959428540 }

// Khinchin's constant K  (OEIS A002210)
fn khinchin() -> f64 { 2.68545200106530644531 }

// Glaisher-Kinkelin constant A  (OEIS A074962)
fn glaisher() -> f64 { 1.28242712910062263688 }

// Twin prime constant C2 = prod_{p>=3 prime} (1 - 1/(p-1)^2)  (OEIS A005597)
fn twin_prime() -> f64 { 0.66016181584686957393 }

// Landau-Ramanujan constant K  (OEIS A064533)
fn landau_ramanujan() -> f64 { 0.76422365358922066299 }

// =============================================================================
// Chaos and dynamical systems
// =============================================================================

// Feigenbaum delta — period-doubling route to chaos  (OEIS A006890)
fn feigenbaum_delta() -> f64 { 4.66920160910299067185 }

// Feigenbaum alpha  (OEIS A006891)
fn feigenbaum_alpha() -> f64 { 2.50290787509589282228 }

// =============================================================================
// Analysis constants
// =============================================================================

// Omega constant W(1) — solution of x*e^x = 1  (OEIS A030178)
fn omega() -> f64 { 0.56714329040978387300 }

// Dottie number — fixed point of cos(x)  (OEIS A003957)
fn dottie() -> f64 { 0.73908513321516064166 }

// Meissel-Mertens constant M  (OEIS A077761)
fn meissel_mertens() -> f64 { 0.26149721284764278376 }

// =============================================================================
// Degrees / radians conversion factors
// =============================================================================

fn deg_to_rad() -> f64 { 0.01745329251994329577 }
fn rad_to_deg() -> f64 { 57.29577951308232087680 }

// =============================================================================
// Machine constants (IEEE 754 f64)
// =============================================================================

// Machine epsilon: 2^{-52}
fn machine_eps() -> f64 { 2.2204460492503131e-16 }

// Smallest positive normal f64: 2^{-1022}
fn min_pos_f64() -> f64 { 2.2250738585072014e-308 }

// Largest finite f64
fn max_f64() -> f64 { 1.7976931348623157e308 }

// Sentinel for positive infinity
fn inf() -> f64 { 1.0e308 }

// Sentinel for negative infinity
fn neg_inf() -> f64 { 0.0 - 1.0e308 }
