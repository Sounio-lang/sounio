// stdlib/math/combinatorics_perm.sio — In-place permutation generation
//
// Pure Sounio implementations of lexicographic permutation generation,
// permutation counting, and Fisher-Yates shuffle with MINSTD PRNG.
//
// Uses struct wrapper pattern for i64 array mutation (native compiler safe).
//
// References:
//   Knuth (2011): "The Art of Computer Programming" Vol. 4A, Section 7.2.1.2
//   Sedgewick (1977): "Permutation Generation Methods" Computing Surveys
//   Park & Miller (1988): "Random Number Generators: Good Ones Are Hard to Find"

// ============================================================================
// DATA STRUCTURE
// ============================================================================

struct Perm128 {
    data: [i64; 128]
}

// ============================================================================
// CORE PERMUTATION ALGORITHM
// ============================================================================

// Generates the next lexicographic permutation in-place.
// Returns true if a next permutation exists, false if already at last.
// Algorithm: find rightmost i where arr[i] < arr[i+1], find rightmost j
// where arr[j] > arr[i], swap, reverse suffix.
pub fn next_permutation(p: &!Perm128, n: i32) -> bool with Mut, Panic {
    // 1. Find largest i such that p.data[i] < p.data[i+1]
    var i = n - 2
    while i >= 0 {
        if p.data[i] < p.data[i + 1] {
            // Found the pivot
            // 2. Find largest j such that p.data[j] > p.data[i]
            var j = n - 1
            while p.data[j] <= p.data[i] {
                j = j - 1
            }

            // 3. Swap p.data[i] and p.data[j]
            let tmp = p.data[i]
            p.data[i] = p.data[j]
            p.data[j] = tmp

            // 4. Reverse suffix starting at p.data[i+1]
            var lo = i + 1
            var hi = n - 1
            while lo < hi {
                let t = p.data[lo]
                p.data[lo] = p.data[hi]
                p.data[hi] = t
                lo = lo + 1
                hi = hi - 1
            }
            return true
        }
        i = i - 1
    }
    // No pivot found => last permutation
    return false
}

// Count total permutations by iterating (for small n).
// Useful for testing: factorial(n) permutations expected.
pub fn count_permutations(n: i32) -> i32 with Mut, Panic {
    var p = Perm128 { data: [0; 128] }
    var i: i32 = 0
    while i < n {
        p.data[i] = i as i64
        i = i + 1
    }
    var count: i32 = 1
    while next_permutation(&!p, n) {
        count = count + 1
    }
    count
}

// Fisher-Yates shuffle using MINSTD PRNG (Park-Miller).
// Shuffles first n elements of p.data in-place.
// Returns updated PRNG state.
pub fn shuffle_perm(p: &!Perm128, n: i32, seed: i64) -> i64 with Mut, Div, Panic {
    var rng = seed
    var i = n - 1
    while i > 0 {
        // MINSTD: rng = (16807 * rng) mod 2^31-1
        let a: i64 = 16807
        let m: i64 = 2147483647
        let q: i64 = 127773
        let r_val: i64 = 2836
        let hi = rng / q
        let lo = rng - hi * q
        let t = a * lo - r_val * hi
        if t > 0 {
            rng = t
        } else {
            rng = t + m
        }

        // Map to range [0, i]
        var j_val = rng
        if j_val < 0 {
            j_val = 0 - j_val
        }
        j_val = j_val - (j_val / ((i as i64) + 1)) * ((i as i64) + 1)

        // Swap p.data[i] and p.data[j_val]
        let j_i32 = j_val as i32
        let tmp = p.data[i]
        p.data[i] = p.data[j_i32]
        p.data[j_i32] = tmp
        i = i - 1
    }
    rng
}
