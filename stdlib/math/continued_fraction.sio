// stdlib/math/continued_fraction.sio — Continued fraction arithmetic
//
// Pure Sounio implementations:
//   Simple continued fraction representation [a0; a1, a2, ...]
//   Conversion to/from rationals and floating point
//   Convergent computation (Wallis recurrence)
//   Best rational approximation (Stern-Brocot / CF truncation)
//   Named CF expansions (sqrt(2), e, golden ratio, pi)
//   Generalized CF evaluation (modified Lentz-Thompson-Barnett)
//
// A simple continued fraction represents a real number as:
//   a0 + 1/(a1 + 1/(a2 + 1/(a3 + ...)))
// where a0 is an integer and a1, a2, ... are positive integers.
//
// References:
//   Wall (1948): "Analytic Theory of Continued Fractions"
//   Lorentzen & Waadeland (2008): "Continued Fractions" (2nd ed.)
//   Khinchin (1964): "Continued Fractions"
//   Press et al. (2007): NR3 §5.2 (Lentz method)

// =============================================================================
// Structs
// =============================================================================

struct ContinuedFraction { coeffs: [i64; 256], len: i32 }
struct RationalPair { p: i64, q: i64 }

// =============================================================================
// Helpers
// =============================================================================

fn cf_abs_i64(x: i64) -> i64 { if x < 0 { 0 - x } else { x } }
fn cf_abs_f64(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }
fn cf_max_f64(a: f64, b: f64) -> f64 { if a > b { a } else { b } }

fn cf_floor(x: f64) -> i64 {
    let i = x as i64
    if (i as f64) > x { i - 1 } else { i }
}

fn cf_ln(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 - 1.0e30 }
    if x == 1.0 { return 0.0 }
    var m = x
    var e = 0
    while m >= 2.0 { m = m / 2.0; e = e + 1 }
    while m < 0.5 { m = m * 2.0; e = e - 1 }
    let t = (m - 1.0) / (m + 1.0)
    let t2 = t * t
    var sum = t
    var term = t
    var k = 1
    while k < 30 { term = term * t2; sum = sum + term / ((2 * k + 1) as f64); k = k + 1 }
    2.0 * sum + (e as f64) * 0.6931471805599453
}

fn cf_exp(x: f64) -> f64 with Mut, Div, Panic {
    if x > 500.0 { return 1.0e200 }
    if x < -500.0 { return 0.0 }
    var kf = x / 0.6931471805599453
    var k: i64 = 0
    if kf >= 0.0 { k = kf as i64 } else { k = (kf as i64) - 1 }
    let r = x - (k as f64) * 0.6931471805599453
    var sum = 1.0
    var term = 1.0
    var n = 1
    while n < 25 { term = term * r / (n as f64); sum = sum + term; n = n + 1 }
    var result = sum
    if k >= 0 { var i: i64 = 0; while i < k { result = result * 2.0; i = i + 1 } }
    else { var i: i64 = 0; while i < (0 - k) { result = result / 2.0; i = i + 1 } }
    result
}

fn cf_sin(x: f64) -> f64 with Mut, Div, Panic {
    var t = x
    while t > 3.14159265358979323846 { t = t - 6.28318530717958647692 }
    while t < -3.14159265358979323846 { t = t + 6.28318530717958647692 }
    let t2 = t * t
    var sum = t
    var term = t
    var n = 1
    while n < 15 {
        term = 0.0 - term * t2 / ((2 * n) as f64) / ((2 * n + 1) as f64)
        sum = sum + term
        n = n + 1
    }
    sum
}

fn cf_cos(x: f64) -> f64 with Mut, Div, Panic {
    var t = x
    while t > 3.14159265358979323846 { t = t - 6.28318530717958647692 }
    while t < -3.14159265358979323846 { t = t + 6.28318530717958647692 }
    let t2 = t * t
    var sum = 1.0
    var term = 1.0
    var n = 1
    while n < 15 {
        term = 0.0 - term * t2 / ((2 * n - 1) as f64) / ((2 * n) as f64)
        sum = sum + term
        n = n + 1
    }
    sum
}

fn cf_atan(x: f64) -> f64 with Mut, Div, Panic {
    if x > 1.0 { return 1.5707963267948966 - cf_atan(1.0 / x) }
    if x < -1.0 { return 0.0 - 1.5707963267948966 - cf_atan(1.0 / x) }
    let x2 = x * x
    var sum = x
    var term = x
    var n = 1
    while n < 50 {
        term = 0.0 - term * x2
        sum = sum + term / ((2 * n + 1) as f64)
        n = n + 1
    }
    sum
}

// =============================================================================
// GCD for rationals
// =============================================================================

fn cf_gcd(a: i64, b: i64) -> i64 with Mut, Div {
    var x = cf_abs_i64(a)
    var y = cf_abs_i64(b)
    while y != 0 {
        let t = y
        y = x - (x / y) * y
        x = t
    }
    x
}

// =============================================================================
// CF from rational p/q
// =============================================================================

// Convert a rational number p/q to its simple continued fraction [a0; a1, a2, ...].
// Uses the Euclidean algorithm. Terminates exactly for rationals.
fn cf_from_rational(p: i64, q: i64) -> ContinuedFraction with Mut, Div {
    var cf: ContinuedFraction = ContinuedFraction { coeffs: [0; 256], len: 0 }
    if q == 0 { return cf }

    var a = p
    var b = q

    // Handle negative: ensure b > 0
    if b < 0 { a = 0 - a; b = 0 - b }

    var i = 0
    while b != 0 && i < 256 {
        var quo = a / b
        // Floor division for negative
        if a < 0 && (a - quo * b) != 0 { quo = quo - 1 }
        cf.coeffs[i] = quo
        let rem = a - quo * b
        a = b
        b = rem
        i = i + 1
    }
    cf.len = i
    cf
}

// =============================================================================
// CF to rational
// =============================================================================

// Convert a continued fraction back to a rational p/q.
// Uses backward evaluation: p/q = a_{n-1} then iteratively
// p/q = a_k + 1/(p/q) = (a_k * p + q) / p
fn cf_to_rational(cf: &ContinuedFraction) -> RationalPair with Mut, Div {
    if cf.len <= 0 { return RationalPair { p: 0, q: 1 } }

    var p = cf.coeffs[cf.len - 1]
    var q: i64 = 1

    var i = cf.len - 2
    while i >= 0 {
        // p/q = a_i + q/p = (a_i * p + q) / p
        let new_p = cf.coeffs[i] * p + q
        let new_q = p
        p = new_p
        q = new_q
        i = i - 1
    }

    // Normalize sign
    if q < 0 { p = 0 - p; q = 0 - q }

    // Reduce
    let g = cf_gcd(cf_abs_i64(p), cf_abs_i64(q))
    if g > 1 { p = p / g; q = q / g }

    RationalPair { p: p, q: q }
}

// =============================================================================
// Convergents
// =============================================================================

// Compute the k-th convergent p_k/q_k of the continued fraction.
// Uses the Wallis recurrence:
//   p_{-1} = 1, p_0 = a_0
//   q_{-1} = 0, q_0 = 1
//   p_n = a_n * p_{n-1} + p_{n-2}
//   q_n = a_n * q_{n-1} + q_{n-2}
fn cf_convergent(cf: &ContinuedFraction, k: i32) -> RationalPair with Mut, Div {
    if k < 0 || k >= cf.len { return RationalPair { p: 0, q: 1 } }

    var p_prev: i64 = 1    // p_{-1}
    var p_curr = cf.coeffs[0]  // p_0
    var q_prev: i64 = 0    // q_{-1}
    var q_curr: i64 = 1    // q_0

    if k == 0 {
        return RationalPair { p: p_curr, q: q_curr }
    }

    var i = 1
    while i <= k {
        let a = cf.coeffs[i]
        let p_new = a * p_curr + p_prev
        let q_new = a * q_curr + q_prev
        p_prev = p_curr
        q_prev = q_curr
        p_curr = p_new
        q_curr = q_new
        i = i + 1
    }

    // Normalize
    if q_curr < 0 { p_curr = 0 - p_curr; q_curr = 0 - q_curr }
    let g = cf_gcd(cf_abs_i64(p_curr), cf_abs_i64(q_curr))
    if g > 1 { p_curr = p_curr / g; q_curr = q_curr / g }

    RationalPair { p: p_curr, q: q_curr }
}

// Compute all convergents up to cf.len and store in arrays.
fn cf_all_convergents(cf: &ContinuedFraction, ps: &![i64; 256], qs: &![i64; 256]) with Mut, Div {
    if cf.len <= 0 { return }

    ps[0] = cf.coeffs[0]
    qs[0] = 1

    if cf.len == 1 { return }

    ps[1] = cf.coeffs[1] * cf.coeffs[0] + 1
    qs[1] = cf.coeffs[1]

    var i = 2
    while i < cf.len {
        ps[i] = cf.coeffs[i] * ps[i - 1] + ps[i - 2]
        qs[i] = cf.coeffs[i] * qs[i - 1] + qs[i - 2]
        i = i + 1
    }
}

// =============================================================================
// CF from f64
// =============================================================================

// Expand a floating-point number into its continued fraction representation.
// Iterates at most max_terms steps or until the remainder is negligible.
fn cf_from_f64(x: f64, max_terms: i32) -> ContinuedFraction with Mut, Div, Panic {
    var cf: ContinuedFraction = ContinuedFraction { coeffs: [0; 256], len: 0 }
    var r = x
    var i = 0
    let limit = if max_terms < 256 { max_terms } else { 256 }

    while i < limit {
        let a = cf_floor(r)
        cf.coeffs[i] = a
        i = i + 1
        let frac = r - (a as f64)
        if cf_abs_f64(frac) < 1.0e-14 { break }
        r = 1.0 / frac
        // Guard against overflow
        if r > 1.0e15 || r < -1.0e15 { break }
    }
    cf.len = i
    cf
}

// =============================================================================
// CF to f64
// =============================================================================

// Evaluate a continued fraction to floating point via backward evaluation.
fn cf_to_f64(cf: &ContinuedFraction) -> f64 with Mut, Div {
    if cf.len <= 0 { return 0.0 }
    var result = cf.coeffs[cf.len - 1] as f64
    var i = cf.len - 2
    while i >= 0 {
        result = (cf.coeffs[i] as f64) + 1.0 / result
        i = i - 1
    }
    result
}

// =============================================================================
// Best rational approximation
// =============================================================================

// Find the best rational approximation p/q to x with q <= max_denom.
// Uses CF convergents: each convergent is a best approximation of its kind
// (best approximation with denominator not exceeding q_k).
// Also checks semi-convergents (mediants) for completeness.
fn cf_best_rational(x: f64, max_denom: i64) -> RationalPair with Mut, Div, Panic {
    let cf = cf_from_f64(x, 100)

    var best_p: i64 = cf.coeffs[0]
    var best_q: i64 = 1
    var best_err = cf_abs_f64(x - (best_p as f64) / (best_q as f64))

    // Walk through convergents
    var p_prev: i64 = 1
    var p_curr = cf.coeffs[0]
    var q_prev: i64 = 0
    var q_curr: i64 = 1

    var i = 1
    while i < cf.len {
        let a = cf.coeffs[i]

        // Check semi-convergents: (j * p_curr + p_prev) / (j * q_curr + q_prev)
        // for j = 1, ..., a
        var j: i64 = 1
        while j <= a {
            let sp = j * p_curr + p_prev
            let sq = j * q_curr + q_prev
            if sq > max_denom { break }
            let err = cf_abs_f64(x - (sp as f64) / (sq as f64))
            if err < best_err {
                best_p = sp
                best_q = sq
                best_err = err
            }
            j = j + 1
        }

        let p_new = a * p_curr + p_prev
        let q_new = a * q_curr + q_prev

        if q_new > max_denom { break }

        let err = cf_abs_f64(x - (p_new as f64) / (q_new as f64))
        if err < best_err {
            best_p = p_new
            best_q = q_new
            best_err = err
        }

        p_prev = p_curr
        q_prev = q_curr
        p_curr = p_new
        q_curr = q_new
        i = i + 1
    }

    RationalPair { p: best_p, q: best_q }
}

// =============================================================================
// Named continued fractions
// =============================================================================

// sqrt(2) = [1; 2, 2, 2, ...] — periodic with period 1
fn cf_sqrt2(n: i32) -> ContinuedFraction with Mut {
    var cf: ContinuedFraction = ContinuedFraction { coeffs: [0; 256], len: 0 }
    let limit = if n < 256 { n } else { 256 }
    if limit <= 0 { return cf }
    cf.coeffs[0] = 1
    var i = 1
    while i < limit {
        cf.coeffs[i] = 2
        i = i + 1
    }
    cf.len = limit
    cf
}

// e = [2; 1, 2, 1, 1, 4, 1, 1, 6, 1, 1, 8, ...]
// Pattern: [2; 1, 2k, 1] for k = 1, 2, 3, ...
fn cf_e(n: i32) -> ContinuedFraction with Mut {
    var cf: ContinuedFraction = ContinuedFraction { coeffs: [0; 256], len: 0 }
    let limit = if n < 256 { n } else { 256 }
    if limit <= 0 { return cf }
    cf.coeffs[0] = 2
    var i = 1
    while i < limit {
        let m = i - 1  // 0-indexed position after a0
        let r = m - (m / 3) * 3  // m mod 3
        if r == 1 {
            // Position 1, 4, 7, 10, ... -> 2, 4, 6, 8, ...
            cf.coeffs[i] = (2 * ((m / 3) + 1)) as i64
        } else {
            cf.coeffs[i] = 1
        }
        i = i + 1
    }
    cf.len = limit
    cf
}

// Golden ratio phi = [1; 1, 1, 1, ...] — the "most irrational" number
fn cf_golden(n: i32) -> ContinuedFraction with Mut {
    var cf: ContinuedFraction = ContinuedFraction { coeffs: [0; 256], len: 0 }
    let limit = if n < 256 { n } else { 256 }
    var i = 0
    while i < limit {
        cf.coeffs[i] = 1
        i = i + 1
    }
    cf.len = limit
    cf
}

// sqrt(N) = [a0; a1, a2, ..., 2*a0] (periodic) where a0 = floor(sqrt(N)).
// Returns the periodic CF expansion for sqrt(N).
fn cf_sqrt_n(nn: i64, max_terms: i32) -> ContinuedFraction with Mut, Div {
    var cf: ContinuedFraction = ContinuedFraction { coeffs: [0; 256], len: 0 }
    if nn <= 0 { return cf }

    // Integer sqrt via Newton
    var s: i64 = 1
    while s * s <= nn { s = s + 1 }
    s = s - 1

    // Perfect square check
    if s * s == nn {
        cf.coeffs[0] = s
        cf.len = 1
        return cf
    }

    let a0 = s
    cf.coeffs[0] = a0
    var idx = 1
    let limit = if max_terms < 256 { max_terms } else { 256 }

    var m: i64 = 0
    var d: i64 = 1
    var a = a0

    while idx < limit {
        m = d * a - m
        d = (nn - m * m) / d
        if d == 0 { break }
        a = (a0 + m) / d
        cf.coeffs[idx] = a
        idx = idx + 1
        // Period ends when a == 2*a0
        if a == 2 * a0 { break }
    }
    cf.len = idx
    cf
}

// Pi: computed via cf_from_f64 with high precision.
// pi = [3; 7, 15, 1, 292, 1, 1, 1, 2, ...]
fn cf_pi(n: i32) -> ContinuedFraction with Mut, Div, Panic {
    cf_from_f64(3.14159265358979323846, n)
}

// =============================================================================
// Generalized CF evaluation: modified Lentz-Thompson-Barnett
// =============================================================================

// Evaluates a generalized continued fraction:
//   b0 + a1/(b1 + a2/(b2 + a3/(b3 + ...)))
//
// Given functions a(n) and b(n) for n = 0, 1, 2, ...:
//   f = b0 + a1/(b1 + a2/(b2 + ...))
//
// The modified Lentz method avoids the instabilities of forward/backward
// recurrence by maintaining a product form. This is THE standard method
// for evaluating continued fractions in numerical software.
//
// Uses a_fn(n) for numerator coefficients and b_fn(n) for denominator coefficients
// where the CF is b(0) + a(1)/(b(1) + a(2)/(b(2) + ...))
//
// Parameters:
//   a: array of a(n) values, a[0] unused (or set to 0)
//   b: array of b(n) values
//   n: number of terms to evaluate
//
// Returns the evaluated CF value.
fn gcf_eval(a: &[f64; 256], b: &[f64; 256], n: i32) -> f64 with Mut, Div, Panic {
    let tiny = 1.0e-30

    // f = b[0]; if zero, use tiny
    var f = b[0]
    if cf_abs_f64(f) < tiny { f = tiny }

    var c = f
    var d = 0.0

    var i = 1
    while i < n {
        d = b[i] + a[i] * d
        if cf_abs_f64(d) < tiny { d = tiny }
        c = b[i] + a[i] / c
        if cf_abs_f64(c) < tiny { c = tiny }
        d = 1.0 / d
        let delta = c * d
        f = f * delta
        if cf_abs_f64(delta - 1.0) < 1.0e-15 { break }
        i = i + 1
    }
    f
}

// =============================================================================
// CF-based function evaluation
// =============================================================================

// Evaluate tan(x) via its continued fraction:
// tan(x) = x / (1 - x^2 / (3 - x^2 / (5 - x^2 / (7 - ...))))
fn cf_tan(x: f64, n: i32) -> f64 with Mut, Div, Panic {
    var a: [f64; 256] = [0.0; 256]
    var b: [f64; 256] = [0.0; 256]
    let x2 = x * x

    b[0] = 0.0
    a[1] = x
    b[1] = 1.0

    var i = 2
    while i < n && i < 256 {
        a[i] = 0.0 - x2
        b[i] = ((2 * i - 1) as f64)
        i = i + 1
    }

    gcf_eval(&a, &b, n)
}

// Evaluate exp(x) via the Padé-like continued fraction:
// e^x = 1 + 2x / (2 - x + x^2/(6 + x^2/(10 + x^2/(14 + ...))))
fn cf_exp(x: f64, n: i32) -> f64 with Mut, Div, Panic {
    // Use the standard CF: e^x = 1/(1 - x/(1 + x/(2 - x/(3 + x/(2 - ...)))))
    // Alternative: direct Taylor is often simpler; this demonstrates CF evaluation
    var a: [f64; 256] = [0.0; 256]
    var b: [f64; 256] = [0.0; 256]

    b[0] = 1.0
    a[1] = x
    b[1] = 1.0

    var i = 2
    while i < n && i < 256 {
        if (i - (i / 2) * 2) == 0 {
            // even
            a[i] = 0.0 - x
            b[i] = (i / 2) as f64
        } else {
            // odd
            a[i] = x
            b[i] = 1.0
        }
        i = i + 1
    }

    // Fallback: use gcf_eval on the standard Euler CF for exp
    // This is illustrative; in production, use the Taylor-based cf_exp above
    cf_exp_helper(x)
}

fn cf_exp_helper(x: f64) -> f64 with Mut, Div, Panic {
    cf_exp(x)  // Use the helper function defined at top
}

// Evaluate ln(1+x) via its continued fraction (valid for x > -1):
// ln(1+x) = x/(1 + 1^2*x/(2 + 1^2*x/(3 + 2^2*x/(4 + 2^2*x/(5 + ...)))))
fn cf_ln1p(x: f64, n: i32) -> f64 with Mut, Div, Panic {
    var a: [f64; 256] = [0.0; 256]
    var b: [f64; 256] = [0.0; 256]

    b[0] = 0.0
    a[1] = x
    b[1] = 1.0

    var i = 2
    let limit = if n < 256 { n } else { 256 }
    while i < limit {
        let k = (i - 1) / 2  // 0, 0, 1, 1, 2, 2, ...
        let kp = (i / 2) as i64  // 1, 1, 1, 2, 2, 3, ...
        a[i] = (kp * kp) as f64 * x
        b[i] = i as f64
        i = i + 1
    }

    gcf_eval(&a, &b, limit)
}

// =============================================================================
// CF arithmetic: mediant (Stern-Brocot)
// =============================================================================

// Mediant of two fractions: (p1+p2)/(q1+q2).
// Key to Stern-Brocot tree and CF-based rational approximation.
fn mediant(a: &RationalPair, b: &RationalPair) -> RationalPair {
    RationalPair { p: a.p + b.p, q: a.q + b.q }
}

// =============================================================================
// CF comparison and properties
// =============================================================================

// Check if two CFs are equal (coefficient-by-coefficient).
fn cf_equal(a: &ContinuedFraction, b: &ContinuedFraction) -> bool with Mut {
    if a.len != b.len { return false }
    var i = 0
    while i < a.len {
        if a.coeffs[i] != b.coeffs[i] { return false }
        i = i + 1
    }
    true
}

// Check if a CF represents a rational number (finite CF).
// All finite CFs represent rationals; infinite CFs represent irrationals.
// In practice, we check if the CF was "short" relative to precision.
fn cf_is_rational(cf: &ContinuedFraction) -> bool {
    cf.len < 50  // Heuristic: short CFs likely rational
}

// Return the period length of a periodic CF (e.g., sqrt(N)).
// Returns 0 if no period detected within the length.
fn cf_period(cf: &ContinuedFraction) -> i32 with Mut {
    if cf.len < 3 { return 0 }
    // Check if last element is 2 * first (hallmark of sqrt CF)
    let a0 = cf.coeffs[0]
    if cf.coeffs[cf.len - 1] == 2 * a0 {
        return cf.len - 1
    }
    0
}

// Compute |x - p_k/q_k| — error of k-th convergent.
fn cf_convergent_error(cf: &ContinuedFraction, k: i32, x: f64) -> f64 with Mut, Div {
    let conv = cf_convergent(cf, k)
    if conv.q == 0 { return 1.0e30 }
    cf_abs_f64(x - (conv.p as f64) / (conv.q as f64))
}

// =============================================================================
// Gauss's CF for 2F1 (hypergeometric-related)
// =============================================================================

// Evaluate the Gauss continued fraction for the ratio of hypergeometric functions:
//   2F1(a, b+1; c+1; z) / 2F1(a, b; c; z) = 1 / (1 - d1*z/(1 - d2*z/(1 - ...)))
// where d_{2n+1} = a*(c-b+n)*z / ((c+2n)*(c+2n+1))
//       d_{2n}   = (b+n)*(c-a+n)*z / ((c+2n-1)*(c+2n))
//
// This is useful for evaluating 2F1 ratios stably.
fn gauss_cf_2f1_ratio(aa: f64, bb: f64, cc: f64, z: f64, max_iter: i32) -> f64 with Mut, Div, Panic {
    let tiny = 1.0e-30
    var f = 1.0
    var c = 1.0
    var d = 0.0

    var n = 1
    while n <= max_iter {
        // Compute a_n (the CF numerator)
        var an: f64 = 0.0
        let m = (n - 1) / 2
        if (n - (n / 2) * 2) == 1 {
            // Odd: n = 2m+1
            let mf = m as f64
            an = 0.0 - (aa + mf) * (cc - bb + mf) * z / ((cc + 2.0 * mf) * (cc + 2.0 * mf + 1.0))
        } else {
            // Even: n = 2m
            let mf = (n / 2) as f64
            an = 0.0 - (bb + mf) * (cc - aa + mf) * z / ((cc + 2.0 * mf - 1.0) * (cc + 2.0 * mf))
        }

        d = 1.0 + an * d
        if cf_abs_f64(d) < tiny { d = tiny }
        c = 1.0 + an / c
        if cf_abs_f64(c) < tiny { c = tiny }
        d = 1.0 / d
        let delta = c * d
        f = f * delta
        if cf_abs_f64(delta - 1.0) < 1.0e-15 { break }
        n = n + 1
    }
    f
}
