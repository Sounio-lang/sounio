//! stdlib/math/core.sio - Core mathematical function declarations
//!
//! Declares mathematical functions that are implemented via FFI bindings to libm.
//! See lib.sio for the public module interface

// External C library math functions
extern "C" {
    // Trigonometric functions (f64 versions)
    fn sin(x: f64) -> f64;
    fn cos(x: f64) -> f64;
    fn tan(x: f64) -> f64;
    fn asin(x: f64) -> f64;
    fn acos(x: f64) -> f64;
    fn atan(x: f64) -> f64;
    fn atan2(y: f64, x: f64) -> f64;

    // Exponential and logarithmic functions (f64 versions)
    fn exp(x: f64) -> f64;
    fn log(x: f64) -> f64;
    fn log10(x: f64) -> f64;
    fn log2(x: f64) -> f64;
    fn pow(base: f64, exp: f64) -> f64;

    // Power and roots (f64 versions)
    fn sqrt(x: f64) -> f64;
    fn cbrt(x: f64) -> f64;

    // Rounding functions (f64 versions)
    fn floor(x: f64) -> f64;
    fn ceil(x: f64) -> f64;
    fn round(x: f64) -> f64;
    fn trunc(x: f64) -> f64;

    // Absolute value (f64 versions)
    fn fabs(x: f64) -> f64;
}

// Alias for fabs
pub fn abs(x: f64) -> f64 { fabs(x) }

// Comparison functions (f64 versions - implemented in pure Sounio)
pub fn max(a: f64, b: f64) -> f64 { if a > b { a } else { b } }
pub fn min(a: f64, b: f64) -> f64 { if a < b { a } else { b } }

// External C library math functions (f32 versions)
extern "C" {
    // Trigonometric functions (f32 versions)
    fn sinf(x: f32) -> f32;
    fn cosf(x: f32) -> f32;
    fn tanf(x: f32) -> f32;
    fn asinf(x: f32) -> f32;
    fn acosf(x: f32) -> f32;
    fn atanf(x: f32) -> f32;
    fn atan2f(y: f32, x: f32) -> f32;

    // Exponential and logarithmic functions (f32 versions)
    fn expf(x: f32) -> f32;
    fn logf(x: f32) -> f32;
    fn log10f(x: f32) -> f32;
    fn log2f(x: f32) -> f32;
    fn powf(base: f32, exp: f32) -> f32;

    // Power and roots (f32 versions)
    fn sqrtf(x: f32) -> f32;
    fn cbrtf(x: f32) -> f32;

    // Rounding functions (f32 versions)
    fn floorf(x: f32) -> f32;
    fn ceilf(x: f32) -> f32;
    fn roundf(x: f32) -> f32;
    fn truncf(x: f32) -> f32;

    // Absolute value (f32 versions)
    fn fabsf(x: f32) -> f32;
}

// Wrapper functions with friendlier names for f32
fn sin_f32(x: f32) -> f32 { sinf(x) }
fn cos_f32(x: f32) -> f32 { cosf(x) }
fn tan_f32(x: f32) -> f32 { tanf(x) }
fn asin_f32(x: f32) -> f32 { asinf(x) }
fn acos_f32(x: f32) -> f32 { acosf(x) }
fn atan_f32(x: f32) -> f32 { atanf(x) }
fn atan2_f32(y: f32, x: f32) -> f32 { atan2f(y, x) }
fn exp_f32(x: f32) -> f32 { expf(x) }
fn log_f32(x: f32) -> f32 { logf(x) }
fn log10_f32(x: f32) -> f32 { log10f(x) }
fn log2_f32(x: f32) -> f32 { log2f(x) }
fn pow_f32(base: f32, exp: f32) -> f32 { powf(base, exp) }
fn sqrt_f32(x: f32) -> f32 { sqrtf(x) }
fn cbrt_f32(x: f32) -> f32 { cbrtf(x) }
fn floor_f32(x: f32) -> f32 { floorf(x) }
fn ceil_f32(x: f32) -> f32 { ceilf(x) }
fn round_f32(x: f32) -> f32 { roundf(x) }
fn trunc_f32(x: f32) -> f32 { truncf(x) }
pub fn abs_f32(x: f32) -> f32 { fabsf(x) }

// Comparison functions (f32 versions - implemented in pure Sounio)
pub fn max_f32(a: f32, b: f32) -> f32 { if a > b { a } else { b } }
pub fn min_f32(a: f32, b: f32) -> f32 { if a < b { a } else { b } }

// Constants
pub const PI: f64 = 3.141592653589793
pub const E: f64 = 2.718281828459045
pub const PI_F32: f32 = 3.141592653589793
pub const E_F32: f32 = 2.718281828459045

// Utility functions
pub fn deg_to_rad(degrees: f64) -> f64 with Panic {
    degrees * PI / 180.0
}

pub fn rad_to_deg(radians: f64) -> f64 with Panic {
    radians * 180.0 / PI
}

pub fn deg_to_rad_f32(degrees: f32) -> f32 with Panic {
    degrees * PI_F32 / 180.0
}

pub fn rad_to_deg_f32(radians: f32) -> f32 with Panic {
    radians * 180.0 / PI_F32
}
