//! stdlib/math/core.sio - Core mathematical function declarations
//!
//! Declares mathematical functions that are implemented via FFI bindings to libm.
//! See lib.sio for the public module interface

// Trigonometric functions (f64 versions)
#[extern("sin")]
pub fn sin(x: f64) -> f64 { }

#[extern("cos")]
pub fn cos(x: f64) -> f64 { }

#[extern("tan")]
pub fn tan(x: f64) -> f64 { }

#[extern("asin")]
pub fn asin(x: f64) -> f64 { }

#[extern("acos")]
pub fn acos(x: f64) -> f64 { }

#[extern("atan")]
pub fn atan(x: f64) -> f64 { }

#[extern("atan2")]
pub fn atan2(y: f64, x: f64) -> f64 { }

// Exponential and logarithmic functions (f64 versions)
#[extern("exp")]
pub fn exp(x: f64) -> f64 { }

#[extern("log")]
pub fn log(x: f64) -> f64 { }

#[extern("log10")]
pub fn log10(x: f64) -> f64 { }

#[extern("log2")]
pub fn log2(x: f64) -> f64 { }

#[extern("pow")]
pub fn pow(base: f64, exp: f64) -> f64 { }

// Power and roots (f64 versions)
#[extern("sqrt")]
pub fn sqrt(x: f64) -> f64 { }

#[extern("cbrt")]
pub fn cbrt(x: f64) -> f64 { }

// Rounding functions (f64 versions)
#[extern("floor")]
pub fn floor(x: f64) -> f64 { }

#[extern("ceil")]
pub fn ceil(x: f64) -> f64 { }

#[extern("round")]
pub fn round(x: f64) -> f64 { }

#[extern("trunc")]
pub fn trunc(x: f64) -> f64 { }

// Absolute value (f64 versions)
#[extern("fabs")]
pub fn abs(x: f64) -> f64 { }

// Comparison functions (f64 versions - implemented in pure Sounio)
pub fn max(a: f64, b: f64) -> f64 { if a > b { a } else { b } }
pub fn min(a: f64, b: f64) -> f64 { if a < b { a } else { b } }

// Trigonometric functions (f32 versions)
#[extern("sinf")]
pub fn sin_f32(x: f32) -> f32 { }

#[extern("cosf")]
pub fn cos_f32(x: f32) -> f32 { }

#[extern("tanf")]
pub fn tan_f32(x: f32) -> f32 { }

#[extern("asinf")]
pub fn asin_f32(x: f32) -> f32 { }

#[extern("acosf")]
pub fn acos_f32(x: f32) -> f32 { }

#[extern("atanf")]
pub fn atan_f32(x: f32) -> f32 { }

#[extern("atan2f")]
pub fn atan2_f32(y: f32, x: f32) -> f32 { }

// Exponential and logarithmic functions (f32 versions)
#[extern("expf")]
pub fn exp_f32(x: f32) -> f32 { }

#[extern("logf")]
pub fn log_f32(x: f32) -> f32 { }

#[extern("log10f")]
pub fn log10_f32(x: f32) -> f32 { }

#[extern("log2f")]
pub fn log2_f32(x: f32) -> f32 { }

#[extern("powf")]
pub fn pow_f32(base: f32, exp: f32) -> f32 { }

// Power and roots (f32 versions)
#[extern("sqrtf")]
pub fn sqrt_f32(x: f32) -> f32 { }

#[extern("cbrtf")]
pub fn cbrt_f32(x: f32) -> f32 { }

// Rounding functions (f32 versions)
#[extern("floorf")]
pub fn floor_f32(x: f32) -> f32 { }

#[extern("ceilf")]
pub fn ceil_f32(x: f32) -> f32 { }

#[extern("roundf")]
pub fn round_f32(x: f32) -> f32 { }

#[extern("truncf")]
pub fn trunc_f32(x: f32) -> f32 { }

// Absolute value (f32 versions)
#[extern("fabsf")]
pub fn abs_f32(x: f32) -> f32 { }

// Comparison functions (f32 versions - implemented in pure Sounio)
pub fn max_f32(a: f32, b: f32) -> f32 { if a > b { a } else { b } }
pub fn min_f32(a: f32, b: f32) -> f32 { if a < b { a } else { b } }

// Constants
pub const PI: f64 = 3.141592653589793
pub const E: f64 = 2.718281828459045
pub const PI_F32: f32 = 3.141592653589793
pub const E_F32: f32 = 2.718281828459045

// Utility functions
pub fn deg_to_rad(degrees: f64) -> f64 {
    degrees * PI / 180.0
}

pub fn rad_to_deg(radians: f64) -> f64 {
    radians * 180.0 / PI
}

pub fn deg_to_rad_f32(degrees: f32) -> f32 {
    degrees * PI_F32 / 180.0
}

pub fn rad_to_deg_f32(radians: f32) -> f32 {
    radians * 180.0 / PI_F32
}
