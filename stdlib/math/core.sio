//! stdlib/math/core.sio - Core mathematical functions
//!
//! Provides essential mathematical operations via FFI bindings to libm.
//! All functions operate on f64 (double precision) and f32 (single precision).
//!
//! Categories:
//! - Trigonometric: sin, cos, tan, asin, acos, atan, atan2
//! - Exponential/Logarithmic: exp, log, log10, log2, pow, sqrt, cbrt
//! - Rounding: floor, ceil, round, trunc
//! - Comparison: abs, max, min
//! - Constants: PI, E

// ============================================================================
// TRIGONOMETRIC FUNCTIONS (f64)
// ============================================================================

/// sin(x) - Sine of x (in radians)
fn sin(x: f64) -> f64 {
    @extern("sin")
}

/// cos(x) - Cosine of x (in radians)
fn cos(x: f64) -> f64 {
    @extern("cos")
}

/// tan(x) - Tangent of x (in radians)
fn tan(x: f64) -> f64 {
    @extern("tan")
}

/// asin(x) - Arc sine of x, result in radians [-π/2, π/2]
fn asin(x: f64) -> f64 {
    @extern("asin")
}

/// acos(x) - Arc cosine of x, result in radians [0, π]
fn acos(x: f64) -> f64 {
    @extern("acos")
}

/// atan(x) - Arc tangent of x, result in radians [-π/2, π/2]
fn atan(x: f64) -> f64 {
    @extern("atan")
}

/// atan2(y, x) - Arc tangent of y/x, result in radians [-π, π]
/// Takes into account the quadrant to give correct angle
fn atan2(y: f64, x: f64) -> f64 {
    @extern("atan2")
}

// ============================================================================
// EXPONENTIAL & LOGARITHMIC FUNCTIONS (f64)
// ============================================================================

/// exp(x) - e raised to the power x
fn exp(x: f64) -> f64 {
    @extern("exp")
}

/// log(x) - Natural logarithm (base e) of x
/// Undefined for x <= 0
fn log(x: f64) -> f64 {
    @extern("log")
}

/// log10(x) - Base-10 logarithm of x
/// Undefined for x <= 0
fn log10(x: f64) -> f64 {
    @extern("log10")
}

/// log2(x) - Base-2 logarithm of x
/// Undefined for x <= 0
fn log2(x: f64) -> f64 {
    @extern("log2")
}

/// pow(base, exp) - base raised to the power exp
fn pow(base: f64, exp: f64) -> f64 {
    @extern("pow")
}

/// sqrt(x) - Square root of x
/// Undefined for x < 0
fn sqrt(x: f64) -> f64 {
    @extern("sqrt")
}

/// cbrt(x) - Cube root of x
fn cbrt(x: f64) -> f64 {
    @extern("cbrt")
}

// ============================================================================
// ROUNDING FUNCTIONS (f64)
// ============================================================================

/// floor(x) - Largest integer <= x
fn floor(x: f64) -> f64 {
    @extern("floor")
}

/// ceil(x) - Smallest integer >= x
fn ceil(x: f64) -> f64 {
    @extern("ceil")
}

/// round(x) - Round to nearest integer (0.5 rounds away from zero)
fn round(x: f64) -> f64 {
    @extern("round")
}

/// trunc(x) - Truncate to integer (remove fractional part)
fn trunc(x: f64) -> f64 {
    @extern("trunc")
}

// ============================================================================
// COMPARISON & ABSOLUTE VALUE (f64)
// ============================================================================

/// abs(x) - Absolute value of x
fn abs(x: f64) -> f64 {
    @extern("fabs")
}

/// max(a, b) - Maximum of two numbers
fn max(a: f64, b: f64) -> f64 {
    if a > b { a } else { b }
}

/// min(a, b) - Minimum of two numbers
fn min(a: f64, b: f64) -> f64 {
    if a < b { a } else { b }
}

// ============================================================================
// f32 VERSIONS (Single Precision)
// ============================================================================

/// sin_f32(x) - Sine of x (in radians)
fn sin_f32(x: f32) -> f32 {
    @extern("sinf")
}

/// cos_f32(x) - Cosine of x (in radians)
fn cos_f32(x: f32) -> f32 {
    @extern("cosf")
}

/// tan_f32(x) - Tangent of x (in radians)
fn tan_f32(x: f32) -> f32 {
    @extern("tanf")
}

/// asin_f32(x) - Arc sine of x
fn asin_f32(x: f32) -> f32 {
    @extern("asinf")
}

/// acos_f32(x) - Arc cosine of x
fn acos_f32(x: f32) -> f32 {
    @extern("acosf")
}

/// atan_f32(x) - Arc tangent of x
fn atan_f32(x: f32) -> f32 {
    @extern("atanf")
}

/// atan2_f32(y, x) - Arc tangent of y/x
fn atan2_f32(y: f32, x: f32) -> f32 {
    @extern("atan2f")
}

/// exp_f32(x) - e raised to the power x
fn exp_f32(x: f32) -> f32 {
    @extern("expf")
}

/// log_f32(x) - Natural logarithm of x
fn log_f32(x: f32) -> f32 {
    @extern("logf")
}

/// log10_f32(x) - Base-10 logarithm of x
fn log10_f32(x: f32) -> f32 {
    @extern("log10f")
}

/// log2_f32(x) - Base-2 logarithm of x
fn log2_f32(x: f32) -> f32 {
    @extern("log2f")
}

/// pow_f32(base, exp) - base raised to the power exp
fn pow_f32(base: f32, exp: f32) -> f32 {
    @extern("powf")
}

/// sqrt_f32(x) - Square root of x
fn sqrt_f32(x: f32) -> f32 {
    @extern("sqrtf")
}

/// cbrt_f32(x) - Cube root of x
fn cbrt_f32(x: f32) -> f32 {
    @extern("cbrtf")
}

/// floor_f32(x) - Largest integer <= x
fn floor_f32(x: f32) -> f32 {
    @extern("floorf")
}

/// ceil_f32(x) - Smallest integer >= x
fn ceil_f32(x: f32) -> f32 {
    @extern("ceilf")
}

/// round_f32(x) - Round to nearest integer
fn round_f32(x: f32) -> f32 {
    @extern("roundf")
}

/// trunc_f32(x) - Truncate to integer
fn trunc_f32(x: f32) -> f32 {
    @extern("truncf")
}

/// abs_f32(x) - Absolute value of x
fn abs_f32(x: f32) -> f32 {
    @extern("fabsf")
}

/// max_f32(a, b) - Maximum of two f32 numbers
fn max_f32(a: f32, b: f32) -> f32 {
    if a > b { a } else { b }
}

/// min_f32(a, b) - Minimum of two f32 numbers
fn min_f32(a: f32, b: f32) -> f32 {
    if a < b { a } else { b }
}

// ============================================================================
// MATHEMATICAL CONSTANTS
// ============================================================================

/// π (pi) - Ratio of circle circumference to diameter
const PI: f64 = 3.141592653589793

/// e - Euler's number, base of natural logarithm
const E: f64 = 2.718281828459045

/// π (pi) - Single precision version
const PI_F32: f32 = 3.141592653589793

/// e - Single precision version
const E_F32: f32 = 2.718281828459045

// ============================================================================
// UTILITY: Degree/Radian Conversion
// ============================================================================

/// Convert degrees to radians
fn deg_to_rad(degrees: f64) -> f64 {
    degrees * PI / 180.0
}

/// Convert radians to degrees
fn rad_to_deg(radians: f64) -> f64 {
    radians * 180.0 / PI
}

/// Convert degrees to radians (f32)
fn deg_to_rad_f32(degrees: f32) -> f32 {
    degrees * PI_F32 / 180.0
}

/// Convert radians to degrees (f32)
fn rad_to_deg_f32(radians: f32) -> f32 {
    radians * 180.0 / PI_F32
}
