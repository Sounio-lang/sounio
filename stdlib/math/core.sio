//! stdlib/math/core.sio - Core mathematical function declarations
//!
//! Declares mathematical functions that are builtin/intrinsic
//! See lib.sio for the public module interface

// These are builtin functions handled by the compiler
// Stubs with panic bodies - actual implementation delegated to builtins
pub fn sin(x: f64) -> f64 { panic("sin builtin") }
pub fn cos(x: f64) -> f64 { panic("cos builtin") }
pub fn tan(x: f64) -> f64 { panic("tan builtin") }
pub fn asin(x: f64) -> f64 { panic("asin builtin") }
pub fn acos(x: f64) -> f64 { panic("acos builtin") }
pub fn atan(x: f64) -> f64 { panic("atan builtin") }
pub fn atan2(y: f64, x: f64) -> f64 { panic("atan2 builtin") }
pub fn exp(x: f64) -> f64 { panic("exp builtin") }
pub fn log(x: f64) -> f64 { panic("log builtin") }
pub fn log10(x: f64) -> f64 { panic("log10 builtin") }
pub fn log2(x: f64) -> f64 { panic("log2 builtin") }
pub fn pow(base: f64, exp: f64) -> f64 { panic("pow builtin") }
pub fn sqrt(x: f64) -> f64 { panic("sqrt builtin") }
pub fn cbrt(x: f64) -> f64 { panic("cbrt builtin") }
pub fn floor(x: f64) -> f64 { panic("floor builtin") }
pub fn ceil(x: f64) -> f64 { panic("ceil builtin") }
pub fn round(x: f64) -> f64 { panic("round builtin") }
pub fn trunc(x: f64) -> f64 { panic("trunc builtin") }
pub fn abs(x: f64) -> f64 { panic("abs builtin") }
pub fn max(a: f64, b: f64) -> f64 { if a > b { a } else { b } }
pub fn min(a: f64, b: f64) -> f64 { if a < b { a } else { b } }
pub fn sin_f32(x: f32) -> f32 { panic("sin_f32 builtin") }
pub fn cos_f32(x: f32) -> f32 { panic("cos_f32 builtin") }
pub fn tan_f32(x: f32) -> f32 { panic("tan_f32 builtin") }
pub fn asin_f32(x: f32) -> f32 { panic("asin_f32 builtin") }
pub fn acos_f32(x: f32) -> f32 { panic("acos_f32 builtin") }
pub fn atan_f32(x: f32) -> f32 { panic("atan_f32 builtin") }
pub fn atan2_f32(y: f32, x: f32) -> f32 { panic("atan2_f32 builtin") }
pub fn exp_f32(x: f32) -> f32 { panic("exp_f32 builtin") }
pub fn log_f32(x: f32) -> f32 { panic("log_f32 builtin") }
pub fn log10_f32(x: f32) -> f32 { panic("log10_f32 builtin") }
pub fn log2_f32(x: f32) -> f32 { panic("log2_f32 builtin") }
pub fn pow_f32(base: f32, exp: f32) -> f32 { panic("pow_f32 builtin") }
pub fn sqrt_f32(x: f32) -> f32 { panic("sqrt_f32 builtin") }
pub fn cbrt_f32(x: f32) -> f32 { panic("cbrt_f32 builtin") }
pub fn floor_f32(x: f32) -> f32 { panic("floor_f32 builtin") }
pub fn ceil_f32(x: f32) -> f32 { panic("ceil_f32 builtin") }
pub fn round_f32(x: f32) -> f32 { panic("round_f32 builtin") }
pub fn trunc_f32(x: f32) -> f32 { panic("trunc_f32 builtin") }
pub fn abs_f32(x: f32) -> f32 { panic("abs_f32 builtin") }
pub fn max_f32(a: f32, b: f32) -> f32 { if a > b { a } else { b } }
pub fn min_f32(a: f32, b: f32) -> f32 { if a < b { a } else { b } }

// Constants
pub const PI: f64 = 3.141592653589793
pub const E: f64 = 2.718281828459045
pub const PI_F32: f32 = 3.141592653589793
pub const E_F32: f32 = 2.718281828459045

// Utility functions
pub fn deg_to_rad(degrees: f64) -> f64 {
    degrees * PI / 180.0
}

pub fn rad_to_deg(radians: f64) -> f64 {
    radians * 180.0 / PI
}

pub fn deg_to_rad_f32(degrees: f32) -> f32 {
    degrees * PI_F32 / 180.0
}

pub fn rad_to_deg_f32(radians: f32) -> f32 {
    radians * 180.0 / PI_F32
}
