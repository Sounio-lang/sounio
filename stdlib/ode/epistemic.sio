// stdlib/ode/epistemic.sio — Epistemic ODE Solver
//
// ODE integration that propagates uncertainty through time steps.
// Every state variable carries its standard uncertainty and confidence.
// Uncertainty grows with each step; confidence never increases.
//
// This is the ODE solver that scientific computing SHOULD have:
// after integrating, you know not just the solution but HOW UNCERTAIN
// each state is and HOW CONFIDENT you can be in the result.
//
// Implements:
//   - Epistemic RK4 (4th-order Runge-Kutta with uncertainty propagation)
//   - GUM-compliant linearized uncertainty propagation
//   - Step-size-dependent confidence degradation
//   - Adaptive uncertainty monitoring
//
// References:
//   Butcher (2008): "Numerical Methods for ODEs"
//   GUM JCGM 100:2008: "Evaluation of measurement data"
//   Hairer et al. (1993): "Solving ODEs I: Nonstiff Problems"

// =============================================================================
// Math helpers
// =============================================================================

fn sqrt_ode(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 20 { y = 0.5 * (y + x / y); i = i + 1 }
    y
}

fn abs_ode(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn min_ode(a: f64, b: f64) -> f64 {
    if a < b { a } else { b }
}

fn max_ode(a: f64, b: f64) -> f64 {
    if a > b { a } else { b }
}

// =============================================================================
// Epistemic State Vector
// =============================================================================

struct EpistemicState {
    values: [f64; 16],          // state variables (max 16 dimensions)
    uncertainties: [f64; 16],   // standard uncertainty per component
    confidences: [f64; 16],     // confidence per component [0, 1]
    n_dims: i32,
    time: f64,
}

fn estate_new(n: i32) -> EpistemicState {
    EpistemicState {
        values: [0.0; 16],
        uncertainties: [0.0; 16],
        confidences: [1.0; 16],
        n_dims: n,
        time: 0.0,
    }
}

fn estate_set(s: &!EpistemicState, idx: i32, val: f64, unc: f64, conf: f64) with Mut, Panic {
    s.values[idx] = val
    s.uncertainties[idx] = unc
    s.confidences[idx] = conf
}

// =============================================================================
// Derivative with Uncertainty
// =============================================================================
// The derivative function returns both the derivative value AND
// the sensitivity (Jacobian diagonal) for uncertainty propagation.

struct DerivResult {
    deriv: [f64; 16],           // dy/dt for each component
    sensitivity: [f64; 16],     // |df_i/dy_i| for uncertainty propagation
}

// =============================================================================
// Epistemic RK4 Step
// =============================================================================
// Standard RK4 for the values, with linearized GUM propagation for uncertainty.
//
// Uncertainty propagation rule:
//   u(y_{n+1})^2 = u(y_n)^2 + dt^2 * |df/dy|^2 * u(y_n)^2 + u_trunc^2
//   where u_trunc = O(dt^5) is the local truncation error estimate
//
// Confidence degradation:
//   conf(y_{n+1}) = conf(y_n) * (1 - epsilon)
//   where epsilon depends on the relative uncertainty growth

// For a simple single-step demonstration with inline derivative:
// This computes RK4 for a general system where derivative values are
// provided externally (since Sounio doesn't support function pointers).

struct RK4EpistemicConfig {
    dt: f64,
    n_steps: i32,
    confidence_decay_rate: f64,  // per-step confidence decay (e.g., 0.001)
    max_relative_uncertainty: f64, // stop if u/|y| exceeds this
}

fn rk4_epistemic_config_default() -> RK4EpistemicConfig {
    RK4EpistemicConfig {
        dt: 0.01,
        n_steps: 1000,
        confidence_decay_rate: 0.001,
        max_relative_uncertainty: 0.5,  // 50% relative uncertainty = stop
    }
}

// Single RK4 step with uncertainty propagation
// k1..k4 are the RK4 derivative evaluations at the 4 stages
// sens is the sensitivity (|df/dy|) at the current state
fn epistemic_rk4_step(
    state: &!EpistemicState,
    k1: &[f64; 16],
    k2: &[f64; 16],
    k3: &[f64; 16],
    k4: &[f64; 16],
    sens: &[f64; 16],
    dt: f64,
    conf_decay: f64,
) with Mut, Div, Panic {
    var i = 0
    while i < state.n_dims {
        // Standard RK4 update
        let dy = dt / 6.0 * (k1[i] + 2.0 * k2[i] + 2.0 * k3[i] + k4[i])
        state.values[i] = state.values[i] + dy

        // Uncertainty propagation (GUM linearization)
        // u_{n+1}^2 = u_n^2 * (1 + dt * |df/dy|)^2 + truncation_error^2
        let growth_factor = 1.0 + dt * abs_ode(sens[i])
        let u_propagated = state.uncertainties[i] * growth_factor

        // Truncation error estimate: O(dt^5) ~ |k4 - k3| * dt / 6
        let u_trunc = abs_ode(k4[i] - k3[i]) * dt / 6.0

        state.uncertainties[i] = sqrt_ode(u_propagated * u_propagated + u_trunc * u_trunc)

        // Confidence degrades monotonically
        let rel_growth = if abs_ode(state.values[i]) > 1.0e-30 {
            state.uncertainties[i] / abs_ode(state.values[i])
        } else {
            0.0
        }
        // Faster decay for larger relative uncertainty
        let effective_decay = conf_decay * (1.0 + 10.0 * rel_growth)
        state.confidences[i] = state.confidences[i] * (1.0 - effective_decay)

        i = i + 1
    }
    state.time = state.time + dt
}

// =============================================================================
// Simple Exponential Decay: dy/dt = -lambda * y
// =============================================================================
// Exact solution: y(t) = y0 * exp(-lambda * t)
// This serves as a test case and demonstration.

// Compute one RK4 step of exponential decay and update state.
// Returns (updated_value, relative_uncertainty) so caller doesn't
// need to re-read from state (avoids ownership conflicts in loops).
fn exp_decay_step(
    state: &!EpistemicState,
    lambda: f64,
    y: f64,
    dt: f64,
    conf_decay: f64,
) -> f64 with Mut, Div, Panic {
    var k1: [f64; 16] = [0.0; 16]
    k1[0] = 0.0 - lambda * y

    var k2: [f64; 16] = [0.0; 16]
    k2[0] = 0.0 - lambda * (y + dt / 2.0 * k1[0])

    var k3: [f64; 16] = [0.0; 16]
    k3[0] = 0.0 - lambda * (y + dt / 2.0 * k2[0])

    var k4: [f64; 16] = [0.0; 16]
    k4[0] = 0.0 - lambda * (y + dt * k3[0])

    var sens: [f64; 16] = [0.0; 16]
    sens[0] = lambda

    epistemic_rk4_step(state, &k1, &k2, &k3, &k4, &sens, dt, conf_decay)

    // Return updated value so caller can track it without re-reading state
    state.values[0]
}

fn exp_decay_epistemic(
    y0: f64,
    u0: f64,           // initial uncertainty
    lambda: f64,
    config: &RK4EpistemicConfig,
) -> EpistemicState with Mut, Div, Panic {
    var state = estate_new(1)
    estate_set(&!state, 0, y0, u0, 1.0)

    // Track value externally to avoid shared/exclusive borrow conflicts in loop
    var y = y0
    var step = 0
    while step < config.n_steps {
        let dt = config.dt
        // Perform RK4 step (only exclusive borrow of state in this loop body)
        y = exp_decay_step(&!state, lambda, y, dt, config.confidence_decay_rate)
        step = step + 1
    }
    state
}

// =============================================================================
// Integration Summary
// =============================================================================

struct IntegrationSummary {
    final_time: f64,
    n_steps_taken: i32,
    min_confidence: f64,
    max_relative_uncertainty: f64,
    converged: bool,
}

fn integration_summary(state: &EpistemicState, n_steps: i32) -> IntegrationSummary with Mut, Div, Panic {
    var min_conf: f64 = 1.0
    var max_rel: f64 = 0.0
    var i = 0
    while i < state.n_dims {
        min_conf = min_ode(min_conf, state.confidences[i])
        let val = abs_ode(state.values[i])
        if val > 1.0e-30 {
            let rel = state.uncertainties[i] / val
            max_rel = max_ode(max_rel, rel)
        }
        i = i + 1
    }

    IntegrationSummary {
        final_time: state.time,
        n_steps_taken: n_steps,
        min_confidence: min_conf,
        max_relative_uncertainty: max_rel,
        converged: max_rel < 0.1,  // less than 10% relative uncertainty
    }
}
