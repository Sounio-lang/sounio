// pbpk_debug.d - Debug why RK4 step isn't working

struct PBPKState {
    gut: f64,
    central: f64
}

struct PBPKDeriv {
    d_gut: f64,
    d_central: f64
}

fn pbpk_ode(st: PBPKState, ka: f64, ke: f64) -> PBPKDeriv {
    let dg = 0.0 - ka * st.gut
    let dc = ka * st.gut - ke * st.central
    return PBPKDeriv {
        d_gut: dg,
        d_central: dc
    }
}
