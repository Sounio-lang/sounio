// Accepted-observation diagnostics, compatible with the ROS4 NumericBuffer context.
// Packed caller-owned16-scalar header + six SoA capacity blocks. No hot Alloc
// or aggregate-return helpers. Header integrity is checked, not authenticated.
use collections::numeric_buffer::{NumericBuffer,numeric_buffer_status,numeric_buffer_len,numeric_buffer_at,numeric_buffer_set}
use math::pure::{is_finite}
fn dob_abs(x:f64)->f64 {if x<0.0 {-x}else{x}}
fn dob_integer(x:f64,lo:f64,hi:f64)->bool {
 if !is_finite(x) {return false}
 if x<lo || x>hi {return false}
 let value=x as i64
 return (value as f64)==x
}
pub fn diagnostic_observer_workspace(capacity:i64)->i64 with Div {
 if capacity<1 || capacity>9007199254740992 {return -1}
 if capacity>(9223372036854771704/8-16)/6 {return -1}
 return 16+6*capacity
}
fn dob_header(c:&NumericBuffer)->bool with Div,Panic {
 if numeric_buffer_status(c)!=0 {return false}
 let length=numeric_buffer_len(c)
 if length<16 {return false}
 if numeric_buffer_at(c,0)!=314159.0 {return false}
 let cf=numeric_buffer_at(c,1)
 if !dob_integer(cf,1.0,9007199254740992.0) {return false}
 let cap=cf as i64
 let need=diagnostic_observer_workspace(cap)
 if need<0 {return false}
 if length!=need {return false}
 let used=numeric_buffer_at(c,3)
 if !dob_integer(numeric_buffer_at(c,2),0.0,9007199254740992.0) || !dob_integer(used,0.0,cf) {return false}
 if used>numeric_buffer_at(c,2) {return false}
 if !dob_integer(numeric_buffer_at(c,4),-1.0,1.0) || !dob_integer(numeric_buffer_at(c,5),-1.0,1.0) {return false}
 var j:i64=6
 while j<16 {if !is_finite(numeric_buffer_at(c,j)) {return false};j=j+1}
 if !dob_integer(numeric_buffer_at(c,9),0.0,used) || !dob_integer(numeric_buffer_at(c,10),0.0,2.0) {return false}
 if !dob_integer(numeric_buffer_at(c,13),0.0,6.0) {return false}
 if !dob_integer(numeric_buffer_at(c,14),0.0,used) || !dob_integer(numeric_buffer_at(c,15),0.0,used) {return false}
 if used>=2.0 {if numeric_buffer_at(c,5)==0.0 {return false}}
 return true
}
pub fn diagnostic_observer_init(c:&!NumericBuffer,capacity:i64,max_observations:i64,direction:i64)->i64 with Mut,Div,Panic {
 let need=diagnostic_observer_workspace(capacity)
 if need<0 || max_observations<0 || max_observations>9007199254740992 || direction< -1 || direction>1 {return 1}
 if numeric_buffer_status(c)!=0 || numeric_buffer_len(c)!=need {return 1}
 var i:i64=0
 while i<16 {numeric_buffer_set(c,i,0.0);i=i+1}
 numeric_buffer_set(c,0,314159.0)
 numeric_buffer_set(c,1,capacity as f64)
 numeric_buffer_set(c,2,max_observations as f64)
 numeric_buffer_set(c,4,direction as f64)
 i=0
 while i<capacity {numeric_buffer_set(c,16+5*capacity+i,0.0);i=i+1}
 return 0
}
fn dob_error(c:&!NumericBuffer,code:i64)->i64 with Mut {numeric_buffer_set(c,13,code as f64);code}
// Status0recorded;1shape/header,2nonfiniteinput,3timeorder,4capacity,6budget.
// After a verified-header failure only the sticky status cell changes.
// Row flags:1abs drift available,2relative available,4sample zero,8strict signchange.
pub fn diagnostic_observer_push(c:&!NumericBuffer,time:f64,quantity:f64,event:f64)->i64 with Mut,Div,Panic {
 if !dob_header(c) {return 1}
 let old_status=numeric_buffer_at(c,13) as i64
 if old_status!=0 {return old_status}
 if !is_finite(time) || !is_finite(quantity) || !is_finite(event) {return dob_error(c,2)}
 let cap=numeric_buffer_at(c,1) as i64
 let used=numeric_buffer_at(c,3) as i64
 if used>=cap {return dob_error(c,4)}
 if (used as f64)>=numeric_buffer_at(c,2) {return dob_error(c,6)}
 var time_direction=numeric_buffer_at(c,5)
 let old_time=numeric_buffer_at(c,7)
 if used>0 {
  if time==old_time {return dob_error(c,3)}
  let next_direction=if time>old_time {1.0}else{-1.0}
  if time_direction!=0.0 {if next_direction!=time_direction {return dob_error(c,3)}}
  time_direction=next_direction
 }
 let reference=if used==0 {quantity}else{numeric_buffer_at(c,6)}
 let difference=quantity-reference
 var absolute=0.0
 var relative=0.0
 var flags:i64=0
 if is_finite(difference) {absolute=dob_abs(difference);flags=1}
 if reference!=0.0 {
  if is_finite(difference) {
   let value=dob_abs(difference/reference)
   if is_finite(value) {relative=value;flags=flags+2}
  } else {
   let half=quantity*0.5-reference*0.5
   let ratio=dob_abs(half/reference)
   if is_finite(ratio) {
    if ratio!=0.0 {
     let value=ratio*2.0
     if is_finite(value) {relative=value;flags=flags+2}
    }
   }
  }
 }
 let previous=numeric_buffer_at(c,8)
 let direction=numeric_buffer_at(c,4) as i64
 var crossing:i64=0
 if event==0.0 {
  flags=flags+4
  if used==0 {crossing=1} else if previous!=0.0 {
   if direction==0 {crossing=1} else if direction>0 {if previous<0.0 {crossing=1}} else {if previous>0.0 {crossing=1}}
  }
 } else if used>0 {
  if previous<0.0 {
   if event>0.0 {if direction>=0 {crossing=2}}
  } else if previous>0.0 {
   if event<0.0 {if direction<=0 {crossing=2}}
  }
 }
 if crossing==2 {flags=flags+8}
 let events=numeric_buffer_at(c,9)
 if crossing!=0 {
  if events==0.0 {
   numeric_buffer_set(c,10,crossing as f64)
   numeric_buffer_set(c,11,if crossing==1 {time}else{old_time})
   numeric_buffer_set(c,12,time)
  }
  numeric_buffer_set(c,9,events+1.0)
 }
 numeric_buffer_set(c,16+used,time)
 numeric_buffer_set(c,16+cap+used,quantity)
 numeric_buffer_set(c,16+2*cap+used,event)
 numeric_buffer_set(c,16+3*cap+used,absolute)
 numeric_buffer_set(c,16+4*cap+used,relative)
 numeric_buffer_set(c,16+5*cap+used,flags as f64)
 if flags%2==1 {let value=numeric_buffer_at(c,14)+1.0;numeric_buffer_set(c,14,value)}
 if (flags/2)%2==1 {let value=numeric_buffer_at(c,15)+1.0;numeric_buffer_set(c,15,value)}
 numeric_buffer_set(c,3,(used+1) as f64)
 numeric_buffer_set(c,5,time_direction)
 numeric_buffer_set(c,6,reference)
 numeric_buffer_set(c,7,time)
 numeric_buffer_set(c,8,event)
 return 0
}
pub fn diagnostic_observer_status(c:&NumericBuffer)->i64 with Div,Panic {
 if !dob_header(c) {return 1}
 return numeric_buffer_at(c,13) as i64
}
// Into one reusable length6 slot: time,quantity,event,abs,relative,flags.
pub fn diagnostic_observer_get_into(c:&NumericBuffer,index:i64,out:&!NumericBuffer)->i64 with Mut,Div,Panic {
 if !dob_header(c) {return 1}
 if numeric_buffer_status(out)!=0 || numeric_buffer_len(out)!=6 {return 1}
 let used=numeric_buffer_at(c,3) as i64
 if index<0 || index>=used {return 1}
 let cap=numeric_buffer_at(c,1) as i64
 var j:i64=0
 while j<6 {let value=numeric_buffer_at(c,16+j*cap+index);numeric_buffer_set(out,j,value);j=j+1}
 return 0
}
pub struct DiagnosticObserverInfo {pub status:i64,pub used:i64,pub capacity:i64,pub events:i64,pub first_kind:i64,pub first_left:f64,pub first_right:f64,pub absolute_available:i64,pub relative_available:i64}
pub fn diagnostic_observer_info(c:&NumericBuffer)->DiagnosticObserverInfo with Div,Panic {
 if !dob_header(c) {return DiagnosticObserverInfo{status:1,used:0,capacity:0,events:0,first_kind:0,first_left:0.0,first_right:0.0,absolute_available:0,relative_available:0}}
 DiagnosticObserverInfo{status:numeric_buffer_at(c,13) as i64,used:numeric_buffer_at(c,3) as i64,capacity:numeric_buffer_at(c,1) as i64,events:numeric_buffer_at(c,9) as i64,first_kind:numeric_buffer_at(c,10) as i64,first_left:numeric_buffer_at(c,11),first_right:numeric_buffer_at(c,12),absolute_available:numeric_buffer_at(c,14) as i64,relative_available:numeric_buffer_at(c,15) as i64}
}
