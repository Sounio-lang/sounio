// solver.sio - Generic ODE Solver API for Sounio
//
// Provides a unified solve() interface for ordinary differential equations:
//   dy/dt = f(t, y),  y(t0) = y0
//
// Supports multiple methods:
// - RK4: Fixed-step 4th-order Runge-Kutta
// - RK45: Adaptive Dormand-Prince 5(4) method
// - Tsit5: Tsitouras 5(4) adaptive method
//
// Reference: Hairer, Norsett, Wanner - "Solving Ordinary Differential Equations I"

// ============================================================================
// HELPER FUNCTIONS
// ============================================================================

use math::pure::{exp,is_finite,ln_checked}

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn max_f64(a: f64, b: f64) -> f64 {
    if a > b { return a }
    return b
}

fn min_f64(a: f64, b: f64) -> f64 {
    if a < b { return a }
    return b
}

fn sqrt_f64(x: f64) -> f64 with Mut, Div {
    if x <= 0.0 { return 0.0 }
    var y = x
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    return y
}

// Fifth root for step size control (order p=5)
fn pow_1_5(x: f64) -> f64 with Mut, Div {
    if x <= 0.0 { return 0.0 }
    var y = 1.0
    y = y - (y * y * y * y * y - x) / (5.0 * y * y * y * y)
    y = y - (y * y * y * y * y - x) / (5.0 * y * y * y * y)
    y = y - (y * y * y * y * y - x) / (5.0 * y * y * y * y)
    y = y - (y * y * y * y * y - x) / (5.0 * y * y * y * y)
    y = y - (y * y * y * y * y - x) / (5.0 * y * y * y * y)
    y = y - (y * y * y * y * y - x) / (5.0 * y * y * y * y)
    y = y - (y * y * y * y * y - x) / (5.0 * y * y * y * y)
    y = y - (y * y * y * y * y - x) / (5.0 * y * y * y * y)
    return y
}

// ============================================================================
// SOLVER OPTIONS
// ============================================================================

// Configuration for ODE solvers
pub struct ODEOptions {
    /// Relative tolerance (default: 1e-4)
    pub rtol: f64,
    /// Absolute tolerance (default: 1e-7)
    pub atol: f64,
    /// Initial step size (0 = auto)
    pub dt_init: f64,
    /// Minimum step size
    pub dt_min: f64,
    /// Maximum step size
    pub dt_max: f64,
    /// Maximum number of steps
    pub max_steps: i64,
    /// Safety factor for step control (default: 0.9)
    pub safety: f64,
    /// Maximum step growth factor (default: 10.0)
    pub max_growth: f64,
    /// Minimum step shrink factor (default: 0.2)
    pub min_shrink: f64
}

// Default solver options - good for most problems
pub fn default_options() -> ODEOptions {
    return ODEOptions {
        rtol: 0.0001,
        atol: 0.0000001,
        dt_init: 0.0,
        dt_min: 0.000000000001,
        dt_max: 1000000.0,
        max_steps: 1000000,
        safety: 0.9,
        max_growth: 10.0,
        min_shrink: 0.2
    }
}

// High accuracy options for precision work
pub fn high_accuracy_options() -> ODEOptions {
    return ODEOptions {
        rtol: 0.0000000001,
        atol: 0.000000000001,
        dt_init: 0.0,
        dt_min: 0.000000000000001,
        dt_max: 1.0,
        max_steps: 10000000,
        safety: 0.9,
        max_growth: 5.0,
        min_shrink: 0.1
    }
}

// Fast options for quick solutions
pub fn fast_options() -> ODEOptions {
    return ODEOptions {
        rtol: 0.001,
        atol: 0.00001,
        dt_init: 0.1,
        dt_min: 0.0000001,
        dt_max: 10000.0,
        max_steps: 100000,
        safety: 0.9,
        max_growth: 10.0,
        min_shrink: 0.2
    }
}

// ============================================================================
// SOLUTION STRUCTURE
// ============================================================================

// Result from ODE solver
pub struct SolverODESolution {
    /// Whether integration succeeded
    pub success: bool,
    /// Number of steps taken
    pub nsteps: i64,
    /// Number of function evaluations
    pub nfeval: i64,
    /// Number of rejected steps
    pub nreject: i64,
    /// Final time reached
    pub t_final: f64,
    /// Final solution value
    pub u_final: f64,
    /// 0 complete,1 attempt budget,2 no progress,3 invalid request,4 arithmetic
    pub status: i64
}

// Solution for vector ODE (up to 3 components)
pub struct ODESolutionVec3 {
    pub success: bool,
    pub nsteps: i64,
    pub nfeval: i64,
    pub nreject: i64,
    pub t_final: f64,
    pub u1_final: f64,
    pub u2_final: f64,
    pub u3_final: f64,
    pub status: i64
}

// ============================================================================
// DORMAND-PRINCE 5(4) COEFFICIENTS (RK45)
// ============================================================================

// Butcher tableau for DOPRI5
fn dp_c2() -> f64 { 1.0/5.0 }
fn dp_c3() -> f64 { 3.0/10.0 }
fn dp_c4() -> f64 { 4.0/5.0 }
fn dp_c5() -> f64 { 8.0/9.0 }
fn dp_c6() -> f64 { 1.0 }
fn dp_c7() -> f64 { 1.0 }

fn dp_a21() -> f64 { 1.0/5.0 }
fn dp_a31() -> f64 { 3.0/40.0 }
fn dp_a32() -> f64 { 9.0/40.0 }
fn dp_a41() -> f64 { 44.0/45.0 }
fn dp_a42() -> f64 { 0.0 - 56.0/15.0 }
fn dp_a43() -> f64 { 32.0/9.0 }
fn dp_a51() -> f64 { 19372.0/6561.0 }
fn dp_a52() -> f64 { 0.0 - 25360.0/2187.0 }
fn dp_a53() -> f64 { 64448.0/6561.0 }
fn dp_a54() -> f64 { 0.0 - 212.0/729.0 }
fn dp_a61() -> f64 { 9017.0/3168.0 }
fn dp_a62() -> f64 { 0.0 - 355.0/33.0 }
fn dp_a63() -> f64 { 46732.0/5247.0 }
fn dp_a64() -> f64 { 49.0/176.0 }
fn dp_a65() -> f64 { 0.0 - 5103.0/18656.0 }
fn dp_a71() -> f64 { 35.0/384.0 }
fn dp_a73() -> f64 { 500.0/1113.0 }
fn dp_a74() -> f64 { 125.0/192.0 }
fn dp_a75() -> f64 { 0.0 - 2187.0/6784.0 }
fn dp_a76() -> f64 { 11.0/84.0 }

// 5th order weights
fn dp_b1() -> f64 { 35.0/384.0 }
fn dp_b3() -> f64 { 500.0/1113.0 }
fn dp_b4() -> f64 { 125.0/192.0 }
fn dp_b5() -> f64 { 0.0 - 2187.0/6784.0 }
fn dp_b6() -> f64 { 11.0/84.0 }

// Error estimation coefficients (b - bhat)
fn dp_e1() -> f64 { 71.0/57600.0 }
fn dp_e3() -> f64 { 0.0 - 71.0/16695.0 }
fn dp_e4() -> f64 { 71.0/1920.0 }
fn dp_e5() -> f64 { 0.0 - 17253.0/339200.0 }
fn dp_e6() -> f64 { 22.0/525.0 }
fn dp_e7() -> f64 { 0.0 - 1.0/40.0 }

// ============================================================================
// STEP RESULT TYPES
// ============================================================================

struct RK45StepResult {
    u_new: f64,
    err: f64
}

struct RK45StepResultVec3 {
    u1_new: f64,
    u2_new: f64,
    u3_new: f64,
    err: f64
}

// ============================================================================
// GENERIC SOLVE API FOR SCALAR ODE
// ============================================================================

// Solve scalar ODE using RK45 (Dormand-Prince 5(4)) with adaptive stepping
//
// Parameters:
// - f_eval: User provides ODE function value at (t, u)
// - u0: Initial condition
// - t_span_start: Start time
// - t_span_end: End time
// - opts: Solver options
//
// The user must provide the ODE system via a specific function pattern.
// For custom ODEs, create wrapper functions that match the interface.

// Example ODE: Exponential decay du/dt = -k*u
fn ode_exp_decay(u: f64, t: f64) -> f64 {
    let k = 0.1
    return 0.0 - k * u
}

// Single RK45 step for exponential decay
fn rk45_step_exp_decay(u: f64, t: f64, dt: f64) -> RK45StepResult {
    // Stage 1
    let k1 = ode_exp_decay(u, t)

    // Stage 2
    let u2 = u + dt * dp_a21() * k1
    let k2 = ode_exp_decay(u2, t + dp_c2() * dt)

    // Stage 3
    let u3 = u + dt * (dp_a31() * k1 + dp_a32() * k2)
    let k3 = ode_exp_decay(u3, t + dp_c3() * dt)

    // Stage 4
    let u4 = u + dt * (dp_a41() * k1 + dp_a42() * k2 + dp_a43() * k3)
    let k4 = ode_exp_decay(u4, t + dp_c4() * dt)

    // Stage 5
    let u5 = u + dt * (dp_a51() * k1 + dp_a52() * k2 + dp_a53() * k3 + dp_a54() * k4)
    let k5 = ode_exp_decay(u5, t + dp_c5() * dt)

    // Stage 6
    let u6 = u + dt * (dp_a61() * k1 + dp_a62() * k2 + dp_a63() * k3 + dp_a64() * k4 + dp_a65() * k5)
    let k6 = ode_exp_decay(u6, t + dp_c6() * dt)

    // 5th order solution
    let u_new = u + dt * (dp_b1() * k1 + dp_b3() * k3 + dp_b4() * k4 + dp_b5() * k5 + dp_b6() * k6)

    // Stage 7 for error estimate (FSAL property)
    let k7 = ode_exp_decay(u_new, t + dt)

    // Error estimate
    let err_raw = dt * (dp_e1() * k1 + dp_e3() * k3 + dp_e4() * k4 + dp_e5() * k5 + dp_e6() * k6 + dp_e7() * k7)

    return RK45StepResult { u_new: u_new, err: abs_f64(err_raw) }
}

// Compute optimal step size based on error
fn compute_optimal_step(dt:f64,err_norm:f64,opts:ODEOptions)->f64 with Mut,Div {
 var factor=opts.max_growth
 if err_norm>0.0 {
  let logged=ln_checked(err_norm)
  if logged.status!=0 {return 0.0}
  factor=opts.safety*exp(-0.2*logged.value)
 }
 factor=max_f64(opts.min_shrink,min_f64(opts.max_growth,factor))
 dt*factor
}

// Solve exponential decay ODE using RK45

fn solver_scalar_result(status:i64,t:f64,u:f64,steps:i64,evals:i64,rejects:i64)->SolverODESolution {
 SolverODESolution{success:status==0,nsteps:steps,nfeval:evals,nreject:rejects,t_final:t,u_final:u,status:status}
}
fn solver_invalid()->SolverODESolution {solver_scalar_result(3,0.0,0.0,0,0,0)}
fn solver_fixed_valid(u:f64,t0:f64,t1:f64,steps:i64)->bool {
 steps>0 && steps<=1000000 && is_finite(u) && is_finite(t0) && is_finite(t1)
}

pub fn solve_rk45_exp_decay(u0:f64,t_start:f64,t_end:f64,opts:ODEOptions)->SolverODESolution with Mut,Div {
 if !is_finite(u0) || !is_finite(t_start) || !is_finite(t_end) || t_end<t_start ||
 !is_finite(opts.rtol) || !is_finite(opts.atol) || opts.rtol<0.0 || opts.atol<=0.0 ||
 !is_finite(opts.dt_init) || opts.dt_init<0.0 || !is_finite(opts.dt_min) || opts.dt_min<=0.0 ||
 !is_finite(opts.dt_max) || opts.dt_max<opts.dt_min ||
 !is_finite(opts.safety) || opts.safety<=0.0 || opts.safety>=1.0 ||
 !is_finite(opts.max_growth) || opts.max_growth<1.0 ||
 !is_finite(opts.min_shrink) || opts.min_shrink<=0.0 || opts.min_shrink>=1.0 ||
 opts.max_steps<1 || opts.max_steps>1000000 {return solver_invalid()}
 if t_start==t_end {return solver_scalar_result(0,t_start,u0,0,0,0)}
 let span=t_end-t_start
 if !is_finite(span) {return solver_scalar_result(4,t_start,u0,0,0,0)}
 var dt=opts.dt_init
 if dt==0.0 {dt=span*0.01}
 dt=max_f64(opts.dt_min,min_f64(opts.dt_max,dt))
 var t=t_start
 var u=u0
 var steps:i64=0
 var rejects:i64=0
 var attempts:i64=0
 while t<t_end && attempts<opts.max_steps {
  let remaining=t_end-t
  let h=min_f64(dt,remaining)
  let next=if h==remaining {t_end} else {t+h}
  if !is_finite(next) || !is_finite(h) {return solver_scalar_result(4,t,u,steps,attempts*7,rejects)}
  if next<=t || h<=0.0 {return solver_scalar_result(2,t,u,steps,attempts*7,rejects)}
  let result=rk45_step_exp_decay(u,t,h)
  attempts=attempts+1
  let scale=opts.atol+opts.rtol*max_f64(abs_f64(u),abs_f64(result.u_new))
  if !is_finite(result.u_new) || !is_finite(result.err) || !is_finite(scale) || scale<=0.0 {
   return solver_scalar_result(4,t,u,steps,attempts*7,rejects)
  }
  let err=result.err/scale
  if !is_finite(err) {return solver_scalar_result(4,t,u,steps,attempts*7,rejects)}
  if err<=1.0 {
   t=next;u=result.u_new;steps=steps+1
   let proposal=compute_optimal_step(h,err,opts)
   dt=if is_finite(proposal) {max_f64(opts.dt_min,min_f64(opts.dt_max,proposal))} else {opts.dt_max}
  } else {
   rejects=rejects+1
   let reduced=compute_optimal_step(h,err,opts)
   if h<=opts.dt_min || reduced>=h || reduced<=0.0 {return solver_scalar_result(2,t,u,steps,attempts*7,rejects)}
   dt=max_f64(opts.dt_min,reduced)
  }
 }
 if t<t_end {return solver_scalar_result(1,t,u,steps,attempts*7,rejects)}
 solver_scalar_result(0,t,u,steps,attempts*7,rejects)
}

// ============================================================================
// FIXED-STEP RK4 SOLVER
// ============================================================================

// Single RK4 step for exponential decay
fn rk4_step_exp_decay(u: f64, t: f64, dt: f64) -> f64 {
    let k1 = ode_exp_decay(u, t)
    let k2 = ode_exp_decay(u + 0.5 * dt * k1, t + 0.5 * dt)
    let k3 = ode_exp_decay(u + 0.5 * dt * k2, t + 0.5 * dt)
    let k4 = ode_exp_decay(u + dt * k3, t + dt)
    return u + (dt / 6.0) * (k1 + 2.0 * k2 + 2.0 * k3 + k4)
}

// Solve exponential decay using fixed-step RK4
pub fn solve_rk4_exp_decay(u0:f64,t_start:f64,t_end:f64,n_steps:i64)->SolverODESolution with Mut,Div {
 if !solver_fixed_valid(u0,t_start,t_end,n_steps) {return solver_invalid()}
 if t_start==t_end {return solver_scalar_result(0,t_start,u0,0,0,0)}
 let span=t_end-t_start
 if !is_finite(span) {return solver_scalar_result(4,t_start,u0,0,0,0)}
 var u=u0
 var t=t_start
 var i:i64=0
 while i<n_steps {
  let next=if i+1==n_steps {t_end} else {t_start+span*(((i+1) as f64)/(n_steps as f64))}
  let dt=next-t
  if !is_finite(next) || !is_finite(dt) {return solver_scalar_result(4,t,u,i,i*4,0)}
  if (span>0.0 && next<=t) || (span<0.0 && next>=t) {return solver_scalar_result(2,t,u,i,i*4,0)}
  let candidate=rk4_step_exp_decay(u,t,dt)
  if !is_finite(candidate) {return solver_scalar_result(4,t,u,i,(i+1)*4,0)}
  u=candidate;t=next;i=i+1
 }
 solver_scalar_result(0,t,u,i,i*4,0)
}

// ============================================================================
// 3-COMPONENT VECTOR ODE SOLVER (for systems like 3-compartment PK)
// ============================================================================

// State for 3-component ODE system
pub struct State3 {
    pub u1: f64,
    pub u2: f64,
    pub u3: f64,
    pub t: f64
}

// Derivative for 3-component system
struct Deriv3 {
    du1: f64,
    du2: f64,
    du3: f64
}

// Parameters for 3-compartment PK model
pub struct SolverPKParams3 {
    pub ka: f64,   // Absorption rate (gut -> central)
    pub ke: f64,   // Elimination rate (central -> eliminated)
    pub k12: f64,  // Transfer rate (central -> peripheral)
    pub k21: f64   // Transfer rate (peripheral -> central)
}

fn solver_default_pk3_params() -> SolverPKParams3 {
    return SolverPKParams3 {
        ka: 1.5,
        ke: 0.1,
        k12: 0.3,
        k21: 0.15
    }
}

// 3-compartment PK ODE system
fn ode_pk3(s: State3, p: SolverPKParams3) -> Deriv3 {
    return Deriv3 {
        du1: 0.0 - p.ka * s.u1,  // Gut: absorption only
        du2: p.ka * s.u1 - p.ke * s.u2 - p.k12 * s.u2 + p.k21 * s.u3,  // Central
        du3: p.k12 * s.u2 - p.k21 * s.u3  // Peripheral
    }
}

// RK4 step for 3-component PK system
fn solver_rk4_step_pk3(s: State3, dt: f64, p: SolverPKParams3) -> State3 {
    // Stage 1
    let k1 = ode_pk3(s, p)

    // Stage 2
    let s2 = State3 {
        u1: s.u1 + 0.5 * dt * k1.du1,
        u2: s.u2 + 0.5 * dt * k1.du2,
        u3: s.u3 + 0.5 * dt * k1.du3,
        t: s.t + 0.5 * dt
    }
    let k2 = ode_pk3(s2, p)

    // Stage 3
    let s3 = State3 {
        u1: s.u1 + 0.5 * dt * k2.du1,
        u2: s.u2 + 0.5 * dt * k2.du2,
        u3: s.u3 + 0.5 * dt * k2.du3,
        t: s.t + 0.5 * dt
    }
    let k3 = ode_pk3(s3, p)

    // Stage 4
    let s4 = State3 {
        u1: s.u1 + dt * k3.du1,
        u2: s.u2 + dt * k3.du2,
        u3: s.u3 + dt * k3.du3,
        t: s.t + dt
    }
    let k4 = ode_pk3(s4, p)

    // Combine
    return State3 {
        u1: s.u1 + (dt / 6.0) * (k1.du1 + 2.0*k2.du1 + 2.0*k3.du1 + k4.du1),
        u2: s.u2 + (dt / 6.0) * (k1.du2 + 2.0*k2.du2 + 2.0*k3.du2 + k4.du2),
        u3: s.u3 + (dt / 6.0) * (k1.du3 + 2.0*k2.du3 + 2.0*k3.du3 + k4.du3),
        t: s.t + dt
    }
}

// Solve 3-compartment PK model with RK4
pub fn solve_pk3_rk4(s0:State3,p:SolverPKParams3,t_end:f64,n_steps:i64)->ODESolutionVec3 with Mut,Div {
 var out=ODESolutionVec3{success:false,nsteps:0,nfeval:0,nreject:0,t_final:0.0,u1_final:0.0,u2_final:0.0,u3_final:0.0,status:3}
 if !solver_fixed_valid(s0.u1,s0.t,t_end,n_steps) || !is_finite(s0.u2) || !is_finite(s0.u3) ||
 !is_finite(p.ka) || !is_finite(p.ke) || !is_finite(p.k12) || !is_finite(p.k21) ||
 p.ka<0.0 || p.ke<0.0 || p.k12<0.0 || p.k21<0.0 {return out}
 out.t_final=s0.t;out.u1_final=s0.u1;out.u2_final=s0.u2;out.u3_final=s0.u3
 let span=t_end-s0.t
 if !is_finite(span) {out.status=4;return out}
 var s=s0
 var i:i64=0
 while i<n_steps && s.t!=t_end {
  let next=if i+1==n_steps {t_end} else {s0.t+span*(((i+1) as f64)/(n_steps as f64))}
  let dt=next-s.t
  if !is_finite(next) || !is_finite(dt) {out.status=4;return out}
  if (span>0.0 && next<=s.t) || (span<0.0 && next>=s.t) {out.status=2;return out}
  let candidate=solver_rk4_step_pk3(s,dt,p)
  out.nfeval=(i+1)*4
  if !is_finite(candidate.u1) || !is_finite(candidate.u2) || !is_finite(candidate.u3) {out.status=4;return out}
  s=candidate;s.t=next;i=i+1
  out.nsteps=i;out.t_final=s.t;out.u1_final=s.u1;out.u2_final=s.u2;out.u3_final=s.u3
 }
 out.success=true;out.status=0
 out
}

// ============================================================================
// STIFF SOLVER: BACKWARD EULER (BDF1)
// ============================================================================

// Backward Euler step for exponential decay (analytically solved)
// For du/dt = -k*u, implicit: u_{n+1} = u_n / (1 + k*dt)
fn backward_euler_step_exp_decay(u: f64, dt: f64, k: f64) -> f64 {
    return u / (1.0 + k * dt)
}

// Solve exponential decay using Backward Euler (L-stable for stiff)
pub fn solve_bdf1_exp_decay(u0:f64,t_start:f64,t_end:f64,n_steps:i64)->SolverODESolution with Mut,Div {
 if !solver_fixed_valid(u0,t_start,t_end,n_steps) {return solver_invalid()}
 if t_start==t_end {return solver_scalar_result(0,t_start,u0,0,0,0)}
 let span=t_end-t_start
 if !is_finite(span) {return solver_scalar_result(4,t_start,u0,0,0,0)}
 var u=u0
 var t=t_start
 var i:i64=0
 while i<n_steps {
  let next=if i+1==n_steps {t_end} else {t_start+span*(((i+1) as f64)/(n_steps as f64))}
  let dt=next-t
  if !is_finite(next) || !is_finite(dt) {return solver_scalar_result(4,t,u,i,i*1,0)}
  if (span>0.0 && next<=t) || (span<0.0 && next>=t) {return solver_scalar_result(2,t,u,i,i*1,0)}
  let candidate=backward_euler_step_exp_decay(u,dt,0.1)
  if !is_finite(candidate) {return solver_scalar_result(4,t,u,i,(i+1)*1,0)}
  u=candidate;t=next;i=i+1
 }
 solver_scalar_result(0,t,u,i,i*1,0)
}

// ============================================================================
// ANALYTICAL SOLUTIONS FOR VALIDATION
// ============================================================================

fn solver_exp_approx(x: f64) -> f64 with Mut, Div {
    // #846: delegate to the shared, full-range math::pure::exp.
    exp(x)
}

pub fn solver_exp_decay_analytical(u0: f64, k: f64, t: f64) -> f64 with Mut, Div {
    return u0 * solver_exp_approx(0.0 - k * t)
}

pub fn exp_decay_analytical(u0: f64, k: f64, t: f64) -> f64 with Mut, Div {
    return solver_exp_decay_analytical(u0, k, t)
}

