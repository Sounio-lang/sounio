// ode — Ordinary differential equation solvers
//
// Fixed-step and adaptive Runge-Kutta methods, BDF implicit stiff solvers,
// epistemic ODE integration with uncertainty propagation, and PBPK models.
//
// Submodules:
//   solver            — Unified solve() API (RK4, RK45, Tsit5)
//   solvers           — Euler, Midpoint, RK4, RK45 Dormand-Prince (adaptive)
//   rk4               — Classic 4th-order Runge-Kutta (fixed step)
//   tsit5             — Tsitouras 5(4) adaptive embedded method
//   tsit5_multicomp   — Tsit5 for multi-compartment (3-compartment PK) systems
//   bdf               — Backward Differentiation Formula (orders 1-4) for stiff systems
//   epistemic         — Epistemic RK4 with GUM uncertainty propagation
//   epistemic_pk_fit  — 1-compartment PK parameter inference via Gauss-Newton
//   epistemic_pkpd_fit — Sequential PK/PD link model inference with full GUM chain
//   pbpk14            — 14-compartment whole-body PBPK model (Euler)
//   pbpk3_stable      — 3-compartment PBPK model (RK4, numerically stable)

pub use epistemic_pk_fit::{
    PKFitResult,
    epistemic_pk_gauss_newton,
}

pub use epistemic_pkpd_fit::{
    PKPDFitResult,
    epistemic_pkpd_fit,
}
