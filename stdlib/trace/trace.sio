// trace/mod.sio — Lightweight Execution Tracing
//
// Structured span-based tracing for profiling and diagnostics.
// Fixed-capacity tracer (128 spans) with nanosecond timestamps.
//
// Inspired by: Tokio tracing, OpenTelemetry spans

// ============================================================================
// TRACER — parallel flat arrays (avoids runtime-indexed struct-array write bug)
// ============================================================================

pub struct Tracer {
    span_id:     [i64; 128],
    span_parent: [i64; 128],
    span_start:  [i64; 128],
    span_end:    [i64; 128],
    span_tag:    [i64; 128],
    count:       i32,
}

pub fn tracer_new() -> Tracer {
    Tracer {
        span_id:     [0; 128],
        span_parent: [0; 128],
        span_start:  [0; 128],
        span_end:    [0; 128],
        span_tag:    [0; 128],
        count:       0,
    }
}

// Begin a new span. Mutates tracer in place; returns new span ID (-1 if full).
pub fn tracer_begin(t: &!Tracer, parent: i64, tag: i64, now: i64) -> i64 with Mut {
    if t.count >= 128 { return 0 - 1 }
    let idx = t.count as usize
    let new_id = (t.count as i64) + 1
    t.span_id[idx]     = new_id
    t.span_parent[idx] = parent
    t.span_start[idx]  = now
    t.span_end[idx]    = 0
    t.span_tag[idx]    = tag
    t.count = t.count + 1
    new_id
}

// End a span by setting its end timestamp. Mutates tracer in place.
pub fn tracer_end(t: &!Tracer, id: i64, now: i64) with Mut {
    var i: i32 = 0
    while i < t.count {
        if t.span_id[i as usize] == id {
            t.span_end[i as usize] = now
        }
        i = i + 1
    }
}

// Get duration of a span in nanoseconds (0 if not ended or not found)
pub fn tracer_span_duration(t: &Tracer, id: i64) -> i64 {
    var i: i32 = 0
    while i < t.count {
        if t.span_id[i as usize] == id {
            let s = t.span_start[i as usize]
            let e = t.span_end[i as usize]
            if e > s { return e - s }
            return 0
        }
        i = i + 1
    }
    0
}

// ============================================================================
// INLINE TESTS
// ============================================================================

//@ run-pass
fn test_tracer_new() -> i32 {
    let t = tracer_new()
    if t.count != 0 { return 1 }
    0
}

//@ run-pass
fn test_tracer_begin_end() -> i32 with Mut {
    var t = tracer_new()
    let id = tracer_begin(&!t, 0, 42, 1000)
    if id != 1 { return 1 }
    if t.count != 1 { return 2 }
    tracer_end(&!t, id, 2000)
    let dur = tracer_span_duration(&t, id)
    if dur != 1000 { return 3 }
    0
}

//@ run-pass
fn test_tracer_multiple_spans() -> i32 with Mut {
    var t = tracer_new()
    let id1 = tracer_begin(&!t, 0, 1, 100)
    let id2 = tracer_begin(&!t, id1, 2, 200)
    if id2 != 2 { return 1 }
    tracer_end(&!t, id2, 300)
    tracer_end(&!t, id1, 400)
    let dur1 = tracer_span_duration(&t, 1)
    let dur2 = tracer_span_duration(&t, 2)
    if dur1 != 300 { return 2 }
    if dur2 != 100 { return 3 }
    0
}
