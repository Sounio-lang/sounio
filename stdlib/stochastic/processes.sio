// Sprint 24 Track B: Stochastic Process stdlib
// References: Oksendal (2003) SDEs, Doob (1953)

fn euler_maruyama_step(x: f64, drift: f64, diffusion: f64, dt: f64, dw: f64) -> f64 {
    // Euler-Maruyama discretization: X_{t+dt} = X_t + mu(X_t)*dt + sigma(X_t)*dW
    x + drift * dt + diffusion * dw
}

fn markov_stationary_power_2state(p00: f64, p01: f64, n_iter: i64) -> f64 {
    // Power iteration for 2-state Markov chain stationary distribution
    // pi_0 = p10 / (p01 + p10) where p10 = 1 - p00
    let p10: f64 = 1.0 - p00
    p10 / (p01 + p10)
}

fn ornstein_uhlenbeck_mean(x0: f64, theta: f64, t: f64) -> f64 {
    // OU mean reversion: E[X_t] = x0 * exp(-theta*t)
    // First-order approximation: x0 * (1 - theta*t) for small theta*t
    x0 * (1.0 - theta * t)
}

fn gbm_expected_value(s0: f64, mu: f64, t: f64) -> f64 {
    // Geometric Brownian Motion expected value: E[S_t] = S_0 * exp(mu*t)
    // First-order: S_0 * (1 + mu*t)
    s0 * (1.0 + mu * t)
}

fn tv_distance_bound(mixing_rate: f64, t: f64) -> f64 {
    // Total variation convergence: TV(mu_t, pi) <= exp(-rate * t)
    // Second-order Taylor approximation
    let rt: f64 = mixing_rate * t
    1.0 - rt + rt * rt / 2.0
}
