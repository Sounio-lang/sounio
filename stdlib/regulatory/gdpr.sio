// stdlib/regulatory/gdpr.sio
//
// GDPR Article 17 ("Right to erasure / Right to be forgotten")
// compliance surface, realized as library-level desugars on top of
// Sounio's surgical-intervention types.
//
// Legal text (GDPR Art. 17, paraphrase):
//   "The data subject shall have the right to obtain from the
//    controller the erasure of personal data concerning him or her
//    without undue delay, and the controller shall have the
//    obligation to erase personal data without undue delay."
//
// Operational translation used by this module:
//   A GDPR-compliant erasure is a surgical operation of type
//   ExactlyPrivate<T> with ZD, coupled with an audit trail of type
//   Audited<T> with ZD, Witness.  Both effects together enforce:
//     1. Exact removal   (algebraic zeroing, not epsilon-close)
//     2. Machine-checkable derivation of the removal
//
// Required effects to call any function in this module:
//   with ZD, Witness
//
// Jurisprudence:
//   - Art. 17(1) — the right itself
//   - Art. 17(3) — exceptions (freedom of expression, public interest)
//     NOT handled here; downstream gating is out of scope
//   - Recital 65 — context of the right, especially the "without undue
//     delay" obligation that makes post-hoc retraining impractical.

// gdpr_erase_residual: the operational compliance metric for
// GDPR Art. 17. Given a weight vector w and a reference w_never_trained
// (what the model would look like had the data subject never contributed),
// the compliance holds iff the L2 residual is fp-exact zero.
fn gdpr_erase_residual(w_forgotten: &[f64; 16],
                       w_reference: &[f64; 16]) -> f64 with Mut, ZD, Witness {
    var s = 0.0
    var i = 0
    while i < 16 {
        let d = (*w_forgotten)[i] - (*w_reference)[i]
        s = s + d * d
        i = i + 1
    }
    s
}

// gdpr_art17_compliant: a boolean predicate over the residual.
// Returns true iff residual < 1e-10, the fp-exact threshold matching
// the Lean `native_decide` discharge condition on unlearning_kernel_exact.
fn gdpr_art17_compliant(residual: f64) -> bool with Mut, ZD, Witness {
    residual < 0.0000000001 && residual > 0.0 - 0.0000000001
}

// gdpr_art17_witness_header: emit the regulatory-citation header that
// the Sounio audit harness embeds into the Lean witness for a GDPR
// Art.17 operation.  This is what downstream auditors grep for.
fn gdpr_art17_witness_header() with IO, Mut, ZD, Witness {
    print("[audit] regulation=GDPR-Art17 surgical_op=unlearn\n")
    print("[audit] witness=unlearning_kernel_exact\n")
    print("[audit] compliance_threshold=1e-10\n")
}
