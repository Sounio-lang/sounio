// Parallel nominal ontology fixture for D8. It does not transport runtime
// kernel receipts. Siblings encode non-subsumption, not OWL disjointness.

ontology PathConditionedPartialIdentification {
    class EpistemicArtifact

    class ObservationArtifact subclass_of EpistemicArtifact
    class ScalarProjectionObservation subclass_of ObservationArtifact
    class ObservedFalse subclass_of ObservationArtifact
    class NotMeasured subclass_of ObservationArtifact
    class MissingUnderPolicy subclass_of ObservationArtifact

    class StateArtifact subclass_of EpistemicArtifact
    class LatentState subclass_of StateArtifact

    class IdentifiedSetArtifact subclass_of EpistemicArtifact
    class ExactIdentifiedSet subclass_of IdentifiedSetArtifact
    class SoundOuterIdentifiedSet subclass_of IdentifiedSetArtifact
    class WitnessedInnerIdentifiedSet subclass_of IdentifiedSetArtifact
    class HeuristicIdentifiedSet subclass_of IdentifiedSetArtifact

    class StatisticalSetArtifact subclass_of EpistemicArtifact
    class ConfidenceRegion subclass_of StatisticalSetArtifact
    class PredictiveSet subclass_of StatisticalSetArtifact

    class UncertaintyRepresentationArtifact subclass_of EpistemicArtifact
    class ValueInterval subclass_of UncertaintyRepresentationArtifact
    class PBox subclass_of UncertaintyRepresentationArtifact
    class CredalSet subclass_of UncertaintyRepresentationArtifact
    class Posterior subclass_of UncertaintyRepresentationArtifact

    class OrderedHistoryArtifact subclass_of EpistemicArtifact
    class OrderedHistoryAB subclass_of OrderedHistoryArtifact
    class OrderedHistoryBA subclass_of OrderedHistoryArtifact

    class SetInferenceArtifact subclass_of EpistemicArtifact
    class SubsetReceipt subclass_of SetInferenceArtifact
    class OuterOnlyOverlapUndecided subclass_of SetInferenceArtifact
    class RealIdentifiedSetOverlap subclass_of SetInferenceArtifact
    class ExactSeparation subclass_of SetInferenceArtifact
    class ModelEvidenceConflict subclass_of SetInferenceArtifact

    class CausalStatusArtifact subclass_of EpistemicArtifact
    class AssociationReceipt subclass_of CausalStatusArtifact
    class InterventionReceipt subclass_of CausalStatusArtifact
    class CounterfactualReceipt subclass_of CausalStatusArtifact

    class ClinicalAuthorityArtifact subclass_of EpistemicArtifact
    class ClinicalAction subclass_of ClinicalAuthorityArtifact

    class ContextArtifact subclass_of EpistemicArtifact
    class IndividualContext subclass_of ContextArtifact
    class DyadicContext subclass_of ContextArtifact

    class InterpretationArtifact subclass_of EpistemicArtifact
    class SufferingProxy subclass_of InterpretationArtifact
    class HumanSuffering subclass_of InterpretationArtifact

    role conditions domain OrderedHistoryArtifact range IdentifiedSetArtifact
    role observes domain ObservationArtifact range IdentifiedSetArtifact
    role refines domain SubsetReceipt range ExactIdentifiedSet
    role abstains_on domain OuterOnlyOverlapUndecided range SoundOuterIdentifiedSet
    role reports_conflict domain ModelEvidenceConflict range ExactIdentifiedSet
    role supports domain AssociationReceipt range IdentifiedSetArtifact
}

fn accept_observation(v: ObservationArtifact) -> i32 { 0 }
fn accept_state(v: StateArtifact) -> i32 { 0 }
fn accept_identified_set(v: IdentifiedSetArtifact) -> i32 { 0 }
fn accept_statistical_set(v: StatisticalSetArtifact) -> i32 { 0 }
fn accept_uncertainty(v: UncertaintyRepresentationArtifact) -> i32 { 0 }
fn accept_history(v: OrderedHistoryArtifact) -> i32 { 0 }
fn accept_set_inference(v: SetInferenceArtifact) -> i32 { 0 }
fn accept_causal_status(v: CausalStatusArtifact) -> i32 { 0 }
fn accept_clinical_authority(v: ClinicalAuthorityArtifact) -> i32 { 0 }
fn accept_context(v: ContextArtifact) -> i32 { 0 }
fn accept_interpretation(v: InterpretationArtifact) -> i32 { 0 }

fn exact_is_identified(v: ExactIdentifiedSet) -> i32 { accept_identified_set(v) }
fn confidence_is_statistical(v: ConfidenceRegion) -> i32 { accept_statistical_set(v) }
fn pbox_is_uncertainty(v: PBox) -> i32 { accept_uncertainty(v) }
fn ab_is_history(v: OrderedHistoryAB) -> i32 { accept_history(v) }
fn conflict_is_inference(v: ModelEvidenceConflict) -> i32 { accept_set_inference(v) }
fn association_is_causal_status(v: AssociationReceipt) -> i32 {
    accept_causal_status(v)
}
fn individual_is_context(v: IndividualContext) -> i32 { accept_context(v) }
fn proxy_is_interpretation(v: SufferingProxy) -> i32 { accept_interpretation(v) }
