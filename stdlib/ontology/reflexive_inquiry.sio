// Experimental ontology for proof-carrying reflexive inquiry.
// Sibling classes encode non-subsumption, not OWL disjointness.

ontology ReflexiveInquiry {
    class EpistemicArtifact

    class InquiryAction subclass_of EpistemicArtifact
    class PassiveObservationAction subclass_of InquiryAction
    class ReactiveInquiryAction subclass_of InquiryAction
    class SyntheticInquiryAction subclass_of InquiryAction
    class PhysicalIntervention subclass_of InquiryAction

    class LayeredState subclass_of EpistemicArtifact
    class RelationalProcessState subclass_of LayeredState
    class InstrumentState subclass_of LayeredState
    class ObserverKnowledgeState subclass_of LayeredState

    class EffectArtifact subclass_of EpistemicArtifact
    class InquiryEffectFootprint subclass_of EffectArtifact
    class PotentialInterference subclass_of EffectArtifact
    class ExactCommutationReceipt subclass_of EffectArtifact
    class StateOnlyCommutationReceipt subclass_of EffectArtifact
    class ExactNonCommutationReceipt subclass_of EffectArtifact
    class FullInquiryReorderAuthorization subclass_of EffectArtifact
    class NonAssociativityReceipt subclass_of EffectArtifact

    class EvidenceArtifact subclass_of EpistemicArtifact
    class OrderTraceObservation subclass_of EvidenceArtifact
    class AdmissibleOrderTraceObservation subclass_of OrderTraceObservation
    class MissingOrderTraceObservation subclass_of OrderTraceObservation
    class UnauditedOrderTraceObservation subclass_of OrderTraceObservation
    class LayerAuditObservation subclass_of EvidenceArtifact
    class EvidenceProvenanceReceipt subclass_of EvidenceArtifact

    class InferenceReceipt subclass_of EpistemicArtifact
    class ReactiveLocusAmbiguity subclass_of InferenceReceipt
    class DeclaredLocusIdentification subclass_of InferenceReceipt
    class GlobalTruthReceipt subclass_of InferenceReceipt
    class BiologicalMechanismReceipt subclass_of InferenceReceipt
    class RealPersonCounterfactualReceipt subclass_of InferenceReceipt
    class ClinicalAuthorityReceipt subclass_of InferenceReceipt

    role reads_state domain InquiryEffectFootprint range LayeredState
    role writes_state domain InquiryEffectFootprint range LayeredState
    role has_footprint domain InquiryAction range InquiryEffectFootprint
    role has_provenance domain AdmissibleOrderTraceObservation range EvidenceProvenanceReceipt
    role supports_inference domain EvidenceArtifact range InferenceReceipt
    role authorizes_reorder domain ExactCommutationReceipt range FullInquiryReorderAuthorization
    role precedes transitive
    role epistemically_related_to symmetric
}

fn accept_action(a: InquiryAction) -> i32 { 0 }
fn accept_effect(e: EffectArtifact) -> i32 { 0 }
fn accept_evidence(e: EvidenceArtifact) -> i32 { 0 }
fn accept_inference(r: InferenceReceipt) -> i32 { 0 }

fn passive_is_action(a: PassiveObservationAction) -> i32 { accept_action(a) }
fn reactive_is_action(a: ReactiveInquiryAction) -> i32 { accept_action(a) }
fn noncommutation_is_effect(e: ExactNonCommutationReceipt) -> i32 { accept_effect(e) }
fn ambiguity_is_inference(r: ReactiveLocusAmbiguity) -> i32 { accept_inference(r) }
