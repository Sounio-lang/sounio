// Typed bridge: runtime ontology model (IRI) <-> generated GO semantic types.
//
// The runtime model in `ontology::model` carries classes as bare `IRI` values
// (an i64 id). The generated stub `ontology::generated::go` declares the same
// GO classes as compile-time nominal types inside an `ontology { ... }` block,
// where the Sounio compiler enforces subclass subsumption at call sites.
//
// This module is the seam between the two: it lets a runtime IRI be re-presented
// as its compile-time GO type so that ontology subsumption is checked statically.
//
//   * `go_<class>()           -> IRI`        : a runtime IRI tagged with the
//                                              class's canonical numeric id.
//   * `iri_as_go_<class>(&IRI) -> GO_<class>`: coerce a runtime IRI to the
//                                              nominal type for static checking.
//
// CONSTRAINT — one bundle per compile unit. The compiler resets its class /
// subclass matrices per `ontology { }` block, so the LAST block in a compile
// unit wins and earlier blocks' subsumption is lost (verified: importing both
// `generated::go` and `generated::chebi` makes the non-last bundle's casts fail
// with E001). A program may therefore bridge exactly ONE generated bundle at a
// time. Lifting this needs a compiler change (accumulate, don't reset, per block).
//
// SCALING — this file is the hand-written reference for GO. The same shape applies
// to every bundle in `generated/`; the long-term home for the other bundles'
// bridges is the stub generator (scripts/ontology/generate_dontology_stubs.sh),
// emitted alongside each stub, not hand-maintained here.

use ontology::model::{IRI, iri_new, OWLClass}
use ontology::generated::go::*

// ── Typed IRI constructors ──────────────────────────────────────────────────
// Build a runtime IRI carrying the class's canonical GO id.

pub fn go_biological_process() -> IRI { iri_new(GO_0008150_ID) }   // GO_0008150
pub fn go_cellular_process() -> IRI { iri_new(GO_0009987_ID) }     // GO_0009987
pub fn go_signaling() -> IRI { iri_new(GO_0007165_ID) }            // GO_0007165
pub fn go_cell_communication() -> IRI { iri_new(GO_0007154_ID) }   // GO_0007154
pub fn go_signal_transduction() -> IRI { iri_new(GO_0007166_ID) }  // GO_0007166
pub fn go_molecular_function() -> IRI { iri_new(GO_0003674_ID) }   // GO_0003674
pub fn go_catalytic_activity() -> IRI { iri_new(GO_0003824_ID) }   // GO_0003824

// ── IRI -> nominal coercions ────────────────────────────────────────────────
// Re-present a runtime IRI as its compile-time GO type. The `as` carries no
// runtime check (the id is taken on faith); its purpose is to hand the value to
// the compiler's ontology subsumption checker. Callers that need a runtime guard
// should compare `iri.id` against the corresponding `GO_*_ID` first.

pub fn iri_as_go_biological_process(iri: &IRI) -> GO_0008150 { iri.id as GO_0008150 }
pub fn iri_as_go_cellular_process(iri: &IRI) -> GO_0009987 { iri.id as GO_0009987 }
pub fn iri_as_go_signaling(iri: &IRI) -> GO_0007165 { iri.id as GO_0007165 }
pub fn iri_as_go_cell_communication(iri: &IRI) -> GO_0007154 { iri.id as GO_0007154 }
pub fn iri_as_go_signal_transduction(iri: &IRI) -> GO_0007166 { iri.id as GO_0007166 }
pub fn iri_as_go_molecular_function(iri: &IRI) -> GO_0003674 { iri.id as GO_0003674 }
pub fn iri_as_go_catalytic_activity(iri: &IRI) -> GO_0003824 { iri.id as GO_0003824 }

// ── OWLClass -> nominal coercions ───────────────────────────────────────────
// Sugar over the IRI coercions for the runtime model's richer `OWLClass` type
// (which carries the class `iri` plus runtime superclass/disjoint edges). Reads
// `c.iri.id`; identical contract to the IRI form — no runtime check, hands the
// value to the compiler's subsumption checker.

pub fn owl_class_as_go_biological_process(c: &OWLClass) -> GO_0008150 { c.iri.id as GO_0008150 }
pub fn owl_class_as_go_cellular_process(c: &OWLClass) -> GO_0009987 { c.iri.id as GO_0009987 }
pub fn owl_class_as_go_signaling(c: &OWLClass) -> GO_0007165 { c.iri.id as GO_0007165 }
pub fn owl_class_as_go_cell_communication(c: &OWLClass) -> GO_0007154 { c.iri.id as GO_0007154 }
pub fn owl_class_as_go_signal_transduction(c: &OWLClass) -> GO_0007166 { c.iri.id as GO_0007166 }
pub fn owl_class_as_go_molecular_function(c: &OWLClass) -> GO_0003674 { c.iri.id as GO_0003674 }
pub fn owl_class_as_go_catalytic_activity(c: &OWLClass) -> GO_0003824 { c.iri.id as GO_0003824 }
