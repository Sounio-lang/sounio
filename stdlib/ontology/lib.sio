//! stdlib/ontology/lib.sio
//!
//! Public ontology facade backed by the compiler ontology resolver slice.
//! Also re-exports terminology constants (SNOMED CT, ICD-10) and onto_is_a.

use compiler::ontology::mod::*

pub use terminology::{
    // SNOMED CT concept codes
    SNOMED_CLINICAL_FINDING, SNOMED_PROCEDURE, SNOMED_OBSERVABLE_ENTITY,
    SNOMED_BODY_STRUCTURE, SNOMED_ORGANISM, SNOMED_SUBSTANCE,
    SNOMED_PHARMACEUTICAL, SNOMED_PHYSICAL_OBJECT, SNOMED_PHYSICAL_FORCE,
    SNOMED_EVENT, SNOMED_DISORDER, SNOMED_INFECTIOUS_DISEASE,
    SNOMED_NEOPLASM, SNOMED_CARDIOVASCULAR_DISORDER, SNOMED_RESPIRATORY_DISORDER,
    SNOMED_FEVER, SNOMED_PAIN, SNOMED_DYSPNEA, SNOMED_HYPERTENSION,
    SNOMED_SURGICAL_PROCEDURE,
    // ICD-10 chapter boundaries
    ICD10_CH1_START, ICD10_CH1_END,
    ICD10_CH2_START, ICD10_CH2_END,
    ICD10_CH3_START, ICD10_CH3_END,
    ICD10_CH4_START, ICD10_CH4_END,
    ICD10_CH5_START, ICD10_CH5_END,
    ICD10_CH6_START, ICD10_CH6_END,
    ICD10_CH7_START, ICD10_CH7_END,
    ICD10_CH8_START, ICD10_CH8_END,
    ICD10_CH9_START, ICD10_CH9_END,
    ICD10_CH10_START, ICD10_CH10_END,
    // Subsumption
    onto_is_a,
}

fn resolve_curie(curie: string) -> ResolvedOntologyTerm {
    ontology_resolve(curie)
}

fn search(query: string) -> ResolvedOntologyTermList {
    ontology_search(query)
}

fn ancestors(curie: string) -> ResolvedOntologyTermList {
    ontology_ancestors(curie)
}

fn is_subclass(child: string, parent: string) -> bool {
    ontology_is_subclass(child, parent)
}

fn map_term(source_curie: string, to_ontology: string) -> OntologyMappingList {
    ontology_map_term(source_curie, to_ontology)
}
