// Parallel nominal ontology fixture for D9. It does not transport runtime
// kernel receipts. Siblings encode non-subsumption, not OWL disjointness.

ontology StatisticalCoverageEmpiricalBinding {
    class EpistemicArtifact

    class IdentifiedSetArtifact subclass_of EpistemicArtifact
    class ExactIdentifiedSet subclass_of IdentifiedSetArtifact

    class StatisticalSetArtifact subclass_of EpistemicArtifact
    class ConfidenceRegion subclass_of StatisticalSetArtifact
    class PredictiveSet subclass_of StatisticalSetArtifact

    class CoverageEvidenceArtifact subclass_of EpistemicArtifact
    class WholeSetCoverage subclass_of CoverageEvidenceArtifact
    class MemberwiseCoverage subclass_of CoverageEvidenceArtifact
    class AdequateCoverage subclass_of CoverageEvidenceArtifact
    class MarginalCoverage subclass_of CoverageEvidenceArtifact
    class SelectionConditionedCoverage subclass_of CoverageEvidenceArtifact
    class SelectionConditionedCoverageFailure subclass_of CoverageEvidenceArtifact

    class DataEvidenceArtifact subclass_of EpistemicArtifact
    class DeclaredLineage subclass_of DataEvidenceArtifact
    class IntegrityEvidence subclass_of DataEvidenceArtifact
    class AuthenticityEvidence subclass_of DataEvidenceArtifact
    class MeasurementValidityEvidence subclass_of DataEvidenceArtifact
    class ExternalDataCustody subclass_of DataEvidenceArtifact
    class SealedValidation subclass_of DataEvidenceArtifact

    class ContextArtifact subclass_of EpistemicArtifact
    class SamplingDesign subclass_of ContextArtifact
    class TargetPopulation subclass_of ContextArtifact
    class TargetTimeWindow subclass_of ContextArtifact
    class StatisticalCoverageCalibration subclass_of ContextArtifact
    class InstrumentCalibration subclass_of ContextArtifact
    class SamplingPositivity subclass_of ContextArtifact
    class InstrumentPopulationCompatibility subclass_of ContextArtifact

    class BindingArtifact subclass_of EpistemicArtifact
    class DeclaredContextBinding subclass_of BindingArtifact
    class EmpiricalBinding subclass_of BindingArtifact

    class AbstentionArtifact subclass_of EpistemicArtifact
    class SelectionAbstention subclass_of AbstentionArtifact
    class CalibrationAbstention subclass_of AbstentionArtifact
    class PositivityAbstention subclass_of AbstentionArtifact
    class InstrumentPopulationAbstention subclass_of AbstentionArtifact
    class ExternalBindingAbstention subclass_of AbstentionArtifact

    class StateArtifact subclass_of EpistemicArtifact
    class PatientState subclass_of StateArtifact

    class ClinicalAuthorityArtifact subclass_of EpistemicArtifact
    class NegativePrediction subclass_of ClinicalAuthorityArtifact
    class ClinicalEscalation subclass_of ClinicalAuthorityArtifact
    class ClinicalActionAuthority subclass_of ClinicalAuthorityArtifact

    class CausalArtifact subclass_of EpistemicArtifact
    class AssociationEvidence subclass_of CausalArtifact
    class CausalTreatmentEffect subclass_of CausalArtifact

    role targets domain SamplingDesign range IdentifiedSetArtifact
    role covers domain CoverageEvidenceArtifact range StatisticalSetArtifact
    role calibrated_for domain StatisticalCoverageCalibration range TargetPopulation
    role measured_for domain InstrumentCalibration range TargetPopulation
    role binds domain BindingArtifact range StatisticalSetArtifact
    role abstains_on domain AbstentionArtifact range EpistemicArtifact
    role authorizes domain ClinicalActionAuthority range PatientState
}

fn accept_identified_set(v: IdentifiedSetArtifact) -> i32 { 0 }
fn accept_statistical_set(v: StatisticalSetArtifact) -> i32 { 0 }
fn accept_coverage(v: CoverageEvidenceArtifact) -> i32 { 0 }
fn accept_data_evidence(v: DataEvidenceArtifact) -> i32 { 0 }
fn accept_context(v: ContextArtifact) -> i32 { 0 }
fn accept_binding(v: BindingArtifact) -> i32 { 0 }
fn accept_abstention(v: AbstentionArtifact) -> i32 { 0 }
fn accept_state(v: StateArtifact) -> i32 { 0 }
fn accept_clinical_authority(v: ClinicalAuthorityArtifact) -> i32 { 0 }
fn accept_causal(v: CausalArtifact) -> i32 { 0 }

fn exact_is_identified(v: ExactIdentifiedSet) -> i32 {
    accept_identified_set(v)
}
fn confidence_is_statistical(v: ConfidenceRegion) -> i32 {
    accept_statistical_set(v)
}
fn whole_is_coverage(v: WholeSetCoverage) -> i32 { accept_coverage(v) }
fn lineage_is_data_evidence(v: DeclaredLineage) -> i32 {
    accept_data_evidence(v)
}
fn population_is_context(v: TargetPopulation) -> i32 { accept_context(v) }
fn empirical_is_binding(v: EmpiricalBinding) -> i32 { accept_binding(v) }
fn external_is_abstention(v: ExternalBindingAbstention) -> i32 {
    accept_abstention(v)
}
fn patient_is_state(v: PatientState) -> i32 { accept_state(v) }
fn action_is_authority(v: ClinicalActionAuthority) -> i32 {
    accept_clinical_authority(v)
}
fn effect_is_causal(v: CausalTreatmentEffect) -> i32 { accept_causal(v) }
