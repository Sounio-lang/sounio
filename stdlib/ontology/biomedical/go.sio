// stdlib/ontology/biomedical/go.sio
//
// Gene Ontology (GO) Helpers
//
// Provides utilities for working with Gene Ontology terms,
// including the three main branches: biological process, molecular function,
// and cellular component.

// ============================================================================
// GO CONSTANTS
// ============================================================================

// Namespace ID
let NS_GO: i64 = 102

// GO namespaces (branches)
let GO_BIOLOGICAL_PROCESS: i64 = 1
let GO_MOLECULAR_FUNCTION: i64 = 2
let GO_CELLULAR_COMPONENT: i64 = 3

// GO relationship types
let GO_REL_IS_A: i64 = 10
let GO_REL_PART_OF: i64 = 11
let GO_REL_REGULATES: i64 = 12
let GO_REL_POSITIVELY_REGULATES: i64 = 13
let GO_REL_NEGATIVELY_REGULATES: i64 = 14
let GO_REL_HAS_PART: i64 = 15
let GO_REL_OCCURS_IN: i64 = 16

// Evidence codes
let EV_EXP: i64 = 100    // Inferred from Experiment
let EV_IDA: i64 = 101    // Inferred from Direct Assay
let EV_IPI: i64 = 102    // Inferred from Physical Interaction
let EV_IMP: i64 = 103    // Inferred from Mutant Phenotype
let EV_IGI: i64 = 104    // Inferred from Genetic Interaction
let EV_IEP: i64 = 105    // Inferred from Expression Pattern
let EV_ISS: i64 = 106    // Inferred from Sequence Similarity
let EV_ISO: i64 = 107    // Inferred from Sequence Orthology
let EV_IEA: i64 = 108    // Inferred from Electronic Annotation
let EV_TAS: i64 = 109    // Traceable Author Statement
let EV_NAS: i64 = 110    // Non-traceable Author Statement
let EV_ND: i64 = 111     // No biological Data available

// ============================================================================
// GO TERM
// ============================================================================

// GO term structure
pub struct GOTerm {
    pub go_id: i64,
    pub namespace: i64,
    pub name_id: i64,
    pub definition_id: i64,
    pub is_obsolete: bool,
    pub replaced_by: i64,
}

pub fn go_term_new(id: i64, namespace: i64) -> GOTerm {
    GOTerm {
        go_id: id,
        namespace: namespace,
        name_id: 0,
        definition_id: 0,
        is_obsolete: false,
        replaced_by: 0,
    }
}

pub fn go_term_is_bp(term: &GOTerm) -> bool {
    term.namespace == GO_BIOLOGICAL_PROCESS
}

pub fn go_term_is_mf(term: &GOTerm) -> bool {
    term.namespace == GO_MOLECULAR_FUNCTION
}

pub fn go_term_is_cc(term: &GOTerm) -> bool {
    term.namespace == GO_CELLULAR_COMPONENT
}

// ============================================================================
// GO ANNOTATION
// ============================================================================

// GO annotation linking gene to term
pub struct GOAnnotation {
    pub gene_id: i64,
    pub go_term_id: i64,
    pub evidence_code: i64,
    pub qualifier: i64,
    pub with_from_id: i64,
}

let QUAL_NONE: i64 = 0
let QUAL_NOT: i64 = 1
let QUAL_CONTRIBUTES_TO: i64 = 2
let QUAL_COLOCALIZES_WITH: i64 = 3

pub fn go_annotation_new(gene: i64, term: i64, evidence: i64) -> GOAnnotation {
    GOAnnotation {
        gene_id: gene,
        go_term_id: term,
        evidence_code: evidence,
        qualifier: QUAL_NONE,
        with_from_id: 0,
    }
}

pub fn go_annotation_is_experimental(ann: &GOAnnotation) -> bool {
    ann.evidence_code >= EV_EXP && ann.evidence_code <= EV_IEP
}

pub fn go_annotation_is_electronic(ann: &GOAnnotation) -> bool {
    ann.evidence_code == EV_IEA
}

// ============================================================================
// GO HIERARCHY
// ============================================================================

// GO term in hierarchy
pub struct GOHierarchyEntry {
    pub term_id: i64,
    pub parents: [i64],
    pub children: [i64],
    pub depth: i64,
}

pub fn go_hierarchy_entry_new(id: i64) -> GOHierarchyEntry {
    GOHierarchyEntry {
        term_id: id,
        parents: [],
        children: [],
        depth: 0,
    }
}

// GO hierarchy graph
pub struct GOGraph {
    pub entries: [GOHierarchyEntry],
}

pub fn go_graph_new() -> GOGraph {
    GOGraph {
        entries: [],
    }
}

pub fn go_graph_add(g: &GOGraph, entry: GOHierarchyEntry) {
    g.entries.push(entry)
}

pub fn go_graph_find(g: &GOGraph, term_id: i64) -> i64 {
    let n = g.entries.len()
    for i in 0..n {
        if g.entries[i].term_id == term_id {
            return i as i64
        }
    }
    0 - 1
}

// Check if term1 is ancestor of term2
pub fn go_is_ancestor(g: &GOGraph, ancestor_id: i64, term_id: i64) -> bool {
    let term_idx = go_graph_find(g, term_id)
    if term_idx < 0 {
        return false
    }

    var to_check: [i64] = []
    let n_parents = g.entries[term_idx as i64].parents.len()
    for i in 0..n_parents {
        to_check.push(g.entries[term_idx as i64].parents[i])
    }

    var checked = 0
    while checked < to_check.len() && checked < 1000 {
        let current = to_check[checked]
        if current == ancestor_id {
            return true
        }

        let current_idx = go_graph_find(g, current)
        if current_idx >= 0 {
            let n_p = g.entries[current_idx as i64].parents.len()
            for i in 0..n_p {
                to_check.push(g.entries[current_idx as i64].parents[i])
            }
        }
        checked = checked + 1
    }

    false
}

// ============================================================================
// GO ENRICHMENT
// ============================================================================

// Simple enrichment result
pub struct GOEnrichmentResult {
    pub term_id: i64,
    pub gene_count: i64,
    pub expected_count: f64,
    pub fold_enrichment: f64,
}

pub fn go_enrichment_result_new(term: i64, count: i64, expected: f64) -> GOEnrichmentResult {
    var fold = 0.0
    if expected > 0.0 {
        fold = (count as f64) / expected
    }

    GOEnrichmentResult {
        term_id: term,
        gene_count: count,
        expected_count: expected,
        fold_enrichment: fold,
    }
}

pub fn go_enrichment_is_significant(result: &GOEnrichmentResult, threshold: f64) -> bool {
    result.fold_enrichment >= threshold
}

