// stdlib/ontology/biomedical/snomed_concept.sio
//
// SNOMED-CT concept identifiers and concept wrapper.
//
// MADAROS REPAIR NOTE (2026-08): this block used to live inside
// snomed.sio.  Bisected probe: declarations of a small struct with an
// `impl` and free functions constructing a struct whose field is
// another struct (SCTID nested inside SNOMEDConcept) poison the codegen
// of unrelated `&!` mutations in the same module (SNOMEDElplus writes
// silently vanish).  Splitting them into their own module restores
// exact mutation semantics; snomed.sio re-exports the public surface.
//
pub let NS_SNOMED: i64 = 100
// ============================================================================
// SNOMED CONCEPT ID
// ============================================================================

// SNOMED CT Identifier
pub struct SCTID {
    id: i64,
    namespace_id: i64,
}

pub fn sctid_new(id: i64) -> SCTID {
    SCTID {
        id: id,
        namespace_id: NS_SNOMED,
    }
}

impl SCTID {
    pub fn equals(self: &SCTID, other: &SCTID) -> bool {
        self.id == other.id
    }

    pub fn clone(self: &SCTID) -> SCTID {
        SCTID {
            id: self.id,
            namespace_id: self.namespace_id,
        }
    }
}

// Check if valid SNOMED CT ID (basic validation)
pub fn sctid_is_valid(id: i64) -> bool {
    // SCTID must be positive and have appropriate length
    id > 0 && id < 10000000000000000
}

// ============================================================================
// SNOMED CONCEPT
// ============================================================================

// SNOMED concept wrapper
pub struct SNOMEDConcept {
    sctid: SCTID,
    fsn_id: i64,  // Fully Specified Name string ID
    preferred_term_id: i64,
    semantic_tag: i64,
    is_primitive: bool,
    is_active: bool,
}

pub fn snomed_concept_new(id: i64) -> SNOMEDConcept {
    SNOMEDConcept {
        sctid: sctid_new(id),
        fsn_id: 0,
        preferred_term_id: 0,
        semantic_tag: 0,
        is_primitive: true,
        is_active: true,
    }
}

pub fn snomed_concept_with_tag(id: i64, tag: i64) -> SNOMEDConcept {
    SNOMEDConcept {
        sctid: sctid_new(id),
        fsn_id: 0,
        preferred_term_id: 0,
        semantic_tag: tag,
        is_primitive: true,
        is_active: true,
    }
}

