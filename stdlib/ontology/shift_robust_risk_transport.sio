// Parallel nominal ontology fixture for D11. It classifies shift, target-risk,
// calibration, observation, and warrant-state concepts without transporting
// runtime kernel tokens or conferring production, clinical, or institutional
// authority. Siblings encode non-subsumption, not OWL disjointness.

ontology ShiftRobustRiskTransport {
    class EpistemicArtifact

    class ShiftEvidenceArtifact subclass_of EpistemicArtifact
    class CovariateShiftEvidence subclass_of ShiftEvidenceArtifact
    class LabelShiftEvidence subclass_of ShiftEvidenceArtifact
    class ConceptShiftEvidence subclass_of ShiftEvidenceArtifact
    class ConceptStabilityEvidence subclass_of ShiftEvidenceArtifact
    class NoDetectedShiftEvidence subclass_of ShiftEvidenceArtifact
    class NoShiftEvidence subclass_of ShiftEvidenceArtifact

    class TransportEvidenceArtifact subclass_of EpistemicArtifact
    class OverlapEvidence subclass_of TransportEvidenceArtifact
    class OverlapFailure subclass_of TransportEvidenceArtifact
    class LabelShiftIdentifiability subclass_of TransportEvidenceArtifact
    class SingularLabelShift subclass_of TransportEvidenceArtifact

    class RiskEvidenceArtifact subclass_of EpistemicArtifact
    class MarginalTargetRisk subclass_of RiskEvidenceArtifact
    class PrespecifiedSubgroupRisk subclass_of RiskEvidenceArtifact
    class SourceConformalRisk subclass_of RiskEvidenceArtifact
    class ShiftRobustTargetRisk subclass_of RiskEvidenceArtifact

    class CalibrationEvidenceArtifact subclass_of EpistemicArtifact
    class SourceMarginalCalibration subclass_of CalibrationEvidenceArtifact
    class TargetLocalCalibration subclass_of CalibrationEvidenceArtifact

    class TargetObservationArtifact subclass_of EpistemicArtifact
    class UnlabeledTargetEvidence subclass_of TargetObservationArtifact
    class LabeledTargetEvidence subclass_of TargetObservationArtifact

    class ScopeEvidenceArtifact subclass_of EpistemicArtifact
    class TargetScopeSubsetEvidence subclass_of ScopeEvidenceArtifact

    class WarrantStateArtifact subclass_of EpistemicArtifact
    class SourceScopedWarrantArtifact subclass_of WarrantStateArtifact
    class TargetScopedWarrantArtifact subclass_of WarrantStateArtifact
    class SourceCanaryWarrant subclass_of SourceScopedWarrantArtifact
    class TargetCanaryContinuation subclass_of TargetScopedWarrantArtifact
    class DegradedCanary subclass_of TargetScopedWarrantArtifact
    class SuspendedCanary subclass_of TargetScopedWarrantArtifact
    class RevokedCanary subclass_of TargetScopedWarrantArtifact

    class ReservedAuthorityArtifact subclass_of EpistemicArtifact
    class ProductionDeploymentAuthority subclass_of ReservedAuthorityArtifact
    class ClinicalActionAuthority subclass_of ReservedAuthorityArtifact
    class InstitutionalRevocationAuthority subclass_of ReservedAuthorityArtifact

    class TransportSubjectArtifact subclass_of EpistemicArtifact
    class SourcePopulation subclass_of TransportSubjectArtifact
    class TargetPopulation subclass_of TransportSubjectArtifact
    class ModelVersion subclass_of TransportSubjectArtifact
    class DeploymentSite subclass_of TransportSubjectArtifact
    class MonitoringEpoch subclass_of TransportSubjectArtifact

    role compares_source domain ShiftEvidenceArtifact range SourcePopulation
    role evaluates_target domain ShiftEvidenceArtifact range TargetPopulation
    role bounds_target domain RiskEvidenceArtifact range TargetPopulation
    role calibrated_in_source domain SourceMarginalCalibration range SourcePopulation
    role calibrated_in_target domain TargetLocalCalibration range TargetPopulation
    role observes domain TargetObservationArtifact range TargetPopulation
    role establishes_source_scope domain TargetScopeSubsetEvidence range SourcePopulation
    role establishes_target_scope domain TargetScopeSubsetEvidence range TargetPopulation
    role scopes_source_to domain SourceScopedWarrantArtifact range SourcePopulation
    role scopes_target_to domain TargetScopedWarrantArtifact range TargetPopulation
    role applies_to_model domain WarrantStateArtifact range ModelVersion
    role observed_at domain WarrantStateArtifact range MonitoringEpoch
}

fn accept_shift(v: ShiftEvidenceArtifact) -> i32 { 0 }
fn accept_transport(v: TransportEvidenceArtifact) -> i32 { 0 }
fn accept_risk(v: RiskEvidenceArtifact) -> i32 { 0 }
fn accept_calibration(v: CalibrationEvidenceArtifact) -> i32 { 0 }
fn accept_observation(v: TargetObservationArtifact) -> i32 { 0 }
fn accept_scope(v: ScopeEvidenceArtifact) -> i32 { 0 }
fn accept_warrant(v: WarrantStateArtifact) -> i32 { 0 }
fn accept_reserved_authority(v: ReservedAuthorityArtifact) -> i32 { 0 }
fn accept_subject(v: TransportSubjectArtifact) -> i32 { 0 }

fn covariate_is_shift(v: CovariateShiftEvidence) -> i32 { accept_shift(v) }
fn label_is_shift(v: LabelShiftEvidence) -> i32 { accept_shift(v) }
fn concept_is_shift(v: ConceptShiftEvidence) -> i32 { accept_shift(v) }
fn stable_is_shift_evidence(v: ConceptStabilityEvidence) -> i32 {
    accept_shift(v)
}
fn undetected_is_shift_evidence(v: NoDetectedShiftEvidence) -> i32 {
    accept_shift(v)
}
fn no_shift_is_shift_evidence(v: NoShiftEvidence) -> i32 { accept_shift(v) }
fn overlap_is_transport(v: OverlapEvidence) -> i32 { accept_transport(v) }
fn overlap_failure_is_transport(v: OverlapFailure) -> i32 {
    accept_transport(v)
}
fn label_id_is_transport(v: LabelShiftIdentifiability) -> i32 {
    accept_transport(v)
}
fn singular_is_transport(v: SingularLabelShift) -> i32 {
    accept_transport(v)
}
fn marginal_is_risk(v: MarginalTargetRisk) -> i32 { accept_risk(v) }
fn subgroup_is_risk(v: PrespecifiedSubgroupRisk) -> i32 { accept_risk(v) }
fn source_conformal_is_risk(v: SourceConformalRisk) -> i32 { accept_risk(v) }
fn target_robust_is_risk(v: ShiftRobustTargetRisk) -> i32 { accept_risk(v) }
fn source_calibration_is_calibration(v: SourceMarginalCalibration) -> i32 {
    accept_calibration(v)
}
fn target_calibration_is_calibration(v: TargetLocalCalibration) -> i32 {
    accept_calibration(v)
}
fn unlabeled_is_observation(v: UnlabeledTargetEvidence) -> i32 {
    accept_observation(v)
}
fn labeled_is_observation(v: LabeledTargetEvidence) -> i32 {
    accept_observation(v)
}
fn subset_is_scope_evidence(v: TargetScopeSubsetEvidence) -> i32 {
    accept_scope(v)
}
fn source_scoped_is_warrant(v: SourceScopedWarrantArtifact) -> i32 {
    accept_warrant(v)
}
fn target_scoped_is_warrant(v: TargetScopedWarrantArtifact) -> i32 {
    accept_warrant(v)
}
fn source_canary_is_warrant(v: SourceCanaryWarrant) -> i32 {
    accept_warrant(v)
}
fn continuation_is_warrant(v: TargetCanaryContinuation) -> i32 {
    accept_warrant(v)
}
fn degraded_is_warrant(v: DegradedCanary) -> i32 { accept_warrant(v) }
fn suspended_is_warrant(v: SuspendedCanary) -> i32 { accept_warrant(v) }
fn revoked_is_warrant(v: RevokedCanary) -> i32 { accept_warrant(v) }
fn production_is_reserved(v: ProductionDeploymentAuthority) -> i32 {
    accept_reserved_authority(v)
}
fn clinical_is_reserved(v: ClinicalActionAuthority) -> i32 {
    accept_reserved_authority(v)
}
fn institutional_is_reserved(v: InstitutionalRevocationAuthority) -> i32 {
    accept_reserved_authority(v)
}
fn source_population_is_subject(v: SourcePopulation) -> i32 {
    accept_subject(v)
}
fn target_population_is_subject(v: TargetPopulation) -> i32 {
    accept_subject(v)
}
fn model_is_subject(v: ModelVersion) -> i32 { accept_subject(v) }
fn site_is_subject(v: DeploymentSite) -> i32 { accept_subject(v) }
fn epoch_is_subject(v: MonitoringEpoch) -> i32 { accept_subject(v) }
