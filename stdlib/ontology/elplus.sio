//! stdlib/ontology/elplus.sio
//!
//! Role-aware EL+ boolean closure, packaged from the verified
//! ontology-frontiers research line (round 8 demo
//! examples/ontology_elplus_closure_demo.sio; round 9 real-data
//! integration artifacts/ontology-frontiers/real-data/scale/).
//!
//! Model: a finite concept universe of interned EL+ concepts
//! (atom | top | conjunction | existential restriction), described by a
//! parallel-array concept table:
//!
//!   ckind[c]  0 atom, 1 top, 2 conjunction, 3 existential
//!   carg1[c]  atom id (atom) | first conjunct (conj) | role (ex)
//!   carg2[c]  second conjunct (conj) | filler base concept (ex)
//!
//! Relations, all flattened Boolean arrays (row-major):
//!
//!   S[c*64+d]           subsumption pairs over the universe
//!   R[(r*64+c)*64+f]    role edges (r, C, f): C <= ex r.f, f base
//!   rclos[r*8+s]        role-hierarchy closure (reflexive + transitive)
//!   exid[r*64+f]        interned id of ex r.f, or -1 if not in universe
//!
//! Two computation variants:
//!
//!   DENSE (demos / small TBoxes): `elplus_fixpoint` iterates the 8
//!   completion rules to a genuine fixpoint.  Two layouts of the same
//!   engine: the LEGACY layout (64 concepts, 8 roles, 8 composition chains;
//!   the S / R / rclos / pack arrays and the 64-stride indexing documented
//!   above, unchanged, `elplus_*`) and the WIDE layout (256 concepts, 16
//!   roles, 32 chains, 256-stride, `elplus_wide_*`; see the section
//!   "Wide dense variant" below).  The legacy `elplus_fixpoint_packed` keeps
//!   its own copy of the 8-rule loop (the original, unchanged except for
//!   capacity guards) and the wide core carries a second copy with 256-stride
//!   indexing: an embedding of the legacy arrays into a shared wide workspace
//!   was tried and dropped because the committed Madaros prebuilt does not see
//!   direct writes to module-level arrays from a callee (see the 2026-11-15
//!   report), so both layouts are kept in step by the legacy-vs-wide cell
//!   comparison in tests/run-pass/elplus_limits_256.sio, section (g).  Inputs
//!   capacity are refused (wide: status code, legacy: panic), never written
//!   out of bounds.
//!
//!   SPARSE (scale): no concept matrix at all for the role layer.  For
//!   TBoxes with the OAEI Anatomy profile (no conjunctions, a single
//!   active role, no role hierarchy/composition) the least fixpoint
//!   satisfies  E(c) = union over ancestors a of c of the ancestor sets
//!   of the stated fillers of a,  so the role-edge fillers of every
//!   class are computed by ancestor-set expansion over packed adjacency:
//!   per-class BFS (`elplus_sparse_bfs`), stated-filler seeding
//!   (`elplus_sparse_seed_edges`), in-place expansion
//!   (`elplus_sparse_expand`).  Capacities: 4096 classes (incl. the top
//!   slot), 4096 stated edges per kind; the two workspace matrices
//!   (`elplus_clos`, `elplus_emat`, 4096-stride) are module-level (see the
//!   sparse section header).  TBoxes
//!   with conjunctions, role hierarchies or composition must use the
//!   dense variant (or a future stratified sparse variant); the round-9
//!   python mirror (scale/gen_elplus_data.py) runs the GENERAL 8-rule
//!   fixpoint and aborts unless it agrees with this reduction exactly.
//!
//! Formal companions (Lean 4, verified):
//!   - formal/OntologyELPlus.lean                 (EL+ syntax/semantics,
//!     9-rule deductive system, der_sound, incoherentP_empty)
//!   - formal/OntologyELPlusClosureComplete.lean  (crStep / closeSatF;
//!     subBPlusC_iff / conflictBPlusC_iff: the boolean fixpoint coincides
//!     with the deductive system over conceptUniv, both directions)
//!
//! The 8 completion rules mirrored here (crStep generators):
//!   transitivity on S; conjElim; conjIntro; stoR (C <= ex r.D becomes
//!   edge (r,C,D)); Rmono (edge (r,C,D) and D <= D' give (r,C,D'));
//!   roleSub (edge (r,C,D) and r <=* s give (s,C,D)); roleComp (edges
//!   (r1,C,D) and (r2,D,E) with chain r1 o r2 <= r3 give (r3,C,E));
//!   RtoS (edge (r,C,D) gives C <= ex r.D).
//!
//! Data layout: parallel primitive arrays with runtime checks. The
//! compiler limits this layout was first chosen around (arrays of structs,
//! arrays without splat initialisation, module arrays through `&!`, the
//! qualified import form, imported calls with more than 8 parameters) no
//! longer reproduce (re-measured 2026-11-14; witnesses
//! tests/run-pass/{array_struct_literal,module_array_mut_ref,
//! elplus_qualified_import,elplus_fixpoint14_from_helper}.sio). `where`
//! refinement clauses are ADR-028 D-19.
//!
//! Repair integration (round 10): `elplus_derive_conflicts` derives the
//! mapping-pair conflict relation from a closed dense EL+ matrix (same
//! 256-stride output shape as ontology::closure::derive_conflicts, so
//! ontology::repair plugs in unchanged), and `elplus_subsumes_sparse` /
//! `elplus_edge_sparse` are O(1) read-only accessors over the sparse
//! workspace matrices so repair drivers can query the role-aware closure.
//! `elplus_subsumes_dense` / `elplus_edge_dense` are the O(1) dense
//! counterparts over the `elplus_fixpoint` output matrices, used by the
//! SNOMED mini-closure adapter (ontology::biomedical::snomed).

// ── Dense variant capacities ─────────────────────────────────────────────
// Legacy-layout capacities (the wide layout is ELPLUS_WIDE_* below).
// Maximum number of interned concepts (atoms + top + conjs + existentials).
pub const ELPLUS_MAXC: i64 = 64
// Maximum number of roles.
pub const ELPLUS_MAXR: i64 = 8
// Maximum number of composition chains r1 o r2 <= r3.
pub const ELPLUS_MAXCH: i64 = 8

// ── Sparse variant capacities ────────────────────────────────────────────
// Maximum number of classes including the top slot (matrix rows/cols used).
const ELPLUS_SC: i64 = 4096
// Maximum number of stated edges per kind (sub or exsub).
const ELPLUS_SE: i64 = 4096

// ── Wide dense variant (capacity raised 2026-11-15) ───────────────────────
//
// The legacy dense API above/below is bound to the 64 / 8 / 8 layout by the
// array TYPES in its signatures (`[bool; 4096]`, `[bool; 32768]`,
// `[i64; 704]`, ...) and by the callers' literal strides (`s[a*64+b]`); it is
// kept source compatible (its rule loop is the original; only capacity guards were added) next to the
// wide core below.  The wide API has the same rules, the same relations, and the
// layout below:
//
//   S[c*256+d]            [bool; 65536]    (256 x 256)
//   R[(r*256+c)*256+f]    [bool; 1048576]  (16 x 256 x 256)
//   rclos[r*16+s]         [bool; 256]      (16 x 16)
//   pack                  [i64; 4864]      ckind[0..256) carg1[256..512)
//                                          carg2[512..768) exid[768..4864),
//                                          exid[768 + r*256 + f]
//   chains                [i64; 96]        ch1[0..32) ch2[32..64) ch3[64..96)
//   dims                  [i64; 4]         [nchain, nc, nb, nr]
//
// Fail closed.  Every wide entry point validates its dimensions and the
// concept / existential / chain tables of the used region BEFORE writing
// anything to its outputs; a violation returns a nonzero status
// (`elplus_wide_seed`, `elplus_wide_role_closure`) or a negative status
// (`elplus_wide_fixpoint_packed`: -1 nchain, -2 nc, -3 nb, -4 nr, -5 conjunct
// out of range, -6 existential role/filler out of range, -7 exid out of range,
// -8 chain role out of range).  The legacy entry points panic on the same
// violations at THEIR capacities (before 2026-11-15 they wrote out of bounds
// silently: `elplus_seed(&!s, 65, 0)` returned normally and corrupted memory).
//
// Soundness: the Lean development (formal/OntologyELPlusClosureComplete.lean)
// quantifies over arbitrary `Fin n` / `Fin m` universes; no size is part of
// the theorems.  The capacities here are only the bounds of the executable
// mirror; a TBox that does not fit is REFUSED, never truncated.

// Wide capacities (documentation and caller use; the wide code below uses the
// literals 256 / 16 / 32 on purpose: with these named constants the committed
// Madaros prebuilt computed wrong results, measured: elplus_wide_seed(s, 3, 2)
// set 3 cells instead of 5).
pub const ELPLUS_WIDE_MAXC: i64 = 256
pub const ELPLUS_WIDE_MAXR: i64 = 16
pub const ELPLUS_WIDE_MAXCH: i64 = 32

/// Validate dims and the used part of the tables of a wide-layout pack
/// against the capacities (`cc` concepts, `cr` roles, `ch` chains) for the
/// dims, and against the ACTIVE dimensions dims = [nchain, nc, nb, nr] for
/// every id: concept ids (conjunct arguments, exid entries) must lie in
/// 0..nc (exid: -1 is the only absence sentinel), existential roles and chain
/// endpoints in 0..nr, existential fillers in 0..nb, and nb <= nc. Returns 0
/// when valid, otherwise the positive form of the status documented above
/// (9 nb > nc). Only entries that the rules can read are examined:
/// conjunction / existential arguments of concepts c < nc, exid[r][f] for
/// r < nr, f < nb, and the chains k < nchain.
fn elplus_wide_check(pack: &[i64; 4864], chains: &[i64; 96], dims: &[i64; 4], cc: i64, cr: i64, ch: i64) -> i64 with Div, Panic {
    let nchain = dims[0]
    let nc = dims[1]
    let nb = dims[2]
    let nr = dims[3]
    if nchain < 0 || nchain > ch { return 1 }
    if nc < 0 || nc > cc { return 2 }
    if nb < 0 || nb > cc { return 3 }
    if nr < 0 || nr > cr { return 4 }
    if nb > nc { return 9 }
    var c: i64 = 0
    while c < nc {
        let kind = pack[c]
        let a1 = pack[256 + c]
        let a2 = pack[512 + c]
        if kind == 2 {
            if a1 < 0 || a1 >= nc || a2 < 0 || a2 >= nc { return 5 }
        }
        if kind == 3 {
            if a1 < 0 || a1 >= nr || a2 < 0 || a2 >= nb { return 6 }
        }
        c = c + 1
    }
    var r: i64 = 0
    while r < nr {
        var f: i64 = 0
        while f < nb {
            let x = pack[768 + r * 256 + f]
            if x < 0 - 1 || x >= nc { return 7 }
            f = f + 1
        }
        r = r + 1
    }
    var k: i64 = 0
    while k < nchain {
        let x1 = chains[k]
        let x2 = chains[32 + k]
        let x3 = chains[64 + k]
        if x1 < 0 || x1 >= nr || x2 < 0 || x2 >= nr || x3 < 0 || x3 >= nr { return 8 }
        k = k + 1
    }
    return 0
}

/// Validate the INPUT state of the matrices against the active dimensions,
/// before anything is written: a set `rclos` cell outside nr x nr (10), a set
/// `s` cell outside nc x nc (11), a set `r` cell outside nr x nc x nb (12).
/// Returns 0 or the positive status.
fn elplus_wide_check_state(s: &[bool; 65536], r: &[bool; 1048576], rclos: &[bool; 256], dims: &[i64; 4]) -> i64 with Div, Panic {
    let nc = dims[1]
    let nb = dims[2]
    let nr = dims[3]
    var a: i64 = 0
    while a < 16 {
        var b: i64 = 0
        while b < 16 {
            if rclos[a * 16 + b] {
                if a >= nr || b >= nr { return 10 }
            }
            b = b + 1
        }
        a = a + 1
    }
    a = 0
    while a < 256 {
        var b: i64 = 0
        while b < 256 {
            if s[a * 256 + b] {
                if a >= nc || b >= nc { return 11 }
            }
            b = b + 1
        }
        a = a + 1
    }
    var rr: i64 = 0
    while rr < 16 {
        var c: i64 = 0
        while c < 256 {
            var f: i64 = 0
            while f < 256 {
                if r[(rr * 256 + c) * 256 + f] {
                    if rr >= nr || c >= nc || f >= nb { return 12 }
                }
                f = f + 1
            }
            c = c + 1
        }
        rr = rr + 1
    }
    return 0
}

/// Wide role-hierarchy closure: seed reflexivity, then transitive saturation
/// over the stated cells of `rclos` (16 x 16, stride 16).  Returns 0, or 1
/// (nothing written) when `nr` is outside 0..=16.
///
/// # Complexity
/// O(nr^3) per pass, at most nr passes.
pub fn elplus_wide_role_closure(rclos: &![bool; 256], nr: i64) -> i64 with Mut, Div, Panic {
    if nr < 0 || nr > 16 { return 1 }
    var r: i64 = 0
    while r < nr {
        rclos[r * 16 + r] = true
        r = r + 1
    }
    var changed = true
    var a: i64 = 0
    var b: i64 = 0
    var d: i64 = 0
    while changed {
        changed = false
        a = 0
        while a < nr {
            b = 0
            while b < nr {
                if rclos[a * 16 + b] {
                    d = 0
                    while d < nr {
                        if rclos[b * 16 + d] {
                            if !rclos[a * 16 + d] {
                                rclos[a * 16 + d] = true
                                changed = true
                            }
                        }
                        d = d + 1
                    }
                }
                b = b + 1
            }
            a = a + 1
        }
    }
    return 0
}

/// Wide subsumption seed: every cell of the 256 x 256 matrix false, then
/// reflexivity and the top axiom for every concept c < nc.  Returns 0, or
/// 1 (nc outside 0..=256) / 2 (top outside 0..nc while nc > 0); on a
/// refusal NOTHING is written.
///
/// # Complexity
/// O(256^2)
pub fn elplus_wide_seed(s: &![bool; 65536], nc: i64, top: i64) -> i64 with Mut, Div, Panic {
    if nc < 0 || nc > 256 { return 1 }
    if nc > 0 {
        if top < 0 || top >= nc { return 2 }
    }
    var a: i64 = 0
    while a < 256 {
        var b: i64 = 0
        while b < 256 {
            s[a * 256 + b] = false
            b = b + 1
        }
        a = a + 1
    }
    var c: i64 = 0
    while c < nc {
        s[c * 256 + c] = true
        s[c * 256 + top] = true
        c = c + 1
    }
    return 0
}

/// Pack helper: concept `c` of kind `kind` (0 atom, 1 top, 2 conjunction,
/// 3 existential) with arguments `a1`, `a2` (see the module header).
/// Returns 0, or 1 when c is outside 0..256, kind outside 0..=3, or an argument
/// is outside its capacity (nothing written).
pub fn elplus_wide_set_concept(pack: &![i64; 4864], c: i64, kind: i64, a1: i64, a2: i64) -> i64 with Mut, Div, Panic {
    if c < 0 || c >= 256 { return 1 }
    if kind < 0 || kind > 3 { return 1 }
    if kind == 2 {
        if a1 < 0 || a1 >= 256 || a2 < 0 || a2 >= 256 { return 1 }
    }
    if kind == 3 {
        if a1 < 0 || a1 >= 16 || a2 < 0 || a2 >= 256 { return 1 }
    }
    pack[c] = kind
    pack[256 + c] = a1
    pack[512 + c] = a2
    return 0
}

/// Pack helper: exid[r][f] = id of the interned `exists r.f` (or -1).
/// Returns 0, or 1 when r, f or id (-1 or 0..256) is out of range (nothing
/// written).
pub fn elplus_wide_set_exid(pack: &![i64; 4864], r: i64, f: i64, id: i64) -> i64 with Mut, Div, Panic {
    if r < 0 || r >= 16 || f < 0 || f >= 256 { return 1 }
    if id < 0 - 1 || id >= 256 { return 1 }
    pack[768 + r * 256 + f] = id
    return 0
}

/// Pack helper: chain k is r1 o r2 <= r3.  Returns 0, or 1 when k is out of
/// range (nothing written).
pub fn elplus_wide_set_chain(chains: &![i64; 96], k: i64, r1: i64, r2: i64, r3: i64) -> i64 with Mut, Div, Panic {
    if k < 0 || k >= 32 { return 1 }
    if r1 < 0 || r1 >= 16 || r2 < 0 || r2 >= 16 || r3 < 0 || r3 >= 16 { return 1 }
    chains[k] = r1
    chains[32 + k] = r2
    chains[64 + k] = r3
    return 0
}

/// The 8-rule EL+ completion step iterated to a genuine fixpoint over the
/// wide capacities (256 concepts, 16 roles, 32 chains): the PRIMARY home of
/// the rule loop at 256 stride (the legacy 64 / 8 / 8 entry points keep their own copy).
/// Identical semantics to the legacy documentation of `elplus_fixpoint`
/// (S seeded with `elplus_wide_seed` plus the stated inclusions; R passed
/// splat-false and derived here; derived edges that would need a
/// non-interned existential are skipped, the `conceptUniv` restriction).
///
/// Returns the number of rounds (>= 1) or a negative status (see the
/// section header); on a negative status `s` and `r` are untouched.
///
/// # Complexity
/// O(rounds * (nc^3 + nr*nc*nb^2 + nr^2*nc*nb + nchain*nc*nb^2)), the guarded
/// inner loops only run for set edges.
///
/// # References
/// - formal/OntologyELPlusClosureComplete.lean, theorems
///   `closeSatF_trans` ... `closeSatF_RtoS`, `subBPlusC_iff`,
///   `conflictBPlusC_iff` (over an arbitrary finite universe).
pub fn elplus_wide_fixpoint_packed(
    s: &![bool; 65536],
    r: &![bool; 1048576],
    pack: &[i64; 4864],
    rclos: &[bool; 256],
    chains: &[i64; 96],
    dims: &[i64; 4]
) -> i64 with Mut, Div, Panic {
    let status = elplus_wide_check(pack, chains, dims, 256, 16, 32)
    if status != 0 { return 0 - status }
    let status2 = elplus_wide_check_state(s, r, rclos, dims)
    if status2 != 0 { return 0 - status2 }
    var nchain: i64 = dims[0]
    var nc: i64 = dims[1]
    var nb: i64 = dims[2]
    var nr: i64 = dims[3]
    var changed = true
    var rounds: i64 = 0
    var a: i64 = 0
    var k: i64 = 0
    var d: i64 = 0
    var c: i64 = 0
    var rr: i64 = 0
    var ss: i64 = 0
    var f: i64 = 0
    var d2: i64 = 0
    var f2: i64 = 0
    var x: i64 = 0
    var idx: i64 = 0
    var r1: i64 = 0
    var r2: i64 = 0
    var r3: i64 = 0
    while changed {
        changed = false
        rounds = rounds + 1

        // (T) transitivity on S
        a = 0
        while a < nc {
            k = 0
            while k < nc {
                if s[a * 256 + k] {
                    d = 0
                    while d < nc {
                        if s[k * 256 + d] && !s[a * 256 + d] {
                            s[a * 256 + d] = true
                            changed = true
                        }
                        d = d + 1
                    }
                }
                k = k + 1
            }
            a = a + 1
        }

        // (CE) conjunction elimination and (CI) introduction (kind 2)
        a = 0
        while a < nc {
            d = 0
            while d < nc {
                if pack[d] == 2 {
                    if s[a * 256 + d] {
                        if !s[a * 256 + pack[256 + d]] {
                            s[a * 256 + pack[256 + d]] = true
                            changed = true
                        }
                        if !s[a * 256 + pack[512 + d]] {
                            s[a * 256 + pack[512 + d]] = true
                            changed = true
                        }
                    }
                    if s[a * 256 + pack[256 + d]] && s[a * 256 + pack[512 + d]] {
                        if !s[a * 256 + d] {
                            s[a * 256 + d] = true
                            changed = true
                        }
                    }
                }
                d = d + 1
            }
            a = a + 1
        }

        // (S2R) stoR: C <= ex r.D becomes edge (r, C, D)
        a = 0
        while a < nc {
            d = 0
            while d < nc {
                if pack[d] == 3 && s[a * 256 + d] {
                    idx = (pack[256 + d] * 256 + a) * 256 + pack[512 + d]
                    if !r[idx] {
                        r[idx] = true
                        changed = true
                    }
                }
                d = d + 1
            }
            a = a + 1
        }

        // (RM) Rmono: edge (r,C,D) and D <= D' give (r,C,D'), D' base
        rr = 0
        while rr < nr {
            c = 0
            while c < nc {
                f = 0
                while f < nb {
                    if r[(rr * 256 + c) * 256 + f] {
                        d2 = 0
                        while d2 < nb {
                            if s[f * 256 + d2] && pack[768 + rr * 256 + d2] >= 0 {
                                idx = (rr * 256 + c) * 256 + d2
                                if !r[idx] {
                                    r[idx] = true
                                    changed = true
                                }
                            }
                            d2 = d2 + 1
                        }
                    }
                    f = f + 1
                }
                c = c + 1
            }
            rr = rr + 1
        }

        // (RS) roleSub: edge (r,C,D) and r <=* s (rclos) give (s,C,D)
        rr = 0
        while rr < nr {
            ss = 0
            while ss < nr {
                if rclos[rr * 16 + ss] {
                    c = 0
                    while c < nc {
                        f = 0
                        while f < nb {
                            if r[(rr * 256 + c) * 256 + f] && pack[768 + ss * 256 + f] >= 0 {
                                idx = (ss * 256 + c) * 256 + f
                                if !r[idx] {
                                    r[idx] = true
                                    changed = true
                                }
                            }
                            f = f + 1
                        }
                        c = c + 1
                    }
                }
                ss = ss + 1
            }
            rr = rr + 1
        }

        // (RC) roleComp: edges (r1,C,D) and (r2,D,E) with chain
        // r1 o r2 <= r3 give (r3,C,E)
        k = 0
        while k < nchain {
            r1 = chains[k]
            r2 = chains[32 + k]
            r3 = chains[64 + k]
            c = 0
            while c < nc {
                f = 0
                while f < nb {
                    if r[(r1 * 256 + c) * 256 + f] {
                        f2 = 0
                        while f2 < nb {
                            if r[(r2 * 256 + f) * 256 + f2] && pack[768 + r3 * 256 + f2] >= 0 {
                                idx = (r3 * 256 + c) * 256 + f2
                                if !r[idx] {
                                    r[idx] = true
                                    changed = true
                                }
                            }
                            f2 = f2 + 1
                        }
                    }
                    f = f + 1
                }
                c = c + 1
            }
            k = k + 1
        }

        // (R2S) RtoS: edge (r,C,D) gives C <= ex r.D
        rr = 0
        while rr < nr {
            c = 0
            while c < nc {
                f = 0
                while f < nb {
                    if r[(rr * 256 + c) * 256 + f] {
                        x = pack[768 + rr * 256 + f]
                        if x >= 0 && !s[c * 256 + x] {
                            s[c * 256 + x] = true
                            changed = true
                        }
                    }
                    f = f + 1
                }
                c = c + 1
            }
            rr = rr + 1
        }
    }
    return rounds
}

/// Role-hierarchy closure: seed reflexivity, then transitive saturation
/// over the stated cells of rclos.  Existing stated cells are kept.
///
/// # Parameters
/// - `rclos`: flattened 8 x 8 role matrix (mutated in place).
/// - `nr`: number of roles (0 <= nr <= 8).
///
/// # Complexity
/// O(nr^3) per pass, at most nr passes.
pub fn elplus_role_closure(rclos: &![bool; 64], nr: i64) with Mut, Div, Panic {
    if nr < 0 || nr > ELPLUS_MAXR { panic("elplus_role_closure: nr outside 0..8 (legacy capacity ELPLUS_MAXR); use elplus_wide_role_closure") }
    var r: i64 = 0
    while r < nr {
        rclos[r * ELPLUS_MAXR + r] = true
        r = r + 1
    }
    var changed = true
    var a: i64 = 0
    var b: i64 = 0
    var d: i64 = 0
    while changed {
        changed = false
        a = 0
        while a < nr {
            b = 0
            while b < nr {
                if rclos[a * ELPLUS_MAXR + b] {
                    d = 0
                    while d < nr {
                        if rclos[b * ELPLUS_MAXR + d] {
                            if !rclos[a * ELPLUS_MAXR + d] {
                                rclos[a * ELPLUS_MAXR + d] = true
                                changed = true
                            }
                        }
                        d = d + 1
                    }
                }
                b = b + 1
            }
            a = a + 1
        }
    }
}

/// Initialise a subsumption matrix: every cell false, then reflexivity
/// and the top axiom (c <= top for every concept c).
///
/// # Parameters
/// - `s`: flattened 64 x 64 matrix (mutated in place).
/// - `nc`: number of interned concepts (0 <= nc <= 64).
/// - `top`: id of the top concept (0 <= top < nc).
///
/// # Complexity
/// O(64^2)
pub fn elplus_seed(s: &![bool; 4096], nc: i64, top: i64) with Mut, Div, Panic {
    if nc < 0 || nc > ELPLUS_MAXC { panic("elplus_seed: nc outside 0..64 (legacy capacity ELPLUS_MAXC); use elplus_wide_seed") }
    if nc > 0 {
        if top < 0 || top >= ELPLUS_MAXC { panic("elplus_seed: top outside 0..64 (legacy capacity ELPLUS_MAXC)") }
    }
    var a: i64 = 0
    while a < ELPLUS_MAXC {
        var b: i64 = 0
        while b < ELPLUS_MAXC {
            s[a * ELPLUS_MAXC + b] = false
            b = b + 1
        }
        a = a + 1
    }
    var c: i64 = 0
    while c < nc {
        s[c * ELPLUS_MAXC + c] = true
        s[c * ELPLUS_MAXC + top] = true
        c = c + 1
    }
}

/// The 8-rule EL+ completion step iterated to a genuine fixpoint
/// (executable mirror of crStep / closeSatF).  S must be seeded (see
/// `elplus_seed`) with the stated inclusions before the call; R is fully
/// derived here (pass it splat-false).  Returns the number of rounds
/// taken.  Terminates: the matrices are finite and cells only flip
/// false -> true.
///
/// # Parameters
/// - `s`: flattened 64 x 64 subsumption matrix (mutated in place).
/// - `r`: flattened 8 x 64 x 64 role-edge cube (mutated in place);
///   index (role*64 + source)*64 + filler.
/// - `ckind`, `carg1`, `carg2`: concept table (see module header).
/// - `exid`: r*64 + f -> interned id of ex r.f, or -1 if absent; rules
///   that would create a non-interned existential are skipped (this is
///   the `conceptUniv` restriction of the Lean development).
/// - `rclos`: role-hierarchy closure (from `elplus_role_closure`).
/// - `ch1`, `ch2`, `ch3`, `nchain`: composition chains
///   ch1[k] o ch2[k] <= ch3[k] (0 <= nchain <= 8).
/// - `nc`: number of interned concepts (0 <= nc <= 64).
/// - `nb`: number of base concepts (fillers range over 0..nb-1).
/// - `nr`: number of roles (0 <= nr <= 8).
///
/// # Complexity
/// O(rounds * (nc^3 + nr*nc^2*nb + nr^2*nc*nb + nchain*nc*nb^2)); with
/// the 64/8 capacities this is bounded and intended for small TBoxes.
///
/// # References
/// - formal/OntologyELPlusClosureComplete.lean, theorems
///   `closeSatF_trans` ... `closeSatF_RtoS` (fixpoint is closed under
///   every rule) and `subBPlusC_iff` / `conflictBPlusC_iff` (the boolean
///   closure IS the deductive relation over conceptUniv).
pub fn elplus_fixpoint(
    s: &![bool; 4096],
    r: &![bool; 32768],
    ckind: &[i64; 64],
    carg1: &[i64; 64],
    carg2: &[i64; 64],
    exid: &[i64; 512],
    rclos: &[bool; 64],
    ch1: &[i64; 8],
    ch2: &[i64; 8],
    ch3: &[i64; 8],
    nchain: i64,
    nc: i64,
    nb: i64,
    nr: i64
) -> i64 with Mut, Div, Panic {
    var pack: [i64; 704] = [0; 704]
    var chains: [i64; 24] = [0; 24]
    var dims: [i64; 4] = [0; 4]
    var i: i64 = 0
    while i < 64 {
        pack[i] = ckind[i]
        pack[64 + i] = carg1[i]
        pack[128 + i] = carg2[i]
        i = i + 1
    }
    i = 0
    while i < 512 {
        pack[192 + i] = exid[i]
        i = i + 1
    }
    i = 0
    while i < 8 {
        chains[i] = ch1[i]
        chains[8 + i] = ch2[i]
        chains[16 + i] = ch3[i]
        i = i + 1
    }
    dims[0] = nchain
    dims[1] = nc
    dims[2] = nb
    dims[3] = nr
    return elplus_fixpoint_packed(s, r, &pack, rclos, &chains, &dims)
}

/// Cross-module packaging of `elplus_fixpoint` and the PRIMARY home of
/// the 8-rule loop: identical semantics, but 6 parameters instead of
/// 14; the public 14-parameter `elplus_fixpoint` above packs and
/// delegates here. (The packing was introduced when imported calls with
/// more than 8 parameters produced no ELF outside `main`, probe 2026-08;
/// that no longer reproduces: tests/run-pass/
/// elplus_fixpoint14_from_helper.sio.)
///
/// # Parameters
/// - `s`, `r`: as in `elplus_fixpoint` (mutated in place).
/// - `pack`: concept tables concatenated — ckind[0..64) then
///   carg1[0..64) then carg2[0..64) then exid[0..512).
/// - `rclos`: role-hierarchy closure (from `elplus_role_closure`).
/// - `chains`: ch1[0..8) then ch2[0..8) then ch3[0..8).
/// - `dims`: [nchain, nc, nb, nr].
///
/// # Complexity
/// Same as `elplus_fixpoint`, plus one O(704) unpack.
pub fn elplus_fixpoint_packed(
    s: &![bool; 4096],
    r: &![bool; 32768],
    pack: &[i64; 704],
    rclos: &[bool; 64],
    chains: &[i64; 24],
    dims: &[i64; 4]
) -> i64 with Mut, Div, Panic {
    if dims[0] < 0 || dims[0] > ELPLUS_MAXCH { panic("elplus_fixpoint: nchain outside 0..8 (legacy capacity ELPLUS_MAXCH); use elplus_wide_fixpoint_packed") }
    if dims[1] < 0 || dims[1] > ELPLUS_MAXC { panic("elplus_fixpoint: nc outside 0..64 (legacy capacity ELPLUS_MAXC); use elplus_wide_fixpoint_packed") }
    if dims[2] < 0 || dims[2] > ELPLUS_MAXC { panic("elplus_fixpoint: nb outside 0..64 (legacy capacity ELPLUS_MAXC); use elplus_wide_fixpoint_packed") }
    if dims[3] < 0 || dims[3] > ELPLUS_MAXR { panic("elplus_fixpoint: nr outside 0..8 (legacy capacity ELPLUS_MAXR); use elplus_wide_fixpoint_packed") }
    var ckind: [i64; 64] = [0; 64]
    var carg1: [i64; 64] = [0; 64]
    var carg2: [i64; 64] = [0; 64]
    var exid: [i64; 512] = [0; 512]
    var ch1: [i64; 8] = [0; 8]
    var ch2: [i64; 8] = [0; 8]
    var ch3: [i64; 8] = [0; 8]
    var i: i64 = 0
    while i < 64 {
        ckind[i] = pack[i]
        carg1[i] = pack[64 + i]
        carg2[i] = pack[128 + i]
        i = i + 1
    }
    i = 0
    while i < 512 {
        exid[i] = pack[192 + i]
        i = i + 1
    }
    i = 0
    while i < 8 {
        ch1[i] = chains[i]
        ch2[i] = chains[8 + i]
        ch3[i] = chains[16 + i]
        i = i + 1
    }
    var nchain: i64 = dims[0]
    var nc: i64 = dims[1]
    var nb: i64 = dims[2]
    var nr: i64 = dims[3]
    var changed = true
    var rounds: i64 = 0
    var a: i64 = 0
    var k: i64 = 0
    var d: i64 = 0
    var c: i64 = 0
    var rr: i64 = 0
    var ss: i64 = 0
    var f: i64 = 0
    var d2: i64 = 0
    var f2: i64 = 0
    var x: i64 = 0
    var idx: i64 = 0
    var r1: i64 = 0
    var r2: i64 = 0
    var r3: i64 = 0
    while changed {
        changed = false
        rounds = rounds + 1

        // (T) transitivity on S
        a = 0
        while a < nc {
            k = 0
            while k < nc {
                if s[a * ELPLUS_MAXC + k] {
                    d = 0
                    while d < nc {
                        if s[k * ELPLUS_MAXC + d] && !s[a * ELPLUS_MAXC + d] {
                            s[a * ELPLUS_MAXC + d] = true
                            changed = true
                        }
                        d = d + 1
                    }
                }
                k = k + 1
            }
            a = a + 1
        }

        // (CE) conjunction elimination and (CI) introduction (kind 2)
        a = 0
        while a < nc {
            d = 0
            while d < nc {
                if ckind[d] == 2 {
                    if s[a * ELPLUS_MAXC + d] {
                        if !s[a * ELPLUS_MAXC + carg1[d]] {
                            s[a * ELPLUS_MAXC + carg1[d]] = true
                            changed = true
                        }
                        if !s[a * ELPLUS_MAXC + carg2[d]] {
                            s[a * ELPLUS_MAXC + carg2[d]] = true
                            changed = true
                        }
                    }
                    if s[a * ELPLUS_MAXC + carg1[d]] && s[a * ELPLUS_MAXC + carg2[d]] {
                        if !s[a * ELPLUS_MAXC + d] {
                            s[a * ELPLUS_MAXC + d] = true
                            changed = true
                        }
                    }
                }
                d = d + 1
            }
            a = a + 1
        }

        // (S2R) stoR: C <= ex r.D becomes edge (r, C, D)
        a = 0
        while a < nc {
            d = 0
            while d < nc {
                if ckind[d] == 3 && s[a * ELPLUS_MAXC + d] {
                    idx = (carg1[d] * ELPLUS_MAXC + a) * ELPLUS_MAXC + carg2[d]
                    if !r[idx] {
                        r[idx] = true
                        changed = true
                    }
                }
                d = d + 1
            }
            a = a + 1
        }

        // (RM) Rmono: edge (r,C,D) and D <= D' give (r,C,D'), D' base
        rr = 0
        while rr < nr {
            c = 0
            while c < nc {
                f = 0
                while f < nb {
                    if r[(rr * ELPLUS_MAXC + c) * ELPLUS_MAXC + f] {
                        d2 = 0
                        while d2 < nb {
                            if s[f * ELPLUS_MAXC + d2] && exid[rr * ELPLUS_MAXC + d2] >= 0 {
                                idx = (rr * ELPLUS_MAXC + c) * ELPLUS_MAXC + d2
                                if !r[idx] {
                                    r[idx] = true
                                    changed = true
                                }
                            }
                            d2 = d2 + 1
                        }
                    }
                    f = f + 1
                }
                c = c + 1
            }
            rr = rr + 1
        }

        // (RS) roleSub: edge (r,C,D) and r <=* s (rclos) give (s,C,D)
        rr = 0
        while rr < nr {
            ss = 0
            while ss < nr {
                if rclos[rr * ELPLUS_MAXR + ss] {
                    c = 0
                    while c < nc {
                        f = 0
                        while f < nb {
                            if r[(rr * ELPLUS_MAXC + c) * ELPLUS_MAXC + f] && exid[ss * ELPLUS_MAXC + f] >= 0 {
                                idx = (ss * ELPLUS_MAXC + c) * ELPLUS_MAXC + f
                                if !r[idx] {
                                    r[idx] = true
                                    changed = true
                                }
                            }
                            f = f + 1
                        }
                        c = c + 1
                    }
                }
                ss = ss + 1
            }
            rr = rr + 1
        }

        // (RC) roleComp: edges (r1,C,D) and (r2,D,E) with chain
        // r1 o r2 <= r3 give (r3,C,E)
        k = 0
        while k < nchain {
            r1 = ch1[k]
            r2 = ch2[k]
            r3 = ch3[k]
            c = 0
            while c < nc {
                f = 0
                while f < nb {
                    if r[(r1 * ELPLUS_MAXC + c) * ELPLUS_MAXC + f] {
                        f2 = 0
                        while f2 < nb {
                            if r[(r2 * ELPLUS_MAXC + f) * ELPLUS_MAXC + f2] && exid[r3 * ELPLUS_MAXC + f2] >= 0 {
                                idx = (r3 * ELPLUS_MAXC + c) * ELPLUS_MAXC + f2
                                if !r[idx] {
                                    r[idx] = true
                                    changed = true
                                }
                            }
                            f2 = f2 + 1
                        }
                    }
                    f = f + 1
                }
                c = c + 1
            }
            k = k + 1
        }

        // (R2S) RtoS: edge (r,C,D) gives C <= ex r.D
        rr = 0
        while rr < nr {
            c = 0
            while c < nc {
                f = 0
                while f < nb {
                    if r[(rr * ELPLUS_MAXC + c) * ELPLUS_MAXC + f] {
                        x = exid[rr * ELPLUS_MAXC + f]
                        if x >= 0 && !s[c * ELPLUS_MAXC + x] {
                            s[c * ELPLUS_MAXC + x] = true
                            changed = true
                        }
                    }
                    f = f + 1
                }
                c = c + 1
            }
            rr = rr + 1
        }
    }
    return rounds
}

/// Count the set cells of a subsumption matrix (restricted to the
/// nc x nc used region).
///
/// # Complexity
/// O(nc^2)
pub fn elplus_s_count(s: &[bool; 4096], nc: i64) -> i64 with Div, Panic {
    var n: i64 = 0
    var a: i64 = 0
    while a < nc {
        var b: i64 = 0
        while b < nc {
            if s[a * ELPLUS_MAXC + b] {
                n = n + 1
            }
            b = b + 1
        }
        a = a + 1
    }
    return n
}

/// Count the set cells of the role-edge cube (restricted to the used
/// nr x nc x nb region).
///
/// # Complexity
/// O(nr*nc*nb)
pub fn elplus_r_count(r: &[bool; 32768], nr: i64, nc: i64, nb: i64) -> i64 with Div, Panic {
    var n: i64 = 0
    var rr: i64 = 0
    while rr < nr {
        var c: i64 = 0
        while c < nc {
            var f: i64 = 0
            while f < nb {
                if r[(rr * ELPLUS_MAXC + c) * ELPLUS_MAXC + f] {
                    n = n + 1
                }
                f = f + 1
            }
            c = c + 1
        }
        rr = rr + 1
    }
    return n
}

/// Dense closure query: does concept `a` subsume to concept `b` in a
/// CLOSED dense subsumption matrix (output of `elplus_fixpoint`)?
/// Dense counterpart of `elplus_subsumes_sparse`; read-only accessor so
/// adapters (e.g. ontology::biomedical::snomed) never reimplement the
/// row-major indexing.
///
/// # Complexity
/// O(1)
pub fn elplus_subsumes_dense(s: &[bool; 4096], a: i64, b: i64) -> bool with Div, Panic {
    return s[a * ELPLUS_MAXC + b]
}

/// Dense role-edge query: does concept `c` have a derived role edge
/// (role, c, f) in the CLOSED dense role-edge cube (output of
/// `elplus_fixpoint`)?  Dense counterpart of `elplus_edge_sparse`.
///
/// # Complexity
/// O(1)
pub fn elplus_edge_dense(r: &[bool; 32768], role: i64, c: i64, f: i64) -> bool with Div, Panic {
    return r[(role * ELPLUS_MAXC + c) * ELPLUS_MAXC + f]
}

/// DERIVE conflict between two concepts from a closed subsumption matrix
/// and an atomic disjointness matrix: conflict(a, b) iff there exist
/// d1, d2 with s[a][d1], s[b][d2] and disj[d1][d2].
///
/// # References
/// - formal/OntologyELPlusClosureComplete.lean, theorem
///   `conflictBPlusC_iff`: this boolean oracle IS the deductive
///   conflict relation.
///
/// # Complexity
/// O(nc^2)
pub fn elplus_conflict(s: &[bool; 4096], disj: &[bool; 4096], nc: i64, a: i64, b: i64) -> bool with Div, Panic {
    var hit = false
    var d1: i64 = 0
    while d1 < nc {
        if s[a * ELPLUS_MAXC + d1] {
            var d2: i64 = 0
            while d2 < nc {
                if s[b * ELPLUS_MAXC + d2] && disj[d1 * ELPLUS_MAXC + d2] {
                    hit = true
                }
                d2 = d2 + 1
            }
        }
        d1 = d1 + 1
    }
    return hit
}

// ── Repair-integration exports ─────────────────────────────────────────
// Mapping-pair matrices use the same 256 stride as
// ontology::closure::derive_conflicts, so the repair module
// (ontology::repair) plugs into the EL+-derived oracle unchanged.

// Maximum number of candidate mappings for conflict derivation.
const ELPLUS_MAXM: i64 = 256

/// DERIVE the conflict relation between candidate mappings from a CLOSED
/// EL+ subsumption matrix (output of `elplus_fixpoint`) and a
/// disjointness matrix over the interned concept universe — the
/// role-aware counterpart of ontology::closure::derive_conflicts.
///
/// Mapping k asserts entity `ent[k]` under concept `cls[k]`.  Mappings
/// a, b conflict iff they assert the SAME entity and
/// `elplus_conflict(s, disj, nc, cls[a], cls[b])`, i.e. their asserted
/// concepts reach a disjoint pair through the EL+ closure (roles
/// included: existential targets produced by stoR/RtoS/Rmono/roleSub/
/// roleComp participate via the interned concept rows of `s`).
///
/// The result is symmetric: `conf_pair[a * 256 + b]` and
/// `conf_pair[b * 256 + a]` are both set (diagonal excluded).
///
/// # Parameters
/// - `conf_pair`: flattened m x m output matrix (fully overwritten).
/// - `m`: number of mappings (0 <= m <= 256).
/// - `ent`: entity id asserted by each mapping (index < m used).
/// - `cls`: concept id under which each mapping asserts its entity.
/// - `s`: closed EL+ subsumption matrix (from `elplus_fixpoint`).
/// - `disj`: disjointness matrix over the interned universe (symmetric).
/// - `nc`: number of interned concepts (0 <= nc <= 64).
///
/// # Complexity
/// O(m^2 * nc^2)
///
/// # References
/// - formal/OntologyELPlusClosureComplete.lean, theorem
///   `conflictBPlusC_iff`: the boolean conflict oracle IS the deductive
///   conflict relation over conceptUniv.
pub fn elplus_derive_conflicts(
    conf_pair: &![bool; 65536],
    m: i64,
    ent: &[i64; 256],
    cls: &[i64; 256],
    s: &[bool; 4096],
    disj: &[bool; 4096],
    nc: i64
) with Mut, Div, Panic {
    var i: i64 = 0
    while i < m {
        var j: i64 = 0
        while j < m {
            conf_pair[i * ELPLUS_MAXM + j] = false
            if i != j {
                if ent[i] == ent[j] {
                    if elplus_conflict(s, disj, nc, cls[i], cls[j]) {
                        conf_pair[i * ELPLUS_MAXM + j] = true
                    }
                }
            }
            j = j + 1
        }
        i = i + 1
    }
}

// ── Wide dense accessors (256 / 16 layout; out-of-range arguments are
//    answered "no", never read out of bounds) ─────────────────────────────

/// Wide closure query: does concept `a` subsume to `b` in a CLOSED wide
/// subsumption matrix?  False when a or b is outside 0..256.
///
/// # Complexity
/// O(1)
pub fn elplus_wide_subsumes(s: &[bool; 65536], a: i64, b: i64) -> bool with Div, Panic {
    if a < 0 || a >= 256 || b < 0 || b >= 256 { return false }
    return s[a * 256 + b]
}

/// Wide role-edge query: derived edge (role, c, f) in a CLOSED wide
/// role-edge cube?  False when an argument is out of range.
///
/// # Complexity
/// O(1)
pub fn elplus_wide_edge(r: &[bool; 1048576], role: i64, c: i64, f: i64) -> bool with Div, Panic {
    if role < 0 || role >= 16 || c < 0 || c >= 256 || f < 0 || f >= 256 { return false }
    return r[(role * 256 + c) * 256 + f]
}

/// Count the set cells of the used nc x nc region of a wide subsumption
/// matrix (nc clamped to 0..256).
///
/// # Complexity
/// O(nc^2)
pub fn elplus_wide_s_count(s: &[bool; 65536], nc: i64) -> i64 with Div, Panic {
    var n: i64 = 0
    var lim: i64 = nc
    if lim > 256 { lim = 256 }
    var a: i64 = 0
    while a < lim {
        var b: i64 = 0
        while b < lim {
            if s[a * 256 + b] {
                n = n + 1
            }
            b = b + 1
        }
        a = a + 1
    }
    return n
}

/// Count the set cells of the used nr x nc x nb region of a wide role-edge
/// cube (each bound clamped to its capacity).
///
/// # Complexity
/// O(nr*nc*nb)
pub fn elplus_wide_r_count(r: &[bool; 1048576], nr: i64, nc: i64, nb: i64) -> i64 with Div, Panic {
    var n: i64 = 0
    var lr: i64 = nr
    var lc: i64 = nc
    var lb: i64 = nb
    if lr > 16 { lr = 16 }
    if lc > 256 { lc = 256 }
    if lb > 256 { lb = 256 }
    var rr: i64 = 0
    while rr < lr {
        var c: i64 = 0
        while c < lc {
            var f: i64 = 0
            while f < lb {
                if r[(rr * 256 + c) * 256 + f] {
                    n = n + 1
                }
                f = f + 1
            }
            c = c + 1
        }
        rr = rr + 1
    }
    return n
}

/// Wide conflict: exist d1, d2 with s[a][d1], s[b][d2] and disj[d1][d2]
/// (wide counterpart of `elplus_conflict`).  False when a, b or nc is out of
/// range.
///
/// # Complexity
/// O(nc^2)
pub fn elplus_wide_conflict(s: &[bool; 65536], disj: &[bool; 65536], nc: i64, a: i64, b: i64) -> bool with Div, Panic {
    if nc < 0 || nc > 256 { return false }
    if a < 0 || a >= 256 || b < 0 || b >= 256 { return false }
    var hit = false
    var d1: i64 = 0
    while d1 < nc {
        if s[a * 256 + d1] {
            var d2: i64 = 0
            while d2 < nc {
                if s[b * 256 + d2] && disj[d1 * 256 + d2] {
                    hit = true
                }
                d2 = d2 + 1
            }
        }
        d1 = d1 + 1
    }
    return hit
}

/// Wide counterpart of `elplus_derive_conflicts`: same mapping stride
/// (256, at most 256 mappings) and output shape, over a CLOSED wide
/// subsumption matrix and a wide disjointness matrix (stride 256).  Returns
/// 0, or 1 (nothing written) when m or nc is out of range or a concept id
/// of a mapping is outside 0..256.
///
/// # Complexity
/// O(m^2 * nc^2)
pub fn elplus_wide_derive_conflicts(
    conf_pair: &![bool; 65536],
    m: i64,
    ent: &[i64; 256],
    cls: &[i64; 256],
    s: &[bool; 65536],
    disj: &[bool; 65536],
    nc: i64
) -> i64 with Mut, Div, Panic {
    if m < 0 || m > 256 || nc < 0 || nc > 256 { return 1 }
    var q: i64 = 0
    while q < m {
        if cls[q] < 0 || cls[q] >= 256 { return 1 }
        q = q + 1
    }
    var i: i64 = 0
    while i < m {
        var j: i64 = 0
        while j < m {
            conf_pair[i * 256 + j] = false
            if i != j {
                if ent[i] == ent[j] {
                    if elplus_wide_conflict(s, disj, nc, cls[i], cls[j]) {
                        conf_pair[i * 256 + j] = true
                    }
                }
            }
            j = j + 1
        }
        i = i + 1
    }
    return 0
}

// ── Sparse variant (scale; Anatomy profile: no conjunctions, single
//    active role, no role hierarchy/composition) ────────────────────────
//
// The two workspace matrices are module-level: functions here mutate
// their own module globals, the pattern the generated data modules rely
// on (init_chunk_* functions). (This was first forced by a `&!`
// miscompile of module arrays, round 9 bisect; that no longer reproduces,
// 16M-word arrays across a module boundary included:
// tests/run-pass/module_array_mut_ref.sio.)
//
// elplus_emat plays a double role: it is seeded with the stated-filler
// unions (e[c] |= clos[f] for each stated edge (c, f)) and then expanded
// IN PLACE (e[c] |= e[a] for every ancestor a of c).  A single in-place
// pass in any class order is NOT exact: if c is processed before one of
// its ancestors a, and a's own ancestors have not yet been folded into
// e[a], then e[c] misses seed[a'].  Iteration to fixpoint is required
// unless class ids are topologically sorted (ancestors before
// descendants), so the pass computes exactly
//   e[c] = union over ancestors a of c of seed[a].

/// Sparse closure matrix: clos[c*4096 + d] = class c subsumes to d
/// (columns 0..w-1; column w-1 is the top slot).
pub var elplus_clos: [bool; 16777216] = [false; 16777216]

/// Sparse role-edge filler matrix: after seeding + expansion,
/// elplus_emat[c*4096 + f] = class c has a derived role edge with
/// filler f (f base; column w-1 = existential onto top).
pub var elplus_emat: [bool; 16777216] = [false; 16777216]

/// Fixup writes for the garbage leading cells of the two module-level
/// splat matrices (known compiler pitfall: cells 0..2 of module-level
/// bool splat arrays can be dirty).  Call once before any other sparse
/// function.
pub fn elplus_sparse_init_mats() with Mut, Div, Panic {
    elplus_clos[0] = false
    elplus_clos[1] = false
    elplus_clos[2] = false
    elplus_emat[0] = false
    elplus_emat[1] = false
    elplus_emat[2] = false
}

/// Build a packed parent adjacency (counting sort) from packed sub edges
/// child*10000+parent.  After the call, the parents of class c are
/// plist[poff[c] .. poff[c+1]-1].
///
/// # Parameters
/// - `pack`: packed edges (index < ne used; ids must be < 10000).
/// - `ne`: number of edges (0 <= ne <= 4096).
/// - `poff`: offsets output, size h+1 (fully overwritten for 0..h).
/// - `pcount`: scratch cursor array (overwritten).
/// - `plist`: adjacency output (first ne cells overwritten).
/// - `h`: number of classes (0 <= h <= 4096).
///
/// # Complexity
/// O(h + ne)
pub fn elplus_sparse_build_adj(pack: &[i64; 4096], ne: i64, poff: &![i64; 4097], pcount: &![i64; 4096], plist: &![i64; 4096], h: i64) with Mut, Div, Panic {
    var c: i64 = 0
    while c <= h {
        poff[c] = 0
        c = c + 1
    }
    var e: i64 = 0
    while e < ne {
        c = pack[e] / 10000
        poff[c + 1] = poff[c + 1] + 1
        e = e + 1
    }
    c = 0
    while c < h {
        poff[c + 1] = poff[c + 1] + poff[c]
        c = c + 1
    }
    c = 0
    while c < h {
        pcount[c] = poff[c]
        c = c + 1
    }
    e = 0
    while e < ne {
        c = pack[e] / 10000
        plist[pcount[c]] = pack[e] - c * 10000
        pcount[c] = pcount[c] + 1
        e = e + 1
    }
}

/// Per-class BFS over the packed parent adjacency: fills the clos rows
/// of every class c < h with its subsumption ancestors (reflexive), sets
/// the top column (index w-1) of every row, and sets the top row
/// (row w-1) to {top}.  Returns the atom closure edge count (reflexive
/// ancestors, excluding the top column).
///
/// # Parameters
/// - `poff`, `plist`: parent adjacency from `elplus_sparse_build_adj`.
/// - `vis`, `queue`: scratch arrays (overwritten).
/// - `h`: number of classes (0 <= h <= 4095).
/// - `w`: matrix width used (h + 1; the top slot is index w-1).
///
/// # Complexity
/// O(sum_c |ancestors(c)| + h)
pub fn elplus_sparse_bfs(poff: &[i64; 4097], plist: &[i64; 4096], vis: &![i64; 4096], queue: &![i64; 4096], h: i64, w: i64) -> i64 with Mut, Div, Panic {
    var total: i64 = 0
    var s: i64 = 0
    var head: i64 = 0
    var tail: i64 = 0
    var b: i64 = 0
    var t: i64 = 0
    var p: i64 = 0
    while s < h {
        head = 0
        tail = 0
        queue[tail] = s
        tail = tail + 1
        vis[s] = s + 1
        elplus_clos[s * ELPLUS_SC + s] = true
        while head < tail {
            b = queue[head]
            head = head + 1
            t = poff[b]
            while t < poff[b + 1] {
                p = plist[t]
                if vis[p] != s + 1 {
                    vis[p] = s + 1
                    queue[tail] = p
                    tail = tail + 1
                    elplus_clos[s * ELPLUS_SC + p] = true
                }
                t = t + 1
            }
        }
        total = total + tail
        elplus_clos[s * ELPLUS_SC + w - 1] = true
        s = s + 1
    }
    elplus_clos[(w - 1) * ELPLUS_SC + w - 1] = true
    return total
}

/// Seed the role-edge filler matrix with the stated existential edges:
/// e[c] |= clos[f] for every stated edge (c, f) (role dimension
/// collapsed; valid for the Anatomy profile where all stated
/// restrictions use the single active role).  Cells are only ever set —
/// call `elplus_sparse_init_mats` first.
///
/// # Complexity
/// O(nex * w)
pub fn elplus_sparse_seed_edges(exc: &[i64; 4096], exf: &[i64; 4096], nex: i64, w: i64) with Mut, Div, Panic {
    var k: i64 = 0
    var c: i64 = 0
    var f: i64 = 0
    var j: i64 = 0
    while k < nex {
        c = exc[k]
        f = exf[k]
        j = 0
        while j < w {
            if elplus_clos[f * ELPLUS_SC + j] {
                elplus_emat[c * ELPLUS_SC + j] = true
            }
            j = j + 1
        }
        k = k + 1
    }
}

/// Ancestor expansion of the role-edge fillers to fixpoint:
/// e[c] |= e[a] for every ancestor a of c, iterated until stable.
/// A single arbitrary-order pass is NOT exact (see the math-review note);
/// iteration is required unless class ids are topologically sorted.
/// This is the least fixpoint of stoR + RtoS + transitivity + Rmono for
/// the Anatomy profile.
///
/// # Complexity
/// O(passes * h^2 + (sum_c |ancestors(c)|) * w); passes ≤ h + 1.
pub fn elplus_sparse_expand(h: i64, w: i64) with Mut, Div, Panic {
    var c: i64 = 0
    var a: i64 = 0
    var j: i64 = 0
    var changed: bool = true
    while changed {
        changed = false
        c = 0
        while c < h {
            a = 0
            while a < h {
                if elplus_clos[c * ELPLUS_SC + a] {
                    j = 0
                    while j < w {
                        if elplus_emat[a * ELPLUS_SC + j] && !elplus_emat[c * ELPLUS_SC + j] {
                            elplus_emat[c * ELPLUS_SC + j] = true
                            changed = true
                        }
                        j = j + 1
                    }
                }
                a = a + 1
            }
            c = c + 1
        }
    }
}

/// Sparse closure query: does class `c` subsume to `d` (columns
/// 0..w-1 of the workspace closure matrix; column w-1 is the top slot)?
/// Read-only accessor; repair drivers use this in place of direct closure-matrix indexing.
///
/// # Complexity
/// O(1)
pub fn elplus_subsumes_sparse(c: i64, d: i64) -> bool with Div, Panic {
    return elplus_clos[c * ELPLUS_SC + d]
}

/// Sparse role-edge query: does class `c` have a derived role edge with
/// filler `f` (after `elplus_sparse_seed_edges` + `elplus_sparse_expand`)?
/// Column w-1 means an existential onto top.
///
/// # Complexity
/// O(1)
pub fn elplus_edge_sparse(c: i64, f: i64) -> bool with Div, Panic {
    return elplus_emat[c * ELPLUS_SC + f]
}

/// Count the set cells of one workspace matrix row (columns 0..w-1).
///
/// # Parameters
/// - `which`: 0 for the closure matrix, anything else for the role-edge
///   filler matrix.
/// - `row`: row index (0 <= row < w).
///
/// # Complexity
/// O(w)
pub fn elplus_sparse_row_count(which: i64, row: i64, w: i64) -> i64 with Div, Panic {
    var n: i64 = 0
    var j: i64 = 0
    if which == 0 {
        while j < w {
            if elplus_clos[row * ELPLUS_SC + j] {
                n = n + 1
            }
            j = j + 1
        }
    } else {
        while j < w {
            if elplus_emat[row * ELPLUS_SC + j] {
                n = n + 1
            }
            j = j + 1
        }
    }
    return n
}
