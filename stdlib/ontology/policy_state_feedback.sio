// Experimental ontology for proof-carrying policy-state feedback.
// Sibling classes encode non-subsumption, not OWL disjointness.

ontology PolicyStateFeedback {
    class EpistemicArtifact

    class ObservationArtifact subclass_of EpistemicArtifact
    class ObservedAnchorValue subclass_of ObservationArtifact
    class ObservedTargetValue subclass_of ObservationArtifact
    class ExogenousCoverageProbe subclass_of ObservationArtifact

    class PolicyArtifact subclass_of EpistemicArtifact
    class PolicyStateSummary subclass_of PolicyArtifact
    class AdaptivePolicyDecision subclass_of PolicyArtifact
    class PolicyWithholding subclass_of PolicyArtifact
    class PolicyErasedFeedbackTrace subclass_of PolicyArtifact

    class CoverageArtifact subclass_of EpistemicArtifact
    class PolicyCoverageGap subclass_of CoverageArtifact
    class StatisticalPositivityReceipt subclass_of CoverageArtifact
    class PolicyComparisonNonidentification subclass_of CoverageArtifact

    class InferenceArtifact subclass_of EpistemicArtifact
    class PolicyInducedTargetAmbiguity subclass_of InferenceArtifact
    class BoundedPolicyStateFeedback subclass_of InferenceArtifact
    class WithinFamilyTargetIdentification subclass_of InferenceArtifact
    class CausalFeedbackMechanismReceipt subclass_of InferenceArtifact
    class OffPolicyValueIdentificationReceipt subclass_of InferenceArtifact
    class ClinicalPolicyAuthorityReceipt subclass_of InferenceArtifact

    class BudgetArtifact subclass_of EpistemicArtifact
    class DeclaredSyntheticObservationBudget subclass_of BudgetArtifact
    class BudgetExceededObservationAction subclass_of BudgetArtifact
    class ConsentReceipt subclass_of BudgetArtifact
    class EthicsApprovalReceipt subclass_of BudgetArtifact
    class SubjectiveSufferingReceipt subclass_of BudgetArtifact

    role summarized_by domain ObservationArtifact range PolicyStateSummary
    role governs domain AdaptivePolicyDecision range ObservationArtifact
    role creates_gap domain PolicyWithholding range PolicyCoverageGap
    role supports domain ExogenousCoverageProbe range WithinFamilyTargetIdentification
    role constrained_by domain PolicyArtifact range DeclaredSyntheticObservationBudget
    role precedes transitive
}

fn accept_observation(a: ObservationArtifact) -> i32 { 0 }
fn accept_policy(p: PolicyArtifact) -> i32 { 0 }
fn accept_coverage(c: CoverageArtifact) -> i32 { 0 }
fn accept_inference(i: InferenceArtifact) -> i32 { 0 }
fn accept_budget(b: BudgetArtifact) -> i32 { 0 }

fn target_is_observation(v: ObservedTargetValue) -> i32 { accept_observation(v) }
fn withholding_is_policy(w: PolicyWithholding) -> i32 { accept_policy(w) }
fn gap_is_coverage(g: PolicyCoverageGap) -> i32 { accept_coverage(g) }
fn ambiguity_is_inference(a: PolicyInducedTargetAmbiguity) -> i32 { accept_inference(a) }
fn refusal_is_budget(r: BudgetExceededObservationAction) -> i32 { accept_budget(r) }
