// stdlib/ontology/terminology.sio
//
// Standard Biomedical Terminology Constants
//
// SNOMED CT concept codes and ICD-10 chapter boundary codes as named constants.
// All codes are integer IDs matching SNOMED CT numeric concept identifiers
// and ICD-10 chapter ranges.
//
// References:
//   SNOMED International — SNOMED CT Browser https://browser.ihtsdotools.org/
//   WHO ICD-10 — https://icd.who.int/browse10/2019/en
//   SNOMED CT Concept Model v3.0 (2022)

// ============================================================================
// SNOMED CT CONCEPT CODES
// ============================================================================
// Representative top-level and high-frequency SNOMED CT concepts.
// Source: SNOMED CT International Release (January 2024), US Edition.

// Hierarchy roots — SNOMED CT top-level concepts
pub const SNOMED_CLINICAL_FINDING: i64         = 404684003  // Clinical finding
pub const SNOMED_PROCEDURE: i64                = 71388002   // Procedure
pub const SNOMED_OBSERVABLE_ENTITY: i64        = 363787002  // Observable entity
pub const SNOMED_BODY_STRUCTURE: i64           = 123037004  // Body structure
pub const SNOMED_ORGANISM: i64                 = 410607006  // Organism
pub const SNOMED_SUBSTANCE: i64                = 105590001  // Substance
pub const SNOMED_PHARMACEUTICAL: i64           = 373873005  // Pharmaceutical / biologic product
pub const SNOMED_PHYSICAL_OBJECT: i64          = 260787004  // Physical object
pub const SNOMED_PHYSICAL_FORCE: i64           = 78621006   // Physical force
pub const SNOMED_EVENT: i64                    = 272379006  // Event

// Common disorders
pub const SNOMED_DISORDER: i64                 = 64572001   // Disease (disorder)
pub const SNOMED_INFECTIOUS_DISEASE: i64       = 40733004   // Infectious disease
pub const SNOMED_NEOPLASM: i64                 = 108369006  // Neoplasm (morphologic abnormality)
pub const SNOMED_CARDIOVASCULAR_DISORDER: i64  = 49601007   // Disorder of cardiovascular system
pub const SNOMED_RESPIRATORY_DISORDER: i64     = 50043002   // Disorder of respiratory system

// Common findings
pub const SNOMED_FEVER: i64                    = 386661006  // Fever (finding)
pub const SNOMED_PAIN: i64                     = 22253000   // Pain (finding)
pub const SNOMED_DYSPNEA: i64                  = 230145002  // Difficulty breathing (finding)
pub const SNOMED_HYPERTENSION: i64             = 38341003   // Hypertensive disorder

// Common procedures
pub const SNOMED_SURGICAL_PROCEDURE: i64       = 387713003  // Surgical procedure (procedure)

// ============================================================================
// ICD-10 CHAPTER BOUNDARY CODES
// ============================================================================
// ICD-10 uses alphanumeric codes. Here we encode chapter boundaries as
// (start, end) pairs where each code character range is represented as
// a pair of integer constants encoding the ASCII ordinal of the first letter
// and the numeric range.
//
// Encoding: ICD10_CHx_START / ICD10_CHx_END = chapter x boundary code
// as a composite: letter_ord * 1000 + numeric_range_start
// Example: A00 → 65*1000 + 0 = 65000

// Chapter I: Certain infectious and parasitic diseases (A00–B99)
pub const ICD10_CH1_START: i64  = 65000  // A00
pub const ICD10_CH1_END: i64    = 66999  // B99

// Chapter II: Neoplasms (C00–D49)
pub const ICD10_CH2_START: i64  = 67000  // C00
pub const ICD10_CH2_END: i64    = 68049  // D49 (approx — D is 68)

// Chapter III: Diseases of blood and blood-forming organs (D50–D89)
pub const ICD10_CH3_START: i64  = 68050  // D50
pub const ICD10_CH3_END: i64    = 68089  // D89

// Chapter IV: Endocrine, nutritional and metabolic diseases (E00–E89)
pub const ICD10_CH4_START: i64  = 69000  // E00
pub const ICD10_CH4_END: i64    = 69089  // E89

// Chapter V: Mental and behavioural disorders (F00–F99)
pub const ICD10_CH5_START: i64  = 70000  // F00
pub const ICD10_CH5_END: i64    = 70099  // F99

// Chapter VI: Diseases of the nervous system (G00–G99)
pub const ICD10_CH6_START: i64  = 71000  // G00
pub const ICD10_CH6_END: i64    = 71099  // G99

// Chapter VII: Diseases of the eye and adnexa (H00–H59)
pub const ICD10_CH7_START: i64  = 72000  // H00
pub const ICD10_CH7_END: i64    = 72059  // H59

// Chapter VIII: Diseases of the ear and mastoid process (H60–H95)
pub const ICD10_CH8_START: i64  = 72060  // H60
pub const ICD10_CH8_END: i64    = 72095  // H95

// Chapter IX: Diseases of the circulatory system (I00–I99)
pub const ICD10_CH9_START: i64  = 73000  // I00
pub const ICD10_CH9_END: i64    = 73099  // I99

// Chapter X: Diseases of the respiratory system (J00–J99)
pub const ICD10_CH10_START: i64 = 74000  // J00
pub const ICD10_CH10_END: i64   = 74099  // J99

// ============================================================================
// SUBSUMPTION CHECK
// ============================================================================

// onto_is_a — transitive subsumption check using a flat parent array.
//
// Represents a concept hierarchy as a flat array where parent[i] = j means
// concept i directly subclasses concept j. Sentinel: parent[i] = i means root.
//
// The check walks the parent chain up to max_depth steps, returning true
// if parent is reached. This is the standard closure-following algorithm
// equivalent to the OWL SubClassOf axiom under rdfs:subClassOf transitivity.
//
// Parameters:
//   parents    — flat parent-pointer array (parents[i] = direct parent of i)
//   n_concepts — number of valid entries in parents
//   child      — index of the candidate subclass
//   parent     — index of the candidate superclass
//
// Returns: true iff child is-a parent (reflexive-transitive closure)
//
// Note on IC weighting for onto_distance:
//   The existing reasoner_wu_palmer_similarity uses graph depth as a proxy
//   for specificity. A richer approach is Information Content (IC) weighting
//   after Resnik (1995): IC(c) = -log(P(c)), where P(c) = freq(c)/freq(root).
//   IC-weighted similarity (Lin 1998): sim(c1,c2) = 2*IC(lcs) / (IC(c1)+IC(c2)).
//   TODO: integrate corpus frequency table to support IC-based onto_distance.
pub fn onto_is_a(parents: &[i64; 1024], n_concepts: i64,
                 child: i64, parent: i64) -> bool {
    // Reflexive: every concept is-a itself
    if child == parent {
        return true
    }

    if child < 0 || child >= n_concepts {
        return false
    }
    if parent < 0 || parent >= n_concepts {
        return false
    }

    // Walk parent chain
    var current = child
    let max_depth = n_concepts
    var steps = 0

    while steps < max_depth {
        let p = parents[current]
        if p == current {
            // Reached a root without finding parent
            return false
        }
        if p == parent {
            return true
        }
        if p < 0 || p >= n_concepts {
            return false
        }
        current = p
        steps = steps + 1
    }

    false
}
