// Parallel nominal ontology fixture for the D7 model protocol.
// It does not transport runtime kernel receipts or represent the compiler's
// private rebracketing capability. Siblings encode non-subsumption, not OWL
// disjointness.

ontology ProofCarryingRebracketingProtocol {
    class EpistemicArtifact

    class RebracketingDecisionArtifact subclass_of EpistemicArtifact
    class RebracketingRequest subclass_of RebracketingDecisionArtifact
    class LocalRebracketingEqualityDecision subclass_of RebracketingDecisionArtifact
    class RebracketingRefusal subclass_of RebracketingDecisionArtifact
    class CompilerAuthorityPromotionAbstention subclass_of RebracketingDecisionArtifact
    class LocalRebracketingModelReplay subclass_of RebracketingDecisionArtifact

    class RebracketingLawArtifact subclass_of EpistemicArtifact
    class LocalEqualityWitness subclass_of RebracketingLawArtifact
    class SemanticInequalityWitness subclass_of RebracketingLawArtifact
    class GlobalAssociativityLaw subclass_of RebracketingLawArtifact

    class RebracketingAuthorityClaimArtifact subclass_of EpistemicArtifact
    class CompilerRebracketingCapabilityClaim subclass_of RebracketingAuthorityClaimArtifact
    class SemanticCarrierRewriteClaim subclass_of RebracketingAuthorityClaimArtifact
    class ProofAssistantRebracketingTheorem subclass_of RebracketingAuthorityClaimArtifact

    class InterpretationArtifact subclass_of EpistemicArtifact
    class EmpiricalRebracketingEquivalence subclass_of InterpretationArtifact
    class CausalRebracketingMechanism subclass_of InterpretationArtifact
    class ClinicalRebracketingAction subclass_of InterpretationArtifact
    class RebracketingConsent subclass_of InterpretationArtifact
    class RebracketingSuffering subclass_of InterpretationArtifact

    role supports domain LocalEqualityWitness range LocalRebracketingEqualityDecision
    role blocks domain SemanticInequalityWitness range RebracketingRefusal
    role records domain LocalRebracketingEqualityDecision range LocalRebracketingModelReplay
    role abstains_from domain CompilerAuthorityPromotionAbstention range GlobalAssociativityLaw
    role refuses_capability domain CompilerAuthorityPromotionAbstention range CompilerRebracketingCapabilityClaim
}

fn accept_decision(v: RebracketingDecisionArtifact) -> i32 { 0 }
fn accept_law(v: RebracketingLawArtifact) -> i32 { 0 }
fn accept_authority_claim(v: RebracketingAuthorityClaimArtifact) -> i32 { 0 }
fn accept_interpretation(v: InterpretationArtifact) -> i32 { 0 }

fn local_is_decision(v: LocalRebracketingEqualityDecision) -> i32 {
    accept_decision(v)
}
fn refusal_is_decision(v: RebracketingRefusal) -> i32 { accept_decision(v) }
fn equality_is_law_evidence(v: LocalEqualityWitness) -> i32 { accept_law(v) }
fn compiler_capability_is_claim(v: CompilerRebracketingCapabilityClaim) -> i32 {
    accept_authority_claim(v)
}
fn empirical_is_interpretation(v: EmpiricalRebracketingEquivalence) -> i32 {
    accept_interpretation(v)
}
