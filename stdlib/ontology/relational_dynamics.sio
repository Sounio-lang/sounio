// Experimental ontology for bounded relational-dynamics models.
//
// These classes organize synthetic model artifacts. They do not assert that a
// person, therapeutic relationship, diagnosis, or biological mechanism has
// been observed. In particular, a participant state is not a dyadic state and
// a mathematical witness is not clinical authority.

ontology RelationalDynamics {
    class ModelArtifact
    class RelationalEntity subclass_of ModelArtifact
    class ParticipantState subclass_of ModelArtifact
    class DyadicRelationalState subclass_of RelationalEntity

    class RelationalProcess subclass_of ModelArtifact
    class MediatedHistory subclass_of RelationalProcess
    class GroupingSensitiveProcess subclass_of MediatedHistory
    class AssociativeControlProcess subclass_of MediatedHistory

    class GroupingStructure subclass_of ModelArtifact
    class LeftGroupedStructure subclass_of GroupingStructure
    class RightGroupedStructure subclass_of GroupingStructure
    class PredictiveStateExpansion subclass_of ModelArtifact

    class EpistemicReceipt subclass_of ModelArtifact
    class ObservationReceipt subclass_of EpistemicReceipt
    class BoundedAssociatorWitness subclass_of EpistemicReceipt
    class CausalMechanismReceipt subclass_of EpistemicReceipt
    class ClinicalAuthorityReceipt subclass_of EpistemicReceipt

    role has_participant domain RelationalProcess range ParticipantState
    role has_relational_state domain RelationalProcess range DyadicRelationalState
    role has_grouping domain MediatedHistory range GroupingStructure
    role has_predictive_expansion domain MediatedHistory range PredictiveStateExpansion
    role produces_observation domain RelationalProcess range ObservationReceipt
    role produces_witness domain GroupingSensitiveProcess range BoundedAssociatorWitness
    role precedes transitive
    role related_to symmetric
}

fn accept_relational_process(p: RelationalProcess) -> i32 { 0 }

fn grouping_sensitive_is_relational(p: GroupingSensitiveProcess) -> i32 {
    accept_relational_process(p)
}

fn associative_control_is_relational(p: AssociativeControlProcess) -> i32 {
    accept_relational_process(p)
}
