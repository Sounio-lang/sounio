//! stdlib/roots/lib.sio - Root finding algorithms
//!
//! Provides numerical methods for finding roots of equations:
//! - Bisection method (bracketing, guaranteed convergence)
//! - Newton-Raphson method (fast convergence with derivative)
//! - Secant method (fast, no derivative needed)
//! - Fixed-point iteration
//! - Brent's method (robust hybrid)
//!
//! Each method returns a RootResult with the root, iteration count, and convergence status.
//!
//! Function-index dispatch variants (bisection_id, newton_id, secant_id, brent_id)
//! use integer f_id to select from built-in test functions without function pointers.
//! These return RootResult2 which carries epistemic uncertainty from convergence tolerance.

// #1622: these were `extern "C"` bindings to libm. The native backend has no
// dynamic linker, so every call compiled to a stub returning 0. The builtin
// names it does implement (sqrt, exp, log, sin, cos) need no declaration.
use math::libm::{libm_fabs}
// Result of a root-finding algorithm
pub struct RootResult {
    root: f64,
    iterations: i32,
    converged: bool,
    function_value: f64,
}

// Create a successful root result
fn root_success(root: f64, iterations: i32, fval: f64) -> RootResult {
    RootResult { root: root, iterations: iterations, converged: true, function_value: fval }
}

// Create a failed root result
fn root_failure(root: f64, iterations: i32, fval: f64) -> RootResult {
    RootResult { root: root, iterations: iterations, converged: false, function_value: fval }
}

// =============================================================================
// BISECTION METHOD
// =============================================================================

// Bisection method for root finding.
//
// Finds a root of f(x) = 0 in the interval [a, b].
// Requires f(a) and f(b) to have opposite signs (bracket the root).
//
// Parameters:
// - a, b: Interval endpoints (must bracket the root)
// - tol: Tolerance for convergence (stops when |b-a| < tol)
// - max_iter: Maximum number of iterations
// - f: Function to find root of
//
// Convergence: Guaranteed if f is continuous and brackets are valid.
// Convergence rate: Linear (one bit of precision per iteration).
pub fn bisection(a: f64, b: f64, tol: f64, max_iter: i32, f: fn(f64) -> f64) -> RootResult with Div, Panic, Mut {
    var lo = a
    var hi = b
    var f_lo = f(lo)
    var f_hi = f(hi)

    // Check if endpoints bracket a root
    if f_lo * f_hi > 0.0 {
        return root_failure((lo + hi) / 2.0, 0, f_lo)
    }

    // Handle case where endpoint is already a root
    if f_lo == 0.0 {
        return root_success(lo, 0, 0.0)
    }
    if f_hi == 0.0 {
        return root_success(hi, 0, 0.0)
    }

    var iter = 0
    var mid = (lo + hi) / 2.0
    var f_mid = f(mid)

    while iter < max_iter {
        if libm_fabs(hi - lo) < tol {
            return root_success(mid, iter, f_mid)
        }

        mid = (lo + hi) / 2.0
        f_mid = f(mid)

        if libm_fabs(f_mid) < tol {
            return root_success(mid, iter + 1, f_mid)
        }

        if f_lo * f_mid < 0.0 {
            hi = mid
            f_hi = f_mid
        } else {
            lo = mid
            f_lo = f_mid
        }

        iter = iter + 1
    }

    root_failure(mid, iter, f_mid)
}

// =============================================================================
// NEWTON-RAPHSON METHOD
// =============================================================================

// Newton-Raphson method for root finding.
//
// Uses the iteration x_{n+1} = x_n - f(x_n) / f'(x_n)
//
// Parameters:
// - x0: Initial guess
// - tol: Tolerance for convergence (stops when |f(x)| < tol)
// - max_iter: Maximum number of iterations
// - f: Function to find root of
// - df: Derivative of f
//
// Convergence: Quadratic near simple roots (doubles precision each step).
// Warning: May diverge if starting point is far from root or derivative is small.
pub fn newton_raphson(x0: f64, tol: f64, max_iter: i32, f: fn(f64) -> f64, df: fn(f64) -> f64) -> RootResult with Div, Panic, Mut {
    var x = x0
    var iter = 0

    while iter < max_iter {
        let fx = f(x)

        if libm_fabs(fx) < tol {
            return root_success(x, iter, fx)
        }

        let dfx = df(x)

        // Check for zero derivative
        if dfx == 0.0 {
            return root_failure(x, iter, fx)
        }

        x = x - fx / dfx
        iter = iter + 1
    }

    let final_fx = f(x)
    root_failure(x, iter, final_fx)
}

// =============================================================================
// SECANT METHOD
// =============================================================================

// Secant method for root finding.
//
// Similar to Newton's method but approximates the derivative using finite differences:
// x_{n+1} = x_n - f(x_n) * (x_n - x_{n-1}) / (f(x_n) - f(x_{n-1}))
//
// Parameters:
// - x0, x1: Two initial guesses
// - tol: Tolerance for convergence
// - max_iter: Maximum number of iterations
// - f: Function to find root of
//
// Convergence: Superlinear (~1.618, the golden ratio).
// Advantage: Does not require derivative computation.
pub fn secant(x0: f64, x1: f64, tol: f64, max_iter: i32, f: fn(f64) -> f64) -> RootResult with Div, Panic, Mut {
    var x_prev = x0
    var x_curr = x1
    var f_prev = f(x_prev)
    var f_curr = f(x_curr)
    var iter = 0

    while iter < max_iter {
        if libm_fabs(f_curr) < tol {
            return root_success(x_curr, iter, f_curr)
        }

        let denom = f_curr - f_prev
        if denom == 0.0 {
            return root_failure(x_curr, iter, f_curr)
        }

        let x_next = x_curr - f_curr * (x_curr - x_prev) / denom

        x_prev = x_curr
        f_prev = f_curr
        x_curr = x_next
        f_curr = f(x_curr)

        iter = iter + 1
    }

    root_failure(x_curr, iter, f_curr)
}

// =============================================================================
// FIXED-POINT ITERATION
// =============================================================================

// Fixed-point iteration for solving x = g(x).
//
// Uses the iteration x_{n+1} = g(x_n)
// Converges to a fixed point x* where x* = g(x*).
//
// Parameters:
// - x0: Initial guess
// - tol: Tolerance for convergence (stops when |x_{n+1} - x_n| < tol)
// - max_iter: Maximum number of iterations
// - g: Iteration function (seeking fixed point of g)
//
// Convergence: Linear, requires |g'(x*)| < 1 near the fixed point.
// Note: To solve f(x) = 0, rewrite as x = x - c*f(x) for some constant c.
pub fn fixed_point(x0: f64, tol: f64, max_iter: i32, g: fn(f64) -> f64) -> RootResult with Div, Panic, Mut {
    var x = x0
    var iter = 0

    while iter < max_iter {
        let x_new = g(x)

        if libm_fabs(x_new - x) < tol {
            return root_success(x_new, iter + 1, x_new - g(x_new))
        }

        x = x_new
        iter = iter + 1
    }

    root_failure(x, iter, x - g(x))
}

// =============================================================================
// BRENT'S METHOD
// =============================================================================

// Brent's method for root finding.
//
// A robust hybrid method combining bisection, secant, and inverse quadratic interpolation.
// Guaranteed to converge like bisection but often achieves superlinear convergence.
//
// Parameters:
// - a, b: Interval endpoints (must bracket the root)
// - tol: Tolerance for convergence
// - max_iter: Maximum number of iterations
// - f: Function to find root of
//
// This is generally the best choice for bracketed root finding.
pub fn brent(a: f64, b: f64, tol: f64, max_iter: i32, f: fn(f64) -> f64) -> RootResult with Div, Panic, Mut {
    var lo = a
    var hi = b
    var f_lo = f(lo)
    var f_hi = f(hi)

    // Check bracket
    if f_lo * f_hi > 0.0 {
        return root_failure((lo + hi) / 2.0, 0, f_lo)
    }

    // Ensure |f(lo)| >= |f(hi)|
    if libm_fabs(f_lo) < libm_fabs(f_hi) {
        // Swap
        let tmp = lo
        lo = hi
        hi = tmp
        let tmp_f = f_lo
        f_lo = f_hi
        f_hi = tmp_f
    }

    var c = lo
    var f_c = f_lo
    var d = hi - lo
    var e = d

    var iter = 0
    while iter < max_iter {
        if libm_fabs(f_hi) < tol {
            return root_success(hi, iter, f_hi)
        }

        if libm_fabs(hi - lo) < tol {
            return root_success(hi, iter, f_hi)
        }

        var use_bisection = true
        var s = 0.0

        // Try inverse quadratic interpolation if we have 3 distinct points
        if f_lo != f_c && f_hi != f_c {
            // Inverse quadratic interpolation
            let r = f_hi / f_c
            let q = f_lo / f_c
            let p = f_hi / f_lo
            s = p * (q * (r - q) * (c - hi) - (1.0 - r) * (hi - lo)) / ((q - 1.0) * (r - 1.0) * (p - 1.0))
            s = hi + s
            use_bisection = false
        } else if f_lo != f_hi {
            // Secant method
            s = hi - f_hi * (hi - lo) / (f_hi - f_lo)
            use_bisection = false
        }

        // Check if interpolation is acceptable
        if !use_bisection {
            let cond1 = if lo < hi { s < lo || s > hi } else { s < hi || s > lo }
            let cond2 = libm_fabs(s - hi) >= libm_fabs(e) / 2.0
            if cond1 || cond2 {
                use_bisection = true
            }
        }

        if use_bisection {
            s = (lo + hi) / 2.0
            e = hi - lo
            d = e
        } else {
            e = d
            d = s - hi
        }

        // Update points
        c = hi
        f_c = f_hi

        let f_s = f(s)

        if f_lo * f_s < 0.0 {
            hi = s
            f_hi = f_s
        } else {
            lo = s
            f_lo = f_s
        }

        // Ensure |f(lo)| >= |f(hi)|
        if libm_fabs(f_lo) < libm_fabs(f_hi) {
            let tmp = lo
            lo = hi
            hi = tmp
            let tmp_f = f_lo
            f_lo = f_hi
            f_hi = tmp_f
        }

        iter = iter + 1
    }

    root_failure(hi, iter, f_hi)
}

// =============================================================================
// HELPER FUNCTIONS
// =============================================================================

// Halley's method - cubic convergence when second derivative is available
// x_{n+1} = x_n - 2*f*f' / (2*f'^2 - f*f'')
pub fn halley(x0: f64, tol: f64, max_iter: i32, f: fn(f64) -> f64, df: fn(f64) -> f64, d2f: fn(f64) -> f64) -> RootResult with Div, Panic, Mut {
    var x = x0
    var iter = 0

    while iter < max_iter {
        let fx = f(x)

        if libm_fabs(fx) < tol {
            return root_success(x, iter, fx)
        }

        let dfx = df(x)
        let d2fx = d2f(x)

        let denom = 2.0 * dfx * dfx - fx * d2fx
        if denom == 0.0 {
            return root_failure(x, iter, fx)
        }

        x = x - 2.0 * fx * dfx / denom
        iter = iter + 1
    }

    let final_fx = f(x)
    root_failure(x, iter, final_fx)
}

// =============================================================================
// FUNCTION-INDEX DISPATCH VARIANTS
// =============================================================================
//
// These variants take an f_id: i32 selecting from built-in test functions.
// They return RootResult2 which adds epistemic uncertainty (root_unc) from
// the convergence tolerance and the residual f_at_root.
//
// f_id table:
//   0 — f(x) = x²-2           f'(x) = 2x           (root = √2 ≈ 1.41421)
//   1 — f(x) = x³-x-1         f'(x) = 3x²-1        (root ≈ 1.32472)
//   2 — f(x) = cos(x)-x       f'(x) = -sin(x)-1    (root ≈ 0.73909)
//   3 — f(x) = exp(x)-3       f'(x) = exp(x)       (root = ln(3) ≈ 1.09861)

// Root result with epistemic uncertainty field
pub struct RootResult2 {
    pub root: f64,
    pub root_unc: f64,
    pub iterations: i32,
    pub converged: i32,
    pub f_at_root: f64,
}

// ---- inline pure-Sounio math helpers (no FFI) used by dispatch variants ----
// Newton-Raphson sqrt (20 iters)
fn rt_sqrt(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 20 {
        y = 0.5 * (y + x / y)
        i = i + 1
    }
    y
}

// |x|
fn rt_abs(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

// exp via range-reduction + Taylor (25 terms)
fn rt_exp(x: f64) -> f64 with Mut, Div, Panic {
    if x > 500.0 { return 1.0e200 }
    if x < -500.0 { return 0.0 }
    let ln2v = 0.6931471805599453
    var kf = x / ln2v
    var k: i32 = 0
    if kf >= 0.0 { k = kf as i32 } else { k = (kf as i32) - 1 }
    let r = x - (k as f64) * ln2v
    var s = 1.0
    var t = 1.0
    var n = 1
    while n < 25 {
        t = t * r / (n as f64)
        s = s + t
        n = n + 1
    }
    var result = s
    if k >= 0 {
        var i = 0
        while i < k { result = result * 2.0; i = i + 1 }
    } else {
        var i = 0
        while i < (0 - k) { result = result / 2.0; i = i + 1 }
    }
    result
}

// cos via Taylor (15 terms, range-reduced)
fn rt_cos(x: f64) -> f64 with Mut, Div, Panic {
    let pi_v = 3.14159265358979323846
    let twopi = 6.28318530717958647692
    var a = x
    while a >= twopi { a = a - twopi }
    while a < 0.0 { a = a + twopi }
    if a > pi_v { a = a - twopi }
    let a2 = a * a
    var sum = 1.0
    var term = 1.0
    var n = 1
    while n < 15 {
        term = 0.0 - term * a2 / ((2 * n - 1) * 2 * n) as f64
        sum = sum + term
        n = n + 1
    }
    sum
}

// sin(x) = cos(x - pi/2)
fn rt_sin(x: f64) -> f64 with Mut, Div, Panic {
    let half_pi = 1.5707963267948966
    rt_cos(x - half_pi)
}

// ---- function dispatch ----

// Evaluate f(x) for the function selected by f_id
fn eval_f(f_id: i32, x: f64) -> f64 with Mut, Div, Panic {
    if f_id == 0 { return x * x - 2.0 }
    if f_id == 1 { return x * x * x - x - 1.0 }
    if f_id == 2 { return rt_cos(x) - x }
    if f_id == 3 { return rt_exp(x) - 3.0 }
    // default: same as f_id=0
    x * x - 2.0
}

// Evaluate f'(x) for the function selected by f_id
fn eval_df(f_id: i32, x: f64) -> f64 with Mut, Div, Panic {
    if f_id == 0 { return 2.0 * x }
    if f_id == 1 { return 3.0 * x * x - 1.0 }
    if f_id == 2 { return 0.0 - rt_sin(x) - 1.0 }
    if f_id == 3 { return rt_exp(x) }
    2.0 * x
}

// Build a successful RootResult2
fn rr2_ok(root: f64, unc: f64, iter: i32, fval: f64) -> RootResult2 {
    RootResult2 { root: root, root_unc: unc, iterations: iter, converged: 1, f_at_root: fval }
}

// Build a failed RootResult2
fn rr2_fail(root: f64, unc: f64, iter: i32, fval: f64) -> RootResult2 {
    RootResult2 { root: root, root_unc: unc, iterations: iter, converged: 0, f_at_root: fval }
}

// Bisection using function-index dispatch.
// Interval [a,b] must bracket the root: eval_f(f_id,a)*eval_f(f_id,b) < 0.
// root_unc is set to half the final bracket width (convergence uncertainty).
pub fn bisection_id(f_id: i32, a: f64, b: f64, tol: f64, max_iter: i32) -> RootResult2 with Mut, Div, Panic {
    var lo = a
    var hi = b
    var f_lo = eval_f(f_id, lo)
    var f_hi = eval_f(f_id, hi)

    if f_lo * f_hi > 0.0 {
        let mid = (lo + hi) / 2.0
        return rr2_fail(mid, libm_fabs(hi - lo) / 2.0, 0, eval_f(f_id, mid))
    }
    if f_lo == 0.0 { return rr2_ok(lo, 0.0, 0, 0.0) }
    if f_hi == 0.0 { return rr2_ok(hi, 0.0, 0, 0.0) }

    var iter = 0
    var mid = (lo + hi) / 2.0
    var f_mid = eval_f(f_id, mid)

    while iter < max_iter {
        if libm_fabs(hi - lo) < tol {
            return rr2_ok(mid, libm_fabs(hi - lo) / 2.0, iter, f_mid)
        }
        mid = (lo + hi) / 2.0
        f_mid = eval_f(f_id, mid)
        if libm_fabs(f_mid) < tol {
            return rr2_ok(mid, tol / 2.0, iter + 1, f_mid)
        }
        if f_lo * f_mid < 0.0 {
            hi = mid
            f_hi = f_mid
        } else {
            lo = mid
            f_lo = f_mid
        }
        iter = iter + 1
    }
    rr2_fail(mid, libm_fabs(hi - lo) / 2.0, iter, f_mid)
}

// Newton-Raphson using function-index dispatch.
// Uses both eval_f and eval_df. root_unc is derived from |f(root)| / |f'(root)|.
pub fn newton_id(f_id: i32, x0: f64, tol: f64, max_iter: i32) -> RootResult2 with Mut, Div, Panic {
    var x = x0
    var iter = 0

    while iter < max_iter {
        let fx = eval_f(f_id, x)
        if libm_fabs(fx) < tol {
            let dfx = eval_df(f_id, x)
            let unc = if libm_fabs(dfx) > 1.0e-30 { libm_fabs(fx) / libm_fabs(dfx) } else { tol }
            return rr2_ok(x, unc, iter, fx)
        }
        let dfx = eval_df(f_id, x)
        if dfx == 0.0 { return rr2_fail(x, tol, iter, fx) }
        x = x - fx / dfx
        iter = iter + 1
    }

    let final_fx = eval_f(f_id, x)
    rr2_fail(x, tol, iter, final_fx)
}

// Secant method using function-index dispatch.
// root_unc is |x_curr - x_prev| at convergence.
pub fn secant_id(f_id: i32, x0: f64, x1: f64, tol: f64, max_iter: i32) -> RootResult2 with Mut, Div, Panic {
    var x_prev = x0
    var x_curr = x1
    var f_prev = eval_f(f_id, x_prev)
    var f_curr = eval_f(f_id, x_curr)
    var iter = 0

    while iter < max_iter {
        if libm_fabs(f_curr) < tol {
            return rr2_ok(x_curr, libm_fabs(x_curr - x_prev), iter, f_curr)
        }
        let denom = f_curr - f_prev
        if denom == 0.0 { return rr2_fail(x_curr, tol, iter, f_curr) }
        let x_next = x_curr - f_curr * (x_curr - x_prev) / denom
        x_prev = x_curr
        f_prev = f_curr
        x_curr = x_next
        f_curr = eval_f(f_id, x_curr)
        iter = iter + 1
    }
    rr2_fail(x_curr, libm_fabs(x_curr - x_prev), iter, f_curr)
}

// Brent's method using function-index dispatch (gold-standard bracketed solver).
// root_unc is half the final bracket width.
pub fn brent_id(f_id: i32, a: f64, b: f64, tol: f64, max_iter: i32) -> RootResult2 with Mut, Div, Panic {
    var lo = a
    var hi = b
    var f_lo = eval_f(f_id, lo)
    var f_hi = eval_f(f_id, hi)

    if f_lo * f_hi > 0.0 {
        let mid = (lo + hi) / 2.0
        return rr2_fail(mid, libm_fabs(hi - lo) / 2.0, 0, eval_f(f_id, mid))
    }

    // Ensure |f(lo)| >= |f(hi)|
    if libm_fabs(f_lo) < libm_fabs(f_hi) {
        var tmp = lo; lo = hi; hi = tmp
        var tf = f_lo; f_lo = f_hi; f_hi = tf
    }

    var c = lo
    var f_c = f_lo
    var d = hi - lo
    var e = d
    var iter = 0

    while iter < max_iter {
        if libm_fabs(f_hi) < tol {
            return rr2_ok(hi, libm_fabs(hi - lo) / 2.0, iter, f_hi)
        }
        if libm_fabs(hi - lo) < tol {
            return rr2_ok(hi, libm_fabs(hi - lo) / 2.0, iter, f_hi)
        }

        var use_bisect = true
        var s = 0.0

        if f_lo != f_c && f_hi != f_c {
            let r = f_hi / f_c
            let q = f_lo / f_c
            let p = f_hi / f_lo
            s = p * (q * (r - q) * (c - hi) - (1.0 - r) * (hi - lo)) / ((q - 1.0) * (r - 1.0) * (p - 1.0))
            s = hi + s
            use_bisect = false
        } else if f_lo != f_hi {
            s = hi - f_hi * (hi - lo) / (f_hi - f_lo)
            use_bisect = false
        }

        if !use_bisect {
            let cond1 = if lo < hi { s < lo || s > hi } else { s < hi || s > lo }
            let cond2 = libm_fabs(s - hi) >= libm_fabs(e) / 2.0
            if cond1 || cond2 { use_bisect = true }
        }

        if use_bisect {
            s = (lo + hi) / 2.0
            e = hi - lo
            d = e
        } else {
            e = d
            d = s - hi
        }

        c = hi
        f_c = f_hi
        let f_s = eval_f(f_id, s)

        if f_lo * f_s < 0.0 {
            hi = s; f_hi = f_s
        } else {
            lo = s; f_lo = f_s
        }

        if libm_fabs(f_lo) < libm_fabs(f_hi) {
            var tmp = lo; lo = hi; hi = tmp
            var tf = f_lo; f_lo = f_hi; f_hi = tf
        }

        iter = iter + 1
    }
    rr2_fail(hi, libm_fabs(hi - lo) / 2.0, iter, f_hi)
}
