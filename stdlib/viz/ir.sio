// stdlib/viz/ir.sio — Sounio-owned Visual IR
//
// Fixed-capacity scene graph for native visual frontends. Scientific meaning
// lives in Sounio data: units, uncertainty, fields, molecules, and simulation
// state are lowered to renderers, not delegated to JS or Python.

pub const VIZ_NODE_EMPTY: i64 = 0
pub const VIZ_NODE_SCENE: i64 = 1
pub const VIZ_NODE_GROUP: i64 = 2
pub const VIZ_NODE_PANEL: i64 = 3
pub const VIZ_NODE_CANVAS_LAYER: i64 = 4
pub const VIZ_NODE_CHART_LINE: i64 = 5
pub const VIZ_NODE_CHART_SCATTER: i64 = 6
pub const VIZ_NODE_CHART_BAR: i64 = 7
pub const VIZ_NODE_HEATMAP: i64 = 8
pub const VIZ_NODE_MESH: i64 = 9
pub const VIZ_NODE_MOLECULE: i64 = 10
pub const VIZ_NODE_FIELD: i64 = 11
pub const VIZ_NODE_LABEL: i64 = 12
pub const VIZ_NODE_CONTROL: i64 = 13
pub const VIZ_NODE_UNCERTAINTY_BAND: i64 = 14
pub const VIZ_NODE_FOREST: i64 = 15
pub const VIZ_NODE_WATERFALL: i64 = 16

pub const VIZ_CONTROL_BUTTON: i64 = 1
pub const VIZ_CONTROL_SLIDER: i64 = 2
pub const VIZ_CONTROL_TOGGLE: i64 = 3
pub const VIZ_CONTROL_TABS: i64 = 4
pub const VIZ_CONTROL_LEGEND: i64 = 5
pub const VIZ_CONTROL_TOOLTIP: i64 = 6
pub const VIZ_CONTROL_VIEWPORT: i64 = 7

pub struct VizStyle {
    pub r: i64,
    pub g: i64,
    pub b: i64,
    pub alpha: i64,
    pub stroke_width: i64,
    pub fill: bool,
    pub palette: i64,
    pub font_scale: i64,
}

pub struct VizLayout {
    pub x: i64,
    pub y: i64,
    pub w: i64,
    pub h: i64,
    pub layout_kind: i64, // 0=fixed, 1=row, 2=column
    pub gap: i64,
}

pub struct VizNode {
    pub kind: i64,
    pub parent: i64,
    pub first_child: i64,
    pub next_sibling: i64,
    pub style: VizStyle,
    pub layout: VizLayout,
    pub data_slot: i64,
    pub flags: i64,
    pub value: f64,
    pub min_value: f64,
    pub max_value: f64,
    pub selected: bool,
    pub label: [i8; 64],
    pub label_len: i64,
}

pub struct VizSeriesData {
    pub xs: [f64; 1024],
    pub ys: [f64; 1024],
    pub vars: [f64; 1024],
    pub n: i64,
    pub x_min: f64,
    pub x_max: f64,
    pub y_min: f64,
    pub y_max: f64,
}

pub struct VizHeatmapData {
    pub values: [f64; 4096],
    pub rows: i64,
    pub cols: i64,
    pub min_value: f64,
    pub max_value: f64,
}

pub struct VizScene {
    pub nodes: [VizNode; 64],
    pub node_count: i64,
    pub series: [VizSeriesData; 8],
    pub series_count: i64,
    pub heatmaps: [VizHeatmapData; 4],
    pub heatmap_count: i64,
    pub selected_node: i64,
    pub time: f64,
}

pub fn viz_style_rgb(r: i64, g: i64, b: i64) -> VizStyle {
    VizStyle { r: r, g: g, b: b, alpha: 255, stroke_width: 1, fill: true, palette: 0, font_scale: 1 }
}

pub fn viz_layout_rect(x: i64, y: i64, w: i64, h: i64) -> VizLayout {
    VizLayout { x: x, y: y, w: w, h: h, layout_kind: 0, gap: 0 }
}

pub fn viz_node_empty() -> VizNode {
    VizNode {
        kind: VIZ_NODE_EMPTY, parent: 0, first_child: 0, next_sibling: 0,
        style: viz_style_rgb(220, 220, 220),
        layout: viz_layout_rect(0, 0, 0, 0),
        data_slot: 0, flags: 0, value: 0.0, min_value: 0.0, max_value: 1.0,
        selected: false, label: [0; 64], label_len: 0,
    }
}

pub fn viz_series_empty() -> VizSeriesData {
    VizSeriesData {
        xs: [0.0; 1024], ys: [0.0; 1024], vars: [0.0; 1024], n: 0,
        x_min: 0.0, x_max: 1.0, y_min: 0.0, y_max: 1.0,
    }
}

pub fn viz_heatmap_empty() -> VizHeatmapData {
    VizHeatmapData {
        values: [0.0; 4096], rows: 0, cols: 0,
        min_value: 0.0, max_value: 1.0,
    }
}

pub fn viz_scene_new() -> VizScene {
    VizScene {
        nodes: [viz_node_empty(); 64],
        node_count: 0,
        series: [viz_series_empty(); 8],
        series_count: 0,
        heatmaps: [viz_heatmap_empty(); 4],
        heatmap_count: 0,
        selected_node: 0,
        time: 0.0,
    }
}

pub fn viz_scene_add_node(scene: &!VizScene, kind: i64, layout: VizLayout, style: VizStyle, data_slot: i64) -> i64 with Mut {
    if scene.node_count >= 64 { return 0 - 1 }
    let idx = scene.node_count
    scene.nodes[idx as usize] = viz_node_empty()
    scene.nodes[idx as usize].kind = kind
    scene.nodes[idx as usize].layout = layout
    scene.nodes[idx as usize].style = style
    scene.nodes[idx as usize].data_slot = data_slot
    scene.node_count = scene.node_count + 1
    idx
}

pub fn viz_scene_add_series(scene: &!VizScene, xs: &[f64; 1024], ys: &[f64; 1024], vars: &[f64; 1024], n: i64) -> i64 with Mut {
    if scene.series_count >= 8 { return 0 - 1 }
    let slot = scene.series_count
    var d = viz_series_empty()
    d.n = n
    if n > 0 {
        d.x_min = xs[0]
        d.x_max = xs[0]
        d.y_min = ys[0]
        d.y_max = ys[0]
    }
    var i: i64 = 0
    while i < n && i < 1024 {
        d.xs[i as usize] = xs[i as usize]
        d.ys[i as usize] = ys[i as usize]
        d.vars[i as usize] = vars[i as usize]
        if xs[i as usize] < d.x_min { d.x_min = xs[i as usize] }
        if xs[i as usize] > d.x_max { d.x_max = xs[i as usize] }
        if ys[i as usize] < d.y_min { d.y_min = ys[i as usize] }
        if ys[i as usize] > d.y_max { d.y_max = ys[i as usize] }
        i = i + 1
    }
    scene.series[slot as usize] = d
    scene.series_count = scene.series_count + 1
    slot
}

pub fn viz_scene_add_heatmap(scene: &!VizScene, values: &[f64; 4096], rows: i64, cols: i64, min_value: f64, max_value: f64) -> i64 with Mut {
    if scene.heatmap_count >= 4 { return 0 - 1 }
    let slot = scene.heatmap_count
    var d = viz_heatmap_empty()
    d.rows = rows
    d.cols = cols
    d.min_value = min_value
    d.max_value = max_value
    var i: i64 = 0
    while i < rows * cols && i < 4096 {
        d.values[i as usize] = values[i as usize]
        i = i + 1
    }
    scene.heatmaps[slot as usize] = d
    scene.heatmap_count = scene.heatmap_count + 1
    slot
}

pub fn viz_add_line_chart(scene: &!VizScene, xs: &[f64; 1024], ys: &[f64; 1024], n: i64, layout: VizLayout, style: VizStyle) -> i64 with Mut {
    let vars: [f64; 1024] = [0.0; 1024]
    let slot = viz_scene_add_series(scene, xs, ys, &vars, n)
    viz_scene_add_node(scene, VIZ_NODE_CHART_LINE, layout, style, slot)
}

pub fn viz_add_uncertainty_band(scene: &!VizScene, xs: &[f64; 1024], ys: &[f64; 1024], vars: &[f64; 1024], n: i64, layout: VizLayout, style: VizStyle) -> i64 with Mut {
    let slot = viz_scene_add_series(scene, xs, ys, vars, n)
    viz_scene_add_node(scene, VIZ_NODE_UNCERTAINTY_BAND, layout, style, slot)
}

pub fn viz_add_heatmap(scene: &!VizScene, values: &[f64; 4096], rows: i64, cols: i64, min_value: f64, max_value: f64, layout: VizLayout) -> i64 with Mut {
    let slot = viz_scene_add_heatmap(scene, values, rows, cols, min_value, max_value)
    viz_scene_add_node(scene, VIZ_NODE_HEATMAP, layout, viz_style_rgb(255, 255, 255), slot)
}

pub fn viz_add_control(scene: &!VizScene, control_kind: i64, layout: VizLayout, value: f64, min_value: f64, max_value: f64) -> i64 with Mut {
    let idx = viz_scene_add_node(scene, VIZ_NODE_CONTROL, layout, viz_style_rgb(90, 180, 240), control_kind)
    if idx >= 0 {
        scene.nodes[idx as usize].value = value
        scene.nodes[idx as usize].min_value = min_value
        scene.nodes[idx as usize].max_value = max_value
    }
    idx
}

pub fn viz_scene_set_time(scene: &!VizScene, t: f64) with Mut {
    scene.time = t
}
