pub const VIZ_NODE_SCENE: i64 = 1
pub const VIZ_NODE_GROUP: i64 = 2
pub const VIZ_NODE_PANEL: i64 = 3
pub const VIZ_NODE_CANVAS_LAYER: i64 = 4
pub const VIZ_NODE_CHART_LINE: i64 = 5
pub const VIZ_NODE_CHART_SCATTER: i64 = 6
pub const VIZ_NODE_CHART_BAR: i64 = 7
pub const VIZ_NODE_HEATMAP: i64 = 8
pub const VIZ_NODE_MESH: i64 = 9
pub const VIZ_NODE_MOLECULE: i64 = 10
pub const VIZ_NODE_FIELD: i64 = 11
pub const VIZ_NODE_LABEL: i64 = 12
pub const VIZ_NODE_CONTROL: i64 = 13
pub const VIZ_NODE_UNCERTAINTY_BAND: i64 = 14
pub const VIZ_NODE_FOREST: i64 = 15
pub const VIZ_NODE_WATERFALL: i64 = 16
pub const VIZ_NODE_VECTOR_FIELD: i64 = 17
pub const VIZ_NODE_TRAJECTORY: i64 = 18
pub const VIZ_NODE_SPECTRUM: i64 = 19
pub const VIZ_INTERVAL_NONE: i64 = 0
pub const VIZ_INTERVAL_CONFIDENCE: i64 = 1
pub const VIZ_INTERVAL_PREDICTION: i64 = 2
pub const VIZ_INTERVAL_CREDIBLE: i64 = 3
pub const VIZ_INTERVAL_STANDARD_UNCERTAINTY: i64 = 4

pub const VIZ_CONTROL_BUTTON: i64 = 1
pub const VIZ_CONTROL_SLIDER: i64 = 2
pub const VIZ_CONTROL_TOGGLE: i64 = 3
pub const VIZ_CONTROL_TABS: i64 = 4
pub const VIZ_CONTROL_LEGEND: i64 = 5
pub const VIZ_CONTROL_TOOLTIP: i64 = 6
pub const VIZ_CONTROL_VIEWPORT: i64 = 7

pub const VIZ_LAYOUT_FIXED: i64 = 0
pub const VIZ_LAYOUT_ROW: i64 = 1
pub const VIZ_LAYOUT_COLUMN: i64 = 2

pub struct VizStyle {
    pub r: i64,
    pub g: i64,
    pub b: i64,
    pub alpha: i64,
    pub stroke_width: i64,
    pub fill: bool,
    pub palette: i64,
    pub font_scale: i64,
}

pub struct VizLayout {
    pub x: i64,
    pub y: i64,
    pub w: i64,
    pub h: i64,
    pub layout_kind: i64, // 0=fixed, 1=row, 2=column
    pub gap: i64,
}

pub struct VizNode {
    pub id: i64,
    pub parent_id: i64,
    pub tag: i64,
    pub kind: i64,
    pub parent: i64,
    pub first_child: i64,
    pub next_sibling: i64,
    pub style: VizStyle,
    pub layout: VizLayout,
    pub data_slot: i64,
    pub flags: i64,
    pub value: f64,
    pub min_value: f64,
    pub max_value: f64,
    pub selected: bool,
    pub label: [i8; 64],
    pub label_len: i64,
}

pub struct VizSeriesData {
    pub xs: [f64; 1024],
    pub ys: [f64; 1024],
    pub vars: [f64; 1024],
    pub lower: [f64; 1024],
    pub upper: [f64; 1024],
    pub interval_kind: i64,
    pub interval_level: f64,
    pub n: i64,
    pub x_min: f64,
    pub x_max: f64,
    pub y_min: f64,
    pub y_max: f64,
}

pub struct VizHeatmapData {
    pub values: [f64; 4096],
    pub rows: i64,
    pub cols: i64,
    pub min_value: f64,
    pub max_value: f64,
}

pub struct VizVectorFieldData {
    pub vx: [f64; 4096],
    pub vy: [f64; 4096],
    pub variance: [f64; 4096],
    pub rows: i64,
    pub cols: i64,
}

pub struct VizTrajectoryData {
    pub x: [f64; 1024],
    pub y: [f64; 1024],
    pub z: [f64; 1024],
    pub t: [f64; 1024],
    pub variance: [f64; 1024],
    pub n: i64,
}

pub struct VizSpectrumData {
    pub x: [f64; 1024],
    pub intensity: [f64; 1024],
    pub variance: [f64; 1024],
    pub n: i64,
    pub x_min: f64,
    pub x_max: f64,
    pub y_min: f64,
    pub y_max: f64,
}

pub struct VizMeshData {
    pub tris: [Tri3D; 128],
    pub n: i64,
}

pub struct VizScene {
    pub nodes: [VizNode; 64],
    pub node_count: i64,
    pub series: [VizSeriesData; 8],
    pub series_count: i64,
    pub heatmaps: [VizHeatmapData; 4],
    pub heatmap_count: i64,
    pub molecules: [MoleculeViz; 4],
    pub molecule_count: i64,
    pub fields: [ScalarField2D; 4],
    pub field_heatmap_slots: [i64; 4],
    pub field_count: i64,
    pub vector_fields: [VectorField2D; 4],
    pub vector_data: [VizVectorFieldData; 4],
    pub vector_field_rows: [i64; 4],
    pub vector_field_cols: [i64; 4],
    pub vector_field_count: i64,
    pub trajectories: [Trajectory3D; 4],
    pub trajectory_data: [VizTrajectoryData; 4],
    pub trajectory_count: i64,
    pub spectra: [SpectrumViz; 4],
    pub spectrum_data: [VizSpectrumData; 4],
    pub spectrum_count: i64,
    pub meshes: [VizMeshData; 4],
    pub mesh_count: i64,
    pub selected_node: i64,
    pub hovered_node: i64,
    pub focused_node: i64,
    pub next_node_id: i64,
    pub active_tab: i64,
    pub time: f64,
}

pub fn viz_style_rgb(r: i64, g: i64, b: i64) -> VizStyle {
    VizStyle { r: r, g: g, b: b, alpha: 255, stroke_width: 1, fill: true, palette: 0, font_scale: 1 }
}

pub fn viz_layout_rect(x: i64, y: i64, w: i64, h: i64) -> VizLayout {
    VizLayout { x: x, y: y, w: w, h: h, layout_kind: VIZ_LAYOUT_FIXED, gap: 0 }
}

pub fn viz_layout_row(x: i64, y: i64, w: i64, h: i64, gap: i64) -> VizLayout {
    VizLayout { x: x, y: y, w: w, h: h, layout_kind: VIZ_LAYOUT_ROW, gap: gap }
}

pub fn viz_layout_column(x: i64, y: i64, w: i64, h: i64, gap: i64) -> VizLayout {
    VizLayout { x: x, y: y, w: w, h: h, layout_kind: VIZ_LAYOUT_COLUMN, gap: gap }
}

fn viz_layout_nonneg(v: i64) -> i64 {
    if v < 0 { 0 } else { v }
}

pub fn viz_node_empty() -> VizNode {
    VizNode {
        id: 0, parent_id: 0 - 1, tag: 0,
        kind: VIZ_NODE_EMPTY, parent: 0, first_child: 0, next_sibling: 0,
        style: viz_style_rgb(220, 220, 220),
        layout: viz_layout_rect(0, 0, 0, 0),
        data_slot: 0, flags: 0, value: 0.0, min_value: 0.0, max_value: 1.0,
        selected: false, label: [0; 64], label_len: 0,
    }
}

pub fn viz_series_empty() -> VizSeriesData {
    VizSeriesData {
        xs: [0.0; 1024], ys: [0.0; 1024], vars: [0.0; 1024],
        lower: [0.0; 1024], upper: [0.0; 1024],
        interval_kind: VIZ_INTERVAL_NONE, interval_level: 0.0, n: 0,
        x_min: 0.0, x_max: 1.0, y_min: 0.0, y_max: 1.0,
    }
}

pub fn viz_heatmap_empty() -> VizHeatmapData {
    VizHeatmapData {
        values: [0.0; 4096], rows: 0, cols: 0,
        min_value: 0.0, max_value: 1.0,
    }
}

pub fn viz_vector_field_empty() -> VizVectorFieldData {
    VizVectorFieldData {
        vx: [0.0; 4096], vy: [0.0; 4096], variance: [0.0; 4096],
        rows: 0, cols: 0,
    }
}

pub fn viz_trajectory_empty() -> VizTrajectoryData {
    VizTrajectoryData {
        x: [0.0; 1024], y: [0.0; 1024], z: [0.0; 1024],
        t: [0.0; 1024], variance: [0.0; 1024], n: 0,
    }
}

pub fn viz_spectrum_empty() -> VizSpectrumData {
    VizSpectrumData {
        x: [0.0; 1024], intensity: [0.0; 1024], variance: [0.0; 1024],
        n: 0, x_min: 0.0, x_max: 1.0, y_min: 0.0, y_max: 1.0,
    }
}

pub fn viz_tri_empty() -> Tri3D {
    Tri3D {
        v0x: 0.0, v0y: 0.0, v0z: -2.0,
        v1x: 0.0, v1y: 0.0, v1z: -2.0,
        v2x: 0.0, v2y: 0.0, v2z: -2.0,
        nx: 0.0, ny: 0.0, nz: 1.0,
        base_r: 0, base_g: 0, base_b: 0,
    }
}

pub fn viz_mesh_empty() -> VizMeshData {
    VizMeshData { tris: [viz_tri_empty(); 128], n: 0 }
}

pub fn viz_scene_new() -> VizScene {
    VizScene {
        nodes: [viz_node_empty(); 64],
        node_count: 0,
        series: [viz_series_empty(); 8],
        series_count: 0,
        heatmaps: [viz_heatmap_empty(); 4],
        heatmap_count: 0,
        molecules: [molecule_empty(); 4],
        molecule_count: 0,
        fields: [scalar_field_empty(0, 0); 4],
        field_heatmap_slots: [0 - 1; 4],
        field_count: 0,
        vector_fields: [vector_field_empty(0, 0); 4],
        vector_data: [viz_vector_field_empty(); 4],
        vector_field_rows: [0; 4],
        vector_field_cols: [0; 4],
        vector_field_count: 0,
        trajectories: [trajectory_empty(); 4],
        trajectory_data: [viz_trajectory_empty(); 4],
        trajectory_count: 0,
        spectra: [spectrum_empty(); 4],
        spectrum_data: [viz_spectrum_empty(); 4],
        spectrum_count: 0,
        meshes: [viz_mesh_empty(); 4],
        mesh_count: 0,
        selected_node: 0 - 1,
        hovered_node: 0 - 1,
        focused_node: 0 - 1,
        next_node_id: 1,
        active_tab: 0,
        time: 0.0,
    }
}

pub fn viz_scene_add_node(scene: &!VizScene, kind: i64, layout: VizLayout, style: VizStyle, data_slot: i64) -> i64 with Mut {
    if scene.node_count >= 64 { return 0 - 1 }
    let idx = scene.node_count
    scene.nodes[idx as usize] = viz_node_empty()
    scene.nodes[idx as usize].kind = kind
    scene.nodes[idx as usize].id = scene.next_node_id
    scene.next_node_id = scene.next_node_id + 1
    scene.nodes[idx as usize].layout = layout
    scene.nodes[idx as usize].style = style
    scene.nodes[idx as usize].data_slot = data_slot
    scene.node_count = scene.node_count + 1
    idx
}

pub fn viz_node_id(scene: &VizScene, node_idx: i64) -> i64 {
    if node_idx < 0 || node_idx >= scene.node_count { return 0 - 1 }
    scene.nodes[node_idx as usize].id
}

pub fn viz_scene_find_node(scene: &VizScene, id: i64) -> i64 with Mut {
    var i: i64 = 0
    while i < scene.node_count {
        if scene.nodes[i as usize].id == id { return i }
        i = i + 1
    }
    0 - 1
}

pub fn viz_scene_set_tag(scene: &!VizScene, node_idx: i64, tag: i64) with Mut {
    if node_idx < 0 || node_idx >= scene.node_count { return }
    scene.nodes[node_idx as usize].tag = tag
}

pub fn viz_scene_set_parent(scene: &!VizScene, node_idx: i64, parent_idx: i64) with Mut {
    if node_idx < 0 || node_idx >= scene.node_count { return }
    if parent_idx < 0 || parent_idx >= scene.node_count {
        scene.nodes[node_idx as usize].parent = 0 - 1
        scene.nodes[node_idx as usize].parent_id = 0 - 1
        return
    }
    scene.nodes[node_idx as usize].parent = parent_idx
    scene.nodes[node_idx as usize].parent_id = scene.nodes[parent_idx as usize].id
}

pub fn viz_scene_add_series(scene: &!VizScene, xs: &[f64; 1024], ys: &[f64; 1024], vars: &[f64; 1024], n: i64) -> i64 with Mut {
    if scene.series_count >= 8 { return 0 - 1 }
    if n < 0 || n > 1024 { return 0 - 1 }
    let slot = scene.series_count
    var d = viz_series_empty()
    d.n = n
    if n > 0 {
        d.x_min = xs[0]
        d.x_max = xs[0]
        d.y_min = ys[0]
        d.y_max = ys[0]
    }
    var i: i64 = 0
    while i < n && i < 1024 {
        d.xs[i as usize] = xs[i as usize]
        d.ys[i as usize] = ys[i as usize]
        d.vars[i as usize] = vars[i as usize]
        if xs[i as usize] < d.x_min { d.x_min = xs[i as usize] }
        if xs[i as usize] > d.x_max { d.x_max = xs[i as usize] }
        if ys[i as usize] < d.y_min { d.y_min = ys[i as usize] }
        if ys[i as usize] > d.y_max { d.y_max = ys[i as usize] }
        i = i + 1
    }
    scene.series[slot as usize] = d
    scene.series_count = scene.series_count + 1
    slot
}

pub fn viz_scene_add_heatmap(scene: &!VizScene, values: &[f64; 4096], rows: i64, cols: i64, min_value: f64, max_value: f64) -> i64 with Mut {
    if scene.heatmap_count >= 4 { return 0 - 1 }
    let slot = scene.heatmap_count
    var d = viz_heatmap_empty()
    d.rows = rows
    d.cols = cols
    d.min_value = min_value
    d.max_value = max_value
    var i: i64 = 0
    while i < rows * cols && i < 4096 {
        d.values[i as usize] = values[i as usize]
        i = i + 1
    }
    scene.heatmaps[slot as usize] = d
    scene.heatmap_count = scene.heatmap_count + 1
    slot
}

pub fn viz_scene_add_molecule_data(scene: &!VizScene, mol: MoleculeViz) -> i64 with Mut {
    if scene.molecule_count >= 4 { return 0 - 1 }
    let slot = scene.molecule_count
    scene.molecules[slot as usize] = mol
    scene.molecule_count = scene.molecule_count + 1
    slot
}

pub fn viz_scene_add_field_data(scene: &!VizScene, field: ScalarField2D) -> i64 with Mut {
    if scene.field_count >= 4 { return 0 - 1 }
    let slot = scene.field_count
    scene.fields[slot as usize] = field
    scene.field_count = scene.field_count + 1
    slot
}

pub fn viz_scene_add_vector_field_data(scene: &!VizScene, field: VectorField2D) -> i64 with Mut {
    if scene.vector_field_count >= 4 { return 0 - 1 }
    let slot = scene.vector_field_count
    let rows = field.rows
    let cols = field.cols
    scene.vector_fields[slot as usize] = field
    var d = viz_vector_field_empty()
    d.rows = rows
    d.cols = cols
    var i: i64 = 0
    while i < rows * cols && i < 4096 {
        d.vx[i as usize] = field.vx[i as usize]
        d.vy[i as usize] = field.vy[i as usize]
        d.variance[i as usize] = field.variance[i as usize]
        i = i + 1
    }
    scene.vector_data[slot as usize] = d
    scene.vector_field_rows[slot as usize] = rows
    scene.vector_field_cols[slot as usize] = cols
    scene.vector_field_count = scene.vector_field_count + 1
    slot
}

pub fn viz_scene_add_trajectory_data(scene: &!VizScene, tr: Trajectory3D) -> i64 with Mut {
    if scene.trajectory_count >= 4 { return 0 - 1 }
    let slot = scene.trajectory_count
    let n = tr.n
    scene.trajectories[slot as usize] = tr
    var d = viz_trajectory_empty()
    d.n = n
    var i: i64 = 0
    while i < n && i < 1024 {
        d.x[i as usize] = tr.x[i as usize]
        d.y[i as usize] = tr.y[i as usize]
        d.z[i as usize] = tr.z[i as usize]
        d.t[i as usize] = tr.t[i as usize]
        d.variance[i as usize] = tr.variance[i as usize]
        i = i + 1
    }
    scene.trajectory_data[slot as usize] = d
    scene.trajectory_count = scene.trajectory_count + 1
    slot
}

pub fn viz_scene_add_spectrum_data(scene: &!VizScene, spec: SpectrumViz) -> i64 with Mut {
    if scene.spectrum_count >= 4 { return 0 - 1 }
    let slot = scene.spectrum_count
    let n = spec.n
    scene.spectra[slot as usize] = spec
    var d = viz_spectrum_empty()
    d.n = n
    d.x_min = spec.x_min
    d.x_max = spec.x_max
    d.y_min = spec.y_min
    d.y_max = spec.y_max
    var i: i64 = 0
    while i < n && i < 1024 {
        d.x[i as usize] = spec.x[i as usize]
        d.intensity[i as usize] = spec.intensity[i as usize]
        d.variance[i as usize] = spec.variance[i as usize]
        i = i + 1
    }
    scene.spectrum_data[slot as usize] = d
    scene.spectrum_count = scene.spectrum_count + 1
    slot
}

pub fn viz_scene_add_mesh_data(scene: &!VizScene, tris: &[Tri3D; 128], n: i64) -> i64 with Mut {
    if scene.mesh_count >= 4 { return 0 - 1 }
    let slot = scene.mesh_count
    var d = viz_mesh_empty()
    d.n = n
    var i: i64 = 0
    while i < n && i < 128 {
        d.tris[i as usize] = tris[i as usize]
        i = i + 1
    }
    scene.meshes[slot as usize] = d
    scene.mesh_count = scene.mesh_count + 1
    slot
}

pub fn viz_add_line_chart(scene: &!VizScene, xs: &[f64; 1024], ys: &[f64; 1024], n: i64, layout: VizLayout, style: VizStyle) -> i64 with Mut {
    if n < 0 || n > 1024 || scene.series_count >= 8 || scene.node_count >= 64 { return 0 - 1 }
    let vars: [f64; 1024] = [0.0; 1024]
    let slot = viz_scene_add_series(scene, xs, ys, &vars, n)
    viz_scene_add_node(scene, VIZ_NODE_CHART_LINE, layout, style, slot)
}

pub fn viz_add_scatter_chart(scene: &!VizScene, xs: &[f64; 1024], ys: &[f64; 1024], n: i64, layout: VizLayout, style: VizStyle) -> i64 with Mut {
    if n < 0 || n > 1024 || scene.series_count >= 8 || scene.node_count >= 64 { return 0 - 1 }
    var found = false
    var xmin:f64 = 0.0; var xmax:f64 = 0.0
    var ymin:f64 = 0.0; var ymax:f64 = 0.0
    var i:i64 = 0
    while i < n {
        let vx = xs[i as usize]; let vy = ys[i as usize]
        if scatter_finite(vx) && scatter_finite(vy) {
            if !found { xmin=vx; xmax=vx; ymin=vy; ymax=vy; found=true }
            else {
                if vx < xmin { xmin=vx }; if vx > xmax { xmax=vx }
                if vy < ymin { ymin=vy }; if vy > ymax { ymax=vy }
            }
        }
        i=i+1
    }
    if n > 0 && !found { return -1 }
    let vars: [f64; 1024] = [0.0; 1024]
    let slot = viz_scene_add_series(scene, xs, ys, &vars, n)
    scene.series[slot as usize].x_min=xmin; scene.series[slot as usize].x_max=xmax
    scene.series[slot as usize].y_min=ymin; scene.series[slot as usize].y_max=ymax
    viz_scene_add_node(scene, VIZ_NODE_CHART_SCATTER, layout, style, slot)
}

pub fn viz_add_bar_chart(scene: &!VizScene, xs: &[f64; 1024], ys: &[f64; 1024], n: i64, layout: VizLayout, style: VizStyle) -> i64 with Mut {
    if n < 0 || n > 1024 || scene.series_count >= 8 || scene.node_count >= 64 { return 0 - 1 }
    var found=false
    var xmin:f64=0.0; var xmax:f64=0.0
    var ymin:f64=0.0; var ymax:f64=0.0
    var i:i64=0
    while i < n {
        let vx=xs[i as usize]; let vy=ys[i as usize]
        if scatter_finite(vx) && scatter_finite(vy) {
            if !found { xmin=vx; xmax=vx; found=true }
            else { if vx < xmin { xmin=vx }; if vx > xmax { xmax=vx } }
            if vy < ymin { ymin=vy }; if vy > ymax { ymax=vy }
        }
        i=i+1
    }
    if n > 0 && !found { return -1 }
    let vars: [f64; 1024] = [0.0; 1024]
    let slot = viz_scene_add_series(scene, xs, ys, &vars, n)
    scene.series[slot as usize].x_min=xmin; scene.series[slot as usize].x_max=xmax
    scene.series[slot as usize].y_min=ymin; scene.series[slot as usize].y_max=ymax
    viz_scene_add_node(scene, VIZ_NODE_CHART_BAR, layout, style, slot)
}

// Sampled +/-one-sigma spans; not confidence intervals. Transactional validation.
pub fn viz_add_uncertainty_band(scene:&!VizScene,xs:&[f64;1024],ys:&[f64;1024],vars:&[f64;1024],
 n:i64,layout:VizLayout,style:VizStyle)->i64 with Mut,Div,Panic {
 if n<0 || n>1024 || scene.series_count>=8 || scene.node_count>=64 {return -1}
 if !scatter_geometry(layout.x,layout.y,layout.w,layout.h) || !uncertainty_prefix(xs,ys,vars,n) {return -1}
 var xmin:f64=0.0
 var xmax:f64=1.0
 var ymin:f64=0.0
 var ymax:f64=1.0
 if n>0 {
  let first=uncertainty_bounds(ys[0],vars[0])
  xmin=xs[0]
  xmax=xs[0]
  ymin=first.lower
  ymax=first.upper
 }
 var i:i64=1
 while i<n {
  let bounds=uncertainty_bounds(ys[i as usize],vars[i as usize])
  if xs[i as usize]<xmin {xmin=xs[i as usize]}
  if xs[i as usize]>xmax {xmax=xs[i as usize]}
  if bounds.lower<ymin {ymin=bounds.lower}
  if bounds.upper>ymax {ymax=bounds.upper}
  i=i+1
 }
 if !uncertainty_domain(xmin,xmax,ymin,ymax) {return -1}
 let slot=viz_scene_add_series(scene,xs,ys,vars,n)
 scene.series[slot as usize].x_min=xmin
 scene.series[slot as usize].x_max=xmax
 scene.series[slot as usize].y_min=ymin
 scene.series[slot as usize].y_max=ymax
 scene.series[slot as usize].interval_kind=VIZ_INTERVAL_STANDARD_UNCERTAINTY
 scene.series[slot as usize].interval_level=0.0
 viz_scene_add_node(scene,VIZ_NODE_UNCERTAINTY_BAND,layout,style,slot)
}

// Legacy variance means +/-one sigma, never a confidence interval.
pub fn viz_add_forest_plot(scene:&!VizScene,estimates:&[f64;1024],variances:&[f64;1024],n:i64,
 layout:VizLayout,style:VizStyle)->i64 with Mut,Div,Panic {
 if scene.series_count>=8 || scene.node_count>=64 {return -1}
 let rows=forest_layout(n,layout.x,layout.y,layout.w,layout.h)
 if rows.status!=0 {return -1}
 var xmin:f64=0.0;var xmax:f64=1.0
 var i:i64=0
 while i<n {
  let bounds=uncertainty_bounds(estimates[i as usize],variances[i as usize])
  if bounds.status!=0 {return -1}
  if i==0 {xmin=bounds.lower;xmax=bounds.upper}
  else {if bounds.lower<xmin {xmin=bounds.lower};if bounds.upper>xmax {xmax=bounds.upper}}
  i=i+1
 }
 if !forest_domain(xmin,xmax) {return -1}
 let slot=scene.series_count
 scene.series[slot as usize]=viz_series_empty()
 scene.series[slot as usize].n=n
 scene.series[slot as usize].x_min=xmin;scene.series[slot as usize].x_max=xmax
 scene.series[slot as usize].y_min=0.0;scene.series[slot as usize].y_max=if n==0 {0.0} else {(n-1) as f64}
 i=0
 while i<n {
  scene.series[slot as usize].xs[i as usize]=estimates[i as usize]
  scene.series[slot as usize].ys[i as usize]=i as f64
  scene.series[slot as usize].vars[i as usize]=variances[i as usize]
  i=i+1
 }
 scene.series_count=scene.series_count+1
 let node=viz_scene_add_node(scene,VIZ_NODE_FOREST,layout,style,slot)
 scene.nodes[node as usize].min_value=0.0;scene.nodes[node as usize].max_value=n as f64
 node
}

fn viz_interval_finite(x: f64) -> bool {
    if x != x { return false }
    if x == 0.0 && x == 1.0 { return false }
    let ax = if x < 0.0 { 0.0 - x } else { x }
    ax <= 1.7976931348623157e308
}

pub struct ForestPageResult {
 pub status:i64,pub chart:i64,pub first:i64,pub count:i64,pub next:i64,pub total:i64,pub has_more:bool,
}
// Explicit pages preserve one global X envelope across the full validated source.
pub fn viz_add_forest_interval_page(scene:&!VizScene,estimates:&[f64;1024],lower:&[f64;1024],upper:&[f64;1024],
 total:i64,first:i64,kind:i64,level:f64,layout:VizLayout,style:VizStyle)->ForestPageResult with Mut,Div {
 var out=ForestPageResult{status:1,chart:-1,first:first,count:0,next:first,total:total,has_more:false}
 let page=forest_page_plan(total,first,layout.x,layout.y,layout.w,layout.h)
 if page.status!=0 {out.status=if page.status==2 {4} else {3};return out}
 if kind<VIZ_INTERVAL_CONFIDENCE || kind>VIZ_INTERVAL_CREDIBLE ||
    !viz_interval_finite(level) || level<=0.0 || level>=1.0 {out.status=2;return out}
 if scene.series_count>=8 || scene.node_count>=64 {out.status=5;return out}
 var xmin:f64=0.0;var xmax:f64=0.0
 var i:i64=0
 while i<total {
  let e=estimates[i as usize];let lo=lower[i as usize];let hi=upper[i as usize]
  if !viz_interval_finite(e) || !viz_interval_finite(lo) || !viz_interval_finite(hi) || lo>e || e>hi {out.status=2;return out}
  if i==0 {xmin=lo;xmax=hi}
  else {if lo<xmin {xmin=lo};if hi>xmax {xmax=hi}}
  i=i+1
 }
 if !forest_domain(xmin,xmax) {out.status=2;return out}
 let slot=scene.series_count
 scene.series[slot as usize]=viz_series_empty()
 scene.series[slot as usize].n=page.count
 scene.series[slot as usize].x_min=xmin;scene.series[slot as usize].x_max=xmax
 scene.series[slot as usize].y_min=0.0;scene.series[slot as usize].y_max=(page.count-1) as f64
 i=0
 while i<page.count {
  let source=(first+i) as usize
  scene.series[slot as usize].xs[i as usize]=estimates[source]
  scene.series[slot as usize].ys[i as usize]=i as f64
  scene.series[slot as usize].lower[i as usize]=lower[source]
  scene.series[slot as usize].upper[i as usize]=upper[source]
  i=i+1
 }
 scene.series[slot as usize].interval_kind=kind;scene.series[slot as usize].interval_level=level
 scene.series_count=scene.series_count+1
 let node=viz_scene_add_node(scene,VIZ_NODE_FOREST,layout,style,slot)
 scene.nodes[node as usize].min_value=first as f64;scene.nodes[node as usize].max_value=total as f64
 out.status=0;out.chart=node;out.count=page.count;out.next=page.next;out.has_more=page.has_more
 out
}
/// Whole-source convenience: insufficient row capacity rejects atomically.
pub fn viz_add_forest_interval_plot(scene:&!VizScene,estimates:&[f64;1024],lower:&[f64;1024],upper:&[f64;1024],
 n:i64,kind:i64,level:f64,layout:VizLayout,style:VizStyle)->i64 with Mut,Div {
 if n<1 || n>1024 {return -1}
 let rows=forest_layout(n,layout.x,layout.y,layout.w,layout.h)
 if rows.status!=0 {return -1}
 let result=viz_add_forest_interval_page(scene,estimates,lower,upper,n,0,kind,level,layout,style)
 result.chart
}

pub fn viz_add_waterfall(scene: &!VizScene, values: &[f64; 1024], n: i64, layout: VizLayout, style: VizStyle) -> i64 with Mut {
    if n < 0 || n > 1024 || scene.series_count >= 8 || scene.node_count >= 64 { return 0 - 1 }
    var xs: [f64; 1024] = [0.0; 1024]
    var vars: [f64; 1024] = [0.0; 1024]
    var i: i64 = 0
    while i < n && i < 1024 {
        xs[i as usize] = i as f64
        i = i + 1
    }
    let slot = viz_scene_add_series(scene, &xs, values, &vars, n)
    viz_scene_add_node(scene, VIZ_NODE_WATERFALL, layout, style, slot)
}

pub fn viz_add_heatmap(scene: &!VizScene, values: &[f64; 4096], rows: i64, cols: i64, min_value: f64, max_value: f64, layout: VizLayout) -> i64 with Mut {
    let slot = viz_scene_add_heatmap(scene, values, rows, cols, min_value, max_value)
    viz_scene_add_node(scene, VIZ_NODE_HEATMAP, layout, viz_style_rgb(255, 255, 255), slot)
}

pub fn viz_add_molecule(scene: &!VizScene, mol: MoleculeViz, layout: VizLayout, style: VizStyle) -> i64 with Mut {
    let slot = viz_scene_add_molecule_data(scene, mol)
    viz_scene_add_node(scene, VIZ_NODE_MOLECULE, layout, style, slot)
}

pub fn viz_add_scalar_field(scene: &!VizScene, field: ScalarField2D, layout: VizLayout) -> i64 with Mut {
    var values: [f64; 4096] = [0.0; 4096]
    let rows = field.rows
    let cols = field.cols
    let min_value = field.min_value
    let max_value = field.max_value
    var i: i64 = 0
    while i < rows * cols && i < 4096 {
        values[i as usize] = field.values[i as usize]
        i = i + 1
    }
    let slot = viz_scene_add_field_data(scene, field)
    if slot >= 0 {
        let heat_slot = viz_scene_add_heatmap(scene, &values, rows, cols, min_value, max_value)
        scene.field_heatmap_slots[slot as usize] = heat_slot
    }
    viz_scene_add_node(scene, VIZ_NODE_FIELD, layout, viz_style_rgb(120, 200, 220), slot)
}

pub fn viz_add_vector_field(scene: &!VizScene, field: VectorField2D, layout: VizLayout) -> i64 with Mut {
    let slot = viz_scene_add_vector_field_data(scene, field)
    viz_scene_add_node(scene, VIZ_NODE_VECTOR_FIELD, layout, viz_style_rgb(240, 210, 120), slot)
}

pub fn viz_add_trajectory(scene: &!VizScene, tr: Trajectory3D, layout: VizLayout) -> i64 with Mut {
    let slot = viz_scene_add_trajectory_data(scene, tr)
    viz_scene_add_node(scene, VIZ_NODE_TRAJECTORY, layout, viz_style_rgb(210, 170, 255), slot)
}

pub fn viz_add_spectrum(scene: &!VizScene, spec: SpectrumViz, layout: VizLayout) -> i64 with Mut {
    let slot = viz_scene_add_spectrum_data(scene, spec)
    viz_scene_add_node(scene, VIZ_NODE_SPECTRUM, layout, viz_style_rgb(255, 210, 120), slot)
}

pub fn viz_add_mesh(scene: &!VizScene, tris: &[Tri3D; 128], n: i64, layout: VizLayout, style: VizStyle) -> i64 with Mut {
    let slot = viz_scene_add_mesh_data(scene, tris, n)
    viz_scene_add_node(scene, VIZ_NODE_MESH, layout, style, slot)
}

pub fn viz_add_control(scene: &!VizScene, control_kind: i64, layout: VizLayout, value: f64, min_value: f64, max_value: f64) -> i64 with Mut {
    let idx = viz_scene_add_node(scene, VIZ_NODE_CONTROL, layout, viz_style_rgb(90, 180, 240), control_kind)
    if idx >= 0 {
        scene.nodes[idx as usize].value = value
        scene.nodes[idx as usize].min_value = min_value
        scene.nodes[idx as usize].max_value = max_value
    }
    idx
}

pub fn viz_node_set_label(scene: &!VizScene, node_idx: i64, text: &[i8; 64], len: i64) with Mut {
    if node_idx < 0 || node_idx >= scene.node_count { return }
    var n = len
    if n < 0 { n = 0 }
    if n > 64 { n = 64 }
    scene.nodes[node_idx as usize].label_len = n
    var i: i64 = 0
    while i < 64 {
        scene.nodes[node_idx as usize].label[i as usize] = 0
        i = i + 1
    }
    i = 0
    while i < n {
        scene.nodes[node_idx as usize].label[i as usize] = text[i as usize]
        i = i + 1
    }
}

pub fn viz_add_label(scene: &!VizScene, text: &[i8; 64], len: i64, layout: VizLayout, style: VizStyle) -> i64 with Mut {
    let idx = viz_scene_add_node(scene, VIZ_NODE_LABEL, layout, style, 0)
    viz_node_set_label(scene, idx, text, len)
    idx
}

pub fn viz_add_text_control(scene: &!VizScene, control_kind: i64, text: &[i8; 64], len: i64, layout: VizLayout, style: VizStyle) -> i64 with Mut {
    let idx = viz_add_control(scene, control_kind, layout, 0.0, 0.0, 1.0)
    if idx >= 0 {
        scene.nodes[idx as usize].style = style
        viz_node_set_label(scene, idx, text, len)
    }
    idx
}

pub fn viz_add_button(scene: &!VizScene, text: &[i8; 64], len: i64, layout: VizLayout, style: VizStyle) -> i64 with Mut {
    viz_add_text_control(scene, VIZ_CONTROL_BUTTON, text, len, layout, style)
}

pub fn viz_add_slider(scene: &!VizScene, layout: VizLayout, value: f64, min_value: f64, max_value: f64, style: VizStyle) -> i64 with Mut {
    let idx = viz_add_control(scene, VIZ_CONTROL_SLIDER, layout, value, min_value, max_value)
    if idx >= 0 {
        scene.nodes[idx as usize].style = style
    }
    idx
}

pub fn viz_add_toggle(scene: &!VizScene, layout: VizLayout, on: bool, style: VizStyle) -> i64 with Mut {
    let value = if on { 1.0 } else { 0.0 }
    let idx = viz_add_control(scene, VIZ_CONTROL_TOGGLE, layout, value, 0.0, 1.0)
    if idx >= 0 {
        scene.nodes[idx as usize].style = style
    }
    idx
}

pub fn viz_add_tabs(scene: &!VizScene, layout: VizLayout, active: i64, min_tab: i64, max_tab: i64, style: VizStyle) -> i64 with Mut {
    let idx = viz_add_control(scene, VIZ_CONTROL_TABS, layout, active as f64, min_tab as f64, max_tab as f64)
    if idx >= 0 {
        scene.nodes[idx as usize].style = style
    }
    idx
}

pub fn viz_add_viewport(scene: &!VizScene, text: &[i8; 64], len: i64, layout: VizLayout, style: VizStyle) -> i64 with Mut {
    viz_add_text_control(scene, VIZ_CONTROL_VIEWPORT, text, len, layout, style)
}

pub fn viz_add_plot_viewport(scene: &!VizScene, layout: VizLayout, style: VizStyle) -> i64 with Mut {
    let idx = viz_add_control(scene, VIZ_CONTROL_VIEWPORT, layout, 0.0, 0.0, 1.0)
    if idx >= 0 {
        scene.nodes[idx as usize].style = style
    }
    idx
}

pub fn viz_add_legend(scene: &!VizScene, text: &[i8; 64], len: i64, layout: VizLayout, style: VizStyle) -> i64 with Mut {
    viz_add_text_control(scene, VIZ_CONTROL_LEGEND, text, len, layout, style)
}

pub fn viz_add_tooltip(scene: &!VizScene, text: &[i8; 64], len: i64, layout: VizLayout, style: VizStyle) -> i64 with Mut {
    viz_add_text_control(scene, VIZ_CONTROL_TOOLTIP, text, len, layout, style)
}

pub fn viz_scene_set_time(scene: &!VizScene, t: f64) with Mut {
    scene.time = t
}

fn viz_node_is_focusable_kind(kind: i64, data_slot: i64) -> bool {
    if kind != VIZ_NODE_CONTROL { return false }
    if data_slot == VIZ_CONTROL_BUTTON { return true }
    if data_slot == VIZ_CONTROL_SLIDER { return true }
    if data_slot == VIZ_CONTROL_TOGGLE { return true }
    if data_slot == VIZ_CONTROL_TABS { return true }
    if data_slot == VIZ_CONTROL_VIEWPORT { return true }
    return false
}

fn viz_scene_is_focusable_node(scene: &VizScene, node_idx: i64) -> bool {
    if node_idx < 0 || node_idx >= scene.node_count { return false }
    return viz_node_is_focusable_kind(scene.nodes[node_idx as usize].kind, scene.nodes[node_idx as usize].data_slot)
}

fn viz_scene_focus_set(scene: &!VizScene, node_idx: i64) with Mut {
    if node_idx < 0 || node_idx >= scene.node_count {
        scene.focused_node = 0 - 1
        return
    }
    scene.focused_node = node_idx
}

pub fn viz_scene_focus_next(scene: &!VizScene) -> i64 with Mut {
    if scene.node_count <= 0 {
        scene.focused_node = 0 - 1
        return 0 - 1
    }
    var start = scene.focused_node + 1
    if start < 0 || start >= scene.node_count { start = 0 }
    var step: i64 = 0
    while step < scene.node_count {
        let idx = (start + step) % scene.node_count
        if viz_scene_is_focusable_node(scene, idx) {
            viz_scene_focus_set(scene, idx)
            return idx
        }
        step = step + 1
    }
    scene.focused_node = 0 - 1
    return 0 - 1
}

pub fn viz_scene_focus_prev(scene: &!VizScene) -> i64 with Mut {
    if scene.node_count <= 0 {
        scene.focused_node = 0 - 1
        return 0 - 1
    }
    var start = scene.focused_node - 1
    if start < 0 || start >= scene.node_count { start = scene.node_count - 1 }
    var step: i64 = 0
    while step < scene.node_count {
        var idx = start - step
        while idx < 0 { idx = idx + scene.node_count }
        if viz_scene_is_focusable_node(scene, idx) {
            viz_scene_focus_set(scene, idx)
            return idx
        }
        step = step + 1
    }
    scene.focused_node = 0 - 1
    return 0 - 1
}

pub fn viz_scene_activate_focused(scene: &!VizScene) -> bool with Mut, Div {
    let idx = scene.focused_node
    if idx < 0 || idx >= scene.node_count { return false }
    let kind = scene.nodes[idx as usize].kind
    let slot = scene.nodes[idx as usize].data_slot
    if !viz_node_is_focusable_kind(kind, slot) { return false }
    scene.selected_node = idx
    var i: i64 = 0
    while i < scene.node_count {
        scene.nodes[i as usize].selected = i == idx
        i = i + 1
    }
    if slot == VIZ_CONTROL_TOGGLE {
        viz_scene_toggle(scene, idx)
    } else if slot == VIZ_CONTROL_TABS {
        viz_scene_step_tab_key(scene, idx, 1)
    }
    return true
}

fn viz_print_i64(n: i64) with IO, Mut, Div {
    if n == 0 { print("0"); return }
    var v = n
    if v < 0 { print("-"); v = 0 - v }
    var digits: [i64; 20] = [0; 20]
    var len: i64 = 0
    while v > 0 {
        digits[len as usize] = v - (v / 10) * 10
        v = v / 10
        len = len + 1
    }
    var i = len - 1
    while i >= 0 {
        let d = digits[i as usize]
        if d == 0 { print("0") }
        if d == 1 { print("1") }
        if d == 2 { print("2") }
        if d == 3 { print("3") }
        if d == 4 { print("4") }
        if d == 5 { print("5") }
        if d == 6 { print("6") }
        if d == 7 { print("7") }
        if d == 8 { print("8") }
        if d == 9 { print("9") }
        i = i - 1
    }
}

fn viz_dump_node(scene: &VizScene, idx: i64) with IO, Mut, Div {
    print("node idx="); viz_print_i64(idx)
    print(" id="); viz_print_i64(scene.nodes[idx as usize].id)
    print(" parent_id="); viz_print_i64(scene.nodes[idx as usize].parent_id)
    print(" tag="); viz_print_i64(scene.nodes[idx as usize].tag)
    print(" kind="); viz_print_i64(scene.nodes[idx as usize].kind)
    print(" slot="); viz_print_i64(scene.nodes[idx as usize].data_slot)
    print(" rect="); viz_print_i64(scene.nodes[idx as usize].layout.x)
    print(","); viz_print_i64(scene.nodes[idx as usize].layout.y)
    print(","); viz_print_i64(scene.nodes[idx as usize].layout.w)
    print(","); viz_print_i64(scene.nodes[idx as usize].layout.h)
    println("")
}

pub fn viz_scene_dump(scene: &VizScene) with IO, Mut, Div {
    print("VizScene nodes="); viz_print_i64(scene.node_count)
    print(" selected="); viz_print_i64(scene.selected_node)
    print(" hovered="); viz_print_i64(scene.hovered_node)
    print(" focused="); viz_print_i64(scene.focused_node)
    print(" series="); viz_print_i64(scene.series_count)
    print(" heatmaps="); viz_print_i64(scene.heatmap_count)
    print(" molecules="); viz_print_i64(scene.molecule_count)
    print(" fields="); viz_print_i64(scene.field_count)
    print(" vectors="); viz_print_i64(scene.vector_field_count)
    print(" trajectories="); viz_print_i64(scene.trajectory_count)
    print(" spectra="); viz_print_i64(scene.spectrum_count)
    print(" meshes="); viz_print_i64(scene.mesh_count)
    println("")
    var i: i64 = 0
    while i < scene.node_count {
        viz_dump_node(scene, i)
        i = i + 1
    }
}

pub fn viz_scene_apply_layout_range(scene: &!VizScene, first_idx: i64, count: i64, layout: VizLayout) with Mut {
    if count <= 0 { return }
    if first_idx < 0 || first_idx >= scene.node_count { return }
    var n = count
    if first_idx + n > scene.node_count {
        n = scene.node_count - first_idx
    }
    if n <= 0 { return }

    if layout.layout_kind == VIZ_LAYOUT_ROW {
        let total_gap = layout.gap * (n - 1)
        let cell_w = viz_layout_nonneg(layout.w - total_gap) / n
        var i: i64 = 0
        while i < n {
            let idx = first_idx + i
            scene.nodes[idx as usize].layout = viz_layout_rect(layout.x + i * (cell_w + layout.gap), layout.y, cell_w, layout.h)
            i = i + 1
        }
    } else if layout.layout_kind == VIZ_LAYOUT_COLUMN {
        let total_gap = layout.gap * (n - 1)
        let cell_h = viz_layout_nonneg(layout.h - total_gap) / n
        var i: i64 = 0
        while i < n {
            let idx = first_idx + i
            scene.nodes[idx as usize].layout = viz_layout_rect(layout.x, layout.y + i * (cell_h + layout.gap), layout.w, cell_h)
            i = i + 1
        }
    }
}

pub fn viz_scene_set_slider(scene: &!VizScene, node_idx: i64, value: f64) with Mut {
    if node_idx < 0 || node_idx >= scene.node_count { return }
    let min_v = scene.nodes[node_idx as usize].min_value
    let max_v = scene.nodes[node_idx as usize].max_value
    var v = value
    if v < min_v { v = min_v }
    if v > max_v { v = max_v }
    scene.nodes[node_idx as usize].value = v
}

pub fn viz_scene_set_time_from_slider(scene: &!VizScene, node_idx: i64, value: f64) with Mut {
    viz_scene_set_slider(scene, node_idx, value)
    if node_idx < 0 || node_idx >= scene.node_count { return }
    if scene.nodes[node_idx as usize].kind == VIZ_NODE_CONTROL && scene.nodes[node_idx as usize].data_slot == VIZ_CONTROL_SLIDER {
        scene.time = scene.nodes[node_idx as usize].value
    }
}

pub fn viz_scene_set_toggle(scene: &!VizScene, node_idx: i64, enabled: bool) with Mut {
    if node_idx < 0 || node_idx >= scene.node_count { return }
    if scene.nodes[node_idx as usize].kind == VIZ_NODE_CONTROL && scene.nodes[node_idx as usize].data_slot == VIZ_CONTROL_TOGGLE {
        scene.nodes[node_idx as usize].value = if enabled { 1.0 } else { 0.0 }
        scene.nodes[node_idx as usize].selected = enabled
    }
}

pub fn viz_scene_toggle(scene: &!VizScene, node_idx: i64) with Mut {
    if node_idx < 0 || node_idx >= scene.node_count { return }
    if scene.nodes[node_idx as usize].kind == VIZ_NODE_CONTROL && scene.nodes[node_idx as usize].data_slot == VIZ_CONTROL_TOGGLE {
        viz_scene_set_toggle(scene, node_idx, scene.nodes[node_idx as usize].value <= 0.0)
    }
}

pub fn viz_scene_set_tab(scene: &!VizScene, node_idx: i64, tab_idx: i64) with Mut {
    if node_idx < 0 || node_idx >= scene.node_count { return }
    if scene.nodes[node_idx as usize].kind == VIZ_NODE_CONTROL && scene.nodes[node_idx as usize].data_slot == VIZ_CONTROL_TABS {
        var idx = tab_idx
        let min_i = scene.nodes[node_idx as usize].min_value as i64
        let max_i = scene.nodes[node_idx as usize].max_value as i64
        if idx < min_i { idx = min_i }
        if idx > max_i { idx = max_i }
        scene.nodes[node_idx as usize].value = idx as f64
        scene.active_tab = idx
    }
}

fn viz_scene_tab_from_pointer(node: &VizNode, px: i64) -> i64 with Mut, Div {
    let min_i = node.min_value as i64
    let max_i = node.max_value as i64
    var count = max_i - min_i + 1
    if count <= 0 { count = 1 }
    let denom = if node.layout.w <= 0 { 1 } else { node.layout.w }
    var rel = px - node.layout.x
    if rel < 0 { rel = 0 }
    if rel >= denom { rel = denom - 1 }
    let tab_w = if denom / count <= 0 { 1 } else { denom / count }
    var idx = min_i + rel / tab_w
    if idx > max_i { idx = max_i }
    idx
}

pub fn viz_scene_activate_control(scene: &!VizScene, node_idx: i64, px: i64, py: i64) -> i64 with Mut, Div {
    if node_idx < 0 || node_idx >= scene.node_count { return node_idx }
    let kind = scene.nodes[node_idx as usize].kind
    let slot = scene.nodes[node_idx as usize].data_slot
    if kind == VIZ_NODE_CONTROL && slot == VIZ_CONTROL_TOGGLE {
        viz_scene_toggle(scene, node_idx)
    } else if kind == VIZ_NODE_CONTROL && slot == VIZ_CONTROL_TABS {
        let min_v = scene.nodes[node_idx as usize].min_value
        let max_v = scene.nodes[node_idx as usize].max_value
        let lx = scene.nodes[node_idx as usize].layout.x
        let lw = scene.nodes[node_idx as usize].layout.w
        let min_i = min_v as i64
        let max_i = max_v as i64
        var count = max_i - min_i + 1
        if count <= 0 { count = 1 }
        let denom = if lw <= 0 { 1 } else { lw }
        var rel = px - lx
        if rel < 0 { rel = 0 }
        if rel >= denom { rel = denom - 1 }
        let tab_w = if denom / count <= 0 { 1 } else { denom / count }
        var idx = min_i + rel / tab_w
        if idx > max_i { idx = max_i }
        viz_scene_set_tab(scene, node_idx, idx)
    }
    node_idx
}

pub fn viz_scene_hit_test(scene: &VizScene, px: i64, py: i64) -> i64 with Mut {
    var found: i64 = 0 - 1
    var i: i64 = 0
    while i < scene.node_count {
        let x = scene.nodes[i as usize].layout.x
        let y = scene.nodes[i as usize].layout.y
        let w = scene.nodes[i as usize].layout.w
        let h = scene.nodes[i as usize].layout.h
        if px >= x && px < x + w && py >= y && py < y + h {
            found = i
        }
        i = i + 1
    }
    found
}

pub fn viz_scene_pointer_down(scene: &!VizScene, px: i64, py: i64) -> i64 with Mut, Div {
    let idx = viz_scene_hit_test(scene, px, py)
    scene.selected_node = idx
    if idx >= 0 && idx < scene.node_count && viz_scene_is_focusable_node(scene, idx) {
        scene.focused_node = idx
    }
    var i: i64 = 0
    while i < scene.node_count {
        scene.nodes[i as usize].selected = i == idx
        i = i + 1
    }
    viz_scene_activate_control(scene, idx, px, py)
    idx
}

pub fn viz_scene_pointer_move(scene: &!VizScene, px: i64, py: i64) -> i64 with Mut {
    let idx = viz_scene_hit_test(scene, px, py)
    scene.hovered_node = idx
    idx
}

pub fn viz_scene_pointer_up(scene: &!VizScene, px: i64, py: i64) -> i64 with Mut {
    let idx = viz_scene_hit_test(scene, px, py)
    scene.hovered_node = idx
    scene.selected_node = 0 - 1
    var i: i64 = 0
    while i < scene.node_count {
        scene.nodes[i as usize].selected = false
        i = i + 1
    }
    idx
}

pub fn viz_scene_pointer_update(scene: &!VizScene, px: i64, py: i64) -> i64 with Mut, Div {
    var idx = scene.selected_node
    if idx < 0 || idx >= scene.node_count {
        idx = viz_scene_hit_test(scene, px, py)
        scene.selected_node = idx
    }
    if idx < 0 || idx >= scene.node_count { return idx }
    let kind = scene.nodes[idx as usize].kind
    let slot = scene.nodes[idx as usize].data_slot
    if kind == VIZ_NODE_CONTROL && slot == VIZ_CONTROL_SLIDER {
        let lw = scene.nodes[idx as usize].layout.w
        let lx = scene.nodes[idx as usize].layout.x
        let min_v = scene.nodes[idx as usize].min_value
        let max_v = scene.nodes[idx as usize].max_value
        let denom = if lw <= 0 { 1 } else { lw }
        var rel = px - lx
        if rel < 0 { rel = 0 }
        if rel > denom { rel = denom }
        let frac = (rel as f64) / (denom as f64)
        let value = min_v + frac * (max_v - min_v)
        viz_scene_set_time_from_slider(scene, idx, value)
    } else if kind == VIZ_NODE_CONTROL && slot == VIZ_CONTROL_TABS {
        viz_scene_activate_control(scene, idx, px, py)
    }
    idx
}

fn viz_scene_step_slider_key(scene: &!VizScene, node_idx: i64, direction: i64) with Mut {
    if node_idx < 0 || node_idx >= scene.node_count { return }
    let min_v = scene.nodes[node_idx as usize].min_value
    let max_v = scene.nodes[node_idx as usize].max_value
    let cur = scene.nodes[node_idx as usize].value
    let step = (max_v - min_v) / 10.0
    viz_scene_set_time_from_slider(scene, node_idx, cur + step * (direction as f64))
}

fn viz_scene_step_tab_key(scene: &!VizScene, node_idx: i64, direction: i64) with Mut {
    if node_idx < 0 || node_idx >= scene.node_count { return }
    let tab = (scene.nodes[node_idx as usize].value as i64) + direction
    viz_scene_set_tab(scene, node_idx, tab)
}

pub fn viz_scene_key_press(scene: &!VizScene, key: i64) -> bool with Mut {
    if key == KEY_TAB {
        return viz_scene_focus_next(scene) >= 0
    }
    var idx = scene.selected_node
    if idx < 0 || idx >= scene.node_count {
        idx = scene.hovered_node
    }
    if idx < 0 || idx >= scene.node_count {
        idx = scene.focused_node
    }
    if idx < 0 || idx >= scene.node_count {
        return false
    }
    let kind = scene.nodes[idx as usize].kind
    let slot = scene.nodes[idx as usize].data_slot
    if kind == VIZ_NODE_CONTROL && slot == VIZ_CONTROL_SLIDER {
        if key == KEY_LEFT {
            viz_scene_step_slider_key(scene, idx, 0 - 1)
            return true
        }
        if key == KEY_RIGHT {
            viz_scene_step_slider_key(scene, idx, 1)
            return true
        }
    } else if kind == VIZ_NODE_CONTROL && slot == VIZ_CONTROL_TABS {
        if key == KEY_LEFT {
            viz_scene_step_tab_key(scene, idx, 0 - 1)
            return true
        }
        if key == KEY_RIGHT {
            viz_scene_step_tab_key(scene, idx, 1)
            return true
        }
    } else if kind == VIZ_NODE_CONTROL && slot == VIZ_CONTROL_TOGGLE {
        if key == KEY_SPACE || key == KEY_RETURN {
            viz_scene_toggle(scene, idx)
            return true
        }
    }
    false
}

pub fn viz_scene_handle_event(scene: &!VizScene, ev: Event) -> bool with Mut, Div {
    if ev.kind == EV_MOUSE_PRESS && ev.key == MOUSE_LEFT {
        viz_scene_pointer_down(scene, ev.x, ev.y)
        return true
    }
    if ev.kind == EV_MOTION {
        if scene.selected_node >= 0 {
            viz_scene_pointer_update(scene, ev.x, ev.y)
        } else {
            viz_scene_pointer_move(scene, ev.x, ev.y)
        }
        return true
    }
    if ev.kind == EV_MOUSE_RELEASE && ev.key == MOUSE_LEFT {
        viz_scene_pointer_up(scene, ev.x, ev.y)
        return true
    }
    if ev.kind == EV_KEY_PRESS {
        return viz_scene_key_press(scene, ev.key)
    }
    false
}

// A scientific axis occupies no series slot. flags: 0=horizontal, 1=vertical;
// data_slot stores the requested interval count. Label is a short ASCII unit/title.
// Returns -1 without scene mutation for invalid/unreadable plans or geometry.
// Caller reserves margins for endpoint labels and title.
pub const VIZ_NODE_AXIS: i64 = 20

pub fn viz_add_axis(scene: &!VizScene, lo: f64, hi: f64, intervals: i64,
    vertical: bool, layout: VizLayout, style: VizStyle) -> i64 with Mut, Div {
    let ticks = axis_ticks(lo, hi, intervals)
    if ticks.status != 0 { return 0 - 1 }
    if layout.x < 0 - 1000000 || layout.x > 1000000 { return 0 - 1 }
    if layout.y < 0 - 1000000 || layout.y > 1000000 { return 0 - 1 }
    if layout.w < 1 || layout.w > 1000000 || layout.h < 1 || layout.h > 1000000 { return 0 - 1 }
    // Longest label is 13 glyphs; 112 px leaves one glyph of separation.
    if !vertical && layout.w < intervals * 112 { return 0 - 1 }
    if vertical && layout.h < intervals * 12 { return 0 - 1 }
    let idx = viz_scene_add_node(scene, VIZ_NODE_AXIS, layout, style, intervals)
    if idx < 0 { return idx }
    scene.nodes[idx as usize].min_value = lo
    scene.nodes[idx as usize].max_value = hi
    scene.nodes[idx as usize].flags = if vertical { 1 } else { 0 }
    idx
}

// Opt-in actual canonical-cell label fitting; legacy viz_add_axis unchanged.
pub const VIZ_FLAG_FITTED_AXIS:i64=65536
pub struct FittedAxisResult {
 pub status:i64,pub node:i64,pub intervals:i64,
 pub required_left:i64,pub required_right:i64,pub required_top:i64,pub required_bottom:i64,
}
pub fn viz_add_fitted_axis(scene:&!VizScene,lo:f64,hi:f64,max_intervals:i64,
 vertical:bool,layout:VizLayout,document_w:i64,document_h:i64,spec:&ScaleSpec,
 style:VizStyle)->FittedAxisResult with Mut,Div {
 var out=FittedAxisResult{status:1,node:-1,intervals:0,
 required_left:0,required_right:0,required_top:0,required_bottom:0}
 if !scatter_geometry(layout.x,layout.y,layout.w,layout.h) ||
    style.stroke_width!=1 || style.alpha!=255 ||
    style.r<0 || style.r>255 || style.g<0 || style.g>255 || style.b<0 || style.b>255 {return out}
 if scene.node_count<0 || scene.node_count>=64 {out.status=4;return out}
 let extent=if vertical {layout.h} else {layout.w}
 let plan=axis_fit_labels(lo,hi,max_intervals,vertical,layout.x,layout.y,extent,document_w,document_h,spec)
 out.status=plan.status
 out.required_left=plan.required_left;out.required_right=plan.required_right
 out.required_top=plan.required_top;out.required_bottom=plan.required_bottom
 if plan.status!=0 {return out}
 let node=viz_scene_add_node(scene,VIZ_NODE_AXIS,layout,style,plan.intervals)
 scene.nodes[node as usize].min_value=lo;scene.nodes[node as usize].max_value=hi
 scene.nodes[node as usize].value=spec.constant
 scene.nodes[node as usize].flags=VIZ_FLAG_FITTED_AXIS+spec.mode*2+(if vertical {1}else{0})
 out.node=node;out.intervals=plan.intervals
 out
}

// Opt-in clipping for linear polylines. Domain belongs to the shared series.
pub const VIZ_FLAG_CLIP_PLOT: i64 = 256
pub fn viz_line_set_viewport(scene: &!VizScene, node_idx: i64,
    xmin: f64, xmax: f64, ymin: f64, ymax: f64) -> bool with Mut {
    if node_idx < 0 || node_idx >= scene.node_count { return false }
    let kind: i64 = scene.nodes[node_idx as usize].kind
    let stroke: i64 = scene.nodes[node_idx as usize].style.stroke_width
    let data_slot: i64 = scene.nodes[node_idx as usize].data_slot
    let flags: i64 = scene.nodes[node_idx as usize].flags
    if (flags & 7680) != 0 { return false }
    let layout: VizLayout = scene.nodes[node_idx as usize].layout
    if kind != VIZ_NODE_CHART_LINE || stroke != 1 { return false }
    if data_slot < 0 || data_slot >= scene.series_count { return false }
    if layout.x < -1000000 || layout.y < -1000000 { return false }
    if layout.w < 1 || layout.h < 1 || layout.w > 1000000 || layout.h > 1000000 { return false }
    if layout.x > 1000000 - layout.w || layout.y > 1000000 - layout.h { return false }
    if !viz_interval_finite(xmin) || !viz_interval_finite(xmax) || !viz_interval_finite(ymin) || !viz_interval_finite(ymax) { return false }
    let dx: f64 = xmax - xmin
    let dy: f64 = ymax - ymin
    if dx <= 0.0 || dy <= 0.0 || !viz_interval_finite(dx) || !viz_interval_finite(dy) { return false }
    let slot = data_slot as usize
    scene.series[slot].x_min = xmin; scene.series[slot].x_max = xmax
    scene.series[slot].y_min = ymin; scene.series[slot].y_max = ymax
    scene.nodes[node_idx as usize].flags = flags | VIZ_FLAG_CLIP_PLOT
    true
}

// Snapshot the chart style, so the legend sample represents the same series.
// Visible text is bounded by the shared 8px-cell layout; full label stays in IR.
pub fn viz_add_series_legend(scene: &!VizScene, chart_idx: i64, text: &[i8; 64],
    len: i64, layout: VizLayout) -> i64 with Mut, Div {
    if chart_idx < 0 || chart_idx >= scene.node_count || len < 1 || len > 64 { return 0 - 1 }
    let kind: i64 = scene.nodes[chart_idx as usize].kind
    let style: VizStyle = scene.nodes[chart_idx as usize].style
    if kind != VIZ_NODE_CHART_LINE && kind != VIZ_NODE_CHART_SCATTER &&
       kind != VIZ_NODE_CHART_BAR && kind != VIZ_NODE_FOREST { return 0 - 1 }
    var k: i64 = 0
    while k < len {
        let ch = text[k as usize] as i64
        if ch < 32 || ch > 126 { return 0 - 1 }
        k = k + 1
    }
    let plan = legend_layout(layout.x, layout.y, layout.w, layout.h, len)
    if plan.status != 0 || plan.visible_len < 1 { return 0 - 1 }
    viz_add_legend(scene, text, len, layout, style)
}

// Typed vertical standard-uncertainty bar on a raw linear two-point series.
// Bounds must already equal center +/- u. Level0 means no coverage probability.
// All validation precedes mutation; existing interval labels cannot be replaced.
pub fn viz_line_set_standard_uncertainty(scene:&!VizScene,node_idx:i64,
 center:f64,u:f64)->bool with Mut,Div,Panic {
 if node_idx<0 || node_idx>=scene.node_count {return false}
 let kind:i64=scene.nodes[node_idx as usize].kind
 let slot:i64=scene.nodes[node_idx as usize].data_slot
 let flags:i64=scene.nodes[node_idx as usize].flags
 if kind!=VIZ_NODE_CHART_LINE || slot<0 || slot>=scene.series_count {return false}
 if (flags & 7680)!=0 {return false}
 let count:i64=scene.series[slot as usize].n
 let previous:i64=scene.series[slot as usize].interval_kind
 if count!=2 || (previous!=VIZ_INTERVAL_NONE && previous!=VIZ_INTERVAL_STANDARD_UNCERTAINTY) {return false}
 if !viz_interval_finite(center) || !viz_interval_finite(u) || u<0.0 {return false}
 let lower=center-u
 let upper=center+u
 if !viz_interval_finite(lower) || !viz_interval_finite(upper) {return false}
 let x0:f64=scene.series[slot as usize].xs[0]
 let x1:f64=scene.series[slot as usize].xs[1]
 let y0:f64=scene.series[slot as usize].ys[0]
 let y1:f64=scene.series[slot as usize].ys[1]
 if !viz_interval_finite(x0) || x0!=x1 || y0!=lower || y1!=upper {return false}
 scene.series[slot as usize].lower[0]=lower
 scene.series[slot as usize].lower[1]=lower
 scene.series[slot as usize].upper[0]=upper
 scene.series[slot as usize].upper[1]=upper
 scene.series[slot as usize].interval_level=0.0
 scene.series[slot as usize].interval_kind=VIZ_INTERVAL_STANDARD_UNCERTAINTY
 return true
}

// Checked raw-linear scatter viewport. Validate completely before mutation.
pub fn viz_scatter_set_viewport(scene:&!VizScene,node_idx:i64,
    xmin:f64,xmax:f64,ymin:f64,ymax:f64)->bool with Mut {
    if node_idx < 0 || node_idx >= scene.node_count { return false }
    let slot:i64=scene.nodes[node_idx as usize].data_slot
    if scene.nodes[node_idx as usize].kind != VIZ_NODE_CHART_SCATTER ||
       slot < 0 || slot >= scene.series_count { return false }
    let flags:i64=scene.nodes[node_idx as usize].flags
    if (flags & 7680) != 0 { return false }
    let layout:VizLayout=scene.nodes[node_idx as usize].layout
    if !scatter_geometry(layout.x,layout.y,layout.w,layout.h) { return false }
    let style:VizStyle=scene.nodes[node_idx as usize].style
    if style.stroke_width != 1 || style.alpha != 255 ||
       style.r < 0 || style.r > 255 || style.g < 0 || style.g > 255 ||
       style.b < 0 || style.b > 255 { return false }
    if !scatter_finite(xmin) || !scatter_finite(xmax) ||
       !scatter_finite(ymin) || !scatter_finite(ymax) { return false }
    let dx=xmax-xmin; let dy=ymax-ymin
    if dx <= 0.0 || dy <= 0.0 || !scatter_finite(dx) || !scatter_finite(dy) { return false }
    scene.series[slot as usize].x_min=xmin; scene.series[slot as usize].x_max=xmax
    scene.series[slot as usize].y_min=ymin; scene.series[slot as usize].y_max=ymax
    scene.nodes[node_idx as usize].flags=flags | VIZ_FLAG_CLIP_PLOT
    true
}


// Raw-linear bars may be cropped to a window excluding zero.
pub fn viz_bar_set_viewport(scene:&!VizScene,node_idx:i64,
    xmin:f64,xmax:f64,ymin:f64,ymax:f64)->bool with Mut {
    if node_idx < 0 || node_idx >= scene.node_count { return false }
    let slot:i64=scene.nodes[node_idx as usize].data_slot
    if scene.nodes[node_idx as usize].kind != VIZ_NODE_CHART_BAR ||
       slot < 0 || slot >= scene.series_count { return false }
    let flags:i64=scene.nodes[node_idx as usize].flags
    if (flags & 7680) != 0 { return false }
    let layout:VizLayout=scene.nodes[node_idx as usize].layout
    if !scatter_geometry(layout.x,layout.y,layout.w,layout.h) { return false }
    let style:VizStyle=scene.nodes[node_idx as usize].style
    if style.stroke_width != 1 || style.alpha != 255 ||
       style.r < 0 || style.r > 255 || style.g < 0 || style.g > 255 ||
       style.b < 0 || style.b > 255 { return false }
    if !scatter_finite(xmin) || !scatter_finite(xmax) ||
       !scatter_finite(ymin) || !scatter_finite(ymax) { return false }
    let dx=xmax-xmin; let dy=ymax-ymin
    if dx <= 0.0 || dy <= 0.0 || !scatter_finite(dx) || !scatter_finite(dy) { return false }
    scene.series[slot as usize].x_min=xmin; scene.series[slot as usize].x_max=xmax
    scene.series[slot as usize].y_min=ymin; scene.series[slot as usize].y_max=ymax
    scene.nodes[node_idx as usize].flags=flags | VIZ_FLAG_CLIP_PLOT
    true
}
