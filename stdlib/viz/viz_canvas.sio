// stdlib/viz/viz_canvas.sio — Visual IR renderer to display::Canvas

use display::canvas::{Canvas, canvas_set_pixel, canvas_fill_rect, canvas_draw_rect, canvas_draw_text, canvas_fill_circle}
use display::canvas_ext::{canvas_draw_line_aa, PixelScissor, canvas_draw_line_aa_scissored}
use viz::coord::{coord_new, coord_draw_axes, coord_draw_frame}
use viz::chart::{chart_line, chart_heatmap}
use viz::epiviz::{epiviz_band}
use render::renderer3d::{Camera3D, Light3D, Tri3D, r3d_depth_buf_alloc, r3d_depth_buf_clear, r3d_render_viewport}
