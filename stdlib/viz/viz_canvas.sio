    VizScene, VizNode, VIZ_NODE_AXIS, VIZ_FLAG_CLIP_PLOT, VIZ_FLAG_FITTED_AXIS,
    VIZ_NODE_PANEL, VIZ_NODE_CHART_LINE, VIZ_NODE_CHART_SCATTER, VIZ_NODE_CHART_BAR,
    VIZ_NODE_HEATMAP, VIZ_NODE_UNCERTAINTY_BAND, VIZ_NODE_LABEL, VIZ_NODE_CONTROL,
    VIZ_NODE_FOREST, VIZ_NODE_WATERFALL,
    VIZ_INTERVAL_NONE,
    VIZ_NODE_MOLECULE, VIZ_NODE_FIELD, VIZ_NODE_VECTOR_FIELD, VIZ_NODE_TRAJECTORY, VIZ_NODE_SPECTRUM, VIZ_NODE_MESH,
    VIZ_CONTROL_SLIDER, VIZ_CONTROL_TOGGLE, VIZ_CONTROL_TABS, VIZ_CONTROL_LEGEND,
    VIZ_CONTROL_BUTTON, VIZ_CONTROL_TOOLTIP, VIZ_CONTROL_VIEWPORT
}

fn vc_pad_range_min(v: f64) -> f64 { v - 0.001 }
fn vc_pad_range_max(v: f64) -> f64 { v + 0.001 }

fn vc_draw_panel(c: &!Canvas, node: &VizNode) with Mut {
    canvas_fill_rect(c, node.layout.x, node.layout.y, node.layout.w, node.layout.h, 18, 22, 28)
    canvas_draw_rect(c, node.layout.x, node.layout.y, node.layout.w, node.layout.h, 80, 95, 110)
}

fn vc_draw_control(c: &!Canvas, node: &VizNode) with Mut, Div {
    let x = node.layout.x
    let y = node.layout.y
    let w = node.layout.w
    let h = node.layout.h
    if node.data_slot == VIZ_CONTROL_SLIDER {
        canvas_fill_rect(c, x, y + h / 2 - 2, w, 4, 55, 60, 70)
        let span = node.max_value - node.min_value
        let frac = if span == 0.0 { 0.0 } else { (node.value - node.min_value) / span }
        let knob_x = x + (frac * (w as f64)) as i64
        canvas_fill_rect(c, knob_x - 3, y, 7, h, node.style.r, node.style.g, node.style.b)
    } else if node.data_slot == VIZ_CONTROL_TOGGLE {
        canvas_draw_rect(c, x, y, w, h, 130, 150, 160)
        if node.value > 0.0 {
            canvas_fill_rect(c, x + 3, y + 3, w - 6, h - 6, node.style.r, node.style.g, node.style.b)
        }
    } else if node.data_slot == VIZ_CONTROL_TABS {
        canvas_fill_rect(c, x, y, w, h, 40, 48, 58)
        let min_i = node.min_value as i64
        let max_i = node.max_value as i64
        var count = max_i - min_i + 1
        if count <= 0 { count = 1 }
        let tab_w = if w / count <= 0 { 1 } else { w / count }
        var active = node.value as i64
        if active < min_i { active = min_i }
        if active > max_i { active = max_i }
        canvas_fill_rect(c, x + (active - min_i) * tab_w, y, tab_w, h, node.style.r, node.style.g, node.style.b)
        canvas_draw_rect(c, x, y, w, h, 120, 135, 150)
    } else if node.data_slot == VIZ_CONTROL_LEGEND {
        canvas_draw_rect(c, x, y, w, h, 120, 135, 150)
        let plan = legend_layout(x, y, w, h, node.label_len)
        if plan.status == 0 {
            canvas_fill_rect(c, plan.swatch_x, plan.swatch_y, 10, 6, node.style.r, node.style.g, node.style.b)
            var text: [i8; 256] = [0; 256]
            var k: i64 = 0
            while k < plan.visible_len { text[k as usize] = node.label[k as usize]; k = k + 1 }
            canvas_draw_text(c, &text, plan.visible_len, plan.text_x, plan.text_y, node.style.r, node.style.g, node.style.b)
        }
    } else if node.data_slot == VIZ_CONTROL_TOOLTIP {
        canvas_fill_rect(c, x, y, w, h, 28, 34, 42)
        canvas_draw_rect(c, x, y, w, h, 140, 155, 170)
        vc_draw_label(c, node)
    } else if node.data_slot == VIZ_CONTROL_VIEWPORT || node.data_slot == VIZ_CONTROL_BUTTON {
        canvas_draw_rect(c, x, y, w, h, 120, 135, 150)
        vc_draw_label(c, node)
    }
}

fn vc_draw_label(c: &!Canvas, node: &VizNode) with Mut {
    var buf: [i8; 256] = [0; 256]
    var i: i64 = 0
    while i < node.label_len && i < 64 {
        buf[i as usize] = node.label[i as usize]
        i = i + 1
    }
    canvas_draw_text(c, &buf, node.label_len, node.layout.x, node.layout.y, node.style.r, node.style.g, node.style.b)
}

fn vc_clamp(v: i64, lo: i64, hi: i64) -> i64 {
    if v < lo { lo } else if v > hi { hi } else { v }
}

fn vc_sqrt(x: f64) -> f64 with Mut, Div {
    if x <= 0.0 { return 0.0 }
    var g = x
    var i: i64 = 0
    while i < 12 {
        g = (g + x / g) * 0.5
        i = i + 1
    }
    g
}

fn vc_draw_waterfall(scene: &VizScene, c: &!Canvas, node: &VizNode) with Mut, Div {
    let d = scene.series[node.data_slot as usize]
    if d.n <= 0 { return }
    canvas_draw_rect(c, node.layout.x, node.layout.y, node.layout.w, node.layout.h, 80, 95, 110)
    let row_h = vc_clamp(node.layout.h / d.n - 2, 3, 24)
    let span = if d.y_max == d.y_min { 1.0 } else { d.y_max - d.y_min }
    var i: i64 = 0
    while i < d.n && i < 1024 {
        let frac = (d.ys[i as usize] - d.y_min) / span
        let bar_w = vc_clamp((frac * (node.layout.w as f64)) as i64, 1, node.layout.w)
        let py = node.layout.y + i * (row_h + 2)
        canvas_fill_rect(c, node.layout.x, py, bar_w, row_h, node.style.r, node.style.g, node.style.b)
        canvas_fill_rect(c, node.layout.x + bar_w, py, node.layout.w - bar_w, row_h, 36, 40, 50)
        i = i + 1
    }
}

fn vc_forest_rect(c:&!Canvas,rx:i64,ry:i64,rw:i64,rh:i64,x:i64,y:i64,w:i64,h:i64,r:i64,g:i64,b:i64) with Mut {
 let clipped=forest_clip_rect(rx,ry,rw,rh,x,y,w,h)
 if clipped.status==0 {
  let cx:i64=clipped.x;let cy:i64=clipped.y;let cw:i64=clipped.w;let ch:i64=clipped.h
  canvas_fill_rect(c,cx,cy,cw,ch,r,g,b)
 }
}
fn vc_draw_forest(scene:&VizScene,c:&!Canvas,idx:i64) with Mut,Div,Panic {
 let slot:i64=scene.nodes[idx as usize].data_slot
 if slot<0 || slot>=scene.series_count {return}
 let n:i64=scene.series[slot as usize].n
 let x:i64=scene.nodes[idx as usize].layout.x
 let y:i64=scene.nodes[idx as usize].layout.y
 let w:i64=scene.nodes[idx as usize].layout.w
 let h:i64=scene.nodes[idx as usize].layout.h
 let r:i64=scene.nodes[idx as usize].style.r
 let g:i64=scene.nodes[idx as usize].style.g
 let b:i64=scene.nodes[idx as usize].style.b
 let xmin:f64=scene.series[slot as usize].x_min
 let xmax:f64=scene.series[slot as usize].x_max
 let kind:i64=scene.series[slot as usize].interval_kind
 let level:f64=scene.series[slot as usize].interval_level
 let layout=forest_layout(n,x,y,w,h)
 if layout.status!=0 || !forest_domain(xmin,xmax) {return}
 if !forest_prefix(&scene.series[slot as usize].xs,&scene.series[slot as usize].vars,
  &scene.series[slot as usize].lower,&scene.series[slot as usize].upper,n,kind,level) {return}
 canvas_draw_rect(c,x,y,w,h,90,95,120)
 var i:i64=0
 while i<n {
  let e:f64=scene.series[slot as usize].xs[i as usize]
  var lo:f64=scene.series[slot as usize].lower[i as usize]
  var hi:f64=scene.series[slot as usize].upper[i as usize]
  if kind==0 {
   let bounds=uncertainty_bounds(e,scene.series[slot as usize].vars[i as usize])
   lo=bounds.lower;hi=bounds.upper
  }
  let row=forest_project(e,lo,hi,i,n,xmin,xmax,x,y,w,h)
  if row.status==0 {
   let cy:i64=row.center
   let left:i64=row.left
   let right:i64=row.right
   let estimate:i64=row.estimate
   vc_forest_rect(c,left,cy,right-left+1,1,x,y,w,h,180,180,220)
   if row.lower_cap {vc_forest_rect(c,left,cy-2,1,5,x,y,w,h,180,180,220)}
   if row.upper_cap {vc_forest_rect(c,right,cy-2,1,5,x,y,w,h,180,180,220)}
   if row.marker {vc_forest_rect(c,estimate-3,cy-3,7,7,x,y,w,h,r,g,b)}
  }
  i=i+1
 }
}

fn vc_mol_x(node: &VizNode, x: f64) -> i64 {
    node.layout.x + node.layout.w / 2 + (x * (node.layout.w as f64) * 0.30) as i64
}

fn vc_mol_y(node: &VizNode, y: f64) -> i64 {
    node.layout.y + node.layout.h / 2 - (y * (node.layout.h as f64) * 0.30) as i64
}

fn vc_draw_molecule(scene: &VizScene, c: &!Canvas, node: &VizNode) with Mut, Div {
    canvas_draw_rect(c, node.layout.x, node.layout.y, node.layout.w, node.layout.h, 120, 130, 150)
    if node.data_slot < 0 || node.data_slot >= scene.molecule_count { return }
    let slot = node.data_slot as usize
    var bond_count = scene.molecules[slot].bond_count
    if bond_count < 0 { bond_count = 0 }
    if bond_count > 96 { bond_count = 96 }
    var atom_count = scene.molecules[slot].atom_count
    if atom_count < 0 { atom_count = 0 }
    if atom_count > 64 { atom_count = 64 }
    var bi: i64 = 0
    while bi < bond_count {
        let b = scene.molecules[slot].bonds[bi as usize]
        if b.atom_a >= 0 && b.atom_a < atom_count && b.atom_b >= 0 && b.atom_b < atom_count {
            let a0 = scene.molecules[slot].atoms[b.atom_a as usize]
            let a1 = scene.molecules[slot].atoms[b.atom_b as usize]
            let x0 = vc_mol_x(node, a0.x)
            let y0 = vc_mol_y(node, a0.y)
            let x1 = vc_mol_x(node, a1.x)
            let y1 = vc_mol_y(node, a1.y)
            canvas_draw_line_aa(c, x0, y0, x1, y1, 180, 190, 205)
            if b.order > 1 {
                canvas_draw_line_aa(c, x0, y0 + 2, x1, y1 + 2, 150, 160, 175)
            }
        }
        bi = bi + 1
    }
    let cx = node.layout.x + node.layout.w / 2
    let cy = node.layout.y + node.layout.h / 2
    canvas_fill_rect(c, cx - 2, cy - 2, 5, 5, node.style.r, node.style.g, node.style.b)
    var ai: i64 = 0
    while ai < atom_count {
        let a = scene.molecules[slot].atoms[ai as usize]
        let sx = vc_mol_x(node, a.x)
        let sy = vc_mol_y(node, a.y)
        let rad = vc_clamp((a.radius * 8.0) as i64, 3, 12)
        canvas_fill_circle(c, sx, sy, rad, a.r, a.g, a.b)
        canvas_fill_rect(c, sx - 1, sy - 1, 3, 3, a.r, a.g, a.b)
        canvas_draw_rect(c, sx - rad, sy - rad, rad * 2 + 1, rad * 2 + 1, 40, 45, 55)
        ai = ai + 1
    }
}

fn vc_draw_field(scene: &VizScene, c: &!Canvas, node: &VizNode) with Mut, Div {
    let rows: i64 = 8
    let cols: i64 = 8
    let cell_w = if cols == 0 { 1 } else { node.layout.w / cols }
    let cell_h = if rows == 0 { 1 } else { node.layout.h / rows }
    var rr: i64 = 0
    while rr < rows {
        var cc: i64 = 0
        while cc < cols {
            let intensity = (rr * 24 + cc * 12) % 220
            canvas_fill_rect(c, node.layout.x + cc * cell_w, node.layout.y + rr * cell_h, cell_w + 1, cell_h + 1, intensity / 3, 80 + intensity / 4, 130 + intensity / 3)
            cc = cc + 1
        }
        rr = rr + 1
    }
    canvas_draw_rect(c, node.layout.x, node.layout.y, node.layout.w, node.layout.h, 90, 120, 130)
    let cx = node.layout.x + node.layout.w / 2
    let cy = node.layout.y + node.layout.h / 2
    canvas_draw_line_aa(c, cx - cell_w, cy, cx + cell_w, cy, 240, 240, 180)
    canvas_draw_line_aa(c, cx, cy - cell_h, cx, cy + cell_h, 240, 240, 180)
}

fn vc_draw_vector_field(scene: &VizScene, c: &!Canvas, node: &VizNode) with Mut, Div {
    let f = scene.vector_data[node.data_slot as usize]
    let rows = scene.vector_field_rows[node.data_slot as usize]
    let cols = scene.vector_field_cols[node.data_slot as usize]
    let cell_w = if cols <= 0 { 1 } else { node.layout.w / cols }
    let cell_h = if rows <= 0 { 1 } else { node.layout.h / rows }
    canvas_draw_rect(c, node.layout.x, node.layout.y, node.layout.w, node.layout.h, 120, 110, 70)
    var rr: i64 = 0
    while rr < rows && rr < 32 {
        var cc: i64 = 0
        while cc < cols && cc < 32 {
            let idx = rr * cols + cc
            let cx = node.layout.x + cc * cell_w + cell_w / 2
            let cy = node.layout.y + rr * cell_h + cell_h / 2
            let dx = vc_clamp((f.vx[idx as usize] * 3.0) as i64, 0 - cell_w / 2, cell_w / 2)
            let dy = vc_clamp((f.vy[idx as usize] * 3.0) as i64, 0 - cell_h / 2, cell_h / 2)
            canvas_draw_line_aa(c, cx, cy, cx + dx, cy + dy, node.style.r, node.style.g, node.style.b)
            canvas_fill_rect(c, cx + dx - 1, cy + dy - 1, 3, 3, node.style.r, node.style.g, node.style.b)
            cc = cc + 1
        }
        rr = rr + 1
    }
}

fn vc_traj_x(node: &VizNode, x: f64, z: f64) -> i64 {
    node.layout.x + node.layout.w / 2 + (x * (node.layout.w as f64) * 0.35) as i64 + (z * 2.0) as i64
}

fn vc_traj_y(node: &VizNode, y: f64, z: f64) -> i64 {
    node.layout.y + node.layout.h / 2 - (y * (node.layout.h as f64) * 0.35) as i64 - (z * 2.0) as i64
}

fn vc_draw_trajectory(scene: &VizScene, c: &!Canvas, node: &VizNode) with Mut, Div {
    let tr = scene.trajectory_data[node.data_slot as usize]
    canvas_draw_rect(c, node.layout.x, node.layout.y, node.layout.w, node.layout.h, 120, 95, 150)
    var i: i64 = 1
    while i < tr.n && i < 1024 {
        let x0 = vc_traj_x(node, tr.x[(i - 1) as usize], tr.z[(i - 1) as usize])
        let y0 = vc_traj_y(node, tr.y[(i - 1) as usize], tr.z[(i - 1) as usize])
        let x1 = vc_traj_x(node, tr.x[i as usize], tr.z[i as usize])
        let y1 = vc_traj_y(node, tr.y[i as usize], tr.z[i as usize])
        canvas_draw_line_aa(c, x0, y0, x1, y1, node.style.r, node.style.g, node.style.b)
        i = i + 1
    }
    if tr.n > 0 {
        let sx = vc_traj_x(node, tr.x[0], tr.z[0])
        let sy = vc_traj_y(node, tr.y[0], tr.z[0])
        canvas_fill_rect(c, sx - 2, sy - 2, 5, 5, 180, 230, 190)
        let last = tr.n - 1
        let ex = vc_traj_x(node, tr.x[last as usize], tr.z[last as usize])
        let ey = vc_traj_y(node, tr.y[last as usize], tr.z[last as usize])
        canvas_fill_rect(c, ex - 2, ey - 2, 5, 5, 255, 180, 130)
        var cur = scene.time as i64
        if cur < 0 { cur = 0 }
        if cur >= tr.n { cur = tr.n - 1 }
        let tx = vc_traj_x(node, tr.x[cur as usize], tr.z[cur as usize])
        let ty = vc_traj_y(node, tr.y[cur as usize], tr.z[cur as usize])
        canvas_draw_rect(c, tx - 4, ty - 4, 9, 9, 255, 245, 120)
    }
}

fn vc_spec_x(node: &VizNode, x: f64, xmin: f64, xmax: f64) -> i64 {
    let span = if xmax == xmin { 1.0 } else { xmax - xmin }
    node.layout.x + (((x - xmin) / span) * (node.layout.w as f64)) as i64
}

fn vc_spec_y(node: &VizNode, y: f64, ymin: f64, ymax: f64) -> i64 {
    let span = if ymax == ymin { 1.0 } else { ymax - ymin }
    node.layout.y + node.layout.h - (((y - ymin) / span) * (node.layout.h as f64)) as i64
}

fn vc_draw_spectrum(scene: &VizScene, c: &!Canvas, node: &VizNode) with Mut, Div {
    let s = scene.spectrum_data[node.data_slot as usize]
    canvas_draw_rect(c, node.layout.x, node.layout.y, node.layout.w, node.layout.h, 140, 110, 70)
    var i: i64 = 1
    while i < s.n && i < 1024 {
        let x0 = vc_spec_x(node, s.x[(i - 1) as usize], s.x_min, s.x_max)
        let y0 = vc_spec_y(node, s.intensity[(i - 1) as usize], s.y_min, s.y_max)
        let x1 = vc_spec_x(node, s.x[i as usize], s.x_min, s.x_max)
        let y1 = vc_spec_y(node, s.intensity[i as usize], s.y_min, s.y_max)
        canvas_draw_line_aa(c, x0, y0, x1, y1, node.style.r, node.style.g, node.style.b)
        i = i + 1
    }
}

fn vc_draw_mesh(scene: &VizScene, c: &!Canvas, node: &VizNode) with Mut, Div, Alloc {
    let m = scene.meshes[node.data_slot as usize]
    var tris: [Tri3D; 4096] = [m.tris[0]; 4096]
    var i: i64 = 0
    while i < m.n && i < 128 {
        tris[i as usize] = m.tris[i as usize]
        i = i + 1
    }
    let cam = Camera3D { pos_x: 0.0, pos_y: 0.0, pos_z: 0.0, focal: (node.layout.w as f64) * 0.8 }
    let light = Light3D { dx: 0.0, dy: 0.0, dz: 1.0, r: 255, g: 255, b: 255, ambient: 0.35 }
    let depth = r3d_depth_buf_alloc(c.width, c.height)
    r3d_depth_buf_clear(depth, c.width, c.height)
    r3d_render_viewport(&tris, m.n, &cam, &light, depth, c, node.layout.x, node.layout.y, node.layout.w, node.layout.h)
    heap_free(depth as *mut i8)
    canvas_draw_rect(c, node.layout.x, node.layout.y, node.layout.w, node.layout.h, 120, 130, 150)
}

fn vc_draw_scatter(scene:&VizScene,c:&!Canvas,idx:i64) with Mut,Div {
    let slot:i64=scene.nodes[idx as usize].data_slot
    if slot < 0 || slot >= scene.series_count { return }
    let x:i64=scene.nodes[idx as usize].layout.x
    let y:i64=scene.nodes[idx as usize].layout.y
    let w:i64=scene.nodes[idx as usize].layout.w
    let h:i64=scene.nodes[idx as usize].layout.h
    let red:i64=scene.nodes[idx as usize].style.r
    let green:i64=scene.nodes[idx as usize].style.g
    let blue:i64=scene.nodes[idx as usize].style.b
    let clipped=(scene.nodes[idx as usize].flags & VIZ_FLAG_CLIP_PLOT) != 0
    let xmin:f64=scene.series[slot as usize].x_min
    let xmax:f64=scene.series[slot as usize].x_max
    let ymin:f64=scene.series[slot as usize].y_min
    let ymax:f64=scene.series[slot as usize].y_max
    let domain_check=scatter_project(xmin,ymin,xmin,xmax,ymin,ymax,x,y,w,h,false)
    if domain_check.status != 0 { return }
    if !clipped {
        var y_zero:i64=y+h-1
        var x_zero:i64=x
        if ymin <= 0.0 && ymax >= 0.0 {
            let axis_point=scatter_project(xmin,0.0,xmin,xmax,ymin,ymax,x,y,w,h,false)
            if axis_point.status == 0 { y_zero=axis_point.y }
        }
        if xmin <= 0.0 && xmax >= 0.0 {
            let axis_point=scatter_project(0.0,ymin,xmin,xmax,ymin,ymax,x,y,w,h,false)
            if axis_point.status == 0 { x_zero=axis_point.x }
        }
        canvas_fill_rect(c,x,y_zero,w,1,220,220,220)
        canvas_fill_rect(c,x_zero,y,1,h,220,220,220)
        let cs=coord_new(xmin,xmax,ymin,ymax,x,y,w,h)
        coord_draw_frame(&cs,c)
    }
    var i:i64=0
    while i < scene.series[slot as usize].n && i < 1024 {
        let sx:f64=scene.series[slot as usize].xs[i as usize]
        let sy:f64=scene.series[slot as usize].ys[i as usize]
        let point=scatter_project(sx,sy,xmin,xmax,ymin,ymax,x,y,w,h,clipped)
        if point.status == 0 {
            let px:i64=point.x; let py:i64=point.y
            if clipped {
                var dy:i64 = -3
                while dy <= 3 {
                    var dx:i64 = -3
                    while dx <= 3 {
                        let qx=px+dx; let qy=py+dy
                        if dx*dx+dy*dy <= 9 && qx >= x && qx <= x+w && qy >= y && qy <= y+h {
                            canvas_set_pixel(c,qx,qy,red,green,blue)
                        }
                        dx=dx+1
                    }
                    dy=dy+1
                }
            } else {
                canvas_fill_rect(c,px-3,py,7,1,red,green,blue)
                canvas_fill_rect(c,px,py-3,1,7,red,green,blue)
            }
        }
        i=i+1
    }
}

fn vc_draw_bar(scene:&VizScene,c:&!Canvas,idx:i64) with Mut,Div {
    let slot:i64=scene.nodes[idx as usize].data_slot
    if slot < 0 || slot >= scene.series_count { return }
    let x:i64=scene.nodes[idx as usize].layout.x
    let y:i64=scene.nodes[idx as usize].layout.y
    let w:i64=scene.nodes[idx as usize].layout.w
    let h:i64=scene.nodes[idx as usize].layout.h
    let red:i64=scene.nodes[idx as usize].style.r
    let green:i64=scene.nodes[idx as usize].style.g
    let blue:i64=scene.nodes[idx as usize].style.b
    let clipped=(scene.nodes[idx as usize].flags & VIZ_FLAG_CLIP_PLOT) != 0
    let xmin:f64=scene.series[slot as usize].x_min
    let xmax:f64=scene.series[slot as usize].x_max
    let ymin:f64=scene.series[slot as usize].y_min
    let ymax:f64=scene.series[slot as usize].y_max
    let domain_check=scatter_project(xmin,ymin,xmin,xmax,ymin,ymax,x,y,w,h,false)
    if domain_check.status != 0 { return }
    if !clipped {
        var y_zero:i64=y+h-1
        var x_zero:i64=x
        if ymin <= 0.0 && ymax >= 0.0 {
            let axis_point=scatter_project(xmin,0.0,xmin,xmax,ymin,ymax,x,y,w,h,false)
            if axis_point.status == 0 { y_zero=axis_point.y }
        }
        if xmin <= 0.0 && xmax >= 0.0 {
            let axis_point=scatter_project(0.0,ymin,xmin,xmax,ymin,ymax,x,y,w,h,false)
            if axis_point.status == 0 { x_zero=axis_point.x }
        }
        canvas_fill_rect(c,x,y_zero,w,1,220,220,220)
        canvas_fill_rect(c,x_zero,y,1,h,220,220,220)
        let cs=coord_new(xmin,xmax,ymin,ymax,x,y,w,h)
        coord_draw_frame(&cs,c)
    }
    var first:f64=0.0; var second:f64=0.0
    var pairs:i64=0
    var scan:i64=0
    while scan < scene.series[slot as usize].n && scan < 1024 && pairs < 2 {
        let sx:f64=scene.series[slot as usize].xs[scan as usize]
        let sy:f64=scene.series[slot as usize].ys[scan as usize]
        if scatter_finite(sx) && scatter_finite(sy) {
            if pairs == 0 { first=sx } else { second=sx }
            pairs=pairs+1
        }
        scan=scan+1
    }
    let width=bar_pair_width(first,second,pairs,xmin,xmax,x,w)
    if width.status != 0 { return }
    var i:i64=0
    while i < scene.series[slot as usize].n && i < 1024 {
        let sx:f64=scene.series[slot as usize].xs[i as usize]
        let sy:f64=scene.series[slot as usize].ys[i as usize]
        let rect=bar_project(sx,sy,xmin,xmax,ymin,ymax,x,y,w,h,width.value,clipped)
        if rect.status == 0 {
            let rx:i64=rect.x; let ry:i64=rect.y
            let rw:i64=rect.w; let rh:i64=rect.h
            canvas_fill_rect(c,rx,ry,rw,rh,red,green,blue)
        }
        i=i+1
    }
}

// Dedicated band path: direct scalar loads, shared checked geometry.
fn vc_draw_uncertainty_band(scene:&VizScene,c:&!Canvas,node_idx:i64) with Mut,Div,Panic {
 let slot:i64=scene.nodes[node_idx as usize].data_slot
 if slot<0 || slot>=scene.series_count {return}
 let xmin:f64=scene.series[slot as usize].x_min
 let xmax:f64=scene.series[slot as usize].x_max
 let ymin:f64=scene.series[slot as usize].y_min
 let ymax:f64=scene.series[slot as usize].y_max
 let x:i64=scene.nodes[node_idx as usize].layout.x
 let y:i64=scene.nodes[node_idx as usize].layout.y
 let w:i64=scene.nodes[node_idx as usize].layout.w
 let h:i64=scene.nodes[node_idx as usize].layout.h
 let r:i64=scene.nodes[node_idx as usize].style.r
 let g:i64=scene.nodes[node_idx as usize].style.g
 let b:i64=scene.nodes[node_idx as usize].style.b
 let n:i64=scene.series[slot as usize].n
 let cs=coord_new(xmin,xmax,ymin,ymax,x,y,w,h)
 epiviz_band(&cs,&scene.series[slot as usize].xs,&scene.series[slot as usize].ys,&scene.series[slot as usize].vars,n,c,r,g,b)
}

pub fn viz_canvas_render_scene(scene: &VizScene, c: &!Canvas) with Mut, Div, Alloc, Panic {
    var i: i64 = 0
    while i < scene.node_count {
        let node = scene.nodes[i as usize]
        if node.kind == VIZ_NODE_PANEL {
            vc_draw_panel(c, &node)
        } else if node.kind == VIZ_NODE_AXIS {
            vc_draw_axis(c, &node)
        } else if node.kind == VIZ_NODE_LABEL {
            vc_draw_label(c, &node)
        } else if node.kind == VIZ_NODE_CONTROL {
            vc_draw_control(c, &node)
        } else if node.kind == VIZ_NODE_CHART_LINE && (node.flags & VIZ_FLAG_CLIP_PLOT) != 0 {
            vc_draw_clipped_line(scene, c, &node)
        } else if node.kind == VIZ_NODE_CHART_SCATTER {
            vc_draw_scatter(scene,c,i)
        } else if node.kind == VIZ_NODE_CHART_BAR {
            vc_draw_bar(scene,c,i)
        } else if node.kind == VIZ_NODE_UNCERTAINTY_BAND {
            vc_draw_uncertainty_band(scene,c,i)
        } else if node.kind == VIZ_NODE_CHART_LINE {
            let d = scene.series[node.data_slot as usize]
            let x0 = if d.x_min == d.x_max { vc_pad_range_min(d.x_min) } else { d.x_min }
            let x1 = if d.x_min == d.x_max { vc_pad_range_max(d.x_max) } else { d.x_max }
            let y0 = if d.y_min == d.y_max { vc_pad_range_min(d.y_min) } else { d.y_min }
            let y1 = if d.y_min == d.y_max { vc_pad_range_max(d.y_max) } else { d.y_max }
            let cs = coord_new(x0, x1, y0, y1, node.layout.x, node.layout.y, node.layout.w, node.layout.h)
            coord_draw_axes(&cs, c)
            chart_line(&cs, &d.xs, &d.ys, d.n, c, node.style.r, node.style.g, node.style.b)
        } else if node.kind == VIZ_NODE_HEATMAP {
            let h = scene.heatmaps[node.data_slot as usize]
            let cs = coord_new(0.0, h.cols as f64, 0.0, h.rows as f64, node.layout.x, node.layout.y, node.layout.w, node.layout.h)
            chart_heatmap(&cs, &h.values, h.rows, h.cols, h.min_value, h.max_value, c)
            coord_draw_axes(&cs, c)
        } else if node.kind == VIZ_NODE_FOREST {
            vc_draw_forest(scene,c,i)
        } else if node.kind == VIZ_NODE_WATERFALL {
            vc_draw_waterfall(scene, c, &node)
        } else if node.kind == VIZ_NODE_MOLECULE {
            vc_draw_molecule(scene, c, &node)
        } else if node.kind == VIZ_NODE_FIELD {
            vc_draw_field(scene, c, &node)
        } else if node.kind == VIZ_NODE_VECTOR_FIELD {
            vc_draw_vector_field(scene, c, &node)
        } else if node.kind == VIZ_NODE_TRAJECTORY {
            vc_draw_trajectory(scene, c, &node)
        } else if node.kind == VIZ_NODE_SPECTRUM {
            vc_draw_spectrum(scene, c, &node)
        } else if node.kind == VIZ_NODE_MESH {
            vc_draw_mesh(scene, c, &node)
        }
        i = i + 1
    }
}

fn vc_draw_axis(c:&!Canvas,node:&VizNode) with Mut,Div {
 let flags:i64=node.flags
 if flags<0 {return}
 let fitted=(flags & VIZ_FLAG_FITTED_AXIS)!=0
 let low=flags-(if fitted {VIZ_FLAG_FITTED_AXIS}else{0})
 if low<0 || low>5 {return}
 let spec=ScaleSpec{mode:low/2,constant:if low<2 {1.0}else{node.value}}
 let intervals:i64=node.data_slot
 let ticks=axis_scaled_ticks(node.min_value,node.max_value,intervals,&spec)
 if ticks.status!=0 {return}
 let vertical=(low & 1)==1
 let x=node.layout.x;let y=node.layout.y
 let extent=if vertical {node.layout.h}else{node.layout.w}
 let plan=axis_measure_labels(&ticks,vertical,x,y,extent,c.width,c.height)
 if plan.status==1 || (fitted && plan.status!=0) {return}
 // Legacy axes keep their historic overlap/outside behavior. Both paths
 // now obtain label placement from the same canonical-cell planner.
 if vertical {canvas_fill_rect(c,x,y,1,node.layout.h+1,node.style.r,node.style.g,node.style.b)}
 else {canvas_fill_rect(c,x,y,node.layout.w+1,1,node.style.r,node.style.g,node.style.b)}
 var text:[i8;256]=[0;256]
 var i:i64=0
 while i<ticks.n {
  // Recompute canonical text from its scalar tick; preserve planned geometry.
  let label=axis_label(ticks.values[i as usize])
  var j:i64=0
  while j<label.n {text[j as usize]=label.text[j as usize];j=j+1}
  let px:i64=plan.tick_x[i as usize];let py:i64=plan.tick_y[i as usize]
  if vertical {canvas_fill_rect(c,px-4,py,5,1,node.style.r,node.style.g,node.style.b)}
  else {canvas_fill_rect(c,px,py,1,5,node.style.r,node.style.g,node.style.b)}
  let tx:i64=plan.text_x[i as usize];let ty:i64=plan.text_y[i as usize]
  canvas_draw_text(c,&text,label.n,tx,ty,node.style.r,node.style.g,node.style.b)
  i=i+1
 }
    var title: [i8; 256] = [0; 256]
    var k: i64 = 0
    while k < node.label_len && k < 64 {
        title[k as usize] = node.label[k as usize]
        k = k + 1
    }
    let title_y = if vertical { y - 16 } else { y + 24 }
    canvas_draw_text(c, &title, k, x, title_y, node.style.r, node.style.g, node.style.b)
}

fn vc_draw_clipped_line(scene: &VizScene, c: &!Canvas, node: &VizNode) with Mut, Div {
    let slot = node.data_slot as usize
    let count: i64 = scene.series[slot].n
    let d = &scene.series[slot]
    let sc = PixelScissor { left: node.layout.x, top: node.layout.y,
        right: node.layout.x + node.layout.w, bottom: node.layout.y + node.layout.h }
    var i: i64 = 0
    while i + 1 < count && i + 1 < 1024 {
        let seg = clip_series_segment(d.xs[i as usize], d.ys[i as usize],
            d.xs[(i+1) as usize], d.ys[(i+1) as usize], d.x_min, d.x_max, d.y_min, d.y_max)
        if seg.status == 0 {
            let x0: i64 = clip_pixel(node.layout.x, node.layout.w, seg.x0)
            let x1: i64 = clip_pixel(node.layout.x, node.layout.w, seg.x1)
            let y0: i64 = clip_pixel(node.layout.y, node.layout.h, 1.0 - seg.y0)
            let y1: i64 = clip_pixel(node.layout.y, node.layout.h, 1.0 - seg.y1)
            canvas_draw_line_aa_scissored(c, &sc, x0, y0, x1, y1, node.style.r, node.style.g, node.style.b)
        }
        i = i + 1
    }
}
