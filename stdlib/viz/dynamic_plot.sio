// Compact borrowed scientific plot geometry; payloads stay in checked owners.
use math::pure::{is_finite}
use collections::numeric_buffer::{NumericBuffer,numeric_buffer_status,numeric_buffer_len,numeric_buffer_at}
use collections::integer_buffer::{IntegerBuffer,integer_buffer_status,integer_buffer_len,integer_buffer_at}
use display::canvas::{Canvas,canvas_fill_rect}
use display::canvas_ext::{PixelScissor,canvas_draw_line_aa_scissored}
use viz::scatter::{scatter_geometry,scatter_project}
use viz::uncertainty::{UncertaintySegment,uncertainty_domain,uncertainty_segment,uncertainty_raster_segment}
use viz::forest::{ForestRect,forest_clip_rect}
pub struct DynamicPlotSpec {pub x:i64,pub y:i64,pub w:i64,pub h:i64,pub xmin:f64,pub xmax:f64,pub ymin:f64,pub ymax:f64,pub r:i64,pub g:i64,pub b:i64,pub interval_kind:i64,pub level:f64}
pub struct DynamicPlotResult {pub status:i64,pub input_count:i64,pub selected_count:i64,pub visible_primitives:i64}
fn dp_result(status:i64,n:i64,count:i64)->DynamicPlotResult {DynamicPlotResult{status:status,input_count:n,selected_count:count,visible_primitives:0}}
fn dp_spec(s:&DynamicPlotSpec)->bool {
 if !scatter_geometry(s.x,s.y,s.w,s.h) || !uncertainty_domain(s.xmin,s.xmax,s.ymin,s.ymax) {return false}
 if s.r<0 || s.r>255 || s.g<0 || s.g>255 || s.b<0 || s.b>255 {return false}
 true
}
fn dp_payload(s:&DynamicPlotSpec,x:&NumericBuffer,y:&NumericBuffer,a:&IntegerBuffer)->i64 with Mut,Panic {
 if !dp_spec(s) {return 1}
 if numeric_buffer_status(x)!=0 || numeric_buffer_status(y)!=0 || integer_buffer_status(a)!=0 {return 2}
 let n=numeric_buffer_len(x)
 if numeric_buffer_len(y)!=n || integer_buffer_len(a)!=n {return 2}
 var i:i64=0
 while i<n {
  let flag=integer_buffer_at(a,i)
  if flag!=0 && flag!=1 {return 3}
  if flag==1 {
   if !is_finite(numeric_buffer_at(x,i)) || !is_finite(numeric_buffer_at(y,i)) {return 3}
  }
  i=i+1
 }
 0
}
fn dp_segment(s:&DynamicPlotSpec,x:&NumericBuffer,y:&NumericBuffer,left:i64,right:i64)->UncertaintySegment with Mut,Div,Panic {
 uncertainty_segment(numeric_buffer_at(x,left),numeric_buffer_at(y,left),numeric_buffer_at(x,right),numeric_buffer_at(y,right),s.xmin,s.xmax,s.ymin,s.ymax,s.x,s.y,s.w,s.h)
}
fn dp_line_check(s:&DynamicPlotSpec,x:&NumericBuffer,y:&NumericBuffer,a:&IntegerBuffer,indices:&IntegerBuffer,count:i64)->i64 with Mut,Div,Panic {
 let status=dp_payload(s,x,y,a)
 if status!=0 {return status}
 if s.interval_kind!=0 || s.level!=0.0 {return 1}
 if integer_buffer_status(indices)!=0 {return 2}
 if count<0 || count>integer_buffer_len(indices) {return 2}
 let n=numeric_buffer_len(x)
 var i:i64=0
 var previous:i64= -1
 var selected:i64=0
 while selected<count {
  let index=integer_buffer_at(indices,selected)
  if index<0 || index>=n || index<=previous {return 4}
  // Every source gap run must have its first original index selected. Never
  // rely on && to protect an indexed read on this compiler family.
  while i<index {
   if integer_buffer_at(a,i)==0 {
    var first=true
    if i>0 {if integer_buffer_at(a,i-1)==0 {first=false}}
    if first {return 4}
   }
   i=i+1
  }
  if previous>=0 {
   if integer_buffer_at(a,previous)==1 {
    if integer_buffer_at(a,index)==1 {
     let segment=dp_segment(s,x,y,previous,index)
     if segment.status==2 {return 5}
    }
   }
  }
  previous=index
  i=index+1
  selected=selected+1
 }
 while i<n {
  if integer_buffer_at(a,i)==0 {
   var first=true
   if i>0 {if integer_buffer_at(a,i-1)==0 {first=false}}
   if first {return 4}
  }
  i=i+1
 }
 0
}
fn dp_scissor(s:&DynamicPlotSpec,c:&Canvas)->PixelScissor {
 var left=s.x;var top=s.y;var right=s.x+s.w;var bottom=s.y+s.h
 if left<0 {left=0};if top<0 {top=0}
 if right>=c.width {right=c.width-1};if bottom>=c.height {bottom=c.height-1}
 PixelScissor{left:left,top:top,right:right,bottom:bottom}
}
fn dp_canvas_valid(c:&Canvas)->bool {c.width>0 && c.height>0 && c.width<=1000000 && c.height<=1000000 && (c.pixels as i64)>0}
fn dp_svg_color(s:&DynamicPlotSpec) with IO {
 let r:i64=s.r;let g:i64=s.g;let b:i64=s.b
 print("rgb(");print(r);print(",");print(g);print(",");print(b);print(")")
}
fn dp_svg_begin(s:&DynamicPlotSpec,id:i64) with IO {
 let px:f64=(s.x as f64)-0.5;let py:f64=(s.y as f64)-0.5
 let width:i64=s.w+1;let height:i64=s.h+1
 print("<defs><clipPath clipPathUnits=\"userSpaceOnUse\" id=\"dynamic-clip-");print(id)
 print("\"><rect x=\"");print(px);print("\" y=\"");print(py);print("\" width=\"");print(width);print("\" height=\"");print(height)
 println("\"/></clipPath></defs>")
 print("<g clip-path=\"url(#dynamic-clip-");print(id);println(")\">")
}
fn dp_svg_segment(s:&DynamicPlotSpec,seg:&UncertaintySegment) with IO {
 let x0:i64=seg.x0;let y0:i64=seg.y0;let x1:i64=seg.x1;let y1:i64=seg.y1
 print("<line data-dynamic-part=\"line\" x1=\"");print(x0);print("\" y1=\"");print(y0)
 print("\" x2=\"");print(x1);print("\" y2=\"");print(y1);print("\" stroke=\"");dp_svg_color(s)
 println("\" stroke-width=\"1\" stroke-linecap=\"round\"/>")
}
// Exact shared preflight for composed documents; no output or raster mutation.
pub fn dynamic_line_validate(s:&DynamicPlotSpec,x:&NumericBuffer,y:&NumericBuffer,a:&IntegerBuffer,indices:&IntegerBuffer,count:i64)->i64 with Mut,Div,Panic {
 dp_line_check(s,x,y,a,indices,count)
}
pub fn dynamic_line_canvas(c:&!Canvas,s:&DynamicPlotSpec,x:&NumericBuffer,y:&NumericBuffer,a:&IntegerBuffer,indices:&IntegerBuffer,count:i64)->DynamicPlotResult with Mut,Div,Panic {
 let n=numeric_buffer_len(x)
 let status=dp_line_check(s,x,y,a,indices,count)
 var result=dp_result(status,n,count)
 if status!=0 {return result}
 if !dp_canvas_valid(c) {result.status=1;return result}
 let sc=dp_scissor(s,c)
 var k:i64=1
 while k<count {
  let left=integer_buffer_at(indices,k-1);let right=integer_buffer_at(indices,k)
  if integer_buffer_at(a,left)==1 {
   if integer_buffer_at(a,right)==1 {
    let segment=dp_segment(s,x,y,left,right)
    if segment.status==0 {
     let raster=uncertainty_raster_segment(segment.x0,segment.y0,segment.x1,segment.y1,sc.left,sc.top,sc.right,sc.bottom)
     if raster.status==0 {canvas_draw_line_aa_scissored(c,&sc,raster.x0,raster.y0,raster.x1,raster.y1,s.r,s.g,s.b);result.visible_primitives=result.visible_primitives+1}
    }
   }
  }
  k=k+1
 }
 result
}
// Emits an SVG fragment. Caller owns the root SVG and supplies a unique id>=0.
pub fn dynamic_line_svg(s:&DynamicPlotSpec,x:&NumericBuffer,y:&NumericBuffer,a:&IntegerBuffer,indices:&IntegerBuffer,count:i64,id:i64)->DynamicPlotResult with IO,Mut,Div,Panic {
 let n=numeric_buffer_len(x)
 let status=dp_line_check(s,x,y,a,indices,count)
 var result=dp_result(status,n,count)
 if status!=0 {return result}
 if id<0 {result.status=1;return result}
 dp_svg_begin(s,id)
 println("<metadata data-dynamic-series=\"ordered-line\" data-reduction=\"original-indices\"/>")
 var k:i64=1
 while k<count {
  let left=integer_buffer_at(indices,k-1);let right=integer_buffer_at(indices,k)
  if integer_buffer_at(a,left)==1 {
   if integer_buffer_at(a,right)==1 {
    let segment=dp_segment(s,x,y,left,right)
    if segment.status==0 {dp_svg_segment(s,&segment);result.visible_primitives=result.visible_primitives+1}
   }
  }
  k=k+1
 }
 println("</g>")
 result
}
fn dp_interval_part(s:&DynamicPlotSpec,sx:f64,mean:f64,lo:f64,hi:f64,part:i64)->ForestRect with Mut,Div {
 let empty=ForestRect{status:1,x:0,y:0,w:0,h:0}
 if hi<s.ymin || lo>s.ymax {return empty}
 let span=s.xmax-s.xmin
 if span==0.0 {if sx!=s.xmin {return empty}} else {
  let unit=(sx-s.xmin)/span
  if !is_finite(unit) {return empty}
  if unit<0.0 {if unit*(s.w as f64)< -2.0 {return empty}}
  if unit>1.0 {if (unit-1.0)*(s.w as f64)>2.0 {return empty}}
 }
 let lower=if lo<s.ymin {s.ymin}else{lo}
 let upper=if hi>s.ymax {s.ymax}else{hi}
 let bottom=scatter_project(sx,lower,s.xmin,s.xmax,s.ymin,s.ymax,s.x,s.y,s.w,s.h,false)
 let top=scatter_project(sx,upper,s.xmin,s.xmax,s.ymin,s.ymax,s.x,s.y,s.w,s.h,false)
 if bottom.status!=0 || top.status!=0 {return ForestRect{status:2,x:0,y:0,w:0,h:0}}
 if part==0 {return forest_clip_rect(top.x,top.y,1,bottom.y-top.y+1,s.x,s.y,s.w,s.h)}
 if part==1 {
  if lo<s.ymin || lo>s.ymax {return empty}
  return forest_clip_rect(bottom.x-2,bottom.y,5,1,s.x,s.y,s.w,s.h)
 }
 if part==2 {
  if hi<s.ymin || hi>s.ymax {return empty}
  return forest_clip_rect(top.x-2,top.y,5,1,s.x,s.y,s.w,s.h)
 }
 if mean<s.ymin || mean>s.ymax {return empty}
 let point=scatter_project(sx,mean,s.xmin,s.xmax,s.ymin,s.ymax,s.x,s.y,s.w,s.h,false)
 if point.status!=0 {return ForestRect{status:2,x:0,y:0,w:0,h:0}}
 forest_clip_rect(point.x-1,point.y-1,3,3,s.x,s.y,s.w,s.h)
}
fn dp_interval_check(s:&DynamicPlotSpec,x:&NumericBuffer,mean:&NumericBuffer,lower:&NumericBuffer,upper:&NumericBuffer,a:&IntegerBuffer)->i64 with Mut,Div,Panic {
 let status=dp_payload(s,x,mean,a)
 if status!=0 {return status}
 if s.interval_kind<1 || s.interval_kind>4 || !is_finite(s.level) {return 1}
 if s.interval_kind==4 {if s.level!=0.0 {return 1}} else {if s.level<=0.0 || s.level>=1.0 {return 1}}
 let n=numeric_buffer_len(x)
 if numeric_buffer_status(lower)!=0 || numeric_buffer_status(upper)!=0 {return 2}
 if numeric_buffer_len(lower)!=n || numeric_buffer_len(upper)!=n {return 2}
 var i:i64=0
 while i<n {
  if integer_buffer_at(a,i)==1 {
   let lo=numeric_buffer_at(lower,i);let hi=numeric_buffer_at(upper,i);let value=numeric_buffer_at(mean,i)
   if !is_finite(lo) || !is_finite(hi) || lo>value || value>hi {return 3}
   var part:i64=0
   while part<4 {
    let rect=dp_interval_part(s,numeric_buffer_at(x,i),value,lo,hi,part)
    if rect.status==2 {return 5}
    part=part+1
   }
  }
  i=i+1
 }
 0
}
fn dp_svg_rect(s:&DynamicPlotSpec,rect:&ForestRect,part:i64) with IO {
 let x:f64=(rect.x as f64)-0.5;let y:f64=(rect.y as f64)-0.5
 let w:i64=rect.w;let h:i64=rect.h
 print("<rect data-dynamic-interval-part=\"");print(part);print("\" x=\"");print(x);print("\" y=\"");print(y)
 print("\" width=\"");print(w);print("\" height=\"");print(h);print("\" fill=\"");dp_svg_color(s);println("\"/>")
}
pub fn dynamic_interval_canvas(c:&!Canvas,s:&DynamicPlotSpec,x:&NumericBuffer,mean:&NumericBuffer,lower:&NumericBuffer,upper:&NumericBuffer,a:&IntegerBuffer)->DynamicPlotResult with Mut,Div,Panic {
 let n=numeric_buffer_len(x)
 let status=dp_interval_check(s,x,mean,lower,upper,a)
 var result=dp_result(status,n,n)
 if status!=0 {return result}
 if !dp_canvas_valid(c) {result.status=1;return result}
 var i:i64=0
 while i<n {
  if integer_buffer_at(a,i)==1 {
   var part:i64=0
   while part<4 {
    let rect=dp_interval_part(s,numeric_buffer_at(x,i),numeric_buffer_at(mean,i),numeric_buffer_at(lower,i),numeric_buffer_at(upper,i),part)
    if rect.status==0 {
     var left=rect.x;var top=rect.y;var right=rect.x+rect.w;var bottom=rect.y+rect.h
     if left<0 {left=0};if top<0 {top=0}
     if right>c.width {right=c.width};if bottom>c.height {bottom=c.height}
     if right>left && bottom>top {canvas_fill_rect(c,left,top,right-left,bottom-top,s.r,s.g,s.b);result.visible_primitives=result.visible_primitives+1}
    }
    part=part+1
   }
  }
  i=i+1
 }
 result
}
pub fn dynamic_interval_svg(s:&DynamicPlotSpec,x:&NumericBuffer,mean:&NumericBuffer,lower:&NumericBuffer,upper:&NumericBuffer,a:&IntegerBuffer,id:i64)->DynamicPlotResult with IO,Mut,Div,Panic {
 let n=numeric_buffer_len(x)
 let status=dp_interval_check(s,x,mean,lower,upper,a)
 var result=dp_result(status,n,n)
 if status!=0 {return result}
 if id<0 {result.status=1;return result}
 dp_svg_begin(s,id)
 let kind:i64=s.interval_kind;let level:f64=s.level
 print("<metadata data-dynamic-series=\"supplied-intervals\" data-interval-kind=\"");print(kind);print("\" data-interval-level=\"");print(level);println("\"/>")
 var i:i64=0
 while i<n {
  if integer_buffer_at(a,i)==1 {
   var part:i64=0
   while part<4 {
    let rect=dp_interval_part(s,numeric_buffer_at(x,i),numeric_buffer_at(mean,i),numeric_buffer_at(lower,i),numeric_buffer_at(upper,i),part)
    if rect.status==0 {dp_svg_rect(s,&rect,part);result.visible_primitives=result.visible_primitives+1}
    part=part+1
   }
  }
  i=i+1
 }
 println("</g>")
 result
}
