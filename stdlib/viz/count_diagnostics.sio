// Actual fixed-alpha CountGLM outputs -> borrowed descriptive scientific figure.
use collections::numeric_buffer::{NumericBuffer,numeric_buffer_status,numeric_buffer_len,numeric_buffer_at,numeric_buffer_set}
use collections::integer_buffer::{IntegerBuffer,integer_buffer_status,integer_buffer_len,integer_buffer_at,integer_buffer_set}
use stats::regression::dynamic_count_glm::{DynamicCountFit}
use stats::regression::nb2_deviance::{nb2_deviance_slot,nb2_deviance_into,nb2_deviance_slot_residual}
use viz::scientific_document::{ScientificDocumentPlan,ScientificDocumentText,ScientificDocumentResult,scientific_two_panel_plan,scientific_document_svg,scientific_document_canvas}
use display::canvas::{Canvas}
use math::pure::{is_finite}
pub struct CountDiagnosticData {
 pub status:i64,pub n:i64,pub residual_available:i64,pub residual_unavailable:i64,pub first_unavailable_status:i64,
 pub count_max:f64,pub residual_bound:f64,pub alpha:f64,pub payload_bytes:i64,
 pub assumptions_assessed:bool,pub inference_available:bool,
}
fn cd_empty()->CountDiagnosticData {
 CountDiagnosticData{status:1,n:0,residual_available:0,residual_unavailable:0,first_unavailable_status:0,
 count_max:0.0,residual_bound:0.0,alpha:0.0,payload_bytes:0,assumptions_assessed:false,inference_available:false}
}
// Aggregate output payload budget, excluding inputs and constant metadata.
pub fn count_diagnostic_workspace(n:i64)->i64 with Div {
 if n<1 || n>9223372036854775807/32 {return -1}
 n*32
}
// Outputs: observed[count], signed_deviance[dimensionless], and two 0/1 masks.
// A finite signed residual remains available even if its square overflows.
// Structural/payload errors leave ALL outputs unchanged. Arithmetic-unavailable
// residuals are explicit masked placeholders, never silently dropped/calibrated.
pub fn count_diagnostic_prepare(fit:&DynamicCountFit,counts:&IntegerBuffer,means:&NumericBuffer,
 observed:&!NumericBuffer,residual:&!NumericBuffer,observed_mask:&!IntegerBuffer,residual_mask:&!IntegerBuffer)->CountDiagnosticData with Mut,Div,Panic {
 var out=cd_empty()
 if fit.status!=0 || fit.rows<1 || !is_finite(fit.alpha) || fit.alpha<0.0 {return out}
 out.status=2
 if integer_buffer_status(counts)!=0 || numeric_buffer_status(means)!=0 || numeric_buffer_status(observed)!=0 ||
 numeric_buffer_status(residual)!=0 || integer_buffer_status(observed_mask)!=0 || integer_buffer_status(residual_mask)!=0 {return out}
 let n=fit.rows
 if integer_buffer_len(counts)!=n || numeric_buffer_len(means)!=n || numeric_buffer_len(observed)!=n ||
 numeric_buffer_len(residual)!=n || integer_buffer_len(observed_mask)!=n || integer_buffer_len(residual_mask)!=n {return out}
 let payload=count_diagnostic_workspace(n)
 if payload<0 {return out}
 out.status=3
 var i:i64=0
 while i<n {
  let count=integer_buffer_at(counts,i);let mean=numeric_buffer_at(means,i)
  if count<0 || count>9007199254740992 || !is_finite(mean) || mean<=0.0 {return out}
  i=i+1
 }
 var slot=nb2_deviance_slot()
 var maximum:f64=0.0;var bound:f64=0.0
 i=0
 while i<n {
  let count=integer_buffer_at(counts,i);let mean=numeric_buffer_at(means,i)
  if mean>maximum {maximum=mean};if (count as f64)>maximum {maximum=count as f64}
  let code=nb2_deviance_into(count,mean,fit.alpha,&!slot)
  if code==0 {
   let value=nb2_deviance_slot_residual(&slot);let magnitude=if value<0.0 {-value}else{value}
   if magnitude>bound {bound=magnitude}
   out.residual_available=out.residual_available+1
  } else {
   if out.residual_unavailable==0 {out.first_unavailable_status=code}
   out.residual_unavailable=out.residual_unavailable+1
  }
  i=i+1
 }
 i=0
 while i<n {
  let count=integer_buffer_at(counts,i);let mean=numeric_buffer_at(means,i)
  let code=nb2_deviance_into(count,mean,fit.alpha,&!slot)
  let ignored0=numeric_buffer_set(observed,i,count as f64)
  let ignored1=integer_buffer_set(observed_mask,i,1)
  let ignored2=integer_buffer_set(residual_mask,i,if code==0 {1}else{0})
  let value=if code==0 {nb2_deviance_slot_residual(&slot)}else{0.0}
  let ignored3=numeric_buffer_set(residual,i,value)
  i=i+1
 }
 out.status=0;out.n=n;out.alpha=fit.alpha;out.count_max=maximum
 out.residual_bound=if bound==0.0 {1.0}else{bound}
 out.payload_bytes=payload
 out
}
pub fn count_diagnostic_plan(data:&CountDiagnosticData,width:i64,height:i64)->ScientificDocumentPlan with Mut,Div {
 var plan=scientific_two_panel_plan(width,height,0.0,data.count_max,0.0,data.count_max,
 0.0,data.count_max,-data.residual_bound,data.residual_bound)
 if data.status!=0 || data.n<1 || !is_finite(data.alpha) || data.alpha<0.0 ||
 data.residual_available<0 || data.residual_unavailable<0 {plan.status=3;return plan}
 if data.residual_available>data.n {plan.status=3;return plan}
 if data.residual_unavailable!=data.n-data.residual_available {plan.status=3;return plan}
 plan.identity_left=true;plan.zero_right=true;plan.count_diagnostic=true
 plan.alpha=data.alpha;plan.unavailable=data.residual_unavailable
 plan
}
fn cd_render_valid(fit:&DynamicCountFit,data:&CountDiagnosticData,plan:&ScientificDocumentPlan,means:&NumericBuffer,
 observed:&NumericBuffer,residual:&NumericBuffer,observed_mask:&IntegerBuffer,residual_mask:&IntegerBuffer)->bool with Mut,Panic {
 if fit.status!=0 || data.status!=0 || data.n!=fit.rows || data.alpha!=fit.alpha || !plan.count_diagnostic ||
 plan.alpha!=data.alpha || plan.unavailable!=data.residual_unavailable || !plan.identity_left || !plan.zero_right {return false}
 if numeric_buffer_status(means)!=0 || numeric_buffer_status(observed)!=0 || numeric_buffer_status(residual)!=0 ||
 integer_buffer_status(observed_mask)!=0 || integer_buffer_status(residual_mask)!=0 {return false}
 if numeric_buffer_len(means)!=data.n || numeric_buffer_len(observed)!=data.n || numeric_buffer_len(residual)!=data.n ||
 integer_buffer_len(observed_mask)!=data.n || integer_buffer_len(residual_mask)!=data.n {return false}
 if plan.left.xmin!=0.0 || plan.left.xmax!=data.count_max || plan.left.ymin!=0.0 || plan.left.ymax!=data.count_max ||
 plan.right.xmin!=0.0 || plan.right.xmax!=data.count_max || plan.right.ymin!= -data.residual_bound || plan.right.ymax!=data.residual_bound {return false}
 var available:i64=0;var i:i64=0
 while i<data.n {
  if integer_buffer_at(observed_mask,i)!=1 {return false}
  let flag=integer_buffer_at(residual_mask,i)
  if flag==1 {available=available+1} else {if flag!=0 {return false}}
  i=i+1
 }
 available==data.residual_available
}
pub fn count_diagnostic_svg(fit:&DynamicCountFit,data:&CountDiagnosticData,plan:&ScientificDocumentPlan,
 text:&ScientificDocumentText,bytes:&IntegerBuffer,means:&NumericBuffer,observed:&NumericBuffer,residual:&NumericBuffer,
 observed_mask:&IntegerBuffer,residual_mask:&IntegerBuffer)->ScientificDocumentResult with IO,Mut,Div,Panic {
 if !cd_render_valid(fit,data,plan,means,observed,residual,observed_mask,residual_mask) {
  return ScientificDocumentResult{status:30,stage:0,left_painted:0,right_painted:0}
 }
 scientific_document_svg(plan,text,bytes,means,observed,observed_mask,means,residual,residual_mask)
}
pub fn count_diagnostic_canvas(c:&!Canvas,fit:&DynamicCountFit,data:&CountDiagnosticData,plan:&ScientificDocumentPlan,
 text:&ScientificDocumentText,bytes:&IntegerBuffer,means:&NumericBuffer,observed:&NumericBuffer,residual:&NumericBuffer,
 observed_mask:&IntegerBuffer,residual_mask:&IntegerBuffer)->ScientificDocumentResult with Mut,Div,Panic {
 if !cd_render_valid(fit,data,plan,means,observed,residual,observed_mask,residual_mask) {
  return ScientificDocumentResult{status:30,stage:0,left_painted:0,right_painted:0}
 }
 scientific_document_canvas(c,plan,text,bytes,means,observed,observed_mask,means,residual,residual_mask)
}
