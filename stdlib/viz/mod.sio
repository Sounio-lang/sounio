// stdlib/viz/mod.sio — Native visual frontend public map
//
// Concrete modules:
//   viz::coord       data-to-pixel coordinate systems
//   viz::chart       direct Canvas chart helpers
//   viz::epiviz      epistemic uncertainty charts
//   viz::sci         science-specific chart helpers
//   viz::ir          fixed-capacity Visual IR
//   viz::viz_canvas  Visual IR -> display::Canvas
//   viz::viz_html    Visual IR -> static HTML/SVG
//   viz::viz_app     Event -> Visual IR -> Canvas app/frame runner
//   viz::viz_window  Optional display::Window bridge for VizApp
//   viz::viz_replay  Deterministic event replay over VizApp + Canvas hashes
//   viz::inspector   Native Canvas inspector panel for Visual IR identity/state
//   viz::audit       Shared state hashes for Canvas/HTML/debug audit surfaces
//   viz::editor      Minimal selected-node scene editing over Visual IR
//   viz::workbench   Reusable native visual workbench scene blueprint
//   viz::physchem    molecule/field/trajectory visualization data

pub fn viz_version() -> i64 { 15 }

pub use viz::coord::{CoordSystem, coord_new, coord_map_x, coord_map_y}
pub use viz::ir::{VizScene, viz_scene_new, viz_layout_rect, viz_style_rgb}
