// stdlib/viz/snapshot.sio - bounded Visual IR scene snapshots
//
// Snapshots preserve the edit-facing Visual IR state: node identity, hierarchy,
// layout, style, labels, control values, selection/focus, molecule-studio
// state, counts, and the expected audit hash. Heavy scientific payload slots
// stay in VizScene; the snapshot is for native frontend authoring state.

use viz::audit::{viz_audit_hash, viz_audit_node_hash}
use viz::ir::{VizLayout, VizScene, VizStyle, viz_node_empty}

pub struct VizSceneSnapshot {
    pub node_id: [i64; 64],
    pub node_parent_id: [i64; 64],
    pub node_tag: [i64; 64],
    pub node_kind: [i64; 64],
    pub node_parent: [i64; 64],
    pub node_first_child: [i64; 64],
    pub node_next_sibling: [i64; 64],
    pub node_style_r: [i64; 64],
    pub node_style_g: [i64; 64],
    pub node_style_b: [i64; 64],
    pub node_style_alpha: [i64; 64],
    pub node_style_stroke_width: [i64; 64],
    pub node_style_fill: [bool; 64],
    pub node_style_palette: [i64; 64],
    pub node_style_font_scale: [i64; 64],
    pub node_layout_x: [i64; 64],
    pub node_layout_y: [i64; 64],
    pub node_layout_w: [i64; 64],
    pub node_layout_h: [i64; 64],
    pub node_layout_kind: [i64; 64],
    pub node_layout_gap: [i64; 64],
    pub node_data_slot: [i64; 64],
    pub node_flags: [i64; 64],
    pub node_value: [f64; 64],
    pub node_min_value: [f64; 64],
    pub node_max_value: [f64; 64],
    pub node_selected: [bool; 64],
    pub node_label: [i8; 4096],
    pub node_label_len: [i64; 64],
    pub node_count: i64,
    pub selected_node: i64,
    pub hovered_node: i64,
    pub focused_node: i64,
    pub selected_atom_node: i64,
    pub selected_atom_index: i64,
    pub molecule_studio_node: i64,
    pub molecule_tool: i64,
    pub molecule_unit: i64,
    pub molecule_pending_atom: i64,
    pub molecule_last_reason: i64,
    pub molecule_last_action: i64,
    pub molecule_accept_count: i64,
    pub molecule_reject_count: i64,
    pub molecule_timeline_count: i64,
    pub next_node_id: i64,
    pub active_tab: i64,
    pub time: f64,
    pub series_count: i64,
    pub heatmap_count: i64,
    pub molecule_count: i64,
    pub field_count: i64,
    pub vector_field_count: i64,
    pub trajectory_count: i64,
    pub spectrum_count: i64,
    pub lattice_count: i64,
    pub particle_event_count: i64,
    pub mesh_count: i64,
    pub audit_hash: i64,
    pub first_node_hash: i64,
}

pub fn viz_scene_snapshot_empty() -> VizSceneSnapshot {
    VizSceneSnapshot {
        node_id: [0; 64],
        node_parent_id: [0 - 1; 64],
        node_tag: [0; 64],
        node_kind: [0; 64],
        node_parent: [0; 64],
        node_first_child: [0; 64],
        node_next_sibling: [0; 64],
        node_style_r: [0; 64],
        node_style_g: [0; 64],
        node_style_b: [0; 64],
        node_style_alpha: [0; 64],
        node_style_stroke_width: [0; 64],
        node_style_fill: [false; 64],
        node_style_palette: [0; 64],
        node_style_font_scale: [0; 64],
        node_layout_x: [0; 64],
        node_layout_y: [0; 64],
        node_layout_w: [0; 64],
        node_layout_h: [0; 64],
        node_layout_kind: [0; 64],
        node_layout_gap: [0; 64],
        node_data_slot: [0; 64],
        node_flags: [0; 64],
        node_value: [0.0; 64],
        node_min_value: [0.0; 64],
        node_max_value: [0.0; 64],
        node_selected: [false; 64],
        node_label: [0; 4096],
        node_label_len: [0; 64],
        node_count: 0,
        selected_node: 0 - 1,
        hovered_node: 0 - 1,
        focused_node: 0 - 1,
        selected_atom_node: 0 - 1,
        selected_atom_index: 0 - 1,
        molecule_studio_node: 0 - 1,
        molecule_tool: 0,
        molecule_unit: 0,
        molecule_pending_atom: 0 - 1,
        molecule_last_reason: 0,
        molecule_last_action: 0,
        molecule_accept_count: 0,
        molecule_reject_count: 0,
        molecule_timeline_count: 0,
        next_node_id: 1,
        active_tab: 0,
        time: 0.0,
        series_count: 0,
        heatmap_count: 0,
        molecule_count: 0,
        field_count: 0,
        vector_field_count: 0,
        trajectory_count: 0,
        spectrum_count: 0,
        lattice_count: 0,
        particle_event_count: 0,
        mesh_count: 0,
        audit_hash: 0,
        first_node_hash: 0,
    }
}

fn viz_snapshot_count(n: i64, max_n: i64) -> i64 {
    if n < 0 { return 0 }
    if n > max_n { return max_n }
    n
}

pub fn viz_scene_snapshot(scene: &VizScene) -> VizSceneSnapshot with Mut {
    var snap = viz_scene_snapshot_empty()
    snap.node_count = viz_snapshot_count(scene.node_count, 64)
    snap.selected_node = scene.selected_node
    snap.hovered_node = scene.hovered_node
    snap.focused_node = scene.focused_node
    snap.selected_atom_node = scene.selected_atom_node
    snap.selected_atom_index = scene.selected_atom_index
    snap.molecule_studio_node = scene.molecule_studio_node
    snap.molecule_tool = scene.molecule_tool
    snap.molecule_unit = scene.molecule_unit
    snap.molecule_pending_atom = scene.molecule_pending_atom
    snap.molecule_last_reason = scene.molecule_last_reason
    snap.molecule_last_action = scene.molecule_last_action
    snap.molecule_accept_count = scene.molecule_accept_count
    snap.molecule_reject_count = scene.molecule_reject_count
    snap.molecule_timeline_count = scene.molecule_timeline_count
    snap.next_node_id = scene.next_node_id
    snap.active_tab = scene.active_tab
    snap.time = scene.time
    snap.series_count = viz_snapshot_count(scene.series_count, 8)
    snap.heatmap_count = viz_snapshot_count(scene.heatmap_count, 4)
    snap.molecule_count = viz_snapshot_count(scene.molecule_count, 4)
    snap.field_count = viz_snapshot_count(scene.field_count, 4)
    snap.vector_field_count = viz_snapshot_count(scene.vector_field_count, 4)
    snap.trajectory_count = viz_snapshot_count(scene.trajectory_count, 4)
    snap.spectrum_count = viz_snapshot_count(scene.spectrum_count, 4)
    snap.lattice_count = viz_snapshot_count(scene.lattice_count, 4)
    snap.particle_event_count = viz_snapshot_count(scene.particle_event_count, 4)
    snap.mesh_count = viz_snapshot_count(scene.mesh_count, 4)
    var i: i64 = 0
    while i < snap.node_count {
        let n = scene.nodes[i as usize]
        snap.node_id[i as usize] = n.id
        snap.node_parent_id[i as usize] = n.parent_id
        snap.node_tag[i as usize] = n.tag
        snap.node_kind[i as usize] = n.kind
        snap.node_parent[i as usize] = n.parent
        snap.node_first_child[i as usize] = n.first_child
        snap.node_next_sibling[i as usize] = n.next_sibling
        snap.node_style_r[i as usize] = n.style.r
        snap.node_style_g[i as usize] = n.style.g
        snap.node_style_b[i as usize] = n.style.b
        snap.node_style_alpha[i as usize] = n.style.alpha
        snap.node_style_stroke_width[i as usize] = n.style.stroke_width
        snap.node_style_fill[i as usize] = n.style.fill
        snap.node_style_palette[i as usize] = n.style.palette
        snap.node_style_font_scale[i as usize] = n.style.font_scale
        snap.node_layout_x[i as usize] = n.layout.x
        snap.node_layout_y[i as usize] = n.layout.y
        snap.node_layout_w[i as usize] = n.layout.w
        snap.node_layout_h[i as usize] = n.layout.h
        snap.node_layout_kind[i as usize] = n.layout.layout_kind
        snap.node_layout_gap[i as usize] = n.layout.gap
        snap.node_data_slot[i as usize] = n.data_slot
        snap.node_flags[i as usize] = n.flags
        snap.node_value[i as usize] = n.value
        snap.node_min_value[i as usize] = n.min_value
        snap.node_max_value[i as usize] = n.max_value
        snap.node_selected[i as usize] = n.selected
        snap.node_label_len[i as usize] = n.label_len
        var j: i64 = 0
        while j < 64 {
            snap.node_label[(i * 64 + j) as usize] = n.label[j as usize]
            j = j + 1
        }
        i = i + 1
    }
    snap.audit_hash = viz_audit_hash(scene)
    snap.first_node_hash = viz_audit_node_hash(scene, 0)
    snap
}

pub fn viz_scene_snapshot_hash(snap: &VizSceneSnapshot) -> i64 {
    var h: i64 = 41
    h = h * 131 + snap.node_count
    h = h * 131 + snap.selected_node
    h = h * 131 + snap.hovered_node
    h = h * 131 + snap.focused_node
    h = h * 131 + snap.selected_atom_node
    h = h * 131 + snap.selected_atom_index
    h = h * 131 + snap.molecule_tool
    h = h * 131 + snap.molecule_unit
    h = h * 131 + snap.molecule_last_reason
    h = h * 131 + snap.molecule_last_action
    h = h * 131 + snap.molecule_accept_count
    h = h * 131 + snap.molecule_reject_count
    h = h * 131 + snap.molecule_timeline_count
    h = h * 131 + snap.active_tab
    h = h * 131 + snap.time as i64
    h = h * 131 + snap.series_count
    h = h * 131 + snap.heatmap_count
    h = h * 131 + snap.molecule_count
    h = h * 131 + snap.field_count
    h = h * 131 + snap.vector_field_count
    h = h * 131 + snap.trajectory_count
    h = h * 131 + snap.spectrum_count
    h = h * 131 + snap.lattice_count
    h = h * 131 + snap.particle_event_count
    h = h * 131 + snap.mesh_count
    var i: i64 = 0
    while i < snap.node_count && i < 64 {
        h = h * 131 + snap.node_id[i as usize]
        h = h * 131 + snap.node_parent_id[i as usize]
        h = h * 131 + snap.node_tag[i as usize]
        h = h * 131 + snap.node_kind[i as usize]
        h = h * 131 + snap.node_data_slot[i as usize]
        h = h * 131 + snap.node_layout_x[i as usize]
        h = h * 131 + snap.node_layout_y[i as usize]
        h = h * 131 + snap.node_layout_w[i as usize]
        h = h * 131 + snap.node_layout_h[i as usize]
        h = h * 131 + (snap.node_value[i as usize] * 1000.0) as i64
        i = i + 1
    }
    h = h * 131 + snap.audit_hash
    h = h * 131 + snap.first_node_hash
    h
}

pub fn viz_scene_restore_snapshot(scene: &!VizScene, snap: &VizSceneSnapshot) -> bool with Mut {
    if snap.node_count < 0 || snap.node_count > 64 { return false }
    scene.node_count = snap.node_count
    scene.selected_node = snap.selected_node
    scene.hovered_node = snap.hovered_node
    scene.focused_node = snap.focused_node
    scene.selected_atom_node = snap.selected_atom_node
    scene.selected_atom_index = snap.selected_atom_index
    scene.molecule_studio_node = snap.molecule_studio_node
    scene.molecule_tool = snap.molecule_tool
    scene.molecule_unit = snap.molecule_unit
    scene.molecule_pending_atom = snap.molecule_pending_atom
    scene.molecule_last_reason = snap.molecule_last_reason
    scene.molecule_last_action = snap.molecule_last_action
    scene.molecule_accept_count = snap.molecule_accept_count
    scene.molecule_reject_count = snap.molecule_reject_count
    scene.molecule_timeline_count = snap.molecule_timeline_count
    scene.next_node_id = snap.next_node_id
    scene.active_tab = snap.active_tab
    scene.time = snap.time
    scene.series_count = snap.series_count
    scene.heatmap_count = snap.heatmap_count
    scene.molecule_count = snap.molecule_count
    scene.field_count = snap.field_count
    scene.vector_field_count = snap.vector_field_count
    scene.trajectory_count = snap.trajectory_count
    scene.spectrum_count = snap.spectrum_count
    scene.lattice_count = snap.lattice_count
    scene.particle_event_count = snap.particle_event_count
    scene.mesh_count = snap.mesh_count
    var i: i64 = 0
    while i < 64 {
        if i < snap.node_count {
            var n = scene.nodes[i as usize]
            n.id = snap.node_id[i as usize]
            n.parent_id = snap.node_parent_id[i as usize]
            n.tag = snap.node_tag[i as usize]
            n.kind = snap.node_kind[i as usize]
            n.parent = snap.node_parent[i as usize]
            n.first_child = snap.node_first_child[i as usize]
            n.next_sibling = snap.node_next_sibling[i as usize]
            n.style = VizStyle {
                r: snap.node_style_r[i as usize],
                g: snap.node_style_g[i as usize],
                b: snap.node_style_b[i as usize],
                alpha: snap.node_style_alpha[i as usize],
                stroke_width: snap.node_style_stroke_width[i as usize],
                fill: snap.node_style_fill[i as usize],
                palette: snap.node_style_palette[i as usize],
                font_scale: snap.node_style_font_scale[i as usize],
            }
            n.layout = VizLayout {
                x: snap.node_layout_x[i as usize],
                y: snap.node_layout_y[i as usize],
                w: snap.node_layout_w[i as usize],
                h: snap.node_layout_h[i as usize],
                layout_kind: snap.node_layout_kind[i as usize],
                gap: snap.node_layout_gap[i as usize],
            }
            n.data_slot = snap.node_data_slot[i as usize]
            n.flags = snap.node_flags[i as usize]
            n.value = snap.node_value[i as usize]
            n.min_value = snap.node_min_value[i as usize]
            n.max_value = snap.node_max_value[i as usize]
            n.selected = snap.node_selected[i as usize]
            n.label_len = snap.node_label_len[i as usize]
            var j: i64 = 0
            while j < 64 {
                n.label[j as usize] = snap.node_label[(i * 64 + j) as usize]
                j = j + 1
            }
            scene.nodes[i as usize] = n
        } else {
            scene.nodes[i as usize] = viz_node_empty()
        }
        i = i + 1
    }
    true
}

pub fn viz_scene_snapshot_matches(scene: &VizScene, snap: &VizSceneSnapshot) -> bool with Mut {
    if scene.node_count != snap.node_count { return false }
    if viz_audit_hash(scene) != snap.audit_hash { return false }
    if viz_audit_node_hash(scene, 0) != snap.first_node_hash { return false }
    true
}
