// Checked shared scalar bar geometry; no IR dependency or allocation.
use viz::scatter::{scatter_finite,scatter_project}
pub struct BarRect {
    pub x:i64,
    pub y:i64,
    pub w:i64,
    pub h:i64,
    pub status:i64,
}
pub struct BarWidth { pub value:i64, pub status:i64 }
pub fn bar_pair_width(x0:f64,x1:f64,pair_count:i64,xmin:f64,xmax:f64,x:i64,w:i64)->BarWidth with Div {
    let bad=BarWidth {value:0,status:2}
    if pair_count < 0 || pair_count > 2 { return bad }
    let domain=scatter_project(xmin,0.0,xmin,xmax,0.0,0.0,x,0,w,1,false)
    if domain.status != 0 { return bad }
    if pair_count == 0 { return BarWidth {value:8,status:0} }
    let a=scatter_project(x0,0.0,xmin,xmax,0.0,0.0,x,0,w,1,false)
    if a.status != 0 { return bad }
    if pair_count == 1 { return BarWidth {value:8,status:0} }
    let b=scatter_project(x1,0.0,xmin,xmax,0.0,0.0,x,0,w,1,false)
    if b.status != 0 { return bad }
    var gap=b.x-a.x
    if gap < 0 { gap=0-gap }
    var value=gap*8/10
    if value < 2 { value=2 }
    if value > 40 { value=40 }
    BarWidth {value:value,status:0}
}
pub fn bar_project(sx:f64,sy:f64,xmin:f64,xmax:f64,ymin:f64,ymax:f64,
    x:i64,y:i64,w:i64,h:i64,width:i64,clipped:bool)->BarRect with Div {
    let bad=BarRect {x:0,y:0,w:0,h:0,status:2}
    let empty=BarRect {x:0,y:0,w:0,h:0,status:1}
    if width < 2 || width > 40 || !scatter_finite(sx) || !scatter_finite(sy) { return bad }
    if ymin == ymax && ymin != 0.0 { return bad }
    if ymin == ymax && sy != 0.0 { return bad }
    var tip=sy
    var base:f64=0.0
    if clipped {
        if tip < ymin { tip=ymin }; if tip > ymax { tip=ymax }
        if base < ymin { base=ymin }; if base > ymax { base=ymax }
    }
    let point=scatter_project(sx,tip,xmin,xmax,ymin,ymax,x,y,w,h,false)
    if point.status != 0 { return bad }
    let baseline=scatter_project(sx,base,xmin,xmax,ymin,ymax,x,y,w,h,false)
    if baseline.status != 0 { return bad }
    var left=point.x-width/2
    var right=left+width
    var top=point.y
    var bottom=baseline.y
    if top > bottom { let swap=top; top=bottom; bottom=swap }
    if clipped {
        if left < x { left=x }; if right > x+w+1 { right=x+w+1 }
        if top < y { top=y }; if bottom > y+h+1 { bottom=y+h+1 }
    }
    if right <= left || bottom <= top { return empty }
    BarRect {x:left,y:top,w:right-left,h:bottom-top,status:0}
}
