// Shared ASCII legend geometry. Glyph cells are 8x8 pixels.
pub struct LegendLayout {
    pub swatch_x: i64, pub swatch_y: i64,
    pub text_x: i64, pub text_y: i64,
    pub visible_len: i64, pub status: i64,
}
pub fn legend_layout(x: i64, y: i64, w: i64, h: i64, len: i64) -> LegendLayout with Mut, Div {
    var out = LegendLayout { swatch_x: 0, swatch_y: 0, text_x: 0, text_y: 0, visible_len: 0, status: 1 }
    if x < -1000000 || x > 1000000 || y < -1000000 || y > 1000000 { return out }
    if w < 24 || w > 1000000 || h < 10 || h > 1000000 || len < 0 || len > 64 { return out }
    let capacity = (w - 24) / 8
    out.visible_len = if len < capacity { len } else { capacity }
    out.swatch_x = x + 4
    out.swatch_y = y + (h - 6) / 2
    out.text_x = x + 20
    out.text_y = y + (h - 8) / 2
    out.status = 0
    out
}
