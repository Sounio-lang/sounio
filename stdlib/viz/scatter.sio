// Shared checked scatter projection. No IR dependency; no allocation.
pub struct ScatterPoint {
    pub x: i64,
    pub y: i64,
    pub status: i64,
}
pub fn scatter_finite(v:f64)->bool {
    v == v && v <= 1.7976931348623157e308 && v >= -1.7976931348623157e308
}
pub fn scatter_geometry(x:i64,y:i64,w:i64,h:i64)->bool {
    x >= -1000000 && y >= -1000000 && w >= 1 && h >= 1 &&
    w <= 1000000 && h <= 1000000 && x <= 1000000-w && y <= 1000000-h
}
pub fn scatter_project(sample_x:f64,sample_y:f64,xmin:f64,xmax:f64,ymin:f64,ymax:f64,
    x:i64,y:i64,w:i64,h:i64,clipped:bool)->ScatterPoint with Div {
    let bad = ScatterPoint {x:0,y:0,status:2}
    if !scatter_geometry(x,y,w,h) { return bad }
    if !scatter_finite(sample_x) || !scatter_finite(sample_y) ||
       !scatter_finite(xmin) || !scatter_finite(xmax) ||
       !scatter_finite(ymin) || !scatter_finite(ymax) { return bad }
    if xmax < xmin || ymax < ymin { return bad }
    let dx = xmax-xmin
    let dy = ymax-ymin
    if !scatter_finite(dx) || !scatter_finite(dy) { return bad }
    if dx == 0.0 && sample_x != xmin { return bad }
    if dy == 0.0 && sample_y != ymin { return bad }
    if clipped && (sample_x < xmin || sample_x > xmax || sample_y < ymin || sample_y > ymax) {
        return ScatterPoint {x:0,y:0,status:1}
    }
    var ox:i64 = w/2
    var oy:i64 = h/2
    if dx > 0.0 {
        let u = (sample_x-xmin)/dx
        if !scatter_finite(u) || u < -1000000.0 || u > 1000000.0 { return bad }
        ox = (u*(w as f64)) as i64
    }
    if dy > 0.0 {
        let v = (sample_y-ymin)/dy
        if !scatter_finite(v) || v < -1000000.0 || v > 1000000.0 { return bad }
        oy = (v*(h as f64)) as i64
    }
    ScatterPoint {x:x+ox,y:y+h-oy,status:0}
}
