// stdlib/viz/colormap.sio — Perceptually-uniform colormaps
//
// Implements viridis and plasma using 8-anchor linear interpolation.
// Anchor values sampled from the BIDS colormap project (CC0 license).
//
// Usage:
//   let r = viridis_r(t)   // t ∈ [0.0, 1.0]
//   let g = viridis_g(t)
//   let b = viridis_b(t)
//   // r/g/b are integers in [0, 255]

// ============================================================
// Internal interpolation helper
// ============================================================

fn cm_clamp_i(v: i64, lo: i64, hi: i64) -> i64 {
    if v < lo { lo } else if v > hi { hi } else { v }
}

// Linearly interpolate between 8 anchors at positions 0/1/2/.../7.
// t ∈ [0, 1] → anchor range.
fn cm_interp8(anchors: &[i64; 8], t: f64) -> i64 with Div {
    if t <= 0.0 { return anchors[0] }
    if t >= 1.0 { return anchors[7] }
    let scaled = t * 7.0
    let i = scaled as i64
    let i_clamped = cm_clamp_i(i, 0, 6)
    let frac = scaled - (i_clamped as f64)
    let lo = anchors[i_clamped as usize]
    let hi = anchors[(i_clamped + 1) as usize]
    let result = (lo as f64) * (1.0 - frac) + (hi as f64) * frac
    cm_clamp_i(result as i64, 0, 255)
}

// ============================================================
// Viridis — dark purple → blue-green → yellow
//
// Anchors sampled at positions 0/36/72/109/145/182/218/255
// from the 256-entry viridis LUT (BIDS project, Matplotlib 2.0):
//   [0]=(68,1,84)  [36]=(70,50,127)  [72]=(54,92,141)  [109]=(39,127,142)
//   [145]=(31,161,135)  [182]=(74,194,109)  [218]=(159,218,58)  [255]=(253,231,37)
// ============================================================

pub fn viridis_r(t: f64) -> i64 with Div {
    let anchors: [i64; 8] = [68, 70, 54, 39, 31, 74, 159, 253]
    cm_interp8(&anchors, t)
}

pub fn viridis_g(t: f64) -> i64 with Div {
    let anchors: [i64; 8] = [1, 50, 92, 127, 161, 194, 218, 231]
    cm_interp8(&anchors, t)
}

pub fn viridis_b(t: f64) -> i64 with Div {
    let anchors: [i64; 8] = [84, 127, 141, 142, 135, 109, 58, 37]
    cm_interp8(&anchors, t)
}

// ============================================================
// Plasma — deep blue → magenta → yellow
//
// Anchors sampled at positions 0/36/72/109/145/182/218/255:
//   [0]=(13,8,135)  [36]=(84,2,163)  [72]=(139,10,165)  [109]=(185,50,137)
//   [145]=(219,92,104)  [182]=(244,136,73)  [218]=(254,188,43)  [255]=(240,249,33)
// ============================================================

pub fn plasma_r(t: f64) -> i64 with Div {
    let anchors: [i64; 8] = [13, 84, 139, 185, 219, 244, 254, 240]
    cm_interp8(&anchors, t)
}

pub fn plasma_g(t: f64) -> i64 with Div {
    let anchors: [i64; 8] = [8, 2, 10, 50, 92, 136, 188, 249]
    cm_interp8(&anchors, t)
}

pub fn plasma_b(t: f64) -> i64 with Div {
    let anchors: [i64; 8] = [135, 163, 165, 137, 104, 73, 43, 33]
    cm_interp8(&anchors, t)
}
