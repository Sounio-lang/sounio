// stdlib/viz/audit.sio - shared Visual IR audit summaries

use viz::ir::{VizScene}

pub fn viz_audit_hash(scene: &VizScene) -> i64 with Mut {
    var h: i64 = 23
    h = h * 131 + scene.node_count
    h = h * 131 + scene.selected_node
    h = h * 131 + scene.hovered_node
    h = h * 131 + scene.focused_node
    h = h * 131 + scene.active_tab
    h = h * 131 + scene.time as i64
    h
}

pub fn viz_audit_node_hash(scene: &VizScene, node_idx: i64) -> i64 with Mut {
    if node_idx < 0 || node_idx >= scene.node_count { return 0 }
    var h: i64 = 29
    h = h * 131 + scene.nodes[node_idx as usize].id
    h = h * 131 + scene.nodes[node_idx as usize].parent_id
    h = h * 131 + scene.nodes[node_idx as usize].tag
    h = h * 131 + scene.nodes[node_idx as usize].kind
    h = h * 131 + scene.nodes[node_idx as usize].data_slot
    h = h * 131 + scene.nodes[node_idx as usize].layout.x
    h = h * 131 + scene.nodes[node_idx as usize].layout.y
    h = h * 131 + scene.nodes[node_idx as usize].layout.w
    h = h * 131 + scene.nodes[node_idx as usize].layout.h
    h
}
