// stdlib/viz/audit.sio - shared Visual IR audit summaries

use viz::ir::{VizScene}

pub fn viz_audit_hash(scene: &VizScene) -> i64 with Mut {
    var h: i64 = 23
    h = wrapping_add(wrapping_mul(h, 131), scene.node_count)
    h = wrapping_add(wrapping_mul(h, 131), scene.selected_node)
    h = wrapping_add(wrapping_mul(h, 131), scene.hovered_node)
    h = wrapping_add(wrapping_mul(h, 131), scene.focused_node)
    h = wrapping_add(wrapping_mul(h, 131), scene.active_tab)
    h = wrapping_add(wrapping_mul(h, 131), scene.time as i64)
    h
}

pub fn viz_audit_node_hash(scene: &VizScene, node_idx: i64) -> i64 with Mut {
    if node_idx < 0 || node_idx >= scene.node_count { return 0 }
    let n = scene.nodes[node_idx as usize]
    var h: i64 = 29
    h = wrapping_add(wrapping_mul(h, 131), n.id)
    h = wrapping_add(wrapping_mul(h, 131), n.parent_id)
    h = wrapping_add(wrapping_mul(h, 131), n.tag)
    h = wrapping_add(wrapping_mul(h, 131), n.kind)
    h = wrapping_add(wrapping_mul(h, 131), n.data_slot)
    h = wrapping_add(wrapping_mul(h, 131), n.layout.x)
    h = wrapping_add(wrapping_mul(h, 131), n.layout.y)
    h = wrapping_add(wrapping_mul(h, 131), n.layout.w)
    h = wrapping_add(wrapping_mul(h, 131), n.layout.h)
    h
}
