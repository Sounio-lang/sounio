// stdlib/viz/audit.sio - shared Visual IR audit summaries

use viz::ir::{VizScene}

pub fn viz_audit_hash(scene: &VizScene) -> i64 with Mut {
    var h: i64 = 23
    h = h * 131 + scene.node_count
    h = h * 131 + scene.selected_node
    h = h * 131 + scene.hovered_node
    h = h * 131 + scene.focused_node
    h = h * 131 + scene.selected_atom_node
    h = h * 131 + scene.selected_atom_index
    h = h * 131 + scene.molecule_studio_node
    h = h * 131 + scene.molecule_tool
    h = h * 131 + scene.molecule_unit
    h = h * 131 + scene.molecule_pending_atom
    h = h * 131 + scene.molecule_last_reason
    h = h * 131 + scene.molecule_last_action
    h = h * 131 + scene.molecule_accept_count
    h = h * 131 + scene.molecule_reject_count
    h = h * 131 + scene.molecule_timeline_count
    h = h * 131 + scene.active_tab
    h = h * 131 + scene.time as i64
    var mi: i64 = 0
    var molecule_count = scene.molecule_count
    if molecule_count < 0 { molecule_count = 0 }
    if molecule_count > 4 { molecule_count = 4 }
    h = h * 131 + molecule_count
    while mi < molecule_count {
        var atom_count = scene.molecules[mi as usize].atom_count
        if atom_count < 0 { atom_count = 0 }
        if atom_count > 64 { atom_count = 64 }
        var bond_count = scene.molecules[mi as usize].bond_count
        if bond_count < 0 { bond_count = 0 }
        if bond_count > 96 { bond_count = 96 }
        h = h * 131 + atom_count
        h = h * 131 + bond_count
        var ai: i64 = 0
        while ai < atom_count {
            let a = scene.molecules[mi as usize].atoms[ai as usize]
            h = h * 131 + a.atomic_number
            h = h * 131 + (a.x * 1000.0) as i64
            h = h * 131 + (a.y * 1000.0) as i64
            h = h * 131 + (a.z * 1000.0) as i64
            h = h * 131 + (a.radius * 1000.0) as i64
            h = h * 131 + a.r
            h = h * 131 + a.g
            h = h * 131 + a.b
            ai = ai + 1
        }
        var bi: i64 = 0
        while bi < bond_count {
            let b = scene.molecules[mi as usize].bonds[bi as usize]
            h = h * 131 + b.atom_a
            h = h * 131 + b.atom_b
            h = h * 131 + b.order
            h = h * 131 + (b.length.value * 1000.0) as i64
            h = h * 131 + (b.variance * 1000.0) as i64
            bi = bi + 1
        }
        mi = mi + 1
    }
    var lattice_count = scene.lattice_count
    if lattice_count < 0 { lattice_count = 0 }
    if lattice_count > 4 { lattice_count = 4 }
    h = h * 131 + lattice_count
    var li: i64 = 0
    while li < lattice_count {
        let lat = scene.lattice_data[li as usize]
        var cells = lat.rows * lat.cols
        if cells < 0 { cells = 0 }
        if cells > 4096 { cells = 4096 }
        h = h * 131 + lat.rows
        h = h * 131 + lat.cols
        var ci: i64 = 0
        while ci < cells {
            h = h * 131 + (lat.displacement_x[ci as usize] * 10000.0) as i64
            h = h * 131 + (lat.displacement_y[ci as usize] * 10000.0) as i64
            h = h * 131 + (lat.phase[ci as usize] * 1000.0) as i64
            h = h * 131 + (lat.variance[ci as usize] * 1000000.0) as i64
            ci = ci + 1
        }
        li = li + 1
    }
    var event_count = scene.particle_event_count
    if event_count < 0 { event_count = 0 }
    if event_count > 4 { event_count = 4 }
    h = h * 131 + event_count
    var ei: i64 = 0
    while ei < event_count {
        let ev = scene.particle_event_data[ei as usize]
        var n = ev.n
        if n < 0 { n = 0 }
        if n > 1024 { n = 1024 }
        h = h * 131 + n
        var pi: i64 = 0
        while pi < n {
            h = h * 131 + (ev.px[pi as usize] * 10000.0) as i64
            h = h * 131 + (ev.py[pi as usize] * 10000.0) as i64
            h = h * 131 + (ev.pz[pi as usize] * 10000.0) as i64
            h = h * 131 + (ev.energy[pi as usize] * 1000.0) as i64
            h = h * 131 + (ev.variance[pi as usize] * 1000000.0) as i64
            h = h * 131 + ev.kind[pi as usize]
            pi = pi + 1
        }
        ei = ei + 1
    }
    h
}

pub fn viz_audit_node_hash(scene: &VizScene, node_idx: i64) -> i64 with Mut {
    if node_idx < 0 || node_idx >= scene.node_count { return 0 }
    let n = scene.nodes[node_idx as usize]
    var h: i64 = 29
    h = h * 131 + n.id
    h = h * 131 + n.parent_id
    h = h * 131 + n.tag
    h = h * 131 + n.kind
    h = h * 131 + n.data_slot
    h = h * 131 + n.layout.x
    h = h * 131 + n.layout.y
    h = h * 131 + n.layout.w
    h = h * 131 + n.layout.h
    h
}
