// stdlib/viz/audit.sio - shared Visual IR audit summaries

use viz::ir::{VizScene}

pub fn viz_audit_hash(scene: &VizScene) -> i64 with Mut {
    var h: i64 = 23
    h = h * 131 + scene.node_count
    h = h * 131 + scene.selected_node
    h = h * 131 + scene.hovered_node
    h = h * 131 + scene.focused_node
    h = h * 131 + scene.selected_atom_node
    h = h * 131 + scene.selected_atom_index
    h = h * 131 + scene.molecule_studio_node
    h = h * 131 + scene.molecule_tool
    h = h * 131 + scene.molecule_unit
    h = h * 131 + scene.molecule_pending_atom
    h = h * 131 + scene.molecule_last_reason
    h = h * 131 + scene.molecule_last_action
    h = h * 131 + scene.molecule_accept_count
    h = h * 131 + scene.molecule_reject_count
    h = h * 131 + scene.molecule_timeline_count
    h = h * 131 + scene.active_tab
    h = h * 131 + scene.time as i64
    var ni: i64 = 0
    while ni < scene.node_count && ni < 64 {
        let n = scene.nodes[ni as usize]
        h = h * 131 + n.tag
        h = h * 131 + n.kind
        h = h * 131 + n.data_slot
        h = h * 131 + (n.value * 1000.0) as i64
        let selected_i = if n.selected { 1 } else { 0 }
        h = h * 131 + selected_i
        ni = ni + 1
    }
    var mi: i64 = 0
    var molecule_count = scene.molecule_count
    if molecule_count < 0 { molecule_count = 0 }
    if molecule_count > 4 { molecule_count = 4 }
    h = h * 131 + molecule_count
    while mi < molecule_count {
        let atom_base = mi * 64
        let bond_base = mi * 96
        var atom_count = scene.molecule_atom_counts[mi as usize]
        if atom_count < 0 { atom_count = 0 }
        if atom_count > 64 { atom_count = 64 }
        var bond_count = scene.molecule_bond_counts[mi as usize]
        if bond_count < 0 { bond_count = 0 }
        if bond_count > 96 { bond_count = 96 }
        h = h * 131 + atom_count
        h = h * 131 + bond_count
        var ai: i64 = 0
        while ai < atom_count {
            let aidx = atom_base + ai
            h = h * 131 + scene.molecule_atom_atomic_number[aidx as usize]
            h = h * 131 + (scene.molecule_atom_x[aidx as usize] * 1000.0) as i64
            h = h * 131 + (scene.molecule_atom_y[aidx as usize] * 1000.0) as i64
            h = h * 131 + (scene.molecule_atom_z[aidx as usize] * 1000.0) as i64
            h = h * 131 + (scene.molecule_atom_radius[aidx as usize] * 1000.0) as i64
            h = h * 131 + scene.molecule_atom_r[aidx as usize]
            h = h * 131 + scene.molecule_atom_g[aidx as usize]
            h = h * 131 + scene.molecule_atom_b[aidx as usize]
            ai = ai + 1
        }
        var bi: i64 = 0
        while bi < bond_count {
            let bidx = bond_base + bi
            h = h * 131 + scene.molecule_bond_a[bidx as usize]
            h = h * 131 + scene.molecule_bond_b[bidx as usize]
            h = h * 131 + scene.molecule_bond_order[bidx as usize]
            h = h * 131 + (scene.molecule_bond_length[bidx as usize] * 1000.0) as i64
            h = h * 131 + (scene.molecule_bond_variance[bidx as usize] * 1000.0) as i64
            bi = bi + 1
        }
        mi = mi + 1
    }
    var lattice_count = scene.lattice_count
    if lattice_count < 0 { lattice_count = 0 }
    if lattice_count > 4 { lattice_count = 4 }
    h = h * 131 + lattice_count
    var li: i64 = 0
    while li < lattice_count {
        let lat = scene.lattice_data[li as usize]
        var cells = lat.rows * lat.cols
        if cells < 0 { cells = 0 }
        if cells > 4096 { cells = 4096 }
        h = h * 131 + lat.rows
        h = h * 131 + lat.cols
        var ci: i64 = 0
        while ci < cells {
            h = h * 131 + (lat.displacement_x[ci as usize] * 10000.0) as i64
            h = h * 131 + (lat.displacement_y[ci as usize] * 10000.0) as i64
            h = h * 131 + (lat.phase[ci as usize] * 1000.0) as i64
            h = h * 131 + (lat.variance[ci as usize] * 1000000.0) as i64
            ci = ci + 1
        }
        li = li + 1
    }
    var event_count = scene.particle_event_count
    if event_count < 0 { event_count = 0 }
    if event_count > 4 { event_count = 4 }
    h = h * 131 + event_count
    var ei: i64 = 0
    while ei < event_count {
        let ev = scene.particle_event_data[ei as usize]
        var n = ev.n
        if n < 0 { n = 0 }
        if n > 1024 { n = 1024 }
        h = h * 131 + n
        var pi: i64 = 0
        while pi < n {
            h = h * 131 + (ev.px[pi as usize] * 10000.0) as i64
            h = h * 131 + (ev.py[pi as usize] * 10000.0) as i64
            h = h * 131 + (ev.pz[pi as usize] * 10000.0) as i64
            h = h * 131 + (ev.energy[pi as usize] * 1000.0) as i64
            h = h * 131 + (ev.variance[pi as usize] * 1000000.0) as i64
            h = h * 131 + ev.kind[pi as usize]
            pi = pi + 1
        }
        ei = ei + 1
    }
    var mesh_count = scene.mesh_count
    if mesh_count < 0 { mesh_count = 0 }
    if mesh_count > 4 { mesh_count = 4 }
    h = h * 131 + mesh_count
    var me: i64 = 0
    while me < mesh_count {
        var tri_count = scene.meshes[me as usize].n
        if tri_count < 0 { tri_count = 0 }
        if tri_count > 128 { tri_count = 128 }
        h = h * 131 + tri_count
        var ti: i64 = 0
        while ti < tri_count {
            h = h * 131 + (scene.meshes[me as usize].v0x[ti as usize] * 1000.0) as i64
            h = h * 131 + (scene.meshes[me as usize].v0y[ti as usize] * 1000.0) as i64
            h = h * 131 + (scene.meshes[me as usize].v0z[ti as usize] * 1000.0) as i64
            h = h * 131 + (scene.meshes[me as usize].v1x[ti as usize] * 1000.0) as i64
            h = h * 131 + (scene.meshes[me as usize].v1y[ti as usize] * 1000.0) as i64
            h = h * 131 + (scene.meshes[me as usize].v1z[ti as usize] * 1000.0) as i64
            h = h * 131 + (scene.meshes[me as usize].v2x[ti as usize] * 1000.0) as i64
            h = h * 131 + (scene.meshes[me as usize].v2y[ti as usize] * 1000.0) as i64
            h = h * 131 + (scene.meshes[me as usize].v2z[ti as usize] * 1000.0) as i64
            h = h * 131 + (scene.meshes[me as usize].nx[ti as usize] * 1000.0) as i64
            h = h * 131 + (scene.meshes[me as usize].ny[ti as usize] * 1000.0) as i64
            h = h * 131 + (scene.meshes[me as usize].nz[ti as usize] * 1000.0) as i64
            h = h * 131 + scene.meshes[me as usize].base_r[ti as usize]
            h = h * 131 + scene.meshes[me as usize].base_g[ti as usize]
            h = h * 131 + scene.meshes[me as usize].base_b[ti as usize]
            ti = ti + 1
        }
        me = me + 1
    }
    h
}

pub fn viz_audit_node_hash(scene: &VizScene, node_idx: i64) -> i64 with Mut {
    if node_idx < 0 || node_idx >= scene.node_count { return 0 }
    let n = scene.nodes[node_idx as usize]
    var h: i64 = 29
    h = h * 131 + n.id
    h = h * 131 + n.parent_id
    h = h * 131 + n.tag
    h = h * 131 + n.kind
    h = h * 131 + n.data_slot
    h = h * 131 + n.layout.x
    h = h * 131 + n.layout.y
    h = h * 131 + n.layout.w
    h = h * 131 + n.layout.h
    h
}
