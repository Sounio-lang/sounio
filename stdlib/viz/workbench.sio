pub fn viz_workbench_experiment_packet_ledger_emit(ledger: &VizWorkbenchExperimentPacketLedger) with IO, Mut, Div {
    print("<!-- workbench-experiment-packet-ledger valid=")
    if ledger.valid { print("1") } else { print("0") }
    print(" ledger-hash=")
    viz_workbench_print_i64(ledger.ledger_hash)
    print(" packets=")
    viz_workbench_print_i64(ledger.packet_count)
    print(" last-packet-hash=")
    viz_workbench_print_i64(ledger.last_packet_hash)
    print(" last-payload-stamp-hash=")
    viz_workbench_print_i64(ledger.last_payload_stamp_hash)
    print(" last-frame-hash=")
    viz_workbench_print_i64(ledger.last_frame_hash)
    print(" last-audit-hash=")
    viz_workbench_print_i64(ledger.last_audit_hash)
    if ledger.packet_count > 1 {
        let idx = ledger.packet_count - 1
        print(" packet-delta=")
        viz_workbench_print_i64(ledger.packet_hash_deltas[idx as usize])
        print(" payload-delta=")
        viz_workbench_print_i64(ledger.payload_stamp_deltas[idx as usize])
        print(" frame-delta=")
        viz_workbench_print_i64(ledger.frame_hash_deltas[idx as usize])
        print(" audit-delta=")
        viz_workbench_print_i64(ledger.audit_hash_deltas[idx as usize])
    }
    print(" -->\n")
}

