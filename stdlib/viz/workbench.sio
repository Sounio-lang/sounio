    let toggle = viz_add_toggle(scene, viz_layout_rect(348, 228, 30, 20), false, viz_style_rgb(120, 225, 150))
    let plot = viz_add_line_chart(scene, &xs, &ys, 18, viz_layout_rect(16, 44, 110, 70), viz_style_rgb(255, 140, 90))
    let band = viz_add_uncertainty_band(scene, &xs, &ys, &vars, 18, viz_layout_rect(138, 44, 110, 70), viz_style_rgb(90, 190, 255))
    let heatmap = viz_add_heatmap(scene, &field.values, field.rows, field.cols, field.min_value, field.max_value, viz_layout_rect(260, 44, 110, 70))
    let vector_field = viz_add_vector_field(scene, vectors, viz_layout_rect(16, 132, 90, 62))
    let trajectory = viz_add_trajectory(scene, traj, viz_layout_rect(118, 132, 100, 62))
