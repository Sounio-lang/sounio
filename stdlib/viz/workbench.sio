fn viz_workbench_find_tag(scene: &VizScene, tag: i64) -> i64 with Mut {
    var i: i64 = 0
    while i < scene.node_count {
        if scene.nodes[i as usize].tag == tag { return i }
        i = i + 1
    }
    0 - 1
}

fn viz_workbench_set_time(scene: &!VizScene, t_in: f64) with Mut, Div {
    var t = t_in
    if t < 0.0 { t = 0.0 }
    if t > 10.0 { t = 10.0 }
    scene.time = t
    let slider = viz_workbench_find_tag(scene, 8101)
    if slider >= 0 {
        viz_scene_set_time_from_slider(scene, slider, t)
    }
    let readout = viz_workbench_find_tag(scene, VIZ_WORKBENCH_TAG_TIME_READOUT)
    if readout >= 0 {
        scene.nodes[readout as usize].value = scene.time
        scene.nodes[readout as usize].min_value = 0.0
        scene.nodes[readout as usize].max_value = 10.0
    }
    viz_workbench_sync_dynamics(scene)
}

fn viz_workbench_toggle_play(scene: &!VizScene) with Mut {
    let play = viz_workbench_find_tag(scene, VIZ_WORKBENCH_TAG_TIME_PLAY)
    if play >= 0 {
        if scene.nodes[play as usize].value > 0.0 {
            scene.nodes[play as usize].value = 0.0
            scene.nodes[play as usize].selected = false
        } else {
            scene.nodes[play as usize].value = 1.0
            scene.nodes[play as usize].selected = true
        }
    }
}

pub fn viz_workbench_playing(scene: &VizScene) -> bool with Mut {
    let play = viz_workbench_find_tag(scene, VIZ_WORKBENCH_TAG_TIME_PLAY)
    if play < 0 { return false }
    scene.nodes[play as usize].value > 0.0
}

fn viz_workbench_sync_molecule_mirrors(scene: &!VizScene) with Mut {
    var mi: i64 = 0
    while mi < scene.molecule_count && mi < 4 {
        viz_scene_sync_molecule_mirror(scene, mi)
        mi = mi + 1
    }
}

pub fn viz_workbench_sync_dynamics(scene: &!VizScene) with Mut, Div {
    if scene.lattice_count > 0 {
        scene.lattice_data[0].rows = 6
        scene.lattice_data[0].cols = 6
        var r: i64 = 0
        while r < 6 {
            var c: i64 = 0
            while c < 6 {
                let idx = r * 6 + c
                let phase = ((r + c) as f64) * 0.25 + scene.time * 0.35
                scene.lattice_data[0].phase[idx as usize] = phase
                scene.lattice_data[0].displacement_x[idx as usize] = ((c as f64) - 3.0) * 0.02 + scene.time * 0.006
                scene.lattice_data[0].displacement_y[idx as usize] = ((r as f64) - 3.0) * 0.02 - scene.time * 0.004
                scene.lattice_data[0].variance[idx as usize] = 0.001 + (idx as f64) * 0.0001 + scene.time * 0.00002
                c = c + 1
            }
            r = r + 1
        }
    }
    if scene.particle_event_count > 0 {
        scene.particle_event_data[0].n = 18
        var i: i64 = 0
        while i < 18 {
            scene.particle_event_data[0].px[i as usize] = (i as f64) * 0.08 + scene.time * 0.025
            scene.particle_event_data[0].py[i as usize] = ((i * i) as f64) * 0.006 + scene.time * 0.015
            scene.particle_event_data[0].pz[i as usize] = (i as f64) * 0.02 + scene.time * 0.01
            scene.particle_event_data[0].energy[i as usize] = 1.0 + (i as f64) * 0.05 + scene.time * 0.03
            scene.particle_event_data[0].variance[i as usize] = 0.01 + (i as f64) * 0.001 + scene.time * 0.0005
            scene.particle_event_data[0].kind[i as usize] = i % 3
            i = i + 1
        }
    }
    if scene.mesh_count > 0 {
        let t = scene.time
        scene.meshes[0].n = 2
        scene.meshes[0].tris[0] = Tri3D {
            v0x: -0.42 + t * 0.010, v0y: -0.34 + t * 0.004, v0z: -2.00 + t * 0.006,
            v1x: 0.42 - t * 0.006, v1y: -0.34 + t * 0.010, v1z: -2.00 - t * 0.004,
            v2x: -0.10 + t * 0.020, v2y: 0.42 - t * 0.006, v2z: -2.00 + t * 0.002,
            nx: t * 0.018, ny: t * 0.010, nz: 1.0,
            base_r: 150 + (t * 6.0) as i64, base_g: 210, base_b: 130,
        }
        scene.meshes[0].tris[1] = Tri3D {
            v0x: -0.35 - t * 0.004, v0y: 0.28 - t * 0.006, v0z: -2.12 + t * 0.004,
            v1x: 0.35 + t * 0.008, v1y: 0.28 - t * 0.003, v1z: -2.12 - t * 0.006,
            v2x: 0.10 - t * 0.016, v2y: -0.48 + t * 0.008, v2z: -2.12 + t * 0.003,
            nx: 0.0 - t * 0.010, ny: t * 0.014, nz: 1.0,
            base_r: 120, base_g: 170 + (t * 4.0) as i64, base_b: 235,
        }
        scene.meshes[0].v0x[0] = -0.42 + t * 0.010
        scene.meshes[0].v0y[0] = -0.34 + t * 0.004
        scene.meshes[0].v0z[0] = -2.00 + t * 0.006
        scene.meshes[0].v1x[0] = 0.42 - t * 0.006
        scene.meshes[0].v1y[0] = -0.34 + t * 0.010
        scene.meshes[0].v1z[0] = -2.00 - t * 0.004
        scene.meshes[0].v2x[0] = -0.10 + t * 0.020
        scene.meshes[0].v2y[0] = 0.42 - t * 0.006
        scene.meshes[0].v2z[0] = -2.00 + t * 0.002
        scene.meshes[0].nx[0] = t * 0.018
        scene.meshes[0].ny[0] = t * 0.010
        scene.meshes[0].nz[0] = 1.0
        scene.meshes[0].base_r[0] = 150 + (t * 6.0) as i64
        scene.meshes[0].base_g[0] = 210
        scene.meshes[0].base_b[0] = 130
        scene.meshes[0].v0x[1] = -0.35 - t * 0.004
        scene.meshes[0].v0y[1] = 0.28 - t * 0.006
        scene.meshes[0].v0z[1] = -2.12 + t * 0.004
        scene.meshes[0].v1x[1] = 0.35 + t * 0.008
        scene.meshes[0].v1y[1] = 0.28 - t * 0.003
        scene.meshes[0].v1z[1] = -2.12 - t * 0.006
        scene.meshes[0].v2x[1] = 0.10 - t * 0.016
        scene.meshes[0].v2y[1] = -0.48 + t * 0.008
        scene.meshes[0].v2z[1] = -2.12 + t * 0.003
        scene.meshes[0].nx[1] = 0.0 - t * 0.010
        scene.meshes[0].ny[1] = t * 0.014
        scene.meshes[0].nz[1] = 1.0
        scene.meshes[0].base_r[1] = 120
        scene.meshes[0].base_g[1] = 170 + (t * 4.0) as i64
        scene.meshes[0].base_b[1] = 235
    }
    viz_workbench_sync_molecule_mirrors(scene)
}

pub fn viz_workbench_event(kind: i64, key: i64, x: i64, y: i64, mods: i64) -> Event {
    Event { kind: kind, key: key, x: x, y: y, mods: mods }
}

pub fn viz_workbench_constraint(ids: &VizWorkbenchIds) -> VizMoleculeConstraint {
    viz_molecule_constraint_default(ids.molecule)
}

pub fn viz_workbench_handle_event(scene: &!VizScene, constraint: &!VizMoleculeConstraint, ev: Event) -> bool with Mut, Div {
    if viz_molecule_studio_handle_event(scene, constraint, ev) {
        return true
    }
    if ev.kind == EV_MOUSE_PRESS && ev.key == MOUSE_LEFT {
        let idx = viz_scene_hit_test(scene, ev.x, ev.y)
        if idx >= 0 && idx < scene.node_count {
            let tag = scene.nodes[idx as usize].tag
            if tag == VIZ_WORKBENCH_TAG_TIME_BACK {
                viz_workbench_set_time(scene, scene.time - 1.0)
                return true
            }
            if tag == VIZ_WORKBENCH_TAG_TIME_PLAY {
                viz_workbench_toggle_play(scene)
                return true
            }
            if tag == VIZ_WORKBENCH_TAG_TIME_FORWARD {
                viz_workbench_set_time(scene, scene.time + 1.0)
                return true
            }
        }
    }
    viz_scene_handle_event(scene, ev)
}

fn viz_workbench_hash_marker(h_in: i64) -> f64 with Mut, Div {
    var h = h_in
    if h < 0 { h = 0 - h }
    let m = h - (h / 1000000) * 1000000
    m as f64
}

fn viz_workbench_package_select_target(scene: &!VizScene, ids: &VizWorkbenchIds) with Mut {
    if scene.selected_node >= 0 && scene.selected_node < scene.node_count { return }
    if ids.slider < 0 || ids.slider >= scene.node_count { return }
    scene.selected_node = ids.slider
    scene.focused_node = ids.slider
    scene.hovered_node = ids.slider
    scene.nodes[ids.slider as usize].selected = true
}

fn viz_workbench_set_package_marker(scene: &!VizScene, ids: &VizWorkbenchIds, history_hash: i64) with Mut, Div {
    if ids.package_audit < 0 || ids.package_audit >= scene.node_count { return }
    scene.nodes[ids.package_audit as usize].value = viz_workbench_hash_marker(history_hash)
    scene.nodes[ids.package_audit as usize].min_value = 0.0
    scene.nodes[ids.package_audit as usize].max_value = 1000000.0
}

pub fn viz_workbench_handle_package_command(
    scene: &!VizScene,
    ids: &VizWorkbenchIds,
    history: &!VizSceneHistory,
    pkg: &!VizScenePackage,
    command: i64,
) -> bool with Mut, Div {
    if command == VIZ_WORKBENCH_PACKAGE_SAVE {
        viz_workbench_package_select_target(scene, ids)
        viz_scene_history_record(history, scene, VIZ_WORKBENCH_TAG_PACKAGE_SAVE)
        viz_workbench_set_package_marker(scene, ids, viz_scene_history_hash(history))
        viz_scene_package_capture(pkg, scene, history)
        return viz_scene_package_verify(pkg)
    }
    if command == VIZ_WORKBENCH_PACKAGE_RESTORE {
        if !viz_scene_package_restore(scene, pkg) { return false }
        viz_workbench_sync_dynamics(scene)
        viz_workbench_set_package_marker(scene, ids, pkg.history_hash)
        return true
    }
    if command == VIZ_WORKBENCH_PACKAGE_UNDO {
        if !viz_scene_history_undo(history, scene) { return false }
        viz_workbench_sync_dynamics(scene)
        viz_workbench_set_package_marker(scene, ids, viz_scene_history_hash(history))
        viz_scene_package_capture(pkg, scene, history)
        return true
    }
    if command == VIZ_WORKBENCH_PACKAGE_REDO {
        if !viz_scene_history_redo(history, scene) { return false }
        viz_workbench_sync_dynamics(scene)
        viz_workbench_set_package_marker(scene, ids, viz_scene_history_hash(history))
        viz_scene_package_capture(pkg, scene, history)
        return true
    }
    false
}

pub fn viz_workbench_handle_package_event(
    scene: &!VizScene,
    ids: &VizWorkbenchIds,
    history: &!VizSceneHistory,
    pkg: &!VizScenePackage,
    ev: Event,
) -> bool with Mut, Div {
    if ev.kind != EV_MOUSE_PRESS || ev.key != MOUSE_LEFT { return false }
    let idx = viz_scene_hit_test(scene, ev.x, ev.y)
    if idx < 0 || idx >= scene.node_count { return false }
    let tag = scene.nodes[idx as usize].tag
    if tag == VIZ_WORKBENCH_TAG_PACKAGE_UNDO {
        return viz_workbench_handle_package_command(scene, ids, history, pkg, VIZ_WORKBENCH_PACKAGE_UNDO)
    }
    if tag == VIZ_WORKBENCH_TAG_PACKAGE_REDO {
        return viz_workbench_handle_package_command(scene, ids, history, pkg, VIZ_WORKBENCH_PACKAGE_REDO)
    }
    if tag == VIZ_WORKBENCH_TAG_PACKAGE_SAVE {
        return viz_workbench_handle_package_command(scene, ids, history, pkg, VIZ_WORKBENCH_PACKAGE_SAVE)
    }
    if tag == VIZ_WORKBENCH_TAG_PACKAGE_RESTORE {
        return viz_workbench_handle_package_command(scene, ids, history, pkg, VIZ_WORKBENCH_PACKAGE_RESTORE)
    }
    false
}

pub fn viz_workbench_package_app_handle_event(
    app: &!VizApp,
    scene: &!VizScene,
    ids: &VizWorkbenchIds,
    constraint: &!VizMoleculeConstraint,
    history: &!VizSceneHistory,
    pkg: &!VizScenePackage,
    ev: Event,
) -> bool with Mut, Div {
    if ev.kind == EV_CLOSE || ev.kind == EV_EXPOSE {
        return viz_app_handle_event(app, scene, ev)
    }
    var changed = viz_workbench_handle_package_event(scene, ids, history, pkg, ev)
    if !changed {
        changed = viz_workbench_handle_event(scene, constraint, ev)
    }
    if changed {
        viz_workbench_sync_dynamics(scene)
        app.dirty = true
    }
    changed
}

pub fn viz_workbench_app_handle_event(app: &!VizApp, scene: &!VizScene, constraint: &!VizMoleculeConstraint, ev: Event) -> bool with Mut, Div {
    if ev.kind == EV_CLOSE || ev.kind == EV_EXPOSE {
        return viz_app_handle_event(app, scene, ev)
    }
    let changed = viz_workbench_handle_event(scene, constraint, ev)
    if changed {
        viz_workbench_sync_dynamics(scene)
        app.dirty = true
    }
    changed
}

pub fn viz_workbench_tick(app: &!VizApp, scene: &!VizScene, dt: f64) -> bool with Mut, Div {
    if !viz_workbench_playing(scene) { return false }
    viz_workbench_set_time(scene, scene.time + dt)
    app.dirty = true
    true
}

fn viz_workbench_replay_store_frame(session: &!VizWorkbenchReplaySession, frame_idx: i64, frame_hash: i64, scene: &VizScene) with Mut {
    if frame_idx < 0 || frame_idx >= 33 { return }
    session.frame_hashes[frame_idx as usize] = frame_hash
    session.audit_hashes[frame_idx as usize] = viz_audit_hash(scene)
    session.times_ms[frame_idx as usize] = (scene.time * 1000.0) as i64
    session.frame_count = frame_idx + 1
    session.final_frame_hash = frame_hash
    session.final_audit_hash = session.audit_hashes[frame_idx as usize]
}

pub fn viz_workbench_replay_record_session(app: &!VizApp, scene: &!VizScene, ids: &VizWorkbenchIds, c: &!Canvas, steps: &[VizWorkbenchReplayStep; 32], step_count: i64) -> VizWorkbenchReplaySession with Mut, Div, Alloc {
    var session = viz_workbench_replay_session_new()
    var constraint = viz_workbench_constraint(ids)
    var count = step_count
    if count < 0 { count = 0 }
    if count > 32 { count = 32 }
    session.step_count = count

    var i: i64 = 0
    while i < count {
        session.steps[i as usize] = steps[i as usize]
        i = i + 1
    }

    var hash = viz_replay_present(app, scene, c)
    viz_workbench_replay_store_frame(&!session, 0, hash, scene)

    i = 0
    while i < count {
        let step = steps[i as usize]
        if step.kind == VIZ_WORKBENCH_REPLAY_EVENT {
            viz_workbench_app_handle_event(app, scene, &!constraint, step.event)
        }
        if step.kind == VIZ_WORKBENCH_REPLAY_TICK {
            viz_workbench_tick(app, scene, (step.dt_ms as f64) / 1000.0)
        }
        hash = viz_replay_present(app, scene, c)
        viz_workbench_replay_store_frame(&!session, i + 1, hash, scene)
        i = i + 1
    }
    session
}

pub fn viz_workbench_replay_verify_session(app: &!VizApp, scene: &!VizScene, ids: &VizWorkbenchIds, c: &!Canvas, session: &VizWorkbenchReplaySession) -> bool with Mut, Div, Alloc {
    var constraint = viz_workbench_constraint(ids)
    var count = session.step_count
    if count < 0 { return false }
    if count > 32 { return false }
    if session.frame_count != count + 1 { return false }

    var hash = viz_replay_present(app, scene, c)
    if hash != session.frame_hashes[0] { return false }
    if viz_audit_hash(scene) != session.audit_hashes[0] { return false }
    if ((scene.time * 1000.0) as i64) != session.times_ms[0] { return false }

    var i: i64 = 0
    while i < count {
        let step = session.steps[i as usize]
        if step.kind == VIZ_WORKBENCH_REPLAY_EVENT {
            viz_workbench_app_handle_event(app, scene, &!constraint, step.event)
        }
        if step.kind == VIZ_WORKBENCH_REPLAY_TICK {
            viz_workbench_tick(app, scene, (step.dt_ms as f64) / 1000.0)
        }
        hash = viz_replay_present(app, scene, c)
        let frame_idx = i + 1
        if hash != session.frame_hashes[frame_idx as usize] { return false }
        if viz_audit_hash(scene) != session.audit_hashes[frame_idx as usize] { return false }
        if ((scene.time * 1000.0) as i64) != session.times_ms[frame_idx as usize] { return false }
        i = i + 1
    }
    hash == session.final_frame_hash && viz_audit_hash(scene) == session.final_audit_hash
}

pub fn viz_workbench_replay_session_hash(session: &VizWorkbenchReplaySession) -> i64 with Mut {
    var h: i64 = 1469598103934665603
    h = h * 131 + session.step_count
    h = h * 131 + session.frame_count
    h = h * 131 + session.final_frame_hash
    h = h * 131 + session.final_audit_hash
    var i: i64 = 0
    while i < session.step_count && i < 32 {
        let step = session.steps[i as usize]
        h = h * 131 + step.kind
        h = h * 131 + step.dt_ms
        h = h * 131 + step.event.kind
        h = h * 131 + step.event.key
        h = h * 131 + step.event.x
        h = h * 131 + step.event.y
        i = i + 1
    }
    i = 0
    while i < session.frame_count && i < 33 {
        h = h * 131 + session.times_ms[i as usize]
        h = h * 131 + session.frame_hashes[i as usize]
        h = h * 131 + session.audit_hashes[i as usize]
        i = i + 1
    }
    h
}

fn viz_workbench_session_timeline_clamp_frame(session: &VizWorkbenchReplaySession, frame_idx: i64) -> i64 {
    if session.frame_count <= 0 { return 0 }
    if frame_idx < 0 { return 0 }
    if frame_idx >= session.frame_count { return session.frame_count - 1 }
    frame_idx
}

pub fn viz_workbench_session_timeline_from_session(session: &VizWorkbenchReplaySession, frame_idx: i64) -> VizWorkbenchSessionTimeline with Mut {
    if session.frame_count <= 0 || session.frame_count > 33 { return viz_workbench_session_timeline_empty() }
    let idx = viz_workbench_session_timeline_clamp_frame(session, frame_idx)
    var prev = idx - 1
    if prev < 0 { prev = idx }
    var next = idx + 1
    if next >= session.frame_count { next = idx }
    let dt = viz_workbench_abs_delta(session.times_ms[idx as usize], session.times_ms[prev as usize])
    let df = viz_workbench_abs_delta(session.frame_hashes[idx as usize], session.frame_hashes[prev as usize])
    let da = viz_workbench_abs_delta(session.audit_hashes[idx as usize], session.audit_hashes[prev as usize])
    var h: i64 = 211
    h = h * 131 + viz_workbench_replay_session_hash(session)
    h = h * 131 + idx
    h = h * 131 + session.frame_hashes[idx as usize]
    h = h * 131 + session.audit_hashes[idx as usize]
    h = h * 131 + session.times_ms[idx as usize]
    VizWorkbenchSessionTimeline {
        valid: true,
        selected_frame: idx,
        frame_count: session.frame_count,
        selected_time_ms: session.times_ms[idx as usize],
        selected_frame_hash: session.frame_hashes[idx as usize],
        selected_audit_hash: session.audit_hashes[idx as usize],
        previous_frame_hash: session.frame_hashes[prev as usize],
        next_frame_hash: session.frame_hashes[next as usize],
        selected_delta_ms: dt,
        selected_frame_delta: df,
        selected_audit_delta: da,
        timeline_hash: h,
    }
}

pub fn viz_workbench_session_timeline_mark(scene: &!VizScene, ids: &VizWorkbenchIds, timeline: &VizWorkbenchSessionTimeline) with Mut, Div {
    if !timeline.valid { return }
    viz_workbench_set_time(scene, (timeline.selected_time_ms as f64) / 1000.0)
    if ids.studio_timeline >= 0 && ids.studio_timeline < scene.node_count {
        scene.nodes[ids.studio_timeline as usize].value = timeline.selected_frame as f64
        scene.nodes[ids.studio_timeline as usize].min_value = 0.0
        var max_frame = timeline.frame_count - 1
        if max_frame < 0 { max_frame = 0 }
        scene.nodes[ids.studio_timeline as usize].max_value = max_frame as f64
    }
}

pub fn viz_workbench_replay_to_frame(
    app: &!VizApp,
    scene: &!VizScene,
    ids: &VizWorkbenchIds,
    c: &!Canvas,
    session: &VizWorkbenchReplaySession,
    frame_idx: i64,
) -> VizWorkbenchSessionTimeline with Mut, Div, Alloc {
    if session.frame_count <= 0 || session.frame_count > 33 { return viz_workbench_session_timeline_empty() }
    if session.step_count < 0 || session.step_count > 32 { return viz_workbench_session_timeline_empty() }
    if session.frame_count != session.step_count + 1 { return viz_workbench_session_timeline_empty() }
    let target = viz_workbench_session_timeline_clamp_frame(session, frame_idx)
    var constraint = viz_workbench_constraint(ids)
    var hash = viz_replay_present(app, scene, c)
    if hash != session.frame_hashes[0] { return viz_workbench_session_timeline_empty() }
    if viz_audit_hash(scene) != session.audit_hashes[0] { return viz_workbench_session_timeline_empty() }
    if ((scene.time * 1000.0) as i64) != session.times_ms[0] { return viz_workbench_session_timeline_empty() }
    if target == 0 {
        let timeline = viz_workbench_session_timeline_from_session(session, 0)
        viz_workbench_session_timeline_mark(scene, ids, &timeline)
        return timeline
    }
    var i: i64 = 0
    while i < target {
        let step = session.steps[i as usize]
        if step.kind == VIZ_WORKBENCH_REPLAY_EVENT {
            viz_workbench_app_handle_event(app, scene, &!constraint, step.event)
        }
        if step.kind == VIZ_WORKBENCH_REPLAY_TICK {
            viz_workbench_tick(app, scene, (step.dt_ms as f64) / 1000.0)
        }
        hash = viz_replay_present(app, scene, c)
        let current_frame = i + 1
        if hash != session.frame_hashes[current_frame as usize] { return viz_workbench_session_timeline_empty() }
        if viz_audit_hash(scene) != session.audit_hashes[current_frame as usize] { return viz_workbench_session_timeline_empty() }
        if ((scene.time * 1000.0) as i64) != session.times_ms[current_frame as usize] { return viz_workbench_session_timeline_empty() }
        i = i + 1
    }
    let timeline = viz_workbench_session_timeline_from_session(session, target)
    viz_workbench_session_timeline_mark(scene, ids, &timeline)
    timeline
}

pub fn viz_workbench_session_archive_hash(archive: &VizWorkbenchSessionArchive) -> i64 with Mut {
    var h: i64 = 307
    h = h * 131 + archive.session_hash
    h = h * 131 + archive.project_hash
    h = h * 131 + archive.timeline_hash
    h = h * 131 + archive.diff_hash
    h = h * 131 + archive.selected_frame
    h = h * 131 + archive.frame_count
    h = h * 131 + archive.final_time_ms
    h = h * 131 + archive.final_frame_hash
    h = h * 131 + archive.final_audit_hash
    h = h * 131 + archive.selected_time_ms
    h = h * 131 + archive.selected_frame_hash
    h = h * 131 + archive.selected_audit_hash
    h
}

fn viz_workbench_session_archive_copy(archive: &VizWorkbenchSessionArchive) -> VizWorkbenchSessionArchive {
    VizWorkbenchSessionArchive {
        valid: archive.valid,
        session_hash: archive.session_hash,
        project_hash: archive.project_hash,
        timeline_hash: archive.timeline_hash,
        diff_hash: archive.diff_hash,
        selected_frame: archive.selected_frame,
        frame_count: archive.frame_count,
        final_time_ms: archive.final_time_ms,
        final_frame_hash: archive.final_frame_hash,
        final_audit_hash: archive.final_audit_hash,
        selected_time_ms: archive.selected_time_ms,
        selected_frame_hash: archive.selected_frame_hash,
        selected_audit_hash: archive.selected_audit_hash,
        archive_hash: archive.archive_hash,
    }
}

pub fn viz_workbench_session_archive_build(
    session: &VizWorkbenchReplaySession,
    project: &VizSceneProject,
    timeline: &VizWorkbenchSessionTimeline,
    diff: &VizWorkbenchProjectDiff,
) -> VizWorkbenchSessionArchive with Mut {
    if !timeline.valid { return viz_workbench_session_archive_empty() }
    if !viz_scene_project_verify(project) { return viz_workbench_session_archive_empty() }
    if session.frame_count <= 0 || session.frame_count > 33 { return viz_workbench_session_archive_empty() }
    if session.step_count < 0 || session.step_count > 32 { return viz_workbench_session_archive_empty() }
    if session.frame_count != session.step_count + 1 { return viz_workbench_session_archive_empty() }
    let session_hash = viz_workbench_replay_session_hash(session)
    if project.replay_signature != session_hash { return viz_workbench_session_archive_empty() }
    if project.final_frame_hash != session.final_frame_hash { return viz_workbench_session_archive_empty() }
    if project.final_audit_hash != session.final_audit_hash { return viz_workbench_session_archive_empty() }
    let final_time = session.times_ms[(session.frame_count - 1) as usize]
    if project.final_time_ms != final_time { return viz_workbench_session_archive_empty() }
    if timeline.frame_count != session.frame_count { return viz_workbench_session_archive_empty() }
    if timeline.selected_frame < 0 || timeline.selected_frame >= session.frame_count { return viz_workbench_session_archive_empty() }
    if timeline.selected_time_ms != session.times_ms[timeline.selected_frame as usize] { return viz_workbench_session_archive_empty() }
    if timeline.selected_frame_hash != session.frame_hashes[timeline.selected_frame as usize] { return viz_workbench_session_archive_empty() }
    if timeline.selected_audit_hash != session.audit_hashes[timeline.selected_frame as usize] { return viz_workbench_session_archive_empty() }
    var diff_hash = 0
    if diff.valid { diff_hash = diff.diff_hash }
    var archive = VizWorkbenchSessionArchive {
        valid: true,
        session_hash: session_hash,
        project_hash: project.project_hash,
        timeline_hash: timeline.timeline_hash,
        diff_hash: diff_hash,
        selected_frame: timeline.selected_frame,
        frame_count: session.frame_count,
        final_time_ms: final_time,
        final_frame_hash: session.final_frame_hash,
        final_audit_hash: session.final_audit_hash,
        selected_time_ms: timeline.selected_time_ms,
        selected_frame_hash: timeline.selected_frame_hash,
        selected_audit_hash: timeline.selected_audit_hash,
        archive_hash: 0,
    }
    archive.archive_hash = viz_workbench_session_archive_hash(&archive)
    archive
}

pub fn viz_workbench_session_archive_verify(
    archive: &VizWorkbenchSessionArchive,
    session: &VizWorkbenchReplaySession,
    project: &VizSceneProject,
    timeline: &VizWorkbenchSessionTimeline,
    diff: &VizWorkbenchProjectDiff,
) -> bool with Mut {
    if !archive.valid { return false }
    let rebuilt = viz_workbench_session_archive_build(session, project, timeline, diff)
    if !rebuilt.valid { return false }
    archive.archive_hash == rebuilt.archive_hash &&
        archive.session_hash == rebuilt.session_hash &&
        archive.project_hash == rebuilt.project_hash &&
        archive.timeline_hash == rebuilt.timeline_hash &&
        archive.diff_hash == rebuilt.diff_hash &&
        archive.selected_frame == rebuilt.selected_frame &&
        archive.frame_count == rebuilt.frame_count &&
        archive.final_time_ms == rebuilt.final_time_ms &&
        archive.final_frame_hash == rebuilt.final_frame_hash &&
        archive.final_audit_hash == rebuilt.final_audit_hash &&
        archive.selected_time_ms == rebuilt.selected_time_ms &&
        archive.selected_frame_hash == rebuilt.selected_frame_hash &&
        archive.selected_audit_hash == rebuilt.selected_audit_hash
}

pub fn viz_workbench_notebook_compare_hash(cmp: &VizWorkbenchNotebookCompare) -> i64 with Mut {
    var h: i64 = 353
    h = h * 131 + cmp.left_index
    h = h * 131 + cmp.right_index
    h = h * 131 + cmp.left_archive_hash
    h = h * 131 + cmp.right_archive_hash
    h = h * 131 + cmp.session_delta
    h = h * 131 + cmp.project_delta
    h = h * 131 + cmp.timeline_delta
    h = h * 131 + cmp.diff_delta
    h = h * 131 + cmp.selected_frame_delta
    h = h * 131 + cmp.final_time_delta_ms
    h = h * 131 + cmp.final_frame_delta
    h = h * 131 + cmp.final_audit_delta
    h
}

pub fn viz_workbench_notebook_compare_archives(
    left: &VizWorkbenchSessionArchive,
    right: &VizWorkbenchSessionArchive,
    left_index: i64,
    right_index: i64,
) -> VizWorkbenchNotebookCompare with Mut {
    if !left.valid { return viz_workbench_notebook_compare_empty() }
    if !right.valid { return viz_workbench_notebook_compare_empty() }
    var cmp = VizWorkbenchNotebookCompare {
        valid: true,
        left_index: left_index,
        right_index: right_index,
        left_archive_hash: left.archive_hash,
        right_archive_hash: right.archive_hash,
        session_delta: right.session_hash - left.session_hash,
        project_delta: right.project_hash - left.project_hash,
        timeline_delta: right.timeline_hash - left.timeline_hash,
        diff_delta: right.diff_hash - left.diff_hash,
        selected_frame_delta: right.selected_frame - left.selected_frame,
        final_time_delta_ms: right.final_time_ms - left.final_time_ms,
        final_frame_delta: right.final_frame_hash - left.final_frame_hash,
        final_audit_delta: right.final_audit_hash - left.final_audit_hash,
        compare_hash: 0,
    }
    cmp.compare_hash = viz_workbench_notebook_compare_hash(&cmp)
    cmp
}

fn viz_workbench_notebook_compare_slots(notebook: &VizWorkbenchNotebook, left_index: i64, right_index: i64) -> VizWorkbenchNotebookCompare with Mut {
    if left_index < 0 || left_index >= notebook.archive_count { return viz_workbench_notebook_compare_empty() }
    if right_index < 0 || right_index >= notebook.archive_count { return viz_workbench_notebook_compare_empty() }
    if !notebook.archive_valid[left_index as usize] { return viz_workbench_notebook_compare_empty() }
    if !notebook.archive_valid[right_index as usize] { return viz_workbench_notebook_compare_empty() }
    var cmp = VizWorkbenchNotebookCompare {
        valid: true,
        left_index: left_index,
        right_index: right_index,
        left_archive_hash: notebook.archive_hashes[left_index as usize],
        right_archive_hash: notebook.archive_hashes[right_index as usize],
        session_delta: notebook.session_hashes[right_index as usize] - notebook.session_hashes[left_index as usize],
        project_delta: notebook.project_hashes[right_index as usize] - notebook.project_hashes[left_index as usize],
        timeline_delta: notebook.timeline_hashes[right_index as usize] - notebook.timeline_hashes[left_index as usize],
        diff_delta: notebook.diff_hashes[right_index as usize] - notebook.diff_hashes[left_index as usize],
        selected_frame_delta: notebook.selected_frames[right_index as usize] - notebook.selected_frames[left_index as usize],
        final_time_delta_ms: notebook.final_time_ms[right_index as usize] - notebook.final_time_ms[left_index as usize],
        final_frame_delta: notebook.final_frame_hashes[right_index as usize] - notebook.final_frame_hashes[left_index as usize],
        final_audit_delta: notebook.final_audit_hashes[right_index as usize] - notebook.final_audit_hashes[left_index as usize],
        compare_hash: 0,
    }
    cmp.compare_hash = viz_workbench_notebook_compare_hash(&cmp)
    cmp
}

pub fn viz_workbench_notebook_hash(notebook: &VizWorkbenchNotebook) -> i64 with Mut {
    var h: i64 = 401
    h = h * 131 + notebook.archive_count
    h = h * 131 + notebook.selected_index
    h = h * 131 + notebook.baseline_index
    h = h * 131 + notebook.compare_index
    h = h * 131 + notebook.selected_archive_hash
    h = h * 131 + notebook.baseline_archive_hash
    h = h * 131 + notebook.compare_archive_hash
    h = h * 131 + notebook.compare_hash
    var i: i64 = 0
    while i < 8 {
        if notebook.archive_valid[i as usize] {
            h = h * 131 + notebook.archive_hashes[i as usize]
        } else {
            h = h * 131 + 17
        }
        i = i + 1
    }
    h
}

fn viz_workbench_notebook_refresh(notebook: &!VizWorkbenchNotebook) with Mut {
    notebook.selected_archive_hash = 0
    notebook.baseline_archive_hash = 0
    notebook.compare_archive_hash = 0
    notebook.compare_hash = 0
    notebook.valid = notebook.archive_count > 0
    if notebook.selected_index >= 0 && notebook.selected_index < 8 && notebook.archive_valid[notebook.selected_index as usize] {
        notebook.selected_archive_hash = notebook.archive_hashes[notebook.selected_index as usize]
    }
    if notebook.baseline_index >= 0 && notebook.baseline_index < 8 && notebook.archive_valid[notebook.baseline_index as usize] {
        notebook.baseline_archive_hash = notebook.archive_hashes[notebook.baseline_index as usize]
    }
    if notebook.compare_index >= 0 && notebook.compare_index < 8 && notebook.archive_valid[notebook.compare_index as usize] {
        notebook.compare_archive_hash = notebook.archive_hashes[notebook.compare_index as usize]
    }
    if notebook.baseline_archive_hash != 0 && notebook.compare_archive_hash != 0 {
        let cmp = viz_workbench_notebook_compare_slots(notebook, notebook.baseline_index, notebook.compare_index)
        notebook.compare_hash = cmp.compare_hash
    }
    notebook.notebook_hash = viz_workbench_notebook_hash(notebook)
}

pub fn viz_workbench_notebook_add_archive(notebook: &!VizWorkbenchNotebook, archive: &VizWorkbenchSessionArchive) -> bool with Mut {
    if !archive.valid { return false }
    if notebook.archive_count < 0 || notebook.archive_count >= 8 { return false }
    let idx = notebook.archive_count
    notebook.archives[idx as usize] = viz_workbench_session_archive_copy(archive)
    notebook.archive_valid[idx as usize] = true
    notebook.archive_hashes[idx as usize] = archive.archive_hash
    notebook.session_hashes[idx as usize] = archive.session_hash
    notebook.project_hashes[idx as usize] = archive.project_hash
    notebook.timeline_hashes[idx as usize] = archive.timeline_hash
    notebook.diff_hashes[idx as usize] = archive.diff_hash
    notebook.selected_frames[idx as usize] = archive.selected_frame
    notebook.final_time_ms[idx as usize] = archive.final_time_ms
    notebook.final_frame_hashes[idx as usize] = archive.final_frame_hash
    notebook.final_audit_hashes[idx as usize] = archive.final_audit_hash
    notebook.archive_count = notebook.archive_count + 1
    notebook.selected_index = idx
    if notebook.archive_count == 1 {
        notebook.baseline_index = 0
        notebook.compare_index = 0
    } else {
        notebook.compare_index = idx
    }
    viz_workbench_notebook_refresh(notebook)
    true
}

pub fn viz_workbench_notebook_select(notebook: &!VizWorkbenchNotebook, selected: i64, baseline: i64, compare: i64) -> bool with Mut {
    if selected < 0 || selected >= notebook.archive_count { return false }
    if baseline < 0 || baseline >= notebook.archive_count { return false }
    if compare < 0 || compare >= notebook.archive_count { return false }
    if !notebook.archive_valid[selected as usize] { return false }
    if !notebook.archive_valid[baseline as usize] { return false }
    if !notebook.archive_valid[compare as usize] { return false }
    notebook.selected_index = selected
    notebook.baseline_index = baseline
    notebook.compare_index = compare
    viz_workbench_notebook_refresh(notebook)
    true
}

pub fn viz_workbench_notebook_compare(notebook: &VizWorkbenchNotebook) -> VizWorkbenchNotebookCompare with Mut {
    if !notebook.valid { return viz_workbench_notebook_compare_empty() }
    if notebook.baseline_index < 0 || notebook.baseline_index >= notebook.archive_count { return viz_workbench_notebook_compare_empty() }
    if notebook.compare_index < 0 || notebook.compare_index >= notebook.archive_count { return viz_workbench_notebook_compare_empty() }
    if !notebook.archive_valid[notebook.baseline_index as usize] { return viz_workbench_notebook_compare_empty() }
    if !notebook.archive_valid[notebook.compare_index as usize] { return viz_workbench_notebook_compare_empty() }
    viz_workbench_notebook_compare_slots(notebook, notebook.baseline_index, notebook.compare_index)
}

pub fn viz_workbench_notebook_verify(notebook: &VizWorkbenchNotebook) -> bool with Mut {
    if !notebook.valid { return false }
    if notebook.archive_count <= 0 || notebook.archive_count > 8 { return false }
    if notebook.selected_index < 0 || notebook.selected_index >= notebook.archive_count { return false }
    if notebook.baseline_index < 0 || notebook.baseline_index >= notebook.archive_count { return false }
    if notebook.compare_index < 0 || notebook.compare_index >= notebook.archive_count { return false }
    var counted: i64 = 0
    var i: i64 = 0
    while i < 8 {
        if notebook.archive_valid[i as usize] {
            if notebook.archive_hashes[i as usize] == 0 { return false }
            if notebook.session_hashes[i as usize] == 0 { return false }
            if notebook.project_hashes[i as usize] == 0 { return false }
            if notebook.timeline_hashes[i as usize] == 0 { return false }
            if notebook.final_frame_hashes[i as usize] == 0 { return false }
            if notebook.final_audit_hashes[i as usize] == 0 { return false }
            counted = counted + 1
        }
        i = i + 1
    }
    if counted != notebook.archive_count { return false }
    if notebook.selected_archive_hash != notebook.archive_hashes[notebook.selected_index as usize] { return false }
    if notebook.baseline_archive_hash != notebook.archive_hashes[notebook.baseline_index as usize] { return false }
    if notebook.compare_archive_hash != notebook.archive_hashes[notebook.compare_index as usize] { return false }
    let cmp = viz_workbench_notebook_compare(notebook)
    if !cmp.valid { return false }
    if notebook.compare_hash != cmp.compare_hash { return false }
    notebook.notebook_hash == viz_workbench_notebook_hash(notebook)
}

pub fn viz_workbench_notebook_browser_hash(browser: &VizWorkbenchNotebookBrowser) -> i64 with Mut {
    var h: i64 = 449
    h = h * 131 + browser.notebook_hash
    h = h * 131 + browser.archive_index
    h = h * 131 + browser.archive_hash
    h = h * 131 + browser.session_hash
    h = h * 131 + browser.project_hash
    h = h * 131 + browser.selected_frame
    h = h * 131 + browser.frame_count
    h = h * 131 + browser.selected_time_ms
    h = h * 131 + browser.selected_frame_hash
    h = h * 131 + browser.selected_audit_hash
    h = h * 131 + browser.replay_timeline_hash
    h = h * 131 + browser.replay_frame_hash
    h = h * 131 + browser.replay_audit_hash
    h = h * 131 + browser.replay_time_ms
    h
}

pub fn viz_workbench_notebook_browser_select(
    notebook: &VizWorkbenchNotebook,
    app: &!VizApp,
    scene: &!VizScene,
    ids: &VizWorkbenchIds,
    canvas: &!Canvas,
    session: &VizWorkbenchReplaySession,
    archive_index: i64,
) -> VizWorkbenchNotebookBrowser with Mut, Div, Alloc {
    if !viz_workbench_notebook_verify(notebook) { return viz_workbench_notebook_browser_empty() }
    if archive_index < 0 || archive_index >= notebook.archive_count { return viz_workbench_notebook_browser_empty() }
    if !notebook.archive_valid[archive_index as usize] { return viz_workbench_notebook_browser_empty() }
    if session.frame_count <= 0 || session.frame_count > 33 { return viz_workbench_notebook_browser_empty() }
    if session.step_count < 0 || session.step_count > 32 { return viz_workbench_notebook_browser_empty() }
    if session.frame_count != session.step_count + 1 { return viz_workbench_notebook_browser_empty() }
    if viz_workbench_replay_session_hash(session) != notebook.session_hashes[archive_index as usize] { return viz_workbench_notebook_browser_empty() }
    let frame = notebook.selected_frames[archive_index as usize]
    if frame < 0 || frame >= session.frame_count { return viz_workbench_notebook_browser_empty() }
    let timeline = viz_workbench_replay_to_frame(app, scene, ids, canvas, session, frame)
    if !timeline.valid { return viz_workbench_notebook_browser_empty() }
    if timeline.timeline_hash != notebook.timeline_hashes[archive_index as usize] { return viz_workbench_notebook_browser_empty() }
    if timeline.selected_frame_hash != notebook.archives[archive_index as usize].selected_frame_hash { return viz_workbench_notebook_browser_empty() }
    if timeline.selected_audit_hash != notebook.archives[archive_index as usize].selected_audit_hash { return viz_workbench_notebook_browser_empty() }
    var browser = VizWorkbenchNotebookBrowser {
        valid: true,
        notebook_hash: notebook.notebook_hash,
        archive_index: archive_index,
        archive_hash: notebook.archive_hashes[archive_index as usize],
        session_hash: notebook.session_hashes[archive_index as usize],
        project_hash: notebook.project_hashes[archive_index as usize],
        selected_frame: frame,
        frame_count: session.frame_count,
        selected_time_ms: timeline.selected_time_ms,
        selected_frame_hash: timeline.selected_frame_hash,
        selected_audit_hash: timeline.selected_audit_hash,
        replay_timeline_hash: timeline.timeline_hash,
        replay_frame_hash: timeline.selected_frame_hash,
        replay_audit_hash: timeline.selected_audit_hash,
        replay_time_ms: ((scene.time * 1000.0) as i64),
        browser_hash: 0,
    }
    browser.browser_hash = viz_workbench_notebook_browser_hash(&browser)
    browser
}

pub fn viz_workbench_notebook_browser_verify(
    browser: &VizWorkbenchNotebookBrowser,
    notebook: &VizWorkbenchNotebook,
    session: &VizWorkbenchReplaySession,
) -> bool with Mut {
    if !browser.valid { return false }
    if !viz_workbench_notebook_verify(notebook) { return false }
    if browser.archive_index < 0 || browser.archive_index >= notebook.archive_count { return false }
    if !notebook.archive_valid[browser.archive_index as usize] { return false }
    if browser.notebook_hash != notebook.notebook_hash { return false }
    if browser.archive_hash != notebook.archive_hashes[browser.archive_index as usize] { return false }
    if browser.session_hash != notebook.session_hashes[browser.archive_index as usize] { return false }
    if browser.project_hash != notebook.project_hashes[browser.archive_index as usize] { return false }
    if browser.selected_frame != notebook.selected_frames[browser.archive_index as usize] { return false }
    if browser.frame_count != session.frame_count { return false }
    if browser.session_hash != viz_workbench_replay_session_hash(session) { return false }
    if browser.selected_frame < 0 || browser.selected_frame >= session.frame_count { return false }
    if browser.selected_time_ms != session.times_ms[browser.selected_frame as usize] { return false }
    if browser.selected_frame_hash != session.frame_hashes[browser.selected_frame as usize] { return false }
    if browser.selected_audit_hash != session.audit_hashes[browser.selected_frame as usize] { return false }
    if browser.replay_timeline_hash != notebook.timeline_hashes[browser.archive_index as usize] { return false }
    if browser.replay_frame_hash != browser.selected_frame_hash { return false }
    if browser.replay_audit_hash != browser.selected_audit_hash { return false }
    browser.browser_hash == viz_workbench_notebook_browser_hash(browser)
}

pub fn viz_workbench_notebook_compare_browser_hash(compare: &VizWorkbenchNotebookCompareBrowser) -> i64 with Mut {
    var h: i64 = 467
    h = h * 131 + compare.notebook_hash
    h = h * 131 + compare.compare_hash
    h = h * 131 + compare.left_index
    h = h * 131 + compare.right_index
    h = h * 131 + compare.left_browser_hash
    h = h * 131 + compare.right_browser_hash
    h = h * 131 + compare.left_archive_hash
    h = h * 131 + compare.right_archive_hash
    h = h * 131 + compare.left_frame
    h = h * 131 + compare.right_frame
    h = h * 131 + compare.left_time_ms
    h = h * 131 + compare.right_time_ms
    h = h * 131 + compare.time_delta_ms
    h = h * 131 + compare.frame_delta
    h = h * 131 + compare.frame_hash_delta
    h = h * 131 + compare.audit_hash_delta
    h
}

pub fn viz_workbench_notebook_compare_browser_select(
    notebook: &VizWorkbenchNotebook,
    left_app: &!VizApp,
    left_scene: &!VizScene,
    left_ids: &VizWorkbenchIds,
    left_canvas: &!Canvas,
    left_session: &VizWorkbenchReplaySession,
    right_app: &!VizApp,
    right_scene: &!VizScene,
    right_ids: &VizWorkbenchIds,
    right_canvas: &!Canvas,
    right_session: &VizWorkbenchReplaySession,
) -> VizWorkbenchNotebookCompareBrowser with Mut, Div, Alloc {
    if !viz_workbench_notebook_verify(notebook) { return viz_workbench_notebook_compare_browser_empty() }
    let cmp = viz_workbench_notebook_compare(notebook)
    if !cmp.valid { return viz_workbench_notebook_compare_browser_empty() }
    let left_browser = viz_workbench_notebook_browser_select(notebook, left_app, left_scene, left_ids, left_canvas, left_session, notebook.baseline_index)
    if !left_browser.valid { return viz_workbench_notebook_compare_browser_empty() }
    let right_browser = viz_workbench_notebook_browser_select(notebook, right_app, right_scene, right_ids, right_canvas, right_session, notebook.compare_index)
    if !right_browser.valid { return viz_workbench_notebook_compare_browser_empty() }
    var compare = VizWorkbenchNotebookCompareBrowser {
        valid: true,
        notebook_hash: notebook.notebook_hash,
        compare_hash: cmp.compare_hash,
        left_index: notebook.baseline_index,
        right_index: notebook.compare_index,
        left_browser_hash: left_browser.browser_hash,
        right_browser_hash: right_browser.browser_hash,
        left_archive_hash: left_browser.archive_hash,
        right_archive_hash: right_browser.archive_hash,
        left_frame: left_browser.selected_frame,
        right_frame: right_browser.selected_frame,
        left_time_ms: left_browser.selected_time_ms,
        right_time_ms: right_browser.selected_time_ms,
        time_delta_ms: right_browser.selected_time_ms - left_browser.selected_time_ms,
        frame_delta: right_browser.selected_frame - left_browser.selected_frame,
        frame_hash_delta: right_browser.selected_frame_hash - left_browser.selected_frame_hash,
        audit_hash_delta: right_browser.selected_audit_hash - left_browser.selected_audit_hash,
        compare_browser_hash: 0,
    }
    compare.compare_browser_hash = viz_workbench_notebook_compare_browser_hash(&compare)
    compare
}

pub fn viz_workbench_notebook_compare_browser_verify(
    compare: &VizWorkbenchNotebookCompareBrowser,
    notebook: &VizWorkbenchNotebook,
    left_browser: &VizWorkbenchNotebookBrowser,
    right_browser: &VizWorkbenchNotebookBrowser,
) -> bool with Mut {
    if !compare.valid { return false }
    if !viz_workbench_notebook_verify(notebook) { return false }
    let cmp = viz_workbench_notebook_compare(notebook)
    if !cmp.valid { return false }
    if compare.notebook_hash != notebook.notebook_hash { return false }
    if compare.compare_hash != cmp.compare_hash { return false }
    if compare.left_index != notebook.baseline_index { return false }
    if compare.right_index != notebook.compare_index { return false }
    if !left_browser.valid { return false }
    if !right_browser.valid { return false }
    if compare.left_browser_hash != left_browser.browser_hash { return false }
    if compare.right_browser_hash != right_browser.browser_hash { return false }
    if compare.left_archive_hash != left_browser.archive_hash { return false }
    if compare.right_archive_hash != right_browser.archive_hash { return false }
    if compare.left_frame != left_browser.selected_frame { return false }
    if compare.right_frame != right_browser.selected_frame { return false }
    if compare.left_time_ms != left_browser.selected_time_ms { return false }
    if compare.right_time_ms != right_browser.selected_time_ms { return false }
    if compare.time_delta_ms != right_browser.selected_time_ms - left_browser.selected_time_ms { return false }
    if compare.frame_delta != right_browser.selected_frame - left_browser.selected_frame { return false }
    if compare.frame_hash_delta != right_browser.selected_frame_hash - left_browser.selected_frame_hash { return false }
    if compare.audit_hash_delta != right_browser.selected_audit_hash - left_browser.selected_audit_hash { return false }
    compare.compare_browser_hash == viz_workbench_notebook_compare_browser_hash(compare)
}

pub fn viz_workbench_experiment_diff_player_hash(player: &VizWorkbenchExperimentDiffPlayer) -> i64 with Mut {
    var h: i64 = 491
    h = h * 131 + player.notebook_hash
    h = h * 131 + player.compare_hash
    h = h * 131 + player.left_index
    h = h * 131 + player.right_index
    h = h * 131 + player.requested_left_frame
    h = h * 131 + player.requested_right_frame
    h = h * 131 + player.left_frame
    h = h * 131 + player.right_frame
    h = h * 131 + player.left_frame_count
    h = h * 131 + player.right_frame_count
    h = h * 131 + player.left_time_ms
    h = h * 131 + player.right_time_ms
    h = h * 131 + player.time_delta_ms
    h = h * 131 + player.frame_delta
    h = h * 131 + player.frame_hash_delta
    h = h * 131 + player.audit_hash_delta
    h = h * 131 + player.frame_hash_distance
    h = h * 131 + player.audit_hash_distance
    h = h * 131 + player.left_timeline_hash
    h = h * 131 + player.right_timeline_hash
    h = h * 131 + player.left_frame_hash
    h = h * 131 + player.right_frame_hash
    h = h * 131 + player.left_audit_hash
    h = h * 131 + player.right_audit_hash
    h
}

pub fn viz_workbench_experiment_diff_player_select(
    notebook: &VizWorkbenchNotebook,
    left_app: &!VizApp,
    left_scene: &!VizScene,
    left_ids: &VizWorkbenchIds,
    left_canvas: &!Canvas,
    left_session: &VizWorkbenchReplaySession,
    right_app: &!VizApp,
    right_scene: &!VizScene,
    right_ids: &VizWorkbenchIds,
    right_canvas: &!Canvas,
    right_session: &VizWorkbenchReplaySession,
    left_frame: i64,
    right_frame: i64,
) -> VizWorkbenchExperimentDiffPlayer with Mut, Div, Alloc {
    if !viz_workbench_notebook_verify(notebook) { return viz_workbench_experiment_diff_player_empty() }
    let cmp = viz_workbench_notebook_compare(notebook)
    if !cmp.valid { return viz_workbench_experiment_diff_player_empty() }
    if viz_workbench_replay_session_hash(left_session) != notebook.session_hashes[notebook.baseline_index as usize] { return viz_workbench_experiment_diff_player_empty() }
    if viz_workbench_replay_session_hash(right_session) != notebook.session_hashes[notebook.compare_index as usize] { return viz_workbench_experiment_diff_player_empty() }
    let left_timeline = viz_workbench_replay_to_frame(left_app, left_scene, left_ids, left_canvas, left_session, left_frame)
    if !left_timeline.valid { return viz_workbench_experiment_diff_player_empty() }
    let right_timeline = viz_workbench_replay_to_frame(right_app, right_scene, right_ids, right_canvas, right_session, right_frame)
    if !right_timeline.valid { return viz_workbench_experiment_diff_player_empty() }
    var player = VizWorkbenchExperimentDiffPlayer {
        valid: true,
        notebook_hash: notebook.notebook_hash,
        compare_hash: cmp.compare_hash,
        left_index: notebook.baseline_index,
        right_index: notebook.compare_index,
        requested_left_frame: left_frame,
        requested_right_frame: right_frame,
        left_frame: left_timeline.selected_frame,
        right_frame: right_timeline.selected_frame,
        left_frame_count: left_timeline.frame_count,
        right_frame_count: right_timeline.frame_count,
        left_time_ms: left_timeline.selected_time_ms,
        right_time_ms: right_timeline.selected_time_ms,
        time_delta_ms: right_timeline.selected_time_ms - left_timeline.selected_time_ms,
        frame_delta: right_timeline.selected_frame - left_timeline.selected_frame,
        frame_hash_delta: right_timeline.selected_frame_hash - left_timeline.selected_frame_hash,
        audit_hash_delta: right_timeline.selected_audit_hash - left_timeline.selected_audit_hash,
        frame_hash_distance: viz_workbench_abs_delta(right_timeline.selected_frame_hash, left_timeline.selected_frame_hash),
        audit_hash_distance: viz_workbench_abs_delta(right_timeline.selected_audit_hash, left_timeline.selected_audit_hash),
        left_timeline_hash: left_timeline.timeline_hash,
        right_timeline_hash: right_timeline.timeline_hash,
        left_frame_hash: left_timeline.selected_frame_hash,
        right_frame_hash: right_timeline.selected_frame_hash,
        left_audit_hash: left_timeline.selected_audit_hash,
        right_audit_hash: right_timeline.selected_audit_hash,
        player_hash: 0,
    }
    player.player_hash = viz_workbench_experiment_diff_player_hash(&player)
    player
}

pub fn viz_workbench_experiment_diff_player_verify(
    player: &VizWorkbenchExperimentDiffPlayer,
    notebook: &VizWorkbenchNotebook,
    left_session: &VizWorkbenchReplaySession,
    right_session: &VizWorkbenchReplaySession,
) -> bool with Mut {
    if !player.valid { return false }
    if !viz_workbench_notebook_verify(notebook) { return false }
    let cmp = viz_workbench_notebook_compare(notebook)
    if !cmp.valid { return false }
    if player.notebook_hash != notebook.notebook_hash { return false }
    if player.compare_hash != cmp.compare_hash { return false }
    if player.left_index != notebook.baseline_index { return false }
    if player.right_index != notebook.compare_index { return false }
    if viz_workbench_replay_session_hash(left_session) != notebook.session_hashes[player.left_index as usize] { return false }
    if viz_workbench_replay_session_hash(right_session) != notebook.session_hashes[player.right_index as usize] { return false }
    if player.left_frame < 0 || player.left_frame >= left_session.frame_count { return false }
    if player.right_frame < 0 || player.right_frame >= right_session.frame_count { return false }
    if player.left_frame_count != left_session.frame_count { return false }
    if player.right_frame_count != right_session.frame_count { return false }
    if player.left_time_ms != left_session.times_ms[player.left_frame as usize] { return false }
    if player.right_time_ms != right_session.times_ms[player.right_frame as usize] { return false }
    if player.left_frame_hash != left_session.frame_hashes[player.left_frame as usize] { return false }
    if player.right_frame_hash != right_session.frame_hashes[player.right_frame as usize] { return false }
    if player.left_audit_hash != left_session.audit_hashes[player.left_frame as usize] { return false }
    if player.right_audit_hash != right_session.audit_hashes[player.right_frame as usize] { return false }
    if player.time_delta_ms != player.right_time_ms - player.left_time_ms { return false }
    if player.frame_delta != player.right_frame - player.left_frame { return false }
    if player.frame_hash_delta != player.right_frame_hash - player.left_frame_hash { return false }
    if player.audit_hash_delta != player.right_audit_hash - player.left_audit_hash { return false }
    if player.frame_hash_distance != viz_workbench_abs_delta(player.right_frame_hash, player.left_frame_hash) { return false }
    if player.audit_hash_distance != viz_workbench_abs_delta(player.right_audit_hash, player.left_audit_hash) { return false }
    if player.left_timeline_hash != viz_workbench_session_timeline_from_session(left_session, player.left_frame).timeline_hash { return false }
    if player.right_timeline_hash != viz_workbench_session_timeline_from_session(right_session, player.right_frame).timeline_hash { return false }
    player.player_hash == viz_workbench_experiment_diff_player_hash(player)
}

pub fn viz_workbench_experiment_diff_overlay_hash(overlay: &VizWorkbenchExperimentDiffOverlay) -> i64 with Mut {
    var h: i64 = 509
    h = h * 131 + overlay.player_hash
    h = h * 131 + overlay.diff_node
    h = h * 131 + overlay.dt_node
    h = h * 131 + overlay.audit_node
    h = h * 131 + overlay.frame_node
    h = h * 131 + overlay.tooltip_node
    h = h * 131 + overlay.diff_marker
    h = h * 131 + overlay.time_delta_ms
    h = h * 131 + overlay.frame_delta
    h = h * 131 + overlay.frame_hash_marker
    h = h * 131 + overlay.audit_hash_marker
    h = h * 131 + overlay.frame_hash_distance_marker
    h = h * 131 + overlay.audit_hash_distance_marker
    h
}

fn viz_workbench_experiment_diff_overlay_label(scene: &!VizScene, node_idx: i64) with Mut {
    if node_idx < 0 || node_idx >= scene.node_count { return }
    var txt: [i8; 64] = [0; 64]
    txt[0] = 100
    txt[1] = 105
    txt[2] = 102
    txt[3] = 102
    txt[4] = 32
    txt[5] = 111
    txt[6] = 118
    txt[7] = 101
    txt[8] = 114
    txt[9] = 108
    txt[10] = 97
    txt[11] = 121
    viz_node_set_label(scene, node_idx, &txt, 12)
}

pub fn viz_workbench_experiment_diff_overlay_apply(
    scene: &!VizScene,
    ids: &VizWorkbenchIds,
    player: &VizWorkbenchExperimentDiffPlayer,
) -> VizWorkbenchExperimentDiffOverlay with Mut, Div {
    if !player.valid { return viz_workbench_experiment_diff_overlay_empty() }
    if ids.workspace_diff < 0 || ids.workspace_diff >= scene.node_count { return viz_workbench_experiment_diff_overlay_empty() }
    if ids.workspace_dt < 0 || ids.workspace_dt >= scene.node_count { return viz_workbench_experiment_diff_overlay_empty() }
    if ids.workspace_daudit < 0 || ids.workspace_daudit >= scene.node_count { return viz_workbench_experiment_diff_overlay_empty() }
    if ids.workspace_dframe < 0 || ids.workspace_dframe >= scene.node_count { return viz_workbench_experiment_diff_overlay_empty() }
    let diff_marker = viz_workbench_hash_marker(player.player_hash)
    let frame_marker = viz_workbench_hash_marker(player.frame_hash_delta)
    let audit_marker = viz_workbench_hash_marker(player.audit_hash_delta)
    let frame_distance_marker = viz_workbench_hash_marker(player.frame_hash_distance)
    let audit_distance_marker = viz_workbench_hash_marker(player.audit_hash_distance)
    scene.nodes[ids.workspace_diff as usize].value = diff_marker
    scene.nodes[ids.workspace_diff as usize].min_value = 0.0
    scene.nodes[ids.workspace_diff as usize].max_value = 1000000.0
    scene.nodes[ids.workspace_diff as usize].style = viz_style_rgb(255, 170, 130)
    scene.nodes[ids.workspace_dt as usize].value = player.time_delta_ms as f64
    scene.nodes[ids.workspace_dt as usize].min_value = 0.0
    scene.nodes[ids.workspace_dt as usize].max_value = 10000000.0
    scene.nodes[ids.workspace_dt as usize].style = viz_style_rgb(160, 210, 255)
    scene.nodes[ids.workspace_daudit as usize].value = audit_marker
    scene.nodes[ids.workspace_daudit as usize].min_value = 0.0
    scene.nodes[ids.workspace_daudit as usize].max_value = 1000000.0
    scene.nodes[ids.workspace_daudit as usize].style = viz_style_rgb(245, 220, 140)
    scene.nodes[ids.workspace_dframe as usize].value = frame_marker
    scene.nodes[ids.workspace_dframe as usize].min_value = 0.0
    scene.nodes[ids.workspace_dframe as usize].max_value = 1000000.0
    scene.nodes[ids.workspace_dframe as usize].style = viz_style_rgb(180, 220, 255)
    if ids.workspace_dproject >= 0 && ids.workspace_dproject < scene.node_count {
        scene.nodes[ids.workspace_dproject as usize].value = frame_distance_marker
        scene.nodes[ids.workspace_dproject as usize].style = viz_style_rgb(120, 225, 150)
    }
    if ids.workspace_dnodes >= 0 && ids.workspace_dnodes < scene.node_count {
        scene.nodes[ids.workspace_dnodes as usize].value = audit_distance_marker
        scene.nodes[ids.workspace_dnodes as usize].style = viz_style_rgb(255, 170, 130)
    }
    if ids.tooltip >= 0 && ids.tooltip < scene.node_count {
        viz_workbench_experiment_diff_overlay_label(scene, ids.tooltip)
        scene.nodes[ids.tooltip as usize].value = player.player_hash as f64
        scene.nodes[ids.tooltip as usize].style = viz_style_rgb(255, 170, 130)
    }
    scene.selected_node = ids.workspace_diff
    scene.focused_node = ids.workspace_diff
    scene.hovered_node = ids.workspace_dframe
    scene.nodes[ids.workspace_diff as usize].selected = true
    var overlay = VizWorkbenchExperimentDiffOverlay {
        valid: true,
        player_hash: player.player_hash,
        overlay_hash: 0,
        diff_node: ids.workspace_diff,
        dt_node: ids.workspace_dt,
        audit_node: ids.workspace_daudit,
        frame_node: ids.workspace_dframe,
        tooltip_node: ids.tooltip,
        diff_marker: diff_marker as i64,
        time_delta_ms: player.time_delta_ms,
        frame_delta: player.frame_delta,
        frame_hash_marker: frame_marker as i64,
        audit_hash_marker: audit_marker as i64,
        frame_hash_distance_marker: frame_distance_marker as i64,
        audit_hash_distance_marker: audit_distance_marker as i64,
    }
    overlay.overlay_hash = viz_workbench_experiment_diff_overlay_hash(&overlay)
    overlay
}

pub fn viz_workbench_experiment_diff_overlay_verify(
    overlay: &VizWorkbenchExperimentDiffOverlay,
    scene: &VizScene,
    player: &VizWorkbenchExperimentDiffPlayer,
) -> bool with Mut, Div {
    if !overlay.valid { return false }
    if !player.valid { return false }
    if overlay.player_hash != player.player_hash { return false }
    if overlay.diff_node < 0 || overlay.diff_node >= scene.node_count { return false }
    if overlay.dt_node < 0 || overlay.dt_node >= scene.node_count { return false }
    if overlay.audit_node < 0 || overlay.audit_node >= scene.node_count { return false }
    if overlay.frame_node < 0 || overlay.frame_node >= scene.node_count { return false }
    if scene.nodes[overlay.diff_node as usize].value != overlay.diff_marker as f64 { return false }
    if scene.nodes[overlay.dt_node as usize].value != overlay.time_delta_ms as f64 { return false }
    if scene.nodes[overlay.audit_node as usize].value != overlay.audit_hash_marker as f64 { return false }
    if scene.nodes[overlay.frame_node as usize].value != overlay.frame_hash_marker as f64 { return false }
    if overlay.diff_marker != viz_workbench_hash_marker(player.player_hash) as i64 { return false }
    if overlay.frame_hash_marker != viz_workbench_hash_marker(player.frame_hash_delta) as i64 { return false }
    if overlay.audit_hash_marker != viz_workbench_hash_marker(player.audit_hash_delta) as i64 { return false }
    if overlay.frame_hash_distance_marker != viz_workbench_hash_marker(player.frame_hash_distance) as i64 { return false }
    if overlay.audit_hash_distance_marker != viz_workbench_hash_marker(player.audit_hash_distance) as i64 { return false }
    if scene.selected_node != overlay.diff_node { return false }
    if scene.focused_node != overlay.diff_node { return false }
    if !scene.nodes[overlay.diff_node as usize].selected { return false }
    if scene.nodes[overlay.diff_node as usize].style.r != 255 { return false }
    if scene.nodes[overlay.diff_node as usize].style.g != 170 { return false }
    if scene.nodes[overlay.diff_node as usize].style.b != 130 { return false }
    if overlay.tooltip_node >= 0 && overlay.tooltip_node < scene.node_count {
        if scene.nodes[overlay.tooltip_node as usize].label_len != 12 { return false }
        if scene.nodes[overlay.tooltip_node as usize].label[0] != 100 { return false }
        if scene.nodes[overlay.tooltip_node as usize].label[5] != 111 { return false }
    }
    overlay.overlay_hash == viz_workbench_experiment_diff_overlay_hash(overlay)
}

pub fn viz_workbench_experiment_diff_artifact_hash(artifact: &VizWorkbenchExperimentDiffArtifact) -> i64 with Mut {
    var h: i64 = 541
    h = h * 131 + artifact.notebook_hash
    h = h * 131 + artifact.compare_hash
    h = h * 131 + artifact.player_hash
    h = h * 131 + artifact.overlay_hash
    h = h * 131 + artifact.left_archive_hash
    h = h * 131 + artifact.right_archive_hash
    h = h * 131 + artifact.scene_audit_hash
    h = h * 131 + artifact.rendered_frame_hash
    h = h * 131 + artifact.selected_left_frame
    h = h * 131 + artifact.selected_right_frame
    h = h * 131 + artifact.frame_delta
    h = h * 131 + artifact.time_delta_ms
    h = h * 131 + artifact.frame_hash_delta
    h = h * 131 + artifact.audit_hash_delta
    h
}

pub fn viz_workbench_experiment_diff_artifact_build(
    notebook: &VizWorkbenchNotebook,
    player: &VizWorkbenchExperimentDiffPlayer,
    overlay: &VizWorkbenchExperimentDiffOverlay,
    scene: &VizScene,
    rendered_frame_hash: i64,
) -> VizWorkbenchExperimentDiffArtifact with Mut {
    if !viz_workbench_notebook_verify(notebook) { return viz_workbench_experiment_diff_artifact_empty() }
    if !player.valid { return viz_workbench_experiment_diff_artifact_empty() }
    if !overlay.valid { return viz_workbench_experiment_diff_artifact_empty() }
    if player.notebook_hash != notebook.notebook_hash { return viz_workbench_experiment_diff_artifact_empty() }
    if overlay.player_hash != player.player_hash { return viz_workbench_experiment_diff_artifact_empty() }
    if rendered_frame_hash == 0 { return viz_workbench_experiment_diff_artifact_empty() }
    var artifact = VizWorkbenchExperimentDiffArtifact {
        valid: true,
        notebook_hash: notebook.notebook_hash,
        compare_hash: player.compare_hash,
        player_hash: player.player_hash,
        overlay_hash: overlay.overlay_hash,
        left_archive_hash: notebook.baseline_archive_hash,
        right_archive_hash: notebook.compare_archive_hash,
        scene_audit_hash: viz_audit_hash(scene),
        rendered_frame_hash: rendered_frame_hash,
        selected_left_frame: player.left_frame,
        selected_right_frame: player.right_frame,
        frame_delta: player.frame_delta,
        time_delta_ms: player.time_delta_ms,
        frame_hash_delta: player.frame_hash_delta,
        audit_hash_delta: player.audit_hash_delta,
        artifact_hash: 0,
    }
    artifact.artifact_hash = viz_workbench_experiment_diff_artifact_hash(&artifact)
    artifact
}

pub fn viz_workbench_experiment_diff_artifact_verify(
    artifact: &VizWorkbenchExperimentDiffArtifact,
    notebook: &VizWorkbenchNotebook,
    player: &VizWorkbenchExperimentDiffPlayer,
    overlay: &VizWorkbenchExperimentDiffOverlay,
    scene: &VizScene,
) -> bool with Mut {
    if !artifact.valid { return false }
    if !viz_workbench_notebook_verify(notebook) { return false }
    if !player.valid { return false }
    if !overlay.valid { return false }
    if artifact.notebook_hash != notebook.notebook_hash { return false }
    if artifact.compare_hash != player.compare_hash { return false }
    if artifact.player_hash != player.player_hash { return false }
    if artifact.overlay_hash != overlay.overlay_hash { return false }
    if artifact.left_archive_hash != notebook.baseline_archive_hash { return false }
    if artifact.right_archive_hash != notebook.compare_archive_hash { return false }
    if artifact.scene_audit_hash != viz_audit_hash(scene) { return false }
    if artifact.rendered_frame_hash == 0 { return false }
    if artifact.selected_left_frame != player.left_frame { return false }
    if artifact.selected_right_frame != player.right_frame { return false }
    if artifact.frame_delta != player.frame_delta { return false }
    if artifact.time_delta_ms != player.time_delta_ms { return false }
    if artifact.frame_hash_delta != player.frame_hash_delta { return false }
    if artifact.audit_hash_delta != player.audit_hash_delta { return false }
    artifact.artifact_hash == viz_workbench_experiment_diff_artifact_hash(artifact)
}

pub fn viz_workbench_experiment_diff_library_hash(library: &VizWorkbenchExperimentDiffLibrary) -> i64 with Mut {
    var h: i64 = 563
    h = h * 131 + library.artifact_count
    h = h * 131 + library.selected_index
    h = h * 131 + library.baseline_index
    h = h * 131 + library.compare_index
    h = h * 131 + library.selected_artifact_hash
    h = h * 131 + library.baseline_artifact_hash
    h = h * 131 + library.compare_artifact_hash
    h = h * 131 + library.artifact_hash_delta
    h = h * 131 + library.rendered_frame_hash_delta
    h = h * 131 + library.scene_audit_hash_delta
    var i: i64 = 0
    while i < 8 {
        if library.artifact_valid[i as usize] {
            h = h * 131 + library.artifact_hashes[i as usize]
            h = h * 131 + library.rendered_frame_hashes[i as usize]
            h = h * 131 + library.scene_audit_hashes[i as usize]
        } else {
            h = h * 131 + 23
        }
        i = i + 1
    }
    h
}

fn viz_workbench_experiment_diff_library_refresh(library: &!VizWorkbenchExperimentDiffLibrary) with Mut {
    library.selected_artifact_hash = 0
    library.baseline_artifact_hash = 0
    library.compare_artifact_hash = 0
    library.artifact_hash_delta = 0
    library.rendered_frame_hash_delta = 0
    library.scene_audit_hash_delta = 0
    library.valid = library.artifact_count > 0
    if library.selected_index >= 0 && library.selected_index < 8 && library.artifact_valid[library.selected_index as usize] {
        library.selected_artifact_hash = library.artifact_hashes[library.selected_index as usize]
    }
    if library.baseline_index >= 0 && library.baseline_index < 8 && library.artifact_valid[library.baseline_index as usize] {
        library.baseline_artifact_hash = library.artifact_hashes[library.baseline_index as usize]
    }
    if library.compare_index >= 0 && library.compare_index < 8 && library.artifact_valid[library.compare_index as usize] {
        library.compare_artifact_hash = library.artifact_hashes[library.compare_index as usize]
    }
    if library.baseline_artifact_hash != 0 && library.compare_artifact_hash != 0 {
        library.artifact_hash_delta = library.artifact_hashes[library.compare_index as usize] - library.artifact_hashes[library.baseline_index as usize]
        library.rendered_frame_hash_delta = library.rendered_frame_hashes[library.compare_index as usize] - library.rendered_frame_hashes[library.baseline_index as usize]
        library.scene_audit_hash_delta = library.scene_audit_hashes[library.compare_index as usize] - library.scene_audit_hashes[library.baseline_index as usize]
    }
    library.library_hash = viz_workbench_experiment_diff_library_hash(library)
}

pub fn viz_workbench_experiment_diff_library_add(
    library: &!VizWorkbenchExperimentDiffLibrary,
    artifact: &VizWorkbenchExperimentDiffArtifact,
) -> bool with Mut {
    if !artifact.valid { return false }
    if library.artifact_count < 0 || library.artifact_count >= 8 { return false }
    let idx = library.artifact_count
    library.artifacts[idx as usize] = *artifact
    library.artifact_valid[idx as usize] = true
    library.artifact_hashes[idx as usize] = artifact.artifact_hash
    library.rendered_frame_hashes[idx as usize] = artifact.rendered_frame_hash
    library.scene_audit_hashes[idx as usize] = artifact.scene_audit_hash
    library.artifact_count = library.artifact_count + 1
    library.selected_index = idx
    if library.artifact_count == 1 {
        library.baseline_index = 0
        library.compare_index = 0
    } else {
        library.compare_index = idx
    }
    viz_workbench_experiment_diff_library_refresh(library)
    true
}

pub fn viz_workbench_experiment_diff_library_select(
    library: &!VizWorkbenchExperimentDiffLibrary,
    selected: i64,
    baseline: i64,
    compare: i64,
) -> bool with Mut {
    if selected < 0 || selected >= library.artifact_count { return false }
    if baseline < 0 || baseline >= library.artifact_count { return false }
    if compare < 0 || compare >= library.artifact_count { return false }
    if !library.artifact_valid[selected as usize] { return false }
    if !library.artifact_valid[baseline as usize] { return false }
    if !library.artifact_valid[compare as usize] { return false }
    library.selected_index = selected
    library.baseline_index = baseline
    library.compare_index = compare
    viz_workbench_experiment_diff_library_refresh(library)
    true
}

pub fn viz_workbench_experiment_diff_library_verify(library: &VizWorkbenchExperimentDiffLibrary) -> bool with Mut {
    if !library.valid { return false }
    if library.artifact_count <= 0 || library.artifact_count > 8 { return false }
    if library.selected_index < 0 || library.selected_index >= library.artifact_count { return false }
    if library.baseline_index < 0 || library.baseline_index >= library.artifact_count { return false }
    if library.compare_index < 0 || library.compare_index >= library.artifact_count { return false }
    var counted: i64 = 0
    var i: i64 = 0
    while i < 8 {
        if library.artifact_valid[i as usize] {
            if library.artifacts[i as usize].artifact_hash != library.artifact_hashes[i as usize] { return false }
            if library.artifacts[i as usize].rendered_frame_hash != library.rendered_frame_hashes[i as usize] { return false }
            if library.artifacts[i as usize].scene_audit_hash != library.scene_audit_hashes[i as usize] { return false }
            if library.artifact_hashes[i as usize] == 0 { return false }
            if library.rendered_frame_hashes[i as usize] == 0 { return false }
            if library.scene_audit_hashes[i as usize] == 0 { return false }
            counted = counted + 1
        }
        i = i + 1
    }
    if counted != library.artifact_count { return false }
    if library.selected_artifact_hash != library.artifact_hashes[library.selected_index as usize] { return false }
    if library.baseline_artifact_hash != library.artifact_hashes[library.baseline_index as usize] { return false }
    if library.compare_artifact_hash != library.artifact_hashes[library.compare_index as usize] { return false }
    if library.artifact_hash_delta != library.artifact_hashes[library.compare_index as usize] - library.artifact_hashes[library.baseline_index as usize] { return false }
    if library.rendered_frame_hash_delta != library.rendered_frame_hashes[library.compare_index as usize] - library.rendered_frame_hashes[library.baseline_index as usize] { return false }
    if library.scene_audit_hash_delta != library.scene_audit_hashes[library.compare_index as usize] - library.scene_audit_hashes[library.baseline_index as usize] { return false }
    library.library_hash == viz_workbench_experiment_diff_library_hash(library)
}

pub fn viz_workbench_experiment_diff_library_browser_hash(browser: &VizWorkbenchExperimentDiffLibraryBrowser) -> i64 with Mut {
    var h: i64 = 587
    h = h * 131 + browser.library_hash
    h = h * 131 + browser.selected_index
    h = h * 131 + browser.baseline_index
    h = h * 131 + browser.compare_index
    h = h * 131 + browser.artifact_count
    h = h * 131 + browser.selected_artifact_hash
    h = h * 131 + browser.baseline_artifact_hash
    h = h * 131 + browser.compare_artifact_hash
    h = h * 131 + browser.artifact_hash_delta
    h = h * 131 + browser.rendered_frame_hash_delta
    h = h * 131 + browser.scene_audit_hash_delta
    h = h * 131 + browser.selected_marker
    h = h * 131 + browser.baseline_marker
    h = h * 131 + browser.compare_marker
    h = h * 131 + browser.artifact_delta_marker
    h = h * 131 + browser.rendered_delta_marker
    h = h * 131 + browser.audit_delta_marker
    h = h * 131 + browser.selected_node
    h = h * 131 + browser.baseline_node
    h = h * 131 + browser.compare_node
    h = h * 131 + browser.artifact_delta_node
    h = h * 131 + browser.rendered_delta_node
    h = h * 131 + browser.audit_delta_node
    h = h * 131 + browser.tooltip_node
    h
}

fn viz_workbench_experiment_diff_library_browser_label(scene: &!VizScene, node_idx: i64) with Mut {
    if node_idx < 0 || node_idx >= scene.node_count { return }
    var txt: [i8; 64] = [0; 64]
    txt[0] = 100
    txt[1] = 105
    txt[2] = 102
    txt[3] = 102
    txt[4] = 32
    txt[5] = 108
    txt[6] = 105
    txt[7] = 98
    txt[8] = 114
    txt[9] = 97
    txt[10] = 114
    txt[11] = 121
    viz_node_set_label(scene, node_idx, &txt, 12)
}

pub fn viz_workbench_experiment_diff_library_browser_apply(
    library: &VizWorkbenchExperimentDiffLibrary,
    scene: &!VizScene,
    ids: &VizWorkbenchIds,
) -> VizWorkbenchExperimentDiffLibraryBrowser with Mut, Div {
    if !viz_workbench_experiment_diff_library_verify(library) { return viz_workbench_experiment_diff_library_browser_empty() }
    if ids.workspace_diff < 0 || ids.workspace_diff >= scene.node_count { return viz_workbench_experiment_diff_library_browser_empty() }
    if ids.workspace_dt < 0 || ids.workspace_dt >= scene.node_count { return viz_workbench_experiment_diff_library_browser_empty() }
    if ids.workspace_daudit < 0 || ids.workspace_daudit >= scene.node_count { return viz_workbench_experiment_diff_library_browser_empty() }
    if ids.workspace_dframe < 0 || ids.workspace_dframe >= scene.node_count { return viz_workbench_experiment_diff_library_browser_empty() }
    let selected_marker = viz_workbench_hash_marker(library.selected_artifact_hash)
    let baseline_marker = viz_workbench_hash_marker(library.baseline_artifact_hash)
    let compare_marker = viz_workbench_hash_marker(library.compare_artifact_hash)
    let artifact_delta_marker = viz_workbench_hash_marker(library.artifact_hash_delta)
    let rendered_delta_marker = viz_workbench_hash_marker(library.rendered_frame_hash_delta)
    let audit_delta_marker = viz_workbench_hash_marker(library.scene_audit_hash_delta)
    let selected_tint = 150 + ((selected_marker as i64) - ((selected_marker as i64) / 90) * 90)
    let baseline_tint = 120 + ((baseline_marker as i64) - ((baseline_marker as i64) / 80) * 80)
    let compare_tint = 130 + ((compare_marker as i64) - ((compare_marker as i64) / 90) * 90)
    let delta_tint = 110 + ((artifact_delta_marker as i64) - ((artifact_delta_marker as i64) / 100) * 100)
    scene.nodes[ids.workspace_diff as usize].value = artifact_delta_marker
    scene.nodes[ids.workspace_diff as usize].min_value = 0.0
    scene.nodes[ids.workspace_diff as usize].max_value = 1000000.0
    scene.nodes[ids.workspace_diff as usize].style = viz_style_rgb(255, delta_tint, 120)
    scene.nodes[ids.workspace_dt as usize].value = selected_marker
    scene.nodes[ids.workspace_dt as usize].min_value = 0.0
    scene.nodes[ids.workspace_dt as usize].max_value = 1000000.0
    scene.nodes[ids.workspace_dt as usize].style = viz_style_rgb(160, selected_tint, 255)
    scene.nodes[ids.workspace_daudit as usize].value = audit_delta_marker
    scene.nodes[ids.workspace_daudit as usize].min_value = 0.0
    scene.nodes[ids.workspace_daudit as usize].max_value = 1000000.0
    scene.nodes[ids.workspace_daudit as usize].style = viz_style_rgb(245, 225, 140)
    scene.nodes[ids.workspace_dframe as usize].value = rendered_delta_marker
    scene.nodes[ids.workspace_dframe as usize].min_value = 0.0
    scene.nodes[ids.workspace_dframe as usize].max_value = 1000000.0
    scene.nodes[ids.workspace_dframe as usize].style = viz_style_rgb(190, 220, 255)
    if ids.workspace_dproject >= 0 && ids.workspace_dproject < scene.node_count {
        scene.nodes[ids.workspace_dproject as usize].value = baseline_marker
        scene.nodes[ids.workspace_dproject as usize].style = viz_style_rgb(120, baseline_tint, 150)
    }
    if ids.workspace_dnodes >= 0 && ids.workspace_dnodes < scene.node_count {
        scene.nodes[ids.workspace_dnodes as usize].value = compare_marker
        scene.nodes[ids.workspace_dnodes as usize].style = viz_style_rgb(255, compare_tint, 130)
    }
    if ids.tooltip >= 0 && ids.tooltip < scene.node_count {
        viz_workbench_experiment_diff_library_browser_label(scene, ids.tooltip)
        scene.nodes[ids.tooltip as usize].value = library.library_hash as f64
        scene.nodes[ids.tooltip as usize].style = viz_style_rgb(255, 140, 120)
    }
    scene.selected_node = ids.workspace_diff
    scene.focused_node = ids.workspace_diff
    scene.hovered_node = ids.workspace_dt
    scene.nodes[ids.workspace_diff as usize].selected = true
    var browser = VizWorkbenchExperimentDiffLibraryBrowser {
        valid: true,
        library_hash: library.library_hash,
        selected_index: library.selected_index,
        baseline_index: library.baseline_index,
        compare_index: library.compare_index,
        artifact_count: library.artifact_count,
        selected_artifact_hash: library.selected_artifact_hash,
        baseline_artifact_hash: library.baseline_artifact_hash,
        compare_artifact_hash: library.compare_artifact_hash,
        artifact_hash_delta: library.artifact_hash_delta,
        rendered_frame_hash_delta: library.rendered_frame_hash_delta,
        scene_audit_hash_delta: library.scene_audit_hash_delta,
        selected_marker: selected_marker as i64,
        baseline_marker: baseline_marker as i64,
        compare_marker: compare_marker as i64,
        artifact_delta_marker: artifact_delta_marker as i64,
        rendered_delta_marker: rendered_delta_marker as i64,
        audit_delta_marker: audit_delta_marker as i64,
        selected_node: ids.workspace_dt,
        baseline_node: ids.workspace_dproject,
        compare_node: ids.workspace_dnodes,
        artifact_delta_node: ids.workspace_diff,
        rendered_delta_node: ids.workspace_dframe,
        audit_delta_node: ids.workspace_daudit,
        tooltip_node: ids.tooltip,
        browser_hash: 0,
    }
    browser.browser_hash = viz_workbench_experiment_diff_library_browser_hash(&browser)
    browser
}

pub fn viz_workbench_experiment_diff_library_browser_verify(
    browser: &VizWorkbenchExperimentDiffLibraryBrowser,
    library: &VizWorkbenchExperimentDiffLibrary,
    scene: &VizScene,
) -> bool with Mut, Div {
    if !browser.valid { return false }
    if !viz_workbench_experiment_diff_library_verify(library) { return false }
    if browser.library_hash != library.library_hash { return false }
    if browser.selected_index != library.selected_index { return false }
    if browser.baseline_index != library.baseline_index { return false }
    if browser.compare_index != library.compare_index { return false }
    if browser.artifact_count != library.artifact_count { return false }
    if browser.selected_artifact_hash != library.selected_artifact_hash { return false }
    if browser.baseline_artifact_hash != library.baseline_artifact_hash { return false }
    if browser.compare_artifact_hash != library.compare_artifact_hash { return false }
    if browser.artifact_hash_delta != library.artifact_hash_delta { return false }
    if browser.rendered_frame_hash_delta != library.rendered_frame_hash_delta { return false }
    if browser.scene_audit_hash_delta != library.scene_audit_hash_delta { return false }
    if browser.selected_marker != viz_workbench_hash_marker(library.selected_artifact_hash) as i64 { return false }
    if browser.baseline_marker != viz_workbench_hash_marker(library.baseline_artifact_hash) as i64 { return false }
    if browser.compare_marker != viz_workbench_hash_marker(library.compare_artifact_hash) as i64 { return false }
    if browser.artifact_delta_marker != viz_workbench_hash_marker(library.artifact_hash_delta) as i64 { return false }
    if browser.rendered_delta_marker != viz_workbench_hash_marker(library.rendered_frame_hash_delta) as i64 { return false }
    if browser.audit_delta_marker != viz_workbench_hash_marker(library.scene_audit_hash_delta) as i64 { return false }
    if browser.artifact_delta_node < 0 || browser.artifact_delta_node >= scene.node_count { return false }
    if browser.selected_node < 0 || browser.selected_node >= scene.node_count { return false }
    if browser.rendered_delta_node < 0 || browser.rendered_delta_node >= scene.node_count { return false }
    if browser.audit_delta_node < 0 || browser.audit_delta_node >= scene.node_count { return false }
    if scene.nodes[browser.artifact_delta_node as usize].value != browser.artifact_delta_marker as f64 { return false }
    if scene.nodes[browser.selected_node as usize].value != browser.selected_marker as f64 { return false }
    if scene.nodes[browser.rendered_delta_node as usize].value != browser.rendered_delta_marker as f64 { return false }
    if scene.nodes[browser.audit_delta_node as usize].value != browser.audit_delta_marker as f64 { return false }
    if browser.baseline_node >= 0 && browser.baseline_node < scene.node_count {
        if scene.nodes[browser.baseline_node as usize].value != browser.baseline_marker as f64 { return false }
    }
    if browser.compare_node >= 0 && browser.compare_node < scene.node_count {
        if scene.nodes[browser.compare_node as usize].value != browser.compare_marker as f64 { return false }
    }
    if scene.selected_node != browser.artifact_delta_node { return false }
    if scene.focused_node != browser.artifact_delta_node { return false }
    if !scene.nodes[browser.artifact_delta_node as usize].selected { return false }
    if scene.nodes[browser.artifact_delta_node as usize].style.r != 255 { return false }
    if scene.nodes[browser.artifact_delta_node as usize].style.g < 110 { return false }
    if scene.nodes[browser.artifact_delta_node as usize].style.g > 209 { return false }
    if scene.nodes[browser.artifact_delta_node as usize].style.b != 120 { return false }
    if browser.tooltip_node >= 0 && browser.tooltip_node < scene.node_count {
        if scene.nodes[browser.tooltip_node as usize].label_len != 12 { return false }
        if scene.nodes[browser.tooltip_node as usize].label[0] != 100 { return false }
        if scene.nodes[browser.tooltip_node as usize].label[5] != 108 { return false }
    }
    browser.browser_hash == viz_workbench_experiment_diff_library_browser_hash(browser)
}

pub fn viz_workbench_experiment_compare_mode_hash(mode: &VizWorkbenchExperimentCompareMode) -> i64 with Mut {
    var h: i64 = 601
    h = h * 131 + mode.library.library_hash
    h = h * 131 + mode.browser.browser_hash
    h = h * 131 + mode.event_count
    h = h * 131 + mode.select_count
    h = h * 131 + mode.baseline_count
    h = h * 131 + mode.compare_count
    h = h * 131 + mode.last_event_kind
    h = h * 131 + mode.last_event_key
    h = h * 131 + mode.last_action
    h = h * 131 + mode.last_frame_hash
    h
}

fn viz_workbench_experiment_compare_mode_prev(idx: i64, count: i64) -> i64 {
    if count <= 0 { return 0 }
    if idx <= 0 { return count - 1 }
    idx - 1
}

fn viz_workbench_experiment_compare_mode_next(idx: i64, count: i64) -> i64 {
    if count <= 0 { return 0 }
    if idx + 1 >= count { return 0 }
    idx + 1
}

pub fn viz_workbench_experiment_compare_mode_init(
    library: &VizWorkbenchExperimentDiffLibrary,
    app: &VizApp,
    scene: &!VizScene,
    ids: &VizWorkbenchIds,
    c: &Canvas,
) -> VizWorkbenchExperimentCompareMode with Mut, Div {
    if !viz_workbench_experiment_diff_library_verify(library) { return viz_workbench_experiment_compare_mode_empty() }
    let browser = viz_workbench_experiment_diff_library_browser_apply(library, scene, ids)
    if !browser.valid { return viz_workbench_experiment_compare_mode_empty() }
    var mode = VizWorkbenchExperimentCompareMode {
        valid: true,
        library: *library,
        browser: browser,
        event_count: 0,
        select_count: 0,
        baseline_count: 0,
        compare_count: 0,
        last_event_kind: 0,
        last_event_key: 0,
        last_action: 0,
        last_frame_hash: viz_app_frame_hash(app, scene, c),
        mode_hash: 0,
    }
    mode.mode_hash = viz_workbench_experiment_compare_mode_hash(&mode)
    mode
}

pub fn viz_workbench_experiment_compare_mode_capture_frame(
    mode: &!VizWorkbenchExperimentCompareMode,
    app: &VizApp,
    scene: &VizScene,
    c: &Canvas,
) -> i64 with Mut {
    if !mode.valid { return 0 }
    mode.last_frame_hash = viz_app_frame_hash(app, scene, c)
    mode.mode_hash = viz_workbench_experiment_compare_mode_hash(mode)
    mode.last_frame_hash
}

pub fn viz_workbench_experiment_compare_mode_handle_event(
    app: &!VizApp,
    scene: &!VizScene,
    ids: &VizWorkbenchIds,
    mode: &!VizWorkbenchExperimentCompareMode,
    ev: Event,
) -> bool with Mut, Div {
    if !mode.valid { return false }
    if !viz_workbench_experiment_diff_library_verify(&mode.library) { return false }
    var action: i64 = 0
    var selected = mode.library.selected_index
    var baseline = mode.library.baseline_index
    var compare = mode.library.compare_index
    if ev.kind == EV_KEY_PRESS && ev.key == KEY_RIGHT {
        selected = viz_workbench_experiment_compare_mode_next(selected, mode.library.artifact_count)
        compare = selected
        action = 1
        mode.select_count = mode.select_count + 1
        mode.compare_count = mode.compare_count + 1
    }
    if ev.kind == EV_KEY_PRESS && ev.key == KEY_LEFT {
        selected = viz_workbench_experiment_compare_mode_prev(selected, mode.library.artifact_count)
        compare = selected
        action = 2
        mode.select_count = mode.select_count + 1
        mode.compare_count = mode.compare_count + 1
    }
    if ev.kind == EV_MOUSE_PRESS && ev.key == MOUSE_LEFT {
        let idx = viz_scene_hit_test(scene, ev.x, ev.y)
        if idx >= 0 && idx < scene.node_count {
            let tag = scene.nodes[idx as usize].tag
            if tag == VIZ_WORKBENCH_TAG_WORKSPACE_DIFF {
                selected = viz_workbench_experiment_compare_mode_next(selected, mode.library.artifact_count)
                compare = selected
                action = 3
                mode.select_count = mode.select_count + 1
                mode.compare_count = mode.compare_count + 1
            }
            if tag == VIZ_WORKBENCH_TAG_WORKSPACE_DPROJECT {
                baseline = selected
                action = 4
                mode.baseline_count = mode.baseline_count + 1
            }
            if tag == VIZ_WORKBENCH_TAG_WORKSPACE_DNODES {
                compare = selected
                action = 5
                mode.compare_count = mode.compare_count + 1
            }
            if tag == VIZ_WORKBENCH_TAG_WORKSPACE_COMPARE {
                compare = viz_workbench_experiment_compare_mode_next(compare, mode.library.artifact_count)
                selected = compare
                action = 6
                mode.select_count = mode.select_count + 1
                mode.compare_count = mode.compare_count + 1
            }
        }
    }
    if action == 0 { return false }
    if !viz_workbench_experiment_diff_library_select(&!mode.library, selected, baseline, compare) { return false }
    let browser = viz_workbench_experiment_diff_library_browser_apply(&mode.library, scene, ids)
    if !browser.valid { return false }
    mode.browser = browser
    mode.event_count = mode.event_count + 1
    mode.last_event_kind = ev.kind
    mode.last_event_key = ev.key
    mode.last_action = action
    app.dirty = true
    mode.mode_hash = viz_workbench_experiment_compare_mode_hash(mode)
    true
}

pub fn viz_workbench_experiment_compare_mode_verify(
    mode: &VizWorkbenchExperimentCompareMode,
    scene: &VizScene,
) -> bool with Mut, Div {
    if !mode.valid { return false }
    if !viz_workbench_experiment_diff_library_verify(&mode.library) { return false }
    if !viz_workbench_experiment_diff_library_browser_verify(&mode.browser, &mode.library, scene) { return false }
    if mode.event_count < 0 { return false }
    if mode.select_count < 0 { return false }
    if mode.baseline_count < 0 { return false }
    if mode.compare_count < 0 { return false }
    if mode.last_action < 0 || mode.last_action > 6 { return false }
    mode.mode_hash == viz_workbench_experiment_compare_mode_hash(mode)
}

pub fn viz_workbench_experiment_package_hash(pkg: &VizWorkbenchExperimentPackage) -> i64 with Mut {
    var h: i64 = 617
    h = h * 131 + pkg.notebook_hash
    h = h * 131 + pkg.notebook_compare_hash
    h = h * 131 + pkg.library_hash
    h = h * 131 + pkg.library_browser_hash
    h = h * 131 + pkg.compare_mode_hash
    h = h * 131 + pkg.selected_archive_hash
    h = h * 131 + pkg.baseline_archive_hash
    h = h * 131 + pkg.compare_archive_hash
    h = h * 131 + pkg.selected_artifact_hash
    h = h * 131 + pkg.baseline_artifact_hash
    h = h * 131 + pkg.compare_artifact_hash
    h = h * 131 + pkg.artifact_count
    h = h * 131 + pkg.archive_count
    h = h * 131 + pkg.event_count
    h = h * 131 + pkg.select_count
    h = h * 131 + pkg.baseline_count
    h = h * 131 + pkg.compare_count
    h = h * 131 + pkg.last_event_kind
    h = h * 131 + pkg.last_event_key
    h = h * 131 + pkg.last_action
    h = h * 131 + pkg.compare_mode_frame_hash
    h = h * 131 + pkg.rendered_frame_hash
    h = h * 131 + pkg.scene_audit_hash
    h = h * 131 + pkg.artifact_hash_delta
    h = h * 131 + pkg.rendered_frame_hash_delta
    h = h * 131 + pkg.scene_audit_hash_delta
    h
}

pub fn viz_workbench_experiment_package_build(
    notebook: &VizWorkbenchNotebook,
    library: &VizWorkbenchExperimentDiffLibrary,
    browser: &VizWorkbenchExperimentDiffLibraryBrowser,
    mode: &VizWorkbenchExperimentCompareMode,
    scene: &VizScene,
    rendered_frame_hash: i64,
) -> VizWorkbenchExperimentPackage with Mut, Div {
    if !viz_workbench_notebook_verify(notebook) { return viz_workbench_experiment_package_empty() }
    if !viz_workbench_experiment_diff_library_verify(library) { return viz_workbench_experiment_package_empty() }
    if !viz_workbench_experiment_diff_library_browser_verify(browser, library, scene) { return viz_workbench_experiment_package_empty() }
    if !viz_workbench_experiment_compare_mode_verify(mode, scene) { return viz_workbench_experiment_package_empty() }
    if rendered_frame_hash == 0 { return viz_workbench_experiment_package_empty() }
    if mode.library.library_hash != library.library_hash { return viz_workbench_experiment_package_empty() }
    if mode.browser.browser_hash != browser.browser_hash { return viz_workbench_experiment_package_empty() }
    var pkg = VizWorkbenchExperimentPackage {
        valid: true,
        notebook_hash: notebook.notebook_hash,
        notebook_compare_hash: notebook.compare_hash,
        library_hash: library.library_hash,
        library_browser_hash: browser.browser_hash,
        compare_mode_hash: mode.mode_hash,
        selected_archive_hash: notebook.selected_archive_hash,
        baseline_archive_hash: notebook.baseline_archive_hash,
        compare_archive_hash: notebook.compare_archive_hash,
        selected_artifact_hash: library.selected_artifact_hash,
        baseline_artifact_hash: library.baseline_artifact_hash,
        compare_artifact_hash: library.compare_artifact_hash,
        artifact_count: library.artifact_count,
        archive_count: notebook.archive_count,
        event_count: mode.event_count,
        select_count: mode.select_count,
        baseline_count: mode.baseline_count,
        compare_count: mode.compare_count,
        last_event_kind: mode.last_event_kind,
        last_event_key: mode.last_event_key,
        last_action: mode.last_action,
        compare_mode_frame_hash: mode.last_frame_hash,
        rendered_frame_hash: rendered_frame_hash,
        scene_audit_hash: viz_audit_hash(scene),
        artifact_hash_delta: library.artifact_hash_delta,
        rendered_frame_hash_delta: library.rendered_frame_hash_delta,
        scene_audit_hash_delta: library.scene_audit_hash_delta,
        package_hash: 0,
    }
    pkg.package_hash = viz_workbench_experiment_package_hash(&pkg)
    pkg
}

pub fn viz_workbench_experiment_package_verify(
    pkg: &VizWorkbenchExperimentPackage,
    notebook: &VizWorkbenchNotebook,
    library: &VizWorkbenchExperimentDiffLibrary,
    browser: &VizWorkbenchExperimentDiffLibraryBrowser,
    mode: &VizWorkbenchExperimentCompareMode,
    scene: &VizScene,
) -> bool with Mut, Div {
    if !pkg.valid { return false }
    if !viz_workbench_notebook_verify(notebook) { return false }
    if !viz_workbench_experiment_diff_library_verify(library) { return false }
    if !viz_workbench_experiment_diff_library_browser_verify(browser, library, scene) { return false }
    if !viz_workbench_experiment_compare_mode_verify(mode, scene) { return false }
    if pkg.notebook_hash != notebook.notebook_hash { return false }
    if pkg.notebook_compare_hash != notebook.compare_hash { return false }
    if pkg.library_hash != library.library_hash { return false }
    if pkg.library_browser_hash != browser.browser_hash { return false }
    if pkg.compare_mode_hash != mode.mode_hash { return false }
    if pkg.selected_archive_hash != notebook.selected_archive_hash { return false }
    if pkg.baseline_archive_hash != notebook.baseline_archive_hash { return false }
    if pkg.compare_archive_hash != notebook.compare_archive_hash { return false }
    if pkg.selected_artifact_hash != library.selected_artifact_hash { return false }
    if pkg.baseline_artifact_hash != library.baseline_artifact_hash { return false }
    if pkg.compare_artifact_hash != library.compare_artifact_hash { return false }
    if pkg.artifact_count != library.artifact_count { return false }
    if pkg.archive_count != notebook.archive_count { return false }
    if pkg.event_count != mode.event_count { return false }
    if pkg.select_count != mode.select_count { return false }
    if pkg.baseline_count != mode.baseline_count { return false }
    if pkg.compare_count != mode.compare_count { return false }
    if pkg.last_event_kind != mode.last_event_kind { return false }
    if pkg.last_event_key != mode.last_event_key { return false }
    if pkg.last_action != mode.last_action { return false }
    if pkg.compare_mode_frame_hash != mode.last_frame_hash { return false }
    if pkg.rendered_frame_hash == 0 { return false }
    if pkg.scene_audit_hash != viz_audit_hash(scene) { return false }
    if pkg.artifact_hash_delta != library.artifact_hash_delta { return false }
    if pkg.rendered_frame_hash_delta != library.rendered_frame_hash_delta { return false }
    if pkg.scene_audit_hash_delta != library.scene_audit_hash_delta { return false }
    pkg.package_hash == viz_workbench_experiment_package_hash(pkg)
}

pub fn viz_workbench_experiment_package_restore_hash(restore: &VizWorkbenchExperimentPackageRestore) -> i64 with Mut {
    var h: i64 = 631
    h = h * 131 + restore.package_hash
    h = h * 131 + restore.restored_library_hash
    h = h * 131 + restore.restored_browser_hash
    h = h * 131 + restore.restored_mode_hash
    h = h * 131 + restore.restored_frame_hash
    h = h * 131 + restore.restored_scene_audit_hash
    h = h * 131 + restore.selected_index
    h = h * 131 + restore.baseline_index
    h = h * 131 + restore.compare_index
    h
}

fn viz_workbench_experiment_package_find_artifact(library: &VizWorkbenchExperimentDiffLibrary, artifact_hash: i64) -> i64 with Mut {
    var i: i64 = 0
    while i < library.artifact_count && i < 8 {
        if library.artifact_valid[i as usize] && library.artifact_hashes[i as usize] == artifact_hash {
            return i
        }
        i = i + 1
    }
    -1
}

fn viz_workbench_experiment_package_copy_library(
    dst: &!VizWorkbenchExperimentDiffLibrary,
    src: &VizWorkbenchExperimentDiffLibrary,
) with Mut {
    dst.valid = src.valid
    dst.artifacts = src.artifacts
    dst.artifact_valid = src.artifact_valid
    dst.artifact_hashes = src.artifact_hashes
    dst.rendered_frame_hashes = src.rendered_frame_hashes
    dst.scene_audit_hashes = src.scene_audit_hashes
    dst.artifact_count = src.artifact_count
    dst.selected_index = src.selected_index
    dst.baseline_index = src.baseline_index
    dst.compare_index = src.compare_index
    dst.selected_artifact_hash = src.selected_artifact_hash
    dst.baseline_artifact_hash = src.baseline_artifact_hash
    dst.compare_artifact_hash = src.compare_artifact_hash
    dst.artifact_hash_delta = src.artifact_hash_delta
    dst.rendered_frame_hash_delta = src.rendered_frame_hash_delta
    dst.scene_audit_hash_delta = src.scene_audit_hash_delta
    dst.library_hash = src.library_hash
}

fn viz_workbench_experiment_package_write_mode(
    mode: &!VizWorkbenchExperimentCompareMode,
    library: &VizWorkbenchExperimentDiffLibrary,
    browser: &VizWorkbenchExperimentDiffLibraryBrowser,
    pkg: &VizWorkbenchExperimentPackage,
) with Mut {
    mode.valid = true
    mode.library = *library
    mode.browser = *browser
    mode.event_count = pkg.event_count
    mode.select_count = pkg.select_count
    mode.baseline_count = pkg.baseline_count
    mode.compare_count = pkg.compare_count
    mode.last_event_kind = pkg.last_event_kind
    mode.last_event_key = pkg.last_event_key
    mode.last_action = pkg.last_action
    mode.last_frame_hash = pkg.compare_mode_frame_hash
    mode.mode_hash = 0
    mode.mode_hash = viz_workbench_experiment_compare_mode_hash(mode)
}

pub fn viz_workbench_experiment_package_restore(
    pkg: &VizWorkbenchExperimentPackage,
    source_library: &VizWorkbenchExperimentDiffLibrary,
    app: &!VizApp,
    scene: &!VizScene,
    ids: &VizWorkbenchIds,
    c: &!Canvas,
    restored_library: &!VizWorkbenchExperimentDiffLibrary,
    restored_mode: &!VizWorkbenchExperimentCompareMode,
) -> VizWorkbenchExperimentPackageRestore with Mut, Div, Alloc {
    if !pkg.valid { return viz_workbench_experiment_package_restore_empty() }
    if pkg.package_hash != viz_workbench_experiment_package_hash(pkg) { return viz_workbench_experiment_package_restore_empty() }
    if !viz_workbench_experiment_diff_library_verify(source_library) { return viz_workbench_experiment_package_restore_empty() }
    if source_library.artifact_count != pkg.artifact_count { return viz_workbench_experiment_package_restore_empty() }
    let selected = viz_workbench_experiment_package_find_artifact(source_library, pkg.selected_artifact_hash)
    let baseline = viz_workbench_experiment_package_find_artifact(source_library, pkg.baseline_artifact_hash)
    let compare = viz_workbench_experiment_package_find_artifact(source_library, pkg.compare_artifact_hash)
    if selected < 0 || baseline < 0 || compare < 0 { return viz_workbench_experiment_package_restore_empty() }
    viz_workbench_experiment_package_copy_library(restored_library, source_library)
    if !viz_workbench_experiment_diff_library_select(restored_library, selected, baseline, compare) { return viz_workbench_experiment_package_restore_empty() }
    if restored_library.library_hash != pkg.library_hash { return viz_workbench_experiment_package_restore_empty() }
    let browser = viz_workbench_experiment_diff_library_browser_apply(restored_library, scene, ids)
    if !browser.valid { return viz_workbench_experiment_package_restore_empty() }
    if browser.browser_hash != pkg.library_browser_hash { return viz_workbench_experiment_package_restore_empty() }
    viz_workbench_experiment_package_write_mode(restored_mode, restored_library, &browser, pkg)
    if restored_mode.mode_hash != pkg.compare_mode_hash { return viz_workbench_experiment_package_restore_empty() }
    if !viz_workbench_experiment_compare_mode_verify(restored_mode, scene) { return viz_workbench_experiment_package_restore_empty() }
    canvas_clear(c, app.bg_r, app.bg_g, app.bg_b)
    viz_canvas_render_scene(scene, c)
    let rendered = viz_workbench_canvas_hash(c)
    var restore = VizWorkbenchExperimentPackageRestore {
        valid: true,
        package_hash: pkg.package_hash,
        restored_library_hash: restored_library.library_hash,
        restored_browser_hash: restored_mode.browser.browser_hash,
        restored_mode_hash: restored_mode.mode_hash,
        restored_frame_hash: rendered,
        restored_scene_audit_hash: viz_audit_hash(scene),
        selected_index: selected,
        baseline_index: baseline,
        compare_index: compare,
        restore_hash: 0,
    }
    restore.restore_hash = viz_workbench_experiment_package_restore_hash(&restore)
    restore
}

pub fn viz_workbench_experiment_package_restore_verify(
    restore: &VizWorkbenchExperimentPackageRestore,
    pkg: &VizWorkbenchExperimentPackage,
    restored_library: &VizWorkbenchExperimentDiffLibrary,
    restored_mode: &VizWorkbenchExperimentCompareMode,
    scene: &VizScene,
) -> bool with Mut, Div {
    if !restore.valid { return false }
    if !pkg.valid { return false }
    if restore.package_hash != pkg.package_hash { return false }
    if !viz_workbench_experiment_diff_library_verify(restored_library) { return false }
    if !viz_workbench_experiment_compare_mode_verify(restored_mode, scene) { return false }
    if restore.restored_library_hash != restored_library.library_hash { return false }
    if restore.restored_browser_hash != restored_mode.browser.browser_hash { return false }
    if restore.restored_mode_hash != restored_mode.mode_hash { return false }
    if restore.restored_library_hash != pkg.library_hash { return false }
    if restore.restored_browser_hash != pkg.library_browser_hash { return false }
    if restore.restored_mode_hash != pkg.compare_mode_hash { return false }
    if restore.restored_frame_hash == 0 { return false }
    if restore.restored_scene_audit_hash != viz_audit_hash(scene) { return false }
    if restore.selected_index != restored_library.selected_index { return false }
    if restore.baseline_index != restored_library.baseline_index { return false }
    if restore.compare_index != restored_library.compare_index { return false }
    restore.restore_hash == viz_workbench_experiment_package_restore_hash(restore)
}

pub fn viz_workbench_experiment_package_store_hash(store: &VizWorkbenchExperimentPackageStore) -> i64 with Mut {
    var h: i64 = 641
    h = h * 131 + store.package_count
    h = h * 131 + store.active_slot
    h = h * 131 + store.baseline_slot
    h = h * 131 + store.compare_slot
    h = h * 131 + store.active_package_hash
    h = h * 131 + store.baseline_package_hash
    h = h * 131 + store.compare_package_hash
    h = h * 131 + store.package_hash_delta
    h = h * 131 + store.rendered_frame_hash_delta
    h = h * 131 + store.scene_audit_hash_delta
    h = h * 131 + store.save_count
    h = h * 131 + store.select_count
    var i: i64 = 0
    while i < 4 {
        if store.package_valid[i as usize] {
            h = h * 131 + store.package_hashes[i as usize]
            h = h * 131 + store.library_hashes[i as usize]
            h = h * 131 + store.compare_mode_hashes[i as usize]
            h = h * 131 + store.rendered_frame_hashes[i as usize]
            h = h * 131 + store.scene_audit_hashes[i as usize]
        } else {
            h = h * 131 + 29
        }
        i = i + 1
    }
    h
}

fn viz_workbench_experiment_package_store_refresh(store: &!VizWorkbenchExperimentPackageStore) with Mut {
    store.active_package_hash = 0
    store.baseline_package_hash = 0
    store.compare_package_hash = 0
    store.package_hash_delta = 0
    store.rendered_frame_hash_delta = 0
    store.scene_audit_hash_delta = 0
    store.valid = store.package_count > 0
    if store.active_slot >= 0 && store.active_slot < 4 && store.package_valid[store.active_slot as usize] {
        store.active_package_hash = store.package_hashes[store.active_slot as usize]
    }
    if store.baseline_slot >= 0 && store.baseline_slot < 4 && store.package_valid[store.baseline_slot as usize] {
        store.baseline_package_hash = store.package_hashes[store.baseline_slot as usize]
    }
    if store.compare_slot >= 0 && store.compare_slot < 4 && store.package_valid[store.compare_slot as usize] {
        store.compare_package_hash = store.package_hashes[store.compare_slot as usize]
    }
    if store.baseline_package_hash != 0 && store.compare_package_hash != 0 {
        store.package_hash_delta = store.package_hashes[store.compare_slot as usize] - store.package_hashes[store.baseline_slot as usize]
        store.rendered_frame_hash_delta = store.rendered_frame_hashes[store.compare_slot as usize] - store.rendered_frame_hashes[store.baseline_slot as usize]
        store.scene_audit_hash_delta = store.scene_audit_hashes[store.compare_slot as usize] - store.scene_audit_hashes[store.baseline_slot as usize]
    }
    store.store_hash = viz_workbench_experiment_package_store_hash(store)
}

pub fn viz_workbench_experiment_package_store_add(
    store: &!VizWorkbenchExperimentPackageStore,
    pkg: &VizWorkbenchExperimentPackage,
) -> bool with Mut {
    if !pkg.valid { return false }
    if pkg.package_hash != viz_workbench_experiment_package_hash(pkg) { return false }
    if store.package_count < 0 || store.package_count >= 4 { return false }
    let idx = store.package_count
    store.packages[idx as usize] = *pkg
    store.package_valid[idx as usize] = true
    store.package_hashes[idx as usize] = pkg.package_hash
    store.library_hashes[idx as usize] = pkg.library_hash
    store.compare_mode_hashes[idx as usize] = pkg.compare_mode_hash
    store.rendered_frame_hashes[idx as usize] = pkg.rendered_frame_hash
    store.scene_audit_hashes[idx as usize] = pkg.scene_audit_hash
    store.package_count = store.package_count + 1
    store.active_slot = idx
    if store.package_count == 1 {
        store.baseline_slot = 0
        store.compare_slot = 0
    } else {
        store.compare_slot = idx
    }
    store.save_count = store.save_count + 1
    viz_workbench_experiment_package_store_refresh(store)
    true
}

pub fn viz_workbench_experiment_package_store_select(
    store: &!VizWorkbenchExperimentPackageStore,
    active: i64,
    baseline: i64,
    compare: i64,
) -> bool with Mut {
    if active < 0 || active >= store.package_count { return false }
    if baseline < 0 || baseline >= store.package_count { return false }
    if compare < 0 || compare >= store.package_count { return false }
    if !store.package_valid[active as usize] { return false }
    if !store.package_valid[baseline as usize] { return false }
    if !store.package_valid[compare as usize] { return false }
    store.active_slot = active
    store.baseline_slot = baseline
    store.compare_slot = compare
    store.select_count = store.select_count + 1
    viz_workbench_experiment_package_store_refresh(store)
    true
}

pub fn viz_workbench_experiment_package_store_verify(store: &VizWorkbenchExperimentPackageStore) -> bool with Mut {
    if !store.valid { return false }
    if store.package_count <= 0 || store.package_count > 4 { return false }
    if store.active_slot < 0 || store.active_slot >= store.package_count { return false }
    if store.baseline_slot < 0 || store.baseline_slot >= store.package_count { return false }
    if store.compare_slot < 0 || store.compare_slot >= store.package_count { return false }
    var counted: i64 = 0
    var i: i64 = 0
    while i < 4 {
        if store.package_valid[i as usize] {
            if !store.packages[i as usize].valid { return false }
            if store.packages[i as usize].package_hash != store.package_hashes[i as usize] { return false }
            if store.packages[i as usize].library_hash != store.library_hashes[i as usize] { return false }
            if store.packages[i as usize].compare_mode_hash != store.compare_mode_hashes[i as usize] { return false }
            if store.packages[i as usize].rendered_frame_hash != store.rendered_frame_hashes[i as usize] { return false }
            if store.packages[i as usize].scene_audit_hash != store.scene_audit_hashes[i as usize] { return false }
            if store.package_hashes[i as usize] == 0 { return false }
            if store.rendered_frame_hashes[i as usize] == 0 { return false }
            if store.scene_audit_hashes[i as usize] == 0 { return false }
            counted = counted + 1
        }
        i = i + 1
    }
    if counted != store.package_count { return false }
    if store.active_package_hash != store.package_hashes[store.active_slot as usize] { return false }
    if store.baseline_package_hash != store.package_hashes[store.baseline_slot as usize] { return false }
    if store.compare_package_hash != store.package_hashes[store.compare_slot as usize] { return false }
    if store.package_hash_delta != store.package_hashes[store.compare_slot as usize] - store.package_hashes[store.baseline_slot as usize] { return false }
    if store.rendered_frame_hash_delta != store.rendered_frame_hashes[store.compare_slot as usize] - store.rendered_frame_hashes[store.baseline_slot as usize] { return false }
    if store.scene_audit_hash_delta != store.scene_audit_hashes[store.compare_slot as usize] - store.scene_audit_hashes[store.baseline_slot as usize] { return false }
    store.store_hash == viz_workbench_experiment_package_store_hash(store)
}

pub fn viz_workbench_experiment_package_store_mark(
    scene: &!VizScene,
    ids: &VizWorkbenchIds,
    store: &VizWorkbenchExperimentPackageStore,
) with Mut, Div {
    if ids.experiment_store_active >= 0 && ids.experiment_store_active < scene.node_count {
        scene.nodes[ids.experiment_store_active as usize].value = store.active_slot as f64
        scene.nodes[ids.experiment_store_active as usize].min_value = 0.0
        scene.nodes[ids.experiment_store_active as usize].max_value = 3.0
    }
    if ids.experiment_store_baseline >= 0 && ids.experiment_store_baseline < scene.node_count {
        scene.nodes[ids.experiment_store_baseline as usize].value = store.baseline_slot as f64
        scene.nodes[ids.experiment_store_baseline as usize].min_value = 0.0
        scene.nodes[ids.experiment_store_baseline as usize].max_value = 3.0
    }
    if ids.experiment_store_compare >= 0 && ids.experiment_store_compare < scene.node_count {
        scene.nodes[ids.experiment_store_compare as usize].value = store.compare_slot as f64
        scene.nodes[ids.experiment_store_compare as usize].min_value = 0.0
        scene.nodes[ids.experiment_store_compare as usize].max_value = 3.0
    }
    if ids.experiment_store_package_delta >= 0 && ids.experiment_store_package_delta < scene.node_count {
        scene.nodes[ids.experiment_store_package_delta as usize].value = viz_workbench_hash_marker(store.package_hash_delta)
        scene.nodes[ids.experiment_store_package_delta as usize].min_value = 0.0
        scene.nodes[ids.experiment_store_package_delta as usize].max_value = 1000000.0
    }
    if ids.experiment_store_frame_delta >= 0 && ids.experiment_store_frame_delta < scene.node_count {
        scene.nodes[ids.experiment_store_frame_delta as usize].value = viz_workbench_hash_marker(store.rendered_frame_hash_delta)
        scene.nodes[ids.experiment_store_frame_delta as usize].min_value = 0.0
        scene.nodes[ids.experiment_store_frame_delta as usize].max_value = 1000000.0
    }
    if ids.experiment_store_audit_delta >= 0 && ids.experiment_store_audit_delta < scene.node_count {
        scene.nodes[ids.experiment_store_audit_delta as usize].value = viz_workbench_hash_marker(store.scene_audit_hash_delta)
        scene.nodes[ids.experiment_store_audit_delta as usize].min_value = 0.0
        scene.nodes[ids.experiment_store_audit_delta as usize].max_value = 1000000.0
    }
    viz_workbench_sync_molecule_mirrors(scene)
}

fn viz_workbench_experiment_package_store_copy_mode(
    dst: &!VizWorkbenchExperimentCompareMode,
    src: &VizWorkbenchExperimentCompareMode,
) with Mut {
    dst.valid = src.valid
    dst.library = src.library
    dst.browser = src.browser
    dst.event_count = src.event_count
    dst.select_count = src.select_count
    dst.baseline_count = src.baseline_count
    dst.compare_count = src.compare_count
    dst.last_event_kind = src.last_event_kind
    dst.last_event_key = src.last_event_key
    dst.last_action = src.last_action
    dst.last_frame_hash = src.last_frame_hash
    dst.mode_hash = src.mode_hash
}

pub fn viz_workbench_experiment_package_store_restore_active(
    app: &!VizApp,
    scene: &!VizScene,
    ids: &VizWorkbenchIds,
    store: &VizWorkbenchExperimentPackageStore,
    c: &!Canvas,
    mode: &!VizWorkbenchExperimentCompareMode,
) -> VizWorkbenchExperimentPackageRestore with Mut, Div, Alloc {
    if !viz_workbench_experiment_package_store_verify(store) { return viz_workbench_experiment_package_restore_empty() }
    if store.active_slot < 0 || store.active_slot >= store.package_count { return viz_workbench_experiment_package_restore_empty() }
    let pkg = store.packages[store.active_slot as usize]
    var restored_library = viz_workbench_experiment_diff_library_empty()
    var restored_mode = viz_workbench_experiment_compare_mode_empty()
    let restore = viz_workbench_experiment_package_restore(&pkg, &mode.library, app, scene, ids, c, &!restored_library, &!restored_mode)
    if restore.valid {
        viz_workbench_experiment_package_store_copy_mode(mode, &restored_mode)
    }
    restore
}

pub fn viz_workbench_handle_experiment_package_store_event(
    app: &!VizApp,
    scene: &!VizScene,
    ids: &VizWorkbenchIds,
    notebook: &VizWorkbenchNotebook,
    mode: &!VizWorkbenchExperimentCompareMode,
    store: &!VizWorkbenchExperimentPackageStore,
    c: &!Canvas,
    ev: Event,
) -> bool with Mut, Div, Alloc {
    if ev.kind != EV_MOUSE_PRESS || ev.key != MOUSE_LEFT { return false }
    let idx = viz_scene_hit_test(scene, ev.x, ev.y)
    if idx < 0 || idx >= scene.node_count { return false }
    let tag = scene.nodes[idx as usize].tag
    if tag == VIZ_WORKBENCH_TAG_EXPERIMENT_STORE_SAVE {
        canvas_clear(c, app.bg_r, app.bg_g, app.bg_b)
        viz_canvas_render_scene(scene, c)
        let pkg = viz_workbench_experiment_package_build(notebook, &mode.library, &mode.browser, mode, scene, viz_workbench_canvas_hash(c))
        if !viz_workbench_experiment_package_store_add(store, &pkg) { return false }
        viz_workbench_experiment_package_store_mark(scene, ids, store)
        return true
    }
    if tag == VIZ_WORKBENCH_TAG_EXPERIMENT_STORE_ACTIVE {
        if store.package_count <= 0 { return false }
        var next = store.active_slot + 1
        if next >= store.package_count { next = 0 }
        if !viz_workbench_experiment_package_store_select(store, next, store.baseline_slot, store.compare_slot) { return false }
        viz_workbench_experiment_package_store_mark(scene, ids, store)
        return true
    }
    if tag == VIZ_WORKBENCH_TAG_EXPERIMENT_STORE_BASELINE {
        if store.package_count <= 0 { return false }
        if !viz_workbench_experiment_package_store_select(store, store.active_slot, store.active_slot, store.compare_slot) { return false }
        viz_workbench_experiment_package_store_mark(scene, ids, store)
        return true
    }
    if tag == VIZ_WORKBENCH_TAG_EXPERIMENT_STORE_COMPARE {
        if store.package_count <= 0 { return false }
        if !viz_workbench_experiment_package_store_select(store, store.active_slot, store.baseline_slot, store.active_slot) { return false }
        viz_workbench_experiment_package_store_mark(scene, ids, store)
        return true
    }
    if tag == VIZ_WORKBENCH_TAG_EXPERIMENT_STORE_RESTORE {
        let restore = viz_workbench_experiment_package_store_restore_active(app, scene, ids, store, c, mode)
        if !restore.valid { return false }
        viz_workbench_experiment_package_store_mark(scene, ids, store)
        return true
    }
    false
}

pub fn viz_workbench_experiment_timeline_cockpit_hash(cockpit: &VizWorkbenchExperimentTimelineCockpit) -> i64 with Mut {
    var h: i64 = 751
    h = h * 131 + cockpit.notebook_hash
    h = h * 131 + cockpit.store_hash
    h = h * 131 + cockpit.mode_hash
    h = h * 131 + cockpit.active_slot
    h = h * 131 + cockpit.baseline_slot
    h = h * 131 + cockpit.compare_slot
    h = h * 131 + cockpit.active_package_hash
    h = h * 131 + cockpit.baseline_package_hash
    h = h * 131 + cockpit.compare_package_hash
    h = h * 131 + cockpit.selected_archive_hash
    h = h * 131 + cockpit.baseline_archive_hash
    h = h * 131 + cockpit.compare_archive_hash
    h = h * 131 + cockpit.selected_frame
    h = h * 131 + cockpit.baseline_frame
    h = h * 131 + cockpit.compare_frame
    h = h * 131 + cockpit.frame_count
    h = h * 131 + cockpit.selected_time_ms
    h = h * 131 + cockpit.frame_delta
    h = h * 131 + cockpit.package_hash_delta
    h = h * 131 + cockpit.rendered_frame_hash_delta
    h = h * 131 + cockpit.scene_audit_hash_delta
    h = h * 131 + cockpit.active_timeline_hash
    h = h * 131 + cockpit.baseline_timeline_hash
    h = h * 131 + cockpit.compare_timeline_hash
    h = h * 131 + cockpit.active_frame_hash
    h = h * 131 + cockpit.baseline_frame_hash
    h = h * 131 + cockpit.compare_frame_hash
    h = h * 131 + cockpit.active_audit_hash
    h = h * 131 + cockpit.baseline_audit_hash
    h = h * 131 + cockpit.compare_audit_hash
    h
}

fn viz_workbench_notebook_find_archive(notebook: &VizWorkbenchNotebook, archive_hash: i64) -> i64 with Mut {
    var i: i64 = 0
    while i < notebook.archive_count {
        if notebook.archive_valid[i as usize] && notebook.archive_hashes[i as usize] == archive_hash {
            return i
        }
        i = i + 1
    }
    0 - 1
}

pub fn viz_workbench_experiment_timeline_cockpit_build(
    notebook: &VizWorkbenchNotebook,
    store: &VizWorkbenchExperimentPackageStore,
    mode: &VizWorkbenchExperimentCompareMode,
) -> VizWorkbenchExperimentTimelineCockpit with Mut {
    if !viz_workbench_notebook_verify(notebook) { return viz_workbench_experiment_timeline_cockpit_empty() }
    if !viz_workbench_experiment_package_store_verify(store) { return viz_workbench_experiment_timeline_cockpit_empty() }
    if store.active_slot < 0 || store.active_slot >= store.package_count { return viz_workbench_experiment_timeline_cockpit_empty() }
    if store.baseline_slot < 0 || store.baseline_slot >= store.package_count { return viz_workbench_experiment_timeline_cockpit_empty() }
    if store.compare_slot < 0 || store.compare_slot >= store.package_count { return viz_workbench_experiment_timeline_cockpit_empty() }
    let active_pkg = store.packages[store.active_slot as usize]
    let baseline_pkg = store.packages[store.baseline_slot as usize]
    let compare_pkg = store.packages[store.compare_slot as usize]
    if active_pkg.notebook_hash != notebook.notebook_hash { return viz_workbench_experiment_timeline_cockpit_empty() }
    if baseline_pkg.notebook_hash != notebook.notebook_hash { return viz_workbench_experiment_timeline_cockpit_empty() }
    if compare_pkg.notebook_hash != notebook.notebook_hash { return viz_workbench_experiment_timeline_cockpit_empty() }
    let active_archive = viz_workbench_notebook_find_archive(notebook, active_pkg.selected_archive_hash)
    let baseline_archive = viz_workbench_notebook_find_archive(notebook, baseline_pkg.baseline_archive_hash)
    let compare_archive = viz_workbench_notebook_find_archive(notebook, compare_pkg.compare_archive_hash)
    if active_archive < 0 || baseline_archive < 0 || compare_archive < 0 { return viz_workbench_experiment_timeline_cockpit_empty() }
    let active = notebook.archives[active_archive as usize]
    let baseline = notebook.archives[baseline_archive as usize]
    let compare = notebook.archives[compare_archive as usize]
    if !active.valid || !baseline.valid || !compare.valid { return viz_workbench_experiment_timeline_cockpit_empty() }
    var cockpit = VizWorkbenchExperimentTimelineCockpit {
        valid: true,
        notebook_hash: notebook.notebook_hash,
        store_hash: store.store_hash,
        mode_hash: mode.mode_hash,
        active_slot: store.active_slot,
        baseline_slot: store.baseline_slot,
        compare_slot: store.compare_slot,
        active_package_hash: active_pkg.package_hash,
        baseline_package_hash: baseline_pkg.package_hash,
        compare_package_hash: compare_pkg.package_hash,
        selected_archive_hash: active_pkg.selected_archive_hash,
        baseline_archive_hash: baseline_pkg.baseline_archive_hash,
        compare_archive_hash: compare_pkg.compare_archive_hash,
        selected_frame: active.selected_frame,
        baseline_frame: baseline.selected_frame,
        compare_frame: compare.selected_frame,
        frame_count: active.frame_count,
        selected_time_ms: active.selected_time_ms,
        frame_delta: compare.selected_frame - baseline.selected_frame,
        package_hash_delta: store.package_hash_delta,
        rendered_frame_hash_delta: store.rendered_frame_hash_delta,
        scene_audit_hash_delta: store.scene_audit_hash_delta,
        active_timeline_hash: active.timeline_hash,
        baseline_timeline_hash: baseline.timeline_hash,
        compare_timeline_hash: compare.timeline_hash,
        active_frame_hash: active.selected_frame_hash,
        baseline_frame_hash: baseline.selected_frame_hash,
        compare_frame_hash: compare.selected_frame_hash,
        active_audit_hash: active.selected_audit_hash,
        baseline_audit_hash: baseline.selected_audit_hash,
        compare_audit_hash: compare.selected_audit_hash,
        cockpit_hash: 0,
    }
    cockpit.cockpit_hash = viz_workbench_experiment_timeline_cockpit_hash(&cockpit)
    cockpit
}

pub fn viz_workbench_experiment_timeline_cockpit_verify(
    cockpit: &VizWorkbenchExperimentTimelineCockpit,
    notebook: &VizWorkbenchNotebook,
    store: &VizWorkbenchExperimentPackageStore,
    mode: &VizWorkbenchExperimentCompareMode,
) -> bool with Mut {
    if !cockpit.valid { return false }
    if cockpit.notebook_hash != notebook.notebook_hash { return false }
    if cockpit.store_hash != store.store_hash { return false }
    if cockpit.mode_hash != mode.mode_hash { return false }
    if cockpit.active_slot != store.active_slot { return false }
    if cockpit.baseline_slot != store.baseline_slot { return false }
    if cockpit.compare_slot != store.compare_slot { return false }
    if cockpit.active_package_hash != store.active_package_hash { return false }
    if cockpit.baseline_package_hash != store.baseline_package_hash { return false }
    if cockpit.compare_package_hash != store.compare_package_hash { return false }
    if cockpit.package_hash_delta != store.package_hash_delta { return false }
    if cockpit.rendered_frame_hash_delta != store.rendered_frame_hash_delta { return false }
    if cockpit.scene_audit_hash_delta != store.scene_audit_hash_delta { return false }
    let rebuilt = viz_workbench_experiment_timeline_cockpit_build(notebook, store, mode)
    if !rebuilt.valid { return false }
    if cockpit.cockpit_hash != rebuilt.cockpit_hash { return false }
    cockpit.cockpit_hash == viz_workbench_experiment_timeline_cockpit_hash(cockpit)
}

pub fn viz_workbench_experiment_timeline_cockpit_mark(
    scene: &!VizScene,
    ids: &VizWorkbenchIds,
    cockpit: &VizWorkbenchExperimentTimelineCockpit,
) with Mut, Div {
    if !cockpit.valid { return }
    if ids.studio_timeline >= 0 && ids.studio_timeline < scene.node_count {
        scene.nodes[ids.studio_timeline as usize].value = cockpit.selected_frame as f64
        scene.nodes[ids.studio_timeline as usize].min_value = 0.0
        scene.nodes[ids.studio_timeline as usize].max_value = cockpit.frame_count as f64
    }
    if ids.experiment_store_package_delta >= 0 && ids.experiment_store_package_delta < scene.node_count {
        scene.nodes[ids.experiment_store_package_delta as usize].value = viz_workbench_hash_marker(cockpit.package_hash_delta)
    }
    if ids.experiment_store_frame_delta >= 0 && ids.experiment_store_frame_delta < scene.node_count {
        scene.nodes[ids.experiment_store_frame_delta as usize].value = viz_workbench_hash_marker(cockpit.rendered_frame_hash_delta)
    }
    if ids.experiment_store_audit_delta >= 0 && ids.experiment_store_audit_delta < scene.node_count {
        scene.nodes[ids.experiment_store_audit_delta as usize].value = viz_workbench_hash_marker(cockpit.scene_audit_hash_delta)
    }
    if ids.workspace_dt >= 0 && ids.workspace_dt < scene.node_count {
        scene.nodes[ids.workspace_dt as usize].value = cockpit.selected_time_ms as f64
    }
    if ids.workspace_dnodes >= 0 && ids.workspace_dnodes < scene.node_count {
        scene.nodes[ids.workspace_dnodes as usize].value = cockpit.frame_delta as f64
    }
    viz_workbench_sync_molecule_mirrors(scene)
}

pub fn viz_workbench_experiment_cockpit_playback_hash(playback: &VizWorkbenchExperimentCockpitPlayback) -> i64 with Mut {
    var h: i64 = 881
    h = h * 131 + playback.cockpit_hash
    h = h * 131 + playback.action_count
    h = h * 131 + playback.last_action
    h = h * 131 + playback.active_frame
    h = h * 131 + playback.baseline_frame
    h = h * 131 + playback.compare_frame
    h = h * 131 + playback.active_frame_count
    h = h * 131 + playback.baseline_frame_count
    h = h * 131 + playback.compare_frame_count
    h = h * 131 + playback.active_time_ms
    h = h * 131 + playback.baseline_time_ms
    h = h * 131 + playback.compare_time_ms
    h = h * 131 + playback.time_delta_ms
    h = h * 131 + playback.frame_delta
    h = h * 131 + playback.active_timeline_hash
    h = h * 131 + playback.baseline_timeline_hash
    h = h * 131 + playback.compare_timeline_hash
    h = h * 131 + playback.active_frame_hash
    h = h * 131 + playback.baseline_frame_hash
    h = h * 131 + playback.compare_frame_hash
    h = h * 131 + playback.active_audit_hash
    h = h * 131 + playback.baseline_audit_hash
    h = h * 131 + playback.compare_audit_hash
    h = h * 131 + playback.package_hash_delta
    h = h * 131 + playback.rendered_frame_hash_delta
    h = h * 131 + playback.scene_audit_hash_delta
    h
}

pub fn viz_workbench_experiment_cockpit_playback_build(
    cockpit: &VizWorkbenchExperimentTimelineCockpit,
    active_session: &VizWorkbenchReplaySession,
    baseline_session: &VizWorkbenchReplaySession,
    compare_session: &VizWorkbenchReplaySession,
    active_frame: i64,
    baseline_frame: i64,
    compare_frame: i64,
) -> VizWorkbenchExperimentCockpitPlayback with Mut {
    if !cockpit.valid { return viz_workbench_experiment_cockpit_playback_empty() }
    let active_timeline = viz_workbench_session_timeline_from_session(active_session, active_frame)
    let baseline_timeline = viz_workbench_session_timeline_from_session(baseline_session, baseline_frame)
    let compare_timeline = viz_workbench_session_timeline_from_session(compare_session, compare_frame)
    if !active_timeline.valid || !baseline_timeline.valid || !compare_timeline.valid { return viz_workbench_experiment_cockpit_playback_empty() }
    var playback = VizWorkbenchExperimentCockpitPlayback {
        valid: true,
        cockpit_hash: cockpit.cockpit_hash,
        playback_hash: 0,
        action_count: 0,
        last_action: 0,
        active_frame: active_timeline.selected_frame,
        baseline_frame: baseline_timeline.selected_frame,
        compare_frame: compare_timeline.selected_frame,
        active_frame_count: active_timeline.frame_count,
        baseline_frame_count: baseline_timeline.frame_count,
        compare_frame_count: compare_timeline.frame_count,
        active_time_ms: active_timeline.selected_time_ms,
        baseline_time_ms: baseline_timeline.selected_time_ms,
        compare_time_ms: compare_timeline.selected_time_ms,
        time_delta_ms: compare_timeline.selected_time_ms - baseline_timeline.selected_time_ms,
        frame_delta: compare_timeline.selected_frame - baseline_timeline.selected_frame,
        active_timeline_hash: active_timeline.timeline_hash,
        baseline_timeline_hash: baseline_timeline.timeline_hash,
        compare_timeline_hash: compare_timeline.timeline_hash,
        active_frame_hash: active_timeline.selected_frame_hash,
        baseline_frame_hash: baseline_timeline.selected_frame_hash,
        compare_frame_hash: compare_timeline.selected_frame_hash,
        active_audit_hash: active_timeline.selected_audit_hash,
        baseline_audit_hash: baseline_timeline.selected_audit_hash,
        compare_audit_hash: compare_timeline.selected_audit_hash,
        package_hash_delta: cockpit.package_hash_delta,
        rendered_frame_hash_delta: cockpit.rendered_frame_hash_delta,
        scene_audit_hash_delta: cockpit.scene_audit_hash_delta,
    }
    playback.playback_hash = viz_workbench_experiment_cockpit_playback_hash(&playback)
    playback
}

pub fn viz_workbench_experiment_cockpit_playback_verify(
    playback: &VizWorkbenchExperimentCockpitPlayback,
    cockpit: &VizWorkbenchExperimentTimelineCockpit,
    active_session: &VizWorkbenchReplaySession,
    baseline_session: &VizWorkbenchReplaySession,
    compare_session: &VizWorkbenchReplaySession,
) -> bool with Mut {
    if !playback.valid { return false }
    if playback.cockpit_hash != cockpit.cockpit_hash { return false }
    if playback.package_hash_delta != cockpit.package_hash_delta { return false }
    if playback.rendered_frame_hash_delta != cockpit.rendered_frame_hash_delta { return false }
    if playback.scene_audit_hash_delta != cockpit.scene_audit_hash_delta { return false }
    let rebuilt = viz_workbench_experiment_cockpit_playback_build(cockpit, active_session, baseline_session, compare_session, playback.active_frame, playback.baseline_frame, playback.compare_frame)
    if !rebuilt.valid { return false }
    if playback.active_timeline_hash != rebuilt.active_timeline_hash { return false }
    if playback.baseline_timeline_hash != rebuilt.baseline_timeline_hash { return false }
    if playback.compare_timeline_hash != rebuilt.compare_timeline_hash { return false }
    if playback.active_frame_hash != rebuilt.active_frame_hash { return false }
    if playback.baseline_frame_hash != rebuilt.baseline_frame_hash { return false }
    if playback.compare_frame_hash != rebuilt.compare_frame_hash { return false }
    playback.playback_hash == viz_workbench_experiment_cockpit_playback_hash(playback)
}

pub fn viz_workbench_experiment_cockpit_playback_mark(
    scene: &!VizScene,
    ids: &VizWorkbenchIds,
    playback: &VizWorkbenchExperimentCockpitPlayback,
) with Mut, Div {
    if !playback.valid { return }
    if ids.studio_timeline >= 0 && ids.studio_timeline < scene.node_count {
        scene.nodes[ids.studio_timeline as usize].value = playback.active_frame as f64
        scene.nodes[ids.studio_timeline as usize].min_value = 0.0
        scene.nodes[ids.studio_timeline as usize].max_value = playback.active_frame_count as f64
    }
    if ids.workspace_dt >= 0 && ids.workspace_dt < scene.node_count {
        scene.nodes[ids.workspace_dt as usize].value = playback.time_delta_ms as f64
    }
    if ids.workspace_dnodes >= 0 && ids.workspace_dnodes < scene.node_count {
        scene.nodes[ids.workspace_dnodes as usize].value = playback.frame_delta as f64
    }
    if ids.workspace_dframe >= 0 && ids.workspace_dframe < scene.node_count {
        scene.nodes[ids.workspace_dframe as usize].value = viz_workbench_hash_marker(playback.compare_frame_hash - playback.baseline_frame_hash)
    }
    if ids.workspace_daudit >= 0 && ids.workspace_daudit < scene.node_count {
        scene.nodes[ids.workspace_daudit as usize].value = viz_workbench_hash_marker(playback.compare_audit_hash - playback.baseline_audit_hash)
    }
    viz_workbench_sync_molecule_mirrors(scene)
}

fn viz_workbench_experiment_cockpit_playback_copy(
    dst: &!VizWorkbenchExperimentCockpitPlayback,
    src: &VizWorkbenchExperimentCockpitPlayback,
) with Mut {
    dst.valid = src.valid
    dst.cockpit_hash = src.cockpit_hash
    dst.playback_hash = src.playback_hash
    dst.action_count = src.action_count
    dst.last_action = src.last_action
    dst.active_frame = src.active_frame
    dst.baseline_frame = src.baseline_frame
    dst.compare_frame = src.compare_frame
    dst.active_frame_count = src.active_frame_count
    dst.baseline_frame_count = src.baseline_frame_count
    dst.compare_frame_count = src.compare_frame_count
    dst.active_time_ms = src.active_time_ms
    dst.baseline_time_ms = src.baseline_time_ms
    dst.compare_time_ms = src.compare_time_ms
    dst.time_delta_ms = src.time_delta_ms
    dst.frame_delta = src.frame_delta
    dst.active_timeline_hash = src.active_timeline_hash
    dst.baseline_timeline_hash = src.baseline_timeline_hash
    dst.compare_timeline_hash = src.compare_timeline_hash
    dst.active_frame_hash = src.active_frame_hash
    dst.baseline_frame_hash = src.baseline_frame_hash
    dst.compare_frame_hash = src.compare_frame_hash
    dst.active_audit_hash = src.active_audit_hash
    dst.baseline_audit_hash = src.baseline_audit_hash
    dst.compare_audit_hash = src.compare_audit_hash
    dst.package_hash_delta = src.package_hash_delta
    dst.rendered_frame_hash_delta = src.rendered_frame_hash_delta
    dst.scene_audit_hash_delta = src.scene_audit_hash_delta
}

pub fn viz_workbench_handle_experiment_cockpit_playback_event(
    scene: &!VizScene,
    ids: &VizWorkbenchIds,
    cockpit: &VizWorkbenchExperimentTimelineCockpit,
    playback: &!VizWorkbenchExperimentCockpitPlayback,
    active_session: &VizWorkbenchReplaySession,
    baseline_session: &VizWorkbenchReplaySession,
    compare_session: &VizWorkbenchReplaySession,
    ev: Event,
) -> bool with Mut, Div {
    if ev.kind != EV_MOUSE_PRESS || ev.key != MOUSE_LEFT { return false }
    let idx = viz_scene_hit_test(scene, ev.x, ev.y)
    if idx < 0 || idx >= scene.node_count { return false }
    let tag = scene.nodes[idx as usize].tag
    var action: i64 = 0
    var da: i64 = 0
    if tag == VIZ_WORKBENCH_TAG_TIME_BACK {
        action = 1
        da = 0 - 1
    }
    if tag == VIZ_WORKBENCH_TAG_TIME_FORWARD {
        action = 2
        da = 1
    }
    if action == 0 { return false }
    let previous_actions = playback.action_count
    let next = viz_workbench_experiment_cockpit_playback_build(
        cockpit,
        active_session,
        baseline_session,
        compare_session,
        playback.active_frame + da,
        playback.baseline_frame + da,
        playback.compare_frame + da,
    )
    if !next.valid { return false }
    viz_workbench_experiment_cockpit_playback_copy(playback, &next)
    playback.action_count = previous_actions + 1
    playback.last_action = action
    playback.playback_hash = viz_workbench_experiment_cockpit_playback_hash(playback)
    viz_workbench_experiment_cockpit_playback_mark(scene, ids, playback)
    true
}

fn viz_workbench_experiment_export_packet_molecule_snapshot_hash(packet: &VizWorkbenchExperimentExportPacket, seed: i64) -> i64 with Mut {
    var h: i64 = seed
    h = h * 131 + packet.stamped_molecule_count
    var mi: i64 = 0
    while mi < packet.stamped_molecule_count && mi < 4 {
        h = h * 131 + packet.molecule_atom_counts[mi as usize]
        h = h * 131 + packet.molecule_bond_counts[mi as usize]
        h = h * 131 + packet.molecule_snapshot_hashes[mi as usize]
        mi = mi + 1
    }
    h
}

pub fn viz_workbench_experiment_export_packet_hash(packet: &VizWorkbenchExperimentExportPacket) -> i64 with Mut {
    var h: i64 = 991
    h = h * 131 + packet.package_hash
    h = h * 131 + packet.restore_hash
    h = h * 131 + packet.store_hash
    h = h * 131 + packet.cockpit_hash
    h = h * 131 + packet.playback_hash
    h = h * 131 + packet.export_frame_hash
    h = h * 131 + packet.export_scene_audit_hash
    h = h * 131 + packet.notebook_hash
    h = h * 131 + packet.mode_hash
    h = h * 131 + packet.active_slot
    h = h * 131 + packet.baseline_slot
    h = h * 131 + packet.compare_slot
    h = h * 131 + packet.active_frame
    h = h * 131 + packet.baseline_frame
    h = h * 131 + packet.compare_frame
    h = h * 131 + packet.action_count
    h = h * 131 + packet.last_action
    h = h * 131 + packet.package_count
    h = h * 131 + packet.package_hash_delta
    h = h * 131 + packet.rendered_frame_hash_delta
    h = h * 131 + packet.scene_audit_hash_delta
    h = h * 131 + packet.selected_node
    h = h * 131 + packet.hovered_node
    h = h * 131 + packet.focused_node
    h = h * 131 + packet.active_tab
    h = h * 131 + packet.scene_time_ms
    h = h * 131 + packet.selected_atom_node
    h = h * 131 + packet.selected_atom_index
    h = h * 131 + packet.molecule_studio_node
    h = h * 131 + packet.molecule_tool
    h = h * 131 + packet.molecule_unit
    h = h * 131 + packet.molecule_pending_atom
    h = h * 131 + packet.molecule_last_reason
    h = h * 131 + packet.molecule_last_action
    h = h * 131 + packet.molecule_accept_count
    h = h * 131 + packet.molecule_reject_count
    h = h * 131 + packet.molecule_timeline_count
    h = h * 131 + packet.scene_stamp_hash
    h = h * 131 + packet.node_stamp_hash
    h = h * 131 + packet.chart_stamp_hash
    h = h * 131 + packet.field_stamp_hash
    h = h * 131 + packet.molecule_stamp_hash
    h = h * 131 + packet.mesh_stamp_hash
    h = h * 131 + packet.payload_stamp_hash
    var i: i64 = 0
    while i < 64 {
        h = h * 131 + packet.node_value_millis[i as usize]
        let selected_i = if packet.node_selected_flags[i as usize] { 1 } else { 0 }
        h = h * 131 + selected_i
        h = h * 131 + packet.node_style_r[i as usize]
        h = h * 131 + packet.node_style_g[i as usize]
        h = h * 131 + packet.node_style_b[i as usize]
        h = h * 131 + packet.node_style_alpha[i as usize]
        h = h * 131 + packet.node_style_stroke_width[i as usize]
        let fill_i = if packet.node_style_fill_flags[i as usize] { 1 } else { 0 }
        h = h * 131 + fill_i
        h = h * 131 + packet.node_style_palette[i as usize]
        h = h * 131 + packet.node_style_font_scale[i as usize]
        i = i + 1
    }
    viz_workbench_experiment_export_packet_molecule_snapshot_hash(packet, h)
}

pub fn viz_workbench_experiment_import_replay_report_hash(report: &VizWorkbenchExperimentImportReplayReport) -> i64 with Mut {
    var h: i64 = 997
    h = h * 131 + report.packet_hash
    h = h * 131 + report.package_hash
    h = h * 131 + report.restore_hash
    h = h * 131 + report.store_hash
    h = h * 131 + report.cockpit_hash
    h = h * 131 + report.playback_hash
    h = h * 131 + report.replay_frame_hash
    h = h * 131 + report.replay_scene_audit_hash
    h = h * 131 + report.expected_frame_hash
    h = h * 131 + report.expected_scene_audit_hash
    h = h * 131 + report.active_slot
    h = h * 131 + report.baseline_slot
    h = h * 131 + report.compare_slot
    h = h * 131 + report.active_frame
    h = h * 131 + report.baseline_frame
    h = h * 131 + report.compare_frame
    h = h * 131 + report.action_count
    h = h * 131 + report.last_action
    h = h * 131 + report.frame_hash_delta
    h = h * 131 + report.scene_audit_hash_delta
    h = h * 131 + report.selected_node
    h = h * 131 + report.hovered_node
    h = h * 131 + report.focused_node
    h = h * 131 + report.active_tab
    h = h * 131 + report.scene_time_ms
    h = h * 131 + report.selected_atom_node
    h = h * 131 + report.selected_atom_index
    h = h * 131 + report.molecule_studio_node
    h = h * 131 + report.molecule_tool
    h = h * 131 + report.molecule_unit
    h = h * 131 + report.molecule_pending_atom
    h = h * 131 + report.molecule_last_reason
    h = h * 131 + report.molecule_last_action
    h = h * 131 + report.molecule_accept_count
    h = h * 131 + report.molecule_reject_count
    h = h * 131 + report.molecule_timeline_count
    h = h * 131 + report.scene_stamp_hash
    h
}

pub fn viz_workbench_experiment_packet_ledger_hash(ledger: &VizWorkbenchExperimentPacketLedger) -> i64 with Mut {
    var h: i64 = 1013
    let valid_i = if ledger.valid { 1 } else { 0 }
    h = h * 131 + valid_i
    h = h * 131 + ledger.packet_count
    h = h * 131 + ledger.last_packet_hash
    h = h * 131 + ledger.last_payload_stamp_hash
    h = h * 131 + ledger.last_frame_hash
    h = h * 131 + ledger.last_audit_hash
    var i: i64 = 0
    while i < 4 {
        h = h * 131 + ledger.packet_hashes[i as usize]
        h = h * 131 + ledger.payload_stamp_hashes[i as usize]
        h = h * 131 + ledger.scene_stamp_hashes[i as usize]
        h = h * 131 + ledger.frame_hashes[i as usize]
        h = h * 131 + ledger.audit_hashes[i as usize]
        h = h * 131 + ledger.packet_hash_deltas[i as usize]
        h = h * 131 + ledger.payload_stamp_deltas[i as usize]
        h = h * 131 + ledger.frame_hash_deltas[i as usize]
        h = h * 131 + ledger.audit_hash_deltas[i as usize]
        i = i + 1
    }
    h
}

pub fn viz_workbench_experiment_packet_ledger_add(
    ledger: &!VizWorkbenchExperimentPacketLedger,
    packet: &VizWorkbenchExperimentExportPacket,
) -> bool with Mut {
    if !packet.valid { return false }
    if packet.packet_hash != viz_workbench_experiment_export_packet_hash(packet) { return false }
    if packet.payload_stamp_hash == 0 { return false }
    if packet.scene_stamp_hash == 0 { return false }
    if packet.export_frame_hash == 0 { return false }
    let idx = ledger.packet_count
    if idx < 0 || idx >= 4 { return false }
    ledger.packet_hashes[idx as usize] = packet.packet_hash
    ledger.payload_stamp_hashes[idx as usize] = packet.payload_stamp_hash
    ledger.scene_stamp_hashes[idx as usize] = packet.scene_stamp_hash
    ledger.frame_hashes[idx as usize] = packet.export_frame_hash
    ledger.audit_hashes[idx as usize] = packet.export_scene_audit_hash
    if idx == 0 {
        ledger.packet_hash_deltas[idx as usize] = 0
        ledger.payload_stamp_deltas[idx as usize] = 0
        ledger.frame_hash_deltas[idx as usize] = 0
        ledger.audit_hash_deltas[idx as usize] = 0
    } else {
        let prev = idx - 1
        ledger.packet_hash_deltas[idx as usize] = packet.packet_hash - ledger.packet_hashes[prev as usize]
        ledger.payload_stamp_deltas[idx as usize] = packet.payload_stamp_hash - ledger.payload_stamp_hashes[prev as usize]
        ledger.frame_hash_deltas[idx as usize] = packet.export_frame_hash - ledger.frame_hashes[prev as usize]
        ledger.audit_hash_deltas[idx as usize] = packet.export_scene_audit_hash - ledger.audit_hashes[prev as usize]
    }
    ledger.packet_count = idx + 1
    ledger.last_packet_hash = packet.packet_hash
    ledger.last_payload_stamp_hash = packet.payload_stamp_hash
    ledger.last_frame_hash = packet.export_frame_hash
    ledger.last_audit_hash = packet.export_scene_audit_hash
    ledger.valid = true
    ledger.ledger_hash = viz_workbench_experiment_packet_ledger_hash(ledger)
    true
}

pub fn viz_workbench_experiment_packet_ledger_verify(ledger: &VizWorkbenchExperimentPacketLedger) -> bool with Mut {
    if !ledger.valid { return false }
    if ledger.packet_count <= 0 { return false }
    if ledger.packet_count > 4 { return false }
    var i: i64 = 0
    while i < ledger.packet_count {
        if ledger.packet_hashes[i as usize] == 0 { return false }
        if ledger.payload_stamp_hashes[i as usize] == 0 { return false }
        if ledger.scene_stamp_hashes[i as usize] == 0 { return false }
        if ledger.frame_hashes[i as usize] == 0 { return false }
        if i == 0 {
            if ledger.packet_hash_deltas[i as usize] != 0 { return false }
            if ledger.payload_stamp_deltas[i as usize] != 0 { return false }
            if ledger.frame_hash_deltas[i as usize] != 0 { return false }
            if ledger.audit_hash_deltas[i as usize] != 0 { return false }
        } else {
            let prev = i - 1
            if ledger.packet_hash_deltas[i as usize] != ledger.packet_hashes[i as usize] - ledger.packet_hashes[prev as usize] { return false }
            if ledger.payload_stamp_deltas[i as usize] != ledger.payload_stamp_hashes[i as usize] - ledger.payload_stamp_hashes[prev as usize] { return false }
            if ledger.frame_hash_deltas[i as usize] != ledger.frame_hashes[i as usize] - ledger.frame_hashes[prev as usize] { return false }
            if ledger.audit_hash_deltas[i as usize] != ledger.audit_hashes[i as usize] - ledger.audit_hashes[prev as usize] { return false }
        }
        i = i + 1
    }
    let last = ledger.packet_count - 1
    if ledger.last_packet_hash != ledger.packet_hashes[last as usize] { return false }
    if ledger.last_payload_stamp_hash != ledger.payload_stamp_hashes[last as usize] { return false }
    if ledger.last_frame_hash != ledger.frame_hashes[last as usize] { return false }
    if ledger.last_audit_hash != ledger.audit_hashes[last as usize] { return false }
    ledger.ledger_hash == viz_workbench_experiment_packet_ledger_hash(ledger)
}

pub fn viz_workbench_experiment_packet_ledger_replay_report_hash(report: &VizWorkbenchExperimentPacketLedgerReplayReport) -> i64 with Mut {
    var h: i64 = 1019
    let valid_i = if report.valid { 1 } else { 0 }
    h = h * 131 + valid_i
    h = h * 131 + report.ledger_hash
    h = h * 131 + report.packet_count
    h = h * 131 + report.verified_packet_count
    h = h * 131 + report.imported_packet_count
    h = h * 131 + report.first_packet_hash
    h = h * 131 + report.last_packet_hash
    h = h * 131 + report.last_import_hash
    h = h * 131 + report.first_payload_stamp_hash
    h = h * 131 + report.last_payload_stamp_hash
    h = h * 131 + report.first_frame_hash
    h = h * 131 + report.last_frame_hash
    h = h * 131 + report.first_audit_hash
    h = h * 131 + report.last_audit_hash
    h = h * 131 + report.total_packet_hash_delta
    h = h * 131 + report.total_payload_stamp_delta
    h = h * 131 + report.total_frame_hash_delta
    h = h * 131 + report.total_audit_hash_delta
    h = h * 131 + report.final_frame_hash_delta
    h = h * 131 + report.final_audit_hash_delta
    h
}

pub fn viz_workbench_experiment_packet_ledger_replay_report_build_pair(
    ledger: &VizWorkbenchExperimentPacketLedger,
    first_packet: &VizWorkbenchExperimentExportPacket,
    last_packet: &VizWorkbenchExperimentExportPacket,
    last_import: &VizWorkbenchExperimentImportReplayReport,
) -> VizWorkbenchExperimentPacketLedgerReplayReport with Mut {
    if !viz_workbench_experiment_packet_ledger_verify(ledger) { return viz_workbench_experiment_packet_ledger_replay_report_empty() }
    if ledger.packet_count != 2 { return viz_workbench_experiment_packet_ledger_replay_report_empty() }
    if !first_packet.valid { return viz_workbench_experiment_packet_ledger_replay_report_empty() }
    if !last_packet.valid { return viz_workbench_experiment_packet_ledger_replay_report_empty() }
    if !last_import.valid { return viz_workbench_experiment_packet_ledger_replay_report_empty() }
    if first_packet.packet_hash != viz_workbench_experiment_export_packet_hash(first_packet) { return viz_workbench_experiment_packet_ledger_replay_report_empty() }
    if last_packet.packet_hash != viz_workbench_experiment_export_packet_hash(last_packet) { return viz_workbench_experiment_packet_ledger_replay_report_empty() }
    if ledger.packet_hashes[0] != first_packet.packet_hash { return viz_workbench_experiment_packet_ledger_replay_report_empty() }
    if ledger.packet_hashes[1] != last_packet.packet_hash { return viz_workbench_experiment_packet_ledger_replay_report_empty() }
    if ledger.payload_stamp_hashes[0] != first_packet.payload_stamp_hash { return viz_workbench_experiment_packet_ledger_replay_report_empty() }
    if ledger.payload_stamp_hashes[1] != last_packet.payload_stamp_hash { return viz_workbench_experiment_packet_ledger_replay_report_empty() }
    if ledger.frame_hashes[0] != first_packet.export_frame_hash { return viz_workbench_experiment_packet_ledger_replay_report_empty() }
    if ledger.frame_hashes[1] != last_packet.export_frame_hash { return viz_workbench_experiment_packet_ledger_replay_report_empty() }
    if ledger.audit_hashes[0] != first_packet.export_scene_audit_hash { return viz_workbench_experiment_packet_ledger_replay_report_empty() }
    if ledger.audit_hashes[1] != last_packet.export_scene_audit_hash { return viz_workbench_experiment_packet_ledger_replay_report_empty() }
    if last_import.packet_hash != last_packet.packet_hash { return viz_workbench_experiment_packet_ledger_replay_report_empty() }
    if last_import.expected_frame_hash != last_packet.export_frame_hash { return viz_workbench_experiment_packet_ledger_replay_report_empty() }
    if last_import.expected_scene_audit_hash != last_packet.export_scene_audit_hash { return viz_workbench_experiment_packet_ledger_replay_report_empty() }
    if last_import.frame_hash_delta != 0 { return viz_workbench_experiment_packet_ledger_replay_report_empty() }
    if last_import.scene_audit_hash_delta != 0 { return viz_workbench_experiment_packet_ledger_replay_report_empty() }
    var report = VizWorkbenchExperimentPacketLedgerReplayReport {
        valid: true,
        replay_hash: 0,
        ledger_hash: ledger.ledger_hash,
        packet_count: ledger.packet_count,
        verified_packet_count: 2,
        imported_packet_count: 1,
        first_packet_hash: first_packet.packet_hash,
        last_packet_hash: last_packet.packet_hash,
        last_import_hash: last_import.import_hash,
        first_payload_stamp_hash: first_packet.payload_stamp_hash,
        last_payload_stamp_hash: last_packet.payload_stamp_hash,
        first_frame_hash: first_packet.export_frame_hash,
        last_frame_hash: last_packet.export_frame_hash,
        first_audit_hash: first_packet.export_scene_audit_hash,
        last_audit_hash: last_packet.export_scene_audit_hash,
        total_packet_hash_delta: last_packet.packet_hash - first_packet.packet_hash,
        total_payload_stamp_delta: last_packet.payload_stamp_hash - first_packet.payload_stamp_hash,
        total_frame_hash_delta: last_packet.export_frame_hash - first_packet.export_frame_hash,
        total_audit_hash_delta: last_packet.export_scene_audit_hash - first_packet.export_scene_audit_hash,
        final_frame_hash_delta: last_import.frame_hash_delta,
        final_audit_hash_delta: last_import.scene_audit_hash_delta,
    }
    report.replay_hash = viz_workbench_experiment_packet_ledger_replay_report_hash(&report)
    report
}

pub fn viz_workbench_experiment_packet_ledger_replay_report_verify(
    report: &VizWorkbenchExperimentPacketLedgerReplayReport,
    ledger: &VizWorkbenchExperimentPacketLedger,
    last_import: &VizWorkbenchExperimentImportReplayReport,
) -> bool with Mut {
    if !report.valid { return false }
    if !viz_workbench_experiment_packet_ledger_verify(ledger) { return false }
    if !last_import.valid { return false }
    if report.ledger_hash != ledger.ledger_hash { return false }
    if report.packet_count != ledger.packet_count { return false }
    if report.verified_packet_count != ledger.packet_count { return false }
    if report.imported_packet_count != 1 { return false }
    if report.first_packet_hash != ledger.packet_hashes[0] { return false }
    let last = ledger.packet_count - 1
    if report.last_packet_hash != ledger.packet_hashes[last as usize] { return false }
    if report.last_import_hash != last_import.import_hash { return false }
    if report.first_payload_stamp_hash != ledger.payload_stamp_hashes[0] { return false }
    if report.last_payload_stamp_hash != ledger.payload_stamp_hashes[last as usize] { return false }
    if report.first_frame_hash != ledger.frame_hashes[0] { return false }
    if report.last_frame_hash != ledger.frame_hashes[last as usize] { return false }
    if report.first_audit_hash != ledger.audit_hashes[0] { return false }
    if report.last_audit_hash != ledger.audit_hashes[last as usize] { return false }
    if report.total_packet_hash_delta != report.last_packet_hash - report.first_packet_hash { return false }
    if report.total_payload_stamp_delta != report.last_payload_stamp_hash - report.first_payload_stamp_hash { return false }
    if report.total_frame_hash_delta != report.last_frame_hash - report.first_frame_hash { return false }
    if report.total_audit_hash_delta != report.last_audit_hash - report.first_audit_hash { return false }
    if report.final_frame_hash_delta != last_import.frame_hash_delta { return false }
    if report.final_audit_hash_delta != last_import.scene_audit_hash_delta { return false }
    if report.final_frame_hash_delta != 0 { return false }
    if report.final_audit_hash_delta != 0 { return false }
    report.replay_hash == viz_workbench_experiment_packet_ledger_replay_report_hash(report)
}

pub fn viz_workbench_experiment_packet_ledger_browser_hash(browser: &VizWorkbenchExperimentPacketLedgerBrowser) -> i64 with Mut {
    var h: i64 = 1021
    let valid_i = if browser.valid { 1 } else { 0 }
    h = h * 131 + valid_i
    h = h * 131 + browser.ledger_hash
    h = h * 131 + browser.replay_hash
    h = h * 131 + browser.selected_index
    h = h * 131 + browser.packet_count
    h = h * 131 + browser.selected_packet_hash
    h = h * 131 + browser.selected_payload_stamp_hash
    h = h * 131 + browser.selected_frame_hash
    h = h * 131 + browser.selected_audit_hash
    h = h * 131 + browser.packet_delta
    h = h * 131 + browser.payload_stamp_delta
    h = h * 131 + browser.frame_hash_delta
    h = h * 131 + browser.audit_hash_delta
    h = h * 131 + browser.selected_marker
    h = h * 131 + browser.packet_delta_marker
    h = h * 131 + browser.payload_delta_marker
    h = h * 131 + browser.frame_delta_marker
    h = h * 131 + browser.audit_delta_marker
    h = h * 131 + browser.selected_node
    h = h * 131 + browser.packet_delta_node
    h = h * 131 + browser.payload_delta_node
    h = h * 131 + browser.frame_delta_node
    h = h * 131 + browser.audit_delta_node
    h = h * 131 + browser.tooltip_node
    h
}

fn viz_workbench_experiment_packet_ledger_browser_label(scene: &!VizScene, node_idx: i64) with Mut {
    if node_idx < 0 || node_idx >= scene.node_count { return }
    var txt: [i8; 64] = [0; 64]
    txt[0] = 112
    txt[1] = 97
    txt[2] = 99
    txt[3] = 107
    txt[4] = 101
    txt[5] = 116
    txt[6] = 32
    txt[7] = 108
    txt[8] = 101
    txt[9] = 100
    txt[10] = 103
    txt[11] = 101
    txt[12] = 114
    viz_node_set_label(scene, node_idx, &txt, 13)
}

pub fn viz_workbench_experiment_packet_ledger_browser_apply(
    ledger: &VizWorkbenchExperimentPacketLedger,
    replay: &VizWorkbenchExperimentPacketLedgerReplayReport,
    scene: &!VizScene,
    ids: &VizWorkbenchIds,
    selected_index: i64,
) -> VizWorkbenchExperimentPacketLedgerBrowser with Mut, Div {
    if !viz_workbench_experiment_packet_ledger_verify(ledger) { return viz_workbench_experiment_packet_ledger_browser_empty() }
    if !replay.valid { return viz_workbench_experiment_packet_ledger_browser_empty() }
    if replay.ledger_hash != ledger.ledger_hash { return viz_workbench_experiment_packet_ledger_browser_empty() }
    if replay.packet_count != ledger.packet_count { return viz_workbench_experiment_packet_ledger_browser_empty() }
    if replay.final_frame_hash_delta != 0 { return viz_workbench_experiment_packet_ledger_browser_empty() }
    if replay.final_audit_hash_delta != 0 { return viz_workbench_experiment_packet_ledger_browser_empty() }
    if ids.workspace_diff < 0 || ids.workspace_diff >= scene.node_count { return viz_workbench_experiment_packet_ledger_browser_empty() }
    if ids.workspace_dt < 0 || ids.workspace_dt >= scene.node_count { return viz_workbench_experiment_packet_ledger_browser_empty() }
    if ids.workspace_daudit < 0 || ids.workspace_daudit >= scene.node_count { return viz_workbench_experiment_packet_ledger_browser_empty() }
    if ids.workspace_dframe < 0 || ids.workspace_dframe >= scene.node_count { return viz_workbench_experiment_packet_ledger_browser_empty() }
    var idx = selected_index
    if idx < 0 { idx = 0 }
    if idx >= ledger.packet_count { idx = ledger.packet_count - 1 }
    let selected_packet_hash = ledger.packet_hashes[idx as usize]
    let selected_payload_stamp_hash = ledger.payload_stamp_hashes[idx as usize]
    let selected_frame_hash = ledger.frame_hashes[idx as usize]
    let selected_audit_hash = ledger.audit_hashes[idx as usize]
    let packet_delta = ledger.packet_hash_deltas[idx as usize]
    let payload_delta = ledger.payload_stamp_deltas[idx as usize]
    let frame_delta = ledger.frame_hash_deltas[idx as usize]
    let audit_delta = ledger.audit_hash_deltas[idx as usize]
    let selected_marker = viz_workbench_hash_marker(selected_packet_hash)
    let packet_delta_marker = viz_workbench_hash_marker(packet_delta)
    let payload_delta_marker = viz_workbench_hash_marker(payload_delta)
    let frame_delta_marker = viz_workbench_hash_marker(frame_delta)
    let audit_delta_marker = viz_workbench_hash_marker(audit_delta)
    let selected_tint = 140 + ((selected_marker as i64) - ((selected_marker as i64) / 90) * 90)
    let packet_tint = 120 + ((packet_delta_marker as i64) - ((packet_delta_marker as i64) / 100) * 100)
    scene.nodes[ids.workspace_dt as usize].value = selected_marker
    scene.nodes[ids.workspace_dt as usize].min_value = 0.0
    scene.nodes[ids.workspace_dt as usize].max_value = 1000000.0
    scene.nodes[ids.workspace_dt as usize].style = viz_style_rgb(140, selected_tint, 255)
    scene.nodes[ids.workspace_diff as usize].value = packet_delta_marker
    scene.nodes[ids.workspace_diff as usize].min_value = 0.0
    scene.nodes[ids.workspace_diff as usize].max_value = 1000000.0
    scene.nodes[ids.workspace_diff as usize].style = viz_style_rgb(255, packet_tint, 120)
    scene.nodes[ids.workspace_dframe as usize].value = frame_delta_marker
    scene.nodes[ids.workspace_dframe as usize].min_value = 0.0
    scene.nodes[ids.workspace_dframe as usize].max_value = 1000000.0
    scene.nodes[ids.workspace_dframe as usize].style = viz_style_rgb(190, 220, 255)
    scene.nodes[ids.workspace_daudit as usize].value = audit_delta_marker
    scene.nodes[ids.workspace_daudit as usize].min_value = 0.0
    scene.nodes[ids.workspace_daudit as usize].max_value = 1000000.0
    scene.nodes[ids.workspace_daudit as usize].style = viz_style_rgb(245, 225, 140)
    if ids.workspace_dproject >= 0 && ids.workspace_dproject < scene.node_count {
        scene.nodes[ids.workspace_dproject as usize].value = payload_delta_marker
        scene.nodes[ids.workspace_dproject as usize].style = viz_style_rgb(140, 225, 185)
    }
    if ids.tooltip >= 0 && ids.tooltip < scene.node_count {
        viz_workbench_experiment_packet_ledger_browser_label(scene, ids.tooltip)
        scene.nodes[ids.tooltip as usize].value = replay.replay_hash as f64
        scene.nodes[ids.tooltip as usize].style = viz_style_rgb(170, 220, 255)
    }
    scene.selected_node = ids.workspace_dt
    scene.focused_node = ids.workspace_dt
    scene.hovered_node = ids.workspace_diff
    scene.nodes[ids.workspace_dt as usize].selected = true
    var browser = VizWorkbenchExperimentPacketLedgerBrowser {
        valid: true,
        ledger_hash: ledger.ledger_hash,
        replay_hash: replay.replay_hash,
        selected_index: idx,
        packet_count: ledger.packet_count,
        selected_packet_hash: selected_packet_hash,
        selected_payload_stamp_hash: selected_payload_stamp_hash,
        selected_frame_hash: selected_frame_hash,
        selected_audit_hash: selected_audit_hash,
        packet_delta: packet_delta,
        payload_stamp_delta: payload_delta,
        frame_hash_delta: frame_delta,
        audit_hash_delta: audit_delta,
        selected_marker: selected_marker as i64,
        packet_delta_marker: packet_delta_marker as i64,
        payload_delta_marker: payload_delta_marker as i64,
        frame_delta_marker: frame_delta_marker as i64,
        audit_delta_marker: audit_delta_marker as i64,
        selected_node: ids.workspace_dt,
        packet_delta_node: ids.workspace_diff,
        payload_delta_node: ids.workspace_dproject,
        frame_delta_node: ids.workspace_dframe,
        audit_delta_node: ids.workspace_daudit,
        tooltip_node: ids.tooltip,
        browser_hash: 0,
    }
    browser.browser_hash = viz_workbench_experiment_packet_ledger_browser_hash(&browser)
    browser
}

pub fn viz_workbench_experiment_packet_ledger_browser_verify(
    browser: &VizWorkbenchExperimentPacketLedgerBrowser,
    ledger: &VizWorkbenchExperimentPacketLedger,
    replay: &VizWorkbenchExperimentPacketLedgerReplayReport,
    scene: &VizScene,
) -> bool with Mut {
    if !browser.valid { return false }
    if !viz_workbench_experiment_packet_ledger_verify(ledger) { return false }
    if !replay.valid { return false }
    if browser.ledger_hash != ledger.ledger_hash { return false }
    if browser.replay_hash != replay.replay_hash { return false }
    if browser.packet_count != ledger.packet_count { return false }
    if browser.selected_index < 0 || browser.selected_index >= ledger.packet_count { return false }
    let idx = browser.selected_index
    if browser.selected_packet_hash != ledger.packet_hashes[idx as usize] { return false }
    if browser.selected_payload_stamp_hash != ledger.payload_stamp_hashes[idx as usize] { return false }
    if browser.selected_frame_hash != ledger.frame_hashes[idx as usize] { return false }
    if browser.selected_audit_hash != ledger.audit_hashes[idx as usize] { return false }
    if browser.packet_delta != ledger.packet_hash_deltas[idx as usize] { return false }
    if browser.payload_stamp_delta != ledger.payload_stamp_deltas[idx as usize] { return false }
    if browser.frame_hash_delta != ledger.frame_hash_deltas[idx as usize] { return false }
    if browser.audit_hash_delta != ledger.audit_hash_deltas[idx as usize] { return false }
    if browser.selected_node < 0 || browser.selected_node >= scene.node_count { return false }
    if scene.nodes[browser.selected_node as usize].value != browser.selected_marker as f64 { return false }
    if browser.packet_delta_node >= 0 && browser.packet_delta_node < scene.node_count {
        if scene.nodes[browser.packet_delta_node as usize].value != browser.packet_delta_marker as f64 { return false }
    }
    if browser.frame_delta_node >= 0 && browser.frame_delta_node < scene.node_count {
        if scene.nodes[browser.frame_delta_node as usize].value != browser.frame_delta_marker as f64 { return false }
    }
    if browser.audit_delta_node >= 0 && browser.audit_delta_node < scene.node_count {
        if scene.nodes[browser.audit_delta_node as usize].value != browser.audit_delta_marker as f64 { return false }
    }
    browser.browser_hash == viz_workbench_experiment_packet_ledger_browser_hash(browser)
}

fn viz_workbench_experiment_export_packet_stamp_hash(packet: &VizWorkbenchExperimentExportPacket) -> i64 with Mut {
    var h: i64 = 1009
    h = h * 131 + packet.node_stamp_hash
    h = h * 131 + packet.chart_stamp_hash
    h = h * 131 + packet.field_stamp_hash
    h = h * 131 + packet.molecule_stamp_hash
    h = h * 131 + packet.mesh_stamp_hash
    h = h * 131 + packet.payload_stamp_hash
    h = h * 131 + packet.selected_node
    h = h * 131 + packet.hovered_node
    h = h * 131 + packet.focused_node
    h = h * 131 + packet.active_tab
    h = h * 131 + packet.scene_time_ms
    h = h * 131 + packet.selected_atom_node
    h = h * 131 + packet.selected_atom_index
    h = h * 131 + packet.molecule_studio_node
    h = h * 131 + packet.molecule_tool
    h = h * 131 + packet.molecule_unit
    h = h * 131 + packet.molecule_pending_atom
    h = h * 131 + packet.molecule_last_reason
    h = h * 131 + packet.molecule_last_action
    h = h * 131 + packet.molecule_accept_count
    h = h * 131 + packet.molecule_reject_count
    h = h * 131 + packet.molecule_timeline_count
    var i: i64 = 0
    while i < 64 {
        h = h * 131 + packet.node_value_millis[i as usize]
        let selected_i = if packet.node_selected_flags[i as usize] { 1 } else { 0 }
        h = h * 131 + selected_i
        h = h * 131 + packet.node_style_r[i as usize]
        h = h * 131 + packet.node_style_g[i as usize]
        h = h * 131 + packet.node_style_b[i as usize]
        h = h * 131 + packet.node_style_alpha[i as usize]
        h = h * 131 + packet.node_style_stroke_width[i as usize]
        let fill_i = if packet.node_style_fill_flags[i as usize] { 1 } else { 0 }
        h = h * 131 + fill_i
        h = h * 131 + packet.node_style_palette[i as usize]
        h = h * 131 + packet.node_style_font_scale[i as usize]
        i = i + 1
    }
    viz_workbench_experiment_export_packet_molecule_snapshot_hash(packet, h)
}

fn viz_workbench_experiment_export_packet_capture_molecule_snapshot(
    packet: &!VizWorkbenchExperimentExportPacket,
    scene: &VizScene,
) with Mut {
    var i: i64 = 0
    while i < 4 {
        packet.molecule_atom_counts[i as usize] = 0
        packet.molecule_bond_counts[i as usize] = 0
        packet.molecule_snapshot_hashes[i as usize] = 0
        i = i + 1
    }
    var mi: i64 = 0
    while mi < scene.molecule_count && mi < 4 {
        var atom_count = scene.molecules[mi as usize].atom_count
        if atom_count < 0 { atom_count = 0 }
        if atom_count > 64 { atom_count = 64 }
        var bond_count = scene.molecules[mi as usize].bond_count
        if bond_count < 0 { bond_count = 0 }
        if bond_count > 96 { bond_count = 96 }
        packet.molecule_atom_counts[mi as usize] = atom_count
        packet.molecule_bond_counts[mi as usize] = bond_count
        var h: i64 = 3037 + mi
        h = h * 131 + atom_count
        h = h * 131 + bond_count
        var ai: i64 = 0
        while ai < atom_count {
            let a = scene.molecules[mi as usize].atoms[ai as usize]
            h = h * 131 + a.atomic_number
            h = h * 131 + (a.x * 1000.0) as i64
            h = h * 131 + (a.y * 1000.0) as i64
            h = h * 131 + (a.z * 1000.0) as i64
            h = h * 131 + (a.radius * 1000.0) as i64
            h = h * 131 + a.r
            h = h * 131 + a.g
            h = h * 131 + a.b
            ai = ai + 1
        }
        var bi: i64 = 0
        while bi < bond_count {
            let b = scene.molecules[mi as usize].bonds[bi as usize]
            h = h * 131 + b.atom_a
            h = h * 131 + b.atom_b
            h = h * 131 + b.order
            h = h * 131 + (b.length.value * 1000.0) as i64
            h = h * 131 + (b.length.uncertainty * 1000.0) as i64
            h = h * 131 + (b.variance * 1000.0) as i64
            bi = bi + 1
        }
        packet.molecule_snapshot_hashes[mi as usize] = h
        mi = mi + 1
    }
}

fn viz_workbench_experiment_export_packet_node_stamp_hash(packet: &VizWorkbenchExperimentExportPacket) -> i64 with Mut {
    var h: i64 = 1709
    h = h * 131 + packet.stamped_node_count
    h = h * 131 + packet.stamped_next_node_id
    var i: i64 = 0
    while i < packet.stamped_node_count && i < 64 {
        let n = packet.stamped_nodes[i as usize]
        h = h * 131 + n.id
        h = h * 131 + n.parent_id
        h = h * 131 + n.tag
        h = h * 131 + n.kind
        h = h * 131 + n.data_slot
        h = h * 131 + n.layout.x
        h = h * 131 + n.layout.y
        h = h * 131 + n.layout.w
        h = h * 131 + n.layout.h
        h = h * 131 + packet.node_value_millis[i as usize]
        let selected_i = if packet.node_selected_flags[i as usize] { 1 } else { 0 }
        h = h * 131 + selected_i
        h = h * 131 + packet.node_style_r[i as usize]
        h = h * 131 + packet.node_style_g[i as usize]
        h = h * 131 + packet.node_style_b[i as usize]
        h = h * 131 + packet.node_style_alpha[i as usize]
        i = i + 1
    }
    h
}

fn viz_workbench_experiment_export_packet_chart_stamp_hash(packet: &VizWorkbenchExperimentExportPacket) -> i64 with Mut {
    var h: i64 = 1721
    h = h * 131 + packet.stamped_series_count
    var i: i64 = 0
    while i < packet.stamped_series_count && i < 8 {
        let s = packet.stamped_series[i as usize]
        h = h * 131 + s.n
        h = h * 131 + (s.x_min * 1000.0) as i64
        h = h * 131 + (s.x_max * 1000.0) as i64
        h = h * 131 + (s.y_min * 1000.0) as i64
        h = h * 131 + (s.y_max * 1000.0) as i64
        if s.n > 0 {
            h = h * 131 + (s.xs[0] * 1000.0) as i64
            h = h * 131 + (s.ys[0] * 1000.0) as i64
            h = h * 131 + (s.vars[0] * 1000.0) as i64
        }
        i = i + 1
    }
    h = h * 131 + packet.stamped_heatmap_count
    i = 0
    while i < packet.stamped_heatmap_count && i < 4 {
        let hm = packet.stamped_heatmaps[i as usize]
        h = h * 131 + hm.rows
        h = h * 131 + hm.cols
        h = h * 131 + (hm.min_value * 1000.0) as i64
        h = h * 131 + (hm.max_value * 1000.0) as i64
        if hm.rows > 0 && hm.cols > 0 {
            h = h * 131 + (hm.values[0] * 1000.0) as i64
        }
        i = i + 1
    }
    h
}

fn viz_workbench_experiment_export_packet_field_stamp_hash(packet: &VizWorkbenchExperimentExportPacket) -> i64 with Mut {
    var h: i64 = 1733
    h = h * 131 + packet.stamped_vector_field_count
    var i: i64 = 0
    while i < packet.stamped_vector_field_count && i < 4 {
        h = h * 131 + packet.stamped_vector_field_rows[i as usize]
        h = h * 131 + packet.stamped_vector_field_cols[i as usize]
        i = i + 1
    }
    h = h * 131 + packet.stamped_trajectory_count
    i = 0
    while i < packet.stamped_trajectory_count && i < 4 {
        h = h * 131 + packet.stamped_trajectory_data[i as usize].n
        i = i + 1
    }
    h = h * 131 + packet.stamped_spectrum_count
    i = 0
    while i < packet.stamped_spectrum_count && i < 4 {
        h = h * 131 + packet.stamped_spectrum_data[i as usize].n
        h = h * 131 + (packet.stamped_spectrum_data[i as usize].x_min * 1000.0) as i64
        h = h * 131 + (packet.stamped_spectrum_data[i as usize].x_max * 1000.0) as i64
        i = i + 1
    }
    h = h * 131 + packet.stamped_lattice_count
    i = 0
    while i < packet.stamped_lattice_count && i < 4 {
        h = h * 131 + packet.stamped_lattice_data[i as usize].rows
        h = h * 131 + packet.stamped_lattice_data[i as usize].cols
        i = i + 1
    }
    h = h * 131 + packet.stamped_particle_event_count
    i = 0
    while i < packet.stamped_particle_event_count && i < 4 {
        h = h * 131 + packet.stamped_particle_event_data[i as usize].n
        i = i + 1
    }
    h
}

fn viz_workbench_experiment_export_packet_mesh_stamp_hash(packet: &VizWorkbenchExperimentExportPacket) -> i64 with Mut {
    var h: i64 = 1741
    h = h * 131 + packet.stamped_mesh_count
    var i: i64 = 0
    while i < packet.stamped_mesh_count && i < 4 {
        h = h * 131 + packet.stamped_meshes[i as usize].n
        i = i + 1
    }
    h
}

fn viz_workbench_experiment_export_packet_capture_domain_stamps(packet: &!VizWorkbenchExperimentExportPacket) with Mut {
    packet.node_stamp_hash = viz_workbench_experiment_export_packet_node_stamp_hash(packet)
    packet.chart_stamp_hash = viz_workbench_experiment_export_packet_chart_stamp_hash(packet)
    packet.field_stamp_hash = viz_workbench_experiment_export_packet_field_stamp_hash(packet)
    packet.molecule_stamp_hash = viz_workbench_experiment_export_packet_molecule_snapshot_hash(packet, 1753)
    packet.mesh_stamp_hash = viz_workbench_experiment_export_packet_mesh_stamp_hash(packet)
    var h: i64 = 1763
    h = h * 131 + packet.node_stamp_hash
    h = h * 131 + packet.chart_stamp_hash
    h = h * 131 + packet.field_stamp_hash
    h = h * 131 + packet.molecule_stamp_hash
    h = h * 131 + packet.mesh_stamp_hash
    h = h * 131 + packet.export_frame_hash
    h = h * 131 + packet.export_scene_audit_hash
    packet.payload_stamp_hash = h
}

fn viz_workbench_experiment_export_packet_restore_molecule_counts(
    scene: &!VizScene,
    packet: &VizWorkbenchExperimentExportPacket,
) with Mut {
    var molecule_count = packet.stamped_molecule_count
    if molecule_count < 0 { molecule_count = 0 }
    if molecule_count > 4 { molecule_count = 4 }
    var mi: i64 = 0
    while mi < molecule_count {
        var mol = scene.molecules[mi as usize]
        var atom_count = packet.molecule_atom_counts[mi as usize]
        if atom_count < 0 { atom_count = 0 }
        if atom_count > 64 { atom_count = 64 }
        var bond_count = packet.molecule_bond_counts[mi as usize]
        if bond_count < 0 { bond_count = 0 }
        if bond_count > 96 { bond_count = 96 }
        mol.atom_count = atom_count
        mol.bond_count = bond_count
        scene.molecules[mi as usize] = mol
        viz_scene_sync_molecule_mirror(scene, mi)
        mi = mi + 1
    }
}

fn viz_workbench_experiment_export_packet_capture_scene_stamp(
    packet: &!VizWorkbenchExperimentExportPacket,
    scene: &VizScene,
) with Mut {
    packet.stamped_node_count = scene.node_count
    packet.stamped_series_count = scene.series_count
    packet.stamped_heatmap_count = scene.heatmap_count
    packet.stamped_molecule_count = scene.molecule_count
    packet.stamped_vector_field_count = scene.vector_field_count
    packet.stamped_trajectory_count = scene.trajectory_count
    packet.stamped_spectrum_count = scene.spectrum_count
    packet.stamped_lattice_count = scene.lattice_count
    packet.stamped_particle_event_count = scene.particle_event_count
    packet.stamped_mesh_count = scene.mesh_count
    packet.stamped_next_node_id = scene.next_node_id
    packet.selected_node = scene.selected_node
    packet.hovered_node = scene.hovered_node
    packet.focused_node = scene.focused_node
    packet.active_tab = scene.active_tab
    packet.scene_time_ms = (scene.time * 1000.0) as i64
    packet.selected_atom_node = scene.selected_atom_node
    packet.selected_atom_index = scene.selected_atom_index
    packet.molecule_studio_node = scene.molecule_studio_node
    packet.molecule_tool = scene.molecule_tool
    packet.molecule_unit = scene.molecule_unit
    packet.molecule_pending_atom = scene.molecule_pending_atom
    packet.molecule_last_reason = scene.molecule_last_reason
    packet.molecule_last_action = scene.molecule_last_action
    packet.molecule_accept_count = scene.molecule_accept_count
    packet.molecule_reject_count = scene.molecule_reject_count
    packet.molecule_timeline_count = scene.molecule_timeline_count
    var i: i64 = 0
    while i < 64 {
        packet.stamped_nodes[i as usize] = scene.nodes[i as usize]
        i = i + 1
    }
    i = 0
    while i < 8 {
        packet.stamped_series[i as usize] = scene.series[i as usize]
        i = i + 1
    }
    i = 0
    while i < 4 {
        packet.stamped_heatmaps[i as usize] = scene.heatmaps[i as usize]
        packet.stamped_molecules[i as usize] = scene.molecules[i as usize]
        packet.stamped_vector_data[i as usize] = scene.vector_data[i as usize]
        packet.stamped_vector_field_rows[i as usize] = scene.vector_field_rows[i as usize]
        packet.stamped_vector_field_cols[i as usize] = scene.vector_field_cols[i as usize]
        packet.stamped_trajectory_data[i as usize] = scene.trajectory_data[i as usize]
        packet.stamped_spectrum_data[i as usize] = scene.spectrum_data[i as usize]
        packet.stamped_lattice_data[i as usize] = scene.lattice_data[i as usize]
        packet.stamped_particle_event_data[i as usize] = scene.particle_event_data[i as usize]
        packet.stamped_meshes[i as usize] = scene.meshes[i as usize]
        i = i + 1
    }
    viz_workbench_experiment_export_packet_capture_molecule_snapshot(packet, scene)
    i = 0
    while i < 64 {
        if i < scene.node_count {
            let n = scene.nodes[i as usize]
            packet.node_value_millis[i as usize] = (n.value * 1000.0) as i64
            packet.node_selected_flags[i as usize] = n.selected
            packet.node_style_r[i as usize] = n.style.r
            packet.node_style_g[i as usize] = n.style.g
            packet.node_style_b[i as usize] = n.style.b
            packet.node_style_alpha[i as usize] = n.style.alpha
            packet.node_style_stroke_width[i as usize] = n.style.stroke_width
            packet.node_style_fill_flags[i as usize] = n.style.fill
            packet.node_style_palette[i as usize] = n.style.palette
            packet.node_style_font_scale[i as usize] = n.style.font_scale
        }
        i = i + 1
    }
    viz_workbench_experiment_export_packet_capture_domain_stamps(packet)
    packet.scene_stamp_hash = viz_workbench_experiment_export_packet_stamp_hash(packet)
}

fn viz_workbench_experiment_export_packet_restore_stamped_scene(
    scene: &!VizScene,
    packet: &VizWorkbenchExperimentExportPacket,
) with Mut {
    scene.node_count = packet.stamped_node_count
    scene.series_count = packet.stamped_series_count
    scene.heatmap_count = packet.stamped_heatmap_count
    scene.molecule_count = packet.stamped_molecule_count
    scene.vector_field_count = packet.stamped_vector_field_count
    scene.trajectory_count = packet.stamped_trajectory_count
    scene.spectrum_count = packet.stamped_spectrum_count
    scene.lattice_count = packet.stamped_lattice_count
    scene.particle_event_count = packet.stamped_particle_event_count
    scene.mesh_count = packet.stamped_mesh_count
    var i: i64 = 0
    while i < 64 {
        scene.nodes[i as usize] = packet.stamped_nodes[i as usize]
        i = i + 1
    }
    i = 0
    while i < 8 {
        scene.series[i as usize] = packet.stamped_series[i as usize]
        i = i + 1
    }
    i = 0
    while i < 4 {
        scene.heatmaps[i as usize] = packet.stamped_heatmaps[i as usize]
        scene.molecules[i as usize] = packet.stamped_molecules[i as usize]
        scene.vector_data[i as usize] = packet.stamped_vector_data[i as usize]
        scene.vector_field_rows[i as usize] = packet.stamped_vector_field_rows[i as usize]
        scene.vector_field_cols[i as usize] = packet.stamped_vector_field_cols[i as usize]
        scene.trajectory_data[i as usize] = packet.stamped_trajectory_data[i as usize]
        scene.spectrum_data[i as usize] = packet.stamped_spectrum_data[i as usize]
        scene.lattice_data[i as usize] = packet.stamped_lattice_data[i as usize]
        scene.particle_event_data[i as usize] = packet.stamped_particle_event_data[i as usize]
        scene.meshes[i as usize] = packet.stamped_meshes[i as usize]
        i = i + 1
    }
    viz_workbench_experiment_export_packet_restore_molecule_counts(scene, packet)
    scene.selected_node = packet.selected_node
    scene.hovered_node = packet.hovered_node
    scene.focused_node = packet.focused_node
    scene.selected_atom_node = packet.selected_atom_node
    scene.selected_atom_index = packet.selected_atom_index
    scene.molecule_studio_node = packet.molecule_studio_node
    scene.molecule_tool = packet.molecule_tool
    scene.molecule_unit = packet.molecule_unit
    scene.molecule_pending_atom = packet.molecule_pending_atom
    scene.molecule_last_reason = packet.molecule_last_reason
    scene.molecule_last_action = packet.molecule_last_action
    scene.molecule_accept_count = packet.molecule_accept_count
    scene.molecule_reject_count = packet.molecule_reject_count
    scene.molecule_timeline_count = packet.molecule_timeline_count
    scene.next_node_id = packet.stamped_next_node_id
    scene.active_tab = packet.active_tab
    scene.time = (packet.scene_time_ms as f64) / 1000.0
}

pub fn viz_workbench_experiment_export_packet_build(
    pkg: &VizWorkbenchExperimentPackage,
    restore: &VizWorkbenchExperimentPackageRestore,
    store: &VizWorkbenchExperimentPackageStore,
    cockpit: &VizWorkbenchExperimentTimelineCockpit,
    playback: &VizWorkbenchExperimentCockpitPlayback,
    scene: &VizScene,
    export_frame_hash: i64,
) -> VizWorkbenchExperimentExportPacket with Mut {
    var packet = viz_workbench_experiment_export_packet_empty()
    if !viz_workbench_experiment_export_packet_capture(&!packet, pkg, restore, store, cockpit, playback, scene, export_frame_hash) {
        return viz_workbench_experiment_export_packet_empty()
    }
    packet
}

pub fn viz_workbench_experiment_export_packet_capture(
    packet: &!VizWorkbenchExperimentExportPacket,
    pkg: &VizWorkbenchExperimentPackage,
    restore: &VizWorkbenchExperimentPackageRestore,
    store: &VizWorkbenchExperimentPackageStore,
    cockpit: &VizWorkbenchExperimentTimelineCockpit,
    playback: &VizWorkbenchExperimentCockpitPlayback,
    scene: &VizScene,
    export_frame_hash: i64,
) -> bool with Mut {
    if !pkg.valid { return false }
    if !restore.valid { return false }
    if !store.valid { return false }
    if !cockpit.valid { return false }
    if !playback.valid { return false }
    if pkg.package_hash != restore.package_hash { return false }
    if store.active_package_hash != pkg.package_hash { return false }
    if cockpit.store_hash != store.store_hash { return false }
    if playback.cockpit_hash != cockpit.cockpit_hash { return false }
    if export_frame_hash == 0 { return false }
    packet.valid = true
    packet.packet_hash = 0
    packet.package_hash = pkg.package_hash
    packet.restore_hash = restore.restore_hash
    packet.store_hash = store.store_hash
    packet.cockpit_hash = cockpit.cockpit_hash
    packet.playback_hash = playback.playback_hash
    packet.export_frame_hash = export_frame_hash
    packet.export_scene_audit_hash = viz_audit_hash(scene)
    packet.notebook_hash = cockpit.notebook_hash
    packet.mode_hash = cockpit.mode_hash
    packet.active_slot = store.active_slot
    packet.baseline_slot = store.baseline_slot
    packet.compare_slot = store.compare_slot
    packet.active_frame = playback.active_frame
    packet.baseline_frame = playback.baseline_frame
    packet.compare_frame = playback.compare_frame
    packet.action_count = playback.action_count
    packet.last_action = playback.last_action
    packet.package_count = store.package_count
    packet.package_hash_delta = store.package_hash_delta
    packet.rendered_frame_hash_delta = store.rendered_frame_hash_delta
    packet.scene_audit_hash_delta = store.scene_audit_hash_delta
    viz_workbench_experiment_export_packet_capture_scene_stamp(packet, scene)
    packet.packet_hash = viz_workbench_experiment_export_packet_hash(packet)
    true
}

pub fn viz_workbench_experiment_export_packet_verify(
    packet: &VizWorkbenchExperimentExportPacket,
    pkg: &VizWorkbenchExperimentPackage,
    restore: &VizWorkbenchExperimentPackageRestore,
    store: &VizWorkbenchExperimentPackageStore,
    cockpit: &VizWorkbenchExperimentTimelineCockpit,
    playback: &VizWorkbenchExperimentCockpitPlayback,
    scene: &VizScene,
) -> bool with Mut {
    if !packet.valid { return false }
    if packet.package_hash != pkg.package_hash { return false }
    if packet.restore_hash != restore.restore_hash { return false }
    if packet.store_hash != store.store_hash { return false }
    if packet.cockpit_hash != cockpit.cockpit_hash { return false }
    if packet.playback_hash != playback.playback_hash { return false }
    if packet.notebook_hash != cockpit.notebook_hash { return false }
    if packet.mode_hash != cockpit.mode_hash { return false }
    if packet.active_slot != store.active_slot { return false }
    if packet.baseline_slot != store.baseline_slot { return false }
    if packet.compare_slot != store.compare_slot { return false }
    if packet.active_frame != playback.active_frame { return false }
    if packet.baseline_frame != playback.baseline_frame { return false }
    if packet.compare_frame != playback.compare_frame { return false }
    if packet.action_count != playback.action_count { return false }
    if packet.last_action != playback.last_action { return false }
    if packet.package_count != store.package_count { return false }
    if packet.package_hash_delta != store.package_hash_delta { return false }
    if packet.rendered_frame_hash_delta != store.rendered_frame_hash_delta { return false }
    if packet.scene_audit_hash_delta != store.scene_audit_hash_delta { return false }
    if packet.export_scene_audit_hash != viz_audit_hash(scene) { return false }
    packet.packet_hash == viz_workbench_experiment_export_packet_hash(packet)
}

fn viz_workbench_experiment_export_packet_apply_scene_state(
    scene: &!VizScene,
    packet: &VizWorkbenchExperimentExportPacket,
) with Mut {
    scene.selected_node = packet.selected_node
    scene.hovered_node = packet.hovered_node
    scene.focused_node = packet.focused_node
    scene.active_tab = packet.active_tab
    scene.time = (packet.scene_time_ms as f64) / 1000.0
    scene.selected_atom_node = packet.selected_atom_node
    scene.selected_atom_index = packet.selected_atom_index
    scene.molecule_studio_node = packet.molecule_studio_node
    scene.molecule_tool = packet.molecule_tool
    scene.molecule_unit = packet.molecule_unit
    scene.molecule_pending_atom = packet.molecule_pending_atom
    scene.molecule_last_reason = packet.molecule_last_reason
    scene.molecule_last_action = packet.molecule_last_action
    scene.molecule_accept_count = packet.molecule_accept_count
    scene.molecule_reject_count = packet.molecule_reject_count
    scene.molecule_timeline_count = packet.molecule_timeline_count
    var i: i64 = 0
    while i < scene.node_count {
        if i < 64 {
            scene.nodes[i as usize].value = (packet.node_value_millis[i as usize] as f64) / 1000.0
            scene.nodes[i as usize].selected = packet.node_selected_flags[i as usize]
            scene.nodes[i as usize].style.r = packet.node_style_r[i as usize]
            scene.nodes[i as usize].style.g = packet.node_style_g[i as usize]
            scene.nodes[i as usize].style.b = packet.node_style_b[i as usize]
            scene.nodes[i as usize].style.alpha = packet.node_style_alpha[i as usize]
            scene.nodes[i as usize].style.stroke_width = packet.node_style_stroke_width[i as usize]
            scene.nodes[i as usize].style.fill = packet.node_style_fill_flags[i as usize]
            scene.nodes[i as usize].style.palette = packet.node_style_palette[i as usize]
            scene.nodes[i as usize].style.font_scale = packet.node_style_font_scale[i as usize]
        }
        i = i + 1
    }
    scene.molecule_count = packet.stamped_molecule_count
    if scene.molecule_count < 0 { scene.molecule_count = 0 }
    if scene.molecule_count > 4 { scene.molecule_count = 4 }
    var mi: i64 = 0
    while mi < scene.molecule_count {
        scene.molecules[mi as usize] = packet.stamped_molecules[mi as usize]
        mi = mi + 1
    }
    viz_workbench_experiment_export_packet_restore_molecule_counts(scene, packet)
}

pub fn viz_workbench_experiment_import_replay_report_build(
    packet: &VizWorkbenchExperimentExportPacket,
    notebook: &VizWorkbenchNotebook,
    source_library: &VizWorkbenchExperimentDiffLibrary,
    store: &VizWorkbenchExperimentPackageStore,
    app: &!VizApp,
    scene: &!VizScene,
    ids: &VizWorkbenchIds,
    c: &!Canvas,
    restored_library: &!VizWorkbenchExperimentDiffLibrary,
    restored_mode: &!VizWorkbenchExperimentCompareMode,
    active_session: &VizWorkbenchReplaySession,
    baseline_session: &VizWorkbenchReplaySession,
    compare_session: &VizWorkbenchReplaySession,
) -> VizWorkbenchExperimentImportReplayReport with Mut, Div, Alloc {
    if !packet.valid { return viz_workbench_experiment_import_replay_report_empty() }
    if packet.packet_hash != viz_workbench_experiment_export_packet_hash(packet) { return viz_workbench_experiment_import_replay_report_empty() }
    if !viz_workbench_notebook_verify(notebook) { return viz_workbench_experiment_import_replay_report_empty() }
    if !viz_workbench_experiment_package_store_verify(store) { return viz_workbench_experiment_import_replay_report_empty() }
    if packet.active_slot < 0 || packet.active_slot >= store.package_count { return viz_workbench_experiment_import_replay_report_empty() }
    if packet.baseline_slot < 0 || packet.baseline_slot >= store.package_count { return viz_workbench_experiment_import_replay_report_empty() }
    if packet.compare_slot < 0 || packet.compare_slot >= store.package_count { return viz_workbench_experiment_import_replay_report_empty() }
    if packet.store_hash != store.store_hash { return viz_workbench_experiment_import_replay_report_empty() }
    if packet.active_slot != store.active_slot { return viz_workbench_experiment_import_replay_report_empty() }
    if packet.baseline_slot != store.baseline_slot { return viz_workbench_experiment_import_replay_report_empty() }
    if packet.compare_slot != store.compare_slot { return viz_workbench_experiment_import_replay_report_empty() }
    if packet.package_hash != store.active_package_hash { return viz_workbench_experiment_import_replay_report_empty() }
    if packet.package_count != store.package_count { return viz_workbench_experiment_import_replay_report_empty() }
    if packet.package_hash_delta != store.package_hash_delta { return viz_workbench_experiment_import_replay_report_empty() }
    if packet.rendered_frame_hash_delta != store.rendered_frame_hash_delta { return viz_workbench_experiment_import_replay_report_empty() }
    if packet.scene_audit_hash_delta != store.scene_audit_hash_delta { return viz_workbench_experiment_import_replay_report_empty() }
    let pkg = store.packages[packet.active_slot as usize]
    if !pkg.valid { return viz_workbench_experiment_import_replay_report_empty() }
    if pkg.package_hash != packet.package_hash { return viz_workbench_experiment_import_replay_report_empty() }
    let active_timeline = viz_workbench_replay_to_frame(app, scene, ids, c, active_session, packet.active_frame)
    if !active_timeline.valid { return viz_workbench_experiment_import_replay_report_empty() }
    if active_timeline.selected_frame != packet.active_frame { return viz_workbench_experiment_import_replay_report_empty() }
    let restore = viz_workbench_experiment_package_restore(&pkg, source_library, app, scene, ids, c, restored_library, restored_mode)
    if !restore.valid { return viz_workbench_experiment_import_replay_report_empty() }
    if !viz_workbench_experiment_package_restore_verify(&restore, &pkg, restored_library, restored_mode, scene) { return viz_workbench_experiment_import_replay_report_empty() }
    viz_workbench_experiment_package_store_mark(scene, ids, store)
    let cockpit = viz_workbench_experiment_timeline_cockpit_build(notebook, store, restored_mode)
    if !cockpit.valid { return viz_workbench_experiment_import_replay_report_empty() }
    if cockpit.cockpit_hash != packet.cockpit_hash { return viz_workbench_experiment_import_replay_report_empty() }
    viz_workbench_experiment_timeline_cockpit_mark(scene, ids, &cockpit)
    var playback = viz_workbench_experiment_cockpit_playback_build(&cockpit, active_session, baseline_session, compare_session, packet.active_frame, packet.baseline_frame, packet.compare_frame)
    if !playback.valid { return viz_workbench_experiment_import_replay_report_empty() }
    playback.action_count = packet.action_count
    playback.last_action = packet.last_action
    playback.playback_hash = viz_workbench_experiment_cockpit_playback_hash(&playback)
    if playback.playback_hash != packet.playback_hash { return viz_workbench_experiment_import_replay_report_empty() }
    viz_workbench_experiment_cockpit_playback_mark(scene, ids, &playback)
    viz_workbench_experiment_export_packet_restore_stamped_scene(scene, packet)
    canvas_clear(c, app.bg_r, app.bg_g, app.bg_b)
    viz_canvas_render_scene(scene, c)
    let replay_frame_hash = viz_workbench_canvas_hash(c)
    let replay_scene_audit_hash = viz_audit_hash(scene)
    var report = VizWorkbenchExperimentImportReplayReport {
        valid: true,
        import_hash: 0,
        packet_hash: packet.packet_hash,
        package_hash: packet.package_hash,
        restore_hash: packet.restore_hash,
        store_hash: store.store_hash,
        cockpit_hash: cockpit.cockpit_hash,
        playback_hash: playback.playback_hash,
        replay_frame_hash: replay_frame_hash,
        replay_scene_audit_hash: replay_scene_audit_hash,
        expected_frame_hash: packet.export_frame_hash,
        expected_scene_audit_hash: packet.export_scene_audit_hash,
        active_slot: packet.active_slot,
        baseline_slot: packet.baseline_slot,
        compare_slot: packet.compare_slot,
        active_frame: packet.active_frame,
        baseline_frame: packet.baseline_frame,
        compare_frame: packet.compare_frame,
        action_count: packet.action_count,
        last_action: packet.last_action,
        frame_hash_delta: replay_frame_hash - packet.export_frame_hash,
        scene_audit_hash_delta: replay_scene_audit_hash - packet.export_scene_audit_hash,
        selected_node: packet.selected_node,
        hovered_node: packet.hovered_node,
        focused_node: packet.focused_node,
        active_tab: packet.active_tab,
        scene_time_ms: packet.scene_time_ms,
        selected_atom_node: packet.selected_atom_node,
        selected_atom_index: packet.selected_atom_index,
        molecule_studio_node: packet.molecule_studio_node,
        molecule_tool: packet.molecule_tool,
        molecule_unit: packet.molecule_unit,
        molecule_pending_atom: packet.molecule_pending_atom,
        molecule_last_reason: packet.molecule_last_reason,
        molecule_last_action: packet.molecule_last_action,
        molecule_accept_count: packet.molecule_accept_count,
        molecule_reject_count: packet.molecule_reject_count,
        molecule_timeline_count: packet.molecule_timeline_count,
        scene_stamp_hash: packet.scene_stamp_hash,
    }
    report.import_hash = viz_workbench_experiment_import_replay_report_hash(&report)
    report
}

pub fn viz_workbench_experiment_import_replay_report_verify(
    report: &VizWorkbenchExperimentImportReplayReport,
    packet: &VizWorkbenchExperimentExportPacket,
    store: &VizWorkbenchExperimentPackageStore,
    scene: &VizScene,
) -> bool with Mut {
    if !report.valid { return false }
    if !packet.valid { return false }
    if !store.valid { return false }
    if report.packet_hash != packet.packet_hash { return false }
    if report.package_hash != packet.package_hash { return false }
    if report.restore_hash != packet.restore_hash { return false }
    if report.store_hash != packet.store_hash { return false }
    if report.cockpit_hash != packet.cockpit_hash { return false }
    if report.playback_hash != packet.playback_hash { return false }
    if report.expected_frame_hash != packet.export_frame_hash { return false }
    if report.expected_scene_audit_hash != packet.export_scene_audit_hash { return false }
    if report.active_slot != packet.active_slot { return false }
    if report.baseline_slot != packet.baseline_slot { return false }
    if report.compare_slot != packet.compare_slot { return false }
    if report.active_frame != packet.active_frame { return false }
    if report.baseline_frame != packet.baseline_frame { return false }
    if report.compare_frame != packet.compare_frame { return false }
    if report.action_count != packet.action_count { return false }
    if report.last_action != packet.last_action { return false }
    if report.package_hash != store.active_package_hash { return false }
    if report.store_hash != store.store_hash { return false }
    if report.replay_scene_audit_hash != viz_audit_hash(scene) { return false }
    if report.frame_hash_delta != report.replay_frame_hash - report.expected_frame_hash { return false }
    if report.scene_audit_hash_delta != report.replay_scene_audit_hash - report.expected_scene_audit_hash { return false }
    if report.selected_node != packet.selected_node { return false }
    if report.hovered_node != packet.hovered_node { return false }
    if report.focused_node != packet.focused_node { return false }
    if report.active_tab != packet.active_tab { return false }
    if report.scene_time_ms != packet.scene_time_ms { return false }
    if report.selected_atom_node != packet.selected_atom_node { return false }
    if report.selected_atom_index != packet.selected_atom_index { return false }
    if report.molecule_studio_node != packet.molecule_studio_node { return false }
    if report.molecule_tool != packet.molecule_tool { return false }
    if report.molecule_unit != packet.molecule_unit { return false }
    if report.molecule_pending_atom != packet.molecule_pending_atom { return false }
    if report.molecule_last_reason != packet.molecule_last_reason { return false }
    if report.molecule_last_action != packet.molecule_last_action { return false }
    if report.molecule_accept_count != packet.molecule_accept_count { return false }
    if report.molecule_reject_count != packet.molecule_reject_count { return false }
    if report.molecule_timeline_count != packet.molecule_timeline_count { return false }
    if report.scene_stamp_hash != packet.scene_stamp_hash { return false }
    if scene.selected_node != packet.selected_node { return false }
    if scene.hovered_node != packet.hovered_node { return false }
    if scene.focused_node != packet.focused_node { return false }
    if scene.active_tab != packet.active_tab { return false }
    if (scene.time * 1000.0) as i64 != packet.scene_time_ms { return false }
    if scene.selected_atom_node != packet.selected_atom_node { return false }
    if scene.selected_atom_index != packet.selected_atom_index { return false }
    if scene.molecule_studio_node != packet.molecule_studio_node { return false }
    if scene.molecule_tool != packet.molecule_tool { return false }
    if scene.molecule_unit != packet.molecule_unit { return false }
    if scene.molecule_pending_atom != packet.molecule_pending_atom { return false }
    if scene.molecule_last_reason != packet.molecule_last_reason { return false }
    if scene.molecule_last_action != packet.molecule_last_action { return false }
    if scene.molecule_accept_count != packet.molecule_accept_count { return false }
    if scene.molecule_reject_count != packet.molecule_reject_count { return false }
    if scene.molecule_timeline_count != packet.molecule_timeline_count { return false }
    report.import_hash == viz_workbench_experiment_import_replay_report_hash(report)
}

pub fn viz_workbench_project_capture(
    project: &!VizSceneProject,
    scene: &VizScene,
    history: &VizSceneHistory,
    pkg: &!VizScenePackage,
    session: &VizWorkbenchReplaySession,
    export_hash: i64,
) with Mut {
    viz_scene_package_capture(pkg, scene, history)
    var final_time_ms = (scene.time * 1000.0) as i64
    if session.frame_count > 0 && session.frame_count <= 33 {
        final_time_ms = session.times_ms[(session.frame_count - 1) as usize]
    }
    viz_scene_project_capture(
        project,
        scene,
        history,
        viz_workbench_replay_session_hash(session),
        session.final_frame_hash,
        session.final_audit_hash,
        final_time_ms,
        export_hash,
    )
}

pub fn viz_workbench_project_restore(scene: &!VizScene, project: &VizSceneProject) -> bool with Mut, Div {
    if !viz_scene_project_restore(scene, project) { return false }
    viz_workbench_sync_dynamics(scene)
    true
}

pub fn viz_workbench_project_verify_session(
    app: &!VizApp,
    scene: &!VizScene,
    ids: &VizWorkbenchIds,
    c: &!Canvas,
    project: &VizSceneProject,
    session: &VizWorkbenchReplaySession,
) -> bool with Mut, Div, Alloc {
    if !viz_scene_project_verify(project) { return false }
    if project.replay_signature != viz_workbench_replay_session_hash(session) { return false }
    if project.final_frame_hash != session.final_frame_hash { return false }
    if project.final_audit_hash != session.final_audit_hash { return false }
    if session.frame_count <= 0 || session.frame_count > 33 { return false }
    if project.final_time_ms != session.times_ms[(session.frame_count - 1) as usize] { return false }
    viz_workbench_replay_verify_session(app, scene, ids, c, session)
}

pub fn viz_workbench_canvas_hash(c: &Canvas) -> i64 with Mut {
    var h: i64 = 23
    var i: i64 = 0
    let n = c.width * c.height
    while i < n {
        h = h * 131 + read_i64(c.pixels, i)
        i = i + 1
    }
    h
}

fn viz_workbench_project_current_session(app: &!VizApp, scene: &!VizScene, c: &!Canvas) -> VizWorkbenchReplaySession with Mut, Div, Alloc {
    var session = viz_workbench_replay_session_new()
    session.step_count = 0
    let frame_hash = viz_replay_present(app, scene, c)
    viz_workbench_replay_store_frame(&!session, 0, frame_hash, scene)
    session
}

fn viz_workbench_project_store_mark(scene: &!VizScene, ids: &VizWorkbenchIds, store: &VizWorkbenchProjectStore) with Mut, Div {
    viz_workbench_set_package_marker(scene, ids, store.last_project_hash)
}

fn viz_workbench_project_workspace_clamp_slot(slot: i64) -> i64 {
    if slot < 0 { return 0 }
    if slot > 1 { return 1 }
    slot
}

fn viz_workbench_project_workspace_slot_hash(workspace: &VizWorkbenchProjectWorkspace, slot: i64) -> i64 with Mut, Div {
    let idx = viz_workbench_project_workspace_clamp_slot(slot)
    var h: i64 = 41
    h = h * 131 + idx
    h = h * 131 + workspace.project_hashes[idx as usize]
    h = h * 131 + workspace.audit_hashes[idx as usize]
    h = h * 131 + workspace.time_ms[idx as usize]
    h
}

fn viz_workbench_project_workspace_project_hash(workspace: &VizWorkbenchProjectWorkspace, slot: i64) -> i64 {
    if slot == 0 { return workspace.project_a.project_hash }
    workspace.project_b.project_hash
}

fn viz_workbench_project_workspace_time_ms(workspace: &VizWorkbenchProjectWorkspace, slot: i64) -> i64 {
    if slot == 0 { return workspace.project_a.final_time_ms }
    workspace.project_b.final_time_ms
}

fn viz_workbench_project_workspace_frame_hash(workspace: &VizWorkbenchProjectWorkspace, slot: i64) -> i64 {
    if slot == 0 { return workspace.project_a.final_frame_hash }
    workspace.project_b.final_frame_hash
}

fn viz_workbench_project_workspace_node_count(workspace: &VizWorkbenchProjectWorkspace, slot: i64) -> i64 {
    if slot == 0 { return workspace.project_a.package.snapshot.node_count }
    workspace.project_b.package.snapshot.node_count
}

fn viz_workbench_abs_delta(a: i64, b: i64) -> i64 {
    if a >= b { return a - b }
    b - a
}

pub fn viz_workbench_project_workspace_slot_valid(workspace: &VizWorkbenchProjectWorkspace, slot: i64) -> bool {
    let idx = viz_workbench_project_workspace_clamp_slot(slot)
    workspace.valid[idx as usize]
}

pub fn viz_workbench_project_workspace_active_hash(workspace: &VizWorkbenchProjectWorkspace) -> i64 {
    let idx = viz_workbench_project_workspace_clamp_slot(workspace.active_slot)
    workspace.project_hashes[idx as usize]
}

pub fn viz_workbench_project_workspace_save(
    app: &!VizApp,
    scene: &!VizScene,
    ids: &VizWorkbenchIds,
    workspace: &!VizWorkbenchProjectWorkspace,
    c: &!Canvas,
    slot: i64,
) -> bool with Mut, Div, Alloc {
    let idx = viz_workbench_project_workspace_clamp_slot(slot)
    viz_workbench_package_select_target(scene, ids)
    var history = viz_scene_history_new()
    var pkg = viz_scene_package_new()
    viz_scene_history_record(&!history, scene, VIZ_WORKBENCH_TAG_PACKAGE_SAVE + idx)
    let session = viz_workbench_project_current_session(app, scene, c)
    let export_hash = viz_workbench_canvas_hash(c)
    if idx == 0 { viz_workbench_project_capture(&!workspace.project_a, scene, &history, &!pkg, &session, export_hash) }
    if idx == 1 { viz_workbench_project_capture(&!workspace.project_b, scene, &history, &!pkg, &session, export_hash) }
    if idx == 0 {
        if !viz_scene_project_verify(&workspace.project_a) { return false }
    }
    if idx == 1 {
        if !viz_scene_project_verify(&workspace.project_b) { return false }
    }
    if !workspace.valid[idx as usize] {
        workspace.slot_count = workspace.slot_count + 1
    }
    workspace.valid[idx as usize] = true
    workspace.project_hashes[idx as usize] = viz_workbench_project_workspace_project_hash(workspace, idx)
    workspace.time_ms[idx as usize] = viz_workbench_project_workspace_time_ms(workspace, idx)
    workspace.active_slot = idx
    workspace.save_count = workspace.save_count + 1
    viz_workbench_set_package_marker(scene, ids, workspace.project_hashes[idx as usize])
    workspace.audit_hashes[idx as usize] = viz_audit_hash(scene)
    true
}

pub fn viz_workbench_project_workspace_load(
    scene: &!VizScene,
    ids: &VizWorkbenchIds,
    workspace: &!VizWorkbenchProjectWorkspace,
    slot: i64,
) -> bool with Mut, Div {
    let idx = viz_workbench_project_workspace_clamp_slot(slot)
    if !workspace.valid[idx as usize] { return false }
    if idx == 0 {
        if !viz_workbench_project_restore(scene, &workspace.project_a) { return false }
    }
    if idx == 1 {
        if !viz_workbench_project_restore(scene, &workspace.project_b) { return false }
    }
    if workspace.active_slot != idx {
        workspace.switch_count = workspace.switch_count + 1
    }
    workspace.active_slot = idx
    workspace.load_count = workspace.load_count + 1
    viz_workbench_set_package_marker(scene, ids, workspace.project_hashes[idx as usize])
    true
}

pub fn viz_workbench_project_workspace_compare(
    workspace: &!VizWorkbenchProjectWorkspace,
    left_slot: i64,
    right_slot: i64,
) -> i64 with Mut, Div {
    let diff = viz_workbench_project_workspace_compare_detail(workspace, left_slot, right_slot)
    if !diff.valid { return 0 }
    diff.diff_hash
}

pub fn viz_workbench_project_workspace_compare_detail(
    workspace: &!VizWorkbenchProjectWorkspace,
    left_slot: i64,
    right_slot: i64,
) -> VizWorkbenchProjectDiff with Mut, Div {
    let left = viz_workbench_project_workspace_clamp_slot(left_slot)
    let right = viz_workbench_project_workspace_clamp_slot(right_slot)
    if !workspace.valid[left as usize] { return viz_workbench_project_diff_empty() }
    if !workspace.valid[right as usize] { return viz_workbench_project_diff_empty() }
    let dt = viz_workbench_abs_delta(workspace.time_ms[left as usize], workspace.time_ms[right as usize])
    let da = viz_workbench_abs_delta(workspace.audit_hashes[left as usize], workspace.audit_hashes[right as usize])
    let df = viz_workbench_abs_delta(
        viz_workbench_project_workspace_frame_hash(workspace, left),
        viz_workbench_project_workspace_frame_hash(workspace, right),
    )
    let dp = viz_workbench_abs_delta(workspace.project_hashes[left as usize], workspace.project_hashes[right as usize])
    let dn = viz_workbench_abs_delta(
        viz_workbench_project_workspace_node_count(workspace, left),
        viz_workbench_project_workspace_node_count(workspace, right),
    )
    var h: i64 = 97
    h = h * 131 + viz_workbench_project_workspace_slot_hash(workspace, left)
    h = h * 131 + viz_workbench_project_workspace_slot_hash(workspace, right)
    h = h * 131 + workspace.slot_count
    h = h * 131 + dt
    h = h * 131 + da
    h = h * 131 + df
    h = h * 131 + dp
    h = h * 131 + dn
    workspace.active_slot = left
    workspace.compare_slot = right
    workspace.compare_count = workspace.compare_count + 1
    workspace.last_diff_hash = h
    workspace.last_time_delta_ms = dt
    workspace.last_audit_delta = da
    workspace.last_frame_delta = df
    workspace.last_project_delta = dp
    workspace.last_node_delta = dn
    VizWorkbenchProjectDiff {
        valid: true,
        left_slot: left,
        right_slot: right,
        time_delta_ms: dt,
        audit_delta: da,
        frame_delta: df,
        project_delta: dp,
        node_delta: dn,
        diff_hash: h,
    }
}

fn viz_workbench_project_workspace_mark(scene: &!VizScene, ids: &VizWorkbenchIds, workspace: &VizWorkbenchProjectWorkspace) with Mut, Div {
    if ids.workspace_diff < 0 || ids.workspace_diff >= scene.node_count { return }
    var marker = workspace.last_diff_hash
    if marker == 0 {
        marker = viz_workbench_project_workspace_active_hash(workspace)
    }
    scene.nodes[ids.workspace_diff as usize].value = viz_workbench_hash_marker(marker)
    scene.nodes[ids.workspace_diff as usize].min_value = 0.0
    scene.nodes[ids.workspace_diff as usize].max_value = 1000000.0
    if ids.workspace_dt >= 0 && ids.workspace_dt < scene.node_count {
        scene.nodes[ids.workspace_dt as usize].value = workspace.last_time_delta_ms as f64
        scene.nodes[ids.workspace_dt as usize].min_value = 0.0
        scene.nodes[ids.workspace_dt as usize].max_value = 10000000.0
    }
    if ids.workspace_daudit >= 0 && ids.workspace_daudit < scene.node_count {
        scene.nodes[ids.workspace_daudit as usize].value = viz_workbench_hash_marker(workspace.last_audit_delta)
        scene.nodes[ids.workspace_daudit as usize].min_value = 0.0
        scene.nodes[ids.workspace_daudit as usize].max_value = 1000000.0
    }
    if ids.workspace_dframe >= 0 && ids.workspace_dframe < scene.node_count {
        scene.nodes[ids.workspace_dframe as usize].value = viz_workbench_hash_marker(workspace.last_frame_delta)
        scene.nodes[ids.workspace_dframe as usize].min_value = 0.0
        scene.nodes[ids.workspace_dframe as usize].max_value = 1000000.0
    }
    if ids.workspace_dproject >= 0 && ids.workspace_dproject < scene.node_count {
        scene.nodes[ids.workspace_dproject as usize].value = viz_workbench_hash_marker(workspace.last_project_delta)
        scene.nodes[ids.workspace_dproject as usize].min_value = 0.0
        scene.nodes[ids.workspace_dproject as usize].max_value = 1000000.0
    }
    if ids.workspace_dnodes >= 0 && ids.workspace_dnodes < scene.node_count {
        scene.nodes[ids.workspace_dnodes as usize].value = workspace.last_node_delta as f64
        scene.nodes[ids.workspace_dnodes as usize].min_value = 0.0
        scene.nodes[ids.workspace_dnodes as usize].max_value = 1000.0
    }
}

pub fn viz_workbench_handle_workspace_event(
    app: &!VizApp,
    scene: &!VizScene,
    ids: &VizWorkbenchIds,
    workspace: &!VizWorkbenchProjectWorkspace,
    c: &!Canvas,
    ev: Event,
) -> bool with Mut, Div, Alloc {
    if ev.kind != EV_MOUSE_PRESS || ev.key != MOUSE_LEFT { return false }
    let idx = viz_scene_hit_test(scene, ev.x, ev.y)
    if idx < 0 || idx >= scene.node_count { return false }
    let tag = scene.nodes[idx as usize].tag
    if tag == VIZ_WORKBENCH_TAG_WORKSPACE_SAVE_A {
        if !viz_workbench_project_workspace_save(app, scene, ids, workspace, c, 0) { return false }
        viz_workbench_project_workspace_mark(scene, ids, workspace)
        return true
    }
    if tag == VIZ_WORKBENCH_TAG_WORKSPACE_SAVE_B {
        if !viz_workbench_project_workspace_save(app, scene, ids, workspace, c, 1) { return false }
        viz_workbench_project_workspace_mark(scene, ids, workspace)
        return true
    }
    if tag == VIZ_WORKBENCH_TAG_WORKSPACE_LOAD_A {
        if !viz_workbench_project_workspace_load(scene, ids, workspace, 0) { return false }
        viz_workbench_project_workspace_mark(scene, ids, workspace)
        return true
    }
    if tag == VIZ_WORKBENCH_TAG_WORKSPACE_LOAD_B {
        if !viz_workbench_project_workspace_load(scene, ids, workspace, 1) { return false }
        viz_workbench_project_workspace_mark(scene, ids, workspace)
        return true
    }
    if tag == VIZ_WORKBENCH_TAG_WORKSPACE_COMPARE {
        let diff = viz_workbench_project_workspace_compare(workspace, 0, 1)
        if diff == 0 { return false }
        viz_workbench_project_workspace_mark(scene, ids, workspace)
        return true
    }
    false
}

pub fn viz_workbench_project_store_save(
    app: &!VizApp,
    scene: &!VizScene,
    ids: &VizWorkbenchIds,
    store: &!VizWorkbenchProjectStore,
    c: &!Canvas,
) -> bool with Mut, Div, Alloc {
    viz_workbench_package_select_target(scene, ids)
    viz_scene_history_record(&!store.history, scene, VIZ_WORKBENCH_TAG_PACKAGE_SAVE)
    let session = viz_workbench_project_current_session(app, scene, c)
    let export_hash = viz_workbench_canvas_hash(c)
    viz_workbench_project_capture(&!store.project, scene, &store.history, &!store.package, &session, export_hash)
    if !viz_scene_project_verify(&store.project) { return false }
    store.last_project_hash = store.project.project_hash
    store.last_replay_signature = store.project.replay_signature
    store.last_export_hash = store.project.export_hash
    store.dirty = false
    store.save_count = store.save_count + 1
    viz_workbench_project_store_mark(scene, ids, store)
    true
}

pub fn viz_workbench_project_store_load(
    scene: &!VizScene,
    ids: &VizWorkbenchIds,
    store: &!VizWorkbenchProjectStore,
) -> bool with Mut, Div {
    if !viz_workbench_project_restore(scene, &store.project) { return false }
    store.last_project_hash = store.project.project_hash
    store.last_replay_signature = store.project.replay_signature
    store.last_export_hash = store.project.export_hash
    store.dirty = false
    store.load_count = store.load_count + 1
    viz_workbench_project_store_mark(scene, ids, store)
    true
}

pub fn viz_workbench_project_store_export(
    app: &!VizApp,
    scene: &!VizScene,
    ids: &VizWorkbenchIds,
    store: &!VizWorkbenchProjectStore,
    c: &!Canvas,
) -> bool with Mut, Div, Alloc {
    if !viz_workbench_project_store_save(app, scene, ids, store, c) { return false }
    store.export_count = store.export_count + 1
    true
}

pub fn viz_workbench_handle_project_event(
    app: &!VizApp,
    scene: &!VizScene,
    ids: &VizWorkbenchIds,
    store: &!VizWorkbenchProjectStore,
    c: &!Canvas,
    ev: Event,
) -> bool with Mut, Div, Alloc {
    if ev.kind != EV_MOUSE_PRESS || ev.key != MOUSE_LEFT { return false }
    let idx = viz_scene_hit_test(scene, ev.x, ev.y)
    if idx < 0 || idx >= scene.node_count { return false }
    let tag = scene.nodes[idx as usize].tag
    if tag == VIZ_WORKBENCH_TAG_PACKAGE_SAVE {
        return viz_workbench_project_store_save(app, scene, ids, store, c)
    }
    if tag == VIZ_WORKBENCH_TAG_PACKAGE_RESTORE {
        return viz_workbench_project_store_load(scene, ids, store)
    }
    if tag == VIZ_WORKBENCH_TAG_EXPORT {
        return viz_workbench_project_store_export(app, scene, ids, store, c)
    }
    false
}

pub fn viz_workbench_project_app_handle_event(
    app: &!VizApp,
    scene: &!VizScene,
    ids: &VizWorkbenchIds,
    constraint: &!VizMoleculeConstraint,
    store: &!VizWorkbenchProjectStore,
    c: &!Canvas,
    ev: Event,
) -> bool with Mut, Div, Alloc {
    if ev.kind == EV_CLOSE || ev.kind == EV_EXPOSE {
        return viz_app_handle_event(app, scene, ev)
    }
    var changed = viz_workbench_handle_project_event(app, scene, ids, store, c, ev)
    if !changed {
        changed = viz_workbench_handle_event(scene, constraint, ev)
        if changed {
            store.dirty = true
        }
    }
    if changed {
        viz_workbench_sync_dynamics(scene)
        app.dirty = true
    }
    changed
}

pub fn viz_workbench_workspace_app_handle_event(
    app: &!VizApp,
    scene: &!VizScene,
    ids: &VizWorkbenchIds,
    constraint: &!VizMoleculeConstraint,
    store: &!VizWorkbenchProjectStore,
    workspace: &!VizWorkbenchProjectWorkspace,
    c: &!Canvas,
    ev: Event,
) -> bool with Mut, Div, Alloc {
    if ev.kind == EV_CLOSE || ev.kind == EV_EXPOSE {
        return viz_app_handle_event(app, scene, ev)
    }
    var changed = viz_workbench_handle_workspace_event(app, scene, ids, workspace, c, ev)
    if !changed {
        changed = viz_workbench_handle_project_event(app, scene, ids, store, c, ev)
    }
    if !changed {
        changed = viz_workbench_handle_event(scene, constraint, ev)
        if changed {
            store.dirty = true
        }
    }
    if changed {
        viz_workbench_sync_dynamics(scene)
        app.dirty = true
    }
    changed
}

fn viz_workbench_print_i64(n: i64) with IO, Mut, Div {
    if n == 0 { print("0"); return }
    var v = n
    if v < 0 { print("-"); v = 0 - v }
    var digits: [i64; 20] = [0; 20]
    var len: i64 = 0
    while v > 0 {
        digits[len as usize] = v - (v / 10) * 10
        v = v / 10
        len = len + 1
    }
    var i = len - 1
    while i >= 0 {
        let d = digits[i as usize]
        if d == 0 { print("0") }
        if d == 1 { print("1") }
        if d == 2 { print("2") }
        if d == 3 { print("3") }
        if d == 4 { print("4") }
        if d == 5 { print("5") }
        if d == 6 { print("6") }
        if d == 7 { print("7") }
        if d == 8 { print("8") }
        if d == 9 { print("9") }
        i = i - 1
    }
}

pub fn viz_workbench_replay_emit_html_archive(session: &VizWorkbenchReplaySession) with IO, Mut, Div {
    print("<!-- workbench-replay-session steps=")
    viz_workbench_print_i64(session.step_count)
    print(" frames=")
    viz_workbench_print_i64(session.frame_count)
    print(" signature=")
    viz_workbench_print_i64(viz_workbench_replay_session_hash(session))
    print(" final-frame-hash=")
    viz_workbench_print_i64(session.final_frame_hash)
    print(" final-audit-hash=")
    viz_workbench_print_i64(session.final_audit_hash)
    print(" final-time-ms=")
    if session.frame_count > 0 {
        viz_workbench_print_i64(session.times_ms[(session.frame_count - 1) as usize])
    } else {
        viz_workbench_print_i64(0)
    }
    print(" -->\n")
}

pub fn viz_workbench_session_archive_emit(archive: &VizWorkbenchSessionArchive) with IO, Mut, Div {
    print("<!-- workbench-session-archive valid=")
    if archive.valid { print("1") } else { print("0") }
    print(" archive-hash=")
    viz_workbench_print_i64(archive.archive_hash)
    print(" session-hash=")
    viz_workbench_print_i64(archive.session_hash)
    print(" project-hash=")
    viz_workbench_print_i64(archive.project_hash)
    print(" timeline-hash=")
    viz_workbench_print_i64(archive.timeline_hash)
    print(" diff-hash=")
    viz_workbench_print_i64(archive.diff_hash)
    print(" selected-frame=")
    viz_workbench_print_i64(archive.selected_frame)
    print(" frames=")
    viz_workbench_print_i64(archive.frame_count)
    print(" selected-time-ms=")
    viz_workbench_print_i64(archive.selected_time_ms)
    print(" final-time-ms=")
    viz_workbench_print_i64(archive.final_time_ms)
    print(" selected-frame-hash=")
    viz_workbench_print_i64(archive.selected_frame_hash)
    print(" final-frame-hash=")
    viz_workbench_print_i64(archive.final_frame_hash)
    print(" selected-audit-hash=")
    viz_workbench_print_i64(archive.selected_audit_hash)
    print(" final-audit-hash=")
    viz_workbench_print_i64(archive.final_audit_hash)
    print(" -->\n")
}

pub fn viz_workbench_notebook_emit(notebook: &VizWorkbenchNotebook) with IO, Mut, Div {
    let cmp = viz_workbench_notebook_compare(notebook)
    print("<!-- workbench-notebook valid=")
    if notebook.valid { print("1") } else { print("0") }
    print(" notebook-hash=")
    viz_workbench_print_i64(notebook.notebook_hash)
    print(" archives=")
