// stdlib/viz/workbench.sio - native visual workbench scene blueprint

use display::canvas::{Canvas}
use display::event::{Event, EV_MOUSE_PRESS, EV_MOTION, EV_KEY_PRESS, EV_CLOSE, EV_EXPOSE, MOUSE_LEFT, KEY_RIGHT}
use render::renderer3d::{Tri3D}
use viz::audit::{viz_audit_hash}
use viz::authoring::{VizMoleculeConstraint, viz_molecule_constraint_default}
use viz::ir::{
    VizScene, viz_layout_rect, viz_style_rgb,
    viz_add_label, viz_add_line_chart, viz_add_uncertainty_band, viz_add_heatmap,
    viz_add_molecule_slot, viz_add_scalar_field, viz_add_vector_field, viz_add_trajectory,
    viz_add_spectrum, viz_add_lattice_field, viz_add_particle_event, viz_add_mesh, viz_add_slider, viz_add_tabs, viz_add_toggle,
    viz_add_legend, viz_add_tooltip, viz_add_viewport, viz_add_button,
    viz_scene_add_molecule_data, viz_scene_set_tag, viz_scene_set_parent, viz_scene_set_time,
    viz_scene_handle_event, viz_scene_hit_test, viz_scene_set_time_from_slider,
}
use viz::molecule_studio::{viz_molecule_studio_bind, viz_molecule_studio_handle_event}
use viz::physchem::{
    molecule_h2o, scalar_field_radial, vector_field_vortex,
    trajectory_spiral, spectrum_absorption_demo,
    lattice_field_phonon_frame, particle_event_view_frame,
}
use viz::snapshot::{
    VizSceneHistory, VizScenePackage, VizSceneProject,
    viz_scene_history_new, viz_scene_package_new, viz_scene_project_new,
    viz_scene_history_record, viz_scene_history_undo, viz_scene_history_redo,
    viz_scene_history_hash,
    viz_scene_package_capture, viz_scene_package_restore, viz_scene_package_verify,
    viz_scene_project_capture, viz_scene_project_restore, viz_scene_project_verify,
}
use viz::viz_app::{VizApp, viz_app_handle_event}
use viz::viz_replay::{viz_replay_present}

pub struct VizWorkbenchIds {
    pub title: i64,
    pub slider: i64,
    pub tabs: i64,
    pub toggle: i64,
    pub plot: i64,
    pub molecule: i64,
    pub band: i64,
    pub heatmap: i64,
    pub vector_field: i64,
    pub trajectory: i64,
    pub spectrum: i64,
    pub mesh: i64,
    pub legend: i64,
    pub tooltip: i64,
    pub viewport: i64,
    pub button: i64,
    pub studio_select: i64,
    pub studio_move: i64,
    pub studio_atom: i64,
    pub studio_bond: i64,
    pub studio_delete: i64,
    pub studio_lock: i64,
    pub studio_status: i64,
    pub studio_timeline: i64,
    pub lattice: i64,
    pub particle_event: i64,
    pub time_back: i64,
    pub time_play: i64,
    pub time_forward: i64,
    pub time_readout: i64,
    pub package_undo: i64,
    pub package_redo: i64,
    pub package_save: i64,
    pub package_restore: i64,
    pub package_audit: i64,
}

pub const VIZ_WORKBENCH_TAG_TIME_BACK: i64 = 8801
pub const VIZ_WORKBENCH_TAG_TIME_PLAY: i64 = 8802
pub const VIZ_WORKBENCH_TAG_TIME_FORWARD: i64 = 8803
pub const VIZ_WORKBENCH_TAG_TIME_READOUT: i64 = 8804
pub const VIZ_WORKBENCH_TAG_PACKAGE_UNDO: i64 = 8901
pub const VIZ_WORKBENCH_TAG_PACKAGE_REDO: i64 = 8902
pub const VIZ_WORKBENCH_TAG_PACKAGE_SAVE: i64 = 8903
pub const VIZ_WORKBENCH_TAG_PACKAGE_RESTORE: i64 = 8904
pub const VIZ_WORKBENCH_TAG_PACKAGE_AUDIT: i64 = 8905
pub const VIZ_WORKBENCH_TAG_EXPORT: i64 = 8604

pub const VIZ_WORKBENCH_PACKAGE_UNDO: i64 = 1
pub const VIZ_WORKBENCH_PACKAGE_REDO: i64 = 2
pub const VIZ_WORKBENCH_PACKAGE_SAVE: i64 = 3
pub const VIZ_WORKBENCH_PACKAGE_RESTORE: i64 = 4

pub const VIZ_WORKBENCH_REPLAY_EVENT: i64 = 1
pub const VIZ_WORKBENCH_REPLAY_TICK: i64 = 2

pub struct VizWorkbenchReplayStep {
    pub kind: i64,
    pub event: Event,
    pub dt_ms: i64,
}

pub struct VizWorkbenchReplaySession {
    pub steps: [VizWorkbenchReplayStep; 32],
    pub step_count: i64,
    pub frame_hashes: [i64; 33],
    pub audit_hashes: [i64; 33],
    pub times_ms: [i64; 33],
    pub frame_count: i64,
    pub final_frame_hash: i64,
    pub final_audit_hash: i64,
}

pub struct VizWorkbenchProjectStore {
    pub project: VizSceneProject,
    pub history: VizSceneHistory,
    pub package: VizScenePackage,
    pub last_project_hash: i64,
    pub last_replay_signature: i64,
    pub last_export_hash: i64,
    pub dirty: bool,
    pub save_count: i64,
    pub load_count: i64,
    pub export_count: i64,
}

pub struct VizWorkbenchProjectWorkspace {
    pub project_a: VizSceneProject,
    pub project_b: VizSceneProject,
    pub valid: [bool; 2],
    pub project_hashes: [i64; 2],
    pub audit_hashes: [i64; 2],
    pub time_ms: [i64; 2],
    pub active_slot: i64,
    pub compare_slot: i64,
    pub slot_count: i64,
    pub switch_count: i64,
    pub save_count: i64,
    pub load_count: i64,
    pub compare_count: i64,
    pub last_diff_hash: i64,
}

pub fn viz_workbench_replay_step_empty() -> VizWorkbenchReplayStep {
    VizWorkbenchReplayStep {
        kind: 0,
        event: Event { kind: 0, key: 0, x: 0, y: 0, mods: 0 },
        dt_ms: 0,
    }
}

pub fn viz_workbench_replay_event(ev: Event) -> VizWorkbenchReplayStep {
    VizWorkbenchReplayStep { kind: VIZ_WORKBENCH_REPLAY_EVENT, event: ev, dt_ms: 0 }
}

pub fn viz_workbench_replay_tick(dt_ms: i64) -> VizWorkbenchReplayStep {
    VizWorkbenchReplayStep {
        kind: VIZ_WORKBENCH_REPLAY_TICK,
        event: Event { kind: 0, key: 0, x: 0, y: 0, mods: 0 },
        dt_ms: dt_ms,
    }
}

pub fn viz_workbench_replay_session_new() -> VizWorkbenchReplaySession {
    VizWorkbenchReplaySession {
        steps: [viz_workbench_replay_step_empty(); 32],
        step_count: 0,
        frame_hashes: [0; 33],
        audit_hashes: [0; 33],
        times_ms: [0; 33],
        frame_count: 0,
        final_frame_hash: 0,
        final_audit_hash: 0,
    }
}

pub fn viz_workbench_project_store_new() -> VizWorkbenchProjectStore {
    VizWorkbenchProjectStore {
        project: viz_scene_project_new(),
        history: viz_scene_history_new(),
        package: viz_scene_package_new(),
        last_project_hash: 0,
        last_replay_signature: 0,
        last_export_hash: 0,
        dirty: false,
        save_count: 0,
        load_count: 0,
        export_count: 0,
    }
}

pub fn viz_workbench_project_workspace_new() -> VizWorkbenchProjectWorkspace {
    VizWorkbenchProjectWorkspace {
        project_a: viz_scene_project_new(),
        project_b: viz_scene_project_new(),
        valid: [false; 2],
        project_hashes: [0; 2],
        audit_hashes: [0; 2],
        time_ms: [0; 2],
        active_slot: 0,
        compare_slot: 0,
        slot_count: 0,
        switch_count: 0,
        save_count: 0,
        load_count: 0,
        compare_count: 0,
        last_diff_hash: 0,
    }
}

pub fn viz_workbench_build_scene(scene: &!VizScene) -> VizWorkbenchIds with Mut, Div {
    var xs: [f64; 1024] = [0.0; 1024]
    var ys: [f64; 1024] = [0.0; 1024]
    var vars: [f64; 1024] = [0.0; 1024]
    var i: i64 = 0
    while i < 18 {
        xs[i as usize] = i as f64
        ys[i as usize] = 3.5 + (i as f64) * 0.22
        vars[i as usize] = 0.04 + (i as f64) * 0.006
        i = i + 1
    }

    var title_text: [i8; 64] = [0; 64]
    title_text[0] = 83
    title_text[1] = 111
    title_text[2] = 117
    title_text[3] = 110
    title_text[4] = 105
    title_text[5] = 111
    title_text[6] = 32
    title_text[7] = 86
    title_text[8] = 105
    title_text[9] = 115
    title_text[10] = 117
    title_text[11] = 97
    title_text[12] = 108
    title_text[13] = 32
    title_text[14] = 87
    title_text[15] = 111
    title_text[16] = 114
    title_text[17] = 107
    title_text[18] = 98
    title_text[19] = 101
    title_text[20] = 110
    title_text[21] = 99
    title_text[22] = 104

    var legend_text: [i8; 64] = [0; 64]
    legend_text[0] = 115
    legend_text[1] = 101
    legend_text[2] = 109
    legend_text[3] = 97
    legend_text[4] = 110
    legend_text[5] = 116
    legend_text[6] = 105
    legend_text[7] = 99
    legend_text[8] = 32
    legend_text[9] = 73
    legend_text[10] = 82

    var tooltip_text: [i8; 64] = [0; 64]
    tooltip_text[0] = 114
    tooltip_text[1] = 101
    tooltip_text[2] = 112
    tooltip_text[3] = 108
    tooltip_text[4] = 97
    tooltip_text[5] = 121
    tooltip_text[6] = 32
    tooltip_text[7] = 114
    tooltip_text[8] = 101
    tooltip_text[9] = 97
    tooltip_text[10] = 100
    tooltip_text[11] = 121

    var viewport_text: [i8; 64] = [0; 64]
    viewport_text[0] = 97
    viewport_text[1] = 117
    viewport_text[2] = 100
    viewport_text[3] = 105
    viewport_text[4] = 116
    viewport_text[5] = 32
    viewport_text[6] = 112
    viewport_text[7] = 97
    viewport_text[8] = 110
    viewport_text[9] = 101
    viewport_text[10] = 108

    var button_text: [i8; 64] = [0; 64]
    button_text[0] = 101
    button_text[1] = 120
    button_text[2] = 112
    button_text[3] = 111
    button_text[4] = 114
    button_text[5] = 116

    var select_text: [i8; 64] = [0; 64]
    select_text[0] = 115
    select_text[1] = 101
    select_text[2] = 108

    var move_text: [i8; 64] = [0; 64]
    move_text[0] = 109
    move_text[1] = 111
    move_text[2] = 118
    move_text[3] = 101

    var atom_text: [i8; 64] = [0; 64]
    atom_text[0] = 43
    atom_text[1] = 97
    atom_text[2] = 116
    atom_text[3] = 111
    atom_text[4] = 109

    var bond_text: [i8; 64] = [0; 64]
    bond_text[0] = 98
    bond_text[1] = 111
    bond_text[2] = 110
    bond_text[3] = 100

    var del_text: [i8; 64] = [0; 64]
    del_text[0] = 100
    del_text[1] = 101
    del_text[2] = 108

    var lock_text: [i8; 64] = [0; 64]
    lock_text[0] = 108
    lock_text[1] = 111
    lock_text[2] = 99
    lock_text[3] = 107

    var studio_status_text: [i8; 64] = [0; 64]
    studio_status_text[0] = 79
    studio_status_text[1] = 75

    var studio_timeline_text: [i8; 64] = [0; 64]
    studio_timeline_text[0] = 116
    studio_timeline_text[1] = 105
    studio_timeline_text[2] = 109
    studio_timeline_text[3] = 101
    studio_timeline_text[4] = 108
    studio_timeline_text[5] = 105
    studio_timeline_text[6] = 110
    studio_timeline_text[7] = 101

    var time_back_text: [i8; 64] = [0; 64]
    time_back_text[0] = 60

    var time_play_text: [i8; 64] = [0; 64]
    time_play_text[0] = 112
    time_play_text[1] = 108
    time_play_text[2] = 97
    time_play_text[3] = 121

    var time_forward_text: [i8; 64] = [0; 64]
    time_forward_text[0] = 62

    var time_readout_text: [i8; 64] = [0; 64]
    time_readout_text[0] = 102
    time_readout_text[1] = 114
    time_readout_text[2] = 97
    time_readout_text[3] = 109
    time_readout_text[4] = 101

    var package_undo_text: [i8; 64] = [0; 64]
    package_undo_text[0] = 117
    package_undo_text[1] = 110
    package_undo_text[2] = 100
    package_undo_text[3] = 111

    var package_redo_text: [i8; 64] = [0; 64]
    package_redo_text[0] = 114
    package_redo_text[1] = 101
    package_redo_text[2] = 100
    package_redo_text[3] = 111

    var package_save_text: [i8; 64] = [0; 64]
    package_save_text[0] = 115
    package_save_text[1] = 97
    package_save_text[2] = 118
    package_save_text[3] = 101

    var package_restore_text: [i8; 64] = [0; 64]
    package_restore_text[0] = 108
    package_restore_text[1] = 111
    package_restore_text[2] = 97
    package_restore_text[3] = 100

    var package_audit_text: [i8; 64] = [0; 64]
    package_audit_text[0] = 112
    package_audit_text[1] = 107
    package_audit_text[2] = 103
    package_audit_text[3] = 32
    package_audit_text[4] = 97
    package_audit_text[5] = 117
    package_audit_text[6] = 100
    package_audit_text[7] = 105
    package_audit_text[8] = 116

    let field = scalar_field_radial(8, 8)
    let vectors = vector_field_vortex(6, 6)
    let traj = trajectory_spiral(24)
    let spec = spectrum_absorption_demo(32)
    let lattice_data = lattice_field_phonon_frame(6, 6, 2.0)
    let particle_data = particle_event_view_frame(18, 2.0)
    let mol = molecule_h2o()
    let mol_slot = viz_scene_add_molecule_data(scene, mol)
    var tris: [Tri3D; 128] = [Tri3D {
        v0x: -0.42, v0y: -0.34, v0z: -2.0,
        v1x: 0.42, v1y: -0.34, v1z: -2.0,
        v2x: 0.0, v2y: 0.42, v2z: -2.0,
        nx: 0.0, ny: 0.0, nz: 1.0,
        base_r: 170, base_g: 220, base_b: 130,
    }; 128]
    tris[1] = Tri3D {
        v0x: -0.35, v0y: 0.28, v0z: -2.12,
        v1x: 0.35, v1y: 0.28, v1z: -2.12,
        v2x: 0.0, v2y: -0.48, v2z: -2.12,
        nx: 0.0, ny: 0.0, nz: 1.0,
        base_r: 120, base_g: 190, base_b: 245,
    }

    viz_scene_set_time(scene, 2.0)
    let title = viz_add_label(scene, &title_text, 23, viz_layout_rect(12, 14, 220, 12), viz_style_rgb(230, 238, 245))
    let slider = viz_add_slider(scene, viz_layout_rect(16, 228, 170, 22), 2.0, 0.0, 10.0, viz_style_rgb(245, 190, 80))
    let tabs = viz_add_tabs(scene, viz_layout_rect(200, 228, 132, 20), 0, 0, 3, viz_style_rgb(100, 190, 240))
    let toggle = viz_add_toggle(scene, viz_layout_rect(348, 228, 30, 20), false, viz_style_rgb(120, 225, 150))
    let plot = viz_add_line_chart(scene, &xs, &ys, 18, viz_layout_rect(16, 44, 110, 70), viz_style_rgb(255, 140, 90))
    let band = viz_add_uncertainty_band(scene, &xs, &ys, &vars, 18, viz_layout_rect(138, 44, 110, 70), viz_style_rgb(90, 190, 255))
    let heatmap = viz_add_heatmap(scene, &field.values, field.rows, field.cols, field.min_value, field.max_value, viz_layout_rect(260, 44, 110, 70))
    let vector_field = viz_add_vector_field(scene, vectors, viz_layout_rect(16, 132, 90, 62))
    let trajectory = viz_add_trajectory(scene, traj, viz_layout_rect(118, 132, 100, 62))
    let spectrum = viz_add_spectrum(scene, spec, viz_layout_rect(230, 132, 110, 62))
    let lattice = viz_add_lattice_field(scene, lattice_data, viz_layout_rect(230, 202, 104, 20))
    let particle_event = viz_add_particle_event(scene, particle_data, viz_layout_rect(352, 202, 92, 20))
    let time_back = viz_add_button(scene, &time_back_text, 1, viz_layout_rect(16, 202, 26, 20), viz_style_rgb(210, 230, 180))
    let time_play = viz_add_button(scene, &time_play_text, 4, viz_layout_rect(48, 202, 46, 20), viz_style_rgb(120, 225, 150))
    let time_forward = viz_add_button(scene, &time_forward_text, 1, viz_layout_rect(100, 202, 26, 20), viz_style_rgb(210, 230, 180))
    let time_readout = viz_add_viewport(scene, &time_readout_text, 5, viz_layout_rect(132, 202, 82, 20), viz_style_rgb(160, 210, 255))
    let mesh = viz_add_mesh(scene, &tris, 2, viz_layout_rect(352, 132, 92, 62), viz_style_rgb(170, 220, 130))
    let scalar = viz_add_scalar_field(scene, field, viz_layout_rect(392, 228, 52, 40))
    let package_undo = viz_add_button(scene, &package_undo_text, 4, viz_layout_rect(16, 244, 38, 18), viz_style_rgb(210, 230, 180))
    let package_redo = viz_add_button(scene, &package_redo_text, 4, viz_layout_rect(60, 244, 38, 18), viz_style_rgb(210, 230, 180))
    let package_save = viz_add_button(scene, &package_save_text, 4, viz_layout_rect(104, 244, 42, 18), viz_style_rgb(120, 225, 150))
    let package_restore = viz_add_button(scene, &package_restore_text, 4, viz_layout_rect(152, 244, 42, 18), viz_style_rgb(180, 220, 255))
    let package_audit = viz_add_viewport(scene, &package_audit_text, 9, viz_layout_rect(200, 244, 92, 18), viz_style_rgb(160, 210, 255))
    let legend = viz_add_legend(scene, &legend_text, 11, viz_layout_rect(16, 264, 112, 18), viz_style_rgb(255, 140, 90))
    let tooltip = viz_add_tooltip(scene, &tooltip_text, 12, viz_layout_rect(142, 264, 124, 18), viz_style_rgb(245, 220, 140))
    let viewport = viz_add_viewport(scene, &viewport_text, 11, viz_layout_rect(280, 264, 106, 18), viz_style_rgb(160, 210, 255))
    let button = viz_add_button(scene, &button_text, 6, viz_layout_rect(398, 264, 58, 18), viz_style_rgb(210, 230, 180))
    let molecule = viz_add_molecule_slot(scene, mol_slot, viz_layout_rect(382, 44, 78, 70), viz_style_rgb(210, 220, 240))
    let studio_select = viz_add_button(scene, &select_text, 3, viz_layout_rect(16, 292, 32, 18), viz_style_rgb(180, 220, 255))
    let studio_move = viz_add_button(scene, &move_text, 4, viz_layout_rect(54, 292, 38, 18), viz_style_rgb(180, 220, 255))
    let studio_atom = viz_add_button(scene, &atom_text, 5, viz_layout_rect(98, 292, 44, 18), viz_style_rgb(180, 220, 255))
    let studio_bond = viz_add_button(scene, &bond_text, 4, viz_layout_rect(148, 292, 42, 18), viz_style_rgb(180, 220, 255))
    let studio_delete = viz_add_button(scene, &del_text, 3, viz_layout_rect(196, 292, 34, 18), viz_style_rgb(255, 170, 130))
    let studio_lock = viz_add_button(scene, &lock_text, 4, viz_layout_rect(236, 292, 42, 18), viz_style_rgb(255, 220, 130))
    let studio_status = viz_add_tooltip(scene, &studio_status_text, 2, viz_layout_rect(292, 292, 74, 18), viz_style_rgb(245, 220, 140))
    let studio_timeline = viz_add_viewport(scene, &studio_timeline_text, 8, viz_layout_rect(374, 292, 82, 18), viz_style_rgb(160, 210, 255))
    viz_molecule_studio_bind(scene, molecule)

    viz_scene_set_tag(scene, title, 8000)
    viz_scene_set_tag(scene, slider, 8101)
    viz_scene_set_tag(scene, tabs, 8102)
    viz_scene_set_tag(scene, toggle, 8103)
    viz_scene_set_tag(scene, plot, 8201)
    viz_scene_set_tag(scene, molecule, 8301)
    viz_scene_set_tag(scene, band, 8202)
    viz_scene_set_tag(scene, heatmap, 8203)
    viz_scene_set_tag(scene, vector_field, 8401)
    viz_scene_set_tag(scene, trajectory, 8402)
    viz_scene_set_tag(scene, spectrum, 8403)
    viz_scene_set_tag(scene, lattice, 8405)
    viz_scene_set_tag(scene, particle_event, 8406)
    viz_scene_set_tag(scene, time_back, VIZ_WORKBENCH_TAG_TIME_BACK)
    viz_scene_set_tag(scene, time_play, VIZ_WORKBENCH_TAG_TIME_PLAY)
    viz_scene_set_tag(scene, time_forward, VIZ_WORKBENCH_TAG_TIME_FORWARD)
    viz_scene_set_tag(scene, time_readout, VIZ_WORKBENCH_TAG_TIME_READOUT)
    viz_scene_set_tag(scene, mesh, 8501)
    viz_scene_set_tag(scene, scalar, 8404)
    viz_scene_set_tag(scene, package_undo, VIZ_WORKBENCH_TAG_PACKAGE_UNDO)
    viz_scene_set_tag(scene, package_redo, VIZ_WORKBENCH_TAG_PACKAGE_REDO)
    viz_scene_set_tag(scene, package_save, VIZ_WORKBENCH_TAG_PACKAGE_SAVE)
    viz_scene_set_tag(scene, package_restore, VIZ_WORKBENCH_TAG_PACKAGE_RESTORE)
    viz_scene_set_tag(scene, package_audit, VIZ_WORKBENCH_TAG_PACKAGE_AUDIT)
    viz_scene_set_tag(scene, legend, 8601)
    viz_scene_set_tag(scene, tooltip, 8602)
    viz_scene_set_tag(scene, viewport, 8603)
    viz_scene_set_tag(scene, button, VIZ_WORKBENCH_TAG_EXPORT)
    viz_scene_set_tag(scene, studio_select, 8701)
    viz_scene_set_tag(scene, studio_move, 8702)
    viz_scene_set_tag(scene, studio_atom, 8703)
    viz_scene_set_tag(scene, studio_bond, 8704)
    viz_scene_set_tag(scene, studio_delete, 8705)
    viz_scene_set_tag(scene, studio_lock, 8706)
    viz_scene_set_tag(scene, studio_status, 8710)
    viz_scene_set_tag(scene, studio_timeline, 8711)

    if time_play >= 0 { scene.nodes[time_play as usize].value = 0.0 }
    if time_readout >= 0 {
        scene.nodes[time_readout as usize].value = 2.0
        scene.nodes[time_readout as usize].min_value = 0.0
        scene.nodes[time_readout as usize].max_value = 10.0
    }

    viz_scene_set_parent(scene, band, plot)
    viz_scene_set_parent(scene, heatmap, plot)
    viz_scene_set_parent(scene, slider, plot)
    viz_scene_set_parent(scene, tabs, plot)
    viz_scene_set_parent(scene, toggle, band)
    viz_scene_set_parent(scene, vector_field, heatmap)
    viz_scene_set_parent(scene, trajectory, plot)
    viz_scene_set_parent(scene, spectrum, plot)
    viz_scene_set_parent(scene, lattice, heatmap)
    viz_scene_set_parent(scene, particle_event, heatmap)
    viz_scene_set_parent(scene, time_back, plot)
    viz_scene_set_parent(scene, time_play, plot)
    viz_scene_set_parent(scene, time_forward, plot)
    viz_scene_set_parent(scene, time_readout, plot)
    viz_scene_set_parent(scene, mesh, plot)
    viz_scene_set_parent(scene, scalar, heatmap)
    viz_scene_set_parent(scene, package_undo, title)
    viz_scene_set_parent(scene, package_redo, title)
    viz_scene_set_parent(scene, package_save, title)
    viz_scene_set_parent(scene, package_restore, title)
    viz_scene_set_parent(scene, package_audit, title)
    viz_scene_set_parent(scene, legend, title)
    viz_scene_set_parent(scene, tooltip, title)
    viz_scene_set_parent(scene, viewport, title)
    viz_scene_set_parent(scene, button, title)
    viz_scene_set_parent(scene, molecule, plot)
    viz_scene_set_parent(scene, studio_select, molecule)
    viz_scene_set_parent(scene, studio_move, molecule)
    viz_scene_set_parent(scene, studio_atom, molecule)
    viz_scene_set_parent(scene, studio_bond, molecule)
    viz_scene_set_parent(scene, studio_delete, molecule)
    viz_scene_set_parent(scene, studio_lock, molecule)
    viz_scene_set_parent(scene, studio_status, molecule)
    viz_scene_set_parent(scene, studio_timeline, molecule)

    VizWorkbenchIds {
        title: title,
        slider: slider,
        tabs: tabs,
        toggle: toggle,
        plot: plot,
        molecule: molecule,
        band: band,
        heatmap: heatmap,
        vector_field: vector_field,
        trajectory: trajectory,
        spectrum: spectrum,
        mesh: mesh,
        legend: legend,
        tooltip: tooltip,
        viewport: viewport,
        button: button,
        studio_select: studio_select,
        studio_move: studio_move,
        studio_atom: studio_atom,
        studio_bond: studio_bond,
        studio_delete: studio_delete,
        studio_lock: studio_lock,
        studio_status: studio_status,
        studio_timeline: studio_timeline,
        lattice: lattice,
        particle_event: particle_event,
        time_back: time_back,
        time_play: time_play,
        time_forward: time_forward,
        time_readout: time_readout,
        package_undo: package_undo,
        package_redo: package_redo,
        package_save: package_save,
        package_restore: package_restore,
        package_audit: package_audit,
    }
}

fn viz_workbench_find_tag(scene: &VizScene, tag: i64) -> i64 with Mut {
    var i: i64 = 0
    while i < scene.node_count {
        if scene.nodes[i as usize].tag == tag { return i }
        i = i + 1
    }
    0 - 1
}

fn viz_workbench_set_time(scene: &!VizScene, t_in: f64) with Mut, Div {
    var t = t_in
    if t < 0.0 { t = 0.0 }
    if t > 10.0 { t = 10.0 }
    scene.time = t
    let slider = viz_workbench_find_tag(scene, 8101)
    if slider >= 0 {
        viz_scene_set_time_from_slider(scene, slider, t)
    }
    let readout = viz_workbench_find_tag(scene, VIZ_WORKBENCH_TAG_TIME_READOUT)
    if readout >= 0 {
        scene.nodes[readout as usize].value = scene.time
        scene.nodes[readout as usize].min_value = 0.0
        scene.nodes[readout as usize].max_value = 10.0
    }
    viz_workbench_sync_dynamics(scene)
}

fn viz_workbench_toggle_play(scene: &!VizScene) with Mut {
    let play = viz_workbench_find_tag(scene, VIZ_WORKBENCH_TAG_TIME_PLAY)
    if play >= 0 {
        if scene.nodes[play as usize].value > 0.0 {
            scene.nodes[play as usize].value = 0.0
            scene.nodes[play as usize].selected = false
        } else {
            scene.nodes[play as usize].value = 1.0
            scene.nodes[play as usize].selected = true
        }
    }
}

pub fn viz_workbench_playing(scene: &VizScene) -> bool with Mut {
    let play = viz_workbench_find_tag(scene, VIZ_WORKBENCH_TAG_TIME_PLAY)
    if play < 0 { return false }
    scene.nodes[play as usize].value > 0.0
}

pub fn viz_workbench_sync_dynamics(scene: &!VizScene) with Mut, Div {
    if scene.lattice_count > 0 {
        scene.lattice_data[0].rows = 6
        scene.lattice_data[0].cols = 6
        var r: i64 = 0
        while r < 6 {
            var c: i64 = 0
            while c < 6 {
                let idx = r * 6 + c
                let phase = ((r + c) as f64) * 0.25 + scene.time * 0.35
                scene.lattice_data[0].phase[idx as usize] = phase
                scene.lattice_data[0].displacement_x[idx as usize] = ((c as f64) - 3.0) * 0.02 + scene.time * 0.006
                scene.lattice_data[0].displacement_y[idx as usize] = ((r as f64) - 3.0) * 0.02 - scene.time * 0.004
                scene.lattice_data[0].variance[idx as usize] = 0.001 + (idx as f64) * 0.0001 + scene.time * 0.00002
                c = c + 1
            }
            r = r + 1
        }
    }
    if scene.particle_event_count > 0 {
        scene.particle_event_data[0].n = 18
        var i: i64 = 0
        while i < 18 {
            scene.particle_event_data[0].px[i as usize] = (i as f64) * 0.08 + scene.time * 0.025
            scene.particle_event_data[0].py[i as usize] = ((i * i) as f64) * 0.006 + scene.time * 0.015
            scene.particle_event_data[0].pz[i as usize] = (i as f64) * 0.02 + scene.time * 0.01
            scene.particle_event_data[0].energy[i as usize] = 1.0 + (i as f64) * 0.05 + scene.time * 0.03
            scene.particle_event_data[0].variance[i as usize] = 0.01 + (i as f64) * 0.001 + scene.time * 0.0005
            scene.particle_event_data[0].kind[i as usize] = i % 3
            i = i + 1
        }
    }
    if scene.mesh_count > 0 {
        let t = scene.time
        scene.meshes[0].n = 2
        scene.meshes[0].tris[0] = Tri3D {
            v0x: -0.42 + t * 0.010, v0y: -0.34 + t * 0.004, v0z: -2.00 + t * 0.006,
            v1x: 0.42 - t * 0.006, v1y: -0.34 + t * 0.010, v1z: -2.00 - t * 0.004,
            v2x: -0.10 + t * 0.020, v2y: 0.42 - t * 0.006, v2z: -2.00 + t * 0.002,
            nx: t * 0.018, ny: t * 0.010, nz: 1.0,
            base_r: 150 + (t * 6.0) as i64, base_g: 210, base_b: 130,
        }
        scene.meshes[0].tris[1] = Tri3D {
            v0x: -0.35 - t * 0.004, v0y: 0.28 - t * 0.006, v0z: -2.12 + t * 0.004,
            v1x: 0.35 + t * 0.008, v1y: 0.28 - t * 0.003, v1z: -2.12 - t * 0.006,
            v2x: 0.10 - t * 0.016, v2y: -0.48 + t * 0.008, v2z: -2.12 + t * 0.003,
            nx: 0.0 - t * 0.010, ny: t * 0.014, nz: 1.0,
            base_r: 120, base_g: 170 + (t * 4.0) as i64, base_b: 235,
        }
        scene.meshes[0].v0x[0] = -0.42 + t * 0.010
        scene.meshes[0].v0y[0] = -0.34 + t * 0.004
        scene.meshes[0].v0z[0] = -2.00 + t * 0.006
        scene.meshes[0].v1x[0] = 0.42 - t * 0.006
        scene.meshes[0].v1y[0] = -0.34 + t * 0.010
        scene.meshes[0].v1z[0] = -2.00 - t * 0.004
        scene.meshes[0].v2x[0] = -0.10 + t * 0.020
        scene.meshes[0].v2y[0] = 0.42 - t * 0.006
        scene.meshes[0].v2z[0] = -2.00 + t * 0.002
        scene.meshes[0].nx[0] = t * 0.018
        scene.meshes[0].ny[0] = t * 0.010
        scene.meshes[0].nz[0] = 1.0
        scene.meshes[0].base_r[0] = 150 + (t * 6.0) as i64
        scene.meshes[0].base_g[0] = 210
        scene.meshes[0].base_b[0] = 130
        scene.meshes[0].v0x[1] = -0.35 - t * 0.004
        scene.meshes[0].v0y[1] = 0.28 - t * 0.006
        scene.meshes[0].v0z[1] = -2.12 + t * 0.004
        scene.meshes[0].v1x[1] = 0.35 + t * 0.008
        scene.meshes[0].v1y[1] = 0.28 - t * 0.003
        scene.meshes[0].v1z[1] = -2.12 - t * 0.006
        scene.meshes[0].v2x[1] = 0.10 - t * 0.016
        scene.meshes[0].v2y[1] = -0.48 + t * 0.008
        scene.meshes[0].v2z[1] = -2.12 + t * 0.003
        scene.meshes[0].nx[1] = 0.0 - t * 0.010
        scene.meshes[0].ny[1] = t * 0.014
        scene.meshes[0].nz[1] = 1.0
        scene.meshes[0].base_r[1] = 120
        scene.meshes[0].base_g[1] = 170 + (t * 4.0) as i64
        scene.meshes[0].base_b[1] = 235
    }
}

pub fn viz_workbench_event(kind: i64, key: i64, x: i64, y: i64, mods: i64) -> Event {
    Event { kind: kind, key: key, x: x, y: y, mods: mods }
}

pub fn viz_workbench_constraint(ids: &VizWorkbenchIds) -> VizMoleculeConstraint {
    viz_molecule_constraint_default(ids.molecule)
}

pub fn viz_workbench_handle_event(scene: &!VizScene, constraint: &!VizMoleculeConstraint, ev: Event) -> bool with Mut, Div {
    if viz_molecule_studio_handle_event(scene, constraint, ev) {
        return true
    }
    if ev.kind == EV_MOUSE_PRESS && ev.key == MOUSE_LEFT {
        let idx = viz_scene_hit_test(scene, ev.x, ev.y)
        if idx >= 0 && idx < scene.node_count {
            let tag = scene.nodes[idx as usize].tag
            if tag == VIZ_WORKBENCH_TAG_TIME_BACK {
                viz_workbench_set_time(scene, scene.time - 1.0)
                return true
            }
            if tag == VIZ_WORKBENCH_TAG_TIME_PLAY {
                viz_workbench_toggle_play(scene)
                return true
            }
            if tag == VIZ_WORKBENCH_TAG_TIME_FORWARD {
                viz_workbench_set_time(scene, scene.time + 1.0)
                return true
            }
        }
    }
    viz_scene_handle_event(scene, ev)
}

fn viz_workbench_hash_marker(h_in: i64) -> f64 with Mut, Div {
    var h = h_in
    if h < 0 { h = 0 - h }
    let m = h - (h / 1000000) * 1000000
    m as f64
}

fn viz_workbench_package_select_target(scene: &!VizScene, ids: &VizWorkbenchIds) with Mut {
    if scene.selected_node >= 0 && scene.selected_node < scene.node_count { return }
    if ids.slider < 0 || ids.slider >= scene.node_count { return }
    scene.selected_node = ids.slider
    scene.focused_node = ids.slider
    scene.hovered_node = ids.slider
    scene.nodes[ids.slider as usize].selected = true
}

fn viz_workbench_set_package_marker(scene: &!VizScene, ids: &VizWorkbenchIds, history_hash: i64) with Mut, Div {
    if ids.package_audit < 0 || ids.package_audit >= scene.node_count { return }
    scene.nodes[ids.package_audit as usize].value = viz_workbench_hash_marker(history_hash)
    scene.nodes[ids.package_audit as usize].min_value = 0.0
    scene.nodes[ids.package_audit as usize].max_value = 1000000.0
}

pub fn viz_workbench_handle_package_command(
    scene: &!VizScene,
    ids: &VizWorkbenchIds,
    history: &!VizSceneHistory,
    pkg: &!VizScenePackage,
    command: i64,
) -> bool with Mut, Div {
    if command == VIZ_WORKBENCH_PACKAGE_SAVE {
        viz_workbench_package_select_target(scene, ids)
        viz_scene_history_record(history, scene, VIZ_WORKBENCH_TAG_PACKAGE_SAVE)
        viz_workbench_set_package_marker(scene, ids, viz_scene_history_hash(history))
        viz_scene_package_capture(pkg, scene, history)
        return viz_scene_package_verify(pkg)
    }
    if command == VIZ_WORKBENCH_PACKAGE_RESTORE {
        if !viz_scene_package_restore(scene, pkg) { return false }
        viz_workbench_sync_dynamics(scene)
        viz_workbench_set_package_marker(scene, ids, pkg.history_hash)
        return true
    }
    if command == VIZ_WORKBENCH_PACKAGE_UNDO {
        if !viz_scene_history_undo(history, scene) { return false }
        viz_workbench_sync_dynamics(scene)
        viz_workbench_set_package_marker(scene, ids, viz_scene_history_hash(history))
        viz_scene_package_capture(pkg, scene, history)
        return true
    }
    if command == VIZ_WORKBENCH_PACKAGE_REDO {
        if !viz_scene_history_redo(history, scene) { return false }
        viz_workbench_sync_dynamics(scene)
        viz_workbench_set_package_marker(scene, ids, viz_scene_history_hash(history))
        viz_scene_package_capture(pkg, scene, history)
        return true
    }
    false
}

pub fn viz_workbench_handle_package_event(
    scene: &!VizScene,
    ids: &VizWorkbenchIds,
    history: &!VizSceneHistory,
    pkg: &!VizScenePackage,
    ev: Event,
) -> bool with Mut, Div {
    if ev.kind != EV_MOUSE_PRESS || ev.key != MOUSE_LEFT { return false }
    let idx = viz_scene_hit_test(scene, ev.x, ev.y)
    if idx < 0 || idx >= scene.node_count { return false }
    let tag = scene.nodes[idx as usize].tag
    if tag == VIZ_WORKBENCH_TAG_PACKAGE_UNDO {
        return viz_workbench_handle_package_command(scene, ids, history, pkg, VIZ_WORKBENCH_PACKAGE_UNDO)
    }
    if tag == VIZ_WORKBENCH_TAG_PACKAGE_REDO {
        return viz_workbench_handle_package_command(scene, ids, history, pkg, VIZ_WORKBENCH_PACKAGE_REDO)
    }
    if tag == VIZ_WORKBENCH_TAG_PACKAGE_SAVE {
        return viz_workbench_handle_package_command(scene, ids, history, pkg, VIZ_WORKBENCH_PACKAGE_SAVE)
    }
    if tag == VIZ_WORKBENCH_TAG_PACKAGE_RESTORE {
        return viz_workbench_handle_package_command(scene, ids, history, pkg, VIZ_WORKBENCH_PACKAGE_RESTORE)
    }
    false
}

pub fn viz_workbench_package_app_handle_event(
    app: &!VizApp,
    scene: &!VizScene,
    ids: &VizWorkbenchIds,
    constraint: &!VizMoleculeConstraint,
    history: &!VizSceneHistory,
    pkg: &!VizScenePackage,
    ev: Event,
) -> bool with Mut, Div {
    if ev.kind == EV_CLOSE || ev.kind == EV_EXPOSE {
        return viz_app_handle_event(app, scene, ev)
    }
    var changed = viz_workbench_handle_package_event(scene, ids, history, pkg, ev)
    if !changed {
        changed = viz_workbench_handle_event(scene, constraint, ev)
    }
    if changed {
        viz_workbench_sync_dynamics(scene)
        app.dirty = true
    }
    changed
}

pub fn viz_workbench_app_handle_event(app: &!VizApp, scene: &!VizScene, constraint: &!VizMoleculeConstraint, ev: Event) -> bool with Mut, Div {
    if ev.kind == EV_CLOSE || ev.kind == EV_EXPOSE {
        return viz_app_handle_event(app, scene, ev)
    }
    let changed = viz_workbench_handle_event(scene, constraint, ev)
    if changed {
        viz_workbench_sync_dynamics(scene)
        app.dirty = true
    }
    changed
}

pub fn viz_workbench_tick(app: &!VizApp, scene: &!VizScene, dt: f64) -> bool with Mut, Div {
    if !viz_workbench_playing(scene) { return false }
    viz_workbench_set_time(scene, scene.time + dt)
    app.dirty = true
    true
}

fn viz_workbench_replay_store_frame(session: &!VizWorkbenchReplaySession, frame_idx: i64, frame_hash: i64, scene: &VizScene) with Mut {
    if frame_idx < 0 || frame_idx >= 33 { return }
    session.frame_hashes[frame_idx as usize] = frame_hash
    session.audit_hashes[frame_idx as usize] = viz_audit_hash(scene)
    session.times_ms[frame_idx as usize] = (scene.time * 1000.0) as i64
    session.frame_count = frame_idx + 1
    session.final_frame_hash = frame_hash
    session.final_audit_hash = session.audit_hashes[frame_idx as usize]
}

pub fn viz_workbench_replay_record_session(app: &!VizApp, scene: &!VizScene, ids: &VizWorkbenchIds, c: &!Canvas, steps: &[VizWorkbenchReplayStep; 32], step_count: i64) -> VizWorkbenchReplaySession with Mut, Div, Alloc {
    var session = viz_workbench_replay_session_new()
    var constraint = viz_workbench_constraint(ids)
    var count = step_count
    if count < 0 { count = 0 }
    if count > 32 { count = 32 }
    session.step_count = count

    var i: i64 = 0
    while i < count {
        session.steps[i as usize] = steps[i as usize]
        i = i + 1
    }

    var hash = viz_replay_present(app, scene, c)
    viz_workbench_replay_store_frame(&!session, 0, hash, scene)

    i = 0
    while i < count {
        let step = steps[i as usize]
        if step.kind == VIZ_WORKBENCH_REPLAY_EVENT {
            viz_workbench_app_handle_event(app, scene, &!constraint, step.event)
        }
        if step.kind == VIZ_WORKBENCH_REPLAY_TICK {
            viz_workbench_tick(app, scene, (step.dt_ms as f64) / 1000.0)
        }
        hash = viz_replay_present(app, scene, c)
        viz_workbench_replay_store_frame(&!session, i + 1, hash, scene)
        i = i + 1
    }
    session
}

pub fn viz_workbench_replay_verify_session(app: &!VizApp, scene: &!VizScene, ids: &VizWorkbenchIds, c: &!Canvas, session: &VizWorkbenchReplaySession) -> bool with Mut, Div, Alloc {
    var constraint = viz_workbench_constraint(ids)
    var count = session.step_count
    if count < 0 { return false }
    if count > 32 { return false }
    if session.frame_count != count + 1 { return false }

    var hash = viz_replay_present(app, scene, c)
    if hash != session.frame_hashes[0] { return false }
    if viz_audit_hash(scene) != session.audit_hashes[0] { return false }
    if ((scene.time * 1000.0) as i64) != session.times_ms[0] { return false }

    var i: i64 = 0
    while i < count {
        let step = session.steps[i as usize]
        if step.kind == VIZ_WORKBENCH_REPLAY_EVENT {
            viz_workbench_app_handle_event(app, scene, &!constraint, step.event)
        }
        if step.kind == VIZ_WORKBENCH_REPLAY_TICK {
            viz_workbench_tick(app, scene, (step.dt_ms as f64) / 1000.0)
        }
        hash = viz_replay_present(app, scene, c)
        let frame_idx = i + 1
        if hash != session.frame_hashes[frame_idx as usize] { return false }
        if viz_audit_hash(scene) != session.audit_hashes[frame_idx as usize] { return false }
        if ((scene.time * 1000.0) as i64) != session.times_ms[frame_idx as usize] { return false }
        i = i + 1
    }
    hash == session.final_frame_hash && viz_audit_hash(scene) == session.final_audit_hash
}

pub fn viz_workbench_replay_session_hash(session: &VizWorkbenchReplaySession) -> i64 with Mut {
    var h: i64 = 1469598103934665603
    h = h * 131 + session.step_count
    h = h * 131 + session.frame_count
    h = h * 131 + session.final_frame_hash
    h = h * 131 + session.final_audit_hash
    var i: i64 = 0
    while i < session.step_count && i < 32 {
        let step = session.steps[i as usize]
        h = h * 131 + step.kind
        h = h * 131 + step.dt_ms
        h = h * 131 + step.event.kind
        h = h * 131 + step.event.key
        h = h * 131 + step.event.x
        h = h * 131 + step.event.y
        i = i + 1
    }
    i = 0
    while i < session.frame_count && i < 33 {
        h = h * 131 + session.times_ms[i as usize]
        h = h * 131 + session.frame_hashes[i as usize]
        h = h * 131 + session.audit_hashes[i as usize]
        i = i + 1
    }
    h
}

pub fn viz_workbench_project_capture(
    project: &!VizSceneProject,
    scene: &VizScene,
    history: &VizSceneHistory,
    pkg: &!VizScenePackage,
    session: &VizWorkbenchReplaySession,
    export_hash: i64,
) with Mut {
    viz_scene_package_capture(pkg, scene, history)
    var final_time_ms = (scene.time * 1000.0) as i64
    if session.frame_count > 0 && session.frame_count <= 33 {
        final_time_ms = session.times_ms[(session.frame_count - 1) as usize]
    }
    viz_scene_project_capture(
        project,
        scene,
        history,
        viz_workbench_replay_session_hash(session),
        session.final_frame_hash,
        session.final_audit_hash,
        final_time_ms,
        export_hash,
    )
}

pub fn viz_workbench_project_restore(scene: &!VizScene, project: &VizSceneProject) -> bool with Mut, Div {
    if !viz_scene_project_restore(scene, project) { return false }
    viz_workbench_sync_dynamics(scene)
    true
}

pub fn viz_workbench_project_verify_session(
    app: &!VizApp,
    scene: &!VizScene,
    ids: &VizWorkbenchIds,
    c: &!Canvas,
    project: &VizSceneProject,
    session: &VizWorkbenchReplaySession,
) -> bool with Mut, Div, Alloc {
    if !viz_scene_project_verify(project) { return false }
    if project.replay_signature != viz_workbench_replay_session_hash(session) { return false }
    if project.final_frame_hash != session.final_frame_hash { return false }
    if project.final_audit_hash != session.final_audit_hash { return false }
    if session.frame_count <= 0 || session.frame_count > 33 { return false }
    if project.final_time_ms != session.times_ms[(session.frame_count - 1) as usize] { return false }
    viz_workbench_replay_verify_session(app, scene, ids, c, session)
}

fn viz_workbench_canvas_hash(c: &Canvas) -> i64 with Mut {
    var h: i64 = 23
    var i: i64 = 0
    let n = c.width * c.height
    while i < n {
        h = h * 131 + read_i64(c.pixels, i)
        i = i + 1
    }
    h
}

fn viz_workbench_project_current_session(app: &!VizApp, scene: &!VizScene, c: &!Canvas) -> VizWorkbenchReplaySession with Mut, Div, Alloc {
    var session = viz_workbench_replay_session_new()
    session.step_count = 0
    let frame_hash = viz_replay_present(app, scene, c)
    viz_workbench_replay_store_frame(&!session, 0, frame_hash, scene)
    session
}

fn viz_workbench_project_store_mark(scene: &!VizScene, ids: &VizWorkbenchIds, store: &VizWorkbenchProjectStore) with Mut, Div {
    viz_workbench_set_package_marker(scene, ids, store.last_project_hash)
}

fn viz_workbench_project_workspace_clamp_slot(slot: i64) -> i64 {
    if slot < 0 { return 0 }
    if slot > 1 { return 1 }
    slot
}

fn viz_workbench_project_workspace_slot_hash(workspace: &VizWorkbenchProjectWorkspace, slot: i64) -> i64 with Mut, Div {
    let idx = viz_workbench_project_workspace_clamp_slot(slot)
    var h: i64 = 41
    h = h * 131 + idx
    h = h * 131 + workspace.project_hashes[idx as usize]
    h = h * 131 + workspace.audit_hashes[idx as usize]
    h = h * 131 + workspace.time_ms[idx as usize]
    h
}

fn viz_workbench_project_workspace_project_hash(workspace: &VizWorkbenchProjectWorkspace, slot: i64) -> i64 {
    if slot == 0 { return workspace.project_a.project_hash }
    workspace.project_b.project_hash
}

fn viz_workbench_project_workspace_time_ms(workspace: &VizWorkbenchProjectWorkspace, slot: i64) -> i64 {
    if slot == 0 { return workspace.project_a.final_time_ms }
    workspace.project_b.final_time_ms
}

pub fn viz_workbench_project_workspace_slot_valid(workspace: &VizWorkbenchProjectWorkspace, slot: i64) -> bool {
    let idx = viz_workbench_project_workspace_clamp_slot(slot)
    workspace.valid[idx as usize]
}

pub fn viz_workbench_project_workspace_active_hash(workspace: &VizWorkbenchProjectWorkspace) -> i64 {
    let idx = viz_workbench_project_workspace_clamp_slot(workspace.active_slot)
    workspace.project_hashes[idx as usize]
}

pub fn viz_workbench_project_workspace_save(
    app: &!VizApp,
    scene: &!VizScene,
    ids: &VizWorkbenchIds,
    workspace: &!VizWorkbenchProjectWorkspace,
    c: &!Canvas,
    slot: i64,
) -> bool with Mut, Div, Alloc {
    let idx = viz_workbench_project_workspace_clamp_slot(slot)
    viz_workbench_package_select_target(scene, ids)
    var history = viz_scene_history_new()
    var pkg = viz_scene_package_new()
    viz_scene_history_record(&!history, scene, VIZ_WORKBENCH_TAG_PACKAGE_SAVE + idx)
    let session = viz_workbench_project_current_session(app, scene, c)
    let export_hash = viz_workbench_canvas_hash(c)
    if idx == 0 { viz_workbench_project_capture(&!workspace.project_a, scene, &history, &!pkg, &session, export_hash) }
    if idx == 1 { viz_workbench_project_capture(&!workspace.project_b, scene, &history, &!pkg, &session, export_hash) }
    if idx == 0 {
        if !viz_scene_project_verify(&workspace.project_a) { return false }
    }
    if idx == 1 {
        if !viz_scene_project_verify(&workspace.project_b) { return false }
    }
    if !workspace.valid[idx as usize] {
        workspace.slot_count = workspace.slot_count + 1
    }
    workspace.valid[idx as usize] = true
    workspace.project_hashes[idx as usize] = viz_workbench_project_workspace_project_hash(workspace, idx)
    workspace.time_ms[idx as usize] = viz_workbench_project_workspace_time_ms(workspace, idx)
    workspace.active_slot = idx
    workspace.save_count = workspace.save_count + 1
    viz_workbench_set_package_marker(scene, ids, workspace.project_hashes[idx as usize])
    workspace.audit_hashes[idx as usize] = viz_audit_hash(scene)
    true
}

pub fn viz_workbench_project_workspace_load(
    scene: &!VizScene,
    ids: &VizWorkbenchIds,
    workspace: &!VizWorkbenchProjectWorkspace,
    slot: i64,
) -> bool with Mut, Div {
    let idx = viz_workbench_project_workspace_clamp_slot(slot)
    if !workspace.valid[idx as usize] { return false }
    if idx == 0 {
        if !viz_workbench_project_restore(scene, &workspace.project_a) { return false }
    }
    if idx == 1 {
        if !viz_workbench_project_restore(scene, &workspace.project_b) { return false }
    }
    if workspace.active_slot != idx {
        workspace.switch_count = workspace.switch_count + 1
    }
    workspace.active_slot = idx
    workspace.load_count = workspace.load_count + 1
    viz_workbench_set_package_marker(scene, ids, workspace.project_hashes[idx as usize])
    true
}

pub fn viz_workbench_project_workspace_compare(
    workspace: &!VizWorkbenchProjectWorkspace,
    left_slot: i64,
    right_slot: i64,
) -> i64 with Mut, Div {
    let left = viz_workbench_project_workspace_clamp_slot(left_slot)
    let right = viz_workbench_project_workspace_clamp_slot(right_slot)
    if !workspace.valid[left as usize] { return 0 }
    if !workspace.valid[right as usize] { return 0 }
    var h: i64 = 97
    h = h * 131 + viz_workbench_project_workspace_slot_hash(workspace, left)
    h = h * 131 + viz_workbench_project_workspace_slot_hash(workspace, right)
    h = h * 131 + workspace.slot_count
    workspace.active_slot = left
    workspace.compare_slot = right
    workspace.compare_count = workspace.compare_count + 1
    workspace.last_diff_hash = h
    h
}

pub fn viz_workbench_project_store_save(
    app: &!VizApp,
    scene: &!VizScene,
    ids: &VizWorkbenchIds,
    store: &!VizWorkbenchProjectStore,
    c: &!Canvas,
) -> bool with Mut, Div, Alloc {
    viz_workbench_package_select_target(scene, ids)
    viz_scene_history_record(&!store.history, scene, VIZ_WORKBENCH_TAG_PACKAGE_SAVE)
    let session = viz_workbench_project_current_session(app, scene, c)
    let export_hash = viz_workbench_canvas_hash(c)
    viz_workbench_project_capture(&!store.project, scene, &store.history, &!store.package, &session, export_hash)
    if !viz_scene_project_verify(&store.project) { return false }
    store.last_project_hash = store.project.project_hash
    store.last_replay_signature = store.project.replay_signature
    store.last_export_hash = store.project.export_hash
    store.dirty = false
    store.save_count = store.save_count + 1
    viz_workbench_project_store_mark(scene, ids, store)
    true
}

pub fn viz_workbench_project_store_load(
    scene: &!VizScene,
    ids: &VizWorkbenchIds,
    store: &!VizWorkbenchProjectStore,
) -> bool with Mut, Div {
    if !viz_workbench_project_restore(scene, &store.project) { return false }
    store.last_project_hash = store.project.project_hash
    store.last_replay_signature = store.project.replay_signature
    store.last_export_hash = store.project.export_hash
    store.dirty = false
    store.load_count = store.load_count + 1
    viz_workbench_project_store_mark(scene, ids, store)
    true
}

pub fn viz_workbench_project_store_export(
    app: &!VizApp,
    scene: &!VizScene,
    ids: &VizWorkbenchIds,
    store: &!VizWorkbenchProjectStore,
    c: &!Canvas,
) -> bool with Mut, Div, Alloc {
    if !viz_workbench_project_store_save(app, scene, ids, store, c) { return false }
    store.export_count = store.export_count + 1
    true
}

pub fn viz_workbench_handle_project_event(
    app: &!VizApp,
    scene: &!VizScene,
    ids: &VizWorkbenchIds,
    store: &!VizWorkbenchProjectStore,
    c: &!Canvas,
    ev: Event,
) -> bool with Mut, Div, Alloc {
    if ev.kind != EV_MOUSE_PRESS || ev.key != MOUSE_LEFT { return false }
    let idx = viz_scene_hit_test(scene, ev.x, ev.y)
    if idx < 0 || idx >= scene.node_count { return false }
    let tag = scene.nodes[idx as usize].tag
    if tag == VIZ_WORKBENCH_TAG_PACKAGE_SAVE {
        return viz_workbench_project_store_save(app, scene, ids, store, c)
    }
    if tag == VIZ_WORKBENCH_TAG_PACKAGE_RESTORE {
        return viz_workbench_project_store_load(scene, ids, store)
    }
    if tag == VIZ_WORKBENCH_TAG_EXPORT {
        return viz_workbench_project_store_export(app, scene, ids, store, c)
    }
    false
}

pub fn viz_workbench_project_app_handle_event(
    app: &!VizApp,
    scene: &!VizScene,
    ids: &VizWorkbenchIds,
    constraint: &!VizMoleculeConstraint,
    store: &!VizWorkbenchProjectStore,
    c: &!Canvas,
    ev: Event,
) -> bool with Mut, Div, Alloc {
    if ev.kind == EV_CLOSE || ev.kind == EV_EXPOSE {
        return viz_app_handle_event(app, scene, ev)
    }
    var changed = viz_workbench_handle_project_event(app, scene, ids, store, c, ev)
    if !changed {
        changed = viz_workbench_handle_event(scene, constraint, ev)
        if changed {
            store.dirty = true
        }
    }
    if changed {
        viz_workbench_sync_dynamics(scene)
        app.dirty = true
    }
    changed
}

fn viz_workbench_print_i64(n: i64) with IO, Mut, Div {
    if n == 0 { print("0"); return }
    var v = n
    if v < 0 { print("-"); v = 0 - v }
    var digits: [i64; 20] = [0; 20]
    var len: i64 = 0
    while v > 0 {
        digits[len as usize] = v - (v / 10) * 10
        v = v / 10
        len = len + 1
    }
    var i = len - 1
    while i >= 0 {
        let d = digits[i as usize]
        if d == 0 { print("0") }
        if d == 1 { print("1") }
        if d == 2 { print("2") }
        if d == 3 { print("3") }
        if d == 4 { print("4") }
        if d == 5 { print("5") }
        if d == 6 { print("6") }
        if d == 7 { print("7") }
        if d == 8 { print("8") }
        if d == 9 { print("9") }
        i = i - 1
    }
}

pub fn viz_workbench_replay_emit_html_archive(session: &VizWorkbenchReplaySession) with IO, Mut, Div {
    print("<!-- workbench-replay-session steps=")
    viz_workbench_print_i64(session.step_count)
    print(" frames=")
    viz_workbench_print_i64(session.frame_count)
    print(" signature=")
    viz_workbench_print_i64(viz_workbench_replay_session_hash(session))
    print(" final-frame-hash=")
    viz_workbench_print_i64(session.final_frame_hash)
    print(" final-audit-hash=")
    viz_workbench_print_i64(session.final_audit_hash)
    print(" final-time-ms=")
    if session.frame_count > 0 {
        viz_workbench_print_i64(session.times_ms[(session.frame_count - 1) as usize])
    } else {
        viz_workbench_print_i64(0)
    }
    print(" -->\n")
}

pub fn viz_workbench_replay_dump_session(session: &VizWorkbenchReplaySession) with IO, Mut {
    print("VIZ_WORKBENCH_REPLAY_SESSION count=")
    print_int(session.step_count)
    print(" frames=")
    print_int(session.frame_count)
    print("\n")
    var i: i64 = 0
    while i < session.frame_count && i < 33 {
        print("frame ")
        print_int(i)
        print(" time-ms=")
        print_int(session.times_ms[i as usize])
        print(" frame-hash=")
        print_int(session.frame_hashes[i as usize])
        print(" audit-hash=")
        print_int(session.audit_hashes[i as usize])
        print("\n")
        i = i + 1
    }
}

pub fn viz_workbench_default_events(events: &![Event; 32]) -> i64 with Mut {
    events[0] = viz_workbench_event(EV_MOUSE_PRESS, MOUSE_LEFT, 46, 238, 0)
    events[1] = viz_workbench_event(EV_MOTION, 0, 101, 238, 0)
    events[2] = viz_workbench_event(EV_MOUSE_PRESS, MOUSE_LEFT, 304, 238, 0)
    events[3] = viz_workbench_event(EV_KEY_PRESS, KEY_RIGHT, 0, 0, 0)
    events[4] = viz_workbench_event(EV_MOUSE_PRESS, MOUSE_LEFT, 356, 238, 0)
    5
}
