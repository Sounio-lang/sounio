    print(" baseline=")
    viz_workbench_print_i64(notebook.baseline_index)
    print(" compare=")
    viz_workbench_print_i64(notebook.compare_index)
    print(" selected-archive-hash=")
    viz_workbench_print_i64(notebook.selected_archive_hash)
    print(" baseline-archive-hash=")
    viz_workbench_print_i64(notebook.baseline_archive_hash)
    print(" compare-archive-hash=")
    viz_workbench_print_i64(notebook.compare_archive_hash)
    print(" compare-hash=")
    viz_workbench_print_i64(notebook.compare_hash)
    print(" compare-valid=")
    if cmp.valid { print("1") } else { print("0") }
    print(" session-delta=")
    viz_workbench_print_i64(cmp.session_delta)
    print(" project-delta=")
    viz_workbench_print_i64(cmp.project_delta)
    print(" timeline-delta=")
    viz_workbench_print_i64(cmp.timeline_delta)
    print(" final-time-delta-ms=")
    viz_workbench_print_i64(cmp.final_time_delta_ms)
    print(" final-frame-delta=")
    viz_workbench_print_i64(cmp.final_frame_delta)
    print(" final-audit-delta=")
    viz_workbench_print_i64(cmp.final_audit_delta)
    print(" -->\n")
}

pub fn viz_workbench_notebook_browser_emit(browser: &VizWorkbenchNotebookBrowser) with IO, Mut, Div {
    print("<!-- workbench-notebook-browser valid=")
    if browser.valid { print("1") } else { print("0") }
    print(" browser-hash=")
    viz_workbench_print_i64(browser.browser_hash)
    print(" notebook-hash=")
    viz_workbench_print_i64(browser.notebook_hash)
    print(" archive-index=")
    viz_workbench_print_i64(browser.archive_index)
    print(" archive-hash=")
    viz_workbench_print_i64(browser.archive_hash)
    print(" session-hash=")
    viz_workbench_print_i64(browser.session_hash)
    print(" project-hash=")
    viz_workbench_print_i64(browser.project_hash)
    print(" selected-frame=")
    viz_workbench_print_i64(browser.selected_frame)
    print(" frames=")
    viz_workbench_print_i64(browser.frame_count)
    print(" selected-time-ms=")
