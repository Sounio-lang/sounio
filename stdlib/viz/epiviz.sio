// stdlib/viz/epiviz.sio — Epistemic uncertainty visualization
//
// Renders Epistemic data (val ± σ, confidence) directly from
// stdlib/epistemic/knowledge.sio types into a Canvas.

use display::canvas::{Canvas, canvas_fill_rect}
use display::canvas_ext::{canvas_draw_line_aa, canvas_blend_pixel}
use display::font::{font_draw_string}
use viz::coord::{CoordSystem, coord_map_x, coord_map_y}
use epistemic::knowledge::{Epistemic}

// ============================================================
// Internal
// ============================================================

fn epiviz_sqrt(x: f64) -> f64 with Mut, Div {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 20 {
        y = 0.5 * (y + x / y)
        i = i + 1
    }
    y
}

fn epiviz_clamp(v: i64, lo: i64, hi: i64) -> i64 {
    if v < lo { lo } else if v > hi { hi } else { v }
}

// Draw a semi-transparent filled band between two y-screen coordinates.
// Simulated via a 50%-dimmed fill using alternating rows.
fn epiviz_draw_band_row(c: &!Canvas, x: i64, y: i64, w: i64, r: i64, g: i64, b: i64) with Mut {
    // Checkerboard at 50% density — every other pixel
    var px = x
    while px < x + w {
        if (px + y) % 2 == 0 {
            canvas_fill_rect(c, px, y, 1, 1, r, g, b)
        }
        px = px + 1
    }
}

// ============================================================
// Uncertainty band — center line + ±1σ shaded region
// ============================================================
//
// xs[i], vals[i], vars[i]: data-space X, mean, and variance (σ²).
// Band is rendered as a translucent region between val-σ and val+σ.

pub fn epiviz_band(
    cs: &CoordSystem,
    xs: &[f64; 1024],
    vals: &[f64; 1024],
    vars: &[f64; 1024],
    n: i64,
    c: &!Canvas,
    r: i64, g: i64, b: i64,
) with Mut, Div {
    if n == 0 { return }
    // First pass: draw the ±1σ band
    var i: i64 = 0
    while i < n {
        let sx   = coord_map_x(cs, xs[i as usize])
        let sigma = epiviz_sqrt(vars[i as usize])
        let y_lo = coord_map_y(cs, vals[i as usize] - sigma)
        let y_hi = coord_map_y(cs, vals[i as usize] + sigma)
        let band_top    = if y_hi < y_lo { y_hi } else { y_lo }
        let band_bottom = if y_hi > y_lo { y_hi } else { y_lo }
        var py = band_top
        while py <= band_bottom {
            epiviz_draw_band_row(c, sx - 1, py, 3, r / 2, g / 2, b)
            py = py + 1
        }
        i = i + 1
    }
    // Second pass: center line (solid, antialiased)
    var j: i64 = 0
    while j < n - 1 {
        let sx0 = coord_map_x(cs, xs[j as usize])
        let sy0 = coord_map_y(cs, vals[j as usize])
        let sx1 = coord_map_x(cs, xs[(j + 1) as usize])
        let sy1 = coord_map_y(cs, vals[(j + 1) as usize])
        canvas_draw_line_aa(c, sx0, sy0, sx1, sy1, r, g, b)
        j = j + 1
    }
}

// ============================================================
// Epistemic series — convenience wrapper for Epistemic arrays
// ============================================================

pub fn epiviz_knowledge_series(
    cs: &CoordSystem,
    xs: &[f64; 1024],
    ks: &[Epistemic; 1024],
    n: i64,
    c: &!Canvas,
    r: i64, g: i64, b: i64,
) with Mut, Div {
    // Unpack vals + vars into local arrays
    var vals: [f64; 1024] = [0.0; 1024]
    var vars: [f64; 1024] = [0.0; 1024]
    var i: i64 = 0
    while i < n {
        vals[i as usize] = ks[i as usize].val
        vars[i as usize] = ks[i as usize].variance
        i = i + 1
    }
    epiviz_band(cs, xs, &vals, &vars, n, c, r, g, b)
}

// ============================================================
// Confidence waterfall — bar per operation showing decay
// ============================================================
//
// confidences[i] in [0, 1000]; labels[i][0..8] is an 8-char tag.
// Draws horizontal bars ranked by index, colored by confidence:
//   high (≥900) → green, mid (≥600) → yellow, low → red.

fn epiviz_conf_color_r(conf: i64) -> i64 {
    if conf >= 900 { 80 }
    else if conf >= 600 { 255 }
    else { 220 }
}

fn epiviz_conf_color_g(conf: i64) -> i64 {
    if conf >= 900 { 220 }
    else if conf >= 600 { 200 }
    else { 60 }
}

fn epiviz_conf_color_b(conf: i64) -> i64 {
    if conf >= 900 { 80 } else { 40 }
}

pub fn epiviz_waterfall(
    cs: &CoordSystem,
    confidences: &[i64; 64],
    n: i64,
    c: &!Canvas,
) with Mut, Div {
    if n == 0 { return }
    let bar_h = epiviz_clamp(cs.screen_h / n - 2, 4, 30)
    var i: i64 = 0
    while i < n {
        let conf = confidences[i as usize]
        let bar_w = epiviz_clamp((conf * cs.screen_w) / 1000, 2, cs.screen_w)
        let py = cs.screen_y + i * (bar_h + 2)
        let cr = epiviz_conf_color_r(conf)
        let cg = epiviz_conf_color_g(conf)
        let cb = epiviz_conf_color_b(conf)
        canvas_fill_rect(c, cs.screen_x, py, bar_w, bar_h, cr, cg, cb)
        // dim border
        canvas_fill_rect(c, cs.screen_x + bar_w, py, cs.screen_w - bar_w, bar_h, 40, 40, 50)
        i = i + 1
    }
}

// ============================================================
// Forest plot — per-study estimates + pooled result
// ============================================================
//
// studies: array of Epistemic (val ± σ per study)
// pooled:  the meta-analysis pooled Epistemic
// Draws horizontal error bars and a diamond for the pooled result.

pub fn epiviz_forest(
    cs: &CoordSystem,
    studies: &[Epistemic; 64],
    n: i64,
    pooled: Epistemic,
    c: &!Canvas,
) with Mut, Div {
    if n == 0 { return }
    let row_h = epiviz_clamp(cs.screen_h / (n + 2), 6, 20)

    // Center of X axis = pooled.val, so scale by max sigma across studies
    var max_sigma: f64 = 0.0
    var i: i64 = 0
    while i < n {
        let s = epiviz_sqrt(studies[i as usize].variance)
        if s > max_sigma { max_sigma = s }
        i = i + 1
    }
    let x_span = if max_sigma > 0.0 { max_sigma * 4.0 } else { 1.0 }
    let x_lo = pooled.val - x_span * 0.5
    let x_hi = pooled.val + x_span * 0.5

    // Per-study rows
    var j: i64 = 0
    while j < n {
        let est = studies[j as usize].val
        let sigma = epiviz_sqrt(studies[j as usize].variance)
        let conf  = studies[j as usize].confidence

        let row_y = cs.screen_y + j * (row_h + 2) + row_h / 2
        let sx_est = cs.screen_x + (((est - x_lo) / (x_hi - x_lo)) * (cs.screen_w as f64)) as i64
        let sx_lo  = cs.screen_x + ((((est - sigma) - x_lo) / (x_hi - x_lo)) * (cs.screen_w as f64)) as i64
        let sx_hi  = cs.screen_x + ((((est + sigma) - x_lo) / (x_hi - x_lo)) * (cs.screen_w as f64)) as i64

        // Error bar line
        canvas_fill_rect(c, sx_lo, row_y, sx_hi - sx_lo + 1, 1, 180, 180, 220)
        // Cap lines
        canvas_fill_rect(c, sx_lo, row_y - 2, 1, 5, 180, 180, 220)
        canvas_fill_rect(c, sx_hi, row_y - 2, 1, 5, 180, 180, 220)
        // Center marker (confidence-colored)
        let mr = if conf >= 900 { 80 } else if conf >= 600 { 200 } else { 220 }
        let mg = if conf >= 900 { 200 } else if conf >= 600 { 180 } else { 80 }
        let mb = if conf >= 900 { 80 } else { 40 }
        canvas_fill_rect(c, sx_est - 3, row_y - 3, 7, 7, mr, mg, mb)

        j = j + 1
    }

    // Pooled diamond
    let pooled_y  = cs.screen_y + n * (row_h + 2) + row_h + row_h / 2
    let pooled_sigma = epiviz_sqrt(pooled.variance)
    let sx_p  = cs.screen_x + (((pooled.val - x_lo) / (x_hi - x_lo)) * (cs.screen_w as f64)) as i64
    let sx_pl = cs.screen_x + ((((pooled.val - pooled_sigma) - x_lo) / (x_hi - x_lo)) * (cs.screen_w as f64)) as i64
    let sx_pr = cs.screen_x + ((((pooled.val + pooled_sigma) - x_lo) / (x_hi - x_lo)) * (cs.screen_w as f64)) as i64
    // Draw diamond as 4 lines
    canvas_draw_line_aa(c, sx_pl, pooled_y, sx_p, pooled_y - 6, 255, 220, 80)
    canvas_draw_line_aa(c, sx_p, pooled_y - 6, sx_pr, pooled_y, 255, 220, 80)
    canvas_draw_line_aa(c, sx_pr, pooled_y, sx_p, pooled_y + 6, 255, 220, 80)
    canvas_draw_line_aa(c, sx_p, pooled_y + 6, sx_pl, pooled_y, 255, 220, 80)
}

// ============================================================
// Violin / KDE plot — posterior distribution as half-violin
// ============================================================
//
// Renders a half-violin (right-side only) at a given data-space Y centre.
// Uses Gaussian KDE with Silverman bandwidth: h = 0.9 * σ * n^(-1/5).
// 64 evaluation points; max half-width = 35 px.
// n ≤ 256 data points.

fn epiviz_exp_neg(x: f64) -> f64 with Mut, Div {
    // exp(-x) for x >= 0 via Taylor series on fractional part × e^(-1)^ipart
    if x <= 0.0 { return 1.0 }
    if x > 10.0 { return 0.0 }
    let e1: f64 = 0.36787944117
    let ipart = x as i64
    let frac = x - (ipart as f64)
    var r: f64 = 1.0
    var term: f64 = 1.0
    var k: i64 = 1
    while k <= 12 {
        term = 0.0 - term * frac / (k as f64)
        r = r + term
        k = k + 1
    }
    if r < 0.0 { r = 0.0 }
    var em: i64 = 0
    while em < ipart {
        r = r * e1
        em = em + 1
    }
    r
}

fn epiviz_fifth_root(n: i64) -> f64 with Mut, Div {
    // Compute n^(1/5) via Newton: y ← (4y + n/y^4) / 5
    if n <= 1 { return 1.0 }
    var y: f64 = 2.0
    var i: i64 = 0
    while i < 20 {
        let y4 = y * y * y * y
        y = (4.0 * y + (n as f64) / y4) / 5.0
        i = i + 1
    }
    y
}

pub fn epiviz_violin(
    cs: &CoordSystem,
    data: &[f64; 256],
    n: i64,
    label_y: f64,
    c: &!Canvas,
    r: i64, g: i64, b: i64,
) with Mut, Div {
    if n < 3 { return }

    // Mean and σ for Silverman bandwidth
    var dsum: f64 = 0.0
    var vi: i64 = 0
    while vi < n {
        dsum = dsum + data[vi as usize]
        vi = vi + 1
    }
    let dmean = dsum / (n as f64)
    var var_acc: f64 = 0.0
    var vj: i64 = 0
    while vj < n {
        let d = data[vj as usize] - dmean
        var_acc = var_acc + d * d
        vj = vj + 1
    }
    let sigma = epiviz_sqrt(var_acc / (n as f64))
    if sigma <= 0.0 { return }

    // Silverman h = 0.9 * σ * n^(-1/5)
    let h = 0.9 * sigma / epiviz_fifth_root(n)
    if h <= 0.0 { return }

    // Display range: mean ± 3.5σ
    let x_lo = dmean - 3.5 * sigma
    let x_hi = dmean + 3.5 * sigma
    if x_hi <= x_lo { return }

    // Evaluate KDE at 64 points; Gaussian kernel K(u) = exp(-u²/2)
    let n_eval: i64 = 64
    var densities: [f64; 64] = [0.0; 64]
    var max_dens: f64 = 0.001
    var ei: i64 = 0
    while ei < n_eval {
        let x = x_lo + (x_hi - x_lo) * (ei as f64) / ((n_eval - 1) as f64)
        var kde_sum: f64 = 0.0
        var ki: i64 = 0
        while ki < n {
            let u = (x - data[ki as usize]) / h
            let u2 = u * u
            if u2 < 9.0 {
                kde_sum = kde_sum + epiviz_exp_neg(u2 * 0.5)
            }
            ki = ki + 1
        }
        densities[ei as usize] = kde_sum
        if kde_sum > max_dens { max_dens = kde_sum }
        ei = ei + 1
    }

    let center_sy = coord_map_y(cs, label_y)
    let max_hw: i64 = 35

    // Fill half-violin (spans from center_sy outward in screen-Y)
    var pi: i64 = 0
    while pi < n_eval - 1 {
        let t0 = (pi as f64) / ((n_eval - 1) as f64)
        let t1 = ((pi + 1) as f64) / ((n_eval - 1) as f64)
        let sx0 = coord_map_x(cs, x_lo + (x_hi - x_lo) * t0)
        let sx1 = coord_map_x(cs, x_lo + (x_hi - x_lo) * t1)
        if sx1 <= sx0 {
            pi = pi + 1
            continue
        }
        let hw0 = (densities[pi as usize] / max_dens * (max_hw as f64)) as i64
        let hw1 = (densities[(pi + 1) as usize] / max_dens * (max_hw as f64)) as i64
        let span = sx1 - sx0
        var px = sx0
        while px <= sx1 {
            let t = if span > 0 { ((px - sx0) as f64) / (span as f64) } else { 0.0 }
            let hw = (hw0 as f64 * (1.0 - t) + hw1 as f64 * t) as i64
            var dy: i64 = 0
            while dy <= hw {
                canvas_blend_pixel(c, px, center_sy - dy, r, g, b, 120)
                canvas_blend_pixel(c, px, center_sy + dy, r, g, b, 120)
                dy = dy + 1
            }
            px = px + 1
        }
        pi = pi + 1
    }
    // Baseline at label_y
    let sx_lo = coord_map_x(cs, x_lo)
    let sx_hi = coord_map_x(cs, x_hi)
    canvas_draw_line_aa(c, sx_lo, center_sy, sx_hi, center_sy, r, g, b)
}
