// stdlib/viz/viz_replay.sio - deterministic event replay over VizApp + Visual IR

use display::canvas::{Canvas, canvas_clear}
use display::event::{Event}
use viz::ir::{VizScene, viz_scene_dump}
use viz::viz_app::{VizApp, viz_app_handle_event, viz_app_frame_hash}
use viz::viz_canvas::{viz_canvas_render_scene}

pub fn viz_replay_present(app: &!VizApp, scene: &!VizScene, c: &!Canvas) -> i64 with Mut, Div, Alloc {
    canvas_clear(c, app.bg_r, app.bg_g, app.bg_b)
    viz_canvas_render_scene(scene, c)
    app.frame = app.frame + 1
    app.dirty = false
    viz_app_frame_hash(app, scene, c)
}

pub fn viz_replay_events(app: &!VizApp, scene: &!VizScene, c: &!Canvas, events: &[Event; 32], count: i64) -> i64 with Mut, Div, Alloc {
    var i: i64 = 0
    var last_hash: i64 = viz_replay_present(app, scene, c)
    while i < count && i < 32 {
        viz_app_handle_event(app, scene, events[i as usize])
        last_hash = viz_replay_present(app, scene, c)
        i = i + 1
    }
    last_hash
}

pub fn viz_replay_dump(scene: &VizScene) with IO, Mut, Div {
    viz_scene_dump(scene)
}
