//! Basic Search Algorithms
//!
//! Fundamental search algorithms for sorted and unsorted sequences.
//!
//! # Algorithms
//! - `linear_search` - O(n) search in unsorted data
//! - `binary_search` - O(log n) search in sorted data
//! - `lower_bound` - First element >= target
//! - `upper_bound` - First element > target
//! - `equal_range` - Range of elements equal to target
//!
//! # Examples
//! ```sio
//! let arr = [1, 3, 5, 7, 9]
//! match binary_search_i64(&arr, 5, 5) {
//!     Some(idx) => print("Found at index " ++ idx.to_string()),
//!     None => print("Not found"),
//! }
//! ```

// =============================================================================
// Linear Search
// =============================================================================

// Searches for target in an unsorted slice, returning the first matching index.
//
// Time complexity: O(n)
// Space complexity: O(1)
pub fn linear_search_i64(arr: &[i64], len: usize, target: i64) -> Option<usize> {
    var i: usize = 0
    while i < len {
        if arr[i] == target {
            return Some(i)
        }
        i = i + 1
    }
    None
}

// Searches for target in an unsorted slice of f64.
pub fn linear_search_f64(arr: &[f64], len: usize, target: f64, epsilon: f64) -> Option<usize> {
    var i: usize = 0
    while i < len {
        let diff = arr[i] - target
        if diff < epsilon && diff > -epsilon {
            return Some(i)
        }
        i = i + 1
    }
    None
}

// Searches for target using a comparison function.
//
// Returns the index of the first element where cmp(element) returns true.
pub fn linear_search_by<T>(
    arr: &[T],
    len: usize,
    predicate: fn(&T) -> bool
) -> Option<usize> {
    var i: usize = 0
    while i < len {
        if predicate(&arr[i]) {
            return Some(i)
        }
        i = i + 1
    }
    None
}

// =============================================================================
// Binary Search
// =============================================================================

// Binary search for target in a sorted slice.
//
// Returns the index if found, None otherwise.
// Time complexity: O(log n)
// Space complexity: O(1)
//
// # Precondition
// The slice must be sorted in ascending order.
pub fn binary_search_i64(arr: &[i64], len: usize, target: i64) -> Option<usize> {
    if len == 0 {
        return None
    }

    var left: usize = 0
    var right: usize = len

    while left < right {
        let mid = left + (right - left) / 2

        if arr[mid] == target {
            return Some(mid)
        } else if arr[mid] < target {
            left = mid + 1
        } else {
            right = mid
        }
    }

    None
}

// Binary search for target in a sorted slice of f64.
//
// Uses epsilon for floating-point comparison.
pub fn binary_search_f64(arr: &[f64], len: usize, target: f64, epsilon: f64) -> Option<usize> {
    if len == 0 {
        return None
    }

    var left: usize = 0
    var right: usize = len

    while left < right {
        let mid = left + (right - left) / 2
        let diff = arr[mid] - target

        if diff < epsilon && diff > -epsilon {
            return Some(mid)
        } else if arr[mid] < target {
            left = mid + 1
        } else {
            right = mid
        }
    }

    None
}

// Binary search using a comparison function.
//
// The comparison function should return:
// - Ordering::Less if element < target
// - Ordering::Equal if element == target
// - Ordering::Greater if element > target
pub fn binary_search_by<T>(
    arr: &[T],
    len: usize,
    cmp: fn(&T) -> Ordering
) -> Option<usize> {
    if len == 0 {
        return None
    }

    var left: usize = 0
    var right: usize = len

    while left < right {
        let mid = left + (right - left) / 2

        match cmp(&arr[mid]) {
            Ordering::Equal => return Some(mid),
            Ordering::Less => left = mid + 1,
            Ordering::Greater => right = mid,
        }
    }

    None
}

// =============================================================================
// Lower Bound / Upper Bound
// =============================================================================

// Returns the index of the first element >= target.
//
// If all elements are less than target, returns len.
// Time complexity: O(log n)
pub fn lower_bound_i64(arr: &[i64], len: usize, target: i64) -> usize {
    var left: usize = 0
    var right: usize = len

    while left < right {
        let mid = left + (right - left) / 2

        if arr[mid] < target {
            left = mid + 1
        } else {
            right = mid
        }
    }

    left
}

// Returns the index of the first element > target.
//
// If all elements are <= target, returns len.
// Time complexity: O(log n)
pub fn upper_bound_i64(arr: &[i64], len: usize, target: i64) -> usize {
    var left: usize = 0
    var right: usize = len

    while left < right {
        let mid = left + (right - left) / 2

        if arr[mid] <= target {
            left = mid + 1
        } else {
            right = mid
        }
    }

    left
}

// Returns the index of the first element >= target for f64.
pub fn lower_bound_f64(arr: &[f64], len: usize, target: f64) -> usize {
    var left: usize = 0
    var right: usize = len

    while left < right {
        let mid = left + (right - left) / 2

        if arr[mid] < target {
            left = mid + 1
        } else {
            right = mid
        }
    }

    left
}

// Returns the index of the first element > target for f64.
pub fn upper_bound_f64(arr: &[f64], len: usize, target: f64) -> usize {
    var left: usize = 0
    var right: usize = len

    while left < right {
        let mid = left + (right - left) / 2

        if arr[mid] <= target {
            left = mid + 1
        } else {
            right = mid
        }
    }

    left
}

// =============================================================================
// Equal Range
// =============================================================================

// Range of indices for elements equal to target.
pub struct EqualRange {
    start: usize,
    end: usize,
}

impl EqualRange {
    // Returns the number of elements in the range.
    pub fn count(self: &EqualRange) -> usize {
        self.end - self.start
    }
    // Returns true if the range is empty.
    pub fn is_empty(self: &EqualRange) -> bool {
        self.start >= self.end
    }
}

// Returns the range [lower_bound, upper_bound) of elements equal to target.
//
// Time complexity: O(log n)
pub fn equal_range_i64(arr: &[i64], len: usize, target: i64) -> EqualRange {
    EqualRange {
        start: lower_bound_i64(arr, len, target),
        end: upper_bound_i64(arr, len, target),
    }
}

// Returns the count of elements equal to target.
pub fn count_equal_i64(arr: &[i64], len: usize, target: i64) -> usize {
    let range = equal_range_i64(arr, len, target)
    range.count()
}

// =============================================================================
// Contains
// =============================================================================

// Returns true if the sorted slice contains the target.
pub fn contains_sorted_i64(arr: &[i64], len: usize, target: i64) -> bool {
    match binary_search_i64(arr, len, target) {
        Some(_) => true,
        None => false,
    }
}

// Returns true if the unsorted slice contains the target.
pub fn contains_i64(arr: &[i64], len: usize, target: i64) -> bool {
    match linear_search_i64(arr, len, target) {
        Some(_) => true,
        None => false,
    }
}

// =============================================================================
// Ordering enum (if not already defined elsewhere)
// =============================================================================

// Result of comparing two values.
pub enum Ordering {
    Less,
    Equal,
    Greater,
}

// =============================================================================
// Exponential Search
// =============================================================================

// Exponential search for unbounded or very large sorted arrays.
//
// Useful when the target is expected to be near the beginning.
// Time complexity: O(log n) where n is the position of the target.
pub fn exponential_search_i64(arr: &[i64], len: usize, target: i64) -> Option<usize> {
    if len == 0 {
        return None
    }

    // Check first element
    if arr[0] == target {
        return Some(0)
    }

    // Find range for binary search by repeated doubling
    var bound: usize = 1
    while bound < len && arr[bound] < target {
        bound = bound * 2
    }

    // Binary search in the found range
    let left = bound / 2
    let right = if bound < len { bound + 1 } else { len }

    // Perform binary search in [left, right)
    var lo = left
    var hi = right

    while lo < hi {
        let mid = lo + (hi - lo) / 2

        if arr[mid] == target {
            return Some(mid)
        } else if arr[mid] < target {
            lo = mid + 1
        } else {
            hi = mid
        }
    }

    None
}

// =============================================================================
// Interpolation Search
// =============================================================================

// Interpolation search for uniformly distributed sorted data.
//
// Time complexity: O(log log n) for uniform data, O(n) worst case.
//
// Best suited for large arrays with uniformly distributed numeric values.
pub fn interpolation_search_i64(arr: &[i64], len: usize, target: i64) -> Option<usize> {
    if len == 0 {
        return None
    }

    var lo: usize = 0
    var hi: usize = len - 1

    while lo <= hi && target >= arr[lo] && target <= arr[hi] {
        if lo == hi {
            if arr[lo] == target {
                return Some(lo)
            }
            return None
        }

        // Interpolation formula
        let range = arr[hi] - arr[lo]
        if range == 0 {
            // All elements are equal
            if arr[lo] == target {
                return Some(lo)
            }
            return None
        }

        let pos_f64 = (lo as f64) + (((target - arr[lo]) as f64) * ((hi - lo) as f64) / (range as f64))
        let pos = pos_f64 as usize

        // Clamp to valid range
        let pos = if pos < lo { lo } else if pos > hi { hi } else { pos }

        if arr[pos] == target {
            return Some(pos)
        } else if arr[pos] < target {
            lo = pos + 1
        } else {
            if pos == 0 {
                return None
            }
            hi = pos - 1
        }
    }

    None
}

// =============================================================================
// Index of Minimum/Maximum
// =============================================================================

// Returns the index of the minimum element.
//
// Returns None if the slice is empty.
pub fn index_of_min_i64(arr: &[i64], len: usize) -> Option<usize> {
    if len == 0 {
        return None
    }

    var min_idx: usize = 0
    var i: usize = 1
    while i < len {
        if arr[i] < arr[min_idx] {
            min_idx = i
        }
        i = i + 1
    }

    Some(min_idx)
}

// Returns the index of the maximum element.
//
// Returns None if the slice is empty.
pub fn index_of_max_i64(arr: &[i64], len: usize) -> Option<usize> {
    if len == 0 {
        return None
    }

    var max_idx: usize = 0
    var i: usize = 1
    while i < len {
        if arr[i] > arr[max_idx] {
            max_idx = i
        }
        i = i + 1
    }

    Some(max_idx)
}

// Returns indices of both minimum and maximum in a single pass.
pub fn index_of_minmax_i64(arr: &[i64], len: usize) -> Option<(usize, usize)> {
    if len == 0 {
        return None
    }

    var min_idx: usize = 0
    var max_idx: usize = 0
    var i: usize = 1
    while i < len {
        if arr[i] < arr[min_idx] {
            min_idx = i
        }
        if arr[i] > arr[max_idx] {
            max_idx = i
        }
        i = i + 1
    }

    Some((min_idx, max_idx))
}

// =============================================================================
// Tests
// =============================================================================

fn test_linear_search() -> bool {
    let arr: [i64; 5] = [3, 1, 4, 1, 5]

    match linear_search_i64(&arr, 5, 4) {
        Some(2) => {},
        _ => return false,
    }

    match linear_search_i64(&arr, 5, 1) {
        Some(1) => {},  // First occurrence
        _ => return false,
    }

    match linear_search_i64(&arr, 5, 9) {
        None => {},
        _ => return false,
    }

    true
}

fn test_binary_search() -> bool {
    let arr: [i64; 5] = [1, 3, 5, 7, 9]

    match binary_search_i64(&arr, 5, 5) {
        Some(2) => {},
        _ => return false,
    }

    match binary_search_i64(&arr, 5, 1) {
        Some(0) => {},
        _ => return false,
    }

    match binary_search_i64(&arr, 5, 9) {
        Some(4) => {},
        _ => return false,
    }

    match binary_search_i64(&arr, 5, 4) {
        None => {},
        _ => return false,
    }

    true
}

fn test_bounds() -> bool {
    let arr: [i64; 7] = [1, 2, 2, 2, 3, 4, 5]

    // lower_bound: first element >= 2
    if lower_bound_i64(&arr, 7, 2) != 1 { return false }

    // upper_bound: first element > 2
    if upper_bound_i64(&arr, 7, 2) != 4 { return false }

    // equal_range for 2
    let range = equal_range_i64(&arr, 7, 2)
    if range.start != 1 { return false }
    if range.end != 4 { return false }
    if range.count() != 3 { return false }

    true
}

fn test_minmax() -> bool {
    let arr: [i64; 5] = [3, 1, 4, 1, 5]

    match index_of_min_i64(&arr, 5) {
        Some(1) => {},  // First occurrence of min
        _ => return false,
    }

    match index_of_max_i64(&arr, 5) {
        Some(4) => {},
        _ => return false,
    }

    true
}

pub fn run_tests() -> bool {
    test_linear_search() &&
    test_binary_search() &&
    test_bounds() &&
    test_minmax()
}
