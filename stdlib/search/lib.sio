//! stdlib/search/lib.sio - Search Algorithms
//!
//! This module provides various search algorithms:
//!
//! - `basic` - Linear search, binary search, bounds
//! - `pattern` - String pattern matching (KMP, Boyer-Moore, edit distance)
//! - `mcts` - Monte Carlo Tree Search for game AI and optimization
//!
//! # Examples
//! ```sio
//! // Binary search
//! let arr = [1, 3, 5, 7, 9]
//! match binary_search_i64(&arr, 5, 5) {
//!     Some(idx) => print("Found at " ++ idx.to_string()),
//!     None => print("Not found"),
//! }
//!
//! // Pattern matching
//! let text = "hello world".as_bytes()
//! let pattern = "world".as_bytes()
//! match kmp_search(&text, 11, &pattern, 5) {
//!     Some(idx) => print("Pattern at " ++ idx.to_string()),
//!     None => print("Pattern not found"),
//! }
//! ```


// Submodules are resolved by path (`use search::<name>`);
// Sounio has no `mod` item, so the declarations that stood here were
// inert Rust syntax that also stopped this file parsing. Covered:
//   basic, pattern, mcts
