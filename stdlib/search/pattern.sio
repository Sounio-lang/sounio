//! String Pattern Matching Algorithms
//!
//! Efficient algorithms for finding patterns within text.
//!
//! # Algorithms
//! - `kmp_search` - Knuth-Morris-Pratt algorithm, O(n+m)
//! - `boyer_moore_search` - Boyer-Moore algorithm, O(n/m) best case
//! - `rabin_karp_search` - Rabin-Karp with rolling hash
//! - `edit_distance` - Levenshtein distance for fuzzy matching
//!
//! # Examples
//! ```sio
//! let text = "hello world"
//! let pattern = "world"
//! match kmp_search(text, pattern) {
//!     Some(idx) => print("Found at index " ++ idx.to_string()),
//!     None => print("Not found"),
//! }
//! ```

// =============================================================================
// Knuth-Morris-Pratt (KMP) Algorithm
// =============================================================================

/// KMP failure function (also called partial match table).
///
/// failure[i] = length of longest proper prefix of pattern[0..i]
/// that is also a suffix.
pub fn kmp_failure_function(pattern: &[u8], pattern_len: usize) -> Vec<usize> with Alloc {
    var failure = Vec::with_capacity(pattern_len)

    // Initialize with zeros
    var i: usize = 0
    while i < pattern_len {
        failure.push(0)
        i = i + 1
    }

    if pattern_len == 0 {
        return failure
    }

    var k: usize = 0  // Length of previous longest prefix suffix
    var j: usize = 1

    while j < pattern_len {
        if pattern[j] == pattern[k] {
            k = k + 1
            failure[j] = k
            j = j + 1
        } else {
            if k != 0 {
                k = failure[k - 1]
            } else {
                failure[j] = 0
                j = j + 1
            }
        }
    }

    failure
}

/// Searches for pattern in text using the KMP algorithm.
///
/// Returns the index of the first occurrence, or None if not found.
/// Time complexity: O(n + m) where n = text length, m = pattern length.
/// Space complexity: O(m) for the failure function.
pub fn kmp_search(text: &[u8], text_len: usize, pattern: &[u8], pattern_len: usize) -> Option<usize> with Alloc {
    if pattern_len == 0 {
        return Some(0)
    }

    if text_len < pattern_len {
        return None
    }

    let failure = kmp_failure_function(pattern, pattern_len)

    var i: usize = 0  // Index in text
    var j: usize = 0  // Index in pattern

    while i < text_len {
        if text[i] == pattern[j] {
            i = i + 1
            j = j + 1

            if j == pattern_len {
                // Found a match
                return Some(i - pattern_len)
            }
        } else {
            if j != 0 {
                j = failure[j - 1]
            } else {
                i = i + 1
            }
        }
    }

    None
}

/// Finds all occurrences of pattern in text using KMP.
///
/// Returns a vector of starting indices.
pub fn kmp_search_all(text: &[u8], text_len: usize, pattern: &[u8], pattern_len: usize) -> Vec<usize> with Alloc {
    var matches = Vec::new()

    if pattern_len == 0 || text_len < pattern_len {
        return matches
    }

    let failure = kmp_failure_function(pattern, pattern_len)

    var i: usize = 0
    var j: usize = 0

    while i < text_len {
        if text[i] == pattern[j] {
            i = i + 1
            j = j + 1

            if j == pattern_len {
                matches.push(i - pattern_len)
                j = failure[j - 1]
            }
        } else {
            if j != 0 {
                j = failure[j - 1]
            } else {
                i = i + 1
            }
        }
    }

    matches
}

// =============================================================================
// Boyer-Moore Algorithm (Simplified: Bad Character Rule Only)
// =============================================================================

/// Bad character table for Boyer-Moore.
///
/// For each character, stores the rightmost position in the pattern.
fn boyer_moore_bad_char_table(pattern: &[u8], pattern_len: usize) -> [i64; 256] {
    var table: [i64; 256] = [-1; 256]

    var i: usize = 0
    while i < pattern_len {
        let c = pattern[i] as usize
        table[c] = i as i64
        i = i + 1
    }

    table
}

/// Searches for pattern in text using Boyer-Moore algorithm.
///
/// Uses the bad character rule for simplicity.
/// Time complexity: O(n/m) best case, O(nm) worst case.
pub fn boyer_moore_search(text: &[u8], text_len: usize, pattern: &[u8], pattern_len: usize) -> Option<usize> {
    if pattern_len == 0 {
        return Some(0)
    }

    if text_len < pattern_len {
        return None
    }

    let bad_char = boyer_moore_bad_char_table(pattern, pattern_len)

    var shift: usize = 0

    while shift <= text_len - pattern_len {
        var j = (pattern_len - 1) as i64

        // Match pattern from right to left
        while j >= 0 && pattern[j as usize] == text[shift + (j as usize)] {
            j = j - 1
        }

        if j < 0 {
            // Found a match
            return Some(shift)
        } else {
            // Calculate shift using bad character rule
            let bad_char_shift = j - bad_char[text[shift + (j as usize)] as usize]
            let actual_shift = if bad_char_shift > 1 { bad_char_shift as usize } else { 1 }
            shift = shift + actual_shift
        }
    }

    None
}

/// Finds all occurrences using Boyer-Moore.
pub fn boyer_moore_search_all(text: &[u8], text_len: usize, pattern: &[u8], pattern_len: usize) -> Vec<usize> with Alloc {
    var matches = Vec::new()

    if pattern_len == 0 || text_len < pattern_len {
        return matches
    }

    let bad_char = boyer_moore_bad_char_table(pattern, pattern_len)

    var shift: usize = 0

    while shift <= text_len - pattern_len {
        var j = (pattern_len - 1) as i64

        while j >= 0 && pattern[j as usize] == text[shift + (j as usize)] {
            j = j - 1
        }

        if j < 0 {
            matches.push(shift)
            // Shift by 1 to find overlapping matches
            shift = shift + 1
        } else {
            let bad_char_shift = j - bad_char[text[shift + (j as usize)] as usize]
            let actual_shift = if bad_char_shift > 1 { bad_char_shift as usize } else { 1 }
            shift = shift + actual_shift
        }
    }

    matches
}

// =============================================================================
// Rabin-Karp Algorithm
// =============================================================================

// Prime for hash computation
const RABIN_KARP_PRIME: u64 = 1000000007
const RABIN_KARP_BASE: u64 = 256

/// Searches for pattern in text using Rabin-Karp rolling hash.
///
/// Good for multiple pattern matching.
/// Time complexity: O(n + m) expected, O(nm) worst case.
pub fn rabin_karp_search(text: &[u8], text_len: usize, pattern: &[u8], pattern_len: usize) -> Option<usize> {
    if pattern_len == 0 {
        return Some(0)
    }

    if text_len < pattern_len {
        return None
    }

    // Compute hash of pattern and first window of text
    var pattern_hash: u64 = 0
    var text_hash: u64 = 0
    var h: u64 = 1  // h = BASE^(pattern_len-1) mod PRIME

    // Compute h
    var i: usize = 0
    while i < pattern_len - 1 {
        h = (h * RABIN_KARP_BASE) % RABIN_KARP_PRIME
        i = i + 1
    }

    // Compute initial hashes
    i = 0
    while i < pattern_len {
        pattern_hash = (RABIN_KARP_BASE * pattern_hash + (pattern[i] as u64)) % RABIN_KARP_PRIME
        text_hash = (RABIN_KARP_BASE * text_hash + (text[i] as u64)) % RABIN_KARP_PRIME
        i = i + 1
    }

    // Slide the pattern over text
    i = 0
    while i <= text_len - pattern_len {
        // If hashes match, verify character by character
        if pattern_hash == text_hash {
            var match_found = true
            var j: usize = 0
            while j < pattern_len {
                if text[i + j] != pattern[j] {
                    match_found = false
                    break
                }
                j = j + 1
            }

            if match_found {
                return Some(i)
            }
        }

        // Compute hash for next window
        if i < text_len - pattern_len {
            // Remove leading digit, add trailing digit
            text_hash = (RABIN_KARP_BASE * (text_hash + RABIN_KARP_PRIME - (h * (text[i] as u64)) % RABIN_KARP_PRIME)
                         + (text[i + pattern_len] as u64)) % RABIN_KARP_PRIME
        }

        i = i + 1
    }

    None
}

// =============================================================================
// Edit Distance (Levenshtein Distance)
// =============================================================================

/// Computes the Levenshtein (edit) distance between two byte sequences.
///
/// The edit distance is the minimum number of single-character edits
/// (insertions, deletions, or substitutions) required to change one
/// string into the other.
///
/// Time complexity: O(nm) where n and m are the lengths of the strings.
/// Space complexity: O(min(n, m)) using two-row optimization.
pub fn edit_distance(s1: &[u8], len1: usize, s2: &[u8], len2: usize) -> usize with Alloc {
    // Ensure s1 is the shorter string for space optimization
    if len1 > len2 {
        return edit_distance(s2, len2, s1, len1)
    }

    if len1 == 0 {
        return len2
    }

    // Two-row optimization: only need previous and current row
    var prev = Vec::with_capacity(len1 + 1)
    var curr = Vec::with_capacity(len1 + 1)

    // Initialize first row
    var i: usize = 0
    while i <= len1 {
        prev.push(i)
        curr.push(0)
        i = i + 1
    }

    // Fill in the rest of the matrix
    var j: usize = 1
    while j <= len2 {
        curr[0] = j

        i = 1
        while i <= len1 {
            let cost = if s1[i - 1] == s2[j - 1] { 0 } else { 1 }

            let delete = prev[i] + 1
            let insert = curr[i - 1] + 1
            let substitute = prev[i - 1] + cost

            curr[i] = min3(delete, insert, substitute)
            i = i + 1
        }

        // Swap rows
        var temp = prev
        prev = curr
        curr = temp

        j = j + 1
    }

    prev[len1]
}

/// Helper function: minimum of three values.
fn min3(a: usize, b: usize, c: usize) -> usize {
    let min_ab = if a < b { a } else { b }
    if min_ab < c { min_ab } else { c }
}

/// Computes normalized edit distance (0.0 to 1.0).
///
/// Returns 0.0 for identical strings, 1.0 for completely different strings.
pub fn normalized_edit_distance(s1: &[u8], len1: usize, s2: &[u8], len2: usize) -> f64 with Alloc {
    let max_len = if len1 > len2 { len1 } else { len2 }

    if max_len == 0 {
        return 0.0
    }

    let dist = edit_distance(s1, len1, s2, len2)
    (dist as f64) / (max_len as f64)
}

/// Computes similarity score (0.0 to 1.0).
///
/// Returns 1.0 for identical strings, 0.0 for completely different strings.
pub fn similarity(s1: &[u8], len1: usize, s2: &[u8], len2: usize) -> f64 with Alloc {
    1.0 - normalized_edit_distance(s1, len1, s2, len2)
}

// =============================================================================
// Fuzzy Matching
// =============================================================================

/// Result of a fuzzy match.
pub struct FuzzyMatch {
    index: usize,
    distance: usize,
    score: f64,
}

impl FuzzyMatch {
    /// Returns the index in the candidates list.
    pub fn index(self: &FuzzyMatch) -> usize {
        self.index
    }

    /// Returns the edit distance.
    pub fn distance(self: &FuzzyMatch) -> usize {
        self.distance
    }

    /// Returns the similarity score (0.0 to 1.0).
    pub fn score(self: &FuzzyMatch) -> f64 {
        self.score
    }
}

/// Finds the best fuzzy match for query among candidates.
///
/// Returns None if no candidate is within the threshold.
pub fn fuzzy_match_best(
    query: &[u8],
    query_len: usize,
    candidates: &[&[u8]],
    candidate_lens: &[usize],
    num_candidates: usize,
    max_distance: usize
) -> Option<FuzzyMatch> with Alloc {
    var best: Option<FuzzyMatch> = None
    var best_distance = max_distance + 1

    var i: usize = 0
    while i < num_candidates {
        let dist = edit_distance(query, query_len, candidates[i], candidate_lens[i])

        if dist < best_distance {
            best_distance = dist
            let max_len = if query_len > candidate_lens[i] { query_len } else { candidate_lens[i] }
            let score = if max_len == 0 { 1.0 } else { 1.0 - (dist as f64) / (max_len as f64) }
            best = Some(FuzzyMatch { index: i, distance: dist, score })
        }

        i = i + 1
    }

    best
}

/// Finds all fuzzy matches within the threshold.
pub fn fuzzy_match_all(
    query: &[u8],
    query_len: usize,
    candidates: &[&[u8]],
    candidate_lens: &[usize],
    num_candidates: usize,
    max_distance: usize
) -> Vec<FuzzyMatch> with Alloc {
    var matches = Vec::new()

    var i: usize = 0
    while i < num_candidates {
        let dist = edit_distance(query, query_len, candidates[i], candidate_lens[i])

        if dist <= max_distance {
            let max_len = if query_len > candidate_lens[i] { query_len } else { candidate_lens[i] }
            let score = if max_len == 0 { 1.0 } else { 1.0 - (dist as f64) / (max_len as f64) }
            matches.push(FuzzyMatch { index: i, distance: dist, score })
        }

        i = i + 1
    }

    matches
}

// =============================================================================
// Longest Common Subsequence (LCS)
// =============================================================================

/// Computes the length of the longest common subsequence.
///
/// A subsequence is a sequence that can be derived by deleting some
/// or no elements without changing the order of remaining elements.
pub fn lcs_length(s1: &[u8], len1: usize, s2: &[u8], len2: usize) -> usize with Alloc {
    if len1 == 0 || len2 == 0 {
        return 0
    }

    // Two-row optimization
    var prev = Vec::with_capacity(len2 + 1)
    var curr = Vec::with_capacity(len2 + 1)

    var j: usize = 0
    while j <= len2 {
        prev.push(0)
        curr.push(0)
        j = j + 1
    }

    var i: usize = 1
    while i <= len1 {
        j = 1
        while j <= len2 {
            if s1[i - 1] == s2[j - 1] {
                curr[j] = prev[j - 1] + 1
            } else {
                curr[j] = if prev[j] > curr[j - 1] { prev[j] } else { curr[j - 1] }
            }
            j = j + 1
        }

        // Swap rows
        var temp = prev
        prev = curr
        curr = temp

        i = i + 1
    }

    prev[len2]
}

// =============================================================================
// Hamming Distance
// =============================================================================

/// Computes the Hamming distance between two equal-length byte sequences.
///
/// The Hamming distance is the number of positions at which the
/// corresponding bytes are different.
///
/// Returns None if the sequences have different lengths.
pub fn hamming_distance(s1: &[u8], s2: &[u8], len: usize) -> usize {
    var distance: usize = 0

    var i: usize = 0
    while i < len {
        if s1[i] != s2[i] {
            distance = distance + 1
        }
        i = i + 1
    }

    distance
}

// =============================================================================
// Tests
// =============================================================================

fn test_kmp() -> bool {
    let text: [u8; 11] = [104, 101, 108, 108, 111, 32, 119, 111, 114, 108, 100]  // "hello world"
    let pattern: [u8; 5] = [119, 111, 114, 108, 100]  // "world"

    match kmp_search(&text, 11, &pattern, 5) {
        Some(6) => {},
        _ => return false,
    }

    // Test pattern not found
    let missing: [u8; 3] = [120, 121, 122]  // "xyz"
    match kmp_search(&text, 11, &missing, 3) {
        None => {},
        _ => return false,
    }

    true
}

fn test_boyer_moore() -> bool {
    let text: [u8; 11] = [104, 101, 108, 108, 111, 32, 119, 111, 114, 108, 100]
    let pattern: [u8; 5] = [119, 111, 114, 108, 100]

    match boyer_moore_search(&text, 11, &pattern, 5) {
        Some(6) => {},
        _ => return false,
    }

    true
}

fn test_edit_distance() -> bool {
    let s1: [u8; 6] = [107, 105, 116, 116, 101, 110]  // "kitten"
    let s2: [u8; 7] = [115, 105, 116, 116, 105, 110, 103]  // "sitting"

    // kitten -> sitten (k->s) -> sittin (e->i) -> sitting (+g) = 3
    if edit_distance(&s1, 6, &s2, 7) != 3 { return false }

    // Same string should have distance 0
    if edit_distance(&s1, 6, &s1, 6) != 0 { return false }

    // Empty vs non-empty
    let empty: [u8; 0] = []
    if edit_distance(&empty, 0, &s1, 6) != 6 { return false }

    true
}

fn test_lcs() -> bool {
    let s1: [u8; 4] = [65, 66, 67, 68]  // "ABCD"
    let s2: [u8; 4] = [65, 67, 66, 68]  // "ACBD"

    // LCS is "ABD" or "ACD", length 3
    if lcs_length(&s1, 4, &s2, 4) != 3 { return false }

    true
}

fn test_hamming() -> bool {
    let s1: [u8; 4] = [1, 2, 3, 4]
    let s2: [u8; 4] = [1, 2, 5, 4]

    if hamming_distance(&s1, &s2, 4) != 1 { return false }

    true
}

pub fn run_tests() -> bool {
    test_kmp() &&
    test_boyer_moore() &&
    test_edit_distance() &&
    test_lcs() &&
    test_hamming()
}
