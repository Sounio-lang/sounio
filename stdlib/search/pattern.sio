fn test_hamming() -> bool with Panic, Div, Mut {
    let s1: [u8; 4] = [1, 2, 3, 4]
    let s2: [u8; 4] = [1, 2, 5, 4]

    if hamming_distance(&s1, &s2, 4) != 1 { return false }

    true
}

