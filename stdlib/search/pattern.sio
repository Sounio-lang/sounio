//! String Pattern Matching Algorithms
//!
//! Efficient algorithms for finding patterns within text.
//!
//! # Algorithms
//! - `kmp_search` - Knuth-Morris-Pratt algorithm, O(n+m)
//! - `boyer_moore_search` - Boyer-Moore algorithm, O(n/m) best case
//! - `rabin_karp_search` - Rabin-Karp with rolling hash
//! - `edit_distance` - Levenshtein distance for fuzzy matching
//!
//! # Examples
//! ```sio
//! let text = "hello world"
//! let pattern = "world"
//! match kmp_search(text, pattern) {
//!     Some(idx) => print("Found at index " ++ idx.to_string()),
//!     None => print("Not found"),
//! }
//! ```

// =============================================================================
// Knuth-Morris-Pratt (KMP) Algorithm
// =============================================================================

// KMP failure function (also called partial match table).
//
// failure[i] = length of longest proper prefix of pattern[0..i]
// that is also a suffix.
//
// Caller must provide failure array with length >= pattern_len.
pub fn kmp_failure_function(pattern: &[u8], pattern_len: usize, failure: &![usize]) with Panic, Div, Mut {
    // Initialize with zeros
    var i: usize = 0
    while i < pattern_len {
        failure[i] = 0
        i = i + 1
    }

    if pattern_len == 0 {
        return
    }

    var k: usize = 0  // Length of previous longest prefix suffix
    var j: usize = 1

    while j < pattern_len {
        if pattern[j] == pattern[k] {
            k = k + 1
            failure[j] = k
            j = j + 1
        } else {
            if k != 0 {
                k = failure[k - 1]
            } else {
                failure[j] = 0
                j = j + 1
            }
        }
    }
}

// Searches for pattern in text using the KMP algorithm.
//
// Returns the index of the first occurrence, or None if not found.
// Time complexity: O(n + m) where n = text length, m = pattern length.
// Space complexity: O(m) for the failure function.
//
// Caller must provide failure_buf array with length >= pattern_len.
pub fn kmp_search(text: &[u8], text_len: usize, pattern: &[u8], pattern_len: usize, failure_buf: &![usize]) -> Option<usize> with Panic, Div, Mut {
    if pattern_len == 0 {
        return Some(0)
    }

    if text_len < pattern_len {
        return None
    }

    kmp_failure_function(pattern, pattern_len, failure_buf)

    var i: usize = 0  // Index in text
    var j: usize = 0  // Index in pattern

    while i < text_len {
        if text[i] == pattern[j] {
            i = i + 1
            j = j + 1

            if j == pattern_len {
                // Found a match
                return Some(i - pattern_len)
            }
        } else {
            if j != 0 {
                j = failure_buf[j - 1]
            } else {
                i = i + 1
            }
        }
    }

    return None
}

// Finds all occurrences of pattern in text using KMP.
//
// Returns the number of matches found. Matches are written to matches_buf.
// Caller must provide:
//   - failure_buf: array with length >= pattern_len
//   - matches_buf: array to store match indices
//   - max_matches: maximum number of matches to find
pub fn kmp_search_all(text: &[u8], text_len: usize, pattern: &[u8], pattern_len: usize, failure_buf: &![usize], matches_buf: &![usize], max_matches: usize) -> usize with Panic, Div, Mut {
    if pattern_len == 0 || text_len < pattern_len {
        return 0
    }

    kmp_failure_function(pattern, pattern_len, failure_buf)

    var i: usize = 0
    var j: usize = 0
    var match_count: usize = 0

    while i < text_len {
        if text[i] == pattern[j] {
            i = i + 1
            j = j + 1

            if j == pattern_len {
                if match_count < max_matches {
                    matches_buf[match_count] = i - pattern_len
                    match_count = match_count + 1
                }
                j = failure_buf[j - 1]
            }
        } else {
            if j != 0 {
                j = failure_buf[j - 1]
            } else {
                i = i + 1
            }
        }
    }

    match_count
}

// =============================================================================
// Boyer-Moore Algorithm (Simplified: Bad Character Rule Only)
// =============================================================================

// Bad character table for Boyer-Moore.
//
// For each character, stores the rightmost position in the pattern.
// Caller must provide table array with length >= 256.
fn boyer_moore_bad_char_table(pattern: &[u8], pattern_len: usize, table: &![i64]) with Panic, Div, Mut {
    // Initialize all positions to -1
    var i: usize = 0
    while i < 256 {
        table[i] = -1
        i = i + 1
    }

    // Fill in actual character positions
    i = 0
    while i < pattern_len {
        let c = pattern[i] as usize
        table[c] = i as i64
        i = i + 1
    }
}

// Searches for pattern in text using Boyer-Moore algorithm.
//
// Uses the bad character rule for simplicity.
// Time complexity: O(n/m) best case, O(nm) worst case.
//
// Caller must provide bad_char_buf array with length >= 256.
pub fn boyer_moore_search(text: &[u8], text_len: usize, pattern: &[u8], pattern_len: usize, bad_char_buf: &![i64]) -> Option<usize> with Panic, Div, Mut {
    if pattern_len == 0 {
        return Some(0)
    }

    if text_len < pattern_len {
        return None
    }

    boyer_moore_bad_char_table(pattern, pattern_len, bad_char_buf)

    var shift: usize = 0

    while shift <= text_len - pattern_len {
        var j = (pattern_len - 1) as i64

        // Match pattern from right to left
        while j >= 0 && pattern[j as usize] == text[shift + (j as usize)] {
            j = j - 1
        }

        if j < 0 {
            // Found a match
            return Some(shift)
        } else {
            // Calculate shift using bad character rule
            let bad_char_shift = j - bad_char_buf[text[shift + (j as usize)] as usize]
            let actual_shift = if bad_char_shift > 1 { bad_char_shift as usize } else { 1 }
            shift = shift + actual_shift
        }
    }

    return None
}

// Finds all occurrences using Boyer-Moore.
//
// Returns the number of matches found.
// Caller must provide:
//   - bad_char_buf: array with length >= 256
//   - matches_buf: array to store match indices
//   - max_matches: maximum number of matches to find
pub fn boyer_moore_search_all(text: &[u8], text_len: usize, pattern: &[u8], pattern_len: usize, bad_char_buf: &![i64], matches_buf: &![usize], max_matches: usize) -> usize with Panic, Div, Mut {
    if pattern_len == 0 || text_len < pattern_len {
        return 0
    }

    boyer_moore_bad_char_table(pattern, pattern_len, bad_char_buf)

    var shift: usize = 0
    var match_count: usize = 0

    while shift <= text_len - pattern_len {
        var j = (pattern_len - 1) as i64

        while j >= 0 && pattern[j as usize] == text[shift + (j as usize)] {
            j = j - 1
        }

        if j < 0 {
            if match_count < max_matches {
                matches_buf[match_count] = shift
                match_count = match_count + 1
            }
            // Shift by 1 to find overlapping matches
            shift = shift + 1
        } else {
            let bad_char_shift = j - bad_char_buf[text[shift + (j as usize)] as usize]
            let actual_shift = if bad_char_shift > 1 { bad_char_shift as usize } else { 1 }
            shift = shift + actual_shift
        }
    }

    match_count
}

// =============================================================================
// Rabin-Karp Algorithm
// =============================================================================

// Prime for hash computation
const RABIN_KARP_PRIME: u64 = 1000000007
const RABIN_KARP_BASE: u64 = 256

// Searches for pattern in text using Rabin-Karp rolling hash.
//
// Good for multiple pattern matching.
// Time complexity: O(n + m) expected, O(nm) worst case.
pub fn rabin_karp_search(text: &[u8], text_len: usize, pattern: &[u8], pattern_len: usize) -> Option<usize> with Panic, Div, Mut {
    if pattern_len == 0 {
        return Some(0)
    }

    if text_len < pattern_len {
        return None
    }

    // Compute hash of pattern and first window of text
    var pattern_hash: u64 = 0
    var text_hash: u64 = 0
    var h: u64 = 1  // h = BASE^(pattern_len-1) mod PRIME

    // Compute h
    var i: usize = 0
    while i < pattern_len - 1 {
        h = (h * RABIN_KARP_BASE) % RABIN_KARP_PRIME
        i = i + 1
    }

    // Compute initial hashes
    i = 0
    while i < pattern_len {
        pattern_hash = (RABIN_KARP_BASE * pattern_hash + (pattern[i] as u64)) % RABIN_KARP_PRIME
        text_hash = (RABIN_KARP_BASE * text_hash + (text[i] as u64)) % RABIN_KARP_PRIME
        i = i + 1
    }

    // Slide the pattern over text
    i = 0
    while i <= text_len - pattern_len {
        // If hashes match, verify character by character
        if pattern_hash == text_hash {
            var match_found = true
            var j: usize = 0
            while j < pattern_len {
                if text[i + j] != pattern[j] {
                    match_found = false
                    break
                }
                j = j + 1
            }

            if match_found {
                return Some(i)
            }
        }

        // Compute hash for next window
        if i < text_len - pattern_len {
            // Remove leading digit, add trailing digit
            text_hash = (RABIN_KARP_BASE * (text_hash + RABIN_KARP_PRIME - (h * (text[i] as u64)) % RABIN_KARP_PRIME)
                         + (text[i + pattern_len] as u64)) % RABIN_KARP_PRIME
        }

        i = i + 1
    }

    return None
}

// =============================================================================
// Edit Distance (Levenshtein Distance)
// =============================================================================

// Computes the Levenshtein (edit) distance between two byte sequences.
//
// The edit distance is the minimum number of single-character edits
// (insertions, deletions, or substitutions) required to change one
// string into the other.
//
// Time complexity: O(nm) where n and m are the lengths of the strings.
// Space complexity: O(min(n, m)) using two-row optimization.
//
// Caller must provide two work buffers (prev_buf, curr_buf) each with length > max(len1, len2).
pub fn edit_distance(s1: &[u8], len1: usize, s2: &[u8], len2: usize, prev_buf: &![usize], curr_buf: &![usize]) -> usize with Panic, Div, Mut {
    // Ensure s1 is the shorter string for space optimization
    if len1 > len2 {
        return edit_distance(s2, len2, s1, len1, prev_buf, curr_buf)
    }

    if len1 == 0 {
        return len2
    }

    // Initialize first row
    var i: usize = 0
    while i <= len1 {
        prev_buf[i] = i
        curr_buf[i] = 0
        i = i + 1
    }

    // Fill in the rest of the matrix
    var j: usize = 1
    while j <= len2 {
        curr_buf[0] = j

        i = 1
        while i <= len1 {
            let cost = if s1[i - 1] == s2[j - 1] { 0 } else { 1 }

            let delete = prev_buf[i] + 1
            let insert = curr_buf[i - 1] + 1
            let substitute = prev_buf[i - 1] + cost

            curr_buf[i] = min3(delete, insert, substitute)
            i = i + 1
        }

        // Copy curr to prev for next iteration
        i = 0
        while i <= len1 {
            prev_buf[i] = curr_buf[i]
            i = i + 1
        }

        j = j + 1
    }

    prev_buf[len1]
}

// Helper function: minimum of three values.
fn min3(a: usize, b: usize, c: usize) -> usize {
    let min_ab = if a < b { a } else { b }
    if min_ab < c { min_ab } else { c }
}

// Computes normalized edit distance (0.0 to 1.0).
//
// Returns 0.0 for identical strings, 1.0 for completely different strings.
//
// Caller must provide two work buffers each with length > max(len1, len2).
pub fn normalized_edit_distance(s1: &[u8], len1: usize, s2: &[u8], len2: usize, prev_buf: &![usize], curr_buf: &![usize]) -> f64 with Panic, Div, Mut {
    let max_len = if len1 > len2 { len1 } else { len2 }

    if max_len == 0 {
        return 0.0
    }

    let dist = edit_distance(s1, len1, s2, len2, prev_buf, curr_buf)
    (dist as f64) / (max_len as f64)
}

// Computes similarity score (0.0 to 1.0).
//
// Returns 1.0 for identical strings, 0.0 for completely different strings.
//
// Caller must provide two work buffers each with length > max(len1, len2).
pub fn similarity(s1: &[u8], len1: usize, s2: &[u8], len2: usize, prev_buf: &![usize], curr_buf: &![usize]) -> f64 with Panic, Div, Mut {
    1.0 - normalized_edit_distance(s1, len1, s2, len2, prev_buf, curr_buf)
}

// =============================================================================
// Fuzzy Matching
// =============================================================================

// Result of a fuzzy match.
pub struct FuzzyMatch {
    index: usize,
    distance: usize,
    score: f64,
}

impl FuzzyMatch {
    // Returns the index in the candidates list.
    pub fn index(&self) -> usize {
        self.index
    }

    // Returns the edit distance.
    pub fn distance(&self) -> usize {
        self.distance
    }

    // Returns the similarity score (0.0 to 1.0).
    pub fn score(&self) -> f64 {
        self.score
    }
}

// Finds the best fuzzy match for search_query among a single candidate.
// For multiple candidates, call this in a loop.
//
// Caller must provide two work buffers (prev_buf, curr_buf) each with length > max(search_query_len, candidate_len).
pub fn fuzzy_match_single(search_query: &[u8], search_query_len: usize, candidate: &[u8], candidate_len: usize, max_distance: usize, prev_buf: &![usize], curr_buf: &![usize]) -> Option<FuzzyMatch> with Panic, Div, Mut {
    let dist = edit_distance(search_query, search_query_len, candidate, candidate_len, prev_buf, curr_buf)

    if dist <= max_distance {
        let max_len = if search_query_len > candidate_len { search_query_len } else { candidate_len }
        let score = if max_len == 0 { 1.0 } else { 1.0 - (dist as f64) / (max_len as f64) }
        return Some(FuzzyMatch { index: 0, distance: dist, score })
    }

    return None
}

// =============================================================================
// Longest Common Subsequence (LCS)
// =============================================================================

// Computes the length of the longest common subsequence.
//
// A subsequence is a sequence that can be derived by deleting some
// or no elements without changing the order of remaining elements.
//
// Caller must provide two work buffers (prev_buf, curr_buf) each with length > len2.
pub fn lcs_length(s1: &[u8], len1: usize, s2: &[u8], len2: usize, prev_buf: &![usize], curr_buf: &![usize]) -> usize with Panic, Div, Mut {
    if len1 == 0 || len2 == 0 {
        return 0
    }

    // Initialize buffers
    var j: usize = 0
    while j <= len2 {
        prev_buf[j] = 0
        curr_buf[j] = 0
        j = j + 1
    }

    var i: usize = 1
    while i <= len1 {
        j = 1
        while j <= len2 {
            if s1[i - 1] == s2[j - 1] {
                curr_buf[j] = prev_buf[j - 1] + 1
            } else {
                curr_buf[j] = if prev_buf[j] > curr_buf[j - 1] { prev_buf[j] } else { curr_buf[j - 1] }
            }
            j = j + 1
        }

        // Copy curr to prev for next iteration
        j = 0
        while j <= len2 {
            prev_buf[j] = curr_buf[j]
            j = j + 1
        }

        i = i + 1
    }

    prev_buf[len2]
}

// =============================================================================
// Hamming Distance
// =============================================================================

// Computes the Hamming distance between two equal-length byte sequences.
//
// The Hamming distance is the number of positions at which the
// corresponding bytes are different.
//
// Both sequences must have the same length.
pub fn hamming_distance(s1: &[u8], s2: &[u8], len: usize) -> usize with Panic, Div, Mut {
    var distance: usize = 0

    var i: usize = 0
    while i < len {
        if s1[i] != s2[i] {
            distance = distance + 1
        }
        i = i + 1
    }

    distance
}

