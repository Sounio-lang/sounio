// stdlib/distributed/pure/types.sio — Distributed Computing Types

module distributed::pure::types

pub struct NodeId {
    pub host: string,
    pub port: i32,
    pub id: i32,
}

pub struct DistributedMessage {
    pub from: NodeId,
    pub to: NodeId,
    pub payload: [u8; 1024],
    pub payload_len: i32,
}

pub struct NodeRegistry {
    pub nodes: [NodeId; 16],
    pub n_nodes: i32,
}

pub fn node_id_new(host: string, port: i32, id: i32) -> NodeId {
    NodeId { host: host, port: port, id: id }
}

pub fn registry_new() -> NodeRegistry {
    NodeRegistry { nodes: [NodeId { host: "", port: 0, id: 0 }; 16], n_nodes: 0 }
}

pub fn registry_add(r: &! NodeRegistry, node: NodeId) with Mut {
    if r.n_nodes < 16 {
        r.nodes[r.n_nodes as usize] = node
        r.n_nodes = r.n_nodes + 1
    }
}

pub fn registry_size(r: &NodeRegistry) -> i32 { r.n_nodes }