// stdlib/str — Byte string utilities
//
// Main implementation: str/lib.sio (Str struct, str_concat, str_split_char, etc.)
// Simple byte-buffer operations below for [u8; 256] use cases.

fn str_buf_eq(a: &[u8; 256], a_len: i32, b: &[u8; 256], b_len: i32) -> bool with Mut, Panic, Div {
    if a_len != b_len { return false }
    var i: i32 = 0
    while i < a_len {
        if a[i] != b[i] { return false }
        i = i + 1
    }
    true
}

fn str_buf_starts_with(s: &[u8; 256], s_len: i32, prefix: &[u8; 64], p_len: i32) -> bool with Mut, Panic, Div {
    if p_len > s_len { return false }
    var i: i32 = 0
    while i < p_len {
        if s[i] != prefix[i] { return false }
        i = i + 1
    }
    true
}

fn str_buf_ends_with(s: &[u8; 256], s_len: i32, suffix: &[u8; 64], p_len: i32) -> bool with Mut, Panic, Div {
    if p_len > s_len { return false }
    var i: i32 = 0
    let offset = s_len - p_len
    while i < p_len {
        if s[offset + i] != suffix[i] { return false }
        i = i + 1
    }
    true
}

fn str_buf_find(s: &[u8; 256], s_len: i32, needle: u8) -> i32 with Mut, Panic, Div {
    var i: i32 = 0
    while i < s_len {
        if s[i] == needle { return i }
        i = i + 1
    }
    0 - 1
}

fn str_buf_rfind(s: &[u8; 256], s_len: i32, needle: u8) -> i32 with Mut, Panic, Div {
    var i: i32 = s_len - 1
    while i >= 0 {
        if s[i] == needle { return i }
        i = i - 1
    }
    0 - 1
}

fn str_buf_count(s: &[u8; 256], s_len: i32, needle: u8) -> i32 with Mut, Panic, Div {
    var n: i32 = 0
    var i: i32 = 0
    while i < s_len {
        if s[i] == needle { n = n + 1 }
        i = i + 1
    }
    n
}

fn str_buf_to_upper(s: &[u8; 256], len: i32, out: &![u8; 256]) with Mut, Panic, Div {
    var i: i32 = 0
    while i < len {
        let c = s[i]
        if c >= 97 && c <= 122 {
            out[i] = c - 32
        } else {
            out[i] = c
        }
        i = i + 1
    }
}

fn str_buf_to_lower(s: &[u8; 256], len: i32, out: &![u8; 256]) with Mut, Panic, Div {
    var i: i32 = 0
    while i < len {
        let c = s[i]
        if c >= 65 && c <= 90 {
            out[i] = c + 32
        } else {
            out[i] = c
        }
        i = i + 1
    }
}

// =============================================================================
// Tests
// =============================================================================

fn test_str_buf_eq() -> bool with Mut, Panic, Div {
    var a: [u8; 256] = [0; 256]
    var b: [u8; 256] = [0; 256]
    a[0] = 104
    a[1] = 105
    b[0] = 104
    b[1] = 105
    str_buf_eq(&a, 2, &b, 2) && !str_buf_eq(&a, 2, &b, 1)
}

fn test_starts_with() -> bool with Mut, Panic, Div {
    var s: [u8; 256] = [0; 256]
    var p: [u8; 64] = [0; 64]
    s[0] = 104
    s[1] = 101
    s[2] = 108
    s[3] = 108
    s[4] = 111
    p[0] = 104
    p[1] = 101
    p[2] = 108
    str_buf_starts_with(&s, 5, &p, 3)
}

fn test_find() -> bool with Mut, Panic, Div {
    var s: [u8; 256] = [0; 256]
    s[0] = 97
    s[1] = 98
    s[2] = 99
    str_buf_find(&s, 3, 98) == 1 && str_buf_find(&s, 3, 120) == (0 - 1)
}

// Struct wrapper for by-ref mutation visibility in JIT
struct Buf256 {
    data: [u8; 256]
}

fn str_buf_to_upper_wrapped(s: &[u8; 256], len: i32, out: &!Buf256) with Mut, Panic, Div {
    var i: i32 = 0
    while i < len {
        let c = s[i]
        if c >= 97 && c <= 122 {
            out.data[i] = c - 32
        } else {
            out.data[i] = c
        }
        i = i + 1
    }
}

fn test_to_upper() -> bool with Mut, Panic, Div {
    var s: [u8; 256] = [0; 256]
    var out = Buf256 { data: [0; 256] }
    s[0] = 97
    s[1] = 98
    s[2] = 99
    str_buf_to_upper_wrapped(&s, 3, &!out)
    out.data[0] == 65 && out.data[1] == 66 && out.data[2] == 67
}

fn main() with IO, Mut, Panic, Div {
    if test_str_buf_eq() { print("str eq: PASS\n") } else { print("str eq: FAIL\n") }
    if test_starts_with() { print("str starts_with: PASS\n") } else { print("str starts_with: FAIL\n") }
    if test_find() { print("str find: PASS\n") } else { print("str find: FAIL\n") }
    if test_to_upper() { print("str to_upper: PASS\n") } else { print("str to_upper: FAIL\n") }
}
