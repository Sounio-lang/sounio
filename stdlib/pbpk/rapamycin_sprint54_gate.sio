// stdlib/pbpk/rapamycin_sprint54_gate.sio — Sprint 54 certification gate
//
// Inducer stratum (ke=0.05590 h⁻¹, F=0.047, standard D=34mg) dose analysis.
// Third in the pharmacogenomic trilogy: S48 (slow, feasible), S51 (fast, feasible),
// S54 (ind, structurally infeasible).
//
// Key values:
//   N=7  D=34mg: margin=0.290 (WARN — standard, sub-certification)
//   N=7  D=56mg: margin=1.094 (WARN — at the N=28 ceiling dose)
//   N=28 D=34mg: margin=2.117 (CERT)
//   N=28 D=56mg: margin=2.008 (barely CERT — ceiling boundary)
//   N=28 D=60mg: margin=1.598 (WARN — ceiling exceeded)
//   cert_gap_n7  = 0.906 (shortfall from 2.0 at the constrained maximum)
//   ceiling_gap_steps = 11 (steps of 2mg from standard to N=28 ceiling)
//   Diminishing returns: first 2mg step adds 0.114, last adds 0.058
//
// Finding A: standard D=34mg → WARN at N=7 (margin=0.290); N=28 CERT (2.117).
// Finding B: N=7 margin at N=28 ceiling dose D=56mg = 1.094; gap = 0.906.
// Finding C: N=28 ceiling binds at D=56mg (d_cert_n28_max); dose escalation
//            above D=56mg causes supra-therapeutic trough at N=28.
// Finding D: structural infeasibility — no dose simultaneously certifies N=7
//            and N=28; gap 0.906 cannot be closed by dose escalation alone.
//
// 56 assertions in sections A–H. All must pass (return 56).

module pbpk::rapamycin_sprint54_gate

use pbpk::rapamycin_ind_dose_adjust::{
    ida_margin_n7_d34, ida_margin_n7_d36, ida_margin_n7_d40,
    ida_margin_n7_d42, ida_margin_n7_d48, ida_margin_n7_d50,
    ida_margin_n7_d52, ida_margin_n7_d56,
    ida_margin_n28_d34, ida_margin_n28_d42,
    ida_margin_n28_d50, ida_margin_n28_d56, ida_margin_n28_d60,
    ida_d_cert_n28_max,
    ida_margin_n7_at_n28_max, ida_cert_gap_n7,
    ida_ceiling_gap_steps,
    ida_margin_n7_step1, ida_margin_n7_step_last
}

pub fn rapamycin_sprint54_gate() -> i64 with Mut, Div, Panic {
    var score = 0

    // ── Section A: standard D=34mg WARN at N=7, CERT at N=28 (Finding A) ──────
    if ida_margin_n7_d34() > 0.0 { score = score + 1 };
    if ida_margin_n7_d34() < 2.0 { score = score + 1 };
    if ida_margin_n7_d34() > 0.28 { score = score + 1 };
    if ida_margin_n7_d34() < 0.31 { score = score + 1 };
    if ida_margin_n28_d34() >= 2.0 { score = score + 1 };
    if ida_margin_n28_d34() > 2.10 { score = score + 1 };
    if ida_margin_n28_d34() < 2.13 { score = score + 1 };

    // ── Section B: monotone N=7 climb with diminishing returns ───────────────
    if ida_margin_n7_d36() > ida_margin_n7_d34() { score = score + 1 };
    if ida_margin_n7_d42() > ida_margin_n7_d36() { score = score + 1 };
    if ida_margin_n7_d50() > ida_margin_n7_d42() { score = score + 1 };
    if ida_margin_n7_d56() > ida_margin_n7_d50() { score = score + 1 };
    if ida_margin_n7_step1() > ida_margin_n7_step_last() { score = score + 1 };
    if ida_margin_n7_step_last() < ida_margin_n7_step1() * 0.6 { score = score + 1 };
    if ida_margin_n7_d56() < 2.0 { score = score + 1 };

    // ── Section C: N=28 ceiling at D=56mg (Finding C) ────────────────────────
    if ida_d_cert_n28_max() > 55.9 { score = score + 1 };
    if ida_d_cert_n28_max() < 56.1 { score = score + 1 };
    if ida_margin_n28_d56() >= 2.0 { score = score + 1 };
    if ida_margin_n28_d56() < 2.1 { score = score + 1 };
    if ida_margin_n28_d60() < 2.0 { score = score + 1 };
    if ida_ceiling_gap_steps() > 10 { score = score + 1 };
    if ida_ceiling_gap_steps() < 12 { score = score + 1 };

    // ── Section D: N=7 margin at ceiling dose — infeasibility gap (Finding B) ─
    if ida_margin_n7_at_n28_max() > 1.09 { score = score + 1 };
    if ida_margin_n7_at_n28_max() < 1.10 { score = score + 1 };
    if ida_cert_gap_n7() > 0.90 { score = score + 1 };
    if ida_cert_gap_n7() < 0.92 { score = score + 1 };
    if ida_margin_n7_at_n28_max() < 2.0 { score = score + 1 };
    if ida_cert_gap_n7() > 0.0 { score = score + 1 };
    if ida_margin_n7_d56() < ida_margin_n7_at_n28_max() + 0.001 { score = score + 1 };

    // ── Section E: N=7 scan never reaches cert — structural infeasibility (F D) ─
    if ida_margin_n7_d34() < 2.0 { score = score + 1 };
    if ida_margin_n7_d40() < 2.0 { score = score + 1 };
    if ida_margin_n7_d48() < 2.0 { score = score + 1 };
    if ida_margin_n7_d52() < 2.0 { score = score + 1 };
    if ida_margin_n7_d56() < 2.0 { score = score + 1 };
    if ida_margin_n7_d56() > 1.0 { score = score + 1 };
    if ida_margin_n7_d56() > ida_margin_n7_d34() + 0.7 { score = score + 1 };

    // ── Section F: N=28 margin across dose range ──────────────────────────────
    if ida_margin_n28_d34() > 2.0 { score = score + 1 };
    if ida_margin_n28_d42() > 2.0 { score = score + 1 };
    if ida_margin_n28_d50() > 2.0 { score = score + 1 };
    if ida_margin_n28_d50() > 2.7 { score = score + 1 };
    if ida_margin_n28_d50() < 2.8 { score = score + 1 };
    if ida_margin_n28_d56() > 2.0 { score = score + 1 };
    if ida_margin_n28_d60() < 2.0 { score = score + 1 };

    // ── Section G: diminishing returns quantification ─────────────────────────
    if ida_margin_n7_step1() > 0.11 { score = score + 1 };
    if ida_margin_n7_step1() < 0.12 { score = score + 1 };
    if ida_margin_n7_step_last() > 0.05 { score = score + 1 };
    if ida_margin_n7_step_last() < 0.07 { score = score + 1 };
    if ida_margin_n7_step1() > ida_margin_n7_step_last() + 0.05 { score = score + 1 };
    if ida_margin_n7_d50() < ida_margin_n7_d34() + 0.7 { score = score + 1 };
    if ida_margin_n7_d56() - ida_margin_n7_d34() < 0.85 { score = score + 1 };

    // ── Section H: policy — infeasibility magnitude and contrast ──────────────
    if ida_cert_gap_n7() > 0.5 { score = score + 1 };
    if ida_margin_n7_d56() < 1.5 { score = score + 1 };
    if ida_margin_n28_d56() > 2.0 { score = score + 1 };
    if ida_margin_n28_d60() < 2.0 { score = score + 1 };
    if ida_cert_gap_n7() > 0.8 { score = score + 1 };
    if ida_margin_n7_d34() > 0.0 { score = score + 1 };
    if ida_d_cert_n28_max() > 34.0 { score = score + 1 };

    score
}
