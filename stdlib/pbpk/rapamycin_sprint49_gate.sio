// stdlib/pbpk/rapamycin_sprint49_gate.sio — Sprint 49 certification gate
//
// GUM trajectory for slow stratum at GUM-optimal dose D=2.5mg (Sprint 48).
// Contrasted with standard D=5mg (Sprint 44: N_crit=3, N_last_cert=18).
//
// Actual values at D=2.5mg:
//   margin_n7  = 1.419 (WARN — week-1 falls before N_crit; the cost)
//   margin_n14 = 6.251 (CERT — week-2 safe)
//   margin_n28 = 12.073 (CERT — month-1 alarm eliminated)
//   N_crit     = 8  (vs 3 at D=5mg: 5-dose cost)
//   N_last_cert= 58 (vs 18 at D=5mg: 40-dose gain)
//   N_peak     = 29 (vs 10 at D=5mg: delayed by 19 doses)
//   margin_peak= 12.354 (vs 7.755 at D=5mg: 59% higher)
//
// 56 assertions in sections A–H. All must pass (return 56).

module pbpk::rapamycin_sprint49_gate

use pbpk::rapamycin_slow_adjusted::{
    sa_margin_n7, sa_margin_n14, sa_margin_n28,
    sa_n_crit, sa_n_last_cert, sa_n_peak, sa_margin_peak,
    sa_ncrit_gap, sa_nlast_cert_gain
}

pub fn rapamycin_sprint49_gate() -> i64 with Mut, Div, Panic {
    var score = 0

    // ── Section A: monitoring visit spot values ────────────────────────────────
    if sa_margin_n7() > 0.0 { score = score + 1 };
    if sa_margin_n7() < 2.0 { score = score + 1 };
    if sa_margin_n7() > 1.0 { score = score + 1 };
    if sa_margin_n14() > 2.0 { score = score + 1 };
    if sa_margin_n14() > 6.0 { score = score + 1 };
    if sa_margin_n28() > 2.0 { score = score + 1 };
    if sa_margin_n28() > 12.0 { score = score + 1 };

    // ── Section B: N_crit and N_last_cert at D=2.5mg ──────────────────────────
    if sa_n_crit() > 7 { score = score + 1 };
    if sa_n_crit() < 9 { score = score + 1 };
    if sa_n_last_cert() > 57 { score = score + 1 };
    if sa_n_last_cert() < 60 { score = score + 1 };
    if sa_n_last_cert() - sa_n_crit() > 49 { score = score + 1 };
    if sa_n_last_cert() > sa_n_crit() + 40 { score = score + 1 };
    if sa_n_crit() < sa_n_last_cert() { score = score + 1 };

    // ── Section C: N_peak and peak margin ─────────────────────────────────────
    if sa_n_peak() > 28 { score = score + 1 };
    if sa_n_peak() < 30 { score = score + 1 };
    if sa_margin_peak() > 12.0 { score = score + 1 };
    if sa_margin_peak() < 13.0 { score = score + 1 };
    if sa_margin_peak() > sa_margin_n28() { score = score + 1 };
    if sa_margin_peak() > sa_margin_n14() { score = score + 1 };
    if sa_n_peak() > sa_n_crit() { score = score + 1 };

    // ── Section D: Finding A — dose trade-off (ncrit cost vs nlast gain) ──────
    if sa_ncrit_gap() > 4 { score = score + 1 };
    if sa_ncrit_gap() < 6 { score = score + 1 };
    if sa_nlast_cert_gain() > 39 { score = score + 1 };
    if sa_nlast_cert_gain() < 41 { score = score + 1 };
    if sa_n_crit() > 3 { score = score + 1 };
    if sa_n_last_cert() > 18 { score = score + 1 };
    if sa_nlast_cert_gain() > sa_ncrit_gap() * 7 { score = score + 1 };

    // ── Section E: Finding B — monitoring visit safety ────────────────────────
    if sa_margin_n14() > sa_margin_n7() { score = score + 1 };
    if sa_margin_n28() > sa_margin_n14() { score = score + 1 };
    if sa_margin_n28() > sa_margin_n7() { score = score + 1 };
    if sa_margin_n14() - sa_margin_n7() > 4.0 { score = score + 1 };
    if sa_margin_n28() > sa_margin_n7() + 10.0 { score = score + 1 };
    if sa_margin_n14() < 7.0 { score = score + 1 };
    if sa_margin_n28() > 11.5 { score = score + 1 };

    // ── Section F: Finding C — N_peak shifted later vs D=5mg (N_peak was 10) ─
    if sa_n_peak() > 10 { score = score + 1 };
    if sa_n_peak() > sa_n_crit() + 20 { score = score + 1 };
    if sa_n_peak() < 35 { score = score + 1 };
    if sa_margin_peak() > sa_margin_n7() + 10.0 { score = score + 1 };
    if sa_margin_peak() > sa_margin_n14() + 6.0 { score = score + 1 };
    if sa_margin_peak() < sa_margin_n28() + 0.5 { score = score + 1 };
    if sa_n_peak() < sa_n_last_cert() { score = score + 1 };

    // ── Section G: Finding D — population impact at monitoring visits ──────────
    if sa_margin_n28() > 11.0 { score = score + 1 };
    // Mirror identity: adjusted margin + standard alarm = total reversal > 14σ
    if sa_margin_n28() + 2.536 > 14.0 { score = score + 1 };
    if sa_margin_n7() < 1.5 { score = score + 1 };
    if sa_margin_n28() - sa_margin_n14() > 5.0 { score = score + 1 };
    if sa_n_crit() < 10 { score = score + 1 };
    if sa_n_crit() > sa_n_peak() - 22 { score = score + 1 };
    if sa_margin_n28() > sa_margin_n7() + sa_margin_n14() { score = score + 1 };

    // ── Section H: policy implications ────────────────────────────────────────
    if sa_n_last_cert() > 55 { score = score + 1 };
    if sa_margin_peak() > sa_margin_n28() + 0.2 { score = score + 1 };
    if sa_margin_peak() - sa_margin_n7() > 10.0 { score = score + 1 };
    if sa_n_peak() - sa_n_crit() > 20 { score = score + 1 };
    if sa_n_last_cert() > sa_n_crit() + 45 { score = score + 1 };
    if sa_n_last_cert() > 3 * sa_n_crit() { score = score + 1 };
    if sa_margin_n28() > sa_margin_n14() + 5.0 { score = score + 1 };

    score
}
