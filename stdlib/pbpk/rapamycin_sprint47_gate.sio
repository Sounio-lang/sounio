// stdlib/pbpk/rapamycin_sprint47_gate.sio — Sprint 47 certification gate
//
// Maximum alarm-free inter-visit gap analysis for population-weighted
// five-stratum model. Standard monitoring: N=7, N=14, N=28.
//
// Finding A: fast self-resolution — alarm 20% at N=7 drops to 0% at N=14;
//            fast stratum certifies without any schedule intervention.
// Finding B: slow late alarm — alarm re-appears at N=23, six doses before
//            the month-1 visit; alarm-free window closes at N=22 (8 doses
//            after week-2 check, vs 14-dose standard gap).
// Finding C: safe fraction = 57.1% — only 571/1000 of the standard
//            week-2-to-month-1 gap is alarm-free; gap excess = 6 doses.
// Finding D: slow singularity — slow stratum (w=0.15) is the sole driver
//            of all post-N=14 alarm; fast/std/inh/ind remain alarm-free.
//
// 56 assertions in sections A–H. All must pass (return 56).

module pbpk::rapamycin_sprint47_gate

use pbpk::rapamycin_visit_gap::{
    vg_alarm_n7, vg_alarm_n14, vg_alarm_n18, vg_alarm_n22, vg_alarm_n23, vg_alarm_n28,
    vg_n_alarm_free_max, vg_n_alarm_onset_post14,
    vg_gap_standard, vg_gap_alarm_free, vg_gap_excess, vg_safe_pct10
}

pub fn rapamycin_sprint47_gate() -> i64 with Mut, Div, Panic {
    var score = 0

    // ── Section A: spot alarm values at key doses ─────────────────────────────
    if vg_alarm_n7() > 0.19 { score = score + 1 };
    if vg_alarm_n7() < 0.21 { score = score + 1 };
    if vg_alarm_n14() < 0.001 { score = score + 1 };
    if vg_alarm_n18() < 0.001 { score = score + 1 };
    if vg_alarm_n22() < 0.001 { score = score + 1 };
    if vg_alarm_n23() > 0.14 { score = score + 1 };
    if vg_alarm_n28() > 0.14 { score = score + 1 };

    // ── Section B: scanner results ────────────────────────────────────────────
    if vg_n_alarm_free_max() > 21 { score = score + 1 };
    if vg_n_alarm_free_max() < 23 { score = score + 1 };
    if vg_n_alarm_onset_post14() > 22 { score = score + 1 };
    if vg_n_alarm_onset_post14() < 24 { score = score + 1 };
    if vg_n_alarm_onset_post14() - vg_n_alarm_free_max() > 0 { score = score + 1 };
    if vg_n_alarm_onset_post14() - vg_n_alarm_free_max() < 2 { score = score + 1 };
    if vg_n_alarm_onset_post14() < 28 { score = score + 1 };

    // ── Section C: gap magnitudes ─────────────────────────────────────────────
    if vg_gap_standard() > 13 { score = score + 1 };
    if vg_gap_standard() < 15 { score = score + 1 };
    if vg_gap_alarm_free() > 7 { score = score + 1 };
    if vg_gap_alarm_free() < 9 { score = score + 1 };
    if vg_gap_excess() > 5 { score = score + 1 };
    if vg_gap_excess() < 7 { score = score + 1 };
    if vg_gap_alarm_free() + vg_gap_excess() > 13 { score = score + 1 };

    // ── Section D: FINDING A — fast self-resolution ───────────────────────────
    if vg_alarm_n7() > 0.0 { score = score + 1 };
    if vg_alarm_n14() < 0.001 { score = score + 1 };
    if vg_alarm_n7() > vg_alarm_n14() { score = score + 1 };
    if vg_alarm_n7() - vg_alarm_n14() > 0.19 { score = score + 1 };
    if vg_alarm_n7() > vg_alarm_n23() { score = score + 1 };
    if vg_alarm_n18() < 0.001 { score = score + 1 };
    if vg_alarm_n22() < vg_alarm_n23() { score = score + 1 };

    // ── Section E: FINDING B — slow late alarm and gap excess ─────────────────
    if vg_alarm_n22() < 0.001 { score = score + 1 };
    if vg_alarm_n23() > 0.14 { score = score + 1 };
    if vg_alarm_n23() < 0.16 { score = score + 1 };
    if vg_alarm_n28() > vg_alarm_n22() { score = score + 1 };
    if vg_alarm_n28() > vg_alarm_n23() - 0.001 { score = score + 1 };
    if vg_alarm_n28() < vg_alarm_n23() + 0.001 { score = score + 1 };
    if vg_gap_excess() > 0 { score = score + 1 };

    // ── Section F: FINDING C — safe fraction 57.1% of standard gap ───────────
    if vg_safe_pct10() > 560 { score = score + 1 };
    if vg_safe_pct10() < 580 { score = score + 1 };
    if vg_gap_alarm_free() * 2 > vg_gap_standard() { score = score + 1 };
    if vg_gap_excess() * 2 < vg_gap_standard() { score = score + 1 };
    if vg_gap_alarm_free() < vg_gap_standard() { score = score + 1 };
    if vg_gap_excess() > vg_gap_standard() / 3 { score = score + 1 };
    if vg_gap_alarm_free() > vg_gap_excess() { score = score + 1 };

    // ── Section G: FINDING D — slow singularity (w=0.15 only) ────────────────
    if vg_alarm_n23() > 0.1 { score = score + 1 };
    if vg_alarm_n23() < 0.2 { score = score + 1 };
    if vg_alarm_n28() > 0.1 { score = score + 1 };
    if vg_alarm_n28() < 0.2 { score = score + 1 };
    if vg_n_alarm_free_max() > 21 { score = score + 1 };
    if vg_alarm_n7() > vg_alarm_n23() { score = score + 1 };
    if vg_alarm_n14() + vg_alarm_n18() + vg_alarm_n22() < 0.001 { score = score + 1 };

    // ── Section H: policy implications ────────────────────────────────────────
    // Standard gap overshoots alarm-free window by exactly 6 doses
    if vg_gap_standard() - vg_gap_alarm_free() > 5 { score = score + 1 };
    if vg_gap_standard() - vg_gap_alarm_free() < 7 { score = score + 1 };
    // 8 alarm-free doses from week-2 before slow tips: intermediate visit at N≤22
    if vg_n_alarm_free_max() - 14 > 7 { score = score + 1 };
    // Alarm onset within the standard monitoring window (before N=28)
    if vg_n_alarm_onset_post14() - 14 < vg_gap_standard() { score = score + 1 };
    // Structural identity: n_alarm_free_max + gap_excess = 28
    if vg_n_alarm_free_max() + vg_gap_excess() > 27 { score = score + 1 };
    // Total alarm mass across the two alarm events (fast at N=7 and slow at N=23)
    if vg_alarm_n7() + vg_alarm_n23() > 0.30 { score = score + 1 };
    // Safe fraction capped below 60% (confirms excess is substantial)
    if vg_safe_pct10() < 600 { score = score + 1 };

    score
}
