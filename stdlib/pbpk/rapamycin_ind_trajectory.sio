// stdlib/pbpk/rapamycin_ind_trajectory.sio — Sprint 55
//
// GUM-exact trough margin trajectory for the inducer stratum (strong CYP3A4
// inducer, ke=0.05590 h⁻¹, F=0.047) at the standard dose D=34mg.
// Third trajectory analysis: parallel to Sprint 49 (slow, D=2.5mg) and
// Sprint 52 (fast, D=9.5mg).
//
// The inducer stratum (ke=0.05590 h⁻¹, τ=24h) reaches pharmacokinetic
// near-steady-state within ~5–6 doses (accumulation factor R≈1.35).
// Its week-1 WARN is therefore NOT a trough-level problem — the trough at
// N=7 and N=28 are nearly identical. The certifying force is GUM precision:
// u_c contracts as N increases (more accumulated doses → tighter PK estimate),
// converting the same trough from WARN at N=7 to CERT at N=28.
//
// Finding A: n_crit — first dose-day where ind certifies at D=34mg; this
//            defines the minimum monitoring visit interval for this stratum.
// Finding B: trajectory is nearly flat in trough C but the margin climbs
//            because u_c contracts with N; peak margin and peak day.
// Finding C: long certified tail — ind certifies from n_crit through n_last_cert
//            (ceiling is not a binding constraint at D=34mg even at SS).
// Finding D: visit implication — n_crit relative to the three standard visits
//            (7, 14, 28); if n_crit > 7 the week-1 visit is too early for ind.

module pbpk::rapamycin_ind_trajectory

use pbpk::rapamycin_assay::{as_trough_mg_l}
use pbpk::rapamycin_expanded_u::{eu_u_c}
use pbpk::rapamycin_clinical::{trough_floor_mg_l, trough_ceil_mg_l}
use pbpk::rapamycin_oral_budget::{
    ob_ka_var_std, ob_f_var_std, ob_ke_var_std, ob_k12_var_std, ob_k21_var_std
}

fn it_min2(a: f64, b: f64) -> f64 { if a < b { a } else { b } }

fn it_margin_at(n: i64) -> f64 with Mut, Div, Panic {
    let ka  = ob_ka_var_std()
    let fv  = ob_f_var_std()
    let ke  = ob_ke_var_std()
    let k12 = ob_k12_var_std()
    let k21 = ob_k21_var_std()
    let c   = as_trough_mg_l(34.0, n, 0.05590, 0.047)
    let uc  = eu_u_c(34.0, n, 0.05590, 0.047, ka, fv, ke, k12, k21)
    it_min2((c - trough_floor_mg_l()) / uc, (trough_ceil_mg_l() - c) / uc)
}

// ── Named spot values ─────────────────────────────────────────────────────────
pub fn it_margin_n1()  -> f64 with Mut, Div, Panic { it_margin_at(1)  }
pub fn it_margin_n3()  -> f64 with Mut, Div, Panic { it_margin_at(3)  }
pub fn it_margin_n5()  -> f64 with Mut, Div, Panic { it_margin_at(5)  }
pub fn it_margin_n7()  -> f64 with Mut, Div, Panic { it_margin_at(7)  }
pub fn it_margin_n10() -> f64 with Mut, Div, Panic { it_margin_at(10) }
pub fn it_margin_n14() -> f64 with Mut, Div, Panic { it_margin_at(14) }
pub fn it_margin_n21() -> f64 with Mut, Div, Panic { it_margin_at(21) }
pub fn it_margin_n28() -> f64 with Mut, Div, Panic { it_margin_at(28) }
pub fn it_margin_n42() -> f64 with Mut, Div, Panic { it_margin_at(42) }
pub fn it_margin_n56() -> f64 with Mut, Div, Panic { it_margin_at(56) }

// ── Scanner: first N (1..100) where ind certifies at D=34mg ──────────────────
pub fn it_n_crit() -> i64 with Mut, Div, Panic {
    var n      = 1
    var result = 0
    while n <= 100 {
        if it_margin_at(n) >= 2.0 && result == 0 { result = n };
        n = n + 1
    }
    result
}

// ── Scanner: last N (1..120) where ind certifies at D=34mg ───────────────────
pub fn it_n_last_cert() -> i64 with Mut, Div, Panic {
    var n    = 1
    var last = 0
    while n <= 120 {
        if it_margin_at(n) >= 2.0 { last = n };
        n = n + 1
    }
    last
}

// ── Scanner: argmax N of margin in 1..120 ─────────────────────────────────────
pub fn it_n_peak() -> i64 with Mut, Div, Panic {
    var n      = 1
    var best_n = 1
    var best_m = it_margin_at(1)
    while n <= 120 {
        let m = it_margin_at(n)
        if m > best_m { best_n = n };
        if m > best_m { best_m = m };
        n = n + 1
    }
    best_n
}

pub fn it_margin_peak() -> f64 with Mut, Div, Panic {
    it_margin_at(it_n_peak())
}

// ── Derived metrics ────────────────────────────────────────────────────────────
// Days beyond week-1 visit to first certification
pub fn it_ncrit_beyond_n7() -> i64 with Mut, Div, Panic {
    it_n_crit() - 7
}

// Total certified span
pub fn it_cert_span() -> i64 with Mut, Div, Panic {
    it_n_last_cert() - it_n_crit()
}

// Days from n_crit to peak
pub fn it_peak_lag() -> i64 with Mut, Div, Panic {
    it_n_peak() - it_n_crit()
}

// Margin gain from N=7 to N=28 (GUM precision effect)
pub fn it_margin_gain_n7_to_n28() -> f64 with Mut, Div, Panic {
    it_margin_at(28) - it_margin_at(7)
}
