// stdlib/pbpk/rapamycin_dual_adjusted_coverage.sio — Sprint 53
//
// Population-weighted GUM coverage fractions under the dual-adjusted protocol:
// slow stratum at D=2.5mg (Sprint 48/49) AND fast stratum at D=9.5mg (Sprint 51/52),
// all other strata (std, inh, ind) at their standard doses.
//
// Progression:
//   Standard (Sprint 46):    N=7(0.70/0.10/0.20)  N=14(0.70/0.30/0.00)  N=28(0.85/0.00/0.15)
//   Slow-only (Sprint 50):   N=7(0.55/0.25/0.20)  N=14(0.70/0.30/0.00)  N=28(1.00/0.00/0.00)
//   Dual (this module):      N=7(0.75/0.25/0.00)  N=14(0.90/0.10/0.00)  N=28(1.00/0.00/0.00)
//
// Finding A: alarm elimination — dual adjustment zeros alarm at ALL visits;
//            the fast stratum moves ALARM→CERT at N=7 (+0.20 cert, -0.20 alarm).
// Finding B: N=7 net gain — cert 0.55→0.75 vs slow-only; slow remains WARN
//            (cost unchanged); fast ALARM→CERT recaptures +0.20 cert at week-1.
// Finding C: N=14 step-up — fast moves WARN→CERT at N=14 (+0.20 cert, -0.20 warn);
//            N=14 cert reaches 0.90 — the highest of any visit under standard protocol.
// Finding D: N=28 fully certified — unchanged from slow-only Sprint 50 (1.00/0.00/0.00);
//            fast at D=9.5mg is CERT at N=28 (margin=3.226), same as at standard dose.

module pbpk::rapamycin_dual_adjusted_coverage

use pbpk::rapamycin_monitoring_protocol::{
    mp_std_margin_n7,  mp_std_margin_n14,  mp_std_margin_n28,
    mp_inh_margin_n7,  mp_inh_margin_n14,  mp_inh_margin_n28,
    mp_ind_margin_n7,  mp_ind_margin_n14,  mp_ind_margin_n28
}
use pbpk::rapamycin_slow_adjusted::{sa_margin_n7, sa_margin_n14, sa_margin_n28}
use pbpk::rapamycin_fast_adjusted::{fa_margin_n7, fa_margin_n14, fa_margin_n28}

fn dac_cert_w(margin: f64, w: f64) -> f64
    with Mut, Div, Panic {
    if margin >= 2.0 { w } else { 0.0 }
}
fn dac_warn_w(margin: f64, w: f64) -> f64
    with Mut, Div, Panic {
    if margin >= 0.0 && margin < 2.0 { w } else { 0.0 }
}
fn dac_alarm_w(margin: f64, w: f64) -> f64
    with Mut, Div, Panic {
    if margin < 0.0 { w } else { 0.0 }
}

// ── N=7 — slow at D=2.5mg (WARN), fast at D=9.5mg (CERT), others standard ──
pub fn dac_cert_n7() -> f64 with Mut, Div, Panic {
    let a = dac_cert_w(mp_std_margin_n7(), 0.50)
    let b = dac_cert_w(sa_margin_n7(),     0.15)
    let c = dac_cert_w(fa_margin_n7(),     0.20)
    let d = dac_cert_w(mp_inh_margin_n7(), 0.05)
    let e = dac_cert_w(mp_ind_margin_n7(), 0.10)
    a + b + c + d + e
}
pub fn dac_warn_n7() -> f64 with Mut, Div, Panic {
    let a = dac_warn_w(mp_std_margin_n7(), 0.50)
    let b = dac_warn_w(sa_margin_n7(),     0.15)
    let c = dac_warn_w(fa_margin_n7(),     0.20)
    let d = dac_warn_w(mp_inh_margin_n7(), 0.05)
    let e = dac_warn_w(mp_ind_margin_n7(), 0.10)
    a + b + c + d + e
}
pub fn dac_alarm_n7() -> f64 with Mut, Div, Panic {
    let a = dac_alarm_w(mp_std_margin_n7(), 0.50)
    let b = dac_alarm_w(sa_margin_n7(),     0.15)
    let c = dac_alarm_w(fa_margin_n7(),     0.20)
    let d = dac_alarm_w(mp_inh_margin_n7(), 0.05)
    let e = dac_alarm_w(mp_ind_margin_n7(), 0.10)
    a + b + c + d + e
}

// ── N=14 — slow at D=2.5mg (CERT), fast at D=9.5mg (CERT), others standard ─
pub fn dac_cert_n14() -> f64 with Mut, Div, Panic {
    let a = dac_cert_w(mp_std_margin_n14(), 0.50)
    let b = dac_cert_w(sa_margin_n14(),     0.15)
    let c = dac_cert_w(fa_margin_n14(),     0.20)
    let d = dac_cert_w(mp_inh_margin_n14(), 0.05)
