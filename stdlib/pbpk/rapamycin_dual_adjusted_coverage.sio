    let c = dac_warn_w(fa_margin_n14(),     0.20)
    let d = dac_warn_w(mp_inh_margin_n14(), 0.05)
    let e = dac_warn_w(mp_ind_margin_n14(), 0.10)
    a + b + c + d + e
}
pub fn dac_alarm_n14() -> f64 with Mut, Div, Panic {
    let a = dac_alarm_w(mp_std_margin_n14(), 0.50)
    let b = dac_alarm_w(sa_margin_n14(),     0.15)
    let c = dac_alarm_w(fa_margin_n14(),     0.20)
    let d = dac_alarm_w(mp_inh_margin_n14(), 0.05)
    let e = dac_alarm_w(mp_ind_margin_n14(), 0.10)
    a + b + c + d + e
}

// ── N=28 — slow at D=2.5mg (CERT), fast at D=9.5mg (CERT), others standard ─
pub fn dac_cert_n28() -> f64 with Mut, Div, Panic {
    let a = dac_cert_w(mp_std_margin_n28(), 0.50)
    let b = dac_cert_w(sa_margin_n28(),     0.15)
    let c = dac_cert_w(fa_margin_n28(),     0.20)
    let d = dac_cert_w(mp_inh_margin_n28(), 0.05)
