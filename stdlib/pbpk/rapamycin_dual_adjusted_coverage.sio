}
pub fn dac_alarm_n28() -> f64 with Mut, Div, Panic {
    let a = dac_alarm_w(mp_std_margin_n28(), 0.50)
    let b = dac_alarm_w(sa_margin_n28(),     0.15)
    let c = dac_alarm_w(fa_margin_n28(),     0.20)
    let d = dac_alarm_w(mp_inh_margin_n28(), 0.05)
    let e = dac_alarm_w(mp_ind_margin_n28(), 0.10)
    a + b + c + d + e
}
