    let a = dac_warn_w(mp_std_margin_n28(), 0.50)
    let b = dac_warn_w(sa_margin_n28(),     0.15)
    let c = dac_warn_w(fa_margin_n28(),     0.20)
    let d = dac_warn_w(mp_inh_margin_n28(), 0.05)
    let e = dac_warn_w(mp_ind_margin_n28(), 0.10)
