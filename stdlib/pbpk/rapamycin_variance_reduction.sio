// stdlib/pbpk/rapamycin_variance_reduction.sio — Sprint 40
//
// GUM-exact variance-reduction sensitivity: N_crit under six variance
// scenarios (baseline, ka/2, F/2, ke/2, peripheral/2, ka=0, all/2)
// across all five pharmacogenomic strata.
//
// Variance components (from ob_*_var_std): ka=0.0225, F=0.001521,
// ke=0.000008, k12=0.000156, k21=0.000002 (ka dominates: 73.5% of budget).
//
// Finding A: ka dominance — halving ka variance achieves the same N_crit
//            as halving ALL variance components simultaneously for std and
//            fast strata; ke/2 has zero effect on all five strata.
// Finding B: Ind ka windfall — ind N_crit: 26→18 (ka/2), 26→10 (ka=0);
//            largest absolute reduction of any single intervention (−16 doses).
// Finding C: Inh three-lever equivalence — ka/2, F/2, and peripheral/2 each
//            independently reduce inh N_crit 7→6; reflects inh's uniquely
//            balanced variance budget (ka+F+peripheral all significant).
// Finding D: Slow floor — high bioavailability (F=0.188) pushes slow to
//            minimum N_crit=3 so quickly that even ka=0 only saves 1 dose.

module pbpk::rapamycin_variance_reduction

use pbpk::rapamycin_assay::{as_trough_mg_l}
use pbpk::rapamycin_expanded_u::{eu_u_c}
use pbpk::rapamycin_clinical::{trough_floor_mg_l, trough_ceil_mg_l}
use pbpk::rapamycin_oral_budget::{
    ob_ka_var_std, ob_f_var_std, ob_ke_var_std, ob_k12_var_std, ob_k21_var_std,
    ob_ke_var_inh, ob_ke_var_ind
}

fn vr_find_ncrit(d: f64, ke: f64, f: f64,
                 ka_v: f64, f_v: f64, ke_v: f64, k12_v: f64, k21_v: f64) -> i64
    with Mut, Div, Panic {
    let floor = trough_floor_mg_l(); let ceil = trough_ceil_mg_l()
    var n = 1; var found = 0
    while n <= 60 && found == 0 {
        let c  = as_trough_mg_l(d, n, ke, f)
        let uc = eu_u_c(d, n, ke, f, ka_v, f_v, ke_v, k12_v, k21_v)
        let zf = (c - floor) / uc
        let zc = (ceil - c)  / uc
        if zf >= 2.0 && zc >= 2.0 { found = n }
        else { n = n + 1 }
    }
    found
}

// ── std stratum D=5mg ke=0.01118 F=0.141 ────────────────────────────────────
pub fn vr_std_ncrit_base() -> i64 with Mut, Div, Panic {
    let ka=ob_ka_var_std(); let fv=ob_f_var_std(); let ke=ob_ke_var_std()
    let k12=ob_k12_var_std(); let k21=ob_k21_var_std()
    vr_find_ncrit(5.0,0.01118,0.141, ka,fv,ke,k12,k21)
}
pub fn vr_std_ncrit_ka2() -> i64 with Mut, Div, Panic {
    let ka=ob_ka_var_std(); let fv=ob_f_var_std(); let ke=ob_ke_var_std()
    let k12=ob_k12_var_std(); let k21=ob_k21_var_std()
    vr_find_ncrit(5.0,0.01118,0.141, ka/2.0,fv,ke,k12,k21)
