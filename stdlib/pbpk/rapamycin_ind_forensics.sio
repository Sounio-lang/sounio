// stdlib/pbpk/rapamycin_ind_forensics.sio — Sprint 32: Ind forensics + std→ind DDI transition
//
// Novel dissertation contribution: dissects WHY nc_ind_crit() = 0 (the structural
// uncertifiability of ind at the standard D=20mg) and quantifies the TDM
// intensification window for a std patient who starts rifampin co-medication.
//
// ── Part A: ind structural forensics ────────────────────────────────────────
//
//   Sprint 26 finding: at D=20mg, N=26 (ind regime SS), C_pred < floor + 2·u_c,
//   so the 95% CI's lower bound always straddles the floor — no N within 1..50
//   certifies.  Sprint 26 attributed this to a structural mismatch:
//   "C_SS (4.71 ng/mL) < floor + 2·u_c_SS (6.34 ng/mL)"
//
//   Sprint 32 quantifies the gap (probe /tmp/s32_probe.sio):
//     if_ind_structural_gap_n26() = floor + 2·u_c − C_pred = +0.001629 mg/L
//     (≈ 41% of floor — substantial structural barrier)
//
//   At D=34 the gap closes (gap = −0.0000302, just below 0) — consistent with
//   Sprint 27 D29 finding that D=34 certifies.
//
//   A single LCMS observation shrinks u_pk to u_post (Sprint 28 §D).  Plugging
//   u_post into dc_d_min:
//
//     if_ind_d_min_n26()              = 33.745 mg  (Sprint 27 prior)
//     if_ind_d_min_posterior_lcms()   = 18.845 mg  (LCMS, ~44% reduction)
//     if_ind_d_min_posterior_cmia()   = 21.682 mg  (CMIA, ~36% reduction)
//
//   A single LCMS observation MORE THAN HALVES the certifiable-dose floor —
//   ind becomes treatable at near-standard doses (≈ 20 mg) post-measurement.
//   This is the strongest demonstration in the arc that measurement reshapes
//   the dose-cert window: the structural barrier is conditional on an
//   informed prior.
//
// ── Part B: DDI transition (std → ind via rifampin) ─────────────────────────
//
//   A patient on standard regimen (D=5mg, ke=0.01118, F=0.141) starts
//   rifampin at dose n_switch.  After the switch, ke and F move toward the
//   strong-inducer anchors (ke=0.05590, F=0.047) — typically over ~7 days as
//   CYP3A4 induction reaches steady state.  Sprint 32 models the EXTREME
//   (instantaneous) switch to bound the worst-case TDM hazard.
//
//   if_trough_with_switch(D, n_total, n_switch, ke_pre, F_pre, ke_post, F_post)
//
//   Findings (probe /tmp/s32_probe.sio):
//     - All three switch days alarm the floor: trough at +14d
//         switch_day=1  → 0.00106 mg/L (4× below floor)
//         switch_day=7  → 0.00188 mg/L (2× below)
//         switch_day=14 → 0.00273 mg/L (1.5× below)
//       Later switches keep more accumulated drug at +14d (carry-over).
//     - TDM intensification window (doses N ≥ n_switch where trough < floor,
//       scanned to 30 doses):
//         switch_day=1  → 30 days (entire scan window)
//         switch_day=7  → 23 days
//         switch_day=14 → 13 days
//     - if_dynamic_ncrit_day7 = 0 — never re-certifies within 50 doses at D=5.
//     - Clean cross-check: if_no_switch (n_switch > n_total) reproduces
//       as_trough_mg_l to numerical zero — same Euler loop, same params.
//
// ── Effect annotations ─────────────────────────────────────────────────────
//   All pub fns: with Mut, Div, Panic

module pbpk::rapamycin_ind_forensics

use pbpk::rapamycin_assay::{as_trough_mg_l, as_v_pred_conc}
use pbpk::rapamycin_expanded_u::{eu_u_c, eu_lo, eu_hi, eu_fully_in_range}
use pbpk::rapamycin_n_crit::{nc_find_crit, nc_ind_crit}
use pbpk::rapamycin_dose_cert::{dc_ind_n26_d_min, dc_ind_n26_d_max}
use pbpk::rapamycin_clinical::{trough_floor_mg_l, trough_ceil_mg_l}
use pbpk::rapamycin_ddi::{
    ddi_ke_baseline, ddi_f_baseline,
    ddi_ke_ind_strong, ddi_f_ind_strong,
    ddi_ke_var_baseline, ddi_ke_var_ind,
    ddi_ke_var_below_crossover
}
use pbpk::rapamycin_cyp3a5::{cyp_ke_standard, cyp_f_standard}
use pbpk::rapamycin_oral_budget::{
    ob_ka_var_std, ob_f_var_std, ob_ke_var_std,
    ob_k12_var_std, ob_k21_var_std
}

// ── Local helpers ────────────────────────────────────────────────────────────

fn if_sqrt(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { 0.0001 } else {
        var r = x
        var i = 0
        while i < 50 { r = (r + x / r) / 2.0; i = i + 1 }
        r
    }
}

// ── Part A: structural-gap forensics ───────────────────────────────────────

// floor + 2·u_c − C_pred at (D=20, N=26, ind regime).  > 0 ⇒ uncertifiable.
pub fn if_ind_structural_gap_n26() -> f64 with Mut, Div, Panic {
    let c = as_trough_mg_l(20.0, 26, ddi_ke_ind_strong(), ddi_f_ind_strong())
    let u = eu_u_c(20.0, 26, ddi_ke_ind_strong(), ddi_f_ind_strong(),
                   ob_ka_var_std(), ob_f_var_std(), ddi_ke_var_ind(),
                   ob_k12_var_std(), ob_k21_var_std())
    trough_floor_mg_l() + 2.0 * u - c
}

// Generalised: gap at any (D, N) under ind regime.  < 0 ⇒ certifiable.
pub fn if_ind_gap_at_dose(d: f64, n: i64) -> f64 with Mut, Div, Panic {
    let c = as_trough_mg_l(d, n, ddi_ke_ind_strong(), ddi_f_ind_strong())
    let u = eu_u_c(d, n, ddi_ke_ind_strong(), ddi_f_ind_strong(),
                   ob_ka_var_std(), ob_f_var_std(), ddi_ke_var_ind(),
                   ob_k12_var_std(), ob_k21_var_std())
    trough_floor_mg_l() + 2.0 * u - c
}

// At D=34, gap should be ≤ 0 (Sprint 27 D29).
pub fn if_ind_gap_at_34_n26() -> f64 with Mut, Div, Panic { if_ind_gap_at_dose(34.0, 26) }

// Re-expose dc_ind_n26_d_min for cross-reference assertions
pub fn if_ind_d_min_n26() -> f64 with Mut, Div, Panic { dc_ind_n26_d_min() }

// Posterior-aware D_min: replace u_pk with u_post = sqrt(V_pk · V_assay / (V_pk + V_assay))
// using LCMS V_assay.  Sprint 28 §D shows u_post < u_pk, so D_min posterior < D_min prior.
pub fn if_ind_d_min_posterior_lcms() -> f64 with Mut, Div, Panic {
    let d_ref = 20.0
    let c     = as_trough_mg_l(d_ref, 26, ddi_ke_ind_strong(), ddi_f_ind_strong())
    let v_pk  = as_v_pred_conc(d_ref, 26, ddi_ke_ind_strong(), ddi_f_ind_strong(),
                               ob_ka_var_std(), ob_f_var_std(), ddi_ke_var_ind(),
                               ob_k12_var_std(), ob_k21_var_std())
    let cv = 0.05    // LCMS
    let v_assay = cv * cv * c * c
    let v_post = if (v_pk + v_assay) <= 0.0 { v_pk } else { v_pk * v_assay / (v_pk + v_assay) }
    let u_post = if_sqrt(v_post)
    // Replace u_pk with u_post in dc_d_min formula: D_min = floor · d_ref / (C − 2·u_post)
    let lo_coeff = c - 2.0 * u_post
    if lo_coeff <= 0.0 { 999.0 } else { trough_floor_mg_l() * d_ref / lo_coeff }
}

// Posterior-aware D_min via CMIA — less reduction than LCMS
pub fn if_ind_d_min_posterior_cmia() -> f64 with Mut, Div, Panic {
    let d_ref = 20.0
    let c     = as_trough_mg_l(d_ref, 26, ddi_ke_ind_strong(), ddi_f_ind_strong())
    let v_pk  = as_v_pred_conc(d_ref, 26, ddi_ke_ind_strong(), ddi_f_ind_strong(),
                               ob_ka_var_std(), ob_f_var_std(), ddi_ke_var_ind(),
                               ob_k12_var_std(), ob_k21_var_std())
    let cv = 0.12    // CMIA
    let v_assay = cv * cv * c * c
    let v_post = if (v_pk + v_assay) <= 0.0 { v_pk } else { v_pk * v_assay / (v_pk + v_assay) }
    let u_post = if_sqrt(v_post)
    let lo_coeff = c - 2.0 * u_post
    if lo_coeff <= 0.0 { 999.0 } else { trough_floor_mg_l() * d_ref / lo_coeff }
}

// Confirm nc_ind_crit is structurally 0
pub fn if_nc_ind_is_zero() -> bool with Mut, Div, Panic { nc_ind_crit() == 0 }

// ── Part B: DDI transition ODE ─────────────────────────────────────────────
//
// Local copy of as_trough_mg_l body with ke, F swapping at dose n_switch.
// Pattern: pre-switch uses (ke_pre, F_pre); from dose n_switch onward uses
// (ke_post, F_post).  Same Euler step structure as as_trough_mg_l.

pub fn if_trough_with_switch(d_oral: f64, n_total: i64, n_switch: i64,
                             ke_pre: f64, f_pre: f64,
                             ke_post: f64, f_post: f64) -> f64
    with Mut, Div, Panic {
    let k12_val = 0.05
    let k21_val = 0.005
    let ka_val  = 0.62
    let vc      = 75.0
    var a_gut = d_oral
    var a1 = 0.0
    var a2 = 0.0
    var dose = 0
    while dose < n_total {
        if dose > 0 { a_gut = a_gut + d_oral };
        let ke_v = if dose >= n_switch { ke_post } else { ke_pre }
        let f_v  = if dose >= n_switch { f_post  } else { f_pre  }
        let j11 = 0.0 - (ke_v + k12_val)
        let j12 = k21_val
        let j21 = k12_val
        let j22 = 0.0 - k21_val
        var step = 0
        while step < 48 {
            let flux = f_v * ka_val * a_gut
            let new_ag = a_gut + 0.5 * (0.0 - ka_val * a_gut)
            let new_a1 = a1 + 0.5 * (j11 * a1 + j12 * a2 + flux)
            let new_a2 = a2 + 0.5 * (j21 * a1 + j22 * a2)
            a_gut = new_ag
            a1 = new_a1
            a2 = new_a2
            step = step + 1
        }
        dose = dose + 1
    }
    a1 / vc
}

// Trough at end of n_total doses, with std→ind switch at n_switch
pub fn if_trough_std_to_ind(d_oral: f64, n_total: i64, n_switch: i64) -> f64
    with Mut, Div, Panic {
    if_trough_with_switch(d_oral, n_total, n_switch,
                          cyp_ke_standard(), cyp_f_standard(),
                          ddi_ke_ind_strong(), ddi_f_ind_strong())
}

// Trough at end of n_total doses, with ind→std switch at n_switch (recovery)
pub fn if_trough_ind_to_std(d_oral: f64, n_total: i64, n_switch: i64) -> f64
    with Mut, Div, Panic {
    if_trough_with_switch(d_oral, n_total, n_switch,
                          ddi_ke_ind_strong(), ddi_f_ind_strong(),
                          cyp_ke_standard(), cyp_f_standard())
}

// ── Switch-day named scenarios — trough at +14 days post-switch ────────────

pub fn if_switch_day1_trough14()  -> f64 with Mut, Div, Panic {
    if_trough_std_to_ind(5.0, 15, 1)        // total 15, switch day 1
}
pub fn if_switch_day7_trough14()  -> f64 with Mut, Div, Panic {
    if_trough_std_to_ind(5.0, 21, 7)        // total 21, switch day 7
}
pub fn if_switch_day14_trough14() -> f64 with Mut, Div, Panic {
    if_trough_std_to_ind(5.0, 28, 14)       // total 28, switch day 14
}

// Did the trough cross below floor at +14 days post-switch?
pub fn if_switch_day1_alarms_floor()  -> bool with Mut, Div, Panic {
    if_switch_day1_trough14() < trough_floor_mg_l()
}
pub fn if_switch_day7_alarms_floor()  -> bool with Mut, Div, Panic {
    if_switch_day7_trough14() < trough_floor_mg_l()
}
pub fn if_switch_day14_alarms_floor() -> bool with Mut, Div, Panic {
    if_switch_day14_trough14() < trough_floor_mg_l()
}

// ── TDM intensification window ─────────────────────────────────────────────
// Count doses N ≥ n_switch where trough < floor (in std→ind transition at D=5mg)
pub fn if_tdm_intensification_days(n_switch: i64, max_n: i64) -> i64
    with Mut, Div, Panic {
    var n = n_switch
    var cnt = 0
    while n <= max_n {
        let c = if_trough_std_to_ind(5.0, n, n_switch)
        if c < trough_floor_mg_l() { cnt = cnt + 1 };
        n = n + 1
    }
    cnt
}

pub fn if_tdm_intensification_day1()  -> i64 with Mut, Div, Panic { if_tdm_intensification_days(1, 30)  }
pub fn if_tdm_intensification_day7()  -> i64 with Mut, Div, Panic { if_tdm_intensification_days(7, 30)  }
pub fn if_tdm_intensification_day14() -> i64 with Mut, Div, Panic { if_tdm_intensification_days(14, 30) }

// ── Dynamic ncrit: first N ≥ n_switch where trough re-enters [floor, ceil] ──
pub fn if_dynamic_ncrit_std_to_ind(n_switch: i64, max_n: i64) -> i64
    with Mut, Div, Panic {
    let floor = trough_floor_mg_l()
    let ceil  = trough_ceil_mg_l()
    var n = n_switch + 1
    var found = 0
    while n <= max_n {
        if found == 0 {
            let c = if_trough_std_to_ind(5.0, n, n_switch)
            if c >= floor && c <= ceil { found = n };
        };
        n = n + 1
    }
    found
}

pub fn if_dynamic_ncrit_day7() -> i64 with Mut, Div, Panic {
    if_dynamic_ncrit_std_to_ind(7, 50)
}

// ── Cross-check: no-switch reproduces as_trough_mg_l ───────────────────────
pub fn if_no_switch_matches_std() -> f64 with Mut, Div, Panic {
    if_trough_with_switch(5.0, 14, 100,    // n_switch > n_total → no switch
                          cyp_ke_standard(), cyp_f_standard(),
                          ddi_ke_ind_strong(), ddi_f_ind_strong())
}

pub fn if_no_switch_diff() -> f64 with Mut, Div, Panic {
    let with_switch = if_no_switch_matches_std()
    let direct = as_trough_mg_l(5.0, 14, cyp_ke_standard(), cyp_f_standard())
    if direct == 0.0 { 0.0 } else { (with_switch - direct) / direct }
}

// ── Asymmetric coupling: std→ind vs ind→std at matching N, switch day ────
// std→ind drops the trough; ind→std raises it (recovery).
pub fn if_std_to_ind_drops_more_than_ind_to_std_recovers() -> bool
    with Mut, Div, Panic {
    let base_std = as_trough_mg_l(5.0, 14, cyp_ke_standard(), cyp_f_standard())
    let base_ind = as_trough_mg_l(5.0, 14, ddi_ke_ind_strong(), ddi_f_ind_strong())
    let drop = base_std - if_trough_std_to_ind(5.0, 21, 7)    // post-7-day-switch
    let rise = if_trough_ind_to_std(5.0, 21, 7) - base_ind
    drop > rise
}

// Quick numeric exposures for the gate
pub fn if_floor_value() -> f64 { trough_floor_mg_l() }    // 0.004
pub fn if_ceil_value()  -> f64 { trough_ceil_mg_l() }     // 0.020

// Crossover marker (rapamycin_ddi.sio:122)
pub fn if_crossover_value() -> f64 with Mut, Div, Panic { ddi_ke_var_below_crossover() }
pub fn if_std_ke_var_below_crossover() -> bool with Mut, Div, Panic {
    ob_ke_var_std() < ddi_ke_var_below_crossover()
}
pub fn if_ind_ke_var_below_crossover() -> bool with Mut, Div, Panic {
    ddi_ke_var_ind() < ddi_ke_var_below_crossover()
}
