// stdlib/pbpk/rapamycin_sprint37_gate.sio — Sprint 37 certification gate
//
// Certifies assay-inclusive certification horizon: HPLC preserves model,
// fast assay-sensitivity, ind poor uncertifiable, penalty ordering.
//
// 56 assertions in sections A–H. All must pass (return 56).

module pbpk::rapamycin_sprint37_gate

use pbpk::rapamycin_cert_horizon::{
    ach_std_ncrit_model, ach_std_ncrit_hplc, ach_std_ncrit_cmia, ach_std_ncrit_poor,
    ach_std_penalty_cmia, ach_std_penalty_poor,
    ach_slow_ncrit_model, ach_slow_ncrit_hplc, ach_slow_ncrit_cmia, ach_slow_ncrit_poor,
    ach_fast_ncrit_model, ach_fast_ncrit_hplc, ach_fast_ncrit_cmia, ach_fast_ncrit_poor,
    ach_fast_penalty_cmia, ach_fast_penalty_poor,
    ach_inh_ncrit_model, ach_inh_ncrit_hplc, ach_inh_ncrit_cmia, ach_inh_ncrit_poor,
    ach_inh_penalty_cmia, ach_inh_penalty_poor,
    ach_ind_ncrit_model, ach_ind_ncrit_hplc, ach_ind_ncrit_cmia, ach_ind_ncrit_poor,
    ach_ind_penalty_hplc, ach_ind_penalty_cmia
}

pub fn rapamycin_sprint37_gate() -> i64 with Mut, Div, Panic {
    var score = 0

    // ── Section A: Model N_crit values confirmed ──────────────────────────────
    // std model N_crit = 6 (consistent with Sprint 26)
    if ach_std_ncrit_model() == 6 { score = score + 1 };
    // slow model N_crit = 3
    if ach_slow_ncrit_model() == 3 { score = score + 1 };
    // fast model N_crit = 15
    if ach_fast_ncrit_model() == 15 { score = score + 1 };
    // inh model N_crit = 7
    if ach_inh_ncrit_model() == 7 { score = score + 1 };
    // ind model N_crit = 26
    if ach_ind_ncrit_model() == 26 { score = score + 1 };
    // slow certifies earliest (N=3 — minimum among all strata)
    if ach_slow_ncrit_model() < ach_std_ncrit_model() { score = score + 1 };
    if ach_slow_ncrit_model() < ach_fast_ncrit_model() { score = score + 1 };

    // ── Section B: FINDING A — HPLC preserves model N_crit ───────────────────
    // std HPLC = 6 (0 penalty)
    if ach_std_ncrit_hplc() == 6 { score = score + 1 };
    if ach_std_ncrit_hplc() == ach_std_ncrit_model() { score = score + 1 };
    // slow HPLC = 3 (0 penalty)
    if ach_slow_ncrit_hplc() == 3 { score = score + 1 };
    // fast HPLC = 15 (0 penalty)
    if ach_fast_ncrit_hplc() == 15 { score = score + 1 };
    if ach_fast_ncrit_hplc() == ach_fast_ncrit_model() { score = score + 1 };
    // inh HPLC = 7 (0 penalty)
    if ach_inh_ncrit_hplc() == 7 { score = score + 1 };
    // ind HPLC = 27 (+1 penalty — only stratum HPLC cannot preserve)
    if ach_ind_ncrit_hplc() == 27 { score = score + 1 };
    if ach_ind_penalty_hplc() == 1 { score = score + 1 };

    // ── Section C: CMIA penalties ─────────────────────────────────────────────
    // std CMIA = 7 (+1)
    if ach_std_ncrit_cmia() == 7 { score = score + 1 };
    if ach_std_penalty_cmia() == 1 { score = score + 1 };
    // slow CMIA = 4 (+1)
    if ach_slow_ncrit_cmia() == 4 { score = score + 1 };
    // FINDING B — fast CMIA = 18 (+3, largest CMIA penalty)
    if ach_fast_ncrit_cmia() == 18 { score = score + 1 };
    if ach_fast_penalty_cmia() == 3 { score = score + 1 };
    // fast CMIA N=18 exceeds N=14 protocol checkpoint (requires extended monitoring)
    if ach_fast_ncrit_cmia() > 14 { score = score + 1 };
    // inh CMIA = 8 (+1)
    if ach_inh_ncrit_cmia() == 8 { score = score + 1 };
    if ach_inh_penalty_cmia() == 1 { score = score + 1 };
    // ind CMIA = 32 (+6)
    if ach_ind_ncrit_cmia() == 32 { score = score + 1 };
    if ach_ind_penalty_cmia() == 6 { score = score + 1 };

    // ── Section D: FINDING C — ind poor assay uncertifiable ──────────────────
    // ind D34 poor returns 0 (not certifiable within 60 doses)
    if ach_ind_ncrit_poor() == 0 { score = score + 1 };
    // All other strata certify within 60 under poor assay
    if ach_std_ncrit_poor() > 0 { score = score + 1 };
    if ach_slow_ncrit_poor() > 0 { score = score + 1 };
    if ach_fast_ncrit_poor() > 0 { score = score + 1 };
    if ach_inh_ncrit_poor() > 0 { score = score + 1 };
    // ind uniquely uncertifiable — only stratum where poor returns 0
    if ach_ind_ncrit_poor() < ach_std_ncrit_poor() { score = score + 1 };

    // ── Section E: FINDING B — fast is most assay-sensitive ──────────────────
    // fast poor penalty = 17 (largest absolute penalty)
    if ach_fast_ncrit_poor() == 32 { score = score + 1 };
    if ach_fast_penalty_poor() == 17 { score = score + 1 };
    // fast poor penalty > std poor penalty
    if ach_fast_penalty_poor() > ach_std_penalty_poor() { score = score + 1 };
    // fast poor penalty > inh poor penalty
    if ach_fast_penalty_poor() > ach_inh_penalty_poor() { score = score + 1 };
    // fast poor penalty > slow poor penalty
    if ach_fast_penalty_poor() > ach_slow_ncrit_poor() - ach_slow_ncrit_model() { score = score + 1 };

    // ── Section F: FINDING D — penalty ordering under poor ───────────────────
    // fast(17) > inh(7) > std(6) > slow(4)
    if ach_fast_penalty_poor() > ach_inh_penalty_poor() { score = score + 1 };
    if ach_inh_penalty_poor() > ach_std_penalty_poor() { score = score + 1 };
    if ach_std_penalty_poor() > ach_slow_ncrit_poor() - ach_slow_ncrit_model() { score = score + 1 };
    // inh poor penalty = 7
    if ach_inh_ncrit_poor() == 14 { score = score + 1 };
    if ach_inh_penalty_poor() == 7 { score = score + 1 };
    // std poor penalty = 6
    if ach_std_ncrit_poor() == 12 { score = score + 1 };
    if ach_std_penalty_poor() == 6 { score = score + 1 };

    // ── Section G: Monotone ordering N_crit model ≤ hplc ≤ cmia ≤ poor ───────
    if ach_std_ncrit_model() <= ach_std_ncrit_hplc() { score = score + 1 };
    if ach_std_ncrit_hplc() <= ach_std_ncrit_cmia() { score = score + 1 };
    if ach_std_ncrit_cmia() <= ach_std_ncrit_poor() { score = score + 1 };
    if ach_fast_ncrit_model() <= ach_fast_ncrit_hplc() { score = score + 1 };
    if ach_fast_ncrit_hplc() <= ach_fast_ncrit_cmia() { score = score + 1 };
    if ach_fast_ncrit_cmia() <= ach_fast_ncrit_poor() { score = score + 1 };

    // ── Section H: Cross-stratum absolute N_crit ordering ────────────────────
    // slow always certifies first (N=3 model, N=7 poor) — fastest across all assays
    if ach_slow_ncrit_poor() < ach_std_ncrit_poor() { score = score + 1 };
    if ach_slow_ncrit_poor() < ach_fast_ncrit_poor() { score = score + 1 };
    if ach_slow_ncrit_poor() < ach_inh_ncrit_poor() { score = score + 1 };
    // fast certifies latest (N=15 model, N=32 poor)
    if ach_fast_ncrit_poor() > ach_std_ncrit_poor() { score = score + 1 };
    if ach_fast_ncrit_poor() > ach_inh_ncrit_poor() { score = score + 1 };
    // CMIA fast (18) > CMIA ind (undefined; cmia ind=32) — ind worst under CMIA
    if ach_ind_ncrit_cmia() > ach_fast_ncrit_cmia() { score = score + 1 };
    // slow poor exact = 7 (4 doses beyond model N=3)
    if ach_slow_ncrit_poor() == 7 { score = score + 1 };

    score
}
