// stdlib/pbpk/rapamycin_sprint59_gate.sio — Sprint 59 certification gate
//
// Population-weighted expected GUM margin at standard monitoring visits.
//
// E[margin] values:
//   N=7:  2.223  (inh=0.160, slow=0.213, std=1.410, fast=0.412, ind=0.029)
//   N=14: 5.637  (inh=0.488, slow=0.938, std=3.216, fast=0.877, ind=0.118)
//   N=28: 5.452  (inh=0.439, slow=1.811, std=2.345, fast=0.645, ind=0.212)
//   gain N=7→14: +3.413 (largest single-interval jump)
//   gain N=14→28: −0.185 (slight regression — Finding A)
//   gain N=7→28:  +3.229
//
// Finding A: E[margin] peaks at N=14, not N=28; gain N=14→28 = −0.185.
//            The week-2 visit is the pharmacokinetically optimal monitoring
//            point for the population as a whole.
// Finding B: std (w=0.50) drives the N=14 peak — contribution 3.216 at N=14
//            vs 2.345 at N=28; std peaks at N=19 and is descending by N=28.
// Finding C: slow and ind both gain N=14→28 (late-peaking strata, partially
//            offsetting the descent); slow: 0.938→1.811, ind: 0.118→0.212.
// Finding D: gain N=7→14 = 3.413 — the largest epistemic jump of any interval,
//            driven by u_c contraction across all five strata simultaneously.
//
// 56 assertions in sections A–H. All must pass (return 56).

module pbpk::rapamycin_sprint59_gate

use pbpk::rapamycin_expected_margin::{
    em_inh_contribution_n7,  em_slow_contribution_n7,  em_std_contribution_n7,
    em_fast_contribution_n7, em_ind_contribution_n7,
    em_inh_contribution_n14, em_slow_contribution_n14, em_std_contribution_n14,
    em_fast_contribution_n14,em_ind_contribution_n14,
    em_inh_contribution_n28, em_slow_contribution_n28, em_std_contribution_n28,
    em_fast_contribution_n28,em_ind_contribution_n28,
    em_expected_margin_n7, em_expected_margin_n14, em_expected_margin_n28,
    em_gain_n7_to_n14, em_gain_n14_to_n28, em_gain_n7_to_n28
}

pub fn rapamycin_sprint59_gate() -> i64 with Mut, Div, Panic {
    var score = 0

    // ── Section A: N=7 expected margin ≈ 2.223 ───────────────────────────────
    if em_expected_margin_n7() > 2.2 { score = score + 1 };
    if em_expected_margin_n7() < 2.3 { score = score + 1 };
    if em_expected_margin_n7() > 2.0 { score = score + 1 };
    if em_std_contribution_n7() > 1.4 { score = score + 1 };
    if em_std_contribution_n7() < 1.5 { score = score + 1 };
    if em_ind_contribution_n7() < 0.05 { score = score + 1 };
    if em_slow_contribution_n7() > 0.2 { score = score + 1 };

    // ── Section B: N=14 expected margin ≈ 5.637 ──────────────────────────────
    if em_expected_margin_n14() > 5.5 { score = score + 1 };
    if em_expected_margin_n14() < 5.8 { score = score + 1 };
    if em_expected_margin_n14() > 5.6 { score = score + 1 };
    if em_std_contribution_n14() > 3.2 { score = score + 1 };
    if em_std_contribution_n14() < 3.3 { score = score + 1 };
    if em_slow_contribution_n14() > 0.9 { score = score + 1 };
    if em_slow_contribution_n14() < 1.0 { score = score + 1 };

    // ── Section C: N=28 expected margin ≈ 5.452 ──────────────────────────────
    if em_expected_margin_n28() > 5.3 { score = score + 1 };
    if em_expected_margin_n28() < 5.6 { score = score + 1 };
    if em_expected_margin_n28() > 5.4 { score = score + 1 };
    if em_slow_contribution_n28() > 1.8 { score = score + 1 };
    if em_slow_contribution_n28() < 1.85 { score = score + 1 };
    if em_ind_contribution_n28() > 0.2 { score = score + 1 };
    if em_ind_contribution_n28() < 0.25 { score = score + 1 };

    // ── Section D: peak at N=14 — Finding A ──────────────────────────────────
    if em_expected_margin_n14() > em_expected_margin_n7() { score = score + 1 };
    if em_expected_margin_n14() > em_expected_margin_n28() { score = score + 1 };
    if em_expected_margin_n28() > em_expected_margin_n7() { score = score + 1 };
    if em_gain_n7_to_n14() > 3.4 { score = score + 1 };
    if em_gain_n14_to_n28() < 0.0 { score = score + 1 };
    if em_gain_n14_to_n28() > -0.25 { score = score + 1 };
    if em_gain_n7_to_n28() > 3.2 { score = score + 1 };

    // ── Section E: std dominance at N=14 (Finding B) ─────────────────────────
    if em_std_contribution_n14() > em_std_contribution_n7() { score = score + 1 };
    if em_std_contribution_n14() > em_std_contribution_n28() { score = score + 1 };
    if em_std_contribution_n7() > 1.4 { score = score + 1 };
    if em_std_contribution_n14() > 3.2 { score = score + 1 };
    if em_std_contribution_n28() > 2.3 { score = score + 1 };
    if em_std_contribution_n28() < 2.4 { score = score + 1 };
    if em_std_contribution_n14() > em_std_contribution_n28() + 0.8 { score = score + 1 };

    // ── Section F: slow late emergence (Finding C) ───────────────────────────
    if em_slow_contribution_n28() > em_slow_contribution_n14() { score = score + 1 };
    if em_slow_contribution_n14() > em_slow_contribution_n7() { score = score + 1 };
    if em_slow_contribution_n7() > 0.2 { score = score + 1 };
    if em_slow_contribution_n7() < 0.25 { score = score + 1 };
    if em_slow_contribution_n14() > 0.93 { score = score + 1 };
    if em_slow_contribution_n28() > 1.8 { score = score + 1 };
    if em_slow_contribution_n28() > em_slow_contribution_n7() + 1.5 { score = score + 1 };

    // ── Section G: ind late emergence ────────────────────────────────────────
    if em_ind_contribution_n28() > em_ind_contribution_n14() { score = score + 1 };
    if em_ind_contribution_n14() > em_ind_contribution_n7() { score = score + 1 };
    if em_ind_contribution_n7() < 0.05 { score = score + 1 };
    if em_ind_contribution_n14() > 0.1 { score = score + 1 };
    if em_ind_contribution_n14() < 0.15 { score = score + 1 };
    if em_ind_contribution_n28() > 0.2 { score = score + 1 };
    if em_ind_contribution_n28() < 0.25 { score = score + 1 };

    // ── Section H: policy — week-2 is optimal; gains largest N=7→14 ──────────
    if em_expected_margin_n7()  > 2.0 { score = score + 1 };
    if em_expected_margin_n14() > 5.0 { score = score + 1 };
    if em_expected_margin_n28() > 5.0 { score = score + 1 };
    if em_expected_margin_n14() > em_expected_margin_n28() { score = score + 1 };
    if em_gain_n7_to_n14() > 3.0 { score = score + 1 };
    if em_gain_n14_to_n28() > -0.3 { score = score + 1 };
    if em_gain_n7_to_n28() > 3.0 { score = score + 1 };

    score
}
