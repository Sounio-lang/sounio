// stdlib/pbpk/rapamycin_monitoring_protocol.sio — Sprint 42
//
// Scheduled monitoring protocol evaluation: certification status at standard
// clinical visits N=7 (week 1), N=14 (week 2), N=28 (month 1) for each
// pharmacogenomic stratum at their correct optimal dose.
//
// Finding A: fast sub-therapeutic at week-1 check — Z_floor=-0.538 at N=7
//            (C=0.003607 < floor=0.004); still uncertified at N=14 (m=1.844);
//            certifies with strong margin by month-1 (m=5.131 at N=28).
// Finding B: slow toxicity between visits — certified at week-2 (m=5.315);
//            overtly toxic at month-1 (Z_ceil=-2.536, C=0.023 > ceil=0.020);
//            toxicity occurs at N=23, between scheduled N=14 and N=28 visits.
// Finding C: ind just-certifies at month-1 — margin increases monotonically
//            (0.289 → 1.174 → 2.103); floor is binding at every visit;
//            Z_ceil=5.949 at N=28 (ceiling never a constraint for ind).
// Finding D: inh exceptional ceiling margin — Z_ceil=40.896 at N=7; ceiling
//            is irrelevant for inh at correct 1.5mg dose; floor alone drives
//            certification.

module pbpk::rapamycin_monitoring_protocol

use pbpk::rapamycin_assay::{as_trough_mg_l}
use pbpk::rapamycin_expanded_u::{eu_u_c}
use pbpk::rapamycin_clinical::{trough_floor_mg_l, trough_ceil_mg_l}
use pbpk::rapamycin_oral_budget::{
    ob_ka_var_std, ob_f_var_std, ob_ke_var_std, ob_k12_var_std, ob_k21_var_std,
    ob_ke_var_inh, ob_ke_var_ind
}

fn mp_min(a: f64, b: f64) -> f64 { if a < b { a } else { b } }

fn mp_margin(d: f64, n: i64, ke: f64, f: f64,
             ka_v: f64, fv: f64, ke_v: f64, k12_v: f64, k21_v: f64) -> f64
    with Mut, Div, Panic {
    let c  = as_trough_mg_l(d, n, ke, f)
    let uc = eu_u_c(d, n, ke, f, ka_v, fv, ke_v, k12_v, k21_v)
    mp_min((c - trough_floor_mg_l()) / uc, (trough_ceil_mg_l() - c) / uc)
}
fn mp_zf(d: f64, n: i64, ke: f64, f: f64,
         ka_v: f64, fv: f64, ke_v: f64, k12_v: f64, k21_v: f64) -> f64
    with Mut, Div, Panic {
    let c  = as_trough_mg_l(d, n, ke, f)
    let uc = eu_u_c(d, n, ke, f, ka_v, fv, ke_v, k12_v, k21_v)
    (c - trough_floor_mg_l()) / uc
}
fn mp_zc(d: f64, n: i64, ke: f64, f: f64,
         ka_v: f64, fv: f64, ke_v: f64, k12_v: f64, k21_v: f64) -> f64
    with Mut, Div, Panic {
    let c  = as_trough_mg_l(d, n, ke, f)
    let uc = eu_u_c(d, n, ke, f, ka_v, fv, ke_v, k12_v, k21_v)
    (trough_ceil_mg_l() - c) / uc
}

// ── std D=5mg ke=0.01118 F=0.141 ────────────────────────────────────────────
pub fn mp_std_margin_n7() -> f64 with Mut, Div, Panic {
    let ka=ob_ka_var_std(); let fv=ob_f_var_std(); let ke=ob_ke_var_std()
    let k12=ob_k12_var_std(); let k21=ob_k21_var_std()
    mp_margin(5.0,7,0.01118,0.141, ka,fv,ke,k12,k21)
}
pub fn mp_std_margin_n14() -> f64 with Mut, Div, Panic {
    let ka=ob_ka_var_std(); let fv=ob_f_var_std(); let ke=ob_ke_var_std()
    let k12=ob_k12_var_std(); let k21=ob_k21_var_std()
    mp_margin(5.0,14,0.01118,0.141, ka,fv,ke,k12,k21)
}
pub fn mp_std_margin_n28() -> f64 with Mut, Div, Panic {
    let ka=ob_ka_var_std(); let fv=ob_f_var_std(); let ke=ob_ke_var_std()
    let k12=ob_k12_var_std(); let k21=ob_k21_var_std()
    mp_margin(5.0,28,0.01118,0.141, ka,fv,ke,k12,k21)
}
pub fn mp_std_cert_n7() -> bool with Mut, Div, Panic { mp_std_margin_n7() >= 2.0 }
pub fn mp_std_cert_n14() -> bool with Mut, Div, Panic { mp_std_margin_n14() >= 2.0 }
pub fn mp_std_cert_n28() -> bool with Mut, Div, Panic { mp_std_margin_n28() >= 2.0 }

