// stdlib/pbpk/rapamycin_sprint50_gate.sio — Sprint 50 certification gate
//
// Adjusted protocol (slow at D=2.5mg) vs standard (Sprint 46).
//
// Adjusted values:
//   N=7:  cert=0.55, warn=0.25, alarm=0.20  (Δcert=-0.15, Δwarn=+0.15, Δalarm=0)
//   N=14: cert=0.70, warn=0.30, alarm=0.00  (identical to standard)
//   N=28: cert=1.00, warn=0.00, alarm=0.00  (Δcert=+0.15, Δalarm=-0.15)
//
// Symmetric swap: the slow-stratum weight (0.15pp) that was CERT at N=7
// becomes WARN; the same 0.15pp that was ALARM at N=28 becomes CERT.
// Week-2 visit is completely unaffected (slow N_crit=8 < 14).
//
// 56 assertions in sections A–H. All must pass (return 56).

module pbpk::rapamycin_sprint50_gate

use pbpk::rapamycin_adjusted_coverage::{
    ac_cert_n7,  ac_warn_n7,  ac_alarm_n7,
    ac_cert_n14, ac_warn_n14, ac_alarm_n14,
    ac_cert_n28, ac_warn_n28, ac_alarm_n28
}
use pbpk::rapamycin_population_coverage::{
    pc_cert_n7,  pc_warn_n7,  pc_alarm_n7,
    pc_cert_n14, pc_warn_n14, pc_alarm_n14,
    pc_cert_n28, pc_warn_n28, pc_alarm_n28
}

pub fn rapamycin_sprint50_gate() -> i64 with Mut, Div, Panic {
    var score = 0

    // ── Section A: adjusted N=7 profile (cert=0.55, warn=0.25, alarm=0.20) ───
    if ac_cert_n7() > 0.54 { score = score + 1 };
    if ac_cert_n7() < 0.56 { score = score + 1 };
    if ac_warn_n7() > 0.24 { score = score + 1 };
    if ac_warn_n7() < 0.26 { score = score + 1 };
    if ac_alarm_n7() > 0.19 { score = score + 1 };
    if ac_alarm_n7() < 0.21 { score = score + 1 };
    if ac_cert_n7() + ac_warn_n7() + ac_alarm_n7() > 0.999 { score = score + 1 };

    // ── Section B: adjusted N=14 profile — identical to standard ──────────────
    if ac_cert_n14() > 0.69 { score = score + 1 };
    if ac_cert_n14() < 0.71 { score = score + 1 };
    if ac_warn_n14() > 0.29 { score = score + 1 };
    if ac_warn_n14() < 0.31 { score = score + 1 };
    if ac_alarm_n14() < 0.001 { score = score + 1 };
    if ac_cert_n14() > ac_warn_n14() { score = score + 1 };
    if ac_cert_n14() + ac_warn_n14() + ac_alarm_n14() > 0.999 { score = score + 1 };

    // ── Section C: adjusted N=28 — fully certified ────────────────────────────
    if ac_cert_n28() > 0.999 { score = score + 1 };
    if ac_cert_n28() < 1.001 { score = score + 1 };
    if ac_warn_n28() < 0.001 { score = score + 1 };
    if ac_alarm_n28() < 0.001 { score = score + 1 };
    if ac_cert_n28() + ac_warn_n28() + ac_alarm_n28() > 0.999 { score = score + 1 };
    if ac_cert_n28() > 0.99 { score = score + 1 };
    if ac_alarm_n28() < ac_cert_n28() * 0.001 { score = score + 1 };

    // ── Section D: Finding A — week-1 trade-off ───────────────────────────────
    if ac_cert_n7() < pc_cert_n7() { score = score + 1 };
    if ac_warn_n7() > pc_warn_n7() { score = score + 1 };
    if ac_alarm_n7() > pc_alarm_n7() - 0.001 { score = score + 1 };
    if ac_alarm_n7() < pc_alarm_n7() + 0.001 { score = score + 1 };
    if pc_cert_n7() - ac_cert_n7() > 0.14 { score = score + 1 };
    if ac_warn_n7() - pc_warn_n7() > 0.14 { score = score + 1 };
    if pc_cert_n7() - ac_cert_n7() < 0.16 { score = score + 1 };

    // ── Section E: Finding B — week-2 unchanged ───────────────────────────────
    if ac_cert_n14() > pc_cert_n14() - 0.001 { score = score + 1 };
    if ac_cert_n14() < pc_cert_n14() + 0.001 { score = score + 1 };
    if ac_warn_n14() > pc_warn_n14() - 0.001 { score = score + 1 };
    if ac_warn_n14() < pc_warn_n14() + 0.001 { score = score + 1 };
    if ac_cert_n14() + ac_warn_n14() > 0.99 { score = score + 1 };
    if ac_cert_n14() > 0.69 { score = score + 1 };
    if ac_warn_n14() + ac_alarm_n14() < ac_cert_n14() { score = score + 1 };

    // ── Section F: Finding C — month-1 alarm eliminated ──────────────────────
    if ac_alarm_n28() < pc_alarm_n28() - 0.10 { score = score + 1 };
    if ac_cert_n28() > pc_cert_n28() { score = score + 1 };
    if ac_cert_n28() > pc_cert_n28() + 0.14 { score = score + 1 };
    if ac_alarm_n28() < pc_alarm_n28() { score = score + 1 };
    if pc_alarm_n28() - ac_alarm_n28() > 0.14 { score = score + 1 };
    if ac_cert_n28() + ac_alarm_n28() > 0.999 { score = score + 1 };
    if ac_alarm_n28() < pc_alarm_n28() - 0.14 { score = score + 1 };

    // ── Section G: Finding D — symmetric swap (|Δcert_n7| = |Δalarm_n28|) ────
    // The slow weight (0.15) appears in Δcert_n7 and Δalarm_n28 with equal magnitude
    if ac_cert_n7() + pc_alarm_n28() > pc_cert_n7() + ac_alarm_n28() - 0.001 { score = score + 1 };
    if ac_cert_n7() + pc_alarm_n28() < pc_cert_n7() + ac_alarm_n28() + 0.001 { score = score + 1 };
    if ac_warn_n7() > 2.0 * pc_warn_n7() - 0.001 { score = score + 1 };
    if ac_cert_n28() > ac_cert_n7() + 0.44 { score = score + 1 };
    if ac_alarm_n7() > ac_alarm_n28() { score = score + 1 };
    if ac_alarm_n7() > 10.0 * ac_alarm_n28() + 0.1 { score = score + 1 };
    if pc_cert_n28() - ac_cert_n7() > 0.29 { score = score + 1 };

    // ── Section H: policy implications ────────────────────────────────────────
    if ac_cert_n28() > ac_cert_n7() { score = score + 1 };
    if ac_cert_n28() - ac_cert_n7() > 0.44 { score = score + 1 };
    if ac_cert_n14() > ac_cert_n7() { score = score + 1 };
    if ac_cert_n28() > ac_cert_n14() { score = score + 1 };
    if ac_alarm_n28() + ac_alarm_n14() + ac_alarm_n7() < 0.25 { score = score + 1 };
    if pc_alarm_n28() + pc_alarm_n14() + pc_alarm_n7() > ac_alarm_n28() + ac_alarm_n14() + ac_alarm_n7() { score = score + 1 };
    if ac_cert_n7() + ac_cert_n14() + ac_cert_n28() > 2.20 { score = score + 1 };

    score
}
