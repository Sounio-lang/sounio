    mst_sqrt(as_v_pred_conc(mst_dose_ind(), 14, mst_ind_ke(), mst_ind_F(),
        ob_ka_var_std(), ob_f_var_std(), ddi_ke_var_ind(),
        ob_k12_var_std(), ob_k21_var_std()))
}

// ── 10. k-to-match for ind (§F) ─────────────────────────────────────────────

pub fn mst_k_to_match_lcms_ind_n14() -> i64 with Mut, Div, Panic {
    mst_k_to_match_lcms(mst_dose_ind(), 14, mst_ind_ke(), mst_ind_F(),
        ob_ka_var_std(), ob_f_var_std(), ddi_ke_var_ind(),
        ob_k12_var_std(), ob_k21_var_std())
}
