// ── 9. Posterior u_post (mg/L) per cell — used by §D ────────────────────────

pub fn mst_u_post_std_n14_lcms() -> f64 with Mut, Div, Panic {
    mst_sqrt(mst_posterior(mst_dose_std(), 14, mst_std_ke(), mst_std_F(),
        ob_ka_var_std(), ob_f_var_std(), ob_ke_var_std(),
        ob_k12_var_std(), ob_k21_var_std(), as_cv_hplc()).variance)
}
pub fn mst_u_post_std_n14_cmia() -> f64 with Mut, Div, Panic {
    mst_sqrt(mst_posterior(mst_dose_std(), 14, mst_std_ke(), mst_std_F(),
        ob_ka_var_std(), ob_f_var_std(), ob_ke_var_std(),
        ob_k12_var_std(), ob_k21_var_std(), as_cv_cmia()).variance)
}
pub fn mst_u_post_ind_n14_lcms() -> f64 with Mut, Div, Panic {
    mst_sqrt(mst_posterior(mst_dose_ind(), 14, mst_ind_ke(), mst_ind_F(),
        ob_ka_var_std(), ob_f_var_std(), ddi_ke_var_ind(),
        ob_k12_var_std(), ob_k21_var_std(), as_cv_hplc()).variance)
}

// Prior u_pk per cell — used by §D
pub fn mst_u_pk_std_n14() -> f64 with Mut, Div, Panic {
    mst_sqrt(as_v_pred_conc(mst_dose_std(), 14, mst_std_ke(), mst_std_F(),
        ob_ka_var_std(), ob_f_var_std(), ob_ke_var_std(),
        ob_k12_var_std(), ob_k21_var_std()))
}
