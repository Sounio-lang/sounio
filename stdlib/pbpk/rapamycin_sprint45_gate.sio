// stdlib/pbpk/rapamycin_sprint45_gate.sio — Sprint 45 certification gate
//
// Peak GUM margin analysis across five strata.
// N_peak = argmax margin(N) over N∈[1,60]; N_cross = first N where Z_ceil < Z_floor.
//
// Finding A: std unimodal — N_peak=19, margin_peak=8.442; Z_ceil exceeds
//            Z_floor by 0.155σ at N=19; crossing at N=20.
// Finding B: slow earliest peak — N_peak=10, margin_peak=7.755; highest F
//            drives fastest accumulation; Z_ceil-Z_floor gap=0.779σ at peak.
// Finding C: inh highest peak margin — N_peak=22, margin_peak=14.302; reduced
//            dose + slowest ke centres concentration with maximum σ-headroom.
// Finding D: fast and ind monotone — N_peak=60, N_cross=0; ceiling never
//            binds within 60 doses; floor alone drives the margin trajectory.
//
// 56 assertions in sections A–H. All must pass (return 56).

module pbpk::rapamycin_sprint45_gate

use pbpk::rapamycin_margin_peak::{
    pm_std_npeak, pm_std_margin_peak, pm_std_zf_npeak, pm_std_zc_npeak, pm_std_ncross,
    pm_slow_npeak, pm_slow_margin_peak, pm_slow_zf_npeak, pm_slow_zc_npeak, pm_slow_ncross,
    pm_fast_npeak, pm_fast_margin_peak, pm_fast_margin_n15, pm_fast_margin_n30, pm_fast_ncross,
    pm_inh_npeak, pm_inh_margin_peak, pm_inh_zf_npeak, pm_inh_zc_npeak, pm_inh_ncross,
    pm_ind_npeak, pm_ind_margin_peak, pm_ind_margin_n26, pm_ind_margin_n45, pm_ind_ncross
}

pub fn rapamycin_sprint45_gate() -> i64 with Mut, Div, Panic {
    var score = 0

    // ── Section A: N_peak classification — three unimodal, two monotone ──────
    // std=19, slow=10, inh=22, fast=60, ind=60
    if pm_std_npeak() > 18 && pm_std_npeak() < 20 { score = score + 1 };
    if pm_slow_npeak() > 9 && pm_slow_npeak() < 11 { score = score + 1 };
    if pm_inh_npeak() > 21 && pm_inh_npeak() < 23 { score = score + 1 };
    if pm_fast_npeak() > 59 { score = score + 1 };
    if pm_ind_npeak() > 59 { score = score + 1 };
    // Slow peaks earliest of all five strata
    if pm_slow_npeak() < pm_std_npeak() { score = score + 1 };
    // inh peaks latest of the three unimodal strata
    if pm_inh_npeak() > pm_std_npeak() { score = score + 1 };

    // ── Section B: N_cross and N_peak = N_cross − 1 for unimodal strata ──────
    // std: N_cross=20; slow: N_cross=11; inh: N_cross=23
    if pm_std_ncross() > 19 && pm_std_ncross() < 21 { score = score + 1 };
    if pm_slow_ncross() > 10 && pm_slow_ncross() < 12 { score = score + 1 };
    if pm_inh_ncross() > 22 && pm_inh_ncross() < 24 { score = score + 1 };
    // fast and ind: ceiling never becomes binding (N_cross=0)
    if pm_fast_ncross() < 1 { score = score + 1 };
    if pm_ind_ncross() < 1 { score = score + 1 };
    // N_cross = N_peak + 1 exactly for std (discrete floor-to-ceiling switch)
    if pm_std_ncross() - pm_std_npeak() > 0 && pm_std_ncross() - pm_std_npeak() < 2 { score = score + 1 };
    // N_cross = N_peak + 1 exactly for inh
    if pm_inh_ncross() - pm_inh_npeak() > 0 && pm_inh_ncross() - pm_inh_npeak() < 2 { score = score + 1 };

    // ── Section C: FINDING A — std unimodal peak profile ─────────────────────
    // N_peak=19: margin=8.442, zf=8.442 (floor-limited), zc=8.597
    if pm_std_margin_peak() > 8.4 { score = score + 1 };
    if pm_std_margin_peak() < 8.5 { score = score + 1 };
    if pm_std_zf_npeak() > 8.4 && pm_std_zf_npeak() < 8.5 { score = score + 1 };
    if pm_std_zc_npeak() > 8.5 && pm_std_zc_npeak() < 8.7 { score = score + 1 };
    // Floor is the binding constraint at N_peak (zc > zf)
    if pm_std_zc_npeak() > pm_std_zf_npeak() { score = score + 1 };
    // Z_ceil exceeds Z_floor by 0.1–0.2σ at peak (concentration nearly centred)
    if pm_std_zc_npeak() - pm_std_zf_npeak() > 0.1 && pm_std_zc_npeak() - pm_std_zf_npeak() < 0.2 { score = score + 1 };
    // Crossing happens one dose after peak
    if pm_std_ncross() > pm_std_npeak() { score = score + 1 };

    // ── Section D: FINDING B — slow earliest peak ─────────────────────────────
    // N_peak=10: margin=7.755, zf=7.755 (floor-limited), zc=8.534
    if pm_slow_margin_peak() > 7.7 && pm_slow_margin_peak() < 7.8 { score = score + 1 };
    if pm_slow_zf_npeak() > 7.7 && pm_slow_zf_npeak() < 7.8 { score = score + 1 };
    if pm_slow_zc_npeak() > 8.5 && pm_slow_zc_npeak() < 8.6 { score = score + 1 };
    // Floor is the binding constraint at N_peak
    if pm_slow_zc_npeak() > pm_slow_zf_npeak() { score = score + 1 };
    // Z_ceil-Z_floor gap larger for slow than std at their respective peaks (0.779 vs 0.155)
    if pm_slow_zc_npeak() - pm_slow_zf_npeak() > pm_std_zc_npeak() - pm_std_zf_npeak() { score = score + 1 };
    // N_cross = N_peak + 1 for slow
    if pm_slow_ncross() - pm_slow_npeak() > 0 && pm_slow_ncross() - pm_slow_npeak() < 2 { score = score + 1 };
    // Slow peak margin less than std peak margin (faster accumulation, earlier tilt)
    if pm_slow_margin_peak() < pm_std_margin_peak() { score = score + 1 };

    // ── Section E: FINDING C — inh highest peak margin ───────────────────────
    // N_peak=22: margin=14.302, zf=14.302 (floor-limited), zc=14.921
    if pm_inh_margin_peak() > 14.3 && pm_inh_margin_peak() < 14.4 { score = score + 1 };
    if pm_inh_zf_npeak() > 14.3 && pm_inh_zf_npeak() < 14.4 { score = score + 1 };
    if pm_inh_zc_npeak() > 14.9 && pm_inh_zc_npeak() < 15.0 { score = score + 1 };
    // Floor is the binding constraint at N_peak
    if pm_inh_zc_npeak() > pm_inh_zf_npeak() { score = score + 1 };
    // Z_ceil-Z_floor gap at inh peak: 0.619σ (between std 0.155 and slow 0.779)
    if pm_inh_zc_npeak() - pm_inh_zf_npeak() > 0.6 && pm_inh_zc_npeak() - pm_inh_zf_npeak() < 0.7 { score = score + 1 };
    // inh peak margin exceeds std peak margin by more than 5σ (14.302 > 8.442+5)
    if pm_inh_margin_peak() > pm_std_margin_peak() + 5.0 { score = score + 1 };
    // inh peak margin exceeds slow peak margin by more than 6σ (14.302 > 7.755+6)
    if pm_inh_margin_peak() > pm_slow_margin_peak() + 6.0 { score = score + 1 };

    // ── Section F: FINDING D — fast monotone, floor-limited throughout ────────
    // Margin grows: N=15: 2.139 → N=30: 5.478 → N=60: 8.577
    if pm_fast_margin_peak() > 8.5 && pm_fast_margin_peak() < 9.0 { score = score + 1 };
    if pm_fast_margin_n15() > 2.1 && pm_fast_margin_n15() < 2.2 { score = score + 1 };
    if pm_fast_margin_n30() > 5.4 && pm_fast_margin_n30() < 5.6 { score = score + 1 };
    // Monotone: N=15 < N=30 < N=60
    if pm_fast_margin_n15() < pm_fast_margin_n30() { score = score + 1 };
    if pm_fast_margin_n30() < pm_fast_margin_peak() { score = score + 1 };
    // fast peak exceeds 3× its N_crit margin (8.577 > 2.139 × 3 = 6.417)
    if pm_fast_margin_peak() > pm_fast_margin_n15() * 3.0 { score = score + 1 };
    // fast N_peak extends >30 doses beyond inh N_peak (60 > 22+30=52)
    if pm_fast_npeak() > pm_inh_npeak() + 30 { score = score + 1 };

    // ── Section G: FINDING E — ind monotone, lowest peak margin of all ────────
    // Margin grows: N=26: 2.015 → N=45: 2.534 → N=60: 2.673
    if pm_ind_margin_peak() > 2.6 && pm_ind_margin_peak() < 2.8 { score = score + 1 };
    if pm_ind_margin_n26() > 2.0 && pm_ind_margin_n26() < 2.1 { score = score + 1 };
    if pm_ind_margin_n45() > 2.5 && pm_ind_margin_n45() < 2.6 { score = score + 1 };
    // Monotone: N=26 < N=45 < N=60
    if pm_ind_margin_n26() < pm_ind_margin_n45() { score = score + 1 };
    if pm_ind_margin_n45() < pm_ind_margin_peak() { score = score + 1 };
    // ind peak margin lowest of all five strata (2.673 < slow 7.755)
    if pm_ind_margin_peak() < pm_slow_margin_peak() { score = score + 1 };
    // ind N_peak extends >30 doses beyond inh N_peak
    if pm_ind_npeak() > pm_inh_npeak() + 30 { score = score + 1 };

    // ── Section H: cross-stratum peak comparisons ─────────────────────────────
    // inh highest peak margin of all five strata
    if pm_inh_margin_peak() > pm_std_margin_peak() { score = score + 1 };
    // std peak > slow peak (unimodal ranking)
    if pm_std_margin_peak() > pm_slow_margin_peak() { score = score + 1 };
    // fast "peak" > ind "peak" (both monotone, fast floor-limited less severely)
    if pm_fast_margin_peak() > pm_ind_margin_peak() { score = score + 1 };
    // fast peak ≈ std peak (both near 8.5σ, different mechanism)
    if pm_fast_margin_peak() > pm_std_margin_peak() { score = score + 1 };
    // N_peak ordering: slow (10) < std (19) < inh (22) for unimodal strata
    if pm_std_npeak() - pm_slow_npeak() > 8 { score = score + 1 };
    // inh N_peak only 3 doses after std N_peak (22 vs 19)
    if pm_inh_npeak() - pm_std_npeak() > 2 && pm_inh_npeak() - pm_std_npeak() < 5 { score = score + 1 };
    // slow peak margin exceeds ind peak margin by more than 2× (7.755 > 2.673×2=5.346)
    if pm_slow_margin_peak() > pm_ind_margin_peak() * 2.0 { score = score + 1 };

    score
}
