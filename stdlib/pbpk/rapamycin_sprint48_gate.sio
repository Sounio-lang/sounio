// stdlib/pbpk/rapamycin_sprint48_gate.sio — Sprint 48 certification gate
//
// GUM-certified dose adjustment for the slow stratum at month-1 (N=28).
// Dose scan in 0.5mg steps, D∈[0.5, 5.0].
//
// Actual values:
//   D=0.5mg: margin=-13.359 (ALARM, sub-therapeutic)
//   D=1.0mg: margin= 2.536 (CERT, lower boundary)
//   D=1.5mg: margin= 7.835 (CERT)
//   D=2.0mg: margin=10.484 (CERT)
//   D=2.5mg: margin=12.073 (CERT, OPTIMAL — maximum margin)
//   D=3.0mg: margin= 8.061 (CERT, ceiling-limited)
//   D=3.5mg: margin= 4.276 (CERT, upper boundary)
//   D=4.0mg: margin= 1.438 (WARN, below k=2.0)
//   D=4.5mg: margin=-0.770 (ALARM, supra-therapeutic)
//   D=5.0mg: margin=-2.536 (ALARM, standard adult dose fails)
//
// Mirror identity: margin(1mg) = +2.536 = -margin(5mg); exact negatives because
// C(5mg)=ceil+δ and C(1mg)=floor+δ/5, U_c∝D → Z_ceil(5mg)=-Z_floor(1mg).
//
// 56 assertions in sections A–H. All must pass (return 56).

module pbpk::rapamycin_sprint48_gate

use pbpk::rapamycin_dose_adjust::{
    da_slow_margin_n28_d05, da_slow_margin_n28_d10, da_slow_margin_n28_d15,
    da_slow_margin_n28_d20, da_slow_margin_n28_d25, da_slow_margin_n28_d30,
    da_slow_margin_n28_d35, da_slow_margin_n28_d40, da_slow_margin_n28_d45,
    da_slow_margin_n28_d50,
    da_slow_d_cert_max, da_slow_d_cert_min, da_slow_d_optimal,
    da_slow_cert_range_steps
}

pub fn rapamycin_sprint48_gate() -> i64 with Mut, Div, Panic {
    var score = 0

    // ── Section A: upper ALARM zone (D≥4.5mg) ────────────────────────────────
    if da_slow_margin_n28_d45() < 0.0 { score = score + 1 };
    if da_slow_margin_n28_d45() > -1.5 { score = score + 1 };
    if da_slow_margin_n28_d50() < 0.0 { score = score + 1 };
    if da_slow_margin_n28_d50() < -2.5 { score = score + 1 };
    if da_slow_margin_n28_d50() > -3.0 { score = score + 1 };
    if da_slow_margin_n28_d50() < da_slow_margin_n28_d45() { score = score + 1 };
    if da_slow_margin_n28_d45() < da_slow_margin_n28_d40() { score = score + 1 };

    // ── Section B: CERT zone (D=1.0 to 3.5mg) ────────────────────────────────
    if da_slow_margin_n28_d10() > 2.0 { score = score + 1 };
    if da_slow_margin_n28_d15() > 2.0 { score = score + 1 };
    if da_slow_margin_n28_d20() > 2.0 { score = score + 1 };
    if da_slow_margin_n28_d25() > 2.0 { score = score + 1 };
    if da_slow_margin_n28_d30() > 2.0 { score = score + 1 };
    if da_slow_margin_n28_d35() > 2.0 { score = score + 1 };
    if da_slow_margin_n28_d40() < 2.0 { score = score + 1 };

    // ── Section C: scanner results ────────────────────────────────────────────
    if da_slow_d_cert_max() > 3.4 { score = score + 1 };
    if da_slow_d_cert_max() < 3.6 { score = score + 1 };
    if da_slow_d_cert_min() > 0.9 { score = score + 1 };
    if da_slow_d_cert_min() < 1.1 { score = score + 1 };
    if da_slow_d_optimal() > 2.4 { score = score + 1 };
    if da_slow_d_optimal() < 2.6 { score = score + 1 };
    if da_slow_cert_range_steps() > 4 { score = score + 1 };

    // ── Section D: Finding A — standard dose outside cert range ──────────────
    if da_slow_margin_n28_d50() < da_slow_margin_n28_d10() { score = score + 1 };
    if da_slow_margin_n28_d50() < -2.0 { score = score + 1 };
    if da_slow_margin_n28_d05() < -10.0 { score = score + 1 };
    if da_slow_margin_n28_d05() < da_slow_margin_n28_d50() - 5.0 { score = score + 1 };
    if da_slow_d_cert_max() < 4.0 { score = score + 1 };
    if da_slow_margin_n28_d40() > 0.0 { score = score + 1 };
    if da_slow_margin_n28_d35() > da_slow_margin_n28_d45() + 4.0 { score = score + 1 };

    // ── Section E: Finding B — non-obvious cert boundaries ───────────────────
    if da_slow_margin_n28_d40() > 1.0 { score = score + 1 };
    if da_slow_margin_n28_d35() > da_slow_margin_n28_d40() { score = score + 1 };
    if da_slow_margin_n28_d35() > 4.0 { score = score + 1 };
    if da_slow_margin_n28_d10() > da_slow_margin_n28_d05() + 15.0 { score = score + 1 };
    if da_slow_margin_n28_d40() < da_slow_margin_n28_d35() { score = score + 1 };
    if da_slow_d_cert_min() < da_slow_d_cert_max() { score = score + 1 };
    if da_slow_d_cert_max() < 4.0 && da_slow_d_cert_max() > 3.0 { score = score + 1 };

    // ── Section F: Finding C — GUM-optimal dose at D=2.5mg ───────────────────
    if da_slow_d_optimal() > 2.4 { score = score + 1 };
    if da_slow_margin_n28_d25() > da_slow_margin_n28_d20() { score = score + 1 };
    if da_slow_margin_n28_d25() > da_slow_margin_n28_d30() { score = score + 1 };
    if da_slow_margin_n28_d25() > 12.0 { score = score + 1 };
    if da_slow_margin_n28_d25() > da_slow_margin_n28_d35() + 7.0 { score = score + 1 };
    if da_slow_margin_n28_d25() > da_slow_margin_n28_d10() + 9.0 { score = score + 1 };
    if da_slow_margin_n28_d20() > da_slow_margin_n28_d30() { score = score + 1 };

    // ── Section G: Finding D — mirror symmetry margin(1mg) = -margin(5mg) ────
    if da_slow_margin_n28_d10() > 2.5 { score = score + 1 };
    if da_slow_margin_n28_d10() < 2.6 { score = score + 1 };
    if da_slow_margin_n28_d50() < -2.5 { score = score + 1 };
    if da_slow_margin_n28_d50() > -2.6 { score = score + 1 };
    if da_slow_margin_n28_d10() + da_slow_margin_n28_d50() > -0.01 { score = score + 1 };
    if da_slow_margin_n28_d10() + da_slow_margin_n28_d50() < 0.01 { score = score + 1 };
    if da_slow_d_cert_max() - da_slow_d_cert_min() > 2.4 { score = score + 1 };

    // ── Section H: policy implications ────────────────────────────────────────
    if da_slow_d_cert_max() < da_slow_d_optimal() + 1.1 { score = score + 1 };
    if da_slow_d_optimal() - da_slow_d_cert_min() > 1.4 { score = score + 1 };
    if da_slow_margin_n28_d25() > da_slow_margin_n28_d50() + 14.0 { score = score + 1 };
    if da_slow_cert_range_steps() < 10 { score = score + 1 };
    if da_slow_d_optimal() < da_slow_d_cert_max() { score = score + 1 };
    if da_slow_d_optimal() > da_slow_d_cert_min() { score = score + 1 };
    if da_slow_margin_n28_d25() + da_slow_margin_n28_d50() > 9.0 { score = score + 1 };

    score
}
