// stdlib/pbpk/rapamycin_atlas.sio — Cross-route epistemic atlas for rapamycin
//
// Sprint 17 dissertation capstone: assembles all five delivery-route models
// (stent, oral single-dose, oral steady-state, loading-dose, IV bolus) and
// certifies three universal principles that hold across every route:
//
// ── Universal Principle 1: ke never dominates any delivery route ──────────────
//
//   Stent (S12):      dom = k21  (peripheral depot → central, k21_var drives it)
//   Oral single (S13): dom = ka  (gut → central absorption, ka_var dominates)
//   Oral SS (S14):     dom = ka  (recurring absorption, ka_var dominates)
//   Loading SS (S15):  dom = ka  (loading bolus, ka_var dominates)
//   IV bolus (S16):    dom = k12 (central → peripheral distribution, k12_var)
//
//   ke is STRUCTURALLY irrelevant for both oral and IV: ke÷4 changes nothing
//   in either route (certified ss_ke_irrelevant and iv_ke_irrelevant).
//   The only route where ke competes is stent — and even there it loses to k21.
//
// ── Universal Principle 2: dominant source = primary flux governor ────────────
//
//   Each route has a characteristic primary flow direction:
//     Stent: large peripheral depot releases drug toward central → k21
//     IV:    large central bolus distributes to peripheral      → k12
//     Oral:  gut bolus absorbs to central                      → ka
//
//   The dominant GUM budget source is always the rate that governs the
//   highest-amplitude flux in the system.
//
// ── Universal Principle 3: route-appropriate measurement is the only fix ──────
//
//   Oral: only ka improvement (Tmax sampling ≈4h) crosses the clinical gate.
//   IV:   only k12 improvement (distribution-phase sampling ≈2–6h) raises conf.
//   Stent: only k21 improvement (peripheral release characterization) matters.
//   ke improvement is never the right answer — in any route.
//
// ── Confidence ceiling across the atlas ───────────────────────────────────────
//
//   Loaded oral SS + ka÷16 → conf=950: global optimum of the five-route atlas.
//   IV bolus conf=900 ≥ oral single conf=700: IV is epistemically immediate.
//   Oral SS (N=14) conf=900 = IV N=1 conf=900: 14 oral days ≡ 1 IV dose.
//
// ── Summary functions (all return bool, certifying cross-route properties) ─────
//
//   atlas_oral_ka_universal:       ka dominates all 3 oral scenarios
//   atlas_ke_never_dominates:      ke not dominant for any route
//   atlas_ke_universally_wasted:   ke÷4 irrelevant for both oral SS and IV
//   atlas_all_routes_certified:    all sprint gate functions pass
//   atlas_route_dominance_distinct: stent/IV/oral have different dominant sources
//   atlas_loading_rescues_oral:    loading dose rescues the 2mg oral protocol
//   atlas_ka16_is_global_optimum:  loaded SS ka÷16 achieves conf=950 (peak)

module pbpk::rapamycin_atlas

use pbpk::rapamycin_oral_3cmt::{
    oral_ka_dominant, oral_improvement_fires
}
use pbpk::rapamycin_ss_oral::{
    ss_ka_dominant, ss_ke_irrelevant, ss_k12_second_bottleneck, ss_onset_fires
}
use pbpk::rapamycin_load_oral::{
    load_ka_dominant, load_rescues_therapeutic, load_ka16_optimal
}
use pbpk::rapamycin_iv_bolus::{
    iv_k12_dominant, iv_ke_irrelevant, iv_k12_tighten_fires, iv_ke_second_bottleneck
}
use pbpk::rapamycin_stent_clinical::{
    cypher_k21_dominant, cypher_safety_certified, cypher_krel_irrelevant
}

// ka dominates ALL three oral delivery scenarios
pub fn atlas_oral_ka_universal() -> bool with Mut, Div, Panic {
    oral_ka_dominant() && ss_ka_dominant() && load_ka_dominant()
}

// ke is NOT the dominant source for any delivery route:
// stent(k21) + oral(ka) + SS(ka) + loaded(ka) + IV(k12) all non-ke
pub fn atlas_ke_never_dominates() -> bool with Epistemic, Mut, Div, Panic {
    // cypher_safety_certified also certifies k21 dominates stent
    let oral_ok  = oral_ka_dominant()
    let ss_ok    = ss_ka_dominant()
    let load_ok  = load_ka_dominant()
    let iv_ok    = iv_k12_dominant()
    let stent_ok = cypher_k21_dominant()
    oral_ok && ss_ok && load_ok && iv_ok && stent_ok
}

// ke÷4 changes nothing for oral SS and IV — both confirmed
pub fn atlas_ke_universally_wasted() -> bool with Epistemic, Mut, Div, Panic {
    ss_ke_irrelevant() && iv_ke_irrelevant()
}

// Each route has a distinct dominant source (not all the same parameter)
// Certified by: stent=k21, IV=k12, oral=ka — three different rates
pub fn atlas_route_dominance_distinct() -> bool with Epistemic, Mut, Div, Panic {
    cypher_k21_dominant() && iv_k12_dominant() && oral_ka_dominant()
}

// All individual sprint gate functions pass — omnibus certification
pub fn atlas_all_routes_certified() -> bool with Epistemic, Mut, Div, Panic {
    // Sprint 12
    let s12 = cypher_safety_certified() && cypher_krel_irrelevant()
    // Sprint 13
    let s13 = oral_ka_dominant() && oral_improvement_fires()
    // Sprint 14
    let s14 = ss_ka_dominant() && ss_ke_irrelevant() && ss_k12_second_bottleneck()
    // Sprint 15
    let s15 = load_ka_dominant() && load_rescues_therapeutic() && load_ka16_optimal()
    // Sprint 16
    let s16 = iv_k12_dominant() && iv_ke_irrelevant() && iv_k12_tighten_fires()
    s12 && s13 && s14 && s15 && s16
}

// Loading dose is the unique oral rescue: only protocol that crosses gate at N=14
pub fn atlas_loading_rescues_oral() -> bool with Epistemic, Mut, Div, Panic {
    load_rescues_therapeutic()
}

// Loaded SS ka÷16 → conf=950: highest epistemic certainty across the five-route atlas
pub fn atlas_ka16_is_global_optimum() -> bool with Mut, Div, Panic {
    load_ka16_optimal()
}
