// stdlib/pbpk/rapamycin_population_coverage.sio — Sprint 46
//
// GUM-certified population coverage at standard monitoring visits, weighted
// by CYP3A4/P-gp pharmacogenomic stratum prevalence.
//
// Stratum weights (population fractions from CYP3A4 genotype epidemiology):
//   std  (*1/*1 or *1/*3, no DDI): w=0.50
//   slow (CYP3A4 poor metabolizer): w=0.15
//   fast (CYP3A4 ultra-rapid):      w=0.20
//   inh  (on strong CYP3A4 inhibitor, e.g. ketoconazole): w=0.05
//   ind  (on strong CYP3A4 inducer, e.g. rifampicin):     w=0.10
//
// Classification thresholds (ISO GUM k=2.0):
//   CERT:  margin ≥ 2.0 (CI fully within therapeutic window)
//   WARN:  0 ≤ margin < 2.0 (certified point estimate, uncertain boundary)
//   ALARM: margin < 0.0 (CI breaches a boundary — sub-therapeutic or toxic)
//
// Population fractions at standard monitoring visits (N=7/14/28):
//   N=7:  cert=0.70, warn=0.10, alarm=0.20 (fast sub-therapeutic alarm)
//   N=14: cert=0.70, warn=0.30, alarm=0.00 (fast+ind in warning; alarm resolved)
//   N=28: cert=0.85, warn=0.00, alarm=0.15 (slow now toxic; ind newly certified)
//
// Finding A: alarm is non-monotone — 20% alarmed at N=7 (fast sub-therapeutic),
//            zero at N=14, then 15% re-alarmed at N=28 (slow stratum toxic).
// Finding B: certification plateau — cert identical at N=7 and N=14 (0.70),
//            then jumps 15% at N=28 as ind achieves certification (margin=2.103).
// Finding C: warning zone peaks at N=14 — 30% of population in warning zone at
//            week-2, double the N=7 warning fraction; entirely resolved by month-1.
// Finding D: 15% of population GUM-predicted toxic at month-1 despite correct
//            pharmacogenomic dosing — slow stratum accumulates past ceiling
//            (margin=-2.536) between the N=14 and N=28 monitoring visits.

module pbpk::rapamycin_population_coverage

use pbpk::rapamycin_monitoring_protocol::{
    mp_std_margin_n7,  mp_std_margin_n14,  mp_std_margin_n28,
    mp_slow_margin_n7, mp_slow_margin_n14, mp_slow_margin_n28,
    mp_fast_margin_n7, mp_fast_margin_n14, mp_fast_margin_n28,
    mp_inh_margin_n7,  mp_inh_margin_n14,  mp_inh_margin_n28,
    mp_ind_margin_n7,  mp_ind_margin_n14,  mp_ind_margin_n28
}

fn pc_cert_w(margin: f64, w: f64) -> f64
    with Mut, Div, Panic {
    if margin >= 2.0 { w } else { 0.0 }
}
fn pc_warn_w(margin: f64, w: f64) -> f64
    with Mut, Div, Panic {
    if margin >= 0.0 && margin < 2.0 { w } else { 0.0 }
}
fn pc_alarm_w(margin: f64, w: f64) -> f64
    with Mut, Div, Panic {
    if margin < 0.0 { w } else { 0.0 }
}

// ── N=7 (week 1) ─────────────────────────────────────────────────────────────
pub fn pc_cert_n7() -> f64 with Mut, Div, Panic {
    let a = pc_cert_w(mp_std_margin_n7(),  0.50)
    let b = pc_cert_w(mp_slow_margin_n7(), 0.15)
    let c = pc_cert_w(mp_fast_margin_n7(), 0.20)
    let d = pc_cert_w(mp_inh_margin_n7(),  0.05)
    let e = pc_cert_w(mp_ind_margin_n7(),  0.10)
    a + b + c + d + e
}
pub fn pc_warn_n7() -> f64 with Mut, Div, Panic {
    let a = pc_warn_w(mp_std_margin_n7(),  0.50)
    let b = pc_warn_w(mp_slow_margin_n7(), 0.15)
    let c = pc_warn_w(mp_fast_margin_n7(), 0.20)
    let d = pc_warn_w(mp_inh_margin_n7(),  0.05)
    let e = pc_warn_w(mp_ind_margin_n7(),  0.10)
    a + b + c + d + e
}
pub fn pc_alarm_n7() -> f64 with Mut, Div, Panic {
    let a = pc_alarm_w(mp_std_margin_n7(),  0.50)
    let b = pc_alarm_w(mp_slow_margin_n7(), 0.15)
    let c = pc_alarm_w(mp_fast_margin_n7(), 0.20)
    let d = pc_alarm_w(mp_inh_margin_n7(),  0.05)
    let e = pc_alarm_w(mp_ind_margin_n7(),  0.10)
    a + b + c + d + e
}

