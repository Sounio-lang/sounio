// ── Dose-invariance certification ─────────────────────────────────────────────

// N_10% for std stratum at D=2mg — must equal 12 (dose-invariance of RSU)
pub fn ru_std_n10_d2() -> i64 with Mut, Div, Panic {
    let ka = ob_ka_var_std(); let fv = ob_f_var_std()
    let ke = ob_ke_var_std(); let k12 = ob_k12_var_std(); let k21 = ob_k21_var_std()
    ru_find_n_thresh(2.0, 100, 0.01118, 0.141, ka, fv, ke, k12, k21, 0.10)
}

// N_10% for std stratum at D=10mg — must equal 12 (dose-invariance of RSU)
