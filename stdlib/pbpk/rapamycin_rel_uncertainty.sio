// ── Independence theorem probes ───────────────────────────────────────────────

// Slow: N_crit=3 < N_10%=8 — CI certifies while RSU > 10%
pub fn ru_slow_ncrit_before_n10() -> bool with Mut, Div, Panic {
    ru_slow_n10() > 3
}

// Inhibitor: N_10%=4 < N_crit=7 — RSU certified before CI
pub fn ru_inh_n10_before_ncrit() -> bool with Mut, Div, Panic {
    ru_inh_n10() < 7
}

// Standard: N_crit=6 < N_10%=12 — CI certifies while RSU > 10%
pub fn ru_std_ncrit_before_n10() -> bool with Mut, Div, Panic {
    ru_std_n10() > 6
}
