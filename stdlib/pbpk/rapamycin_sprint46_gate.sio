// stdlib/pbpk/rapamycin_sprint46_gate.sio — Sprint 46 certification gate
//
// Population-weighted GUM coverage fractions at scheduled monitoring visits.
// Five pharmacogenomic strata weighted by CYP3A4 prevalence:
//   std(0.50) slow(0.15) fast(0.20) inh(0.05) ind(0.10)
// Classification: CERT(margin≥2.0), WARN(0≤margin<2.0), ALARM(margin<0).
//
// Finding A: alarm non-monotone — 20% alarmed at N=7 (fast sub-therapeutic),
//            zero at N=14 (fast self-resolves), then 15% re-alarmed at N=28
//            (slow stratum accumulates to toxicity between visits 2 and 3).
// Finding B: cert plateau at weeks 1–2 (0.70), then +15pp jump at month-1
//            as ind stratum achieves first certification (margin=2.103).
// Finding C: warn zone peaks at N=14 — 30% in warn at week 2, double week 1;
//            fully resolved by month 1 as fast/ind strata certify.
// Finding D: 15% of population GUM-predicted toxic at month-1 despite
//            pharmacogenomically-optimised dosing — slow accumulates past
//            ceiling between the N=14 and N=28 visits.
//
// 56 assertions in sections A–H. All must pass (return 56).

module pbpk::rapamycin_sprint46_gate

use pbpk::rapamycin_population_coverage::{
    pc_cert_n7,  pc_warn_n7,  pc_alarm_n7,
    pc_cert_n14, pc_warn_n14, pc_alarm_n14,
    pc_cert_n28, pc_warn_n28, pc_alarm_n28
}

pub fn rapamycin_sprint46_gate() -> i64 with Mut, Div, Panic {
    var score = 0

    // ── Section A: N=7 week-1 profile — cert=0.70, warn=0.10, alarm=0.20 ─────
    if pc_cert_n7() > 0.69 { score = score + 1 };
    if pc_cert_n7() < 0.71 { score = score + 1 };
    if pc_warn_n7() > 0.09 { score = score + 1 };
    if pc_warn_n7() < 0.11 { score = score + 1 };
    if pc_alarm_n7() > 0.19 { score = score + 1 };
    if pc_alarm_n7() < 0.21 { score = score + 1 };
    if pc_cert_n7() + pc_warn_n7() + pc_alarm_n7() > 0.999 { score = score + 1 };

    // ── Section B: N=14 week-2 profile — cert=0.70, warn=0.30, alarm=0.00 ────
    if pc_cert_n14() > 0.69 { score = score + 1 };
    if pc_cert_n14() < 0.71 { score = score + 1 };
    if pc_warn_n14() > 0.29 { score = score + 1 };
    if pc_warn_n14() < 0.31 { score = score + 1 };
    if pc_alarm_n14() < 0.01 { score = score + 1 };
    if pc_cert_n14() > pc_warn_n14() { score = score + 1 };
    if pc_cert_n14() + pc_warn_n14() + pc_alarm_n14() > 0.999 { score = score + 1 };

    // ── Section C: N=28 month-1 profile — cert=0.85, warn=0.00, alarm=0.15 ───
    if pc_cert_n28() > 0.84 { score = score + 1 };
    if pc_cert_n28() < 0.86 { score = score + 1 };
    if pc_alarm_n28() > 0.14 { score = score + 1 };
    if pc_alarm_n28() < 0.16 { score = score + 1 };
    if pc_warn_n28() < 0.01 { score = score + 1 };
    if pc_cert_n28() > 5.0 * pc_alarm_n28() { score = score + 1 };
    if pc_cert_n28() + pc_warn_n28() + pc_alarm_n28() > 0.999 { score = score + 1 };

    // ── Section D: FINDING A — alarm non-monotone across visits ──────────────
    if pc_alarm_n7() > 0.0 { score = score + 1 };
    if pc_alarm_n14() < 0.01 { score = score + 1 };
    if pc_alarm_n28() > 0.0 { score = score + 1 };
    if pc_alarm_n7() > pc_alarm_n14() { score = score + 1 };
    if pc_alarm_n28() > pc_alarm_n14() { score = score + 1 };
    if pc_alarm_n14() < pc_alarm_n7() - 0.15 { score = score + 1 };
    if pc_alarm_n7() > pc_alarm_n28() { score = score + 1 };

    // ── Section E: FINDING B — cert plateau at weeks 1–2, +15pp jump at month-1
    if pc_cert_n14() < pc_cert_n7() + 0.01 { score = score + 1 };
    if pc_cert_n14() > pc_cert_n7() - 0.01 { score = score + 1 };
    if pc_cert_n28() > pc_cert_n14() + 0.14 { score = score + 1 };
    if pc_cert_n28() - pc_cert_n14() > 0.14 { score = score + 1 };
    if pc_cert_n28() - pc_cert_n14() < 0.16 { score = score + 1 };
    if pc_cert_n28() > pc_cert_n7() + 0.14 { score = score + 1 };
    if pc_cert_n28() - pc_cert_n7() > 0.10 { score = score + 1 };

    // ── Section F: FINDING C — warn zone peaks at N=14 ───────────────────────
    if pc_warn_n14() > pc_warn_n7() { score = score + 1 };
    if pc_warn_n14() > pc_warn_n28() { score = score + 1 };
    if pc_warn_n14() > 2.0 * pc_warn_n7() { score = score + 1 };
    if pc_warn_n14() > 0.25 { score = score + 1 };
    if pc_warn_n28() < 0.01 { score = score + 1 };
    if pc_warn_n7() < pc_alarm_n7() { score = score + 1 };
    if pc_warn_n14() > pc_alarm_n7() { score = score + 1 };

    // ── Section G: Sum integrity and aggregate distributions ─────────────────
    if pc_cert_n7() + pc_cert_n14() + pc_cert_n28() > 2.20 { score = score + 1 };
    if pc_cert_n7() + pc_cert_n14() + pc_cert_n28() < 2.30 { score = score + 1 };
    if pc_warn_n7() + pc_warn_n14() + pc_warn_n28() > 0.35 { score = score + 1 };
    if pc_warn_n7() + pc_warn_n14() + pc_warn_n28() < 0.45 { score = score + 1 };
    if pc_alarm_n7() + pc_alarm_n14() + pc_alarm_n28() > 0.30 { score = score + 1 };
    if pc_alarm_n7() + pc_alarm_n14() + pc_alarm_n28() < 0.40 { score = score + 1 };
    if pc_cert_n7() + pc_cert_n14() + pc_cert_n28() > (pc_alarm_n7() + pc_alarm_n14() + pc_alarm_n28()) * 5.0 { score = score + 1 };

    // ── Section H: Policy implications and structural identities ──────────────
    // Net safe fraction (cert − alarm) improves visit-on-visit
    if pc_cert_n28() - pc_alarm_n28() > pc_cert_n7() - pc_alarm_n7() { score = score + 1 };
    // Non-alarm fraction (cert + warn) also improves
    if pc_cert_n28() + pc_warn_n28() > pc_cert_n7() + pc_warn_n7() { score = score + 1 };
    // cert_n28 ≈ cert_n14 + alarm_n28 (ind-certification gain equals slow-alarm weight)
    if pc_cert_n28() > pc_cert_n14() + pc_alarm_n28() - 0.001 { score = score + 1 };
    if pc_cert_n28() < pc_cert_n14() + pc_alarm_n28() + 0.001 { score = score + 1 };
    // alarm_n7 alone exceeds the total alarm mass at N=28 (fast resolves, slow worsens less)
    if pc_alarm_n7() > pc_alarm_n28() - 0.001 { score = score + 1 };
    // 85% certified by month-1 yet 15% toxic — pharmacogenomics insufficient without
    // interval monitoring between week-2 and month-1
    if pc_cert_n28() > 0.8 { score = score + 1 };
    if pc_alarm_n28() > 0.1 { score = score + 1 };

    score
}
