// stdlib/pbpk/rapamycin_uncertainty_budget.sio — Sprint 35: GUM Variance Budget Decomposition
//
// Novel dissertation contribution: decomposes u_c² into five independent GUM
// sensitivity channels (F, ka, ke, k12, k21), computing fractional shares for
// each stratum × checkpoint. Certifies which channel dominates, how dominance
// shifts across strata and time, and the unique inh regime where compartmental
// transfer (k12+k21) rivals absorption (ka) as a variance driver.
//
// ── Channel Definitions (ISO GUM §5.1.2) ─────────────────────────────────────
//
//   V_total = V_F + V_ka + V_ke + V_k12 + V_k21
//   Share_i = V_i / V_total        ∈ (0, 1),  Σ Share_i = 1
//   ch: 0=F, 1=ka, 2=ke, 3=k12, 4=k21
//
// ── Budget Shares at N=14 ─────────────────────────────────────────────────────
//
//   Standard (D=5mg, ke=0.01118, F=0.141):
//     ka  73.5%  F  9.2%  k12  10.8%  k21  5.9%  ke  0.6%
//
//   Slow    (D=5mg, ke=0.00838, F=0.188):
//     ka  63.4%  F  8.0%  k12  18.2%  k21  9.4%  ke  1.0%
//
//   Fast    (D=5mg, ke=0.01677, F=0.094):
//     ka  82.3%  F 10.2%  k12   4.6%  k21  2.7%  ke  0.2%
//
//   Inhibitor (D=1.5mg, ke=0.002236, F=0.282):
//     ka  42.8%  F  5.5%  k12  35.3%  k21 16.3%  ke  0.1%
//     → Unique: k12 alone (35.3%) > ka/2; peripheral transfer rivals absorption.
//
//   Inducer (D=34mg, ke=0.05590, F=0.047):
//     ka  86.3%  F  9.8%  k12   1.0%  k21  1.6%  ke  1.3%
//     → Maximum ka dominance: fastest elimination + largest dose → ka overwhelms.
//
// ── Four Novel Findings ───────────────────────────────────────────────────────
//
//   FINDING A — ka universal dominance: ka > 40% in every stratum/N.
//     Absorption-rate variability is the primary uncertainty driver.
//
//   FINDING B — ka share decreases with N (std): 81.6% → 73.5% → 60.2%.
//     Peripheral compartment accumulates, k12/k21 channels catch up over time.
//
//   FINDING C — inh k12+k21 regime: k12+k21 = 51.7% for inh at N=14.
//     The only stratum where compartmental transfer > absorption as variance driver.
//     Caused by very slow ke (long half-life → peripheral saturation before SS).
//
//   FINDING D — ke share diagnostic for genotype: ske_fast < ske_std < ske_slow.
//     ke_var is identical across std/slow/fast; the share difference is purely
//     from the sensitivity coefficient ∂C/∂ke — driven by steady-state level.
//
// ── Effect annotations ────────────────────────────────────────────────────────
//   All ub_* functions: with Mut, Div, Panic

module pbpk::rapamycin_uncertainty_budget

use pbpk::rapamycin_oral_budget::{
    ob_ka_var_std, ob_f_var_std, ob_ke_var_std, ob_k12_var_std, ob_k21_var_std,
    ob_ke_var_inh, ob_ke_var_ind,
    ob_v1_channel, ob_v1_total
}

// ── Core primitive: fractional share of channel ch ───────────────────────────

pub fn ub_share(d_oral: f64, n: i64, ke_val: f64, f_val: f64,
                ka_var: f64, f_var: f64, ke_var: f64,
                k12_var: f64, k21_var: f64, ch: i64) -> f64
    with Mut, Div, Panic {
    let vc   = ob_v1_channel(d_oral, n, ke_val, f_val, ka_var, f_var, ke_var, k12_var, k21_var, ch)
    let vtot = ob_v1_total(  d_oral, n, ke_val, f_val, ka_var, f_var, ke_var, k12_var, k21_var)
    vc / vtot
}

// ── std N=7 shares ────────────────────────────────────────────────────────────

pub fn ub_std_ska_n7() -> f64 with Mut, Div, Panic {
    let ka=ob_ka_var_std(); let fv=ob_f_var_std(); let ke=ob_ke_var_std()
    let k12=ob_k12_var_std(); let k21=ob_k21_var_std()
    ub_share(5.0, 7, 0.01118, 0.141, ka, fv, ke, k12, k21, 1)
}
pub fn ub_std_sF_n7() -> f64 with Mut, Div, Panic {
    let ka=ob_ka_var_std(); let fv=ob_f_var_std(); let ke=ob_ke_var_std()
    let k12=ob_k12_var_std(); let k21=ob_k21_var_std()
    ub_share(5.0, 7, 0.01118, 0.141, ka, fv, ke, k12, k21, 0)
}
pub fn ub_std_sk12_n7() -> f64 with Mut, Div, Panic {
    let ka=ob_ka_var_std(); let fv=ob_f_var_std(); let ke=ob_ke_var_std()
    let k12=ob_k12_var_std(); let k21=ob_k21_var_std()
    ub_share(5.0, 7, 0.01118, 0.141, ka, fv, ke, k12, k21, 3)
}
pub fn ub_std_sk21_n7() -> f64 with Mut, Div, Panic {
    let ka=ob_ka_var_std(); let fv=ob_f_var_std(); let ke=ob_ke_var_std()
    let k12=ob_k12_var_std(); let k21=ob_k21_var_std()
    ub_share(5.0, 7, 0.01118, 0.141, ka, fv, ke, k12, k21, 4)
}

