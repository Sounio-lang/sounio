// stdlib/pbpk/rapamycin_sprint53_gate.sio — Sprint 53 certification gate
//
// Dual-adjusted protocol: slow at D=2.5mg + fast at D=9.5mg simultaneously.
// Three-way comparison: dual vs standard (Sprint 46) vs slow-only (Sprint 50).
//
// Dual-adjusted values:
//   N=7:  cert=0.75, warn=0.25, alarm=0.00  (Δ vs standard: +0.05, +0.15, -0.20)
//   N=14: cert=0.90, warn=0.10, alarm=0.00  (Δ vs standard: +0.20, -0.20, 0.00)
//   N=28: cert=1.00, warn=0.00, alarm=0.00  (identical to slow-only)
//
// Δ dual vs slow-only:
//   N=7:  Δcert=+0.20, Δwarn=0.00, Δalarm=-0.20  (fast ALARM→CERT)
//   N=14: Δcert=+0.20, Δwarn=-0.20, Δalarm=0.00  (fast WARN→CERT)
//   N=28: all zero (fast was already CERT at N=28 at any dose in range)
//
// Finding A: complete alarm elimination — zero alarms at all three visits.
// Finding B: N=7 recovery vs slow-only — fast ALARM→CERT adds 0.20 cert at week-1.
// Finding C: N=14 step-up — fast WARN→CERT brings N=14 cert to 0.90, highest of all.
// Finding D: N=28 invariance — fast dose change doesn't affect month-1 coverage.
//
// 56 assertions in sections A–H. All must pass (return 56).

module pbpk::rapamycin_sprint53_gate

use pbpk::rapamycin_dual_adjusted_coverage::{
    dac_cert_n7,  dac_warn_n7,  dac_alarm_n7,
    dac_cert_n14, dac_warn_n14, dac_alarm_n14,
    dac_cert_n28, dac_warn_n28, dac_alarm_n28
}
use pbpk::rapamycin_adjusted_coverage::{
    ac_cert_n7,  ac_warn_n7,  ac_alarm_n7,
    ac_cert_n14, ac_warn_n14, ac_alarm_n14,
    ac_cert_n28, ac_warn_n28, ac_alarm_n28
}
use pbpk::rapamycin_population_coverage::{
    pc_cert_n7,  pc_warn_n7,  pc_alarm_n7,
    pc_cert_n14, pc_warn_n14, pc_alarm_n14,
    pc_cert_n28, pc_warn_n28, pc_alarm_n28
}

pub fn rapamycin_sprint53_gate() -> i64 with Mut, Div, Panic {
    var score = 0

    // ── Section A: dual N=7 profile (cert=0.75, warn=0.25, alarm=0.00) ────────
    if dac_cert_n7() > 0.74 { score = score + 1 };
    if dac_cert_n7() < 0.76 { score = score + 1 };
    if dac_warn_n7() > 0.24 { score = score + 1 };
    if dac_warn_n7() < 0.26 { score = score + 1 };
    if dac_alarm_n7() < 0.001 { score = score + 1 };
    if dac_cert_n7() + dac_warn_n7() + dac_alarm_n7() > 0.999 { score = score + 1 };
    if dac_cert_n7() > dac_warn_n7() { score = score + 1 };

    // ── Section B: dual N=14 profile (cert=0.90, warn=0.10, alarm=0.00) ───────
    if dac_cert_n14() > 0.89 { score = score + 1 };
    if dac_cert_n14() < 0.91 { score = score + 1 };
    if dac_warn_n14() > 0.09 { score = score + 1 };
    if dac_warn_n14() < 0.11 { score = score + 1 };
    if dac_alarm_n14() < 0.001 { score = score + 1 };
    if dac_cert_n14() + dac_warn_n14() + dac_alarm_n14() > 0.999 { score = score + 1 };
    if dac_cert_n14() > dac_cert_n7() { score = score + 1 };

    // ── Section C: dual N=28 — fully certified ────────────────────────────────
    if dac_cert_n28() > 0.999 { score = score + 1 };
    if dac_cert_n28() < 1.001 { score = score + 1 };
    if dac_warn_n28() < 0.001 { score = score + 1 };
    if dac_alarm_n28() < 0.001 { score = score + 1 };
    if dac_cert_n28() + dac_warn_n28() + dac_alarm_n28() > 0.999 { score = score + 1 };
    if dac_cert_n28() > 0.99 { score = score + 1 };
    if dac_cert_n28() > dac_cert_n14() { score = score + 1 };

    // ── Section D: Finding A — complete alarm elimination vs standard ──────────
    if dac_alarm_n7() < pc_alarm_n7() - 0.19 { score = score + 1 };
    if dac_alarm_n7() < 0.001 { score = score + 1 };
    if pc_alarm_n7() - dac_alarm_n7() > 0.19 { score = score + 1 };
    if dac_cert_n7() > pc_cert_n7() { score = score + 1 };
    if dac_alarm_n28() < pc_alarm_n28() - 0.14 { score = score + 1 };
    if dac_alarm_n28() < 0.001 { score = score + 1 };
    if dac_alarm_n7() + dac_alarm_n14() + dac_alarm_n28() < 0.001 { score = score + 1 };

    // ── Section E: Finding B — N=7 cert recovery vs slow-only ─────────────────
    if dac_cert_n7() > ac_cert_n7() + 0.19 { score = score + 1 };
    if dac_cert_n7() > ac_cert_n7() { score = score + 1 };
    if dac_alarm_n7() < ac_alarm_n7() - 0.19 { score = score + 1 };
    if dac_warn_n7() > ac_warn_n7() - 0.001 { score = score + 1 };
    if dac_warn_n7() < ac_warn_n7() + 0.001 { score = score + 1 };
    if ac_cert_n7() + pc_alarm_n7() > dac_cert_n7() - 0.001 { score = score + 1 };
    if ac_cert_n7() + pc_alarm_n7() < dac_cert_n7() + 0.001 { score = score + 1 };

    // ── Section F: Finding C — N=14 step-up vs both baselines ────────────────
    if dac_cert_n14() > pc_cert_n14() + 0.19 { score = score + 1 };
    if dac_cert_n14() > ac_cert_n14() + 0.19 { score = score + 1 };
    if dac_warn_n14() < pc_warn_n14() - 0.19 { score = score + 1 };
    if dac_warn_n14() < ac_warn_n14() - 0.19 { score = score + 1 };
    if dac_alarm_n14() < pc_alarm_n14() + 0.001 { score = score + 1 };
    if pc_cert_n14() + pc_warn_n14() > dac_cert_n14() + dac_warn_n14() - 0.001 { score = score + 1 };
    if dac_cert_n14() > dac_cert_n7() { score = score + 1 };

    // ── Section G: Finding D — N=28 invariance vs slow-only ──────────────────
    if dac_cert_n28() > ac_cert_n28() - 0.001 { score = score + 1 };
    if dac_cert_n28() < ac_cert_n28() + 0.001 { score = score + 1 };
    if dac_warn_n28() < ac_warn_n28() + 0.001 { score = score + 1 };
    if dac_alarm_n28() < ac_alarm_n28() + 0.001 { score = score + 1 };
    if dac_cert_n28() > pc_cert_n28() + 0.14 { score = score + 1 };
    if pc_alarm_n28() - dac_alarm_n28() > 0.14 { score = score + 1 };
    if dac_cert_n28() > dac_cert_n14() { score = score + 1 };

    // ── Section H: monotone cert trajectory and aggregate comparison ──────────
    if dac_cert_n28() > dac_cert_n14() { score = score + 1 };
    if dac_cert_n14() > dac_cert_n7() { score = score + 1 };
    if dac_alarm_n7() + dac_alarm_n14() + dac_alarm_n28() < 0.001 { score = score + 1 };
    if dac_cert_n7() + dac_cert_n14() + dac_cert_n28() > pc_cert_n7() + pc_cert_n14() + pc_cert_n28() { score = score + 1 };
    if pc_alarm_n7() + pc_alarm_n14() + pc_alarm_n28() > dac_alarm_n7() + dac_alarm_n14() + dac_alarm_n28() + 0.30 { score = score + 1 };
    if dac_cert_n28() - dac_cert_n7() > 0.24 { score = score + 1 };
    if dac_cert_n14() - dac_cert_n7() > 0.14 { score = score + 1 };

    score
}
