// stdlib/pbpk/rapamycin_sprint70_gate.sio — Sprint 70 certification gate
//
// 56 assertions across 8 sections verifying sequential k-measurement TDM findings.
// All values probe-verified from rapamycin_tdm_sequential.sio.
//
// Sections:
//   A: LCMS gains at N=7 (k=1,2,3) — diminishing returns
//   B: Immuno gains at N=7 (k=1,2,3,9) — flat marginal returns
//   C: Machine-exact equivalence: immuno k=9 == LCMS k=1
//   D: Diminishing returns ordering for both assay types
//   E: Posterior margins at N=7 — LCMS k=1,2,3 and immuno k=1,3,9
//   F: N=14 LCMS gains and immuno equivalence
//   G: Theoretical 9:1 ratio (CV_ratio_sq)
//   H: Cross-sprint and cross-assay comparisons
//
// All 56 assertions must pass (return 56).

module pbpk::rapamycin_sprint70_gate

use pbpk::rapamycin_tdm_sequential::{
    ts_cv_ratio_sq,
    ts_gain_lcms_k1_n7, ts_gain_lcms_k2_n7, ts_gain_lcms_k3_n7,
    ts_gain_immuno_k1_n7, ts_gain_immuno_k2_n7, ts_gain_immuno_k3_n7, ts_gain_immuno_k9_n7,
    ts_gain_lcms_k1_n14, ts_gain_lcms_k2_n14, ts_gain_lcms_k3_n14,
    ts_gain_immuno_k1_n14, ts_gain_immuno_k9_n14,
    ts_margin_prior_n7, ts_margin_lcms_k1_n7, ts_margin_lcms_k2_n7, ts_margin_lcms_k3_n7,
    ts_margin_immuno_k1_n7, ts_margin_immuno_k3_n7, ts_margin_immuno_k9_n7,
    ts_equiv_gain_diff_n7, ts_equiv_gain_diff_n14,
    ts_marginal_lcms_k2_n7, ts_marginal_lcms_k3_n7,
    ts_marginal_immuno_k2_n7, ts_marginal_immuno_k3_n7
}

pub fn rapamycin_sprint70_gate() -> i64 with Mut, Div, Panic {
    var score = 0

    // ── Section A: LCMS gains at N=7 — k=1,2,3 (Finding A) ──────────────────
    if ts_gain_lcms_k1_n7() > 2.84 { score = score + 1 };
    if ts_gain_lcms_k1_n7() < 2.86 { score = score + 1 };
    if ts_gain_lcms_k2_n7() > 3.89 { score = score + 1 };
    if ts_gain_lcms_k2_n7() < 3.92 { score = score + 1 };
    if ts_gain_lcms_k3_n7() > 4.72 { score = score + 1 };
    if ts_gain_lcms_k3_n7() > ts_gain_lcms_k2_n7() { score = score + 1 };
    if ts_gain_lcms_k2_n7() > ts_gain_lcms_k1_n7() { score = score + 1 };

    // ── Section B: Immuno gains at N=7 — k=1,2,3,9 (Finding B) ──────────────
    if ts_gain_immuno_k1_n7() > 1.33 { score = score + 1 };
    if ts_gain_immuno_k1_n7() < 1.35 { score = score + 1 };
    if ts_gain_immuno_k2_n7() > 1.60 { score = score + 1 };
    if ts_gain_immuno_k3_n7() > 1.83 { score = score + 1 };
    if ts_gain_immuno_k9_n7() > 2.84 { score = score + 1 };
    if ts_gain_immuno_k9_n7() < 2.86 { score = score + 1 };
    if ts_gain_immuno_k3_n7() > ts_gain_immuno_k1_n7() { score = score + 1 };

    // ── Section C: Machine-exact equivalence — 9 immuno == 1 LCMS (Finding C)
    if ts_equiv_gain_diff_n7()  == 0.0 { score = score + 1 };
    if ts_equiv_gain_diff_n14() == 0.0 { score = score + 1 };
    if ts_gain_immuno_k9_n7() == ts_gain_lcms_k1_n7() { score = score + 1 };
    if ts_gain_immuno_k9_n14() == ts_gain_lcms_k1_n14() { score = score + 1 };
    if ts_cv_ratio_sq() == 9.0 { score = score + 1 };
    if ts_cv_ratio_sq() > 8.9  { score = score + 1 };
    if ts_cv_ratio_sq() < 9.1  { score = score + 1 };

    // ── Section D: Diminishing returns ordering (Finding A,B) ────────────────
    if ts_marginal_lcms_k2_n7()   > ts_marginal_lcms_k3_n7()   { score = score + 1 };
    if ts_marginal_immuno_k2_n7() > ts_marginal_immuno_k3_n7() { score = score + 1 };
    if ts_marginal_lcms_k2_n7()   > ts_marginal_immuno_k2_n7() { score = score + 1 };
    if ts_marginal_lcms_k2_n7()   > 1.0  { score = score + 1 };
    if ts_marginal_lcms_k3_n7()   > 0.8  { score = score + 1 };
    if ts_marginal_immuno_k2_n7() > 0.26 { score = score + 1 };
    if ts_marginal_immuno_k2_n7() < 0.28 { score = score + 1 };

    // ── Section E: Posterior margins at N=7 (Finding D,E) ────────────────────
    if ts_margin_prior_n7()    > 2.8  { score = score + 1 };
    if ts_margin_lcms_k1_n7()  > 8.0  { score = score + 1 };
    if ts_margin_lcms_k2_n7()  > 11.0 { score = score + 1 };
    if ts_margin_lcms_k3_n7()  > 13.3 { score = score + 1 };
    if ts_margin_immuno_k9_n7() == ts_margin_lcms_k1_n7() { score = score + 1 };
    if ts_margin_immuno_k3_n7() > 5.0  { score = score + 1 };
    if ts_margin_immuno_k3_n7() < ts_margin_lcms_k1_n7() { score = score + 1 };

    // ── Section F: N=14 gains and equivalence (Finding F) ────────────────────
    if ts_gain_lcms_k1_n14() > 2.09 { score = score + 1 };
    if ts_gain_lcms_k1_n14() < 2.10 { score = score + 1 };
    if ts_gain_lcms_k2_n14() > 2.78 { score = score + 1 };
    if ts_gain_lcms_k3_n14() > 3.33 { score = score + 1 };
    if ts_gain_immuno_k9_n14() > 2.09 { score = score + 1 };
    if ts_gain_immuno_k9_n14() < 2.10 { score = score + 1 };
    if ts_gain_lcms_k1_n14() < ts_gain_lcms_k1_n7() { score = score + 1 };

    // ── Section G: Gain monotonicity and LCMS dominance (Finding G) ──────────
    if ts_gain_lcms_k1_n7() > ts_gain_immuno_k3_n7() { score = score + 1 };
    if ts_gain_lcms_k1_n7() > ts_gain_immuno_k1_n7() * 2.0 { score = score + 1 };
    if ts_gain_immuno_k1_n14() < ts_gain_immuno_k1_n7() { score = score + 1 };
    if ts_gain_lcms_k2_n7() > 3.8  { score = score + 1 };
    if ts_margin_lcms_k3_n7() > ts_margin_lcms_k1_n7() { score = score + 1 };
    if ts_gain_immuno_k3_n7() < ts_gain_lcms_k1_n7() { score = score + 1 };
    if ts_gain_lcms_k3_n7() > 4.7  { score = score + 1 };

    // ── Section H: Cross-sprint comparisons ──────────────────────────────────
    // Sprint 68 L3 gain ≈ 2.34 (u_pk_L0/u_pk_L3 = 1/0.428); LCMS k=1 > ka elimination
    // Sprint 69: LCMS k=1 margin N=7 = 8.03 > L3 margin 6.58
    if ts_gain_lcms_k1_n7() > 2.0  { score = score + 1 };
    if ts_gain_lcms_k2_n7() > ts_gain_lcms_k1_n7() { score = score + 1 };
    if ts_margin_lcms_k1_n7() > 8.0 { score = score + 1 };
    if ts_margin_immuno_k1_n7() > ts_margin_prior_n7() { score = score + 1 };
    if ts_gain_immuno_k9_n7() > ts_gain_immuno_k3_n7() { score = score + 1 };
    if ts_gain_lcms_k1_n7() > ts_gain_lcms_k1_n14() { score = score + 1 };
    if ts_marginal_lcms_k2_n7() > ts_marginal_lcms_k3_n7() { score = score + 1 };

    score
}
