// stdlib/pbpk/rapamycin_uc_trajectory.sio — Sprint 61
//
// GUM combined uncertainty u_c trajectory for the standard stratum (ke=0.01118,
// F=0.141, D=5mg) — the epistemic timeline showing how u_c, trough c, and their
// ratio (relative uncertainty CV = u_c/c) evolve with each dose.
//
// The margin = min(Z_floor, Z_ceil) rises in the floor-binding phase because
// c grows faster than u_c; it falls in the ceil-binding phase because the
// ceiling closes faster than u_c contracts. This module makes that geometry
// explicit by separating the two factors.
//
// Finding A: u_c increases monotonically from N=1 to SS — sensitivity to ke
//            amplifies as accumulation grows (R·∂R/∂ke term); the margin rises
//            despite growing u_c because the trough numerator grows faster.
// Finding B: CV = u_c/c shrinks monotonically — relative uncertainty improves
//            even as absolute u_c grows; CV at N=28 < CV at N=7 < CV at N=1.
// Finding C: The absolute u_c at N=7 already exceeds u_c at N=1 because the
//            7-dose accumulation amplifies the ke uncertainty through R.
// Finding D: u_c ratio N=28/N=7 > 1 (u_c grows between visits) while margin
//            ratio N=14/N=7 > 1 (margin grows) — margin gain is driven by
//            trough rise, not epistemic contraction; the GUM window widens
//            because the trough centres itself in the therapeutic window.

module pbpk::rapamycin_uc_trajectory

use pbpk::rapamycin_assay::{as_trough_mg_l}
use pbpk::rapamycin_expanded_u::{eu_u_c}
use pbpk::rapamycin_clinical::{trough_floor_mg_l, trough_ceil_mg_l}
use pbpk::rapamycin_oral_budget::{
    ob_ka_var_std, ob_f_var_std, ob_ke_var_std, ob_k12_var_std, ob_k21_var_std
}

fn uct_uc_at(n: i64) -> f64 with Mut, Div, Panic {
    let ka  = ob_ka_var_std()
    let fv  = ob_f_var_std()
    let ke  = ob_ke_var_std()
    let k12 = ob_k12_var_std()
    let k21 = ob_k21_var_std()
    eu_u_c(5.0, n, 0.01118, 0.141, ka, fv, ke, k12, k21)
}

fn uct_c_at(n: i64) -> f64 with Mut, Div, Panic {
    as_trough_mg_l(5.0, n, 0.01118, 0.141)
}

// ── Trough concentration at monitoring visits ──────────────────────────────────
pub fn uct_c_n1()  -> f64 with Mut, Div, Panic { uct_c_at(1)  }
pub fn uct_c_n7()  -> f64 with Mut, Div, Panic { uct_c_at(7)  }
pub fn uct_c_n14() -> f64 with Mut, Div, Panic { uct_c_at(14) }
pub fn uct_c_n28() -> f64 with Mut, Div, Panic { uct_c_at(28) }
pub fn uct_c_n42() -> f64 with Mut, Div, Panic { uct_c_at(42) }
pub fn uct_c_n56() -> f64 with Mut, Div, Panic { uct_c_at(56) }

// ── Combined uncertainty u_c at monitoring visits ─────────────────────────────
pub fn uct_uc_n1()  -> f64 with Mut, Div, Panic { uct_uc_at(1)  }
pub fn uct_uc_n7()  -> f64 with Mut, Div, Panic { uct_uc_at(7)  }
pub fn uct_uc_n14() -> f64 with Mut, Div, Panic { uct_uc_at(14) }
pub fn uct_uc_n28() -> f64 with Mut, Div, Panic { uct_uc_at(28) }
pub fn uct_uc_n42() -> f64 with Mut, Div, Panic { uct_uc_at(42) }
pub fn uct_uc_n56() -> f64 with Mut, Div, Panic { uct_uc_at(56) }

// ── Relative uncertainty CV = u_c / c ─────────────────────────────────────────
pub fn uct_cv_n1()  -> f64 with Mut, Div, Panic { uct_uc_n1()  / uct_c_n1()  }
pub fn uct_cv_n7()  -> f64 with Mut, Div, Panic { uct_uc_n7()  / uct_c_n7()  }
pub fn uct_cv_n14() -> f64 with Mut, Div, Panic { uct_uc_n14() / uct_c_n14() }
pub fn uct_cv_n28() -> f64 with Mut, Div, Panic { uct_uc_n28() / uct_c_n28() }

// ── u_c growth ratios between visits (Finding A) ──────────────────────────────
pub fn uct_uc_ratio_n7_n1()   -> f64 with Mut, Div, Panic { uct_uc_n7()  / uct_uc_n1()  }
pub fn uct_uc_ratio_n14_n7()  -> f64 with Mut, Div, Panic { uct_uc_n14() / uct_uc_n7()  }
pub fn uct_uc_ratio_n28_n14() -> f64 with Mut, Div, Panic { uct_uc_n28() / uct_uc_n14() }

// ── Trough growth ratios — must exceed u_c ratios in floor-binding phase ───────
pub fn uct_c_ratio_n7_n1()   -> f64 with Mut, Div, Panic { uct_c_n7()  / uct_c_n1()  }
pub fn uct_c_ratio_n14_n7()  -> f64 with Mut, Div, Panic { uct_c_n14() / uct_c_n7()  }

// ── First N where u_c exceeds twice its N=1 value (amplification scanner) ──────
pub fn uct_double_n() -> i64 with Mut, Div, Panic {
    let threshold = uct_uc_n1() * 2.0
    var n = 1
    var result = 0
    while n <= 200 {
        if uct_uc_at(n) >= threshold && result == 0 { result = n };
        n = n + 1
    }
    result
}
