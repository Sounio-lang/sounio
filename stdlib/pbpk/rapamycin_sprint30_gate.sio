// stdlib/pbpk/rapamycin_sprint30_gate.sio — Sprint 30 certification gate
//
// Certifies the Coverage-Factor Sensitivity theorem and the Gold Theorem
// (inducer D=34mg k=2.000 N_crit = N_conf from Sprint 29).
//
// 56 assertions in sections A–H. All must pass (return 56).

module pbpk::rapamycin_sprint30_gate

use pbpk::rapamycin_k_sensitivity::{
    ks_find_n_crit_k, ks_monotone,
    ks_std_k80, ks_std_k90, ks_std_k95, ks_std_k99,
    ks_slow_k80, ks_slow_k90, ks_slow_k95, ks_slow_k99,
    ks_fast_k80, ks_fast_k90, ks_fast_k95, ks_fast_k99,
    ks_inh_k80, ks_inh_k90, ks_inh_k95, ks_inh_k99,
    ks_ind_d20_k80, ks_ind_d20_k95,
    ks_ind_d34_k80, ks_ind_d34_k90, ks_ind_d34_k95, ks_ind_d34_k99
}
use pbpk::rapamycin_oral_budget::{
    ob_ka_var_std, ob_f_var_std, ob_ke_var_std, ob_k12_var_std, ob_k21_var_std,
    ob_ke_var_inh, ob_ke_var_ind
}

pub fn rapamycin_sprint30_gate() -> i64 with Mut, Div, Panic {
    var score = 0

    // ── Section A: N_crit at k=1.282 (80% CI) ────────────────────────────────
    if ks_std_k80()  == 5  { score = score + 1 };
    if ks_slow_k80() == 3  { score = score + 1 };
    if ks_fast_k80() == 13 { score = score + 1 };
    if ks_inh_k80()  == 6  { score = score + 1 };
    // Inducer D=20mg: still 0 even at 80% — structurally uncertifiable
    if ks_ind_d20_k80() == 0 { score = score + 1 };
    // Inducer D=34mg at k=1.282: certifiable in 16 doses
    if ks_ind_d34_k80() == 16 { score = score + 1 };
    // Slow k=1.282 is lowest N_crit of certifiable strata
    if ks_slow_k80() <= ks_std_k80()  { score = score + 1 };
    if ks_slow_k80() <= ks_fast_k80() { score = score + 1 };

    // ── Section B: N_crit at k=1.645 (90% CI) ────────────────────────────────
    if ks_std_k90()  == 6  { score = score + 1 };
    if ks_slow_k90() == 3  { score = score + 1 };
    if ks_fast_k90() == 14 { score = score + 1 };
    if ks_inh_k90()  == 6  { score = score + 1 };
    if ks_ind_d34_k90() == 20 { score = score + 1 };
    // Inhibitor plateau: N_crit stays 6 from k=1.282 through k=1.645
    if ks_inh_k80() == ks_inh_k90() { score = score + 1 };
    // Slow plateau: N_crit stays 3 from k=1.282 through k=1.645
    if ks_slow_k80() == ks_slow_k90() { score = score + 1 };

    // ── Section C: N_crit at k=2.000 (ISO 95% — baseline) ────────────────────
    // These must match Sprint 26 N_crit values exactly
    if ks_std_k95()  == 6  { score = score + 1 };
    if ks_slow_k95() == 3  { score = score + 1 };
    if ks_fast_k95() == 15 { score = score + 1 };
    if ks_inh_k95()  == 7  { score = score + 1 };
    if ks_ind_d20_k95() == 0 { score = score + 1 };
    // Gold theorem: ind D=34mg k=2.000 N_crit = 26 = N_conf(ind D=20mg, Sprint 29)
    if ks_ind_d34_k95() == 26 { score = score + 1 };

    // ── Section D: N_crit at k=2.576 (99% CI) ────────────────────────────────
    if ks_std_k99()  == 7  { score = score + 1 };
    if ks_slow_k99() == 4  { score = score + 1 };
    if ks_fast_k99() == 17 { score = score + 1 };
    if ks_inh_k99()  == 7  { score = score + 1 };
    // Inducer D=34mg at k=2.576: 49 doses — clinically prohibitive
    if ks_ind_d34_k99() == 49 { score = score + 1 };
    // Inhibitor plateau continues: N_crit stays 7 from k=2.000 through k=2.576
    if ks_inh_k95() == ks_inh_k99() { score = score + 1 };
    // Std k=2.576 is only 1 dose above baseline k=2.000
    if ks_std_k99() == ks_std_k95() + 1 { score = score + 1 };

    // ── Section E: Monotonicity theorem — N_crit(k) non-decreasing ───────────
    let ka = ob_ka_var_std(); let fv = ob_f_var_std()
    let ke = ob_ke_var_std(); let k12 = ob_k12_var_std(); let k21 = ob_k21_var_std()
    let ke_inh = ob_ke_var_inh(); let ke_ind = ob_ke_var_ind()
    // Standard: monotone across all 3 adjacent pairs
    if ks_monotone(5.0, 60, 0.01118, 0.141, ka, fv, ke, k12, k21, 1.282, 1.645) { score = score + 1 };
    if ks_monotone(5.0, 60, 0.01118, 0.141, ka, fv, ke, k12, k21, 1.645, 2.000) { score = score + 1 };
    if ks_monotone(5.0, 60, 0.01118, 0.141, ka, fv, ke, k12, k21, 2.000, 2.576) { score = score + 1 };
    // Slow: monotone
    if ks_monotone(5.0, 60, 0.00838, 0.188, ka, fv, ke, k12, k21, 1.282, 2.576) { score = score + 1 };
    // Fast: monotone
    if ks_monotone(5.0, 60, 0.01677, 0.094, ka, fv, ke, k12, k21, 1.282, 2.576) { score = score + 1 };
    // Inhibitor: monotone
    if ks_monotone(1.5, 60, 0.002236, 0.282, ka, fv, ke_inh, k12, k21, 1.282, 2.576) { score = score + 1 };
    // Inducer D=34mg: monotone across all k
    if ks_monotone(34.0, 60, 0.05590, 0.047, ka, fv, ke_ind, k12, k21, 1.282, 2.576) { score = score + 1 };

    // ── Section F: k-spread (sensitivity) ordering ────────────────────────────
    // Fast has the widest k-spread among certifiable strata (13→17 = 4)
    let fast_spread = ks_fast_k99() - ks_fast_k80()
    let std_spread  = ks_std_k99()  - ks_std_k80()
    let slow_spread = ks_slow_k99() - ks_slow_k80()
    let inh_spread  = ks_inh_k99()  - ks_inh_k80()
    if fast_spread == 4 { score = score + 1 };
    if std_spread  == 2 { score = score + 1 };
    if slow_spread == 1 { score = score + 1 };
    if inh_spread  == 1 { score = score + 1 };
    // Fast most k-sensitive; slow most k-robust
    if fast_spread > std_spread  { score = score + 1 };
    if slow_spread <= std_spread { score = score + 1 };

    // ── Section G: Gold theorem connections ───────────────────────────────────
    // ind D=34mg k=2.000: N_crit=26 exactly (Gold theorem — link to Sprint 29)
    if ks_ind_d34_k95() == 26 { score = score + 1 };
    // ind D=34mg k=1.282: N_crit=16 (within standard monitoring protocol)
    if ks_ind_d34_k80() <= 20 { score = score + 1 };
    // ind D=34mg k=2.576: N_crit=49 — exceeds clinical monitoring window
    if ks_ind_d34_k99() > 40 { score = score + 1 };
    // ind D=34mg k=1.282 N_crit < ind D=34mg k=2.000 N_crit (monotonicity)
    if ks_ind_d34_k80() < ks_ind_d34_k95() { score = score + 1 };

    // ── Section H: Clinical implications ─────────────────────────────────────
    // Slow genotype: 3 doses suffice even at k=1.645 (safety margin proven)
    if ks_slow_k90() <= 3 { score = score + 1 };
    // Fast k=2.576 requires 17 doses — exceeds 14-dose standard TDM window
    if ks_fast_k99() > 14 { score = score + 1 };
    // Standard k=2.000 and k=1.645 give same N_crit (6) — 90% already ISO-equivalent
    if ks_std_k90() == ks_std_k95() { score = score + 1 };
    // Slow k=2.000 and k=1.282 give same N_crit (3) — extreme k-robustness
    if ks_slow_k80() == ks_slow_k95() { score = score + 1 };
    // Inducer D=20mg uncertifiable at EVERY k (both 80% and 95% give 0)
    if ks_ind_d20_k80() == 0 && ks_ind_d20_k95() == 0 { score = score + 1 };
    // All k=2.000 values match Sprint 26 (consistency check)
    if ks_std_k95() == 6 && ks_slow_k95() == 3 && ks_fast_k95() == 15 && ks_inh_k95() == 7 {
        score = score + 1
    };
    // Fast still requires ≥ 10 doses even at the most lenient 80% coverage
    if ks_fast_k80() >= 10 { score = score + 1 };
    // Inh and std converge at same N_crit at k=2.576 (both require 7 doses at 99%)
    if ks_inh_k99() == ks_std_k99() { score = score + 1 };
    // Fast: going from 95% to 99% costs exactly 2 additional doses
    if ks_fast_k99() - ks_fast_k95() == 2 { score = score + 1 };
    // Slow: going from 95% to 99% costs exactly 1 additional dose
    if ks_slow_k99() - ks_slow_k95() == 1 { score = score + 1 };
    // Ind D=34mg: strict monotone at 90%→95% boundary (20 < 26)
    if ks_ind_d34_k90() < ks_ind_d34_k95() { score = score + 1 };

    score
}
