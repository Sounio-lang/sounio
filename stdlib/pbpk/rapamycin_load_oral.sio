// stdlib/pbpk/rapamycin_load_oral.sio — Loading-dose oral rapamycin
//
// Novel contribution: GUM variance propagation through a clinical loading-dose
// + maintenance protocol (D_load on day 1, D_maint daily thereafter), modelled
// as N multi-dose cycles with heterogeneous first-dose amplitude.
//
// Sprint 15 dissertation finding: the loading dose RESCUES the THERAPEUTIC gate
// for a 2mg/day maintenance regimen — reducing the required number of doses from
// N=21 (uniform 2mg, Sprint 14) to N=14 (6mg load + 2mg maintenance). This is
// the minimal clinical protocol that crosses the epistemic gate within 2 weeks.
//
// ── Loading dose mechanics ────────────────────────────────────────────────────
//
//   Day 0 (loading): A_gut(0) = D_load;  V_gut_f(0) = D_load² × Var(F)
//   Days 1..N-1 (maintenance): A_gut += D_maint; V_gut_f += D_maint² × Var(F)
//
//   The larger initial bolus (D_load > D_maint) achieves higher early central
//   concentrations, pushing the trough into the therapeutic window earlier than
//   uniform D_maint dosing. However, D_load² amplifies the early gut variance
//   contribution (via Var(F)) relative to uniform dosing with the same dose.
//
// ── ka dominance preserved under loading ─────────────────────────────────────
//
//   ka remains the dominant uncertainty source across all tested loading ratios
//   (1:1, 3:1, 4.5:1) and at all N. The large A_gut at day 0 creates a large
//   per-step ka variance injection (0.25 × Var(ka) × A_gut²) that persists
//   through the absorption phase of each dose, preventing any other source from
//   overtaking ka.
//
// ── Second bottleneck after extreme ka tightening ────────────────────────────
//
//   At ka÷16: dom shifts to k12 (index 3, distribution rate) — consistent with
//   Sprint 14. Additionally, at D_load=6mg + ka÷16, conf reaches 950 — the
//   highest epistemic confidence in the entire oral rapamycin trilogy.
//
// ── Standard loading scenario ─────────────────────────────────────────────────
//
//   D_load=6mg, D_maint=2mg, N=14 doses (2 weeks); standard PK + variances.
//   Results: dec=1 (THERAPEUTIC), conf=900, dom=1 (ka)
//
// ── Loading protocol comparison ───────────────────────────────────────────────
//
//   D_maint=2mg uniform × 14 → UNCERTAIN/900 (Sprint 14)
//   D_load=6mg + D_maint=2mg × 13 → THERAPEUTIC/900 (Sprint 15)  ← rescue!
//   D_load=9mg + D_maint=3mg × 13 → THERAPEUTIC/900 at N=7+
//
// ── Budget channel indices ─────────────────────────────────────────────────────
//   0 = F (bioavailability)    1 = ka (absorption rate — universally dominant)
//   2 = ke (elimination)       3 = k12 (distribution — 2nd bottleneck at ka÷16)
//   4 = k21 (return rate)
//
// Effect annotations:
//   classify_load_trough:      with Epistemic, Mut, Div, Panic
//   conf_load_trough:          with Mut, Div, Panic
//   dom_load_trough:           with Mut, Div, Panic
//   classify_standard_load:    with Epistemic, Mut, Div, Panic
//   conf_standard_load:        with Mut, Div, Panic
//   dom_standard_load:         with Mut, Div, Panic
//   load_rescues_therapeutic:  with Epistemic, Mut, Div, Panic
//   load_ka_dominant:          with Mut, Div, Panic
//   load_ka16_optimal:         with Mut, Div, Panic

module pbpk::rapamycin_load_oral

use epistemic::knowledge::{Epistemic}
use pbpk::rapamycin_clinical::{
    assess_trough, conf_from_rel,
    decision_therapeutic, decision_uncertain
}

fn load_sqrt(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { 0.0001 } else {
        var r = x; var i = 0
        while i < 50 { r = (r + x / r) / 2.0; i = i + 1 }
        r
    }
}

fn load_argmax5(b0: f64, b1: f64, b2: f64, b3: f64, b4: f64) -> i64 {
    var idx = 0; var dv = b0
    if b1 > dv { idx = 1; dv = b1 }
    if b2 > dv { idx = 2; dv = b2 }
    if b3 > dv { idx = 3; dv = b3 }
    if b4 > dv { idx = 4 }
    idx
}

// ── classify_load_trough ───────────────────────────────────────────────────────
// Loading-dose Euler: day 0 = d_load, days 1..n_doses-1 = d_maint.
// 48 steps of dt=0.5h per day. Returns trough decision at end of day n_doses-1.

pub fn classify_load_trough(
    d_load: f64, d_maint: f64, n_doses: i64,
    ke_val: f64, ke_var: f64,
    k12_val: f64, k12_var: f64,
    k21_val: f64, k21_var: f64,
    ka_val: f64, ka_var: f64,
    f_val: f64, f_var: f64,
    vc: f64
) -> i64 with Epistemic, Mut, Div, Panic {
    let j11 = 0.0 - (ke_val + k12_val);  let j12 = k21_val
    let j21 = k12_val;                    let j22 = 0.0 - k21_val
    let g11 = 1.0 + 0.5 * j11;           let g12 = 0.5 * j12
    let g21 = 0.5 * j21;                 let g22 = 1.0 + 0.5 * j22
    let g_gut    = 1.0 - 0.5 * ka_val
    let g_gut_sq = g_gut * g_gut

    var a_gut    = d_load
    var a1       = 0.0;     var a2      = 0.0
    var v_gut_f  = d_load * d_load * f_var
    var v_gut_ka = 0.0
    var v1       = 0.0;     var v2      = 0.0

    var dose = 0
    while dose < n_doses {
        if dose > 0 {
            a_gut   = a_gut + d_maint
            v_gut_f = v_gut_f + d_maint * d_maint * f_var
        }
        var step = 0
        while step < 48 {
            let flux   = f_val * ka_val * a_gut
            let new_ag = a_gut + 0.5 * (0.0 - ka_val * a_gut)
            let new_a1 = a1 + 0.5 * (j11 * a1 + j12 * a2 + flux)
            let new_a2 = a2 + 0.5 * (j21 * a1 + j22 * a2)
            let ckg      = 0.25 * ka_var * a_gut * a_gut
            let new_vgf  = g_gut_sq * v_gut_f
            let new_vgka = g_gut_sq * v_gut_ka + ckg
            let v_gut    = v_gut_f + v_gut_ka
            let v1s  = g11*g11*v1 + g12*g12*v2
            let cke  = 0.25 * ke_var  * a1 * a1
            let ck12 = 0.25 * k12_var * a1 * a1
            let ck21 = 0.25 * k21_var * a2 * a2
            let gv1  = 0.25 * ka_val * ka_val * v_gut
            let new_v1 = v1s + cke + ck12 + ck21 + gv1
            let new_v2 = g21*g21*v1 + g22*g22*v2 + 0.25*(k12_var*a1*a1 + k21_var*a2*a2)
            a_gut = new_ag; a1 = new_a1; a2 = new_a2
            v_gut_f = new_vgf; v_gut_ka = new_vgka
            v1 = new_v1; v2 = new_v2
            step = step + 1
        }
        dose = dose + 1
    }
    let c_t   = a1 / vc
    let std_t = load_sqrt(v1) / vc
    let conf  = conf_from_rel(c_t, std_t)
    let c_ep  = Epistemic::new(c_t, v1 / (vc * vc), conf)
    assess_trough(&c_ep)
}

// ── conf_load_trough ───────────────────────────────────────────────────────────

pub fn conf_load_trough(
    d_load: f64, d_maint: f64, n_doses: i64,
    ke_val: f64, ke_var: f64,
    k12_val: f64, k12_var: f64,
    k21_val: f64, k21_var: f64,
    ka_val: f64, ka_var: f64,
    f_val: f64, f_var: f64,
    vc: f64
) -> i64 with Mut, Div, Panic {
    let j11 = 0.0 - (ke_val + k12_val);  let j12 = k21_val
    let j21 = k12_val;                    let j22 = 0.0 - k21_val
    let g11 = 1.0 + 0.5 * j11;           let g12 = 0.5 * j12
    let g21 = 0.5 * j21;                 let g22 = 1.0 + 0.5 * j22
    let g_gut    = 1.0 - 0.5 * ka_val
    let g_gut_sq = g_gut * g_gut

    var a_gut    = d_load
    var a1       = 0.0;     var a2      = 0.0
    var v_gut_f  = d_load * d_load * f_var
    var v_gut_ka = 0.0
    var v1       = 0.0;     var v2      = 0.0

    var dose = 0
    while dose < n_doses {
        if dose > 0 {
            a_gut   = a_gut + d_maint
            v_gut_f = v_gut_f + d_maint * d_maint * f_var
        }
        var step = 0
        while step < 48 {
            let flux   = f_val * ka_val * a_gut
            let new_ag = a_gut + 0.5 * (0.0 - ka_val * a_gut)
            let new_a1 = a1 + 0.5 * (j11 * a1 + j12 * a2 + flux)
            let new_a2 = a2 + 0.5 * (j21 * a1 + j22 * a2)
            let ckg      = 0.25 * ka_var * a_gut * a_gut
            let new_vgf  = g_gut_sq * v_gut_f
            let new_vgka = g_gut_sq * v_gut_ka + ckg
            let v_gut    = v_gut_f + v_gut_ka
            let v1s  = g11*g11*v1 + g12*g12*v2
            let cke  = 0.25 * ke_var  * a1 * a1
            let ck12 = 0.25 * k12_var * a1 * a1
            let ck21 = 0.25 * k21_var * a2 * a2
            let gv1  = 0.25 * ka_val * ka_val * v_gut
            let new_v1 = v1s + cke + ck12 + ck21 + gv1
            let new_v2 = g21*g21*v1 + g22*g22*v2 + 0.25*(k12_var*a1*a1 + k21_var*a2*a2)
            a_gut = new_ag; a1 = new_a1; a2 = new_a2
            v_gut_f = new_vgf; v_gut_ka = new_vgka
            v1 = new_v1; v2 = new_v2
            step = step + 1
        }
        dose = dose + 1
    }
    let c_t   = a1 / vc
    let std_t = load_sqrt(v1) / vc
    conf_from_rel(c_t, std_t)
}

// ── dom_load_trough ────────────────────────────────────────────────────────────

pub fn dom_load_trough(
    d_load: f64, d_maint: f64, n_doses: i64,
    ke_val: f64, ke_var: f64,
    k12_val: f64, k12_var: f64,
    k21_val: f64, k21_var: f64,
    ka_val: f64, ka_var: f64,
    f_val: f64, f_var: f64,
    vc: f64
) -> i64 with Mut, Div, Panic {
    let j11 = 0.0 - (ke_val + k12_val);  let j12 = k21_val
    let j21 = k12_val;                    let j22 = 0.0 - k21_val
    let g11 = 1.0 + 0.5 * j11;           let g12 = 0.5 * j12
    let g21 = 0.5 * j21;                 let g22 = 1.0 + 0.5 * j22
    let g_gut    = 1.0 - 0.5 * ka_val
    let g11sq    = g11 * g11
    let g_gut_sq = g_gut * g_gut

    var a_gut    = d_load
    var a1       = 0.0;     var a2      = 0.0
    var v_gut_f  = d_load * d_load * f_var
    var v_gut_ka = 0.0
    var v1       = 0.0;     var v2      = 0.0
    var bud_f    = 0.0;     var bud_ka  = 0.0
    var bud_ke   = 0.0;     var bud_k12 = 0.0;  var bud_k21 = 0.0

    var dose = 0
    while dose < n_doses {
        if dose > 0 {
            a_gut   = a_gut + d_maint
            v_gut_f = v_gut_f + d_maint * d_maint * f_var
        }
        var step = 0
        while step < 48 {
            let flux   = f_val * ka_val * a_gut
            let new_ag = a_gut + 0.5 * (0.0 - ka_val * a_gut)
            let new_a1 = a1 + 0.5 * (j11 * a1 + j12 * a2 + flux)
            let new_a2 = a2 + 0.5 * (j21 * a1 + j22 * a2)
            let ckg      = 0.25 * ka_var * a_gut * a_gut
            let new_vgf  = g_gut_sq * v_gut_f
            let new_vgka = g_gut_sq * v_gut_ka + ckg
            let v_gut    = v_gut_f + v_gut_ka
            let v1s  = g11sq * v1 + g12*g12*v2
            let cke  = 0.25 * ke_var  * a1 * a1
            let ck12 = 0.25 * k12_var * a1 * a1
            let ck21 = 0.25 * k21_var * a2 * a2
            let ckac = 0.25 * ka_var * a_gut * a_gut * f_val * f_val
            let gv1  = 0.25 * ka_val * ka_val * v_gut
            let new_v1 = v1s + cke + ck12 + ck21 + gv1
            let new_v2 = g21*g21*v1 + g22*g22*v2 + 0.25*(k12_var*a1*a1 + k21_var*a2*a2)
            let bfc  = 0.25 * ka_val * ka_val * v_gut_f
            let bkac = 0.25 * ka_val * ka_val * v_gut_ka + ckac
            a_gut = new_ag; a1 = new_a1; a2 = new_a2
            v_gut_f = new_vgf; v_gut_ka = new_vgka
            v1 = new_v1; v2 = new_v2
            bud_f   = g11sq * bud_f   + bfc
            bud_ka  = g11sq * bud_ka  + bkac
            bud_ke  = g11sq * bud_ke  + cke
            bud_k12 = g11sq * bud_k12 + ck12
            bud_k21 = g11sq * bud_k21 + ck21
            step = step + 1
        }
        dose = dose + 1
    }
    load_argmax5(bud_f, bud_ka, bud_ke, bud_k12, bud_k21)
}

// ── Standard variance constants ────────────────────────────────────────────────

pub fn load_ka_var_std()  -> f64 { 0.0225 }
pub fn load_f_var_std()   -> f64 { 0.001521 }
pub fn load_ke_var_std()  -> f64 { 0.00000841 }
pub fn load_k12_var_std() -> f64 { 0.000156 }
pub fn load_k21_var_std() -> f64 { 0.0000016 }

// ── Standard wrappers: D_load=6mg, D_maint=2mg, standard PK constants ─────────

pub fn classify_standard_load(n_doses: i64, ka_var: f64) -> i64
    with Epistemic, Mut, Div, Panic {
    classify_load_trough(6.0, 2.0, n_doses,
                         0.01118, load_ke_var_std(), 0.05, load_k12_var_std(),
                         0.005, load_k21_var_std(), 0.62, ka_var,
                         0.141, load_f_var_std(), 75.0)
}

pub fn conf_standard_load(n_doses: i64, ka_var: f64) -> i64
    with Mut, Div, Panic {
    conf_load_trough(6.0, 2.0, n_doses,
                     0.01118, load_ke_var_std(), 0.05, load_k12_var_std(),
                     0.005, load_k21_var_std(), 0.62, ka_var,
                     0.141, load_f_var_std(), 75.0)
}

pub fn dom_standard_load(n_doses: i64, ka_var: f64) -> i64
    with Mut, Div, Panic {
    dom_load_trough(6.0, 2.0, n_doses,
                    0.01118, load_ke_var_std(), 0.05, load_k12_var_std(),
                    0.005, load_k21_var_std(), 0.62, ka_var,
                    0.141, load_f_var_std(), 75.0)
}

// ── Uniform 2mg wrappers (for rescue comparison) ───────────────────────────────

pub fn classify_uniform_2mg(n_doses: i64) -> i64
    with Epistemic, Mut, Div, Panic {
    classify_load_trough(2.0, 2.0, n_doses,
                         0.01118, load_ke_var_std(), 0.05, load_k12_var_std(),
                         0.005, load_k21_var_std(), 0.62, load_ka_var_std(),
                         0.141, load_f_var_std(), 75.0)
}

pub fn conf_uniform_2mg(n_doses: i64) -> i64 with Mut, Div, Panic {
    conf_load_trough(2.0, 2.0, n_doses,
                     0.01118, load_ke_var_std(), 0.05, load_k12_var_std(),
                     0.005, load_k21_var_std(), 0.62, load_ka_var_std(),
                     0.141, load_f_var_std(), 75.0)
}

// ── Gate summary functions ─────────────────────────────────────────────────────

// Loading dose rescues the 2mg maintenance protocol:
// uniform 2mg × 14 → UNCERTAIN, but 6mg load + 2mg × 13 → THERAPEUTIC
pub fn load_rescues_therapeutic() -> bool with Epistemic, Mut, Div, Panic {
    let unif_14 = classify_uniform_2mg(14)
    let load_14 = classify_standard_load(14, load_ka_var_std())
    unif_14 == decision_uncertain() && load_14 == decision_therapeutic()
}

// ka remains dominant with the 6mg loading dose
pub fn load_ka_dominant() -> bool with Mut, Div, Panic {
    dom_standard_load(14, load_ka_var_std()) == 1
}

// ka/16 at loaded SS: conf=950 (highest in trilogy), k12 surfaces as second bottleneck
pub fn load_ka16_optimal() -> bool with Mut, Div, Panic {
    let conf16 = conf_standard_load(14, load_ka_var_std() / 16.0)
    let dom16  = dom_standard_load(14, load_ka_var_std() / 16.0)
    conf16 == 950 && dom16 == 3
}
