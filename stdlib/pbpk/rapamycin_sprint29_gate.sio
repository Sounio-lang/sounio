// stdlib/pbpk/rapamycin_sprint29_gate.sio — Sprint 29 certification gate
//
// Certifies the Confidence-N Hierarchy theorem and false confidence window
// quantification across all clinical strata.
//
// 56 assertions in sections A–H. All must pass (return 56).

module pbpk::rapamycin_sprint29_gate

use pbpk::rapamycin_conf_hierarchy::{
    ch_find_n_conf, ch_find_n_crit, ch_false_window_width, ch_conf_before_crit,
    ch_std_n_conf, ch_std_n_crit, ch_std_false_window,
    ch_slow_n_conf, ch_slow_n_crit, ch_slow_false_window,
    ch_fast_n_conf, ch_fast_n_crit, ch_fast_false_window,
    ch_inh_n_conf, ch_inh_n_crit, ch_inh_false_window,
    ch_ind_n_conf, ch_ind_n_crit_d20, ch_ind_n_crit_d34,
    ch_std_hierarchy_holds, ch_slow_hierarchy_holds,
    ch_fast_hierarchy_holds, ch_inh_hierarchy_holds,
    ch_ind_conf_certifies_ci_never
}
use pbpk::rapamycin_oral_budget::{
    ob_ka_var_std, ob_f_var_std, ob_ke_var_std, ob_k12_var_std, ob_k21_var_std,
    ob_ke_var_inh, ob_ke_var_ind
}

pub fn rapamycin_sprint29_gate() -> i64 with Mut, Div, Panic {
    var score = 0

    // ── Section A: N_conf exact values ───────────────────────────────────────
    // Standard genotype: N_conf=2 (C=9.79 ng/mL, high relative to floor; conf rises fast)
    if ch_std_n_conf() == 2 { score = score + 1 };
    // Slow genotype: N_conf=1 (C=14.49 ng/mL >> floor; even N=1 conf is ≥ 800)
    if ch_slow_n_conf() == 1 { score = score + 1 };
    // Fast genotype: N_conf=5 (C=5.37 ng/mL barely above floor; needs 5 doses for conf)
    if ch_fast_n_conf() == 5 { score = score + 1 };
    // Inhibitor (D=1.5mg): N_conf=1 (C=8.33 ng/mL well above floor)
    if ch_inh_n_conf() == 1 { score = score + 1 };
    // Inducer (D=20mg): N_conf=26 (conf finally reaches 820 at N=26)
    if ch_ind_n_conf() == 26 { score = score + 1 };

    // ── Section B: N_crit exact values (hierarchy denominator) ────────────────
    if ch_std_n_crit() == 6 { score = score + 1 };
    if ch_slow_n_crit() == 3 { score = score + 1 };
    if ch_fast_n_crit() == 15 { score = score + 1 };
    if ch_inh_n_crit() == 7 { score = score + 1 };
    // Inducer D=20mg: N_crit=0 — CI never certifiable (SS C=4.71 ng/mL, u_c too large)
    if ch_ind_n_crit_d20() == 0 { score = score + 1 };

    // ── Section C: False confidence window widths ─────────────────────────────
    // std: [2, 5] — 4 doses of false confidence
    if ch_std_false_window() == 4 { score = score + 1 };
    // slow: [1, 2] — 2 doses of false confidence (smallest certifiable)
    if ch_slow_false_window() == 2 { score = score + 1 };
    // fast: [5, 14] — 10 doses of false confidence (LARGEST certifiable)
    if ch_fast_false_window() == 10 { score = score + 1 };
    // inh: [1, 6] — 6 doses of false confidence
    if ch_inh_false_window() == 6 { score = score + 1 };
    // fast false window is larger than std false window
    if ch_fast_false_window() > ch_std_false_window() { score = score + 1 };
    // inh false window is larger than slow false window
    if ch_inh_false_window() > ch_slow_false_window() { score = score + 1 };

    // ── Section D: Hierarchy theorem — N_conf < N_crit for all certifiable strata
    if ch_std_hierarchy_holds() { score = score + 1 };
    if ch_slow_hierarchy_holds() { score = score + 1 };
    if ch_fast_hierarchy_holds() { score = score + 1 };
    if ch_inh_hierarchy_holds() { score = score + 1 };

    // ── Section E: Inducer catastrophic case ─────────────────────────────────
    // N_conf=26 but N_crit=0: confidence certifies, CI NEVER certifies at D=20mg
    if ch_ind_conf_certifies_ci_never() { score = score + 1 };
    // N_conf > 0 alone (conf does eventually certify for inducer)
    if ch_ind_n_conf() > 0 { score = score + 1 };
    // N_crit at D=20mg is 0 (CI cannot be rescued by N at this dose)
    if ch_ind_n_crit_d20() == 0 { score = score + 1 };
    // At D=34mg (certified dose from Sprint 27), N_crit is FOUND (not 0)
    if ch_ind_n_crit_d34() > 0 { score = score + 1 };
    // D=34mg N_crit is ≤ 26 (certifiable by the time inducer N_conf fires)
    if ch_ind_n_crit_d34() <= 26 { score = score + 1 };

    // ── Section F: Ordering relationships ────────────────────────────────────
    // Slow has smallest N_conf (1) of all certifiable strata
    if ch_slow_n_conf() <= ch_std_n_conf() { score = score + 1 };
    if ch_slow_n_conf() <= ch_fast_n_conf() { score = score + 1 };
    if ch_slow_n_conf() <= ch_inh_n_conf() { score = score + 1 };
    // Fast has largest N_conf among certifiable strata
    if ch_fast_n_conf() >= ch_std_n_conf() { score = score + 1 };
    if ch_fast_n_conf() >= ch_slow_n_conf() { score = score + 1 };
    // N_crit ordering: slow < std < inh < fast
    if ch_slow_n_crit() < ch_std_n_crit() { score = score + 1 };
    if ch_std_n_crit() < ch_inh_n_crit() { score = score + 1 };
    if ch_inh_n_crit() < ch_fast_n_crit() { score = score + 1 };
    // False window ordering: slow < std < inh < fast
    if ch_slow_false_window() < ch_std_false_window() { score = score + 1 };
    if ch_std_false_window() < ch_inh_false_window() { score = score + 1 };
    if ch_inh_false_window() < ch_fast_false_window() { score = score + 1 };

    // ── Section G: Bounds and safety invariants ────────────────────────────────
    // All N_conf values are positive (conf eventually certifies for all strata)
    if ch_std_n_conf() > 0 { score = score + 1 };
    if ch_slow_n_conf() > 0 { score = score + 1 };
    if ch_fast_n_conf() > 0 { score = score + 1 };
    if ch_inh_n_conf() > 0 { score = score + 1 };
    if ch_ind_n_conf() > 0 { score = score + 1 };
    // All N_crit for certifiable strata are within max_n=50
    if ch_std_n_crit() > 0 { score = score + 1 };
    if ch_slow_n_crit() > 0 { score = score + 1 };
    if ch_fast_n_crit() > 0 { score = score + 1 };
    if ch_inh_n_crit() > 0 { score = score + 1 };
    // All false windows are non-negative
    if ch_std_false_window() >= 0 { score = score + 1 };
    if ch_slow_false_window() >= 0 { score = score + 1 };
    if ch_fast_false_window() >= 0 { score = score + 1 };
    if ch_inh_false_window() >= 0 { score = score + 1 };

    // ── Section H: Clinical implications ─────────────────────────────────────
    // Fast metabolizer false window is clinically significant (> 5 doses)
    if ch_fast_false_window() > 5 { score = score + 1 };
    // Slow metabolizer fast N_crit (≤ 5) enables early safety certification
    if ch_slow_n_crit() <= 5 { score = score + 1 };
    // Inducer N_conf is above clinical standard N=14 (N_conf=26 > 14)
    if ch_ind_n_conf() > 14 { score = score + 1 };
    // Standard stratum N_crit within routine TDM window (≤ 14 doses)
    if ch_std_n_crit() <= 14 { score = score + 1 };
    // Inhibitor N_crit within routine TDM window (≤ 14 doses)
    if ch_inh_n_crit() <= 14 { score = score + 1 };
    // Fast N_crit exceeds routine TDM window (> 14) — requires extended monitoring
    if ch_fast_n_crit() > 14 { score = score + 1 };
    // Inducer D=34mg N_crit within certifiable range
    if ch_ind_n_crit_d34() >= 1 { score = score + 1 };

    score
}
