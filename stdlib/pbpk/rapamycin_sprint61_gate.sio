// stdlib/pbpk/rapamycin_sprint61_gate.sio — Sprint 61 certification gate
//
// GUM u_c trajectory and CV evolution for the standard stratum.
//
// Key values (std ke=0.01118, F=0.141, D=5mg):
//   c  (mg/L): N=1:0.002590, N=7:0.006411, N=14:0.009793, N=28:0.015258,
//              N=42:0.019358, N=56:0.022433
//   uc (mg/L): N=1:0.000805, N=7:0.000855, N=14:0.000901, N=28:0.001011,
//              N=42:0.001116, N=56:0.001205
//   CV=uc/c:   N=1:0.311, N=7:0.133, N=14:0.092, N=28:0.066
//   uc ratios: uc(7)/uc(1)=1.061, uc(14)/uc(7)=1.054, uc(28)/uc(14)=1.123
//   c  ratios: c(7)/c(1)=2.475,   c(14)/c(7)=1.528
//   double_n=0 (u_c never doubles within N=200)
//
// Finding A: u_c increases monotonically — accumulation amplifies ke sensitivity.
// Finding B: CV = u_c/c decreases 4.7× from N=1 to N=28; halves by N=7.
// Finding C: c at N=1 = 0.00259 mg/L < floor = 0.004 mg/L — N=1 ALARM is
//            genuine pharmacological under-dosing, not epistemic artefact.
// Finding D: margin gains are driven by trough centering (c grows 2.5× from
//            N=1→7) not by u_c contraction (u_c grows only 6.1% same interval).
//
// 56 assertions in sections A–H. All must pass (return 56).

module pbpk::rapamycin_sprint61_gate

use pbpk::rapamycin_uc_trajectory::{
    uct_c_n1,  uct_c_n7,  uct_c_n14, uct_c_n28, uct_c_n42, uct_c_n56,
    uct_uc_n1, uct_uc_n7, uct_uc_n14, uct_uc_n28, uct_uc_n42, uct_uc_n56,
    uct_cv_n1, uct_cv_n7, uct_cv_n14, uct_cv_n28,
    uct_uc_ratio_n7_n1, uct_uc_ratio_n14_n7, uct_uc_ratio_n28_n14,
    uct_c_ratio_n7_n1, uct_c_ratio_n14_n7,
    uct_double_n
}

pub fn rapamycin_sprint61_gate() -> i64 with Mut, Div, Panic {
    var score = 0

    // ── Section A: u_c increases monotonically (Finding A) ───────────────────
    if uct_uc_n7()  > uct_uc_n1()  { score = score + 1 };
    if uct_uc_n14() > uct_uc_n7()  { score = score + 1 };
    if uct_uc_n28() > uct_uc_n14() { score = score + 1 };
    if uct_uc_n42() > uct_uc_n28() { score = score + 1 };
    if uct_uc_n56() > uct_uc_n42() { score = score + 1 };
    if uct_uc_n1()  > 0.0008 { score = score + 1 };
    if uct_uc_n1()  < 0.0009 { score = score + 1 };

    // ── Section B: CV = u_c/c decreases monotonically (Finding B) ───────────
    if uct_cv_n7()  < uct_cv_n1()  { score = score + 1 };
    if uct_cv_n14() < uct_cv_n7()  { score = score + 1 };
    if uct_cv_n28() < uct_cv_n14() { score = score + 1 };
    if uct_cv_n1()  > 0.30 { score = score + 1 };
    if uct_cv_n7()  > 0.13 { score = score + 1 };
    if uct_cv_n7()  < 0.14 { score = score + 1 };
    if uct_cv_n28() < 0.07 { score = score + 1 };

    // ── Section C: trough concentration trajectory ────────────────────────────
    if uct_c_n7()  > uct_c_n1()  { score = score + 1 };
    if uct_c_n14() > uct_c_n7()  { score = score + 1 };
    if uct_c_n28() > uct_c_n14() { score = score + 1 };
    if uct_c_n7()  > 0.006 { score = score + 1 };
    if uct_c_n7()  < 0.007 { score = score + 1 };
    if uct_c_n14() > 0.009 { score = score + 1 };
    if uct_c_n14() < 0.011 { score = score + 1 };

    // ── Section D: trough crosses floor, midpoint, and ceiling (Finding C) ────
    if uct_c_n1()  < 0.004 { score = score + 1 };
    if uct_c_n7()  > 0.004 { score = score + 1 };
    if uct_c_n14() < 0.012 { score = score + 1 };
    if uct_c_n28() > 0.012 { score = score + 1 };
    if uct_c_n28() < 0.020 { score = score + 1 };
    if uct_c_n42() < 0.020 { score = score + 1 };
    if uct_c_n56() > 0.020 { score = score + 1 };

    // ── Section E: u_c growth ratios and bounded amplification (Finding A/D) ──
    if uct_uc_ratio_n7_n1()   > 1.0 { score = score + 1 };
    if uct_uc_ratio_n14_n7()  > 1.0 { score = score + 1 };
    if uct_uc_ratio_n28_n14() > 1.0 { score = score + 1 };
    if uct_uc_ratio_n7_n1()   > 1.05 { score = score + 1 };
    if uct_uc_ratio_n7_n1()   < 1.10 { score = score + 1 };
    if uct_double_n() == 0 { score = score + 1 };
    if uct_uc_ratio_n28_n14() > uct_uc_ratio_n14_n7() { score = score + 1 };

    // ── Section F: trough grows much faster than u_c (Finding D) ─────────────
    if uct_c_ratio_n7_n1()  > uct_uc_ratio_n7_n1()  { score = score + 1 };
    if uct_c_ratio_n14_n7() > uct_uc_ratio_n14_n7() { score = score + 1 };
    if uct_c_ratio_n7_n1()  > 2.0 { score = score + 1 };
    if uct_c_ratio_n7_n1()  < 3.0 { score = score + 1 };
    if uct_c_ratio_n14_n7() > 1.5 { score = score + 1 };
    if uct_c_ratio_n14_n7() < 1.6 { score = score + 1 };
    if uct_c_ratio_n7_n1()  > uct_uc_ratio_n7_n1() * 2.0 { score = score + 1 };

    // ── Section G: GUM precision at monitoring visits ─────────────────────────
    if uct_uc_n7()  > 0.00085 { score = score + 1 };
    if uct_uc_n7()  < 0.00090 { score = score + 1 };
    if uct_c_n7()   > 0.006 { score = score + 1 };
    if uct_cv_n7()  < uct_cv_n1() / 2.0 { score = score + 1 };
    if uct_cv_n28() < uct_cv_n1() / 4.0 { score = score + 1 };
    if uct_c_n28()  > uct_c_n7() * 2.0 { score = score + 1 };
    if uct_uc_n28() < uct_uc_n1() * 2.0 { score = score + 1 };

    // ── Section H: policy — certification driven by centering, not contraction ─
    if uct_c_n1()  < 0.004 { score = score + 1 };
    if uct_c_n7()  > 0.004 { score = score + 1 };
    if uct_cv_n7()  < 0.14 { score = score + 1 };
    if uct_cv_n28() < 0.07 { score = score + 1 };
    if uct_uc_n28() > uct_uc_n1() { score = score + 1 };
    if uct_double_n() == 0 { score = score + 1 };
    if uct_c_ratio_n7_n1() > uct_uc_ratio_n7_n1() * 2.0 { score = score + 1 };

    score
}
