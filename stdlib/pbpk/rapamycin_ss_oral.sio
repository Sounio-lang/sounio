// stdlib/pbpk/rapamycin_ss_oral.sio — Steady-state multi-dose oral rapamycin
//
// Novel contribution: GUM variance propagation through N consecutive oral doses
// of a 3-compartment (gut → central → peripheral) model. Answers the question:
// does the dominant uncertainty source flip as the patient approaches steady state?
//
// Sprint 14 dissertation finding: ka (absorption rate) REMAINS the dominant
// uncertainty source at steady state, for all clinically relevant N (3–28 doses).
//
// ── Why ka is universal ────────────────────────────────────────────────────────
//
//   At each new dose, A_gut is re-loaded with d_oral (mg). The per-step budget
//   injection from ka is 0.25 × Var(ka) × A_gut² (dt=0.5h hardcoded), which is
//   LARGE early in each dose interval when A_gut is at its maximum. This injection
//   recurs every dose interval, preventing ke from catching up.
//
//   ke's term 0.25 × Var(ke) × A1² is small because A1 at trough is depleted
//   AND Var(ke) = 8.41e-6 is 18× smaller than Var(k12) = 1.56e-4.
//
// ── Second bottleneck ─────────────────────────────────────────────────────────
//
//   After extreme ka tightening (÷16), dom flips to k12 (index 3) — NOT ke
//   (index 2), NOT F (index 0). At steady state, drug accumulates extensively
//   in the peripheral compartment; k12_var × A1² >> ke_var × A1².
//
// ── Standard SS scenario ──────────────────────────────────────────────────────
//
//   ke=0.01118 h⁻¹, k12=0.05, k21=0.005, Vc=75L, ka=0.62 h⁻¹, F=0.141
//   D=5mg per dose, N=14 doses (2 weeks ≈ true SS, t½≈62h)
//   dt=0.5h, 48 steps per dose, 672 total steps
//
//   Results: dec=1 (THERAPEUTIC), conf=900, dom=1 (ka)
//
// ── SS onset ──────────────────────────────────────────────────────────────────
//
//   D=5mg: THERAPEUTIC from N=3 doses (conf=820); N=14 gives conf=900
//   D=2mg: needs N=21 doses to reach THERAPEUTIC (slow accumulation)
//
// ── Improvement hierarchy at SS (N=14, D=5mg) ────────────────────────────────
//
//   ka÷4 → THERAPEUTIC/900/ka (dom stays; same as baseline after SS reached)
//   ke÷4 → THERAPEUTIC/900/ka (irrelevant — dec/conf/dom unchanged)
//   F÷4  → THERAPEUTIC/900/ka (irrelevant — dec/conf/dom unchanged)
//   ka÷16 → THERAPEUTIC/900/k12 (dom shifts to k12, NOT ke)
//
// ── Clinical implication ──────────────────────────────────────────────────────
//
//   Across ALL phases of oral rapamycin therapy — single dose AND steady state —
//   only dense sampling around Tmax (≈4h post-dose) to characterize ka crosses
//   the clinical gate. Elimination (ke) and bioavailability (F) characterization
//   are wasted resources at every stage of therapy.
//
// ── Budget channel indices ─────────────────────────────────────────────────────
//   0 = F (bioavailability)    1 = ka (absorption rate — dominant)
//   2 = ke (elimination)       3 = k12 (distribution — 2nd bottleneck at ka÷16)
//   4 = k21 (return rate)
//
// Effect annotations:
//   classify_ss_trough:     with Epistemic, Mut, Div, Panic
//   conf_ss_trough:         with Mut, Div, Panic
//   dom_ss_trough:          with Mut, Div, Panic
//   classify_standard_ss:   with Epistemic, Mut, Div, Panic
//   conf_standard_ss:       with Mut, Div, Panic
//   dom_standard_ss:        with Mut, Div, Panic
//   ss_ka_dominant:         with Mut, Div, Panic
//   ss_k12_second_bottleneck: with Mut, Div, Panic
//   ss_ke_irrelevant:       with Epistemic, Mut, Div, Panic
//   ss_onset_fires:         with Epistemic, Mut, Div, Panic

module pbpk::rapamycin_ss_oral

use epistemic::knowledge::{Epistemic}
use pbpk::rapamycin_clinical::{
    assess_trough, conf_from_rel,
    decision_therapeutic, decision_uncertain
}

fn ss_sqrt(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { 0.0001 } else {
        var r = x; var i = 0
        while i < 50 { r = (r + x / r) / 2.0; i = i + 1 }
        r
    }
}

fn ss_argmax5(b0: f64, b1: f64, b2: f64, b3: f64, b4: f64) -> i64 {
    var idx = 0; var dv = b0
    if b1 > dv { idx = 1; dv = b1 }
    if b2 > dv { idx = 2; dv = b2 }
    if b3 > dv { idx = 3; dv = b3 }
    if b4 > dv { idx = 4 }
    idx
}

// ── classify_ss_trough ─────────────────────────────────────────────────────────
// Multi-dose Euler: n_doses × 48 steps of dt=0.5h. Returns trough decision.
// Budget channels not tracked (only trough classification needed here).

pub fn classify_ss_trough(
    ke_val: f64, ke_var: f64,
    k12_val: f64, k12_var: f64,
    k21_val: f64, k21_var: f64,
    ka_val: f64, ka_var: f64,
    f_val: f64, f_var: f64,
    d_oral: f64, vc: f64, n_doses: i64
) -> i64 with Epistemic, Mut, Div, Panic {
    let j11 = 0.0 - (ke_val + k12_val);  let j12 = k21_val
    let j21 = k12_val;                    let j22 = 0.0 - k21_val
    let g11 = 1.0 + 0.5 * j11;           let g12 = 0.5 * j12
    let g21 = 0.5 * j21;                 let g22 = 1.0 + 0.5 * j22
    let g_gut    = 1.0 - 0.5 * ka_val
    let g_gut_sq = g_gut * g_gut

    var a_gut    = d_oral
    var a1       = 0.0;     var a2      = 0.0
    var v_gut_f  = d_oral * d_oral * f_var
    var v_gut_ka = 0.0
    var v1       = 0.0;     var v2      = 0.0

    var dose = 0
    while dose < n_doses {
        if dose > 0 {
            a_gut   = a_gut + d_oral
            v_gut_f = v_gut_f + d_oral * d_oral * f_var
        }
        var step = 0
        while step < 48 {
            let flux   = f_val * ka_val * a_gut
            let new_ag = a_gut + 0.5 * (0.0 - ka_val * a_gut)
            let new_a1 = a1 + 0.5 * (j11 * a1 + j12 * a2 + flux)
            let new_a2 = a2 + 0.5 * (j21 * a1 + j22 * a2)
            let ckg      = 0.25 * ka_var * a_gut * a_gut
            let new_vgf  = g_gut_sq * v_gut_f
            let new_vgka = g_gut_sq * v_gut_ka + ckg
            let v_gut    = v_gut_f + v_gut_ka
            let v1s  = g11*g11*v1 + g12*g12*v2
            let cke  = 0.25 * ke_var  * a1 * a1
            let ck12 = 0.25 * k12_var * a1 * a1
            let ck21 = 0.25 * k21_var * a2 * a2
            let gv1  = 0.25 * ka_val * ka_val * v_gut
            let new_v1 = v1s + cke + ck12 + ck21 + gv1
            let new_v2 = g21*g21*v1 + g22*g22*v2 + 0.25*(k12_var*a1*a1 + k21_var*a2*a2)
            a_gut = new_ag; a1 = new_a1; a2 = new_a2
            v_gut_f = new_vgf; v_gut_ka = new_vgka
            v1 = new_v1; v2 = new_v2
            step = step + 1
        }
        dose = dose + 1
    }
    let c_t   = a1 / vc
    let std_t = ss_sqrt(v1) / vc
    let conf  = conf_from_rel(c_t, std_t)
    let c_ep  = Epistemic::new(c_t, v1 / (vc * vc), conf)
    assess_trough(&c_ep)
}

// ── conf_ss_trough ─────────────────────────────────────────────────────────────
// Multi-dose Euler. Returns trough confidence score (no Epistemic needed).

pub fn conf_ss_trough(
    ke_val: f64, ke_var: f64,
    k12_val: f64, k12_var: f64,
    k21_val: f64, k21_var: f64,
    ka_val: f64, ka_var: f64,
    f_val: f64, f_var: f64,
    d_oral: f64, vc: f64, n_doses: i64
) -> i64 with Mut, Div, Panic {
    let j11 = 0.0 - (ke_val + k12_val);  let j12 = k21_val
    let j21 = k12_val;                    let j22 = 0.0 - k21_val
    let g11 = 1.0 + 0.5 * j11;           let g12 = 0.5 * j12
    let g21 = 0.5 * j21;                 let g22 = 1.0 + 0.5 * j22
    let g_gut    = 1.0 - 0.5 * ka_val
    let g_gut_sq = g_gut * g_gut

    var a_gut    = d_oral
    var a1       = 0.0;     var a2      = 0.0
    var v_gut_f  = d_oral * d_oral * f_var
    var v_gut_ka = 0.0
    var v1       = 0.0;     var v2      = 0.0

    var dose = 0
    while dose < n_doses {
        if dose > 0 {
            a_gut   = a_gut + d_oral
            v_gut_f = v_gut_f + d_oral * d_oral * f_var
        }
        var step = 0
        while step < 48 {
            let flux   = f_val * ka_val * a_gut
            let new_ag = a_gut + 0.5 * (0.0 - ka_val * a_gut)
            let new_a1 = a1 + 0.5 * (j11 * a1 + j12 * a2 + flux)
            let new_a2 = a2 + 0.5 * (j21 * a1 + j22 * a2)
            let ckg      = 0.25 * ka_var * a_gut * a_gut
            let new_vgf  = g_gut_sq * v_gut_f
            let new_vgka = g_gut_sq * v_gut_ka + ckg
            let v_gut    = v_gut_f + v_gut_ka
            let v1s  = g11*g11*v1 + g12*g12*v2
            let cke  = 0.25 * ke_var  * a1 * a1
            let ck12 = 0.25 * k12_var * a1 * a1
            let ck21 = 0.25 * k21_var * a2 * a2
            let gv1  = 0.25 * ka_val * ka_val * v_gut
            let new_v1 = v1s + cke + ck12 + ck21 + gv1
            let new_v2 = g21*g21*v1 + g22*g22*v2 + 0.25*(k12_var*a1*a1 + k21_var*a2*a2)
            a_gut = new_ag; a1 = new_a1; a2 = new_a2
            v_gut_f = new_vgf; v_gut_ka = new_vgka
            v1 = new_v1; v2 = new_v2
            step = step + 1
        }
        dose = dose + 1
    }
    let c_t   = a1 / vc
    let std_t = ss_sqrt(v1) / vc
    conf_from_rel(c_t, std_t)
}

// ── dom_ss_trough ──────────────────────────────────────────────────────────────
// Multi-dose Euler with 5-channel budget tracking. Returns dominant source index.

pub fn dom_ss_trough(
    ke_val: f64, ke_var: f64,
    k12_val: f64, k12_var: f64,
    k21_val: f64, k21_var: f64,
    ka_val: f64, ka_var: f64,
    f_val: f64, f_var: f64,
    d_oral: f64, vc: f64, n_doses: i64
) -> i64 with Mut, Div, Panic {
    let j11 = 0.0 - (ke_val + k12_val);  let j12 = k21_val
    let j21 = k12_val;                    let j22 = 0.0 - k21_val
    let g11 = 1.0 + 0.5 * j11;           let g12 = 0.5 * j12
    let g21 = 0.5 * j21;                 let g22 = 1.0 + 0.5 * j22
    let g_gut    = 1.0 - 0.5 * ka_val
    let g11sq    = g11 * g11
    let g_gut_sq = g_gut * g_gut

    var a_gut    = d_oral
    var a1       = 0.0;     var a2      = 0.0
    var v_gut_f  = d_oral * d_oral * f_var
    var v_gut_ka = 0.0
    var v1       = 0.0;     var v2      = 0.0
    var bud_f    = 0.0;     var bud_ka  = 0.0
    var bud_ke   = 0.0;     var bud_k12 = 0.0;  var bud_k21 = 0.0

    var dose = 0
    while dose < n_doses {
        if dose > 0 {
            a_gut   = a_gut + d_oral
            v_gut_f = v_gut_f + d_oral * d_oral * f_var
        }
        var step = 0
        while step < 48 {
            let flux   = f_val * ka_val * a_gut
            let new_ag = a_gut + 0.5 * (0.0 - ka_val * a_gut)
            let new_a1 = a1 + 0.5 * (j11 * a1 + j12 * a2 + flux)
            let new_a2 = a2 + 0.5 * (j21 * a1 + j22 * a2)
            let ckg      = 0.25 * ka_var * a_gut * a_gut
            let new_vgf  = g_gut_sq * v_gut_f
            let new_vgka = g_gut_sq * v_gut_ka + ckg
            let v_gut    = v_gut_f + v_gut_ka
            let v1s  = g11sq * v1 + g12*g12*v2
            let cke  = 0.25 * ke_var  * a1 * a1
            let ck12 = 0.25 * k12_var * a1 * a1
            let ck21 = 0.25 * k21_var * a2 * a2
            let ckac = 0.25 * ka_var * a_gut * a_gut * f_val * f_val
            let gv1  = 0.25 * ka_val * ka_val * v_gut
            let new_v1 = v1s + cke + ck12 + ck21 + gv1
            let new_v2 = g21*g21*v1 + g22*g22*v2 + 0.25*(k12_var*a1*a1 + k21_var*a2*a2)
            let bfc  = 0.25 * ka_val * ka_val * v_gut_f
            let bkac = 0.25 * ka_val * ka_val * v_gut_ka + ckac
            a_gut = new_ag; a1 = new_a1; a2 = new_a2
            v_gut_f = new_vgf; v_gut_ka = new_vgka
            v1 = new_v1; v2 = new_v2
            bud_f   = g11sq * bud_f   + bfc
            bud_ka  = g11sq * bud_ka  + bkac
            bud_ke  = g11sq * bud_ke  + cke
            bud_k12 = g11sq * bud_k12 + ck12
            bud_k21 = g11sq * bud_k21 + ck21
            step = step + 1
        }
        dose = dose + 1
    }
    ss_argmax5(bud_f, bud_ka, bud_ke, bud_k12, bud_k21)
}

// ── Standard variance constants ────────────────────────────────────────────────

pub fn ss_ka_var_std()  -> f64 { 0.0225 }
pub fn ss_f_var_std()   -> f64 { 0.001521 }
pub fn ss_ke_var_std()  -> f64 { 0.00000841 }
pub fn ss_k12_var_std() -> f64 { 0.000156 }
pub fn ss_k21_var_std() -> f64 { 0.0000016 }

// ── Standard wrappers: D=5mg, standard PK constants, N and ka_var free ─────────

pub fn classify_standard_ss(n_doses: i64, ka_var: f64) -> i64
    with Epistemic, Mut, Div, Panic {
    classify_ss_trough(0.01118, ss_ke_var_std(), 0.05, ss_k12_var_std(),
                       0.005, ss_k21_var_std(), 0.62, ka_var,
                       0.141, ss_f_var_std(), 5.0, 75.0, n_doses)
}

pub fn conf_standard_ss(n_doses: i64, ka_var: f64) -> i64
    with Mut, Div, Panic {
    conf_ss_trough(0.01118, ss_ke_var_std(), 0.05, ss_k12_var_std(),
                   0.005, ss_k21_var_std(), 0.62, ka_var,
                   0.141, ss_f_var_std(), 5.0, 75.0, n_doses)
}

pub fn dom_standard_ss(n_doses: i64, ka_var: f64) -> i64
    with Mut, Div, Panic {
    dom_ss_trough(0.01118, ss_ke_var_std(), 0.05, ss_k12_var_std(),
                  0.005, ss_k21_var_std(), 0.62, ka_var,
                  0.141, ss_f_var_std(), 5.0, 75.0, n_doses)
}

// ── ke-variant wrappers (ke_var free, D=5mg, N=14, ka_var=std) ──────────────

pub fn classify_ss_ke_variant(n_doses: i64, ke_var: f64) -> i64
    with Epistemic, Mut, Div, Panic {
    classify_ss_trough(0.01118, ke_var, 0.05, ss_k12_var_std(),
                       0.005, ss_k21_var_std(), 0.62, ss_ka_var_std(),
                       0.141, ss_f_var_std(), 5.0, 75.0, n_doses)
}

pub fn conf_ss_ke_variant(n_doses: i64, ke_var: f64) -> i64
    with Mut, Div, Panic {
    conf_ss_trough(0.01118, ke_var, 0.05, ss_k12_var_std(),
                   0.005, ss_k21_var_std(), 0.62, ss_ka_var_std(),
                   0.141, ss_f_var_std(), 5.0, 75.0, n_doses)
}

pub fn dom_ss_ke_variant(n_doses: i64, ke_var: f64) -> i64
    with Mut, Div, Panic {
    dom_ss_trough(0.01118, ke_var, 0.05, ss_k12_var_std(),
                  0.005, ss_k21_var_std(), 0.62, ss_ka_var_std(),
                  0.141, ss_f_var_std(), 5.0, 75.0, n_doses)
}

// ── Gate summary functions ─────────────────────────────────────────────────────

// ka dominates at standard SS (N=14, D=5mg)
pub fn ss_ka_dominant() -> bool with Mut, Div, Panic {
    dom_standard_ss(14, ss_ka_var_std()) == 1
}

// after extreme ka tightening (÷16), k12 surfaces as second bottleneck — not ke
pub fn ss_k12_second_bottleneck() -> bool with Mut, Div, Panic {
    dom_standard_ss(14, ss_ka_var_std() / 16.0) == 3
}

// ke÷4 leaves dec, conf, dom unchanged at SS
pub fn ss_ke_irrelevant() -> bool with Epistemic, Mut, Div, Panic {
    let dec_base = classify_standard_ss(14, ss_ka_var_std())
    let dec_kei  = classify_ss_ke_variant(14, ss_ke_var_std() / 4.0)
    let dom_base = dom_standard_ss(14, ss_ka_var_std())
    let dom_kei  = dom_ss_ke_variant(14, ss_ke_var_std() / 4.0)
    dec_base == dec_kei && dom_base == dom_kei
}

// D=5mg onset: N=1 UNCERTAIN, N=3 THERAPEUTIC, dom=ka throughout
pub fn ss_onset_fires() -> bool with Epistemic, Mut, Div, Panic {
    let d1 = classify_standard_ss(1, ss_ka_var_std())
    let d3 = classify_standard_ss(3, ss_ka_var_std())
    d1 == decision_uncertain() && d3 == decision_therapeutic()
}
