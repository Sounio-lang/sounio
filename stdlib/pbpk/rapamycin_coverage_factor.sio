// stdlib/pbpk/rapamycin_coverage_factor.sio — Sprint 43
//
// ISO GUM coverage factor (k) sensitivity: N_crit under four k thresholds
// (90%/95.45%/99%/99.73%) across all five pharmacogenomic strata.
//
// k=1.645 → 90% two-sided coverage (relaxed regulatory standard)
// k=2.000 → 95.45% (ISO GUM standard, reference throughout this work)
// k=2.576 → 99% (high-confidence clinical requirement)
// k=3.000 → 99.73% (near-total coverage, ultra-conservative)
//
// Finding A: ind catastrophic k-sensitivity — N_crit 20→26→49→0 (NEVER);
//            at k=3.0 the inducer stratum never achieves GUM certification
//            within 60 doses; Z_floor at N=35 is only 2.337, short of k=3.0.
// Finding B: fast monotone k-sensitivity — N_crit 14→15→17→19, adding
//            5 doses across the full k range; floor-binding throughout.
// Finding C: inh k-plateau above k=2.0 — N_crit 6→7→7→7; Z_floor=3.210
//            at N=7 already exceeds k=3.0, making inh certification robust
//            to any regulatory threshold above 90%.
// Finding D: std N=5 sub-threshold — Z_floor=1.600 at N=5 is below the
//            k=1.645 threshold; std N_crit is anchored at 6 for k≤2.0.

module pbpk::rapamycin_coverage_factor

use pbpk::rapamycin_assay::{as_trough_mg_l}
use pbpk::rapamycin_expanded_u::{eu_u_c}
use pbpk::rapamycin_clinical::{trough_floor_mg_l, trough_ceil_mg_l}
use pbpk::rapamycin_oral_budget::{
    ob_ka_var_std, ob_f_var_std, ob_ke_var_std, ob_k12_var_std, ob_k21_var_std,
    ob_ke_var_inh, ob_ke_var_ind
}

fn cf_find_ncrit(d: f64, ke: f64, f: f64,
                 ka_v: f64, f_v: f64, ke_v: f64, k12_v: f64, k21_v: f64,
                 k_thresh: f64) -> i64
    with Mut, Div, Panic {
    let floor = trough_floor_mg_l(); let ceil = trough_ceil_mg_l()
    var n = 1; var found = 0
    while n <= 60 && found == 0 {
        let c  = as_trough_mg_l(d, n, ke, f)
        let uc = eu_u_c(d, n, ke, f, ka_v, f_v, ke_v, k12_v, k21_v)
        if (c - floor) / uc >= k_thresh && (ceil - c) / uc >= k_thresh { found = n }
        else { n = n + 1 }
    }
    found
}

fn cf_zf(d: f64, n: i64, ke: f64, f: f64,
         ka_v: f64, f_v: f64, ke_v: f64, k12_v: f64, k21_v: f64) -> f64
    with Mut, Div, Panic {
    let c  = as_trough_mg_l(d, n, ke, f)
    let uc = eu_u_c(d, n, ke, f, ka_v, f_v, ke_v, k12_v, k21_v)
    (c - trough_floor_mg_l()) / uc
}

// ── std D=5mg ────────────────────────────────────────────────────────────────
pub fn cf_std_ncrit_k165() -> i64 with Mut, Div, Panic {
    let ka=ob_ka_var_std(); let fv=ob_f_var_std(); let ke=ob_ke_var_std()
    let k12=ob_k12_var_std(); let k21=ob_k21_var_std()
    cf_find_ncrit(5.0,0.01118,0.141, ka,fv,ke,k12,k21, 1.645)
}
