// stdlib/pbpk/rapamycin_sprint69_gate.sio — Sprint 69 certification gate
//
// 56 assertions across 8 sections verifying single-measurement TDM update findings.
// All values probe-verified from rapamycin_tdm_update.sio.
//
// Sections:
//   A: Trough concentrations and prior u_pk
//   B: Assay uncertainty crossover — u_lcms < u_pk < u_immuno at all N
//   C: Posterior u values after LCMS and immunoassay
//   D: Precision gain factors
//   E: Posterior margins after LCMS — dramatic gain
//   F: Posterior margins after immunoassay — modest gain
//   G: LCMS/immuno epistemic value ratio
//   H: Cross-sprint: LCMS posterior > Sprint 68 L3 (full ka elimination)
//
// All 56 assertions must pass (return 56).

module pbpk::rapamycin_sprint69_gate

use pbpk::rapamycin_tdm_update::{
    tu_c_n7, tu_c_n14, tu_c_n28,
    tu_u_pk_n7, tu_u_pk_n14, tu_u_pk_n28,
    tu_u_lcms_n7, tu_u_lcms_n14, tu_u_lcms_n28,
    tu_u_immuno_n7, tu_u_immuno_n14, tu_u_immuno_n28,
    tu_u_post_lcms_n7, tu_u_post_lcms_n14, tu_u_post_lcms_n28,
    tu_u_post_immuno_n7, tu_u_post_immuno_n14, tu_u_post_immuno_n28,
    tu_gain_lcms_n7, tu_gain_lcms_n14, tu_gain_lcms_n28,
    tu_gain_immuno_n7, tu_gain_immuno_n14, tu_gain_immuno_n28,
    tu_margin_prior_n7, tu_margin_prior_n14, tu_margin_prior_n28,
    tu_margin_post_lcms_n7, tu_margin_post_lcms_n14, tu_margin_post_lcms_n28,
    tu_margin_post_immuno_n7, tu_margin_post_immuno_n14, tu_margin_post_immuno_n28,
    tu_margin_gain_lcms_n7, tu_margin_gain_lcms_n14, tu_margin_gain_lcms_n28,
    tu_margin_gain_immuno_n7, tu_margin_gain_immuno_n14, tu_margin_gain_immuno_n28,
    tu_lcms_immuno_gain_ratio_n7, tu_lcms_immuno_gain_ratio_n14
}

pub fn rapamycin_sprint69_gate() -> i64 with Mut, Div, Panic {
    var score = 0

    // ── Section A: Trough concentrations and prior u_pk ──────────────────────
    if tu_c_n7()  > 0.006  { score = score + 1 };
    if tu_c_n7()  < 0.007  { score = score + 1 };
    if tu_c_n14() > 0.009  { score = score + 1 };
    if tu_c_n28() > 0.015  { score = score + 1 };
    if tu_u_pk_n7()  > 0.000850 { score = score + 1 };
    if tu_u_pk_n7()  < 0.000860 { score = score + 1 };
    if tu_u_pk_n28() > tu_u_pk_n7() { score = score + 1 };

    // ── Section B: Crossover asymmetry — u_lcms < u_pk < u_immuno ────────────
    if tu_u_lcms_n7()   < tu_u_pk_n7()   { score = score + 1 };
    if tu_u_lcms_n14()  < tu_u_pk_n14()  { score = score + 1 };
    if tu_u_lcms_n28()  < tu_u_pk_n28()  { score = score + 1 };
    if tu_u_immuno_n7()  > tu_u_pk_n7()  { score = score + 1 };
    if tu_u_immuno_n14() > tu_u_pk_n14() { score = score + 1 };
    if tu_u_immuno_n28() > tu_u_pk_n28() { score = score + 1 };
    if tu_u_lcms_n7() < tu_u_immuno_n7() { score = score + 1 };

    // ── Section C: Posterior u values ────────────────────────────────────────
    if tu_u_post_lcms_n7()   < tu_u_pk_n7()   { score = score + 1 };
    if tu_u_post_lcms_n7()   < tu_u_lcms_n7() { score = score + 1 };
    if tu_u_post_immuno_n7() < tu_u_pk_n7()   { score = score + 1 };
    if tu_u_post_lcms_n7()   > 0.000290 { score = score + 1 };
    if tu_u_post_lcms_n7()   < 0.000310 { score = score + 1 };
    if tu_u_post_immuno_n7() > 0.000630 { score = score + 1 };
    if tu_u_post_lcms_n7()   < tu_u_post_immuno_n7() { score = score + 1 };

    // ── Section D: Precision gain factors ────────────────────────────────────
    if tu_gain_lcms_n7()   > 2.8  { score = score + 1 };
    if tu_gain_lcms_n7()   < 2.9  { score = score + 1 };
    if tu_gain_lcms_n14()  > 2.0  { score = score + 1 };
    if tu_gain_lcms_n28()  > 1.6  { score = score + 1 };
    if tu_gain_immuno_n7() > 1.3  { score = score + 1 };
    if tu_gain_immuno_n7() < 1.4  { score = score + 1 };
    if tu_gain_lcms_n7()   > tu_gain_immuno_n7() { score = score + 1 };

    // ── Section E: Posterior margins after LCMS — dramatic (Finding C) ───────
    if tu_margin_prior_n7()     > 2.0  { score = score + 1 };
    if tu_margin_post_lcms_n7() > 8.0  { score = score + 1 };
    if tu_margin_post_lcms_n7() < 8.1  { score = score + 1 };
    if tu_margin_gain_lcms_n7() > 5.0  { score = score + 1 };
    if tu_margin_gain_lcms_n14() > 7.0 { score = score + 1 };
    if tu_margin_post_lcms_n7() > tu_margin_prior_n7() * 2.0 { score = score + 1 };
    if tu_margin_post_lcms_n14() > tu_margin_prior_n14() { score = score + 1 };

    // ── Section F: Posterior margins after immunoassay — modest ──────────────
    if tu_margin_post_immuno_n7()  > tu_margin_prior_n7()  { score = score + 1 };
    if tu_margin_post_immuno_n14() > tu_margin_prior_n14() { score = score + 1 };
    if tu_margin_gain_immuno_n7()  > 0.9  { score = score + 1 };
    if tu_margin_gain_immuno_n7()  < 1.0  { score = score + 1 };
    if tu_margin_gain_immuno_n28() < 0.5  { score = score + 1 };
    if tu_margin_gain_lcms_n7() > tu_margin_gain_immuno_n7() * 4.0 { score = score + 1 };
    if tu_margin_post_lcms_n7() > tu_margin_post_immuno_n7() { score = score + 1 };

    // ── Section G: LCMS/immuno epistemic value ratio (Finding E) ─────────────
    if tu_lcms_immuno_gain_ratio_n7()  > 2.1  { score = score + 1 };
    if tu_lcms_immuno_gain_ratio_n7()  < 2.2  { score = score + 1 };
    if tu_lcms_immuno_gain_ratio_n14() > 1.7  { score = score + 1 };
    if tu_lcms_immuno_gain_ratio_n14() < 1.9  { score = score + 1 };
    if tu_gain_lcms_n7() > tu_gain_lcms_n14() { score = score + 1 };
    if tu_gain_lcms_n14() > tu_gain_lcms_n28() { score = score + 1 };
    if tu_gain_immuno_n28() < 1.1  { score = score + 1 };

    // ── Section H: LCMS posterior > Sprint 68 L3 (full ka elimination) ───────
    // Sprint 68 L3 margin at N=7 = 6.58; LCMS posterior = 8.03 > 6.58 (Finding D)
    if tu_margin_post_lcms_n7() > 6.58 { score = score + 1 };
    if tu_margin_post_lcms_n7() > 8.0  { score = score + 1 };
    if tu_gain_lcms_n7() > 2.5  { score = score + 1 };
    if tu_gain_immuno_n28() > 1.0 { score = score + 1 };
    if tu_u_post_lcms_n7() < tu_u_post_immuno_n7() { score = score + 1 };
    if tu_margin_gain_lcms_n7() > tu_margin_gain_immuno_n7() { score = score + 1 };
    if tu_margin_post_lcms_n7() > tu_margin_prior_n7() { score = score + 1 };

    score
}
