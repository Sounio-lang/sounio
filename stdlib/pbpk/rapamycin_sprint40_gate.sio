// stdlib/pbpk/rapamycin_sprint40_gate.sio — Sprint 40 certification gate
//
// Certifies GUM-exact variance-reduction sensitivity: ka dominance, ind
// ka windfall (−16 doses at ka=0), inh three-lever equivalence, slow floor,
// ke/2 irrelevance across all strata.
//
// 56 assertions in sections A–H. All must pass (return 56).

module pbpk::rapamycin_sprint40_gate

use pbpk::rapamycin_variance_reduction::{
    vr_std_ncrit_base, vr_std_ncrit_ka2, vr_std_ncrit_f2, vr_std_ncrit_ke2,
    vr_std_ncrit_per2, vr_std_ncrit_ka0, vr_std_ncrit_all2,
    vr_slow_ncrit_base, vr_slow_ncrit_ka2, vr_slow_ncrit_ka0, vr_slow_ncrit_all2,
    vr_fast_ncrit_base, vr_fast_ncrit_ka2, vr_fast_ncrit_f2, vr_fast_ncrit_ke2,
    vr_fast_ncrit_per2, vr_fast_ncrit_ka0, vr_fast_ncrit_all2,
    vr_inh_ncrit_base, vr_inh_ncrit_ka2, vr_inh_ncrit_f2, vr_inh_ncrit_ke2,
    vr_inh_ncrit_per2, vr_inh_ncrit_ka0, vr_inh_ncrit_all2,
    vr_ind_ncrit_base, vr_ind_ncrit_ka2, vr_ind_ncrit_f2, vr_ind_ncrit_ke2,
    vr_ind_ncrit_per2, vr_ind_ncrit_ka0, vr_ind_ncrit_all2,
    vr_std_uc_base_n6, vr_fast_uc_base_n15, vr_inh_uc_base_n7, vr_ind_uc_base_n26
}

pub fn rapamycin_sprint40_gate() -> i64 with Mut, Div, Panic {
    var score = 0

    // ── Section A: baseline N_crit values ────────────────────────────────────
    // std=6, slow=3, fast=15, inh=7, ind=26
    if vr_std_ncrit_base() > 5 && vr_std_ncrit_base() < 7 { score = score + 1 };
    if vr_slow_ncrit_base() > 2 && vr_slow_ncrit_base() < 4 { score = score + 1 };
    if vr_fast_ncrit_base() > 14 && vr_fast_ncrit_base() < 16 { score = score + 1 };
    if vr_inh_ncrit_base() > 6 && vr_inh_ncrit_base() < 8 { score = score + 1 };
    if vr_ind_ncrit_base() > 25 && vr_ind_ncrit_base() < 27 { score = score + 1 };
    // Stratum ordering
    if vr_slow_ncrit_base() < vr_std_ncrit_base() { score = score + 1 };
    if vr_fast_ncrit_base() > vr_std_ncrit_base() { score = score + 1 };

    // ── Section B: FINDING A — ka/2 N_crit ───────────────────────────────────
    // std=5, fast=13, inh=6, ind=18; slow unchanged (3)
    if vr_std_ncrit_ka2() > 4 && vr_std_ncrit_ka2() < 6 { score = score + 1 };
    if vr_fast_ncrit_ka2() > 12 && vr_fast_ncrit_ka2() < 14 { score = score + 1 };
    if vr_inh_ncrit_ka2() > 5 && vr_inh_ncrit_ka2() < 7 { score = score + 1 };
    if vr_ind_ncrit_ka2() > 17 && vr_ind_ncrit_ka2() < 19 { score = score + 1 };
    // ka/2 strictly improves std, fast, inh, ind
    if vr_std_ncrit_ka2() < vr_std_ncrit_base() { score = score + 1 };
    if vr_fast_ncrit_ka2() < vr_fast_ncrit_base() { score = score + 1 };
    if vr_ind_ncrit_ka2() < vr_ind_ncrit_base() { score = score + 1 };

    // ── Section C: FINDING B — ka=0 theoretical minimum ─────────────────────
    // std=4, slow=2, fast=11, inh=6, ind=10
    if vr_std_ncrit_ka0() > 3 && vr_std_ncrit_ka0() < 5 { score = score + 1 };
    if vr_slow_ncrit_ka0() > 1 && vr_slow_ncrit_ka0() < 3 { score = score + 1 };
    if vr_fast_ncrit_ka0() > 10 && vr_fast_ncrit_ka0() < 12 { score = score + 1 };
    if vr_inh_ncrit_ka0() > 5 && vr_inh_ncrit_ka0() < 7 { score = score + 1 };
    if vr_ind_ncrit_ka0() > 9 && vr_ind_ncrit_ka0() < 11 { score = score + 1 };
    // Eliminating ka is strictly better than halving it
    if vr_ind_ncrit_ka0() < vr_ind_ncrit_ka2() { score = score + 1 };
    if vr_fast_ncrit_ka0() < vr_fast_ncrit_ka2() { score = score + 1 };

    // ── Section D: FINDING A — ke/2 is negligible ────────────────────────────
    // All strata: ke/2 leaves N_crit unchanged vs baseline
    if vr_std_ncrit_ke2() > 5 && vr_std_ncrit_ke2() < 7 { score = score + 1 };
    if vr_fast_ncrit_ke2() > 14 && vr_fast_ncrit_ke2() < 16 { score = score + 1 };
    if vr_inh_ncrit_ke2() > 6 && vr_inh_ncrit_ke2() < 8 { score = score + 1 };
    if vr_ind_ncrit_ke2() > 25 && vr_ind_ncrit_ke2() < 27 { score = score + 1 };
    // ka/2 beats ke/2 for every stratum where ka/2 improves
    if vr_std_ncrit_ka2() < vr_std_ncrit_ke2() { score = score + 1 };
    if vr_fast_ncrit_ka2() < vr_fast_ncrit_ke2() { score = score + 1 };
    if vr_ind_ncrit_ka2() < vr_ind_ncrit_ke2() { score = score + 1 };

    // ── Section E: F/2 effect ────────────────────────────────────────────────
    // std: no change (6); inh: 7→6; ind: 26→25
    if vr_std_ncrit_f2() > 5 && vr_std_ncrit_f2() < 7 { score = score + 1 };
    if vr_inh_ncrit_f2() > 5 && vr_inh_ncrit_f2() < 7 { score = score + 1 };
    if vr_ind_ncrit_f2() > 24 && vr_ind_ncrit_f2() < 26 { score = score + 1 };
    if vr_inh_ncrit_f2() < vr_inh_ncrit_base() { score = score + 1 };
    if vr_ind_ncrit_f2() < vr_ind_ncrit_base() { score = score + 1 };
    // ka dominates F for ind: ka/2 far better than F/2 (18 vs 25)
    if vr_ind_ncrit_ka2() < vr_ind_ncrit_f2() { score = score + 1 };
    // F/2 no help for std (same baseline); but ka/2 helps: ka2 < f2
    if vr_std_ncrit_f2() > vr_std_ncrit_ka2() { score = score + 1 };

    // ── Section F: peripheral/2 effect ───────────────────────────────────────
    // std: 6 (no change), fast: 15 (no change), inh: 6 (saves 1), ind: 26 (no change)
    if vr_std_ncrit_per2() > 5 && vr_std_ncrit_per2() < 7 { score = score + 1 };
    if vr_fast_ncrit_per2() > 14 && vr_fast_ncrit_per2() < 16 { score = score + 1 };
    if vr_inh_ncrit_per2() > 5 && vr_inh_ncrit_per2() < 7 { score = score + 1 };
    if vr_ind_ncrit_per2() > 25 && vr_ind_ncrit_per2() < 27 { score = score + 1 };
    // Peripheral reduction helps inh (saves 1 dose)
    if vr_inh_ncrit_per2() < vr_inh_ncrit_base() { score = score + 1 };
    // Peripheral irrelevant for ind; ka dominates
    if vr_ind_ncrit_per2() > vr_ind_ncrit_ka2() { score = score + 1 };
    // inh per/2 beats inh ke/2 (per saves 1 dose; ke saves 0)
    if vr_inh_ncrit_per2() < vr_inh_ncrit_ke2() { score = score + 1 };

    // ── Section G: all/2 and FINDING A — ka dominance theorem ────────────────
    // std=5, fast=13, inh=6, ind=17
    if vr_std_ncrit_all2() > 4 && vr_std_ncrit_all2() < 6 { score = score + 1 };
    if vr_fast_ncrit_all2() > 12 && vr_fast_ncrit_all2() < 14 { score = score + 1 };
    if vr_inh_ncrit_all2() > 5 && vr_inh_ncrit_all2() < 7 { score = score + 1 };
    if vr_ind_ncrit_all2() > 16 && vr_ind_ncrit_all2() < 18 { score = score + 1 };
    // all/2 improves on baseline
    if vr_std_ncrit_all2() < vr_std_ncrit_base() { score = score + 1 };
    if vr_ind_ncrit_all2() < vr_ind_ncrit_base() { score = score + 1 };
    // all/2 slightly better than ka/2 for ind (17 < 18): F/2 adds marginal gain
    if vr_ind_ncrit_all2() < vr_ind_ncrit_ka2() { score = score + 1 };

    // ── Section H: cross-stratum findings ────────────────────────────────────
    // Stratum ordering preserved
    if vr_slow_ncrit_base() < vr_std_ncrit_base() { score = score + 1 };
    // FINDING B: ind ka windfall — largest absolute reduction (16 doses at ka=0)
    if vr_ind_ncrit_base() - vr_ind_ncrit_ka0() > 15 { score = score + 1 };
    // FINDING D: slow floor — ke/2 AND ke=0 negligible since N_crit already minimal
    if vr_ind_ncrit_ke2() > vr_ind_ncrit_f2() { score = score + 1 };
    // ke/2 strictly dominated by ka/2 everywhere it matters
    if vr_ind_ncrit_ke2() > vr_ind_ncrit_all2() { score = score + 1 };
    // fast N_crit reduction: ka=0 saves 4 doses (15→11)
    if vr_fast_ncrit_base() - vr_fast_ncrit_ka0() > 3 { score = score + 1 };
    // ind ka halving beats ka=0 difference: ka2 savings (8 doses) > ka0 additional (8 doses)
    if vr_ind_ncrit_ka2() - vr_ind_ncrit_ka0() > 5 { score = score + 1 };
    // FINDING D: slow floor — even ka=0 only saves 1 dose for slow
    if vr_slow_ncrit_ka0() < vr_slow_ncrit_base() { score = score + 1 };

    score
}
