// stdlib/pbpk/rapamycin_expected_margin.sio — Sprint 59
//
// Population-weighted expected GUM margin at each standard monitoring visit.
// E[margin_N] = sum_strata(weight * margin_N); weights: inh=0.05, slow=0.15,
// std=0.50, fast=0.20, ind=0.10.
//
// Values (from five-stratum atlas):
//   N=7:  inh=3.191, slow=1.419, std=2.821, fast=2.059, ind=0.290
//         E[m_7]  = 0.160 + 0.213 + 1.410 + 0.412 + 0.029 = 2.223
//   N=14: inh=9.757, slow=6.251, std=6.432, fast=4.387, ind=1.179
//         E[m_14] = 0.488 + 0.938 + 3.216 + 0.877 + 0.118 = 5.637
//   N=28: inh=8.787, slow=12.073, std=4.690, fast=3.226, ind=2.117
//         E[m_28] = 0.439 + 1.811 + 2.345 + 0.645 + 0.212 = 5.452
//
// Finding A: E[margin] peaks at N=14, not N=28 — the week-2 visit is the
//            pharmacokinetically optimal monitoring point for the majority
//            population; E[m_14] > E[m_28] by 0.185.
// Finding B: std (w=0.50) drives the peak to N=14 — its margin peaks at N=19
//            and is already descending by N=28; 3.216 → 2.345 between visits.
// Finding C: slow and ind both gain from N=14 to N=28 (late-peaking strata),
//            partially offsetting std/fast/inh decline; net effect = −0.185.
// Finding D: gain N=7→14 = 3.413 (largest single-interval information jump);
//            gain N=14→28 = −0.185 (slight GUM-margin regression).

module pbpk::rapamycin_expected_margin

use pbpk::rapamycin_inh_trajectory::{iht_margin_n7, iht_margin_n14, iht_margin_n28}
use pbpk::rapamycin_slow_adjusted::{sa_margin_n7, sa_margin_n14, sa_margin_n28}
use pbpk::rapamycin_std_trajectory::{stt_margin_n7, stt_margin_n14, stt_margin_n28}
use pbpk::rapamycin_fast_adjusted::{fa_margin_n7, fa_margin_n14, fa_margin_n28}
use pbpk::rapamycin_ind_trajectory::{it_margin_n7, it_margin_n14, it_margin_n28}

// ── Per-stratum weighted contributions ────────────────────────────────────────
pub fn em_inh_contribution_n7()  -> f64 with Mut, Div, Panic { iht_margin_n7()  * 0.05 }
pub fn em_slow_contribution_n7() -> f64 with Mut, Div, Panic { sa_margin_n7()   * 0.15 }
pub fn em_std_contribution_n7()  -> f64 with Mut, Div, Panic { stt_margin_n7()  * 0.50 }
pub fn em_fast_contribution_n7() -> f64 with Mut, Div, Panic { fa_margin_n7()   * 0.20 }
pub fn em_ind_contribution_n7()  -> f64 with Mut, Div, Panic { it_margin_n7()   * 0.10 }

pub fn em_inh_contribution_n14()  -> f64 with Mut, Div, Panic { iht_margin_n14()  * 0.05 }
pub fn em_slow_contribution_n14() -> f64 with Mut, Div, Panic { sa_margin_n14()   * 0.15 }
pub fn em_std_contribution_n14()  -> f64 with Mut, Div, Panic { stt_margin_n14()  * 0.50 }
pub fn em_fast_contribution_n14() -> f64 with Mut, Div, Panic { fa_margin_n14()   * 0.20 }
pub fn em_ind_contribution_n14()  -> f64 with Mut, Div, Panic { it_margin_n14()   * 0.10 }

pub fn em_inh_contribution_n28()  -> f64 with Mut, Div, Panic { iht_margin_n28()  * 0.05 }
pub fn em_slow_contribution_n28() -> f64 with Mut, Div, Panic { sa_margin_n28()   * 0.15 }
pub fn em_std_contribution_n28()  -> f64 with Mut, Div, Panic { stt_margin_n28()  * 0.50 }
pub fn em_fast_contribution_n28() -> f64 with Mut, Div, Panic { fa_margin_n28()   * 0.20 }
pub fn em_ind_contribution_n28()  -> f64 with Mut, Div, Panic { it_margin_n28()   * 0.10 }

// ── Population-weighted expected margin ───────────────────────────────────────
pub fn em_expected_margin_n7() -> f64 with Mut, Div, Panic {
    em_inh_contribution_n7()  + em_slow_contribution_n7()
    + em_std_contribution_n7() + em_fast_contribution_n7()
    + em_ind_contribution_n7()
}

pub fn em_expected_margin_n14() -> f64 with Mut, Div, Panic {
    em_inh_contribution_n14()  + em_slow_contribution_n14()
    + em_std_contribution_n14() + em_fast_contribution_n14()
    + em_ind_contribution_n14()
}

pub fn em_expected_margin_n28() -> f64 with Mut, Div, Panic {
    em_inh_contribution_n28()  + em_slow_contribution_n28()
    + em_std_contribution_n28() + em_fast_contribution_n28()
    + em_ind_contribution_n28()
}

// ── Convergence metrics (Finding D) ───────────────────────────────────────────
pub fn em_gain_n7_to_n14()  -> f64 with Mut, Div, Panic { em_expected_margin_n14() - em_expected_margin_n7()  }
pub fn em_gain_n14_to_n28() -> f64 with Mut, Div, Panic { em_expected_margin_n28() - em_expected_margin_n14() }
pub fn em_gain_n7_to_n28()  -> f64 with Mut, Div, Panic { em_expected_margin_n28() - em_expected_margin_n7()  }
