// stdlib/pbpk/rapamycin_cyp3a5.sio — CYP3A5 genotype-stratified oral rapamycin GUM
//
// Sprint 18 dissertation finding: CYP3A5 pharmacogenomics does NOT change the
// dominant uncertainty source — ka remains dominant for all three genotypes
// (*3/*3 slow, *1/*3 standard, *1/*1 fast expressor). However, the *1/*1
// genotype imposes a structural confidence ceiling of 900 (vs 950 for standard)
// due to low bioavailability (F=0.094), and its second bottleneck is F rather
// than k12.
//
// ── CYP3A5 genotype pharmacokinetics ────────────────────────────────────────────
//
//   *3/*3 non-expressor (slow): ke = 0.00838 h⁻¹ (0.75× std), F = 0.188 (1.33× std)
//   *1/*3 heterozygous (standard): ke = 0.01118 h⁻¹, F = 0.141
//   *1/*1 expressor (fast): ke = 0.01677 h⁻¹ (1.50× std), F = 0.094 (0.67× std)
//
// ── Universal finding: ka dominates all genotypes ────────────────────────────────
//
//   *3/*3: 5mg N=14 → THERAPEUTIC, conf=900, dom=ka
//   *1/*3: 5mg N=14 → THERAPEUTIC, conf=900, dom=ka
//   *1/*1: 5mg N=14 → THERAPEUTIC, conf=820, dom=ka
//
//   CYP3A5 genotype changes ke and F but NOT ka or ka_var — ka remains the
//   largest uncertainty source because D²×Var(ka)×A_gut² accumulates over 14
//   doses regardless of elimination rate.
//
// ── *1/*1 structural confidence penalty ─────────────────────────────────────────
//
//   *1/*1 achieves conf=820 (not 900) at standard 5mg N=14 because the lower
//   F=0.094 reduces trough concentration → wider rel_std. Dose escalation
//   (7, 9, 12mg) gives THERAPEUTIC but conf remains locked at 820 — this is
//   not a measurement problem but a structural property of the genotype.
//
//   ka÷4 rescues *1/*1 from conf=820 → 900, crossing the clinical gate.
//   ke÷4 is irrelevant even for *1/*1 (despite 1.50× ke), confirming the
//   universal principle: ke never governs oral rapamycin uncertainty.
//
// ── Second bottleneck: genotype-dependent ────────────────────────────────────────
//
//   *1/*3 (standard): ka÷16 → conf=950, dom=k12 (as in Sprint 14)
//   *1/*1 (fast):     ka÷16 → conf=900, dom=F  (bioavailability, NOT k12)
//
//   The *1/*1 second bottleneck shifts from k12 to F because low F=0.094
//   amplifies the relative contribution of f_var. The consequence: extreme ka
//   tightening cannot push *1/*1 past conf=900 — only bioavailability
//   measurement improvement can reach conf=950.
//
// ── *3/*3 dose reduction ─────────────────────────────────────────────────────────
//
//   High F=0.188 and slow ke=0.00838 allow *3/*3 to achieve THERAPEUTIC/900
//   at 1.5mg N=14. 1mg is UNCERTAIN (concentration below therapeutic floor,
//   not a measurement problem). Standard 5mg gives THERAPEUTIC/900.
//
//   Clinical implication: *3/*3 patients can use half the standard dose;
//   *1/*1 patients need better ka characterisation, not higher doses.
//
// ── Budget channel indices ────────────────────────────────────────────────────────
//   0 = F (bioavailability)   ← second bottleneck for *1/*1 genotype
//   1 = ka (absorption rate)  ← universally dominant across all genotypes
//   2 = ke (elimination)      ← irrelevant for all genotypes
//   3 = k12 (distribution)    ← second bottleneck for *1/*3 and *3/*3
//   4 = k21 (return rate)     ← minor
//
// Effect annotations:
//   classify_cyp_ss:              with Epistemic, Mut, Div, Panic
//   conf_cyp_ss:                  with Mut, Div, Panic
//   dom_cyp_ss:                   with Mut, Div, Panic
//   classify/conf/dom wrappers:   matching above
//   cyp_ka_universal:             with Epistemic, Mut, Div, Panic
//   cyp_ke_irrelevant_all:        with Epistemic, Mut, Div, Panic
//   cyp_ka4_rescues_fast:         with Mut, Div, Panic
//   cyp_slow/standard/fast_*:     with Mut, Div, Panic or Epistemic as needed

module pbpk::rapamycin_cyp3a5

use epistemic::knowledge::{Epistemic}
use pbpk::rapamycin_clinical::{
    assess_trough, conf_from_rel,
    decision_therapeutic, decision_uncertain
}

fn cyp_sqrt(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { 0.0001 } else {
        var r = x; var i = 0
        while i < 50 { r = (r + x / r) / 2.0; i = i + 1 }
        r
    }
}

fn cyp_argmax5(b0: f64, b1: f64, b2: f64, b3: f64, b4: f64) -> i64 {
    var idx = 0; var dv = b0
    if b1 > dv { idx = 1; dv = b1 }
    if b2 > dv { idx = 2; dv = b2 }
    if b3 > dv { idx = 3; dv = b3 }
    if b4 > dv { idx = 4 }
    idx
}

// ── CYP3A5 genotype constants ──────────────────────────────────────────────────

pub fn cyp_ke_slow()     -> f64 { 0.00838 }   // *3/*3: ke = 0.75× standard
pub fn cyp_f_slow()      -> f64 { 0.188 }     // *3/*3: F  = 1.33× standard
pub fn cyp_ke_standard() -> f64 { 0.01118 }   // *1/*3: standard ke
pub fn cyp_f_standard()  -> f64 { 0.141 }     // *1/*3: standard F
pub fn cyp_ke_fast()     -> f64 { 0.01677 }   // *1/*1: ke = 1.50× standard
pub fn cyp_f_fast()      -> f64 { 0.094 }     // *1/*1: F  = 0.67× standard

// ── Variance constants (same across genotypes — population PK, not CYP3A5-specific) ──

pub fn cyp_ka_var_std()  -> f64 { 0.0225 }
pub fn cyp_ke_var_std()  -> f64 { 0.00000841 }
pub fn cyp_k12_var_std() -> f64 { 0.000156 }
pub fn cyp_k21_var_std() -> f64 { 0.0000016 }
pub fn cyp_f_var_std()   -> f64 { 0.001521 }

// ── classify_cyp_ss ────────────────────────────────────────────────────────────
// Multi-dose oral SS GUM for a given CYP3A5 genotype.
// ke_val and f_val are genotype-specific; all variances are population-level.
// Returns THERAPEUTIC/UNCERTAIN/SUB/TOXIC decision code.

pub fn classify_cyp_ss(
    ke_val: f64, f_val: f64,
    d_oral: f64, n_doses: i64,
    ke_var: f64, k12_var: f64, k21_var: f64,
    ka_var: f64, f_var: f64
) -> i64 with Epistemic, Mut, Div, Panic {
    let k12_val = 0.05;   let k21_val = 0.005
    let vc_val  = 75.0;   let ka_val  = 0.62

    let j11 = 0.0 - (ke_val + k12_val);  let j12 = k21_val
    let j21 = k12_val;                    let j22 = 0.0 - k21_val
    let g11 = 1.0 + 0.5 * j11;           let g12 = 0.5 * j12
    let g21 = 0.5 * j21;                 let g22 = 1.0 + 0.5 * j22
    let g_gut    = 1.0 - 0.5 * ka_val
    let g11sq    = g11 * g11
    let g_gut_sq = g_gut * g_gut

    var a_gut   = d_oral
    var a1      = 0.0;   var a2     = 0.0
    var v_gut_f = d_oral * d_oral * f_var
    var v_gut_ka = 0.0
    var v1      = 0.0;   var v2     = 0.0

    var dose = 0
    while dose < n_doses {
        if dose > 0 {
            a_gut   = a_gut + d_oral
            v_gut_f = v_gut_f + d_oral * d_oral * f_var
        }
        var step = 0
        while step < 48 {
            let flux     = f_val * ka_val * a_gut
            let new_ag   = a_gut + 0.5 * (0.0 - ka_val * a_gut)
            let new_a1   = a1 + 0.5 * (j11 * a1 + j12 * a2 + flux)
            let new_a2   = a2 + 0.5 * (j21 * a1 + j22 * a2)
            let ckg      = 0.25 * ka_var * a_gut * a_gut
            let new_vgf  = g_gut_sq * v_gut_f
            let new_vgka = g_gut_sq * v_gut_ka + ckg
            let v_gut    = v_gut_f + v_gut_ka
            let v1s      = g11sq * v1 + g12 * g12 * v2
            let cke      = 0.25 * ke_var  * a1 * a1
            let ck12     = 0.25 * k12_var * a1 * a1
            let ck21     = 0.25 * k21_var * a2 * a2
            let gv1      = 0.25 * ka_val * ka_val * v_gut
            let new_v1   = v1s + cke + ck12 + ck21 + gv1
            let new_v2   = g21*g21*v1 + g22*g22*v2 + 0.25*(k12_var*a1*a1 + k21_var*a2*a2)
            a_gut = new_ag; a1 = new_a1; a2 = new_a2
            v_gut_f = new_vgf; v_gut_ka = new_vgka
            v1 = new_v1; v2 = new_v2
            step = step + 1
        }
        dose = dose + 1
    }
    let c_t   = a1 / vc_val
    let std_t = cyp_sqrt(v1) / vc_val
    let conf  = conf_from_rel(c_t, std_t)
    let c_ep  = Epistemic::new(c_t, v1 / (vc_val * vc_val), conf)
    assess_trough(&c_ep)
}

// ── conf_cyp_ss ────────────────────────────────────────────────────────────────

pub fn conf_cyp_ss(
    ke_val: f64, f_val: f64,
    d_oral: f64, n_doses: i64,
    ke_var: f64, k12_var: f64, k21_var: f64,
    ka_var: f64, f_var: f64
) -> i64 with Mut, Div, Panic {
    let k12_val = 0.05;   let k21_val = 0.005
    let vc_val  = 75.0;   let ka_val  = 0.62

    let j11 = 0.0 - (ke_val + k12_val);  let j12 = k21_val
    let j21 = k12_val;                    let j22 = 0.0 - k21_val
    let g11 = 1.0 + 0.5 * j11;           let g12 = 0.5 * j12
    let g21 = 0.5 * j21;                 let g22 = 1.0 + 0.5 * j22
    let g_gut    = 1.0 - 0.5 * ka_val
    let g11sq    = g11 * g11
    let g_gut_sq = g_gut * g_gut

    var a_gut   = d_oral
    var a1      = 0.0;   var a2     = 0.0
    var v_gut_f = d_oral * d_oral * f_var
    var v_gut_ka = 0.0
    var v1      = 0.0;   var v2     = 0.0

    var dose = 0
    while dose < n_doses {
        if dose > 0 {
            a_gut   = a_gut + d_oral
            v_gut_f = v_gut_f + d_oral * d_oral * f_var
        }
        var step = 0
        while step < 48 {
            let flux     = f_val * ka_val * a_gut
            let new_ag   = a_gut + 0.5 * (0.0 - ka_val * a_gut)
            let new_a1   = a1 + 0.5 * (j11 * a1 + j12 * a2 + flux)
            let new_a2   = a2 + 0.5 * (j21 * a1 + j22 * a2)
            let ckg      = 0.25 * ka_var * a_gut * a_gut
            let new_vgf  = g_gut_sq * v_gut_f
            let new_vgka = g_gut_sq * v_gut_ka + ckg
            let v_gut    = v_gut_f + v_gut_ka
            let v1s      = g11sq * v1 + g12 * g12 * v2
            let cke      = 0.25 * ke_var  * a1 * a1
            let ck12     = 0.25 * k12_var * a1 * a1
            let ck21     = 0.25 * k21_var * a2 * a2
            let gv1      = 0.25 * ka_val * ka_val * v_gut
            let new_v1   = v1s + cke + ck12 + ck21 + gv1
            let new_v2   = g21*g21*v1 + g22*g22*v2 + 0.25*(k12_var*a1*a1 + k21_var*a2*a2)
            a_gut = new_ag; a1 = new_a1; a2 = new_a2
            v_gut_f = new_vgf; v_gut_ka = new_vgka
            v1 = new_v1; v2 = new_v2
            step = step + 1
        }
        dose = dose + 1
    }
    let c_t   = a1 / vc_val
    let std_t = cyp_sqrt(v1) / vc_val
    conf_from_rel(c_t, std_t)
}

// ── dom_cyp_ss ─────────────────────────────────────────────────────────────────

pub fn dom_cyp_ss(
    ke_val: f64, f_val: f64,
    d_oral: f64, n_doses: i64,
    ke_var: f64, k12_var: f64, k21_var: f64,
    ka_var: f64, f_var: f64
) -> i64 with Mut, Div, Panic {
    let k12_val = 0.05;   let k21_val = 0.005
    let vc_val  = 75.0;   let ka_val  = 0.62

    let j11 = 0.0 - (ke_val + k12_val);  let j12 = k21_val
    let j21 = k12_val;                    let j22 = 0.0 - k21_val
    let g11 = 1.0 + 0.5 * j11;           let g12 = 0.5 * j12
    let g21 = 0.5 * j21;                 let g22 = 1.0 + 0.5 * j22
    let g_gut    = 1.0 - 0.5 * ka_val
    let g11sq    = g11 * g11
    let g_gut_sq = g_gut * g_gut

    var a_gut    = d_oral
    var a1       = 0.0;   var a2      = 0.0
    var v_gut_f  = d_oral * d_oral * f_var
    var v_gut_ka = 0.0
    var v1       = 0.0;   var v2      = 0.0
    var bud_f    = 0.0;   var bud_ka  = 0.0
    var bud_ke   = 0.0;   var bud_k12 = 0.0;  var bud_k21 = 0.0

    var dose = 0
    while dose < n_doses {
        if dose > 0 {
            a_gut   = a_gut + d_oral
            v_gut_f = v_gut_f + d_oral * d_oral * f_var
        }
        var step = 0
        while step < 48 {
            let flux     = f_val * ka_val * a_gut
            let new_ag   = a_gut + 0.5 * (0.0 - ka_val * a_gut)
            let new_a1   = a1 + 0.5 * (j11 * a1 + j12 * a2 + flux)
            let new_a2   = a2 + 0.5 * (j21 * a1 + j22 * a2)
            let ckg      = 0.25 * ka_var * a_gut * a_gut
            let new_vgf  = g_gut_sq * v_gut_f
            let new_vgka = g_gut_sq * v_gut_ka + ckg
            let v_gut    = v_gut_f + v_gut_ka
            let v1s      = g11sq * v1 + g12 * g12 * v2
            let cke      = 0.25 * ke_var  * a1 * a1
            let ck12     = 0.25 * k12_var * a1 * a1
            let ck21     = 0.25 * k21_var * a2 * a2
            let ckac     = 0.25 * ka_var * a_gut * a_gut * f_val * f_val
            let gv1      = 0.25 * ka_val * ka_val * v_gut
            let new_v1   = v1s + cke + ck12 + ck21 + gv1
            let new_v2   = g21*g21*v1 + g22*g22*v2 + 0.25*(k12_var*a1*a1 + k21_var*a2*a2)
            let bfc      = 0.25 * ka_val * ka_val * v_gut_f
            let bkac     = 0.25 * ka_val * ka_val * v_gut_ka + ckac
            a_gut = new_ag; a1 = new_a1; a2 = new_a2
            v_gut_f = new_vgf; v_gut_ka = new_vgka
            v1 = new_v1; v2 = new_v2
            bud_f   = g11sq * bud_f   + bfc
            bud_ka  = g11sq * bud_ka  + bkac
            bud_ke  = g11sq * bud_ke  + cke
            bud_k12 = g11sq * bud_k12 + ck12
            bud_k21 = g11sq * bud_k21 + ck21
            step = step + 1
        }
        dose = dose + 1
    }
    cyp_argmax5(bud_f, bud_ka, bud_ke, bud_k12, bud_k21)
}

// ── Standard wrappers: 5mg N=14, standard variances ────────────────────────────

// *3/*3 non-expressor (slow)
pub fn classify_standard_slow(ka_var: f64) -> i64 with Epistemic, Mut, Div, Panic {
    classify_cyp_ss(cyp_ke_slow(), cyp_f_slow(), 5.0, 14,
                    cyp_ke_var_std(), cyp_k12_var_std(), cyp_k21_var_std(),
                    ka_var, cyp_f_var_std())
}
pub fn conf_standard_slow(ka_var: f64) -> i64 with Mut, Div, Panic {
    conf_cyp_ss(cyp_ke_slow(), cyp_f_slow(), 5.0, 14,
                cyp_ke_var_std(), cyp_k12_var_std(), cyp_k21_var_std(),
                ka_var, cyp_f_var_std())
}
pub fn dom_standard_slow(ka_var: f64) -> i64 with Mut, Div, Panic {
    dom_cyp_ss(cyp_ke_slow(), cyp_f_slow(), 5.0, 14,
               cyp_ke_var_std(), cyp_k12_var_std(), cyp_k21_var_std(),
               ka_var, cyp_f_var_std())
}

// *1/*3 heterozygous (standard)
pub fn classify_standard_hetero(ka_var: f64) -> i64 with Epistemic, Mut, Div, Panic {
    classify_cyp_ss(cyp_ke_standard(), cyp_f_standard(), 5.0, 14,
                    cyp_ke_var_std(), cyp_k12_var_std(), cyp_k21_var_std(),
                    ka_var, cyp_f_var_std())
}
pub fn conf_standard_hetero(ka_var: f64) -> i64 with Mut, Div, Panic {
    conf_cyp_ss(cyp_ke_standard(), cyp_f_standard(), 5.0, 14,
                cyp_ke_var_std(), cyp_k12_var_std(), cyp_k21_var_std(),
                ka_var, cyp_f_var_std())
}
pub fn dom_standard_hetero(ka_var: f64) -> i64 with Mut, Div, Panic {
    dom_cyp_ss(cyp_ke_standard(), cyp_f_standard(), 5.0, 14,
               cyp_ke_var_std(), cyp_k12_var_std(), cyp_k21_var_std(),
               ka_var, cyp_f_var_std())
}

// *1/*1 expressor (fast)
pub fn classify_standard_fast(ka_var: f64) -> i64 with Epistemic, Mut, Div, Panic {
    classify_cyp_ss(cyp_ke_fast(), cyp_f_fast(), 5.0, 14,
                    cyp_ke_var_std(), cyp_k12_var_std(), cyp_k21_var_std(),
                    ka_var, cyp_f_var_std())
}
pub fn conf_standard_fast(ka_var: f64) -> i64 with Mut, Div, Panic {
    conf_cyp_ss(cyp_ke_fast(), cyp_f_fast(), 5.0, 14,
                cyp_ke_var_std(), cyp_k12_var_std(), cyp_k21_var_std(),
                ka_var, cyp_f_var_std())
}
pub fn dom_standard_fast(ka_var: f64) -> i64 with Mut, Div, Panic {
    dom_cyp_ss(cyp_ke_fast(), cyp_f_fast(), 5.0, 14,
               cyp_ke_var_std(), cyp_k12_var_std(), cyp_k21_var_std(),
               ka_var, cyp_f_var_std())
}

// ── Gate summary functions ─────────────────────────────────────────────────────

// ka is the dominant uncertainty source for all three CYP3A5 genotypes
pub fn cyp_ka_universal() -> bool with Epistemic, Mut, Div, Panic {
    let ka = cyp_ka_var_std()
    dom_standard_slow(ka)    == 1 &&
    dom_standard_hetero(ka)  == 1 &&
    dom_standard_fast(ka)    == 1
}

// *3/*3 and *1/*3 achieve conf=900 at 5mg N=14
pub fn cyp_slow_conf_900() -> bool with Mut, Div, Panic {
    conf_standard_slow(cyp_ka_var_std()) == 900
}
pub fn cyp_standard_conf_900() -> bool with Mut, Div, Panic {
    conf_standard_hetero(cyp_ka_var_std()) == 900
}

// *1/*1 is structurally limited to conf=820 at standard ka_var (5mg N=14)
pub fn cyp_fast_conf_820() -> bool with Mut, Div, Panic {
    conf_standard_fast(cyp_ka_var_std()) == 820
}

// Dose escalation cannot rescue *1/*1 confidence — 12mg N=14 still conf=820
pub fn cyp_fast_dose_irrelevant() -> bool with Mut, Div, Panic {
    conf_cyp_ss(cyp_ke_fast(), cyp_f_fast(), 12.0, 14,
                cyp_ke_var_std(), cyp_k12_var_std(), cyp_k21_var_std(),
                cyp_ka_var_std(), cyp_f_var_std()) == 820
}

// ka÷4 rescues *1/*1 from conf=820 → 900 (crosses clinical gate)
pub fn cyp_ka4_rescues_fast() -> bool with Mut, Div, Panic {
    let conf_base = conf_standard_fast(cyp_ka_var_std())
    let conf_ka4  = conf_standard_fast(cyp_ka_var_std() / 4.0)
    conf_base == 820 && conf_ka4 == 900
}

// ke÷4 is irrelevant for all three genotypes — even *1/*1 with 1.50× ke
pub fn cyp_ke_irrelevant_all() -> bool with Epistemic, Mut, Div, Panic {
    let ka    = cyp_ka_var_std()
    let ke    = cyp_ke_var_std()
    let k12   = cyp_k12_var_std()
    let k21   = cyp_k21_var_std()
    let f_var = cyp_f_var_std()
    let c_slow_base = conf_cyp_ss(cyp_ke_slow(),     cyp_f_slow(),     5.0, 14, ke,       k12, k21, ka, f_var)
    let c_slow_kei  = conf_cyp_ss(cyp_ke_slow(),     cyp_f_slow(),     5.0, 14, ke/4.0,   k12, k21, ka, f_var)
    let c_het_base  = conf_cyp_ss(cyp_ke_standard(), cyp_f_standard(), 5.0, 14, ke,       k12, k21, ka, f_var)
    let c_het_kei   = conf_cyp_ss(cyp_ke_standard(), cyp_f_standard(), 5.0, 14, ke/4.0,   k12, k21, ka, f_var)
    let c_fast_base = conf_cyp_ss(cyp_ke_fast(),     cyp_f_fast(),     5.0, 14, ke,       k12, k21, ka, f_var)
    let c_fast_kei  = conf_cyp_ss(cyp_ke_fast(),     cyp_f_fast(),     5.0, 14, ke/4.0,   k12, k21, ka, f_var)
    c_slow_base == c_slow_kei && c_het_base == c_het_kei && c_fast_base == c_fast_kei
}

// *3/*3 can use 1.5mg N=14 and remain THERAPEUTIC/900 (dose reduction safe)
pub fn cyp_slow_dose_halve() -> bool with Epistemic, Mut, Div, Panic {
    let dec  = classify_cyp_ss(cyp_ke_slow(), cyp_f_slow(), 1.5, 14,
                               cyp_ke_var_std(), cyp_k12_var_std(), cyp_k21_var_std(),
                               cyp_ka_var_std(), cyp_f_var_std())
    let conf = conf_cyp_ss(cyp_ke_slow(), cyp_f_slow(), 1.5, 14,
                           cyp_ke_var_std(), cyp_k12_var_std(), cyp_k21_var_std(),
                           cyp_ka_var_std(), cyp_f_var_std())
    dec == decision_therapeutic() && conf == 900
}

// *3/*3 1mg N=14 → UNCERTAIN (concentration below floor, not measurement problem)
pub fn cyp_slow_1mg_uncertain() -> bool with Epistemic, Mut, Div, Panic {
    classify_cyp_ss(cyp_ke_slow(), cyp_f_slow(), 1.0, 14,
                    cyp_ke_var_std(), cyp_k12_var_std(), cyp_k21_var_std(),
                    cyp_ka_var_std(), cyp_f_var_std()) == decision_uncertain()
}

// *1/*1 second bottleneck is F (dom=0), not k12 (dom=3) — at ka÷16
pub fn cyp_fast_second_bottleneck_f() -> bool with Mut, Div, Panic {
    dom_standard_fast(cyp_ka_var_std() / 16.0) == 0
}

// *1/*3 second bottleneck is k12 (dom=3) at ka÷16 — genotype contrast
pub fn cyp_standard_second_bottleneck_k12() -> bool with Mut, Div, Panic {
    dom_standard_hetero(cyp_ka_var_std() / 16.0) == 3
}

// *1/*1 ka÷16 → conf=900 (NOT 950): structural ceiling due to F bottleneck
pub fn cyp_fast_ka16_ceiling() -> bool with Mut, Div, Panic {
    conf_standard_fast(cyp_ka_var_std() / 16.0) == 900
}

// *1/*3 ka÷16 → conf=900 (uniform SS ceiling; 950 requires loading dose, cf. Sprint 15)
pub fn cyp_standard_ka16_conf_900() -> bool with Mut, Div, Panic {
    conf_standard_hetero(cyp_ka_var_std() / 16.0) == 900
}
