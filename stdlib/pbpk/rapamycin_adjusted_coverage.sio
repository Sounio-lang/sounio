// stdlib/pbpk/rapamycin_adjusted_coverage.sio — Sprint 50
//
// Population-weighted GUM coverage fractions under the adjusted protocol:
// slow stratum at GUM-optimal D=2.5mg (Sprint 48/49), all other strata at
// their standard doses. Compared against the Sprint 46 standard protocol.
//
// Standard (Sprint 46):
//   N=7:  cert=0.70, warn=0.10, alarm=0.20
//   N=14: cert=0.70, warn=0.30, alarm=0.00
//   N=28: cert=0.85, warn=0.00, alarm=0.15
//
// Finding A: week-1 trade-off — slow at D=2.5mg is WARN at N=7 (margin=1.419)
//            rather than CERT; cert falls 0.70→0.55, warn rises 0.10→0.25;
//            alarm unchanged at 0.20 (fast still sub-therapeutic at N=7).
// Finding B: week-2 unchanged — slow certifies at N_crit=8 before the N=14
//            visit; adjusted coverage at N=14 is identical to standard.
// Finding C: month-1 fully certified — slow ALARM(-0.15) becomes CERT(+0.15);
//            adjusted N=28: cert=1.00, warn=0.00, alarm=0.00.
// Finding D: asymmetric clinical trade-off — the 0.15pp cert loss at N=7
//            (CERT→WARN, not toxic) is offset by the 0.15pp alarm elimination
//            at N=28 (ALARM→CERT); toxic harm eliminated, minor reassurance
//            cost at the earliest visit only.

module pbpk::rapamycin_adjusted_coverage

use pbpk::rapamycin_monitoring_protocol::{
    mp_std_margin_n7,  mp_std_margin_n14,  mp_std_margin_n28,
    mp_fast_margin_n7, mp_fast_margin_n14, mp_fast_margin_n28,
    mp_inh_margin_n7,  mp_inh_margin_n14,  mp_inh_margin_n28,
    mp_ind_margin_n7,  mp_ind_margin_n14,  mp_ind_margin_n28
}
use pbpk::rapamycin_slow_adjusted::{sa_margin_n7, sa_margin_n14, sa_margin_n28}

fn ac_cert_w(margin: f64, w: f64) -> f64
    with Mut, Div, Panic {
    if margin >= 2.0 { w } else { 0.0 }
}
fn ac_warn_w(margin: f64, w: f64) -> f64
    with Mut, Div, Panic {
    if margin >= 0.0 && margin < 2.0 { w } else { 0.0 }
}
fn ac_alarm_w(margin: f64, w: f64) -> f64
    with Mut, Div, Panic {
    if margin < 0.0 { w } else { 0.0 }
}

// ── N=7 (week 1) — slow at D=2.5mg, others standard ─────────────────────────
pub fn ac_cert_n7() -> f64 with Mut, Div, Panic {
    let a = ac_cert_w(mp_std_margin_n7(),  0.50)
    let b = ac_cert_w(sa_margin_n7(),      0.15)
    let c = ac_cert_w(mp_fast_margin_n7(), 0.20)
    let d = ac_cert_w(mp_inh_margin_n7(),  0.05)
    let e = ac_cert_w(mp_ind_margin_n7(),  0.10)
    a + b + c + d + e
}
pub fn ac_warn_n7() -> f64 with Mut, Div, Panic {
    let a = ac_warn_w(mp_std_margin_n7(),  0.50)
    let b = ac_warn_w(sa_margin_n7(),      0.15)
    let c = ac_warn_w(mp_fast_margin_n7(), 0.20)
    let d = ac_warn_w(mp_inh_margin_n7(),  0.05)
    let e = ac_warn_w(mp_ind_margin_n7(),  0.10)
    a + b + c + d + e
}
pub fn ac_alarm_n7() -> f64 with Mut, Div, Panic {
    let a = ac_alarm_w(mp_std_margin_n7(),  0.50)
    let b = ac_alarm_w(sa_margin_n7(),      0.15)
    let c = ac_alarm_w(mp_fast_margin_n7(), 0.20)
    let d = ac_alarm_w(mp_inh_margin_n7(),  0.05)
    let e = ac_alarm_w(mp_ind_margin_n7(),  0.10)
    a + b + c + d + e
}

// ── N=14 (week 2) — slow at D=2.5mg (N_crit=8 < 14, so CERT), others std ────
pub fn ac_cert_n14() -> f64 with Mut, Div, Panic {
    let a = ac_cert_w(mp_std_margin_n14(),  0.50)
    let b = ac_cert_w(sa_margin_n14(),      0.15)
    let c = ac_cert_w(mp_fast_margin_n14(), 0.20)
    let d = ac_cert_w(mp_inh_margin_n14(),  0.05)
    let e = ac_cert_w(mp_ind_margin_n14(),  0.10)
    a + b + c + d + e
}
pub fn ac_warn_n14() -> f64 with Mut, Div, Panic {
    let a = ac_warn_w(mp_std_margin_n14(),  0.50)
    let b = ac_warn_w(sa_margin_n14(),      0.15)
    let c = ac_warn_w(mp_fast_margin_n14(), 0.20)
    let d = ac_warn_w(mp_inh_margin_n14(),  0.05)
    let e = ac_warn_w(mp_ind_margin_n14(),  0.10)
    a + b + c + d + e
}
pub fn ac_alarm_n14() -> f64 with Mut, Div, Panic {
    let a = ac_alarm_w(mp_std_margin_n14(),  0.50)
    let b = ac_alarm_w(sa_margin_n14(),      0.15)
    let c = ac_alarm_w(mp_fast_margin_n14(), 0.20)
    let d = ac_alarm_w(mp_inh_margin_n14(),  0.05)
    let e = ac_alarm_w(mp_ind_margin_n14(),  0.10)
    a + b + c + d + e
}

// ── N=28 (month 1) — slow at D=2.5mg (margin=12.073, CERT), others std ───────
pub fn ac_cert_n28() -> f64 with Mut, Div, Panic {
    let a = ac_cert_w(mp_std_margin_n28(),  0.50)
    let b = ac_cert_w(sa_margin_n28(),      0.15)
    let c = ac_cert_w(mp_fast_margin_n28(), 0.20)
    let d = ac_cert_w(mp_inh_margin_n28(),  0.05)
    let e = ac_cert_w(mp_ind_margin_n28(),  0.10)
    a + b + c + d + e
}
pub fn ac_warn_n28() -> f64 with Mut, Div, Panic {
    let a = ac_warn_w(mp_std_margin_n28(),  0.50)
    let b = ac_warn_w(sa_margin_n28(),      0.15)
    let c = ac_warn_w(mp_fast_margin_n28(), 0.20)
    let d = ac_warn_w(mp_inh_margin_n28(),  0.05)
    let e = ac_warn_w(mp_ind_margin_n28(),  0.10)
    a + b + c + d + e
}
pub fn ac_alarm_n28() -> f64 with Mut, Div, Panic {
    let a = ac_alarm_w(mp_std_margin_n28(),  0.50)
    let b = ac_alarm_w(sa_margin_n28(),      0.15)
    let c = ac_alarm_w(mp_fast_margin_n28(), 0.20)
    let d = ac_alarm_w(mp_inh_margin_n28(),  0.05)
    let e = ac_alarm_w(mp_ind_margin_n28(),  0.10)
    a + b + c + d + e
}
