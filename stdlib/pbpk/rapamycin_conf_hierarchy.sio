// ── CYP3A4 inducer (D=20mg, N=26) ────────────────────────────────────────────

pub fn ch_ind_n_conf() -> i64 with Mut, Div, Panic {
    let ka = ob_ka_var_std(); let fv = ob_f_var_std()
    let ke = ob_ke_var_std(); let k12 = ob_k12_var_std(); let k21 = ob_k21_var_std()
    let ke_ind = ob_ke_var_ind()
    ch_find_n_conf(20.0, 50, 0.05590, 0.047, ka, fv, ke_ind, k12, k21)
}

// Inducer N_crit at D=20mg: structurally 0 (CI cannot be certified).
pub fn ch_ind_n_crit_d20() -> i64 with Mut, Div, Panic {
    let ka = ob_ka_var_std(); let fv = ob_f_var_std()
    let ke = ob_ke_var_std(); let k12 = ob_k12_var_std(); let k21 = ob_k21_var_std()
    let ke_ind = ob_ke_var_ind()
    ch_find_n_crit(20.0, 50, 0.05590, 0.047, ka, fv, ke_ind, k12, k21)
}

// Inducer D=34mg: N_crit found (CI certifies at higher dose).
pub fn ch_ind_n_crit_d34() -> i64 with Mut, Div, Panic {
    let ka = ob_ka_var_std(); let fv = ob_f_var_std()
    let ke = ob_ke_var_std(); let k12 = ob_k12_var_std(); let k21 = ob_k21_var_std()
