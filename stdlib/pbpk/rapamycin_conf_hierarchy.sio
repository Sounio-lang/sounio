// stdlib/pbpk/rapamycin_conf_hierarchy.sio — Sprint 29: Confidence-N Hierarchy
//
// Novel dissertation contribution: proves that the GUM confidence score is
// necessary but NOT sufficient for CI certification, and quantifies the
// "false confidence window" — the clinically dangerous N range where
// conf ≥ 800 declares THERAPEUTIC but the 95% CI still straddles the floor.
//
// ── Confidence-N Hierarchy Theorem ───────────────────────────────────────────
//
//   For all certifiable strata: N_conf ≤ N_crit
//
//   N_conf: First N where conf score ≥ conf_clinical_min (800).
//           Driven by point-estimate proximity to floor.
//   N_crit: First N where 95% CI is FULLY within [floor, ceil].
//           Driven by GUM variance shrinkage (u_c ∝ 1/√N).
//
//   The false confidence window [N_conf, N_crit − 1] is where
//   the compound epistemic system would declare THERAPEUTIC (conf ≥ 800)
//   yet the CI is not fully certified — the point estimate is in range
//   but the lower bound C − 1.96·u_c still straddles the floor.
//
//   This is a compile-time-detectable clinical gap: the GUM system catches
//   cases where confidence heuristics mislead the clinician.
//
// ── Certified stratum results (probe Sprint 29) ───────────────────────────────
//
//   Standard genotype (ke=0.01118, F=0.141, D=5mg, SS):
//     N_conf=2, N_crit=6, false_window=4
//     At N=2: conf=820 (THERAPEUTIC) but lo=3.18 < floor=4 ng/mL
//
//   Slow genotype (ke=0.00838, F=0.188, D=5mg, SS):
//     N_conf=1, N_crit=3, false_window=2
//     Smallest false window — high C (14.5 ng/mL) means conf certifies fast
//
//   Fast genotype (ke=0.01677, F=0.094, D=5mg, SS):
//     N_conf=5, N_crit=15, false_window=10
//     LARGEST false window of certifiable strata — 10 dose gap
//     Clinically: 10 weeks of false-therapeutic dosing at standard frequency
//
//   CYP3A4 inhibitor (ke=0.002236, F=0.282, D=1.5mg, SS):
//     N_conf=1, N_crit=7, false_window=6
//     High C (8.3 ng/mL) means conf certifies at N=1 but CI is wide
//
//   CYP3A4 inducer (ke=0.05590, F=0.047, D=20mg, N=26):
//     N_conf=26, N_crit=0 (structurally uncertifiable)
//     MOST DANGEROUS: conf reaches 820 at N=26, but CI NEVER certifies
//     at D=20mg regardless of N → point-estimate TDM passes; GUM CI fails
//     Compile-time-detectable: the CI cannot be rescued by more data at this dose
//
// ── Effect annotations ────────────────────────────────────────────────────────
//   ch_find_n_conf, ch_false_window_width: with Mut, Div, Panic
//   All named scenario functions:          with Mut, Div, Panic

module pbpk::rapamycin_conf_hierarchy

use pbpk::rapamycin_clinical::{
    conf_from_rel, trough_floor_mg_l, trough_ceil_mg_l, conf_clinical_min
}
use pbpk::rapamycin_assay::{as_trough_mg_l, as_conf_pred}
use pbpk::rapamycin_expanded_u::{eu_fully_in_range, eu_u_c}
use pbpk::rapamycin_oral_budget::{
    ob_ka_var_std, ob_f_var_std, ob_ke_var_std, ob_k12_var_std, ob_k21_var_std,
    ob_ke_var_inh, ob_ke_var_ind
}

// ── Core search functions ─────────────────────────────────────────────────────

// First N where conf score ≥ conf_clinical_min (800). Returns 0 if not found.
pub fn ch_find_n_conf(d_oral: f64, max_n: i64, ke_val: f64, f_val: f64,
                      ka_var: f64, f_var: f64, ke_var: f64,
                      k12_var: f64, k21_var: f64) -> i64
    with Mut, Div, Panic {
    var n = 1
    var found = 0
    while n <= max_n {
        if found == 0 {
            let c = as_conf_pred(d_oral, n, ke_val, f_val, ka_var, f_var, ke_var, k12_var, k21_var)
            if c >= conf_clinical_min() { found = n }
        };
        n = n + 1
    }
    found
}

// First N where CI is fully within [floor, ceil]. Returns 0 if not found.
pub fn ch_find_n_crit(d_oral: f64, max_n: i64, ke_val: f64, f_val: f64,
                      ka_var: f64, f_var: f64, ke_var: f64,
                      k12_var: f64, k21_var: f64) -> i64
    with Mut, Div, Panic {
    var n = 1
    var found = 0
    while n <= max_n {
        if found == 0 {
            if eu_fully_in_range(d_oral, n, ke_val, f_val, ka_var, f_var, ke_var, k12_var, k21_var) {
                found = n
            }
        };
        n = n + 1
    }
    found
}

// Width of false confidence window: N_crit − N_conf. Returns -1 if N_conf=0.
// Returns N_crit when N_crit=0 (uncertifiable) and N_conf>0: structurally open.
pub fn ch_false_window_width(d_oral: f64, max_n: i64, ke_val: f64, f_val: f64,
                              ka_var: f64, f_var: f64, ke_var: f64,
                              k12_var: f64, k21_var: f64) -> i64
    with Mut, Div, Panic {
    let n_conf = ch_find_n_conf(d_oral, max_n, ke_val, f_val, ka_var, f_var, ke_var, k12_var, k21_var)
    let n_crit = ch_find_n_crit(d_oral, max_n, ke_val, f_val, ka_var, f_var, ke_var, k12_var, k21_var)
    if n_conf == 0 { 0 }
    else if n_crit == 0 { max_n - n_conf + 1 }
    else { n_crit - n_conf }
}

// True iff N_conf < N_crit (confidence certifies strictly before CI).
pub fn ch_conf_before_crit(d_oral: f64, max_n: i64, ke_val: f64, f_val: f64,
                            ka_var: f64, f_var: f64, ke_var: f64,
                            k12_var: f64, k21_var: f64) -> bool
    with Mut, Div, Panic {
    let n_conf = ch_find_n_conf(d_oral, max_n, ke_val, f_val, ka_var, f_var, ke_var, k12_var, k21_var)
    let n_crit = ch_find_n_crit(d_oral, max_n, ke_val, f_val, ka_var, f_var, ke_var, k12_var, k21_var)
    if n_conf == 0 { false }
    else if n_crit == 0 { true }
    else { n_conf < n_crit }
}

// ── Standard genotype (D=5mg, SS) ────────────────────────────────────────────

pub fn ch_std_n_conf() -> i64 with Mut, Div, Panic {
    let ka = ob_ka_var_std(); let fv = ob_f_var_std()
    let ke = ob_ke_var_std(); let k12 = ob_k12_var_std(); let k21 = ob_k21_var_std()
    ch_find_n_conf(5.0, 50, 0.01118, 0.141, ka, fv, ke, k12, k21)
}

pub fn ch_std_n_crit() -> i64 with Mut, Div, Panic {
    let ka = ob_ka_var_std(); let fv = ob_f_var_std()
    let ke = ob_ke_var_std(); let k12 = ob_k12_var_std(); let k21 = ob_k21_var_std()
    ch_find_n_crit(5.0, 50, 0.01118, 0.141, ka, fv, ke, k12, k21)
}

pub fn ch_std_false_window() -> i64 with Mut, Div, Panic {
    let ka = ob_ka_var_std(); let fv = ob_f_var_std()
    let ke = ob_ke_var_std(); let k12 = ob_k12_var_std(); let k21 = ob_k21_var_std()
    ch_false_window_width(5.0, 50, 0.01118, 0.141, ka, fv, ke, k12, k21)
}

