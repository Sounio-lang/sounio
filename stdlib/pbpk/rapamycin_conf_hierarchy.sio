}

// ── Hierarchy theorem checks ──────────────────────────────────────────────────

// For std: N_conf=2 < N_crit=6 (4-dose false window)
pub fn ch_std_hierarchy_holds() -> bool with Mut, Div, Panic {
    ch_std_n_conf() < ch_std_n_crit()
}

// For slow: N_conf=1 < N_crit=3 (2-dose false window)
pub fn ch_slow_hierarchy_holds() -> bool with Mut, Div, Panic {
    ch_slow_n_conf() < ch_slow_n_crit()
}

// For fast: N_conf=5 < N_crit=15 (10-dose false window)
pub fn ch_fast_hierarchy_holds() -> bool with Mut, Div, Panic {
    ch_fast_n_conf() < ch_fast_n_crit()
}

// For inh: N_conf=1 < N_crit=7 (6-dose false window)
pub fn ch_inh_hierarchy_holds() -> bool with Mut, Div, Panic {
    ch_inh_n_conf() < ch_inh_n_crit()
}

// Inducer (D=20mg): N_conf=26 but N_crit=0 — hierarchy holds (N_conf > 0, N_crit = 0)
// False window is structurally infinite at D=20mg.
pub fn ch_ind_conf_certifies_ci_never() -> bool with Mut, Div, Panic {
    ch_ind_n_conf() > 0 && ch_ind_n_crit_d20() == 0
}
