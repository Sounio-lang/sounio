// stdlib/pbpk/rapamycin_sprint44_gate.sio — Sprint 44 certification gate
//
// GUM-certified steady-state profile and safe monitoring gap.
// N_last_cert = last N in [1,60] where both Z_floor≥2.0 and Z_ceil≥2.0.
//
// Finding A: std late-onset toxicity — N_last_cert=36 (gap=30); Z_ceil=2.102 at
//            N=36 drops to 1.826 at N=37; toxic (margin=-2.577) at N=60.
// Finding B: slow shortest window — N_last_cert=18 (gap=15); ceiling drops
//            0.616σ/dose at boundary; margin=-10.005 at N=60.
// Finding C: inh late toxicity despite 1.5mg — N_last_cert=37 (gap=30);
//            Z_ceil=1.9997 at N=38 (misses by <0.001σ); margin=-6.182 at N=60.
// Finding D: fast and ind unbounded — N_last_cert=60; fast floor-limited
//            (margin=8.577); ind floor-limited (margin=2.673, monotone growth).
//
// 56 assertions in sections A–H. All must pass (return 56).

module pbpk::rapamycin_sprint44_gate

use pbpk::rapamycin_steady_state::{
    ss_std_nlast_cert, ss_std_zc_n36, ss_std_zc_n37, ss_std_margin_n60, ss_std_zf_n60,
    ss_slow_nlast_cert, ss_slow_zc_n18, ss_slow_zc_n19, ss_slow_margin_n60, ss_slow_zf_n60,
    ss_fast_nlast_cert, ss_fast_margin_n60, ss_fast_zf_n60, ss_fast_zc_n60,
    ss_inh_nlast_cert, ss_inh_zc_n37, ss_inh_zc_n38, ss_inh_margin_n60, ss_inh_zf_n60,
    ss_ind_nlast_cert, ss_ind_margin_n60, ss_ind_zf_n60, ss_ind_zc_n60
}

pub fn rapamycin_sprint44_gate() -> i64 with Mut, Div, Panic {
    var score = 0

    // ── Section A: N_last_cert classification — three bounded, two unbounded ──
    // std=36, slow=18, inh=37, fast=60, ind=60
    if ss_std_nlast_cert() > 35 && ss_std_nlast_cert() < 37 { score = score + 1 };
    if ss_slow_nlast_cert() > 17 && ss_slow_nlast_cert() < 19 { score = score + 1 };
    if ss_inh_nlast_cert() > 36 && ss_inh_nlast_cert() < 38 { score = score + 1 };
    if ss_fast_nlast_cert() > 59 { score = score + 1 };
    if ss_ind_nlast_cert() > 59 { score = score + 1 };
    // Slow has the shortest window of all five strata
    if ss_slow_nlast_cert() < ss_std_nlast_cert() { score = score + 1 };
    // inh window exceeds std window by exactly 1 dose (both are gap=30)
    if ss_inh_nlast_cert() > ss_std_nlast_cert() { score = score + 1 };

    // ── Section B: FINDING A — std late-onset toxicity ───────────────────────
    // Z_ceil drops from 2.102 (N=36, certified) to 1.826 (N=37, uncertified)
    if ss_std_zc_n36() > 2.0 { score = score + 1 };
    if ss_std_zc_n36() < 2.2 { score = score + 1 };
    if ss_std_zc_n37() > 1.8 { score = score + 1 };
    if ss_std_zc_n37() < 2.0 { score = score + 1 };
    if ss_std_margin_n60() < -2.5 { score = score + 1 };
    // Floor never at risk — Z_floor=15.620 at N=60 while ceiling closes
    if ss_std_zf_n60() > 15.0 { score = score + 1 };
    // Ceiling drops >0.25σ per dose at the window boundary
    if ss_std_zc_n36() - ss_std_zc_n37() > 0.25 { score = score + 1 };

    // ── Section C: FINDING B — slow shortest window ───────────────────────────
    // Z_ceil=2.572 at N=18 (last certified); 1.956 at N=19 (first uncertified)
    if ss_slow_zc_n18() > 2.5 { score = score + 1 };
    if ss_slow_zc_n18() < 2.6 { score = score + 1 };
    if ss_slow_zc_n19() > 1.9 { score = score + 1 };
    if ss_slow_zc_n19() < 2.0 { score = score + 1 };
    if ss_slow_margin_n60() < -9.0 { score = score + 1 };
    // Floor irrelevant — Z_floor=19.380 at N=60
    if ss_slow_zf_n60() > 19.0 { score = score + 1 };
    // Slow more toxic at SS than std (-10 < -2.577)
    if ss_slow_margin_n60() < ss_std_margin_n60() { score = score + 1 };

    // ── Section D: FINDING C — inh late toxicity despite 1.5mg ──────────────
    // Z_ceil=2.559 at N=37 (last certified); 1.9997 at N=38 (misses by <0.001σ)
    if ss_inh_zc_n37() > 2.5 { score = score + 1 };
    if ss_inh_zc_n37() < 2.6 { score = score + 1 };
    if ss_inh_zc_n38() > 1.9 { score = score + 1 };
    if ss_inh_zc_n38() < 2.0 { score = score + 1 };
    if ss_inh_margin_n60() < -6.0 { score = score + 1 };
    // Floor irrelevant — Z_floor=20.824 at N=60 (ke so slow, floor never reached)
    if ss_inh_zf_n60() > 20.0 { score = score + 1 };
    // inh ceiling holds tighter than std at first uncertified N (1.9997 > 1.826)
    if ss_inh_zc_n38() > ss_std_zc_n37() { score = score + 1 };

    // ── Section E: FINDING D — fast unbounded, floor-limited ─────────────────
    // margin=8.577 at N=60; floor-limited (Z_ceil=10.436 always safe)
    if ss_fast_margin_n60() > 8.5 { score = score + 1 };
    if ss_fast_margin_n60() < 9.0 { score = score + 1 };
    if ss_fast_zf_n60() > 8.0 { score = score + 1 };
    if ss_fast_zc_n60() > 10.0 { score = score + 1 };
    // Ceiling farther than floor at SS (floor is the binding constraint)
    if ss_fast_zc_n60() > ss_fast_zf_n60() { score = score + 1 };
    // fast SS margin exceeds 3× std last-certified ceiling margin
    if ss_fast_margin_n60() > ss_std_zc_n36() * 3.0 { score = score + 1 };
    // fast window extends >20 doses beyond std window
    if ss_fast_nlast_cert() > ss_std_nlast_cert() + 20 { score = score + 1 };

    // ── Section F: FINDING E — ind floor-limited monotone growth ─────────────
    // margin=2.673, floor-limited (Z_ceil=5.329 at N=60); ind certified at SS
    if ss_ind_margin_n60() > 2.6 { score = score + 1 };
    if ss_ind_margin_n60() < 2.8 { score = score + 1 };
    if ss_ind_zf_n60() > 2.6 { score = score + 1 };
    if ss_ind_zc_n60() > 5.0 { score = score + 1 };
    // Ceiling at least 2σ farther than floor at SS (floor-limited structure)
    if ss_ind_zc_n60() > ss_ind_zf_n60() + 2.0 { score = score + 1 };
    // ind margin at SS less than fast (floor-limited but far from SS floor)
    if ss_ind_margin_n60() < ss_fast_margin_n60() { score = score + 1 };
    // ind window extends >20 doses beyond std window
    if ss_ind_nlast_cert() > ss_std_nlast_cert() + 20 { score = score + 1 };

    // ── Section G: monitoring gap cross-stratum comparisons ──────────────────
    // gap = N_last_cert − N_crit: std=30, slow=15, inh=30, fast=45, ind=34
    // inh gap (37-7=30) exceeds slow gap (18-3=15)
    if ss_inh_nlast_cert() - 7 > ss_slow_nlast_cert() - 3 { score = score + 1 };
    // std and inh have same gap (30 each); they differ by 1 dose in absolute N_last_cert
    if ss_inh_nlast_cert() - ss_std_nlast_cert() > 0 && ss_inh_nlast_cert() - ss_std_nlast_cert() < 2 { score = score + 1 };
    // fast gap (60-15=45) exceeds ind gap (60-26=34)
    if ss_fast_nlast_cert() - 15 > ss_ind_nlast_cert() - 26 { score = score + 1 };
    // slow gap (15) shorter than ind gap (34)
    if ss_slow_nlast_cert() - 3 < ss_ind_nlast_cert() - 26 { score = score + 1 };
    // std gap (30) exceeds slow gap (15)
    if ss_std_nlast_cert() - 6 > ss_slow_nlast_cert() - 3 { score = score + 1 };
    // At N=60 slow floor Z exceeds |slow margin| (floor never at risk; ceiling kills)
    if ss_slow_zf_n60() > 0.0 - ss_slow_margin_n60() { score = score + 1 };
    // Slow ceiling closes faster per dose than std at their respective boundaries
    if ss_slow_zc_n18() - ss_slow_zc_n19() > ss_std_zc_n36() - ss_std_zc_n37() { score = score + 1 };

    // ── Section H: cross-stratum steady-state toxicity classification ─────────
    // Three strata toxic at N=60 (std, slow, inh); two certified (fast, ind)
    if ss_std_margin_n60() < 0.0 { score = score + 1 };
    if ss_inh_margin_n60() < 0.0 { score = score + 1 };
    if ss_fast_margin_n60() > 2.0 { score = score + 1 };
    if ss_ind_margin_n60() > 2.0 { score = score + 1 };
    // inh more toxic than std at N=60 (-6.18 < -2.58; reduced dose still accumulates)
    if ss_inh_margin_n60() < ss_std_margin_n60() { score = score + 1 };
    // slow most toxic at N=60 (-10.0 < -6.18)
    if ss_slow_margin_n60() < ss_inh_margin_n60() { score = score + 1 };
    // fast margin at SS exceeds ind margin at SS (8.577 > 2.673)
    if ss_fast_margin_n60() > ss_ind_margin_n60() { score = score + 1 };

    score
}
