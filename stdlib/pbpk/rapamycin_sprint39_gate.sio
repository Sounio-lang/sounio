// stdlib/pbpk/rapamycin_sprint39_gate.sio — Sprint 39 certification gate
//
// Certifies therapeutic-window sensitivity: floor dominance, ceiling
// insensitivity, ind floor penalty (+17 doses), slow ceiling collapse at N=14,
// std/fast Z_floor analysis under strict floor specification.
//
// 56 assertions in sections A–H. All must pass (return 56).

module pbpk::rapamycin_sprint39_gate

use pbpk::rapamycin_window_sensitivity::{
    tws_std_ncrit_std, tws_std_ncrit_sf, tws_std_ncrit_cc, tws_std_ncrit_nw,
    tws_slow_ncrit_std, tws_slow_ncrit_sf, tws_slow_ncrit_cc, tws_slow_ncrit_nw,
    tws_fast_ncrit_std, tws_fast_ncrit_sf, tws_fast_ncrit_cc, tws_fast_ncrit_nw,
    tws_inh_ncrit_std, tws_inh_ncrit_sf, tws_inh_ncrit_cc, tws_inh_ncrit_nw,
    tws_ind_ncrit_std, tws_ind_ncrit_sf, tws_ind_ncrit_cc, tws_ind_ncrit_nw,
    tws_slow_zceil_std_n7, tws_slow_zceil_cc_n7,
    tws_slow_zceil_std_n14, tws_slow_zceil_cc_n14,
    tws_slow_zceil_std_n26, tws_slow_zceil_cc_n26,
    tws_std_zfloor_std_n6, tws_std_zfloor_sf_n6,
    tws_std_zfloor_std_n7, tws_std_zfloor_sf_n7,
    tws_fast_zfloor_std_n14, tws_fast_zfloor_sf_n14,
    tws_fast_zfloor_std_n15, tws_fast_zfloor_sf_n15
}

pub fn rapamycin_sprint39_gate() -> i64 with Mut, Div, Panic {
    var score = 0

    // ── Section A: std window N_crit baseline ────────────────────────────────
    // std: 6, slow: 3, fast: 15, inh: 7, ind: 26
    if tws_std_ncrit_std() > 5 && tws_std_ncrit_std() < 7 { score = score + 1 };
    if tws_slow_ncrit_std() > 2 && tws_slow_ncrit_std() < 4 { score = score + 1 };
    if tws_fast_ncrit_std() > 14 && tws_fast_ncrit_std() < 16 { score = score + 1 };
    if tws_inh_ncrit_std() > 6 && tws_inh_ncrit_std() < 8 { score = score + 1 };
    if tws_ind_ncrit_std() > 25 && tws_ind_ncrit_std() < 27 { score = score + 1 };

    // ── Section B: strict-floor N_crit values ────────────────────────────────
    // std: 8, slow: 4, fast: 20, inh: 9, ind: 43 (+17 from std)
    if tws_std_ncrit_sf() > 7 && tws_std_ncrit_sf() < 9 { score = score + 1 };
    if tws_slow_ncrit_sf() > 3 && tws_slow_ncrit_sf() < 5 { score = score + 1 };
    if tws_fast_ncrit_sf() > 19 && tws_fast_ncrit_sf() < 21 { score = score + 1 };
    if tws_inh_ncrit_sf() > 8 && tws_inh_ncrit_sf() < 10 { score = score + 1 };
    if tws_ind_ncrit_sf() > 42 && tws_ind_ncrit_sf() < 44 { score = score + 1 };
    // Strict floor strictly increases N_crit for fast and ind
    if tws_fast_ncrit_sf() > tws_fast_ncrit_std() { score = score + 1 };
    if tws_ind_ncrit_sf() > tws_ind_ncrit_std() { score = score + 1 };

    // ── Section C: FINDING A — ceiling insensitivity (cc ≡ std) ─────────────
    // Conservative ceiling does not tighten N_crit for any stratum
    if tws_std_ncrit_cc() > 5 && tws_std_ncrit_cc() < 7 { score = score + 1 };
    if tws_slow_ncrit_cc() > 2 && tws_slow_ncrit_cc() < 4 { score = score + 1 };
    if tws_fast_ncrit_cc() > 14 && tws_fast_ncrit_cc() < 16 { score = score + 1 };
    if tws_inh_ncrit_cc() > 6 && tws_inh_ncrit_cc() < 8 { score = score + 1 };
    if tws_ind_ncrit_cc() > 25 && tws_ind_ncrit_cc() < 27 { score = score + 1 };
    // cc < sf: ceiling slack; floor is the binding constraint
    if tws_std_ncrit_cc() < tws_std_ncrit_sf() { score = score + 1 };

    // ── Section D: FINDING A — narrow ≡ strict-floor (floor dominates) ───────
    if tws_std_ncrit_nw() > 7 && tws_std_ncrit_nw() < 9 { score = score + 1 };
    if tws_slow_ncrit_nw() > 3 && tws_slow_ncrit_nw() < 5 { score = score + 1 };
    if tws_fast_ncrit_nw() > 19 && tws_fast_ncrit_nw() < 21 { score = score + 1 };
    if tws_inh_ncrit_nw() > 8 && tws_inh_ncrit_nw() < 10 { score = score + 1 };
    if tws_ind_ncrit_nw() > 42 && tws_ind_ncrit_nw() < 44 { score = score + 1 };

    // ── Section E: FINDING C — slow ceiling collapse at N=14 under cc ────────
    // std ceiling: Z_ceil_slow_N14 ≈ 5.315 (safe); cc: ≈ 0.496 (unsafe, below 2σ)
    if tws_slow_zceil_std_n14() > 5.0 && tws_slow_zceil_std_n14() < 5.5 { score = score + 1 };
    if tws_slow_zceil_cc_n14() > 0.0 && tws_slow_zceil_cc_n14() < 1.0 { score = score + 1 };
    if tws_slow_zceil_cc_n14() < 2.0 { score = score + 1 };
    // At N=7 both windows are safe; at N=26 both are toxic (slow accumulates past ceiling)
    if tws_slow_zceil_std_n7() > 10.0 { score = score + 1 };
    if tws_slow_zceil_cc_n7() > 5.0 && tws_slow_zceil_cc_n7() < 6.5 { score = score + 1 };
    if tws_slow_zceil_std_n26() < 0.0 { score = score + 1 };
    if tws_slow_zceil_cc_n26() < tws_slow_zceil_std_n26() { score = score + 1 };

    // ── Section F: FINDING D — std Z_floor at N=6,7 under strict floor ───────
    // N=6: std floor certifies (2.221 ≥ 2.0); strict floor fails (1.044 < 2.0)
    if tws_std_zfloor_std_n6() > 2.0 { score = score + 1 };
    if tws_std_zfloor_sf_n6() < 2.0 { score = score + 1 };
    if tws_std_zfloor_std_n6() - tws_std_zfloor_sf_n6() > 1.0 { score = score + 1 };
    // N=7: std certifies (2.821); strict floor still fails (1.651)
    if tws_std_zfloor_std_n7() > 2.5 && tws_std_zfloor_std_n7() < 3.2 { score = score + 1 };
    if tws_std_zfloor_sf_n7() < 2.0 { score = score + 1 };
    // Monotone: both increase from N=6 to N=7
    if tws_std_zfloor_sf_n7() > tws_std_zfloor_sf_n6() { score = score + 1 };

    // ── Section G: Fast Z_floor at N=14,15 — one-dose threshold ─────────────
    // N=14: std fails (1.844); strict floor far worse (0.502)
    // N=15: std certifies (2.139); strict floor still fails (0.801)
    if tws_fast_zfloor_std_n14() < 2.0 { score = score + 1 };
    if tws_fast_zfloor_std_n15() > 2.0 { score = score + 1 };
    if tws_fast_zfloor_sf_n14() < 1.0 { score = score + 1 };
    if tws_fast_zfloor_sf_n15() < 2.0 { score = score + 1 };
    if tws_fast_zfloor_std_n15() - tws_fast_zfloor_std_n14() > 0.2 { score = score + 1 };
    if tws_fast_zfloor_sf_n15() > tws_fast_zfloor_sf_n14() { score = score + 1 };

    // ── Section H: Cross-stratum findings ────────────────────────────────────
    // Stratum ordering under std window
    if tws_slow_ncrit_std() < tws_std_ncrit_std() { score = score + 1 };
    if tws_fast_ncrit_std() > tws_std_ncrit_std() { score = score + 1 };
    // ind floor penalty is the largest across all strata
    if tws_ind_ncrit_sf() > tws_fast_ncrit_sf() { score = score + 1 };
    if tws_ind_ncrit_sf() - tws_ind_ncrit_std() > 10 { score = score + 1 };
    // Per-stratum floor penalties (sf − std)
    if tws_std_ncrit_sf() - tws_std_ncrit_std() > 1 { score = score + 1 };
    if tws_fast_ncrit_sf() - tws_fast_ncrit_std() > 4 { score = score + 1 };
    if tws_inh_ncrit_sf() - tws_inh_ncrit_std() > 1 { score = score + 1 };
    // Slow ceiling collapse: cc dramatically worsens Z_ceil at N=14
    if tws_slow_zceil_cc_n14() < tws_slow_zceil_std_n14() { score = score + 1 };
    if tws_slow_zceil_std_n7() > tws_slow_zceil_cc_n7() { score = score + 1 };
    if tws_slow_zceil_cc_n26() < tws_slow_zceil_std_n26() { score = score + 1 };
    // Ceiling irrelevant: cc == std for both std and fast strata (floor dominates)
    if tws_std_ncrit_cc() < tws_std_ncrit_sf() { score = score + 1 };
    if tws_fast_ncrit_cc() < tws_fast_ncrit_sf() { score = score + 1 };
    // Ind narrow = 43 > 40
    if tws_ind_ncrit_nw() > 40 { score = score + 1 };
    // Slow floor sensitivity: even fast-converging slow stratum gets penalised
    if tws_slow_ncrit_sf() > tws_slow_ncrit_std() { score = score + 1 };

    score
}
