// stdlib/pbpk/rapamycin_sprint35_gate.sio — Sprint 35 certification gate
//
// Certifies GUM variance budget decomposition: channel shares, ka universal
// dominance, peripheral drift with N, inh k12+k21 regime, ke genotype diagnostic.
//
// 56 assertions in sections A–H. All must pass (return 56).

module pbpk::rapamycin_sprint35_gate

use pbpk::rapamycin_uncertainty_budget::{
    ub_std_ska_n7, ub_std_sF_n7, ub_std_sk12_n7, ub_std_sk21_n7, ub_std_sk12k21_n7,
    ub_std_ska_n14, ub_std_sF_n14, ub_std_ske_n14, ub_std_sk12_n14, ub_std_sk21_n14,
    ub_std_sk12k21_n14,
    ub_std_ska_n26, ub_std_sk12k21_n26,
    ub_slow_ska_n14, ub_slow_ske_n14, ub_slow_sk12k21_n14,
    ub_fast_ska_n14, ub_fast_ske_n14, ub_fast_sk12k21_n14,
    ub_inh_ska_n14, ub_inh_sk12_n14, ub_inh_sk12k21_n14, ub_inh_ske_n14,
    ub_ind_ska_n26, ub_ind_sk12k21_n26, ub_ind_ske_n26
}

pub fn rapamycin_sprint35_gate() -> i64 with Mut, Div, Panic {
    var score = 0

    // ── Section A: std fractional shares at N=14 ──────────────────────────────
    // ka ≈ 73.5%
    if ub_std_ska_n14() > 0.72 && ub_std_ska_n14() < 0.75 { score = score + 1 };
    // F ≈ 9.2%
    if ub_std_sF_n14() > 0.085 && ub_std_sF_n14() < 0.10 { score = score + 1 };
    // ke ≈ 0.58%
    if ub_std_ske_n14() > 0.004 && ub_std_ske_n14() < 0.008 { score = score + 1 };
    // k12 ≈ 10.8%
    if ub_std_sk12_n14() > 0.10 && ub_std_sk12_n14() < 0.12 { score = score + 1 };
    // k21 ≈ 5.9%
    if ub_std_sk21_n14() > 0.05 && ub_std_sk21_n14() < 0.07 { score = score + 1 };
    // Sum-to-unity: ka + F + ke + k12 + k21 = 1
    if ub_std_ska_n14() + ub_std_sF_n14() + ub_std_ske_n14() +
       ub_std_sk12_n14() + ub_std_sk21_n14() > 0.999 &&
       ub_std_ska_n14() + ub_std_sF_n14() + ub_std_ske_n14() +
       ub_std_sk12_n14() + ub_std_sk21_n14() < 1.001 { score = score + 1 };
    // ka is the dominant channel (>all others)
    if ub_std_ska_n14() > ub_std_sF_n14() + ub_std_ske_n14() +
       ub_std_sk12_n14() + ub_std_sk21_n14() { score = score + 1 };

    // ── Section B: FINDING A — ka universal dominance ─────────────────────────
    // ka > 40% in ALL strata (even inh with lowest ka share)
    if ub_inh_ska_n14() > 0.40 { score = score + 1 };
    // ka dominant at N=7 (std): ≈ 81.6%
    if ub_std_ska_n7() > 0.80 && ub_std_ska_n7() < 0.83 { score = score + 1 };
    // fast ka share ≈ 82.3% at N=14
    if ub_fast_ska_n14() > 0.81 && ub_fast_ska_n14() < 0.84 { score = score + 1 };
    // slow ka share ≈ 63.4% at N=14
    if ub_slow_ska_n14() > 0.62 && ub_slow_ska_n14() < 0.65 { score = score + 1 };
    // ind ka share ≈ 86.3% at N=26 (maximum ka dominance)
    if ub_ind_ska_n26() > 0.85 && ub_ind_ska_n26() < 0.88 { score = score + 1 };
    // Ordering: fast > std > slow > inh (ka share inversely tracks elimination rate)
    if ub_fast_ska_n14() > ub_std_ska_n14() { score = score + 1 };
    if ub_std_ska_n14()  > ub_slow_ska_n14() { score = score + 1 };
    if ub_slow_ska_n14() > ub_inh_ska_n14() { score = score + 1 };

    // ── Section C: FINDING B — ka share decreases with N (std) ───────────────
    // N=7: 81.6% > N=14: 73.5% > N=26: 60.2%
    if ub_std_ska_n7() > ub_std_ska_n14() { score = score + 1 };
    if ub_std_ska_n14() > ub_std_ska_n26() { score = score + 1 };
    // ka share N=7 vs N=26 drops by > 15 percentage points
    if ub_std_ska_n7() - ub_std_ska_n26() > 0.18 { score = score + 1 };
    // std N=26 ka share ≈ 60.2%
    if ub_std_ska_n26() > 0.59 && ub_std_ska_n26() < 0.62 { score = score + 1 };

    // ── Section D: FINDING B — k12+k21 share increases with N (std) ──────────
    // N=7: 7.8% < N=14: 16.7% < N=26: 31.3%
    if ub_std_sk12k21_n7() < ub_std_sk12k21_n14() { score = score + 1 };
    if ub_std_sk12k21_n14() < ub_std_sk12k21_n26() { score = score + 1 };
    // N=7 peripheral share ≈ 7.8%
    if ub_std_sk12k21_n7() > 0.07 && ub_std_sk12k21_n7() < 0.09 { score = score + 1 };
    // N=14 peripheral share ≈ 16.7%
    if ub_std_sk12k21_n14() > 0.15 && ub_std_sk12k21_n14() < 0.18 { score = score + 1 };
    // N=26 peripheral share ≈ 31.3%
    if ub_std_sk12k21_n26() > 0.30 && ub_std_sk12k21_n26() < 0.33 { score = score + 1 };
    // Peripheral share N=26 > 4× peripheral share N=7 (exponential drift)
    if ub_std_sk12k21_n26() > 4.0 * ub_std_sk12k21_n7() { score = score + 1 };

    // ── Section E: FINDING C — inh k12+k21 regime ────────────────────────────
    // inh k12+k21 ≈ 51.6% — majority of variance from peripheral transfer
    if ub_inh_sk12k21_n14() > 0.50 && ub_inh_sk12k21_n14() < 0.53 { score = score + 1 };
    // inh k12 alone ≈ 35.3% — largest single non-ka channel across all strata
    if ub_inh_sk12_n14() > 0.34 && ub_inh_sk12_n14() < 0.37 { score = score + 1 };
    // inh k12+k21 > ka share (unique: peripheral > absorption)
    if ub_inh_sk12k21_n14() > ub_inh_ska_n14() { score = score + 1 };
    // inh k12+k21 >> std k12+k21 (×3 difference)
    if ub_inh_sk12k21_n14() > 3.0 * ub_std_sk12k21_n14() { score = score + 1 };
    // inh k12+k21 >> fast k12+k21 (fastest elimination → least peripheral variance)
    if ub_inh_sk12k21_n14() > ub_fast_sk12k21_n14() { score = score + 1 };

    // ── Section F: FINDING D — ke share diagnostic for genotype ──────────────
    // ske ordering: fast < std < slow (same ke_var, different sensitivity)
    if ub_fast_ske_n14() < ub_std_ske_n14() { score = score + 1 };
    if ub_std_ske_n14()  < ub_slow_ske_n14() { score = score + 1 };
    // fast ke share ≈ 0.25% (very small — fast elimination means SS is lower)
    if ub_fast_ske_n14() > 0.001 && ub_fast_ske_n14() < 0.004 { score = score + 1 };
    // slow ke share ≈ 0.98% (almost 4× fast)
    if ub_slow_ske_n14() > 0.008 && ub_slow_ske_n14() < 0.013 { score = score + 1 };
    // inh ke share < 0.1% (ke_inh is extremely small → ke_var tiny)
    if ub_inh_ske_n14() < 0.001 { score = score + 1 };
    // ind ke share ≈ 1.3% at N=26 (largest ke, ke_var biggest)
    if ub_ind_ske_n26() > 0.01 && ub_ind_ske_n26() < 0.02 { score = score + 1 };

    // ── Section G: ind extreme ka dominance ──────────────────────────────────
    // ind D34 N=26: ka ≈ 86.3% — maximum across all strata
    if ub_ind_ska_n26() > ub_fast_ska_n14() { score = score + 1 };
    if ub_ind_ska_n26() > ub_std_ska_n7() { score = score + 1 };
    // ind k12+k21 ≈ 2.6% — minimum peripheral share (fast clearance leaves no peripheral drift)
    if ub_ind_sk12k21_n26() > 0.02 && ub_ind_sk12k21_n26() < 0.04 { score = score + 1 };
    // Contrast: ind k12+k21 is smallest; inh k12+k21 is largest
    if ub_ind_sk12k21_n26() < ub_inh_sk12k21_n14() { score = score + 1 };
    // Inducer ka share × 2 > (all other channels combined) × 2
    if ub_ind_ska_n26() > 0.75 { score = score + 1 };

    // ── Section H: Structural properties and cross-stratum ordering ───────────
    // ka always > F (absorption variability > bioavailability variability)
    if ub_std_ska_n14() > ub_std_sF_n14() { score = score + 1 };
    if ub_inh_ska_n14() > ub_inh_ske_n14() { score = score + 1 };
    // F share is similar across std/fast (same dose, similar F variance structure)
    if ub_std_sF_n14() > 0.085 && ub_fast_ska_n14() > 0.80 { score = score + 1 };
    // ka share at N=7 > ka share at N=26 for std (monotone)
    if ub_std_ska_n7() > ub_std_ska_n26() { score = score + 1 };
    // ke channel is never dominant (all shares < 2%)
    if ub_std_ske_n14() < 0.02 && ub_slow_ske_n14() < 0.02 &&
       ub_fast_ske_n14() < 0.02 { score = score + 1 };
    // k21 share is always less than k12 share (more variance enters than returns)
    if ub_std_sk12_n14() > ub_std_sk21_n14() { score = score + 1 };
    // inh ska bound: below 45%
    if ub_inh_ska_n14() < 0.45 { score = score + 1 };
    // For std and fast: ka > k12+k21 (ka dominates peripheral combined)
    if ub_std_ska_n14() > ub_std_sk12k21_n14() { score = score + 1 };
    if ub_fast_ska_n14() > ub_fast_sk12k21_n14() { score = score + 1 };
    // inh is unique: k12+k21 > ka (only stratum where peripheral > absorption)
    if ub_inh_sk12k21_n14() > ub_inh_ska_n14() { score = score + 1 };
    // inh_ske < fast_ske (inh ke_var is orders of magnitude smaller)
    if ub_inh_ske_n14() < ub_fast_ske_n14() { score = score + 1 };
    // inh k12 alone > std k12+k21 combined (peripheral dominance of inh)
    if ub_inh_sk12_n14() > ub_std_sk12k21_n14() { score = score + 1 };
    // ind sk12k21 < std sk12k21 (fastest ke → least peripheral drift)
    if ub_ind_sk12k21_n26() < ub_std_sk12k21_n14() { score = score + 1 };
    // std ska N=26 still > 50% even as peripheral channels grow
    if ub_std_ska_n26() > 0.50 { score = score + 1 };
    // inh k12+k21 > slow k12+k21 (slowest ke still less peripheral drift than inh)
    if ub_inh_sk12k21_n14() > ub_slow_sk12k21_n14() { score = score + 1 };

    score
}
