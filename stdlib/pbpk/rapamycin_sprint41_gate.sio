// stdlib/pbpk/rapamycin_sprint41_gate.sio — Sprint 41 certification gate
//
// Certifies phenotype-naive fixed-dose protocol audit: inh certify-then-toxify
// (certifies N=1, toxic N=9), ind chronic sub-therapeutic (Z_floor=-9.67 at
// N=26, never certifies), slow delayed toxicity (N_tox=23), fast/std safe.
//
// 56 assertions in sections A–H. All must pass (return 56).

module pbpk::rapamycin_sprint41_gate

use pbpk::rapamycin_phenotype_audit::{
    pa_inh_correct_ncrit, pa_ind_correct_ncrit,
    pa_std5_ncrit, pa_std5_ntox,
    pa_slow5_ncrit, pa_slow5_ntox, pa_slow5_zceil_n14, pa_slow5_zceil_n21,
    pa_fast5_ncrit, pa_fast5_ntox,
    pa_inh5_ncrit, pa_inh5_nlast_cert, pa_inh5_ntox, pa_inh5_cert_window,
    pa_inh5_zceil_n7, pa_inh5_zceil_n8, pa_inh5_zceil_n9,
    pa_ind5_ncrit, pa_ind5_ntox, pa_ind5_zfloor_n26, pa_ind5_zfloor_n60,
    pa_ind5_trough_n26
}

pub fn rapamycin_sprint41_gate() -> i64 with Mut, Div, Panic {
    var score = 0

    // ── Section A: correct-dose N_crit baselines ──────────────────────────────
    // std=6, slow=3, fast=15, inh(1.5mg)=7, ind(34mg)=26
    if pa_std5_ncrit() > 5 && pa_std5_ncrit() < 7 { score = score + 1 };
    if pa_slow5_ncrit() > 2 && pa_slow5_ncrit() < 4 { score = score + 1 };
    if pa_fast5_ncrit() > 14 && pa_fast5_ncrit() < 16 { score = score + 1 };
    if pa_inh_correct_ncrit() > 6 && pa_inh_correct_ncrit() < 8 { score = score + 1 };
    if pa_ind_correct_ncrit() > 25 && pa_ind_correct_ncrit() < 27 { score = score + 1 };
    if pa_std5_ncrit() < pa_fast5_ncrit() { score = score + 1 };
    if pa_inh_correct_ncrit() > pa_slow5_ncrit() { score = score + 1 };

    // ── Section B: FINDING A — inh certify-then-toxify at D=5mg ─────────────
    // Certifies at N=1, last certified N=7, overtly toxic at N=9
    if pa_inh5_ncrit() > 0 && pa_inh5_ncrit() < 2 { score = score + 1 };
    if pa_inh5_nlast_cert() > 6 && pa_inh5_nlast_cert() < 8 { score = score + 1 };
    if pa_inh5_ntox() > 8 && pa_inh5_ntox() < 10 { score = score + 1 };
    // Paradox: wrong dose certifies faster than correct-dose protocol
    if pa_inh5_ncrit() < pa_inh_correct_ncrit() { score = score + 1 };
    // Toxicity follows last-certified by 2 doses
    if pa_inh5_ntox() > pa_inh5_nlast_cert() { score = score + 1 };
    // Certification window spans 7 doses (N=1 through N=7)
    if pa_inh5_cert_window() > 6 { score = score + 1 };
    // Window closes before fast metabolizer even certifies
    if pa_inh5_nlast_cert() < pa_fast5_ncrit() { score = score + 1 };

    // ── Section C: inh Z_ceil trace — ceiling approach and breach ────────────
    // N=7: Z_ceil=2.303 (just certified); N=8: 1.011 (fails); N=9: -0.211 (toxic)
    if pa_inh5_zceil_n7() > 2.2 && pa_inh5_zceil_n7() < 2.5 { score = score + 1 };
    if pa_inh5_zceil_n8() > 0.5 && pa_inh5_zceil_n8() < 1.5 { score = score + 1 };
    if pa_inh5_zceil_n9() < 0.0 { score = score + 1 };
    if pa_inh5_zceil_n7() > pa_inh5_zceil_n8() { score = score + 1 };
    if pa_inh5_zceil_n8() > pa_inh5_zceil_n9() { score = score + 1 };
    // Gap between last certified and first toxic = 2 doses (N=8 is uncertified but not toxic)
    if pa_inh5_ntox() - pa_inh5_nlast_cert() > 1 { score = score + 1 };
    // Z_ceil at N=8 drops to less than half of Z_ceil at N=7
    if pa_inh5_zceil_n8() < pa_inh5_zceil_n7() / 2.0 { score = score + 1 };

    // ── Section D: FINDING B — ind at D=5mg chronically sub-therapeutic ──────
    // Never certifies (N_crit=0), never toxic (N_tox=0), Z_floor=-9.67 at N=26
    if pa_ind5_ncrit() < 1 { score = score + 1 };
    if pa_ind5_zfloor_n26() < -9.0 { score = score + 1 };
    if pa_ind5_zfloor_n60() < -8.5 { score = score + 1 };
    if pa_ind5_trough_n26() < 0.002 { score = score + 1 };
    if pa_ind5_trough_n26() > 0.001 { score = score + 1 };
    // Z_floor at N=60 less negative than N=26: trough still slowly accumulating
    if pa_ind5_zfloor_n60() > pa_ind5_zfloor_n26() { score = score + 1 };
    // ind at 5mg: sub-therapeutic AND non-toxic (no ceiling breach ever)
    if pa_ind5_ntox() < 1 { score = score + 1 };

    // ── Section E: FINDING C — slow delayed toxicity ──────────────────────────
    // Certifies at N=3, toxic at N=23; Z_ceil=5.315 at N=14, 0.801 at N=21
    if pa_slow5_ntox() > 22 && pa_slow5_ntox() < 24 { score = score + 1 };
    if pa_std5_ntox() > 44 && pa_std5_ntox() < 46 { score = score + 1 };
    if pa_slow5_zceil_n14() > 5.0 { score = score + 1 };
    // At N=21: uncertifiable (Z_ceil<2) but not yet overtly toxic (C < ceiling)
    if pa_slow5_zceil_n21() > 0.0 && pa_slow5_zceil_n21() < 2.0 { score = score + 1 };
    if pa_slow5_ntox() > pa_slow5_ncrit() { score = score + 1 };
    if pa_std5_ntox() > pa_slow5_ntox() { score = score + 1 };
    // fast never toxic; slow becomes toxic
    if pa_fast5_ntox() < pa_slow5_ntox() { score = score + 1 };

    // ── Section F: FINDING D — std and fast safe behaviors ───────────────────
    if pa_std5_ntox() > pa_std5_ncrit() { score = score + 1 };
    if pa_std5_ntox() > 30 { score = score + 1 };
    // fast certifies before slow becomes toxic
    if pa_fast5_ncrit() < pa_slow5_ntox() { score = score + 1 };
    if pa_fast5_ntox() < 1 { score = score + 1 };
    // inh at D=5mg becomes toxic much sooner than slow
    if pa_inh5_ntox() < pa_slow5_ntox() { score = score + 1 };
    // inh becomes toxic before fast even certifies
    if pa_inh5_ntox() < pa_fast5_ncrit() { score = score + 1 };
    // Slow ceiling is still safe at N=14 (monitoring point), then collapses
    if pa_slow5_zceil_n14() > pa_slow5_zceil_n21() { score = score + 1 };

    // ── Section G: cross-finding comparisons ─────────────────────────────────
    // Wrong dose certifies earlier than correct standard
    if pa_inh5_ncrit() < pa_std5_ncrit() { score = score + 1 };
    // inh at D=5mg toxic before ind on correct dose even certifies
    if pa_inh5_ntox() < pa_ind_correct_ncrit() { score = score + 1 };
    // Slow certification-to-toxicity span: 23-3 = 20 doses
    if pa_slow5_ntox() - pa_slow5_ncrit() > 15 { score = score + 1 };
    // inh certification-to-toxicity span: 9-1 = 8 doses (very narrow)
    if pa_inh5_ntox() - pa_inh5_ncrit() > 7 { score = score + 1 };
    // std certification-to-toxicity span: 45-6 = 39 doses (very wide)
    if pa_std5_ntox() - pa_std5_ncrit() > 35 { score = score + 1 };
    // ind at 5mg: trough still accumulating slowly (less negative at N=60 vs N=26)
    if pa_ind5_zfloor_n60() > pa_ind5_zfloor_n26() { score = score + 1 };
    // inh nlast_cert < ind_correct_ncrit: window closes before ind certifies
    if pa_inh5_nlast_cert() < pa_ind_correct_ncrit() { score = score + 1 };

    // ── Section H: clinical implications ─────────────────────────────────────
    // inh Z_ceil drops sharply: N=7→8 drop exceeds 1.0σ
    if pa_inh5_zceil_n7() - pa_inh5_zceil_n8() > 1.0 { score = score + 1 };
    // N=8→9 drop also exceeds 1.0σ
    if pa_inh5_zceil_n8() - pa_inh5_zceil_n9() > 1.0 { score = score + 1 };
    // Slow ceiling: N=14→21 drop exceeds 4.0σ (rapid approach)
    if pa_slow5_zceil_n14() - pa_slow5_zceil_n21() > 4.0 { score = score + 1 };
    // fast requires more doses than inh correct (15 > 7)
    if pa_fast5_ncrit() > pa_inh_correct_ncrit() { score = score + 1 };
    // ind at D=5mg trough is below floor (0.001177 < 0.004 mg/L)
    if pa_ind5_trough_n26() < 0.004 { score = score + 1 };
    // inh cert window (7 doses) much smaller than std safe span (39 doses)
    if pa_inh5_cert_window() < pa_std5_ntox() - pa_std5_ncrit() { score = score + 1 };
    // inh last certified N < ind correct N_crit
    if pa_inh5_nlast_cert() < pa_ind_correct_ncrit() { score = score + 1 };

    score
}
