// stdlib/pbpk/rapamycin_sprint57_gate.sio — Sprint 57 certification gate
//
// Standard stratum (ke=0.01118 h⁻¹, F=0.141, D=5mg, w=0.50) trajectory.
// Fifth and final trajectory analysis; majority stratum (50% of population).
//
// Key trajectory values:
//   N=1:  -1.751 ALARM   N=3:  +0.272 WARN   N=5:  +1.600 WARN
//   N=7:  +2.821 CERT    N=14: +6.432 CERT    N=19: +8.442 CERT (peak)
//   N=21: +7.622 CERT    N=28: +4.689 CERT    N=42: +0.575 WARN
//   N=56: -2.019 ALARM   N=84: -4.864 ALARM
//   n_crit=6, n_last_cert=36, n_peak=19, margin_peak=8.442, cert_span=30
//   ncrit_lead=5, peak_lag=13, margin_gain_n7_to_n28=1.869
//
// Five-stratum atlas (by ke, at protocol doses):
//   Inh  ke=0.002236: n_crit=7,  n_last=37,   n_peak=22,  peak=14.147, span=30
//   Slow ke=0.00838:  n_crit=8,  n_last=58,   n_peak=29,  peak=12.354, span=50
//   Std  ke=0.01118:  n_crit=6,  n_last=36,   n_peak=19,  peak=8.442,  span=30
//   Fast ke=0.01677:  n_crit=7,  n_last=34,   n_peak=18,  peak=5.469,  span=27
//   Ind  ke=0.05590:  n_crit=26, n_last=120+, n_peak=120+,peak=2.78+,  span=94+
//
// Finding A: n_crit=6 — std certifies one day before the week-1 visit;
//            earliest n_crit of the ceiling-limited strata (inh/slow/std/fast).
// Finding B: peak at N=19, margin=8.442 — between slow (12.354) and fast (5.469);
//            the std stratum is the pharmacokinetic median.
// Finding C: cert_span=30 days — same as inh, shorter than slow (50); the
//            ceiling binds at N=37 as the moderate ke leads to moderate accumulation.
// Finding D: all three standard monitoring visits certify with comfortable margin;
//            margin_gain N=7→N=28=1.869 (accumulation + GUM precision combined).
//
// 56 assertions in sections A–H. All must pass (return 56).

module pbpk::rapamycin_sprint57_gate

use pbpk::rapamycin_std_trajectory::{
    stt_margin_n1,  stt_margin_n3,  stt_margin_n5,
    stt_margin_n7,  stt_margin_n14, stt_margin_n21,
    stt_margin_n28, stt_margin_n42, stt_margin_n56,
    stt_margin_n84,
    stt_n_crit,     stt_n_last_cert, stt_n_peak,
    stt_margin_peak, stt_ncrit_lead,
    stt_cert_span,  stt_peak_lag,
    stt_margin_gain_n7_to_n28
}

pub fn rapamycin_sprint57_gate() -> i64 with Mut, Div, Panic {
    var score = 0

    // ── Section A: early ALARM → WARN transition (N=1..5) ────────────────────
    if stt_margin_n1() < 0.0 { score = score + 1 };
    if stt_margin_n1() > -2.0 { score = score + 1 };
    if stt_margin_n3() > 0.0 { score = score + 1 };
    if stt_margin_n3() < 2.0 { score = score + 1 };
    if stt_margin_n5() > 1.5 { score = score + 1 };
    if stt_margin_n5() < 2.0 { score = score + 1 };
    if stt_margin_n5() > stt_margin_n3() { score = score + 1 };

    // ── Section B: n_crit=6 — certifies before week-1 visit (Finding A) ──────
    if stt_n_crit() > 5 { score = score + 1 };
    if stt_n_crit() < 7 { score = score + 1 };
    if stt_ncrit_lead() > 4 { score = score + 1 };
    if stt_ncrit_lead() < 6 { score = score + 1 };
    if stt_margin_n7() >= 2.0 { score = score + 1 };
    if stt_margin_n7() > 2.8 { score = score + 1 };
    if stt_margin_n7() < 3.0 { score = score + 1 };

    // ── Section C: peak at N=19, margin=8.442 (Finding B) ────────────────────
    if stt_n_peak() > 18 { score = score + 1 };
    if stt_n_peak() < 20 { score = score + 1 };
    if stt_margin_peak() > 8.4 { score = score + 1 };
    if stt_margin_peak() < 8.5 { score = score + 1 };
    if stt_margin_n14() > 6.4 { score = score + 1 };
    if stt_margin_n14() < 6.5 { score = score + 1 };
    if stt_peak_lag() > 12 { score = score + 1 };

    // ── Section D: ceiling binding — last cert N=36, ALARM by N=56 (Finding C) ─
    if stt_n_last_cert() > 35 { score = score + 1 };
    if stt_n_last_cert() < 37 { score = score + 1 };
    if stt_cert_span() > 29 { score = score + 1 };
    if stt_cert_span() < 31 { score = score + 1 };
    if stt_margin_n42() > 0.0 { score = score + 1 };
    if stt_margin_n42() < 2.0 { score = score + 1 };
    if stt_margin_n56() < 0.0 { score = score + 1 };

    // ── Section E: unimodal trajectory — rise then monotone fall ─────────────
    if stt_margin_n7()  > stt_margin_n5()  { score = score + 1 };
    if stt_margin_n14() > stt_margin_n7()  { score = score + 1 };
    if stt_margin_n21() > stt_margin_n14() { score = score + 1 };
    if stt_margin_n28() < stt_margin_n21() { score = score + 1 };
    if stt_margin_n42() < stt_margin_n28() { score = score + 1 };
    if stt_margin_n56() < stt_margin_n42() { score = score + 1 };
    if stt_margin_n84() < stt_margin_n56() { score = score + 1 };

    // ── Section F: standard monitoring visit profile (Finding D) ─────────────
    if stt_margin_n7()  >= 2.0 { score = score + 1 };
    if stt_margin_n14() >= 2.0 { score = score + 1 };
    if stt_margin_n28() >= 2.0 { score = score + 1 };
    if stt_margin_n28() > 4.6 { score = score + 1 };
    if stt_margin_n28() < 4.8 { score = score + 1 };
    if stt_margin_n21() > 7.6 { score = score + 1 };
    if stt_margin_gain_n7_to_n28() > 1.8 { score = score + 1 };

    // ── Section G: atlas position — std is the pharmacokinetic median ─────────
    if stt_n_crit() < 7 { score = score + 1 };
    if stt_n_peak() > 18 { score = score + 1 };
    if stt_n_peak() < 29 { score = score + 1 };
    if stt_margin_peak() > 5.469 { score = score + 1 };
    if stt_margin_peak() < 12.354 { score = score + 1 };
    if stt_cert_span() > 27 { score = score + 1 };
    if stt_cert_span() < 50 { score = score + 1 };

    // ── Section H: policy — certifies before week-1; all visits safe; ceiling ─
    if stt_n_crit() < 7 { score = score + 1 };
    if stt_margin_n7()  >= 2.0 { score = score + 1 };
    if stt_margin_n14() >= 2.0 { score = score + 1 };
    if stt_margin_n28() >= 2.0 { score = score + 1 };
    if stt_n_last_cert() < 42 { score = score + 1 };
    if stt_margin_n42() > 0.0 { score = score + 1 };
    if stt_margin_n56() < 0.0 { score = score + 1 };

    score
}
