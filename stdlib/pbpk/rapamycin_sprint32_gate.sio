// stdlib/pbpk/rapamycin_sprint32_gate.sio — Sprint 32 certification gate
//
// Certifies the Protocol Checkpoint Safety Matrix: all (stratum × checkpoint)
// cells across N=7, N=14, N=26, with four key safety findings.
//
// 56 assertions in sections A–H. All must pass (return 56).

module pbpk::rapamycin_sprint32_gate

use pbpk::rapamycin_checkpoint::{
    cp_certified, cp_expanded_u, cp_c_above_ceil, cp_u_grows,
    cp_std_cert_n7,  cp_std_cert_n14,  cp_std_cert_n26,
    cp_slow_cert_n7, cp_slow_cert_n14, cp_slow_cert_n26, cp_slow_toxic_n26,
    cp_fast_cert_n7, cp_fast_cert_n14, cp_fast_cert_n15, cp_fast_cert_n26,
    cp_inh_cert_n7,  cp_inh_cert_n14,  cp_inh_cert_n26,
    cp_ind_d20_cert_n7, cp_ind_d20_cert_n14, cp_ind_d20_cert_n26,
    cp_ind_d34_cert_n14, cp_ind_d34_cert_n26,
    cp_std_u_n7, cp_std_u_n14, cp_std_u_n26,
    cp_inh_u_n7, cp_inh_u_n26,
    cp_fast_u_n14, cp_ind_d20_u_n26
}
use pbpk::rapamycin_oral_budget::{
    ob_ka_var_std, ob_f_var_std, ob_ke_var_std, ob_k12_var_std, ob_k21_var_std,
    ob_ke_var_inh, ob_ke_var_ind
}

pub fn rapamycin_sprint32_gate() -> i64 with Mut, Div, Panic {
    var score = 0

    // ── Section A: N=7 checkpoint — first-week review ────────────────────────
    // Standard: certified (N_crit=6 < 7)
    if cp_std_cert_n7()  { score = score + 1 };
    // Slow: certified (N_crit=3 < 7)
    if cp_slow_cert_n7() { score = score + 1 };
    // Fast: NOT certified (N_crit=15 > 7) — Finding A
    if !cp_fast_cert_n7() { score = score + 1 };
    // Inhibitor: certified EXACTLY at N=7 (N_crit=7) — Finding C
    if cp_inh_cert_n7()  { score = score + 1 };
    // Inducer D=20mg: NOT certified
    if !cp_ind_d20_cert_n7() { score = score + 1 };
    // Inducer D=34mg: NOT certified (N_crit=26 > 7)
    let ka = ob_ka_var_std(); let fv = ob_f_var_std()
    let ke = ob_ke_var_std(); let k12 = ob_k12_var_std(); let k21 = ob_k21_var_std()
    let ke_ind = ob_ke_var_ind()
    if !cp_certified(34.0, 7, 0.05590, 0.047, ka, fv, ke_ind, k12, k21) { score = score + 1 };

    // ── Section B: N=14 checkpoint — standard SS assessment ──────────────────
    // Standard: certified
    if cp_std_cert_n14()  { score = score + 1 };
    // Slow: certified
    if cp_slow_cert_n14() { score = score + 1 };
    // Fast: NOT certified — Finding A (ONE dose short: N_crit=15, protocol ends at N=14)
    if !cp_fast_cert_n14() { score = score + 1 };
    // Inhibitor: certified
    if cp_inh_cert_n14()  { score = score + 1 };
    // Inducer D=20mg: NOT certified
    if !cp_ind_d20_cert_n14() { score = score + 1 };
    // Inducer D=34mg: NOT certified (N_crit=26 > 14) — Finding D (needs full extended monitoring)
    if !cp_ind_d34_cert_n14() { score = score + 1 };

    // ── Section C: N=26 checkpoint — extended monitoring ─────────────────────
    // Standard: certified
    if cp_std_cert_n26()  { score = score + 1 };
    // Slow: NOT certified at N=26 — Finding B (toxic accumulation: C > ceil)
    if !cp_slow_cert_n26() { score = score + 1 };
    // Slow toxic: point estimate ABOVE ceiling — compile-time hazard detection
    if cp_slow_toxic_n26() { score = score + 1 };
    // Fast: NOW certified (N_crit=15 < 26)
    if cp_fast_cert_n26()  { score = score + 1 };
    // Inhibitor: certified
    if cp_inh_cert_n26()   { score = score + 1 };
    // Inducer D=20mg: STILL not certified (structurally impossible)
    if !cp_ind_d20_cert_n26() { score = score + 1 };
    // Inducer D=34mg: certified EXACTLY at N=26 — Finding D (Gold theorem cross-check)
    if cp_ind_d34_cert_n26() { score = score + 1 };

    // ── Section D: Fast gap theorem — ONE dose short ──────────────────────────
    // Fast fails at N=14 AND passes at N=15
    if !cp_fast_cert_n14() && cp_fast_cert_n15() { score = score + 1 };
    // This is the narrowest possible gap: N_crit = protocol_N + 1
    if cp_fast_cert_n15() { score = score + 1 };
    // Fast fails at N=7 (confirmed not certified early)
    if !cp_fast_cert_n7()  { score = score + 1 };
    // Fast passes at N=26 (confirmed certified at extended checkpoint)
    if cp_fast_cert_n26()  { score = score + 1 };
    // Fast not certified at N=10 either (failure spans all standard monitoring)
    if !cp_certified(5.0, 10, 0.01677, 0.094, ka, fv, ke, k12, k21) { score = score + 1 };
    // Fast fails at N=14 (direct negative), passes at N=15 (direct positive)
    if !cp_certified(5.0, 14, 0.01677, 0.094, ka, fv, ke, k12, k21) { score = score + 1 };
    if  cp_certified(5.0, 15, 0.01677, 0.094, ka, fv, ke, k12, k21) { score = score + 1 };

    // ── Section E: Expanded uncertainty U = 2·u_c at checkpoints ────────────
    // U grows with N for standard stratum (absolute uncertainty increases)
    if cp_std_u_n14() > cp_std_u_n7()  { score = score + 1 };
    if cp_std_u_n26() > cp_std_u_n14() { score = score + 1 };
    // U grows for slow stratum (N=7 → N=26)
    if cp_u_grows(5.0, 7, 26, 0.00838, 0.188, ka, fv, ke, k12, k21) { score = score + 1 };
    // U grows for fast stratum (N=7 → N=26)
    if cp_u_grows(5.0, 7, 26, 0.01677, 0.094, ka, fv, ke, k12, k21) { score = score + 1 };
    // Standard U < 0.002 mg/L (2 ng/mL) at all checkpoints — tight absolute budget
    if cp_std_u_n7()  < 0.002 { score = score + 1 };
    if cp_std_u_n14() < 0.002 { score = score + 1 };
    if cp_std_u_n26() < 0.002 { score = score + 1 };
    // Inhibitor U < 0.001 mg/L at N=7 (smallest budget — high F, large C, tight CI)
    if cp_inh_u_n7() < 0.001  { score = score + 1 };
    // Inhibitor U grows: U(N=26) > U(N=7)
    if cp_inh_u_n26() > cp_inh_u_n7() { score = score + 1 };
    // Inducer D=20mg U at N=26 > standard U at N=26 (wide budget from low F)
    if cp_ind_d20_u_n26() > cp_std_u_n26() { score = score + 1 };
    // Fast U at N=14 < standard U at N=14 (fast has smaller absolute uncertainty)
    if cp_fast_u_n14() < cp_std_u_n14() { score = score + 1 };

    // ── Section F: Stratum-ordering at N=14 ──────────────────────────────────
    // At N=14, exactly 3 strata certified (std, slow, inh) — count via booleans
    let ka2 = ob_ka_var_std(); let fv2 = ob_f_var_std()
    let ke2 = ob_ke_var_std(); let k122 = ob_k12_var_std(); let k212 = ob_k21_var_std()
    let ke_inh = ob_ke_var_inh()
    let cert_std  = cp_certified(5.0,  14, 0.01118,  0.141,   ka2, fv2, ke2,     k122, k212)
    let cert_slow = cp_certified(5.0,  14, 0.00838,  0.188,   ka2, fv2, ke2,     k122, k212)
    let cert_fast = cp_certified(5.0,  14, 0.01677,  0.094,   ka2, fv2, ke2,     k122, k212)
    let cert_inh  = cp_certified(1.5,  14, 0.002236, 0.282,   ka2, fv2, ke_inh,  k122, k212)
    if cert_std  { score = score + 1 };
    if cert_slow { score = score + 1 };
    if !cert_fast { score = score + 1 };
    if cert_inh  { score = score + 1 };

    // ── Section G: Inhibitor boundary precision ───────────────────────────────
    // Inhibitor certifies at N=7 but let's verify N=6 does NOT certify
    let ke_inh2 = ob_ke_var_inh()
    if !cp_certified(1.5, 6, 0.002236, 0.282, ka, fv, ke_inh2, k12, k21) { score = score + 1 };
    if cp_inh_cert_n7() { score = score + 1 };
    // N_crit=7 is the unique boundary: one less and uncertified, this N exactly certified
    if !cp_certified(1.5, 6,  0.002236, 0.282, ka, fv, ke_inh2, k12, k21) &&
        cp_certified(1.5, 7,  0.002236, 0.282, ka, fv, ke_inh2, k12, k21) { score = score + 1 };

    // ── Section H: Matrix completeness and safety summary ────────────────────
    // At N=7: standard CERT, inh CERT, fast FAIL
    if cp_std_cert_n7() && cp_inh_cert_n7() && !cp_fast_cert_n7() { score = score + 1 };
    // At N=14: std/slow/inh CERT, fast FAIL (key safety gap)
    if cp_std_cert_n14() && cp_slow_cert_n14() && !cp_fast_cert_n14() { score = score + 1 };
    // At N=26: slow exits (toxic), fast enters — stratum exchange
    if !cp_slow_cert_n26() && cp_fast_cert_n26() { score = score + 1 };
    // Inducer D=20mg fails at ALL THREE checkpoints (structural impossibility)
    if !cp_ind_d20_cert_n7() && !cp_ind_d20_cert_n14() && !cp_ind_d20_cert_n26() { score = score + 1 };
    // Standard stratum passes ALL THREE checkpoints (most robust)
    if cp_std_cert_n7() && cp_std_cert_n14() && cp_std_cert_n26() { score = score + 1 };
    // Inhibitor passes all three (certified from N=7 onward)
    if cp_inh_cert_n7() && cp_inh_cert_n14() && cp_inh_cert_n26() { score = score + 1 };
    // Gold theorem: ind D=34mg fails at N=14, passes at N=26
    if !cp_ind_d34_cert_n14() && cp_ind_d34_cert_n26() { score = score + 1 };
    // Slow is safe at N=7 and N=14 but toxic at N=26 — safety window collapse
    if cp_slow_cert_n7() && cp_slow_cert_n14() && !cp_slow_cert_n26() { score = score + 1 };
    // Inh U at N=7 is smaller than std U at N=7 (high-F drives tighter budget)
    if cp_inh_u_n7() < cp_std_u_n7() { score = score + 1 };
    // Inh U at N=26 still smaller than std U at N=26
    if cp_inh_u_n26() < cp_std_u_n26() { score = score + 1 };
    // Slow is NOT yet toxic at N=14 (C < ceil) — toxicity only appears at N=26
    if !cp_c_above_ceil(5.0, 14, 0.00838, 0.188) { score = score + 1 };
    // Standard is NOT toxic at N=26 (C stays within ceiling at extended monitoring)
    if !cp_c_above_ceil(5.0, 26, 0.01118, 0.141) { score = score + 1 };

    score
}
