// stdlib/pbpk/rapamycin_sprint58_gate.sio — Sprint 58 certification gate
//
// Population-weighted composite certification across all five CYP3A4/P-gp strata.
// Weights: inh=0.05, slow=0.15, std=0.50, fast=0.20, ind=0.10.
//
// Per-stratum margins at monitoring visits:
//   inh  N=7:3.191 CERT   N=14:9.757 CERT   N=28:8.787 CERT
//   slow N=7:1.419 WARN   N=14:6.251 CERT   N=28:12.073 CERT
//   std  N=7:2.821 CERT   N=14:6.432 CERT   N=28:4.690 CERT
//   fast N=7:2.059 CERT   N=14:4.387 CERT   N=28:3.226 CERT
//   ind  N=7:0.290 WARN   N=14:1.179 WARN   N=28:2.117 CERT
//
// Population composite:
//   N=7:  cert=0.75, warn=0.25, alarm=0.00
//   N=14: cert=0.90, warn=0.10, alarm=0.00
//   N=28: cert=1.00, warn≈0,   alarm=0.00
//   gain N=7→14=0.15 (slow joins), gain N=14→28=0.10 (ind joins)
//
// Finding A: universal coverage — entire population certified by N=28.
// Finding B: monotone 0.75→0.90→1.00; each visit eliminates one stratum from gap.
// Finding C: zero ALARM population weight at all three monitoring visits.
// Finding D: two N=7 non-certifiers: slow (n_crit=8, +1 day) and ind (n_crit=26).
//
// 56 assertions in sections A–H. All must pass (return 56).

module pbpk::rapamycin_sprint58_gate

use pbpk::rapamycin_population_composite::{
    pwc_cert_n7, pwc_warn_n7, pwc_alarm_n7, pwc_gap_n7,
    pwc_cert_n14, pwc_warn_n14, pwc_alarm_n14, pwc_gap_n14,
    pwc_cert_n28, pwc_warn_n28, pwc_alarm_n28, pwc_gap_n28,
    pwc_gain_n7_to_n14, pwc_gain_n14_to_n28, pwc_total_gain
}
use pbpk::rapamycin_inh_trajectory::{iht_margin_n7, iht_margin_n14, iht_margin_n28}
use pbpk::rapamycin_slow_adjusted::{sa_margin_n7, sa_margin_n14, sa_margin_n28}
use pbpk::rapamycin_std_trajectory::{stt_margin_n7, stt_margin_n14, stt_margin_n28}
use pbpk::rapamycin_fast_adjusted::{fa_margin_n7, fa_margin_n14, fa_margin_n28}
use pbpk::rapamycin_ind_trajectory::{it_margin_n7, it_margin_n14, it_margin_n28}

pub fn rapamycin_sprint58_gate() -> i64 with Mut, Div, Panic {
    var score = 0

    // ── Section A: N=7 population fractions ──────────────────────────────────
    if pwc_cert_n7() > 0.74 { score = score + 1 };
    if pwc_cert_n7() < 0.76 { score = score + 1 };
    if pwc_alarm_n7() < 0.01 { score = score + 1 };
    if pwc_warn_n7() > 0.24 { score = score + 1 };
    if pwc_warn_n7() < 0.26 { score = score + 1 };
    if pwc_gap_n7() > 0.24 { score = score + 1 };
    if pwc_gap_n7() < 0.26 { score = score + 1 };

    // ── Section B: N=7 per-stratum breakdown (Finding D) ─────────────────────
    if iht_margin_n7() >= 2.0 { score = score + 1 };
    if sa_margin_n7() < 2.0 { score = score + 1 };
    if sa_margin_n7() > 0.0 { score = score + 1 };
    if stt_margin_n7() >= 2.0 { score = score + 1 };
    if fa_margin_n7() >= 2.0 { score = score + 1 };
    if it_margin_n7() < 2.0 { score = score + 1 };
    if it_margin_n7() > 0.0 { score = score + 1 };

    // ── Section C: N=14 population fractions ─────────────────────────────────
    if pwc_cert_n14() > 0.89 { score = score + 1 };
    if pwc_cert_n14() < 0.91 { score = score + 1 };
    if pwc_alarm_n14() < 0.01 { score = score + 1 };
    if pwc_warn_n14() > 0.09 { score = score + 1 };
    if pwc_warn_n14() < 0.11 { score = score + 1 };
    if pwc_gap_n14() > 0.09 { score = score + 1 };
    if pwc_gap_n14() < 0.11 { score = score + 1 };

    // ── Section D: N=28 universal coverage (Finding A) ───────────────────────
    if pwc_cert_n28() > 0.99 { score = score + 1 };
    if pwc_cert_n28() < 1.01 { score = score + 1 };
    if pwc_alarm_n28() < 0.01 { score = score + 1 };
    if pwc_warn_n28() < 0.01 { score = score + 1 };
    if pwc_gap_n28() < 0.01 { score = score + 1 };
    if it_margin_n28() >= 2.0 { score = score + 1 };
    if sa_margin_n28() >= 2.0 { score = score + 1 };

    // ── Section E: monotone convergence 0.75→0.90→1.00 (Finding B) ──────────
    if pwc_cert_n14() > pwc_cert_n7() { score = score + 1 };
    if pwc_cert_n28() > pwc_cert_n14() { score = score + 1 };
    if pwc_gain_n7_to_n14() > 0.14 { score = score + 1 };
    if pwc_gain_n7_to_n14() < 0.16 { score = score + 1 };
    if pwc_gain_n14_to_n28() > 0.09 { score = score + 1 };
    if pwc_gain_n14_to_n28() < 0.11 { score = score + 1 };
    if pwc_total_gain() > 0.24 { score = score + 1 };

    // ── Section F: zero ALARM throughout (Finding C) ─────────────────────────
    if pwc_alarm_n7() < 0.01 { score = score + 1 };
    if pwc_alarm_n14() < 0.01 { score = score + 1 };
    if pwc_alarm_n28() < 0.01 { score = score + 1 };
    if it_margin_n7() > 0.0 { score = score + 1 };
    if sa_margin_n7() > 0.0 { score = score + 1 };
    if it_margin_n14() > 0.0 { score = score + 1 };
    if pwc_total_gain() < 0.26 { score = score + 1 };

    // ── Section G: gap elimination sequence ───────────────────────────────────
    if pwc_gap_n7() > pwc_gap_n14() { score = score + 1 };
    if pwc_gap_n14() > pwc_gap_n28() { score = score + 1 };
    if pwc_gap_n7() > 0.24 { score = score + 1 };
    if pwc_gap_n7() < 0.26 { score = score + 1 };
    if pwc_gap_n14() > 0.09 { score = score + 1 };
    if pwc_gap_n14() < 0.11 { score = score + 1 };
    if pwc_gap_n28() < 0.01 { score = score + 1 };

    // ── Section H: policy — 75%→90%→100%; no ALARM at any standard visit ─────
    if pwc_cert_n7() > 0.74 { score = score + 1 };
    if pwc_cert_n14() > 0.89 { score = score + 1 };
    if pwc_cert_n28() > 0.99 { score = score + 1 };
    if pwc_alarm_n7() < 0.01 { score = score + 1 };
    if pwc_alarm_n14() < 0.01 { score = score + 1 };
    if pwc_alarm_n28() < 0.01 { score = score + 1 };
    if pwc_total_gain() > 0.24 { score = score + 1 };

    score
}
