// stdlib/pbpk/rapamycin_sprint28_gate.sio — Sprint 28: Sensitivity Index Gate
//
// 56-assertion certification for ISO GUM sensitivity indices S_i = V_i/V_total.
// Sections A-H: S_F bounds, S_ke bounds, S_k12 analysis, ordering,
// N-evolution, inhibitor anomaly, actionability, inducer extremes.

module pbpk::rapamycin_sprint28_gate

use pbpk::rapamycin_sensitivity::{
    si_s_ke, si_s_F, si_s_ka, si_s_k12, si_s_k21,
    si_v_F_std_ss, si_v_tot_inh_ss
}
use pbpk::rapamycin_oral_budget::{
    ob_v1_channel, ob_v1_total,
    ob_ka_var_std, ob_f_var_std, ob_ke_var_std,
    ob_k12_var_std, ob_k21_var_std, ob_ke_var_inh, ob_ke_var_ind
}

fn s28_chk(b: bool) -> i64 with Mut, Div, Panic {
    if b { 1 } else { 0 }
}

pub fn rapamycin_sprint28_gate() -> i64 with Mut, Div, Panic {
    let ka   = ob_ka_var_std()
    let fv   = ob_f_var_std()
    let kev  = ob_ke_var_std()
    let k12v = ob_k12_var_std()
    let k21v = ob_k21_var_std()
    let ke_inh = ob_ke_var_inh()
    let ke_ind = ob_ke_var_ind()

    var ok = 0

    // ── Section A: S_F absolute bounds (probe-certified) ─────────────────────
    // A1-A2: std N=14 S_F = 73.5%
    ok = ok + s28_chk(si_s_F(5.0, 14, 0.01118, 0.141, ka, fv, kev, k12v, k21v) > 0.72)
    ok = ok + s28_chk(si_s_F(5.0, 14, 0.01118, 0.141, ka, fv, kev, k12v, k21v) < 0.75)
    // A3-A4: std N=3 S_F = 85.4%
    ok = ok + s28_chk(si_s_F(5.0, 3, 0.01118, 0.141, ka, fv, kev, k12v, k21v) > 0.84)
    ok = ok + s28_chk(si_s_F(5.0, 3, 0.01118, 0.141, ka, fv, kev, k12v, k21v) < 0.87)
    // A5-A6: slow N=14 S_F = 63.4%
    ok = ok + s28_chk(si_s_F(5.0, 14, 0.00838, 0.188, ka, fv, kev, k12v, k21v) > 0.62)
    ok = ok + s28_chk(si_s_F(5.0, 14, 0.00838, 0.188, ka, fv, kev, k12v, k21v) < 0.65)
    // A7-A8: fast N=14 S_F = 82.3%
    ok = ok + s28_chk(si_s_F(5.0, 14, 0.01677, 0.094, ka, fv, kev, k12v, k21v) > 0.81)
    ok = ok + s28_chk(si_s_F(5.0, 14, 0.01677, 0.094, ka, fv, kev, k12v, k21v) < 0.84)
    // A9-A10: inh N=14 S_F = 42.8% (anomaly — lowest S_F of all strata)
    ok = ok + s28_chk(si_s_F(1.5, 14, 0.002236, 0.282, ka, fv, ke_inh, k12v, k21v) > 0.42)
    ok = ok + s28_chk(si_s_F(1.5, 14, 0.002236, 0.282, ka, fv, ke_inh, k12v, k21v) < 0.44)

    // ── Section B: S_ke bounds ────────────────────────────────────────────────
    // B11-B12: std N=14 S_ke = 9.2%
    ok = ok + s28_chk(si_s_ke(5.0, 14, 0.01118, 0.141, ka, fv, kev, k12v, k21v) > 0.08)
    ok = ok + s28_chk(si_s_ke(5.0, 14, 0.01118, 0.141, ka, fv, kev, k12v, k21v) < 0.10)
    // B13-B14: std N=3 S_ke = 10.7%
    ok = ok + s28_chk(si_s_ke(5.0, 3, 0.01118, 0.141, ka, fv, kev, k12v, k21v) > 0.10)
    ok = ok + s28_chk(si_s_ke(5.0, 3, 0.01118, 0.141, ka, fv, kev, k12v, k21v) < 0.12)
    // B15-B16: inh N=14 S_ke = 5.5% (lowest — inhibition so severe ke uncertainty tiny)
    ok = ok + s28_chk(si_s_ke(1.5, 14, 0.002236, 0.282, ka, fv, ke_inh, k12v, k21v) > 0.04)
    ok = ok + s28_chk(si_s_ke(1.5, 14, 0.002236, 0.282, ka, fv, ke_inh, k12v, k21v) < 0.07)
    // B17-B18: ind N=26 S_ke = 9.8%
    ok = ok + s28_chk(si_s_ke(20.0, 26, 0.05590, 0.047, ka, fv, ke_ind, k12v, k21v) > 0.09)
    ok = ok + s28_chk(si_s_ke(20.0, 26, 0.05590, 0.047, ka, fv, ke_ind, k12v, k21v) < 0.11)

    // ── Section C: S_k12 analysis ─────────────────────────────────────────────
    // C19: std N=3 S_k12 < 5% (distribution negligible at onset)
    ok = ok + s28_chk(si_s_k12(5.0, 3, 0.01118, 0.141, ka, fv, kev, k12v, k21v) < 0.05)
    // C20: std N=14 S_k12 > 10% (grows with doses)
    ok = ok + s28_chk(si_s_k12(5.0, 14, 0.01118, 0.141, ka, fv, kev, k12v, k21v) > 0.10)
    // C21-C22: inh N=14 S_k12 = 35.3% — the anomaly
    ok = ok + s28_chk(si_s_k12(1.5, 14, 0.002236, 0.282, ka, fv, ke_inh, k12v, k21v) > 0.33)
    ok = ok + s28_chk(si_s_k12(1.5, 14, 0.002236, 0.282, ka, fv, ke_inh, k12v, k21v) < 0.37)
    // C23-C24: slow N=14 S_k12 = 18.2%
    ok = ok + s28_chk(si_s_k12(5.0, 14, 0.00838, 0.188, ka, fv, kev, k12v, k21v) > 0.17)
    ok = ok + s28_chk(si_s_k12(5.0, 14, 0.00838, 0.188, ka, fv, kev, k12v, k21v) < 0.20)
    // C25: ind N=26 S_k12 < 2% (rapid clearance: drug never reaches peripheral)
    ok = ok + s28_chk(si_s_k12(20.0, 26, 0.05590, 0.047, ka, fv, ke_ind, k12v, k21v) < 0.02)
    // C26: S_k12 grows with N for standard (3.5% → 10.8%)
    ok = ok + s28_chk(si_s_k12(5.0, 14, 0.01118, 0.141, ka, fv, kev, k12v, k21v) >
                      si_s_k12(5.0, 3, 0.01118, 0.141, ka, fv, kev, k12v, k21v))

    // ── Section D: Ordering — S_F > S_ke universally ─────────────────────────
    // D27-D31: S_F > S_ke in every stratum
    ok = ok + s28_chk(si_s_F(5.0, 14, 0.01118, 0.141, ka, fv, kev, k12v, k21v) >
                      si_s_ke(5.0, 14, 0.01118, 0.141, ka, fv, kev, k12v, k21v))
    ok = ok + s28_chk(si_s_F(5.0, 14, 0.00838, 0.188, ka, fv, kev, k12v, k21v) >
                      si_s_ke(5.0, 14, 0.00838, 0.188, ka, fv, kev, k12v, k21v))
    ok = ok + s28_chk(si_s_F(5.0, 14, 0.01677, 0.094, ka, fv, kev, k12v, k21v) >
                      si_s_ke(5.0, 14, 0.01677, 0.094, ka, fv, kev, k12v, k21v))
    ok = ok + s28_chk(si_s_F(1.5, 14, 0.002236, 0.282, ka, fv, ke_inh, k12v, k21v) >
                      si_s_ke(1.5, 14, 0.002236, 0.282, ka, fv, ke_inh, k12v, k21v))
    ok = ok + s28_chk(si_s_F(20.0, 26, 0.05590, 0.047, ka, fv, ke_ind, k12v, k21v) >
                      si_s_ke(20.0, 26, 0.05590, 0.047, ka, fv, ke_ind, k12v, k21v))
    // D32-D34: S_F > S_k12 in every stratum (F still above k12 everywhere)
    ok = ok + s28_chk(si_s_F(5.0, 14, 0.01118, 0.141, ka, fv, kev, k12v, k21v) >
                      si_s_k12(5.0, 14, 0.01118, 0.141, ka, fv, kev, k12v, k21v))
    ok = ok + s28_chk(si_s_F(5.0, 14, 0.00838, 0.188, ka, fv, kev, k12v, k21v) >
                      si_s_k12(5.0, 14, 0.00838, 0.188, ka, fv, kev, k12v, k21v))
    ok = ok + s28_chk(si_s_F(1.5, 14, 0.002236, 0.282, ka, fv, ke_inh, k12v, k21v) >
                      si_s_k12(1.5, 14, 0.002236, 0.282, ka, fv, ke_inh, k12v, k21v))

    // ── Section E: S_F evolution with N for standard ──────────────────────────
    // E35: S_F decreases N=3 → N=7 → N=14 (k12 steals from F)
    ok = ok + s28_chk(si_s_F(5.0, 3, 0.01118, 0.141, ka, fv, kev, k12v, k21v) >
                      si_s_F(5.0, 7, 0.01118, 0.141, ka, fv, kev, k12v, k21v))
    ok = ok + s28_chk(si_s_F(5.0, 7, 0.01118, 0.141, ka, fv, kev, k12v, k21v) >
                      si_s_F(5.0, 14, 0.01118, 0.141, ka, fv, kev, k12v, k21v))
    // E37: S_k12 increases N=3 → N=7 → N=14
    ok = ok + s28_chk(si_s_k12(5.0, 7, 0.01118, 0.141, ka, fv, kev, k12v, k21v) >
                      si_s_k12(5.0, 3, 0.01118, 0.141, ka, fv, kev, k12v, k21v))
    ok = ok + s28_chk(si_s_k12(5.0, 14, 0.01118, 0.141, ka, fv, kev, k12v, k21v) >
                      si_s_k12(5.0, 7, 0.01118, 0.141, ka, fv, kev, k12v, k21v))
    // E39: S_k21 increases N=3 → N=14 (return channel grows with distribution)
    ok = ok + s28_chk(si_s_k21(5.0, 14, 0.01118, 0.141, ka, fv, kev, k12v, k21v) >
                      si_s_k21(5.0, 3, 0.01118, 0.141, ka, fv, kev, k12v, k21v))
    // E40: S_ke slightly decreases N=3 → N=14 (ke channel stable but fraction shrinks)
    ok = ok + s28_chk(si_s_ke(5.0, 3, 0.01118, 0.141, ka, fv, kev, k12v, k21v) >
                      si_s_ke(5.0, 14, 0.01118, 0.141, ka, fv, kev, k12v, k21v))

    // ── Section F: Inhibitor anomaly ─────────────────────────────────────────
    // F41: inh S_k12 >> std S_k12 (35% vs 11% — anomaly)
    ok = ok + s28_chk(si_s_k12(1.5, 14, 0.002236, 0.282, ka, fv, ke_inh, k12v, k21v) >
                      si_s_k12(5.0, 14, 0.01118, 0.141, ka, fv, kev, k12v, k21v))
    // F42: inh k12 > inh ke (distribution > elimination for inhibitor)
    ok = ok + s28_chk(si_s_k12(1.5, 14, 0.002236, 0.282, ka, fv, ke_inh, k12v, k21v) >
                      si_s_ke(1.5, 14, 0.002236, 0.282, ka, fv, ke_inh, k12v, k21v))
    // F43: inh k12 > inh k21 (forward distribution > return)
    ok = ok + s28_chk(si_s_k12(1.5, 14, 0.002236, 0.282, ka, fv, ke_inh, k12v, k21v) >
                      si_s_k21(1.5, 14, 0.002236, 0.282, ka, fv, ke_inh, k12v, k21v))
    // F44: inh S_F + S_k12 > 0.75 (together account for >75% of total variance)
    ok = ok + s28_chk(si_s_F(1.5, 14, 0.002236, 0.282, ka, fv, ke_inh, k12v, k21v) +
                      si_s_k12(1.5, 14, 0.002236, 0.282, ka, fv, ke_inh, k12v, k21v) > 0.75)
    // F45: inh S_ke < std S_ke (inhibitor ke uncertainty contributes less)
    ok = ok + s28_chk(si_s_ke(1.5, 14, 0.002236, 0.282, ka, fv, ke_inh, k12v, k21v) <
                      si_s_ke(5.0, 14, 0.01118, 0.141, ka, fv, kev, k12v, k21v))
    // F46: inh S_k12 > fast S_k12 (inhibitor: 35% vs fast: 5%)
    ok = ok + s28_chk(si_s_k12(1.5, 14, 0.002236, 0.282, ka, fv, ke_inh, k12v, k21v) >
                      si_s_k12(5.0, 14, 0.01677, 0.094, ka, fv, kev, k12v, k21v))

    // ── Section G: Actionability — V_F vs other channels ─────────────────────
    // G47: V_F_std > V_total_inh (std F-channel alone > entire inh variance budget)
    ok = ok + s28_chk(si_v_F_std_ss() > si_v_tot_inh_ss())
    // G48: S_ka < S_k21 for all standard N (ka always smallest)
    ok = ok + s28_chk(si_s_ka(5.0, 14, 0.01118, 0.141, ka, fv, kev, k12v, k21v) <
                      si_s_k21(5.0, 14, 0.01118, 0.141, ka, fv, kev, k12v, k21v))
    // G49: S_k21 < S_k12 for std N=14 (forward > return in central budget)
    ok = ok + s28_chk(si_s_k21(5.0, 14, 0.01118, 0.141, ka, fv, kev, k12v, k21v) <
                      si_s_k12(5.0, 14, 0.01118, 0.141, ka, fv, kev, k12v, k21v))
    // G50: S_ke + S_F > 0.80 for std N=14 (9.2+73.5=82.7%)
    ok = ok + s28_chk(si_s_ke(5.0, 14, 0.01118, 0.141, ka, fv, kev, k12v, k21v) +
                      si_s_F(5.0, 14, 0.01118, 0.141, ka, fv, kev, k12v, k21v) > 0.80)
    // G51: S_ke + S_F > 0.90 for fast N=14 (10.2+82.3=92.5%)
    ok = ok + s28_chk(si_s_ke(5.0, 14, 0.01677, 0.094, ka, fv, kev, k12v, k21v) +
                      si_s_F(5.0, 14, 0.01677, 0.094, ka, fv, kev, k12v, k21v) > 0.90)
    // G52: S_F alone > 0.5 for all strata except inh (F majority contributor)
    ok = ok + s28_chk(si_s_F(5.0, 14, 0.01118, 0.141, ka, fv, kev, k12v, k21v) > 0.5 &&
                      si_s_F(5.0, 14, 0.00838, 0.188, ka, fv, kev, k12v, k21v) > 0.5 &&
                      si_s_F(5.0, 14, 0.01677, 0.094, ka, fv, kev, k12v, k21v) > 0.5 &&
                      si_s_F(20.0, 26, 0.05590, 0.047, ka, fv, ke_ind, k12v, k21v) > 0.5)

    // ── Section H: Inducer extremes ───────────────────────────────────────────
    // H53: ind S_F > 0.85 (highest F dominance)
    ok = ok + s28_chk(si_s_F(20.0, 26, 0.05590, 0.047, ka, fv, ke_ind, k12v, k21v) > 0.85)
    // H54: ind S_k12 < std S_k12 (rapid clearance suppresses peripheral distribution)
    ok = ok + s28_chk(si_s_k12(20.0, 26, 0.05590, 0.047, ka, fv, ke_ind, k12v, k21v) <
                      si_s_k12(5.0, 14, 0.01118, 0.141, ka, fv, kev, k12v, k21v))
    // H55: ind S_k21 < std S_k21
    ok = ok + s28_chk(si_s_k21(20.0, 26, 0.05590, 0.047, ka, fv, ke_ind, k12v, k21v) <
                      si_s_k21(5.0, 14, 0.01118, 0.141, ka, fv, kev, k12v, k21v))
    // H56: ind S_ka > std S_ka (rapid clearance amplifies absorption timing)
    ok = ok + s28_chk(si_s_ka(20.0, 26, 0.05590, 0.047, ka, fv, ke_ind, k12v, k21v) >
                      si_s_ka(5.0, 14, 0.01118, 0.141, ka, fv, kev, k12v, k21v))

    ok
}
