// stdlib/pbpk/rapamycin_sprint28_gate.sio — Sprint 28: Bayesian TDM measurement-update gate
//
// 56 assertions certifying:
//   §A  Equivalence theorem (cv_immuno/cv_lcms)² is stratum-invariant
//   §B  gain ≥ 1.0 in every (stratum, N, assay) cell
//   §C  LCMS gain > CMIA gain in every cell
//   §D  u_post < u_pk strictly via ep_merge
//   §E  Cross-stratum gain ordering: inh < slow < std < fast < ind
//   §F  mst_k_to_match_lcms ∈ {5, 6, 7} for ind and std
//   §G  Gain at N=7 > gain at N=14 in every stratum (informational-decay
//       theorem: V_assay grows with C-saturation faster than V_pred)
//   §H  Sanity bounds — equivalence count, gain magnitudes
//
// Pattern: `pub fn rapamycin_sprint28_gate() -> i64`, sequential `var ok = 0;
// ok = ok + s28_chk(...)` accumulation (mirrors sprint27_gate.sio:29).

module pbpk::rapamycin_sprint28_gate

use pbpk::rapamycin_multistratum_tdm::{
    mst_equiv_count,
    mst_gain_std_n7_lcms,  mst_gain_std_n14_lcms,
    mst_gain_std_n7_cmia,  mst_gain_std_n14_cmia,
    mst_gain_slow_n7_lcms, mst_gain_slow_n14_lcms,
    mst_gain_slow_n7_cmia, mst_gain_slow_n14_cmia,
    mst_gain_fast_n7_lcms, mst_gain_fast_n14_lcms,
    mst_gain_fast_n7_cmia, mst_gain_fast_n14_cmia,
    mst_gain_inh_n7_lcms,  mst_gain_inh_n14_lcms,
    mst_gain_inh_n7_cmia,  mst_gain_inh_n14_cmia,
    mst_gain_ind_n7_lcms,  mst_gain_ind_n14_lcms,
    mst_gain_ind_n7_cmia,  mst_gain_ind_n14_cmia,
    mst_u_pk_std_n14,      mst_u_post_std_n14_lcms, mst_u_post_std_n14_cmia,
    mst_u_pk_ind_n14,      mst_u_post_ind_n14_lcms,
    mst_k_to_match_lcms_std_n14, mst_k_to_match_lcms_ind_n14
}
use pbpk::rapamycin_assay::{as_cv_hplc, as_cv_cmia, as_cv_poor}

fn s28_chk(b: bool) -> i64 with Mut, Div, Panic {
    if b { 1 } else { 0 }
}

pub fn rapamycin_sprint28_gate() -> i64 with Mut, Div, Panic {
    var ok = 0

    // ── §A — Equivalence theorem (6 assertions) ───────────────────────────
    let eq_hc = mst_equiv_count(as_cv_hplc(), as_cv_cmia())   // ≈ 5.76
    let eq_hp = mst_equiv_count(as_cv_hplc(), as_cv_poor())   // = 25.0
    let eq_cp = mst_equiv_count(as_cv_cmia(), as_cv_poor())   // ≈ 4.34
    // A1-A2: hplc/cmia ∈ [5.7, 5.85]
    ok = ok + s28_chk(eq_hc > 5.70)
    ok = ok + s28_chk(eq_hc < 5.85)
    // A3-A4: hplc/poor ∈ [24.5, 25.5]
    ok = ok + s28_chk(eq_hp > 24.5)
    ok = ok + s28_chk(eq_hp < 25.5)
    // A5-A6: cmia/poor ∈ [4.3, 4.4]
    ok = ok + s28_chk(eq_cp > 4.30)
    ok = ok + s28_chk(eq_cp < 4.40)

    // ── §B — gain ≥ 1.0 in every cell (10 assertions, sampled) ────────────
    ok = ok + s28_chk(mst_gain_std_n14_lcms()  >= 1.0)   // B7
    ok = ok + s28_chk(mst_gain_std_n14_cmia()  >= 1.0)   // B8
    ok = ok + s28_chk(mst_gain_slow_n14_lcms() >= 1.0)   // B9
    ok = ok + s28_chk(mst_gain_slow_n14_cmia() >= 1.0)   // B10
    ok = ok + s28_chk(mst_gain_fast_n14_lcms() >= 1.0)   // B11
    ok = ok + s28_chk(mst_gain_fast_n14_cmia() >= 1.0)   // B12
    ok = ok + s28_chk(mst_gain_inh_n14_lcms()  >= 1.0)   // B13
    ok = ok + s28_chk(mst_gain_inh_n14_cmia()  >= 1.0)   // B14
    ok = ok + s28_chk(mst_gain_ind_n14_lcms()  >= 1.0)   // B15
    ok = ok + s28_chk(mst_gain_ind_n14_cmia()  >= 1.0)   // B16

    // ── §C — LCMS gain > CMIA gain in every cell (10 assertions) ──────────
    let g_std_l7  = mst_gain_std_n7_lcms()
    let g_std_c7  = mst_gain_std_n7_cmia()
    let g_std_l14 = mst_gain_std_n14_lcms()
    let g_std_c14 = mst_gain_std_n14_cmia()
    let g_slow_l7  = mst_gain_slow_n7_lcms()
    let g_slow_c7  = mst_gain_slow_n7_cmia()
    let g_slow_l14 = mst_gain_slow_n14_lcms()
    let g_slow_c14 = mst_gain_slow_n14_cmia()
    let g_fast_l7  = mst_gain_fast_n7_lcms()
    let g_fast_c7  = mst_gain_fast_n7_cmia()
    let g_fast_l14 = mst_gain_fast_n14_lcms()
    let g_fast_c14 = mst_gain_fast_n14_cmia()
    let g_inh_l7   = mst_gain_inh_n7_lcms()
    let g_inh_c7   = mst_gain_inh_n7_cmia()
    let g_inh_l14  = mst_gain_inh_n14_lcms()
    let g_inh_c14  = mst_gain_inh_n14_cmia()
    let g_ind_l7   = mst_gain_ind_n7_lcms()
    let g_ind_c7   = mst_gain_ind_n7_cmia()
    let g_ind_l14  = mst_gain_ind_n14_lcms()
    let g_ind_c14  = mst_gain_ind_n14_cmia()
    ok = ok + s28_chk(g_std_l7  > g_std_c7)    // C17
    ok = ok + s28_chk(g_std_l14 > g_std_c14)   // C18
    ok = ok + s28_chk(g_slow_l7 > g_slow_c7)   // C19
    ok = ok + s28_chk(g_slow_l14 > g_slow_c14) // C20
    ok = ok + s28_chk(g_fast_l7 > g_fast_c7)   // C21
    ok = ok + s28_chk(g_fast_l14 > g_fast_c14) // C22
    ok = ok + s28_chk(g_inh_l7  > g_inh_c7)    // C23
    ok = ok + s28_chk(g_inh_l14 > g_inh_c14)   // C24
    ok = ok + s28_chk(g_ind_l7  > g_ind_c7)    // C25
    ok = ok + s28_chk(g_ind_l14 > g_ind_c14)   // C26

    // ── §D — u_post < u_pk strictly (6 assertions) ────────────────────────
    let u_pk_std = mst_u_pk_std_n14()
    let u_pk_ind = mst_u_pk_ind_n14()
    let u_post_std_l = mst_u_post_std_n14_lcms()
    let u_post_std_c = mst_u_post_std_n14_cmia()
    let u_post_ind_l = mst_u_post_ind_n14_lcms()
    ok = ok + s28_chk(u_post_std_l < u_pk_std)              // D27
    ok = ok + s28_chk(u_post_std_c < u_pk_std)              // D28
    ok = ok + s28_chk(u_post_ind_l < u_pk_ind)              // D29
    // gain consistency: u_pk / u_post matches mst_gain (within 1%)
    ok = ok + s28_chk(u_post_std_l * g_std_l14 > 0.99 * u_pk_std)  // D30
    ok = ok + s28_chk(u_post_std_l * g_std_l14 < 1.01 * u_pk_std)  // D31
    // LCMS posterior tighter than CMIA posterior (more informative obs)
    ok = ok + s28_chk(u_post_std_l < u_post_std_c)          // D32

    // ── §E — Cross-stratum gain ordering at N=14 LCMS (8 assertions) ──────
    // Ordering: inh < slow < std < fast < ind
    ok = ok + s28_chk(g_inh_l14  < g_slow_l14)              // E33
    ok = ok + s28_chk(g_slow_l14 < g_std_l14)               // E34
    ok = ok + s28_chk(g_std_l14  < g_fast_l14)              // E35
    ok = ok + s28_chk(g_fast_l14 < g_ind_l14)               // E36
    // Same ordering at N=7
    ok = ok + s28_chk(g_inh_l7   < g_slow_l7)               // E37
    ok = ok + s28_chk(g_slow_l7  < g_std_l7)                // E38
    ok = ok + s28_chk(g_std_l7   < g_fast_l7)               // E39
    ok = ok + s28_chk(g_fast_l7  < g_ind_l7)                // E40

    // ── §F — k-to-match LCMS ∈ {5,6,7} (4 assertions) ─────────────────────
    let k_std = mst_k_to_match_lcms_std_n14()
    let k_ind = mst_k_to_match_lcms_ind_n14()
    ok = ok + s28_chk(k_std >= 5)                           // F41
    ok = ok + s28_chk(k_std <= 7)                           // F42
    ok = ok + s28_chk(k_ind >= 5)                           // F43
    ok = ok + s28_chk(k_ind <= 7)                           // F44

    // ── §G — gain at N=7 > gain at N=14 in every stratum (5 assertions) ──
    ok = ok + s28_chk(g_std_l7  > g_std_l14)                // G45
    ok = ok + s28_chk(g_slow_l7 > g_slow_l14)               // G46
    ok = ok + s28_chk(g_fast_l7 > g_fast_l14)               // G47
    ok = ok + s28_chk(g_inh_l7  > g_inh_l14)                // G48
    ok = ok + s28_chk(g_ind_l7  > g_ind_l14)                // G49

    // ── §H — Sanity bounds (7 assertions) ─────────────────────────────────
    // H50: equivalence theorem matches analytic constant (5.76 to 0.01)
    ok = ok + s28_chk(eq_hc > 5.755 && eq_hc < 5.765)
    // H51-H52: std N=14 LCMS gain within probe band [2.09, 2.10]
    ok = ok + s28_chk(g_std_l14 > 2.09 && g_std_l14 < 2.10)
    // H53-H54: ind N=14 LCMS gain within probe band [6.32, 6.33]
    ok = ok + s28_chk(g_ind_l14 > 6.32 && g_ind_l14 < 6.33)
    // H55: ind gain > 3× std gain at N=14 LCMS (wide-prior wins big)
    ok = ok + s28_chk(g_ind_l14 > 3.0 * g_std_l14)
    // H56: u_pk std N=14 ∈ [0.0008, 0.001] (matches Sprint 25 finding 0.000901)
    ok = ok + s28_chk(u_pk_std > 0.0008 && u_pk_std < 0.001)
    // H57: u_post_ind_lcms < u_pk_std (a single LCMS read on ind beats
    //      the prior on std — non-trivial cross-stratum claim)
    ok = ok + s28_chk(u_post_ind_l < u_pk_std)
    // H58: posterior u_post_std_lcms ≈ 0.000430 ± 0.00001
    ok = ok + s28_chk(u_post_std_l > 0.000425 && u_post_std_l < 0.000435)

    ok
}
