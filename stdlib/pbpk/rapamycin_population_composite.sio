// stdlib/pbpk/rapamycin_population_composite.sio — Sprint 58
//
// Population-weighted certification composite across all five CYP3A4/P-gp strata.
// Weights (w): inh=0.05, slow=0.15, std=0.50, fast=0.20, ind=0.10 (sum=1.00).
//
// At each standard monitoring visit (N=7/14/28):
//   N=7:  CERT 0.75 (inh+std+fast),         WARN 0.25 (slow+ind), ALARM 0.00
//   N=14: CERT 0.90 (inh+slow+std+fast),     WARN 0.10 (ind),      ALARM 0.00
//   N=28: CERT 1.00 (all five strata),        WARN 0.00,            ALARM 0.00
//
// Finding A: universal coverage by N=28 — the 4-week visit certifies the entire
//            patient population under stratum-optimal dosing.
// Finding B: monotone convergence 0.75 → 0.90 → 1.00; gain N=7→14 = 0.15
//            (slow joins), gain N=14→28 = 0.10 (ind joins).
// Finding C: no stratum enters ALARM at any standard monitoring visit;
//            pwc_alarm = 0.00 at N=7, 14, and 28.
// Finding D: the two N=7 non-certifiers are slow (n_crit=8, resolves next day)
//            and ind (n_crit=26, resolves by day 26); 25% gap fully closes by N=28.

module pbpk::rapamycin_population_composite

use pbpk::rapamycin_inh_trajectory::{iht_margin_n7, iht_margin_n14, iht_margin_n28}
use pbpk::rapamycin_slow_adjusted::{sa_margin_n7, sa_margin_n14, sa_margin_n28}
use pbpk::rapamycin_std_trajectory::{stt_margin_n7, stt_margin_n14, stt_margin_n28}
use pbpk::rapamycin_fast_adjusted::{fa_margin_n7, fa_margin_n14, fa_margin_n28}
use pbpk::rapamycin_ind_trajectory::{it_margin_n7, it_margin_n14, it_margin_n28}

fn pwc_cert_w(m: f64) -> f64 { if m >= 2.0 { 1.0 } else { 0.0 } }
fn pwc_alarm_w(m: f64) -> f64 { if m < 0.0 { 1.0 } else { 0.0 } }

// ── N=7 composite ─────────────────────────────────────────────────────────────
pub fn pwc_cert_n7() -> f64 with Mut, Div, Panic {
    pwc_cert_w(iht_margin_n7()) * 0.05
    + pwc_cert_w(sa_margin_n7()) * 0.15
    + pwc_cert_w(stt_margin_n7()) * 0.50
    + pwc_cert_w(fa_margin_n7()) * 0.20
    + pwc_cert_w(it_margin_n7()) * 0.10
}

pub fn pwc_alarm_n7() -> f64 with Mut, Div, Panic {
    pwc_alarm_w(iht_margin_n7()) * 0.05
    + pwc_alarm_w(sa_margin_n7()) * 0.15
    + pwc_alarm_w(stt_margin_n7()) * 0.50
    + pwc_alarm_w(fa_margin_n7()) * 0.20
    + pwc_alarm_w(it_margin_n7()) * 0.10
}

pub fn pwc_warn_n7() -> f64 with Mut, Div, Panic {
    1.0 - pwc_cert_n7() - pwc_alarm_n7()
}

// ── N=14 composite ────────────────────────────────────────────────────────────
pub fn pwc_cert_n14() -> f64 with Mut, Div, Panic {
    pwc_cert_w(iht_margin_n14()) * 0.05
    + pwc_cert_w(sa_margin_n14()) * 0.15
    + pwc_cert_w(stt_margin_n14()) * 0.50
    + pwc_cert_w(fa_margin_n14()) * 0.20
    + pwc_cert_w(it_margin_n14()) * 0.10
}

pub fn pwc_alarm_n14() -> f64 with Mut, Div, Panic {
    pwc_alarm_w(iht_margin_n14()) * 0.05
    + pwc_alarm_w(sa_margin_n14()) * 0.15
    + pwc_alarm_w(stt_margin_n14()) * 0.50
    + pwc_alarm_w(fa_margin_n14()) * 0.20
    + pwc_alarm_w(it_margin_n14()) * 0.10
}

pub fn pwc_warn_n14() -> f64 with Mut, Div, Panic {
    1.0 - pwc_cert_n14() - pwc_alarm_n14()
}

// ── N=28 composite ────────────────────────────────────────────────────────────
pub fn pwc_cert_n28() -> f64 with Mut, Div, Panic {
    pwc_cert_w(iht_margin_n28()) * 0.05
    + pwc_cert_w(sa_margin_n28()) * 0.15
    + pwc_cert_w(stt_margin_n28()) * 0.50
    + pwc_cert_w(fa_margin_n28()) * 0.20
    + pwc_cert_w(it_margin_n28()) * 0.10
}

pub fn pwc_alarm_n28() -> f64 with Mut, Div, Panic {
    pwc_alarm_w(iht_margin_n28()) * 0.05
    + pwc_alarm_w(sa_margin_n28()) * 0.15
    + pwc_alarm_w(stt_margin_n28()) * 0.50
    + pwc_alarm_w(fa_margin_n28()) * 0.20
    + pwc_alarm_w(it_margin_n28()) * 0.10
}

pub fn pwc_warn_n28() -> f64 with Mut, Div, Panic {
    1.0 - pwc_cert_n28() - pwc_alarm_n28()
}

// ── Coverage gaps (uncertified fraction at each visit) ────────────────────────
pub fn pwc_gap_n7()  -> f64 with Mut, Div, Panic { 1.0 - pwc_cert_n7()  }
pub fn pwc_gap_n14() -> f64 with Mut, Div, Panic { 1.0 - pwc_cert_n14() }
pub fn pwc_gap_n28() -> f64 with Mut, Div, Panic { 1.0 - pwc_cert_n28() }

// ── Convergence metrics (Finding B) ───────────────────────────────────────────
pub fn pwc_gain_n7_to_n14()  -> f64 with Mut, Div, Panic { pwc_cert_n14() - pwc_cert_n7()  }
pub fn pwc_gain_n14_to_n28() -> f64 with Mut, Div, Panic { pwc_cert_n28() - pwc_cert_n14() }
pub fn pwc_total_gain()      -> f64 with Mut, Div, Panic { pwc_cert_n28() - pwc_cert_n7()  }
