// stdlib/pbpk/rapamycin_sprint63_gate.sio — Sprint 63 certification gate
//
// Protocol-split analysis for CNI co-medication vs CNI-free (mono) dosing.
// Standard stratum (ke=0.01118, F=0.141, D=5mg); combined 4–20 window split
// at midpoint 0.012 mg/L (FDA NDA 21-083 boundary).
//
// Findings:
//   A: CNI cert window:      n_crit=6, n_last_cert=14, cert_span=8
//   B: CNI margin spots:     N=7 CERT (2.82), N=14 CERT (2.45), N=21 ALARM
//   C: CNI peak:             n_peak=10, margin_peak≈4.49
//   D: CNI-free cert window: n_crit=25, n_last_cert=36, cert_span=11
//   E: CNI-free margin spots: N=7 ALARM (−6.54), N=14 ALARM (−2.45), N=28 CERT
//   F: CNI-free peak:        n_peak=30, margin_peak≈3.82
//   G: Span losses:          cni_loss=22, free_loss=19; sub-spans 8+11=19<30
//   H: Dead-zone:            CNI closes day 14; CNI-free opens day 25; gap=11
//
// 56 assertions in sections A–H. All must pass (return 56).

module pbpk::rapamycin_sprint63_gate

use pbpk::rapamycin_cni_protocol::{
    cp_cni_margin_n7, cp_cni_margin_n14, cp_cni_margin_n21, cp_cni_margin_n28,
    cp_cni_n_crit, cp_cni_n_last_cert, cp_cni_n_peak, cp_cni_margin_peak, cp_cni_cert_span,
    cp_free_margin_n7, cp_free_margin_n14, cp_free_margin_n28,
    cp_free_n_crit, cp_free_n_last_cert, cp_free_n_peak, cp_free_margin_peak, cp_free_cert_span,
    cp_combined_n_crit, cp_combined_n_last_cert, cp_combined_cert_span,
    cp_cni_span_loss, cp_free_span_loss
}

pub fn rapamycin_sprint63_gate() -> i64 with Mut, Div, Panic {
    var score = 0

    // ── Section A: CNI cert window (Finding A) ───────────────────────────────
    if cp_cni_n_crit()      == 6  { score = score + 1 };
    if cp_cni_n_last_cert() == 14 { score = score + 1 };
    if cp_cni_cert_span()   == 8  { score = score + 1 };
    if cp_cni_n_crit() == cp_combined_n_crit() { score = score + 1 };
    if cp_cni_n_last_cert() < cp_combined_n_last_cert() { score = score + 1 };
    if cp_cni_cert_span()   < cp_combined_cert_span()   { score = score + 1 };
    if cp_cni_span_loss()   == 22 { score = score + 1 };

    // ── Section B: CNI margin spots (Finding B) ──────────────────────────────
    if cp_cni_margin_n7()  > 2.0  { score = score + 1 };
    if cp_cni_margin_n7()  > 2.8  { score = score + 1 };
    if cp_cni_margin_n7()  < 2.9  { score = score + 1 };
    if cp_cni_margin_n14() > 2.0  { score = score + 1 };
    if cp_cni_margin_n14() > 2.4  { score = score + 1 };
    if cp_cni_margin_n21() < 0.0  { score = score + 1 };
    if cp_cni_margin_n28() < 0.0  { score = score + 1 };

    // ── Section C: CNI peak (Finding C) ─────────────────────────────────────
    if cp_cni_n_peak()      == 10 { score = score + 1 };
    if cp_cni_margin_peak() > 4.0 { score = score + 1 };
    if cp_cni_margin_peak() > 4.4 { score = score + 1 };
    if cp_cni_margin_peak() < 5.0 { score = score + 1 };
    if cp_cni_n_peak() > cp_cni_n_crit()      { score = score + 1 };
    if cp_cni_n_peak() < cp_cni_n_last_cert() { score = score + 1 };
    if cp_cni_margin_peak() > cp_cni_margin_n7() { score = score + 1 };

    // ── Section D: CNI-free cert window (Finding D) ──────────────────────────
    if cp_free_n_crit()      == 25 { score = score + 1 };
    if cp_free_n_last_cert() == 36 { score = score + 1 };
    if cp_free_cert_span()   == 11 { score = score + 1 };
    if cp_free_n_last_cert() == cp_combined_n_last_cert() { score = score + 1 };
    if cp_free_n_crit()    > cp_combined_n_crit()    { score = score + 1 };
    if cp_free_cert_span() < cp_combined_cert_span() { score = score + 1 };
    if cp_free_span_loss()  == 19 { score = score + 1 };

    // ── Section E: CNI-free margin spots (Finding E) ─────────────────────────
    if cp_free_margin_n7()  < 0.0   { score = score + 1 };
    if cp_free_margin_n7()  < -6.0  { score = score + 1 };
    if cp_free_margin_n14() < 0.0   { score = score + 1 };
    if cp_free_margin_n14() < -2.0  { score = score + 1 };
    if cp_free_margin_n28() > 2.0   { score = score + 1 };
    if cp_free_margin_n28() > 3.0   { score = score + 1 };
    if cp_free_margin_n28() < 4.0   { score = score + 1 };

    // ── Section F: CNI-free peak (Finding F) ─────────────────────────────────
    if cp_free_n_peak()      == 30  { score = score + 1 };
    if cp_free_margin_peak() > 3.0  { score = score + 1 };
    if cp_free_margin_peak() > 3.8  { score = score + 1 };
    if cp_free_margin_peak() < 4.5  { score = score + 1 };
    if cp_free_n_peak() > cp_free_n_crit()      { score = score + 1 };
    if cp_free_n_peak() < cp_free_n_last_cert() { score = score + 1 };
    if cp_free_margin_peak() > cp_free_margin_n28() { score = score + 1 };

    // ── Section G: Span losses and sub-span arithmetic (Finding G) ───────────
    if cp_cni_span_loss()  > cp_free_span_loss()  { score = score + 1 };
    if cp_cni_cert_span()  < cp_free_cert_span()  { score = score + 1 };
    let sub_total = cp_cni_cert_span() + cp_free_cert_span()
    if sub_total == 19 { score = score + 1 };
    if sub_total < cp_combined_cert_span() { score = score + 1 };
    if cp_cni_span_loss() + cp_free_span_loss() > 40 { score = score + 1 };
    if cp_combined_cert_span() == 30 { score = score + 1 };
    if cp_combined_n_crit() == 6   { score = score + 1 };

    // ── Section H: Dead-zone gap between protocols (Finding D) ───────────────
    let dead_zone_start = cp_cni_n_last_cert() + 1
    let dead_zone_end   = cp_free_n_crit() - 1
    if dead_zone_start == 15 { score = score + 1 };
    if dead_zone_end   == 24 { score = score + 1 };
    let dead_zone_len  = dead_zone_end - dead_zone_start + 1
    if dead_zone_len   == 10 { score = score + 1 };
    if dead_zone_len   > 0   { score = score + 1 };
    if cp_cni_n_last_cert() < cp_free_n_crit() { score = score + 1 };
    if cp_free_n_crit() > cp_cni_n_last_cert() + 1 { score = score + 1 };
    if cp_cni_n_crit() < cp_free_n_crit()      { score = score + 1 };

    score
}
