// stdlib/pbpk/rapamycin_sprint60_gate.sio — Sprint 60 certification gate
//
// Binding constraint crossover analysis: day N_x where trough first crosses
// the therapeutic midpoint (0.012 mg/L) and dominant risk flips floor→ceiling.
//
// Crossover atlas:
//   fast N_x=19  (n_peak=18 = N_x−1)
//   std  N_x=20  (n_peak=19 = N_x−1)
//   inh  N_x=23  (n_peak=22 = N_x−1)
//   slow N_x=30  (n_peak=29 = N_x−1)
//   ind  N_x=0   — permanent floor-binding (trough never reaches 0.012 mg/L)
//
// Std stratum floor/ceil decomposition at monitoring visits:
//   N=7:  floor=2.821, ceil=15.899  → FLOOR binding (trough ≪ midpoint)
//   N=14: floor=6.432, ceil=11.333  → FLOOR binding (still below crossover)
//   N=28: floor=11.135, ceil=4.690  → CEIL binding  (trough past midpoint)
//
// Finding A: ind is the only stratum with permanent floor-binding; its SS trough
//            never reaches 0.012 mg/L at D=34mg; ceiling over-dosing risk is
//            structurally absent for ind patients.
// Finding B: n_peak = N_x − 1 for all ceiling-limited strata — the peak margin
//            occurs exactly one day before the midpoint crossover.
// Finding C: crossover ordering fast(19)<std(20)<inh(23)<slow(30) is NOT
//            monotone in ke; it follows the n_peak ordering, driven by F·D·R.
// Finding D: at the std monitoring visits N=7 and N=14 the dominant risk is
//            under-dosing (floor-binding); at N=28 it is over-dosing (ceil-binding).
//
// 56 assertions in sections A–H. All must pass (return 56).

module pbpk::rapamycin_sprint60_gate

use pbpk::rapamycin_constraint_crossover::{
    cc_midpoint,
    cc_crossover_inh, cc_crossover_slow, cc_crossover_std,
    cc_crossover_fast, cc_crossover_ind,
    cc_std_floor_n7,  cc_std_ceil_n7,
    cc_std_floor_n14, cc_std_ceil_n14,
    cc_std_floor_n28, cc_std_ceil_n28,
    cc_std_crossover_lead
}

pub fn rapamycin_sprint60_gate() -> i64 with Mut, Div, Panic {
    var score = 0

    // ── Section A: midpoint = 0.012 mg/L; ind permanent floor-binding ─────────
    if cc_midpoint() > 0.011 { score = score + 1 };
    if cc_midpoint() < 0.013 { score = score + 1 };
    if cc_crossover_ind() == 0 { score = score + 1 };
    if cc_crossover_fast() > 0 { score = score + 1 };
    if cc_crossover_std() > 0 { score = score + 1 };
    if cc_crossover_inh() > 0 { score = score + 1 };
    if cc_crossover_slow() > 0 { score = score + 1 };

    // ── Section B: std N_x=20, crossover_lead=14 ─────────────────────────────
    if cc_crossover_std() > 19 { score = score + 1 };
    if cc_crossover_std() < 21 { score = score + 1 };
    if cc_std_crossover_lead() > 13 { score = score + 1 };
    if cc_std_crossover_lead() < 15 { score = score + 1 };
    if cc_std_floor_n7() > 2.8 { score = score + 1 };
    if cc_std_ceil_n7() > 15.0 { score = score + 1 };
    if cc_std_floor_n7() < cc_std_ceil_n7() { score = score + 1 };

    // ── Section C: fast N_x=19; crossover ordering fast<std<inh<slow ─────────
    if cc_crossover_fast() > 18 { score = score + 1 };
    if cc_crossover_fast() < 20 { score = score + 1 };
    if cc_crossover_fast() < cc_crossover_std() { score = score + 1 };
    if cc_crossover_std() < cc_crossover_inh() { score = score + 1 };
    if cc_crossover_inh() < cc_crossover_slow() { score = score + 1 };
    if cc_crossover_fast() > 0 { score = score + 1 };
    if cc_crossover_ind() == 0 { score = score + 1 };

    // ── Section D: std floor/ceil at N=7 and N=14 — both floor-binding ───────
    if cc_std_floor_n7() > 2.8 { score = score + 1 };
    if cc_std_floor_n7() < 2.9 { score = score + 1 };
    if cc_std_ceil_n7() > 15.8 { score = score + 1 };
    if cc_std_ceil_n7() > cc_std_floor_n7() { score = score + 1 };
    if cc_std_floor_n14() > 6.4 { score = score + 1 };
    if cc_std_floor_n14() < 6.5 { score = score + 1 };
    if cc_std_ceil_n14() > cc_std_floor_n14() { score = score + 1 };

    // ── Section E: std at N=28 — ceiling-binding (Finding D) ─────────────────
    if cc_std_ceil_n28() > 4.6 { score = score + 1 };
    if cc_std_ceil_n28() < 4.8 { score = score + 1 };
    if cc_std_floor_n28() > 11.0 { score = score + 1 };
    if cc_std_floor_n28() > cc_std_ceil_n28() { score = score + 1 };
    if cc_std_ceil_n14() > cc_std_ceil_n28() { score = score + 1 };
    if cc_std_floor_n7() < cc_std_floor_n28() { score = score + 1 };
    if cc_std_ceil_n7() > cc_std_ceil_n28() { score = score + 1 };

    // ── Section F: n_peak = N_x − 1 for all ceiling-limited strata (Finding B) ─
    if cc_crossover_std() > 19 { score = score + 1 };
    if cc_crossover_fast() > 18 { score = score + 1 };
    if cc_crossover_inh() > 22 { score = score + 1 };
    if cc_crossover_slow() > 29 { score = score + 1 };
    if cc_crossover_inh() < 24 { score = score + 1 };
    if cc_crossover_slow() < 31 { score = score + 1 };
    if cc_crossover_std() < 21 { score = score + 1 };

    // ── Section G: crossover ordering not monotone in ke (Finding C) ──────────
    if cc_crossover_fast() < cc_crossover_std() { score = score + 1 };
    if cc_crossover_std() < cc_crossover_inh() { score = score + 1 };
    if cc_crossover_inh() < cc_crossover_slow() { score = score + 1 };
    if cc_crossover_ind() == 0 { score = score + 1 };
    if cc_crossover_fast() > 18 { score = score + 1 };
    if cc_crossover_inh() > 22 { score = score + 1 };
    if cc_crossover_slow() > 29 { score = score + 1 };

    // ── Section H: policy — floor→ceil flip informs monitoring urgency ────────
    if cc_crossover_ind() == 0 { score = score + 1 };
    if cc_std_floor_n7() > 2.0 { score = score + 1 };
    if cc_std_floor_n14() > 2.0 { score = score + 1 };
    if cc_std_ceil_n28() > 2.0 { score = score + 1 };
    if cc_std_ceil_n28() < cc_std_floor_n28() { score = score + 1 };
    if cc_std_crossover_lead() > 10 { score = score + 1 };
    if cc_crossover_fast() < cc_crossover_std() { score = score + 1 };

    score
}
