// stdlib/pbpk/rapamycin_sprint56_gate.sio — Sprint 56 certification gate
//
// Inhibitor stratum (ke=0.002236 h⁻¹, F=0.282) trajectory at standard D=1.5mg.
// Fourth and final trajectory analysis completing the five-stratum picture.
//
// Key trajectory values:
//   N=1:   -6.944 ALARM   N=3:  -2.176 ALARM   N=5:   +0.685 WARN
//   N=7:   +3.191 CERT    N=14: +9.757 CERT     N=21: +13.724 CERT
//   N=28:  +8.787 CERT    N=42: -0.021 ALARM    N=56:  -5.052 ALARM
//   n_crit=7, n_last_cert=37, n_peak=22, margin_peak=14.147, cert_span=30
//   ncrit_lead=6, peak_lag=15, margin_gain_n7_to_n56=-8.243
//
// Five-stratum trajectory comparison (S49/S52/S55/S56):
//   Slow (D=2.5mg):  n_crit=8,  n_last=58,  n_peak=29, peak=12.354, span=50
//   Inh  (D=1.5mg):  n_crit=7,  n_last=37,  n_peak=22, peak=14.147, span=30
//   Fast (D=9.5mg):  n_crit=7,  n_last=34,  n_peak=18, peak=5.469,  span=27
//   Ind  (D=34mg):   n_crit=26, n_last=120+, n_peak=120+, peak=2.78+, span=94+
//
// Finding A: n_crit=7 — inh certifies exactly at week-1 visit (same as fast);
//            6 ALARM/WARN days precede first certification.
// Finding B: ceiling binding — last cert N=37; N=42 margin=-0.021 (knife-edge);
//            cert window is 30 days driven by rapid accumulation (R≈19).
// Finding C: contrast with ind — opposite dynamics: ind near-SS by dose 6
//            (R≈1.35), GUM-limited; inh accumulates slowly (R≈19),
//            trough-accumulation limited; trajectories are mechanistic mirrors.
// Finding D: peak at N=22, margin=14.147 — highest peak of all five strata;
//            the inh trough is maximally centered at the optimal accumulation day.
//
// 56 assertions in sections A–H. All must pass (return 56).

module pbpk::rapamycin_sprint56_gate

use pbpk::rapamycin_inh_trajectory::{
    iht_margin_n1,  iht_margin_n3,  iht_margin_n5,
    iht_margin_n7,  iht_margin_n14, iht_margin_n21,
    iht_margin_n28, iht_margin_n42, iht_margin_n56,
    iht_margin_n84,
    iht_n_crit,     iht_n_last_cert, iht_n_peak,
    iht_margin_peak, iht_ncrit_lead,
    iht_cert_span,  iht_peak_lag,
    iht_margin_gain_n7_to_n56
}

pub fn rapamycin_sprint56_gate() -> i64 with Mut, Div, Panic {
    var score = 0

    // ── Section A: early deep ALARM → WARN transition (Finding A setup) ───────
    if iht_margin_n1() < 0.0 { score = score + 1 };
    if iht_margin_n1() < -6.0 { score = score + 1 };
    if iht_margin_n3() < 0.0 { score = score + 1 };
    if iht_margin_n3() > -3.0 { score = score + 1 };
    if iht_margin_n5() > 0.0 { score = score + 1 };
    if iht_margin_n5() < 2.0 { score = score + 1 };
    if iht_margin_n5() > 0.6 { score = score + 1 };

    // ── Section B: CERT exactly at week-1 visit (Finding A) ──────────────────
    if iht_n_crit() > 6 { score = score + 1 };
    if iht_n_crit() < 8 { score = score + 1 };
    if iht_ncrit_lead() > 5 { score = score + 1 };
    if iht_ncrit_lead() < 7 { score = score + 1 };
    if iht_margin_n7() >= 2.0 { score = score + 1 };
    if iht_margin_n7() > 3.1 { score = score + 1 };
    if iht_margin_n7() < 3.3 { score = score + 1 };

    // ── Section C: peak at N=22, margin=14.147 (Finding D) ───────────────────
    if iht_n_peak() > 21 { score = score + 1 };
    if iht_n_peak() < 23 { score = score + 1 };
    if iht_margin_peak() > 14.1 { score = score + 1 };
    if iht_margin_peak() < 14.2 { score = score + 1 };
    if iht_margin_n21() > 13.7 { score = score + 1 };
    if iht_margin_n21() < 13.8 { score = score + 1 };
    if iht_peak_lag() > 14 { score = score + 1 };

    // ── Section D: ceiling binding — last cert N=37, knife-edge at N=42 ───────
    if iht_n_last_cert() > 36 { score = score + 1 };
    if iht_n_last_cert() < 38 { score = score + 1 };
    if iht_cert_span() > 29 { score = score + 1 };
    if iht_cert_span() < 31 { score = score + 1 };
    if iht_margin_n42() < 0.0 { score = score + 1 };
    if iht_margin_n42() > -0.1 { score = score + 1 };
    if iht_margin_n56() < -5.0 { score = score + 1 };

    // ── Section E: unimodal trajectory — rise then monotone fall ─────────────
    if iht_margin_n7() > iht_margin_n5() { score = score + 1 };
    if iht_margin_n14() > iht_margin_n7() { score = score + 1 };
    if iht_margin_n21() > iht_margin_n14() { score = score + 1 };
    if iht_margin_n28() < iht_margin_n21() { score = score + 1 };
    if iht_margin_n42() < iht_margin_n28() { score = score + 1 };
    if iht_margin_n56() < iht_margin_n42() { score = score + 1 };
    if iht_margin_n84() < iht_margin_n56() { score = score + 1 };

    // ── Section F: all three standard monitoring visits certify ──────────────
    if iht_margin_n7()  >= 2.0 { score = score + 1 };
    if iht_margin_n14() >= 2.0 { score = score + 1 };
    if iht_margin_n28() >= 2.0 { score = score + 1 };
    if iht_margin_n14() > 9.7 { score = score + 1 };
    if iht_margin_n14() < 9.8 { score = score + 1 };
    if iht_margin_n28() > 8.7 { score = score + 1 };
    if iht_margin_n28() < 8.9 { score = score + 1 };

    // ── Section G: contrast with slow/ind strata (Finding C) ─────────────────
    if iht_n_crit() < 8 { score = score + 1 };
    if iht_n_last_cert() < 58 { score = score + 1 };
    if iht_n_peak() < 29 { score = score + 1 };
    if iht_cert_span() < 50 { score = score + 1 };
    if iht_margin_peak() > 12.354 { score = score + 1 };
    if iht_margin_gain_n7_to_n56() < 0.0 { score = score + 1 };
    if iht_margin_n56() < iht_margin_n7() - 5.0 { score = score + 1 };

    // ── Section H: policy — all 3 visits CERT; dose review urgent before N=42 ─
    if iht_margin_n7()  >= 2.0 { score = score + 1 };
    if iht_margin_n14() >= 2.0 { score = score + 1 };
    if iht_margin_n28() >= 2.0 { score = score + 1 };
    if iht_n_last_cert() < 42 { score = score + 1 };
    if iht_margin_n42() < 0.0 { score = score + 1 };
    if iht_margin_peak() > iht_margin_n28() { score = score + 1 };
    if iht_margin_n28() > iht_margin_n7() { score = score + 1 };

    score
}
