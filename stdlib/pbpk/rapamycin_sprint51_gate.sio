// stdlib/pbpk/rapamycin_sprint51_gate.sio — Sprint 51 certification gate
//
// Fast stratum (CYP3A4 ultra-rapid, ke=0.01677 h⁻¹, F=0.094) dose adjustment
// to achieve GUM certification at week-1 (N=7).
//
// Finding A: D=5mg → ALARM at N=7 (margin=-0.538); D=5.5mg still ALARM (-0.040).
// Finding B: N=7 cert boundary → D=9.5mg (first margin≥2.0 in 0.5mg steps = 9 steps).
// Finding C: N=28 ceiling safety → fast certifies at N=28 across full scan range
//            (near-SS by N=28; D=5.0→margin=5.131, D=10.0→margin=2.552, all CERT).
// Finding D: Feasible window [9.5, 10.0] mg — non-empty but narrow (0.5mg); both
//            dose points simultaneously certify fast at N=7 and maintain N=28 CERT.
//
// 56 assertions in sections A–H. All must pass (return 56).

module pbpk::rapamycin_sprint51_gate

use pbpk::rapamycin_fast_dose_adjust::{
    fda_margin_n7_d50,  fda_margin_n7_d55,  fda_margin_n7_d60,
    fda_margin_n7_d65,  fda_margin_n7_d70,  fda_margin_n7_d75,
    fda_margin_n7_d80,  fda_margin_n7_d85,  fda_margin_n7_d90,
    fda_margin_n7_d95,  fda_margin_n7_d100,
    fda_margin_n28_d50, fda_margin_n28_d70,
    fda_margin_n28_d90, fda_margin_n28_d100,
    fda_d_cert_n7_min,  fda_d_cert_n28_max,
    fda_d_optimal_n7,   fda_dose_gap_steps
}

pub fn rapamycin_sprint51_gate() -> i64 with Mut, Div, Panic {
    var score = 0

    // ── Section A: D=5mg ALARM at N=7 — fast sub-therapeutic at standard dose ──
    if fda_margin_n7_d50() < 0.0 { score = score + 1 };
    if fda_margin_n7_d50() > -1.0 { score = score + 1 };
    if fda_margin_n7_d50() > -0.55 { score = score + 1 };
    if fda_margin_n7_d50() < -0.53 { score = score + 1 };
    if fda_margin_n7_d55() < 0.0 { score = score + 1 };
    if fda_margin_n7_d55() > -0.05 { score = score + 1 };
    if fda_margin_n7_d55() < -0.03 { score = score + 1 };

    // ── Section B: dose-response at N=7 — monotone climb toward certification ──
    if fda_margin_n7_d60() > 0.0 { score = score + 1 };
    if fda_margin_n7_d60() > 0.37 { score = score + 1 };
    if fda_margin_n7_d60() < 0.38 { score = score + 1 };
    if fda_margin_n7_d70() > 1.02 { score = score + 1 };
    if fda_margin_n7_d80() > 1.51 { score = score + 1 };
    if fda_margin_n7_d90() > 1.89 { score = score + 1 };
    if fda_margin_n7_d90() < 2.0 { score = score + 1 };

    // ── Section C: N=7 cert boundary at D=9.5mg (Finding B) ──────────────────
    if fda_margin_n7_d95() >= 2.0 { score = score + 1 };
    if fda_margin_n7_d95() > 2.05 { score = score + 1 };
    if fda_margin_n7_d95() < 2.07 { score = score + 1 };
    if fda_d_cert_n7_min() > 9.4 { score = score + 1 };
    if fda_d_cert_n7_min() < 9.6 { score = score + 1 };
    if fda_margin_n7_d100() > 2.20 { score = score + 1 };
    if fda_margin_n7_d100() > fda_margin_n7_d95() { score = score + 1 };

    // ── Section D: N=28 ceiling safety — CERT throughout scan (Finding C) ──────
    if fda_margin_n28_d50() > 2.0 { score = score + 1 };
    if fda_margin_n28_d50() > 5.1 { score = score + 1 };
    if fda_margin_n28_d70() > 6.5 { score = score + 1 };
    if fda_margin_n28_d90() > 3.9 { score = score + 1 };
    if fda_margin_n28_d100() > 2.5 { score = score + 1 };
    if fda_margin_n28_d100() < 2.6 { score = score + 1 };
    if fda_d_cert_n28_max() > 9.9 { score = score + 1 };

    // ── Section E: feasible window [9.5, 10.0] mg non-empty (Finding D) ─────
    if fda_d_cert_n28_max() > 9.9 { score = score + 1 };
    if fda_d_cert_n28_max() < 10.1 { score = score + 1 };
    if fda_d_cert_n7_min() < fda_d_cert_n28_max() + 0.1 { score = score + 1 };
    if fda_d_cert_n28_max() - fda_d_cert_n7_min() > 0.4 { score = score + 1 };
    if fda_d_cert_n28_max() - fda_d_cert_n7_min() < 0.6 { score = score + 1 };
    if fda_margin_n7_d100() >= 2.0 { score = score + 1 };
    if fda_margin_n28_d100() >= 2.0 { score = score + 1 };

    // ── Section F: dose gap — 9 steps (4.5mg) from standard (gap analysis) ────
    if fda_dose_gap_steps() > 8 { score = score + 1 };
    if fda_dose_gap_steps() < 10 { score = score + 1 };
    if fda_d_cert_n7_min() - 5.0 > 4.4 { score = score + 1 };
    if fda_d_cert_n7_min() - 5.0 < 4.6 { score = score + 1 };
    if fda_d_cert_n7_min() > 9.0 { score = score + 1 };
    if fda_margin_n7_d90() < 2.0 { score = score + 1 };
    if fda_margin_n7_d95() >= 2.0 { score = score + 1 };

    // ── Section G: monotone dose-response structure at N=7 ───────────────────
    if fda_margin_n7_d55() > fda_margin_n7_d50() { score = score + 1 };
    if fda_margin_n7_d60() > fda_margin_n7_d55() { score = score + 1 };
    if fda_margin_n7_d70() > fda_margin_n7_d65() { score = score + 1 };
    if fda_margin_n7_d80() > fda_margin_n7_d70() { score = score + 1 };
    if fda_margin_n7_d90() > fda_margin_n7_d80() { score = score + 1 };
    if fda_margin_n7_d95() > fda_margin_n7_d90() { score = score + 1 };
    if fda_margin_n7_d100() > fda_margin_n7_d95() { score = score + 1 };

    // ── Section H: policy — large-gap, narrow-window, floor-limited problem ───
    if fda_margin_n28_d50() > 5.0 { score = score + 1 };
    if fda_margin_n28_d70() > fda_margin_n28_d90() { score = score + 1 };
    if fda_d_cert_n28_max() - fda_d_cert_n7_min() < 1.0 { score = score + 1 };
    if fda_d_cert_n28_max() - fda_d_cert_n7_min() > 0.4 { score = score + 1 };
    if fda_d_optimal_n7() > 11.9 { score = score + 1 };
    if fda_margin_n28_d50() > fda_margin_n7_d50() + 5.5 { score = score + 1 };
    if fda_d_cert_n7_min() - fda_d_cert_n28_max() < 0.0 { score = score + 1 };

    score
}
