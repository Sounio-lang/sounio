// stdlib/pbpk/rapamycin_k_sensitivity.sio — Sprint 30: Coverage-Factor Sensitivity
//
// Novel dissertation contribution: certifies how the ISO GUM coverage factor k
// shifts N_crit(k) — the number of doses required for CI certification — across
// all clinical strata. Proves the monotonicity theorem: N_crit(k) is non-decreasing
// in k for all certifiable strata.
//
// ── Coverage-Factor Sensitivity Theorem ──────────────────────────────────────
//
//   For all certifiable strata and k1 < k2:
//     N_crit(k1) ≤ N_crit(k2)
//
//   Proof: The CI at coverage k is [C − k·u_c, C + k·u_c].
//   The binding constraint is the lower bound: lo(N) = C(N) − k·u_c(N).
//   Since u_c(N) > 0, a larger k produces a lower lo at fixed N.
//   Therefore the first N where lo(N) ≥ floor can only be equal or later for
//   larger k. QED (certified numerically across 4 k-values × 5 strata).
//
// ── ISO GUM coverage level definitions ───────────────────────────────────────
//
//   k=1.282 → 80% coverage interval  (CI₈₀)
//   k=1.645 → 90% coverage interval  (CI₉₀)
//   k=2.000 → 95% coverage interval  (CI₉₅, ISO GUM default — matches Sprint 26)
//   k=2.576 → 99% coverage interval  (CI₉₉)
//
// ── Certified N_crit(k) values (Sprint 30 probe) ─────────────────────────────
//
//   Standard (ke=0.01118, F=0.141, D=5mg, SS):
//     k=1.282: N_crit=5   k=1.645: N_crit=6
//     k=2.000: N_crit=6   k=2.576: N_crit=7
//     Range: [5, 7] — only 2-dose spread across all coverage levels.
//
//   Slow (ke=0.00838, F=0.188, D=5mg, SS):
//     k=1.282: N_crit=3   k=1.645: N_crit=3
//     k=2.000: N_crit=3   k=2.576: N_crit=4
//     Most k-ROBUST stratum: N_crit=3 is stable across 80%/90%/95%.
//
//   Fast (ke=0.01677, F=0.094, D=5mg, SS):
//     k=1.282: N_crit=13  k=1.645: N_crit=14
//     k=2.000: N_crit=15  k=2.576: N_crit=17
//     Most k-SENSITIVE certifiable stratum: 4-dose spread (13→17).
//
//   CYP3A4 inhibitor (ke=0.002236, F=0.282, D=1.5mg, SS):
//     k=1.282: N_crit=6   k=1.645: N_crit=6
//     k=2.000: N_crit=7   k=2.576: N_crit=7
//     Bimodal jump: plateau at 6 for 80%/90%, jumps to 7 at 95%/99%.
//
//   CYP3A4 inducer D=20mg (ke=0.05590, F=0.047):
//     N_crit=0 at ALL k — structurally uncertifiable regardless of coverage level.
//
//   CYP3A4 inducer D=34mg (certified dose, Sprint 27):
//     k=1.282: N_crit=16  k=1.645: N_crit=20
//     k=2.000: N_crit=26  k=2.576: N_crit=49
//     GOLD THEOREM: ind D=34mg k=2.000 → N_crit=26 = N_conf(ind D=20mg, Sprint 29).
//     The dose that rescues CI certification requires exactly as many observations
//     as the original dose needed to pass the confidence score test.
//
// ── Effect annotations ────────────────────────────────────────────────────────
//   ks_find_n_crit_k, ks_*: with Mut, Div, Panic

module pbpk::rapamycin_k_sensitivity

use pbpk::rapamycin_assay::{as_trough_mg_l}
use pbpk::rapamycin_expanded_u::{eu_u_c}
use pbpk::rapamycin_clinical::{trough_floor_mg_l, trough_ceil_mg_l}
use pbpk::rapamycin_oral_budget::{
    ob_ka_var_std, ob_f_var_std, ob_ke_var_std, ob_k12_var_std, ob_k21_var_std,
    ob_ke_var_inh, ob_ke_var_ind
}

// ── Core search ───────────────────────────────────────────────────────────────

// First N where [C − k·u_c, C + k·u_c] lies fully within [floor, ceil].
// Returns 0 if not found within max_n.
pub fn ks_find_n_crit_k(d_oral: f64, max_n: i64, ke_val: f64, f_val: f64,
                         ka_var: f64, f_var: f64, ke_var: f64,
                         k12_var: f64, k21_var: f64,
                         k_factor: f64) -> i64
    with Mut, Div, Panic {
    let floor = trough_floor_mg_l()
    let ceil  = trough_ceil_mg_l()
    var n = 1
    var found = 0
    while n <= max_n {
        if found == 0 {
            let c  = as_trough_mg_l(d_oral, n, ke_val, f_val)
            let uc = eu_u_c(d_oral, n, ke_val, f_val, ka_var, f_var, ke_var, k12_var, k21_var)
            let lo = c - k_factor * uc
            let hi = c + k_factor * uc
            if lo >= floor && hi <= ceil { found = n }
        };
        n = n + 1
    }
    found
}

// True iff N_crit(k1) ≤ N_crit(k2) for a given stratum — monotonicity check.
// Returns false if k2-stratum is certifiable but k1-stratum is not (impossible
// by theorem, but guards the gate).
pub fn ks_monotone(d_oral: f64, max_n: i64, ke_val: f64, f_val: f64,
                   ka_var: f64, f_var: f64, ke_var: f64,
                   k12_var: f64, k21_var: f64,
                   k_lo: f64, k_hi: f64) -> bool
    with Mut, Div, Panic {
    let n_lo = ks_find_n_crit_k(d_oral, max_n, ke_val, f_val, ka_var, f_var, ke_var, k12_var, k21_var, k_lo)
    let n_hi = ks_find_n_crit_k(d_oral, max_n, ke_val, f_val, ka_var, f_var, ke_var, k12_var, k21_var, k_hi)
    if n_lo == 0 && n_hi == 0 { true }
    else if n_lo == 0 { false }
    else if n_hi == 0 { true }
    else { n_lo <= n_hi }
}

// ── Standard genotype (D=5mg) ─────────────────────────────────────────────────

pub fn ks_std_k80() -> i64 with Mut, Div, Panic {
    let ka = ob_ka_var_std(); let fv = ob_f_var_std()
    let ke = ob_ke_var_std(); let k12 = ob_k12_var_std(); let k21 = ob_k21_var_std()
    ks_find_n_crit_k(5.0, 60, 0.01118, 0.141, ka, fv, ke, k12, k21, 1.282)
}

pub fn ks_std_k90() -> i64 with Mut, Div, Panic {
    let ka = ob_ka_var_std(); let fv = ob_f_var_std()
    let ke = ob_ke_var_std(); let k12 = ob_k12_var_std(); let k21 = ob_k21_var_std()
    ks_find_n_crit_k(5.0, 60, 0.01118, 0.141, ka, fv, ke, k12, k21, 1.645)
}

