// stdlib/pbpk/rapamycin_sprint68_gate.sio — Sprint 68 certification gate
//
// 56 assertions across 8 sections verifying ka_var sensitivity findings.
// All values probe-verified from rapamycin_ka_sensitivity.sio.
//
// Sections:
//   A: u_c values and GUM budget ratios at N=7
//   B: Margins at N=7 (all CERT, monotone increasing)
//   C: Margins at N=1 (all ALARM, monotone MORE negative — alarm sharpening)
//   D: Certification windows (ncrit/nlast/span per level)
//   E: Marginal advances per ka halving
//   F: Dead band — L1 == L2 in ncrit and span
//   G: Span gains and total cert window expansion
//   H: Cross-comparisons and GUM budget internal consistency
//
// All 56 assertions must pass (return 56).

module pbpk::rapamycin_sprint68_gate

use pbpk::rapamycin_ka_sensitivity::{
    ks_uc_l0_n7, ks_uc_l1_n7, ks_uc_l2_n7, ks_uc_l3_n7,
    ks_uc_ratio_l1_l0, ks_uc_ratio_l3_l0,
    ks_margin_l0_n7, ks_margin_l1_n7, ks_margin_l2_n7, ks_margin_l3_n7,
    ks_margin_l0_n1, ks_margin_l1_n1, ks_margin_l2_n1, ks_margin_l3_n1,
    ks_ncrit_l0, ks_ncrit_l1, ks_ncrit_l2, ks_ncrit_l3,
    ks_nlast_l0, ks_nlast_l1, ks_nlast_l2, ks_nlast_l3,
    ks_span_l0, ks_span_l1, ks_span_l2, ks_span_l3,
    ks_advance_l0_to_l1, ks_advance_l1_to_l2, ks_advance_l2_to_l3, ks_total_advance,
    ks_span_gain_l0_to_l1, ks_span_gain_l0_to_l3
}

pub fn rapamycin_sprint68_gate() -> i64 with Mut, Div, Panic {
    var score = 0

    // ── Section A: u_c at N=7 and GUM budget ratios (Finding F) ─────────────
    if ks_uc_l0_n7() > 0.000850 { score = score + 1 };
    if ks_uc_l0_n7() < 0.000860 { score = score + 1 };
    if ks_uc_l1_n7() > 0.000650 { score = score + 1 };
    if ks_uc_l1_n7() < 0.000665 { score = score + 1 };
    if ks_uc_l2_n7() > 0.000525 { score = score + 1 };
    if ks_uc_l2_n7() < 0.000540 { score = score + 1 };
    if ks_uc_l3_n7() > 0.000360 { score = score + 1 };

    // ── Section B: Margins at N=7 — all CERT, monotone increasing ────────────
    if ks_margin_l0_n7() > 2.0  { score = score + 1 };
    if ks_margin_l0_n7() > 2.8  { score = score + 1 };
    if ks_margin_l0_n7() < 2.9  { score = score + 1 };
    if ks_margin_l1_n7() > 3.6  { score = score + 1 };
    if ks_margin_l1_n7() < 3.8  { score = score + 1 };
    if ks_margin_l2_n7() > 4.4  { score = score + 1 };
    if ks_margin_l3_n7() > 6.0  { score = score + 1 };

    // ── Section C: Margins at N=1 — all ALARM, alarm sharpening (Finding E) ──
    if ks_margin_l0_n1() < 0.0  { score = score + 1 };
    if ks_margin_l1_n1() < 0.0  { score = score + 1 };
    if ks_margin_l2_n1() < 0.0  { score = score + 1 };
    if ks_margin_l3_n1() < 0.0  { score = score + 1 };
    if ks_margin_l0_n1() > -2.0 { score = score + 1 };
    if ks_margin_l3_n1() < -4.5 { score = score + 1 };
    if ks_margin_l3_n1() < ks_margin_l0_n1() { score = score + 1 };

    // ── Section D: Certification windows ─────────────────────────────────────
    if ks_ncrit_l0() == 6 { score = score + 1 };
    if ks_ncrit_l1() == 5 { score = score + 1 };
    if ks_ncrit_l2() == 5 { score = score + 1 };
    if ks_ncrit_l3() == 4 { score = score + 1 };
    if ks_nlast_l0() == 36 { score = score + 1 };
    if ks_span_l0()  == 30 { score = score + 1 };
    if ks_span_l3()  == 34 { score = score + 1 };

    // ── Section E: Marginal advances per ka halving ───────────────────────────
    if ks_advance_l0_to_l1() == 1 { score = score + 1 };
    if ks_advance_l1_to_l2() == 0 { score = score + 1 };
    if ks_advance_l2_to_l3() == 1 { score = score + 1 };
    if ks_total_advance()    == 2 { score = score + 1 };
    if ks_advance_l0_to_l1() > 0 { score = score + 1 };
    if ks_advance_l1_to_l2() == 0 { score = score + 1 };
    if ks_total_advance() < 3 { score = score + 1 };

    // ── Section F: Dead band — L1 equals L2 in ncrit and span (Finding D) ────
    if ks_ncrit_l1() == ks_ncrit_l2() { score = score + 1 };
    if ks_span_l1()  == ks_span_l2()  { score = score + 1 };
    if ks_nlast_l1() == ks_nlast_l2() { score = score + 1 };
    if ks_span_l1()  == 32 { score = score + 1 };
    if ks_advance_l1_to_l2() == 0 { score = score + 1 };
    if ks_ncrit_l0() > ks_ncrit_l1() { score = score + 1 };
    if ks_ncrit_l1() > ks_ncrit_l3() { score = score + 1 };

    // ── Section G: Span gains (Finding B) ────────────────────────────────────
    if ks_span_gain_l0_to_l1() == 2 { score = score + 1 };
    if ks_span_gain_l0_to_l3() == 4 { score = score + 1 };
    if ks_span_l3() > ks_span_l0() { score = score + 1 };
    if ks_span_l1() > ks_span_l0() { score = score + 1 };
    if ks_nlast_l3() > ks_nlast_l0() { score = score + 1 };
    if ks_span_gain_l0_to_l3() < 5 { score = score + 1 };
    if ks_span_l0() == 30 { score = score + 1 };

    // ── Section H: GUM ratios and cross-sprint consistency (Findings F/G) ────
    if ks_uc_ratio_l1_l0() > 0.76 { score = score + 1 };
    if ks_uc_ratio_l1_l0() < 0.78 { score = score + 1 };
    if ks_uc_ratio_l3_l0() > 0.42 { score = score + 1 };
    if ks_uc_ratio_l3_l0() < 0.44 { score = score + 1 };
    if ks_uc_ratio_l3_l0() < ks_uc_ratio_l1_l0() { score = score + 1 };
    if ks_total_advance() == 2 { score = score + 1 };
    if ks_margin_l3_n7() > ks_margin_l0_n7() { score = score + 1 };

    score
}
