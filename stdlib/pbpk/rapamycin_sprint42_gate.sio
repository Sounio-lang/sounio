// stdlib/pbpk/rapamycin_sprint42_gate.sio — Sprint 42 certification gate
//
// Certifies scheduled monitoring protocol evaluation: fast sub-therapeutic
// at week-1 (Z_floor=-0.538), slow certified at week-2 then overtly toxic
// at month-1 (between-visit toxicity at N=23), ind just-certifies at month-1
// (m=2.103), inh exceptional ceiling margin (Z_ceil=40.9 at N=7).
//
// 56 assertions in sections A–H. All must pass (return 56).

module pbpk::rapamycin_sprint42_gate

use pbpk::rapamycin_monitoring_protocol::{
    mp_std_margin_n7, mp_std_margin_n14, mp_std_margin_n28,
    mp_std_cert_n7, mp_std_cert_n14, mp_std_cert_n28,
    mp_slow_margin_n7, mp_slow_margin_n14, mp_slow_margin_n28,
    mp_slow_cert_n7, mp_slow_cert_n14, mp_slow_cert_n28,
    mp_slow_zfloor_n14, mp_slow_zceil_n14, mp_slow_zceil_n28,
    mp_fast_margin_n7, mp_fast_margin_n14, mp_fast_margin_n28,
    mp_fast_cert_n7, mp_fast_cert_n14, mp_fast_cert_n28,
    mp_fast_zceil_n7, mp_fast_zceil_n14,
    mp_inh_margin_n7, mp_inh_margin_n14, mp_inh_margin_n28,
    mp_inh_cert_n7, mp_inh_cert_n14, mp_inh_cert_n28,
    mp_inh_zceil_n7, mp_inh_zceil_n14, mp_inh_zceil_n28,
    mp_ind_margin_n7, mp_ind_margin_n14, mp_ind_margin_n28,
    mp_ind_cert_n7, mp_ind_cert_n14, mp_ind_cert_n28,
    mp_ind_zceil_n28
}

pub fn rapamycin_sprint42_gate() -> i64 with Mut, Div, Panic {
    var score = 0

    // ── Section A: week-1 (N=7) certification status ──────────────────────────
    // std: CERT (2.821); slow: CERT (5.645); fast: SUB (-0.538); inh: CERT (3.210);
    // ind: UNCERT(floor) (0.289)
    if mp_std_cert_n7() { score = score + 1 };
    if mp_fast_margin_n7() < 0.0 { score = score + 1 };
    if mp_slow_cert_n7() { score = score + 1 };
    if mp_inh_cert_n7() { score = score + 1 };
    if mp_ind_margin_n7() > 0.0 && mp_ind_margin_n7() < 2.0 { score = score + 1 };
    // Slow margin decreases N=7→14 (ceiling approach tightens margin)
    if mp_slow_margin_n7() > mp_slow_margin_n14() { score = score + 1 };
    // Slow more certain than std at week-1 (faster accumulation)
    if mp_slow_margin_n7() > mp_std_margin_n7() { score = score + 1 };

    // ── Section B: week-2 (N=14) certification status ────────────────────────
    // std: CERT (6.432); slow: CERT (5.315); fast: UNCERT (1.844); inh: CERT (9.846);
    // ind: UNCERT (1.174)
    if mp_std_cert_n14() { score = score + 1 };
    if mp_slow_cert_n14() { score = score + 1 };
    if mp_fast_margin_n14() > 1.0 && mp_fast_margin_n14() < 2.0 { score = score + 1 };
    if mp_inh_cert_n14() { score = score + 1 };
    if mp_ind_margin_n14() > 1.0 && mp_ind_margin_n14() < 2.0 { score = score + 1 };
    // Both fast and ind margins increase monotonically toward certification
    if mp_fast_margin_n14() > mp_fast_margin_n7() { score = score + 1 };
    if mp_ind_margin_n14() > mp_ind_margin_n7() { score = score + 1 };

    // ── Section C: month-1 (N=28) certification status ───────────────────────
    // std: CERT (4.690); slow: TOX (-2.536); fast: CERT (5.131); inh: CERT (8.890);
    // ind: CERT (2.103, just certified)
    if mp_std_cert_n28() { score = score + 1 };
    if mp_slow_margin_n28() < -2.0 { score = score + 1 };
    if mp_fast_cert_n28() { score = score + 1 };
    if mp_inh_cert_n28() { score = score + 1 };
    if mp_ind_margin_n28() > 2.0 && mp_ind_margin_n28() < 2.5 { score = score + 1 };
    if mp_ind_cert_n28() { score = score + 1 };
    // Slow at N=28 worse than fast at N=7 (toxic vs sub-therapeutic)
    if mp_slow_margin_n28() < mp_fast_margin_n7() { score = score + 1 };

    // ── Section D: FINDING A — fast sub-therapeutic at early visits ───────────
    // fast: Z_floor(N=7)=-0.538; uncertified N=14 (1.844); certified N=28 (5.131)
    if mp_fast_zceil_n7() > mp_fast_zceil_n14() { score = score + 1 };
    if mp_fast_margin_n14() < 2.0 { score = score + 1 };
    if mp_fast_margin_n28() > 5.0 { score = score + 1 };
    if mp_fast_margin_n28() > mp_fast_margin_n14() { score = score + 1 };
    // Ceiling completely irrelevant for fast at week-1 (Z_ceil > 20)
    if mp_fast_zceil_n7() > 20.0 { score = score + 1 };
    if mp_fast_margin_n7() < mp_fast_margin_n14() { score = score + 1 };
    if mp_fast_margin_n14() < mp_fast_margin_n28() { score = score + 1 };

    // ── Section E: FINDING B — slow toxicity between N=14 and N=28 visits ────
    // N=14: certified (m=5.315, Z_floor=10.106, Z_ceil=5.315)
    // N=28: overtly toxic (Z_ceil=-2.536, C=0.023 > ceil=0.020)
    if mp_slow_margin_n14() > 5.0 { score = score + 1 };
    if mp_slow_zceil_n28() < -2.0 { score = score + 1 };
    if mp_slow_cert_n14() { score = score + 1 };
    // Floor is very safe at week-2 (Z_floor=10.106) while ceiling closes
    if mp_slow_zfloor_n14() > 10.0 { score = score + 1 };
    // Ceiling drop from N=14 to N=28 exceeds 7σ (5.315→-2.536 = 7.851 drop)
    if mp_slow_zceil_n14() - mp_slow_zceil_n28() > 7.0 { score = score + 1 };
    if mp_slow_margin_n14() > mp_slow_margin_n28() { score = score + 1 };
    if mp_slow_margin_n7() > mp_slow_margin_n28() { score = score + 1 };

    // ── Section F: FINDING C — ind just-certifies at month-1 ─────────────────
    // Monotone approach: 0.289 → 1.174 → 2.103; floor binding throughout
    if mp_ind_margin_n7() > 0.0 && mp_ind_margin_n7() < 1.0 { score = score + 1 };
    if mp_ind_margin_n14() > 1.0 && mp_ind_margin_n14() < 2.0 { score = score + 1 };
    // Ceiling not binding for ind at month-1 (Z_ceil=5.949)
    if mp_ind_zceil_n28() > 5.0 { score = score + 1 };
    if mp_ind_margin_n28() > mp_ind_margin_n14() { score = score + 1 };
    if mp_ind_margin_n14() > mp_ind_margin_n7() { score = score + 1 };
    // Just barely certified at month-1 (2.103 < 2.5)
    if mp_ind_margin_n28() < 2.5 { score = score + 1 };
    // Slow convergence: <1σ gain per 14-dose interval at this phase
    if mp_ind_margin_n28() - mp_ind_margin_n14() < 2.0 { score = score + 1 };

    // ── Section G: FINDING D — inh exceptional ceiling margin ────────────────
    // Z_ceil at N=7: 40.896; N=14: 26.503; N=28: 8.890 (decreasing but vast)
    if mp_inh_zceil_n7() > 40.0 { score = score + 1 };
    if mp_inh_margin_n7() > 3.0 { score = score + 1 };
    if mp_inh_margin_n14() > 9.0 { score = score + 1 };
    if mp_inh_margin_n28() > 8.0 { score = score + 1 };
    // Ceiling margin decreases as trough accumulates toward SS, still enormous
    if mp_inh_zceil_n7() > mp_inh_zceil_n14() { score = score + 1 };
    if mp_inh_zceil_n14() > mp_inh_zceil_n28() { score = score + 1 };
    // Floor-driven certification: margin increases N=7→14 (floor binding)
    if mp_inh_margin_n7() < mp_inh_margin_n14() { score = score + 1 };

    // ── Section H: cross-stratum comparisons ─────────────────────────────────
    // std margin increases N=7→14 (both floor and ceil safe throughout)
    if mp_std_margin_n14() > mp_slow_margin_n14() { score = score + 1 };
    // fast at month-1 exceeds ind at month-1 despite later certification
    if mp_fast_margin_n28() > mp_ind_margin_n28() { score = score + 1 };
    // inh margin at week-2 vastly exceeds ind (9.846 vs 1.174)
    if mp_inh_margin_n14() > mp_ind_margin_n14() { score = score + 1 };
    // Slow reversal: highest margin at week-1, then toxic by month-1
    if mp_slow_margin_n28() < mp_slow_margin_n7() { score = score + 1 };
    // std safer than ind at month-1 (4.690 > 2.103)
    if mp_std_margin_n28() > mp_ind_margin_n28() { score = score + 1 };
    // inh margin at week-1 exceeds std margin at week-1 (3.210 > 2.821)
    if mp_inh_margin_n7() > mp_std_margin_n7() { score = score + 1 };
    // fast margin at month-1 exceeds std margin at month-1 (5.131 > 4.690)
    if mp_fast_margin_n28() > mp_std_margin_n28() { score = score + 1 };

    score
}
