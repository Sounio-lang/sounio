// stdlib/pbpk/rapamycin_sprint55_gate.sio — Sprint 55 certification gate
//
// Inducer stratum (ke=0.05590 h⁻¹, F=0.047) trajectory at standard D=34mg.
// Third in the trajectory trilogy: S49 (slow, D=2.5mg), S52 (fast, D=9.5mg),
// S55 (ind, D=34mg).
//
// Key trajectory values:
//   N=1:  -0.925 ALARM   N=5:  -0.045 ALARM (barely)
//   N=7:  +0.290 WARN    N=10: +0.720 WARN
//   N=14: +1.179 WARN    N=21: +1.750 WARN
//   N=28: +2.117 CERT    N=42: +2.506 CERT    N=56: +2.669 CERT
//   n_crit=26, n_last_cert=120+, n_peak=120+ (ceiling never binding)
//   ncrit_beyond_n7=19, cert_span=94+, peak_lag=94+
//   margin_gain N=7→N=28 = 1.827
//
// Finding A: n_crit=26 — ind certifies at day 26, which lies between the
//            week-2 (N=14) and month-1 (N=28) standard visits; month-1 is
//            the first standard visit where ind certifies.
// Finding B: GUM precision drives certification — near-SS is reached by ~N=6
//            (ke=0.05590, R≈1.35); the margin_gain of 1.827 from N=7 to N=28
//            is almost entirely u_c contraction, not trough change.
// Finding C: long certified tail — margin monotonically rises throughout the
//            120-day scan; ceiling never binds at D=34mg; ind certifies
//            indefinitely once past n_crit=26.
// Finding D: visit schedule implication — week-1 and week-2 visits are
//            epistemically too early for the inducer stratum; month-1 (N=28)
//            is the earliest certifying standard visit.
//
// 56 assertions in sections A–H. All must pass (return 56).

module pbpk::rapamycin_sprint55_gate

use pbpk::rapamycin_ind_trajectory::{
    it_margin_n1,  it_margin_n3,  it_margin_n5,
    it_margin_n7,  it_margin_n10, it_margin_n14,
    it_margin_n21, it_margin_n28, it_margin_n42, it_margin_n56,
    it_n_crit,     it_n_last_cert, it_n_peak,
    it_margin_peak, it_ncrit_beyond_n7,
    it_cert_span,  it_peak_lag,
    it_margin_gain_n7_to_n28
}

pub fn rapamycin_sprint55_gate() -> i64 with Mut, Div, Panic {
    var score = 0

    // ── Section A: early ALARM → WARN transition at N=7 ──────────────────────
    if it_margin_n1() < 0.0 { score = score + 1 };
    if it_margin_n3() < 0.0 { score = score + 1 };
    if it_margin_n5() < 0.0 { score = score + 1 };
    if it_margin_n5() > -0.1 { score = score + 1 };
    if it_margin_n7() > 0.0 { score = score + 1 };
    if it_margin_n7() > 0.28 { score = score + 1 };
    if it_margin_n7() < 0.31 { score = score + 1 };

    // ── Section B: sub-cert trajectory through standard monitoring visits ─────
    if it_margin_n7()  < 2.0 { score = score + 1 };
    if it_margin_n14() < 2.0 { score = score + 1 };
    if it_margin_n14() > it_margin_n7() { score = score + 1 };
    if it_margin_n14() > 1.17 { score = score + 1 };
    if it_margin_n14() < 1.19 { score = score + 1 };
    if it_margin_n21() < 2.0 { score = score + 1 };
    if it_margin_n21() > 1.74 { score = score + 1 };

    // ── Section C: n_crit=26 — certifies between week-2 and month-1 (Find A) ─
    if it_n_crit() > 25 { score = score + 1 };
    if it_n_crit() < 27 { score = score + 1 };
    if it_ncrit_beyond_n7() > 18 { score = score + 1 };
    if it_ncrit_beyond_n7() < 20 { score = score + 1 };
    if it_margin_n28() >= 2.0 { score = score + 1 };
    if it_margin_n28() > 2.11 { score = score + 1 };
    if it_margin_n28() < 2.13 { score = score + 1 };

    // ── Section D: GUM precision drives margin gain N=7→N=28 (Finding B) ─────
    if it_margin_gain_n7_to_n28() > 1.8 { score = score + 1 };
    if it_margin_gain_n7_to_n28() < 1.9 { score = score + 1 };
    if it_margin_n14() > it_margin_n7() + 0.8 { score = score + 1 };
    if it_margin_n21() > it_margin_n14() + 0.5 { score = score + 1 };
    if it_margin_n28() > it_margin_n21() + 0.3 { score = score + 1 };
    if it_margin_n7() < it_margin_n28() * 0.2 { score = score + 1 };
    if it_margin_n28() > it_margin_n7() + 1.8 { score = score + 1 };

    // ── Section E: long certified tail — ceiling never binds (Finding C) ──────
    if it_n_last_cert() > 119 { score = score + 1 };
    if it_margin_n42() >= 2.0 { score = score + 1 };
    if it_margin_n56() >= 2.0 { score = score + 1 };
    if it_margin_n56() > it_margin_n42() { score = score + 1 };
    if it_cert_span() > 90 { score = score + 1 };
    if it_margin_n42() > 2.5 { score = score + 1 };
    if it_margin_n56() > 2.6 { score = score + 1 };

    // ── Section F: peak beyond scan range — monotone precision-driven rise ────
    if it_n_peak() > 119 { score = score + 1 };
    if it_margin_peak() > 2.78 { score = score + 1 };
    if it_peak_lag() > 90 { score = score + 1 };
    if it_margin_n56() > it_margin_n28() { score = score + 1 };
    if it_margin_n42() > it_margin_n28() { score = score + 1 };
    if it_margin_n56() > it_margin_n42() { score = score + 1 };
    if it_margin_peak() > 2.0 { score = score + 1 };

    // ── Section G: month-1 is first certifying standard visit (Finding D) ─────
    if it_n_crit() > 14 { score = score + 1 };
    if it_n_crit() < 28 { score = score + 1 };
    if it_margin_n7()  < 2.0 { score = score + 1 };
    if it_margin_n14() < 2.0 { score = score + 1 };
    if it_margin_n28() >= 2.0 { score = score + 1 };
    if it_ncrit_beyond_n7() > 14 { score = score + 1 };
    if it_ncrit_beyond_n7() < 28 { score = score + 1 };

    // ── Section H: trajectory shape and magnitude ─────────────────────────────
    if it_margin_n3() < 0.0 { score = score + 1 };
    if it_margin_n7() > 0.0 { score = score + 1 };
    if it_margin_n7() < 2.0 { score = score + 1 };
    if it_margin_n28() >= 2.0 { score = score + 1 };
    if it_margin_n56() > it_margin_n7() + 2.3 { score = score + 1 };
    if it_margin_n5() < it_margin_n7() { score = score + 1 };
    if it_margin_n10() > it_margin_n7() { score = score + 1 };

    score
}
