// stdlib/pbpk/rapamycin_ind_dose_adjust.sio — Sprint 54
//
// GUM dose analysis for the inducer stratum (strong CYP3A4 inducer,
// ke=0.05590 h⁻¹, F=0.047, standard D=34mg, w=0.10).
// Third in the pharmacogenomic dose-adjustment trilogy:
//   Sprint 48: slow stratum (poor metabolizer) — feasible window found
//   Sprint 51: fast stratum (ultra-rapid)      — feasible window found
//   Sprint 54: ind stratum  (strong inducer)   — structural infeasibility
//
// The inducer stratum has ke=0.05590 h⁻¹ (half-life ≈ 12.4h), clearing
// drug so rapidly between 24h doses that the 7-dose trough accumulation
// remains far below the 2σ certification floor regardless of dose.
// Simultaneously, the N=28 ceiling binds above D=56mg (near-SS trough
// approaches ceil). These two constraints produce a structural gap:
// no dose simultaneously achieves CERT at N=7 AND stays CERT at N=28.
//
// Finding A: D=34mg standard → WARN at N=7 (margin=0.290); margin grows
//            monotonically but slowly with dose (diminishing returns).
// Finding B: N=7 margin at the N=28 ceiling dose (D=56mg) ≈ 1.09 — still
//            0.91 short of the 2.0 certification threshold.
// Finding C: N=28 ceiling binding — d_cert_n28_max=56mg; above this dose
//            the near-SS trough exceeds the therapeutic ceiling.
// Finding D: structural infeasibility — no dose in [34,80] satisfies both
//            N=7 cert (margin≥2.0) and N=28 cert (margin≥2.0).

module pbpk::rapamycin_ind_dose_adjust

use pbpk::rapamycin_assay::{as_trough_mg_l}
use pbpk::rapamycin_expanded_u::{eu_u_c}
use pbpk::rapamycin_clinical::{trough_floor_mg_l, trough_ceil_mg_l}
use pbpk::rapamycin_oral_budget::{
    ob_ka_var_std, ob_f_var_std, ob_ke_var_std, ob_k12_var_std, ob_k21_var_std
}

fn ida_min(a: f64, b: f64) -> f64 { if a < b { a } else { b } }

fn ida_margin(d: f64, n: i64) -> f64 with Mut, Div, Panic {
    let ka  = ob_ka_var_std()
    let fv  = ob_f_var_std()
    let ke  = ob_ke_var_std()
    let k12 = ob_k12_var_std()
    let k21 = ob_k21_var_std()
    let c   = as_trough_mg_l(d, n, 0.05590, 0.047)
    let uc  = eu_u_c(d, n, 0.05590, 0.047, ka, fv, ke, k12, k21)
    ida_min((c - trough_floor_mg_l()) / uc, (trough_ceil_mg_l() - c) / uc)
}

// ── Spot values at N=7 in 2mg steps D=34..60 ─────────────────────────────────
pub fn ida_margin_n7_d34() -> f64 with Mut, Div, Panic { ida_margin(34.0, 7) }
pub fn ida_margin_n7_d36() -> f64 with Mut, Div, Panic { ida_margin(36.0, 7) }
pub fn ida_margin_n7_d38() -> f64 with Mut, Div, Panic { ida_margin(38.0, 7) }
pub fn ida_margin_n7_d40() -> f64 with Mut, Div, Panic { ida_margin(40.0, 7) }
pub fn ida_margin_n7_d42() -> f64 with Mut, Div, Panic { ida_margin(42.0, 7) }
pub fn ida_margin_n7_d44() -> f64 with Mut, Div, Panic { ida_margin(44.0, 7) }
pub fn ida_margin_n7_d46() -> f64 with Mut, Div, Panic { ida_margin(46.0, 7) }
pub fn ida_margin_n7_d48() -> f64 with Mut, Div, Panic { ida_margin(48.0, 7) }
pub fn ida_margin_n7_d50() -> f64 with Mut, Div, Panic { ida_margin(50.0, 7) }
pub fn ida_margin_n7_d52() -> f64 with Mut, Div, Panic { ida_margin(52.0, 7) }
pub fn ida_margin_n7_d54() -> f64 with Mut, Div, Panic { ida_margin(54.0, 7) }
pub fn ida_margin_n7_d56() -> f64 with Mut, Div, Panic { ida_margin(56.0, 7) }

// ── Spot values at N=28 for key doses ────────────────────────────────────────
pub fn ida_margin_n28_d34() -> f64 with Mut, Div, Panic { ida_margin(34.0, 28) }
pub fn ida_margin_n28_d42() -> f64 with Mut, Div, Panic { ida_margin(42.0, 28) }
pub fn ida_margin_n28_d50() -> f64 with Mut, Div, Panic { ida_margin(50.0, 28) }
pub fn ida_margin_n28_d56() -> f64 with Mut, Div, Panic { ida_margin(56.0, 28) }
pub fn ida_margin_n28_d60() -> f64 with Mut, Div, Panic { ida_margin(60.0, 28) }

// ── Scanner: highest D (2mg steps, 80..34) where ind certifies at N=28 ───────
pub fn ida_d_cert_n28_max() -> f64 with Mut, Div, Panic {
    var d      = 80.0
    var result = 0.0
    while d >= 34.0 {
        if ida_margin(d, 28) >= 2.0 && result == 0.0 { result = d };
        d = d - 2.0
    }
    result
}

// ── N=7 margin at the ceiling-constrained maximum dose ───────────────────────
pub fn ida_margin_n7_at_n28_max() -> f64 with Mut, Div, Panic {
    let d_max = ida_d_cert_n28_max()
    ida_margin(d_max, 7)
}

// ── Certification gap: 2.0 − margin_n7 at the ceiling-constrained dose ───────
pub fn ida_cert_gap_n7() -> f64 with Mut, Div, Panic {
    2.0 - ida_margin_n7_at_n28_max()
}

// ── Dose increment from standard to N=28 ceiling max (in 2mg steps) ──────────
pub fn ida_ceiling_gap_steps() -> i64 with Mut, Div, Panic {
    let d_max = ida_d_cert_n28_max()
    let diff  = d_max - 34.0
    let s     = diff / 2.0
    if s > 0.9 && s < 1.1 { 1 }
    else if s > 1.9 && s < 2.1 { 2 }
    else if s > 2.9 && s < 3.1 { 3 }
    else if s > 3.9 && s < 4.1 { 4 }
    else if s > 4.9 && s < 5.1 { 5 }
    else if s > 5.9 && s < 6.1 { 6 }
    else if s > 6.9 && s < 7.1 { 7 }
    else if s > 7.9 && s < 8.1 { 8 }
    else if s > 8.9 && s < 9.1 { 9 }
    else if s > 9.9 && s < 10.1 { 10 }
    else if s > 10.9 && s < 11.1 { 11 }
    else { 0 }
}

// ── N=7 margin increment per 2mg dose step at standard ───────────────────────
// (d36 - d34): first-step sensitivity
pub fn ida_margin_n7_step1() -> f64 with Mut, Div, Panic {
    ida_margin(36.0, 7) - ida_margin(34.0, 7)
}

// (d50 - d48): last-step sensitivity in spot range (diminishing returns)
pub fn ida_margin_n7_step_last() -> f64 with Mut, Div, Panic {
    ida_margin(50.0, 7) - ida_margin(48.0, 7)
}
