// ── Population-weighted cert fractions at N=7 under each protocol ─────────────
// Weights: std=0.50, slow=0.15, fast=0.20, inh=0.05, ind=0.10
fn msc_cert_flag(m: f64) -> f64 { if m >= 2.0 { 1.0 } else { 0.0 } }

pub fn msc_pop_cni_cert_n7() -> f64 with Mut, Div, Panic {
    msc_cert_flag(msc_std_cni_margin_n7())  * 0.50
    + msc_cert_flag(msc_slow_cni_margin_n7())  * 0.15
    + msc_cert_flag(msc_fast_cni_margin_n7())  * 0.20
    + msc_cert_flag(msc_inh_cni_margin_n7())   * 0.05
    + msc_cert_flag(msc_ind_cni_margin_n7())   * 0.10
}

pub fn msc_pop_free_cert_n28() -> f64 with Mut, Div, Panic {
    msc_cert_flag(msc_std_free_margin_n28())  * 0.50
    + msc_cert_flag(msc_slow_free_margin_n28()) * 0.15
    + msc_cert_flag(msc_fast_free_margin_n28()) * 0.20
    + msc_cert_flag(msc_inh_free_margin_n28())  * 0.05
    + msc_cert_flag(msc_ind_free_margin_n28())  * 0.10
}
