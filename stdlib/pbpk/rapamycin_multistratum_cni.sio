pub fn msc_slow_free_margin_n14() -> f64 with Mut, Div, Panic { msc_free_margin(2.5, 0.00838, 0.188, 14) }
pub fn msc_slow_free_margin_n28() -> f64 with Mut, Div, Panic { msc_free_margin(2.5, 0.00838, 0.188, 28) }
pub fn msc_slow_free_ncrit() -> i64 with Mut, Div, Panic { msc_free_ncrit(2.5, 0.00838, 0.188) }
pub fn msc_slow_free_nlast() -> i64 with Mut, Div, Panic { msc_free_nlast(2.5, 0.00838, 0.188) }
