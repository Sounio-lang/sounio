pub fn msc_ind_cni_margin_n14() -> f64 with Mut, Div, Panic { msc_cni_margin(34.0, 0.05590, 0.047, 14) }
pub fn msc_ind_cni_margin_n28() -> f64 with Mut, Div, Panic { msc_cni_margin(34.0, 0.05590, 0.047, 28) }
