// stdlib/pbpk/rapamycin_uc_budget.sio — Sprint 62
//
// ISO GUM uncertainty budget for the standard stratum (ke=0.01118, F=0.141,
// D=5mg): fractional contribution of each PK parameter to u_c at N=7/14/28.
//
// Method: eu_u_c is called with all-but-one variance set to zero to isolate
// each parameter's contribution; fractional share = u_i² / u_c_total².
// By GUM: u_c² = u_ke² + u_F² + u_ka² + u_k12² + u_k21² (uncorrelated).
//
// Parameters and their roles:
//   ke  (elimination rate)    — enters via accumulation factor R = 1/(1−exp(−ke·τ))
//   F   (bioavailability)     — enters linearly: c ∝ F·D
//   ka  (absorption rate)     — affects shape; trough mostly post-absorption
//   k12 (central→peripheral)  — distribution phase
//   k21 (peripheral→central)  — distribution equilibration
//
// Finding A: ka (absorption rate) dominates — 81.6% at N=7, 58.3% at N=28;
//            ke is minor throughout (0.3%→1.0%), F is second (~10%→7%).
// Finding B: F's absolute contribution is N-invariant (0.000273 mg/L at all N)
//            because it enters as a dose-proportional constant in eu_u_c.
// Finding C: k12+k21 (distribution) grow from 7.8% to 33.3% as steady state
//            is approached; distribution equilibration dominates late-phase budget.
// Finding D: sum of fractional contributions = 1.000 (GUM additive closure).

module pbpk::rapamycin_uc_budget

use pbpk::rapamycin_expanded_u::{eu_u_c}
use pbpk::rapamycin_oral_budget::{
    ob_ka_var_std, ob_f_var_std, ob_ke_var_std, ob_k12_var_std, ob_k21_var_std
}

fn ucb_total_n(n: i64) -> f64 with Mut, Div, Panic {
    eu_u_c(5.0, n, 0.01118, 0.141, ob_ka_var_std(), ob_f_var_std(), ob_ke_var_std(), ob_k12_var_std(), ob_k21_var_std())
}

fn ucb_ke_n(n: i64) -> f64 with Mut, Div, Panic {
    eu_u_c(5.0, n, 0.01118, 0.141, 0.0, 0.0, ob_ke_var_std(), 0.0, 0.0)
}

fn ucb_f_n(n: i64) -> f64 with Mut, Div, Panic {
    eu_u_c(5.0, n, 0.01118, 0.141, 0.0, ob_f_var_std(), 0.0, 0.0, 0.0)
}

fn ucb_ka_n(n: i64) -> f64 with Mut, Div, Panic {
    eu_u_c(5.0, n, 0.01118, 0.141, ob_ka_var_std(), 0.0, 0.0, 0.0, 0.0)
}

fn ucb_k12_n(n: i64) -> f64 with Mut, Div, Panic {
    eu_u_c(5.0, n, 0.01118, 0.141, 0.0, 0.0, 0.0, ob_k12_var_std(), 0.0)
}

fn ucb_k21_n(n: i64) -> f64 with Mut, Div, Panic {
    eu_u_c(5.0, n, 0.01118, 0.141, 0.0, 0.0, 0.0, 0.0, ob_k21_var_std())
}

fn ucb_frac_n(u_i: f64, u_tot: f64) -> f64 with Mut, Div, Panic {
    (u_i * u_i) / (u_tot * u_tot)
}

// ── Absolute u_c contributions (mg/L) ─────────────────────────────────────────
pub fn ucb_uc_ke_n7()  -> f64 with Mut, Div, Panic { ucb_ke_n(7)  }
pub fn ucb_uc_ke_n14() -> f64 with Mut, Div, Panic { ucb_ke_n(14) }
pub fn ucb_uc_ke_n28() -> f64 with Mut, Div, Panic { ucb_ke_n(28) }

pub fn ucb_uc_f_n7()   -> f64 with Mut, Div, Panic { ucb_f_n(7)  }
pub fn ucb_uc_f_n14()  -> f64 with Mut, Div, Panic { ucb_f_n(14) }
pub fn ucb_uc_f_n28()  -> f64 with Mut, Div, Panic { ucb_f_n(28) }

pub fn ucb_uc_ka_n7()  -> f64 with Mut, Div, Panic { ucb_ka_n(7)  }
pub fn ucb_uc_k12_n7() -> f64 with Mut, Div, Panic { ucb_k12_n(7)  }
pub fn ucb_uc_k21_n7() -> f64 with Mut, Div, Panic { ucb_k21_n(7)  }

// ── Fractional contributions (0..1, sum = 1) ──────────────────────────────────
pub fn ucb_frac_ke_n7() -> f64 with Mut, Div, Panic {
    ucb_frac_n(ucb_ke_n(7),  ucb_total_n(7))
}
pub fn ucb_frac_ke_n14() -> f64 with Mut, Div, Panic {
    ucb_frac_n(ucb_ke_n(14), ucb_total_n(14))
}
pub fn ucb_frac_ke_n28() -> f64 with Mut, Div, Panic {
    ucb_frac_n(ucb_ke_n(28), ucb_total_n(28))
}

pub fn ucb_frac_f_n7() -> f64 with Mut, Div, Panic {
    ucb_frac_n(ucb_f_n(7),  ucb_total_n(7))
}
pub fn ucb_frac_f_n14() -> f64 with Mut, Div, Panic {
    ucb_frac_n(ucb_f_n(14), ucb_total_n(14))
}
pub fn ucb_frac_f_n28() -> f64 with Mut, Div, Panic {
    ucb_frac_n(ucb_f_n(28), ucb_total_n(28))
}

pub fn ucb_frac_ka_n7()  -> f64 with Mut, Div, Panic { ucb_frac_n(ucb_ka_n(7),  ucb_total_n(7))  }
pub fn ucb_frac_k12_n7() -> f64 with Mut, Div, Panic { ucb_frac_n(ucb_k12_n(7), ucb_total_n(7))  }
pub fn ucb_frac_k21_n7() -> f64 with Mut, Div, Panic { ucb_frac_n(ucb_k21_n(7), ucb_total_n(7))  }

pub fn ucb_frac_ka_n28()  -> f64 with Mut, Div, Panic { ucb_frac_n(ucb_ka_n(28),  ucb_total_n(28)) }
pub fn ucb_frac_k12_n28() -> f64 with Mut, Div, Panic { ucb_frac_n(ucb_k12_n(28), ucb_total_n(28)) }
pub fn ucb_frac_k21_n28() -> f64 with Mut, Div, Panic { ucb_frac_n(ucb_k21_n(28), ucb_total_n(28)) }

// ── GUM closure check: sum of fractions ≈ 1.0 ─────────────────────────────────
pub fn ucb_sum_fracs_n7() -> f64 with Mut, Div, Panic {
    ucb_frac_ke_n7() + ucb_frac_f_n7() + ucb_frac_ka_n7()
    + ucb_frac_k12_n7() + ucb_frac_k21_n7()
}

pub fn ucb_sum_fracs_n28() -> f64 with Mut, Div, Panic {
    ucb_frac_ke_n28() + ucb_frac_f_n28() + ucb_frac_ka_n28()
    + ucb_frac_k12_n28() + ucb_frac_k21_n28()
}

// ── ke dominance evolution: fractional shift N=7→N=28 ─────────────────────────
pub fn ucb_ke_dominance_gain() -> f64 with Mut, Div, Panic {
    ucb_frac_ke_n28() - ucb_frac_ke_n7()
}
