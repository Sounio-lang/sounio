// stdlib/pbpk/rapamycin_sprint64_gate.sio — Sprint 64 certification gate
//
// Multi-stratum CNI protocol analysis: all five CYP3A4/P-gp strata under
// CNI co-medication (4–12 ng/mL) and CNI-free (12–20 ng/mL) protocols.
//
// Key findings:
//   A: STD — CNI ncrit=6/nlast=14/span=8; FREE ncrit=25/nlast=36/span=11
//   B: SLOW — widest windows: CNI span=17, FREE span=23
//   C: FAST — narrowest CNI window: span=4 (ncrit=7, nlast=11)
//   D: INH — CNI span=12 (ncrit=7, nlast=19); FREE span=11 (ncrit=26, nlast=37)
//   E: IND — CNI span=0 (ncrit=nlast=26); FREE NEVER certifies (ncrit=0, nlast=0)
//   F: Population CNI cert N=7 = 0.75; FREE cert N=28 = 0.75 (symmetric)
//   G: Span ordering: slow > inh > std > fast for CNI; slow > std > inh > fast for FREE
//   H: ind unique pathology — only stratum with span=0 under CNI; only one never-certifying
//
// 56 assertions in sections A–H. All must pass (return 56).

module pbpk::rapamycin_sprint64_gate

use pbpk::rapamycin_multistratum_cni::{
    msc_std_cni_margin_n7, msc_std_cni_margin_n14, msc_std_cni_margin_n21,
    msc_std_cni_ncrit, msc_std_cni_nlast, msc_std_cni_span,
    msc_std_free_margin_n7, msc_std_free_margin_n28,
    msc_std_free_ncrit, msc_std_free_nlast, msc_std_free_span,
    msc_slow_cni_margin_n7, msc_slow_cni_margin_n14, msc_slow_cni_margin_n21,
    msc_slow_cni_ncrit, msc_slow_cni_nlast, msc_slow_cni_span,
    msc_slow_free_margin_n14, msc_slow_free_margin_n28,
    msc_slow_free_ncrit, msc_slow_free_nlast, msc_slow_free_span,
    msc_fast_cni_margin_n7, msc_fast_cni_margin_n14, msc_fast_cni_margin_n21,
    msc_fast_cni_ncrit, msc_fast_cni_nlast, msc_fast_cni_span,
    msc_fast_free_margin_n7, msc_fast_free_margin_n28,
    msc_fast_free_ncrit, msc_fast_free_nlast, msc_fast_free_span,
    msc_inh_cni_margin_n7, msc_inh_cni_margin_n14, msc_inh_cni_margin_n28,
    msc_inh_cni_ncrit, msc_inh_cni_nlast, msc_inh_cni_span,
    msc_inh_free_margin_n7, msc_inh_free_margin_n28,
    msc_inh_free_ncrit, msc_inh_free_nlast, msc_inh_free_span,
    msc_ind_cni_margin_n7, msc_ind_cni_margin_n14, msc_ind_cni_margin_n28,
    msc_ind_cni_ncrit, msc_ind_cni_nlast, msc_ind_cni_span,
    msc_ind_free_margin_n7, msc_ind_free_margin_n28,
    msc_ind_free_ncrit, msc_ind_free_nlast, msc_ind_free_span,
    msc_pop_cni_cert_n7, msc_pop_free_cert_n28
}

pub fn rapamycin_sprint64_gate() -> i64 with Mut, Div, Panic {
    var score = 0

    // ── Section A: STD stratum (cross-check with Sprint 63) ──────────────────
    if msc_std_cni_ncrit()  == 6  { score = score + 1 };
    if msc_std_cni_nlast()  == 14 { score = score + 1 };
    if msc_std_cni_span()   == 8  { score = score + 1 };
    if msc_std_cni_margin_n7()  > 2.0 { score = score + 1 };
    if msc_std_cni_margin_n21() < 0.0 { score = score + 1 };
    if msc_std_free_ncrit() == 25 { score = score + 1 };
    if msc_std_free_span()  == 11 { score = score + 1 };

    // ── Section B: SLOW stratum — widest windows (Finding B) ─────────────────
    if msc_slow_cni_ncrit()  == 8  { score = score + 1 };
    if msc_slow_cni_nlast()  == 25 { score = score + 1 };
    if msc_slow_cni_span()   == 17 { score = score + 1 };
    if msc_slow_cni_margin_n7()  < 2.0 { score = score + 1 };
    if msc_slow_cni_margin_n14() > 2.0 { score = score + 1 };
    if msc_slow_free_ncrit() == 35 { score = score + 1 };
    if msc_slow_free_span()  == 23 { score = score + 1 };

    // ── Section C: FAST stratum — narrowest CNI window (Finding C) ───────────
    if msc_fast_cni_ncrit()  == 7  { score = score + 1 };
    if msc_fast_cni_nlast()  == 11 { score = score + 1 };
    if msc_fast_cni_span()   == 4  { score = score + 1 };
    if msc_fast_cni_margin_n7()  > 2.0 { score = score + 1 };
    if msc_fast_cni_margin_n14() < 2.0 { score = score + 1 };
    if msc_fast_free_ncrit() == 28 { score = score + 1 };
    if msc_fast_free_span()  == 6  { score = score + 1 };

    // ── Section D: INH stratum (Finding D) ───────────────────────────────────
    if msc_inh_cni_ncrit()  == 7  { score = score + 1 };
    if msc_inh_cni_nlast()  == 19 { score = score + 1 };
    if msc_inh_cni_span()   == 12 { score = score + 1 };
    if msc_inh_cni_margin_n14() > 2.0 { score = score + 1 };
    if msc_inh_cni_margin_n28() < 0.0 { score = score + 1 };
    if msc_inh_free_ncrit() == 26 { score = score + 1 };
    if msc_inh_free_span()  == 11 { score = score + 1 };

    // ── Section E: IND stratum — degenerate (Finding A) ──────────────────────
    if msc_ind_cni_ncrit() == 26 { score = score + 1 };
    if msc_ind_cni_nlast() == 26 { score = score + 1 };
    if msc_ind_cni_span()  == 0  { score = score + 1 };
    if msc_ind_cni_margin_n7()  < 2.0 { score = score + 1 };
    if msc_ind_cni_margin_n28() < 2.0 { score = score + 1 };
    if msc_ind_free_ncrit() == 0 { score = score + 1 };
    if msc_ind_free_nlast() == 0 { score = score + 1 };

    // ── Section F: Population fractions (Finding D) ───────────────────────────
    if msc_pop_cni_cert_n7()   > 0.74 { score = score + 1 };
    if msc_pop_cni_cert_n7()   < 0.76 { score = score + 1 };
    if msc_pop_free_cert_n28() > 0.74 { score = score + 1 };
    if msc_pop_free_cert_n28() < 0.76 { score = score + 1 };
    if msc_std_free_margin_n28() > 0.0 { score = score + 1 };
    if msc_inh_free_margin_n28() > 0.0 { score = score + 1 };
    if msc_slow_free_margin_n28() < 0.0 { score = score + 1 };

    // ── Section G: CNI span ordering across strata (Finding B, C) ────────────
    if msc_slow_cni_span() > msc_inh_cni_span()  { score = score + 1 };
    if msc_inh_cni_span()  > msc_std_cni_span()  { score = score + 1 };
    if msc_std_cni_span()  > msc_fast_cni_span() { score = score + 1 };
    if msc_fast_cni_span() > msc_ind_cni_span()  { score = score + 1 };
    if msc_slow_free_span() > msc_std_free_span() { score = score + 1 };
    if msc_std_free_span()  > msc_fast_free_span() { score = score + 1 };
    if msc_ind_free_span()  == 0 { score = score + 1 };

    // ── Section H: IND pathology + inter-protocol contrasts (Finding A) ───────
    if msc_ind_cni_ncrit() > msc_std_cni_ncrit()  { score = score + 1 };
    if msc_ind_cni_ncrit() > msc_fast_cni_ncrit() { score = score + 1 };
    if msc_slow_free_nlast() > msc_std_free_nlast() { score = score + 1 };
    if msc_inh_cni_span() > msc_std_cni_span()    { score = score + 1 };
    if msc_fast_cni_nlast() < msc_std_cni_nlast()  { score = score + 1 };
    if msc_slow_cni_ncrit() > msc_std_cni_ncrit()  { score = score + 1 };
    if msc_inh_free_ncrit() > msc_std_free_ncrit() { score = score + 1 };

    score
}
