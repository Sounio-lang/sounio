// stdlib/pbpk/rapamycin_sprint52_gate.sio — Sprint 52 certification gate
//
// Fast stratum (CYP3A4 ultra-rapid, ke=0.01677 h⁻¹, F=0.094) at adjusted
// dose D=9.5mg (Sprint 51 minimum certifying dose). Trajectory parallel to
// Sprint 49 (slow stratum at D=2.5mg).
//
// Trajectory values (D=9.5mg):
//   N=1:  -0.820 ALARM   N=7:  +2.059 CERT (n_crit)
//   N=14: +4.387 CERT    N=18: +5.469 CERT (peak)
//   N=21: +4.855 CERT    N=28: +3.226 CERT
//   N=42: +0.928 WARN    N=56: -0.516 ALARM
//   N=84: -2.033 ALARM
//   n_last_cert=34, cert_span=27, ncrit_lead=6, peak_lag=11
//
// Finding A: exact-threshold certification — n_crit=7, adjusted dose certifies
//            precisely at the week-1 visit; 6 days before (N=1..6) sub-therapeutic.
// Finding B: peak at N=18, margin=5.469 — strong mid-trajectory certification;
//            fast accumulates past floor then ceiling begins binding.
// Finding C: ceiling binding — last cert at N=34; WARN by N=42, ALARM by N=56;
//            adjusted dose requires dose review before week-6 mark.
// Finding D: all three standard monitoring visits (N=7, 14, 28) certify;
//            month-1 margin=3.226 gives adequate safety at the last routine visit.
//
// 56 assertions in sections A–H. All must pass (return 56).

module pbpk::rapamycin_sprint52_gate

use pbpk::rapamycin_fast_adjusted::{
    fa_margin_n1,  fa_margin_n3,  fa_margin_n7,
    fa_margin_n14, fa_margin_n21, fa_margin_n28,
    fa_margin_n42, fa_margin_n56, fa_margin_n84,
    fa_n_crit,     fa_n_last_cert, fa_n_peak,
    fa_margin_peak, fa_ncrit_lead,
    fa_cert_span,  fa_peak_lag
}

pub fn rapamycin_sprint52_gate() -> i64 with Mut, Div, Panic {
    var score = 0

    // ── Section A: pre-cert trajectory — ALARM → WARN → CERT at N=7 ──────────
    if fa_margin_n1() < 0.0 { score = score + 1 };
    if fa_margin_n1() > -1.0 { score = score + 1 };
    if fa_margin_n3() > 0.0 { score = score + 1 };
    if fa_margin_n3() < 2.0 { score = score + 1 };
    if fa_margin_n7() >= 2.0 { score = score + 1 };
    if fa_margin_n7() > 2.05 { score = score + 1 };
    if fa_margin_n7() < 2.07 { score = score + 1 };

    // ── Section B: n_crit=7 — exact-threshold cert at week-1 visit (Finding A) ─
    if fa_n_crit() > 6 { score = score + 1 };
    if fa_n_crit() < 8 { score = score + 1 };
    if fa_ncrit_lead() > 5 { score = score + 1 };
    if fa_ncrit_lead() < 7 { score = score + 1 };
    if fa_margin_n14() > fa_margin_n7() { score = score + 1 };
    if fa_n_crit() > 0 { score = score + 1 };
    if fa_margin_n7() < fa_margin_n14() { score = score + 1 };

    // ── Section C: peak at N=18, margin=5.469 (Finding B) ────────────────────
    if fa_n_peak() > 17 { score = score + 1 };
    if fa_n_peak() < 19 { score = score + 1 };
    if fa_margin_peak() > 5.4 { score = score + 1 };
    if fa_margin_peak() < 5.5 { score = score + 1 };
    if fa_margin_n21() > 4.8 { score = score + 1 };
    if fa_margin_n21() < 5.0 { score = score + 1 };
    if fa_peak_lag() > 10 { score = score + 1 };

    // ── Section D: ceiling binding — last cert N=34, ALARM by N=56 (Finding C) ─
    if fa_n_last_cert() > 33 { score = score + 1 };
    if fa_n_last_cert() < 35 { score = score + 1 };
    if fa_cert_span() > 26 { score = score + 1 };
    if fa_cert_span() < 28 { score = score + 1 };
    if fa_margin_n42() > 0.0 { score = score + 1 };
    if fa_margin_n42() < 2.0 { score = score + 1 };
    if fa_margin_n56() < 0.0 { score = score + 1 };

    // ── Section E: all monitoring visits certify (Finding D) ─────────────────
    if fa_margin_n7()  >= 2.0 { score = score + 1 };
    if fa_margin_n14() >= 2.0 { score = score + 1 };
    if fa_margin_n28() >= 2.0 { score = score + 1 };
    if fa_margin_n28() > 3.0 { score = score + 1 };
    if fa_margin_n28() < 4.0 { score = score + 1 };
    if fa_margin_n14() > 4.3 { score = score + 1 };
    if fa_margin_n14() < 4.4 { score = score + 1 };

    // ── Section F: unimodal trajectory — rise then monotone fall ─────────────
    if fa_margin_n14() > fa_margin_n7() { score = score + 1 };
    if fa_margin_n21() > fa_margin_n14() { score = score + 1 };
    if fa_margin_n28() < fa_margin_n21() { score = score + 1 };
    if fa_margin_n42() < fa_margin_n28() { score = score + 1 };
    if fa_margin_n56() < fa_margin_n42() { score = score + 1 };
    if fa_margin_n84() < fa_margin_n56() { score = score + 1 };
    if fa_margin_n84() < -2.0 { score = score + 1 };

    // ── Section G: derived metrics — cert span and peak structure ─────────────
    if fa_cert_span() > 25 { score = score + 1 };
    if fa_cert_span() < 30 { score = score + 1 };
    if fa_peak_lag() > 9 { score = score + 1 };
    if fa_peak_lag() < 13 { score = score + 1 };
    if fa_n_peak() < fa_n_last_cert() { score = score + 1 };
    if fa_n_crit() < fa_n_peak() { score = score + 1 };
    if fa_margin_peak() > fa_margin_n28() { score = score + 1 };

    // ── Section H: policy — monitoring visits covered; dose review before N=42 ─
    if fa_n_last_cert() > 28 { score = score + 1 };
    if fa_n_last_cert() < 42 { score = score + 1 };
    if fa_margin_n42() > 0.0 { score = score + 1 };
    if fa_margin_n42() < 1.0 { score = score + 1 };
    if fa_margin_n56() < fa_margin_n42() { score = score + 1 };
    if fa_margin_n1() < fa_margin_n7() { score = score + 1 };
    if fa_margin_n28() > fa_margin_n42() { score = score + 1 };

    score
}
