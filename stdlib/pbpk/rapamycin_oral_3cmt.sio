// stdlib/pbpk/rapamycin_oral_3cmt.sio — Oral rapamycin 3-compartment epistemic model
//
// Novel contribution: GUM variance propagation through a 3-compartment oral
// absorption model (gut → central → peripheral) with a 5-channel uncertainty budget
// that separately tracks F (bioavailability) and ka (absorption rate).
//
// The dissertation finding: for the oral route, ka (absorption rate) dominates
// the trough uncertainty budget — NOT F (bioavailability), despite F carrying
// similar or larger inter-individual CV (≈28% vs 24%).
//
// ── Why ka dominates over F ──────────────────────────────────────────────────
//
//   F uncertainty enters only as the initial condition V_gut(0) = D² × Var(F).
//   This uncertainty decays exponentially as drug is absorbed (half-life ≈ 1/ka = 1.6h).
//
//   ka uncertainty creates NEW variance EVERY time step: dt² × Var(ka) × A_gut²(t).
//   This accumulates over the entire absorption phase, amplified by the large
//   A_gut in the early steps (A_gut(0) = 10 mg).
//
//   Net result: ka contribution ≈ 10× F contribution at the 24h trough endpoint.
//
// ── Clinical consequence ────────────────────────────────────────────────────
//
//   A clinician who invests in better bioavailability characterization (e.g.,
//   improved LC-MS/MS assay for F) will NOT cross the UNCERTAIN → THERAPEUTIC
//   threshold. Only improving ka characterization (denser sampling around Tmax,
//   ≈4h post-dose) will promote the clinical gate.
//
// ── Standard oral scenario ───────────────────────────────────────────────────
//
//   ke_val  = 0.01118 h⁻¹  (from t½=62h; Yatscoff et al. 1995)
//   k12_val = 0.05 h⁻¹     (central→peripheral distribution)
//   k21_val = 0.005 h⁻¹    (peripheral→central return)
//   vc_val  = 75.0 L
//   ka_val  = 0.62 h⁻¹     (oral absorption; Jusko et al. 2000)
//   F_val   = 0.141         (bioavailability 14.1%; Jusko et al. 2000)
//   D_oral  = 10.0 mg       (standard loading dose; target trough 4–20 ng/mL)
//   dt = 0.5 h, n_steps = 48 (total 24 h)
//
// ── Standard uncertainty budget ─────────────────────────────────────────────
//
//   ke_var  = 8.41e-6  (σ=0.0029 h⁻¹; 26% CV — derived from t½ uncertainty)
//   k12_var = 1.56e-4  (σ=0.0125 h⁻¹; 25% CV)
//   k21_var = 1.56e-6  (σ=0.00125 h⁻¹; 25% CV)
//   ka_var  = 0.0225   (σ=0.15 h⁻¹; 24% CV — dominant)
//   F_var   = 0.001521 (σ=0.039; 28% CV — NOT dominant at 24h trough)
//
//   Baseline: UNCERTAIN (conf=700 < 800), dom=ka (index 1)
//   ka_var÷4: THERAPEUTIC (conf=820), dom=ka (index 1 still)
//   F_var÷4:  UNCERTAIN (conf=700), dom=ka — F improvement does NOT help
//   ka_var/16: THERAPEUTIC (conf=820), dom=F (index 0 — F surfaces as #2)
//
// ── Budget channel indices ───────────────────────────────────────────────────
//   0 = F (bioavailability) — enters via initial V_gut(0) = D² × F_var
//   1 = ka (absorption rate) — dominant; creates variance throughout absorption
//   2 = ke (elimination) — minor at 24h trough
//   3 = k12 (distribution rate) — minor
//   4 = k21 (return rate) — minor
//
// Effect annotations:
//   classify_oral_trough:    with Epistemic, Mut, Div, Panic
//   conf_oral_trough:        with Mut, Div, Panic
//   dom_oral_trough:         with Mut, Div, Panic
//   classify_standard_oral:  with Epistemic, Mut, Div, Panic
//   conf_standard_oral:      with Mut, Div, Panic
//   dom_standard_oral:       with Mut, Div, Panic
//   oral_improvement_fires:  with Epistemic, Mut, Div, Panic
//   oral_ka_dominant:        with Mut, Div, Panic

module pbpk::rapamycin_oral_3cmt

use epistemic::knowledge::{Epistemic}
use pbpk::rapamycin_clinical::{
    assess_trough, conf_from_rel,
    decision_therapeutic, decision_uncertain
}

// ── Private helpers ───────────────────────────────────────────────────────────

fn sqrt_f64(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { 0.0001 } else {
        var r = x; var i = 0
        while i < 50 { r = (r + x / r) / 2.0; i = i + 1 }
        r
    }
}

fn argmax5(b0: f64, b1: f64, b2: f64, b3: f64, b4: f64) -> i64 {
    var dom = 0; var dv = b0
    if b1 > dv { dom = 1; dv = b1 }
    if b2 > dv { dom = 2; dv = b2 }
    if b3 > dv { dom = 3; dv = b3 }
    if b4 > dv { dom = 4 }
    dom
}

// ── Core 3-compartment oral GUM simulation ────────────────────────────────────
//
// Runs Euler integration (gut → central → peripheral) for n_steps steps of dt.
// Returns trough classification at t_end = n_steps × dt.
//
// Budget indices: 0=F, 1=ka, 2=ke, 3=k12, 4=k21

pub fn classify_oral_trough(
    ke_val: f64, ke_var: f64,
    k12_val: f64, k12_var: f64,
    k21_val: f64, k21_var: f64,
    ka_val: f64, ka_var: f64,
    f_val: f64, f_var: f64,
    d_oral: f64, vc: f64, dt: f64, n_steps: i64
) -> i64 with Epistemic, Mut, Div, Panic {
    var a_gut    = d_oral
    var a1       = 0.0
    var a2       = 0.0
    var v_gut_f  = d_oral * d_oral * f_var
    var v_gut_ka = 0.0
    var v1       = 0.0
    var v2       = 0.0

    let j11 = 0.0 - (ke_val + k12_val)
    let j12 = k21_val
    let j21 = k12_val
    let j22 = 0.0 - k21_val
    let g11 = 1.0 + dt * j11
    let g12 = dt * j12
    let g21 = dt * j21
    let g22 = 1.0 + dt * j22
    let g_gut = 1.0 - dt * ka_val
    let g11sq = g11 * g11
    let g_gut_sq = g_gut * g_gut

    var step = 0
    while step < n_steps {
        let flux = f_val * ka_val * a_gut
        let new_a_gut = a_gut + dt * (0.0 - ka_val * a_gut)
        let new_a1    = a1   + dt * (j11 * a1 + j12 * a2 + flux)
        let new_a2    = a2   + dt * (j21 * a1 + j22 * a2)
        let ckg = dt * dt * ka_var * a_gut * a_gut
        let new_vgf  = g_gut_sq * v_gut_f
        let new_vgka = g_gut_sq * v_gut_ka + ckg
        let v_gut = v_gut_f + v_gut_ka
        let v1s   = g11 * g11 * v1 + g12 * g12 * v2
        let cke   = dt * dt * ke_var  * a1 * a1
        let ck12  = dt * dt * k12_var * a1 * a1
        let ck21  = dt * dt * k21_var * a2 * a2
        let gv1   = dt * dt * ka_val * ka_val * v_gut
        let new_v1 = v1s + cke + ck12 + ck21 + gv1
        let new_v2 = g21*g21*v1 + g22*g22*v2 + dt*dt*(k12_var*a1*a1 + k21_var*a2*a2)
        a_gut = new_a_gut; a1 = new_a1; a2 = new_a2
        v_gut_f = new_vgf; v_gut_ka = new_vgka
        v1 = new_v1; v2 = new_v2
        step = step + 1
    }
    let c_t   = a1 / vc
    let std_t = sqrt_f64(v1) / vc
    let conf  = conf_from_rel(c_t, std_t)
    let c_ep  = Epistemic::new(c_t, v1 / (vc * vc), conf)
    assess_trough(&c_ep)
}

pub fn conf_oral_trough(
    ke_val: f64, ke_var: f64,
    k12_val: f64, k12_var: f64,
    k21_val: f64, k21_var: f64,
    ka_val: f64, ka_var: f64,
    f_val: f64, f_var: f64,
    d_oral: f64, vc: f64, dt: f64, n_steps: i64
) -> i64 with Mut, Div, Panic {
    var a_gut    = d_oral
    var a1       = 0.0
    var a2       = 0.0
    var v_gut_f  = d_oral * d_oral * f_var
    var v_gut_ka = 0.0
    var v1       = 0.0
    var v2       = 0.0

    let j11 = 0.0 - (ke_val + k12_val)
    let j12 = k21_val
    let j21 = k12_val
    let j22 = 0.0 - k21_val
    let g11 = 1.0 + dt * j11
    let g12 = dt * j12
    let g21 = dt * j21
    let g22 = 1.0 + dt * j22
    let g_gut = 1.0 - dt * ka_val
    let g_gut_sq = g_gut * g_gut

    var step = 0
    while step < n_steps {
        let flux = f_val * ka_val * a_gut
        let new_a_gut = a_gut + dt * (0.0 - ka_val * a_gut)
        let new_a1    = a1   + dt * (j11 * a1 + j12 * a2 + flux)
        let new_a2    = a2   + dt * (j21 * a1 + j22 * a2)
        let ckg = dt * dt * ka_var * a_gut * a_gut
        let new_vgf  = g_gut_sq * v_gut_f
        let new_vgka = g_gut_sq * v_gut_ka + ckg
        let v_gut = v_gut_f + v_gut_ka
        let v1s  = g11*g11*v1 + g12*g12*v2
        let cke  = dt * dt * ke_var  * a1 * a1
        let ck12 = dt * dt * k12_var * a1 * a1
        let ck21 = dt * dt * k21_var * a2 * a2
        let gv1  = dt * dt * ka_val * ka_val * v_gut
        let new_v1 = v1s + cke + ck12 + ck21 + gv1
        let new_v2 = g21*g21*v1 + g22*g22*v2 + dt*dt*(k12_var*a1*a1 + k21_var*a2*a2)
        a_gut = new_a_gut; a1 = new_a1; a2 = new_a2
        v_gut_f = new_vgf; v_gut_ka = new_vgka
        v1 = new_v1; v2 = new_v2
        step = step + 1
    }
    let c_t   = a1 / vc
    let std_t = sqrt_f64(v1) / vc
    conf_from_rel(c_t, std_t)
}

pub fn dom_oral_trough(
    ke_val: f64, ke_var: f64,
    k12_val: f64, k12_var: f64,
    k21_val: f64, k21_var: f64,
    ka_val: f64, ka_var: f64,
    f_val: f64, f_var: f64,
    d_oral: f64, vc: f64, dt: f64, n_steps: i64
) -> i64 with Mut, Div, Panic {
    var a_gut    = d_oral
    var a1       = 0.0
    var a2       = 0.0
    var v_gut_f  = d_oral * d_oral * f_var
    var v_gut_ka = 0.0
    var v1       = 0.0
    var v2       = 0.0
    var bud_f    = 0.0
    var bud_ka   = 0.0
    var bud_ke   = 0.0
    var bud_k12  = 0.0
    var bud_k21  = 0.0

    let j11 = 0.0 - (ke_val + k12_val)
    let j12 = k21_val
    let j21 = k12_val
    let j22 = 0.0 - k21_val
    let g11 = 1.0 + dt * j11
    let g12 = dt * j12
    let g21 = dt * j21
    let g22 = 1.0 + dt * j22
    let g_gut = 1.0 - dt * ka_val
    let g11sq    = g11 * g11
    let g_gut_sq = g_gut * g_gut

    var step = 0
    while step < n_steps {
        let flux = f_val * ka_val * a_gut
        let new_a_gut = a_gut + dt * (0.0 - ka_val * a_gut)
        let new_a1    = a1   + dt * (j11 * a1 + j12 * a2 + flux)
        let new_a2    = a2   + dt * (j21 * a1 + j22 * a2)
        let ckg = dt * dt * ka_var * a_gut * a_gut
        let new_vgf  = g_gut_sq * v_gut_f
        let new_vgka = g_gut_sq * v_gut_ka + ckg
        let v_gut = v_gut_f + v_gut_ka
        let v1s   = g11*g11*v1 + g12*g12*v2
        let cke   = dt * dt * ke_var  * a1 * a1
        let ck12  = dt * dt * k12_var * a1 * a1
        let ck21  = dt * dt * k21_var * a2 * a2
        let ckac  = dt * dt * ka_var * a_gut * a_gut * f_val * f_val
        let gv1   = dt * dt * ka_val * ka_val * v_gut
        let new_v1 = v1s + cke + ck12 + ck21 + gv1
        let new_v2 = g21*g21*v1 + g22*g22*v2 + dt*dt*(k12_var*a1*a1 + k21_var*a2*a2)
        let bfc  = dt * dt * ka_val * ka_val * v_gut_f
        let bkac = dt * dt * ka_val * ka_val * v_gut_ka + ckac
        a_gut = new_a_gut; a1 = new_a1; a2 = new_a2
        v_gut_f = new_vgf; v_gut_ka = new_vgka
        v1 = new_v1; v2 = new_v2
        bud_f   = g11sq * bud_f   + bfc
        bud_ka  = g11sq * bud_ka  + bkac
        bud_ke  = g11sq * bud_ke  + cke
        bud_k12 = g11sq * bud_k12 + ck12
        bud_k21 = g11sq * bud_k21 + ck21
        step = step + 1
    }
    argmax5(bud_f, bud_ka, bud_ke, bud_k12, bud_k21)
}

// ── Standard-scenario wrappers ────────────────────────────────────────────────
//
// ke=0.01118, k12=0.05, k21=0.005, Vc=75, D=10mg, dt=0.5h, n=48.
// ke_var=8.41e-6, k12_var=1.56e-4, k21_var=1.56e-6 (fixed population values).
// Only ka_var and f_var are varied for the budget analysis.

pub fn classify_standard_oral(ka_var: f64, f_var: f64) -> i64 with Epistemic, Mut, Div, Panic {
    classify_oral_trough(0.01118, 0.00000841, 0.05, 0.000156, 0.005, 0.0000016,
                         0.62, ka_var, 0.141, f_var, 10.0, 75.0, 0.5, 48)
}

pub fn conf_standard_oral(ka_var: f64, f_var: f64) -> i64 with Mut, Div, Panic {
    conf_oral_trough(0.01118, 0.00000841, 0.05, 0.000156, 0.005, 0.0000016,
                     0.62, ka_var, 0.141, f_var, 10.0, 75.0, 0.5, 48)
}

pub fn dom_standard_oral(ka_var: f64, f_var: f64) -> i64 with Mut, Div, Panic {
    dom_oral_trough(0.01118, 0.00000841, 0.05, 0.000156, 0.005, 0.0000016,
                    0.62, ka_var, 0.141, f_var, 10.0, 75.0, 0.5, 48)
}

// ── Composite analysis functions ──────────────────────────────────────────────

// Standard parameter values (reference constants)
pub fn oral_ka_var_std() -> f64 { 0.0225   }   // ka_var = (0.15)²
pub fn oral_f_var_std()  -> f64 { 0.001521 }   // F_var  = (0.039)²

// True iff ka (index 1) is the dominant uncertainty source.
pub fn oral_ka_dominant() -> bool with Mut, Div, Panic {
    dom_standard_oral(oral_ka_var_std(), oral_f_var_std()) == 1
}

// The Sprint 13 improvement gate:
//   baseline UNCERTAIN, targeted ka (÷4) THERAPEUTIC, blind F (÷4) UNCERTAIN,
//   and ka is the dominant source in the baseline.
pub fn oral_improvement_fires() -> bool with Epistemic, Mut, Div, Panic {
    let ka_std = oral_ka_var_std()
    let f_std  = oral_f_var_std()
    let dec_base = classify_standard_oral(ka_std, f_std)
    let dec_ka   = classify_standard_oral(ka_std / 4.0, f_std)
    let dec_f    = classify_standard_oral(ka_std, f_std / 4.0)
    let dom_base = dom_standard_oral(ka_std, f_std)
    dec_base == decision_uncertain()   &&
    dec_ka   == decision_therapeutic() &&
    dec_f    == decision_uncertain()   &&
    dom_base == 1
}
