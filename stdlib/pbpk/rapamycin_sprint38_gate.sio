// stdlib/pbpk/rapamycin_sprint38_gate.sio — Sprint 38 certification gate
//
// Certifies assay-inclusive dose windows: ind poor collapse, fast uncertifiable,
// CMIA uniform compression, D_max asymmetry.
//
// 56 assertions in sections A–H. All must pass (return 56).

module pbpk::rapamycin_sprint38_gate

use pbpk::rapamycin_assay_dose_window::{
    adw_std_dmin_model_n14, adw_std_dmin_hplc_n14, adw_std_dmin_cmia_n14, adw_std_dmin_poor_n14,
    adw_std_dmax_model_n14, adw_std_dmax_cmia_n14,
    adw_std_width_model_n14, adw_std_width_cmia_n14, adw_std_width_poor_n14,
    adw_std_dmin_poor_n7, adw_std_width_poor_n7,
    adw_fast_dmin_model_n14, adw_fast_dmin_cmia_n14, adw_fast_dmin_poor_n14,
    adw_fast_width_model_n14, adw_fast_width_cmia_n14, adw_fast_width_poor_n14,
    adw_inh_width_model_n14, adw_inh_width_cmia_n14, adw_inh_width_poor_n14,
    adw_ind_dmin_poor_n26, adw_ind_dmax_poor_n26, adw_ind_collapsed_poor_n26,
    adw_ind_width_model_n26, adw_ind_width_cmia_n26
}

pub fn rapamycin_sprint38_gate() -> i64 with Mut, Div, Panic {
    var score = 0

    // ── Section A: std N=14 model window (baseline) ───────────────────────────
    // D_min ≈ 2.503 mg
    if adw_std_dmin_model_n14() > 2.4 && adw_std_dmin_model_n14() < 2.6 { score = score + 1 };
    // D_max ≈ 8.625 mg
    if adw_std_dmax_model_n14() > 8.5 && adw_std_dmax_model_n14() < 8.7 { score = score + 1 };
    // Width ≈ 6.122 mg
    if adw_std_width_model_n14() > 6.0 && adw_std_width_model_n14() < 6.3 { score = score + 1 };
    // HPLC D_min ≈ 2.583 mg (slight increase)
    if adw_std_dmin_hplc_n14() > 2.55 && adw_std_dmin_hplc_n14() < 2.62 { score = score + 1 };
    // CMIA D_min ≈ 2.928 mg
    if adw_std_dmin_cmia_n14() > 2.9 && adw_std_dmin_cmia_n14() < 2.96 { score = score + 1 };
    // poor D_min ≈ 4.371 mg
    if adw_std_dmin_poor_n14() > 4.3 && adw_std_dmin_poor_n14() < 4.5 { score = score + 1 };
    // Monotone: model < HPLC < CMIA < poor
    if adw_std_dmin_model_n14() < adw_std_dmin_hplc_n14() { score = score + 1 };
    if adw_std_dmin_hplc_n14() < adw_std_dmin_cmia_n14() { score = score + 1 };
    if adw_std_dmin_cmia_n14() < adw_std_dmin_poor_n14() { score = score + 1 };

    // ── Section B: std N=14 window width compression ──────────────────────────
    // CMIA width ≈ 4.913 mg (−19.7% from model)
    if adw_std_width_cmia_n14() > 4.8 && adw_std_width_cmia_n14() < 5.0 { score = score + 1 };
    // poor width ≈ 2.291 mg (−62.6% from model)
    if adw_std_width_poor_n14() > 2.2 && adw_std_width_poor_n14() < 2.4 { score = score + 1 };
    // Width ordering: model > HPLC > CMIA > poor
    if adw_std_width_model_n14() > adw_std_width_cmia_n14() { score = score + 1 };
    if adw_std_width_cmia_n14() > adw_std_width_poor_n14() { score = score + 1 };
    // CMIA retains > 75% of model width; poor retains < 40%
    if adw_std_width_cmia_n14() > 0.75 * adw_std_width_model_n14() { score = score + 1 };
    if adw_std_width_poor_n14() < 0.40 * adw_std_width_model_n14() { score = score + 1 };

    // ── Section C: FINDING D — asymmetric compression at std N=14 ────────────
    // D_max CMIA shift = model − cmia ≈ 0.784 mg
    if adw_std_dmax_model_n14() - adw_std_dmax_cmia_n14() > 0.75 &&
       adw_std_dmax_model_n14() - adw_std_dmax_cmia_n14() < 0.85 { score = score + 1 };
    // D_min CMIA shift = cmia − model ≈ 0.425 mg
    if adw_std_dmin_cmia_n14() - adw_std_dmin_model_n14() > 0.40 &&
       adw_std_dmin_cmia_n14() - adw_std_dmin_model_n14() < 0.46 { score = score + 1 };
    // D_max shift > D_min shift (ceiling absorbs more uncertainty)
    if adw_std_dmax_model_n14() - adw_std_dmax_cmia_n14() >
       adw_std_dmin_cmia_n14() - adw_std_dmin_model_n14() { score = score + 1 };

    // ── Section D: FINDING C — fast 5mg below poor window at N=14 ────────────
    // fast model D_min ≈ 5.149 mg
    if adw_fast_dmin_model_n14() > 5.1 && adw_fast_dmin_model_n14() < 5.2 { score = score + 1 };
    // fast poor D_min ≈ 8.690 mg — above standard 5mg
    if adw_fast_dmin_poor_n14() > 8.6 && adw_fast_dmin_poor_n14() < 8.8 { score = score + 1 };
    // 5mg < fast poor D_min (standard dose uncertifiable)
    if 5.0 < adw_fast_dmin_poor_n14() { score = score + 1 };
    // fast CMIA D_min ≈ 5.877 mg (still above standard 5mg)
    if adw_fast_dmin_cmia_n14() > 5.8 && adw_fast_dmin_cmia_n14() < 5.95 { score = score + 1 };
    // fast CMIA D_min > 5mg as well
    if 5.0 < adw_fast_dmin_cmia_n14() { score = score + 1 };
    // fast model D_min already > 5mg (standard under-doses fast metabolizers even without assay error)
    if 5.0 < adw_fast_dmin_model_n14() { score = score + 1 };

    // ── Section E: FINDING B — CMIA uniform ~18-20% compression ─────────────
    // std width compression ratio: cmia/model ≈ 0.803
    if adw_std_width_cmia_n14() / adw_std_width_model_n14() > 0.79 &&
       adw_std_width_cmia_n14() / adw_std_width_model_n14() < 0.82 { score = score + 1 };
    // fast CMIA width ≈ 7.737 mg vs model 9.418 (ratio ≈ 0.822)
    if adw_fast_width_cmia_n14() > 7.6 && adw_fast_width_cmia_n14() < 7.9 { score = score + 1 };
    if adw_fast_width_model_n14() > 9.3 && adw_fast_width_model_n14() < 9.5 { score = score + 1 };
    // inh width compression: cmia ≈ 1.876, model ≈ 2.451 (ratio ≈ 0.765)
    if adw_inh_width_cmia_n14() > 1.85 && adw_inh_width_cmia_n14() < 1.91 { score = score + 1 };
    if adw_inh_width_model_n14() > 2.40 && adw_inh_width_model_n14() < 2.50 { score = score + 1 };
    // All CMIA/model ratios are between 0.75 and 0.85 (uniform 18-20% compression)
    if adw_inh_width_cmia_n14() / adw_inh_width_model_n14() > 0.75 &&
       adw_inh_width_cmia_n14() / adw_inh_width_model_n14() < 0.85 { score = score + 1 };

    // ── Section F: FINDING A — ind poor window collapse ───────────────────────
    // ind poor D_min ≈ 57.52 mg > D_max ≈ 49.86 mg → collapsed
    if adw_ind_collapsed_poor_n26() { score = score + 1 };
    if adw_ind_dmin_poor_n26() > adw_ind_dmax_poor_n26() { score = score + 1 };
    // D_min_poor ≈ 57.5 mg
    if adw_ind_dmin_poor_n26() > 55.0 && adw_ind_dmin_poor_n26() < 60.0 { score = score + 1 };
    // D_max_poor ≈ 49.9 mg
    if adw_ind_dmax_poor_n26() > 48.0 && adw_ind_dmax_poor_n26() < 52.0 { score = score + 1 };
    // ind model window (N=26) ≈ 23.05 mg wide
    if adw_ind_width_model_n26() > 22.0 && adw_ind_width_model_n26() < 24.0 { score = score + 1 };
    // ind CMIA width ≈ 16.906 (still open)
    if adw_ind_width_cmia_n26() > 16.0 && adw_ind_width_cmia_n26() < 17.5 { score = score + 1 };

    // ── Section G: std poor at N=7 — first-week uncertifiable ────────────────
    // std poor D_min at N=7 ≈ 7.199 mg (5mg standard dose is below window)
    if adw_std_dmin_poor_n7() > 7.0 && adw_std_dmin_poor_n7() < 7.4 { score = score + 1 };
    if 5.0 < adw_std_dmin_poor_n7() { score = score + 1 };
    // poor window width at N=7 ≈ 2.757 mg (narrow but non-empty)
    if adw_std_width_poor_n7() > 2.6 && adw_std_width_poor_n7() < 2.9 { score = score + 1 };
    // std poor D_min at N=7 > std poor D_min at N=14 (harder to certify early)
    if adw_std_dmin_poor_n7() > adw_std_dmin_poor_n14() { score = score + 1 };

    // ── Section H: Cross-stratum ordering ────────────────────────────────────
    // Across all strata at N=14, poor: all D_min > 0, all D_max > D_min
    if adw_std_width_poor_n14() > 0.0 { score = score + 1 };
    if adw_fast_width_poor_n14() > 0.0 { score = score + 1 };
    if adw_inh_width_poor_n14() > 0.0 { score = score + 1 };
    // fast poor width at N=14 ≈ 3.148 mg (largest poor width among non-ind strata)
    if adw_fast_width_poor_n14() > 3.0 && adw_fast_width_poor_n14() < 3.3 { score = score + 1 };
    // inh poor width ≈ 0.910 mg (smallest non-collapsed poor window)
    if adw_inh_width_poor_n14() > 0.85 && adw_inh_width_poor_n14() < 0.97 { score = score + 1 };
    // std poor D_min N=14 < fast poor D_min N=14 (std certifies at lower dose)
    if adw_std_dmin_poor_n14() < adw_fast_dmin_poor_n14() { score = score + 1 };
    // fast has wider window than std under every assay (wider therapeutic window due to pharmacokinetics)
    if adw_fast_width_model_n14() > adw_std_width_model_n14() { score = score + 1 };
    if adw_fast_width_cmia_n14() > adw_std_width_cmia_n14() { score = score + 1 };
    if adw_fast_width_poor_n14() > adw_std_width_poor_n14() { score = score + 1 };
    // inh has narrowest non-collapsed window under poor (0.91 mg)
    if adw_inh_width_poor_n14() < adw_std_width_poor_n14() { score = score + 1 };
    if adw_inh_width_poor_n14() < adw_fast_width_poor_n14() { score = score + 1 };
    // inh width narrows monotonically: model > cmia > poor
    if adw_inh_width_model_n14() > adw_inh_width_cmia_n14() { score = score + 1 };
    if adw_inh_width_cmia_n14() > adw_inh_width_poor_n14() { score = score + 1 };
    // ind model window is large (23 mg); CMIA still open (16.9 mg)
    if adw_ind_width_model_n26() > adw_ind_width_cmia_n26() { score = score + 1 };
    if adw_ind_width_cmia_n26() > 0.0 { score = score + 1 };
    // poor width at std N=14 is less than half the model width
    if adw_std_width_poor_n14() < adw_std_width_model_n14() / 2.0 { score = score + 1 };

    score
}
