// stdlib/pbpk/rapamycin_sprint66_gate.sio — Sprint 66 certification gate
//
// GUM-exact 3× loading dose: n_crit advancement and cert_span invariance across
// all five CYP3A4/P-gp strata (combined 4–20 window).
//
// Findings:
//   A: n_crit advances: std 6→4, slow 8→6, fast 7→5, inh 7→4, ind 26→24 (+2/+3)
//   B: cert_span INVARIANT: std=30, slow=50, fast=27 (exactly preserved)
//   C: inh span +1 (30→31); ind span +2 (74→76, scan boundary)
//   D: n_last contracts by 2 for std/slow/fast (ceiling binds earlier)
//   E: margin N=1 WARN for all strata (max 1.84 for inh); no day-1 certification
//   F: span-advance tradeoff: 2-day advance, 2-day n_last contraction = zero-sum
//   G: inh advance=3 (unique); all others advance=2
//   H: Policy: loading dose shifts window but does not widen it
//
// 56 assertions in sections A–H. All must pass (return 56).

module pbpk::rapamycin_sprint66_gate

use pbpk::rapamycin_loading_dose::{
    ld_std_margin_load_n1, ld_std_margin_load_n3, ld_std_margin_load_n7,
    ld_std_ncrit_load, ld_std_nlast_load, ld_std_span_load,
    ld_std_ncrit_uniform, ld_std_nlast_uniform, ld_std_span_uniform, ld_std_advance,
    ld_slow_margin_load_n1, ld_slow_margin_load_n7,
    ld_slow_ncrit_load, ld_slow_nlast_load, ld_slow_span_load,
    ld_slow_ncrit_uniform, ld_slow_nlast_uniform, ld_slow_span_uniform, ld_slow_advance,
    ld_fast_margin_load_n1, ld_fast_margin_load_n7,
    ld_fast_ncrit_load, ld_fast_nlast_load, ld_fast_span_load,
    ld_fast_ncrit_uniform, ld_fast_nlast_uniform, ld_fast_span_uniform, ld_fast_advance,
    ld_inh_margin_load_n1, ld_inh_margin_load_n7,
    ld_inh_ncrit_load, ld_inh_nlast_load, ld_inh_span_load,
    ld_inh_ncrit_uniform, ld_inh_nlast_uniform, ld_inh_span_uniform, ld_inh_advance,
    ld_ind_margin_load_n1, ld_ind_margin_load_n7,
    ld_ind_ncrit_load, ld_ind_nlast_load, ld_ind_span_load,
    ld_ind_ncrit_uniform, ld_ind_nlast_uniform, ld_ind_span_uniform, ld_ind_advance
}

pub fn rapamycin_sprint66_gate() -> i64 with Mut, Div, Panic {
    var score = 0

    // ── Section A: n_crit advances for all strata (Finding A) ────────────────
    if ld_std_advance()  == 2 { score = score + 1 };
    if ld_slow_advance() == 2 { score = score + 1 };
    if ld_fast_advance() == 2 { score = score + 1 };
    if ld_inh_advance()  == 3 { score = score + 1 };
    if ld_ind_advance()  == 2 { score = score + 1 };
    if ld_std_ncrit_load()  == 4  { score = score + 1 };
    if ld_inh_ncrit_load()  == 4  { score = score + 1 };

    // ── Section B: cert_span invariant for std/slow/fast (Finding B) ─────────
    if ld_std_span_load()  == ld_std_span_uniform()  { score = score + 1 };
    if ld_slow_span_load() == ld_slow_span_uniform() { score = score + 1 };
    if ld_fast_span_load() == ld_fast_span_uniform() { score = score + 1 };
    if ld_std_span_load()  == 30 { score = score + 1 };
    if ld_slow_span_load() == 50 { score = score + 1 };
    if ld_fast_span_load() == 27 { score = score + 1 };
    if ld_std_span_uniform() == 30 { score = score + 1 };

    // ── Section C: n_crit and n_last values (Finding A, D) ───────────────────
    if ld_std_ncrit_load()  == 4  { score = score + 1 };
    if ld_slow_ncrit_load() == 6  { score = score + 1 };
    if ld_fast_ncrit_load() == 5  { score = score + 1 };
    if ld_ind_ncrit_load()  == 24 { score = score + 1 };
    if ld_std_nlast_load()  == 34 { score = score + 1 };
    if ld_slow_nlast_load() == 56 { score = score + 1 };
    if ld_fast_nlast_load() == 32 { score = score + 1 };

    // ── Section D: n_last contracts vs uniform for std/slow/fast (Finding D) ─
    if ld_std_nlast_load()  < ld_std_nlast_uniform()  { score = score + 1 };
    if ld_slow_nlast_load() < ld_slow_nlast_uniform() { score = score + 1 };
    if ld_fast_nlast_load() < ld_fast_nlast_uniform() { score = score + 1 };
    let std_nlast_delta = ld_std_nlast_uniform() - ld_std_nlast_load()
    if std_nlast_delta == 2 { score = score + 1 };
    let slow_nlast_delta = ld_slow_nlast_uniform() - ld_slow_nlast_load()
    if slow_nlast_delta == 2 { score = score + 1 };
    let fast_nlast_delta = ld_fast_nlast_uniform() - ld_fast_nlast_load()
    if fast_nlast_delta == 2 { score = score + 1 };
    if ld_std_advance() == std_nlast_delta { score = score + 1 };

    // ── Section E: no day-1 certification for any stratum (Finding E) ────────
    if ld_std_margin_load_n1()  < 2.0 { score = score + 1 };
    if ld_slow_margin_load_n1() < 2.0 { score = score + 1 };
    if ld_fast_margin_load_n1() < 2.0 { score = score + 1 };
    if ld_inh_margin_load_n1()  < 2.0 { score = score + 1 };
    if ld_ind_margin_load_n1()  < 2.0 { score = score + 1 };
    if ld_inh_margin_load_n1()  > 1.8 { score = score + 1 };
    if ld_std_margin_load_n3()  < 2.0 { score = score + 1 };

    // ── Section F: inh exception — advance=3, span+1 (Finding C) ─────────────
    if ld_inh_advance() > ld_std_advance()   { score = score + 1 };
    if ld_inh_advance() > ld_slow_advance()  { score = score + 1 };
    if ld_inh_span_load() > ld_inh_span_uniform() { score = score + 1 };
    if ld_inh_nlast_load() == 35 { score = score + 1 };
    if ld_inh_span_load()  == 31 { score = score + 1 };
    if ld_inh_nlast_uniform() == 37 { score = score + 1 };
    if ld_inh_margin_load_n7() > 2.0 { score = score + 1 };

    // ── Section G: ind stratum (Finding A, B) ─────────────────────────────────
    if ld_ind_advance()      == 2  { score = score + 1 };
    if ld_ind_ncrit_uniform() == 26 { score = score + 1 };
    if ld_ind_ncrit_load()    == 24 { score = score + 1 };
    if ld_ind_nlast_load()    == 100 { score = score + 1 };
    if ld_ind_span_load()     > ld_ind_span_uniform() { score = score + 1 };
    if ld_ind_margin_load_n7() > ld_ind_margin_load_n1() { score = score + 1 };
    if ld_std_margin_load_n7() > 2.0 { score = score + 1 };

    // ── Section H: all advances ≥ 2; no stratum gets zero advance (Finding F) ─
    if ld_std_advance()  >= 2 { score = score + 1 };
    if ld_slow_advance() >= 2 { score = score + 1 };
    if ld_fast_advance() >= 2 { score = score + 1 };
    if ld_inh_advance()  >= 2 { score = score + 1 };
    if ld_ind_advance()  >= 2 { score = score + 1 };
    if ld_inh_advance()  > ld_ind_advance()  { score = score + 1 };
    if ld_slow_margin_load_n7() > 2.0 { score = score + 1 };

    score
}
