    let k12=ob_k12_var_std(); let k21=ob_k21_var_std()
    adw_d_max(34.0, 26, 0.05590, 0.047, ka, fv, ke_ind, k12, k21, as_cv_poor())
}
pub fn adw_ind_collapsed_poor_n26() -> bool with Mut, Div, Panic {
    let ka=ob_ka_var_std(); let fv=ob_f_var_std(); let ke_ind=ob_ke_var_ind()
    let k12=ob_k12_var_std(); let k21=ob_k21_var_std()
    adw_collapsed(34.0, 26, 0.05590, 0.047, ka, fv, ke_ind, k12, k21, as_cv_poor())
}
