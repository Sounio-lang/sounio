// ── ind D34 N=26 — FINDING A: poor collapses ─────────────────────────────────

pub fn adw_ind_dmin_poor_n26() -> f64 with Mut, Div, Panic {
    let ka=ob_ka_var_std(); let fv=ob_f_var_std(); let ke_ind=ob_ke_var_ind()
    let k12=ob_k12_var_std(); let k21=ob_k21_var_std()
    adw_d_min(34.0, 26, 0.05590, 0.047, ka, fv, ke_ind, k12, k21, as_cv_poor())
}
