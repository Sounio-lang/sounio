// stdlib/pbpk/rapamycin_sprint36_gate.sio — Sprint 36 certification gate
//
// Certifies assay-inclusive sigma-distance: Gold theorem fragility, fast N=15
// HPLC survival, inh CMIA failure, std poor-assay failure.
//
// 56 assertions in sections A–H. All must pass (return 56).

module pbpk::rapamycin_sprint36_gate

use pbpk::rapamycin_assay_impact::{
    ai_std_zf_hplc_n7, ai_std_zf_cmia_n7, ai_std_zf_poor_n7,
    ai_std_zf_hplc_n14, ai_std_zf_cmia_n14, ai_std_zf_poor_n14,
    ai_inh_zf_hplc_n7, ai_inh_zf_cmia_n7, ai_inh_zf_poor_n7, ai_inh_zf_hplc_n14,
    ai_fast_zf_hplc_n15, ai_fast_zf_cmia_n15, ai_fast_zf_poor_n15,
    ai_ind_zf_hplc_n26, ai_ind_zf_cmia_n26, ai_ind_zf_poor_n26, ai_ind_zc_hplc_n26,
    ai_slow_zf_hplc_n14, ai_slow_zf_poor_n14
}

pub fn rapamycin_sprint36_gate() -> i64 with Mut, Div, Panic {
    var score = 0

    // ── Section A: std N=7 assay matrix ──────────────────────────────────────
    // HPLC: Z_floor ≈ 2.641 — CERT
    if ai_std_zf_hplc_n7() > 2.6 && ai_std_zf_hplc_n7() < 2.7 { score = score + 1 };
    if ai_std_zf_hplc_n7() >= 2.0 { score = score + 1 };
    // CMIA: Z_floor ≈ 2.097 — still CERT but reduced
    if ai_std_zf_cmia_n7() > 2.0 && ai_std_zf_cmia_n7() < 2.2 { score = score + 1 };
    if ai_std_zf_cmia_n7() >= 2.0 { score = score + 1 };
    // FINDING D — poor assay: Z_floor ≈ 1.327 — FAIL
    if ai_std_zf_poor_n7() > 1.2 && ai_std_zf_poor_n7() < 1.4 { score = score + 1 };
    if ai_std_zf_poor_n7() < 2.0 { score = score + 1 };
    // Ordering: model > HPLC > CMIA > poor
    if ai_std_zf_hplc_n7() > ai_std_zf_cmia_n7() { score = score + 1 };
    if ai_std_zf_cmia_n7() > ai_std_zf_poor_n7() { score = score + 1 };

    // ── Section B: std N=14 — robust across all assays ────────────────────────
    // HPLC: Z_floor ≈ 5.651 — robustly CERT
    if ai_std_zf_hplc_n14() > 5.5 && ai_std_zf_hplc_n14() < 5.8 { score = score + 1 };
    if ai_std_zf_hplc_n14() >= 2.0 { score = score + 1 };
    // CMIA: Z_floor ≈ 3.913 — CERT
    if ai_std_zf_cmia_n14() > 3.8 && ai_std_zf_cmia_n14() < 4.0 { score = score + 1 };
    if ai_std_zf_cmia_n14() >= 2.0 { score = score + 1 };
    // poor: Z_floor ≈ 2.221 — still CERT even with worst assay
    if ai_std_zf_poor_n14() > 2.1 && ai_std_zf_poor_n14() < 2.4 { score = score + 1 };
    if ai_std_zf_poor_n14() >= 2.0 { score = score + 1 };

    // ── Section C: FINDING C — inh N=7 CMIA failure ─────────────────────────
    // HPLC: Z_floor ≈ 2.615 — CERT
    if ai_inh_zf_hplc_n7() > 2.5 && ai_inh_zf_hplc_n7() < 2.7 { score = score + 1 };
    if ai_inh_zf_hplc_n7() >= 2.0 { score = score + 1 };
    // CMIA: Z_floor ≈ 1.622 — FAIL (routine immunoassay incompatible)
    if ai_inh_zf_cmia_n7() > 1.5 && ai_inh_zf_cmia_n7() < 1.7 { score = score + 1 };
    if ai_inh_zf_cmia_n7() < 2.0 { score = score + 1 };
    // poor: Z_floor ≈ 0.868 — FAIL (deeply)
    if ai_inh_zf_poor_n7() > 0.8 && ai_inh_zf_poor_n7() < 0.95 { score = score + 1 };
    if ai_inh_zf_poor_n7() < 2.0 { score = score + 1 };
    // inh at N=14 survives HPLC robustly (Z ≈ 7.15)
    if ai_inh_zf_hplc_n14() > 7.0 { score = score + 1 };
    // Gap: HPLC minus CMIA at inh N=7 > 0.9σ
    if ai_inh_zf_hplc_n7() - ai_inh_zf_cmia_n7() > 0.9 { score = score + 1 };

    // ── Section D: FINDING B — fast N=15 HPLC survivor ───────────────────────
    // HPLC: Z_floor ≈ 2.003 — barely CERT (margin = 0.003σ)
    if ai_fast_zf_hplc_n15() > 1.99 && ai_fast_zf_hplc_n15() < 2.02 { score = score + 1 };
    if ai_fast_zf_hplc_n15() >= 2.0 { score = score + 1 };
    // HPLC margin above threshold is tiny: 0.003σ
    if ai_fast_zf_hplc_n15() - 2.0 < 0.01 { score = score + 1 };
    // CMIA: Z_floor ≈ 1.591 — FAIL
    if ai_fast_zf_cmia_n15() > 1.5 && ai_fast_zf_cmia_n15() < 1.7 { score = score + 1 };
    if ai_fast_zf_cmia_n15() < 2.0 { score = score + 1 };
    // poor: Z_floor ≈ 1.008 — FAIL (barely above 1.0)
    if ai_fast_zf_poor_n15() > 0.95 && ai_fast_zf_poor_n15() < 1.1 { score = score + 1 };
    if ai_fast_zf_poor_n15() < 2.0 { score = score + 1 };

    // ── Section E: FINDING A — Gold theorem fragility ────────────────────────
    // ind D34 N=26 model CERT (Z=2.015), HPLC FAIL (Z=1.976)
    // HPLC: Z_floor ≈ 1.976 — FAIL even under gold-standard assay
    if ai_ind_zf_hplc_n26() > 1.96 && ai_ind_zf_hplc_n26() < 1.99 { score = score + 1 };
    if ai_ind_zf_hplc_n26() < 2.0 { score = score + 1 };
    // HPLC failure margin: 2.0 - 1.976 ≈ 0.024σ (close but uncertified)
    if 2.0 - ai_ind_zf_hplc_n26() > 0.02 && 2.0 - ai_ind_zf_hplc_n26() < 0.04 { score = score + 1 };
    // CMIA: Z_floor ≈ 1.814 — deeper FAIL
    if ai_ind_zf_cmia_n26() > 1.8 && ai_ind_zf_cmia_n26() < 1.83 { score = score + 1 };
    if ai_ind_zf_cmia_n26() < 2.0 { score = score + 1 };
    // poor: Z_floor ≈ 1.420 — FAIL
    if ai_ind_zf_poor_n26() > 1.3 && ai_ind_zf_poor_n26() < 1.5 { score = score + 1 };
    // Z_ceil remains certified under HPLC (ceiling not a problem for inducer)
    if ai_ind_zc_hplc_n26() > 5.8 { score = score + 1 };

    // ── Section F: Assay penalty ordering ────────────────────────────────────
    // Penalty worsens: HPLC < CMIA < poor (for every stratum)
    if ai_std_zf_hplc_n14() > ai_std_zf_cmia_n14() { score = score + 1 };
    if ai_std_zf_cmia_n14() > ai_std_zf_poor_n14() { score = score + 1 };
    if ai_inh_zf_hplc_n7() > ai_inh_zf_cmia_n7() { score = score + 1 };
    if ai_inh_zf_cmia_n7() > ai_inh_zf_poor_n7() { score = score + 1 };
    if ai_fast_zf_hplc_n15() > ai_fast_zf_cmia_n15() { score = score + 1 };
    if ai_fast_zf_cmia_n15() > ai_fast_zf_poor_n15() { score = score + 1 };
    if ai_ind_zf_hplc_n26() > ai_ind_zf_cmia_n26() { score = score + 1 };

    // ── Section G: Assay survival ranking by stratum ─────────────────────────
    // std N=14 is most robust — survives even poor assay
    if ai_std_zf_poor_n14() > ai_fast_zf_poor_n15() { score = score + 1 };
    if ai_std_zf_poor_n14() > ai_inh_zf_poor_n7() { score = score + 1 };
    // inh N=7 is more assay-sensitive than std N=7 (inh smaller margin initially)
    if ai_inh_zf_cmia_n7() < 2.0 && ai_std_zf_cmia_n7() >= 2.0 { score = score + 1 };
    // ind at N=26 HPLC Z falls below HPLC Z for std at N=7 (fragility)
    if ai_ind_zf_hplc_n26() < ai_std_zf_hplc_n7() { score = score + 1 };
    // ind assay penalty (model−HPLC) larger than fast N=15 assay penalty
    if 2.0 - ai_ind_zf_hplc_n26() > ai_fast_zf_hplc_n15() - 2.0 { score = score + 1 };
    // inh at N=14 HPLC Z > inh at N=7 HPLC Z (margin grows with N)
    if ai_inh_zf_hplc_n14() > ai_inh_zf_hplc_n7() { score = score + 1 };
    // slow N=14 remains certified even under poor assay (large model margin)
    if ai_slow_zf_poor_n14() >= 2.0 { score = score + 1 };
    // slow HPLC Z > std HPLC Z at N=14 (slow has larger floor margin)
    if ai_slow_zf_hplc_n14() > ai_std_zf_hplc_n14() { score = score + 1 };

    // ── Section H: Structural properties ────────────────────────────────────
    // All assay Z values are positive (point estimate never subtherapeutic here)
    if ai_std_zf_poor_n7() > 0.0 { score = score + 1 };
    if ai_inh_zf_poor_n7() > 0.0 { score = score + 1 };
    // HPLC always tightest CI (smallest u_total) → largest Z
    if ai_std_zf_hplc_n7() > ai_std_zf_cmia_n7() { score = score + 1 };
    // ind HPLC fail is a direct consequence of near-boundary model CERT (2.015σ)
    // Gold theorem: model Z - HPLC Z = 2.015 - 1.976 ≈ 0.039 < 0.05
    // (assay penalty for ind is small but just crosses threshold)
    if ai_ind_zf_hplc_n26() > 1.95 { score = score + 1 };
    // Fast N=15 HPLC margin (0.003σ) is smaller than ind HPLC gap from threshold (0.024σ)
    if ai_fast_zf_hplc_n15() - 2.0 < 2.0 - ai_ind_zf_hplc_n26() { score = score + 1 };

    score
}
