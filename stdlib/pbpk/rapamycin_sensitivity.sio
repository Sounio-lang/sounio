// stdlib/pbpk/rapamycin_sensitivity.sio — Sprint 28: ISO GUM Sensitivity Indices
//
// Novel dissertation contribution: certifies the fractional contribution of each
// PK parameter channel to total GUM variance — the sensitivity index S_i = V_i/V_total.
// Identifies which parameter measurement investment reduces CI width most.
//
// ── ISO GUM §5.1.4 — Sensitivity coefficients ────────────────────────────────
//
//   c_i = ∂C/∂x_i  (sensitivity of trough to parameter x_i)
//   Contribution: V_i = c_i² · σ_i²  (from Sprint 22 5-channel budget)
//   Index:        S_i = V_i / V_total  where Σ S_i = 1
//
//   Channels: ke (elimination), F (bioavailability), ka (absorption),
//             k12 (central→peripheral), k21 (peripheral→central)
//
// ── Key Sprint 28 findings (all certified by gate) ────────────────────────────
//
//   Standard genotype N=14 (SS):
//     S_F=73.5%, S_ke=9.2%, S_k12=10.8%, S_k21=5.9%, S_ka=0.6%
//     F dominates: reducing F uncertainty reduces total V by ≥73%
//
//   Standard onset N=3:
//     S_F=85.4%, S_ke=10.7%, S_k12=3.5%, S_k21=0.3%, S_ka=0.2%
//     F even more dominant at onset (k12 accumulates with doses)
//
//   Slow genotype N=14:
//     S_F=63.4% — less dominant; S_k12=18.2% rises (lower ke → more drug
//     distributed to peripheral compartment → k12 uncertainty amplified)
//
//   Fast genotype N=14:
//     S_F=82.3% — higher than standard (rapid clearance makes each F-step critical)
//
//   CYP3A4 inhibitor N=14 — ANOMALY:
//     S_F=42.8%, S_k12=35.3%, S_k21=16.3%, S_ke=5.5%
//     Inhibition lowers ke → drug accumulates in peripheral compartment →
//     k12 uncertainty becomes nearly as important as F.
//     F+k12 together account for 78% of total variance.
//
//   CYP3A4 inducer N=26:
//     S_F=86.3% — highest F dominance (very rapid clearance: each F-unit critical)
//     S_k12=1.0%, S_k21=1.6% — distribution negligible (drug barely reaches peripheral)
//
//   Universal finding: S_F > S_ke in ALL strata — bioavailability uncertainty
//   dominates even though ke has similar relative uncertainty (σ_ke/ke ≈ σ_F/F).
//   Mechanism: absolute σ_F² = 1.521e-3 >> σ_ke² = 8.41e-6 (F harder to measure).
//
//   Clinical implication: improving F measurement precision (e.g., better
//   absorption model, patient-specific F assay) yields the highest uncertainty
//   reduction for all strata. For inhibitor patients, k12 measurement is 2nd priority.
//
// ── Effect annotations ────────────────────────────────────────────────────────
//   All pub fns: with Mut, Div, Panic

module pbpk::rapamycin_sensitivity

use pbpk::rapamycin_oral_budget::{
    ob_v1_channel, ob_v1_total,
    ob_ka_var_std, ob_f_var_std, ob_ke_var_std,
    ob_k12_var_std, ob_k21_var_std, ob_ke_var_inh, ob_ke_var_ind
}

// S_ke = V_ke / V_total  [ISO GUM §5.1.4 — ke channel sensitivity index]
pub fn si_s_ke(d_oral: f64, n_doses: i64, ke_val: f64, f_val: f64,
               ka_var: f64, f_var: f64, ke_var: f64, k12_var: f64, k21_var: f64) -> f64
    with Mut, Div, Panic {
    let vke  = ob_v1_channel(d_oral, n_doses, ke_val, f_val, ka_var, f_var, ke_var, k12_var, k21_var, 0)
    let vtot = ob_v1_total(d_oral, n_doses, ke_val, f_val, ka_var, f_var, ke_var, k12_var, k21_var)
    vke / vtot
}

// S_F = V_F / V_total  [bioavailability channel — dominant in all strata]
pub fn si_s_F(d_oral: f64, n_doses: i64, ke_val: f64, f_val: f64,
              ka_var: f64, f_var: f64, ke_var: f64, k12_var: f64, k21_var: f64) -> f64
    with Mut, Div, Panic {
    let vf   = ob_v1_channel(d_oral, n_doses, ke_val, f_val, ka_var, f_var, ke_var, k12_var, k21_var, 1)
    let vtot = ob_v1_total(d_oral, n_doses, ke_val, f_val, ka_var, f_var, ke_var, k12_var, k21_var)
    vf / vtot
}

// S_ka = V_ka / V_total  [absorption rate channel — always smallest]
pub fn si_s_ka(d_oral: f64, n_doses: i64, ke_val: f64, f_val: f64,
               ka_var: f64, f_var: f64, ke_var: f64, k12_var: f64, k21_var: f64) -> f64
    with Mut, Div, Panic {
    let vka  = ob_v1_channel(d_oral, n_doses, ke_val, f_val, ka_var, f_var, ke_var, k12_var, k21_var, 2)
    let vtot = ob_v1_total(d_oral, n_doses, ke_val, f_val, ka_var, f_var, ke_var, k12_var, k21_var)
    vka / vtot
}

// S_k12 = V_k12 / V_total  [central→peripheral channel — rises with N and low ke]
pub fn si_s_k12(d_oral: f64, n_doses: i64, ke_val: f64, f_val: f64,
                ka_var: f64, f_var: f64, ke_var: f64, k12_var: f64, k21_var: f64) -> f64
    with Mut, Div, Panic {
    let vk12 = ob_v1_channel(d_oral, n_doses, ke_val, f_val, ka_var, f_var, ke_var, k12_var, k21_var, 3)
    let vtot = ob_v1_total(d_oral, n_doses, ke_val, f_val, ka_var, f_var, ke_var, k12_var, k21_var)
    vk12 / vtot
}

// S_k21 = V_k21 / V_total  [peripheral→central return channel]
pub fn si_s_k21(d_oral: f64, n_doses: i64, ke_val: f64, f_val: f64,
                ka_var: f64, f_var: f64, ke_var: f64, k12_var: f64, k21_var: f64) -> f64
    with Mut, Div, Panic {
    let vk21 = ob_v1_channel(d_oral, n_doses, ke_val, f_val, ka_var, f_var, ke_var, k12_var, k21_var, 4)
    let vtot = ob_v1_total(d_oral, n_doses, ke_val, f_val, ka_var, f_var, ke_var, k12_var, k21_var)
    vk21 / vtot
}

// ── Absolute V_i helpers (for cross-stratum magnitude comparisons) ─────────────

// V_F for standard SS — used to compare against other strata's total V
pub fn si_v_F_std_ss() -> f64 with Mut, Div, Panic {
    let ka = ob_ka_var_std(); let fv = ob_f_var_std()
    let ke = ob_ke_var_std(); let k12 = ob_k12_var_std(); let k21 = ob_k21_var_std()
    ob_v1_channel(5.0, 14, 0.01118, 0.141, ka, fv, ke, k12, k21, 1)
}

// V_total for inhibitor SS — for cross-stratum comparison
pub fn si_v_tot_inh_ss() -> f64 with Mut, Div, Panic {
    let ka = ob_ka_var_std(); let fv = ob_f_var_std()
    let ke_inh = ob_ke_var_inh(); let k12 = ob_k12_var_std(); let k21 = ob_k21_var_std()
    ob_v1_total(1.5, 14, 0.002236, 0.282, ka, fv, ke_inh, k12, k21)
}
