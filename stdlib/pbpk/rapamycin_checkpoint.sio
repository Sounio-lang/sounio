// Finding B: slow D=5mg C > ceil at N=26 (toxic accumulation)
pub fn cp_slow_toxic_n26() -> bool with Mut, Div, Panic {
    cp_c_above_ceil(5.0, 26, 0.00838, 0.188)
}

