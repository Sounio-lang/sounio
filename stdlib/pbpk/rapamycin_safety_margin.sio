// stdlib/pbpk/rapamycin_safety_margin.sio — Sprint 34: Sigma-Distance Safety Margins
//
// Novel dissertation contribution: quantifies the distance from each therapeutic
// boundary in units of u_c (sigma-distance), converting binary CERT/FAIL into
// a continuous safety margin Z ∈ (−∞, +∞). Certification iff min(Z_floor, Z_ceil) ≥ k=2.
//
// ── Sigma-Distance Safety Margin ─────────────────────────────────────────────
//
//   Z_floor(N) = (C(N) − floor) / u_c(N)  — σ above the subtherapeutic boundary
//   Z_ceil(N)  = (ceil − C(N))  / u_c(N)  — σ below the toxic boundary
//   Z_margin   = min(Z_floor, Z_ceil)      — binding constraint
//
//   CI certified iff Z_margin ≥ k = 2.0  (ISO GUM coverage factor)
//
//   Interpretation:
//     Z < 0        → point estimate outside boundary (subtherapeutic or toxic)
//     0 ≤ Z < 2.0  → point estimate in range, CI not certified (straddles boundary)
//     Z ≥ 2.0      → CI fully certified on this side
//
// ── Certified Sigma-Distance Values at Protocol Checkpoints ──────────────────
//
//   Standard genotype (D=5mg):
//     N=7:  Z_floor=2.821, Z_ceil=15.899, binding=floor, CERT
//     N=14: Z_floor=6.432, Z_ceil=11.333, binding=floor, CERT
//     N=26: Z_floor=10.622,Z_ceil=5.456,  binding=CEIL←  CERT (binding rotates!)
//
//   Slow genotype (D=5mg):
//     N=14: Z_floor=10.106,Z_ceil=5.315,  binding=CEIL   CERT
//     N=26: Z_floor=14.733,Z_ceil=−1.683, TOXIC (Z_ceil < 0 → C > ceil)
//
//   Fast genotype (D=5mg):
//     N=7:  Z_floor=−0.538 SUB (C < floor — not merely uncertified)
//     N=14: Z_floor=1.844,  Z_ceil=19.626, FAIL by 0.156σ — fast gap quantification
//     N=15: Z_floor=2.139,  Z_ceil=19.260, CERT (0.139σ above threshold)
//     N=26: Z_floor=4.758,  Z_ceil=15.863, CERT
//
//   Inhibitor (D=1.5mg):
//     N=6: Z_floor=1.986, FAIL by 0.014σ — razor-edge near-miss
//     N=7: Z_floor=3.210, Z_ceil=40.896, CERT (+1.224σ jump from N=6)
//
//   Inducer D=34mg:
//     N=26: Z_floor=2.015, Z_ceil=6.043, CERT by 0.015σ — Gold theorem confirmed
//
// ── Novel Safety Findings ─────────────────────────────────────────────────────
//
//   FINDING A — FAST GAP (σ-quantification): The fast metabolizer at N=14 fails
//   certification by exactly 0.156σ. The margin at N=15 is +0.139σ. The "one-dose
//   gap" from Sprint 32 has a sigma magnitude: the transition spans 0.295σ.
//
//   FINDING B — INHIBITOR RAZOR EDGE: At N=6, Z_floor=1.986 (fails by 0.014σ).
//   This is the closest any stratum comes to the k=2.0 threshold at a FAIL point.
//   The jump to N=7 (Z_floor=3.210) represents +1.224σ — disproportionately large.
//
//   FINDING C — STANDARD BINDING SWITCH: At N=7 and N=14, Z_floor is the binding
//   constraint for std (drug is far from ceiling). At N=26, Z_ceil=5.456 < Z_floor
//   — the binding constraint rotates to the ceiling as drug accumulates.
//
//   FINDING D — GOLD THEOREM (σ-precision): Inducer D=34mg at N=26: Z_floor=2.015,
//   certified by 0.015σ above the threshold. The compilation-certified dose (Sprint 27)
//   achieves certification at the compilation-certified N (Sprint 29) by 0.015σ.
//
// ── Effect annotations ────────────────────────────────────────────────────────
//   All sm_* functions: with Mut, Div, Panic

module pbpk::rapamycin_safety_margin

use pbpk::rapamycin_assay::{as_trough_mg_l}
use pbpk::rapamycin_expanded_u::{eu_u_c}
use pbpk::rapamycin_clinical::{trough_floor_mg_l, trough_ceil_mg_l}
use pbpk::rapamycin_oral_budget::{
    ob_ka_var_std, ob_f_var_std, ob_ke_var_std, ob_k12_var_std, ob_k21_var_std,
    ob_ke_var_inh, ob_ke_var_ind
}

// ── Core sigma-distance primitives ───────────────────────────────────────────

pub fn sm_z_floor(d_oral: f64, n: i64, ke_val: f64, f_val: f64,
                  ka_var: f64, f_var: f64, ke_var: f64,
                  k12_var: f64, k21_var: f64) -> f64
    with Mut, Div, Panic {
    let c  = as_trough_mg_l(d_oral, n, ke_val, f_val)
    let uc = eu_u_c(d_oral, n, ke_val, f_val, ka_var, f_var, ke_var, k12_var, k21_var)
    (c - trough_floor_mg_l()) / uc
}

pub fn sm_z_ceil(d_oral: f64, n: i64, ke_val: f64, f_val: f64,
                 ka_var: f64, f_var: f64, ke_var: f64,
                 k12_var: f64, k21_var: f64) -> f64
    with Mut, Div, Panic {
    let c  = as_trough_mg_l(d_oral, n, ke_val, f_val)
    let uc = eu_u_c(d_oral, n, ke_val, f_val, ka_var, f_var, ke_var, k12_var, k21_var)
    (trough_ceil_mg_l() - c) / uc
}

// Binding safety margin: min(Z_floor, Z_ceil)
pub fn sm_margin(d_oral: f64, n: i64, ke_val: f64, f_val: f64,
                 ka_var: f64, f_var: f64, ke_var: f64,
                 k12_var: f64, k21_var: f64) -> f64
    with Mut, Div, Panic {
    let zf = sm_z_floor(d_oral, n, ke_val, f_val, ka_var, f_var, ke_var, k12_var, k21_var)
    let zc = sm_z_ceil( d_oral, n, ke_val, f_val, ka_var, f_var, ke_var, k12_var, k21_var)
    if zf < zc { zf } else { zc }
}

// True iff floor is the binding constraint (Z_floor < Z_ceil)
pub fn sm_binding_floor(d_oral: f64, n: i64, ke_val: f64, f_val: f64,
                         ka_var: f64, f_var: f64, ke_var: f64,
                         k12_var: f64, k21_var: f64) -> bool
    with Mut, Div, Panic {
    sm_z_floor(d_oral, n, ke_val, f_val, ka_var, f_var, ke_var, k12_var, k21_var) <
    sm_z_ceil( d_oral, n, ke_val, f_val, ka_var, f_var, ke_var, k12_var, k21_var)
}

// ── Standard genotype (D=5mg) ─────────────────────────────────────────────────

pub fn sm_std_zf_n7()  -> f64 with Mut, Div, Panic {
    let ka=ob_ka_var_std(); let fv=ob_f_var_std(); let ke=ob_ke_var_std()
    let k12=ob_k12_var_std(); let k21=ob_k21_var_std()
    sm_z_floor(5.0, 7, 0.01118, 0.141, ka, fv, ke, k12, k21)
}
