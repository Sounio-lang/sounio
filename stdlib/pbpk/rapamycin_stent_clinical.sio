        k12_val: p0.k12_val  k12_var: p0.k12_var
        k21_val: p0.k21_val  k21_var: p0.k21_var * k21_scale
        vc_val: p0.vc_val
        krel_val: p0.krel_val  krel_var: p0.krel_var
