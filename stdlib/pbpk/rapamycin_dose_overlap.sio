// stdlib/pbpk/rapamycin_dose_overlap.sio — Sprint 33: Cross-Stratum Dose Overlap
//
// Novel dissertation contribution: for each pair (and triple) of genotype strata,
// certifies whether a single dose D exists that is simultaneously CI-certified for
// both strata at N=14 — without requiring pharmacogenomic testing.
//
// ── Cross-Stratum Certifiable Dose Overlap Theorem ───────────────────────────
//
//   Given stratum i with certifiable window [D_min_i, D_max_i] (Sprint 27):
//     Overlap(i,j) = [max(D_min_i, D_min_j), min(D_max_i, D_max_j)]
//     Overlap is non-empty iff max(D_min_i, D_min_j) < min(D_max_i, D_max_j).
//
// ── Certifiable Dose Windows at N=14 ─────────────────────────────────────────
//
//   Standard (ke=0.01118, F=0.141): [2.503, 8.625] mg
//   Slow     (ke=0.00838, F=0.188): [1.612, 6.038] mg
//   Fast     (ke=0.01677, F=0.094): [5.149, 14.567] mg
//   Inhibitor(ke=0.002236,F=0.282): [0.805, 3.256] mg
//
// ── Pairwise Overlaps at N=14 ─────────────────────────────────────────────────
//
//   Slow ∩ Std:  [2.503, 6.038] — width 3.536 mg   (EXISTS)
//   Std  ∩ Fast: [5.149, 8.625] — width 3.476 mg   (EXISTS)
//   Slow ∩ Fast: [5.149, 6.038] — width 0.889 mg   (EXISTS — very narrow)
//   Inh  ∩ Slow: [1.612, 3.256] — width 1.644 mg   (EXISTS)
//   Inh  ∩ Std:  [2.503, 3.256] — width 0.753 mg   (EXISTS — narrow)
//   Inh  ∩ Fast: EMPTY (fast D_min=5.149 > inh D_max=3.256)
//     → IMPOSSIBILITY THEOREM: fast and inhibitor patients cannot share
//       a single CI-certified rapamycin dose. Genotyping is mandatory.
//
// ── Triple Overlap (Genotype-Naive Safe Zone) ─────────────────────────────────
//
//   Slow ∩ Std ∩ Fast at N=14: [5.149, 6.038] mg — width 0.889 mg
//   Midpoint: 5.594 mg — the optimal genotype-naive prescription for
//   patients whose CYP3A5 genotype is unknown among std/slow/fast.
//   The 5.5 mg dose (within this window) is simultaneously CI-certified
//   for all three genotypes.
//
// ── N=7 vs N=14 Temporal Theorem ─────────────────────────────────────────────
//
//   At N=7 the triple overlap is EMPTY (fast D_min=9.309 > slow D_max=8.901).
//   The genotype-naive safe zone APPEARS between N=7 and N=14.
//   This provides a compile-time deadline: the overlap-based prescription
//   cannot be applied at the first-week review; it requires the full N=14
//   steady-state assessment.
//
// ── Effect annotations ────────────────────────────────────────────────────────
//   All do_* functions: with Mut, Div, Panic

module pbpk::rapamycin_dose_overlap

use pbpk::rapamycin_dose_cert::{dc_d_min, dc_d_max}
use pbpk::rapamycin_oral_budget::{
    ob_ka_var_std, ob_f_var_std, ob_ke_var_std, ob_k12_var_std, ob_k21_var_std,
    ob_ke_var_inh
}

fn max_f(a: f64, b: f64) -> f64 { if a > b { a } else { b } }
fn min_f(a: f64, b: f64) -> f64 { if a < b { a } else { b } }

// ── Per-stratum D_min/D_max at N=14 ──────────────────────────────────────────

pub fn do_std_lo_n14() -> f64 with Mut, Div, Panic {
    let ka = ob_ka_var_std(); let fv = ob_f_var_std()
    let ke = ob_ke_var_std(); let k12 = ob_k12_var_std(); let k21 = ob_k21_var_std()
    dc_d_min(5.0, 14, 0.01118, 0.141, ka, fv, ke, k12, k21)
}
pub fn do_std_hi_n14() -> f64 with Mut, Div, Panic {
    let ka = ob_ka_var_std(); let fv = ob_f_var_std()
    let ke = ob_ke_var_std(); let k12 = ob_k12_var_std(); let k21 = ob_k21_var_std()
    dc_d_max(5.0, 14, 0.01118, 0.141, ka, fv, ke, k12, k21)
}

pub fn do_slow_lo_n14() -> f64 with Mut, Div, Panic {
    let ka = ob_ka_var_std(); let fv = ob_f_var_std()
    let ke = ob_ke_var_std(); let k12 = ob_k12_var_std(); let k21 = ob_k21_var_std()
    dc_d_min(5.0, 14, 0.00838, 0.188, ka, fv, ke, k12, k21)
}
pub fn do_slow_hi_n14() -> f64 with Mut, Div, Panic {
    let ka = ob_ka_var_std(); let fv = ob_f_var_std()
    let ke = ob_ke_var_std(); let k12 = ob_k12_var_std(); let k21 = ob_k21_var_std()
    dc_d_max(5.0, 14, 0.00838, 0.188, ka, fv, ke, k12, k21)
}

pub fn do_fast_lo_n14() -> f64 with Mut, Div, Panic {
    let ka = ob_ka_var_std(); let fv = ob_f_var_std()
    let ke = ob_ke_var_std(); let k12 = ob_k12_var_std(); let k21 = ob_k21_var_std()
    dc_d_min(5.0, 14, 0.01677, 0.094, ka, fv, ke, k12, k21)
}
pub fn do_fast_hi_n14() -> f64 with Mut, Div, Panic {
    let ka = ob_ka_var_std(); let fv = ob_f_var_std()
    let ke = ob_ke_var_std(); let k12 = ob_k12_var_std(); let k21 = ob_k21_var_std()
    dc_d_max(5.0, 14, 0.01677, 0.094, ka, fv, ke, k12, k21)
}

pub fn do_inh_lo_n14() -> f64 with Mut, Div, Panic {
    let ka = ob_ka_var_std(); let fv = ob_f_var_std()
    let ke = ob_ke_var_std(); let k12 = ob_k12_var_std(); let k21 = ob_k21_var_std()
    let ke_inh = ob_ke_var_inh()
    dc_d_min(1.5, 14, 0.002236, 0.282, ka, fv, ke_inh, k12, k21)
}
pub fn do_inh_hi_n14() -> f64 with Mut, Div, Panic {
    let ka = ob_ka_var_std(); let fv = ob_f_var_std()
    let ke = ob_ke_var_std(); let k12 = ob_k12_var_std(); let k21 = ob_k21_var_std()
    let ke_inh = ob_ke_var_inh()
    dc_d_max(1.5, 14, 0.002236, 0.282, ka, fv, ke_inh, k12, k21)
}

// ── Pairwise overlaps at N=14 ─────────────────────────────────────────────────

pub fn do_slow_std_lo() -> f64 with Mut, Div, Panic {
    max_f(do_slow_lo_n14(), do_std_lo_n14())
}
pub fn do_slow_std_hi() -> f64 with Mut, Div, Panic {
    min_f(do_slow_hi_n14(), do_std_hi_n14())
}
pub fn do_slow_std_width() -> f64 with Mut, Div, Panic {
    let lo = do_slow_std_lo(); let hi = do_slow_std_hi()
    if hi > lo { hi - lo } else { 0.0 }
}
pub fn do_slow_std_exists() -> bool with Mut, Div, Panic {
    do_slow_std_hi() > do_slow_std_lo()
}

pub fn do_std_fast_lo() -> f64 with Mut, Div, Panic {
    max_f(do_std_lo_n14(), do_fast_lo_n14())
}
pub fn do_std_fast_hi() -> f64 with Mut, Div, Panic {
    min_f(do_std_hi_n14(), do_fast_hi_n14())
}
pub fn do_std_fast_width() -> f64 with Mut, Div, Panic {
    let lo = do_std_fast_lo(); let hi = do_std_fast_hi()
    if hi > lo { hi - lo } else { 0.0 }
}
pub fn do_std_fast_exists() -> bool with Mut, Div, Panic {
    do_std_fast_hi() > do_std_fast_lo()
}

pub fn do_slow_fast_lo() -> f64 with Mut, Div, Panic {
    max_f(do_slow_lo_n14(), do_fast_lo_n14())
}
pub fn do_slow_fast_hi() -> f64 with Mut, Div, Panic {
    min_f(do_slow_hi_n14(), do_fast_hi_n14())
}
pub fn do_slow_fast_width() -> f64 with Mut, Div, Panic {
    let lo = do_slow_fast_lo(); let hi = do_slow_fast_hi()
    if hi > lo { hi - lo } else { 0.0 }
}
pub fn do_slow_fast_exists() -> bool with Mut, Div, Panic {
    do_slow_fast_hi() > do_slow_fast_lo()
}

pub fn do_inh_slow_lo() -> f64 with Mut, Div, Panic { max_f(do_inh_lo_n14(), do_slow_lo_n14()) }
pub fn do_inh_slow_hi() -> f64 with Mut, Div, Panic { min_f(do_inh_hi_n14(), do_slow_hi_n14()) }
pub fn do_inh_slow_width() -> f64 with Mut, Div, Panic {
    let lo = do_inh_slow_lo(); let hi = do_inh_slow_hi()
    if hi > lo { hi - lo } else { 0.0 }
}
pub fn do_inh_slow_exists() -> bool with Mut, Div, Panic { do_inh_slow_hi() > do_inh_slow_lo() }

pub fn do_inh_std_lo() -> f64 with Mut, Div, Panic { max_f(do_inh_lo_n14(), do_std_lo_n14()) }
pub fn do_inh_std_hi() -> f64 with Mut, Div, Panic { min_f(do_inh_hi_n14(), do_std_hi_n14()) }
pub fn do_inh_std_width() -> f64 with Mut, Div, Panic {
    let lo = do_inh_std_lo(); let hi = do_inh_std_hi()
    if hi > lo { hi - lo } else { 0.0 }
}
pub fn do_inh_std_exists() -> bool with Mut, Div, Panic { do_inh_std_hi() > do_inh_std_lo() }

// Impossibility: fast ∩ inh — D_min_fast > D_max_inh
pub fn do_fast_inh_empty() -> bool with Mut, Div, Panic {
    do_fast_lo_n14() > do_inh_hi_n14()
}

// ── Triple overlap: slow ∩ std ∩ fast (genotype-naive safe zone) ──────────────

pub fn do_triple_lo() -> f64 with Mut, Div, Panic {
    max_f(do_slow_lo_n14(), max_f(do_std_lo_n14(), do_fast_lo_n14()))
}
pub fn do_triple_hi() -> f64 with Mut, Div, Panic {
    min_f(do_slow_hi_n14(), min_f(do_std_hi_n14(), do_fast_hi_n14()))
}
pub fn do_triple_width() -> f64 with Mut, Div, Panic {
    let lo = do_triple_lo(); let hi = do_triple_hi()
    if hi > lo { hi - lo } else { 0.0 }
}
pub fn do_triple_exists() -> bool with Mut, Div, Panic {
    do_triple_hi() > do_triple_lo()
}
pub fn do_triple_midpoint() -> f64 with Mut, Div, Panic {
    (do_triple_lo() + do_triple_hi()) / 2.0
}

// ── N=7 triple overlap: EMPTY (temporal theorem) ──────────────────────────────

pub fn do_triple_lo_n7() -> f64 with Mut, Div, Panic {
    let ka = ob_ka_var_std(); let fv = ob_f_var_std()
    let ke = ob_ke_var_std(); let k12 = ob_k12_var_std(); let k21 = ob_k21_var_std()
    let std7  = dc_d_min(5.0, 7, 0.01118, 0.141, ka, fv, ke, k12, k21)
    let slow7 = dc_d_min(5.0, 7, 0.00838, 0.188, ka, fv, ke, k12, k21)
    let fast7 = dc_d_min(5.0, 7, 0.01677, 0.094, ka, fv, ke, k12, k21)
    max_f(slow7, max_f(std7, fast7))
}
pub fn do_triple_hi_n7() -> f64 with Mut, Div, Panic {
    let ka = ob_ka_var_std(); let fv = ob_f_var_std()
    let ke = ob_ke_var_std(); let k12 = ob_k12_var_std(); let k21 = ob_k21_var_std()
    let std7  = dc_d_max(5.0, 7, 0.01118, 0.141, ka, fv, ke, k12, k21)
    let slow7 = dc_d_max(5.0, 7, 0.00838, 0.188, ka, fv, ke, k12, k21)
    let fast7 = dc_d_max(5.0, 7, 0.01677, 0.094, ka, fv, ke, k12, k21)
    min_f(slow7, min_f(std7, fast7))
}
pub fn do_triple_empty_n7() -> bool with Mut, Div, Panic {
    do_triple_lo_n7() >= do_triple_hi_n7()
}

// ── Window-width ordering ─────────────────────────────────────────────────────

// Slow∩Std has largest width among certifiable overlaps
pub fn do_slow_std_widest() -> bool with Mut, Div, Panic {
    do_slow_std_width() > do_slow_fast_width() &&
    do_slow_std_width() > do_inh_std_width()   &&
    do_slow_std_width() > do_inh_slow_width()
}

// Slow∩Fast has narrowest non-zero width (0.889 mg)
pub fn do_slow_fast_narrowest() -> bool with Mut, Div, Panic {
    do_slow_fast_width() < do_slow_std_width() &&
    do_slow_fast_width() < do_std_fast_width() &&
    do_slow_fast_width() > 0.0
}
