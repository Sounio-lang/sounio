// stdlib/pbpk/rapamycin_sprint31_gate.sio — Sprint 31 certification gate
//
// Certifies the RSU Cascade Theorem: dose-invariance of RSU thresholds,
// monotone decrease of RSU with N, and the independence of N_crit and N_10%.
//
// 56 assertions in sections A–H. All must pass (return 56).

module pbpk::rapamycin_sprint31_gate

use pbpk::rapamycin_rel_uncertainty::{
    ru_find_n_thresh, ru_rsu_at_n, ru_rsu_decreasing,
    ru_std_n20, ru_std_n10, ru_std_n5,
    ru_slow_n20, ru_slow_n10, ru_slow_n5,
    ru_fast_n20, ru_fast_n10, ru_fast_n5,
    ru_inh_n20, ru_inh_n10, ru_inh_n5,
    ru_ind_n20, ru_ind_n10,
    ru_std_n10_d2, ru_std_n10_d10,
    ru_slow_ncrit_before_n10, ru_inh_n10_before_ncrit, ru_std_ncrit_before_n10
}
use pbpk::rapamycin_oral_budget::{
    ob_ka_var_std, ob_f_var_std, ob_ke_var_std, ob_k12_var_std, ob_k21_var_std,
    ob_ke_var_inh, ob_ke_var_ind
}

pub fn rapamycin_sprint31_gate() -> i64 with Mut, Div, Panic {
    var score = 0

    // ── Section A: N_20% exact values ────────────────────────────────────────
    // Inhibitor: fastest RSU convergence (high F → high C)
    if ru_inh_n20()  == 1 { score = score + 1 };
    // Slow: large F → large C → fast RSU drop
    if ru_slow_n20() == 2 { score = score + 1 };
    // Standard: moderate
    if ru_std_n20()  == 3 { score = score + 1 };
    // Fast: low F → low C → slow RSU drop
    if ru_fast_n20() == 8 { score = score + 1 };
    // Inducer D=20mg: structurally elevated — N_20% unreachable
    if ru_ind_n20()  == 0 { score = score + 1 };
    // Ordering: inh < slow < std < fast (all certifiable strata)
    if ru_inh_n20() < ru_slow_n20() { score = score + 1 };
    if ru_slow_n20() < ru_std_n20() { score = score + 1 };
    if ru_std_n20() < ru_fast_n20() { score = score + 1 };

    // ── Section B: N_10% exact values ────────────────────────────────────────
    if ru_inh_n10()  == 4  { score = score + 1 };
    if ru_slow_n10() == 8  { score = score + 1 };
    if ru_std_n10()  == 12 { score = score + 1 };
    if ru_fast_n10() == 27 { score = score + 1 };
    // Inducer D=20mg: N_10% also unreachable
    if ru_ind_n10()  == 0  { score = score + 1 };
    // Ordering preserved at N_10%
    if ru_inh_n10() < ru_slow_n10() { score = score + 1 };
    if ru_slow_n10() < ru_std_n10() { score = score + 1 };
    if ru_std_n10() < ru_fast_n10() { score = score + 1 };

    // ── Section C: N_5% exact values ─────────────────────────────────────────
    if ru_inh_n5()  == 17 { score = score + 1 };
    if ru_slow_n5() == 38 { score = score + 1 };
    if ru_std_n5()  == 88 { score = score + 1 };
    // Fast: N_5% unreachable within 100 doses (low F → permanently elevated RSU)
    if ru_fast_n5() == 0  { score = score + 1 };
    // Ordering preserved: inh < slow < std
    if ru_inh_n5() < ru_slow_n5() { score = score + 1 };
    if ru_slow_n5() < ru_std_n5() { score = score + 1 };
    // std N_5% is within the long-term clinical monitoring window (≤ 100)
    if ru_std_n5() <= 100 { score = score + 1 };

    // ── Section D: Dose-invariance theorem ───────────────────────────────────
    // N_10%(std) is identical at D=2mg, D=5mg, D=10mg (RSU = u_c/C is dose-cancelled)
    if ru_std_n10_d2()  == 12 { score = score + 1 };
    if ru_std_n10()     == 12 { score = score + 1 };
    if ru_std_n10_d10() == 12 { score = score + 1 };
    // All three identical (pairwise)
    if ru_std_n10_d2() == ru_std_n10()     { score = score + 1 };
    if ru_std_n10()    == ru_std_n10_d10() { score = score + 1 };

    // ── Section E: RSU monotone decrease (u_c/C falls with N) ────────────────
    let ka = ob_ka_var_std(); let fv = ob_f_var_std()
    let ke = ob_ke_var_std(); let k12 = ob_k12_var_std(); let k21 = ob_k21_var_std()
    let ke_inh = ob_ke_var_inh(); let ke_ind = ob_ke_var_ind()
    // Standard: RSU decreases N=1→5, N=5→20
    if ru_rsu_decreasing(5.0, 1, 5,  0.01118, 0.141, ka, fv, ke, k12, k21) { score = score + 1 };
    if ru_rsu_decreasing(5.0, 5, 20, 0.01118, 0.141, ka, fv, ke, k12, k21) { score = score + 1 };
    // Slow: RSU decreases N=1→10
    if ru_rsu_decreasing(5.0, 1, 10, 0.00838, 0.188, ka, fv, ke, k12, k21) { score = score + 1 };
    // Fast: RSU decreases N=1→30
    if ru_rsu_decreasing(5.0, 1, 30, 0.01677, 0.094, ka, fv, ke, k12, k21) { score = score + 1 };
    // Inhibitor: RSU decreases N=1→10
    if ru_rsu_decreasing(1.5, 1, 10, 0.002236, 0.282, ka, fv, ke_inh, k12, k21) { score = score + 1 };

    // ── Section F: Independence theorem ──────────────────────────────────────
    // Slow: N_crit=3 < N_10%=8 — CI certifies while RSU still > 10%
    if ru_slow_ncrit_before_n10() { score = score + 1 };
    // Inhibitor: N_10%=4 < N_crit=7 — RSU reaches target before CI certifies
    if ru_inh_n10_before_ncrit() { score = score + 1 };
    // Standard: N_crit=6 < N_10%=12 — CI certifies while RSU still > 10%
    if ru_std_ncrit_before_n10() { score = score + 1 };
    // Direct values confirming independence
    if ru_slow_n10() > 3  { score = score + 1 };   // N_10%=8 > N_crit=3
    if ru_inh_n10()  < 7  { score = score + 1 };   // N_10%=4 < N_crit=7
    if ru_std_n10()  > 6  { score = score + 1 };   // N_10%=12 > N_crit=6

    // ── Section G: Structural limitations ────────────────────────────────────
    // Fast: N_10% requires more than 14 doses (beyond standard TDM window)
    if ru_fast_n10() > 14 { score = score + 1 };
    // Fast: N_5% is unreachable (0) — permanent precision floor from low F
    if ru_fast_n5()  == 0 { score = score + 1 };
    // Inducer: BOTH N_20% and N_10% unreachable — most precision-challenged stratum
    if ru_ind_n20()  == 0 && ru_ind_n10() == 0 { score = score + 1 };
    // Inhibitor N_5%=17 < standard TDM window endpoint — achievable with patience
    if ru_inh_n5() <= 20 { score = score + 1 };
    // Slow N_5%=38 is clinically long but finite
    if ru_slow_n5() > 0 && ru_slow_n5() <= 50 { score = score + 1 };
    // Standard N_5%=88 is practically prohibitive (> 60 doses)
    if ru_std_n5() > 60 { score = score + 1 };

    // ── Section H: Cascade ordering and clinical thresholds ──────────────────
    // For every certifiable stratum: N_20% ≤ N_10% (threshold cascade is monotone)
    if ru_inh_n20()  <= ru_inh_n10()  { score = score + 1 };
    if ru_slow_n20() <= ru_slow_n10() { score = score + 1 };
    if ru_std_n20()  <= ru_std_n10()  { score = score + 1 };
    if ru_fast_n20() <= ru_fast_n10() { score = score + 1 };
    // N_10% ≤ N_5% for all certifiable strata (where N_5% is not 0)
    if ru_inh_n10()  <= ru_inh_n5()  { score = score + 1 };
    if ru_slow_n10() <= ru_slow_n5() { score = score + 1 };
    if ru_std_n10()  <= ru_std_n5()  { score = score + 1 };
    // Inhibitor has the shortest RSU cascade (N_20%=1, N_10%=4, N_5%=17)
    if ru_inh_n10() <= ru_std_n10()  { score = score + 1 };
    if ru_inh_n5()  <= ru_slow_n5()  { score = score + 1 };
    // Fast N_20% is at least 6 doses above slow N_20% (low-F penalty)
    if ru_fast_n20() >= ru_slow_n20() + 6 { score = score + 1 };
    // Sum of inh + slow N_10% is less than fast N_10% alone (fast penalty > both combined)
    if ru_inh_n10() + ru_slow_n10() < ru_fast_n10() { score = score + 1 };

    score
}
