// stdlib/pbpk/rapamycin_sprint43_gate.sio — Sprint 43 certification gate
//
// ISO GUM coverage factor (k) sensitivity: 56 assertions across
// k=1.645/2.0/2.576/3.0 for all five pharmacogenomic strata.
//
// Finding A: ind catastrophic — N_crit 20→26→49→NEVER; Z_floor=2.337 at N=35
//            is short of k=3.0; ind never achieves GUM certification within 60 doses.
// Finding B: fast monotone — N_crit 14→15→17→19; +5 doses across full k range.
// Finding C: inh k-plateau above k=2.0 — N_crit 6→7→7→7; Z_floor=3.210 at N=7
//            exceeds k=3.0, making inh robust to any regulatory threshold above 90%.
// Finding D: std N=5 sub-threshold — Z_floor=1.600 < k=1.645; std anchored at 6.
//
// 56 assertions in sections A–H. All must pass (return 56).

module pbpk::rapamycin_sprint43_gate

use pbpk::rapamycin_coverage_factor::{
    cf_std_ncrit_k165, cf_std_ncrit_k200, cf_std_ncrit_k258, cf_std_ncrit_k300,
    cf_std_zf_n5, cf_std_zf_n6,
    cf_slow_ncrit_k165, cf_slow_ncrit_k200, cf_slow_ncrit_k258, cf_slow_ncrit_k300,
    cf_fast_ncrit_k165, cf_fast_ncrit_k200, cf_fast_ncrit_k258, cf_fast_ncrit_k300,
    cf_fast_zf_n14, cf_fast_zf_n15,
    cf_inh_ncrit_k165, cf_inh_ncrit_k200, cf_inh_ncrit_k258, cf_inh_ncrit_k300,
    cf_inh_zf_n6, cf_inh_zf_n7,
    cf_ind_ncrit_k165, cf_ind_ncrit_k200, cf_ind_ncrit_k258, cf_ind_ncrit_k300,
    cf_ind_zf_n26, cf_ind_zf_n35
}

pub fn rapamycin_sprint43_gate() -> i64 with Mut, Div, Panic {
    var score = 0

    // ── Section A: k=2.0 baseline certification (ISO GUM reference) ──────────
    // std=6, slow=3, fast=15, inh=7, ind=26
    if cf_std_ncrit_k200() > 5 && cf_std_ncrit_k200() < 7 { score = score + 1 };
    if cf_slow_ncrit_k200() > 2 && cf_slow_ncrit_k200() < 4 { score = score + 1 };
    if cf_fast_ncrit_k200() > 14 && cf_fast_ncrit_k200() < 16 { score = score + 1 };
    if cf_inh_ncrit_k200() > 6 && cf_inh_ncrit_k200() < 8 { score = score + 1 };
    if cf_ind_ncrit_k200() > 25 && cf_ind_ncrit_k200() < 27 { score = score + 1 };
    // Fast requires more doses than std at reference threshold
    if cf_fast_ncrit_k200() > cf_std_ncrit_k200() { score = score + 1 };
    // Ind requires more doses than fast at reference threshold
    if cf_ind_ncrit_k200() > cf_fast_ncrit_k200() { score = score + 1 };

    // ── Section B: k=1.645 (90% coverage, relaxed regulatory) ───────────────
    // std=6, slow=3, fast=14, inh=6, ind=20
    if cf_std_ncrit_k165() > 5 && cf_std_ncrit_k165() < 7 { score = score + 1 };
    if cf_slow_ncrit_k165() > 2 && cf_slow_ncrit_k165() < 4 { score = score + 1 };
    if cf_fast_ncrit_k165() > 13 && cf_fast_ncrit_k165() < 15 { score = score + 1 };
    if cf_inh_ncrit_k165() > 5 && cf_inh_ncrit_k165() < 7 { score = score + 1 };
    if cf_ind_ncrit_k165() > 19 && cf_ind_ncrit_k165() < 21 { score = score + 1 };
    // Relaxed threshold reduces N_crit for fast
    if cf_fast_ncrit_k165() < cf_fast_ncrit_k200() { score = score + 1 };
    // Relaxed threshold reduces N_crit for ind
    if cf_ind_ncrit_k165() < cf_ind_ncrit_k200() { score = score + 1 };

    // ── Section C: k=2.576 (99% coverage, high-confidence clinical) ──────────
    // std=7, slow=4, fast=17, inh=7, ind=49
    if cf_std_ncrit_k258() > 6 && cf_std_ncrit_k258() < 8 { score = score + 1 };
    if cf_slow_ncrit_k258() > 3 && cf_slow_ncrit_k258() < 5 { score = score + 1 };
    if cf_fast_ncrit_k258() > 16 && cf_fast_ncrit_k258() < 18 { score = score + 1 };
    if cf_inh_ncrit_k258() > 6 && cf_inh_ncrit_k258() < 8 { score = score + 1 };
    if cf_ind_ncrit_k258() > 48 && cf_ind_ncrit_k258() < 50 { score = score + 1 };
    // Stricter threshold increases N_crit for fast
    if cf_fast_ncrit_k258() > cf_fast_ncrit_k200() { score = score + 1 };
    // Stricter threshold massively increases N_crit for ind
    if cf_ind_ncrit_k258() > cf_ind_ncrit_k200() { score = score + 1 };

    // ── Section D: FINDING A — ind catastrophic k-sensitivity ────────────────
    // ind: 20→26→49→NEVER; Z_floor=2.337 at N=35 < k=3.0
    if cf_ind_ncrit_k300() < 1 { score = score + 1 };
    if cf_ind_ncrit_k258() > 45 { score = score + 1 };
    if cf_ind_ncrit_k200() > cf_ind_ncrit_k165() { score = score + 1 };
    if cf_ind_ncrit_k258() > cf_ind_ncrit_k200() { score = score + 1 };
    // The jump from k=2.0 to k=2.576 costs >20 doses for ind
    if cf_ind_ncrit_k258() - cf_ind_ncrit_k200() > 20 { score = score + 1 };
    // ind N_crit at k=2.576 exceeds k=1.645 by more than 25 doses
    if cf_ind_ncrit_k258() > cf_ind_ncrit_k165() + 25 { score = score + 1 };
    // Z_floor at ind N=35 is between 2.3 and 2.4, confirming floor at k=3.0
    if cf_ind_zf_n35() > 2.3 && cf_ind_zf_n35() < 2.4 { score = score + 1 };

    // ── Section E: FINDING B — fast monotone k-sensitivity ───────────────────
    // fast: 14→15→17→19; monotone increase across all k thresholds
    if cf_fast_ncrit_k300() > 18 && cf_fast_ncrit_k300() < 20 { score = score + 1 };
    if cf_fast_ncrit_k300() > cf_fast_ncrit_k258() { score = score + 1 };
    if cf_fast_ncrit_k258() > cf_fast_ncrit_k200() { score = score + 1 };
    if cf_fast_ncrit_k200() > cf_fast_ncrit_k165() { score = score + 1 };
    // Total spread across k range is >4 doses for fast
    if cf_fast_ncrit_k300() - cf_fast_ncrit_k165() > 4 { score = score + 1 };
    // k=2.576 costs >1 dose more than k=2.0 for fast
    if cf_fast_ncrit_k258() - cf_fast_ncrit_k200() > 1 { score = score + 1 };
    // fast at k=3.0 requires more doses than std at k=3.0
    if cf_fast_ncrit_k300() > cf_std_ncrit_k300() { score = score + 1 };

    // ── Section F: FINDING C — inh k-plateau above k=2.0 ────────────────────
    // inh: 6→7→7→7; Z_floor=3.210 at N=7 exceeds k=3.0 (floor-binding)
    if cf_inh_ncrit_k200() > 6 && cf_inh_ncrit_k200() < 8 { score = score + 1 };
    if cf_inh_ncrit_k258() > 6 && cf_inh_ncrit_k258() < 8 { score = score + 1 };
    if cf_inh_ncrit_k300() > 6 && cf_inh_ncrit_k300() < 8 { score = score + 1 };
    if cf_inh_ncrit_k165() > 5 && cf_inh_ncrit_k165() < 7 { score = score + 1 };
    // Relaxed k=1.645 requires one fewer dose than k=2.0 for inh
    if cf_inh_ncrit_k165() < cf_inh_ncrit_k200() { score = score + 1 };
    // inh at k=2.576 certifies before fast at k=2.0 (7 < 15)
    if cf_inh_ncrit_k258() < cf_fast_ncrit_k200() { score = score + 1 };
    // ind at k=3.0 fails while inh at k=3.0 certifies
    if cf_ind_ncrit_k300() < cf_inh_ncrit_k300() { score = score + 1 };

    // ── Section G: Z values at key threshold boundaries ───────────────────────
    // std N=5: Z_floor=1.600 (below k=1.645 — sub-threshold)
    // std N=6: Z_floor=2.221 (certifies at k=2.0)
    // fast N=14: Z_floor=1.844 (between k=1.645 and k=2.0)
    // fast N=15: Z_floor=2.139 (certifies at k=2.0, fails k=2.576)
    // inh N=6: Z_floor=1.986 (between k=1.645 and k=2.0)
    // inh N=7: Z_floor=3.210 (exceeds k=3.0 — plateau anchor)
    // ind N=26: Z_floor=2.015 (just certifies at k=2.0)
    if cf_std_zf_n5() > 1.5 && cf_std_zf_n5() < 1.7 { score = score + 1 };
    if cf_std_zf_n6() > 2.1 && cf_std_zf_n6() < 2.3 { score = score + 1 };
    if cf_fast_zf_n14() > 1.8 && cf_fast_zf_n14() < 1.9 { score = score + 1 };
    if cf_fast_zf_n15() > 2.0 && cf_fast_zf_n15() < 2.2 { score = score + 1 };
    if cf_inh_zf_n6() > 1.9 && cf_inh_zf_n6() < 2.0 { score = score + 1 };
    if cf_inh_zf_n7() > 3.0 { score = score + 1 };
    if cf_ind_zf_n26() > 2.0 && cf_ind_zf_n26() < 2.1 { score = score + 1 };

    // ── Section H: cross-stratum k-sensitivity comparisons ───────────────────
    // ind N_crit exceeds fast at high k (catastrophic vs monotone)
    if cf_ind_ncrit_k258() > cf_fast_ncrit_k258() { score = score + 1 };
    // fast k-spread exceeds std k-spread (more sensitive stratum)
    if cf_fast_ncrit_k300() - cf_fast_ncrit_k165() > cf_std_ncrit_k300() - cf_std_ncrit_k165() { score = score + 1 };
    // inh at k=3.0 certifies before std at k=3.0
    if cf_inh_ncrit_k300() < cf_std_ncrit_k300() { score = score + 1 };
    // ind k-jump (k2→k2.576) larger than fast k-jump (floor binding vs ceiling room)
    if cf_ind_ncrit_k200() - cf_ind_ncrit_k165() > cf_fast_ncrit_k200() - cf_fast_ncrit_k165() { score = score + 1 };
    // slow certifies before std at k=3.0
    if cf_slow_ncrit_k300() < cf_std_ncrit_k300() { score = score + 1 };
    // ind N_crit at k=2.576 exceeds 2× ind at k=1.645 (superlinear blow-up)
    if cf_ind_ncrit_k258() > cf_ind_ncrit_k165() * 2 { score = score + 1 };
    // fast Z_floor strictly increases from N=14 to N=15 (monotone accumulation)
    if cf_fast_zf_n15() > cf_fast_zf_n14() { score = score + 1 };

    score
}
