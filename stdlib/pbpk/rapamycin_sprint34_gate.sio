// stdlib/pbpk/rapamycin_sprint34_gate.sio — Sprint 34 certification gate
//
// Certifies sigma-distance safety margins: Z_floor, Z_ceil, binding constraint
// rotation, fast gap quantification, inhibitor razor edge, Gold theorem σ-precision.
//
// 56 assertions in sections A–H. All must pass (return 56).

module pbpk::rapamycin_sprint34_gate

use pbpk::rapamycin_safety_margin::{
    sm_z_floor, sm_z_ceil, sm_margin, sm_binding_floor,
    sm_std_zf_n7, sm_std_zf_n14, sm_std_zc_n14, sm_std_zf_n26, sm_std_zc_n26,
    sm_slow_zf_n14, sm_slow_zc_n14, sm_slow_zc_n26,
    sm_fast_zf_n7, sm_fast_zf_n14, sm_fast_zf_n15, sm_fast_zf_n26,
    sm_inh_zf_n6, sm_inh_zf_n7, sm_inh_zf_n14,
    sm_ind34_zf_n26, sm_ind34_zc_n26
}

pub fn rapamycin_sprint34_gate() -> i64 with Mut, Div, Panic {
    var score = 0

    // ── Section A: Z_floor values ─────────────────────────────────────────────
    // std N=7: Z_floor ≈ 2.821 (certified)
    if sm_std_zf_n7() > 2.7 && sm_std_zf_n7() < 2.9 { score = score + 1 };
    // std N=14: Z_floor ≈ 6.432
    if sm_std_zf_n14() > 6.3 && sm_std_zf_n14() < 6.6 { score = score + 1 };
    // std N=26: Z_floor ≈ 10.622
    if sm_std_zf_n26() > 10.5 && sm_std_zf_n26() < 10.8 { score = score + 1 };
    // slow N=14: Z_floor ≈ 10.106
    if sm_slow_zf_n14() > 10.0 && sm_slow_zf_n14() < 10.3 { score = score + 1 };
    // fast N=7: Z_floor ≈ -0.538 (subtherapeutic)
    if sm_fast_zf_n7() > -0.7 && sm_fast_zf_n7() < -0.4 { score = score + 1 };
    if sm_fast_zf_n7() < 0.0 { score = score + 1 };
    // fast N=26: Z_floor ≈ 4.758
    if sm_fast_zf_n26() > 4.6 && sm_fast_zf_n26() < 4.9 { score = score + 1 };

    // ── Section B: Z_ceil values ──────────────────────────────────────────────
    // std N=14: Z_ceil ≈ 11.333
    if sm_std_zc_n14() > 11.2 && sm_std_zc_n14() < 11.5 { score = score + 1 };
    if sm_std_zc_n14() >= 2.0 { score = score + 1 };
    // std N=26: Z_ceil ≈ 5.456 (ceiling now binding — see Section F)
    if sm_std_zc_n26() > 5.3 && sm_std_zc_n26() < 5.6 { score = score + 1 };
    if sm_std_zc_n26() >= 2.0 { score = score + 1 };
    // slow N=14: Z_ceil ≈ 5.315 (ceiling binding)
    if sm_slow_zc_n14() > 5.2 && sm_slow_zc_n14() < 5.5 { score = score + 1 };
    if sm_slow_zc_n14() >= 2.0 { score = score + 1 };
    // slow N=26: Z_ceil ≈ -1.683 (TOXIC — C > ceiling)
    if sm_slow_zc_n26() > -1.8 && sm_slow_zc_n26() < -1.5 { score = score + 1 };
    if sm_slow_zc_n26() < 0.0 { score = score + 1 };
    // ind D34 N=26: Z_ceil ≈ 6.043
    if sm_ind34_zc_n26() > 5.9 && sm_ind34_zc_n26() < 6.2 { score = score + 1 };
    if sm_ind34_zc_n26() >= 2.0 { score = score + 1 };

    // ── Section C: Safety margins and binding constraints at N=14 ────────────
    // slow N=14: ceiling is binding (Z_ceil < Z_floor)
    if sm_slow_zc_n14() < sm_slow_zf_n14() { score = score + 1 };
    // std N=14: floor is binding (Z_floor < Z_ceil)
    if sm_std_zf_n14() < sm_std_zc_n14() { score = score + 1 };
    // std margin at N=14 = Z_floor (floor binding)
    if sm_std_zf_n14() > 6.3 { score = score + 1 };
    // slow margin at N=14 = Z_ceil (ceil binding) ≈ 5.315
    if sm_slow_zc_n14() > 5.2 && sm_slow_zc_n14() < 5.5 { score = score + 1 };
    // all certified at N=14 (std, slow — not fast)
    if sm_std_zf_n14() >= 2.0 && sm_std_zc_n14() >= 2.0 { score = score + 1 };
    if sm_slow_zf_n14() >= 2.0 && sm_slow_zc_n14() >= 2.0 { score = score + 1 };

    // ── Section D: FINDING A — Fast gap σ-quantification ─────────────────────
    // fast N=14: Z_floor ≈ 1.844 — FAIL by 0.156σ
    if sm_fast_zf_n14() > 1.8 && sm_fast_zf_n14() < 1.9 { score = score + 1 };
    if sm_fast_zf_n14() < 2.0 { score = score + 1 };
    // Gap from threshold: 2.0 - 1.844 ≈ 0.156σ
    if 2.0 - sm_fast_zf_n14() > 0.1 && 2.0 - sm_fast_zf_n14() < 0.2 { score = score + 1 };
    // fast N=15: Z_floor ≈ 2.139 — CERT by 0.139σ
    if sm_fast_zf_n15() > 2.1 && sm_fast_zf_n15() < 2.2 { score = score + 1 };
    if sm_fast_zf_n15() >= 2.0 { score = score + 1 };
    // Margin above threshold at N=15: 2.139 - 2.0 ≈ 0.139σ
    if sm_fast_zf_n15() - 2.0 > 0.1 && sm_fast_zf_n15() - 2.0 < 0.2 { score = score + 1 };
    // One-dose gap total span: 0.295σ (0.156 + 0.139)
    if (2.0 - sm_fast_zf_n14()) + (sm_fast_zf_n15() - 2.0) > 0.25 &&
       (2.0 - sm_fast_zf_n14()) + (sm_fast_zf_n15() - 2.0) < 0.35 { score = score + 1 };

    // ── Section E: FINDING B — Inhibitor razor edge ────────────────────────
    // inh N=6: Z_floor ≈ 1.986 — FAIL by 0.014σ (closest stratum to threshold)
    if sm_inh_zf_n6() > 1.97 && sm_inh_zf_n6() < 1.99 { score = score + 1 };
    if sm_inh_zf_n6() < 2.0 { score = score + 1 };
    // Gap from threshold: 2.0 - 1.986 ≈ 0.014σ (razor edge)
    if 2.0 - sm_inh_zf_n6() > 0.01 && 2.0 - sm_inh_zf_n6() < 0.02 { score = score + 1 };
    // inh N=7: Z_floor ≈ 3.210 — CERT
    if sm_inh_zf_n7() > 3.1 && sm_inh_zf_n7() < 3.3 { score = score + 1 };
    if sm_inh_zf_n7() >= 2.0 { score = score + 1 };
    // Jump N=6→N=7: +1.224σ (disproportionately large)
    if sm_inh_zf_n7() - sm_inh_zf_n6() > 1.2 && sm_inh_zf_n7() - sm_inh_zf_n6() < 1.3 { score = score + 1 };
    // inh N=14 further: Z_floor > 9.0
    if sm_inh_zf_n14() > 9.0 { score = score + 1 };

    // ── Section F: FINDING C — Standard binding switch ────────────────────────
    // At N=7: floor binding for std (Z_floor < Z_ceil)
    if sm_std_zf_n7() < sm_std_zc_n26() { score = score + 1 };
    // At N=26: ceiling binding (Z_ceil=5.456 < Z_floor=10.622)
    if sm_std_zc_n26() < sm_std_zf_n26() { score = score + 1 };
    // The switch confirms drug accumulation shifts binding constraint
    if sm_std_zf_n26() > sm_std_zc_n26() + 4.0 { score = score + 1 };
    // At N=14: still floor binding (Z_floor=6.432 < Z_ceil=11.333)
    if sm_std_zf_n14() < sm_std_zc_n14() { score = score + 1 };
    // Margin grows: N=7 to N=14
    if sm_std_zf_n14() > sm_std_zf_n7() { score = score + 1 };
    // Ceiling margin shrinks as drug accumulates: N=14 to N=26
    if sm_std_zc_n26() < sm_std_zc_n14() { score = score + 1 };

    // ── Section G: FINDING D — Gold theorem σ-precision ──────────────────────
    // ind D34 N=26: Z_floor ≈ 2.015 — CERT by 0.015σ
    if sm_ind34_zf_n26() > 2.01 && sm_ind34_zf_n26() < 2.02 { score = score + 1 };
    if sm_ind34_zf_n26() >= 2.0 { score = score + 1 };
    // Margin above threshold: 2.015 - 2.0 ≈ 0.015σ (ultra-precise)
    if sm_ind34_zf_n26() - 2.0 > 0.01 && sm_ind34_zf_n26() - 2.0 < 0.02 { score = score + 1 };
    // Gold theorem: compilation-certified dose × N achieves threshold by 0.015σ
    // Both floor and ceil certified (margin min = Z_floor since Z_ceil=6.043)
    if sm_ind34_zc_n26() > sm_ind34_zf_n26() { score = score + 1 };
    // The 0.015σ gap is the smallest CERT margin across all strata/N combinations
    if sm_ind34_zf_n26() - 2.0 < sm_fast_zf_n15() - 2.0 { score = score + 1 };
    // Inducer floor margin much less than ceil margin (floor is the binding constraint)
    if sm_ind34_zc_n26() - sm_ind34_zf_n26() > 3.5 { score = score + 1 };

    // ── Section H: Cross-stratum ordering and structural properties ──────────
    // Floor margins at N=14 ordering: slow > std > fast
    if sm_slow_zf_n14() > sm_std_zf_n14() { score = score + 1 };
    if sm_std_zf_n14() > sm_fast_zf_n14() { score = score + 1 };
    // fast is closest to fail threshold at N=14 among non-subtherapeutic
    if sm_fast_zf_n14() < sm_std_zf_n14() && sm_fast_zf_n14() < sm_slow_zf_n14() { score = score + 1 };
    // inh N=14 has very large margin (certified early, dose is small)
    if sm_inh_zf_n14() > 9.0 { score = score + 1 };
    // Subtherapeutic fast N=7: strictly negative Z_floor
    if sm_fast_zf_n7() < 0.0 { score = score + 1 };
    // Toxic slow N=26: Z_ceil strictly negative
    if sm_slow_zc_n26() < 0.0 { score = score + 1 };
    // All std margins positive (certified at all checkpoints)
    if sm_std_zf_n7() > 0.0 && sm_std_zf_n14() > 0.0 && sm_std_zf_n26() > 0.0 { score = score + 1 };

    score
}
