pub fn ld_inh_advance()        -> i64 with Mut, Div, Panic { ld_inh_ncrit_uniform() - ld_inh_ncrit_load() }

// ── ind stratum (ke=0.05590, F=0.047, D_maint=34mg) ─────────────────────────
pub fn ld_ind_margin_load_n1() -> f64 with Mut, Div, Panic { ld_margin(102.0, 34.0, 1, 0.05590, 0.047) }
pub fn ld_ind_margin_load_n7() -> f64 with Mut, Div, Panic { ld_margin(102.0, 34.0, 7, 0.05590, 0.047) }
pub fn ld_ind_ncrit_load()     -> i64 with Mut, Div, Panic { ld_ncrit(102.0, 34.0, 0.05590, 0.047) }
pub fn ld_ind_nlast_load()     -> i64 with Mut, Div, Panic { ld_nlast(102.0, 34.0, 0.05590, 0.047) }
pub fn ld_ind_span_load()      -> i64 with Mut, Div, Panic { ld_ind_nlast_load() - ld_ind_ncrit_load() }
pub fn ld_ind_ncrit_uniform()  -> i64 { 26 }
pub fn ld_ind_nlast_uniform()  -> i64 { 100 }
pub fn ld_ind_span_uniform()   -> i64 { 74 }
pub fn ld_ind_advance()        -> i64 with Mut, Div, Panic { ld_ind_ncrit_uniform() - ld_ind_ncrit_load() }
