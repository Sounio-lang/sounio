// stdlib/pbpk/rapamycin_sprint65_gate.sio — Sprint 65 certification gate
//
// Assay GUM expansion: HPLC-MS/MS (CV=5%) and immunoassay (CV=15%) effects on
// certification windows for the standard stratum.
//
// Findings:
//   A: Immunoassay WARN at N=7 (margin=1.874); LCMS and PK-only CERT
//   B: n_crit: PK=6, LCMS=6, immunoassay=8 (+2 days)
//   C: n_last_cert: PK=36, LCMS=34, immunoassay=27; cert_spans: 30/28/19
//   D: u_immuno_n7 (0.000962) > u_pk_n7 (0.000855) — assay dominates at N=7
//   E: u_lcms_n7 (0.000321) minor; u_total_lcms_n7 only 7% above u_pk_n7
//   F: Span losses: LCMS −2 (7%), immunoassay −11 (37%)
//   G: Margin ordering PK > LCMS > immunoassay at every time-point
//   H: u_total_immuno grows with N (C rises toward SS, u_assay=CV*C amplifies)
//
// 56 assertions in sections A–H. All must pass (return 56).

module pbpk::rapamycin_sprint65_gate

use pbpk::rapamycin_assay_gum::{
    ag_cv_lcms, ag_cv_immuno,
    ag_std_margin_pk_n7, ag_std_margin_pk_n14, ag_std_margin_pk_n28,
    ag_std_margin_lcms_n7, ag_std_margin_lcms_n14, ag_std_margin_lcms_n28,
    ag_std_margin_immuno_n7, ag_std_margin_immuno_n14, ag_std_margin_immuno_n28,
    ag_std_u_pk_n7, ag_std_u_pk_n14, ag_std_u_pk_n28,
    ag_std_u_lcms_n7, ag_std_u_lcms_n14, ag_std_u_lcms_n28,
    ag_std_u_immuno_n7, ag_std_u_immuno_n14, ag_std_u_immuno_n28,
    ag_std_u_total_lcms_n7, ag_std_u_total_lcms_n14, ag_std_u_total_lcms_n28,
    ag_std_u_total_immuno_n7, ag_std_u_total_immuno_n14, ag_std_u_total_immuno_n28,
    ag_std_ncrit_pk_only, ag_std_nlast_pk_only, ag_std_span_pk_only,
    ag_std_ncrit_lcms, ag_std_nlast_lcms, ag_std_span_lcms,
    ag_std_ncrit_immuno, ag_std_nlast_immuno, ag_std_span_immuno,
    ag_span_loss_lcms, ag_span_loss_immuno
}

pub fn rapamycin_sprint65_gate() -> i64 with Mut, Div, Panic {
    var score = 0

    // ── Section A: week-1 margin comparison — immunoassay WARN (Finding A) ───
    if ag_std_margin_pk_n7()     > 2.0 { score = score + 1 };
    if ag_std_margin_lcms_n7()   > 2.0 { score = score + 1 };
    if ag_std_margin_immuno_n7() < 2.0 { score = score + 1 };
    if ag_std_margin_immuno_n7() > 1.8 { score = score + 1 };
    if ag_std_margin_lcms_n7()   < ag_std_margin_pk_n7()     { score = score + 1 };
    if ag_std_margin_immuno_n7() < ag_std_margin_lcms_n7()   { score = score + 1 };
    if ag_std_margin_immuno_n7() > 0.0 { score = score + 1 };

    // ── Section B: cert windows — n_crit (Finding B) ─────────────────────────
    if ag_std_ncrit_pk_only() == 6 { score = score + 1 };
    if ag_std_ncrit_lcms()    == 6 { score = score + 1 };
    if ag_std_ncrit_immuno()  == 8 { score = score + 1 };
    if ag_std_ncrit_immuno()  > ag_std_ncrit_pk_only() { score = score + 1 };
    if ag_std_ncrit_lcms()   == ag_std_ncrit_pk_only() { score = score + 1 };
    if ag_std_span_pk_only()  == 30 { score = score + 1 };
    if ag_std_span_lcms()     == 28 { score = score + 1 };

    // ── Section C: cert windows — n_last and span (Finding C) ────────────────
    if ag_std_nlast_pk_only() == 36 { score = score + 1 };
    if ag_std_nlast_lcms()    == 34 { score = score + 1 };
    if ag_std_nlast_immuno()  == 27 { score = score + 1 };
    if ag_std_span_immuno()   == 19 { score = score + 1 };
    if ag_std_nlast_immuno()  < ag_std_nlast_pk_only() { score = score + 1 };
    if ag_std_span_immuno()   < ag_std_span_lcms()     { score = score + 1 };
    if ag_std_span_lcms()     < ag_std_span_pk_only()  { score = score + 1 };

    // ── Section D: immunoassay u dominates PK at N=7 (Finding D, E) ──────────
    if ag_std_u_immuno_n7()  > ag_std_u_pk_n7()  { score = score + 1 };
    if ag_std_u_immuno_n7()  > 0.00095 { score = score + 1 };
    if ag_std_u_immuno_n7()  < 0.00098 { score = score + 1 };
    if ag_std_u_lcms_n7()    < ag_std_u_pk_n7()  { score = score + 1 };
    if ag_std_u_lcms_n7()    > 0.00030 { score = score + 1 };
    if ag_std_u_lcms_n7()    < 0.00034 { score = score + 1 };
    if ag_std_u_pk_n7()      > 0.00083 { score = score + 1 };

    // ── Section E: u_total comparison (Finding E, F) ─────────────────────────
    if ag_std_u_total_lcms_n7()   > ag_std_u_pk_n7() { score = score + 1 };
    if ag_std_u_total_immuno_n7() > ag_std_u_pk_n7() { score = score + 1 };
    if ag_std_u_total_immuno_n7() > ag_std_u_total_lcms_n7() { score = score + 1 };
    if ag_std_u_total_lcms_n7()   > 0.00090 { score = score + 1 };
    if ag_std_u_total_lcms_n7()   < 0.00095 { score = score + 1 };
    if ag_std_u_total_immuno_n7() > 0.00125 { score = score + 1 };
    if ag_std_u_total_immuno_n7() < 0.00135 { score = score + 1 };

    // ── Section F: span losses (Finding F) ───────────────────────────────────
    if ag_span_loss_lcms()   == 2  { score = score + 1 };
    if ag_span_loss_immuno() == 11 { score = score + 1 };
    if ag_span_loss_immuno() > ag_span_loss_lcms()    { score = score + 1 };
    if ag_span_loss_immuno() > 0   { score = score + 1 };
    if ag_span_loss_lcms()   > 0   { score = score + 1 };
    if ag_std_ncrit_immuno() > ag_std_ncrit_lcms()    { score = score + 1 };
    if ag_std_nlast_immuno() < ag_std_nlast_lcms()    { score = score + 1 };

    // ── Section G: margin ordering holds at N=14 and N=28 (Finding G) ────────
    if ag_std_margin_pk_n14()     > ag_std_margin_lcms_n14()   { score = score + 1 };
    if ag_std_margin_lcms_n14()   > ag_std_margin_immuno_n14() { score = score + 1 };
    if ag_std_margin_pk_n28()     > ag_std_margin_lcms_n28()   { score = score + 1 };
    if ag_std_margin_lcms_n28()   > ag_std_margin_immuno_n28() { score = score + 1 };
    if ag_std_margin_immuno_n14() > 2.0 { score = score + 1 };
    if ag_std_margin_immuno_n28() < 2.0 { score = score + 1 };
    if ag_std_margin_lcms_n28()   > 2.0 { score = score + 1 };

    // ── Section H: u_total grows with N for immunoassay (Finding H) ──────────
    if ag_std_u_total_immuno_n14() > ag_std_u_total_immuno_n7()  { score = score + 1 };
    if ag_std_u_total_immuno_n28() > ag_std_u_total_immuno_n14() { score = score + 1 };
    if ag_std_u_immuno_n14()       > ag_std_u_immuno_n7()        { score = score + 1 };
    if ag_std_u_total_lcms_n14()   > ag_std_u_total_lcms_n7()    { score = score + 1 };
    if ag_std_u_total_lcms_n28()   > ag_std_u_total_lcms_n14()   { score = score + 1 };
    if ag_std_u_pk_n14()           > ag_std_u_pk_n7()            { score = score + 1 };
    if ag_std_u_pk_n28()           > ag_std_u_pk_n14()           { score = score + 1 };

    score
}
