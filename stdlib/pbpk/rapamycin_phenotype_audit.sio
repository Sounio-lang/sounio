// ── FINDING A: inh at D=5mg (overdose — should receive 1.5mg) ───────────────
pub fn pa_inh5_ncrit() -> i64 with Mut, Div, Panic {
    let ka=ob_ka_var_std(); let fv=ob_f_var_std()
    let k12=ob_k12_var_std(); let k21=ob_k21_var_std()
    pa_find_ncrit(5.0,0.002236,0.282, ka,fv,ob_ke_var_inh(),k12,k21)
}
pub fn pa_inh5_nlast_cert() -> i64 with Mut, Div, Panic {
    let ka=ob_ka_var_std(); let fv=ob_f_var_std()
    let k12=ob_k12_var_std(); let k21=ob_k21_var_std()
    pa_find_nlast_cert(5.0,0.002236,0.282, ka,fv,ob_ke_var_inh(),k12,k21)
}
pub fn pa_inh5_ntox() -> i64 with Mut, Div, Panic {
    pa_find_ntox(5.0,0.002236,0.282)
}
pub fn pa_inh5_cert_window() -> i64 with Mut, Div, Panic {
    let ncrit  = pa_inh5_ncrit()
    let nlast  = pa_inh5_nlast_cert()
    if ncrit == 0 { 0 } else { nlast - ncrit + 1 }
}
pub fn pa_inh5_zceil_n7() -> f64 with Mut, Div, Panic {
    let ka=ob_ka_var_std(); let fv=ob_f_var_std()
    let k12=ob_k12_var_std(); let k21=ob_k21_var_std()
    pa_zceil(5.0,7,0.002236,0.282, ka,fv,ob_ke_var_inh(),k12,k21)
}
pub fn pa_inh5_zceil_n8() -> f64 with Mut, Div, Panic {
    let ka=ob_ka_var_std(); let fv=ob_f_var_std()
