// stdlib/pbpk/rapamycin_sprint67_gate.sio — Sprint 67 certification gate
//
// Population-weighted timing synthesis across all five CYP3A4/P-gp strata,
// uniform and 3× loading-dose protocols (combined 4–20 window).
//
// Findings:
//   A: E[n_crit] = 8.55 (uniform) → 6.50 (loading), advance = 2.05 days
//   B: E[n_last] = 45.35 → 43.55, loss = 1.80 days (ceiling binds earlier)
//   C: E[span] essentially invariant: 36.80 → 37.05 (+0.25 days)
//   D: ind contributes 2.60/8.55 = 30.4% of E[n_crit] despite w=0.10
//   E: Pop cert N=7: uniform=0.75 → loading=0.90 (+0.15, slow stratum promoted)
//   F: ncrit spread (max−min) = 20 days for both protocols (spread invariant)
//   G: std dominates E[span] (15.0/36.8 = 40.8%); slow second (7.5)
//   H: E[n_crit_advance] ≈ E[n_last_loss] (2.05 ≈ 1.80): loading is nearly
//      zero-sum at population level — window shifts ~2 days earlier
//
// 56 assertions in sections A–H. All must pass (return 56).

module pbpk::rapamycin_sprint67_gate

use pbpk::rapamycin_pop_timing::{
    pt_e_ncrit_uniform, pt_e_ncrit_load, pt_e_ncrit_advance,
    pt_e_nlast_uniform, pt_e_nlast_load, pt_e_nlast_loss,
    pt_e_span_uniform, pt_e_span_load, pt_e_span_delta,
    pt_ind_ncrit_contrib, pt_ind_ncrit_frac,
    pt_cert_n7_uniform, pt_cert_n7_load, pt_cert_n7_gain,
    pt_ncrit_spread_uniform, pt_ncrit_spread_load,
    pt_std_span_contrib, pt_slow_span_contrib, pt_fast_span_contrib,
    pt_inh_span_contrib, pt_ind_span_contrib
}

pub fn rapamycin_sprint67_gate() -> i64 with Mut, Div, Panic {
    var score = 0

    // ── Section A: E[n_crit] values and advance (Finding A) ──────────────────
    if pt_e_ncrit_uniform() > 8.5  { score = score + 1 };
    if pt_e_ncrit_uniform() < 8.6  { score = score + 1 };
    if pt_e_ncrit_load()    > 6.4  { score = score + 1 };
    if pt_e_ncrit_load()    < 6.6  { score = score + 1 };
    if pt_e_ncrit_advance() > 2.0  { score = score + 1 };
    if pt_e_ncrit_advance() < 2.1  { score = score + 1 };
    if pt_e_ncrit_load()    < pt_e_ncrit_uniform() { score = score + 1 };

    // ── Section B: E[n_last] values and loss (Finding B) ─────────────────────
    if pt_e_nlast_uniform() > 45.3 { score = score + 1 };
    if pt_e_nlast_uniform() < 45.4 { score = score + 1 };
    if pt_e_nlast_load()    > 43.5 { score = score + 1 };
    if pt_e_nlast_load()    < 43.6 { score = score + 1 };
    if pt_e_nlast_loss()    > 1.7  { score = score + 1 };
    if pt_e_nlast_loss()    < 1.9  { score = score + 1 };
    if pt_e_nlast_load()    < pt_e_nlast_uniform() { score = score + 1 };

    // ── Section C: E[span] invariance (Finding C) ────────────────────────────
    if pt_e_span_uniform() > 36.7 { score = score + 1 };
    if pt_e_span_uniform() < 36.9 { score = score + 1 };
    if pt_e_span_load()    > 37.0 { score = score + 1 };
    if pt_e_span_load()    < 37.1 { score = score + 1 };
    if pt_e_span_delta()   > 0.0  { score = score + 1 };
    if pt_e_span_delta()   < 0.5  { score = score + 1 };
    if pt_e_span_load()    > pt_e_span_uniform() { score = score + 1 };

    // ── Section D: ind dominates E[n_crit] (Finding D) ───────────────────────
    if pt_ind_ncrit_contrib() > 2.5 { score = score + 1 };
    if pt_ind_ncrit_contrib() < 2.7 { score = score + 1 };
    if pt_ind_ncrit_frac()    > 0.30 { score = score + 1 };
    if pt_ind_ncrit_frac()    < 0.31 { score = score + 1 };
    if pt_ind_ncrit_contrib() > 0.15 * pt_e_ncrit_uniform() { score = score + 1 };
    if pt_ind_ncrit_frac() > 0.25 { score = score + 1 };
    if pt_e_ncrit_uniform() > pt_e_ncrit_advance() * 4.0 { score = score + 1 };

    // ── Section E: pop cert N=7 (Finding E) ──────────────────────────────────
    if pt_cert_n7_uniform() > 0.74 { score = score + 1 };
    if pt_cert_n7_uniform() < 0.76 { score = score + 1 };
    if pt_cert_n7_load()    > 0.89 { score = score + 1 };
    if pt_cert_n7_load()    < 0.91 { score = score + 1 };
    if pt_cert_n7_gain()    > 0.14 { score = score + 1 };
    if pt_cert_n7_gain()    < 0.16 { score = score + 1 };
    if pt_cert_n7_load()    > pt_cert_n7_uniform() { score = score + 1 };

    // ── Section F: ncrit spread invariant (Finding F) ────────────────────────
    if pt_ncrit_spread_uniform() > 19.9 { score = score + 1 };
    if pt_ncrit_spread_uniform() < 20.1 { score = score + 1 };
    if pt_ncrit_spread_load()    > 19.9 { score = score + 1 };
    if pt_ncrit_spread_load()    < 20.1 { score = score + 1 };
    if pt_ncrit_spread_uniform() == pt_ncrit_spread_load() { score = score + 1 };
    if pt_e_ncrit_advance() > 2.0 { score = score + 1 };
    if pt_e_nlast_loss()    > 1.5 { score = score + 1 };

    // ── Section G: span contributions ordering (Finding G) ───────────────────
    if pt_std_span_contrib()  > pt_slow_span_contrib() { score = score + 1 };
    if pt_slow_span_contrib() > pt_ind_span_contrib()  { score = score + 1 };
    if pt_ind_span_contrib()  > pt_fast_span_contrib() { score = score + 1 };
    if pt_fast_span_contrib() > pt_inh_span_contrib()  { score = score + 1 };
    if pt_std_span_contrib()  > 14.9 { score = score + 1 };
    if pt_slow_span_contrib() > 7.4  { score = score + 1 };
    if pt_inh_span_contrib()  < 2.0  { score = score + 1 };

    // ── Section H: advance ≈ loss (zero-sum at pop level, Finding H) ─────────
    let advance_minus_loss = pt_e_ncrit_advance() - pt_e_nlast_loss()
    if advance_minus_loss > 0.0  { score = score + 1 };
    if advance_minus_loss < 0.5  { score = score + 1 };
    if pt_e_span_delta()  < pt_e_ncrit_advance() { score = score + 1 };
    if pt_e_span_delta()  > 0.0  { score = score + 1 };
    if pt_e_ncrit_advance() > pt_e_span_delta() * 5.0 { score = score + 1 };
    if pt_cert_n7_gain() < pt_e_ncrit_advance() { score = score + 1 };
    if pt_e_nlast_uniform() > pt_e_nlast_load() { score = score + 1 };

    score
}
