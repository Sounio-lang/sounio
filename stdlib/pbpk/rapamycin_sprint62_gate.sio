// stdlib/pbpk/rapamycin_sprint62_gate.sio — Sprint 62 certification gate
//
// ISO GUM uncertainty budget decomposition for the standard stratum (D=5mg).
//
// Fractional contributions (u_i²/u_c²):
//   N=7:  ke=0.003, F=0.102, ka=0.816, k12=0.061, k21=0.017  sum=1.000
//   N=14: ke=0.006, F=0.092
//   N=28: ke=0.010, F=0.073, ka=0.583, k12=0.185, k21=0.148  sum=1.000
//
// Absolute u_c components:
//   ke  (mg/L): N=7:0.000049, N=14:0.000069, N=28:0.000101  (grows)
//   F   (mg/L): N=7:0.000273, N=14:0.000273, N=28:0.000273  (constant!)
//   ka  (mg/L): N=7:0.000772  (dominant source)
//
// Finding A: ka dominates — 81.6% at N=7, 58.3% at N=28; ke remains minor
//            throughout (0.3%→1.0%); F is second contributor (~10%→7%).
// Finding B: F's absolute contribution is N-invariant (0.000273 mg/L) —
//            it enters eu_u_c as a dose-proportional constant, not scaled by N.
// Finding C: k12+k21 grow from 7.8% to 33.3% (N=7→28) as the distribution
//            compartment equilibrates — late-phase budget shifts to distribution.
// Finding D: GUM additive closure holds: sum = 1.000 at N=7 and N=28.
//
// 56 assertions in sections A–H. All must pass (return 56).

module pbpk::rapamycin_sprint62_gate

use pbpk::rapamycin_uc_budget::{
    ucb_uc_ke_n7, ucb_uc_ke_n14, ucb_uc_ke_n28,
    ucb_uc_f_n7,  ucb_uc_f_n14,  ucb_uc_f_n28,
    ucb_uc_ka_n7, ucb_uc_k12_n7, ucb_uc_k21_n7,
    ucb_frac_ke_n7,  ucb_frac_ke_n14,  ucb_frac_ke_n28,
    ucb_frac_f_n7,   ucb_frac_f_n14,   ucb_frac_f_n28,
    ucb_frac_ka_n7,  ucb_frac_k12_n7,  ucb_frac_k21_n7,
    ucb_frac_ka_n28, ucb_frac_k12_n28, ucb_frac_k21_n28,
    ucb_sum_fracs_n7, ucb_sum_fracs_n28,
    ucb_ke_dominance_gain
}

pub fn rapamycin_sprint62_gate() -> i64 with Mut, Div, Panic {
    var score = 0

    // ── Section A: ka dominates at N=7 (Finding A) ───────────────────────────
    if ucb_frac_ka_n7() > 0.80 { score = score + 1 };
    if ucb_frac_ka_n7() < 0.85 { score = score + 1 };
    if ucb_frac_ka_n7() > ucb_frac_f_n7() { score = score + 1 };
    if ucb_frac_ka_n7() > ucb_frac_ke_n7() { score = score + 1 };
    if ucb_frac_ke_n7() < 0.01 { score = score + 1 };
    if ucb_frac_f_n7() > 0.09 { score = score + 1 };
    if ucb_frac_f_n7() < 0.12 { score = score + 1 };

    // ── Section B: ka still dominates at N=28, share reduced (Finding A) ─────
    if ucb_frac_ka_n28() > 0.55 { score = score + 1 };
    if ucb_frac_ka_n28() < 0.62 { score = score + 1 };
    if ucb_frac_ka_n28() > ucb_frac_f_n28() { score = score + 1 };
    if ucb_frac_ka_n28() > ucb_frac_ke_n28() { score = score + 1 };
    if ucb_frac_ka_n7()  > ucb_frac_ka_n28() { score = score + 1 };
    if ucb_frac_ke_n28() < 0.02 { score = score + 1 };
    if ucb_frac_f_n28()  > 0.07 { score = score + 1 };

    // ── Section C: F absolute contribution is N-invariant (Finding B) ────────
    if ucb_uc_f_n7()  > 0.00027 { score = score + 1 };
    if ucb_uc_f_n7()  < 0.00028 { score = score + 1 };
    if ucb_uc_f_n14() > 0.00027 { score = score + 1 };
    if ucb_uc_f_n14() < 0.00028 { score = score + 1 };
    if ucb_uc_f_n28() > 0.00027 { score = score + 1 };
    if ucb_uc_f_n28() < 0.00028 { score = score + 1 };
    if ucb_uc_f_n7()  > 0.0 { score = score + 1 };

    // ── Section D: k12+k21 grow with N (Finding C) ───────────────────────────
    if ucb_frac_k12_n7()  < ucb_frac_k12_n28() { score = score + 1 };
    if ucb_frac_k21_n7()  < ucb_frac_k21_n28() { score = score + 1 };
    if ucb_frac_k12_n7()  > 0.05 { score = score + 1 };
    if ucb_frac_k12_n7()  < 0.07 { score = score + 1 };
    if ucb_frac_k12_n28() > 0.18 { score = score + 1 };
    if ucb_frac_k12_n28() < 0.20 { score = score + 1 };
    if ucb_frac_k21_n28() > 0.14 { score = score + 1 };

    // ── Section E: ke minor throughout (Finding A) ───────────────────────────
    if ucb_frac_ke_n7()  < 0.01 { score = score + 1 };
    if ucb_frac_ke_n14() < 0.01 { score = score + 1 };
    if ucb_frac_ke_n28() < 0.02 { score = score + 1 };
    if ucb_frac_ke_n28() > ucb_frac_ke_n7() { score = score + 1 };
    if ucb_ke_dominance_gain() > 0.005 { score = score + 1 };
    if ucb_ke_dominance_gain() < 0.01 { score = score + 1 };
    if ucb_uc_ke_n28() > ucb_uc_ke_n7() { score = score + 1 };

    // ── Section F: GUM additive closure (Finding D) ───────────────────────────
    if ucb_sum_fracs_n7()  > 0.999 { score = score + 1 };
    if ucb_sum_fracs_n7()  < 1.001 { score = score + 1 };
    if ucb_sum_fracs_n28() > 0.999 { score = score + 1 };
    if ucb_sum_fracs_n28() < 1.001 { score = score + 1 };
    let ke_f_n7 = ucb_frac_ke_n7() + ucb_frac_f_n7()
    if ke_f_n7 > 0.10 { score = score + 1 };
    let ka_dist_n7 = ucb_frac_ka_n7() + ucb_frac_k12_n7() + ucb_frac_k21_n7()
    if ka_dist_n7 > 0.88 { score = score + 1 };
    let ke_f_n28 = ucb_frac_ke_n28() + ucb_frac_f_n28()
    if ke_f_n28 < 0.09 { score = score + 1 };

    // ── Section G: distribution equilibration hierarchy (Finding C) ───────────
    let dist_n28 = ucb_frac_k12_n28() + ucb_frac_k21_n28()
    if dist_n28 > 0.33 { score = score + 1 };
    let dist_n7 = ucb_frac_k12_n7() + ucb_frac_k21_n7()
    if dist_n7 < 0.10 { score = score + 1 };
    if ucb_frac_k12_n28() > ucb_frac_k21_n28() { score = score + 1 };
    if ucb_frac_k12_n7()  > ucb_frac_k21_n7()  { score = score + 1 };
    if ucb_frac_k21_n28() > ucb_frac_k21_n7() { score = score + 1 };
    if ucb_frac_k12_n28() > ucb_frac_k12_n7() { score = score + 1 };
    if ucb_frac_ka_n7() > dist_n28 { score = score + 1 };

    // ── Section H: policy — ka uncertainty is primary precision target ────────
    if ucb_frac_ka_n7()  > 0.80 { score = score + 1 };
    if ucb_frac_ka_n28() > 0.55 { score = score + 1 };
    if ucb_uc_f_n7()  > ucb_uc_ke_n7()  { score = score + 1 };
    if ucb_uc_ka_n7() > ucb_uc_f_n7()  { score = score + 1 };
    if ucb_frac_ke_n28() < 0.02 { score = score + 1 };
    if ucb_sum_fracs_n7()  > 0.999 { score = score + 1 };
    if ucb_sum_fracs_n28() > 0.999 { score = score + 1 };

    score
}
