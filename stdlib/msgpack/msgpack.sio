// msgpack/mod.sio — MessagePack Encoding
//
// Compact binary serialization following the MessagePack specification.
// Encodes integers, floats, and nil values.
//
// Reference: https://github.com/msgpack/msgpack/blob/master/spec.md

// ============================================================================
// INTEGER ENCODING
// ============================================================================
// MessagePack format for integers:
//   positive fixint: 0x00 - 0x7f (single byte, value 0-127)
//   negative fixint: 0xe0 - 0xff (single byte, value -32 to -1)
//   uint 8:  0xcc + 1 byte
//   uint 16: 0xcd + 2 bytes
//   uint 32: 0xce + 4 bytes
//   int 8:   0xd0 + 1 byte
//   int 16:  0xd1 + 2 bytes
//   int 32:  0xd2 + 4 bytes

pub fn msgpack_encode_int(val: i64, out: &![u8; 16]) -> i32 with Mut, Panic {
    // Positive fixint: 0-127
    if val >= 0 && val <= 127 {
        out[0] = (val as i32) as u8
        return 1
    }

    // Negative fixint: -32 to -1
    if val >= 0 - 32 && val < 0 {
        // 0xe0 | (val & 0x1f)
        let byte = 224 + (val + 32)
        out[0] = (byte as i32) as u8
        return 1
    }

    // Positive: uint 8 (128-255)
    if val >= 0 && val <= 255 {
        out[0] = 204  // 0xcc
        out[1] = (val as i32) as u8
        return 2
    }

    // Positive: uint 16 (256-65535)
    if val >= 0 && val <= 65535 {
        out[0] = 205  // 0xcd
        let v = val as i32
        out[1] = ((v / 256) % 256) as u8
        out[2] = (v % 256) as u8
        return 3
    }

    // Negative: int 8 (-128 to -33)
    if val >= 0 - 128 && val < 0 - 32 {
        out[0] = 208  // 0xd0
        let byte = (val + 256) % 256
        out[1] = (byte as i32) as u8
        return 2
    }

    // Negative: int 16 (-32768 to -129)
    if val >= 0 - 32768 && val < 0 - 128 {
        out[0] = 209  // 0xd1
        let v = (val + 65536) % 65536
        let vi = v as i32
        out[1] = ((vi / 256) % 256) as u8
        out[2] = (vi % 256) as u8
        return 3
    }

    // Positive: uint 32
    if val >= 0 && val <= 4294967295 {
        out[0] = 206  // 0xce
        var v = val
        out[4] = ((v % 256) as i32) as u8
        v = v / 256
        out[3] = ((v % 256) as i32) as u8
        v = v / 256
        out[2] = ((v % 256) as i32) as u8
        v = v / 256
        out[1] = ((v % 256) as i32) as u8
        return 5
    }

    // Negative: int 32
    out[0] = 210  // 0xd2
    let v = (val + 4294967296) % 4294967296
    var rem = v
    out[4] = ((rem % 256) as i32) as u8
    rem = rem / 256
    out[3] = ((rem % 256) as i32) as u8
    rem = rem / 256
    out[2] = ((rem % 256) as i32) as u8
    rem = rem / 256
    out[1] = ((rem % 256) as i32) as u8
    5
}

// ============================================================================
// FLOAT ENCODING
// ============================================================================
// MessagePack float 64: 0xcb + 8 bytes (IEEE 754 big-endian)
// We use a simplified encoding that stores the f64 as raw bytes.

pub fn msgpack_encode_float(val: f64, out: &![u8; 16]) -> i32 with Mut, Panic, Div {
    // float 64 format: 0xcb + 8 bytes big-endian IEEE 754
    out[0] = 203  // 0xcb

    // For a pure-Sounio implementation without bit-cast intrinsics,
    // we encode a simplified representation:
    // Store as integer * scale approach (limited precision).
    // NOTE: A full implementation would need a reinterpret_cast intrinsic.

    // Detect special cases
    if val == 0.0 {
        var i: i32 = 1
        while i <= 8 {
            out[i as usize] = 0
            i = i + 1
        }
        return 9
    }

    // For non-zero values, store a marker + approximate encoding
    // This is a placeholder for the bit-level encoding.
    // In practice, the JIT can provide f64_to_bits intrinsic.
    out[1] = 0
    out[2] = 0
    out[3] = 0
    out[4] = 0
    out[5] = 0
    out[6] = 0
    out[7] = 0
    out[8] = 1  // non-zero marker
    9
}

// ============================================================================
// NIL ENCODING
// ============================================================================
// MessagePack nil: single byte 0xc0

pub fn msgpack_encode_nil(out: &![u8; 16]) -> i32 with Mut, Panic {
    out[0] = 192  // 0xc0
    1
}

// ============================================================================
// INLINE TESTS
// ============================================================================

//@ run-pass
fn test_encode_positive_fixint() -> i32 {
    var buf: [u8; 16] = [0; 16]
    let n = msgpack_encode_int(42, &!buf)
    if n != 1 { return 1 }
    if buf[0] != 42 { return 2 }
    0
}

//@ run-pass
fn test_encode_zero() -> i32 {
    var buf: [u8; 16] = [0; 16]
    let n = msgpack_encode_int(0, &!buf)
    if n != 1 { return 1 }
    if buf[0] != 0 { return 2 }
    0
}

//@ run-pass
fn test_encode_negative_fixint() -> i32 {
    var buf: [u8; 16] = [0; 16]
    let n = msgpack_encode_int(0 - 1, &!buf)
    if n != 1 { return 1 }
    // -1 should be 0xff = 255
    if buf[0] != 255 { return 2 }
    0
}

//@ run-pass
fn test_encode_nil() -> i32 {
    var buf: [u8; 16] = [0; 16]
    let n = msgpack_encode_nil(&!buf)
    if n != 1 { return 1 }
    if buf[0] != 192 { return 2 }
    0
}

//@ run-pass
fn test_encode_uint8() -> i32 {
    var buf: [u8; 16] = [0; 16]
    let n = msgpack_encode_int(200, &!buf)
    if n != 2 { return 1 }
    if buf[0] != 204 { return 2 }  // 0xcc
    if buf[1] != 200 { return 3 }
    0
}

//@ run-pass
fn test_encode_float_zero() -> i32 {
    var buf: [u8; 16] = [0; 16]
    let n = msgpack_encode_float(0.0, &!buf)
    if n != 9 { return 1 }
    if buf[0] != 203 { return 2 }  // 0xcb
    0
}
