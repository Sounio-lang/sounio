//! stdlib/msgpack/mod.sio - MessagePack Binary Serialization
//!
//! This module provides encoding and decoding of MessagePack, a compact binary
//! serialization format. MessagePack is more efficient than JSON for binary
//! data and supports more data types.
//!
//! NOTE: This is a stub implementation. Pattern matching with variable bindings
//! is not yet supported in Sounio for user-defined enum variants. Full
//! implementation pending language feature completion.

// =============================================================================
// FFI Declarations
// =============================================================================

extern "C" {
    fn malloc(size: usize) -> *mut u8;
    fn free(ptr: *mut u8);
}

// =============================================================================
// MessagePack Value Types (Tag-based representation)
// =============================================================================

// Value type tags
let TAG_NIL: u8 = 0;
let TAG_BOOL: u8 = 1;
let TAG_POS_INT: u8 = 2;
let TAG_NEG_INT: u8 = 3;
let TAG_FLOAT32: u8 = 4;
let TAG_FLOAT64: u8 = 5;
let TAG_STR: u8 = 6;
let TAG_BIN: u8 = 7;
let TAG_ARRAY: u8 = 8;
let TAG_MAP: u8 = 9;
let TAG_EXT: u8 = 10;

// MessagePack value using struct-based tagged union
// This avoids pattern matching on enum variants which Sounio doesn't support
pub struct MsgPackValue {
    tag: u8,
    bool_val: bool,
    u64_val: u64,
    i64_val: i64,
    f32_val: f32,
    f64_val: f64,
    str_val: string,
    bin_val: Vec<u8>,
    array_val: Vec<MsgPackValue>,
    map_val: Vec<(MsgPackValue, MsgPackValue)>,
    ext_type_id: i8,
    ext_data: Vec<u8>,
}

// Decode errors
pub enum MsgPackError {
    UnexpectedEof,
    InvalidMarker,
    InvalidUtf8,
    DataTooLarge,
    InvalidExtType,
    BufferTooSmall
}

// =============================================================================
// Value Constructors
// =============================================================================

// Creates a nil value
pub fn msgpack_nil() -> MsgPackValue with Alloc {
    MsgPackValue {
        tag: TAG_NIL,
        bool_val: false,
        u64_val: 0,
        i64_val: 0,
        f32_val: 0.0,
        f64_val: 0.0,
        str_val: "",
        bin_val: [],
        array_val: [],
        map_val: [],
        ext_type_id: 0,
        ext_data: [],
    }
}

// Creates a boolean value
pub fn msgpack_bool(b: bool) -> MsgPackValue with Alloc {
    MsgPackValue {
        tag: TAG_BOOL,
        bool_val: b,
        u64_val: 0,
        i64_val: 0,
        f32_val: 0.0,
        f64_val: 0.0,
        str_val: "",
        bin_val: [],
        array_val: [],
        map_val: [],
        ext_type_id: 0,
        ext_data: [],
    }
}

// Creates a positive integer value
pub fn msgpack_uint(n: u64) -> MsgPackValue with Alloc {
    MsgPackValue {
        tag: TAG_POS_INT,
        bool_val: false,
        u64_val: n,
        i64_val: 0,
        f32_val: 0.0,
        f64_val: 0.0,
        str_val: "",
        bin_val: [],
        array_val: [],
        map_val: [],
        ext_type_id: 0,
        ext_data: [],
    }
}

// Creates a signed integer value
pub fn msgpack_int(n: i64) -> MsgPackValue with Alloc {
    if n >= 0 {
        MsgPackValue {
            tag: TAG_POS_INT,
            bool_val: false,
            u64_val: n as u64,
            i64_val: 0,
            f32_val: 0.0,
            f64_val: 0.0,
            str_val: "",
            bin_val: [],
            array_val: [],
            map_val: [],
            ext_type_id: 0,
            ext_data: [],
        }
    } else {
        MsgPackValue {
            tag: TAG_NEG_INT,
            bool_val: false,
            u64_val: 0,
            i64_val: n,
            f32_val: 0.0,
            f64_val: 0.0,
            str_val: "",
            bin_val: [],
            array_val: [],
            map_val: [],
            ext_type_id: 0,
            ext_data: [],
        }
    }
}

// Creates a 64-bit float value
pub fn msgpack_float(f: f64) -> MsgPackValue with Alloc {
    MsgPackValue {
        tag: TAG_FLOAT64,
        bool_val: false,
        u64_val: 0,
        i64_val: 0,
        f32_val: 0.0,
        f64_val: f,
        str_val: "",
        bin_val: [],
        array_val: [],
        map_val: [],
        ext_type_id: 0,
        ext_data: [],
    }
}

// Creates a string value
pub fn msgpack_str(s: string) -> MsgPackValue with Alloc {
    MsgPackValue {
        tag: TAG_STR,
        bool_val: false,
        u64_val: 0,
        i64_val: 0,
        f32_val: 0.0,
        f64_val: 0.0,
        str_val: s,
        bin_val: [],
        array_val: [],
        map_val: [],
        ext_type_id: 0,
        ext_data: [],
    }
}

// Creates a binary value
pub fn msgpack_bin(data: Vec<u8>) -> MsgPackValue with Alloc {
    MsgPackValue {
        tag: TAG_BIN,
        bool_val: false,
        u64_val: 0,
        i64_val: 0,
        f32_val: 0.0,
        f64_val: 0.0,
        str_val: "",
        bin_val: data,
        array_val: [],
        map_val: [],
        ext_type_id: 0,
        ext_data: [],
    }
}

// Creates an array value
pub fn msgpack_array(items: Vec<MsgPackValue>) -> MsgPackValue with Alloc {
    MsgPackValue {
        tag: TAG_ARRAY,
        bool_val: false,
        u64_val: 0,
        i64_val: 0,
        f32_val: 0.0,
        f64_val: 0.0,
        str_val: "",
        bin_val: [],
        array_val: items,
        map_val: [],
        ext_type_id: 0,
        ext_data: [],
    }
}

// Creates a map value
pub fn msgpack_map(entries: Vec<(MsgPackValue, MsgPackValue)>) -> MsgPackValue with Alloc {
    MsgPackValue {
        tag: TAG_MAP,
        bool_val: false,
        u64_val: 0,
        i64_val: 0,
        f32_val: 0.0,
        f64_val: 0.0,
        str_val: "",
        bin_val: [],
        array_val: [],
        map_val: entries,
        ext_type_id: 0,
        ext_data: [],
    }
}

// =============================================================================
// Value Type Checks
// =============================================================================

pub fn msgpack_is_nil(value: &MsgPackValue) -> bool {
    value.tag == TAG_NIL
}

pub fn msgpack_is_bool(value: &MsgPackValue) -> bool {
    value.tag == TAG_BOOL
}

pub fn msgpack_is_int(value: &MsgPackValue) -> bool {
    value.tag == TAG_POS_INT || value.tag == TAG_NEG_INT
}

pub fn msgpack_is_float(value: &MsgPackValue) -> bool {
    value.tag == TAG_FLOAT32 || value.tag == TAG_FLOAT64
}

pub fn msgpack_is_str(value: &MsgPackValue) -> bool {
    value.tag == TAG_STR
}

pub fn msgpack_is_bin(value: &MsgPackValue) -> bool {
    value.tag == TAG_BIN
}

pub fn msgpack_is_array(value: &MsgPackValue) -> bool {
    value.tag == TAG_ARRAY
}

pub fn msgpack_is_map(value: &MsgPackValue) -> bool {
    value.tag == TAG_MAP
}

// =============================================================================
// Value Accessors
// =============================================================================

pub fn msgpack_as_bool(value: &MsgPackValue) -> Option<bool> {
    if value.tag == TAG_BOOL {
        return Some(value.bool_val)
    }
    return None
}

pub fn msgpack_as_i64(value: &MsgPackValue) -> Option<i64> {
    if value.tag == TAG_POS_INT {
        return Some(value.u64_val as i64)
    }
    if value.tag == TAG_NEG_INT {
        return Some(value.i64_val)
    }
    return None
}

pub fn msgpack_as_u64(value: &MsgPackValue) -> Option<u64> {
    if value.tag == TAG_POS_INT {
        return Some(value.u64_val)
    }
    return None
}

pub fn msgpack_as_f64(value: &MsgPackValue) -> Option<f64> {
    if value.tag == TAG_FLOAT64 {
        return Some(value.f64_val)
    }
    if value.tag == TAG_FLOAT32 {
        return Some(value.f32_val as f64)
    }
    return None
}

pub fn msgpack_as_str(value: &MsgPackValue) -> Option<&string> {
    if value.tag == TAG_STR {
        return Some(&value.str_val)
    }
    return None
}

pub fn msgpack_as_bin(value: &MsgPackValue) -> Option<&Vec<u8>> {
    if value.tag == TAG_BIN {
        return Some(&value.bin_val)
    }
    return None
}

pub fn msgpack_as_array(value: &MsgPackValue) -> Option<&Vec<MsgPackValue>> {
    if value.tag == TAG_ARRAY {
        return Some(&value.array_val)
    }
    return None
}

pub fn msgpack_as_map(value: &MsgPackValue) -> Option<&Vec<(MsgPackValue, MsgPackValue)>> {
    if value.tag == TAG_MAP {
        return Some(&value.map_val)
    }
    return None
}

// Returns the length of an array, map, string, or binary
pub fn msgpack_len(value: &MsgPackValue) -> usize {
    if value.tag == TAG_ARRAY {
        value.array_val.len()
    } else if value.tag == TAG_MAP {
        value.map_val.len()
    } else if value.tag == TAG_STR {
        value.str_val.len()
    } else if value.tag == TAG_BIN {
        value.bin_val.len()
    } else {
        0
    }
}

// =============================================================================
// Error Handling
// =============================================================================

pub fn msgpack_error_message(err: &MsgPackError) -> string {
    match err {
        MsgPackError::UnexpectedEof => "Unexpected end of data",
        MsgPackError::InvalidMarker => "Invalid marker byte",
        MsgPackError::InvalidUtf8 => "Invalid UTF-8 in string",
        MsgPackError::DataTooLarge => "Data too large",
        MsgPackError::InvalidExtType => "Invalid extension type",
        MsgPackError::BufferTooSmall => "Buffer too small for encoding"
    }
}

// =============================================================================
// Encoding (Stub Implementation)
// =============================================================================

// Encodes a MsgPackValue into bytes.
// NOTE: Stub implementation - returns empty vector pending full implementation
pub fn msgpack_encode(value: &MsgPackValue) -> Vec<u8> with Alloc, Mut, Div, Panic {
    var buf: Vec<u8> = [];
    encode_value(&!buf, value);
    buf
}

// Encodes a MessagePack ext type: fixext (len 1/2/4/8/16) or ext8/ext16/ext32.
// MessagePack spec §2.4: https://github.com/msgpack/msgpack/blob/master/spec.md
fn encode_ext(buf: &!Vec<u8>, type_id: i8, data: &Vec<u8>) with Alloc, Mut, Div, Panic {
    let len = data.len();
    let tid = type_id as u8;

    // Prefer fixext formats for power-of-two lengths
    if len == 1 {
        buf.push(212); // 0xd4 = fixext 1
        buf.push(tid);
        buf.push(data[0]);
        return
    } else if len == 2 {
        buf.push(213); // 0xd5 = fixext 2
        buf.push(tid);
        buf.push(data[0]); buf.push(data[1]);
        return
    } else if len == 4 {
        buf.push(214); // 0xd6 = fixext 4
        buf.push(tid);
        var i: usize = 0; while i < 4 { buf.push(data[i]); i = i + 1 }
        return
    } else if len == 8 {
        buf.push(215); // 0xd7 = fixext 8
        buf.push(tid);
        var i: usize = 0; while i < 8 { buf.push(data[i]); i = i + 1 }
        return
    } else if len == 16 {
        buf.push(216); // 0xd8 = fixext 16
        buf.push(tid);
        var i: usize = 0; while i < 16 { buf.push(data[i]); i = i + 1 }
        return
    }

    // Variable-length ext formats
    if len <= 255 {
        buf.push(199); // 0xc7 = ext8
        buf.push(len as u8);
        buf.push(tid);
    } else if len <= 65535 {
        buf.push(200); // 0xc8 = ext16
        buf.push((len >> 8) as u8);
        buf.push(len as u8);
        buf.push(tid);
    } else {
        buf.push(201); // 0xc9 = ext32
        buf.push((len >> 24) as u8);
        buf.push((len >> 16) as u8);
        buf.push((len >> 8) as u8);
        buf.push(len as u8);
        buf.push(tid);
    }

    var i: usize = 0;
    while i < len {
        buf.push(data[i]);
        i = i + 1
    }
}

fn encode_value(buf: &!Vec<u8>, value: &MsgPackValue) with Alloc, Mut, Div, Panic {
    if value.tag == TAG_NIL {
        buf.push(192); // 0xc0
    } else if value.tag == TAG_BOOL {
        if value.bool_val {
            buf.push(195); // 0xc3 = true
        } else {
            buf.push(194); // 0xc2 = false
        }
    } else if value.tag == TAG_POS_INT {
        encode_pos_int(buf, value.u64_val);
    } else if value.tag == TAG_NEG_INT {
        encode_neg_int(buf, value.i64_val);
    } else if value.tag == TAG_FLOAT64 {
        encode_float64(buf, value.f64_val);
    } else if value.tag == TAG_STR {
        encode_str(buf, &value.str_val);
    } else if value.tag == TAG_BIN {
        encode_bin(buf, &value.bin_val);
    } else if value.tag == TAG_ARRAY {
        encode_array(buf, &value.array_val);
    } else if value.tag == TAG_MAP {
        encode_map(buf, &value.map_val);
    }
    } else if value.tag == TAG_EXT {
        encode_ext(buf, value.ext_type_id, &value.ext_data);
    }
}

fn encode_pos_int(buf: &!Vec<u8>, n: u64) with Alloc {
    if n <= 127 {
        // Positive fixint
        buf.push(n as u8);
    } else if n <= 255 {
        buf.push(204); // 0xcc = uint8
        buf.push(n as u8);
    } else if n <= 65535 {
        buf.push(205); // 0xcd = uint16
        buf.push((n >> 8) as u8);
        buf.push(n as u8);
    } else if n <= 4294967295 {
        buf.push(206); // 0xce = uint32
        buf.push((n >> 24) as u8);
        buf.push((n >> 16) as u8);
        buf.push((n >> 8) as u8);
        buf.push(n as u8);
    } else {
        buf.push(207); // 0xcf = uint64
        buf.push((n >> 56) as u8);
        buf.push((n >> 48) as u8);
        buf.push((n >> 40) as u8);
        buf.push((n >> 32) as u8);
        buf.push((n >> 24) as u8);
        buf.push((n >> 16) as u8);
        buf.push((n >> 8) as u8);
        buf.push(n as u8);
    }
}

fn encode_neg_int(buf: &!Vec<u8>, n: i64) with Alloc {
    if n >= -32 {
        // Negative fixint
        buf.push((n as i8) as u8);
    } else if n >= -128 {
        buf.push(208); // 0xd0 = int8
        buf.push(n as u8);
    } else if n >= -32768 {
        buf.push(209); // 0xd1 = int16
        buf.push((n >> 8) as u8);
        buf.push(n as u8);
    } else if n >= -2147483648 {
        buf.push(210); // 0xd2 = int32
        buf.push((n >> 24) as u8);
        buf.push((n >> 16) as u8);
        buf.push((n >> 8) as u8);
        buf.push(n as u8);
    } else {
        buf.push(211); // 0xd3 = int64
        buf.push((n >> 56) as u8);
        buf.push((n >> 48) as u8);
        buf.push((n >> 40) as u8);
        buf.push((n >> 32) as u8);
        buf.push((n >> 24) as u8);
        buf.push((n >> 16) as u8);
        buf.push((n >> 8) as u8);
        buf.push(n as u8);
    }
}

fn encode_float64(buf: &!Vec<u8>, f: f64) with Alloc, Mut {
    buf.push(203); // 0xcb = float64
    let bits = f64_to_bits(f);
    buf.push((bits >> 56) as u8);
    buf.push((bits >> 48) as u8);
    buf.push((bits >> 40) as u8);
    buf.push((bits >> 32) as u8);
    buf.push((bits >> 24) as u8);
    buf.push((bits >> 16) as u8);
    buf.push((bits >> 8) as u8);
    buf.push(bits as u8);
}

fn encode_str(buf: &!Vec<u8>, s: &string) with Alloc, Mut, Div {
    let len = s.len();

    if len <= 31 {
        // Fixstr
        buf.push(160 | (len as u8)); // 0xa0 | len
    } else if len <= 255 {
        buf.push(217); // 0xd9 = str8
        buf.push(len as u8);
    } else if len <= 65535 {
        buf.push(218); // 0xda = str16
        buf.push((len >> 8) as u8);
        buf.push(len as u8);
    } else {
        buf.push(219); // 0xdb = str32
        buf.push((len >> 24) as u8);
        buf.push((len >> 16) as u8);
        buf.push((len >> 8) as u8);
        buf.push(len as u8);
    }

    // Push string bytes
    var i: usize = 0;
    while i < len {
        buf.push(s.byte_at(i));
        i = i + 1;
    }
}

fn encode_bin(buf: &!Vec<u8>, data: &Vec<u8>) with Alloc, Mut, Div, Panic {
    let len = data.len();

    if len <= 255 {
        buf.push(196); // 0xc4 = bin8
        buf.push(len as u8);
    } else if len <= 65535 {
        buf.push(197); // 0xc5 = bin16
        buf.push((len >> 8) as u8);
        buf.push(len as u8);
    } else {
        buf.push(198); // 0xc6 = bin32
        buf.push((len >> 24) as u8);
        buf.push((len >> 16) as u8);
        buf.push((len >> 8) as u8);
        buf.push(len as u8);
    }

    var i: usize = 0;
    while i < len {
        buf.push(data[i]);
        i = i + 1;
    }
}

fn encode_array(buf: &!Vec<u8>, items: &Vec<MsgPackValue>) with Alloc, Mut, Div, Panic {
    let len = items.len();

    if len <= 15 {
        // Fixarray
        buf.push(144 | (len as u8)); // 0x90 | len
    } else if len <= 65535 {
        buf.push(220); // 0xdc = array16
        buf.push((len >> 8) as u8);
        buf.push(len as u8);
    } else {
        buf.push(221); // 0xdd = array32
        buf.push((len >> 24) as u8);
        buf.push((len >> 16) as u8);
        buf.push((len >> 8) as u8);
        buf.push(len as u8);
    }

    var i: usize = 0;
    while i < len {
        encode_value(buf, &items[i]);
        i = i + 1;
    }
}

fn encode_map(buf: &!Vec<u8>, entries: &Vec<(MsgPackValue, MsgPackValue)>) with Alloc, Mut, Div, Panic {
    let len = entries.len();

    if len <= 15 {
        // Fixmap
        buf.push(128 | (len as u8)); // 0x80 | len
    } else if len <= 65535 {
        buf.push(222); // 0xde = map16
        buf.push((len >> 8) as u8);
        buf.push(len as u8);
    } else {
        buf.push(223); // 0xdf = map32
        buf.push((len >> 24) as u8);
        buf.push((len >> 16) as u8);
        buf.push((len >> 8) as u8);
        buf.push(len as u8);
    }

    var i: usize = 0;
    while i < len {
        encode_value(buf, &entries[i].0);
        encode_value(buf, &entries[i].1);
        i = i + 1;
    }
}

// Helper: convert f64 to bits using pointer reinterpret
fn f64_to_bits(f: f64) -> u64 with Alloc, Mut {
    let ptr = malloc(8) as *mut f64;
    *ptr = f;
    let u_ptr = ptr as *mut u64;
    let result = *u_ptr;
    free(ptr as *mut u8);
    result
}

// =============================================================================
// Decoding (Stub Implementation)
// =============================================================================

// Decodes MessagePack bytes into a value.
// NOTE: Stub implementation - returns nil for now pending full implementation
pub fn msgpack_decode(data: &[u8]) -> Result<MsgPackValue, MsgPackError> with Alloc, Mut, Panic, Div {
    if data.len() == 0 {
        return Err(MsgPackError::UnexpectedEof)
    }

    var pos: usize = 0;
    decode_value_at(data, &!pos)
}

fn decode_value_at(data: &[u8], pos: &!usize) -> Result<MsgPackValue, MsgPackError> with Alloc, Mut, Panic, Div {
    if *pos >= data.len() {
        return Err(MsgPackError::UnexpectedEof)
    }

    let marker = data[*pos];
    *pos = *pos + 1;

    // Positive fixint (0x00 - 0x7f)
    if marker <= 127 {
        return Ok(msgpack_uint(marker as u64))
    }

    // Negative fixint (0xe0 - 0xff)
    if marker >= 224 {
        return Ok(msgpack_int((marker as i8) as i64))
    }

    // Fixmap (0x80 - 0x8f)
    if marker >= 128 && marker <= 143 {
        let len = (marker & 15) as usize;
        return decode_map_n(data, pos, len)
    }

    // Fixarray (0x90 - 0x9f)
    if marker >= 144 && marker <= 159 {
        let len = (marker & 15) as usize;
        return decode_array_n(data, pos, len)
    }

    // Fixstr (0xa0 - 0xbf)
    if marker >= 160 && marker <= 191 {
        let len = (marker & 31) as usize;
        return decode_str_n(data, pos, len)
    }

    // Nil: 0xc0 = 192
    if marker == 192 {
        return Ok(msgpack_nil())
    }
    // False: 0xc2 = 194
    if marker == 194 {
        return Ok(msgpack_bool(false))
    }
    // True: 0xc3 = 195
    if marker == 195 {
        return Ok(msgpack_bool(true))
    }

    // Float64: 0xcb = 203
    if marker == 203 {
        if *pos + 8 > data.len() {
            return Err(MsgPackError::UnexpectedEof)
        }
        let bits = read_u64_be(data, *pos);
        *pos = *pos + 8;
        return Ok(msgpack_float(f64_from_bits(bits)))
    }

    // Uint8: 0xcc = 204
    if marker == 204 {
        if *pos >= data.len() {
            return Err(MsgPackError::UnexpectedEof)
        }
        let v = data[*pos] as u64;
        *pos = *pos + 1;
        return Ok(msgpack_uint(v))
    }

    // Uint16: 0xcd = 205
    if marker == 205 {
        if *pos + 2 > data.len() {
            return Err(MsgPackError::UnexpectedEof)
        }
        let v = read_u16_be(data, *pos) as u64;
        *pos = *pos + 2;
        return Ok(msgpack_uint(v))
    }

    // Uint32: 0xce = 206
    if marker == 206 {
        if *pos + 4 > data.len() {
            return Err(MsgPackError::UnexpectedEof)
        }
        let v = read_u32_be(data, *pos) as u64;
        *pos = *pos + 4;
        return Ok(msgpack_uint(v))
    }

    // Uint64: 0xcf = 207
    if marker == 207 {
        if *pos + 8 > data.len() {
            return Err(MsgPackError::UnexpectedEof)
        }
        let v = read_u64_be(data, *pos);
        *pos = *pos + 8;
        return Ok(msgpack_uint(v))
    }

    // Str8: 0xd9 = 217
    if marker == 217 {
        if *pos >= data.len() {
            return Err(MsgPackError::UnexpectedEof)
        }
        let len = data[*pos] as usize;
        *pos = *pos + 1;
        return decode_str_n(data, pos, len)
    }

    // Str16: 0xda = 218
    if marker == 218 {
        if *pos + 2 > data.len() {
            return Err(MsgPackError::UnexpectedEof)
        }
        let len = read_u16_be(data, *pos) as usize;
        *pos = *pos + 2;
        return decode_str_n(data, pos, len)
    }

    // Array16: 0xdc = 220
    if marker == 220 {
        if *pos + 2 > data.len() {
            return Err(MsgPackError::UnexpectedEof)
        }
        let len = read_u16_be(data, *pos) as usize;
        *pos = *pos + 2;
        return decode_array_n(data, pos, len)
    }

    // Map16: 0xde = 222
    if marker == 222 {
        if *pos + 2 > data.len() {
            return Err(MsgPackError::UnexpectedEof)
        }
        let len = read_u16_be(data, *pos) as usize;
        *pos = *pos + 2;
        return decode_map_n(data, pos, len)
    }

    // Unknown marker
    Err(MsgPackError::InvalidMarker)
}

fn decode_str_n(data: &[u8], pos: &!usize, len: usize) -> Result<MsgPackValue, MsgPackError> with Alloc, Mut, Div, Panic {
    if *pos + len > data.len() {
        return Err(MsgPackError::UnexpectedEof)
    }

    // For simplicity, just create empty string (full UTF-8 handling pending)
    var s: string = "";
    var i: usize = 0;
    while i < len {
        // ASCII only for now
        let b = data[*pos + i];
        if b < 128 {
            s = s ++ char_from_ascii(b);
        }
        i = i + 1;
    }
    *pos = *pos + len;
    Ok(msgpack_str(s))
}

fn decode_array_n(data: &[u8], pos: &!usize, len: usize) -> Result<MsgPackValue, MsgPackError> with Alloc {
    // Stub implementation - just skip past the array elements
    // Full implementation requires unwrapping Result values which needs pattern matching
    var items: Vec<MsgPackValue> = [];
    // For now, return empty array
    Ok(msgpack_array(items))
}

fn decode_map_n(data: &[u8], pos: &!usize, len: usize) -> Result<MsgPackValue, MsgPackError> with Alloc {
    // Stub implementation - just skip past the map entries
    // Full implementation requires unwrapping Result values which needs pattern matching
    var entries: Vec<(MsgPackValue, MsgPackValue)> = [];
    // For now, return empty map
    Ok(msgpack_map(entries))
}

// =============================================================================
// Helper Functions
// =============================================================================

fn read_u16_be(data: &[u8], pos: usize) -> u16 with Panic {
    ((data[pos] as u16) << 8) | (data[pos + 1] as u16)
}

fn read_u32_be(data: &[u8], pos: usize) -> u32 with Panic {
    ((data[pos] as u32) << 24) |
    ((data[pos + 1] as u32) << 16) |
    ((data[pos + 2] as u32) << 8) |
    (data[pos + 3] as u32)
}

fn read_u64_be(data: &[u8], pos: usize) -> u64 with Panic {
    ((data[pos] as u64) << 56) |
    ((data[pos + 1] as u64) << 48) |
    ((data[pos + 2] as u64) << 40) |
    ((data[pos + 3] as u64) << 32) |
    ((data[pos + 4] as u64) << 24) |
    ((data[pos + 5] as u64) << 16) |
    ((data[pos + 6] as u64) << 8) |
    (data[pos + 7] as u64)
}

fn f64_from_bits(bits: u64) -> f64 with Alloc, Mut {
    let ptr = malloc(8) as *mut u64;
    *ptr = bits;
    let f_ptr = ptr as *mut f64;
    let result = *f_ptr;
    free(ptr as *mut u8);
    result
}

fn char_from_ascii(b: u8) -> string {
    // Simplified ASCII to string conversion
    // Returns single character string for printable ASCII
    if b >= 32 && b <= 126 {
        // Would need proper char conversion - stub returns "?"
        "?"
    } else {
        ""
    }
}
