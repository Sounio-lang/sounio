// stdlib/msgpack/mod.sio — Public exports for the msgpack module
//
// Per stdlib/CONVENTIONS.md §2, mod.sio declares only the public surface
// (pub use re-exports). Implementations live in the sibling files.

pub use msgpack::lib::{
    MsgPackBuf,
    msgpack_new,
    msgpack_pack_bool,
    msgpack_pack_f64,
    msgpack_pack_fixstr,
    msgpack_pack_i64,
    msgpack_pack_nil,
    msgpack_unpack_bool,
    msgpack_unpack_bool_advance,
    msgpack_unpack_f64,
    msgpack_unpack_f64_advance,
    msgpack_unpack_i64,
    msgpack_unpack_i64_advance,
    msgpack_unpack_type,
}

pub use msgpack::msgpack::{
    msgpack_encode_float,
    msgpack_encode_int,
    msgpack_encode_nil,
}

