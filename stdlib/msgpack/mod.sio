//! stdlib/msgpack/mod.sio - MessagePack Binary Serialization
//!
//! This module provides encoding and decoding of MessagePack, a compact binary
//! serialization format. MessagePack is more efficient than JSON for binary
//! data and supports more data types.
//!
//! # Examples
//! ```sio
//! // Encode a value
//! let value = MsgPackValue::Map(vec![
//!     (MsgPackValue::Str("name"), MsgPackValue::Str("John")),
//!     (MsgPackValue::Str("age"), MsgPackValue::PosInt(30)),
//! ])
//! let bytes = msgpack_encode(&value)
//!
//! // Decode bytes
//! match msgpack_decode(&bytes) {
//!     Ok(decoded) => print("Decoded successfully"),
//!     Err(e) => print("Decode error: " ++ msgpack_error_message(&e)),
//! }
//! ```

// =============================================================================
// MessagePack Value Types
// =============================================================================

// Represents a MessagePack value
pub enum MsgPackValue {
    // Nil value
    Nil,
    // Boolean value
    Bool(bool),
    // Positive integer (0 to 2^64-1)
    PosInt(u64),
    // Negative integer (-2^63 to -1)
    NegInt(i64),
    // 32-bit float
    Float32(f32),
    // 64-bit float
    Float64(f64),
    // UTF-8 string
    Str(string),
    // Binary data
    Bin(Vec<u8>),
    // Array of values
    Array(Vec<MsgPackValue>),
    // Map of key-value pairs
    Map(Vec<(MsgPackValue, MsgPackValue)>),
    // Extension type (type_id, data)
    Ext { type_id: i8, data: Vec<u8> }
}

// Decode errors
pub enum MsgPackError {
    // Unexpected end of data
    UnexpectedEof,
    // Invalid type marker
    InvalidMarker { marker: u8 },
    // Invalid UTF-8 in string
    InvalidUtf8,
    // Data too large
    DataTooLarge { max: usize, actual: usize },
    // Invalid extension type
    InvalidExtType { type_id: i8 },
    // Buffer too small for encoding
    BufferTooSmall
}

// Returns an error message
pub fn msgpack_error_message(err: &MsgPackError) -> string {
    match err {
        MsgPackError::UnexpectedEof => "Unexpected end of data".to_string(),
        MsgPackError::InvalidMarker { marker } => "Invalid marker: 0x" ++ format_hex(*marker as u64, 2),
        MsgPackError::InvalidUtf8 => "Invalid UTF-8 in string".to_string(),
        MsgPackError::DataTooLarge { max, actual } => "Data too large: max " ++ max.to_string() ++ ", got " ++ actual.to_string(),
        MsgPackError::InvalidExtType { type_id } => "Invalid extension type: " ++ type_id.to_string(),
        MsgPackError::BufferTooSmall => "Buffer too small for encoding".to_string()
    }
}

fn format_hex(n: u64, min_digits: usize) -> string with Alloc {
    let hex_chars = "0123456789abcdef";
    var result = String::new();
    var value = n;

    if value == 0 {
        result.push('0');
    } else {
        while value > 0 {
            let digit = (value % 16) as usize;
            result.insert(0, hex_chars.char_at(digit));
            value = value / 16;
        }
    }

    while result.len() < min_digits {
        result.insert(0, '0');
    }

    result
}

// =============================================================================
// MessagePack Format Constants
// =============================================================================

// Positive fixint: 0x00 - 0x7f
// Fixmap: 0x80 - 0x8f
// Fixarray: 0x90 - 0x9f
// Fixstr: 0xa0 - 0xbf
// Nil: 0xc0
// (unused): 0xc1
// False: 0xc2
// True: 0xc3
// Bin8: 0xc4
// Bin16: 0xc5
// Bin32: 0xc6
// Ext8: 0xc7
// Ext16: 0xc8
// Ext32: 0xc9
// Float32: 0xca
// Float64: 0xcb
// Uint8: 0xcc
// Uint16: 0xcd
// Uint32: 0xce
// Uint64: 0xcf
// Int8: 0xd0
// Int16: 0xd1
// Int32: 0xd2
// Int64: 0xd3
// Fixext1: 0xd4
// Fixext2: 0xd5
// Fixext4: 0xd6
// Fixext8: 0xd7
// Fixext16: 0xd8
// Str8: 0xd9
// Str16: 0xda
// Str32: 0xdb
// Array16: 0xdc
// Array32: 0xdd
// Map16: 0xde
// Map32: 0xdf
// Negative fixint: 0xe0 - 0xff

let MARKER_NIL: u8 = 0xc0;
let MARKER_FALSE: u8 = 0xc2;
let MARKER_TRUE: u8 = 0xc3;
let MARKER_BIN8: u8 = 0xc4;
let MARKER_BIN16: u8 = 0xc5;
let MARKER_BIN32: u8 = 0xc6;
let MARKER_EXT8: u8 = 0xc7;
let MARKER_EXT16: u8 = 0xc8;
let MARKER_EXT32: u8 = 0xc9;
let MARKER_FLOAT32: u8 = 0xca;
let MARKER_FLOAT64: u8 = 0xcb;
let MARKER_UINT8: u8 = 0xcc;
let MARKER_UINT16: u8 = 0xcd;
let MARKER_UINT32: u8 = 0xce;
let MARKER_UINT64: u8 = 0xcf;
let MARKER_INT8: u8 = 0xd0;
let MARKER_INT16: u8 = 0xd1;
let MARKER_INT32: u8 = 0xd2;
let MARKER_INT64: u8 = 0xd3;
let MARKER_FIXEXT1: u8 = 0xd4;
let MARKER_FIXEXT2: u8 = 0xd5;
let MARKER_FIXEXT4: u8 = 0xd6;
let MARKER_FIXEXT8: u8 = 0xd7;
let MARKER_FIXEXT16: u8 = 0xd8;
let MARKER_STR8: u8 = 0xd9;
let MARKER_STR16: u8 = 0xda;
let MARKER_STR32: u8 = 0xdb;
let MARKER_ARRAY16: u8 = 0xdc;
let MARKER_ARRAY32: u8 = 0xdd;
let MARKER_MAP16: u8 = 0xde;
let MARKER_MAP32: u8 = 0xdf;

// =============================================================================
// Decoding
// =============================================================================

struct Decoder {
    data: Vec<u8>,
    pos: usize
}

fn decoder_new(data: &[u8]) -> Decoder with Alloc {
    Decoder {
        data: data.to_vec(),
        pos: 0
    }
}

fn decoder_remaining(d: &Decoder) -> usize {
    if d.pos >= d.data.len() {
        0
    } else {
        d.data.len() - d.pos
    }
}

fn decoder_read_u8(d: &!Decoder) -> Result<u8, MsgPackError> {
    if d.pos >= d.data.len() {
        return Err(MsgPackError::UnexpectedEof)
    }
    let b = d.data[d.pos];
    d.pos = d.pos + 1;
    Ok(b)
}

fn decoder_read_u16(d: &!Decoder) -> Result<u16, MsgPackError> {
    if d.pos + 2 > d.data.len() {
        return Err(MsgPackError::UnexpectedEof)
    }
    let b0 = d.data[d.pos] as u16;
    let b1 = d.data[d.pos + 1] as u16;
    d.pos = d.pos + 2;
    Ok((b0 << 8) | b1)
}

fn decoder_read_u32(d: &!Decoder) -> Result<u32, MsgPackError> {
    if d.pos + 4 > d.data.len() {
        return Err(MsgPackError::UnexpectedEof)
    }
    let b0 = d.data[d.pos] as u32;
    let b1 = d.data[d.pos + 1] as u32;
    let b2 = d.data[d.pos + 2] as u32;
    let b3 = d.data[d.pos + 3] as u32;
    d.pos = d.pos + 4;
    Ok((b0 << 24) | (b1 << 16) | (b2 << 8) | b3)
}

fn decoder_read_u64(d: &!Decoder) -> Result<u64, MsgPackError> {
    let hi = decoder_read_u32(d)? as u64;
    let lo = decoder_read_u32(d)? as u64;
    Ok((hi << 32) | lo)
}

fn decoder_read_i8(d: &!Decoder) -> Result<i8, MsgPackError> {
    decoder_read_u8(d).map(|b| b as i8)
}

fn decoder_read_i16(d: &!Decoder) -> Result<i16, MsgPackError> {
    decoder_read_u16(d).map(|v| v as i16)
}

fn decoder_read_i32(d: &!Decoder) -> Result<i32, MsgPackError> {
    decoder_read_u32(d).map(|v| v as i32)
}

fn decoder_read_i64(d: &!Decoder) -> Result<i64, MsgPackError> {
    decoder_read_u64(d).map(|v| v as i64)
}

fn decoder_read_bytes(d: &!Decoder, len: usize) -> Result<Vec<u8>, MsgPackError> with Alloc {
    if d.pos + len > d.data.len() {
        return Err(MsgPackError::UnexpectedEof)
    }
    let bytes = d.data[d.pos..d.pos + len].to_vec();
    d.pos = d.pos + len;
    Ok(bytes)
}

// Decodes MessagePack bytes into a value.
pub fn msgpack_decode(data: &[u8]) -> Result<MsgPackValue, MsgPackError> with Alloc {
    var d = decoder_new(data);
    decode_value(&!d)
}

fn decode_value(d: &!Decoder) -> Result<MsgPackValue, MsgPackError> with Alloc {
    let marker = decoder_read_u8(d)?;

    // Positive fixint (0x00 - 0x7f)
    if marker <= 0x7f {
        return Ok(MsgPackValue::PosInt(marker as u64))
    }

    // Negative fixint (0xe0 - 0xff)
    if marker >= 0xe0 {
        return Ok(MsgPackValue::NegInt((marker as i8) as i64))
    }

    // Fixmap (0x80 - 0x8f)
    if marker >= 0x80 && marker <= 0x8f {
        let len = (marker & 0x0f) as usize;
        return decode_map(d, len)
    }

    // Fixarray (0x90 - 0x9f)
    if marker >= 0x90 && marker <= 0x9f {
        let len = (marker & 0x0f) as usize;
        return decode_array(d, len)
    }

    // Fixstr (0xa0 - 0xbf)
    if marker >= 0xa0 && marker <= 0xbf {
        let len = (marker & 0x1f) as usize;
        return decode_str(d, len)
    }

    match marker {
        0xc0 => Ok(MsgPackValue::Nil),
        0xc2 => Ok(MsgPackValue::Bool(false)),
        0xc3 => Ok(MsgPackValue::Bool(true)),

        // Binary
        0xc4 => {
            let len = decoder_read_u8(d)? as usize;
            let bytes = decoder_read_bytes(d, len)?;
            Ok(MsgPackValue::Bin(bytes))
        },
        0xc5 => {
            let len = decoder_read_u16(d)? as usize;
            let bytes = decoder_read_bytes(d, len)?;
            Ok(MsgPackValue::Bin(bytes))
        },
        0xc6 => {
            let len = decoder_read_u32(d)? as usize;
            let bytes = decoder_read_bytes(d, len)?;
            Ok(MsgPackValue::Bin(bytes))
        },

        // Ext
        0xc7 => {
            let len = decoder_read_u8(d)? as usize;
            let type_id = decoder_read_i8(d)?;
            let data = decoder_read_bytes(d, len)?;
            Ok(MsgPackValue::Ext { type_id, data })
        },
        0xc8 => {
            let len = decoder_read_u16(d)? as usize;
            let type_id = decoder_read_i8(d)?;
            let data = decoder_read_bytes(d, len)?;
            Ok(MsgPackValue::Ext { type_id, data })
        },
        0xc9 => {
            let len = decoder_read_u32(d)? as usize;
            let type_id = decoder_read_i8(d)?;
            let data = decoder_read_bytes(d, len)?;
            Ok(MsgPackValue::Ext { type_id, data })
        },

        // Float
        0xca => {
            let bits = decoder_read_u32(d)?;
            Ok(MsgPackValue::Float32(f32::from_bits(bits)))
        },
        0xcb => {
            let bits = decoder_read_u64(d)?;
            Ok(MsgPackValue::Float64(f64::from_bits(bits)))
        },

        // Unsigned integers
        0xcc => decoder_read_u8(d).map(|v| MsgPackValue::PosInt(v as u64)),
        0xcd => decoder_read_u16(d).map(|v| MsgPackValue::PosInt(v as u64)),
        0xce => decoder_read_u32(d).map(|v| MsgPackValue::PosInt(v as u64)),
        0xcf => decoder_read_u64(d).map(|v| MsgPackValue::PosInt(v)),

        // Signed integers
        0xd0 => decoder_read_i8(d).map(|v| {
            if v >= 0 { MsgPackValue::PosInt(v as u64) }
            else { MsgPackValue::NegInt(v as i64) }
        }),
        0xd1 => decoder_read_i16(d).map(|v| {
            if v >= 0 { MsgPackValue::PosInt(v as u64) }
            else { MsgPackValue::NegInt(v as i64) }
        }),
        0xd2 => decoder_read_i32(d).map(|v| {
            if v >= 0 { MsgPackValue::PosInt(v as u64) }
            else { MsgPackValue::NegInt(v as i64) }
        }),
        0xd3 => decoder_read_i64(d).map(|v| {
            if v >= 0 { MsgPackValue::PosInt(v as u64) }
            else { MsgPackValue::NegInt(v) }
        }),

        // Fixed ext
        0xd4 => {
            let type_id = decoder_read_i8(d)?;
            let data = decoder_read_bytes(d, 1)?;
            Ok(MsgPackValue::Ext { type_id, data })
        },
        0xd5 => {
            let type_id = decoder_read_i8(d)?;
            let data = decoder_read_bytes(d, 2)?;
            Ok(MsgPackValue::Ext { type_id, data })
        },
        0xd6 => {
            let type_id = decoder_read_i8(d)?;
            let data = decoder_read_bytes(d, 4)?;
            Ok(MsgPackValue::Ext { type_id, data })
        },
        0xd7 => {
            let type_id = decoder_read_i8(d)?;
            let data = decoder_read_bytes(d, 8)?;
            Ok(MsgPackValue::Ext { type_id, data })
        },
        0xd8 => {
            let type_id = decoder_read_i8(d)?;
            let data = decoder_read_bytes(d, 16)?;
            Ok(MsgPackValue::Ext { type_id, data })
        },

        // String
        0xd9 => {
            let len = decoder_read_u8(d)? as usize;
            decode_str(d, len)
        },
        0xda => {
            let len = decoder_read_u16(d)? as usize;
            decode_str(d, len)
        },
        0xdb => {
            let len = decoder_read_u32(d)? as usize;
            decode_str(d, len)
        },

        // Array
        0xdc => {
            let len = decoder_read_u16(d)? as usize;
            decode_array(d, len)
        },
        0xdd => {
            let len = decoder_read_u32(d)? as usize;
            decode_array(d, len)
        },

        // Map
        0xde => {
            let len = decoder_read_u16(d)? as usize;
            decode_map(d, len)
        },
        0xdf => {
            let len = decoder_read_u32(d)? as usize;
            decode_map(d, len)
        },

        _ => Err(MsgPackError::InvalidMarker { marker })
    }
}

fn decode_str(d: &!Decoder, len: usize) -> Result<MsgPackValue, MsgPackError> with Alloc {
    let bytes = decoder_read_bytes(d, len)?;
    match String::from_utf8(bytes) {
        Ok(s) => Ok(MsgPackValue::Str(s)),
        Err(_) => Err(MsgPackError::InvalidUtf8)
    }
}

fn decode_array(d: &!Decoder, len: usize) -> Result<MsgPackValue, MsgPackError> with Alloc {
    var items: Vec<MsgPackValue> = Vec::with_capacity(len);

    var i: usize = 0;
    while i < len {
        items.push(decode_value(d)?);
        i = i + 1;
    }

    Ok(MsgPackValue::Array(items))
}

fn decode_map(d: &!Decoder, len: usize) -> Result<MsgPackValue, MsgPackError> with Alloc {
    var entries: Vec<(MsgPackValue, MsgPackValue)> = Vec::with_capacity(len);

    var i: usize = 0;
    while i < len {
        let key = decode_value(d)?;
        let value = decode_value(d)?;
        entries.push((key, value));
        i = i + 1;
    }

    Ok(MsgPackValue::Map(entries))
}

// =============================================================================
// Encoding
// =============================================================================

// Encodes a MsgPackValue into bytes.
pub fn msgpack_encode(value: &MsgPackValue) -> Vec<u8> with Alloc {
    var buf: Vec<u8> = Vec::new();
    encode_value(&!buf, value);
    buf
}

fn encode_value(buf: &!Vec<u8>, value: &MsgPackValue) with Alloc {
    match value {
        MsgPackValue::Nil => buf.push(MARKER_NIL),

        MsgPackValue::Bool(b) => {
            if *b {
                buf.push(MARKER_TRUE);
            } else {
                buf.push(MARKER_FALSE);
            }
        },

        MsgPackValue::PosInt(n) => encode_pos_int(buf, *n),
        MsgPackValue::NegInt(n) => encode_neg_int(buf, *n),
        MsgPackValue::Float32(f) => encode_float32(buf, *f),
        MsgPackValue::Float64(f) => encode_float64(buf, *f),
        MsgPackValue::Str(s) => encode_str(buf, s),
        MsgPackValue::Bin(b) => encode_bin(buf, b),
        MsgPackValue::Array(items) => encode_array(buf, items),
        MsgPackValue::Map(entries) => encode_map(buf, entries),
        MsgPackValue::Ext { type_id, data } => encode_ext(buf, *type_id, data)
    }
}

fn encode_pos_int(buf: &!Vec<u8>, n: u64) with Alloc {
    if n <= 0x7f {
        // Positive fixint
        buf.push(n as u8);
    } else if n <= 0xff {
        buf.push(MARKER_UINT8);
        buf.push(n as u8);
    } else if n <= 0xffff {
        buf.push(MARKER_UINT16);
        buf.push((n >> 8) as u8);
        buf.push(n as u8);
    } else if n <= 0xffffffff {
        buf.push(MARKER_UINT32);
        buf.push((n >> 24) as u8);
        buf.push((n >> 16) as u8);
        buf.push((n >> 8) as u8);
        buf.push(n as u8);
    } else {
        buf.push(MARKER_UINT64);
        buf.push((n >> 56) as u8);
        buf.push((n >> 48) as u8);
        buf.push((n >> 40) as u8);
        buf.push((n >> 32) as u8);
        buf.push((n >> 24) as u8);
        buf.push((n >> 16) as u8);
        buf.push((n >> 8) as u8);
        buf.push(n as u8);
    }
}

fn encode_neg_int(buf: &!Vec<u8>, n: i64) with Alloc {
    if n >= -32 {
        // Negative fixint
        buf.push((n as i8) as u8);
    } else if n >= -128 {
        buf.push(MARKER_INT8);
        buf.push(n as u8);
    } else if n >= -32768 {
        buf.push(MARKER_INT16);
        let v = n as i16;
        buf.push((v >> 8) as u8);
        buf.push(v as u8);
    } else if n >= -2147483648 {
        buf.push(MARKER_INT32);
        let v = n as i32;
        buf.push((v >> 24) as u8);
        buf.push((v >> 16) as u8);
        buf.push((v >> 8) as u8);
        buf.push(v as u8);
    } else {
        buf.push(MARKER_INT64);
        buf.push((n >> 56) as u8);
        buf.push((n >> 48) as u8);
        buf.push((n >> 40) as u8);
        buf.push((n >> 32) as u8);
        buf.push((n >> 24) as u8);
        buf.push((n >> 16) as u8);
        buf.push((n >> 8) as u8);
        buf.push(n as u8);
    }
}

fn encode_float32(buf: &!Vec<u8>, f: f32) with Alloc {
    buf.push(MARKER_FLOAT32);
    let bits = f.to_bits();
    buf.push((bits >> 24) as u8);
    buf.push((bits >> 16) as u8);
    buf.push((bits >> 8) as u8);
    buf.push(bits as u8);
}

fn encode_float64(buf: &!Vec<u8>, f: f64) with Alloc {
    buf.push(MARKER_FLOAT64);
    let bits = f.to_bits();
    buf.push((bits >> 56) as u8);
    buf.push((bits >> 48) as u8);
    buf.push((bits >> 40) as u8);
    buf.push((bits >> 32) as u8);
    buf.push((bits >> 24) as u8);
    buf.push((bits >> 16) as u8);
    buf.push((bits >> 8) as u8);
    buf.push(bits as u8);
}

fn encode_str(buf: &!Vec<u8>, s: &str) with Alloc {
    let len = s.len();

    if len <= 31 {
        // Fixstr
        buf.push(0xa0 | (len as u8));
    } else if len <= 0xff {
        buf.push(MARKER_STR8);
        buf.push(len as u8);
    } else if len <= 0xffff {
        buf.push(MARKER_STR16);
        buf.push((len >> 8) as u8);
        buf.push(len as u8);
    } else {
        buf.push(MARKER_STR32);
        buf.push((len >> 24) as u8);
        buf.push((len >> 16) as u8);
        buf.push((len >> 8) as u8);
        buf.push(len as u8);
    }

    for b in s.as_bytes() {
        buf.push(*b);
    }
}

fn encode_bin(buf: &!Vec<u8>, data: &[u8]) with Alloc {
    let len = data.len();

    if len <= 0xff {
        buf.push(MARKER_BIN8);
        buf.push(len as u8);
    } else if len <= 0xffff {
        buf.push(MARKER_BIN16);
        buf.push((len >> 8) as u8);
        buf.push(len as u8);
    } else {
        buf.push(MARKER_BIN32);
        buf.push((len >> 24) as u8);
        buf.push((len >> 16) as u8);
        buf.push((len >> 8) as u8);
        buf.push(len as u8);
    }

    for b in data {
        buf.push(*b);
    }
}

fn encode_array(buf: &!Vec<u8>, items: &[MsgPackValue]) with Alloc {
    let len = items.len();

    if len <= 15 {
        // Fixarray
        buf.push(0x90 | (len as u8));
    } else if len <= 0xffff {
        buf.push(MARKER_ARRAY16);
        buf.push((len >> 8) as u8);
        buf.push(len as u8);
    } else {
        buf.push(MARKER_ARRAY32);
        buf.push((len >> 24) as u8);
        buf.push((len >> 16) as u8);
        buf.push((len >> 8) as u8);
        buf.push(len as u8);
    }

    for item in items {
        encode_value(buf, item);
    }
}

fn encode_map(buf: &!Vec<u8>, entries: &[(MsgPackValue, MsgPackValue)]) with Alloc {
    let len = entries.len();

    if len <= 15 {
        // Fixmap
        buf.push(0x80 | (len as u8));
    } else if len <= 0xffff {
        buf.push(MARKER_MAP16);
        buf.push((len >> 8) as u8);
        buf.push(len as u8);
    } else {
        buf.push(MARKER_MAP32);
        buf.push((len >> 24) as u8);
        buf.push((len >> 16) as u8);
        buf.push((len >> 8) as u8);
        buf.push(len as u8);
    }

    for entry in entries {
        encode_value(buf, &entry.0);
        encode_value(buf, &entry.1);
    }
}

fn encode_ext(buf: &!Vec<u8>, type_id: i8, data: &[u8]) with Alloc {
    let len = data.len();

    match len {
        1 => {
            buf.push(MARKER_FIXEXT1);
            buf.push(type_id as u8);
        },
        2 => {
            buf.push(MARKER_FIXEXT2);
            buf.push(type_id as u8);
        },
        4 => {
            buf.push(MARKER_FIXEXT4);
            buf.push(type_id as u8);
        },
        8 => {
            buf.push(MARKER_FIXEXT8);
            buf.push(type_id as u8);
        },
        16 => {
            buf.push(MARKER_FIXEXT16);
            buf.push(type_id as u8);
        },
        _ => {
            if len <= 0xff {
                buf.push(MARKER_EXT8);
                buf.push(len as u8);
            } else if len <= 0xffff {
                buf.push(MARKER_EXT16);
                buf.push((len >> 8) as u8);
                buf.push(len as u8);
            } else {
                buf.push(MARKER_EXT32);
                buf.push((len >> 24) as u8);
                buf.push((len >> 16) as u8);
                buf.push((len >> 8) as u8);
                buf.push(len as u8);
            }
            buf.push(type_id as u8);
        }
    }

    for b in data {
        buf.push(*b);
    }
}

// =============================================================================
// Value Access Functions
// =============================================================================

// Returns true if the value is nil
pub fn msgpack_is_nil(value: &MsgPackValue) -> bool {
    match value {
        MsgPackValue::Nil => true,
        _ => false
    }
}

// Returns the boolean value if it is a Bool
pub fn msgpack_as_bool(value: &MsgPackValue) -> Option<bool> {
    match value {
        MsgPackValue::Bool(b) => Some(*b),
        _ => None
    }
}

// Returns the integer value (converts both positive and negative)
pub fn msgpack_as_i64(value: &MsgPackValue) -> Option<i64> {
    match value {
        MsgPackValue::PosInt(n) => Some(*n as i64),
        MsgPackValue::NegInt(n) => Some(*n),
        _ => None
    }
}

// Returns the unsigned integer value if it is a positive integer
pub fn msgpack_as_u64(value: &MsgPackValue) -> Option<u64> {
    match value {
        MsgPackValue::PosInt(n) => Some(*n),
        _ => None
    }
}

// Returns the float value
pub fn msgpack_as_f64(value: &MsgPackValue) -> Option<f64> {
    match value {
        MsgPackValue::Float64(f) => Some(*f),
        MsgPackValue::Float32(f) => Some(*f as f64),
        MsgPackValue::PosInt(n) => Some(*n as f64),
        MsgPackValue::NegInt(n) => Some(*n as f64),
        _ => None
    }
}

// Returns the string value if it is a Str
pub fn msgpack_as_str(value: &MsgPackValue) -> Option<&str> {
    match value {
        MsgPackValue::Str(s) => Some(s),
        _ => None
    }
}

// Returns the binary data if it is a Bin
pub fn msgpack_as_bin(value: &MsgPackValue) -> Option<&[u8]> {
    match value {
        MsgPackValue::Bin(b) => Some(b),
        _ => None
    }
}

// Returns the array if it is an Array
pub fn msgpack_as_array(value: &MsgPackValue) -> Option<&Vec<MsgPackValue>> {
    match value {
        MsgPackValue::Array(a) => Some(a),
        _ => None
    }
}

// Returns the map if it is a Map
pub fn msgpack_as_map(value: &MsgPackValue) -> Option<&Vec<(MsgPackValue, MsgPackValue)>> {
    match value {
        MsgPackValue::Map(m) => Some(m),
        _ => None
    }
}

// Gets a value from a map by string key
pub fn msgpack_get(value: &MsgPackValue, key: &str) -> Option<&MsgPackValue> {
    match value {
        MsgPackValue::Map(entries) => {
            for entry in entries {
                match &entry.0 {
                    MsgPackValue::Str(k) if k == key => return Some(&entry.1),
                    _ => continue
                }
            }
            None
        },
        _ => None
    }
}

// Gets a value from an array by index
pub fn msgpack_at(value: &MsgPackValue, index: usize) -> Option<&MsgPackValue> {
    match value {
        MsgPackValue::Array(items) => {
            if index < items.len() {
                Some(&items[index])
            } else {
                None
            }
        },
        _ => None
    }
}

// Returns the length of an array or map
pub fn msgpack_len(value: &MsgPackValue) -> usize {
    match value {
        MsgPackValue::Array(a) => a.len(),
        MsgPackValue::Map(m) => m.len(),
        MsgPackValue::Str(s) => s.len(),
        MsgPackValue::Bin(b) => b.len(),
        _ => 0
    }
}

// =============================================================================
// Convenience Constructors
// =============================================================================

// Creates a nil value
pub fn msgpack_nil() -> MsgPackValue {
    MsgPackValue::Nil
}

// Creates a boolean value
pub fn msgpack_bool(b: bool) -> MsgPackValue {
    MsgPackValue::Bool(b)
}

// Creates an integer value
pub fn msgpack_int(n: i64) -> MsgPackValue {
    if n >= 0 {
        MsgPackValue::PosInt(n as u64)
    } else {
        MsgPackValue::NegInt(n)
    }
}

// Creates a float value
pub fn msgpack_float(f: f64) -> MsgPackValue {
    MsgPackValue::Float64(f)
}

// Creates a string value
pub fn msgpack_str(s: &str) -> MsgPackValue with Alloc {
    MsgPackValue::Str(s.to_string())
}

// Creates a binary value
pub fn msgpack_bin(data: &[u8]) -> MsgPackValue with Alloc {
    MsgPackValue::Bin(data.to_vec())
}

// Creates an array value
pub fn msgpack_array(items: Vec<MsgPackValue>) -> MsgPackValue {
    MsgPackValue::Array(items)
}

// Creates a map value
pub fn msgpack_map(entries: Vec<(MsgPackValue, MsgPackValue)>) -> MsgPackValue {
    MsgPackValue::Map(entries)
}
