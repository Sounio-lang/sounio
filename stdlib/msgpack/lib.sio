// stdlib/msgpack/lib.sio — MessagePack binary serialization
//
// Simple encoder/decoder for numeric types following the MessagePack spec.
// Reference: https://github.com/msgpack/msgpack/blob/master/spec.md
//
// Format codes used:
//   0xc0 (192) — nil
//   0xc2 (194) — false
//   0xc3 (195) — true
//   0xcb (203) — float 64 (8 bytes big-endian IEEE 754)
//   0xd3 (211) — int 64 (8 bytes big-endian two's complement)
//   0xa0-0xbf  — fixstr (low 5 bits = length)
//   0x00-0x7f  — positive fixint
//   0xe0-0xff  — negative fixint

pub struct MsgPackBuf {
    pub data: [u8; 1024],
    pub len: i32,
}

// ============================================================================
// CONSTRUCTOR
// ============================================================================

pub fn msgpack_new() -> MsgPackBuf {
    MsgPackBuf { data: [0; 1024], len: 0 }
}

// ============================================================================
// HELPERS
// ============================================================================

// Append a single byte to the buffer (no-op if full)
fn mp_push(buf: MsgPackBuf, b: u8) -> MsgPackBuf with Panic, Mut {
    var out = buf
    if out.len < 1024 {
        out.data[out.len] = b
        out.len = out.len + 1
    }
    out
}

// Read a single byte at position pos (returns 0 if out of range)
fn mp_byte(buf: &MsgPackBuf, pos: i32) -> u8 with Panic {
    if pos < 0 || pos >= buf.len { return 0 }
    buf.data[pos]
}

// ============================================================================
// PACK
// ============================================================================

pub fn msgpack_pack_nil(buf: MsgPackBuf) -> MsgPackBuf with Panic, Mut {
    mp_push(buf, 192)
}

pub fn msgpack_pack_bool(buf: MsgPackBuf, val: i32) -> MsgPackBuf with Panic, Mut {
    if val == 0 {
        mp_push(buf, 194)
    } else {
        mp_push(buf, 195)
    }
}

// Pack i64: use positive fixint (0-127), negative fixint (-32..-1),
// or int64 format 0xd3 + 8 bytes big-endian for everything else.
pub fn msgpack_pack_i64(buf: MsgPackBuf, val: i64) -> MsgPackBuf with Panic, Div, Mut {
    // Positive fixint
    if val >= 0 && val <= 127 {
        return mp_push(buf, (val as i32) as u8)
    }
    // Negative fixint: -32 to -1 — encoded as 0xe0|(val+32) = 224..255
    if val >= 0 - 32 && val < 0 {
        let code = 224 + ((val + 32) as i32)
        return mp_push(buf, code as u8)
    }
    // int64: 0xd3 + 8 bytes big-endian two's complement
    var out = mp_push(buf, 211)
    // Extract 8 bytes big-endian from val (two's complement via unsigned shift)
    // We compute each byte by shifting right successively.
    // For negative numbers we add 2^64 conceptually; since we work in i64
    // we use modular arithmetic: byte = (val >> (shift)) & 0xff
    // Sounio uses arithmetic right shift; mask with 255 to get byte.
    let b7 = ((val / 72057594037927936) % 256) as i32
    let rem6 = val % 72057594037927936
    let b6 = ((rem6 / 281474976710656) % 256) as i32
    let rem5 = rem6 % 281474976710656
    let b5 = ((rem5 / 1099511627776) % 256) as i32
    let rem4 = rem5 % 1099511627776
    let b4 = ((rem4 / 4294967296) % 256) as i32
    let rem3 = rem4 % 4294967296
    let b3 = ((rem3 / 16777216) % 256) as i32
    let rem2 = rem3 % 16777216
    let b2 = ((rem2 / 65536) % 256) as i32
    let rem1 = rem2 % 65536
    let b1 = ((rem1 / 256) % 256) as i32
    let b0 = (rem1 % 256) as i32
    // For negative values, bytes need to represent two's complement.
    // The modular arithmetic above gives correct unsigned bytes for non-negative.
    // For negative: we need to add 256 to make negative byte values positive.
    var B7 = b7
    var B6 = b6
    var B5 = b5
    var B4 = b4
    var B3 = b3
    var B2 = b2
    var B1 = b1
    var B0 = b0
    if B7 < 0 { B7 = B7 + 256 }
    if B6 < 0 { B6 = B6 + 256 }
    if B5 < 0 { B5 = B5 + 256 }
    if B4 < 0 { B4 = B4 + 256 }
    if B3 < 0 { B3 = B3 + 256 }
    if B2 < 0 { B2 = B2 + 256 }
    if B1 < 0 { B1 = B1 + 256 }
    if B0 < 0 { B0 = B0 + 256 }
    out = mp_push(out, B7 as u8)
    out = mp_push(out, B6 as u8)
    out = mp_push(out, B5 as u8)
    out = mp_push(out, B4 as u8)
    out = mp_push(out, B3 as u8)
    out = mp_push(out, B2 as u8)
    out = mp_push(out, B1 as u8)
    out = mp_push(out, B0 as u8)
    out
}

// Pack f64 as 0xcb + 8 bytes big-endian IEEE 754.
// We use an integer-based encoding: decompose val into sign, exponent, mantissa.
// IEEE 754 double: 1 sign bit, 11 exponent bits (bias 1023), 52 mantissa bits.
pub fn msgpack_pack_f64(buf: MsgPackBuf, val: f64) -> MsgPackBuf with Panic, Div, Mut {
    var out = mp_push(buf, 203)

    // Handle special cases first
    if val == 0.0 {
        out = mp_push(out, 0)
        out = mp_push(out, 0)
        out = mp_push(out, 0)
        out = mp_push(out, 0)
        out = mp_push(out, 0)
        out = mp_push(out, 0)
        out = mp_push(out, 0)
        out = mp_push(out, 0)
        return out
    }

    // Determine sign
    var sign: i32 = 0
    var absval = val
    if val < 0.0 {
        sign = 1
        absval = 0.0 - val
    }

    // Compute exponent: find e such that 2^e <= absval < 2^(e+1)
    // Use iterative approach
    var e: i32 = 0
    var mant = absval
    if mant >= 2.0 {
        while mant >= 2.0 {
            mant = mant / 2.0
            e = e + 1
        }
    } else {
        while mant < 1.0 {
            mant = mant * 2.0
            e = e - 1
        }
    }
    // Now mant in [1.0, 2.0), e is the biased-free exponent
    // Fractional mantissa (remove implicit leading 1)
    mant = mant - 1.0

    // Biased exponent for IEEE 754 double (bias = 1023)
    let biased_exp: i32 = e + 1023

    // Extract 52 mantissa bits as integer by multiplying up
    // mant in [0, 1) — multiply by 2^52 = 4503599627370496
    let scale: f64 = 4503599627370496.0
    var mant_int: i64 = (mant * scale) as i64

    // Build the 8-byte IEEE 754 representation:
    // byte 0 (MSB): sign(1) | exp[10:3](8 bits)
    // byte 1: exp[2:0](3 bits) | mant[51:45](5 bits)
    // bytes 2-7: mant[44:0] split across 6 bytes
    let exp_hi8: i32 = (biased_exp / 8) % 256      // bits 10..3
    let exp_lo3: i32 = biased_exp % 8               // bits 2..0
    let byte0: i32 = sign * 128 + exp_hi8
    // mant_int holds 52 bits; extract top 5 bits for byte1 upper part
    // mant bits 51..45: shift right 45 = divide by 2^45 = 35184372088832
    let div45: i64 = 35184372088832
    let mant_top5: i32 = (mant_int / div45) as i32
    let byte1: i32 = exp_lo3 * 32 + (mant_top5 % 32)

    // Remaining 45 bits: mant_int % 2^45
    var rem45 = mant_int % div45
    // Split into 5 bytes of 9 bits each — but bytes are 8 bits.
    // Bytes 2..7 cover mant bits 44..0 = 45 bits total across 6 bytes
    // byte2: mant[44:37] = bits 44..37 (8 bits)
    let div37: i64 = 137438953472
    let byte2: i32 = (rem45 / div37) as i32
    var rem37 = rem45 % div37
    // byte3: mant[36:29]
    let div29: i64 = 536870912
    let byte3: i32 = (rem37 / div29) as i32
    var rem29 = rem37 % div29
    // byte4: mant[28:21]
    let div21: i64 = 2097152
    let byte4: i32 = (rem29 / div21) as i32
    var rem21 = rem29 % div21
    // byte5: mant[20:13]
    let div13: i64 = 8192
    let byte5: i32 = (rem21 / div13) as i32
    var rem13 = rem21 % div13
    // byte6: mant[12:5]
    let div5: i64 = 32
    let byte6: i32 = (rem13 / div5) as i32
    // byte7: mant[4:0] — 5 bits, but we need 8 bits so shift left 3
    let byte7: i32 = ((rem13 % div5) as i32) * 8

    out = mp_push(out, byte0 as u8)
    out = mp_push(out, byte1 as u8)
    out = mp_push(out, byte2 as u8)
    out = mp_push(out, byte3 as u8)
    out = mp_push(out, byte4 as u8)
    out = mp_push(out, byte5 as u8)
    out = mp_push(out, byte6 as u8)
    out = mp_push(out, byte7 as u8)
    out
}

// Pack a fixed string: fixstr format 0xa0|len + raw bytes (len <= 31)
pub fn msgpack_pack_fixstr(buf: MsgPackBuf, s: &[u8; 128], len: i32) -> MsgPackBuf with Panic, Div, Mut {
    var slen = len
    if slen < 0 { slen = 0 }
    if slen > 31 { slen = 31 }
    var out = mp_push(buf, (160 + slen) as u8)
    var i: i32 = 0
    while i < slen {
        out = mp_push(out, s[i])
        i = i + 1
    }
    out
}

// ============================================================================
// UNPACK — type detection
// ============================================================================

// Returns type code at position:
//   0 = nil, 1 = bool, 2 = int, 3 = float, 4 = str
pub fn msgpack_unpack_type(buf: &MsgPackBuf, pos: i32) -> i32 with Panic {
    if pos < 0 || pos >= buf.len { return -1 }
    let b = buf.data[pos] as i32
    // nil
    if b == 192 { return 0 }
    // bool
    if b == 194 || b == 195 { return 1 }
    // float64
    if b == 203 { return 3 }
    // int64
    if b == 211 { return 2 }
    // positive fixint 0x00..0x7f
    if b >= 0 && b <= 127 { return 2 }
    // negative fixint 0xe0..0xff
    if b >= 224 { return 2 }
    // fixstr 0xa0..0xbf
    if b >= 160 && b <= 191 { return 4 }
    // unknown
    return -1
}

// ============================================================================
// UNPACK i64
// Returns the decoded value via out param; returns new position.
// ============================================================================

pub fn msgpack_unpack_i64(buf: &MsgPackBuf, pos: i32) -> i64 with Panic, Div {
    if pos < 0 || pos >= buf.len { return 0 }
    let b = buf.data[pos] as i32
    // positive fixint
    if b >= 0 && b <= 127 { return b as i64 }
    // negative fixint (0xe0..0xff = 224..255), value = b - 256
    if b >= 224 { return (b - 256) as i64 }
    // int64 0xd3: next 8 bytes
    if b == 211 {
        if pos + 8 >= buf.len { return 0 }
        let b7 = buf.data[pos + 1] as i64
        let b6 = buf.data[pos + 2] as i64
        let b5 = buf.data[pos + 3] as i64
        let b4 = buf.data[pos + 4] as i64
        let b3 = buf.data[pos + 5] as i64
        let b2 = buf.data[pos + 6] as i64
        let b1 = buf.data[pos + 7] as i64
        let b0 = buf.data[pos + 8] as i64
        // Reconstruct: big-endian unsigned value
        let unsigned_val = b7 * 72057594037927936
                         + b6 * 281474976710656
                         + b5 * 1099511627776
                         + b4 * 4294967296
                         + b3 * 16777216
                         + b2 * 65536
                         + b1 * 256
                         + b0
        // If high bit set (b7 >= 128), it was negative: subtract 2^63
        if b7 >= 128 {
            // 2^63 = 9223372036854775808 — subtract to get signed value
            return unsigned_val - 9223372036854775807 - 1
        }
        return unsigned_val
    }
    0
}

// Returns new position after consuming i64 value at pos
pub fn msgpack_unpack_i64_advance(buf: &MsgPackBuf, pos: i32) -> i32 with Panic {
    if pos < 0 || pos >= buf.len { return pos + 1 }
    let b = buf.data[pos] as i32
    if b >= 0 && b <= 127 { return pos + 1 }
    if b >= 224 { return pos + 1 }
    if b == 211 { return pos + 9 }
    return pos + 1
}

// ============================================================================
// UNPACK f64
// ============================================================================

pub fn msgpack_unpack_f64(buf: &MsgPackBuf, pos: i32) -> f64 with Panic, Div, Mut {
    if pos < 0 || pos + 8 >= buf.len { return 0.0 }
    let b = buf.data[pos] as i32
    if b != 203 { return 0.0 }
    // Read 8 bytes big-endian
    let byte0 = buf.data[pos + 1] as i32
    let byte1 = buf.data[pos + 2] as i32
    let byte2 = buf.data[pos + 3] as i32
    let byte3 = buf.data[pos + 4] as i32
    let byte4 = buf.data[pos + 5] as i32
    let byte5 = buf.data[pos + 6] as i32
    let byte6 = buf.data[pos + 7] as i32
    let byte7 = buf.data[pos + 8] as i32

    // Check for zero
    if byte0 == 0 && byte1 == 0 && byte2 == 0 && byte3 == 0
    && byte4 == 0 && byte5 == 0 && byte6 == 0 && byte7 == 0 {
        return 0.0
    }

    // Extract sign
    let sign: i32 = byte0 / 128
    // Extract biased exponent: bits 62..52 = byte0[6:0] * 16 + byte1[7:4]
    let exp_hi: i32 = byte0 % 128
    let exp_lo: i32 = byte1 / 32
    let biased_exp: i32 = exp_hi * 8 + exp_lo

    // Extract mantissa bits 51..0 from remaining bytes
    // byte1[4:0] = mant bits 51..47, byte2..byte7 = mant bits 46..0
    let mant_b1: i64 = (byte1 % 32) as i64  // 5 bits
    let mant_b2: i64 = byte2 as i64           // 8 bits
    let mant_b3: i64 = byte3 as i64
    let mant_b4: i64 = byte4 as i64
    let mant_b5: i64 = byte5 as i64
    let mant_b6: i64 = byte6 as i64
    let mant_b7_raw: i64 = byte7 as i64
    // byte7 encodes mant[4:0] in the upper 5 bits (bits 7..3), lower 3 bits = 0
    let mant_b7: i64 = mant_b7_raw / 8

    // Reconstruct mantissa integer (52 bits)
    let mant_int: i64 = mant_b1 * 35184372088832   // << 45
                      + mant_b2 * 137438953472      // << 37
                      + mant_b3 * 536870912          // << 29
                      + mant_b4 * 2097152            // << 21
                      + mant_b5 * 8192               // << 13
                      + mant_b6 * 32                 // << 5
                      + mant_b7

    // Reconstruct float: val = (1 + mant_int/2^52) * 2^(biased_exp - 1023)
    let scale: f64 = 4503599627370496.0  // 2^52
    let mant_f: f64 = 1.0 + (mant_int as f64) / scale

    // Apply exponent: multiply or divide by 2 repeatedly
    let exp_real: i32 = biased_exp - 1023
    var result = mant_f
    if exp_real >= 0 {
        var k: i32 = 0
        while k < exp_real {
            result = result * 2.0
            k = k + 1
        }
    } else {
        var k: i32 = 0
        var ne = 0 - exp_real
        while k < ne {
            result = result / 2.0
            k = k + 1
        }
    }
    if sign == 1 { result = 0.0 - result }
    result
}

// Returns new position after f64
pub fn msgpack_unpack_f64_advance(buf: &MsgPackBuf, pos: i32) -> i32 with Panic {
    pos + 9
}

// ============================================================================
// UNPACK bool
// ============================================================================

pub fn msgpack_unpack_bool(buf: &MsgPackBuf, pos: i32) -> i32 with Panic {
    if pos < 0 || pos >= buf.len { return 0 }
    let b = buf.data[pos] as i32
    if b == 195 { return 1 }
    return 0
}

// Returns new position after bool
pub fn msgpack_unpack_bool_advance(buf: &MsgPackBuf, pos: i32) -> i32 with Panic {
    pos + 1
}
