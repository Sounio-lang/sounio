// stdlib/csv/row — Lightweight single-row CSV parser
//
// Parses one line of comma-separated f64 values into a fixed-size row.
// For full CSV table parsing, see csv/parser.sio.

struct CsvRow {
    fields: [f64; 32],
    field_count: i32
}

fn csv_row_new() -> CsvRow {
    CsvRow { fields: [0.0; 32], field_count: 0 }
}

// Count commas + 1 to get field count (0 for empty line)
fn csv_parse_field_count(line: &[u8; 256], line_len: i32) -> i32 with Mut, Panic, Div {
    if line_len <= 0 { return 0 }
    var count: i32 = 1
    var i: i32 = 0
    while i < line_len {
        if line[i] == 44 { count = count + 1 }
        i = i + 1
    }
    count
}

// Parse a simple decimal f64 from bytes[start..end)
fn csv_parse_f64(line: &[u8; 256], start: i32, end: i32) -> f64 with Mut, Div, Panic {
    var i = start
    while i < end && (line[i] == 32 || line[i] == 9) {
        i = i + 1
    }
    if i >= end { return 0.0 }

    var negative = false
    if line[i] == 45 {
        negative = true
        i = i + 1
    } else if line[i] == 43 {
        i = i + 1
    }

    var int_part: f64 = 0.0
    while i < end && line[i] >= 48 && line[i] <= 57 {
        int_part = int_part * 10.0 + (line[i] - 48) as f64
        i = i + 1
    }

    var frac_part: f64 = 0.0
    if i < end && line[i] == 46 {
        i = i + 1
        var divisor: f64 = 10.0
        while i < end && line[i] >= 48 && line[i] <= 57 {
            frac_part = frac_part + (line[i] - 48) as f64 / divisor
            divisor = divisor * 10.0
            i = i + 1
        }
    }

    var result = int_part + frac_part
    if negative { result = 0.0 - result }
    result
}

// Parse a line of comma-separated f64 values
fn csv_parse_row(line: &[u8; 256], line_len: i32) -> CsvRow with Mut, Div, Panic {
    var row = csv_row_new()
    if line_len <= 0 { return row }

    var field_start: i32 = 0
    var i: i32 = 0
    while i <= line_len && row.field_count < 32 {
        if i == line_len || line[i] == 44 {
            let val = csv_parse_f64(line, field_start, i)
            row.fields[row.field_count] = val
            row.field_count = row.field_count + 1
            field_start = i + 1
        }
        i = i + 1
    }
    row
}

fn csv_row_get(row: CsvRow, idx: i32) -> f64 with Panic, Div {
    if idx < 0 || idx >= row.field_count { return 0.0 }
    row.fields[idx]
}

// =============================================================================
// Tests
// =============================================================================

fn test_parse_simple() -> bool with Mut, Div, Panic {
    var line: [u8; 256] = [0; 256]
    // "1.5,2.0,3.5"
    line[0] = 49
    line[1] = 46
    line[2] = 53
    line[3] = 44
    line[4] = 50
    line[5] = 46
    line[6] = 48
    line[7] = 44
    line[8] = 51
    line[9] = 46
    line[10] = 53

    let row = csv_parse_row(&line, 11)
    row.field_count == 3 && row.fields[0] == 1.5 && row.fields[1] == 2.0 && row.fields[2] == 3.5
}

fn test_field_count() -> bool with Mut, Panic, Div {
    var line: [u8; 256] = [0; 256]
    // "10,20,30,40"
    line[0] = 49
    line[1] = 48
    line[2] = 44
    line[3] = 50
    line[4] = 48
    line[5] = 44
    line[6] = 51
    line[7] = 48
    line[8] = 44
    line[9] = 52
    line[10] = 48
    csv_parse_field_count(&line, 11) == 4
}

fn main() with IO, Mut, Div, Panic {
    if test_parse_simple() { print("csv parse_simple: PASS\n") } else { print("csv parse_simple: FAIL\n") }
    if test_field_count() { print("csv field_count: PASS\n") } else { print("csv field_count: FAIL\n") }
}
