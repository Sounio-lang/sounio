// csv — CSV parsing and serialization
//
// Numeric CSV (f64 values) backed by fixed-size arrays (256 rows x 16 cols).
// No heap allocation. Includes column-level statistics.
//
// Submodules:
//   parser — Full table parse/serialize with column stats
//   row    — Lightweight single-row CSV parser

pub use parser::{
    CsvBuf, CsvTable,
    csv_buf_new, csv_table_new,
    csv_table_set, csv_table_get, csv_table_add_row,
    csv_parse, csv_parse_buf,
    csv_serialize, csv_serialize_buf,
    csv_col_sum, csv_col_mean, csv_col_variance,
    csv_col_min, csv_col_max,
}
