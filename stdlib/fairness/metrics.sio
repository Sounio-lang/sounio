// stdlib/fairness/metrics.sio — ML Fairness Metrics and Impossibility Theorem
//
// Canonical implementations of the four most widely used group fairness criteria,
// plus the Chouldechova (2017) impossibility theorem and Lipschitz individual fairness.
//
// REFERENCES:
//   Dwork et al. (2012) "Fairness Through Awareness" — demographic parity, individual fairness
//   Hardt et al. (2016) "Equality of Opportunity in Supervised Learning" — equalized odds
//   Chouldechova (2017) "Fair Prediction with Disparate Impact" — impossibility theorem
//   Kusner et al. (2017) "Counterfactual Fairness" — causal counterfactual criterion
//   Barocas, Hardt & Narayanan (2023) "Fairness and Machine Learning" — textbook survey
//   Menon & Williamson (2018) "The cost of fairness in binary classification"
//
// Sounio Sprint 22 Track F — first type system with fairness as a type-level constraint.
// Paper: FAccT 2027 + POPL 2027 short paper "From Privacy to Fairness: Unified Responsible AI Types"

// ============================================================
// Fairness criterion codes (matches TyFairPrediction.array_size)
// ============================================================

let FAIRNESS_DP: i64 = 0   // demographic parity
let FAIRNESS_EO: i64 = 1   // equalized odds
let FAIRNESS_IF: i64 = 2   // individual fairness (Lipschitz)
let FAIRNESS_CWG: i64 = 3  // calibration within group
let FAIRNESS_CF: i64 = 4   // counterfactual fairness

// ============================================================
// Group fairness metrics
// ============================================================

// --- Demographic Parity ---

// dp_gap: |P(Ŷ=1|A=0) - P(Ŷ=1|A=1)|
// Perfect demographic parity: dp_gap = 0.
// EU AI Act threshold (high-risk systems): dp_gap ≤ 0.05 recommended.
fn dp_gap(rate_a0: f64, rate_a1: f64) -> f64 with IO {
    let d = rate_a1 + (0.0 - rate_a0)
    if d < 0.0 { 0.0 - d } else { d }
}

// dp_ratio: min(rate)/max(rate) — the "80% rule" (EEOC 1978, EU AI Act 2024)
// Violation when dp_ratio < 0.8 (minority gets < 80% of majority's approval rate).
fn dp_ratio(rate_a0: f64, rate_a1: f64) -> f64 with IO, Div, Panic {
    let lo = if rate_a0 < rate_a1 { rate_a0 } else { rate_a1 }
    let hi = if rate_a0 > rate_a1 { rate_a0 } else { rate_a1 }
    lo / hi
}

// dp_satisfied: true if gap ≤ epsilon
fn dp_satisfied(rate_a0: f64, rate_a1: f64, epsilon: f64) -> bool with IO {
    dp_gap(rate_a0, rate_a1) <= epsilon
}

// --- Equalized Odds ---

// eo_gap: max(|ΔTPR|, |ΔFPR|)
// Both true and false positive rates must be equal across groups.
fn eo_gap(tpr0: f64, tpr1: f64, fpr0: f64, fpr1: f64) -> f64 with IO {
    let dt = tpr1 + (0.0 - tpr0)
    let df = fpr1 + (0.0 - fpr0)
    let at = if dt < 0.0 { 0.0 - dt } else { dt }
    let af = if df < 0.0 { 0.0 - df } else { df }
    if at > af { at } else { af }
}

// eop_gap: |ΔTPR| — equal opportunity (Hardt et al. 2016)
// Weaker than equalized odds: only TPR must be equal.
fn eop_gap(tpr0: f64, tpr1: f64) -> f64 with IO {
    let d = tpr1 + (0.0 - tpr0)
    if d < 0.0 { 0.0 - d } else { d }
}

// eo_satisfied: true if max(|ΔTPR|, |ΔFPR|) ≤ epsilon
fn eo_satisfied(tpr0: f64, tpr1: f64, fpr0: f64, fpr1: f64, epsilon: f64) -> bool with IO {
    eo_gap(tpr0, tpr1, fpr0, fpr1) <= epsilon
}

// --- Calibration within group ---

// cwg_gap: |P(Y=1|Ŷ≈p, A=0) - P(Y=1|Ŷ≈p, A=1)|
// At each predicted probability p, actual outcomes should not differ by group.
fn cwg_gap(actual0: f64, actual1: f64) -> f64 with IO {
    let d = actual1 + (0.0 - actual0)
    if d < 0.0 { 0.0 - d } else { d }
}

// positive_predictive_value: P(Y=1|Ŷ=1) = TP / (TP + FP)
// Required for Chouldechova impossibility calculation.
fn ppv(true_positive_rate: f64, prevalence: f64, false_positive_rate: f64) -> f64 with IO, Div, Panic {
    // Bayes theorem: PPV = TPR * P / (TPR * P + FPR * (1-P))
    let num = true_positive_rate * prevalence
    let denom = num + false_positive_rate * (1.0 + (0.0 - prevalence))
    num / denom
}

// ============================================================
// Chouldechova impossibility theorem (2017)
// ============================================================

// chouldechova_check: computes the necessary gap between PPV values when base rates differ.
// When P(Y=1|A=0) ≠ P(Y=1|A=1), the following cannot all hold simultaneously:
//   (a) Equal PPV across groups (calibration within group)
//   (b) Equal FPR across groups (equalized odds component)
//   (c) Equal TPR across groups (equalized odds component)
// Returns the minimum inevitable PPV gap given different prevalences and equal TPR/FPR.
fn chouldechova_ppv_gap(
    prevalence_a0: f64,     // P(Y=1|A=0)
    prevalence_a1: f64,     // P(Y=1|A=1)
    shared_tpr: f64,        // common TPR (assuming equal TPR for equalized opportunity)
    shared_fpr: f64         // common FPR (assuming equal FPR for equalized odds)
) -> f64 with IO, Div, Panic {
    // PPV for each group given shared TPR/FPR but different prevalences
    let ppv0 = ppv(shared_tpr, prevalence_a0, shared_fpr)
    let ppv1 = ppv(shared_tpr, prevalence_a1, shared_fpr)
    let d = ppv1 + (0.0 - ppv0)
    if d < 0.0 { 0.0 - d } else { d }
}

// fairness_criteria_incompatible: Chouldechova 2017 — returns true if
// demographic parity and calibration within group are contradictory given unequal base rates.
fn fairness_criteria_incompatible(criterion_a: i64, criterion_b: i64, base_rates_equal: bool) -> bool with IO {
    // When base rates are equal, all criteria can be jointly satisfied.
    if base_rates_equal {
        return false
    }
    // Chouldechova: DP ∧ CWG is impossible when base rates differ
    let dp_and_cwg = (criterion_a == FAIRNESS_DP && criterion_b == FAIRNESS_CWG)
        || (criterion_a == FAIRNESS_CWG && criterion_b == FAIRNESS_DP)
    // EO ∧ CWG is also impossible when base rates differ
    let eo_and_cwg = (criterion_a == FAIRNESS_EO && criterion_b == FAIRNESS_CWG)
        || (criterion_a == FAIRNESS_CWG && criterion_b == FAIRNESS_EO)
    dp_and_cwg || eo_and_cwg
}

// ============================================================
// Individual fairness (Lipschitz)
// ============================================================

// if_violation: |f(x) - f(x')| - L * d(x, x')
// Negative means individual fairness holds (Lipschitz satisfied).
// d(x, x') should be a task-specific metric capturing "similarity".
fn if_violation(score_x: f64, score_x_prime: f64, lipschitz: f64, distance: f64) -> f64 with IO {
    let sd = score_x + (0.0 - score_x_prime)
    let abs_sd = if sd < 0.0 { 0.0 - sd } else { sd }
    abs_sd + (0.0 - (lipschitz * distance))
}

// if_satisfied: true if Lipschitz condition holds (no individual fairness violation)
fn if_satisfied(score_x: f64, score_x_prime: f64, lipschitz: f64, distance: f64) -> bool with IO {
    if_violation(score_x, score_x_prime, lipschitz, distance) <= 0.0
}

// ============================================================
// Counterfactual fairness
// ============================================================

// cf_gap: |Ŷ(A←a) - Ŷ(A←a')| — counterfactual gap
// Counterfactually fair if cf_gap = 0 for all pairs (a, a').
fn cf_gap(score_a0: f64, score_a1: f64) -> f64 with IO {
    let d = score_a1 + (0.0 - score_a0)
    if d < 0.0 { 0.0 - d } else { d }
}

// cf_satisfied: true if counterfactual gap ≤ epsilon
fn cf_satisfied(score_a0: f64, score_a1: f64, epsilon: f64) -> bool with IO {
    cf_gap(score_a0, score_a1) <= epsilon
}

// ============================================================
// Aggregate fairness report from raw prediction arrays
// ============================================================

// FairnessReport — comprehensive fairness metrics computed from prediction arrays
struct FairnessReport {
    demographic_parity_diff: f64,       // |P(Ŷ=1|A=0) - P(Ŷ=1|A=1)|
    equalized_odds_diff: f64,           // max(|ΔTPR|, |ΔFPR|)
    predictive_parity_diff: f64,        // |PPV(A=0) - PPV(A=1)|
    calibration_diff: f64,              // |P(Y=1|Ŷ=1,A=0) - P(Y=1|Ŷ=1,A=1)|
    disparate_impact_ratio: f64,        // min(P₀/P₁, P₁/P₀)
    individual_fairness_lipschitz: f64, // placeholder (requires distance metric)
    chouldechova_impossible: i32,       // 1 if impossibility theorem triggered
}

// Helper: integer absolute value
fn abs_i32(x: i32) -> i32 {
    if x < 0 { 0 - x } else { x }
}

// Helper: f64 absolute value
fn abs_f64_local(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

// Helper: safe f64 division (returns 0 if denominator is 0)
fn safe_div(num: f64, denom: f64) -> f64 with Div, Panic {
    if denom == 0.0 { return 0.0 }
    num / denom
}

// demographic_parity: |P(Ŷ=1|A=0) - P(Ŷ=1|A=1)|
// Ref: Dwork et al. 2012 "Fairness Through Awareness"
fn demographic_parity(predictions: [i32; 256], protected: [i32; 256], n: i32) -> f64 with Mut, Div, Panic {
    var count0: f64 = 0.0
    var pos0: f64 = 0.0
    var count1: f64 = 0.0
    var pos1: f64 = 0.0
    var i: i32 = 0
    while i < n {
        let idx = i as usize
        let p = predictions[idx]
        let g = protected[idx]
        if g == 0 {
            count0 = count0 + 1.0
            if p == 1 { pos0 = pos0 + 1.0 }
        } else {
            count1 = count1 + 1.0
            if p == 1 { pos1 = pos1 + 1.0 }
        }
        i = i + 1
    }
    let rate0 = safe_div(pos0, count0)
    let rate1 = safe_div(pos1, count1)
    abs_f64_local(rate0 - rate1)
}

// equalized_odds: max(|ΔTPR|, |ΔFPR|)
// Ref: Hardt et al. 2016 "Equality of Opportunity in Supervised Learning"
fn equalized_odds(predictions: [i32; 256], true_labels: [i32; 256], protected: [i32; 256], n: i32) -> f64 with Mut, Div, Panic {
    // Group 0
    var tp0: f64 = 0.0
    var fp0: f64 = 0.0
    var fn0: f64 = 0.0
    var tn0: f64 = 0.0
    // Group 1
    var tp1: f64 = 0.0
    var fp1: f64 = 0.0
    var fn1: f64 = 0.0
    var tn1: f64 = 0.0
    var i: i32 = 0
    while i < n {
        let idx = i as usize
        let y_hat = predictions[idx]
        let y = true_labels[idx]
        let g = protected[idx]
        if g == 0 {
            if y == 1 && y_hat == 1 { tp0 = tp0 + 1.0 }
            if y == 0 && y_hat == 1 { fp0 = fp0 + 1.0 }
            if y == 1 && y_hat == 0 { fn0 = fn0 + 1.0 }
            if y == 0 && y_hat == 0 { tn0 = tn0 + 1.0 }
        } else {
            if y == 1 && y_hat == 1 { tp1 = tp1 + 1.0 }
            if y == 0 && y_hat == 1 { fp1 = fp1 + 1.0 }
            if y == 1 && y_hat == 0 { fn1 = fn1 + 1.0 }
            if y == 0 && y_hat == 0 { tn1 = tn1 + 1.0 }
        }
        i = i + 1
    }
    let tpr0 = safe_div(tp0, tp0 + fn0)
    let tpr1 = safe_div(tp1, tp1 + fn1)
    let fpr0 = safe_div(fp0, fp0 + tn0)
    let fpr1 = safe_div(fp1, fp1 + tn1)
    let d_tpr = abs_f64_local(tpr0 - tpr1)
    let d_fpr = abs_f64_local(fpr0 - fpr1)
    if d_tpr > d_fpr { d_tpr } else { d_fpr }
}

// disparate_impact: min(P₀/P₁, P₁/P₀)
// 4/5 rule (EEOC 1978): value < 0.8 signals adverse impact.
fn disparate_impact(predictions: [i32; 256], protected: [i32; 256], n: i32) -> f64 with Mut, Div, Panic {
    var count0: f64 = 0.0
    var pos0: f64 = 0.0
    var count1: f64 = 0.0
    var pos1: f64 = 0.0
    var i: i32 = 0
    while i < n {
        let idx = i as usize
        let p = predictions[idx]
        let g = protected[idx]
        if g == 0 {
            count0 = count0 + 1.0
            if p == 1 { pos0 = pos0 + 1.0 }
        } else {
            count1 = count1 + 1.0
            if p == 1 { pos1 = pos1 + 1.0 }
        }
        i = i + 1
    }
    let rate0 = safe_div(pos0, count0)
    let rate1 = safe_div(pos1, count1)
    if rate0 == 0.0 && rate1 == 0.0 { return 1.0 }
    if rate0 == 0.0 || rate1 == 0.0 { return 0.0 }
    let r01 = safe_div(rate0, rate1)
    let r10 = safe_div(rate1, rate0)
    if r01 < r10 { r01 } else { r10 }
}

// chouldechova_check: returns 1 if the impossibility theorem applies.
// Chouldechova 2017: when base rates differ (base0 ≠ base1), you cannot
// simultaneously equalize FPR, FNR, and PPV.
// Inputs: tp0, fp0, tp1, fp1 are rates; base0, base1 are prevalences P(Y=1|A=g).
fn chouldechova_check(tp0: f64, fp0: f64, tp1: f64, fp1: f64, base0: f64, base1: f64) -> i32 with Div, Panic {
    // Impossibility requires: base rates differ
    let rate_diff = abs_f64_local(base0 - base1)
    if rate_diff < 0.001 {
        return 0  // base rates equal → all criteria can hold simultaneously
    }
    // PPV = TPR * P / (TPR * P + FPR * (1 - P))
    let ppv0 = safe_div(tp0 * base0, tp0 * base0 + fp0 * (1.0 - base0))
    let ppv1 = safe_div(tp1 * base1, tp1 * base1 + fp1 * (1.0 - base1))
    // Equalized FPR and FNR (TPR) imply unequal PPV when base rates differ
    let fpr_diff = abs_f64_local(fp0 - fp1)
    let tpr_diff = abs_f64_local(tp0 - tp1)
    let ppv_diff = abs_f64_local(ppv0 - ppv1)
    // If FPR and TPR are roughly equal but PPV is not (base rate effect):
    // impossibility is demonstrated
    if fpr_diff < 0.05 && tpr_diff < 0.05 && ppv_diff > 0.05 {
        return 1
    }
    // Also flag if base rates differ significantly: Chouldechova's theorem
    // guarantees impossibility in principle even if not yet realized
    if rate_diff > 0.1 {
        return 1
    }
    0
}

// predictive_parity: |PPV(A=0) - PPV(A=1)|
// PPV = P(Y=1 | Ŷ=1); equal across groups means equal precision.
fn predictive_parity_diff_from_arrays(predictions: [i32; 256], true_labels: [i32; 256], protected: [i32; 256], n: i32) -> f64 with Mut, Div, Panic {
    var tp0: f64 = 0.0
    var fp0: f64 = 0.0
    var tp1: f64 = 0.0
    var fp1: f64 = 0.0
    var i: i32 = 0
    while i < n {
        let idx = i as usize
        let y_hat = predictions[idx]
        let y = true_labels[idx]
        let g = protected[idx]
        if g == 0 {
            if y == 1 && y_hat == 1 { tp0 = tp0 + 1.0 }
            if y == 0 && y_hat == 1 { fp0 = fp0 + 1.0 }
        } else {
            if y == 1 && y_hat == 1 { tp1 = tp1 + 1.0 }
            if y == 0 && y_hat == 1 { fp1 = fp1 + 1.0 }
        }
        i = i + 1
    }
    let ppv0 = safe_div(tp0, tp0 + fp0)
    let ppv1 = safe_div(tp1, tp1 + fp1)
    abs_f64_local(ppv0 - ppv1)
}

// fairness_report: compute all metrics from raw arrays in one pass
fn fairness_report(predictions: [i32; 256], true_labels: [i32; 256], protected: [i32; 256], n: i32) -> FairnessReport with Mut, Div, Panic {
    // Group 0 and 1 counts
    var count0: f64 = 0.0
    var pos0: f64 = 0.0
    var count1: f64 = 0.0
    var pos1: f64 = 0.0
    var tp0: f64 = 0.0
    var fp0: f64 = 0.0
    var fn0: f64 = 0.0
    var tn0: f64 = 0.0
    var tp1: f64 = 0.0
    var fp1: f64 = 0.0
    var fn1: f64 = 0.0
    var tn1: f64 = 0.0
    var i: i32 = 0
    while i < n {
        let idx = i as usize
        let y_hat = predictions[idx]
        let y = true_labels[idx]
        let g = protected[idx]
        if g == 0 {
            count0 = count0 + 1.0
            if y_hat == 1 { pos0 = pos0 + 1.0 }
            if y == 1 && y_hat == 1 { tp0 = tp0 + 1.0 }
            if y == 0 && y_hat == 1 { fp0 = fp0 + 1.0 }
            if y == 1 && y_hat == 0 { fn0 = fn0 + 1.0 }
            if y == 0 && y_hat == 0 { tn0 = tn0 + 1.0 }
        } else {
            count1 = count1 + 1.0
            if y_hat == 1 { pos1 = pos1 + 1.0 }
            if y == 1 && y_hat == 1 { tp1 = tp1 + 1.0 }
            if y == 0 && y_hat == 1 { fp1 = fp1 + 1.0 }
            if y == 1 && y_hat == 0 { fn1 = fn1 + 1.0 }
            if y == 0 && y_hat == 0 { tn1 = tn1 + 1.0 }
        }
        i = i + 1
    }
    let rate0 = safe_div(pos0, count0)
    let rate1 = safe_div(pos1, count1)
    let dp_diff = abs_f64_local(rate0 - rate1)
    let tpr0 = safe_div(tp0, tp0 + fn0)
    let tpr1 = safe_div(tp1, tp1 + fn1)
    let fpr0 = safe_div(fp0, fp0 + tn0)
    let fpr1 = safe_div(fp1, fp1 + tn1)
    let d_tpr = abs_f64_local(tpr0 - tpr1)
    let d_fpr = abs_f64_local(fpr0 - fpr1)
    let eo_diff = if d_tpr > d_fpr { d_tpr } else { d_fpr }
    let ppv0 = safe_div(tp0, tp0 + fp0)
    let ppv1 = safe_div(tp1, tp1 + fp1)
    let pp_diff = abs_f64_local(ppv0 - ppv1)
    // Calibration diff: same as predictive parity here (PPV-based)
    let cal_diff = pp_diff
    // Disparate impact ratio
    let di = if rate0 == 0.0 && rate1 == 0.0 {
        1.0
    } else if rate0 == 0.0 || rate1 == 0.0 {
        0.0
    } else {
        let r01 = safe_div(rate0, rate1)
        let r10 = safe_div(rate1, rate0)
        if r01 < r10 { r01 } else { r10 }
    }
    // Chouldechova impossibility (with base rates estimated from true_labels)
    var pos_true0: f64 = 0.0
    var pos_true1: f64 = 0.0
    var j: i32 = 0
    while j < n {
        let jdx = j as usize
        let y = true_labels[jdx]
        let g = protected[jdx]
        if g == 0 && y == 1 { pos_true0 = pos_true0 + 1.0 }
        if g == 1 && y == 1 { pos_true1 = pos_true1 + 1.0 }
        j = j + 1
    }
    let base0 = safe_div(pos_true0, count0)
    let base1 = safe_div(pos_true1, count1)
    let chould = chouldechova_check(tpr0, fpr0, tpr1, fpr1, base0, base1)
    FairnessReport {
        demographic_parity_diff: dp_diff,
        equalized_odds_diff: eo_diff,
        predictive_parity_diff: pp_diff,
        calibration_diff: cal_diff,
        disparate_impact_ratio: di,
        individual_fairness_lipschitz: 0.0,  // requires distance metric
        chouldechova_impossible: chould,
    }
}

// ============================================================
// Epistemic confidence tracking for fairness metrics
// ============================================================

// EpistemicFairnessValue — a fairness metric with uncertainty from finite sample size.
// Uses Wilson score interval (Brown, Cai, DasGupta 2001) for binomial proportions.
struct EpistemicFairnessValue {
    point_estimate: f64,    // the raw metric
    lower_95: f64,          // 95% CI lower bound
    upper_95: f64,          // 95% CI upper bound
    n_samples: i32,         // effective sample size
}

// sqrt helper for epistemic CI (Newton, 30 iterations)
//
// 30 iterations from y=x/2 converge to double precision across the IEEE 754
// range [1e-308, 1e308] (log2(log2(x)) iterations to enter the quadratic
// regime, then quadratic doubling of correct digits per step). 8 iters — the
// previous count — was insufficient for variances σ² > 2.5e5, i.e. σ > 500,
// producing ~4% relative error at σ=525 (rapamycin Vd scenario). Mirrors
// the canonical implementation in stdlib/epistemic/knowledge.sio::ep_sqrt.
fn ep_sqrt(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x / 2.0
    var k = 0
    while k < 30 {
        y = (y + x / y) / 2.0
        k = k + 1
    }
    y
}

// Wilson interval half-width for a proportion p over n trials at z=1.96 (95%)
// half = z * sqrt(p*(1-p)/n + z²/(4n²)) / (1 + z²/n)
fn wilson_half(p: f64, n: i32) -> f64 with Mut, Div, Panic {
    let z = 1.96
    let nf: f64 = n as f64
    let z2 = z * z
    let inner = p * (1.0 - p) / nf + z2 / (4.0 * nf * nf)
    z * ep_sqrt(inner) / (1.0 + z2 / nf)
}

// epistemic_dp_metric — wrap demographic parity with Wilson-style CI
// Uses normal approximation for the difference of two proportions.
fn epistemic_demographic_parity(predictions: [i32; 256], protected: [i32; 256], n: i32) -> EpistemicFairnessValue with Mut, Div, Panic {
    var count0: f64 = 0.0
    var pos0: f64 = 0.0
    var count1: f64 = 0.0
    var pos1: f64 = 0.0
    var i: i32 = 0
    while i < n {
        let idx = i as usize
        let p = predictions[idx]
        let g = protected[idx]
        if g == 0 {
            count0 = count0 + 1.0
            if p == 1 { pos0 = pos0 + 1.0 }
        } else {
            count1 = count1 + 1.0
            if p == 1 { pos1 = pos1 + 1.0 }
        }
        i = i + 1
    }
    let rate0 = safe_div(pos0, count0)
    let rate1 = safe_div(pos1, count1)
    let diff = abs_f64_local(rate0 - rate1)
    // SE of difference of proportions: sqrt(p0(1-p0)/n0 + p1(1-p1)/n1)
    let se = ep_sqrt(safe_div(rate0 * (1.0 - rate0), count0) + safe_div(rate1 * (1.0 - rate1), count1))
    let half = 1.96 * se
    EpistemicFairnessValue {
        point_estimate: diff,
        lower_95: if diff - half < 0.0 { 0.0 } else { diff - half },
        upper_95: diff + half,
        n_samples: n,
    }
}

// ============================================================
// Fairness audit summary
// ============================================================

struct FairnessAuditResult {
    dp_gap_val: f64,
    eo_gap_val: f64,
    cwg_gap_val: f64,
    cf_gap_val: f64,
    impossibility_triggered: bool,
    overall_fair: bool,
}

fn fairness_audit(
    rate_a0: f64, rate_a1: f64,       // approval rates for DP
    tpr_a0: f64, tpr_a1: f64,         // true positive rates for EO
    fpr_a0: f64, fpr_a1: f64,         // false positive rates for EO
    cal_a0: f64, cal_a1: f64,         // calibration rates for CWG
    score_cf_a0: f64, score_cf_a1: f64, // counterfactual scores
    base_rates_equal: bool,           // are base rates equal? (for impossibility)
    epsilon: f64                      // shared tolerance for all criteria
) -> FairnessAuditResult with IO, Div, Panic {
    let dp = dp_gap(rate_a0, rate_a1)
    let eo = eo_gap(tpr_a0, tpr_a1, fpr_a0, fpr_a1)
    let cwg = cwg_gap(cal_a0, cal_a1)
    let cf = cf_gap(score_cf_a0, score_cf_a1)
    let impossible = fairness_criteria_incompatible(FAIRNESS_DP, FAIRNESS_CWG, base_rates_equal)
    let all_ok = dp <= epsilon && eo <= epsilon && cwg <= epsilon && cf <= epsilon
    FairnessAuditResult {
        dp_gap_val: dp,
        eo_gap_val: eo,
        cwg_gap_val: cwg,
        cf_gap_val: cf,
        impossibility_triggered: impossible,
        overall_fair: all_ok,
    }
}
