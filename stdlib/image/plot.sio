// Draw an ASCII string at scale `sc` (advance 8*sc px per glyph). Returns end x.
pub fn plot_text_sc(img: &!Image, s: string, px: i64, py: i64, c: i64, sc: i64) -> i64 with Mut, Panic, Div {
    let gs = (sc as f64) * 0.62
    let hw = gs * 0.55
    let adv = (7.0 * gs) as i64
    var x = px; var i = 0; let n = str_len(s)
    while i < n { sf_draw(img, str_char_at(s, i), x, py, gs, hw, c); x = x + adv; i = i + 1 }
    x
}
// Default 2× text (legible for figure titles / axis labels).
pub fn plot_text(img: &!Image, s: string, px: i64, py: i64, c: i64) -> i64 with Mut, Panic, Div {
    plot_text_sc(img, s, px, py, c, 2)
}

// Draw a number with `dec` decimal places at (px,py), scale `sc`. Returns end x.
pub fn draw_number(img: &!Image, val: f64, dec: i64, px: i64, py: i64, c: i64, sc: i64) -> i64 with Mut, Div, Panic {
    let gs = (sc as f64) * 0.62
    let hw = gs * 0.55
    let adv = (7.0 * gs) as i64
    var x = px
    var v = val
    if v < 0.0 { sf_draw(img, 45, x, py, gs, hw, c); x = x + adv; v = 0.0 - v }
    let ip = v as i64
    var digs: [i64; 16] = [0; 16]
    var nd = 0
    var q = ip
    if q == 0 { digs[0 as usize] = 0; nd = 1 }
    else { while q > 0 { digs[nd as usize] = q % 10; nd = nd + 1; q = q / 10 } }
    var k = nd - 1
    while k >= 0 { sf_draw(img, 48 + digs[k as usize], x, py, gs, hw, c); x = x + adv; k = k - 1 }
    if dec > 0 {
        sf_draw(img, 46, x, py, gs, hw, c); x = x + adv
        var frac = v - (ip as f64)
        var d = 0
        while d < dec { frac = frac * 10.0; let dg = (frac as i64) % 10; sf_draw(img, 48 + dg, x, py, gs, hw, c); x = x + adv; d = d + 1 }
    }
    x
}

// Light gridlines at the `nx`/`ny` interior tick positions.
pub fn plot_grid(img: &!Image, a: &Area, nx: i64, ny: i64, c: i64) with Mut, Div, Panic {
    let dx = if (*a).xmax - (*a).xmin == 0.0 { 1.0 } else { (*a).xmax - (*a).xmin }
    var i = 1
    while i < nx {
        let px = mapx(a, (*a).xmin + dx * ((i as f64) / (nx as f64)))
        var y = (*a).y0
        while y <= (*a).y1 { setpx(img, px, y, c); y = y + 1 }
        i = i + 1
    }
    let dy = if (*a).ymax - (*a).ymin == 0.0 { 1.0 } else { (*a).ymax - (*a).ymin }
    var j = 1
    while j < ny {
        let py = mapy(a, (*a).ymin + dy * ((j as f64) / (ny as f64)))
        var x = (*a).x0
        while x <= (*a).x1 { setpx(img, x, py, c); x = x + 1 }
        j = j + 1
    }
}

// Axis frame + `nx`/`ny` ticks with numeric labels.
pub fn plot_axes(img: &!Image, a: &Area, nx: i64, ny: i64, c: i64, sc: i64) with Mut, Div, Panic {
    // frame
    var x = (*a).x0
    while x <= (*a).x1 { setpx(img, x, (*a).y0, c); setpx(img, x, (*a).y1, c); x = x + 1 }
    var y = (*a).y0
    while y <= (*a).y1 { setpx(img, (*a).x0, y, c); setpx(img, (*a).x1, y, c); y = y + 1 }
    // x ticks + labels
    let dx = if (*a).xmax - (*a).xmin == 0.0 { 1.0 } else { (*a).xmax - (*a).xmin }
    var i = 0
    while i <= nx {
        let vx = (*a).xmin + dx * ((i as f64) / (nx as f64))
        let sx = mapx(a, vx)
        var t = 0; while t < 3*sc { setpx(img, sx, (*a).y1 + t, c); t = t + 1 }
        draw_number(img, vx, if dx < 10.0 { 1 } else { 0 }, sx - 6*sc, (*a).y1 + 6*sc, c, sc)
        i = i + 1
    }
    // y ticks + labels
    let dy = if (*a).ymax - (*a).ymin == 0.0 { 1.0 } else { (*a).ymax - (*a).ymin }
    var j = 0
    while j <= ny {
        let vy = (*a).ymin + dy * ((j as f64) / (ny as f64))
        let sy = mapy(a, vy)
        var t2 = 0; while t2 < 3*sc { setpx(img, (*a).x0 - t2, sy, c); t2 = t2 + 1 }
        draw_number(img, vy, if dy < 10.0 { 1 } else { 0 }, (*a).x0 - 34*sc, sy - 4*sc, c, sc)
        j = j + 1
    }
}

// One legend row at pixel (px,py): a colour swatch line + disc, then the label.
pub fn plot_legend_item(img: &!Image, px: i64, py: i64, c: i64, label: string) with Mut, Panic, Div {
    seg_aa(img, px, py + 6, px + 22, py + 6, 1.4, c)
    let rf = 2.5
    var yy = 0 - 3
    while yy <= 3 {
        var xx = 0 - 3
        while xx <= 3 {
            let d = sqrt(((xx * xx) + (yy * yy)) as f64)
            var av = 0
            if d <= rf { av = 255 } else { if d <= rf + 1.0 { av = ((rf + 1.0 - d) * 255.0) as i64 } }
            if av > 0 { blend(img, px + 11 + xx, py + 6 + yy, c, av) }
            xx = xx + 1
        }
        yy = yy + 1
    }
    let _e = plot_text_sc(img, label, px + 30, py, c, 2)
}

pub fn plot_save(img: &Image, filename: string) -> bool with IO, Mut, Div, Panic {
    png_write(filename, img)
}
