// stdlib/image/pure/types.sio — Image Types

module image::pure::types

pub struct Image {
    pub width: i32,
    pub height: i32,
    pub pixels: [u32; 1000000],  // max ~1200x800 pixels
}

pub fn image_new(w: i32, h: i32) -> Image {
    Image { width: w, height: h, pixels: [0; 1000000] }
}

pub fn image_get_pixel(img: &Image, x: i32, y: i32) -> u32 {
    if x < 0 || x >= img.width || y < 0 || y >= img.height { return 0 }
    let idx = (y * img.width + x) as usize
    img.pixels[idx]
}

pub fn image_set_pixel(img: &! Image, x: i32, y: i32, c: u32) with Mut {
    if x < 0 || x >= img.width || y < 0 || y >= img.height { return }
    let idx = (y * img.width + x) as usize
    img.pixels[idx] = c
}

pub fn image_width(img: &Image) -> i32 { img.width }

pub fn image_height(img: &Image) -> i32 { img.height }