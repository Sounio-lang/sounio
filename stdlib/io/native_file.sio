// Checked regular-file I/O. Reads append into caller-owned, budgeted byte buffers.
// A successful positive-length read with value=0 is EOF. Short reads/writes are explicit.
use ffi::platform::{Platform,PlatformValue,platform_call}
use collections::byte_buffer::{ByteBuffer,byte_buffer_native_file_open,byte_buffer_native_file_read,byte_buffer_native_file_write}
pub linear struct NativeFile {id:i64,status:i64}
pub fn native_file_open(p:&Platform,path:&ByteBuffer,mode:i64)->NativeFile with IO {
 let r=byte_buffer_native_file_open(p,path,mode)
 return NativeFile {id:r.value,status:r.status}
}
pub fn native_file_status(f:&NativeFile)->i64 {f.status}
pub fn native_file_read(p:&Platform,f:&NativeFile,b:&!ByteBuffer,n:i64)->PlatformValue with IO,Alloc,Mut {
 if f.status!=0 {return PlatformValue {value:0,status:f.status}}
 return byte_buffer_native_file_read(p,f.id,b,n)
}
pub fn native_file_write(p:&Platform,f:&NativeFile,b:&ByteBuffer,offset:i64,n:i64)->PlatformValue with IO {
 if f.status!=0 {return PlatformValue {value:0,status:f.status}}
 return byte_buffer_native_file_write(p,f.id,b,offset,n)
}
pub fn native_file_write_all(p:&Platform,f:&NativeFile,b:&ByteBuffer,offset:i64,n:i64)->PlatformValue with IO,Mut {
 var done:i64=0
 if n<0 || offset<0 {return PlatformValue {value:0,status:22}}
 // Validate even an empty write, including the owner and source range.
 let initial=native_file_write(p,f,b,offset,0)
 if initial.status!=0 {return initial}
 while done<n {
  let r=native_file_write(p,f,b,offset+done,n-done)
  if r.status!=0 {return PlatformValue {value:done,status:r.status}}
  if r.value<=0 || r.value>n-done {return PlatformValue {value:done,status:5}}
  done=done+r.value
 }
 return PlatformValue {value:done,status:0}
}
pub fn native_file_seek(p:&Platform,f:&NativeFile,offset:i64,origin:i64)->PlatformValue with IO {
 if f.status!=0 {return PlatformValue {value:0,status:f.status}}
 return platform_call(p,93,f.id,offset,origin,0)
}
pub fn native_file_sync(p:&Platform,f:&NativeFile)->i64 with IO {
 if f.status!=0 {return f.status}
 return platform_call(p,94,f.id,0,0,0).status
}
pub fn native_file_close(p:&Platform,f:NativeFile)->i64 with IO {
 let NativeFile {id,status}=f
 if status!=0 {return status}
 return platform_call(p,2,id,0,0,0).status
}
