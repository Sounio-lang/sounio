// Checked native IO entrypoint. Legacy pure/binary/scientific helpers remain
// available through their direct modules and the existing io::mod facade.

// Checked owned native file I/O and explicit buffered-reader lifecycle.
pub use io::native_file::{
    NativeFile, native_file_open, native_file_status, native_file_read,
    native_file_write, native_file_write_all, native_file_seek, native_file_sync,
    native_file_close,
}

pub use io::buffered_reader::{
    BufferedReader, buffered_reader_new, buffered_reader_status, buffered_reader_offset,
    buffered_reader_next, buffered_reader_close,
}
