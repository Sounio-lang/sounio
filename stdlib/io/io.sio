// io/mod.sio — Buffered I/O
//
// Fixed-capacity byte buffer for composing and reading data.
// No heap allocation; uses a 4096-byte internal buffer.

// ============================================================================
// IO BUFFER
// ============================================================================

pub struct IoBuffer {
    data: [u8; 4096],  // Internal storage
    len: i32,          // Number of valid bytes
    pos: i32,          // Read cursor position
}

pub fn io_buf_new() -> IoBuffer {
    IoBuffer { data: [0; 4096], len: 0, pos: 0 }
}

// ============================================================================
// WRITE TO BUFFER
// ============================================================================
// Appends n bytes from data to the buffer. Returns updated buffer.
// Silently truncates if buffer would overflow.

pub fn io_buf_write(buf: IoBuffer, data: &[u8; 256], n: i32) -> IoBuffer {
    var out = buf
    var i: i32 = 0
    while i < n {
        if out.len >= 4096 {
            return out
        }
        out.data[out.len as usize] = data[i as usize]
        out.len = out.len + 1
        i = i + 1
    }
    out
}

// ============================================================================
// READ FROM BUFFER
// ============================================================================
// Reads up to n bytes from buffer starting at pos. Returns (updated buffer, bytes read).
// Updates pos in the returned buffer.

pub fn io_buf_read(buf: IoBuffer, out: &![u8; 256], n: i32) -> (IoBuffer, i32) with Mut, Panic, Div {
    var b = buf
    var count: i32 = 0
    var i: i32 = 0
    while i < n {
        if b.pos >= b.len {
            return (b, count)
        }
        out[i as usize] = b.data[b.pos as usize]
        b.pos = b.pos + 1
        count = count + 1
        i = i + 1
    }
    (b, count)
}

// ============================================================================
// BUFFER QUERIES
// ============================================================================

pub fn io_buf_remaining(buf: &IoBuffer) -> i32 {
    buf.len - buf.pos
}

pub fn io_buf_capacity(buf: &IoBuffer) -> i32 {
    4096 - buf.len
}

pub fn io_buf_is_empty(buf: &IoBuffer) -> bool {
    buf.len == 0
}

pub fn io_buf_reset(buf: IoBuffer) -> IoBuffer {
    var out = buf
    out.len = 0
    out.pos = 0
    out
}

// ============================================================================
// INLINE TESTS
// ============================================================================

//@ run-pass
fn test_io_buf_new() -> i32 {
    let b = io_buf_new()
    if b.len != 0 { return 1 }
    if b.pos != 0 { return 2 }
    0
}

//@ run-pass
fn test_io_buf_write_read() -> i32 {
    var b = io_buf_new()
    var data: [u8; 256] = [0; 256]
    data[0] = 65  // 'A'
    data[1] = 66  // 'B'
    data[2] = 67  // 'C'
    b = io_buf_write(b, &data, 3)
    if b.len != 3 { return 1 }

    var out: [u8; 256] = [0; 256]
    let result = io_buf_read(b, &!out, 3)
    let b2 = result.0
    let n = result.1
    if n != 3 { return 2 }
    if out[0] != 65 { return 3 }
    if out[1] != 66 { return 4 }
    if out[2] != 67 { return 5 }
    0
}

//@ run-pass
fn test_io_buf_remaining() -> i32 {
    var b = io_buf_new()
    var data: [u8; 256] = [0; 256]
    data[0] = 1
    data[1] = 2
    b = io_buf_write(b, &data, 2)
    if io_buf_remaining(&b) != 2 { return 1 }
    0
}
