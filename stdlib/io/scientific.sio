//     var mode: [i8; 4] = [119, 98, 0, 0]  // "wb\0\0"
//     let fp = fopen(path, &mode)
//     if fp == 0 { return 0 - 1 }
//
//     // Write magic "SMAT" (4 bytes)
//     // Write rows (8 bytes, little-endian i64)
//     // Write cols (8 bytes, little-endian i64)
//     // Write data (rows * cols * 8 bytes, f64 array)
//
//     fclose(fp)
//     return 0
// }

