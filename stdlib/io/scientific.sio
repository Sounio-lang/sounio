//     return m
// }

// ============================================================================
// CONVENIENCE: PRINT MATRIX AS CSV (from MatrixData struct)
// ============================================================================

pub fn matrix_data_print_csv(m: MatrixData) with IO, Mut, Panic, Div {
    print_csv(m.data, m.rows, m.cols)
}

pub fn matrix_data_print_json(m: MatrixData) with IO, Mut, Panic, Div {
    print_json_matrix(m.data, m.rows, m.cols)
}

// ============================================================================
// COLUMN STATISTICS (operates on flat arrays)
// ============================================================================

pub fn col_mean(data: [f64; 4096], rows: i64, cols: i64, col: i64) -> f64 with Mut, Div, Panic {
    if col < 0 { return 0.0 }
    if col >= cols { return 0.0 }
    if rows <= 0 { return 0.0 }
    var sum = 0.0
    var r: i64 = 0
    while r < rows {
        sum = sum + data[(r * cols + col) as usize]
        r = r + 1
    }
    sum / (rows as f64)
}

pub fn col_std(data: [f64; 4096], rows: i64, cols: i64, col: i64) -> f64 with Mut, Div, Panic {
    if rows < 2 { return 0.0 }
    let mean = col_mean(data, rows, cols, col)
    var sum_sq = 0.0
    var r: i64 = 0
    while r < rows {
        let diff = data[(r * cols + col) as usize] - mean
        sum_sq = sum_sq + diff * diff
        r = r + 1
    }
    sci_sqrt(sum_sq / ((rows - 1) as f64))
}

// ============================================================================
// PYTHON INTEROP SCRIPTS (printed to stdout)
// ============================================================================

// Print a complete Python script that reads the CSV from stdin
pub fn print_python_csv_reader() with IO {
    println("#!/usr/bin/env python3")
    println("import numpy as np")
    println("import sys")
    println("data = np.loadtxt(sys.stdin, delimiter=',', skiprows=1)")
    println("print(f'Loaded matrix: {data.shape}')")
    println("print(f'Mean: {data.mean():.6f}')")
    println("print(f'Std:  {data.std():.6f}')")
}

// Print a Python script that converts the flat f64 stream to .npy
pub fn print_python_npy_converter(rows: i64, cols: i64) with IO, Mut, Panic, Div {
    println("#!/usr/bin/env python3")
    println("import numpy as np, sys")
    print("data = np.loadtxt(sys.stdin).reshape(")
    sci_print_i64(rows)
    print(", ")
    sci_print_i64(cols)
    println(")")
    println("np.save('output.npy', data)")
    println("print(f'Saved {data.shape} to output.npy')")
}
