// stdlib/regex — Pattern matching utilities
//
// Main implementation: regex/lib.sio (regex_match, glob_match, regex_count)
// Simple literal-only functions below for basic use cases.

fn regex_match_literal(text: &[u8; 256], text_len: i32, pattern: &[u8; 64], pat_len: i32) -> bool with Mut, Panic, Div {
    if text_len != pat_len { return false }
    var i: i32 = 0
    while i < text_len {
        if text[i] != pattern[i] { return false }
        i = i + 1
    }
    true
}

fn regex_find_literal(text: &[u8; 256], text_len: i32, pattern: &[u8; 64], pat_len: i32) -> i32 with Mut, Panic, Div {
    if pat_len <= 0 { return 0 }
    if pat_len > text_len { return 0 - 1 }

    var i: i32 = 0
    let limit = text_len - pat_len + 1
    while i < limit {
        var j: i32 = 0
        var matched = true
        while j < pat_len && matched {
            if text[i + j] != pattern[j] { matched = false }
            j = j + 1
        }
        if matched { return i }
        i = i + 1
    }
    0 - 1
}

// =============================================================================
// Tests
// =============================================================================

fn test_literal_match() -> bool with Mut, Panic, Div {
    var text: [u8; 256] = [0; 256]
    var pat: [u8; 64] = [0; 64]
    text[0] = 97
    text[1] = 98
    text[2] = 99
    pat[0] = 97
    pat[1] = 98
    pat[2] = 99
    regex_match_literal(&text, 3, &pat, 3)
}

fn test_find_literal() -> bool with Mut, Panic, Div {
    var text: [u8; 256] = [0; 256]
    var pat: [u8; 64] = [0; 64]
    // "hello world" find "world"
    text[0] = 104
    text[1] = 101
    text[2] = 108
    text[3] = 108
    text[4] = 111
    text[5] = 32
    text[6] = 119
    text[7] = 111
    text[8] = 114
    text[9] = 108
    text[10] = 100
    pat[0] = 119
    pat[1] = 111
    pat[2] = 114
    pat[3] = 108
    pat[4] = 100
    regex_find_literal(&text, 11, &pat, 5) == 6
}

fn main() with IO, Mut, Panic, Div {
    if test_literal_match() { print("regex literal_match: PASS\n") } else { print("regex literal_match: FAIL\n") }
    if test_find_literal() { print("regex find_literal: PASS\n") } else { print("regex find_literal: FAIL\n") }
}
