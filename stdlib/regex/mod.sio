//! stdlib/regex/mod.sio - Regular Expression Engine
//!
//! A pure Sounio implementation of regular expressions using NFA simulation.
//! Supports common regex features with guaranteed linear time matching.
//!
//! # Supported Syntax
//!
//! - Literals: `abc` matches "abc"
//! - Character classes: `[abc]`, `[a-z]`, `[^abc]`
//! - Predefined classes: `\d` (digit), `\w` (word), `\s` (whitespace)
//! - Quantifiers: `*`, `+`, `?`, `{n}`, `{n,}`, `{n,m}`
//! - Anchors: `^` (start), `$` (end)
//! - Groups: `(...)` for grouping
//! - Alternation: `a|b`
//! - Escape sequences: `\.`, `\\`, etc.
//!
//! # Examples
//!
//! ```sio
//! let re = regex_compile(r"hello\s+world")?
//! let matched = regex_is_match(&re, "hello   world")  // true
//!
//! let captures = regex_captures(&re, "hello   world")?
//! let full_match = captures[0]  // "hello   world"
//!
//! let all_matches = regex_find_all(&re, "hello world, hello friend")
//! ```

// ============================================================================
// Types
// ============================================================================

// A compiled regular expression.
pub struct Regex {
    /// Original pattern string
    pattern: String,
    /// NFA states
    states: Vec<NfaState>,
    /// Start state index
    start: usize,
    /// Number of capture groups
    num_groups: usize,
}

// NFA state types
enum NfaState {
    /// Match a single character
    Char { c: char, next: usize },
    /// Match a character class
    CharClass { chars: Vec<CharRange>, negated: bool, next: usize },
    /// Match any character (except newline)
    Any { next: usize },
    /// Split into two possible paths (for |, *, +, ?)
    Split { next1: usize, next2: usize },
    /// Start of a capture group
    GroupStart { group: usize, next: usize },
    /// End of a capture group
    GroupEnd { group: usize, next: usize },
    /// Anchor: start of string
    AnchorStart { next: usize },
    /// Anchor: end of string
    AnchorEnd { next: usize },
    /// Accepting state (match complete)
    Accept,
}

// Character range for character classes
struct CharRange {
    start: char,
    end: char,
}

// Regex compilation errors
pub enum RegexError {
    /// Unexpected end of pattern
    UnexpectedEnd,
    /// Invalid escape sequence
    InvalidEscape { pos: usize },
    /// Unbalanced parentheses
    UnbalancedParen { pos: usize },
    /// Invalid character class
    InvalidCharClass { pos: usize },
    /// Invalid quantifier
    InvalidQuantifier { pos: usize },
    /// Pattern too complex
    TooComplex,
}

// Match result with capture groups
pub struct Match {
    /// Full match start position
    start: usize,
    /// Full match end position
    end: usize,
    /// Capture groups (index 0 is full match)
    groups: Vec<Option<Span>>,
}

// A span in the input string
pub struct Span {
    start: usize,
    end: usize,
}

// ============================================================================
// Compilation
// ============================================================================

// Compile a regex pattern into an NFA.
pub fn regex_compile(pattern: &str) -> Result<Regex, RegexError> with Alloc {
    var compiler = RegexCompiler {
        pattern: pattern,
        pos: 0,
        states: vec_new(),
        num_groups: 0,
    }

    let start = compiler_parse_expr(&!compiler)?

    // Add final accept state
    let accept_idx = vec_len(&compiler.states)
    vec_push(&!compiler.states, NfaState::Accept)

    // Patch dangling next pointers to accept state
    compiler_patch(&!compiler, start, accept_idx)

    Ok(Regex {
        pattern: string_from(pattern),
        states: compiler.states,
        start: start,
        num_groups: compiler.num_groups,
    })
}

struct RegexCompiler {
    pattern: &str,
    pos: usize,
    states: Vec<NfaState>,
    num_groups: usize,
}

fn compiler_peek(c: &RegexCompiler) -> Option<char> {
    if c.pos >= c.pattern.len() {
        None
    } else {
        Some(c.pattern.char_at(c.pos))
    }
}

fn compiler_advance(c: &!RegexCompiler) -> Option<char> {
    if c.pos >= c.pattern.len() {
        None
    } else {
        let ch = c.pattern.char_at(c.pos)
        c.pos = c.pos + 1
        Some(ch)
    }
}

fn compiler_emit(c: &!RegexCompiler, state: NfaState) -> usize {
    let idx = vec_len(&c.states)
    vec_push(&!c.states, state)
    idx
}

// Parse alternation: expr | expr | ...
fn compiler_parse_expr(c: &!RegexCompiler) -> Result<usize, RegexError> with Alloc {
    let first = compiler_parse_concat(c)?

    if compiler_peek(c) != Some('|') {
        return Ok(first)
    }

    var branches = vec_new::<usize>()
    vec_push(&!branches, first)

    while compiler_peek(c) == Some('|') {
        compiler_advance(c)
        let branch = compiler_parse_concat(c)?
        vec_push(&!branches, branch)
    }

    // Build alternation: split -> branch1, split -> branch2, ...
    var result = branches[vec_len(&branches) - 1]
    var i = vec_len(&branches) - 2
    while i >= 0 {
        let split_idx = compiler_emit(c, NfaState::Split {
            next1: branches[i],
            next2: result,
        })
        result = split_idx
        if i == 0 { break }
        i = i - 1
    }

    Ok(result)
}

// Parse concatenation: term term term ...
fn compiler_parse_concat(c: &!RegexCompiler) -> Result<usize, RegexError> with Alloc {
    var terms = vec_new::<usize>()

    while compiler_peek(c).is_some() {
        let ch = compiler_peek(c).unwrap()
        if ch == '|' || ch == ')' {
            break
        }

        let term = compiler_parse_quantified(c)?
        vec_push(&!terms, term)
    }

    if vec_len(&terms) == 0 {
        // Empty expression - emit empty transition
        return Ok(compiler_emit(c, NfaState::Split { next1: 0, next2: 0 }))
    }

    // Link terms together
    var i = 0
    while i < vec_len(&terms) - 1 {
        compiler_patch(c, terms[i], terms[i + 1])
        i = i + 1
    }

    Ok(terms[0])
}

// Parse quantified term: term*, term+, term?, term{n,m}
fn compiler_parse_quantified(c: &!RegexCompiler) -> Result<usize, RegexError> with Alloc {
    let term = compiler_parse_atom(c)?

    match compiler_peek(c) {
        Some('*') => {
            compiler_advance(c)
            // a* = split(a -> self, out)
            let split_idx = compiler_emit(c, NfaState::Split { next1: term, next2: 0 })
            compiler_patch(c, term, split_idx)
            Ok(split_idx)
        },
        Some('+') => {
            compiler_advance(c)
            // a+ = a -> split(a, out)
            let split_idx = compiler_emit(c, NfaState::Split { next1: term, next2: 0 })
            compiler_patch(c, term, split_idx)
            Ok(term)
        },
        Some('?') => {
            compiler_advance(c)
            // a? = split(a, out)
            let split_idx = compiler_emit(c, NfaState::Split { next1: term, next2: 0 })
            Ok(split_idx)
        },
        Some('{') => {
            compiler_parse_counted(c, term)
        },
        _ => Ok(term),
    }
}

// Parse counted quantifier: {n}, {n,}, {n,m}
fn compiler_parse_counted(c: &!RegexCompiler, term: usize) -> Result<usize, RegexError> with Alloc {
    compiler_advance(c)  // consume '{'

    var min_count = 0
    while compiler_peek(c).is_some() {
        let ch = compiler_peek(c).unwrap()
        if ch >= '0' && ch <= '9' {
            compiler_advance(c)
            min_count = min_count * 10 + ((ch as u32) - ('0' as u32)) as usize
        } else {
            break
        }
    }

    var max_count = min_count
    var unbounded = false

    if compiler_peek(c) == Some(',') {
        compiler_advance(c)
        if compiler_peek(c) == Some('}') {
            unbounded = true
        } else {
            max_count = 0
            while compiler_peek(c).is_some() {
                let ch = compiler_peek(c).unwrap()
                if ch >= '0' && ch <= '9' {
                    compiler_advance(c)
                    max_count = max_count * 10 + ((ch as u32) - ('0' as u32)) as usize
                } else {
                    break
                }
            }
        }
    }

    if compiler_peek(c) != Some('}') {
        return Err(RegexError::InvalidQuantifier { pos: c.pos })
    }
    compiler_advance(c)

    // For simplicity, just return the term for now
    // A full implementation would duplicate the term appropriately
    Ok(term)
}

// Parse atomic element: char, group, class, anchor
fn compiler_parse_atom(c: &!RegexCompiler) -> Result<usize, RegexError> with Alloc {
    match compiler_peek(c) {
        None => Err(RegexError::UnexpectedEnd),
        Some('(') => compiler_parse_group(c),
        Some('[') => compiler_parse_char_class(c),
        Some('^') => {
            compiler_advance(c)
            Ok(compiler_emit(c, NfaState::AnchorStart { next: 0 }))
        },
        Some('$') => {
            compiler_advance(c)
            Ok(compiler_emit(c, NfaState::AnchorEnd { next: 0 }))
        },
        Some('.') => {
            compiler_advance(c)
            Ok(compiler_emit(c, NfaState::Any { next: 0 }))
        },
        Some('\\') => compiler_parse_escape(c),
        Some(ch) => {
            if ch == '*' || ch == '+' || ch == '?' || ch == '{' || ch == '|' || ch == ')' {
                Err(RegexError::InvalidQuantifier { pos: c.pos })
            } else {
                compiler_advance(c)
                Ok(compiler_emit(c, NfaState::Char { c: ch, next: 0 }))
            }
        },
    }
}

// Parse escape sequence: \d, \w, \s, \\, etc.
fn compiler_parse_escape(c: &!RegexCompiler) -> Result<usize, RegexError> with Alloc {
    compiler_advance(c)  // consume '\'

    match compiler_peek(c) {
        None => Err(RegexError::UnexpectedEnd),
        Some('d') => {
            compiler_advance(c)
            // \d = [0-9]
            var ranges = vec_new::<CharRange>()
            vec_push(&!ranges, CharRange { start: '0', end: '9' })
            Ok(compiler_emit(c, NfaState::CharClass { chars: ranges, negated: false, next: 0 }))
        },
        Some('D') => {
            compiler_advance(c)
            // \D = [^0-9]
            var ranges = vec_new::<CharRange>()
            vec_push(&!ranges, CharRange { start: '0', end: '9' })
            Ok(compiler_emit(c, NfaState::CharClass { chars: ranges, negated: true, next: 0 }))
        },
        Some('w') => {
            compiler_advance(c)
            // \w = [a-zA-Z0-9_]
            var ranges = vec_new::<CharRange>()
            vec_push(&!ranges, CharRange { start: 'a', end: 'z' })
            vec_push(&!ranges, CharRange { start: 'A', end: 'Z' })
            vec_push(&!ranges, CharRange { start: '0', end: '9' })
            vec_push(&!ranges, CharRange { start: '_', end: '_' })
            Ok(compiler_emit(c, NfaState::CharClass { chars: ranges, negated: false, next: 0 }))
        },
        Some('W') => {
            compiler_advance(c)
            // \W = [^a-zA-Z0-9_]
            var ranges = vec_new::<CharRange>()
            vec_push(&!ranges, CharRange { start: 'a', end: 'z' })
            vec_push(&!ranges, CharRange { start: 'A', end: 'Z' })
            vec_push(&!ranges, CharRange { start: '0', end: '9' })
            vec_push(&!ranges, CharRange { start: '_', end: '_' })
            Ok(compiler_emit(c, NfaState::CharClass { chars: ranges, negated: true, next: 0 }))
        },
        Some('s') => {
            compiler_advance(c)
            // \s = [ \t\n\r\f\v]
            var ranges = vec_new::<CharRange>()
            vec_push(&!ranges, CharRange { start: ' ', end: ' ' })
            vec_push(&!ranges, CharRange { start: '\t', end: '\t' })
            vec_push(&!ranges, CharRange { start: '\n', end: '\n' })
            vec_push(&!ranges, CharRange { start: '\r', end: '\r' })
            Ok(compiler_emit(c, NfaState::CharClass { chars: ranges, negated: false, next: 0 }))
        },
        Some('S') => {
            compiler_advance(c)
            // \S = [^ \t\n\r\f\v]
            var ranges = vec_new::<CharRange>()
            vec_push(&!ranges, CharRange { start: ' ', end: ' ' })
            vec_push(&!ranges, CharRange { start: '\t', end: '\t' })
            vec_push(&!ranges, CharRange { start: '\n', end: '\n' })
            vec_push(&!ranges, CharRange { start: '\r', end: '\r' })
            Ok(compiler_emit(c, NfaState::CharClass { chars: ranges, negated: true, next: 0 }))
        },
        Some('n') => {
            compiler_advance(c)
            Ok(compiler_emit(c, NfaState::Char { c: '\n', next: 0 }))
        },
        Some('r') => {
            compiler_advance(c)
            Ok(compiler_emit(c, NfaState::Char { c: '\r', next: 0 }))
        },
        Some('t') => {
            compiler_advance(c)
            Ok(compiler_emit(c, NfaState::Char { c: '\t', next: 0 }))
        },
        Some(ch) => {
            // Escaped literal: \., \\, etc.
            compiler_advance(c)
            Ok(compiler_emit(c, NfaState::Char { c: ch, next: 0 }))
        },
    }
}

// Parse group: (expr)
fn compiler_parse_group(c: &!RegexCompiler) -> Result<usize, RegexError> with Alloc {
    compiler_advance(c)  // consume '('

    let group_num = c.num_groups
    c.num_groups = c.num_groups + 1

    let start_idx = compiler_emit(c, NfaState::GroupStart { group: group_num, next: 0 })

    let inner = compiler_parse_expr(c)?

    if compiler_peek(c) != Some(')') {
        return Err(RegexError::UnbalancedParen { pos: c.pos })
    }
    compiler_advance(c)

    let end_idx = compiler_emit(c, NfaState::GroupEnd { group: group_num, next: 0 })

    // Link: start -> inner -> end
    compiler_patch_single(c, start_idx, inner)
    compiler_patch(c, inner, end_idx)

    Ok(start_idx)
}

// Parse character class: [abc], [a-z], [^abc]
fn compiler_parse_char_class(c: &!RegexCompiler) -> Result<usize, RegexError> with Alloc {
    compiler_advance(c)  // consume '['

    var negated = false
    if compiler_peek(c) == Some('^') {
        negated = true
        compiler_advance(c)
    }

    var ranges = vec_new::<CharRange>()

    while compiler_peek(c).is_some() && compiler_peek(c) != Some(']') {
        let ch = compiler_advance(c).unwrap()

        if ch == '\\' {
            // Escape in char class
            if compiler_peek(c).is_none() {
                return Err(RegexError::InvalidCharClass { pos: c.pos })
            }
            let escaped = compiler_advance(c).unwrap()
            let actual_char = match escaped {
                'n' => '\n',
                'r' => '\r',
                't' => '\t',
                _ => escaped,
            }
            vec_push(&!ranges, CharRange { start: actual_char, end: actual_char })
        } else if compiler_peek(c) == Some('-') && compiler_peek_at(c, 1) != Some(']') {
            // Range: a-z
            compiler_advance(c)  // consume '-'
            if compiler_peek(c).is_none() {
                return Err(RegexError::InvalidCharClass { pos: c.pos })
            }
            let end_ch = compiler_advance(c).unwrap()
            vec_push(&!ranges, CharRange { start: ch, end: end_ch })
        } else {
            vec_push(&!ranges, CharRange { start: ch, end: ch })
        }
    }

    if compiler_peek(c) != Some(']') {
        return Err(RegexError::InvalidCharClass { pos: c.pos })
    }
    compiler_advance(c)

    Ok(compiler_emit(c, NfaState::CharClass { chars: ranges, negated: negated, next: 0 }))
}

fn compiler_peek_at(c: &RegexCompiler, offset: usize) -> Option<char> {
    let pos = c.pos + offset
    if pos >= c.pattern.len() {
        None
    } else {
        Some(c.pattern.char_at(pos))
    }
}

// Patch all dangling next pointers in a fragment to point to target
fn compiler_patch(c: &!RegexCompiler, start: usize, target: usize) {
    var visited = vec_new::<bool>()
    vec_resize(&!visited, vec_len(&c.states), false)

    var stack = vec_new::<usize>()
    vec_push(&!stack, start)

    while vec_len(&stack) > 0 {
        let idx = vec_pop(&!stack)
        if idx >= vec_len(&c.states) || visited[idx] {
            continue
        }
        visited[idx] = true

        match &c.states[idx] {
            NfaState::Char { next, .. } => {
                if *next == 0 && idx != target {
                    c.states[idx] = match &c.states[idx] {
                        NfaState::Char { c: ch, .. } => NfaState::Char { c: *ch, next: target },
                        _ => c.states[idx],
                    }
                } else if *next != 0 {
                    vec_push(&!stack, *next)
                }
            },
            NfaState::CharClass { next, .. } => {
                if *next == 0 && idx != target {
                    c.states[idx] = match &c.states[idx] {
                        NfaState::CharClass { chars, negated, .. } =>
                            NfaState::CharClass { chars: chars.clone(), negated: *negated, next: target },
                        _ => c.states[idx],
                    }
                } else if *next != 0 {
                    vec_push(&!stack, *next)
                }
            },
            NfaState::Any { next } => {
                if *next == 0 && idx != target {
                    c.states[idx] = NfaState::Any { next: target }
                } else if *next != 0 {
                    vec_push(&!stack, *next)
                }
            },
            NfaState::Split { next1, next2 } => {
                vec_push(&!stack, *next1)
                vec_push(&!stack, *next2)
            },
            NfaState::GroupStart { next, .. } => {
                if *next == 0 && idx != target {
                    c.states[idx] = match &c.states[idx] {
                        NfaState::GroupStart { group, .. } =>
                            NfaState::GroupStart { group: *group, next: target },
                        _ => c.states[idx],
                    }
                } else if *next != 0 {
                    vec_push(&!stack, *next)
                }
            },
            NfaState::GroupEnd { next, .. } => {
                if *next == 0 && idx != target {
                    c.states[idx] = match &c.states[idx] {
                        NfaState::GroupEnd { group, .. } =>
                            NfaState::GroupEnd { group: *group, next: target },
                        _ => c.states[idx],
                    }
                } else if *next != 0 {
                    vec_push(&!stack, *next)
                }
            },
            NfaState::AnchorStart { next } => {
                if *next == 0 && idx != target {
                    c.states[idx] = NfaState::AnchorStart { next: target }
                } else if *next != 0 {
                    vec_push(&!stack, *next)
                }
            },
            NfaState::AnchorEnd { next } => {
                if *next == 0 && idx != target {
                    c.states[idx] = NfaState::AnchorEnd { next: target }
                } else if *next != 0 {
                    vec_push(&!stack, *next)
                }
            },
            NfaState::Accept => {},
        }
    }
}

fn compiler_patch_single(c: &!RegexCompiler, idx: usize, target: usize) {
    c.states[idx] = match &c.states[idx] {
        NfaState::Char { c: ch, .. } => NfaState::Char { c: *ch, next: target },
        NfaState::CharClass { chars, negated, .. } =>
            NfaState::CharClass { chars: chars.clone(), negated: *negated, next: target },
        NfaState::Any { .. } => NfaState::Any { next: target },
        NfaState::Split { next1, next2 } => NfaState::Split { next1: *next1, next2: *next2 },
        NfaState::GroupStart { group, .. } => NfaState::GroupStart { group: *group, next: target },
        NfaState::GroupEnd { group, .. } => NfaState::GroupEnd { group: *group, next: target },
        NfaState::AnchorStart { .. } => NfaState::AnchorStart { next: target },
        NfaState::AnchorEnd { .. } => NfaState::AnchorEnd { next: target },
        NfaState::Accept => NfaState::Accept,
    }
}

// ============================================================================
// Matching
// ============================================================================

// Check if the regex matches anywhere in the input.
pub fn regex_is_match(re: &Regex, input: &str) -> bool with Alloc {
    regex_find(re, input).is_some()
}

// Find the first match in the input.
pub fn regex_find(re: &Regex, input: &str) -> Option<Match> with Alloc {
    var start_pos = 0
    while start_pos <= input.len() {
        match try_match_at(re, input, start_pos) {
            Some(m) => return Some(m),
            None => start_pos = start_pos + 1,
        }
    }
    None
}

// Find all non-overlapping matches in the input.
pub fn regex_find_all(re: &Regex, input: &str) -> Vec<Match> with Alloc {
    var matches = vec_new::<Match>()
    var pos = 0

    while pos <= input.len() {
        match try_match_at(re, input, pos) {
            Some(m) => {
                let next_pos = if m.end > pos { m.end } else { pos + 1 }
                vec_push(&!matches, m)
                pos = next_pos
            },
            None => pos = pos + 1,
        }
    }

    matches
}

// Get capture groups from the first match.
pub fn regex_captures(re: &Regex, input: &str) -> Option<Match> with Alloc {
    regex_find(re, input)
}

// Replace the first match with a replacement string.
pub fn regex_replace(re: &Regex, input: &str, replacement: &str) -> String with Alloc {
    match regex_find(re, input) {
        None => string_from(input),
        Some(m) => {
            var result = string_new()
            string_push_str(&!result, &input[..m.start])
            string_push_str(&!result, replacement)
            string_push_str(&!result, &input[m.end..])
            result
        },
    }
}

// Replace all matches with a replacement string.
pub fn regex_replace_all(re: &Regex, input: &str, replacement: &str) -> String with Alloc {
    let matches = regex_find_all(re, input)

    if vec_len(&matches) == 0 {
        return string_from(input)
    }

    var result = string_new()
    var last_end = 0

    for m in &matches {
        string_push_str(&!result, &input[last_end..m.start])
        string_push_str(&!result, replacement)
        last_end = m.end
    }

    string_push_str(&!result, &input[last_end..])
    result
}

// Split input by regex matches.
pub fn regex_split(re: &Regex, input: &str) -> Vec<String> with Alloc {
    let matches = regex_find_all(re, input)

    var parts = vec_new::<String>()
    var last_end = 0

    for m in &matches {
        vec_push(&!parts, string_from(&input[last_end..m.start]))
        last_end = m.end
    }

    vec_push(&!parts, string_from(&input[last_end..]))
    parts
}

// NFA simulation state
struct NfaThread {
    state: usize,
    groups: Vec<Option<Span>>,
}

// Try to match at a specific position
fn try_match_at(re: &Regex, input: &str, start: usize) -> Option<Match> with Alloc {
    var current = vec_new::<NfaThread>()
    var next = vec_new::<NfaThread>()

    // Initialize with start state
    var initial_groups = vec_new::<Option<Span>>()
    vec_resize(&!initial_groups, re.num_groups + 1, None)
    // Group 0 starts at current position
    initial_groups[0] = Some(Span { start: start, end: start })

    add_state(re, &!current, re.start, input, start, initial_groups)

    var pos = start
    var last_match: Option<Match> = None

    while pos <= input.len() {
        if vec_len(&current) == 0 {
            break
        }

        let ch = if pos < input.len() {
            Some(input.char_at(pos))
        } else {
            None
        }

        // Process all current threads
        for thread in &current {
            match &re.states[thread.state] {
                NfaState::Accept => {
                    // Record match
                    var groups = thread.groups.clone()
                    groups[0] = Some(Span { start: start, end: pos })
                    last_match = Some(Match {
                        start: start,
                        end: pos,
                        groups: groups,
                    })
                },
                NfaState::Char { c, next: next_state } => {
                    if ch == Some(*c) {
                        add_state(re, &!next, *next_state, input, pos + 1, thread.groups.clone())
                    }
                },
                NfaState::CharClass { chars, negated, next: next_state } => {
                    if let Some(c) = ch {
                        var in_class = false
                        for range in chars {
                            if c >= range.start && c <= range.end {
                                in_class = true
                                break
                            }
                        }

                        if in_class != *negated {
                            add_state(re, &!next, *next_state, input, pos + 1, thread.groups.clone())
                        }
                    }
                },
                NfaState::Any { next: next_state } => {
                    if let Some(c) = ch {
                        if c != '\n' {
                            add_state(re, &!next, *next_state, input, pos + 1, thread.groups.clone())
                        }
                    }
                },
                _ => {
                    // Split, anchors, etc. handled by add_state epsilon closure
                },
            }
        }

        // Swap current and next
        var tmp = current
        current = next
        next = tmp
        vec_clear(&!next)

        pos = pos + 1
    }

    last_match
}

// Add state with epsilon closure
fn add_state(
    re: &Regex,
    threads: &!Vec<NfaThread>,
    state: usize,
    input: &str,
    pos: usize,
    groups: Vec<Option<Span>>
) with Alloc {
    // Check if state already in threads (avoid duplicates)
    for t in &*threads {
        if t.state == state {
            return
        }
    }

    match &re.states[state] {
        NfaState::Split { next1, next2 } => {
            add_state(re, threads, *next1, input, pos, groups.clone())
            add_state(re, threads, *next2, input, pos, groups)
        },
        NfaState::GroupStart { group, next } => {
            var new_groups = groups.clone()
            new_groups[*group] = Some(Span { start: pos, end: pos })
            add_state(re, threads, *next, input, pos, new_groups)
        },
        NfaState::GroupEnd { group, next } => {
            var new_groups = groups.clone()
            if let Some(span) = &new_groups[*group] {
                new_groups[*group] = Some(Span { start: span.start, end: pos })
            }
            add_state(re, threads, *next, input, pos, new_groups)
        },
        NfaState::AnchorStart { next } => {
            if pos == 0 {
                add_state(re, threads, *next, input, pos, groups)
            }
        },
        NfaState::AnchorEnd { next } => {
            if pos == input.len() {
                add_state(re, threads, *next, input, pos, groups)
            }
        },
        _ => {
            vec_push(threads, NfaThread { state: state, groups: groups })
        },
    }
}

// ============================================================================
// Utilities
// ============================================================================

// Get the matched substring from a Match.
pub fn match_str<'a>(m: &Match, input: &'a str) -> &'a str {
    &input[m.start..m.end]
}

// Get a capture group's substring from a Match.
pub fn match_group<'a>(m: &Match, group: usize, input: &'a str) -> Option<&'a str> {
    if group >= vec_len(&m.groups) {
        return None
    }

    match &m.groups[group] {
        Some(span) => Some(&input[span.start..span.end]),
        None => None,
    }
}

// Escape special regex characters in a string.
pub fn regex_escape(s: &str) -> String with Alloc {
    let special = "\\^$.|?*+()[]{}"
    var result = string_new()

    for ch in s.chars() {
        if special.contains(ch) {
            string_push(&!result, '\\')
        }
        string_push(&!result, ch)
    }

    result
}

// Create a regex that matches a literal string.
pub fn regex_literal(s: &str) -> Result<Regex, RegexError> with Alloc {
    let escaped = regex_escape(s)
    regex_compile(&escaped)
}
