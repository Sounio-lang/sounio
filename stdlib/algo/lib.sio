//! stdlib/algo - Algorithms Module
//!
//! Classic algorithms for sorting, searching, and graph operations.
//!
//! # Submodules
//! - `sort` - Sorting algorithms (quicksort, mergesort, heapsort, radix)
//! - `graph` - Graph algorithms (Dijkstra, A*, DFS, topological sort)
//!
//! # Examples
//! ```sio
//! // Sorting
//! var arr = [5, 2, 8, 1, 9]
//! quicksort_i64(&!arr, 5)
//! // arr is now [1, 2, 5, 8, 9]
//!
//! // Graph shortest path
//! let result = dijkstra(&adj, 6, 0)
//! print("Distance to node 3: " ++ result.distances[3].to_string())
//! ```


// Submodules are resolved by path (`use algo::<name>`);
// Sounio has no `mod` item, so the declarations that stood here were
// inert Rust syntax that also stopped this file parsing. Covered:
//   sort, graph
