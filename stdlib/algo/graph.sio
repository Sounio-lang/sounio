//! Graph Algorithms
//!
//! Classical graph algorithms for traversal and shortest paths.
//!
//! # Algorithms
//! - DFS: Depth-first search
//! - BFS: Breadth-first search
//! - Dijkstra: Single-source shortest paths (non-negative weights)
//! - Bellman-Ford: Single-source shortest paths (allows negative weights)
//! - Topological Sort: Linear ordering of DAG vertices
//! - A*: Heuristic-guided shortest path
//!
//! # Graph Representation
//! Graphs are represented as adjacency lists using `Vec<Vec<Edge>>` where
//! each outer index is a node and contains a list of outgoing edges.

// =============================================================================
// Types
// =============================================================================

/// A weighted directed edge.
pub struct Edge {
    to: usize,
    weight: f64,
}

impl Edge {
    /// Create a new edge.
    pub fn new(to: usize, weight: f64) -> Edge {
        Edge { to, weight }
    }

    /// Create an unweighted edge (weight = 1).
    pub fn unweighted(to: usize) -> Edge {
        Edge { to, weight: 1.0 }
    }
}

/// Result of Dijkstra's algorithm.
pub struct DijkstraResult {
    /// Distance from source to each node. f64::INFINITY if unreachable.
    distances: Vec<f64>,
    /// Parent of each node in the shortest path tree. -1 if no parent.
    parents: Vec<i64>,
    /// The source node.
    source: usize,
}

impl DijkstraResult {
    /// Get distance to a node.
    pub fn distance(self: &DijkstraResult, node: usize) -> f64 {
        self.distances[node]
    }

    /// Check if a node is reachable.
    pub fn is_reachable(self: &DijkstraResult, node: usize) -> bool {
        self.distances[node] < INFINITY
    }

    /// Reconstruct the path from source to target.
    pub fn path_to(self: &DijkstraResult, target: usize) -> Vec<usize> with Alloc {
        var path = Vec::new()

        if !self.is_reachable(target) {
            return path
        }

        var current = target as i64
        while current != -1 {
            path.push(current as usize)
            current = self.parents[current as usize]
        }

        // Reverse to get source-to-target order
        reverse_usize(&!path)
        path
    }
}

/// Result of A* algorithm.
pub struct AStarResult {
    /// The path from source to target.
    path: Vec<usize>,
    /// Total cost of the path.
    cost: f64,
    /// Number of nodes visited during search.
    nodes_visited: usize,
    /// Whether a path was found.
    found: bool,
}

/// Result of DFS.
pub struct DfsResult {
    /// Order in which nodes were visited.
    visit_order: Vec<usize>,
    /// Discovery time for each node.
    discovery: Vec<i64>,
    /// Finish time for each node.
    finish: Vec<i64>,
    /// Parent in DFS tree (-1 if root or not visited).
    parents: Vec<i64>,
}

/// Result of BFS.
pub struct BfsResult {
    /// Distance from source to each node (-1 if unreachable).
    distances: Vec<i64>,
    /// Parent in BFS tree (-1 if root or not visited).
    parents: Vec<i64>,
    /// Order in which nodes were visited.
    visit_order: Vec<usize>,
}

// Infinity constant
const INFINITY: f64 = 1.0e308

// =============================================================================
// Depth-First Search
// =============================================================================

/// Depth-first search from a source node.
///
/// Returns discovery times, finish times, and parent pointers.
pub fn dfs(adj: &[Vec<Edge>], n: usize, source: usize) -> DfsResult with Alloc {
    var discovery = Vec::with_capacity(n)
    var finish = Vec::with_capacity(n)
    var parents = Vec::with_capacity(n)
    var visited = Vec::with_capacity(n)
    var visit_order = Vec::new()

    var i: usize = 0
    while i < n {
        discovery.push(-1)
        finish.push(-1)
        parents.push(-1)
        visited.push(false)
        i = i + 1
    }

    var time: i64 = 0
    dfs_visit(adj, source, &!discovery, &!finish, &!parents, &!visited, &!visit_order, &!time)

    DfsResult { visit_order, discovery, finish, parents }
}

fn dfs_visit(
    adj: &[Vec<Edge>],
    u: usize,
    discovery: &!Vec<i64>,
    finish: &!Vec<i64>,
    parents: &!Vec<i64>,
    visited: &!Vec<bool>,
    visit_order: &!Vec<usize>,
    time: &!i64
) {
    visited[u] = true
    *time = *time + 1
    discovery[u] = *time
    visit_order.push(u)

    var i: usize = 0
    while i < adj[u].len() {
        let v = adj[u][i].to
        if !visited[v] {
            parents[v] = u as i64
            dfs_visit(adj, v, discovery, finish, parents, visited, visit_order, time)
        }
        i = i + 1
    }

    *time = *time + 1
    finish[u] = *time
}

/// Full DFS visiting all components.
pub fn dfs_full(adj: &[Vec<Edge>], n: usize) -> DfsResult with Alloc {
    var discovery = Vec::with_capacity(n)
    var finish = Vec::with_capacity(n)
    var parents = Vec::with_capacity(n)
    var visited = Vec::with_capacity(n)
    var visit_order = Vec::new()

    var i: usize = 0
    while i < n {
        discovery.push(-1)
        finish.push(-1)
        parents.push(-1)
        visited.push(false)
        i = i + 1
    }

    var time: i64 = 0
    i = 0
    while i < n {
        if !visited[i] {
            dfs_visit(adj, i, &!discovery, &!finish, &!parents, &!visited, &!visit_order, &!time)
        }
        i = i + 1
    }

    DfsResult { visit_order, discovery, finish, parents }
}

// =============================================================================
// Breadth-First Search
// =============================================================================

/// Breadth-first search from a source node.
pub fn bfs(adj: &[Vec<Edge>], n: usize, source: usize) -> BfsResult with Alloc {
    var distances = Vec::with_capacity(n)
    var parents = Vec::with_capacity(n)
    var visit_order = Vec::new()

    var i: usize = 0
    while i < n {
        distances.push(-1)
        parents.push(-1)
        i = i + 1
    }

    // Simple queue using Vec with head pointer
    var queue = Vec::new()
    var head: usize = 0

    distances[source] = 0
    queue.push(source)

    while head < queue.len() {
        let u = queue[head]
        head = head + 1
        visit_order.push(u)

        i = 0
        while i < adj[u].len() {
            let v = adj[u][i].to
            if distances[v] == -1 {
                distances[v] = distances[u] + 1
                parents[v] = u as i64
                queue.push(v)
            }
            i = i + 1
        }
    }

    BfsResult { distances, parents, visit_order }
}

// =============================================================================
// Dijkstra's Algorithm
// =============================================================================

/// Dijkstra's algorithm for single-source shortest paths.
///
/// Works only with non-negative edge weights.
/// Time complexity: O((V + E) log V) with binary heap.
pub fn dijkstra(adj: &[Vec<Edge>], n: usize, source: usize) -> DijkstraResult with Alloc {
    var distances = Vec::with_capacity(n)
    var parents = Vec::with_capacity(n)
    var visited = Vec::with_capacity(n)

    var i: usize = 0
    while i < n {
        distances.push(INFINITY)
        parents.push(-1)
        visited.push(false)
        i = i + 1
    }

    distances[source] = 0.0

    // Simple priority queue using linear scan
    // (For production, use a proper binary heap)
    var remaining = n

    while remaining > 0 {
        // Find unvisited node with minimum distance
        var min_dist = INFINITY
        var min_node: i64 = -1

        i = 0
        while i < n {
            if !visited[i] && distances[i] < min_dist {
                min_dist = distances[i]
                min_node = i as i64
            }
            i = i + 1
        }

        if min_node == -1 {
            break  // No more reachable nodes
        }

        let u = min_node as usize
        visited[u] = true
        remaining = remaining - 1

        // Relax edges
        i = 0
        while i < adj[u].len() {
            let edge = &adj[u][i]
            let v = edge.to
            let new_dist = distances[u] + edge.weight

            if new_dist < distances[v] {
                distances[v] = new_dist
                parents[v] = u as i64
            }
            i = i + 1
        }
    }

    DijkstraResult { distances, parents, source }
}

// =============================================================================
// Bellman-Ford Algorithm
// =============================================================================

/// Result of Bellman-Ford algorithm.
pub struct BellmanFordResult {
    distances: Vec<f64>,
    parents: Vec<i64>,
    has_negative_cycle: bool,
}

/// Bellman-Ford algorithm for single-source shortest paths.
///
/// Handles negative edge weights and detects negative cycles.
/// Time complexity: O(VE)
pub fn bellman_ford(adj: &[Vec<Edge>], n: usize, source: usize) -> BellmanFordResult with Alloc {
    var distances = Vec::with_capacity(n)
    var parents = Vec::with_capacity(n)

    var i: usize = 0
    while i < n {
        distances.push(INFINITY)
        parents.push(-1)
        i = i + 1
    }

    distances[source] = 0.0

    // Relax all edges (V-1) times
    var iter: usize = 0
    while iter < n - 1 {
        var changed = false

        var u: usize = 0
        while u < n {
            if distances[u] < INFINITY {
                var j: usize = 0
                while j < adj[u].len() {
                    let edge = &adj[u][j]
                    let v = edge.to
                    let new_dist = distances[u] + edge.weight

                    if new_dist < distances[v] {
                        distances[v] = new_dist
                        parents[v] = u as i64
                        changed = true
                    }
                    j = j + 1
                }
            }
            u = u + 1
        }

        if !changed {
            break  // Early termination
        }

        iter = iter + 1
    }

    // Check for negative cycles
    var has_negative_cycle = false
    var u: usize = 0
    while u < n {
        if distances[u] < INFINITY {
            var j: usize = 0
            while j < adj[u].len() {
                let edge = &adj[u][j]
                let v = edge.to
                if distances[u] + edge.weight < distances[v] {
                    has_negative_cycle = true
                    break
                }
                j = j + 1
            }
        }
        if has_negative_cycle {
            break
        }
        u = u + 1
    }

    BellmanFordResult { distances, parents, has_negative_cycle }
}

// =============================================================================
// Topological Sort
// =============================================================================

/// Topological sort of a directed acyclic graph.
///
/// Returns None if the graph has a cycle.
pub fn topological_sort(adj: &[Vec<Edge>], n: usize) -> Option<Vec<usize>> with Alloc {
    // Compute in-degrees
    var in_degree = Vec::with_capacity(n)
    var i: usize = 0
    while i < n {
        in_degree.push(0)
        i = i + 1
    }

    i = 0
    while i < n {
        var j: usize = 0
        while j < adj[i].len() {
            let v = adj[i][j].to
            in_degree[v] = in_degree[v] + 1
            j = j + 1
        }
        i = i + 1
    }

    // Initialize queue with nodes having in-degree 0
    var queue = Vec::new()
    var head: usize = 0

    i = 0
    while i < n {
        if in_degree[i] == 0 {
            queue.push(i)
        }
        i = i + 1
    }

    var result = Vec::new()

    while head < queue.len() {
        let u = queue[head]
        head = head + 1
        result.push(u)

        var j: usize = 0
        while j < adj[u].len() {
            let v = adj[u][j].to
            in_degree[v] = in_degree[v] - 1
            if in_degree[v] == 0 {
                queue.push(v)
            }
            j = j + 1
        }
    }

    // Check if all nodes were processed
    if result.len() == n {
        Some(result)
    } else {
        None  // Graph has a cycle
    }
}

// =============================================================================
// A* Algorithm
// =============================================================================

/// A* algorithm for shortest path with heuristic.
///
/// The heuristic function h(n) should be admissible (never overestimate).
pub fn astar(
    adj: &[Vec<Edge>],
    n: usize,
    source: usize,
    target: usize,
    heuristic: &[f64]  // Pre-computed heuristic values to target
) -> AStarResult with Alloc {
    var g_score = Vec::with_capacity(n)
    var f_score = Vec::with_capacity(n)
    var parents = Vec::with_capacity(n)
    var in_open = Vec::with_capacity(n)
    var closed = Vec::with_capacity(n)

    var i: usize = 0
    while i < n {
        g_score.push(INFINITY)
        f_score.push(INFINITY)
        parents.push(-1)
        in_open.push(false)
        closed.push(false)
        i = i + 1
    }

    g_score[source] = 0.0
    f_score[source] = heuristic[source]
    in_open[source] = true

    var nodes_visited: usize = 0

    while true {
        // Find node in open set with lowest f_score
        var best_f = INFINITY
        var current: i64 = -1

        i = 0
        while i < n {
            if in_open[i] && f_score[i] < best_f {
                best_f = f_score[i]
                current = i as i64
            }
            i = i + 1
        }

        if current == -1 {
            // No path found
            return AStarResult {
                path: Vec::new(),
                cost: INFINITY,
                nodes_visited,
                found: false,
            }
        }

        let u = current as usize
        nodes_visited = nodes_visited + 1

        if u == target {
            // Reconstruct path
            var path = Vec::new()
            var node = target as i64
            while node != -1 {
                path.push(node as usize)
                node = parents[node as usize]
            }
            reverse_usize(&!path)

            return AStarResult {
                path,
                cost: g_score[target],
                nodes_visited,
                found: true,
            }
        }

        in_open[u] = false
        closed[u] = true

        // Explore neighbors
        i = 0
        while i < adj[u].len() {
            let edge = &adj[u][i]
            let v = edge.to

            if closed[v] {
                i = i + 1
                continue
            }

            let tentative_g = g_score[u] + edge.weight

            if tentative_g < g_score[v] {
                parents[v] = u as i64
                g_score[v] = tentative_g
                f_score[v] = g_score[v] + heuristic[v]

                if !in_open[v] {
                    in_open[v] = true
                }
            }

            i = i + 1
        }
    }

    // Unreachable
    AStarResult {
        path: Vec::new(),
        cost: INFINITY,
        nodes_visited,
        found: false,
    }
}

// =============================================================================
// Utility Functions
// =============================================================================

fn reverse_usize(arr: &!Vec<usize>) {
    let len = arr.len()
    if len <= 1 {
        return
    }

    var left: usize = 0
    var right = len - 1

    while left < right {
        let temp = arr[left]
        arr[left] = arr[right]
        arr[right] = temp
        left = left + 1
        right = right - 1
    }
}

// =============================================================================
// Tests
// =============================================================================

fn test_dijkstra() -> bool {
    // Simple graph: 0 -> 1 (1) -> 2 (2) -> 3 (3)
    //               0 -> 3 (10)
    var adj: Vec<Vec<Edge>> = Vec::new()

    // Node 0
    var edges0 = Vec::new()
    edges0.push(Edge::new(1, 1.0))
    edges0.push(Edge::new(3, 10.0))
    adj.push(edges0)

    // Node 1
    var edges1 = Vec::new()
    edges1.push(Edge::new(2, 2.0))
    adj.push(edges1)

    // Node 2
    var edges2 = Vec::new()
    edges2.push(Edge::new(3, 3.0))
    adj.push(edges2)

    // Node 3 (no outgoing)
    adj.push(Vec::new())

    let result = dijkstra(&adj, 4, 0)

    // Distance to 3 should be 6 (0->1->2->3), not 10 (0->3)
    if result.distances[3] > 6.5 || result.distances[3] < 5.5 { return false }

    true
}

fn test_bfs() -> bool {
    var adj: Vec<Vec<Edge>> = Vec::new()

    // Simple chain: 0 -> 1 -> 2
    var e0 = Vec::new()
    e0.push(Edge::unweighted(1))
    adj.push(e0)

    var e1 = Vec::new()
    e1.push(Edge::unweighted(2))
    adj.push(e1)

    adj.push(Vec::new())

    let result = bfs(&adj, 3, 0)

    if result.distances[0] != 0 { return false }
    if result.distances[1] != 1 { return false }
    if result.distances[2] != 2 { return false }

    true
}

fn test_topological_sort() -> bool {
    // DAG: 0 -> 1 -> 3
    //      0 -> 2 -> 3
    var adj: Vec<Vec<Edge>> = Vec::new()

    var e0 = Vec::new()
    e0.push(Edge::unweighted(1))
    e0.push(Edge::unweighted(2))
    adj.push(e0)

    var e1 = Vec::new()
    e1.push(Edge::unweighted(3))
    adj.push(e1)

    var e2 = Vec::new()
    e2.push(Edge::unweighted(3))
    adj.push(e2)

    adj.push(Vec::new())

    match topological_sort(&adj, 4) {
        Some(order) => {
            // 0 must come before 1, 2
            // 1, 2 must come before 3
            if order.len() != 4 { return false }
            if order[0] != 0 { return false }
            if order[3] != 3 { return false }
            true
        },
        None => false,
    }
}

pub fn run_tests() -> bool {
    test_dijkstra() &&
    test_bfs() &&
    test_topological_sort()
}
