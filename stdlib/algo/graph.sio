//! Graph Algorithms
//!
//! Classic graph algorithms for directed and undirected graphs represented
//! as adjacency lists. All algorithms use fixed-size arrays for simplicity.
//!
//! # Representation
//! - Graphs are represented as adjacency lists (array of arrays)
//! - Max 100 nodes for simplicity
//! - For weighted graphs, use adjacency matrix
//!
//! # Algorithms
//! - dijkstra: Shortest paths from source (weighted graphs)
//! - dfs: Depth-first search traversal
//! - bfs: Breadth-first search traversal
//! - topological_sort: Topological ordering (DAGs)
//! - has_cycle: Cycle detection
//!
//! # Usage
//! ```sio
//! // Create adjacency list for graph with 5 nodes
//! var adj = [[0; 10]; 100]
//! adj[0][0] = 1  // edge 0 -> 1
//! adj[0][1] = 2  // edge 0 -> 2
//!
//! let visited = dfs(&adj, 5, 0)
//! ```

// Helper: Find minimum distance node not yet visited
fn find_min_unvisited(dist: &[f64; 100], visited: &[bool; 100], n: usize) -> usize with Panic, Div, Mut {
    var min_dist = 1e100
    var min_idx = 0

    var i = 0
    while i < n {
        if !visited[i] && dist[i] < min_dist {
            min_dist = dist[i]
            min_idx = i
        }
        i = i + 1
    }

    return min_idx
}

// Dijkstra's shortest path algorithm
//
// Computes shortest paths from source to all other nodes in a weighted graph.
// Uses adjacency matrix where adj[i][j] is the weight of edge i -> j.
// Returns array of distances from source to each node.
//
// Arguments:
// - adj: Adjacency matrix (adj[i][j] = weight of edge i->j, or -1 if no edge)
// - n: Number of nodes
// - source: Starting node
//
// Returns: Array of shortest distances from source to each node (INF if unreachable)
pub fn dijkstra(adj: &[[f64; 100]; 100], n: usize, source: usize) -> [f64; 100] with Panic, Div, Mut {
    var dist = [1e100; 100]
    var visited = [false; 100]

    dist[source] = 0.0

    var count = 0
    while count < n {
        let u = find_min_unvisited(&dist, &visited, n)
        visited[u] = true

        // Update distances to neighbors
        var v = 0
        while v < n {
            if !visited[v] && adj[u][v] >= 0.0 {
                let new_dist = dist[u] + adj[u][v]
                if new_dist < dist[v] {
                    dist[v] = new_dist
                }
            }
            v = v + 1
        }

        count = count + 1
    }

    return dist
}

// Depth-first search traversal
//
// Performs DFS starting from source node and returns nodes in visit order.
// Uses stack-based iterative approach (no recursion).
//
// Arguments:
// - adj: Adjacency list (adj[i] contains neighbors of node i, -1 terminated)
// - n: Number of nodes
// - source: Starting node
//
// Returns: Array of nodes in DFS visit order (length encoded at index 0)
pub fn dfs(adj: &[[i32; 10]; 100], n: usize, source: usize) -> [i32; 100] with Panic, Div, Mut {
    var visited = [false; 100]
    var result = [-1; 100]
    var result_len = 0

    // Manual stack for DFS
    var stack = [-1; 100]
    var stack_top = 0

    // Push source
    stack[stack_top] = source as i32
    stack_top = stack_top + 1

    while stack_top > 0 {
        // Pop from stack
        stack_top = stack_top - 1
        let node = stack[stack_top]
        let u = node as usize

        if !visited[u] {
            visited[u] = true
            result[result_len] = node
            result_len = result_len + 1

            // Push unvisited neighbors (in reverse order for proper DFS)
            var j = 0
            while j < 10 {
                if adj[u][j] >= 0 {
                    let neighbor = adj[u][j] as usize
                    if !visited[neighbor] {
                        stack[stack_top] = adj[u][j]
                        stack_top = stack_top + 1
                    }
                } else {
                    break
                }
                j = j + 1
            }
        }
    }

    // Store length at index 0 (hack since we can't return dynamic size)
    var final_result = [-1; 100]
    final_result[0] = result_len as i32
    var k = 0
    while k < result_len {
        final_result[k + 1] = result[k]
        k = k + 1
    }

    return final_result
}

// Breadth-first search traversal
//
// Performs BFS starting from source node and returns nodes in visit order.
// Uses queue-based approach.
//
// Arguments:
// - adj: Adjacency list (adj[i] contains neighbors of node i, -1 terminated)
// - n: Number of nodes
// - source: Starting node
//
// Returns: Array of nodes in BFS visit order (length encoded at index 0)
pub fn bfs(adj: &[[i32; 10]; 100], n: usize, source: usize) -> [i32; 100] with Panic, Div, Mut {
    var visited = [false; 100]
    var result = [-1; 100]
    var result_len = 0

    // Manual queue for BFS
    var queue = [-1; 100]
    var queue_head = 0
    var queue_tail = 0

    // Enqueue source
    queue[queue_tail] = source as i32
    queue_tail = queue_tail + 1
    visited[source] = true

    while queue_head < queue_tail {
        // Dequeue
        let node = queue[queue_head]
        queue_head = queue_head + 1
        let u = node as usize

        result[result_len] = node
        result_len = result_len + 1

        // Enqueue unvisited neighbors
        var j = 0
        while j < 10 {
            if adj[u][j] >= 0 {
                let neighbor = adj[u][j] as usize
                if !visited[neighbor] {
                    visited[neighbor] = true
                    queue[queue_tail] = adj[u][j]
                    queue_tail = queue_tail + 1
                }
            } else {
                break
            }
            j = j + 1
        }
    }

    // Store length at index 0
    var final_result = [-1; 100]
    final_result[0] = result_len as i32
    var k = 0
    while k < result_len {
        final_result[k + 1] = result[k]
        k = k + 1
    }

    return final_result
}

// State struct for topological sort DFS traversal
// Used to consolidate mutable state into a single parameter
struct TopoState {
    visited: [bool; 100],
    rec_stack: [bool; 100],
    result: [i32; 100],
    result_pos: usize,
    has_cycle: bool
}

// Helper for topological sort: recursive DFS
// Uses state struct to avoid 4+ mutable ref parameter limitation
fn topo_dfs_visit(
    adj: &[[i32; 10]; 100],
    node: usize,
    state: &!TopoState
) with Panic, Div, Mut {
    if state.has_cycle {
        return
    }

    if state.rec_stack[node] {
        state.has_cycle = true
        return
    }

    if state.visited[node] {
        return
    }

    state.visited[node] = true
    state.rec_stack[node] = true

    // Visit all neighbors
    var j = 0
    while j < 10 {
        if adj[node][j] >= 0 {
            let neighbor = adj[node][j] as usize
            topo_dfs_visit(adj, neighbor, state)
        } else {
            break
        }
        j = j + 1
    }

    state.rec_stack[node] = false

    // Add to result (reverse postorder)
    state.result_pos = state.result_pos - 1
    state.result[state.result_pos] = node as i32
}

// Topological sort
//
// Computes topological ordering of a directed acyclic graph (DAG).
// Returns array of nodes in topological order, or all -1s if cycle detected.
//
// Arguments:
// - adj: Adjacency list (adj[i] contains neighbors of node i, -1 terminated)
// - n: Number of nodes
//
// Returns: Array of nodes in topological order (length at index 0), or [-2, ...] if cycle
pub fn topological_sort(adj: &[[i32; 10]; 100], n: usize) -> [i32; 100] with Panic, Div, Mut {
    var state = TopoState {
        visited: [false; 100],
        rec_stack: [false; 100],
        result: [-1; 100],
        result_pos: n,
        has_cycle: false
    }

    var i = 0
    while i < n {
        if !state.visited[i] {
            topo_dfs_visit(adj, i, &!state)
        }
        i = i + 1
    }

    if state.has_cycle {
        var cycle_result = [-2; 100]
        cycle_result[0] = -2  // Signal: cycle detected
        return cycle_result
    }

    // Shift result to start at index 1, put length at index 0
    var final_result = [-1; 100]
    final_result[0] = n as i32
    var k = 0
    while k < n {
        final_result[k + 1] = state.result[state.result_pos + k]
        k = k + 1
    }

    return final_result
}

// State struct for cycle detection DFS
struct CycleState {
    visited: [bool; 100],
    rec_stack: [bool; 100],
    has_cycle: bool
}

// Helper for cycle detection: DFS visit
fn cycle_dfs_visit(
    adj: &[[i32; 10]; 100],
    node: usize,
    state: &!CycleState
) with Panic, Div, Mut {
    if state.has_cycle {
        return
    }

    if state.rec_stack[node] {
        state.has_cycle = true
        return
    }

    if state.visited[node] {
        return
    }

    state.visited[node] = true
    state.rec_stack[node] = true

    // Visit all neighbors
    var j = 0
    while j < 10 {
        if adj[node][j] >= 0 {
            let neighbor = adj[node][j] as usize
            cycle_dfs_visit(adj, neighbor, state)
        } else {
            break
        }
        j = j + 1
    }

    state.rec_stack[node] = false
}

// Cycle detection
//
// Checks if the directed graph contains a cycle using DFS.
//
// Arguments:
// - adj: Adjacency list (adj[i] contains neighbors of node i, -1 terminated)
// - n: Number of nodes
//
// Returns: true if graph has a cycle, false otherwise
pub fn has_cycle(adj: &[[i32; 10]; 100], n: usize) -> bool with Panic, Div, Mut {
    var state = CycleState {
        visited: [false; 100],
        rec_stack: [false; 100],
        has_cycle: false
    }

    var i = 0
    while i < n {
        if !state.visited[i] {
            cycle_dfs_visit(adj, i, &!state)
        }
        i = i + 1
    }

    return state.has_cycle
}

// Tests

fn test_bfs_simple() -> bool with Panic, Div, Mut {
    // Graph: 0 -> 1 -> 2
    //        0 -> 3
    var adj = [[-1; 10]; 100]
    adj[0][0] = 1
    adj[0][1] = 3
    adj[1][0] = 2

    let result = bfs(&adj, 4, 0)
    let len = result[0]

    // Should visit: 0, 1, 3, 2 (BFS order)
    if len != 4 {
        return false
    }
    if result[1] != 0 {
        return false
    }
    if result[2] != 1 && result[2] != 3 {
        return false
    }

    return true
}

fn test_dfs_simple() -> bool with Panic, Div, Mut {
    // Graph: 0 -> 1 -> 2
    //        0 -> 3
    var adj = [[-1; 10]; 100]
    adj[0][0] = 1
    adj[0][1] = 3
    adj[1][0] = 2

    let result = dfs(&adj, 4, 0)
    let len = result[0]

    // Should visit all 4 nodes
    if len != 4 {
        return false
    }
    if result[1] != 0 {
        return false
    }

    return true
}

fn test_dijkstra_simple() -> bool with Panic, Div, Mut {
    // Graph: 0 --(1)-- 1 --(2)-- 2
    //        |                    |
    //       (4)                  (1)
    //        |                    |
    //        3 -------(1)--------
    var adj = [[-1.0; 100]; 100]

    // Initialize all to -1 (no edge)
    var i = 0
    while i < 100 {
        var j = 0
        while j < 100 {
            adj[i][j] = -1.0
            j = j + 1
        }
        i = i + 1
    }

    // Add edges
    adj[0][1] = 1.0
    adj[0][3] = 4.0
    adj[1][2] = 2.0
    adj[2][3] = 1.0
    adj[3][2] = 1.0  // Also reverse

    let dist = dijkstra(&adj, 4, 0)

    // Shortest paths from 0:
    // 0 -> 0: 0
    // 0 -> 1: 1
    // 0 -> 2: 3 (via 0->1->2)
    // 0 -> 3: 4

    if dist[0] != 0.0 {
        return false
    }
    if dist[1] != 1.0 {
        return false
    }
    if dist[2] != 3.0 {
        return false
    }
    if dist[3] != 4.0 {
        return false
    }

    return true
}

fn test_topological_sort_simple() -> bool with Panic, Div, Mut {
    // DAG: 0 -> 1 -> 3
    //      0 -> 2 -> 3
    var adj = [[-1; 10]; 100]
    adj[0][0] = 1
    adj[0][1] = 2
    adj[1][0] = 3
    adj[2][0] = 3

    let result = topological_sort(&adj, 4)
    let len = result[0]

    // Should not have cycle
    if len < 0 {
        return false
    }

    // Should have all 4 nodes
    if len != 4 {
        return false
    }

    // Node 0 should come before 1 and 2
    // Nodes 1 and 2 should come before 3
    var pos0 = 0
    var pos1 = 0
    var pos2 = 0
    var pos3 = 0

    let len_usize = len as usize
    var k = 1
    while k <= len_usize {
        if result[k] == 0 {
            pos0 = k
        }
        if result[k] == 1 {
            pos1 = k
        }
        if result[k] == 2 {
            pos2 = k
        }
        if result[k] == 3 {
            pos3 = k
        }
        k = k + 1
    }

    if pos0 >= pos1 || pos0 >= pos2 {
        return false
    }
    if pos1 >= pos3 || pos2 >= pos3 {
        return false
    }

    return true
}

fn test_has_cycle_no_cycle() -> bool with Panic, Div, Mut {
    // DAG: 0 -> 1 -> 2
    var adj = [[-1; 10]; 100]
    adj[0][0] = 1
    adj[1][0] = 2

    let result = has_cycle(&adj, 3)

    return !result  // Should NOT have cycle
}

fn test_has_cycle_with_cycle() -> bool with Panic, Div, Mut {
    // Graph with cycle: 0 -> 1 -> 2 -> 0
    var adj = [[-1; 10]; 100]
    adj[0][0] = 1
    adj[1][0] = 2
    adj[2][0] = 0  // Creates cycle

    let result = has_cycle(&adj, 3)

    return result  // Should have cycle
}

// Run all tests
pub fn graph_run_tests() -> bool with Panic, Div, Mut {
    if !test_bfs_simple() {
        return false
    }
    if !test_dfs_simple() {
        return false
    }
    if !test_dijkstra_simple() {
        return false
    }
    if !test_topological_sort_simple() {
        return false
    }
    if !test_has_cycle_no_cycle() {
        return false
    }
    if !test_has_cycle_with_cycle() {
        return false
    }

    return true
}
