//@ run-pass
//@ expect-stdout: ALL PASS

// stdlib/algo/sort.sio — Sorting algorithms
//
// Pure Sounio implementations for fixed-size i64 and f64 arrays:
//   - Insertion sort: stable, O(n^2), good for small arrays
//   - Heapsort: in-place, O(n log n) worst-case
//   - Quicksort-style via heapsort (avoids ownership issues with recursive &! reborrow)
//
// All arrays are fixed-size [T; 1024]. Pass actual length as n parameter.

// =============================================================================
// i64 sorting
// =============================================================================

// Insertion sort for i64 arrays. Stable, O(n^2).
fn insertion_sort_i64(arr: &![i64; 1024], n: i32) with Mut, Div, Panic {
    var i = 1
    while i < n {
        let key = arr[i]
        var j = i - 1
        while j >= 0 && arr[j] > key {
            arr[j + 1] = arr[j]
            j = j - 1
        }
        arr[j + 1] = key
        i = i + 1
    }
}

// Heapify subtree rooted at index root, heap size = size.
fn heapify_i64(arr: &![i64; 1024], size: i32, root: i32) with Mut, Div, Panic {
    var largest = root
    let left = 2 * root + 1
    let right = 2 * root + 2

    if left < size && arr[left] > arr[largest] {
        largest = left
    }
    if right < size && arr[right] > arr[largest] {
        largest = right
    }

    if largest != root {
        let temp = arr[root]
        arr[root] = arr[largest]
        arr[largest] = temp
        // Iterative sift-down to avoid recursive &! reborrow
        var pos = largest
        var done = false
        while !done {
            var big = pos
            let l = 2 * pos + 1
            let r = 2 * pos + 2
            if l < size && arr[l] > arr[big] { big = l }
            if r < size && arr[r] > arr[big] { big = r }
            if big != pos {
                let t = arr[pos]
                arr[pos] = arr[big]
                arr[big] = t
                pos = big
            } else {
                done = true
            }
        }
    }
}

// Heapsort for i64 arrays. In-place, O(n log n).
fn heapsort_i64(arr: &![i64; 1024], n: i32) with Mut, Div, Panic {
    if n <= 1 { return }

    // Build max heap
    var i = n / 2 - 1
    while i >= 0 {
        heapify_i64(arr, n, i)
        i = i - 1
    }

    // Extract elements
    var end = n - 1
    while end > 0 {
        let temp = arr[0]
        arr[0] = arr[end]
        arr[end] = temp
        heapify_i64(arr, end, 0)
        end = end - 1
    }
}

// Check if i64 array is sorted in ascending order.
fn is_sorted_i64(arr: &[i64; 1024], n: i32) -> bool with Mut, Div, Panic {
    if n <= 1 { return true }
    var i = 0
    while i < n - 1 {
        if arr[i] > arr[i + 1] { return false }
        i = i + 1
    }
    true
}

// =============================================================================
// f64 sorting
// =============================================================================

// Insertion sort for f64 arrays.
fn insertion_sort_f64(arr: &![f64; 1024], n: i32) with Mut, Div, Panic {
    var i = 1
    while i < n {
        let key = arr[i]
        var j = i - 1
        while j >= 0 && arr[j] > key {
            arr[j + 1] = arr[j]
            j = j - 1
        }
        arr[j + 1] = key
        i = i + 1
    }
}

// Heapsort for f64 arrays.
fn heapsort_f64(arr: &![f64; 1024], n: i32) with Mut, Div, Panic {
    if n <= 1 { return }

    // Build max heap (iterative sift-down)
    var i = n / 2 - 1
    while i >= 0 {
        // Sift down arr[i]
        var pos = i
        var done = false
        while !done {
            var big = pos
            let l = 2 * pos + 1
            let r = 2 * pos + 2
            if l < n && arr[l] > arr[big] { big = l }
            if r < n && arr[r] > arr[big] { big = r }
            if big != pos {
                let t = arr[pos]
                arr[pos] = arr[big]
                arr[big] = t
                pos = big
            } else {
                done = true
            }
        }
        i = i - 1
    }

    // Extract elements
    var end = n - 1
    while end > 0 {
        let temp = arr[0]
        arr[0] = arr[end]
        arr[end] = temp

        // Sift down arr[0] within heap of size end
        var pos = 0
        var done2 = false
        while !done2 {
            var big = pos
            let l = 2 * pos + 1
            let r = 2 * pos + 2
            if l < end && arr[l] > arr[big] { big = l }
            if r < end && arr[r] > arr[big] { big = r }
            if big != pos {
                let t = arr[pos]
                arr[pos] = arr[big]
                arr[big] = t
                pos = big
            } else {
                done2 = true
            }
        }
        end = end - 1
    }
}

// Check if f64 array is sorted in ascending order.
fn is_sorted_f64(arr: &[f64; 1024], n: i32) -> bool with Mut, Div, Panic {
    if n <= 1 { return true }
    var i = 0
    while i < n - 1 {
        if arr[i] > arr[i + 1] { return false }
        i = i + 1
    }
    true
}

// Compatibility aliases — delegate to heapsort (O(n log n), in-place).
fn quicksort_i64(arr: &![i64; 1024], n: i32) with Mut, Div, Panic {
    heapsort_i64(arr, n)
}

fn quicksort_f64(arr: &![f64; 1024], n: i32) with Mut, Div, Panic {
    heapsort_f64(arr, n)
}

fn mergesort_i64(arr: &![i64; 1024], n: i32) with Mut, Div, Panic {
    heapsort_i64(arr, n)
}

// =============================================================================
// Inline tests
// =============================================================================

var CNT: [i64; 2] = [0; 2]

fn chk(label: i64, ok: i64) with IO, Mut {
    if ok == 1 {
        print("  PASS ["); print(label); print("]\n")
        CNT[0] = CNT[0] + 1
    } else {
        print("  FAIL ["); print(label); print("]\n")
        CNT[1] = CNT[1] + 1
    }
}

fn check_sorted_i64(arr: &[i64; 1024], n: i32) -> i64 with Mut, Div, Panic {
    if n <= 1 { return 1 }
    var i: i32 = 0
    while i < n - 1 {
        if arr[i] > arr[i + 1] { return 0 }
        i = i + 1
    }
    1
}

fn check_sorted_f64(arr: &[f64; 1024], n: i32) -> i64 with Mut, Div, Panic {
    if n <= 1 { return 1 }
    var i: i32 = 0
    while i < n - 1 {
        if arr[i] > arr[i + 1] { return 0 }
        i = i + 1
    }
    1
}

fn test_insertion_sort() with IO, Mut, Div, Panic {
    var a: [i64; 1024] = [0; 1024]
    a[0]=5; a[1]=3; a[2]=8; a[3]=1; a[4]=9; a[5]=2; a[6]=7; a[7]=4
    insertion_sort_i64(&!a, 8)
    chk(1, check_sorted_i64(&a, 8))
    chk(2, if a[0] == 1 && a[7] == 9 { 1 } else { 0 })
}

fn test_heapsort_i64() with IO, Mut, Div, Panic {
    var a: [i64; 1024] = [0; 1024]
    a[0]=10; a[1]=4; a[2]=77; a[3]=22; a[4]=1; a[5]=55; a[6]=33; a[7]=6
    heapsort_i64(&!a, 8)
    chk(3, check_sorted_i64(&a, 8))
    chk(4, if a[0] == 1 && a[7] == 77 { 1 } else { 0 })
}

fn test_heapsort_f64() with IO, Mut, Div, Panic {
    var a: [f64; 1024] = [0.0; 1024]
    a[0]=3.14; a[1]=1.41; a[2]=2.72; a[3]=0.57; a[4]=1.73
    heapsort_f64(&!a, 5)
    chk(5, check_sorted_f64(&a, 5))
    chk(6, if a[0] < 0.6 && a[4] > 3.0 { 1 } else { 0 })
}

fn test_already_sorted() with IO, Mut, Div, Panic {
    var a: [i64; 1024] = [0; 1024]
    a[0]=1; a[1]=2; a[2]=3; a[3]=4; a[4]=5
    heapsort_i64(&!a, 5)
    chk(7, check_sorted_i64(&a, 5))
    chk(8, if a[0] == 1 && a[4] == 5 { 1 } else { 0 })
}

fn test_reverse_sorted() with IO, Mut, Div, Panic {
    var a: [i64; 1024] = [0; 1024]
    a[0]=9; a[1]=8; a[2]=7; a[3]=6; a[4]=5; a[5]=4; a[6]=3; a[7]=2; a[8]=1; a[9]=0
    heapsort_i64(&!a, 10)
    chk(9, check_sorted_i64(&a, 10))
    chk(10, if a[0] == 0 && a[9] == 9 { 1 } else { 0 })
}

fn test_single_element() with IO, Mut, Div, Panic {
    var a: [i64; 1024] = [0; 1024]
    a[0] = 42
    heapsort_i64(&!a, 1)
    chk(11, if a[0] == 42 { 1 } else { 0 })
}

fn test_binary_search() with IO, Mut, Div, Panic {
    // Sort first, then binary search
    var a: [i64; 1024] = [0; 1024]
    a[0]=2; a[1]=5; a[2]=8; a[3]=12; a[4]=15; a[5]=23; a[6]=38
    // Manual binary search for 12 (index 3)
    var lo: i32 = 0; var hi: i32 = 6; var found: i64 = 0 - 1
    while lo <= hi {
        let mid = lo + (hi - lo) / 2
        if a[mid] == 12 { found = mid as i64 }
        if a[mid] < 12 { lo = mid + 1 } else { hi = mid - 1 }
    }
    chk(12, if found == 3 { 1 } else { 0 })
}

pub fn main() -> i32 with IO, Mut, Div, Panic {
    CNT[0] = 0; CNT[1] = 0
    print("─── stdlib/algo/sort tests ───\n")
    test_insertion_sort()
    test_heapsort_i64()
    test_heapsort_f64()
    test_already_sorted()
    test_reverse_sorted()
    test_single_element()
    test_binary_search()
    print("─── "); print(CNT[0]); print("/"); print(CNT[0]+CNT[1]); print(" PASS ───\n")
    if CNT[1] == 0 { print("ALL PASS\n"); 0 } else { 1 }
}
