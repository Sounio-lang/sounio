//! Sorting Algorithms
//!
//! Provides efficient sorting implementations for i64 and f64 arrays:
//! - Quicksort: Fast in-place unstable sort (O(n log n) average)
//! - Merge sort: Stable sort with temp buffer (O(n log n) worst-case)
//! - Heapsort: In-place unstable sort (O(n log n) worst-case)
//!
//! # Usage
//! ```sio
//! var data = [3, 1, 4, 1, 5, 9, 2, 6]
//! quicksort_i64(&!data, 8)
//! // data is now [1, 1, 2, 3, 4, 5, 6, 9]
//! ```

extern "C" {
    fn malloc(size: usize) -> *mut u8;
    fn free(ptr: *mut u8);
}

// ===== i64 Sorting Algorithms =====

// Quicksort: In-place unstable sort using Hoare partition scheme
pub fn quicksort_i64(arr: &![i64], len: usize) with Panic, Div {
    if len <= 1 {
        return
    }
    quicksort_i64_range(&!arr, 0, len - 1)
}

// Internal: Quicksort a range [low, high]
fn quicksort_i64_range(arr: &![i64], low: usize, high: usize) with Panic, Div {
    if low < high {
        let pivot_idx = partition_i64(&!arr, low, high)

        // Sort left partition
        if pivot_idx > 0 {
            quicksort_i64_range(&!arr, low, pivot_idx - 1)
        }

        // Sort right partition
        if pivot_idx < high {
            quicksort_i64_range(&!arr, pivot_idx + 1, high)
        }
    }
}

// Internal: Hoare partition scheme
fn partition_i64(arr: &![i64], low: usize, high: usize) -> usize with Panic, Div {
    // Use middle element as pivot to avoid worst case on sorted arrays
    let mid = low + (high - low) / 2
    let pivot = arr[mid]

    var i = low
    var j = high

    while true {
        // Find element from left >= pivot
        while arr[i] < pivot {
            i = i + 1
        }

        // Find element from right <= pivot
        while arr[j] > pivot {
            j = j - 1
        }

        if i >= j {
            return j
        }

        // Swap arr[i] and arr[j]
        let temp = arr[i]
        arr[i] = arr[j]
        arr[j] = temp

        i = i + 1
        j = j - 1
    }

    return j
}

// Merge sort: Stable sort with O(n) space complexity
pub fn mergesort_i64(arr: &![i64], len: usize) with Alloc, Panic, Div {
    if len <= 1 {
        return
    }

    // Allocate temporary buffer
    let size_bytes = len * 8
    let temp = malloc(size_bytes) as *mut i64

    mergesort_i64_recursive(&!arr, temp, 0, len - 1)

    free(temp as *mut u8)
}

// Internal: Recursive merge sort
fn mergesort_i64_recursive(arr: &![i64], temp: *mut i64, left: usize, right: usize) with Panic, Div {
    if left >= right {
        return
    }

    let mid = left + (right - left) / 2

    // Sort left half
    mergesort_i64_recursive(&!arr, temp, left, mid)

    // Sort right half
    mergesort_i64_recursive(&!arr, temp, mid + 1, right)

    // Merge the two halves
    merge_i64(&!arr, temp, left, mid, right)
}

// Internal: Merge two sorted subarrays
fn merge_i64(arr: &![i64], temp: *mut i64, left: usize, mid: usize, right: usize) with Panic, Div {
    // Copy to temp buffer
    var i = left
    while i <= right {
        temp[i] = arr[i]
        i = i + 1
    }

    var i1 = left
    var i2 = mid + 1
    var curr = left

    // Merge back to original array
    while i1 <= mid && i2 <= right {
        if temp[i1] <= temp[i2] {
            arr[curr] = temp[i1]
            i1 = i1 + 1
        } else {
            arr[curr] = temp[i2]
            i2 = i2 + 1
        }
        curr = curr + 1
    }

    // Copy remaining elements from left half
    while i1 <= mid {
        arr[curr] = temp[i1]
        i1 = i1 + 1
        curr = curr + 1
    }

    // Right half is already in place
}

// Heapsort: In-place unstable sort
pub fn heapsort_i64(arr: &![i64], len: usize) with Panic, Div {
    if len <= 1 {
        return
    }

    // Build max heap
    var i = len / 2
    while i > 0 {
        i = i - 1
        heapify_i64(&!arr, len, i)
    }

    // Extract elements from heap
    var end = len - 1
    while end > 0 {
        // Move current root to end
        let temp = arr[0]
        arr[0] = arr[end]
        arr[end] = temp

        // Heapify reduced heap
        heapify_i64(&!arr, end, 0)

        end = end - 1
    }
}

// Internal: Maintain max heap property
fn heapify_i64(arr: &![i64], heap_size: usize, root: usize) with Panic {
    var largest = root
    let left = 2 * root + 1
    let right = 2 * root + 2

    if left < heap_size && arr[left] > arr[largest] {
        largest = left
    }

    if right < heap_size && arr[right] > arr[largest] {
        largest = right
    }

    if largest != root {
        // Swap root with largest
        let temp = arr[root]
        arr[root] = arr[largest]
        arr[largest] = temp

        // Recursively heapify affected subtree
        heapify_i64(&!arr, heap_size, largest)
    }
}

// Check if array is sorted in ascending order
pub fn is_sorted_i64(arr: &[i64], len: usize) -> bool with Panic, Div {
    if len <= 1 {
        return true
    }

    var i = 0
    while i < len - 1 {
        if arr[i] > arr[i + 1] {
            return false
        }
        i = i + 1
    }

    return true
}

// ===== f64 Sorting Algorithms =====

// Quicksort for f64 arrays
pub fn quicksort_f64(arr: &![f64], len: usize) with Panic, Div {
    if len <= 1 {
        return
    }
    quicksort_f64_range(&!arr, 0, len - 1)
}

fn quicksort_f64_range(arr: &![f64], low: usize, high: usize) with Panic, Div {
    if low < high {
        let pivot_idx = partition_f64(&!arr, low, high)

        if pivot_idx > 0 {
            quicksort_f64_range(&!arr, low, pivot_idx - 1)
        }

        if pivot_idx < high {
            quicksort_f64_range(&!arr, pivot_idx + 1, high)
        }
    }
}

fn partition_f64(arr: &![f64], low: usize, high: usize) -> usize with Panic, Div {
    let mid = low + (high - low) / 2
    let pivot = arr[mid]

    var i = low
    var j = high

    while true {
        while arr[i] < pivot {
            i = i + 1
        }

        while arr[j] > pivot {
            j = j - 1
        }

        if i >= j {
            return j
        }

        let temp = arr[i]
        arr[i] = arr[j]
        arr[j] = temp

        i = i + 1
        j = j - 1
    }

    return j
}

// Merge sort for f64 arrays
pub fn mergesort_f64(arr: &![f64], len: usize) with Alloc, Panic, Div {
    if len <= 1 {
        return
    }

    let size_bytes = len * 8
    let temp = malloc(size_bytes) as *mut f64

    mergesort_f64_recursive(&!arr, temp, 0, len - 1)

    free(temp as *mut u8)
}

fn mergesort_f64_recursive(arr: &![f64], temp: *mut f64, left: usize, right: usize) with Panic, Div {
    if left >= right {
        return
    }

    let mid = left + (right - left) / 2

    mergesort_f64_recursive(&!arr, temp, left, mid)
    mergesort_f64_recursive(&!arr, temp, mid + 1, right)
    merge_f64(&!arr, temp, left, mid, right)
}

fn merge_f64(arr: &![f64], temp: *mut f64, left: usize, mid: usize, right: usize) with Panic, Div {
    var i = left
    while i <= right {
        temp[i] = arr[i]
        i = i + 1
    }

    var i1 = left
    var i2 = mid + 1
    var curr = left

    while i1 <= mid && i2 <= right {
        if temp[i1] <= temp[i2] {
            arr[curr] = temp[i1]
            i1 = i1 + 1
        } else {
            arr[curr] = temp[i2]
            i2 = i2 + 1
        }
        curr = curr + 1
    }

    while i1 <= mid {
        arr[curr] = temp[i1]
        i1 = i1 + 1
        curr = curr + 1
    }
}

// Heapsort for f64 arrays
pub fn heapsort_f64(arr: &![f64], len: usize) with Panic, Div {
    if len <= 1 {
        return
    }

    var i = len / 2
    while i > 0 {
        i = i - 1
        heapify_f64(&!arr, len, i)
    }

    var end = len - 1
    while end > 0 {
        let temp = arr[0]
        arr[0] = arr[end]
        arr[end] = temp

        heapify_f64(&!arr, end, 0)

        end = end - 1
    }
}

fn heapify_f64(arr: &![f64], heap_size: usize, root: usize) with Panic {
    var largest = root
    let left = 2 * root + 1
    let right = 2 * root + 2

    if left < heap_size && arr[left] > arr[largest] {
        largest = left
    }

    if right < heap_size && arr[right] > arr[largest] {
        largest = right
    }

    if largest != root {
        let temp = arr[root]
        arr[root] = arr[largest]
        arr[largest] = temp

        heapify_f64(&!arr, heap_size, largest)
    }
}

// Check if f64 array is sorted
pub fn is_sorted_f64(arr: &[f64], len: usize) -> bool with Panic, Div {
    if len <= 1 {
        return true
    }

    var i = 0
    while i < len - 1 {
        if arr[i] > arr[i + 1] {
            return false
        }
        i = i + 1
    }

    return true
}

// ===== Test Functions =====

fn test_quicksort_i64() -> bool with Panic, Div {
    var arr = [9, 3, 7, 1, 5, 8, 2, 4, 6]
    quicksort_i64(&!arr, 9)
    return is_sorted_i64(&arr, 9)
}

fn test_mergesort_i64() -> bool with Alloc, Panic, Div {
    var arr = [5, 2, 9, 1, 7, 3, 8, 4, 6]
    mergesort_i64(&!arr, 9)
    return is_sorted_i64(&arr, 9)
}

fn test_heapsort_i64() -> bool with Panic, Div {
    var arr = [4, 8, 2, 9, 1, 6, 3, 7, 5]
    heapsort_i64(&!arr, 9)
    return is_sorted_i64(&arr, 9)
}

fn test_quicksort_f64() -> bool with Panic, Div {
    var arr = [9.5, 3.2, 7.8, 1.1, 5.4, 8.9, 2.3, 4.6, 6.7]
    quicksort_f64(&!arr, 9)
    return is_sorted_f64(&arr, 9)
}

fn test_mergesort_f64() -> bool with Alloc, Panic, Div {
    var arr = [5.5, 2.2, 9.9, 1.1, 7.7, 3.3, 8.8, 4.4, 6.6]
    mergesort_f64(&!arr, 9)
    return is_sorted_f64(&arr, 9)
}

fn test_heapsort_f64() -> bool with Panic, Div {
    var arr = [4.4, 8.8, 2.2, 9.9, 1.1, 6.6, 3.3, 7.7, 5.5]
    heapsort_f64(&!arr, 9)
    return is_sorted_f64(&arr, 9)
}

fn test_already_sorted() -> bool with Panic, Div {
    var arr = [1, 2, 3, 4, 5]
    quicksort_i64(&!arr, 5)
    return is_sorted_i64(&arr, 5)
}

fn test_reverse_sorted() -> bool with Panic, Div {
    var arr = [5, 4, 3, 2, 1]
    heapsort_i64(&!arr, 5)
    return is_sorted_i64(&arr, 5)
}

fn test_single_element() -> bool with Panic, Div {
    var arr = [42]
    quicksort_i64(&!arr, 1)
    return is_sorted_i64(&arr, 1)
}

fn test_duplicates() -> bool with Alloc, Panic, Div {
    var arr = [3, 1, 4, 1, 5, 9, 2, 6, 5]
    mergesort_i64(&!arr, 9)
    return is_sorted_i64(&arr, 9)
}

// Run all tests
pub fn sort_run_tests() -> bool with Alloc, Panic, Div {
    if !test_quicksort_i64() {
        return false
    }
    if !test_mergesort_i64() {
        return false
    }
    if !test_heapsort_i64() {
        return false
    }
    if !test_quicksort_f64() {
        return false
    }
    if !test_mergesort_f64() {
        return false
    }
    if !test_heapsort_f64() {
        return false
    }
    if !test_already_sorted() {
        return false
    }
    if !test_reverse_sorted() {
        return false
    }
    if !test_single_element() {
        return false
    }
    if !test_duplicates() {
        return false
    }
    return true
}
