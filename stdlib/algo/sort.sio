// stdlib/algo/sort.sio — Sorting algorithms
//
// Pure Sounio implementations for fixed-size i64 and f64 arrays:
//   - Insertion sort: stable, O(n^2), good for small arrays
//   - Heapsort: in-place, O(n log n) worst-case
//   - Quicksort-style via heapsort (avoids ownership issues with recursive &! reborrow)
//
// All arrays are fixed-size [T; 1024]. Pass actual length as n parameter.

// =============================================================================
// i64 sorting
// =============================================================================

// Insertion sort for i64 arrays. Stable, O(n^2).
fn insertion_sort_i64(arr: &![i64; 1024], n: i32) with Mut, Div, Panic {
    var i = 1
    while i < n {
        let key = arr[i]
        var j = i - 1
        while j >= 0 && arr[j] > key {
            arr[j + 1] = arr[j]
            j = j - 1
        }
        arr[j + 1] = key
        i = i + 1
    }
}

// Heapify subtree rooted at index root, heap size = size.
fn heapify_i64(arr: &![i64; 1024], size: i32, root: i32) with Mut, Div, Panic {
    var largest = root
    let left = 2 * root + 1
    let right = 2 * root + 2

    if left < size && arr[left] > arr[largest] {
        largest = left
    }
    if right < size && arr[right] > arr[largest] {
        largest = right
    }

    if largest != root {
        let temp = arr[root]
        arr[root] = arr[largest]
        arr[largest] = temp
        // Iterative sift-down to avoid recursive &! reborrow
        var pos = largest
        var done = false
        while !done {
            var big = pos
            let l = 2 * pos + 1
            let r = 2 * pos + 2
            if l < size && arr[l] > arr[big] { big = l }
            if r < size && arr[r] > arr[big] { big = r }
            if big != pos {
                let t = arr[pos]
                arr[pos] = arr[big]
                arr[big] = t
                pos = big
            } else {
                done = true
            }
        }
    }
}

// Heapsort for i64 arrays. In-place, O(n log n).
fn heapsort_i64(arr: &![i64; 1024], n: i32) with Mut, Div, Panic {
    if n <= 1 { return }

    // Build max heap
    var i = n / 2 - 1
    while i >= 0 {
        heapify_i64(arr, n, i)
        i = i - 1
    }

    // Extract elements
    var end = n - 1
    while end > 0 {
        let temp = arr[0]
        arr[0] = arr[end]
        arr[end] = temp
        heapify_i64(arr, end, 0)
        end = end - 1
    }
}

// Check if i64 array is sorted in ascending order.
fn is_sorted_i64(arr: &[i64; 1024], n: i32) -> bool with Mut, Div, Panic {
    if n <= 1 { return true }
    var i = 0
    while i < n - 1 {
        if arr[i] > arr[i + 1] { return false }
        i = i + 1
    }
    true
}

// =============================================================================
// f64 sorting
// =============================================================================

// Insertion sort for f64 arrays.
fn insertion_sort_f64(arr: &![f64; 1024], n: i32) with Mut, Div, Panic {
    var i = 1
    while i < n {
        let key = arr[i]
        var j = i - 1
        while j >= 0 && arr[j] > key {
            arr[j + 1] = arr[j]
            j = j - 1
        }
        arr[j + 1] = key
        i = i + 1
    }
}

// Heapsort for f64 arrays.
fn heapsort_f64(arr: &![f64; 1024], n: i32) with Mut, Div, Panic {
    if n <= 1 { return }

    // Build max heap (iterative sift-down)
    var i = n / 2 - 1
    while i >= 0 {
        // Sift down arr[i]
        var pos = i
        var done = false
        while !done {
            var big = pos
            let l = 2 * pos + 1
            let r = 2 * pos + 2
            if l < n && arr[l] > arr[big] { big = l }
            if r < n && arr[r] > arr[big] { big = r }
            if big != pos {
                let t = arr[pos]
                arr[pos] = arr[big]
                arr[big] = t
                pos = big
            } else {
                done = true
            }
        }
        i = i - 1
    }

    // Extract elements
    var end = n - 1
    while end > 0 {
        let temp = arr[0]
        arr[0] = arr[end]
        arr[end] = temp

        // Sift down arr[0] within heap of size end
        var pos = 0
        var done2 = false
        while !done2 {
            var big = pos
            let l = 2 * pos + 1
            let r = 2 * pos + 2
            if l < end && arr[l] > arr[big] { big = l }
            if r < end && arr[r] > arr[big] { big = r }
            if big != pos {
                let t = arr[pos]
                arr[pos] = arr[big]
                arr[big] = t
                pos = big
            } else {
                done2 = true
            }
        }
        end = end - 1
    }
}

// Check if f64 array is sorted in ascending order.
fn is_sorted_f64(arr: &[f64; 1024], n: i32) -> bool with Mut, Div, Panic {
    if n <= 1 { return true }
    var i = 0
    while i < n - 1 {
        if arr[i] > arr[i + 1] { return false }
        i = i + 1
    }
    true
}
