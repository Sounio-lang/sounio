//! Sorting Algorithms
//!
//! In-place and stable sorting algorithms for various use cases.
//!
//! # Algorithms
//! - `quicksort` - O(n log n) average, unstable, in-place
//! - `mergesort` - O(n log n) guaranteed, stable, requires O(n) extra space
//! - `heapsort` - O(n log n) guaranteed, unstable, in-place
//! - `insertion_sort` - O(n^2), stable, in-place, good for small/nearly sorted
//! - `radix_sort` - O(nk), stable, for integers
//!
//! # Choosing an Algorithm
//! - General purpose: quicksort (fastest average case)
//! - Need stability: mergesort
//! - Worst-case guarantee: heapsort or mergesort
//! - Small arrays (n < 20): insertion_sort
//! - Integers with limited range: radix_sort

// =============================================================================
// Quicksort
// =============================================================================

/// Quicksort implementation for i64 arrays.
///
/// Average: O(n log n), Worst: O(n^2)
/// In-place, unstable.
pub fn quicksort_i64(arr: &![i64], len: usize) {
    if len <= 1 {
        return
    }
    quicksort_i64_range(arr, 0, len - 1)
}

fn quicksort_i64_range(arr: &![i64], low: usize, high: usize) {
    if low >= high {
        return
    }

    // Use median-of-three pivot selection for better performance
    let pivot_idx = partition_i64(arr, low, high)

    if pivot_idx > 0 {
        quicksort_i64_range(arr, low, pivot_idx - 1)
    }
    quicksort_i64_range(arr, pivot_idx + 1, high)
}

fn partition_i64(arr: &![i64], low: usize, high: usize) -> usize {
    // Median-of-three pivot selection
    let mid = low + (high - low) / 2
    if arr[mid] < arr[low] {
        swap_i64(arr, low, mid)
    }
    if arr[high] < arr[low] {
        swap_i64(arr, low, high)
    }
    if arr[mid] < arr[high] {
        swap_i64(arr, mid, high)
    }
    // Now arr[high] is the median (our pivot)

    let pivot = arr[high]
    var i = low as i64 - 1

    var j = low
    while j < high {
        if arr[j] <= pivot {
            i = i + 1
            swap_i64(arr, i as usize, j)
        }
        j = j + 1
    }

    swap_i64(arr, (i + 1) as usize, high)
    (i + 1) as usize
}

fn swap_i64(arr: &![i64], i: usize, j: usize) {
    let temp = arr[i]
    arr[i] = arr[j]
    arr[j] = temp
}

/// Quicksort for f64 arrays.
pub fn quicksort_f64(arr: &![f64], len: usize) {
    if len <= 1 {
        return
    }
    quicksort_f64_range(arr, 0, len - 1)
}

fn quicksort_f64_range(arr: &![f64], low: usize, high: usize) {
    if low >= high {
        return
    }

    let pivot_idx = partition_f64(arr, low, high)

    if pivot_idx > 0 {
        quicksort_f64_range(arr, low, pivot_idx - 1)
    }
    quicksort_f64_range(arr, pivot_idx + 1, high)
}

fn partition_f64(arr: &![f64], low: usize, high: usize) -> usize {
    let mid = low + (high - low) / 2
    if arr[mid] < arr[low] {
        swap_f64(arr, low, mid)
    }
    if arr[high] < arr[low] {
        swap_f64(arr, low, high)
    }
    if arr[mid] < arr[high] {
        swap_f64(arr, mid, high)
    }

    let pivot = arr[high]
    var i = low as i64 - 1

    var j = low
    while j < high {
        if arr[j] <= pivot {
            i = i + 1
            swap_f64(arr, i as usize, j)
        }
        j = j + 1
    }

    swap_f64(arr, (i + 1) as usize, high)
    (i + 1) as usize
}

fn swap_f64(arr: &![f64], i: usize, j: usize) {
    let temp = arr[i]
    arr[i] = arr[j]
    arr[j] = temp
}

// =============================================================================
// Insertion Sort
// =============================================================================

/// Insertion sort for i64 arrays.
///
/// O(n^2) time, O(1) space, stable.
/// Efficient for small arrays or nearly-sorted data.
pub fn insertion_sort_i64(arr: &![i64], len: usize) {
    if len <= 1 {
        return
    }

    var i: usize = 1
    while i < len {
        let key = arr[i]
        var j = i as i64 - 1

        while j >= 0 && arr[j as usize] > key {
            arr[(j + 1) as usize] = arr[j as usize]
            j = j - 1
        }

        arr[(j + 1) as usize] = key
        i = i + 1
    }
}

/// Insertion sort for f64 arrays.
pub fn insertion_sort_f64(arr: &![f64], len: usize) {
    if len <= 1 {
        return
    }

    var i: usize = 1
    while i < len {
        let key = arr[i]
        var j = i as i64 - 1

        while j >= 0 && arr[j as usize] > key {
            arr[(j + 1) as usize] = arr[j as usize]
            j = j - 1
        }

        arr[(j + 1) as usize] = key
        i = i + 1
    }
}

// =============================================================================
// Merge Sort
// =============================================================================

/// Merge sort for i64 arrays.
///
/// O(n log n) time, O(n) space, stable.
pub fn mergesort_i64(arr: &![i64], len: usize) with Alloc {
    if len <= 1 {
        return
    }

    var temp = Vec::with_capacity(len)
    var i: usize = 0
    while i < len {
        temp.push(0)
        i = i + 1
    }

    mergesort_i64_range(arr, &!temp, 0, len - 1)
}

fn mergesort_i64_range(arr: &![i64], temp: &![Vec<i64>], low: usize, high: usize) {
    if low >= high {
        return
    }

    let mid = low + (high - low) / 2
    mergesort_i64_range(arr, temp, low, mid)
    mergesort_i64_range(arr, temp, mid + 1, high)
    merge_i64(arr, temp, low, mid, high)
}

fn merge_i64(arr: &![i64], temp: &![Vec<i64>], low: usize, mid: usize, high: usize) {
    // Copy to temp
    var i = low
    while i <= high {
        temp[i] = arr[i]
        i = i + 1
    }

    // Merge back
    var left = low
    var right = mid + 1
    var k = low

    while left <= mid && right <= high {
        if temp[left] <= temp[right] {
            arr[k] = temp[left]
            left = left + 1
        } else {
            arr[k] = temp[right]
            right = right + 1
        }
        k = k + 1
    }

    // Copy remaining left elements
    while left <= mid {
        arr[k] = temp[left]
        left = left + 1
        k = k + 1
    }

    // Right elements are already in place
}

// =============================================================================
// Heap Sort
// =============================================================================

/// Heapsort for i64 arrays.
///
/// O(n log n) time guaranteed, O(1) space, unstable.
pub fn heapsort_i64(arr: &![i64], len: usize) {
    if len <= 1 {
        return
    }

    // Build max heap
    var i = (len / 2) as i64 - 1
    while i >= 0 {
        heapify_down_i64(arr, len, i as usize)
        i = i - 1
    }

    // Extract elements from heap
    var end = len - 1
    while end > 0 {
        swap_i64(arr, 0, end)
        heapify_down_i64(arr, end, 0)
        end = end - 1
    }
}

fn heapify_down_i64(arr: &![i64], len: usize, root: usize) {
    var largest = root
    let left = 2 * root + 1
    let right = 2 * root + 2

    if left < len && arr[left] > arr[largest] {
        largest = left
    }

    if right < len && arr[right] > arr[largest] {
        largest = right
    }

    if largest != root {
        swap_i64(arr, root, largest)
        heapify_down_i64(arr, len, largest)
    }
}

/// Heapsort for f64 arrays.
pub fn heapsort_f64(arr: &![f64], len: usize) {
    if len <= 1 {
        return
    }

    // Build max heap
    var i = (len / 2) as i64 - 1
    while i >= 0 {
        heapify_down_f64(arr, len, i as usize)
        i = i - 1
    }

    // Extract elements
    var end = len - 1
    while end > 0 {
        swap_f64(arr, 0, end)
        heapify_down_f64(arr, end, 0)
        end = end - 1
    }
}

fn heapify_down_f64(arr: &![f64], len: usize, root: usize) {
    var largest = root
    let left = 2 * root + 1
    let right = 2 * root + 2

    if left < len && arr[left] > arr[largest] {
        largest = left
    }

    if right < len && arr[right] > arr[largest] {
        largest = right
    }

    if largest != root {
        swap_f64(arr, root, largest)
        heapify_down_f64(arr, len, largest)
    }
}

// =============================================================================
// Radix Sort (for unsigned integers)
// =============================================================================

/// Radix sort for u32 arrays (LSD).
///
/// O(nk) time where k is the number of digits, O(n) space, stable.
pub fn radix_sort_u32(arr: &![u32], len: usize) with Alloc {
    if len <= 1 {
        return
    }

    // Find maximum to determine number of digits
    var max_val: u32 = 0
    var i: usize = 0
    while i < len {
        if arr[i] > max_val {
            max_val = arr[i]
        }
        i = i + 1
    }

    // Output array
    var output = Vec::with_capacity(len)
    i = 0
    while i < len {
        output.push(0u32)
        i = i + 1
    }

    // Process each digit (LSD radix sort)
    var exp: u32 = 1
    while max_val / exp > 0 {
        counting_sort_digit_u32(arr, &!output, len, exp)
        exp = exp * 10
    }
}

fn counting_sort_digit_u32(arr: &![u32], output: &![Vec<u32>], len: usize, exp: u32) {
    var count: [i64; 10] = [0; 10]

    // Count occurrences of each digit
    var i: usize = 0
    while i < len {
        let digit = ((arr[i] / exp) % 10) as usize
        count[digit] = count[digit] + 1
        i = i + 1
    }

    // Change count[i] to position of digit in output
    i = 1
    while i < 10 {
        count[i] = count[i] + count[i - 1]
        i = i + 1
    }

    // Build output array (traverse from end for stability)
    var j = len as i64 - 1
    while j >= 0 {
        let digit = ((arr[j as usize] / exp) % 10) as usize
        count[digit] = count[digit] - 1
        output[count[digit] as usize] = arr[j as usize]
        j = j - 1
    }

    // Copy output back to arr
    i = 0
    while i < len {
        arr[i] = output[i]
        i = i + 1
    }
}

// =============================================================================
// Utility Functions
// =============================================================================

/// Check if array is sorted in ascending order.
pub fn is_sorted_i64(arr: &[i64], len: usize) -> bool {
    if len <= 1 {
        return true
    }

    var i: usize = 1
    while i < len {
        if arr[i] < arr[i - 1] {
            return false
        }
        i = i + 1
    }

    true
}

/// Check if array is sorted in ascending order.
pub fn is_sorted_f64(arr: &[f64], len: usize) -> bool {
    if len <= 1 {
        return true
    }

    var i: usize = 1
    while i < len {
        if arr[i] < arr[i - 1] {
            return false
        }
        i = i + 1
    }

    true
}

/// Check if array is sorted in descending order.
pub fn is_sorted_desc_i64(arr: &[i64], len: usize) -> bool {
    if len <= 1 {
        return true
    }

    var i: usize = 1
    while i < len {
        if arr[i] > arr[i - 1] {
            return false
        }
        i = i + 1
    }

    true
}

/// Reverse array in-place.
pub fn reverse_i64(arr: &![i64], len: usize) {
    if len <= 1 {
        return
    }

    var left: usize = 0
    var right = len - 1

    while left < right {
        swap_i64(arr, left, right)
        left = left + 1
        right = right - 1
    }
}

/// Reverse array in-place.
pub fn reverse_f64(arr: &![f64], len: usize) {
    if len <= 1 {
        return
    }

    var left: usize = 0
    var right = len - 1

    while left < right {
        swap_f64(arr, left, right)
        left = left + 1
        right = right - 1
    }
}

// =============================================================================
// Tests
// =============================================================================

fn test_quicksort() -> bool {
    var arr: [i64; 8] = [64, 34, 25, 12, 22, 11, 90, 5]
    quicksort_i64(&!arr, 8)

    if !is_sorted_i64(&arr, 8) { return false }
    if arr[0] != 5 { return false }
    if arr[7] != 90 { return false }

    true
}

fn test_insertion_sort() -> bool {
    var arr: [i64; 5] = [5, 2, 4, 6, 1]
    insertion_sort_i64(&!arr, 5)

    if !is_sorted_i64(&arr, 5) { return false }

    true
}

fn test_heapsort() -> bool {
    var arr: [i64; 6] = [12, 11, 13, 5, 6, 7]
    heapsort_i64(&!arr, 6)

    if !is_sorted_i64(&arr, 6) { return false }

    true
}

fn test_radix_sort() -> bool {
    var arr: [u32; 7] = [170, 45, 75, 90, 802, 24, 2]
    radix_sort_u32(&!arr, 7)

    // Check sorted
    if arr[0] != 2 { return false }
    if arr[1] != 24 { return false }
    if arr[6] != 802 { return false }

    true
}

fn test_is_sorted() -> bool {
    let sorted: [i64; 5] = [1, 2, 3, 4, 5]
    let unsorted: [i64; 5] = [1, 3, 2, 4, 5]

    if !is_sorted_i64(&sorted, 5) { return false }
    if is_sorted_i64(&unsorted, 5) { return false }

    true
}

pub fn run_tests() -> bool {
    test_quicksort() &&
    test_insertion_sort() &&
    test_heapsort() &&
    test_radix_sort() &&
    test_is_sorted()
}
