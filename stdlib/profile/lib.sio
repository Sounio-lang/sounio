// profile — Execution profiling
//
// Named timing slots with POSIX clock_gettime and lightweight function-level profiling.
//
// Submodules:
//   profiler      — Synchronous wall-clock profiler with named slots (up to 64)
//   async_profile — Lightweight function profiler by fn_id (up to 256 entries)

pub use profiler::{
    profiler_new,
    profiler_begin, profiler_end, profiler_reset,
    profiler_report,
    profiler_slot_total_ms, profiler_slot_calls, profiler_slot_avg_us,
    profiler_slot_count,
}
