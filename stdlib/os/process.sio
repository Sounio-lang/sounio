//! stdlib/os/process.sio - Process Information and Control
//!
//! This module provides functions for interacting with the current process
//! and spawning child processes.

// =============================================================================
// FFI Declarations
// =============================================================================

extern "C" {
    fn getpid() -> i32;
    fn getppid() -> i32;
    fn fork() -> i32;
    fn execv(path: *const u8, argv: **const u8) -> i32;
    fn execve(path: *const u8, argv: **const u8, envp: **const u8) -> i32;
    fn waitpid(pid: i32, status: *mut i32, options: i32) -> i32;
    fn kill(pid: i32, sig: i32) -> i32;
    fn exit(status: i32) -> !;
    fn _exit(status: i32) -> !;
    fn abort() -> !;
    fn system(command: *const u8) -> i32;
    fn atexit(func: fn()) -> i32;
}

// Signal constants (POSIX)
pub let SIGTERM: i32 = 15;
pub let SIGKILL: i32 = 9;
pub let SIGINT: i32 = 2;
pub let SIGHUP: i32 = 1;
pub let SIGQUIT: i32 = 3;
pub let SIGSTOP: i32 = 19;
pub let SIGCONT: i32 = 18;
pub let SIGUSR1: i32 = 10;
pub let SIGUSR2: i32 = 12;

// waitpid options
pub let WNOHANG: i32 = 1;
pub let WUNTRACED: i32 = 2;

// =============================================================================
// Process Identification
// =============================================================================

/// Returns the process ID of the current process.
///
/// # Example
/// ```sio
/// let pid = process_id()
/// print("My PID: " ++ pid.to_string())
/// ```
pub fn process_id() -> i32 with IO {
    getpid()
}

/// Returns the process ID of the parent process.
///
/// # Example
/// ```sio
/// let ppid = parent_process_id()
/// print("Parent PID: " ++ ppid.to_string())
/// ```
pub fn parent_process_id() -> i32 with IO {
    getppid()
}

// =============================================================================
// Process Arguments
// =============================================================================

// Note: Command-line argument access typically requires runtime support
// These are placeholders that would be filled in by the runtime

/// The command-line arguments passed to the program.
///
/// The first element is the program name.
///
/// # Example
/// ```sio
/// let args = process_args()
/// for arg in args {
///     print(arg)
/// }
/// ```
pub fn process_args() -> Vec<string> with IO, Alloc {
    // This would be populated by the runtime during program initialization
    // For now, return empty vector
    Vec::new()
}

/// Returns the name of the current executable.
pub fn process_name() -> Option<string> with IO, Alloc {
    let args = process_args();
    if args.len() > 0 {
        Some(args[0].clone())
    } else {
        None
    }
}

// =============================================================================
// Process Exit
// =============================================================================

/// Terminates the current process with the specified exit code.
///
/// This function calls cleanup handlers and flushes stdio buffers.
///
/// # Example
/// ```sio
/// if error_occurred {
///     process_exit(1)
/// }
/// process_exit(0)
/// ```
pub fn process_exit(code: i32) -> ! with IO {
    exit(code)
}

/// Terminates the process immediately without cleanup.
///
/// This does not call atexit handlers or flush stdio buffers.
/// Use only when normal exit is not safe (e.g., after fork in child).
pub fn process_exit_immediately(code: i32) -> ! with IO {
    _exit(code)
}

/// Terminates the process abnormally.
///
/// This generates a core dump on Unix systems.
pub fn process_abort() -> ! with IO {
    abort()
}

// =============================================================================
// Process Control
// =============================================================================

/// Sends a signal to the specified process.
///
/// Returns true on success, false on failure.
///
/// # Example
/// ```sio
/// // Send SIGTERM to process 1234
/// process_signal(1234, SIGTERM)
/// ```
pub fn process_signal(pid: i32, signal: i32) -> bool with IO {
    kill(pid, signal) == 0
}

/// Terminates the specified process with SIGTERM.
///
/// Returns true on success, false on failure.
pub fn process_terminate(pid: i32) -> bool with IO {
    process_signal(pid, SIGTERM)
}

/// Forcefully kills the specified process with SIGKILL.
///
/// Returns true on success, false on failure.
pub fn process_kill(pid: i32) -> bool with IO {
    process_signal(pid, SIGKILL)
}

// =============================================================================
// Child Process Management
// =============================================================================

/// Status of a child process after waiting
pub enum ExitStatus {
    /// Process exited normally with given status code
    Exited { code: i32 },
    /// Process was terminated by a signal
    Signaled { signal: i32 },
    /// Process was stopped
    Stopped { signal: i32 },
    /// Status unknown
    Unknown
}

/// Returns true if the exit status indicates success (code 0)
pub fn exit_status_success(status: &ExitStatus) -> bool {
    match status {
        ExitStatus::Exited { code } => *code == 0,
        _ => false
    }
}

/// Returns the exit code if the process exited normally
pub fn exit_status_code(status: &ExitStatus) -> Option<i32> {
    match status {
        ExitStatus::Exited { code } => Some(*code),
        _ => None
    }
}

/// Waits for a child process to exit.
///
/// Returns the exit status of the child.
///
/// # Example
/// ```sio
/// let status = process_wait(child_pid)
/// if exit_status_success(&status) {
///     print("Child exited successfully")
/// }
/// ```
pub fn process_wait(pid: i32) -> ExitStatus with IO {
    var status: i32 = 0;
    let result = waitpid(pid, &!status, 0);

    if result < 0 {
        return ExitStatus::Unknown
    }

    // Decode status (POSIX macros)
    let exited = (status & 0x7f) == 0;
    let exit_code = (status >> 8) & 0xff;
    let signaled = (status & 0x7f) != 0 && (status & 0x7f) != 0x7f;
    let signal = status & 0x7f;
    let stopped = (status & 0xff) == 0x7f;
    let stop_signal = (status >> 8) & 0xff;

    if exited {
        ExitStatus::Exited { code: exit_code }
    } else if stopped {
        ExitStatus::Stopped { signal: stop_signal }
    } else if signaled {
        ExitStatus::Signaled { signal: signal }
    } else {
        ExitStatus::Unknown
    }
}

/// Waits for a child process without blocking.
///
/// Returns `Some(status)` if the child has exited, or `None` if still running.
pub fn process_try_wait(pid: i32) -> Option<ExitStatus> with IO {
    var status: i32 = 0;
    let result = waitpid(pid, &!status, WNOHANG);

    if result == 0 {
        // Child still running
        None
    } else if result > 0 {
        // Child has exited
        Some(process_wait(pid))
    } else {
        // Error
        None
    }
}

// =============================================================================
// Process Spawning
// =============================================================================

/// Result of spawning a process
pub enum SpawnResult {
    /// Successfully spawned with the given PID
    Ok { pid: i32 },
    /// Fork failed
    ForkFailed,
    /// Exec failed (only returned in child on error)
    ExecFailed
}

/// Spawns a new process executing the given command.
///
/// Returns the child's PID on success.
///
/// # Example
/// ```sio
/// match process_spawn("/bin/ls", &["/bin/ls", "-la"]) {
///     SpawnResult::Ok { pid } => {
///         print("Spawned child with PID: " ++ pid.to_string())
///         let status = process_wait(pid)
///     },
///     SpawnResult::ForkFailed => print("Fork failed"),
///     SpawnResult::ExecFailed => print("Exec failed"),
/// }
/// ```
pub fn process_spawn(path: &str, args: &[&str]) -> SpawnResult with IO, Alloc {
    let pid = fork();

    if pid < 0 {
        return SpawnResult::ForkFailed
    }

    if pid == 0 {
        // Child process
        // Build null-terminated argv array
        var argv: Vec<*const u8> = Vec::with_capacity(args.len() + 1);
        for arg in args {
            argv.push(arg.as_ptr());
        }
        argv.push(null);

        let result = execv(path.as_ptr(), argv.as_ptr());
        // If we get here, exec failed
        _exit(127)
    }

    // Parent process
    SpawnResult::Ok { pid: pid }
}

/// Runs a shell command and waits for it to complete.
///
/// Returns the exit status of the command.
///
/// # Example
/// ```sio
/// let status = process_run("ls -la")
/// ```
pub fn process_run(command: &str) -> i32 with IO {
    system(command.as_ptr())
}

// =============================================================================
// Resource Limits
// =============================================================================

extern "C" {
    fn getrlimit(resource: i32, rlim: *mut RLimit) -> i32;
    fn setrlimit(resource: i32, rlim: *const RLimit) -> i32;
}

/// Resource limit structure
struct RLimit {
    rlim_cur: u64,  // Soft limit
    rlim_max: u64   // Hard limit
}

// Resource limit constants
pub let RLIMIT_CPU: i32 = 0;     // CPU time in seconds
pub let RLIMIT_FSIZE: i32 = 1;   // Maximum file size
pub let RLIMIT_DATA: i32 = 2;    // Maximum data segment size
pub let RLIMIT_STACK: i32 = 3;   // Maximum stack size
pub let RLIMIT_CORE: i32 = 4;    // Maximum core file size
pub let RLIMIT_NOFILE: i32 = 7;  // Maximum open files
pub let RLIMIT_AS: i32 = 9;      // Maximum address space

pub let RLIM_INFINITY: u64 = 0xffffffffffffffff;

/// Resource limit value
pub struct ResourceLimit {
    pub soft: u64,
    pub hard: u64
}

/// Gets the resource limit for the specified resource.
pub fn get_resource_limit(resource: i32) -> Result<ResourceLimit, ()> with IO {
    var rlim = RLimit { rlim_cur: 0, rlim_max: 0 };
    let result = getrlimit(resource, &!rlim);

    if result == 0 {
        Ok(ResourceLimit { soft: rlim.rlim_cur, hard: rlim.rlim_max })
    } else {
        Err(())
    }
}

/// Sets the resource limit for the specified resource.
pub fn set_resource_limit(resource: i32, soft: u64, hard: u64) -> bool with IO {
    let rlim = RLimit { rlim_cur: soft, rlim_max: hard };
    setrlimit(resource, &rlim) == 0
}

// =============================================================================
// Process Information
// =============================================================================

/// Information about a process
pub struct ProcessInfo {
    pub pid: i32,
    pub ppid: i32,
    pub uid: u32,
    pub gid: u32
}

/// Gets information about the current process
pub fn current_process_info() -> ProcessInfo with IO {
    use os::env::{uid, gid};

    ProcessInfo {
        pid: process_id(),
        ppid: parent_process_id(),
        uid: uid(),
        gid: gid()
    }
}

// =============================================================================
// Cleanup Handlers
// =============================================================================

/// Registers a function to be called when the process exits normally.
///
/// The function will be called in reverse order of registration.
/// Returns true on success.
pub fn at_exit(handler: fn()) -> bool with IO {
    atexit(handler) == 0
}
