//! stdlib/os/process.sio - Process Information
//!
//! Provides POSIX process operations including process ID retrieval,
//! command-line arguments, and process termination via FFI bindings.

// =============================================================================
// FFI Declarations - POSIX Process Functions
// =============================================================================

extern "C" {
    fn getpid() -> i32;
    fn getppid() -> i32;
    fn exit(status: i32) -> !;
    fn abort() -> !;
}

// =============================================================================
// Process Identification
// =============================================================================

// Returns the current process ID (PID)
//
// Example:
//   let pid = process_id()
pub fn process_id() -> u32 with IO {
    getpid() as u32
}

// Returns the parent process ID (PPID)
//
// Example:
//   let ppid = process_parent_id()
pub fn process_parent_id() -> u32 with IO {
    getppid() as u32
}

// =============================================================================
// Process Termination
// =============================================================================

// Terminates the current process with the specified exit code
//
// This function calls cleanup handlers and flushes stdio buffers
// before termination. The never-return type (!) indicates this
// function never returns to the caller.
//
// Example:
//   if error_occurred {
//       process_exit(1)
//   }
//   process_exit(0)
pub fn process_exit(code: i32) -> ! with IO {
    exit(code)
}

// Terminates the process abnormally, generating a core dump
//
// This function never returns. It immediately aborts the process
// without calling cleanup handlers or flushing buffers.
//
// Example:
//   process_abort()
pub fn process_abort() -> ! with IO {
    abort()
}

// =============================================================================
// Process Arguments
// =============================================================================

// Returns command-line arguments passed to the program
//
// NOTE: This is a simplified implementation that currently returns
// an empty array. Full argument parsing requires runtime support
// (access to argc/argv from the C runtime) which will be added in
// a future version.
//
// Example:
//   let args = process_args()
//   for arg in args {
//       println(arg)
//   }
pub fn process_args() -> [string; 0] with IO {
    []
}

// =============================================================================
// Test Functions
// =============================================================================

// Test: Display current process ID
pub fn test_process_id() -> i32 with IO {
    let pid = process_id();
    println("Current PID: {pid}");
    return 0
}

// Test: Display parent process ID
pub fn test_process_parent_id() -> i32 with IO {
    let ppid = process_parent_id();
    println("Parent PID: {ppid}");
    return 0
}

// Test: Display process arguments (currently empty)
pub fn test_process_args() -> i32 with IO {
    let args = process_args();
    println("Arguments: (empty array)");
    return 0
}

// Test: Verify exit and abort signatures without calling them
pub fn test_exit_signatures() -> i32 with IO {
    println("process_exit(code: i32) -> ! available");
    println("process_abort() -> ! available");
    return 0
}

// Test: All process functions
pub fn test_all_process() -> i32 with IO {
    println("=== Process Information Tests ===");

    let pid = process_id();
    println("Current PID: {pid}");

    let ppid = process_parent_id();
    println("Parent PID: {ppid}");

    let args = process_args();
    println("Arguments: (empty array)");

    println("Exit/abort functions available (not tested to avoid termination)");
    println("All tests passed!");

    return 0
}
