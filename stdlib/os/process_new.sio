// stdlib/os/process_new — Process control primitives
//
// Thin wrappers around POSIX process functions.

extern "C" {
    fn exit(code: i32)
    fn getpid() -> i32
}

struct ProcessResult {
    exit_code: i32,
    ran: bool
}

fn process_result_new(code: i32, ran: bool) -> ProcessResult {
    ProcessResult { exit_code: code, ran: ran }
}

fn process_exit(code: i32) with IO {
    exit(code)
}

fn process_getpid() -> i32 with IO {
    getpid()
}

fn process_result_ok(r: ProcessResult) -> bool {
    r.ran && r.exit_code == 0
}
