//! stdlib/os/process.sio - Process Information and Control
//!
//! This module provides process operations via POSIX FFI including process ID
//! retrieval, command-line arguments, and process termination.

// =============================================================================
// FFI Declarations - POSIX Process Functions
// =============================================================================

extern "C" {
    fn getpid() -> i32;
    fn getppid() -> i32;
    fn exit(status: i32) -> !;
    fn abort() -> !;
}

// =============================================================================
// Core Process Functions
// =============================================================================

// Returns the current process ID
pub fn process_id() -> u32 with IO {
    getpid() as u32
}

// Returns the parent process ID
pub fn process_parent_id() -> u32 with IO {
    getppid() as u32
}

// Terminates the current process with the specified exit code
// This function calls cleanup handlers and flushes stdio buffers
pub fn process_exit(code: i32) -> ! with IO {
    exit(code)
}

// Terminates the process abnormally
// This generates a core dump on Unix systems
pub fn process_abort() -> ! with IO {
    abort()
}

// Returns command-line arguments passed to the program
// NOTE: Currently returns an empty vector - full implementation requires runtime support
pub fn process_args() -> Vec<string> with IO, Alloc {
    Vec::new()
}

// =============================================================================
// Test Functions
// =============================================================================

// Test: Get current process ID
pub fn test_process_id() with IO {
    let pid = process_id();
    println("Current process ID:");
    println(pid);
}

// Test: Get parent process ID
pub fn test_parent_id() with IO {
    let ppid = process_parent_id();
    println("Parent process ID:");
    println(ppid);
}

// Test: Get process arguments (currently returns empty vector)
pub fn test_process_args() with IO, Alloc {
    let args = process_args();
    println("Number of arguments:");
    println(args.len());
}

// Test: Verify exit/abort functions have correct signatures
// (We don't actually call them to avoid terminating the test)
pub fn test_exit_signatures() with IO {
    println("Exit functions available:");
    println("  process_exit(code: i32) -> !");
    println("  process_abort() -> !");
}
