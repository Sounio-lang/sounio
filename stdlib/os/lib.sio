//! stdlib/os - Operating System Bindings
//!
//! This module provides access to operating system functionality:
//! - `env` - Environment variables and paths
//! - `process` - Process information and control
//! - `fs` - Filesystem operations (see stdlib/io for file I/O)
//!
//! # Examples
//! ```sio
//! // Get environment variable
//! match env_var("HOME") {
//!     Some(home) => print("Home: " ++ home),
//!     None => print("HOME not set"),
//! }
//!
//! // Get process ID
//! let pid = process_id()
//! print("PID: " ++ pid.to_string())
//!
//! // Exit with status code
//! process_exit(0)
//! ```

pub mod env;
pub mod process;
