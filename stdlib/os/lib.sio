//! stdlib/os/lib.sio - Operating System Primitives
//!
//! This module provides environment and process operations for interacting
//! with the underlying operating system.
//!
//! # Submodules
//!
//! - **env** (env.sio): Environment variables, current directory, user information,
//!   and standard paths (home, config, cache, temp). Functions include `env_var()`,
//!   `env_set()`, `current_dir()`, `home_dir()`, `config_dir()`, etc.
//!
//! - **process** (process.sio): Process identification, arguments, exit control,
//!   signal handling, child process management, and resource limits. Functions
//!   include `process_id()`, `process_exit()`, `process_spawn()`, `process_wait()`,
//!   `get_resource_limit()`, etc.
//!
//! # Usage Examples
//!
//! ```sio
//! // Environment variable access
//! match env_var("HOME") {
//!     Some(home) => print("Home: " ++ home),
//!     None => print("HOME not set"),
//! }
//! let editor = env_var_or("EDITOR", "vim")
//!
//! // Process information
//! let pid = process_id()
//! let ppid = parent_process_id()
//! print("PID: " ++ pid.to_string())
//!
//! // Spawn and wait for child process
//! match process_spawn("/bin/ls", &["/bin/ls", "-la"]) {
//!     SpawnResult::Ok { pid } => {
//!         let status = process_wait(pid)
//!         if exit_status_success(&status) {
//!             print("Command succeeded")
//!         }
//!     },
//!     _ => print("Spawn failed"),
//! }
//! ```


// Submodules are resolved by path (`use os::<name>`);
// Sounio has no `mod` item, so the declarations that stood here were
// inert Rust syntax that also stopped this file parsing. Covered:
//   env, process
