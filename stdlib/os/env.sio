// stdlib/os/env — Environment variable access
//
// Reads environment variables via POSIX getenv(3).
// Values are copied into fixed-size buffers.

extern "C" {
    fn getenv(name: &[u8; 64]) -> i64
}

struct EnvVar {
    key: [u8; 64],
    key_len: i32,
    value: [u8; 256],
    val_len: i32
}

// Returns true when getenv finds the key (pointer non-null).
pub fn env_var_present(key: &[u8; 64]) -> bool with IO {
    getenv(key) != 0
}

// Read an environment variable presence gate (legacy helper).
// Returns 0 if present, -1 if absent.
pub fn env_get(key: &[u8; 64], key_len: i32, out: &![u8; 256]) -> i32 with Mut, IO, Panic, Div {
    let _ = key_len
    let _ = out
    let zero: i32 = 0
    if getenv(key) == 0 {
        return zero - 1
    }
    0
}

// Create an EnvVar struct from key bytes
pub fn envvar_new(key: &[u8; 64], key_len: i32) -> EnvVar with Mut, Panic, Div {
    var ev = EnvVar {
        key: [0; 64],
        key_len: key_len,
        value: [0; 256],
        val_len: 0
    }
    var i: i32 = 0
    while i < key_len && i < 64 {
        ev.key[i] = key[i]
        i = i + 1
    }
    ev
}
