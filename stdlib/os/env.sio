//! stdlib/os/env.sio - Environment Variables
//!
//! This module provides functions for reading and writing environment
//! variables, as well as accessing current directory information.

// =============================================================================
// FFI Declarations
// =============================================================================

extern "C" {
    fn getenv(name: *const u8) -> *const u8;
    fn setenv(name: *const u8, value: *const u8, overwrite: i32) -> i32;
    fn unsetenv(name: *const u8) -> i32;
    fn getcwd(buf: *mut u8, size: usize) -> *mut u8;
    fn chdir(path: *const u8) -> i32;
    fn getuid() -> u32;
    fn geteuid() -> u32;
    fn getgid() -> u32;
    fn getegid() -> u32;
    fn gethostname(name: *mut u8, len: usize) -> i32;
}

// =============================================================================
// Environment Variable Operations
// =============================================================================

/// Fetches the environment variable `key` from the current process.
///
/// Returns `None` if the variable is not present in the environment.
///
/// # Example
/// ```sio
/// match env_var("PATH") {
///     Some(path) => print("PATH: " ++ path),
///     None => print("PATH not set"),
/// }
/// ```
pub fn env_var(key: &str) -> Option<string> with IO {
    let key_ptr = key.as_ptr();
    let result = getenv(key_ptr);

    if result == null {
        None
    } else {
        // Convert C string to Sounio string
        Some(string_from_cstr(result))
    }
}

/// Fetches the environment variable `key`, returning the default if not present.
///
/// # Example
/// ```sio
/// let editor = env_var_or("EDITOR", "vim")
/// ```
pub fn env_var_or(key: &str, default: &str) -> string with IO {
    match env_var(key) {
        Some(value) => value,
        None => default.to_string()
    }
}

/// Sets the environment variable `key` to `value`.
///
/// If `overwrite` is true, the variable will be overwritten if it already exists.
/// Returns true on success, false on failure.
///
/// # Example
/// ```sio
/// env_set_var("MY_VAR", "hello", true)
/// ```
pub fn env_set_var(key: &str, value: &str, overwrite: bool) -> bool with IO {
    let overwrite_int = if overwrite { 1 } else { 0 };
    let result = setenv(key.as_ptr(), value.as_ptr(), overwrite_int);
    result == 0
}

/// Sets the environment variable `key` to `value`, always overwriting.
///
/// # Example
/// ```sio
/// env_set("MY_VAR", "hello")
/// ```
pub fn env_set(key: &str, value: &str) -> bool with IO {
    env_set_var(key, value, true)
}

/// Removes an environment variable from the current process.
///
/// Returns true on success, false on failure.
///
/// # Example
/// ```sio
/// env_remove("MY_VAR")
/// ```
pub fn env_remove(key: &str) -> bool with IO {
    let result = unsetenv(key.as_ptr());
    result == 0
}

// =============================================================================
// Directory Operations
// =============================================================================

/// Returns the current working directory as a string.
///
/// # Example
/// ```sio
/// match current_dir() {
///     Ok(dir) => print("CWD: " ++ dir),
///     Err(e) => print("Error getting CWD"),
/// }
/// ```
pub fn current_dir() -> Result<string, EnvError> with IO, Alloc {
    let buf_size: usize = 4096;
    var buf: [u8; 4096] = [0u8; 4096];

    let result = getcwd(&!buf[0], buf_size);

    if result == null {
        Err(EnvError::GetCwdFailed)
    } else {
        Ok(string_from_cstr(&buf[0]))
    }
}

/// Sets the current working directory.
///
/// # Example
/// ```sio
/// match set_current_dir("/home/user") {
///     Ok(()) => print("Changed directory"),
///     Err(_) => print("Failed to change directory"),
/// }
/// ```
pub fn set_current_dir(path: &str) -> Result<(), EnvError> with IO {
    let result = chdir(path.as_ptr());

    if result == 0 {
        Ok(())
    } else {
        Err(EnvError::SetCwdFailed)
    }
}

// =============================================================================
// User Information
// =============================================================================

/// Returns the real user ID of the calling process.
pub fn uid() -> u32 with IO {
    getuid()
}

/// Returns the effective user ID of the calling process.
pub fn euid() -> u32 with IO {
    geteuid()
}

/// Returns the real group ID of the calling process.
pub fn gid() -> u32 with IO {
    getgid()
}

/// Returns the effective group ID of the calling process.
pub fn egid() -> u32 with IO {
    getegid()
}

/// Returns the hostname of the current machine.
///
/// # Example
/// ```sio
/// match hostname() {
///     Ok(name) => print("Hostname: " ++ name),
///     Err(_) => print("Failed to get hostname"),
/// }
/// ```
pub fn hostname() -> Result<string, EnvError> with IO, Alloc {
    let buf_size: usize = 256;
    var buf: [u8; 256] = [0u8; 256];

    let result = gethostname(&!buf[0], buf_size);

    if result == 0 {
        Ok(string_from_cstr(&buf[0]))
    } else {
        Err(EnvError::GetHostnameFailed)
    }
}

// =============================================================================
// Standard Directory Paths
// =============================================================================

/// Returns the home directory for the current user.
///
/// On Unix, this reads the HOME environment variable.
pub fn home_dir() -> Option<string> with IO {
    env_var("HOME")
}

/// Returns the temporary directory path.
///
/// On Unix, this reads TMPDIR or defaults to /tmp.
pub fn temp_dir() -> string with IO {
    env_var_or("TMPDIR", "/tmp")
}

/// Returns the user's config directory.
///
/// On Unix, this is typically $XDG_CONFIG_HOME or ~/.config.
pub fn config_dir() -> Option<string> with IO, Alloc {
    match env_var("XDG_CONFIG_HOME") {
        Some(dir) => Some(dir),
        None => {
            match home_dir() {
                Some(home) => Some(home ++ "/.config"),
                None => None
            }
        }
    }
}

/// Returns the user's data directory.
///
/// On Unix, this is typically $XDG_DATA_HOME or ~/.local/share.
pub fn data_dir() -> Option<string> with IO, Alloc {
    match env_var("XDG_DATA_HOME") {
        Some(dir) => Some(dir),
        None => {
            match home_dir() {
                Some(home) => Some(home ++ "/.local/share"),
                None => None
            }
        }
    }
}

/// Returns the user's cache directory.
///
/// On Unix, this is typically $XDG_CACHE_HOME or ~/.cache.
pub fn cache_dir() -> Option<string> with IO, Alloc {
    match env_var("XDG_CACHE_HOME") {
        Some(dir) => Some(dir),
        None => {
            match home_dir() {
                Some(home) => Some(home ++ "/.cache"),
                None => None
            }
        }
    }
}

// =============================================================================
// Environment Iterator
// =============================================================================

/// An iterator over all environment variables.
///
/// Yields (key, value) pairs for each environment variable.
pub struct EnvVars {
    index: usize,
    environ_ptr: **const u8
}

extern "C" {
    // environ is a pointer to an array of C strings (null-terminated)
    static environ: **const u8;
}

/// Returns an iterator over all environment variables.
pub fn env_vars() -> EnvVars with IO {
    EnvVars {
        index: 0,
        environ_ptr: environ
    }
}

// =============================================================================
// Error Types
// =============================================================================

/// Errors that can occur during environment operations
pub enum EnvError {
    /// Failed to get current working directory
    GetCwdFailed,
    /// Failed to set current working directory
    SetCwdFailed,
    /// Failed to get hostname
    GetHostnameFailed,
    /// Invalid UTF-8 in environment variable
    InvalidUtf8,
    /// Environment variable not found
    NotFound
}

/// Returns a human-readable error message
pub fn env_error_message(err: &EnvError) -> string {
    match err {
        EnvError::GetCwdFailed => "Failed to get current working directory",
        EnvError::SetCwdFailed => "Failed to set current working directory",
        EnvError::GetHostnameFailed => "Failed to get hostname",
        EnvError::InvalidUtf8 => "Invalid UTF-8 in environment variable",
        EnvError::NotFound => "Environment variable not found"
    }
}

// =============================================================================
// Helper Functions
// =============================================================================

/// Converts a null-terminated C string to a Sounio string.
fn string_from_cstr(ptr: *const u8) -> string with Alloc {
    if ptr == null {
        return ""
    }

    // Count length
    var len: usize = 0;
    while unsafe { *(ptr.offset(len as isize)) } != 0u8 {
        len = len + 1;
    }

    // Copy bytes
    var bytes: Vec<u8> = Vec::with_capacity(len);
    var i: usize = 0;
    while i < len {
        bytes.push(unsafe { *(ptr.offset(i as isize)) });
        i = i + 1;
    }

    string::from_utf8_unchecked(bytes)
}
