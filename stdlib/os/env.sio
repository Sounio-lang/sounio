// stdlib/os/env — Environment variable access
//
// Reads environment variables from /proc/self/environ through the syscall6
// builtin (open/read/close), the same way stdlib/http and stdlib/display reach
// the kernel: the native backend has no dynamic linker, so getenv(3) is not
// callable. Values are copied into fixed-size buffers.

let ENV_SYS_READ: i64 = 0
let ENV_SYS_OPEN: i64 = 2
let ENV_SYS_CLOSE: i64 = 3

// syscall6 receives these buffers by address. They are module globals, as in
// stdlib/http/post.sio, because `&!local_array` passed to syscall6 does not
// reach the kernel as the array's address on the native backend.
var ENV_PATH: [i8; 32] = [0; 32]
var ENV_BUF: [u8; 4096] = [0; 4096]

// Look `key` up in the process environment. The key ends at its first NUL
// byte or at byte 64. Returns the value length when the key is set (the value
// may be empty) and -1 when it is not set or the environment cannot be read.
// Up to 255 value bytes are copied into `out`, followed by a NUL.
fn env_lookup(key: &[u8; 64], out: &![u8; 256]) -> i64 with IO, Mut {
    var klen: i64 = 0
    while klen < 64 && key[klen as usize] != 0 {
        klen = klen + 1
    }
    if klen == 0 { return 0 - 1 }

    // "/proc/self/environ"
    ENV_PATH[0] = 47 as i8   // /
    ENV_PATH[1] = 112 as i8  // p
    ENV_PATH[2] = 114 as i8  // r
    ENV_PATH[3] = 111 as i8  // o
    ENV_PATH[4] = 99 as i8   // c
    ENV_PATH[5] = 47 as i8   // /
    ENV_PATH[6] = 115 as i8  // s
    ENV_PATH[7] = 101 as i8  // e
    ENV_PATH[8] = 108 as i8  // l
    ENV_PATH[9] = 102 as i8  // f
    ENV_PATH[10] = 47 as i8  // /
    ENV_PATH[11] = 101 as i8 // e
    ENV_PATH[12] = 110 as i8 // n
    ENV_PATH[13] = 118 as i8 // v
    ENV_PATH[14] = 105 as i8 // i
    ENV_PATH[15] = 114 as i8 // r
    ENV_PATH[16] = 111 as i8 // o
    ENV_PATH[17] = 110 as i8 // n
    let fd = syscall6(ENV_SYS_OPEN, &!ENV_PATH, 0, 0, 0, 0, 0)
    if fd < 0 { return 0 - 1 }

    // Entries are KEY=VALUE, each terminated by NUL. Scan them as a stream so
    // an environment larger than the buffer is still read completely.
    var matching = true
    var match_pos: i64 = 0
    var found = false
    var done = false
    var vlen: i64 = 0
    while !done {
        let n = syscall6(ENV_SYS_READ, fd, &!ENV_BUF, 4096, 0, 0, 0)
        if n <= 0 {
            done = true
        } else {
            var i: i64 = 0
            while i < n && !done {
                let b = ENV_BUF[i as usize]
                if found {
                    if b == 0 {
                        done = true
                    } else {
                        if vlen < 255 { out[vlen as usize] = b }
                        vlen = vlen + 1
                    }
                } else if b == 0 {
                    matching = true
                    match_pos = 0
                } else if matching {
                    if match_pos < klen {
                        if b == key[match_pos as usize] {
                            match_pos = match_pos + 1
                        } else {
                            matching = false
                        }
                    } else if b == 61 {   // '=' right after the whole key
                        found = true
                    } else {
                        matching = false
                    }
                }
                i = i + 1
            }
        }
    }
    syscall6(ENV_SYS_CLOSE, fd, 0, 0, 0, 0, 0)
    if !found { return 0 - 1 }
    let term = if vlen < 255 { vlen } else { 255 }
    out[term as usize] = 0
    vlen
}

struct EnvVar {
    key: [u8; 64],
    key_len: i32,
    value: [u8; 256],
    val_len: i32
}

// Returns true when the key is set in the environment (the value may be empty).
pub fn env_var_present(key: &[u8; 64]) -> bool with IO, Mut {
    var scratch: [u8; 256] = [0; 256]
    env_lookup(key, &!scratch) >= 0
}

// Read an environment variable. Returns 0 if present, -1 if absent. The key
// ends at its first NUL byte or at `key_len`, whichever comes first; up to 255
// value bytes are copied into `out`, NUL-terminated.
pub fn env_get(key: &[u8; 64], key_len: i32, out: &![u8; 256]) -> i32 with Mut, IO, Panic, Div {
    var k: [u8; 64] = [0; 64]
    var i: i32 = 0
    while i < key_len && i < 64 {
        k[i as usize] = key[i as usize]
        i = i + 1
    }
    let zero: i32 = 0
    if env_lookup(&k, out) < 0 {
        return zero - 1
    }
    0
}

// Create an EnvVar struct from key bytes
pub fn envvar_new(key: &[u8; 64], key_len: i32) -> EnvVar with Mut, Panic, Div {
    var ev = EnvVar {
        key: [0; 64],
        key_len: key_len,
        value: [0; 256],
        val_len: 0
    }
    var i: i32 = 0
    while i < key_len && i < 64 {
        ev.key[i] = key[i]
        i = i + 1
    }
    ev
}
