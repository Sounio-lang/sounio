// stdlib/quantum/linear.sio — Quantum Computing via Linear Types
//
// The no-cloning theorem of quantum mechanics states that an unknown
// quantum state cannot be copied. Sounio enforces this at COMPILE TIME
// via linear types: a Qubit is a linear resource that must be consumed
// exactly once. Attempting to copy produces a compile error.
//
// SOTA: Guppy (Quantinuum, Oct 2025): "Imperative Quantum Programming
//       with Ownership and Borrowing"
//       — Linear types enforce no-cloning at the type level
//       — Statically compiled, strongly typed quantum programs
//
//       Beryllium (Horizon Quantum, Dec 2025):
//       — "Manage information, not qubits" philosophy
//       — Quantum computation as effectful computation
//
// This module provides:
//   - Linear Qubit type (cannot be cloned)
//   - Standard quantum gates (H, X, Y, Z, S, T, CNOT, CZ, SWAP)
//   - Measurement (consumes qubit, returns classical bit): `measure_qubit`
//     (not `measure`, which is the builtin Knowledge constructor and would
//     shadow a user function of that name -- error E008 on Madaros)
//   - Classical statevector simulation (cap QUANTUM_MAX_QUBITS = 10)
//   - Bell pair, GHZ3, and teleportation primitives
//
// This is not a quantum computer. Rx/Ry/Rz live on Statevector in
// epistemic_vqe.sio; they are not duplicated here. VQE modules remain
// capped at 4 qubits.

// =============================================================================
// Simulator cap — 10 qubits = 1024 amplitudes
// =============================================================================
// The 11th qubit_alloc panics. The previous 8-qubit buffer overflowed
// silently on the 9th allocation.

pub const QUANTUM_MAX_QUBITS: i32 = 10
pub const QUANTUM_MAX_AMPLITUDES: i32 = 1024

// =============================================================================
// Math helpers for state simulation
// =============================================================================

fn sqrt_sim(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 20 { y = 0.5 * (y + x / y); i = i + 1 }
    y
}

// =============================================================================
// Qubit — A Linear Resource
// =============================================================================

// A qubit is a linear type: it MUST be consumed exactly once.
// The compiler will reject programs that:
//   1. Use a qubit twice (violates no-cloning)
//   2. Forget to use a qubit (violates no-deleting — optional)
//
// Internally, state_id indexes into the quantum simulator.
pub linear struct Qubit {
    state_id: i64,
}

// =============================================================================
// Quantum State Simulator
// =============================================================================
// For simulation/testing. A real quantum backend would replace this.
// State vector: 2^n complex amplitudes (max 10 qubits = 1024 amplitudes).
// We store real and imaginary parts separately.

pub struct QuantumState {
    real: [f64; 1024],
    imag: [f64; 1024],
    n_qubits: i32,
    n_amplitudes: i32,      // 2^n_qubits
    next_id: i64,
}

pub fn quantum_state_new() -> QuantumState with Mut, Div, Panic {
    var qs = QuantumState {
        real: [0.0; 1024],
        imag: [0.0; 1024],
        n_qubits: 0,
        n_amplitudes: 1,
        next_id: 0,
    }
    // |0...0⟩ state
    qs.real[0] = 1.0
    return qs
}

// =============================================================================
// Qubit Allocation
// =============================================================================

// Allocate a new qubit in the |0⟩ state.
// Panics if doubling the state vector would exceed QUANTUM_MAX_AMPLITUDES
// (the 11th qubit: 10 is the last that fits).
pub fn qubit_alloc(qs: &!QuantumState) -> Qubit with Mut, Div, Panic {
    let new_n = qs.n_amplitudes * 2
    if new_n > QUANTUM_MAX_AMPLITUDES {
        panic("QuantumState: QUANTUM_MAX_QUBITS exceeded")
    }
    let qid = qs.next_id
    qs.next_id = qs.next_id + 1
    qs.n_qubits = qs.n_qubits + 1
    qs.n_amplitudes = new_n
    Qubit { state_id: qid }
}

// =============================================================================
// Single-Qubit Gates
// =============================================================================
// Each gate CONSUMES the input qubit and RETURNS a new one.
// This is the linear type pattern: the old state is gone, replaced by new state.

// Hadamard gate: |0⟩ → (|0⟩ + |1⟩)/sqrt(2), |1⟩ → (|0⟩ - |1⟩)/sqrt(2)
pub fn hadamard(q: Qubit, qs: &!QuantumState) -> Qubit with Mut, Div, Panic {
    let qid = q.state_id     // consumes q (linear move)
    let target = qid as i32
    let inv_sqrt2 = 0.7071067811865476

    let n = qs.n_amplitudes
    let stride = 1 << target  // 2^target
    var i = 0
    while i < n {
        let bit = (i >> target) & 1
        if bit == 0 {
            let j = i | stride  // partner with bit=1
            let r0 = qs.real[i]
            let i0 = qs.imag[i]
            let r1 = qs.real[j]
            let i1 = qs.imag[j]
            qs.real[i] = inv_sqrt2 * (r0 + r1)
            qs.imag[i] = inv_sqrt2 * (i0 + i1)
            qs.real[j] = inv_sqrt2 * (r0 - r1)
            qs.imag[j] = inv_sqrt2 * (i0 - i1)
        }
        i = i + 1
    }

    Qubit { state_id: qid }
}

// Pauli-X (NOT gate): |0⟩ → |1⟩, |1⟩ → |0⟩
pub fn pauli_x(q: Qubit, qs: &!QuantumState) -> Qubit with Mut, Div, Panic {
    let qid = q.state_id
    let target = qid as i32
    let stride = 1 << target
    var i = 0
    while i < qs.n_amplitudes {
        let bit = (i >> target) & 1
        if bit == 0 {
            let j = i | stride
            let tmp_r = qs.real[i]
            let tmp_i = qs.imag[i]
            qs.real[i] = qs.real[j]
            qs.imag[i] = qs.imag[j]
            qs.real[j] = tmp_r
            qs.imag[j] = tmp_i
        }
        i = i + 1
    }
    Qubit { state_id: qid }
}

// Pauli-Y: |0⟩ → i|1⟩, |1⟩ → −i|0⟩
pub fn pauli_y(q: Qubit, qs: &!QuantumState) -> Qubit with Mut, Div, Panic {
    let qid = q.state_id
    let target = qid as i32
    let stride = 1 << target
    var i = 0
    while i < qs.n_amplitudes {
        let bit = (i >> target) & 1
        if bit == 0 {
            let j = i | stride
            let r0 = qs.real[i]
            let i0 = qs.imag[i]
            let r1 = qs.real[j]
            let i1 = qs.imag[j]
            // Y|1⟩ = −i|0⟩ → new |0⟩ amp = −i * old |1⟩
            qs.real[i] = i1
            qs.imag[i] = 0.0 - r1
            // Y|0⟩ = i|1⟩ → new |1⟩ amp = i * old |0⟩
            qs.real[j] = 0.0 - i0
            qs.imag[j] = r0
        }
        i = i + 1
    }
    Qubit { state_id: qid }
}

// Pauli-Z: |0⟩ → |0⟩, |1⟩ → -|1⟩
pub fn pauli_z(q: Qubit, qs: &!QuantumState) -> Qubit with Mut, Div, Panic {
    let qid = q.state_id
    let target = qid as i32
    var i = 0
    while i < qs.n_amplitudes {
        let bit = (i >> target) & 1
        if bit == 1 {
            qs.real[i] = 0.0 - qs.real[i]
            qs.imag[i] = 0.0 - qs.imag[i]
        }
        i = i + 1
    }
    Qubit { state_id: qid }
}

// S gate (phase gate): |0⟩ → |0⟩, |1⟩ → i|1⟩
pub fn s_gate(q: Qubit, qs: &!QuantumState) -> Qubit with Mut, Div, Panic {
    let qid = q.state_id
    let target = qid as i32
    var i = 0
    while i < qs.n_amplitudes {
        let bit = (i >> target) & 1
        if bit == 1 {
            // Multiply by i: (a + bi) * i = -b + ai
            let r = qs.real[i]
            let im = qs.imag[i]
            qs.real[i] = 0.0 - im
            qs.imag[i] = r
        }
        i = i + 1
    }
    Qubit { state_id: qid }
}

// T gate: |0⟩ → |0⟩, |1⟩ → e^{i*pi/4}|1⟩
pub fn t_gate(q: Qubit, qs: &!QuantumState) -> Qubit with Mut, Div, Panic {
    let qid = q.state_id
    let target = qid as i32
    let cos_pi4 = 0.7071067811865476
    let sin_pi4 = 0.7071067811865476
    var i = 0
    while i < qs.n_amplitudes {
        let bit = (i >> target) & 1
        if bit == 1 {
            let r = qs.real[i]
            let im = qs.imag[i]
            qs.real[i] = r * cos_pi4 - im * sin_pi4
            qs.imag[i] = r * sin_pi4 + im * cos_pi4
        }
        i = i + 1
    }
    Qubit { state_id: qid }
}

// =============================================================================
// Two-Qubit Gates
// =============================================================================

// CNOT: Controlled-NOT
// |control, target⟩: flips target if control is |1⟩
// Consumes BOTH qubits linearly, returns BOTH
pub struct QubitPair {
    pub first: Qubit,
    pub second: Qubit,
}

pub struct QubitTriple {
    pub first: Qubit,
    pub second: Qubit,
    pub third: Qubit,
}

pub fn cnot(control: Qubit, target: Qubit, qs: &!QuantumState) -> QubitPair with Mut, Div, Panic {
    let cid = control.state_id   // consumes control
    let tid = target.state_id    // consumes target
    let c = cid as i32
    let t = tid as i32
    let t_stride = 1 << t

    var i = 0
    while i < qs.n_amplitudes {
        let c_bit = (i >> c) & 1
        let t_bit = (i >> t) & 1
        // Only swap when control=1, target=0
        if c_bit == 1 {
            if t_bit == 0 {
                let j = i | t_stride  // same but target=1
                let tmp_r = qs.real[i]
                let tmp_i = qs.imag[i]
                qs.real[i] = qs.real[j]
                qs.imag[i] = qs.imag[j]
                qs.real[j] = tmp_r
                qs.imag[j] = tmp_i
            }
        }
        i = i + 1
    }

    QubitPair {
        first: Qubit { state_id: cid },
        second: Qubit { state_id: tid },
    }
}

// CZ: Controlled-Z. Phase −1 on |11⟩. Returns the pair, same as CNOT.
pub fn cz(control: Qubit, target: Qubit, qs: &!QuantumState) -> QubitPair with Mut, Div, Panic {
    let cid = control.state_id
    let tid = target.state_id
    let c = cid as i32
    let t = tid as i32

    var i = 0
    while i < qs.n_amplitudes {
        let c_bit = (i >> c) & 1
        let t_bit = (i >> t) & 1
        if c_bit == 1 {
            if t_bit == 1 {
                qs.real[i] = 0.0 - qs.real[i]
                qs.imag[i] = 0.0 - qs.imag[i]
            }
        }
        i = i + 1
    }

    QubitPair {
        first: Qubit { state_id: cid },
        second: Qubit { state_id: tid },
    }
}

// SWAP: exchange the two qubit bits. Returns the pair.
pub fn swap(q1: Qubit, q2: Qubit, qs: &!QuantumState) -> QubitPair with Mut, Div, Panic {
    let id1 = q1.state_id
    let id2 = q2.state_id
    let a = id1 as i32
    let b = id2 as i32
    let a_stride = 1 << a
    let b_stride = 1 << b

    var i = 0
    while i < qs.n_amplitudes {
        let a_bit = (i >> a) & 1
        let b_bit = (i >> b) & 1
        if a_bit == 0 {
            if b_bit == 1 {
                let j = i ^ a_stride ^ b_stride
                let tmp_r = qs.real[i]
                let tmp_i = qs.imag[i]
                qs.real[i] = qs.real[j]
                qs.imag[i] = qs.imag[j]
                qs.real[j] = tmp_r
                qs.imag[j] = tmp_i
            }
        }
        i = i + 1
    }

    QubitPair {
        first: Qubit { state_id: id1 },
        second: Qubit { state_id: id2 },
    }
}

// =============================================================================
// Measurement — Collapses the Qubit (consumes it forever!)
// =============================================================================
// Measurement is the ultimate linear consumption: the qubit ceases to exist
// as a quantum resource and becomes a classical bit.
//
// Returns: true for |1⟩, false for |0⟩

pub struct MeasurementResult {
    pub outcome: bool,          // true = |1⟩, false = |0⟩
    pub probability: f64,       // probability of the observed outcome
}

pub fn measure_qubit(q: Qubit, qs: &!QuantumState, rng_seed: f64) -> MeasurementResult with Mut, Div, Panic {
    let qid = q.state_id        // consumes q — qubit ceases to exist
    let target = qid as i32
    let stride = 1 << target

    // Compute probability of measuring |1⟩
    var prob_one: f64 = 0.0
    var i = 0
    while i < qs.n_amplitudes {
        let bit = (i >> target) & 1
        if bit == 1 {
            prob_one = prob_one + qs.real[i] * qs.real[i] + qs.imag[i] * qs.imag[i]
        }
        i = i + 1
    }

    // Pseudo-random "coin flip" using seed (deterministic for reproducibility)
    let coin = rng_seed  // should be uniform [0,1)
    let outcome = coin < prob_one

    // Collapse: zero out the non-observed branch and renormalize
    let prob_observed = if outcome { prob_one } else { 1.0 - prob_one }
    let norm = if prob_observed > 1.0e-30 { 1.0 / sqrt_sim(prob_observed) } else { 0.0 }

    i = 0
    while i < qs.n_amplitudes {
        let bit = (i >> target) & 1
        let keep = if outcome { bit == 1 } else { bit == 0 }
        if keep {
            qs.real[i] = qs.real[i] * norm
            qs.imag[i] = qs.imag[i] * norm
        } else {
            qs.real[i] = 0.0
            qs.imag[i] = 0.0
        }
        i = i + 1
    }

    // Qubit q is consumed here — linear type system ensures it cannot be used again
    MeasurementResult {
        outcome: outcome,
        probability: prob_observed,
    }
}

// =============================================================================
// Bell Pair — Entanglement via H + CNOT
// =============================================================================
// Creates the Bell state |Φ+⟩ = (|00⟩ + |11⟩)/sqrt(2)

pub fn bell_pair(q1: Qubit, q2: Qubit, qs: &!QuantumState) -> QubitPair with Mut, Div, Panic {
    let h_q1 = hadamard(q1, qs)
    cnot(h_q1, q2, qs)
}

// =============================================================================
// GHZ3 — H on the first qubit, CNOT chain
// =============================================================================
// |GHZ⟩ = (|000⟩ + |111⟩)/sqrt(2)

pub fn ghz3(q0: Qubit, q1: Qubit, q2: Qubit, qs: &!QuantumState) -> QubitTriple with Mut, Div, Panic {
    let h0 = hadamard(q0, qs)
    let QubitPair { first: a, second: b } = cnot(h0, q1, qs)
    let QubitPair { first: b2, second: c } = cnot(b, q2, qs)
    QubitTriple { first: a, second: b2, third: c }
}

// =============================================================================
// Teleportation
// =============================================================================
// Bell on the channel (alice, bob), CNOT+H on the message, two measurements,
// then X/Z corrections on the target. Three linear qubits in; one qubit out
// plus two classical bits.

pub struct TeleportResult {
    pub qubit: Qubit,
    pub m1: bool,
    pub m2: bool,
}

pub fn teleport(msg: Qubit, alice: Qubit, bob: Qubit, qs: &!QuantumState, seed1: f64, seed2: f64) -> TeleportResult with Mut, Div, Panic {
    let QubitPair { first: alice_b, second: bob_b } = bell_pair(alice, bob, qs)
    let QubitPair { first: msg2, second: alice2 } = cnot(msg, alice_b, qs)
    let msg_h = hadamard(msg2, qs)
    let m1 = measure_qubit(msg_h, qs, seed1)
    let m2 = measure_qubit(alice2, qs, seed2)

    // Consume bob_b before the classical branches so the linear value
    // is not live across an `if`. X/Z act on the statevector by id.
    let bid = bob_b.state_id
    let t = bid as i32
    if m2.outcome {
        let stride = 1 << t
        var i = 0
        while i < qs.n_amplitudes {
            let bit = (i >> t) & 1
            if bit == 0 {
                let j = i | stride
                let tmp_r = qs.real[i]
                let tmp_i = qs.imag[i]
                qs.real[i] = qs.real[j]
                qs.imag[i] = qs.imag[j]
                qs.real[j] = tmp_r
                qs.imag[j] = tmp_i
            }
            i = i + 1
        }
    }
    if m1.outcome {
        var i = 0
        while i < qs.n_amplitudes {
            let bit = (i >> t) & 1
            if bit == 1 {
                qs.real[i] = 0.0 - qs.real[i]
                qs.imag[i] = 0.0 - qs.imag[i]
            }
            i = i + 1
        }
    }

    TeleportResult {
        qubit: Qubit { state_id: bid },
        m1: m1.outcome,
        m2: m2.outcome,
    }
}

// =============================================================================
// State Inspection (for simulation/testing only)
// =============================================================================

pub struct StateInfo {
    pub n_qubits: i32,
    pub n_amplitudes: i32,
    pub prob_zero: f64,     // probability of all-zeros state
    pub total_prob: f64,    // should be 1.0 (normalization check)
}

pub fn quantum_state_info(qs: &QuantumState) -> StateInfo with Mut, Div, Panic {
    var total: f64 = 0.0
    var i = 0
    while i < qs.n_amplitudes {
        total = total + qs.real[i] * qs.real[i] + qs.imag[i] * qs.imag[i]
        i = i + 1
    }
    let p0 = qs.real[0] * qs.real[0] + qs.imag[0] * qs.imag[0]

    StateInfo {
        n_qubits: qs.n_qubits,
        n_amplitudes: qs.n_amplitudes,
        prob_zero: p0,
        total_prob: total,
    }
}

pub fn amp_real(qs: &QuantumState, idx: i32) -> f64 with Mut, Div, Panic {
    if idx < 0 { return 0.0 }
    if idx >= qs.n_amplitudes { return 0.0 }
    qs.real[idx]
}

pub fn amp_imag(qs: &QuantumState, idx: i32) -> f64 with Mut, Div, Panic {
    if idx < 0 { return 0.0 }
    if idx >= qs.n_amplitudes { return 0.0 }
    qs.imag[idx]
}

pub fn amp_prob(qs: &QuantumState, idx: i32) -> f64 with Mut, Div, Panic {
    let re = amp_real(qs, idx)
    let im = amp_imag(qs, idx)
    re * re + im * im
}
