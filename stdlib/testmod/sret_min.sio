//! stdlib/testmod/sret_min.sio
//! Minimal cross-module large-struct SRET forwarding repro dependency module.
//! Returns a Big struct { c: [i64; 256], bits } by value across a module boundary.

pub struct Big {
    c: [i64; 256],
    bits: i32,
}

pub fn big_zero(k: i32) -> Big with Mut, Panic {
    Big { c: [0; 256], bits: k }
}

pub fn big_basis(k: i32, idx: i32) -> Big with Mut, Panic {
    var r = big_zero(k)
    r.c[idx as usize] = 1
    return r
}

// ---- controls: scalar + small-struct cross-module returns ----
pub struct Small {
    c: [i64; 4],
    bits: i32,
}

pub fn imported_scalar(x: i64) -> i64 with Mut, Panic {
    return x + 1
}

pub fn small_basis(k: i32, idx: i32) -> Small with Mut, Panic {
    var r = Small { c: [0; 4], bits: k }
    r.c[idx as usize] = 1
    return r
}

pub fn small_zero(k: i32) -> Small with Mut, Panic {
    Small { c: [0; 4], bits: k }
}

// small struct BUT forwards through an inner same-module struct-returning call
// (same shape as big_basis). Bisects size vs inner-call-remap.
pub fn small_basis_fwd(k: i32, idx: i32) -> Small with Mut, Panic {
    var r = small_zero(k)
    r.c[idx as usize] = 1
    return r
}

// medium structs to bracket a size threshold, all using the forwarding pattern.
pub struct M16 { c: [i64; 16], bits: i32 }
pub struct M64 { c: [i64; 64], bits: i32 }

pub fn m16_zero(k: i32) -> M16 with Mut, Panic { M16 { c: [0; 16], bits: k } }
pub fn m16_basis_fwd(k: i32, idx: i32) -> M16 with Mut, Panic {
    var r = m16_zero(k)
    r.c[idx as usize] = 1
    return r
}
pub fn m64_zero(k: i32) -> M64 with Mut, Panic { M64 { c: [0; 64], bits: k } }
pub fn m64_basis_fwd(k: i32, idx: i32) -> M64 with Mut, Panic {
    var r = m64_zero(k)
    r.c[idx as usize] = 1
    return r
}

// add: forwards through a struct-returning call and mutates a large [i64;256] field.
pub fn big_add(a: Big, b: Big) -> Big with Mut, Panic {
    var r = big_zero(a.bits)
    var i: i32 = 0
    while i < 256 {
        r.c[i as usize] = a.c[i as usize] + b.c[i as usize]
        i = i + 1
    }
    return r
}
