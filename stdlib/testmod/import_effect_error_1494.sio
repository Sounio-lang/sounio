// Test-only module for #1494: an effect error inside an IMPORTED function.
// `quiet_value` calls `noisy_value`, which declares `with IO`, but does not
// declare IO itself. tests/compile-fail/imported_module_effect_error_is_fatal_issue_1494.sio
// imports it; the missing effect must refuse the program on both engines.

pub fn noisy_value() -> i64 with IO {
    println(1)
    3
}

pub fn quiet_value() -> i64 {
    noisy_value()
}
