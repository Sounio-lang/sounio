//! stdlib/testmod/dep_chain_mid.sio
//! Mid module for PR #2515 review round 2, finding D's witness fixture
//! (comment_id 4089110737): calls testmod::dep_chain_leaf through its
//! module-qualified path. A seed/main module that `use`s ONLY
//! testmod::dep_chain_mid (not testmod::dep_chain_leaf directly) must still
//! resolve this qualified call correctly when dep_chain_mid is lowered as a
//! dependency -- the registry entry for `dep_chain_leaf` comes entirely
//! from THIS file's own `use` line below, collected by the multi-module
//! preregister pass across the whole loaded module graph
//! (module_frontend.sio), not from anything the seed itself `use`s.
use testmod::dep_chain_leaf;

pub fn mid_call(x: i64) -> i64 with Mut, Panic {
    dep_chain_leaf::leaf_add(x, 1)
}
