//! stdlib/testmod/gen_big_wrapper.sio
//! Witness fixture for PR #2515 review round 7, finding A (comment_id
//! 4091287518): imports testmod::gen_big so a program that imports THIS
//! module (but never imports testmod::gen_big itself) still has gen_big
//! loaded as part of the whole compilation -- exactly the shape needed to
//! test whether a DIFFERENT module can illegitimately borrow gen_big's
//! qualifier from this one. The qualified GENERIC call below is legitimate
//! here because THIS module's own `use` line registers `gen_big` as a known
//! module -- mirrors testmod::dep_chain_mid's convention.
use testmod::gen_big;

pub fn wrapper_touch(k: i64, z: i64) -> i64 with Mut, Panic {
    let g = gen_big::gbig_basis::<i64>(k, 0, z, z)
    g.bits
}
