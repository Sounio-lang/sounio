//! stdlib/testmod/nr_a.sio -- test-only module for #2773 (module-local name
//! resolution). Defines pub fns spelled exactly like testmod::nr_b's. A module's
//! unqualified call to its own function must run its own body, whichever
//! module's same-named fn the main file imported.
pub fn nr_energy() -> f64 { 1.5 }
pub fn nr_scale() -> f64 { 2.0 }
pub fn nr_a_twice() -> f64 { nr_energy() * nr_scale() }
