//! stdlib/testmod/uses_named_tc_c.sio
//! Witness fixture for PR #2515 review round 7, finding B (comment_id
//! 4091287602): imports `tc_c` as a NAMED FUNCTION (path-form named-item
//! import, see stdlib/testmod/named_item_holder.sio) -- module_frontend.sio's
//! resolve_import_file_path fallback records the full path
//! "testmod::named_item_holder::tc_c" via lower_named_item_terminal_note,
//! keyed by the FULL joined path (ast_path_prefix_name), not the bare
//! terminal "tc_c". Before the fix, a bare-name-keyed registry entry for
//! "tc_c" here would collide with the unrelated REAL module `testmod::tc_c`
//! used by stdlib/testmod/uses_real_tc_c_module.sio in the same compilation.
use testmod::named_item_holder::tc_c;

pub fn call_named_tc_c(x: i64) -> i64 with Mut, Panic {
    tc_c(x)
}
