//! stdlib/testmod/gen_big.sio
//! Minimal GENERIC cross-module large-array-struct summary-lowering repro.
//! Mirrors stdlib/algebra/cayley_dickson_exact.sio's CDElementExact<F> shape:
//! a generic struct with a large [F; 2048] array field, returned by-value from a
//! generic function, imported + monomorphised via turbofish in the caller.

// Copilot review (PR #2515), comment 4109848820: `c`/`bits` were private,
// but tests/run-pass/gen_dep_summary_min.sio and
// tests/run-pass/madaros_module_qualified_generic_call.sio both read them
// straight from the caller's module (`r.c[3]`, `r.bits`, etc.) -- the
// checker's own private-field denial for this specific case relied
// entirely on the empty-path bypass this review is closing, so leaving
// them private was a real access-control hole this test suite was
// silently exercising. Marked pub instead of adding an accessor: this
// struct exists solely as a cross-module generic-lowering repro fixture,
// and both call sites already treat direct field access as their whole
// point.
pub struct GBig<F> {
    pub c: [F; 2048],
    pub bits: i64,
}

pub fn gbig_zero<F>(k: i64, z: F) -> GBig<F> with Mut, Panic {
    GBig { c: [z; 2048], bits: k }
}

pub fn gbig_basis<F>(k: i64, idx: i64, z: F, o: F) -> GBig<F> with Mut, Panic {
    var r = gbig_zero::<F>(k, z)
    r.c[idx as usize] = o
    return r
}
