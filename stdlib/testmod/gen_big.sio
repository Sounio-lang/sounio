//! stdlib/testmod/gen_big.sio
//! Minimal GENERIC cross-module large-array-struct summary-lowering repro.
//! Mirrors stdlib/algebra/cayley_dickson_exact.sio's CDElementExact<F> shape:
//! a generic struct with a large [F; 2048] array field, returned by-value from a
//! generic function, imported + monomorphised via turbofish in the caller.

pub struct GBig<F> {
    c: [F; 2048],
    bits: i64,
}

pub fn gbig_zero<F>(k: i64, z: F) -> GBig<F> with Mut, Panic {
    GBig { c: [z; 2048], bits: k }
}

pub fn gbig_basis<F>(k: i64, idx: i64, z: F, o: F) -> GBig<F> with Mut, Panic {
    var r = gbig_zero::<F>(k, z)
    r.c[idx as usize] = o
    return r
}
