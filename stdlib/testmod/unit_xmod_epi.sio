//! stdlib/testmod/unit_xmod_epi.sio — helper module for
//! tests/run-pass/unit_xmod_epistemic_clone.sio. The units are declared HERE,
//! not in the caller, and are not `pub`: the shape of
//! stdlib/darwin_pbpk/circ28_drug.sio (cd_ka_dt, cd_half_life).
unit per_h = 1 / h
unit L_per_h = L / h
pub fn uxe_ka_dt(ka: per_h, dt: h) -> f64 { return (ka * dt) as f64 }
pub fn uxe_cast(ka: per_h) -> f64 { return ka as f64 }
pub fn uxe_half_life(cl: L_per_h, v: L) -> f64 {
    let k = cl / v
    return 0.693 / (k as f64)
}
pub fn uxe_scale(q: L_per_h, e: f64) -> f64 { return (q * e) as f64 }
