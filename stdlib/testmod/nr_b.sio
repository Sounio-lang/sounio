//! stdlib/testmod/nr_b.sio -- test-only module for #2773; see nr_a.sio.
//! nr_b_shadow also pins local scoping: the `let nr_energy` binder shadows the
//! fn only AFTER its own initializer, which still calls nr_b's nr_energy().
pub fn nr_energy() -> f64 { 0.0 - 7.25 }
pub fn nr_scale() -> f64 { 10.0 }
pub fn nr_b_other() -> f64 { nr_energy() * 2.0 }
pub fn nr_b_shadow() -> f64 {
    let nr_energy = nr_energy() + 1.0
    nr_energy * nr_scale()
}
