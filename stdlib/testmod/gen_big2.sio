//! stdlib/testmod/gen_big2.sio
//! A10 bisect v2: generic large-array struct dep WITH a trait + impl-for-i64 +
//! trait-bounded generics (closely mirrors cayley_dickson_exact.sio, but with NO
//! cross-module impl). Tests whether trait/impl/bound in the generic dep triggers
//! the summary-lowering SIGSEGV.

trait ERing {
    fn er_add(self, o: Self) -> Self with Mut, Div, Panic
    fn er_mul(self, o: Self) -> Self with Mut, Div, Panic
    fn er_is_zero(self) -> bool
}

impl ERing for i64 {
    fn er_add(self, o: Self) -> Self with Mut, Div, Panic { self + o }
    fn er_mul(self, o: Self) -> Self with Mut, Div, Panic { self * o }
    fn er_is_zero(self) -> bool { self == 0 }
}

pub struct GBig2<F: ERing> {
    c: [F; 2048],
    bits: i32,
}

pub fn gbig2_zero<F: ERing>(k: i32, zero: F) -> GBig2<F> with Mut, Panic {
    GBig2 { c: [zero; 2048], bits: k }
}

pub fn gbig2_basis<F: ERing>(k: i32, idx: i32, zero: F, one: F) -> GBig2<F> with Mut, Panic {
    var r = gbig2_zero::<F>(k, zero)
    if idx >= 0 && idx < (1 << k) {
        r.c[idx as usize] = one
    }
    r
}
