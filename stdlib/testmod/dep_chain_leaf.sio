//! stdlib/testmod/dep_chain_leaf.sio
//! Leaf module for PR #2515 review round 2, finding D's witness fixture
//! (comment_id 4089110737): a transitive-dependency module-qualified-call
//! chain, where the qualifying module (this file) is only ever `use`d by
//! testmod::dep_chain_mid, never directly by a test's own seed/main module.

pub fn leaf_add(a: i64, b: i64) -> i64 with Mut, Panic {
    a + b + 10000
}
