//! stdlib/testmod/uses_real_tc_c_module.sio
//! Witness fixture for PR #2515 review round 7, finding B (comment_id
//! 4091287602): imports the REAL `testmod::tc_c` module (stdlib/testmod/tc_c.sio,
//! a genuine file, not a named-item fallback) and calls through its
//! module-qualified path. In the same compilation as
//! stdlib/testmod/uses_named_tc_c.sio (which registers a DIFFERENT, unrelated
//! named-item import whose terminal segment also happens to be "tc_c"), this
//! module's own qualified call must still resolve correctly -- the two
//! registry entries differ only by full path
//! ("testmod::tc_c" vs "testmod::named_item_holder::tc_c"), so they must not
//! collide.
use testmod::tc_c;

pub fn call_real_tc_c(a: i64, b: i64) -> i64 with Mut, Panic {
    tc_c::tc_c_add(a, b)
}
