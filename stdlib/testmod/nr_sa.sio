//! stdlib/testmod/nr_sa.sio -- test-only module for #2773 (same-named structs).
//! NrRes differs from testmod::nr_sb's NrRes; NrPt is identical to
//! testmod::nr_sc's NrPt.
pub struct NrRes { a: f64 }
pub struct NrPt { x: f64, y: f64 }
pub fn nr_sa_res(v: f64) -> f64 {
    let r = NrRes { a: v }
    r.a
}
pub fn nr_sa_pt_sum(v: f64) -> f64 {
    let p = NrPt { x: v, y: 1.0 }
    p.x + p.y
}
