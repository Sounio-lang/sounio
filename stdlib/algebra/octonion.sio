// stdlib/algebra/octonion.sio
// Verified octonionic arithmetic with Fano-selective enforcement.
//
// The octonions O form the largest normed division algebra (dim 8).
// Multiplication is non-commutative and non-associative, but alternative:
//   (aa)b = a(ab)  and  (ba)a = b(aa)   [Artin's theorem]
//
// The 7 imaginary units e1..e7 multiply according to the Fano plane PG(2,2).
// The 7 lines of the Fano plane define the 42 ordered triples where
// multiplication is associative. The remaining 168 triples are non-associative,
// with associator (ei,ej,ek) = ±2.
//
// This module uses the Cayley-Dickson doubling construction:
//   O = H + H*e  where e² = -1
// The sign convention follows Albuquerque-Majid (1999):
//   σ(a,b) = (-1)^f(a,b) where f is the canonical 2-cocycle.
//
// The algebra declaration enables Fano-selective optimization:
//   The e-graph may reassociate (a*b)*c ↔ a*(b*c) ONLY on Fano lines.

algebra Octonion over f64 {
    add: commutative, associative
    mul: alternative, non_commutative
    reassociate: fano_selective
}

// === Octonion representation ===
// Stored as 8 f64 components: [e0, e1, e2, e3, e4, e5, e6, e7]
// where e0 = real part, e1..e7 = imaginary units.

// Cayley-Dickson sign: σ(a,b) at tower level `bits`.
// Verified in Lean 4 (SounioCayleyDickson.lean) and in the compiler
// (ir_cd_sigma in self-hosted/ir/algebra.sio). This is the exact same algorithm.
fn cd_sigma_r(a: i64, b: i64, bits: i64) -> i64 with Mut, Div {
    if a == 0 || b == 0 { return 1 }
    if bits <= 1 { return 0 - 1 }
    let half = 1 << (bits - 1)
    let a_hi = if a >= half { 1 } else { 0 }
    let b_hi = if b >= half { 1 } else { 0 }
    let a_lo = a & (half - 1)
    let b_lo = b & (half - 1)
    if a_hi == 0 && b_hi == 0 { return cd_sigma_r(a_lo, b_lo, bits - 1) }
    if a_hi == 0 && b_hi == 1 { return cd_sigma_r(b_lo, a_lo, bits - 1) }
    if a_hi == 1 && b_hi == 0 {
        if b_lo == 0 { return cd_sigma_r(a_lo, b_lo, bits - 1) }
        return 0 - cd_sigma_r(a_lo, b_lo, bits - 1)
    }
    if b_lo == 0 { return 0 - cd_sigma_r(b_lo, a_lo, bits - 1) }
    cd_sigma_r(b_lo, a_lo, bits - 1)
}

// Octonion sign: σ(a,b) for basis elements a,b ∈ {0..7}
fn cd_sigma(a: i64, b: i64) -> i64 with Mut, Div {
    cd_sigma_r(a, b, 3)
}

// Sedenion sign: σ(a,b) for basis elements a,b ∈ {0..15}
fn cd_sigma_sedenion(a: i64, b: i64) -> i64 with Mut, Div {
    cd_sigma_r(a, b, 4)
}

// Basis product: ei * ej = sigma(i,j) * e_{i XOR j}  (for i,j > 0)
//                ei * e0 = ei, e0 * ei = ei, e0 * e0 = e0
fn basis_product_index(i: i64, j: i64) -> i64 {
    if i == 0 { return j }
    if j == 0 { return i }
    // XOR gives the result index for Cayley-Dickson
    let k = i
    // Use bitwise XOR
    let xor_val = (i + j) - 2 * (i / 2 + j / 2 - (i + j) / 2 + (i / 4 + j / 4 - (i + j) / 4) * 2)
    // Simplified: for octonion basis, i XOR j is just the standard XOR
    // Since we can't do bitwise XOR directly, use the ir_cd_sigma approach
    i
}

// === Core multiplication ===
// Full octonion product: component-by-component using sign table.
// c = a * b where a,b,c are [f64; 8]

fn oct_mul(a: &[f64; 8], b: &[f64; 8], out: &![f64; 8]) with Mut, Div, NonAssoc {
    // out[k] = sum over all (i,j) where basis_product(i,j) has index k
    //        = sum_i sum_j  a[i] * b[j] * sigma(i,j)  where (i XOR j) == k
    //
    // Direct 8x8 expansion (no loops over basis — fully unrolled for clarity):
    // e0 component (real part):
    var r0 = a[0] * b[0]
    r0 = r0 - a[1] * b[1]
    r0 = r0 - a[2] * b[2]
    r0 = r0 - a[3] * b[3]
    r0 = r0 - a[4] * b[4]
    r0 = r0 - a[5] * b[5]
    r0 = r0 - a[6] * b[6]
    r0 = r0 - a[7] * b[7]
    out[0] = r0

    // e1 component:
    var r1 = a[0] * b[1] + a[1] * b[0]
    r1 = r1 + a[2] * b[3] - a[3] * b[2]
    r1 = r1 + a[4] * b[5] - a[5] * b[4]
    r1 = r1 - a[6] * b[7] + a[7] * b[6]
    out[1] = r1

    // e2 component:
    var r2 = a[0] * b[2] + a[2] * b[0]
    r2 = r2 - a[1] * b[3] + a[3] * b[1]
    r2 = r2 + a[4] * b[6] - a[6] * b[4]
    r2 = r2 + a[5] * b[7] - a[7] * b[5]
    out[2] = r2

    // e3 component:
    var r3 = a[0] * b[3] + a[3] * b[0]
    r3 = r3 + a[1] * b[2] - a[2] * b[1]
    r3 = r3 + a[4] * b[7] - a[7] * b[4]
    r3 = r3 - a[5] * b[6] + a[6] * b[5]
    out[3] = r3

    // e4 component:
    var r4 = a[0] * b[4] + a[4] * b[0]
    r4 = r4 - a[1] * b[5] + a[5] * b[1]
    r4 = r4 - a[2] * b[6] + a[6] * b[2]
    r4 = r4 - a[3] * b[7] + a[7] * b[3]
    out[4] = r4

    // e5 component:
    var r5 = a[0] * b[5] + a[5] * b[0]
    r5 = r5 + a[1] * b[4] - a[4] * b[1]
    r5 = r5 - a[2] * b[7] + a[7] * b[2]
    r5 = r5 + a[3] * b[6] - a[6] * b[3]
    out[5] = r5

    // e6 component:
    var r6 = a[0] * b[6] + a[6] * b[0]
    r6 = r6 + a[1] * b[7] - a[7] * b[1]
    r6 = r6 + a[2] * b[4] - a[4] * b[2]
    r6 = r6 - a[3] * b[5] + a[5] * b[3]
    out[6] = r6

    // e7 component:
    var r7 = a[0] * b[7] + a[7] * b[0]
    r7 = r7 - a[1] * b[6] + a[6] * b[1]
    r7 = r7 + a[2] * b[5] - a[5] * b[2]
    r7 = r7 + a[3] * b[4] - a[4] * b[3]
    out[7] = r7
}

// === Associator ===
// [a,b,c] = (a*b)*c - a*(b*c)
// Returns the associator as an octonion (8 components).

fn oct_associator(
    a: &[f64; 8], b: &[f64; 8], c: &[f64; 8],
    out: &![f64; 8]
) with Mut, Div, NonAssoc {
    // (a*b)*c
    var ab: [f64; 8] = [0.0; 8]
    oct_mul(a, b, &!ab)
    var ab_c: [f64; 8] = [0.0; 8]
    oct_mul(&ab, c, &!ab_c)

    // a*(b*c)
    var bc: [f64; 8] = [0.0; 8]
    oct_mul(b, c, &!bc)
    var a_bc: [f64; 8] = [0.0; 8]
    oct_mul(a, &bc, &!a_bc)

    // [a,b,c] = (a*b)*c - a*(b*c)
    var i: i64 = 0
    while i < 8 {
        out[i] = ab_c[i] - a_bc[i]
        i = i + 1
    }
}

// === Norm ===
// |a|² = a0² + a1² + ... + a7²
fn oct_norm_sq(a: &[f64; 8]) -> f64 with Mut {
    var sum: f64 = 0.0
    var i: i64 = 0
    while i < 8 { sum = sum + a[i] * a[i]; i = i + 1 }
    sum
}

// === Basis element constructors ===
fn oct_basis(idx: i64) -> [f64; 8] {
    var o: [f64; 8] = [0.0; 8]
    o[idx] = 1.0
    o
}

fn oct_real(x: f64) -> [f64; 8] {
    var o: [f64; 8] = [0.0; 8]
    o[0] = x
    o
}

// === Fano predicate (mirrors ir_can_reassociate_triple) ===
// Returns true if (ei, ej, ek) lie on a Fano line (associative triple).
fn is_fano_triple(i: i64, j: i64, k: i64) -> bool with Mut, Div {
    if i == 0 || j == 0 || k == 0 { return true }
    if i == j || j == k || i == k { return true }
    let alpha_1 = cd_sigma(i, j)
    let ij_xor = oct_xor(i, j)
    let alpha_2 = cd_sigma(ij_xor, k)
    let alpha = alpha_1 * alpha_2
    let beta_1 = cd_sigma(j, k)
    let jk_xor = oct_xor(j, k)
    let beta_2 = cd_sigma(i, jk_xor)
    let beta = beta_1 * beta_2
    alpha == beta
}

// Integer XOR for basis indices 0..7
fn oct_xor(a: i64, b: i64) -> i64 {
    // Bit-by-bit XOR for 3-bit integers
    let a0 = a - (a / 2) * 2
    let b0 = b - (b / 2) * 2
    let a1 = (a / 2) - (a / 4) * 2
    let b1 = (b / 2) - (b / 4) * 2
    let a2 = a / 4
    let b2 = b / 4
    let x0 = if a0 == b0 { 0 } else { 1 }
    let x1 = if a1 == b1 { 0 } else { 1 }
    let x2 = if a2 == b2 { 0 } else { 1 }
    x0 + 2 * x1 + 4 * x2
}

// === Associator norm for basis triple ===
// |[ei, ej, ek]|² — should be 0 for Fano lines, 8 for non-Fano
fn basis_associator_norm_sq(i: i64, j: i64, k: i64) -> f64 with Mut, Div, NonAssoc {
    var a = oct_basis(i)
    var b = oct_basis(j)
    var c = oct_basis(k)
    var assoc: [f64; 8] = [0.0; 8]
    oct_associator(&a, &b, &c, &!assoc)
    oct_norm_sq(&assoc)
}
