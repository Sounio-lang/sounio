// stdlib/algebra/octonion.sio
// Verified octonionic arithmetic with Fano-selective enforcement.
//
// The octonions O form the largest normed division algebra (dim 8).
// Multiplication is non-commutative and non-associative, but alternative:
//   (aa)b = a(ab)  and  (ba)a = b(aa)   [Artin's theorem]
//
// The 7 imaginary units e1..e7 multiply according to the Fano plane PG(2,2).
// The 7 lines of the Fano plane define the 42 ordered triples where
// multiplication is associative. The remaining 168 triples are non-associative,
// with associator (ei,ej,ek) = ±2.
//
// This module uses the Cayley-Dickson doubling construction:
//   O = H + H*e  where e² = -1
// The sign convention follows Albuquerque-Majid (1999):
//   σ(a,b) = (-1)^f(a,b) where f is the canonical 2-cocycle.
//
// The algebra declaration enables Fano-selective optimization:
//   The e-graph may reassociate (a*b)*c ↔ a*(b*c) ONLY on Fano lines.

algebra Octonion over f64 {
    add: commutative, associative
    mul: alternative, non_commutative
    reassociate: fano_selective
}

// === Octonion representation ===
// Stored as 8 f64 components: [e0, e1, e2, e3, e4, e5, e6, e7]
// where e0 = real part, e1..e7 = imaginary units.

// Cayley-Dickson sign: σ(a,b) at tower level `bits`.
// Verified in Lean 4 (SounioCayleyDickson.lean) and in the compiler
// (ir_cd_sigma in self-hosted/ir/algebra.sio). This is the exact same algorithm.
fn cd_sigma_r(a: i64, b: i64, bits: i64) -> i64 with Mut, Div {
    if a == 0 || b == 0 { return 1 }
    if bits <= 1 { return 0 - 1 }
    let half = 1 << (bits - 1)
    let a_hi = if a >= half { 1 } else { 0 }
    let b_hi = if b >= half { 1 } else { 0 }
    let a_lo = a & (half - 1)
    let b_lo = b & (half - 1)
    if a_hi == 0 && b_hi == 0 { return cd_sigma_r(a_lo, b_lo, bits - 1) }
    if a_hi == 0 && b_hi == 1 { return cd_sigma_r(b_lo, a_lo, bits - 1) }
    if a_hi == 1 && b_hi == 0 {
        if b_lo == 0 { return cd_sigma_r(a_lo, b_lo, bits - 1) }
        return 0 - cd_sigma_r(a_lo, b_lo, bits - 1)
    }
    if b_lo == 0 { return 0 - cd_sigma_r(b_lo, a_lo, bits - 1) }
    cd_sigma_r(b_lo, a_lo, bits - 1)
}

// Octonion sign: σ(a,b) for basis elements a,b ∈ {0..7}
pub fn cd_sigma(a: i64, b: i64) -> i64 with Mut, Div {
    cd_sigma_r(a, b, 3)
}

// Sedenion sign: σ(a,b) for basis elements a,b ∈ {0..15}
pub fn cd_sigma_sedenion(a: i64, b: i64) -> i64 with Mut, Div {
    cd_sigma_r(a, b, 4)
}

// Basis product: ei * ej = sigma(i,j) * e_{i XOR j}  (for i,j > 0)
//                ei * e0 = ei, e0 * ei = ei, e0 * e0 = e0
fn basis_product_index(i: i64, j: i64) -> i64 {
    if i == 0 { return j }
    if j == 0 { return i }
    // XOR gives the result index for Cayley-Dickson
    let k = i
    // Use bitwise XOR
    let xor_val = (i + j) - 2 * (i / 2 + j / 2 - (i + j) / 2 + (i / 4 + j / 4 - (i + j) / 4) * 2)
    // Simplified: for octonion basis, i XOR j is just the standard XOR
    // Since we can't do bitwise XOR directly, use the ir_cd_sigma approach
    i
}

// === Core multiplication ===
// Full octonion product: component-by-component using sign table.
// c = a * b where a,b,c are [f64; 8]
//
// Madaros large-body note (2026-07-20):
// - #1274: lo/hi split keeps each helper ≤ ~0x1200 frame / well under IR caps.
// - #1292: vreg tables 512→2048 (silent high-vreg drop).
// - Unsplit full 8-component exclusive-ref body lowers to ~2180 IR ops; under
//   IR_MAX_INSTRS=2048 the body filled the array, IrReturn was dropped, and
//   core_ir fallthrough re-entered main (ENTER/BEFORE_MUL). Fixed by raising
//   IR_MAX_INSTRS to 4096 + synthetic epilogue defense. Gate:
//   scripts/madaros_unsplit_oct_mul_gate.sh
// Keep the lo/hi split as defense-in-depth for older Madaros binaries and
// multi-module import paths; public API/math unchanged.

fn oct_mul_lo(a: &[f64; 8], b: &[f64; 8], out: &![f64; 8]) with Mut, Div, NonAssoc {
    // e0..e3
    var r0 = a[0] * b[0]
    r0 = r0 - a[1] * b[1]
    r0 = r0 - a[2] * b[2]
    r0 = r0 - a[3] * b[3]
    r0 = r0 - a[4] * b[4]
    r0 = r0 - a[5] * b[5]
    r0 = r0 - a[6] * b[6]
    r0 = r0 - a[7] * b[7]
    out[0] = r0

    var r1 = a[0] * b[1] + a[1] * b[0]
    r1 = r1 + a[2] * b[3] - a[3] * b[2]
    r1 = r1 + a[4] * b[5] - a[5] * b[4]
    r1 = r1 - a[6] * b[7] + a[7] * b[6]
    out[1] = r1

    var r2 = a[0] * b[2] + a[2] * b[0]
    r2 = r2 - a[1] * b[3] + a[3] * b[1]
    r2 = r2 + a[4] * b[6] - a[6] * b[4]
    r2 = r2 + a[5] * b[7] - a[7] * b[5]
    out[2] = r2

    var r3 = a[0] * b[3] + a[3] * b[0]
    r3 = r3 + a[1] * b[2] - a[2] * b[1]
    r3 = r3 + a[4] * b[7] - a[7] * b[4]
    r3 = r3 - a[5] * b[6] + a[6] * b[5]
    out[3] = r3
}

fn oct_mul_hi(a: &[f64; 8], b: &[f64; 8], out: &![f64; 8]) with Mut, Div, NonAssoc {
    // e4..e7
    var r4 = a[0] * b[4] + a[4] * b[0]
    r4 = r4 - a[1] * b[5] + a[5] * b[1]
    r4 = r4 - a[2] * b[6] + a[6] * b[2]
    r4 = r4 - a[3] * b[7] + a[7] * b[3]
    out[4] = r4

    var r5 = a[0] * b[5] + a[5] * b[0]
    r5 = r5 + a[1] * b[4] - a[4] * b[1]
    r5 = r5 - a[2] * b[7] + a[7] * b[2]
    r5 = r5 + a[3] * b[6] - a[6] * b[3]
    out[5] = r5

    var r6 = a[0] * b[6] + a[6] * b[0]
    r6 = r6 + a[1] * b[7] - a[7] * b[1]
    r6 = r6 + a[2] * b[4] - a[4] * b[2]
    r6 = r6 - a[3] * b[5] + a[5] * b[3]
    out[6] = r6

    var r7 = a[0] * b[7] + a[7] * b[0]
    r7 = r7 - a[1] * b[6] + a[6] * b[1]
    r7 = r7 + a[2] * b[5] - a[5] * b[2]
    r7 = r7 + a[3] * b[4] - a[4] * b[3]
    out[7] = r7
}

pub fn oct_mul(a: &[f64; 8], b: &[f64; 8], out: &![f64; 8]) with Mut, Div, NonAssoc {
    // out[k] = sum over all (i,j) where basis_product(i,j) has index k
    //        = sum_i sum_j  a[i] * b[j] * sigma(i,j)  where (i XOR j) == k
    // Direct 8x8 expansion, split for Madaros native frame size (see above).
    oct_mul_lo(a, b, out)
    oct_mul_hi(a, b, out)
}

// === Associator ===
// [a,b,c] = (a*b)*c - a*(b*c)
// Returns the associator as an octonion (8 components).

pub fn oct_associator(
    a: &[f64; 8], b: &[f64; 8], c: &[f64; 8],
    out: &![f64; 8]
) with Mut, Div, NonAssoc {
    // (a*b)*c
    var ab: [f64; 8] = [0.0; 8]
    oct_mul(a, b, &!ab)
    var ab_c: [f64; 8] = [0.0; 8]
    oct_mul(&ab, c, &!ab_c)

    // a*(b*c)
    var bc: [f64; 8] = [0.0; 8]
    oct_mul(b, c, &!bc)
    var a_bc: [f64; 8] = [0.0; 8]
    oct_mul(a, &bc, &!a_bc)

    // [a,b,c] = (a*b)*c - a*(b*c)
    var i: i64 = 0
    while i < 8 {
        out[i] = ab_c[i] - a_bc[i]
        i = i + 1
    }
}

// === Norm ===
// |a|² = a0² + a1² + ... + a7²
pub fn oct_norm_sq(a: &[f64; 8]) -> f64 with Mut {
    var sum: f64 = 0.0
    var i: i64 = 0
    while i < 8 { sum = sum + a[i] * a[i]; i = i + 1 }
    sum
}

// === Basis element constructors ===
pub fn oct_basis(idx: i64) -> [f64; 8] with Mut {
    var o: [f64; 8] = [0.0; 8]
    o[idx] = 1.0
    o
}

pub fn oct_real(x: f64) -> [f64; 8] with Mut {
    var o: [f64; 8] = [0.0; 8]
    o[0] = x
    o
}

// === Fano predicate (mirrors ir_can_reassociate_triple) ===
// Returns true if (ei, ej, ek) lie on a Fano line (associative triple).
pub fn is_fano_triple(i: i64, j: i64, k: i64) -> bool with Mut, Div {
    if i == 0 || j == 0 || k == 0 { return true }
    if i == j || j == k || i == k { return true }
    let alpha_1 = cd_sigma(i, j)
    let ij_xor = oct_xor(i, j)
    let alpha_2 = cd_sigma(ij_xor, k)
    let alpha = alpha_1 * alpha_2
    let beta_1 = cd_sigma(j, k)
    let jk_xor = oct_xor(j, k)
    let beta_2 = cd_sigma(i, jk_xor)
    let beta = beta_1 * beta_2
    alpha == beta
}

// Integer XOR for basis indices 0..7
pub fn oct_xor(a: i64, b: i64) -> i64 {
    // Bit-by-bit XOR for 3-bit integers
    let a0 = a - (a / 2) * 2
    let b0 = b - (b / 2) * 2
    let a1 = (a / 2) - (a / 4) * 2
    let b1 = (b / 2) - (b / 4) * 2
    let a2 = a / 4
    let b2 = b / 4
    let x0 = if a0 == b0 { 0 } else { 1 }
    let x1 = if a1 == b1 { 0 } else { 1 }
    let x2 = if a2 == b2 { 0 } else { 1 }
    x0 + 2 * x1 + 4 * x2
}

// === Associator norm for basis triple ===
// |[ei, ej, ek]|² — should be 0 for Fano lines, 4 for non-Fano
fn basis_associator_norm_sq(i: i64, j: i64, k: i64) -> f64 with Mut, Div, NonAssoc {
    var a = oct_basis(i)
    var b = oct_basis(j)
    var c = oct_basis(k)
    var assoc: [f64; 8] = [0.0; 8]
    oct_associator(&a, &b, &c, &!assoc)
    oct_norm_sq(&assoc)
}

// =========================================================================
// G₂ 3-form and SU(3) branching
// =========================================================================
//
// The G₂ 3-form φ is the canonical calibration form on Im(O) ≅ ℝ⁷.
// It is defined by the Fano plane: φ = Σ_{(i,j,k) ∈ Fano} eⁱ ∧ eʲ ∧ eᵏ
// where the 7 oriented Fano lines are:
//   (1,2,3), (1,4,5), (1,7,6), (2,4,6), (2,5,7), (3,4,7), (3,6,5)
// with signs from the Cayley-Dickson cocycle.
//
// Given a 7-frame {v₁..v₇} (7 vectors of dimension n), the G₂ 3-form
// evaluates to: φ(v_i, v_j, v_k) = det of the 3×3 Gram-like matrix
// projected onto the Fano structure.
//
// For connectome eigenvectors: each vₖ is an n-dimensional vector
// (one entry per brain region). We compute the inner products
// ⟨vₐ, v_b⟩ and evaluate φ on the frame.
//
// The maximal subgroup SU(3) ⊂ G₂ induces the branching:
//   7 = 3 ⊕ 3̄ ⊕ 1     (fundamental representation)
//  14 = 8 ⊕ 3 ⊕ 3̄       (adjoint representation)
// Under the standard embedding, the decomposition maps:
//   3 ↔ {e₁, e₂, e₃}    (color triplet)
//   3̄ ↔ {e₄, e₅, e₆}    (anti-triplet)
//   1 ↔ {e₇}             (singlet)
//
// References:
//   Harvey-Lawson 1982, "Calibrated geometries"
//   Bryant 1987, "Metrics with exceptional holonomy"
//   Baez 2002, "The Octonions" §4.1

// The 7 oriented Fano lines as (i,j,k) triples.
// Sign convention: ei*ej = +ek along each oriented line.
// Stored as flat array: fano_lines[3*n .. 3*n+2] = (i,j,k) for line n.
fn fano_line_i(n: i64) -> i64 {
    // Line 0: (1,2,3), Line 1: (1,4,5), Line 2: (1,7,6)
    // Line 3: (2,4,6), Line 4: (2,5,7), Line 5: (3,4,7), Line 6: (3,6,5)
    if n == 0 { return 1 }
    if n == 1 { return 1 }
    if n == 2 { return 1 }
    if n == 3 { return 2 }
    if n == 4 { return 2 }
    if n == 5 { return 3 }
    3
}

fn fano_line_j(n: i64) -> i64 {
    if n == 0 { return 2 }
    if n == 1 { return 4 }
    if n == 2 { return 7 }
    if n == 3 { return 4 }
    if n == 4 { return 5 }
    if n == 5 { return 4 }
    6
}

fn fano_line_k(n: i64) -> i64 {
    if n == 0 { return 3 }
    if n == 1 { return 5 }
    if n == 2 { return 6 }
    if n == 3 { return 6 }
    if n == 4 { return 7 }
    if n == 5 { return 7 }
    5
}

// Inner product of two vectors stored in flat arrays.
// v1 starts at offset o1, v2 at offset o2, each of length `dim`.
fn frame_inner(frame: &[f64; 700], o1: i64, o2: i64, dim: i64) -> f64 with Mut {
    var sum: f64 = 0.0
    var idx: i64 = 0
    while idx < dim {
        sum = sum + frame[o1 + idx] * frame[o2 + idx]
        idx = idx + 1
    }
    sum
}

// G₂ 3-form evaluated on a 7-frame.
//
// `frame` is a flat array of 7 vectors, each of dimension `dim`.
//   frame[k*dim .. (k+1)*dim - 1] = vector vₖ₊₁ (k = 0..6, mapping to e₁..e₇)
//
// φ(frame) = Σ_{line ℓ} sign(ℓ) · det(G_ℓ)
// where G_ℓ is the 3×3 Gram matrix of the triple (v_i, v_j, v_k)
// and sign(ℓ) is the Cayley-Dickson sign σ(i,j) for that Fano line.
//
// For an orthonormal frame aligned with octonion basis, this equals 7.
// Deviation from 7 measures departure from G₂ structure.
//
// Max dim = 100 (frame array is 700 = 7 * 100).
fn g2_3form(frame: &[f64; 700], dim: i64) -> f64 with Mut, Div {
    var phi: f64 = 0.0
    var line: i64 = 0
    while line < 7 {
        let i = fano_line_i(line)
        let j = fano_line_j(line)
        let k = fano_line_k(line)

        // Offsets into frame array (basis e₁..e₇ → indices 0..6)
        let oi = (i - 1) * dim
        let oj = (j - 1) * dim
        let ok = (k - 1) * dim

        // 3×3 Gram matrix entries
        let g11 = frame_inner(frame, oi, oi, dim)
        let g12 = frame_inner(frame, oi, oj, dim)
        let g13 = frame_inner(frame, oi, ok, dim)
        let g21 = frame_inner(frame, oj, oi, dim)
        let g22 = frame_inner(frame, oj, oj, dim)
        let g23 = frame_inner(frame, oj, ok, dim)
        let g31 = frame_inner(frame, ok, oi, dim)
        let g32 = frame_inner(frame, ok, oj, dim)
        let g33 = frame_inner(frame, ok, ok, dim)

        // det(G) = g11(g22*g33 - g23*g32)
        //        - g12(g21*g33 - g23*g31)
        //        + g13(g21*g32 - g22*g31)
        let det = g11 * (g22 * g33 - g23 * g32)
                - g12 * (g21 * g33 - g23 * g31)
                + g13 * (g21 * g32 - g22 * g31)

        // Sign from Cayley-Dickson cocycle
        let sign = cd_sigma(i, j)

        if sign > 0 {
            phi = phi + det
        } else {
            phi = phi - det
        }

        line = line + 1
    }
    phi
}

// === SU(3) ⊂ G₂ branching projector ===
//
// Under SU(3) ⊂ G₂, the fundamental 7 decomposes as 3 ⊕ 3̄ ⊕ 1:
//   triplet:      {v₁, v₂, v₃}  (color)
//   anti-triplet: {v₄, v₅, v₆}  (anti-color)
//   singlet:      {v₇}
//
// We measure decomposition quality by computing the 7×7 Gram matrix
// of the frame and checking block-diagonal dominance:
//
//   G = [ G₃₃   G₃₃̄  G₃₁ ]    ideal:  [ I₃  0   0 ]
//       [ G₃̄₃   G₃̄₃̄  G₃̄₁ ]            [ 0   I₃  0 ]
//       [ G₁₃   G₁₃̄  G₁₁ ]            [ 0   0   1 ]
//
// The branching quality Q ∈ [0,1] is:
//   Q = 1 - (off-block Frobenius norm)² / (total Frobenius norm)²
// Q = 1 means perfect block-diagonal (exact SU(3) decomposition).
// Q = 0 means no block structure.

// Compute the 7×7 Gram matrix of a 7-frame.
// gram[i*7 + j] = ⟨v_{i+1}, v_{j+1}⟩
fn frame_gram(frame: &[f64; 700], dim: i64, gram: &![f64; 49]) with Mut {
    var i: i64 = 0
    while i < 7 {
        var j: i64 = 0
        while j < 7 {
            gram[i * 7 + j] = frame_inner(frame, i * dim, j * dim, dim)
            j = j + 1
        }
        i = i + 1
    }
}

// Which block does basis index k (0..6) belong to?
// 0,1,2 → block 0 (triplet 3)
// 3,4,5 → block 1 (anti-triplet 3̄)
// 6     → block 2 (singlet 1)
fn su3_block(k: i64) -> i64 {
    if k < 3 { return 0 }
    if k < 6 { return 1 }
    2
}

// SU(3) branching quality Q ∈ [0, 1].
// Input: gram is a 7×7 Gram matrix (49 entries, row-major).
fn su3_branching_quality(gram: &[f64; 49]) -> f64 with Mut {
    var total_frob: f64 = 0.0
    var off_block_frob: f64 = 0.0
    var i: i64 = 0
    while i < 7 {
        var j: i64 = 0
        while j < 7 {
            let val = gram[i * 7 + j]
            let v2 = val * val
            total_frob = total_frob + v2
            if su3_block(i) != su3_block(j) {
                off_block_frob = off_block_frob + v2
            }
            j = j + 1
        }
        i = i + 1
    }
    if total_frob < 0.000001 { return 0.0 }
    1.0 - off_block_frob / total_frob
}

// Combined analysis: G₂ 3-form + SU(3) branching quality for a 7-frame.
// Returns (phi, quality) packed as a 2-element array.
fn g2_su3_analysis(frame: &[f64; 700], dim: i64, result: &![f64; 2]) with Mut, Div {
    let phi = g2_3form(frame, dim)
    var gram: [f64; 49] = [0.0; 49]
    frame_gram(frame, dim, &!gram)
    let q = su3_branching_quality(&gram)
    result[0] = phi
    result[1] = q
}

// === Associator deviation field ===
//
// For a 7-frame, compute the associator deviation for all 35 unordered
// triples {i,j,k} with 1 ≤ i < j < k ≤ 7.
//
// Each triple gets mapped to basis elements, and the associator
// ‖[eᵢ, eⱼ, eₖ]‖² is computed. For a G₂-compatible frame, the
// deviations should be:
//   0   for triples on Fano lines (7 of them)
//   4   for non-Fano triples (28 of them)
//
// The deviation field is stored in `devs[0..34]`.
// Triple ordering: lexicographic on (i,j,k) with i<j<k.
fn associator_deviation_field(devs: &![f64; 35]) with Mut, Div, NonAssoc {
    var idx: i64 = 0
    var i: i64 = 1
    while i <= 7 {
        var j: i64 = i + 1
        while j <= 7 {
            var k: i64 = j + 1
            while k <= 7 {
                devs[idx] = basis_associator_norm_sq(i, j, k)
                idx = idx + 1
                k = k + 1
            }
            j = j + 1
        }
        i = i + 1
    }
}

// Count how many of the 35 triples are Fano (associator norm = 0).
fn count_fano_triples(devs: &[f64; 35]) -> i64 with Mut {
    var count: i64 = 0
    var idx: i64 = 0
    while idx < 35 {
        if devs[idx] < 0.001 {
            count = count + 1
        }
        idx = idx + 1
    }
    count
}

// Count how many non-Fano triples have ‖associator‖² = 4 (±ε).
// Under Cayley-Dickson sign convention, [eᵢ,eⱼ,eₖ] = ±2eₘ for non-Fano
// triples, giving ‖·‖² = 4.
fn count_norm4_triples(devs: &[f64; 35]) -> i64 with Mut {
    var count: i64 = 0
    var idx: i64 = 0
    while idx < 35 {
        let diff = devs[idx] - 4.0
        let absdiff = if diff < 0.0 { 0.0 - diff } else { diff }
        if absdiff < 0.001 {
            count = count + 1
        }
        idx = idx + 1
    }
    count
}

// === G₂ null model ===
//
// For significance testing of the G₂ 3-form on connectome eigenvectors,
// we need a null distribution. The null hypothesis is: the eigenvector
// frame bears no relationship to the octonion G₂ structure.
//
// Procedure:
//   1. Generate random SO(7) rotations via 21 Givens rotations
//      (one per plane pair (i,j) with 0 ≤ i < j ≤ 6)
//   2. Apply each rotation to the eigenvector frame
//   3. Recompute φ = g2_3form on the rotated frame
//   4. Collect the distribution of |φ| values
//   5. The p-value is the fraction of null |φ| values ≥ observed |φ|
//
// Key insight: SO(7) has dimension 21, G₂ has dimension 14.
// The coset SO(7)/G₂ is 7-dimensional. Generic SO(7) rotations
// break the G₂ 3-form, reducing |φ| from its maximum of 7.
// Only the 14-dimensional G₂ subgroup preserves φ.
//
// Note: SU(3) branching quality Q is invariant under SO(7) for
// orthonormal frames (SO(7) preserves the Gram matrix). Q only
// varies for non-orthonormal frames from real data.
