// stdlib/algebra/ladder.sio
//
// Cayley–Dickson Capability Ladder — tiers L1 … L5.
//
// Companion to `stdlib/algebra/cayley_dickson.sio` (generic engine)
// and `formal/lean4/SounioPathionBridge.lean` (L5 count theorem).
// Exposes the *capability tier* abstraction used by Paper~I:
//
//   tier  algebra           dim   associativity   alternative   ZD?
//   ----  ---------------   ---   -------------   -----------   ---
//   L1    reals   ℝ          1    yes             yes           no
//   L2    complex ℂ          2    yes             yes           no
//   L3    quaternions ℍ      4    yes             yes           no
//   L3½   octonions 𝕆        8    no              yes           no
//   L4    sedenions 𝕊       16    no              no            YES (168-graph)
//   L5    pathions 𝕋        32    no              no            YES (420 prims)
//
// Each tier is modelled as a (dim, bits) pair; bits = log2(dim).  The
// function `tier_capabilities(bits)` returns a `CapabilityTier` struct
// reporting which algebraic properties hold.  Paper~I uses this
// table to argue that level L4 (sedenions) is the *first* tier on
// which surgical AI becomes possible, and L5 (pathions) the first
// tier on which *meta-surgical* operations (surgery on the surgery
// operator itself) become available.

// ────────────────────────────────────────────────────────────────────
// Tier descriptor
// ────────────────────────────────────────────────────────────────────

struct CapabilityTier {
    bits: i32,           // log2 of dimension
    dim: i32,            // 2^bits
    assoc: bool,         // associative?
    alternative: bool,   // alternative (Moufang)?
    has_zd: bool,        // has zero divisors?
    surgical: bool,      // supports Sounio surgical type system?
    meta_surgical: bool, // supports meta-surgical (surgery on surgery)?
}

fn tier_of_bits(bits: i32) -> CapabilityTier with Mut, Panic, Div {
    // Deterministic from level; matches the ladder above.
    // Guards: bits in 0..=5.
    if bits <= 1 {
        return CapabilityTier {
            bits: bits, dim: 1 << bits,
            assoc: true, alternative: true,
            has_zd: false, surgical: false, meta_surgical: false,
        }
    }
    if bits == 2 {
        return CapabilityTier {
            bits: 2, dim: 4,
            assoc: true, alternative: true,
            has_zd: false, surgical: false, meta_surgical: false,
        }
    }
    if bits == 3 {
        return CapabilityTier {
            bits: 3, dim: 8,
            assoc: false, alternative: true,
            has_zd: false, surgical: false, meta_surgical: false,
        }
    }
    if bits == 4 {
        return CapabilityTier {
            bits: 4, dim: 16,
            assoc: false, alternative: false,
            has_zd: true, surgical: true, meta_surgical: false,
        }
    }
    if bits == 5 {
        return CapabilityTier {
            bits: 5, dim: 32,
            assoc: false, alternative: false,
            has_zd: true, surgical: true, meta_surgical: true,
        }
    }
    // Default for bits > 5: treat as meta-surgical too (extrapolation).
    CapabilityTier {
        bits: bits, dim: 1 << bits,
        assoc: false, alternative: false,
        has_zd: true, surgical: true, meta_surgical: true,
    }
}

// ────────────────────────────────────────────────────────────────────
// Per-tier query helpers
// ────────────────────────────────────────────────────────────────────

fn supports_surgery(bits: i32) -> bool with Mut, Panic, Div {
    let t = tier_of_bits(bits)
    t.surgical
}

fn supports_meta_surgery(bits: i32) -> bool with Mut, Panic, Div {
    let t = tier_of_bits(bits)
    t.meta_surgical
}

// is_associative: hard requirement for matrix algebra, classical
// optimization convergence theorems, and most ML code.  False above L3.
fn is_associative(bits: i32) -> bool with Mut, Panic, Div {
    let t = tier_of_bits(bits)
    t.assoc
}

// is_alternative: the weakened associativity law of octonions
// (the Moufang identity).  False above L3.5.
fn is_alternative(bits: i32) -> bool with Mut, Panic, Div {
    let t = tier_of_bits(bits)
    t.alternative
}

// ────────────────────────────────────────────────────────────────────
// Primitive-basis count (structural data for Paper I tables)
// ────────────────────────────────────────────────────────────────────

// Number of primitive two-support elements at tier `bits`.
// This matches the Lean `prim_count_84` (L4) and `pathPrim_count_420`
// (L5) theorems from SounioPathionBridge.  For L1–L3 the count is 0
// because no primitive ZD vertices exist (no zero divisors).
fn primitive_count(bits: i32) -> i64 with Mut, Panic, Div {
    if bits <= 3 { return 0 }
    if bits == 4 { return 84 }
    if bits == 5 { return 420 }
    // Upper bound for higher tiers (quadratic growth, unverified);
    // callers should treat as a lower bound for L ≥ 6.
    let n = (1 << bits) as i64
    (n - 2) * (n - 2) / 4
}

// Number of xor-fiber labels (Fano-line analogue) at tier `bits`.
// L4: 7 (Fano PG(2,2)). L5: 15 (PG(3,2)). General: 2^(bits-1) - 1.
fn fiber_label_count(bits: i32) -> i64 with Mut, Panic, Div {
    if bits <= 3 { return 0 }
    (1 << (bits - 1)) - 1
}

// ────────────────────────────────────────────────────────────────────
// String labels for diagnostics
// ────────────────────────────────────────────────────────────────────

fn print_tier_name(bits: i32) with IO, Mut, Panic, Div {
    if bits == 0 { print("L0-reals") }
    else if bits == 1 { print("L1-complex") }
    else if bits == 2 { print("L2-quaternion") }
    else if bits == 3 { print("L3-octonion") }
    else if bits == 4 { print("L4-sedenion-surgical") }
    else if bits == 5 { print("L5-pathion-meta-surgical") }
    else { print("L6+") }
}
