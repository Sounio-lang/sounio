// stdlib/algebra/associator_field.sio
//
// AssociatorField — one object, seven windows.
//
// The associator [a,b,c] = (a·b)·c − a·(b·c) of the octonions is a single
// mathematical artifact that simultaneously carries seven structures. This
// module makes it a first-class value in Sounio so every research thread that
// circles it (homology functor, R-flux, G₂ geometry, annihilation statistics,
// order-entropy, epistemic PBPK) computes the SAME object in the SAME compiler.
//
// Windows captured per field:
//   1. cohomology      — is_coboundary: [α] trivial in HH³ ⇒ orders gauge-equivalent
//   2. gauge (R-flux)  — assoc: the associator 3-form value itself
//   3. geometry (G₂)   — g2_residual: distance from the associative (G₂-trivial) locus
//   4. order-ambiguity — pentagon_witness: magnitude of coherence violation
//   5. statistics      — norm_sq: the annihilation/zero-divisor proximity signal
//   6. information      — order_entropy: entropy of uniform parenthesization choice
//   7. epistemic (GUM)  — gum_augmentation: κ·‖α‖² added to the variance budget
//
// Reuses the verified octonion primitives in algebra::octonion. No new algebra.

use algebra::octonion::{oct_associator, oct_norm_sq, oct_basis, oct_mul}

// Newton sqrt — matches the ep_sqrt idiom in stdlib/epistemic/knowledge.sio.
// Public: L0 pentagon edge identities and external witnesses call this.
pub fn af_sqrt(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y
}

// ln 2 — the maximal entropy of a binary parenthesization choice for one triple:
// {(a·b)·c, a·(b·c)}. Coincident when the associator vanishes (entropy 0).
pub fn af_ln2() -> f64 { 0.6931471805599453 }

// Coboundary tolerance: associator norm² below this is treated as trivial.
fn af_eps() -> f64 { 0.000001 }

// The artifact. One struct. Seven windows.
pub struct OctAssociatorField {
    assoc: [f64; 8],        // window 2: the associator 3-form value [a,b,c]
    norm_sq: f64,           // window 5: ‖[a,b,c]‖² — annihilation / ZD-proximity signal
    g2_residual: f64,       // window 3: √norm_sq — distance from the associative locus
    is_coboundary: bool,    // window 1: norm_sq < ε ⇒ [α] trivial in HH³
    pentagon_witness: f64,  // window 4: = norm_sq — coherence-violation magnitude
    order_entropy: f64,     // window 6: 0 if coboundary, else ln 2
    gum_augmentation: f64,  // window 7: κ·‖α‖² added to variance
}

// Build the field from three octonions and a coupling constant κ.
// Madaros multi-module (2026-07-20): green after algebra::octonion::oct_mul
// lo/hi frame split (#1274). Previously exclusive-ref dep chain SEGV'd at
// runtime; residual blocker was E175 privacy on this public surface.
pub fn assoc_field_octonion(
    a: &[f64; 8], b: &[f64; 8], c: &[f64; 8], kappa: f64
) -> OctAssociatorField with Mut, Div, Panic, NonAssoc {
    var assoc: [f64; 8] = [0.0; 8]
    oct_associator(a, b, c, &!assoc)
    let n2 = oct_norm_sq(&assoc)
    let cob = n2 < af_eps()
    let ent = if cob { 0.0 } else { af_ln2() }
    OctAssociatorField {
        assoc: assoc,
        norm_sq: n2,
        g2_residual: af_sqrt(n2),
        is_coboundary: cob,
        pentagon_witness: n2,
        order_entropy: ent,
        gum_augmentation: kappa * n2,
    }
}

// Convenience: build the field for a basis triple (eᵢ, eⱼ, eₖ).
pub fn assoc_field_basis(i: i64, j: i64, k: i64, kappa: f64) -> OctAssociatorField
    with Mut, Div, Panic, NonAssoc {
    var a = oct_basis(i)
    var b = oct_basis(j)
    var c = oct_basis(k)
    assoc_field_octonion(&a, &b, &c, kappa)
}

// Window 7 applied: augment a base GUM variance with the structural
// (order-indeterminacy) contribution carried by the associator field.
//   u²_total = u²_GUM + κ·‖α‖²
pub fn af_augmented_variance(base_variance: f64, field: &OctAssociatorField) -> f64 {
    base_variance + field.gum_augmentation
}

// ===========================================================================
// Window 6 — the associahedron K₄ (n=4 pentagon), as checked code.
//
// The plan's VERDICT established (by hand) that the order-ambiguity variance
// of a product of four octonions w·x·y·z is *classical* operad theory: the
// five parenthesizations are the five vertices of the pentagon K₄, and the
// spread between them factors through the associators at the pentagon's faces.
//
// This block turns that hand-derivation into running, checked Sounio code.
// The key lever is that the octonions form a COMPOSITION algebra: ‖ab‖=‖a‖‖b‖.
// That makes two of the pentagon edges EXACT identities (verified in the test):
//
//   ((wx)y)z − (w(xy))z = [w,x,y]·z   ⇒   ‖edge‖ = ‖[w,x,y]‖·‖z‖
//   w((xy)z) − w(x(yz)) = w·[x,y,z]   ⇒   ‖edge‖ = ‖w‖·‖[x,y,z]‖
//
// so the "order entropy" of a depth-2 tree is not new mathematics — it is the
// associator norm scaled by composition. No GPU kernel, no first-such-theorem.
// ===========================================================================

fn oct_sub(a: &[f64; 8], b: &[f64; 8], out: &![f64; 8]) with Mut {
    var i: i64 = 0
    while i < 8 { out[i] = a[i] - b[i]; i = i + 1 }
}

// Fill the five parenthesizations of w·x·y·z into ps[k*8 .. k*8+7], k=0..4:
//   P0 = ((wx)y)z   P1 = (w(xy))z   P2 = (wx)(yz)   P3 = w((xy)z)   P4 = w(x(yz))
pub fn pentagon_products(
    w: &[f64; 8], x: &[f64; 8], y: &[f64; 8], z: &[f64; 8], ps: &![f64; 40]
) with Mut, Div, NonAssoc {
    var t1: [f64; 8] = [0.0; 8]
    var t2: [f64; 8] = [0.0; 8]
    var p0: [f64; 8] = [0.0; 8]
    var p1: [f64; 8] = [0.0; 8]
    var p2: [f64; 8] = [0.0; 8]
    var p3: [f64; 8] = [0.0; 8]
    var p4: [f64; 8] = [0.0; 8]
    oct_mul(w, x, &!t1);  oct_mul(&t1, y, &!t2);  oct_mul(&t2, z, &!p0)   // ((wx)y)z
    oct_mul(x, y, &!t1);  oct_mul(w, &t1, &!t2);  oct_mul(&t2, z, &!p1)   // (w(xy))z
    oct_mul(w, x, &!t1);  oct_mul(y, z, &!t2);    oct_mul(&t1, &t2, &!p2) // (wx)(yz)
    oct_mul(x, y, &!t1);  oct_mul(&t1, z, &!t2);  oct_mul(w, &t2, &!p3)   // w((xy)z)
    oct_mul(y, z, &!t1);  oct_mul(x, &t1, &!t2);  oct_mul(w, &t2, &!p4)   // w(x(yz))
    var c: i64 = 0
    while c < 8 {
        ps[c] = p0[c]
        ps[8 + c] = p1[c]
        ps[16 + c] = p2[c]
        ps[24 + c] = p3[c]
        ps[32 + c] = p4[c]
        c = c + 1
    }
}

// Population variance of the five pentagon vertices (mean of squared distances
// from their component-wise centroid). Zero exactly when all triples among
// {w,x,y,z} associate (the product is order-independent).
pub fn pentagon_variance(ps: &[f64; 40]) -> f64 with Mut, Div {
    var mean: [f64; 8] = [0.0; 8]
    var c: i64 = 0
    while c < 8 {
        var s: f64 = 0.0
        var k: i64 = 0
        while k < 5 { s = s + ps[k * 8 + c]; k = k + 1 }
        mean[c] = s / 5.0
        c = c + 1
    }
    var v: f64 = 0.0
    var k: i64 = 0
    while k < 5 {
        var d2: f64 = 0.0
        var cc: i64 = 0
        while cc < 8 {
            let d = ps[k * 8 + cc] - mean[cc]
            d2 = d2 + d * d
            cc = cc + 1
        }
        v = v + d2
        k = k + 1
    }
    v / 5.0
}

// Norm of the difference between two pentagon vertices ps[i] and ps[j].
// Public: composition-edge identities (‖[w,x,y]‖·‖z‖, ‖w‖·‖[x,y,z]‖).
pub fn pentagon_edge_norm(ps: &[f64; 40], i: i64, j: i64) -> f64 with Mut, Div, Panic {
    var diff: f64 = 0.0
    var c: i64 = 0
    while c < 8 {
        let d = ps[i * 8 + c] - ps[j * 8 + c]
        diff = diff + d * d
        c = c + 1
    }
    af_sqrt(diff)
}
