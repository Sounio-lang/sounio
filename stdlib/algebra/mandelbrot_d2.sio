// Reusable Mandelbrot-d2 helpers for structured hypercomplex projections.

pub fn trust_region_clip(step: f64, radius: f64) -> f64 with Div {
    if radius <= 0.0 { return step }
    if step > radius { return radius }
    if step < 0.0 - radius { return 0.0 - radius }
    step
}

pub fn md2_squash(v: f64) -> f64 with Div {
    if v >= 0.0 {
        v / (1.0 + v)
    } else {
        v / (1.0 + (0.0 - v))
    }
}

pub fn md2_orbit_feature(seed: f64, delta: f64) -> f64 with Mut, Div {
    var z = trust_region_clip(0.55 * seed + 0.20 * delta, 2.0)
    let c = trust_region_clip(0.35 * seed + 0.25 * delta, 2.0)
    var dz = 1.0 + 0.10 * delta
    var ddz = 0.0
    var it: i64 = 0
    while it < 3 {
        ddz = trust_region_clip(2.0 * (dz * dz + z * ddz), 8.0)
        dz = trust_region_clip(2.0 * z * dz + 1.0 + 0.15 * delta, 6.0)
        z = trust_region_clip(z * z + c, 4.0)
        it = it + 1
    }
    trust_region_clip(md2_squash(ddz), 1.5)
}
