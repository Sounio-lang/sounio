// stdlib/algebra/fano_auts.sio
//
// PSL(2,7) ≅ Aut(Fano) — 168 permutations of {1..7} preserving the
// Fano line set [(1,2,3),(1,4,5),(1,6,7),(2,4,6),(2,5,7),(3,4,7),(3,5,6)].
//
// Lex-sorted enumeration; identity is row 0.  The Lean mirror lives at
// formal/FanoLabellingOrbits.lean (`fanoAuts`) and is verified by
// `fano_automorphism_group_card : fanoAuts.length = 168`.
//
// Storage is a flat [i64; 1176] (168 × 7) populated row-major.  Use
// `fano_auts_into(&!buf)` to materialise, then index `buf[row*7 + k]`
// for image of basis index k+1 (1-indexed).

pub fn fano_auts_into(out: &[i64; 1176]) with Mut {
    out[0] = 1
    out[1] = 2
    out[2] = 3
    out[3] = 4
    out[4] = 5
    out[5] = 6
    out[6] = 7
    out[7] = 1
