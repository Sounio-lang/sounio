// stdlib/algebra/sedenion_decl.sio
//
// Sedenion algebra declaration for the Sounio type system.
//
// The sedenions 𝕊 = ℝ¹⁶ are obtained from the octonions by Cayley-Dickson doubling:
//   𝕊 = 𝕆 ⊕ 𝕆ℓ,  ℓ² = -1,  (a+bℓ)(c+dℓ) = (ac−d*b) + (da+bc*)ℓ
//
// Key properties:
//   - Non-commutative (like octonions and quaternions)
//   - NON-alternative (unlike octonions): (aa)b ≠ a(ab) in general
//   - NOT a division algebra: has zero divisors (ir_has_zero_divisors = true for alg_tag=4)
//   - The zero divisors form 𝒵(𝕊) ≅ G₂ (Moreno 1998, Reggiani 2024)
//
// Reassociation:
//   The Fano-selective predicate (ir_can_reassociate_triple with cd_bits=4)
//   extends to the sedenion level via the same Cayley-Dickson sigma function.
//   168 of the 15×14 = 210 ordered imaginary basis pairs produce zero products,
//   organizing the G₂ variety via the Dual Pathway (Agourakis 2026).
//
// This declaration missing from stdlib until now — only algebra Octonion existed.
// See: stdlib/algebra/octonion.sio for the octonion template.

algebra Sedenion over f64 {
    add: commutative, associative
    mul: non_commutative
    reassociate: fano_selective
}
