// Clinical Ollivier-Ricci Curvature Pipeline
//
// Unified pipeline for computing epistemic ORC on psychiatric and
// neurological networks: brain connectomes (fMRI/DTI), symptom networks,
// protein-protein interaction networks, and semantic networks.
//
// NOVELTY CLAIMS (all first-of-kind):
//   1. Uncertainty-quantified ORC (every kappa carries sigma)
//   2. GCI (Geometric Certainty Index) as clinical biomarker
//   3. d* (critical embedding dimension) as Cayley-Dickson biomarker
//   4. Phase boundary distance (delta_eta) for treatment response prediction
//   5. Cross-disorder curvature spectrum in unified framework
//
// Depends on: graph::epistemic_curvature, epistemic::core, causal::core

module medical::clinical_orc

// External math
extern "C" {
    fn sqrt(x: f64) -> f64;
}

fn sqrt_f64(x: f64) -> f64 {
    if x < 0.0 { return 0.0 }
    sqrt(x)
}

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

// =============================================================================
// Clinical Network Types
// =============================================================================

pub enum NetworkDomain {
    BrainConnectome,     // fMRI/DTI functional/structural connectivity
    SymptomNetwork,      // psychiatric symptom co-occurrence
    SemanticNetwork,     // word association / knowledge graph
    ProteinInteraction,  // PPI from STRING/BioGRID
}

pub enum ClinicalGroup {
    HealthyControl,
    Depression,          // MDD, includes severity levels
    ADHD,
    Autism,              // ASD
    Schizophrenia,
    Alzheimers,
    Parkinsons,
    Epilepsy,
    Other,
}

pub enum DepressionSeverity {
    Minimum,
    Mild,
    Moderate,
    Severe,
}

// Subject-level clinical metadata
pub struct SubjectMetadata {
    pub subject_id: i64,
    pub group: ClinicalGroup,
    pub age: f64,
    pub sex: i64,            // 0=female, 1=male, 2=other
    pub severity_score: f64, // PHQ-9, GAD-7, ADOS, etc.
    pub medication: bool,
    pub mean_fd: f64,        // mean framewise displacement (motion)
}

// =============================================================================
// Clinical Curvature Profile — Per-Subject Result
// =============================================================================

pub struct ClinicalCurvatureProfile {
    // Subject info
    pub subject_id: i64,
    pub group: ClinicalGroup,
    pub domain: NetworkDomain,

    // Network topology
    pub n_nodes: usize,
    pub n_edges: usize,
    pub mean_degree: f64,
    pub clustering: f64,
    pub eta: f64,               // k^2/N

    // Epistemic ORC results
    pub mean_kappa: f64,
    pub sigma_mean_kappa: f64,  // SE of mean
    pub std_kappa: f64,         // edge-level SD
    pub min_kappa: f64,
    pub max_kappa: f64,

    // Novel biomarkers
    pub gci: f64,               // Geometric Certainty Index [0,1]
    pub eta_c_predicted: f64,   // analytical phase boundary
    pub delta_eta: f64,         // distance from boundary (treatment predictor)
    pub d_star: f64,            // critical embedding dimension (0 if no crossing)
    pub d_star_found: bool,

    // Per-edge curvature distribution
    pub frac_hyperbolic: f64,
    pub frac_euclidean: f64,
    pub frac_spherical: f64,
    pub frac_uncertain: f64,    // edges where CI crosses geometry boundary

    // Confidence
    pub mean_confidence: f64,
    pub dominant_geometry: i64,  // 0=hyp, 1=euc, 2=sph, 3=uncertain
}

// =============================================================================
// Cross-Disorder Comparison — Multi-Subject Result
// =============================================================================

pub struct CrossDisorderResult {
    pub n_subjects: usize,

    // Per-group summaries
    pub group_labels: [i64],         // ClinicalGroup codes
    pub group_sizes: [usize],
    pub group_mean_kappa: [f64],
    pub group_std_kappa: [f64],
    pub group_mean_gci: [f64],
    pub group_mean_delta_eta: [f64],
    pub group_mean_d_star: [f64],

    // Statistical tests (t-test between pairs)
    pub pairwise_t_stats: [f64],     // flattened upper-triangle
    pub pairwise_p_values: [f64],

    // Effect sizes (Cohen's d)
    pub pairwise_cohens_d: [f64],

    // Curvature spectrum ordering (sorted by mean kappa)
    pub spectrum_order: [i64],       // group indices sorted ascending by kappa
}

// =============================================================================
// Treatment Response Prediction
// =============================================================================

pub struct TreatmentPrediction {
    pub subject_id: i64,
    pub delta_eta_baseline: f64,   // distance from phase boundary at baseline
    pub kappa_baseline: f64,
    pub gci_baseline: f64,
    pub predicted_response: f64,   // probability of response [0,1]
    pub confidence: f64,           // epistemic confidence in prediction
}

// Predict treatment response from curvature features
// Hypothesis: patients near phase boundary (small |delta_eta|) are more responsive
pub fn predict_treatment_response(
    profile: &ClinicalCurvatureProfile,
    population_mean_delta_eta: f64,
    population_std_delta_eta: f64
) -> TreatmentPrediction {
    // Normalize delta_eta to z-score
    let z_delta = if population_std_delta_eta > 1e-10 {
        (profile.delta_eta - population_mean_delta_eta) / population_std_delta_eta
    } else { 0.0 }

    // Patients near boundary (z ≈ 0) predicted more responsive
    // Using a sigmoid centered at boundary: P(response) = 1 / (1 + exp(|z| - 1))
    let abs_z = abs_f64(z_delta)
    let logit = abs_z - 1.0
    let exp_neg_logit = if logit > 20.0 { 0.0 }
        else if logit < -20.0 { 1.0 }
        else {
            // exp(-logit) approximation
            var scaled = (0.0 - logit) / 16.0
            let x2 = scaled * scaled
            let x3 = x2 * scaled
            let x4 = x3 * scaled
            var r = 1.0 + scaled + x2/2.0 + x3/6.0 + x4/24.0
            var i: usize = 0
            while i < 16 { r = r * r; i = i + 1 }
            r
        }

    let predicted_response = 1.0 / (1.0 + exp_neg_logit)

    // Confidence: higher when GCI is high and delta_eta is precise
    let conf = profile.gci * profile.mean_confidence

    TreatmentPrediction {
        subject_id: profile.subject_id,
        delta_eta_baseline: profile.delta_eta,
        kappa_baseline: profile.mean_kappa,
        gci_baseline: profile.gci,
        predicted_response,
        confidence: conf,
    }
}

// =============================================================================
// Curvature Trajectory (Severity Progression)
// =============================================================================

// Track curvature across severity levels or time points
pub struct CurvatureTrajectory {
    pub labels: [i64],           // severity codes or time indices
    pub kappas: [f64],           // mean kappa at each point
    pub sigma_kappas: [f64],     // uncertainty at each point
    pub gcis: [f64],             // GCI at each point
    pub delta_etas: [f64],       // phase boundary distance at each point
    pub trend_slope: f64,        // linear trend (positive = toward spherical)
    pub trend_p_value: f64,      // significance of trend
}

// Compute linear trend from trajectory
pub fn compute_trajectory_trend(
    x: &[f64],      // severity scores or time points
    y: &[f64],      // kappa values
    sigma: &[f64]   // uncertainties (for weighted regression)
) -> CurvatureTrajectory {
    let n = x.len()
    if n < 2 {
        return CurvatureTrajectory {
            labels: [], kappas: [], sigma_kappas: [],
            gcis: [], delta_etas: [],
            trend_slope: 0.0, trend_p_value: 1.0,
        }
    }

    // Weighted least squares: y = a + b*x
    // w_i = 1/sigma_i^2 (inverse-variance weighting)
    var sum_w: f64 = 0.0
    var sum_wx: f64 = 0.0
    var sum_wy: f64 = 0.0
    var sum_wxx: f64 = 0.0
    var sum_wxy: f64 = 0.0
    var i: usize = 0
    while i < n {
        let w = if sigma[i] > 1e-10 { 1.0 / (sigma[i] * sigma[i]) } else { 1.0 }
        sum_w = sum_w + w
        sum_wx = sum_wx + w * x[i]
        sum_wy = sum_wy + w * y[i]
        sum_wxx = sum_wxx + w * x[i] * x[i]
        sum_wxy = sum_wxy + w * x[i] * y[i]
        i = i + 1
    }

    let denom = sum_w * sum_wxx - sum_wx * sum_wx
    let slope = if abs_f64(denom) > 1e-15 {
        (sum_w * sum_wxy - sum_wx * sum_wy) / denom
    } else { 0.0 }

    // p-value approximation: use t-test on slope
    // sigma_slope^2 = sum_w / denom (simplified)
    let sigma_slope = if abs_f64(denom) > 1e-15 {
        sqrt_f64(sum_w / abs_f64(denom))
    } else { 1e10 }

    let t_stat = if sigma_slope > 1e-10 { slope / sigma_slope } else { 0.0 }
    // p ≈ 2 * exp(-t^2/2) (very rough normal approximation)
    let t2 = t_stat * t_stat
    var p_approx = 1.0
    if t2 > 0.0 {
        // exp(-t^2/2) approximation
        var scaled = (0.0 - t2 / 2.0) / 16.0
        let x2 = scaled * scaled
        let x3 = x2 * scaled
        var r = 1.0 + scaled + x2/2.0 + x3/6.0
        var k: usize = 0
        while k < 16 { r = r * r; k = k + 1 }
        p_approx = 2.0 * r
        if p_approx > 1.0 { p_approx = 1.0 }
    }

    // Copy inputs
    var ks: [f64] = []
    var sigs: [f64] = []
    i = 0
    while i < n {
        ks.push(y[i])
        sigs.push(sigma[i])
        i = i + 1
    }

    CurvatureTrajectory {
        labels: [],
        kappas: ks,
        sigma_kappas: sigs,
        gcis: [],
        delta_etas: [],
        trend_slope: slope,
        trend_p_value: p_approx,
    }
}

// =============================================================================
// PPI Network Analysis (RQ5: Neurodegeneration)
// =============================================================================

// Build PPI graph at a confidence threshold
// STRING scores are in [0, 1000], we normalize to [0, 1]
pub struct PPIEdge {
    pub protein_a: usize,
    pub protein_b: usize,
    pub confidence: f64,     // STRING combined_score / 1000
}

// Sweep confidence thresholds to find curvature phase transition
pub struct PPIPhaseTrajectory {
    pub thresholds: [f64],
    pub etas: [f64],
    pub kappas: [f64],
    pub sigma_kappas: [f64],
    pub n_edges_at_threshold: [usize],
    pub eta_c_crossing: f64,  // threshold where eta crosses eta_c
    pub has_sign_change: bool,
}

pub fn sweep_ppi_thresholds(
    edges: &[PPIEdge],
    n_proteins: usize,
    thresholds: &[f64]
) -> PPIPhaseTrajectory {
    let n_thresholds = thresholds.len()
    var etas: [f64] = []
    var kappas: [f64] = []
    var sigma_kappas: [f64] = []
    var n_edges_list: [usize] = []

    var t_idx: usize = 0
    while t_idx < n_thresholds {
        let threshold = thresholds[t_idx]

        // Build adjacency at this threshold
        var adj: [[usize]] = []
        var i: usize = 0
        while i < n_proteins {
            adj.push([])
            i = i + 1
        }

        var n_edges: usize = 0
        var e_idx: usize = 0
        while e_idx < edges.len() {
            if edges[e_idx].confidence >= threshold {
                let a = edges[e_idx].protein_a
                let b = edges[e_idx].protein_b
                adj[a].push(b)
                adj[b].push(a)
                n_edges = n_edges + 1
            }
            e_idx = e_idx + 1
        }

        // Compute eta = k^2/N
        var total_deg: usize = 0
        i = 0
        while i < n_proteins {
            total_deg = total_deg + adj[i].len()
            i = i + 1
        }
        let mean_k = (total_deg as f64) / (n_proteins as f64)
        let eta = mean_k * mean_k / (n_proteins as f64)

        etas.push(eta)
        n_edges_list.push(n_edges)

        // For PPI, cost uncertainty comes from STRING confidence scores
        // sigma_d ≈ (1 - confidence) for each edge on the path
        // Simplified: use mean (1-confidence) as uniform cost uncertainty
        // Skip full ORC for empty graphs
        if n_edges < 2 {
            kappas.push(0.0)
            sigma_kappas.push(0.0)
        } else {
            // Use Hehl analytical approximation for speed
            // Full Sinkhorn ORC is too slow for threshold sweeps
            var clustering: f64 = 0.0  // approximate
            let kappa_approx = hehl_kappa_internal(mean_k, eta, clustering, n_proteins as f64, 0.5)
            kappas.push(kappa_approx)
            // Uncertainty from threshold sensitivity: delta_kappa/delta_threshold
            sigma_kappas.push(0.05)  // placeholder — refine with bootstrap
        }

        t_idx = t_idx + 1
    }

    // Find sign change
    var has_sign_change = false
    var eta_c_crossing: f64 = 0.0
    var idx: usize = 0
    while idx < n_thresholds - 1 {
        if (kappas[idx] < 0.0 && kappas[idx + 1] >= 0.0) ||
           (kappas[idx] >= 0.0 && kappas[idx + 1] < 0.0) {
            has_sign_change = true
            // Linear interpolation
            let f = abs_f64(kappas[idx]) / (abs_f64(kappas[idx]) + abs_f64(kappas[idx + 1]))
            eta_c_crossing = thresholds[idx] + f * (thresholds[idx + 1] - thresholds[idx])
        }
        idx = idx + 1
    }

    // Copy thresholds
    var ts: [f64] = []
    idx = 0
    while idx < n_thresholds {
        ts.push(thresholds[idx])
        idx = idx + 1
    }

    PPIPhaseTrajectory {
        thresholds: ts, etas, kappas, sigma_kappas,
        n_edges_at_threshold: n_edges_list,
        eta_c_crossing, has_sign_change,
    }
}

// Internal Hehl kappa (to avoid circular dependency)
fn hehl_kappa_internal(k: f64, eta: f64, clustering: f64, n_nodes: f64, alpha: f64) -> f64 {
    if k < 2.0 { return 0.0 }
    let t_clust = clustering * (k - 1.0)
    let t_rand = (k - 1.0) * (k - 1.0) / (n_nodes - 1.0)
    var t = if t_clust > t_rand { t_clust } else { t_rand }
    if t < 0.0 { t = 0.0 }
    if t > k - 1.0 { t = k - 1.0 }
    let n_exc = k - 1.0 - t
    if n_exc < 1e-10 { return 1.0 - alpha }

    let p_edge = eta / k
    // exp approximation
    var val = 0.0 - p_edge * n_exc
    if val < -20.0 { val = -20.0 }
    var scaled = val / 16.0
    let x2 = scaled * scaled
    let x3 = x2 * scaled
    let x4 = x3 * scaled
    var exp_val = 1.0 + scaled + x2/2.0 + x3/6.0 + x4/24.0
    var i: usize = 0
    while i < 16 { exp_val = exp_val * exp_val; i = i + 1 }

    let expected_matching = n_exc * (1.0 - exp_val)
    let f_m = expected_matching / n_exc
    let mass_exc = (1.0 - alpha) * n_exc / k
    let w1 = alpha + mass_exc * (f_m + 3.0 * (1.0 - f_m))
    1.0 - w1
}

// =============================================================================
// Causal Curvature Framework (RQ4)
// =============================================================================

// Causal effect of treatment on curvature change
pub struct CausalCurvatureEffect {
    pub ate_delta_kappa: f64,       // average treatment effect on kappa change
    pub sigma_ate: f64,             // uncertainty on ATE
    pub ci_lower: f64,
    pub ci_upper: f64,
    pub e_value: f64,               // sensitivity to unmeasured confounding
    pub mediated_through_clustering: f64,  // proportion mediated via delta_C
    pub is_significant: bool,       // p < 0.05
}

// Compute E-value for sensitivity analysis
// E = effect + sqrt(effect * (effect - 1))
// Minimum unmeasured confounder strength to explain away the effect
pub fn compute_e_value(effect_rr: f64) -> f64 {
    if effect_rr <= 1.0 { return 1.0 }
    effect_rr + sqrt_f64(effect_rr * (effect_rr - 1.0))
}

// =============================================================================
// 7-Dimensional Feature Vector for Cross-Disorder Classification
// =============================================================================
//
// Maps naturally to quaternion pairs for hypercomplex classification:
//   q1 = (kappa_mean, kappa_std, GCI, eta)
//   q2 = (clustering, d_star, delta_eta, 0)

pub struct CurvatureFeatureVector {
    pub kappa_mean: f64,
    pub kappa_std: f64,
    pub gci: f64,
    pub eta: f64,
    pub clustering: f64,
    pub d_star: f64,
    pub delta_eta: f64,
}

pub fn extract_features(profile: &ClinicalCurvatureProfile) -> CurvatureFeatureVector {
    CurvatureFeatureVector {
        kappa_mean: profile.mean_kappa,
        kappa_std: profile.std_kappa,
        gci: profile.gci,
        eta: profile.eta,
        clustering: profile.clustering,
        d_star: profile.d_star,
        delta_eta: profile.delta_eta,
    }
}

// Normalize features to [0, 1] range using population statistics
pub fn normalize_features(
    features: &CurvatureFeatureVector,
    pop_min: &CurvatureFeatureVector,
    pop_max: &CurvatureFeatureVector
) -> CurvatureFeatureVector {
    let range = |val: f64, lo: f64, hi: f64| -> f64 {
        if abs_f64(hi - lo) < 1e-10 { 0.5 }
        else { (val - lo) / (hi - lo) }
    }

    CurvatureFeatureVector {
        kappa_mean: range(features.kappa_mean, pop_min.kappa_mean, pop_max.kappa_mean),
        kappa_std: range(features.kappa_std, pop_min.kappa_std, pop_max.kappa_std),
        gci: range(features.gci, pop_min.gci, pop_max.gci),
        eta: range(features.eta, pop_min.eta, pop_max.eta),
        clustering: range(features.clustering, pop_min.clustering, pop_max.clustering),
        d_star: range(features.d_star, pop_min.d_star, pop_max.d_star),
        delta_eta: range(features.delta_eta, pop_min.delta_eta, pop_max.delta_eta),
    }
}

// =============================================================================
// Tests
// =============================================================================

pub fn test_treatment_prediction() -> bool {
    let profile = ClinicalCurvatureProfile {
        subject_id: 1, group: ClinicalGroup::Depression,
        domain: NetworkDomain::BrainConnectome,
        n_nodes: 200, n_edges: 4000, mean_degree: 40.0,
        clustering: 0.15, eta: 8.0,
        mean_kappa: -0.05, sigma_mean_kappa: 0.01, std_kappa: 0.2,
        min_kappa: -0.5, max_kappa: 0.3,
        gci: 0.6, eta_c_predicted: 3.0, delta_eta: 5.0,
        d_star: 6.5, d_star_found: true,
        frac_hyperbolic: 0.4, frac_euclidean: 0.2,
        frac_spherical: 0.3, frac_uncertain: 0.1,
        mean_confidence: 0.8, dominant_geometry: 0,
    }

    let pred = predict_treatment_response(&profile, 3.0, 2.0)
    // Should produce a valid prediction
    pred.predicted_response >= 0.0 && pred.predicted_response <= 1.0
}

pub fn test_e_value() -> bool {
    // E-value of 1.0 means no confounding needed (null effect)
    let e1 = compute_e_value(1.0)
    // E-value > 1 for positive effect
    let e2 = compute_e_value(2.0)

    e1 == 1.0 && e2 > 2.0
}

pub fn test_feature_extraction() -> bool {
    let profile = ClinicalCurvatureProfile {
        subject_id: 1, group: ClinicalGroup::HealthyControl,
        domain: NetworkDomain::BrainConnectome,
        n_nodes: 100, n_edges: 2000, mean_degree: 40.0,
        clustering: 0.12, eta: 16.0,
        mean_kappa: 0.1, sigma_mean_kappa: 0.005, std_kappa: 0.15,
        min_kappa: -0.3, max_kappa: 0.5,
        gci: 0.85, eta_c_predicted: 3.2, delta_eta: 12.8,
        d_star: 4.0, d_star_found: true,
        frac_hyperbolic: 0.1, frac_euclidean: 0.2,
        frac_spherical: 0.6, frac_uncertain: 0.1,
        mean_confidence: 0.9, dominant_geometry: 2,
    }

    let features = extract_features(&profile)
    features.kappa_mean == 0.1 && features.gci == 0.85 && features.d_star == 4.0
}

pub fn test_trajectory_trend() -> bool {
    // Severity scores: 0 (min), 1 (mild), 2 (moderate), 3 (severe)
    let x: [f64] = [0.0, 1.0, 2.0, 3.0]
    // Kappa values: depression gets less hyperbolic with severity
    let y: [f64] = [-0.13, -0.07, -0.065, -0.074]
    let sigma: [f64] = [0.01, 0.01, 0.01, 0.01]

    let traj = compute_trajectory_trend(&x, &y, &sigma)
    // Slope should be positive (toward less negative = less hyperbolic)
    traj.trend_slope > 0.0
}

pub fn run_clinical_orc_tests() -> bool {
    test_treatment_prediction() &&
    test_e_value() &&
    test_feature_extraction() &&
    test_trajectory_trend()
}
