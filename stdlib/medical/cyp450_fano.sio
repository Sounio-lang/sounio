//! stdlib/medical/cyp450_fano.sio
//!
//! CYP450 Drug Metabolism and the Fano Plane
//!
//! Maps the 7 FDA-canonical CYP450 isoforms to the 7 imaginary octonion
//! basis elements. The Fano plane structure predicts which CYP enzyme
//! triples have order-independent vs order-dependent drug interactions.
//!
//! The 7 CYP isoforms (FDA DDI guidance):
//!   CYP1A2, CYP2B6, CYP2C8, CYP2C9, CYP2C19, CYP2D6, CYP3A4
//!
//! Key biological fact: Mechanism-Based Inhibition (MBI) creates a
//! time-arrow in drug interactions. Drug A then Drug B ≠ Drug B then Drug A.
//! 67% of pharmacodynamic DDIs are monodirectional (Wicha et al. 2017).
//!
//! The mapping is constrained by biology:
//!   - CYP2C8, CYP2C9, CYP2C19 share chromosome 10 gene cluster
//!     → they must lie on a Fano line (associative = overlapping substrates)
//!   - CYP2D6 is non-inducible → algebraically unique
//!   - CYP3A4 metabolizes 30% of all drugs → dominant element
//!
//! The 168 theorem predicts: of 343 ordered CYP triples,
//!   133 are trivially associative (same enzyme repeated)
//!    42 are associative (enzymes on same Fano line = mechanistic family)
//!   168 are NON-ASSOCIATIVE (enzyme order matters for DDI outcome)
//!
//! References:
//!   Agourakis & Gerenutti (2026): The 168 Theorem. AACA (submitted)
//!   FDA Table of Substrates, Inhibitors and Inducers
//!   Zanger & Schwab (2020): Cytochrome P450 enzymes in drug metabolism
//!   Zhou et al. (2020): Mechanism-based CYP inhibition
//!   Wicha et al. (2017): General pharmacodynamic interaction model. Nat Comm.

// ============================================================================
// CYP450 ISOFORMS — 7 imaginary octonion basis elements
// ============================================================================
//
// Mapping motivated by genetic clustering and substrate overlap:
//
//   e1: CYP1A2     — isolated family (chr 15), planar aromatic substrates
//   e2: CYP2C9     — CYP2C gene cluster (chr 10), acidic/neutral substrates
//   e3: CYP2C8     — CYP2C gene cluster (chr 10), shares substrates with CYP3A4
//   e4: CYP2B6     — CYP2 family (chr 19), distinct from CYP2C
//   e5: CYP2C19    — CYP2C gene cluster (chr 10), completes the cluster Fano line
//   e6: CYP2D6     — unique: non-inducible, basic nitrogen substrates, highly polymorphic
//   e7: CYP3A4     — dominant enzyme (30% of drugs), bridges to CYP2C8 via substrates
//
// Fano plane triples (standard octonion multiplication table):
//   (1,2,4)  (2,3,5)  (3,4,6)  (4,5,7)  (5,6,1)  (6,7,2)  (7,1,3)
//
// Pharmacological interpretation of each Fano line:
//
//   Line (2,3,5): CYP2C9–CYP2C8–CYP2C19
//     → The CYP2C gene cluster. Same chromosome (10q23.33).
//       Overlapping substrates. Co-regulated expression.
//       PREDICTION: DDIs within this triple are ORDER-INDEPENDENT.
//
//   Line (1,2,4): CYP1A2–CYP2C9–CYP2B6
//     → CYP1/2 broad family axis. All inducible by rifampin.
//       PREDICTION: Cross-induction cascades are order-independent.
//
//   Line (3,4,6): CYP2C8–CYP2B6–CYP2D6
//     → CYP2 subfamily convergence. Mixed-substrate polymorphic enzymes.
//       CYP2D6's non-inducibility makes this the most surprising line.
//
//   Line (4,5,7): CYP2B6–CYP2C19–CYP3A4
//     → Prodrug activation triad (bupropion, clopidogrel, midazolam).
//       PREDICTION: Sequential prodrug activation is order-independent.
//
//   Line (5,6,1): CYP2C19–CYP2D6–CYP1A2
//     → Polymorphic triad (all three have clinically significant variants).
//       PREDICTION: Pharmacogenomic interactions are order-independent.
//
//   Line (6,7,2): CYP2D6–CYP3A4–CYP2C9
//     → The "big three" metabolizers (~65% of all drug metabolism).
//       PREDICTION: The dominant metabolic pathway interactions are order-independent.
//
//   Line (7,1,3): CYP3A4–CYP1A2–CYP2C8
//     → Paclitaxel metabolism bridge (CYP3A4/CYP2C8 share paclitaxel;
//       CYP1A2 bridges via polycyclic aromatic substrates).

pub fn cyp_1a2() -> i32 { 1 }
pub fn cyp_2c9() -> i32 { 2 }
pub fn cyp_2c8() -> i32 { 3 }
pub fn cyp_2b6() -> i32 { 4 }
pub fn cyp_2c19() -> i32 { 5 }
pub fn cyp_2d6() -> i32 { 6 }
pub fn cyp_3a4() -> i32 { 7 }

// ============================================================================
// FANO PLANE — reuses the universal structure
// ============================================================================

fn fano_lines() -> [i32; 21] with Mut, Panic {
    var t: [i32; 21] = [0; 21]
    t[0]=1; t[1]=2; t[2]=4    // CYP1A2–CYP2C9–CYP2B6
    t[3]=2; t[4]=3; t[5]=5    // CYP2C9–CYP2C8–CYP2C19  ← the gene cluster
    t[6]=3; t[7]=4; t[8]=6    // CYP2C8–CYP2B6–CYP2D6
    t[9]=4; t[10]=5; t[11]=7  // CYP2B6–CYP2C19–CYP3A4
    t[12]=5; t[13]=6; t[14]=1 // CYP2C19–CYP2D6–CYP1A2
    t[15]=6; t[16]=7; t[17]=2 // CYP2D6–CYP3A4–CYP2C9
    t[18]=7; t[19]=1; t[20]=3 // CYP3A4–CYP1A2–CYP2C8
    t
}

pub fn is_on_fano_line(a: i32, b: i32, c: i32) -> bool with Mut, Panic, Div {
    if a == b || b == c || a == c { return true }
    let t = fano_lines()
    var line: i32 = 0
    while line < 7 {
        let p = t[(line * 3) as usize]
        let q = t[(line * 3 + 1) as usize]
        let r = t[(line * 3 + 2) as usize]
        let has_a = (a == p) || (a == q) || (a == r)
        let has_b = (b == p) || (b == q) || (b == r)
        let has_c = (c == p) || (c == q) || (c == r)
        if has_a && has_b && has_c { return true }
        line = line + 1
    }
    false
}

pub fn classify_triple(a: i32, b: i32, c: i32) -> i32 with Mut, Panic, Div {
    if a < 1 || a > 7 || b < 1 || b > 7 || c < 1 || c > 7 { return -1 }
    if a == b || b == c || a == c { return 0 }
    if is_on_fano_line(a, b, c) { return 1 }
    return 2
}

pub fn compute_partition() -> [i32; 3] with Mut, Panic, Div {
    var counts: [i32; 3] = [0; 3]
    var i: i32 = 1
    while i <= 7 {
        var j: i32 = 1
        while j <= 7 {
            var k: i32 = 1
            while k <= 7 {
                let c = classify_triple(i, j, k)
                if c >= 0 && c <= 2 { counts[c as usize] = counts[c as usize] + 1 }
                k = k + 1
            }
            j = j + 1
        }
        i = i + 1
    }
    counts
}

// ============================================================================
// CYP450 CASCADE — a sequence of enzyme-mediated interactions
// ============================================================================

pub struct CYP450Cascade {
    cyps: [i32; 16],
    mbi: [bool; 16],      // is this step an MBI (mechanism-based inhibitor)?
    length: i32,
}

pub fn cyp_cascade_new() -> CYP450Cascade with Mut, Panic {
    CYP450Cascade {
        cyps: [0; 16],
        mbi: [false; 16],
        length: 0,
    }
}

pub fn cyp_cascade_add(c: CYP450Cascade, cyp: i32, is_mbi: bool) -> CYP450Cascade with Mut, Panic {
    var r = c
    if r.length < 16 {
        r.cyps[r.length as usize] = cyp
        r.mbi[r.length as usize] = is_mbi
        r.length = r.length + 1
    }
    r
}

pub fn cyp_cascade_nonassoc_count(c: CYP450Cascade) -> i32 with Mut, Panic, Div {
    var count: i32 = 0
    var i: i32 = 0
    while i < c.length - 2 {
        let a = c.cyps[i as usize]
        let b = c.cyps[(i + 1) as usize]
        let d = c.cyps[(i + 2) as usize]
        if classify_triple(a, b, d) == 2 { count = count + 1 }
        i = i + 1
    }
    count
}

// ============================================================================
// CLINICAL DDI CASCADES
// ============================================================================

/// HIV antiretroviral cocktail: ritonavir (CYP3A4 MBI) → lopinavir (CYP3A4 sub)
/// → efavirenz (CYP2B6 sub + CYP3A4 inducer)
/// Ritonavir is intentionally given FIRST to boost lopinavir AUC 380-7700%.
pub fn hiv_cocktail() -> CYP450Cascade with Mut, Panic {
    var c = cyp_cascade_new()
    c = cyp_cascade_add(c, cyp_3a4(), true)   // ritonavir: CYP3A4 MBI
    c = cyp_cascade_add(c, cyp_3a4(), false)   // lopinavir: CYP3A4 substrate
    c = cyp_cascade_add(c, cyp_2b6(), false)   // efavirenz: CYP2B6 substrate
    c
}

/// Psychiatric polypharmacy: fluvoxamine (CYP1A2 MBI + CYP2C19 inh)
/// → clozapine (CYP1A2 substrate) → codeine (CYP2D6 prodrug)
pub fn psychiatric_cascade() -> CYP450Cascade with Mut, Panic {
    var c = cyp_cascade_new()
    c = cyp_cascade_add(c, cyp_1a2(), true)    // fluvoxamine: CYP1A2 MBI
    c = cyp_cascade_add(c, cyp_1a2(), false)   // clozapine: CYP1A2 substrate
    c = cyp_cascade_add(c, cyp_2d6(), false)   // codeine: CYP2D6 prodrug
    c
}

/// Cardiology cascade: amiodarone (inhibits CYP1A2 + CYP2D6 + CYP3A4)
/// → warfarin (CYP2C9 substrate) → simvastatin (CYP3A4 substrate)
pub fn cardiology_cascade() -> CYP450Cascade with Mut, Panic {
    var c = cyp_cascade_new()
    c = cyp_cascade_add(c, cyp_2d6(), true)    // amiodarone: multi-CYP inhibitor
    c = cyp_cascade_add(c, cyp_2c9(), false)   // warfarin: CYP2C9 substrate
    c = cyp_cascade_add(c, cyp_3a4(), false)   // simvastatin: CYP3A4 substrate
    c
}

/// Gastroenterology: omeprazole (CYP2C19 MBI) → clopidogrel (CYP2C19 prodrug)
/// → atorvastatin (CYP3A4 substrate)
/// Clinical evidence: time-separation does NOT mitigate the omeprazole-clopidogrel
/// interaction because it is MBI, not competitive inhibition.
pub fn gi_antiplatelet_cascade() -> CYP450Cascade with Mut, Panic {
    var c = cyp_cascade_new()
    c = cyp_cascade_add(c, cyp_2c19(), true)   // omeprazole: CYP2C19 MBI
    c = cyp_cascade_add(c, cyp_2c19(), false)   // clopidogrel: CYP2C19 prodrug
    c = cyp_cascade_add(c, cyp_3a4(), false)    // atorvastatin: CYP3A4 substrate
    c
}

/// Rapamycin (sirolimus) context — relevant to dissertation:
/// sirolimus (CYP3A4 ~90%) + ketoconazole (CYP3A4 MBI) → AUC ↑ 10.9×
/// + tacrolimus (CYP3A4 substrate) — calcineurin inhibitor
pub fn transplant_cascade() -> CYP450Cascade with Mut, Panic {
    var c = cyp_cascade_new()
    c = cyp_cascade_add(c, cyp_3a4(), true)    // ketoconazole: CYP3A4 MBI
    c = cyp_cascade_add(c, cyp_3a4(), false)   // sirolimus: CYP3A4 substrate
    c = cyp_cascade_add(c, cyp_2c8(), false)   // sirolimus minor: CYP2C8
    c
}
