//! stdlib/medical/drug_cascade.sio
//!
//! Pharmacological Non-Associativity via the 168 Theorem
//!
//! Maps 7 psychiatric drug classes to the 7 imaginary octonion basis
//! elements. The Fano plane structure predicts which drug triples
//! have order-dependent (non-associative) clinical effects.
//!
//! The 168 theorem (Agourakis 2026):
//!   Of 343 ordered triples (i,j,k) ∈ {1,...,7}³:
//!     133 are trivially associative (repeated drug class)
//!      42 are associative (drugs share a Fano-line mechanism)
//!     168 are NON-ASSOCIATIVE (order of administration matters)
//!
//! The binary property: ||[e_i, e_j, e_k]|| ∈ {0, 2}
//!   Either the order COMPLETELY matters or COMPLETELY doesn't.
//!   This predicts BIMODAL drug cascade effects.
//!
//! Question: Is the brain non-associative?
//! Test: Do psychiatric drug cascades show order-dependent outcomes
//!       consistent with the Fano plane structure?
//!
//! References:
//!   Agourakis & Gerenutti (2026): The 168 Theorem. AACA (submitted)
//!   STAR*D (2006): Sequenced treatment for depression
//!   CATIE (2005): Clinical antipsychotic trials

// ============================================================================
// DRUG CLASSES — 7 imaginary octonion basis elements
// ============================================================================
//
// The mapping drug class → e_k is motivated by receptor pharmacology:
//
//   e1: SSRI          — 5-HT reuptake (serotonin axis)
//   e2: SNRI          — 5-HT + NE reuptake (dual monoamine)
//   e3: Benzodiazepine — GABA-A potentiation (inhibitory axis)
//   e4: Typical AP     — D2 blockade (dopamine axis)
//   e5: Atypical AP    — 5-HT2A/D2 (serotonin-dopamine bridge)
//   e6: Mood stabilizer — multiple targets (Li, VPA, LTG)
//   e7: Stimulant      — DA/NE reuptake (catecholamine axis)
//
// Fano plane triples (from the standard octonion multiplication table):
//   (1,2,4)  (2,3,5)  (3,4,6)  (4,5,7)  (5,6,1)  (6,7,2)  (7,1,3)
//
// Each triple defines a quaternion subalgebra = mechanistic family:
//   Line (1,2,4): SSRI–SNRI–TypicalAP      (monoamine triad)
//   Line (2,3,5): SNRI–Benzo–AtypicalAP     (anxiolytic-antipsychotic bridge)
//   Line (3,4,6): Benzo–TypicalAP–MoodStab  (sedation-stabilization axis)
//   Line (4,5,7): TypicalAP–AtypicalAP–Stim (dopamine spectrum)
//   Line (5,6,1): AtypicalAP–MoodStab–SSRI  (maintenance triad)
//   Line (6,7,2): MoodStab–Stim–SNRI        (activation axis)
//   Line (7,1,3): Stim–SSRI–Benzo           (anxiety management triad)

pub fn drug_ssri() -> i32 { 1 }
pub fn drug_snri() -> i32 { 2 }
pub fn drug_benzo() -> i32 { 3 }
pub fn drug_typical_ap() -> i32 { 4 }
pub fn drug_atypical_ap() -> i32 { 5 }
pub fn drug_mood_stabilizer() -> i32 { 6 }
pub fn drug_stimulant() -> i32 { 7 }

// ============================================================================
// FANO PLANE — the algebraic structure of drug interactions
// ============================================================================

// 7 Fano lines, each with 3 drug classes that form an associative subalgebra.
// Stored as [line_idx * 3 + offset] = drug class index.
fn cascade_fano_lines() -> [i32; 21] with Mut, Panic, Div {
    var t: [i32; 21] = [0; 21]
    t[0]=1; t[1]=2; t[2]=4    // SSRI–SNRI–TypicalAP
    t[3]=2; t[4]=3; t[5]=5    // SNRI–Benzo–AtypicalAP
    t[6]=3; t[7]=4; t[8]=6    // Benzo–TypicalAP–MoodStab
    t[9]=4; t[10]=5; t[11]=7  // TypicalAP–AtypicalAP–Stim
    t[12]=5; t[13]=6; t[14]=1 // AtypicalAP–MoodStab–SSRI
    t[15]=6; t[16]=7; t[17]=2 // MoodStab–Stim–SNRI
    t[18]=7; t[19]=1; t[20]=3 // Stim–SSRI–Benzo
    t
}

/// Check if three drug classes lie on the same Fano line.
/// If so, they form an associative (quaternion) subalgebra —
/// the order of administration does NOT matter.
pub fn cascade_is_on_fano_line(a: i32, b: i32, c: i32) -> bool with Mut, Panic, Div {
    if a == b || b == c || a == c { return true }  // repeated = trivially associative
    let t = cascade_fano_lines()
    var line: i32 = 0
    while line < 7 {
        let p = t[(line * 3) as usize]
        let q = t[(line * 3 + 1) as usize]
        let r = t[(line * 3 + 2) as usize]
        // Check if {a,b,c} = {p,q,r} (as unordered sets)
        let has_a = (a == p) || (a == q) || (a == r)
        let has_b = (b == p) || (b == q) || (b == r)
        let has_c = (c == p) || (c == q) || (c == r)
        if has_a && has_b && has_c { return true }
        line = line + 1
    }
    false
}

// ============================================================================
// THE 168 PARTITION
// ============================================================================

/// Classification of a drug triple.
///   0 = TRIVIAL (repeated class — order irrelevant by definition)
///   1 = ASSOCIATIVE (on Fano line — shared mechanism, order doesn't matter)
///   2 = NON-ASSOCIATIVE (off Fano line — order MATTERS, norm = 2)
pub fn cascade_classify_triple(a: i32, b: i32, c: i32) -> i32 with Mut, Panic, Div {
    if a < 1 || a > 7 || b < 1 || b > 7 || c < 1 || c > 7 { return -1 }
    if a == b || b == c || a == c { return 0 }  // trivial
    if cascade_is_on_fano_line(a, b, c) { return 1 }    // associative
    return 2                                      // NON-ASSOCIATIVE
}

/// Compute the full 168 partition: count all 343 triples.
/// Returns [trivial_count, associative_count, nonassociative_count].
pub fn cascade_compute_partition() -> [i32; 3] with Mut, Panic, Div {
    var counts: [i32; 3] = [0; 3]
    var i: i32 = 1
    while i <= 7 {
        var j: i32 = 1
        while j <= 7 {
            var k: i32 = 1
            while k <= 7 {
                let c = cascade_classify_triple(i, j, k)
                if c >= 0 && c <= 2 { counts[c as usize] = counts[c as usize] + 1 }
                k = k + 1
            }
            j = j + 1
        }
        i = i + 1
    }
    counts
}

// ============================================================================
// DRUG CASCADE — a sequence of prescriptions
// ============================================================================

pub struct DrugCascade {
    // Sequence of drug classes administered (max 16 steps)
    drugs: [i32; 16],
    // Timestamps (days from start)
    days: [i32; 16],
    // Response at each step (0.0 = no response, 1.0 = full remission)
    response: [f64; 16],
    // Number of drugs in the cascade
    length: i32,
}

pub fn cascade_new() -> DrugCascade {
    DrugCascade {
        drugs: [0; 16],
        days: [0; 16],
        response: [0.0; 16],
        length: 0,
    }
}

/// Add a drug to the cascade.
pub fn cascade_add(c: DrugCascade, drug: i32, day: i32, resp: f64) -> DrugCascade with Mut, Panic, Div {
    var r = c
    if r.length < 16 {
        r.drugs[r.length as usize] = drug
        r.days[r.length as usize] = day
        r.response[r.length as usize] = resp
        r.length = r.length + 1
    }
    r
}

// ============================================================================
// CASCADE ANALYSIS — the core computation
// ============================================================================

/// Count how many non-associative triples appear in this cascade.
///
/// For a cascade of length n, there are (n-2) consecutive triples:
///   (drug[0], drug[1], drug[2]), (drug[1], drug[2], drug[3]), ...
///
/// Returns the fraction of triples that are non-associative.
/// High fraction → the patient's treatment is highly order-dependent.
/// Low fraction → the treatment sequence doesn't matter much.
pub fn cascade_nonassoc_fraction(c: DrugCascade) -> f64 with Mut, Panic, Div {
    if c.length < 3 { return 0.0 }

    var nonassoc: i32 = 0
    var total: i32 = 0

    var i: i32 = 0
    while i < c.length - 2 {
        let a = c.drugs[i as usize]
        let b = c.drugs[(i + 1) as usize]
        let d = c.drugs[(i + 2) as usize]
        if a >= 1 && a <= 7 && b >= 1 && b <= 7 && d >= 1 && d <= 7 {
            total = total + 1
            if cascade_classify_triple(a, b, d) == 2 {
                nonassoc = nonassoc + 1
            }
        }
        i = i + 1
    }

    if total > 0 { (nonassoc as f64) / (total as f64) } else { 0.0 }
}

/// List all non-associative triples in the cascade.
/// Returns count of non-associative triples found.
pub fn cascade_list_nonassoc(c: DrugCascade, out_i: &![i32; 16], out_j: &![i32; 16], out_k: &![i32; 16]) -> i32 with Mut, Panic, Div {
    var count: i32 = 0
    var i: i32 = 0
    while i < c.length - 2 {
        let a = c.drugs[i as usize]
        let b = c.drugs[(i + 1) as usize]
        let d = c.drugs[(i + 2) as usize]
        if a >= 1 && a <= 7 && b >= 1 && b <= 7 && d >= 1 && d <= 7 {
            if cascade_classify_triple(a, b, d) == 2 {
                if count < 16 {
                    out_i[count as usize] = a
                    out_j[count as usize] = b
                    out_k[count as usize] = d
                    count = count + 1
                }
            }
        }
        i = i + 1
    }
    count
}

/// Compute the "associator energy" of a cascade.
///
/// For each consecutive triple, the associator norm is 0 (associative)
/// or 2 (non-associative). The energy is the sum of squared norms,
/// divided by the number of triples.
///
/// Energy = 0: fully associative cascade (order irrelevant)
/// Energy = 4: fully non-associative cascade (every step is order-dependent)
pub fn cascade_energy(c: DrugCascade) -> f64 with Mut, Panic, Div {
    if c.length < 3 { return 0.0 }
    var energy: f64 = 0.0
    var total: i32 = 0
    var i: i32 = 0
    while i < c.length - 2 {
        let a = c.drugs[i as usize]
        let b = c.drugs[(i + 1) as usize]
        let d = c.drugs[(i + 2) as usize]
        if a >= 1 && a <= 7 && b >= 1 && b <= 7 && d >= 1 && d <= 7 {
            total = total + 1
            if cascade_classify_triple(a, b, d) == 2 {
                energy = energy + 4.0  // ||[e_i,e_j,e_k]||² = 4
            }
        }
        i = i + 1
    }
    if total > 0 { energy / (total as f64) } else { 0.0 }
}

// ============================================================================
// CLINICAL SCENARIOS
// ============================================================================

/// STAR*D-like depression treatment cascade.
///
/// Level 1: SSRI (citalopram)
/// Level 2: Switch to SNRI (venlafaxine) or augment with benzo
/// Level 3: Add atypical AP (aripiprazole)
/// Level 4: Switch to mood stabilizer (lithium)
///
/// The STAR*D sequence is: SSRI → SNRI → AtypicalAP → MoodStab
/// = e1 → e2 → e5 → e6
pub fn star_d_cascade() -> DrugCascade with Mut, Panic, Div {
    var c = cascade_new()
    c = cascade_add(c, 1, 0, 0.30)    // SSRI, day 0, 30% response
    c = cascade_add(c, 2, 42, 0.25)   // SNRI, day 42, 25% response
    c = cascade_add(c, 5, 84, 0.15)   // Atypical AP, day 84, 15% response
    c = cascade_add(c, 6, 126, 0.10)  // Mood stabilizer, day 126, 10% response
    c
}

/// Alternative cascade: start with benzo anxiolysis, then SSRI, then AP.
/// Same drugs, DIFFERENT ORDER.
/// If the brain is non-associative, this should produce different outcomes.
pub fn alternative_cascade() -> DrugCascade with Mut, Panic, Div {
    var c = cascade_new()
    c = cascade_add(c, 3, 0, 0.50)    // Benzo first (fast anxiolysis)
    c = cascade_add(c, 1, 14, 0.35)   // SSRI second (serotonin baseline)
    c = cascade_add(c, 5, 56, 0.20)   // Atypical AP third (augmentation)
    c = cascade_add(c, 6, 98, 0.15)   // Mood stabilizer fourth
    c
}

/// Polypharmacy cascade typical of treatment-resistant schizophrenia.
pub fn schizophrenia_cascade() -> DrugCascade with Mut, Panic, Div {
    var c = cascade_new()
    c = cascade_add(c, 4, 0, 0.40)    // Typical AP (first episode)
    c = cascade_add(c, 5, 42, 0.35)   // Atypical AP (switch for side effects)
    c = cascade_add(c, 6, 84, 0.20)   // Mood stabilizer (augment)
    c = cascade_add(c, 3, 126, 0.15)  // Benzo (for agitation)
    c = cascade_add(c, 1, 168, 0.10)  // SSRI (comorbid depression)
    c
}

/// ADHD cascade with comorbid anxiety.
pub fn adhd_anxiety_cascade() -> DrugCascade with Mut, Panic, Div {
    var c = cascade_new()
    c = cascade_add(c, 7, 0, 0.60)    // Stimulant first
    c = cascade_add(c, 1, 30, 0.45)   // SSRI for anxiety
    c = cascade_add(c, 3, 60, 0.30)   // Benzo PRN
    c
}

// ============================================================================
// FANO LINE NAMES (for printing)
// ============================================================================

/// Return the Fano line index (0-6) that contains drugs a and b,
/// or -1 if they don't share a line.
pub fn shared_fano_line(a: i32, b: i32) -> i32 with Mut, Panic, Div {
    if a == b { return -1 }
    let t = cascade_fano_lines()
    var line: i32 = 0
    while line < 7 {
        let p = t[(line * 3) as usize]
        let q = t[(line * 3 + 1) as usize]
        let r = t[(line * 3 + 2) as usize]
        let has_a = (a == p) || (a == q) || (a == r)
        let has_b = (b == p) || (b == q) || (b == r)
        if has_a && has_b { return line }
        line = line + 1
    }
    -1
}
