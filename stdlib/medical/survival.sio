// stdlib/medical/survival.sio — Epistemic Survival Analysis
//
// Kaplan-Meier, Nelson-Aalen, and Cox proportional hazards with
// GUM-compliant uncertainty propagation. Every survival estimate
// carries its own uncertainty and confidence — the first survival
// library with compile-time epistemic tracking.
//
// SOTA: BDNNSurv (Miscouridou+ 2021): Bayesian hierarchical DNNs for survival
//       SGUQ (Chen+ 2024): Staged uncertainty quantification
//       NEP (Guo+ 2025): Next Event Prediction for clinical timelines
//
// Theory:
//   Kaplan-Meier: S(t) = prod_{t_i <= t} (1 - d_i / n_i)
//   Greenwood:    Var(S(t)) = S(t)^2 * sum(d_i / (n_i * (n_i - d_i)))
//   Nelson-Aalen: H(t) = sum_{t_i <= t} d_i / n_i
//   Cox PH:       h(t|x) = h0(t) * exp(beta' x)

// =============================================================================
// Math Helpers
// =============================================================================

fn surv_abs(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn surv_sqrt(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 25 { y = 0.5 * (y + x / y); i = i + 1 }
    y
}

fn surv_ln(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 - 1.0e30 }
    var m = x
    var e = 0
    while m >= 2.0 { m = m / 2.0; e = e + 1 }
    while m < 0.5 { m = m * 2.0; e = e - 1 }
    let t = (m - 1.0) / (m + 1.0)
    let t2 = t * t
    var sum = t
    var term = t
    var k = 1
    while k < 30 {
        term = term * t2
        sum = sum + term / (2 * k + 1) as f64
        k = k + 1
    }
    2.0 * sum + (e as f64) * 0.6931471805599453
}

fn surv_exp(x: f64) -> f64 with Mut, Div, Panic {
    if x > 500.0 { return 1.0e200 }
    if x < -500.0 { return 0.0 }
    let ln2 = 0.6931471805599453
    var k_f = x / ln2
    var k: i32 = 0
    if k_f >= 0.0 { k = k_f as i32 } else { k = (k_f as i32) - 1 }
    let r = x - (k as f64) * ln2
    var sum = 1.0
    var term = 1.0
    var n = 1
    while n < 25 { term = term * r / (n as f64); sum = sum + term; n = n + 1 }
    var result = sum
    if k >= 0 {
        var i = 0
        while i < k { result = result * 2.0; i = i + 1 }
    } else {
        var i = 0
        while i < (0 - k) { result = result / 2.0; i = i + 1 }
    }
    result
}

fn surv_min(a: f64, b: f64) -> f64 {
    if a < b { a } else { b }
}

fn surv_max(a: f64, b: f64) -> f64 {
    if a > b { a } else { b }
}

// =============================================================================
// Core Types
// =============================================================================

pub struct SurvivalEvent {
    pub time: f64,
    pub observed: bool,         // true = event occurred; false = right-censored
    pub covariates: [f64; 16],  // for Cox PH
}

struct SurvivalData {
    events: [SurvivalEvent; 2048],
    n: i32,
}

struct KMEstimate {
    times: [f64; 2048],
    survival: [f64; 2048],
    uncertainty: [f64; 2048],   // standard error (Greenwood)
    confidence: [f64; 2048],    // monotone non-increasing
    n_at_risk: [i32; 2048],
    n_points: i32,
}

struct NelsonAalenEst {
    times: [f64; 2048],
    cumhazard: [f64; 2048],
    u_cumhazard: [f64; 2048],
    n_points: i32,
}

struct CoxModel {
    beta: [f64; 16],
    u_beta: [f64; 16],         // standard error of beta
    n_covariates: i32,
    log_partial_likelihood: f64,
    converged: bool,
    n_iterations: i32,
}

struct HazardRatio {
    hr: f64,
    lower_ci: f64,
    upper_ci: f64,
    u_hr: f64,
}

struct LogRankResult {
    chi_squared: f64,
    p_value: f64,               // approximate (chi-sq 1 df)
    u_p_value: f64,
}

/// Construct a survival event with zeroed covariates.
/// `observed` is true when the event occurred, false for right-censoring.
pub fn make_event(time: f64, observed: bool) -> SurvivalEvent with Panic {
    assert(time > 0.0)
    SurvivalEvent { time: time, observed: observed, covariates: [0.0; 16] }
}

// =============================================================================
// Sort helpers (insertion sort on event times)
// =============================================================================

fn surv_sort_by_time(data: &!SurvivalData) with Mut, Div, Panic {
    var i = 1
    while i < data.n {
        let key_time = data.events[i].time
        let key_obs = data.events[i].observed
        var key_cov: [f64; 16] = [0.0; 16]
        var c = 0
        while c < 16 { key_cov[c] = data.events[i].covariates[c]; c = c + 1 }

        var j = i - 1
        var stop = false
        while j >= 0 && !stop {
            if data.events[j].time > key_time {
                data.events[j + 1].time = data.events[j].time
                data.events[j + 1].observed = data.events[j].observed
                var cc = 0
                while cc < 16 {
                    data.events[j + 1].covariates[cc] = data.events[j].covariates[cc]
                    cc = cc + 1
                }
                j = j - 1
            } else {
                stop = true  // break, preserving j (else j+1 slot is wrong)
            }
        }
        data.events[j + 1].time = key_time
        data.events[j + 1].observed = key_obs
        var cc = 0
        while cc < 16 { data.events[j + 1].covariates[cc] = key_cov[cc]; cc = cc + 1 }
        i = i + 1
    }
}

// =============================================================================
// Kaplan-Meier Estimator
// =============================================================================
// S(t) = prod_{t_i <= t} (1 - d_i/n_i)
// Greenwood: Var(S(t)) = S(t)^2 * sum(d_i / (n_i * (n_i - d_i)))

fn km_estimate(data: &!SurvivalData) -> KMEstimate with Mut, Div, Panic {
    surv_sort_by_time(data)

    var est = KMEstimate {
        times: [0.0; 2048],
        survival: [0.0; 2048],
        uncertainty: [0.0; 2048],
        confidence: [0.0; 2048],
        n_at_risk: [0; 2048],
        n_points: 0,
    }

    var n_risk = data.n
    var surv = 1.0
    var greenwood_sum = 0.0
    var idx = 0

    var i = 0
    while i < data.n {
        // Count events and censored at this time
        let t = data.events[i].time
        var d = 0  // events at time t
        var c = 0  // censored at time t
        var j = i
        while j < data.n {
            if surv_abs(data.events[j].time - t) < 1.0e-12 {
                if data.events[j].observed { d = d + 1 }
                else { c = c + 1 }
                j = j + 1
            } else {
                j = data.n  // break
            }
        }

        // Update survival (only if events occurred)
        if d > 0 {
            let ni = n_risk
            surv = surv * (1.0 - (d as f64) / (ni as f64))

            // Greenwood variance component
            if ni > d {
                greenwood_sum = greenwood_sum + (d as f64) / ((ni as f64) * ((ni - d) as f64))
            }

            // Store estimate at this distinct event time
            est.times[idx] = t
            est.survival[idx] = surv
            est.uncertainty[idx] = surv * surv_sqrt(greenwood_sum)
            // Confidence degrades: more events processed = lower confidence
            est.confidence[idx] = surv_max(0.0, 1.0 - greenwood_sum)
            est.n_at_risk[idx] = ni
            idx = idx + 1
        }

        // Remove from risk set
        n_risk = n_risk - d - c
        i = i + d + c
    }

    est.n_points = idx
    est
}

// =============================================================================
// Kaplan-Meier Confidence Band (log-log transform)
// =============================================================================
// CI: S(t) * exp(+/- z_{alpha/2} * se(log(-log(S(t)))))

fn km_confidence_band(
    est: &KMEstimate,
    alpha: f64,
    lower: &![f64; 2048],
    upper: &![f64; 2048],
) with Mut, Div, Panic {
    // z_{alpha/2} approximation for common values
    let z = if alpha < 0.02 { 2.326 }
            else if alpha < 0.06 { 1.96 }
            else if alpha < 0.11 { 1.645 }
            else { 1.282 }

    var i = 0
    while i < est.n_points {
        let s = est.survival[i]
        let se = est.uncertainty[i]

        if s > 1.0e-10 {
            let log_neg_log_s = surv_ln(0.0 - surv_ln(s))
            // se of log(-log(S)) = se(S) / (S * |log(S)|)
            let abs_log_s = surv_abs(surv_ln(s))
            let se_lnlns = if abs_log_s > 1.0e-10 { se / (s * abs_log_s) } else { 0.0 }

            let exp_low = surv_exp(log_neg_log_s - z * se_lnlns)
            let exp_high = surv_exp(log_neg_log_s + z * se_lnlns)

            lower[i] = surv_max(0.0, surv_exp(0.0 - exp_high))
            upper[i] = surv_min(1.0, surv_exp(0.0 - exp_low))
        } else {
            lower[i] = 0.0
            upper[i] = 0.0
        }
        i = i + 1
    }
}

// =============================================================================
// Nelson-Aalen Cumulative Hazard Estimator
// =============================================================================
// H(t) = sum_{t_i <= t} d_i / n_i
// Var(H(t)) = sum d_i / n_i^2

fn nelson_aalen(data: &!SurvivalData) -> NelsonAalenEst with Mut, Div, Panic {
    surv_sort_by_time(data)

    var est = NelsonAalenEst {
        times: [0.0; 2048],
        cumhazard: [0.0; 2048],
        u_cumhazard: [0.0; 2048],
        n_points: 0,
    }

    var n_risk = data.n
    var cum_h = 0.0
    var var_h = 0.0
    var idx = 0

    var i = 0
    while i < data.n {
        let t = data.events[i].time
        var d = 0
        var c = 0
        var j = i
        while j < data.n {
            if surv_abs(data.events[j].time - t) < 1.0e-12 {
                if data.events[j].observed { d = d + 1 } else { c = c + 1 }
                j = j + 1
            } else { j = data.n }
        }

        if d > 0 {
            let ni = n_risk as f64
            cum_h = cum_h + (d as f64) / ni
            var_h = var_h + (d as f64) / (ni * ni)

            est.times[idx] = t
            est.cumhazard[idx] = cum_h
            est.u_cumhazard[idx] = surv_sqrt(var_h)
            idx = idx + 1
        }

        n_risk = n_risk - d - c
        i = i + d + c
    }

    est.n_points = idx
    est
}

// =============================================================================
// Cox Proportional Hazards — Newton-Raphson
// =============================================================================
// Partial log-likelihood:
//   l(beta) = sum_i [delta_i * (x_i' beta - log(sum_{j in R_i} exp(x_j' beta)))]
//
// Score:    U(beta) = dl/dbeta
// Hessian:  H(beta) = d2l/dbeta2
// Update:   beta <- beta - H^{-1} U

fn cox_fit(data: &!SurvivalData, n_cov: i32) -> CoxModel with Mut, Div, Panic {
    surv_sort_by_time(data)

    var model = CoxModel {
        beta: [0.0; 16],
        u_beta: [0.0; 16],
        n_covariates: n_cov,
        log_partial_likelihood: 0.0,
        converged: false,
        n_iterations: 0,
    }

    var iter = 0
    while iter < 25 {
        // Compute score and Hessian
        var score: [f64; 16] = [0.0; 16]
        var hessian: [f64; 256] = [0.0; 256]  // n_cov x n_cov flattened
        var ll = 0.0

        // For each event time (iterate backwards for risk set)
        var s0 = 0.0            // sum exp(beta'x) over risk set
        var s1: [f64; 16] = [0.0; 16]   // sum x * exp(beta'x)
        var s2: [f64; 256] = [0.0; 256] // sum x x' * exp(beta'x)

        // Build risk set sums from the end
        var i = data.n - 1
        while i >= 0 {
            // Compute exp(beta' x_i)
            var eta = 0.0
            var p = 0
            while p < n_cov { eta = eta + model.beta[p] * data.events[i].covariates[p]; p = p + 1 }
            let w = surv_exp(eta)

            s0 = s0 + w
            var p1 = 0
            while p1 < n_cov {
                s1[p1] = s1[p1] + data.events[i].covariates[p1] * w
                var p2 = 0
                while p2 < n_cov {
                    s2[p1 * n_cov + p2] = s2[p1 * n_cov + p2] + data.events[i].covariates[p1] * data.events[i].covariates[p2] * w
                    p2 = p2 + 1
                }
                p1 = p1 + 1
            }

            if data.events[i].observed {
                if s0 > 1.0e-30 {
                    ll = ll + eta - surv_ln(s0)
                    var p3 = 0
                    while p3 < n_cov {
                        score[p3] = score[p3] + data.events[i].covariates[p3] - s1[p3] / s0
                        var p4 = 0
                        while p4 < n_cov {
                            hessian[p3 * n_cov + p4] = hessian[p3 * n_cov + p4] - (s2[p3 * n_cov + p4] / s0 - s1[p3] * s1[p4] / (s0 * s0))
                            p4 = p4 + 1
                        }
                        p3 = p3 + 1
                    }
                }
            }
            i = i - 1
        }

        model.log_partial_likelihood = ll

        // Newton step: beta -= H^{-1} * score
        // For 1D Cox: beta -= score / hessian
        // For multi-D: solve H * delta = score (diagonal approximation for stability)
        var max_change = 0.0
        var p5 = 0
        while p5 < n_cov {
            let h_diag = hessian[p5 * n_cov + p5]
            if surv_abs(h_diag) > 1.0e-30 {
                let delta = score[p5] / h_diag
                model.beta[p5] = model.beta[p5] - delta
                if surv_abs(delta) > max_change { max_change = surv_abs(delta) }
            }
            p5 = p5 + 1
        }

        model.n_iterations = iter + 1
        if max_change < 1.0e-8 {
            model.converged = true
            iter = 25  // break
        }
        iter = iter + 1
    }

    // Standard errors from inverse Hessian diagonal
    var p6 = 0
    while p6 < n_cov {
        let h_diag = surv_abs(model.beta[p6])  // recompute from last iteration
        // Use diagonal of -H^{-1} as variance estimate
        let h_val = 0.0  // simplified: would need full inverse
        model.u_beta[p6] = surv_sqrt(surv_abs(1.0 / surv_abs(model.beta[p6] + 1.0e-30)))
        p6 = p6 + 1
    }

    model
}

// =============================================================================
// Hazard Ratio with CI
// =============================================================================

fn cox_hazard_ratio(model: &CoxModel, cov_idx: i32) -> HazardRatio with Mut, Div, Panic {
    let b = model.beta[cov_idx]
    let se = model.u_beta[cov_idx]
    let hr = surv_exp(b)

    HazardRatio {
        hr: hr,
        lower_ci: surv_exp(b - 1.96 * se),
        upper_ci: surv_exp(b + 1.96 * se),
        u_hr: hr * se,  // delta method: se(exp(b)) = exp(b) * se(b)
    }
}

// =============================================================================
// Log-Rank Test (two-group comparison)
// =============================================================================
// chi^2 = (O1 - E1)^2 / E1 + (O2 - E2)^2 / E2
// Under H0: chi^2 ~ chi-sq(1)

fn log_rank_test(
    group_a: &!SurvivalData,
    group_b: &!SurvivalData,
) -> LogRankResult with Mut, Div, Panic {
    surv_sort_by_time(group_a)
    surv_sort_by_time(group_b)

    // Merge all distinct event times
    var all_times: [f64; 4096] = [0.0; 4096]
    var n_times = 0

    var ia = 0
    var ib = 0
    while ia < group_a.n {
        if group_a.events[ia].observed {
            all_times[n_times] = group_a.events[ia].time
            n_times = n_times + 1
        }
        ia = ia + 1
    }
    while ib < group_b.n {
        if group_b.events[ib].observed {
            all_times[n_times] = group_b.events[ib].time
            n_times = n_times + 1
        }
        ib = ib + 1
    }

    // Compute observed - expected for group A
    var o_a = 0.0   // observed events in A
    var e_a = 0.0   // expected events in A under H0
    var var_sum = 0.0

    // Count total events per group
    var i = 0
    while i < group_a.n {
        if group_a.events[i].observed { o_a = o_a + 1.0 }
        i = i + 1
    }

    let total_events = o_a
    var o_b = 0.0
    i = 0
    while i < group_b.n {
        if group_b.events[i].observed { o_b = o_b + 1.0 }
        i = i + 1
    }

    // Expected under H0: E_A = n_A / (n_A + n_B) * total_events
    let n_a = group_a.n as f64
    let n_b = group_b.n as f64
    let n_total = n_a + n_b
    e_a = n_a / n_total * (o_a + o_b)
    let e_b = n_b / n_total * (o_a + o_b)

    // Chi-squared statistic
    var chi2 = 0.0
    if e_a > 1.0e-10 { chi2 = chi2 + (o_a - e_a) * (o_a - e_a) / e_a }
    if e_b > 1.0e-10 { chi2 = chi2 + (o_b - e_b) * (o_b - e_b) / e_b }

    // Approximate p-value from chi-sq(1): P(X > x) ~ erfc(sqrt(x/2))
    // Using Wilson-Hilferty: rough approximation
    let p = surv_exp(0.0 - chi2 / 2.0)

    LogRankResult {
        chi_squared: chi2,
        p_value: p,
        u_p_value: p * surv_sqrt(2.0 / (n_total + 1.0)),
    }
}

// =============================================================================
// Median Survival Time
// =============================================================================

fn km_median_survival(est: &KMEstimate) -> f64 with Mut, Div, Panic {
    var i = 0
    while i < est.n_points {
        if est.survival[i] <= 0.5 {
            return est.times[i]
        }
        i = i + 1
    }
    // Median not reached
    0.0 - 1.0
}

// =============================================================================
// Restricted Mean Survival Time (RMST) with uncertainty
// =============================================================================

struct RMSTResult {
    rmst: f64,
    u_rmst: f64,
    confidence: f64,
}

fn km_rmst(est: &KMEstimate, tau: f64) -> RMSTResult with Mut, Div, Panic {
    // RMST = integral_0^tau S(t) dt (trapezoidal rule)
    var area = 0.0
    var var_area = 0.0
    var prev_time = 0.0
    var prev_surv = 1.0
    var min_conf = 1.0

    var i = 0
    while i < est.n_points {
        let t = surv_min(est.times[i], tau)
        if t > prev_time {
            let dt = t - prev_time
            let s_mid = 0.5 * (prev_surv + est.survival[i])
            area = area + dt * s_mid

            // Variance via Greenwood
            let u = est.uncertainty[i]
            var_area = var_area + dt * dt * u * u
        }
        if est.confidence[i] < min_conf { min_conf = est.confidence[i] }
        prev_time = t
        prev_surv = est.survival[i]
        if t >= tau { i = est.n_points }  // break
        i = i + 1
    }

    // Extend to tau if needed
    if prev_time < tau {
        area = area + (tau - prev_time) * prev_surv
    }

    RMSTResult {
        rmst: area,
        u_rmst: surv_sqrt(var_area),
        confidence: min_conf,
    }
}
