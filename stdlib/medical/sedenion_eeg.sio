// Sounio Standard Library: EEG/MEG Analysis with Sedenions
//
// This module provides sedenion-based analysis of electroencephalogram (EEG)
// and magnetoencephalogram (MEG) brain signals. Sedenions (16D hypercomplex
// numbers) naturally encode 16-channel electrode clusters, enabling compact
// spatial-temporal analysis.
//
// Applications:
// - Multi-channel EEG signal processing
// - Source localization
// - Connectivity analysis
// - Event-related potential (ERP) extraction
// - Brain-computer interface (BCI) features
//
// Channel Mapping (16-electrode montage):
// Standard 10-20 system subset:
//   e0  = Fp1 (frontal pole left)    e8  = T7 (temporal left)
//   e1  = Fp2 (frontal pole right)   e9  = T8 (temporal right)
//   e2  = F3 (frontal left)          e10 = P7 (parietal left)
//   e3  = F4 (frontal right)         e11 = P8 (parietal right)
//   e4  = C3 (central left)          e12 = O1 (occipital left)
//   e5  = C4 (central right)         e13 = O2 (occipital right)
//   e6  = Fz (frontal midline)       e14 = Pz (parietal midline)
//   e7  = Cz (central midline)       e15 = Oz (occipital midline)
//
// Mathematical Framework:
// - Each time sample is a sedenion encoding 16-channel voltages
// - Sedenion multiplication captures cross-channel correlations
// - Sedenion conjugate relates to spatial inversion
//
// References:
// - Niedermeyer & da Silva (2005) Electroencephalography
// - Makeig et al. (2004) Mining event-related brain dynamics
// - Delorme & Makeig (2004) EEGLAB

use math::sedenion;

// Electrode position indices (10-20 system)
let FP1: i32 = 0
let FP2: i32 = 1
let F3: i32 = 2
let F4: i32 = 3
let C3: i32 = 4
let C4: i32 = 5
let FZ: i32 = 6
let CZ: i32 = 7
let T7: i32 = 8
let T8: i32 = 9
let P7: i32 = 10
let P8: i32 = 11
let O1: i32 = 12
let O2: i32 = 13
let PZ: i32 = 14
let OZ: i32 = 15

// EEG acquisition parameters
struct EEGParams {
    sample_rate: f32,      // Hz (typically 256, 512, 1024)
    reference: str,        // "average", "linked_ears", "Cz", etc.
    notch_freq: f32,       // Notch filter frequency (50 or 60 Hz)
    bandpass_low: f32,     // Bandpass low cutoff (Hz)
    bandpass_high: f32,    // Bandpass high cutoff (Hz)
}

// Default clinical EEG parameters
fn default_eeg_params() -> EEGParams {
    EEGParams {
        sample_rate: 256.0,
        reference: "average",
        notch_freq: 60.0,
        bandpass_low: 0.5,
        bandpass_high: 70.0,
    }
}

// Single time sample: 16-channel sedenion
struct EEGSample {
    channels: Sedenion,   // Voltages in microvolts
    timestamp: f64,       // Time in seconds
}

// EEG epoch (segment of continuous recording)
struct EEGEpoch {
    samples: [Sedenion],  // Time series of sedenion samples
    start_time: f64,      // Epoch start time (s)
    sample_rate: f32,     // Samples per second
    label: str,           // Event label ("stimulus", "rest", etc.)
}

// Create EEG epoch from raw data arrays
fn create_epoch(
    data: [[f32; 16]],    // [time][channel] data
    start_time: f64,
    sample_rate: f32,
    label: str
) -> EEGEpoch {
    var samples: [Sedenion] = []

    for t in 0..len(data) {
        let s = sedenion_from_array(data[t])
        samples = samples ++ [s]
    }

    EEGEpoch {
        samples: samples,
        start_time: start_time,
        sample_rate: sample_rate,
        label: label,
    }
}

// Get epoch duration in seconds
fn epoch_duration(epoch: EEGEpoch) -> f64 {
    (len(epoch.samples) as f64) / (epoch.sample_rate as f64)
}

// Get sample at time index
fn get_sample(epoch: EEGEpoch, t: i32) -> Sedenion {
    if t >= 0 && t < len(epoch.samples) {
        epoch.samples[t]
    } else {
        sedenion_zero()
    }
}

// Average re-referencing: subtract mean across channels
fn rereference_average(epoch: EEGEpoch) -> EEGEpoch {
    var new_samples: [Sedenion] = []

    for sample in epoch.samples {
        // Compute mean voltage
        var mean_voltage = 0.0
        for c in 0..16 {
            mean_voltage = mean_voltage + sedenion_get_component(sample, c)
        }
        mean_voltage = mean_voltage / 16.0

        // Subtract mean from each channel
        var rereferenced = sample
        for c in 0..16 {
            let val = sedenion_get_component(sample, c) - mean_voltage
            rereferenced = sedenion_set_component(rereferenced, c, val)
        }

        new_samples = new_samples ++ [rereferenced]
    }

    EEGEpoch {
        samples: new_samples,
        start_time: epoch.start_time,
        sample_rate: epoch.sample_rate,
        label: epoch.label,
    }
}

// Band-pass filter using simple IIR (Butterworth approximation)
struct FilterState {
    x1: Sedenion,  // Previous input
    x2: Sedenion,  // 2nd previous input
    y1: Sedenion,  // Previous output
    y2: Sedenion,  // 2nd previous output
}

fn init_filter_state() -> FilterState {
    FilterState {
        x1: sedenion_zero(),
        x2: sedenion_zero(),
        y1: sedenion_zero(),
        y2: sedenion_zero(),
    }
}

// Apply 2nd order IIR filter to epoch
fn apply_bandpass(epoch: EEGEpoch, low_hz: f32, high_hz: f32) -> EEGEpoch with Epistemic {
    let fs = epoch.sample_rate

    // Simple butterworth coefficients (approximation)
    let wl = 2.0 * 3.14159 * low_hz / fs
    let wh = 2.0 * 3.14159 * high_hz / fs

    // Precomputed for typical values (placeholder - real would use bilinear transform)
    let b0 = 0.067
    let b1 = 0.0
    let b2 = -0.067
    let a1 = -1.142
    let a2 = 0.412

    var state = init_filter_state()
    var new_samples: [Sedenion] = []

    for sample in epoch.samples {
        // y[n] = b0*x[n] + b1*x[n-1] + b2*x[n-2] - a1*y[n-1] - a2*y[n-2]
        var y = sedenion_zero()
        for c in 0..16 {
            let x0 = sedenion_get_component(sample, c)
            let x1 = sedenion_get_component(state.x1, c)
            let x2 = sedenion_get_component(state.x2, c)
            let y1 = sedenion_get_component(state.y1, c)
            let y2 = sedenion_get_component(state.y2, c)

            let yn = b0 * x0 + b1 * x1 + b2 * x2 - a1 * y1 - a2 * y2
            y = sedenion_set_component(y, c, yn)
        }

        // Update state
        state.x2 = state.x1
        state.x1 = sample
        state.y2 = state.y1
        state.y1 = y

        new_samples = new_samples ++ [y]
    }

    EEGEpoch {
        samples: new_samples,
        start_time: epoch.start_time,
        sample_rate: epoch.sample_rate,
        label: epoch.label,
    }
}

// Compute power spectral density per channel
struct PowerSpectrum {
    frequencies: [f32],    // Frequency bins (Hz)
    power: [Sedenion],     // Power per channel per frequency
    total_power: f32,      // Total power across all channels
}

// Simple FFT-based power spectrum (DFT approximation)
fn compute_power_spectrum(epoch: EEGEpoch) -> PowerSpectrum with Epistemic {
    let n = len(epoch.samples)
    let fs = epoch.sample_rate
    let n_freqs = n / 2 + 1

    var frequencies: [f32] = []
    var power: [Sedenion] = []
    var total_power = 0.0

    // Compute frequencies
    for k in 0..n_freqs {
        let freq = (k as f32) * fs / (n as f32)
        frequencies = frequencies ++ [freq]
        power = power ++ [sedenion_zero()]
    }

    // DFT (simplified - real implementation would use FFT)
    for k in 0..n_freqs {
        var real_sum = sedenion_zero()
        var imag_sum = sedenion_zero()

        for t in 0..n {
            let angle = -2.0 * 3.14159 * (k as f32) * (t as f32) / (n as f32)
            let cos_angle = cos(angle)
            let sin_angle = sin(angle)

            let sample = epoch.samples[t]
            real_sum = sedenion_add(real_sum, sedenion_scale(sample, cos_angle))
            imag_sum = sedenion_add(imag_sum, sedenion_scale(sample, sin_angle))
        }

        // Power = |X(k)|^2 / N
        var psd = sedenion_zero()
        for c in 0..16 {
            let re = sedenion_get_component(real_sum, c)
            let im = sedenion_get_component(imag_sum, c)
            let p = (re * re + im * im) / (n as f32)
            psd = sedenion_set_component(psd, c, p)
            total_power = total_power + p
        }

        power[k] = psd
    }

    PowerSpectrum {
        frequencies: frequencies,
        power: power,
        total_power: total_power,
    }
}

// Extract band power (e.g., alpha 8-12 Hz)
fn band_power(spectrum: PowerSpectrum, low_hz: f32, high_hz: f32) -> Sedenion {
    var bp = sedenion_zero()
    let n_freqs = len(spectrum.frequencies)

    for i in 0..n_freqs {
        let freq = spectrum.frequencies[i]
        if freq >= low_hz && freq <= high_hz {
            bp = sedenion_add(bp, spectrum.power[i])
        }
    }

    bp
}

// Standard EEG frequency bands
fn delta_power(spectrum: PowerSpectrum) -> Sedenion { band_power(spectrum, 0.5, 4.0) }
fn theta_power(spectrum: PowerSpectrum) -> Sedenion { band_power(spectrum, 4.0, 8.0) }
fn alpha_power(spectrum: PowerSpectrum) -> Sedenion { band_power(spectrum, 8.0, 13.0) }
fn beta_power(spectrum: PowerSpectrum) -> Sedenion { band_power(spectrum, 13.0, 30.0) }
fn gamma_power(spectrum: PowerSpectrum) -> Sedenion { band_power(spectrum, 30.0, 70.0) }

// Compute connectivity using sedenion multiplication
// Cross-channel correlation captured in algebraic structure
struct Connectivity {
    coherence: Sedenion,       // Cross-spectral coherence (simplified)
    phase_locking: f32,        // Phase-locking value
    cross_modal_strength: f32, // Sedenion-based connectivity strength
}

fn compute_connectivity(epoch: EEGEpoch) -> Connectivity with Epistemic {
    let n = len(epoch.samples)
    if n < 2 {
        return Connectivity {
            coherence: sedenion_zero(),
            phase_locking: 0.0,
            cross_modal_strength: 0.0,
        }
    }

    // Use sedenion multiplication to capture cross-channel interactions
    var cross_product_sum = sedenion_zero()
    var norm_sum = 0.0

    for t in 0..(n - 1) {
        let s1 = epoch.samples[t]
        let s2 = epoch.samples[t + 1]

        // Sedenion conjugate multiplication captures correlation
        let conj_s1 = sedenion_conj(s1)
        let cross = sedenion_mul(conj_s1, s2)

        cross_product_sum = sedenion_add(cross_product_sum, cross)
        norm_sum = norm_sum + sedenion_norm(s1) * sedenion_norm(s2)
    }

    // Normalize
    let coherence = sedenion_scale(cross_product_sum, 1.0 / ((n - 1) as f32))

    // Phase-locking: consistency of phase difference
    let coh_norm = sedenion_norm(coherence)
    let avg_power = norm_sum / ((n - 1) as f32)
    let phase_locking = if avg_power > 0.0 { coh_norm / sqrt(avg_power) } else { 0.0 }

    // Cross-modal strength from sedenion algebraic properties
    let self_mul = sedenion_mul(coherence, coherence)
    let cross_modal_strength = sedenion_norm(self_mul) / (coh_norm * coh_norm + 1e-10)

    Connectivity {
        coherence: coherence,
        phase_locking: phase_locking,
        cross_modal_strength: cross_modal_strength,
    }
}

// Event-Related Potential (ERP) computation
struct ERP {
    average: [Sedenion],    // Grand average waveform
    std_dev: [Sedenion],    // Standard deviation across trials
    n_trials: i32,          // Number of averaged trials
    time_axis: [f32],       // Time points (ms)
}

// Compute ERP from multiple epochs
fn compute_erp(epochs: [EEGEpoch]) -> ERP with Epistemic {
    if len(epochs) == 0 {
        return ERP {
            average: [],
            std_dev: [],
            n_trials: 0,
            time_axis: [],
        }
    }

    let n_samples = len(epochs[0].samples)
    let fs = epochs[0].sample_rate
    let n_trials = len(epochs)

    // Initialize accumulators
    var sum: [Sedenion] = []
    var sum_sq: [Sedenion] = []
    var time_axis: [f32] = []

    for t in 0..n_samples {
        sum = sum ++ [sedenion_zero()]
        sum_sq = sum_sq ++ [sedenion_zero()]
        let time_ms = (t as f32) * 1000.0 / fs
        time_axis = time_axis ++ [time_ms]
    }

    // Accumulate across trials
    for epoch in epochs {
        for t in 0..n_samples {
            if t < len(epoch.samples) {
                let sample = epoch.samples[t]
                sum[t] = sedenion_add(sum[t], sample)

                // Squared for variance
                let sq = sedenion_mul_componentwise(sample, sample)
                sum_sq[t] = sedenion_add(sum_sq[t], sq)
            }
        }
    }

    // Compute mean and standard deviation
    var average: [Sedenion] = []
    var std_dev: [Sedenion] = []

    for t in 0..n_samples {
        let mean = sedenion_scale(sum[t], 1.0 / (n_trials as f32))
        average = average ++ [mean]

        // Variance = E[X^2] - E[X]^2
        let mean_sq = sedenion_scale(sum_sq[t], 1.0 / (n_trials as f32))
        let mean_squared = sedenion_mul_componentwise(mean, mean)
        let variance = sedenion_sub(mean_sq, mean_squared)

        // Standard deviation (component-wise sqrt)
        var sd = sedenion_zero()
        for c in 0..16 {
            let v = sedenion_get_component(variance, c)
            let s = if v > 0.0 { sqrt(v) } else { 0.0 }
            sd = sedenion_set_component(sd, c, s)
        }
        std_dev = std_dev ++ [sd]
    }

    ERP {
        average: average,
        std_dev: std_dev,
        n_trials: n_trials,
        time_axis: time_axis,
    }
}

// BCI feature extraction: extract features for classification
struct BCIFeatures {
    band_powers: [Sedenion; 5],    // Delta, theta, alpha, beta, gamma
    connectivity: f32,             // Global connectivity measure
    asymmetry: Sedenion,           // Left-right asymmetry
    spatial_complexity: f32,       // Spatial pattern complexity
}

fn extract_bci_features(epoch: EEGEpoch) -> BCIFeatures with Epistemic {
    // Power spectrum
    let spectrum = compute_power_spectrum(epoch)

    let band_powers: [Sedenion; 5] = [
        delta_power(spectrum),
        theta_power(spectrum),
        alpha_power(spectrum),
        beta_power(spectrum),
        gamma_power(spectrum)
    ]

    // Connectivity
    let conn = compute_connectivity(epoch)

    // Left-right asymmetry (log ratio of homologous pairs)
    var asymmetry = sedenion_zero()
    // Fp1-Fp2
    let ratio0 = compute_asymmetry_ratio(spectrum, FP1, FP2)
    asymmetry = sedenion_set_component(asymmetry, 0, ratio0)
    // F3-F4
    let ratio1 = compute_asymmetry_ratio(spectrum, F3, F4)
    asymmetry = sedenion_set_component(asymmetry, 1, ratio1)
    // C3-C4
    let ratio2 = compute_asymmetry_ratio(spectrum, C3, C4)
    asymmetry = sedenion_set_component(asymmetry, 2, ratio2)
    // P7-P8
    let ratio3 = compute_asymmetry_ratio(spectrum, P7, P8)
    asymmetry = sedenion_set_component(asymmetry, 3, ratio3)
    // O1-O2
    let ratio4 = compute_asymmetry_ratio(spectrum, O1, O2)
    asymmetry = sedenion_set_component(asymmetry, 4, ratio4)

    // Spatial complexity: sedenion norm variance
    var spatial_complexity = 0.0
    let n = len(epoch.samples)
    var norm_sum = 0.0
    var norm_sq_sum = 0.0

    for sample in epoch.samples {
        let norm = sedenion_norm(sample)
        norm_sum = norm_sum + norm
        norm_sq_sum = norm_sq_sum + norm * norm
    }

    let mean_norm = norm_sum / (n as f32)
    let var_norm = norm_sq_sum / (n as f32) - mean_norm * mean_norm
    spatial_complexity = sqrt(var_norm) / (mean_norm + 1e-10)

    BCIFeatures {
        band_powers: band_powers,
        connectivity: conn.cross_modal_strength,
        asymmetry: asymmetry,
        spatial_complexity: spatial_complexity,
    }
}

fn compute_asymmetry_ratio(spectrum: PowerSpectrum, left: i32, right: i32) -> f32 {
    let alpha = alpha_power(spectrum)
    let left_power = sedenion_get_component(alpha, left)
    let right_power = sedenion_get_component(alpha, right)

    if left_power > 0.0 && right_power > 0.0 {
        log(right_power / left_power)
    } else {
        0.0
    }
}

// Component-wise sedenion multiplication (element-by-element)
fn sedenion_mul_componentwise(a: Sedenion, b: Sedenion) -> Sedenion {
    var result = sedenion_zero()
    for i in 0..16 {
        let ai = sedenion_get_component(a, i)
        let bi = sedenion_get_component(b, i)
        result = sedenion_set_component(result, i, ai * bi)
    }
    result
}

// Get electrode name from index
fn electrode_name(index: i32) -> str {
    match index {
        0 => "Fp1",
        1 => "Fp2",
        2 => "F3",
        3 => "F4",
        4 => "C3",
        5 => "C4",
        6 => "Fz",
        7 => "Cz",
        8 => "T7",
        9 => "T8",
        10 => "P7",
        11 => "P8",
        12 => "O1",
        13 => "O2",
        14 => "Pz",
        15 => "Oz",
        _ => "Unknown",
    }
}

// Helper: Create sedenion from 16-element array
fn sedenion_from_array(arr: [f32; 16]) -> Sedenion {
    sedenion_new(
        arr[0], arr[1], arr[2], arr[3],
        arr[4], arr[5], arr[6], arr[7],
        arr[8], arr[9], arr[10], arr[11],
        arr[12], arr[13], arr[14], arr[15]
    )
}

// ============================================================================
// SCALAR EEG ANALYSIS (single-channel, Vec<f64> interface)
// ============================================================================

// Standard EEG frequency bands from a single-channel scalar analysis
struct EegBands {
    delta: f64,   // 0.5–4 Hz
    theta: f64,   // 4–8 Hz
    alpha: f64,   // 8–13 Hz
    beta: f64,    // 13–30 Hz
    gamma: f64,   // 30–100 Hz
}

// Scalar math helpers (f64 versions for single-channel analysis)
fn abs_f64_eeg(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn sqrt_f64_eeg(x: f64) -> f64 {
    if x <= 0.0 { return 0.0 }
    var g = x / 2.0
    if g < 1.0 { g = 1.0 }
    var i = 0
    while i < 25 {
        g = (g + x / g) / 2.0
        i = i + 1
    }
    g
}

// cos via Taylor series (f64, for DFT angle computation)
fn cos_f64_eeg(x: f64) -> f64 {
    // Reduce x to [-pi, pi] range using repeated subtraction
    let two_pi = 6.283185307179586
    var xr = x
    while xr > 3.14159265358979 { xr = xr - two_pi }
    while xr < -3.14159265358979 { xr = xr + two_pi }
    var sum = 1.0
    var term = 1.0
    var i = 1
    while i < 15 {
        term = term * (0.0 - xr * xr) / ((2 * i - 1) * (2 * i)) as f64
        sum = sum + term
        i = i + 1
    }
    sum
}

// sin via Taylor series (f64)
fn sin_f64_eeg(x: f64) -> f64 {
    let two_pi = 6.283185307179586
    var xr = x
    while xr > 3.14159265358979 { xr = xr - two_pi }
    while xr < -3.14159265358979 { xr = xr + two_pi }
    var sum = xr
    var term = xr
    var i = 1
    while i < 15 {
        term = term * (0.0 - xr * xr) / ((2 * i) * (2 * i + 1)) as f64
        sum = sum + term
        i = i + 1
    }
    sum
}

// atan2 approximation (for Hilbert phase estimation)
fn atan2_f64_eeg(y: f64, x: f64) -> f64 {
    let pi = 3.14159265358979
    if x > 0.0 {
        atan_f64_eeg(y / x)
    } else if x < 0.0 && y >= 0.0 {
        atan_f64_eeg(y / x) + pi
    } else if x < 0.0 && y < 0.0 {
        atan_f64_eeg(y / x) - pi
    } else if x == 0.0 && y > 0.0 {
        pi / 2.0
    } else if x == 0.0 && y < 0.0 {
        0.0 - pi / 2.0
    } else {
        0.0
    }
}

// atan via Maclaurin series (convergent for |z| <= 1; uses identity for |z| > 1)
fn atan_f64_eeg(z: f64) -> f64 {
    let pi = 3.14159265358979
    if abs_f64_eeg(z) > 1.0 {
        // atan(z) = pi/2 - atan(1/z) for z > 0
        if z > 0.0 {
            pi / 2.0 - atan_small_f64_eeg(1.0 / z)
        } else {
            0.0 - pi / 2.0 - atan_small_f64_eeg(1.0 / z)
        }
    } else {
        atan_small_f64_eeg(z)
    }
}

// atan series for |z| <= 1
fn atan_small_f64_eeg(z: f64) -> f64 {
    var sum = z
    var term = z
    var i = 1
    while i < 20 {
        term = term * (0.0 - z * z)
        sum = sum + term / (2 * i + 1) as f64
        i = i + 1
    }
    sum
}

// Compute power spectrum via direct DFT for a scalar signal
// Returns power[k] = (Re[k]^2 + Im[k]^2) / N for k = 0..N/2
// signal: time-domain samples; sample_rate: Hz (used only for frequency labeling)
fn compute_power_spectrum_scalar(signal: Vec<f64>, sample_rate: f64) -> Vec<f64> {
    let n = signal.len()
    if n == 0 { return Vec::new() }

    let n_freqs = n / 2 + 1
    var power: Vec<f64> = Vec::new()

    let pi = 3.14159265358979
    let two_pi_over_n = 2.0 * pi / n as f64

    var k = 0
    while k < n_freqs {
        var re = 0.0
        var im = 0.0
        var t = 0
        while t < n {
            let angle = two_pi_over_n * k as f64 * t as f64
            re = re + signal[t] * cos_f64_eeg(angle)
            im = im - signal[t] * sin_f64_eeg(angle)
            t = t + 1
        }
        power.push((re * re + im * im) / n as f64)
        k = k + 1
    }

    power
}

// Extract total power in a frequency band [low_hz, high_hz] from power spectrum
// power: output of compute_power_spectrum_scalar; sample_rate and n_samples needed for bin->Hz mapping
fn extract_band_power(power: Vec<f64>, sample_rate: f64, low_hz: f64, high_hz: f64) -> f64 {
    let n = power.len()
    if n == 0 { return 0.0 }
    // N (original signal length) ≈ 2*(n-1) since n_freqs = N/2 + 1
    let n_signal = 2 * (n - 1)
    var total = 0.0
    var k = 0
    while k < n {
        let bin_freq = k as f64 * sample_rate / n_signal as f64
        if bin_freq >= low_hz && bin_freq <= high_hz {
            total = total + power[k]
        }
        k = k + 1
    }
    total
}

// Compute all standard EEG band powers from a single-channel signal
fn compute_eeg_bands(signal: Vec<f64>, sample_rate: f64) -> EegBands {
    let power = compute_power_spectrum_scalar(signal, sample_rate)
    EegBands {
        delta: extract_band_power(power, sample_rate, 0.5, 4.0),
        theta: extract_band_power(power, sample_rate, 4.0, 8.0),
        alpha: extract_band_power(power, sample_rate, 8.0, 13.0),
        beta: extract_band_power(power, sample_rate, 13.0, 30.0),
        gamma: extract_band_power(power, sample_rate, 30.0, 100.0),
    }
}

// ============================================================================
// PHASE LOCKING VALUE (PLV) between two single-channel signals
// ============================================================================

// Approximate instantaneous phase of a signal via Hilbert transform approximation.
// Uses a causal FIR odd-harmonic approximation: each sample's imaginary part is
// approximated by a 5-tap weighted sum of neighboring samples (Bedrosian approach).
// Phase = atan2(hilbert_imag[n], signal[n])
fn estimate_instantaneous_phase(signal: Vec<f64>) -> Vec<f64> {
    let n = signal.len()
    var phases: Vec<f64> = Vec::new()

    // 5-tap FIR Hilbert coefficients h[k] for k = -2..2 (odd-symmetric, causal approx)
    // h[-2] = 2/(-2*pi), h[-1] = 2/(-1*pi), h[0] = 0, h[1] = 2/(1*pi), h[2] = 2/(2*pi)
    // Equivalent: h[+1] = 2/pi ≈ 0.6366, h[+2] = 1/pi ≈ 0.3183 (and negatives)
    let pi = 3.14159265358979
    let h1 = 2.0 / pi          // tap at offset ±1
    let h2 = 2.0 / (2.0 * pi)  // tap at offset ±2

    var i = 0
    while i < n {
        // Hilbert imaginary part approximation using symmetric taps
        var hilb = 0.0
        if i >= 1 { hilb = hilb + h1 * signal[i - 1] }
        if i >= 2 { hilb = hilb + h2 * signal[i - 2] }
        if i + 1 < n { hilb = hilb - h1 * signal[i + 1] }
        if i + 2 < n { hilb = hilb - h2 * signal[i + 2] }

        let phase = atan2_f64_eeg(hilb, signal[i])
        phases.push(phase)
        i = i + 1
    }

    phases
}

// Phase Locking Value between two signals
// PLV = |mean(exp(i*(phase_a - phase_b)))| = sqrt(mean_cos^2 + mean_sin^2)
fn compute_plv(signal_a: Vec<f64>, signal_b: Vec<f64>) -> f64 {
    let n = signal_a.len()
    if n == 0 { return 0.0 }

    let phase_a = estimate_instantaneous_phase(signal_a)
    let phase_b = estimate_instantaneous_phase(signal_b)

    let n_b = signal_b.len()
    let n_use = if n < n_b { n } else { n_b }

    var sum_cos = 0.0
    var sum_sin = 0.0
    var i = 0
    while i < n_use {
        let phase_diff = phase_a[i] - phase_b[i]
        sum_cos = sum_cos + cos_f64_eeg(phase_diff)
        sum_sin = sum_sin + sin_f64_eeg(phase_diff)
        i = i + 1
    }

    let mean_cos = sum_cos / n_use as f64
    let mean_sin = sum_sin / n_use as f64

    sqrt_f64_eeg(mean_cos * mean_cos + mean_sin * mean_sin)
}

