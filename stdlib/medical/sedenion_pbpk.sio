// Sounio Standard Library: 16-Compartment PBPK Modeling with Sedenions
//
// This module provides physiologically-based pharmacokinetic (PBPK) modeling
// for a 16-compartment mammalian body using sedenions to represent state.
// Sedenions (16D hypercomplex numbers) encode the drug amount in each compartment
// as components e0 to e15.
//
// Mathematical Model Overview:
// - State: Sedenion where e0 = plasma, e1 = heart, ..., e15 = gonads
// - Dynamics: Linear compartmental model dA/dt = Q * (C_in - C_out)
// - Inputs: IV dose to plasma; elimination from liver/kidney
// - Uncertainty: Propagated via Knowledge<T> effect
//
// Compartment Mapping (16-compartment whole-body model):
//   e0  = Plasma (central)     e8  = Skin
//   e1  = Heart                e9  = Bone
//   e2  = Lung                 e10 = Gut (GI tract)
//   e3  = Brain                e11 = Spleen
//   e4  = Liver                e12 = Pancreas
//   e5  = Kidney               e13 = Thyroid
//   e6  = Muscle               e14 = Adrenal
//   e7  = Fat (adipose)        e15 = Gonads
//
// References:
// - Rowland & Tozer (2011) Clinical Pharmacokinetics
// - Jones & Rowland-Yeo (2013) Basic concepts in PBPK modeling
// - Rodgers et al. (2005) Tissue-plasma partition coefficients

use math/sedenion

// Compartment index constants
let PLASMA: i32 = 0
let HEART: i32 = 1
let LUNG: i32 = 2
let BRAIN: i32 = 3
let LIVER: i32 = 4
let KIDNEY: i32 = 5
let MUSCLE: i32 = 6
let FAT: i32 = 7
let SKIN: i32 = 8
let BONE: i32 = 9
let GUT: i32 = 10
let SPLEEN: i32 = 11
let PANCREAS: i32 = 12
let THYROID: i32 = 13
let ADRENAL: i32 = 14
let GONADS: i32 = 15

// Physiological parameters for a drug and body
struct PhysiologicalParams {
    // Compartment volumes (L) - encoded as sedenion
    volumes: Sedenion,

    // Blood flow fractions (relative to cardiac output) - encoded as sedenion
    flow_fractions: Sedenion,

    // Tissue-plasma partition coefficients Kp - encoded as sedenion
    partition_coeffs: Sedenion,

    // Cardiac output (L/h)
    cardiac_output: f32,

    // Hepatic intrinsic clearance (L/h)
    liver_cl_int: f32,

    // Renal intrinsic clearance (L/h)
    kidney_cl_int: f32,

    // Fraction unbound in plasma
    fu: f32,
}

// PBPK state: sedenion-encoded amounts in each compartment
struct PBPKState16 {
    // Drug amounts (mg) in each compartment - sedenion encoding
    amounts: Sedenion,

    // Current simulation time (h)
    time: f32,
}

// Create default human physiological parameters (70 kg adult male)
fn default_human_params() -> PhysiologicalParams {
    // Volumes (L) - from ICRP 89 reference values
    let volumes = sedenion_from_array([
        3.0,    // e0: plasma
        0.31,   // e1: heart
        0.5,    // e2: lung
        1.45,   // e3: brain
        1.8,    // e4: liver
        0.31,   // e5: kidney
        29.0,   // e6: muscle
        18.2,   // e7: fat
        3.3,    // e8: skin
        10.5,   // e9: bone
        1.65,   // e10: gut
        0.18,   // e11: spleen
        0.14,   // e12: pancreas
        0.02,   // e13: thyroid
        0.014,  // e14: adrenal
        0.035   // e15: gonads
    ])

    // Blood flow fractions (relative to cardiac output)
    // Based on Williams & Leggett (1989) cardiac output distribution
    let flow_fractions = sedenion_from_array([
        0.0,    // e0: plasma (not a tissue)
        0.04,   // e1: heart (coronary)
        1.0,    // e2: lung (full cardiac output)
        0.12,   // e3: brain
        0.255,  // e4: liver (hepatic artery + portal vein)
        0.19,   // e5: kidney
        0.17,   // e6: muscle
        0.052,  // e7: fat
        0.05,   // e8: skin
        0.05,   // e9: bone
        0.15,   // e10: gut (-> portal vein -> liver)
        0.03,   // e11: spleen (-> portal vein -> liver)
        0.01,   // e12: pancreas
        0.016,  // e13: thyroid
        0.003,  // e14: adrenal
        0.0005  // e15: gonads
    ])

    // Example partition coefficients for a moderately lipophilic drug
    let partition_coeffs = sedenion_from_array([
        1.0,    // e0: plasma (reference)
        1.2,    // e1: heart
        0.8,    // e2: lung
        2.0,    // e3: brain
        3.5,    // e4: liver
        2.1,    // e5: kidney
        0.6,    // e6: muscle
        15.0,   // e7: fat (lipophilic accumulation)
        1.1,    // e8: skin
        0.4,    // e9: bone
        2.5,    // e10: gut
        1.8,    // e11: spleen
        2.2,    // e12: pancreas
        1.5,    // e13: thyroid
        1.9,    // e14: adrenal
        2.0     // e15: gonads
    ])

    PhysiologicalParams {
        volumes: volumes,
        flow_fractions: flow_fractions,
        partition_coeffs: partition_coeffs,
        cardiac_output: 348.0,  // L/h (5.8 L/min)
        liver_cl_int: 15.0,     // L/h
        kidney_cl_int: 8.0,     // L/h
        fu: 0.1,                // 10% unbound
    }
}

// Create initial state with IV bolus dose to plasma
fn initial_state_iv_bolus(dose_mg: f32) -> PBPKState16 {
    // All drug starts in plasma compartment (e0)
    var amounts = sedenion_zero()
    amounts = sedenion_set_component(amounts, 0, dose_mg)

    PBPKState16 {
        amounts: amounts,
        time: 0.0,
    }
}

// Get concentration in compartment i (mg/L)
fn get_concentration(state: PBPKState16, params: PhysiologicalParams, compartment: i32) -> f32 {
    let amount = sedenion_get_component(state.amounts, compartment)
    let volume = sedenion_get_component(params.volumes, compartment)
    if volume > 0.0 {
        amount / volume
    } else {
        0.0
    }
}

// Compute concentration normalized by partition coefficient
fn get_venous_concentration(state: PBPKState16, params: PhysiologicalParams, compartment: i32) -> f32 {
    let conc = get_concentration(state, params, compartment)
    let kp = sedenion_get_component(params.partition_coeffs, compartment)
    if kp > 0.0 {
        conc / kp
    } else {
        conc
    }
}

// Compute the derivative dA/dt for all compartments
// Returns a sedenion where each component is the rate of change (mg/h)
fn compute_derivative(state: PBPKState16, params: PhysiologicalParams, dose_rate: f32) -> Sedenion {
    let q_card = params.cardiac_output
    let c_plasma = get_concentration(state, params, PLASMA)
    let c_arterial = c_plasma  // Well-mixed assumption

    var dadt = sedenion_zero()

    // Plasma derivative: dose input + venous returns - arterial distribution
    var venous_return = 0.0
    for i in 1..16 {
        let q_i = q_card * sedenion_get_component(params.flow_fractions, i)
        let c_ven_i = get_venous_concentration(state, params, i)
        venous_return = venous_return + q_i * c_ven_i
    }
    let d_plasma = dose_rate + venous_return - q_card * c_arterial
    dadt = sedenion_set_component(dadt, PLASMA, d_plasma)

    // Tissue compartments (perfusion-limited model)
    for i in 1..16 {
        let q_i = q_card * sedenion_get_component(params.flow_fractions, i)
        let c_ven_i = get_venous_concentration(state, params, i)

        // Base rate: Q_i * (C_arterial - C_venous)
        var rate = q_i * (c_arterial - c_ven_i)

        // Add hepatic clearance for liver
        if i == LIVER {
            let cl_hep = params.liver_cl_int * params.fu
            rate = rate - cl_hep * c_ven_i
        }

        // Add renal clearance for kidney
        if i == KIDNEY {
            let cl_ren = params.kidney_cl_int * params.fu
            rate = rate - cl_ren * c_ven_i
        }

        dadt = sedenion_set_component(dadt, i, rate)
    }

    dadt
}

// Single PBPK timestep using Forward Euler integration
// Returns updated state after dt hours
fn pbpk_step(state: PBPKState16, params: PhysiologicalParams, dt: f32, dose_rate: f32) -> PBPKState16 with Epistemic {
    let dadt = compute_derivative(state, params, dose_rate)

    // Euler step: A(t+dt) = A(t) + dt * dA/dt
    let new_amounts = sedenion_add(state.amounts, sedenion_scale(dadt, dt))

    // Ensure non-negative amounts (mass conservation)
    var clamped_amounts = new_amounts
    for i in 0..16 {
        let amt = sedenion_get_component(new_amounts, i)
        if amt < 0.0 {
            clamped_amounts = sedenion_set_component(clamped_amounts, i, 0.0)
        }
    }

    PBPKState16 {
        amounts: clamped_amounts,
        time: state.time + dt,
    }
}

// Run simulation for specified duration
fn simulate(initial_state: PBPKState16, params: PhysiologicalParams,
            duration: f32, dt: f32, dose_rate: f32) -> [PBPKState16] with Epistemic {
    let n_steps = (duration / dt) as i32
    var states: [PBPKState16] = []
    var current = initial_state

    states = states ++ [current]

    for step in 0..n_steps {
        current = pbpk_step(current, params, dt, dose_rate)
        states = states ++ [current]
    }

    states
}

// Compute steady-state concentrations using fixed-point iteration
fn steady_state(params: PhysiologicalParams, dose_rate: f32, tolerance: f32) -> PBPKState16 with Epistemic {
    var state = initial_state_iv_bolus(0.0)  // Start from zero
    let dt = 0.01  // Small timestep for stability
    let max_iterations = 100000

    for iter in 0..max_iterations {
        let prev_amounts = state.amounts
        state = pbpk_step(state, params, dt, dose_rate)

        // Check convergence: ||A_new - A_old|| < tolerance
        let diff = sedenion_sub(state.amounts, prev_amounts)
        let norm_diff = sedenion_norm(diff)

        if norm_diff < tolerance {
            return state
        }
    }

    // Return best estimate if not converged
    state
}

// Calculate Area Under the Curve (AUC) for plasma using trapezoidal rule
// Takes array of states from simulation
fn calculate_auc_plasma(states: [PBPKState16], params: PhysiologicalParams) -> f32 {
    var auc = 0.0

    if len(states) < 2 {
        return 0.0
    }

    for i in 1..len(states) {
        let c1 = get_concentration(states[i - 1], params, PLASMA)
        let c2 = get_concentration(states[i], params, PLASMA)
        let t1 = states[i - 1].time
        let t2 = states[i].time

        // Trapezoidal rule
        auc = auc + 0.5 * (c1 + c2) * (t2 - t1)
    }

    auc
}

// Calculate total systemic clearance: CL = Dose / AUC
fn calculate_clearance(dose_mg: f32, auc: f32) -> f32 {
    if auc > 0.0 {
        dose_mg / auc
    } else {
        0.0
    }
}

// Calculate volume of distribution at steady state
fn calculate_vss(params: PhysiologicalParams) -> f32 {
    var vss = 0.0

    for i in 0..16 {
        let vol = sedenion_get_component(params.volumes, i)
        let kp = sedenion_get_component(params.partition_coeffs, i)
        vss = vss + vol * kp
    }

    vss
}

// Calculate terminal half-life from clearance and Vss
fn calculate_half_life(clearance: f32, vss: f32) -> f32 {
    if clearance > 0.0 {
        0.693 * vss / clearance
    } else {
        0.0
    }
}

// Knowledge-wrapped PBPK step for epistemic uncertainty propagation
fn pbpk_step_epistemic(
    state: Knowledge<PBPKState16>,
    params: Knowledge<PhysiologicalParams>,
    dt: f32,
    dose_rate: f32
) -> Knowledge<PBPKState16> with Epistemic {
    // Propagate uncertainty through simulation
    let new_state = pbpk_step(state.value, params.value, dt, dose_rate)

    // Uncertainty grows with time (simplified model)
    // In full model, would use sensitivity analysis
    let time_factor = 1.0 + 0.01 * new_state.time
    let new_uncertainty = state.uncertainty * time_factor + params.uncertainty * 0.1

    Knowledge {
        value: new_state,
        uncertainty: new_uncertainty,
    }
}

// Export drug concentrations to array format
fn export_concentrations(state: PBPKState16, params: PhysiologicalParams) -> [f32; 16] {
    var concs: [f32; 16] = [0.0; 16]

    for i in 0..16 {
        concs[i] = get_concentration(state, params, i)
    }

    concs
}

// Get compartment name from index
fn compartment_name(index: i32) -> str {
    match index {
        0 => "Plasma",
        1 => "Heart",
        2 => "Lung",
        3 => "Brain",
        4 => "Liver",
        5 => "Kidney",
        6 => "Muscle",
        7 => "Fat",
        8 => "Skin",
        9 => "Bone",
        10 => "Gut",
        11 => "Spleen",
        12 => "Pancreas",
        13 => "Thyroid",
        14 => "Adrenal",
        15 => "Gonads",
        _ => "Unknown",
    }
}

// Helper: Create sedenion from 16-element array
fn sedenion_from_array(arr: [f32; 16]) -> Sedenion {
    sedenion_new(
        arr[0], arr[1], arr[2], arr[3],
        arr[4], arr[5], arr[6], arr[7],
        arr[8], arr[9], arr[10], arr[11],
        arr[12], arr[13], arr[14], arr[15]
    )
}

// Module exports
mod sedenion_pbpk {
    pub type PhysiologicalParams
    pub type PBPKState16
    pub fn default_human_params
    pub fn initial_state_iv_bolus
    pub fn pbpk_step
    pub fn simulate
    pub fn steady_state
    pub fn calculate_auc_plasma
    pub fn calculate_clearance
    pub fn calculate_vss
    pub fn calculate_half_life
    pub fn get_concentration
    pub fn compartment_name
}
