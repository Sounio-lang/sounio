// Sounio Standard Library: Medical Applications with Sedenions
//
// This module provides sedenion-based (16D hypercomplex) medical computing libraries.
// Sedenions naturally encode 16-dimensional data, making them ideal for:
// - 16-compartment physiological models (PBPK)
// - 16-channel imaging modalities
// - 16-electrode EEG/MEG montages
//
// IMPORTANT: Zero Divisor Safety
// Sedenions have zero divisors (non-zero elements with zero product).
// All functions that could produce zero divisors are marked and include
// safety checks. Use the SafeSedenion refinement type for division-safe operations.
//
// Submodules:
// - sedenion_pbpk: 16-compartment pharmacokinetic modeling
// - sedenion_imaging: Multi-modal medical imaging fusion
// - sedenion_eeg: EEG/MEG brain signal analysis

pub mod sedenion_pbpk
pub mod sedenion_imaging
pub mod sedenion_eeg

// Re-export commonly used types
pub use sedenion_pbpk::PhysiologicalParams
pub use sedenion_pbpk::PBPKState16
pub use sedenion_imaging::MultiModalImage
pub use sedenion_imaging::RadiomicsFeatures
pub use sedenion_eeg::EEGEpoch
pub use sedenion_eeg::PowerSpectrum
pub use sedenion_eeg::BCIFeatures
