// hypercomplex_graph/erdos_unit_distance — Sounio attack on Erdős #508 and #704
//
// Objective: Use the verified 168 Theorem / ZD bridge structure to generate
// algebraic unit-distance graphs and measure whether zero-divisor "surgery"
// (right-multiplication by a primitive ZD element) can change their chromatic
// number — the first computable, reproducible step toward:
//
//   #508: Chromatic number of the plane (Hadwiger–Nelson)
//   #704: Chromatic number of unit-distance graphs in R^d
//
// HONEST MATHEMATICAL FRAME (verified, not assumed):
// - A point set with integer coordinates whose edges are pairs at squared
//   Euclidean distance == 1 is ALWAYS bipartite (chromatic number <= 2): it is
//   a subgraph of the integer lattice Z^16, 2-colored by parity of coord sum.
// - So the real, non-trivial question is: can a ZD surgery break that
//   bipartite structure (force chromatic number >= 3)?
//
// MECHANISM (confirmed = "ZD surgery / 4D annihilator", not the associator
// route): right-multiply each point by a primitive ZD element v = e_lo ± e_hi.
// This is a linear map on the sedenions with a non-trivial kernel (sedenions
// are NOT norm-multiplicative — the whole point of zero-divisors). Some unit
// edges survive, some are lost (kernel), and some new pairs become "unit".
//
// SOURCE OF TRUTH for the algebra (mirrored exactly, no invented mappings):
//   formal/lean4/SounioZeroDivisorBridge.lean   — PrimSed / validPrims (84) /
//                                                   168 unordered ZD pairs
//   formal/lean4/SounioCayleyDickson.lean        — cdSigma (sign function)
//   self-hosted/check/cayley_dickson.sio         — cd_sigma_ct (same function)
//
// Self-contained (no imports — matches the oct_graph.sio pattern; the run-pass
// harness cannot resolve imports).

module hypercomplex_graph::erdos_unit_distance

// ============================================================================
// Cayley–Dickson sign function  (e_a · e_b = cd_sigma_ct(a,b,4) · e_{a^b} in S)
// Verbatim from self-hosted/check/cayley_dickson.sio (== Lean cdSigma a b 4).
// ============================================================================

fn cd_sigma_ct(a: i64, b: i64, bits: i64) -> i64 {
    if a == 0 || b == 0 { return 1 }
    if bits <= 1 { return 0 - 1 }
    let half = 1 << (bits - 1)
    let a_hi = if a >= half { 1 } else { 0 }
    let b_hi = if b >= half { 1 } else { 0 }
    let a_lo = a & (half - 1)
    let b_lo = b & (half - 1)
    if a_hi == 0 && b_hi == 0 { return cd_sigma_ct(a_lo, b_lo, bits - 1) }
    if a_hi == 0 && b_hi == 1 { return cd_sigma_ct(b_lo, a_lo, bits - 1) }
    if a_hi == 1 && b_hi == 0 {
        if b_lo == 0 { return cd_sigma_ct(a_lo, b_lo, bits - 1) }
        else { return 0 - cd_sigma_ct(a_lo, b_lo, bits - 1) }
    }
    // both hi
    if b_lo == 0 { return 0 - cd_sigma_ct(b_lo, a_lo, bits - 1) }
    return cd_sigma_ct(b_lo, a_lo, bits - 1)
}

fn sed_sigma(a: i64, b: i64) -> i64 { return cd_sigma_ct(a, b, 4) }

fn near(a: f64, b: f64, tol: f64) -> i64 {
    let d = a - b
    let d2 = if d < 0.0 { 0.0 - d } else { d }
    if d2 <= tol { 1 } else { 0 }
}

// ============================================================================
// State (fixed-size flat buffers — native compiler has no dynamic arrays)
// ============================================================================

// 84 valid primitive imaginary sedenions  v = e_lo ± e_hi
var PRIM_LO:  [i64; 84] = [0; 84]
var PRIM_HI:  [i64; 84] = [0; 84]
var PRIM_NEG: [i64; 84] = [0; 84]   // 1 => sign of e_hi is -1
var NPRIM:    i64 = 0

// Probe: NPTS points × 16 coords, flat
var PROBE: [f64; 112] = [0.0; 112]   // 7 * 16
var NPTS:  i64 = 7

// Scratch
var DIFF: [f64; 16] = [0.0; 16]
var TW:   [f64; 16] = [0.0; 16]
var TMP:  [f64; 16] = [0.0; 16]   // intermediate (p·u) for associator surgery
var TW2:  [f64; 16] = [0.0; 16]   // ((p·u)·v) for associator surgery

// 168 unordered ZD pairs (u·v == 0, u lex-before v); headroom 200
var PAIR_U: [i64; 200] = [0; 200]
var PAIR_V: [i64; 200] = [0; 200]
var NPAIR:  i64 = 0

// Conflict-graph adjacency (NPTS x NPTS), 1 = edge
var ADJ: [i64; 49] = [0; 49]   // 7 * 7
var CLASSIC: [i64; 49] = [0; 49]   // saved classical adjacency for edge diffing

// Coloring odometer
var COLORS: [i64; 7] = [0; 7]

// ============================================================================
// §1. Enumerate the 84 valid primitives  (mirror validPrims from the bridge)
//     lo in 1..7, hi in 9..15, exclude (lo ^ hi) == 8.  7*7*2 - 14 = 84.
// ============================================================================

pub fn build_prims() with Mut {
    NPRIM = 0
    var lo = 1
    while lo <= 7 {
        var hi = 9
        while hi <= 15 {
            if (lo ^ hi) != 8 {
                // +1 variant
                PRIM_LO[NPRIM as usize] = lo
                PRIM_HI[NPRIM as usize] = hi
                PRIM_NEG[NPRIM as usize] = 0
                NPRIM = NPRIM + 1
                // -1 variant
                PRIM_LO[NPRIM as usize] = lo
                PRIM_HI[NPRIM as usize] = hi
                PRIM_NEG[NPRIM as usize] = 1
                NPRIM = NPRIM + 1
            }
            hi = hi + 1
        }
        lo = lo + 1
    }
}

// ============================================================================
// §2. Probe configuration (7 vertices in 16D, integer coords).
//     Mirrors moser7_probe in SounioErdosUnitDistance.lean for Sounio<->Lean
//     parity.  Classical (untwisted) graph is necessarily bipartite.
// ============================================================================

fn set_coord(pt: i64, k: i64, v: f64) with Mut {
    PROBE[(pt * 16 + k) as usize] = v
}

pub fn init_probe() with Mut {
    var i = 0
    while i < 112 { PROBE[i as usize] = 0.0; i = i + 1 }
    NPTS = 7
    // Enriched probe: spans BOTH sedenion halves so pairwise xors hit the
    // active ZD fiber labels {9..15}. (A probe using only indices 0..7 makes
    // every surgery act trivially — cross terms vanish, twisted ≡ classical.)
    set_coord(0, 0, 1.0)                        // v0 = e0
    set_coord(1, 1, 1.0)                        // v1 = e1
    set_coord(2, 0, 1.0); set_coord(2, 1, 1.0)  // v2 = e0 + e1
    set_coord(3, 9, 1.0)                        // v3 = e9
    set_coord(4, 10, 1.0)                       // v4 = e10
    set_coord(5, 9, 1.0); set_coord(5, 10, 1.0) // v5 = e9 + e10
    set_coord(6, 1, 1.0); set_coord(6, 9, 1.0)  // v6 = e1 + e9 (cross-half bridge)
}

// DIFF <- PROBE[i] - PROBE[j]
fn point_diff(i: i64, j: i64) with Mut {
    var k = 0
    while k < 16 {
        DIFF[k as usize] = PROBE[(i*16 + k) as usize] - PROBE[(j*16 + k) as usize]
        k = k + 1
    }
}

fn norm_sq(buf: &[f64; 16]) -> f64 {
    var s = 0.0
    var k = 0
    while k < 16 { s = s + (*buf)[k as usize] * (*buf)[k as usize]; k = k + 1 }
    return s
}

// ============================================================================
// §3. ZD surgery: TW <- DIFF · v_idx   (right-multiplication by primitive)
//     (x · e_j)_k = x_{k^j} · sigma(k^j, j);  v = e_lo ± e_hi  => sum of two.
// ============================================================================

fn rmul_prim(idx: i64) with Mut, Panic {
    let lo = PRIM_LO[idx as usize]
    let hi = PRIM_HI[idx as usize]
    let s = if PRIM_NEG[idx as usize] == 1 { 0.0 - 1.0 } else { 1.0 }
    var k = 0
    while k < 16 {
        let klo = k ^ lo
        let khi = k ^ hi
        let t1 = DIFF[klo as usize] * (cd_sigma_ct(klo, lo, 4) as f64)
        let t2 = DIFF[khi as usize] * (cd_sigma_ct(khi, hi, 4) as f64)
        TW[k as usize] = t1 + s * t2
        k = k + 1
    }
}

// ||v||^2 = 2 for every primitive (two unit components). Twisted "unit" target.
fn prim_norm_sq() -> f64 { return 2.0 }

// Generic right-multiplication by primitive idx: out <- inp · v_idx.
fn rmul_into(inp: &[f64; 16], idx: i64, out: &![f64; 16]) with Mut, Panic {
    let lo = PRIM_LO[idx as usize]
    let hi = PRIM_HI[idx as usize]
    let s = if PRIM_NEG[idx as usize] == 1 { 0.0 - 1.0 } else { 1.0 }
    var k = 0
    while k < 16 {
        let klo = k ^ lo
        let khi = k ^ hi
        let t1 = (*inp)[klo as usize] * (cd_sigma_ct(klo, lo, 4) as f64)
        let t2 = (*inp)[khi as usize] * (cd_sigma_ct(khi, hi, 4) as f64)
        (*out)[k as usize] = t1 + s * t2
        k = k + 1
    }
}

// Generic LEFT-multiplication by primitive idx: out <- v_idx · inp.
// (v·x)_k = x_{k^lo}·sigma(lo, k^lo) + s·x_{k^hi}·sigma(hi, k^hi).
// Differs from rmul by sigma argument order: distinct imaginary units
// anticommute (sigma(a,b) = -sigma(b,a)), but terms touching index 0 do not
// flip — so left-mult can break the total-parity invariant that forces
// right-mult bipartiteness.
fn lmul_into(inp: &[f64; 16], idx: i64, out: &![f64; 16]) with Mut, Panic {
    let lo = PRIM_LO[idx as usize]
    let hi = PRIM_HI[idx as usize]
    let s = if PRIM_NEG[idx as usize] == 1 { 0.0 - 1.0 } else { 1.0 }
    var k = 0
    while k < 16 {
        let klo = k ^ lo
        let khi = k ^ hi
        let t1 = (*inp)[klo as usize] * (cd_sigma_ct(lo, klo, 4) as f64)
        let t2 = (*inp)[khi as usize] * (cd_sigma_ct(hi, khi, 4) as f64)
        (*out)[k as usize] = t1 + s * t2
        k = k + 1
    }
}

// ============================================================================
// §3b. ZD pairs + ASSOCIATOR surgery (the non-associative lever → 168 classes)
//
//   A ZD class is an unordered pair (u, v) of primitives with u·v == 0.
//   Since u·v = 0, the associator assoc(p,u,v) = (p·u)·v − p·(u·v) = (p·u)·v.
//   So the associator-twisted point is exactly the double right-multiplication
//   (p·u)·v — computed by applying rmul_into twice. This is GENUINE
//   non-associativity, indexed by the full 168 ZD classes (not 84 linear maps).
//   Twisted "unit" target = ||u||²·||v||² = 2·2 = 4.
// ============================================================================

// Coefficient k of the primitive product (e_lou ± e_hiu)·(e_lov ± e_hiv).
// Mirrors `primProd` in SounioZeroDivisorBridge.lean (four cross terms).
fn prim_prod_coeff(iu: i64, iv: i64, k: i64) -> i64 {
    let lou = PRIM_LO[iu as usize]; let hiu = PRIM_HI[iu as usize]
    let lov = PRIM_LO[iv as usize]; let hiv = PRIM_HI[iv as usize]
    let su = if PRIM_NEG[iu as usize] == 1 { 0 - 1 } else { 1 }
    let sv = if PRIM_NEG[iv as usize] == 1 { 0 - 1 } else { 1 }
    var acc = 0
    if (lou ^ lov) == k { acc = acc + cd_sigma_ct(lou, lov, 4) }
    if (lou ^ hiv) == k { acc = acc + sv * cd_sigma_ct(lou, hiv, 4) }
    if (hiu ^ lov) == k { acc = acc + su * cd_sigma_ct(hiu, lov, 4) }
    if (hiu ^ hiv) == k { acc = acc + su * sv * cd_sigma_ct(hiu, hiv, 4) }
    return acc
}

fn is_zero_pair(iu: i64, iv: i64) -> i64 {
    var k = 0
    while k < 16 { if prim_prod_coeff(iu, iv, k) != 0 { return 0 }; k = k + 1 }
    return 1
}

// Enumerate the 168 unordered ZD pairs (i < j in primitive order = lexicographic,
// and u·v == 0; the ZD relation is symmetric since 336 ordered = 2·168).
pub fn build_zd_pairs() with Mut, Panic {
    NPAIR = 0
    var i = 0
    while i < NPRIM {
        var j = i + 1
        while j < NPRIM {
            if is_zero_pair(i, j) == 1 {
                PAIR_U[NPAIR as usize] = i
                PAIR_V[NPAIR as usize] = j
                NPAIR = NPAIR + 1
            }
            j = j + 1
        }
        i = i + 1
    }
}

// ||u||²·||v||² = 4 for ZD-pair primitives; associator twisted "unit" target.
fn assoc_norm_sq() -> f64 { return 4.0 }

// ============================================================================
// §4. Conflict graphs + exact chromatic number (brute force; n <= 7)
// ============================================================================

fn clear_adj() with Mut {
    var i = 0
    while i < 49 { ADJ[i as usize] = 0; i = i + 1 }
}

// Classical: edge iff squared Euclidean distance == 1.
fn build_classical_adj() with Mut, Panic {
    clear_adj()
    var i = 0
    while i < NPTS {
        var j = i + 1
        while j < NPTS {
            point_diff(i, j)
            let d = norm_sq(&DIFF)
            if near(d, 1.0, 1.0e-9) == 1 {
                ADJ[(i*7 + j) as usize] = 1
                ADJ[(j*7 + i) as usize] = 1
            }
            j = j + 1
        }
        i = i + 1
    }
}

// Twisted by primitive idx: edge iff ||(p_i - p_j)·v||^2 == ||v||^2 (== 2).
fn build_twisted_adj(idx: i64) with Mut, Panic {
    clear_adj()
    let target = prim_norm_sq()
    var i = 0
    while i < NPTS {
        var j = i + 1
        while j < NPTS {
            point_diff(i, j)
            rmul_prim(idx)
            let d = norm_sq(&TW)
            if near(d, target, 1.0e-9) == 1 {
                ADJ[(i*7 + j) as usize] = 1
                ADJ[(j*7 + i) as usize] = 1
            }
            j = j + 1
        }
        i = i + 1
    }
}

// Associator-twisted by ZD pair `pair_idx`: edge iff ||((p_i-p_j)·u)·v||^2 == 4.
fn build_assoc_adj(pair_idx: i64) with Mut, Panic {
    clear_adj()
    let u = PAIR_U[pair_idx as usize]
    let v = PAIR_V[pair_idx as usize]
    let target = assoc_norm_sq()
    var i = 0
    while i < NPTS {
        var j = i + 1
        while j < NPTS {
            point_diff(i, j)
            rmul_into(&DIFF, u, &!TMP)   // (p_i - p_j) · u
            rmul_into(&TMP, v, &!TW2)    // ((p_i - p_j) · u) · v   = assoc(diff, u, v)
            let d = norm_sq(&TW2)
            if near(d, target, 1.0e-9) == 1 {
                ADJ[(i*7 + j) as usize] = 1
                ADJ[(j*7 + i) as usize] = 1
            }
            j = j + 1
        }
        i = i + 1
    }
}

// Is the current ADJ graph (n vertices) properly k-colorable? Brute force.
fn colorable(n: i64, k: i64) -> i64 with Mut, Panic {
    var i = 0
    while i < n { COLORS[i as usize] = 0; i = i + 1 }
    var done = 0
    while done == 0 {
        // check current assignment
        var ok = 1
        var a = 0
        while a < n {
            var b = a + 1
            while b < n {
                if ADJ[(a*7 + b) as usize] == 1 {
                    if COLORS[a as usize] == COLORS[b as usize] { ok = 0 }
                }
                b = b + 1
            }
            a = a + 1
        }
        if ok == 1 { return 1 }
        // odometer increment (base k, n digits)
        var pos = 0
        var carry = 1
        while pos < n && carry == 1 {
            COLORS[pos as usize] = COLORS[pos as usize] + 1
            if COLORS[pos as usize] >= k {
                COLORS[pos as usize] = 0
                pos = pos + 1
            } else {
                carry = 0
            }
        }
        if carry == 1 { done = 1 }
    }
    return 0
}

pub fn chromatic_number(n: i64) -> i64 with Mut, Panic {
    var k = 1
    while k <= n {
        if colorable(n, k) == 1 { return k }
        k = k + 1
    }
    return n
}

// Count current-ADJ edges (upper triangle).
fn count_edges() -> i64 {
    var c = 0
    var i = 0
    while i < NPTS {
        var j = i + 1
        while j < NPTS {
            if ADJ[(i*7 + j) as usize] == 1 { c = c + 1 }
            j = j + 1
        }
        i = i + 1
    }
    return c
}

// ============================================================================
// §5. Spot-check: known ZD pair (e3+e10)·(e6-e15) == 0  (sed_zd_z * sed_zd_w)
// ============================================================================

pub fn zd_pair_self_check() -> i64 with Mut, Panic {
    // u = e3 + e10 ; w = e6 - e15.  (u·w)_k summed over the four cross terms.
    var ok = 1
    var k = 0
    while k < 16 {
        var acc = 0
        if (3 ^ 6) == k  { acc = acc + cd_sigma_ct(3, 6, 4) }    // e3 · e6
        if (3 ^ 15) == k { acc = acc - cd_sigma_ct(3, 15, 4) }   // e3 · (-e15)
        if (10 ^ 6) == k { acc = acc + cd_sigma_ct(10, 6, 4) }   // e10 · e6
        if (10 ^ 15) == k { acc = acc - cd_sigma_ct(10, 15, 4) } // e10 · (-e15)
        if acc != 0 { ok = 0 }
        k = k + 1
    }
    return ok
}

// ============================================================================
// §6. The 84-surgery chromatic spectrum + honest report
// ============================================================================

// Full demo: classical chi, then chi spectrum over all 84 ZD surgeries.
// Prints reproducible integers. Returns number of surgeries that raise chi
// above the classical (bipartite-breaking) value.
pub fn erdos_run_demo() -> i64 with IO, Mut, Panic, Div {
    build_prims()
    init_probe()

    print("=== Erdos #508/#704 — ZD-surgery chromatic probe (7 vertices, 16D) ===\n")
    print("valid primitives (validPrims, must be 84): "); print_int(NPRIM); print("\n")
    print("known ZD pair (e3+e10)(e6-e15)==0 self-check: "); print_int(zd_pair_self_check()); print("\n")

    build_classical_adj()
    let classical_edges = count_edges()
    // save classical adjacency for per-surgery edge diffing
    var ci = 0
    while ci < 49 { CLASSIC[ci as usize] = ADJ[ci as usize]; ci = ci + 1 }
    let chi0 = chromatic_number(NPTS)
    print("classical: edges="); print_int(classical_edges)
    print("  chromatic_number="); print_int(chi0)
    print("  (integer dist^2==1 => bipartite, expect <= 2)\n")

    var chi_min = NPTS + 1
    var chi_max = 0
    var n_raise = 0       // surgeries with chi > classical
    var n_change = 0      // surgeries with chi != classical
    var edges_min = 99
    var edges_max = 0
    var n_edge_change = 0 // surgeries whose edge set differs from classical
    var idx = 0
    while idx < NPRIM {
        build_twisted_adj(idx)
        let chi = chromatic_number(NPTS)
        let e = count_edges()
        // edge diff vs classical (upper triangle)
        var lost = 0; var gained = 0
        var a = 0
        while a < NPTS {
            var b = a + 1
            while b < NPTS {
                let cl = CLASSIC[(a*7 + b) as usize]
                let tw = ADJ[(a*7 + b) as usize]
                if cl == 1 && tw == 0 { lost = lost + 1 }
                if cl == 0 && tw == 1 { gained = gained + 1 }
                b = b + 1
            }
            a = a + 1
        }
        if e < edges_min { edges_min = e }
        if e > edges_max { edges_max = e }
        if lost > 0 || gained > 0 { n_edge_change = n_edge_change + 1 }
        if chi < chi_min { chi_min = chi }
        if chi > chi_max { chi_max = chi }
        if chi != chi0 { n_change = n_change + 1 }
        if chi > chi0 { n_raise = n_raise + 1 }
        idx = idx + 1
    }

    print("twisted spectrum over "); print_int(NPRIM); print(" ZD surgeries:\n")
    print("  edges_min="); print_int(edges_min)
    print("  edges_max="); print_int(edges_max)
    print("  surgeries changing edge set: "); print_int(n_edge_change); print("\n")
    print("  chi_min="); print_int(chi_min)
    print("  chi_max="); print_int(chi_max); print("\n")
    print("  surgeries changing chi: "); print_int(n_change); print("\n")
    print("  surgeries raising chi (breaking bipartite): "); print_int(n_raise); print("\n")
    print("algebraic invariant from bridge: 84 surgery maps acting through ")
    print("168 unordered ZD-pair classes (7 fibers x 24)\n")
    return n_raise
}

// ============================================================================
// §7. ASSOCIATOR surgery spectrum over the 168 ZD classes + honest report.
// ============================================================================

// Returns number of associator surgeries that raise chi above the classical χ.
pub fn erdos_run_assoc_demo() -> i64 with IO, Mut, Panic, Div {
    build_prims()
    build_zd_pairs()
    init_probe()

    print("=== Erdos #508/#704 — ASSOCIATOR surgery (p.u).v over 168 ZD classes ===\n")
    print("ZD pairs enumerated (unorderedZDPairs, must be 168): "); print_int(NPAIR); print("\n")

    build_classical_adj()
    let classical_edges = count_edges()
    var ci = 0
    while ci < 49 { CLASSIC[ci as usize] = ADJ[ci as usize]; ci = ci + 1 }
    let chi0 = chromatic_number(NPTS)
    print("classical: edges="); print_int(classical_edges)
    print("  chromatic_number="); print_int(chi0); print("\n")

    var chi_min = NPTS + 1
    var chi_max = 0
    var n_raise = 0
    var n_change = 0
    var edges_min = 99
    var edges_max = 0
    var n_edge_change = 0
    var p = 0
    while p < NPAIR {
        build_assoc_adj(p)
        let chi = chromatic_number(NPTS)
        let e = count_edges()
        var lost = 0; var gained = 0
        var a = 0
        while a < NPTS {
            var b = a + 1
            while b < NPTS {
                let cl = CLASSIC[(a*7 + b) as usize]
                let tw = ADJ[(a*7 + b) as usize]
                if cl == 1 && tw == 0 { lost = lost + 1 }
                if cl == 0 && tw == 1 { gained = gained + 1 }
                b = b + 1
            }
            a = a + 1
        }
        if e < edges_min { edges_min = e }
        if e > edges_max { edges_max = e }
        if lost > 0 || gained > 0 { n_edge_change = n_edge_change + 1 }
        if chi < chi_min { chi_min = chi }
        if chi > chi_max { chi_max = chi }
        if chi != chi0 { n_change = n_change + 1 }
        if chi > chi0 { n_raise = n_raise + 1 }
        p = p + 1
    }

    print("associator spectrum over "); print_int(NPAIR); print(" ZD-pair classes:\n")
    print("  edges_min="); print_int(edges_min)
    print("  edges_max="); print_int(edges_max)
    print("  classes changing edge set: "); print_int(n_edge_change); print("\n")
    print("  chi_min="); print_int(chi_min)
    print("  chi_max="); print_int(chi_max); print("\n")
    print("  classes changing chi: "); print_int(n_change); print("\n")
    print("  classes raising chi (breaking bipartite): "); print_int(n_raise); print("\n")
    return n_raise
}

// Note: empirical value distribution of ||((e_m)·u)·v||^2 over the 16 unit
// basis directions (first ZD pair) is {0: 6, 4: 8, 8: 2} — clean clusters at
// 0 (kernel), 4 (twisted-unit target used above), 8 (amplified). No value-2
// cluster, so the == 4 target is well-defined and captures the surviving
// unit-distance directions.

// ============================================================================
// §8. SCALE (slice 3): does ANY surgery produce a NON-bipartite twisted graph
//     (χ ≥ 3) on a larger integer probe? Verified empirically that the assoc
//     value histogram {0:6, 4:8, 8:2} is identical across all 168 pairs (the
//     classes are PSL(2,7)-symmetric), so the ==4 target is universal.
//
//     Probe = the COMPLETE set of weight-≤2 binary 16D vectors (1 + 16 + 120 =
//     137 points) — exhaustive over a natural bounded family, not cherry-picked.
//     Twisted graph built directly (no lifting), bipartiteness via BFS (O(V+E),
//     scales; the k^n brute force does not). χ≥3 ⟺ an odd cycle exists.
// ============================================================================

// Sized for both probes: binary weight-≤2 (137 pts) and signed weight-≤2
// ({0} ∪ {±e_i} ∪ {e_i+e_j} ∪ {e_i−e_j} = 1+32+120+120 = 273 pts).
var BIGPROBE: [f64; 4800] = [0.0; 4800]   // up to 300 * 16
var BIGN:     i64 = 0
var BADJ:     [i64; 90000] = [0; 90000]   // up to 300 * 300 adjacency
var BCOLOR:   [i64; 300] = [0; 300]       // 2 = unvisited, else 0/1
var BQUEUE:   [i64; 300] = [0; 300]

pub fn build_big_probe() with Mut {
    var i = 0
    while i < 2192 { BIGPROBE[i as usize] = 0.0; i = i + 1 }
    BIGN = 1                                  // point 0 = zero vector
    var a = 0
    while a < 16 {                            // weight-1
        BIGPROBE[(BIGN*16 + a) as usize] = 1.0
        BIGN = BIGN + 1
        a = a + 1
    }
    a = 0
    while a < 16 {                            // weight-2
        var b = a + 1
        while b < 16 {
            BIGPROBE[(BIGN*16 + a) as usize] = 1.0
            BIGPROBE[(BIGN*16 + b) as usize] = 1.0
            BIGN = BIGN + 1
            b = b + 1
        }
        a = a + 1
    }
}

// Signed weight-≤2 family: {0} ∪ {±e_i} ∪ {e_i+e_j} ∪ {e_i−e_j} = 273 points.
pub fn build_big_probe_signed() with Mut {
    var i = 0
    while i < 4800 { BIGPROBE[i as usize] = 0.0; i = i + 1 }
    BIGN = 1                                  // point 0 = zero vector
    var a = 0
    while a < 16 {                            // ±e_i
        BIGPROBE[(BIGN*16 + a) as usize] = 1.0;  BIGN = BIGN + 1
        BIGPROBE[(BIGN*16 + a) as usize] = 0.0 - 1.0;  BIGN = BIGN + 1
        a = a + 1
    }
    a = 0
    while a < 16 {                            // e_i + e_j and e_i − e_j
        var b = a + 1
        while b < 16 {
            BIGPROBE[(BIGN*16 + a) as usize] = 1.0; BIGPROBE[(BIGN*16 + b) as usize] = 1.0
            BIGN = BIGN + 1
            BIGPROBE[(BIGN*16 + a) as usize] = 1.0; BIGPROBE[(BIGN*16 + b) as usize] = 0.0 - 1.0
            BIGN = BIGN + 1
            b = b + 1
        }
        a = a + 1
    }
}

fn big_point_diff(i: i64, j: i64) with Mut {
    var k = 0
    while k < 16 {
        DIFF[k as usize] = BIGPROBE[(i*16 + k) as usize] - BIGPROBE[(j*16 + k) as usize]
        k = k + 1
    }
}

fn clear_badj() with Mut {
    var i = 0
    let n2 = BIGN * BIGN
    while i < n2 { BADJ[i as usize] = 0; i = i + 1 }
}

// Linear twisted graph on the big probe for primitive idx: edge iff ||d·v||²==2.
fn build_big_linear_adj(idx: i64) with Mut, Panic {
    clear_badj()
    var i = 0
    while i < BIGN {
        var j = i + 1
        while j < BIGN {
            big_point_diff(i, j)
            rmul_into(&DIFF, idx, &!TW)
            if near(norm_sq(&TW), 2.0, 1.0e-9) == 1 {
                BADJ[(i*BIGN + j) as usize] = 1
                BADJ[(j*BIGN + i) as usize] = 1
            }
            j = j + 1
        }
        i = i + 1
    }
}

// LEFT-multiplication twisted graph on the big probe: edge iff ||v·d||²==2.
fn build_big_left_adj(idx: i64) with Mut, Panic {
    clear_badj()
    var i = 0
    while i < BIGN {
        var j = i + 1
        while j < BIGN {
            big_point_diff(i, j)
            lmul_into(&DIFF, idx, &!TW)
            if near(norm_sq(&TW), 2.0, 1.0e-9) == 1 {
                BADJ[(i*BIGN + j) as usize] = 1
                BADJ[(j*BIGN + i) as usize] = 1
            }
            j = j + 1
        }
        i = i + 1
    }
}

// Associator twisted graph on the big probe for ZD pair p: edge iff ||(d·u)·v||²==4.
fn build_big_assoc_adj(pair_idx: i64) with Mut, Panic {
    clear_badj()
    let u = PAIR_U[pair_idx as usize]
    let v = PAIR_V[pair_idx as usize]
    var i = 0
    while i < BIGN {
        var j = i + 1
        while j < BIGN {
            big_point_diff(i, j)
            rmul_into(&DIFF, u, &!TMP)
            rmul_into(&TMP, v, &!TW2)
            if near(norm_sq(&TW2), 4.0, 1.0e-9) == 1 {
                BADJ[(i*BIGN + j) as usize] = 1
                BADJ[(j*BIGN + i) as usize] = 1
            }
            j = j + 1
        }
        i = i + 1
    }
}

// BFS 2-coloring of BADJ. Returns 1 if bipartite (χ ≤ 2), 0 if an odd cycle
// exists (χ ≥ 3). O(V + E), scales to the full 137-vertex graph.
fn bfs_bipartite() -> i64 with Mut, Panic {
    var i = 0
    while i < BIGN { BCOLOR[i as usize] = 2; i = i + 1 }
    var comp = 0
    while comp < BIGN {
        if BCOLOR[comp as usize] == 2 {
            BCOLOR[comp as usize] = 0
            var head = 0
            var tail = 0
            BQUEUE[tail as usize] = comp; tail = tail + 1
            while head < tail {
                let cur = BQUEUE[head as usize]; head = head + 1
                var w = 0
                while w < BIGN {
                    if BADJ[(cur*BIGN + w) as usize] == 1 {
                        if BCOLOR[w as usize] == 2 {
                            BCOLOR[w as usize] = 1 - BCOLOR[cur as usize]
                            BQUEUE[tail as usize] = w; tail = tail + 1
                        } else {
                            if BCOLOR[w as usize] == BCOLOR[cur as usize] { return 0 }
                        }
                    }
                    w = w + 1
                }
            }
        }
        comp = comp + 1
    }
    return 1
}

// Count edges in current BADJ (upper triangle).
fn badj_edges() -> i64 {
    var c = 0
    var i = 0
    while i < BIGN {
        var j = i + 1
        while j < BIGN { if BADJ[(i*BIGN + j) as usize] == 1 { c = c + 1 }; j = j + 1 }
        i = i + 1
    }
    return c
}

// Scan all 84 linear + 168 associator surgeries on the 137-point probe.
// Returns total number of surgeries whose twisted graph is NON-bipartite (χ≥3).
pub fn erdos_run_scale_search() -> i64 with IO, Mut, Panic, Div {
    build_prims()
    build_zd_pairs()

    print("=== Erdos #508/#704 — SCALE search for chi>=3 (odd cycle, BFS) ===\n")
    print("[binary weight-<=2 family, complete (expect 137)]\n")
    build_big_probe()
    let nb_bin = scan_current_probe()
    print("[signed weight-<=2 family, complete (expect 273)]\n")
    build_big_probe_signed()
    let nb_sgn = scan_current_probe()

    let total = nb_bin + nb_sgn
    print("TOTAL surgeries producing chi>=3 (non-bipartite) across both probes: ")
    print_int(total); print("\n")
    return total
}

// Parity of nonzero coords of probe point `pt` in index range [a,b).
fn range_parity(pt: i64, a: i64, b: i64) -> i64 {
    var s = 0; var k = a
    while k < b { if BIGPROBE[(pt*16 + k) as usize] != 0.0 { s = s + 1 }; k = k + 1 }
    return s - (s / 2) * 2
}

// Does coloring-by-(total coord-count parity) properly 2-color current BADJ?
fn total_parity_2colors() -> i64 {
    var i = 0
    while i < BIGN {
        var j = i + 1
        while j < BIGN {
            if BADJ[(i*BIGN + j) as usize] == 1 {
                if range_parity(i,0,16) == range_parity(j,0,16) { return 0 }
            }
            j = j + 1
        }
        i = i + 1
    }
    return 1
}

// Scan both surgery families on the CURRENT big probe; returns # non-bipartite.
// Also reports how many LINEAR graphs are 2-colored by total coord-sum parity.
fn scan_current_probe() -> i64 with IO, Mut, Panic, Div {
    print("  BIGN="); print_int(BIGN); print(":\n")
    var lin_nb = 0; var lin_totalpar = 0; var le_min = 1000000; var le_max = 0
    var idx = 0
    while idx < NPRIM {
        build_big_linear_adj(idx)
        let e = badj_edges()
        if e < le_min { le_min = e }
        if e > le_max { le_max = e }
        if bfs_bipartite() == 0 { lin_nb = lin_nb + 1 }
        if total_parity_2colors() == 1 { lin_totalpar = lin_totalpar + 1 }
        idx = idx + 1
    }
    print("  linear(84):  edges["); print_int(le_min); print(".."); print_int(le_max)
    print("] non-bip="); print_int(lin_nb)
    print(" total-parity-2colors="); print_int(lin_totalpar); print("/84\n")
    var as_nb = 0; var ae_min = 1000000; var ae_max = 0
    var p = 0
    while p < NPAIR {
        build_big_assoc_adj(p)
        let e = badj_edges()
        if e < ae_min { ae_min = e }
        if e > ae_max { ae_max = e }
        if bfs_bipartite() == 0 { as_nb = as_nb + 1 }
        p = p + 1
    }
    print("  assoc(168):  edges["); print_int(ae_min); print(".."); print_int(ae_max)
    print("] non-bip="); print_int(as_nb); print("\n")
    return lin_nb + as_nb
}

// ============================================================================
// §9. LEFT-multiplication search (slice 4): does v·d break the total-parity
//     invariant and produce a NON-bipartite twisted graph (χ ≥ 3)?
// ============================================================================

// Scan the 84 LEFT-mult surgeries on the current big probe.
// Reports non-bipartite count + how many are still 2-colored by total parity.
fn scan_left_current() -> i64 with IO, Mut, Panic, Div {
    print("  BIGN="); print_int(BIGN); print(":\n")
    var nb = 0; var tp = 0; var emin = 1000000; var emax = 0
    var idx = 0
    while idx < NPRIM {
        build_big_left_adj(idx)
        let e = badj_edges()
        if e < emin { emin = e }
        if e > emax { emax = e }
        if bfs_bipartite() == 0 { nb = nb + 1 }
        if total_parity_2colors() == 1 { tp = tp + 1 }
        idx = idx + 1
    }
    print("  left-mul(84): edges["); print_int(emin); print(".."); print_int(emax)
    print("] non-bip="); print_int(nb)
    print(" total-parity-2colors="); print_int(tp); print("/84\n")
    return nb
}

pub fn erdos_run_left_search() -> i64 with IO, Mut, Panic, Div {
    build_prims()
    print("=== Erdos #508/#704 — LEFT-multiplication search (slice 4) ===\n")
    print("[binary weight-<=2 family (137)]\n")
    build_big_probe()
    let nb_bin = scan_left_current()
    print("[signed weight-<=2 family (273)]\n")
    build_big_probe_signed()
    let nb_sgn = scan_left_current()
    let total = nb_bin + nb_sgn
    print("LEFT-mul surgeries producing chi>=3 (non-bipartite): "); print_int(total); print("\n")
    return total
}

// ============================================================================
// §10. NON-DISTANCE construction (slice 4b): associator conflict graph.
//
//   Distance-based surgery hit a two-sided total-parity ceiling. The associator
//   assoc(x,y,c) = (x·y)·c − x·(y·c) is BILINEAR in (x,y) — NOT a function of
//   x−y — so the associator conflict graph is not translation-invariant and
//   need not inherit the parity bipartition. Edge (i,j) ⟺ ‖assoc(p_i,p_j,c)‖²==T.
//   This is the genuinely non-associative, non-distance lever for χ ≥ 3.
// ============================================================================

var PX: [f64; 16] = [0.0; 16]
var PY: [f64; 16] = [0.0; 16]
var AP1: [f64; 16] = [0.0; 16]
var AP2: [f64; 16] = [0.0; 16]
var AA1: [f64; 16] = [0.0; 16]
var AA2: [f64; 16] = [0.0; 16]

// General sedenion product: out = x · y  (out_k = Σ_{a^b=k} x_a y_b σ(a,b)).
fn sed_prod_full(x: &[f64; 16], y: &[f64; 16], out: &![f64; 16]) with Mut, Panic {
    var k = 0
    while k < 16 { (*out)[k as usize] = 0.0; k = k + 1 }
    var a = 0
    while a < 16 {
        if (*x)[a as usize] != 0.0 {
            var b = 0
            while b < 16 {
                if (*y)[b as usize] != 0.0 {
                    let kk = a ^ b
                    (*out)[kk as usize] = (*out)[kk as usize]
                        + (*x)[a as usize] * (*y)[b as usize] * (cd_sigma_ct(a, b, 4) as f64)
                }
                b = b + 1
            }
        }
        a = a + 1
    }
}

fn load_point(idx: i64, out: &![f64; 16]) with Mut {
    var k = 0
    while k < 16 { (*out)[k as usize] = BIGPROBE[(idx*16 + k) as usize]; k = k + 1 }
}

// ‖assoc(p_i, p_j, c)‖²  where c is primitive cidx.
fn assoc_normsq(i: i64, j: i64, cidx: i64) -> f64 with Mut, Panic {
    load_point(i, &!PX)
    load_point(j, &!PY)
    sed_prod_full(&PX, &PY, &!AP1)        // x·y
    rmul_into(&AP1, cidx, &!AA1)          // (x·y)·c
    rmul_into(&PY, cidx, &!AP2)           // y·c
    sed_prod_full(&PX, &AP2, &!AA2)       // x·(y·c)
    var s = 0.0
    var k = 0
    while k < 16 { let d = AA1[k as usize] - AA2[k as usize]; s = s + d * d; k = k + 1 }
    return s
}

// Value distribution of ‖assoc(p_i,p_j,c)‖² over the 137-probe pairs (verified,
// stable across c): {0:~800, 4:~1240, 8:~1700, 16:~1500, larger:~4000} — NO
// value 2. Smallest nonzero is 4, giving a sparse (~13%) conflict graph; used as
// the twisted-unit target T=4 below.

// Associator conflict graph for primitive c: edge (i,j) iff
// ‖[p_i,p_j,c]‖²==4 OR ‖[p_j,p_i,c]‖²==4 (symmetrized; T=4 = smallest nonzero).
fn build_assoc_conflict_adj(cidx: i64) with Mut, Panic {
    clear_badj()
    var i = 0
    while i < BIGN {
        var j = i + 1
        while j < BIGN {
            let d1 = assoc_normsq(i, j, cidx)
            let d2 = assoc_normsq(j, i, cidx)
            if near(d1, 4.0, 1.0e-9) == 1 || near(d2, 4.0, 1.0e-9) == 1 {
                BADJ[(i*BIGN + j) as usize] = 1
                BADJ[(j*BIGN + i) as usize] = 1
            }
            j = j + 1
        }
        i = i + 1
    }
}

// Scan the associator conflict graph over all 84 primitives c on the binary
// weight-≤2 probe. Returns # of c giving a NON-bipartite graph (χ ≥ 3).
pub fn erdos_run_assoc_conflict_search() -> i64 with IO, Mut, Panic, Div {
    build_prims()
    build_big_probe()
    print("=== Erdos #508/#704 — ASSOCIATOR CONFLICT graph (non-distance) ===\n")
    print("edge iff ||[p_i,p_j,c]||^2 == 4; probe = binary weight-<=2 (137)\n")
    var nonbip = 0
    var first = 0 - 1
    var emin = 1000000; var emax = 0
    var tp = 0
    var c = 0
    while c < NPRIM {
        build_assoc_conflict_adj(c)
        let e = badj_edges()
        if e < emin { emin = e }
        if e > emax { emax = e }
        if total_parity_2colors() == 1 { tp = tp + 1 }
        if bfs_bipartite() == 0 { nonbip = nonbip + 1; if first < 0 { first = c } }
        c = c + 1
    }
    print("  edges["); print_int(emin); print(".."); print_int(emax); print("]")
    print("  total-parity-2colors="); print_int(tp); print("/84\n")
    print("  NON-bipartite (chi>=3) graphs: "); print_int(nonbip); print(" / 84")
    if first >= 0 { print("  (first at c="); print_int(first); print(")") }
    print("\n")
    return nonbip
}

// Report a concrete χ≥3 certificate: a triangle in the associator conflict
// graph at c=cidx, plus a greedy chromatic upper bound. For c=0 this finds the
// triangle {e_1,e_2,e_3} (probe indices 2,3,4) and greedy χ ≈ 10 (so χ ∈ [3,10]).
var GCOLOR: [i64; 300] = [0; 300]
pub fn assoc_conflict_witness(cidx: i64) -> i64 with IO, Mut, Panic, Div {
    build_prims(); build_big_probe()
    build_assoc_conflict_adj(cidx)
    // find one triangle (i<j<k mutually adjacent)
    var ti = 0 - 1; var tj = 0 - 1; var tk = 0 - 1
    var i = 0
    while i < BIGN && ti < 0 {
        var j = i + 1
        while j < BIGN && ti < 0 {
            if BADJ[(i*BIGN + j) as usize] == 1 {
                var k = j + 1
                while k < BIGN && ti < 0 {
                    if BADJ[(i*BIGN + k) as usize] == 1 && BADJ[(j*BIGN + k) as usize] == 1 {
                        ti = i; tj = j; tk = k
                    }
                    k = k + 1
                }
            }
            j = j + 1
        }
        i = i + 1
    }
    if ti >= 0 { print("triangle witness (chi>=3): "); print_int(ti); print(","); print_int(tj); print(","); print_int(tk); print("\n") }
    else { print("no triangle found (odd cycle longer)\n") }
    // greedy chromatic upper bound (natural vertex order)
    var v = 0
    while v < BIGN { GCOLOR[v as usize] = 0 - 1; v = v + 1 }
    var maxc = 0
    v = 0
    while v < BIGN {
        // smallest color not used by colored neighbors
        var col = 0
        var found = 0
        while found == 0 {
            var clash = 0
            var w = 0
            while w < BIGN {
                if BADJ[(v*BIGN + w) as usize] == 1 && GCOLOR[w as usize] == col { clash = 1 }
                w = w + 1
            }
            if clash == 0 { found = 1 } else { col = col + 1 }
        }
        GCOLOR[v as usize] = col
        if col + 1 > maxc { maxc = col + 1 }
        v = v + 1
    }
    print("greedy chromatic upper bound: "); print_int(maxc); print("\n")
    return maxc
}

pub fn erdos_unit_distance_module_ready() -> i32 { 1 }
