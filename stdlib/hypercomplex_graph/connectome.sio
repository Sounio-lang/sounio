// hypercomplex_graph::connectome — Connectome to Octonion-Labeled Graph
//
// Converts adjacency matrices (from matrix_reader) into octonion-labeled
// graphs (from oct_graph) for associator field analysis.
//
// The key bridge for Paper 4: real brain connectivity data → algebraic
// structure (octonion labels) → geometric invariant (associator field).
//
// Labeling strategy:
//   Each edge (u,v) in the connectome receives an octonion label based on
//   two principles:
//   1. The MAGNITUDE is the edge weight (functional connectivity strength)
//   2. The DIRECTION (which octonion basis element) encodes topology:
//      - Use the 7 imaginary basis elements cyclically: e_((u+v) mod 7 + 1)
//      - This ensures different edges get different algebraic "colors"
//      - The non-associativity of these labels reveals structural patterns
//
// For subgraph analysis (OctGraph is max 32 nodes), we extract
// communities/ROI clusters from the full 200-node connectome and
// build OctGraphs per community.
//
// References:
//   - Baez 2002, "The Octonions"
//   - Sporns 2011, "Networks of the Brain" (community structure)

// ============================================================================
// MATH HELPERS (inlined per Sounio convention)
// ============================================================================

fn cn_abs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

fn cn_sqrt(x: f64) -> f64 with Mut, Panic, Div {
    if x <= 0.0 { return 0.0 }
    var r = x
    var i = 0
    while i < 20 { r = 0.5 * (r + x / r); i = i + 1 }
    r
}

// ============================================================================
// OCTONION (inlined — cannot import across modules in JIT)
// ============================================================================

struct Oct {
    e: [f64; 8]
}

fn oct_zero() -> Oct { Oct { e: [0.0; 8] } }

fn oct_unit(idx: i64) -> Oct with Mut, Panic {
    var o = Oct { e: [0.0; 8] }
    if idx >= 0 && idx < 8 { o.e[idx as usize] = 1.0 }
    o
}

fn oct_scale(o: Oct, s: f64) -> Oct with Mut, Panic, Div {
    var r = oct_zero()
    var i: i64 = 0
    while i < 8 { r.e[i as usize] = o.e[i as usize] * s; i = i + 1 }
    r
}

fn oct_sub(a: Oct, b: Oct) -> Oct with Mut, Panic, Div {
    var r = oct_zero()
    var i: i64 = 0
    while i < 8 { r.e[i as usize] = a.e[i as usize] - b.e[i as usize]; i = i + 1 }
    r
}

fn oct_conjugate(o: Oct) -> Oct with Mut, Panic, Div {
    var r = oct_zero()
    r.e[0] = o.e[0]
    var i: i64 = 1
    while i < 8 { r.e[i as usize] = 0.0 - o.e[i as usize]; i = i + 1 }
    r
}

fn oct_norm_sq(o: Oct) -> f64 with Mut, Panic, Div {
    var s: f64 = 0.0
    var i: i64 = 0
    while i < 8 { s = s + o.e[i as usize] * o.e[i as usize]; i = i + 1 }
    s
}

fn oct_norm(o: Oct) -> f64 with Mut, Panic, Div { cn_sqrt(oct_norm_sq(o)) }

fn oct_fano_index(i: i64, j: i64) -> i64 with Mut, Panic, Div {
    if i == j { return 0 }
    var t: [i64; 21] = [0; 21]
    t[0]=1;t[1]=2;t[2]=4; t[3]=2;t[4]=3;t[5]=5; t[6]=3;t[7]=4;t[8]=6
    t[9]=4;t[10]=5;t[11]=7; t[12]=5;t[13]=6;t[14]=1; t[15]=6;t[16]=7;t[17]=2
    t[18]=7;t[19]=1;t[20]=3
    var k: i64 = 0
    while k < 7 {
        let a=t[(k*3) as usize]; let b=t[(k*3+1) as usize]; let c=t[(k*3+2) as usize]
        if (i==a&&j==b)||(i==b&&j==c)||(i==c&&j==a) {
            if i==a&&j==b {return c}; if i==b&&j==c {return a}; return b
        }
        if (i==b&&j==a)||(i==c&&j==b)||(i==a&&j==c) {
            if i==b&&j==a {return c}; if i==c&&j==b {return a}; return b
        }
        k=k+1
    }
    0
}

fn oct_fano_sign(i: i64, j: i64) -> f64 with Mut, Panic, Div {
    if i==j {return -1.0}; if i==0||j==0 {return 1.0}
    var t: [i64; 21] = [0; 21]
    t[0]=1;t[1]=2;t[2]=4; t[3]=2;t[4]=3;t[5]=5; t[6]=3;t[7]=4;t[8]=6
    t[9]=4;t[10]=5;t[11]=7; t[12]=5;t[13]=6;t[14]=1; t[15]=6;t[16]=7;t[17]=2
    t[18]=7;t[19]=1;t[20]=3
    var k: i64 = 0
    while k < 7 {
        let a=t[(k*3) as usize]; let b=t[(k*3+1) as usize]; let c=t[(k*3+2) as usize]
        if (i==a&&j==b)||(i==b&&j==c)||(i==c&&j==a) {return 1.0}
        if (i==b&&j==a)||(i==c&&j==b)||(i==a&&j==c) {return -1.0}
        k=k+1
    }
    0.0
}

fn oct_mul(a: Oct, b: Oct) -> Oct with Mut, Panic, Div {
    var result = oct_zero()
    var i: i64 = 0
    while i < 8 {
        var j: i64 = 0
        while j < 8 {
            let coeff = a.e[i as usize] * b.e[j as usize]
            if i==0&&j==0 { result.e[0] = result.e[0] + coeff }
            else if i==0 { result.e[j as usize] = result.e[j as usize] + coeff }
            else if j==0 { result.e[i as usize] = result.e[i as usize] + coeff }
            else if i==j { result.e[0] = result.e[0] - coeff }
            else {
                let k = oct_fano_index(i, j)
                let sign = oct_fano_sign(i, j)
                result.e[k as usize] = result.e[k as usize] + sign * coeff
            }
            j=j+1
        }
        i=i+1
    }
    result
}

fn oct_associator(a: Oct, b: Oct, c: Oct) -> Oct with Mut, Panic, Div {
    let ab = oct_mul(a, b)
    let bc = oct_mul(b, c)
    oct_sub(oct_mul(ab, c), oct_mul(a, bc))
}

// ============================================================================
// OCTGRAPH (inlined, max 32 nodes for subgraph analysis)
// ============================================================================

struct OctGraph {
    n: i32
    adj: [i32; 1024]       // 32x32
    lab0: [f64; 1024]
    lab1: [f64; 1024]
    lab2: [f64; 1024]
    lab3: [f64; 1024]
    lab4: [f64; 1024]
    lab5: [f64; 1024]
    lab6: [f64; 1024]
    lab7: [f64; 1024]
}

fn og_new(n: i32) -> OctGraph {
    OctGraph {
        n: n, adj: [0; 1024],
        lab0: [0.0; 1024], lab1: [0.0; 1024], lab2: [0.0; 1024], lab3: [0.0; 1024],
        lab4: [0.0; 1024], lab5: [0.0; 1024], lab6: [0.0; 1024], lab7: [0.0; 1024],
    }
}

fn og_idx(u: i32, v: i32) -> i32 { u * 32 + v }

fn og_set_edge(g: OctGraph, u: i32, v: i32, label: Oct) -> OctGraph with Mut, Panic, Div {
    var r = g
    let idx = og_idx(u, v) as usize
    r.adj[idx] = 1
    r.lab0[idx]=label.e[0]; r.lab1[idx]=label.e[1]; r.lab2[idx]=label.e[2]; r.lab3[idx]=label.e[3]
    r.lab4[idx]=label.e[4]; r.lab5[idx]=label.e[5]; r.lab6[idx]=label.e[6]; r.lab7[idx]=label.e[7]
    r
}

fn og_add_undir(g: OctGraph, u: i32, v: i32, label: Oct) -> OctGraph with Mut, Panic, Div {
    var r = og_set_edge(g, u, v, label)
    r = og_set_edge(r, v, u, oct_conjugate(label))
    r
}

fn og_get_label(g: OctGraph, u: i32, v: i32) -> Oct with Mut, Panic {
    let idx = og_idx(u, v) as usize
    var o = Oct { e: [0.0; 8] }
    o.e[0]=g.lab0[idx]; o.e[1]=g.lab1[idx]; o.e[2]=g.lab2[idx]; o.e[3]=g.lab3[idx]
    o.e[4]=g.lab4[idx]; o.e[5]=g.lab5[idx]; o.e[6]=g.lab6[idx]; o.e[7]=g.lab7[idx]
    o
}

fn og_degree(g: OctGraph, v: i32) -> i32 with Mut, Panic, Div {
    var d: i32 = 0
    var i: i32 = 0
    while i < g.n {
        if g.adj[og_idx(v, i) as usize] == 1 { d = d + 1 }
        i = i + 1
    }
    d
}

// ============================================================================
// LABELING STRATEGIES
// ============================================================================
//
// Strategy 1: Cyclic basis labeling
//   edge (u,v) → w * e_{(u+v) mod 7 + 1}
//   where w = edge weight (connectivity strength)
//   This deterministically distributes all 7 imaginary basis elements.
//
// Strategy 2: Weight-to-magnitude labeling
//   edge (u,v) → oct with ||oct|| = weight, direction from topology hash
//
// Strategy 3: Degree-dependent labeling
//   edge (u,v) → direction depends on (deg(u), deg(v)) mod 7
//   This encodes hub structure into the algebraic labels.

// Cyclic basis label: weight * e_{(u+v) mod 7 + 1}
pub fn label_cyclic(u: i64, v: i64, weight: f64) -> Oct with Mut, Panic, Div {
    let basis = (u + v) % 7 + 1
    oct_scale(oct_unit(basis), weight)
}

// Degree-dependent label: weight * e_{(deg_u + deg_v) mod 7 + 1}
pub fn label_degree(deg_u: i64, deg_v: i64, weight: f64) -> Oct with Mut, Panic, Div {
    let basis = (deg_u + deg_v) % 7 + 1
    oct_scale(oct_unit(basis), weight)
}

// Mixed label: combines node indices and weight for richer algebra
// Real part = weight, imaginary part from cyclic basis
pub fn label_mixed(u: i64, v: i64, weight: f64) -> Oct with Mut, Panic, Div {
    let basis = (u + v) % 7 + 1
    var o = oct_unit(basis)
    o.e[0] = weight    // real part = connectivity strength
    // Normalize to preserve weight as magnitude
    let n = oct_norm(o)
    if n > 1e-12 {
        oct_scale(o, weight / n)
    } else {
        o
    }
}

// ============================================================================
// MATRIX → OCTGRAPH CONVERSION
// ============================================================================
//
// Convert a subgraph of the full adjacency matrix to an OctGraph.
// Since OctGraph is limited to 32 nodes, we take a subset of nodes
// (e.g., a community or ROI cluster).

// Convert a subgraph of nodes [node_list[0..n_nodes]] from the full matrix
// to an OctGraph with cyclic basis labeling.
//   matrix_data: flattened 200x200 adjacency matrix
//   matrix_n:    dimension of the matrix (max 200)
//   node_list:   indices of nodes to include (max 32)
//   n_nodes:     number of nodes in node_list
//   threshold:   edge weight threshold
pub fn matrix_to_octgraph(
    matrix_data: [f64; 40000], matrix_n: i64,
    node_list: [i32; 32], n_nodes: i32,
    threshold: f64
) -> OctGraph with Mut, Panic, Div {
    var g = og_new(n_nodes)

    var i: i32 = 0
    while i < n_nodes {
        var j: i32 = i + 1
        while j < n_nodes {
            let orig_u = node_list[i as usize] as i64
            let orig_v = node_list[j as usize] as i64
            let w = matrix_data[(orig_u * matrix_n + orig_v) as usize]

            if w > threshold {
                let label = label_cyclic(orig_u, orig_v, w)
                g = og_add_undir(g, i, j, label)
            }
            j = j + 1
        }
        i = i + 1
    }
    g
}

// Convert first n nodes (n <= 32) of matrix directly to OctGraph
pub fn matrix_head_to_octgraph(
    matrix_data: [f64; 40000], matrix_n: i64,
    n_nodes: i32, threshold: f64
) -> OctGraph with Mut, Panic, Div {
    var nodes: [i32; 32] = [0; 32]
    var i: i32 = 0
    while i < n_nodes && i < 32 {
        nodes[i as usize] = i
        i = i + 1
    }
    matrix_to_octgraph(matrix_data, matrix_n, nodes, n_nodes, threshold)
}

// ============================================================================
// ASSOCIATOR FIELD ON CONNECTOME SUBGRAPH
// ============================================================================

pub struct ConnectomeAssocField {
    // Statistics over all length-3 paths
    count: i32
    mean_norm: f64
    max_norm: f64
    energy: f64              // sum of ||[a,b,c]||^2
    zero_count: i32          // associators near zero (alternativity channels)
    // Per-node associator density
    node_density: [f64; 32]  // mean associator norm for triples through each node
    node_triple_count: [i32; 32]
}

fn caf_empty() -> ConnectomeAssocField {
    ConnectomeAssocField {
        count: 0, mean_norm: 0.0, max_norm: 0.0, energy: 0.0, zero_count: 0,
        node_density: [0.0; 32], node_triple_count: [0; 32],
    }
}

// Compute associator field over the OctGraph
pub fn connectome_assoc_field(g: OctGraph) -> ConnectomeAssocField with Mut, Panic, Div {
    var field = caf_empty()
    var sum_norm: f64 = 0.0
    var max_n: f64 = 0.0

    var u: i32 = 0
    while u < g.n {
        var v: i32 = 0
        while v < g.n {
            if g.adj[og_idx(u, v) as usize] == 1 && u != v {
                var w: i32 = 0
                while w < g.n {
                    if g.adj[og_idx(v, w) as usize] == 1 && v != w && w != u {
                        var x: i32 = 0
                        while x < g.n {
                            if g.adj[og_idx(w, x) as usize] == 1 && w != x && x != v {
                                let a = og_get_label(g, u, v)
                                let b = og_get_label(g, v, w)
                                let c = og_get_label(g, w, x)
                                let assoc = oct_associator(a, b, c)
                                let n = oct_norm(assoc)

                                field.count = field.count + 1
                                sum_norm = sum_norm + n
                                field.energy = field.energy + n * n
                                if n > max_n { max_n = n }
                                if n < 1e-9 { field.zero_count = field.zero_count + 1 }

                                // Track per-node density (middle nodes v, w)
                                field.node_density[v as usize] = field.node_density[v as usize] + n
                                field.node_triple_count[v as usize] = field.node_triple_count[v as usize] + 1
                                field.node_density[w as usize] = field.node_density[w as usize] + n
                                field.node_triple_count[w as usize] = field.node_triple_count[w as usize] + 1
                            }
                            x = x + 1
                        }
                    }
                    w = w + 1
                }
            }
            v = v + 1
        }
        u = u + 1
    }

    if field.count > 0 {
        field.mean_norm = sum_norm / (field.count as f64)
    }
    field.max_norm = max_n

    // Normalize per-node density
    var i: i32 = 0
    while i < g.n {
        if field.node_triple_count[i as usize] > 0 {
            field.node_density[i as usize] = field.node_density[i as usize] / (field.node_triple_count[i as usize] as f64)
        }
        i = i + 1
    }
    field
}

// ============================================================================
// CONNECTOME COMPARISON — ASD vs TD associator fields
// ============================================================================

pub struct AssocComparison {
    mean_diff: f64          // mean_A - mean_B
    max_diff: f64           // max_A - max_B
    energy_diff: f64        // energy_A - energy_B
    zero_frac_a: f64        // fraction of zero associators in A
    zero_frac_b: f64        // fraction of zero associators in B
}

pub fn compare_assoc_fields(
    a: ConnectomeAssocField, b: ConnectomeAssocField
) -> AssocComparison with Div, Panic {
    let zf_a = if a.count > 0 { (a.zero_count as f64) / (a.count as f64) } else { 0.0 }
    let zf_b = if b.count > 0 { (b.zero_count as f64) / (b.count as f64) } else { 0.0 }

    AssocComparison {
        mean_diff: a.mean_norm - b.mean_norm,
        max_diff: a.max_norm - b.max_norm,
        energy_diff: a.energy - b.energy,
        zero_frac_a: zf_a,
        zero_frac_b: zf_b,
    }
}

// ============================================================================
// LAPLACIAN EIGENVECTOR EXTRACTION (for G₂ bridge)
// ============================================================================
//
// Extract the k smallest non-trivial eigenvectors of the graph Laplacian
// via deflated power iteration on the shifted matrix (λ_max·I - L).
//
// The Laplacian L = D - A has eigenvalues 0 = λ₁ ≤ λ₂ ≤ ... ≤ λₙ.
// The eigenvector for λ₁ is the constant vector (1/√n, ..., 1/√n).
// We want eigenvectors ψ₂, ..., ψ₈ (the 7 smallest non-trivial modes).
//
// Method:
//   1. Compute L and estimate λ_max via power iteration
//   2. Form M = λ_max·I - L (flips spectrum: largest eigenvalues of M
//      correspond to smallest non-zero eigenvalues of L)
//   3. Deflated power iteration: for each eigenvector k,
//      iterate v ← M·v, project out constant vector and all
//      previously found eigenvectors, normalize
//   4. The Rayleigh quotient on L gives the eigenvalue
//
// Storage: eigenvectors stored in flat array evecs[k*n + i]
//   where k = eigenvector index (0..6 for ψ₂..ψ₈), i = vertex index
//
// Max n = 32 (matching OctGraph), max k = 7 (imaginary octonion basis).
//
// References:
//   Belkin-Niyogi 2003, "Laplacian Eigenmaps for dimensionality reduction"
//   Atasoy+ 2016, "Human brain networks function in connectome-specific
//     harmonic waves" (connectome harmonics)

// Result of eigenvector extraction
pub struct LaplacianEigenvectors {
    n: i64                    // number of vertices
    k: i64                    // number of eigenvectors extracted
    eigenvalues: [f64; 8]     // λ₂..λ₈ (indices 0..6)
    // Eigenvectors stored flat: evecs[idx*32 + vertex]
    evecs: [f64; 256]         // 8 eigenvectors × 32 vertices max
}

fn le_empty() -> LaplacianEigenvectors {
    LaplacianEigenvectors {
        n: 0, k: 0,
        eigenvalues: [0.0; 8],
        evecs: [0.0; 256],
    }
}

// Internal: matvec for n×n matrix in [f64; 1024]
fn cn_matvec(
    mat: &[f64; 1024], n: i64,
    vec: &[f64; 32], out: &![f64; 32]
) with Mut {
    var i: i64 = 0
    while i < n {
        var s: f64 = 0.0
        var j: i64 = 0
        while j < n {
            s = s + mat[i * n + j] * vec[j]
            j = j + 1
        }
        out[i] = s
        i = i + 1
    }
}

// Internal: dot product
fn cn_dot(u: &[f64; 32], v: &[f64; 32], n: i64) -> f64 with Mut {
    var s: f64 = 0.0
    var i: i64 = 0
    while i < n {
        s = s + u[i] * v[i]
        i = i + 1
    }
    s
}

// Internal: normalize vector, return norm
fn cn_normalize(v: &![f64; 32], n: i64) -> f64 with Mut, Div {
    var norm_sq: f64 = 0.0
    var i: i64 = 0
    while i < n {
        norm_sq = norm_sq + v[i] * v[i]
        i = i + 1
    }
    let nval = cn_sqrt(norm_sq)
    if nval > 1.0e-15 {
        i = 0
        while i < n {
            v[i] = v[i] / nval
            i = i + 1
        }
    }
    nval
}

// Internal: project out the constant vector
fn cn_project_orth_ones(v: &![f64; 32], n: i64) with Mut, Div {
    var dot: f64 = 0.0
    var i: i64 = 0
    while i < n {
        dot = dot + v[i]
        i = i + 1
    }
    let proj = dot / (n as f64)
    i = 0
    while i < n {
        v[i] = v[i] - proj
        i = i + 1
    }
}

// Internal: project out previously found eigenvector (stored in evecs at offset)
fn cn_project_orth_evec(
    v: &![f64; 32], evecs: &[f64; 256], evec_idx: i64, n: i64
) with Mut {
    let offset = evec_idx * 32
    var dot: f64 = 0.0
    var i: i64 = 0
    while i < n {
        dot = dot + v[i] * evecs[offset + i]
        i = i + 1
    }
    i = 0
    while i < n {
        v[i] = v[i] - dot * evecs[offset + i]
        i = i + 1
    }
}

// Extract k smallest non-trivial eigenvectors of the Laplacian.
//   adj:  n×n adjacency matrix in row-major [f64; 1024]
//   n:    number of vertices (max 32)
//   k:    number of eigenvectors to extract (max 7)
//   max_iter: power iterations per eigenvector
pub fn laplacian_eigenvectors(
    adj: &[f64; 1024], n: i64, k: i64, max_iter: i64
) -> LaplacianEigenvectors with Mut, Div, Panic {
    var result = le_empty()
    result.n = n
    result.k = k

    // Step 1: Compute Laplacian L = D - A
    var lap: [f64; 1024] = [0.0; 1024]
    var i: i64 = 0
    while i < n {
        var deg: f64 = 0.0
        var jj: i64 = 0
        while jj < n {
            deg = deg + adj[i * n + jj]
            jj = jj + 1
        }
        var j: i64 = 0
        while j < n {
            if i == j {
                lap[i * n + j] = deg
            } else {
                lap[i * n + j] = 0.0 - adj[i * n + j]
            }
            j = j + 1
        }
        i = i + 1
    }

    // Step 2: Estimate λ_max via power iteration on L
    var v: [f64; 32] = [0.0; 32]
    i = 0
    while i < n { v[i] = 1.0; i = i + 1 }
    cn_normalize(&!v, n)
    var w: [f64; 32] = [0.0; 32]
    var lambda_max: f64 = 0.0
    var iter: i64 = 0
    while iter < 100 {
        cn_matvec(&lap, n, &v, &!w)
        lambda_max = cn_dot(&v, &w, n)
        cn_normalize(&!w, n)
        i = 0
        while i < n { v[i] = w[i]; i = i + 1 }
        iter = iter + 1
    }
    // Add small margin to ensure positive definiteness
    lambda_max = lambda_max * 1.01 + 0.1

    // Step 3: Form M = λ_max·I - L (shifted matrix)
    var shifted: [f64; 1024] = [0.0; 1024]
    i = 0
    while i < n {
        var j: i64 = 0
        while j < n {
            if i == j {
                shifted[i * n + j] = lambda_max - lap[i * n + j]
            } else {
                shifted[i * n + j] = 0.0 - lap[i * n + j]
            }
            j = j + 1
        }
        i = i + 1
    }

    // Step 4: Extract k eigenvectors via deflated power iteration
    var ek: i64 = 0
    while ek < k && ek < 7 {
        // Initialize with alternating vector orthogonal to constants
        i = 0
        while i < n {
            // Use different starting vectors for each eigenvector
            let phase = (i + ek) * 7 + ek * 3
            let bit = phase - (phase / 2) * 2
            if bit == 0 { v[i] = 1.0 } else { v[i] = 0.0 - 1.0 }
            i = i + 1
        }
        // Project out constant and all previous eigenvectors
        cn_project_orth_ones(&!v, n)
        var prev: i64 = 0
        while prev < ek {
            cn_project_orth_evec(&!v, &result.evecs, prev, n)
            prev = prev + 1
        }
        cn_normalize(&!v, n)

        // Power iteration on shifted matrix
        iter = 0
        while iter < max_iter {
            cn_matvec(&shifted, n, &v, &!w)
            // Project out constant vector
            cn_project_orth_ones(&!w, n)
            // Project out all previously found eigenvectors
            prev = 0
            while prev < ek {
                cn_project_orth_evec(&!w, &result.evecs, prev, n)
                prev = prev + 1
            }
            let nval = cn_normalize(&!w, n)
            if nval < 1.0e-15 { iter = max_iter }
            // Copy w → v
            i = 0
            while i < n { v[i] = w[i]; i = i + 1 }
            iter = iter + 1
        }

        // Compute eigenvalue via Rayleigh quotient on L
        cn_matvec(&lap, n, &v, &!w)
        let eigenval = cn_dot(&v, &w, n)
        result.eigenvalues[ek] = eigenval

        // Store eigenvector
        let offset = ek * 32
        i = 0
        while i < n {
            result.evecs[offset + i] = v[i]
            i = i + 1
        }

        ek = ek + 1
    }

    result
}

// ============================================================================
// COHORT COMPARISON (G₂ bridge — neurotypical vs ADHD)
// ============================================================================
//
// Given two groups of connectomes (e.g., neurotypical vs ADHD), compute
// G₂ invariants per subject and test for group differences via
// permutation test.
//
// Pipeline per subject:
//   adjacency matrix → Laplacian → 7 eigenvectors → G₂ 3-form + SU(3) Q
//
// Group comparison:
//   1. Compute mean φ and mean Q per group
//   2. Test statistic: |mean_φ_A - mean_φ_B| (or Q analog)
//   3. Permutation test: shuffle group labels N times, recompute statistic
//   4. p-value = fraction of permutations with statistic ≥ observed
//
// Effect size: Cohen's d = (mean_A - mean_B) / pooled_sd
//
// Max cohort size: 64 subjects per group (128 total).
//
// References:
//   Good 2005, "Permutation, Parametric and Bootstrap Tests of Hypotheses"
//   Di Martino+ 2014, "The autism brain imaging data exchange" (ABIDE-I)

// Per-subject G₂ invariants
pub struct SubjectG2 {
    phi: f64           // G₂ 3-form value
    phi_abs: f64       // |φ|
    su3_quality: f64   // SU(3) branching quality Q
    lambda2: f64       // Fiedler value (algebraic connectivity)
}

fn subject_g2_empty() -> SubjectG2 {
    SubjectG2 { phi: 0.0, phi_abs: 0.0, su3_quality: 0.0, lambda2: 0.0 }
}

// Cohort: up to 64 subjects
pub struct Cohort {
    n: i64
    subjects: [SubjectG2; 64]
}

fn cohort_empty() -> Cohort {
    Cohort {
        n: 0,
        subjects: [SubjectG2 { phi: 0.0, phi_abs: 0.0, su3_quality: 0.0, lambda2: 0.0 }; 64],
    }
}

fn cohort_add(c: &!Cohort, s: SubjectG2) with Mut {
    if c.n < 64 {
        c.subjects[c.n] = s
        c.n = c.n + 1
    }
}

// Group statistics
pub struct CohortStats {
    n: i64
    mean_phi_abs: f64
    var_phi_abs: f64
    mean_su3_q: f64
    var_su3_q: f64
    mean_lambda2: f64
}

fn cn_cohort_stats(c: &Cohort) -> CohortStats with Mut, Div {
    var stats = CohortStats {
        n: c.n, mean_phi_abs: 0.0, var_phi_abs: 0.0,
        mean_su3_q: 0.0, var_su3_q: 0.0, mean_lambda2: 0.0,
    }
    if c.n == 0 { return stats }

    // Means
    var i: i64 = 0
    while i < c.n {
        stats.mean_phi_abs = stats.mean_phi_abs + c.subjects[i].phi_abs
        stats.mean_su3_q = stats.mean_su3_q + c.subjects[i].su3_quality
        stats.mean_lambda2 = stats.mean_lambda2 + c.subjects[i].lambda2
        i = i + 1
    }
    let nf = c.n as f64
    stats.mean_phi_abs = stats.mean_phi_abs / nf
    stats.mean_su3_q = stats.mean_su3_q / nf
    stats.mean_lambda2 = stats.mean_lambda2 / nf

    // Variances
    i = 0
    while i < c.n {
        let dp = c.subjects[i].phi_abs - stats.mean_phi_abs
        let dq = c.subjects[i].su3_quality - stats.mean_su3_q
        stats.var_phi_abs = stats.var_phi_abs + dp * dp
        stats.var_su3_q = stats.var_su3_q + dq * dq
        i = i + 1
    }
    if c.n > 1 {
        stats.var_phi_abs = stats.var_phi_abs / (nf - 1.0)
        stats.var_su3_q = stats.var_su3_q / (nf - 1.0)
    }
    stats
}

// Cohen's d effect size between two cohorts
pub struct EffectSize {
    d_phi: f64      // Cohen's d for |φ|
    d_su3_q: f64    // Cohen's d for SU(3) quality
    diff_phi: f64   // raw mean difference in |φ|
    diff_q: f64     // raw mean difference in Q
}

fn cn_effect_size(a: &CohortStats, b: &CohortStats) -> EffectSize with Div {
    let diff_phi = a.mean_phi_abs - b.mean_phi_abs
    let diff_q = a.mean_su3_q - b.mean_su3_q

    // Pooled sd: sp = sqrt(((n1-1)*s1² + (n2-1)*s2²) / (n1+n2-2))
    let n1 = if a.n > 1 { a.n - 1 } else { 1 }
    let n2 = if b.n > 1 { b.n - 1 } else { 1 }
    let denom = (n1 + n2) as f64

    let pooled_var_phi = ((n1 as f64) * a.var_phi_abs + (n2 as f64) * b.var_phi_abs) / denom
    let pooled_var_q = ((n1 as f64) * a.var_su3_q + (n2 as f64) * b.var_su3_q) / denom

    let sp_phi = cn_sqrt(pooled_var_phi)
    let sp_q = cn_sqrt(pooled_var_q)

    EffectSize {
        d_phi: if sp_phi > 1.0e-12 { diff_phi / sp_phi } else { 0.0 },
        d_su3_q: if sp_q > 1.0e-12 { diff_q / sp_q } else { 0.0 },
        diff_phi: diff_phi,
        diff_q: diff_q,
    }
}

// Permutation test result
pub struct PermTestResult {
    observed_diff_phi: f64    // |mean_A(|φ|) - mean_B(|φ|)|
    observed_diff_q: f64      // |mean_A(Q) - mean_B(Q)|
    p_value_phi: f64          // fraction of permutations ≥ observed (|φ|)
    p_value_q: f64            // fraction of permutations ≥ observed (Q)
    n_perms: i64              // number of permutations run
}

// Internal: MINSTD PRNG for permutation shuffling
fn cn_rng_next(state: i64) -> i64 with Div {
    let a: i64 = 16807
    let m: i64 = 2147483647
    let q: i64 = 127773
    let r: i64 = 2836
    let hi = state / q
    let lo = state - hi * q
    let t = a * lo - r * hi
    if t > 0 { t } else { t + m }
}

// Permutation test: combine two cohorts, shuffle labels, compare groups.
pub fn permutation_test(
    a: &Cohort, b: &Cohort, n_perms: i64, seed: i64
) -> PermTestResult with Mut, Div {
    let stats_a = cn_cohort_stats(a)
    let stats_b = cn_cohort_stats(b)
    let obs_diff_phi = cn_abs(stats_a.mean_phi_abs - stats_b.mean_phi_abs)
    let obs_diff_q = cn_abs(stats_a.mean_su3_q - stats_b.mean_su3_q)

    let n_total = a.n + b.n
    if n_total == 0 || n_perms == 0 {
        return PermTestResult {
            observed_diff_phi: obs_diff_phi, observed_diff_q: obs_diff_q,
            p_value_phi: 1.0, p_value_q: 1.0, n_perms: 0,
        }
    }

    // Combined pool
    var pool_phi: [f64; 128] = [0.0; 128]
    var pool_q: [f64; 128] = [0.0; 128]
    var i: i64 = 0
    while i < a.n {
        pool_phi[i] = a.subjects[i].phi_abs
        pool_q[i] = a.subjects[i].su3_quality
        i = i + 1
    }
    i = 0
    while i < b.n {
        pool_phi[a.n + i] = b.subjects[i].phi_abs
        pool_q[a.n + i] = b.subjects[i].su3_quality
        i = i + 1
    }

    // Permutation loop
    var count_ge_phi: i64 = 0
    var count_ge_q: i64 = 0
    var rng = seed
    var perm: i64 = 0

    while perm < n_perms {
        // Copy pool for shuffling
        var sh_phi: [f64; 128] = [0.0; 128]
        var sh_q: [f64; 128] = [0.0; 128]
        i = 0
        while i < n_total {
            sh_phi[i] = pool_phi[i]
            sh_q[i] = pool_q[i]
            i = i + 1
        }

        // Fisher-Yates shuffle
        i = n_total - 1
        while i > 0 {
            rng = cn_rng_next(rng)
            var j = rng
            if j < 0 { j = 0 - j }
            j = j - (j / (i + 1)) * (i + 1)
            let tp = sh_phi[i]
            let tq = sh_q[i]
            sh_phi[i] = sh_phi[j]
            sh_q[i] = sh_q[j]
            sh_phi[j] = tp
            sh_q[j] = tq
            i = i - 1
        }

        // Mean difference under this permutation
        var sa_phi: f64 = 0.0
        var sa_q: f64 = 0.0
        i = 0
        while i < a.n { sa_phi = sa_phi + sh_phi[i]; sa_q = sa_q + sh_q[i]; i = i + 1 }
        var sb_phi: f64 = 0.0
        var sb_q: f64 = 0.0
        i = 0
        while i < b.n { sb_phi = sb_phi + sh_phi[a.n + i]; sb_q = sb_q + sh_q[a.n + i]; i = i + 1 }

        let pd_phi = cn_abs(sa_phi / (a.n as f64) - sb_phi / (b.n as f64))
        let pd_q = cn_abs(sa_q / (a.n as f64) - sb_q / (b.n as f64))

        if pd_phi >= obs_diff_phi { count_ge_phi = count_ge_phi + 1 }
        if pd_q >= obs_diff_q { count_ge_q = count_ge_q + 1 }

        perm = perm + 1
    }

    PermTestResult {
        observed_diff_phi: obs_diff_phi,
        observed_diff_q: obs_diff_q,
        p_value_phi: (count_ge_phi as f64) / (n_perms as f64),
        p_value_q: (count_ge_q as f64) / (n_perms as f64),
        n_perms: n_perms,
    }
}
