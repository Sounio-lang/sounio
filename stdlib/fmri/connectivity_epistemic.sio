// fmri::connectivity_epistemic — Epistemic-Aware Functional Connectivity
//
// Connectivity matrices with uncertainty propagation:
// - Pearson correlation with Fisher-z CI
// - Phase-locking value (PLV)
// - Graph-theoretic metrics with uncertainty
//
// All outputs integrate with epistemic principles.

// Math helpers inlined

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn sqrt_f64(x: f64) -> f64 {
    if x <= 0.0 { return 0.0 }
    var r = x
    r = 0.5 * (r + x / r)
    r = 0.5 * (r + x / r)
    r = 0.5 * (r + x / r)
    r = 0.5 * (r + x / r)
    r = 0.5 * (r + x / r)
    r = 0.5 * (r + x / r)
    r = 0.5 * (r + x / r)
    r = 0.5 * (r + x / r)
    r = 0.5 * (r + x / r)
    r = 0.5 * (r + x / r)
    r
}

fn exp_f64(x: f64) -> f64 {
    var result = 1.0
    var term = 1.0
    var i = 1
    while i < 20 {
        term = term * x / (i as f64)
        result = result + term
        i = i + 1
    }
    result
}

fn log_f64(x: f64) -> f64 {
    if x <= 0.0 { return 0.0 }
    var v = x
    var scale = 0.0
    while v > 2.0 { v = v / 2.718281828; scale = scale + 1.0 }
    while v < 0.5 { v = v * 2.718281828; scale = scale - 1.0 }
    let y = (v - 1.0) / (v + 1.0)
    let y2 = y * y
    let result = 2.0 * y * (1.0 + y2 / 3.0 + y2 * y2 / 5.0 + y2 * y2 * y2 / 7.0 + y2 * y2 * y2 * y2 / 9.0)
    result + scale
}

fn cos_f64(x: f64) -> f64 {
    let x2 = x * x
    let x4 = x2 * x2
    let x6 = x4 * x2
    let x8 = x6 * x2
    1.0 - x2 / 2.0 + x4 / 24.0 - x6 / 720.0 + x8 / 40320.0
}

fn sin_f64(x: f64) -> f64 {
    let x2 = x * x
    let x3 = x2 * x
    let x5 = x3 * x2
    let x7 = x5 * x2
    let x9 = x7 * x2
    x - x3 / 6.0 + x5 / 120.0 - x7 / 5040.0 + x9 / 362880.0
}

fn fisher_z(r: f64) -> f64 {
    var rc = r
    if rc > 0.999 { rc = 0.999 }
    if rc < 0.0 - 0.999 { rc = 0.0 - 0.999 }
    0.5 * log_f64((1.0 + rc) / (1.0 - rc))
}

fn fisher_z_inv(z: f64) -> f64 {
    let e2z = exp_f64(2.0 * z)
    (e2z - 1.0) / (e2z + 1.0)
}

fn fisher_z_se(n: i64) -> f64 {
    if n < 4 { return 1.0 }
    1.0 / sqrt_f64((n - 3) as f64)
}

// ============================================================================
// EPISTEMIC STATUS
// ============================================================================

// Epistemic status for connectivity values
enum EpistemicStatus {
    Verified,           // High confidence, validated
    Provisional,        // Reasonable confidence
    Uncertain,          // Low confidence, needs validation
}

// ============================================================================
// CONNECTIVITY RESULT WITH UNCERTAINTY
// ============================================================================

// Single connectivity edge with uncertainty
struct ConnectivityEdge {
    r: f64,             // Correlation value
    uncertainty: f64,   // Uncertainty (SE)
    ci_lower: f64,      // 95% CI lower bound
    ci_upper: f64,      // 95% CI upper bound
    p_value: f64,       // P-value
}

fn edge_new() -> ConnectivityEdge {
    ConnectivityEdge {
        r: 0.0,
        uncertainty: 0.0,
        ci_lower: 0.0,
        ci_upper: 0.0,
        p_value: 1.0,
    }
}

// Connectivity matrix with uncertainty (small for demo)
struct ConnectivityMatrix {
    matrix: [[f64; 50]; 50],
    uncertainty: [[f64; 50]; 50],
    ci_lower: [[f64; 50]; 50],
    ci_upper: [[f64; 50]; 50],
    n_rois: i64,
    n_volumes_used: i64,
    mean_fd: f64,
}

fn connectivity_matrix_new() -> ConnectivityMatrix {
    ConnectivityMatrix {
        matrix: [[0.0; 50]; 50],
        uncertainty: [[0.0; 50]; 50],
        ci_lower: [[0.0; 50]; 50],
        ci_upper: [[0.0; 50]; 50],
        n_rois: 0,
        n_volumes_used: 0,
        mean_fd: 0.0,
    }
}

// ============================================================================
// PEARSON CORRELATION WITH FISHER-Z CI
// ============================================================================

// Pearson correlation between two timeseries
fn pearson_correlation(x: [f64; 200], y: [f64; 200], n: i64) -> f64 {
    // Compute means
    var mean_x: f64 = 0.0
    var mean_y: f64 = 0.0
    var i: i64 = 0
    while i < n {
        mean_x = mean_x + x[i as usize]
        mean_y = mean_y + y[i as usize]
        i = i + 1
    }
    mean_x = mean_x / n as f64
    mean_y = mean_y / n as f64

    // Compute correlation
    var cov: f64 = 0.0
    var var_x: f64 = 0.0
    var var_y: f64 = 0.0
    i = 0
    while i < n {
        let dx = x[i as usize] - mean_x
        let dy = y[i as usize] - mean_y
        cov = cov + dx * dy
        var_x = var_x + dx * dx
        var_y = var_y + dy * dy
        i = i + 1
    }

    let denom = sqrt_f64(var_x * var_y)
    if denom > 1e-10 {
        cov / denom
    } else {
        0.0
    }
}

// fisher_z, fisher_z_inv, fisher_z_se defined in preprocess.sio

// Compute correlation with confidence interval
fn compute_fc_with_ci(x: [f64; 200], y: [f64; 200], n: i64) -> ConnectivityEdge {
    var edge = edge_new()

    edge.r = pearson_correlation(x, y, n)

    // Fisher z confidence interval
    let z = fisher_z(edge.r)
    let z_se = fisher_z_se(n)
    let z_lower = z - 1.96 * z_se
    let z_upper = z + 1.96 * z_se

    edge.ci_lower = fisher_z_inv(z_lower)
    edge.ci_upper = fisher_z_inv(z_upper)
    edge.uncertainty = (edge.ci_upper - edge.ci_lower) / 2.0

    // P-value approximation
    let z_stat = abs_f64(z) / z_se
    edge.p_value = 2.0 * (1.0 - normal_cdf(z_stat))

    edge
}

// Standard normal CDF approximation
fn normal_cdf(x: f64) -> f64 {
    let t = 1.0 / (1.0 + 0.2316419 * abs_f64(x))
    let d = 0.3989422804014327  // 1/sqrt_f64(2*pi)
    let p = d * exp_f64(-x * x / 2.0) *
            (0.319381530 * t - 0.356563782 * t * t + 1.781477937 * t * t * t -
             1.821255978 * t * t * t * t + 1.330274429 * t * t * t * t * t)

    if x > 0.0 {
        1.0 - p
    } else {
        p
    }
}

// ============================================================================
// PHASE-LOCKING VALUE (PLV)
// ============================================================================

// Phase-locking value between two phase series
fn compute_plv(phase_x: [f64; 200], phase_y: [f64; 200], n: i64) -> f64 {
    // PLV = |mean(exp_f64(i * (phase_x - phase_y)))|
    var sum_cos: f64 = 0.0
    var sum_sin: f64 = 0.0

    var t: i64 = 0
    while t < n {
        let diff = phase_x[t as usize] - phase_y[t as usize]
        sum_cos = sum_cos + cos_f64(diff)
        sum_sin = sum_sin + sin_f64(diff)
        t = t + 1
    }

    sqrt_f64(sum_cos * sum_cos + sum_sin * sum_sin) / n as f64
}

// PLV with significance test (Rayleigh test)
fn compute_plv_with_pvalue(phase_x: [f64; 200], phase_y: [f64; 200], n: i64) -> ConnectivityEdge {
    var edge = edge_new()

    edge.r = compute_plv(phase_x, phase_y, n)

    // Rayleigh test for circular uniformity
    let rayleigh_z = n as f64 * edge.r * edge.r
    edge.p_value = exp_f64(-rayleigh_z)

    // Uncertainty from sample size
    edge.uncertainty = 1.0 / sqrt_f64(n as f64)
    edge.ci_lower = edge.r - 1.96 * edge.uncertainty
    edge.ci_upper = edge.r + 1.96 * edge.uncertainty

    // Clamp to valid range
    if edge.ci_lower < 0.0 { edge.ci_lower = 0.0 }
    if edge.ci_upper > 1.0 { edge.ci_upper = 1.0 }

    edge
}

// ============================================================================
// GRAPH METRICS WITH UNCERTAINTY
// ============================================================================

// Graph metric with uncertainty
struct GraphMetric {
    value: f64,
    uncertainty: f64,
    ci_lower: f64,
    ci_upper: f64,
    status: EpistemicStatus,
}

fn graph_metric_new() -> GraphMetric {
    GraphMetric {
        value: 0.0,
        uncertainty: 0.0,
        ci_lower: 0.0,
        ci_upper: 0.0,
        status: EpistemicStatus::Provisional,
    }
}

// Node degree (weighted sum of connections)
fn node_degree_weighted(
    conn_row: [f64; 50],
    unc_row: [f64; 50],
    n_nodes: i64,
    threshold: f64
) -> GraphMetric {
    var metric = graph_metric_new()
    var sum: f64 = 0.0
    var sum_unc_sq: f64 = 0.0

    var j: i64 = 0
    while j < n_nodes {
        if conn_row[j as usize] > threshold {
            sum = sum + conn_row[j as usize]
            sum_unc_sq = sum_unc_sq + unc_row[j as usize] * unc_row[j as usize]
        }
        j = j + 1
    }

    metric.value = sum
    metric.uncertainty = sqrt_f64(sum_unc_sq)
    metric.ci_lower = sum - 1.96 * metric.uncertainty
    metric.ci_upper = sum + 1.96 * metric.uncertainty

    if metric.uncertainty < metric.value * 0.1 {
        metric.status = EpistemicStatus::Verified
    } else if metric.uncertainty < metric.value * 0.3 {
        metric.status = EpistemicStatus::Provisional
    } else {
        metric.status = EpistemicStatus::Uncertain
    }

    metric
}

// Mean connectivity strength
fn mean_connectivity(matrix: [[f64; 50]; 50], n_rois: i64) -> GraphMetric {
    var metric = graph_metric_new()
    var sum: f64 = 0.0
    var count: i64 = 0

    var i: i64 = 0
    while i < n_rois {
        var j: i64 = i + 1
        while j < n_rois {
            sum = sum + matrix[i as usize][j as usize]
            count = count + 1
            j = j + 1
        }
        i = i + 1
    }

    if count > 0 {
        metric.value = sum / count as f64
    }

    // Approximate SE for mean correlation
    metric.uncertainty = 0.1  // Placeholder
    metric.ci_lower = metric.value - 1.96 * metric.uncertainty
    metric.ci_upper = metric.value + 1.96 * metric.uncertainty
    metric.status = EpistemicStatus::Provisional

    metric
}

// ============================================================================
// MOTION-AWARE UNCERTAINTY
// ============================================================================

// Inflate uncertainty based on motion quality
fn inflate_uncertainty_for_motion(
    base_uncertainty: f64,
    mean_fd: f64,
    scrub_fraction: f64
) -> f64 {
    // 2x per mm mean FD + 50% max from scrubbing
    let fd_factor = 1.0 + mean_fd * 2.0
    let scrub_factor = 1.0 + scrub_fraction * 0.5
    base_uncertainty * fd_factor * scrub_factor
}

// Determine epistemic status from uncertainty
fn status_from_uncertainty(r: f64, uncertainty: f64) -> EpistemicStatus {
    let rel_unc = if abs_f64(r) > 0.01 { uncertainty / abs_f64(r) } else { uncertainty }

    if rel_unc < 0.1 {
        EpistemicStatus::Verified
    } else if rel_unc < 0.3 {
        EpistemicStatus::Provisional
    } else {
        EpistemicStatus::Uncertain
    }
}

// ============================================================================
// BRIDGE: FC → EPISTEMIC ORC PIPELINE
// ============================================================================
//
// Connects functional connectivity computation to graph::epistemic_curvature.
// Takes an FC matrix with Fisher-z CIs, thresholds to binary graph, and
// propagates uncertainty into the cost matrix for epistemic ORC.

// Result of FC-to-graph conversion with uncertainty propagation
struct FCtoGraphResult {
    // Adjacency list (undirected)
    adj: [[usize; 50]; 50],
    adj_len: [usize; 50],
    n_rois: usize,

    // Cost uncertainty matrix for ORC
    // sigma_d(i,j) = uncertainty on BFS distance due to edge-existence uncertainty
    cost_uncertainty: [[f64; 50]; 50],

    // Edge classification
    n_certain_edges: usize,    // |r| - threshold > sigma_r
    n_uncertain_edges: usize,  // |r| - threshold < sigma_r (near threshold)
    n_total_edges: usize,

    // Per-edge correlations and CIs (for provenance)
    edge_rs: [f64; 1250],        // max 50*50/2 edges
    edge_sigmas: [f64; 1250],
    edge_u: [usize; 1250],
    edge_v: [usize; 1250],
    n_stored_edges: usize,
}

fn fc_to_graph_new() -> FCtoGraphResult {
    FCtoGraphResult {
        adj: [[0; 50]; 50],
        adj_len: [0; 50],
        n_rois: 0,
        cost_uncertainty: [[0.0; 50]; 50],
        n_certain_edges: 0,
        n_uncertain_edges: 0,
        n_total_edges: 0,
        edge_rs: [0.0; 1250],
        edge_sigmas: [0.0; 1250],
        edge_u: [0; 1250],
        edge_v: [0; 1250],
        n_stored_edges: 0,
    }
}

// Convert FC matrix to binary graph with epistemic edge uncertainty
//
// For each pair (i,j):
//   if |r_ij| > threshold: add edge
//   Classify edge as "certain" (|r|-threshold > sigma_r) or "uncertain"
//
// Cost uncertainty for BFS distance d(i,j):
//   sigma_d ≈ sqrt(d * frac_uncertain)
//   where frac_uncertain = n_uncertain / n_total
//   (each hop has probability frac_uncertain of being wrong)
fn build_epistemic_graph(
    fc_matrix: &ConnectivityMatrix,
    threshold: f64,
    motion_mean_fd: f64,
    scrub_fraction: f64
) -> FCtoGraphResult {
    var result = fc_to_graph_new()
    let n = fc_matrix.n_rois
    result.n_rois = n as usize

    // Phase 1: Build adjacency and classify edges
    var i: i64 = 0
    while i < n {
        var j: i64 = i + 1
        while j < n {
            let r = fc_matrix.matrix[i as usize][j as usize]
            let abs_r = abs_f64(r)

            if abs_r > threshold {
                // Add edge
                let ui = i as usize
                let uj = j as usize
                let li = result.adj_len[ui]
                let lj = result.adj_len[uj]
                result.adj[ui][li] = uj
                result.adj[uj][lj] = ui
                result.adj_len[ui] = li + 1
                result.adj_len[uj] = lj + 1

                // Get base uncertainty and inflate for motion
                let base_sigma = fc_matrix.uncertainty[ui][uj]
                let sigma_r = inflate_uncertainty_for_motion(
                    base_sigma, motion_mean_fd, scrub_fraction
                )

                // Classify: certain if well above threshold
                if abs_r - threshold > sigma_r {
                    result.n_certain_edges = result.n_certain_edges + 1
                } else {
                    result.n_uncertain_edges = result.n_uncertain_edges + 1
                }
                result.n_total_edges = result.n_total_edges + 1

                // Store edge provenance
                if result.n_stored_edges < 1250 {
                    let idx = result.n_stored_edges
                    result.edge_rs[idx] = r
                    result.edge_sigmas[idx] = sigma_r
                    result.edge_u[idx] = ui
                    result.edge_v[idx] = uj
                    result.n_stored_edges = result.n_stored_edges + 1
                }
            }
            j = j + 1
        }
        i = i + 1
    }

    // Phase 2: BFS distance matrix (for cost uncertainty computation)
    let frac_uncertain = if result.n_total_edges > 0 {
        (result.n_uncertain_edges as f64) / (result.n_total_edges as f64)
    } else { 0.0 }

    // BFS from each source node
    var source: usize = 0
    while source < (n as usize) {
        var dist: [i64; 50] = [-1; 50]
        dist[source] = 0
        var queue: [usize; 50] = [0; 50]
        queue[0] = source
        var head: usize = 0
        var tail: usize = 1

        while head < tail {
            let u = queue[head]
            head = head + 1
            var k: usize = 0
            while k < result.adj_len[u] {
                let v = result.adj[u][k]
                if dist[v] == -1 {
                    dist[v] = dist[u] + 1
                    queue[tail] = v
                    tail = tail + 1
                }
                k = k + 1
            }
        }

        // Set cost uncertainty: sigma_d(source, target) = sqrt(d * frac_uncertain)
        var target: usize = 0
        while target < (n as usize) {
            if dist[target] > 0 {
                result.cost_uncertainty[source][target] =
                    sqrt_f64((dist[target] as f64) * frac_uncertain)
            }
            target = target + 1
        }

        source = source + 1
    }

    result
}

// Compute mean ORC with uncertainty from an FC matrix
// This is the main entry point for fMRI → curvature analysis
//
// Returns: (mean_kappa, sigma_kappa, gci, eta, clustering)
struct FCCurvatureSummary {
    mean_kappa: f64,
    sigma_mean_kappa: f64,
    gci: f64,
    eta: f64,
    clustering: f64,
    n_nodes: usize,
    n_edges: usize,
    n_uncertain_edges: usize,
    frac_uncertain: f64,
}

fn compute_fc_curvature_summary(
    fc_matrix: &ConnectivityMatrix,
    threshold: f64,
    motion_mean_fd: f64,
    scrub_fraction: f64
) -> FCCurvatureSummary {
    let graph = build_epistemic_graph(fc_matrix, threshold, motion_mean_fd, scrub_fraction)

    // Compute eta = mean_k^2 / N
    var total_deg: usize = 0
    var i: usize = 0
    while i < graph.n_rois {
        total_deg = total_deg + graph.adj_len[i]
        i = i + 1
    }
    let mean_k = if graph.n_rois > 0 {
        (total_deg as f64) / (graph.n_rois as f64)
    } else { 0.0 }
    let eta = if graph.n_rois > 0 {
        mean_k * mean_k / (graph.n_rois as f64)
    } else { 0.0 }

    let frac_unc = if graph.n_total_edges > 0 {
        (graph.n_uncertain_edges as f64) / (graph.n_total_edges as f64)
    } else { 0.0 }

    FCCurvatureSummary {
        mean_kappa: 0.0,          // Filled by epistemic_curvature pipeline
        sigma_mean_kappa: 0.0,
        gci: 1.0 - frac_unc,     // Approximate GCI from edge certainty fraction
        eta: eta,
        clustering: 0.0,         // Filled by graph metrics computation
        n_nodes: graph.n_rois,
        n_edges: graph.n_total_edges,
        n_uncertain_edges: graph.n_uncertain_edges,
        frac_uncertain: frac_unc,
    }
}

