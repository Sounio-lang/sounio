// Bounded native paired-image QC: uint8 NIfTI-1/2, <=4096 samples/image,
// <=500 matching timepoints. Motion TSV has tx,ty,tz,rx,ry,rz and <=9 dp.
// Atlas coverage and a composite uncertainty index require additional inputs.
use fmri::nifti::{NiftiFileBuffer,NiftiHeader,nifti_file_buffer_new,nifti_header_new,nifti_read_file_buffer_into,nifti_parse_header_buffer_into}
use ffi::platform::{platform_open,platform_close}
use collections::byte_buffer::{byte_buffer_new,byte_buffer_push,byte_buffer_close}
use data::native_csv::{native_csv_open,native_csv_status,native_csv_next,native_csv_f64_9dp,native_csv_close}
use math::pure::{sqrt,ln,tanh,is_finite}

pub struct FmriNativeMetrics {
 pub status:i64,
 pub nframes:i64,
 pub fd_mean:f64,
 pub fd_max:f64,
 pub scrub_fraction:f64,
 pub tsnr_median:f64,
 pub tsnr_status:i64,
 pub dvars_median:f64,
 pub dvars_status:i64,
 pub fc_r:f64,
 pub fc_status:i64,
 pub fc_ci_width:f64,
 pub ci_status:i64,
}
pub fn fmri_native_metrics_new()->FmriNativeMetrics {
 FmriNativeMetrics {status:22,nframes:0,fd_mean:0.0,fd_max:0.0,scrub_fraction:0.0,
 tsnr_median:0.0,tsnr_status:1,dvars_median:0.0,dvars_status:1,
 fc_r:0.0,fc_status:1,fc_ci_width:0.0,ci_status:1}
}
fn pr_abs(x:f64)->f64 {if x<0.0 {0.0-x} else {x}}
fn fmri_shape(b:&NiftiFileBuffer,h:&NiftiHeader)->i64 with Div {
 if h.nx<=0 || h.ny<=0 || h.nz<=0 || h.nt<2 || h.nt>500 {return 0}
 if h.nx>4096 || h.ny>4096 || h.nz>4096 {return 0}
 if h.datatype!=2 || h.bitpix!=8 {return 0}
 let n=h.nx*h.ny*h.nz
 if n>4096/h.nt {return 0}
 if h.vox_offset<0 || h.vox_offset>b.len {return 0}
 if n*h.nt>b.len-h.vox_offset {return 0}
 n
}
fn fmri_motion_shape(b:&NiftiFileBuffer)->i64 with Mut,Div,Panic {
 let header="tx\tty\ttz\trx\try\trz"
 let hn=str_len(header)
 if b.len<=hn {return 0}
 var i:i64=0
 while i<hn {
  if b.data[i as usize] as i64!=str_char_at(header,i) {return 0}
  i=i+1
 }
 if b.data[i as usize]==13 as u8 {
  i=i+1
  if i>=b.len {return 0}
 }
 if b.data[i as usize]!=10 as u8 {return 0}
 i=i+1
 var rows:i64=0
 var column:i64=0
 var chars:i64=0
 var fraction:i64=0
 var dot=false
 while i<b.len {
  let c=b.data[i as usize] as i64
  if c==9 {
   if chars==0 || column>=5 {return 0}
   column=column+1;chars=0;fraction=0;dot=false
  } else {
   if c==10 || c==13 {
    if column!=5 || chars==0 {return 0}
    if c==13 {
     i=i+1
     if i>=b.len {return 0}
     if b.data[i as usize]!=10 as u8 {return 0}
    }
    rows=rows+1;column=0;chars=0;fraction=0;dot=false
   } else {
    if c>=48 && c<=57 {
     if dot {fraction=fraction+1;if fraction>9 {return 0}}
    } else {
     if c==46 {if dot {return 0};dot=true} else {
      if (c!=43 && c!=45) || chars!=0 {return 0}
     }
    }
    chars=chars+1
   }
  }
  i=i+1
 }
 if chars>0 || column>0 {
  if column!=5 || chars==0 {return 0}
  rows=rows+1
 }
 if rows>500 {return 0}
 rows
}
struct FmriMotionStats {status:i64,mean:f64,maximum:f64,scrub:f64}
fn fmri_motion_stats(b:&NiftiFileBuffer,nt:i64)->FmriMotionStats with IO,Alloc,Mut,Div,Panic {
 var out=FmriMotionStats {status:22,mean:0.0,maximum:0.0,scrub:0.0}
 if fmri_motion_shape(b)!=nt {return out}
 let p=platform_open()
 var input=byte_buffer_new(b.len)
 var code:i64=0
 var i:i64=0
 while i<b.len {
  let c=b.data[i as usize] as i64
  let v=if c==9 {44} else {c}
  if byte_buffer_push(&!input,v)!=0 {code=12}
  i=i+1
 }
 var csv=native_csv_open(&p,&input,b.len+1)
 if native_csv_status(&csv)!=0 {code=22}
 var previous:[f64;6]=[0.0;6]
 var row:i64=0
 var sum:f64=0.0
 var maximum:f64=0.0
 var scrubbed:i64=0
 while code==0 && native_csv_next(&!csv) {
  var current:[f64;6]=[0.0;6]
  var col:i64=0
  while col<6 {
   let number=native_csv_f64_9dp(&!csv,col)
   if number.status!=0 || !is_finite(number.value) {code=22}
   current[col as usize]=number.value
   col=col+1
  }
  if row>=nt {code=22}
  if row>0 && code==0 {
   let translation=pr_abs(current[0]-previous[0])+pr_abs(current[1]-previous[1])+pr_abs(current[2]-previous[2])
   let rotation=pr_abs(current[3]-previous[3])+pr_abs(current[4]-previous[4])+pr_abs(current[5]-previous[5])
   let fd=translation+50.0*rotation
   sum=sum+fd
   if fd>maximum {maximum=fd}
   if fd>0.2 {scrubbed=scrubbed+1}
  }
  previous=current
  row=row+1
 }
 let closed=native_csv_close(&p,csv)
 if closed!=0 || row!=nt {code=22}
 byte_buffer_close(input)
 platform_close(p)
 if code==0 {
  out.status=0
  out.mean=sum/((nt-1) as f64)
  out.maximum=maximum
  out.scrub=(scrubbed as f64)/(nt as f64)
 }
 out
}
fn fmri_median(data:&![f64;4096],n:i64)->f64 with Mut,Div,Panic {
 var i:i64=1
 while i<n {
  let x=data[i as usize]
  var j=i
  while j>0 && data[(j-1) as usize]>x {
   data[j as usize]=data[(j-1) as usize]
   j=j-1
  }
  data[j as usize]=x
  i=i+1
 }
 if n%2==1 {data[(n/2) as usize]} else {(data[(n/2-1) as usize]+data[(n/2) as usize])/2.0}
}
fn fmri_voxel(b:&NiftiFileBuffer,h:&NiftiHeader,nvox:i64,t:i64,v:i64)->f64 with Mut,Div,Panic {
 b.data[(h.vox_offset+t*nvox+v) as usize] as f64
}
fn fmri_tsnr(b:&NiftiFileBuffer,h:&NiftiHeader,nvox:i64,out:&!FmriNativeMetrics) with Mut,Div,Panic {
 var values:[f64;4096]=[0.0;4096]
 var v:i64=0
 var valid=true
 while v<nvox {
  var total:f64=0.0
  var t:i64=0
  while t<h.nt {total=total+fmri_voxel(b,h,nvox,t,v);t=t+1}
  let mean=total/(h.nt as f64)
  var squares:f64=0.0
  t=0
  while t<h.nt {
   let delta=fmri_voxel(b,h,nvox,t,v)-mean
   squares=squares+delta*delta
   t=t+1
  }
  if squares<=0.0 {valid=false} else {values[v as usize]=mean/sqrt(squares/((h.nt-1) as f64))}
  v=v+1
 }
 if valid {out.tsnr_median=fmri_median(&!values,nvox);out.tsnr_status=0}
}
fn fmri_dvars(b:&NiftiFileBuffer,h:&NiftiHeader,nvox:i64,out:&!FmriNativeMetrics) with Mut,Div,Panic {
 var values:[f64;4096]=[0.0;4096]
 var t:i64=1
 while t<h.nt {
  var sum:f64=0.0
  var v:i64=0
  while v<nvox {
   let d=fmri_voxel(b,h,nvox,t,v)-fmri_voxel(b,h,nvox,t-1,v)
   sum=sum+d*d;v=v+1
  }
  values[(t-1) as usize]=sqrt(sum/(nvox as f64))
  t=t+1
 }
 out.dvars_median=fmri_median(&!values,h.nt-1)
 out.dvars_status=0
}
fn fmri_global_mean(b:&NiftiFileBuffer,h:&NiftiHeader,nvox:i64,t:i64)->f64 with Mut,Div,Panic {
 var sum:f64=0.0
 var v:i64=0
 while v<nvox {sum=sum+fmri_voxel(b,h,nvox,t,v);v=v+1}
 sum/(nvox as f64)
}
fn fmri_fc(a:&NiftiFileBuffer,ha:&NiftiHeader,b:&NiftiFileBuffer,hb:&NiftiHeader,nvox:i64,out:&!FmriNativeMetrics) with Mut,Div,Panic {
 var x:[f64;500]=[0.0;500]
 var y:[f64;500]=[0.0;500]
 var sx:f64=0.0
 var sy:f64=0.0
 var t:i64=0
 while t<ha.nt {
  x[t as usize]=fmri_global_mean(a,ha,nvox,t)
  y[t as usize]=fmri_global_mean(b,hb,nvox,t)
  sx=sx+x[t as usize];sy=sy+y[t as usize];t=t+1
 }
 let mx=sx/(ha.nt as f64)
 let my=sy/(ha.nt as f64)
 var xx:f64=0.0
 var yy:f64=0.0
 var xy:f64=0.0
 t=0
 while t<ha.nt {
  let dx=x[t as usize]-mx
  let dy=y[t as usize]-my
  xx=xx+dx*dx;yy=yy+dy*dy;xy=xy+dx*dy;t=t+1
 }
 if xx<=0.0 || yy<=0.0 {return}
 var r=xy/sqrt(xx*yy)
 if r>1.0 {r=1.0}
 if r<0.0-1.0 {r=0.0-1.0}
 out.fc_r=r;out.fc_status=0
 if ha.nt>3 {
  if r==1.0 || r==0.0-1.0 {out.fc_ci_width=0.0} else {
   let z=0.5*ln((1.0+r)/(1.0-r))
   let radius=1.96/sqrt((ha.nt-3) as f64)
   out.fc_ci_width=tanh(z+radius)-tanh(z-radius)
  }
  out.ci_status=0
 }
}
pub fn fmri_calculate_native(a:&NiftiFileBuffer,ha:&NiftiHeader,b:&NiftiFileBuffer,hb:&NiftiHeader,motion:&NiftiFileBuffer,out:&!FmriNativeMetrics)->i64 with IO,Alloc,Mut,Div,Panic {
 out.status=22;out.nframes=0
 out.fd_mean=0.0;out.fd_max=0.0;out.scrub_fraction=0.0
 out.tsnr_median=0.0;out.tsnr_status=1;out.dvars_median=0.0;out.dvars_status=1
 out.fc_r=0.0;out.fc_status=1;out.fc_ci_width=0.0;out.ci_status=1
 let na=fmri_shape(a,ha)
 let nb=fmri_shape(b,hb)
 if na==0 || na!=nb || ha.nx!=hb.nx || ha.ny!=hb.ny || ha.nz!=hb.nz || ha.nt!=hb.nt {return 22}
 let m=fmri_motion_stats(motion,ha.nt)
 if m.status!=0 {return m.status}
 out.nframes=ha.nt;out.fd_mean=m.mean;out.fd_max=m.maximum;out.scrub_fraction=m.scrub
 fmri_tsnr(a,ha,na,out)
 fmri_dvars(a,ha,na,out)
 fmri_fc(a,ha,b,hb,na,out)
 out.status=0
 0
}
fn fmri_emit_metric(name:string,value:f64) with IO {
 print("SCIENCE_METRIC fmri ");print(name);print(" ");println(value)
 print("FMRI_BITS ");print(name);print(" ");print_int(f64_to_bits(value));print("\n")
}
fn fmri_emit_unavailable(name:string,reason:string) with IO {
 print("SCIENCE_UNAVAILABLE fmri ");print(name);print(" ");println(reason)
}
pub fn run_fmri_pipeline_gate(path_a:string,path_b:string,path_motion:string)->i32 with IO,Alloc,Mut,Div,Panic {
 var a=nifti_file_buffer_new()
 var b=nifti_file_buffer_new()
 var motion=nifti_file_buffer_new()
 if nifti_read_file_buffer_into(path_a,&!a)!=0 {return 10}
 if nifti_read_file_buffer_into(path_b,&!b)!=0 {return 11}
 if nifti_read_file_buffer_into(path_motion,&!motion)!=0 {return 12}
 var ha=nifti_header_new()
 var hb=nifti_header_new()
 if nifti_parse_header_buffer_into(&a,&!ha)!=0 {return 13}
 if nifti_parse_header_buffer_into(&b,&!hb)!=0 {return 14}
 var out=fmri_native_metrics_new()
 let status=fmri_calculate_native(&a,&ha,&b,&hb,&motion,&!out)
 if status!=0 {return 15}
 fmri_emit_metric("nifti1_status",1.0)
 fmri_emit_metric("nifti2_status",1.0)
 fmri_emit_metric("qc_fd_mean",out.fd_mean)
 fmri_emit_metric("qc_fd_max",out.fd_max)
 fmri_emit_metric("qc_scrub_fraction",out.scrub_fraction)
 if out.tsnr_status==0 {fmri_emit_metric("qc_tsnr_median",out.tsnr_median)} else {fmri_emit_unavailable("qc_tsnr_median","zero_temporal_variance")}
 if out.dvars_status==0 {fmri_emit_metric("qc_dvars_median",out.dvars_median)}
 if out.fc_status==0 {fmri_emit_metric("fc_r",out.fc_r)} else {fmri_emit_unavailable("fc_r","zero_global_signal_variance")}
 if out.ci_status==0 {fmri_emit_metric("fc_ci_width",out.fc_ci_width)} else {fmri_emit_unavailable("fc_ci_width","insufficient_or_constant_timepoints")}
 fmri_emit_unavailable("atlas_coverage_ratio","atlas_input_required")
 fmri_emit_unavailable("uncertainty_score","index_definition_required")
 0
}
