// fmri/pipeline_real.sio — Executable tiny-fixture fMRI pipeline

fn pr_abs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }
fn pr_sqrt(x: f64) -> f64 {
    if x <= 0.0 { return 0.0 }
    var r = x
    var i = 0
    while i < 15 { r = 0.5 * (r + x / r); i = i + 1 }
    r
}

struct FmriPipelineConfig {
    min_atlas_coverage: f64,
    fd_threshold: f64,
}

fn fmri_pipeline_config_default() -> FmriPipelineConfig {
    FmriPipelineConfig { min_atlas_coverage: 0.01, fd_threshold: 0.2 }
}

struct FmriQcMetrics {
    fd_mean: f64,
    fd_max: f64,
    scrub_fraction: f64,
    tsnr_median: f64,
    dvars_median: f64,
}

fn fmri_qc_metrics_new() -> FmriQcMetrics {
    FmriQcMetrics { fd_mean: 0.0, fd_max: 0.0, scrub_fraction: 0.0, tsnr_median: 0.0, dvars_median: 0.0 }
}

struct FmriAtlasCoverage {
    n_regions: i64,
    covered_voxels: i64,
    coverage_ratio: f64,
    passes_threshold: bool,
}

fn fmri_atlas_coverage_new() -> FmriAtlasCoverage {
    FmriAtlasCoverage { n_regions: 0, covered_voxels: 0, coverage_ratio: 0.0, passes_threshold: false }
}

struct FmriUncertaintySummary {
    fc_ci_width: f64,
    uncertainty_score: f64,
}

fn fmri_uncertainty_summary_new() -> FmriUncertaintySummary {
    FmriUncertaintySummary { fc_ci_width: 0.0, uncertainty_score: 0.0 }
}

struct FmriPipelineResult {
    success: bool,
    qc: FmriQcMetrics,
    fc_r: f64,
    atlas: FmriAtlasCoverage,
    uncertainty: FmriUncertaintySummary,
}

fn fmri_pipeline_result_new() -> FmriPipelineResult {
    FmriPipelineResult {
        success: false,
        qc: fmri_qc_metrics_new(),
        fc_r: 0.0,
        atlas: fmri_atlas_coverage_new(),
        uncertainty: fmri_uncertainty_summary_new(),
    }
}

struct MotionParams6PR {
    tx: f64, ty: f64, tz: f64,
    rx: f64, ry: f64, rz: f64,
}

fn motion_params6_new_pr() -> MotionParams6PR {
    MotionParams6PR { tx: 0.0, ty: 0.0, tz: 0.0, rx: 0.0, ry: 0.0, rz: 0.0 }
}

fn framewise_displacement(prev: MotionParams6PR, curr: MotionParams6PR, head_radius: f64) -> f64 {
    pr_abs(curr.tx - prev.tx) + pr_abs(curr.ty - prev.ty) + pr_abs(curr.tz - prev.tz) +
    head_radius * (pr_abs(curr.rx - prev.rx) + pr_abs(curr.ry - prev.ry) + pr_abs(curr.rz - prev.rz))
}

// Compute FD timeseries from motion params
fn calculate_fd_timeseries(
    motion: &[MotionParams6PR; 500], n: i64, head_radius: f64,
    fd_out: &![f64; 500]
) -> f64 with Mut, Div, Panic {
    var max_fd = 0.0
    var sum_fd = 0.0
    var i: i64 = 1
    while i < n && i < 500 {
        let fd = framewise_displacement(motion[(i - 1) as usize], motion[i as usize], head_radius)
        fd_out[(i - 1) as usize] = fd
        sum_fd = sum_fd + fd
        if fd > max_fd { max_fd = fd }
        i = i + 1
    }
    if n > 1 { sum_fd / ((n - 1) as f64) } else { 0.0 }
}

// Pearson correlation for two arrays
fn pr_pearson(x: &[f64; 100], y: &[f64; 100], n: i64) -> f64 with Div, Panic, Mut {
    var sx = 0.0
    var sy = 0.0
    var sxx = 0.0
    var syy = 0.0
    var sxy = 0.0
    var i: i64 = 0
    while i < n {
        sx = sx + x[i as usize]
        sy = sy + y[i as usize]
        sxx = sxx + x[i as usize] * x[i as usize]
        syy = syy + y[i as usize] * y[i as usize]
        sxy = sxy + x[i as usize] * y[i as usize]
        i = i + 1
    }
    let nf = n as f64
    let num = nf * sxy - sx * sy
    let den = pr_sqrt((nf * sxx - sx * sx) * (nf * syy - sy * sy))
    if den < 0.0001 { 0.0 } else { num / den }
}

fn test_fd_zero_motion() -> bool with Mut, Div, Panic {
    var motion: [MotionParams6PR; 500] = [motion_params6_new_pr(); 500]
    var fd_out: [f64; 500] = [0.0; 500]
    let mean_fd = calculate_fd_timeseries(&motion, 10, 50.0, &!fd_out)
    pr_abs(mean_fd) < 0.001
}

fn test_pipeline_result_init() -> bool {
    let r = fmri_pipeline_result_new()
    !r.success && r.fc_r == 0.0
}

// ============================================================================
// Portão da pista fMRI real — carrega dois NIfTI de fixture e confere coerência.
//
// 🚨 Esta função era CHAMADA por tests/stdlib/fmri/test_pipeline_real_e2e.sio e NÃO EXISTIA.
// O compilador emitia `xor eax,eax` no lugar, a chamada devolvia 0, o teste imprimia
// "SCIENCE_FMRI_OK" e passava — sem jamais abrir um arquivo. Achado pelo E201 (28-ago-2026).
//
// O que ela verifica de fato, e nada além disso: que os dois volumes carregam pelo caminho
// nativo (`nifti_load_file_into`, que lê o buffer e faz o parse do header) e que os dois
// concordam nas dimensões espaciais. Não é a pipeline inteira — é um portão, e o nome diz isso.
// Códigos de retorno distintos por modo de falha, para o teste não colapsar tudo em "deu ruim".
fn run_fmri_pipeline_gate(path_a: string, path_b: string, motion_tsv: string) -> i32
    with IO, Mut, Div, Panic {
    var img_a = nifti_image_new()
    var hdr_a = nifti_header_new()
    let rc_a = nifti_load_file_into(path_a, &!img_a, &!hdr_a)
    if rc_a != 0 { return 4 }

    var img_b = nifti_image_new()
    var hdr_b = nifti_header_new()
    let rc_b = nifti_load_file_into(path_b, &!img_b, &!hdr_b)
    if rc_b != 0 { return 5 }

    // Dois volumes da mesma aquisição têm de concordar na grade espacial.
    if hdr_a.nx != hdr_b.nx { return 6 }
    if hdr_a.ny != hdr_b.ny { return 7 }
    if hdr_a.nz != hdr_b.nz { return 8 }

    // Grade degenerada não é volume.
    if hdr_a.nx <= 0 { return 9 }
    if hdr_a.ny <= 0 { return 10 }

    // O arquivo de movimento entra no portão pelo caminho de leitura, não por suposição:
    // se não abrir, o portão falha em vez de fingir que leu.
    var motion_buf = nifti_file_buffer_new()
    let rc_m = nifti_read_file_buffer_into(motion_tsv, &!motion_buf)
    if rc_m != 0 { return 11 }
    if motion_buf.len <= 0 { return 12 }

    0
}
