// research::erdos90_mixed_pool — union ℤ² + Eisenstein pools (exact, dual metric)
//
// Points carry tag 0 (square ℤ², unit²=NSQ) or tag 1 (Eisenstein axial, d2==1).
// Cross-tag edges are omitted: ℤ² and ℤ[ω] share no common integer Cartesian frame
// (docs/research/erdos-90-planar-search-plan.md). Objective = induced edges within
// each metric; subset search may mix tags to hunt heterogeneous dense sets.

module research::erdos90_mixed_pool

fn isqrt(n: i64) -> i64 with Mut {
    if n < 0 { return 0 }
    var r = 0
    while (r + 1) * (r + 1) <= n { r = r + 1 }
    return r
}

fn harb(n: i64) -> i64 with Mut {
    let m = 12 * n - 3
    let s = isqrt(m)
    var c = s
    if s * s < m { c = s + 1 }
    return 3 * n - c
}

fn iabs(x: i64) -> i64 { if x < 0 { return 0 - x } else { return x } }

fn hexdist(a: i64, b: i64) -> i64 {
    return (iabs(a) + iabs(b) + iabs(a + b)) / 2
}

fn axial_d2(ai: i64, bi: i64, aj: i64, bj: i64) -> i64 {
    let x = ai - aj
    let y = bi - bj
    return x * x + x * y + y * y
}

var PA: [i64; 1500] = [0; 1500]
var PB: [i64; 1500] = [0; 1500]
var PTAG: [i64; 1500] = [0; 1500]
var PNORM: [i64; 1500] = [0; 1500]
var PN: i64 = 0
var NBR: [i64; 24000] = [0; 24000]
var NDEG: [i64; 1500] = [0; 1500]
var MEM: [i64; 1500] = [0; 1500]
var RNG: i64 = 1

fn rng_next() -> i64 with Mut {
    RNG = (RNG * 16807) % 2147483647
    if RNG < 0 { RNG = RNG + 2147483647 }
    return RNG
}

fn build_pool_mixed(Rz: i64, Re: i64) with Mut {
    PN = 0
    var x = 0 - Rz
    while x <= Rz {
        var y = 0 - Rz
        while y <= Rz {
            if x * x + y * y <= Rz * Rz {
                if PN < 1500 {
                    PA[PN as usize] = x
                    PB[PN as usize] = y
                    PTAG[PN as usize] = 0
                    PNORM[PN as usize] = x * x + y * y
                    PN = PN + 1
                }
            }
            y = y + 1
        }
        x = x + 1
    }
    var a = 0 - Re
    while a <= Re {
        var b = 0 - Re
        while b <= Re {
            if hexdist(a, b) <= Re {
                if PN < 1500 {
                    PA[PN as usize] = a
                    PB[PN as usize] = b
                    PTAG[PN as usize] = 1
                    PNORM[PN as usize] = hexdist(a, b)
                    PN = PN + 1
                }
            }
            b = b + 1
        }
        a = a + 1
    }
}

fn edge_ok(i: i64, j: i64, nsq: i64) -> i64 {
    let ti = PTAG[i as usize]
    let tj = PTAG[j as usize]
    if ti == 0 && tj == 0 {
        let dx = PA[i as usize] - PA[j as usize]
        let dy = PB[i as usize] - PB[j as usize]
        if dx * dx + dy * dy == nsq { return 1 } else { return 0 }
    }
    if ti == 1 && tj == 1 {
        if axial_d2(PA[i as usize], PB[i as usize], PA[j as usize], PB[j as usize]) == 1 {
            return 1
        } else { return 0 }
    }
    return 0
}

fn build_nbrs(nsq: i64) with Mut {
    var i = 0
    while i < PN {
        var d = 0
        var j = 0
        while j < PN {
            if j != i {
                if edge_ok(i, j, nsq) == 1 {
                    if d < 16 { NBR[(i * 16 + d) as usize] = j; d = d + 1 }
                }
            }
            j = j + 1
        }
        NDEG[i as usize] = d
        i = i + 1
    }
}

fn mem_deg(i: i64) -> i64 with Mut {
    var c = 0
    var t = 0
    let d = NDEG[i as usize]
    while t < d {
        let nb = NBR[(i * 16 + t) as usize]
        if MEM[nb as usize] == 1 { c = c + 1 }
        t = t + 1
    }
    return c
}

fn total_edges() -> i64 with Mut {
    var s = 0
    var i = 0
    while i < PN {
        if MEM[i as usize] == 1 { s = s + mem_deg(i) }
        i = i + 1
    }
    return s / 2
}

fn clear_mem() with Mut {
    var i = 0
    while i < PN { MEM[i as usize] = 0; i = i + 1 }
}

fn init_mixed_disk(n: i64) with Mut {
    clear_mem()
    var picked = 0
    var used: [i64; 1500] = [0; 1500]
    while picked < n {
        var best = 0 - 1
        var bestNorm = 999999999
        var i = 0
        while i < PN {
            if used[i as usize] == 0 {
                if PNORM[i as usize] < bestNorm { bestNorm = PNORM[i as usize]; best = i }
            }
            i = i + 1
        }
        if best < 0 { picked = n } else {
            used[best as usize] = 1
            MEM[best as usize] = 1
            picked = picked + 1
        }
    }
}

fn init_random(n: i64) with Mut {
    clear_mem()
    var picked = 0
    while picked < n {
        let r = rng_next() % PN
        if MEM[r as usize] == 0 { MEM[r as usize] = 1; picked = picked + 1 }
    }
}

fn hillclimb(iters: i64) -> i64 with Mut, Div {
    var edges = total_edges()
    var t = 0
    while t < iters {
        let m = rng_next() % PN
        let c = rng_next() % PN
        if MEM[m as usize] == 1 && MEM[c as usize] == 0 && m != c {
            let dm = mem_deg(m)
            var adj = 0
            var u = 0
            let dd = NDEG[m as usize]
            while u < dd {
                if NBR[(m * 16 + u) as usize] == c { adj = 1 }
                u = u + 1
            }
            let dc = mem_deg(c)
            let delta = dc - adj - dm
            if delta > 0 {
                MEM[m as usize] = 0
                MEM[c as usize] = 1
                edges = edges + delta
            }
        }
        t = t + 1
    }
    return edges
}

fn count_tags() -> i64 with Mut {
    var z = 0
    var e = 0
    var i = 0
    while i < PN {
        if MEM[i as usize] == 1 {
            if PTAG[i as usize] == 0 { z = z + 1 } else { e = e + 1 }
        }
        i = i + 1
    }
    return z * 1000 + e
}

pub fn run(Rz: i64, Re: i64, nsq: i64, n: i64, restarts: i64, iters: i64) -> i64 with IO, Mut, Panic, Div {
    build_pool_mixed(Rz, Re)
    build_nbrs(nsq)
    init_mixed_disk(n)
    let diskc = hillclimb(iters)
    var best = diskc
    var s = 0
    while s < restarts {
        init_random(n)
        let c = hillclimb(iters)
        if c > best { best = c }
        s = s + 1
    }
    let tags = count_tags()
    let zsel = tags / 1000
    let esel = tags % 1000
    let h = harb(n)
    print("mixed Rz="); print_int(Rz); print(" Re="); print_int(Re)
    print(" Z2N="); print_int(nsq); print(" n="); print_int(n)
    print(" pool="); print_int(PN)
    print(" selZ2="); print_int(zsel); print(" selE="); print_int(esel)
    print(" diskHC="); print_int(diskc)
    print(" bestHC="); print_int(best)
    print(" harb="); print_int(h)
    if best > h { print("  BEAT-HARB") } else { print("  harb-ok") }
    if best > diskc { print("  SUBSET>DISK") } else { print("  disk-optimal") }
    print("\n")
    return best
}

fn main() -> i32 with IO, Mut, Panic, Div {
    RNG = 424242
    print("=== Erdos [90] mixed Z2+Eisenstein subset (dual metric, no cross edges) ===\n")
    let _ = run(12, 10, 1, 80, 8, 200000)
    let _ = run(14, 12, 1, 120, 5, 250000)
    print("honest: cross-tag unit edges omitted (no shared integer frame).\n")
    return 0
}