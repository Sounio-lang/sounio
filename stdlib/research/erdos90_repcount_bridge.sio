// research::erdos90_repcount_bridge — r₂(N) engine → optimizer N candidates
//
// Verifies Gauss r₂ doubling (4·2^t) for primes q ≡ 1 (mod 4), then prints the N
// literals wired into erdos90_optimize.sio / erdos90_search.sio. Links the finite
// ℤ[i] rep-count core to the cluster sweep without claiming the class-field tower.

module research::erdos90_repcount_bridge

fn isqrt(n: i64) -> i64 with Mut {
    var r = 0
    while (r + 1) * (r + 1) <= n { r = r + 1 }
    return r
}

fn r2(n: i64) -> i64 with Mut {
    let s = isqrt(n)
    var cnt = 0
    var a = 0 - s
    while a <= s {
        var b = 0 - s
        while b <= s {
            if a * a + b * b == n { cnt = cnt + 1 }
            b = b + 1
        }
        a = a + 1
    }
    return cnt
}

fn expected_r2(t: i64) -> i64 with Mut {
    var p = 4
    var i = 0
    while i < t { p = p * 2; i = i + 1 }
    return p
}

fn check_r2(n: i64, t: i64) -> i64 with IO, Mut {
    let got = r2(n)
    let exp = expected_r2(t)
    print("  N="); print_int(n); print(" r2="); print_int(got); print(" expect="); print_int(exp)
    if got == exp { print(" OK\n"); return 1 } else { print(" FAIL\n"); return 0 }
}

pub fn verify_chain() -> i64 with IO, Mut {
    var ok = 0
    ok = ok + check_r2(5, 1)
    ok = ok + check_r2(65, 2)
    ok = ok + check_r2(1105, 3)
    ok = ok + check_r2(32045, 4)
    if r2(15) != 0 { print("  r2(15) should be 0\n"); return 0 }
    print("  r2(15)=0 OK (q≡3 mod 4 kills reps)\n")
    return ok
}

fn main() -> i32 with IO, Mut {
    print("=== Erdos [90] r2 bridge: rep-count → optimizer N sweep ===\n")
    let ok = verify_chain()
    print("\noptimizer consider() literals (high r2): 5 25 65 325 1105 32045\n")
    print("pilot crossover N=25 at n=225; cluster peak N=1105 at n=16384.\n")
    if ok == 4 { return 0 } else { return 1 }
}