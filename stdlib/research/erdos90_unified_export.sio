// research::erdos90_unified_export — export n=100 Q(sqrt3) witness for Lean countUnitQ

module research::erdos90_unified_export

fn isqrt(n: i64) -> i64 with Mut {
    if n < 0 { return 0 }
    var r = 0
    while (r + 1) * (r + 1) <= n { r = r + 1 }
    return r
}

fn harb(n: i64) -> i64 with Mut {
    let m = 12 * n - 3
    let s = isqrt(m)
    var c = s
    if s * s < m { c = s + 1 }
    return 3 * n - c
}

fn iabs(x: i64) -> i64 { if x < 0 { return 0 - x } else { return x } }

fn hexdist(a: i64, b: i64) -> i64 {
    return (iabs(a) + iabs(b) + iabs(a + b)) / 2
}

var PX: [i64; 1800] = [0; 1800]
var PU: [i64; 1800] = [0; 1800]
var PV: [i64; 1800] = [0; 1800]
var PTAG: [i64; 1800] = [0; 1800]
var PNORM: [i64; 1800] = [0; 1800]
var PN: i64 = 0
var NBR: [i64; 28800] = [0; 28800]
var NDEG: [i64; 1800] = [0; 1800]
var MEM: [i64; 1800] = [0; 1800]
var BESTMEM: [i64; 1800] = [0; 1800]
var RNG: i64 = 1
var EXPORT_SEED: i64 = 1000003

fn rng_next() -> i64 with Mut {
    RNG = (RNG * 16807) % 2147483647
    if RNG < 0 { RNG = RNG + 2147483647 }
    return RNG
}

fn unit_edge(i: i64, j: i64) -> i64 {
    let dpx = PX[i as usize] - PX[j as usize]
    let dpu = PU[i as usize] - PU[j as usize]
    let dpv = PV[i as usize] - PV[j as usize]
    if dpu * dpv != 0 { return 0 }
    let sq = dpx * dpx + dpu * dpu + 3 * dpv * dpv
    if sq == 4 { return 1 } else { return 0 }
}

fn pool_has_coord(px: i64, pu: i64, pv: i64) -> i64 with Mut {
    var i = 0
    while i < PN {
        if PX[i as usize] == px && PU[i as usize] == pu && PV[i as usize] == pv {
            return 1
        }
        i = i + 1
    }
    return 0
}

fn pool_add(px: i64, pu: i64, pv: i64, tag: i64, norm: i64) with Mut {
    if pool_has_coord(px, pu, pv) == 1 { return }
    if PN < 1800 {
        PX[PN as usize] = px
        PU[PN as usize] = pu
        PV[PN as usize] = pv
        PTAG[PN as usize] = tag
        PNORM[PN as usize] = norm
        PN = PN + 1
    }
}

fn build_pool(Rz: i64, Re: i64) with Mut {
    PN = 0
    var x = 0 - Rz
    while x <= Rz {
        var y = 0 - Rz
        while y <= Rz {
            if x * x + y * y <= Rz * Rz {
                pool_add(2 * x, 2 * y, 0, 0, x * x + y * y)
            }
            y = y + 1
        }
        x = x + 1
    }
    var a = 0 - Re
    while a <= Re {
        var b = 0 - Re
        while b <= Re {
            if hexdist(a, b) <= Re {
                pool_add(2 * a + b, 0, b, 1, hexdist(a, b))
            }
            b = b + 1
        }
        a = a + 1
    }
}

fn build_nbrs() with Mut {
    var i = 0
    while i < PN {
        var d = 0
        var j = 0
        while j < PN {
            if j != i {
                if unit_edge(i, j) == 1 {
                    if d < 16 { NBR[(i * 16 + d) as usize] = j; d = d + 1 }
                }
            }
            j = j + 1
        }
        NDEG[i as usize] = d
        i = i + 1
    }
}

fn mem_deg(i: i64) -> i64 with Mut {
    var c = 0
    var t = 0
    let deg = NDEG[i as usize]
    while t < deg {
        let nb = NBR[(i * 16 + t) as usize]
        if MEM[nb as usize] == 1 { c = c + 1 }
        t = t + 1
    }
    return c
}

fn total_edges() -> i64 with Mut {
    var s = 0
    var i = 0
    while i < PN {
        if MEM[i as usize] == 1 { s = s + mem_deg(i) }
        i = i + 1
    }
    return s / 2
}

fn clear_mem() with Mut {
    var i = 0
    while i < PN { MEM[i as usize] = 0; i = i + 1 }
}

fn save_best_mem() with Mut {
    var i = 0
    while i < PN { BESTMEM[i as usize] = MEM[i as usize]; i = i + 1 }
}

fn restore_best_mem() with Mut {
    var i = 0
    while i < PN { MEM[i as usize] = BESTMEM[i as usize]; i = i + 1 }
}

fn init_disk(n: i64) with Mut {
    clear_mem()
    var picked = 0
    var used: [i64; 1800] = [0; 1800]
    while picked < n {
        var best = 0 - 1
        var bestNorm = 999999999
        var i = 0
        while i < PN {
            if used[i as usize] == 0 {
                if PNORM[i as usize] < bestNorm { bestNorm = PNORM[i as usize]; best = i }
            }
            i = i + 1
        }
        if best < 0 { picked = n } else {
            used[best as usize] = 1
            MEM[best as usize] = 1
            picked = picked + 1
        }
    }
}

fn init_random(n: i64) with Mut {
    clear_mem()
    var picked = 0
    while picked < n {
        let r = rng_next() % PN
        if MEM[r as usize] == 0 { MEM[r as usize] = 1; picked = picked + 1 }
    }
}

fn hillclimb(iters: i64) -> i64 with Mut, Div {
    var edges = total_edges()
    var t = 0
    while t < iters {
        let m = rng_next() % PN
        let c = rng_next() % PN
        if MEM[m as usize] == 1 && MEM[c as usize] == 0 && m != c {
            let dm = mem_deg(m)
            var adj = 0
            var u = 0
            let dd = NDEG[m as usize]
            while u < dd {
                if NBR[(m * 16 + u) as usize] == c { adj = 1 }
                u = u + 1
            }
            let dc = mem_deg(c)
            let delta = dc - adj - dm
            if delta > 0 {
                MEM[m as usize] = 0
                MEM[c as usize] = 1
                edges = edges + delta
            }
        }
        t = t + 1
    }
    return edges
}

fn count_disk_nsq(rr: i64, nsq: i64) -> i64 with Mut {
    let R = isqrt(rr)
    var px: [i64; 256] = [0; 256]
    var py: [i64; 256] = [0; 256]
    var dn = 0
    var x = 0 - R
    while x <= R {
        var y = 0 - R
        while y <= R {
            if x * x + y * y <= rr {
                if dn < 256 { px[dn as usize] = x; py[dn as usize] = y; dn = dn + 1 }
            }
            y = y + 1
        }
        x = x + 1
    }
    var cnt = 0
    var i = 0
    while i < dn {
        var j = i + 1
        while j < dn {
            let dx = px[i as usize] - px[j as usize]
            let dy = py[i as usize] - py[j as usize]
            if dx * dx + dy * dy == nsq { cnt = cnt + 1 }
            j = j + 1
        }
        i = i + 1
    }
    return cnt
}

fn grid_best_at_n(target_n: i64) -> i64 with Mut {
    var rr = 4
    var bestc = 0
    while rr <= 120 {
        let R = isqrt(rr)
        var dn = 0
        var x = 0 - R
        while x <= R {
            var y = 0 - R
            while y <= R {
                if x * x + y * y <= rr { dn = dn + 1 }
                y = y + 1
            }
            x = x + 1
        }
        if dn == target_n {
            var bc = count_disk_nsq(rr, 1)
            if count_disk_nsq(rr, 5) > bc { bc = count_disk_nsq(rr, 5) }
            if count_disk_nsq(rr, 25) > bc { bc = count_disk_nsq(rr, 25) }
            if count_disk_nsq(rr, 65) > bc { bc = count_disk_nsq(rr, 65) }
            if count_disk_nsq(rr, 325) > bc { bc = count_disk_nsq(rr, 325) }
            if bc > bestc { bestc = bc }
        }
        rr = rr + 1
    }
    return bestc
}

fn warm_cluster_rng() with Mut, Div {
    build_pool(12, 12)
    build_nbrs()
    init_disk(60)
    let _ = hillclimb(400000)
    var s = 0
    while s < 15 {
        init_random(60)
        let _ = hillclimb(400000)
        s = s + 1
    }
}

fn export_witness() with IO, Mut, Div {
    let n = 100
    let restarts = 60
    let iters = 1200000
    warm_cluster_rng()
    build_pool(12, 12)
    build_nbrs()
    init_disk(n)
    let _ = hillclimb(iters)
    save_best_mem()
    var best = total_edges()
    var s = 0
    while s < restarts {
        init_random(n)
        let _ = hillclimb(iters)
        let c = total_edges()
        if c > best { best = c; save_best_mem() }
        s = s + 1
    }
    restore_best_mem()
    let edges = total_edges()
    print("EXPORT seed="); print_int(EXPORT_SEED)
    print(" n="); print_int(n)
    print(" restarts="); print_int(restarts)
    print(" edges="); print_int(edges)
    print(" harb="); print_int(harb(n)); print("\n")
    var k = 0
    var i = 0
    while i < PN {
        if MEM[i as usize] == 1 {
            print("WITNESS "); print_int(k)
            print(" px="); print_int(PX[i as usize])
            print(" pu="); print_int(PU[i as usize])
            print(" pv="); print_int(PV[i as usize])
            print(" tag="); print_int(PTAG[i as usize]); print("\n")
            k = k + 1
        }
        i = i + 1
    }
    print("EXPORT_DONE\n")
}

fn main() -> i32 with IO, Mut, Panic, Div {
    RNG = EXPORT_SEED
    print("=== Erdos [90] unified Q(sqrt3) witness export (n=100) ===\n")
    export_witness()
    let grid = grid_best_at_n(100)
    print("grid_disk_n100_bestN_count="); print_int(grid)
    print(" harb100="); print_int(harb(100)); print("\n")
    return 0
}