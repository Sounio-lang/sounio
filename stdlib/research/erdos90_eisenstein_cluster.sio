// research::erdos90_eisenstein_cluster — heavy Eisenstein subset sweep for Slurm array
//
// Edit CLUSTER_SEED per array task (sed) before compile. Self-contained static ELF.

module research::erdos90_eisenstein_cluster

fn isqrt(n: i64) -> i64 with Mut {
    if n < 0 { return 0 }
    var r = 0
    while (r + 1) * (r + 1) <= n { r = r + 1 }
    return r
}

fn harb(n: i64) -> i64 with Mut {
    let m = 12 * n - 3
    let s = isqrt(m)
    var c = s
    if s * s < m { c = s + 1 }
    return 3 * n - c
}

fn iabs(x: i64) -> i64 { if x < 0 { return 0 - x } else { return x } }

fn hexdist(a: i64, b: i64) -> i64 {
    return (iabs(a) + iabs(b) + iabs(a + b)) / 2
}

fn axial_d2(ai: i64, bi: i64, aj: i64, bj: i64) -> i64 {
    let x = ai - aj
    let y = bi - bj
    return x * x + x * y + y * y
}

var PA: [i64; 1200] = [0; 1200]
var PB: [i64; 1200] = [0; 1200]
var PHEX: [i64; 1200] = [0; 1200]
var PN: i64 = 0
var NBR: [i64; 7200] = [0; 7200]
var NDEG: [i64; 1200] = [0; 1200]
var MEM: [i64; 1200] = [0; 1200]
var RNG: i64 = 1
var CLUSTER_SEED: i64 = 1234567

fn rng_next() -> i64 with Mut {
    RNG = (RNG * 16807) % 2147483647
    if RNG < 0 { RNG = RNG + 2147483647 }
    return RNG
}

fn build_pool_hex(R: i64) with Mut {
    PN = 0
    var a = 0 - R
    while a <= R {
        var b = 0 - R
        while b <= R {
            if hexdist(a, b) <= R {
                if PN < 1200 {
                    PA[PN as usize] = a
                    PB[PN as usize] = b
                    PHEX[PN as usize] = hexdist(a, b)
                    PN = PN + 1
                }
            }
            b = b + 1
        }
        a = a + 1
    }
}

fn build_nbrs() with Mut {
    var i = 0
    while i < PN {
        var d = 0
        var j = 0
        while j < PN {
            if j != i {
                if axial_d2(PA[i as usize], PB[i as usize], PA[j as usize], PB[j as usize]) == 1 {
                    if d < 6 { NBR[(i * 6 + d) as usize] = j; d = d + 1 }
                }
            }
            j = j + 1
        }
        NDEG[i as usize] = d
        i = i + 1
    }
}

fn mem_deg(i: i64) -> i64 with Mut {
    var c = 0
    var t = 0
    let d = NDEG[i as usize]
    while t < d {
        let nb = NBR[(i * 6 + t) as usize]
        if MEM[nb as usize] == 1 { c = c + 1 }
        t = t + 1
    }
    return c
}

fn total_edges() -> i64 with Mut {
    var s = 0
    var i = 0
    while i < PN {
        if MEM[i as usize] == 1 { s = s + mem_deg(i) }
        i = i + 1
    }
    return s / 2
}

fn clear_mem() with Mut {
    var i = 0
    while i < PN { MEM[i as usize] = 0; i = i + 1 }
}

fn init_hex_disk(n: i64) with Mut {
    clear_mem()
    var picked = 0
    var used: [i64; 1200] = [0; 1200]
    while picked < n {
        var best = 0 - 1
        var bestHex = 999999999
        var i = 0
        while i < PN {
            if used[i as usize] == 0 {
                if PHEX[i as usize] < bestHex { bestHex = PHEX[i as usize]; best = i }
            }
            i = i + 1
        }
        if best < 0 { picked = n } else {
            used[best as usize] = 1
            MEM[best as usize] = 1
            picked = picked + 1
        }
    }
}

fn init_random(n: i64) with Mut {
    clear_mem()
    var picked = 0
    while picked < n {
        let r = rng_next() % PN
        if MEM[r as usize] == 0 { MEM[r as usize] = 1; picked = picked + 1 }
    }
}

fn hillclimb(iters: i64) -> i64 with Mut, Div {
    var edges = total_edges()
    var t = 0
    while t < iters {
        let m = rng_next() % PN
        let c = rng_next() % PN
        if MEM[m as usize] == 1 && MEM[c as usize] == 0 && m != c {
            let dm = mem_deg(m)
            var adj = 0
            var u = 0
            let dd = NDEG[m as usize]
            while u < dd {
                if NBR[(m * 6 + u) as usize] == c { adj = 1 }
                u = u + 1
            }
            let dc = mem_deg(c)
            let delta = dc - adj - dm
            if delta > 0 {
                MEM[m as usize] = 0
                MEM[c as usize] = 1
                edges = edges + delta
            }
        }
        t = t + 1
    }
    return edges
}

fn run_one(R: i64, n: i64, restarts: i64, iters: i64) -> i64 with IO, Mut, Panic, Div {
    build_pool_hex(R)
    build_nbrs()
    init_hex_disk(n)
    let diskc = hillclimb(iters)
    var best = diskc
    var s = 0
    while s < restarts {
        init_random(n)
        let c = hillclimb(iters)
        if c > best { best = c }
        s = s + 1
    }
    let h = harb(n)
    print("seed="); print_int(CLUSTER_SEED)
    print(" R="); print_int(R); print(" n="); print_int(n)
    print(" restarts="); print_int(restarts)
    print(" bestHC="); print_int(best)
    print(" harb="); print_int(h)
    if best > h { print(" BEAT-HARB") } else { print(" harb-ok") }
    print("\n")
    return best
}

fn main() -> i32 with IO, Mut, Panic, Div {
    RNG = CLUSTER_SEED
    print("=== Erdos [90] Eisenstein cluster task ===\n")
    let _ = run_one(10, 100, 25, 600000)
    let _ = run_one(12, 150, 25, 600000)
    let _ = run_one(14, 200, 20, 500000)
    print("CLUSTER_DONE\n")
    return 0
}