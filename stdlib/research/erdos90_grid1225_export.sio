// research::erdos90_grid1225_export — export full 15×15 ℤ² grid witness (N=25) for Lean

module research::erdos90_grid1225_export

var GX: [i64; 1225] = [0; 1225]
var GY: [i64; 1225] = [0; 1225]
var GN: i64 = 0
var UNIT_N: i64 = 25

fn build_grid(w: i64) with Mut {
    GN = 0
    var x = 0
    while x < w {
        var y = 0
        while y < w {
            if GN < 1225 {
                GX[GN as usize] = x
                GY[GN as usize] = y
                GN = GN + 1
            }
            y = y + 1
        }
        x = x + 1
    }
}

fn unit_edge(i: i64, j: i64) -> i64 {
    let dx = GX[i as usize] - GX[j as usize]
    let dy = GY[i as usize] - GY[j as usize]
    let sq = dx * dx + dy * dy
    if sq == UNIT_N { return 1 } else { return 0 }
}

fn count_edges() -> i64 with Mut {
    var cnt = 0
    var i = 0
    while i < GN {
        var j = i + 1
        while j < GN {
            if unit_edge(i, j) == 1 { cnt = cnt + 1 }
            j = j + 1
        }
        i = i + 1
    }
    return cnt
}

fn isqrt(n: i64) -> i64 with Mut {
    if n < 0 { return 0 }
    var r = 0
    while (r + 1) * (r + 1) <= n { r = r + 1 }
    return r
}

fn harb(n: i64) -> i64 with Mut {
    let m = 12 * n - 3
    let s = isqrt(m)
    var c = s
    if s * s < m { c = s + 1 }
    return 3 * n - c
}

fn export_witness() with IO, Mut {
    build_grid(35)
    let edges = count_edges()
    print("EXPORT grid=35x35 unitN="); print_int(UNIT_N)
    print(" n="); print_int(GN)
    print(" edges="); print_int(edges)
    print(" harb="); print_int(harb(GN)); print("\n")
    var k = 0
    while k < GN {
        print("WITNESS "); print_int(k)
        print(" x="); print_int(GX[k as usize])
        print(" y="); print_int(GY[k as usize]); print("\n")
        k = k + 1
    }
    print("EXPORT_DONE\n")
}

fn main() -> i32 with IO, Mut {
    print("=== Erdos [90] Z^2 grid witness export (35x35, N=25) ===\n")
    export_witness()
    return 0
}