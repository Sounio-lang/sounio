// research::erdos90_disk225_compare — compact-disk + optimal N vs fixed-N=25 subset baseline

module research::erdos90_disk225_compare

fn isqrt(n: i64) -> i64 with Mut {
    if n < 0 { return 0 }
    var r = 0
    while (r + 1) * (r + 1) <= n { r = r + 1 }
    return r
}

fn harb(n: i64) -> i64 with Mut {
    let m = 12 * n - 3
    let s = isqrt(m)
    var c = s
    if s * s < m { c = s + 1 }
    return 3 * n - c
}

var DX: [i64; 8192] = [0; 8192]
var DY: [i64; 8192] = [0; 8192]
var DN: i64 = 0
var BESTN: i64 = 0
var BESTC: i64 = 0

fn build_disk(rr: i64) with Mut {
    DN = 0
    let R = isqrt(rr)
    var x = 0 - R
    while x <= R {
        var y = 0 - R
        while y <= R {
            if x * x + y * y <= rr {
                if DN < 8192 {
                    DX[DN as usize] = x
                    DY[DN as usize] = y
                    DN = DN + 1
                }
            }
            y = y + 1
        }
        x = x + 1
    }
}

fn count_unit(nsq: i64) -> i64 with Mut {
    var cnt = 0
    var i = 0
    while i < DN {
        var j = i + 1
        while j < DN {
            let dx = DX[i as usize] - DX[j as usize]
            let dy = DY[i as usize] - DY[j as usize]
            if dx * dx + dy * dy == nsq { cnt = cnt + 1 }
            j = j + 1
        }
        i = i + 1
    }
    return cnt
}

fn consider(nsq: i64) with Mut {
    let c = count_unit(nsq)
    if c > BESTC { BESTC = c; BESTN = nsq }
}

fn best_over_N() with Mut {
    BESTC = 0
    BESTN = 0
    consider(1)
    consider(5)
    consider(25)
    consider(65)
    consider(85)
    consider(125)
    consider(325)
    consider(425)
    consider(1105)
}

fn probe_rr(rr: i64) with IO, Mut {
    build_disk(rr)
    best_over_N()
    print("rr="); print_int(rr)
    print(" n="); print_int(DN)
    print(" harb="); print_int(harb(DN))
    print(" bestN="); print_int(BESTN)
    print(" count="); print_int(BESTC)
    if BESTC > 856 { print(" BEAT-SUBSET856") } else { print(" below-subset") }
    if BESTC > 828 { print(" BEAT-GRID828") } else { print(" below-grid") }
    print("\n")
}

fn main() -> i32 with IO, Mut {
    print("=== Erdos [90] disk+optimal-N at n~225 (Regime III, matched cardinality) ===\n")
    print("baseline n=225: grid N=25 edges=828; subset N=25 edges=856\n\n")
    var rr = 50
    while rr <= 160 {
        build_disk(rr)
        if DN >= 220 && DN <= 230 {
            best_over_N()
            print("rr="); print_int(rr)
            print(" n="); print_int(DN)
            print(" harb="); print_int(harb(DN))
            print(" bestN="); print_int(BESTN)
            print(" count="); print_int(BESTC)
            if BESTC > 856 { print(" BEAT-SUBSET856") } else { print(" below-subset856") }
            if BESTC > 828 { print(" BEAT-GRID828") } else { print(" below-grid828") }
            print("\n")
        }
        rr = rr + 1
    }
    print("DISK225_COMPARE_DONE\n")
    return 0
}