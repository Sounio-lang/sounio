// research::erdos90_search_epistemic — epistemic continuous search pilot (capability demo)
//
// Maximizes the smooth expected conformance-count over 6 point coordinates via
// stdlib/optimize/epistemic_bfgs::epistemic_ascent_maximize (parameterized objective).
// σ_d uses the runtime GUM shadow path (variance_of) — reconciled in
// tests/run-pass/erdos90_sigma_d_reconcile.sio (horizontal + diagonal cases).
//
// HONEST SCOPE: smooth epistemic SURROGATE; NOT a u(n) bound; does NOT beat the grid.

use optimize::epistemic_bfgs::*

fn sqrtf(x: f64) -> f64 with Mut { if x <= 0.0 { return 0.0 }; var r = x; var i = 0; while i < 40 { r = 0.5*(r + x/r); i = i+1 }; return r }
fn exp_approx(x: f64) -> f64 with Mut, Div {
    if x < -40.0 { return 0.0 }
    var n = 0; var t = x
    while t > 0.5 { t = t-1.0; n = n+1 }
    while t < -0.5 { t = t+1.0; n = n-1 }
    var term = 1.0; var sum = 1.0; var k = 1
    while k < 18 { term = term*t/(k as f64); sum = sum+term; k = k+1 }
    let e = 2.718281828459045; var p = 1.0; var i = 0
    if n >= 0 { while i < n { p = p*e; i = i+1 } } else { while i > n { p = p/e; i = i-1 } }
    return sum*p
}
fn erf_approx(x: f64) -> f64 with Mut, Div {
    var s = 1.0; var z = x; if z < 0.0 { s = 0.0-1.0; z = 0.0-z }
    let t = 1.0/(1.0+0.3275911*z)
    let poly = ((((1.061405429*t-1.453152027)*t)+1.421413741)*t-0.284496736)*t+0.254829592
    return s*(1.0 - poly*t*exp_approx(0.0-z*z))
}
fn phi(z: f64) -> f64 with Mut, Div { return 0.5*(1.0+erf_approx(z/1.4142135623730951)) }

fn pconf_d2(d2: f64, vd2: f64, tau: f64) -> f64 with Mut, Div {
    let d = sqrtf(d2); if d <= 0.0 { return 0.0 }
    let sigma_d = sqrtf(vd2) / (2.0 * d)
    if sigma_d <= 0.0 { if (d-1.0) < tau && (1.0-d) < tau { return 1.0 } else { return 0.0 } }
    return phi((1.0+tau-d)/sigma_d) - phi((1.0-tau-d)/sigma_d)
}

var SEARCH_SIGMA_COORD: f64 = 0.02
var SEARCH_TAU: f64 = 0.1

fn conformance_objective(x: &EpistemicParams) -> f64 with Mut, Div, Panic, Epistemic {
    var f = 0.0
    var i = 0
    while i < 6 {
        var j = i + 1
        while j < 6 {
            let ax = measure(x.values[(2*i) as usize], uncertainty: SEARCH_SIGMA_COORD)
            let ay = measure(x.values[(2*i+1) as usize], uncertainty: SEARCH_SIGMA_COORD)
            let bx = measure(x.values[(2*j) as usize], uncertainty: SEARCH_SIGMA_COORD)
            let by = measure(x.values[(2*j+1) as usize], uncertainty: SEARCH_SIGMA_COORD)
            let dx = ax.value - bx.value
            let dy = ay.value - by.value
            let d2 = dx * dx + dy * dy
            let vd2 = variance_of(d2)
            f = f + pconf_d2(d2, vd2, SEARCH_TAU)
            j = j + 1
        }
        i = i + 1
    }
    return f
}

fn main() -> i32 with IO, Mut, Div, Panic, Epistemic {
    SEARCH_SIGMA_COORD = 0.02
    SEARCH_TAU = 0.1
    var x = eparams_zeros(12)
    x.values[0]=2.05;  x.values[1]=2.00
    x.values[2]=2.95;  x.values[3]=2.05
    x.values[4]=2.55;  x.values[5]=2.80
    x.values[6]=2.45;  x.values[7]=1.20
    x.values[8]=3.40;  x.values[9]=2.60
    x.values[10]=1.60; x.values[11]=2.60
    let config = epistemic_bfgs_config_default()
    print("=== epistemic continuous search (epistemic_ascent_maximize + GUM sigma_d) ===\n")
    print("initial expected conformance count = ")
    print_f64(conformance_objective(&x))
    print("\n")
    let final = epistemic_ascent_maximize(&x, &config, conformance_objective)
    print("final   expected conformance count = ")
    print_f64(final)
    print("\n(capability demo; not a u(n) bound)\n")
    return 0
}