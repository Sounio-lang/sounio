// research::erdos90_subset1936_export — reproducible n=1936 ℤ² subset witness (N=25)

module research::erdos90_subset1936_export

fn isqrt(n: i64) -> i64 with Mut {
    if n < 0 { return 0 }
    var r = 0
    while (r + 1) * (r + 1) <= n { r = r + 1 }
    return r
}

fn harb(n: i64) -> i64 with Mut {
    let m = 12 * n - 3
    let s = isqrt(m)
    var c = s
    if s * s < m { c = s + 1 }
    return 3 * n - c
}

var PX: [i64; 2600] = [0; 2600]
var PY: [i64; 2600] = [0; 2600]
var PNORM: [i64; 2600] = [0; 2600]
var PN: i64 = 0
var NBR: [i64; 124800] = [0; 124800]
var NDEG: [i64; 2600] = [0; 2600]
var MEM: [i64; 2600] = [0; 2600]
var RNG: i64 = 1
var EXPORT_SEED: i64 = 314159
var BEST_N1936: i64 = 0
var WIN_R: i64 = 0
var TARGET_N: i64 = 1936
var TARGET_NSQ: i64 = 25
var WX: [i64; 1936] = [0; 1936]
var WY: [i64; 1936] = [0; 1936]
var WN: i64 = 0

fn rng_next() -> i64 with Mut {
    RNG = (RNG * 16807) % 2147483647
    if RNG < 0 { RNG = RNG + 2147483647 }
    return RNG
}

fn build_pool(R: i64) with Mut {
    PN = 0
    var x = 0 - R
    while x <= R {
        var y = 0 - R
        while y <= R {
            if PN < 2600 {
                PX[PN as usize] = x
                PY[PN as usize] = y
                PNORM[PN as usize] = x * x + y * y
                PN = PN + 1
            }
            y = y + 1
        }
        x = x + 1
    }
}

fn build_nbrs(nsq: i64) with Mut {
    var i = 0
    while i < PN {
        var d = 0
        var j = 0
        while j < PN {
            if j != i {
                let dx = PX[i as usize] - PX[j as usize]
                let dy = PY[i as usize] - PY[j as usize]
                if dx * dx + dy * dy == nsq {
                    if d < 48 { NBR[(i * 48 + d) as usize] = j; d = d + 1 }
                }
            }
            j = j + 1
        }
        NDEG[i as usize] = d
        i = i + 1
    }
}

fn mem_deg(i: i64) -> i64 with Mut {
    var c = 0
    var t = 0
    let d = NDEG[i as usize]
    while t < d {
        let nb = NBR[(i * 48 + t) as usize]
        if MEM[nb as usize] == 1 { c = c + 1 }
        t = t + 1
    }
    return c
}

fn total_edges() -> i64 with Mut {
    var s = 0
    var i = 0
    while i < PN {
        if MEM[i as usize] == 1 { s = s + mem_deg(i) }
        i = i + 1
    }
    return s / 2
}

fn clear_mem() with Mut {
    var i = 0
    while i < PN { MEM[i as usize] = 0; i = i + 1 }
}

fn snapshot_witness(R: i64) with Mut {
    WIN_R = R
    WN = 0
    var i = 0
    while i < PN {
        if MEM[i as usize] == 1 && WN < 1936 {
            WX[WN as usize] = PX[i as usize]
            WY[WN as usize] = PY[i as usize]
            WN = WN + 1
        }
        i = i + 1
    }
}

fn track_best_n1936(R: i64) with Mut {
    let c = total_edges()
    if c > BEST_N1936 { BEST_N1936 = c; snapshot_witness(R) }
}

fn init_disk(n: i64) with Mut {
    clear_mem()
    var picked = 0
    var used: [i64; 2600] = [0; 2600]
    while picked < n {
        var best = 0 - 1
        var bestNorm = 999999999
        var i = 0
        while i < PN {
            if used[i as usize] == 0 {
                if PNORM[i as usize] < bestNorm { bestNorm = PNORM[i as usize]; best = i }
            }
            i = i + 1
        }
        if best < 0 { picked = n } else {
            used[best as usize] = 1
            MEM[best as usize] = 1
            picked = picked + 1
        }
    }
}

fn init_random(n: i64) with Mut {
    clear_mem()
    var picked = 0
    while picked < n {
        let r = rng_next() % PN
        if MEM[r as usize] == 0 { MEM[r as usize] = 1; picked = picked + 1 }
    }
}

fn hillclimb(iters: i64) -> i64 with Mut, Div {
    var edges = total_edges()
    var t = 0
    while t < iters {
        let m = rng_next() % PN
        let c = rng_next() % PN
        if MEM[m as usize] == 1 && MEM[c as usize] == 0 && m != c {
            let dm = mem_deg(m)
            var adj = 0
            var u = 0
            let dd = NDEG[m as usize]
            while u < dd {
                if NBR[(m * 48 + u) as usize] == c { adj = 1 }
                u = u + 1
            }
            let dc = mem_deg(c)
            let delta = dc - adj - dm
            if delta > 0 {
                MEM[m as usize] = 0
                MEM[c as usize] = 1
                edges = edges + delta
            }
        }
        t = t + 1
    }
    return edges
}

fn run_one(R: i64, nsq: i64, n: i64, restarts: i64, iters: i64) -> i64 with Mut, Panic, Div {
    build_pool(R)
    build_nbrs(nsq)
    init_disk(n)
    let diskc = hillclimb(iters)
    var best = diskc
    if n == TARGET_N { track_best_n1936(R) }
    var s = 0
    while s < restarts {
        init_random(n)
        let c = hillclimb(iters)
        if c > best { best = c }
        if n == TARGET_N { track_best_n1936(R) }
        s = s + 1
    }
    return best
}

fn export_witness() with IO, Mut, Panic, Div {
    BEST_N1936 = 0
    let _ = run_one(22, TARGET_NSQ, TARGET_N, 40, 800000)
    let _ = run_one(24, TARGET_NSQ, TARGET_N, 60, 1200000)
    let _ = run_one(26, TARGET_NSQ, TARGET_N, 60, 1200000)
    print("EXPORT seed="); print_int(EXPORT_SEED)
    print(" winR="); print_int(WIN_R)
    print(" unitN="); print_int(TARGET_NSQ)
    print(" n="); print_int(WN)
    print(" edges="); print_int(BEST_N1936)
    print(" harb="); print_int(harb(TARGET_N))
    print(" grid44x44=9992\n")
    var k = 0
    while k < WN {
        print("WITNESS "); print_int(k)
        print(" x="); print_int(WX[k as usize])
        print(" y="); print_int(WY[k as usize]); print("\n")
        k = k + 1
    }
    print("EXPORT_DONE\n")
}

fn main() -> i32 with IO, Mut, Panic, Div {
    RNG = EXPORT_SEED
    print("=== Erdos [90] Z^2 subset witness export (n=1936, N=25) ===\n")
    export_witness()
    return 0
}