// research::erdos90_disk225_export — compact disk rr=72, n=225, N=25 witness for Lean

module research::erdos90_disk225_export

var DX: [i64; 225] = [0; 225]
var DY: [i64; 225] = [0; 225]
var DN: i64 = 0
var UNIT_N: i64 = 25
var DISK_RR: i64 = 72

fn isqrt(n: i64) -> i64 with Mut {
    if n < 0 { return 0 }
    var r = 0
    while (r + 1) * (r + 1) <= n { r = r + 1 }
    return r
}

fn harb(n: i64) -> i64 with Mut {
    let m = 12 * n - 3
    let s = isqrt(m)
    var c = s
    if s * s < m { c = s + 1 }
    return 3 * n - c
}

fn build_disk(rr: i64) with Mut {
    DN = 0
    let R = isqrt(rr)
    var x = 0 - R
    while x <= R {
        var y = 0 - R
        while y <= R {
            if x * x + y * y <= rr {
                if DN < 225 {
                    DX[DN as usize] = x
                    DY[DN as usize] = y
                    DN = DN + 1
                }
            }
            y = y + 1
        }
        x = x + 1
    }
}

fn unit_edge(i: i64, j: i64) -> i64 {
    let dx = DX[i as usize] - DX[j as usize]
    let dy = DY[i as usize] - DY[j as usize]
    let sq = dx * dx + dy * dy
    if sq == UNIT_N { return 1 } else { return 0 }
}

fn count_edges() -> i64 with Mut {
    var cnt = 0
    var i = 0
    while i < DN {
        var j = i + 1
        while j < DN {
            if unit_edge(i, j) == 1 { cnt = cnt + 1 }
            j = j + 1
        }
        i = i + 1
    }
    return cnt
}

fn export_witness() with IO, Mut {
    build_disk(DISK_RR)
    let edges = count_edges()
    print("EXPORT disk rr="); print_int(DISK_RR)
    print(" unitN="); print_int(UNIT_N)
    print(" n="); print_int(DN)
    print(" edges="); print_int(edges)
    print(" harb="); print_int(harb(DN))
    print(" grid15x15=828 subset856=856\n")
    var k = 0
    while k < DN {
        print("WITNESS "); print_int(k)
        print(" x="); print_int(DX[k as usize])
        print(" y="); print_int(DY[k as usize]); print("\n")
        k = k + 1
    }
    print("EXPORT_DONE\n")
}

fn main() -> i32 with IO, Mut {
    print("=== Erdos [90] compact disk witness export (rr=72, n=225, N=25) ===\n")
    export_witness()
    return 0
}