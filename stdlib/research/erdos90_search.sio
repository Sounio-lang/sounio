// research::erdos90_search — Erdős [90] planar unit-distance search (CPU pilot)
//
// Stage-2 pilot for docs/research/erdos-90-planar-search-plan.md.
// Baseline (verified, Lean SounioErdos90PlanarLowerBound): the triangular
// NEAREST-NEIGHBOUR lattice gives u(n) >= harb(n) = floor(3n - sqrt(12n-3)) ~ 3n.
//
// This pilot asks: does the Erdős GRID construction beat that? Take an n = W*W
// point square region of Z^2 and choose the unit distance^2 = N to be a value
// with MANY representations as a sum of two squares (r2(N) > 6). Then interior
// points have r2(N) unit-neighbours, so the unit-distance count ~ (r2(N)/2)*n,
// which exceeds 3n once r2(N) > 6 (e.g. N=25 -> 12 neighbours, N=65 -> 16).
//
// All exact integer arithmetic: an edge is dx*dx + dy*dy == N. Any config a
// search reports is re-certifiable in Lean (countUnit / native_decide).
//
// Self-contained (no imports), with a main, so `souc run` executes it directly.

module research::erdos90_search

fn isqrt(n: i64) -> i64 {
    if n < 0 { return 0 }
    var r = 0
    while (r + 1) * (r + 1) <= n { r = r + 1 }
    return r
}

// Harborth triangular-NN lattice bound: floor(3n - sqrt(12n - 3))
fn harb(n: i64) -> i64 {
    let m = 12 * n - 3
    let s = isqrt(m)
    var c = s
    if s * s < m { c = s + 1 }
    return 3 * n - c
}

// W*W grid points (flat), W <= 16 so n <= 256
var GX: [i64; 256] = [0; 256]
var GY: [i64; 256] = [0; 256]
var GN: i64 = 0

fn build_grid(w: i64) with Mut {
    GN = 0
    var x = 0
    while x < w {
        var y = 0
        while y < w {
            GX[GN as usize] = x
            GY[GN as usize] = y
            GN = GN + 1
            y = y + 1
        }
        x = x + 1
    }
}

// number of unordered pairs at squared distance == nsq
fn count_unit(nsq: i64) -> i64 with Mut {
    var cnt = 0
    var i = 0
    while i < GN {
        var j = i + 1
        while j < GN {
            let dx = GX[i as usize] - GX[j as usize]
            let dy = GY[i as usize] - GY[j as usize]
            if dx * dx + dy * dy == nsq { cnt = cnt + 1 }
            j = j + 1
        }
        i = i + 1
    }
    return cnt
}

// candidate unit-distance^2 values (varying r2(N)); 1=NN(4), 5(8), 25(12), 65(16), 325(...)
var NCAND: [i64; 12] = [1, 2, 5, 10, 13, 25, 50, 65, 85, 125, 169, 325]
var NCN: i64 = 12

// best grid count over candidate N for the current grid; also report which N
fn best_grid_count(out_bestN: &! i64) -> i64 with Mut {
    var best = 0
    var bestN = 0
    var t = 0
    while t < NCN {
        let nsq = NCAND[t as usize]
        let c = count_unit(nsq)
        if c > best { best = c; bestN = nsq }
        t = t + 1
    }
    *out_bestN = bestN
    return best
}

pub fn run_pilot() -> i64 with IO, Mut, Panic, Div {
    print("=== Erdos [90] planar unit-distance pilot: grid vs triangular harb(n) ===\n")
    print("n=W*W points in a WxW Z^2 grid; unit^2=N chosen for many sum-of-2-squares reps.\n")
    print("cols: n  harb(n)~3n(triangular NN)  bestGrid  bestN  grid_beats_harb?\n")
    var beats = 0
    var w = 3
    while w <= 16 {
        build_grid(w)
        let n = w * w
        var bestN = 0
        let g = best_grid_count(&! bestN)
        let h = harb(n)
        print("n="); print_int(n)
        print("  harb="); print_int(h)
        print("  grid="); print_int(g)
        print("  N="); print_int(bestN)
        if g > h { print("  BEAT\n"); beats = beats + 1 }
        else { print("  -\n") }
        w = w + 1
    }
    print("grid configurations beating the triangular harb(n) baseline: ")
    print_int(beats); print("\n")
    return beats
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let beats = run_pilot()
    if beats > 0 {
        print("RESULT: explicit exact grid configs exceed the triangular NN lattice ")
        print("for some n (u(n) > harb(n) there) — re-certifiable in Lean.\n")
    } else {
        print("RESULT: no grid config beat harb(n) in the searched range.\n")
    }
    return 0
}
