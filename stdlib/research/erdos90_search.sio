// research::erdos90_search — Erdős [90] planar unit-distance search (CPU pilot)
//
// Stage-2 pilot for docs/research/erdos-90-planar-search-plan.md.
// Baseline (verified in Lean SounioErdos90PlanarLowerBound): the triangular
// NEAREST-NEIGHBOUR lattice gives u(n) >= harb(n) = floor(3n - sqrt(12n-3)) ~ 3n.
//
// Question: does the Erdős GRID construction beat that? Take n = W*W points of a
// WxW square region of Z^2 and choose unit distance^2 = N with MANY sum-of-two-
// squares representations r2(N). Interior points then have r2(N) unit-neighbours,
// so the unit-distance count ~ (r2(N)/2)*n, which exceeds 3n once r2(N) > 6
// (N=25 -> 12, N=65 -> 16). The advantage needs W >> sqrt(N) (small boundary).
//
// Exact integer arithmetic: an edge is dx*dx + dy*dy == N. Any reported config is
// re-certifiable in Lean. Self-contained, with main; run with `souc run`.

fn isqrt(n: i64) -> i64 with Mut {
    if n < 0 { return 0 }
    var r = 0
    while (r + 1) * (r + 1) <= n { r = r + 1 }
    return r
}

fn harb(n: i64) -> i64 with Mut {
    let m = 12 * n - 3
    let s = isqrt(m)
    var c = s
    if s * s < m { c = s + 1 }
    return 3 * n - c
}

var GN: i64 = 0
var BESTN: i64 = 0

fn build_grid(w: i64, GX: [i64; 3025], GY: [i64; 3025]) with Mut {
    GN = 0
    var x = 0
    while x < w {
        var y = 0
        while y < w {
            GX[GN as usize] = x
            GY[GN as usize] = y
            GN = GN + 1
            y = y + 1
        }
        x = x + 1
    }
}

fn count_unit(nsq: i64, GX: [i64; 3025], GY: [i64; 3025]) -> i64 with Mut {
    var cnt = 0
    var i = 0
    while i < GN {
        var j = i + 1
        while j < GN {
            let dx = GX[i as usize] - GX[j as usize]
            let dy = GY[i as usize] - GY[j as usize]
            if dx * dx + dy * dy == nsq { cnt = cnt + 1 }
            j = j + 1
        }
        i = i + 1
    }
    return cnt
}

var BESTBEST: i64 = 0

fn best_grid_count(GX: [i64; 3025], GY: [i64; 3025]) -> i64 with Mut {
    BESTBEST = 0
    BESTN = 0
    consider(1, GX, GY)
    consider(5, GX, GY)
    consider(25, GX, GY)
    consider(65, GX, GY)
    consider(85, GX, GY)
    consider(125, GX, GY)
    consider(325, GX, GY)
    consider(1105, GX, GY)
    return BESTBEST
}

fn consider(nsq: i64, GX: [i64; 3025], GY: [i64; 3025]) with Mut {
    let c = count_unit(nsq, GX, GY)
    if c > BESTBEST { BESTBEST = c; BESTN = nsq }
}

fn run_pilot() -> i64 with IO, Mut, Panic, Div {
    print("=== Erdos [90] planar pilot: Z^2 grid (many-rep distance) vs triangular harb(n) ===\n")
    print("cols: n  harb(n)~3n  bestGrid  bestN(unit^2)  grid_beats_harb?\n")
    var GX: [i64; 3025] = [0; 3025]
    var GY: [i64; 3025] = [0; 3025]
    var beats = 0
    var w = 5
    while w <= 55 {
        build_grid(w, GX, GY)
        let n = w * w
        let g = best_grid_count(GX, GY)
        let h = harb(n)
        print("n="); print_int(n)
        print("  harb="); print_int(h)
        print("  grid="); print_int(g)
        print("  N="); print_int(BESTN)
        if g > h { print("  BEAT\n"); beats = beats + 1 }
        else { print("  -\n") }
        w = w + 10
    }
    print("grid configs beating triangular harb(n): "); print_int(beats); print("\n")
    return beats
}

fn main() with IO, Mut, Panic, Div {
    let beats = run_pilot()
    if beats > 0 {
        print("RESULT: explicit exact Z^2 grid configs exceed the triangular NN lattice ")
        print("for some n (u(n) > harb(n) there) -- re-certifiable in Lean.\n")
    } else {
        print("RESULT: no grid config beat harb(n) in the searched range.\n")
    }
}
