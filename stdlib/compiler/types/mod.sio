// compiler::types module entry point
//
// Re-exports core type system types for the self-hosted compiler.
// The module loader resolves `use compiler::types` to this file.

// TypeId: unique identifier for a type in the type pool
struct TypeId {
    value: i64,
}

fn type_id_new(v: i64) -> TypeId {
    TypeId { value: v }
}

fn type_id_from_kind(kind: i32) -> TypeId {
    TypeId { value: kind as i64 }
}

// TypeVar: type variable for polymorphism and unification
struct TypeVar {
    id: i64,
}

fn type_var_new(id: i64) -> TypeVar {
    TypeVar { id: id }
}

fn type_var_fresh(counter: &!i64) -> TypeVar {
    let id = *counter
    *counter = *counter + 1
    TypeVar { id: id }
}
