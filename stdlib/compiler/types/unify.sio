// ============================================================================
// UNIFICATION
// ============================================================================

struct UnifyState {
    pool: TypePool,
    subst: Substitution,
    errors: [UnifyResult; 32],
    n_errors: i64,
}

fn unify_state_new(pool: TypePool) -> UnifyState {
    // TODO: Initialize UnifyState with given pool and empty substitution/errors
    UnifyState { pool: pool, subst: subst_new(), errors: [unify_ok(); 32], n_errors: 0 }
}

// Main unification function
// Returns updated state with substitution or error
