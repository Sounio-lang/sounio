// stdlib/compiler/types/type.sio
// Core Type enum representation (struct + kind constants pattern)
// ============================================================================

// Type kind constants - must match Rust compiler/src/types/core.rs
fn TYPE_UNKNOWN() -> i32 { 0 }
fn TYPE_UNIT() -> i32 { 1 }
fn TYPE_BOOL() -> i32 { 2 }
fn TYPE_I8() -> i32 { 3 }
fn TYPE_I16() -> i32 { 4 }
fn TYPE_I32() -> i32 { 5 }
fn TYPE_I64() -> i32 { 6 }
fn TYPE_I128() -> i32 { 7 }
fn TYPE_ISIZE() -> i32 { 8 }
fn TYPE_U8() -> i32 { 9 }
fn TYPE_U16() -> i32 { 10 }
fn TYPE_U32() -> i32 { 11 }
fn TYPE_U64() -> i32 { 12 }
fn TYPE_U128() -> i32 { 13 }
fn TYPE_USIZE() -> i32 { 14 }
fn TYPE_F32() -> i32 { 15 }
fn TYPE_F64() -> i32 { 16 }
fn TYPE_CHAR() -> i32 { 17 }
fn TYPE_STR() -> i32 { 18 }
fn TYPE_STRING() -> i32 { 19 }

// Linear algebra types (kinds 30-37)
fn TYPE_VEC2() -> i32 { 30 }
fn TYPE_VEC3() -> i32 { 31 }
fn TYPE_VEC4() -> i32 { 32 }
fn TYPE_MAT2() -> i32 { 33 }
fn TYPE_MAT3() -> i32 { 34 }
fn TYPE_MAT4() -> i32 { 35 }
fn TYPE_QUAT() -> i32 { 36 }
fn TYPE_DUAL() -> i32 { 37 }

// Compound types (kinds 40-50)
fn TYPE_REF() -> i32 { 40 }
fn TYPE_RAW_POINTER() -> i32 { 41 }
fn TYPE_ARRAY() -> i32 { 42 }
fn TYPE_SLICE() -> i32 { 43 }
fn TYPE_TUPLE() -> i32 { 44 }
fn TYPE_FUNCTION() -> i32 { 45 }
fn TYPE_NAMED() -> i32 { 46 }

// Epistemic/Scientific types (kinds 60-70)
fn TYPE_QUANTITY() -> i32 { 60 }
fn TYPE_ONTOLOGY() -> i32 { 61 }
fn TYPE_KNOWLEDGE() -> i32 { 62 }
fn TYPE_TENSOR() -> i32 { 63 }
fn TYPE_FUTURE() -> i32 { 64 }

// Polymorphism (kinds 80-85)
fn TYPE_VAR() -> i32 { 80 }
fn TYPE_FORALL() -> i32 { 81 }

// Special types (kinds 90-95)
fn TYPE_NEVER() -> i32 { 90 }
fn TYPE_ERROR() -> i32 { 91 }

// Error type constructor (for error recovery)
fn type_error() -> Type {
    Type {
        kind: TYPE_ERROR(),
        inner_idx: -1,
        is_mutable: false,
        array_size: 0,
        name: [0; 64],
        name_len: 0,
        type_args: [0; 8],
        n_args: 0,
        param_types: [0; 16],
        n_params: 0,
        return_type_idx: -1,
        effect_set: 0,
        unit_suffix: [0; 32],
        unit_suffix_len: 0,
        epsilon: 0.0,
        provenance: 0,
        var_id: -1,
        tensor_dims: [0; 8],
        n_dims: 0,
    }
}
fn TYPE_SELF() -> i32 { 92 }

// ============================================================================
// Main Type struct
// ============================================================================

struct Type {
    kind: i32,

    // Reference/pointer inner type (index into type pool)
    inner_idx: i64,
    is_mutable: bool,

    // Array/slice metadata
    array_size: i64,  // -1 for slice, 0 for inferred size

    // Named type metadata
    name: [i8; 64],
    name_len: i64,

    // Generic type arguments
    type_args: [i64; 8],
    n_args: i64,

    // Function type metadata
    param_types: [i64; 16],
    n_params: i64,
    return_type_idx: i64,
    effect_set: i64,  // Bitmask for effect tracking

    // Quantity type metadata
    unit_suffix: [i8; 32],
    unit_suffix_len: i64,

    // Knowledge type metadata
    epsilon: f64,
    provenance: i32,

    // Type variable metadata
    var_id: i64,

    // Tensor metadata
    tensor_dims: [i64; 8],
    n_dims: i64,
}

// ============================================================================
// Type pool for allocation and interning
// ============================================================================

struct TypePool {
    types: [Type; 256],
    count: i64,
}

fn type_pool_new() -> TypePool with Mut {
    var pool: TypePool;
    pool.count = 0;
    pool
}

fn type_pool_add(pool: &!TypePool, t: Type) -> i64 with Mut, Panic {
    var idx: i64 = pool.count;
    if idx >= 256 {
        // Pool full - in real implementation, would allocate new pool
        return -1;
    }
    pool.types[idx as usize] = t;
    pool.count = idx + 1;
    idx
}

fn type_pool_get(pool: &!TypePool, idx: i64) -> Type with Panic {
    if idx < 0 || idx >= pool.count {
        // Return error type for out-of-bounds
        return type_error();
    }
    pool.types[idx as usize]
}

