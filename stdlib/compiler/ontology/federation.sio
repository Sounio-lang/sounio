// stdlib/compiler/ontology/federation.sio
//
// Conservative Phase 1 federation hook. The live network-backed federation is
// implemented in sounio-py and reused from Jupyter. The compiler source keeps
// the contract explicit and fail-closed.

pub(crate) fn ontology_mode_allows_federation(mode: string) -> bool {
    mode == "hybrid" || mode == "federated"
}

pub(crate) fn ontology_federated_resolve(curie: string, config: OntologyConfig) -> ResolvedOntologyTerm {
    let _curie = curie
    let _config = config
    ontology_term_empty()
}

pub(crate) fn ontology_federated_search(query: string, config: OntologyConfig) -> ResolvedOntologyTermList {
    let _query = query
    let _config = config
    ontology_term_list_new()
}
