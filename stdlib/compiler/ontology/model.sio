// stdlib/compiler/ontology/model.sio
//
// Canonical ontology model for compiler-facing resolution.

pub struct ResolvedOntologyTerm {
    pub curie: string,
    pub label: string,
    pub definition: string,
    pub parents: [string; 8],
    pub parents_len: i64,
    pub synonyms: [string; 8],
    pub synonyms_len: i64,
    pub source_layer: string,
    pub iri: string,
    pub mapping_confidence: f64,
    pub provenance: string,
}

pub struct ResolvedOntologyTermList {
    pub items: [ResolvedOntologyTerm; 16],
    pub len: i64,
}

pub struct OntologyMapping {
    pub subject_id: string,
    pub predicate: string,
    pub object_id: string,
    pub confidence: f64,
    pub justification: string,
}

pub struct OntologyMappingList {
    pub items: [OntologyMapping; 16],
    pub len: i64,
}

pub struct OntologyConfig {
    pub home: string,
    pub mode: string,
    pub cache_dir: string,
    pub bioportal_api_key: string,
    pub ols4_base_url: string,
}

pub(crate) fn ontology_term_empty() -> ResolvedOntologyTerm {
    ResolvedOntologyTerm {
        curie: "",
        label: "",
        definition: "",
        parents: [""; 8],
        parents_len: 0,
        synonyms: [""; 8],
        synonyms_len: 0,
        source_layer: "",
        iri: "",
        mapping_confidence: 0.0,
        provenance: "",
    }
}

pub(crate) fn ontology_term_list_new() -> ResolvedOntologyTermList {
    ResolvedOntologyTermList {
        items: [ontology_term_empty(); 16],
        len: 0,
    }
}

fn ontology_mapping_empty() -> OntologyMapping {
    OntologyMapping {
        subject_id: "",
        predicate: "",
        object_id: "",
        confidence: 0.0,
        justification: "",
    }
}

pub(crate) fn ontology_mapping_list_new() -> OntologyMappingList {
    OntologyMappingList {
        items: [ontology_mapping_empty(); 16],
        len: 0,
    }
}

pub(crate) fn ontology_term_found(term: ResolvedOntologyTerm) -> bool {
    str_len(term.curie) > 0
}

pub(crate) fn ontology_term_add_parent(term: ResolvedOntologyTerm, parent: string) -> ResolvedOntologyTerm {
    var out = term
    if out.parents_len < 8 {
        out.parents[out.parents_len as usize] = parent
        out.parents_len = out.parents_len + 1
    }
    out
}

pub(crate) fn ontology_term_add_synonym(term: ResolvedOntologyTerm, synonym: string) -> ResolvedOntologyTerm {
    var out = term
    if out.synonyms_len < 8 {
        out.synonyms[out.synonyms_len as usize] = synonym
        out.synonyms_len = out.synonyms_len + 1
    }
    out
}

pub(crate) fn ontology_term_list_push(lst: ResolvedOntologyTermList, term: ResolvedOntologyTerm) -> ResolvedOntologyTermList {
    var out = lst
    if out.len < 16 {
        out.items[out.len as usize] = term
        out.len = out.len + 1
    }
    out
}

pub(crate) fn ontology_mapping_list_push(lst: OntologyMappingList, mapping: OntologyMapping) -> OntologyMappingList {
    var out = lst
    if out.len < 16 {
        out.items[out.len as usize] = mapping
        out.len = out.len + 1
    }
    out
}

fn ontology_config_default() -> OntologyConfig {
    OntologyConfig {
        home: "data/ontology/bundles",
        mode: "hybrid",
        cache_dir: "data/ontology/cache",
        bioportal_api_key: "",
        ols4_base_url: "",
    }
}
