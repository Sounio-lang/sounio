// stdlib/compiler/ontology/mod.sio
//
// Public compiler-facing ontology facade.

module ontology

use compiler::ontology::model::*
use compiler::ontology::mapping::*
use compiler::ontology::cache::*
use compiler::ontology::federation::*
use compiler::ontology::resolver::*
use compiler::ontology::store::*

fn ontology_is_supported_prefix(raw: string) -> bool {
    starts_with(raw, "SNOMED:") ||
    starts_with(raw, "LOINC:") ||
    starts_with(raw, "HPO:") ||
    starts_with(raw, "GO:") ||
    starts_with(raw, "CHEBI:")
}

fn ontology_curie_literal_valid(raw: string) -> bool {
    if !ontology_is_supported_prefix(raw) {
        return false
    }
    let len = str_len(raw)
    len > 4
}

pub(crate) fn ontology_resolve_curie(curie: string) -> ResolvedOntologyTerm {
    ontology_resolve(curie)
}

pub(crate) fn ontology_search_text(query: string) -> ResolvedOntologyTermList {
    ontology_search(query)
}

pub(crate) fn ontology_ancestor_terms(curie: string) -> ResolvedOntologyTermList {
    ontology_ancestors(curie)
}

pub(crate) fn ontology_is_subclass_of(child: string, parent: string) -> bool {
    ontology_is_subclass(child, parent)
}

pub(crate) fn ontology_map_to(source_curie: string, target_ontology: string) -> OntologyMappingList {
    ontology_map_term(source_curie, target_ontology)
}

pub(crate) fn ontology_print_term(term: ResolvedOntologyTerm) with IO {
    if !ontology_term_found(term) {
        println("unresolved")
        return
    }
    println("curie=" + term.curie)
    println("label=" + term.label)
    println("definition=" + term.definition)
    println("source_layer=" + term.source_layer)
    println("iri=" + term.iri)
    println("provenance=" + term.provenance)
}

pub(crate) fn ontology_print_search_results(results: ResolvedOntologyTermList) with IO, Mut, Panic, Div {
    var i: i64 = 0
    while i < results.len {
        let term = results.items[i as usize]
        println(term.curie + " | " + term.label + " | " + term.provenance)
        i = i + 1
    }
}

pub(crate) fn ontology_print_mappings(mappings: OntologyMappingList) with IO, Mut, Panic, Div {
    var i: i64 = 0
    while i < mappings.len {
        let item = mappings.items[i as usize]
        println(item.subject_id + " -> " + item.object_id + " | " + item.predicate)
        i = i + 1
    }
}
