// stdlib/compiler/ontology/cache.sio
//
// Phase 1 cache surface. The persistent on-disk implementation is provided in
// the Python/Jupyter integration, while the compiler source owns the config
// contract and negative-result sentinel behavior.

fn ontology_default_home() -> string { "data/ontology/bundles" }
fn ontology_default_mode() -> string { "hybrid" }
fn ontology_default_cache_dir() -> string { "data/ontology/cache" }

pub(crate) fn ontology_cache_config() -> OntologyConfig {
    OntologyConfig {
        home: ontology_default_home(),
        mode: ontology_default_mode(),
        cache_dir: ontology_default_cache_dir(),
        bioportal_api_key: "",
        ols4_base_url: "",
    }
}

pub(crate) fn ontology_cache_negative(curie: string) -> ResolvedOntologyTerm {
    let t = ontology_term_empty()
    t
}
