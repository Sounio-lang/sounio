// stdlib/compiler/ontology/mapping.sio
//
// SSSOM-like mapping slice for the clinical notebook demo.

fn ontology_mapping_make(
    subject_id: string,
    predicate: string,
    object_id: string,
    confidence: f64,
    justification: string
) -> OntologyMapping {
    OntologyMapping {
        subject_id: subject_id,
        predicate: predicate,
        object_id: object_id,
        confidence: confidence,
        justification: justification,
    }
}

pub(crate) fn ontology_map_term_local(source_curie: string, to_ontology: string) -> OntologyMappingList {
    var out = ontology_mapping_list_new()
    if source_curie == "SNOMED:44054006" && to_ontology == "HPO" {
        return ontology_mapping_list_push(
            out,
            ontology_mapping_make(
                "SNOMED:44054006",
                "closeMatch",
                "HPO:0005978",
                0.72,
                "Clinical diagnosis aligns with glucose homeostasis abnormality."
            )
        )
    }
    if source_curie == "HPO:0003074" && to_ontology == "GO" {
        return ontology_mapping_list_push(
            out,
            ontology_mapping_make(
                "HPO:0003074",
                "exactMatch",
                "GO:0042593",
                0.91,
                "Hyperglycemia maps to glucose homeostasis."
            )
        )
    }
    if source_curie == "HPO:0003074" && to_ontology == "CHEBI" {
        return ontology_mapping_list_push(
            out,
            ontology_mapping_make(
                "HPO:0003074",
                "relatedMatch",
                "CHEBI:17234",
                0.66,
                "Hyperglycemia concerns excess blood glucose."
            )
        )
    }
    if source_curie == "LOINC:4548-4" && to_ontology == "HPO" {
        return ontology_mapping_list_push(
            out,
            ontology_mapping_make(
                "LOINC:4548-4",
                "closeMatch",
                "HPO:0005978",
                0.61,
                "HbA1c observes glucose homeostasis."
            )
        )
    }
    if source_curie == "SNOMED:44054006" && to_ontology == "CHEBI" {
        return ontology_mapping_list_push(
            out,
            ontology_mapping_make(
                "SNOMED:44054006",
                "relatedMatch",
                "CHEBI:6801",
                0.70,
                "Metformin is a canonical therapeutic agent for type 2 diabetes."
            )
        )
    }
    out
}
