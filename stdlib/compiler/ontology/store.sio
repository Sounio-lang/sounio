// stdlib/compiler/ontology/store.sio
//
// Phase 1 local biomedical slice derived from bundled .dontology shards.

fn ontology_store_make(
    curie: string,
    label: string,
    definition: string,
    iri: string,
    provenance: string
) -> ResolvedOntologyTerm {
    ResolvedOntologyTerm {
        curie: curie,
        label: label,
        definition: definition,
        parents: [""; 8],
        parents_len: 0,
        synonyms: [""; 8],
        synonyms_len: 0,
        source_layer: "local",
        iri: iri,
        mapping_confidence: 1.0,
        provenance: provenance,
    }
}

pub(crate) fn ontology_store_resolve_local(curie: string) -> ResolvedOntologyTerm {
    if curie == "SNOMED:138875005" {
        let t = ontology_store_make(
            "SNOMED:138875005",
            "SNOMED CT Concept",
            "Top-level root concept for the local SNOMED slice.",
            "http://snomed.info/id/138875005",
            "local:snomed"
        )
        return ontology_term_add_synonym(t, "SNOMED root")
    }
    if curie == "SNOMED:73211009" {
        let t0 = ontology_store_make(
            "SNOMED:73211009",
            "Diabetes mellitus",
            "General diabetes mellitus diagnosis in the clinical slice.",
            "http://snomed.info/id/73211009",
            "local:snomed"
        )
        let t1 = ontology_term_add_parent(t0, "SNOMED:138875005")
        return ontology_term_add_synonym(t1, "Diabetes")
    }
    if curie == "SNOMED:44054006" {
        let t0 = ontology_store_make(
            "SNOMED:44054006",
            "Type 2 diabetes mellitus",
            "Type 2 diabetes mellitus diagnosis used in the clinical demo.",
            "http://snomed.info/id/44054006",
            "local:snomed"
        )
        let t1 = ontology_term_add_parent(t0, "SNOMED:73211009")
        return ontology_term_add_synonym(t1, "T2DM")
    }
    if curie == "LOINC:4548-4" {
        let t0 = ontology_store_make(
            "LOINC:4548-4",
            "Hemoglobin A1c/Hemoglobin.total in Blood",
            "Clinical lab code for HbA1c.",
            "https://loinc.org/4548-4",
            "local:loinc"
        )
        return ontology_term_add_synonym(t0, "HbA1c")
    }
    if curie == "LOINC:1558-6" {
        let t0 = ontology_store_make(
            "LOINC:1558-6",
            "Glucose [Moles/volume] in Blood",
            "Clinical lab code for blood glucose concentration.",
            "https://loinc.org/1558-6",
            "local:loinc"
        )
        return ontology_term_add_synonym(t0, "Blood glucose")
    }
    if curie == "HPO:0000118" {
        let t0 = ontology_store_make(
            "HPO:0000118",
            "Phenotypic abnormality",
            "Root phenotype abnormality concept in the HPO slice.",
            "http://purl.obolibrary.org/obo/HP_0000118",
            "local:hpo"
        )
        return ontology_term_add_synonym(t0, "HPO root")
    }
    if curie == "HPO:0005978" {
        let t0 = ontology_store_make(
            "HPO:0005978",
            "Abnormality of glucose homeostasis",
            "Bridge phenotype used between clinical and discovery contexts.",
            "http://purl.obolibrary.org/obo/HP_0005978",
            "local:hpo"
        )
        let t1 = ontology_term_add_parent(t0, "HPO:0000118")
        return ontology_term_add_synonym(t1, "Glucose homeostasis abnormality")
    }
    if curie == "HPO:0003074" {
        let t0 = ontology_store_make(
            "HPO:0003074",
            "Hyperglycemia",
            "Phenotype for elevated glucose used in the clinical notebook demo.",
            "http://purl.obolibrary.org/obo/HP_0003074",
            "local:hpo"
        )
        let t1 = ontology_term_add_parent(t0, "HPO:0005978")
        return ontology_term_add_synonym(t1, "High blood glucose")
    }
    if curie == "GO:0008150" {
        return ontology_store_make(
            "GO:0008150",
            "biological_process",
            "Root biological process term in the GO slice.",
            "http://purl.obolibrary.org/obo/GO_0008150",
            "local:go"
        )
    }
    if curie == "GO:0042593" {
        let t0 = ontology_store_make(
            "GO:0042593",
            "glucose homeostasis",
            "Biological process maintaining glucose homeostasis.",
            "http://purl.obolibrary.org/obo/GO_0042593",
            "local:go"
        )
        let t1 = ontology_term_add_parent(t0, "GO:0008150")
        return ontology_term_add_synonym(t1, "Glucose regulation")
    }
    if curie == "GO:0006006" {
        let t0 = ontology_store_make(
            "GO:0006006",
            "glucose metabolic process",
            "Glucose metabolic process in the GO demo slice.",
            "http://purl.obolibrary.org/obo/GO_0006006",
            "local:go"
        )
        return ontology_term_add_parent(t0, "GO:0042593")
    }
    if curie == "CHEBI:24431" {
        return ontology_store_make(
            "CHEBI:24431",
            "chemical entity",
            "Root chemical entity term in the ChEBI slice.",
            "http://purl.obolibrary.org/obo/CHEBI_24431",
            "local:chebi"
        )
    }
    if curie == "CHEBI:17234" {
        let t0 = ontology_store_make(
            "CHEBI:17234",
            "glucose",
            "ChEBI glucose concept for discovery-side mapping.",
            "http://purl.obolibrary.org/obo/CHEBI_17234",
            "local:chebi"
        )
        return ontology_term_add_parent(t0, "CHEBI:24431")
    }
    if curie == "CHEBI:6801" {
        let t0 = ontology_store_make(
            "CHEBI:6801",
            "metformin",
            "ChEBI metformin concept used for therapeutic linking.",
            "http://purl.obolibrary.org/obo/CHEBI_6801",
            "local:chebi"
        )
        return ontology_term_add_parent(t0, "CHEBI:24431")
    }
    ontology_term_empty()
}

pub(crate) fn ontology_store_search_local(query: string) -> ResolvedOntologyTermList {
    var out = ontology_term_list_new()
    if starts_with(query, "glucose") || starts_with(query, "Glucose") {
        out = ontology_term_list_push(out, ontology_store_resolve_local("LOINC:1558-6"))
        out = ontology_term_list_push(out, ontology_store_resolve_local("HPO:0005978"))
        out = ontology_term_list_push(out, ontology_store_resolve_local("HPO:0003074"))
        out = ontology_term_list_push(out, ontology_store_resolve_local("GO:0042593"))
        out = ontology_term_list_push(out, ontology_store_resolve_local("CHEBI:17234"))
        return out
    }
    if starts_with(query, "diabetes") || starts_with(query, "Diabetes") {
        out = ontology_term_list_push(out, ontology_store_resolve_local("SNOMED:73211009"))
        out = ontology_term_list_push(out, ontology_store_resolve_local("SNOMED:44054006"))
        return out
    }
    if starts_with(query, "metformin") || starts_with(query, "Metformin") {
        out = ontology_term_list_push(out, ontology_store_resolve_local("CHEBI:6801"))
        return out
    }
    let exact = ontology_store_resolve_local(query)
    if ontology_term_found(exact) {
        out = ontology_term_list_push(out, exact)
    }
    out
}
