// stdlib/compiler/ontology/resolver.sio
//
// Local-first ontology resolution for the compiler surface.

pub(crate) fn ontology_resolve(curie: string) -> ResolvedOntologyTerm {
    let config = ontology_cache_config()
    ontology_resolve_with_config(curie, config)
}

fn ontology_resolve_with_config(curie: string, config: OntologyConfig) -> ResolvedOntologyTerm {
    let local = ontology_store_resolve_local(curie)
    if ontology_term_found(local) {
        return local
    }
    if ontology_mode_allows_federation(config.mode) {
        let remote = ontology_federated_resolve(curie, config)
        if ontology_term_found(remote) {
            return remote
        }
    }
    ontology_cache_negative(curie)
}

pub(crate) fn ontology_search(query: string) -> ResolvedOntologyTermList {
    let config = ontology_cache_config()
    let local = ontology_store_search_local(query)
    if local.len > 0 {
        return local
    }
    if ontology_mode_allows_federation(config.mode) {
        return ontology_federated_search(query, config)
    }
    ontology_term_list_new()
}

pub(crate) fn ontology_ancestors(curie: string) -> ResolvedOntologyTermList {
    var out = ontology_term_list_new()
    let term = ontology_resolve(curie)
    if !ontology_term_found(term) {
        return out
    }

    var i: i64 = 0
    while i < term.parents_len {
        let parent_curie = term.parents[i as usize]
        let parent = ontology_resolve(parent_curie)
        if ontology_term_found(parent) {
            out = ontology_term_list_push(out, parent)
            let nested = ontology_ancestors(parent_curie)
            var j: i64 = 0
            while j < nested.len {
                out = ontology_term_list_push(out, nested.items[j as usize])
                j = j + 1
            }
        }
        i = i + 1
    }
    out
}

pub(crate) fn ontology_is_subclass(child: string, parent: string) -> bool {
    if child == parent {
        return true
    }
    let ancestors = ontology_ancestors(child)
    var i: i64 = 0
    while i < ancestors.len {
        if ancestors.items[i as usize].curie == parent {
            return true
        }
        i = i + 1
    }
    false
}

pub(crate) fn ontology_map_term(source_curie: string, to_ontology: string) -> OntologyMappingList {
    ontology_map_term_local(source_curie, to_ontology)
}
