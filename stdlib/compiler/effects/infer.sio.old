// stdlib/compiler/effects/infer.sio
// Effect Inference and Checking for Sounio Compiler
// Implements bottom-up effect inference and consistency checking against declarations.
// Based on WP-3.2 specification.

// Core effect bitmasks (i64 bit positions)
const EFFECT_PANIC: i64 = 1 << 0;  // Bounds checks, errors, etc.
const EFFECT_MUT: i64 = 1 << 1;     // Mutable dereference or assignment
const EFFECT_ALLOC: i64 = 1 << 2;   // Heap allocation (new T)
const EFFECT_IO: i64 = 1 << 3;      // I/O operations (file, network)
const EFFECT_GPU: i64 = 1 << 4;     // GPU kernel launches
const EFFECT_PROB: i64 = 1 << 5;    // Probabilistic/random operations
const EFFECT_DIV: i64 = 1 << 6;     // Division (zero-divide risk)
const EFFECT_ALL: i64 = (1 << 7) - 1;  // Mask for all defined effects (up to bit 6)

// Forward declarations (assumed from other compiler modules)
struct TypeContext;  // Type environment with bindings
struct CompileError {
    message: string,
    location: SourceLocation,
};
struct SourceLocation {
    file: string,
    line: i64,
    col: i64,
};
struct HirExpr {
    kind: i32,  // Enum-like: Literal=0, Var=1, Call=2, Index=3, etc.
    // Variant fields (union-like, but in Sounio use tagged variants or manual)
    // For simplicity, assume fields like: lit_val: i64, var_name: string, callee: HirExpr, args: [HirExpr; 16], etc.
    // Actual impl would use proper variants; here we use a flat struct with optional fields.
    data: [u8; 256],  // Placeholder for variant data
    loc: SourceLocation,
};
struct HirStmt {
    kind: i32,  // Assign=0, Seq=1, If=2, While=3, Return=4, etc.
    // Similar placeholder
    data: [u8; 256],
    loc: SourceLocation,
};
struct FunctionDef {
    sig: FunctionSignature,
    body: [HirStmt; 128],  // Statements in body
    n_stmts: i64,
};
struct FunctionSignature {
    name: string,
    params: [string; 16],
    n_params: i64,
    return_type: string,
    effect_set: i64,  // Declared effects bitmask
};
struct EffectConstraint {
    source_expr: HirExpr,  // Reference to source (copy or ptr?)
    effect: i32,           // Effect type (0=Panic, 1=Mut, etc.)
    location: SourceLocation,
};

// Main inference result
struct EffectInferenceResult {
    inferred_effects: i64,
    context: TypeContext,
    errors: [CompileError; 32],
    n_errors: i64,
};

// Checking result
struct EffectCheckResult {
    declared_effects: i64,
    inferred_effects: i64,
    missing_effects: i64,    // Inferred but not declared (error)
    extra_effects: i64,      // Declared but not inferred (warning, conservative OK)
    is_consistent: bool,
};

// Helper: Create empty inference result
fn empty_inference_result(ctx: TypeContext) -> EffectInferenceResult with Panic {
    var res = EffectInferenceResult {
        inferred_effects: 0,
        context: ctx,
        errors: [CompileError { message: "", location: SourceLocation { file: "", line: 0, col: 0 } }; 32],
        n_errors: 0,
    };
    res
}

// Helper: Add error to result
fn add_error(res: &! EffectInferenceResult, msg: string, loc: SourceLocation) -> () with Panic {
    if res.n_errors < 32 {
        let idx = res.n_errors as usize;
        res.errors[idx].message = msg;
        res.errors[idx].location = loc;
        res.n_errors = res.n_errors + 1;
    }
}

// Helper: Union two effect sets
fn union_effects(e1: i64, e2: i64) -> i64 {
    e1 | e2
}

// Helper: Get effect bit from i32 type (0=Panic, etc.)
fn get_effect_bit(eff_type: i32) -> i64 with Panic {
    match eff_type {
        0 => EFFECT_PANIC,
        1 => EFFECT_MUT,
        2 => EFFECT_ALLOC,
        3 => EFFECT_IO,
        4 => EFFECT_GPU,
        5 => EFFECT_PROB,
        6 => EFFECT_DIV,
        _ => 0,  // Unknown, no effect
    }
}

// Infer effects from a single expression (bottom-up)
fn infer_expr_effects(ctx: TypeContext, expr: HirExpr) -> EffectInferenceResult with Panic {
    var res = empty_inference_result(ctx);
    var local_effects: i64 = 0;

    // Match on expr.kind (simplified; real impl would use proper pattern matching)
    match expr.kind {
        0 => {  // Literal (int, string, etc.)
            local_effects = 0;  // No effects
        },
        1 => {  // Variable reference
            // Check if bound in context; assume no effects from read
            local_effects = 0;
            // If mutable binding, might add Mut? But typically read is pure.
        },
        2 => {  // Function call: expr.callee (HirExpr), expr.args [HirExpr;16], n_args
            // Infer effects from args first (bottom-up)
            var arg_effects: i64 = 0;
            // Assume expr.data encodes n_args and args; placeholder loop
            var i: i64 = 0;
            while i < 16 {  // Max args
                if /* check if arg i valid */ false { break; }
                let arg_res = infer_expr_effects(res.context, /* expr.args[i] */ HirExpr { kind: 0, .. });
                arg_effects = union_effects(arg_effects, arg_res.inferred_effects);
                res.context = arg_res.context;  // Propagate context updates
                i = i + 1;
            }

            // Look up callee in context (assume ctx has fn_table: map<string, FunctionSignature>)
            let callee_name = /* extract from expr.callee */ "unknown";
            // Assume ctx lookup:
            let callee_sig: FunctionSignature = /* ctx.get_fn(callee_name) */ FunctionSignature { effect_set: 0, .. };
            if callee_sig.effect_set == 0 {
                add_error(&! res, format!("Undeclared function: {}", callee_name), expr.loc);
            }
            local_effects = union_effects(callee_sig.effect_set, arg_effects);
        },
        3 => {  // Array indexing: arr[i] -> adds Panic
            // Infer from arr and i
            let arr_res = infer_expr_effects(res.context, /* expr.arr */ HirExpr { kind: 1, .. });
            let idx_res = infer_expr_effects(arr_res.context, /* expr.idx */ HirExpr { kind: 0, .. });
            local_effects = union_effects(union_effects(arr_res.inferred_effects, idx_res.inferred_effects), EFFECT_PANIC);
            res.context = idx_res.context;
        },
        4 => {  // Binary op: e.g., a / b -> if div, add Div
            let left_res = infer_expr_effects(res.context, /* expr.left */ HirExpr { kind: 0, .. });
            let right_res = infer_expr_effects(left_res.context, /* expr.right */ HirExpr { kind: 0, .. });
            local_effects = union_effects(left_res.inferred_effects, right_res.inferred_effects);
            if /* op is / */ true {
                local_effects = union_effects(local_effects, EFFECT_DIV);
            }
            // Other ops: + - * no effects, unless overflow (but not tracked)
            res.context = right_res.context;
        },
        5 => {  // Unary deref: *ptr = value -> but this is expr, assign is stmt; for load *ptr adds Mut?
            // Assume load *ptr adds Mut if ptr mutable
            local_effects = EFFECT_MUT;
            // Infer from ptr
            let ptr_res = infer_expr_effects(res.context, /* expr.operand */ HirExpr { kind: 1, .. });
            local_effects = union_effects(local_effects, ptr_res.inferred_effects);
            res.context = ptr_res.context;
        },
        6 => {  // Allocation: new T
            local_effects = EFFECT_ALLOC;
        },
        7 => {  // I/O expr: e.g., read_file(path) -> but that's call, handled above
            // Specific intrinsics might be tagged
            local_effects = EFFECT_IO;
        },
        8 => {  // GPU launch: kernel(...) 
            local_effects = EFFECT_GPU;
        },
        9 => {  // Random: rand()
            local_effects = EFFECT_PROB;
        },
        // Add more kinds: IfExpr (rare), Match, etc.
        _ => {
            add_error(&! res, format!("Unknown expr kind: {}", expr.kind), expr.loc);
            local_effects = 0;
        },
    }

    res.inferred_effects = local_effects;
    res
}

// Infer effects from a statement
fn infer_stmt_effects(ctx: TypeContext, stmt: HirStmt) -> EffectInferenceResult with Panic {
    var res = empty_inference_result(ctx);
    var local_effects: i64 = 0;

    match stmt.kind {
        0 => {  // Assignment: var x = expr; or *ptr = expr (Mut)
            let expr_res = infer_expr_effects(res.context, /* stmt.expr */ HirExpr { kind: 0, .. });
            local_effects = expr_res.inferred_effects;
            if /* is mutable deassign */ true {
                local_effects = union_effects(local_effects, EFFECT_MUT);
            }
            // Update context with new binding
            // res.context = update_binding(expr_res.context, stmt.var_name, expr_res.inferred_effects);
            res.context = expr_res.context;
        },
        1 => {  // Sequential: stmt1; stmt2
            let stmt1_res = infer_stmt_effects(res.context, /* stmt.first */ HirStmt { kind: 0, .. });
            let stmt2_res = infer_stmt_effects(stmt1_res.context, /* stmt.second */ HirStmt { kind: 0, .. });
            local_effects = union_effects(stmt1_res.inferred_effects, stmt2_res.inferred_effects);
            res.context = stmt2_res.context;
        },
        2 => {  // If: if cond { then } [else { els }]
            let cond_res = infer_expr_effects(res.context, /* stmt.cond */ HirExpr { kind: 0, .. });
            let then_res = infer_stmt_effects(cond_res.context, /* stmt.then */ HirStmt { kind: 1, .. });
            var else_effects: i64 = 0;
            if /* has else */ true {
                let else_res = infer_stmt_effects(then_res.context, /* stmt.else_ */ HirStmt { kind: 1, .. });
                else_effects = else_res.inferred_effects;
                res.context = else_res.context;
            } else {
                res.context = then_res.context;
            }
            local_effects = union_effects(union_effects(cond_res.inferred_effects, then_res.inferred_effects), else_effects);
        },
        3 => {  // While: while cond { body } -> may need Div? But infer from body + cond
            let cond_res = infer_expr_effects(res.context, /* stmt.cond */ HirExpr { kind: 0, .. });
            let body_res = infer_stmt_effects(cond_res.context, /* stmt.body */ HirStmt { kind: 1, .. });
            local_effects = union_effects(cond_res.inferred_effects, body_res.inferred_effects);
            // While loops may imply Div if iteration count unknown, but per spec, only if div inside
            // No auto-add; user must declare if needed
            res.context = body_res.context;
        },
        4 => {  // Return: return expr;
            let expr_res = infer_expr_effects(res.context, /* stmt.expr */ HirExpr { kind: 0, .. });
            local_effects = expr_res.inferred_effects;
            res.context = expr_res.context;
        },
        5 => {  // Block: { stmts... }
            var block_effects: i64 = 0;
            // Assume stmt.data has n_stmts and array
            var i: i64 = 0;
            while i < 128 {
                if /* i >= n_stmts */ false { break; }
                let s_res = infer_stmt_effects(res.context, /* stmts[i] */ HirStmt { kind: 0, .. });
                block_effects = union_effects(block_effects, s_res.inferred_effects);
                res.context = s_res.context;
                i = i + 1;
            }
            local_effects = block_effects;
        },
        // Function call as stmt: similar to expr call
        6 => {
            let call_res = infer_expr_effects(res.context, /* stmt.call_expr */ HirExpr { kind: 2, .. });
            local_effects = call_res.inferred_effects;
            res.context = call_res.context;
        },
        // Error/throw: adds Panic
        7 => {
            local_effects = EFFECT_PANIC;
        },
        _ => {
            add_error(&! res, format!("Unknown stmt kind: {}", stmt.kind), stmt.loc);
            local_effects = 0;
        },
    }

    res.inferred_effects = local_effects;
    res
}

// Infer effects for entire function body
fn infer_fn_effects(ctx: TypeContext, fn_def: FunctionDef) -> EffectInferenceResult with Panic {
    var res = empty_inference_result(ctx);
    var body_effects: i64 = 0;

    // Enter new scope for params
    // ctx = push_scope(ctx, fn_def.sig.params, fn_def.sig.n_params);

    // Infer statements
    var i: i64 = 0;
    while i < fn_def.n_stmts {
        let stmt_res = infer_stmt_effects(res.context, fn_def.body[i as usize]);
        body_effects = union_effects(body_effects, stmt_res.inferred_effects);
        res.context = stmt_res.context;
        // Merge errors
        var j: i64 = 0;
        while j < stmt_res.n_errors {
            add_error(&! res, stmt_res.errors[j as usize].message, stmt_res.errors[j as usize].location);
            j = j + 1;
        }
        i = i + 1;
    }

    // Add return expr if present (assume last stmt is return)
    if fn_def.n_stmts > 0 && fn_def.body[(fn_def.n_stmts - 1) as usize].kind == 4 {
        // Already included in body
    } else {
        // Unit return, no effect
    }

    res.inferred_effects = body_effects;
    res
}

// Effect checking implementation
fn check_effects(declared: i64, inferred: i64) -> EffectCheckResult {
    var result = EffectCheckResult {
        declared_effects: declared,
        inferred_effects: inferred,
        missing_effects: inferred & !declared,  // ~ is bitwise not, but careful with sign; assume positive
        extra_effects: declared & !inferred,
        is_consistent: (inferred & !declared) == 0,
    };
    // In Sounio, ~ is bitwise not for i64; mask with EFFECT_ALL if needed
    result.missing_effects = inferred & (~declared & EFFECT_ALL);
    result.extra_effects = declared & (~inferred & EFFECT_ALL);
    result.is_consistent = (result.missing_effects == 0);
    result
}

fn check_fn_effects(fn_sig: FunctionSignature, inferred: i64) -> bool {
    let check = check_effects(fn_sig.effect_set, inferred);
    if !check.is_consistent {
        // In real compiler, report error via logger
        // Here, just return false
        return false;
    }
    // Extra effects OK (conservative declaration)
    true
}

// Constraint collection (for more advanced solving, e.g., effect variables)
fn collect_effect_constraints(expr: HirExpr, constraints: &! [EffectConstraint; 128], n: &! i64) -> () with Panic {
    // Recursive collection
    // For each effect source, add constraint
    match expr.kind {
        2 => {  // Call: add callee effects
            // Assume add: constraints[*n] = EffectConstraint { source_expr: expr, effect: 3 /*IO?*/, location: expr.loc };
            // *n += 1;
            // Recur on args
            var i: i64 = 0;
            while i < 16 {
                // collect_effect_constraints(args[i], constraints, n);
                i += 1;
            }
        },
        3 => {  // Index: add Panic
            constraints[*n as usize] = EffectConstraint {
                source_expr: expr,  // Copy expr
                effect: 0,  // Panic
                location: expr.loc,
            };
            *n = *n + 1;
            // Recur on arr and idx
        },
        4 => {  // Div op
            if /* is / */ true {
                constraints[*n as usize] = EffectConstraint { source_expr: expr, effect: 6 /*Div*/, location: expr.loc };
                *n = *n + 1;
            }
        },
        // Add for other sources: alloc, io, etc.
        _ => {},
    }
    // Recur on subexprs generally
}

fn solve_effect_constraints(constraints: [EffectConstraint; 128], n: i64) -> i64 with Panic {
    var effect_mask: i64 = 0;
    var i: i64 = 0;
    while i < n {
        let eff = constraints[i as usize].effect;
        let bit = get_effect_bit(eff);
        effect_mask = union_effects(effect_mask, bit);
        i = i + 1;
    }
    effect_mask
}

// Top-level inference entry point (for module)
fn infer_module_effects(ctx: TypeContext, fns: [FunctionDef; 64], n_fns: i64) -> [EffectInferenceResult; 64] with Panic {
    var results: [EffectInferenceResult; 64] = [empty_inference_result(ctx); 64];
    var i: i64 = 0;
    while i < n_fns {
        results[i as usize] = infer_fn_effects(ctx, fns[i as usize]);
        // Check consistency
        let consistent = check_fn_effects(fns[i as usize].sig, results[i as usize].inferred_effects);
        if !consistent {
            // Add error to results[i]
            add_error(&! results[i as usize], "Inferred effects exceed declared", SourceLocation { file: "", line: 0, col: 0 });
        }
        i = i + 1;
    }
    results
}

// Example usage (for testing, not executed)
fn example_inference() -> () with Panic, IO {
    // Simulate the example
    let ctx = /* empty ctx */;
    let fn_def = FunctionDef {
        sig: FunctionSignature {
            name: "process_file",
            params: ["path"],
            n_params: 1,
            return_type: "i64",
            effect_set: union_effects(EFFECT_IO, EFFECT_PANIC),
        },
        body: [/* stmts: read_file (call IO), len(), if (no), error(Panic) */ HirStmt { kind: 0, .. }; 128],
        n_stmts: 4,
    };
    let res = infer_fn_effects(ctx, fn_def);
    // Inferred: IO | Panic
    // Check: consistent
    let check = check_effects(fn_def.sig.effect_set, res.inferred_effects);
    assert(check.is_consistent);
}

