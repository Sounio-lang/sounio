// stdlib/compiler/effects/effect.sio
// Effect type system implementation for Sounio
// Simplified stub for bootstrap

fn EFFECT_IO() -> i32 { 0 }
fn EFFECT_MUT() -> i32 { 1 }
fn EFFECT_ALLOC() -> i32 { 2 }
fn EFFECT_PANIC() -> i32 { 3 }
fn EFFECT_ASYNC() -> i32 { 4 }
fn EFFECT_GPU() -> i32 { 5 }
fn EFFECT_PROB() -> i32 { 6 }
fn EFFECT_DIV() -> i32 { 7 }

struct EffectSet {
    mask: i64,
}

struct EffectVar {
    id: i64,
    lower_bound: i64,
    upper_bound: i64,
}

fn effect_singleton(kind: i32) -> EffectSet with Panic {
    EffectSet { mask: (1 << (kind as i64)) }
}

fn effect_union(e1: EffectSet, e2: EffectSet) -> EffectSet {
    EffectSet { mask: e1.mask | e2.mask }
}

fn effect_intersect(e1: EffectSet, e2: EffectSet) -> EffectSet {
    EffectSet { mask: e1.mask & e2.mask }
}

fn effect_complement(e: EffectSet) -> EffectSet {
    EffectSet { mask: !e.mask }
}

fn effect_subset(e1: EffectSet, e2: EffectSet) -> bool {
    (e1.mask & !e2.mask) == 0
}

fn effect_disjoint(e1: EffectSet, e2: EffectSet) -> bool {
    (e1.mask & e2.mask) == 0
}

fn effect_empty() -> EffectSet {
    EffectSet { mask: 0 }
}

fn effect_full() -> EffectSet {
    EffectSet { mask: -1 }
}

fn effect_is_empty(e: EffectSet) -> bool {
    e.mask == 0
}

struct EffectConstraint {
    left_id: i64,
    right_id: i64,
    operator: i32,
}

struct EffectConstraints {
    items: [EffectConstraint; 64],
    count: i64,
}

fn effect_constraints_new() -> EffectConstraints {
    EffectConstraints { items: [EffectConstraint { left_id: 0, right_id: 0, operator: 0 }; 64], count: 0 }
}

struct EffectSubstitution {
    vars: [i64; 32],
    values: [i64; 32],
    count: i64,
}

fn effect_substitution_new() -> EffectSubstitution {
    EffectSubstitution { vars: [0; 32], values: [0; 32], count: 0 }
}

struct EffectSignature {
    effect_set: EffectSet,
    effect_vars: [EffectVar; 8],
    n_effect_vars: i64,
}

fn effect_signature_new(mask: i64) -> EffectSignature {
    EffectSignature {
        effect_set: EffectSet { mask: mask },
        effect_vars: [EffectVar { id: 0, lower_bound: 0, upper_bound: 0 }; 8],
        n_effect_vars: 0,
    }
}

struct RowVariable {
    id: i64,
    tail: i64,
}

fn row_variable_new(id: i64, tail: i64) -> RowVariable {
    RowVariable { id: id, tail: tail }
}

struct Row {
    effects: EffectSet,
    tail_var: RowVariable,
}

fn row_new() -> Row {
    Row { effects: effect_empty(), tail_var: RowVariable { id: 0, tail: 0 } }
}

fn row_union(r1: Row, r2: Row) -> Row {
    Row { effects: effect_union(r1.effects, r2.effects), tail_var: r1.tail_var }
}
