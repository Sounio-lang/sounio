// File: stdlib/compiler/effects/infer.sio
// Effect Inference and Checking for Sounio Compiler
// Implements bottom-up effect inference and consistency checking against declared effects.
// Based on WP-3.2 specification.


// Effect bitmasks (i64 for up to 64 effects; extend as needed)
const EFFECT_PANIC: i64 = 1 << 0;  // Bit 0: Panic (e.g., array index, error)
const EFFECT_DIV: i64 = 1 << 1;    // Bit 1: Div (division by zero)
const EFFECT_MUT: i64 = 1 << 2;    // Bit 2: Mut (mutable dereference)
const EFFECT_ALLOC: i64 = 1 << 3;  // Bit 3: Alloc (heap allocation)
const EFFECT_IO: i64 = 1 << 4;     // Bit 4: IO (file/network ops)
const EFFECT_GPU: i64 = 1 << 5;    // Bit 5: GPU (kernel launch)
const EFFECT_PROB: i64 = 1 << 6;   // Bit 6: Prob (randomness)

// Additional effects can be added by shifting further (e.g., 1 << 7 for new effects)

// Struct for inference result
struct EffectInferenceResult {
    inferred_effects: i64,     // Bitmask of inferred effects
    context: TypeContext,      // Updated type context (e.g., with new bindings)
    errors: [CompileError; 32], // Accumulated errors
    n_errors: i64,             // Number of errors
}

// Struct for check result
struct EffectCheckResult {
    declared_effects: i64,     // From function signature
    inferred_effects: i64,     // From body inference
    missing_effects: i64,      // Inferred but not declared (error)
    extra_effects: i64,        // Declared but not inferred (warning, conservative OK)
    is_consistent: bool,       // True if inferred ⊆ declared
}

// Struct for effect constraints (for data flow tracking)
struct EffectConstraint {
    source_expr: HirExpr,      // Reference to source expression (assume Rc or similar)
    effect: i32,               // Effect type (as i32 for indexing, map to bits)
    location: SourceLocation,  // Source location for errors
}

// Fixed-size array for constraints (max 128)
struct EffectConstraints {
    items: [EffectConstraint; 128],
}

// Helper constructors for compile errors (avoid type aliases / Rust macros)
fn compile_error_default() -> CompileError {
    CompileError { message: "", location: SourceLocation { file: "", line: 0, col: 0 } }
}

fn compile_error_new(msg: string, loc: SourceLocation) -> CompileError {
    CompileError { message: msg, location: loc }
}

// Infer effects from an expression (bottom-up)
fn infer_expr_effects(ctx: TypeContext, expr: HirExpr) -> EffectInferenceResult with Panic {
    var result = EffectInferenceResult {
        inferred_effects: 0,
        context: ctx,
        errors: [compile_error_default(); 32],  // Assume default constructor
        n_errors: 0,
    };

    // Match on expression kind (assume HirExpr is an enum with variants)
    match expr.kind {  // Pseudo-syntax; adjust to actual HirExpr match
        HirExprKindLiteral(_) => {
            // Literals have no effects
            result.inferred_effects = 0;
        }
        HirExprKindVar(name) => {
            // Variables: no effects unless mutable binding, but check context
            if let Some(binding) = ctx.lookup_binding(&name) {
                // If mutable, might imply Mut, but typically no runtime effect here
                result.inferred_effects = 0;
                result.context = ctx.extend_binding(name, binding);  // Update if needed
            } else {
                // Unbound variable error
                var err = compile_error_new("Unbound variable", expr.location);
                result.errors[result.n_errors as usize] = err;
                result.n_errors = result.n_errors + 1;
                result.inferred_effects = EFFECT_PANIC;  // Panic on error?
            }
        }
        HirExprKindFunctionCall(callee, args) => {
            // Recurse on args first
            var arg_effects: i64 = 0;
            for arg in args {
                let arg_res = infer_expr_effects(result.context, arg);
                arg_effects = arg_effects | arg_res.inferred_effects;
                // Accumulate errors
                var i: i64 = 0;
                while i < arg_res.n_errors {
                    if result.n_errors < 32 {
                        result.errors[result.n_errors as usize] = arg_res.errors[i as usize];
                        result.n_errors = result.n_errors + 1;
                    }
                    i = i + 1;
                }
                result.context = arg_res.context;
            }

            // Look up callee effects
            if let Some(sig) = result.context.lookup_function(&callee.name) {
                let callee_effects = sig.effect_set;
                result.inferred_effects = arg_effects | callee_effects;
            } else {
                // Unknown function: assume Panic
                var err = compile_error_new("Unknown function", expr.location);
                result.errors[result.n_errors as usize] = err;
                result.n_errors = result.n_errors + 1;
                result.inferred_effects = EFFECT_PANIC;
            }
        }
        HirExprKindArrayIndex(arr, idx) => {
            // Recurse on arr and idx
            let arr_res = infer_expr_effects(result.context, arr);
            let idx_res = infer_expr_effects(result.context, idx);
            result.inferred_effects = arr_res.inferred_effects | idx_res.inferred_effects | EFFECT_PANIC;  // Bounds check
            // Accumulate errors...
            result.context = idx_res.context;
        }
        HirExprKindBinaryOp(op, left, right) => {
            // Recurse on operands
            let left_res = infer_expr_effects(result.context, left);
            let right_res = infer_expr_effects(left_res.context, right);
            var op_effects: i64 = left_res.inferred_effects | right_res.inferred_effects;

            // Specific ops add effects
            match op {
                BinaryOpDiv => { op_effects = op_effects | EFFECT_DIV; }
                BinaryOpAssign => { op_effects = op_effects | EFFECT_MUT; }  // If mutable
                _ => { }  // Other ops (add, mul, etc.) no extra
            }
            result.inferred_effects = op_effects;
            result.context = right_res.context;
            // Accumulate errors...
        }
        HirExprKindUnaryOp(op, operand) => {
            let op_res = infer_expr_effects(result.context, operand);
            var op_effects: i64 = op_res.inferred_effects;
            match op {
                UnaryOpDe=> { op_effects = op_effects | EFFECT_MUT; }  // Mutable deref
                UnaryOpNew(_) => { op_effects = op_effects | EFFECT_ALLOC; }  // Heap alloc
                _ => { }
            }
            result.inferred_effects = op_effects;
            result.context = op_res.context;
        }
        HirExprKindMethodCall(receiver, method, args) => {
            // Similar to function call, but check receiver type for effects (e.g., IO methods)
            let recv_res = infer_expr_effects(result.context, receiver);
            var call_effects: i64 = recv_res.inferred_effects;
            // Assume method lookup adds specific effects (e.g., read_file adds IO)
            if method == "read_file" { call_effects = call_effects | EFFECT_IO; }
            else if method == "random" { call_effects = call_effects | EFFECT_PROB; }
            // ... other methods
            else if method == "kernel_launch" { call_effects = call_effects | EFFECT_GPU; }
            // Recurse args...
            result.inferred_effects = call_effects;
            result.context = recv_res.context;
        }
        // Other cases: If, Match, Block, etc. - treat as stmt-like or recurse
        HirExprKindIf(cond, then_branch, else_branch) => {
            let cond_res = infer_expr_effects(result.context, cond);
            let then_res = infer_expr_effects(cond_res.context, then_branch);
            let else_res = infer_expr_effects(then_res.context, else_branch);
            result.inferred_effects = cond_res.inferred_effects | then_res.inferred_effects | else_res.inferred_effects;
            result.context = else_res.context;
        }
        // Add more cases as needed for full HirExpr coverage (e.g., Loop, FieldAccess)
        _ => {
            // Default: no effects, but log warning
            result.inferred_effects = 0;
        }
    }

    // Update context if needed (e.g., for effect polymorphism, but simplified here)
    result
}

// Infer effects from a statement
fn infer_stmt_effects(ctx: TypeContext, stmt: HirStmt) -> EffectInferenceResult with Panic {
    var result = EffectInferenceResult {
        inferred_effects: 0,
        context: ctx,
        errors: [compile_error_default(); 32],
        n_errors: 0,
    };

    match stmt.kind {
        HirStmtKindExpr(e) => {
            let expr_res = infer_expr_effects(result.context, e);
            result.inferred_effects = expr_res.inferred_effects;
            // Accumulate errors
            var i: i64 = 0;
            while i < expr_res.n_errors {
                if result.n_errors < 32 {
                    result.errors[result.n_errors as usize] = expr_res.errors[i as usize];
                    result.n_errors = result.n_errors + 1;
                }
                i = i + 1;
            }
            result.context = expr_res.context;
        }
        HirStmtKindLet(var, init) => {
            let init_res = infer_expr_effects(result.context, init);
            // Let binding: effects from init, update context with var binding
            result.inferred_effects = init_res.inferred_effects;
            if var.is_mut { result.inferred_effects = result.inferred_effects | EFFECT_MUT; }  // Mutable var implies potential Mut
            result.context = result.context.extend_binding(var.name, init_res.context.get_type(init));
            // Errors...
        }
        HirStmtKindAssign(target, value) => {
            let val_res = infer_expr_effects(result.context, value);
            var assign_effects: i64 = val_res.inferred_effects | EFFECT_MUT;  // Assignment is mut
            // If target is deor array, add more
            if target.is_deref() { assign_effects = assign_effects | EFFECT_PANIC; }  // Potential invalid access
            result.inferred_effects = assign_effects;
            result.context = val_res.context;
        }
        HirStmtKindSeq(stmt1, stmt2) => {
            let s1_res = infer_stmt_effects(result.context, stmt1);
            let s2_res = infer_stmt_effects(s1_res.context, stmt2);
            result.inferred_effects = s1_res.inferred_effects | s2_res.inferred_effects;
            result.context = s2_res.context;
            // Accumulate all errors
        }
        HirStmtKindIf(cond, then_b, else_b) => {
            // All branches contribute (union)
            let cond_res = infer_expr_effects(result.context, cond);
            let then_res = infer_stmt_effects(cond_res.context, then_b);
            let else_res = infer_stmt_effects(then_res.context, else_b);
            result.inferred_effects = cond_res.inferred_effects | then_res.inferred_effects | else_res.inferred_effects;
            result.context = else_res.context;
        }
        HirStmtKindWhile(cond, body) => {
            let cond_res = infer_expr_effects(result.context, cond);
            let body_res = infer_stmt_effects(cond_res.context, body);
            var loop_effects: i64 = cond_res.inferred_effects | body_res.inferred_effects;
            // While loops may introduce Div if condition involves division, but generally union
            // Per rules: may need 'with Div' if potential div-by-zero in cond/body
            if body_res.inferred_effects & EFFECT_DIV != 0 {
                loop_effects = loop_effects | EFFECT_DIV;
            }
            result.inferred_effects = loop_effects;
            result.context = body_res.context;
        }
        // Add cases for Return, Block, etc.
        HirStmtKindReturn(e) => {
            let e_res = infer_expr_effects(result.context, e);
            result.inferred_effects = e_res.inferred_effects;
            result.context = e_res.context;
        }
        _ => {
            result.inferred_effects = 0;
        }
    }

    result
}

// Infer effects from a function body
fn infer_fn_effects(ctx: TypeContext, fn_def: FunctionDef) -> EffectInferenceResult with Panic {
    // Enter new scope for params
    var local_ctx = ctx.enter_scope();
    for param in fn_def.params {
        local_ctx = local_ctx.extend_binding(param.name, param.typ);
    }

    // Infer from body (assume body is a block of statements + optional return expr)
    var body_effects: i64 = 0;
    for stmt in fn_def.body.statements {
        let stmt_res = infer_stmt_effects(local_ctx, stmt);
        body_effects = body_effects | stmt_res.inferred_effects;
        // Accumulate errors into result
        local_ctx = stmt_res.context;
    }

    // Add return expression effects
    if let Some(ret_expr) = fn_def.body.return_expr {
        let ret_res = infer_expr_effects(local_ctx, ret_expr);
        body_effects = body_effects | ret_res.inferred_effects;
        local_ctx = ret_res.context;
    }

    var result = EffectInferenceResult {
        inferred_effects: body_effects,
        context: local_ctx.exit_scope(ctx),  // Restore outer context
        errors: [compile_error_default(); 32],  // Collect from all recursions
        n_errors: 0,  // Populate from sub-results
    };

    // To fully accumulate errors, we'd need to propagate them up (simplified here;
    // in full impl, use a mutable error collector)

    result
}

// Check effects consistency
fn check_effects(declared: i64, inferred: i64) -> EffectCheckResult {
    var result = EffectCheckResult {
        declared_effects: declared,
        inferred_effects: inferred,
        missing_effects: 0,
        extra_effects: 0,
        is_consistent: true,
    };

    // Missing = inferred & ~declared (effects used but not declared)
    result.missing_effects = inferred & !declared;

    // Extra = declared & ~inferred (overly conservative declaration, OK)
    result.extra_effects = declared & !inferred;

    // Consistent if no missing effects (inferred ⊆ declared)
    result.is_consistent = (result.missing_effects == 0);

    result
}

// Check function effects and report if inconsistent
fn check_fn_effects(fn_sig: FunctionSignature, inferred: i64) -> bool {
    let check = check_effects(fn_sig.effect_set, inferred);
    if !check.is_consistent {
        // In full compiler, report error with details
        // e.g., error!("Function {} uses undeclared effects: {:?}", fn_sig.name, check.missing_effects);
        // For now, return false
        return false;
    }
    true  // Consistent
}

// Collect effect constraints during traversal (for debugging/analysis)
fn collect_effect_constraints(expr: HirExpr, constraints: EffectConstraints, n: i64) -> (EffectConstraints, i64) with Panic {
    // Base: add constraint if expr introduces effect
    // This is a helper; in inference, we'd call this alongside

    // Example: for array index
    if expr.is_array_index() {
        if n < 128 {
            constraints.items[n as usize] = EffectConstraint {
                source_expr: expr.clone(),  // Assume cloneable
                effect: 0,  // Panic as i32 (map 0 -> EFFECT_PANIC bit)
                location: expr.location,
            };
            n = n + 1;
        }
    }

    // Recurse on subexprs...
    // (Full impl would traverse entire tree)

    (constraints, n)
}

// Solve constraints to compute effect mask
fn solve_effect_constraints(constraints: EffectConstraints, n: i64) -> i64 with Panic {
    var effect_mask: i64 = 0;
    var i: i64 = 0;
    while i < n {
        let eff = constraints.items[i as usize].effect;
        let bit = match eff {  // Map i32 to bit
            0 => EFFECT_PANIC,
            1 => EFFECT_DIV,
            2 => EFFECT_MUT,
            3 => EFFECT_ALLOC,
            4 => EFFECT_IO,
            5 => EFFECT_GPU,
            6 => EFFECT_PROB,
            _ => 0,
        };
        effect_mask = effect_mask | bit;
        i = i + 1;
    }
    effect_mask
}

// Entry point for full inference + check on a function
fn infer_and_check_function(ctx: TypeContext, fn_def: FunctionDef) -> bool {
    let infer_res = infer_fn_effects(ctx, fn_def);
    let sig = FunctionSignaturefrom_def(&fn_def);  // Assume helper to get sig
    check_fn_effects(sig, infer_res.inferred_effects)
}

