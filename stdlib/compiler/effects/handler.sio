// Additional utility for capability management: Check mutation capability
fn check_mut_capability(cap: MutCapability, region_start: i64, op: i32) -> bool with Panic, Mut, Div {
    // op: 0=read (always allowed if region matches), 1=write
    var i: i64 = 0;
    while i < cap.n_regions {
        let r: Region = cap.regions[i as usize];
        if region_start >= r.start && region_start < r.end {
            if op == 1 && (r.permissions & 2) == 0 {
                return false;  // No write perm
            }
            return true;
        }
        i = i + 1;
    }
    false
}

// Restrict mutation capability
fn restrict_mut(cap: MutCapability, allowed_regions: [Region; 16], n: i64) -> MutCapability with Panic, Mut, Div {
    var new_cap: MutCapability = cap;
    new_cap.n_regions = n;
    if n > 16 {
        new_cap.n_regions = 16;
    }
    var i: i64 = 0;
    while i < new_cap.n_regions {
        new_cap.regions[i as usize] = allowed_regions[i as usize];
        i = i + 1;
    }
    new_cap
}

// Example: Create default capabilities
fn default_capabilities() -> Capabilities with Panic {
    Capabilities {
        io_cap: IOCapability { level: 0, paths: [""; 16], n_paths: 0 },
        mut_cap: MutCapability { regions: [default_region(); 32], n_regions: 0 },
        alloc_cap: false,
        gpu_cap: false,
    }
}

// Check overall capabilities for an effect (wrapper)
fn check_capabilities(caps: Capabilities, effect: i32, args: [i64; 4]) -> bool with Panic, Mut, Div {
    if effect == 1 {  // IO
        let path_idx: i64 = args[0];
        let path: string = resolve_string(path_idx);
        let op: i32 = args[1] as i32;
        check_io_capability(caps.io_cap, path, op)
    } else if effect == 2 {  // Mut
        let region_start: i64 = args[0];
        let op: i32 = args[1] as i32;
        check_mut_capability(caps.mut_cap, region_start, op)
    } else if effect == 3 {  // Alloc
        caps.alloc_cap
    } else if effect == 4 {  // GPU
        caps.gpu_cap
    } else {
        false
    }
}

// Compose capabilities (restrictive AND)
fn compose_capabilities(c1: Capabilities, c2: Capabilities) -> Capabilities with Panic, Mut, Div {
    Capabilities {
        io_cap: restrict_io(c1.io_cap, c2.io_cap.paths, c2.io_cap.n_paths),  // Use c2's paths as restriction
        mut_cap: restrict_mut(c1.mut_cap, c2.mut_cap.regions, c2.mut_cap.n_regions),
        alloc_cap: c1.alloc_cap && c2.alloc_cap,
        gpu_cap: c1.gpu_cap && c2.gpu_cap,
    }
}

// Mask effects in a computation's type (utility)
fn mask_computation_effects(comp: Computation, mask: i64) -> Computation with Panic, Mut {
    comp.effects = comp.effects & (-1 - mask);
    comp
}

// Example usage in a larger context: Run computation with capabilities
fn run_with_capabilities(caps: Capabilities, comp: Computation) -> HandlerResult with Panic, Mut, Div {
    // Check if comp.effects are allowed by caps
    var allowed: bool = true;
    var effect_bit: i64 = 1;
    var i: i32 = 0;
    while i < 64 {  // Check each bit
        if (comp.effects & effect_bit) != 0 {
            let args: [i64; 4] = extract_effect_args(comp, i as i32);  // Placeholder
            if !check_capabilities(caps, i as i32, args) {
                allowed = false;
                break;
            }
        }
        effect_bit = effect_bit << 1;
        i = i + 1;
    }
    if !allowed {
        return HandlerResult { value: 0, success: false, masked_effects: 0 };
    }

    // Proceed with execution (using default handler if none specified)
    let default_handler: EffectHandler = EffectHandler { handled_effects: comp.effects, handler_fn: 0, return_type_idx: comp.result_type };
    with_handler(default_handler, comp)
}

// Placeholder: Extract args for effect check
fn extract_effect_args(comp: Computation, effect_id: i32) -> [i64; 4] with Panic {
    [0; 4]
}

