// Test wrapper using mock handler
fn test_read_and_process() -> i64 with Panic {
    // Create a mock IO handler
    let mock_handler: EffectHandler = EffectHandler {
        handled_effects: 1,  // IO bit
        handler_fn: resolve_fn_index(0),
        return_type_idx: resolve_type_index(0),
    };

    // Run the IO computation under the mock handler
    let comp: Computation = Computation {
        code: resolve_comp_index(0),
        effects: 1,  // Has IO
        result_type: resolve_type_index(0),
    };
    let result: HandlerResult = with_handler(mock_handler, comp);

    // Result now has no IO effect (masked)
    if !result.success {
        return 0;
    }
    result.value as i64
}

