// Reflection and Query Functions

// Human-readable provenance
fn provenance_string(prov: Provenance) -> &str {
    let kind_str: &str;
    match prov.kind {
        0 => kind_str = "Measured",
        1 => kind_str = "Computed",
        2 => kind_str = "Assumed",
        3 => kind_str = "Inferred",
        _ => kind_str = "Unknown",
    }
    let depth_str = if prov.derivation_depth == 0 {
        "(direct)"
    } else {
        "(" + prov.derivation_depth.to_string() + " steps)"
    };
    kind_str + " " + depth_str
}

// Is this knowledge from direct measurement?
fn is_measured(k: Knowledge) -> bool {
    k.provenance.kind == PROVENANCE_MEASURED()
}

// Is knowledge computed/derived?
fn is_computed(k: Knowledge) -> bool {
    k.provenance.kind == PROVENANCE_COMPUTED()
}

// Confidence threshold check
fn is_confident(k: Knowledge, threshold: f64) -> bool {
    knowledge_confidence(k) > threshold
}

// Trace provenance chain (recursive, up to depth)
fn trace_provenance(k: Knowledge, max_depth: i64) -> &str {
    if k.provenance.derivation_depth == 0 || max_depth <= 0 {
        provenance_string(k.provenance)
    } else {
        // Recursive trace (placeholder; full impl needs parent refs)
        provenance_string(k.provenance) + " <- [chain]"
    }
}

// Error Budget Tracking

// Total propagated error from depth
fn total_propagated_error(k: Knowledge) -> f64 {
    k.confidence * (1.0 + k.provenance.derivation_depth as f64 * 0.1)  // Heuristic penalty per step
}

// Suggest refinement if error too high
fn needs_refinement(k: Knowledge, tolerance: f64) -> bool {
    k.confidence > tolerance
}

// Aggregate multiple Knowledges (e.g., ensemble)
fn knowledge_ensemble(ks: []Knowledge) -> Knowledge with Panic {
    if ks.len() == 0 {
        panic("Empty ensemble");
    }
    var ensemble = ks[0] with Panic;
    for i in 1..ks.len() {
        let next = ks[i] with Panic;
        ensemble = knowledge_union(ensemble, next);
    }
    // Average confidence if measured
    if is_measured(ensemble) {
        var sum_conf: f64 = 0.0;
        var count: i64 = 0;
        for k in ks {
            if is_measured(k) {
                sum_conf += k.confidence;
                count += 1;
            }
        }
        if count > 0 {
            ensemble.confidence = sum_conf / count as f64;
        }
    }
    ensemble
}

// Validation Helpers

// Check type compatibility
fn types_compatible(k1: Knowledge, k2: Knowledge) -> bool {
    k1.type_idx == k2.type_idx
}

// Compute uncertainty contribution (sensitivity)
fn uncertainty_contribution(k_main: Knowledge, k_factor: Knowledge, op: i32) -> f64 {
    // Placeholder: depends on operation (add/mul/etc.)
    // For add: 100 * k_factor.confidence / (k_main.confidence + k_factor.confidence)
    0.0
}

// Export for Compiler Integration

// These would be used by the epistemic type checker
fn epistemic_type_of(k: Knowledge) -> i64 {
    k.type_idx
}

fn epistemic_uncertainty(k: Knowledge) -> f64 {
    k.confidence
}

fn epistemic_provenance(k: Knowledge) -> Provenance {
    k.provenance
}

