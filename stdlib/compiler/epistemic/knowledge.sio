// stdlib/compiler/epistemic/knowledge.sio
// Epistemic Types for Uncertainty Tracking
// Implements Knowledge<T> metadata for scientific computing
// Tracks confidence bounds (epsilon) and provenance
// Propagates uncertainty through operations
// Enables compile-time checks for precision loss

// Core Structures

struct Knowledge {
    type_idx: i64,           // Type index of inner value T
    confidence: f64,         // ε (epsilon): uncertainty bound (0.0 = certain, 1.0 = fully uncertain)
    provenance: Provenance,  // Origin and derivation history
}

struct Provenance {
    kind: i32,               // 0=Measured, 1=Computed, 2=Assumed, 3=Inferred
    source: i64,             // Reference ID (e.g., variable ID or function hash)
    derivation_depth: i64,   // Steps from original source (0 = direct)
}

// Provenance Kind Constants
fn PROVENANCE_MEASURED() -> i32 {
    0  // Empirical measurement (e.g., sensor data)
}

fn PROVENANCE_COMPUTED() -> i32 {
    1  // Derived via computation (e.g., integral of concentration)
}

fn PROVENANCE_ASSUMED() -> i32 {
    2  // Assumption or approximation (e.g., ideal gas law)
}

fn PROVENANCE_INFERRED() -> i32 {
    3  // Inferred from other values (e.g., Bayesian update)
}

// Knowledge Constructor
fn knowledge_new(type_idx: i64, confidence: f64, provenance: Provenance) -> Knowledge {
    Knowledge {
        type_idx: type_idx,
        confidence: confidence,
        provenance: provenance,
    }
}

// Specialized Constructors

// For measured values: ε = measurement error (absolute or relative)
fn knowledge_measured(type_idx: i64, epsilon: f64) -> Knowledge {
    let prov = Provenance {
        kind: PROVENANCE_MEASURED(),
        source: -1,  // No specific source (direct measurement)
        derivation_depth: 0,
    };
    knowledge_new(type_idx, epsilon, prov)
}

// For assumed values: ε = assumed uncertainty
fn knowledge_assumed(type_idx: i64, epsilon: f64) -> Knowledge {
    let prov = Provenance {
        kind: PROVENANCE_ASSUMED(),
        source: -1,  // Assumption, no external source
        derivation_depth: 0,
    };
    knowledge_new(type_idx, epsilon, prov)
}

// For computed values: typically called internally during propagation
fn knowledge_computed(type_idx: i64, epsilon: f64, source: i64, parent_depth: i64) -> Knowledge {
    let prov = Provenance {
        kind: PROVENANCE_COMPUTED(),
        source: source,
        derivation_depth: parent_depth + 1,
    };
    knowledge_new(type_idx, epsilon, prov)
}

// For inferred values: e.g., from models
fn knowledge_inferred(type_idx: i64, epsilon: f64, source: i64, parent_depth: i64) -> Knowledge {
    let prov = Provenance {
        kind: PROVENANCE_INFERRED(),
        source: source,
        derivation_depth: parent_depth + 1,
    };
    knowledge_new(type_idx, epsilon, prov)
}

// Confidence Queries

// Absolute confidence: 1 - ε (e.g., ε=0.05 -> 0.95 or 95%)
fn knowledge_confidence(k: Knowledge) -> f64 {
    1.0 - k.confidence
}

// Relative confidence: useful for error propagation
fn knowledge_relative_confidence(k: Knowledge, nominal_value: f64) -> f64 {
    if nominal_value == 0.0 {
        0.0  // Undefined for zero
    } else {
        k.confidence / nominal_value.abs()
    }
}

// Bound Combination Operations

// Union: Conservative (widest uncertainty bound)
fn knowledge_union(k1: Knowledge, k2: Knowledge) -> Knowledge {
    var result = k1;
    // Take the maximum ε (worst-case uncertainty)
    if k2.confidence > k1.confidence {
        result.confidence = k2.confidence;
        // Inherit provenance from the more uncertain source
        result.provenance = k2.provenance;
    }
    // Update type_idx if mismatched (error in full system)
    if k1.type_idx != k2.type_idx {
        // Compiler error expected here
    }
    result
}

// Intersection: Optimistic (narrowest bound, assumes correlation)
fn knowledge_intersect(k1: Knowledge, k2: Knowledge) -> Knowledge {
    var result = k1;
    // Take the minimum ε (best-case)
    if k2.confidence < k1.confidence {
        result.confidence = k2.confidence;
        result.provenance = k2.provenance;
    }
    // Type check
    if k1.type_idx != k2.type_idx {
        // Compiler error
    }
    result
}

// Uncertainty Propagation for Arithmetic

// Helper: Compute max derivation depth
fn max(a: i64, b: i64) -> i64 {
    if a > b {
        a
    } else {
        b
    }
}

// Addition/Subtraction: ε_result = ε_a + ε_b (absolute errors add)
fn knowledge_add(k_a: Knowledge, k_b: Knowledge) -> Knowledge {
    let result_eps = k_a.confidence + k_b.confidence;
    let max_depth = max(k_a.provenance.derivation_depth, k_b.provenance.derivation_depth);
    var result = knowledge_computed(k_a.type_idx, result_eps, -1, max_depth);
    result
}

fn knowledge_sub(k_a: Knowledge, k_b: Knowledge) -> Knowledge {
    // Uncertainty propagates identically to addition
    knowledge_add(k_a, k_b)
}

// Multiplication: ε_result ≈ |a| * ε_b + |b| * ε_a (absolute)
// But spec uses relative: combines relative errors
fn knowledge_mul(k_a: Knowledge, k_b: Knowledge, value_a: f64, value_b: f64) -> Knowledge with Panic, Div {
    // Compute relative errors
    var rel_eps_a: f64 = 0.0;
    if value_a != 0.0 {
        rel_eps_a = k_a.confidence / value_a.abs();
    }

    var rel_eps_b: f64 = 0.0;
    if value_b != 0.0 {
        rel_eps_b = k_b.confidence / value_b.abs();
    }

    // Relative errors add (for independent uncertainties)
    let combined_rel_eps = rel_eps_a + rel_eps_b;

    // Absolute result ε
    let result_eps = combined_rel_eps * (value_a * value_b).abs();

    let max_depth = max(k_a.provenance.derivation_depth, k_b.provenance.derivation_depth);
    var result = knowledge_computed(k_a.type_idx, result_eps, -1, max_depth);
    result
}

// Division: ε_result ≈ |ε_a / b| + |a * ε_b / b²| (absolute)
fn knowledge_div(k_a: Knowledge, k_b: Knowledge, value_a: f64, value_b: f64) -> Knowledge with Panic, Div {
    if value_b == 0.0 {
        panic("Division by zero in uncertainty propagation");
    }

    // Absolute error propagation
    let term1 = k_a.confidence / value_b.abs();
    let term2 = value_a.abs() * k_b.confidence / (value_b * value_b).abs();

    let result_eps = term1 + term2;

    let max_depth = max(k_a.provenance.derivation_depth, k_b.provenance.derivation_depth);
    var result = knowledge_computed(k_a.type_idx, result_eps, -1, max_depth);
    result
}

// Power: Simplified for ε_result ≈ |n * a^(n-1) * ε_a| (for y = x^n)
fn knowledge_pow(k_a: Knowledge, value_a: f64, exponent: f64) -> Knowledge with Panic, Div {
    if value_a == 0.0 && exponent < 0.0 {
        panic("Undefined power in uncertainty propagation");
    }

    let result_eps = exponent.abs() * value_a.abs().powf(exponent - 1.0) * k_a.confidence;

    let max_depth = k_a.provenance.derivation_depth;
    var result = knowledge_computed(k_a.type_idx, result_eps, -1, max_depth);
    result
}

// Exponential: ε_result ≈ |e^x * ε_x| (for y = e^x)
fn knowledge_exp(k_a: Knowledge, value_a: f64) -> Knowledge with Panic, Div {
    let result_eps = value_a.exp() * k_a.confidence;

    let max_depth = k_a.provenance.derivation_depth;
    var result = knowledge_computed(k_a.type_idx, result_eps, -1, max_depth);
    result
}

// Logarithm: ε_result ≈ |ε_x / x| (for y = ln(x))
fn knowledge_log(k_a: Knowledge, value_a: f64) -> Knowledge with Panic, Div {
    if value_a <= 0.0 {
        panic("Log of non-positive in uncertainty propagation");
    }

    let result_eps = k_a.confidence / value_a;

    let max_depth = k_a.provenance.derivation_depth;
    var result = knowledge_computed(k_a.type_idx, result_eps, -1, max_depth);
    result
}

// Unwrapping with Justification

// Extract inner value, but requires justification string
// In full system: Knowledge<T> unwraps to T
// Here: Placeholder returns confidence (actual impl would return value)
fn knowledge_unwrap(k: Knowledge, reason: &str) -> f64 {
    // Compiler enforces: reason.len() > 0
    // Runtime: Log warning if k.confidence > threshold
    if k.confidence > 0.1 {
        // Warn: "Unwrapping high uncertainty: " + reason
    }
    k.confidence  // Placeholder; real: return inner_value
}

// Safe unwrap with confidence check
fn knowledge_unwrap_safe(k: Knowledge, reason: &str, min_conf: f64) -> f64 with Panic {
    if knowledge_confidence(k) < min_conf {
        panic("Insufficient confidence for unwrap: " + reason);
    }
    knowledge_unwrap(k, reason)
}

// Type Checking and Validation

struct KnowledgeCheckResult {
    is_valid: bool,
    reason_required: bool,
    min_confidence: f64,
    suggested_action: &str,  // e.g., "Provide justification" or "Refine measurement"
}

fn check_knowledge_use(k: Knowledge, context_min_conf: f64) -> KnowledgeCheckResult {
    let conf = knowledge_confidence(k);
    var result = KnowledgeCheckResult {
        is_valid: conf >= context_min_conf,
        reason_required: k.confidence > 0.05,  // >5% error needs reason
        min_confidence: context_min_conf,
        suggested_action: if conf < 0.9 { "Consider propagation or refinement" } else { "" },
    };
    result
}

// Refinement: Narrow bounds based on additional evidence
fn knowledge_refine(k: Knowledge, new_epsilon: f64, evidence_source: i64) -> Knowledge {
    if new_epsilon >= k.confidence {
        // Cannot widen; error
        panic("Refinement cannot increase uncertainty");
    }
    var result = k;
    result.confidence = new_epsilon;
    result.provenance.source = evidence_source;
    result.provenance.kind = PROVENANCE_INFERRED();
    result.provenance.derivation_depth += 1;
    result
}

// PKPD-Specific Integrations

// Type Indices (assumed defined elsewhere; examples)
fn DOSE_TYPE() -> i64 { 1001 }
fn CONC_TYPE() -> i64 { 1002 }
fn AUC_TYPE() -> i64 { 1003 }
fn CLEARANCE_TYPE() -> i64 { 1004 }

// Measured concentration (e.g., from assay)
fn measure_concentration(nominal_value: f64, measurement_error: f64) -> Knowledge {
    knowledge_measured(CONC_TYPE(), measurement_error)
}

// Assumed bioavailability (F)
fn assume_bioavailability(assumed_f: f64, uncertainty: f64) -> Knowledge {
    knowledge_assumed(CONC_TYPE(), uncertainty)
}

// Computed Clearance: CL = Dose / AUC
// Note: Pass nominal values for propagation
fn compute_clearance(dose_k: Knowledge, auc_k: Knowledge, dose_value: f64, auc_value: f64) -> Knowledge {
    let cl_k = knowledge_div(dose_k, auc_k, dose_value, auc_value);
    // Type as clearance
    var result = cl_k;
    result.type_idx = CLEARANCE_TYPE();
    result
}

// Volume of Distribution: Vd = Dose / C_max
fn compute_vd(dose_k: Knowledge, cmax_k: Knowledge, dose_value: f64, cmax_value: f64) -> Knowledge {
    let vd_k = knowledge_div(dose_k, cmax_k, dose_value, cmax_value);
    var result = vd_k;
    result.type_idx = CLEARANCE_TYPE();  // Reuse or define Vd_TYPE
    result
}

// Half-life: t1/2 = 0.693 * Vd / CL
fn compute_half_life(vd_k: Knowledge, cl_k: Knowledge, vd_value: f64, cl_value: f64) -> Knowledge {
    // t1/2 = ln(2) * Vd / CL
    let ln2: f64 = 0.693147;
    // First, Vd / CL
    let ratio_k = knowledge_div(vd_k, cl_k, vd_value, cl_value);
    let ratio_value = vd_value / cl_value;
    // Then multiply by ln2 (certain)
    let certain_ln2 = knowledge_measured(CONC_TYPE(), 0.0);  // ε=0
    knowledge_mul(ratio_k, certain_ln2, ratio_value, ln2)
}

