// stdlib/compiler/linear/modality.sio
// Linear type system - minimal bootstrap stub

fn MODALITY_UNRESTRICTED() -> i32 { 0 }
fn MODALITY_AFFINE() -> i32 { 2 }
fn MODALITY_LINEAR() -> i32 { 3 }

struct LinearType {
    modality: i32,
    base_type: i64,
}

fn create_unrestricted(base: i64) -> LinearType {
    LinearType { modality: MODALITY_UNRESTRICTED(), base_type: base }
}

fn create_linear(base: i64) -> LinearType {
    LinearType { modality: MODALITY_LINEAR(), base_type: base }
}
