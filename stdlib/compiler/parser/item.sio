// compiler::parser::item — Top-Level Item AST Nodes
//
// Item types for the self-hosted Sounio parser.

// ============================================================================
// ITEM KIND CONSTANTS
// ============================================================================

fn ITEM_FN() -> i32 { 0 }
fn ITEM_STRUCT() -> i32 { 1 }
fn ITEM_ENUM() -> i32 { 2 }
fn ITEM_TRAIT() -> i32 { 3 }
fn ITEM_IMPL() -> i32 { 4 }
fn ITEM_TYPE_ALIAS() -> i32 { 5 }
fn ITEM_EFFECT() -> i32 { 6 }
fn ITEM_HANDLER() -> i32 { 7 }
fn ITEM_IMPORT() -> i32 { 8 }
fn ITEM_EXPORT() -> i32 { 9 }
fn ITEM_EXTERN() -> i32 { 10 }
fn ITEM_GLOBAL() -> i32 { 11 }
fn ITEM_ODE() -> i32 { 12 }
fn ITEM_PDE() -> i32 { 13 }
fn ITEM_CAUSAL() -> i32 { 14 }
fn ITEM_MODULE() -> i32 { 15 }
fn ITEM_ONTOLOGY_IMPORT() -> i32 { 16 }

// ============================================================================
// FORWARD DECLARATIONS (from ast.sio)
// ============================================================================

struct Span {
    start: i64,
    end: i64,
}

struct NodeId {
    value: i64,
}

struct PathSegment {
    name: [i8; 64],
    name_len: i64,
    generic_args: [i64; 8],
    n_generics: i64,
}

struct Path {
    segments: [PathSegment; 8],
    n_segments: i64,
}

struct Block {
    stmt_indices: [i64; 256],
    n_stmts: i64,
    has_trailing_expr: bool,
    trailing_expr_idx: i64,
}

struct Pattern {
    kind: i32,
    name: [i8; 64],
    name_len: i64,
    is_mut: bool,
    sub_patterns: [i64; 16],
    n_sub_patterns: i64,
    field_names: [[i8; 64]; 16],
    field_name_lens: [i64; 16],
    n_fields: i64,
    literal_kind: i32,
    literal_int: i64,
    path_str: [i8; 128],
    path_len: i64,
}

// ============================================================================
// GENERICS
// ============================================================================

struct GenericParam {
    name: [i8; 64],
    name_len: i64,
    // Bounds (indices into type pool)
    bound_indices: [i64; 8],
    n_bounds: i64,
    // Default type (index into type pool)
    has_default: bool,
    default_type_idx: i64,
}

fn generic_param_new() -> GenericParam {
    GenericParam {
        name: [0; 64],
        name_len: 0,
        bound_indices: [0; 8],
        n_bounds: 0,
        has_default: false,
        default_type_idx: -1,
    }
}

struct Generics {
    params: [GenericParam; 16],
    n_params: i64,
}

fn generics_new() -> Generics {
    Generics {
        params: [generic_param_new(); 16],
        n_params: 0,
    }
}

// ============================================================================
// FUNCTION PARAMETER
// ============================================================================

struct Param {
    id: NodeId,
    is_mut: bool,
    pattern_idx: i64,
    type_idx: i64,
    name: [i8; 64],
    name_len: i64,
}

fn param_new() -> Param {
    Param {
        id: NodeId { value: 0 },
        is_mut: false,
        pattern_idx: -1,
        type_idx: -1,
        name: [0; 64],
        name_len: 0,
    }
}

// ============================================================================
// EFFECT REFERENCE
// ============================================================================

struct EffectRef {
    path: Path,
    // Type arguments for parameterized effects
    type_args: [i64; 8],
    n_type_args: i64,
}

fn effect_ref_new() -> EffectRef {
    var seg = PathSegment {
        name: [0; 64],
        name_len: 0,
        generic_args: [0; 8],
        n_generics: 0,
    };
    EffectRef {
        path: Path { segments: [seg; 8], n_segments: 0 },
        type_args: [0; 8],
        n_type_args: 0,
    }
}

// ============================================================================
// FUNCTION MODIFIERS
// ============================================================================

struct FnModifiers {
    is_async: bool,
    is_unsafe: bool,
    is_const: bool,
    is_extern: bool,
    is_kernel: bool,
}

fn fn_modifiers_new() -> FnModifiers {
    FnModifiers {
        is_async: false,
        is_unsafe: false,
        is_const: false,
        is_extern: false,
        is_kernel: false,
    }
}

