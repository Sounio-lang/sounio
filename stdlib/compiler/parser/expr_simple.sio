// compiler::parser::expr_simple — Simplified Expression Parser Test
//
// A simplified expression parser that demonstrates the Pratt parsing approach
// without the complex memory management.

extern "C" {
    fn print(s: &str) -> ();
}

// ============================================================================
// TOKEN KINDS
// ============================================================================

fn TK_EOF() -> i32 { 0 }
fn TK_IDENT() -> i32 { 200 }
fn TK_INT_LIT() -> i32 { 201 }
fn TK_FLOAT_LIT() -> i32 { 205 }
fn TK_TRUE() -> i32 { 39 }
fn TK_FALSE() -> i32 { 40 }

fn TK_PLUS() -> i32 { 220 }
fn TK_MINUS() -> i32 { 221 }
fn TK_STAR() -> i32 { 222 }
fn TK_SLASH() -> i32 { 223 }
fn TK_PERCENT() -> i32 { 224 }
fn TK_AMP_AMP() -> i32 { 244 }
fn TK_PIPE_PIPE() -> i32 { 245 }
fn TK_EQ_EQ() -> i32 { 240 }
fn TK_NE() -> i32 { 241 }
fn TK_LT() -> i32 { 231 }
fn TK_GT() -> i32 { 232 }
fn TK_LE() -> i32 { 242 }
fn TK_GE() -> i32 { 243 }
fn TK_LPAREN() -> i32 { 280 }
fn TK_RPAREN() -> i32 { 281 }
fn TK_BANG() -> i32 { 229 }

// ============================================================================
// PRECEDENCE LEVELS
// ============================================================================

fn PREC_NONE() -> i32 { 0 }
fn PREC_OR() -> i32 { 2 }
fn PREC_AND() -> i32 { 3 }
fn PREC_EQUALITY() -> i32 { 4 }
fn PREC_COMPARISON() -> i32 { 5 }
fn PREC_TERM() -> i32 { 11 }
fn PREC_FACTOR() -> i32 { 12 }
fn PREC_UNARY() -> i32 { 13 }

fn get_precedence(kind: i32) -> i32 {
    if kind == TK_PIPE_PIPE() { return PREC_OR() }
    if kind == TK_AMP_AMP() { return PREC_AND() }
    if kind == TK_EQ_EQ() || kind == TK_NE() { return PREC_EQUALITY() }
    if kind == TK_LT() || kind == TK_GT() || kind == TK_LE() || kind == TK_GE() {
        return PREC_COMPARISON()
    }
    if kind == TK_PLUS() || kind == TK_MINUS() { return PREC_TERM() }
    if kind == TK_STAR() || kind == TK_SLASH() || kind == TK_PERCENT() {
        return PREC_FACTOR()
    }
    PREC_NONE()
}

// ============================================================================
// BINARY OPERATORS
// ============================================================================

fn BINOP_ADD() -> i32 { 0 }
fn BINOP_SUB() -> i32 { 1 }
fn BINOP_MUL() -> i32 { 2 }
fn BINOP_DIV() -> i32 { 3 }
fn BINOP_REM() -> i32 { 4 }
fn BINOP_AND() -> i32 { 5 }
fn BINOP_OR() -> i32 { 6 }
fn BINOP_EQ() -> i32 { 12 }
fn BINOP_NE() -> i32 { 13 }
fn BINOP_LT() -> i32 { 14 }
fn BINOP_LE() -> i32 { 15 }
fn BINOP_GT() -> i32 { 16 }
fn BINOP_GE() -> i32 { 17 }

fn token_to_binop(kind: i32) -> i32 {
    if kind == TK_PLUS() { return BINOP_ADD() }
    if kind == TK_MINUS() { return BINOP_SUB() }
    if kind == TK_STAR() { return BINOP_MUL() }
    if kind == TK_SLASH() { return BINOP_DIV() }
    if kind == TK_PERCENT() { return BINOP_REM() }
    if kind == TK_AMP_AMP() { return BINOP_AND() }
    if kind == TK_PIPE_PIPE() { return BINOP_OR() }
    if kind == TK_EQ_EQ() { return BINOP_EQ() }
    if kind == TK_NE() { return BINOP_NE() }
    if kind == TK_LT() { return BINOP_LT() }
    if kind == TK_LE() { return BINOP_LE() }
    if kind == TK_GT() { return BINOP_GT() }
    if kind == TK_GE() { return BINOP_GE() }
    -1
}

// ============================================================================
// EXPRESSION KINDS
// ============================================================================

fn EXPR_INT() -> i32 { 0 }
fn EXPR_FLOAT() -> i32 { 1 }
fn EXPR_BOOL() -> i32 { 2 }
fn EXPR_IDENT() -> i32 { 3 }
fn EXPR_BINARY() -> i32 { 4 }
fn EXPR_UNARY() -> i32 { 5 }
fn EXPR_PAREN() -> i32 { 6 }

// ============================================================================
// SIMPLE TOKEN STREAM (using arrays)
// ============================================================================

struct Token {
    kind: i32,
    int_val: i64,
    float_val: f64,
    name: [i8; 32],
    name_len: i64,
}

fn token_new() -> Token {
    Token {
        kind: TK_EOF(),
        int_val: 0,
        float_val: 0.0,
        name: [0; 32],
        name_len: 0,
    }
}

// ============================================================================
// SIMPLE EXPRESSION NODE (stack-allocated)
// ============================================================================

struct SimpleExpr {
    kind: i32,
    int_val: i64,
    float_val: f64,
    bool_val: bool,
    binop: i32,
    unop: i32,
    // For a simplified tree, we track depth instead of pointers
    depth: i32,
}

fn simple_expr_new() -> SimpleExpr {
    SimpleExpr {
        kind: EXPR_INT(),
        int_val: 0,
        float_val: 0.0,
        bool_val: false,
        binop: 0,
        unop: 0,
        depth: 0,
    }
}

fn simple_expr_int(v: i64) -> SimpleExpr {
    var e = simple_expr_new();
    e.kind = EXPR_INT();
    e.int_val = v;
    e
}

fn simple_expr_binary(op: i32, depth: i32) -> SimpleExpr {
    var e = simple_expr_new();
    e.kind = EXPR_BINARY();
    e.binop = op;
    e.depth = depth;
    e
}

// ============================================================================
// PARSE STATE (position in token array)
// ============================================================================

struct ParseState {
    tokens: [Token; 64],
    n_tokens: i64,
    pos: i64,
}

fn parse_state_new() -> ParseState {
    ParseState {
        tokens: [token_new(); 64],
        n_tokens: 0,
        pos: 0,
    }
}

fn ps_peek(s: ParseState) -> i32 {
    if s.pos < s.n_tokens {
        s.tokens[s.pos as usize].kind
    } else {
        TK_EOF()
    }
}

fn ps_at(s: ParseState, kind: i32) -> bool {
    ps_peek(s) == kind
}

fn ps_advance(s: ParseState) -> ParseState {
    var new_s = s;
    if new_s.pos < new_s.n_tokens {
        new_s.pos = new_s.pos + 1;
    }
    new_s
}

fn ps_current(s: ParseState) -> Token {
    if s.pos < s.n_tokens {
        s.tokens[s.pos as usize]
    } else {
        token_new()
    }
}

// ============================================================================
// PARSE RESULT
// ============================================================================

struct ParseResult {
    state: ParseState,
    expr: SimpleExpr,
    success: bool,
}

fn parse_ok(s: ParseState, e: SimpleExpr) -> ParseResult {
    ParseResult { state: s, expr: e, success: true }
}

fn parse_err(s: ParseState) -> ParseResult {
    ParseResult { state: s, expr: simple_expr_new(), success: false }
}

// ============================================================================
// PRIMARY PARSING
// ============================================================================

fn parse_primary(s: ParseState) -> ParseResult {
    var state = s;
    let kind = ps_peek(state);

    // Integer
    if kind == TK_INT_LIT() {
        let tok = ps_current(state);
        state = ps_advance(state);
        return parse_ok(state, simple_expr_int(tok.int_val))
    }

    // Float
    if kind == TK_FLOAT_LIT() {
        let tok = ps_current(state);
        state = ps_advance(state);
        var e = simple_expr_new();
        e.kind = EXPR_FLOAT();
        e.float_val = tok.float_val;
        return parse_ok(state, e)
    }

    // Bool
    if kind == TK_TRUE() {
        state = ps_advance(state);
        var e = simple_expr_new();
        e.kind = EXPR_BOOL();
        e.bool_val = true;
        return parse_ok(state, e)
    }
    if kind == TK_FALSE() {
        state = ps_advance(state);
        var e = simple_expr_new();
        e.kind = EXPR_BOOL();
        e.bool_val = false;
        return parse_ok(state, e)
    }

    // Identifier
    if kind == TK_IDENT() {
        let tok = ps_current(state);
        state = ps_advance(state);
        var e = simple_expr_new();
        e.kind = EXPR_IDENT();
        return parse_ok(state, e)
    }

    // Parenthesized expression
    if kind == TK_LPAREN() {
        state = ps_advance(state);
        let inner = parse_expr(state);
        if !inner.success {
            return inner
        }
        state = inner.state;

        if !ps_at(state, TK_RPAREN()) {
            return parse_err(state)
        }
        state = ps_advance(state);

        var e = inner.expr;
        e.kind = EXPR_PAREN();
        return parse_ok(state, e)
    }

    parse_err(state)
}

// ============================================================================
// UNARY PARSING
// ============================================================================

fn parse_unary(s: ParseState) -> ParseResult {
    var state = s;
    let kind = ps_peek(state);

    // Negation
    if kind == TK_MINUS() {
        state = ps_advance(state);
        let operand = parse_unary(state);
        if !operand.success {
            return operand
        }
        state = operand.state;

        var e = simple_expr_new();
        e.kind = EXPR_UNARY();
        e.unop = 0;  // NEG
        e.depth = operand.expr.depth + 1;
        return parse_ok(state, e)
    }

    // Logical not
    if kind == TK_BANG() {
        state = ps_advance(state);
        let operand = parse_unary(state);
        if !operand.success {
            return operand
        }
        state = operand.state;

        var e = simple_expr_new();
        e.kind = EXPR_UNARY();
        e.unop = 1;  // NOT
        e.depth = operand.expr.depth + 1;
        return parse_ok(state, e)
    }

    parse_primary(state)
}

// ============================================================================
// BINARY PARSING (Pratt parser)
// ============================================================================

fn parse_expr_prec(s: ParseState, min_prec: i32) -> ParseResult {
    var state = s;

    let left = parse_unary(state);
    if !left.success {
        return left
    }
    state = left.state;
    var left_expr = left.expr;

    loop {
        let op_kind = ps_peek(state);
        let op_prec = get_precedence(op_kind);

        if op_prec < min_prec {
            break
        }

        state = ps_advance(state);

        let right = parse_expr_prec(state, op_prec + 1);
        if !right.success {
            return right
        }
        state = right.state;

        var bin = simple_expr_binary(token_to_binop(op_kind), left_expr.depth + right.expr.depth + 1);
        left_expr = bin;
    }

    parse_ok(state, left_expr)
}

fn parse_expr(s: ParseState) -> ParseResult {
    parse_expr_prec(s, 1)
}

// ============================================================================
// TESTS
// ============================================================================

/// Test: "1 + 2"
fn test_simple_addition() -> bool {
    var state = parse_state_new();

    // Token 0: 1 (INT_LIT)
    state.tokens[0].kind = TK_INT_LIT();
    state.tokens[0].int_val = 1;

    // Token 1: + (PLUS)
    state.tokens[1].kind = TK_PLUS();

    // Token 2: 2 (INT_LIT)
    state.tokens[2].kind = TK_INT_LIT();
    state.tokens[2].int_val = 2;

    state.n_tokens = 3;

    let result = parse_expr(state);

    if !result.success {
        print("  Failed to parse\n");
        return false
    }

    if result.expr.kind != EXPR_BINARY() {
        print("  Expected BINARY, got other\n");
        return false
    }

    if result.expr.binop != BINOP_ADD() {
        print("  Expected ADD binop\n");
        return false
    }

    true
}

/// Test: "1 + 2 * 3" - checks precedence
fn test_precedence() -> bool {
    var state = parse_state_new();

    // 1 + 2 * 3
    state.tokens[0].kind = TK_INT_LIT();
    state.tokens[0].int_val = 1;
    state.tokens[1].kind = TK_PLUS();
    state.tokens[2].kind = TK_INT_LIT();
    state.tokens[2].int_val = 2;
    state.tokens[3].kind = TK_STAR();
    state.tokens[4].kind = TK_INT_LIT();
    state.tokens[4].int_val = 3;
    state.n_tokens = 5;

    let result = parse_expr(state);

    if !result.success {
        print("  Failed to parse\n");
        return false
    }

    // Should parse as (1 + (2 * 3)), depth = 3
    if result.expr.kind != EXPR_BINARY() {
        print("  Expected BINARY\n");
        return false
    }

    // Top-level should be ADD (lower precedence)
    if result.expr.binop != BINOP_ADD() {
        print("  Expected ADD at top level\n");
        return false
    }

    true
}

/// Test: "(1 + 2) * 3" - checks parentheses
fn test_parentheses() -> bool {
    var state = parse_state_new();

    // (1 + 2) * 3
    state.tokens[0].kind = TK_LPAREN();
    state.tokens[1].kind = TK_INT_LIT();
    state.tokens[1].int_val = 1;
    state.tokens[2].kind = TK_PLUS();
    state.tokens[3].kind = TK_INT_LIT();
    state.tokens[3].int_val = 2;
    state.tokens[4].kind = TK_RPAREN();
    state.tokens[5].kind = TK_STAR();
    state.tokens[6].kind = TK_INT_LIT();
    state.tokens[6].int_val = 3;
    state.n_tokens = 7;

    let result = parse_expr(state);

    if !result.success {
        print("  Failed to parse\n");
        return false
    }

    // Should parse as ((1 + 2) * 3), top is MUL
    if result.expr.binop != BINOP_MUL() {
        print("  Expected MUL at top level\n");
        return false
    }

    true
}

/// Test: "-x" - unary negation
fn test_unary_neg() -> bool {
    var state = parse_state_new();

    state.tokens[0].kind = TK_MINUS();
    state.tokens[1].kind = TK_IDENT();
    state.n_tokens = 2;

    let result = parse_expr(state);

    if !result.success {
        print("  Failed to parse\n");
        return false
    }

    if result.expr.kind != EXPR_UNARY() {
        print("  Expected UNARY\n");
        return false
    }

    true
}

/// Test: "a && b || c" - logical operators
fn test_logical_ops() -> bool {
    var state = parse_state_new();

    // a && b || c
    state.tokens[0].kind = TK_IDENT();
    state.tokens[1].kind = TK_AMP_AMP();
    state.tokens[2].kind = TK_IDENT();
    state.tokens[3].kind = TK_PIPE_PIPE();
    state.tokens[4].kind = TK_IDENT();
    state.n_tokens = 5;

    let result = parse_expr(state);

    if !result.success {
        print("  Failed to parse\n");
        return false
    }

    // Should parse as ((a && b) || c), top is OR
    if result.expr.binop != BINOP_OR() {
        print("  Expected OR at top level (has lower precedence than AND)\n");
        return false
    }
