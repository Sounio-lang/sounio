// compiler::parser::expr_simple
// Simplified expression parser - minimal bootstrap stub

fn TK_EOF() -> i32 { 0 }
fn TK_IDENT() -> i32 { 200 }
fn TK_INT_LIT() -> i32 { 201 }

fn EXPR_INT() -> i32 { 0 }
fn EXPR_BINARY() -> i32 { 4 }

fn BINOP_ADD() -> i32 { 0 }

struct Token {
    kind: i32,
    int_val: i64,
}

struct SimpleExpr {
    kind: i32,
    int_val: i64,
    binop: i32,
}

fn parse_expr() -> SimpleExpr {
    SimpleExpr { kind: EXPR_INT(), int_val: 0, binop: BINOP_ADD() }
}
