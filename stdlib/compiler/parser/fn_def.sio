// compiler::parser::fn_def — Function Definition AST Node
//
// Function definition for the self-hosted Sounio parser.

// ============================================================================
// IMPORTS (would use module system when available)
// ============================================================================

// Visibility constants
fn VIS_PRIVATE() -> i32 { 0 }
fn VIS_PUBLIC() -> i32 { 1 }

// ============================================================================
// FORWARD DECLARATIONS
// ============================================================================

struct Span {
    start: i64,
    end: i64,
}

struct NodeId {
    value: i64,
}

struct PathSegment {
    name: [i8; 64],
    name_len: i64,
    generic_args: [i64; 8],
    n_generics: i64,
}

struct Path {
    segments: [PathSegment; 8],
    n_segments: i64,
}

struct Block {
    stmt_indices: [i64; 256],
    n_stmts: i64,
    has_trailing_expr: bool,
    trailing_expr_idx: i64,
}

struct GenericParam {
    name: [i8; 64],
    name_len: i64,
    bound_indices: [i64; 8],
    n_bounds: i64,
    has_default: bool,
    default_type_idx: i64,
}

struct Generics {
    params: [GenericParam; 16],
    n_params: i64,
}

struct Param {
    id: NodeId,
    is_mut: bool,
    pattern_idx: i64,
    type_idx: i64,
    name: [i8; 64],
    name_len: i64,
}

struct EffectRef {
    path: Path,
    type_args: [i64; 8],
    n_type_args: i64,
}

struct FnModifiers {
    is_async: bool,
    is_unsafe: bool,
    is_const: bool,
    is_extern: bool,
    is_kernel: bool,
}

// ============================================================================
// FUNCTION DEFINITION
// ============================================================================

struct FnDef {
    id: NodeId,
    visibility: i32,
    modifiers: FnModifiers,
    name: [i8; 64],
    name_len: i64,
    generics: Generics,
    params: [Param; 32],
    n_params: i64,
    has_return_type: bool,
    return_type_idx: i64,  // Index into type pool
    effects: [EffectRef; 8],
    n_effects: i64,
    body: Block,
    span: Span,
}

fn fn_def_new() -> FnDef {
    var seg = PathSegment {
        name: [0; 64],
        name_len: 0,
        generic_args: [0; 8],
        n_generics: 0,
    };
    var gp = GenericParam {
        name: [0; 64],
        name_len: 0,
        bound_indices: [0; 8],
        n_bounds: 0,
        has_default: false,
        default_type_idx: -1,
    };
    var param = Param {
        id: NodeId { value: 0 },
        is_mut: false,
        pattern_idx: -1,
        type_idx: -1,
        name: [0; 64],
        name_len: 0,
    };
    var effect = EffectRef {
        path: Path { segments: [seg; 8], n_segments: 0 },
        type_args: [0; 8],
        n_type_args: 0,
    };
    FnDef {
        id: NodeId { value: 0 },
        visibility: VIS_PRIVATE(),
        modifiers: FnModifiers {
            is_async: false,
            is_unsafe: false,
            is_const: false,
            is_extern: false,
            is_kernel: false,
        },
        name: [0; 64],
        name_len: 0,
        generics: Generics { params: [gp; 16], n_params: 0 },
        params: [param; 32],
        n_params: 0,
        has_return_type: false,
        return_type_idx: -1,
        effects: [effect; 8],
        n_effects: 0,
        body: Block {
            stmt_indices: [0; 256],
            n_stmts: 0,
            has_trailing_expr: false,
            trailing_expr_idx: -1,
        },
        span: Span { start: 0, end: 0 },
    }
}

