// compiler::parser::struct_def — Struct Definition AST Node
//
// Struct definition for the self-hosted Sounio parser.

// ============================================================================
// FORWARD DECLARATIONS
// ============================================================================

struct Span {
    start: i64,
    end: i64,
}

struct NodeId {
    value: i64,
}

struct GenericParam {
    name: [i8; 64],
    name_len: i64,
    bound_indices: [i64; 8],
    n_bounds: i64,
    has_default: bool,
    default_type_idx: i64,
}

struct Generics {
    params: [GenericParam; 16],
    n_params: i64,
}

// ============================================================================
// TYPE MODIFIERS
// ============================================================================

struct TypeModifiers {
    is_linear: bool,
    is_affine: bool,
    is_copy: bool,
}

fn type_modifiers_new() -> TypeModifiers {
    TypeModifiers {
        is_linear: false,
        is_affine: false,
        is_copy: false,
    }
}

// ============================================================================
// FIELD DEFINITION
// ============================================================================

struct FieldDef {
    id: NodeId,
    visibility: i32,
    name: [i8; 64],
    name_len: i64,
    type_idx: i64,  // Index into type pool
}

fn field_def_new() -> FieldDef {
    FieldDef {
        id: NodeId { value: 0 },
        visibility: 0,
        name: [0; 64],
        name_len: 0,
        type_idx: -1,
    }
}

// ============================================================================
// STRUCT DEFINITION
// ============================================================================

struct StructDef {
    id: NodeId,
    visibility: i32,
    modifiers: TypeModifiers,
    name: [i8; 64],
    name_len: i64,
    generics: Generics,
    fields: [FieldDef; 64],
    n_fields: i64,
    span: Span,
}

fn struct_def_new() -> StructDef {
    var gp = GenericParam {
        name: [0; 64],
        name_len: 0,
        bound_indices: [0; 8],
        n_bounds: 0,
        has_default: false,
        default_type_idx: -1,
    };
    StructDef {
        id: NodeId { value: 0 },
        visibility: 0,
        modifiers: TypeModifiers {
            is_linear: false,
            is_affine: false,
            is_copy: false,
        },
        name: [0; 64],
        name_len: 0,
        generics: Generics { params: [gp; 16], n_params: 0 },
        fields: [field_def_new(); 64],
        n_fields: 0,
        span: Span { start: 0, end: 0 },
    }
}

// ============================================================================
// ENUM DEFINITION
// ============================================================================

// Variant data kind
fn VARIANT_UNIT() -> i32 { 0 }
fn VARIANT_TUPLE() -> i32 { 1 }
fn VARIANT_STRUCT() -> i32 { 2 }

struct VariantDef {
    id: NodeId,
    name: [i8; 64],
    name_len: i64,
    data_kind: i32,
    // For tuple variants: type indices
    tuple_types: [i64; 16],
    n_tuple_types: i64,
    // For struct variants: fields
    fields: [FieldDef; 16],
    n_fields: i64,
}

fn variant_def_new() -> VariantDef {
    VariantDef {
        id: NodeId { value: 0 },
        name: [0; 64],
        name_len: 0,
        data_kind: VARIANT_UNIT(),
        tuple_types: [0; 16],
        n_tuple_types: 0,
        fields: [field_def_new(); 16],
        n_fields: 0,
    }
}

struct EnumDef {
    id: NodeId,
    visibility: i32,
    modifiers: TypeModifiers,
    name: [i8; 64],
    name_len: i64,
    generics: Generics,
    variants: [VariantDef; 64],
    n_variants: i64,
    span: Span,
}

fn enum_def_new() -> EnumDef {
    var gp = GenericParam {
        name: [0; 64],
        name_len: 0,
        bound_indices: [0; 8],
        n_bounds: 0,
        has_default: false,
        default_type_idx: -1,
    };
    EnumDef {
        id: NodeId { value: 0 },
        visibility: 0,
        modifiers: type_modifiers_new(),
        name: [0; 64],
        name_len: 0,
        generics: Generics { params: [gp; 16], n_params: 0 },
        variants: [variant_def_new(); 64],
        n_variants: 0,
        span: Span { start: 0, end: 0 },
    }
}

