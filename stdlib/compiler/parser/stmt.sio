// compiler::parser::stmt — Statement AST Nodes
//
// Statement types for the self-hosted Sounio parser.

// ============================================================================
// STATEMENT KIND CONSTANTS
// ============================================================================

fn STMT_LET() -> i32 { 0 }      // let x = ...
fn STMT_VAR() -> i32 { 1 }      // var x = ...
fn STMT_EXPR() -> i32 { 2 }     // expr;
fn STMT_ASSIGN() -> i32 { 3 }   // x = ...
fn STMT_EMPTY() -> i32 { 4 }    // ;

// ============================================================================
// ASSIGNMENT OPERATORS
// ============================================================================

fn ASSIGN_EQ() -> i32 { 0 }         // =
fn ASSIGN_ADD_EQ() -> i32 { 1 }     // +=
fn ASSIGN_SUB_EQ() -> i32 { 2 }     // -=
fn ASSIGN_MUL_EQ() -> i32 { 3 }     // *=
fn ASSIGN_DIV_EQ() -> i32 { 4 }     // /=
fn ASSIGN_REM_EQ() -> i32 { 5 }     // %=
fn ASSIGN_BIT_AND_EQ() -> i32 { 6 } // &=
fn ASSIGN_BIT_OR_EQ() -> i32 { 7 }  // |=
fn ASSIGN_BIT_XOR_EQ() -> i32 { 8 } // ^=
fn ASSIGN_SHL_EQ() -> i32 { 9 }     // <<=
fn ASSIGN_SHR_EQ() -> i32 { 10 }    // >>=

// ============================================================================
// PATTERN KIND CONSTANTS
// ============================================================================

fn PAT_IDENT() -> i32 { 0 }      // x
fn PAT_WILDCARD() -> i32 { 1 }   // _
fn PAT_TUPLE() -> i32 { 2 }      // (a, b)
fn PAT_STRUCT() -> i32 { 3 }     // Foo { x, y }
fn PAT_ENUM() -> i32 { 4 }       // Some(x)
fn PAT_LITERAL() -> i32 { 5 }    // 42
fn PAT_RANGE() -> i32 { 6 }      // 1..10
fn PAT_OR() -> i32 { 7 }         // a | b
fn PAT_REF() -> i32 { 8 }        // &x
fn PAT_MUT() -> i32 { 9 }        // mut x

// ============================================================================
// PATTERN
// ============================================================================

struct Pattern {
    kind: i32,
    name: [i8; 64],
    name_len: i64,
    is_mut: bool,
    // For compound patterns (indices into pattern pool)
    sub_patterns: [i64; 16],
    n_sub_patterns: i64,
    // For struct patterns
    field_names: [[i8; 64]; 16],
    field_name_lens: [i64; 16],
    n_fields: i64,
    // For literal patterns
    literal_kind: i32,
    literal_int: i64,
    // Path for struct/enum patterns
    path_str: [i8; 128],
    path_len: i64,
}

fn pattern_new() -> Pattern {
    Pattern {
        kind: PAT_WILDCARD(),
        name: [0; 64],
        name_len: 0,
        is_mut: false,
        sub_patterns: [0; 16],
        n_sub_patterns: 0,
        field_names: [[0; 64]; 16],
        field_name_lens: [0; 16],
        n_fields: 0,
        literal_kind: 0,
        literal_int: 0,
        path_str: [0; 128],
        path_len: 0,
    }
}

fn pattern_ident(name: [i8; 64], len: i64, is_mut: bool) -> Pattern with Mut {
    var p = pattern_new();
    p.kind = PAT_IDENT();
    p.name = name;
    p.name_len = len;
    p.is_mut = is_mut;
    p
}

fn pattern_wildcard() -> Pattern with Mut {
    var p = pattern_new();
    p.kind = PAT_WILDCARD();
    p
}

// ============================================================================
// BLOCK
// ============================================================================

// Block of statements (indices into statement pool)
struct Block {
    stmt_indices: [i64; 256],
    n_stmts: i64,
    // Optional trailing expression (for block expressions)
    has_trailing_expr: bool,
    trailing_expr_idx: i64,
}

fn block_new() -> Block {
    Block {
        stmt_indices: [0; 256],
        n_stmts: 0,
        has_trailing_expr: false,
        trailing_expr_idx: -1,
    }
}

// ============================================================================
// STATEMENT
// ============================================================================

struct Stmt {
    kind: i32,
    // For let/var statements
    pattern_idx: i64,
    has_type: bool,
    type_idx: i64,
    has_value: bool,
    value_expr_idx: i64,
    // For expression statements
    expr_idx: i64,
    has_semi: bool,
    // For assignments
    target_expr_idx: i64,
    assign_op: i32,
}

fn stmt_new() -> Stmt {
    Stmt {
        kind: STMT_EMPTY(),
        pattern_idx: -1,
        has_type: false,
        type_idx: -1,
        has_value: false,
        value_expr_idx: -1,
        expr_idx: -1,
        has_semi: true,
        target_expr_idx: -1,
        assign_op: ASSIGN_EQ(),
    }
}

