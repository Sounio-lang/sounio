// compiler::parser::expr — Expression AST Nodes
//
// Expression types for the self-hosted Sounio parser.

// ============================================================================
// EXPRESSION KIND CONSTANTS
// ============================================================================

fn EXPR_LITERAL() -> i32 { 0 }
fn EXPR_PATH() -> i32 { 1 }
fn EXPR_BINARY() -> i32 { 2 }
fn EXPR_UNARY() -> i32 { 3 }
fn EXPR_CALL() -> i32 { 4 }
fn EXPR_METHOD_CALL() -> i32 { 5 }
fn EXPR_FIELD() -> i32 { 6 }
fn EXPR_INDEX() -> i32 { 7 }
fn EXPR_CAST() -> i32 { 8 }
fn EXPR_BLOCK() -> i32 { 9 }
fn EXPR_IF() -> i32 { 10 }
fn EXPR_MATCH() -> i32 { 11 }
fn EXPR_LOOP() -> i32 { 12 }
fn EXPR_WHILE() -> i32 { 13 }
fn EXPR_FOR() -> i32 { 14 }
fn EXPR_RETURN() -> i32 { 15 }
fn EXPR_BREAK() -> i32 { 16 }
fn EXPR_CONTINUE() -> i32 { 17 }
fn EXPR_CLOSURE() -> i32 { 18 }
fn EXPR_TUPLE() -> i32 { 19 }
fn EXPR_ARRAY() -> i32 { 20 }
fn EXPR_STRUCT_LIT() -> i32 { 21 }
fn EXPR_RANGE() -> i32 { 22 }
fn EXPR_TRY() -> i32 { 23 }
fn EXPR_AWAIT() -> i32 { 24 }

// ============================================================================
// LITERAL KIND CONSTANTS
// ============================================================================

fn LIT_INT() -> i32 { 0 }
fn LIT_FLOAT() -> i32 { 1 }
fn LIT_STRING() -> i32 { 2 }
fn LIT_CHAR() -> i32 { 3 }
fn LIT_BOOL() -> i32 { 4 }
fn LIT_UNIT() -> i32 { 5 }
fn LIT_INT_UNIT() -> i32 { 6 }    // 500_mg
fn LIT_FLOAT_UNIT() -> i32 { 7 }  // 10.5_mL

// ============================================================================
// BINARY OPERATORS
// ============================================================================

fn BINOP_ADD() -> i32 { 0 }
fn BINOP_SUB() -> i32 { 1 }
fn BINOP_MUL() -> i32 { 2 }
fn BINOP_DIV() -> i32 { 3 }
fn BINOP_REM() -> i32 { 4 }
fn BINOP_AND() -> i32 { 5 }   // &&
fn BINOP_OR() -> i32 { 6 }    // ||
fn BINOP_BIT_AND() -> i32 { 7 }
fn BINOP_BIT_OR() -> i32 { 8 }
fn BINOP_BIT_XOR() -> i32 { 9 }
fn BINOP_SHL() -> i32 { 10 }
fn BINOP_SHR() -> i32 { 11 }
fn BINOP_EQ() -> i32 { 12 }
fn BINOP_NE() -> i32 { 13 }
fn BINOP_LT() -> i32 { 14 }
fn BINOP_LE() -> i32 { 15 }
fn BINOP_GT() -> i32 { 16 }
fn BINOP_GE() -> i32 { 17 }

// ============================================================================
// UNARY OPERATORS
// ============================================================================

fn UNOP_NEG() -> i32 { 0 }      // -x
fn UNOP_NOT() -> i32 { 1 }      // !x
fn UNOP_REF() -> i32 { 2 }      // &x
fn UNOP_REF_MUT() -> i32 { 3 }  // &!x
fn UNOP_DEREF() -> i32 { 4 }    // *x

// ============================================================================
// LITERAL VALUE
// ============================================================================

struct LiteralValue {
    kind: i32,
    int_val: i64,
    float_val: f64,
    bool_val: bool,
    text: [i8; 256],
    text_len: i64,
    unit_suffix: [i8; 32],
    unit_suffix_len: i64,
}

fn literal_value_new() -> LiteralValue {
    LiteralValue {
        kind: LIT_UNIT(),
        int_val: 0,
        float_val: 0.0,
        bool_val: false,
        text: [0; 256],
        text_len: 0,
        unit_suffix: [0; 32],
        unit_suffix_len: 0,
    }
}

fn literal_int(v: i64) -> LiteralValue with Mut {
    var lit = literal_value_new();
    lit.kind = LIT_INT();
    lit.int_val = v;
    lit
}

fn literal_float(v: f64) -> LiteralValue with Mut {
    var lit = literal_value_new();
    lit.kind = LIT_FLOAT();
    lit.float_val = v;
    lit
}

fn literal_bool(v: bool) -> LiteralValue with Mut {
    var lit = literal_value_new();
    lit.kind = LIT_BOOL();
    lit.bool_val = v;
    lit
}

fn literal_unit() -> LiteralValue with Mut {
    var lit = literal_value_new();
    lit.kind = LIT_UNIT();
    lit
}

// ============================================================================
// EXPRESSION NODE
// ============================================================================

// Forward declare - will be defined in full parser
struct Span {
    start: i64,
    end: i64,
}

struct NodeId {
    value: i64,
}

struct Path {
    segments: [PathSegment; 8],
    n_segments: i64,
}

struct PathSegment {
    name: [i8; 64],
    name_len: i64,
    generic_args: [i64; 8],
    n_generics: i64,
}

