// compiler::parser::impl_def — Impl Block AST Node
//
// Implementation block for trait implementations in the self-hosted Sounio parser.

// ============================================================================
// FORWARD DECLARATIONS
// ============================================================================

struct Span {
    start: i64,
    end: i64,
}

struct NodeId {
    value: i64,
}

// ============================================================================
// IMPL BLOCK
// ============================================================================

// ImplBlock represents: impl Trait for Type { methods... }
struct ImplBlock {
    id: NodeId,
    trait_name: [i8; 64],
    trait_name_len: i64,
    type_name: [i8; 64],
    type_name_len: i64,
    // Indices to function definitions in pool
    methods: [i64; 32],
    method_count: i64,
    span: Span,
}

fn impl_block_new() -> ImplBlock {
    ImplBlock {
        id: NodeId { value: 0 },
        trait_name: [0; 64],
        trait_name_len: 0,
        type_name: [0; 64],
        type_name_len: 0,
        methods: [0; 32],
        method_count: 0,
        span: Span { start: 0, end: 0 },
    }
}
