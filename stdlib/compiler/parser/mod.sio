// compiler::parser — Self-hosted Sounio Parser
//
// This is the parser for the self-hosted Sounio compiler.
// It produces an AST from a token stream.
//
// Equivalent to compiler/src/parser/mod.rs in the Rust implementation.

// FFI for print
extern "C" {
    fn print(s: &str) -> ();
}

// ============================================================================
// TOKEN KIND CONSTANTS (from lexer)
// ============================================================================

fn TK_EOF() -> i32 { 0 }
fn TK_ERROR() -> i32 { 1 }
fn TK_IDENT() -> i32 { 200 }
fn TK_INT_LIT() -> i32 { 201 }
fn TK_FLOAT_LIT() -> i32 { 205 }
fn TK_STRING_LIT() -> i32 { 206 }

// Keywords
fn TK_MODULE() -> i32 { 10 }
fn TK_IMPORT() -> i32 { 11 }
fn TK_USE() -> i32 { 12 }
fn TK_FN() -> i32 { 14 }
fn TK_LET() -> i32 { 15 }
fn TK_VAR() -> i32 { 16 }
fn TK_CONST() -> i32 { 17 }
fn TK_STRUCT() -> i32 { 20 }
fn TK_ENUM() -> i32 { 21 }
fn TK_TRAIT() -> i32 { 22 }
fn TK_IMPL() -> i32 { 23 }
fn TK_IF() -> i32 { 24 }
fn TK_ELSE() -> i32 { 25 }
fn TK_MATCH() -> i32 { 26 }
fn TK_FOR() -> i32 { 27 }
fn TK_WHILE() -> i32 { 28 }
fn TK_LOOP() -> i32 { 29 }
fn TK_BREAK() -> i32 { 30 }
fn TK_CONTINUE() -> i32 { 31 }
fn TK_RETURN() -> i32 { 32 }
fn TK_TRUE() -> i32 { 39 }
fn TK_FALSE() -> i32 { 40 }
fn TK_PUB() -> i32 { 41 }
fn TK_TYPE() -> i32 { 43 }
fn TK_EXTERN() -> i32 { 45 }
fn TK_WITH() -> i32 { 53 }
fn TK_EFFECT() -> i32 { 50 }
fn TK_HANDLER() -> i32 { 51 }
fn TK_LINEAR() -> i32 { 54 }
fn TK_KERNEL() -> i32 { 70 }

// Operators and delimiters
fn TK_EQ() -> i32 { 230 }
fn TK_ARROW() -> i32 { 270 }
fn TK_FAT_ARROW() -> i32 { 271 }
fn TK_LPAREN() -> i32 { 280 }
fn TK_RPAREN() -> i32 { 281 }
fn TK_LBRACKET() -> i32 { 282 }
fn TK_RBRACKET() -> i32 { 283 }
fn TK_LBRACE() -> i32 { 284 }
fn TK_RBRACE() -> i32 { 285 }
fn TK_COMMA() -> i32 { 290 }
fn TK_SEMI() -> i32 { 291 }
fn TK_COLON() -> i32 { 292 }
fn TK_COLON_COLON() -> i32 { 293 }
fn TK_DOT() -> i32 { 294 }
fn TK_LT() -> i32 { 231 }
fn TK_GT() -> i32 { 232 }

// ============================================================================
// TOKEN AND SPAN (from lexer)
// ============================================================================

struct Span {
    start: i64,
    end: i64,
}

fn span_new(s: i64, e: i64) -> Span {
    Span { start: s, end: e }
}

struct Token {
    kind: i32,
    span: Span,
    text: [i8; 256],
    text_len: i64,
}

fn token_new() -> Token {
    Token {
        kind: TK_EOF(),
        span: Span { start: 0, end: 0 },
        text: [0; 256],
        text_len: 0,
    }
}

struct TokenStream {
    tokens: [Token; 16384],
    n_tokens: i64,
    pos: i64,
}

// ============================================================================
// NODE ID GENERATOR
// ============================================================================

struct IdGenerator {
    next_val: i64,
}

fn id_generator_new() -> IdGenerator {
    IdGenerator { next_val: 1 }
}

fn id_generator_next(gen: IdGenerator) -> IdGeneratorResult {
    IdGeneratorResult {
        gen: IdGenerator { next_val: gen.next_val + 1 },
        id: NodeId { value: gen.next_val },
    }
}

struct NodeId {
    value: i64,
}

struct IdGeneratorResult {
    gen: IdGenerator,
    id: NodeId,
}

// ============================================================================
// PARSER STATE
// ============================================================================

struct Parser {
    tokens: TokenStream,
    pos: i64,
    id_gen: IdGenerator,
    allow_struct_literals: bool,
    pending_gt: bool,
}

fn parser_new(tokens: TokenStream) -> Parser {
    Parser {
        tokens: tokens,
        pos: 0,
        id_gen: id_generator_new(),
        allow_struct_literals: true,
        pending_gt: false,
    }
}

// ============================================================================
// PARSER RESULT TYPE
// ============================================================================

struct ParseResult {
    parser: Parser,
    success: bool,
    error_msg: [i8; 256],
    error_len: i64,
}

fn parse_ok(p: Parser) -> ParseResult {
    ParseResult {
        parser: p,
        success: true,
        error_msg: [0; 256],
        error_len: 0,
    }
}

fn parse_err(p: Parser, msg: [i8; 256], len: i64) -> ParseResult {
    ParseResult {
        parser: p,
        success: false,
        error_msg: msg,
        error_len: len,
    }
}

// ============================================================================
// PARSER HELPER FUNCTIONS
// ============================================================================

/// Get current token
fn parser_current(p: Parser) -> Token {
    if p.pos < p.tokens.n_tokens {
        p.tokens.tokens[p.pos as usize]
    } else {
        // Return EOF token
        var tok = token_new();
        tok.kind = TK_EOF();
        tok
    }
}

/// Get current token kind
fn parser_peek(p: Parser) -> i32 {
    parser_current(p).kind
}

/// Look ahead n tokens
fn parser_peek_n(p: Parser, n: i64) -> i32 {
    let idx = p.pos + n;
    if idx < p.tokens.n_tokens {
        p.tokens.tokens[idx as usize].kind
    } else {
        TK_EOF()
    }
}

/// Check if at specific token kind
fn parser_at(p: Parser, kind: i32) -> bool {
    parser_peek(p) == kind
}

/// Check if at any of the given kinds
fn parser_at_any(p: Parser, k1: i32, k2: i32, k3: i32) -> bool {
    let curr = parser_peek(p);
    curr == k1 || curr == k2 || curr == k3
}

/// Advance parser and return the consumed token
fn parser_advance(p: Parser) -> ParserAdvanceResult {
    let tok = parser_current(p);
    var new_p = p;
    if new_p.pos < new_p.tokens.n_tokens {
        new_p.pos = new_p.pos + 1;
    }
    ParserAdvanceResult {
        parser: new_p,
        token: tok,
    }
}

struct ParserAdvanceResult {
    parser: Parser,
    token: Token,
}

/// Expect a specific token kind, advance if found
fn parser_expect(p: Parser, kind: i32) -> ParseResult {
    if parser_at(p, kind) {
        let result = parser_advance(p);
        parse_ok(result.parser)
    } else {
        var msg: [i8; 256] = [0; 256];
        // "Expected token kind N"
        msg[0] = 69; msg[1] = 120; msg[2] = 112; msg[3] = 101; // Expe
        msg[4] = 99; msg[5] = 116; msg[6] = 101; msg[7] = 100; // cted
        parse_err(p, msg, 8)
    }
}

/// Get current span
fn parser_span(p: Parser) -> Span {
    parser_current(p).span
}

/// Check if at EOF
fn parser_at_eof(p: Parser) -> bool {
    parser_at(p, TK_EOF())
}

// ============================================================================
// PATH PARSING
// ============================================================================

struct PathSegment {
    name: [i8; 64],
    name_len: i64,
    generic_args: [i64; 8],
    n_generics: i64,
}

fn path_segment_new() -> PathSegment {
    PathSegment {
        name: [0; 64],
        name_len: 0,
        generic_args: [0; 8],
        n_generics: 0,
    }
}

struct Path {
    segments: [PathSegment; 8],
    n_segments: i64,
}

fn path_new() -> Path {
    Path {
        segments: [path_segment_new(); 8],
        n_segments: 0,
    }
}

struct ParsePathResult {
    parser: Parser,
    path: Path,
    success: bool,
}

/// Parse a path: a::b::c
fn parse_path(p: Parser) -> ParsePathResult {
    var parser = p;
    var path = path_new();

    // First segment must be an identifier
    if !parser_at(parser, TK_IDENT()) {
        return ParsePathResult {
            parser: parser,
            path: path,
            success: false,
        }
    }

    // Parse first segment
    let adv = parser_advance(parser);
    parser = adv.parser;
    var seg = path_segment_new();

    // Copy token text to segment name
    var i: i64 = 0;
    while i < adv.token.text_len && i < 64 {
        seg.name[i as usize] = adv.token.text[i as usize];
        i = i + 1;
    }
    seg.name_len = adv.token.text_len;
    path.segments[0] = seg;
    path.n_segments = 1;

    // Parse remaining segments
    while parser_at(parser, TK_COLON_COLON()) && path.n_segments < 8 {
        // Consume ::
        let adv2 = parser_advance(parser);
        parser = adv2.parser;

        // Expect identifier
        if !parser_at(parser, TK_IDENT()) {
            return ParsePathResult {
                parser: parser,
                path: path,
                success: false,
            }
        }

        let adv3 = parser_advance(parser);
        parser = adv3.parser;

        var seg2 = path_segment_new();
        var j: i64 = 0;
        while j < adv3.token.text_len && j < 64 {
            seg2.name[j as usize] = adv3.token.text[j as usize];
            j = j + 1;
        }
        seg2.name_len = adv3.token.text_len;
        path.segments[path.n_segments as usize] = seg2;
        path.n_segments = path.n_segments + 1;
    }

    ParsePathResult {
        parser: parser,
        path: path,
        success: true,
    }
}

// ============================================================================
// TYPE EXPRESSION PARSING
// ============================================================================

// Type expression kind constants
fn TY_PATH() -> i32 { 0 }
fn TY_REF() -> i32 { 1 }
fn TY_REF_MUT() -> i32 { 2 }
fn TY_ARRAY() -> i32 { 3 }
fn TY_SLICE() -> i32 { 4 }
fn TY_TUPLE() -> i32 { 5 }
fn TY_FUNC() -> i32 { 6 }
fn TY_UNIT() -> i32 { 7 }

struct TypeExpr {
    kind: i32,
    span: Span,
    path: Path,
    is_mut: bool,
    inner_type_idx: i64,
    array_size: i64,
    element_types: [i64; 16],
    n_elements: i64,
}

fn type_expr_new() -> TypeExpr {
    TypeExpr {
        kind: TY_UNIT(),
        span: Span { start: 0, end: 0 },
        path: path_new(),
        is_mut: false,
        inner_type_idx: -1,
        array_size: 0,
        element_types: [0; 16],
        n_elements: 0,
    }
}

struct ParseTypeResult {
    parser: Parser,
    ty: TypeExpr,
    success: bool,
}

/// Parse a type expression
fn parse_type(p: Parser) -> ParseTypeResult {
    var parser = p;
    let start = parser_span(parser).start;

    // Check for reference types: & or &!
    if parser_at(parser, TK_AMP()) {
        let adv = parser_advance(parser);
        parser = adv.parser;

        // Check for &!
        let is_mut = parser_at(parser, TK_BANG());
        if is_mut {
            let adv2 = parser_advance(parser);
            parser = adv2.parser;
        }

        // Parse inner type
        let inner = parse_type(parser);
        if !inner.success {
            return inner
        }
        parser = inner.parser;

        var ty = type_expr_new();
        if is_mut {
            ty.kind = TY_REF_MUT();
        } else {
            ty.kind = TY_REF();
        }
        ty.span = span_new(start, parser_span(parser).end);

        return ParseTypeResult {
            parser: parser,
            ty: ty,
            success: true,
        }
    }

    // Check for unit type: ()
    if parser_at(parser, TK_LPAREN()) {
        let next = parser_peek_n(parser, 1);
        if next == TK_RPAREN() {
            let adv = parser_advance(parser);
            parser = adv.parser;
            let adv2 = parser_advance(parser);
            parser = adv2.parser;

            var ty = type_expr_new();
            ty.kind = TY_UNIT();
            ty.span = span_new(start, parser_span(parser).end);

            return ParseTypeResult {
                parser: parser,
                ty: ty,
                success: true,
            }
        }
    }

    // Check for array/slice: [T] or [T; N]
    if parser_at(parser, TK_LBRACKET()) {
        let adv = parser_advance(parser);
        parser = adv.parser;

        let elem = parse_type(parser);
        if !elem.success {
            return elem
        }
        parser = elem.parser;

        var ty = type_expr_new();

        if parser_at(parser, TK_SEMI()) {
            // Array: [T; N]
            let adv2 = parser_advance(parser);
            parser = adv2.parser;

            // Parse size expression (simplified: just integer)
            if parser_at(parser, TK_INT_LIT()) {
                let adv3 = parser_advance(parser);
                parser = adv3.parser;
                // Parse integer from text (simplified)
                ty.array_size = 0;  // Would parse actual integer
            }

            ty.kind = TY_ARRAY();
        } else {
            // Slice: [T]
            ty.kind = TY_SLICE();
        }

        // Expect ]
        if !parser_at(parser, TK_RBRACKET()) {
            return ParseTypeResult {
                parser: parser,
                ty: type_expr_new(),
                success: false,
            }
        }
        let adv4 = parser_advance(parser);
        parser = adv4.parser;

        ty.span = span_new(start, parser_span(parser).end);

        return ParseTypeResult {
            parser: parser,
            ty: ty,
            success: true,
        }
    }

    // Path type (most common): i32, String, foo::Bar<T>
    let path_result = parse_path(parser);
    if !path_result.success {
        return ParseTypeResult {
            parser: path_result.parser,
            ty: type_expr_new(),
            success: false,
        }
    }

    var ty = type_expr_new();
    ty.kind = TY_PATH();
    ty.path = path_result.path;
    ty.span = span_new(start, parser_span(path_result.parser).end);

    ParseTypeResult {
        parser: path_result.parser,
        ty: ty,
        success: true,
    }
}

// Operator tokens we need for type parsing
fn TK_AMP() -> i32 { 226 }
fn TK_BANG() -> i32 { 229 }

// ============================================================================
// ITEM PARSING
// ============================================================================

// Item kind constants
fn ITEM_FN() -> i32 { 0 }
fn ITEM_STRUCT() -> i32 { 1 }
fn ITEM_ENUM() -> i32 { 2 }
fn ITEM_TRAIT() -> i32 { 3 }
fn ITEM_IMPL() -> i32 { 4 }
fn ITEM_IMPORT() -> i32 { 8 }

struct Item {
    kind: i32,
    span: Span,
    // Function data
    fn_name: [i8; 64],
    fn_name_len: i64,
    // Struct data
    struct_name: [i8; 64],
    struct_name_len: i64,
}

fn item_new() -> Item {
    Item {
        kind: 0,
        span: Span { start: 0, end: 0 },
        fn_name: [0; 64],
        fn_name_len: 0,
        struct_name: [0; 64],
        struct_name_len: 0,
    }
}

struct ParseItemResult {
    parser: Parser,
    item: Item,
    success: bool,
}

/// Parse a top-level item
fn parse_item(p: Parser) -> ParseItemResult {
    var parser = p;

    // Skip doc comments
    while parser_at(parser, TK_DOC_COMMENT_OUTER()) || parser_at(parser, TK_DOC_COMMENT_INNER()) {
        let adv = parser_advance(parser);
        parser = adv.parser;
    }

    // Check visibility
    let is_pub = parser_at(parser, TK_PUB());
    if is_pub {
        let adv = parser_advance(parser);
        parser = adv.parser;
    }

    // Check modifiers (linear, kernel, etc.)
    let is_linear = parser_at(parser, TK_LINEAR());
    if is_linear {
        let adv = parser_advance(parser);
        parser = adv.parser;
    }

    let is_kernel = parser_at(parser, TK_KERNEL());
    if is_kernel {
        let adv = parser_advance(parser);
        parser = adv.parser;
    }

    // Dispatch based on keyword
    let curr = parser_peek(parser);

    if curr == TK_FN() {
        return parse_fn(parser)
    }

    if curr == TK_STRUCT() {
        return parse_struct(parser)
    }

    if curr == TK_ENUM() {
        return parse_enum(parser)
    }

    if curr == TK_IMPORT() || curr == TK_USE() {
        return parse_import(parser)
    }

    if curr == TK_EXTERN() {
        return parse_extern(parser)
    }

    // Unknown item
    ParseItemResult {
        parser: parser,
        item: item_new(),
        success: false,
    }
}

// Doc comment token kinds
fn TK_DOC_COMMENT_OUTER() -> i32 { 310 }
fn TK_DOC_COMMENT_INNER() -> i32 { 311 }

// ============================================================================
// FUNCTION PARSING
// ============================================================================

struct FnDef {
    name: [i8; 64],
    name_len: i64,
    n_params: i64,
    has_return_type: bool,
    return_type: TypeExpr,
    span: Span,
}

fn fn_def_new() -> FnDef {
    FnDef {
        name: [0; 64],
        name_len: 0,
        n_params: 0,
        has_return_type: false,
        return_type: type_expr_new(),
        span: Span { start: 0, end: 0 },
    }
}

struct ParseFnResult {
    parser: Parser,
    fn_def: FnDef,
    success: bool,
}

/// Parse function: fn name(params) -> ReturnType { body }
fn parse_fn(p: Parser) -> ParseItemResult {
    var parser = p;
    let start = parser_span(parser).start;

    // Consume 'fn'
    let adv = parser_advance(parser);
    parser = adv.parser;

    // Parse function name
    if !parser_at(parser, TK_IDENT()) {
        return ParseItemResult {
            parser: parser,
            item: item_new(),
            success: false,
        }
    }

    let name_adv = parser_advance(parser);
    parser = name_adv.parser;

    var item = item_new();
    item.kind = ITEM_FN();

    // Copy name
    var i: i64 = 0;
    while i < name_adv.token.text_len && i < 64 {
        item.fn_name[i as usize] = name_adv.token.text[i as usize];
        i = i + 1;
    }
    item.fn_name_len = name_adv.token.text_len;

    // Expect (
    if !parser_at(parser, TK_LPAREN()) {
        return ParseItemResult {
            parser: parser,
            item: item_new(),
            success: false,
        }
    }
    let lparen_adv = parser_advance(parser);
    parser = lparen_adv.parser;

    // Parse parameters (simplified: skip to closing paren)
    var depth: i64 = 1;
    while !parser_at_eof(parser) && depth > 0 {
        let curr = parser_peek(parser);
        if curr == TK_LPAREN() {
            depth = depth + 1;
        } else if curr == TK_RPAREN() {
            depth = depth - 1;
        }
        if depth > 0 {
            let skip_adv = parser_advance(parser);
            parser = skip_adv.parser;
        }
    }

    // Consume )
    let rparen_adv = parser_advance(parser);
    parser = rparen_adv.parser;

    // Check for return type: ->
    if parser_at(parser, TK_ARROW()) {
        let arrow_adv = parser_advance(parser);
        parser = arrow_adv.parser;

        // Parse return type
        let ty_result = parse_type(parser);
        if ty_result.success {
            parser = ty_result.parser;
        }
    }

    // Check for effects: with Effect1, Effect2
    if parser_at(parser, TK_WITH()) {
        let with_adv = parser_advance(parser);
        parser = with_adv.parser;

        // Parse effect list (simplified: skip to {)
        while !parser_at_eof(parser) && !parser_at(parser, TK_LBRACE()) {
            let skip_adv = parser_advance(parser);
            parser = skip_adv.parser;
        }
    }

    // Parse body: { ... }
    if parser_at(parser, TK_LBRACE()) {
        // Skip body for now
        var brace_depth: i64 = 0;
        while !parser_at_eof(parser) {
            let curr = parser_peek(parser);
            if curr == TK_LBRACE() {
                brace_depth = brace_depth + 1;
            } else if curr == TK_RBRACE() {
                brace_depth = brace_depth - 1;
                if brace_depth == 0 {
                    let adv2 = parser_advance(parser);
                    parser = adv2.parser;
                    break
                }
            }
            let adv2 = parser_advance(parser);
            parser = adv2.parser;
        }
    }

    item.span = span_new(start, parser_span(parser).end);

    ParseItemResult {
        parser: parser,
        item: item,
        success: true,
    }
}

// ============================================================================
// STRUCT PARSING
// ============================================================================

/// Parse struct: struct Name { fields }
fn parse_struct(p: Parser) -> ParseItemResult {
    var parser = p;
    let start = parser_span(parser).start;

    // Consume 'struct'
    let adv = parser_advance(parser);
    parser = adv.parser;

    // Parse struct name
    if !parser_at(parser, TK_IDENT()) {
        return ParseItemResult {
            parser: parser,
            item: item_new(),
            success: false,
        }
    }

    let name_adv = parser_advance(parser);
    parser = name_adv.parser;

    var item = item_new();
    item.kind = ITEM_STRUCT();

    // Copy name
    var i: i64 = 0;
    while i < name_adv.token.text_len && i < 64 {
        item.struct_name[i as usize] = name_adv.token.text[i as usize];
        i = i + 1;
    }
    item.struct_name_len = name_adv.token.text_len;

    // Parse generics if present: <T, U>
    if parser_at(parser, TK_LT()) {
        // Skip generics for now
        while !parser_at_eof(parser) && !parser_at(parser, TK_GT()) {
            let skip_adv = parser_advance(parser);
            parser = skip_adv.parser;
        }
        if parser_at(parser, TK_GT()) {
            let gt_adv = parser_advance(parser);
            parser = gt_adv.parser;
        }
    }

    // Expect { or ;
    if parser_at(parser, TK_LBRACE()) {
        // Skip body
        var brace_depth: i64 = 0;
        while !parser_at_eof(parser) {
            let curr = parser_peek(parser);
            if curr == TK_LBRACE() {
                brace_depth = brace_depth + 1;
            } else if curr == TK_RBRACE() {
                brace_depth = brace_depth - 1;
                if brace_depth == 0 {
                    let adv2 = parser_advance(parser);
                    parser = adv2.parser;
                    break
                }
            }
            let adv2 = parser_advance(parser);
            parser = adv2.parser;
        }
    }

    item.span = span_new(start, parser_span(parser).end);

    ParseItemResult {
        parser: parser,
        item: item,
        success: true,
    }
}

// ============================================================================
// ENUM PARSING (placeholder)
// ============================================================================

fn parse_enum(p: Parser) -> ParseItemResult {
    // Similar to struct parsing
    parse_struct(p)  // Placeholder
}

// ============================================================================
// IMPORT PARSING
// ============================================================================

fn parse_import(p: Parser) -> ParseItemResult {
    var parser = p;
    let start = parser_span(parser).start;

    // Consume 'import' or 'use'
    let adv = parser_advance(parser);
    parser = adv.parser;

    var item = item_new();
    item.kind = ITEM_IMPORT();

    // Parse path
    let path_result = parse_path(parser);
    if path_result.success {
        parser = path_result.parser;
    }

    // Consume optional ;
    if parser_at(parser, TK_SEMI()) {
        let semi_adv = parser_advance(parser);
        parser = semi_adv.parser;
    }

    item.span = span_new(start, parser_span(parser).end);

    ParseItemResult {
        parser: parser,
        item: item,
        success: true,
    }
}

// ============================================================================
// EXTERN PARSING
// ============================================================================

fn parse_extern(p: Parser) -> ParseItemResult {
    var parser = p;
    let start = parser_span(parser).start;

    // Consume 'extern'
    let adv = parser_advance(parser);
    parser = adv.parser;

    var item = item_new();
    item.kind = ITEM_FN();  // extern fn

    // Skip to end of extern block
    if parser_at(parser, TK_LBRACE()) {
        var brace_depth: i64 = 0;
        while !parser_at_eof(parser) {
            let curr = parser_peek(parser);
            if curr == TK_LBRACE() {
                brace_depth = brace_depth + 1;
            } else if curr == TK_RBRACE() {
                brace_depth = brace_depth - 1;
                if brace_depth == 0 {
                    let adv2 = parser_advance(parser);
                    parser = adv2.parser;
                    break
                }
            }
            let adv2 = parser_advance(parser);
            parser = adv2.parser;
        }
    }

    item.span = span_new(start, parser_span(parser).end);

    ParseItemResult {
        parser: parser,
        item: item,
        success: true,
    }
}

// ============================================================================
// AST
// ============================================================================

struct Ast {
    module_name: Path,
    has_module_name: bool,
    items: [Item; 1024],
    n_items: i64,
}

fn ast_new() -> Ast {
    Ast {
        module_name: path_new(),
        has_module_name: false,
        items: [item_new(); 1024],
        n_items: 0,
    }
}

struct ParseAstResult {
    parser: Parser,
    ast: Ast,
    success: bool,
}

/// Parse a complete Sounio program
fn parse_program(p: Parser) -> ParseAstResult {
    var parser = p;
    var ast = ast_new();

    // Skip initial doc comments
    while parser_at(parser, TK_DOC_COMMENT_OUTER()) || parser_at(parser, TK_DOC_COMMENT_INNER()) {
        let adv = parser_advance(parser);
        parser = adv.parser;
    }

    // Optional module declaration
    if parser_at(parser, TK_MODULE()) {
        let adv = parser_advance(parser);
        parser = adv.parser;

        let path_result = parse_path(parser);
        if path_result.success {
            parser = path_result.parser;
            ast.module_name = path_result.path;
            ast.has_module_name = true;
        }

        // Consume optional ;
        if parser_at(parser, TK_SEMI()) {
            let semi_adv = parser_advance(parser);
            parser = semi_adv.parser;
        }
    }

    // Parse items
    while !parser_at_eof(parser) && ast.n_items < 1024 {
        let item_result = parse_item(parser);
        if item_result.success {
            parser = item_result.parser;
            ast.items[ast.n_items as usize] = item_result.item;
            ast.n_items = ast.n_items + 1;
        } else {
            // Skip unknown token
            let skip_adv = parser_advance(parser);
            parser = skip_adv.parser;
        }
    }

    ParseAstResult {
        parser: parser,
        ast: ast,
        success: true,
    }
}

// ============================================================================
// PUBLIC API
// ============================================================================

/// Parse tokens into an AST
fn parse(tokens: TokenStream) -> ParseAstResult {
    let parser = parser_new(tokens);
    parse_program(parser)
}

