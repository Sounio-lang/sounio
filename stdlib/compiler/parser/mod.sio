// compiler::parser — Self-hosted Sounio Parser
//
// This is the parser for the self-hosted Sounio compiler.
// It produces an AST from a token stream.
//
// Equivalent to compiler/src/parser/mod.rs in the Rust implementation.

// ============================================================================
// TOKEN KIND CONSTANTS (from lexer)
// ============================================================================

fn TK_EOF() -> i32 { 0 }
fn TK_ERROR() -> i32 { 1 }
fn TK_IDENT() -> i32 { 200 }
fn TK_INT_LIT() -> i32 { 201 }
fn TK_FLOAT_LIT() -> i32 { 205 }
fn TK_STRING_LIT() -> i32 { 206 }

// Keywords
fn TK_MODULE() -> i32 { 10 }
fn TK_IMPORT() -> i32 { 11 }
fn TK_USE() -> i32 { 12 }
fn TK_FN() -> i32 { 14 }
fn TK_LET() -> i32 { 15 }
fn TK_VAR() -> i32 { 16 }
fn TK_CONST() -> i32 { 17 }
fn TK_STRUCT() -> i32 { 20 }
fn TK_ENUM() -> i32 { 21 }
fn TK_TRAIT() -> i32 { 22 }
fn TK_IMPL() -> i32 { 23 }
fn TK_IF() -> i32 { 24 }
fn TK_ELSE() -> i32 { 25 }
fn TK_MATCH() -> i32 { 26 }
fn TK_FOR() -> i32 { 27 }
fn TK_WHILE() -> i32 { 28 }
fn TK_LOOP() -> i32 { 29 }
fn TK_BREAK() -> i32 { 30 }
fn TK_CONTINUE() -> i32 { 31 }
fn TK_RETURN() -> i32 { 32 }
fn TK_TRUE() -> i32 { 39 }
fn TK_FALSE() -> i32 { 40 }
fn TK_PUB() -> i32 { 41 }
fn TK_TYPE() -> i32 { 43 }
fn TK_EXTERN() -> i32 { 45 }
fn TK_WITH() -> i32 { 53 }
fn TK_EFFECT() -> i32 { 50 }
fn TK_HANDLER() -> i32 { 51 }
fn TK_LINEAR() -> i32 { 54 }
fn TK_KERNEL() -> i32 { 70 }

// Operators and delimiters
fn TK_EQ() -> i32 { 230 }
fn TK_ARROW() -> i32 { 270 }
fn TK_FAT_ARROW() -> i32 { 271 }
fn TK_LPAREN() -> i32 { 280 }
fn TK_RPAREN() -> i32 { 281 }
fn TK_LBRACKET() -> i32 { 282 }
fn TK_RBRACKET() -> i32 { 283 }
fn TK_LBRACE() -> i32 { 284 }
fn TK_RBRACE() -> i32 { 285 }
fn TK_COMMA() -> i32 { 290 }
fn TK_SEMI() -> i32 { 291 }
fn TK_COLON() -> i32 { 292 }
fn TK_COLON_COLON() -> i32 { 293 }
fn TK_DOT() -> i32 { 294 }
fn TK_LT() -> i32 { 231 }
fn TK_GT() -> i32 { 232 }

// ============================================================================
// TOKEN AND SPAN (from lexer)
// ============================================================================

struct Span {
    start: i64,
    end: i64,
}

fn span_new(s: i64, e: i64) -> Span {
    Span { start: s, end: e }
}

struct Token {
    kind: i32,
    span: Span,
    text: [i8; 256],
    text_len: i64,
}

fn token_new() -> Token {
    Token {
        kind: TK_EOF(),
        span: Span { start: 0, end: 0 },
        text: [0; 256],
        text_len: 0,
    }
}

struct TokenStream {
    tokens: [Token; 16384],
    n_tokens: i64,
    pos: i64,
}

// ============================================================================
// NODE ID GENERATOR
// ============================================================================

struct IdGenerator {
    next_val: i64,
}

fn id_generator_new() -> IdGenerator {
    IdGenerator { next_val: 1 }
}

fn id_generator_next(gen: IdGenerator) -> IdGeneratorResult {
    IdGeneratorResult {
        gen: IdGenerator { next_val: gen.next_val + 1 },
        id: NodeId { value: gen.next_val },
    }
}

struct NodeId {
    value: i64,
}

struct IdGeneratorResult {
    gen: IdGenerator,
    id: NodeId,
}

// ============================================================================
// PARSER STATE
// ============================================================================

struct Parser {
    tokens: TokenStream,
    pos: i64,
    id_gen: IdGenerator,
    allow_struct_literals: bool,
    pending_gt: bool,
}

fn parser_new(tokens: TokenStream) -> Parser {
    Parser {
        tokens: tokens,
        pos: 0,
        id_gen: id_generator_new(),
        allow_struct_literals: true,
        pending_gt: false,
    }
}

// ============================================================================
// PARSER RESULT TYPE
// ============================================================================

struct ParseResult {
    parser: Parser,
    success: bool,
    error_msg: [i8; 256],
    error_len: i64,
}

fn parse_ok(p: Parser) -> ParseResult {
    ParseResult {
        parser: p,
        success: true,
        error_msg: [0; 256],
        error_len: 0,
    }
}

