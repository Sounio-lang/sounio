// compiler::parser::ast — Abstract Syntax Tree for Self-Hosted Sounio Compiler
//
// This module defines AST node types for the self-hosted Sounio parser.
// Following the pattern from stdlib/medlang/ast.sio using fixed-size arrays.

// ============================================================================
// COMMON TYPES
// ============================================================================

// Source span (byte offsets)
struct Span {
    start: i64,
    end: i64,
}

fn span_new(start: i64, end: i64) -> Span {
    Span { start: start, end: end }
}

fn span_dummy() -> Span {
    Span { start: 0, end: 0 }
}

// Node ID for unique identification
struct NodeId {
    value: i64,
}

fn node_id_new(v: i64) -> NodeId {
    NodeId { value: v }
}

fn node_id_dummy() -> NodeId {
    NodeId { value: 0 }
}

// ============================================================================
// PATH
// ============================================================================

// A path segment: identifier with optional generic args
struct PathSegment {
    name: [i8; 64],
    name_len: i64,
    // Generic args as type indices (for later resolution)
    generic_args: [i64; 8],
    n_generics: i64,
}

fn path_segment_new() -> PathSegment {
    PathSegment {
        name: [0; 64],
        name_len: 0,
        generic_args: [0; 8],
        n_generics: 0,
    }
}

// Path: a::b::c
struct Path {
    segments: [PathSegment; 8],
    n_segments: i64,
}

fn path_new() -> Path {
    Path {
        segments: [path_segment_new(); 8],
        n_segments: 0,
    }
}

fn path_simple_from_bytes(bytes: [i8; 64], len: i64) -> Path {
    var p = path_new();
    var seg = path_segment_new();
    var i: i64 = 0;
    while i < len && i < 64 {
        seg.name[i as usize] = bytes[i as usize];
        i = i + 1;
    }
    seg.name_len = len;
    p.segments[0] = seg;
    p.n_segments = 1;
    p
}

// ============================================================================
// VISIBILITY
// ============================================================================

// Visibility constants
fn VIS_PRIVATE() -> i32 { 0 }
fn VIS_PUBLIC() -> i32 { 1 }
fn VIS_CRATE() -> i32 { 2 }
fn VIS_SUPER() -> i32 { 3 }

// ============================================================================
// TYPE EXPRESSIONS
// ============================================================================

// Type expression kind constants
fn TY_PATH() -> i32 { 0 }       // i32, String, foo::Bar<T>
fn TY_REF() -> i32 { 1 }        // &T
fn TY_REF_MUT() -> i32 { 2 }    // &!T
fn TY_ARRAY() -> i32 { 3 }      // [T; N]
fn TY_SLICE() -> i32 { 4 }      // [T]
fn TY_TUPLE() -> i32 { 5 }      // (T1, T2, ...)
fn TY_FUNC() -> i32 { 6 }       // fn(T1, T2) -> R
fn TY_UNIT() -> i32 { 7 }       // ()
fn TY_NEVER() -> i32 { 8 }      // !
fn TY_INFER() -> i32 { 9 }      // _
fn TY_PTR() -> i32 { 10 }       // *T or *!T
fn TY_UNIT_TYPE() -> i32 { 11 } // Type with unit annotation (mg, mL)

// Type expression (stored inline with kind discriminator)
struct TypeExpr {
    kind: i32,
    span: Span,
    // For path types
    path: Path,
    // For ref/ptr types
    is_mut: bool,
    inner_type_idx: i64,  // Index into type pool for inner type
    // For array types
    array_size: i64,
    // For tuple/function types (indices into type pool)
    element_types: [i64; 16],
    n_elements: i64,
    return_type_idx: i64,
    // For unit types
    unit_name: [i8; 32],
    unit_name_len: i64,
}

fn type_expr_new() -> TypeExpr {
    TypeExpr {
        kind: TY_UNIT(),
        span: span_dummy(),
        path: path_new(),
        is_mut: false,
        inner_type_idx: -1,
        array_size: 0,
        element_types: [0; 16],
        n_elements: 0,
        return_type_idx: -1,
        unit_name: [0; 32],
        unit_name_len: 0,
    }
}

fn type_expr_unit() -> TypeExpr {
    var te = type_expr_new();
    te.kind = TY_UNIT();
    te
}

fn type_expr_path(p: Path) -> TypeExpr {
    var te = type_expr_new();
    te.kind = TY_PATH();
    te.path = p;
    te
}

