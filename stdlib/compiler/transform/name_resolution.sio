/// Statistics about resolution
struct ResolutionStats {
    scopes_created: i32,
    symbols_added: i32,
    references_resolved: i32,
    unresolved_count: i32,
    conflicts_found: i32,
    cycles_detected: i32,
    shadowing_warnings: i32
}

/// Get resolution stats
fn resolution_stats(st: &SymbolTable) -> ResolutionStats {
    var stats: ResolutionStats = {
        scopes_created: st.scopes,
        symbols_added: 0,
        references_resolved: 0,
        unresolved_count: 0,
        conflicts_found: 0,
        cycles_detected: 0,
        shadowing_warnings: st.warnings
    };
    stats
}

/// Test: Basic symbol addition
fn test_add_symbol() {
    var st = symbol_table_new();
    let result = add_symbol("x", 0, VariableSym, &!st);
    // Should succeed
}

/// Test: Conflict detection
fn test_conflict_detection() {
    var st = symbol_table_new();
    let _ = add_symbol("f", 0, FunctionSym, &!st);
    let result = add_symbol("f", 1, FunctionSym, &!st);
    // Second should fail with ConflictingDefinition
}

/// Test: Scope hierarchy
fn test_scope_hierarchy() {
    var st = symbol_table_new();
    push_scope(FunctionScope(0), &!st);
    // Add to function scope
    let _ = add_symbol("local", 1, VariableSym, &!st);
    pop_scope(&!st);
    // Back to global
}

/// Test: Shadowing detection
fn test_shadowing_detection() {
    var st = symbol_table_new();
    let _ = add_symbol("x", 0, VariableSym, &!st);
    push_scope(BlockScope, &!st);
    // Adding "x" in block should warn
    let _ = check_shadowing("x", st.current_scope_id, &st);
    pop_scope(&!st);
}

/// Test: Undefined name
fn test_undefined_name() {
    var st = symbol_table_new();
    let found = resolve_name("undefined", 0, &st);
    // Should be (false, -1, -1)
}

/// Run all tests
fn run_all_tests() {
    test_add_symbol();
    test_conflict_detection();
    test_scope_hierarchy();
    test_shadowing_detection();
    test_undefined_name();
}
