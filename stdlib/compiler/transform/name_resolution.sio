/// Phase 2.1: Name Resolution Pass for Self-Hosted Sedenion Compiler
///
/// Resolves all identifier references to definitions, building a symbol table
/// hierarchy and detecting name resolution errors (undefined names, conflicts).

/// Symbol table entry: maps name to definition
struct SymbolEntry {
    name: str,
    node_id: i32,      // The NodeId of the definition
    kind: SymbolKind,  // What kind of symbol (function, struct, var, etc.)
    scope_depth: i32   // Depth in scope hierarchy (0 = global)
}

/// Kind of symbol
enum SymbolKind {
    FunctionSym,
    StructSym,
    EnumSym,
    TraitSym,
    TypeAliasSym,
    VariableSym,
    ParameterSym,
    ModuleSym,
}

/// Single scope in the hierarchy
struct Scope {
    id: i32,
    parent_id: i32,      // -1 for global scope
    entries: i32,        // Count of entries (map would be expensive)
    depth: i32,
    scope_type: ScopeType
}

enum ScopeType {
    GlobalScope,
    FunctionScope(i32),      // function node_id
    BlockScope,
    ModuleScope(str),        // module name
}

/// Symbol table manager
struct SymbolTable {
    scopes: i32,          // Total scope count
    current_scope_id: i32,
    global_scope_id: i32,
    errors: i32,
    warnings: i32
}

/// Name resolution error
enum ResolutionError {
    UndefinedName(str),
    ConflictingDefinition(str, i32, i32),   // name, old_id, new_id
    CyclicImport(str),                       // module name
    AmbiguousName(str, i32, i32),            // name, choice1, choice2
    ShadowingWarning(str, i32, i32),         // name, shadowed_id, shadow_id
}

/// Initialize empty symbol table
fn symbol_table_new() -> SymbolTable {
    var st: SymbolTable = {
        scopes: 1,
        current_scope_id: 0,
        global_scope_id: 0,
        errors: 0,
        warnings: 0
    };
    st
}

/// Create a new scope
fn scope_new(parent_id: i32, depth: i32, scope_type: ScopeType) -> Scope {
    var s: Scope = {
        id: parent_id + 1,
        parent_id: parent_id,
        entries: 0,
        depth: depth,
        scope_type: scope_type
    };
    s
}

/// Create function scope
fn scope_function(parent_id: i32, depth: i32, fn_id: i32) -> Scope {
    scope_new(parent_id, depth, FunctionScope(fn_id))
}

/// Create block scope
fn scope_block(parent_id: i32, depth: i32) -> Scope {
    scope_new(parent_id, depth, BlockScope)
}

/// Create module scope
fn scope_module(parent_id: i32, depth: i32, name: str) -> Scope {
    scope_new(parent_id, depth, ModuleScope(name))
}

/// Create a symbol entry
fn symbol_entry_new(name: str, node_id: i32, kind: SymbolKind, scope_depth: i32) -> SymbolEntry {
    var e: SymbolEntry = {
        name: name,
        node_id: node_id,
        kind: kind,
        scope_depth: scope_depth
    };
    e
}

/// Resolve a name in current scope (recursive up to parents)
/// Returns (found: bool, node_id: i32, depth_difference: i32)
fn resolve_name(name: str, scope_id: i32, st: &SymbolTable) -> (bool, i32, i32) {
