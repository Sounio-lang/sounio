/// Extract natural loop from back edge u→v (v dominates u)
fn extract_natural_loop(back_edge_from: i32, back_edge_to: i32) -> Loop {
    var l: Loop = {
        loop_id: back_edge_from,
        header_block: back_edge_to,
        exit_blocks: 0,
        back_edges: 1,
        contains_call: false,
        nest_level: 0
    };
    l
}

