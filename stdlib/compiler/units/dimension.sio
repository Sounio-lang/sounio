// stdlib/compiler/units/dimension.sio
// SI Dimensional Analysis - Simplified Stub

fn DIM_MASS() -> i32 { 0 }
fn DIM_LENGTH() -> i32 { 1 }
fn DIM_TIME() -> i32 { 2 }
fn DIM_CURRENT() -> i32 { 3 }
fn DIM_TEMPERATURE() -> i32 { 4 }
fn DIM_AMOUNT() -> i32 { 5 }
fn DIM_LUMINOSITY() -> i32 { 6 }
fn DIM_DIMENSIONLESS() -> i32 { 7 }

struct Dimension {
    mass: i32,
    length: i32,
    time: i32,
    current: i32,
    temperature: i32,
    amount: i32,
    luminosity: i32,
}

fn dimension_new(m: i32, l: i32, t: i32, i: i32, th: i32, n: i32, j: i32) -> Dimension {
    Dimension {
        mass: m, length: l, time: t, current: i,
        temperature: th, amount: n, luminosity: j,
    }
}

fn dimension_dimensionless() -> Dimension {
    dimension_new(0, 0, 0, 0, 0, 0, 0)
}

pub struct Unit {
    name: [i8; 32],
    name_len: i64,
    dimension: Dimension,
    scale: f64,
}

fn unit_new(name: [i8; 32], name_len: i64, dim: Dimension, scale: f64) -> Unit {
    Unit { name: name, name_len: name_len, dimension: dim, scale: scale }
}

struct DimensionError {
    error_code: i32,
    expected_dim: Dimension,
    actual_dim: Dimension,
}
