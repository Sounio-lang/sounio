// compiler::ast module entry point
//
// Re-exports core AST types for the self-hosted compiler.
// The module loader resolves `use compiler::ast` to this file.
//
// Note: The full AST is defined in compiler::parser::ast, but these
// common types (NodeId, Span) are used throughout the compiler and
// are re-exported here for convenience.

// Source span (byte offsets into source text)
struct Span {
    start: i64,
    end: i64,
}

fn span_new(start: i64, end: i64) -> Span {
    Span { start: start, end: end }
}

fn span_dummy() -> Span {
    Span { start: 0, end: 0 }
}

fn span_contains(span: &Span, offset: i64) -> bool {
    offset >= span.start && offset < span.end
}

fn span_len(span: &Span) -> i64 {
    span.end - span.start
}

// Node ID for unique identification of AST nodes
struct NodeId {
    value: i64,
}

fn node_id_new(v: i64) -> NodeId {
    NodeId { value: v }
}

fn node_id_dummy() -> NodeId {
    NodeId { value: 0 }
}
