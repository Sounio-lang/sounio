// ============================================================================
// TOKEN STRUCTURE
// ============================================================================

// Token with kind, span, and text content
struct Token {
    kind: i32,
    span: Span,
    // Text stored as fixed-size array (max 256 chars for identifiers/strings)
    text: [i8; 256],
    text_len: i64,
}

fn token_new() -> Token {
    Token {
        kind: TK_EOF(),
        span: span_empty(),
        text: [0; 256],
        text_len: 0,
    }
}

fn token_with_kind(kind: i32, start: i64, end: i64) -> Token {
    Token {
        kind: kind,
        span: span_new(start, end),
        text: [0; 256],
        text_len: 0,
    }
}

fn token_eof(pos: i64) -> Token {
    Token {
        kind: TK_EOF(),
        span: span_new(pos, pos),
        text: [0; 256],
        text_len: 0,
    }
}

fn token_error(pos: i64) -> Token {
    Token {
        kind: TK_ERROR(),
        span: span_new(pos, pos + 1),
        text: [0; 256],
        text_len: 0,
    }
}

// ============================================================================
// TOKEN KIND CLASSIFICATION
// ============================================================================

// Check if token kind is a keyword (10-179)
fn is_keyword(kind: i32) -> bool {
    kind >= 10 && kind < 180
}

// Check if token kind is a literal (200-209)
fn is_literal(kind: i32) -> bool {
    kind >= 200 && kind < 220
}

// Check if token kind is an operator (220-279)
fn is_operator(kind: i32) -> bool {
    kind >= 220 && kind < 280
}

// Check if token kind is a delimiter (280-289)
fn is_delimiter(kind: i32) -> bool {
    kind >= 280 && kind < 290
}

// Check if token kind is punctuation (290-309)
fn is_punctuation(kind: i32) -> bool {
    kind >= 290 && kind < 310
}

// Check if token kind is a doc comment (310-319)
fn is_doc_comment(kind: i32) -> bool {
    kind >= 310 && kind < 320
}

