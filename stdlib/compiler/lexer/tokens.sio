// compiler::lexer::tokens — Token definitions for the Sounio self-hosted compiler
//
// This module defines all token types recognized by the Sounio lexer.
// Equivalent to compiler/src/lexer/tokens.rs in the Rust implementation.

// ============================================================================
// SPAN - Source location tracking
// ============================================================================

// Span represents a range in the source code (byte offsets)
struct Span {
    start: i64,
    end: i64,
}

fn span_new(start: i64, end: i64) -> Span {
    Span { start: start, end: end }
}

fn span_empty() -> Span {
    Span { start: 0, end: 0 }
}

fn span_len(s: Span) -> i64 {
    s.end - s.start
}

// ============================================================================
// TOKEN KIND - Enum represented as i32 constants
// ============================================================================
// Since Sounio doesn't have full enum support yet, we use i32 constants.
// Each category has a base value for easy identification.

// --- Special tokens (0-9) ---
fn TK_EOF() -> i32 { 0 }
fn TK_ERROR() -> i32 { 1 }

// --- Keywords: Core language (10-49) ---
fn TK_MODULE() -> i32 { 10 }
