// ============================================================================
// KEYWORD LOOKUP
// ============================================================================

// Match keyword text and return token kind or TOKEN_IDENT
fn keyword_lookup(text: [i8; 256], len: i64) -> i32 {
    // Core language keywords
    if len == 2 {
        if text[0] == 105 && text[1] == 102 { return TOKEN_IF }      // "if"
        if text[0] == 105 && text[1] == 110 { return TOKEN_IN }      // "in"
        if text[0] == 97 && text[1] == 115 { return TOKEN_AS }       // "as"
        if text[0] == 100 && text[1] == 111 { return TOKEN_DO }      // "do"
    }
    if len == 3 {
        if text[0] == 102 && text[1] == 110 && text[2] == 0 { return TOKEN_FN }        // "fn"
        if text[0] == 108 && text[1] == 101 && text[2] == 116 { return TOKEN_LET }    // "let"
        if text[0] == 118 && text[1] == 97 && text[2] == 114 { return TOKEN_VAR }     // "var"
        if text[0] == 109 && text[1] == 117 && text[2] == 116 { return TOKEN_MUT }    // "mut"
        if text[0] == 116 && text[1] == 121 && text[2] == 112 { return TOKEN_TYPE }   // "typ"
        if text[0] == 117 && text[1] == 115 && text[2] == 101 { return TOKEN_USE }    // "use"
        if text[0] == 112 && text[1] == 117 && text[2] == 98 { return TOKEN_PUB }     // "pub"
    }
    if len == 4 {
        if text[0] == 116 && text[1] == 114 && text[2] == 117 && text[3] == 101 { return TOKEN_TRUE }    // "true"
    }
    if len == 5 {
        if text[0] == 102 && text[1] == 97 && text[2] == 108 && text[3] == 115 && text[4] == 101 { return TOKEN_FALSE }  // "false"
        if text[0] == 119 && text[1] == 104 && text[2] == 105 && text[3] == 108 && text[4] == 101 { return TOKEN_WHILE }  // "while"
    }

    // For simplicity, just map basic keywords
    // A full implementation would check all 60 keywords
    TOKEN_IDENT
}

// ============================================================================
// IDENTIFIER AND KEYWORD SCANNING
// ============================================================================

fn scan_identifier(lex: Lexer) -> ScanResult with Mut, Panic {
    var l = lex
    let start = l.pos
    var text: [i8; 256] = [0; 256]
    var text_idx: i64 = 0

    // Collect identifier characters
    while !lexer_at_end(l) && is_ident_continue(l.current) && text_idx < 256 {
        text[text_idx] = l.current
        text_idx = text_idx + 1
        l = lexer_advance(l)
    }

    let end = l.pos

    // Try keyword lookup
    let kind = keyword_lookup(text, text_idx)

    scan_result_with_text(l, kind, start, end, text, text_idx)
}

// ============================================================================
// INTEGER SCANNING
// ============================================================================

fn scan_integer_digits(lex: Lexer) -> Lexer with Mut, Panic {
    var l = lex
    while !lexer_at_end(l) && is_digit(l.current) {
        l = lexer_advance(l)
    }
    l
}

fn scan_integer(lex: Lexer) -> ScanResult with Mut, Panic {
    var l = lex
    let start = l.pos
    var kind = TOKEN_INT_LIT

    // Check for hex, binary, octal
    if l.current == 48 {  // '0'
        if lexer_peek(l) == 120 {  // 'x'
            l = lexer_advance_n(l, 2)
            while !lexer_at_end(l) && is_hex_digit(l.current) {
                l = lexer_advance(l)
            }
            kind = TOKEN_HEX_LIT
        } else if lexer_peek(l) == 98 {  // 'b'
            l = lexer_advance_n(l, 2)
            while !lexer_at_end(l) && is_bin_digit(l.current) {
                l = lexer_advance(l)
            }
            kind = TOKEN_BIN_LIT
        } else if lexer_peek(l) == 111 {  // 'o'
            l = lexer_advance_n(l, 2)
            while !lexer_at_end(l) && is_oct_digit(l.current) {
                l = lexer_advance(l)
            }
            kind = TOKEN_OCT_LIT
        } else {
            l = scan_integer_digits(l)
        }
    } else {
        l = scan_integer_digits(l)
    }

    let end = l.pos
    scan_result_new(l, kind, start, end)
}

// ============================================================================
// FLOAT SCANNING
// ============================================================================

fn scan_float_after_dot(lex: Lexer) -> ScanResult with Mut, Panic {
    var l = lex
    let start = l.pos

    // Skip digits before decimal
    while !lexer_at_end(l) && is_digit(l.current) {
        l = lexer_advance(l)
    }

    // Decimal point
    if !lexer_at_end(l) && l.current == 46 {  // '.'
        l = lexer_advance(l)
        while !lexer_at_end(l) && is_digit(l.current) {
            l = lexer_advance(l)
        }
    }

    // Exponent (e or E)
    if !lexer_at_end(l) && (l.current == 101 || l.current == 69) {  // 'e' or 'E'
        l = lexer_advance(l)
        if !lexer_at_end(l) && (l.current == 43 || l.current == 45) {  // '+' or '-'
            l = lexer_advance(l)
        }
        while !lexer_at_end(l) && is_digit(l.current) {
            l = lexer_advance(l)
        }
    }

    let end = l.pos
    scan_result_new(l, TOKEN_FLOAT_LIT, start, end)
}

// ============================================================================
// STRING SCANNING
// ============================================================================

fn scan_string(lex: Lexer) -> ScanResult with Mut, Panic {
    var l = lex
    let start = l.pos
    var text: [i8; 256] = [0; 256]
    var text_idx: i64 = 0

    l = lexer_advance(l)  // skip opening quote

    while !lexer_at_end(l) && l.current != 34 && text_idx < 256 {  // '"'
        if l.current == 92 {  // backslash
            text[text_idx] = l.current
            text_idx = text_idx + 1
            l = lexer_advance(l)
            if !lexer_at_end(l) {
                text[text_idx] = l.current
                text_idx = text_idx + 1
                l = lexer_advance(l)
            }
        } else {
            text[text_idx] = l.current
            text_idx = text_idx + 1
            l = lexer_advance(l)
        }
    }

    if !lexer_at_end(l) {
        l = lexer_advance(l)  // skip closing quote
    }

    let end = l.pos
    scan_result_with_text(l, TOKEN_STRING_LIT, start, end, text, text_idx)
}

// ============================================================================
// OPERATOR SCANNING (Longest Match)
// ============================================================================

fn scan_operator(lex: Lexer) -> ScanResult with Mut, Panic {
    var l = lex
    let start = l.pos
    var kind = 0i32

    let c = l.current
    let c2 = lexer_peek(l)
    let c3 = lexer_peek_n(l, 2)

    // Three-character operators (highest priority)
    if c == 46 && c2 == 46 && c3 == 46 {  // "..."
        l = lexer_advance_n(l, 3)
        kind = TOKEN_DOT_DOT_DOT
    } else if c == 60 && c2 == 60 && c3 == 61 {  // "<<="
        l = lexer_advance_n(l, 3)
        kind = TOKEN_SHL_EQ
    } else if c == 62 && c2 == 62 && c3 == 61 {  // ">>="
        l = lexer_advance_n(l, 3)
        kind = TOKEN_SHR_EQ
    }
    // Two-character operators
    else if c == 61 && c2 == 61 {  // "=="
        l = lexer_advance_n(l, 2)
        kind = TOKEN_EQ_EQ
    } else if c == 33 && c2 == 61 {  // "!="
        l = lexer_advance_n(l, 2)
        kind = TOKEN_NE
    } else if c == 60 && c2 == 61 {  // "<="
        l = lexer_advance_n(l, 2)
        kind = TOKEN_LE
    } else if c == 62 && c2 == 61 {  // ">="
        l = lexer_advance_n(l, 2)
        kind = TOKEN_GE
    } else if c == 38 && c2 == 38 {  // "&&"
        l = lexer_advance_n(l, 2)
        kind = TOKEN_AMP_AMP
    } else if c == 124 && c2 == 124 {  // "||"
        l = lexer_advance_n(l, 2)
        kind = TOKEN_PIPE_PIPE
    } else if c == 43 && c2 == 43 {  // "++"
        l = lexer_advance_n(l, 2)
        kind = TOKEN_PLUS_PLUS
    } else if c == 43 && c2 == 61 {  // "+="
        l = lexer_advance_n(l, 2)
        kind = TOKEN_PLUS_EQ
    } else if c == 45 && c2 == 61 {  // "-="
        l = lexer_advance_n(l, 2)
        kind = TOKEN_MINUS_EQ
    } else if c == 45 && c2 == 62 {  // "->"
        l = lexer_advance_n(l, 2)
        kind = TOKEN_ARROW
    } else if c == 61 && c2 == 62 {  // "=>"
        l = lexer_advance_n(l, 2)
        kind = TOKEN_FAT_ARROW
    } else if c == 60 && c2 == 45 {  // "<-"
        l = lexer_advance_n(l, 2)
        kind = TOKEN_LEFT_ARROW
    } else if c == 60 && c2 == 60 {  // "<<"
        l = lexer_advance_n(l, 2)
        kind = TOKEN_SHL
    } else if c == 62 && c2 == 62 {  // ">>"
        l = lexer_advance_n(l, 2)
        kind = TOKEN_SHR
    } else if c == 38 && c2 == 33 {  // "&!"
        l = lexer_advance_n(l, 2)
        kind = TOKEN_AMP_BANG
    } else if c == 58 && c2 == 58 {  // "::"
        l = lexer_advance_n(l, 2)
        kind = TOKEN_COLON_COLON
    } else if c == 46 && c2 == 46 {  // ".."
        l = lexer_advance_n(l, 2)
        kind = TOKEN_DOT_DOT
    } else if c == 43 && c2 == 45 {  // "+-"
        l = lexer_advance_n(l, 2)
        kind = TOKEN_PLUS_EQ  // Reusing as placeholder
    }
    // Single-character operators
    else if c == 43 {  // "+"
        l = lexer_advance(l)
        kind = TOKEN_PLUS
    } else if c == 45 {  // "-"
        l = lexer_advance(l)
        kind = TOKEN_MINUS
    } else if c == 42 {  // "*"
        l = lexer_advance(l)
        kind = TOKEN_STAR
    } else if c == 47 {  // "/"
        l = lexer_advance(l)
        kind = TOKEN_SLASH
    } else if c == 37 {  // "%"
        l = lexer_advance(l)
        kind = TOKEN_PERCENT
    } else if c == 94 {  // "^"
        l = lexer_advance(l)
        kind = TOKEN_CARET
    } else if c == 38 {  // "&"
        l = lexer_advance(l)
        kind = TOKEN_AMP
    } else if c == 124 {  // "|"
        l = lexer_advance(l)
        kind = TOKEN_PIPE
    } else if c == 126 {  // "~"
        l = lexer_advance(l)
        kind = TOKEN_TILDE
    } else if c == 33 {  // "!"
        l = lexer_advance(l)
        kind = TOKEN_BANG
    } else if c == 61 {  // "="
        l = lexer_advance(l)
        kind = TOKEN_EQ
    } else if c == 60 {  // "<"
        l = lexer_advance(l)
        kind = TOKEN_LT
    } else if c == 62 {  // ">"
        l = lexer_advance(l)
        kind = TOKEN_GT
    }

    let end = l.pos
    scan_result_new(l, kind, start, end)
}

// ============================================================================
// CHARACTER LITERAL SCANNING
// ============================================================================

fn scan_char_literal(lex: Lexer) -> ScanResult with Mut, Panic {
    var l = lex
    let start = l.pos

    l = lexer_advance(l)  // skip opening quote

    // Handle escape sequences
    if !lexer_at_end(l) && l.current == 92 {  // backslash
        l = lexer_advance(l)  // skip backslash
        if !lexer_at_end(l) {
            l = lexer_advance(l)  // skip escaped char
        }
    } else if !lexer_at_end(l) {
        l = lexer_advance(l)  // regular char
    }

    if !lexer_at_end(l) && l.current == 39 {  // closing quote
        l = lexer_advance(l)
    }

    let end = l.pos
    scan_result_new(l, TOKEN_CHAR_LIT, start, end)
}

// ============================================================================
// DOC COMMENT SCANNING
// ============================================================================

fn scan_doc_comment_line(lex: Lexer) -> ScanResult with Mut, Div, Panic {
    var l = lex
    let start = l.pos
    var text: [i8; 256] = [0; 256]
    var text_idx: i64 = 0
    var kind = TOKEN_DOC_COMMENT_OUTER

    // Skip ///
    l = lexer_advance_n(l, 3)

    // Check for inner comment //!
    if l.pos > start + 2 && lex.source[start + 2] == 33 {  // '!'
        kind = TOKEN_DOC_COMMENT_INNER
    }

    // Collect comment text until newline
    while !lexer_at_end(l) && l.current != 10 && text_idx < 256 {  // '\n'
        text[text_idx] = l.current
        text_idx = text_idx + 1
        l = lexer_advance(l)
    }

    let end = l.pos
    scan_result_with_text(l, kind, start, end, text, text_idx)
}

fn scan_doc_comment_block(lex: Lexer) -> ScanResult with Mut, Div, Panic {
    var l = lex
    let start = l.pos
    var text: [i8; 256] = [0; 256]
    var text_idx: i64 = 0
    var kind = TOKEN_DOC_BLOCK_OUTER

    // Skip /**
    l = lexer_advance_n(l, 3)

    // Check for inner comment /*!
    if l.pos > start + 2 && lex.source[start + 2] == 33 {  // '!'
        kind = TOKEN_DOC_BLOCK_INNER
    }

    // Collect until */
    while !lexer_at_end(l) && text_idx < 256 {
        if l.current == 42 && lexer_peek(l) == 47 {  // */
            l = lexer_advance_n(l, 2)
            break
        }
        text[text_idx] = l.current
        text_idx = text_idx + 1
        l = lexer_advance(l)
    }

    let end = l.pos
    scan_result_with_text(l, kind, start, end, text, text_idx)
}

// ============================================================================
// DELIMITER SCANNING
// ============================================================================

fn scan_delimiter(lex: Lexer) -> ScanResult with Mut, Panic {
    var l = lex
    let start = l.pos
    var kind = 0i32

    let c = l.current

    if c == 40 {  // "("
        kind = TOKEN_LPAREN
    } else if c == 41 {  // ")"
        kind = TOKEN_RPAREN
    } else if c == 91 {  // "["
        kind = TOKEN_LBRACKET
    } else if c == 93 {  // "]"
        kind = TOKEN_RBRACKET
    } else if c == 123 {  // "{"
        kind = TOKEN_LBRACE
    } else if c == 125 {  // "}"
        kind = TOKEN_RBRACE
    } else if c == 44 {  // ","
        kind = TOKEN_COMMA
    } else if c == 59 {  // ";"
        kind = TOKEN_SEMI
    } else if c == 58 {  // ":"
        kind = TOKEN_COLON
    } else if c == 46 {  // "."
        kind = TOKEN_DOT
    } else if c == 64 {  // "@"
        kind = TOKEN_AT
    } else if c == 35 {  // "#"
        kind = TOKEN_HASH
    } else if c == 36 {  // "$"
        kind = TOKEN_DOLLAR
    } else if c == 63 {  // "?"
        kind = TOKEN_QUESTION
    }

    if kind != 0i32 {
        l = lexer_advance(l)
    }

    let end = l.pos
    scan_result_new(l, kind, start, end)
}

// ============================================================================
// MAIN LEXER ENTRY POINT (STUB)
// ============================================================================

// Note: Full implementation of lex() would dispatch to all scanning functions
// This is a placeholder showing the overall structure

// Main lexer dispatcher - tokenizes source code
// Returns total number of tokens produced
fn lex(source: [i8; 1048576], len: i64) -> i32 with Mut, Panic {
    var lex = lexer_init(source, len)
    var token_count = 0i32

    // Main tokenization loop
    while !lexer_at_end(lex) {
        let c = lex.current

        // Skip whitespace (space, tab, newline, carriage return)
        if c == 32 || c == 9 || c == 10 || c == 13 {
            lex = lexer_advance(lex)
            continue
        }

        // Line comment: //
        if c == 47 && lexer_peek(lex) == 47 {
            lex = skip_line_comment(lex)
            continue
        }

        // Block comment: /* (may be nested)
        if c == 47 && lexer_peek(lex) == 42 {
            let result = skip_block_comment(lex)
            lex = result
            continue
        }

        // Doc comment: /// or //!
        if c == 47 && lexer_peek(lex) == 47 {
            if lexer_peek_n(lex, 2) == 47 || lexer_peek_n(lex, 2) == 33 {
                let result = scan_doc_comment_line(lex)
                lex = result.lexer
                token_count = token_count + 1
                continue
            }
        }

        // Block doc comment: /** or /*!
        if c == 47 && lexer_peek(lex) == 42 {
            if lexer_peek_n(lex, 2) == 42 || lexer_peek_n(lex, 2) == 33 {
                let result = scan_doc_comment_block(lex)
                lex = result.lexer
                token_count = token_count + 1
                continue
            }
        }

        // String literals
        if c == 34 {  // "
            let result = scan_string(lex)
            lex = result.lexer
            token_count = token_count + 1
            continue
        }

        // Character literals
        if c == 39 {  // '
            let result = scan_char_literal(lex)
            lex = result.lexer
            token_count = token_count + 1
            continue
        }

        // Numeric literals
        if is_digit(c) {
            let result = scan_integer(lex)
            lex = result.lexer
            token_count = token_count + 1
            continue
        }

        // Identifiers and keywords
        if is_alpha(c) || c == 95 {  // 95 = '_'
            let result = scan_identifier(lex)
            lex = result.lexer
            token_count = token_count + 1
            continue
        }

        // Delimiters
        if is_delimiter(c) {
            let result = scan_delimiter(lex)
            lex = result.lexer
            token_count = token_count + 1
            continue
        }

        // Operators (longest-match priority)
        if is_operator_start(c) {
            let result = scan_operator(lex)
            lex = result.lexer
            token_count = token_count + 1
            continue
        }

        // Unknown character - skip it
        lex = lexer_advance(lex)
    }

    token_count
}

// Helper: Check if character starts an operator
fn is_operator_start(c: i8) -> bool {
    // Operators: + - * / % = < > ! & | : ? @ # $ ^ ~ ++  -- == != <= >= && || :: => +- ± &! << >> etc.
    c == 43 || c == 45 || c == 42 || c == 47 || c == 37 || c == 61 || c == 60 || c == 62 ||
    c == 33 || c == 38 || c == 124 || c == 58 || c == 63 || c == 64 || c == 35 || c == 36 ||
    c == 94 || c == 126
}

// Helper: Check if character is a delimiter
fn is_delimiter(c: i8) -> bool {
    c == 40 || c == 41 || c == 91 || c == 93 || c == 123 || c == 125 || c == 44 || c == 46 || c == 59
}

