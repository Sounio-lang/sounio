// compiler::lexer::keywords — Keyword lookup for the Sounio lexer
//
// This module provides keyword recognition by matching identifier text
// against the set of reserved keywords.

// Import token kind constants (in a real module system, this would be an import)
// For now, we duplicate the constants or assume they're in scope

// ============================================================================
// STRING COMPARISON HELPERS
// ============================================================================

/// Compare two byte arrays for equality
fn bytes_equal(a: [i8; 256], a_len: i64, b: [i8; 256], b_len: i64) -> bool {
    if a_len != b_len {
        return false
    }
    var i: i64 = 0;
    while i < a_len {
        if a[i as usize] != b[i as usize] {
            return false
        }
        i = i + 1;
    }
    true
}

/// Create a keyword pattern from a string literal (up to 16 chars)
fn make_pattern(c0: i8, c1: i8, c2: i8, c3: i8, c4: i8, c5: i8, c6: i8, c7: i8,
                c8: i8, c9: i8, c10: i8, c11: i8, c12: i8, c13: i8, c14: i8, c15: i8,
                len: i64) -> [i8; 256] {
    var pattern: [i8; 256] = [0; 256];
    if len >= 1 { pattern[0] = c0; }
    if len >= 2 { pattern[1] = c1; }
    if len >= 3 { pattern[2] = c2; }
    if len >= 4 { pattern[3] = c3; }
    if len >= 5 { pattern[4] = c4; }
    if len >= 6 { pattern[5] = c5; }
    if len >= 7 { pattern[6] = c6; }
    if len >= 8 { pattern[7] = c7; }
    if len >= 9 { pattern[8] = c8; }
    if len >= 10 { pattern[9] = c9; }
    if len >= 11 { pattern[10] = c10; }
    if len >= 12 { pattern[11] = c11; }
    if len >= 13 { pattern[12] = c12; }
    if len >= 14 { pattern[13] = c13; }
    if len >= 15 { pattern[14] = c14; }
    if len >= 16 { pattern[15] = c15; }
    pattern
}

/// Match text against a keyword pattern
fn match_keyword(text: [i8; 256], text_len: i64,
                 c0: i8, c1: i8, c2: i8, c3: i8, c4: i8, c5: i8, c6: i8, c7: i8,
                 c8: i8, c9: i8, c10: i8, c11: i8, c12: i8, c13: i8, c14: i8, c15: i8,
                 kw_len: i64) -> bool {
    if text_len != kw_len {
        return false
    }
    if kw_len >= 1 && text[0] != c0 { return false }
    if kw_len >= 2 && text[1] != c1 { return false }
    if kw_len >= 3 && text[2] != c2 { return false }
    if kw_len >= 4 && text[3] != c3 { return false }
    if kw_len >= 5 && text[4] != c4 { return false }
    if kw_len >= 6 && text[5] != c5 { return false }
    if kw_len >= 7 && text[6] != c6 { return false }
    if kw_len >= 8 && text[7] != c7 { return false }
    if kw_len >= 9 && text[8] != c8 { return false }
    if kw_len >= 10 && text[9] != c9 { return false }
    if kw_len >= 11 && text[10] != c10 { return false }
    if kw_len >= 12 && text[11] != c11 { return false }
    if kw_len >= 13 && text[12] != c12 { return false }
    if kw_len >= 14 && text[13] != c13 { return false }
    if kw_len >= 15 && text[14] != c14 { return false }
    if kw_len >= 16 && text[15] != c15 { return false }
    true
}

// ============================================================================
// KEYWORD LOOKUP
// ============================================================================

// Token kind constants (duplicated from tokens.sio for now)
fn TK_IDENT() -> i32 { 200 }
fn TK_FN() -> i32 { 14 }
fn TK_LET() -> i32 { 15 }
fn TK_VAR() -> i32 { 16 }
fn TK_IF() -> i32 { 24 }
fn TK_ELSE() -> i32 { 25 }
fn TK_FOR() -> i32 { 27 }
fn TK_WHILE() -> i32 { 28 }
fn TK_LOOP() -> i32 { 29 }
fn TK_BREAK() -> i32 { 30 }
fn TK_CONTINUE() -> i32 { 31 }
fn TK_RETURN() -> i32 { 32 }
fn TK_IN() -> i32 { 33 }
fn TK_AS() -> i32 { 34 }
fn TK_STRUCT() -> i32 { 20 }
fn TK_ENUM() -> i32 { 21 }
fn TK_TRAIT() -> i32 { 22 }
fn TK_IMPL() -> i32 { 23 }
fn TK_TRUE() -> i32 { 39 }
fn TK_FALSE() -> i32 { 40 }
fn TK_MODULE() -> i32 { 10 }
fn TK_IMPORT() -> i32 { 11 }
fn TK_USE() -> i32 { 12 }
fn TK_PUB() -> i32 { 36 }
fn TK_CONST() -> i32 { 18 }
fn TK_TYPE() -> i32 { 19 }
fn TK_MATCH() -> i32 { 26 }
fn TK_WHERE() -> i32 { 35 }
fn TK_SELF_LOWER() -> i32 { 37 }
fn TK_SELF_UPPER() -> i32 { 38 }
fn TK_MUT() -> i32 { 17 }
fn TK_WITH() -> i32 { 53 }
fn TK_EFFECT() -> i32 { 50 }
fn TK_HANDLER() -> i32 { 51 }
fn TK_HANDLE() -> i32 { 52 }
fn TK_PERFORM() -> i32 { 54 }
fn TK_RESUME() -> i32 { 55 }
fn TK_LINEAR() -> i32 { 56 }
fn TK_AFFINE() -> i32 { 57 }
fn TK_MOVE() -> i32 { 58 }
fn TK_COPY() -> i32 { 59 }
fn TK_DROP() -> i32 { 60 }
fn TK_KERNEL() -> i32 { 70 }
fn TK_DEVICE() -> i32 { 72 }
fn TK_SHARED() -> i32 { 73 }
fn TK_GPU() -> i32 { 74 }
fn TK_ASYNC() -> i32 { 75 }
fn TK_AWAIT() -> i32 { 76 }
fn TK_SPAWN() -> i32 { 77 }
fn TK_UNSAFE() -> i32 { 41 }
fn TK_EXTERN() -> i32 { 42 }
fn TK_STATIC() -> i32 { 43 }
fn TK_EXPORT() -> i32 { 13 }
fn TK_TILE() -> i32 { 71 }

/// Lookup keyword from identifier text
/// Returns TK_IDENT if not a keyword
fn lookup_keyword(text: [i8; 256], len: i64) -> i32 {
    // 2-character keywords
    if len == 2 {
        // fn
        if text[0] == 102 && text[1] == 110 { return TK_FN() }
        // if
        if text[0] == 105 && text[1] == 102 { return TK_IF() }
        // in
        if text[0] == 105 && text[1] == 110 { return TK_IN() }
        // as
        if text[0] == 97 && text[1] == 115 { return TK_AS() }
        // do
        if text[0] == 100 && text[1] == 111 { return 133 }  // TK_DO
    }

    // 3-character keywords
    if len == 3 {
        // let
        if text[0] == 108 && text[1] == 101 && text[2] == 116 { return TK_LET() }
        // var
        if text[0] == 118 && text[1] == 97 && text[2] == 114 { return TK_VAR() }
        // for
        if text[0] == 102 && text[1] == 111 && text[2] == 114 { return TK_FOR() }
        // mut
        if text[0] == 109 && text[1] == 117 && text[2] == 116 { return TK_MUT() }
        // use
        if text[0] == 117 && text[1] == 115 && text[2] == 101 { return TK_USE() }
        // pub
        if text[0] == 112 && text[1] == 117 && text[2] == 98 { return TK_PUB() }
        // gpu
        if text[0] == 103 && text[1] == 112 && text[2] == 117 { return TK_GPU() }
        // ode
        if text[0] == 111 && text[1] == 100 && text[2] == 101 { return 110 }  // TK_ODE
        // pde
        if text[0] == 112 && text[1] == 100 && text[2] == 101 { return 111 }  // TK_PDE
    }

    // 4-character keywords
    if len == 4 {
        // else
        if text[0] == 101 && text[1] == 108 && text[2] == 115 && text[3] == 101 { return TK_ELSE() }
        // loop
        if text[0] == 108 && text[1] == 111 && text[2] == 111 && text[3] == 112 { return TK_LOOP() }
        // true
        if text[0] == 116 && text[1] == 114 && text[2] == 117 && text[3] == 101 { return TK_TRUE() }
        // enum
        if text[0] == 101 && text[1] == 110 && text[2] == 117 && text[3] == 109 { return TK_ENUM() }
        // impl
        if text[0] == 105 && text[1] == 109 && text[2] == 112 && text[3] == 108 { return TK_IMPL() }
        // type
        if text[0] == 116 && text[1] == 121 && text[2] == 112 && text[3] == 101 { return TK_TYPE() }
        // Self
        if text[0] == 83 && text[1] == 101 && text[2] == 108 && text[3] == 102 { return TK_SELF_UPPER() }
        // self
        if text[0] == 115 && text[1] == 101 && text[2] == 108 && text[3] == 102 { return TK_SELF_LOWER() }
        // with
        if text[0] == 119 && text[1] == 105 && text[2] == 116 && text[3] == 104 { return TK_WITH() }
        // move
        if text[0] == 109 && text[1] == 111 && text[2] == 118 && text[3] == 101 { return TK_MOVE() }
        // copy
        if text[0] == 99 && text[1] == 111 && text[2] == 112 && text[3] == 121 { return TK_COPY() }
        // drop
        if text[0] == 100 && text[1] == 114 && text[2] == 111 && text[3] == 112 { return TK_DROP() }
        // tile
        if text[0] == 116 && text[1] == 105 && text[2] == 108 && text[3] == 101 { return TK_TILE() }
        // from
        if text[0] == 102 && text[1] == 114 && text[2] == 111 && text[3] == 109 { return 151 }  // TK_FROM
        // grad
        if text[0] == 103 && text[1] == 114 && text[2] == 97 && text[3] == 100 { return 168 }  // TK_GRAD
        // dual
        if text[0] == 100 && text[1] == 117 && text[2] == 97 && text[3] == 108 { return 167 }  // TK_DUAL
        // quat
        if text[0] == 113 && text[1] == 117 && text[2] == 97 && text[3] == 116 { return 166 }  // TK_QUAT
        // vec2
        if text[0] == 118 && text[1] == 101 && text[2] == 99 && text[3] == 50 { return 160 }  // TK_VEC2
        // vec3
        if text[0] == 118 && text[1] == 101 && text[2] == 99 && text[3] == 51 { return 161 }  // TK_VEC3
        // vec4
        if text[0] == 118 && text[1] == 101 && text[2] == 99 && text[3] == 52 { return 162 }  // TK_VEC4
        // mat2
        if text[0] == 109 && text[1] == 97 && text[2] == 116 && text[3] == 50 { return 163 }  // TK_MAT2
        // mat3
        if text[0] == 109 && text[1] == 97 && text[2] == 116 && text[3] == 51 { return 164 }  // TK_MAT3
        // mat4
        if text[0] == 109 && text[1] == 97 && text[2] == 116 && text[3] == 52 { return 165 }  // TK_MAT4
    }

    // 5-character keywords
    if len == 5 {
        // while
        if text[0] == 119 && text[1] == 104 && text[2] == 105 && text[3] == 108 && text[4] == 101 { return TK_WHILE() }
        // break
        if text[0] == 98 && text[1] == 114 && text[2] == 101 && text[3] == 97 && text[4] == 107 { return TK_BREAK() }
        // false
        if text[0] == 102 && text[1] == 97 && text[2] == 108 && text[3] == 115 && text[4] == 101 { return TK_FALSE() }
        // trait
        if text[0] == 116 && text[1] == 114 && text[2] == 97 && text[3] == 105 && text[4] == 116 { return TK_TRAIT() }
        // const
        if text[0] == 99 && text[1] == 111 && text[2] == 110 && text[3] == 115 && text[4] == 116 { return TK_CONST() }
        // match
        if text[0] == 109 && text[1] == 97 && text[2] == 116 && text[3] == 99 && text[4] == 104 { return TK_MATCH() }
        // where
        if text[0] == 119 && text[1] == 104 && text[2] == 101 && text[3] == 114 && text[4] == 101 { return TK_WHERE() }
        // async
        if text[0] == 97 && text[1] == 115 && text[2] == 121 && text[3] == 110 && text[4] == 99 { return TK_ASYNC() }
        // await
        if text[0] == 97 && text[1] == 119 && text[2] == 97 && text[3] == 105 && text[4] == 116 { return TK_AWAIT() }
        // spawn
        if text[0] == 115 && text[1] == 112 && text[2] == 97 && text[3] == 119 && text[4] == 110 { return TK_SPAWN() }
        // infer
        if text[0] == 105 && text[1] == 110 && text[2] == 102 && text[3] == 101 && text[4] == 114 { return 92 }  // TK_INFER
        // proof
        if text[0] == 112 && text[1] == 114 && text[2] == 111 && text[3] == 111 && text[4] == 102 { return 93 }  // TK_PROOF
        // nodes
        if text[0] == 110 && text[1] == 111 && text[2] == 100 && text[3] == 101 && text[4] == 115 { return 113 }  // TK_NODES
        // edges
        if text[0] == 101 && text[1] == 100 && text[2] == 103 && text[3] == 101 && text[4] == 115 { return 114 }  // TK_EDGES
        // state
        if text[0] == 115 && text[1] == 116 && text[2] == 97 && text[3] == 116 && text[4] == 101 { return 116 }  // TK_STATE
        // query
        if text[0] == 113 && text[1] == 117 && text[2] == 101 && text[3] == 114 && text[4] == 121 { return 144 }  // TK_QUERY
        // align
        if text[0] == 97 && text[1] == 108 && text[2] == 105 && text[3] == 103 && text[4] == 110 { return 152 }  // TK_ALIGN
        // Valid
        if text[0] == 86 && text[1] == 97 && text[2] == 108 && text[3] == 105 && text[4] == 100 { return 135 }  // TK_VALID
        // Input
        if text[0] == 73 && text[1] == 110 && text[2] == 112 && text[3] == 117 && text[4] == 116 { return 143 }  // TK_INPUT_PROV
    }

    // 6-character keywords
    if len == 6 {
        // return
        if text[0] == 114 && text[1] == 101 && text[2] == 116 && text[3] == 117 && text[4] == 114 && text[5] == 110 { return TK_RETURN() }
        // struct
        if text[0] == 115 && text[1] == 116 && text[2] == 114 && text[3] == 117 && text[4] == 99 && text[5] == 116 { return TK_STRUCT() }
        // import
        if text[0] == 105 && text[1] == 109 && text[2] == 112 && text[3] == 111 && text[4] == 114 && text[5] == 116 { return TK_IMPORT() }
        // module
        if text[0] == 109 && text[1] == 111 && text[2] == 100 && text[3] == 117 && text[4] == 108 && text[5] == 101 { return TK_MODULE() }
        // export
        if text[0] == 101 && text[1] == 120 && text[2] == 112 && text[3] == 111 && text[4] == 114 && text[5] == 116 { return TK_EXPORT() }
        // effect
        if text[0] == 101 && text[1] == 102 && text[2] == 102 && text[3] == 101 && text[4] == 99 && text[5] == 116 { return TK_EFFECT() }
        // handle
        if text[0] == 104 && text[1] == 97 && text[2] == 110 && text[3] == 100 && text[4] == 108 && text[5] == 101 { return TK_HANDLE() }
        // resume
        if text[0] == 114 && text[1] == 101 && text[2] == 115 && text[3] == 117 && text[4] == 109 && text[5] == 101 { return TK_RESUME() }
        // linear
        if text[0] == 108 && text[1] == 105 && text[2] == 110 && text[3] == 101 && text[4] == 97 && text[5] == 114 { return TK_LINEAR() }
        // affine
        if text[0] == 97 && text[1] == 102 && text[2] == 102 && text[3] == 105 && text[4] == 110 && text[5] == 101 { return TK_AFFINE() }
        // kernel
        if text[0] == 107 && text[1] == 101 && text[2] == 114 && text[3] == 110 && text[4] == 101 && text[5] == 108 { return TK_KERNEL() }
        // device
        if text[0] == 100 && text[1] == 101 && text[2] == 118 && text[3] == 105 && text[4] == 99 && text[5] == 101 { return TK_DEVICE() }
        // shared
        if text[0] == 115 && text[1] == 104 && text[2] == 97 && text[3] == 114 && text[4] == 101 && text[5] == 100 { return TK_SHARED() }
        // unsafe
        if text[0] == 117 && text[1] == 110 && text[2] == 115 && text[3] == 97 && text[4] == 102 && text[5] == 101 { return TK_UNSAFE() }
        // extern
        if text[0] == 101 && text[1] == 120 && text[2] == 116 && text[3] == 101 && text[4] == 114 && text[5] == 110 { return TK_EXTERN() }
        // static
        if text[0] == 115 && text[1] == 116 && text[2] == 97 && text[3] == 116 && text[4] == 105 && text[5] == 99 { return TK_STATIC() }
        // sample
        if text[0] == 115 && text[1] == 97 && text[2] == 109 && text[3] == 112 && text[4] == 108 && text[5] == 101 { return 90 }  // TK_SAMPLE
        // assert
        if text[0] == 97 && text[1] == 115 && text[2] == 115 && text[3] == 101 && text[4] == 114 && text[5] == 116 { return 97 }  // TK_ASSERT
        // assume
        if text[0] == 97 && text[1] == 115 && text[2] == 115 && text[3] == 117 && text[4] == 109 && text[5] == 101 { return 98 }  // TK_ASSUME
        // causal
        if text[0] == 99 && text[1] == 97 && text[2] == 117 && text[3] == 115 && text[4] == 97 && text[5] == 108 { return 112 }  // TK_CAUSAL
        // params
        if text[0] == 112 && text[1] == 97 && text[2] == 114 && text[3] == 97 && text[4] == 109 && text[5] == 115 { return 117 }  // TK_PARAMS
        // domain
        if text[0] == 100 && text[1] == 111 && text[2] == 109 && text[3] == 97 && text[4] == 105 && text[5] == 110 { return 118 }  // TK_DOMAIN
        // Tensor
        if text[0] == 84 && text[1] == 101 && text[2] == 110 && text[3] == 115 && text[4] == 111 && text[5] == 114 { return 132 }  // TK_TENSOR
        // Source
        if text[0] == 83 && text[1] == 111 && text[2] == 117 && text[3] == 114 && text[4] == 99 && text[5] == 101 { return 139 }  // TK_SOURCE_PROV
        // compat
        if text[0] == 99 && text[1] == 111 && text[2] == 109 && text[3] == 112 && text[4] == 97 && text[5] == 116 { return 155 }  // TK_COMPAT
    }

    // 7-character keywords
    if len == 7 {
        // handler
        if text[0] == 104 && text[1] == 97 && text[2] == 110 && text[3] == 100 && text[4] == 108 && text[5] == 101 && text[6] == 114 { return TK_HANDLER() }
        // perform
        if text[0] == 112 && text[1] == 101 && text[2] == 114 && text[3] == 102 && text[4] == 111 && text[5] == 114 && text[6] == 109 { return TK_PERFORM() }
        // observe
        if text[0] == 111 && text[1] == 98 && text[2] == 115 && text[3] == 101 && text[4] == 114 && text[5] == 118 && text[6] == 101 { return 91 }  // TK_OBSERVE
        // initial
        if text[0] == 105 && text[1] == 110 && text[2] == 105 && text[3] == 116 && text[4] == 105 && text[5] == 97 && text[6] == 108 { return 120 }  // TK_INITIAL
        // Derived
        if text[0] == 68 && text[1] == 101 && text[2] == 114 && text[3] == 105 && text[4] == 118 && text[5] == 101 && text[6] == 100 { return 138 }  // TK_DERIVED
        // hessian
        if text[0] == 104 && text[1] == 101 && text[2] == 115 && text[3] == 115 && text[4] == 105 && text[5] == 97 && text[6] == 110 { return 170 }  // TK_HESSIAN
        // jacobian - 8 chars, handled below
    }

    // 8-character keywords
    if len == 8 {
        // continue
        if text[0] == 99 && text[1] == 111 && text[2] == 110 && text[3] == 116 &&
           text[4] == 105 && text[5] == 110 && text[6] == 117 && text[7] == 101 { return TK_CONTINUE() }
        // ontology
        if text[0] == 111 && text[1] == 110 && text[2] == 116 && text[3] == 111 &&
           text[4] == 108 && text[5] == 111 && text[6] == 103 && text[7] == 121 { return 150 }  // TK_ONTOLOGY
        // boundary
        if text[0] == 98 && text[1] == 111 && text[2] == 117 && text[3] == 110 &&
           text[4] == 100 && text[5] == 97 && text[6] == 114 && text[7] == 121 { return 119 }  // TK_BOUNDARY
        // requires
        if text[0] == 114 && text[1] == 101 && text[2] == 113 && text[3] == 117 &&
           text[4] == 105 && text[5] == 114 && text[6] == 101 && text[7] == 115 { return 95 }  // TK_REQUIRES
        // Quantity
        if text[0] == 81 && text[1] == 117 && text[2] == 97 && text[3] == 110 &&
           text[4] == 116 && text[5] == 105 && text[6] == 116 && text[7] == 121 { return 131 }  // TK_QUANTITY
        // Computed
        if text[0] == 67 && text[1] == 111 && text[2] == 109 && text[3] == 112 &&
           text[4] == 117 && text[5] == 116 && text[6] == 101 && text[7] == 100 { return 140 }  // TK_COMPUTED
        // Measured
        if text[0] == 77 && text[1] == 101 && text[2] == 97 && text[3] == 115 &&
           text[4] == 117 && text[5] == 114 && text[6] == 101 && text[7] == 100 { return 142 }  // TK_MEASURED
        // distance
        if text[0] == 100 && text[1] == 105 && text[2] == 115 && text[3] == 116 &&
           text[4] == 97 && text[5] == 110 && text[6] == 99 && text[7] == 101 { return 153 }  // TK_DISTANCE
        // jacobian
        if text[0] == 106 && text[1] == 97 && text[2] == 99 && text[3] == 111 &&
           text[4] == 98 && text[5] == 105 && text[6] == 97 && text[7] == 110 { return 169 }  // TK_JACOBIAN
    }

    // 9-character keywords
    if len == 9 {
        // invariant
        if text[0] == 105 && text[1] == 110 && text[2] == 118 && text[3] == 97 &&
           text[4] == 114 && text[5] == 105 && text[6] == 97 && text[7] == 110 && text[8] == 116 { return 94 }  // TK_INVARIANT
        // equations
        if text[0] == 101 && text[1] == 113 && text[2] == 117 && text[3] == 97 &&
           text[4] == 116 && text[5] == 105 && text[6] == 111 && text[7] == 110 && text[8] == 115 { return 115 }  // TK_EQUATIONS
        // Knowledge
        if text[0] == 75 && text[1] == 110 && text[2] == 111 && text[3] == 119 &&
           text[4] == 108 && text[5] == 101 && text[6] == 100 && text[7] == 103 && text[8] == 101 { return 130 }  // TK_KNOWLEDGE
        // threshold
        if text[0] == 116 && text[1] == 104 && text[2] == 114 && text[3] == 101 &&
           text[4] == 115 && text[5] == 104 && text[6] == 111 && text[7] == 108 && text[8] == 100 { return 154 }  // TK_THRESHOLD
    }

    // 10-character keywords
    if len == 10 {
        // Literature
        if text[0] == 76 && text[1] == 105 && text[2] == 116 && text[3] == 101 &&
           text[4] == 114 && text[5] == 97 && text[6] == 116 && text[7] == 117 &&
           text[8] == 114 && text[9] == 101 { return 141 }  // TK_LITERATURE
        // ValidUntil
        if text[0] == 86 && text[1] == 97 && text[2] == 108 && text[3] == 105 &&
           text[4] == 100 && text[5] == 85 && text[6] == 110 && text[7] == 116 &&
           text[8] == 105 && text[9] == 108 { return 136 }  // TK_VALID_UNTIL
        // ValidWhile
        if text[0] == 86 && text[1] == 97 && text[2] == 108 && text[3] == 105 &&
           text[4] == 100 && text[5] == 87 && text[6] == 104 && text[7] == 105 &&
           text[8] == 108 && text[9] == 101 { return 137 }  // TK_VALID_WHILE
    }

    // 12-character keywords
    if len == 12 {
        // OntologyTerm
        if text[0] == 79 && text[1] == 110 && text[2] == 116 && text[3] == 111 &&
           text[4] == 108 && text[5] == 111 && text[6] == 103 && text[7] == 121 &&
           text[8] == 84 && text[9] == 101 && text[10] == 114 && text[11] == 109 { return 156 }  // TK_ONTOLOGY_TERM
    }

    // 14-character keywords
    if len == 14 {
        // counterfactual
        if text[0] == 99 && text[1] == 111 && text[2] == 117 && text[3] == 110 &&
           text[4] == 116 && text[5] == 101 && text[6] == 114 && text[7] == 102 &&
           text[8] == 97 && text[9] == 99 && text[10] == 116 && text[11] == 117 &&
           text[12] == 97 && text[13] == 108 { return 134 }  // TK_COUNTERFACTUAL
    }

    // Not a keyword - return identifier
    TK_IDENT()
}

