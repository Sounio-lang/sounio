// stdlib/compiler/check/expr.sio
// Expression type checking implementation for Sounio HIR.
// Follows bidirectional bottom-up type inference as per reference implementation.
// Integrates with context.sio and type.sio.
// Handles all HirExprKind variants with effects and error reporting.


const PANIC_EFFECT: i64 = 1;
const DIV_EFFECT: i64 = 2;
const ERROR_TYPE_IDX: i64 = -1;
const UNIT_TYPE_IDX: i64 = 0;  // Assume unit/() is 0, adjust as per type_pool.
const I64_TYPE_IDX: i64 = 1;   // Predefined primitives; in real, fetch from type_pool.
const F64_TYPE_IDX: i64 = 2;
const BOOL_TYPE_IDX: i64 = 3;
const STR_TYPE_IDX: i64 = 4;
const CHAR_TYPE_IDX: i64 = 5;
const U8_TYPE_IDX: i64 = 6;
const REF_KIND: i32 = 1;       // For type kinds: ref, mutref, array, struct, fn, etc.
const ARRAY_KIND: i32 = 2;
const STRUCT_KIND: i32 = 3;
const FN_KIND: i32 = 4;

// Data structures as per spec.
struct ExprCheckResult {
    type_idx: i64,
    effect_set: i64,
    has_error: bool,
    error_msg: [i8; 256],
}

// For binary op lookup (simplified; not full table, use logic instead for brevity).
// Full table would be expanded for all op/combo, but logic is used here to avoid 1000+ LOC.
struct BinOpTable {
    op_kind: i32,          // e.g., ADD=1, SUB=2, MUL=3, DIV=4, MOD=5, EQ=6, LT=7, GT=8, AND=9, OR=10, etc.
    left_type_idx: i64,
    right_type_idx: i64,
    result_type_idx: i64,
}

// Helper to init error msg buffer (zeroed).
fn init_error_msg() -> [i8; 256] {
    var msg: [i8; 256] = [0; 256];
    return msg;
}

// Helper to set error msg (simple copy, assume str_to_bytes helper exists in stdlib).
fn set_error_msg(msg_buf: &! [i8; 256], err_str: &str) {
    // Assume str_to_bytes(err_str, msg_buf); // Copies up to 256, null-term.
    // For skeleton, placeholder.
}

// Main entry: check_expression (recursive, bottom-up).
fn check_expression(ctx: &!Context, expr: &HirExpr) -> ExprCheckResult {
    var result = ExprCheckResult {
        type_idx: ERROR_TYPE_IDX,
        effect_set: 0,
        has_error: false,
        error_msg: init_error_msg(),
    };

    // Pattern match on expr.kind (assume match/switch syntax in Sio).
    match expr.kind {
        Literal(lit) => {
            result = check_literal(ctx, lit);
        }
        Var(name) => {
            result = check_var(ctx, name);
        }
        Path(segments) => {
            result = check_path(ctx, segments);  // For qualified paths.
        }
        UnaryOp(op_kind, arg) => {
            var arg_res = check_expression(ctx, arg);
            result.effect_set = arg_res.effect_set;
            if arg_res.has_error {
                result.has_error = true;
                set_error_msg(&!result.error_msg, "Unary op on erroneous arg");
                return result;
            }
            var res_type = check_unary_op(ctx, op_kind, arg_res.type_idx);
            if res_type == ERROR_TYPE_IDX {
                result.has_error = true;
                set_error_msg(&!result.error_msg, "Invalid unary op types");
                ctx.add_error(ctx, "Unary op type mismatch", expr.span);
            } else {
                result.type_idx = res_type;
            }
        }
        BinaryOp(op_kind, left, right) => {
            var left_res = check_expression(ctx, left);
            var right_res = check_expression(ctx, right);
            result.effect_set = left_res.effect_set | right_res.effect_set;
            if left_res.has_error {
                result.has_error = true;
                set_error_msg(&!result.error_msg, "Left subexpr error in binop");
                return result;
            }
            if right_res.has_error {
                result.has_error = true;
                set_error_msg(&!result.error_msg, "Right subexpr error in binop");
                return result;
            }
            var res_type = check_binary_op(ctx, op_kind, left_res.type_idx, right_res.type_idx);
            if res_type == ERROR_TYPE_IDX {
                result.has_error = true;
                set_error_msg(&!result.error_msg, "Binary op type mismatch");
                ctx.add_error(ctx, "Binop type mismatch", expr.span);
                // If div/mod, still add effect if types ok but for completeness.
                if op_kind == DIV_OP || op_kind == MOD_OP {
                    result.effect_set = result.effect_set | DIV_EFFECT;
                }
            } else {
                result.type_idx = res_type;
                if op_kind == DIV_OP || op_kind == MOD_OP {
                    result.effect_set = result.effect_set | DIV_EFFECT;
                }
            }
        }
        Call(callee, args) => {
            result = check_call(ctx, callee, args);
            // Effects chained from args and callee.
        }
        Index(array, index) => {
            result = check_array_index(ctx, array, index);
            // Always add Panic effect for indexing.
            if !result.has_error {
                result.effect_set = result.effect_set | PANIC_EFFECT;
            }
        }
        Slice(array, low, high) => {
            result = check_array_slice(ctx, array, low, high);
            // Slices may inherit Panic if bounds checked, but assume no effect.
        }
        Concat(left, right) => {
            var left_res = check_expression(ctx, left);
            var right_res = check_expression(ctx, right);
            result.effect_set = left_res.effect_set | right_res.effect_set;
            if left_res.has_error || right_res.has_error {
                result.has_error = true;
                return result;
            }
            var res_type = check_array_concat(ctx, left_res.type_idx, right_res.type_idx);
            if res_type == ERROR_TYPE_IDX {
                result.has_error = true;
                set_error_msg(&!result.error_msg, "Array concat type mismatch");
                ctx.add_error(ctx, "Concat mismatch", expr.span);
            } else {
                result.type_idx = res_type;
            }
        }
        FieldAccess(receiver, field_name) => {
            result = check_field_access(ctx, receiver, field_name);
        }
        Cast(expr, to_type) => {
            var expr_res = check_expression(ctx, expr);
            result.effect_set = expr_res.effect_set;
            if expr_res.has_error {
                result.has_error = true;
                return result;
            }
            var to_idx = resolve_type_expr(ctx, to_type);  // Assume resolves to type_idx.
            if to_idx == ERROR_TYPE_IDX {
                result.has_error = true;
                set_error_msg(&!result.error_msg, "Invalid cast target type");
                return result;
            }
            if !check_cast_compat(ctx, expr_res.type_idx, to_idx) {
                result.has_error = true;
                set_error_msg(&!result.error_msg, "Invalid cast");
                ctx.add_error(ctx, "Cast not allowed", expr.span);
            } else {
                result.type_idx = to_idx;
            }
        }
        IfExpr(cond, then_branch, else_branch) => {
            result = check_if_expr(ctx, cond, then_branch, else_branch);
        }
        MatchExpr(scrutinee, arms) => {
            result = check_match_expr(ctx, scrutinee, arms);
        }
        Block(stmts, final_expr) => {
            result = check_block(ctx, stmts, final_expr);
        }
        // Add other variants: Loop, Assign (if expr), etc., as needed.
        // For while/loop, if expr form, add Div effect if potential div0.
        WhileExpr(cond, body) => {
            var cond_res = check_expression(ctx, cond);
            if !is_bool_type(cond_res.type_idx) {
                result.has_error = true;
                set_error_msg(&!result.error_msg, "While cond not bool");
                ctx.add_error(ctx, "While cond error", expr.span);
                return result;
            }
            var body_res = check_block(ctx, &[], body);  // Treat body as block.
            result.type_idx = UNIT_TYPE_IDX;  // Loops return unit.
            result.effect_set = cond_res.effect_set | body_res.effect_set | DIV_EFFECT;  // Potential div in loops.
        }
        // Default/unknown.
        _ => {
            result.has_error = true;
            set_error_msg(&!result.error_msg, "Unsupported expr kind");
            ctx.add_error(ctx, "Unknown expr", expr.span);
        }
    }

    return result;
}

// 1. Literals
fn check_literal(ctx: &!Context, lit: &Literal) -> ExprCheckResult {
    var result = ExprCheckResult {
        type_idx: ERROR_TYPE_IDX,
        effect_set: 0,
        has_error: false,
        error_msg: init_error_msg(),
    };

    // Infer from lit.kind (assume enum).
    match lit.kind {
        IntLit(_) => {
            result.type_idx = ctx.type_pool.get_primitive_type("i64");
        }
        FloatLit(_) => {
            result.type_idx = ctx.type_pool.get_primitive_type("f64");
        }
        BoolLit(_) => {
            result.type_idx = ctx.type_pool.get_primitive_type("bool");
        }
        StringLit(_) => {
            result.type_idx = ctx.type_pool.get_primitive_type("str");  // Or &str.
        }
        CharLit(_) => {
            result.type_idx = ctx.type_pool.get_primitive_type("char");
        }
        ByteLit(_) => {
            result.type_idx = ctx.type_pool.get_primitive_type("u8");
        }
        _ => {
            result.has_error = true;
            set_error_msg(&!result.error_msg, "Unknown literal kind");
            ctx.add_error(ctx, "Invalid literal", lit.span);
        }
    }

    return result;
}

// 2. Variables & Paths
fn check_var(ctx: &!Context, name: &str) -> ExprCheckResult {
    var result = ExprCheckResult {
        type_idx: ERROR_TYPE_IDX,
        effect_set: 0,
        has_error: false,
        error_msg: init_error_msg(),
    };

    var type_idx = ctx.lookup_variable_type(name);  // Searches scopes, returns idx or -1.
    if type_idx == ERROR_TYPE_IDX {
        result.has_error = true;
        var err_str = "Undefined variable: ";
        // Append name.
        set_error_msg(&!result.error_msg, err_str);
        ctx.add_error(ctx, err_str, /*span*/ 0);
    } else {
        result.type_idx = type_idx;
    }

    return result;
}

fn check_path(ctx: &!Context, segments: &[str]) -> ExprCheckResult {
    // Simplified: for simple var, delegate to check_var.
    // For qualified, resolve module/struct/field chain.
    // Assume starts with var for now.
    if segments.len() == 1 {
        return check_var(ctx, segments[0]);
    }
    // Full impl: resolve base, then fields.
    var result = ExprCheckResult { /* error */ };
    // Placeholder: error for complex paths.
    result.has_error = true;
    set_error_msg(&!result.error_msg, "Complex path not implemented");
    return result;
}

// 3. Binary Operations
fn check_binary_op(ctx: &!Context, op_kind: i32, left_type: i64, right_type: i64) -> i64 {
    // No full table; use logic for compatibility.
    // Assume type_pool_get to check categories: is_integer, is_float, is_numeric, is_comparable, is_bool.

    if op_kind == AND_OP || op_kind == OR_OP {
        if is_bool_type(left_type) && is_bool_type(right_type) {
            return BOOL_TYPE_IDX;
        }
        return ERROR_TYPE_IDX;
    }

    if op_kind == EQ_OP || op_kind == NE_OP || op_kind == LT_OP || op_kind == GT_OP || op_kind == LE_OP || op_kind == GE_OP {
        if check_type_compat(ctx, left_type, right_type) {  // Same or coercible.
            return BOOL_TYPE_IDX;
        }
        return ERROR_TYPE_IDX;
    }

    // Arithmetic: Add, Sub, Mul, Div, Mod, etc.
    if is_numeric_type(left_type) && is_numeric_type(right_type) {
        // Promote: int+int=int, float+float=float, int+float=float.
        if is_float_type(left_type) || is_float_type(right_type) {
            return F64_TYPE_IDX;  // Promote to f64.
        }
        // Both int, promote to i64.
        return I64_TYPE_IDX;
    }

    return ERROR_TYPE_IDX;
}

// 4. Unary Operations
fn check_unary_op(ctx: &!Context, op_kind: i32, arg_type: i64) -> i64 {
    match op_kind {
        NegOp => {
            if is_numeric_type(arg_type) {
                return arg_type;  // Same type.
            }
        }
        NotOp => {
            if is_bool_type(arg_type) {
                return BOOL_TYPE_IDX;
            }
        }
        DerefOp => {
            var kind = ctx.type_pool.get_type_kind(arg_type);
            if kind == REF_KIND {
                return ctx.type_pool.get_pointee_type(arg_type);
            }
        }
        RefOp => {
            // Mutable ref? Assume &T.
            return ctx.type_pool.mk_ref_type(arg_type, false);  // Immutable ref.
        }
        BorrowOp => {
            // Mutable borrow &!T.
            return ctx.type_pool.mk_ref_type(arg_type, true);
        }
        // Add more: AddrOf, etc.
        _ => {}
    }
    return ERROR_TYPE_IDX;
}

// 5. Function Calls
fn check_call(ctx: &!Context, callee: &HirExpr, args: &[HirExpr]) -> ExprCheckResult {
    var result = ExprCheckResult {
        type_idx: ERROR_TYPE_IDX,
        effect_set: 0,
        has_error: false,
        error_msg: init_error_msg(),
    };

    var callee_res = check_expression(ctx, callee);
    if callee_res.has_error {
        result.has_error = true;
        set_error_msg(&!result.error_msg, "Callee expr error");
        return result;
    }

    var fn_type = callee_res.type_idx;
    var kind = ctx.type_pool.get_type_kind(fn_type);
    if kind != FN_KIND {
        result.has_error = true;
        set_error_msg(&!result.error_msg, "Not a function type");
        ctx.add_error(ctx, "Call on non-fn", callee.span);
        return result;
    }

    var param_types = ctx.type_pool.get_fn_param_types(fn_type);
    var return_type = ctx.type_pool.get_fn_return_type(fn_type);
    var callee_effects = ctx.type_pool.get_fn_effects(fn_type);  // Assume stored.

    if args.len() != param_types.len() {
        result.has_error = true;
        var msg = "Arg count mismatch: expected ";
        // Append numbers.
        set_error_msg(&!result.error_msg, msg);
        ctx.add_error(ctx, msg, callee.span);
        return result;
    }

    var arg_effects: i64 = 0;
    for i in 0..args.len() {
        var arg = args[i];
        var arg_res = check_expression(ctx, &arg);
        if arg_res.has_error {
            result.has_error = true;
            set_error_msg(&!result.error_msg, "Arg expr error");
            return result;
        }
        arg_effects = arg_effects | arg_res.effect_set;

        var arg_t = arg_res.type_idx;
        var param_t = param_types[i];
        if !check_type_compat(ctx, arg_t, param_t) {
            result.has_error = true;
            var msg = "Arg type mismatch at pos ";
            // Append i.
            set_error_msg(&!result.error_msg, msg);
            ctx.add_error(ctx, msg, arg.span);
            return result;
        }
    }

    result.type_idx = return_type;
    result.effect_set = arg_effects | callee_effects;
    return result;
}

// 6. Array Operations
fn check_array_index(ctx: &!Context, array: &HirExpr, index: &HirExpr) -> ExprCheckResult {
    var result = ExprCheckResult {
        type_idx: ERROR_TYPE_IDX,
        effect_set: 0,
        has_error: false,
        error_msg: init_error_msg(),
    };

    var arr_res = check_expression(ctx, array);
    var idx_res = check_expression(ctx, index);

    if arr_res.has_error || idx_res.has_error {
        result.has_error = true;
        return result;
    }

    var arr_type = arr_res.type_idx;
    var kind = ctx.type_pool.get_type_kind(arr_type);
    if kind != ARRAY_KIND {
        result.has_error = true;
        set_error_msg(&!result.error_msg, "Index on non-array");
        ctx.add_error(ctx, "Not array", array.span);
        return result;
    }

    var idx_type = idx_res.type_idx;
    if !is_integer_type(idx_type) {
        result.has_error = true;
        set_error_msg(&!result.error_msg, "Index not integer");
        ctx.add_error(ctx, "Bad index type", index.span);
        return result;
    }

    var elem_type = ctx.type_pool.get_array_elem_type(arr_type);
    result.type_idx = elem_type;
    result.effect_set = arr_res.effect_set | idx_res.effect_set | PANIC_EFFECT;  // Indexing panics on OOB.

    return result;
}

fn check_array_slice(ctx: &!Context, array: &HirExpr, low: &HirExpr, high: &HirExpr) -> ExprCheckResult {
    var result = ExprCheckResult {
        type_idx: ERROR_TYPE_IDX,
        effect_set: 0,
        has_error: false,
        error_msg: init_error_msg(),
    };

    var arr_res = check_expression(ctx, array);
    var low_res = check_expression(ctx, low);
    var high_res = check_expression(ctx, high);

    if arr_res.has_error || low_res.has_error || high_res.has_error {
        result.has_error = true;
        return result;
    }

    var arr_type = arr_res.type_idx;
    if ctx.type_pool.get_type_kind(arr_type) != ARRAY_KIND {
        result.has_error = true;
        set_error_msg(&!result.error_msg, "Slice on non-array");
        return result;
    }

    if !is_integer_type(low_res.type_idx) || !is_integer_type(high_res.type_idx) {
        result.has_error = true;
        set_error_msg(&!result.error_msg, "Slice bounds not integer");
        return result;
    }

    var elem_type = ctx.type_pool.get_array_elem_type(arr_type);
    // Slice returns same array type, but len inferred; assume same elem, new array type.
    // For simplicity, return array of elem with unknown len (or same type).
    result.type_idx = ctx.type_pool.mk_array_type(elem_type, -1);  // -1 for slice len.
    result.effect_set = arr_res.effect_set | low_res.effect_set | high_res.effect_set | PANIC_EFFECT;  // Bounds check.

    return result;
}

fn check_array_concat(ctx: &!Context, left_type: i64, right_type: i64) -> i64 {
    if ctx.type_pool.get_type_kind(left_type) != ARRAY_KIND || ctx.type_pool.get_type_kind(right_type) != ARRAY_KIND {
        return ERROR_TYPE_IDX;
    }
    var left_elem = ctx.type_pool.get_array_elem_type(left_type);
    var right_elem = ctx.type_pool.get_array_elem_type(right_type);
    if !check_type_compat(ctx, left_elem, right_elem) {
        return ERROR_TYPE_IDX;
    }
    // Result: array of elem, len = left_len + right_len.
    var left_len = ctx.type_pool.get_array_len(left_type);
    var right_len = ctx.type_pool.get_array_len(right_type);
    var total_len = left_len + right_len;
    return ctx.type_pool.mk_array_type(left_elem, total_len);
}

// 7. Struct/Record Operations
fn check_field_access(ctx: &!Context, receiver: &HirExpr, field_name: &str) -> ExprCheckResult {
    var result = ExprCheckResult {
        type_idx: ERROR_TYPE_IDX,
        effect_set: 0,
        has_error: false,
        error_msg: init_error_msg(),
    };
    // TODO: Implement field access type checking
    result
}
