// stdlib/compiler/check/pattern.sio
// Pattern matching type checking - minimal bootstrap stub

fn PAT_IDENT() -> i32 { 0 }
fn PAT_WILDCARD() -> i32 { 1 }
fn PAT_TUPLE() -> i32 { 2 }
fn PAT_STRUCT() -> i32 { 3 }
fn PAT_ENUM() -> i32 { 4 }

struct Pattern {
    kind: i32,
}

fn pattern_new() -> Pattern {
    Pattern { kind: PAT_WILDCARD() }
}
