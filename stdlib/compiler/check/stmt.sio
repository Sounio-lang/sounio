// stdlib/compiler/check/stmt.sio
// Statement and Item Type Checking for Sounio
// Implements type checking for HIR statements and top-level items.
// Follows Sounio syntax rules: var for mutable, &!T for mut refs, etc.


// Data structures as specified
struct StmtCheckResult {
    context: TypeContext,
    effects: i64,  // Bitflags for effects like Panic, Alloc, etc.
    has_error: bool,
}

struct Binding {
    name: [i8; 64],  // Fixed-size string for names
    type_idx: i64,   // Index into type table
    is_mutable: bool,
}

// Helper to create a new StmtCheckResult
fn new_stmt_check_result(ctx: TypeContext, effects: i64, has_error: bool) -> StmtCheckResult {
    StmtCheckResult {
        context: ctx,
        effects: effects,
        has_error: has_error,
    }
}

// Core helper functions

// Check if a type exists in the context
fn check_type_exists(ctx: &TypeContext, type_idx: i64) -> bool {
    // Assume context has a method or lookup table for types
    if type_idx < 0 {
        return false;
    }
    // Pseudo-lookup: in real impl, use ctx.types.contains_key(type_idx)
    true  // Placeholder; implement actual lookup
}

// Add a local binding to the context
fn add_local_binding(ctx: TypeContext, name: [i8; 64], type_idx: i64, is_mutable: bool) -> TypeContext {
    let mut new_ctx = ctx.clone();
    let binding = Binding {
        name: name,
        type_idx: type_idx,
        is_mutable: is_mutable,
    };
    // Assume new_ctx.locals.push(binding) or similar
    // In real: new_ctx.add_binding(name, type_idx, is_mutable)
    new_ctx  // Placeholder
}

// Chain effects from sub-statements (bitwise OR)
fn chain_effects(effects1: i64, effects2: i64) -> i64 {
    effects1 | effects2
}

// Check a single statement kind
fn check_stmt_kind(ctx: TypeContext, kind: HirStmtKind) -> StmtCheckResult {
    match kind {
        HirStmtKindLet { name, type_hint, init_expr } => {
            check_let(ctx, name, type_hint, init_expr)
        }
        HirStmtKindAssign { target, value } => {
            let res = check_assign(ctx, target, value);
            new_stmt_check_result(res, 0, false)  // Assignments have no return type
        }
        HirStmtKindExprStmt { expr } => {
            check_expr_stmt(ctx, expr)
        }
        HirStmtKindReturn { expr } => {
            check_return(ctx, expr)
        }
        HirStmtKindWhile { cond, body } => {
            let res = check_while(ctx, cond, body);
            new_stmt_check_result(res, 0, false)
        }
        HirStmtKindBreak => {
            check_break(ctx)
        }
        HirStmtKindContinue => {
            check_continue(ctx)
        }
        _ => {
            // Unknown or block stmt; handle blocks by recursing
            new_stmt_check_result(ctx, 0, true)  // Error for unhandled
        }
    }
}

// Check a sequence of statements (e.g., block body)
fn check_stmts(ctx: TypeContext, stmts: &[HirStmt]) -> StmtCheckResult {
    let mut current_ctx = ctx;
    let mut total_effects = 0;
    let mut has_error = false;

    for stmt in stmts {
        let res = check_stmt(current_ctx, stmt.clone());
        current_ctx = res.context;
        total_effects = chain_effects(total_effects, res.effects);
        if res.has_error {
            has_error = true;
        }
    }

    new_stmt_check_result(current_ctx, total_effects, has_error)
}

// Wrapper to check a full statement (including pushing/popping scopes if needed)
fn check_stmt(ctx: TypeContext, stmt: HirStmt) -> StmtCheckResult {
    // For blocks, push/pop scope
    if let HirStmtKindBlock { stmts } = &stmt.kind {
        let new_ctx = ctx.push_scope();
        let res = check_stmts(new_ctx, stmts);
        let final_ctx = res.context.pop_scope();
        new_stmt_check_result(final_ctx, res.effects, res.has_error)
    } else {
        check_stmt_kind(ctx, stmt.kind)
    }
}

// Specific statement checkers

// 1. Variable Declaration: let x: T = expr;
fn check_let(ctx: TypeContext, name: [i8; 64], type_hint: Option<i64>, init_expr: HirExpr) -> StmtCheckResult {
    // Type check the init_expr
    let expr_res = check_expr(ctx.clone(), init_expr);  // Assume check_expr exists, returns (ctx, type_idx, effects)
    let inferred_type = expr_res.1;  // Unpack
    let mut effects = expr_res.2;

    let ty = if let Some(hint) = type_hint {
        if !check_type_exists(&ctx, hint) {
            ctx.add_error(ContextErrorUnknownType(hint));
            return new_stmt_check_result(ctx, effects, true);
        }
        // Check compatibility: inferred_type == hint or subtype
        if inferred_type != hint {
            ctx.add_error(ContextErrorTypeMismatch(inferred_type, hint));
            return new_stmt_check_result(ctx, effects, true);
        }
        hint
    } else {
        // Infer from init
        inferred_type
    };

    // For mutable, use 'var' but here assume let is immutable unless specified
    let is_mutable = false;  // Default; could be param if Sounio has mut lets
    ctx = add_local_binding(ctx, name, ty, is_mutable);

    new_stmt_check_result(ctx, effects, false)
}

// 2. Assignment: x = expr;
fn check_assign(ctx: TypeContext, target: HirExpr, value: HirExpr) -> TypeContext {
    // Assume target is a path expr (variable lookup)
    if let HirExprPath { name } = target {
        // Lookup binding
        if let Some(binding) = ctx.lookup_binding(name) {  // Assume method
            let target_ty = binding.type_idx;

            // Check value
            let value_res = check_expr(ctx.clone(), value);
            let value_ty = value_res.0;  // Unpack (ctx, ty, effects)

            if value_ty != target_ty {
                ctx.add_error(ContextErrorTypeMismatch(value_ty, target_ty));
                return ctx;  // Error, but continue
            }

            // For mutable refs, check if target is mutable
            if !binding.is_mutable {
                ctx.add_error(ContextErrorImmutableAssign);
            }

            // Chain effects
            ctx.effects |= value_res.1;  // Assume effects in tuple

            ctx
        } else {
            ctx.add_error(ContextErrorUndefinedVar(name));
            ctx
        }
    } else {
        ctx.add_error(ContextErrorInvalidLValue(target));
        ctx
    }
}

// 3. Expression Statement: expr;
fn check_expr_stmt(ctx: TypeContext, expr: HirExpr) -> StmtCheckResult {
    let res = check_expr(ctx, expr);  // (ctx, ty, effects)
    // Discard ty, expect unit or void
    let ty = res.0;
    if ty != ctx.unit_type_idx() {  // Assume method for unit
        // Warn or error if non-unit, but Sounio may allow
    }
    new_stmt_check_result(res.1, res.2, false)  // ctx, effects, no error
}

// 4. Return Statement: return expr;
fn check_return(ctx: TypeContext, expr: HirExpr) -> StmtCheckResult {
    let res = check_expr(ctx.clone(), expr);
    let ret_ty = res.0;  // ty from expr

    // Get current function's return type (assume ctx.current_fn_ret)
    let fn_ret_ty = ctx.current_fn_ret_type();

    if ret_ty != fn_ret_ty {
        ctx.add_error(ContextErrorReturnTypeMismatch(ret_ty, fn_ret_ty));
        return new_stmt_check_result(ctx, res.2, true);
    }

    // Mark function as returning (assume ctx.mark_returning())
    let mut new_ctx = ctx;
    new_ctx.mark_returning();

    new_stmt_check_result(new_ctx, res.2, false)
}

// 5. While Loop: while cond { body }
fn check_while(ctx: TypeContext, cond: HirExpr, body_stmts: &[HirStmt]) -> TypeContext {
    // Check cond is bool
    let cond_res = check_expr(ctx.clone(), cond);
    let cond_ty = cond_res.0;
    if cond_ty != ctx.bool_type_idx() {
        ctx.add_error(ContextErrorExpectedBool(cond_ty));
        return ctx;
    }

    // Body in same scope (no new scope for while body in Sounio?)
    // But push scope for block
    let body_ctx = ctx.push_scope();
    let body_res = check_stmts(body_ctx, body_stmts);
    let final_ctx = body_res.context.pop_scope();

    // Chain effects: loop may have Panic, etc.
    final_ctx.effects |= cond_res.2 | body_res.effects | EffectsLOOP.bits();  // Assume

    // Check for break/continue validity: assume ctx.loop_depth > 0
    if ctx.loop_depth == 0 {
        ctx.add_error(ContextErrorBreakOutsideLoop);
    }

    final_ctx
}

// 6. Break
fn check_break(ctx: TypeContext) -> StmtCheckResult {
    if ctx.loop_depth == 0 {
        ctx.add_error(ContextErrorBreakOutsideLoop);
        return new_stmt_check_result(ctx, 0, true);
    }
    // Breaks propagate no value, effects from prior
    new_stmt_check_result(ctx, EffectsBREAK.bits(), false)
}

// Continue similar
fn check_continue(ctx: TypeContext) -> StmtCheckResult {
    if ctx.loop_depth == 0 {
        ctx.add_error(ContextErrorContinueOutsideLoop);
        return new_stmt_check_result(ctx, 0, true);
    }
    new_stmt_check_result(ctx, EffectsCONTINUE.bits(), false)
}

// Assume check_expr is defined elsewhere, e.g., in expr.sio
// For now, placeholder
fn check_expr(ctx: TypeContext, expr: HirExpr) -> (TypeContext, i64, i64) {  // (ctx, ty, effects)
    // Implementation depends on expr kind
    // E.g., for literals, path lookups, etc.
    // For array index: require Panic effect
    if let HirExprIndex { arr, idx } = expr {
        // Check types, add Panic effect
        let effects = EffectsPANIC.bits();
        return (ctx, ctx.i64_type_idx(), effects);  // Example
    }
    (ctx, ctx.unit_type_idx(), 0)
}

// Top-level item checkers

// Check item kind
fn check_item_kind(ctx: TypeContext, kind: HirItemKind) -> StmtCheckResult {
    match kind {
        HirItemKindFnDef { name, params, return_type, body } => {
            let res = check_fn_def(ctx, name, params, return_type, body);
            new_stmt_check_result(res, 0, false)
        }
        HirItemKindStructDef { name, fields } => {
            let res = check_struct_def(ctx, name, fields);
            new_stmt_check_result(res, 0, false)
        }
        HirItemKindEnumDef { name, variants } => {
            let res = check_enum_def(ctx, name, variants);
            new_stmt_check_result(res, 0, false)
        }
        HirItemKindTypeAlias { name, target_type } => {
            let res = check_type_alias(ctx, name, target_type);
            new_stmt_check_result(res, 0, false)
        }
        _ => new_stmt_check_result(ctx, 0, true),
    }
}

// Wrapper for full item
fn check_item(ctx: TypeContext, item: HirItem) -> TypeContext {
    let res = check_item_kind(ctx, item.kind);
    if res.has_error {
        // Propagate errors
    }
    res.context
}

// 1. Function Definitions
fn check_fn_def(ctx: TypeContext, name: [i8; 64], params: &[ ( [i8;64], i64 ) ], return_type: i64, body: &[HirStmt]) -> TypeContext {
    // Check return_type exists
    if !check_type_exists(&ctx, return_type) {
        let mut new_ctx = ctx.clone();
        new_ctx.add_error(ContextErrorUnknownType(return_type));
        return new_ctx;
    }

    // Check params: well-formed types
    for (param_name, param_ty) in params {
        if !check_type_exists(&ctx, *param_ty) {
            ctx.add_error(ContextErrorUnknownType(*param_ty));
            return ctx;
        }
        // No duplicates, etc.
    }

    // Push new scope for function
    let mut new_ctx = ctx.push_scope();
    new_ctx.current_fn_name = Some(name);
    new_ctx.current_fn_ret_type = Some(return_type);
    new_ctx.loop_depth = 0;  // Reset

    // Add params as bindings (immutable)
    for (param_name, param_ty) in params {
        new_ctx = add_local_binding(new_ctx, *param_name, *param_ty, false);
    }

    // Check body
    let body_res = check_stmts(new_ctx, body);
    let final_ctx = body_res.context.pop_scope();

    // If body doesn't return but fn does (non-unit), error unless unit
    if return_type != final_ctx.unit_type_idx() && !body_res.context.is_returning() {
        final_ctx.add_error(ContextErrorMissingReturn);
    }

    // Add function signature to global context
    // Assume final_ctx.add_fn_sig(name, params, return_type)

    final_ctx
}

// 2. Struct Definitions
fn check_struct_def(ctx: TypeContext, name: [i8; 64], fields: &[ ( [i8;64], i64 ) ]) -> TypeContext {
    // Check field types exist, no cycles (simple check)
    for (_, field_ty) in fields {
        if !check_type_exists(&ctx, *field_ty) {
            ctx.add_error(ContextErrorUnknownType(*field_ty));
            return ctx;
        }
    }

    // Add struct type to context
    // Assume ctx.add_struct_type(name, fields) -> type_idx
    let type_idx = ctx.add_struct_type(name, fields);  // Placeholder

    // No body, just definition
    ctx
}

// 3. Enum Definitions
fn check_enum_def(ctx: TypeContext, name: [i8; 64], variants: &[ ( [i8;64], Option<i64> ) ]) -> TypeContext {  // Variant name, optional payload ty
    for (_, payload) in variants {
        if let Some(ty) = payload {
            if !check_type_exists(&ctx, *ty) {
                ctx.add_error(ContextErrorUnknownType(*ty));
                return ctx;
            }
        }
    }

    // Add enum to context
    // ctx.add_enum_type(name, variants)
    ctx
}

// 4. Type Alias
fn check_type_alias(ctx: TypeContext, name: [i8; 64], target_type: i64) -> TypeContext {
    if !check_type_exists(&ctx, target_type) {
        ctx.add_error(ContextErrorUnknownType(target_type));
        return ctx;
    }

    // Add alias
    // ctx.add_alias(name, target_type)
    ctx
}

// Entry point for module: check a module's items and stmts
fn check_module_items(ctx: TypeContext, items: &[HirItem]) -> TypeContext {
    let mut current_ctx = ctx;
    for item in items {
        current_ctx = check_item(current_ctx, item.clone());
    }
    current_ctx
}

