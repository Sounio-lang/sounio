// compiler::check::env — Type Environment (Symbol Table)
//
// Symbol table and type bindings for the self-hosted type checker.

extern "C" {
    fn print(s: &str) -> ();
}

// ============================================================================
// BINDING KINDS
// ============================================================================

fn BIND_VAR() -> i32 { 0 }       // Variable binding
fn BIND_FN() -> i32 { 1 }        // Function binding
fn BIND_TYPE() -> i32 { 2 }      // Type alias
fn BIND_STRUCT() -> i32 { 3 }    // Struct definition
fn BIND_ENUM() -> i32 { 4 }      // Enum definition

// ============================================================================
// TYPE KIND CONSTANTS (duplicated from types.sio for standalone use)
// ============================================================================

fn TYPE_UNKNOWN() -> i32 { 0 }
fn TYPE_UNIT() -> i32 { 2 }
fn TYPE_BOOL() -> i32 { 3 }
fn TYPE_I32() -> i32 { 6 }
fn TYPE_I64() -> i32 { 7 }
fn TYPE_F32() -> i32 { 12 }
fn TYPE_F64() -> i32 { 13 }

// ============================================================================
// SYMBOL BINDING
// ============================================================================

/// A binding in the environment
struct Binding {
    kind: i32,
    // Name of the binding
    name: [i8; 64],
    name_len: i64,
    // Type index (into type pool)
    type_idx: i64,
    // For variables: is mutable?
    is_mutable: bool,
    // For functions: parameter type indices
    param_types: [i64; 8],
    n_params: i64,
    // For functions: return type index
    return_type_idx: i64,
    // Scope depth
    scope_depth: i64,
}

fn binding_new() -> Binding {
    Binding {
        kind: BIND_VAR(),
        name: [0; 64],
        name_len: 0,
        type_idx: -1,
        is_mutable: false,
        param_types: [-1; 8],
        n_params: 0,
        return_type_idx: -1,
        scope_depth: 0,
    }
}

fn binding_var(name: [i8; 64], name_len: i64, type_idx: i64, is_mut: bool, depth: i64) -> Binding {
    var b = binding_new();
    b.kind = BIND_VAR();
    b.name = name;
    b.name_len = name_len;
    b.type_idx = type_idx;
    b.is_mutable = is_mut;
    b.scope_depth = depth;
    b
}

fn binding_fn(name: [i8; 64], name_len: i64, return_idx: i64, depth: i64) -> Binding {
    var b = binding_new();
    b.kind = BIND_FN();
    b.name = name;
    b.name_len = name_len;
    b.return_type_idx = return_idx;
    b.scope_depth = depth;
    b
}

// ============================================================================
// ENVIRONMENT
// ============================================================================

/// Type environment (symbol table)
struct Env {
    bindings: [Binding; 256],
    count: i64,
    scope_depth: i64,
}

fn env_new() -> Env {
    Env {
        bindings: [binding_new(); 256],
        count: 0,
        scope_depth: 0,
    }
}

/// Enter a new scope
fn env_enter_scope(env: Env) -> Env {
    var e = env;
    e.scope_depth = e.scope_depth + 1;
    e
}

/// Leave the current scope (removes bindings at this depth)
fn env_leave_scope(env: Env) -> Env {
    var e = env;

    // Remove bindings at current scope depth
    while e.count > 0 && e.bindings[(e.count - 1) as usize].scope_depth == e.scope_depth {
        e.count = e.count - 1;
    }

    e.scope_depth = e.scope_depth - 1;
    e
}

/// Add a binding to the environment
fn env_bind(env: Env, b: Binding) -> Env {
    var e = env;
    if e.count < 256 {
        var binding = b;
        binding.scope_depth = e.scope_depth;
        e.bindings[e.count as usize] = binding;
        e.count = e.count + 1;
    }
    e
}

/// Check if two names are equal
fn names_equal(a: [i8; 64], a_len: i64, b: [i8; 64], b_len: i64) -> bool {
    if a_len != b_len {
        return false
    }
    var i: i64 = 0;
    while i < a_len {
        if a[i as usize] != b[i as usize] {
            return false
        }
        i = i + 1;
    }
    true
}

/// Lookup a binding by name (returns most recent match)
fn env_lookup(env: Env, name: [i8; 64], name_len: i64) -> Binding {
    // Search from end (most recent) to beginning
    var i = env.count - 1;
    while i >= 0 {
        let b = env.bindings[i as usize];
        if names_equal(b.name, b.name_len, name, name_len) {
            return b
        }
        i = i - 1;
    }
    // Not found - return empty binding with -1 type
    binding_new()
}

/// Check if a name exists in the current scope
fn env_exists_in_scope(env: Env, name: [i8; 64], name_len: i64) -> bool {
    var i = env.count - 1;
    while i >= 0 {
        let b = env.bindings[i as usize];
        if b.scope_depth < env.scope_depth {
            // Reached outer scope
            return false
        }
        if names_equal(b.name, b.name_len, name, name_len) {
            return true
        }
        i = i - 1;
    }
    false
}

// ============================================================================
// HELPER FUNCTIONS
// ============================================================================

fn make_name(c0: i8, c1: i8, c2: i8, c3: i8, len: i64) -> [i8; 64] {
    var name: [i8; 64] = [0; 64];
    name[0] = c0;
    name[1] = c1;
    name[2] = c2;
    name[3] = c3;
    name
}

// ============================================================================
// TESTS
// ============================================================================

fn test_env_basic() -> bool {
    var env = env_new();

    // Create a name "x" (120 is 'x')
    let x_name = make_name(120, 0, 0, 0, 1);

    // Add binding for x: i32
    env = env_bind(env, binding_var(x_name, 1, 0, false, 0));

    if env.count != 1 {
        print("  Expected 1 binding\n");
        return false
    }

    // Lookup x
    let found = env_lookup(env, x_name, 1);
    if found.type_idx != 0 {
        print("  Should find x with type index 0\n");
        return false
    }

    // Lookup non-existent y (121 is 'y')
    let y_name = make_name(121, 0, 0, 0, 1);
    let not_found = env_lookup(env, y_name, 1);
    if not_found.type_idx != -1 {
        print("  Should not find y\n");
        return false
    }

    true
}

fn test_env_scopes() -> bool {
    var env = env_new();

    let x_name = make_name(120, 0, 0, 0, 1);

    // Add x in global scope
    env = env_bind(env, binding_var(x_name, 1, 0, false, 0));

    // Enter inner scope
    env = env_enter_scope(env);

    // Add shadowing x in inner scope
    env = env_bind(env, binding_var(x_name, 1, 1, true, 1));

    // Lookup should find inner x
    let inner_x = env_lookup(env, x_name, 1);
    if inner_x.type_idx != 1 {
        print("  Should find inner x with type index 1\n");
        return false
    }

    if !inner_x.is_mutable {
        print("  Inner x should be mutable\n");
        return false
    }

    // Leave inner scope
    env = env_leave_scope(env);

    // Lookup should find outer x again
    let outer_x = env_lookup(env, x_name, 1);
    if outer_x.type_idx != 0 {
        print("  Should find outer x with type index 0\n");
        return false
    }

    if outer_x.is_mutable {
        print("  Outer x should not be mutable\n");
        return false
    }

    true
}

fn test_env_exists_in_scope() -> bool {
    var env = env_new();

    let x_name = make_name(120, 0, 0, 0, 1);
    let y_name = make_name(121, 0, 0, 0, 1);

    // Add x in global scope
    env = env_bind(env, binding_var(x_name, 1, 0, false, 0));

    // Enter new scope
    env = env_enter_scope(env);

    // x should not exist in current scope (it's in outer)
    if env_exists_in_scope(env, x_name, 1) {
        print("  x should not be in current scope\n");
        return false
    }

    // Add y in current scope
    env = env_bind(env, binding_var(y_name, 1, 1, false, 1));

    // y should exist in current scope
    if !env_exists_in_scope(env, y_name, 1) {
        print("  y should be in current scope\n");
        return false
    }

    true
}

fn test_function_bindings() -> bool {
    var env = env_new();

    // Function name "add" (97='a', 100='d', 100='d')
    let add_name = make_name(97, 100, 100, 0, 3);

    // Create function binding with return type index 0
    var fn_bind = binding_fn(add_name, 3, 0, 0);
    fn_bind.n_params = 2;
    fn_bind.param_types[0] = 1;  // First param type index
    fn_bind.param_types[1] = 1;  // Second param type index

    env = env_bind(env, fn_bind);

    // Lookup the function
    let found = env_lookup(env, add_name, 3);

    if found.kind != BIND_FN() {
        print("  Should find function binding\n");
        return false
    }

    if found.n_params != 2 {
        print("  Function should have 2 params\n");
        return false
    }

    if found.return_type_idx != 0 {
        print("  Wrong return type index\n");
        return false
    }

    true
}

fn main() -> i32 {
    print("Testing type environment...\n\n");

    var passed: i64 = 0;
    var failed: i64 = 0;

    if test_env_basic() {
        print("PASS: test_env_basic\n");
        passed = passed + 1;
    } else {
        print("FAIL: test_env_basic\n");
        failed = failed + 1;
    }

    if test_env_scopes() {
        print("PASS: test_env_scopes\n");
        passed = passed + 1;
    } else {
        print("FAIL: test_env_scopes\n");
        failed = failed + 1;
    }

    if test_env_exists_in_scope() {
        print("PASS: test_env_exists_in_scope\n");
        passed = passed + 1;
    } else {
        print("FAIL: test_env_exists_in_scope\n");
        failed = failed + 1;
    }

    if test_function_bindings() {
        print("PASS: test_function_bindings\n");
        passed = passed + 1;
    } else {
        print("FAIL: test_function_bindings\n");
        failed = failed + 1;
    }

    print("\n");
    if failed == 0 {
        print("All environment tests passed!\n");
        0
    } else {
        print("Some tests failed.\n");
        1
    }
}
