// compiler::check::types — Type Representation
//
// Type system for the self-hosted Sounio type checker.

extern "C" {
    fn print(s: &str) -> ();
}

// ============================================================================
// TYPE KIND CONSTANTS
// ============================================================================

fn TYPE_UNKNOWN() -> i32 { 0 }
fn TYPE_NEVER() -> i32 { 1 }
fn TYPE_UNIT() -> i32 { 2 }
fn TYPE_BOOL() -> i32 { 3 }
fn TYPE_I8() -> i32 { 4 }
fn TYPE_I16() -> i32 { 5 }
fn TYPE_I32() -> i32 { 6 }
fn TYPE_I64() -> i32 { 7 }
fn TYPE_U8() -> i32 { 8 }
fn TYPE_U16() -> i32 { 9 }
fn TYPE_U32() -> i32 { 10 }
fn TYPE_U64() -> i32 { 11 }
fn TYPE_F32() -> i32 { 12 }
fn TYPE_F64() -> i32 { 13 }
fn TYPE_USIZE() -> i32 { 14 }
fn TYPE_ISIZE() -> i32 { 15 }
fn TYPE_STRING() -> i32 { 16 }
fn TYPE_CHAR() -> i32 { 17 }
fn TYPE_REF() -> i32 { 18 }       // &T
fn TYPE_REF_MUT() -> i32 { 19 }   // &!T
fn TYPE_ARRAY() -> i32 { 20 }     // [T; N]
fn TYPE_SLICE() -> i32 { 21 }     // [T]
fn TYPE_TUPLE() -> i32 { 22 }     // (T1, T2, ...)
fn TYPE_STRUCT() -> i32 { 23 }
fn TYPE_ENUM() -> i32 { 24 }
fn TYPE_FN() -> i32 { 25 }        // fn(T) -> R
fn TYPE_VAR() -> i32 { 26 }       // Type variable for inference

// ============================================================================
// TYPE REPRESENTATION
// ============================================================================

/// Represents a type in the type system
struct Type {
    kind: i32,
    // For composite types (ref, array, etc.) - index into type pool
    inner_idx: i64,
    // For arrays - the size
    array_size: i64,
    // For named types (struct/enum) - name
    name: [i8; 64],
    name_len: i64,
    // For tuples/function params - element type indices
    elem_types: [i64; 8],
    n_elems: i64,
    // For functions - return type index
    return_type_idx: i64,
    // For type variables - unique ID
    var_id: i64,
}

fn type_new() -> Type {
    Type {
        kind: TYPE_UNKNOWN(),
        inner_idx: -1,
        array_size: 0,
        name: [0; 64],
        name_len: 0,
        elem_types: [-1; 8],
        n_elems: 0,
        return_type_idx: -1,
        var_id: 0,
    }
}

// ============================================================================
// TYPE CONSTRUCTORS
// ============================================================================

fn type_unit() -> Type {
    var t = type_new();
    t.kind = TYPE_UNIT();
    t
}

fn type_bool() -> Type {
    var t = type_new();
    t.kind = TYPE_BOOL();
    t
}

fn type_i32() -> Type {
    var t = type_new();
    t.kind = TYPE_I32();
    t
}

fn type_i64() -> Type {
    var t = type_new();
    t.kind = TYPE_I64();
    t
}

fn type_f32() -> Type {
    var t = type_new();
    t.kind = TYPE_F32();
    t
}

fn type_f64() -> Type {
    var t = type_new();
    t.kind = TYPE_F64();
    t
}

fn type_string() -> Type {
    var t = type_new();
    t.kind = TYPE_STRING();
    t
}

fn type_ref(inner_idx: i64) -> Type {
    var t = type_new();
    t.kind = TYPE_REF();
    t.inner_idx = inner_idx;
    t
}

fn type_ref_mut(inner_idx: i64) -> Type {
    var t = type_new();
    t.kind = TYPE_REF_MUT();
    t.inner_idx = inner_idx;
    t
}

fn type_array(inner_idx: i64, size: i64) -> Type {
    var t = type_new();
    t.kind = TYPE_ARRAY();
    t.inner_idx = inner_idx;
    t.array_size = size;
    t
}

fn type_var(id: i64) -> Type {
    var t = type_new();
    t.kind = TYPE_VAR();
    t.var_id = id;
    t
}

// ============================================================================
// TYPE POOL
// ============================================================================

/// Pool for storing types (simulating heap allocation)
struct TypePool {
    types: [Type; 256],
    count: i64,
}

fn type_pool_new() -> TypePool {
    TypePool {
        types: [type_new(); 256],
        count: 0,
    }
}

fn type_pool_add(pool: TypePool, t: Type) -> TypePool {
    var p = pool;
    if p.count < 256 {
        p.types[p.count as usize] = t;
        p.count = p.count + 1;
    }
    p
}

fn type_pool_get(pool: TypePool, idx: i64) -> Type {
    if idx >= 0 && idx < pool.count {
        pool.types[idx as usize]
    } else {
        type_new()  // Return unknown type
    }
}

fn type_pool_last_idx(pool: TypePool) -> i64 {
    pool.count - 1
}

// ============================================================================
// TYPE COMPARISON
// ============================================================================

/// Check if two types are equal
fn types_equal(a: Type, b: Type) -> bool {
    if a.kind != b.kind {
        return false
    }

    // Primitive types - just compare kind
    if a.kind == TYPE_UNIT() || a.kind == TYPE_BOOL() ||
       a.kind == TYPE_I8() || a.kind == TYPE_I16() ||
       a.kind == TYPE_I32() || a.kind == TYPE_I64() ||
       a.kind == TYPE_U8() || a.kind == TYPE_U16() ||
       a.kind == TYPE_U32() || a.kind == TYPE_U64() ||
       a.kind == TYPE_F32() || a.kind == TYPE_F64() ||
       a.kind == TYPE_USIZE() || a.kind == TYPE_ISIZE() ||
       a.kind == TYPE_STRING() || a.kind == TYPE_CHAR() {
        return true
    }

    // Reference types - compare inner
    if a.kind == TYPE_REF() || a.kind == TYPE_REF_MUT() {
        return a.inner_idx == b.inner_idx
    }

    // Array types - compare inner and size
    if a.kind == TYPE_ARRAY() {
        return a.inner_idx == b.inner_idx && a.array_size == b.array_size
    }

    // Type variables - compare ID
    if a.kind == TYPE_VAR() {
        return a.var_id == b.var_id
    }

    // Named types (struct/enum) - compare names
    if a.kind == TYPE_STRUCT() || a.kind == TYPE_ENUM() {
        if a.name_len != b.name_len {
            return false
        }
        var i: i64 = 0;
        while i < a.name_len {
            if a.name[i as usize] != b.name[i as usize] {
                return false
            }
            i = i + 1;
        }
        return true
    }

    // Default: assume not equal
    false
}

/// Check if type is numeric
fn is_numeric(t: Type) -> bool {
    t.kind == TYPE_I8() || t.kind == TYPE_I16() ||
    t.kind == TYPE_I32() || t.kind == TYPE_I64() ||
    t.kind == TYPE_U8() || t.kind == TYPE_U16() ||
    t.kind == TYPE_U32() || t.kind == TYPE_U64() ||
    t.kind == TYPE_F32() || t.kind == TYPE_F64() ||
    t.kind == TYPE_USIZE() || t.kind == TYPE_ISIZE()
}

/// Check if type is integer
fn is_integer(t: Type) -> bool {
    t.kind == TYPE_I8() || t.kind == TYPE_I16() ||
    t.kind == TYPE_I32() || t.kind == TYPE_I64() ||
    t.kind == TYPE_U8() || t.kind == TYPE_U16() ||
    t.kind == TYPE_U32() || t.kind == TYPE_U64() ||
    t.kind == TYPE_USIZE() || t.kind == TYPE_ISIZE()
}

/// Check if type is floating point
fn is_float(t: Type) -> bool {
    t.kind == TYPE_F32() || t.kind == TYPE_F64()
}

// ============================================================================
// TYPE PRINTING (for debugging)
// ============================================================================

fn print_type(t: Type) -> () {
    if t.kind == TYPE_UNKNOWN() { print("unknown") }
    if t.kind == TYPE_NEVER() { print("!") }
    if t.kind == TYPE_UNIT() { print("()") }
    if t.kind == TYPE_BOOL() { print("bool") }
    if t.kind == TYPE_I8() { print("i8") }
    if t.kind == TYPE_I16() { print("i16") }
    if t.kind == TYPE_I32() { print("i32") }
    if t.kind == TYPE_I64() { print("i64") }
    if t.kind == TYPE_U8() { print("u8") }
    if t.kind == TYPE_U16() { print("u16") }
    if t.kind == TYPE_U32() { print("u32") }
    if t.kind == TYPE_U64() { print("u64") }
    if t.kind == TYPE_F32() { print("f32") }
    if t.kind == TYPE_F64() { print("f64") }
    if t.kind == TYPE_USIZE() { print("usize") }
    if t.kind == TYPE_ISIZE() { print("isize") }
    if t.kind == TYPE_STRING() { print("string") }
    if t.kind == TYPE_CHAR() { print("char") }
    if t.kind == TYPE_REF() { print("&T") }
    if t.kind == TYPE_REF_MUT() { print("&!T") }
    if t.kind == TYPE_ARRAY() { print("[T; N]") }
    if t.kind == TYPE_VAR() { print("?T") }
    if t.kind == TYPE_STRUCT() { print("struct") }
    if t.kind == TYPE_ENUM() { print("enum") }
}

// ============================================================================
// TESTS
// ============================================================================

fn test_primitive_types() -> bool {
    let unit_t = type_unit();
    let bool_t = type_bool();
    let i32_t = type_i32();
    let i64_t = type_i64();
    let f64_t = type_f64();

    // Unit is not numeric
    if is_numeric(unit_t) {
        print("  unit should not be numeric\n");
        return false
    }

    // Bool is not numeric
    if is_numeric(bool_t) {
        print("  bool should not be numeric\n");
        return false
    }

    // i32 is numeric and integer
    if !is_numeric(i32_t) {
        print("  i32 should be numeric\n");
        return false
    }

    if !is_integer(i32_t) {
        print("  i32 should be integer\n");
        return false
    }

    // f64 is numeric but not integer
    if !is_numeric(f64_t) {
        print("  f64 should be numeric\n");
        return false
    }

    if is_integer(f64_t) {
        print("  f64 should not be integer\n");
        return false
    }

    if !is_float(f64_t) {
        print("  f64 should be float\n");
        return false
    }

    true
}

fn test_type_equality() -> bool {
    let i32_a = type_i32();
    let i32_b = type_i32();
    let i64_t = type_i64();

    if !types_equal(i32_a, i32_b) {
        print("  i32 should equal i32\n");
        return false
    }

    if types_equal(i32_a, i64_t) {
        print("  i32 should not equal i64\n");
        return false
    }

    true
}

fn test_type_pool() -> bool {
    var pool = type_pool_new();

    pool = type_pool_add(pool, type_i32());
    pool = type_pool_add(pool, type_i64());
    pool = type_pool_add(pool, type_bool());

    if pool.count != 3 {
        print("  Expected 3 types in pool\n");
        return false
    }

    let t0 = type_pool_get(pool, 0);
    if t0.kind != TYPE_I32() {
        print("  First type should be i32\n");
        return false
    }

    let t1 = type_pool_get(pool, 1);
    if t1.kind != TYPE_I64() {
        print("  Second type should be i64\n");
        return false
    }

    let t2 = type_pool_get(pool, 2);
    if t2.kind != TYPE_BOOL() {
        print("  Third type should be bool\n");
        return false
    }

    true
}

fn test_ref_types() -> bool {
    var pool = type_pool_new();

    // Add i32 to pool
    pool = type_pool_add(pool, type_i32());
    let i32_idx = type_pool_last_idx(pool);

    // Create &i32
    let ref_i32 = type_ref(i32_idx);

    if ref_i32.kind != TYPE_REF() {
        print("  Expected TYPE_REF\n");
        return false
    }

    if ref_i32.inner_idx != i32_idx {
        print("  Wrong inner type index\n");
        return false
    }

    true
}

fn test_array_types() -> bool {
    var pool = type_pool_new();

    pool = type_pool_add(pool, type_i32());
    let i32_idx = type_pool_last_idx(pool);

    // Create [i32; 10]
    let arr_t = type_array(i32_idx, 10);

    if arr_t.kind != TYPE_ARRAY() {
        print("  Expected TYPE_ARRAY\n");
        return false
    }

    if arr_t.inner_idx != i32_idx {
        print("  Wrong element type index\n");
        return false
    }

    if arr_t.array_size != 10 {
        print("  Wrong array size\n");
        return false
    }
