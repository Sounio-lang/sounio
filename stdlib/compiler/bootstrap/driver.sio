    var total: i32 = 3

    if test_multimodule_basic() == 0 { passed = passed + 1 }
    if test_import_deduplication() == 0 { passed = passed + 1 }
    if test_import_cycle_detection() == 0 { passed = passed + 1 }

    if passed == total { 0 } else { 1 }
}

// ============================================================================
// SINGLE-FILE COMPILATION (existing bootstrap path)
// ============================================================================

fn compile_file(path: string, options: CompileOptions) -> CompileArtifact with IO, Mut, Div, Panic {
    // Note: keep this bootstrap path minimal. Directory/module resolution is
    // intentionally left to higher-level tooling for now.
    //
    // Moonshot step: if `path` is a directory, compile a flat concatenation of
    // all `.sio` files within it (non-recursive), sorted deterministically.

    var buf: [i8; 65536] = [0; 65536]
    var n: i64 = file_size(path)

    if n >= 0 {
        // Regular file.
        let bytes = read_file(path)
        if n > 65536 { n = 65536 }
        var i: i64 = 0
        while i < n {
            buf[i as usize] = bytes[i as usize]
            i = i + 1
        }
        return compile_source(buf, n, options)
    }

    // Directory mode.
    if !is_dir(path) {
        // Missing path or unsupported file kind.
        return compile_source(buf, 0, options)
    }

    // Fast path: if a cached SOBC exists in the directory, load it directly and
    // avoid reading/concatenating a directory tree through `read_file` lists.
    let cache_path = path_join(path, ".sounio_bytecode.sobc")
    var cache_size: i64 = file_size(cache_path)
    if cache_size > 0 {
        var out = compile_artifact_empty()
        out.ok = true
        out.exit_code = 0
        // Signal the host VM boundary to load cache directly, avoiding byte-by-byte
        // materialization in self-hosted bytecode.
        out.code_len = 0
        return out
    }

    let entries = list_dir(path)

    // Heuristic guard: listing a directory is cheap, but reading N files into
    // `[i8]` lists is extremely expensive for large trees (e.g. `self-hosted/`).
    // For those, return an empty artifact so the host can continue via the
    // stage-boundary loader.
    var sio_count: i64 = 0
    var total_bytes: i64 = 0
    var scan_idx: i64 = 0
    let total = len(entries)
    while scan_idx < total {
        let p = entries[scan_idx as usize]
        if ends_with(p, ".sio") {
            sio_count = sio_count + 1
            let sz = file_size(p)
            if sz > 0 {
                total_bytes = total_bytes + sz
            }
        }
        scan_idx = scan_idx + 1
    }

    if sio_count > 16 || total_bytes > 16384 {
        return compile_artifact_empty()
    }

    var pos: i64 = 0
    var idx: i64 = 0
    while idx < total {
        let p = entries[idx as usize]
        if ends_with(p, ".sio") {
            let bytes = read_file(p)
            let size = file_size(p)
            var m: i64 = size
            if m < 0 { m = 0 }
            var j: i64 = 0
            while j < m && pos < 65536 {
                buf[pos as usize] = bytes[j as usize]
                pos = pos + 1
                j = j + 1
            }
            // Ensure a newline boundary between files.
            if pos < 65536 {
                buf[pos as usize] = 10
                pos = pos + 1
            }
        }
        idx = idx + 1
    }

    compile_source(buf, pos, options)
}
