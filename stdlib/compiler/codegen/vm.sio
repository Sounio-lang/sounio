// compiler::codegen::vm — Stack-Based Virtual Machine
//
// Simple stack machine for executing bytecode generated by bytecode.sio.
// Provides a complete execution environment for the self-hosted compiler.

extern "C" {
    fn print(s: &str) -> ();
}

// ============================================================================
// BYTECODE OPCODES (same as bytecode.sio)
// ============================================================================

fn OP_NOP() -> i32 { 0 }
fn OP_PUSH_I64() -> i32 { 1 }
fn OP_PUSH_F64() -> i32 { 2 }
fn OP_PUSH_BOOL() -> i32 { 3 }
fn OP_PUSH_UNIT() -> i32 { 4 }
fn OP_POP() -> i32 { 5 }
fn OP_DUP() -> i32 { 6 }
fn OP_LOAD_LOCAL() -> i32 { 10 }
fn OP_STORE_LOCAL() -> i32 { 11 }
fn OP_ADD_I64() -> i32 { 20 }
fn OP_SUB_I64() -> i32 { 21 }
fn OP_MUL_I64() -> i32 { 22 }
fn OP_DIV_I64() -> i32 { 23 }
fn OP_REM_I64() -> i32 { 24 }
fn OP_NEG_I64() -> i32 { 25 }
fn OP_ADD_F64() -> i32 { 30 }
fn OP_SUB_F64() -> i32 { 31 }
fn OP_MUL_F64() -> i32 { 32 }
fn OP_DIV_F64() -> i32 { 33 }
fn OP_NEG_F64() -> i32 { 34 }
fn OP_EQ_I64() -> i32 { 40 }
fn OP_NE_I64() -> i32 { 41 }
fn OP_LT_I64() -> i32 { 42 }
fn OP_LE_I64() -> i32 { 43 }
fn OP_GT_I64() -> i32 { 44 }
fn OP_GE_I64() -> i32 { 45 }
fn OP_NOT() -> i32 { 50 }
fn OP_AND() -> i32 { 51 }
fn OP_OR() -> i32 { 52 }
fn OP_JUMP() -> i32 { 60 }
fn OP_JUMP_IF_FALSE() -> i32 { 61 }
fn OP_CALL() -> i32 { 62 }
fn OP_RET() -> i32 { 63 }
fn OP_HALT() -> i32 { 99 }

// ============================================================================
// VALUE REPRESENTATION
// ============================================================================

fn VAL_I64() -> i32 { 0 }
fn VAL_F64() -> i32 { 1 }
fn VAL_BOOL() -> i32 { 2 }
fn VAL_UNIT() -> i32 { 3 }

struct Value {
    kind: i32,
    i64_val: i64,
    f64_val: f64,
    bool_val: bool,
}

fn value_unit() -> Value {
    Value { kind: VAL_UNIT(), i64_val: 0, f64_val: 0.0, bool_val: false }
}

fn value_i64(v: i64) -> Value {
    Value { kind: VAL_I64(), i64_val: v, f64_val: 0.0, bool_val: false }
}

fn value_f64(v: f64) -> Value {
    Value { kind: VAL_F64(), i64_val: 0, f64_val: v, bool_val: false }
}

fn value_bool(v: bool) -> Value {
    Value { kind: VAL_BOOL(), i64_val: 0, f64_val: 0.0, bool_val: v }
}

fn value_as_i64(v: Value) -> i64 {
    v.i64_val
}

fn value_as_f64(v: Value) -> f64 {
    v.f64_val
}

fn value_as_bool(v: Value) -> bool {
    v.bool_val
}

// ============================================================================
// BYTECODE (same structure as bytecode.sio)
// ============================================================================

struct ByteCode {
    code: [i32; 1024],
    len: i64,
    const_i64: [i64; 128],
    n_const_i64: i64,
    const_f64: [f64; 128],
    n_const_f64: i64,
}

fn bytecode_new() -> ByteCode {
    ByteCode {
        code: [0; 1024],
        len: 0,
        const_i64: [0; 128],
        n_const_i64: 0,
        const_f64: [0.0; 128],
        n_const_f64: 0,
    }
}

fn emit_op(bc: ByteCode, op: i32) -> ByteCode with Mut, Panic {
    var b = bc;
    if b.len < 1024 {
        b.code[b.len as usize] = op;
        b.len = b.len + 1;
    }
    b
}

fn emit_op_i32(bc: ByteCode, op: i32, operand: i32) -> ByteCode with Mut, Panic {
    var b = bc;
    if b.len < 1023 {
        b.code[b.len as usize] = op;
        b.code[(b.len + 1) as usize] = operand;
        b.len = b.len + 2;
    }
    b
}

fn add_const_i64(bc: ByteCode, val: i64) -> ByteCode with Mut, Panic {
    var b = bc;
    if b.n_const_i64 < 128 {
        b.const_i64[b.n_const_i64 as usize] = val;
        b.n_const_i64 = b.n_const_i64 + 1;
    }
    b
}

fn add_const_f64(bc: ByteCode, val: f64) -> ByteCode with Mut, Panic {
    var b = bc;
    if b.n_const_f64 < 128 {
        b.const_f64[b.n_const_f64 as usize] = val;
        b.n_const_f64 = b.n_const_f64 + 1;
    }
    b
}

// ============================================================================
// VIRTUAL MACHINE
// ============================================================================

struct VM {
    // Value stack
    stack: [Value; 256],
    sp: i64,  // Stack pointer
    // Local variables
    locals: [Value; 64],
    n_locals: i64,
    // Program counter
    pc: i64,
    // Halted flag
    halted: bool,
    // Error flag
    error: bool,
}

fn vm_new() -> VM {
    VM {
        stack: [value_unit(); 256],
        sp: 0,
        locals: [value_unit(); 64],
        n_locals: 0,
        pc: 0,
        halted: false,
        error: false,
    }
}

// Push a value onto the stack
fn vm_push(vm: VM, v: Value) -> VM with Mut, Panic {
    var m = vm;
    if m.sp < 256 {
        m.stack[m.sp as usize] = v;
        m.sp = m.sp + 1;
    } else {
        m.error = true;
    }
    m
}

// Pop a value from the stack
fn vm_pop(vm: VM) -> VM with Mut {
    var m = vm;
    if m.sp > 0 {
        m.sp = m.sp - 1;
    } else {
        m.error = true;
    }
    m
}

// Get the top value without popping
fn vm_top(vm: VM) -> Value with Panic {
    if vm.sp > 0 {
        vm.stack[(vm.sp - 1) as usize]
    } else {
        value_unit()
    }
}

// Get value at offset from top (0 = top, 1 = one below top, etc.)
fn vm_peek(vm: VM, offset: i64) -> Value with Panic {
    let idx = vm.sp - 1 - offset;
    if idx >= 0 {
        vm.stack[idx as usize]
    } else {
        value_unit()
    }
}

// Execute one instruction
fn vm_step(vm: VM, bc: ByteCode) -> VM with Mut, Panic {
    var m = vm;

    if m.pc >= bc.len || m.halted || m.error {
        m.halted = true;
        return m
    }

    let op = bc.code[m.pc as usize];
    m.pc = m.pc + 1;

    // NOP
    if op == OP_NOP() {
        return m
    }

    // PUSH_I64 idx
    if op == OP_PUSH_I64() {
        let idx = bc.code[m.pc as usize];
        m.pc = m.pc + 1;
        let val = bc.const_i64[idx as usize];
        m = vm_push(m, value_i64(val));
        return m
    }

    // PUSH_F64 idx
    if op == OP_PUSH_F64() {
        let idx = bc.code[m.pc as usize];
        m.pc = m.pc + 1;
        let val = bc.const_f64[idx as usize];
        m = vm_push(m, value_f64(val));
        return m
    }

    // PUSH_BOOL val
    if op == OP_PUSH_BOOL() {
        let val = bc.code[m.pc as usize];
        m.pc = m.pc + 1;
        m = vm_push(m, value_bool(val != 0));
        return m
    }

    // PUSH_UNIT
    if op == OP_PUSH_UNIT() {
        m = vm_push(m, value_unit());
        return m
    }

    // POP
    if op == OP_POP() {
        m = vm_pop(m);
        return m
    }

    // DUP
    if op == OP_DUP() {
        let top = vm_top(m);
        m = vm_push(m, top);
        return m
    }

    // LOAD_LOCAL idx
    if op == OP_LOAD_LOCAL() {
        let idx = bc.code[m.pc as usize];
        m.pc = m.pc + 1;
        if idx >= 0 && (idx as i64) < m.n_locals {
            m = vm_push(m, m.locals[idx as usize]);
        } else {
            m.error = true;
        }
        return m
    }

    // STORE_LOCAL idx
    if op == OP_STORE_LOCAL() {
        let idx = bc.code[m.pc as usize];
        m.pc = m.pc + 1;
        let val = vm_top(m);
        m = vm_pop(m);
        if idx >= 0 && (idx as i64) < 64 {
            m.locals[idx as usize] = val;
            if (idx as i64) >= m.n_locals {
                m.n_locals = (idx as i64) + 1;
            }
        } else {
            m.error = true;
        }
        return m
    }

    // Binary i64 operations
    if op == OP_ADD_I64() || op == OP_SUB_I64() || op == OP_MUL_I64() ||
       op == OP_DIV_I64() || op == OP_REM_I64() {
        let b = value_as_i64(vm_peek(m, 0));
        m = vm_pop(m);
        let a = value_as_i64(vm_peek(m, 0));
        m = vm_pop(m);

        var result: i64 = 0;
        if op == OP_ADD_I64() { result = a + b; }
        if op == OP_SUB_I64() { result = a - b; }
        if op == OP_MUL_I64() { result = a * b; }
        if op == OP_DIV_I64() {
            if b != 0 { result = a / b; } else { m.error = true; }
        }
        if op == OP_REM_I64() {
            if b != 0 { result = a % b; } else { m.error = true; }
        }

        m = vm_push(m, value_i64(result));
        return m
    }

    // NEG_I64
    if op == OP_NEG_I64() {
        let a = value_as_i64(vm_top(m));
        m = vm_pop(m);
        m = vm_push(m, value_i64(-a));
        return m
    }

    // Binary f64 operations
    if op == OP_ADD_F64() || op == OP_SUB_F64() || op == OP_MUL_F64() ||
       op == OP_DIV_F64() {
        let b = value_as_f64(vm_peek(m, 0));
        m = vm_pop(m);
        let a = value_as_f64(vm_peek(m, 0));
        m = vm_pop(m);

        var result: f64 = 0.0;
        if op == OP_ADD_F64() { result = a + b; }
        if op == OP_SUB_F64() { result = a - b; }
        if op == OP_MUL_F64() { result = a * b; }
        if op == OP_DIV_F64() { result = a / b; }

        m = vm_push(m, value_f64(result));
        return m
    }

    // NEG_F64
    if op == OP_NEG_F64() {
        let a = value_as_f64(vm_top(m));
        m = vm_pop(m);
        m = vm_push(m, value_f64(-a));
        return m
    }

    // Comparison operations
    if op == OP_EQ_I64() || op == OP_NE_I64() || op == OP_LT_I64() ||
       op == OP_LE_I64() || op == OP_GT_I64() || op == OP_GE_I64() {
        let b = value_as_i64(vm_peek(m, 0));
        m = vm_pop(m);
        let a = value_as_i64(vm_peek(m, 0));
        m = vm_pop(m);

        var result = false;
        if op == OP_EQ_I64() { result = a == b; }
        if op == OP_NE_I64() { result = a != b; }
        if op == OP_LT_I64() { result = a < b; }
        if op == OP_LE_I64() { result = a <= b; }
        if op == OP_GT_I64() { result = a > b; }
        if op == OP_GE_I64() { result = a >= b; }

        m = vm_push(m, value_bool(result));
        return m
    }

    // Logical operations
    if op == OP_NOT() {
        let a = value_as_bool(vm_top(m));
        m = vm_pop(m);
        m = vm_push(m, value_bool(!a));
        return m
    }

    if op == OP_AND() {
        let b = value_as_bool(vm_peek(m, 0));
        m = vm_pop(m);
        let a = value_as_bool(vm_peek(m, 0));
        m = vm_pop(m);
        m = vm_push(m, value_bool(a && b));
        return m
    }

    if op == OP_OR() {
        let b = value_as_bool(vm_peek(m, 0));
        m = vm_pop(m);
        let a = value_as_bool(vm_peek(m, 0));
        m = vm_pop(m);
        m = vm_push(m, value_bool(a || b));
        return m
    }

    // JUMP offset
    if op == OP_JUMP() {
        let target = bc.code[m.pc as usize];
        m.pc = target as i64;
        return m
    }

    // JUMP_IF_FALSE offset
    if op == OP_JUMP_IF_FALSE() {
        let target = bc.code[m.pc as usize];
        m.pc = m.pc + 1;
        let cond = value_as_bool(vm_top(m));
        m = vm_pop(m);
        if !cond {
            m.pc = target as i64;
        }
        return m
    }

    // HALT
    if op == OP_HALT() {
        m.halted = true;
        return m
    }

    // Unknown opcode
    m.error = true;
    m
}

// Run until halted or error
fn vm_run(vm: VM, bc: ByteCode) -> VM with Mut, Panic, Div {
    var m = vm;
    while !m.halted && !m.error {
        m = vm_step(m, bc);
    }
    m
}

// Get the result (top of stack after execution)
fn vm_result(vm: VM) -> Value with Panic {
    vm_top(vm)
}

// ============================================================================
// TESTS
// ============================================================================

fn test_push_pop() -> bool with Mut, Panic, Div {
    var bc = bytecode_new();

    // Push 42
    bc = add_const_i64(bc, 42);
    bc = emit_op_i32(bc, OP_PUSH_I64(), 0);
    bc = emit_op(bc, OP_HALT());

    var vm = vm_new();
    vm = vm_run(vm, bc);

    let result = vm_result(vm);
    if result.kind != VAL_I64() {
        print("  Expected i64 value\n");
        return false
    }

    if result.i64_val != 42 {
        print("  Expected 42\n");
        return false
    }

    true
}

fn test_add() -> bool with Mut, Panic, Div {
    var bc = bytecode_new();

    // 10 + 20
    bc = add_const_i64(bc, 10);
    bc = add_const_i64(bc, 20);
    bc = emit_op_i32(bc, OP_PUSH_I64(), 0);
    bc = emit_op_i32(bc, OP_PUSH_I64(), 1);
    bc = emit_op(bc, OP_ADD_I64());
    bc = emit_op(bc, OP_HALT());

    var vm = vm_new();
    vm = vm_run(vm, bc);

    let result = vm_result(vm);
    if result.i64_val != 30 {
        print("  10 + 20 should be 30\n");
        return false
    }

    true
}

fn test_arithmetic() -> bool with Mut, Panic, Div {
    var bc = bytecode_new();

    // (2 + 3) * 4 = 20
    bc = add_const_i64(bc, 2);
    bc = add_const_i64(bc, 3);
    bc = add_const_i64(bc, 4);

    bc = emit_op_i32(bc, OP_PUSH_I64(), 0);  // 2
    bc = emit_op_i32(bc, OP_PUSH_I64(), 1);  // 3
    bc = emit_op(bc, OP_ADD_I64());          // 5
    bc = emit_op_i32(bc, OP_PUSH_I64(), 2);  // 4
    bc = emit_op(bc, OP_MUL_I64());          // 20
    bc = emit_op(bc, OP_HALT());

    var vm = vm_new();
    vm = vm_run(vm, bc);

    let result = vm_result(vm);
    if result.i64_val != 20 {
        print("  (2 + 3) * 4 should be 20\n");
        return false
    }

    true
}

fn test_comparison() -> bool with Mut, Panic, Div {
    var bc = bytecode_new();

    // 5 < 10 = true
    bc = add_const_i64(bc, 5);
    bc = add_const_i64(bc, 10);
    bc = emit_op_i32(bc, OP_PUSH_I64(), 0);
    bc = emit_op_i32(bc, OP_PUSH_I64(), 1);
    bc = emit_op(bc, OP_LT_I64());
    bc = emit_op(bc, OP_HALT());

    var vm = vm_new();
    vm = vm_run(vm, bc);

    let result = vm_result(vm);
    if result.kind != VAL_BOOL() {
        print("  Expected bool value\n");
        return false
    }

    if !result.bool_val {
        print("  5 < 10 should be true\n");
        return false
    }

    true
}

fn test_negation() -> bool with Mut, Panic, Div {
    var bc = bytecode_new();

    // -42
    bc = add_const_i64(bc, 42);
    bc = emit_op_i32(bc, OP_PUSH_I64(), 0);
    bc = emit_op(bc, OP_NEG_I64());
    bc = emit_op(bc, OP_HALT());

    var vm = vm_new();
    vm = vm_run(vm, bc);

    let result = vm_result(vm);
    if result.i64_val != -42 {
        print("  -42 should be -42\n");
        return false
    }

    true
}

fn test_logical() -> bool with Mut, Panic, Div {
    var bc = bytecode_new();

    // true && false = false
    bc = emit_op_i32(bc, OP_PUSH_BOOL(), 1);  // true
    bc = emit_op_i32(bc, OP_PUSH_BOOL(), 0);  // false
    bc = emit_op(bc, OP_AND());
    bc = emit_op(bc, OP_HALT());

    var vm = vm_new();
    vm = vm_run(vm, bc);

    let result = vm_result(vm);
    if result.bool_val {
        print("  true && false should be false\n");
        return false
    }

    true
}

fn test_locals() -> bool with Mut, Panic, Div {
    var bc = bytecode_new();

    // x = 42; x + 1
    bc = add_const_i64(bc, 42);
    bc = add_const_i64(bc, 1);

    // Store 42 in local 0
    bc = emit_op_i32(bc, OP_PUSH_I64(), 0);
    bc = emit_op_i32(bc, OP_STORE_LOCAL(), 0);

    // Load local 0, push 1, add
    bc = emit_op_i32(bc, OP_LOAD_LOCAL(), 0);
    bc = emit_op_i32(bc, OP_PUSH_I64(), 1);
    bc = emit_op(bc, OP_ADD_I64());
    bc = emit_op(bc, OP_HALT());

    var vm = vm_new();
    vm = vm_run(vm, bc);

    let result = vm_result(vm);
    if result.i64_val != 43 {
        print("  42 + 1 should be 43\n");
        return false
    }

    true
}

fn test_float() -> bool with Mut, Panic, Div {
    var bc = bytecode_new();

    // 3.14 * 2.0
    bc = add_const_f64(bc, 3.14);
    bc = add_const_f64(bc, 2.0);
    bc = emit_op_i32(bc, OP_PUSH_F64(), 0);
    bc = emit_op_i32(bc, OP_PUSH_F64(), 1);
    bc = emit_op(bc, OP_MUL_F64());
    bc = emit_op(bc, OP_HALT());

    var vm = vm_new();
    vm = vm_run(vm, bc);

    let result = vm_result(vm);
    if result.kind != VAL_F64() {
        print("  Expected f64 value\n");
        return false
    }

    // Check approximately equal (6.28)
    let diff = result.f64_val - 6.28;
    if diff < -0.001 || diff > 0.001 {
        print("  3.14 * 2.0 should be approximately 6.28\n");
        return false
    }

    true
}
