// compiler::codegen::bytecode — Bytecode Generation
//
// Simple stack-based bytecode generator for the self-hosted compiler.
// Generates bytecode from typed expressions that can be executed
// by the VM in vm.sio.

extern "C" {
    fn print(s: &str) -> ();
}

// ============================================================================
// BYTECODE OPCODES
// ============================================================================

// Stack operations
fn OP_NOP() -> i32 { 0 }
fn OP_PUSH_I64() -> i32 { 1 }      // Push 64-bit integer constant
fn OP_PUSH_F64() -> i32 { 2 }      // Push 64-bit float constant
fn OP_PUSH_BOOL() -> i32 { 3 }     // Push boolean constant
fn OP_PUSH_UNIT() -> i32 { 4 }     // Push unit value
fn OP_POP() -> i32 { 5 }           // Pop top of stack
fn OP_DUP() -> i32 { 6 }           // Duplicate top of stack

// Local variable operations
fn OP_LOAD_LOCAL() -> i32 { 10 }   // Push local variable onto stack
fn OP_STORE_LOCAL() -> i32 { 11 }  // Pop stack into local variable

// Arithmetic operations (i64)
fn OP_ADD_I64() -> i32 { 20 }
fn OP_SUB_I64() -> i32 { 21 }
fn OP_MUL_I64() -> i32 { 22 }
fn OP_DIV_I64() -> i32 { 23 }
fn OP_REM_I64() -> i32 { 24 }
fn OP_NEG_I64() -> i32 { 25 }

// Arithmetic operations (f64)
fn OP_ADD_F64() -> i32 { 30 }
fn OP_SUB_F64() -> i32 { 31 }
fn OP_MUL_F64() -> i32 { 32 }
fn OP_DIV_F64() -> i32 { 33 }
fn OP_NEG_F64() -> i32 { 34 }

// Comparison operations
fn OP_EQ_I64() -> i32 { 40 }
fn OP_NE_I64() -> i32 { 41 }
fn OP_LT_I64() -> i32 { 42 }
fn OP_LE_I64() -> i32 { 43 }
fn OP_GT_I64() -> i32 { 44 }
fn OP_GE_I64() -> i32 { 45 }

// Logical operations
fn OP_NOT() -> i32 { 50 }
fn OP_AND() -> i32 { 51 }
fn OP_OR() -> i32 { 52 }

// Control flow
fn OP_JUMP() -> i32 { 60 }         // Unconditional jump
fn OP_JUMP_IF_FALSE() -> i32 { 61 }// Conditional jump
fn OP_CALL() -> i32 { 62 }         // Call function
fn OP_RET() -> i32 { 63 }          // Return from function

// Misc
fn OP_HALT() -> i32 { 99 }         // Stop execution

// ============================================================================
// BYTECODE BUFFER
// ============================================================================

// Buffer for holding generated bytecode
struct ByteCode {
    code: [i32; 1024],
    len: i64,
    // Constant pool for i64 values
    const_i64: [i64; 128],
    n_const_i64: i64,
    // Constant pool for f64 values
    const_f64: [f64; 128],
    n_const_f64: i64,
}

fn bytecode_new() -> ByteCode {
    ByteCode {
        code: [0; 1024],
        len: 0,
        const_i64: [0; 128],
        n_const_i64: 0,
        const_f64: [0.0; 128],
        n_const_f64: 0,
    }
}

// Emit a single opcode
fn emit_op(bc: ByteCode, op: i32) -> ByteCode {
    var b = bc;
    if b.len < 1024 {
        b.code[b.len as usize] = op;
        b.len = b.len + 1;
    }
    b
}

// Emit an opcode with an i32 operand
fn emit_op_i32(bc: ByteCode, op: i32, operand: i32) -> ByteCode {
    var b = bc;
    if b.len < 1023 {
        b.code[b.len as usize] = op;
        b.code[(b.len + 1) as usize] = operand;
        b.len = b.len + 2;
    }
    b
}

// Add an i64 constant and return its index
fn add_const_i64(bc: ByteCode, val: i64) -> ByteCode {
    var b = bc;
    if b.n_const_i64 < 128 {
        b.const_i64[b.n_const_i64 as usize] = val;
        b.n_const_i64 = b.n_const_i64 + 1;
    }
    b
}

// Get the last constant index
fn last_const_i64_idx(bc: ByteCode) -> i32 {
    (bc.n_const_i64 - 1) as i32
}

// Add an f64 constant and return its index
fn add_const_f64(bc: ByteCode, val: f64) -> ByteCode {
    var b = bc;
    if b.n_const_f64 < 128 {
        b.const_f64[b.n_const_f64 as usize] = val;
        b.n_const_f64 = b.n_const_f64 + 1;
    }
    b
}

fn last_const_f64_idx(bc: ByteCode) -> i32 {
    (bc.n_const_f64 - 1) as i32
}

// Get current code position (for jumps)
fn current_pos(bc: ByteCode) -> i32 {
    bc.len as i32
}

// Patch a jump target
fn patch_jump(bc: ByteCode, pos: i32, target: i32) -> ByteCode {
    var b = bc;
    if pos >= 0 && (pos as i64) < b.len {
        b.code[pos as usize] = target;
    }
    b
}

// ============================================================================
// EXPRESSION KIND CONSTANTS
// ============================================================================

fn EXPR_LITERAL() -> i32 { 0 }
fn EXPR_BINARY() -> i32 { 2 }
fn EXPR_UNARY() -> i32 { 3 }
fn EXPR_PATH() -> i32 { 1 }

// Literal kinds
fn LIT_INT() -> i32 { 0 }
fn LIT_FLOAT() -> i32 { 1 }
fn LIT_BOOL() -> i32 { 4 }
fn LIT_UNIT() -> i32 { 5 }

// Binary operators
fn BINOP_ADD() -> i32 { 0 }
fn BINOP_SUB() -> i32 { 1 }
fn BINOP_MUL() -> i32 { 2 }
fn BINOP_DIV() -> i32 { 3 }
fn BINOP_REM() -> i32 { 4 }
fn BINOP_AND() -> i32 { 5 }
fn BINOP_OR() -> i32 { 6 }
fn BINOP_EQ() -> i32 { 12 }
fn BINOP_NE() -> i32 { 13 }
fn BINOP_LT() -> i32 { 14 }
fn BINOP_LE() -> i32 { 15 }
fn BINOP_GT() -> i32 { 16 }
fn BINOP_GE() -> i32 { 17 }

// Unary operators
fn UNOP_NEG() -> i32 { 0 }
fn UNOP_NOT() -> i32 { 1 }

// Type kinds
fn TYPE_I64() -> i32 { 7 }
fn TYPE_F64() -> i32 { 13 }
fn TYPE_BOOL() -> i32 { 3 }

// ============================================================================
// EXPRESSION REPRESENTATION (simplified)
// ============================================================================

struct Type {
    kind: i32,
}

struct Expr {
    kind: i32,
    lit_kind: i32,
    lit_int: i64,
    lit_float: f64,
    lit_bool: bool,
    binop: i32,
    left_idx: i64,
    right_idx: i64,
    unop: i32,
    operand_idx: i64,
    name: [i8; 32],
    name_len: i64,
    inferred_type: Type,
}

fn expr_new() -> Expr {
    Expr {
        kind: EXPR_LITERAL(),
        lit_kind: LIT_UNIT(),
        lit_int: 0,
        lit_float: 0.0,
        lit_bool: false,
        binop: 0,
        left_idx: -1,
        right_idx: -1,
        unop: 0,
        operand_idx: -1,
        name: [0; 32],
        name_len: 0,
        inferred_type: Type { kind: TYPE_I64() },
    }
}

fn expr_int(val: i64) -> Expr {
    var e = expr_new();
    e.kind = EXPR_LITERAL();
    e.lit_kind = LIT_INT();
    e.lit_int = val;
    e.inferred_type = Type { kind: TYPE_I64() };
    e
}

fn expr_float(val: f64) -> Expr {
    var e = expr_new();
    e.kind = EXPR_LITERAL();
    e.lit_kind = LIT_FLOAT();
    e.lit_float = val;
    e.inferred_type = Type { kind: TYPE_F64() };
    e
}

fn expr_bool(val: bool) -> Expr {
    var e = expr_new();
    e.kind = EXPR_LITERAL();
    e.lit_kind = LIT_BOOL();
    e.lit_bool = val;
    e.inferred_type = Type { kind: TYPE_BOOL() };
    e
}

fn expr_binary_i64(op: i32, left: i64, right: i64) -> Expr {
    var e = expr_new();
    e.kind = EXPR_BINARY();
    e.binop = op;
    e.left_idx = left;
    e.right_idx = right;
    e.inferred_type = Type { kind: TYPE_I64() };
    e
}

fn expr_unary(op: i32, operand: i64) -> Expr {
    var e = expr_new();
    e.kind = EXPR_UNARY();
    e.unop = op;
    e.operand_idx = operand;
    e.inferred_type = Type { kind: TYPE_I64() };
    e
}

// ============================================================================
// EXPRESSION POOL
// ============================================================================

struct ExprPool {
    exprs: [Expr; 128],
    count: i64,
}

fn expr_pool_new() -> ExprPool {
    ExprPool {
        exprs: [expr_new(); 128],
        count: 0,
    }
}

fn expr_pool_add(pool: ExprPool, e: Expr) -> ExprPool {
    var p = pool;
    if p.count < 128 {
        p.exprs[p.count as usize] = e;
        p.count = p.count + 1;
    }
    p
}

fn expr_pool_get(pool: ExprPool, idx: i64) -> Expr {
    if idx >= 0 && idx < pool.count {
        pool.exprs[idx as usize]
    } else {
        expr_new()
    }
}

fn expr_pool_last_idx(pool: ExprPool) -> i64 {
    pool.count - 1
}

// ============================================================================
// CODE GENERATION
// ============================================================================

// Generate bytecode for a literal expression
fn gen_literal(bc: ByteCode, e: Expr) -> ByteCode {
    var b = bc;

    if e.lit_kind == LIT_INT() {
        // Add constant to pool and emit push
        b = add_const_i64(b, e.lit_int);
        let idx = last_const_i64_idx(b);
        b = emit_op_i32(b, OP_PUSH_I64(), idx);
        return b
    }

    if e.lit_kind == LIT_FLOAT() {
        b = add_const_f64(b, e.lit_float);
        let idx = last_const_f64_idx(b);
        b = emit_op_i32(b, OP_PUSH_F64(), idx);
        return b
    }

    if e.lit_kind == LIT_BOOL() {
        if e.lit_bool {
            b = emit_op_i32(b, OP_PUSH_BOOL(), 1);
        } else {
            b = emit_op_i32(b, OP_PUSH_BOOL(), 0);
        }
        return b
    }

    if e.lit_kind == LIT_UNIT() {
        b = emit_op(b, OP_PUSH_UNIT());
        return b
    }

    b
}

// Generate bytecode for a binary expression
fn gen_binary(bc: ByteCode, pool: ExprPool, e: Expr) -> ByteCode {
    var b = bc;

    // Generate left operand
    let left_expr = expr_pool_get(pool, e.left_idx);
    b = gen_expr(b, pool, left_expr);

    // Generate right operand
    let right_expr = expr_pool_get(pool, e.right_idx);
    b = gen_expr(b, pool, right_expr);

    // Emit operator
    let ty = e.inferred_type.kind;
    let is_float = ty == TYPE_F64();

    if e.binop == BINOP_ADD() {
        if is_float {
            b = emit_op(b, OP_ADD_F64());
        } else {
            b = emit_op(b, OP_ADD_I64());
        }
    }

    if e.binop == BINOP_SUB() {
        if is_float {
            b = emit_op(b, OP_SUB_F64());
        } else {
            b = emit_op(b, OP_SUB_I64());
        }
    }

    if e.binop == BINOP_MUL() {
        if is_float {
            b = emit_op(b, OP_MUL_F64());
        } else {
            b = emit_op(b, OP_MUL_I64());
        }
    }

    if e.binop == BINOP_DIV() {
        if is_float {
            b = emit_op(b, OP_DIV_F64());
        } else {
            b = emit_op(b, OP_DIV_I64());
        }
    }

    if e.binop == BINOP_REM() {
        b = emit_op(b, OP_REM_I64());
    }

    // Comparisons
    if e.binop == BINOP_EQ() { b = emit_op(b, OP_EQ_I64()); }
    if e.binop == BINOP_NE() { b = emit_op(b, OP_NE_I64()); }
    if e.binop == BINOP_LT() { b = emit_op(b, OP_LT_I64()); }
    if e.binop == BINOP_LE() { b = emit_op(b, OP_LE_I64()); }
    if e.binop == BINOP_GT() { b = emit_op(b, OP_GT_I64()); }
    if e.binop == BINOP_GE() { b = emit_op(b, OP_GE_I64()); }

    // Logical
    if e.binop == BINOP_AND() { b = emit_op(b, OP_AND()); }
    if e.binop == BINOP_OR() { b = emit_op(b, OP_OR()); }

    b
}

// Generate bytecode for a unary expression
fn gen_unary(bc: ByteCode, pool: ExprPool, e: Expr) -> ByteCode {
    var b = bc;

    // Generate operand
    let operand_expr = expr_pool_get(pool, e.operand_idx);
    b = gen_expr(b, pool, operand_expr);

    // Emit operator
    let ty = e.inferred_type.kind;
    let is_float = ty == TYPE_F64();

    if e.unop == UNOP_NEG() {
        if is_float {
            b = emit_op(b, OP_NEG_F64());
        } else {
            b = emit_op(b, OP_NEG_I64());
        }
    }

    if e.unop == UNOP_NOT() {
        b = emit_op(b, OP_NOT());
    }

    b
}

// Generate bytecode for an expression
fn gen_expr(bc: ByteCode, pool: ExprPool, e: Expr) -> ByteCode {
    if e.kind == EXPR_LITERAL() {
        return gen_literal(bc, e)
    }

    if e.kind == EXPR_BINARY() {
        return gen_binary(bc, pool, e)
    }

    if e.kind == EXPR_UNARY() {
        return gen_unary(bc, pool, e)
    }

    bc
}

// ============================================================================
// DISASSEMBLER (for debugging)
// ============================================================================

fn print_opcode(op: i32) -> () {
    if op == OP_NOP() { print("NOP") }
    if op == OP_PUSH_I64() { print("PUSH_I64") }
    if op == OP_PUSH_F64() { print("PUSH_F64") }
    if op == OP_PUSH_BOOL() { print("PUSH_BOOL") }
    if op == OP_PUSH_UNIT() { print("PUSH_UNIT") }
    if op == OP_POP() { print("POP") }
    if op == OP_ADD_I64() { print("ADD_I64") }
    if op == OP_SUB_I64() { print("SUB_I64") }
    if op == OP_MUL_I64() { print("MUL_I64") }
    if op == OP_DIV_I64() { print("DIV_I64") }
    if op == OP_REM_I64() { print("REM_I64") }
    if op == OP_NEG_I64() { print("NEG_I64") }
    if op == OP_ADD_F64() { print("ADD_F64") }
    if op == OP_SUB_F64() { print("SUB_F64") }
    if op == OP_MUL_F64() { print("MUL_F64") }
    if op == OP_DIV_F64() { print("DIV_F64") }
    if op == OP_NEG_F64() { print("NEG_F64") }
    if op == OP_EQ_I64() { print("EQ_I64") }
    if op == OP_NE_I64() { print("NE_I64") }
    if op == OP_LT_I64() { print("LT_I64") }
    if op == OP_LE_I64() { print("LE_I64") }
    if op == OP_GT_I64() { print("GT_I64") }
    if op == OP_GE_I64() { print("GE_I64") }
    if op == OP_NOT() { print("NOT") }
    if op == OP_AND() { print("AND") }
    if op == OP_OR() { print("OR") }
    if op == OP_HALT() { print("HALT") }
}

// ============================================================================
// TESTS
// ============================================================================

fn test_gen_int_literal() -> bool {
    var pool = expr_pool_new();
    var bc = bytecode_new();

    let e = expr_int(42);
    pool = expr_pool_add(pool, e);

    bc = gen_expr(bc, pool, e);

    if bc.len != 2 {
        print("  Expected 2 bytecode instructions\n");
        return false
    }

    if bc.code[0] != OP_PUSH_I64() {
        print("  Expected PUSH_I64 opcode\n");
        return false
    }

    if bc.n_const_i64 != 1 {
        print("  Expected 1 constant\n");
        return false
    }

    if bc.const_i64[0] != 42 {
        print("  Constant should be 42\n");
        return false
    }

    true
}

fn test_gen_binary_add() -> bool {
    var pool = expr_pool_new();
    var bc = bytecode_new();

    // 10 + 20
    pool = expr_pool_add(pool, expr_int(10));
    let left_idx = expr_pool_last_idx(pool);

    pool = expr_pool_add(pool, expr_int(20));
    let right_idx = expr_pool_last_idx(pool);

    let add = expr_binary_i64(BINOP_ADD(), left_idx, right_idx);
    pool = expr_pool_add(pool, add);

    bc = gen_expr(bc, pool, add);

    // Should have: PUSH_I64 0, PUSH_I64 1, ADD_I64
    if bc.len != 5 {
        print("  Expected 5 bytecode instructions\n");
        return false
    }

    if bc.code[0] != OP_PUSH_I64() {
        print("  First should be PUSH_I64\n");
        return false
    }

    if bc.code[2] != OP_PUSH_I64() {
        print("  Third should be PUSH_I64\n");
        return false
    }

    if bc.code[4] != OP_ADD_I64() {
        print("  Last should be ADD_I64\n");
        return false
    }

    true
}

fn test_gen_unary_neg() -> bool {
    var pool = expr_pool_new();
    var bc = bytecode_new();

    // -42
    pool = expr_pool_add(pool, expr_int(42));
    let operand_idx = expr_pool_last_idx(pool);

    let neg = expr_unary(UNOP_NEG(), operand_idx);
    pool = expr_pool_add(pool, neg);

    bc = gen_expr(bc, pool, neg);

    // Should have: PUSH_I64 0, NEG_I64
    if bc.len != 3 {
        print("  Expected 3 bytecode instructions\n");
        return false
    }

    if bc.code[0] != OP_PUSH_I64() {
        print("  First should be PUSH_I64\n");
        return false
    }

    if bc.code[2] != OP_NEG_I64() {
        print("  Last should be NEG_I64\n");
        return false
    }

    true
}

fn test_gen_comparison() -> bool {
    var pool = expr_pool_new();
    var bc = bytecode_new();

    // 5 < 10
    pool = expr_pool_add(pool, expr_int(5));
    let left_idx = expr_pool_last_idx(pool);

    pool = expr_pool_add(pool, expr_int(10));
    let right_idx = expr_pool_last_idx(pool);

    var lt = expr_new();
    lt.kind = EXPR_BINARY();
    lt.binop = BINOP_LT();
    lt.left_idx = left_idx;
    lt.right_idx = right_idx;
    lt.inferred_type = Type { kind: TYPE_BOOL() };
    pool = expr_pool_add(pool, lt);

    bc = gen_expr(bc, pool, lt);

    // Should have: PUSH_I64 0, PUSH_I64 1, LT_I64
    if bc.len != 5 {
        print("  Expected 5 bytecode instructions\n");
        return false
    }

    if bc.code[4] != OP_LT_I64() {
        print("  Last should be LT_I64\n");
        return false
    }

    true
}

fn test_gen_complex_expr() -> bool {
    var pool = expr_pool_new();
    var bc = bytecode_new();

    // (1 + 2) * 3
    pool = expr_pool_add(pool, expr_int(1));
    let one_idx = expr_pool_last_idx(pool);

    pool = expr_pool_add(pool, expr_int(2));
    let two_idx = expr_pool_last_idx(pool);

    let add = expr_binary_i64(BINOP_ADD(), one_idx, two_idx);
    pool = expr_pool_add(pool, add);
    let add_idx = expr_pool_last_idx(pool);

    pool = expr_pool_add(pool, expr_int(3));
    let three_idx = expr_pool_last_idx(pool);

    let mul = expr_binary_i64(BINOP_MUL(), add_idx, three_idx);
    pool = expr_pool_add(pool, mul);

    bc = gen_expr(bc, pool, mul);

    // Should have: PUSH 1, PUSH 2, ADD, PUSH 3, MUL
    // = 8 instructions (3 pushes with operands = 6, plus ADD and MUL = 2)
    if bc.len != 8 {
        print("  Expected 8 bytecode instructions\n");
        return false
    }

    if bc.code[4] != OP_ADD_I64() {
        print("  Position 4 should be ADD_I64\n");
        return false
    }

    if bc.code[7] != OP_MUL_I64() {
        print("  Position 7 should be MUL_I64\n");
        return false
    }
