// nn — Neural network layers, autograd, and epistemic training
//
// Dense layers (scalar, 2-input, 4x4 matrix), reverse-mode autodiff (Wengert tape),
// epistemic layers with GUM uncertainty propagation, quaternion/octonion layers,
// G2-equivariant networks, and MLP classifiers.
//
// Submodules:
//   autograd_v2        — Reverse-mode AD tape (512 nodes, 16 op types)
//   dense_layer        — 4x4 dense layer (Vec4, Mat4x4, DenseLayer4, MLP_4_4_4)
//   dense              — Scalar dense layer with autograd
//   dense2             — 2-input dense layer (Dense2Layer)
//   epistemic_layer    — Epistemic 4x4 dense layer (EpistemicVec4, EpistemicMat4x4)
//   epistemic_backward — Backward pass with GUM uncertainty propagation
//   differentiable     — Effect-driven forward/backward module interfaces
//   activation         — ReLU, sigmoid, tanh + derivatives
//   tensor             — Fixed-size Tensor8/Tensor16/Tensor32 vector types
//   quaternion         — Epistemic quaternion arithmetic + neural layers
//   dense_quaternion   — Dense quaternion neural network layers
//   optimizers_quaternion — Adam optimizer for quaternion parameters
//   octonion           — Octonion neural network layers
//   g2_equivariant     — G2-equivariant octonion layers (symmetry-preserving)
//   g2_hyperspectral_conv — G2-equivariant 7-band hyperspectral convolution
//   mlp_xor            — 2-2-1 MLP for XOR with Adam optimizer
//   mlp_classifier     — 2-class softmax + cross-entropy MLP classifier
//   beam_search        — Epistemic beam search with confidence-weighted selection

pub use autograd_v2::{
    Tape,
    tape_new, tape_var, tape_const,
    tape_add, tape_sub, tape_mul, tape_div, tape_neg,
    tape_exp, tape_log, tape_sin, tape_cos,
    tape_relu, tape_sigmoid, tape_tanh,
    tape_mul_const, tape_pow_const, tape_add_const,
    tape_backward, tape_value, tape_grad,
    AD2_VAR, AD2_ADD, AD2_MUL, AD2_SUB, AD2_DIV,
    AD2_NEG, AD2_EXP, AD2_LOG, AD2_SIN, AD2_COS,
    AD2_RELU, AD2_SIGMOID, AD2_TANH, AD2_POW,
    AD2_MUL_CONST, AD2_ADD_CONST,
}

pub use dense_layer::{
    Vec4, Mat4x4, DenseLayer4, MLP_4_4_4,
    vec4_new, vec4_zero, vec4_ones, vec4_add, vec4_scale, vec4_dot,
    vec4_apply_activation,
    mat4x4_identity, mat4x4_zeros, mat4x4_mul_vec,
    dense_layer4_new, dense_layer4_identity, dense_layer4_forward,
    mlp_4_4_4_new, mlp_4_4_4_forward,
}

pub use dense::{
    DenseLayer,
    dense_new, dense_forward, dense_output,
    dense_grad_w, dense_grad_b, dense_grad_x, dense_update,
}

pub use dense2::{
    Dense2Layer,
    dense2_new, dense2_forward, dense2_output,
    dense2_grad_w1, dense2_grad_w2, dense2_grad_b,
    dense2_update,
}

pub use epistemic_layer::{
    EpistemicVec4, EpistemicMat4x4, EpistemicDenseLayer4, EpistemicMLP_4_4_4,
    evec4_zeros, evec4_from_values, evec4_from_epistemic,
    emat4_zeros, emat4_identity, emat4_get_val, emat4_get_unc, emat4_get_conf, emat4_set,
    ACT_RELU, ACT_SIGMOID, ACT_TANH, ACT_IDENTITY,
    epistemic_dense_4x4, epistemic_dense_identity, epistemic_dense_forward,
    epistemic_mlp_4_4_4, epistemic_mlp_forward,
    LayerConfidenceSummary, epivec4_confidence_summary,
}

pub use epistemic_backward::{
    EpistemicLayerGrad,
    epistemic_dense_backward, epistemic_dense_update,
    mse_loss, mse_gradient,
}

pub use mlp_xor::{
    MLP, Grads,
    mlp_new, mlp_random,
    mlp_forward_simple, mlp_forward_with_cache,
    mlp_backward, mlp_update,
    grads_add, grads_scale, grads_zero,
}
