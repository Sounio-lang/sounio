//! stdlib/nn/dense_quaternion.sio
//!
//! Dense Quaternion Neural Network Layers
//!
//! Implements dense (fully connected) layers that operate on quaternion-valued
//! inputs and outputs, suitable for spatial-temporal modeling in PBPK,
//! EEG/ECG analysis, and genomic data processing.

use nn::quaternion::{Quaternion, quaternion_exact, quaternion_mul, quaternion_add, quaternion_relu, quaternion_sigmoid, quaternion_tanh, quaternion_get_w, quaternion_get_x, quaternion_get_y, quaternion_get_z}

// ============================================================================
// DENSE QUATERNION LAYER
// ============================================================================

// Dense layer for quaternion-valued inputs/outputs
// 
// Architecture: 4N_in → 4N_out (each quaternion has 4 components)
// Forward: y = activation(W * x + b) where W, x, b are quaternion-valued
pub struct DenseQuaternion {
    /// Weight matrix: each element is a quaternion
    weights: Vec<Quaternion>,
    
    /// Bias vector: each element is a quaternion  
    biases: Vec<Quaternion>,
    
    /// Input size (number of quaternions)
    input_size: i64,
    
    /// Output size (number of quaternions)
    output_size: i64,
    
    /// Activation function
    activation: ActivationFunction,
}

// Activation functions for quaternion layers
enum ActivationFunction {
    None,
    ReLU,
    Sigmoid,
    Tanh,
    Identity,
}

// ============================================================================
// CONSTRUCTORS
// ============================================================================

// Create a new dense quaternion layer
// input_size: number of input quaternions
// output_size: number of output quaternions  
// activation: activation function to use
fn dense_quaternion_new(input_size: i64, output_size: i64, activation: ActivationFunction) -> DenseQuaternion {
    let total_weights = input_size * output_size
    
    // Initialize weights and biases as small random quaternions
    let weights = vec![quaternion_exact(0.1, 0.0, 0.0, 0.0); total_weights as usize]
    let biases = vec![quaternion_exact(0.0, 0.0, 0.0, 0.0); output_size as usize]
    
    DenseQuaternion {
        weights: weights,
        biases: biases,
        input_size: input_size,
        output_size: output_size,
        activation: activation,
    }
}

// Create a layer with specific weight and bias initialization
fn dense_quaternion_from_params(
    input_size: i64, 
    output_size: i64, 
    activation: ActivationFunction,
    init_scale: f64
) -> DenseQuaternion {
    let total_weights = input_size * output_size
    
    // Xavier/Glorot initialization for quaternion weights
    let std_dev = sqrt_f64(2.0 / (input_size + output_size) as f64) * init_scale
    
    let weights = vec![quaternion_exact(std_dev, 0.0, 0.0, 0.0); total_weights as usize]
    let biases = vec![quaternion_exact(0.0, 0.0, 0.0, 0.0); output_size as usize]
    
    DenseQuaternion {
        weights: weights,
        biases: biases,
        input_size: input_size,
        output_size: output_size,
        activation: activation,
    }
}

// ============================================================================
// FORWARD PASS
// ============================================================================

// Forward pass through dense quaternion layer
// 
// # Arguments
// * layer - the dense layer
// * inputs - vector of input quaternions (length = input_size)
// 
// # Returns
// Vector of output quaternions (length = output_size)
fn dense_quaternion_forward(layer: DenseQuaternion, inputs: Vec<Quaternion>) -> Vec<Quaternion> {
    var outputs = vec![quaternion_exact(0.0, 0.0, 0.0, 0.0); layer.output_size as usize]
    
    // For each output quaternion
    var out_idx = 0
    while out_idx < layer.output_size {
        var sum = layer.biases[out_idx as usize]
        
        // Sum over all input quaternions
        var in_idx = 0
        while in_idx < layer.input_size {
            let weight_idx = in_idx * layer.output_size + out_idx
            let weight = layer.weights[weight_idx as usize]
            let input_quat = inputs[in_idx as usize]
            
            // Quaternion multiplication for weighted sum
            let weighted_input = quaternion_mul(weight, input_quat)
            sum = quaternion_add(sum, weighted_input)
            
            in_idx = in_idx + 1
        }
        
        // Apply activation
        outputs[out_idx as usize] = apply_activation(layer.activation, sum)
        out_idx = out_idx + 1
    }
    
    outputs
}

// Apply activation function to quaternion
fn apply_activation(activation: ActivationFunction, input: Quaternion) -> Quaternion {
    match activation {
        ActivationFunction::None => input,
        ActivationFunction::ReLU => quaternion_relu(input),
        ActivationFunction::Sigmoid => quaternion_sigmoid(input),
        ActivationFunction::Tanh => quaternion_tanh(input),
        ActivationFunction::Identity => input,
    }
}

// ============================================================================
// PARAMETER ACCESS
// ============================================================================

// Get weight matrix as flattened vector
fn dense_quaternion_get_weights(layer: DenseQuaternion) -> Vec<Quaternion> {
    layer.weights
}

// Get bias vector
fn dense_quaternion_get_biases(layer: DenseQuaternion) -> Vec<Quaternion> {
    layer.biases
}

// Set specific weight
fn dense_quaternion_set_weight(layer: DenseQuaternion, input_idx: i64, output_idx: i64, weight: Quaternion) -> DenseQuaternion {
    let weight_idx = input_idx * layer.output_size + output_idx
    
    var new_weights = layer.weights
    new_weights[weight_idx as usize] = weight
    
    DenseQuaternion {
        weights: new_weights,
        biases: layer.biases,
        input_size: layer.input_size,
        output_size: layer.output_size,
        activation: layer.activation,
    }
}

// Set specific bias
fn dense_quaternion_set_bias(layer: DenseQuaternion, output_idx: i64, bias: Quaternion) -> DenseQuaternion {
    var new_biases = layer.biases
    new_biases[output_idx as usize] = bias
    
    DenseQuaternion {
        weights: layer.weights,
        biases: new_biases,
        input_size: layer.input_size,
        output_size: layer.output_size,
        activation: layer.activation,
    }
}

// ============================================================================
// LAYER MANIPULATION
// ============================================================================

// Get layer info
fn dense_quaternion_info(layer: DenseQuaternion) -> LayerInfo {
    LayerInfo {
        input_size: layer.input_size,
        output_size: layer.output_size,
        total_params: (layer.input_size * layer.output_size + layer.output_size) as i64,
        activation: layer.activation,
    }
}

// Information about a dense quaternion layer
struct LayerInfo {
    input_size: i64,
    output_size: i64,
    total_params: i64,
    activation: ActivationFunction,
}

// ============================================================================
// MULTILAYER PERCEPTRON (MLP) WITH QUATERNIONS
// ============================================================================

// MLP composed of multiple dense quaternion layers
struct QuaternionMLP {
    layers: Vec<DenseQuaternion>,
    layer_count: i64,
}

// Create MLP with specified architecture
// architecture: vector of layer sizes [input_size, hidden1, hidden2, ..., output_size]
fn quaternion_mlp_new(architecture: Vec<i64>) -> QuaternionMLP {
    var layers = vec![]
    
    var i = 0
    while i < architecture.len() - 1 {
        let input_size = architecture[i as usize]
        let output_size = architecture[(i + 1) as usize]
        
        // Use ReLU for hidden layers, Identity for output
        let activation = if i < architecture.len() - 2 {
            ActivationFunction::ReLU
        } else {
            ActivationFunction::Identity
        }
        
        let layer = dense_quaternion_from_params(input_size, output_size, activation, 0.1)
        layers.push(layer)
        
        i = i + 1
    }
    
    QuaternionMLP {
        layers: layers,
        layer_count: (layers.len() as i64),
    }
}

// Forward pass through MLP
fn quaternion_mlp_forward(mlp: QuaternionMLP, inputs: Vec<Quaternion>) -> Vec<Quaternion> {
    var current_inputs = inputs
    
    var i = 0
    while i < mlp.layer_count {
        let layer = mlp.layers[i as usize]
        current_inputs = dense_quaternion_forward(layer, current_inputs)
        i = i + 1
    }
    
    current_inputs
}

// Predict single output (convenience function)
fn quaternion_mlp_predict(mlp: QuaternionMLP, input: Vec<Quaternion>) -> Vec<Quaternion> {
    quaternion_mlp_forward(mlp, input)
}

// ============================================================================
// LOSS FUNCTIONS FOR QUATERNION OUTPUTS
// ============================================================================

// Mean Squared Error loss for quaternion outputs
// Computes MSE for each component and averages
fn quaternion_mse_loss(predicted: Vec<Quaternion>, target: Vec<Quaternion>) -> f64 {
    var total_loss = 0.0
    var count = 0
    
    var i = 0
    while i < predicted.len() {
        if i < target.len() {
            let pred = predicted[i]
            let targ = target[i]
            
            // MSE for each quaternion component
            let w_loss = (quaternion_get_w(pred) - quaternion_get_w(targ)).powi(2)
            let x_loss = (quaternion_get_x(pred) - quaternion_get_x(targ)).powi(2)
            let y_loss = (quaternion_get_y(pred) - quaternion_get_y(targ)).powi(2)
            let z_loss = (quaternion_get_z(pred) - quaternion_get_z(targ)).powi(2)
            
            total_loss = total_loss + w_loss + x_loss + y_loss + z_loss
            count = count + 4 // 4 components per quaternion
        }
        i = i + 1
    }
    
    if count > 0 {
        total_loss / count as f64
    } else {
        0.0
    }
}

// Mean Absolute Error loss for quaternion outputs
fn quaternion_mae_loss(predicted: Vec<Quaternion>, target: Vec<Quaternion>) -> f64 {
    var total_loss = 0.0
    var count = 0
    
    var i = 0
    while i < predicted.len() {
        if i < target.len() {
            let pred = predicted[i]
            let targ = target[i]
            
            // MAE for each quaternion component
            let w_loss = abs_f64(quaternion_get_w(pred) - quaternion_get_w(targ))
            let x_loss = abs_f64(quaternion_get_x(pred) - quaternion_get_x(targ))
            let y_loss = abs_f64(quaternion_get_y(pred) - quaternion_get_y(targ))
            let z_loss = abs_f64(quaternion_get_z(pred) - quaternion_get_z(targ))
            
            total_loss = total_loss + w_loss + x_loss + y_loss + z_loss
            count = count + 4 // 4 components per quaternion
        }
        i = i + 1
    }
    
    if count > 0 {
        total_loss / count as f64
    } else {
        0.0
    }
}

// Cross-entropy loss for classification tasks (using first component)
fn quaternion_cross_entropy_loss(predicted: Vec<Quaternion>, target_classes: Vec<i64>) -> f64 {
    var total_loss = 0.0
    var count = 0
    
    var i = 0
    while i < predicted.len() {
        if i < target_classes.len() {
            // Use real part (w) for classification probability
            let prob = sigmoid_f64(quaternion_get_w(predicted[i]))
            let target = target_classes[i] as f64
            
            // Binary cross-entropy: -[y*log(p) + (1-y)*log(1-p)]
            let epsilon = 1e-15
            let p_clipped = max_f64(min_f64(prob, 1.0 - epsilon), epsilon)
            
            let loss = -(target * ln_f64(p_clipped) + (1.0 - target) * ln_f64(1.0 - p_clipped))
            total_loss = total_loss + loss
            count = count + 1
        }
        i = i + 1
    }
    
    if count > 0 {
        total_loss / count as f64
    } else {
        0.0
    }
}

// ============================================================================
// UTILITY FUNCTIONS
// ============================================================================

fn sqrt_f64(x: f64) -> f64 {
    if x <= 0.0 { return 0.0 }
    var guess = x / 2.0
    if guess < 1.0 { guess = 1.0 }
    var i = 0
    while i < 20 {
        guess = (guess + x / guess) / 2.0
        i = i + 1
    }
    guess
}

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn min_f64(a: f64, b: f64) -> f64 {
    if a < b { a } else { b }
}

fn max_f64(a: f64, b: f64) -> f64 {
    if a > b { a } else { b }
}

fn sigmoid_f64(x: f64) -> f64 {
    1.0 / (1.0 + exp_f64(0.0 - x))
}

fn ln_f64(x: f64) -> f64 {
    if x <= 0.0 { return 0.0 - 999999.0 }
    if x == 1.0 { return 0.0 }
    
    let y = (x - 1.0) / (x + 1.0)
    var result = 0.0
    var term = y
    var i = 1
    while i < 30 {
        result = result + term / (i as f64)
        term = term * y * y
        i = i + 2
    }
    2.0 * result
}

fn exp_f64(x: f64) -> f64 {
    if x > 20.0 { return exp_f64(x / 2.0) * exp_f64(x / 2.0) }
    if x < 0.0 - 20.0 { return 1.0 / exp_f64(0.0 - x) }
    var sum = 1.0
    var term = 1.0
    var i = 1
    while i <= 20 { term = term * x / i; sum = sum + term; i = i + 1 }
    sum
}

