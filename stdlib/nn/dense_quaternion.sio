//! stdlib/nn/dense_quaternion.sio
//!
//! Minimal active dense quaternion layer surface.

use nn::quaternion::*

enum ActivationFunction {
    None,
    ReLU,
    Sigmoid,
    Tanh,
}

struct DenseQuaternion {
    weight: Quaternion,
    bias: Quaternion,
    input_size: i64,
    output_size: i64,
    activation: ActivationFunction,
}

struct LayerInfo {
    input_size: i64,
    output_size: i64,
    total_params: i64,
}

fn dense_quaternion_new(input_size: i64, output_size: i64, activation: ActivationFunction) -> DenseQuaternion {
    DenseQuaternion {
        weight: quaternion_identity(),
        bias: quaternion_zero(),
        input_size: input_size,
        output_size: output_size,
        activation: activation,
    }
}

fn dense_quaternion_from_params(
    input_size: i64,
    output_size: i64,
    activation: ActivationFunction,
    init_scale: f64
) -> DenseQuaternion {
    DenseQuaternion {
        weight: quaternion_exact(init_scale, 0.0, 0.0, 0.0),
        bias: quaternion_zero(),
        input_size: input_size,
        output_size: output_size,
        activation: activation,
    }
}

fn dense_quaternion_set_weight(layer: DenseQuaternion, weight: Quaternion) -> DenseQuaternion {
    DenseQuaternion {
        weight: weight,
        bias: layer.bias,
        input_size: layer.input_size,
        output_size: layer.output_size,
        activation: layer.activation,
    }
}

fn dense_quaternion_set_bias(layer: DenseQuaternion, bias: Quaternion) -> DenseQuaternion {
    DenseQuaternion {
        weight: layer.weight,
        bias: bias,
        input_size: layer.input_size,
        output_size: layer.output_size,
        activation: layer.activation,
    }
}

fn apply_activation(activation: ActivationFunction, value: Quaternion) -> Quaternion {
    match activation {
        ActivationFunction::None => value,
        ActivationFunction::ReLU => quaternion_relu(value),
        ActivationFunction::Sigmoid => quaternion_sigmoid(value),
        ActivationFunction::Tanh => quaternion_tanh(value),
    }
}

fn dense_quaternion_forward(layer: DenseQuaternion, input: Quaternion) -> Quaternion {
    let weighted = quaternion_mul(layer.weight, input)
    let shifted = quaternion_add(weighted, layer.bias)
    apply_activation(layer.activation, shifted)
}

fn dense_quaternion_get_weight(layer: DenseQuaternion) -> Quaternion {
    layer.weight
}

fn dense_quaternion_get_bias(layer: DenseQuaternion) -> Quaternion {
    layer.bias
}

fn dense_quaternion_param_count(layer: DenseQuaternion) -> i64 {
    // One quaternion weight + one quaternion bias for active single-channel lane.
    let _shape_hint = layer.input_size + layer.output_size
    8
}

fn dense_quaternion_info(layer: DenseQuaternion) -> LayerInfo {
    LayerInfo {
        input_size: layer.input_size,
        output_size: layer.output_size,
        total_params: dense_quaternion_param_count(layer),
    }
}
