//! stdlib/nn/optimizers_quaternion.sio
//!
//! Active quaternion optimizer surface (single-parameter Adam step).

use nn::quaternion::*

struct AdamQuaternion {
    learning_rate: f64,
    beta1: f64,
    beta2: f64,
    epsilon: f64,
    timestep: i64,
    m_w: f64,
    m_x: f64,
    m_y: f64,
    m_z: f64,
    v_w: f64,
    v_x: f64,
    v_y: f64,
    v_z: f64,
}

fn adam_quaternion_new(learning_rate: f64, beta1: f64, beta2: f64, epsilon: f64) -> AdamQuaternion {
    AdamQuaternion {
        learning_rate: learning_rate,
        beta1: beta1,
        beta2: beta2,
        epsilon: epsilon,
        timestep: 0,
        m_w: 0.0,
        m_x: 0.0,
        m_y: 0.0,
        m_z: 0.0,
        v_w: 0.0,
        v_x: 0.0,
        v_y: 0.0,
        v_z: 0.0,
    }
}

fn adam_quaternion_default() -> AdamQuaternion {
    adam_quaternion_new(0.001, 0.9, 0.999, 1e-8)
}

fn adam_quaternion_beta1(opt: AdamQuaternion) -> f64 {
    opt.beta1
}

fn pow_i64(base: f64, n: i64) -> f64 {
    var out = 1.0
    var i: i64 = 0
    while i < n {
        out = out * base
        i = i + 1
    }
    out
}

fn adam_quaternion_step(opt: AdamQuaternion, param: Quaternion, grad: Quaternion) -> (AdamQuaternion, Quaternion) {
    let t = opt.timestep + 1

    let m_w = opt.beta1 * opt.m_w + (1.0 - opt.beta1) * quaternion_get_w(grad)
    let m_x = opt.beta1 * opt.m_x + (1.0 - opt.beta1) * quaternion_get_x(grad)
    let m_y = opt.beta1 * opt.m_y + (1.0 - opt.beta1) * quaternion_get_y(grad)
    let m_z = opt.beta1 * opt.m_z + (1.0 - opt.beta1) * quaternion_get_z(grad)

    let g_w = quaternion_get_w(grad)
    let g_x = quaternion_get_x(grad)
    let g_y = quaternion_get_y(grad)
    let g_z = quaternion_get_z(grad)

    let v_w = opt.beta2 * opt.v_w + (1.0 - opt.beta2) * g_w * g_w
    let v_x = opt.beta2 * opt.v_x + (1.0 - opt.beta2) * g_x * g_x
    let v_y = opt.beta2 * opt.v_y + (1.0 - opt.beta2) * g_y * g_y
    let v_z = opt.beta2 * opt.v_z + (1.0 - opt.beta2) * g_z * g_z

    let beta1_t = pow_i64(opt.beta1, t)
    let beta2_t = pow_i64(opt.beta2, t)

    let m_hat_w = m_w / (1.0 - beta1_t)
    let m_hat_x = m_x / (1.0 - beta1_t)
    let m_hat_y = m_y / (1.0 - beta1_t)
    let m_hat_z = m_z / (1.0 - beta1_t)

    let v_hat_w = v_w / (1.0 - beta2_t)
    let v_hat_x = v_x / (1.0 - beta2_t)
    let v_hat_y = v_y / (1.0 - beta2_t)
    let v_hat_z = v_z / (1.0 - beta2_t)

    let upd_w = opt.learning_rate * m_hat_w / (v_hat_w.sqrt() + opt.epsilon)
    let upd_x = opt.learning_rate * m_hat_x / (v_hat_x.sqrt() + opt.epsilon)
    let upd_y = opt.learning_rate * m_hat_y / (v_hat_y.sqrt() + opt.epsilon)
    let upd_z = opt.learning_rate * m_hat_z / (v_hat_z.sqrt() + opt.epsilon)

    let next_param = quaternion_exact(
        quaternion_get_w(param) - upd_w,
        quaternion_get_x(param) - upd_x,
        quaternion_get_y(param) - upd_y,
        quaternion_get_z(param) - upd_z
    )

    let next_opt = AdamQuaternion {
        learning_rate: opt.learning_rate,
        beta1: opt.beta1,
        beta2: opt.beta2,
        epsilon: opt.epsilon,
        timestep: t,
        m_w: m_w,
        m_x: m_x,
        m_y: m_y,
        m_z: m_z,
        v_w: v_w,
        v_x: v_x,
        v_y: v_y,
        v_z: v_z,
    }

    (next_opt, next_param)
}
