//! stdlib/nn/g2_equivariant.sio
//!
//! Active G2-equivariant activation and rotation helpers.

use nn::octonion::*
use math::octonion::{Octonion, oct_norm, oct_real}

enum G2Activation {
    None,
    MagnitudeReLU,
    LeakyMagnitude,
    RealGate,
    NormSigmoid,
}

fn oct_relu_g2(o: Octonion, threshold: f32) -> Octonion {
    let n = oct_norm(o)
    if n < threshold { oct_zero() } else { o }
}

fn oct_leaky_relu_g2(o: Octonion, threshold: f32, alpha: f32) -> Octonion {
    let n = oct_norm(o)
    if n < threshold { oct_scale(o, alpha) } else { o }
}

fn oct_gate_real(o: Octonion, alpha: f32) -> Octonion {
    if oct_real(o) > 0.0 { o } else { oct_scale(o, alpha) }
}

fn oct_sigmoid_norm(o: Octonion) -> Octonion with Panic {
    let n = oct_norm(o)
    if n <= 1e-8 { return o }
    let sig = 1.0 / (1.0 + ((0.0 - n).exp()))
    oct_scale(o, sig / n)
}

fn apply_g2_activation(kind: G2Activation, input: Octonion) -> Octonion with Panic {
    match kind {
        G2Activation::None => input,
        G2Activation::MagnitudeReLU => oct_relu_g2(input, 0.0001),
        G2Activation::LeakyMagnitude => oct_leaky_relu_g2(input, 0.0001, 0.1),
        G2Activation::RealGate => oct_gate_real(input, 0.1),
        G2Activation::NormSigmoid => oct_sigmoid_norm(input),
    }
}
