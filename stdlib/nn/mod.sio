// Sounio Standard Library: Neural Networks Module
//
// Native neuro-symbolic support for Sounio:
// - Differentiable effects (gradient as algebraic effect)
// - Epistemic tensors (tensors with confidence/provenance)
// - Beam search with epistemic scoring
// - GPU kernel integration (via effects)
// - Quaternion neural networks for spatial-temporal modeling
// - Octonion neural networks for G2 exceptional Lie group representations
//
// This module enables Sounio as a first-class neuro-symbolic language:
// - Neural computation flows through effect system
// - Gradients propagate with epistemic decay
// - Symbolic constraints integrate as loss terms
// - Proofs have end-to-end confidence tracking
// - Quaternion arithmetic for 3D spatial data

pub mod differentiable;
pub mod beam_search;
pub mod quaternion;
pub mod dense_quaternion;
pub mod optimizers_quaternion;
pub mod pbpk_example;
pub mod octonion;

// Re-exports from existing modules
pub use differentiable::{
    Tensor, EpistemicTensor,
    gradient, DiffOp, TensorId,
    autodiff_handler,
    matmul, add, mul, relu, softmax,
    Linear, ConstructionMLP,
    SGD,
    NeuralConstructionSuggester,
};

pub use beam_search::{
    Beam, BeamSearchConfig, BeamSearchEngine, BeamSearchResult,
    ScoringStrategy, SearchStats,
    parallel_beam, gpu_beam_handler,
};

// Re-exports from quaternion modules
