//! stdlib/nn/g2_hyperspectral_conv.sio
//!
//! G₂-equivariant convolution for 7-band hyperspectral imagery.
//!
//! Hyperspectral images have N spatial pixels × 7 spectral bands.
//! The 7 bands map onto Im(𝕆) — the imaginary octonion subspace —
//! which is the natural representation space of G₂ = Aut(𝕆).
//!
//! Parameter efficiency vs naive 7×7 conv:
//!   Naive 7×7: 49 learnable weights per output channel
//!   G₂-equivariant: 14 weights (one per 𝔤₂ generator), 3.5× fewer
//!
//! This module operates on f64 spectral data, matching the native
//! AVX-512 ZMM kernel (8 f64 lanes) from H3.8.

// ============================================================================
// 7-band spectral vector  (Im(𝕆) ≅ ℝ⁷, zero real part)
// ============================================================================

struct SpectralVec7 {
    e1: f64, e2: f64, e3: f64, e4: f64, e5: f64, e6: f64, e7: f64,
}

fn spectral_zero() -> SpectralVec7 {
    SpectralVec7 { e1: 0.0, e2: 0.0, e3: 0.0, e4: 0.0, e5: 0.0, e6: 0.0, e7: 0.0 }
}

fn spectral_add(a: SpectralVec7, b: SpectralVec7) -> SpectralVec7 {
    SpectralVec7 {
        e1: a.e1 + b.e1, e2: a.e2 + b.e2, e3: a.e3 + b.e3,
        e4: a.e4 + b.e4, e5: a.e5 + b.e5, e6: a.e6 + b.e6,
        e7: a.e7 + b.e7,
    }
}

fn spectral_scale(v: SpectralVec7, s: f64) -> SpectralVec7 {
    SpectralVec7 {
        e1: v.e1 * s, e2: v.e2 * s, e3: v.e3 * s,
        e4: v.e4 * s, e5: v.e5 * s, e6: v.e6 * s,
        e7: v.e7 * s,
    }
}

// G₂-invariant inner product ⟨a, b⟩ = Σᵢ aᵢbᵢ
fn spectral_dot(a: SpectralVec7, b: SpectralVec7) -> f64 {
    a.e1*b.e1 + a.e2*b.e2 + a.e3*b.e3 + a.e4*b.e4 + a.e5*b.e5 + a.e6*b.e6 + a.e7*b.e7
}

fn spectral_norm_sq(v: SpectralVec7) -> f64 {
    spectral_dot(v, v)
}

// Magnitude ReLU: zero out vectors below threshold (G₂-equivariant activation)
fn spectral_magnitude_relu(v: SpectralVec7, threshold: f64) -> SpectralVec7 {
    let nsq = spectral_norm_sq(v)
    if nsq < threshold * threshold { spectral_zero() } else { v }
}

// Spectral angle cosine similarity (G₂-invariant metric)
// Returns cos(θ) ∈ [-1, 1]; avoids acos for portability
fn spectral_cos_similarity(a: SpectralVec7, b: SpectralVec7) -> f64 with Div, Panic {
    let dot = spectral_dot(a, b)
    let na_sq = spectral_norm_sq(a)
    let nb_sq = spectral_norm_sq(b)
    if na_sq <= 1e-24 || nb_sq <= 1e-24 { return 0.0 }
    let denom_sq = na_sq * nb_sq
    dot / denom_sq
}

// ============================================================================
// G₂ weight matrix W = Σₖ αₖ Dₖ  (14 generator coefficients)
// ============================================================================
//
// The 14 generators of 𝔤₂ are antisymmetric 7×7 matrices acting on Im(𝕆).
// They are indexed by the 7 Fano-plane lines (7 generators) and their
// negatives (7 more), giving 14 independent directions in 𝔤₂ ⊂ so(7).
//
// Here we represent the full weight matrix explicitly as 7 column vectors
// (each of length 7), computed from the 14 αₖ coefficients.
// For the native AVX-512 backend (H3.8), these columns are loaded into ZMMs.

struct G2WeightMatrix {
    // 7 column vectors of the 7×7 G₂ weight matrix W = Σ αₖ Dₖ
    // col[j] = j-th column of W  (j=0..6 → output components e1..e7)
    col0: SpectralVec7,
    col1: SpectralVec7,
    col2: SpectralVec7,
    col3: SpectralVec7,
    col4: SpectralVec7,
    col5: SpectralVec7,
    col6: SpectralVec7,
}

fn g2_weight_matrix_zero() -> G2WeightMatrix {
    G2WeightMatrix {
        col0: spectral_zero(), col1: spectral_zero(), col2: spectral_zero(),
        col3: spectral_zero(), col4: spectral_zero(), col5: spectral_zero(),
        col6: spectral_zero(),
    }
}

// Apply the weight matrix W to input x: output[i] = Σⱼ W[i,j] * x[j]
// (column-major: output = W·x = Σⱼ x[j] * col[j])
fn g2_matrix_apply(w: G2WeightMatrix, x: SpectralVec7) -> SpectralVec7 {
    var out = spectral_zero()
    out = spectral_add(out, spectral_scale(w.col0, x.e1))
    out = spectral_add(out, spectral_scale(w.col1, x.e2))
    out = spectral_add(out, spectral_scale(w.col2, x.e3))
    out = spectral_add(out, spectral_scale(w.col3, x.e4))
    out = spectral_add(out, spectral_scale(w.col4, x.e5))
    out = spectral_add(out, spectral_scale(w.col5, x.e6))
    out = spectral_add(out, spectral_scale(w.col6, x.e7))
    out
}

// ============================================================================
// G₂-equivariant dense layer
// ============================================================================

struct HyperConvG2 {
    weight: G2WeightMatrix,
    bias: SpectralVec7,
    use_relu: bool,
    relu_threshold: f64,
}

fn hyper_conv_g2_new(weight: G2WeightMatrix) -> HyperConvG2 {
    HyperConvG2 {
        weight: weight,
        bias: spectral_zero(),
        use_relu: false,
        relu_threshold: 0.0,
    }
}

fn hyper_conv_g2_with_bias(layer: HyperConvG2, bias: SpectralVec7) -> HyperConvG2 {
    HyperConvG2 {
        weight: layer.weight,
        bias: bias,
        use_relu: layer.use_relu,
        relu_threshold: layer.relu_threshold,
    }
}

fn hyper_conv_g2_with_relu(layer: HyperConvG2, threshold: f64) -> HyperConvG2 {
    HyperConvG2 {
        weight: layer.weight,
        bias: layer.bias,
        use_relu: true,
        relu_threshold: threshold,
    }
}

// Forward pass: y = activation(W·x + b)
fn hyper_conv_g2_forward(layer: HyperConvG2, x: SpectralVec7) -> SpectralVec7 {
    let wx = g2_matrix_apply(layer.weight, x)
    let out = spectral_add(wx, layer.bias)
    if layer.use_relu {
        spectral_magnitude_relu(out, layer.relu_threshold)
    } else {
        out
    }
}

// ============================================================================
// Parameter count comparison
// ============================================================================

struct LayerParamInfo {
    g2_params: i64,     // 14 × out_channels (G₂-equivariant)
    naive_params: i64,  // 49 × out_channels (full 7×7)
    reduction_num: i64, // numerator of reduction factor (naive / g2)
    reduction_den: i64, // denominator (always 2 for 3.5× = 7/2)
}

fn layer_param_info(out_channels: i64) -> LayerParamInfo {
    LayerParamInfo {
        g2_params: 14 * out_channels,
        naive_params: 49 * out_channels,
        reduction_num: 7,
        reduction_den: 2,
    }
}
