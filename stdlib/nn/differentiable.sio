// stdlib/nn/differentiable.sio — Differentiable Module Interfaces
//
// Differentiable computation as effect-driven forward/backward passes.
// Every module tracks epistemic confidence through gradient updates:
//   - Confidence decays through each backward pass
//   - Gradient magnitude affects confidence degradation rate
//   - Converging training increases confidence; diverging decreases it
//
// SOTA: Tesseract (SciPy 2025): Pipeline-level AD across heterogeneous modules
//       Affect (POPL 2025): Effect handlers for one-shot/multi-shot continuations
//
// Design: Fixed-size arrays, no heap allocation, pure Sounio.
// Max 256 parameters per layer, max 8 layers per network.

// =============================================================================
// Math helpers
// =============================================================================

fn abs_diff(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn sqrt_diff(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 20 { y = 0.5 * (y + x / y); i = i + 1 }
    y
}

fn min_diff(a: f64, b: f64) -> f64 {
    if a < b { a } else { b }
}

fn max_diff(a: f64, b: f64) -> f64 {
    if a > b { a } else { b }
}

fn exp_diff(x: f64) -> f64 with Mut, Div, Panic {
    let clamped = if x > 700.0 { 700.0 } else if x < -700.0 { -700.0 } else { x }
    var result = 1.0
    var term = 1.0
    var i = 1
    while i < 30 {
        term = term * clamped / (i as f64)
        result = result + term
        i = i + 1
    }
    result
}

// =============================================================================
// Dense Tensor (fixed-size, stack-allocated)
// =============================================================================
// Max 256 elements — sufficient for layers up to 16x16

struct DenseTensor {
    data: [f64; 256],
    rows: i32,
    cols: i32,
}

fn tensor_zeros(rows: i32, cols: i32) -> DenseTensor {
    DenseTensor { data: [0.0; 256], rows: rows, cols: cols }
}

fn tensor_set(t: &!DenseTensor, row: i32, col: i32, val: f64) with Mut, Panic {
    t.data[row * t.cols + col] = val
}

fn tensor_get(t: &DenseTensor, row: i32, col: i32) -> f64 with Panic {
    t.data[row * t.cols + col]
}

fn tensor_flat_get(t: &DenseTensor, idx: i32) -> f64 with Panic {
    t.data[idx]
}

fn tensor_flat_set(t: &!DenseTensor, idx: i32, val: f64) with Mut, Panic {
    t.data[idx] = val
}

fn tensor_numel(t: &DenseTensor) -> i32 {
    t.rows * t.cols
}

// =============================================================================
// Epistemic Tensor — Tensor + confidence tracking
// =============================================================================

struct EpistemicTensor {
    data: [f64; 256],
    grad: [f64; 256],
    confidence: [f64; 256],
    rows: i32,
    cols: i32,
    requires_grad: bool,
}

fn etensor_zeros(rows: i32, cols: i32, needs_grad: bool) -> EpistemicTensor {
    EpistemicTensor {
        data: [0.0; 256],
        grad: [0.0; 256],
        confidence: [1.0; 256],
        rows: rows,
        cols: cols,
        requires_grad: needs_grad,
    }
}

fn etensor_set(t: &!EpistemicTensor, idx: i32, val: f64, conf: f64) with Mut, Panic {
    t.data[idx] = val
    t.confidence[idx] = conf
}

fn etensor_get(t: &EpistemicTensor, idx: i32) -> f64 with Panic {
    t.data[idx]
}

fn etensor_zero_grad(t: &!EpistemicTensor) with Mut, Div, Panic {
    var i = 0
    let n = t.rows * t.cols
    while i < n {
        t.grad[i] = 0.0
        i = i + 1
    }
}

fn etensor_accumulate_grad(t: &!EpistemicTensor, incoming: &[f64; 256], n: i32) with Mut, Div, Panic {
    var i = 0
    while i < n {
        t.grad[i] = t.grad[i] + incoming[i]
        i = i + 1
    }
}

// Min confidence across all elements
fn etensor_min_confidence(t: &EpistemicTensor) -> f64 with Mut, Div, Panic {
    var min_c = 1.0
    var i = 0
    let n = t.rows * t.cols
    while i < n {
        if t.confidence[i] < min_c { min_c = t.confidence[i] }
        i = i + 1
    }
    min_c
}

// =============================================================================
// Differentiable Operations — Forward + Backward
// =============================================================================

// Each operation returns the forward result AND can compute gradients.
// This is the "split tape" approach: we store activations inline.

// --- Linear (Dense) Layer ---

struct LinearLayer {
    weights: EpistemicTensor,  // [out_size x in_size]
    biases: EpistemicTensor,   // [out_size x 1]
    in_size: i32,
    out_size: i32,
    // Cached input for backward pass
    cached_input: [f64; 256],
    cached_output: [f64; 256],
}

fn linear_new(in_size: i32, out_size: i32) -> LinearLayer {
    LinearLayer {
        weights: etensor_zeros(out_size, in_size, true),
        biases: etensor_zeros(out_size, 1, true),
        in_size: in_size,
        out_size: out_size,
        cached_input: [0.0; 256],
        cached_output: [0.0; 256],
    }
}

// Initialize with small random-like values (deterministic for reproducibility)
fn linear_init(layer: &!LinearLayer, seed: f64) with Mut, Div, Panic {
    let n = layer.in_size * layer.out_size
    var s = seed
    var i = 0
    while i < n {
        // Simple deterministic pseudo-random via fractional multiply
        s = s * 16807.123 + 0.4231
        var v = s
        while v >= 1.0 { v = v - 1.0 }
        while v < 0.0 { v = v + 1.0 }
        // Xavier initialization: scale by sqrt(2 / (fan_in + fan_out))
        let scale = sqrt_diff(2.0 / ((layer.in_size + layer.out_size) as f64))
        let val = (v - 0.5) * 2.0 * scale
        layer.weights.data[i] = val
        layer.weights.confidence[i] = 0.5  // initial confidence: moderate
        i = i + 1
    }
    // Biases start at zero with full confidence
    i = 0
    while i < layer.out_size {
        layer.biases.data[i] = 0.0
        layer.biases.confidence[i] = 1.0
        i = i + 1
    }
}

// Forward: output = W * input + bias
fn linear_forward(
    layer: &!LinearLayer,
    input: &[f64; 256],
    input_size: i32,
) -> [f64; 256] with Mut, Div, Panic {
    // Cache input for backward
    var i = 0
    while i < input_size {
        layer.cached_input[i] = input[i]
        i = i + 1
    }

    var output: [f64; 256] = [0.0; 256]
    var o = 0
    while o < layer.out_size {
        var sum = layer.biases.data[o]
        var j = 0
        while j < layer.in_size {
            sum = sum + layer.weights.data[o * layer.in_size + j] * input[j]
            j = j + 1
        }
        output[o] = sum
        layer.cached_output[o] = sum
        o = o + 1
    }
    output
}

// Backward: compute gradients for weights, biases, and input
// grad_output: gradient from the next layer [out_size]
// Returns: gradient w.r.t. input [in_size]
fn linear_backward(
    layer: &!LinearLayer,
    grad_output: &[f64; 256],
) -> [f64; 256] with Mut, Div, Panic {
    // Gradient w.r.t. weights: dW = grad_output * input^T
    var o = 0
    while o < layer.out_size {
        var j = 0
        while j < layer.in_size {
            let dw = grad_output[o] * layer.cached_input[j]
            let idx = o * layer.in_size + j
            layer.weights.grad[idx] = layer.weights.grad[idx] + dw
            j = j + 1
        }
        // Gradient w.r.t. bias: db = grad_output
        layer.biases.grad[o] = layer.biases.grad[o] + grad_output[o]
        o = o + 1
    }

    // Gradient w.r.t. input: dx = W^T * grad_output
    var grad_input: [f64; 256] = [0.0; 256]
    var j = 0
    while j < layer.in_size {
        var sum = 0.0
        o = 0
        while o < layer.out_size {
            sum = sum + layer.weights.data[o * layer.in_size + j] * grad_output[o]
            o = o + 1
        }
        grad_input[j] = sum
        j = j + 1
    }
    grad_input
}

// =============================================================================
// Activation Functions — Forward + Backward
// =============================================================================

// ReLU: y = max(0, x)
fn relu_forward(input: &[f64; 256], n: i32, output: &![f64; 256]) with Mut, Div, Panic {
    var i = 0
    while i < n {
        output[i] = if input[i] > 0.0 { input[i] } else { 0.0 }
        i = i + 1
    }
}

fn relu_backward(
    input: &[f64; 256],
    grad_output: &[f64; 256],
    n: i32,
    grad_input: &![f64; 256],
) with Mut, Div, Panic {
    var i = 0
    while i < n {
        grad_input[i] = if input[i] > 0.0 { grad_output[i] } else { 0.0 }
        i = i + 1
    }
}

// Sigmoid: y = 1 / (1 + exp(-x))
fn sigmoid_forward(input: &[f64; 256], n: i32, output: &![f64; 256]) with Mut, Div, Panic {
    var i = 0
    while i < n {
        let ex = exp_diff(0.0 - input[i])
        output[i] = 1.0 / (1.0 + ex)
        i = i + 1
    }
}

fn sigmoid_backward(
    output: &[f64; 256],
    grad_output: &[f64; 256],
    n: i32,
    grad_input: &![f64; 256],
) with Mut, Div, Panic {
    var i = 0
    while i < n {
        let s = output[i]
        grad_input[i] = grad_output[i] * s * (1.0 - s)
        i = i + 1
    }
}

// Softmax (numerically stable)
fn softmax_forward(input: &[f64; 256], n: i32, output: &![f64; 256]) with Mut, Div, Panic {
    // Find max for numerical stability
    var max_val = input[0]
    var i = 1
    while i < n {
        if input[i] > max_val { max_val = input[i] }
        i = i + 1
    }

    // Compute exp(x - max) and sum
    var sum = 0.0
    i = 0
    while i < n {
        output[i] = exp_diff(input[i] - max_val)
        sum = sum + output[i]
        i = i + 1
    }

    // Normalize
    i = 0
    while i < n {
        output[i] = output[i] / sum
        i = i + 1
    }
}

// =============================================================================
// Loss Functions
// =============================================================================

// Mean Squared Error: L = (1/n) * sum((pred - target)^2)
fn mse_loss(
    pred: &[f64; 256],
    target: &[f64; 256],
    n: i32,
) -> f64 with Mut, Div, Panic {
    var sum = 0.0
    var i = 0
    while i < n {
        let d = pred[i] - target[i]
        sum = sum + d * d
        i = i + 1
    }
    sum / (n as f64)
}

fn mse_grad(
    pred: &[f64; 256],
    target: &[f64; 256],
    n: i32,
    grad: &![f64; 256],
) with Mut, Div, Panic {
    var i = 0
    let scale = 2.0 / (n as f64)
    while i < n {
        grad[i] = scale * (pred[i] - target[i])
        i = i + 1
    }
}

// Cross-entropy loss: L = -sum(target * log(pred))
fn cross_entropy_loss(
    pred: &[f64; 256],
    target: &[f64; 256],
    n: i32,
) -> f64 with Mut, Div, Panic {
    var sum = 0.0
    var i = 0
    while i < n {
        let p = if pred[i] < 1.0e-10 { 1.0e-10 } else { pred[i] }
        // ln via artanh series
        var lp = 0.0
        var m = p
        var e_val = 0
        while m >= 2.0 { m = m / 2.0; e_val = e_val + 1 }
        while m < 0.5 { m = m * 2.0; e_val = e_val - 1 }
        let t = (m - 1.0) / (m + 1.0)
        let t2 = t * t
        var s = t
        var term = t
        var k = 1
        while k < 20 { term = term * t2; s = s + term / (2 * k + 1) as f64; k = k + 1 }
        lp = 2.0 * s + (e_val as f64) * 0.6931471805599453

        sum = sum - target[i] * lp
        i = i + 1
    }
    sum
}

// =============================================================================
// SGD Optimizer — with epistemic confidence update
// =============================================================================

struct SGDConfig {
    learning_rate: f64,
    momentum: f64,
    weight_decay: f64,
    confidence_decay_rate: f64,  // how much confidence decays per update
}

fn sgd_default() -> SGDConfig {
    SGDConfig {
        learning_rate: 0.01,
        momentum: 0.9,
        weight_decay: 0.0001,
        confidence_decay_rate: 0.001,
    }
}

// Update a single epistemic tensor's parameters using SGD
fn sgd_step(
    params: &!EpistemicTensor,
    velocity: &![f64; 256],
    n: i32,
    config: &SGDConfig,
) with Mut, Div, Panic {
    var i = 0
    while i < n {
        // Weight decay
        let grad_with_decay = params.grad[i] + config.weight_decay * params.data[i]

        // Momentum
        velocity[i] = config.momentum * velocity[i] + grad_with_decay

        // Update parameter
        params.data[i] = params.data[i] - config.learning_rate * velocity[i]

        // Confidence update:
        // Large gradient magnitude → less confidence (model is still changing)
        // Small gradient → more confidence (converging)
        let grad_mag = abs_diff(grad_with_decay)
        let decay = config.confidence_decay_rate * (1.0 + 10.0 * grad_mag)
        params.confidence[i] = params.confidence[i] * (1.0 - min_diff(decay, 0.1))

        // Floor confidence
        if params.confidence[i] < 0.01 { params.confidence[i] = 0.01 }

        i = i + 1
    }
}

// =============================================================================
// Multi-Layer Perceptron (MLP) — up to 8 layers
// =============================================================================

struct MLP {
    layers: [LinearLayer; 8],
    n_layers: i32,
    // Cached activations for backward pass
    activations: [[f64; 256]; 9],  // n_layers + 1 (input + each layer output)
    relu_masks: [[f64; 256]; 8],   // ReLU activations (pre-activation for backward)
    layer_sizes: [i32; 9],         // input_size, hidden1, hidden2, ..., output_size
}

fn mlp_new(layer_sizes: &[i32; 9], n_layers: i32) -> MLP with Mut, Div, Panic {
    var mlp = MLP {
        layers: [LinearLayer {
            weights: EpistemicTensor {
                data: [0.0; 256], grad: [0.0; 256], confidence: [1.0; 256],
                rows: 0, cols: 0, requires_grad: true,
            },
            biases: EpistemicTensor {
                data: [0.0; 256], grad: [0.0; 256], confidence: [1.0; 256],
                rows: 0, cols: 0, requires_grad: true,
            },
            in_size: 0, out_size: 0,
            cached_input: [0.0; 256], cached_output: [0.0; 256],
        }; 8],
        n_layers: n_layers,
        activations: [[0.0; 256]; 9],
        relu_masks: [[0.0; 256]; 8],
        layer_sizes: [0; 9],
    }

    var i = 0
    while i <= n_layers {
        mlp.layer_sizes[i] = layer_sizes[i]
        i = i + 1
    }

    // Initialize layers
    i = 0
    while i < n_layers {
        mlp.layers[i] = linear_new(layer_sizes[i], layer_sizes[i + 1])
        linear_init(&!mlp.layers[i], 0.42 + (i as f64) * 0.137)
        i = i + 1
    }

    mlp
}

// Forward pass through the MLP
// Returns output activations
fn mlp_forward(
    mlp: &!MLP,
    input: &[f64; 256],
    input_size: i32,
) -> [f64; 256] with Mut, Div, Panic {
    // Store input as first activation
    var i = 0
    while i < input_size {
        mlp.activations[0][i] = input[i]
        i = i + 1
    }

    // Forward through each layer
    var layer_idx = 0
    while layer_idx < mlp.n_layers {
        let act = linear_forward(
            &!mlp.layers[layer_idx],
            &mlp.activations[layer_idx],
            mlp.layer_sizes[layer_idx],
        )

        // Apply ReLU for all layers except the last
        if layer_idx < mlp.n_layers - 1 {
            var j = 0
            while j < mlp.layer_sizes[layer_idx + 1] {
                mlp.relu_masks[layer_idx][j] = act[j]  // store pre-relu
                mlp.activations[layer_idx + 1][j] = if act[j] > 0.0 { act[j] } else { 0.0 }
                j = j + 1
            }
        } else {
            // Last layer: no activation (or softmax applied separately)
            var j = 0
            while j < mlp.layer_sizes[layer_idx + 1] {
                mlp.activations[layer_idx + 1][j] = act[j]
                j = j + 1
            }
        }

        layer_idx = layer_idx + 1
    }

    mlp.activations[mlp.n_layers]
}

// Backward pass: propagate gradients through the MLP
fn mlp_backward(
    mlp: &!MLP,
    grad_output: &[f64; 256],
) with Mut, Div, Panic {
    var current_grad: [f64; 256] = [0.0; 256]
    var i = 0
    let out_size = mlp.layer_sizes[mlp.n_layers]
    while i < out_size {
        current_grad[i] = grad_output[i]
        i = i + 1
    }

    // Backward through layers in reverse
    var layer_idx = mlp.n_layers - 1
    while layer_idx >= 0 {
        // Apply ReLU backward for all layers except the last
        if layer_idx < mlp.n_layers - 1 {
            var j = 0
            while j < mlp.layer_sizes[layer_idx + 1] {
                if mlp.relu_masks[layer_idx][j] <= 0.0 {
                    current_grad[j] = 0.0
                }
                j = j + 1
            }
        }

        // Linear backward
        let prev_grad = linear_backward(&!mlp.layers[layer_idx], &current_grad)
        i = 0
        while i < mlp.layer_sizes[layer_idx] {
            current_grad[i] = prev_grad[i]
            i = i + 1
        }

        layer_idx = layer_idx - 1
    }
}

// Zero all gradients in the MLP
fn mlp_zero_grad(mlp: &!MLP) with Mut, Div, Panic {
    var l = 0
    while l < mlp.n_layers {
        etensor_zero_grad(&!mlp.layers[l].weights)
        etensor_zero_grad(&!mlp.layers[l].biases)
        l = l + 1
    }
}

// =============================================================================
// Training Step — with epistemic tracking
// =============================================================================

struct TrainingState {
    epoch: i32,
    total_loss: f64,
    min_confidence: f64,     // min across all parameters
    mean_confidence: f64,    // mean across all parameters
    n_params: i32,
}

// Forward pass helper that computes loss gradient directly.
// Avoids holding forward output while mlp is borrowed elsewhere.
fn mlp_forward_and_grad(
    mlp: &!MLP,
    input: &[f64; 256],
    target: &[f64; 256],
    input_size: i32,
    output_size: i32,
    loss_grad: &![f64; 256],
) -> f64 with Mut, Div, Panic {
    let output = mlp_forward(mlp, input, input_size)
    let loss = mse_loss(&output, target, output_size)
    mse_grad(&output, target, output_size, loss_grad)
    loss
}

// Complete training step: forward, loss, backward, SGD update.
fn training_step(
    mlp: &!MLP,
    input: &[f64; 256],
    target: &[f64; 256],
    input_size: i32,
    output_size: i32,
    config: &SGDConfig,
    velocities_w: &![[f64; 256]; 8],
    velocities_b: &![[f64; 256]; 8],
) -> f64 with Mut, Div, Panic {
    // Zero gradients
    mlp_zero_grad(mlp)

    // Forward + compute loss gradient in one call
    var loss_grad: [f64; 256] = [0.0; 256]
    let loss = mlp_forward_and_grad(mlp, input, target, input_size, output_size, &!loss_grad)

    // Copy loss_grad to avoid borrow conflict
    var grad_copy: [f64; 256] = [0.0; 256]
    var gi = 0
    while gi < 256 { grad_copy[gi] = loss_grad[gi]; gi = gi + 1 }

    // Backward pass
    mlp_backward(mlp, &grad_copy)

    // SGD update with epistemic tracking
    var l = 0
    while l < mlp.n_layers {
        let w_n = mlp.layers[l].in_size * mlp.layers[l].out_size
        let out_sz = mlp.layers[l].out_size
        sgd_step(&!mlp.layers[l].weights, &!velocities_w[l], w_n, config)
        sgd_step(&!mlp.layers[l].biases, &!velocities_b[l], out_sz, config)
        l = l + 1
    }

    loss
}

// =============================================================================
// Epistemic Summary — How confident is the model?
// =============================================================================

struct ModelConfidence {
    min_weight_confidence: f64,
    mean_weight_confidence: f64,
    max_grad_magnitude: f64,
    is_converging: bool,
    n_total_params: i32,
}

fn mlp_confidence(mlp: &MLP) -> ModelConfidence with Mut, Div, Panic {
    var min_conf = 1.0
    var sum_conf = 0.0
    var max_grad = 0.0
    var total_params = 0

    var l = 0
    while l < mlp.n_layers {
        let w_n = mlp.layers[l].in_size * mlp.layers[l].out_size
        var i = 0
        while i < w_n {
            let c = mlp.layers[l].weights.confidence[i]
            if c < min_conf { min_conf = c }
            sum_conf = sum_conf + c
            let gm = abs_diff(mlp.layers[l].weights.grad[i])
            if gm > max_grad { max_grad = gm }
            total_params = total_params + 1
            i = i + 1
        }
        // Biases
        i = 0
        while i < mlp.layers[l].out_size {
            let c = mlp.layers[l].biases.confidence[i]
            if c < min_conf { min_conf = c }
            sum_conf = sum_conf + c
            total_params = total_params + 1
            i = i + 1
        }
        l = l + 1
    }

    let mean_conf = if total_params > 0 { sum_conf / (total_params as f64) } else { 0.0 }

    ModelConfidence {
        min_weight_confidence: min_conf,
        mean_weight_confidence: mean_conf,
        max_grad_magnitude: max_grad,
        is_converging: max_grad < 0.01,
        n_total_params: total_params,
    }
}
