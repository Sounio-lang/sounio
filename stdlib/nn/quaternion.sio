//! stdlib/nn/quaternion.sio
//!
//! Active quaternion API for stdlib hypercomplex execution lanes.

pub struct Quaternion {
    w: f64,
    x: f64,
    y: f64,
    z: f64,
}

fn quaternion_exact(w: f64, x: f64, y: f64, z: f64) -> Quaternion {
    Quaternion { w: w, x: x, y: y, z: z }
}

fn quaternion_identity() -> Quaternion {
    quaternion_exact(1.0, 0.0, 0.0, 0.0)
}

fn quaternion_zero() -> Quaternion {
    quaternion_exact(0.0, 0.0, 0.0, 0.0)
}

fn quaternion_get_w(q: Quaternion) -> f64 { q.w }
fn quaternion_get_x(q: Quaternion) -> f64 { q.x }
fn quaternion_get_y(q: Quaternion) -> f64 { q.y }
fn quaternion_get_z(q: Quaternion) -> f64 { q.z }

fn quaternion_add(a: Quaternion, b: Quaternion) -> Quaternion {
    quaternion_exact(a.w + b.w, a.x + b.x, a.y + b.y, a.z + b.z)
}

fn quaternion_sub(a: Quaternion, b: Quaternion) -> Quaternion {
    quaternion_exact(a.w - b.w, a.x - b.x, a.y - b.y, a.z - b.z)
}

fn quaternion_mul_scalar(q: Quaternion, s: f64) -> Quaternion {
    quaternion_exact(q.w * s, q.x * s, q.y * s, q.z * s)
}

fn quaternion_conjugate(q: Quaternion) -> Quaternion {
    quaternion_exact(q.w, 0.0 - q.x, 0.0 - q.y, 0.0 - q.z)
}

fn quaternion_dot(a: Quaternion, b: Quaternion) -> f64 {
    a.w * b.w + a.x * b.x + a.y * b.y + a.z * b.z
}

fn quaternion_norm_squared(q: Quaternion) -> f64 {
    quaternion_dot(q, q)
}

fn quaternion_norm(q: Quaternion) -> f64 {
    quaternion_norm_squared(q).sqrt()
}

fn quaternion_normalize(q: Quaternion) -> Quaternion {
    let n = quaternion_norm(q)
    if n <= 1e-12 {
        quaternion_identity()
    } else {
        quaternion_mul_scalar(q, 1.0 / n)
    }
}

fn quaternion_mul(a: Quaternion, b: Quaternion) -> Quaternion {
    let w = a.w * b.w - a.x * b.x - a.y * b.y - a.z * b.z
    let x = a.w * b.x + a.x * b.w + a.y * b.z - a.z * b.y
    let y = a.w * b.y - a.x * b.z + a.y * b.w + a.z * b.x
    let z = a.w * b.z + a.x * b.y - a.y * b.x + a.z * b.w
    quaternion_exact(w, x, y, z)
}

fn quaternion_inverse(q: Quaternion) -> Quaternion {
    let n2 = quaternion_norm_squared(q)
    if n2 <= 1e-12 {
        quaternion_identity()
    } else {
        quaternion_mul_scalar(quaternion_conjugate(q), 1.0 / n2)
    }
}

fn sigmoid_f64(x: f64) -> f64 {
    1.0 / (1.0 + (0.0 - x).exp())
}

fn quaternion_relu(q: Quaternion) -> Quaternion {
    quaternion_exact(
        if q.w > 0.0 { q.w } else { 0.0 },
        if q.x > 0.0 { q.x } else { 0.0 },
        if q.y > 0.0 { q.y } else { 0.0 },
        if q.z > 0.0 { q.z } else { 0.0 }
    )
}

fn quaternion_sigmoid(q: Quaternion) -> Quaternion {
    quaternion_exact(sigmoid_f64(q.w), sigmoid_f64(q.x), sigmoid_f64(q.y), sigmoid_f64(q.z))
}

fn quaternion_tanh(q: Quaternion) -> Quaternion {
    quaternion_exact(q.w.tanh(), q.x.tanh(), q.y.tanh(), q.z.tanh())
}
