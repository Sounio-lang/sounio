// stdlib::nn::epi_certify — the typed dose-certification boundary.
//
// THE DARE, made honest. An epistemic net (built on linalg::epistemic_tensor_dyn)
// propagates GUM uncertainty and produces a RUNTIME confidence for each
// prediction. The question: how does a learned prediction become a clinical
// action (a prescribed dose) without laundering unprovable confidence?
//
// TWO LAYERS, by design:
//
//   1. RUNTIME gate (this module). The net's confidence is computed at run time
//      (it depends on the data seen), so it lives here, as a plain branch:
//      `epi_runtime_certified(net_conf, threshold)`. This decides WHETHER a
//      prediction is even eligible to be certified.
//
//   2. COMPILE-TIME contract (the call site, not this module). A prescription
//      API is gated `with Epistemic(N)`. The Sounio compiler enforces that every
//      Knowledge token entering it carries a LITERAL ε ≥ N/1000. A computed /
//      non-literal ε is stamped conf=1 and REJECTED ("EpistemicComplete
//      violation"). So a learned net's runtime ε can NEVER statically satisfy
//      the gate — the only path to a dose is an explicit, source-visible,
//      auditable LITERAL-ε certification (a human/clinician attestation).
//
// What this is NOT: the compiler does NOT prove the net is confident (impossible
// for a learned model). It proves prescription is non-bypassable and that
// computed confidence cannot silently launder into a dose. See the witnesses:
//   tests/run-pass/dose_certify_accept.sio   (certified literal-ε → prescribes)
//   tests/compile-fail/dose_contract_bypass.sio (computed ε → rejected)

// ASHP/IDSA/SIDP 2020 §8.3: AUC-guided vancomycin dosing requires evidence
// quality ε ≥ 0.82 before a dose is permitted. Expressed as a 0..1000 milli-grade
// for the `with Epistemic(N)` gate, that is N = 820.
pub fn ashp_vanco_threshold_milli() -> i64 { 820 }
pub fn ashp_vanco_threshold() -> f64 { 0.82 }

// RUNTIME gate: does the net's computed confidence clear the bar? This is the
// honest home of a LEARNED model's confidence — it is data-dependent, hence
// runtime. Returns true iff the prediction is eligible to be certified.
pub fn epi_runtime_certified(net_conf: f64, threshold: f64) -> bool {
    net_conf >= threshold
}
