// dual.d - Forward-Mode Automatic Differentiation using Dual Numbers
//
// Dual numbers extend real numbers with an infinitesimal ε where ε² = 0.
// A dual number is: a + bε, where a is the value and b is the derivative.
//
// For any analytic function f:
//   f(a + bε) = f(a) + b*f'(a)*ε
//
// This enables automatic computation of derivatives by propagating through
// arithmetic operations. Perfect for functions with few inputs.
//
// Reference: "Automatic Differentiation in Machine Learning: a Survey"
//            Baydin et al., JMLR 2018

// ============================================================================
// HELPER FUNCTIONS
// ============================================================================

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn sqrt_f64(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    return y
}

// Exponential via Taylor series (15 terms)
fn exp_f64(x: f64) -> f64 with Mut {
    // Handle large values by range reduction: exp(x) = exp(x/n)^n
    if x > 20.0 { return exp_f64(x / 2.0) * exp_f64(x / 2.0) }
    if x < 0.0 - 20.0 { return 1.0 / exp_f64(0.0 - x) }

    var sum = 1.0
    var term = 1.0
    term = term * x / 1.0
    sum = sum + term
    term = term * x / 2.0
    sum = sum + term
    term = term * x / 3.0
    sum = sum + term
    term = term * x / 4.0
    sum = sum + term
    term = term * x / 5.0
    sum = sum + term
    term = term * x / 6.0
    sum = sum + term
    term = term * x / 7.0
    sum = sum + term
    term = term * x / 8.0
    sum = sum + term
    term = term * x / 9.0
    sum = sum + term
    term = term * x / 10.0
    sum = sum + term
    term = term * x / 11.0
    sum = sum + term
    term = term * x / 12.0
    sum = sum + term
    term = term * x / 13.0
    sum = sum + term
    term = term * x / 14.0
    sum = sum + term
    term = term * x / 15.0
    sum = sum + term
    return sum
}

// Natural log via Halley's method with range reduction
fn ln_f64(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 - 1000000.0 }  // -inf approximation

    // Range reduction: ln(x) = ln(x/e^k) + k for appropriate k
    var val = x
    var k = 0.0
    let e = 2.718281828459045

    // Reduce to [1/e, e] range
    while val > e {
        val = val / e
        k = k + 1.0
    }
    while val < 1.0 / e {
        val = val * e
        k = k - 1.0
    }

    // Now use series: ln(1+u) = u - u²/2 + u³/3 - u⁴/4 + ...
    // where u = (val - 1) / (val + 1), so ln(val) = 2 * artanh(u)
    // artanh(u) = u + u³/3 + u⁵/5 + u⁷/7 + ...
    let u = (val - 1.0) / (val + 1.0)
    let u2 = u * u
    var sum = u
    var term = u
    term = term * u2
    sum = sum + term / 3.0
    term = term * u2
    sum = sum + term / 5.0
    term = term * u2
    sum = sum + term / 7.0
    term = term * u2
    sum = sum + term / 9.0
    term = term * u2
    sum = sum + term / 11.0
    term = term * u2
    sum = sum + term / 13.0
    term = term * u2
    sum = sum + term / 15.0
    term = term * u2
    sum = sum + term / 17.0
    term = term * u2
    sum = sum + term / 19.0
    term = term * u2
    sum = sum + term / 21.0

    return 2.0 * sum + k
}

// Power function: x^n using exp/ln
fn pow_f64(x: f64, n: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    return exp_f64(n * ln_f64(x))
}

// Sine via Taylor series
fn sin_f64(x: f64) -> f64 with Mut, Div, Panic {
    // Reduce to [-π, π]
    let pi = 3.141592653589793
    var y = x
    while y > pi { y = y - 2.0 * pi }
    while y < 0.0 - pi { y = y + 2.0 * pi }

    // Taylor: sin(x) = x - x³/3! + x⁵/5! - x⁷/7! + ...
    let x2 = y * y
    var sum = y
    var term = y
    term = term * (0.0 - x2) / (2.0 * 3.0)
    sum = sum + term
    term = term * (0.0 - x2) / (4.0 * 5.0)
    sum = sum + term
    term = term * (0.0 - x2) / (6.0 * 7.0)
    sum = sum + term
    term = term * (0.0 - x2) / (8.0 * 9.0)
    sum = sum + term
    term = term * (0.0 - x2) / (10.0 * 11.0)
    sum = sum + term
    term = term * (0.0 - x2) / (12.0 * 13.0)
    sum = sum + term
    return sum
}

// Cosine via Taylor series
fn cos_f64(x: f64) -> f64 with Mut, Div, Panic {
    let pi = 3.141592653589793
    var y = x
    while y > pi { y = y - 2.0 * pi }
    while y < 0.0 - pi { y = y + 2.0 * pi }

    // Taylor: cos(x) = 1 - x²/2! + x⁴/4! - x⁶/6! + ...
    let x2 = y * y
    var sum = 1.0
    var term = 1.0
    term = term * (0.0 - x2) / (1.0 * 2.0)
    sum = sum + term
    term = term * (0.0 - x2) / (3.0 * 4.0)
    sum = sum + term
    term = term * (0.0 - x2) / (5.0 * 6.0)
    sum = sum + term
    term = term * (0.0 - x2) / (7.0 * 8.0)
    sum = sum + term
    term = term * (0.0 - x2) / (9.0 * 10.0)
    sum = sum + term
    term = term * (0.0 - x2) / (11.0 * 12.0)
    sum = sum + term
    return sum
}

fn tanh_f64(x: f64) -> f64 with Mut, Div, Panic {
    let e2x = exp_f64(2.0 * x)
    return (e2x - 1.0) / (e2x + 1.0)
}

fn signum_f64(x: f64) -> f64 {
    if x > 0.0 { return 1.0 }
    if x < 0.0 { return 0.0 - 1.0 }
    return 0.0
}

// ============================================================================
// DUAL NUMBER TYPE
// ============================================================================
// Dual number: val + dot*ε where ε² = 0
// val is the primal (function value)
// dot is the tangent (derivative)

struct Dual {
    val: f64,  // Primal value
    dot: f64   // Tangent (derivative)
}

// Create a constant (derivative = 0)
fn dual_const(val: f64) -> Dual {
    return Dual { val: val, dot: 0.0 }
}

// Create a variable (derivative = 1)
fn dual_var(val: f64) -> Dual {
    return Dual { val: val, dot: 1.0 }
}

// Create with explicit derivative
fn dual_new(val: f64, dot: f64) -> Dual {
    return Dual { val: val, dot: dot }
}

// ============================================================================
// ARITHMETIC OPERATIONS
// ============================================================================

fn dual_add(a: Dual, b: Dual) -> Dual {
    return Dual { val: a.val + b.val, dot: a.dot + b.dot }
}

fn dual_sub(a: Dual, b: Dual) -> Dual {
    return Dual { val: a.val - b.val, dot: a.dot - b.dot }
}

fn dual_mul(a: Dual, b: Dual) -> Dual with Mut, Div, Panic {
    // Product rule: (f*g)' = f'*g + f*g'
    return Dual {
        val: a.val * b.val,
        dot: a.dot * b.val + a.val * b.dot
    }
}

fn dual_div(a: Dual, b: Dual) -> Dual with Mut, Div, Panic {
    // Quotient rule: (f/g)' = (f'*g - f*g') / g²
    let g2 = b.val * b.val
    return Dual {
        val: a.val / b.val,
        dot: (a.dot * b.val - a.val * b.dot) / g2
    }
}

fn dual_neg(a: Dual) -> Dual with Mut, Div, Panic {
    return Dual { val: 0.0 - a.val, dot: 0.0 - a.dot }
}

// Scale by constant
fn dual_scale(a: Dual, s: f64) -> Dual {
    return Dual { val: a.val * s, dot: a.dot * s }
}

// Add constant
fn dual_add_const(a: Dual, c: f64) -> Dual {
    return Dual { val: a.val + c, dot: a.dot }
}

// ============================================================================
// MATHEMATICAL FUNCTIONS
// ============================================================================

fn dual_sqrt(a: Dual) -> Dual with Mut, Div, Panic {
    // d/dx sqrt(x) = 1/(2*sqrt(x))
    let v = sqrt_f64(a.val)
    return Dual { val: v, dot: a.dot / (2.0 * v) }
}

fn dual_exp(a: Dual) -> Dual with Mut, Div, Panic {
    // d/dx exp(x) = exp(x)
    let e = exp_f64(a.val)
    return Dual { val: e, dot: a.dot * e }
}

fn dual_ln(a: Dual) -> Dual with Mut, Div, Panic {
    // d/dx ln(x) = 1/x
    return Dual { val: ln_f64(a.val), dot: a.dot / a.val }
}

fn dual_pow(a: Dual, n: f64) -> Dual with Mut, Div, Panic {
    // d/dx x^n = n * x^(n-1)
    let v = pow_f64(a.val, n)
    return Dual { val: v, dot: a.dot * n * pow_f64(a.val, n - 1.0) }
}

fn dual_sin(a: Dual) -> Dual with Mut, Div, Panic {
    // d/dx sin(x) = cos(x)
    return Dual { val: sin_f64(a.val), dot: a.dot * cos_f64(a.val) }
}

fn dual_cos(a: Dual) -> Dual with Mut, Div, Panic {
    // d/dx cos(x) = -sin(x)
    return Dual { val: cos_f64(a.val), dot: 0.0 - a.dot * sin_f64(a.val) }
}

fn dual_tan(a: Dual) -> Dual with Mut, Div, Panic {
    // d/dx tan(x) = sec²(x) = 1/cos²(x)
    let c = cos_f64(a.val)
    return Dual { val: sin_f64(a.val) / c, dot: a.dot / (c * c) }
}

fn dual_sigmoid(a: Dual) -> Dual with Mut, Div, Panic {
    // sigmoid(x) = 1 / (1 + exp(-x))
    // d/dx sigmoid(x) = sigmoid(x) * (1 - sigmoid(x))
    let s = 1.0 / (1.0 + exp_f64(0.0 - a.val))
    return Dual { val: s, dot: a.dot * s * (1.0 - s) }
}

fn dual_relu(a: Dual) -> Dual with Mut, Div, Panic {
    // ReLU(x) = max(0, x)
    // d/dx ReLU(x) = 1 if x > 0, else 0
    if a.val > 0.0 {
        return Dual { val: a.val, dot: a.dot }
    }
    return Dual { val: 0.0, dot: 0.0 }
}

fn dual_abs(a: Dual) -> Dual with Mut, Div, Panic {
    // d/dx |x| = sign(x)
    return Dual { val: abs_f64(a.val), dot: a.dot * signum_f64(a.val) }
}

fn dual_max(a: Dual, b: Dual) -> Dual {
    if a.val >= b.val {
        return a
    }
    return b
}

fn dual_min(a: Dual, b: Dual) -> Dual {
    if a.val <= b.val {
        return a
    }
    return b
}

// ============================================================================
// DUAL VECTOR (for multi-variable functions)
// ============================================================================

struct DualVec3 {
    x: Dual,
    y: Dual,
    z: Dual
}

fn dualvec3_new(x: Dual, y: Dual, z: Dual) -> DualVec3 {
    return DualVec3 { x: x, y: y, z: z }
}

fn dualvec3_const(x: f64, y: f64, z: f64) -> DualVec3 {
    return DualVec3 {
        x: dual_const(x),
        y: dual_const(y),
        z: dual_const(z)
    }
}

// Create with i-th component as the variable (for gradient computation)
fn dualvec3_var_i(x: f64, y: f64, z: f64, i: i64) -> DualVec3 {
    if i == 0 {
        return DualVec3 { x: dual_var(x), y: dual_const(y), z: dual_const(z) }
    }
    if i == 1 {
        return DualVec3 { x: dual_const(x), y: dual_var(y), z: dual_const(z) }
    }
    return DualVec3 { x: dual_const(x), y: dual_const(y), z: dual_var(z) }
}

fn dualvec3_add(a: DualVec3, b: DualVec3) -> DualVec3 {
    return DualVec3 {
        x: dual_add(a.x, b.x),
        y: dual_add(a.y, b.y),
        z: dual_add(a.z, b.z)
    }
}

fn dualvec3_scale(v: DualVec3, s: Dual) -> DualVec3 with Mut, Div, Panic {
    return DualVec3 {
        x: dual_mul(v.x, s),
        y: dual_mul(v.y, s),
        z: dual_mul(v.z, s)
    }
}

fn dualvec3_dot(a: DualVec3, b: DualVec3) -> Dual with Mut, Div, Panic {
    return dual_add(dual_add(dual_mul(a.x, b.x), dual_mul(a.y, b.y)), dual_mul(a.z, b.z))
}

fn dualvec3_norm(v: DualVec3) -> Dual with Mut, Div, Panic {
    return dual_sqrt(dualvec3_dot(v, v))
}

// ============================================================================
// CONVENIENCE ALIASES (for example files and user code)
// ============================================================================

// dual(val, dot) — constructor alias for dual_new
fn dual(val: f64, dot: f64) -> Dual {
    return Dual { val: val, dot: dot }
}

// dual_value(d) — extract primal value
fn dual_value(d: Dual) -> f64 {
    return d.val
}

// dual_deriv(d) — extract tangent (derivative)
fn dual_deriv(d: Dual) -> f64 {
    return d.dot
}

// dual_log — natural log alias for dual_ln
fn dual_log(a: Dual) -> Dual with Mut, Div, Panic {
    return dual_ln(a)
}

// ============================================================================
// ADDITIONAL MATHEMATICAL FUNCTIONS
// ============================================================================

// Arctangent scalar helper using Taylor series with range reduction
fn atan_f64(x: f64) -> f64 with Mut, Div, Panic {
    let pi = 3.141592653589793
    if x < 0.0 { return 0.0 - atan_f64(0.0 - x) }
    // For large x: atan(x) = pi/2 - atan(1/x)
    if x > 2.0 { return pi / 2.0 - atan_f64(1.0 / x) }
    // For x in (0.5, 2]: atan(x) = pi/4 + atan((x-1)/(x+1))
    if x > 0.5 {
        let y = (x - 1.0) / (x + 1.0)
        let y2 = y * y
        var sum = y
        var term = y
        term = term * (0.0 - y2); sum = sum + term / 3.0
        term = term * (0.0 - y2); sum = sum + term / 5.0
        term = term * (0.0 - y2); sum = sum + term / 7.0
        term = term * (0.0 - y2); sum = sum + term / 9.0
        term = term * (0.0 - y2); sum = sum + term / 11.0
        term = term * (0.0 - y2); sum = sum + term / 13.0
        term = term * (0.0 - y2); sum = sum + term / 15.0
        term = term * (0.0 - y2); sum = sum + term / 17.0
        term = term * (0.0 - y2); sum = sum + term / 19.0
        return pi / 4.0 + sum
    }
    // For small x: direct Taylor series converges well
    let x2 = x * x
    var sum = x
    var term = x
    term = term * (0.0 - x2); sum = sum + term / 3.0
    term = term * (0.0 - x2); sum = sum + term / 5.0
    term = term * (0.0 - x2); sum = sum + term / 7.0
    term = term * (0.0 - x2); sum = sum + term / 9.0
    term = term * (0.0 - x2); sum = sum + term / 11.0
    term = term * (0.0 - x2); sum = sum + term / 13.0
    term = term * (0.0 - x2); sum = sum + term / 15.0
    term = term * (0.0 - x2); sum = sum + term / 17.0
    term = term * (0.0 - x2); sum = sum + term / 19.0
    term = term * (0.0 - x2); sum = sum + term / 21.0
    return sum
}

// Arcsin scalar helper: asin(x) = atan(x / sqrt(1 - x^2))
fn asin_f64(x: f64) -> f64 with Mut, Div, Panic {
    let denom = sqrt_f64(1.0 - x * x)
    if denom < 0.000001 {
        let pi = 3.141592653589793
        if x > 0.0 { return pi / 2.0 }
        return 0.0 - pi / 2.0
    }
    return atan_f64(x / denom)
}

// Arccos scalar helper: acos(x) = pi/2 - asin(x)
fn acos_f64(x: f64) -> f64 with Mut, Div, Panic {
    let pi = 3.141592653589793
    return pi / 2.0 - asin_f64(x)
}

// Sinh scalar: (exp(x) - exp(-x)) / 2
fn sinh_f64(x: f64) -> f64 with Mut, Div, Panic {
    return (exp_f64(x) - exp_f64(0.0 - x)) / 2.0
}

// Cosh scalar: (exp(x) + exp(-x)) / 2
fn cosh_f64(x: f64) -> f64 with Mut, Div, Panic {
    return (exp_f64(x) + exp_f64(0.0 - x)) / 2.0
}

// Asinh scalar: ln(x + sqrt(x^2 + 1))
fn asinh_f64(x: f64) -> f64 with Mut, Div, Panic {
    return ln_f64(x + sqrt_f64(x * x + 1.0))
}

// Acosh scalar: ln(x + sqrt(x^2 - 1)), x >= 1
fn acosh_f64(x: f64) -> f64 with Mut, Div, Panic {
    if x < 1.0 { return 0.0 }
    return ln_f64(x + sqrt_f64(x * x - 1.0))
}

// Atanh scalar: (ln(1+x) - ln(1-x)) / 2, |x| < 1
fn atanh_f64(x: f64) -> f64 with Mut, Div, Panic {
    return (ln_f64(1.0 + x) - ln_f64(1.0 - x)) / 2.0
}

// Atan2 scalar: full-quadrant arctan(y, x)
fn atan2_f64(y: f64, x: f64) -> f64 with Mut, Div, Panic {
    let pi = 3.141592653589793
    if x > 0.0 { return atan_f64(y / x) }
    if x < 0.0 && y >= 0.0 { return atan_f64(y / x) + pi }
    if x < 0.0 && y < 0.0 { return atan_f64(y / x) - pi }
    if x == 0.0 && y > 0.0 { return pi / 2.0 }
    if x == 0.0 && y < 0.0 { return 0.0 - pi / 2.0 }
    return 0.0
}

// d/dx atan(x) = 1 / (1 + x^2)
fn dual_atan(a: Dual) -> Dual with Mut, Div, Panic {
    return Dual { val: atan_f64(a.val), dot: a.dot / (1.0 + a.val * a.val) }
}

// d/dx asin(x) = 1 / sqrt(1 - x^2)
fn dual_asin(a: Dual) -> Dual with Mut, Div, Panic {
    let denom = sqrt_f64(1.0 - a.val * a.val)
    return Dual { val: asin_f64(a.val), dot: a.dot / denom }
}

// d/dx acos(x) = -1 / sqrt(1 - x^2)
fn dual_acos(a: Dual) -> Dual with Mut, Div, Panic {
    let denom = sqrt_f64(1.0 - a.val * a.val)
    return Dual { val: acos_f64(a.val), dot: 0.0 - a.dot / denom }
}

// d/dx sinh(x) = cosh(x)
fn dual_sinh(a: Dual) -> Dual with Mut, Div, Panic {
    return Dual { val: sinh_f64(a.val), dot: a.dot * cosh_f64(a.val) }
}

// d/dx cosh(x) = sinh(x)
fn dual_cosh(a: Dual) -> Dual with Mut, Div, Panic {
    return Dual { val: cosh_f64(a.val), dot: a.dot * sinh_f64(a.val) }
}

// d/dx asinh(x) = 1 / sqrt(x^2 + 1)
fn dual_asinh(a: Dual) -> Dual with Mut, Div, Panic {
    let denom = sqrt_f64(a.val * a.val + 1.0)
    return Dual { val: asinh_f64(a.val), dot: a.dot / denom }
}

// d/dx acosh(x) = 1 / sqrt(x^2 - 1), x > 1
fn dual_acosh(a: Dual) -> Dual with Mut, Div, Panic {
    let denom = sqrt_f64(a.val * a.val - 1.0)
    return Dual { val: acosh_f64(a.val), dot: a.dot / denom }
}

// d/dx atanh(x) = 1 / (1 - x^2), |x| < 1
fn dual_atanh(a: Dual) -> Dual with Mut, Div, Panic {
    let denom = 1.0 - a.val * a.val
    return Dual { val: atanh_f64(a.val), dot: a.dot / denom }
}

// d/dx log2(x) = 1 / (x * ln(2))
fn dual_log2(a: Dual) -> Dual with Mut, Div, Panic {
    let ln2 = 0.6931471805599453
    return Dual { val: ln_f64(a.val) / ln2, dot: a.dot / (a.val * ln2) }
}

// d/dx log10(x) = 1 / (x * ln(10))
fn dual_log10(a: Dual) -> Dual with Mut, Div, Panic {
    let ln10 = 2.302585092994046
    return Dual { val: ln_f64(a.val) / ln10, dot: a.dot / (a.val * ln10) }
}

// atan2(y, x) dual — tangent with directional derivative
// d(atan2)/dt = (x*dy/dt - y*dx/dt) / (x^2 + y^2)
fn dual_atan2(y: Dual, x: Dual) -> Dual with Mut, Div, Panic {
    let r2 = x.val * x.val + y.val * y.val
    let dot = (x.val * y.dot - y.val * x.dot) / r2
    return Dual { val: atan2_f64(y.val, x.val), dot: dot }
}

// ============================================================================
// HIGH-LEVEL INTERFACE
// ============================================================================

// Gradient result for scalar function f: R -> R
struct GradResult {
    val: f64,    // f(x)
    deriv: f64   // f'(x)
}

// grad_scalar(f_at_dual_var_result) — extract gradient from a dual computation
// Usage: let d = f(dual_var(x)); let g = GradResult { val: d.val, deriv: d.dot }

// dual_diff: compute derivative of a function at a point using forward-mode AD
// The function f must accept a Dual and return a Dual
// Since Sounio lacks higher-order fn types yet, this documents the pattern:
//   let x_d = dual_var(x)
//   let y_d = f(x_d)
//   let deriv = y_d.dot

// ============================================================================
// TESTS
