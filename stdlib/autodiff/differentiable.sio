// Sprint 24 Track A: Differentiable Programming stdlib
// References: Elliott ICFP 2018, Huot et al. LICS 2020

fn smooth_composition_class(k1: i64, k2: i64) -> i64 {
    // Chain rule: C^k1 composed with C^k2 = C^min(k1, k2)
    if k1 == -1 && k2 == -1 { return -1 }
    if k1 == -1 { return k2 }
    if k2 == -1 { return k1 }
    if k1 < k2 { k1 } else { k2 }
}

fn jacobian_fwd_passes(n: i64) -> i64 {
    // Forward-mode: n JVPs for full Jacobian of f: R^n -> R^m
    n
}

fn langevin_step(x: f64, grad_f: f64, eta: f64, temp: f64, noise: f64) -> f64 {
    // Langevin MCMC step: x_{t+1} = x_t - eta*grad_f(x_t) + sqrt(2*eta*T) * noise
    let step_size: f64 = eta * grad_f
    let diffusion_coeff: f64 = 2.0 * eta * temp
    x - step_size + noise * diffusion_coeff
}

fn sgd_as_langevin_sigma(learning_rate: f64, temperature: f64) -> f64 {
    // Diffusion coefficient for Langevin: sigma^2 = 2 * lr * T
    2.0 * learning_rate * temperature
}
