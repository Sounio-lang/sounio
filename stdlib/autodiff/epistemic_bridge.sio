// stdlib/autodiff/epistemic_bridge — Bridge between EpistemicDual and GUM uncertainty
//
// Connects forward-mode AD uncertainty tracking (EpistemicDual) with the
// GUM measurement uncertainty framework (GUMUncertainty, GUMResult).
//
// Math foundation: GUM §5.1 Law of Propagation of Uncertainty
// u(y) = |∂f/∂x| · u(x)  for y = f(x)
//
// References:
// - JCGM 100:2008 (GUM), §5.1
// - Griewank & Walther, "Evaluating Derivatives" (2008)
// - Taylor, "An Introduction to Error Analysis" (1997)

use epistemic::gum::{GUMUncertainty, GUMResult, k_normal_95}
use autodiff::epistemic_dual::EpistemicDual

// =============================================================================
// Local math helpers (no stdlib import needed)
// =============================================================================

fn bridge_abs(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn bridge_sqrt(x: f64) -> f64 {
    if x <= 0.0 { return 0.0 }
    var y = x
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    return y
}

// =============================================================================
// Bridge Functions
// =============================================================================

/// Convert an EpistemicDual (after a forward AD pass) to a GUMUncertainty.
/// The output uncertainty is |dot| * unc via the chain rule (GUM §5.1).
///
/// Math: u(y) = |∂f/∂x| · u(x) = |dot| · unc
/// The sensitivity coefficient is set to dot (the computed derivative).
pub fn edual_to_gum_uncertainty(d: EpistemicDual) -> GUMUncertainty {
    let std_unc = bridge_abs(d.dot) * d.unc
    GUMUncertainty {
        std_uncertainty: std_unc,
        degrees_of_freedom: 1.0e9,
        sensitivity: d.dot,
    }
}

/// Convert a GUMUncertainty to an EpistemicDual for use as an AD input.
/// Value is provided externally; dot = sensitivity; unc = std_uncertainty.
///
/// This allows a GUM-characterised input to seed a forward AD computation.
pub fn gum_to_edual(val: f64, u: GUMUncertainty) -> EpistemicDual {
    EpistemicDual {
        val: val,
        dot: u.sensitivity,
        unc: u.std_uncertainty,
        unc_dot: 0.0,
    }
}

/// Convert a GUMResult to an EpistemicDual.
/// dot is set to 1.0 (neutral sensitivity); unc = std_uncertainty.
pub fn gum_result_to_edual(r: GUMResult) -> EpistemicDual {
    EpistemicDual {
        val: r.value,
        dot: 1.0,
        unc: r.std_uncertainty,
        unc_dot: 0.0,
    }
}

/// Convert an EpistemicDual (output of AD computation) to a GUMResult.
/// Applies GUM §5.1: u(y) = |dot| * unc.
/// dof: degrees of freedom (use 1e9 for Type B / infinite).
pub fn edual_to_gum_result(d: EpistemicDual, dof: f64) -> GUMResult with Div, Panic {
    let std_unc = bridge_abs(d.dot) * d.unc
    let k = k_normal_95()
    GUMResult {
        value: d.val,
        std_uncertainty: std_unc,
        degrees_of_freedom: dof,
        coverage_factor_95: k,
        expanded_uncertainty_95: k * std_unc,
    }
}

/// Compose two GUM propagation steps through an AD computation, under a declared correlation.
///
/// 🚨 A versão anterior desta função aplicava quadratura INCONDICIONALMENTE, e a própria
/// documentação dela dizia "when inputs are independent (GUM §5.1.2)" — enunciava a
/// pré-condição e não a exigia. Nenhum chamador jamais provou independência.
///
/// A fórmula completa do GUM §5.2 é u_c = sqrt(u1² + u2² + 2·ρ·u1·u2). Quadratura é ela com
/// ρ = 0; a soma aditiva é ela com ρ = 1 (Cauchy–Schwarz). São o mesmo teorema em dois pontos,
/// e assumir ρ = 0 em silêncio é publicar um limite mais apertado que a verdade.
pub fn edual_combine_gum_rho(d1: EpistemicDual, d2: EpistemicDual, rho: f64) -> GUMUncertainty with Div, Panic {
    let u1 = bridge_abs(d1.dot) * d1.unc
    let u2 = bridge_abs(d2.dot) * d2.unc
    let sum_sq = u1 * u1 + u2 * u2 + 2.0 * rho * u1 * u2
    let combined = bridge_sqrt(sum_sq)
    // Effective sensitivity: magnitude of combined gradient direction
    let sens = bridge_sqrt(d1.dot * d1.dot + d2.dot * d2.dot)
    GUMUncertainty {
        std_uncertainty: combined,
        degrees_of_freedom: 1.0e9,
        sensitivity: sens,
    }
}

/// Composição sob INDEPENDÊNCIA PROVADA (ρ = 0). Só use quando houver testemunha — em geral,
/// `cat_d_separated` sobre o grafo causal do problema. Existe separada, e com nome explícito,
/// para que a alegação seja grepável:
///   grep -rn "edual_combine_gum_independent" --include=*.sio
pub fn edual_combine_gum_independent(d1: EpistemicDual, d2: EpistemicDual) -> GUMUncertainty with Div, Panic {
    edual_combine_gum_rho(d1, d2, 0.0)
}

/// Compatibilidade de assinatura, semântica INVERTIDA de propósito: sem ρ declarado, o padrão é
/// o PIOR CASO (ρ = 1), não a quadratura. Todo número que afrouxa ao adotar esta versão é um
/// lugar onde o sistema vinha mentindo para baixo.
pub fn edual_combine_gum(d1: EpistemicDual, d2: EpistemicDual) -> GUMUncertainty with Div, Panic {
    edual_combine_gum_rho(d1, d2, 1.0)
}
