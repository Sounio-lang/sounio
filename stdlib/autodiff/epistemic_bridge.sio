// stdlib/autodiff/epistemic_bridge — Bridge between EpistemicDual and GUM uncertainty
//
// Connects forward-mode AD uncertainty tracking (EpistemicDual) with the
// GUM measurement uncertainty framework (GUMUncertainty, GUMResult).
//
// Math foundation: GUM §5.1 Law of Propagation of Uncertainty
// u(y) = |∂f/∂x| · u(x)  for y = f(x)
//
// References:
// - JCGM 100:2008 (GUM), §5.1
// - Griewank & Walther, "Evaluating Derivatives" (2008)
// - Taylor, "An Introduction to Error Analysis" (1997)

use epistemic::gum::{GUMUncertainty, GUMResult, k_normal_95}
use autodiff::epistemic_dual::*

// =============================================================================
// Local math helpers (no stdlib import needed)
// =============================================================================

fn bridge_abs(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn bridge_sqrt(x: f64) -> f64 with Mut, Div {
    if x <= 0.0 { return 0.0 }
    var y = x
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    return y
}

// =============================================================================
// Bridge Functions
// =============================================================================

/// Convert an EpistemicDual (after a forward AD pass) to a GUMUncertainty.
/// The output uncertainty is |dot| * unc via the chain rule (GUM §5.1).
///
/// Math: u(y) = |∂f/∂x| · u(x) = |dot| · unc
/// The sensitivity coefficient is set to dot (the computed derivative).
pub fn edual_to_gum_uncertainty(d: EpistemicDual) -> GUMUncertainty {
    let std_unc = bridge_abs(d.dot) * d.unc
    GUMUncertainty {
        std_uncertainty: std_unc,
        degrees_of_freedom: 1.0e9,
        sensitivity: d.dot,
    }
}

/// Convert a GUMUncertainty to an EpistemicDual for use as an AD input.
/// Value is provided externally; dot = sensitivity; unc = std_uncertainty.
///
/// This allows a GUM-characterised input to seed a forward AD computation.
pub fn gum_to_edual(val: f64, u: GUMUncertainty) -> EpistemicDual {
    EpistemicDual {
        val: val,
        dot: u.sensitivity,
        unc: u.std_uncertainty,
        unc_dot: 0.0,
    }
}

/// Convert a GUMResult to an EpistemicDual.
/// dot is set to 1.0 (neutral sensitivity); unc = std_uncertainty.
pub fn gum_result_to_edual(r: GUMResult) -> EpistemicDual {
    EpistemicDual {
        val: r.value,
        dot: 1.0,
        unc: r.std_uncertainty,
        unc_dot: 0.0,
    }
}

/// Convert an EpistemicDual (output of AD computation) to a GUMResult.
/// Applies GUM §5.1: u(y) = |dot| * unc.
/// dof: degrees of freedom (use 1e9 for Type B / infinite).
pub fn edual_to_gum_result(d: EpistemicDual, dof: f64) -> GUMResult with Mut, Div, Panic {
    let std_unc = bridge_abs(d.dot) * d.unc
    let k = k_normal_95()
    GUMResult {
        value: d.val,
        std_uncertainty: std_unc,
        degrees_of_freedom: dof,
        coverage_factor_95: k,
        expanded_uncertainty_95: k * std_unc,
    }
}

/// Compose two independent GUM propagation steps through an AD computation.
/// u_combined = sqrt(u1^2 + u2^2) when inputs are independent (GUM §5.1.2).
///
/// Each dual carries: output_unc_i = |dot_i| * unc_i
/// Combined: u_c = sqrt(sum of (|dot_i| * unc_i)^2)
pub fn edual_combine_gum(d1: EpistemicDual, d2: EpistemicDual) -> GUMUncertainty with Mut, Div, Panic {
    let u1 = bridge_abs(d1.dot) * d1.unc
    let u2 = bridge_abs(d2.dot) * d2.unc
    let combined = bridge_sqrt(u1 * u1 + u2 * u2)
    // Effective sensitivity: magnitude of combined gradient direction
    let sens = bridge_sqrt(d1.dot * d1.dot + d2.dot * d2.dot)
    GUMUncertainty {
        std_uncertainty: combined,
        degrees_of_freedom: 1.0e9,
        sensitivity: sens,
    }
}
