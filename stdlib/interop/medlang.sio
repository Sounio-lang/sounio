// interop/medlang.sio — MedLang interoperability layer
// Bridges Sounio PK/PD types to MedLang specification

struct MedLangDose {
    amount: f64,
    route: i32,       // 0=IV, 1=oral, 2=IM
    time: f64,
    duration: f64,
}

fn medlang_dose_iv(amount: f64, time: f64) -> MedLangDose {
    MedLangDose { amount: amount, route: 0, time: time, duration: 0.0 }
}

fn medlang_dose_oral(amount: f64, time: f64) -> MedLangDose {
    MedLangDose { amount: amount, route: 1, time: time, duration: 0.0 }
}

fn medlang_dose_infusion(amount: f64, time: f64, duration: f64) -> MedLangDose {
    MedLangDose { amount: amount, route: 0, time: time, duration: duration }
}

struct MedLangObservation {
    time: f64,
    dv: f64,
    cmt: i32,
    mdv: i32,
}

fn medlang_obs_new(time: f64, dv: f64, cmt: i32) -> MedLangObservation {
    MedLangObservation { time: time, dv: dv, cmt: cmt, mdv: 0 }
}

struct MedLangSubject {
    id: i32,
    weight: f64,
    age: f64,
    sex: i32,
    doses: [MedLangDose; 16],
    n_doses: i32,
    observations: [MedLangObservation; 64],
    n_obs: i32,
}

fn medlang_subject_new(id: i32, weight: f64, age: f64, sex: i32) -> MedLangSubject {
    MedLangSubject {
        id: id, weight: weight, age: age, sex: sex,
        doses: [medlang_dose_iv(0.0, 0.0); 16], n_doses: 0,
        observations: [medlang_obs_new(0.0, 0.0, 1); 64], n_obs: 0,
    }
}

fn medlang_add_dose(subj: MedLangSubject, dose: MedLangDose) -> MedLangSubject with Mut, Div, Panic {
    var result = subj
    if result.n_doses < 16 {
        result.doses[result.n_doses] = dose
        result.n_doses = result.n_doses + 1
    }
    result
}

fn medlang_add_obs(subj: MedLangSubject, obs: MedLangObservation) -> MedLangSubject with Mut, Div, Panic {
    var result = subj
    if result.n_obs < 64 {
        result.observations[result.n_obs] = obs
        result.n_obs = result.n_obs + 1
    }
    result
}

// One-compartment model evaluation
fn medlang_onecomp_conc(cl: f64, v: f64, ka: f64, dose: f64, t: f64, is_iv: bool) -> f64 with Div, Panic, Mut {
    if t <= 0.0 { return 0.0 }
    let ke = cl / v
    // exp approximation
    var exp_ke = 1.0
    var term_ke = 1.0
    let x_ke = 0.0 - ke * t
    var i = 1
    while i < 20 { term_ke = term_ke * x_ke / (i as f64); exp_ke = exp_ke + term_ke; i = i + 1 }

    if is_iv {
        (dose / v) * exp_ke
    } else {
        var exp_ka = 1.0
        var term_ka = 1.0
        let x_ka = 0.0 - ka * t
        i = 1
        while i < 20 { term_ka = term_ka * x_ka / (i as f64); exp_ka = exp_ka + term_ka; i = i + 1 }
        (dose * ka / (v * (ka - ke))) * (exp_ke - exp_ka)
    }
}

fn test_medlang_iv_bolus() -> bool with Div, Panic, Mut {
    let c = medlang_onecomp_conc(10.0, 50.0, 0.0, 500.0, 0.001, true)
    c > 9.0
}

fn test_medlang_subject() -> bool with Mut, Div, Panic {
    var subj = medlang_subject_new(1, 70.0, 45.0, 0)
    subj = medlang_add_dose(subj, medlang_dose_iv(500.0, 0.0))
    subj.n_doses == 1
}
