// stdlib/learn/batch_split.sio
//
// Integer batch shares proportional to measured throughput, largest
// remainder, so the shares sum to the total. The slow device receives
// less of the batch.

use tensor2::cpu_kernel::{CpuBuf, ck_alloc, ck_get, ck_set}

pub fn batch_shares(tp: &CpuBuf, n: i64, total: i64, out: &!CpuBuf) with Alloc, Mut, Div, Panic {
    var sum = 0.0
    var i: i64 = 0
    while i < n {
        sum = sum + ck_get(tp, i)
        i = i + 1
    }
    var frac = ck_alloc(n)
    var acc: i64 = 0
    i = 0
    while i < n {
        var exact = 0.0
        if sum > 0.0 { exact = ck_get(tp, i) / sum * (total as f64) }
        let base = exact as i64
        ck_set(out, i, base as f64)
        ck_set(&!frac, i, exact - (base as f64))
        acc = acc + base
        i = i + 1
    }
    var left = total - acc
    while left > 0 {
        var best: i64 = 0
        var bestv = 0.0 - 1.0
        var j: i64 = 0
        while j < n {
            let f = ck_get(&frac, j)
            if f > bestv { bestv = f; best = j }
            j = j + 1
        }
        let cur = ck_get(out, best)
        ck_set(out, best, cur + 1.0)
        ck_set(&!frac, best, 0.0)
        left = left - 1
    }
}
