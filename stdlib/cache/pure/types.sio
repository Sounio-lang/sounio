// stdlib/cache/pure/types.sio — Cache Types
//
// Fixed-capacity key-value cache.

module cache::pure::types

fn cache_miss() -> i64 {
    let z: i64 = 0
    z - 1
}

pub struct LruCache {
    pub n_entries: i32,
    pub keys: [string; 64],
    pub values: [i64; 64],
    pub valid: [bool; 64],
}

pub fn cache_new() -> LruCache {
    LruCache { n_entries: 0, keys: [""; 64], values: [0; 64], valid: [false; 64] }
}

pub fn cache_get(c: &LruCache, key: string) -> i64 with Mut {
    var i: i32 = 0
    while i < c.n_entries {
        if c.keys[i as usize] == key && c.valid[i as usize] {
            return c.values[i as usize]
        }
        i = i + 1
    }
    cache_miss()
}

pub fn cache_put(c: &!LruCache, key: string, value: i64) with Mut {
    var i: i32 = 0
    while i < c.n_entries {
        if c.keys[i as usize] == key {
            c.values[i as usize] = value
            c.valid[i as usize] = true
            return
        }
        i = i + 1
    }
    if c.n_entries < 64 as i32 {
        let idx = c.n_entries as usize
        c.keys[idx] = key
        c.values[idx] = value
        c.valid[idx] = true
        c.n_entries = c.n_entries + 1
    }
}

pub fn cache_size(c: &LruCache) -> i32 { c.n_entries }