// stdlib/string/string.sio
// UTF-8 string utilities using fixed byte arrays
//
// Sounio strings are fixed-size byte buffers.

// Check if byte is a UTF-8 continuation byte
fn str_is_continuation(b: u8) -> i64 {
    if (b as i64) >= 128 {
        if (b as i64) < 192 { return 1 }
    }
    return 0
}

// Count UTF-8 characters in a byte buffer
fn str_char_count(buf: [u8; 256], byte_len: i64) -> i64 {
    var count: i64 = 0
    var i: i64 = 0
    while i < byte_len {
        if str_is_continuation(buf[i]) == 0 {
            count = count + 1
        }
        i = i + 1
    }
    return count
}

// Compare two byte buffers for equality
fn str_eq(a: [u8; 256], a_len: i64, b: [u8; 256], b_len: i64) -> i64 {
    if a_len != b_len { return 0 }
    var i: i64 = 0
    while i < a_len {
        if a[i] != b[i] { return 0 }
        i = i + 1
    }
    return 1
}

// Check if buffer starts with prefix
fn str_starts_with(buf: [u8; 256], buf_len: i64, prefix: [u8; 256], prefix_len: i64) -> i64 {
    if prefix_len > buf_len { return 0 }
    var i: i64 = 0
    while i < prefix_len {
        if buf[i] != prefix[i] { return 0 }
        i = i + 1
    }
    return 1
}

// Find first occurrence of a single byte in buffer
// Returns index or -1 if not found
fn str_find_byte(buf: [u8; 256], buf_len: i64, needle: u8) -> i64 {
    var i: i64 = 0
    while i < buf_len {
        if buf[i] == needle { return i }
        i = i + 1
    }
    return 0 - 1
}

// Trim leading ASCII whitespace, returns new start index
fn str_trim_start(buf: [u8; 256], buf_len: i64) -> i64 {
    var i: i64 = 0
    while i < buf_len {
        let b = buf[i] as i64
        if b != 32 {
            if b != 9 {
                if b != 10 {
                    if b != 13 { return i }
                }
            }
        }
        i = i + 1
    }
    return buf_len
}

// Trim trailing ASCII whitespace, returns new end index
fn str_trim_end(buf: [u8; 256], buf_len: i64) -> i64 {
    var end = buf_len
    while end > 0 {
        let b = buf[end - 1] as i64
        if b != 32 {
            if b != 9 {
                if b != 10 {
                    if b != 13 { return end }
                }
            }
        }
        end = end - 1
    }
    return 0
}

// Convert ASCII lowercase letter to uppercase (single byte)
fn str_to_upper_byte(b: u8) -> u8 {
    let v = b as i64
    if v >= 97 {
        if v <= 122 { return (v - 32) as u8 }
    }
    return b
}

// Convert ASCII uppercase letter to lowercase (single byte)
fn str_to_lower_byte(b: u8) -> u8 {
    let v = b as i64
    if v >= 65 {
        if v <= 90 { return (v + 32) as u8 }
    }
    return b
}
