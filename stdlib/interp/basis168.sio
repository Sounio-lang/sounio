// stdlib/interp/basis168.sio
//
// The canonical 168-class basis of Sounio's Algebraic Mechanistic
// Interpretability (AMI).
//
// Paper B (SounioZeroDivisorBridge.lean) proves that the sedenion
// algebra 𝕊 has exactly 168 projective (unordered) zero-divisor classes
// and 336 ordered ZD pairs, arranged into a 4-regular graph over
// 84 two-support primitive elements.  The 168 classes partition the
// ZD structure exactly, and — crucially for AMI — they form a FIXED
// BASIS that is independent of any trained model.
//
// This means: unlike SAEs (Sparse Autoencoders) or transcoders, which
// discover interpretability bases empirically on each new checkpoint,
// the AMI basis is determined a priori by the algebraic structure.
// Interpretability becomes a projection, not a discovery.
//
// Each of the 168 classes corresponds to an unordered pair {u, v} of
// sedenion primitives with u·v = 0.  For each class we emit:
//   - class_index : i64 (0..167)
//   - fiber       : i64 (0..6, the Fano-fibre tag = u.lo XOR u.hi)
//   - position    : i64 (0..23, the ordinal of the class within its fibre)
//
// The 168 = 7 × 24 decomposition: 7 Fano fibres × 24 classes per fibre.
//
// This file provides helpers to enumerate the basis classes and map
// activations to their 168-coefficient decomposition.  The full Lean
// completeness theorem is in formal/lean4/SounioInterpBasis.lean.

// N_CLASSES: total number of projective ZD classes.
let N_CLASSES: i64 = 168

// N_FIBERS: number of Fano fibres in the 168-graph decomposition.
let N_FIBERS: i64 = 7

// N_PER_FIBER: classes per fibre (168 / 7).
let N_PER_FIBER: i64 = 24

// class_fiber: maps a class index (0..167) to its Fano fibre (0..6).
// The Sedenion algebra's Fano-like 7-colouring is the XOR label of the
// two components' supports (verified in SounioZeroDivisorBridge.lean).
fn class_fiber(class_idx: i64) -> i64 with Mut, Div, Panic, ZD {
    class_idx / N_PER_FIBER
}

// class_position: ordinal position within the fibre (0..23).
fn class_position(class_idx: i64) -> i64 with Mut, Div, Panic, ZD {
    class_idx % N_PER_FIBER
}

// fiber_of: the non-trivial fibre tags (1..7) used by the ZD graph.
// Fibre 0 is reserved for the identity element; the seven non-trivial
// fibres correspond to the 7 lines of the Fano plane in the standard
// octonion/sedenion multiplication table.
fn fiber_tag(fiber_idx: i64) -> i64 with Mut, Div, Panic, ZD {
    fiber_idx + 1
}

// class_exists: sanity check that an index refers to a valid class.
fn class_exists(class_idx: i64) -> bool with Mut, Panic, ZD {
    class_idx >= 0 && class_idx < N_CLASSES
}

// total_classes: expose N_CLASSES through a function (for callers that
// want the effect-typed guarantee).
fn total_classes() -> i64 with Mut, ZD { N_CLASSES }
