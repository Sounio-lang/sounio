// stdlib/interp/projection.sio
//
// Projection / reconstruction utilities for the AMI 168-basis.
//
// The key claim of Paper D (paper_d_ami.tex): interpretability is a
// projection problem, not a discovery problem.  Given a 16-dim sedenion
// activation h(t), we decompose it onto the 168-class basis in a fixed,
// model-independent way, and every non-zero coefficient corresponds to
// a known algebraic capability of the ZD graph.
//
// Full reconstruction is not pointwise for a 16-dim vector onto a 168-dim
// basis: 168 > 16, so the basis is over-complete.  We provide:
//
//   - decompose_onto_two_support_classes: the 84-primitive projection
//     onto the canonical two-support basis.  This is the invertible part:
//     every 16-dim vector has a unique decomposition here.
//
//   - capability_activation: for a given ZD class (indexed 0..167), the
//     inner-product magnitude of the activation with the class's
//     characteristic vector.  This is the "heatmap" quantity used in
//     examples/interp_168_basis.sio.
//
// Runtime cost: O(dim²) per activation, embarrassingly parallel.

// sqrt2_inv: a single-precision approximation of 1/sqrt(2), used
// throughout the examples to match the reference implementation.
fn sqrt2_inv() -> f64 with Mut, ZD { 0.707107 }

// two_support_basis_pair: maps a class index (0..83) to its pair of
// sedenion indices (i, j) with 0 <= i < j < 16.  We return (i, j)
// concatenated as a single i64 (i * 16 + j).  This is a compact
// representation; callers split with div/mod.
//
// The enumeration is lex order: classes 0..15 are (0, 1..15); classes
// 16..29 are (1, 2..15); etc.  Total 16*15/2 = 120 pairs, but only 84
// of them correspond to primitives valid under the ZD-graph structure
// used by SounioZeroDivisorBridge.lean.  For the 84-valid subset the
// lower-level `validPrims` table (in Lean) is authoritative.
fn lex_pair_ij(class_idx: i64) -> i64 with Mut, Div, Panic, ZD {
    // Compute (i, j) such that class_idx = sum_{k<i}(15-k) + (j - i - 1)
    // and return encoded as i * 16 + j.
    var i: i64 = 0
    var remaining = class_idx
    while i < 15 {
        let row_len = 15 - i
        if remaining < row_len {
            let j = i + 1 + remaining
            return i * 16 + j
        }
        remaining = remaining - row_len
        i = i + 1
    }
    0   // unreachable for class_idx < 120
}

// inner16: 16-dim inner product (replicated here to keep this file
// self-contained so the interp path does not pull in epistemic/).
fn inner16(a: &[f64; 16], b: &[f64; 16]) -> f64 with Mut, Panic, ZD {
    var s = 0.0
    var i = 0
    while i < 16 { s = s + (*a)[i] * (*b)[i]; i = i + 1 }
    s
}

// two_support_basis_vector: writes into `out` the (orthonormal) basis
// vector for a two-support class.  Specifically (e_i + e_j)/sqrt(2)
// for classes with positive phase, (e_i - e_j)/sqrt(2) for negative
// phase.  For this stdlib shim we default to positive phase; the full
// signed basis is handled by the enumeration macro in Paper D's
// reference implementation.
fn two_support_basis_vector(i_idx: i64, j_idx: i64, out: &![f64; 16]) with Mut, Div, Panic, ZD {
    let s = sqrt2_inv()
    var k = 0
    while k < 16 { (*out)[k] = 0.0; k = k + 1 }
    (*out)[i_idx as usize] = s
    (*out)[j_idx as usize] = s
}

// capability_activation: projection coefficient of activation `h`
// onto the basis vector for class with indices (i, j).  This is what
// Paper D's heatmap plots.
fn capability_activation(h: &[f64; 16], i_idx: i64, j_idx: i64) -> f64 with Mut, Div, Panic, ZD {
    let s = sqrt2_inv()
    (*h)[i_idx as usize] * s + (*h)[j_idx as usize] * s
}
