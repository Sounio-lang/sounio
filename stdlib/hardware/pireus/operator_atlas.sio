//! eisa_h.pireus_operator_atlas.v1 -- the Sounio novelty classifier for Pireus
//! kind=2 operator proposals.
//!
//! An operator is a 16x16 sign table over F2^4 graded by XOR:
//! e_i * e_j = (-1)^signs[i*16+j] e_(i XOR j). The atlas is the frozen V13 class
//! set (tools/pireus/operator_orbit_canonicalization.freeze.v13, semantics
//! 0a4b2c35...): 30 baseline classes plus 32 admitted classes = 62, under
//! GL(4,F2) x input swap x all 2048 basis-fixed sign gauges. Canonical forms
//! come from the unchanged V13 canonicalizer (pireus_operator_orbit_canonical_view).
//!
//! The V13 classes were generated from cubic-forge children; none of them is
//! the sedenion. Without a reference for the parent algebra, phase 0 (the
//! sedenions themselves) would leave the atlas as "N2". The atlas therefore
//! also carries the three members of the frozen V1 GL4 corpus
//! (GARDEN_PIREUS_OPERATOR_GENESIS_GL4_V1.md, "Corpus and search objective"):
//! untwisted XOR, live Cayley-Dickson-16 and the diagonal bicharacter
//! (-1)^parity(i AND j), as reference classes 62, 63 and 64. Adding them can
//! only move a proposal from N2 to N0/N1, never the other way.
//!
//! Ladder (relative to these 65 reference classes and this equivalence only):
//!   N0  the table is bit-identical to a reference table (a V13 canonical
//!       representative, or a corpus member's defining table);
//!   N1  the table differs, but its canonical form is a reference class;
//!   N2  the canonical form is none of the 65 reference classes (bounded
//!       relative quotient separation, V10 sense). Not algebraic, material,
//!       scientific or historical novelty, and never claim_ready.
//! H (historical priority) needs prior-art review and founder promotion; this
//! module has no way to emit it.

use algebra::cayley_dickson::cd_sigma
use hardware::pireus::operator_orbit_canonicalization::{
    PireusPocCanonicalView,
    pireus_operator_orbit_canonical_view,
}
use crypto::sha256::{
    SHA256State,
    sha256_init, sha256_update_be64, sha256_finalize, sha256_digest_byte,
}

pub const PIREUS_ATLAS_CLASSES: i64 = 62
pub const PIREUS_ATLAS_CORPUS: i64 = 3
pub const PIREUS_ATLAS_REFERENCES: i64 = 65
pub const PIREUS_ATLAS_ORIGIN_V13_BASELINE: i64 = 1
pub const PIREUS_ATLAS_ORIGIN_V13_ADMITTED: i64 = 2
pub const PIREUS_ATLAS_ORIGIN_V1_CORPUS: i64 = 3
pub const PIREUS_ATLAS_BASELINE_CLASSES: i64 = 30
pub const PIREUS_ATLAS_WORDS: i64 = 8
pub const PIREUS_ATLAS_CELLS: i64 = 256
// The V13 class-digest framing (PIREUS_POC_SCHEMA), so the first 30 classes
// hash to the class_digest in the frozen V13 baseline receipt.
pub const PIREUS_ATLAS_V13_SCHEMA: i64 = 733000

pub const PIREUS_ATLAS_N0: i64 = 0
pub const PIREUS_ATLAS_N1: i64 = 1
pub const PIREUS_ATLAS_N2: i64 = 2

pub const PIREUS_ATLAS_OK: i64 = 0
pub const PIREUS_ATLAS_ERR_DOMAIN: i64 = 1
pub const PIREUS_ATLAS_ERR_CANONICALIZATION: i64 = 2
pub const PIREUS_ATLAS_ERR_INTEGRITY: i64 = 3

pub struct PireusOperatorAtlasDigest {
    pub words: [i64; 8],
}

pub struct PireusOperatorAtlasClassification {
    pub valid: bool,
    pub error: i64,
    pub level: i64,
    pub class_id: i64,
    pub origin: i64,
    pub exact_representative: bool,
    pub words: [i64; 8],
    pub matrix: i64,
    pub swap: i64,
    pub gauge: i64,
    pub action_views: i64,
}

