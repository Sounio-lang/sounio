pub fn pireus_operator_atlas_class_word(class_id: i64, word: i64) -> i64
with Mut, Panic {
    let table = pireus_atlas_class_words()
    table[class_id * PIREUS_ATLAS_WORDS + word]
}

fn pireus_atlas_finish(state: SHA256State) -> PireusOperatorAtlasDigest
with Mut, Panic, Div, Epistemic {
    let digest = sha256_finalize(state)
    var words: [i64; 8] = [0; 8]
    var word: i64 = 0
    while word < 8 {
        var value: i64 = 0
        var byte: i64 = 0
        while byte < 4 {
            value = (value << 8) |
                sha256_digest_byte(&digest, (word * 4 + byte) as i32)
            byte = byte + 1
        }
        words[word] = value
        word = word + 1
    }
    PireusOperatorAtlasDigest { words: words }
}

// The V13 poc_digest_classes framing over the first `count` classes.
pub fn pireus_operator_atlas_class_digest(count: i64) -> PireusOperatorAtlasDigest
with Mut, Panic, Div, Epistemic {
    let table = pireus_atlas_class_words()
    var state = sha256_init()
    sha256_update_be64(&! state, PIREUS_ATLAS_V13_SCHEMA)
    sha256_update_be64(&! state, count)
    var index: i64 = 0
    while index < count * PIREUS_ATLAS_WORDS {
        sha256_update_be64(&! state, table[index])
        index = index + 1
    }
    pireus_atlas_finish(state)
}

// class_digest of PIREUS_POC_BASELINE_RECEIPT in the frozen V13 transcript.
pub fn pireus_operator_atlas_frozen_baseline_digest() -> [i64; 8] {
    [3438304597, 4027357389, 368534535, 3142349310,
     789896255, 4232357747, 2728283006, 71599997]
}

// The same framing over all 62 classes, pinned when v1 was frozen.
pub fn pireus_operator_atlas_frozen_digest() -> [i64; 8] {
    [1561567782, 1492778267, 1548016378, 1655687043,
     2603475094, 2660252682, 2876471779, 789442716]
}

fn pireus_atlas_digest_equal(left: &PireusOperatorAtlasDigest, right: &[i64; 8]) -> bool
with Mut, Panic {
    var word: i64 = 0
    while word < 8 {
        if left.words[word] != right[word] { return false }
        word = word + 1
    }
    true
}

pub fn pireus_operator_atlas_intact() -> bool with Mut, Panic, Div, Epistemic {
    let baseline = pireus_operator_atlas_class_digest(PIREUS_ATLAS_BASELINE_CLASSES)
    let full = pireus_operator_atlas_class_digest(PIREUS_ATLAS_CLASSES)
    let frozen_baseline = pireus_operator_atlas_frozen_baseline_digest()
    let frozen_full = pireus_operator_atlas_frozen_digest()
    let baseline_ok = pireus_atlas_digest_equal(&baseline, &frozen_baseline)
    let full_ok = pireus_atlas_digest_equal(&full, &frozen_full)
    baseline_ok && full_ok
}

fn pireus_atlas_bilinear(code: i64, x: i64, y: i64) -> i64 with Mut {
    var s: i64 = 0
    var i: i64 = 0
    while i < 4 {
        if ((x >> i) & 1) == 1 {
            var j: i64 = 0
            while j < 4 {
                if ((y >> j) & 1) == 1 { s = s ^ ((code >> (i * 4 + j)) & 1) }
                j = j + 1
            }
        }
        i = i + 1
    }
    s
}

// Sign bits of the admission kind=2 operator: cd_sigma twisted by i^T B j,
// with B[i][j] at bit (4*i + j) of the phase code.
pub fn pireus_operator_atlas_phase_signs(code: i64) -> [i64; 256]
with Mut, Panic, Div {
    var signs: [i64; 256] = [0; 256]
    var left: i64 = 0
    while left < 16 {
        var right: i64 = 0
        while right < 16 {
            var bit: i64 = 0
            if cd_sigma(left as i32, right as i32, 4) < 0 { bit = 1 }
            signs[left * 16 + right] = bit ^ pireus_atlas_bilinear(code, left, right)
            right = right + 1
        }
        left = left + 1
    }
    signs
}

pub fn pireus_operator_atlas_pack(signs: &[i64; 256]) -> [i64; 8]
with Mut, Panic, Div {
    var words: [i64; 8] = [0; 8]
    var cell: i64 = 0
    while cell < PIREUS_ATLAS_CELLS {
        if signs[cell] != 0 {
            let word = cell / 32
            let bit = cell - word * 32
            words[word] = words[word] | (1 << bit)
        }
        cell = cell + 1
    }
    words
}


fn pireus_atlas_parity(value: i64) -> i64 with Mut {
    var x = value
    var parity: i64 = 0
    while x != 0 {
        parity = parity ^ (x & 1)
        x = x >> 1
    }
    parity
}

// Raw sign table of V1 corpus member 0 (untwisted XOR), 1 (Cayley-Dickson-16)
// or 2 (diagonal bicharacter), from their definitions.
pub fn pireus_operator_atlas_corpus_signs(member: i64) -> [i64; 256]
with Mut, Panic, Div {
    var signs: [i64; 256] = [0; 256]
    var cell: i64 = 0
    while cell < PIREUS_ATLAS_CELLS {
        let left = cell / 16
        let right = cell - left * 16
        if member == 1 {
            if cd_sigma(left as i32, right as i32, 4) < 0 { signs[cell] = 1 }
        }
        if member == 2 { signs[cell] = pireus_atlas_parity(left & right) }
        cell = cell + 1
    }
    signs
}

// V13-canonical words of the three corpus members, pinned for v1.
// test_operator_atlas recanonicalizes the definitions above and must equal these.
fn pireus_atlas_corpus_words() -> [i64; 24] {
    [
        0, 0, 0, 0, 0, 0, 0, 0,
        1789526016, 1556888774, 3091001374, 2398145650,
        1132200446, 2131769138, 3016283074, 2400118180,
        0, 0, 0, 0, 4278255360, 4278255360, 4278255360, 4278255360
    ]
}

// Canonical words of reference class 0..64 (62 V13 classes, then the corpus).
pub fn pireus_operator_atlas_reference_word(class_id: i64, word: i64) -> i64
with Mut, Panic {
    if class_id < PIREUS_ATLAS_CLASSES {
        return pireus_operator_atlas_class_word(class_id, word)
    }
    let corpus = pireus_atlas_corpus_words()
    corpus[(class_id - PIREUS_ATLAS_CLASSES) * PIREUS_ATLAS_WORDS + word]
}

pub fn pireus_operator_atlas_origin(class_id: i64) -> i64 {
    if class_id < 0 { return 0 }
    if class_id < PIREUS_ATLAS_BASELINE_CLASSES { return PIREUS_ATLAS_ORIGIN_V13_BASELINE }
    if class_id < PIREUS_ATLAS_CLASSES { return PIREUS_ATLAS_ORIGIN_V13_ADMITTED }
    PIREUS_ATLAS_ORIGIN_V1_CORPUS
}

pub fn pireus_operator_atlas_find(words: &[i64; 8]) -> i64 with Mut, Panic {
    let table = pireus_atlas_class_words()
    var class_id: i64 = 0
    while class_id < PIREUS_ATLAS_CLASSES {
        var equal = true
        var word: i64 = 0
        while word < PIREUS_ATLAS_WORDS {
            if table[class_id * PIREUS_ATLAS_WORDS + word] != words[word] { equal = false }
            word = word + 1
        }
        if equal { return class_id }
        class_id = class_id + 1
    }
    let corpus = pireus_atlas_corpus_words()
    var member: i64 = 0
    while member < PIREUS_ATLAS_CORPUS {
        var equal = true
        var word: i64 = 0
        while word < PIREUS_ATLAS_WORDS {
            if corpus[member * PIREUS_ATLAS_WORDS + word] != words[word] { equal = false }
            word = word + 1
        }
        if equal { return PIREUS_ATLAS_CLASSES + member }
        member = member + 1
    }
    -1
}

fn pireus_atlas_refusal(error: i64) -> PireusOperatorAtlasClassification {
    PireusOperatorAtlasClassification {
        valid: false, error: error, level: -1, class_id: -1, origin: 0,
        exact_representative: false, words: [0; 8],
        matrix: 0, swap: 0, gauge: 0, action_views: 0,
    }
}

// The atlas domain is the V13 one: bits only, axis cells (row 0 and column 0)
// equal to the unit's +1, so only the 225 interior cells carry a phase.
pub fn pireus_operator_atlas_in_domain(signs: &[i64; 256]) -> bool with Mut, Panic {
    var cell: i64 = 0
    while cell < PIREUS_ATLAS_CELLS {
        if signs[cell] != 0 && signs[cell] != 1 { return false }
        cell = cell + 1
    }
    var lane: i64 = 0
    while lane < 16 {
        if signs[lane] != 0 || signs[lane * 16] != 0 { return false }
        lane = lane + 1
    }
    true
}

pub fn pireus_operator_atlas_classify(signs: &[i64; 256])
-> PireusOperatorAtlasClassification with Mut, Panic, Div, Epistemic {
    if !pireus_operator_atlas_intact() {
        return pireus_atlas_refusal(PIREUS_ATLAS_ERR_INTEGRITY)
    }
    if !pireus_operator_atlas_in_domain(signs) {
        return pireus_atlas_refusal(PIREUS_ATLAS_ERR_DOMAIN)
    }
    let view = pireus_operator_orbit_canonical_view(signs)
    if !view.complete {
        return pireus_atlas_refusal(PIREUS_ATLAS_ERR_CANONICALIZATION)
    }
    let class_id = pireus_operator_atlas_find(&view.words)
    // N0: the table is bit-identical to the reference table itself: the
    // canonical representative for a V13 class, the defining table for a
    // corpus member.
    var exact = false
    if class_id >= 0 {
        let raw = pireus_operator_atlas_pack(signs)
        var reference = view.words
        if class_id >= PIREUS_ATLAS_CLASSES {
            let member_signs = pireus_operator_atlas_corpus_signs(class_id - PIREUS_ATLAS_CLASSES)
            reference = pireus_operator_atlas_pack(&member_signs)
        }
        var same = true
        var word: i64 = 0
        while word < PIREUS_ATLAS_WORDS {
            if raw[word] != reference[word] { same = false }
            word = word + 1
        }
        exact = same
    }
    var level = PIREUS_ATLAS_N2
    if class_id >= 0 {
        level = if exact { PIREUS_ATLAS_N0 } else { PIREUS_ATLAS_N1 }
    }
    PireusOperatorAtlasClassification {
        valid: true, error: PIREUS_ATLAS_OK, level: level, class_id: class_id,
        origin: pireus_operator_atlas_origin(class_id),
        exact_representative: exact, words: view.words,
        matrix: view.matrix, swap: view.swap, gauge: view.gauge,
        action_views: view.action_views,
    }
}
