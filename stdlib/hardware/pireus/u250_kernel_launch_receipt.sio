//! Sounio authority for one frozen U250 kernel launch observation.
//!
//! C++ emits XRT lifecycle facts and opaque returned values. This module owns
//! the invocation, phase order, acceptance, and refusal boundary.

use hardware::pireus::model::{
    PIREUS_RDF_TYPE, PIREUS_CLASS_ONTOLOGY_CLASS,
}
use hardware::pireus::u250_dual_card_admission::{
    PIREUS_U250_LANGUAGE_SOUNIO,
    PIREUS_U250_LANGUAGE_CPP,
    PIREUS_U250_ROLE_SEMANTIC_AUTHORITY,
    PIREUS_U250_ROLE_MATERIAL_PARITY,
}
use hardware::pireus::u250_execution_engine::{
    PireusU250ExecutionEngineResult,
}
use hardware::pireus::u250_fpga_kernel_artifact::{
    PireusU250FpgaKernelArtifactResult,
    PIREUS_U250_KERNEL_ARTIFACT_SAN_SCAN,
}
use hardware::pireus::u250_xclbin_material_receipt::{
    PireusU250XclbinMaterialResult,
    pireus_u250_xclbin_parity_matches_expected,
    pireus_u250_xclbin_material_store,
}
use ontology::query::{
    TripleStore, SparqlResult,
    triple_store_add, triple_iri,
    sparql_new, sparql_select, sparql_add_pattern, sparql_execute,
    triple_pattern_new, queryterm_variable, queryterm_iri,
}

pub const PIREUS_U250_KERNEL_LAUNCH_SCHEMA: i64 = 715000

pub const PIREUS_CLASS_KERNEL_LAUNCH_RECEIPT: i64 = 715001
pub const PIREUS_CLASS_KERNEL_INVOCATION: i64 = 715002
pub const PIREUS_CLASS_XRT_LIFECYCLE_OBSERVATION: i64 = 715003
pub const PIREUS_CLASS_KERNEL_OUTPUT_OBSERVATION: i64 = 715004
pub const PIREUS_CLASS_LAUNCH_PRODUCER: i64 = 715005

pub const PIREUS_ARTIFACT_HAS_LAUNCH_RECEIPT: i64 = 715100
pub const PIREUS_LAUNCH_RECEIPT_HAS_INVOCATION: i64 = 715101
pub const PIREUS_LAUNCH_RECEIPT_HAS_LIFECYCLE: i64 = 715102
pub const PIREUS_LAUNCH_RECEIPT_HAS_OUTPUT: i64 = 715103
pub const PIREUS_LAUNCH_RECEIPT_HAS_PRODUCER: i64 = 715104

pub const PIREUS_U250_KERNEL_LAUNCH_RECEIPT_SAN_SCAN_V0: i64 = 715200
pub const PIREUS_U250_KERNEL_INVOCATION_SAN_SCAN_V0: i64 = 715201
pub const PIREUS_U250_XRT_LIFECYCLE_SAN_SCAN_V0: i64 = 715202
pub const PIREUS_U250_KERNEL_OUTPUT_SAN_SCAN_V0: i64 = 715203
pub const PIREUS_U250_LAUNCH_PRODUCER_CPP: i64 = 715204

pub const PIREUS_U250_KERNEL_LAUNCH_STATUS_AWAITING_LAUNCH: i64 = 715090
pub const PIREUS_U250_KERNEL_LAUNCH_STATUS_PARITY_OPEN: i64 = 715091
pub const PIREUS_U250_KERNEL_LAUNCH_STATUS_PARENT_REFUSED: i64 = 715092
pub const PIREUS_U250_KERNEL_LAUNCH_STATUS_AUTHORITY_REFUSED: i64 = 715093
pub const PIREUS_U250_KERNEL_LAUNCH_STATUS_ORDER_REFUSED: i64 = 715094
pub const PIREUS_U250_KERNEL_LAUNCH_STATUS_OBSERVATION_REFUSED: i64 = 715095
pub const PIREUS_U250_KERNEL_LAUNCH_STATUS_IDENTITY_REFUSED: i64 = 715096
pub const PIREUS_U250_KERNEL_LAUNCH_STATUS_INVOCATION_REFUSED: i64 = 715097
pub const PIREUS_U250_KERNEL_LAUNCH_STATUS_CAPABILITY_REFUSED: i64 = 715098
pub const PIREUS_U250_KERNEL_LAUNCH_STATUS_CLAIM_REFUSED: i64 = 715099

pub struct PireusU250KernelLaunchRequest {
    pub producer_language: i64,
    pub producer_role: i64,
    pub semantics_frozen: bool,
    pub parity_open_requested: bool,
    pub launch_observed: bool,
    pub parent_semantics_matches: bool,
    pub parent_freeze_matches: bool,
    pub artifact_digest_matches: bool,
    pub xclbin_uuid_matches: bool,
    pub device_bdf_matches: bool,
    pub card_serial_matches: bool,
    pub xrt_version_matches: bool,
    pub kernel_symbol_matches: bool,
    pub n_samples: i64,
    pub n_points: i64,
    pub q_delta: i64,
    pub packed_sample_beats: i64,
    pub sample_bytes: i64,
    pub samples_all_zero: bool,
    pub lut_0: i64,
    pub lut_1: i64,
    pub lut_tail_zero: bool,
    pub device_programmed: bool,
    pub kernel_opened: bool,
    pub buffers_allocated: i64,
    pub inputs_synced: bool,
    pub run_submitted: bool,
    pub run_completed: bool,
    pub outputs_synced: i64,
    pub histogram_output_bytes: i64,
    pub catastrophe_output_bytes: i64,
    pub flops_output_bytes: i64,
    pub output_values_recorded: bool,
    pub semantic_verdict_emitted_by_child: bool,
    pub expected_output_present: bool,
    pub kernel_correctness_present: bool,
    pub operation_capability_count: i64,
    pub lowering_requested: bool,
    pub isa_claim_present: bool,
    pub performance_present: bool,
    pub claim_ready_requested: bool,
}

pub struct PireusU250KernelLaunchResult {
    pub valid: bool,
    pub status: i64,
    pub schema: i64,
    pub artifact_parity_open: bool,
    pub launch_observed: bool,
    pub identity_matches: bool,
    pub invocation_matches: bool,
    pub lifecycle_matches: bool,
    pub output_shape_matches: bool,
    pub output_values_recorded: bool,
    pub n_samples: i64,
    pub n_points: i64,
    pub q_delta: i64,
    pub lifecycle_observation_count: i64,
    pub buffers_allocated: i64,
    pub outputs_synced: i64,
    pub execution_parity_open: bool,
    pub kernel_execution_observed: bool,
    pub kernel_correctness_present: bool,
    pub operation_capability_count: i64,
    pub lowering_authorized: bool,
    pub isa_claim_present: bool,
    pub performance_present: bool,
    pub claim_ready: bool,
    pub authority_refused: bool,
    pub order_refused: bool,
    pub observation_refused: bool,
    pub identity_refused: bool,
    pub invocation_refused: bool,
    pub capability_refused: bool,
    pub failures: i64,
}

pub fn pireus_u250_kernel_launch_request(
) -> PireusU250KernelLaunchRequest {
    PireusU250KernelLaunchRequest {
        producer_language: PIREUS_U250_LANGUAGE_SOUNIO,
        producer_role: PIREUS_U250_ROLE_SEMANTIC_AUTHORITY,
        semantics_frozen: false,
        parity_open_requested: false,
        launch_observed: false,
        parent_semantics_matches: true,
        parent_freeze_matches: true,
        artifact_digest_matches: true,
        xclbin_uuid_matches: true,
        device_bdf_matches: true,
        card_serial_matches: true,
        xrt_version_matches: true,
        kernel_symbol_matches: true,
        n_samples: 4,
        n_points: 2,
        q_delta: 16384,
        packed_sample_beats: 1,
        sample_bytes: 64,
        samples_all_zero: true,
        lut_0: 8192,
        lut_1: 16384,
        lut_tail_zero: true,
        device_programmed: false,
        kernel_opened: false,
        buffers_allocated: 0,
        inputs_synced: false,
        run_submitted: false,
        run_completed: false,
        outputs_synced: 0,
        histogram_output_bytes: 32,
        catastrophe_output_bytes: 4,
        flops_output_bytes: 8,
        output_values_recorded: false,
        semantic_verdict_emitted_by_child: false,
        expected_output_present: false,
        kernel_correctness_present: false,
        operation_capability_count: 0,
        lowering_requested: false,
        isa_claim_present: false,
        performance_present: false,
        claim_ready_requested: false,
    }
}

pub fn pireus_u250_kernel_launch_observation(
) -> PireusU250KernelLaunchRequest {
    var request = pireus_u250_kernel_launch_request()
    request.producer_language = PIREUS_U250_LANGUAGE_CPP
    request.producer_role = PIREUS_U250_ROLE_MATERIAL_PARITY
    request.semantics_frozen = true
    request.parity_open_requested = true
    request.launch_observed = true
    request.device_programmed = true
    request.kernel_opened = true
    request.buffers_allocated = 5
    request.inputs_synced = true
    request.run_submitted = true
    request.run_completed = true
    request.outputs_synced = 3
    request.output_values_recorded = true
    request
}

fn u250kl_identity_matches(request: &PireusU250KernelLaunchRequest) -> bool {
    request.parent_semantics_matches && request.parent_freeze_matches &&
        request.artifact_digest_matches && request.xclbin_uuid_matches &&
        request.device_bdf_matches && request.card_serial_matches &&
        request.xrt_version_matches && request.kernel_symbol_matches
}

fn u250kl_invocation_matches(
    request: &PireusU250KernelLaunchRequest,
) -> bool {
    request.n_samples == 4 && request.n_points == 2 &&
        request.q_delta == 16384 && request.packed_sample_beats == 1 &&
        request.sample_bytes == 64 && request.samples_all_zero &&
        request.lut_0 == 8192 && request.lut_1 == 16384 &&
        request.lut_tail_zero
}

fn u250kl_lifecycle_matches(
    request: &PireusU250KernelLaunchRequest,
) -> bool {
    request.device_programmed && request.kernel_opened &&
        request.buffers_allocated == 5 && request.inputs_synced &&
        request.run_submitted && request.run_completed &&
        request.outputs_synced == 3
}

fn u250kl_lifecycle_empty(
    request: &PireusU250KernelLaunchRequest,
) -> bool {
    !request.device_programmed && !request.kernel_opened &&
        request.buffers_allocated == 0 && !request.inputs_synced &&
        !request.run_submitted && !request.run_completed &&
        request.outputs_synced == 0
}

fn u250kl_output_shape_matches(
    request: &PireusU250KernelLaunchRequest,
) -> bool {
    request.histogram_output_bytes == 32 &&
        request.catastrophe_output_bytes == 4 &&
        request.flops_output_bytes == 8
}

fn u250kl_capability_clean(
    request: &PireusU250KernelLaunchRequest,
) -> bool {
    !request.semantic_verdict_emitted_by_child &&
        !request.expected_output_present &&
        !request.kernel_correctness_present &&
        request.operation_capability_count == 0 &&
        !request.lowering_requested && !request.isa_claim_present &&
        !request.performance_present
}

pub fn pireus_u250_kernel_launch_project(
    parent: &PireusU250XclbinMaterialResult,
    request: &PireusU250KernelLaunchRequest,
) -> PireusU250KernelLaunchResult with Mut {
    let parent_valid = pireus_u250_xclbin_parity_matches_expected(parent)
    let waiting = !request.launch_observed
    let authority_valid = if waiting {
        request.producer_language == PIREUS_U250_LANGUAGE_SOUNIO &&
            request.producer_role == PIREUS_U250_ROLE_SEMANTIC_AUTHORITY
    } else {
        request.producer_language == PIREUS_U250_LANGUAGE_CPP &&
            request.producer_role == PIREUS_U250_ROLE_MATERIAL_PARITY
    }
    let order_valid = if waiting {
        !request.semantics_frozen && !request.parity_open_requested
    } else {
        request.semantics_frozen && request.parity_open_requested
    }
    let observation_valid = if waiting {
        u250kl_lifecycle_empty(request) && !request.output_values_recorded
    } else {
        u250kl_lifecycle_matches(request) && request.output_values_recorded
    }
    let identity_valid = u250kl_identity_matches(request)
    let invocation_valid = u250kl_invocation_matches(request)
    let output_valid = u250kl_output_shape_matches(request)
    let capability_clean = u250kl_capability_clean(request)

    var failures: i64 = 0
    if !parent_valid { failures = failures + 1 }
    if !authority_valid { failures = failures + 1 }
    if !order_valid { failures = failures + 1 }
    if !observation_valid { failures = failures + 1 }
    if !identity_valid { failures = failures + 1 }
    if !invocation_valid { failures = failures + 1 }
    if !output_valid { failures = failures + 1 }
    if !capability_clean { failures = failures + 1 }
    if request.claim_ready_requested { failures = failures + 1 }

    var status = if waiting {
        PIREUS_U250_KERNEL_LAUNCH_STATUS_AWAITING_LAUNCH
    } else { PIREUS_U250_KERNEL_LAUNCH_STATUS_PARITY_OPEN }
    if request.claim_ready_requested {
        status = PIREUS_U250_KERNEL_LAUNCH_STATUS_CLAIM_REFUSED
    }
    if !capability_clean {
        status = PIREUS_U250_KERNEL_LAUNCH_STATUS_CAPABILITY_REFUSED
    }
    if !output_valid || !invocation_valid {
        status = PIREUS_U250_KERNEL_LAUNCH_STATUS_INVOCATION_REFUSED
    }
    if !identity_valid {
        status = PIREUS_U250_KERNEL_LAUNCH_STATUS_IDENTITY_REFUSED
    }
    if !observation_valid {
        status = PIREUS_U250_KERNEL_LAUNCH_STATUS_OBSERVATION_REFUSED
    }
    if !order_valid { status = PIREUS_U250_KERNEL_LAUNCH_STATUS_ORDER_REFUSED }
    if !authority_valid {
        status = PIREUS_U250_KERNEL_LAUNCH_STATUS_AUTHORITY_REFUSED
    }
    if !parent_valid { status = PIREUS_U250_KERNEL_LAUNCH_STATUS_PARENT_REFUSED }

    let admitted = failures == 0 && !waiting
    PireusU250KernelLaunchResult {
        valid: failures == 0,
        status: status,
        schema: PIREUS_U250_KERNEL_LAUNCH_SCHEMA,
        artifact_parity_open: parent_valid,
        launch_observed: request.launch_observed,
        identity_matches: identity_valid,
        invocation_matches: invocation_valid,
        lifecycle_matches: if waiting {
            u250kl_lifecycle_empty(request)
        } else { u250kl_lifecycle_matches(request) },
        output_shape_matches: output_valid,
        output_values_recorded: request.output_values_recorded,
        n_samples: request.n_samples,
        n_points: request.n_points,
        q_delta: request.q_delta,
        lifecycle_observation_count: if waiting { 0 } else { 7 },
        buffers_allocated: request.buffers_allocated,
        outputs_synced: request.outputs_synced,
        execution_parity_open: admitted,
        kernel_execution_observed: admitted,
        kernel_correctness_present: request.kernel_correctness_present,
        operation_capability_count: request.operation_capability_count,
        lowering_authorized: false,
        isa_claim_present: request.isa_claim_present,
        performance_present: request.performance_present,
        claim_ready: false,
        authority_refused: !authority_valid,
        order_refused: !order_valid,
        observation_refused: !observation_valid,
        identity_refused: !identity_valid,
        invocation_refused: !invocation_valid || !output_valid,
        capability_refused: !capability_clean,
        failures: failures,
    }
}

pub fn pireus_u250_kernel_launch_waiting_matches_expected(
    result: &PireusU250KernelLaunchResult,
) -> bool {
    result.valid &&
        result.status == PIREUS_U250_KERNEL_LAUNCH_STATUS_AWAITING_LAUNCH &&
        result.schema == PIREUS_U250_KERNEL_LAUNCH_SCHEMA &&
        result.artifact_parity_open && !result.launch_observed &&
        result.identity_matches && result.invocation_matches &&
        result.lifecycle_matches && result.output_shape_matches &&
        !result.output_values_recorded && result.n_samples == 4 &&
        result.n_points == 2 && result.q_delta == 16384 &&
        result.lifecycle_observation_count == 0 &&
        result.buffers_allocated == 0 && result.outputs_synced == 0 &&
        !result.execution_parity_open &&
        !result.kernel_execution_observed &&
        !result.kernel_correctness_present &&
        result.operation_capability_count == 0 &&
        !result.lowering_authorized && !result.isa_claim_present &&
        !result.performance_present && !result.claim_ready &&
        result.failures == 0
}

pub fn pireus_u250_kernel_launch_parity_matches_expected(
    result: &PireusU250KernelLaunchResult,
) -> bool {
    result.valid &&
        result.status == PIREUS_U250_KERNEL_LAUNCH_STATUS_PARITY_OPEN &&
        result.artifact_parity_open && result.launch_observed &&
        result.identity_matches && result.invocation_matches &&
        result.lifecycle_matches && result.output_shape_matches &&
        result.output_values_recorded && result.n_samples == 4 &&
        result.n_points == 2 && result.q_delta == 16384 &&
        result.lifecycle_observation_count == 7 &&
        result.buffers_allocated == 5 && result.outputs_synced == 3 &&
        result.execution_parity_open && result.kernel_execution_observed &&
        !result.kernel_correctness_present &&
        result.operation_capability_count == 0 &&
        !result.lowering_authorized && !result.isa_claim_present &&
        !result.performance_present && !result.claim_ready &&
        result.failures == 0
}

fn u250kl_span_eq(
    raw: string, start: i64, end: i64, expected: string,
) -> bool with Mut, Panic {
    let expected_len = str_len(expected)
    if end - start != expected_len { return false }
    var i: i64 = 0
    while i < expected_len {
        if str_char_at(raw, start + i) != str_char_at(expected, i) {
            return false
        }
        i = i + 1
    }
    true
}

fn u250kl_span_has_prefix(
    raw: string, start: i64, end: i64, prefix: string,
) -> bool with Mut, Panic {
    let prefix_len = str_len(prefix)
    if end - start <= prefix_len { return false }
    var i: i64 = 0
    while i < prefix_len {
        if str_char_at(raw, start + i) != str_char_at(prefix, i) {
            return false
        }
        i = i + 1
    }
    true
}

fn u250kl_line_count(raw: string, expected: string) -> i64
with Mut, Panic {
    let size = str_len(raw)
    var count: i64 = 0
    var start: i64 = 0
    while start < size {
        var end = start
        while end < size && str_char_at(raw, end) != 10 { end = end + 1 }
        var line_end = end
        if line_end > start && str_char_at(raw, line_end - 1) == 13 {
            line_end = line_end - 1
        }
        if u250kl_span_eq(raw, start, line_end, expected) {
            count = count + 1
        }
        start = end + 1
    }
    count
}

fn u250kl_prefix_count(raw: string, prefix: string) -> i64
with Mut, Panic {
    let size = str_len(raw)
    var count: i64 = 0
    var start: i64 = 0
    while start < size {
        var end = start
        while end < size && str_char_at(raw, end) != 10 { end = end + 1 }
        var line_end = end
        if line_end > start && str_char_at(raw, line_end - 1) == 13 {
            line_end = line_end - 1
        }
        if u250kl_span_has_prefix(raw, start, line_end, prefix) {
            count = count + 1
        }
        start = end + 1
    }
    count
}

fn u250kl_has_one(raw: string, expected: string) -> bool
with Mut, Panic {
    u250kl_line_count(raw, expected) == 1
}

fn u250kl_has_one_value(raw: string, prefix: string) -> bool
with Mut, Panic {
    u250kl_prefix_count(raw, prefix) == 1
}

fn u250kl_raw_probe_valid(raw: string) -> bool with Mut, Panic {
    u250kl_has_one(raw, "schema=pireus.u250.kernel-launch-probe.v0") &&
        u250kl_has_one(raw, "producer_language=C++") &&
        u250kl_has_one(raw, "producer_role=MATERIAL_PARITY") &&
        u250kl_has_one(raw, "semantic_authority_language=Sounio") &&
        u250kl_has_one(raw, "parent_semantics_sha256=8d89d94c4b808548a9b8827ac6f54c29d510a40674f2421e99b497f8a6f32f05") &&
        u250kl_has_one(raw, "parent_freeze_sha256=662fe6e6f2dc0c5b27f227c26e5d92d1f0da3c588e7ef94accbf4b49b8abd2e5") &&
        u250kl_has_one(raw, "artifact_name=krnl_san_scan.hw.xclbin") &&
        u250kl_has_one(raw, "artifact_sha256=d30078c7b2e8690aef892b4b6cf96af0f490b70e2b367e5e3679be04fcd4bdbf") &&
        u250kl_has_one(raw, "xclbin_uuid=c50267ec-ae68-48a1-1559-3473f046689c") &&
        u250kl_has_one(raw, "device_bdf=0000:d8:00.1") &&
        u250kl_has_one(raw, "card_serial=22000321B01F") &&
        u250kl_has_one(raw, "xrt_version=2.23.0") &&
        u250kl_has_one(raw, "kernel=krnl_san_scan") &&
        u250kl_has_one(raw, "n_samples=4") &&
        u250kl_has_one(raw, "n_points=2") &&
        u250kl_has_one(raw, "q_delta=16384") &&
        u250kl_has_one(raw, "packed_sample_beats=1") &&
        u250kl_has_one(raw, "sample_bytes=64") &&
        u250kl_has_one(raw, "samples_all_zero=true") &&
        u250kl_has_one(raw, "lut=8192,16384,0,0,0,0,0,0") &&
        u250kl_has_one(raw, "toolchain_sha256=683759ae2d3f34e05a780a935399bb3b12c3acbf3d6a81d863620b572d231e3e") &&
        u250kl_has_one(raw, "hardware_sha256=02bde35408178d3a691d69a8f4f10099c45ab23f468d673cb27f4fedc798554a") &&
        u250kl_has_one(raw, "command_sha256=5bb07529f0f6bb2536395957034f8703854cc7e1e5e3f833afecf9523c964579") &&
        u250kl_has_one(raw, "result_contract_sha256=7bd0d2d7b7838e046a619960c149622b95b5ab4856eb496ff398daaa48d70594") &&
        u250kl_has_one(raw, "device_programmed=true") &&
        u250kl_has_one(raw, "kernel_opened=true") &&
        u250kl_has_one(raw, "buffers_allocated=5") &&
        u250kl_has_one(raw, "inputs_synced=true") &&
        u250kl_has_one(raw, "run_submitted=true") &&
        u250kl_has_one(raw, "run_completed=true") &&
        u250kl_has_one(raw, "outputs_synced=3") &&
        u250kl_has_one(raw, "histogram_output_bytes=32") &&
        u250kl_has_one(raw, "catastrophe_output_bytes=4") &&
        u250kl_has_one(raw, "flops_output_bytes=8") &&
        u250kl_has_one_value(raw, "histogram_observed=") &&
        u250kl_has_one_value(raw, "catastrophe_observed=") &&
        u250kl_has_one_value(raw, "flops_observed=") &&
        u250kl_has_one(raw, "output_values_recorded=true") &&
        u250kl_has_one(raw, "probe_valid=true") &&
        u250kl_has_one(raw, "semantic_verdict_emitted=false") &&
        u250kl_has_one(raw, "expected_output_present=false") &&
        u250kl_has_one(raw, "kernel_correctness_present=false") &&
        u250kl_has_one(raw, "operation_capability_count=0") &&
        u250kl_has_one(raw, "lowering_requested=false") &&
        u250kl_has_one(raw, "isa_claim_present=false") &&
        u250kl_has_one(raw, "performance_present=false") &&
        u250kl_has_one(raw, "claim_ready=false")
}

pub fn pireus_u250_kernel_launch_ingest_text(
    parent: &PireusU250XclbinMaterialResult,
    raw: string,
) -> PireusU250KernelLaunchResult with Mut, Panic {
    if !u250kl_raw_probe_valid(raw) {
        var refused = pireus_u250_kernel_launch_observation()
        refused.output_values_recorded = false
        return pireus_u250_kernel_launch_project(parent, &refused)
    }
    let observed = pireus_u250_kernel_launch_observation()
    pireus_u250_kernel_launch_project(parent, &observed)
}

pub fn pireus_u250_kernel_launch_ingest_file(
    parent: &PireusU250XclbinMaterialResult,
    raw_path: string,
) -> PireusU250KernelLaunchResult with IO, Mut, Panic, Alloc {
    pireus_u250_kernel_launch_ingest_text(parent, read_file(raw_path))
}

fn u250kl_add_class(store: &TripleStore, class_id: i64) {
    triple_store_add(store, triple_iri(
        class_id, PIREUS_RDF_TYPE, PIREUS_CLASS_ONTOLOGY_CLASS))
}

fn u250kl_add_typed(store: &TripleStore, subject: i64, class_id: i64) {
    triple_store_add(store, triple_iri(subject, PIREUS_RDF_TYPE, class_id))
}

pub fn pireus_u250_kernel_launch_store(
    engine: &PireusU250ExecutionEngineResult,
    artifact: &PireusU250FpgaKernelArtifactResult,
    material: &PireusU250XclbinMaterialResult,
    result: &PireusU250KernelLaunchResult,
) -> TripleStore with Mut {
    var store = pireus_u250_xclbin_material_store(engine, artifact, material)
    if !pireus_u250_kernel_launch_parity_matches_expected(result) {
        return store
    }

    u250kl_add_class(&store, PIREUS_CLASS_KERNEL_LAUNCH_RECEIPT)
    u250kl_add_class(&store, PIREUS_CLASS_KERNEL_INVOCATION)
    u250kl_add_class(&store, PIREUS_CLASS_XRT_LIFECYCLE_OBSERVATION)
    u250kl_add_class(&store, PIREUS_CLASS_KERNEL_OUTPUT_OBSERVATION)
    u250kl_add_class(&store, PIREUS_CLASS_LAUNCH_PRODUCER)
    u250kl_add_typed(&store, PIREUS_U250_KERNEL_LAUNCH_RECEIPT_SAN_SCAN_V0,
        PIREUS_CLASS_KERNEL_LAUNCH_RECEIPT)
    u250kl_add_typed(&store, PIREUS_U250_KERNEL_INVOCATION_SAN_SCAN_V0,
        PIREUS_CLASS_KERNEL_INVOCATION)
    u250kl_add_typed(&store, PIREUS_U250_XRT_LIFECYCLE_SAN_SCAN_V0,
        PIREUS_CLASS_XRT_LIFECYCLE_OBSERVATION)
    u250kl_add_typed(&store, PIREUS_U250_KERNEL_OUTPUT_SAN_SCAN_V0,
        PIREUS_CLASS_KERNEL_OUTPUT_OBSERVATION)
    u250kl_add_typed(&store, PIREUS_U250_LAUNCH_PRODUCER_CPP,
        PIREUS_CLASS_LAUNCH_PRODUCER)
    triple_store_add(&store, triple_iri(PIREUS_U250_KERNEL_ARTIFACT_SAN_SCAN,
        PIREUS_ARTIFACT_HAS_LAUNCH_RECEIPT,
        PIREUS_U250_KERNEL_LAUNCH_RECEIPT_SAN_SCAN_V0))
    triple_store_add(&store, triple_iri(
        PIREUS_U250_KERNEL_LAUNCH_RECEIPT_SAN_SCAN_V0,
        PIREUS_LAUNCH_RECEIPT_HAS_INVOCATION,
        PIREUS_U250_KERNEL_INVOCATION_SAN_SCAN_V0))
    triple_store_add(&store, triple_iri(
        PIREUS_U250_KERNEL_LAUNCH_RECEIPT_SAN_SCAN_V0,
        PIREUS_LAUNCH_RECEIPT_HAS_LIFECYCLE,
        PIREUS_U250_XRT_LIFECYCLE_SAN_SCAN_V0))
    triple_store_add(&store, triple_iri(
        PIREUS_U250_KERNEL_LAUNCH_RECEIPT_SAN_SCAN_V0,
        PIREUS_LAUNCH_RECEIPT_HAS_OUTPUT,
        PIREUS_U250_KERNEL_OUTPUT_SAN_SCAN_V0))
    triple_store_add(&store, triple_iri(
        PIREUS_U250_KERNEL_LAUNCH_RECEIPT_SAN_SCAN_V0,
        PIREUS_LAUNCH_RECEIPT_HAS_PRODUCER,
        PIREUS_U250_LAUNCH_PRODUCER_CPP))
    store
}

fn u250kl_query_object(
    store: &TripleStore, subject: i64, predicate: i64,
) -> SparqlResult with Mut, Epistemic {
    var query = sparql_new()
    sparql_select(&query, 0)
    sparql_add_pattern(&query, triple_pattern_new(
        queryterm_iri(subject), queryterm_iri(predicate),
        queryterm_variable(0)))
    sparql_execute(store, &query)
}

pub fn pireus_u250_query_kernel_launch_receipts(
    store: &TripleStore,
) -> SparqlResult with Mut, Epistemic {
    u250kl_query_object(store, PIREUS_U250_KERNEL_ARTIFACT_SAN_SCAN,
        PIREUS_ARTIFACT_HAS_LAUNCH_RECEIPT)
}

pub fn pireus_u250_query_kernel_launch_lifecycle(
    store: &TripleStore,
) -> SparqlResult with Mut, Epistemic {
    u250kl_query_object(store,
        PIREUS_U250_KERNEL_LAUNCH_RECEIPT_SAN_SCAN_V0,
        PIREUS_LAUNCH_RECEIPT_HAS_LIFECYCLE)
}

pub fn pireus_u250_query_kernel_launch_outputs(
    store: &TripleStore,
) -> SparqlResult with Mut, Epistemic {
    u250kl_query_object(store,
        PIREUS_U250_KERNEL_LAUNCH_RECEIPT_SAN_SCAN_V0,
        PIREUS_LAUNCH_RECEIPT_HAS_OUTPUT)
}
