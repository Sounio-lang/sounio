fn osk_parent_source_hash() -> [i64; 8] {
    [0xb73cc3fb, 0x6a905193, 0xa68a65eb, 0x6afd5d27,
     0xda80395a, 0x0c38ae37, 0x72f9df56, 0xe8c8deaf]
}

fn osk_parent_semantics_hash() -> [i64; 8] {
    [0xa1be2923, 0x92727cf5, 0x15baf6d9, 0x5a376d60,
     0x60d56f9b, 0x807fc58d, 0x8998fbe2, 0x3bdc7726]
}

fn osk_parent_freeze_hash() -> [i64; 8] {
    [0x7293594e, 0xb7a881d1, 0xf89d9593, 0xb1cc19e3,
     0xe611f99a, 0x491a4cd1, 0x146afe0a, 0x68cd623a]
}

fn osk_parent_evidence_hash() -> [i64; 8] {
    [0xda2adf49, 0x188c1dcc, 0x1ca4c2a0, 0x72f72f41,
     0x9705a8d2, 0xf12f3463, 0x3ddd8a5e, 0x604998be]
}

fn osk_digest_add_i64(state: SHA256State, value: i64) -> SHA256State
with Mut, Panic, Div, Epistemic {
    var bytes: [u8; 256] = [0; 256]
    var index: i64 = 0
    while index < 8 {
        bytes[index] = ((value >> ((7 - index) * 8)) & 255) as u8
        index = index + 1
    }
    sha256_update(state, bytes, 8)
}

fn osk_digest_add_bool(state: SHA256State, value: bool) -> SHA256State
with Mut, Panic, Div, Epistemic {
    osk_digest_add_i64(state, if value { 1 } else { 0 })
}

fn osk_digest_add_words(state: SHA256State, words: &[i64; 8]) -> SHA256State
with Mut, Panic, Div, Epistemic {
    var next = state
    var index: i64 = 0
    while index < PIREUS_OSK_WORDS {
        next = osk_digest_add_i64(next, words[index])
        index = index + 1
    }
    next
}

fn osk_digest_finish(state: SHA256State) -> PireusOskDigest
with Mut, Panic, Div, Epistemic {
    let digest = sha256_finalize(state)
    var words: [i64; 8] = [0; 8]
    var word: i64 = 0
    while word < PIREUS_OSK_WORDS {
        var value: i64 = 0
        var byte: i64 = 0
        while byte < 4 {
            value = (value << 8) |
                sha256_digest_byte(&digest, (word * 4 + byte) as i32)
            byte = byte + 1
        }
        words[word] = value
        word = word + 1
    }
    PireusOskDigest { words: words }
}

pub fn pireus_osk_digest_nonzero(digest: &PireusOskDigest) -> bool
with Mut, Panic {
    var index: i64 = 0
    while index < PIREUS_OSK_WORDS {
        if digest.words[index] != 0 { return true }
        index = index + 1
    }
    false
}

