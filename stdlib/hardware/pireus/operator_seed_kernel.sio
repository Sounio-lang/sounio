    PireusOskRequest {
        producer_language: PIREUS_ONF_LANGUAGE_SOUNIO,
        producer_role: PIREUS_ONF_ROLE_SEMANTIC_AUTHORITY,
        stage: PIREUS_ONF_STAGE_SOUNIO_EXECUTABLE,
        policy_present: true,
        parent_present: true,
        parent_frozen: true,
        parent_source_bound: true,
        parent_semantics_bound: true,
        parent_freeze_bound: true,
        parent_process_evidence_present: true,
        recursive_parent_evaluation_requested: false,
        prefilled_parent_seed_present: false,
        declared_bits: PIREUS_OSK_BITS,
        declared_lanes: PIREUS_OSK_LANES,
        declared_cells: PIREUS_OSK_CELLS,
        declared_terms: PIREUS_OSK_TERMS,
        declared_probes: PIREUS_OSK_PROBES,
        expected_probe_output_present: false,
        expected_basis_output_present: false,
        expected_operator_digest_present: false,
        expected_ir_digest_present: false,
        expected_transcript_present: false,
        target_evidence_present: false,
        material_evidence_present: false,
        target_cost_present: false,
        target_performance_present: false,
        semantic_write_from_parity: false,
        expected_result_write_from_parity: false,
        review_promoted_to_authority: false,
        broad_novelty_claimed: false,
        historical_novelty_claimed: false,
        priority_claimed: false,
        claim_ready_requested: false,
        founder_waiver_present: false,
    }
}

pub fn pireus_operator_seed_kernel_parent_paths() -> PireusOskParentPaths {
    PireusOskParentPaths {
        parent_source:
            "stdlib/hardware/pireus/operator_novelty_feedback.sio",
        parent_freeze_receipt:
            "tools/pireus/operator_novelty_feedback.freeze.v7",
        parent_frozen_evidence:
            "tools/pireus/evidence/operator_novelty_feedback_v7.frozen.txt",
    }
}

fn osk_request_error(request: &PireusOskRequest) -> i64 {
    if request.producer_language != PIREUS_ONF_LANGUAGE_SOUNIO ||
        request.producer_role != PIREUS_ONF_ROLE_SEMANTIC_AUTHORITY {
        return PIREUS_OSK_ERR_AUTHORITY
    }
    if request.stage != PIREUS_ONF_STAGE_SOUNIO_EXECUTABLE {
        return PIREUS_OSK_ERR_STAGE
    }
    if !request.policy_present { return PIREUS_OSK_ERR_POLICY }
    if !request.parent_present || !request.parent_frozen ||
        !request.parent_source_bound || !request.parent_semantics_bound ||
        !request.parent_freeze_bound ||
        !request.parent_process_evidence_present {
        return PIREUS_OSK_ERR_LINEAGE
    }
    if request.recursive_parent_evaluation_requested {
        return PIREUS_OSK_ERR_POLICY
    }
    if request.declared_bits != PIREUS_OSK_BITS ||
        request.declared_lanes != PIREUS_OSK_LANES ||
        request.declared_cells != PIREUS_OSK_CELLS ||
        request.declared_terms != PIREUS_OSK_TERMS ||
        request.declared_probes != PIREUS_OSK_PROBES {
        return PIREUS_OSK_ERR_IR
    }
    if request.expected_probe_output_present ||
        request.expected_basis_output_present ||
        request.expected_operator_digest_present ||
        request.expected_ir_digest_present ||
        request.expected_transcript_present ||
        request.expected_result_write_from_parity ||
        request.prefilled_parent_seed_present {
        return PIREUS_OSK_ERR_RESULT_INJECTION
    }
    if request.target_evidence_present || request.material_evidence_present ||
        request.target_cost_present || request.target_performance_present {
        return PIREUS_OSK_ERR_MATERIAL
    }
    if request.semantic_write_from_parity ||
        request.review_promoted_to_authority {
        return PIREUS_OSK_ERR_AUTHORITY
    }
    if request.broad_novelty_claimed || request.historical_novelty_claimed ||
        request.priority_claimed || request.claim_ready_requested {
        return PIREUS_OSK_ERR_CLAIM
    }
    if request.founder_waiver_present { return PIREUS_OSK_ERR_WAIVER }
    PIREUS_OSK_OK
}

fn osk_seed_admitted(
    parent_match: bool,
    operator_seed: bool,
    existing_bridge: bool,
    residual_weight: i64,
    cells_valid: bool,
) -> bool {
    parent_match && operator_seed && !existing_bridge &&
        residual_weight > 0 && cells_valid
}

fn osk_seed_word_bit(words: &[i64; 8], cell: i64) -> i64
with Panic, Div {
    let word = cell / PIREUS_OSK_WORD_BITS
    let bit = cell - word * PIREUS_OSK_WORD_BITS
    (words[word] >> bit) & 1
}

fn osk_seed_coefficient(bit: i64) -> i64 {
    if bit == 0 { 1 } else if bit == 1 { -1 } else { 0 }
}

fn osk_seed_cells_valid(
    words: &[i64; 8],
    cells: &[i64; 256],
    expected_weight: i64,
) -> bool with Mut, Panic, Div {
    var cell: i64 = 0
    var nonzero: i64 = 0
    while cell < PIREUS_OSK_CELLS {
        if cells[cell] != 0 && cells[cell] != 1 { return false }
        if cells[cell] != osk_seed_word_bit(words, cell) { return false }
        nonzero = nonzero + cells[cell]
        cell = cell + 1
    }
    nonzero == expected_weight && nonzero > 0
}

fn osk_hash_equal(left: &[i64; 8], right: &[i64; 8]) -> bool
with Mut, Panic {
    var word: i64 = 0
    while word < PIREUS_OSK_WORDS {
        if left[word] != right[word] { return false }
        word = word + 1
    }
    true
}

fn osk_text_sha256_matches(raw: string, expected: &[i64; 8]) -> bool
with Mut, Panic, Div, Epistemic {
    let size = str_len(raw)
    var state = sha256_init()
    var pos: i64 = 0
    while pos < size {
        var window: [u8; 256] = [0; 256]
        var count = size - pos
        if count > 256 { count = 256 }
        var i: i64 = 0
        while i < count {
            var byte = str_char_at(raw, pos + i) as i64
            if byte < 0 { byte = byte + 256 }
            window[i] = byte as u8
            i = i + 1
        }
        state = sha256_update(state, window, count as i32)
        pos = pos + count
    }
    let digest = osk_digest_finish(state)
    osk_hash_equal(&digest.words, expected)
}

fn osk_span_eq(
    raw: string, start: i64, end: i64, expected: string,
) -> bool with Mut, Panic {
    let expected_len = str_len(expected)
    if end - start != expected_len { return false }
    var i: i64 = 0
    while i < expected_len {
        if str_char_at(raw, start + i) != str_char_at(expected, i) {
            return false
        }
        i = i + 1
    }
    true
}

fn osk_span_has_prefix(
    raw: string, start: i64, end: i64, prefix: string,
) -> bool with Mut, Panic {
    let prefix_len = str_len(prefix)
    if end - start <= prefix_len { return false }
    var i: i64 = 0
    while i < prefix_len {
        if str_char_at(raw, start + i) != str_char_at(prefix, i) {
            return false
        }
        i = i + 1
    }
    true
}

fn osk_parse_uint(raw: string, start: i64, end: i64) -> i64
with Mut, Panic {
    if start >= end { return -1 }
    var value: i64 = 0
    var pos = start
    while pos < end {
        let code = str_char_at(raw, pos)
        if code < 48 || code > 57 { return -1 }
        value = value * 10 + (code - 48)
        pos = pos + 1
    }
    value
}

fn osk_parse_prefixed_uint(
    raw: string, start: i64, end: i64, prefix: string,
) -> i64 with Mut, Panic {
    if !osk_span_has_prefix(raw, start, end, prefix) { return -1 }
    osk_parse_uint(raw, start + str_len(prefix), end)
}

fn osk_line_count(raw: string, expected: string) -> i64
with Mut, Panic {
    let size = str_len(raw)
    var count: i64 = 0
    var start: i64 = 0
    while start < size {
        var end = start
        while end < size && str_char_at(raw, end) != 10 { end = end + 1 }
        var line_end = end
        if line_end > start && str_char_at(raw, line_end - 1) == 13 {
            line_end = line_end - 1
        }
        if osk_span_eq(raw, start, line_end, expected) { count = count + 1 }
        start = end + 1
    }
    count
}

fn osk_parse_parent_transcript(raw: string) -> PireusOskParentTranscript
with Mut, Panic, Div {
    var words: [i64; 8] = [0; 8]
    var cells: [i64; 256] = [0; 256]
    var seen: [i64; 256] = [0; 256]
    var word_count: i64 = 0
    var cell_count: i64 = 0
    var duplicate_cells: i64 = 0
    var parse_failures: i64 = 0
    var residual_weight: i64 = -1
    var outcome_kind: i64 = -1
    var replay_checks: i64 = -1
    var replay_failures: i64 = -1
    var word_block: bool = false
    var after_words: bool = false
    var pending_cell: i64 = -1
    let size = str_len(raw)
    var start: i64 = 0
    while start < size {
        var end = start
        while end < size && str_char_at(raw, end) != 10 { end = end + 1 }
        var line_end = end
        if line_end > start && str_char_at(raw, line_end - 1) == 13 {
            line_end = line_end - 1
        }
        if osk_span_has_prefix(
            raw, start, line_end, "PIREUS_ONF_OUTCOME kind=") {
            outcome_kind = osk_parse_prefixed_uint(
                raw, start, line_end, "PIREUS_ONF_OUTCOME kind=")
        } else if osk_span_has_prefix(
            raw, start, line_end, " best_residual_nonzero=") {
            residual_weight = osk_parse_prefixed_uint(
                raw, start, line_end, " best_residual_nonzero=")
        } else if osk_span_has_prefix(
            raw, start, line_end, " best_residual_words=") {
            if word_count != 0 { parse_failures = parse_failures + 1 }
            let value = osk_parse_prefixed_uint(
                raw, start, line_end, " best_residual_words=")
            if value < 0 { parse_failures = parse_failures + 1 }
            else { words[0] = value; word_count = 1; word_block = true }
        } else if word_block &&
            osk_span_has_prefix(raw, start, line_end, ":") {
            let value = osk_parse_prefixed_uint(raw, start, line_end, ":")
            if value < 0 || word_count >= PIREUS_OSK_WORDS {
                parse_failures = parse_failures + 1
            } else {
                words[word_count] = value
                word_count = word_count + 1
                if word_count == PIREUS_OSK_WORDS {
                    word_block = false
                    after_words = true
                }
            }
        } else if after_words && osk_span_has_prefix(
            raw, start, line_end, " replay_checks=") {
            replay_checks = osk_parse_prefixed_uint(
                raw, start, line_end, " replay_checks=")
        } else if after_words && osk_span_has_prefix(
            raw, start, line_end, " replay_failures=") {
            replay_failures = osk_parse_prefixed_uint(
                raw, start, line_end, " replay_failures=")
            after_words = false
        } else if osk_span_has_prefix(
            raw, start, line_end, "PIREUS_ONF_SEED_CELL id=") {
            if pending_cell >= 0 { parse_failures = parse_failures + 1 }
            pending_cell = osk_parse_prefixed_uint(
                raw, start, line_end, "PIREUS_ONF_SEED_CELL id=")
        } else if pending_cell >= 0 &&
            osk_span_has_prefix(raw, start, line_end, " bit=") {
            let bit = osk_parse_prefixed_uint(raw, start, line_end, " bit=")
            if pending_cell < 0 || pending_cell >= PIREUS_OSK_CELLS ||
                (bit != 0 && bit != 1) {
                parse_failures = parse_failures + 1
            } else {
                if seen[pending_cell] != 0 {
                    duplicate_cells = duplicate_cells + 1
                } else {
                    seen[pending_cell] = 1
                    cells[pending_cell] = bit
                    cell_count = cell_count + 1
                }
            }
            pending_cell = -1
        }
        start = end + 1
    }
    if word_block || after_words || pending_cell >= 0 {
        parse_failures = parse_failures + 1
    }
    let bridge_line = osk_line_count(raw, " bridge=0") > 0
    let seed_line = osk_line_count(raw, " seed=1") > 0
    let result_valid =
        osk_line_count(raw, "PIREUS_ONF_RESULT valid=1") == 1 &&
        osk_line_count(raw, " error=0") == 1 &&
        osk_line_count(raw, " failures=0") == 1
    let frozen_match =
        osk_line_count(raw, "PIREUS_ONF_FROZEN match=1") == 1 &&
        osk_line_count(raw, " mismatch_code=0") == 1
    let cells_valid = word_count == PIREUS_OSK_WORDS &&
        cell_count == PIREUS_OSK_CELLS && duplicate_cells == 0 &&
        residual_weight > 0 &&
        osk_seed_cells_valid(&words, &cells, residual_weight)
    let complete = parse_failures == 0 && outcome_kind ==
        PIREUS_ONF_OUTCOME_OPERATOR_SEED && bridge_line && seed_line &&
        replay_checks == PIREUS_OSK_CELLS && replay_failures == 0 &&
        result_valid && frozen_match && cells_valid
    PireusOskParentTranscript {
        seed_words: words,
        seed_cells: cells,
        residual_weight: residual_weight,
        word_count: word_count,
        cell_count: cell_count,
        duplicate_cells: duplicate_cells,
        parse_failures: parse_failures,
        outcome_kind: outcome_kind,
        existing_bridge: !bridge_line,
        operator_seed: seed_line,
        replay_checks: replay_checks,
        replay_failures: replay_failures,
        result_valid: result_valid,
        frozen_match: frozen_match,
        complete: complete,
    }
}

fn osk_invalid_seed_admission() -> PireusOskSeedAdmission {
    PireusOskSeedAdmission {
        lineage: PireusOskLineage {
            parent_source_sha256: osk_parent_source_hash(),
            parent_semantics_sha256: osk_parent_semantics_hash(),
            parent_freeze_sha256: osk_parent_freeze_hash(),
            parent_valid: false,
            parent_frozen_match: false,
            parent_source_file_match: false,
            parent_semantics_receipt_match: false,
            parent_freeze_file_match: false,
            parent_evidence_file_match: false,
            parent_process_evidence_bound: false,
            parent_process_evidence_externalized: false,
            parent_recursive_evaluation_used: false,
            parent_outcome_kind: -1,
            parent_existing_bridge: false,
            parent_operator_seed: false,
            parent_residual_weight: 0,
            seed_word_cell_checks: 0,
            seed_word_cell_failures: 1,
            complete: false,
        },
        seed_words: [0; 8],
        seed_cells: [0; 256],
        seed_admitted: false,
        seed_cells_valid: false,
    }
}

fn osk_build_seed_admission(
    paths: &PireusOskParentPaths,
) -> PireusOskSeedAdmission with IO, Mut, Panic, Div, Alloc, Epistemic {
    let source_size = file_size(paths.parent_source)
    let freeze_size = file_size(paths.parent_freeze_receipt)
    let evidence_size = file_size(paths.parent_frozen_evidence)
    if source_size <= 0 || source_size >= 1048576 ||
        freeze_size <= 0 || freeze_size >= 1048576 ||
        evidence_size <= 0 || evidence_size >= 1048576 {
        return osk_invalid_seed_admission()
    }
    let source_raw = read_file(paths.parent_source)
    let freeze_raw = read_file(paths.parent_freeze_receipt)
    let evidence_raw = read_file(paths.parent_frozen_evidence)
    let source_expected = osk_parent_source_hash()
    let freeze_expected = osk_parent_freeze_hash()
    let evidence_expected = osk_parent_evidence_hash()
    let source_match = osk_text_sha256_matches(source_raw, &source_expected)
    let freeze_match = osk_text_sha256_matches(freeze_raw, &freeze_expected)
    let evidence_match =
        osk_text_sha256_matches(evidence_raw, &evidence_expected)
    let semantics_receipt_match = osk_line_count(
        freeze_raw,
        "semantics_sha256=a1be292392727cf515baf6d95a376d6060d56f9b807fc58d8998fbe23bdc7726") == 1
    let transcript = osk_parse_parent_transcript(evidence_raw)
    let process_evidence_bound = freeze_match && evidence_match &&
        transcript.result_valid && transcript.frozen_match
    let parent_valid = source_match && semantics_receipt_match &&
        process_evidence_bound && transcript.complete
    let cells_valid = osk_seed_cells_valid(
        &transcript.seed_words, &transcript.seed_cells,
        transcript.residual_weight)
    let seed_admitted = osk_seed_admitted(
        parent_valid, transcript.operator_seed,
        transcript.existing_bridge, transcript.residual_weight, cells_valid)
    var seed_word_cell_failures: i64 = 0
    var cell: i64 = 0
    while cell < PIREUS_OSK_CELLS {
        if transcript.seed_cells[cell] !=
            osk_seed_word_bit(&transcript.seed_words, cell) {
            seed_word_cell_failures = seed_word_cell_failures + 1
        }
        cell = cell + 1
    }
    let lineage = PireusOskLineage {
        parent_source_sha256: source_expected,
        parent_semantics_sha256: osk_parent_semantics_hash(),
        parent_freeze_sha256: freeze_expected,
        parent_valid: parent_valid,
        parent_frozen_match: transcript.frozen_match,
        parent_source_file_match: source_match,
        parent_semantics_receipt_match: semantics_receipt_match,
        parent_freeze_file_match: freeze_match,
        parent_evidence_file_match: evidence_match,
        parent_process_evidence_bound: process_evidence_bound,
        parent_process_evidence_externalized: process_evidence_bound,
        parent_recursive_evaluation_used: false,
        parent_outcome_kind: transcript.outcome_kind,
        parent_existing_bridge: transcript.existing_bridge,
        parent_operator_seed: transcript.operator_seed,
        parent_residual_weight: transcript.residual_weight,
        seed_word_cell_checks: transcript.cell_count,
        seed_word_cell_failures: seed_word_cell_failures +
            transcript.duplicate_cells + transcript.parse_failures,
        complete: parent_valid && seed_admitted && cells_valid &&
            transcript.word_count == PIREUS_OSK_WORDS &&
            transcript.cell_count == PIREUS_OSK_CELLS &&
            transcript.replay_checks == PIREUS_OSK_CELLS &&
            transcript.replay_failures == 0 &&
            seed_word_cell_failures == 0,
    }
    PireusOskSeedAdmission {
        lineage: lineage,
        seed_words: transcript.seed_words,
        seed_cells: transcript.seed_cells,
        seed_admitted: seed_admitted,
        seed_cells_valid: cells_valid,
    }
}

fn osk_build_kernel(seed: &[i64; 256]) -> PireusOskKernel
with Mut, Panic, Div {
    var destinations: [i64; 256] = [0; 256]
    var left_indices: [i64; 256] = [0; 256]
    var right_indices: [i64; 256] = [0; 256]
    var coefficients: [i64; 256] = [0; 256]
    var source_cells: [i64; 256] = [0; 256]
    var term_seen: [i64; 256] = [0; 256]
    var source_seen: [i64; 256] = [0; 256]
    var group_counts: [i64; 16] = [0; 16]
    var unique_term_checks: i64 = 0
    var unique_term_failures: i64 = 0
    var unique_source_checks: i64 = 0
    var unique_source_failures: i64 = 0
    var xor_checks: i64 = 0
    var xor_failures: i64 = 0
    var coefficient_checks: i64 = 0
    var coefficient_failures: i64 = 0
    var roundtrip_checks: i64 = 0
    var roundtrip_failures: i64 = 0
    var destination: i64 = 0
    while destination < PIREUS_OSK_DESTINATIONS {
        var left: i64 = 0
        while left < PIREUS_OSK_LANES {
            let term = destination * PIREUS_OSK_TERMS_PER_DESTINATION + left
            let right = left ^ destination
            let source_cell = left * PIREUS_OSK_LANES + right
            let seed_bit = seed[source_cell]
            let coefficient = osk_seed_coefficient(seed_bit)
            destinations[term] = destination
            left_indices[term] = left
            right_indices[term] = right
            coefficients[term] = coefficient
            source_cells[term] = source_cell
            unique_term_checks = unique_term_checks + 1
            if term_seen[term] != 0 { unique_term_failures = unique_term_failures + 1 }
            term_seen[term] = term_seen[term] + 1
            unique_source_checks = unique_source_checks + 1
            if source_seen[source_cell] != 0 {
                unique_source_failures = unique_source_failures + 1
            }
            source_seen[source_cell] = source_seen[source_cell] + 1
            group_counts[destination] = group_counts[destination] + 1
            xor_checks = xor_checks + 1
            if left ^ right != destination { xor_failures = xor_failures + 1 }
            coefficient_checks = coefficient_checks + 1
            if coefficient != 1 && coefficient != -1 {
                coefficient_failures = coefficient_failures + 1
            }
            roundtrip_checks = roundtrip_checks + 1
            let roundtrip_bit = if coefficient == 1 { 0 }
                else if coefficient == -1 { 1 } else { -1 }
            if source_cell != left * PIREUS_OSK_LANES + (left ^ destination) ||
                roundtrip_bit != seed_bit {
                roundtrip_failures = roundtrip_failures + 1
            }
            left = left + 1
        }
        destination = destination + 1
    }
    var destination_group_checks: i64 = 0
    var destination_group_failures: i64 = 0
    destination = 0
    while destination < PIREUS_OSK_DESTINATIONS {
        destination_group_checks = destination_group_checks + 1
        if group_counts[destination] != PIREUS_OSK_TERMS_PER_DESTINATION {
            destination_group_failures = destination_group_failures + 1
        }
        destination = destination + 1
    }
    let complete = unique_term_checks == PIREUS_OSK_TERMS &&
        unique_term_failures == 0 &&
        unique_source_checks == PIREUS_OSK_CELLS &&
        unique_source_failures == 0 &&
        destination_group_checks == PIREUS_OSK_DESTINATIONS &&
        destination_group_failures == 0 &&
        xor_checks == PIREUS_OSK_TERMS && xor_failures == 0 &&
        coefficient_checks == PIREUS_OSK_TERMS &&
        coefficient_failures == 0 &&
        roundtrip_checks == PIREUS_OSK_TERMS && roundtrip_failures == 0
    PireusOskKernel {
        operator_kind: PIREUS_OSK_OPERATOR_TWISTED_XOR_4,
        bits: PIREUS_OSK_BITS,
        lanes: PIREUS_OSK_LANES,
        destination_count: PIREUS_OSK_DESTINATIONS,
        terms_per_destination: PIREUS_OSK_TERMS_PER_DESTINATION,
        term_count: PIREUS_OSK_TERMS,
        destinations: destinations,
        left_indices: left_indices,
        right_indices: right_indices,
        coefficients: coefficients,
        source_cells: source_cells,
        unique_term_checks: unique_term_checks,
        unique_term_failures: unique_term_failures,
        unique_source_checks: unique_source_checks,
        unique_source_failures: unique_source_failures,
        destination_group_checks: destination_group_checks,
        destination_group_failures: destination_group_failures,
        xor_address_checks: xor_checks,
        xor_address_failures: xor_failures,
        coefficient_checks: coefficient_checks,
        coefficient_failures: coefficient_failures,
        roundtrip_checks: roundtrip_checks,
        roundtrip_failures: roundtrip_failures,
        complete: complete,
    }
}

pub fn pireus_osk_table_evaluate(
    seed: &[i64; 256],
    a: &PireusOskVector,
    b: &PireusOskVector,
) -> PireusOskVector with Mut, Panic {
    var output: [i64; 16] = [0; 16]
    var left: i64 = 0
    while left < PIREUS_OSK_LANES {
        var right: i64 = 0
        while right < PIREUS_OSK_LANES {
            let destination = left ^ right
            let bit = seed[left * PIREUS_OSK_LANES + right]
            let coefficient = osk_seed_coefficient(bit)
            output[destination] = output[destination] +
                coefficient * a.lanes[left] * b.lanes[right]
            right = right + 1
        }
        left = left + 1
    }
    PireusOskVector { lanes: output }
}

pub fn pireus_osk_ir_evaluate(
    kernel: &PireusOskKernel,
    a: &PireusOskVector,
    b: &PireusOskVector,
) -> PireusOskVector with Mut, Panic {
    var output: [i64; 16] = [0; 16]
    var term: i64 = 0
    while term < kernel.term_count {
        let destination = kernel.destinations[term]
        let left = kernel.left_indices[term]
        let right = kernel.right_indices[term]
        output[destination] = output[destination] +
            kernel.coefficients[term] * a.lanes[left] * b.lanes[right]
        term = term + 1
    }
    PireusOskVector { lanes: output }
}

fn osk_abs(value: i64) -> i64 {
    if value < 0 { -value } else { value }
}

fn osk_max_abs(vector: &PireusOskVector) -> i64 with Mut, Panic {
    var maximum: i64 = 0
    var lane: i64 = 0
    while lane < PIREUS_OSK_LANES {
        let magnitude = osk_abs(vector.lanes[lane])
        if magnitude > maximum { maximum = magnitude }
        lane = lane + 1
    }
    maximum
}

fn osk_popcount4(value: i64) -> i64 with Mut {
    var count: i64 = 0
    var bit: i64 = 0
    while bit < PIREUS_OSK_BITS {
        if (value & (1 << bit)) != 0 { count = count + 1 }
        bit = bit + 1
    }
    count
}

pub fn pireus_osk_probe_input(id: i64) -> PireusOskVector
with Mut, Panic, Div {
    var lanes: [i64; 16] = [0; 16]
    var lane: i64 = 0
    while lane < PIREUS_OSK_LANES {
        if id == 0 {
            lanes[lane] = lane - 8
        } else if id == 1 {
            lanes[lane] = ((lane * lane + 3 * lane + 1) % 19) - 9
        } else {
            let magnitude = lane + 1
            lanes[lane] = if osk_popcount4(lane) % 2 == 0 {
                magnitude
            } else { -magnitude }
        }
        lane = lane + 1
    }
    PireusOskVector { lanes: lanes }
}

pub fn pireus_osk_probe_input_b(id: i64) -> PireusOskVector
with Mut, Panic, Div {
    var lanes: [i64; 16] = [0; 16]
    var lane: i64 = 0
    while lane < PIREUS_OSK_LANES {
        if id == 0 {
            lanes[lane] = ((5 * lane + 3) % 17) - 8
        } else if id == 1 {
            lanes[lane] = ((7 * lane + 2) % 23) - 11
        } else {
            lanes[lane] = 15 - lane
        }
        lane = lane + 1
    }
    PireusOskVector { lanes: lanes }
}

fn osk_build_probe(
    id: i64,
    seed: &[i64; 256],
    kernel: &PireusOskKernel,
) -> PireusOskProbe with Mut, Panic, Div {
    let a = pireus_osk_probe_input(id)
    let b = pireus_osk_probe_input_b(id)
    let table_output = pireus_osk_table_evaluate(seed, &a, &b)
    let ir_output = pireus_osk_ir_evaluate(kernel, &a, &b)
    let max_abs_a = osk_max_abs(&a)
    let max_abs_b = osk_max_abs(&b)
    let uniform_bound = PIREUS_OSK_TERMS_PER_DESTINATION *
        max_abs_a * max_abs_b
    var lane_checks: i64 = 0
    var equality_failures: i64 = 0
    var bound_checks: i64 = 0
    var bound_failures: i64 = 0
    var lane: i64 = 0
    while lane < PIREUS_OSK_LANES {
        lane_checks = lane_checks + 1
        if table_output.lanes[lane] != ir_output.lanes[lane] {
            equality_failures = equality_failures + 1
        }
        bound_checks = bound_checks + 2
        if osk_abs(table_output.lanes[lane]) > uniform_bound {
            bound_failures = bound_failures + 1
        }
        if osk_abs(ir_output.lanes[lane]) > uniform_bound {
            bound_failures = bound_failures + 1
        }
        lane = lane + 1
    }
    PireusOskProbe {
        id: id,
        a: a,
        b: b,
        table_output: table_output,
        ir_output: ir_output,
        max_abs_a: max_abs_a,
        max_abs_b: max_abs_b,
        uniform_bound: uniform_bound,
        lane_checks: lane_checks,
        equality_failures: equality_failures,
        bound_checks: bound_checks,
        bound_failures: bound_failures,
        complete: lane_checks == PIREUS_OSK_LANES &&
            equality_failures == 0 &&
            bound_checks == 2 * PIREUS_OSK_LANES &&
            bound_failures == 0,
    }
}

pub fn pireus_osk_basis_witness(
    seed: &[i64; 256],
    kernel: &PireusOskKernel,
    left: i64,
    right: i64,
) -> PireusOskBasisWitness with Mut, Panic {
    var a_lanes: [i64; 16] = [0; 16]
    var b_lanes: [i64; 16] = [0; 16]
    a_lanes[left] = 1
    b_lanes[right] = 1
    let a = PireusOskVector { lanes: a_lanes }
    let b = PireusOskVector { lanes: b_lanes }
    let table = pireus_osk_table_evaluate(seed, &a, &b)
    let ir = pireus_osk_ir_evaluate(kernel, &a, &b)
    let destination = left ^ right
    let seed_bit = seed[left * PIREUS_OSK_LANES + right]
    let coefficient = osk_seed_coefficient(seed_bit)
    var table_nonzero: i64 = 0
    var ir_nonzero: i64 = 0
    var lane_checks: i64 = 0
    var failures: i64 = 0
    var lane: i64 = 0
    while lane < PIREUS_OSK_LANES {
        let expected = if lane == destination { coefficient } else { 0 }
        lane_checks = lane_checks + 1
        if table.lanes[lane] != expected { failures = failures + 1 }
        if ir.lanes[lane] != expected { failures = failures + 1 }
        if table.lanes[lane] != ir.lanes[lane] { failures = failures + 1 }
        if table.lanes[lane] != 0 { table_nonzero = table_nonzero + 1 }
        if ir.lanes[lane] != 0 { ir_nonzero = ir_nonzero + 1 }
        lane = lane + 1
    }
    if table_nonzero != 1 { failures = failures + 1 }
    if ir_nonzero != 1 { failures = failures + 1 }
    if table.lanes[destination] != coefficient { failures = failures + 1 }
    if ir.lanes[destination] != coefficient { failures = failures + 1 }
    PireusOskBasisWitness {
        left: left,
        right: right,
        destination: destination,
        coefficient: coefficient,
        table_value: table.lanes[destination],
        ir_value: ir.lanes[destination],
        table_nonzero_lanes: table_nonzero,
        ir_nonzero_lanes: ir_nonzero,
        lane_checks: lane_checks,
        failures: failures,
        complete: lane_checks == PIREUS_OSK_LANES && failures == 0,
    }
}

fn osk_build_basis_certificate(
    seed: &[i64; 256],
    kernel: &PireusOskKernel,
) -> PireusOskBasisCertificate with Mut, Panic {
    var products: i64 = 0
    var lane_checks: i64 = 0
    var path_checks: i64 = 0
    var destination_checks: i64 = 0
    var coefficient_checks: i64 = 0
    var single_support_checks: i64 = 0
    var failures: i64 = 0
    var left: i64 = 0
    while left < PIREUS_OSK_LANES {
        var right: i64 = 0
        while right < PIREUS_OSK_LANES {
            let witness = pireus_osk_basis_witness(seed, kernel, left, right)
            products = products + 1
            lane_checks = lane_checks + witness.lane_checks
            path_checks = path_checks + PIREUS_OSK_LANES
            destination_checks = destination_checks + 1
            coefficient_checks = coefficient_checks + 1
            single_support_checks = single_support_checks + 2
            failures = failures + witness.failures
            if witness.destination != (left ^ right) {
                failures = failures + 1
            }
            let expected_coefficient = osk_seed_coefficient(seed[
                left * PIREUS_OSK_LANES + right])
            if witness.coefficient != expected_coefficient ||
                witness.table_value != expected_coefficient ||
                witness.ir_value != expected_coefficient {
                failures = failures + 1
            }
            if witness.table_nonzero_lanes != 1 ||
                witness.ir_nonzero_lanes != 1 {
                failures = failures + 1
            }
            right = right + 1
        }
        left = left + 1
    }
    PireusOskBasisCertificate {
        products: products,
        lane_checks: lane_checks,
        path_checks: path_checks,
        destination_checks: destination_checks,
        coefficient_checks: coefficient_checks,
        single_support_checks: single_support_checks,
        failures: failures,
        complete: products == PIREUS_OSK_BASIS_PRODUCTS &&
            lane_checks == PIREUS_OSK_BASIS_LANE_CHECKS &&
            path_checks == PIREUS_OSK_BASIS_LANE_CHECKS &&
            destination_checks == PIREUS_OSK_BASIS_PRODUCTS &&
            coefficient_checks == PIREUS_OSK_BASIS_PRODUCTS &&
            single_support_checks == 2 * PIREUS_OSK_BASIS_PRODUCTS &&
            failures == 0,
    }
}

fn osk_default_probe() -> PireusOskProbe {
    let zero = PireusOskVector { lanes: [0; 16] }
    PireusOskProbe {
        id: -1,
        a: zero,
        b: zero,
        table_output: zero,
        ir_output: zero,
        max_abs_a: 0,
        max_abs_b: 0,
        uniform_bound: 0,
        lane_checks: 0,
        equality_failures: 0,
        bound_checks: 0,
        bound_failures: 0,
        complete: false,
    }
}

fn osk_build_probes(
    seed: &[i64; 256],
    kernel: &PireusOskKernel,
) -> [PireusOskProbe; 3] with Mut, Panic, Div {
    var probes: [PireusOskProbe; 3] = [osk_default_probe(); 3]
    var id: i64 = 0
    while id < PIREUS_OSK_PROBES {
        probes[id] = osk_build_probe(id, seed, kernel)
        id = id + 1
    }
    probes
}

fn osk_all_probes_complete(probes: &[PireusOskProbe; 3]) -> bool
with Mut, Panic {
    var id: i64 = 0
    while id < PIREUS_OSK_PROBES {
        if probes[id].id != id || !probes[id].complete { return false }
        id = id + 1
    }
    true
}

fn osk_build_negative_cases() -> [bool; 35] with Mut {
    let base = pireus_operator_seed_kernel_request()
    var request = base
    request.producer_language = PIREUS_ONF_LANGUAGE_PYTHON
    let python_authority = osk_request_error(&request) == PIREUS_OSK_ERR_AUTHORITY
    request = base
    request.producer_language = PIREUS_ONF_LANGUAGE_RUST
    let rust_authority = osk_request_error(&request) == PIREUS_OSK_ERR_AUTHORITY
    request = base
    request.producer_language = PIREUS_ONF_LANGUAGE_CPP
    request.producer_role = PIREUS_ONF_ROLE_MATERIAL_PARITY
    let cpp_authority = osk_request_error(&request) == PIREUS_OSK_ERR_AUTHORITY
    request = base
    request.producer_language = PIREUS_ONF_LANGUAGE_LLM
    request.producer_role = PIREUS_ONF_ROLE_REVIEW_ONLY
    let llm_authority = osk_request_error(&request) == PIREUS_OSK_ERR_AUTHORITY
    request = base
    request.producer_language = PIREUS_ONF_LANGUAGE_LEAN
    request.producer_role = PIREUS_ONF_ROLE_FORMAL_PARITY
    let lean_authority = osk_request_error(&request) == PIREUS_OSK_ERR_AUTHORITY
    request = base
    request.producer_language = PIREUS_ONF_LANGUAGE_KOKA
    request.producer_role = PIREUS_ONF_ROLE_EFFECT_PARITY
    let koka_authority = osk_request_error(&request) == PIREUS_OSK_ERR_AUTHORITY
    request = base; request.policy_present = false
    let missing_policy = osk_request_error(&request) == PIREUS_OSK_ERR_POLICY
    request = base; request.stage = PIREUS_ONF_STAGE_SOUNIO_EXECUTABLE + 1
    let wrong_stage = osk_request_error(&request) == PIREUS_OSK_ERR_STAGE
    request = base; request.parent_present = false
    let missing_parent = osk_request_error(&request) == PIREUS_OSK_ERR_LINEAGE
    request = base; request.parent_frozen = false
    let unfrozen_parent = osk_request_error(&request) == PIREUS_OSK_ERR_LINEAGE
    request = base; request.parent_source_bound = false
    let unbound_parent_source = osk_request_error(&request) == PIREUS_OSK_ERR_LINEAGE
    request = base; request.parent_semantics_bound = false
    let unbound_parent_semantics = osk_request_error(&request) == PIREUS_OSK_ERR_LINEAGE
    request = base; request.parent_freeze_bound = false
    let unbound_parent_freeze = osk_request_error(&request) == PIREUS_OSK_ERR_LINEAGE
    request = base; request.parent_process_evidence_present = false
    let missing_parent_process_evidence =
        osk_request_error(&request) == PIREUS_OSK_ERR_LINEAGE
    request = base; request.recursive_parent_evaluation_requested = true
    let recursive_parent_evaluation =
        osk_request_error(&request) == PIREUS_OSK_ERR_POLICY
    request = base; request.prefilled_parent_seed_present = true
    let prefilled_parent_seed =
        osk_request_error(&request) == PIREUS_OSK_ERR_RESULT_INJECTION
    request = base; request.expected_probe_output_present = true
    let expected_probe_output =
        osk_request_error(&request) == PIREUS_OSK_ERR_RESULT_INJECTION
    request = base; request.expected_basis_output_present = true
    let expected_basis_output =
        osk_request_error(&request) == PIREUS_OSK_ERR_RESULT_INJECTION
    request = base; request.expected_operator_digest_present = true
    let expected_digest =
        osk_request_error(&request) == PIREUS_OSK_ERR_RESULT_INJECTION
    request = base; request.expected_transcript_present = true
    let expected_transcript =
        osk_request_error(&request) == PIREUS_OSK_ERR_RESULT_INJECTION
    request = base; request.target_evidence_present = true
    let target_evidence = osk_request_error(&request) == PIREUS_OSK_ERR_MATERIAL
    request = base; request.material_evidence_present = true
    let material_evidence = osk_request_error(&request) == PIREUS_OSK_ERR_MATERIAL
    request = base; request.target_cost_present = true
    let target_cost = osk_request_error(&request) == PIREUS_OSK_ERR_MATERIAL
    request = base; request.target_performance_present = true
    let target_performance = osk_request_error(&request) == PIREUS_OSK_ERR_MATERIAL
    request = base; request.semantic_write_from_parity = true
    let semantic_write = osk_request_error(&request) == PIREUS_OSK_ERR_AUTHORITY
    request = base; request.expected_result_write_from_parity = true
    let expected_result_write =
        osk_request_error(&request) == PIREUS_OSK_ERR_RESULT_INJECTION
    request = base; request.review_promoted_to_authority = true
    let review_promotion = osk_request_error(&request) == PIREUS_OSK_ERR_AUTHORITY
    request = base; request.broad_novelty_claimed = true
    let broad_novelty = osk_request_error(&request) == PIREUS_OSK_ERR_CLAIM
    request = base; request.historical_novelty_claimed = true
    let historical_novelty = osk_request_error(&request) == PIREUS_OSK_ERR_CLAIM
    request = base; request.priority_claimed = true
    let priority_claim = osk_request_error(&request) == PIREUS_OSK_ERR_CLAIM
    request = base; request.claim_ready_requested = true
    let claim_ready = osk_request_error(&request) == PIREUS_OSK_ERR_CLAIM
    request = base; request.founder_waiver_present = true
    let waiver = osk_request_error(&request) == PIREUS_OSK_ERR_WAIVER
    let bridge_as_seed = !osk_seed_admitted(true, false, true, 0, true)
    let zero_seed = !osk_seed_admitted(true, true, false, 0, true)
    let malformed_seed = !osk_seed_admitted(true, true, false, 1, false)
    var cases: [bool; 35] = [false; 35]
    cases[0] = python_authority
    cases[1] = rust_authority
    cases[2] = cpp_authority
    cases[3] = llm_authority
    cases[4] = lean_authority
    cases[5] = koka_authority
    cases[6] = missing_policy
    cases[7] = wrong_stage
    cases[8] = missing_parent
    cases[9] = unfrozen_parent
    cases[10] = unbound_parent_source
    cases[11] = unbound_parent_semantics
    cases[12] = unbound_parent_freeze
    cases[13] = missing_parent_process_evidence
    cases[14] = recursive_parent_evaluation
    cases[15] = prefilled_parent_seed
    cases[16] = expected_probe_output
    cases[17] = expected_basis_output
    cases[18] = expected_digest
    cases[19] = expected_transcript
    cases[20] = target_evidence
    cases[21] = material_evidence
    cases[22] = target_cost
    cases[23] = target_performance
    cases[24] = semantic_write
    cases[25] = expected_result_write
    cases[26] = review_promotion
    cases[27] = broad_novelty
    cases[28] = historical_novelty
    cases[29] = priority_claim
    cases[30] = claim_ready
    cases[31] = waiver
    cases[32] = bridge_as_seed
    cases[33] = zero_seed
    cases[34] = malformed_seed
    cases
}

fn osk_digest_lineage(lineage: &PireusOskLineage) -> PireusOskDigest
with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = osk_digest_add_words(state, &lineage.parent_source_sha256)
    state = osk_digest_add_words(state, &lineage.parent_semantics_sha256)
    state = osk_digest_add_words(state, &lineage.parent_freeze_sha256)
    state = osk_digest_add_bool(state, lineage.parent_valid)
    state = osk_digest_add_bool(state, lineage.parent_frozen_match)
    state = osk_digest_add_bool(state, lineage.parent_source_file_match)
    state = osk_digest_add_bool(
        state, lineage.parent_semantics_receipt_match)
    state = osk_digest_add_bool(state, lineage.parent_freeze_file_match)
    state = osk_digest_add_bool(state, lineage.parent_evidence_file_match)
    state = osk_digest_add_bool(
        state, lineage.parent_process_evidence_bound)
    state = osk_digest_add_bool(
        state, lineage.parent_process_evidence_externalized)
    state = osk_digest_add_bool(
        state, lineage.parent_recursive_evaluation_used)
    state = osk_digest_add_i64(state, lineage.parent_outcome_kind)
    state = osk_digest_add_bool(state, lineage.parent_existing_bridge)
    state = osk_digest_add_bool(state, lineage.parent_operator_seed)
    state = osk_digest_add_i64(state, lineage.parent_residual_weight)
    state = osk_digest_add_i64(state, lineage.seed_word_cell_checks)
    state = osk_digest_add_i64(state, lineage.seed_word_cell_failures)
    state = osk_digest_add_bool(state, lineage.complete)
    osk_digest_finish(state)
}

fn osk_digest_seed(seed: &[i64; 256]) -> PireusOskDigest
with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    var cell: i64 = 0
    while cell < PIREUS_OSK_CELLS {
        state = osk_digest_add_i64(state, seed[cell])
        cell = cell + 1
    }
    osk_digest_finish(state)
}

fn osk_digest_kernel(kernel: &PireusOskKernel) -> PireusOskDigest
with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = osk_digest_add_i64(state, kernel.operator_kind)
    state = osk_digest_add_i64(state, kernel.bits)
    state = osk_digest_add_i64(state, kernel.lanes)
    state = osk_digest_add_i64(state, kernel.destination_count)
    state = osk_digest_add_i64(state, kernel.terms_per_destination)
    state = osk_digest_add_i64(state, kernel.term_count)
    var term: i64 = 0
    while term < kernel.term_count {
        state = osk_digest_add_i64(state, kernel.destinations[term])
        state = osk_digest_add_i64(state, kernel.left_indices[term])
        state = osk_digest_add_i64(state, kernel.right_indices[term])
        state = osk_digest_add_i64(state, kernel.coefficients[term])
        state = osk_digest_add_i64(state, kernel.source_cells[term])
        term = term + 1
    }
    state = osk_digest_add_i64(state, kernel.unique_term_checks)
    state = osk_digest_add_i64(state, kernel.unique_term_failures)
    state = osk_digest_add_i64(state, kernel.unique_source_checks)
    state = osk_digest_add_i64(state, kernel.unique_source_failures)
    state = osk_digest_add_i64(state, kernel.destination_group_checks)
    state = osk_digest_add_i64(state, kernel.destination_group_failures)
    state = osk_digest_add_i64(state, kernel.xor_address_checks)
    state = osk_digest_add_i64(state, kernel.xor_address_failures)
    state = osk_digest_add_i64(state, kernel.coefficient_checks)
    state = osk_digest_add_i64(state, kernel.coefficient_failures)
    state = osk_digest_add_i64(state, kernel.roundtrip_checks)
    state = osk_digest_add_i64(state, kernel.roundtrip_failures)
    state = osk_digest_add_bool(state, kernel.complete)
    osk_digest_finish(state)
}

fn osk_digest_probes(probes: &[PireusOskProbe; 3]) -> PireusOskDigest
with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    var id: i64 = 0
    while id < PIREUS_OSK_PROBES {
        state = osk_digest_add_i64(state, probes[id].id)
        var lane: i64 = 0
        while lane < PIREUS_OSK_LANES {
            state = osk_digest_add_i64(state, probes[id].a.lanes[lane])
            state = osk_digest_add_i64(state, probes[id].b.lanes[lane])
            state = osk_digest_add_i64(
                state, probes[id].table_output.lanes[lane])
            state = osk_digest_add_i64(
                state, probes[id].ir_output.lanes[lane])
            lane = lane + 1
        }
        state = osk_digest_add_i64(state, probes[id].max_abs_a)
        state = osk_digest_add_i64(state, probes[id].max_abs_b)
        state = osk_digest_add_i64(state, probes[id].uniform_bound)
        state = osk_digest_add_i64(state, probes[id].lane_checks)
        state = osk_digest_add_i64(state, probes[id].equality_failures)
        state = osk_digest_add_i64(state, probes[id].bound_checks)
        state = osk_digest_add_i64(state, probes[id].bound_failures)
        state = osk_digest_add_bool(state, probes[id].complete)
        id = id + 1
    }
    osk_digest_finish(state)
}

fn osk_digest_basis(
    seed: &[i64; 256],
    kernel: &PireusOskKernel,
    basis: &PireusOskBasisCertificate,
) -> PireusOskDigest with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    var left: i64 = 0
    while left < PIREUS_OSK_LANES {
        var right: i64 = 0
        while right < PIREUS_OSK_LANES {
            let witness = pireus_osk_basis_witness(seed, kernel, left, right)
            state = osk_digest_add_i64(state, witness.left)
            state = osk_digest_add_i64(state, witness.right)
            state = osk_digest_add_i64(state, witness.destination)
            state = osk_digest_add_i64(state, witness.coefficient)
            state = osk_digest_add_i64(state, witness.table_value)
            state = osk_digest_add_i64(state, witness.ir_value)
            state = osk_digest_add_i64(state, witness.table_nonzero_lanes)
            state = osk_digest_add_i64(state, witness.ir_nonzero_lanes)
            state = osk_digest_add_i64(state, witness.failures)
            right = right + 1
        }
        left = left + 1
    }
    state = osk_digest_add_i64(state, basis.products)
    state = osk_digest_add_i64(state, basis.lane_checks)
    state = osk_digest_add_i64(state, basis.path_checks)
    state = osk_digest_add_i64(state, basis.destination_checks)
    state = osk_digest_add_i64(state, basis.coefficient_checks)
    state = osk_digest_add_i64(state, basis.single_support_checks)
    state = osk_digest_add_i64(state, basis.failures)
    state = osk_digest_add_bool(state, basis.complete)
    osk_digest_finish(state)
}

fn osk_digest_receipt(
    receipt: &PireusOskReceipt,
    negatives: &PireusOskNegatives,
) -> PireusOskDigest
with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = osk_digest_add_i64(state, receipt.schema)
    state = osk_digest_add_i64(state, receipt.producer_language)
    state = osk_digest_add_i64(state, receipt.producer_role)
    state = osk_digest_add_bool(state, receipt.parent_lineage_bound)
    state = osk_digest_add_bool(state, receipt.parent_frozen_match)
    state = osk_digest_add_bool(
        state, receipt.parent_process_evidence_bound)
    state = osk_digest_add_bool(
        state, receipt.parent_process_evidence_externalized)
    state = osk_digest_add_bool(
        state, receipt.parent_recursive_evaluation_used)
    state = osk_digest_add_bool(state, receipt.operator_seed_admitted)
    state = osk_digest_add_bool(state, receipt.table_evaluator_validated)
    state = osk_digest_add_bool(state, receipt.kernel_ir_complete)
    state = osk_digest_add_bool(state, receipt.ir_evaluator_validated)
    state = osk_digest_add_bool(state, receipt.basis_sweep_complete)
    state = osk_digest_add_bool(state, receipt.dense_probes_complete)
    state = osk_digest_add_bool(state, receipt.generated_operator_candidate)
    state = osk_digest_add_bool(state, receipt.expected_result_used)
    state = osk_digest_add_bool(state, receipt.target_evidence_used)
    state = osk_digest_add_bool(state, receipt.material_evidence_used)
    state = osk_digest_add_bool(state, receipt.target_cost_used)
    state = osk_digest_add_bool(state, receipt.target_performance_used)
    state = osk_digest_add_bool(state, receipt.semantics_frozen)
    state = osk_digest_add_bool(state, receipt.formal_parity_open)
    state = osk_digest_add_bool(state, receipt.effect_parity_open)
    state = osk_digest_add_bool(state, receipt.material_parity_open)
    state = osk_digest_add_bool(state, receipt.broad_novelty)
    state = osk_digest_add_bool(state, receipt.historical_novelty)
    state = osk_digest_add_bool(state, receipt.priority_claim)
    state = osk_digest_add_bool(state, receipt.claim_ready)
    var case: i64 = 0
    while case < PIREUS_OSK_NEGATIVE_CASES {
        state = osk_digest_add_bool(state, negatives.cases[case])
        case = case + 1
    }
    state = osk_digest_add_i64(state, negatives.total)
    state = osk_digest_add_i64(state, negatives.passed)
    osk_digest_finish(state)
}

fn osk_digest_execution(
    probes: &PireusOskDigest,
    basis: &PireusOskDigest,
) -> PireusOskDigest with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = osk_digest_add_words(state, &probes.words)
    state = osk_digest_add_words(state, &basis.words)
    osk_digest_finish(state)
}

fn osk_digest_forge(
    lineage: &PireusOskDigest,
    seed: &PireusOskDigest,
    kernel: &PireusOskDigest,
    probes: &PireusOskDigest,
    basis: &PireusOskDigest,
    receipt: &PireusOskDigest,
) -> PireusOskDigest with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = osk_digest_add_words(state, &lineage.words)
    state = osk_digest_add_words(state, &seed.words)
    state = osk_digest_add_words(state, &kernel.words)
    state = osk_digest_add_words(state, &probes.words)
    state = osk_digest_add_words(state, &basis.words)
    state = osk_digest_add_words(state, &receipt.words)
    osk_digest_finish(state)
}

fn osk_bit(value: bool) -> i64 { if value { 1 } else { 0 } }

/// Exact v8 matcher admitted only after the matcher-free source commit
/// 8d7a128280 and first admissible evidence commit 5c2d6c487b existed in
/// that order. It freezes the finite seed-to-kernel result while broad,
/// historical, priority, parity, material, and claim flags remain false.
fn osk_frozen_mismatch_code(
    result: &PireusOskResult,
    probes: &[PireusOskProbe; 3],
) -> i64 with Mut, Panic, Div {
    if !result.valid || result.error != PIREUS_OSK_OK ||
        result.failure_groups != 0 {
        return 1
    }
    if PIREUS_OSK_BITS != 4 || PIREUS_OSK_LANES != 16 ||
        PIREUS_OSK_DESTINATIONS != 16 ||
        PIREUS_OSK_TERMS_PER_DESTINATION != 16 ||
        PIREUS_OSK_CELLS != 256 || PIREUS_OSK_TERMS != 256 ||
        PIREUS_OSK_BASIS_PRODUCTS != 256 ||
        PIREUS_OSK_BASIS_LANE_CHECKS != 4096 ||
        PIREUS_OSK_PROBES != 3 || PIREUS_OSK_NEGATIVE_CASES != 35 {
        return 1
    }

    let parent_source = osk_parent_source_hash()
    let parent_semantics = osk_parent_semantics_hash()
    let parent_freeze = osk_parent_freeze_hash()
    if !result.lineage.complete || !result.lineage.parent_valid ||
        !result.lineage.parent_frozen_match ||
        !result.lineage.parent_source_file_match ||
        !result.lineage.parent_semantics_receipt_match ||
        !result.lineage.parent_freeze_file_match ||
        !result.lineage.parent_evidence_file_match ||
        !result.lineage.parent_process_evidence_bound ||
        !result.lineage.parent_process_evidence_externalized ||
        result.lineage.parent_recursive_evaluation_used ||
        result.lineage.parent_outcome_kind != PIREUS_ONF_OUTCOME_OPERATOR_SEED ||
        result.lineage.parent_existing_bridge ||
        !result.lineage.parent_operator_seed ||
        result.lineage.parent_residual_weight != 96 ||
        result.lineage.seed_word_cell_checks != PIREUS_OSK_CELLS ||
        result.lineage.seed_word_cell_failures != 0 ||
        !osk_hash_equal(&result.lineage.parent_source_sha256,
            &parent_source) ||
        !osk_hash_equal(&result.lineage.parent_semantics_sha256,
            &parent_semantics) ||
        !osk_hash_equal(&result.lineage.parent_freeze_sha256,
            &parent_freeze) {
        return 2
    }

    let seed_words: [i64; 8] = [
        0, 0, 1010580540, 4042322160,
        2863311530, 2863311530, 2526451350, 1515870810
    ]
    if !osk_hash_equal(&result.seed_words, &seed_words) { return 3 }
    var cell: i64 = 0
    var weight: i64 = 0
    while cell < PIREUS_OSK_CELLS {
        let expected_bit = osk_seed_word_bit(&seed_words, cell)
        if result.seed_cells[cell] != expected_bit { return 3 }
        weight = weight + result.seed_cells[cell]
        cell = cell + 1
    }
    if weight != 96 { return 3 }

    if result.operator_ir.operator_kind !=
            PIREUS_OSK_OPERATOR_TWISTED_XOR_4 ||
        result.operator_ir.bits != PIREUS_OSK_BITS ||
        result.operator_ir.lanes != PIREUS_OSK_LANES ||
        result.operator_ir.destination_count != PIREUS_OSK_DESTINATIONS ||
        result.operator_ir.terms_per_destination !=
            PIREUS_OSK_TERMS_PER_DESTINATION ||
        result.operator_ir.term_count != PIREUS_OSK_TERMS ||
        result.operator_ir.unique_term_checks != PIREUS_OSK_TERMS ||
        result.operator_ir.unique_term_failures != 0 ||
        result.operator_ir.unique_source_checks != PIREUS_OSK_CELLS ||
        result.operator_ir.unique_source_failures != 0 ||
        result.operator_ir.destination_group_checks !=
            PIREUS_OSK_DESTINATIONS ||
        result.operator_ir.destination_group_failures != 0 ||
        result.operator_ir.xor_address_checks != PIREUS_OSK_TERMS ||
        result.operator_ir.xor_address_failures != 0 ||
        result.operator_ir.coefficient_checks != PIREUS_OSK_TERMS ||
        result.operator_ir.coefficient_failures != 0 ||
        result.operator_ir.roundtrip_checks != PIREUS_OSK_TERMS ||
        result.operator_ir.roundtrip_failures != 0 ||
        !result.operator_ir.complete {
        return 4
    }
    var term: i64 = 0
    while term < PIREUS_OSK_TERMS {
        let destination = term / PIREUS_OSK_TERMS_PER_DESTINATION
        let left = term - destination * PIREUS_OSK_TERMS_PER_DESTINATION
        let right = left ^ destination
        let source_cell = left * PIREUS_OSK_LANES + right
        let seed_bit = result.seed_cells[source_cell]
        if seed_bit != 0 && seed_bit != 1 { return 4 }
        let expected_coefficient = if seed_bit == 0 { 1 } else { -1 }
        if result.operator_ir.destinations[term] != destination ||
            result.operator_ir.left_indices[term] != left ||
            result.operator_ir.right_indices[term] != right ||
            result.operator_ir.source_cells[term] != source_cell ||
            result.operator_ir.coefficients[term] !=
                expected_coefficient {
            return 4
        }
        term = term + 1
    }

    if !osk_all_probes_complete(probes) { return 5 }
    var probe: i64 = 0
    while probe < PIREUS_OSK_PROBES {
        let expected_max_abs_a = if probe == 0 { 8 }
            else if probe == 1 { 9 } else { 16 }
        let expected_max_abs_b = if probe == 0 { 8 }
            else if probe == 1 { 11 } else { 15 }
        let expected_uniform_bound = PIREUS_OSK_TERMS_PER_DESTINATION *
            expected_max_abs_a * expected_max_abs_b
        if probes[probe].id != probe ||
            probes[probe].max_abs_a != expected_max_abs_a ||
            probes[probe].max_abs_b != expected_max_abs_b ||
            probes[probe].uniform_bound != expected_uniform_bound ||
            probes[probe].lane_checks != PIREUS_OSK_LANES ||
            probes[probe].equality_failures != 0 ||
            probes[probe].bound_checks != 2 * PIREUS_OSK_LANES ||
            probes[probe].bound_failures != 0 || !probes[probe].complete {
            return 5
        }
        var lane: i64 = 0
        while lane < PIREUS_OSK_LANES {
            let expected_a = if probe == 0 { lane - 8 }
                else if probe == 1 {
                    ((lane * lane + 3 * lane + 1) % 19) - 9
                } else {
                    let magnitude = lane + 1
                    if osk_popcount4(lane) % 2 == 0 {
                        magnitude
                    } else { -magnitude }
                }
            let expected_b = if probe == 0 {
                    ((5 * lane + 3) % 17) - 8
                } else if probe == 1 {
                    ((7 * lane + 2) % 23) - 11
                } else { 15 - lane }
            if probes[probe].a.lanes[lane] != expected_a ||
                probes[probe].b.lanes[lane] != expected_b ||
                probes[probe].table_output.lanes[lane] !=
                    probes[probe].ir_output.lanes[lane] ||
                osk_abs(probes[probe].table_output.lanes[lane]) >
                    probes[probe].uniform_bound ||
                osk_abs(probes[probe].ir_output.lanes[lane]) >
                    probes[probe].uniform_bound {
                return 5
            }
            lane = lane + 1
        }
        probe = probe + 1
    }

    if result.basis.products != PIREUS_OSK_BASIS_PRODUCTS ||
        result.basis.lane_checks != PIREUS_OSK_BASIS_LANE_CHECKS ||
        result.basis.path_checks != PIREUS_OSK_BASIS_LANE_CHECKS ||
        result.basis.destination_checks != PIREUS_OSK_BASIS_PRODUCTS ||
        result.basis.coefficient_checks != PIREUS_OSK_BASIS_PRODUCTS ||
        result.basis.single_support_checks != 2 * PIREUS_OSK_BASIS_PRODUCTS ||
        result.basis.failures != 0 || !result.basis.complete {
        return 6
    }

    if result.candidate.kind != PIREUS_OSK_CANDIDATE_GENERATED_OPERATOR ||
        result.candidate.operator_kind != PIREUS_OSK_OPERATOR_TWISTED_XOR_4 ||
        result.candidate.parent_outcome_kind !=
            PIREUS_ONF_OUTCOME_OPERATOR_SEED ||
        result.candidate.parent_residual_weight != 96 ||
        !osk_hash_equal(&result.candidate.seed_words, &seed_words) ||
        !result.candidate.generated ||
        !result.candidate.future_parent_eligible {
        return 7
    }

    if result.receipt.schema != PIREUS_OSK_SCHEMA ||
        result.receipt.producer_language != PIREUS_ONF_LANGUAGE_SOUNIO ||
        result.receipt.producer_role != PIREUS_ONF_ROLE_SEMANTIC_AUTHORITY ||
        !result.receipt.parent_lineage_bound ||
        !result.receipt.parent_frozen_match ||
        !result.receipt.parent_process_evidence_bound ||
        !result.receipt.parent_process_evidence_externalized ||
        result.receipt.parent_recursive_evaluation_used ||
        !result.receipt.operator_seed_admitted ||
        !result.receipt.table_evaluator_validated ||
        !result.receipt.kernel_ir_complete ||
        !result.receipt.ir_evaluator_validated ||
        !result.receipt.basis_sweep_complete ||
        !result.receipt.dense_probes_complete ||
        !result.receipt.generated_operator_candidate ||
        result.receipt.expected_result_used ||
        result.receipt.target_evidence_used ||
        result.receipt.material_evidence_used ||
        result.receipt.target_cost_used ||
        result.receipt.target_performance_used ||
        result.receipt.semantics_frozen || result.receipt.formal_parity_open ||
        result.receipt.effect_parity_open || result.receipt.material_parity_open ||
        result.receipt.broad_novelty || result.receipt.historical_novelty ||
        result.receipt.priority_claim || result.receipt.claim_ready {
        return 8
    }
    if result.negatives.total != PIREUS_OSK_NEGATIVE_CASES ||
        result.negatives.passed != PIREUS_OSK_NEGATIVE_CASES {
        return 8
    }
    var negative: i64 = 0
    while negative < PIREUS_OSK_NEGATIVE_CASES {
        if !result.negatives.cases[negative] { return 8 }
        negative = negative + 1
    }

    // These are content locks from the committed matcher-free Sounio
    // transcript. The freeze receipt binds their derivation and provenance.
    let lineage_digest: [i64; 8] = [
        3675738762, 3140284394, 3259900661, 547498260,
        109840838, 2653613498, 2978037697, 3365717310
    ]
    let seed_digest: [i64; 8] = [
        3662741265, 1028891527, 3657197346, 3021334856,
        3818359963, 770878430, 1243580868, 2688541637
    ]
    let kernel_digest: [i64; 8] = [
        1749204252, 3788076331, 2718311306, 1135487091,
        2444572534, 1334381576, 168716928, 3286120085
    ]
    let probe_digest: [i64; 8] = [
        1071358865, 860685179, 1231518479, 3237492267,
        2981097347, 934135757, 2013439827, 3950969268
    ]
    let basis_digest: [i64; 8] = [
        4216575109, 2290489890, 3547428631, 927155344,
        3366227467, 3640736892, 2806448532, 1801619831
    ]
    let receipt_digest: [i64; 8] = [
        785940302, 3092856087, 617194821, 3390740065,
        3707112113, 2409147936, 489095688, 1272780877
    ]
    let forge_digest: [i64; 8] = [
        301584187, 4096262081, 1069815211, 2815305046,
        1955365271, 1052119655, 2562120217, 1224337835
    ]
    let execution_digest: [i64; 8] = [
        1261711217, 3184519527, 2781525649, 20130061,
        2413728867, 3763333867, 3992614201, 871017177
    ]
    if !osk_hash_equal(&result.lineage_digest.words, &lineage_digest) ||
        !osk_hash_equal(&result.seed_digest.words, &seed_digest) ||
        !osk_hash_equal(&result.kernel_digest.words, &kernel_digest) ||
        !osk_hash_equal(&result.probe_digest.words, &probe_digest) ||
        !osk_hash_equal(&result.basis_digest.words, &basis_digest) ||
        !osk_hash_equal(&result.receipt_digest.words, &receipt_digest) ||
        !osk_hash_equal(&result.forge_digest.words, &forge_digest) ||
        !osk_hash_equal(&result.candidate.kernel_digest.words,
            &kernel_digest) ||
        !osk_hash_equal(&result.candidate.execution_digest.words,
            &execution_digest) {
        return 9
    }
    0
}

fn osk_print_words(words: &[i64; 8]) with IO, Mut, Panic {
    var word: i64 = 0
    while word < PIREUS_OSK_WORDS {
        if word > 0 { print(":") }
        print_int(words[word])
        word = word + 1
    }
}

fn osk_print_digest(digest: &PireusOskDigest) with IO, Mut, Panic {
    osk_print_words(&digest.words)
}

fn osk_print_vector(vector: &PireusOskVector) with IO, Mut, Panic {
    var lane: i64 = 0
    while lane < PIREUS_OSK_LANES {
        if lane > 0 { print(":") }
        print_int(vector.lanes[lane])
        lane = lane + 1
    }
}

fn osk_print_probe_vector(
    probes: &[PireusOskProbe; 3],
    probe: i64,
    vector_kind: i64,
) with IO, Mut, Panic {
    var lane: i64 = 0
    while lane < PIREUS_OSK_LANES {
        if lane > 0 { print(":") }
        if vector_kind == 0 {
            print_int(probes[probe].a.lanes[lane])
        } else if vector_kind == 1 {
            print_int(probes[probe].b.lanes[lane])
        } else if vector_kind == 2 {
            print_int(probes[probe].table_output.lanes[lane])
        } else {
            print_int(probes[probe].ir_output.lanes[lane])
        }
        lane = lane + 1
    }
}

fn osk_print_negative(name: string, refused: bool) with IO {
    print("PIREUS_OSK_NEGATIVE name=")
    print(name)
    print(" refused=")
    print_int(osk_bit(refused))
    print("\n")
}

fn osk_emit_result(
    result: &PireusOskResult,
    probes: &[PireusOskProbe; 3],
    frozen_match: bool,
    frozen_mismatch_code: i64,
)
with IO, Mut, Panic, Div {
    print("SOUNIO_AUTHORITY schema=pireus-operator-seed-kernel.v8")
    print(" role=SEMANTIC_AUTHORITY stage=SOUNIO_EXECUTABLE\n")

    print("PIREUS_OSK_LINEAGE parent_valid=")
    print_int(osk_bit(result.lineage.parent_valid))
    print(" parent_frozen_match=")
    print_int(osk_bit(result.lineage.parent_frozen_match))
    print(" source_file_match=")
    print_int(osk_bit(result.lineage.parent_source_file_match))
    print(" semantics_receipt_match=")
    print_int(osk_bit(result.lineage.parent_semantics_receipt_match))
    print(" freeze_file_match=")
    print_int(osk_bit(result.lineage.parent_freeze_file_match))
    print(" evidence_file_match=")
    print_int(osk_bit(result.lineage.parent_evidence_file_match))
    print(" process_evidence_bound=")
    print_int(osk_bit(result.lineage.parent_process_evidence_bound))
    print(" process_evidence_externalized=")
    print_int(osk_bit(result.lineage.parent_process_evidence_externalized))
    print(" recursive_parent_evaluation=")
    print_int(osk_bit(result.lineage.parent_recursive_evaluation_used))
    print(" parent_outcome=")
    print_int(result.lineage.parent_outcome_kind)
    print(" parent_bridge=")
    print_int(osk_bit(result.lineage.parent_existing_bridge))
    print(" parent_seed=")
    print_int(osk_bit(result.lineage.parent_operator_seed))
    print(" parent_residual_weight=")
    print_int(result.lineage.parent_residual_weight)
    print(" word_cell_checks=")
    print_int(result.lineage.seed_word_cell_checks)
    print(" word_cell_failures=")
    print_int(result.lineage.seed_word_cell_failures)
    print(" complete=")
    print_int(osk_bit(result.lineage.complete))
    print("\n")
    print("PIREUS_OSK_PARENT_HASH name=source value=")
    osk_print_words(&result.lineage.parent_source_sha256); print("\n")
    print("PIREUS_OSK_PARENT_HASH name=semantics value=")
    osk_print_words(&result.lineage.parent_semantics_sha256); print("\n")
    print("PIREUS_OSK_PARENT_HASH name=freeze value=")
    osk_print_words(&result.lineage.parent_freeze_sha256); print("\n")

    print("PIREUS_OSK_SEED words=")
    osk_print_words(&result.seed_words)
    print(" weight=")
    print_int(result.lineage.parent_residual_weight)
    print("\n")
    var cell: i64 = 0
    while cell < PIREUS_OSK_CELLS {
        print("PIREUS_OSK_SEED_CELL id=")
        print_int(cell)
        print(" left="); print_int(cell / PIREUS_OSK_LANES)
        print(" right=")
        print_int(cell - (cell / PIREUS_OSK_LANES) * PIREUS_OSK_LANES)
        print(" bit="); print_int(result.seed_cells[cell])
        print("\n")
        cell = cell + 1
    }

    print("PIREUS_OSK_KERNEL kind=")
    print_int(result.operator_ir.operator_kind)
    print(" bits="); print_int(result.operator_ir.bits)
    print(" lanes="); print_int(result.operator_ir.lanes)
    print(" destinations="); print_int(result.operator_ir.destination_count)
    print(" terms_per_destination=")
    print_int(result.operator_ir.terms_per_destination)
    print(" terms="); print_int(result.operator_ir.term_count)
    print(" unique_term_checks=")
    print_int(result.operator_ir.unique_term_checks)
    print(" unique_term_failures=")
    print_int(result.operator_ir.unique_term_failures)
    print(" unique_source_checks=")
    print_int(result.operator_ir.unique_source_checks)
    print(" unique_source_failures=")
    print_int(result.operator_ir.unique_source_failures)
    print(" group_checks=")
    print_int(result.operator_ir.destination_group_checks)
    print(" group_failures=")
    print_int(result.operator_ir.destination_group_failures)
    print(" xor_checks=")
    print_int(result.operator_ir.xor_address_checks)
    print(" xor_failures=")
    print_int(result.operator_ir.xor_address_failures)
    print(" coefficient_checks=")
    print_int(result.operator_ir.coefficient_checks)
    print(" coefficient_failures=")
    print_int(result.operator_ir.coefficient_failures)
    print(" roundtrip_checks=")
    print_int(result.operator_ir.roundtrip_checks)
    print(" roundtrip_failures=")
    print_int(result.operator_ir.roundtrip_failures)
    print(" complete="); print_int(osk_bit(result.operator_ir.complete))
    print("\n")
    var term: i64 = 0
    while term < PIREUS_OSK_TERMS {
        print("PIREUS_OSK_TERM id="); print_int(term)
        print(" destination="); print_int(result.operator_ir.destinations[term])
        print(" left="); print_int(result.operator_ir.left_indices[term])
        print(" right="); print_int(result.operator_ir.right_indices[term])
        print(" coefficient="); print_int(result.operator_ir.coefficients[term])
        print(" source_cell="); print_int(result.operator_ir.source_cells[term])
        print("\n")
        term = term + 1
    }

    print("PIREUS_OSK_BASIS products=")
    print_int(result.basis.products)
    print(" lane_checks="); print_int(result.basis.lane_checks)
    print(" path_checks="); print_int(result.basis.path_checks)
    print(" destination_checks="); print_int(result.basis.destination_checks)
    print(" coefficient_checks="); print_int(result.basis.coefficient_checks)
    print(" single_support_checks=")
    print_int(result.basis.single_support_checks)
    print(" failures="); print_int(result.basis.failures)
    print(" complete="); print_int(osk_bit(result.basis.complete))
    print("\n")
    var left: i64 = 0
    while left < PIREUS_OSK_LANES {
        var right: i64 = 0
        while right < PIREUS_OSK_LANES {
            let witness = pireus_osk_basis_witness(
                &result.seed_cells, &result.operator_ir, left, right)
            print("PIREUS_OSK_BASIS_PRODUCT left="); print_int(left)
            print(" right="); print_int(right)
            print(" destination="); print_int(witness.destination)
            print(" coefficient="); print_int(witness.coefficient)
            print(" table_value="); print_int(witness.table_value)
            print(" ir_value="); print_int(witness.ir_value)
            print(" table_nonzero="); print_int(witness.table_nonzero_lanes)
            print(" ir_nonzero="); print_int(witness.ir_nonzero_lanes)
            print(" lane_checks="); print_int(witness.lane_checks)
            print(" failures="); print_int(witness.failures)
            print(" complete="); print_int(osk_bit(witness.complete))
            print("\n")
            right = right + 1
        }
        left = left + 1
    }

    var probe: i64 = 0
    while probe < PIREUS_OSK_PROBES {
        print("PIREUS_OSK_PROBE id="); print_int(probes[probe].id)
        print(" max_abs_a="); print_int(probes[probe].max_abs_a)
        print(" max_abs_b="); print_int(probes[probe].max_abs_b)
        print(" uniform_bound="); print_int(probes[probe].uniform_bound)
        print(" lane_checks="); print_int(probes[probe].lane_checks)
        print(" equality_failures=")
        print_int(probes[probe].equality_failures)
        print(" bound_checks="); print_int(probes[probe].bound_checks)
        print(" bound_failures="); print_int(probes[probe].bound_failures)
        print(" complete="); print_int(osk_bit(probes[probe].complete))
        print("\n")
        print("PIREUS_OSK_PROBE_VECTOR id="); print_int(probe)
        print(" name=a values="); osk_print_probe_vector(probes, probe, 0)
        print("\n")
        print("PIREUS_OSK_PROBE_VECTOR id="); print_int(probe)
        print(" name=b values="); osk_print_probe_vector(probes, probe, 1)
        print("\n")
        print("PIREUS_OSK_PROBE_OUTPUT id="); print_int(probe)
        print(" path=table values=")
        osk_print_probe_vector(probes, probe, 2)
        print("\n")
        print("PIREUS_OSK_PROBE_OUTPUT id="); print_int(probe)
        print(" path=ir values=")
        osk_print_probe_vector(probes, probe, 3)
        print("\n")
        probe = probe + 1
    }

    print("PIREUS_OSK_CANDIDATE kind=")
    print_int(result.candidate.kind)
    print(" operator_kind="); print_int(result.candidate.operator_kind)
    print(" parent_outcome="); print_int(result.candidate.parent_outcome_kind)
    print(" parent_residual_weight=")
    print_int(result.candidate.parent_residual_weight)
    print(" generated="); print_int(osk_bit(result.candidate.generated))
    print(" future_parent_eligible=")
    print_int(osk_bit(result.candidate.future_parent_eligible))
    print(" seed_words="); osk_print_words(&result.candidate.seed_words)
    print(" kernel_digest=")
    osk_print_digest(&result.candidate.kernel_digest)
    print(" execution_digest=")
    osk_print_digest(&result.candidate.execution_digest)
    print("\n")

    print("PIREUS_OSK_RECEIPT schema=")
    print_int(result.receipt.schema)
    print(" producer_language="); print_int(result.receipt.producer_language)
    print(" producer_role="); print_int(result.receipt.producer_role)
    print(" parent_lineage_bound=")
    print_int(osk_bit(result.receipt.parent_lineage_bound))
    print(" parent_frozen_match=")
    print_int(osk_bit(result.receipt.parent_frozen_match))
    print(" parent_process_evidence_bound=")
    print_int(osk_bit(result.receipt.parent_process_evidence_bound))
    print(" parent_process_evidence_externalized=")
    print_int(osk_bit(result.receipt.parent_process_evidence_externalized))
    print(" parent_recursive_evaluation_used=")
    print_int(osk_bit(result.receipt.parent_recursive_evaluation_used))
    print(" seed_admitted=")
    print_int(osk_bit(result.receipt.operator_seed_admitted))
    print(" table_evaluator=")
    print_int(osk_bit(result.receipt.table_evaluator_validated))
    print(" kernel_ir="); print_int(osk_bit(result.receipt.kernel_ir_complete))
    print(" ir_evaluator=")
    print_int(osk_bit(result.receipt.ir_evaluator_validated))
    print(" basis="); print_int(osk_bit(result.receipt.basis_sweep_complete))
    print(" probes="); print_int(osk_bit(result.receipt.dense_probes_complete))
    print(" candidate=")
    print_int(osk_bit(result.receipt.generated_operator_candidate))
    print(" expected_result_used=")
    print_int(osk_bit(result.receipt.expected_result_used))
    print(" target_evidence_used=")
    print_int(osk_bit(result.receipt.target_evidence_used))
    print(" material_evidence_used=")
    print_int(osk_bit(result.receipt.material_evidence_used))
    print(" target_cost_used=")
    print_int(osk_bit(result.receipt.target_cost_used))
    print(" target_performance_used=")
    print_int(osk_bit(result.receipt.target_performance_used))
    print(" semantics_frozen=")
    print_int(osk_bit(result.receipt.semantics_frozen))
    print(" formal_parity_open=")
    print_int(osk_bit(result.receipt.formal_parity_open))
    print(" effect_parity_open=")
    print_int(osk_bit(result.receipt.effect_parity_open))
    print(" material_parity_open=")
    print_int(osk_bit(result.receipt.material_parity_open))
    print(" broad_novelty=")
    print_int(osk_bit(result.receipt.broad_novelty))
    print(" historical_novelty=")
    print_int(osk_bit(result.receipt.historical_novelty))
    print(" priority="); print_int(osk_bit(result.receipt.priority_claim))
    print(" claim_ready="); print_int(osk_bit(result.receipt.claim_ready))
    print("\n")

    osk_print_negative("python_authority", result.negatives.cases[0])
    osk_print_negative("rust_authority", result.negatives.cases[1])
    osk_print_negative("cpp_authority", result.negatives.cases[2])
    osk_print_negative("llm_authority", result.negatives.cases[3])
    osk_print_negative("lean_authority", result.negatives.cases[4])
    osk_print_negative("koka_authority", result.negatives.cases[5])
    osk_print_negative("missing_policy", result.negatives.cases[6])
    osk_print_negative("wrong_stage", result.negatives.cases[7])
    osk_print_negative("missing_parent", result.negatives.cases[8])
    osk_print_negative("unfrozen_parent", result.negatives.cases[9])
    osk_print_negative("unbound_parent_source", result.negatives.cases[10])
    osk_print_negative("unbound_parent_semantics", result.negatives.cases[11])
    osk_print_negative("unbound_parent_freeze", result.negatives.cases[12])
    osk_print_negative(
        "missing_parent_process_evidence", result.negatives.cases[13])
    osk_print_negative(
        "recursive_parent_evaluation", result.negatives.cases[14])
    osk_print_negative("prefilled_parent_seed", result.negatives.cases[15])
    osk_print_negative("expected_probe_output", result.negatives.cases[16])
    osk_print_negative("expected_basis_output", result.negatives.cases[17])
    osk_print_negative("expected_digest", result.negatives.cases[18])
    osk_print_negative("expected_transcript", result.negatives.cases[19])
    osk_print_negative("target_evidence", result.negatives.cases[20])
    osk_print_negative("material_evidence", result.negatives.cases[21])
    osk_print_negative("target_cost", result.negatives.cases[22])
    osk_print_negative("target_performance", result.negatives.cases[23])
    osk_print_negative("semantic_write", result.negatives.cases[24])
    osk_print_negative("expected_result_write", result.negatives.cases[25])
    osk_print_negative("review_promotion", result.negatives.cases[26])
    osk_print_negative("broad_novelty", result.negatives.cases[27])
    osk_print_negative("historical_novelty", result.negatives.cases[28])
    osk_print_negative("priority_claim", result.negatives.cases[29])
    osk_print_negative("claim_ready", result.negatives.cases[30])
    osk_print_negative("waiver", result.negatives.cases[31])
    osk_print_negative("bridge_as_seed", result.negatives.cases[32])
    osk_print_negative("zero_seed", result.negatives.cases[33])
    osk_print_negative("malformed_seed", result.negatives.cases[34])
    print("PIREUS_OSK_NEGATIVES total="); print_int(result.negatives.total)
    print(" passed="); print_int(result.negatives.passed)
    print("\n")

    print("PIREUS_OSK_DIGEST name=lineage value=")
    osk_print_digest(&result.lineage_digest); print("\n")
    print("PIREUS_OSK_DIGEST name=seed value=")
    osk_print_digest(&result.seed_digest); print("\n")
    print("PIREUS_OSK_DIGEST name=kernel value=")
    osk_print_digest(&result.kernel_digest); print("\n")
    print("PIREUS_OSK_DIGEST name=probe value=")
    osk_print_digest(&result.probe_digest); print("\n")
    print("PIREUS_OSK_DIGEST name=basis value=")
    osk_print_digest(&result.basis_digest); print("\n")
    print("PIREUS_OSK_DIGEST name=receipt value=")
    osk_print_digest(&result.receipt_digest); print("\n")
    print("PIREUS_OSK_DIGEST name=forge value=")
    osk_print_digest(&result.forge_digest); print("\n")

    print("PIREUS_OSK_RESULT valid="); print_int(osk_bit(result.valid))
    print(" error="); print_int(result.error)
    print(" failure_groups="); print_int(result.failure_groups)
    print(" claim_ready="); print_int(osk_bit(result.receipt.claim_ready))
    print("\n")
    print("PIREUS_OSK_FROZEN match="); print_int(osk_bit(frozen_match))
    print(" mismatch_code="); print_int(frozen_mismatch_code)
    print("\n")
}

pub fn pireus_operator_seed_kernel_execute(
    request: &PireusOskRequest,
    paths: &PireusOskParentPaths,
    emit_transcript: bool,
) -> PireusOskSummary with IO, Mut, Panic, Div, Alloc, Epistemic {
    let request_error = osk_request_error(request)
    let admission = osk_build_seed_admission(paths)
    let kernel = osk_build_kernel(&admission.seed_cells)
    let probes = osk_build_probes(&admission.seed_cells, &kernel)
    let probes_complete = osk_all_probes_complete(&probes)
    let basis = osk_build_basis_certificate(&admission.seed_cells, &kernel)
    let negative_cases = osk_build_negative_cases()
    var negative_passed: i64 = 0
    var negative_case: i64 = 0
    while negative_case < PIREUS_OSK_NEGATIVE_CASES {
        if negative_cases[negative_case] {
            negative_passed = negative_passed + 1
        }
        negative_case = negative_case + 1
    }
    let negatives = PireusOskNegatives {
        cases: negative_cases,
        total: PIREUS_OSK_NEGATIVE_CASES,
        passed: negative_passed,
    }
    let receipt = PireusOskReceipt {
        schema: PIREUS_OSK_SCHEMA,
        producer_language: PIREUS_ONF_LANGUAGE_SOUNIO,
        producer_role: PIREUS_ONF_ROLE_SEMANTIC_AUTHORITY,
        parent_lineage_bound: admission.lineage.complete,
        parent_frozen_match: admission.lineage.parent_frozen_match,
        parent_process_evidence_bound:
            admission.lineage.parent_process_evidence_bound,
        parent_process_evidence_externalized:
            admission.lineage.parent_process_evidence_externalized,
        parent_recursive_evaluation_used:
            admission.lineage.parent_recursive_evaluation_used,
        operator_seed_admitted: admission.seed_admitted,
        table_evaluator_validated: probes_complete && basis.complete,
        kernel_ir_complete: kernel.complete,
        ir_evaluator_validated: probes_complete && basis.complete,
        basis_sweep_complete: basis.complete,
        dense_probes_complete: probes_complete,
        generated_operator_candidate: admission.lineage.complete &&
            kernel.complete && probes_complete && basis.complete,
        expected_result_used: false,
        target_evidence_used: false,
        material_evidence_used: false,
        target_cost_used: false,
        target_performance_used: false,
        semantics_frozen: false,
        formal_parity_open: false,
        effect_parity_open: false,
        material_parity_open: false,
        broad_novelty: false,
        historical_novelty: false,
        priority_claim: false,
        claim_ready: false,
    }
    let lineage_digest = osk_digest_lineage(&admission.lineage)
    let seed_digest = osk_digest_seed(&admission.seed_cells)
    let kernel_digest = osk_digest_kernel(&kernel)
    let probe_digest = osk_digest_probes(&probes)
    let basis_digest = osk_digest_basis(&admission.seed_cells, &kernel, &basis)
    let receipt_digest = osk_digest_receipt(&receipt, &negatives)
    let execution_digest = osk_digest_execution(&probe_digest, &basis_digest)
    let forge_digest = osk_digest_forge(
        &lineage_digest, &seed_digest, &kernel_digest,
        &probe_digest, &basis_digest, &receipt_digest)
    let candidate = PireusOskGenomeCandidate {
        kind: PIREUS_OSK_CANDIDATE_GENERATED_OPERATOR,
        operator_kind: PIREUS_OSK_OPERATOR_TWISTED_XOR_4,
        parent_outcome_kind: admission.lineage.parent_outcome_kind,
        parent_residual_weight: admission.lineage.parent_residual_weight,
        seed_words: admission.seed_words,
        kernel_digest: kernel_digest,
        execution_digest: execution_digest,
        generated: receipt.generated_operator_candidate,
        future_parent_eligible: receipt.generated_operator_candidate &&
            !receipt.broad_novelty && !receipt.historical_novelty &&
            !receipt.priority_claim && !receipt.claim_ready,
    }
    var failure_groups: i64 = 0
    if request_error != PIREUS_OSK_OK { failure_groups = failure_groups + 1 }
    if !admission.lineage.complete || !admission.seed_admitted ||
        !admission.seed_cells_valid || !kernel.complete ||
        !probes_complete || !basis.complete ||
        !receipt.parent_process_evidence_bound ||
        !receipt.parent_process_evidence_externalized ||
        receipt.parent_recursive_evaluation_used ||
        negatives.passed != negatives.total ||
        !receipt.generated_operator_candidate ||
        receipt.expected_result_used || receipt.target_evidence_used ||
        receipt.material_evidence_used || receipt.target_cost_used ||
        receipt.target_performance_used || receipt.semantics_frozen ||
        receipt.formal_parity_open || receipt.effect_parity_open ||
        receipt.material_parity_open || receipt.broad_novelty ||
        receipt.historical_novelty || receipt.priority_claim ||
        receipt.claim_ready {
        failure_groups = failure_groups + 1
    }
    if !pireus_osk_digest_nonzero(&lineage_digest) ||
        !pireus_osk_digest_nonzero(&seed_digest) ||
        !pireus_osk_digest_nonzero(&kernel_digest) ||
        !pireus_osk_digest_nonzero(&probe_digest) ||
        !pireus_osk_digest_nonzero(&basis_digest) ||
        !pireus_osk_digest_nonzero(&receipt_digest) ||
        !pireus_osk_digest_nonzero(&forge_digest) {
        failure_groups = failure_groups + 1
    }
    let result = PireusOskResult {
        valid: failure_groups == 0,
        error: if failure_groups == 0 { PIREUS_OSK_OK }
            else if request_error != PIREUS_OSK_OK { request_error }
            else if !admission.seed_admitted || !admission.seed_cells_valid {
                PIREUS_OSK_ERR_SEED
            }
            else if !admission.lineage.complete { PIREUS_OSK_ERR_LINEAGE }
            else if !kernel.complete { PIREUS_OSK_ERR_IR }
            else { PIREUS_OSK_ERR_EXECUTION },
        lineage: admission.lineage,
        seed_words: admission.seed_words,
        seed_cells: admission.seed_cells,
        operator_ir: kernel,
        basis: basis,
        candidate: candidate,
        receipt: receipt,
        negatives: negatives,
        lineage_digest: lineage_digest,
        seed_digest: seed_digest,
        kernel_digest: kernel_digest,
        probe_digest: probe_digest,
        basis_digest: basis_digest,
        receipt_digest: receipt_digest,
        forge_digest: forge_digest,
        failure_groups: failure_groups,
    }
    let frozen_mismatch_code = osk_frozen_mismatch_code(&result, &probes)
    let frozen_match = frozen_mismatch_code == 0
    if emit_transcript {
        osk_emit_result(
            &result, &probes, frozen_match, frozen_mismatch_code)
    }
    PireusOskSummary {
        valid: result.valid,
        error: result.error,
        failure_groups: result.failure_groups,
        structural_failures: if result.valid { 0 } else { 1 },
        negative_total: result.negatives.total,
        negative_failures: result.negatives.total - result.negatives.passed,
        frozen_match: frozen_match,
        frozen_mismatch_code: frozen_mismatch_code,
        claim_ready: result.receipt.claim_ready,
    }
}
