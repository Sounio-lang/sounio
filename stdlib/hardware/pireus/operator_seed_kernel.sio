pub const PIREUS_OSK_BITS: i64 = 4
pub const PIREUS_OSK_LANES: i64 = 16
pub const PIREUS_OSK_CELLS: i64 = 256
pub const PIREUS_OSK_WORDS: i64 = 8
pub const PIREUS_OSK_WORD_BITS: i64 = 32
pub const PIREUS_OSK_DESTINATIONS: i64 = 16
pub const PIREUS_OSK_TERMS_PER_DESTINATION: i64 = 16
pub const PIREUS_OSK_TERMS: i64 = 256
pub const PIREUS_OSK_PROBES: i64 = 3
pub const PIREUS_OSK_BASIS_PRODUCTS: i64 = 256
pub const PIREUS_OSK_BASIS_LANE_CHECKS: i64 = 4096

pub const PIREUS_OSK_OPERATOR_TWISTED_XOR_4: i64 = 1
pub const PIREUS_OSK_CANDIDATE_GENERATED_OPERATOR: i64 = 1

pub const PIREUS_OSK_OK: i64 = 0
pub const PIREUS_OSK_ERR_AUTHORITY: i64 = 1
