//! Sounio semantic authority for Pireus Operator Seed Kernel v8.
//!
//! This first executable is matcher-free. It obtains its parent seed only by
//! parsing the exact hash-bound v7 Sounio process evidence. It contains fixed
//! probe inputs and independent algorithms, but no expected probe output,
//! basis transcript, generated operator identity, final digest, or matcher.

use hardware::pireus::operator_novelty_feedback::{
    PIREUS_ONF_OK,
    PIREUS_ONF_OUTCOME_OPERATOR_SEED,
    PIREUS_ONF_LANGUAGE_SOUNIO,
    PIREUS_ONF_LANGUAGE_LEAN,
    PIREUS_ONF_LANGUAGE_KOKA,
    PIREUS_ONF_LANGUAGE_CPP,
    PIREUS_ONF_LANGUAGE_LLM,
    PIREUS_ONF_LANGUAGE_PYTHON,
    PIREUS_ONF_LANGUAGE_RUST,
    PIREUS_ONF_ROLE_SEMANTIC_AUTHORITY,
    PIREUS_ONF_ROLE_FORMAL_PARITY,
    PIREUS_ONF_ROLE_EFFECT_PARITY,
    PIREUS_ONF_ROLE_MATERIAL_PARITY,
    PIREUS_ONF_ROLE_REVIEW_ONLY,
    PIREUS_ONF_STAGE_SOUNIO_EXECUTABLE,
}
use crypto::sha256::{
    SHA256State,
    sha256_init, sha256_update, sha256_finalize, sha256_digest_byte,
}

