//! Sounio-first admission of sealed XOR material-parity receipts.
//!
//! Material producers own observations. This module owns only the typed
//! admission rules and refuses to infer unnamed node coverage or cost.

use hardware::pireus::xor_lowering_legality::{
    PIREUS_XOR_LOWERING_OK,
    pireus_xor_lowering_evaluate,
    pireus_xor_lowering_matches_frozen_semantics,
}
use crypto::sha256::{
    SHA256State,
    sha256_init, sha256_update, sha256_finalize, sha256_digest_byte,
}

