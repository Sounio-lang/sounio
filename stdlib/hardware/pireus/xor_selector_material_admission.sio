fn pxa_parent_binding_valid(
    commit: &[i64; 5],
    binding_digest: &PireusXorAdmissionDigest,
    lowering_live: bool,
) -> bool
with Mut, Panic, Div {
    let expected_commit = pxa_expected_garden_commit()
    let expected_digest = pxa_parent_bindings_digest()
    pxa_commit_equal(commit, &expected_commit) &&
        pxa_hash_equal(&binding_digest.words, &expected_digest.words) &&
        lowering_live
}

fn pxa_binding_error(receipt_match: bool, evidence_match: bool) -> i64 {
    if !receipt_match { return PIREUS_XOR_ADMISSION_BINDING_RECEIPT }
    if !evidence_match { return PIREUS_XOR_ADMISSION_BINDING_EVIDENCE }
    PIREUS_XOR_ADMISSION_BINDING_OK
}

fn pxa_darwin_receipt(
    receipt_match: bool,
    evidence_match: bool,
) -> PireusXorMaterialReceiptInput {
    PireusXorMaterialReceiptInput {
        target_id: PIREUS_XOR_ADMISSION_TARGET_DARWIN_XEON,
        binding_target_id: PIREUS_XOR_ADMISSION_TARGET_DARWIN_XEON,
        producer_language: PIREUS_XOR_ADMISSION_LANGUAGE_CPP,
        producer_role: PIREUS_XOR_ADMISSION_ROLE_MATERIAL_PARITY,
        receipt_stage: PIREUS_XOR_ADMISSION_STAGE_PARITY_OPEN,
        parity_receipt_valid: true,
        claim_ready: false,
        binding_error: pxa_binding_error(receipt_match, evidence_match),
        explicit_node_evidence: [true, true, true, true, true],
        sufficient_node_evidence: [true, true, true, true, true],
        unnamed_resolved_node_count: 0,
        payload_exact: false,
        operand_encoding_status: PIREUS_XOR_ADMISSION_ENCODING_UNCOMPARED,
        static_selector_sites: 3,
        secondary_selector_sites: 0,
        result_pass: true,
        result_reproducible: true,
        binary_reproducible: true,
    }
}

