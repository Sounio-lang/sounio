fn pxa_hash_equal(left: &[i64; 8], right: &[i64; 8]) -> bool
with Mut, Panic {
    var i: i64 = 0
    while i < 8 {
        if left[i] != right[i] { return false }
        i = i + 1
    }
    true
}

fn pxa_hash_nonzero(value: &[i64; 8]) -> bool with Mut, Panic {
    var i: i64 = 0
    while i < 8 {
        if value[i] != 0 { return true }
        i = i + 1
    }
    false
}

fn pxa_commit_equal(left: &[i64; 5], right: &[i64; 5]) -> bool
with Mut, Panic {
    var i: i64 = 0
    while i < 5 {
        if left[i] != right[i] { return false }
        i = i + 1
    }
    true
}

