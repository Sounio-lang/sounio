fn onf_request_error(request: &PireusOnfRequest) -> i64 {
    if request.policy_state != PIREUS_ONF_POLICY_READY {
        return PIREUS_ONF_ERR_POLICY
    }
    if request.producer_language != PIREUS_ONF_LANGUAGE_SOUNIO ||
        request.producer_role != PIREUS_ONF_ROLE_SEMANTIC_AUTHORITY {
        return PIREUS_ONF_ERR_AUTHORITY
    }
    if request.stage != PIREUS_ONF_STAGE_SOUNIO_EXECUTABLE {
        return PIREUS_ONF_ERR_STAGE
    }
    if !request.garden_bound || !request.contract_bound ||
        !request.parent_source_bound || !request.parent_semantics_bound ||
        !request.parent_freeze_bound || !request.parent_parity_open_bound ||
        !request.parent_material_bound {
        return PIREUS_ONF_ERR_LINEAGE
    }
    if !request.complete_enumeration_required ||
        request.enumeration_limit != PIREUS_ONF_GRAMMAR_CARDINALITY {
        return PIREUS_ONF_ERR_GRAMMAR
    }
    if request.expected_frontier_count_present ||
        request.expected_collision_count_present ||
        request.expected_quotient_count_present ||
        request.expected_digest_present || request.candidate_selection_requested ||
        request.collision_promoted_to_novelty ||
        request.incomplete_promoted_to_novelty {
        return PIREUS_ONF_ERR_RESULT_INJECTION
    }
    if request.semantic_write_from_parity ||
        request.expected_result_write_from_parity ||
        request.review_promoted_to_authority || request.parity_process_requested {
        return PIREUS_ONF_ERR_PARITY
    }
    if request.material_claim_requested { return PIREUS_ONF_ERR_MATERIAL }
    if request.historical_claim_requested || request.claim_ready_requested {
        return PIREUS_ONF_ERR_CLAIM
    }
    if request.raw_elf_requested { return PIREUS_ONF_ERR_RAW_ELF }
    PIREUS_ONF_OK
}

fn onf_build_lineage(paths: &PireusOnfPaths) -> PireusOnfLineage
with IO, Mut, Panic, Div, Alloc, Epistemic {
    if file_size(paths.garden) <= 0 || file_size(paths.contract) <= 0 ||
        file_size(paths.parent_source) <= 0 ||
        file_size(paths.parent_freeze) <= 0 ||
        file_size(paths.parent_parity_open) <= 0 ||
        file_size(paths.parent_material_receipt) <= 0 ||
        file_size(paths.parent_evidence) != 1270431 {
        return PireusOnfLineage {
            garden_match: false, contract_match: false,
            parent_source_match: false, parent_freeze_match: false,
            parent_parity_match: false, parent_material_match: false,
            parent_evidence_match: false,
            complete: false,
        }
    }
    let garden_raw = read_file(paths.garden)
    let contract_raw = read_file(paths.contract)
    let parent_source_raw = read_file(paths.parent_source)
    let parent_freeze_raw = read_file(paths.parent_freeze)
    let parent_parity_raw = read_file(paths.parent_parity_open)
    let parent_material_raw = read_file(paths.parent_material_receipt)
    let parent_evidence_raw = read_file(paths.parent_evidence)
    let garden_hash = onf_garden_hash()
    let contract_hash = onf_contract_hash()
    let parent_source_hash = onf_parent_source_hash()
    let parent_freeze_hash = onf_parent_freeze_hash()
    let parent_parity_hash = onf_parent_parity_hash()
    let parent_material_hash = onf_parent_material_hash()
    let parent_evidence_hash = onf_parent_evidence_hash()
    let garden_match = onf_text_sha256_matches(garden_raw, &garden_hash)
    let contract_match = onf_text_sha256_matches(contract_raw, &contract_hash)
    let parent_source_match = onf_text_sha256_matches(
        parent_source_raw, &parent_source_hash)
    let parent_freeze_match = onf_text_sha256_matches(
        parent_freeze_raw, &parent_freeze_hash)
    let parent_parity_match = onf_text_sha256_matches(
        parent_parity_raw, &parent_parity_hash)
    let parent_material_match = onf_text_sha256_matches(
        parent_material_raw, &parent_material_hash)
    let parent_evidence_match = onf_text_sha256_matches(
        parent_evidence_raw, &parent_evidence_hash)
    PireusOnfLineage {
        garden_match: garden_match,
        contract_match: contract_match,
        parent_source_match: parent_source_match,
        parent_freeze_match: parent_freeze_match,
        parent_parity_match: parent_parity_match,
        parent_material_match: parent_material_match,
        parent_evidence_match: parent_evidence_match,
        complete: garden_match && contract_match && parent_source_match &&
            parent_freeze_match && parent_parity_match && parent_material_match &&
            parent_evidence_match,
    }
}

fn onf_span_has_prefix(
    raw: string, start: i64, end: i64, prefix: string,
) -> bool with Mut, Panic {
    if end - start < str_len(prefix) { return false }
    var index: i64 = 0
    while index < str_len(prefix) {
        if str_char_at(raw, start + index) != str_char_at(prefix, index) {
            return false
        }
        index = index + 1
    }
    true
}

fn onf_parse_uint(raw: string, start: i64, end: i64) -> i64
with Mut, Panic {
    if start >= end { return -1 }
    var value: i64 = 0
    var pos = start
    while pos < end {
        let code = str_char_at(raw, pos)
        if code < 48 || code > 57 { return -1 }
        value = value * 10 + code - 48
        pos = pos + 1
    }
    value
}

fn onf_parse_int(raw: string, start: i64, end: i64) -> [i64; 2]
with Mut, Panic {
    if start >= end { return [0, 0] }
    var sign: i64 = 1
    var digits = start
    if str_char_at(raw, digits) == 45 {
        sign = -1
        digits = digits + 1
    }
    let magnitude = onf_parse_uint(raw, digits, end)
    if magnitude < 0 { [0, 0] } else { [1, sign * magnitude] }
}

fn onf_parse_field_uint(
    raw: string, start: i64, end: i64, field: string,
) -> i64 with Mut, Panic {
    let field_len = str_len(field)
    var pos = start
    while pos + field_len <= end {
        var matches = true
        var index: i64 = 0
        while index < field_len {
            if str_char_at(raw, pos + index) != str_char_at(field, index) {
                matches = false
            }
            index = index + 1
        }
        if matches {
            var value_end = pos + field_len
            while value_end < end {
                let code = str_char_at(raw, value_end)
                if code < 48 || code > 57 { break }
                value_end = value_end + 1
            }
            return onf_parse_uint(raw, pos + field_len, value_end)
        }
        pos = pos + 1
    }
    -1
}

fn onf_parse_field_int(
    raw: string, start: i64, end: i64, field: string,
) -> [i64; 2] with Mut, Panic {
    let field_len = str_len(field)
    var pos = start
    while pos + field_len <= end {
        var matches = true
        var index: i64 = 0
        while index < field_len {
            if str_char_at(raw, pos + index) != str_char_at(field, index) {
                matches = false
            }
            index = index + 1
        }
        if matches {
            var value_end = pos + field_len
            if value_end < end && str_char_at(raw, value_end) == 45 {
                value_end = value_end + 1
            }
            while value_end < end {
                let code = str_char_at(raw, value_end)
                if code < 48 || code > 57 { break }
                value_end = value_end + 1
            }
            return onf_parse_int(raw, pos + field_len, value_end)
        }
        pos = pos + 1
    }
    [0, 0]
}

fn onf_parse_parent_basis(raw: string) -> PireusOnfParentSeed
with Mut, Panic {
    var parent = onf_empty_tensor()
    var seen: [i64; 256] = [0; 256]
    var pending = false
    var pending_i: i64 = -1
    var pending_j: i64 = -1
    var pending_destination: i64 = -1
    var basis_cells: i64 = 0
    var failures: i64 = 0
    var start: i64 = 0
    while start < str_len(raw) {
        var end = start
        while end < str_len(raw) && str_char_at(raw, end) != 10 {
            end = end + 1
        }
        var line_end = end
        if line_end > start && str_char_at(raw, line_end - 1) == 13 {
            line_end = line_end - 1
        }
        if onf_span_has_prefix(
            raw, start, line_end, "PIREUS_OAG_BASIS genome=") {
            if pending { failures = failures + 1 }
            let genome = onf_parse_field_uint(
                raw, start, line_end, "genome=")
            pending = genome == 0
            pending_i = -1
            pending_j = -1
            pending_destination = -1
        } else if pending && onf_span_has_prefix(
            raw, start, line_end, " arity=2 i=") {
            pending_i = onf_parse_field_uint(raw, start, line_end, "i=")
        } else if pending && onf_span_has_prefix(raw, start, line_end, " j=") {
            pending_j = onf_parse_field_uint(raw, start, line_end, "j=")
        } else if pending && onf_span_has_prefix(
            raw, start, line_end, " destination=") {
            pending_destination = onf_parse_field_uint(
                raw, start, line_end, "destination=")
        } else if pending && onf_span_has_prefix(
            raw, start, line_end, " coefficient=") {
            let parsed = onf_parse_field_int(
                raw, start, line_end, "coefficient=")
            let coefficient = parsed[1]
            if pending_i < 0 || pending_i >= PIREUS_ONF_LANES ||
                pending_j < 0 || pending_j >= PIREUS_ONF_LANES ||
                pending_destination < 0 ||
                pending_destination >= PIREUS_ONF_LANES ||
                parsed[0] != 1 || coefficient == 0 {
                failures = failures + 1
            } else {
                let seen_cell = pending_i * PIREUS_ONF_LANES + pending_j
                let tensor_cell = onf_tensor_index(
                    pending_destination, pending_i, pending_j)
                if seen[seen_cell] != 0 { failures = failures + 1 }
                else {
                    seen[seen_cell] = 1
                    parent.coefficient[tensor_cell] = coefficient
                    basis_cells = basis_cells + 1
                }
            }
            pending = false
        }
        start = end + 1
    }
    if pending { failures = failures + 1 }
    PireusOnfParentSeed {
        parent: parent,
        basis_cells: basis_cells,
        failures: failures,
        complete: basis_cells == 256 && failures == 0,
    }
}

fn onf_rotl4(value: i64) -> i64 {
    ((value << 1) & 15) | ((value >> 3) & 1)
}

fn onf_parent_class_value_raw(
    parent: &PireusOnfTensor,
    pair_counts: &[i64; 256],
    first_k: i64,
    residual_shape_match: bool,
    atlas_class: i64,
    cell: i64,
) -> i64 with Mut, Panic {
    let output = onf_cell_output(cell)
    let input_0 = onf_cell_input_0(cell)
    let input_1 = onf_cell_input_1(cell)
    let parent_output = input_0 ^ input_1
    let parent_value = parent.coefficient[onf_tensor_index(
        parent_output, input_0, input_1)]
    if atlas_class == 0 {
        if output == parent_output { parent_value } else { 0 }
    } else if !residual_shape_match {
        0
    } else if atlas_class == 1 {
        let affine_output = onf_rotl4(input_0) ^ input_1 ^ first_k
        if output == affine_output { parent_value } else { 0 }
    } else if atlas_class == 2 && output == parent_output {
        parent_value * (1 + pair_counts[
            input_0 * PIREUS_ONF_LANES + input_1])
    } else { 0 }
}

fn onf_validate_derived_basis(
    raw: string,
    parent: &PireusOnfTensor,
    pair_counts: &[i64; 256],
    first_k: i64,
    residual_shape_match: bool,
) -> PireusOnfDerivedValidation with Mut, Panic {
    var seen: [i64; 512] = [0; 512]
    var pending = false
    var pending_class: i64 = -1
    var pending_i: i64 = -1
    var pending_j: i64 = -1
    var pending_destination: i64 = -1
    var basis_cells: i64 = 0
    var failures: i64 = 0
    var start: i64 = 0
    while start < str_len(raw) {
        var end = start
        while end < str_len(raw) && str_char_at(raw, end) != 10 {
            end = end + 1
        }
        var line_end = end
        if line_end > start && str_char_at(raw, line_end - 1) == 13 {
            line_end = line_end - 1
        }
        if onf_span_has_prefix(
            raw, start, line_end, "PIREUS_OAG_BASIS genome=") {
            if pending { failures = failures + 1 }
            let genome = onf_parse_field_uint(
                raw, start, line_end, "genome=")
            pending_class = if genome == 2 { 1 }
                else if genome == 3 { 2 } else { -1 }
            pending = pending_class > 0
            pending_i = -1
            pending_j = -1
            pending_destination = -1
        } else if pending && onf_span_has_prefix(
            raw, start, line_end, " arity=2 i=") {
            pending_i = onf_parse_field_uint(raw, start, line_end, "i=")
        } else if pending && onf_span_has_prefix(raw, start, line_end, " j=") {
            pending_j = onf_parse_field_uint(raw, start, line_end, "j=")
        } else if pending && onf_span_has_prefix(
            raw, start, line_end, " destination=") {
            pending_destination = onf_parse_field_uint(
                raw, start, line_end, "destination=")
        } else if pending && onf_span_has_prefix(
            raw, start, line_end, " coefficient=") {
            let parsed = onf_parse_field_int(
                raw, start, line_end, "coefficient=")
            let coefficient = parsed[1]
            if pending_i < 0 || pending_i >= PIREUS_ONF_LANES ||
                pending_j < 0 || pending_j >= PIREUS_ONF_LANES ||
                pending_destination < 0 ||
                pending_destination >= PIREUS_ONF_LANES ||
                parsed[0] != 1 || coefficient == 0 {
                failures = failures + 1
            } else {
                let pair = pending_i * PIREUS_ONF_LANES + pending_j
                let seen_cell = (pending_class - 1) * 256 + pair
                let tensor_cell = onf_tensor_index(
                    pending_destination, pending_i, pending_j)
                let expected_destination = if pending_class == 1 {
                    onf_rotl4(pending_i) ^ pending_j ^ first_k
                } else { pending_i ^ pending_j }
                let expected_coefficient = onf_parent_class_value_raw(
                    parent, pair_counts, first_k, residual_shape_match,
                    pending_class, tensor_cell)
                if seen[seen_cell] != 0 ||
                    pending_destination != expected_destination ||
                    coefficient != expected_coefficient {
                    failures = failures + 1
                } else {
                    seen[seen_cell] = 1
                    basis_cells = basis_cells + 1
                }
            }
            pending = false
        }
        start = end + 1
    }
    if pending { failures = failures + 1 }
    PireusOnfDerivedValidation {
        basis_cells: basis_cells,
        failures: failures,
        complete: basis_cells == 512 && failures == 0,
    }
}

fn onf_parent_class_digest_v10(
    parent: &PireusOnfTensor,
    pair_counts: &[i64; 256],
    first_k: i64,
    residual_shape_match: bool,
    atlas_class: i64,
) -> PireusOnfDigest with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = onf_digest_add_i64(state, 730000)
    state = onf_digest_add_i64(state, PIREUS_ONF_TENSOR_CELLS)
    var cell: i64 = 0
    while cell < PIREUS_ONF_TENSOR_CELLS {
        state = onf_digest_add_i64(state, onf_parent_class_value_raw(
            parent, pair_counts, first_k, residual_shape_match,
            atlas_class, cell))
        cell = cell + 1
    }
    onf_digest_finish(state)
}

fn onf_build_parent(parent_evidence_raw: string, emit_transcript: bool)
-> PireusOnfParent
with IO, Mut, Panic, Div, Epistemic {
    if emit_transcript { print("PIREUS_ONF_PARENT_PHASE phase=ENTER\n") }
    let seed = onf_parse_parent_basis(parent_evidence_raw)
    var parent = seed.parent
    var pair_counts: [i64; 256] = [0; 256]
    if emit_transcript { print("PIREUS_ONF_PARENT_PHASE phase=EVIDENCE\n") }
    var associator_failures: i64 = 0
    var commutator_failures: i64 = 0
    var first_i: i64 = -1
    var first_j: i64 = -1
    var first_k: i64 = -1
    var failures: i64 = seed.failures
    var i: i64 = 0
    if !seed.complete { failures = failures + 1 }
    while i < PIREUS_ONF_LANES {
        var j: i64 = 0
        while j < PIREUS_ONF_LANES {
            var support: i64 = 0
            var output: i64 = 0
            while output < PIREUS_ONF_LANES {
                if parent.coefficient[onf_tensor_index(output, i, j)] != 0 {
                    support = support + 1
                }
                output = output + 1
            }
            if support != 1 { failures = failures + 1 }
            let cij = parent.coefficient[onf_tensor_index(i ^ j, i, j)]
            let cji = parent.coefficient[onf_tensor_index(i ^ j, j, i)]
            if cij == 0 { failures = failures + 1 }
            if cij != cji { commutator_failures = commutator_failures + 1 }
            var k: i64 = 0
            while k < PIREUS_ONF_LANES {
                let left = cij * parent.coefficient[onf_tensor_index(
                    (i ^ j) ^ k, i ^ j, k)]
                let cjk = parent.coefficient[onf_tensor_index(j ^ k, j, k)]
                let right = cjk * parent.coefficient[onf_tensor_index(
                    i ^ (j ^ k), i, j ^ k)]
                if left != right {
                    associator_failures = associator_failures + 1
                    pair_counts[i * PIREUS_ONF_LANES + j] =
                        pair_counts[i * PIREUS_ONF_LANES + j] + 1
                    if first_i < 0 {
                        first_i = i
                        first_j = j
                        first_k = k
                    }
                }
                k = k + 1
            }
            j = j + 1
        }
        i = i + 1
    }
    if emit_transcript { print("PIREUS_ONF_PARENT_PHASE phase=RESIDUALS\n") }
    let residual_shape_match = associator_failures == 768 &&
        commutator_failures == 112 && first_i == 2 && first_j == 4 &&
        first_k == 2
    if !residual_shape_match {
        failures = failures + 1
    }
    let derived_validation = onf_validate_derived_basis(
        parent_evidence_raw, &parent, &pair_counts, first_k,
        residual_shape_match)
    failures = failures + derived_validation.failures
    if derived_validation.basis_cells != 512 { failures = failures + 1 }
    if emit_transcript { print("PIREUS_ONF_PARENT_PHASE phase=DERIVED\n") }
    let parent_digest = onf_parent_class_digest_v10(
        &parent, &pair_counts, first_k, residual_shape_match, 0)
    if emit_transcript { print("PIREUS_ONF_PARENT_PHASE phase=PARENT_DIGEST\n") }
    let affine_digest = onf_parent_class_digest_v10(
        &parent, &pair_counts, first_k, residual_shape_match, 1)
    if emit_transcript { print("PIREUS_ONF_PARENT_PHASE phase=AFFINE_DIGEST\n") }
    let lift_digest = onf_parent_class_digest_v10(
        &parent, &pair_counts, first_k, residual_shape_match, 2)
    if emit_transcript { print("PIREUS_ONF_PARENT_PHASE phase=LIFT_DIGEST\n") }
    let parent_expected = onf_parent_tensor_digest_expected(0)
    let affine_expected = onf_parent_tensor_digest_expected(1)
    let lift_expected = onf_parent_tensor_digest_expected(2)
    var digest_matches: i64 = 0
    if onf_words_equal(&parent_digest.words, &parent_expected) {
        digest_matches = digest_matches + 1
    }
    if onf_words_equal(&affine_digest.words, &affine_expected) {
        digest_matches = digest_matches + 1
    }
    if onf_words_equal(&lift_digest.words, &lift_expected) {
        digest_matches = digest_matches + 1
    }
    if digest_matches != 3 { failures = failures + 1 }
    PireusOnfParent {
        parent: parent,
        pair_counts: pair_counts,
        associator_failures: associator_failures,
        commutator_failures: commutator_failures,
        first_i: first_i, first_j: first_j, first_k: first_k,
        residual_shape_match: residual_shape_match,
        parent_basis_cells: seed.basis_cells,
        derived_basis_cells: derived_validation.basis_cells,
        digest_matches: digest_matches,
        failures: failures,
        complete: seed.complete && derived_validation.complete && failures == 0 &&
            residual_shape_match && digest_matches == 3,
    }
}

fn onf_class_value(parent: &PireusOnfParent, atlas_class: i64, cell: i64)
-> i64 with Mut, Panic {
    onf_parent_class_value_raw(
        &parent.parent, &parent.pair_counts, parent.first_k,
        parent.residual_shape_match, atlas_class, cell)
}

fn onf_atlas_value(
    parent: &PireusOnfParent, representative: i64, cell: i64,
) -> i64 with Mut, Panic {
    let atlas_class = representative / PIREUS_ONF_GROUP_ORDER
    let action = representative -
        atlas_class * PIREUS_ONF_GROUP_ORDER
    let source = if action == 0 { cell } else { onf_permute_cell(cell) }
    let character = if action == 0 { 1 }
        else { onf_result_character(cell) }
    character * onf_class_value(parent, atlas_class, source)
}

fn onf_build_profiles(parent: &PireusOnfParent)
-> PireusOnfProfiles with Mut, Panic {
    var mismatch_count: [i64; 6] = [0; 6]
    var first_cell: [i64; 6] = [-1; 6]
    var second_cell: [i64; 6] = [-1; 6]
    var first_delta: [i64; 6] = [0; 6]
    var second_delta: [i64; 6] = [0; 6]
    var cells_scanned: i64 = 0
    var representative: i64 = 0
    while representative < PIREUS_ONF_REPRESENTATIVES {
        var cell: i64 = 0
        while cell < PIREUS_ONF_TENSOR_CELLS {
            let atlas_value = onf_atlas_value(parent, representative, cell)
            if parent.parent.coefficient[cell] != atlas_value {
                mismatch_count[representative] =
                    mismatch_count[representative] + 1
                if first_cell[representative] < 0 {
                    first_cell[representative] = cell
                    first_delta[representative] =
                        atlas_value - parent.parent.coefficient[cell]
                } else if second_cell[representative] < 0 {
                    second_cell[representative] = cell
                    second_delta[representative] =
                        atlas_value - parent.parent.coefficient[cell]
                }
            }
            cells_scanned = cells_scanned + 1
            cell = cell + 1
        }
        representative = representative + 1
    }
    PireusOnfProfiles {
        mismatch_count: mismatch_count,
        first_cell: first_cell,
        second_cell: second_cell,
        first_delta: first_delta,
        second_delta: second_delta,
        cells_scanned: cells_scanned,
        complete: cells_scanned ==
            PIREUS_ONF_REPRESENTATIVES * PIREUS_ONF_TENSOR_CELLS,
    }
}

fn onf_sparse_collision(
    profiles: &PireusOnfProfiles, representative: i64,
    mutation_cell: i64, mutation_delta: i64,
) -> bool with Mut, Panic {
    profiles.mismatch_count[representative] == 1 &&
        profiles.first_cell[representative] == mutation_cell &&
        profiles.first_delta[representative] == mutation_delta
}

fn onf_sparse_separator(
    profiles: &PireusOnfProfiles, representative: i64,
    mutation_cell: i64, mutation_delta: i64,
) -> i64 with Mut, Panic {
    let first = profiles.first_cell[representative]
    if first < 0 { return mutation_cell }
    if first < mutation_cell { return first }
    if first > mutation_cell { return mutation_cell }
    if profiles.first_delta[representative] != mutation_delta {
        return mutation_cell
    }
    profiles.second_cell[representative]
}

fn onf_candidate_value(
    parent: &PireusOnfTensor, candidate_id: i64, cell: i64,
) -> i64 with Mut, Panic {
    parent.coefficient[cell] +
        if cell == onf_candidate_cell(candidate_id) {
            onf_candidate_delta(candidate_id)
        } else { 0 }
}

fn onf_direct_atlas_compare(
    parent: &PireusOnfTensor, atlas_parent: &PireusOnfParent,
    candidate_id: i64, representative: i64,
) -> [i64; 2] with Mut, Panic {
    var first: i64 = -1
    var cell: i64 = 0
    while cell < PIREUS_ONF_TENSOR_CELLS {
        if first < 0 && onf_candidate_value(parent, candidate_id, cell) !=
            onf_atlas_value(atlas_parent, representative, cell) {
            first = cell
        }
        cell = cell + 1
    }
    if first < 0 { [1, -1] } else { [0, first] }
}

fn onf_build_action_profile(parent: &PireusOnfTensor)
-> PireusOnfActionProfile with Mut, Panic {
    var difference: [i64; 4096] = [0; 4096]
    var mismatch_count: i64 = 0
    var first_cell: i64 = -1
    var second_cell: i64 = -1
    var permutation_checks: i64 = 0
    var character_checks: i64 = 0
    var involution_checks: i64 = 0
    var failures: i64 = 0
    var seen: [i64; 4096] = [0; 4096]
    var cell: i64 = 0
    while cell < PIREUS_ONF_TENSOR_CELLS {
        let target = onf_permute_cell(cell)
        let character = onf_basis_character(cell)
        permutation_checks = permutation_checks + 1
        character_checks = character_checks + 1
        involution_checks = involution_checks + 2
        if target < 0 || target >= PIREUS_ONF_TENSOR_CELLS {
            failures = failures + 1
        } else {
            seen[target] = seen[target] + 1
            if onf_permute_cell(target) != cell { failures = failures + 1 }
            if character != 1 ||
                character * onf_basis_character(target) != 1 {
                failures = failures + 1
            }
            let result_character = onf_result_character(cell)
            let q_parent = result_character * parent.coefficient[target]
            difference[cell] = q_parent - parent.coefficient[cell]
            if difference[cell] != 0 {
                mismatch_count = mismatch_count + 1
                if first_cell < 0 { first_cell = cell }
                else if second_cell < 0 { second_cell = cell }
            }
        }
        cell = cell + 1
    }
    cell = 0
    while cell < PIREUS_ONF_TENSOR_CELLS {
        permutation_checks = permutation_checks + 1
        if seen[cell] != 1 { failures = failures + 1 }
        cell = cell + 1
    }
    PireusOnfActionProfile {
        difference: difference,
        mismatch_count: mismatch_count,
        first_cell: first_cell,
        second_cell: second_cell,
        permutation_checks: permutation_checks,
        character_checks: character_checks,
        involution_checks: involution_checks,
        failures: failures,
        complete: permutation_checks == 8192 && character_checks == 4096 &&
            involution_checks == 8192 && failures == 0,
    }
}

fn onf_sparse_quotient_image(
    candidate_id: i64, action: &PireusOnfActionProfile,
) -> i64 with Mut, Panic {
    let mutation_cell = onf_candidate_cell(candidate_id)
    let mutation_delta = onf_candidate_delta(candidate_id)
    let target = onf_permute_cell(mutation_cell)
    let transported = mutation_delta * onf_basis_character(mutation_cell)
    let old_value = action.difference[target]
    let new_value = old_value + transported
    let old_nonzero = if old_value != 0 { 1 } else { 0 }
    let new_nonzero = if new_value != 0 { 1 } else { 0 }
    let support = action.mismatch_count - old_nonzero + new_nonzero
    if support != 1 { return -1 }
    var unique_cell: i64 = -1
    var unique_value: i64 = 0
    var cell: i64 = 0
    while cell < PIREUS_ONF_TENSOR_CELLS {
        let value = action.difference[cell] +
            if cell == target { transported } else { 0 }
        if value != 0 {
            unique_cell = cell
            unique_value = value
        }
        cell = cell + 1
    }
    onf_encode_candidate(unique_cell, unique_value)
}

fn onf_direct_quotient_image(
    candidate_id: i64, parent: &PireusOnfTensor,
) -> i64 with Mut, Panic {
    let mutation_cell = onf_candidate_cell(candidate_id)
    let mutation_delta = onf_candidate_delta(candidate_id)
    var support: i64 = 0
    var unique_cell: i64 = -1
    var unique_value: i64 = 0
    var cell: i64 = 0
    while cell < PIREUS_ONF_TENSOR_CELLS {
        let source = onf_permute_cell(cell)
        let result_character = onf_result_character(cell)
        let q_candidate = result_character * parent.coefficient[source] +
            if source == mutation_cell {
                result_character * mutation_delta
            } else { 0 }
        let difference = q_candidate - parent.coefficient[cell]
        if difference != 0 {
            support = support + 1
            unique_cell = cell
            unique_value = difference
        }
        cell = cell + 1
    }
    if support != 1 { -1 }
    else { onf_encode_candidate(unique_cell, unique_value) }
}

fn onf_negative_cases() -> [bool; 20] with Mut {
    var cases: [bool; 20] = [false; 20]
    var request = pireus_operator_novelty_frontier_request()
    request.producer_language = PIREUS_ONF_LANGUAGE_PYTHON
    cases[0] = onf_request_error(&request) == PIREUS_ONF_ERR_AUTHORITY
    request = pireus_operator_novelty_frontier_request()
    request.producer_language = PIREUS_ONF_LANGUAGE_RUST
    cases[1] = onf_request_error(&request) == PIREUS_ONF_ERR_AUTHORITY
    request = pireus_operator_novelty_frontier_request()
    request.producer_language = PIREUS_ONF_LANGUAGE_LLM
    request.producer_role = PIREUS_ONF_ROLE_REVIEW_ONLY
    request.review_promoted_to_authority = true
    cases[2] = onf_request_error(&request) == PIREUS_ONF_ERR_AUTHORITY
    request = pireus_operator_novelty_frontier_request()
    request.producer_language = PIREUS_ONF_LANGUAGE_LEAN
    request.producer_role = PIREUS_ONF_ROLE_FORMAL_PARITY
    request.semantic_write_from_parity = true
    cases[3] = onf_request_error(&request) == PIREUS_ONF_ERR_AUTHORITY
    request = pireus_operator_novelty_frontier_request()
    request.producer_language = PIREUS_ONF_LANGUAGE_KOKA
    request.producer_role = PIREUS_ONF_ROLE_EFFECT_PARITY
    request.expected_result_write_from_parity = true
    cases[4] = onf_request_error(&request) == PIREUS_ONF_ERR_AUTHORITY
    request = pireus_operator_novelty_frontier_request()
    request.producer_language = PIREUS_ONF_LANGUAGE_CPP
    request.producer_role = PIREUS_ONF_ROLE_MATERIAL_PARITY
    request.material_claim_requested = true
    cases[5] = onf_request_error(&request) == PIREUS_ONF_ERR_AUTHORITY
    request = pireus_operator_novelty_frontier_request()
    request.policy_state = PIREUS_ONF_POLICY_MISSING
    cases[6] = onf_request_error(&request) == PIREUS_ONF_ERR_POLICY
    request = pireus_operator_novelty_frontier_request()
    request.policy_state = PIREUS_ONF_POLICY_TIMEOUT
    cases[7] = onf_request_error(&request) == PIREUS_ONF_ERR_POLICY
    request = pireus_operator_novelty_frontier_request()
    request.policy_state = PIREUS_ONF_POLICY_ERROR
    cases[8] = onf_request_error(&request) == PIREUS_ONF_ERR_POLICY
    request = pireus_operator_novelty_frontier_request()
    request.parent_semantics_bound = false
    cases[9] = onf_request_error(&request) == PIREUS_ONF_ERR_LINEAGE
    request = pireus_operator_novelty_frontier_request()
    request.enumeration_limit = PIREUS_ONF_GRAMMAR_CARDINALITY - 1
    cases[10] = onf_request_error(&request) == PIREUS_ONF_ERR_GRAMMAR
    request = pireus_operator_novelty_frontier_request()
    request.expected_frontier_count_present = true
    cases[11] = onf_request_error(&request) == PIREUS_ONF_ERR_RESULT_INJECTION
    request = pireus_operator_novelty_frontier_request()
    request.expected_collision_count_present = true
    cases[12] = onf_request_error(&request) == PIREUS_ONF_ERR_RESULT_INJECTION
    request = pireus_operator_novelty_frontier_request()
    request.expected_quotient_count_present = true
    cases[13] = onf_request_error(&request) == PIREUS_ONF_ERR_RESULT_INJECTION
    request = pireus_operator_novelty_frontier_request()
    request.expected_digest_present = true
    cases[14] = onf_request_error(&request) == PIREUS_ONF_ERR_RESULT_INJECTION
    request = pireus_operator_novelty_frontier_request()
    request.candidate_selection_requested = true
    cases[15] = onf_request_error(&request) == PIREUS_ONF_ERR_RESULT_INJECTION
    request = pireus_operator_novelty_frontier_request()
    request.parity_process_requested = true
    cases[16] = onf_request_error(&request) == PIREUS_ONF_ERR_PARITY
    request = pireus_operator_novelty_frontier_request()
    request.material_claim_requested = true
    cases[17] = onf_request_error(&request) == PIREUS_ONF_ERR_MATERIAL
    request = pireus_operator_novelty_frontier_request()
    request.historical_claim_requested = true
    cases[18] = onf_request_error(&request) == PIREUS_ONF_ERR_CLAIM
    request = pireus_operator_novelty_frontier_request()
    request.raw_elf_requested = true
    cases[19] = onf_request_error(&request) == PIREUS_ONF_ERR_RAW_ELF
    cases
}

fn onf_emit_digest(label: string, digest: &PireusOnfDigest)
with IO, Mut, Panic {
    print("PIREUS_ONF_DIGEST kind="); print(label)
    print(" words=")
    var word: i64 = 0
    while word < 8 {
        if word > 0 { print(":") }
        print_int(digest.words[word])
        word = word + 1
    }
    print("\n")
}

fn onf_build_frontier(
    parent: &PireusOnfTensor,
    atlas_parent: &PireusOnfParent,
    profiles: &PireusOnfProfiles,
    action: &PireusOnfActionProfile,
    emit_transcript: bool,
) -> PireusOnfFrontier with IO, Mut, Panic, Div, Epistemic {
    var failures: i64 = 0
    var codec_checks: i64 = 0
    var unit_boundary_checks: i64 = 0
    var candidate_id: i64 = 0
    while candidate_id < PIREUS_ONF_GRAMMAR_CARDINALITY {
        let cell = onf_candidate_cell(candidate_id)
        let delta = onf_candidate_delta(candidate_id)
        let decoded = onf_encode_candidate(cell, delta)
        codec_checks = codec_checks + 2
        unit_boundary_checks = unit_boundary_checks + 2
        if decoded < 0 || decoded >= PIREUS_ONF_GRAMMAR_CARDINALITY {
            failures = failures + 1
        } else if decoded != candidate_id {
            failures = failures + 1
        }
        if onf_cell_input_0(cell) == 0 || onf_cell_input_1(cell) == 0 {
            failures = failures + 1
        }
        candidate_id = candidate_id + 1
    }

    var quotient_outside: i64 = 0
    var quotient_fixed: i64 = 0
    var quotient_pairs: i64 = 0
    var quotient_symmetry_checks: i64 = 0
    var outside_first: i64 = -1
    var outside_last: i64 = -1
    var fixed_first: i64 = -1
    var fixed_last: i64 = -1
    var pair_first: i64 = -1
    var pair_last: i64 = -1
    var singleton_first: i64 = -1
    var singleton_last: i64 = -1
    candidate_id = 0
    while candidate_id < PIREUS_ONF_GRAMMAR_CARDINALITY {
        let mapped = onf_sparse_quotient_image(candidate_id, action)
        if mapped < 0 {
            quotient_outside = quotient_outside + 1
            if outside_first < 0 { outside_first = candidate_id }
            outside_last = candidate_id
            if singleton_first < 0 { singleton_first = candidate_id }
            singleton_last = candidate_id
        } else {
            quotient_symmetry_checks = quotient_symmetry_checks + 1
            if mapped >= PIREUS_ONF_GRAMMAR_CARDINALITY ||
                onf_sparse_quotient_image(mapped, action) != candidate_id {
                failures = failures + 1
            }
            if mapped == candidate_id {
                quotient_fixed = quotient_fixed + 1
                if fixed_first < 0 { fixed_first = candidate_id }
                fixed_last = candidate_id
                if singleton_first < 0 { singleton_first = candidate_id }
                singleton_last = candidate_id
            } else if mapped > candidate_id {
                quotient_pairs = quotient_pairs + 1
                if pair_first < 0 { pair_first = candidate_id }
                pair_last = candidate_id
            }
        }
        candidate_id = candidate_id + 1
    }
    let quotient_singletons = quotient_outside + quotient_fixed
    let quotient_classes = quotient_singletons + quotient_pairs
    let quotient_in_grammar_images = quotient_fixed + 2 * quotient_pairs
    if quotient_singletons + 2 * quotient_pairs !=
        PIREUS_ONF_GRAMMAR_CARDINALITY {
        failures = failures + 1
    }

    var direct_quotient_canary_checks: i64 = 0
    var canary_slot: i64 = 0
    while canary_slot < 3 {
        let canary = if canary_slot == 0 { 0 }
            else if canary_slot == 1 { 3600 } else { 7199 }
        direct_quotient_canary_checks = direct_quotient_canary_checks + 1
        if onf_direct_quotient_image(canary, parent) !=
            onf_sparse_quotient_image(canary, action) {
            failures = failures + 1
        }
        canary_slot = canary_slot + 1
    }

    var candidate_state = sha256_init()
    var separator_state = sha256_init()
    var quotient_state = sha256_init()
    candidate_state = onf_digest_add_i64(candidate_state, PIREUS_ONF_SCHEMA)
    candidate_state = onf_digest_add_i64(
        candidate_state, PIREUS_ONF_GRAMMAR_CARDINALITY)
    separator_state = onf_digest_add_i64(separator_state, PIREUS_ONF_SCHEMA + 1)
    separator_state = onf_digest_add_i64(
        separator_state, PIREUS_ONF_GRAMMAR_CARDINALITY)
    quotient_state = onf_digest_add_i64(quotient_state, PIREUS_ONF_SCHEMA + 2)
    quotient_state = onf_digest_add_i64(
        quotient_state, PIREUS_ONF_GRAMMAR_CARDINALITY)

    var atlas_collision_candidates: i64 = 0
    var atlas_collision_edges: i64 = 0
    var n2_relative_novelty: i64 = 0
    var separators: i64 = 0
    var collision_first: i64 = -1
    var collision_last: i64 = -1
    var n2_first: i64 = -1
    var n2_last: i64 = -1
    candidate_id = 0
    while candidate_id < PIREUS_ONF_GRAMMAR_CARDINALITY {
        let mutation_cell = onf_candidate_cell(candidate_id)
        let mutation_delta = onf_candidate_delta(candidate_id)
        var collision_mask: i64 = 0
        var candidate_separators: [i64; 6] = [-1; 6]
        var representative: i64 = 0
        while representative < PIREUS_ONF_REPRESENTATIVES {
            let collision = onf_sparse_collision(
                profiles, representative, mutation_cell, mutation_delta)
            let separator = if collision { -1 } else {
                onf_sparse_separator(
                    profiles, representative, mutation_cell, mutation_delta)
            }
            candidate_separators[representative] = separator
            if collision {
                collision_mask = collision_mask | (1 << representative)
                atlas_collision_edges = atlas_collision_edges + 1
            } else {
                separators = separators + 1
                if separator < 0 || separator >= PIREUS_ONF_TENSOR_CELLS ||
                    onf_candidate_value(parent, candidate_id, separator) ==
                    onf_atlas_value(atlas_parent, representative, separator) {
                    failures = failures + 1
                }
            }
            separator_state = onf_digest_add_i64(separator_state, candidate_id)
            separator_state = onf_digest_add_i64(separator_state, representative)
            separator_state = onf_digest_add_i64(
                separator_state, if collision { 1 } else { 0 })
            separator_state = onf_digest_add_i64(separator_state, separator)
            if separator >= 0 {
                separator_state = onf_digest_add_i64(separator_state,
                    onf_candidate_value(parent, candidate_id, separator) -
                    onf_atlas_value(atlas_parent, representative, separator))
            } else {
                separator_state = onf_digest_add_i64(separator_state, 0)
            }
            representative = representative + 1
        }
        if collision_mask == 0 {
            n2_relative_novelty = n2_relative_novelty + 1
            if n2_first < 0 { n2_first = candidate_id }
            n2_last = candidate_id
        } else {
            atlas_collision_candidates = atlas_collision_candidates + 1
            if collision_first < 0 { collision_first = candidate_id }
            collision_last = candidate_id
        }
        let mapped = onf_sparse_quotient_image(candidate_id, action)
        let quotient_kind = if mapped < 0 { 1 }
            else if mapped == candidate_id { 2 } else { 3 }
        let quotient_class = if mapped < 0 || mapped == candidate_id {
            candidate_id
        } else if mapped < candidate_id { mapped } else { candidate_id }
        candidate_state = onf_digest_add_i64(candidate_state, candidate_id)
        candidate_state = onf_digest_add_i64(candidate_state, mutation_cell)
        candidate_state = onf_digest_add_i64(candidate_state, mutation_delta)
        candidate_state = onf_digest_add_i64(candidate_state, collision_mask)
        candidate_state = onf_digest_add_i64(
            candidate_state, if collision_mask == 0 { 1 } else { 0 })
        quotient_state = onf_digest_add_i64(quotient_state, candidate_id)
        quotient_state = onf_digest_add_i64(quotient_state, mapped)
        quotient_state = onf_digest_add_i64(quotient_state, quotient_class)
        quotient_state = onf_digest_add_i64(quotient_state, quotient_kind)
        if emit_transcript {
            print("PIREUS_ONF_CANDIDATE id="); print_int(candidate_id)
            print(" tensor_index="); print_int(mutation_cell)
            print(" delta="); print_int(mutation_delta)
            print(" admitted=1 collision_mask="); print_int(collision_mask)
            print(" outcome=")
            print(if collision_mask == 0 { "N2" } else { "ATLAS_COLLISION" })
            representative = 0
            while representative < PIREUS_ONF_REPRESENTATIVES {
                print(" separator_"); print_int(representative)
                print("="); print_int(candidate_separators[representative])
                representative = representative + 1
            }
            print(" q_image="); print_int(mapped)
            print(" q_class="); print_int(quotient_class)
            print(" q_kind="); print_int(quotient_kind)
            print("\n")
        }
        candidate_id = candidate_id + 1
    }
    if atlas_collision_candidates + n2_relative_novelty !=
        PIREUS_ONF_GRAMMAR_CARDINALITY ||
        separators + atlas_collision_edges !=
        PIREUS_ONF_GRAMMAR_CARDINALITY * PIREUS_ONF_REPRESENTATIVES {
        failures = failures + 1
    }

    var direct_atlas_canary_checks: i64 = 0
    canary_slot = 0
    while canary_slot < 3 {
        let canary = if canary_slot == 0 { 0 }
            else if canary_slot == 1 { 3600 } else { 7199 }
        var representative: i64 = 0
        while representative < PIREUS_ONF_REPRESENTATIVES {
            let direct = onf_direct_atlas_compare(
                parent, atlas_parent, canary, representative)
            let sparse_collision = onf_sparse_collision(
                profiles, representative, onf_candidate_cell(canary),
                onf_candidate_delta(canary))
            let sparse_separator = if sparse_collision { -1 } else {
                onf_sparse_separator(
                    profiles, representative, onf_candidate_cell(canary),
                    onf_candidate_delta(canary))
            }
            direct_atlas_canary_checks = direct_atlas_canary_checks + 1
            if (direct[0] == 1) != sparse_collision ||
                direct[1] != sparse_separator {
                failures = failures + 1
            }
            representative = representative + 1
        }
        canary_slot = canary_slot + 1
    }

    var synthetic_collision_checks: i64 = 0
    let synthetic_id: i64 = 0
    let synthetic_cell = onf_candidate_cell(synthetic_id)
    let synthetic_delta = onf_candidate_delta(synthetic_id)
    var synthetic = onf_empty_tensor()
    var cell: i64 = 0
    while cell < PIREUS_ONF_TENSOR_CELLS {
        synthetic.coefficient[cell] = parent.coefficient[cell]
        cell = cell + 1
    }
    synthetic.coefficient[synthetic_cell] =
        synthetic.coefficient[synthetic_cell] + synthetic_delta
    var synthetic_mismatches: i64 = 0
    var synthetic_first: i64 = -1
    var synthetic_first_delta: i64 = 0
    var synthetic_direct_collision = true
    cell = 0
    while cell < PIREUS_ONF_TENSOR_CELLS {
        if parent.coefficient[cell] != synthetic.coefficient[cell] {
            synthetic_mismatches = synthetic_mismatches + 1
            if synthetic_first < 0 {
                synthetic_first = cell
                synthetic_first_delta =
                    synthetic.coefficient[cell] - parent.coefficient[cell]
            }
        }
        if onf_candidate_value(parent, synthetic_id, cell) !=
            synthetic.coefficient[cell] {
            synthetic_direct_collision = false
        }
        cell = cell + 1
    }
    synthetic_collision_checks = synthetic_collision_checks + 3
    let synthetic_sparse_collision = synthetic_mismatches == 1 &&
        synthetic_first == synthetic_cell &&
        synthetic_first_delta == synthetic_delta
    if !synthetic_sparse_collision || !synthetic_direct_collision ||
        synthetic_cell != onf_candidate_cell(0) || synthetic_delta != 1 {
        failures = failures + 1
    }
    let synthetic_sabotage_cell = if synthetic_cell == 0 { 1 } else { 0 }
    synthetic.coefficient[synthetic_sabotage_cell] =
        synthetic.coefficient[synthetic_sabotage_cell] + 1
    synthetic_collision_checks = synthetic_collision_checks + 1
    if onf_candidate_value(parent, synthetic_id, synthetic_sabotage_cell) ==
        synthetic.coefficient[synthetic_sabotage_cell] {
        failures = failures + 1
    }

    var positive_collision_checks: i64 = 0
    var group_image = onf_empty_tensor()
    cell = 0
    while cell < PIREUS_ONF_TENSOR_CELLS {
        positive_collision_checks = positive_collision_checks + 1
        group_image.coefficient[cell] = onf_result_character(cell) *
            parent.coefficient[onf_permute_cell(cell)]
        if group_image.coefficient[cell] !=
            onf_atlas_value(atlas_parent, 1, cell) {
            failures = failures + 1
        }
        cell = cell + 1
    }
    group_image.coefficient[0] = group_image.coefficient[0] + 1
    positive_collision_checks = positive_collision_checks + 1
    if group_image.coefficient[0] ==
        onf_atlas_value(atlas_parent, 1, 0) {
        failures = failures + 1
    }

    var incomplete_control_checks: i64 = 0
    let incomplete_prefix: i64 = PIREUS_ONF_REPRESENTATIVES - 1
    var incomplete_candidate: i64 = -1
    var incomplete_completed: i64 = 0
    var probe_id: i64 = 0
    while probe_id < PIREUS_ONF_GRAMMAR_CARDINALITY &&
        incomplete_candidate < 0 {
        var prefix_collision = false
        var incomplete_representative: i64 = 0
        while incomplete_representative < incomplete_prefix {
            incomplete_control_checks = incomplete_control_checks + 1
            if onf_sparse_collision(
                profiles, incomplete_representative,
                onf_candidate_cell(probe_id), onf_candidate_delta(probe_id)) {
                prefix_collision = true
            }
            incomplete_representative = incomplete_representative + 1
        }
        if !prefix_collision {
            incomplete_candidate = probe_id
            incomplete_completed = incomplete_representative
        }
        probe_id = probe_id + 1
    }
    let incomplete_complete = incomplete_completed ==
        PIREUS_ONF_REPRESENTATIVES
    if incomplete_candidate < 0 || incomplete_completed != incomplete_prefix ||
        incomplete_complete {
        failures = failures + 1
    }

    let candidate_digest = onf_digest_finish(candidate_state)
    let separator_digest = onf_digest_finish(separator_state)
    let quotient_digest = onf_digest_finish(quotient_state)
    var frontier_state = sha256_init()
    frontier_state = onf_digest_add_i64(frontier_state, PIREUS_ONF_SCHEMA + 3)
    frontier_state = onf_digest_add_i64(
        frontier_state, PIREUS_ONF_GRAMMAR_CARDINALITY)
    frontier_state = onf_digest_add_i64(
        frontier_state, atlas_collision_candidates)
    frontier_state = onf_digest_add_i64(frontier_state, atlas_collision_edges)
    frontier_state = onf_digest_add_i64(frontier_state, n2_relative_novelty)
    frontier_state = onf_digest_add_i64(frontier_state, separators)
    frontier_state = onf_digest_add_i64(frontier_state, quotient_outside)
    frontier_state = onf_digest_add_i64(frontier_state, quotient_fixed)
    frontier_state = onf_digest_add_i64(frontier_state, quotient_pairs)
    frontier_state = onf_digest_add_i64(frontier_state, quotient_classes)
    var representative: i64 = 0
    while representative < PIREUS_ONF_REPRESENTATIVES {
        frontier_state = onf_digest_add_i64(
            frontier_state, profiles.mismatch_count[representative])
        frontier_state = onf_digest_add_i64(
            frontier_state, profiles.first_cell[representative])
        frontier_state = onf_digest_add_i64(
            frontier_state, profiles.second_cell[representative])
        frontier_state = onf_digest_add_i64(
            frontier_state, profiles.first_delta[representative])
        frontier_state = onf_digest_add_i64(
            frontier_state, profiles.second_delta[representative])
        representative = representative + 1
    }
    var word: i64 = 0
    while word < 8 {
        frontier_state = onf_digest_add_i64(
            frontier_state, candidate_digest.words[word])
        frontier_state = onf_digest_add_i64(
            frontier_state, separator_digest.words[word])
        frontier_state = onf_digest_add_i64(
            frontier_state, quotient_digest.words[word])
        word = word + 1
    }
    let frontier_digest = onf_digest_finish(frontier_state)
    if !onf_digest_nonzero(&candidate_digest) ||
        !onf_digest_nonzero(&separator_digest) ||
        !onf_digest_nonzero(&quotient_digest) ||
        !onf_digest_nonzero(&frontier_digest) {
        failures = failures + 1
    }
    PireusOnfFrontier {
        generated: PIREUS_ONF_GRAMMAR_CARDINALITY,
        typed_admitted: PIREUS_ONF_GRAMMAR_CARDINALITY,
        typed_rejected: 0,
        atlas_collision_candidates: atlas_collision_candidates,
        atlas_collision_edges: atlas_collision_edges,
        n2_relative_novelty: n2_relative_novelty,
        separators: separators,
        quotient_outside: quotient_outside,
        quotient_fixed: quotient_fixed,
        quotient_pairs: quotient_pairs,
        quotient_singletons: quotient_singletons,
        quotient_classes: quotient_classes,
        quotient_in_grammar_images: quotient_in_grammar_images,
        collision_first: collision_first, collision_last: collision_last,
        n2_first: n2_first, n2_last: n2_last,
        outside_first: outside_first, outside_last: outside_last,
        fixed_first: fixed_first, fixed_last: fixed_last,
        pair_first: pair_first, pair_last: pair_last,
        singleton_first: singleton_first, singleton_last: singleton_last,
        codec_checks: codec_checks,
        unit_boundary_checks: unit_boundary_checks,
        quotient_symmetry_checks: quotient_symmetry_checks,
        direct_atlas_canary_checks: direct_atlas_canary_checks,
        direct_quotient_canary_checks: direct_quotient_canary_checks,
        synthetic_collision_checks: synthetic_collision_checks,
        positive_collision_checks: positive_collision_checks,
        incomplete_control_checks: incomplete_control_checks,
        failures: failures,
        candidate_digest: candidate_digest,
        separator_digest: separator_digest,
        quotient_digest: quotient_digest,
        frontier_digest: frontier_digest,
        complete: failures == 0,
    }
}

pub fn pireus_operator_novelty_frontier_execute(
    request: &PireusOnfRequest,
    paths: &PireusOnfPaths,
    emit_transcript: bool,
) -> PireusOnfSummary with IO, Mut, Panic, Div, Alloc, Epistemic {
    if emit_transcript { print("PIREUS_ONF_PHASE phase=ENTER\n") }
    let request_error = onf_request_error(request)
    if emit_transcript { print("PIREUS_ONF_PHASE phase=REQUEST\n") }
    let lineage = onf_build_lineage(paths)
    if emit_transcript { print("PIREUS_ONF_PHASE phase=LINEAGE\n") }
    let parent_evidence_raw = read_file(paths.parent_evidence)
    let parent = onf_build_parent(parent_evidence_raw, emit_transcript)
    if emit_transcript { print("PIREUS_ONF_PHASE phase=PARENT\n") }
    let profiles = onf_build_profiles(&parent)
    if emit_transcript { print("PIREUS_ONF_PHASE phase=PROFILES\n") }
    let action = onf_build_action_profile(&parent.parent)
    if emit_transcript { print("PIREUS_ONF_PHASE phase=ACTION\n") }
    let frontier = onf_build_frontier(
        &parent.parent, &parent, &profiles, &action, emit_transcript)
    if emit_transcript { print("PIREUS_ONF_PHASE phase=FRONTIER\n") }
    let negative_cases = onf_negative_cases()
    var negative_passed: i64 = 0
    var negative: i64 = 0
    while negative < PIREUS_ONF_NEGATIVE_CASES {
        if negative_cases[negative] { negative_passed = negative_passed + 1 }
        negative = negative + 1
    }
    let negative_failures = PIREUS_ONF_NEGATIVE_CASES - negative_passed
    var structural_failures: i64 = 0
    if !lineage.complete { structural_failures = structural_failures + 1 }
    if !parent.complete { structural_failures = structural_failures + 1 }
    if !profiles.complete { structural_failures = structural_failures + 1 }
    if !action.complete { structural_failures = structural_failures + 1 }
    if !frontier.complete { structural_failures = structural_failures + 1 }
    if emit_transcript {
        print("PIREUS_ONF_AUTHORITY schema=pireus-operator-novelty-frontier.v11")
        print(" language=Sounio role=SEMANTIC_AUTHORITY stage=SOUNIO_EXECUTABLE")
        print(" expected_result_used=0 candidate_selected=0\n")
        print("PIREUS_ONF_LINEAGE garden_match=")
        print_int(if lineage.garden_match { 1 } else { 0 })
        print(" contract_match=")
        print_int(if lineage.contract_match { 1 } else { 0 })
        print(" parent_source_match=")
        print_int(if lineage.parent_source_match { 1 } else { 0 })
        print(" parent_freeze_match=")
        print_int(if lineage.parent_freeze_match { 1 } else { 0 })
        print(" parent_parity_match=")
        print_int(if lineage.parent_parity_match { 1 } else { 0 })
        print(" parent_material_match=")
        print_int(if lineage.parent_material_match { 1 } else { 0 })
        print(" parent_evidence_match=")
        print_int(if lineage.parent_evidence_match { 1 } else { 0 })
        print(" complete="); print_int(if lineage.complete { 1 } else { 0 })
        print("\n")
        print("PIREUS_ONF_PARENT reconstruction=V9_EVIDENCE_PLUS_V10_RESIDUAL")
        print(" associator_failures="); print_int(parent.associator_failures)
        print(" commutator_failures="); print_int(parent.commutator_failures)
        print(" first_witness="); print_int(parent.first_i); print(":")
        print_int(parent.first_j); print(":"); print_int(parent.first_k)
        print(" parent_basis_cells="); print_int(parent.parent_basis_cells)
        print(" derived_basis_cells="); print_int(parent.derived_basis_cells)
        print(" digest_matches="); print_int(parent.digest_matches)
        print(" failures="); print_int(parent.failures)
        print(" complete="); print_int(if parent.complete { 1 } else { 0 })
        print("\n")
        var representative: i64 = 0
        while representative < PIREUS_ONF_REPRESENTATIVES {
            print("PIREUS_ONF_PROFILE representative=")
            print_int(representative)
            print(" atlas_class=")
            print_int(representative / PIREUS_ONF_GROUP_ORDER)
            print(" action=")
            print_int(representative -
                (representative / PIREUS_ONF_GROUP_ORDER) *
                PIREUS_ONF_GROUP_ORDER)
            print(" mismatch_count=")
            print_int(profiles.mismatch_count[representative])
            print(" first_cell=")
            print_int(profiles.first_cell[representative])
            print(" first_delta=")
            print_int(profiles.first_delta[representative])
            print(" second_cell=")
            print_int(profiles.second_cell[representative])
            print(" second_delta=")
            print_int(profiles.second_delta[representative])
            print("\n")
            representative = representative + 1
        }
        print("PIREUS_ONF_ACTION kind=C2_diag unsigned=1")
        print(" base_mismatch_count="); print_int(action.mismatch_count)
        print(" first_cell="); print_int(action.first_cell)
        print(" second_cell="); print_int(action.second_cell)
        print(" permutation_checks="); print_int(action.permutation_checks)
        print(" character_checks="); print_int(action.character_checks)
        print(" character_value=1 derived_character_trivial=1 involution_checks=")
        print_int(action.involution_checks)
        print(" failures="); print_int(action.failures)
        print(" complete="); print_int(if action.complete { 1 } else { 0 })
        print("\n")
        print("PIREUS_ONF_PARTITION atlas_collision_candidates=")
        print_int(frontier.atlas_collision_candidates)
        print(" atlas_collision_edges=")
        print_int(frontier.atlas_collision_edges)
        print(" n2_relative_novelty=")
        print_int(frontier.n2_relative_novelty)
        print(" separators="); print_int(frontier.separators)
        print(" collision_first="); print_int(frontier.collision_first)
        print(" collision_last="); print_int(frontier.collision_last)
        print(" n2_first="); print_int(frontier.n2_first)
        print(" n2_last="); print_int(frontier.n2_last)
        print("\n")
        print("PIREUS_ONF_QUOTIENT outside=")
        print_int(frontier.quotient_outside)
        print(" fixed="); print_int(frontier.quotient_fixed)
        print(" pairs="); print_int(frontier.quotient_pairs)
        print(" singletons="); print_int(frontier.quotient_singletons)
        print(" classes="); print_int(frontier.quotient_classes)
        print(" in_grammar_images=")
        print_int(frontier.quotient_in_grammar_images)
        print(" outside_first="); print_int(frontier.outside_first)
        print(" outside_last="); print_int(frontier.outside_last)
        print(" fixed_first="); print_int(frontier.fixed_first)
        print(" fixed_last="); print_int(frontier.fixed_last)
        print(" pair_first="); print_int(frontier.pair_first)
        print(" pair_last="); print_int(frontier.pair_last)
        print(" singleton_first="); print_int(frontier.singleton_first)
        print(" singleton_last="); print_int(frontier.singleton_last)
        print("\n")
        print("PIREUS_ONF_CONTROLS codec_checks=")
        print_int(frontier.codec_checks)
        print(" unit_boundary_checks=")
        print_int(frontier.unit_boundary_checks)
        print(" quotient_symmetry_checks=")
        print_int(frontier.quotient_symmetry_checks)
        print(" direct_atlas_canary_checks=")
        print_int(frontier.direct_atlas_canary_checks)
        print(" direct_quotient_canary_checks=")
        print_int(frontier.direct_quotient_canary_checks)
        print(" synthetic_collision_checks=")
        print_int(frontier.synthetic_collision_checks)
        print(" positive_collision_checks=")
        print_int(frontier.positive_collision_checks)
        print(" incomplete_control_checks=")
        print_int(frontier.incomplete_control_checks)
        print(" failures="); print_int(frontier.failures)
        print("\n")
        onf_emit_digest("candidate_census", &frontier.candidate_digest)
        onf_emit_digest("separator_census", &frontier.separator_digest)
        onf_emit_digest("quotient_map", &frontier.quotient_digest)
        onf_emit_digest("aggregate_frontier", &frontier.frontier_digest)
        negative = 0
        while negative < PIREUS_ONF_NEGATIVE_CASES {
            print("PIREUS_ONF_NEGATIVE id="); print_int(negative)
            print(" pass=")
            print_int(if negative_cases[negative] { 1 } else { 0 })
            print(" process_launched=0\n")
            negative = negative + 1
        }
        print("PIREUS_ONF_RESULT valid=")
        print_int(if request_error == PIREUS_ONF_OK &&
            structural_failures == 0 && negative_failures == 0 { 1 } else { 0 })
        print(" error="); print_int(request_error)
        print(" structural_failures="); print_int(structural_failures)
        print(" generated="); print_int(frontier.generated)
        print(" typed_admitted="); print_int(frontier.typed_admitted)
        print(" typed_rejected="); print_int(frontier.typed_rejected)
        print(" bounded_internal_frontier_complete=")
        print_int(if frontier.complete { 1 } else { 0 })
        print(" candidate_selected=0 n3_novelty=0 n4_novelty=0")
        print(" algorithmic_novelty=0 material_novelty=0 scientific_novelty=0")
        print(" historical_novelty=0 priority_claim=0 claim_ready=0\n")
    }
    PireusOnfSummary {
        valid: request_error == PIREUS_ONF_OK && lineage.complete &&
            parent.complete && profiles.complete && action.complete &&
            frontier.complete && structural_failures == 0 &&
            negative_failures == 0,
        error: request_error,
        structural_failures: structural_failures,
        negative_failures: negative_failures,
        generated: frontier.generated,
        typed_admitted: frontier.typed_admitted,
        typed_rejected: frontier.typed_rejected,
        atlas_collision_candidates: frontier.atlas_collision_candidates,
        atlas_collision_edges: frontier.atlas_collision_edges,
        n2_relative_novelty: frontier.n2_relative_novelty,
        separators: frontier.separators,
        quotient_outside: frontier.quotient_outside,
        quotient_fixed: frontier.quotient_fixed,
        quotient_pairs: frontier.quotient_pairs,
        quotient_singletons: frontier.quotient_singletons,
        quotient_classes: frontier.quotient_classes,
        quotient_in_grammar_images: frontier.quotient_in_grammar_images,
        codec_checks: frontier.codec_checks,
        unit_boundary_checks: frontier.unit_boundary_checks,
        quotient_symmetry_checks: frontier.quotient_symmetry_checks,
        direct_canary_checks: frontier.direct_atlas_canary_checks +
            frontier.direct_quotient_canary_checks,
        candidate_digest: frontier.candidate_digest,
        separator_digest: frontier.separator_digest,
        quotient_digest: frontier.quotient_digest,
        frontier_digest: frontier.frontier_digest,
        bounded_internal_frontier_complete: frontier.complete,
        candidate_selected: false,
        n3_novelty: false,
        n4_novelty: false,
        algorithmic_novelty: false,
        material_novelty: false,
        scientific_novelty: false,
        historical_novelty: false,
        priority_claim: false,
        claim_ready: false,
    }
}
