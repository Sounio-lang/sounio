//! Sounio semantic authority for the exhaustive Pireus operator frontier V11.
//!
//! This child of the frozen V10 engine enumerates the complete 7200-member
//! single-coefficient grammar. It classifies exact atlas collisions and the
//! grammar intersection of every unsigned C2_diag orbit without selecting a
//! candidate. Unknown frontier counts and digests are outputs, never inputs.

use crypto::sha256::{
    SHA256State,
    sha256_init, sha256_update, sha256_finalize, sha256_digest_byte,
    sha256_compress,
}

