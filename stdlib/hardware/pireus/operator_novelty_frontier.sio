fn onf_parent_tensor_digest_expected(kind: i64) -> [i64; 8] {
    // These are frozen V10 parent commitments, not V11 frontier expectations.
    if kind == 0 {
        return [1834084630, 2129333647, 2564277308, 1947926938,
                3968335275, 492593715, 2962677067, 2888609230]
    }
    if kind == 1 {
        return [4116906921, 796944123, 1268235762, 1146844781,
                865160307, 1981207310, 3396389739, 2201519885]
    }
    [748326967, 4107818676, 1048309158, 223127322,
     3347210498, 3240193467, 2894393147, 3966930327]
}

fn onf_empty_tensor() -> PireusOnfTensor {
    PireusOnfTensor { coefficient: [0; 4096] }
}

fn onf_empty_digest() -> PireusOnfDigest {
    PireusOnfDigest { words: [0; 8] }
}

fn onf_tensor_index(output: i64, input_0: i64, input_1: i64) -> i64 {
    (input_0 * PIREUS_ONF_LANES + input_1) * PIREUS_ONF_LANES + output
}

fn onf_cell_output(cell: i64) -> i64 {
    cell - (cell / PIREUS_ONF_LANES) * PIREUS_ONF_LANES
}

fn onf_cell_input_0(cell: i64) -> i64 {
    (cell / PIREUS_ONF_LANES) / PIREUS_ONF_LANES
}

fn onf_cell_input_1(cell: i64) -> i64 {
    let pair = cell / PIREUS_ONF_LANES
    pair - (pair / PIREUS_ONF_LANES) * PIREUS_ONF_LANES
}

fn onf_candidate_cell(id: i64) -> i64 {
    let coordinate = id / 2
    let output = coordinate - (coordinate / 16) * 16
    let pair = coordinate / 16
    let input_1 = pair - (pair / 15) * 15 + 1
    let input_0 = pair / 15 + 1
    onf_tensor_index(output, input_0, input_1)
}

fn onf_candidate_delta(id: i64) -> i64 {
    if id - (id / 2) * 2 == 0 { 1 } else { -1 }
}

fn onf_encode_candidate(cell: i64, delta: i64) -> i64 {
    if cell < 0 || cell >= PIREUS_ONF_TENSOR_CELLS ||
        (delta != 1 && delta != -1) {
        return -1
    }
    let output = onf_cell_output(cell)
    let input_0 = onf_cell_input_0(cell)
    let input_1 = onf_cell_input_1(cell)
    if input_0 < 1 || input_0 >= PIREUS_ONF_LANES ||
        input_1 < 1 || input_1 >= PIREUS_ONF_LANES {
        return -1
    }
    let pair = (input_0 - 1) * 15 + (input_1 - 1)
    let coordinate = pair * 16 + output
    coordinate * 2 + if delta == 1 { 0 } else { 1 }
}

fn onf_permute_lane(value: i64) -> i64 {
    if value == 0 { 1 } else if value == 1 { 0 } else { value }
}

fn onf_sign_lane(value: i64) -> i64 {
    // V10 freezes an unsigned action. Keeping this explicit trivial character
    // preserves the signed-monomial transport contract without inventing signs.
    if value >= 0 && value < PIREUS_ONF_LANES { 1 } else { 0 }
}

fn onf_result_character(cell: i64) -> i64 {
    onf_sign_lane(onf_cell_output(cell)) *
        onf_sign_lane(onf_cell_input_0(cell)) *
        onf_sign_lane(onf_cell_input_1(cell))
}

fn onf_permute_cell(cell: i64) -> i64 {
    onf_tensor_index(
        onf_permute_lane(onf_cell_output(cell)),
        onf_permute_lane(onf_cell_input_0(cell)),
        onf_permute_lane(onf_cell_input_1(cell)),
    )
}

fn onf_basis_character(cell: i64) -> i64 {
    let target = onf_permute_cell(cell)
    onf_result_character(target)
}

fn onf_digest_add_i64(state: SHA256State, value: i64) -> SHA256State
with Mut, Panic, Div, Epistemic {
    var bytes: [u8; 256] = [0; 256]
    var index: i64 = 0
    while index < 8 {
        bytes[index] = ((value >> ((7 - index) * 8)) & 255) as u8
        index = index + 1
    }
    sha256_update(state, bytes, 8)
}

fn onf_digest_finish(state: SHA256State) -> PireusOnfDigest
with Mut, Panic, Div, Epistemic {
    let digest = sha256_finalize(state)
    var words: [i64; 8] = [0; 8]
    var word: i64 = 0
    while word < 8 {
        var value: i64 = 0
        var byte: i64 = 0
        while byte < 4 {
            value = (value << 8) |
                sha256_digest_byte(&digest, (word * 4 + byte) as i32)
            byte = byte + 1
        }
        words[word] = value
        word = word + 1
    }
    PireusOnfDigest { words: words }
}

fn onf_digest_nonzero(digest: &PireusOnfDigest) -> bool with Mut, Panic {
    var word: i64 = 0
    while word < 8 {
        if digest.words[word] != 0 { return true }
        word = word + 1
    }
    false
}

fn onf_words_equal(left: &[i64; 8], right: &[i64; 8]) -> bool
with Mut, Panic {
    var word: i64 = 0
    while word < 8 {
        if left[word] != right[word] { return false }
        word = word + 1
    }
    true
}

fn onf_text_sha256_matches(raw: string, expected: &[i64; 8]) -> bool
with Mut, Panic, Div, Epistemic {
    let size = str_len(raw)
    var state: [i64; 8] = [
        0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
        0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19
    ]
    var pos: i64 = 0
    while size - pos >= 64 {
        var block: [u8; 64] = [0; 64]
        var index: i64 = 0
        while index < 64 {
            var byte = str_char_at(raw, pos + index) as i64
            if byte < 0 { byte = byte + 256 }
            block[index] = byte as u8
            index = index + 1
        }
        state = sha256_compress(state, block)
        pos = pos + 64
    }
    var tail: [u8; 64] = [0; 64]
    let remaining = size - pos
    var index: i64 = 0
    while index < remaining {
        var byte = str_char_at(raw, pos + index) as i64
        if byte < 0 { byte = byte + 256 }
        tail[index] = byte as u8
        index = index + 1
    }
    tail[remaining] = 0x80 as u8
    if remaining > 55 {
        state = sha256_compress(state, tail)
        var clear: i64 = 0
        while clear < 64 {
            tail[clear] = 0
            clear = clear + 1
        }
    }
    let bit_length = size * 8
    tail[56] = ((bit_length >> 56) & 255) as u8
    tail[57] = ((bit_length >> 48) & 255) as u8
    tail[58] = ((bit_length >> 40) & 255) as u8
    tail[59] = ((bit_length >> 32) & 255) as u8
    tail[60] = ((bit_length >> 24) & 255) as u8
    tail[61] = ((bit_length >> 16) & 255) as u8
    tail[62] = ((bit_length >> 8) & 255) as u8
    tail[63] = (bit_length & 255) as u8
    state = sha256_compress(state, tail)
    onf_words_equal(&state, expected)
}

fn onf_tensor_digest_v10(table: &PireusOnfTensor) -> PireusOnfDigest
with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = onf_digest_add_i64(state, 730000)
    state = onf_digest_add_i64(state, PIREUS_ONF_TENSOR_CELLS)
    var cell: i64 = 0
    while cell < PIREUS_ONF_TENSOR_CELLS {
        state = onf_digest_add_i64(state, table.coefficient[cell])
        cell = cell + 1
    }
    onf_digest_finish(state)
}

