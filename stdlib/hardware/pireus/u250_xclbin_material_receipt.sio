    pub producer_role: i64,
    pub semantics_frozen: bool,
    pub parity_open_requested: bool,
    pub material_observed: bool,
    pub bitstream_present: bool,
    pub bitstream_digest_present: bool,
    pub metadata_present: bool,
    pub parent_semantics_matches: bool,
    pub parent_freeze_matches: bool,
    pub artifact_name_matches: bool,
    pub artifact_size_bytes: i64,
    pub digest_0: i64,
    pub digest_1: i64,
    pub digest_2: i64,
    pub digest_3: i64,
    pub digest_4: i64,
    pub digest_5: i64,
    pub digest_6: i64,
    pub digest_7: i64,
    pub xclbin_uuid_matches: bool,
    pub kernel_symbol_matches: bool,
    pub platform_matches: bool,
    pub vitis_version_matches: bool,
    pub requested_frequency_mhz: i64,
    pub achieved_frequency_tenths_mhz: i64,
    pub abi_argument_count: i64,
    pub interface_binding_count: i64,
    pub material_bank_binding_count: i64,
    pub argument_order_matches: bool,
    pub interface_mapping_matches: bool,
    pub material_bank_mapping_matches: bool,
    pub semantic_verdict_emitted_by_child: bool,
    pub kernel_execution_observed: bool,
    pub kernel_correctness_present: bool,
    pub operation_capability_count: i64,
    pub lowering_requested: bool,
    pub performance_present: bool,
    pub claim_ready_requested: bool,
}

pub struct PireusU250XclbinMaterialResult {
    pub valid: bool,
    pub status: i64,
    pub schema: i64,
    pub material_observed: bool,
    pub bitstream_present: bool,
    pub bitstream_digest_present: bool,
    pub metadata_present: bool,
    pub identity_matches: bool,
    pub abi_matches: bool,
    pub material_bank_mapping_matches: bool,
    pub artifact_size_bytes: i64,
    pub requested_frequency_mhz: i64,
    pub achieved_frequency_tenths_mhz: i64,
    pub abi_argument_count: i64,
    pub interface_binding_count: i64,
    pub material_bank_binding_count: i64,
    pub artifact_parity_open: bool,
    pub kernel_execution_observed: bool,
    pub kernel_correctness_present: bool,
    pub operation_capability_count: i64,
    pub lowering_authorized: bool,
    pub performance_present: bool,
    pub claim_ready: bool,
    pub authority_refused: bool,
    pub order_refused: bool,
    pub material_refused: bool,
    pub identity_refused: bool,
