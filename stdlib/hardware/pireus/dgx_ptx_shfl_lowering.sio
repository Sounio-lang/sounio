//! Sounio-first DGX candidate for the frozen XOR selector.
//!
//! The importer verifies the committed Garden and frozen parents, reuses the
//! complete pinned PTX corpus import, parses the selected `shfl.sync` section,
//! and derives a finite `.bfly` lane candidate. PTX semantics remain distinct
//! from generated SASS, DGX material support, and compiler emission.

use crypto::sha256::{
    SHA256State, SHA256Digest,
    sha256_init, sha256_update, sha256_finalize, sha256_digest_byte,
}
use hardware::pireus::xor_lowering_legality::{
    PIREUS_XOR_LOWERING_BITS,
    PIREUS_XOR_LOWERING_DIMENSION,
}
use hardware::pireus::ptx_import::{
    PIREUS_PTX_OK,
    pireus_ptx_expected_sha256,
    pireus_ptx_import_chunks,
}

pub const PIREUS_DGX_PTX_OK: i64 = 0
pub const PIREUS_DGX_PTX_ERR_FILE: i64 = 1
pub const PIREUS_DGX_PTX_ERR_HASH: i64 = 2
pub const PIREUS_DGX_PTX_ERR_HTML: i64 = 3
pub const PIREUS_DGX_PTX_ERR_SHAPE: i64 = 4
pub const PIREUS_DGX_PTX_ERR_PARENT: i64 = 5
pub const PIREUS_DGX_PTX_ERR_CANDIDATE: i64 = 6
pub const PIREUS_DGX_PTX_ERR_AUTHORITY: i64 = 7

const DGX_CAPTURE_NONE: i64 = 0
const DGX_CAPTURE_SYNTAX: i64 = 1
const DGX_CAPTURE_SEMANTICS: i64 = 2
const DGX_FROZEN_OPERATION_NODES: i64 = 5
const DGX_RESOLVED_SELECTOR_NODES: i64 = 1

