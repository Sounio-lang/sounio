    PireusPtxInventory {
        total_bytes: 0,
        chunk_count: 0,
        digest_match: false,
        selected_sections: 0,
        headings: 0,
        paragraphs: 0,
        rubrics: 0,
        pre_blocks: 0,
        syntax_lines: 0,
        semantics_lines: 0,
        example_lines: 0,
        tables: 0,
        table_rows: 0,
        code_tokens: 0,
        mode_f4e: 0,
        mode_b4e: 0,
        mode_rc8: 0,
        mode_ecl: 0,
        mode_ecr: 0,
        mode_rc16: 0,
        introduced_ptx_2_0: 0,
        target_sm_20_or_higher: 0,
        error: PIREUS_PTX_OK,
    }
}

