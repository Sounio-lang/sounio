//! Streaming, grammar-bounded importer for the first NVIDIA PTX slice.
//!
//! The normative input is the archived CUDA 13.2.0 PTX ISA 9.2 HTML. The
//! native bootstrap read_file builtin is bounded to 1 MiB, so byte transport
//! uses four ordered chunks. Sounio reconstructs the complete stream, verifies
//! its length and SHA-256, parses HTML tags and attributes, and projects the
//! unique `prmt` section without asserting a SASS or material-hardware link.

use crypto::sha256::{
    SHA256State, SHA256Digest,
    sha256_init, sha256_update, sha256_finalize,
}
use hardware::pireus::model::{
    PIREUS_RDF_TYPE, PIREUS_CLASS_ONTOLOGY_CLASS,
    PIREUS_CLASS_EVIDENCE_ROLE, PIREUS_HAS_EVIDENCE_ROLE,
}
use hardware::pireus::target_profile::{pireus_v01_store}
use ontology::query::{
    TripleStore, SparqlResult,
    triple_store_add, triple_iri,
    sparql_new, sparql_select, sparql_add_pattern, sparql_execute,
    triple_pattern_new, queryterm_variable, queryterm_iri,
}

pub const PIREUS_PTX_OK: i64 = 0
pub const PIREUS_PTX_ERR_FILE: i64 = 1
pub const PIREUS_PTX_ERR_LENGTH: i64 = 2
pub const PIREUS_PTX_ERR_HASH: i64 = 3
pub const PIREUS_PTX_ERR_HTML: i64 = 4
pub const PIREUS_PTX_ERR_DUPLICATE_SECTION: i64 = 5
pub const PIREUS_PTX_ERR_SELECTED_SHAPE: i64 = 6
pub const PIREUS_PTX_ERR_CAPACITY: i64 = 7

pub const PIREUS_PTX_CLASS_INSTRUCTION_FORM: i64 = 704000
pub const PIREUS_PTX_CLASS_VENDOR_CORPUS: i64 = 704001
pub const PIREUS_PTX_CLASS_VIRTUAL_ISA: i64 = 704002
pub const PIREUS_PTX_CLASS_RAW_MODE: i64 = 704003
pub const PIREUS_PTX_CLASS_TARGET_REQUIREMENT: i64 = 704004

pub const PIREUS_PTX_HAS_CORPUS: i64 = 704100
pub const PIREUS_PTX_HAS_VIRTUAL_ISA: i64 = 704101
pub const PIREUS_PTX_HAS_RAW_MODE: i64 = 704102
pub const PIREUS_PTX_HAS_TARGET_REQUIREMENT: i64 = 704103

pub const PIREUS_PTX_CORPUS_CUDA_13_2_PTX_9_2: i64 = 704200
pub const PIREUS_PTX_EVIDENCE_NORMATIVE_VENDOR: i64 = 704201
pub const PIREUS_PTX_VIRTUAL_ISA_9_2: i64 = 704202
pub const PIREUS_PTX_TARGET_SM_20_OR_HIGHER: i64 = 704203
pub const PIREUS_PTX_FORM_PRMT: i64 = 704204
pub const PIREUS_PTX_MODE_F4E: i64 = 704210
pub const PIREUS_PTX_MODE_B4E: i64 = 704211
pub const PIREUS_PTX_MODE_RC8: i64 = 704212
pub const PIREUS_PTX_MODE_ECL: i64 = 704213
pub const PIREUS_PTX_MODE_ECR: i64 = 704214
pub const PIREUS_PTX_MODE_RC16: i64 = 704215

const PIREUS_PTX_EXPECTED_BYTES: i64 = 3428895
const PIREUS_PTX_CHUNKS: i64 = 4
const PIREUS_PTX_CHUNK_BYTES: i64 = 1000000
const PIREUS_PTX_LAST_CHUNK_BYTES: i64 = 428895

const PTX_TAG_SECTION: i64 = 1
const PTX_TAG_H4: i64 = 2
const PTX_TAG_P: i64 = 3
const PTX_TAG_PRE: i64 = 4
const PTX_TAG_TABLE: i64 = 5
const PTX_TAG_TR: i64 = 6
const PTX_TAG_CODE: i64 = 7

const PTX_RUBRIC_SYNTAX: i64 = 1
const PTX_RUBRIC_DESCRIPTION: i64 = 2
const PTX_RUBRIC_SEMANTICS: i64 = 3
const PTX_RUBRIC_PTX_NOTES: i64 = 4
const PTX_RUBRIC_TARGET_NOTES: i64 = 5
const PTX_RUBRIC_EXAMPLES: i64 = 6
const PTX_RUBRIC_MNEMONIC: i64 = 7

pub struct PireusPtxInventory {
    pub total_bytes: i64,
    pub chunk_count: i64,
    pub digest_match: bool,
    pub selected_sections: i64,
    pub headings: i64,
    pub paragraphs: i64,
    pub rubrics: i64,
    pub pre_blocks: i64,
    pub syntax_lines: i64,
    pub semantics_lines: i64,
    pub example_lines: i64,
    pub tables: i64,
    pub table_rows: i64,
    pub code_tokens: i64,
    pub mode_f4e: i64,
    pub mode_b4e: i64,
    pub mode_rc8: i64,
    pub mode_ecl: i64,
    pub mode_ecr: i64,
    pub mode_rc16: i64,
    pub introduced_ptx_2_0: i64,
    pub target_sm_20_or_higher: i64,
    pub error: i64,
}

struct PtxTagMeta {
    selected_id: bool,
    rubric_class: bool,
    id_count: i64,
    malformed: bool,
}

struct PireusPtxParser {
    tag: [i8; 1024],
    tag_len: i64,
    tag_overflow: bool,
    in_tag: bool,
    tag_quote: i64,
    in_comment: bool,
    comment_dash_run: i64,
    section_depth: i64,
    selected_depth: i64,
    selected_active: bool,
    selected_done: bool,
    in_p: bool,
    p_rubric: bool,
    paragraph: [i8; 2048],
    paragraph_len: i64,
    paragraph_space: bool,
    paragraph_overflow: bool,
    in_code: bool,
    code: [i8; 512],
    code_len: i64,
    code_space: bool,
    code_overflow: bool,
    in_pre: bool,
    pre: [i8; 4096],
    pre_len: i64,
    pre_overflow: bool,
    current_rubric: i64,
    rubric_syntax: i64,
    rubric_description: i64,
    rubric_semantics: i64,
    rubric_ptx_notes: i64,
    rubric_target_notes: i64,
    rubric_examples: i64,
    rubric_mnemonic: i64,
    syntax_blocks: i64,
    semantics_blocks: i64,
    examples_blocks: i64,
    raw_mnemonic_tokens: i64,
    target_tokens: i64,
    inventory: PireusPtxInventory,
    error: i64,
}

struct PireusPtxRun {
    parser: PireusPtxParser,
    sha: SHA256State,
    total_bytes: i64,
    chunks: i64,
    error: i64,
}

