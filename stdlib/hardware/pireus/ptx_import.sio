    PireusPtxParser {
        tag: [0; 1024],
        tag_len: 0,
        tag_overflow: false,
        in_tag: false,
        tag_quote: 0,
        in_comment: false,
        comment_dash_run: 0,
        section_depth: 0,
        selected_depth: 0,
        selected_active: false,
        selected_done: false,
        in_p: false,
        p_rubric: false,
        paragraph: [0; 2048],
        paragraph_len: 0,
        paragraph_space: false,
        paragraph_overflow: false,
        in_code: false,
        code: [0; 512],
        code_len: 0,
        code_space: false,
        code_overflow: false,
        in_pre: false,
        pre: [0; 4096],
        pre_len: 0,
        pre_overflow: false,
        current_rubric: 0,
        rubric_syntax: 0,
        rubric_description: 0,
        rubric_semantics: 0,
        rubric_ptx_notes: 0,
        rubric_target_notes: 0,
        rubric_examples: 0,
        rubric_mnemonic: 0,
        syntax_blocks: 0,
        semantics_blocks: 0,
        examples_blocks: 0,
