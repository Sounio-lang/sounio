fn mbc_words_equal(left: &[i64; 8], right: &[i64; 8]) -> bool
with Mut, Panic {
    var word: i64 = 0
    while word < 8 {
        if left[word] != right[word] { return false }
        word = word + 1
    }
    true
}

fn mbc_words_nonzero(words: &[i64; 8]) -> bool with Mut, Panic {
    var word: i64 = 0
    while word < 8 {
        if words[word] != 0 { return true }
        word = word + 1
    }
    false
}

pub fn pireus_mbc_digest_nonzero(digest: &PireusMbcDigest) -> bool
with Mut, Panic {
    var word: i64 = 0
    while word < 8 {
        if digest.words[word] != 0 { return true }
        word = word + 1
    }
    false
}

fn mbc_digest_add_i64(state: SHA256State, value: i64) -> SHA256State
with Mut, Panic, Div, Epistemic {
    var bytes: [u8; 256] = [0; 256]
    var index: i64 = 0
    while index < 8 {
        bytes[index] = ((value >> ((7 - index) * 8)) & 255) as u8
        index = index + 1
    }
    sha256_update(state, bytes, 8)
}

fn mbc_digest_add_words(state: SHA256State, words: &[i64; 8]) -> SHA256State
with Mut, Panic, Div, Epistemic {
    var next = state
    var word: i64 = 0
    while word < 8 {
        next = mbc_digest_add_i64(next, words[word])
        word = word + 1
    }
    next
}

fn mbc_digest_finish(state: SHA256State) -> PireusMbcDigest
with Mut, Panic, Div, Epistemic {
    let digest = sha256_finalize(state)
    var words: [i64; 8] = [0; 8]
    var word: i64 = 0
    while word < 8 {
        var value: i64 = 0
        var byte: i64 = 0
        while byte < 4 {
            value = (value << 8) |
                sha256_digest_byte(&digest, (word * 4 + byte) as i32)
            byte = byte + 1
        }
        words[word] = value
        word = word + 1
    }
    PireusMbcDigest { words: words }
}

fn mbc_text_sha256(raw: string) -> PireusMbcDigest
with Mut, Panic, Div, Epistemic {
    let size = str_len(raw)
    var state: [i64; 8] = [
        0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
        0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19
    ]
    var pos: i64 = 0
    while size - pos >= 64 {
        var block: [u8; 64] = [0; 64]
        var index: i64 = 0
        while index < 64 {
            var byte = str_char_at(raw, pos + index) as i64
            if byte < 0 { byte = byte + 256 }
            block[index] = byte as u8
            index = index + 1
        }
        state = sha256_compress(state, block)
        pos = pos + 64
    }
    var tail: [u8; 64] = [0; 64]
    let remaining = size - pos
    var index: i64 = 0
    while index < remaining {
        var byte = str_char_at(raw, pos + index) as i64
        if byte < 0 { byte = byte + 256 }
        tail[index] = byte as u8
        index = index + 1
    }
    tail[remaining] = 0x80 as u8
    if remaining > 55 {
        state = sha256_compress(state, tail)
        var clear: i64 = 0
        while clear < 64 {
            tail[clear] = 0
            clear = clear + 1
        }
    }
    let bit_length = size * 8
    tail[56] = ((bit_length >> 56) & 255) as u8
    tail[57] = ((bit_length >> 48) & 255) as u8
    tail[58] = ((bit_length >> 40) & 255) as u8
    tail[59] = ((bit_length >> 32) & 255) as u8
    tail[60] = ((bit_length >> 24) & 255) as u8
    tail[61] = ((bit_length >> 16) & 255) as u8
    tail[62] = ((bit_length >> 8) & 255) as u8
    tail[63] = (bit_length & 255) as u8
    state = sha256_compress(state, tail)
    PireusMbcDigest { words: state }
}

fn mbc_span_has_prefix(
    raw: string, start: i64, end: i64, prefix: string,
) -> bool with Mut, Panic {
    if end - start < str_len(prefix) { return false }
    var index: i64 = 0
    while index < str_len(prefix) {
        if str_char_at(raw, start + index) != str_char_at(prefix, index) {
            return false
        }
        index = index + 1
    }
    true
}

fn mbc_parse_uint(raw: string, start: i64, end: i64) -> i64
with Mut, Panic {
    if start >= end { return -1 }
    var value: i64 = 0
    var pos = start
    while pos < end {
        let code = str_char_at(raw, pos)
        if code < 48 || code > 57 { return -1 }
        value = value * 10 + code - 48
        pos = pos + 1
    }
    value
}

fn mbc_parse_field_uint(
    raw: string, start: i64, end: i64, field: string,
) -> i64 with Mut, Panic {
    let field_len = str_len(field)
    var pos = start
    while pos + field_len <= end {
        var matches = true
        var index: i64 = 0
        while index < field_len {
            if str_char_at(raw, pos + index) != str_char_at(field, index) {
                matches = false
            }
            index = index + 1
        }
        if matches {
            var value_end = pos + field_len
            while value_end < end {
                let code = str_char_at(raw, value_end)
                if code < 48 || code > 57 { break }
                value_end = value_end + 1
            }
            return mbc_parse_uint(raw, pos + field_len, value_end)
        }
        pos = pos + 1
    }
    -1
}

fn mbc_parse_probe_set(raw: string) -> PireusMbcProbeSet
with Mut, Panic {
    var ids: [i64; 32] = [0; 32]
    var words: [i64; 256] = [0; 256]
    var seen: [i64; 32] = [0; 32]
    var active: i64 = -1
    var active_cells: i64 = 0
    var records: i64 = 0
    var cells: i64 = 0
    var failures: i64 = 0
    var start: i64 = 0
    while start < str_len(raw) {
        var end = start
        while end < str_len(raw) && str_char_at(raw, end) != 10 {
            end = end + 1
        }
        var line_end = end
        if line_end > start && str_char_at(raw, line_end - 1) == 13 {
            line_end = line_end - 1
        }
        if mbc_span_has_prefix(
            raw, start, line_end, "PIREUS_POC_CANON_BITS admitted=") {
            if active >= 0 { failures = failures + 1 }
            let admitted = mbc_parse_field_uint(
                raw, start, line_end, "admitted=")
            if admitted < 0 || admitted >= PIREUS_MBC_PROBES ||
                admitted != records || seen[admitted] != 0 {
                failures = failures + 1
                active = -1
            } else {
                active = admitted
                active_cells = 0
                seen[admitted] = 1
                ids[admitted] = admitted
            }
        } else if active >= 0 && active_cells < 256 {
            var bit: i64 = -1
            if active_cells == 0 && mbc_span_has_prefix(
                raw, start, line_end, " bits=") {
                bit = mbc_parse_field_uint(raw, start, line_end, "bits=")
            } else if active_cells > 0 &&
                mbc_span_has_prefix(raw, start, line_end, ":") {
                bit = mbc_parse_uint(raw, start + 1, line_end)
            }
            if bit >= 0 {
                if bit > 1 { failures = failures + 1 }
                else {
                    let word = active_cells / 32
                    let shift = 31 - active_cells % 32
                    words[active * 8 + word] =
                        words[active * 8 + word] | (bit << shift)
                    active_cells = active_cells + 1
                    cells = cells + 1
                    if active_cells == 256 {
                        records = records + 1
                        active = -1
                    }
                }
            }
        }
        start = end + 1
    }
    if active >= 0 { failures = failures + 1 }
    var duplicate_contents: i64 = 0
    var left: i64 = 0
    while left < records {
        var right = left + 1
        while right < records {
            var equal = true
            var word: i64 = 0
            while word < 8 {
                if words[left * 8 + word] != words[right * 8 + word] {
                    equal = false
                }
                word = word + 1
            }
            if equal { duplicate_contents = duplicate_contents + 1 }
            right = right + 1
        }
        left = left + 1
    }
    PireusMbcProbeSet {
        ids: ids,
        canonical_words: words,
        records: records,
        cells: cells,
        duplicate_contents: duplicate_contents,
        failures: failures,
        complete: records == PIREUS_MBC_PROBES && cells == 8192 &&
            duplicate_contents == 0 && failures == 0,
    }
}

fn mbc_expected_digest_allowed(language: i64, role: i64, stage: i64) -> bool {
    language == PIREUS_MBC_LANGUAGE_SOUNIO &&
        role == PIREUS_MBC_ROLE_SEMANTIC_AUTHORITY &&
        stage == PIREUS_MBC_STAGE_SOUNIO_EXECUTABLE
}

fn mbc_trust_language_compatible(trust: i64, language: i64, role: i64) -> bool {
    if trust == PIREUS_MBC_TRUST_SOUNIO_RECEIPT {
        language == PIREUS_MBC_LANGUAGE_SOUNIO &&
            role == PIREUS_MBC_ROLE_SEMANTIC_AUTHORITY
    } else if trust == PIREUS_MBC_TRUST_LEAN_KERNEL ||
        trust == PIREUS_MBC_TRUST_LEAN_NATIVE_DECIDE {
        language == PIREUS_MBC_LANGUAGE_LEAN &&
            role == PIREUS_MBC_ROLE_FORMAL_PARITY
    } else if trust == PIREUS_MBC_TRUST_KOKA_EFFECT {
        language == PIREUS_MBC_LANGUAGE_KOKA &&
            role == PIREUS_MBC_ROLE_EFFECT_PARITY
    } else if trust == PIREUS_MBC_TRUST_CPP_MATERIAL {
        language == PIREUS_MBC_LANGUAGE_CPP &&
            role == PIREUS_MBC_ROLE_MATERIAL_PARITY
    } else if trust == PIREUS_MBC_TRUST_HASKELL_OBSERVATION {
        language == PIREUS_MBC_LANGUAGE_HASKELL &&
            role == PIREUS_MBC_ROLE_DENOTATIONAL_BASELINE
    } else { false }
}

fn mbc_partition_parameters_valid(
    actions: i64, blocks: i64, width: i64,
) -> bool {
    actions > 0 && blocks > 0 && width > 0 &&
        actions == blocks * width
}

pub fn pireus_mbc_block_shape_valid(
    index: i64, start: i64, width: i64, end: i64,
) -> bool {
    index >= 0 && index < PIREUS_MBC_BLOCKS &&
        width == PIREUS_MBC_BLOCK_WIDTH &&
        start == index * PIREUS_MBC_BLOCK_WIDTH &&
        end == start + width && end <= PIREUS_MBC_ACTIONS
}

fn mbc_same_domain_result_compatible(
    exact_domain_equal: bool, left_result_equal: bool,
    determinism_mode: i64,
) -> bool {
    if determinism_mode != PIREUS_MBC_DETERMINISM_HOST_INDEPENDENT_EXACT &&
        determinism_mode != PIREUS_MBC_DETERMINISM_MATERIAL_BOUND {
        return false
    }
    !exact_domain_equal || left_result_equal
}

fn mbc_determinism_domain_valid(
    determinism_mode: i64,
    toolchain_bound: bool,
    material_bound: bool,
    policy_bound: bool,
) -> bool {
    if determinism_mode ==
        PIREUS_MBC_DETERMINISM_HOST_INDEPENDENT_EXACT {
        !toolchain_bound && !material_bound && !policy_bound
    } else if determinism_mode == PIREUS_MBC_DETERMINISM_MATERIAL_BOUND {
        toolchain_bound && material_bound && policy_bound
    } else { false }
}

fn mbc_work_domain_determinism_valid(
    domain: &PireusMbcWorkDomain,
) -> bool with Mut, Panic {
    mbc_determinism_domain_valid(
        domain.work_function.determinism_mode,
        mbc_words_nonzero(&domain.toolchain_sha256),
        mbc_words_nonzero(&domain.material_sha256),
        mbc_words_nonzero(&domain.execution_policy_sha256))
}

fn mbc_partition_result() -> PireusMbcPartitionResult
with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = mbc_digest_add_i64(state, MBC_TAG_PARTITION)
    state = mbc_digest_add_i64(state, PIREUS_MBC_ACTIONS)
    state = mbc_digest_add_i64(state, PIREUS_MBC_BLOCKS)
    state = mbc_digest_add_i64(state, PIREUS_MBC_BLOCK_WIDTH)
    var blocks: i64 = 0
    var views: i64 = 0
    var failures: i64 = 0
    var previous_end: i64 = 0
    var index: i64 = 0
    while index < PIREUS_MBC_BLOCKS {
        let start = index * PIREUS_MBC_BLOCK_WIDTH
        let width = PIREUS_MBC_BLOCK_WIDTH
        let end = start + width
        if !pireus_mbc_block_shape_valid(index, start, width, end) ||
            start != previous_end {
            failures = failures + 1
        }
        state = mbc_digest_add_i64(state, index)
        state = mbc_digest_add_i64(state, start)
        state = mbc_digest_add_i64(state, width)
        state = mbc_digest_add_i64(state, end)
        blocks = blocks + 1
        views = views + width
        previous_end = end
        index = index + 1
    }
    if previous_end != PIREUS_MBC_ACTIONS ||
        !mbc_partition_parameters_valid(
            PIREUS_MBC_ACTIONS, PIREUS_MBC_BLOCKS,
            PIREUS_MBC_BLOCK_WIDTH) {
        failures = failures + 1
    }
    PireusMbcPartitionResult {
        blocks: blocks,
        views: views,
        failures: failures,
        complete: blocks == PIREUS_MBC_BLOCKS &&
            views == PIREUS_MBC_ACTIONS && failures == 0,
        digest: mbc_digest_finish(state),
    }
}

fn mbc_work_function() -> PireusMbcWorkFunctionIdentity {
    PireusMbcWorkFunctionIdentity {
        function_id: MBC_WORK_FUNCTION_V13_STREAMING_ACTION,
        source_sha256: mbc_parent_source_hash(),
        semantics_sha256: mbc_parent_semantics_hash(),
        action_count: PIREUS_MBC_ACTIONS,
        ordering: MBC_ORDER_V13_MATRIX_THEN_SWAP,
        determinism_mode:
            PIREUS_MBC_DETERMINISM_HOST_INDEPENDENT_EXACT,
    }
}

fn mbc_partition_schema() -> PireusMbcPartitionSchema {
    PireusMbcPartitionSchema {
        schema_id: MBC_PARTITION_FIXED_64_X_630,
        work_start: 0,
        work_end: PIREUS_MBC_ACTIONS,
        block_count: PIREUS_MBC_BLOCKS,
        block_width: PIREUS_MBC_BLOCK_WIDTH,
    }
}

fn mbc_strategy_digest() -> PireusMbcDigest
with Mut, Panic, Div, Epistemic {
    let garden = mbc_garden_hash()
    let contract = mbc_contract_hash()
    let source = mbc_parent_source_hash()
    let semantics = mbc_parent_semantics_hash()
    let transcript = mbc_parent_transcript_hash()
    let genome = mbc_operator_genome_hash()
    var state = sha256_init()
    state = mbc_digest_add_i64(state, MBC_TAG_STRATEGY)
    state = mbc_digest_add_i64(state, PIREUS_MBC_SCHEMA)
    state = mbc_digest_add_words(state, &garden)
    state = mbc_digest_add_words(state, &contract)
    state = mbc_digest_add_words(state, &source)
    state = mbc_digest_add_words(state, &semantics)
    state = mbc_digest_add_words(state, &transcript)
    state = mbc_digest_add_words(state, &genome)
    state = mbc_digest_add_i64(state, MBC_WORK_FUNCTION_V13_STREAMING_ACTION)
    state = mbc_digest_add_i64(state, MBC_ORDER_V13_MATRIX_THEN_SWAP)
    state = mbc_digest_add_i64(
        state, PIREUS_MBC_DETERMINISM_HOST_INDEPENDENT_EXACT)
    state = mbc_digest_add_i64(state, MBC_PARTITION_FIXED_64_X_630)
    state = mbc_digest_add_i64(state, PIREUS_MBC_PROBES)
    state = mbc_digest_add_i64(state, PIREUS_MBC_BLOCKS)
    state = mbc_digest_add_i64(state, PIREUS_MBC_BLOCK_WIDTH)
    mbc_digest_finish(state)
}

fn mbc_probe_set_digest(probes: &PireusMbcProbeSet) -> PireusMbcDigest
with Mut, Panic, Div, Epistemic {
    let transcript = mbc_parent_transcript_hash()
    var state = sha256_init()
    state = mbc_digest_add_i64(state, MBC_TAG_PROBE_SET)
    state = mbc_digest_add_i64(state, probes.records)
    state = mbc_digest_add_words(state, &transcript)
    var probe: i64 = 0
    while probe < probes.records {
        state = mbc_digest_add_i64(state, probes.ids[probe])
        var word: i64 = 0
        while word < 8 {
            state = mbc_digest_add_i64(
                state, probes.canonical_words[probe * 8 + word])
            word = word + 1
        }
        probe = probe + 1
    }
    mbc_digest_finish(state)
}

fn mbc_work_domain(
    probes: &PireusMbcProbeSet,
    strategy: &PireusMbcDigest,
    probe_index: i64,
    block_index: i64,
) -> PireusMbcWorkDomain with Mut, Panic {
    var canonical: [i64; 8] = [0; 8]
    var word: i64 = 0
    while word < 8 {
        canonical[word] =
            probes.canonical_words[probe_index * 8 + word]
        word = word + 1
    }
    let start = block_index * PIREUS_MBC_BLOCK_WIDTH
    PireusMbcWorkDomain {
        protocol_schema: PIREUS_MBC_SCHEMA,
        work_function: mbc_work_function(),
        operator_genome_sha256: mbc_operator_genome_hash(),
        strategy_sha256: strategy.words,
        probe: PireusMbcProbeIdentity {
            probe_id: probes.ids[probe_index],
            canonical_words: canonical,
        },
        partition: mbc_partition_schema(),
        block_index: block_index,
        block_start: start,
        block_width: PIREUS_MBC_BLOCK_WIDTH,
        block_end: start + PIREUS_MBC_BLOCK_WIDTH,
        numeric_mode: MBC_NUMERIC_EXACT_BOOLEAN_INTEGER,
        toolchain_sha256: [MBC_MATERIAL_NOT_SEMANTIC; 8],
        material_sha256: [MBC_MATERIAL_NOT_SEMANTIC; 8],
        execution_policy_sha256: [MBC_MATERIAL_NOT_SEMANTIC; 8],
    }
}

fn mbc_work_address(domain: &PireusMbcWorkDomain) -> PireusMbcWorkAddress
with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = mbc_digest_add_i64(state, MBC_TAG_WORK_DOMAIN)
    state = mbc_digest_add_i64(state, domain.protocol_schema)
    state = mbc_digest_add_i64(state, domain.work_function.function_id)
    state = mbc_digest_add_words(
        state, &domain.work_function.source_sha256)
    state = mbc_digest_add_words(
        state, &domain.work_function.semantics_sha256)
    state = mbc_digest_add_i64(state, domain.work_function.action_count)
    state = mbc_digest_add_i64(state, domain.work_function.ordering)
    state = mbc_digest_add_i64(
        state, domain.work_function.determinism_mode)
    state = mbc_digest_add_words(state, &domain.operator_genome_sha256)
    state = mbc_digest_add_words(state, &domain.strategy_sha256)
    state = mbc_digest_add_i64(state, domain.probe.probe_id)
    state = mbc_digest_add_words(state, &domain.probe.canonical_words)
    state = mbc_digest_add_i64(state, domain.partition.schema_id)
    state = mbc_digest_add_i64(state, domain.partition.work_start)
    state = mbc_digest_add_i64(state, domain.partition.work_end)
    state = mbc_digest_add_i64(state, domain.partition.block_count)
    state = mbc_digest_add_i64(state, domain.partition.block_width)
    state = mbc_digest_add_i64(state, domain.block_index)
    state = mbc_digest_add_i64(state, domain.block_start)
    state = mbc_digest_add_i64(state, domain.block_width)
    state = mbc_digest_add_i64(state, domain.block_end)
    state = mbc_digest_add_i64(state, domain.numeric_mode)
    state = mbc_digest_add_words(state, &domain.toolchain_sha256)
    state = mbc_digest_add_words(state, &domain.material_sha256)
    state = mbc_digest_add_words(state, &domain.execution_policy_sha256)
    PireusMbcWorkAddress { digest: mbc_digest_finish(state) }
}

fn mbc_plan(
    probes: &PireusMbcProbeSet,
    strategy: &PireusMbcDigest,
) -> PireusMbcPlanResult with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = mbc_digest_add_i64(state, MBC_TAG_PLAN)
    state = mbc_digest_add_i64(state, PIREUS_MBC_LOGICAL_JOBS)
    state = mbc_digest_add_words(state, &strategy.words)
    var first = mbc_zero_digest()
    var last = mbc_zero_digest()
    var domains: i64 = 0
    var addresses: i64 = 0
    var domain_failures: i64 = 0
    var replay_checks: i64 = 0
    var replay_failures: i64 = 0
    var probe: i64 = 0
    while probe < PIREUS_MBC_PROBES {
        var block: i64 = 0
        while block < PIREUS_MBC_BLOCKS {
            let domain = mbc_work_domain(probes, strategy, probe, block)
            let address = mbc_work_address(&domain)
            let replay = mbc_work_address(&domain)
            domains = domains + 1
            addresses = addresses + 1
            if !mbc_work_domain_determinism_valid(&domain) {
                domain_failures = domain_failures + 1
            }
            replay_checks = replay_checks + 1
            if !mbc_words_equal(&address.digest.words, &replay.digest.words) {
                replay_failures = replay_failures + 1
            }
            if domains == 1 { first = address.digest }
            last = address.digest
            state = mbc_digest_add_i64(state, probe)
            state = mbc_digest_add_i64(state, block)
            state = mbc_digest_add_words(state, &address.digest.words)
            block = block + 1
        }
        probe = probe + 1
    }
    let plan_digest = mbc_digest_finish(state)
    PireusMbcPlanResult {
        digest: plan_digest,
        first_address: first,
        last_address: last,
        domains: domains,
        addresses: addresses,
        domain_failures: domain_failures,
        replay_checks: replay_checks,
        replay_failures: replay_failures,
    }
}

fn mbc_negative_surface() -> [i64; 2] {
    var passed: i64 = 0
    var total: i64 = 0
    total = total + 1
    if !pireus_mbc_block_shape_valid(-1, 0, 630, 630) {
        passed = passed + 1
    }
    total = total + 1
    if !pireus_mbc_block_shape_valid(64, 40320, 630, 40950) {
        passed = passed + 1
    }
    total = total + 1
    if !pireus_mbc_block_shape_valid(63, 39689, 630, 40319) {
        passed = passed + 1
    }
    total = total + 1
    if !pireus_mbc_block_shape_valid(63, 39690, 629, 40319) {
        passed = passed + 1
    }
    total = total + 1
    if !pireus_mbc_block_shape_valid(63, 39690, 0, 39690) {
        passed = passed + 1
    }
    total = total + 1
    if !pireus_mbc_block_shape_valid(63, 39690, 630, 40319) {
        passed = passed + 1
    }
    total = total + 1
    if !mbc_partition_parameters_valid(40319, 64, 630) {
        passed = passed + 1
    }
    total = total + 1
    if !mbc_partition_parameters_valid(40320, 63, 630) {
        passed = passed + 1
    }
    total = total + 1
    if !mbc_expected_digest_allowed(
        PIREUS_MBC_LANGUAGE_LEAN, PIREUS_MBC_ROLE_FORMAL_PARITY,
        PIREUS_MBC_STAGE_SOUNIO_EXECUTABLE) {
        passed = passed + 1
    }
    total = total + 1
    if !mbc_expected_digest_allowed(
        PIREUS_MBC_LANGUAGE_CPP, PIREUS_MBC_ROLE_MATERIAL_PARITY,
        PIREUS_MBC_STAGE_SOUNIO_EXECUTABLE) {
        passed = passed + 1
    }
    total = total + 1
    if !mbc_expected_digest_allowed(
        PIREUS_MBC_LANGUAGE_LLM, PIREUS_MBC_ROLE_REVIEW_ONLY,
        PIREUS_MBC_STAGE_SOUNIO_EXECUTABLE) {
        passed = passed + 1
    }
    total = total + 1
    if !mbc_expected_digest_allowed(
        PIREUS_MBC_LANGUAGE_PYTHON, PIREUS_MBC_ROLE_SEMANTIC_AUTHORITY,
        PIREUS_MBC_STAGE_SOUNIO_EXECUTABLE) {
        passed = passed + 1
    }
    total = total + 1
    if !mbc_expected_digest_allowed(
        PIREUS_MBC_LANGUAGE_RUST, PIREUS_MBC_ROLE_SEMANTIC_AUTHORITY,
        PIREUS_MBC_STAGE_SOUNIO_EXECUTABLE) {
        passed = passed + 1
    }
    total = total + 1
    if !mbc_trust_language_compatible(
        PIREUS_MBC_TRUST_LEAN_KERNEL,
        PIREUS_MBC_LANGUAGE_CPP, PIREUS_MBC_ROLE_MATERIAL_PARITY) {
        passed = passed + 1
    }
    total = total + 1
    if !mbc_trust_language_compatible(
        PIREUS_MBC_TRUST_LEAN_NATIVE_DECIDE,
        PIREUS_MBC_LANGUAGE_LEAN, PIREUS_MBC_ROLE_SEMANTIC_AUTHORITY) {
        passed = passed + 1
    }
    total = total + 1
    if !mbc_same_domain_result_compatible(
        true, false, PIREUS_MBC_DETERMINISM_HOST_INDEPENDENT_EXACT) {
        passed = passed + 1
    }
    total = total + 1
    if !mbc_same_domain_result_compatible(true, false, 99) {
        passed = passed + 1
    }
    total = total + 1
    if !mbc_determinism_domain_valid(
        PIREUS_MBC_DETERMINISM_MATERIAL_BOUND,
        false, false, false) {
        passed = passed + 1
    }
    total = total + 1
    if !mbc_determinism_domain_valid(99, true, true, true) {
        passed = passed + 1
    }
    [passed, total]
}

pub fn pireus_multiprobe_block_certification_request() -> PireusMbcRequest {
    PireusMbcRequest {
        producer_language: PIREUS_MBC_LANGUAGE_SOUNIO,
        producer_role: PIREUS_MBC_ROLE_SEMANTIC_AUTHORITY,
        stage: PIREUS_MBC_STAGE_SOUNIO_EXECUTABLE,
        policy_state: PIREUS_MBC_POLICY_READY,
        garden_bound: true,
        contract_bound: true,
        parent_transcript_bound: true,
        parent_semantics_bound: true,
        operator_genome_bound: true,
        exact_domain_equality_required: true,
        canonical_bytes_required: true,
        schema_induced_partition_required: true,
        complete_actual_extent_required: true,
        host_independent_exact_required: true,
        expected_result_present: false,
        observed_as_expected_requested: false,
        semantic_write_from_parity: false,
        parity_process_requested: false,
        cross_trust_aggregation_requested: false,
        native_decide_as_kernel_requested: false,
        same_domain_conflict_accepted: false,
        review_promoted_to_authority: false,
        python_oracle_requested: false,
        rust_oracle_requested: false,
        dgx_slurm_requested: false,
        u250_declared: 2,
        u250_installed: 1,
        u250_pending: 1,
        u250_enumeration_failures: 0,
        actual_block_execution_claimed: false,
        reuse_claimed: false,
        speedup_claimed: false,
        novelty_claimed: false,
        claim_ready_requested: false,
        raw_elf_requested: false,
    }
}

fn mbc_request_negative_surface() -> [i64; 2] {
    let canonical = pireus_multiprobe_block_certification_request()
    var bad = canonical
    var passed: i64 = 0
    var total: i64 = 0

    bad = canonical; bad.policy_state = 0
    total = total + 1
    if pireus_mbc_request_error(&bad) != PIREUS_MBC_OK {
        passed = passed + 1
