fn mbc_zero_digest() -> PireusMbcDigest {
    PireusMbcDigest { words: [0; 8] }
}

fn mbc_failure_summary(error: i64) -> PireusMbcSummary {
    PireusMbcSummary {
        valid: false,
        error: error,
        garden_match: false,
        contract_match: false,
        parent_transcript_match: false,
        parent_records: 0,
        parent_canonical_cells: 0,
        parent_duplicate_contents: 0,
        parent_parse_failures: 0,
        partition_blocks: 0,
        partition_views: 0,
        partition_failures: 0,
        work_domains: 0,
        work_addresses: 0,
        domain_validation_failures: 0,
        address_replay_checks: 0,
        address_replay_failures: 0,
        negative_cases_passed: 0,
        negative_cases_total: 0,
        strategy_digest: mbc_zero_digest(),
        probe_set_digest: mbc_zero_digest(),
        partition_digest: mbc_zero_digest(),
        plan_digest: mbc_zero_digest(),
        first_work_address: mbc_zero_digest(),
        last_work_address: mbc_zero_digest(),
        completed_blocks: 0,
        reuse_hits: 0,
        expected_result_digests: 0,
        actual_block_execution_complete: false,
        any_block_reused: false,
        all_v13_probes_certified: false,
        deterministic_purity_formally_proved: false,
        material_bound_profile_instantiated: false,
        collision_free_semantic_identity: false,
        formal_parity_open: false,
        effect_parity_open: false,
        material_parity_open: false,
        denotational_parity_open: false,
        performance_measured: false,
        speedup_admitted: false,
        cache_hit_rate_admitted: false,
        algorithmic_novelty: false,
        material_novelty: false,
        scientific_novelty: false,
        global_novelty: false,
        historical_novelty: false,
        priority_claim: false,
        claim_ready: false,
    }
}

