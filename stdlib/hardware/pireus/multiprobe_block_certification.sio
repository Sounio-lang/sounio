    }
    bad = canonical; bad.rust_oracle_requested = true
    total = total + 1
    if pireus_mbc_request_error(&bad) != PIREUS_MBC_OK {
        passed = passed + 1
    }
    bad = canonical; bad.dgx_slurm_requested = true
    total = total + 1
    if pireus_mbc_request_error(&bad) != PIREUS_MBC_OK {
        passed = passed + 1
    }
    bad = canonical; bad.u250_declared = 1
    total = total + 1
    if pireus_mbc_request_error(&bad) != PIREUS_MBC_OK {
        passed = passed + 1
    }
    bad = canonical; bad.u250_installed = 2; bad.u250_pending = 0
    total = total + 1
    if pireus_mbc_request_error(&bad) != PIREUS_MBC_OK {
        passed = passed + 1
    }
    bad = canonical; bad.u250_enumeration_failures = 1
    total = total + 1
    if pireus_mbc_request_error(&bad) != PIREUS_MBC_OK {
        passed = passed + 1
    }
    bad = canonical; bad.actual_block_execution_claimed = true
    total = total + 1
    if pireus_mbc_request_error(&bad) != PIREUS_MBC_OK {
        passed = passed + 1
    }
    bad = canonical; bad.reuse_claimed = true
    total = total + 1
    if pireus_mbc_request_error(&bad) != PIREUS_MBC_OK {
        passed = passed + 1
    }
    bad = canonical; bad.speedup_claimed = true
    total = total + 1
    if pireus_mbc_request_error(&bad) != PIREUS_MBC_OK {
        passed = passed + 1
    }
    bad = canonical; bad.novelty_claimed = true
    total = total + 1
    if pireus_mbc_request_error(&bad) != PIREUS_MBC_OK {
        passed = passed + 1
    }
    bad = canonical; bad.claim_ready_requested = true
    total = total + 1
    if pireus_mbc_request_error(&bad) != PIREUS_MBC_OK {
        passed = passed + 1
    }
    bad = canonical; bad.raw_elf_requested = true
    total = total + 1
    if pireus_mbc_request_error(&bad) != PIREUS_MBC_OK {
        passed = passed + 1
    }
    [passed, total]
}

pub fn pireus_multiprobe_block_certification_paths() -> PireusMbcPaths {
    PireusMbcPaths {
        garden:
            "tools/pireus/GARDEN_PIREUS_MULTIPROBE_BLOCK_CERTIFICATION_V14.md",
        contract:
            "tools/pireus/PIREUS_MULTIPROBE_BLOCK_CERTIFICATION_CONTRACT_V14.md",
        parent_transcript:
            "tools/pireus/operator_orbit_canonicalization.first.v13",
    }
}

pub fn pireus_mbc_request_error(request: &PireusMbcRequest) -> i64 {
    if request.policy_state != PIREUS_MBC_POLICY_READY {
        return PIREUS_MBC_ERR_POLICY
    }
    if request.producer_language != PIREUS_MBC_LANGUAGE_SOUNIO ||
        request.producer_role != PIREUS_MBC_ROLE_SEMANTIC_AUTHORITY {
        return PIREUS_MBC_ERR_AUTHORITY
    }
    if request.stage != PIREUS_MBC_STAGE_SOUNIO_EXECUTABLE {
        return PIREUS_MBC_ERR_STAGE
    }
    if !request.garden_bound || !request.contract_bound ||
        !request.parent_transcript_bound ||
        !request.parent_semantics_bound || !request.operator_genome_bound {
        return PIREUS_MBC_ERR_LINEAGE
    }
    if !request.exact_domain_equality_required ||
        !request.canonical_bytes_required ||
        !request.schema_induced_partition_required ||
        !request.complete_actual_extent_required {
        return PIREUS_MBC_ERR_IDENTITY
    }
    if !request.host_independent_exact_required ||
        request.same_domain_conflict_accepted {
        return PIREUS_MBC_ERR_DETERMINISM
    }
    if request.expected_result_present ||
        request.observed_as_expected_requested {
        return PIREUS_MBC_ERR_RESULT_INJECTION
    }
    if request.semantic_write_from_parity ||
        request.parity_process_requested ||
        request.review_promoted_to_authority {
        return PIREUS_MBC_ERR_PARITY
    }
    if request.cross_trust_aggregation_requested ||
        request.native_decide_as_kernel_requested {
        return PIREUS_MBC_ERR_TRUST
    }
    if request.python_oracle_requested || request.rust_oracle_requested {
        return PIREUS_MBC_ERR_AUTHORITY
    }
    if request.dgx_slurm_requested {
        return PIREUS_MBC_ERR_MATERIAL_ROUTE
    }
    if request.u250_declared != 2 || request.u250_installed != 1 ||
        request.u250_pending != 1 ||
        request.u250_enumeration_failures != 0 ||
        request.u250_installed + request.u250_pending !=
            request.u250_declared {
        return PIREUS_MBC_ERR_INVENTORY
    }
    if request.actual_block_execution_claimed || request.reuse_claimed ||
        request.speedup_claimed || request.novelty_claimed ||
        request.claim_ready_requested {
        return PIREUS_MBC_ERR_CLAIM
    }
    if request.raw_elf_requested { return PIREUS_MBC_ERR_RAW_ELF }
    PIREUS_MBC_OK
}

fn mbc_lineage(paths: &PireusMbcPaths) -> PireusMbcLineage
with IO, Mut, Panic, Div, Alloc, Epistemic {
    if file_size(paths.garden) <= 0 || file_size(paths.contract) <= 0 ||
        file_size(paths.parent_transcript) <= 0 {
        return PireusMbcLineage {
            garden_match: false,
            contract_match: false,
            parent_transcript_match: false,
            complete: false,
        }
    }
    let garden_raw = read_file(paths.garden)
    let contract_raw = read_file(paths.contract)
    let transcript_raw = read_file(paths.parent_transcript)
    let garden = mbc_text_sha256(garden_raw)
    let contract = mbc_text_sha256(contract_raw)
    let transcript = mbc_text_sha256(transcript_raw)
    let expected_garden = mbc_garden_hash()
    let expected_contract = mbc_contract_hash()
    let expected_transcript = mbc_parent_transcript_hash()
    let garden_match = mbc_words_equal(&garden.words, &expected_garden)
    let contract_match = mbc_words_equal(&contract.words, &expected_contract)
    let transcript_match = mbc_words_equal(
        &transcript.words, &expected_transcript)
    PireusMbcLineage {
        garden_match: garden_match,
        contract_match: contract_match,
        parent_transcript_match: transcript_match,
        complete: garden_match && contract_match && transcript_match,
    }
}

fn mbc_emit_digest(digest: &PireusMbcDigest) with IO, Mut, Panic {
    var word: i64 = 0
    while word < 8 {
        if word > 0 { print(":") }
        print_int(digest.words[word])
        word = word + 1
    }
}

pub fn pireus_multiprobe_block_certification_evaluate(
    request: &PireusMbcRequest,
    paths: &PireusMbcPaths,
    emit: bool,
) -> PireusMbcSummary with IO, Mut, Panic, Div, Alloc, Epistemic {
    let request_error = pireus_mbc_request_error(request)
    if request_error != PIREUS_MBC_OK {
        if emit {
            print("PIREUS_MBC_PREEXEC_REFUSAL error=")
            print_int(request_error)
            print(" semantic_work_started=0\n")
        }
        return mbc_failure_summary(request_error)
    }
    let lineage = mbc_lineage(paths)
    if !lineage.complete {
        if emit {
            print("PIREUS_MBC_LINEAGE garden_match=")
            print_int(if lineage.garden_match { 1 } else { 0 })
            print(" contract_match=")
            print_int(if lineage.contract_match { 1 } else { 0 })
            print(" parent_transcript_match=")
            print_int(if lineage.parent_transcript_match { 1 } else { 0 })
            print(" semantic_work_started=0\n")
        }
        return mbc_failure_summary(PIREUS_MBC_ERR_LINEAGE)
    }
    let transcript_raw = read_file(paths.parent_transcript)
    let probes = mbc_parse_probe_set(transcript_raw)
    if !probes.complete {
        if emit {
            print("PIREUS_MBC_PARENT probes="); print_int(probes.records)
            print(" canonical_cells="); print_int(probes.cells)
            print(" duplicate_contents="); print_int(probes.duplicate_contents)
            print(" parse_failures="); print_int(probes.failures)
            print(" work_plan_started=0\n")
        }
        return mbc_failure_summary(PIREUS_MBC_ERR_PARENT_PARSE)
    }
    let partition = mbc_partition_result()
    let strategy = mbc_strategy_digest()
    let probe_set = mbc_probe_set_digest(&probes)
    let plan = mbc_plan(&probes, &strategy)
    let structural_negative = mbc_negative_surface()
    let request_negative = mbc_request_negative_surface()
    let negative_passed = structural_negative[0] + request_negative[0]
    let negative_total = structural_negative[1] + request_negative[1]
    var error = PIREUS_MBC_OK
    if error == PIREUS_MBC_OK && !partition.complete {
        error = PIREUS_MBC_ERR_PARTITION
    }
    if error == PIREUS_MBC_OK &&
        (plan.domains != PIREUS_MBC_LOGICAL_JOBS ||
         plan.addresses != PIREUS_MBC_LOGICAL_JOBS ||
         plan.domain_failures != 0 ||
         plan.replay_checks != PIREUS_MBC_LOGICAL_JOBS ||
         plan.replay_failures != 0) {
        error = PIREUS_MBC_ERR_IDENTITY
    }
    if error == PIREUS_MBC_OK && negative_passed != negative_total {
        error = PIREUS_MBC_ERR_NEGATIVE
    }
    let valid = error == PIREUS_MBC_OK
    if emit {
        print("PIREUS_MBC_LINEAGE garden_match=")
        print_int(if lineage.garden_match { 1 } else { 0 })
        print(" contract_match=")
        print_int(if lineage.contract_match { 1 } else { 0 })
        print(" parent_transcript_match=")
        print_int(if lineage.parent_transcript_match { 1 } else { 0 })
        print("\n")
        print("PIREUS_MBC_PARENT probes="); print_int(probes.records)
        print(" canonical_cells="); print_int(probes.cells)
        print(" duplicate_contents="); print_int(probes.duplicate_contents)
        print(" parse_failures="); print_int(probes.failures)
        print("\n")
        print("PIREUS_MBC_PARTITION blocks="); print_int(partition.blocks)
        print(" views="); print_int(partition.views)
        print(" failures="); print_int(partition.failures)
        print(" first_start=0 first_end=630")
        print(" last_start=39690 last_end=40320\n")
        print("PIREUS_MBC_PLAN work_domains="); print_int(plan.domains)
        print(" work_addresses="); print_int(plan.addresses)
        print(" domain_failures="); print_int(plan.domain_failures)
        print(" replay_checks="); print_int(plan.replay_checks)
        print(" replay_failures="); print_int(plan.replay_failures)
        print(" completed_blocks=0 reuse_hits=0 expected_results=0\n")
        print("PIREUS_MBC_NEGATIVES passed="); print_int(negative_passed)
        print(" total="); print_int(negative_total); print("\n")
        print("PIREUS_MBC_DIGEST strategy="); mbc_emit_digest(&strategy)
        print(" probe_set="); mbc_emit_digest(&probe_set)
        print(" partition="); mbc_emit_digest(&partition.digest)
        print(" plan="); mbc_emit_digest(&plan.digest)
        print(" first_address="); mbc_emit_digest(&plan.first_address)
        print(" last_address="); mbc_emit_digest(&plan.last_address); print("\n")
        print("PIREUS_MBC_BOUNDARY actual_blocks=0 reused=0 certified=0")
        print(" purity_proved=0 material_bound_profile=0")
        print(" collision_free=0 formal_parity=0")
        print(" effect_parity=0 material_parity=0 denotational_parity=0")
        print(" performance=0 speedup=0 cache_hit_rate=0")
        print(" algorithmic=0 material_novelty=0 scientific=0 global=0")
        print(" historical=0 priority=0 claim_ready=0\n")
        print("PIREUS_MBC_RESULT valid=")
        print_int(if valid { 1 } else { 0 })
        print(" error="); print_int(error); print("\n")
    }
    PireusMbcSummary {
        valid: valid,
        error: error,
        garden_match: lineage.garden_match,
        contract_match: lineage.contract_match,
        parent_transcript_match: lineage.parent_transcript_match,
        parent_records: probes.records,
        parent_canonical_cells: probes.cells,
        parent_duplicate_contents: probes.duplicate_contents,
        parent_parse_failures: probes.failures,
        partition_blocks: partition.blocks,
        partition_views: partition.views,
        partition_failures: partition.failures,
        work_domains: plan.domains,
        work_addresses: plan.addresses,
        domain_validation_failures: plan.domain_failures,
        address_replay_checks: plan.replay_checks,
        address_replay_failures: plan.replay_failures,
        negative_cases_passed: negative_passed,
        negative_cases_total: negative_total,
        strategy_digest: strategy,
        probe_set_digest: probe_set,
        partition_digest: partition.digest,
        plan_digest: plan.digest,
        first_work_address: plan.first_address,
        last_work_address: plan.last_address,
        completed_blocks: 0,
        reuse_hits: 0,
        expected_result_digests: 0,
        actual_block_execution_complete: false,
        any_block_reused: false,
        all_v13_probes_certified: false,
        deterministic_purity_formally_proved: false,
        material_bound_profile_instantiated: false,
        collision_free_semantic_identity: false,
        formal_parity_open: false,
        effect_parity_open: false,
        material_parity_open: false,
        denotational_parity_open: false,
        performance_measured: false,
        speedup_admitted: false,
        cache_hit_rate_admitted: false,
        algorithmic_novelty: false,
        material_novelty: false,
        scientific_novelty: false,
        global_novelty: false,
        historical_novelty: false,
        priority_claim: false,
        claim_ready: false,
    }
}
