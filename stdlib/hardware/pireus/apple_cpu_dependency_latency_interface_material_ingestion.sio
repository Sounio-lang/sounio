fn paim_sealed_summary_valid(raw: string) -> bool with Mut, Panic, Div {
    let expected: [i64; 8] = [
        0x42701c31, 0x9b81b337, 0x2098b53a, 0x8bb100e2,
        0x9c40a85f, 0x24be611e, 0xb9896d16, 0x75dc0913
    ]
    paim_sha256_matches(raw, &expected) &&
        paim_material_summary_valid(raw) &&
        paim_has_one(raw, "candidate_0_image_loaded=true") &&
        paim_has_one(raw, "candidate_0_symbols_complete=false") &&
        paim_has_one(raw, "candidate_0_accepted_samples=0") &&
        paim_has_one(raw,
            "candidate_1_counter_domain=THREAD_PERF_LEVEL_AGGREGATE") &&
        paim_has_one(raw, "candidate_1_read_successes=1001") &&
        paim_has_one(raw, "candidate_1_migration_observable=false") &&
        paim_has_one(raw, "candidate_2_trace_executed=false") &&
        paim_has_one(raw, "candidate_2_event_configuration=ABSENT") &&
        paim_has_one(raw, "candidate_3_native_unit=TIMER_TICK") &&
        paim_has_one(raw, "candidate_4_native_unit=NANOSECOND") &&
        paim_has_one(raw, "candidate_5_frequency_available=false") &&
        paim_has_one(raw, "candidate_5_frequency_errno=2")
}

fn paim_sealed_samples_valid(raw: string) -> bool with Mut, Panic, Div {
    let expected: [i64; 8] = [
        0x8fe07f2b, 0x44174af6, 0x4ba8014b, 0x151a86c8,
        0xa37589e3, 0x5b7753a5, 0xb037cb75, 0xe5cae582
    ]
    paim_sha256_matches(raw, &expected)
}

fn paim_requirement() -> PireusMeasurementInterfaceRequirement {
    PireusMeasurementInterfaceRequirement {
        request: PireusAppleCpuLatencyRequestRef {
            request_id: PIREUS_APPLE_CPU_LATENCY_REQUEST_ID,
            target_id: PIREUS_TARGET_APPLE_SILICON,
            machine_id: PIREUS_MACHINE_APPLE_MAC17_7,
            engine_id: PIREUS_ENGINE_CPU_APPLE_M5_MAX,
            engine_kind: PIREUS_ENGINE_KIND_CPU,
            isa_id: PIREUS_ENGINE_ISA_AARCH64,
            subject_kind: PIREUS_COST_SUBJECT_LOWERING_NODE,
            subject_node: 0,
            quantity: PIREUS_COST_DEPENDENCY_LATENCY,
            unit: PIREUS_COST_UNIT_CYCLE,
            scope: PIREUS_COST_SCOPE_DEPENDENCY_CHAIN,
            statistic: PIREUS_COST_STAT_MEDIAN,
            requested_samples: 1001,
            requested_warmups: 128,
            required_environment_mask: 2047,
        },
        required_native_unit: PIREUS_COST_UNIT_CYCLE,
        required_counter_domain:
            PIREUS_INTERFACE_COUNTER_DOMAIN_EXECUTING_CPU_CORE,
        required_read_boundary:
            PIREUS_INTERFACE_READ_SERIALIZED_BEFORE_AFTER,
        required_multiplexing: PIREUS_INTERFACE_MULTIPLEXING_DISALLOWED,
        required_core_binding:
            PIREUS_INTERFACE_CORE_MIGRATION_DETECTED_REJECTED,
        required_counter_width_evidenced: true,
        required_wrap_rule_evidenced: true,
        required_privilege_evidenced: true,
        required_event_semantics_evidenced: true,
        required_binary_hash_bound: true,
        required_command_hash_bound: true,
        required_environment_supplement: true,
    }
}

fn paim_candidate_base(
    requirement: &PireusMeasurementInterfaceRequirement,
    candidate_id: i64, family: i64,
) -> PireusMeasurementInterfaceCandidate {
    PireusMeasurementInterfaceCandidate {
        candidate_id: candidate_id,
        request_id: requirement.request.request_id,
        target_id: requirement.request.target_id,
        machine_id: requirement.request.machine_id,
        engine_id: requirement.request.engine_id,
        subject_kind: requirement.request.subject_kind,
        subject_node: requirement.request.subject_node,
        quantity: requirement.request.quantity,
        scope: requirement.request.scope,
        family: family,
        concrete_interface_id: candidate_id + 100,
        access_path: candidate_id + 200,
        counter_source: PIREUS_INTERFACE_OPTION_ABSENT,
        native_unit: PIREUS_INTERFACE_OPTION_ABSENT,
        counter_domain: PIREUS_INTERFACE_OPTION_ABSENT,
        event_identity: PIREUS_INTERFACE_OPTION_ABSENT,
        event_semantics_evidence: PIREUS_INTERFACE_EVIDENCE_ABSENT,
        read_privilege: PIREUS_INTERFACE_PRIVILEGE_UNKNOWN,
        availability_state: PIREUS_INTERFACE_AVAILABILITY_UNKNOWN,
        read_serialization_contract: PIREUS_INTERFACE_OPTION_ABSENT,
        core_binding_contract: PIREUS_INTERFACE_CORE_BINDING_UNKNOWN,
        migration_observable: false,
        migration_evidence: PIREUS_INTERFACE_MIGRATION_ABSENT,
        multiplexing_state: PIREUS_INTERFACE_MULTIPLEXING_UNKNOWN,
        counter_width_bits: 0,
        wrap_rule: PIREUS_INTERFACE_OPTION_ABSENT,
        read_overhead_contract: PIREUS_INTERFACE_OPTION_ABSENT,
        toolchain_identity: 719801,
        binary_identity: 719802,
        command_identity: 719803,
        material_receipt_ref: 719804,
        material_evidence_ref: 719805,
        producer_language: PIREUS_COST_LANGUAGE_CPP,
        producer_role: PIREUS_COST_ROLE_MATERIAL_PARITY,
        evidence_origin_count: 1,
        transport_locator_ref: 0,
        refusal_reason: PIREUS_INTERFACE_REFUSAL_NONE,
        refusal_predicate: PIREUS_INTERFACE_PREDICATE_NONE,
    }
}

fn paim_unavailable_candidate(
    requirement: &PireusMeasurementInterfaceRequirement,
    candidate_id: i64, family: i64,
) -> PireusMeasurementInterfaceCandidate with Mut {
    var candidate = paim_candidate_base(requirement, candidate_id, family)
    candidate.read_privilege = PIREUS_INTERFACE_OPTION_ABSENT
    candidate.availability_state = PIREUS_INTERFACE_AVAILABILITY_UNAVAILABLE
    candidate.core_binding_contract = PIREUS_INTERFACE_OPTION_ABSENT
    candidate.multiplexing_state = PIREUS_INTERFACE_OPTION_ABSENT
    candidate.refusal_reason = PIREUS_INTERFACE_REFUSAL_UNAVAILABLE
    candidate.refusal_predicate = PIREUS_INTERFACE_PREDICATE_AVAILABILITY
    candidate
}

fn paim_cycle_ineligible_candidate(
    requirement: &PireusMeasurementInterfaceRequirement,
    candidate_id: i64, family: i64, native_unit: i64,
    counter_domain: i64, failed_predicate: i64,
) -> PireusMeasurementInterfaceCandidate with Mut {
    var candidate = paim_candidate_base(requirement, candidate_id, family)
    candidate.counter_source = candidate_id + 300
    candidate.native_unit = native_unit
    candidate.counter_domain = counter_domain
    candidate.event_identity = candidate_id + 400
    candidate.event_semantics_evidence =
        PIREUS_INTERFACE_EVIDENCE_ON_DEVICE_CONFIGURATION
    candidate.read_privilege = PIREUS_INTERFACE_PRIVILEGE_USER_EVIDENCED
    candidate.availability_state = PIREUS_INTERFACE_AVAILABILITY_AVAILABLE
    candidate.read_serialization_contract =
        PIREUS_INTERFACE_READ_UNSERIALIZED
    candidate.core_binding_contract = PIREUS_INTERFACE_CORE_BINDING_UNKNOWN
    candidate.migration_observable = false
    candidate.migration_evidence = PIREUS_INTERFACE_MIGRATION_INCAPABLE
    candidate.multiplexing_state = PIREUS_INTERFACE_MULTIPLEXING_DISALLOWED
    candidate.counter_width_bits = 64
    candidate.wrap_rule = PIREUS_INTERFACE_WRAP_MODULO_WIDTH
    candidate.refusal_reason = PIREUS_INTERFACE_REFUSAL_CYCLE_INELIGIBLE
    candidate.refusal_predicate = failed_predicate
    candidate
}

fn paim_observation(
    candidate: PireusMeasurementInterfaceCandidate,
) -> PireusMaterialInterfaceObservation {
    PireusMaterialInterfaceObservation {
        present: true,
        candidate: candidate,
        sounio_source_ref: 719810,
        sounio_semantics_ref: 719811,
        candidate_manifest_ref: 719812,
        hardware_identity_ref: 719813,
        host_key_identity_ref: 719814,
        environment_record_ref: 719815,
        raw_result_ref: 719816,
    }
}

fn paim_material_observations(
    requirement: &PireusMeasurementInterfaceRequirement,
) -> PireusMaterialInterfaceObservationSet with Mut {
    let kpc = paim_unavailable_candidate(requirement, 719900,
        PIREUS_INTERFACE_FAMILY_CORE_CYCLE_COUNTER)
    let process = paim_cycle_ineligible_candidate(
        requirement, 719901,
        PIREUS_INTERFACE_FAMILY_PROCESS_PMU_CYCLE_EVENT,
        PIREUS_COST_UNIT_CYCLE, PIREUS_INTERFACE_COUNTER_DOMAIN_PROCESS,
        PIREUS_INTERFACE_PREDICATE_COUNTER_DOMAIN)
    let trace = paim_candidate_base(requirement, 719902,
        PIREUS_INTERFACE_FAMILY_SYSTEM_TRACE_CYCLE_EVENT)
    let timer = paim_cycle_ineligible_candidate(
        requirement, 719903,
        PIREUS_INTERFACE_FAMILY_ARCHITECTURAL_TIMER_TICK,
        PIREUS_INTERFACE_UNIT_TIMER_TICK,
        PIREUS_INTERFACE_COUNTER_DOMAIN_ARCHITECTURAL_TIMER,
        PIREUS_INTERFACE_PREDICATE_NATIVE_UNIT)
    let monotonic = paim_cycle_ineligible_candidate(
        requirement, 719904, PIREUS_INTERFACE_FAMILY_OS_MONOTONIC_TIME,
        PIREUS_COST_UNIT_NANOSECOND, PIREUS_INTERFACE_COUNTER_DOMAIN_OS_TIME,
        PIREUS_INTERFACE_PREDICATE_NATIVE_UNIT)
    let frequency = paim_unavailable_candidate(requirement, 719905,
        PIREUS_INTERFACE_FAMILY_FREQUENCY_DERIVED_ESTIMATE)
    PireusMaterialInterfaceObservationSet {
        evidence_received: true,
        classification_requested: true,
        candidate_manifest_ref: 719812,
        declared_candidate_count: 0,
        manifest_closed: false,
        closure_evidence_ref: 0,
        transport_failure: false,
        o0: paim_observation(kpc),
        o1: paim_observation(process),
        o2: paim_observation(trace),
        o3: paim_observation(timer),
        o4: paim_observation(monotonic),
        o5: paim_observation(frequency),
    }
}

pub fn pireus_apple_material_ingest_text(
    raw: string,
) -> PireusAppleMaterialIngestionResult with Mut, Panic {
    if paim_transport_failure_valid(raw) {
        return PireusAppleMaterialIngestionResult {
            valid: true,
            status: PIREUS_APPLE_MATERIAL_INGEST_TRANSPORT_FAILURE,
            transport_failure: true,
            material_facts_present: false,
            parity_receipt_valid: false,
            material_observation_ready: false,
            classification_requested: false,
            classification_allowed: false,
            semantic_verdict_emitted_by_child: false,
            cost_present: false,
            claim_ready: false,
            authority_verdict: PIREUS_INTERFACE_VERDICT_UNASSESSED,
            candidate_count: 0,
            complete_terminal_count: 0,
            feasible_count: 0,
            refusal_count: 0,
            cycle_ineligible_count: 0,
            feasible_candidate_id: 0,
            manifest_closed: false,
        }
    }
    if paim_material_summary_valid(raw) {
        return PireusAppleMaterialIngestionResult {
            valid: true,
            status: PIREUS_APPLE_MATERIAL_INGEST_FACTS_UNSEALED,
            transport_failure: false,
            material_facts_present: true,
            parity_receipt_valid: false,
            material_observation_ready: false,
            classification_requested: false,
            classification_allowed: false,
            semantic_verdict_emitted_by_child: false,
            cost_present: false,
            claim_ready: false,
            authority_verdict: PIREUS_INTERFACE_VERDICT_UNASSESSED,
            candidate_count: 0,
            complete_terminal_count: 0,
            feasible_count: 0,
            refusal_count: 0,
            cycle_ineligible_count: 0,
            feasible_candidate_id: 0,
            manifest_closed: false,
        }
    }
    paim_invalid()
}

pub fn pireus_apple_material_ingest_sealed_text(
    receipt: string, summary: string, samples: string,
) -> PireusAppleMaterialIngestionResult with Mut, Panic, Div {
    if !paim_sealed_receipt_valid(receipt) ||
        !paim_sealed_summary_valid(summary) ||
        !paim_sealed_samples_valid(samples) {
        return paim_invalid()
    }
    let requirement = paim_requirement()
    if !pireus_apple_interface_requirement_valid(&requirement, true) {
        return paim_invalid()
    }
    let observations = paim_material_observations(&requirement)
    if !pireus_apple_interface_observation_set_valid(&observations) {
        return paim_invalid()
    }
    let decision = pireus_apple_interface_classify(
        &observations, &requirement)
    PireusAppleMaterialIngestionResult {
        valid: true,
        status: PIREUS_APPLE_MATERIAL_INGEST_SEALED_CLASSIFIED,
        transport_failure: false,
        material_facts_present: true,
        parity_receipt_valid: true,
        material_observation_ready: true,
        classification_requested: true,
        classification_allowed: true,
        semantic_verdict_emitted_by_child: false,
        cost_present: false,
        claim_ready: false,
        authority_verdict: decision.verdict,
        candidate_count: decision.candidate_count,
        complete_terminal_count: decision.complete_terminal_count,
        feasible_count: decision.feasible_count,
        refusal_count: decision.refusal_count,
        cycle_ineligible_count: decision.cycle_ineligible_count,
        feasible_candidate_id: decision.feasible_candidate_id,
        manifest_closed: decision.manifest_closed,
    }
}

pub fn pireus_apple_material_ingest_file(
    path: string,
) -> PireusAppleMaterialIngestionResult
with IO, Mut, Panic, Div, Alloc {
    let size = file_size(path)
    if size <= 0 || size >= 1048576 { return paim_invalid() }
    pireus_apple_material_ingest_text(read_file(path))
}

pub fn pireus_apple_material_ingest_sealed_files(
    receipt_path: string, summary_path: string, samples_path: string,
) -> PireusAppleMaterialIngestionResult
with IO, Mut, Panic, Div, Alloc {
    let receipt_size = file_size(receipt_path)
    let summary_size = file_size(summary_path)
    let samples_size = file_size(samples_path)
    if receipt_size <= 0 || receipt_size >= 1048576 ||
        summary_size <= 0 || summary_size >= 1048576 ||
        samples_size <= 0 || samples_size >= 1048576 {
        return paim_invalid()
    }
    pireus_apple_material_ingest_sealed_text(
        read_file(receipt_path), read_file(summary_path),
        read_file(samples_path))
}

pub fn pireus_apple_material_ingestion_classification_allowed(
    result: &PireusAppleMaterialIngestionResult,
) -> bool {
    result.valid && result.classification_allowed &&
        result.parity_receipt_valid &&
        result.material_observation_ready && result.classification_requested &&
        !result.semantic_verdict_emitted_by_child && !result.cost_present
}

pub fn pireus_apple_material_ingestion_sealed_matches_frozen_classifier(
    result: &PireusAppleMaterialIngestionResult,
) -> bool {
    result.valid &&
        result.status == PIREUS_APPLE_MATERIAL_INGEST_SEALED_CLASSIFIED &&
        !result.transport_failure && result.material_facts_present &&
        result.parity_receipt_valid && result.material_observation_ready &&
        result.classification_requested && result.classification_allowed &&
        !result.semantic_verdict_emitted_by_child && !result.cost_present &&
        !result.claim_ready &&
        result.authority_verdict == PIREUS_INTERFACE_VERDICT_INDETERMINATE &&
        result.candidate_count == 6 &&
        result.complete_terminal_count == 5 &&
        result.feasible_count == 0 && result.refusal_count == 2 &&
        result.cycle_ineligible_count == 3 &&
        result.feasible_candidate_id == 0 && !result.manifest_closed &&
        pireus_apple_material_ingestion_classification_allowed(result)
}

pub fn pireus_apple_material_ingestion_transport_matches_frozen_semantics(
    result: &PireusAppleMaterialIngestionResult,
) -> bool {
    result.valid &&
        result.status == PIREUS_APPLE_MATERIAL_INGEST_TRANSPORT_FAILURE &&
        result.transport_failure && !result.material_facts_present &&
        !result.parity_receipt_valid && !result.material_observation_ready &&
        !result.classification_requested && !result.classification_allowed &&
        !result.semantic_verdict_emitted_by_child && !result.cost_present &&
        !result.claim_ready &&
        result.authority_verdict == PIREUS_INTERFACE_VERDICT_UNASSESSED &&
        !pireus_apple_material_ingestion_classification_allowed(result)
}
