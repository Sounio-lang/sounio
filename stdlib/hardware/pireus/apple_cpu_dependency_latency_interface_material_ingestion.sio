    PIREUS_INTERFACE_MIGRATION_INCAPABLE,
    PIREUS_INTERFACE_MIGRATION_ABSENT,
    PIREUS_INTERFACE_EVIDENCE_ON_DEVICE_CONFIGURATION,
    PIREUS_INTERFACE_EVIDENCE_ABSENT,
    PIREUS_INTERFACE_PRIVILEGE_USER_EVIDENCED,
    PIREUS_INTERFACE_PRIVILEGE_UNKNOWN,
    PIREUS_INTERFACE_AVAILABILITY_AVAILABLE,
    PIREUS_INTERFACE_AVAILABILITY_UNAVAILABLE,
    PIREUS_INTERFACE_AVAILABILITY_UNKNOWN,
    PIREUS_INTERFACE_WRAP_MODULO_WIDTH,
    PIREUS_INTERFACE_OPTION_ABSENT,
    PIREUS_INTERFACE_REFUSAL_NONE,
    PIREUS_INTERFACE_REFUSAL_CYCLE_INELIGIBLE,
    PIREUS_INTERFACE_REFUSAL_UNAVAILABLE,
    PIREUS_INTERFACE_PREDICATE_NONE,
    PIREUS_INTERFACE_PREDICATE_NATIVE_UNIT,
