//! Sounio-first admission semantics for the founder-declared dual U250 fleet.
//!
//! This module defines the expected result before any material observation is
//! admitted. C++ may provide MATERIAL_PARITY only after these semantics freeze.

pub const PIREUS_U250_SCHEMA: i64 = 711000
pub const PIREUS_TARGET_AMD_ALVEO_U250: i64 = 711001
pub const PIREUS_ENGINE_KIND_FPGA: i64 = 711002
pub const PIREUS_FABRIC_XCU250: i64 = 711003
pub const PIREUS_INTERFACE_XRT_XDMA: i64 = 711004
pub const PIREUS_MACHINE_DL380: i64 = 711005

pub const PIREUS_U250_SLOT_0: i64 = 0
pub const PIREUS_U250_SLOT_1: i64 = 1
pub const PIREUS_U250_REQUIRED_CARD_COUNT: i64 = 2
pub const PIREUS_U250_REQUIRED_DDR_BANK_COUNT: i64 = 4
pub const PIREUS_U250_REQUIRED_DDR_BYTES: i64 = 68719476736
pub const PIREUS_U250_PCI_MANAGEMENT: i64 = 0x10ee5004
pub const PIREUS_U250_PCI_USER: i64 = 0x10ee5005

pub const PIREUS_U250_LANGUAGE_NONE: i64 = 0
pub const PIREUS_U250_LANGUAGE_SOUNIO: i64 = 1
pub const PIREUS_U250_LANGUAGE_CPP: i64 = 4
pub const PIREUS_U250_LANGUAGE_EXTERNAL_LLM: i64 = 6
pub const PIREUS_U250_LANGUAGE_PYTHON: i64 = 7
pub const PIREUS_U250_LANGUAGE_RUST: i64 = 8

pub const PIREUS_U250_ROLE_NONE: i64 = 0
pub const PIREUS_U250_ROLE_SEMANTIC_AUTHORITY: i64 = 1
pub const PIREUS_U250_ROLE_MATERIAL_PARITY: i64 = 4
pub const PIREUS_U250_ROLE_REVIEW_ONLY: i64 = 6

pub const PIREUS_U250_STATUS_DECLARATION_INVALID: i64 = 711090
pub const PIREUS_U250_STATUS_INVENTORY_OPEN: i64 = 711091
pub const PIREUS_U250_STATUS_INVENTORY_PARTIAL: i64 = 711092
pub const PIREUS_U250_STATUS_INVENTORY_COMPLETE: i64 = 711093
pub const PIREUS_U250_STATUS_IDENTITY_CONFLICT: i64 = 711094
pub const PIREUS_U250_STATUS_PRE_FREEZE_REFUSED: i64 = 711095
pub const PIREUS_U250_STATUS_FORBIDDEN_PRODUCER: i64 = 711096
pub const PIREUS_U250_STATUS_AUTHORITY_REFUSED: i64 = 711097

pub struct PireusU250Declaration {
    pub schema: i64,
    pub target_family: i64,
    pub engine_kind: i64,
    pub fabric: i64,
    pub interface: i64,
    pub machine: i64,
    pub declared_card_count: i64,
    pub material_slot_count: i64,
    pub producer_language: i64,
    pub producer_role: i64,
    pub garden_bound: bool,
    pub sounio_executable: bool,
    pub semantics_frozen: bool,
    pub parity_open_requested: bool,
    pub claim_ready_requested: bool,
}

pub struct PireusU250CardObservation {
    pub slot: i64,
    pub present: bool,
    pub physical_identity: i64,
    pub producer_language: i64,
    pub producer_role: i64,
    pub receipt_valid: bool,
    pub management_pf_count: i64,
    pub user_pf_count: i64,
    pub management_pci_identity: i64,
    pub user_pci_identity: i64,
    pub xrt_identified: bool,
    pub shell_ready: bool,
    pub ddr_bank_count: i64,
    pub ddr_bytes: i64,
}

pub struct PireusU250AdmissionResult {
    pub valid: bool,
    pub status: i64,
    pub schema: i64,
    pub target_family: i64,
    pub engine_kind: i64,
    pub fabric: i64,
    pub interface: i64,
    pub machine: i64,
    pub semantic_authority_language: i64,
    pub declared_card_count: i64,
    pub material_slot_count: i64,
    pub discovered_card_count: i64,
    pub admitted_card_count: i64,
    pub rejected_card_count: i64,
    pub missing_card_count: i64,
    pub declaration_valid: bool,
    pub slot_layout_valid: bool,
    pub duplicate_identity: bool,
    pub material_before_freeze: bool,
    pub forbidden_producer: bool,
    pub authority_promotion: bool,
    pub unsealed_observation_count: i64,
    pub malformed_observation_count: i64,
    pub inventory_complete: bool,
    pub material_parity_ready: bool,
    pub cost_present: bool,
    pub speedup_present: bool,
    pub kernel_correctness_present: bool,
    pub parity_open: bool,
    pub claim_ready: bool,
    pub failures: i64,
}

pub fn pireus_u250_canonical_declaration() -> PireusU250Declaration {
    PireusU250Declaration {
        schema: PIREUS_U250_SCHEMA,
        target_family: PIREUS_TARGET_AMD_ALVEO_U250,
        engine_kind: PIREUS_ENGINE_KIND_FPGA,
        fabric: PIREUS_FABRIC_XCU250,
        interface: PIREUS_INTERFACE_XRT_XDMA,
        machine: PIREUS_MACHINE_DL380,
        declared_card_count: PIREUS_U250_REQUIRED_CARD_COUNT,
        material_slot_count: PIREUS_U250_REQUIRED_CARD_COUNT,
        producer_language: PIREUS_U250_LANGUAGE_SOUNIO,
        producer_role: PIREUS_U250_ROLE_SEMANTIC_AUTHORITY,
        garden_bound: true,
        sounio_executable: true,
        semantics_frozen: false,
        parity_open_requested: false,
        claim_ready_requested: false,
    }
}

pub fn pireus_u250_empty_observation(slot: i64) -> PireusU250CardObservation {
    PireusU250CardObservation {
        slot: slot,
        present: false,
        physical_identity: 0,
        producer_language: PIREUS_U250_LANGUAGE_NONE,
        producer_role: PIREUS_U250_ROLE_NONE,
        receipt_valid: false,
        management_pf_count: 0,
        user_pf_count: 0,
        management_pci_identity: 0,
        user_pci_identity: 0,
        xrt_identified: false,
        shell_ready: false,
        ddr_bank_count: 0,
        ddr_bytes: 0,
    }
}

pub fn pireus_u250_reference_material_observation(
    slot: i64,
    physical_identity: i64,
) -> PireusU250CardObservation {
    PireusU250CardObservation {
        slot: slot,
        present: true,
        physical_identity: physical_identity,
        producer_language: PIREUS_U250_LANGUAGE_CPP,
        producer_role: PIREUS_U250_ROLE_MATERIAL_PARITY,
        receipt_valid: true,
        management_pf_count: 1,
        user_pf_count: 1,
        management_pci_identity: PIREUS_U250_PCI_MANAGEMENT,
        user_pci_identity: PIREUS_U250_PCI_USER,
        xrt_identified: true,
        shell_ready: true,
        ddr_bank_count: PIREUS_U250_REQUIRED_DDR_BANK_COUNT,
        ddr_bytes: PIREUS_U250_REQUIRED_DDR_BYTES,
    }
}

fn u250_declaration_valid(declaration: &PireusU250Declaration) -> bool {
    declaration.schema == PIREUS_U250_SCHEMA &&
        declaration.target_family == PIREUS_TARGET_AMD_ALVEO_U250 &&
        declaration.engine_kind == PIREUS_ENGINE_KIND_FPGA &&
        declaration.fabric == PIREUS_FABRIC_XCU250 &&
        declaration.interface == PIREUS_INTERFACE_XRT_XDMA &&
        declaration.machine == PIREUS_MACHINE_DL380 &&
        declaration.declared_card_count == PIREUS_U250_REQUIRED_CARD_COUNT &&
        declaration.material_slot_count == PIREUS_U250_REQUIRED_CARD_COUNT &&
        declaration.producer_language == PIREUS_U250_LANGUAGE_SOUNIO &&
        declaration.producer_role == PIREUS_U250_ROLE_SEMANTIC_AUTHORITY &&
        declaration.garden_bound && declaration.sounio_executable
}

fn u250_slot_layout_valid(
    slot_0: &PireusU250CardObservation,
    slot_1: &PireusU250CardObservation,
) -> bool {
    slot_0.slot == PIREUS_U250_SLOT_0 &&
        slot_1.slot == PIREUS_U250_SLOT_1
}

fn u250_forbidden_producer(observation: &PireusU250CardObservation) -> bool {
    observation.present &&
        (observation.producer_language == PIREUS_U250_LANGUAGE_PYTHON ||
         observation.producer_language == PIREUS_U250_LANGUAGE_RUST)
}

fn u250_authority_promotion(observation: &PireusU250CardObservation) -> bool {
    if !observation.present { return false }
    if observation.producer_language == PIREUS_U250_LANGUAGE_CPP &&
        observation.producer_role == PIREUS_U250_ROLE_SEMANTIC_AUTHORITY {
        return true
    }
    if observation.producer_language == PIREUS_U250_LANGUAGE_EXTERNAL_LLM &&
        observation.producer_role != PIREUS_U250_ROLE_REVIEW_ONLY {
        return true
    }
    observation.producer_role == PIREUS_U250_ROLE_SEMANTIC_AUTHORITY &&
        observation.producer_language != PIREUS_U250_LANGUAGE_SOUNIO
}

fn u250_material_shape_valid(observation: &PireusU250CardObservation) -> bool {
    observation.present && observation.physical_identity != 0 &&
        observation.management_pf_count == 1 &&
        observation.user_pf_count == 1 &&
        observation.management_pci_identity == PIREUS_U250_PCI_MANAGEMENT &&
        observation.user_pci_identity == PIREUS_U250_PCI_USER &&
        observation.xrt_identified && observation.shell_ready &&
        observation.ddr_bank_count == PIREUS_U250_REQUIRED_DDR_BANK_COUNT &&
        observation.ddr_bytes >= PIREUS_U250_REQUIRED_DDR_BYTES
}

fn u250_material_admitted(
    declaration: &PireusU250Declaration,
    observation: &PireusU250CardObservation,
) -> bool {
    declaration.semantics_frozen && observation.receipt_valid &&
        observation.producer_language == PIREUS_U250_LANGUAGE_CPP &&
        observation.producer_role == PIREUS_U250_ROLE_MATERIAL_PARITY &&
        !u250_forbidden_producer(observation) &&
        !u250_authority_promotion(observation) &&
        u250_material_shape_valid(observation)
}

fn u250_i64(value: bool) -> i64 {
    if value { 1 } else { 0 }
}

pub fn pireus_u250_dual_card_admit(
    declaration: &PireusU250Declaration,
    slot_0: &PireusU250CardObservation,
    slot_1: &PireusU250CardObservation,
) -> PireusU250AdmissionResult
with Mut {
    let declaration_valid = u250_declaration_valid(declaration)
    let slot_layout_valid = u250_slot_layout_valid(slot_0, slot_1)
    let discovered_card_count = u250_i64(slot_0.present) +
        u250_i64(slot_1.present)
    let duplicate_identity = slot_0.present && slot_1.present &&
        slot_0.physical_identity != 0 &&
        slot_0.physical_identity == slot_1.physical_identity
    let forbidden_producer = u250_forbidden_producer(slot_0) ||
        u250_forbidden_producer(slot_1)
    let authority_promotion = u250_authority_promotion(slot_0) ||
        u250_authority_promotion(slot_1)
    let material_before_freeze = !declaration.semantics_frozen &&
        ((slot_0.present && slot_0.receipt_valid) ||
         (slot_1.present && slot_1.receipt_valid))
    let parity_before_freeze = declaration.parity_open_requested &&
        !declaration.semantics_frozen

    let slot_0_shape = u250_material_shape_valid(slot_0)
    let slot_1_shape = u250_material_shape_valid(slot_1)
    let unsealed_observation_count =
        u250_i64(slot_0.present && !slot_0.receipt_valid) +
        u250_i64(slot_1.present && !slot_1.receipt_valid)
    let malformed_observation_count =
        u250_i64(slot_0.present && !slot_0_shape) +
        u250_i64(slot_1.present && !slot_1_shape)

    let slot_0_admitted = u250_material_admitted(declaration, slot_0) &&
        !duplicate_identity
    let slot_1_admitted = u250_material_admitted(declaration, slot_1) &&
        !duplicate_identity
    let admitted_card_count = u250_i64(slot_0_admitted) +
        u250_i64(slot_1_admitted)
    let rejected_card_count = discovered_card_count - admitted_card_count
    let missing_card_count = PIREUS_U250_REQUIRED_CARD_COUNT -
        admitted_card_count
    let inventory_complete = admitted_card_count ==
        PIREUS_U250_REQUIRED_CARD_COUNT && !duplicate_identity
    let material_parity_ready = declaration.semantics_frozen &&
        admitted_card_count > 0
    let parity_open = material_parity_ready &&
        declaration.parity_open_requested

    var failures: i64 = 0
    if !declaration_valid { failures = failures + 1 }
    if !slot_layout_valid { failures = failures + 1 }
    if duplicate_identity { failures = failures + 1 }
    if material_before_freeze { failures = failures + 1 }
    if parity_before_freeze { failures = failures + 1 }
    if forbidden_producer { failures = failures + 1 }
    if authority_promotion { failures = failures + 1 }
    if declaration.claim_ready_requested { failures = failures + 1 }

    var status = PIREUS_U250_STATUS_INVENTORY_OPEN
    if admitted_card_count == 1 {
        status = PIREUS_U250_STATUS_INVENTORY_PARTIAL
    }
    if inventory_complete {
        status = PIREUS_U250_STATUS_INVENTORY_COMPLETE
    }
    if material_before_freeze || parity_before_freeze {
        status = PIREUS_U250_STATUS_PRE_FREEZE_REFUSED
    }
    if authority_promotion {
        status = PIREUS_U250_STATUS_AUTHORITY_REFUSED
    }
    if forbidden_producer {
        status = PIREUS_U250_STATUS_FORBIDDEN_PRODUCER
    }
    if duplicate_identity {
        status = PIREUS_U250_STATUS_IDENTITY_CONFLICT
    }
    if !declaration_valid || !slot_layout_valid {
        status = PIREUS_U250_STATUS_DECLARATION_INVALID
    }

    PireusU250AdmissionResult {
        valid: failures == 0,
        status: status,
        schema: declaration.schema,
        target_family: declaration.target_family,
        engine_kind: declaration.engine_kind,
        fabric: declaration.fabric,
        interface: declaration.interface,
        machine: declaration.machine,
        semantic_authority_language: PIREUS_U250_LANGUAGE_SOUNIO,
        declared_card_count: declaration.declared_card_count,
        material_slot_count: declaration.material_slot_count,
        discovered_card_count: discovered_card_count,
        admitted_card_count: admitted_card_count,
        rejected_card_count: rejected_card_count,
        missing_card_count: missing_card_count,
        declaration_valid: declaration_valid,
        slot_layout_valid: slot_layout_valid,
        duplicate_identity: duplicate_identity,
        material_before_freeze: material_before_freeze || parity_before_freeze,
        forbidden_producer: forbidden_producer,
        authority_promotion: authority_promotion,
        unsealed_observation_count: unsealed_observation_count,
        malformed_observation_count: malformed_observation_count,
        inventory_complete: inventory_complete,
        material_parity_ready: material_parity_ready,
        cost_present: false,
        speedup_present: false,
        kernel_correctness_present: false,
        parity_open: parity_open,
        claim_ready: false,
        failures: failures,
    }
}

pub fn pireus_u250_initial_admission() -> PireusU250AdmissionResult
with Mut {
    let declaration = pireus_u250_canonical_declaration()
    let slot_0 = pireus_u250_empty_observation(PIREUS_U250_SLOT_0)
    let slot_1 = pireus_u250_empty_observation(PIREUS_U250_SLOT_1)
    pireus_u250_dual_card_admit(&declaration, &slot_0, &slot_1)
}

pub fn pireus_u250_initial_matches_expected(
    result: &PireusU250AdmissionResult,
) -> bool {
    result.valid && result.status == PIREUS_U250_STATUS_INVENTORY_OPEN &&
        result.schema == PIREUS_U250_SCHEMA &&
        result.target_family == PIREUS_TARGET_AMD_ALVEO_U250 &&
        result.engine_kind == PIREUS_ENGINE_KIND_FPGA &&
        result.fabric == PIREUS_FABRIC_XCU250 &&
        result.interface == PIREUS_INTERFACE_XRT_XDMA &&
        result.machine == PIREUS_MACHINE_DL380 &&
        result.semantic_authority_language == PIREUS_U250_LANGUAGE_SOUNIO &&
        result.declared_card_count == PIREUS_U250_REQUIRED_CARD_COUNT &&
        result.material_slot_count == PIREUS_U250_REQUIRED_CARD_COUNT &&
        result.discovered_card_count == 0 &&
        result.admitted_card_count == 0 &&
        result.rejected_card_count == 0 &&
        result.missing_card_count == PIREUS_U250_REQUIRED_CARD_COUNT &&
        result.declaration_valid && result.slot_layout_valid &&
        !result.duplicate_identity && !result.material_before_freeze &&
        !result.forbidden_producer && !result.authority_promotion &&
        result.unsealed_observation_count == 0 &&
        result.malformed_observation_count == 0 &&
        !result.inventory_complete && !result.material_parity_ready &&
        !result.cost_present && !result.speedup_present &&
        !result.kernel_correctness_present && !result.parity_open &&
        !result.claim_ready && result.failures == 0
}
