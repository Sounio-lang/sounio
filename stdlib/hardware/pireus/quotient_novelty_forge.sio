fn qnf_words_equal(left: &[i64; 8], right: &[i64; 8]) -> bool
with Mut, Panic {
    var index: i64 = 0
    while index < 8 {
        if left[index] != right[index] { return false }
        index = index + 1
    }
    true
}

fn qnf_parent_digest_matches(
    digest: &PireusCubicForgeDigest,
    expected: &[i64; 8],
) -> bool with Mut, Panic {
    qnf_words_equal(&digest.words, expected)
}

fn qnf_digest_add_i64(state: SHA256State, value: i64) -> SHA256State
with Mut, Panic, Div {
    var bytes: [u8; 256] = [0; 256]
    var index: i64 = 0
    while index < 8 {
        bytes[index] = ((value >> ((7 - index) * 8)) & 255) as u8
        index = index + 1
    }
    sha256_update(state, bytes, 8)
}

fn qnf_digest_add_bool(state: SHA256State, value: bool) -> SHA256State
with Mut, Panic, Div {
    qnf_digest_add_i64(state, if value { 1 } else { 0 })
}

fn qnf_digest_add_words(state: SHA256State, words: &[i64; 8]) -> SHA256State
with Mut, Panic, Div {
    var next = state
    var index: i64 = 0
    while index < 8 {
        next = qnf_digest_add_i64(next, words[index])
        index = index + 1
    }
    next
}

fn qnf_digest_add_digest(
    state: SHA256State,
    digest: &PireusQuotientDigest,
) -> SHA256State with Mut, Panic, Div {
    qnf_digest_add_words(state, &digest.words)
}

fn qnf_digest_finish(state: SHA256State) -> PireusQuotientDigest
with Mut, Panic, Div, Epistemic {
    let digest = sha256_finalize(state)
    var words: [i64; 8] = [0; 8]
    var word: i64 = 0
    while word < 8 {
        var value: i64 = 0
        var byte: i64 = 0
        while byte < 4 {
            value = (value << 8) |
                sha256_digest_byte(&digest, (word * 4 + byte) as i32)
            byte = byte + 1
        }
        words[word] = value
        word = word + 1
    }
    PireusQuotientDigest { words: words }
}

pub fn pireus_quotient_digest_nonzero(
    digest: &PireusQuotientDigest,
) -> bool with Mut {
    var index: i64 = 0
    while index < 8 {
        if digest.words[index] != 0 { return true }
        index = index + 1
    }
    false
}

pub fn pireus_quotient_novelty_request() -> PireusQuotientRequest {
    PireusQuotientRequest {
        producer_language: PIREUS_QUOTIENT_LANGUAGE_SOUNIO,
        producer_role: PIREUS_QUOTIENT_ROLE_SEMANTIC_AUTHORITY,
        stage: PIREUS_QUOTIENT_STAGE_SOUNIO_EXECUTABLE,
        policy_present: true,
        parent_present: true,
        parent_semantics_frozen: true,
        parent_source_bound: true,
        parent_semantics_bound: true,
        parent_freeze_bound: true,
        parent_transcript_bound: true,
        parent_parity_receipt_bound: true,
        declared_child_count: PIREUS_QUOTIENT_CHILD_COUNT,
        declared_matrix_encodings: PIREUS_QUOTIENT_MATRIX_ENCODINGS,
        declared_gl4_count: PIREUS_QUOTIENT_GL4_COUNT,
        declared_action_count: PIREUS_QUOTIENT_ACTION_COUNT,
        declared_gauge_bits: PIREUS_QUOTIENT_GAUGE_BITS,
        declared_profile_count: PIREUS_QUOTIENT_PROFILE_COUNT,
        expected_stabilizer_present: false,
        expected_partition_present: false,
        expected_representative_present: false,
        expected_witness_present: false,
        expected_digest_present: false,
        selection_requested: false,
        ranking_present: false,
        target_observation_count: 0,
        target_discharge_count: 0,
        material_receipt_count: 0,
        lowering_count: 0,
        cost_record_count: 0,
        performance_record_count: 0,
        global_linear_quotient_requested: false,
        nonlinear_quotient_requested: false,
        isotopy_quotient_requested: false,
        algebra_isomorphism_requested: false,
        algebraic_novelty_requested: false,
        algorithmic_novelty_requested: false,
        material_novelty_requested: false,
        scientific_novelty_requested: false,
        global_novelty_requested: false,
        historical_novelty_requested: false,
        priority_requested: false,
        external_review_promoted: false,
        semantics_frozen: false,
        parity_requested: false,
        claim_ready_requested: false,
        waiver_present: false,
        waiver_founder: false,
        waiver_scoped: false,
        waiver_purpose_bound: false,
        waiver_live: false,
    }
}

fn qnf_request_error(request: &PireusQuotientRequest) -> i64
with Mut, Panic {
    if request.producer_language != PIREUS_QUOTIENT_LANGUAGE_SOUNIO ||
        request.producer_role != PIREUS_QUOTIENT_ROLE_SEMANTIC_AUTHORITY {
        return PIREUS_QUOTIENT_ERR_AUTHORITY
    }
    if request.stage != PIREUS_QUOTIENT_STAGE_SOUNIO_EXECUTABLE ||
        request.semantics_frozen || request.parity_requested {
        return PIREUS_QUOTIENT_ERR_STAGE
    }
    if !request.policy_present { return PIREUS_QUOTIENT_ERR_POLICY }
    if !request.parent_present || !request.parent_semantics_frozen ||
        !request.parent_source_bound || !request.parent_semantics_bound ||
        !request.parent_freeze_bound || !request.parent_transcript_bound ||
        !request.parent_parity_receipt_bound {
        return PIREUS_QUOTIENT_ERR_PARENT
    }
    if request.declared_child_count != PIREUS_QUOTIENT_CHILD_COUNT ||
        request.declared_matrix_encodings !=
            PIREUS_QUOTIENT_MATRIX_ENCODINGS ||
        request.declared_gl4_count != PIREUS_QUOTIENT_GL4_COUNT ||
        request.declared_action_count != PIREUS_QUOTIENT_ACTION_COUNT ||
        request.declared_gauge_bits != PIREUS_QUOTIENT_GAUGE_BITS ||
        request.declared_profile_count != PIREUS_QUOTIENT_PROFILE_COUNT {
        return PIREUS_QUOTIENT_ERR_UNIVERSE
    }
    if request.expected_stabilizer_present ||
        request.expected_partition_present ||
        request.expected_representative_present ||
        request.expected_witness_present || request.expected_digest_present {
        return PIREUS_QUOTIENT_ERR_RESULT_INJECTION
    }
    if request.selection_requested || request.ranking_present {
        return PIREUS_QUOTIENT_ERR_SELECTION
    }
    if request.target_observation_count != 0 ||
        request.target_discharge_count != 0 ||
        request.material_receipt_count != 0 || request.lowering_count != 0 ||
        request.cost_record_count != 0 ||
        request.performance_record_count != 0 {
        return PIREUS_QUOTIENT_ERR_MATERIAL
    }
    if request.global_linear_quotient_requested ||
        request.nonlinear_quotient_requested ||
        request.isotopy_quotient_requested ||
        request.algebra_isomorphism_requested ||
        request.algebraic_novelty_requested ||
        request.algorithmic_novelty_requested ||
        request.material_novelty_requested ||
        request.scientific_novelty_requested ||
        request.global_novelty_requested ||
        request.historical_novelty_requested || request.priority_requested ||
        request.external_review_promoted || request.claim_ready_requested {
        return PIREUS_QUOTIENT_ERR_CLAIM
    }
    if request.waiver_present && !(request.waiver_founder &&
        request.waiver_scoped && request.waiver_purpose_bound &&
        request.waiver_live) {
        return PIREUS_QUOTIENT_ERR_WAIVER
    }
    PIREUS_QUOTIENT_OK
}

fn qnf_bit(value: i64, coordinate: i64) -> i64 {
    (value >> coordinate) & 1
}

fn qnf_mutation_bit(
    population: &PireusCubicMutationPopulation,
    mutation: i64,
    left: i64,
    right: i64,
) -> i64 with Panic {
    let kind = population.kinds[mutation]
    let r = population.r_coordinates[mutation]
    let s = population.s_coordinates[mutation]
    let t = population.t_coordinates[mutation]
    if kind == PIREUS_CUBIC_FORGE_KIND_L2R1 {
        return qnf_bit(left, r) * qnf_bit(left, s) * qnf_bit(right, t)
    }
    if kind == PIREUS_CUBIC_FORGE_KIND_L1R2 {
        return qnf_bit(left, r) * qnf_bit(right, s) * qnf_bit(right, t)
    }
    0
}

fn qnf_build_lineage(
    parent: &PireusCubicForgeDigest,
    parent_live_match: bool,
) -> PireusQuotientLineage with Mut, Panic {
    let source = qnf_parent_source_hash()
    let semantics = qnf_parent_semantics_hash()
    let freeze = qnf_parent_freeze_hash()
    let transcript = qnf_parent_transcript_hash()
    let parity = qnf_parent_parity_hash()
    let digest_match = qnf_parent_digest_matches(parent, &semantics)
    PireusQuotientLineage {
        parent_source_sha256: source,
        parent_semantics_sha256: semantics,
        parent_freeze_sha256: freeze,
        parent_transcript_sha256: transcript,
        parent_parity_receipt_sha256: parity,
        parent_live_match: parent_live_match,
        parent_digest_match: digest_match,
        parent_scope_match: parent_live_match && digest_match,
        complete: parent_live_match && digest_match,
    }
}

fn qnf_recover_parent(
    population: &PireusCubicMutationPopulation,
) -> PireusQuotientParentTable with Mut, Panic {
    var cells: [i64; 256] = [0; 256]
    var reconstruction_checks: i64 = 0
    var reconstruction_failures: i64 = 0
    var sign_range_checks: i64 = 0
    var sign_range_failures: i64 = 0
    var mutation: i64 = 0
    while mutation < PIREUS_QUOTIENT_CHILD_COUNT {
        var left: i64 = 0
        while left < PIREUS_QUOTIENT_DIMENSION {
            var right: i64 = 0
            while right < PIREUS_QUOTIENT_DIMENSION {
                let cell = left * PIREUS_QUOTIENT_DIMENSION + right
                let child = population.sign_bits[
                    mutation * PIREUS_QUOTIENT_CELL_COUNT + cell]
                let recovered = child ^
                    qnf_mutation_bit(population, mutation, left, right)
                if mutation == 0 { cells[cell] = recovered }
                reconstruction_checks = reconstruction_checks + 1
                if cells[cell] != recovered {
                    reconstruction_failures = reconstruction_failures + 1
                }
                sign_range_checks = sign_range_checks + 1
                if recovered < 0 || recovered > 1 {
                    sign_range_failures = sign_range_failures + 1
                }
                right = right + 1
            }
            left = left + 1
        }
        mutation = mutation + 1
    }
    PireusQuotientParentTable {
        cells: cells,
        reconstruction_checks: reconstruction_checks,
        reconstruction_failures: reconstruction_failures,
        sign_range_checks: sign_range_checks,
        sign_range_failures: sign_range_failures,
        complete: reconstruction_checks == PIREUS_QUOTIENT_CHILD_COUNT *
                PIREUS_QUOTIENT_CELL_COUNT &&
            reconstruction_failures == 0 && sign_range_failures == 0,
    }
}

fn qnf_parity4(value: i64) -> i64 with Mut {
    var parity: i64 = 0
    var bit: i64 = 0
    while bit < 4 {
        if (value & (1 << bit)) != 0 { parity = parity ^ 1 }
        bit = bit + 1
    }
    parity
}

fn qnf_matrix_row(code: i64, row: i64) -> i64 {
    (code >> (row * 4)) & 15
}

fn qnf_matrix_apply(code: i64, vector: i64) -> i64 with Mut {
    var result: i64 = 0
    var row: i64 = 0
    while row < 4 {
        if qnf_parity4(qnf_matrix_row(code, row) & vector) == 1 {
            result = result | (1 << row)
        }
        row = row + 1
    }
    result
}

fn qnf_matrix_invertible(code: i64) -> bool with Mut, Panic {
    var seen: [bool; 16] = [false; 16]
    var vector: i64 = 0
    while vector < 16 {
        let image = qnf_matrix_apply(code, vector)
        if seen[image] { return false }
        seen[image] = true
        vector = vector + 1
    }
    true
}

fn qnf_matrix_compose(left: i64, right: i64) -> i64 with Mut {
    var code: i64 = 0
    var row: i64 = 0
    while row < 4 {
        let selector = qnf_matrix_row(left, row)
        var composed_row: i64 = 0
        var source_row: i64 = 0
        while source_row < 4 {
            if (selector & (1 << source_row)) != 0 {
                composed_row = composed_row ^
                    qnf_matrix_row(right, source_row)
            }
            source_row = source_row + 1
        }
        code = code | (composed_row << (row * 4))
        row = row + 1
    }
    code
}

fn qnf_matrix_inverse(code: i64) -> i64 with Mut {
    var inverse: i64 = 0
    var column: i64 = 0
    while column < 4 {
        let target = 1 << column
        var preimage: i64 = 0
        while preimage < 16 && qnf_matrix_apply(code, preimage) != target {
            preimage = preimage + 1
        }
        var row: i64 = 0
        while row < 4 {
            if (preimage & (1 << row)) != 0 {
                inverse = inverse | (1 << (row * 4 + column))
            }
            row = row + 1
        }
        column = column + 1
    }
    inverse
}

fn qnf_is_basis(value: i64) -> bool {
    value == 1 || value == 2 || value == 4 || value == 8
}

fn qnf_highest_basis(value: i64) -> i64 with Mut {
    var bit: i64 = 3
    while bit > 0 {
        if (value & (1 << bit)) != 0 { return 1 << bit }
        bit = bit - 1
    }
    1
}

fn qnf_gauge_index(vector: i64) -> i64 with Mut {
    var index: i64 = 0
    var value: i64 = 1
    while value < vector {
        if !qnf_is_basis(value) { index = index + 1 }
        value = value + 1
    }
    index
}

fn qnf_gauge_value(word: i64, vector: i64) -> i64 with Mut {
    if vector == 0 || qnf_is_basis(vector) { return 0 }
    (word >> qnf_gauge_index(vector)) & 1
}

fn qnf_coboundary(word: i64, left: i64, right: i64) -> i64 with Mut {
    qnf_gauge_value(word, left) ^ qnf_gauge_value(word, right) ^
        qnf_gauge_value(word, left ^ right)
}

fn qnf_pullback_gauge_word(word: i64, matrix: i64) -> i64 with Mut {
    var pulled: i64 = 0
    var vector: i64 = 1
    while vector < PIREUS_QUOTIENT_DIMENSION {
        if !qnf_is_basis(vector) {
            var value = qnf_gauge_value(
                word, qnf_matrix_apply(matrix, vector))
            var coordinate: i64 = 0
            while coordinate < PIREUS_QUOTIENT_BITS {
                if (vector & (1 << coordinate)) != 0 {
                    value = value ^ qnf_gauge_value(
                        word, qnf_matrix_apply(matrix, 1 << coordinate))
                }
                coordinate = coordinate + 1
            }
            if value != 0 {
                pulled = pulled | (1 << qnf_gauge_index(vector))
            }
        }
        vector = vector + 1
    }
    pulled
}

fn qnf_words_zero(words: &[i64; 8]) -> bool with Mut, Panic {
    var word: i64 = 0
    while word < PIREUS_QUOTIENT_TABLE_WORDS {
        if words[word] != 0 { return false }
        word = word + 1
    }
    true
}

fn qnf_normalize(table: &[i64; 256]) -> QnfNormalization
with Mut, Panic, Div {
    var q: [i64; 16] = [0; 16]
    var gauge_word: i64 = 0
    var vector: i64 = 1
    while vector < PIREUS_QUOTIENT_DIMENSION {
        if !qnf_is_basis(vector) {
            let edge = qnf_highest_basis(vector)
            let parent = vector ^ edge
            q[vector] = table[parent * 16 + edge] ^ q[parent]
            if q[vector] != 0 {
                gauge_word = gauge_word |
                    (1 << qnf_gauge_index(vector))
            }
        }
        vector = vector + 1
    }

    var words: [i64; 8] = [0; 8]
    var nonzero: i64 = 0
    var left: i64 = 0
    while left < PIREUS_QUOTIENT_DIMENSION {
        var right: i64 = 0
        while right < PIREUS_QUOTIENT_DIMENSION {
            let cell = left * PIREUS_QUOTIENT_DIMENSION + right
            let delta = q[left] ^ q[right] ^ q[left ^ right]
            let remainder = table[cell] ^ delta
            if remainder != 0 {
                let word = cell / PIREUS_QUOTIENT_WORD_BITS
                let bit = cell - word * PIREUS_QUOTIENT_WORD_BITS
                words[word] = words[word] | (1 << bit)
                nonzero = nonzero + 1
            }
            right = right + 1
        }
        left = left + 1
    }
    QnfNormalization {
        words: words,
        gauge_word: gauge_word,
        nonzero_cells: nonzero,
    }
}

fn qnf_gauge_table(gauge_word: i64) -> QnfTable with Mut, Panic {
    var cells: [i64; 256] = [0; 256]
    var left: i64 = 0
    while left < PIREUS_QUOTIENT_DIMENSION {
        var right: i64 = 0
        while right < PIREUS_QUOTIENT_DIMENSION {
            cells[left * 16 + right] =
                qnf_coboundary(gauge_word, left, right)
            right = right + 1
        }
        left = left + 1
    }
    QnfTable { cells: cells }
}

fn qnf_build_normalizer_certificate()
    -> PireusGaugeNormalizerCertificate with Mut, Panic, Div {
    var pivot_checks: i64 = 0
    var pivot_failures: i64 = 0
    var basis: i64 = 0
    while basis < PIREUS_QUOTIENT_GAUGE_BITS {
        let table = qnf_gauge_table(1 << basis)
        let normalized = qnf_normalize(&table.cells)
        var row: i64 = 0
        while row < PIREUS_QUOTIENT_GAUGE_BITS {
            pivot_checks = pivot_checks + 1
            let observed = (normalized.gauge_word >> row) & 1
            let expected = if row == basis { 1 } else { 0 }
            if observed != expected { pivot_failures = pivot_failures + 1 }
            row = row + 1
        }
        basis = basis + 1
    }

    var roundtrip_words: i64 = 0
    var roundtrip_cell_checks: i64 = 0
    var roundtrip_failures: i64 = 0
    var unique_failures: i64 = 0
    var gauge_word: i64 = 0
    while gauge_word < PIREUS_QUOTIENT_GAUGE_WORD_COUNT {
        let table = qnf_gauge_table(gauge_word)
        let normalized = qnf_normalize(&table.cells)
        roundtrip_words = roundtrip_words + 1
        var left: i64 = 0
        while left < PIREUS_QUOTIENT_DIMENSION {
            var right: i64 = 0
            while right < PIREUS_QUOTIENT_DIMENSION {
                roundtrip_cell_checks = roundtrip_cell_checks + 1
                if table.cells[left * 16 + right] != qnf_coboundary(
                        normalized.gauge_word, left, right) {
                    roundtrip_failures = roundtrip_failures + 1
                }
                right = right + 1
            }
            left = left + 1
        }
        if !qnf_words_zero(&normalized.words) ||
            normalized.nonzero_cells != 0 {
            roundtrip_failures = roundtrip_failures + 1
        }
        if normalized.gauge_word != gauge_word {
            unique_failures = unique_failures + 1
        }
        gauge_word = gauge_word + 1
    }
    PireusGaugeNormalizerCertificate {
        gauge_bits: PIREUS_QUOTIENT_GAUGE_BITS,
        canonical_words: PIREUS_QUOTIENT_GAUGE_WORD_COUNT,
        pivot_checks: pivot_checks,
        pivot_failures: pivot_failures,
        roundtrip_words: roundtrip_words,
        roundtrip_cell_checks: roundtrip_cell_checks,
        roundtrip_failures: roundtrip_failures,
        unique_failures: unique_failures,
        complete: pivot_checks == PIREUS_QUOTIENT_GAUGE_BITS *
                PIREUS_QUOTIENT_GAUGE_BITS && pivot_failures == 0 &&
            roundtrip_words == PIREUS_QUOTIENT_GAUGE_WORD_COUNT &&
            roundtrip_cell_checks == PIREUS_QUOTIENT_GAUGE_WORD_COUNT *
                PIREUS_QUOTIENT_CELL_COUNT &&
            roundtrip_failures == 0 && unique_failures == 0,
    }
}

fn qnf_parent_displacement(
    parent: &PireusQuotientParentTable,
    matrix: i64,
    swap: bool,
) -> QnfTable with Mut, Panic {
    var cells: [i64; 256] = [0; 256]
    var left: i64 = 0
    while left < PIREUS_QUOTIENT_DIMENSION {
        let mapped_left = qnf_matrix_apply(matrix, left)
        var right: i64 = 0
        while right < PIREUS_QUOTIENT_DIMENSION {
            let mapped_right = qnf_matrix_apply(matrix, right)
            let transformed = if swap {
                parent.cells[mapped_right * 16 + mapped_left]
            } else {
                parent.cells[mapped_left * 16 + mapped_right]
            }
            cells[left * 16 + right] =
                transformed ^ parent.cells[left * 16 + right]
            right = right + 1
        }
        left = left + 1
    }
    QnfTable { cells: cells }
}

fn qnf_child_table(
    population: &PireusCubicMutationPopulation,
    child: i64,
) -> QnfTable with Mut, Panic {
    var cells: [i64; 256] = [0; 256]
    var cell: i64 = 0
    while cell < PIREUS_QUOTIENT_CELL_COUNT {
        cells[cell] = population.sign_bits[
            child * PIREUS_QUOTIENT_CELL_COUNT + cell]
        cell = cell + 1
    }
    QnfTable { cells: cells }
}

fn qnf_action_child_table(
    population: &PireusCubicMutationPopulation,
    child: i64,
    matrix: i64,
    swap: bool,
) -> QnfTable with Mut, Panic {
    var cells: [i64; 256] = [0; 256]
    var left: i64 = 0
    while left < PIREUS_QUOTIENT_DIMENSION {
        let mapped_left = qnf_matrix_apply(matrix, left)
        var right: i64 = 0
        while right < PIREUS_QUOTIENT_DIMENSION {
            let mapped_right = qnf_matrix_apply(matrix, right)
            let source = if swap {
                mapped_right * PIREUS_QUOTIENT_DIMENSION + mapped_left
            } else {
                mapped_left * PIREUS_QUOTIENT_DIMENSION + mapped_right
            }
            cells[left * 16 + right] = population.sign_bits[
                child * PIREUS_QUOTIENT_CELL_COUNT + source]
            right = right + 1
        }
        left = left + 1
    }
    QnfTable { cells: cells }
}

fn qnf_action_code(matrix: i64, swap_index: i64) -> i64 {
    matrix * PIREUS_QUOTIENT_SWAP_COUNT + swap_index
}

fn qnf_action_matrix(code: i64) -> i64 with Div {
    code / PIREUS_QUOTIENT_SWAP_COUNT
}

fn qnf_action_swap_index(code: i64) -> i64 with Div {
    code - qnf_action_matrix(code) * PIREUS_QUOTIENT_SWAP_COUNT
}

fn qnf_parent_action_normalization(
    parent: &PireusQuotientParentTable,
    matrix: i64,
    swap_index: i64,
) -> QnfNormalization with Mut, Panic, Div {
    let displacement = qnf_parent_displacement(
        parent, matrix, swap_index == 1)
    qnf_normalize(&displacement.cells)
}

fn qnf_parent_action_admitted(
    parent: &PireusQuotientParentTable,
    matrix: i64,
    swap_index: i64,
) -> bool with Mut, Panic, Div {
    if matrix < 0 || matrix >= PIREUS_QUOTIENT_MATRIX_ENCODINGS ||
        swap_index < 0 || swap_index >= PIREUS_QUOTIENT_SWAP_COUNT ||
        !qnf_matrix_invertible(matrix) {
        return false
    }
    let normalized = qnf_parent_action_normalization(
        parent, matrix, swap_index)
    normalized.nonzero_cells == 0 && qnf_words_zero(&normalized.words)
}

fn qnf_build_actions(parent: &PireusQuotientParentTable)
    -> QnfActionWork with Mut, Panic, Div {
    var admitted_codes: [i64; 40320] = [0; 40320]
    var invertible: i64 = 0
    var actions_considered: i64 = 0
    var admitted: i64 = 0
    var admitted_no_swap: i64 = 0
    var admitted_swap: i64 = 0
    var identity_present: bool = false
    var identity_vector_checks: i64 = 0
    var identity_vector_failures: i64 = 0
    var parent_cell_checks: i64 = 0
    var parent_replay_failures: i64 = 0

    var identity_vector: i64 = 0
    while identity_vector < PIREUS_QUOTIENT_DIMENSION {
        identity_vector_checks = identity_vector_checks + 1
        if qnf_matrix_apply(
                PIREUS_QUOTIENT_IDENTITY_MATRIX, identity_vector) !=
                identity_vector {
            identity_vector_failures = identity_vector_failures + 1
        }
        identity_vector = identity_vector + 1
    }
    var matrix: i64 = 0
    while matrix < PIREUS_QUOTIENT_MATRIX_ENCODINGS {
        if qnf_matrix_invertible(matrix) {
            invertible = invertible + 1
            var swap_index: i64 = 0
            while swap_index < PIREUS_QUOTIENT_SWAP_COUNT {
                let displacement = qnf_parent_displacement(
                    parent, matrix, swap_index == 1)
                let normalized = qnf_normalize(&displacement.cells)
                actions_considered = actions_considered + 1
                if normalized.nonzero_cells == 0 &&
                    qnf_words_zero(&normalized.words) {
                    var left: i64 = 0
                    while left < PIREUS_QUOTIENT_DIMENSION {
                        var right: i64 = 0
                        while right < PIREUS_QUOTIENT_DIMENSION {
                            parent_cell_checks = parent_cell_checks + 1
                            if displacement.cells[left * 16 + right] !=
                                qnf_coboundary(
                                    normalized.gauge_word, left, right) {
                                parent_replay_failures =
                                    parent_replay_failures + 1
                            }
                            right = right + 1
                        }
                        left = left + 1
                    }
                    admitted_codes[admitted] = qnf_action_code(
                        matrix, swap_index)
                    admitted = admitted + 1
                    if swap_index == 0 {
                        admitted_no_swap = admitted_no_swap + 1
                    } else { admitted_swap = admitted_swap + 1 }
                    if matrix == PIREUS_QUOTIENT_IDENTITY_MATRIX &&
                        swap_index == 0 && normalized.gauge_word == 0 {
                        identity_present = true
                    }
                }
                swap_index = swap_index + 1
            }
        }
        matrix = matrix + 1
    }

    var inverse_checks: i64 = 0
    var inverse_failures: i64 = 0
    var action_code_checks: i64 = 0
    var action_code_failures: i64 = 0
    var action: i64 = 0
    while action < admitted {
        let code = admitted_codes[action]
        let matrix = qnf_action_matrix(code)
        let swap = qnf_action_swap_index(code)
        action_code_checks = action_code_checks + 1
        if qnf_action_code(matrix, swap) != code ||
            swap < 0 || swap >= PIREUS_QUOTIENT_SWAP_COUNT ||
            !qnf_matrix_invertible(matrix) {
            action_code_failures = action_code_failures + 1
        }
        let inverse = qnf_matrix_inverse(matrix)
        inverse_checks = inverse_checks + 1
        if !qnf_parent_action_admitted(parent, inverse, swap) ||
            qnf_matrix_compose(matrix, inverse) !=
                PIREUS_QUOTIENT_IDENTITY_MATRIX ||
            qnf_matrix_compose(inverse, matrix) !=
                PIREUS_QUOTIENT_IDENTITY_MATRIX {
            inverse_failures = inverse_failures + 1
        }
        action = action + 1
    }

    var closure_checks: i64 = 0
    var closure_failures: i64 = 0
    var composition_vector_checks: i64 = 0
    var composition_vector_failures: i64 = 0
    var left_action: i64 = 0
    while left_action < admitted {
        var right_action: i64 = 0
        while right_action < admitted {
            let left_code = admitted_codes[left_action]
            let right_code = admitted_codes[right_action]
            let left_matrix = qnf_action_matrix(left_code)
            let right_matrix = qnf_action_matrix(right_code)
            let composed = qnf_matrix_compose(
                left_matrix, right_matrix)
            let composed_swap = qnf_action_swap_index(left_code) ^
                qnf_action_swap_index(right_code)
            closure_checks = closure_checks + 1
            if !qnf_parent_action_admitted(
                    parent, composed, composed_swap) {
                closure_failures = closure_failures + 1
            }
            var vector: i64 = 0
            while vector < PIREUS_QUOTIENT_DIMENSION {
                composition_vector_checks = composition_vector_checks + 1
                if qnf_matrix_apply(composed, vector) != qnf_matrix_apply(
                        left_matrix,
                        qnf_matrix_apply(right_matrix, vector)) {
                    composition_vector_failures =
                        composition_vector_failures + 1
                }
                vector = vector + 1
            }
            right_action = right_action + 1
        }
        left_action = left_action + 1
    }

    var gauge_equivariance_checks: i64 = 0
    var gauge_equivariance_failures: i64 = 0
    action = 0
    while action < admitted {
        let action_code = admitted_codes[action]
        let code = qnf_action_matrix(action_code)
        let swap = qnf_action_swap_index(action_code) == 1
        var basis: i64 = 0
        while basis < PIREUS_QUOTIENT_GAUGE_BITS {
            let gauge_word = 1 << basis
            let pulled_word = qnf_pullback_gauge_word(gauge_word, code)
            var left: i64 = 0
            while left < PIREUS_QUOTIENT_DIMENSION {
                let mapped_left = qnf_matrix_apply(code, left)
                var right: i64 = 0
                while right < PIREUS_QUOTIENT_DIMENSION {
                    let mapped_right = qnf_matrix_apply(code, right)
                    let source_left = if swap {
                        mapped_right
                    } else { mapped_left }
                    let source_right = if swap {
                        mapped_left
                    } else { mapped_right }
                    let lhs = qnf_coboundary(
                        gauge_word, source_left, source_right)
                    let rhs = qnf_coboundary(pulled_word, left, right)
                    gauge_equivariance_checks =
                        gauge_equivariance_checks + 1
                    if lhs != rhs {
                        gauge_equivariance_failures =
                            gauge_equivariance_failures + 1
                    }
                    right = right + 1
                }
                left = left + 1
            }
            basis = basis + 1
        }
        action = action + 1
    }

    let certificate = PireusParentActionCertificate {
        matrix_encodings_scanned: PIREUS_QUOTIENT_MATRIX_ENCODINGS,
        invertible_matrices: invertible,
        actions_considered: actions_considered,
        admitted_actions: admitted,
        admitted_no_swap: admitted_no_swap,
        admitted_swap: admitted_swap,
        rejected_actions: actions_considered - admitted,
        identity_present: identity_present,
        identity_vector_checks: identity_vector_checks,
        identity_vector_failures: identity_vector_failures,
        action_code_checks: action_code_checks,
        action_code_failures: action_code_failures,
        parent_cell_checks: parent_cell_checks,
        parent_replay_failures: parent_replay_failures,
        inverse_checks: inverse_checks,
        inverse_failures: inverse_failures,
        closure_checks: closure_checks,
        closure_failures: closure_failures,
        composition_vector_checks: composition_vector_checks,
        composition_vector_failures: composition_vector_failures,
        gauge_equivariance_checks: gauge_equivariance_checks,
        gauge_equivariance_failures: gauge_equivariance_failures,
        complete: PIREUS_QUOTIENT_SWAP_COUNT == 2 &&
            invertible == PIREUS_QUOTIENT_GL4_COUNT &&
            actions_considered == PIREUS_QUOTIENT_ACTION_COUNT &&
            admitted > 0 && admitted == admitted_no_swap + admitted_swap &&
            identity_present && identity_vector_checks ==
                PIREUS_QUOTIENT_DIMENSION && identity_vector_failures == 0 &&
            action_code_checks == admitted && action_code_failures == 0 &&
            parent_cell_checks == admitted *
                PIREUS_QUOTIENT_CELL_COUNT &&
            parent_replay_failures == 0 && inverse_checks == admitted &&
            inverse_failures == 0 && closure_checks == admitted * admitted &&
            closure_failures == 0 && composition_vector_checks == admitted *
                admitted * PIREUS_QUOTIENT_DIMENSION &&
            composition_vector_failures == 0 &&
            gauge_equivariance_checks == admitted *
                PIREUS_QUOTIENT_GAUGE_BITS * PIREUS_QUOTIENT_CELL_COUNT &&
            gauge_equivariance_failures == 0,
    }
    QnfActionWork {
        certificate: certificate,
        admitted_codes: admitted_codes,
    }
}

fn qnf_pack_table(table: &[i64; 256]) -> [i64; 8]
with Mut, Panic, Div {
    var words: [i64; 8] = [0; 8]
    var cell: i64 = 0
    while cell < PIREUS_QUOTIENT_CELL_COUNT {
        if table[cell] != 0 {
            let word = cell / PIREUS_QUOTIENT_WORD_BITS
            let bit = cell - word * PIREUS_QUOTIENT_WORD_BITS
            words[word] = words[word] | (1 << bit)
        }
        cell = cell + 1
    }
    words
}

fn qnf_flat_words_equal(
    left: &[i64; 384],
    left_child: i64,
    right: &[i64; 384],
    right_child: i64,
) -> bool with Mut, Panic {
    var word: i64 = 0
    while word < PIREUS_QUOTIENT_TABLE_WORDS {
        if left[left_child * PIREUS_QUOTIENT_TABLE_WORDS + word] !=
            right[right_child * PIREUS_QUOTIENT_TABLE_WORDS + word] {
            return false
        }
        word = word + 1
    }
    true
}

fn qnf_normalized_words_match(
    normalization: &QnfNormalization,
    words: &[i64; 384],
    child: i64,
) -> bool with Mut, Panic {
    var word: i64 = 0
    while word < PIREUS_QUOTIENT_TABLE_WORDS {
        if normalization.words[word] !=
            words[child * PIREUS_QUOTIENT_TABLE_WORDS + word] {
            return false
        }
        word = word + 1
    }
    true
}

fn qnf_relation_offset(profile: i64, left: i64, right: i64) -> i64 {
    profile * PIREUS_QUOTIENT_RELATION_CELLS +
        left * PIREUS_QUOTIENT_CHILD_COUNT + right
}

fn qnf_class_digest(
    profile: i64,
    representative: i64,
    member_mask: i64,
    member_count: i64,
    witnesses_m: &[i64; 144],
    witnesses_s: &[i64; 144],
    witnesses_q: &[i64; 144],
    population: &PireusCubicMutationPopulation,
    parent_population_digest: &PireusCubicForgeDigest,
) -> PireusQuotientDigest with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = qnf_digest_add_i64(state, PIREUS_QUOTIENT_SCHEMA)
    state = qnf_digest_add_words(state, &parent_population_digest.words)
    state = qnf_digest_add_i64(state, profile)
    state = qnf_digest_add_i64(state, representative)
    state = qnf_digest_add_i64(state, member_mask)
    state = qnf_digest_add_i64(state, member_count)
    var child: i64 = 0
    while child < PIREUS_QUOTIENT_CHILD_COUNT {
        if (member_mask & (1 << child)) != 0 {
            state = qnf_digest_add_i64(state, child)
            var word: i64 = 0
            while word < 8 {
                state = qnf_digest_add_i64(
                    state,
                    population.child_digest_words[child * 8 + word])
                word = word + 1
            }
            let witness = profile * PIREUS_QUOTIENT_CHILD_COUNT + child
            state = qnf_digest_add_i64(state, witnesses_m[witness])
            state = qnf_digest_add_i64(state, witnesses_s[witness])
            state = qnf_digest_add_i64(state, witnesses_q[witness])
        }
        child = child + 1
    }
    qnf_digest_finish(state)
}

fn qnf_profile_digest(
    profile: i64,
    class_count: i64,
    minimum_size: i64,
    maximum_size: i64,
    size_sum: i64,
    representatives: &[i64; 144],
    member_masks: &[i64; 144],
    member_counts: &[i64; 144],
    class_digests: &[i64; 1152],
) -> PireusQuotientDigest with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = qnf_digest_add_i64(state, PIREUS_QUOTIENT_SCHEMA)
    state = qnf_digest_add_i64(state, profile)
    state = qnf_digest_add_i64(state, class_count)
    state = qnf_digest_add_i64(state, minimum_size)
    state = qnf_digest_add_i64(state, maximum_size)
    state = qnf_digest_add_i64(state, size_sum)
    var class_id: i64 = 0
    while class_id < class_count {
        let slot = profile * PIREUS_QUOTIENT_CHILD_COUNT + class_id
        state = qnf_digest_add_i64(state, representatives[slot])
        state = qnf_digest_add_i64(state, member_masks[slot])
        state = qnf_digest_add_i64(state, member_counts[slot])
        var word: i64 = 0
        while word < 8 {
            state = qnf_digest_add_i64(
                state, class_digests[slot * 8 + word])
            word = word + 1
        }
        class_id = class_id + 1
    }
    qnf_digest_finish(state)
}

fn qnf_build_atlas(
    population: &PireusCubicMutationPopulation,
    parent_population_digest: &PireusCubicForgeDigest,
    actions: &QnfActionWork,
) -> QnfAtlasWork with Mut, Panic, Div, Epistemic {
    var raw_table_words: [i64; 384] = [0; 384]
    var normalized_table_words: [i64; 384] = [0; 384]
    var normalized_gauges: [i64; 48] = [0; 48]
    var relation_bits: [i64; 6912] = [0; 6912]
    var pair_witness_matrices: [i64; 2304] = [0; 2304]
    var pair_witness_swaps: [i64; 2304] = [0; 2304]
    var pair_witness_gauges: [i64; 2304] = [0; 2304]

    var child: i64 = 0
    while child < PIREUS_QUOTIENT_CHILD_COUNT {
        let table = qnf_child_table(population, child)
        let packed = qnf_pack_table(&table.cells)
        let normalized = qnf_normalize(&table.cells)
        normalized_gauges[child] = normalized.gauge_word
        var word: i64 = 0
        while word < PIREUS_QUOTIENT_TABLE_WORDS {
            raw_table_words[child * 8 + word] = packed[word]
            normalized_table_words[child * 8 + word] =
                normalized.words[word]
            word = word + 1
        }
        child = child + 1
    }

    var q0_pair_checks: i64 = 0
    var q1_pair_checks: i64 = 0
    var left: i64 = 0
    while left < PIREUS_QUOTIENT_CHILD_COUNT {
        var right: i64 = 0
        while right < PIREUS_QUOTIENT_CHILD_COUNT {
            q0_pair_checks = q0_pair_checks + 1
            if qnf_flat_words_equal(
                    &raw_table_words, left, &raw_table_words, right) {
                relation_bits[qnf_relation_offset(
                    PIREUS_QUOTIENT_PROFILE_EXTENT, left, right)] = 1
            }
            q1_pair_checks = q1_pair_checks + 1
            if qnf_flat_words_equal(
                    &normalized_table_words, left,
                    &normalized_table_words, right) {
                relation_bits[qnf_relation_offset(
                    PIREUS_QUOTIENT_PROFILE_GAUGE, left, right)] = 1
            }
            right = right + 1
        }
        left = left + 1
    }

    var q2_action_child_checks: i64 = 0
    var q2_target_checks: i64 = 0
    child = 0
    while child < PIREUS_QUOTIENT_CHILD_COUNT {
        var action: i64 = 0
        while action < actions.certificate.admitted_actions {
            let action_code = actions.admitted_codes[action]
            let matrix = qnf_action_matrix(action_code)
            let swap = qnf_action_swap_index(action_code)
            let transformed = qnf_action_child_table(
                population, child, matrix, swap == 1)
            let normalized = qnf_normalize(&transformed.cells)
            q2_action_child_checks = q2_action_child_checks + 1
            var target: i64 = 0
            while target < PIREUS_QUOTIENT_CHILD_COUNT {
                q2_target_checks = q2_target_checks + 1
                if qnf_normalized_words_match(
                        &normalized, &normalized_table_words, target) {
                    let relation = child * PIREUS_QUOTIENT_CHILD_COUNT + target
                    let relation_cell = qnf_relation_offset(
                        PIREUS_QUOTIENT_PROFILE_PARENT, child, target)
                    if relation_bits[relation_cell] == 0 {
                        pair_witness_matrices[relation] = matrix
                        pair_witness_swaps[relation] = swap
                        pair_witness_gauges[relation] =
                            normalized.gauge_word ^ normalized_gauges[target]
                    }
                    relation_bits[relation_cell] = 1
                }
                target = target + 1
            }
            action = action + 1
        }
        child = child + 1
    }

    var reflexive_checks: i64 = 0
    var reflexive_failures: i64 = 0
    var symmetric_checks: i64 = 0
    var symmetric_failures: i64 = 0
    var transitive_checks: i64 = 0
    var transitive_failures: i64 = 0
    var profile: i64 = 0
    while profile < PIREUS_QUOTIENT_PROFILE_COUNT {
        left = 0
        while left < PIREUS_QUOTIENT_CHILD_COUNT {
            reflexive_checks = reflexive_checks + 1
            if relation_bits[qnf_relation_offset(profile, left, left)] == 0 {
                reflexive_failures = reflexive_failures + 1
            }
            var middle: i64 = 0
            while middle < PIREUS_QUOTIENT_CHILD_COUNT {
                symmetric_checks = symmetric_checks + 1
                let forward = relation_bits[
                    qnf_relation_offset(profile, left, middle)]
                let reverse = relation_bits[
                    qnf_relation_offset(profile, middle, left)]
                if forward != reverse {
                    symmetric_failures = symmetric_failures + 1
                }
                var right: i64 = 0
                while right < PIREUS_QUOTIENT_CHILD_COUNT {
                    transitive_checks = transitive_checks + 1
                    if forward != 0 && relation_bits[
                            qnf_relation_offset(profile, middle, right)] != 0 &&
                        relation_bits[
                            qnf_relation_offset(profile, left, right)] == 0 {
                        transitive_failures = transitive_failures + 1
                    }
                    right = right + 1
                }
                middle = middle + 1
            }
            left = left + 1
        }
        profile = profile + 1
    }

    var refinement_checks: i64 = 0
    var refinement_failures: i64 = 0
    left = 0
    while left < PIREUS_QUOTIENT_CHILD_COUNT {
        var right: i64 = 0
        while right < PIREUS_QUOTIENT_CHILD_COUNT {
            let q0 = relation_bits[qnf_relation_offset(
                PIREUS_QUOTIENT_PROFILE_EXTENT, left, right)]
            let q1 = relation_bits[qnf_relation_offset(
                PIREUS_QUOTIENT_PROFILE_GAUGE, left, right)]
            let q2 = relation_bits[qnf_relation_offset(
                PIREUS_QUOTIENT_PROFILE_PARENT, left, right)]
            refinement_checks = refinement_checks + 2
            if q0 != 0 && q1 == 0 {
                refinement_failures = refinement_failures + 1
            }
            if q1 != 0 && q2 == 0 {
                refinement_failures = refinement_failures + 1
            }
            right = right + 1
        }
        left = left + 1
    }

    var class_counts: [i64; 3] = [0; 3]
    var minimum_class_sizes: [i64; 3] = [48; 3]
    var maximum_class_sizes: [i64; 3] = [0; 3]
    var class_size_sums: [i64; 3] = [0; 3]
    var class_representatives: [i64; 144] = [0; 144]
    var class_member_masks: [i64; 144] = [0; 144]
    var class_member_counts: [i64; 144] = [0; 144]
    var child_class_ids: [i64; 144] = [0; 144]
    var child_representatives: [i64; 144] = [0; 144]
    var witness_matrices: [i64; 144] = [0; 144]
    var witness_swaps: [i64; 144] = [0; 144]
    var witness_gauges: [i64; 144] = [0; 144]
    var partition_checks: i64 = 0
    var partition_failures: i64 = 0

    profile = 0
    while profile < PIREUS_QUOTIENT_PROFILE_COUNT {
        child = 0
        while child < PIREUS_QUOTIENT_CHILD_COUNT {
            var representative: i64 = 0
            while representative < PIREUS_QUOTIENT_CHILD_COUNT &&
                relation_bits[qnf_relation_offset(
                    profile, child, representative)] == 0 {
                representative = representative + 1
            }
            partition_checks = partition_checks + 1
            if representative >= PIREUS_QUOTIENT_CHILD_COUNT {
                partition_failures = partition_failures + 1
                representative = child
            }
            child_representatives[
                profile * PIREUS_QUOTIENT_CHILD_COUNT + child] =
                    representative
            child = child + 1
        }

        child = 0
        while child < PIREUS_QUOTIENT_CHILD_COUNT {
            if child_representatives[
                    profile * PIREUS_QUOTIENT_CHILD_COUNT + child] == child {
                let slot = profile * PIREUS_QUOTIENT_CHILD_COUNT +
                    class_counts[profile]
                class_representatives[slot] = child
                class_counts[profile] = class_counts[profile] + 1
            }
            child = child + 1
        }

        child = 0
        while child < PIREUS_QUOTIENT_CHILD_COUNT {
            let representative = child_representatives[
                profile * PIREUS_QUOTIENT_CHILD_COUNT + child]
            var class_id: i64 = 0
            while class_id < class_counts[profile] &&
                class_representatives[
                    profile * PIREUS_QUOTIENT_CHILD_COUNT + class_id] !=
                        representative {
                class_id = class_id + 1
            }
            if class_id >= class_counts[profile] {
                partition_failures = partition_failures + 1
                class_id = 0
            }
            let slot = profile * PIREUS_QUOTIENT_CHILD_COUNT + class_id
            child_class_ids[
                profile * PIREUS_QUOTIENT_CHILD_COUNT + child] = class_id
            class_member_masks[slot] = class_member_masks[slot] | (1 << child)
            class_member_counts[slot] = class_member_counts[slot] + 1
            child = child + 1
        }

        var class_id: i64 = 0
        while class_id < class_counts[profile] {
            let slot = profile * PIREUS_QUOTIENT_CHILD_COUNT + class_id
            let size = class_member_counts[slot]
            class_size_sums[profile] = class_size_sums[profile] + size
            if size < minimum_class_sizes[profile] {
                minimum_class_sizes[profile] = size
            }
            if size > maximum_class_sizes[profile] {
                maximum_class_sizes[profile] = size
            }
            class_id = class_id + 1
        }
        if class_counts[profile] == 0 {
            minimum_class_sizes[profile] = 0
        }
        profile = profile + 1
    }

    var witness_cell_checks: i64 = 0
    var witness_failures: i64 = 0
    profile = 0
    while profile < PIREUS_QUOTIENT_PROFILE_COUNT {
        child = 0
        while child < PIREUS_QUOTIENT_CHILD_COUNT {
            let witness_slot = profile * PIREUS_QUOTIENT_CHILD_COUNT + child
            let representative = child_representatives[witness_slot]
            var matrix = PIREUS_QUOTIENT_IDENTITY_MATRIX
            var swap: i64 = 0
            var gauge: i64 = 0
            if profile == PIREUS_QUOTIENT_PROFILE_GAUGE {
                gauge = normalized_gauges[child] ^
                    normalized_gauges[representative]
            }
            if profile == PIREUS_QUOTIENT_PROFILE_PARENT {
                let relation = child * PIREUS_QUOTIENT_CHILD_COUNT +
                    representative
                matrix = pair_witness_matrices[relation]
                swap = pair_witness_swaps[relation]
                gauge = pair_witness_gauges[relation]
                if matrix == 0 { witness_failures = witness_failures + 1 }
            }
            witness_matrices[witness_slot] = matrix
            witness_swaps[witness_slot] = swap
            witness_gauges[witness_slot] = gauge
            let transformed = qnf_action_child_table(
                population, child, matrix, swap == 1)
            let target = qnf_child_table(population, representative)
            var cell: i64 = 0
            while cell < PIREUS_QUOTIENT_CELL_COUNT {
                let left_index = cell / PIREUS_QUOTIENT_DIMENSION
                let right_index = cell -
                    left_index * PIREUS_QUOTIENT_DIMENSION
                witness_cell_checks = witness_cell_checks + 1
                if (transformed.cells[cell] ^ target.cells[cell]) !=
                    qnf_coboundary(gauge, left_index, right_index) {
                    witness_failures = witness_failures + 1
                }
                cell = cell + 1
            }
            child = child + 1
        }
        profile = profile + 1
    }

    var separation_checks: i64 = 0
    var separation_failures: i64 = 0
    profile = 0
    while profile < PIREUS_QUOTIENT_PROFILE_COUNT {
        var left_class: i64 = 0
        while left_class < class_counts[profile] {
            var right_class: i64 = left_class + 1
            while right_class < class_counts[profile] {
                let left_rep = class_representatives[
                    profile * PIREUS_QUOTIENT_CHILD_COUNT + left_class]
                let right_rep = class_representatives[
                    profile * PIREUS_QUOTIENT_CHILD_COUNT + right_class]
                separation_checks = separation_checks + 1
                if relation_bits[qnf_relation_offset(
                        profile, left_rep, right_rep)] != 0 {
                    separation_failures = separation_failures + 1
                }
                right_class = right_class + 1
            }
            left_class = left_class + 1
        }
        profile = profile + 1
    }

    var class_digest_words: [i64; 1152] = [0; 1152]
    var profile_digest_words: [i64; 24] = [0; 24]
    profile = 0
    while profile < PIREUS_QUOTIENT_PROFILE_COUNT {
        var class_id: i64 = 0
        while class_id < class_counts[profile] {
            let slot = profile * PIREUS_QUOTIENT_CHILD_COUNT + class_id
            let digest = qnf_class_digest(
                profile, class_representatives[slot],
                class_member_masks[slot], class_member_counts[slot],
                &witness_matrices, &witness_swaps, &witness_gauges,
                population, parent_population_digest)
            var word: i64 = 0
            while word < 8 {
                class_digest_words[slot * 8 + word] = digest.words[word]
                word = word + 1
            }
            class_id = class_id + 1
        }
        let digest = qnf_profile_digest(
            profile, class_counts[profile], minimum_class_sizes[profile],
            maximum_class_sizes[profile], class_size_sums[profile],
            &class_representatives, &class_member_masks,
            &class_member_counts, &class_digest_words)
        var word: i64 = 0
        while word < 8 {
            profile_digest_words[profile * 8 + word] = digest.words[word]
            word = word + 1
        }
        profile = profile + 1
    }

    let complete = q0_pair_checks == PIREUS_QUOTIENT_RELATION_CELLS &&
        q1_pair_checks == PIREUS_QUOTIENT_RELATION_CELLS &&
        q2_action_child_checks == actions.certificate.admitted_actions *
            PIREUS_QUOTIENT_CHILD_COUNT &&
        q2_target_checks == actions.certificate.admitted_actions *
            PIREUS_QUOTIENT_RELATION_CELLS &&
        reflexive_checks == PIREUS_QUOTIENT_PROFILE_COUNT *
            PIREUS_QUOTIENT_CHILD_COUNT && reflexive_failures == 0 &&
        symmetric_checks == PIREUS_QUOTIENT_ALL_RELATION_CELLS &&
        symmetric_failures == 0 && transitive_checks ==
            PIREUS_QUOTIENT_PROFILE_COUNT * PIREUS_QUOTIENT_CHILD_COUNT *
                PIREUS_QUOTIENT_CHILD_COUNT * PIREUS_QUOTIENT_CHILD_COUNT &&
        transitive_failures == 0 && refinement_checks ==
            2 * PIREUS_QUOTIENT_RELATION_CELLS &&
        refinement_failures == 0 && partition_checks ==
            PIREUS_QUOTIENT_PROFILE_COUNT * PIREUS_QUOTIENT_CHILD_COUNT &&
        partition_failures == 0 && class_size_sums[0] ==
            PIREUS_QUOTIENT_CHILD_COUNT && class_size_sums[1] ==
            PIREUS_QUOTIENT_CHILD_COUNT && class_size_sums[2] ==
            PIREUS_QUOTIENT_CHILD_COUNT && class_counts[0] > 0 &&
        class_counts[1] > 0 && class_counts[2] > 0 &&
        witness_cell_checks == PIREUS_QUOTIENT_PROFILE_COUNT *
            PIREUS_QUOTIENT_CHILD_COUNT * PIREUS_QUOTIENT_CELL_COUNT &&
        witness_failures == 0 && separation_failures == 0

    let atlas = PireusNoveltyAtlas {
        raw_table_words: raw_table_words,
        normalized_table_words: normalized_table_words,
        normalized_gauges: normalized_gauges,
        relation_bits: relation_bits,
        class_counts: class_counts,
        minimum_class_sizes: minimum_class_sizes,
        maximum_class_sizes: maximum_class_sizes,
        class_size_sums: class_size_sums,
        class_representatives: class_representatives,
        class_member_masks: class_member_masks,
        class_member_counts: class_member_counts,
        child_class_ids: child_class_ids,
        child_representatives: child_representatives,
        witness_matrices: witness_matrices,
        witness_swaps: witness_swaps,
        witness_gauges: witness_gauges,
        class_digest_words: class_digest_words,
        profile_digest_words: profile_digest_words,
        q0_pair_checks: q0_pair_checks,
        q1_pair_checks: q1_pair_checks,
        q2_action_child_checks: q2_action_child_checks,
        q2_target_checks: q2_target_checks,
        reflexive_checks: reflexive_checks,
        reflexive_failures: reflexive_failures,
        symmetric_checks: symmetric_checks,
        symmetric_failures: symmetric_failures,
        transitive_checks: transitive_checks,
        transitive_failures: transitive_failures,
        refinement_checks: refinement_checks,
        refinement_failures: refinement_failures,
        partition_checks: partition_checks,
        partition_failures: partition_failures,
        witness_cell_checks: witness_cell_checks,
        witness_failures: witness_failures,
        separation_checks: separation_checks,
        separation_failures: separation_failures,
        complete: complete,
    }
    QnfAtlasWork {
        atlas: atlas,
        pair_witness_matrices: pair_witness_matrices,
        pair_witness_swaps: pair_witness_swaps,
        pair_witness_gauges: pair_witness_gauges,
    }
}

fn qnf_build_receipt(
    lineage: &PireusQuotientLineage,
    parent: &PireusQuotientParentTable,
    normalizer: &PireusGaugeNormalizerCertificate,
    actions: &PireusParentActionCertificate,
    atlas: &PireusNoveltyAtlas,
) -> PireusQuotientReceipt {
    let exact = lineage.complete && parent.complete && normalizer.complete &&
        actions.complete && atlas.complete
    PireusQuotientReceipt {
        schema: PIREUS_QUOTIENT_SCHEMA,
        producer_language: PIREUS_QUOTIENT_LANGUAGE_SOUNIO,
        producer_role: PIREUS_QUOTIENT_ROLE_SEMANTIC_AUTHORITY,
        stage: PIREUS_QUOTIENT_STAGE_SOUNIO_EXECUTABLE,
        parent_lineage_bound: lineage.complete,
        parent_population_recovered: parent.complete,
        declared_action_universe_complete: actions.complete,
        gauge_normalizer_exact: normalizer.complete,
        parent_gauge_stabilizer_complete: actions.complete,
        extensional_quotient_exact: atlas.complete,
        basis_sign_gauge_quotient_exact: atlas.complete &&
            normalizer.complete,
        parent_linear_swap_gauge_quotient_exact: exact,
        canonical_novelty_atlas_complete: exact,
        parent_relative_operator_novelty_typed: exact,
        no_child_selected: exact,
        target_envelopes_unresolved: exact,
        global_linear_swap_gauge_quotient_complete: false,
        nonlinear_permutation_quotient_complete: false,
        isotopy_quotient_complete: false,
        algebra_isomorphism_complete: false,
        relative_algebraic_novelty: false,
        algorithmic_novelty: false,
        material_novelty: false,
        scientific_novelty: false,
        global_novelty: false,
        historical_novelty: false,
        priority_claim: false,
        external_prior_art_complete: false,
        semantics_frozen: false,
        formal_parity_open: false,
        effect_parity_open: false,
        material_parity_open: false,
        target_lowering_admitted: false,
        target_cost_admitted: false,
        target_performance_admitted: false,
        claim_ready: false,
    }
}

fn qnf_exercise_negatives() -> PireusQuotientNegatives
with Mut, Panic {
    let canonical = pireus_quotient_novelty_request()
    var bad = canonical

    bad.producer_language = PIREUS_QUOTIENT_LANGUAGE_PYTHON
    let python_oracle = qnf_request_error(&bad) != PIREUS_QUOTIENT_OK
    bad = canonical
    bad.producer_language = PIREUS_QUOTIENT_LANGUAGE_RUST
    let rust_oracle = qnf_request_error(&bad) != PIREUS_QUOTIENT_OK
    bad = canonical
    bad.producer_language = PIREUS_QUOTIENT_LANGUAGE_CPP
    bad.producer_role = PIREUS_QUOTIENT_ROLE_MATERIAL_PARITY
    let cpp_authority = qnf_request_error(&bad) != PIREUS_QUOTIENT_OK
    bad = canonical
    bad.producer_language = PIREUS_QUOTIENT_LANGUAGE_LLM
    bad.producer_role = PIREUS_QUOTIENT_ROLE_REVIEW_ONLY
    let llm_authority = qnf_request_error(&bad) != PIREUS_QUOTIENT_OK
    bad = canonical
    bad.parent_present = false
    let missing_parent = qnf_request_error(&bad) != PIREUS_QUOTIENT_OK
    bad = canonical
    bad.parent_semantics_frozen = false
    let unfrozen_parent = qnf_request_error(&bad) != PIREUS_QUOTIENT_OK
    bad = canonical
    bad.parent_source_bound = false
    let unbound_parent = qnf_request_error(&bad) != PIREUS_QUOTIENT_OK
    bad = canonical
    bad.declared_child_count = PIREUS_QUOTIENT_CHILD_COUNT - 1
    let wrong_child_count = qnf_request_error(&bad) != PIREUS_QUOTIENT_OK
    bad = canonical
    bad.declared_matrix_encodings = PIREUS_QUOTIENT_MATRIX_ENCODINGS - 1
    let wrong_matrix_universe = qnf_request_error(&bad) !=
        PIREUS_QUOTIENT_OK
    bad = canonical
    bad.declared_gl4_count = PIREUS_QUOTIENT_GL4_COUNT - 1
    let wrong_gl4_count = qnf_request_error(&bad) != PIREUS_QUOTIENT_OK
    bad = canonical
    bad.declared_action_count = PIREUS_QUOTIENT_ACTION_COUNT - 1
    let wrong_action_count = qnf_request_error(&bad) != PIREUS_QUOTIENT_OK
    bad = canonical
    bad.declared_gauge_bits = PIREUS_QUOTIENT_GAUGE_BITS - 1
    let wrong_gauge_bits = qnf_request_error(&bad) != PIREUS_QUOTIENT_OK
    bad = canonical
    bad.expected_stabilizer_present = true
    let result_injection = qnf_request_error(&bad) != PIREUS_QUOTIENT_OK
    bad = canonical
    bad.selection_requested = true
    let selected_child = qnf_request_error(&bad) != PIREUS_QUOTIENT_OK
    bad = canonical
    bad.ranking_present = true
    let ranking_objective = qnf_request_error(&bad) != PIREUS_QUOTIENT_OK
    bad = canonical
    bad.material_receipt_count = 1
    let material_without_receipt = qnf_request_error(&bad) !=
        PIREUS_QUOTIENT_OK
    bad = canonical
    bad.global_linear_quotient_requested = true
    let global_quotient_promotion = qnf_request_error(&bad) !=
        PIREUS_QUOTIENT_OK
    bad = canonical
    bad.nonlinear_quotient_requested = true
    let nonlinear_promotion = qnf_request_error(&bad) != PIREUS_QUOTIENT_OK
    bad = canonical
    bad.isotopy_quotient_requested = true
    let isotopy_promotion = qnf_request_error(&bad) != PIREUS_QUOTIENT_OK
    bad = canonical
    bad.algebra_isomorphism_requested = true
    let isomorphism_promotion = qnf_request_error(&bad) != PIREUS_QUOTIENT_OK
    bad = canonical
    bad.algebraic_novelty_requested = true
    let algebraic_promotion = qnf_request_error(&bad) != PIREUS_QUOTIENT_OK
    bad = canonical
    bad.algorithmic_novelty_requested = true
    let algorithmic_promotion = qnf_request_error(&bad) !=
        PIREUS_QUOTIENT_OK
    bad = canonical
    bad.material_novelty_requested = true
    let material_promotion = qnf_request_error(&bad) != PIREUS_QUOTIENT_OK
    bad = canonical
    bad.scientific_novelty_requested = true
    let scientific_promotion = qnf_request_error(&bad) !=
        PIREUS_QUOTIENT_OK
    bad = canonical
    bad.global_novelty_requested = true
    let global_promotion = qnf_request_error(&bad) != PIREUS_QUOTIENT_OK
    bad = canonical
    bad.historical_novelty_requested = true
    let historical_promotion = qnf_request_error(&bad) !=
        PIREUS_QUOTIENT_OK
    bad = canonical
    bad.priority_requested = true
    let priority_promotion = qnf_request_error(&bad) != PIREUS_QUOTIENT_OK
    bad = canonical
    bad.parity_requested = true
    let parity_prefreeze = qnf_request_error(&bad) != PIREUS_QUOTIENT_OK
    bad = canonical
    bad.claim_ready_requested = true
    let claim_ready_promotion = qnf_request_error(&bad) !=
        PIREUS_QUOTIENT_OK
    bad = canonical
    bad.external_review_promoted = true
    let review_promotion = qnf_request_error(&bad) != PIREUS_QUOTIENT_OK
    bad = canonical
    bad.waiver_present = true
    bad.waiver_founder = true
    bad.waiver_scoped = false
    bad.waiver_purpose_bound = true
    bad.waiver_live = true
    let invalid_waiver = qnf_request_error(&bad) != PIREUS_QUOTIENT_OK

    var passed: i64 = 0
    if python_oracle { passed = passed + 1 }
    if rust_oracle { passed = passed + 1 }
    if cpp_authority { passed = passed + 1 }
    if llm_authority { passed = passed + 1 }
    if missing_parent { passed = passed + 1 }
    if unfrozen_parent { passed = passed + 1 }
    if unbound_parent { passed = passed + 1 }
    if wrong_child_count { passed = passed + 1 }
    if wrong_matrix_universe { passed = passed + 1 }
    if wrong_gl4_count { passed = passed + 1 }
    if wrong_action_count { passed = passed + 1 }
    if wrong_gauge_bits { passed = passed + 1 }
    if result_injection { passed = passed + 1 }
    if selected_child { passed = passed + 1 }
    if ranking_objective { passed = passed + 1 }
    if material_without_receipt { passed = passed + 1 }
    if global_quotient_promotion { passed = passed + 1 }
    if nonlinear_promotion { passed = passed + 1 }
    if isotopy_promotion { passed = passed + 1 }
    if isomorphism_promotion { passed = passed + 1 }
    if algebraic_promotion { passed = passed + 1 }
    if algorithmic_promotion { passed = passed + 1 }
    if material_promotion { passed = passed + 1 }
    if scientific_promotion { passed = passed + 1 }
    if global_promotion { passed = passed + 1 }
    if historical_promotion { passed = passed + 1 }
    if priority_promotion { passed = passed + 1 }
    if parity_prefreeze { passed = passed + 1 }
    if claim_ready_promotion { passed = passed + 1 }
    if review_promotion { passed = passed + 1 }
    if invalid_waiver { passed = passed + 1 }

    PireusQuotientNegatives {
        passed: passed,
        total: 31,
        python_oracle: python_oracle,
        rust_oracle: rust_oracle,
        cpp_authority: cpp_authority,
        llm_authority: llm_authority,
        missing_parent: missing_parent,
        unfrozen_parent: unfrozen_parent,
        unbound_parent: unbound_parent,
        wrong_child_count: wrong_child_count,
        wrong_matrix_universe: wrong_matrix_universe,
        wrong_gl4_count: wrong_gl4_count,
        wrong_action_count: wrong_action_count,
        wrong_gauge_bits: wrong_gauge_bits,
        result_injection: result_injection,
        selected_child: selected_child,
        ranking_objective: ranking_objective,
        material_without_receipt: material_without_receipt,
        global_quotient_promotion: global_quotient_promotion,
        nonlinear_promotion: nonlinear_promotion,
        isotopy_promotion: isotopy_promotion,
        isomorphism_promotion: isomorphism_promotion,
        algebraic_promotion: algebraic_promotion,
        algorithmic_promotion: algorithmic_promotion,
        material_promotion: material_promotion,
        scientific_promotion: scientific_promotion,
        global_promotion: global_promotion,
        historical_promotion: historical_promotion,
        priority_promotion: priority_promotion,
        parity_prefreeze: parity_prefreeze,
        claim_ready_promotion: claim_ready_promotion,
        review_promotion: review_promotion,
        invalid_waiver: invalid_waiver,
    }
}

fn qnf_digest_lineage(lineage: &PireusQuotientLineage)
    -> PireusQuotientDigest with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = qnf_digest_add_words(state, &lineage.parent_source_sha256)
    state = qnf_digest_add_words(state, &lineage.parent_semantics_sha256)
    state = qnf_digest_add_words(state, &lineage.parent_freeze_sha256)
    state = qnf_digest_add_words(state, &lineage.parent_transcript_sha256)
    state = qnf_digest_add_words(state, &lineage.parent_parity_receipt_sha256)
    state = qnf_digest_add_bool(state, lineage.parent_live_match)
    state = qnf_digest_add_bool(state, lineage.parent_digest_match)
    state = qnf_digest_add_bool(state, lineage.parent_scope_match)
    state = qnf_digest_add_bool(state, lineage.complete)
    qnf_digest_finish(state)
}

fn qnf_digest_normalizer(normalizer: &PireusGaugeNormalizerCertificate)
    -> PireusQuotientDigest with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = qnf_digest_add_i64(state, normalizer.gauge_bits)
    state = qnf_digest_add_i64(state, normalizer.canonical_words)
    state = qnf_digest_add_i64(state, normalizer.pivot_checks)
    state = qnf_digest_add_i64(state, normalizer.pivot_failures)
    state = qnf_digest_add_i64(state, normalizer.roundtrip_words)
    state = qnf_digest_add_i64(state, normalizer.roundtrip_cell_checks)
    state = qnf_digest_add_i64(state, normalizer.roundtrip_failures)
    state = qnf_digest_add_i64(state, normalizer.unique_failures)
    state = qnf_digest_add_bool(state, normalizer.complete)
    qnf_digest_finish(state)
}

fn qnf_digest_actions(
    actions: &QnfActionWork,
    parent: &PireusQuotientParentTable,
)
    -> PireusQuotientDigest with Mut, Panic, Div, Epistemic {
    let certificate = &actions.certificate
    var state = sha256_init()
    state = qnf_digest_add_i64(state, certificate.matrix_encodings_scanned)
    state = qnf_digest_add_i64(state, certificate.invertible_matrices)
    state = qnf_digest_add_i64(state, certificate.actions_considered)
    state = qnf_digest_add_i64(state, certificate.admitted_actions)
    state = qnf_digest_add_i64(state, certificate.admitted_no_swap)
    state = qnf_digest_add_i64(state, certificate.admitted_swap)
    state = qnf_digest_add_i64(state, certificate.rejected_actions)
    state = qnf_digest_add_bool(state, certificate.identity_present)
    state = qnf_digest_add_i64(state, certificate.identity_vector_checks)
    state = qnf_digest_add_i64(state, certificate.identity_vector_failures)
    state = qnf_digest_add_i64(state, certificate.action_code_checks)
    state = qnf_digest_add_i64(state, certificate.action_code_failures)
    state = qnf_digest_add_i64(state, certificate.parent_cell_checks)
    state = qnf_digest_add_i64(state, certificate.parent_replay_failures)
    state = qnf_digest_add_i64(state, certificate.inverse_checks)
    state = qnf_digest_add_i64(state, certificate.inverse_failures)
    state = qnf_digest_add_i64(state, certificate.closure_checks)
    state = qnf_digest_add_i64(state, certificate.closure_failures)
    state = qnf_digest_add_i64(state, certificate.composition_vector_checks)
    state = qnf_digest_add_i64(
        state, certificate.composition_vector_failures)
    state = qnf_digest_add_i64(state, certificate.gauge_equivariance_checks)
    state = qnf_digest_add_i64(
        state, certificate.gauge_equivariance_failures)
    var action: i64 = 0
    while action < certificate.admitted_actions {
        let action_code = actions.admitted_codes[action]
        let matrix = qnf_action_matrix(action_code)
        let swap = qnf_action_swap_index(action_code)
        let normalized = qnf_parent_action_normalization(
            parent, matrix, swap)
        state = qnf_digest_add_i64(state, matrix)
        state = qnf_digest_add_i64(state, swap)
        state = qnf_digest_add_i64(state, normalized.gauge_word)
        action = action + 1
    }
    state = qnf_digest_add_bool(state, certificate.complete)
    qnf_digest_finish(state)
}

fn qnf_digest_atlas(
    atlas: &PireusNoveltyAtlas,
    parent_population_digest: &PireusCubicForgeDigest,
) -> PireusQuotientDigest with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = qnf_digest_add_words(state, &parent_population_digest.words)
    var index: i64 = 0
    while index < PIREUS_QUOTIENT_CHILD_DIGEST_WORDS {
        state = qnf_digest_add_i64(state, atlas.raw_table_words[index])
        state = qnf_digest_add_i64(state, atlas.normalized_table_words[index])
        index = index + 1
    }
    index = 0
    while index < PIREUS_QUOTIENT_CHILD_COUNT {
        state = qnf_digest_add_i64(state, atlas.normalized_gauges[index])
        index = index + 1
    }
    index = 0
    while index < PIREUS_QUOTIENT_ALL_RELATION_CELLS {
        state = qnf_digest_add_i64(state, atlas.relation_bits[index])
        index = index + 1
    }
    var profile: i64 = 0
    while profile < PIREUS_QUOTIENT_PROFILE_COUNT {
        state = qnf_digest_add_i64(state, atlas.class_counts[profile])
        state = qnf_digest_add_i64(
            state, atlas.minimum_class_sizes[profile])
        state = qnf_digest_add_i64(
            state, atlas.maximum_class_sizes[profile])
        state = qnf_digest_add_i64(state, atlas.class_size_sums[profile])
        var word: i64 = 0
        while word < 8 {
            state = qnf_digest_add_i64(
                state, atlas.profile_digest_words[profile * 8 + word])
            word = word + 1
        }
        profile = profile + 1
    }
    index = 0
    while index < PIREUS_QUOTIENT_CLASS_SLOTS {
        state = qnf_digest_add_i64(state, atlas.class_representatives[index])
        state = qnf_digest_add_i64(state, atlas.class_member_masks[index])
        state = qnf_digest_add_i64(state, atlas.class_member_counts[index])
        state = qnf_digest_add_i64(state, atlas.child_class_ids[index])
        state = qnf_digest_add_i64(state, atlas.child_representatives[index])
        state = qnf_digest_add_i64(state, atlas.witness_matrices[index])
        state = qnf_digest_add_i64(state, atlas.witness_swaps[index])
        state = qnf_digest_add_i64(state, atlas.witness_gauges[index])
        index = index + 1
    }
    index = 0
    while index < PIREUS_QUOTIENT_CLASS_DIGEST_WORDS {
        state = qnf_digest_add_i64(state, atlas.class_digest_words[index])
        index = index + 1
    }
    state = qnf_digest_add_i64(state, atlas.q0_pair_checks)
    state = qnf_digest_add_i64(state, atlas.q1_pair_checks)
    state = qnf_digest_add_i64(state, atlas.q2_action_child_checks)
    state = qnf_digest_add_i64(state, atlas.q2_target_checks)
    state = qnf_digest_add_i64(state, atlas.reflexive_checks)
    state = qnf_digest_add_i64(state, atlas.reflexive_failures)
    state = qnf_digest_add_i64(state, atlas.symmetric_checks)
    state = qnf_digest_add_i64(state, atlas.symmetric_failures)
    state = qnf_digest_add_i64(state, atlas.transitive_checks)
    state = qnf_digest_add_i64(state, atlas.transitive_failures)
    state = qnf_digest_add_i64(state, atlas.refinement_checks)
    state = qnf_digest_add_i64(state, atlas.refinement_failures)
    state = qnf_digest_add_i64(state, atlas.partition_checks)
    state = qnf_digest_add_i64(state, atlas.partition_failures)
    state = qnf_digest_add_i64(state, atlas.witness_cell_checks)
    state = qnf_digest_add_i64(state, atlas.witness_failures)
    state = qnf_digest_add_i64(state, atlas.separation_checks)
    state = qnf_digest_add_i64(state, atlas.separation_failures)
    state = qnf_digest_add_bool(state, atlas.complete)
    qnf_digest_finish(state)
}

fn qnf_digest_receipt(receipt: &PireusQuotientReceipt)
    -> PireusQuotientDigest with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = qnf_digest_add_i64(state, receipt.schema)
    state = qnf_digest_add_i64(state, receipt.producer_language)
    state = qnf_digest_add_i64(state, receipt.producer_role)
    state = qnf_digest_add_i64(state, receipt.stage)
    state = qnf_digest_add_bool(state, receipt.parent_lineage_bound)
    state = qnf_digest_add_bool(state, receipt.parent_population_recovered)
    state = qnf_digest_add_bool(
        state, receipt.declared_action_universe_complete)
    state = qnf_digest_add_bool(state, receipt.gauge_normalizer_exact)
    state = qnf_digest_add_bool(
        state, receipt.parent_gauge_stabilizer_complete)
    state = qnf_digest_add_bool(state, receipt.extensional_quotient_exact)
    state = qnf_digest_add_bool(
        state, receipt.basis_sign_gauge_quotient_exact)
    state = qnf_digest_add_bool(
        state, receipt.parent_linear_swap_gauge_quotient_exact)
    state = qnf_digest_add_bool(
        state, receipt.canonical_novelty_atlas_complete)
    state = qnf_digest_add_bool(
        state, receipt.parent_relative_operator_novelty_typed)
    state = qnf_digest_add_bool(state, receipt.no_child_selected)
    state = qnf_digest_add_bool(state, receipt.target_envelopes_unresolved)
    state = qnf_digest_add_bool(
        state, receipt.global_linear_swap_gauge_quotient_complete)
    state = qnf_digest_add_bool(
        state, receipt.nonlinear_permutation_quotient_complete)
    state = qnf_digest_add_bool(state, receipt.isotopy_quotient_complete)
    state = qnf_digest_add_bool(state, receipt.algebra_isomorphism_complete)
    state = qnf_digest_add_bool(state, receipt.relative_algebraic_novelty)
    state = qnf_digest_add_bool(state, receipt.algorithmic_novelty)
    state = qnf_digest_add_bool(state, receipt.material_novelty)
    state = qnf_digest_add_bool(state, receipt.scientific_novelty)
    state = qnf_digest_add_bool(state, receipt.global_novelty)
    state = qnf_digest_add_bool(state, receipt.historical_novelty)
    state = qnf_digest_add_bool(state, receipt.priority_claim)
    state = qnf_digest_add_bool(state, receipt.external_prior_art_complete)
    state = qnf_digest_add_bool(state, receipt.semantics_frozen)
    state = qnf_digest_add_bool(state, receipt.formal_parity_open)
    state = qnf_digest_add_bool(state, receipt.effect_parity_open)
    state = qnf_digest_add_bool(state, receipt.material_parity_open)
    state = qnf_digest_add_bool(state, receipt.target_lowering_admitted)
    state = qnf_digest_add_bool(state, receipt.target_cost_admitted)
    state = qnf_digest_add_bool(state, receipt.target_performance_admitted)
    state = qnf_digest_add_bool(state, receipt.claim_ready)
    qnf_digest_finish(state)
}

fn qnf_digest_forge(
    lineage: &PireusQuotientDigest,
    normalizer: &PireusQuotientDigest,
    actions: &PireusQuotientDigest,
    atlas: &PireusQuotientDigest,
    receipt: &PireusQuotientDigest,
) -> PireusQuotientDigest with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = qnf_digest_add_digest(state, lineage)
    state = qnf_digest_add_digest(state, normalizer)
    state = qnf_digest_add_digest(state, actions)
    state = qnf_digest_add_digest(state, atlas)
    state = qnf_digest_add_digest(state, receipt)
    qnf_digest_finish(state)
}

pub fn pireus_quotient_novelty_evaluate(
    request: &PireusQuotientRequest,
) -> PireusQuotientResult with Mut, Panic, Div, Epistemic {
    let error = qnf_request_error(request)
    let parent_request = pireus_cubic_forge_request()
    let parent_result = pireus_cubic_operator_forge_evaluate(&parent_request)
    let parent_live = pireus_cubic_operator_forge_matches_frozen_semantics(
        &parent_result)
    let lineage = qnf_build_lineage(&parent_result.forge_digest, parent_live)
    let parent = qnf_recover_parent(&parent_result.population)
    let normalizer = qnf_build_normalizer_certificate()
    let action_work = qnf_build_actions(&parent)
    let atlas_work = qnf_build_atlas(
        &parent_result.population, &parent_result.population_digest,
        &action_work)
    let receipt = qnf_build_receipt(
        &lineage, &parent, &normalizer, &action_work.certificate,
        &atlas_work.atlas)
    let negatives = qnf_exercise_negatives()
    let lineage_digest = qnf_digest_lineage(&lineage)
    let normalizer_digest = qnf_digest_normalizer(&normalizer)
    let action_digest = qnf_digest_actions(&action_work, &parent)
    let atlas_digest = qnf_digest_atlas(
        &atlas_work.atlas, &parent_result.population_digest)
    let receipt_digest = qnf_digest_receipt(&receipt)
    let forge_digest = qnf_digest_forge(
        &lineage_digest, &normalizer_digest, &action_digest,
        &atlas_digest, &receipt_digest)

    var failures: i64 = 0
    if error != PIREUS_QUOTIENT_OK { failures = failures + 1 }
    if !lineage.complete || !parent.complete || !normalizer.complete ||
        !action_work.certificate.complete || !atlas_work.atlas.complete {
        failures = failures + 1
    }
    if negatives.passed != negatives.total { failures = failures + 1 }
    if !receipt.parent_lineage_bound ||
        !receipt.parent_population_recovered ||
        !receipt.declared_action_universe_complete ||
        !receipt.gauge_normalizer_exact ||
        !receipt.parent_gauge_stabilizer_complete ||
        !receipt.extensional_quotient_exact ||
        !receipt.basis_sign_gauge_quotient_exact ||
        !receipt.parent_linear_swap_gauge_quotient_exact ||
        !receipt.canonical_novelty_atlas_complete ||
        !receipt.parent_relative_operator_novelty_typed ||
        !receipt.no_child_selected ||
        !receipt.target_envelopes_unresolved ||
        receipt.global_linear_swap_gauge_quotient_complete ||
        receipt.nonlinear_permutation_quotient_complete ||
        receipt.isotopy_quotient_complete ||
        receipt.algebra_isomorphism_complete ||
        receipt.relative_algebraic_novelty || receipt.algorithmic_novelty ||
        receipt.material_novelty || receipt.scientific_novelty ||
        receipt.global_novelty || receipt.historical_novelty ||
        receipt.priority_claim || receipt.external_prior_art_complete ||
        receipt.semantics_frozen || receipt.formal_parity_open ||
        receipt.effect_parity_open || receipt.material_parity_open ||
        receipt.target_lowering_admitted || receipt.target_cost_admitted ||
        receipt.target_performance_admitted || receipt.claim_ready {
        failures = failures + 1
    }
    if parent_result.population.target_observations != 0 ||
        parent_result.population.target_discharges != 0 ||
        parent_result.population.material_receipts != 0 ||
        parent_result.population.target_lowerings != 0 ||
        parent_result.population.target_cost_records != 0 ||
        parent_result.population.target_performance_records != 0 ||
        parent_result.population.unresolved_obligation_total !=
            PIREUS_QUOTIENT_CHILD_COUNT * PIREUS_CUBIC_FORGE_TARGET_COUNT *
                PIREUS_CUBIC_FORGE_OBLIGATION_COUNT ||
        parent_result.population.selected_child != -1 ||
        parent_result.population.ranking_present {
        failures = failures + 1
    }
    if !pireus_quotient_digest_nonzero(&lineage_digest) ||
        !pireus_quotient_digest_nonzero(&normalizer_digest) ||
        !pireus_quotient_digest_nonzero(&action_digest) ||
        !pireus_quotient_digest_nonzero(&atlas_digest) ||
        !pireus_quotient_digest_nonzero(&receipt_digest) ||
        !pireus_quotient_digest_nonzero(&forge_digest) {
        failures = failures + 1
    }

    PireusQuotientResult {
        valid: failures == 0,
        error: error,
        lineage: lineage,
        parent: parent,
        normalizer: normalizer,
        actions: action_work.certificate,
        atlas: atlas_work.atlas,
        receipt: receipt,
        negatives: negatives,
        lineage_digest: lineage_digest,
        normalizer_digest: normalizer_digest,
        action_digest: action_digest,
        atlas_digest: atlas_digest,
        receipt_digest: receipt_digest,
        forge_digest: forge_digest,
        failures: failures,
    }
}

fn qnf_digest_matches_frozen(
    digest: &PireusQuotientDigest,
    expected: &[i64; 8],
) -> bool with Mut, Panic {
    qnf_words_equal(&digest.words, expected)
}

/// Exact v5 result admitted only after matcher-free commit 5b0ace3892,
/// compact-repair commit c118ebf998, and first successful Sounio transcript
/// commit 5768d08797 existed in that order.
/// Here `exact` is always relative to the declared finite table, gauge, and
/// GL(4,2) x C2 universes; it is not a global isomorphism classification.
pub fn pireus_quotient_novelty_frozen_mismatch_code(
    result: &PireusQuotientResult,
) -> i64 with Mut, Panic, Div, Epistemic {
    if !result.valid || result.error != PIREUS_QUOTIENT_OK ||
        result.failures != 0 { return 1 }

    let parent_source = qnf_parent_source_hash()
    let parent_semantics = qnf_parent_semantics_hash()
    let parent_freeze = qnf_parent_freeze_hash()
    let parent_transcript = qnf_parent_transcript_hash()
    let parent_parity = qnf_parent_parity_hash()
    if !result.lineage.complete || !result.lineage.parent_live_match ||
        !result.lineage.parent_digest_match ||
        !result.lineage.parent_scope_match ||
        !qnf_words_equal(
            &result.lineage.parent_source_sha256, &parent_source) ||
        !qnf_words_equal(
            &result.lineage.parent_semantics_sha256, &parent_semantics) ||
        !qnf_words_equal(
            &result.lineage.parent_freeze_sha256, &parent_freeze) ||
        !qnf_words_equal(
            &result.lineage.parent_transcript_sha256, &parent_transcript) ||
        !qnf_words_equal(
            &result.lineage.parent_parity_receipt_sha256, &parent_parity) {
        return 2
    }

    let parent_request = pireus_cubic_forge_request()
    let parent_result = pireus_cubic_operator_forge_evaluate(&parent_request)
    if !pireus_cubic_operator_forge_matches_frozen_semantics(
            &parent_result) { return 3 }
    let recovered_parent = qnf_recover_parent(&parent_result.population)
    if !result.parent.complete || !recovered_parent.complete ||
        result.parent.reconstruction_checks !=
            PIREUS_QUOTIENT_CHILD_COUNT * PIREUS_QUOTIENT_CELL_COUNT ||
        result.parent.reconstruction_failures != 0 ||
        result.parent.sign_range_checks !=
            PIREUS_QUOTIENT_CHILD_COUNT * PIREUS_QUOTIENT_CELL_COUNT ||
        result.parent.sign_range_failures != 0 {
        return 4
    }
    var cell: i64 = 0
    while cell < PIREUS_QUOTIENT_CELL_COUNT {
        if result.parent.cells[cell] != recovered_parent.cells[cell] {
            return 5
        }
        cell = cell + 1
    }

    let normalizer = &result.normalizer
    if !normalizer.complete ||
        normalizer.gauge_bits != PIREUS_QUOTIENT_GAUGE_BITS ||
        normalizer.canonical_words != PIREUS_QUOTIENT_GAUGE_WORD_COUNT ||
        normalizer.pivot_checks !=
            PIREUS_QUOTIENT_GAUGE_BITS * PIREUS_QUOTIENT_GAUGE_BITS ||
        normalizer.pivot_failures != 0 ||
        normalizer.roundtrip_words != PIREUS_QUOTIENT_GAUGE_WORD_COUNT ||
        normalizer.roundtrip_cell_checks !=
            PIREUS_QUOTIENT_GAUGE_WORD_COUNT * PIREUS_QUOTIENT_CELL_COUNT ||
        normalizer.roundtrip_failures != 0 ||
        normalizer.unique_failures != 0 {
        return 6
    }

    let actions = &result.actions
    if !actions.complete ||
        actions.matrix_encodings_scanned !=
            PIREUS_QUOTIENT_MATRIX_ENCODINGS ||
        actions.invertible_matrices != PIREUS_QUOTIENT_GL4_COUNT ||
        actions.actions_considered != PIREUS_QUOTIENT_ACTION_COUNT ||
        actions.admitted_actions !=
            PIREUS_QUOTIENT_FROZEN_ADMITTED_ACTIONS ||
        actions.admitted_no_swap !=
            PIREUS_QUOTIENT_FROZEN_ADMITTED_NO_SWAP ||
        actions.admitted_swap != PIREUS_QUOTIENT_FROZEN_ADMITTED_SWAP ||
        actions.rejected_actions != PIREUS_QUOTIENT_ACTION_COUNT -
            PIREUS_QUOTIENT_FROZEN_ADMITTED_ACTIONS ||
        !actions.identity_present ||
        actions.identity_vector_checks != PIREUS_QUOTIENT_DIMENSION ||
        actions.identity_vector_failures != 0 ||
        actions.action_code_checks != actions.admitted_actions ||
        actions.action_code_failures != 0 ||
        actions.parent_cell_checks != actions.admitted_actions *
            PIREUS_QUOTIENT_CELL_COUNT ||
        actions.parent_replay_failures != 0 ||
        actions.inverse_checks != actions.admitted_actions ||
        actions.inverse_failures != 0 ||
        actions.closure_checks != actions.admitted_actions *
            actions.admitted_actions ||
        actions.closure_failures != 0 ||
        actions.composition_vector_checks != actions.admitted_actions *
            actions.admitted_actions * PIREUS_QUOTIENT_DIMENSION ||
        actions.composition_vector_failures != 0 ||
        actions.gauge_equivariance_checks != actions.admitted_actions *
            PIREUS_QUOTIENT_GAUGE_BITS * PIREUS_QUOTIENT_CELL_COUNT ||
        actions.gauge_equivariance_failures != 0 {
        return 7
    }

    let atlas = &result.atlas
    if !atlas.complete ||
        atlas.q0_pair_checks != PIREUS_QUOTIENT_RELATION_CELLS ||
        atlas.q1_pair_checks != PIREUS_QUOTIENT_RELATION_CELLS ||
        atlas.q2_action_child_checks != actions.admitted_actions *
            PIREUS_QUOTIENT_CHILD_COUNT ||
        atlas.q2_target_checks != actions.admitted_actions *
            PIREUS_QUOTIENT_RELATION_CELLS ||
        atlas.reflexive_checks != PIREUS_QUOTIENT_PROFILE_COUNT *
            PIREUS_QUOTIENT_CHILD_COUNT ||
        atlas.reflexive_failures != 0 ||
        atlas.symmetric_checks != PIREUS_QUOTIENT_ALL_RELATION_CELLS ||
        atlas.symmetric_failures != 0 ||
        atlas.transitive_failures != 0 ||
        atlas.refinement_checks !=
            2 * PIREUS_QUOTIENT_RELATION_CELLS ||
        atlas.refinement_failures != 0 ||
        atlas.partition_checks != PIREUS_QUOTIENT_PROFILE_COUNT *
            PIREUS_QUOTIENT_CHILD_COUNT ||
        atlas.partition_failures != 0 ||
        atlas.witness_cell_checks != PIREUS_QUOTIENT_PROFILE_COUNT *
            PIREUS_QUOTIENT_CHILD_COUNT * PIREUS_QUOTIENT_CELL_COUNT ||
        atlas.witness_failures != 0 || atlas.separation_failures != 0 {
        return 8
    }

    let frozen_class_counts: [i64; 3] = [
        PIREUS_QUOTIENT_FROZEN_Q0_CLASSES,
        PIREUS_QUOTIENT_FROZEN_Q1_CLASSES,
        PIREUS_QUOTIENT_FROZEN_Q2_CLASSES
    ]
    let frozen_min_sizes: [i64; 3] = [
        1, 1, PIREUS_QUOTIENT_FROZEN_Q2_MIN_CLASS_SIZE
    ]
    let frozen_max_sizes: [i64; 3] = [
        1, 1, PIREUS_QUOTIENT_FROZEN_Q2_MAX_CLASS_SIZE
    ]
    var profile: i64 = 0
    while profile < PIREUS_QUOTIENT_PROFILE_COUNT {
        if atlas.class_counts[profile] != frozen_class_counts[profile] ||
            atlas.minimum_class_sizes[profile] !=
                frozen_min_sizes[profile] ||
            atlas.maximum_class_sizes[profile] !=
                frozen_max_sizes[profile] ||
            atlas.class_size_sums[profile] != PIREUS_QUOTIENT_CHILD_COUNT {
            return 9
        }
        var child: i64 = 0
        while child < PIREUS_QUOTIENT_CHILD_COUNT {
            let slot = profile * PIREUS_QUOTIENT_CHILD_COUNT + child
            if atlas.child_class_ids[slot] < 0 ||
                atlas.child_class_ids[slot] >= atlas.class_counts[profile] ||
                atlas.child_representatives[slot] < 0 ||
                atlas.child_representatives[slot] >=
                    PIREUS_QUOTIENT_CHILD_COUNT ||
                atlas.witness_matrices[slot] <= 0 ||
                atlas.witness_swaps[slot] < 0 ||
                atlas.witness_swaps[slot] >= PIREUS_QUOTIENT_SWAP_COUNT ||
                atlas.witness_gauges[slot] < 0 ||
                atlas.witness_gauges[slot] >=
                    PIREUS_QUOTIENT_GAUGE_WORD_COUNT {
                return 10
            }
            child = child + 1
        }
        profile = profile + 1
    }

    let receipt = &result.receipt
    if receipt.schema != PIREUS_QUOTIENT_SCHEMA ||
        receipt.producer_language != PIREUS_QUOTIENT_LANGUAGE_SOUNIO ||
        receipt.producer_role !=
            PIREUS_QUOTIENT_ROLE_SEMANTIC_AUTHORITY ||
        receipt.stage != PIREUS_QUOTIENT_STAGE_SOUNIO_EXECUTABLE ||
        !receipt.parent_lineage_bound ||
        !receipt.parent_population_recovered ||
        !receipt.declared_action_universe_complete ||
        !receipt.gauge_normalizer_exact ||
        !receipt.parent_gauge_stabilizer_complete ||
        !receipt.extensional_quotient_exact ||
        !receipt.basis_sign_gauge_quotient_exact ||
        !receipt.parent_linear_swap_gauge_quotient_exact ||
        !receipt.canonical_novelty_atlas_complete ||
        !receipt.parent_relative_operator_novelty_typed ||
        !receipt.no_child_selected ||
        !receipt.target_envelopes_unresolved ||
        receipt.global_linear_swap_gauge_quotient_complete ||
        receipt.nonlinear_permutation_quotient_complete ||
        receipt.isotopy_quotient_complete ||
        receipt.algebra_isomorphism_complete ||
        receipt.relative_algebraic_novelty || receipt.algorithmic_novelty ||
        receipt.material_novelty || receipt.scientific_novelty ||
        receipt.global_novelty || receipt.historical_novelty ||
        receipt.priority_claim || receipt.external_prior_art_complete ||
        receipt.semantics_frozen || receipt.formal_parity_open ||
        receipt.effect_parity_open || receipt.material_parity_open ||
        receipt.target_lowering_admitted || receipt.target_cost_admitted ||
        receipt.target_performance_admitted || receipt.claim_ready {
        return 11
    }

    let negatives = &result.negatives
    if negatives.passed != PIREUS_QUOTIENT_FROZEN_NEGATIVE_COUNT ||
        negatives.total != PIREUS_QUOTIENT_FROZEN_NEGATIVE_COUNT ||
        !negatives.python_oracle || !negatives.rust_oracle ||
        !negatives.cpp_authority || !negatives.llm_authority ||
        !negatives.missing_parent || !negatives.unfrozen_parent ||
        !negatives.unbound_parent || !negatives.wrong_child_count ||
        !negatives.wrong_matrix_universe || !negatives.wrong_gl4_count ||
        !negatives.wrong_action_count || !negatives.wrong_gauge_bits ||
        !negatives.result_injection || !negatives.selected_child ||
        !negatives.ranking_objective || !negatives.material_without_receipt ||
        !negatives.global_quotient_promotion ||
        !negatives.nonlinear_promotion || !negatives.isotopy_promotion ||
        !negatives.isomorphism_promotion || !negatives.algebraic_promotion ||
        !negatives.algorithmic_promotion || !negatives.material_promotion ||
        !negatives.scientific_promotion || !negatives.global_promotion ||
        !negatives.historical_promotion || !negatives.priority_promotion ||
        !negatives.parity_prefreeze || !negatives.claim_ready_promotion ||
        !negatives.review_promotion || !negatives.invalid_waiver {
        return 12
    }

    let lineage_digest = qnf_digest_lineage(&result.lineage)
    let normalizer_digest = qnf_digest_normalizer(normalizer)
    let atlas_digest = qnf_digest_atlas(
        atlas, &parent_result.population_digest)
    let receipt_digest = qnf_digest_receipt(receipt)
    let forge_digest = qnf_digest_forge(
        &lineage_digest, &normalizer_digest, &result.action_digest,
        &atlas_digest, &receipt_digest)
    if !qnf_words_equal(
            &result.lineage_digest.words, &lineage_digest.words) ||
        !qnf_words_equal(
            &result.normalizer_digest.words, &normalizer_digest.words) ||
        !qnf_words_equal(&result.atlas_digest.words, &atlas_digest.words) ||
        !qnf_words_equal(
            &result.receipt_digest.words, &receipt_digest.words) ||
        !qnf_words_equal(&result.forge_digest.words, &forge_digest.words) {
        return 13
    }

    let frozen_lineage: [i64; 8] = [
        2353045307, 3441671760, 1260572420, 3002817182,
        1601212023, 1256784606, 4284279271, 4077906292
    ]
    let frozen_normalizer: [i64; 8] = [
        2603907705, 3499983655, 1746880537, 484023046,
        1588800700, 1954119001, 1668757044, 2415345554
    ]
    let frozen_actions: [i64; 8] = [
        983992381, 4176626794, 1324421970, 2851529087,
        2158847904, 3995437528, 3762320118, 1428127386
    ]
    let frozen_atlas: [i64; 8] = [
        807999905, 2157797638, 3623547937, 3734262350,
        4286413241, 2914534315, 4040656844, 2387938947
    ]
    let frozen_receipt: [i64; 8] = [
        3036597597, 3150088330, 3597224470, 1561431816,
        570066481, 2128086222, 1820752383, 1676498641
    ]
    let frozen_forge: [i64; 8] = [
        2648584313, 916204688, 4134012353, 2327810979,
        49652181, 4207906974, 958997123, 3982867233
    ]
    if !qnf_digest_matches_frozen(&result.lineage_digest, &frozen_lineage) ||
        !qnf_digest_matches_frozen(
            &result.normalizer_digest, &frozen_normalizer) ||
        !qnf_digest_matches_frozen(&result.action_digest, &frozen_actions) ||
        !qnf_digest_matches_frozen(&result.atlas_digest, &frozen_atlas) ||
        !qnf_digest_matches_frozen(&result.receipt_digest, &frozen_receipt) ||
        !qnf_digest_matches_frozen(&result.forge_digest, &frozen_forge) {
        return 14
    }
    0
}

pub fn pireus_quotient_novelty_matches_frozen_semantics(
    result: &PireusQuotientResult,
) -> bool with Mut, Panic, Div, Epistemic {
    pireus_quotient_novelty_frozen_mismatch_code(result) == 0
}
