//! Pireus v0.1 target, material-profile, and operand-role ontology.
//!
//! This extends the frozen synthetic v0 store. Reported processor features are
//! observations, not instruction-selection or cost claims.

use hardware::pireus::model::{
    pireus_v0_store,
    PIREUS_RDF_TYPE, PIREUS_CLASS_ONTOLOGY_CLASS,
    PIREUS_CLASS_CAPABILITY, PIREUS_CLASS_ARCHITECTURE,
    PIREUS_CLASS_OPERATION, PIREUS_CLASS_LANE_SCOPE,
    PIREUS_CLASS_EVIDENCE_ROLE,
    PIREUS_HAS_ARCHITECTURE, PIREUS_HAS_OPERATION,
    PIREUS_HAS_ELEMENT_BITS, PIREUS_HAS_LANES,
    PIREUS_HAS_LANE_SCOPE, PIREUS_HAS_EVIDENCE_ROLE,
    PIREUS_OP_LANE_PERMUTE, PIREUS_SCOPE_INTRACHUNK,
    PIREUS_EVIDENCE_SYNTHETIC_SOUNIO,
    PIREUS_LITERAL_1, PIREUS_LITERAL_2,
    PIREUS_LITERAL_8, PIREUS_LITERAL_16, PIREUS_LITERAL_64,
}
use ontology::query::{
    TripleStore, SparqlResult,
    triple_store_add, triple_iri, triple_literal,
    sparql_new, sparql_select, sparql_add_pattern, sparql_execute,
    triple_pattern_new, queryterm_variable, queryterm_iri,
    queryterm_literal,
}

pub const PIREUS_CLASS_TARGET: i64 = 701000
pub const PIREUS_CLASS_MACHINE: i64 = 701001
pub const PIREUS_CLASS_PROCESSOR_PROFILE: i64 = 701002
pub const PIREUS_CLASS_OPERAND_ROLE: i64 = 701003
pub const PIREUS_CLASS_ACCESS_MODE: i64 = 701004
pub const PIREUS_CLASS_REPORTED_FEATURE: i64 = 701005

pub const PIREUS_HAS_TARGET: i64 = 701100
pub const PIREUS_HAS_PROFILE: i64 = 701101
pub const PIREUS_HAS_SOCKET_COUNT: i64 = 701102
pub const PIREUS_HAS_CORES_PER_SOCKET: i64 = 701103
pub const PIREUS_HAS_THREADS_PER_CORE: i64 = 701104
pub const PIREUS_HAS_LOGICAL_CPUS: i64 = 701105
pub const PIREUS_HAS_CPU_FAMILY: i64 = 701106
pub const PIREUS_HAS_CPU_MODEL: i64 = 701107
pub const PIREUS_HAS_CPU_STEPPING: i64 = 701108
pub const PIREUS_REPORTS_FEATURE: i64 = 701109
pub const PIREUS_HAS_DATA_SOURCE_COUNT: i64 = 701110
pub const PIREUS_HAS_SELECTOR_SOURCE_COUNT: i64 = 701111
pub const PIREUS_HAS_MASK_SOURCE_COUNT: i64 = 701112
pub const PIREUS_HAS_DESTINATION_ACCESS: i64 = 701113
pub const PIREUS_HAS_OPERAND_ROLE: i64 = 701114

pub const PIREUS_TARGET_DARWIN_XEON: i64 = 701200
pub const PIREUS_TARGET_APPLE_SILICON: i64 = 701201
pub const PIREUS_TARGET_DGX_SPARK: i64 = 701202

pub const PIREUS_ARCH_X86_64: i64 = 701210
pub const PIREUS_ARCH_AARCH64: i64 = 701211
pub const PIREUS_ARCH_CUDA_SM: i64 = 701212

pub const PIREUS_EVIDENCE_DECLARED_TARGET: i64 = 701220
pub const PIREUS_EVIDENCE_OBSERVED_KERNEL: i64 = 701221

pub const PIREUS_ROLE_DATA_SOURCE: i64 = 701230
pub const PIREUS_ROLE_SELECTOR_SOURCE: i64 = 701231
pub const PIREUS_ROLE_MASK_SOURCE: i64 = 701232

pub const PIREUS_ACCESS_READ: i64 = 701240
pub const PIREUS_ACCESS_WRITE: i64 = 701241
pub const PIREUS_ACCESS_READ_WRITE: i64 = 701242

pub const PIREUS_FEATURE_AVX512F: i64 = 701250
pub const PIREUS_FEATURE_AVX512_VNNI: i64 = 701251
pub const PIREUS_FEATURE_AVX512_VBMI2: i64 = 701252
pub const PIREUS_FEATURE_AMX_TILE: i64 = 701253

pub const PIREUS_PROFILE_XEON_GOLD_6148: i64 = 701300
pub const PIREUS_PROFILE_XEON_GOLD_6262V: i64 = 701301
pub const PIREUS_PROFILE_XEON_W3_2423: i64 = 701302
pub const PIREUS_PROFILE_XEON_GOLD_6526Y: i64 = 701303
pub const PIREUS_PROFILE_XEON_6730P: i64 = 701304

pub const PIREUS_MACHINE_R740: i64 = 701310
pub const PIREUS_MACHINE_DL380: i64 = 701311
pub const PIREUS_MACHINE_5860: i64 = 701312
pub const PIREUS_MACHINE_T560: i64 = 701313
pub const PIREUS_MACHINE_R770: i64 = 701314

pub const PIREUS_CAP_F64X8_DATA1_SELECTOR1_WRITE: i64 = 701400
pub const PIREUS_CAP_F64X8_DATA2_SELECTOR1_READ_WRITE: i64 = 701401

pub const PIREUS_LITERAL_0: i64 = 701500
pub const PIREUS_LITERAL_4: i64 = 701501
pub const PIREUS_LITERAL_6: i64 = 701502
pub const PIREUS_LITERAL_7: i64 = 701503
pub const PIREUS_LITERAL_12: i64 = 701504
pub const PIREUS_LITERAL_20: i64 = 701505
pub const PIREUS_LITERAL_24: i64 = 701506
pub const PIREUS_LITERAL_32: i64 = 701507
pub const PIREUS_LITERAL_80: i64 = 701508
pub const PIREUS_LITERAL_85: i64 = 701509
pub const PIREUS_LITERAL_96: i64 = 701510
pub const PIREUS_LITERAL_128: i64 = 701511
pub const PIREUS_LITERAL_143: i64 = 701512
pub const PIREUS_LITERAL_173: i64 = 701513
pub const PIREUS_LITERAL_207: i64 = 701514

fn add_class(store: &TripleStore, class_id: i64) {
    triple_store_add(store, triple_iri(
        class_id, PIREUS_RDF_TYPE, PIREUS_CLASS_ONTOLOGY_CLASS))
}

fn add_typed(store: &TripleStore, individual: i64, class_id: i64) {
    triple_store_add(store, triple_iri(
        individual, PIREUS_RDF_TYPE, class_id))
}

fn add_target(store: &TripleStore, target: i64, architecture: i64) {
    add_typed(store, target, PIREUS_CLASS_TARGET)
    triple_store_add(store, triple_iri(
        target, PIREUS_HAS_ARCHITECTURE, architecture))
    triple_store_add(store, triple_iri(
        target, PIREUS_HAS_EVIDENCE_ROLE,
        PIREUS_EVIDENCE_DECLARED_TARGET))
}

fn add_profile(
    store: &TripleStore,
    profile: i64,
    sockets_literal: i64, sockets: f64,
    cores_literal: i64, cores_per_socket: f64,
    logical_literal: i64, logical_cpus: f64,
    model_literal: i64, cpu_model: f64,
    stepping_literal: i64, cpu_stepping: f64,
    has_vnni: bool,
    has_vbmi2: bool,
    has_amx_tile: bool,
) {
    add_typed(store, profile, PIREUS_CLASS_PROCESSOR_PROFILE)
    triple_store_add(store, triple_iri(
        profile, PIREUS_HAS_ARCHITECTURE, PIREUS_ARCH_X86_64))
    triple_store_add(store, triple_iri(
        profile, PIREUS_HAS_EVIDENCE_ROLE,
        PIREUS_EVIDENCE_OBSERVED_KERNEL))
    triple_store_add(store, triple_literal(
        profile, PIREUS_HAS_SOCKET_COUNT, sockets_literal, sockets))
    triple_store_add(store, triple_literal(
        profile, PIREUS_HAS_CORES_PER_SOCKET,
        cores_literal, cores_per_socket))
    triple_store_add(store, triple_literal(
        profile, PIREUS_HAS_THREADS_PER_CORE, PIREUS_LITERAL_2, 2.0))
    triple_store_add(store, triple_literal(
        profile, PIREUS_HAS_LOGICAL_CPUS, logical_literal, logical_cpus))
    triple_store_add(store, triple_literal(
        profile, PIREUS_HAS_CPU_FAMILY, PIREUS_LITERAL_6, 6.0))
    triple_store_add(store, triple_literal(
        profile, PIREUS_HAS_CPU_MODEL, model_literal, cpu_model))
    triple_store_add(store, triple_literal(
        profile, PIREUS_HAS_CPU_STEPPING,
        stepping_literal, cpu_stepping))
    triple_store_add(store, triple_iri(
        profile, PIREUS_REPORTS_FEATURE, PIREUS_FEATURE_AVX512F))
    if has_vnni {
        triple_store_add(store, triple_iri(
            profile, PIREUS_REPORTS_FEATURE, PIREUS_FEATURE_AVX512_VNNI))
    }
    if has_vbmi2 {
        triple_store_add(store, triple_iri(
            profile, PIREUS_REPORTS_FEATURE, PIREUS_FEATURE_AVX512_VBMI2))
    }
    if has_amx_tile {
        triple_store_add(store, triple_iri(
            profile, PIREUS_REPORTS_FEATURE, PIREUS_FEATURE_AMX_TILE))
    }
}

fn add_machine(store: &TripleStore, machine: i64, profile: i64) {
    add_typed(store, machine, PIREUS_CLASS_MACHINE)
    triple_store_add(store, triple_iri(
        machine, PIREUS_HAS_TARGET, PIREUS_TARGET_DARWIN_XEON))
    triple_store_add(store, triple_iri(
        machine, PIREUS_HAS_PROFILE, profile))
    triple_store_add(store, triple_iri(
        machine, PIREUS_HAS_EVIDENCE_ROLE,
        PIREUS_EVIDENCE_OBSERVED_KERNEL))
}

fn add_permutation_form(
    store: &TripleStore,
    capability: i64,
    data_literal: i64,
    data_sources: f64,
    destination_access: i64,
) {
    add_typed(store, capability, PIREUS_CLASS_CAPABILITY)
    triple_store_add(store, triple_iri(
        capability, PIREUS_HAS_OPERATION, PIREUS_OP_LANE_PERMUTE))
    triple_store_add(store, triple_literal(
        capability, PIREUS_HAS_ELEMENT_BITS, PIREUS_LITERAL_64, 64.0))
    triple_store_add(store, triple_literal(
        capability, PIREUS_HAS_LANES, PIREUS_LITERAL_8, 8.0))
    triple_store_add(store, triple_literal(
        capability, PIREUS_HAS_DATA_SOURCE_COUNT,
        data_literal, data_sources))
    triple_store_add(store, triple_literal(
        capability, PIREUS_HAS_SELECTOR_SOURCE_COUNT,
        PIREUS_LITERAL_1, 1.0))
    triple_store_add(store, triple_literal(
        capability, PIREUS_HAS_MASK_SOURCE_COUNT,
        PIREUS_LITERAL_0, 0.0))
    triple_store_add(store, triple_iri(
        capability, PIREUS_HAS_DESTINATION_ACCESS, destination_access))
    triple_store_add(store, triple_iri(
        capability, PIREUS_HAS_OPERAND_ROLE, PIREUS_ROLE_DATA_SOURCE))
    triple_store_add(store, triple_iri(
        capability, PIREUS_HAS_OPERAND_ROLE, PIREUS_ROLE_SELECTOR_SOURCE))
    triple_store_add(store, triple_iri(
        capability, PIREUS_HAS_LANE_SCOPE, PIREUS_SCOPE_INTRACHUNK))
    triple_store_add(store, triple_iri(
        capability, PIREUS_HAS_EVIDENCE_ROLE,
        PIREUS_EVIDENCE_SYNTHETIC_SOUNIO))
}

pub fn pireus_v01_store() -> TripleStore with Mut {
    var store = pireus_v0_store()

    add_class(&store, PIREUS_CLASS_TARGET)
    add_class(&store, PIREUS_CLASS_MACHINE)
    add_class(&store, PIREUS_CLASS_PROCESSOR_PROFILE)
    add_class(&store, PIREUS_CLASS_OPERAND_ROLE)
    add_class(&store, PIREUS_CLASS_ACCESS_MODE)
    add_class(&store, PIREUS_CLASS_REPORTED_FEATURE)

    add_typed(&store, PIREUS_ARCH_X86_64, PIREUS_CLASS_ARCHITECTURE)
    add_typed(&store, PIREUS_ARCH_AARCH64, PIREUS_CLASS_ARCHITECTURE)
    add_typed(&store, PIREUS_ARCH_CUDA_SM, PIREUS_CLASS_ARCHITECTURE)
    add_typed(&store, PIREUS_EVIDENCE_DECLARED_TARGET,
        PIREUS_CLASS_EVIDENCE_ROLE)
    add_typed(&store, PIREUS_EVIDENCE_OBSERVED_KERNEL,
        PIREUS_CLASS_EVIDENCE_ROLE)
    add_typed(&store, PIREUS_ROLE_DATA_SOURCE, PIREUS_CLASS_OPERAND_ROLE)
    add_typed(&store, PIREUS_ROLE_SELECTOR_SOURCE, PIREUS_CLASS_OPERAND_ROLE)
    add_typed(&store, PIREUS_ROLE_MASK_SOURCE, PIREUS_CLASS_OPERAND_ROLE)
    add_typed(&store, PIREUS_ACCESS_READ, PIREUS_CLASS_ACCESS_MODE)
    add_typed(&store, PIREUS_ACCESS_WRITE, PIREUS_CLASS_ACCESS_MODE)
    add_typed(&store, PIREUS_ACCESS_READ_WRITE, PIREUS_CLASS_ACCESS_MODE)
    add_typed(&store, PIREUS_FEATURE_AVX512F,
        PIREUS_CLASS_REPORTED_FEATURE)
    add_typed(&store, PIREUS_FEATURE_AVX512_VNNI,
        PIREUS_CLASS_REPORTED_FEATURE)
    add_typed(&store, PIREUS_FEATURE_AVX512_VBMI2,
        PIREUS_CLASS_REPORTED_FEATURE)
    add_typed(&store, PIREUS_FEATURE_AMX_TILE,
        PIREUS_CLASS_REPORTED_FEATURE)

    add_target(&store, PIREUS_TARGET_DARWIN_XEON, PIREUS_ARCH_X86_64)
    add_target(&store, PIREUS_TARGET_APPLE_SILICON, PIREUS_ARCH_AARCH64)
    add_target(&store, PIREUS_TARGET_DGX_SPARK, PIREUS_ARCH_CUDA_SM)

    add_profile(&store, PIREUS_PROFILE_XEON_GOLD_6148,
        PIREUS_LITERAL_2, 2.0, PIREUS_LITERAL_20, 20.0,
        PIREUS_LITERAL_80, 80.0, PIREUS_LITERAL_85, 85.0,
        PIREUS_LITERAL_4, 4.0, false, false, false)
    add_profile(&store, PIREUS_PROFILE_XEON_GOLD_6262V,
        PIREUS_LITERAL_2, 2.0, PIREUS_LITERAL_24, 24.0,
        PIREUS_LITERAL_96, 96.0, PIREUS_LITERAL_85, 85.0,
        PIREUS_LITERAL_7, 7.0, true, false, false)
    add_profile(&store, PIREUS_PROFILE_XEON_W3_2423,
        PIREUS_LITERAL_1, 1.0, PIREUS_LITERAL_6, 6.0,
        PIREUS_LITERAL_12, 12.0, PIREUS_LITERAL_143, 143.0,
        PIREUS_LITERAL_8, 8.0, true, true, true)
    add_profile(&store, PIREUS_PROFILE_XEON_GOLD_6526Y,
        PIREUS_LITERAL_2, 2.0, PIREUS_LITERAL_16, 16.0,
        PIREUS_LITERAL_64, 64.0, PIREUS_LITERAL_207, 207.0,
        PIREUS_LITERAL_2, 2.0, true, true, true)
    add_profile(&store, PIREUS_PROFILE_XEON_6730P,
        PIREUS_LITERAL_2, 2.0, PIREUS_LITERAL_32, 32.0,
        PIREUS_LITERAL_128, 128.0, PIREUS_LITERAL_173, 173.0,
        PIREUS_LITERAL_1, 1.0, true, true, true)

    add_machine(&store, PIREUS_MACHINE_R740, PIREUS_PROFILE_XEON_GOLD_6148)
    add_machine(&store, PIREUS_MACHINE_DL380, PIREUS_PROFILE_XEON_GOLD_6262V)
    add_machine(&store, PIREUS_MACHINE_5860, PIREUS_PROFILE_XEON_W3_2423)
    add_machine(&store, PIREUS_MACHINE_T560, PIREUS_PROFILE_XEON_GOLD_6526Y)
    add_machine(&store, PIREUS_MACHINE_R770, PIREUS_PROFILE_XEON_6730P)

    add_permutation_form(&store,
        PIREUS_CAP_F64X8_DATA1_SELECTOR1_WRITE,
        PIREUS_LITERAL_1, 1.0, PIREUS_ACCESS_WRITE)
    add_permutation_form(&store,
        PIREUS_CAP_F64X8_DATA2_SELECTOR1_READ_WRITE,
        PIREUS_LITERAL_2, 2.0, PIREUS_ACCESS_READ_WRITE)
    store
}

pub fn pireus_query_canonical_targets(
    store: &TripleStore,
) -> SparqlResult with Mut, Epistemic {
    var query = sparql_new()
    sparql_select(&query, 0)
    sparql_add_pattern(&query, triple_pattern_new(
        queryterm_variable(0), queryterm_iri(PIREUS_RDF_TYPE),
        queryterm_iri(PIREUS_CLASS_TARGET)))
    sparql_add_pattern(&query, triple_pattern_new(
        queryterm_variable(0), queryterm_iri(PIREUS_HAS_EVIDENCE_ROLE),
        queryterm_iri(PIREUS_EVIDENCE_DECLARED_TARGET)))
    sparql_execute(store, &query)
}

pub fn pireus_query_observed_machines(
    store: &TripleStore,
    target: i64,
    architecture: i64,
) -> SparqlResult with Mut, Epistemic {
    var query = sparql_new()
    sparql_select(&query, 0)
    sparql_add_pattern(&query, triple_pattern_new(
        queryterm_variable(0), queryterm_iri(PIREUS_RDF_TYPE),
        queryterm_iri(PIREUS_CLASS_MACHINE)))
    sparql_add_pattern(&query, triple_pattern_new(
        queryterm_variable(0), queryterm_iri(PIREUS_HAS_TARGET),
        queryterm_iri(target)))
    sparql_add_pattern(&query, triple_pattern_new(
        queryterm_variable(0), queryterm_iri(PIREUS_HAS_PROFILE),
        queryterm_variable(1)))
    sparql_add_pattern(&query, triple_pattern_new(
        queryterm_variable(1), queryterm_iri(PIREUS_HAS_ARCHITECTURE),
        queryterm_iri(architecture)))
    sparql_add_pattern(&query, triple_pattern_new(
        queryterm_variable(0), queryterm_iri(PIREUS_HAS_EVIDENCE_ROLE),
        queryterm_iri(PIREUS_EVIDENCE_OBSERVED_KERNEL)))
    sparql_execute(store, &query)
}

pub fn pireus_query_observed_feature(
    store: &TripleStore,
    feature: i64,
) -> SparqlResult with Mut, Epistemic {
    var query = sparql_new()
    sparql_select(&query, 0)
    sparql_add_pattern(&query, triple_pattern_new(
        queryterm_variable(0), queryterm_iri(PIREUS_RDF_TYPE),
        queryterm_iri(PIREUS_CLASS_MACHINE)))
    sparql_add_pattern(&query, triple_pattern_new(
        queryterm_variable(0), queryterm_iri(PIREUS_HAS_TARGET),
        queryterm_iri(PIREUS_TARGET_DARWIN_XEON)))
    sparql_add_pattern(&query, triple_pattern_new(
        queryterm_variable(0), queryterm_iri(PIREUS_HAS_PROFILE),
        queryterm_variable(1)))
    sparql_add_pattern(&query, triple_pattern_new(
        queryterm_variable(1), queryterm_iri(PIREUS_REPORTS_FEATURE),
        queryterm_iri(feature)))
    sparql_add_pattern(&query, triple_pattern_new(
        queryterm_variable(0), queryterm_iri(PIREUS_HAS_EVIDENCE_ROLE),
        queryterm_iri(PIREUS_EVIDENCE_OBSERVED_KERNEL)))
    sparql_execute(store, &query)
}

pub fn pireus_query_permutation_form(
    store: &TripleStore,
    data_literal: i64, data_sources: f64,
    selector_literal: i64, selector_sources: f64,
    mask_literal: i64, mask_sources: f64,
    destination_access: i64,
) -> SparqlResult with Mut, Epistemic {
    var query = sparql_new()
    sparql_select(&query, 0)
    sparql_add_pattern(&query, triple_pattern_new(
        queryterm_variable(0), queryterm_iri(PIREUS_RDF_TYPE),
        queryterm_iri(PIREUS_CLASS_CAPABILITY)))
    sparql_add_pattern(&query, triple_pattern_new(
        queryterm_variable(0), queryterm_iri(PIREUS_HAS_OPERATION),
        queryterm_iri(PIREUS_OP_LANE_PERMUTE)))
    sparql_add_pattern(&query, triple_pattern_new(
        queryterm_variable(0), queryterm_iri(PIREUS_HAS_ELEMENT_BITS),
        queryterm_literal(PIREUS_LITERAL_64, 64.0)))
    sparql_add_pattern(&query, triple_pattern_new(
        queryterm_variable(0), queryterm_iri(PIREUS_HAS_LANES),
        queryterm_literal(PIREUS_LITERAL_8, 8.0)))
    sparql_add_pattern(&query, triple_pattern_new(
        queryterm_variable(0), queryterm_iri(PIREUS_HAS_DATA_SOURCE_COUNT),
        queryterm_literal(data_literal, data_sources)))
    sparql_add_pattern(&query, triple_pattern_new(
        queryterm_variable(0),
        queryterm_iri(PIREUS_HAS_SELECTOR_SOURCE_COUNT),
        queryterm_literal(selector_literal, selector_sources)))
    sparql_add_pattern(&query, triple_pattern_new(
        queryterm_variable(0), queryterm_iri(PIREUS_HAS_MASK_SOURCE_COUNT),
        queryterm_literal(mask_literal, mask_sources)))
    sparql_add_pattern(&query, triple_pattern_new(
        queryterm_variable(0),
        queryterm_iri(PIREUS_HAS_DESTINATION_ACCESS),
        queryterm_iri(destination_access)))
    sparql_add_pattern(&query, triple_pattern_new(
        queryterm_variable(0), queryterm_iri(PIREUS_HAS_OPERAND_ROLE),
        queryterm_iri(PIREUS_ROLE_DATA_SOURCE)))
    sparql_add_pattern(&query, triple_pattern_new(
        queryterm_variable(0), queryterm_iri(PIREUS_HAS_OPERAND_ROLE),
        queryterm_iri(PIREUS_ROLE_SELECTOR_SOURCE)))
    sparql_add_pattern(&query, triple_pattern_new(
        queryterm_variable(0), queryterm_iri(PIREUS_HAS_LANE_SCOPE),
        queryterm_iri(PIREUS_SCOPE_INTRACHUNK)))
    sparql_add_pattern(&query, triple_pattern_new(
        queryterm_variable(0), queryterm_iri(PIREUS_HAS_EVIDENCE_ROLE),
        queryterm_iri(PIREUS_EVIDENCE_SYNTHETIC_SOUNIO)))
    sparql_execute(store, &query)
}

