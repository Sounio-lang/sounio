fn oag_digest_add_i64(state: SHA256State, value: i64) -> SHA256State
with Mut, Panic, Div, Epistemic {
    var bytes: [u8; 256] = [0; 256]
    var index: i64 = 0
    while index < 8 {
        bytes[index] = ((value >> ((7 - index) * 8)) & 255) as u8
        index = index + 1
    }
    sha256_update(state, bytes, 8)
}

fn oag_digest_add_bool(state: SHA256State, value: bool) -> SHA256State
with Mut, Panic, Div, Epistemic {
    oag_digest_add_i64(state, if value { 1 } else { 0 })
}

fn oag_digest_finish(state: SHA256State) -> PireusOagDigest
with Mut, Panic, Div, Epistemic {
    let digest = sha256_finalize(state)
    var words: [i64; 8] = [0; 8]
    var word: i64 = 0
    while word < PIREUS_OAG_WORDS {
        var value: i64 = 0
        var byte: i64 = 0
        while byte < 4 {
            value = (value << 8) |
                sha256_digest_byte(&digest, (word * 4 + byte) as i32)
            byte = byte + 1
        }
        words[word] = value
        word = word + 1
    }
    PireusOagDigest { words: words }
}

fn oag_hash_equal(left: &[i64; 8], right: &[i64; 8]) -> bool
with Mut, Panic {
    var word: i64 = 0
    while word < PIREUS_OAG_WORDS {
        if left[word] != right[word] { return false }
        word = word + 1
    }
    true
}

fn oag_digest_equal(
    left: &PireusOagDigest,
    right: &PireusOagDigest,
) -> bool with Mut, Panic {
    oag_hash_equal(&left.words, &right.words)
}

fn oag_text_sha256_matches(raw: string, expected: &[i64; 8]) -> bool
with Mut, Panic, Div, Epistemic {
    let size = str_len(raw)
    var state = sha256_init()
    var pos: i64 = 0
    while pos < size {
        var window: [u8; 256] = [0; 256]
        var count = size - pos
        if count > 256 { count = 256 }
        var i: i64 = 0
        while i < count {
            var byte = str_char_at(raw, pos + i) as i64
            if byte < 0 { byte = byte + 256 }
            window[i] = byte as u8
            i = i + 1
        }
        state = sha256_update(state, window, count as i32)
        pos = pos + count
    }
    let digest = oag_digest_finish(state)
    oag_hash_equal(&digest.words, expected)
}

fn oag_span_eq(
    raw: string, start: i64, end: i64, expected: string,
) -> bool with Mut, Panic {
    let expected_len = str_len(expected)
    if end - start != expected_len { return false }
    var i: i64 = 0
    while i < expected_len {
        if str_char_at(raw, start + i) != str_char_at(expected, i) {
            return false
        }
        i = i + 1
    }
    true
}

fn oag_span_has_prefix(
    raw: string, start: i64, end: i64, prefix: string,
) -> bool with Mut, Panic {
    let prefix_len = str_len(prefix)
    if end - start < prefix_len { return false }
    var i: i64 = 0
    while i < prefix_len {
        if str_char_at(raw, start + i) != str_char_at(prefix, i) {
            return false
        }
        i = i + 1
    }
    true
}

fn oag_parse_uint(raw: string, start: i64, end: i64) -> i64
with Mut, Panic {
    if start >= end { return -1 }
    var value: i64 = 0
    var pos = start
    while pos < end {
        let code = str_char_at(raw, pos)
        if code < 48 || code > 57 { return -1 }
        value = value * 10 + (code - 48)
        pos = pos + 1
    }
    value
}

fn oag_parse_prefixed_uint(
    raw: string, start: i64, end: i64, prefix: string,
) -> i64 with Mut, Panic {
    if !oag_span_has_prefix(raw, start, end, prefix) { return -1 }
    oag_parse_uint(raw, start + str_len(prefix), end)
}

fn oag_parse_field_uint(
    raw: string, start: i64, end: i64, field: string,
) -> i64 with Mut, Panic {
    let field_len = str_len(field)
    var pos = start
    while pos + field_len <= end {
        var matches = true
        var i: i64 = 0
        while i < field_len {
            if str_char_at(raw, pos + i) != str_char_at(field, i) {
                matches = false
            }
            i = i + 1
        }
        if matches {
            var value_end = pos + field_len
            while value_end < end {
                let code = str_char_at(raw, value_end)
                if code < 48 || code > 57 { break }
                value_end = value_end + 1
            }
            return oag_parse_uint(raw, pos + field_len, value_end)
        }
        pos = pos + 1
    }
    -1
}

fn oag_line_count(raw: string, expected: string) -> i64
with Mut, Panic {
    let size = str_len(raw)
    var count: i64 = 0
    var start: i64 = 0
    while start < size {
        var end = start
        while end < size && str_char_at(raw, end) != 10 { end = end + 1 }
        var line_end = end
        if line_end > start && str_char_at(raw, line_end - 1) == 13 {
            line_end = line_end - 1
        }
        if oag_span_eq(raw, start, line_end, expected) { count = count + 1 }
        start = end + 1
    }
    count
}

fn oag_word_bit(words: &[i64; 8], cell: i64) -> i64
with Panic, Div {
    let word = cell / PIREUS_OAG_WORD_BITS
    let bit = cell - word * PIREUS_OAG_WORD_BITS
    (words[word] >> bit) & 1
}

fn oag_coefficient(bit: i64) -> i64 {
    if bit == 0 { 1 } else if bit == 1 { -1 } else { 0 }
}

fn oag_parse_parent_transcript(raw: string) -> PireusOagParentTranscript
with Mut, Panic, Div {
    var words: [i64; 8] = [0; 8]
    var cells: [i64; 256] = [0; 256]
    var seen: [i64; 256] = [0; 256]
    var word_count: i64 = 0
    var cell_count: i64 = 0
    var duplicate_cells: i64 = 0
    var parse_failures: i64 = 0
    var seed_weight: i64 = -1
    var word_block = false
    var pending_cell: i64 = -1
    var pending_left: i64 = -1
    var pending_right: i64 = -1
    let size = str_len(raw)
    var start: i64 = 0
    while start < size {
        var end = start
        while end < size && str_char_at(raw, end) != 10 { end = end + 1 }
        var line_end = end
        if line_end > start && str_char_at(raw, line_end - 1) == 13 {
            line_end = line_end - 1
        }
        if oag_span_has_prefix(raw, start, line_end,
            "PIREUS_OSK_SEED words=") {
            let value = oag_parse_prefixed_uint(
                raw, start, line_end, "PIREUS_OSK_SEED words=")
            if value < 0 || word_count != 0 { parse_failures = parse_failures + 1 }
            else { words[0] = value; word_count = 1; word_block = true }
        } else if word_block && oag_span_has_prefix(raw, start, line_end, ":") {
            let value = oag_parse_prefixed_uint(raw, start, line_end, ":")
            if value < 0 || word_count >= PIREUS_OAG_WORDS {
                parse_failures = parse_failures + 1
            } else {
                words[word_count] = value
                word_count = word_count + 1
                if word_count == PIREUS_OAG_WORDS { word_block = false }
            }
        } else if oag_span_has_prefix(raw, start, line_end, " weight=") {
            seed_weight = oag_parse_prefixed_uint(raw, start, line_end, " weight=")
            if seed_weight < 0 { parse_failures = parse_failures + 1 }
        } else if oag_span_has_prefix(raw, start, line_end,
            "PIREUS_OSK_SEED_CELL id=") {
            if pending_cell >= 0 { parse_failures = parse_failures + 1 }
            pending_cell = oag_parse_field_uint(raw, start, line_end, "id=")
            pending_left = -1
            pending_right = -1
        } else if pending_cell >= 0 &&
            oag_span_has_prefix(raw, start, line_end, " left=") {
            pending_left = oag_parse_prefixed_uint(
                raw, start, line_end, " left=")
        } else if pending_cell >= 0 &&
            oag_span_has_prefix(raw, start, line_end, " right=") {
            pending_right = oag_parse_prefixed_uint(
                raw, start, line_end, " right=")
        } else if pending_cell >= 0 &&
            oag_span_has_prefix(raw, start, line_end, " bit=") {
            let bit = oag_parse_field_uint(raw, start, line_end, "bit=")
            if pending_cell < 0 || pending_cell >= PIREUS_OAG_CELLS ||
                pending_left != pending_cell / PIREUS_OAG_LANES ||
                pending_right != pending_cell -
                    (pending_cell / PIREUS_OAG_LANES) * PIREUS_OAG_LANES ||
                (bit != 0 && bit != 1) {
                parse_failures = parse_failures + 1
            } else if seen[pending_cell] != 0 {
                duplicate_cells = duplicate_cells + 1
            } else {
                seen[pending_cell] = 1
                cells[pending_cell] = bit
                cell_count = cell_count + 1
            }
            pending_cell = -1
            pending_left = -1
            pending_right = -1
        }
        start = end + 1
    }
    if word_block || pending_cell >= 0 { parse_failures = parse_failures + 1 }
    let result_valid =
        oag_line_count(raw, "PIREUS_OSK_RESULT valid=1") == 1 &&
        oag_line_count(raw, " error=0") == 1 &&
        oag_line_count(raw, " failure_groups=0") == 1 &&
        oag_line_count(raw, " claim_ready=0") >= 1
    let frozen_match =
        oag_line_count(raw, "PIREUS_OSK_FROZEN match=1") == 1 &&
        oag_line_count(raw, " mismatch_code=0") == 1
    var weight: i64 = 0
    var replay_failures: i64 = 0
    var cell: i64 = 0
    while cell < PIREUS_OAG_CELLS {
        weight = weight + cells[cell]
        if cells[cell] != oag_word_bit(&words, cell) {
            replay_failures = replay_failures + 1
        }
        cell = cell + 1
    }
    let complete = word_count == PIREUS_OAG_WORDS &&
        cell_count == PIREUS_OAG_CELLS && duplicate_cells == 0 &&
        parse_failures == 0 && seed_weight > 0 && weight == seed_weight &&
        replay_failures == 0 && result_valid && frozen_match
    PireusOagParentTranscript {
        seed_words: words,
        seed_cells: cells,
        seed_weight: seed_weight,
        word_count: word_count,
        cell_count: cell_count,
        duplicate_cells: duplicate_cells,
        parse_failures: parse_failures + replay_failures,
        result_valid: result_valid,
        frozen_match: frozen_match,
        complete: complete,
    }
}

pub fn pireus_operator_autogenesis_request() -> PireusOagRequest {
    PireusOagRequest {
        producer_language: PIREUS_ONF_LANGUAGE_SOUNIO,
        producer_role: PIREUS_ONF_ROLE_SEMANTIC_AUTHORITY,
        stage: PIREUS_OAG_STAGE_EXECUTABLE,
        policy_present: true,
        parent_present: true,
        parent_frozen: true,
        parent_source_bound: true,
        parent_semantics_bound: true,
        parent_freeze_bound: true,
        parent_process_evidence_present: true,
        recursive_parent_evaluation_requested: false,
        prefilled_parent_seed_present: false,
        enable_residual_twist: true,
        enable_affine_address: true,
        enable_coefficient_lift: true,
        enable_left_arity_lift: true,
        enable_right_arity_lift: true,
        enable_reduction_tree: true,
        identity_equivalence_declared: true,
        nonlinear_candidate_present: false,
        finite_value_carrier_present: false,
        complete_function_certificate_present: false,
        expected_frontier_size_present: false,
        expected_admitted_genome_present: false,
        expected_rejected_genome_present: false,
        expected_class_count_present: false,
        expected_representative_present: false,
        expected_truth_table_present: false,
        expected_digest_present: false,
        expected_invariant_present: false,
        expected_transcript_present: false,
        target_instruction_present: false,
        target_cost_present: false,
        target_performance_present: false,
        semantic_write_from_parity: false,
        expected_result_write_from_parity: false,
        review_promoted_to_authority: false,
        historical_novelty_requested: false,
        priority_requested: false,
        claim_ready_requested: false,
        founder_waiver_present: false,
    }
}

pub fn pireus_operator_autogenesis_parent_paths() -> PireusOagParentPaths {
    PireusOagParentPaths {
        parent_source: "stdlib/hardware/pireus/operator_seed_kernel.sio",
        parent_freeze_receipt: "tools/pireus/operator_seed_kernel.freeze.v8",
        parent_frozen_evidence:
            "tools/pireus/evidence/operator_seed_kernel_v8.frozen.txt",
    }
}

fn oag_request_error(request: &PireusOagRequest) -> i64 {
    if request.producer_language != PIREUS_ONF_LANGUAGE_SOUNIO ||
        request.producer_role != PIREUS_ONF_ROLE_SEMANTIC_AUTHORITY {
        return PIREUS_OAG_ERR_AUTHORITY
    }
    if request.stage != PIREUS_OAG_STAGE_EXECUTABLE {
        return PIREUS_OAG_ERR_STAGE
    }
    if !request.policy_present { return PIREUS_OAG_ERR_POLICY }
    if !request.parent_present || !request.parent_frozen ||
        !request.parent_source_bound || !request.parent_semantics_bound ||
        !request.parent_freeze_bound ||
        !request.parent_process_evidence_present ||
        request.recursive_parent_evaluation_requested ||
        request.prefilled_parent_seed_present {
        return PIREUS_OAG_ERR_LINEAGE
    }
    if !request.identity_equivalence_declared {
        return PIREUS_OAG_ERR_GENOME
    }
    if request.nonlinear_candidate_present &&
        (!request.finite_value_carrier_present ||
         !request.complete_function_certificate_present) {
        return PIREUS_OAG_ERR_NONLINEAR_CERTIFICATE
    }
    if request.expected_frontier_size_present ||
        request.expected_admitted_genome_present ||
        request.expected_rejected_genome_present ||
        request.expected_class_count_present ||
        request.expected_representative_present ||
        request.expected_truth_table_present ||
        request.expected_digest_present ||
        request.expected_invariant_present ||
        request.expected_transcript_present {
        return PIREUS_OAG_ERR_RESULT_INJECTION
    }
    if request.target_instruction_present || request.target_cost_present ||
        request.target_performance_present {
        return PIREUS_OAG_ERR_MATERIAL
    }
    if request.semantic_write_from_parity ||
        request.expected_result_write_from_parity ||
        request.review_promoted_to_authority {
        return PIREUS_OAG_ERR_AUTHORITY
    }
    if request.historical_novelty_requested || request.priority_requested ||
        request.claim_ready_requested {
        return PIREUS_OAG_ERR_CLAIM
    }
    if request.founder_waiver_present { return PIREUS_OAG_ERR_WAIVER }
    PIREUS_OAG_OK
}

fn oag_invalid_admission() -> PireusOagAdmission {
    PireusOagAdmission {
        lineage: PireusOagLineage {
            source_file_match: false,
            semantics_receipt_match: false,
            freeze_file_match: false,
            evidence_file_match: false,
            parent_result_valid: false,
            parent_frozen_match: false,
            seed_word_checks: 0,
            seed_cell_checks: 0,
            seed_failures: 1,
            seed_weight: 0,
            recursive_parent_evaluation_used: false,
            complete: false,
        },
        seed_words: [0; 8],
        seed_cells: [0; 256],
    }
}

fn oag_build_admission(paths: &PireusOagParentPaths) -> PireusOagAdmission
with IO, Mut, Panic, Div, Alloc, Epistemic {
    let source_size = file_size(paths.parent_source)
    let freeze_size = file_size(paths.parent_freeze_receipt)
    let evidence_size = file_size(paths.parent_frozen_evidence)
    if source_size <= 0 || source_size >= 1048576 ||
        freeze_size <= 0 || freeze_size >= 1048576 ||
        evidence_size <= 0 || evidence_size >= 1048576 {
        return oag_invalid_admission()
    }
    let source_raw = read_file(paths.parent_source)
    let freeze_raw = read_file(paths.parent_freeze_receipt)
    let evidence_raw = read_file(paths.parent_frozen_evidence)
    let expected_source = oag_parent_source_hash()
    let expected_freeze = oag_parent_freeze_hash()
    let expected_evidence = oag_parent_evidence_hash()
    let source_match = oag_text_sha256_matches(source_raw, &expected_source)
    let freeze_match = oag_text_sha256_matches(freeze_raw, &expected_freeze)
    let evidence_match = oag_text_sha256_matches(
        evidence_raw, &expected_evidence)
    let semantics_match = oag_line_count(freeze_raw,
        "semantics_sha256=db63ada1b919dbf869bf3e74163a64acaf7c6d2ec496fb964b6ca0c689c5f508") == 1
    let transcript = oag_parse_parent_transcript(evidence_raw)
    let complete = source_match && freeze_match && evidence_match &&
        semantics_match && transcript.complete
    PireusOagAdmission {
        lineage: PireusOagLineage {
            source_file_match: source_match,
            semantics_receipt_match: semantics_match,
            freeze_file_match: freeze_match,
            evidence_file_match: evidence_match,
            parent_result_valid: transcript.result_valid,
            parent_frozen_match: transcript.frozen_match,
            seed_word_checks: transcript.word_count,
            seed_cell_checks: transcript.cell_count,
            seed_failures: transcript.parse_failures +
                transcript.duplicate_cells,
            seed_weight: transcript.seed_weight,
            recursive_parent_evaluation_used: false,
            complete: complete,
        },
        seed_words: transcript.seed_words,
        seed_cells: transcript.seed_cells,
    }
}

fn oag_parent_basis_coefficient(
    seed: &[i64; 256], left: i64, right: i64,
) -> i64 with Panic {
    oag_coefficient(seed[left * PIREUS_OAG_LANES + right])
}

fn oag_build_residual(seed: &[i64; 256]) -> PireusOagResidual
with Mut, Panic, Div, Epistemic {
    var pair_counts: [i64; 256] = [0; 256]
    var pair_bits: [i64; 256] = [0; 256]
    var associator_failures: i64 = 0
    var commutator_failures: i64 = 0
    var first_i: i64 = -1
    var first_j: i64 = -1
    var first_k: i64 = -1
    var state = sha256_init()
    var i: i64 = 0
    while i < PIREUS_OAG_LANES {
        var j: i64 = 0
        while j < PIREUS_OAG_LANES {
            let cij = oag_parent_basis_coefficient(seed, i, j)
            let cji = oag_parent_basis_coefficient(seed, j, i)
            if cij != cji { commutator_failures = commutator_failures + 1 }
            var k: i64 = 0
            while k < PIREUS_OAG_LANES {
                let left = cij * oag_parent_basis_coefficient(seed, i ^ j, k)
                let right = oag_parent_basis_coefficient(seed, j, k) *
                    oag_parent_basis_coefficient(seed, i, j ^ k)
                let residual = if left == right { 0 } else { 1 }
                if residual != 0 {
                    associator_failures = associator_failures + 1
                    pair_counts[i * PIREUS_OAG_LANES + j] =
                        pair_counts[i * PIREUS_OAG_LANES + j] + 1
                    if first_i < 0 {
                        first_i = i
                        first_j = j
                        first_k = k
                    }
                }
                state = oag_digest_add_i64(state, i)
                state = oag_digest_add_i64(state, j)
                state = oag_digest_add_i64(state, k)
                state = oag_digest_add_i64(state, left)
                state = oag_digest_add_i64(state, right)
                state = oag_digest_add_i64(state, residual)
                k = k + 1
            }
            j = j + 1
        }
        i = i + 1
    }
    var cell: i64 = 0
    while cell < PIREUS_OAG_CELLS {
        pair_bits[cell] = pair_counts[cell] & 1
        state = oag_digest_add_i64(state, pair_counts[cell])
        state = oag_digest_add_i64(state, pair_bits[cell])
        cell = cell + 1
    }
    PireusOagResidual {
        associator_failures: associator_failures,
        commutator_failures: commutator_failures,
        first_i: first_i,
        first_j: first_j,
        first_k: first_k,
        pair_counts: pair_counts,
        pair_bits: pair_bits,
        digest: oag_digest_finish(state),
        complete: first_i >= 0 && associator_failures > 0,
    }
}

fn oag_rotl4(value: i64) -> i64 {
    ((value << 1) & 15) | ((value >> 3) & 1)
}

fn oag_genome_for_slot(
    slot: i64,
    residual: &PireusOagResidual,
) -> PireusOagOperatorGenome with Panic {
    let arity = if slot >= PIREUS_OAG_OPCODE_LEFT_ARITY_LIFT {
        PIREUS_OAG_ARITY_TERNARY
    } else { PIREUS_OAG_ARITY_BILINEAR }
    let address_program = if slot == PIREUS_OAG_OPCODE_AFFINE_ADDRESS {
        PIREUS_OAG_ADDRESS_AFFINE_F2_4
    } else { PIREUS_OAG_ADDRESS_XOR }
    let coefficient_program =
        if slot == PIREUS_OAG_OPCODE_RESIDUAL_TWIST {
            PIREUS_OAG_COEFFICIENT_RESIDUAL_TWIST
        } else if slot == PIREUS_OAG_OPCODE_COEFFICIENT_LIFT {
            PIREUS_OAG_COEFFICIENT_RESIDUAL_LIFT
        } else { PIREUS_OAG_COEFFICIENT_PARENT_SIGN }
    let reduction_program =
        if slot == PIREUS_OAG_OPCODE_LEFT_ARITY_LIFT {
            PIREUS_OAG_REDUCTION_LEFT
        } else if slot == PIREUS_OAG_OPCODE_RIGHT_ARITY_LIFT {
            PIREUS_OAG_REDUCTION_RIGHT
        } else if slot == PIREUS_OAG_OPCODE_REDUCTION_TREE {
            PIREUS_OAG_REDUCTION_LEFT_EXPLICIT_TREE
        } else { PIREUS_OAG_REDUCTION_DIRECT }
    PireusOagOperatorGenome {
        id: slot,
        parent_id: 8,
        mutation_id: slot,
        arity: arity,
        value_carrier: PIREUS_OAG_CARRIER_Z_POWER_16,
        operator_type: PIREUS_OAG_OPERATOR_MULTILINEAR,
        linear_slot_0: true,
        linear_slot_1: true,
        linear_slot_2: arity == PIREUS_OAG_ARITY_TERNARY,
        address_space_bits: PIREUS_OAG_BITS,
        address_program: address_program,
        address_a: if slot == PIREUS_OAG_OPCODE_AFFINE_ADDRESS { 2 } else { 1 },
        address_b: 1,
        address_c: if slot == PIREUS_OAG_OPCODE_AFFINE_ADDRESS {
            residual.first_k
        } else { 0 },
        coefficient_program: coefficient_program,
        reduction_program: reduction_program,
        parenthesization_program: reduction_program,
        equivalence_contract: PIREUS_OAG_EQ_IDENTITY,
        preserved_multilinearity: true,
        intentionally_unpreserved_associativity: true,
        evidence_stage: PIREUS_OAG_STAGE_EXECUTABLE,
    }
}

fn oag_slot_enabled(request: &PireusOagRequest, slot: i64) -> bool {
    if slot == PIREUS_OAG_OPCODE_PARENT { return true }
    if slot == PIREUS_OAG_OPCODE_RESIDUAL_TWIST {
        return request.enable_residual_twist
    }
    if slot == PIREUS_OAG_OPCODE_AFFINE_ADDRESS {
        return request.enable_affine_address
    }
    if slot == PIREUS_OAG_OPCODE_COEFFICIENT_LIFT {
        return request.enable_coefficient_lift
    }
    if slot == PIREUS_OAG_OPCODE_LEFT_ARITY_LIFT {
        return request.enable_left_arity_lift
    }
    if slot == PIREUS_OAG_OPCODE_RIGHT_ARITY_LIFT {
        return request.enable_right_arity_lift
    }
    if slot == PIREUS_OAG_OPCODE_REDUCTION_TREE {
        return request.enable_reduction_tree
    }
    false
}

fn oag_opcode_valid(opcode: i64) -> bool {
    opcode >= PIREUS_OAG_OPCODE_PARENT &&
        opcode <= PIREUS_OAG_OPCODE_REDUCTION_TREE
}

fn oag_apply_address_a(code: i64, value: i64) -> i64 {
    if code == 1 { value }
    else if code == 2 { oag_rotl4(value) }
    else { -1 }
}

fn oag_affine_address(genome: &PireusOagOperatorGenome, i: i64, j: i64) -> i64 {
    if genome.address_program == PIREUS_OAG_ADDRESS_AFFINE_F2_4 {
        oag_apply_address_a(genome.address_a, i) ^
            oag_apply_address_a(genome.address_b, j) ^ genome.address_c
    } else {
        i ^ j
    }
}

fn oag_genome_coefficient(
    genome: &PireusOagOperatorGenome,
    seed: &[i64; 256],
    residual: &PireusOagResidual,
    i: i64,
    j: i64,
) -> i64 with Panic {
    let cell = i * PIREUS_OAG_LANES + j
    let parent_bit = seed[cell]
    if genome.coefficient_program ==
        PIREUS_OAG_COEFFICIENT_RESIDUAL_TWIST {
        oag_coefficient(parent_bit ^ residual.pair_bits[cell])
    } else if genome.coefficient_program ==
        PIREUS_OAG_COEFFICIENT_RESIDUAL_LIFT {
        oag_coefficient(parent_bit) * (1 + residual.pair_counts[cell])
    } else {
        oag_coefficient(parent_bit)
    }
}

pub fn pireus_oag_validate_genome(genome: &PireusOagOperatorGenome) -> i64
with Mut {
    if !oag_opcode_valid(genome.mutation_id) { return PIREUS_OAG_ERR_OPCODE }
    if genome.arity != PIREUS_OAG_ARITY_BILINEAR &&
        genome.arity != PIREUS_OAG_ARITY_TERNARY {
        return PIREUS_OAG_ERR_GENOME
    }
    if genome.value_carrier != PIREUS_OAG_CARRIER_Z_POWER_16 ||
        genome.operator_type != PIREUS_OAG_OPERATOR_MULTILINEAR ||
        !genome.linear_slot_0 || !genome.linear_slot_1 ||
        (genome.arity == PIREUS_OAG_ARITY_TERNARY && !genome.linear_slot_2) ||
        !genome.preserved_multilinearity {
        return PIREUS_OAG_ERR_NONLINEAR_CERTIFICATE
    }
    if genome.address_space_bits != PIREUS_OAG_BITS ||
        (genome.address_program != PIREUS_OAG_ADDRESS_XOR &&
         genome.address_program != PIREUS_OAG_ADDRESS_AFFINE_F2_4) ||
        (genome.address_a != 1 && genome.address_a != 2) ||
        genome.address_b != 1 ||
        genome.equivalence_contract != PIREUS_OAG_EQ_IDENTITY ||
        genome.evidence_stage != PIREUS_OAG_STAGE_EXECUTABLE {
        return PIREUS_OAG_ERR_GENOME
    }
    if genome.mutation_id == PIREUS_OAG_OPCODE_PARENT &&
        (genome.arity != PIREUS_OAG_ARITY_BILINEAR ||
         genome.address_program != PIREUS_OAG_ADDRESS_XOR ||
         genome.address_a != 1 ||
         genome.coefficient_program != PIREUS_OAG_COEFFICIENT_PARENT_SIGN ||
         genome.reduction_program != PIREUS_OAG_REDUCTION_DIRECT) {
        return PIREUS_OAG_ERR_GENOME
    }
    if genome.mutation_id == PIREUS_OAG_OPCODE_RESIDUAL_TWIST &&
        (genome.arity != PIREUS_OAG_ARITY_BILINEAR ||
         genome.address_program != PIREUS_OAG_ADDRESS_XOR ||
         genome.coefficient_program !=
            PIREUS_OAG_COEFFICIENT_RESIDUAL_TWIST ||
         genome.reduction_program != PIREUS_OAG_REDUCTION_DIRECT) {
        return PIREUS_OAG_ERR_GENOME
    }
    if genome.mutation_id == PIREUS_OAG_OPCODE_AFFINE_ADDRESS &&
        (genome.arity != PIREUS_OAG_ARITY_BILINEAR ||
         genome.address_program != PIREUS_OAG_ADDRESS_AFFINE_F2_4 ||
         genome.address_a != 2 ||
         genome.coefficient_program != PIREUS_OAG_COEFFICIENT_PARENT_SIGN ||
         genome.reduction_program != PIREUS_OAG_REDUCTION_DIRECT) {
        return PIREUS_OAG_ERR_GENOME
    }
    if genome.mutation_id == PIREUS_OAG_OPCODE_COEFFICIENT_LIFT &&
        (genome.arity != PIREUS_OAG_ARITY_BILINEAR ||
         genome.address_program != PIREUS_OAG_ADDRESS_XOR ||
         genome.coefficient_program !=
            PIREUS_OAG_COEFFICIENT_RESIDUAL_LIFT ||
         genome.reduction_program != PIREUS_OAG_REDUCTION_DIRECT) {
        return PIREUS_OAG_ERR_GENOME
    }
    if genome.mutation_id == PIREUS_OAG_OPCODE_LEFT_ARITY_LIFT &&
        (genome.arity != PIREUS_OAG_ARITY_TERNARY ||
         genome.address_program != PIREUS_OAG_ADDRESS_XOR ||
         genome.coefficient_program != PIREUS_OAG_COEFFICIENT_PARENT_SIGN ||
         genome.reduction_program != PIREUS_OAG_REDUCTION_LEFT) {
        return PIREUS_OAG_ERR_GENOME
    }
    if genome.mutation_id == PIREUS_OAG_OPCODE_RIGHT_ARITY_LIFT &&
        (genome.arity != PIREUS_OAG_ARITY_TERNARY ||
         genome.address_program != PIREUS_OAG_ADDRESS_XOR ||
         genome.coefficient_program != PIREUS_OAG_COEFFICIENT_PARENT_SIGN ||
         genome.reduction_program != PIREUS_OAG_REDUCTION_RIGHT) {
        return PIREUS_OAG_ERR_GENOME
    }
    // Three inputs have only the already-declared left and right binary trees.
    if genome.mutation_id == PIREUS_OAG_OPCODE_REDUCTION_TREE {
        return PIREUS_OAG_ERR_GENOME
    }
    PIREUS_OAG_OK
}

fn oag_address_certificate(genome: &PireusOagOperatorGenome) -> i64
with Mut, Panic {
    if genome.arity != PIREUS_OAG_ARITY_BILINEAR { return 0 }
    var pair_seen: [i64; 256] = [0; 256]
    var destination_counts: [i64; 16] = [0; 16]
    var failures: i64 = 0
    var destination: i64 = 0
    while destination < PIREUS_OAG_LANES {
        var i: i64 = 0
        while i < PIREUS_OAG_LANES {
            let j = if genome.address_program ==
                PIREUS_OAG_ADDRESS_AFFINE_F2_4 {
                oag_apply_address_a(genome.address_a, i) ^
                    destination ^ genome.address_c
            } else { i ^ destination }
            if j < 0 || j >= PIREUS_OAG_LANES {
                failures = failures + 1
            } else {
                let pair = i * PIREUS_OAG_LANES + j
                pair_seen[pair] = pair_seen[pair] + 1
                destination_counts[destination] =
                    destination_counts[destination] + 1
                if oag_affine_address(genome, i, j) != destination {
                    failures = failures + 1
                }
            }
            i = i + 1
        }
        destination = destination + 1
    }
    var pair: i64 = 0
    while pair < PIREUS_OAG_CELLS {
        if pair_seen[pair] != 1 { failures = failures + 1 }
        pair = pair + 1
    }
    destination = 0
    while destination < PIREUS_OAG_LANES {
        if destination_counts[destination] != PIREUS_OAG_LANES {
            failures = failures + 1
        }
        destination = destination + 1
    }
    failures
}

fn oag_digest_genome(
    genome: &PireusOagOperatorGenome,
    residual: &PireusOagResidual,
) -> PireusOagDigest with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = oag_digest_add_i64(state, PIREUS_OAG_SCHEMA)
    state = oag_digest_add_i64(state, genome.id)
    state = oag_digest_add_i64(state, genome.parent_id)
    state = oag_digest_add_i64(state, genome.mutation_id)
    state = oag_digest_add_i64(state, genome.arity)
    state = oag_digest_add_i64(state, genome.value_carrier)
    state = oag_digest_add_i64(state, genome.operator_type)
    state = oag_digest_add_bool(state, genome.linear_slot_0)
    state = oag_digest_add_bool(state, genome.linear_slot_1)
    state = oag_digest_add_bool(state, genome.linear_slot_2)
    state = oag_digest_add_i64(state, genome.address_space_bits)
    state = oag_digest_add_i64(state, genome.address_program)
    state = oag_digest_add_i64(state, genome.address_a)
    state = oag_digest_add_i64(state, genome.address_b)
    state = oag_digest_add_i64(state, genome.address_c)
    state = oag_digest_add_i64(state, genome.coefficient_program)
    state = oag_digest_add_i64(state, genome.reduction_program)
    state = oag_digest_add_i64(state, genome.parenthesization_program)
    state = oag_digest_add_i64(state, genome.equivalence_contract)
    state = oag_digest_add_bool(state, genome.preserved_multilinearity)
    state = oag_digest_add_bool(
        state, genome.intentionally_unpreserved_associativity)
    var word: i64 = 0
    while word < PIREUS_OAG_WORDS {
        state = oag_digest_add_i64(state, residual.digest.words[word])
        word = word + 1
    }
    oag_digest_finish(state)
}

fn oag_mutation_witness(
    genome: &PireusOagOperatorGenome,
    residual: &PireusOagResidual,
) -> PireusOagMutationWitness with Mut, Panic {
    let reconstruction_checks = if genome.arity == PIREUS_OAG_ARITY_BILINEAR {
        PIREUS_OAG_CELLS
    } else { PIREUS_OAG_TERNARY_BASIS }
    let genome_error = pireus_oag_validate_genome(genome)
    let residual_required =
        genome.mutation_id == PIREUS_OAG_OPCODE_RESIDUAL_TWIST ||
        genome.mutation_id == PIREUS_OAG_OPCODE_COEFFICIENT_LIFT ||
        genome.mutation_id == PIREUS_OAG_OPCODE_AFFINE_ADDRESS
    let residual_failure = if residual_required && !residual.complete {
        1
    } else { 0 }
    let failures = (if genome_error == PIREUS_OAG_OK { 0 } else { 1 }) +
        residual_failure + oag_address_certificate(genome)
    PireusOagMutationWitness {
        source_kind: 1,
        source_digest: PireusOagDigest { words: residual.digest.words },
        opcode: genome.mutation_id,
        parameter_0: genome.address_c,
        parameter_1: residual.associator_failures,
        parameter_2: residual.commutator_failures,
        reconstruction_checks: reconstruction_checks,
        reconstruction_failures: failures,
        complete: failures == 0,
    }
}

fn oag_bilinear_basis_value(
    genome: &PireusOagOperatorGenome,
    seed: &[i64; 256],
    residual: &PireusOagResidual,
    left: i64,
    right: i64,
) -> [i64; 2] with Panic {
    [oag_affine_address(genome, left, right),
     oag_genome_coefficient(genome, seed, residual, left, right)]
}

fn oag_ternary_basis_value(
    genome: &PireusOagOperatorGenome,
    seed: &[i64; 256],
    i: i64,
    j: i64,
    k: i64,
) -> [i64; 2] with Panic {
    let left_coefficient = oag_parent_basis_coefficient(seed, i, j) *
        oag_parent_basis_coefficient(seed, i ^ j, k)
    let right_coefficient = oag_parent_basis_coefficient(seed, j, k) *
        oag_parent_basis_coefficient(seed, i, j ^ k)
    let coefficient = if genome.reduction_program == PIREUS_OAG_REDUCTION_RIGHT {
        right_coefficient
    } else { left_coefficient }
    let destination = (i ^ j) ^ k
    var result: [i64; 2] = [0; 2]
    result[0] = destination
    result[1] = coefficient
    result
}

fn oag_bilinear_independent_value(
    genome: &PireusOagOperatorGenome,
    seed: &[i64; 256],
    residual: &PireusOagResidual,
    left: i64,
    right: i64,
) -> [i64; 2] with Mut, Panic {
    var found: i64 = 0
    var destination_value: i64 = -1
    var coefficient_value: i64 = 0
    var destination: i64 = 0
    while destination < PIREUS_OAG_LANES {
        var i: i64 = 0
        while i < PIREUS_OAG_LANES {
            let j = if genome.address_program ==
                PIREUS_OAG_ADDRESS_AFFINE_F2_4 {
                oag_apply_address_a(genome.address_a, i) ^
                    destination ^ genome.address_c
            } else { i ^ destination }
            if i == left && j == right {
                found = found + 1
                destination_value = destination
                let cell = i * PIREUS_OAG_LANES + j
                let parent_bit = seed[cell]
                if genome.coefficient_program ==
                    PIREUS_OAG_COEFFICIENT_RESIDUAL_TWIST {
                    let twisted_bit = if residual.pair_bits[cell] == 0 {
                        parent_bit
                    } else if parent_bit == 0 { 1 } else { 0 }
                    coefficient_value = if twisted_bit == 0 { 1 } else { -1 }
                } else if genome.coefficient_program ==
                    PIREUS_OAG_COEFFICIENT_RESIDUAL_LIFT {
                    let parent_coefficient = if parent_bit == 0 { 1 } else { -1 }
                    coefficient_value = parent_coefficient *
                        (1 + residual.pair_counts[cell])
                } else {
                    coefficient_value = if parent_bit == 0 { 1 } else { -1 }
                }
            }
            i = i + 1
        }
        destination = destination + 1
    }
    if found != 1 { [-1, 0] }
    else { [destination_value, coefficient_value] }
}

fn oag_parent_vector_apply(
    seed: &[i64; 256],
    a: &[i64; 16],
    b: &[i64; 16],
) -> [i64; 16] with Mut, Panic {
    var output: [i64; 16] = [0; 16]
    var i: i64 = 0
    while i < PIREUS_OAG_LANES {
        var j: i64 = 0
        while j < PIREUS_OAG_LANES {
            output[i ^ j] = output[i ^ j] +
                oag_parent_basis_coefficient(seed, i, j) * a[i] * b[j]
            j = j + 1
        }
        i = i + 1
    }
    output
}

fn oag_ternary_independent_value(
    genome: &PireusOagOperatorGenome,
    seed: &[i64; 256],
    i: i64,
    j: i64,
    k: i64,
) -> [i64; 2] with Mut, Panic {
    var a: [i64; 16] = [0; 16]
    var b: [i64; 16] = [0; 16]
    var c: [i64; 16] = [0; 16]
    a[i] = 1
    b[j] = 1
    c[k] = 1
    var output: [i64; 16] = [0; 16]
    if genome.reduction_program == PIREUS_OAG_REDUCTION_RIGHT {
        let inner = oag_parent_vector_apply(seed, &b, &c)
        output = oag_parent_vector_apply(seed, &a, &inner)
    } else {
        let inner = oag_parent_vector_apply(seed, &a, &b)
        output = oag_parent_vector_apply(seed, &inner, &c)
    }
    var nonzero: i64 = 0
    var destination: i64 = -1
    var coefficient: i64 = 0
    var lane: i64 = 0
    while lane < PIREUS_OAG_LANES {
        if output[lane] != 0 {
            nonzero = nonzero + 1
            destination = lane
            coefficient = output[lane]
        }
        lane = lane + 1
    }
    if nonzero != 1 { [-1, 0] } else { [destination, coefficient] }
}

fn oag_evaluate_genome(
    genome: &PireusOagOperatorGenome,
    seed: &[i64; 256],
    residual: &PireusOagResidual,
) -> PireusOagEvaluation with Mut, Panic, Div, Epistemic {
    var basis_checks: i64 = 0
    var path_checks: i64 = 0
    var failures: i64 = 0
    var nonzero_constants: i64 = 0
    var state = sha256_init()
    if genome.arity == PIREUS_OAG_ARITY_BILINEAR {
        var i: i64 = 0
        while i < PIREUS_OAG_LANES {
            var j: i64 = 0
            while j < PIREUS_OAG_LANES {
                let direct = oag_bilinear_basis_value(
                    genome, seed, residual, i, j)
                let independent = oag_bilinear_independent_value(
                    genome, seed, residual, i, j)
                basis_checks = basis_checks + 1
                path_checks = path_checks + 2
                if direct[0] != independent[0] || direct[1] != independent[1] {
                    failures = failures + 1
                }
                if direct[0] < 0 || direct[0] >= PIREUS_OAG_LANES {
                    failures = failures + 1
                }
                if direct[1] != 0 { nonzero_constants = nonzero_constants + 1 }
                state = oag_digest_add_i64(state, i)
                state = oag_digest_add_i64(state, j)
                state = oag_digest_add_i64(state, direct[0])
                state = oag_digest_add_i64(state, direct[1])
                j = j + 1
            }
            i = i + 1
        }
    } else {
        var i: i64 = 0
        while i < PIREUS_OAG_LANES {
            var j: i64 = 0
            while j < PIREUS_OAG_LANES {
                var k: i64 = 0
                while k < PIREUS_OAG_LANES {
                    let direct = oag_ternary_basis_value(genome, seed, i, j, k)
                    let independent = oag_ternary_independent_value(
                        genome, seed, i, j, k)
                    basis_checks = basis_checks + 1
                    path_checks = path_checks + 2
                    if direct[0] != independent[0] || direct[1] != independent[1] {
                        failures = failures + 1
                    }
                    if direct[0] < 0 || direct[0] >= PIREUS_OAG_LANES {
                        failures = failures + 1
                    }
                    if direct[1] != 0 {
                        nonzero_constants = nonzero_constants + 1
                    }
                    state = oag_digest_add_i64(state, i)
                    state = oag_digest_add_i64(state, j)
                    state = oag_digest_add_i64(state, k)
                    state = oag_digest_add_i64(state, direct[0])
                    state = oag_digest_add_i64(state, direct[1])
                    k = k + 1
                }
                j = j + 1
            }
            i = i + 1
        }
    }
    let expected_checks = if genome.arity == PIREUS_OAG_ARITY_BILINEAR {
        PIREUS_OAG_BILINEAR_BASIS
    } else { PIREUS_OAG_TERNARY_BASIS }
    PireusOagEvaluation {
        basis_checks: basis_checks,
        path_checks: path_checks,
        failures: failures,
        nonzero_constants: nonzero_constants,
        digest: oag_digest_finish(state),
        complete: basis_checks == expected_checks &&
            path_checks == 2 * expected_checks &&
            failures == 0,
    }
}

fn oag_digest_law_profile(
    genome: &PireusOagOperatorGenome,
    seed: &[i64; 256],
    residual: &PireusOagResidual,
) -> PireusOagDigest with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = oag_digest_add_i64(state, genome.arity)
    if genome.arity == PIREUS_OAG_ARITY_BILINEAR {
        var commutator_failures: i64 = 0
        var associator_failures: i64 = 0
        var i: i64 = 0
        while i < PIREUS_OAG_LANES {
            var j: i64 = 0
            while j < PIREUS_OAG_LANES {
                let ij = oag_bilinear_basis_value(genome, seed, residual, i, j)
                let ji = oag_bilinear_basis_value(genome, seed, residual, j, i)
                if ij[0] != ji[0] || ij[1] != ji[1] {
                    commutator_failures = commutator_failures + 1
                }
                var k: i64 = 0
                while k < PIREUS_OAG_LANES {
                    let left_first = oag_bilinear_basis_value(
                        genome, seed, residual, i, j)
                    let left_second = oag_bilinear_basis_value(
                        genome, seed, residual, left_first[0], k)
                    let right_first = oag_bilinear_basis_value(
                        genome, seed, residual, j, k)
                    let right_second = oag_bilinear_basis_value(
                        genome, seed, residual, i, right_first[0])
                    if left_second[0] != right_second[0] ||
                        left_first[1] * left_second[1] !=
                        right_first[1] * right_second[1] {
                        associator_failures = associator_failures + 1
                    }
                    k = k + 1
                }
                j = j + 1
            }
            i = i + 1
        }
        state = oag_digest_add_i64(state, commutator_failures)
        state = oag_digest_add_i64(state, associator_failures)
    } else {
        var positive: i64 = 0
        var negative: i64 = 0
        var i: i64 = 0
        while i < PIREUS_OAG_LANES {
            var j: i64 = 0
            while j < PIREUS_OAG_LANES {
                var k: i64 = 0
                while k < PIREUS_OAG_LANES {
                    let value = oag_ternary_basis_value(genome, seed, i, j, k)
                    if value[1] > 0 { positive = positive + 1 }
                    if value[1] < 0 { negative = negative + 1 }
                    k = k + 1
                }
                j = j + 1
            }
            i = i + 1
        }
        state = oag_digest_add_i64(state, positive)
        state = oag_digest_add_i64(state, negative)
    }
    oag_digest_finish(state)
}

fn oag_genomes_equal_on_basis(
    left: &PireusOagOperatorGenome,
    right: &PireusOagOperatorGenome,
    seed: &[i64; 256],
    residual: &PireusOagResidual,
) -> [i64; 2] with Mut, Panic {
    if left.arity != right.arity { return [0, 0] }
    var witness: i64 = -1
    if left.arity == PIREUS_OAG_ARITY_BILINEAR {
        var i: i64 = 0
        while i < PIREUS_OAG_LANES {
            var j: i64 = 0
            while j < PIREUS_OAG_LANES {
                let a = oag_bilinear_basis_value(left, seed, residual, i, j)
                let b = oag_bilinear_basis_value(right, seed, residual, i, j)
                if witness < 0 && (a[0] != b[0] || a[1] != b[1]) {
                    witness = i * PIREUS_OAG_LANES + j
                }
                j = j + 1
            }
            i = i + 1
        }
    } else {
        var i: i64 = 0
        while i < PIREUS_OAG_LANES {
            var j: i64 = 0
            while j < PIREUS_OAG_LANES {
                var k: i64 = 0
                while k < PIREUS_OAG_LANES {
                    let a = oag_ternary_basis_value(left, seed, i, j, k)
                    let b = oag_ternary_basis_value(right, seed, i, j, k)
                    if witness < 0 && (a[0] != b[0] || a[1] != b[1]) {
                        witness = (i * PIREUS_OAG_LANES + j) *
                            PIREUS_OAG_LANES + k
                    }
                    k = k + 1
                }
                j = j + 1
            }
            i = i + 1
        }
    }
    if witness < 0 { [1, -1] } else { [0, witness] }
}

fn oag_store_digest(
    flat: &![i64; 56], slot: i64, digest: &PireusOagDigest,
) with Mut, Panic {
    var word: i64 = 0
    while word < PIREUS_OAG_WORDS {
        flat[slot * PIREUS_OAG_WORDS + word] = digest.words[word]
        word = word + 1
    }
}

fn oag_load_digest(flat: &[i64; 56], slot: i64) -> PireusOagDigest
with Mut, Panic {
    var words: [i64; 8] = [0; 8]
    var word: i64 = 0
    while word < PIREUS_OAG_WORDS {
        words[word] = flat[slot * PIREUS_OAG_WORDS + word]
        word = word + 1
    }
    PireusOagDigest { words: words }
}

fn oag_flat_digest_equal(flat: &[i64; 56], left: i64, right: i64) -> bool
with Mut, Panic {
    var word: i64 = 0
    while word < PIREUS_OAG_WORDS {
        if flat[left * PIREUS_OAG_WORDS + word] !=
            flat[right * PIREUS_OAG_WORDS + word] {
            return false
        }
        word = word + 1
    }
    true
}

fn oag_build_negative_cases() -> [bool; 41] with Mut, Panic {
    var cases: [bool; 41] = [false; 41]
    var q = pireus_operator_autogenesis_request()
    q.producer_language = PIREUS_ONF_LANGUAGE_PYTHON
    cases[0] = oag_request_error(&q) == PIREUS_OAG_ERR_AUTHORITY
    q = pireus_operator_autogenesis_request()
    q.producer_language = PIREUS_ONF_LANGUAGE_RUST
    cases[1] = oag_request_error(&q) == PIREUS_OAG_ERR_AUTHORITY
    q = pireus_operator_autogenesis_request()
    q.producer_language = PIREUS_ONF_LANGUAGE_CPP
    q.producer_role = PIREUS_ONF_ROLE_MATERIAL_PARITY
    cases[2] = oag_request_error(&q) == PIREUS_OAG_ERR_AUTHORITY
    q = pireus_operator_autogenesis_request()
    q.producer_language = PIREUS_ONF_LANGUAGE_LLM
    q.producer_role = PIREUS_ONF_ROLE_REVIEW_ONLY
    cases[3] = oag_request_error(&q) == PIREUS_OAG_ERR_AUTHORITY
    q = pireus_operator_autogenesis_request()
    q.producer_language = PIREUS_ONF_LANGUAGE_LEAN
    q.producer_role = PIREUS_ONF_ROLE_FORMAL_PARITY
    cases[4] = oag_request_error(&q) == PIREUS_OAG_ERR_AUTHORITY
    q = pireus_operator_autogenesis_request()
    q.producer_language = PIREUS_ONF_LANGUAGE_KOKA
    q.producer_role = PIREUS_ONF_ROLE_EFFECT_PARITY
    cases[5] = oag_request_error(&q) == PIREUS_OAG_ERR_AUTHORITY
    q = pireus_operator_autogenesis_request()
    q.policy_present = false
    cases[6] = oag_request_error(&q) == PIREUS_OAG_ERR_POLICY
    q = pireus_operator_autogenesis_request()
    q.stage = q.stage + 1
    cases[7] = oag_request_error(&q) == PIREUS_OAG_ERR_STAGE
    q = pireus_operator_autogenesis_request()
    q.parent_present = false
    cases[8] = oag_request_error(&q) == PIREUS_OAG_ERR_LINEAGE
    q = pireus_operator_autogenesis_request()
    q.parent_frozen = false
    cases[9] = oag_request_error(&q) == PIREUS_OAG_ERR_LINEAGE
    q = pireus_operator_autogenesis_request()
    q.parent_source_bound = false
    cases[10] = oag_request_error(&q) == PIREUS_OAG_ERR_LINEAGE
    q = pireus_operator_autogenesis_request()
    q.parent_semantics_bound = false
    cases[11] = oag_request_error(&q) == PIREUS_OAG_ERR_LINEAGE
    q = pireus_operator_autogenesis_request()
    q.parent_freeze_bound = false
    cases[12] = oag_request_error(&q) == PIREUS_OAG_ERR_LINEAGE
    q = pireus_operator_autogenesis_request()
    q.parent_process_evidence_present = false
    cases[13] = oag_request_error(&q) == PIREUS_OAG_ERR_LINEAGE
    q = pireus_operator_autogenesis_request()
    q.recursive_parent_evaluation_requested = true
    cases[14] = oag_request_error(&q) == PIREUS_OAG_ERR_LINEAGE
    q = pireus_operator_autogenesis_request()
    q.prefilled_parent_seed_present = true
    cases[15] = oag_request_error(&q) == PIREUS_OAG_ERR_LINEAGE
    q = pireus_operator_autogenesis_request()
    q.expected_frontier_size_present = true
    cases[16] = oag_request_error(&q) == PIREUS_OAG_ERR_RESULT_INJECTION
    q = pireus_operator_autogenesis_request()
    q.expected_admitted_genome_present = true
    cases[17] = oag_request_error(&q) == PIREUS_OAG_ERR_RESULT_INJECTION
    q = pireus_operator_autogenesis_request()
    q.expected_rejected_genome_present = true
    cases[18] = oag_request_error(&q) == PIREUS_OAG_ERR_RESULT_INJECTION
    q = pireus_operator_autogenesis_request()
    q.expected_class_count_present = true
    cases[19] = oag_request_error(&q) == PIREUS_OAG_ERR_RESULT_INJECTION
    q = pireus_operator_autogenesis_request()
    q.expected_representative_present = true
    cases[20] = oag_request_error(&q) == PIREUS_OAG_ERR_RESULT_INJECTION
    q = pireus_operator_autogenesis_request()
    q.expected_truth_table_present = true
    cases[21] = oag_request_error(&q) == PIREUS_OAG_ERR_RESULT_INJECTION
    q = pireus_operator_autogenesis_request()
    q.expected_digest_present = true
    cases[22] = oag_request_error(&q) == PIREUS_OAG_ERR_RESULT_INJECTION
    q = pireus_operator_autogenesis_request()
    q.expected_invariant_present = true
    cases[23] = oag_request_error(&q) == PIREUS_OAG_ERR_RESULT_INJECTION
    q = pireus_operator_autogenesis_request()
    q.expected_transcript_present = true
    cases[24] = oag_request_error(&q) == PIREUS_OAG_ERR_RESULT_INJECTION
    q = pireus_operator_autogenesis_request()
    q.target_instruction_present = true
    cases[25] = oag_request_error(&q) == PIREUS_OAG_ERR_MATERIAL
    q = pireus_operator_autogenesis_request()
    q.target_cost_present = true
    cases[26] = oag_request_error(&q) == PIREUS_OAG_ERR_MATERIAL
    q = pireus_operator_autogenesis_request()
    q.target_performance_present = true
    cases[27] = oag_request_error(&q) == PIREUS_OAG_ERR_MATERIAL
    q = pireus_operator_autogenesis_request()
    q.semantic_write_from_parity = true
    cases[28] = oag_request_error(&q) == PIREUS_OAG_ERR_AUTHORITY
    q = pireus_operator_autogenesis_request()
    q.expected_result_write_from_parity = true
    cases[29] = oag_request_error(&q) == PIREUS_OAG_ERR_AUTHORITY
    q = pireus_operator_autogenesis_request()
    q.review_promoted_to_authority = true
    cases[30] = oag_request_error(&q) == PIREUS_OAG_ERR_AUTHORITY
    q = pireus_operator_autogenesis_request()
    q.historical_novelty_requested = true
    cases[31] = oag_request_error(&q) == PIREUS_OAG_ERR_CLAIM
    q = pireus_operator_autogenesis_request()
    q.claim_ready_requested = true
    cases[32] = oag_request_error(&q) == PIREUS_OAG_ERR_CLAIM
    q = pireus_operator_autogenesis_request()
    q.nonlinear_candidate_present = true
    cases[33] = oag_request_error(&q) ==
        PIREUS_OAG_ERR_NONLINEAR_CERTIFICATE
    q = pireus_operator_autogenesis_request()
    q.priority_requested = true
    cases[34] = oag_request_error(&q) == PIREUS_OAG_ERR_CLAIM
    q = pireus_operator_autogenesis_request()
    q.founder_waiver_present = true
    cases[35] = oag_request_error(&q) == PIREUS_OAG_ERR_WAIVER
    let residual = PireusOagResidual {
        associator_failures: 1,
        commutator_failures: 0,
        first_i: 0,
        first_j: 0,
        first_k: 0,
        pair_counts: [0; 256],
        pair_bits: [0; 256],
        digest: PireusOagDigest { words: [0; 8] },
        complete: true,
    }
    var genome = oag_genome_for_slot(PIREUS_OAG_OPCODE_PARENT, &residual)
    genome.mutation_id = 99
    cases[36] = pireus_oag_validate_genome(&genome) == PIREUS_OAG_ERR_OPCODE
    genome = oag_genome_for_slot(PIREUS_OAG_OPCODE_AFFINE_ADDRESS, &residual)
    genome.address_b = 0
    cases[37] = pireus_oag_validate_genome(&genome) == PIREUS_OAG_ERR_GENOME
    genome = oag_genome_for_slot(PIREUS_OAG_OPCODE_RESIDUAL_TWIST, &residual)
    genome.coefficient_program = PIREUS_OAG_COEFFICIENT_PARENT_SIGN
    cases[38] = pireus_oag_validate_genome(&genome) == PIREUS_OAG_ERR_GENOME
    let empty_residual = PireusOagResidual {
        associator_failures: 0,
        commutator_failures: 0,
        first_i: -1,
        first_j: -1,
        first_k: -1,
        pair_counts: [0; 256],
        pair_bits: [0; 256],
        digest: PireusOagDigest { words: [0; 8] },
        complete: false,
    }
    genome = oag_genome_for_slot(
        PIREUS_OAG_OPCODE_RESIDUAL_TWIST, &empty_residual)
    let empty_witness = oag_mutation_witness(&genome, &empty_residual)
    cases[39] = !empty_witness.complete
    genome = oag_genome_for_slot(PIREUS_OAG_OPCODE_REDUCTION_TREE, &residual)
    cases[40] = pireus_oag_validate_genome(&genome) == PIREUS_OAG_ERR_GENOME
    cases
}

fn oag_bit(value: bool) -> i64 { if value { 1 } else { 0 } }

fn oag_print_digest(digest: &PireusOagDigest) with IO, Mut, Panic {
    var word: i64 = 0
    while word < PIREUS_OAG_WORDS {
        if word > 0 { print(":") }
        print_int(digest.words[word])
        word = word + 1
    }
}

fn oag_print_negative(name: string, refused: bool) with IO {
    print("PIREUS_OAG_NEGATIVE name=")
    print(name)
    print(" refused=")
    print_int(oag_bit(refused))
    print("\n")
}

fn oag_emit_basis(
    genome: &PireusOagOperatorGenome,
    seed: &[i64; 256],
    residual: &PireusOagResidual,
) with IO, Mut, Panic {
    if genome.arity == PIREUS_OAG_ARITY_BILINEAR {
        var i: i64 = 0
        while i < PIREUS_OAG_LANES {
            var j: i64 = 0
            while j < PIREUS_OAG_LANES {
                let direct = oag_bilinear_basis_value(
                    genome, seed, residual, i, j)
                let independent = oag_bilinear_independent_value(
                    genome, seed, residual, i, j)
                print("PIREUS_OAG_BASIS genome="); print_int(genome.id)
                print(" arity=2 i="); print_int(i)
                print(" j="); print_int(j)
                print(" destination="); print_int(direct[0])
                print(" coefficient="); print_int(direct[1])
                print(" independent_destination="); print_int(independent[0])
                print(" independent_coefficient="); print_int(independent[1])
                print("\n")
                j = j + 1
            }
            i = i + 1
        }
    } else {
        var i: i64 = 0
        while i < PIREUS_OAG_LANES {
            var j: i64 = 0
            while j < PIREUS_OAG_LANES {
                var k: i64 = 0
                while k < PIREUS_OAG_LANES {
                    let direct = oag_ternary_basis_value(genome, seed, i, j, k)
                    let independent = oag_ternary_independent_value(
                        genome, seed, i, j, k)
                    print("PIREUS_OAG_BASIS genome="); print_int(genome.id)
                    print(" arity=3 i="); print_int(i)
                    print(" j="); print_int(j)
                    print(" k="); print_int(k)
                    print(" destination="); print_int(direct[0])
                    print(" coefficient="); print_int(direct[1])
                    print(" independent_destination="); print_int(independent[0])
                    print(" independent_coefficient="); print_int(independent[1])
                    print("\n")
                    k = k + 1
                }
                j = j + 1
            }
            i = i + 1
        }
    }
}

fn oag_emit_candidate(
    genome: &PireusOagOperatorGenome,
    mutation: &PireusOagMutationWitness,
    genome_digest: &PireusOagDigest,
    basis_digest: &PireusOagDigest,
    law_digest: &PireusOagDigest,
    quotient_representative: i64,
    separating_witness: i64,
    program_distinct: bool,
    basis_map_distinct: bool,
    law_profile_distinct: bool,
    admissible: bool,
    rejection_reason: i64,
    evaluation: &PireusOagEvaluation,
) with IO, Mut, Panic {
    print("PIREUS_OAG_GENOME id="); print_int(genome.id)
    print(" parent_id="); print_int(genome.parent_id)
    print(" mutation_id="); print_int(genome.mutation_id)
    print(" arity="); print_int(genome.arity)
    print(" carrier="); print_int(genome.value_carrier)
    print(" operator_type="); print_int(genome.operator_type)
    print(" linear_0="); print_int(oag_bit(genome.linear_slot_0))
    print(" linear_1="); print_int(oag_bit(genome.linear_slot_1))
    print(" linear_2="); print_int(oag_bit(genome.linear_slot_2))
    print(" address_program="); print_int(genome.address_program)
    print(" address_a="); print_int(genome.address_a)
    print(" address_b="); print_int(genome.address_b)
    print(" address_c="); print_int(genome.address_c)
    print(" coefficient_program="); print_int(genome.coefficient_program)
    print(" reduction_program="); print_int(genome.reduction_program)
    print(" equivalence_contract="); print_int(genome.equivalence_contract)
    print("\n")
    print("PIREUS_OAG_MUTATION genome="); print_int(genome.id)
    print(" opcode="); print_int(mutation.opcode)
    print(" source_kind="); print_int(mutation.source_kind)
    print(" source_digest="); oag_print_digest(&mutation.source_digest)
    print(" parameter_0="); print_int(mutation.parameter_0)
    print(" parameter_1="); print_int(mutation.parameter_1)
    print(" parameter_2="); print_int(mutation.parameter_2)
    print(" reconstruction_checks=")
    print_int(mutation.reconstruction_checks)
    print(" reconstruction_failures=")
    print_int(mutation.reconstruction_failures)
    print(" complete="); print_int(oag_bit(mutation.complete))
    print("\n")
    print("PIREUS_OAG_EVALUATION genome="); print_int(genome.id)
    print(" basis_checks="); print_int(evaluation.basis_checks)
    print(" path_checks="); print_int(evaluation.path_checks)
    print(" failures="); print_int(evaluation.failures)
    print(" nonzero_constants="); print_int(evaluation.nonzero_constants)
    print(" complete="); print_int(oag_bit(evaluation.complete))
    print(" basis_digest="); oag_print_digest(basis_digest)
    print(" invariant_digest=")
    oag_print_digest(law_digest)
    print("\n")
    print("PIREUS_OAG_DISTINCTION genome="); print_int(genome.id)
    print(" syntax_program_distinct=")
    print_int(oag_bit(program_distinct))
    print(" multilinear_basis_map_distinct=")
    print_int(oag_bit(basis_map_distinct))
    print(" finite_function_distinct=0")
    // v9 quotients only by equality of complete multilinear basis maps under
    // the declared identity contract. It constructs no quotient algebra.
    print(" quotient_relative_distinct=")
    print_int(oag_bit(basis_map_distinct))
    print(" checked_profile_digest_distinct=")
    print_int(oag_bit(law_profile_distinct))
    print(" algorithmically_distinct=0 materially_distinct=0")
    print(" historically_novel=0 claim_ready=0")
    print(" quotient_representative=")
    print_int(quotient_representative)
    print(" separating_witness="); print_int(separating_witness)
    print(" admissible="); print_int(oag_bit(admissible))
    print(" rejection_reason="); print_int(rejection_reason)
    print(" genome_digest="); oag_print_digest(genome_digest)
    print("\n")
}

fn oag_negative_name(index: i64) -> string {
    if index == 0 { return "python_authority" }
    if index == 1 { return "rust_authority" }
    if index == 2 { return "cpp_authority" }
    if index == 3 { return "llm_authority" }
    if index == 4 { return "lean_authority" }
    if index == 5 { return "koka_authority" }
    if index == 6 { return "missing_policy" }
    if index == 7 { return "wrong_stage" }
    if index == 8 { return "missing_parent" }
    if index == 9 { return "unfrozen_parent" }
    if index == 10 { return "unbound_parent_source" }
    if index == 11 { return "unbound_parent_semantics" }
    if index == 12 { return "unbound_parent_freeze" }
    if index == 13 { return "missing_parent_process_evidence" }
    if index == 14 { return "recursive_parent_evaluation" }
    if index == 15 { return "prefilled_parent_seed" }
    if index == 16 { return "expected_frontier_size" }
    if index == 17 { return "expected_admitted_genome" }
    if index == 18 { return "expected_rejected_genome" }
    if index == 19 { return "expected_class_count" }
    if index == 20 { return "expected_representative" }
    if index == 21 { return "expected_truth_table" }
    if index == 22 { return "expected_digest" }
    if index == 23 { return "expected_invariant" }
    if index == 24 { return "expected_transcript" }
    if index == 25 { return "target_instruction" }
    if index == 26 { return "target_cost" }
    if index == 27 { return "target_performance" }
    if index == 28 { return "parity_semantic_write" }
    if index == 29 { return "parity_expected_result" }
    if index == 30 { return "review_promotion" }
    if index == 31 { return "historical_novelty" }
    if index == 32 { return "claim_ready" }
    if index == 33 { return "nonlinear_basis_only" }
    if index == 34 { return "priority_claim" }
    if index == 35 { return "unscoped_waiver" }
    if index == 36 { return "unknown_opcode" }
    if index == 37 { return "nonbijective_affine_address" }
    if index == 38 { return "opcode_program_incoherence" }
    if index == 39 { return "residual_required_but_empty" }
    "ternary_third_tree_undefined"
}

fn oag_frozen_lineage_residual_match(
    admission: &PireusOagAdmission,
    residual: &PireusOagResidual,
) -> bool with Mut, Panic {
    // The weight and residual counts below are empirical content locks from
    // the committed Sounio transcript, recomputed here from the hash-bound
    // parent seed. They are not asserted as ambient algebraic theorems.
    if !admission.lineage.source_file_match ||
        !admission.lineage.semantics_receipt_match ||
        !admission.lineage.freeze_file_match ||
        !admission.lineage.evidence_file_match ||
        !admission.lineage.parent_result_valid ||
        !admission.lineage.parent_frozen_match ||
        admission.lineage.seed_word_checks != PIREUS_OAG_WORDS ||
        admission.lineage.seed_cell_checks != PIREUS_OAG_CELLS ||
        admission.lineage.seed_failures != 0 ||
        admission.lineage.seed_weight != 96 ||
        admission.lineage.recursive_parent_evaluation_used ||
        !admission.lineage.complete {
        return false
    }
    // The digest binds the full 4096 associator comparisons plus all 256
    // per-pair counts and parities, not an external mathematical oracle.
    let residual_digest: [i64; 8] = [
        2570042718, 2211477497, 4020205376, 3616509508,
        1347972669, 3092896318, 3383745819, 2154696541
    ]
    residual.associator_failures == 768 &&
        residual.commutator_failures == 112 &&
        residual.first_i == 2 && residual.first_j == 4 &&
        residual.first_k == 2 && residual.complete &&
        oag_hash_equal(&residual.digest.words, &residual_digest)
}

fn oag_frozen_frontier_match(
    enabled: &[i64; 7],
    admissible: &[i64; 7],
    rejection_reason: &[i64; 7],
    representatives: &[i64; 7],
    separators: &[i64; 7],
) -> bool with Mut, Panic {
    let expected_enabled: [i64; 7] = [1, 1, 1, 1, 1, 1, 1]
    let expected_admissible: [i64; 7] = [1, 1, 1, 1, 1, 1, 0]
    let expected_rejections: [i64; 7] = [0, 0, 0, 0, 0, 0, 11]
    let expected_representatives: [i64; 7] = [0, 0, 2, 3, 4, 5, 6]
    let expected_separators: [i64; 7] = [-1, -1, 0, 36, 900023, 900023, -1]
    var slot: i64 = 0
    while slot < PIREUS_OAG_FRONTIER_CAPACITY {
        if enabled[slot] != expected_enabled[slot] ||
            admissible[slot] != expected_admissible[slot] ||
            rejection_reason[slot] != expected_rejections[slot] ||
            representatives[slot] != expected_representatives[slot] ||
            separators[slot] != expected_separators[slot] {
            return false
        }
        slot = slot + 1
    }
    true
}

fn oag_frozen_negatives_match(cases: &[bool; 41]) -> bool
with Mut, Panic {
    var index: i64 = 0
    while index < PIREUS_OAG_NEGATIVE_CASES {
        if !cases[index] { return false }
        index = index + 1
    }
    true
}

pub fn pireus_operator_autogenesis_execute(
    request: &PireusOagRequest,
    paths: &PireusOagParentPaths,
    emit_transcript: bool,
) -> PireusOagSummary with IO, Mut, Panic, Div, Alloc, Epistemic {
    let request_error = oag_request_error(request)
    let admission = oag_build_admission(paths)
    let residual = oag_build_residual(&admission.seed_cells)
    var enabled: [i64; 7] = [0; 7]
    var admissible: [i64; 7] = [0; 7]
    var rejection_reason: [i64; 7] = [0; 7]
    var representatives: [i64; 7] = [0; 7]
    var separators: [i64; 7] = [-1; 7]
    var genome_digests: [i64; 56] = [0; 56]
    var basis_digests: [i64; 56] = [0; 56]
    var law_digests: [i64; 56] = [0; 56]
    var generated_count: i64 = 0
    var admitted_count: i64 = 0
    var rejected_count: i64 = 0
    var bilinear_basis_checks: i64 = 0
    var ternary_basis_checks: i64 = 0
    var structural_failures: i64 = 0
    var generation_state = sha256_init()
    var slot: i64 = 0
    while slot < PIREUS_OAG_FRONTIER_CAPACITY {
        representatives[slot] = slot
        if oag_slot_enabled(request, slot) {
            enabled[slot] = 1
            generated_count = generated_count + 1
            let genome = oag_genome_for_slot(slot, &residual)
            let mutation = oag_mutation_witness(&genome, &residual)
            let evaluation = oag_evaluate_genome(
                &genome, &admission.seed_cells, &residual)
            let genome_digest = oag_digest_genome(&genome, &residual)
            let law_digest = oag_digest_law_profile(
                &genome, &admission.seed_cells, &residual)
            oag_store_digest(&!genome_digests, slot, &genome_digest)
            oag_store_digest(&!basis_digests, slot, &evaluation.digest)
            oag_store_digest(&!law_digests, slot, &law_digest)
            let valid = mutation.complete && evaluation.complete
            if valid {
                admissible[slot] = 1
                admitted_count = admitted_count + 1
            } else {
                rejected_count = rejected_count + 1
                if !mutation.complete {
                    rejection_reason[slot] = PIREUS_OAG_ERR_GENOME
                } else {
                    rejection_reason[slot] = PIREUS_OAG_ERR_EXECUTION
                    structural_failures = structural_failures +
                        evaluation.failures + 1
                }
            }
            if genome.arity == PIREUS_OAG_ARITY_BILINEAR {
                bilinear_basis_checks = bilinear_basis_checks +
                    evaluation.basis_checks
            } else {
                ternary_basis_checks = ternary_basis_checks +
                    evaluation.basis_checks
            }
            generation_state = oag_digest_add_i64(generation_state, slot)
            generation_state = oag_digest_add_bool(generation_state, valid)
            var word: i64 = 0
            while word < PIREUS_OAG_WORDS {
                generation_state = oag_digest_add_i64(
                    generation_state, genome_digest.words[word])
                generation_state = oag_digest_add_i64(
                    generation_state, evaluation.digest.words[word])
                generation_state = oag_digest_add_i64(
                    generation_state, law_digest.words[word])
                word = word + 1
            }
            generation_state = oag_digest_add_i64(
                generation_state, rejection_reason[slot])
        }
        slot = slot + 1
    }

    var duplicate_checks: i64 = 0
    var duplicate_failures: i64 = 0
    var duplicate_right: i64 = 0
    while duplicate_right < PIREUS_OAG_FRONTIER_CAPACITY {
        if enabled[duplicate_right] != 0 {
            var duplicate_left: i64 = 0
            while duplicate_left < duplicate_right {
                if enabled[duplicate_left] != 0 {
                    duplicate_checks = duplicate_checks + 1
                    let duplicate = oag_flat_digest_equal(
                        &genome_digests, duplicate_left, duplicate_right)
                    if duplicate { duplicate_failures = duplicate_failures + 1 }
                    generation_state = oag_digest_add_bool(
                        generation_state, duplicate)
                }
                duplicate_left = duplicate_left + 1
            }
        }
        duplicate_right = duplicate_right + 1
    }
    if duplicate_failures != 0 {
        structural_failures = structural_failures + duplicate_failures
    }

    var quotient_pairs: i64 = 0
    var separating_witnesses: i64 = 0
    var right_slot: i64 = 0
    while right_slot < PIREUS_OAG_FRONTIER_CAPACITY {
        if enabled[right_slot] != 0 && admissible[right_slot] != 0 {
            let right_genome = oag_genome_for_slot(right_slot, &residual)
            var left_slot: i64 = 0
            while left_slot < right_slot {
                if enabled[left_slot] != 0 && admissible[left_slot] != 0 {
                    quotient_pairs = quotient_pairs + 1
                    let left_genome = oag_genome_for_slot(left_slot, &residual)
                    let comparison = oag_genomes_equal_on_basis(
                        &left_genome, &right_genome,
                        &admission.seed_cells, &residual)
                    if comparison[0] == 1 {
                        representatives[right_slot] = representatives[left_slot]
                    } else {
                        separating_witnesses = separating_witnesses + 1
                        if separators[right_slot] < 0 {
                            separators[right_slot] = if
                                left_genome.arity != right_genome.arity {
                                900000 + left_genome.arity * 10 + right_genome.arity
                            } else { comparison[1] }
                        }
                    }
                    generation_state = oag_digest_add_i64(
                        generation_state, left_slot)
                    generation_state = oag_digest_add_i64(
                        generation_state, right_slot)
                    generation_state = oag_digest_add_i64(
                        generation_state, comparison[0])
                    generation_state = oag_digest_add_i64(
                        generation_state, comparison[1])
                }
                left_slot = left_slot + 1
            }
        }
        right_slot = right_slot + 1
    }
    let generation_digest = oag_digest_finish(generation_state)

    let negative_cases = oag_build_negative_cases()
    var negative_passed: i64 = 0
    var negative: i64 = 0
    while negative < PIREUS_OAG_NEGATIVE_CASES {
        if negative_cases[negative] { negative_passed = negative_passed + 1 }
        negative = negative + 1
    }
    let negative_failures = PIREUS_OAG_NEGATIVE_CASES - negative_passed
    let contract_transformations: i64 = 1
    var identity_checks: i64 = 0
    var identity_failures: i64 = 0
    slot = 0
    while slot < PIREUS_OAG_FRONTIER_CAPACITY {
        if enabled[slot] != 0 && admissible[slot] != 0 {
            let genome = oag_genome_for_slot(slot, &residual)
            let self_comparison = oag_genomes_equal_on_basis(
                &genome, &genome, &admission.seed_cells, &residual)
            identity_checks = identity_checks + 1
            if self_comparison[0] != 1 { identity_failures = identity_failures + 1 }
        }
        slot = slot + 1
    }
    let identity_check = identity_checks == admitted_count &&
        identity_failures == 0
    var basis_distinct_maps: i64 = 0
    slot = 1
    while slot < PIREUS_OAG_FRONTIER_CAPACITY {
        if admissible[slot] != 0 && representatives[slot] == slot {
            basis_distinct_maps = basis_distinct_maps + 1
        }
        slot = slot + 1
    }
    let residual_twist_basis_equal_parent =
        admissible[PIREUS_OAG_OPCODE_RESIDUAL_TWIST] != 0 &&
        representatives[PIREUS_OAG_OPCODE_RESIDUAL_TWIST] ==
            representatives[PIREUS_OAG_OPCODE_PARENT]
    if !identity_check || contract_transformations != 1 {
        structural_failures = structural_failures + 1
    }
    if generated_count <= 0 || admitted_count <= 0 {
        structural_failures = structural_failures + 1
    }
    let failure_groups =
        (if request_error != PIREUS_OAG_OK { 1 } else { 0 }) +
        (if !admission.lineage.complete { 1 } else { 0 }) +
        (if !residual.complete { 1 } else { 0 }) +
        (if structural_failures != 0 { 1 } else { 0 }) +
        (if negative_failures != 0 { 1 } else { 0 })
    let valid = failure_groups == 0
    let generation_expected: [i64; 8] = [
        1600525263, 1864873452, 1530773718, 668777497,
        2993500896, 1490679426, 2030917338, 2911070525
    ]
    let frozen_mismatch_code =
        if !valid || request_error != PIREUS_OAG_OK ||
            failure_groups != 0 || structural_failures != 0 { 1 }
        else if PIREUS_OAG_BITS != 4 || PIREUS_OAG_LANES != 16 ||
            PIREUS_OAG_CELLS != 256 || PIREUS_OAG_WORDS != 8 ||
            PIREUS_OAG_BILINEAR_BASIS != 256 ||
            PIREUS_OAG_TERNARY_BASIS != 4096 ||
            PIREUS_OAG_FRONTIER_CAPACITY != 7 ||
            PIREUS_OAG_NEGATIVE_CASES != 41 { 2 }
        else if !oag_frozen_lineage_residual_match(&admission, &residual) { 3 }
        else if !oag_frozen_frontier_match(
            &enabled, &admissible, &rejection_reason,
            &representatives, &separators) { 4 }
        // Four generated bilinear slots contribute 4*256 checks. Three
        // generated ternary slots, including the typed rejection, contribute
        // 3*4096 checks. These are execution-census locks, not novelty counts.
        else if generated_count != 7 || admitted_count != 6 ||
            rejected_count != 1 || duplicate_checks != 21 ||
            duplicate_failures != 0 || bilinear_basis_checks != 1024 ||
            ternary_basis_checks != 12288 { 5 }
        else if contract_transformations != 1 || !identity_check ||
            identity_checks != 6 || identity_failures != 0 ||
            quotient_pairs != 15 || separating_witnesses != 14 ||
            basis_distinct_maps != 4 ||
            !residual_twist_basis_equal_parent { 6 }
        else if negative_passed != PIREUS_OAG_NEGATIVE_CASES ||
            !oag_frozen_negatives_match(&negative_cases) { 7 }
        else if !oag_hash_equal(
            &generation_digest.words, &generation_expected) { 8 }
        else { 0 }
    let frozen_match = frozen_mismatch_code == 0

    if emit_transcript {
        print("SOUNIO_AUTHORITY schema=pireus-operator-autogenesis.v9")
        print(" role=SEMANTIC_AUTHORITY stage=SOUNIO_EXECUTABLE\n")
        print("PIREUS_OAG_LINEAGE source_file_match=")
        print_int(oag_bit(admission.lineage.source_file_match))
        print(" semantics_receipt_match=")
        print_int(oag_bit(admission.lineage.semantics_receipt_match))
        print(" freeze_file_match=")
        print_int(oag_bit(admission.lineage.freeze_file_match))
        print(" evidence_file_match=")
        print_int(oag_bit(admission.lineage.evidence_file_match))
        print(" parent_result_valid=")
        print_int(oag_bit(admission.lineage.parent_result_valid))
        print(" parent_frozen_match=")
        print_int(oag_bit(admission.lineage.parent_frozen_match))
        print(" seed_word_checks="); print_int(admission.lineage.seed_word_checks)
        print(" seed_cell_checks="); print_int(admission.lineage.seed_cell_checks)
        print(" seed_failures="); print_int(admission.lineage.seed_failures)
        print(" seed_weight="); print_int(admission.lineage.seed_weight)
        print(" recursive_parent_evaluation=0 complete=")
        print_int(oag_bit(admission.lineage.complete))
        print("\n")
        print("PIREUS_OAG_PARENT_HASH name=source value=")
        let source_digest = PireusOagDigest { words: oag_parent_source_hash() }
        oag_print_digest(&source_digest); print("\n")
        print("PIREUS_OAG_PARENT_HASH name=semantics value=")
        let semantics_digest = PireusOagDigest {
            words: oag_parent_semantics_hash()
        }
        oag_print_digest(&semantics_digest); print("\n")
        print("PIREUS_OAG_PARENT_HASH name=freeze value=")
        let freeze_digest = PireusOagDigest { words: oag_parent_freeze_hash() }
        oag_print_digest(&freeze_digest); print("\n")
        print("PIREUS_OAG_PARENT_HASH name=evidence value=")
        let evidence_digest = PireusOagDigest {
            words: oag_parent_evidence_hash()
        }
        oag_print_digest(&evidence_digest); print("\n")
        print("PIREUS_OAG_RESIDUAL associator_failures=")
        print_int(residual.associator_failures)
        print(" commutator_failures="); print_int(residual.commutator_failures)
        print(" first_i="); print_int(residual.first_i)
        print(" first_j="); print_int(residual.first_j)
        print(" first_k="); print_int(residual.first_k)
        print(" digest="); oag_print_digest(&residual.digest)
        print(" complete="); print_int(oag_bit(residual.complete))
        print("\n")
        slot = 0
        while slot < PIREUS_OAG_FRONTIER_CAPACITY {
            if enabled[slot] != 0 {
                let genome = oag_genome_for_slot(slot, &residual)
                let mutation = oag_mutation_witness(&genome, &residual)
                let evaluation = oag_evaluate_genome(
                    &genome, &admission.seed_cells, &residual)
                let genome_digest = oag_load_digest(&genome_digests, slot)
                let basis_digest = oag_load_digest(&basis_digests, slot)
                let law_digest = oag_load_digest(&law_digests, slot)
                var program_distinct = slot != PIREUS_OAG_OPCODE_PARENT
                var law_profile_distinct = slot != PIREUS_OAG_OPCODE_PARENT
                var previous: i64 = 0
                while previous < slot {
                    if enabled[previous] != 0 &&
                        oag_flat_digest_equal(&genome_digests, previous, slot) {
                        program_distinct = false
                    }
                    if enabled[previous] != 0 &&
                        oag_flat_digest_equal(&law_digests, previous, slot) {
                        law_profile_distinct = false
                    }
                    previous = previous + 1
                }
                let basis_distinct = admissible[slot] != 0 &&
                    slot != PIREUS_OAG_OPCODE_PARENT &&
                    representatives[slot] == slot
                let is_admissible = admissible[slot] != 0
                oag_emit_candidate(
                    &genome, &mutation, &genome_digest, &basis_digest,
                    &law_digest, representatives[slot], separators[slot],
                    program_distinct, basis_distinct, law_profile_distinct,
                    is_admissible, rejection_reason[slot], &evaluation)
                if is_admissible {
                    oag_emit_basis(
                        &genome, &admission.seed_cells, &residual)
                }
            }
            slot = slot + 1
        }
        print("PIREUS_OAG_EQUIVALENCE contract=")
        print_int(PIREUS_OAG_EQ_IDENTITY)
        print(" transformations="); print_int(contract_transformations)
        print(" identity_only=1")
        print(" reflexivity="); print_int(oag_bit(identity_check))
        print(" reflexivity_checks="); print_int(identity_checks)
        print(" reflexivity_failures="); print_int(identity_failures)
        print(" pair_checks="); print_int(quotient_pairs)
        print(" separating_witnesses="); print_int(separating_witnesses)
        print(" complete="); print_int(oag_bit(identity_check))
        print("\n")
        right_slot = 0
        while right_slot < PIREUS_OAG_FRONTIER_CAPACITY {
            if enabled[right_slot] != 0 && admissible[right_slot] != 0 {
                let right_genome = oag_genome_for_slot(right_slot, &residual)
                var left_slot: i64 = 0
                while left_slot < right_slot {
                    if enabled[left_slot] != 0 && admissible[left_slot] != 0 {
                        let left_genome = oag_genome_for_slot(
                            left_slot, &residual)
                        let comparison = oag_genomes_equal_on_basis(
                            &left_genome, &right_genome,
                            &admission.seed_cells, &residual)
                        let pair_separator = if comparison[0] == 1 { -1 }
                            else if left_genome.arity != right_genome.arity {
                                900000 + left_genome.arity * 10 +
                                    right_genome.arity
                            } else { comparison[1] }
                        print("PIREUS_OAG_EQ_PAIR left="); print_int(left_slot)
                        print(" right="); print_int(right_slot)
                        print(" same_identity_orbit="); print_int(comparison[0])
                        print(" separating_witness="); print_int(pair_separator)
                        print("\n")
                    }
                    left_slot = left_slot + 1
                }
            }
            right_slot = right_slot + 1
        }
        negative = 0
        while negative < PIREUS_OAG_NEGATIVE_CASES {
            oag_print_negative(
                oag_negative_name(negative), negative_cases[negative])
            negative = negative + 1
        }
        print("PIREUS_OAG_NEGATIVES total=")
        print_int(PIREUS_OAG_NEGATIVE_CASES)
        print(" passed="); print_int(negative_passed)
        print("\n")
        print("PIREUS_OAG_GENERATION generated="); print_int(generated_count)
        print(" admitted="); print_int(admitted_count)
        print(" rejected="); print_int(rejected_count)
        print(" duplicate_checks="); print_int(duplicate_checks)
        print(" duplicate_failures="); print_int(duplicate_failures)
        print(" bilinear_basis_checks="); print_int(bilinear_basis_checks)
        print(" ternary_basis_checks="); print_int(ternary_basis_checks)
        print(" digest="); oag_print_digest(&generation_digest)
        print("\n")
        print("PIREUS_OAG_AUTHORITY expected_result_used=0")
        print(" finite_function_certificate_used=0 target_evidence_used=0")
        print(" material_evidence_used=0 formal_parity_open=0")
        print(" effect_parity_open=0 material_parity_open=0")
        print(" historical_novelty=0 priority=0 claim_ready=0\n")
        print("PIREUS_OAG_RESULT valid="); print_int(oag_bit(valid))
        print(" error="); print_int(request_error)
        print(" failure_groups="); print_int(failure_groups)
        print(" structural_failures="); print_int(structural_failures)
        print(" semantics_frozen=0 claim_ready=0\n")
        print("PIREUS_OAG_FROZEN match="); print_int(oag_bit(frozen_match))
        print(" mismatch_code="); print_int(frozen_mismatch_code)
        print(" basis_distinct_maps="); print_int(basis_distinct_maps)
        print(" residual_twist_basis_equal_parent=")
        print_int(oag_bit(residual_twist_basis_equal_parent))
        print(" admission_scope=TYPED_EXECUTABLE_NOT_NOVELTY")
        print(" quotient_scope=IDENTITY_BASIS_EQUALITY_ONLY")
        print("\n")
    }
    PireusOagSummary {
        valid: valid,
        error: request_error,
        failure_groups: failure_groups,
        structural_failures: structural_failures,
        generated: generated_count,
        admitted: admitted_count,
        negative_failures: negative_failures,
        frozen_match: frozen_match,
        frozen_mismatch_code: frozen_mismatch_code,
        claim_ready: false,
    }
}
