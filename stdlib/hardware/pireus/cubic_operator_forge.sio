}

fn cof_request_error(request: &PireusCubicForgeRequest) -> i64
with Mut, Panic {
    if request.producer_language != PIREUS_CUBIC_FORGE_LANGUAGE_SOUNIO ||
        request.producer_role != PIREUS_CUBIC_FORGE_ROLE_SEMANTIC_AUTHORITY {
        return PIREUS_CUBIC_FORGE_ERR_AUTHORITY
    }
    if request.stage != PIREUS_CUBIC_FORGE_STAGE_SOUNIO_EXECUTABLE ||
        request.semantics_frozen || request.parity_requested {
        return PIREUS_CUBIC_FORGE_ERR_STAGE
    }
    if !request.policy_present { return PIREUS_CUBIC_FORGE_ERR_POLICY }
    if !request.parent_present || !request.parent_semantics_frozen ||
        !request.parent_source_bound || !request.parent_semantics_bound ||
        !request.parent_freeze_bound || !request.parent_transcript_bound ||
        !request.parent_parity_receipt_bound {
        return PIREUS_CUBIC_FORGE_ERR_PARENT
    }
    if request.declared_mutation_count !=
            PIREUS_CUBIC_FORGE_MUTATION_COUNT ||
        !request.exact_descriptor_order || request.malformed_descriptor ||
        request.pure_side_mutation || request.bilinear_equality_claimed ||
        request.child_collision_present {
        return PIREUS_CUBIC_FORGE_ERR_GRAMMAR
    }
    if request.selection_requested || request.ranking_present {
        return PIREUS_CUBIC_FORGE_ERR_SELECTION
    }
    if request.target_count != PIREUS_CUBIC_FORGE_TARGET_COUNT ||
        request.target_ids[0] != PIREUS_GENOME_TARGET_DARWIN_XEON ||
        request.target_ids[1] != PIREUS_GENOME_TARGET_APPLE_SILICON ||
        request.target_ids[2] != PIREUS_GENOME_TARGET_DGX_SPARK ||
        request.target_ids[3] != PIREUS_GENOME_TARGET_AMD_ALVEO_U250 ||
        request.u250_card_count != 2 {
        return PIREUS_CUBIC_FORGE_ERR_TARGET
    }
    if request.target_observation_count != 0 ||
        request.target_discharge_count != 0 ||
        request.material_receipt_count != 0 || request.lowering_count != 0 ||
        request.cost_record_count != 0 ||
        request.performance_record_count != 0 {
        return PIREUS_CUBIC_FORGE_ERR_MATERIAL
    }
    if request.child_changes_partner || request.child_changes_destination ||
        request.child_changes_ordinal || request.child_reassociates ||
        request.fixture_promoted_to_proof ||
        request.diagnostics_promoted_to_mutation_invariant ||
        request.gl4_gauge_inequivalence_requested ||
        request.algebraic_novelty_requested ||
        request.algorithmic_novelty_requested ||
        request.material_novelty_requested ||
        request.scientific_novelty_requested ||
        request.global_novelty_requested ||
        request.historical_novelty_requested || request.priority_requested ||
        request.claim_ready_requested || request.external_review_promoted {
        return PIREUS_CUBIC_FORGE_ERR_CLAIM
    }
    if request.waiver_present && !(request.waiver_founder &&
        request.waiver_scoped && request.waiver_purpose_bound &&
        request.waiver_live) {
        return PIREUS_CUBIC_FORGE_ERR_WAIVER
    }
    PIREUS_CUBIC_FORGE_OK
}

fn cof_descriptor(mutation: i64) -> CubicMutationDescriptor with Mut {
    var ordinal: i64 = 0
    var r: i64 = 0
    while r < 4 {
        var s: i64 = r + 1
        while s < 4 {
            var t: i64 = 0
            while t < 4 {
                if ordinal == mutation {
                    return CubicMutationDescriptor {
                        kind: PIREUS_CUBIC_FORGE_KIND_L2R1,
                        r: r, s: s, t: t, valid: true,
                    }
                }
                ordinal = ordinal + 1
                t = t + 1
            }
            s = s + 1
        }
        r = r + 1
    }
    r = 0
    while r < 4 {
        var s: i64 = 0
        while s < 4 {
            var t: i64 = s + 1
            while t < 4 {
                if ordinal == mutation {
                    return CubicMutationDescriptor {
                        kind: PIREUS_CUBIC_FORGE_KIND_L1R2,
                        r: r, s: s, t: t, valid: true,
                    }
                }
                ordinal = ordinal + 1
                t = t + 1
            }
            s = s + 1
        }
        r = r + 1
    }
    CubicMutationDescriptor { kind: 0, r: -1, s: -1, t: -1, valid: false }
}

fn cof_bit(value: i64, coordinate: i64) -> i64 {
    (value >> coordinate) & 1
}

fn cof_mutation_bit(
    descriptor: &CubicMutationDescriptor,
    left: i64,
    right: i64,
) -> i64 {
    if descriptor.kind == PIREUS_CUBIC_FORGE_KIND_L2R1 {
        return cof_bit(left, descriptor.r) *
            cof_bit(left, descriptor.s) * cof_bit(right, descriptor.t)
    }
    if descriptor.kind == PIREUS_CUBIC_FORGE_KIND_L1R2 {
        return cof_bit(left, descriptor.r) *
            cof_bit(right, descriptor.s) * cof_bit(right, descriptor.t)
    }
    0
}

fn cof_mutation_defect(
    descriptor: &CubicMutationDescriptor,
    i: i64,
    j: i64,
    k: i64,
) -> i64 {
    cof_mutation_bit(descriptor, i, j) ^
        cof_mutation_bit(descriptor, i ^ j, k) ^
        cof_mutation_bit(descriptor, j, k) ^
        cof_mutation_bit(descriptor, i, j ^ k)
}

fn cof_bilinear_bit(matrix: i64, left: i64, right: i64) -> i64
with Mut {
    var value: i64 = 0
    var row: i64 = 0
    while row < 4 {
        if cof_bit(left, row) != 0 {
            var column: i64 = 0
            while column < 4 {
                if cof_bit(right, column) != 0 &&
                    ((matrix >> (4 * row + column)) & 1) != 0 {
                    value = value ^ 1
                }
                column = column + 1
            }
        }
        row = row + 1
    }
    value
}

fn cof_bilinear_defect(matrix: i64, i: i64, j: i64, k: i64) -> i64
with Mut {
    cof_bilinear_bit(matrix, i, j) ^
        cof_bilinear_bit(matrix, i ^ j, k) ^
        cof_bilinear_bit(matrix, j, k) ^
        cof_bilinear_bit(matrix, i, j ^ k)
}

fn cof_build_lineage(
    parent: &PireusOperatorGenomeResult,
    request: &PireusCubicForgeRequest,
) -> PireusCubicForgeLineage with Mut, Panic, Div {
    let expected_semantics = cof_parent_semantics_hash()
    let parent_live_match =
        pireus_operator_genome_matches_frozen_semantics(parent)
    let parent_digest_match =
        cof_parent_digest_matches(&parent.genome_digest, &expected_semantics)
    let parent_scope_match = request.parent_present &&
        request.parent_semantics_frozen && request.parent_source_bound &&
        request.parent_semantics_bound && request.parent_freeze_bound &&
        request.parent_transcript_bound && request.parent_parity_receipt_bound &&
        !parent.receipt.algorithmic_novelty &&
        !parent.receipt.material_novelty &&
        !parent.receipt.scientific_novelty &&
        !parent.receipt.global_novelty &&
        !parent.receipt.historical_novelty && !parent.receipt.priority_claim &&
        !parent.receipt.claim_ready
    PireusCubicForgeLineage {
        parent_source_sha256: cof_parent_source_hash(),
        parent_semantics_sha256: expected_semantics,
        parent_freeze_sha256: cof_parent_freeze_hash(),
        parent_transcript_sha256: cof_parent_transcript_hash(),
        parent_parity_receipt_sha256: cof_parent_parity_receipt_hash(),
        parent_live_match: parent_live_match,
        parent_digest_match: parent_digest_match,
        parent_scope_match: parent_scope_match,
        complete: parent_live_match && parent_digest_match &&
            parent_scope_match,
    }
}

fn cof_child_digest(
    mutation: i64,
    descriptor: &CubicMutationDescriptor,
    signs: &[i64; 12288],
    masks: &[i64; 1536],
    outputs: &[i64; 768],
    support: i64,
    witness_value: i64,
    negatives: i64,
    squares: i64,
    commutators: i64,
    associators: i64,
) -> PireusCubicForgeDigest with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    let parent_semantics = cof_parent_semantics_hash()
    state = cof_digest_add_i64(state, PIREUS_CUBIC_FORGE_SCHEMA)
    state = cof_digest_add_words(state, &parent_semantics)
    state = cof_digest_add_i64(state, mutation)
    state = cof_digest_add_i64(state, descriptor.kind)
    state = cof_digest_add_i64(state, descriptor.r)
    state = cof_digest_add_i64(state, descriptor.s)
    state = cof_digest_add_i64(state, descriptor.t)
    var cell: i64 = 0
    while cell < PIREUS_CUBIC_FORGE_CELL_COUNT {
        state = cof_digest_add_i64(
            state, signs[mutation * PIREUS_CUBIC_FORGE_CELL_COUNT + cell])
        cell = cell + 1
    }
    var group: i64 = 0
    while group < PIREUS_CUBIC_FORGE_GROUP_COUNT {
        state = cof_digest_add_i64(
            state, masks[mutation * PIREUS_CUBIC_FORGE_GROUP_COUNT + group])
        group = group + 1
    }
    var lane: i64 = 0
    while lane < PIREUS_CUBIC_FORGE_DIMENSION {
        state = cof_digest_add_i64(
            state, outputs[mutation * PIREUS_CUBIC_FORGE_DIMENSION + lane])
        lane = lane + 1
    }
    state = cof_digest_add_i64(state, support)
    state = cof_digest_add_i64(state, witness_value)
    state = cof_digest_add_i64(state, negatives)
    state = cof_digest_add_i64(state, squares)
    state = cof_digest_add_i64(state, commutators)
    state = cof_digest_add_i64(state, associators)
    state = cof_digest_add_i64(
        state, PIREUS_CUBIC_FORGE_TARGET_COUNT *
            PIREUS_CUBIC_FORGE_OBLIGATION_COUNT)
    state = cof_digest_add_i64(state, 0)
    cof_digest_finish(state)
}

fn cof_child_lineage_digest(
    mutation: i64,
    descriptor: &CubicMutationDescriptor,
    child: &PireusCubicForgeDigest,
) -> PireusCubicForgeDigest with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    let parent_source = cof_parent_source_hash()
    let parent_semantics = cof_parent_semantics_hash()
    let parent_freeze = cof_parent_freeze_hash()
    let parent_transcript = cof_parent_transcript_hash()
    let parent_parity_receipt = cof_parent_parity_receipt_hash()
    state = cof_digest_add_words(state, &parent_source)
    state = cof_digest_add_words(state, &parent_semantics)
    state = cof_digest_add_words(state, &parent_freeze)
    state = cof_digest_add_words(state, &parent_transcript)
    state = cof_digest_add_words(state, &parent_parity_receipt)
    state = cof_digest_add_i64(state, mutation)
    state = cof_digest_add_i64(state, descriptor.kind)
    state = cof_digest_add_i64(state, descriptor.r)
    state = cof_digest_add_i64(state, descriptor.s)
    state = cof_digest_add_i64(state, descriptor.t)
    state = cof_digest_add_digest(state, child)
    cof_digest_finish(state)
}

fn cof_build_population(
    parent: &PireusOperatorGenomeResult,
) -> PireusCubicMutationPopulation with Mut, Panic, Div, Epistemic {
    var kinds: [i64; 48] = [0; 48]
    var r_coordinates: [i64; 48] = [0; 48]
    var s_coordinates: [i64; 48] = [0; 48]
    var t_coordinates: [i64; 48] = [0; 48]
    var support_counts: [i64; 48] = [0; 48]
    var witness_i: [i64; 48] = [0; 48]
    var witness_j: [i64; 48] = [0; 48]
    var witness_k: [i64; 48] = [0; 48]
    var witness_values: [i64; 48] = [0; 48]
    var negative_counts: [i64; 48] = [0; 48]
    var square_negative_counts: [i64; 48] = [0; 48]
    var commutator_defects: [i64; 48] = [0; 48]
    var associator_defects: [i64; 48] = [0; 48]
    var group_counts: [i64; 48] = [0; 48]
    var unresolved_obligations: [i64; 48] = [0; 48]
    var sign_bits: [i64; 12288] = [0; 12288]
    var group_negative_masks: [i64; 1536] = [0; 1536]
    var fixture_output_bits: [i64; 768] = [0; 768]
    var child_digest_words: [i64; 384] = [0; 384]
    var child_lineage_digest_words: [i64; 384] = [0; 384]
    var descriptor_checks: i64 = 0
    var descriptor_failures: i64 = 0
    var support_checks: i64 = 0
    var support_failures: i64 = 0
    var witness_checks: i64 = 0
    var witness_failures: i64 = 0
    var bilinear_witness_checks: i64 = 0
    var bilinear_witness_failures: i64 = 0
    var pairwise_checks: i64 = 0
    var pairwise_failures: i64 = 0
    var sign_range_checks: i64 = 0
    var sign_range_failures: i64 = 0
    var parent_delta_checks: i64 = 0
    var parent_delta_failures: i64 = 0
    var semantic_cell_checks: i64 = 0
    var semantic_cell_failures: i64 = 0
    var fixture_checks: i64 = 0
    var fixture_failures: i64 = 0
    var group_total: i64 = 0
    var unresolved_total: i64 = 0

    var mutation: i64 = 0
    while mutation < PIREUS_CUBIC_FORGE_MUTATION_COUNT {
        let descriptor = cof_descriptor(mutation)
        kinds[mutation] = descriptor.kind
        r_coordinates[mutation] = descriptor.r
        s_coordinates[mutation] = descriptor.s
        t_coordinates[mutation] = descriptor.t
        descriptor_checks = descriptor_checks + 1
        if !descriptor.valid || descriptor.r < 0 || descriptor.r >= 4 ||
            descriptor.s < 0 || descriptor.s >= 4 ||
            descriptor.t < 0 || descriptor.t >= 4 ||
            (descriptor.kind == PIREUS_CUBIC_FORGE_KIND_L2R1 &&
                descriptor.r >= descriptor.s) ||
            (descriptor.kind == PIREUS_CUBIC_FORGE_KIND_L1R2 &&
                descriptor.s >= descriptor.t) {
            descriptor_failures = descriptor_failures + 1
        }

        let wi = 1 << descriptor.r
        let wj = 1 << descriptor.s
        let wk = 1 << descriptor.t
        let witness = cof_mutation_defect(&descriptor, wi, wj, wk)
        witness_i[mutation] = wi
        witness_j[mutation] = wj
        witness_k[mutation] = wk
        witness_values[mutation] = witness
        witness_checks = witness_checks + 1
        if witness != 1 { witness_failures = witness_failures + 1 }

        var matrix: i64 = 0
        while matrix < PIREUS_CUBIC_FORGE_BILINEAR_COUNT {
            bilinear_witness_checks = bilinear_witness_checks + 1
            if cof_bilinear_defect(matrix, wi, wj, wk) != 0 {
                bilinear_witness_failures = bilinear_witness_failures + 1
            }
            matrix = matrix + 1
        }

        var support: i64 = 0
        var negatives: i64 = 0
        var left: i64 = 0
        while left < PIREUS_CUBIC_FORGE_DIMENSION {
            var right: i64 = 0
            while right < PIREUS_CUBIC_FORGE_DIMENSION {
                let table_cell = left * PIREUS_CUBIC_FORGE_DIMENSION + right
                let mutation_value = cof_mutation_bit(&descriptor, left, right)
                let child_sign = parent.genotype.sign_bits[table_cell] ^
                    mutation_value
                let flat = mutation * PIREUS_CUBIC_FORGE_CELL_COUNT +
                    table_cell
                sign_bits[flat] = child_sign
                support_checks = support_checks + 1
                if mutation_value != 0 { support = support + 1 }
                sign_range_checks = sign_range_checks + 1
                if child_sign < 0 || child_sign > 1 {
                    sign_range_failures = sign_range_failures + 1
                }
                parent_delta_checks = parent_delta_checks + 1
                if (child_sign ^ parent.genotype.sign_bits[table_cell]) !=
                        mutation_value {
                    parent_delta_failures = parent_delta_failures + 1
                }
                if child_sign != 0 { negatives = negatives + 1 }
                right = right + 1
            }
            left = left + 1
        }
        support_counts[mutation] = support
        negative_counts[mutation] = negatives
        if support != PIREUS_CUBIC_FORGE_EXPECTED_SUPPORT {
            support_failures = support_failures + 1
        }

        var squares: i64 = 0
        var commutators: i64 = 0
        left = 0
        while left < PIREUS_CUBIC_FORGE_DIMENSION {
            let diagonal = mutation * PIREUS_CUBIC_FORGE_CELL_COUNT +
                left * PIREUS_CUBIC_FORGE_DIMENSION + left
            if sign_bits[diagonal] != 0 { squares = squares + 1 }
            var right: i64 = 0
            while right < PIREUS_CUBIC_FORGE_DIMENSION {
                let forward = mutation * PIREUS_CUBIC_FORGE_CELL_COUNT +
                    left * PIREUS_CUBIC_FORGE_DIMENSION + right
                let reverse = mutation * PIREUS_CUBIC_FORGE_CELL_COUNT +
                    right * PIREUS_CUBIC_FORGE_DIMENSION + left
                if sign_bits[forward] != sign_bits[reverse] {
                    commutators = commutators + 1
                }
                right = right + 1
            }
            left = left + 1
        }
        square_negative_counts[mutation] = squares
        commutator_defects[mutation] = commutators

        var associators: i64 = 0
        var i: i64 = 0
        while i < PIREUS_CUBIC_FORGE_DIMENSION {
            var j: i64 = 0
            while j < PIREUS_CUBIC_FORGE_DIMENSION {
                var k: i64 = 0
                while k < PIREUS_CUBIC_FORGE_DIMENSION {
                    let base = mutation * PIREUS_CUBIC_FORGE_CELL_COUNT
                    let defect = sign_bits[base + i * 16 + j] ^
                        sign_bits[base + (i ^ j) * 16 + k] ^
                        sign_bits[base + j * 16 + k] ^
                        sign_bits[base + i * 16 + (j ^ k)]
                    if defect != 0 { associators = associators + 1 }
                    k = k + 1
                }
                j = j + 1
            }
            i = i + 1
        }
        associator_defects[mutation] = associators

        var d: i64 = 0
        while d < PIREUS_CUBIC_FORGE_DIMENSION {
            i = 0
            while i < PIREUS_CUBIC_FORGE_DIMENSION {
                let parent_cell = d * PIREUS_CUBIC_FORGE_DIMENSION + i
                semantic_cell_checks = semantic_cell_checks + 1
                if parent.microprogram.destinations[parent_cell] != d ||
                    parent.microprogram.lhs_indices[parent_cell] != i ||
                    parent.microprogram.rhs_indices[parent_cell] != (i ^ d) ||
                    parent.microprogram.ordinals[parent_cell] != i {
                    semantic_cell_failures = semantic_cell_failures + 1
                }
                i = i + 1
            }
            var chunk: i64 = 0
            while chunk < 2 {
                let group = d * 2 + chunk
                var mask: i64 = 0
                var lane: i64 = 0
                while lane < PIREUS_CUBIC_FORGE_GROUP_LANES {
                    let source = chunk * PIREUS_CUBIC_FORGE_GROUP_LANES + lane
                    let partner = source ^ d
                    let sign_cell = mutation * PIREUS_CUBIC_FORGE_CELL_COUNT +
                        source * PIREUS_CUBIC_FORGE_DIMENSION + partner
                    if sign_bits[sign_cell] != 0 {
                        mask = mask | (1 << lane)
                    }
                    lane = lane + 1
                }
                group_negative_masks[
                    mutation * PIREUS_CUBIC_FORGE_GROUP_COUNT + group] = mask
                chunk = chunk + 1
            }

            var direct: f64 = 0.0
            var micro: f64 = 0.0
            i = 0
            while i < PIREUS_CUBIC_FORGE_DIMENSION {
                let partner = i ^ d
                var direct_term = parent.evaluation.lhs[i] *
                    parent.evaluation.rhs[partner]
                let direct_sign = parent.genotype.sign_bits[i * 16 + partner] ^
                    cof_mutation_bit(&descriptor, i, partner)
                if direct_sign != 0 { direct_term = 0.0 - direct_term }
                direct = direct + direct_term

                var micro_term = parent.evaluation.lhs[i] *
                    parent.evaluation.rhs[partner]
                let micro_sign = sign_bits[
                    mutation * PIREUS_CUBIC_FORGE_CELL_COUNT + i * 16 + partner]
                if micro_sign != 0 { micro_term = 0.0 - micro_term }
                micro = micro + micro_term
                i = i + 1
            }
            fixture_output_bits[
                mutation * PIREUS_CUBIC_FORGE_DIMENSION + d] =
                    f64_to_bits(direct)
            fixture_checks = fixture_checks + 1
            if f64_to_bits(direct) != f64_to_bits(micro) {
                fixture_failures = fixture_failures + 1
            }
            d = d + 1
        }
        group_counts[mutation] = PIREUS_CUBIC_FORGE_GROUP_COUNT
        group_total = group_total + PIREUS_CUBIC_FORGE_GROUP_COUNT
        unresolved_obligations[mutation] =
            PIREUS_CUBIC_FORGE_TARGET_COUNT *
                PIREUS_CUBIC_FORGE_OBLIGATION_COUNT
        unresolved_total = unresolved_total + unresolved_obligations[mutation]

        let child_digest = cof_child_digest(
            mutation, &descriptor, &sign_bits, &group_negative_masks,
            &fixture_output_bits, support, witness, negatives, squares,
            commutators, associators)
        let child_lineage = cof_child_lineage_digest(
            mutation, &descriptor, &child_digest)
        var word: i64 = 0
        while word < 8 {
            child_digest_words[mutation * 8 + word] = child_digest.words[word]
            child_lineage_digest_words[mutation * 8 + word] =
                child_lineage.words[word]
            word = word + 1
        }
        mutation = mutation + 1
    }

    var left_child: i64 = 0
    while left_child < PIREUS_CUBIC_FORGE_MUTATION_COUNT {
        var right_child: i64 = left_child + 1
        while right_child < PIREUS_CUBIC_FORGE_MUTATION_COUNT {
            pairwise_checks = pairwise_checks + 1
            var differs = false
            var cell: i64 = 0
            while cell < PIREUS_CUBIC_FORGE_CELL_COUNT && !differs {
                if sign_bits[left_child * PIREUS_CUBIC_FORGE_CELL_COUNT + cell] !=
                    sign_bits[right_child * PIREUS_CUBIC_FORGE_CELL_COUNT + cell] {
                    differs = true
                }
                cell = cell + 1
            }
            if !differs { pairwise_failures = pairwise_failures + 1 }
            right_child = right_child + 1
        }
        left_child = left_child + 1
    }

    let complete = descriptor_checks == PIREUS_CUBIC_FORGE_MUTATION_COUNT &&
        descriptor_failures == 0 &&
        support_checks == PIREUS_CUBIC_FORGE_MUTATION_COUNT *
            PIREUS_CUBIC_FORGE_CELL_COUNT && support_failures == 0 &&
        witness_checks == PIREUS_CUBIC_FORGE_MUTATION_COUNT &&
        witness_failures == 0 &&
        bilinear_witness_checks == PIREUS_CUBIC_FORGE_MUTATION_COUNT *
            PIREUS_CUBIC_FORGE_BILINEAR_COUNT &&
        bilinear_witness_failures == 0 &&
        pairwise_checks == PIREUS_CUBIC_FORGE_PAIR_COUNT &&
        pairwise_failures == 0 &&
        sign_range_checks == PIREUS_CUBIC_FORGE_MUTATION_COUNT *
            PIREUS_CUBIC_FORGE_CELL_COUNT && sign_range_failures == 0 &&
        parent_delta_checks == PIREUS_CUBIC_FORGE_MUTATION_COUNT *
            PIREUS_CUBIC_FORGE_CELL_COUNT && parent_delta_failures == 0 &&
        semantic_cell_checks == PIREUS_CUBIC_FORGE_MUTATION_COUNT *
            PIREUS_CUBIC_FORGE_CELL_COUNT && semantic_cell_failures == 0 &&
        fixture_checks == PIREUS_CUBIC_FORGE_MUTATION_COUNT *
            PIREUS_CUBIC_FORGE_DIMENSION && fixture_failures == 0 &&
        group_total == PIREUS_CUBIC_FORGE_MUTATION_COUNT *
            PIREUS_CUBIC_FORGE_GROUP_COUNT &&
        unresolved_total == PIREUS_CUBIC_FORGE_MUTATION_COUNT *
            PIREUS_CUBIC_FORGE_TARGET_COUNT *
            PIREUS_CUBIC_FORGE_OBLIGATION_COUNT

    PireusCubicMutationPopulation {
        mutation_count: PIREUS_CUBIC_FORGE_MUTATION_COUNT,
        kinds: kinds,
        r_coordinates: r_coordinates,
        s_coordinates: s_coordinates,
        t_coordinates: t_coordinates,
        support_counts: support_counts,
        witness_i: witness_i,
        witness_j: witness_j,
        witness_k: witness_k,
        witness_values: witness_values,
        negative_counts: negative_counts,
        square_negative_counts: square_negative_counts,
        commutator_defects: commutator_defects,
        associator_defects: associator_defects,
        group_counts: group_counts,
        unresolved_obligations: unresolved_obligations,
        sign_bits: sign_bits,
        group_negative_masks: group_negative_masks,
        fixture_output_bits: fixture_output_bits,
        child_digest_words: child_digest_words,
        child_lineage_digest_words: child_lineage_digest_words,
        descriptor_checks: descriptor_checks,
        descriptor_failures: descriptor_failures,
        support_checks: support_checks,
        support_failures: support_failures,
        witness_checks: witness_checks,
        witness_failures: witness_failures,
        bilinear_witness_checks: bilinear_witness_checks,
        bilinear_witness_failures: bilinear_witness_failures,
        pairwise_checks: pairwise_checks,
        pairwise_failures: pairwise_failures,
        sign_range_checks: sign_range_checks,
        sign_range_failures: sign_range_failures,
        parent_delta_checks: parent_delta_checks,
        parent_delta_failures: parent_delta_failures,
        semantic_cell_checks: semantic_cell_checks,
        semantic_cell_failures: semantic_cell_failures,
        fixture_checks: fixture_checks,
        fixture_failures: fixture_failures,
        group_total: group_total,
        unresolved_obligation_total: unresolved_total,
        target_observations: 0,
        target_discharges: 0,
        material_receipts: 0,
        target_lowerings: 0,
        target_cost_records: 0,
        target_performance_records: 0,
        selected_child: -1,
        ranking_present: false,
        complete: complete,
    }
}

fn cof_build_receipt(
    lineage: &PireusCubicForgeLineage,
    population: &PireusCubicMutationPopulation,
) -> PireusCubicForgeReceipt {
    let population_complete = population.complete &&
        population.mutation_count == PIREUS_CUBIC_FORGE_MUTATION_COUNT
    let witnesses_complete = population.witness_checks ==
            PIREUS_CUBIC_FORGE_MUTATION_COUNT &&
        population.witness_failures == 0 &&
        population.bilinear_witness_failures == 0
    PireusCubicForgeReceipt {
        schema: PIREUS_CUBIC_FORGE_SCHEMA,
        producer_language: PIREUS_CUBIC_FORGE_LANGUAGE_SOUNIO,
        producer_role: PIREUS_CUBIC_FORGE_ROLE_SEMANTIC_AUTHORITY,
        stage: PIREUS_CUBIC_FORGE_STAGE_SOUNIO_EXECUTABLE,
        parent_lineage_bound: lineage.complete,
        mixed_cubic_population_complete: population_complete,
        noncocycle_witness_complete: witnesses_complete,
        relative_bilinear_grammar_novelty: population_complete &&
            witnesses_complete,
        executable_child_genomes: population_complete &&
            population.fixture_failures == 0,
        immutable_lineage: lineage.complete,
        no_child_selected: population.selected_child == -1 &&
            !population.ranking_present,
        target_envelopes_unresolved:
            population.unresolved_obligation_total ==
                PIREUS_CUBIC_FORGE_MUTATION_COUNT *
                PIREUS_CUBIC_FORGE_TARGET_COUNT *
                PIREUS_CUBIC_FORGE_OBLIGATION_COUNT &&
            population.target_observations == 0 &&
            population.target_discharges == 0 &&
            population.material_receipts == 0 &&
            population.target_lowerings == 0 &&
            population.target_cost_records == 0 &&
            population.target_performance_records == 0,
        declared_coordinate_scope: true,
        structural_counts_are_child_diagnostics: true,
        fixture_is_smoke_only: true,
        declared_gl4_gauge_inequivalence: false,
        relative_algebraic_novelty: false,
        algebra_isomorphism_complete: false,
        algorithmic_novelty: false,
        material_novelty: false,
        scientific_novelty: false,
        global_novelty: false,
        historical_novelty: false,
        priority_claim: false,
        external_prior_art_complete: false,
        semantics_frozen: false,
        formal_parity_open: false,
        effect_parity_open: false,
        material_parity_open: false,
        target_lowering_admitted: false,
        target_cost_admitted: false,
        target_performance_admitted: false,
        claim_ready: false,
    }
}

fn cof_exercise_negatives() -> PireusCubicForgeNegatives
with Mut, Panic {
    let canonical = pireus_cubic_forge_request()
    var bad = canonical
    bad.producer_language = PIREUS_CUBIC_FORGE_LANGUAGE_PYTHON
    let python_oracle = cof_request_error(&bad) != PIREUS_CUBIC_FORGE_OK
    bad = canonical
    bad.producer_language = PIREUS_CUBIC_FORGE_LANGUAGE_RUST
    let rust_oracle = cof_request_error(&bad) != PIREUS_CUBIC_FORGE_OK
    bad = canonical
    bad.producer_language = PIREUS_CUBIC_FORGE_LANGUAGE_CPP
    bad.producer_role = PIREUS_CUBIC_FORGE_ROLE_MATERIAL_PARITY
    let cpp_authority = cof_request_error(&bad) != PIREUS_CUBIC_FORGE_OK
    bad = canonical
