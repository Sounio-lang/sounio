        parent_semantics_bound: true,
        parent_freeze_bound: true,
        parent_transcript_bound: true,
        parent_parity_receipt_bound: true,
        declared_mutation_count: PIREUS_CUBIC_FORGE_MUTATION_COUNT,
        exact_descriptor_order: true,
        malformed_descriptor: false,
        pure_side_mutation: false,
        bilinear_equality_claimed: false,
