        target_ids: [
            PIREUS_GENOME_TARGET_DARWIN_XEON,
            PIREUS_GENOME_TARGET_APPLE_SILICON,
            PIREUS_GENOME_TARGET_DGX_SPARK,
            PIREUS_GENOME_TARGET_AMD_ALVEO_U250
        ],
        u250_card_count: 2,
        target_observation_count: 0,
        target_discharge_count: 0,
        material_receipt_count: 0,
        lowering_count: 0,
        cost_record_count: 0,
        performance_record_count: 0,
        child_changes_partner: false,
        child_changes_destination: false,
        child_changes_ordinal: false,
        child_reassociates: false,
        fixture_promoted_to_proof: false,
        diagnostics_promoted_to_mutation_invariant: false,
        semantics_frozen: false,
        parity_requested: false,
        gl4_gauge_inequivalence_requested: false,
        algebraic_novelty_requested: false,
        algorithmic_novelty_requested: false,
        material_novelty_requested: false,
        scientific_novelty_requested: false,
        global_novelty_requested: false,
